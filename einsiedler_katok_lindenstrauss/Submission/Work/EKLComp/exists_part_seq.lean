import Mathlib
import Submission.Work.EKLComp.USCBasic
import Submission.Work.EKLC6Core.exists_gen_partition
import Submission.Work.EKLComp.X3Background

/-!
# `Work.EKLComp.exists_part_seq`

For every probability measure `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)` there is a sequence of finite
measurable partitions `P m` which is refining (`P (m+1)` refines `P m`), whose atoms have
`μ`-null topological frontier, and whose generated σ-algebras generate the Borel σ-algebra of
`X₃`.

The proof is in two steps.

* `Work.EKLComp.exists_null_frontier_base` (proved in a companion module) produces a countable
  family `D : ℕ → Set X₃` of Borel sets with `μ (frontier (D n)) = 0` which is a neighbourhood
  basis: for every point `x` and every open `V ∋ x` there is `n` with `x ∈ D n ⊆ V`.
* `Work.EKLComp.PSeq.ofBase` turns such a family into the required refining sequence of finite
  partitions: `P m` is the partition into the atoms of the Boolean algebra generated by
  `D 0, …, D (m-1)`, built by iterated binary joins.  Boolean combinations of null-frontier sets
  have null frontier, and the generated σ-algebras are the σ-algebra generated by `{D 0, …, D m}`,
  which is `borel X₃` because `D` is a basis
  (`Work.EKLC6Core.borel_eq_of_countable_small_sets`).
-/

open MeasureTheory Filter Topology
open scoped ENNReal

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedTactic false

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

namespace PSeq

variable {X : Type*} [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]

/-- `frontier (A ∩ B) ⊆ frontier A ∪ frontier B`. -/
theorem frontier_inter_subset_union (A B : Set X) :
    frontier (A ∩ B) ⊆ frontier A ∪ frontier B := by
  refine (frontier_inter_subset A B).trans ?_
  rintro x (⟨h1, _⟩ | ⟨_, h2⟩)
  · exact Or.inl h1
  · exact Or.inr h2


/-- **A countable family of Borel sets with null frontier which is a neighbourhood basis.**

On a second countable pseudo-metrizable space, for every finite Borel measure `μ` there is a
countable sequence `D n` of Borel sets with `μ (frontier (D n)) = 0` such that for every point
`x` and every open `V ∋ x` some `D n` satisfies `x ∈ D n ⊆ V`. -/
theorem nullFrontierBase {X : Type*} [TopologicalSpace X]
    [TopologicalSpace.PseudoMetrizableSpace X] [MeasurableSpace X] [BorelSpace X]
    [SecondCountableTopology X] (μ : Measure X) [IsFiniteMeasure μ] :
    ∃ D : ℕ → Set X, (∀ n, MeasurableSet (D n)) ∧ (∀ n, μ (frontier (D n)) = 0) ∧
      ∀ x : X, ∀ V : Set X, IsOpen V → x ∈ V → ∃ n, x ∈ D n ∧ D n ⊆ V := by
  letI : PseudoMetricSpace X := TopologicalSpace.pseudoMetrizableSpacePseudoMetric X
  by_cases hne : Nonempty X
  · haveI : Nonempty X := hne
    let q : ℕ → X := TopologicalSpace.denseSeq X
    have hq : DenseRange q := TopologicalSpace.denseRange_denseSeq X
    have hrad : ∀ m : ℕ, (1 : ℝ) / ((m : ℝ) + 2) < 1 / ((m : ℝ) + 1) := by
      intro m
      refine one_div_lt_one_div_of_lt ?_ ?_
      · positivity
      · linarith
    have hr : ∀ n m : ℕ, ∃ r : ℝ, r ∈ Set.Ioo ((1 : ℝ) / ((m : ℝ) + 2))
        (1 / ((m : ℝ) + 1)) ∧ μ (frontier (Metric.thickening r ({q n} : Set X))) = 0 :=
      fun n m => exists_null_frontier_thickening μ ({q n}) (hrad m)
    choose r hr' using hr
    let D : ℕ → Set X := fun k =>
      Metric.thickening (r (Nat.unpair k).1 (Nat.unpair k).2) ({q (Nat.unpair k).1} : Set X)
    refine ⟨D, ?_, ?_, ?_⟩
    · intro k
      have : IsOpen (D k) := by
        simp only [D]
        exact Metric.isOpen_thickening
      exact this.measurableSet
    · intro k
      have h1 : D k = Metric.thickening (r (Nat.unpair k).1 (Nat.unpair k).2)
          ({q (Nat.unpair k).1} : Set X) := rfl
      rw [h1]
      exact (hr' (Nat.unpair k).1 (Nat.unpair k).2).2
    · intro x V hV hxV
      obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.mp hV x hxV
      obtain ⟨m, hm⟩ := exists_nat_one_div_lt (show 0 < ε / 2 by linarith)
      have hm2 : (0 : ℝ) < 1 / ((m : ℝ) + 2) := by positivity
      obtain ⟨n, hn⟩ := hq.exists_dist_lt x hm2
      refine ⟨Nat.pair n m, ?_, ?_⟩
      · simp only [D, Nat.unpair_pair]
        rw [Metric.thickening_singleton, Metric.mem_ball]
        exact lt_trans hn (hr' n m).1.1
      · intro z hz
        simp only [D, Nat.unpair_pair] at hz
        rw [Metric.thickening_singleton, Metric.mem_ball] at hz
        apply hεV
        rw [Metric.mem_ball']
        have hz' : dist (q n) z < 1 / ((m : ℝ) + 1) := by
          rw [dist_comm]; exact lt_trans hz (hr' n m).1.2
        have h1 : (1 : ℝ) / ((m : ℝ) + 2) < ε / 2 := lt_of_le_of_lt (hrad m).le hm
        calc dist x z ≤ dist x (q n) + dist (q n) z := dist_triangle _ _ _
          _ < 1 / ((m : ℝ) + 2) + 1 / ((m : ℝ) + 1) := add_lt_add hn hz'
          _ < ε := by linarith
  · refine ⟨fun _ => ∅, ?_, ?_, ?_⟩
    · intro n; exact MeasurableSet.empty
    · intro n; simp
    · intro x; exact (hne ⟨x⟩).elim

/-- The two-element partition `{D k, (D k)ᶜ}`.  Marked `reducible` so that the index type
`Fin (twoPart D hD k).n` reduces to `Fin 2` during pattern matching. -/
@[reducible] def twoPart (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ) : FinPart X where
  n := 2
  parts := fun i : Fin 2 => if (i : ℕ) = 0 then D k else (D k)ᶜ
  measurable := by
    intro i
    by_cases h : (i : ℕ) = 0
    · rw [if_pos h]; exact hD k
    · rw [if_neg h]; exact (hD k).compl
  disjoint := by
    rw [Pairwise]
    intro i j hij
    by_cases hi : (i : ℕ) = 0 <;> by_cases hj : (j : ℕ) = 0
    · exact absurd (Fin.ext (by omega)) hij
    · rw [if_pos hi, if_neg hj]; exact disjoint_compl_right
    · rw [if_neg hi, if_pos hj]; exact disjoint_compl_left
    · exact absurd (Fin.ext (by omega)) hij
  cover := by
    rw [Set.eq_univ_iff_forall]
    intro x
    by_cases hx : x ∈ D k
    · refine Set.mem_iUnion.mpr ⟨0, ?_⟩
      rw [if_pos (by rfl : ((0 : Fin 2) : ℕ) = 0)]; exact hx
    · refine Set.mem_iUnion.mpr ⟨1, ?_⟩
      rw [if_neg (by decide : ¬(((1 : Fin 2) : ℕ) = 0))]; exact hx

theorem twoPart_parts (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ)
    (i : Fin (twoPart D hD k).n) :
    (twoPart D hD k).parts i = if (i : ℕ) = 0 then D k else (D k)ᶜ := rfl

theorem twoPart_parts_zero (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ) :
    (twoPart D hD k).parts (0 : Fin 2) = D k := by
  rw [twoPart_parts]
  exact if_pos (by rfl : ((0 : Fin 2) : ℕ) = 0)

theorem twoPart_frontier (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ)
    (i : Fin (twoPart D hD k).n) :
    frontier ((twoPart D hD k).parts i) = frontier (D k) := by
  rw [twoPart_parts]
  by_cases h : (i : ℕ) = 0
  · rw [if_pos h]
  · rw [if_neg h, frontier_compl]

theorem twoPart_partSigma_le (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ) :
    partSigma (twoPart D hD k) ≤ MeasurableSpace.generateFrom (Set.range D) := by
  rw [partSigma]
  refine MeasurableSpace.generateFrom_le ?_
  rintro s ⟨i, rfl⟩
  rw [twoPart_parts]
  by_cases h : (i : ℕ) = 0
  · rw [if_pos h]; exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self k)
  · rw [if_neg h]; exact (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self k)).compl

theorem twoPart_mem_partSigma (D : ℕ → Set X) (hD : ∀ n, MeasurableSet (D n)) (k : ℕ) :
    MeasurableSet[partSigma (twoPart D hD k)] (D k) := by
  rw [partSigma, ← twoPart_parts_zero D hD k]
  exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (0 : Fin 2))

/-- `joinPart__USCBasic` with the index type written as `Fin ((joinPart__USCBasic P Q).n)`. -/
theorem joinParts (P Q : FinPart X) (k : Fin (joinPart__USCBasic P Q).n) :
    (joinPart__USCBasic P Q).parts k = P.parts (finProdFinEquiv.symm k).1
      ∩ Q.parts (finProdFinEquiv.symm k).2 :=
  joinPart_parts__USCBasic P Q k

/-- **From a countable null-frontier basis to a refining generating sequence of partitions.** -/
theorem ofBase [SecondCountableTopology X] (μ : Measure X) (D : ℕ → Set X)
    (hDmeas : ∀ n, MeasurableSet (D n))
    (hDfront : ∀ n, μ (frontier (D n)) = 0)
    (hsmall : ∀ x : X, ∀ V : Set X, IsOpen V → x ∈ V → ∃ n, x ∈ D n ∧ D n ⊆ V) :
    ∃ P : ℕ → FinPart X, (∀ m, Refines (P (m + 1)) (P m)) ∧
      (∀ m i, μ (frontier ((P m).parts i)) = 0) ∧
      (⨆ m, partSigma (P m)) = borel X := by
  let P : ℕ → FinPart X := fun m =>
    Nat.rec (twoPart D hDmeas 0) (fun k ih => joinPart__USCBasic ih (twoPart D hDmeas (k + 1))) m
  have hfront_two : ∀ k i, μ (frontier ((twoPart D hDmeas k).parts i)) = 0 := by
    intro k i; rw [twoPart_frontier]; exact hDfront k
  have hpart : ∀ k, partSigma (twoPart D hDmeas k) ≤ partSigma (P k) := by
    intro k
    induction k with
    | zero =>
        show partSigma (twoPart D hDmeas 0) ≤ partSigma (twoPart D hDmeas 0)
        exact le_rfl
    | succ k ih =>
        show partSigma (twoPart D hDmeas (k + 1))
          ≤ partSigma (joinPart__USCBasic (P k) (twoPart D hDmeas (k + 1)))
        rw [partSigma_joinPart]
        exact le_sup_right
  have hle_gen : ∀ m, partSigma (P m) ≤ MeasurableSpace.generateFrom (Set.range D) := by
    intro m
    induction m with
    | zero => exact twoPart_partSigma_le D hDmeas 0
    | succ m ih =>
        show partSigma (joinPart__USCBasic (P m) (twoPart D hDmeas (m + 1)))
          ≤ MeasurableSpace.generateFrom (Set.range D)
        rw [partSigma_joinPart]
        exact sup_le ih (twoPart_partSigma_le D hDmeas (m + 1))
  have hborel : ∀ m, partSigma (P m) ≤ borel X := by
    intro m
    exact le_trans (hle_gen m) (MeasurableSpace.generateFrom_le fun s hs => by
      obtain ⟨k, rfl⟩ := hs
      have hk := hDmeas k
      rwa [BorelSpace.measurable_eq (α := X)] at hk)
  refine ⟨P, ?_, ?_, ?_⟩
  · intro m
    show Refines (joinPart__USCBasic (P m) (twoPart D hDmeas (m + 1))) (P m)
    exact Refines_joinPart_left _ _
  · intro m
    induction m with
    | zero =>
        intro i
        show μ (frontier ((twoPart D hDmeas 0).parts i)) = 0
        exact hfront_two 0 i
    | succ m ih =>
        intro i
        show μ (frontier ((joinPart__USCBasic (P m) (twoPart D hDmeas (m + 1))).parts i)) = 0
        rw [joinParts]
        set a := (finProdFinEquiv.symm i).1 with ha
        set b := (finProdFinEquiv.symm i).2 with hb
        have hsub : frontier ((P m).parts a ∩ (twoPart D hDmeas (m + 1)).parts b)
            ⊆ frontier ((P m).parts a) ∪ frontier ((twoPart D hDmeas (m + 1)).parts b) :=
          frontier_inter_subset_union _ _
        refine le_antisymm ?_ (by simp)
        calc μ (frontier ((P m).parts a ∩ (twoPart D hDmeas (m + 1)).parts b))
            ≤ μ (frontier ((P m).parts a)
                ∪ frontier ((twoPart D hDmeas (m + 1)).parts b)) := measure_mono hsub
          _ ≤ μ (frontier ((P m).parts a))
              + μ (frontier ((twoPart D hDmeas (m + 1)).parts b)) := measure_union_le _ _
          _ = 0 := by rw [ih a, hfront_two (m + 1) b, add_zero]
  · have hfk : ∀ k, MeasurableSet[⨆ m, partSigma (P m)] (D k) := by
      intro k
      exact le_trans (hpart k) (le_iSup (fun m => partSigma (P m)) k)
        (D k) (twoPart_mem_partSigma D hDmeas k)
    refine Work.EKLC6Core.borel_eq_of_countable_small_sets (iSup_le hborel) (Set.range D)
      (Set.countable_range D) ?_ ?_
    · rintro E ⟨k, rfl⟩
      exact hfk k
    · intro x V hV hxV
      obtain ⟨n, h1, h2⟩ := hsmall x V hV hxV
      exact ⟨D n, ⟨n, rfl⟩, h1, h2⟩

end PSeq

theorem exists_part_seq (μ : MeasureTheory.Measure Work.EKLContract.X3) [MeasureTheory.IsProbabilityMeasure μ] : ∃ P : ℕ → Work.EKLContract.FinPart Work.EKLContract.X3, (∀ m, Work.EKLContract.Refines (P (m + 1)) (P m)) ∧ (∀ m i, μ (frontier ((P m).parts i)) = 0) ∧ (⨆ m, Work.EKLContract.partSigma (P m)) = borel Work.EKLContract.X3 := by
  have hX3 := Work.EKLComp.X3Background
  haveI : SecondCountableTopology X3 := hX3.2.2.1
  haveI : PolishSpace X3 := hX3.2.2.2.1
  haveI : TopologicalSpace.PseudoMetrizableSpace X3 := inferInstance
  obtain ⟨D, hDmeas, hDfront, hsmall⟩ := PSeq.nullFrontierBase μ
  exact PSeq.ofBase μ D hDmeas hDfront hsmall

end Work.EKLComp
