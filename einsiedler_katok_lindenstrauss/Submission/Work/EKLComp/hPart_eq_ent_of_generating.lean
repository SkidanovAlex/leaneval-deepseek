/-!
# The Kolmogorov–Sinai theorem for a generating partition (typed at `Type*`)

Main result: if `T` is measure preserving, `Tinv` a left inverse of `T`, and the finite measurable
partition `P` generates the σ-algebra in the sense
`⨆ n, comap (Tinv^[n]) (partSigma P) = mX`, then `P` computes the entropy:
`ofReal (hPart μ T P) = ent μ T`.

The mathematical content is the classical Kolmogorov–Sinai generating theorem, applied to the
*inverse* `Tinv` (for which the hypothesis is literally the classical generating hypothesis), plus
the invariance of `hPart`/`ent` under passing to a left inverse
(`Work.EKLComp.hPart_eq_of_leftInverse`).

## The generating theorem for a single partition

For a measure preserving `S`, a finite partition `P` with `⨆ k, comap (S^[k]) (partSigma P) = mX`
computes the entropy (`ofReal_hPart_eq_ent_of_generating_single`).  The proof is the standard
conditional-entropy argument:

* `h_μ(S,Q) ≤ h_μ(S, P ∨ Q)` for every finite `Q` (refinement);
* the Kolmogorov–Sinai identity `h_μ(S,R) = H_μ(R | past of R)` for `R = P ∨ Q`
  (`Work.EKLComp.hPart_eq_Hcond_past`);
* the chain rule `H_μ(P ∨ Q | m) = H_μ(P | m) + H_μ(Q | m ∨ σ(P))` and monotonicity of
  `H_μ(· | ·)` in the conditioning σ-algebra, giving
  `h_μ(S,Q) ≤ h_μ(S,P) + H_μ(Q | 𝓒)` with `𝓒 ⊇ ⨆ n, comap (S^n) (partSigma P) = mX`;
* `H_μ(Q | mX) ≤ 0`, since the atoms of `Q` are `mX`-measurable.

`Measurable Tinv` is a by-product of the generating hypothesis, and then `Tinv` is automatically
measure preserving because `T ⁻¹' (Tinv ⁻¹' s) = s` exactly.
-/

open MeasureTheory Filter Topology
open scoped ENNReal BigOperators

noncomputable section

set_option maxHeartbeats 1000000

namespace Work.EKLComp

open Work.EKLContract
open Work.EKLComp.Core

variable {X : Type*} [mX : MeasurableSpace X]

/-! ## 1. The σ-algebra of the binary join -/

/-- The σ-algebra generated by `joinTwo P Q` is the join of the two σ-algebras. -/
theorem partSigma_joinTwo (P Q : FinPart X) :
    partSigma (joinTwo P Q) = partSigma P ⊔ partSigma Q := by
  refine le_antisymm ?_ ?_
  · rw [partSigma]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨k, rfl⟩
    have hk : (joinTwo P Q).parts k
        = P.parts (finProdFinEquiv.symm k).1 ∩ Q.parts (finProdFinEquiv.symm k).2 :=
      joinTwo_parts_symm P Q k
    rw [hk]
    exact MeasurableSet.inter
      ((MeasurableSpace.le_def.mp le_sup_left) _
        (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self _)))
      ((MeasurableSpace.le_def.mp le_sup_right) _
        (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self _)))
  · refine sup_le ?_ ?_
    · rw [partSigma]
      refine MeasurableSpace.generateFrom_le ?_
      rintro s ⟨i, rfl⟩
      have hunion : P.parts i = ⋃ j : Fin Q.n, (joinTwo P Q).parts (finProdFinEquiv (i, j)) := by
        ext x
        constructor
        · intro hx
          have hc : x ∈ ⋃ j : Fin Q.n, Q.parts j := by rw [Q.cover]; exact trivial
          obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hc
          exact Set.mem_iUnion.mpr ⟨j, by rw [joinTwo_parts]; exact ⟨hx, hj⟩⟩
        · intro hx
          obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hx
          rw [joinTwo_parts] at hj
          exact hj.1
      rw [hunion]
      exact MeasurableSet.iUnion fun j =>
        MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (finProdFinEquiv (i, j)))
    · rw [partSigma]
      refine MeasurableSpace.generateFrom_le ?_
      rintro s ⟨j, rfl⟩
      have hunion : Q.parts j = ⋃ i : Fin P.n, (joinTwo P Q).parts (finProdFinEquiv (i, j)) := by
        ext x
        constructor
        · intro hx
          have hc : x ∈ ⋃ i : Fin P.n, P.parts i := by rw [P.cover]; exact trivial
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hc
          exact Set.mem_iUnion.mpr ⟨i, by rw [joinTwo_parts]; exact ⟨hi, hx⟩⟩
        · intro hx
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
          rw [joinTwo_parts] at hi
          exact hi.2
      rw [hunion]
      exact MeasurableSet.iUnion fun i =>
        MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self (finProdFinEquiv (i, j)))

theorem refines_joinTwo_right (P Q : FinPart X) : Refines (joinTwo P Q) Q := by
  intro k
  exact ⟨(finProdFinEquiv.symm k).2, Set.inter_subset_right⟩

/-! ## 2. `hPart` is monotone under refinement -/

theorem hPart_le_of_refines' (μ : Measure X) [IsProbabilityMeasure μ] {T : X → X}
    (hT : Measurable T) {P R : FinPart X} (h : Refines R P) : hPart μ T P ≤ hPart μ T R := by
  rw [hPart, hPart]
  refine le_ciInf fun N => ?_
  have h1 := Core.hPart_le_avg μ T P N
  have h2 : Hfam μ (joinSets T P (N + 1)) ≤ Hfam μ (joinSets T R (N + 1)) := by
    choose g hg using h
    refine Core.Hfam_mono μ (Core.joinSets_isMPart hT P (N + 1))
      (Core.joinSets_isMPart hT R (N + 1))
      (fun w : Fin (N + 1) → Fin R.n => fun k => g (w k)) ?_
    intro w x hx
    simp only [joinSets, Set.mem_iInter, Set.mem_preimage] at hx ⊢
    intro k
    exact hg (w k) (hx k)
  calc hPart μ T P ≤ Hfam μ (joinSets T P (N + 1)) / ((N : ℝ) + 1) := h1
    _ ≤ Hfam μ (joinSets T R (N + 1)) / ((N : ℝ) + 1) :=
        div_le_div_of_nonneg_right h2 (by positivity)

/-! ## 3. `Hcond` against the full σ-algebra is non-positive -/

/-- The diagonal Shannon sum: for a partition `A`, the entropy of the product family `A × A`
equals the entropy of `A`. -/
theorem Hfam_prod_diag (μ : Measure X) [IsProbabilityMeasure μ] {ι : Type*} [Fintype ι]
    {A : ι → Set X} (hA : IsMPart A) :
    Hfam μ (fun p : ι × ι => A p.1 ∩ A p.2) = Hfam μ A := by
  rw [Hfam, Hfam, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Finset.sum_eq_single i]
  · rw [Set.inter_self]
  · intro j _ hji
    have hdisj : A i ∩ A j = ∅ :=
      Set.disjoint_iff_inter_eq_empty.mp (hA.disjoint (Ne.symm hji))
    rw [hdisj, measure_empty, ENNReal.toReal_zero, Real.negMulLog_zero]
  · intro h; exact absurd (Finset.mem_univ i) h

theorem isMPart_parts' (P : FinPart X) : IsMPart P.parts :=
  ⟨P.measurable, P.disjoint, P.cover⟩

theorem Hcond_partSigma_eq_zero (μ : Measure X) [IsProbabilityMeasure μ] (Q : FinPart X) :
    @Hcond X mX μ Q (partSigma Q) = 0 := by
  have hQ := isMPart_parts' Q
  have h1 : @Hcond X mX μ Q (partSigma Q)
      = HcondFam X μ Q.parts (partSigmaFam Q.parts) :=
    (HcondFam_eq_Hcond μ Q (partSigma Q)).symm
  rw [h1, Work.EKLC6Core.HcondFam_partSigmaFam (mX := mX) μ Q.parts Q.parts hQ hQ,
    Hfam_prod_diag μ hQ]
  ring

theorem Hcond_top_le_zero (μ : Measure X) [IsProbabilityMeasure μ] (Q : FinPart X) :
    @Hcond X mX μ Q mX ≤ 0 := by
  have hle : partSigma Q ≤ mX := by
    rw [partSigma]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨i, rfl⟩
    exact Q.measurable i
  have h := Work.EKLC6Core.Hcond_mono μ Q (partSigma Q) mX hle
  rw [Hcond_partSigma_eq_zero μ Q] at h
  exact h

/-! ## 4. The chain-rule bound -/

/-- **The chain-rule bound.**  `h_μ(T,Q) ≤ h_μ(T,P) + H_μ(Q | 𝓒)`, where `𝓒` contains the
σ-algebra generated by all the pullbacks of `P`. -/
theorem hPart_le_hPart_add_Hcond (μ : Measure X) [IsProbabilityMeasure μ] {T : X → X}
    (hmp : MeasurePreserving T μ μ) (P Q : FinPart X) :
    hPart μ T Q ≤ hPart μ T P
      + @Hcond X mX μ Q ((⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q)))
          ⊔ partSigma P) := by
  have hT : Measurable T := hmp.measurable
  have h1 : hPart μ T Q ≤ hPart μ T (joinTwo P Q) :=
    hPart_le_of_refines' μ hT (refines_joinTwo_right P Q)
  have h2 : hPart μ T (joinTwo P Q)
      = @Hcond X mX μ (joinTwo P Q)
          (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) :=
    hPart_eq_Hcond_past μ hmp (joinTwo P Q)
  have h3 : @Hcond X mX μ (joinTwo P Q)
        (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q)))
      = @Hcond X mX μ P (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q)))
        + @Hcond X mX μ Q
            ((⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) ⊔ partSigma P) :=
    Hcond_joinTwo μ P Q _
  have hle : (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma P))
      ≤ (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) := by
    refine iSup_le fun n => ?_
    have hpart : partSigma P ≤ partSigma (joinTwo P Q) := by
      rw [partSigma_joinTwo]; exact le_sup_left
    exact le_trans (MeasurableSpace.comap_mono hpart)
      (le_iSup (fun n : ℕ => MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) n)
  have hmonoP : @Hcond X mX μ P
        (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) ≤ hPart μ T P := by
    have h := Work.EKLC6Core.Hcond_mono μ P
      (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma P))
      (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) hle
    rwa [← hPart_eq_Hcond_past μ hmp P] at h
  calc hPart μ T Q ≤ hPart μ T (joinTwo P Q) := h1
    _ = @Hcond X mX μ (joinTwo P Q)
          (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) := h2
    _ = @Hcond X mX μ P (⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q)))
        + @Hcond X mX μ Q
            ((⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) ⊔ partSigma P) := h3
    _ ≤ hPart μ T P
        + @Hcond X mX μ Q
            ((⨆ n : ℕ, MeasurableSpace.comap (T^[n+1]) (partSigma (joinTwo P Q))) ⊔ partSigma P) :=
        add_le_add hmonoP le_rfl

/-! ## 5. The generating theorem for a single partition -/

theorem ofReal_hPart_eq_ent_of_generating_single (μ : Measure X) [IsProbabilityMeasure μ]
    {S : X → X} (hmp : MeasurePreserving S μ μ) (P : FinPart X)
    (hgen : (⨆ k : ℕ, MeasurableSpace.comap (S^[k]) (partSigma P)) = mX) :
    ENNReal.ofReal (hPart μ S P) = ent μ S := by
  refine le_antisymm ?_ ?_
  · exact le_iSup (fun Q : FinPart X => ENNReal.ofReal (hPart μ S Q)) P
  · refine iSup_le fun Q => ?_
    have hb := hPart_le_hPart_add_Hcond μ hmp P Q
    -- the conditioning σ-algebra contains `mX`
    have hGD : (⨆ k : ℕ, MeasurableSpace.comap (S^[k]) (partSigma P))
        ≤ (⨆ n : ℕ, MeasurableSpace.comap (S^[n+1]) (partSigma (joinTwo P Q))) ⊔ partSigma P := by
      refine iSup_le fun k => ?_
      rcases Nat.eq_zero_or_pos k with hk | hk
      · subst hk
        simp only [Function.iterate_zero, MeasurableSpace.comap_id]
        exact le_sup_right
      · obtain ⟨m, rfl⟩ : ∃ m, k = m + 1 := ⟨k - 1, by omega⟩
        have hpart : partSigma P ≤ partSigma (joinTwo P Q) := by
          rw [partSigma_joinTwo]; exact le_sup_left
        exact le_trans (MeasurableSpace.comap_mono hpart)
          (le_trans (le_iSup (fun n : ℕ =>
            MeasurableSpace.comap (S^[n+1]) (partSigma (joinTwo P Q))) m) le_sup_left)
    have hc : mX ≤ (⨆ n : ℕ, MeasurableSpace.comap (S^[n+1]) (partSigma (joinTwo P Q)))
        ⊔ partSigma P := hgen.symm.trans_le hGD
    have hzero : @Hcond X mX μ Q ((⨆ n : ℕ, MeasurableSpace.comap (S^[n+1])
        (partSigma (joinTwo P Q))) ⊔ partSigma P) ≤ 0 :=
      le_trans (Work.EKLC6Core.Hcond_mono μ Q mX _ hc) (Hcond_top_le_zero μ Q)
    exact ENNReal.ofReal_le_ofReal (by linarith)

/-! ## 6. Measurability and measure preservation of the left inverse -/

theorem measurable_of_generating_comap (Tinv : X → X) (P : FinPart X)
    (hgen : (⨆ n : ℕ, MeasurableSpace.comap (Tinv^[n]) (partSigma P)) = mX) :
    Measurable Tinv := by
  rw [measurable_iff_comap_le, ← hgen, MeasurableSpace.comap_iSup]
  refine iSup_le fun n => ?_
  rw [MeasurableSpace.comap_comp]
  exact le_iSup (fun n => MeasurableSpace.comap (Tinv^[n]) (partSigma P)) (n + 1)

theorem measurePreserving_leftInverse (μ : Measure X) {T Tinv : X → X}
    (hmp : MeasurePreserving T μ μ) (hmeas : Measurable Tinv) (hinv : Function.LeftInverse Tinv T) :
    MeasurePreserving Tinv μ μ := by
  refine ⟨hmeas, ?_⟩
  ext s hs
  rw [Measure.map_apply hmeas hs]
  have h1 : T ⁻¹' (Tinv ⁻¹' s) = s := by
    ext x
    rw [Set.mem_preimage, Set.mem_preimage, hinv x]
  exact (hmp.measure_preimage (hmeas hs).nullMeasurableSet).symm.trans (by rw [h1])

/-! ## 7. `ent` is invariant under a left inverse -/

theorem ent_eq_of_leftInverse (μ : Measure X) [IsProbabilityMeasure μ] {T S : X → X}
    (hmp : MeasurePreserving T μ μ) (hS : Measurable S) (hl : Function.LeftInverse S T) :
    ent μ S = ent μ T :=
  iSup_congr fun Q => by rw [hPart_eq_of_leftInverse μ hmp hS hl Q]

/-! ## 8. The main theorem -/

theorem hPart_eq_ent_of_generating {X : Type*} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X)
    [MeasureTheory.IsProbabilityMeasure μ] (T Tinv : X → X)
    (hinv : Function.LeftInverse Tinv T)
    (hmp : MeasureTheory.MeasurePreserving T μ μ) (P : @Work.EKLContract.FinPart X mX)
    (hgen : (⨆ n : ℕ, MeasurableSpace.comap (Tinv^[n]) (@Work.EKLContract.partSigma X mX P)) = mX) :
    ENNReal.ofReal (@Work.EKLContract.hPart X mX μ T P) = @Work.EKLContract.ent X mX μ T := by
  have hTinv : Measurable Tinv := measurable_of_generating_comap Tinv P hgen
  have hTinv_mp : MeasurePreserving Tinv μ μ := measurePreserving_leftInverse μ hmp hTinv hinv
  have h1 : ENNReal.ofReal (hPart μ Tinv P) = ent μ Tinv :=
    ofReal_hPart_eq_ent_of_generating_single μ hTinv_mp P hgen
  have h2 : hPart μ Tinv P = hPart μ T P := hPart_eq_of_leftInverse μ hmp hTinv hinv P
  have h3 : ent μ Tinv = ent μ T := ent_eq_of_leftInverse μ hmp hTinv hinv
  exact (congrArg ENNReal.ofReal h2.symm).trans (h1.trans h3)

end Work.EKLComp
