import Mathlib
import Submission.Work.EKLComp.Core

/-!
# `JacRefiningGenSeq` — a refining sequence of finite partitions generating `mX`

For a standard Borel space `X`, there is a sequence of finite measurable partitions
`P 0, P 1, …` with `P (n+1)` refining `P n` and `⨆ n, partSigma (P n) = mX`.

The proof is in two layers.

* `exists_generating_sequence` : a standard Borel space is countably generated, so there is a
  sequence `f : ℕ → Set X` of measurable sets with `generateFrom (range f) = mX`.
* For such an `f`, the membership partitions `memPartition f n` (Mathlib's
  `Data/Set/MemPartition`) are finite, measurable, refining partitions whose generating
  σ-algebras increase to `generateFrom (range f)`.  We package each of them as a
  `Work.EKLContract.FinPart` via `finPartOf`.
-/

open MeasureTheory

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

variable {X : Type*} [mX : MeasurableSpace X]

/-! ## 1. `FinPart` from a finite measurable partition -/

/-- A finite family `c` of sets, enumerated as a `Fin`-indexed family. -/
noncomputable abbrev finEnum (c : Set (Set X)) [Fintype c] : Fin (Fintype.card c) → Set X :=
  fun i => ((Fintype.equivFin c).symm i : Set X)

theorem finEnum_mem (c : Set (Set X)) [Fintype c] (i : Fin (Fintype.card c)) :
    finEnum c i ∈ c :=
  ((Fintype.equivFin c).symm i).2

theorem exists_finEnum_eq (c : Set (Set X)) [Fintype c] {u : Set X} (hu : u ∈ c) :
    ∃ i, finEnum c i = u := by
  refine ⟨Fintype.equivFin c ⟨u, hu⟩, ?_⟩
  show ((Fintype.equivFin c).symm (Fintype.equivFin c ⟨u, hu⟩) : Set X) = u
  rw [Equiv.symm_apply_apply]

/-- The range of the enumeration `finEnum c` is `c`. -/
theorem range_finEnum (c : Set (Set X)) [Fintype c] : Set.range (finEnum c) = c := by
  ext u
  constructor
  · rintro ⟨i, rfl⟩
    exact finEnum_mem c i
  · intro hu
    exact exists_finEnum_eq c hu

/-- Build a finite partition (as a `FinPart`) out of a finite family of measurable, pairwise
disjoint sets covering `X`. -/
noncomputable abbrev finPartOf (c : Set (Set X)) [Fintype c]
    (hmeas : ∀ s ∈ c, MeasurableSet s)
    (hdisj : ∀ s ∈ c, ∀ t ∈ c, s ≠ t → Disjoint s t)
    (hcov : ⋃₀ c = Set.univ) : FinPart X where
  n := Fintype.card c
  parts := finEnum c
  measurable := fun i => hmeas _ (finEnum_mem c i)
  disjoint := by
    intro i j hij
    refine hdisj (finEnum c i) (finEnum_mem c i) (finEnum c j) (finEnum_mem c j) (fun h => hij ?_)
    exact (Fintype.equivFin c).symm.injective (Subtype.ext h)
  cover := by
    rw [Set.eq_univ_iff_forall]
    intro x
    rw [Set.mem_iUnion]
    have hx : x ∈ ⋃₀ c := by rw [hcov]; exact Set.mem_univ x
    obtain ⟨s, hs, hxs⟩ := Set.mem_sUnion.mp hx
    obtain ⟨i, hi⟩ := exists_finEnum_eq c hs
    exact ⟨i, by rw [hi]; exact hxs⟩

@[simp]
theorem finPartOf_n (c : Set (Set X)) [Fintype c] (hmeas hdisj hcov) :
    (finPartOf c hmeas hdisj hcov).n = Fintype.card c := rfl

theorem finPartOf_parts (c : Set (Set X)) [Fintype c] (hmeas hdisj hcov) :
    (finPartOf c hmeas hdisj hcov).parts = finEnum c := rfl

/-- The atoms of `finPartOf c …` are exactly the members of `c`. -/
theorem range_parts_finPartOf (c : Set (Set X)) [Fintype c] (hmeas hdisj hcov) :
    Set.range (finPartOf c hmeas hdisj hcov).parts = c := by
  rw [finPartOf_parts, range_finEnum]

/-- The σ-algebra generated by `finPartOf c …` is the σ-algebra generated by `c`. -/
theorem partSigma_finPartOf (c : Set (Set X)) [Fintype c] (hmeas hdisj hcov) :
    partSigma (finPartOf c hmeas hdisj hcov) = MeasurableSpace.generateFrom c := by
  rw [partSigma, range_parts_finPartOf]

/-! ## 2. The membership partitions `memPartition f n` as `FinPart`s -/

/-- The `n`-th membership partition of a sequence `f`, as a `FinPart`. -/
noncomputable abbrev memPartitionFinPart (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n))
    (n : ℕ) : FinPart X :=
  finPartOf (memPartition f n)
    (fun s hs => MeasurableSpace.measurableSet_memPartition hmeas n hs)
    (fun s hs t ht hst => disjoint_memPartition f n hs ht hst)
    (sUnion_memPartition f n)

theorem range_parts_memPartitionFinPart (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n))
    (n : ℕ) : Set.range (memPartitionFinPart f hmeas n).parts = memPartition f n :=
  range_parts_finPartOf _ _ _ _

theorem partSigma_memPartitionFinPart (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n))
    (n : ℕ) :
    partSigma (memPartitionFinPart f hmeas n) = MeasurableSpace.generateFrom (memPartition f n) :=
  partSigma_finPartOf _ _ _ _

/-- Every member of `memPartition f n` is an atom of `memPartitionFinPart f hmeas n`. -/
theorem mem_range_parts_memPartitionFinPart (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n))
    (n : ℕ) {u : Set X} (hu : u ∈ memPartition f n) :
    ∃ j, (memPartitionFinPart f hmeas n).parts j = u := by
  have h : u ∈ Set.range (memPartitionFinPart f hmeas n).parts := by
    rw [range_parts_memPartitionFinPart]
    exact hu
  exact h

/-- Each membership partition refines the previous one. -/
theorem refines_memPartitionFinPart (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n)) (n : ℕ) :
    Refines (memPartitionFinPart f hmeas (n + 1)) (memPartitionFinPart f hmeas n) := by
  intro i
  have hi : (memPartitionFinPart f hmeas (n + 1)).parts i ∈ memPartition f (n + 1) := by
    rw [← range_parts_memPartitionFinPart f hmeas (n + 1)]
    exact Set.mem_range_self i
  rw [memPartition_succ] at hi
  obtain ⟨u, hu, h_eq⟩ := hi
  obtain ⟨j, hj⟩ := mem_range_parts_memPartitionFinPart f hmeas n hu
  refine ⟨j, ?_⟩
  rcases h_eq with h_eq | h_eq
  · rw [h_eq, hj]
    exact Set.inter_subset_left
  · rw [h_eq, hj]
    exact Set.sdiff_subset

/-! ## 3. The refining sequence of a generating sequence -/

/-- A sequence of measurable sets generating `mX` yields a refining sequence of finite
partitions whose σ-algebras generate `mX`. -/
theorem exists_refining_gen_seq_of_generating (f : ℕ → Set X) (hmeas : ∀ n, MeasurableSet (f n))
    (hgen : MeasurableSpace.generateFrom (Set.range f) = mX) :
    ∃ P : ℕ → FinPart X,
      (∀ m, Refines (P (m + 1)) (P m)) ∧ (⨆ m, partSigma (P m)) = mX := by
  refine ⟨fun m => memPartitionFinPart f hmeas m, fun m => refines_memPartitionFinPart f hmeas m, ?_⟩
  have hsig : (⨆ m, partSigma (memPartitionFinPart f hmeas m))
      = ⨆ m, MeasurableSpace.generateFrom (memPartition f m) :=
    iSup_congr fun m => partSigma_memPartitionFinPart f hmeas m
  rw [hsig, MeasurableSpace.iSup_generateFrom (fun m => memPartition f m),
    MeasurableSpace.generateFrom_iUnion_memPartition f, hgen]

/-! ## 4. Standard Borel spaces are countably generated -/

/-- Every standard Borel space admits a sequence of measurable sets generating its σ-algebra. -/
theorem exists_generating_sequence (X : Type*) [mX : MeasurableSpace X] [StandardBorelSpace X] :
    ∃ f : ℕ → Set X,
      (∀ n, MeasurableSet (f n)) ∧ MeasurableSpace.generateFrom (Set.range f) = mX := by
  obtain ⟨τ, hB, hP⟩ := StandardBorelSpace.polish (α := X)
  letI : TopologicalSpace X := τ
  haveI : BorelSpace X := hB
  haveI : PolishSpace X := hP
  haveI : MeasurableSpace.CountablyGenerated X :=
    ⟨⟨TopologicalSpace.countableBasis X, TopologicalSpace.countable_countableBasis X,
        (BorelSpace.measurable_eq (α := X)).trans
          (TopologicalSpace.isBasis_countableBasis X).borel_eq_generateFrom⟩⟩
  exact ⟨MeasurableSpace.natGeneratingSequence X,
    MeasurableSpace.measurableSet_natGeneratingSequence,
    MeasurableSpace.generateFrom_natGeneratingSequence X⟩

/-! ## 5. The requested statement -/

theorem JacRefiningGenSeq {X : Type} [mX : MeasurableSpace X] [StandardBorelSpace X] :
    ∃ P : ℕ → Work.EKLContract.FinPart X,
      (∀ m, Work.EKLContract.Refines (P (m + 1)) (P m)) ∧
        (⨆ m, Work.EKLContract.partSigma (P m)) = mX := by
  obtain ⟨f, hmeas, hgen⟩ := exists_generating_sequence X
  exact exists_refining_gen_seq_of_generating f hmeas hgen

end Work.EKLComp
