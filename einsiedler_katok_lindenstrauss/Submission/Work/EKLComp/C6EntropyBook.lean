import Mathlib
import Submission.Work.EKLC6Core.towerDefs
import Submission.Work.EKLC6Core.firstReturn_partition
import Submission.Work.EKLC6Core.neverReturnSet_null
import Submission.Work.EKLC6Core.C6_tsum_entropy
import Submission.Work.EKLComp.negMulLog_sum_le_card_mul_log
import Submission.Work.EKLComp.kac_return_ineq
import Submission.Work.EKLComp.summable_level_entropy

/-!
# `Work.EKLComp.C6EntropyBook` — the entropy bookkeeping for the countable generator (Pisa 7.50/7.52)

This module provides the measure-theoretic half of the countable generator `P` of Pisa 7.43:
the *entropy* clause `∑' n, ofReal (negMulLog (μ (P n))) ≠ ⊤` for a countable partition `P` which
refines the return-time ("Kakutani tower") partition of Pisa 7.49 and whose level-`i` pieces are at
most `N i ≤ c e^{κ i}` in number.

* `retPart t Ω` is the return-time partition `Q̃` of Pisa 7.49: `Q₀ = Ωᶜ` and `Q_{i+1}` the set of
  points of `Ω` whose first return to `Ω` happens at time `i+1`
  (`Work.EKLC6Core.firstReturnSet`), with `(⋃ n, retPart t Ω n)ᶜ = neverReturnSet t Ω`
  (`compl_iUnion_retPart_eq_neverReturn`) and `μ (⋃ n, retPart t Ω n) = 1`;
* `negMulLog_sum_le_mul_log_div` is the per-level (Shannon) bound
  `∑_j negMulLog (x j) ≤ A log (n / A)`;
* `tsum_negMulLog_paired_ne_top` is Pisa 7.52: if a countable partition `D` refines a level family
  `Q` with `∑ μ(Q i) ≤ 1` and `∑ i μ(Q i) ≤ 1` (Kac) and `N i` pieces in level `i`, then the
  entropy of the refinement is finite.  The two numerical inputs are the delegated
  `Work.EKLComp.summable_level_entropy` and the Kac inequality `Work.EKLComp.kac_return_ineq`;
* `HcondSig_retPart_refinement_ne_top` is the consumer-facing form: the σ-algebra generated by such
  a refinement has finite static entropy (`Work.EKLC6Core.HcondSig_ne_top_of_tsum`).
-/

open MeasureTheory Filter Topology
open scoped ENNReal BigOperators

noncomputable section

namespace Work.EKLComp

open Work.EKLContract

/-! ## 1. The return-time partition of Pisa 7.49 -/

/-- The return-time partition `Q̃` of Pisa 7.49: the `0`-th piece is `Ωᶜ` and the `(i+1)`-th piece
is the set of points of `Ω` whose first return to `Ω` happens at time `i+1`. -/
def retPart (t : Fin 3 → ℝ) (Ω : Set X3) : ℕ → Set X3 :=
  fun n => match n with
    | 0 => Ωᶜ
    | (k + 1) => Work.EKLC6Core.firstReturnSet t Ω (k + 1)

@[simp] theorem retPart_zero (t : Fin 3 → ℝ) (Ω : Set X3) : retPart t Ω 0 = Ωᶜ := rfl

@[simp] theorem retPart_succ (t : Fin 3 → ℝ) (Ω : Set X3) (k : ℕ) :
    retPart t Ω (k + 1) = Work.EKLC6Core.firstReturnSet t Ω (k + 1) := rfl

theorem measurableSet_retPart {t : Fin 3 → ℝ} {Ω : Set X3} (hΩ : MeasurableSet Ω) (n : ℕ) :
    MeasurableSet (retPart t Ω n) := by
  rcases n with _ | k
  · rw [retPart_zero]; exact hΩ.compl
  · rw [retPart_succ]
    exact (Work.EKLC6Core.firstReturn_partition (t := t) hΩ).1 (k + 1)

/-- Every return cell for a positive level lies in `Ω`. -/
theorem firstReturnSet_subset (t : Fin 3 → ℝ) (Ω : Set X3) (i : ℕ) :
    Work.EKLC6Core.firstReturnSet t Ω i ⊆ Ω := by
  rw [Work.EKLC6Core.firstReturnSet]
  exact Set.inter_subset_left.trans Set.inter_subset_left

theorem disjoint_retPart {t : Fin 3 → ℝ} {Ω : Set X3} (hΩ : MeasurableSet Ω) {m n : ℕ}
    (h : m ≠ n) : Disjoint (retPart t Ω m) (retPart t Ω n) := by
  rcases m with _ | k <;> rcases n with _ | l
  · exact absurd rfl h
  · rw [retPart_zero, retPart_succ]
    exact Set.disjoint_compl_left_iff_subset.mpr (firstReturnSet_subset t Ω (l + 1))
  · rw [retPart_succ, retPart_zero]
    exact (Set.disjoint_compl_left_iff_subset.mpr (firstReturnSet_subset t Ω (k + 1))).symm
  · rw [retPart_succ, retPart_succ]
    exact (Work.EKLC6Core.firstReturn_partition (t := t) hΩ).2.2.1 (k + 1) (l + 1)
      (by omega) (by omega) (by omega)

/-- The complement of the union of the return-time partition is the never-returning set. -/
theorem compl_iUnion_retPart_eq_neverReturn {t : Fin 3 → ℝ} {Ω : Set X3}
    (hΩ : MeasurableSet Ω) :
    (⋃ n, retPart t Ω n)ᶜ = Work.EKLC6Core.neverReturnSet t Ω := by
  classical
  have hchar := (Work.EKLC6Core.firstReturn_partition (t := t) hΩ).2.2.2.2.1
  have hnever := (Work.EKLC6Core.firstReturn_partition (t := t) hΩ).2.2.2.2.2
  ext z
  constructor
  · intro hz
    have hzΩ : z ∈ Ω := by
      by_contra h
      exact hz (Set.mem_iUnion.mpr ⟨0, by rw [retPart_zero]; exact h⟩)
    have hnot : ∀ j : ℕ, 1 ≤ j →
        ((fun y : X3 => aDiag t • y)^[j]) z ∉ Ω := by
      intro j hj hmem
      have hex : ∃ m : ℕ, 1 ≤ m ∧ ((fun y : X3 => aDiag t • y)^[m]) z ∈ Ω :=
        ⟨j, hj, hmem⟩
      set m₀ := Nat.find hex with hm₀
      have hm₀1 : 1 ≤ m₀ := (Nat.find_spec hex).1
      have hm₀mem : ((fun y : X3 => aDiag t • y)^[m₀]) z ∈ Ω := (Nat.find_spec hex).2
      have hmin : ∀ j' : ℕ, 1 ≤ j' → j' < m₀ →
          ((fun y : X3 => aDiag t • y)^[j']) z ∉ Ω := by
        intro j' hj' hlt hmem'
        exact Nat.find_min hex hlt ⟨hj', hmem'⟩
      have hmemQ : z ∈ retPart t Ω m₀ := by
        obtain ⟨k', hk'⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hm₀1)
        rw [hk', retPart_succ, hchar (k' + 1) (by omega)]
        exact ⟨hzΩ, by simpa only [hk'] using hm₀mem,
          fun j'' hj'' hlt => hmin j'' hj'' (by omega)⟩
      exact hz (Set.mem_iUnion.mpr ⟨m₀, hmemQ⟩)
    rw [hnever]
    exact ⟨hzΩ, fun j hj => hnot j hj⟩
  · intro hz
    rw [hnever] at hz
    obtain ⟨hzΩ, hzall⟩ := hz
    intro hcon
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hcon
    rcases n with _ | k
    · rw [retPart_zero] at hn
      exact hn hzΩ
    · rw [retPart_succ, hchar (k + 1) (by omega)] at hn
      obtain ⟨-, hφ, -⟩ := hn
      exact hzall (k + 1) (by omega) hφ

/-- The return-time partition covers `X₃` modulo `μ`. -/
theorem measure_iUnion_retPart {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω) :
    μ (⋃ n, retPart t Ω n) = 1 := by
  have hnull : μ ((⋃ n, retPart t Ω n)ᶜ) = 0 := by
    rw [compl_iUnion_retPart_eq_neverReturn hΩ]
    exact Work.EKLC6Core.neverReturnSet_null (μ := μ) hmp hΩ
  have hmeas : MeasurableSet (⋃ n, retPart t Ω n) :=
    MeasurableSet.iUnion fun n => measurableSet_retPart hΩ n
  have hfin : μ (⋃ n, retPart t Ω n) ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.one_ne_top
      (le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
        (le_of_eq MeasureTheory.measure_univ))
  have hcompl := MeasureTheory.measure_compl hmeas hfin
  rw [hnull] at hcompl
  have hle : μ (⋃ n, retPart t Ω n) ≤ 1 :=
    le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
      (le_of_eq MeasureTheory.measure_univ)
  have hge : (1 : ℝ≥0∞) ≤ μ (⋃ n, retPart t Ω n) :=
    tsub_eq_zero_iff_le.mp (by simpa using hcompl.symm)
  exact le_antisymm hle hge

/-- The return-time partition is a countable measurable partition of a conull set. -/
theorem tsum_measure_retPart {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω) :
    (∑' i : ℕ, μ (retPart t Ω i)) = 1 := by
  rw [← measure_iUnion_retPart (μ := μ) hmp hΩ]
  exact (MeasureTheory.measure_iUnion (fun i j hij => disjoint_retPart hΩ hij)
    (fun i => measurableSet_retPart hΩ i)).symm

/-- The level masses of the return-time partition are summable with total at most `1`. -/
theorem tsum_ofReal_measure_retPart_le_one {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω) :
    (∑' i : ℕ, ENNReal.ofReal ((μ (retPart t Ω i)).toReal)) ≤ 1 := by
  have hne : ∀ i : ℕ, μ (retPart t Ω i) ≠ ⊤ := fun i =>
    ne_top_of_le_ne_top ENNReal.one_ne_top
      (le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
        (le_of_eq MeasureTheory.measure_univ))
  rw [← tsum_measure_retPart (μ := μ) hmp hΩ]
  exact le_of_eq (tsum_congr fun i => ENNReal.ofReal_toReal (hne i))

/-- **Kac's inequality for the return-time partition.** -/
theorem tsum_ofReal_mul_measure_retPart_le_one {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω) :
    (∑' i : ℕ, ENNReal.ofReal ((i : ℝ) * (μ (retPart t Ω i)).toReal)) ≤ 1 := by
  refine le_trans (le_of_eq (tsum_congr fun i => ?_))
    (Work.EKLComp.kac_return_ineq (μ := μ) hmp hΩ).1
  rcases i with _ | k
  · rw [retPart_zero]; simp
  · rw [retPart_succ]

/-! ## 2. The per-level Shannon bound -/

/-- **The per-level entropy bound (Shannon).**  For a sub-probability vector `x : Fin n → ℝ`
(`0 ≤ x j`), `∑_j negMulLog (x j) ≤ A · log (n / A)` where `A = ∑_j x j`; both sides vanish for
`n = 0` resp. `A = 0` (with the conventions `x/0 = 0` and `log 0 = 0`). -/
theorem negMulLog_sum_le_mul_log_div {n : ℕ} (x : Fin n → ℝ) (hx : ∀ j, 0 ≤ x j) :
    ∑ j, Real.negMulLog (x j)
      ≤ (∑ j, x j) * Real.log ((n : ℝ) / (∑ j, x j)) := by
  rcases Nat.eq_zero_or_pos n with hn | hn
  · subst hn
    simp
  · have hne : (Finset.univ : Finset (Fin n)).Nonempty := ⟨⟨0, hn⟩, Finset.mem_univ _⟩
    have h := Work.EKLComp.negMulLog_sum_le_card_mul_log (s := Finset.univ) hne x
      (fun i _ => hx i)
    simpa using h

/-! ## 3. The entropy of a refinement of a level family (Pisa 7.52) -/

/-- **Pisa 7.52.**  Let `Q` be a level family with `∑_i μ(Q i) ≤ 1` and `∑_i i μ(Q i) ≤ 1` (the
latter is Kac's inequality), and let the sets `D i j` (`0 ≤ j < N i`) partition `Q i`, be pairwise
disjoint, measurable, and vanish for `j ≥ N i`.  If `N i ≤ c e^{κ i}` for `c ≥ 0`, `κ ≥ 0`, then
the entropy of the enumeration `n ↦ D (Nat.unpair n).1 (Nat.unpair n).2` is finite. -/
theorem tsum_negMulLog_paired_ne_top {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (Q : ℕ → Set X3)
    (hQmass : (∑' i : ℕ, ENNReal.ofReal ((μ (Q i)).toReal)) ≤ 1)
    (hQkac : (∑' i : ℕ, ENNReal.ofReal ((i : ℝ) * (μ (Q i)).toReal)) ≤ 1)
    (D : ℕ → ℕ → Set X3) (hDmeas : ∀ i j, MeasurableSet (D i j))
    (hDdisj : ∀ i j i' j', (i, j) ≠ (i', j') → Disjoint (D i j) (D i' j'))
    (hDcov : ∀ i, (⋃ j, D i j) = Q i)
    (N : ℕ → ℕ) (hN1 : ∀ i, 1 ≤ N i) (hDempty : ∀ i j, N i ≤ j → D i j = ∅)
    (c κ : ℝ) (hc : 0 ≤ c) (hκ : 0 ≤ κ)
    (hN : ∀ i, (N i : ℝ) ≤ c * Real.exp (κ * (i : ℝ))) :
    (∑' n : ℕ, ENNReal.ofReal (Real.negMulLog
      ((μ (D (Nat.unpair n).1 (Nat.unpair n).2)).toReal))) ≠ ⊤ := by
  classical
  set A : ℕ → ℝ := fun i => (μ (Q i)).toReal with hA
  have hA0 : ∀ i, 0 ≤ A i := fun i => ENNReal.toReal_nonneg
  have hA1 : ∀ i, A i ≤ 1 := by
    intro i
    have h1 : μ (Q i) ≤ 1 :=
      le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
        (le_of_eq MeasureTheory.measure_univ)
    rw [hA]
    calc (μ (Q i)).toReal ≤ (1 : ℝ≥0∞).toReal := ENNReal.toReal_mono ENNReal.one_ne_top h1
      _ = 1 := by simp
  -- the per-level bound
  have hlevel : ∀ i : ℕ, (∑' j : ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D i j)).toReal)))
      ≤ ENNReal.ofReal (A i * Real.log ((N i : ℝ) / A i)) := by
    intro i
    have hz : ∀ j : ℕ, N i ≤ j →
        ENNReal.ofReal (Real.negMulLog ((μ (D i j)).toReal)) = 0 := by
      intro j hj
      rw [hDempty i j hj, MeasureTheory.measure_empty, ENNReal.toReal_zero,
        Real.negMulLog_zero, ENNReal.ofReal_zero]
    rw [tsum_eq_sum (s := Finset.range (N i))
      (fun j hj => hz j (by simpa [Finset.mem_range] using hj))]
    have hxnn : ∀ j ∈ Finset.range (N i), 0 ≤ Real.negMulLog ((μ (D i j)).toReal) := by
      intro j _
      refine Real.negMulLog_nonneg ENNReal.toReal_nonneg ?_
      rw [← ENNReal.toReal_one]
      exact ENNReal.toReal_mono ENNReal.one_ne_top
        (le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
          (le_of_eq MeasureTheory.measure_univ))
    rw [← ENNReal.ofReal_sum_of_nonneg hxnn]
    refine ENNReal.ofReal_le_ofReal ?_
    have hsumD : ∑ j ∈ Finset.range (N i), (μ (D i j)).toReal = A i := by
      have hne : ∀ j ∈ Finset.range (N i), μ (D i j) ≠ ⊤ := fun j _ =>
        ne_top_of_le_ne_top ENNReal.one_ne_top
          (le_trans (MeasureTheory.measure_mono (Set.subset_univ _))
            (le_of_eq MeasureTheory.measure_univ))
      rw [← ENNReal.toReal_sum hne]
      have hun : (⋃ j ∈ Finset.range (N i), D i j) = Q i := by
        refine le_antisymm ?_ ?_
        · refine Set.iUnion_subset fun j => Set.iUnion_subset fun _ => ?_
          exact (Set.subset_iUnion (fun j => D i j) j).trans (le_of_eq (hDcov i))
        · rw [← hDcov i]
          refine Set.iUnion_subset fun j => ?_
          by_cases hj : j < N i
          · intro x hx
            exact Set.mem_iUnion.mpr ⟨j, Set.mem_iUnion.mpr
              ⟨Finset.mem_range.mpr hj, hx⟩⟩
          · rw [hDempty i j (by omega)]
            exact Set.empty_subset _
      rw [← MeasureTheory.measure_biUnion_finset (s := Finset.range (N i))
        (f := fun j => D i j) ?_ ?_, hun, hA]
      · intro a _ b _ hab
        exact hDdisj i a i b (by intro h; exact hab (Prod.ext_iff.mp h).2)
      · intro b _; exact hDmeas i b
    have hsh := Work.EKLComp.negMulLog_sum_le_card_mul_log (s := Finset.range (N i))
      ⟨0, Finset.mem_range.mpr (hN1 i)⟩ (fun j => (μ (D i j)).toReal)
      (fun j _ => ENNReal.toReal_nonneg)
    simpa [Finset.card_range, hsumD] using hsh
  -- the level bound is summable
  have hfin := Work.EKLComp.summable_level_entropy A hA0 hA1 hQmass hQkac N hN1 c κ hc hκ hN
  have hnonneg : ∀ i : ℕ, 0 ≤ A i * Real.log ((N i : ℝ) / A i) := by
    intro i
    rcases lt_or_ge (0 : ℝ) (A i) with h | h
    · have h1 : (1 : ℝ) ≤ (N i : ℝ) / A i := by
        rw [le_div_iff₀ h]
        have h2 : (1 : ℝ) ≤ (N i : ℝ) := by exact_mod_cast hN1 i
        nlinarith [hA1 i]
      exact mul_nonneg (le_of_lt h) (Real.log_nonneg h1)
    · have h0 : A i = 0 := le_antisymm h (hA0 i)
      rw [h0, zero_mul]
  -- reindex the paired enumeration
  have hstep1 : (∑' n : ℕ, ENNReal.ofReal (Real.negMulLog
        ((μ (D (Nat.unpair n).1 (Nat.unpair n).2)).toReal)))
      = ∑' p : ℕ × ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D p.1 p.2)).toReal)) := by
    simpa using Nat.pairEquiv.symm.tsum_eq
      (fun p : ℕ × ℕ => ENNReal.ofReal (Real.negMulLog ((μ (D p.1 p.2)).toReal)))
  have hstep2 : (∑' p : ℕ × ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D p.1 p.2)).toReal)))
      = ∑' i : ℕ, ∑' j : ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D i j)).toReal)) :=
    ENNReal.tsum_prod'
  have hb : (∑' i : ℕ, ∑' j : ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D i j)).toReal)))
      ≤ ENNReal.ofReal
          (4 + |Real.log c| + κ + ∑' i : ℕ, (i : ℝ) * Real.exp (-(i : ℝ))) := by
    calc (∑' i : ℕ, ∑' j : ℕ, ENNReal.ofReal (Real.negMulLog ((μ (D i j)).toReal)))
        ≤ ∑' i : ℕ, ENNReal.ofReal (A i * Real.log ((N i : ℝ) / A i)) :=
          ENNReal.tsum_le_tsum hlevel
      _ = ENNReal.ofReal (∑' i : ℕ, A i * Real.log ((N i : ℝ) / A i)) := by
          rw [ENNReal.ofReal_tsum_of_nonneg hnonneg hfin.1]
      _ ≤ ENNReal.ofReal
            (4 + |Real.log c| + κ + ∑' i : ℕ, (i : ℝ) * Real.exp (-(i : ℝ))) :=
          ENNReal.ofReal_le_ofReal hfin.2
  rw [hstep1.trans hstep2]
  exact ne_top_of_le_ne_top ENNReal.ofReal_ne_top hb

/-! ## 4. The consumer-facing form: finite static entropy -/

/-- **Pisa 7.50/7.52 for the return-time partition.**  If `D i j` (`j < N i`) is a partition of
the `i`-th return cell of `Ω` into at most `N i ≤ c e^{κ i}` measurable pieces, then the
σ-algebra generated by the enumeration `n ↦ D (Nat.unpair n).1 (Nat.unpair n).2` has finite static
conditional entropy — the entropy clause of `Work.EKLComp.C6GeomInput`. -/
theorem HcondSig_retPart_refinement_ne_top {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω)
    (D : ℕ → ℕ → Set X3) (hDmeas : ∀ i j, MeasurableSet (D i j))
    (hDdisj : ∀ i j i' j', (i, j) ≠ (i', j') → Disjoint (D i j) (D i' j'))
    (hDcov : ∀ i, (⋃ j, D i j) = retPart t Ω i)
    (N : ℕ → ℕ) (hN1 : ∀ i, 1 ≤ N i) (hDempty : ∀ i j, N i ≤ j → D i j = ∅)
    (c κ : ℝ) (hc : 0 ≤ c) (hκ : 0 ≤ κ)
    (hN : ∀ i, (N i : ℝ) ≤ c * Real.exp (κ * (i : ℝ))) :
    @Work.EKLC6Core.HcondSig X3 instMeasurableSpaceX3 μ
      (MeasurableSpace.generateFrom (Set.range
        (fun n : ℕ => D (Nat.unpair n).1 (Nat.unpair n).2)))
      (⊥ : MeasurableSpace X3) ≠ ⊤ := by
  have htsum := tsum_negMulLog_paired_ne_top (μ := μ) (retPart t Ω)
    (tsum_ofReal_measure_retPart_le_one (μ := μ) hmp hΩ)
    (tsum_ofReal_mul_measure_retPart_le_one (μ := μ) hmp hΩ)
    D hDmeas hDdisj hDcov N hN1 hDempty c κ hc hκ hN
  refine Work.EKLC6Core.HcondSig_ne_top_of_tsum (μ := μ) _ (fun n => hDmeas _ _) ?_ htsum
  intro m n hmn
  exact hDdisj _ _ _ _ (by
    intro h
    exact hmn (by
      have h1 : Nat.unpair m = Nat.unpair n := h
      rw [← Nat.pair_unpair m, ← Nat.pair_unpair n, h1]))

/-! ## 5. The tiles as a countable partition with finite entropy -/

/-- **The Pisa 7.51 tiles as a countable partition of finite entropy.**  If the level-`i` tiles
`D i j` (`j < N i`) partition the `i`-th return cell of `Ω`, then the enumeration
`n ↦ D (Nat.unpair n).1 (Nat.unpair n).2` is a countable measurable pairwise disjoint family with
finite Shannon entropy — the first three clauses of `Work.EKLComp.exists_plaque_partition_finiteEnt`
once `D` is defined to be the (measurable) tiles. -/
theorem tiles_partition_finiteEnt {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    {Ω : Set X3} (hΩ : MeasurableSet Ω)
    (D : ℕ → ℕ → Set X3) (hDmeas : ∀ i j, MeasurableSet (D i j))
    (hDdisj : ∀ i j i' j', (i, j) ≠ (i', j') → Disjoint (D i j) (D i' j'))
    (hDcov : ∀ i, (⋃ j, D i j) = retPart t Ω i)
    (N : ℕ → ℕ) (hN1 : ∀ i, 1 ≤ N i) (hDempty : ∀ i j, N i ≤ j → D i j = ∅)
    (c κ : ℝ) (hc : 0 ≤ c) (hκ : 0 ≤ κ)
    (hN : ∀ i, (N i : ℝ) ≤ c * Real.exp (κ * (i : ℝ))) :
    (∀ n : ℕ, MeasurableSet (D (Nat.unpair n).1 (Nat.unpair n).2)) ∧
      (∀ m n : ℕ, m ≠ n →
        Disjoint (D (Nat.unpair m).1 (Nat.unpair m).2)
          (D (Nat.unpair n).1 (Nat.unpair n).2)) ∧
      (∑' n : ℕ, ENNReal.ofReal (Real.negMulLog
        ((μ (D (Nat.unpair n).1 (Nat.unpair n).2)).toReal))) ≠ ⊤ := by
  refine ⟨fun n => hDmeas _ _, fun m n hmn => hDdisj _ _ _ _ ?_, ?_⟩
  · intro h
    exact hmn (by
      have h1 : Nat.unpair m = Nat.unpair n := h
      rw [← Nat.pair_unpair m, ← Nat.pair_unpair n, h1])
  · exact tsum_negMulLog_paired_ne_top (μ := μ) (retPart t Ω)
      (tsum_ofReal_measure_retPart_le_one (μ := μ) hmp hΩ)
      (tsum_ofReal_mul_measure_retPart_le_one (μ := μ) hmp hΩ)
      D hDmeas hDdisj hDcov N hN1 hDempty c κ hc hκ hN

end Work.EKLComp
