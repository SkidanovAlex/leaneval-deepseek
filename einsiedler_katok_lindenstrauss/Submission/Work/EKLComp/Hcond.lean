import Submission.Work.EKLComp.Entropy

/-!
# C3 — conditional entropy: the σ-algebra of a finite partition, conditional expectations
on its atoms, and the entropy chain rule
-/

open MeasureTheory Filter Topology
open scoped ENNReal BigOperators

noncomputable section

set_option maxHeartbeats 2000000

namespace Work.EKLComp.Core

open Work.EKLContract

variable {X : Type*} [mX : MeasurableSpace X]

/-! ## 9. Conditional entropy w.r.t. an arbitrary σ-algebra -/

/-- Conditional entropy of a finite family w.r.t. a σ-algebra `m`. -/
def HcondFam (X : Type*) [mX : MeasurableSpace X] (μ : Measure X) {ι : Type*} [Fintype ι]
    (A : ι → Set X) (m : MeasurableSpace X) : ℝ :=
  ∫ x, ∑ i, Real.negMulLog (condExp m μ ((A i).indicator (fun _ => (1 : ℝ))) x) ∂μ

theorem HcondFam_eq_Hcond (μ : Measure X) (P : @FinPart X mX) (m : MeasurableSpace X) :
    @HcondFam X mX μ (Fin (@FinPart.n X mX P)) _ (@FinPart.parts X mX P) m
      = @Hcond X mX μ P m := rfl

/-! ## 10. The σ-algebra generated by a finite partition -/

/-- The σ-algebra generated by a finite family of sets. -/
def partSigmaFam {ι : Type*} (A : ι → Set X) : MeasurableSpace X :=
  MeasurableSpace.generateFrom (Set.range A)

theorem IsMPart.exists_unique {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A) (x : X) :
    ∃! i, x ∈ A i := by
  have hx : x ∈ ⋃ i, A i := by rw [h.cover]; trivial
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
  refine ⟨i, hi, fun j hj => ?_⟩
  by_contra hne
  exact Set.disjoint_left.mp (h.disjoint hne) hj hi

theorem IsMPart.compl_iUnion {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A)
    (I : Set ι) : (⋃ i ∈ I, A i)ᶜ = ⋃ i ∈ Iᶜ, A i := by
  have ha : (⋃ i ∈ I, A i) = ⋃ i : {i // i ∈ I}, A i.1 := by
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨i, hiI, hxi⟩; exact ⟨⟨i, hiI⟩, hxi⟩
    · rintro ⟨i, hxi⟩; exact ⟨i.1, i.2, hxi⟩
  have hb : (⋃ i ∈ Iᶜ, A i) = ⋃ i : {i // i ∉ I}, A i.1 := by
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨i, hiI, hxi⟩; exact ⟨⟨i, hiI⟩, hxi⟩
    · rintro ⟨i, hxi⟩; exact ⟨i.1, i.2, hxi⟩
  rw [ha, hb]
  ext x
  simp only [Set.mem_compl_iff, Set.mem_iUnion]
  constructor
  · intro hx
    obtain ⟨i₀, hi₀, huniq⟩ := h.exists_unique x
    exact ⟨⟨i₀, fun hI => hx ⟨⟨i₀, hI⟩, hi₀⟩⟩, hi₀⟩
  · rintro ⟨⟨i, hiI⟩, hxi⟩ ⟨⟨j, hjI⟩, hxj⟩
    obtain ⟨i₀, hi₀, huniq⟩ := h.exists_unique x
    have h1 : i = i₀ := huniq i hxi
    have h2 : j = i₀ := huniq j hxj
    rw [h1] at hiI
    rw [h2] at hjI
    exact hiI hjI

theorem IsMPart.union_iUnion {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A)
    (J : ℕ → Set ι) : (⋃ n, ⋃ i ∈ J n, A i) = ⋃ i ∈ (⋃ n, J n), A i := by
  have ha : (⋃ n, ⋃ i ∈ J n, A i) = ⋃ n, ⋃ i : {i // i ∈ J n}, A i.1 := by
    congr 1
    funext n
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨i, hiJ, hxi⟩; exact ⟨⟨i, hiJ⟩, hxi⟩
    · rintro ⟨i, hxi⟩; exact ⟨i.1, i.2, hxi⟩
  have hb : (⋃ i ∈ (⋃ n, J n), A i) = ⋃ i : {i // ∃ n, i ∈ J n}, A i.1 := by
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨i, ⟨n, hn⟩, hxi⟩; exact ⟨⟨i, n, hn⟩, hxi⟩
    · rintro ⟨⟨i, n, hn⟩, hxi⟩; exact ⟨i, ⟨n, hn⟩, hxi⟩
  rw [ha, hb]
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨n, ⟨i, hiJ⟩, hxi⟩; exact ⟨⟨i, n, hiJ⟩, hxi⟩
  · rintro ⟨⟨i, n, hiJ⟩, hxi⟩; exact ⟨n, ⟨i, hiJ⟩, hxi⟩

/-- The σ-algebra of unions of parts of a finite partition, as a `MeasurableSpace`. -/
def partSigmaStruct {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A) :
    MeasurableSpace X where
  MeasurableSet' := fun S => ∃ I : Set ι, S = ⋃ i ∈ I, A i
  measurableSet_empty := ⟨∅, by ext x; simp⟩
  measurableSet_compl := by
    rintro S ⟨I, rfl⟩
    exact ⟨Iᶜ, h.compl_iUnion I⟩
  measurableSet_iUnion := by
    intro f hf
    choose J hJ using hf
    refine ⟨⋃ n, J n, ?_⟩
    rw [show (⋃ n, f n) = ⋃ n, ⋃ i ∈ J n, A i from by congr 1; funext n; exact hJ n]
    exact h.union_iUnion J

theorem partSigmaFam_eq_struct {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A) :
    partSigmaFam A = partSigmaStruct A h := by
  refine le_antisymm ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    rintro S ⟨i, rfl⟩
    exact ⟨{i}, by ext x; simp⟩
  · intro S hS
    obtain ⟨I, rfl⟩ := hS
    have h1 : (⋃ i ∈ I, A i) = ⋃ i : {i // i ∈ I}, A i.1 := by
      ext x
      simp only [Set.mem_iUnion]
      constructor
      · rintro ⟨i, hiI, hxi⟩; exact ⟨⟨i, hiI⟩, hxi⟩
      · rintro ⟨i, hxi⟩; exact ⟨i.1, i.2, hxi⟩
    rw [h1]
    exact MeasurableSet.iUnion fun i => MeasurableSpace.measurableSet_generateFrom ⟨i.1, rfl⟩

theorem measurableSet_partSigmaFam_iff {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A)
    (S : Set X) : MeasurableSet[partSigmaFam A] S ↔ ∃ I : Set ι, S = ⋃ i ∈ I, A i := by
  rw [partSigmaFam_eq_struct h]
  rfl

theorem partSigmaFam_le {ι : Type*} [Fintype ι] {A : ι → Set X} (h : IsMPart A) :
    partSigmaFam A ≤ mX :=
  MeasurableSpace.generateFrom_le fun _ ⟨i, hi⟩ => hi ▸ h.measurable i

/-! ## 11. The unique index of a point -/

/-- The index of the part of a finite partition containing `x`. -/
def partIdx {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A) (x : X) : ι :=
  Classical.choose (h.exists_unique x)

theorem partIdx_mem {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A) (x : X) :
    x ∈ A (partIdx A h x) :=
  (Classical.choose_spec (h.exists_unique x)).1

theorem partIdx_unique {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A) (x : X)
    {i : ι} (hi : x ∈ A i) : i = partIdx A h x :=
  ((Classical.choose_spec (h.exists_unique x)).2 i hi)

theorem partIdx_eq_iff {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A) (x : X)
    (i : ι) : partIdx A h x = i ↔ x ∈ A i := by
  constructor
  · intro hix; rw [← hix]; exact partIdx_mem A h x
  · intro hx; exact (partIdx_unique A h x hx).symm

theorem partIdx_preimage {ι : Type*} [Fintype ι] (A : ι → Set X) (h : IsMPart A)
    (I : Set ι) : partIdx A h ⁻¹' I = ⋃ i ∈ I, A i := by
  ext x
  simp only [Set.mem_preimage, Set.mem_iUnion]
  constructor
  · intro hx
    exact ⟨partIdx A h x, hx, partIdx_mem A h x⟩
  · rintro ⟨i, hiI, hxi⟩
    rw [← partIdx_unique A h x hxi]
    exact hiI

end Work.EKLComp.Core
