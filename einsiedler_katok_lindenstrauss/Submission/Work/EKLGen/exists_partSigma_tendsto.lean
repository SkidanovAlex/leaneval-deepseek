import Mathlib
import Submission.Work.EKLContract.Interfaces
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLComp.JacRefiningGenSeq

namespace Work.EKLGen

open MeasureTheory Work.EKLContract

/-- Given a sequence `f` of measurable sets, the membership partitions `memPartition f l` give an
increasing sequence of finite partitions whose generated σ-algebras increase to the σ-algebra
`generateFrom (Set.range f)` generated by `f`. -/
theorem exists_finPart_chain_of_generating {X : Type*} [mX : MeasurableSpace X]
    (f : ℕ → Set X) (hf : ∀ n, MeasurableSet (f n)) :
    ∃ F : ℕ → FinPart X,
      (∀ l, partSigma (F l) ≤ MeasurableSpace.generateFrom (Set.range f)) ∧
      (∀ l, partSigma (F l) ≤ partSigma (F (l + 1))) ∧
      (⨆ l, partSigma (F l)) = MeasurableSpace.generateFrom (Set.range f) := by
  refine ⟨fun l => Work.EKLComp.memPartitionFinPart f hf l, ?_, ?_, ?_⟩
  · intro l
    rw [Work.EKLComp.partSigma_memPartitionFinPart]
    exact MeasurableSpace.generateFrom_memPartition_le_range f l
  · intro l
    rw [Work.EKLComp.partSigma_memPartitionFinPart, Work.EKLComp.partSigma_memPartitionFinPart]
    exact MeasurableSpace.generateFrom_memPartition_le_succ f l
  · have hsig : (⨆ l, partSigma (Work.EKLComp.memPartitionFinPart f hf l))
        = ⨆ l, MeasurableSpace.generateFrom (memPartition f l) :=
      iSup_congr fun l => Work.EKLComp.partSigma_memPartitionFinPart f hf l
    rw [hsig, MeasurableSpace.iSup_generateFrom, MeasurableSpace.generateFrom_iUnion_memPartition]

theorem exists_partSigma_tendsto {U : Subgroup Work.EKLContract.SL3} {Z : Set Work.EKLContract.X3}
    {A : MeasurableSpace Work.EKLContract.X3} (h : Work.EKLContract.IsPlaqueAlgebra U Z A) :
    ∃ F : ℕ → @Work.EKLContract.FinPart Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3,
      (∀ l, @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F l) ≤ A) ∧
      (∀ l, @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F l) ≤
          @Work.EKLContract.partSigma Work.EKLContract.X3
            Work.EKLContract.instMeasurableSpaceX3 (F (l+1))) ∧
      (⨆ l, @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F l)) = A := by
  -- `A` is countably generated, hence admits a sequence of `A`-measurable sets whose range
  -- generates `A`.
  have hseq : ∃ f : ℕ → Set Work.EKLContract.X3,
      (∀ n, @MeasurableSet Work.EKLContract.X3 A (f n)) ∧
      MeasurableSpace.generateFrom (Set.range f) = A := by
    obtain ⟨b, hbcount, hAeq⟩ := h.2.1
    letI : MeasurableSpace Work.EKLContract.X3 := A
    haveI : MeasurableSpace.CountablyGenerated Work.EKLContract.X3 := ⟨b, hbcount, hAeq⟩
    exact ⟨MeasurableSpace.natGeneratingSequence Work.EKLContract.X3,
      fun n => MeasurableSpace.measurableSet_natGeneratingSequence n,
      MeasurableSpace.generateFrom_natGeneratingSequence Work.EKLContract.X3⟩
  obtain ⟨f, hfA, hfgen⟩ := hseq
  have hfmX : ∀ n, @MeasurableSet Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 (f n) := fun n => h.1 (f n) (hfA n)
  obtain ⟨F, hF1, hF2, hF3⟩ :=
    @exists_finPart_chain_of_generating Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 f hfmX
  exact ⟨F, fun l => (hF1 l).trans_eq hfgen, hF2, hF3.trans hfgen⟩

end Work.EKLGen
