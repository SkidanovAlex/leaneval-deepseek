import Mathlib
import Submission.Work.EKLRelCross.LeafBasic
import Submission.Work.EKLRelCross.flower_balls
import Submission.Work.EKLRelCross.flower_plaque
import Submission.Work.EKLC7.LeafwiseGeom

/-!
# `Work.EKLRelCross.flower_family_exists`

The countable flower family (Pisa Cor. 6.15): for every `R > 0` there are countably many plaque
algebras `(Z i, m i)` with measurable bases `G i ⊆ Z i` of positive `μ`-measure on which the shape
contains the `R`-plaque, whose bases cover almost every point.

## Structure

* `flower_local_exists` (imported from `Submission/Work/EKLRelCross/flower_plaque.lean`) is the
  local geometric input, Pisa §6.  Its statement deliberately puts the base as `O ∩ {free points}`
  for an *open* `O` rather than as an open set: `IsPlaqueAlgebra U Z m` forces the shape to be
  bounded at every point of `Z`, hence `Z ⊆ {U-free points}`; and the `U`-free points are *not*
  open (the periodic locus of a horospherical flow accumulates on non-periodic points — see the
  counterexample produced for `EKLRelCross.flower_geom`, where the version with an open `E ⊆` free
  set was refuted).  So a local flower's base can only be the trace of an open set on the free
  locus.
* `isPlaqueAlgebra_bot` + the `U = ⊥` branch handle the trivial subgroup.
* the assembly (below `flower_local`) is **complete**: `ae_free_orbit` gives the conull set of
  free points, `Work.EKLC7.ae_isOpen_pos` gives the positivity of open neighbourhoods, and a
  countable basis of `X₃` + the `O`-part of `flower_local` extract countably many flowers whose
  bases are conull.

## Plan for the remaining gap

Build the local flower from the cross-section data (Pisa 6.7 + 6.9–6.12, with the cross-section
properties stated only at the relevant *scales*, no freeness on open sets) together with the
σ-algebra generated by the "leaf cuts" `Bset U ρ • (C ∩ F)` for a countable family of closed sets
`F` separating the points of the compact cross-section `C`; its atoms are the plaques
`Bset U ρ • z`, and the shape at `x = v • z` contains `Bset U (ρ-1)` because
`Bset U (ρ-1) · Bset U 1 ⊆ Bset U ρ`.
-/

namespace Work.EKLRelCross

open MeasureTheory Filter Topology
open scoped ENNReal
open Work.EKLContract

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

/-! ## The local flower

`Work.EKLRelCross.flower_local_exists` (in `Submission/Work/EKLRelCross/flower_plaque.lean`) is
the geometric input Pisa 6.7-6.15: for a free point `x₀` and `R > 0` there are `Z, m, G, O` with
`O` open containing `x₀`, `G` Borel with `G ⊆ Z`, `(Z, m)` a plaque algebra, `x₀ ∈ G`,
`O ∩ {U-free points} ⊆ G` and `V R ∩ U ⊆ shape m U x` for all `x ∈ G`.  It is imported above; the
statement is used only through `flower_local_exists` in the assembly below. -/

/-! ## The plaque algebra of the whole space in the trivial case `U = ⊥` -/

theorem shape_bot (x : X3) :
    Work.EKLContract.shape (borel X3) (⊥ : Subgroup SL3) x = ((⊥ : Subgroup SL3) : Set SL3) := by
  have hatom : Work.EKLContract.atom (borel X3) x = {x} := by
    refine Set.Subset.antisymm (Set.sInter_subset_of_mem ⟨?_, rfl⟩) ?_
    · exact (isClosed_singleton (x := x)).measurableSet
    · intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact Set.mem_sInter.mpr fun t ht => ht.2
  ext u
  simp only [Work.EKLContract.shape, Set.mem_ofPred_eq, SetLike.mem_coe, hatom]
  constructor
  · rintro ⟨hu, -⟩; exact hu
  · intro hu
    exact ⟨hu, by rw [Subgroup.mem_bot.mp hu, one_smul]; exact Set.mem_singleton x⟩

theorem isPlaqueAlgebra_bot : Work.EKLContract.IsPlaqueAlgebra (⊥ : Subgroup SL3)
    Set.univ (borel X3) := by
  refine ⟨le_rfl, ?_, MeasurableSet.univ, ?_⟩
  · obtain ⟨b, hbc, -, hb⟩ := TopologicalSpace.exists_countable_basis X3
    exact ⟨b, hbc, hb.borel_eq_generateFrom⟩
  · intro x _
    have hatom : Work.EKLContract.atom (borel X3) x = {x} := by
      refine Set.Subset.antisymm (Set.sInter_subset_of_mem ⟨?_, rfl⟩) ?_
      · exact (isClosed_singleton (x := x)).measurableSet
      · intro y hy
        rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact Set.mem_sInter.mpr fun t ht => ht.2
    refine ⟨by rw [hatom]; exact Set.singleton_subset_iff.mpr (Set.mem_univ x), ?_, ?_, ?_⟩
    · rw [hatom]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact ⟨1, Subgroup.mem_bot.mpr rfl, one_smul SL3 x⟩
    · refine ⟨Set.univ, isOpen_univ, ?_⟩
      rw [shape_bot x, Set.univ_inter]
    · refine ⟨1, ?_⟩
      intro u hu i j
      rw [shape_bot x] at hu
      have hu1 : u = 1 := Subgroup.mem_bot.mp hu
      rw [hu1]
      rw [show ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) = 1 from rfl, Matrix.one_apply]
      split <;> simp

/-! ## The countable family over a.e. free points -/

/-- **The set of `U`-free points is conull** (this is `Work.EKLRelCross.ae_free_orbit`). -/
lemma freeSet_compl_null (h2 : Work.EKLContract.P_X3) (μ : MeasureTheory.Measure Work.EKLContract.X3)
    [MeasureTheory.IsProbabilityMeasure μ] (U : Subgroup Work.EKLContract.SL3)
    (hU : Work.EKLContract.IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasureTheory.MeasurePreserving (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto (fun n : ℕ => Work.EKLContract.aDiag t0 ^ n * u * (Work.EKLContract.aDiag t0 ^ n)⁻¹) Filter.atTop (nhds 1)) :
    μ {x : Work.EKLContract.X3 | ∀ u ∈ U, u • x = x → u = 1}ᶜ = 0 := by
  have h1 : ∀ᵐ x ∂μ, ∀ u ∈ U, u • x = x → u = 1 := ae_free_orbit h2 μ U hU t0 ht0 hcontr
  have h2' := MeasureTheory.ae_iff.mp h1
  simpa [Set.compl_def] using h2'

theorem flower_family_exists (h2 : Work.EKLContract.P_X3) (μ : MeasureTheory.Measure Work.EKLContract.X3) [MeasureTheory.IsProbabilityMeasure μ]
    (U : Subgroup Work.EKLContract.SL3) (hU : Work.EKLContract.IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasureTheory.MeasurePreserving (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto (fun n : ℕ => Work.EKLContract.aDiag t0 ^ n * u * (Work.EKLContract.aDiag t0 ^ n)⁻¹) Filter.atTop (nhds 1))
    (R : ℝ) (hR : 0 < R) :
    ∃ (ι : Type) (_ : Countable ι) (Z : ι → Set Work.EKLContract.X3)
      (m : ι → MeasurableSpace Work.EKLContract.X3) (G : ι → Set Work.EKLContract.X3),
      (∀ i, Work.EKLContract.IsPlaqueAlgebra U (Z i) (m i)) ∧
      (∀ i, MeasurableSet (G i)) ∧
      (∀ i, G i ⊆ Z i) ∧
      (∀ i, μ (Z i) ≠ 0) ∧
      (∀ i, ∀ x ∈ G i, Work.EKLContract.V R ∩ (U : Set Work.EKLContract.SL3) ⊆ Work.EKLContract.shape (m i) U x) ∧
      μ (⋃ i, G i)ᶜ = 0 := by
  classical
  by_cases hbot : U = ⊥
  · subst hbot
    refine ⟨Unit, inferInstance, fun _ => Set.univ, fun _ => borel X3, fun _ => Set.univ,
      fun _ => isPlaqueAlgebra_bot, fun _ => MeasurableSet.univ, fun _ => Set.subset_univ _,
      fun _ => by simp, ?_, ?_⟩
    · intro _ x _ u hu
      rw [shape_bot x]
      exact hu.2
    · have hcov : (⋃ i : Unit, (Set.univ : Set X3))ᶜ = ∅ := by ext z; simp
      rw [hcov, measure_empty]
  · have hfree_ae : ∀ᵐ x ∂μ, ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂ := by
      filter_upwards [ae_free_orbit h2 μ U hU t0 ht0 hcontr] with x hx
      intro u₁ h₁ u₂ h₂ heq
      have hfix : (u₂⁻¹ * u₁) • x = x := by rw [mul_smul, heq, inv_smul_smul]
      have h1 : u₂⁻¹ * u₁ = 1 := hx _ (U.mul_mem (U.inv_mem h₂) h₁) hfix
      calc u₁ = u₂ * (u₂⁻¹ * u₁) := (mul_inv_cancel_left u₂ u₁).symm
        _ = u₂ := by rw [h1, mul_one]
    have hpos : ∀ᵐ x ∂μ, ∀ s : Set X3, IsOpen s → x ∈ s → 0 < μ s :=
      Work.EKLC7.ae_isOpen_pos (μ := μ)
    have hfree_compl : μ {x : X3 | ∀ u ∈ U, u • x = x → u = 1}ᶜ = 0 :=
      freeSet_compl_null h2 μ U hU t0 ht0 hcontr
    -- the set of points that are free *and* see every neighbourhood of positive measure
    set S : Set X3 := {x | (∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂) ∧
      (∀ s : Set X3, IsOpen s → x ∈ s → 0 < μ s)} with hSdef
    have hSae : ∀ᵐ x ∂μ, x ∈ S := by
      filter_upwards [hfree_ae, hpos] with x hx1 hx2
      exact ⟨hx1, hx2⟩
    have hScompl : μ Sᶜ = 0 := by
      have h2' := MeasureTheory.ae_iff.mp hSae
      simpa [Set.compl_def] using h2'
    -- the local flower at every point of `S`
    have hloc : ∀ x : S, ∃ (Z : Set X3) (m : MeasurableSpace X3) (G O : Set X3),
        IsOpen O ∧ (x : X3) ∈ O ∧ @MeasurableSet X3 Work.EKLContract.instMeasurableSpaceX3 G ∧ G ⊆ Z ∧
        IsPlaqueAlgebra U Z m ∧ (x : X3) ∈ G ∧
        O ∩ {y | ∀ u ∈ U, u • y = y → u = 1} ⊆ G ∧
        ∀ y ∈ G, V R ∩ (U : Set SL3) ⊆ shape m U y := by
      intro x
      exact flower_local_exists h2 hU (x : X3) x.property.1 R hR
    choose Zfun mfun Gfun Ofun hOopen hxO hGmeas hGsub hplaq hxG hOG hshape using hloc
    obtain ⟨basis, hbas⟩ := TopologicalSpace.exists_seq_basis X3
    -- the indices: basis elements of positive measure sitting inside some `O_x`, `x ∈ S`
    let ι : Type := {n : ℕ // 0 < μ (basis n) ∧ ∃ s : S, basis n ⊆ Ofun s}
    let sf : ι → S := fun i => Classical.choose i.property.2
    have hsf : ∀ i : ι, basis i.1 ⊆ Ofun (sf i) := fun i => Classical.choose_spec i.property.2
    haveI : Countable ι := inferInstance
    refine ⟨ι, inferInstance, fun i => Zfun (sf i), fun i => mfun (sf i), fun i => Gfun (sf i),
      ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro i; exact hplaq (sf i)
    · intro i; exact hGmeas (sf i)
    · intro i; exact hGsub (sf i)
    · -- `μ (Z i) ≠ 0`: the basis element has positive measure and its free part lies in the base
      intro i
      have hsub' : basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1} ⊆ Gfun (sf i) := by
        intro z hz
        exact hOG (sf i) ⟨hsf i hz.1, hz.2⟩
      have hle : μ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1}) ≤ μ (Zfun (sf i)) :=
        measure_mono (Set.Subset.trans hsub' (hGsub (sf i)))
      have hnull : μ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1}ᶜ) = 0 :=
        measure_mono_null Set.inter_subset_right hfree_compl
      have hsplit : basis i.1 ⊆ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1})
          ∪ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1}ᶜ) := by
        intro z hz
        by_cases h : z ∈ {y : X3 | ∀ u ∈ U, u • y = y → u = 1}
        · exact Set.mem_union_left _ ⟨hz, h⟩
        · exact Set.mem_union_right _ ⟨hz, h⟩
      have hle1 : μ (basis i.1) ≤
          μ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1})
            + μ (basis i.1 ∩ {y | ∀ u ∈ U, u • y = y → u = 1}ᶜ) :=
        le_trans (measure_mono hsplit) (measure_union_le _ _)
      rw [hnull, add_zero] at hle1
      exact ne_of_gt (lt_of_lt_of_le (lt_of_lt_of_le i.property.1 hle1) hle)
    · intro i y hy
      exact hshape (sf i) y hy
    · -- the bases cover almost every point
      have hcover : ∀ᵐ y ∂μ, y ∈ ⋃ i : ι, Gfun (sf i) := by
        filter_upwards [hSae, hpos] with y hyS hypos
        have hyO : y ∈ Ofun ⟨y, hyS⟩ := hxO ⟨y, hyS⟩
        have hyF : y ∈ {z : X3 | ∀ u ∈ U, u • z = z → u = 1} :=
          fun u hu hux => hyS.1 u hu 1 U.one_mem (by rw [hux, one_smul])
        obtain ⟨t, htB, hyt, hts⟩ := hbas.exists_subset_of_mem_open hyO (hOopen ⟨y, hyS⟩)
        obtain ⟨n, rfl⟩ := htB
        have hnpos : 0 < μ (basis n) := hypos _ (hbas.isOpen (Set.mem_range_self n)) hyt
        let i : ι := ⟨n, hnpos, ⟨⟨y, hyS⟩, hts⟩⟩
        refine Set.mem_iUnion.mpr ⟨i, ?_⟩
        exact hOG (sf i) (Set.mem_inter ((hsf i) hyt) hyF)
      have h2' := MeasureTheory.ae_iff.mp hcover
      have : (⋃ i : ι, Gfun (sf i))ᶜ = {y : X3 | ¬ y ∈ ⋃ i : ι, Gfun (sf i)} := rfl
      rw [this]
      exact h2'

end Work.EKLRelCross
