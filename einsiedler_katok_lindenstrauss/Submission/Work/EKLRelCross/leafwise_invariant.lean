/-!
# Clause (U4) of `P_Leafwise`: `U`-invariance ⇔ a.e. Haar leafwise measures

This is Pisa 6.27 / EKL (6).  The file proves the two directions separately:

* **(⟸)** `isUInvariant_of_aeHaar`: a.e. right-`U`-invariance of the leafwise measures forces
  `U`-invariance of `μ`.  Input: `localInvariant_of_AeHaar` (the flow-box argument, giving
  invariance under the `u ∈ U` close enough to `1`).  Globalization uses the *contracting*
  dynamics: for arbitrary `u ∈ U` the conjugate `aDiag t₀^n * u * (aDiag t₀^n)⁻¹` lands in the
  local ball for large `n`, and `(L_u)_* μ = (L_{aDiag t₀^n}⁻¹)_* (L_{.})_* (L_{aDiag t₀^n})_* μ = μ`
  because `μ` is invariant under the whole `aDiag t₀`-flow.  (No connectedness of `U` is needed.)
* **(⟹)** `aeHaar_of_leftQuasiInv` + `propInv_global`: `U`-invariance forces left
  quasi-invariance of `ν x` for small `u` (flow box), hence for all `u ∈ U` (the scaling set is
  a subgroup and `U` is generated by its small elements), then `rightQuasiInv` gives right
  quasi-invariance, and clause (U5) `leafwise_propor` upgrades it to equality.
-/

/-- The `aDiag t₀`-flow preserves `μ` at all integer times `n • t₀`, `n : ℕ`. -/
lemma leafwiseInv_aDiag_nsmul (μ : Measure X3) [IsProbabilityMeasure μ]
    {t0 : Fin 3 → ℝ} (ht0 : MeasurePreserving (fun x : X3 => aDiag t0 • x) μ μ) (n : ℕ) :
    MeasurePreserving (fun x : X3 => aDiag (n • t0) • x) μ μ := by
  induction n with
  | zero =>
    have h : (fun x : X3 => aDiag ((0 : ℕ) • t0) • x) = id := by
      ext x; simp [aDiag_zero]
    rw [h]; exact MeasurePreserving.id μ
  | succ k ih =>
    have h : (fun x : X3 => aDiag ((k + 1 : ℕ) • t0) • x)
        = (fun x : X3 => aDiag (k • t0) • (aDiag t0 • x)) := by
      ext x
      rw [succ_nsmul]
      exact (aDiag_smul_mul (k • t0) t0 x).symm
    rw [h]
    exact ih.comp ht0

/-- The same for negative integer times. -/
lemma leafwiseInv_aDiag_nsmul_neg (μ : Measure X3) [IsProbabilityMeasure μ]
    {t0 : Fin 3 → ℝ} (ht0 : MeasurePreserving (fun x : X3 => aDiag t0 • x) μ μ) (n : ℕ) :
    MeasurePreserving (fun x : X3 => aDiag (-(n • t0)) • x) μ μ := by
  have h1 := leafwiseInv_aDiag_nsmul μ ht0 n
  have h1map : Measure.map (fun x : X3 => aDiag (n • t0) • x) μ = μ := h1.map_eq
  have hg : Measurable (fun x : X3 => aDiag (-(n • t0)) • x) := by fun_prop
  have hf : Measurable (fun x : X3 => aDiag (n • t0) • x) := by fun_prop
  have hcomp : (fun x : X3 => aDiag (-(n • t0)) • x) ∘ (fun x : X3 => aDiag (n • t0) • x) = id := by
    funext x
    simp only [Function.comp_apply]
    rw [aDiag_smul_mul, neg_add_cancel, aDiag_zero, one_smul]
    rfl
  have h := congrArg (fun ν : Measure X3 => Measure.map (fun x : X3 => aDiag (-(n • t0)) • x) ν) h1map
  rw [Measure.map_map hg hf, hcomp, Measure.map_id] at h
  exact ⟨hg, h.symm⟩

/-- **(U4) (⟸)**: a.e. right-`U`-invariance of the leafwise measures implies the `U`-invariance
of `μ`. -/
theorem isUInvariant_of_aeHaar (h2 : P_X3) (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasurePreserving (fun x : X3 => aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Tendsto (fun n : ℕ => aDiag t0 ^ n * u * (aDiag t0 ^ n)⁻¹) atTop (𝓝 1))
    (ν : X3 → Measure SL3) (X' : Set X3) (hL : IsLeafwise μ U ν X')
    (hae : AeHaar μ U ν) : IsUInvariant μ U := by
  obtain ⟨ε, hε, hloc⟩ := localInvariant_of_AeHaar h2 μ U hU t0 ht0 hcontr ν X' hL hae
  intro u hu
  have hVnhds : V ε ∈ 𝓝 (1 : SL3) :=
    (Lemmas.V_open_one ε hε).1.mem_nhds (Lemmas.V_open_one ε hε).2
  obtain ⟨n, hn⟩ := ((hcontr u hu).eventually hVnhds).exists
  set u' : SL3 := aDiag (n • t0) * u * (aDiag (n • t0))⁻¹ with hu'def
  have hnu : aDiag (n • t0) = aDiag t0 ^ n := aDiag_nsmul n t0
  have hu'mem : u' ∈ U := hU.2.1 (n • t0) u hu
  have hu'V : u' ∈ V ε := by rw [hu'def, hnu]; exact hn
  have hmp' : MeasurePreserving (fun x : X3 => u' • x) μ μ := hloc u' hu'mem hu'V
  have hdecomp : u = (aDiag (n • t0))⁻¹ * u' * aDiag (n • t0) := by
    rw [hu'def]; group
  have hinv : (aDiag (n • t0))⁻¹ = aDiag (-(n • t0)) :=
    inv_eq_of_mul_eq_one_left (aDiag_neg_mul (n • t0))
  have h1 : MeasurePreserving (fun x : X3 => aDiag (n • t0) • x) μ μ :=
    leafwiseInv_aDiag_nsmul μ ht0 n
  have h2' : MeasurePreserving (fun x : X3 => aDiag (-(n • t0)) • x) μ μ :=
    leafwiseInv_aDiag_nsmul_neg μ ht0 n
  have hgoal : (fun x : X3 => u • x)
      = (fun x : X3 => aDiag (-(n • t0)) • x) ∘ (fun x : X3 => u' • (aDiag (n • t0) • x)) := by
    funext x
    simp only [Function.comp_apply]
    rw [← hinv, smul_smul, smul_smul, ← hdecomp]
  rw [hgoal]
  exact h2'.comp (hmp'.comp h1)

/-- The set of left translations that scale a fixed Radon measure is a subgroup, so the left
quasi-invariance of a single measure on `SL₃(ℝ)` under the unit ball `Uball U 1` upgrades to all
of `U` (`U` is generated by its small elements, `Work.EKLComp.U_generated_by_Uball`). -/
theorem propInv_global {U : Subgroup SL3} (hU : IsHoro U) (σ : Measure SL3)
    (hloc : ∀ u ∈ (Work.EKLComp.Uball U 1 : Set SL3), ∃ c : ENNReal, c ≠ 0 ∧ c ≠ ⊤ ∧
      σ.map (fun g => u * g) = c • σ) :
    ∀ u ∈ U, ∃ c : ENNReal, c ≠ 0 ∧ c ≠ ⊤ ∧ σ.map (fun g => u * g) = c • σ := by
  classical
  have hmu : ∀ u : SL3, Measurable (fun g : SL3 => u * g) := fun u => by fun_prop
  set S : Subgroup SL3 :=
    { carrier := {u : SL3 | ∃ c : ENNReal, c ≠ 0 ∧ c ≠ ⊤ ∧ σ.map (fun g => u * g) = c • σ},
      mul_mem' := by
        rintro u v ⟨c, hc0, hct, hc⟩ ⟨c', hc'0, hc't, hc'⟩
        refine ⟨c' * c, mul_ne_zero hc'0 hc0, ENNReal.mul_ne_top hc't hct, ?_⟩
        rw [show (fun g : SL3 => (u * v) * g)
              = (fun g : SL3 => u * g) ∘ (fun g : SL3 => v * g) from by
            funext g; simp [mul_assoc]]
        rw [← Measure.map_map (hmu u) (hmu v), hc', Measure.map_smul, hc, smul_smul] <;> try fun_prop,
      one_mem' := by
        refine ⟨1, one_ne_zero, ENNReal.one_ne_top, ?_⟩
        rw [show (fun g : SL3 => (1 : SL3) * g) = id from by funext g; simp]
        simp,
      inv_mem' := by
        rintro u ⟨c, hc0, hct, hc⟩
        refine ⟨c⁻¹, ENNReal.inv_ne_zero.mpr hct, ENNReal.inv_ne_top.mpr hc0, ?_⟩
        have hcomp : (fun g : SL3 => u⁻¹ * g) ∘ (fun g : SL3 => u * g) = id := by
          funext g; simp
        have h : σ = c • (σ.map (fun g : SL3 => u⁻¹ * g)) := by
          have h2 := congrArg (fun (m : Measure SL3) => m.map (fun g : SL3 => u⁻¹ * g)) hc
          rw [Measure.map_map (hmu u⁻¹) (hmu u), hcomp, Measure.map_id, Measure.map_smul] at h2 <;> try fun_prop
          exact h2
        have h3 := congrArg (fun (m : Measure SL3) => c⁻¹ • m) h
        rw [smul_smul, ENNReal.inv_mul_cancel hc0 hct, one_smul] at h3
        exact h3.symm } with hS
  have hgen : Subgroup.closure (Work.EKLComp.Uball U 1) = U :=
    Work.EKLComp.U_generated_by_Uball U hU 1 one_pos
  intro u hu
  rw [← hgen] at hu
  exact (Subgroup.closure_le S).mpr (fun v hv => hloc v hv) hu

/-- **(U4) (⟹)**, reduced to the global left quasi-invariance of the leafwise measures: the
`eq_of_smul`-free route through `rightQuasiInv` (right quasi-invariance of a measure carried by
`U`) and clause (U5) `leafwise_propor` (proportional ⇒ equal). -/
theorem aeHaar_of_leftQuasiInv (h2 : P_X3) (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasurePreserving (fun x : X3 => aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Tendsto (fun n : ℕ => aDiag t0 ^ n * u * (aDiag t0 ^ n)⁻¹) atTop (𝓝 1))
    (ν : X3 → Measure SL3) (X' : Set X3) (hL : IsLeafwise μ U ν X')
    (hlq : ∀ᵐ x ∂μ, ∀ u ∈ U, ∃ c : ENNReal, c ≠ 0 ∧ c ≠ ⊤ ∧
      (ν x).map (fun g => u * g) = c • ν x) :
    AeHaar μ U ν := by
  have hU5 := leafwise_propor h2 μ U hU t0 ht0 hcontr ν X' hL
  have hX' : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hL.conull
  filter_upwards [hlq, hU5, hX'] with x hlqx hU5x hx'
  intro u hu
  obtain ⟨c, hc0, hct, hc⟩ := hlqx u hu
  have hrad : IsFiniteMeasureOnCompacts (ν x) := hL.radon x hx'
  have hcar : (ν x) (U : Set SL3)ᶜ = 0 := hL.carried x hx'
  have hne : ν x ≠ 0 := by
    intro h0
    have h1 := hL.normalised x hx'
    rw [h0] at h1
    simp at h1
  obtain ⟨c', hc'0, hc't, hc'⟩ :=
    rightQuasiInv U hU (ν x) hrad hcar hne (fun v hv => hlqx v hv) u hu
  exact hU5x u hu c' hc'

/-- **(U4) (⟹)** with the local left quasi-invariance as an explicit input. -/
theorem aeHaar_of_localQuasiInv (h2 : P_X3) (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasurePreserving (fun x : X3 => aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Tendsto (fun n : ℕ => aDiag t0 ^ n * u * (aDiag t0 ^ n)⁻¹) atTop (𝓝 1))
    (ν : X3 → Measure SL3) (X' : Set X3) (hL : IsLeafwise μ U ν X')
    (hloc : ∀ᵐ x ∂μ, ∀ u ∈ (Work.EKLComp.Uball U 1 : Set SL3), ∃ c : ENNReal, c ≠ 0 ∧ c ≠ ⊤ ∧
      (ν x).map (fun g => u * g) = c • ν x) :
    AeHaar μ U ν :=
  aeHaar_of_leftQuasiInv h2 μ U hU t0 ht0 hcontr ν X' hL <| by
    filter_upwards [hloc] with x hx
    intro u hu
    exact propInv_global hU (ν x) (fun v hv => hx v hv) u hu

/-- **(U4)** — clause (U4) of `P_Leafwise`: `μ` is `U`-invariant if and only if the leafwise
measures are a.e. right-`U`-invariant. -/
theorem leafwise_invariant (h2 : Work.EKLContract.P_X3) (μ : MeasureTheory.Measure Work.EKLContract.X3) [MeasureTheory.IsProbabilityMeasure μ]
    (U : Subgroup Work.EKLContract.SL3) (hU : Work.EKLContract.IsHoro U) (t0 : Fin 3 → ℝ)
    (ht0 : MeasureTheory.MeasurePreserving (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t0 • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto (fun n : ℕ => Work.EKLContract.aDiag t0 ^ n * u * (Work.EKLContract.aDiag t0 ^ n)⁻¹) Filter.atTop (nhds 1))
    (ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3) (X' : Set Work.EKLContract.X3) (hL : Work.EKLContract.IsLeafwise μ U ν X') :
    Work.EKLContract.IsUInvariant μ U ↔ ∀ᵐ x ∂μ, ∀ u ∈ U, (ν x).map (fun g => g * u) = ν x := by
  constructor
  · -- (⟹) `IsUInvariant → AeHaar` (EKL (6) / Pisa 6.27, via the flow box and clause (U5));
    -- equivalently `aeHaar_of_localQuasiInv` below, applied to the local statement
    -- `Work.EKLRelCross.localQuasiInvAux`.
    intro hinv
    exact Work.EKLC7.AeHaar_of_isUInvariant h2 μ U hU t0 ht0 hcontr ν X' hL hinv
  · -- (⟸) `AeHaar → IsUInvariant`: proved above from `localInvariant_of_AeHaar` and the
    -- contracting dynamics.
    intro hae
    exact isUInvariant_of_aeHaar h2 μ U hU t0 ht0 hcontr ν X' hL hae

end

