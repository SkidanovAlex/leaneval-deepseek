import Mathlib
import Submission.Work.EKLContract.All
import Submission.Work.EKLRelCross.Instances
import Submission.Work.EKLProd.borelOrbitImage
import Submission.Work.EKLProd.shape_orbitImage
import Submission.Work.EKLProd.atom_generateFrom_singleton
import Submission.Work.EKLProd.inv_entries_bound
import Submission.Work.EKLProd.plaque_shape_mass

/-!
# `Work.EKLRelCross.plaque_algebra_exists` — plaque algebras exist almost everywhere

For a probability measure `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)` whose `U`-orbits are almost everywhere
free, and a horospherical subgroup `U ≤ SL₃(ℝ)`, almost every `x` admits, for every `ε > 0`, a
*plaque algebra* `(Z, m)` (Pisa Def. 6.2) with `x ∈ Z` and `shape m U x ⊆ V ε ∩ U`.

The witness is the elementary *orbit plaque* of `U` through `x` at scale `ε`:

* `Z = (V ε ∩ U) • x` is Borel (`Work.EKLProd.borelOrbitImage`), being the σ-compact image of
  the σ-compact set `V ε ∩ U` under the continuous orbit map;
* `m = generateFrom {Z}` is the σ-algebra generated by the single set `Z`; its atoms are the
  four sets `∅, Z, Zᶜ, X₃`, so the atom of a point `y ∈ Z` is exactly `Z`
  (`Work.EKLProd.atom_generateFrom_singleton`);
* a.e. freeness of the `U`-orbit at `x` makes the orbit map `u ↦ u • x` injective on `U`, so for
  `y = u₀ • x` the shape of `y` is the translate `{u ∈ U | u * u₀ ∈ V ε}`
  (`Work.EKLProd.shape_orbitImage`), which is `O ∩ U` with `O = {g | g * u₀ ∈ V ε}` open, and
  which is bounded entrywise because `u = (u * u₀) * u₀⁻¹` with both factors entrywise bounded
  (`Work.EKLProd.inv_entries_bound`).
-/

open MeasureTheory Filter Topology

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLRelCross

open Work.EKLContract

/-! ## Elementary facts -/

/-- **Freeness gives injectivity of the orbit map.**  If no non-trivial element of `U` fixes `x`,
then `u ↦ u • x` is injective on `U`. -/
private lemma inj_orbit_of_free {U : Subgroup SL3} {x : X3}
    (h : ∀ u ∈ U, u • x = x → u = 1) :
    ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂ := by
  intro u₁ h₁ u₂ h₂ heq
  have hmem : u₂⁻¹ * u₁ ∈ U := U.mul_mem (U.inv_mem h₂) h₁
  have hfix : (u₂⁻¹ * u₁) • x = x := by rw [mul_smul, heq, inv_smul_smul]
  have h1 : u₂⁻¹ * u₁ = 1 := h _ hmem hfix
  calc u₁ = u₂ * (u₂⁻¹ * u₁) := (mul_inv_cancel_left u₂ u₁).symm
    _ = u₂ * 1 := by rw [h1]
    _ = u₂ := mul_one u₂

/-- The identity lies in every displacement neighbourhood `V ε`, `ε > 0`. -/
private lemma one_mem_V {ε : ℝ} (hε : 0 < ε) : (1 : SL3) ∈ V ε := by
  intro i j
  have h1 : (1 : SL3) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) i j := rfl
  rw [h1, sub_self, abs_zero]
  exact hε

/-- **Entrywise bound on the shape of a plaque.**  For `u₀ ∈ V ε`, the set of `u` with
`u * u₀ ∈ V ε` is entrywise bounded: `u = (u * u₀) * u₀⁻¹`, the first factor is entrywise
bounded by `1 + ε` and the second one by the `inv_entries_bound` constant. -/
private lemma entries_bound_of_mul_V {ε : ℝ} (hε : 0 < ε) {u₀ : SL3} (hu₀ : u₀ ∈ V ε) :
    ∃ C : ℝ, ∀ u : SL3, u * u₀ ∈ V ε → ∀ i j, |u i j| ≤ C := by
  obtain ⟨C, hC⟩ := Work.EKLProd.inv_entries_bound ε hε
  refine ⟨3 * (1 + ε) * C, ?_⟩
  intro u hu i j
  have hA : ∀ k l, |((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 1 + ε :=
    fun k l => Work.EKLProd.mem_V_entries_le hu k l
  have hB : ∀ k l, |((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ C :=
    fun k l => hC u₀ hu₀ k l
  have hcoe : ((u : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
      = ((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) *
        ((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel_right]
  rw [hcoe, Matrix.mul_apply]
  calc |∑ k : Fin 3, ((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k *
          ((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j|
      ≤ ∑ k : Fin 3, |((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k *
          ((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k| *
          |((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, (1 + ε) * C := by
        refine Finset.sum_le_sum (fun k _ => ?_)
        exact mul_le_mul (hA i k) (hB k j) (abs_nonneg _) (by linarith)
    _ = 3 * (1 + ε) * C := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-! ## The orbit plaque of a free point -/

/-- **The plaque algebra at a single free point.**  If the `U`-orbit of `x` is free, then for
every `ε > 0` the σ-algebra generated by the single orbit plaque `Z = (V ε ∩ U) • x` is a
plaque algebra at `x`, and the shape of `x` is contained in `V ε ∩ U`. -/
private theorem plaque_algebra_at {U : Subgroup SL3} (hUcl : IsClosed (U : Set SL3)) (x : X3)
    (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂) {ε : ℝ} (hε : 0 < ε) :
    ∃ (Z : Set X3) (m : MeasurableSpace X3), IsPlaqueAlgebra U Z m ∧ x ∈ Z ∧
      shape m U x ⊆ V ε ∩ (U : Set SL3) := by
  set Z : Set X3 := (fun u : SL3 => u • x) '' (V ε ∩ (U : Set SL3)) with hZ
  set m : MeasurableSpace X3 := MeasurableSpace.generateFrom {Z} with hm
  have hZborel : MeasurableSet[borel X3] Z := Work.EKLProd.borelOrbitImage U hUcl x ε
  have hxZ : x ∈ Z := ⟨1, ⟨one_mem_V hε, U.one_mem⟩, one_smul SL3 x⟩
  -- The shape of a point `u₀ • x` of the plaque.
  have hshape : ∀ (u₀ : SL3), u₀ ∈ V ε → u₀ ∈ U →
      shape m U (u₀ • x) = {u : SL3 | u ∈ U ∧ u * u₀ ∈ V ε} := by
    intro u₀ hu₀V hu₀U
    simp only [hm, hZ]
    rw [Work.EKLProd.shape_orbitImage U x (V ε ∩ (U : Set SL3)) Set.inter_subset_right hinj u₀
      ⟨hu₀V, hu₀U⟩]
    ext u
    constructor
    · rintro ⟨huU, huB⟩; exact ⟨huU, huB.1⟩
    · rintro ⟨huU, huV⟩; exact ⟨huU, huV, U.mul_mem huU hu₀U⟩
  refine ⟨Z, m, ?_, hxZ, ?_⟩
  · refine ⟨?_, ⟨{Z}, Set.countable_singleton Z, rfl⟩, ?_, ?_⟩
    · rw [hm]
      refine MeasurableSpace.generateFrom_le ?_
      intro t ht
      rw [Set.mem_singleton_iff] at ht
      rw [ht]
      exact hZborel
    · rw [hm]
      exact MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton Z)
    · intro y hy
      have hyZ : y ∈ Z := hy
      rw [hZ] at hy
      obtain ⟨u₀, ⟨hu₀V, hu₀U⟩, hy_eq₀⟩ := hy
      have hy_eq : y = u₀ • x := hy_eq₀.symm
      have hatom : atom m y = Z := by
        rw [hm]
        exact Work.EKLProd.atom_generateFrom_singleton Z y hyZ
      have hsh := hshape u₀ hu₀V hu₀U
      refine ⟨?_, ?_, ?_, ?_⟩
      · intro z hz
        rwa [hatom] at hz
      · rw [hatom]
        intro z hz
        rw [hZ] at hz
        obtain ⟨u, ⟨huV, huU⟩, rfl⟩ := hz
        exact ⟨u * u₀⁻¹, U.mul_mem huU (U.inv_mem hu₀U), by
          rw [hy_eq]
          show (u * u₀⁻¹) • (u₀ • x) = u • x
          rw [mul_smul, inv_smul_smul]⟩
      · refine ⟨{g : SL3 | g * u₀ ∈ V ε}, ?_, ?_⟩
        · exact (Work.EKLContract.Lemmas.V_open_one ε hε).1.preimage (by fun_prop)
        · rw [hy_eq, hsh]
          ext u
          exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩
      · obtain ⟨C, hC⟩ := entries_bound_of_mul_V hε hu₀V
        refine ⟨C, ?_⟩
        intro u hu i j
        have hu' : u ∈ U ∧ u * u₀ ∈ V ε := by
          have h2 := hu
          rw [hy_eq, hsh] at h2
          exact h2
        exact hC u hu'.2 i j
  · have hsh := hshape (1 : SL3) (one_mem_V hε) U.one_mem
    rw [one_smul] at hsh
    rw [hsh]
    intro u hu
    exact ⟨by simpa using hu.2, hu.1⟩

/-! ## The a.e. statement -/

theorem plaque_algebra_exists (h2 : Work.EKLContract.P_X3) {U : Subgroup Work.EKLContract.SL3}
    (hU : Work.EKLContract.IsHoro U) {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hfree : ∀ᵐ x ∂μ, ∀ u ∈ U, u • x = x → u = 1) :
    ∀ᵐ x ∂μ, ∀ ε : ℝ, 0 < ε → ∃ (Z : Set Work.EKLContract.X3)
      (m : MeasurableSpace Work.EKLContract.X3),
      Work.EKLContract.IsPlaqueAlgebra U Z m ∧ x ∈ Z ∧
        Work.EKLContract.shape m U x ⊆ Work.EKLContract.V ε ∩ (U : Set Work.EKLContract.SL3) := by
  filter_upwards [hfree] with x hx
  intro ε hε
  exact plaque_algebra_at hU.1 x (inj_orbit_of_free hx) hε

end Work.EKLRelCross
