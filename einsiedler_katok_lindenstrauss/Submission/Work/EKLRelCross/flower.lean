import Mathlib
import Submission.Work.EKLContract.All
import Submission.Work.EKLRelCross.Instances
import Submission.Work.EKLRelCross.plaque_algebra_exists
import Submission.Work.EKLComp.PlaqueToolkit
import Submission.Work.EKLProd.sl3EntryBox_compact
import Submission.Work.EKLProd.inv_entries_bound

/-!
# `Work.EKLRelCross.flower` — the cross-section flower of a horospherical subgroup

This file sets up the "flower" of a global cross-section `B ⊆ X₃` (a Borel conull set such that
`B ∩ (u • B) = ∅` for every `u ∈ U ∖ {1}`), which is the device that lets one use the `condexp`
axiom of `IsLeafwise` in the *cross-section* regime.

The idea (Pisa §6.7–6.15, specialised to "r = ∞"): the map
`Φ : (V δ ∩ U) × (B ∩ W) → X₃`, `(v,b) ↦ v • b` is injective, so its image is a Borel set which
carries a σ-algebra whose atoms are the plaques `(V δ ∩ U) • b`.  Since `B` is conull these
flowers cover `X₃` up to a null set, and the atom at a point of `B` is exactly the plaque
`(V δ ∩ U) • x`, whose shape is the box `V δ ∩ U` itself.  Feeding `f = 1_{Bᶜ}` into `condexp`
then shows that `ν x` charges the box `V δ ∩ U` only at the identity.

## Main definitions

* `Vinv δ` — the inverse displacement box `(V δ)⁻¹`;
* `flowerSet U δ B W` — the "collared" set `{x | ∃ v ∈ Vinv δ ∩ U, v • x ∈ B ∩ W}`;
* `flowerSigma U δ B W` — the σ-algebra generated by the family `n ↦ flowerSet U δ B (W n)`.

## Main results

* `flowerSet_eq_image` — `flowerSet U δ B W` is the image of `(V δ ∩ U) × (B ∩ W)` under the
  action map (so a *continuous injective* image, hence Borel — see `flower_borel`);
* `mem_atom_iff_pattern` — the atoms of a σ-algebra generated by a family are exactly the
  "same pattern" classes;
* `free_of_mem_crossSection` — the cross-section property gives freeness at each of its points.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option warn.classDefReducibility false
set_option maxHeartbeats 800000

noncomputable section

namespace Work.EKLRelCross

open Work.EKLContract

/-! ## 1. The inverse displacement box -/

/-- The inverse of the displacement box `V δ`: the set of `g` with `g⁻¹ ∈ V δ`. -/
def Vinv (δ : ℝ) : Set SL3 := {g : SL3 | g⁻¹ ∈ V δ}

lemma mem_Vinv_iff {δ : ℝ} {g : SL3} : g ∈ Vinv δ ↔ g⁻¹ ∈ V δ := Iff.rfl

lemma inv_mem_Vinv {δ : ℝ} {g : SL3} (hg : g ∈ Vinv δ) : g⁻¹ ∈ V δ := hg

lemma Vinv_mem_of_inv {δ : ℝ} {g : SL3} (hg : g⁻¹ ∈ V δ) : g ∈ Vinv δ := hg

/-- `V δ` is open, for every `δ`. -/
lemma isOpen_V (δ : ℝ) : IsOpen (V δ) := by
  rw [Work.EKLContract.Lemmas.V_eq_iInter]
  refine isOpen_iInter_of_finite (fun i => isOpen_iInter_of_finite (fun j => ?_))
  apply isOpen_lt _ continuous_const
  fun_prop

lemma isOpen_Vinv (δ : ℝ) : IsOpen (Vinv δ) :=
  (isOpen_V δ).preimage (by fun_prop : Continuous (fun g : SL3 => g⁻¹))

lemma one_mem_Vinv {δ : ℝ} (hδ : 0 < δ) : (1 : SL3) ∈ Vinv δ := by
  rw [mem_Vinv_iff, inv_one]
  exact (Work.EKLContract.Lemmas.V_open_one δ hδ).2

/-- `V δ` is contained in the closed entrywise box of radius `1 + δ`. -/
lemma V_subset_entryBox {δ : ℝ} (hδ : 0 < δ) :
    V δ ⊆ {g : SL3 | ∀ i j, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 + δ} :=
  fun _ hg i j => Work.EKLProd.mem_V_entries_le hg i j

/-- The closed entrywise box of radius `1 + δ` is compact. -/
lemma isCompact_entryBox (δ : ℝ) :
    IsCompact {g : SL3 | ∀ i j, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 + δ} := by
  rw [show {g : SL3 | ∀ i j, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 + δ}
      = {g : SL3 | ∀ i j, -(1 + δ) ≤ (g : Matrix (Fin 3) (Fin 3) ℝ) i j
          ∧ (g : Matrix (Fin 3) (Fin 3) ℝ) i j ≤ 1 + δ} from by
    ext g
    simp only [Set.mem_ofPred_eq]
    constructor
    · intro h i j; exact abs_le.mp (h i j)
    · intro h i j; exact abs_le.mpr (h i j)]
  exact Work.EKLProd.sl3EntryBox_compact (fun _ _ => -(1 + δ)) (fun _ _ => 1 + δ)

/-! ## 2. The flower sets -/

/-- **The `δ`-collar of the cross-section `B` over `W`**: the set of points which can be reached
from a point of `B ∩ W` by an element of `(V δ)⁻¹ ∩ U`.  Equivalently (`flowerSet_eq_image`) the
image of `(V δ ∩ U) × (B ∩ W)` under the action map. -/
def flowerSet (U : Subgroup SL3) (δ : ℝ) (B W : Set X3) : Set X3 :=
  {x : X3 | ∃ v ∈ Vinv δ ∩ (U : Set SL3), v • x ∈ B ∩ W}

/-- The σ-algebra generated by the flower sets of a countable family `W`. -/
def flowerSigma (U : Subgroup SL3) (δ : ℝ) (B : Set X3) (W : ℕ → Set X3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom (Set.range (fun n => flowerSet U δ B (W n)))

lemma mem_flowerSet {U : Subgroup SL3} {δ : ℝ} {B W : Set X3} {x : X3} :
    x ∈ flowerSet U δ B W ↔ ∃ v ∈ Vinv δ ∩ (U : Set SL3), v • x ∈ B ∩ W := Iff.rfl

lemma flowerSet_mono {U : Subgroup SL3} {δ : ℝ} {B W W' : Set X3} (h : W ⊆ W') :
    flowerSet U δ B W ⊆ flowerSet U δ B W' :=
  fun _ ⟨v, hv, hx⟩ => ⟨v, hv, hx.1, h hx.2⟩

lemma flowerSet_subset_univ {U : Subgroup SL3} {δ : ℝ} {B W : Set X3} :
    flowerSet U δ B W ⊆ flowerSet U δ B Set.univ :=
  flowerSet_mono (Set.subset_univ W)

/-- **The flower set as a continuous image**: `flowerSet U δ B W` is the image of
`(V δ ∩ U) × (B ∩ W)` under the action map `(v,b) ↦ v • b`. -/
lemma flowerSet_eq_image (U : Subgroup SL3) (δ : ℝ) (B W : Set X3) :
    flowerSet U δ B W
      = (fun p : SL3 × X3 => p.1 • p.2) '' ((V δ ∩ (U : Set SL3)) ×ˢ (B ∩ W)) := by
  ext x
  constructor
  · rintro ⟨v, ⟨hv, hvU⟩, hx⟩
    exact ⟨(v⁻¹, v • x), ⟨⟨hv, U.inv_mem hvU⟩, hx⟩, inv_smul_smul v x⟩
  · rintro ⟨⟨v, b⟩, ⟨⟨hv, hvU⟩, hb⟩, rfl⟩
    refine ⟨v⁻¹, ⟨?_, U.inv_mem hvU⟩, ?_⟩
    · show (v⁻¹)⁻¹ ∈ V δ
      rwa [inv_inv]
    · show v⁻¹ • (v • b) ∈ B ∩ W
      rwa [inv_smul_smul]

/-! ## 3. Atoms of a generated σ-algebra are pattern classes -/

/-- The σ-algebra of sets whose membership is determined by the `S`-pattern of a fixed point `x`. -/
def patternSigma (S : Set (Set X3)) (x : X3) : MeasurableSpace X3 where
  MeasurableSet' A := ∀ y : X3, (∀ A' ∈ S, (y ∈ A' ↔ x ∈ A')) → (y ∈ A ↔ x ∈ A)
  measurableSet_empty := by intro y _; simp
  measurableSet_compl := by intro A hA y hy; simpa using (hA y hy).not
  measurableSet_iUnion := by
    intro f hf y hy
    simp only [Set.mem_iUnion]
    exact exists_congr (fun n => hf n y hy)

lemma patternSigma_le (S : Set (Set X3)) (x : X3) :
    MeasurableSpace.generateFrom S ≤ patternSigma S x :=
  MeasurableSpace.generateFrom_le (m := patternSigma S x) (fun t ht => fun y hy => hy t ht)

lemma mem_atom_self {m : MeasurableSpace X3} (x : X3) : x ∈ atom m x :=
  fun _ hs => hs.2

lemma atom_subset_of_mem {m : MeasurableSpace X3} {s : Set X3} {x : X3}
    (hs : MeasurableSet[m] s) (hx : x ∈ s) : atom m x ⊆ s :=
  fun _ hy => hy s ⟨hs, hx⟩

/-- **Atoms of a generated σ-algebra are the "same pattern" classes.**  Two points lie in the
same atom of `generateFrom S` exactly when they have the same membership pattern in the family
`S`. -/
lemma mem_atom_iff_pattern {S : Set (Set X3)} {x y : X3} :
    y ∈ atom (MeasurableSpace.generateFrom S) x ↔ ∀ A ∈ S, (y ∈ A ↔ x ∈ A) := by
  constructor
  · intro hy A hA
    have hmA : MeasurableSet[MeasurableSpace.generateFrom S] A :=
      MeasurableSpace.measurableSet_generateFrom hA
    refine ⟨fun hyA => ?_, fun hxA => atom_subset_of_mem hmA hxA hy⟩
    by_contra hxA
    exact (atom_subset_of_mem hmA.compl hxA hy) hyA
  · intro h
    rw [atom]
    intro A hA
    exact ((MeasurableSpace.le_def.mp (patternSigma_le S x)) A hA.1 y h).2 hA.2

/-! ## 4. The cross-section property gives freeness -/

/-- **The cross-section property implies freeness at each point of the cross-section**: if
`B ∩ (u • B) = ∅` for `u ≠ 1` then no non-trivial `u` fixes a point of `B`. -/
lemma free_of_mem_crossSection {U : Subgroup SL3} {B : Set X3}
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1) :
    ∀ b ∈ B, ∀ u ∈ U, u • b = b → u = 1 :=
  fun b hb u hu h => hCS b hb u hu (by rw [h]; exact hb)

end Work.EKLRelCross
