/-!
# `Work.EKLRelCross.crossSection_trivial` — the leafwise measure of a cross-section is trivial

If `μ` is a probability measure on `X₃ = SL₃(ℝ)/SL₃(ℤ)` whose `U`-orbits are essentially free
(`U` horospherical) and which is a *global cross-section* for `U` — i.e. there is a conull Borel
`B` with `B ∩ (u • B) = ∅` for every `u ∈ U ∖ {1}` (Pisa 6.23) — then the leafwise measure system
`ν` of `IsLeafwise μ U ν X'` is trivial: `ν x = δ₁` for `μ`-a.e. `x`.

## The proof

Let `B` be the conull cross-section.  For `δ > 0` consider the *flower* of `B` at scale `δ`
(`Submission/Work/EKLRelCross/flower.lean`): the σ-algebra `m = flowerSigma U δ B W` generated by
the sets `flowerSet U δ B (W n)` of a countable family `W` that separates `B`.  Its atoms are the
plaques `(V δ ∩ U) • b`, `b ∈ B` (`atom_flower`), so `Z = flowerSet U δ B X₃ ⊇ B` is conull and
`(Z, m)` is a plaque algebra (`isPlaqueAlgebra_flower`) with `shape m U x = V δ ∩ U` for every
`x ∈ B` (`shape_flower`).

Applying the `condexp` axiom of `IsLeafwise` to `f = 1_{Bᶜ}` — which vanishes `μ`-a.e. — gives
`∫_{shape m U x} f (u • x) ∂(ν x) = 0` for a.e. `x ∈ Z`; since `μ`-a.e. `x` lies in `B` ⊆ `Z`,
where `shape m U x = V δ ∩ U` has finite positive `ν x`-mass, this says

  `ν x {u ∈ V δ ∩ U | u • x ∉ B} = 0`,

and for `x ∈ B` the cross-section property turns `{u ∈ V δ ∩ U | u • x ∈ B}` into `{1}`, whence
`ν x ((V δ ∩ U) ∖ {1}) = 0`.  Taking `δ = n + 1` for all `n` and using
`U = ⋃ₙ (V (n+1) ∩ U)` gives `ν x (U ∖ {1}) = 0`; with `ν x` carried by `U` and normalised on
`Box1 U ∋ 1`, this forces `ν x = ν x {1} • δ₁ = δ₁`.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option warn.classDefReducibility false
set_option maxHeartbeats 800000

noncomputable section

namespace Work.EKLRelCross

open Work.EKLContract

/-! ## 1. Freeness at the cross-section, and the flower contains the cross-section -/

lemma orbit_inj_of_crossSection {U : Subgroup SL3} {B : Set X3}
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1) {b : X3} (hb : b ∈ B) :
    ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • b = u₂ • b → u₁ = u₂ := by
  intro u₁ h₁ u₂ h₂ heq
  have hmem : u₂⁻¹ * u₁ ∈ U := U.mul_mem (U.inv_mem h₂) h₁
  have hfix : (u₂⁻¹ * u₁) • b ∈ B := by rw [mul_smul, heq, inv_smul_smul]; exact hb
  have h1 : u₂⁻¹ * u₁ = 1 := hCS b hb _ hmem hfix
  calc u₁ = u₂ * (u₂⁻¹ * u₁) := (mul_inv_cancel_left u₂ u₁).symm
    _ = u₂ * 1 := by rw [h1]
    _ = u₂ := mul_one u₂

lemma B_subset_flowerSet {U : Subgroup SL3} {B : Set X3} {δ : ℝ} (hδ : 0 < δ) :
    B ⊆ flowerSet U δ B Set.univ := by
  intro b hb
  simp only [mem_flowerSet]
  exact ⟨1, ⟨one_mem_Vinv hδ, U.one_mem⟩, by simp [hb]⟩

/-! ## 2. The shape of the flower at a point of the cross-section -/

lemma shape_flower {U : Subgroup SL3} {B : Set X3}
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1)
    {W : ℕ → Set X3} (hW0 : W 0 = Set.univ)
    (hsep : ∀ b ∈ B, ∀ b' ∈ B, (∀ n, b ∈ W n ↔ b' ∈ W n) → b = b')
    {δ : ℝ} (hδ : 0 < δ) {v : SL3} (hv : v ∈ V δ) (hvU : v ∈ U) {b : X3} (hb : b ∈ B) :
    ∀ {x : X3}, x = v • b →
      shape (flowerSigma U δ B W) U x = {u : SL3 | u ∈ U ∧ u * v ∈ V δ} := by
  intro x hx
  have hinj := orbit_inj_of_crossSection hCS hb
  have hatomx := atom_flower hCS hW0 hsep hδ hv hvU hb hx
  rw [shape, hatomx]
  ext u
  constructor
  · rintro ⟨huU, hu⟩
    obtain ⟨u', hu', heq⟩ := hu
    have heq' : u' • b = u • x := heq
    have huv : u' = u * v := by
      refine hinj u' hu'.2 (u * v) (U.mul_mem huU hvU) ?_
      show u' • b = (u * v) • b
      rw [heq', hx, mul_smul]
    exact ⟨huU, huv ▸ hu'.1⟩
  · rintro ⟨huU, huv⟩
    refine ⟨huU, ⟨u * v, ⟨huv, U.mul_mem huU hvU⟩, ?_⟩⟩
    show (u * v) • b = u • x
    rw [hx, mul_smul]

/-! ## 3. The flower is a plaque algebra -/

lemma isPlaqueAlgebra_flower (h2 : P_X3) {U : Subgroup SL3} (hUcl : IsClosed (U : Set SL3))
    {B : Set X3} (hB : MeasurableSet B)
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1)
    {W : ℕ → Set X3} (hWopen : ∀ n, IsOpen (W n)) (hW0 : W 0 = Set.univ)
    (hsep : ∀ b ∈ B, ∀ b' ∈ B, (∀ n, b ∈ W n ↔ b' ∈ W n) → b = b')
    {δ : ℝ} (hδ : 0 < δ) :
    IsPlaqueAlgebra U (flowerSet U δ B Set.univ) (flowerSigma U δ B W) := by
  have hZeq : flowerSet U δ B Set.univ = flowerSet U δ B (W 0) := by rw [hW0]
  refine ⟨?_, ⟨Set.range (fun n => flowerSet U δ B (W n)), Set.countable_range _, rfl⟩, ?_, ?_⟩
  · refine MeasurableSpace.generateFrom_le fun t ht => ?_
    obtain ⟨n, rfl⟩ := ht
    exact flowerSet_borel h2 hUcl hB (hWopen n).measurableSet hCS δ
  · rw [hZeq]
    exact MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self 0)
  · intro x hx
    obtain ⟨v, ⟨hv, hvU⟩, hvb⟩ := hx
    set w : SL3 := v⁻¹ with hwdef
    set b : X3 := v • x with hbdef
    have hwV : w ∈ V δ := by rw [hwdef]; exact hv
    have hwU : w ∈ U := U.inv_mem hvU
    have hbB : b ∈ B := hvb.1
    have hxwb : x = w • b := by
      rw [hwdef, hbdef]
      show x = v⁻¹ • (v • x)
      rw [inv_smul_smul]
    have hatomx := atom_flower hCS hW0 hsep hδ hwV hwU hbB hxwb
    have hinj := orbit_inj_of_crossSection hCS hbB
    have hshape : shape (flowerSigma U δ B W) U x = {u : SL3 | u ∈ U ∧ u * w ∈ V δ} := by
      rw [shape, hatomx]
      ext u
      constructor
      · rintro ⟨huU, hu⟩
        obtain ⟨u', hu', heq⟩ := hu
        have heq' : u' • b = u • x := heq
        have huw : u' = u * w := by
          refine hinj u' hu'.2 (u * w) (U.mul_mem huU hwU) ?_
          show u' • b = (u * w) • b
          rw [heq', hxwb, mul_smul]
        exact ⟨huU, huw ▸ hu'.1⟩
      · rintro ⟨huU, huw⟩
        refine ⟨huU, ⟨u * w, ⟨huw, U.mul_mem huU hwU⟩, ?_⟩⟩
        show (u * w) • b = u • x
        rw [hxwb, mul_smul]
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hatomx]
      rintro y ⟨u, ⟨huV, huU⟩, rfl⟩
      simp only [mem_flowerSet]
      refine ⟨u⁻¹, ⟨?_, U.inv_mem huU⟩, ?_⟩
      · show (u⁻¹)⁻¹ ∈ V δ
        rwa [inv_inv]
      · show u⁻¹ • (u • b) ∈ B ∩ Set.univ
        rw [inv_smul_smul]
        exact ⟨hbB, Set.mem_univ _⟩
    · rw [hatomx]
      rintro y ⟨u, ⟨huV, huU⟩, rfl⟩
      refine ⟨u * w⁻¹, U.mul_mem huU (U.inv_mem hwU), ?_⟩
      show (u * w⁻¹) • x = u • b
      rw [mul_smul, show w⁻¹ • x = b from by rw [hxwb, inv_smul_smul]]
    · refine ⟨{g : SL3 | g * w ∈ V δ}, ?_, ?_⟩
      · exact (isOpen_V δ).preimage (by fun_prop : Continuous fun g : SL3 => g * w)
      · rw [hshape]
        ext u; exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩
    · obtain ⟨C, hC⟩ := Work.EKLProd.inv_entries_bound δ hδ
      have hC0 : 0 ≤ C := by
        have h := hC 1 ((Work.EKLContract.Lemmas.V_open_one δ hδ).2) 0 0
        rw [inv_one] at h
        have h1 : ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) 0 0 = 1 := by simp
        rw [h1, abs_one] at h
        linarith
      refine ⟨3 * (1 + δ) * C, ?_⟩
      intro u hu i j
      rw [hshape] at hu
      obtain ⟨huU, huw⟩ := hu
      have hentries : ∀ k l, |((u * w : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 1 + δ :=
        fun k l => Work.EKLProd.mem_V_entries_le huw k l
      have hinv : ∀ k l, |((w⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ C :=
        fun k l => hC w hwV k l
      have hcoe0 : (u * w) * w⁻¹ = u := mul_inv_cancel_right u w
      have hcoe : ((u : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
          = ((u * w : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
            * ((w⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) := by
        conv_lhs => rw [← hcoe0]
        rw [Matrix.SpecialLinearGroup.coe_mul]
      rw [hcoe]
      exact Work.EKLComp.mul_entries_le _ _ i j hentries hinv (by linarith) hC0

/-! ## 4. The mass of the box `V δ ∩ U` -/

lemma mass_V_inter_U_ae {μ : Measure X3} [IsProbabilityMeasure μ] {U : Subgroup SL3}
    {ν : X3 → Measure SL3} {X' : Set X3} (hI : IsLeafwise μ U ν X') {δ : ℝ} (hδ : 0 < δ) :
    ∀ᵐ x ∂μ, 0 < ν x (V δ ∩ (U : Set SL3)) ∧ ν x (V δ ∩ (U : Set SL3)) < ⊤ := by
  have hX : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hI.conull
  filter_upwards [hX] with x hxX
  constructor
  · have hnull : ν x (V δ ∩ ((U : Set SL3))ᶜ) = 0 :=
      measure_mono_null Set.inter_subset_right (hI.carried x hxX)
    have hae : (V δ : Set SL3) =ᵐ[ν x] ((V δ) ∩ (U : Set SL3) : Set SL3) := by
      rw [MeasureTheory.ae_eq_set]
      refine ⟨measure_mono_null ?_ hnull, ?_⟩
      · intro g hg; exact ⟨hg.1, fun hgU => hg.2 ⟨hg.1, hgU⟩⟩
      · show ν x (((V δ) ∩ (U : Set SL3) : Set SL3) \ V δ) = 0
        rw [show ((V δ) ∩ (U : Set SL3) : Set SL3) \ V δ = ∅ from
          Set.sdiff_eq_empty.mpr Set.inter_subset_left, measure_empty]
    rw [← measure_congr hae]
    exact hI.pos x hxX δ hδ
  · refine lt_of_le_of_lt (measure_mono ?_)
      ((hI.radon x hxX).lt_top_of_isCompact (isCompact_entryBox δ))
    intro g hg
    exact V_subset_entryBox hδ hg.1

/-! ## 5. The vanishing along the cross-section -/

lemma flower_null_ae {μ : Measure X3} [IsProbabilityMeasure μ] {U : Subgroup SL3}
    {ν : X3 → Measure SL3} {X' : Set X3} (hI : IsLeafwise μ U ν X') {B : Set X3}
    (hBmeas : MeasurableSet B) (hBnull : μ Bᶜ = 0)
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1)
    {W : ℕ → Set X3} {δ : ℝ} (hδ : 0 < δ)
    (hpla : IsPlaqueAlgebra U (flowerSet U δ B Set.univ) (flowerSigma U δ B W))
    (hZnull : μ (flowerSet U δ B Set.univ)ᶜ = 0)
    (hshape : ∀ x ∈ B, shape (flowerSigma U δ B W) U x = V δ ∩ (U : Set SL3)) :
    ∀ᵐ x ∂μ, ν x ((V δ ∩ (U : Set SL3)) \ {1}) = 0 := by
  have hZmeas : MeasurableSet[instMeasurableSpaceX3] (flowerSet U δ B Set.univ) :=
    hpla.1 _ hpla.2.2.1
  have hNmeas : MeasurableSet[instMeasurableSpaceX3] Bᶜ := hBmeas.compl
  set f : X3 → ℝ := Bᶜ.indicator (fun _ : X3 => (1 : ℝ)) with hfdef
  have hfmeas : Measurable[instMeasurableSpaceX3] f :=
    Measurable.indicator (measurable_const : Measurable[instMeasurableSpaceX3] fun _ : X3 => (1:ℝ))
      hNmeas
  have hfb : ∃ C, ∀ y, |f y| ≤ C := ⟨1, fun y => by
    by_cases hy : y ∈ Bᶜ
    · rw [hfdef, Set.indicator_of_mem hy]; norm_num
    · rw [hfdef, Set.indicator_of_notMem hy]; norm_num⟩
  have hcond₀ := hI.condexp (flowerSet U δ B Set.univ) (flowerSigma U δ B W) hpla f hfmeas hfb
  have hfae : f =ᵐ[μ.restrict (flowerSet U δ B Set.univ)] 0 := by
    refine (MeasureTheory.ae_iff (μ := μ.restrict (flowerSet U δ B Set.univ))).mpr ?_
    have hsub : {a : X3 | ¬(f a = 0)} ⊆ Bᶜ := by
      intro a ha
      by_contra hx
      exact ha (by rw [hfdef, Set.indicator_of_notMem hx])
    refine le_antisymm ?_ bot_le
    calc (μ.restrict (flowerSet U δ B Set.univ)) {a : X3 | ¬(f a = 0)}
        ≤ (μ.restrict (flowerSet U δ B Set.univ)) Bᶜ := measure_mono hsub
      _ = μ (Bᶜ ∩ flowerSet U δ B Set.univ) := MeasureTheory.Measure.restrict_apply hNmeas
      _ ≤ μ Bᶜ := measure_mono Set.inter_subset_left
      _ = 0 := hBnull
  have hzero₀ : condExp (flowerSigma U δ B W) (μ.restrict (flowerSet U δ B Set.univ)) f
      =ᵐ[μ.restrict (flowerSet U δ B Set.univ)] 0 := by
    have h := MeasureTheory.condExp_congr_ae
      (μ := μ.restrict (flowerSet U δ B Set.univ)) (m := flowerSigma U δ B W)
      (f := f) (g := 0) hfae
    rwa [MeasureTheory.condExp_zero] at h
  have hX : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hI.conull
  have hB : ∀ᵐ x ∂μ, x ∈ B := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ B} = Bᶜ from rfl]
    exact hBnull
  have hZae : ∀ᵐ x ∂μ, x ∈ flowerSet U δ B Set.univ := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ flowerSet U δ B Set.univ}
      = (flowerSet U δ B Set.univ)ᶜ from rfl]
    exact hZnull
  have hmass := mass_V_inter_U_ae (ν := ν) hI hδ
  have hres : ∀ᵐ x ∂(μ.restrict (flowerSet U δ B Set.univ)),
      ν x ((V δ ∩ (U : Set SL3)) \ {1}) = 0 := by
    filter_upwards [hcond₀, hzero₀, MeasureTheory.ae_restrict_of_ae hX,
      MeasureTheory.ae_restrict_of_ae hB, MeasureTheory.ae_restrict_of_ae hmass]
      with x hcx hzx hxX hxB hmx
    have hshapex := hshape x hxB
    have hden : (ν x (shape (flowerSigma U δ B W) U x)).toReal ≠ 0 := by
      rw [hshapex]
      exact ENNReal.toReal_ne_zero.mpr ⟨ne_of_gt hmx.1, ne_of_lt hmx.2⟩
    have hnum : ∫ u in shape (flowerSigma U δ B W) U x, f (u • x) ∂(ν x) = 0 := by
      have h := hcx
      rw [hzx] at h
      exact (div_eq_zero_iff.mp h.symm).resolve_right hden
    have hcont : Continuous (fun u : SL3 => u • x) := by fun_prop
    have hmeaspre : MeasurableSet {u : SL3 | u • x ∈ Bᶜ} := hNmeas.preimage hcont.measurable
    have hind : ∫ u in shape (flowerSigma U δ B W) U x, f (u • x) ∂(ν x)
        = (ν x (shape (flowerSigma U δ B W) U x ∩ {u : SL3 | u • x ∈ Bᶜ})).toReal := by
      have h1 : ∀ u : SL3, f (u • x)
          = ({u : SL3 | u • x ∈ Bᶜ}).indicator (fun _ : SL3 => (1 : ℝ)) u := by
        intro u
        by_cases hu : u • x ∈ Bᶜ
        · rw [Set.indicator_of_mem (show u ∈ {u : SL3 | u • x ∈ Bᶜ} from hu),
            hfdef, Set.indicator_of_mem hu]
        · rw [Set.indicator_of_notMem (show u ∉ {u : SL3 | u • x ∈ Bᶜ} from hu),
            hfdef, Set.indicator_of_notMem hu]
      simp only [h1]
      rw [MeasureTheory.setIntegral_indicator hmeaspre, MeasureTheory.setIntegral_const,
        smul_eq_mul, mul_one, MeasureTheory.measureReal_def]
    have h0 : ν x (shape (flowerSigma U δ B W) U x ∩ {u : SL3 | u • x ∈ Bᶜ}) = 0 := by
      rw [hind] at hnum
      have hlt : ν x (shape (flowerSigma U δ B W) U x ∩ {u : SL3 | u • x ∈ Bᶜ}) < ⊤ :=
        lt_of_le_of_lt (measure_mono Set.inter_subset_left) (by rw [hshapex]; exact hmx.2)
      rw [ENNReal.toReal_eq_zero_iff] at hnum
      rcases hnum with h | h
      · exact h
      · exact absurd h (ne_of_lt hlt)
    have hsub : (V δ ∩ (U : Set SL3)) \ {1}
        ⊆ shape (flowerSigma U δ B W) U x ∩ {u : SL3 | u • x ∈ Bᶜ} := by
      intro u hu
      refine ⟨?_, ?_⟩
      · rw [hshapex]; exact hu.1
      · by_contra h
        exact hu.2 (hCS x hxB u hu.1.2 (by simpa using h))
    refine le_antisymm ?_ bot_le
    calc ν x ((V δ ∩ (U : Set SL3)) \ {1})
        ≤ ν x (shape (flowerSigma U δ B W) U x ∩ {u : SL3 | u • x ∈ Bᶜ}) := measure_mono hsub
      _ = 0 := h0
  have hresμ : ∀ᵐ x ∂μ, x ∈ flowerSet U δ B Set.univ →
      ν x ((V δ ∩ (U : Set SL3)) \ {1}) = 0 :=
    (MeasureTheory.ae_restrict_iff' hZmeas).mp hres
  filter_upwards [hresμ, hZae] with x hx hxZ
  exact hx hxZ

/-! ## 6. Normalisation at the identity -/

lemma measurableSet_box1 {U : Subgroup SL3} (hUcl : IsClosed (U : Set SL3)) :
    MeasurableSet (Box1 U : Set SL3) := by
  have h : (Box1 U : Set SL3) = (U : Set SL3) ∩ {g : SL3 |
      ∀ i j, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1} := by
    ext g; simp [Box1]
  rw [h]
  refine hUcl.measurableSet.inter ?_
  rw [show {g : SL3 | ∀ i j,
      |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1}
      = ⋂ i : Fin 3, ⋂ j : Fin 3, {g : SL3 |
          |(g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1} from by
    ext g; simp]
  exact MeasurableSet.iInter fun i => MeasurableSet.iInter fun j =>
    (isClosed_le (by fun_prop : Continuous fun g : SL3 =>
      |((g : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)|)
      continuous_const).measurableSet

lemma one_mem_box1 (U : Subgroup SL3) : (1 : SL3) ∈ Box1 U := by
  refine ⟨U.one_mem, fun i j => ?_⟩
  have h1 : ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) = 1 := rfl
  rw [h1, Matrix.one_apply]
  split_ifs <;> simp

/-- A measure which is carried by `U`, vanishes off `{1}` and gives `Box1 U` mass `1` is `δ₁`. -/
lemma eq_dirac_one_of {U : Subgroup SL3} (hUcl : IsClosed (U : Set SL3)) {ν : Measure SL3}
    (hcarried : ν ((U : Set SL3)ᶜ) = 0) (hoff : ν ((U : Set SL3) \ {1}) = 0)
    (hbox : ν (Box1 U) = 1) :
    ν = MeasureTheory.Measure.dirac (1 : SL3) := by
  have hcompl : ν (({1} : Set SL3)ᶜ) = 0 := by
    have hset : (({1} : Set SL3))ᶜ = ((U : Set SL3) \ {1}) ∪ (U : Set SL3)ᶜ := by
      ext u; constructor
      · intro hu
        by_cases hUu : u ∈ U
        · exact Or.inl ⟨hUu, by simpa using hu⟩
        · exact Or.inr hUu
      · rintro (h | h)
        · exact by simpa using h.2
        · intro h1
          exact h (by rw [h1]; exact U.one_mem)
    rw [hset]
    exact measure_union_null hoff hcarried
  have hdirac : ν = ν ({1} : Set SL3) • MeasureTheory.Measure.dirac (1 : SL3) := by
    refine MeasureTheory.Measure.ext fun A hA => ?_
    have hdiff : ν (A \ ({1} : Set SL3)) = 0 :=
      measure_mono_null (fun y hy => hy.2) hcompl
    have hadd : ν (A ∩ ({1} : Set SL3)) + ν (A \ ({1} : Set SL3)) = ν A :=
      MeasureTheory.measure_inter_add_sdiff A (MeasurableSet.singleton (1 : SL3))
    rw [hdiff, add_zero] at hadd
    rw [MeasureTheory.Measure.smul_apply, MeasureTheory.Measure.dirac_apply' _ hA]
    by_cases h1A : (1 : SL3) ∈ A
    · simp only [Set.indicator_of_mem h1A, Pi.one_apply, smul_eq_mul, mul_one]
      have hthis : A ∩ ({1} : Set SL3) = {1} :=
        Set.inter_eq_right.mpr (Set.singleton_subset_iff.mpr h1A)
      rw [← hadd, hthis]
    · simp only [Set.indicator_of_notMem h1A, smul_eq_mul, mul_zero]
      have hthis : A ∩ ({1} : Set SL3) = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        rintro y ⟨hy, hy1⟩
        have hy_eq : y = 1 := Set.mem_singleton_iff.mp hy1
        exact h1A (hy_eq ▸ hy)
      rw [← hadd, hthis, measure_empty]
  have hone : ν ({1} : Set SL3) = 1 := by
    have hmul : (ν ({1} : Set SL3) • MeasureTheory.Measure.dirac (1 : SL3)) (Box1 U)
        = ν (Box1 U) := by
      conv_rhs => rw [hdirac]
    rw [MeasureTheory.Measure.smul_apply, MeasureTheory.Measure.dirac_apply' _
      (measurableSet_box1 hUcl), Set.indicator_of_mem (one_mem_box1 U), Pi.one_apply] at hmul
    simp only [smul_eq_mul, mul_one, hbox] at hmul
    exact hmul
  rw [hdirac, hone, one_smul]

/-! ## 7. The main theorem -/

theorem crossSection_trivial (h2 : Work.EKLContract.P_X3) {U : Subgroup Work.EKLContract.SL3}
    (hU : Work.EKLContract.IsHoro U) {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (hfree : ∀ᵐ x ∂μ, ∀ u ∈ U, u • x = x → u = 1)
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3} (hI : Work.EKLContract.IsLeafwise μ U ν X')
    (hCS : Work.EKLContract.CrossSection μ U) :
    ∀ᵐ x ∂μ, ν x = MeasureTheory.Measure.dirac 1 := by
  obtain ⟨B, hBmeas, hBnull, hCSprop⟩ := hCS
  have hUcl : IsClosed (U : Set SL3) := hU.1
  haveI : PolishSpace X3 := h2.2.1
  haveI : T2Space X3 := h2.1
  -- a countable family of open sets which separates the points of `B` and contains `X₃`
  obtain ⟨basis, hbas⟩ := TopologicalSpace.exists_seq_basis X3
  set W : ℕ → Set X3 := fun n => if n = 0 then Set.univ else basis (n - 1) with hWdef
  have hW0 : W 0 = Set.univ := by simp [hWdef]
  have hWopen : ∀ n, IsOpen (W n) := by
    intro n
    by_cases hn : n = 0
    · rw [hWdef]; simp [hn]
    · rw [hWdef]; simp only [hn, if_false]
      exact hbas.isOpen (Set.mem_range_self (n - 1))
  have hsep : ∀ b ∈ B, ∀ b' ∈ B, (∀ n, b ∈ W n ↔ b' ∈ W n) → b = b' := by
    intro b hb b' hb' hpat
    by_contra hne
    obtain ⟨u, v, hu, hv, hbu, hb'v, hdisj⟩ := t2_separation hne
    obtain ⟨t, ht, hbt, htu⟩ := (hbas.isOpen_iff.mp hu) b hbu
    obtain ⟨m, rfl⟩ := ht
    have h1 : b ∈ W (m + 1) := by
      rw [hWdef]; simp only [Nat.succ_ne_zero, if_false]
      simpa using hbt
    have h2 : b' ∉ W (m + 1) := by
      rw [hWdef]; simp only [Nat.succ_ne_zero, if_false]
      intro hmem
      exact (Set.disjoint_left.mp hdisj (htu hmem)) hb'v
    exact h2 ((hpat (m + 1)).mp h1)
  -- at every scale, `ν x` charges the box `V (n+1) ∩ U` only at the identity
  have key : ∀ n : ℕ, ∀ᵐ x ∂μ, ν x ((V ((n : ℝ) + 1) ∩ (U : Set SL3)) \ {1}) = 0 := by
    intro n
    have hδ : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have hpla := isPlaqueAlgebra_flower h2 hUcl hBmeas hCSprop hWopen hW0 hsep hδ
    have hZnull : μ (flowerSet U ((n : ℝ) + 1) B Set.univ)ᶜ = 0 :=
      measure_mono_null (Set.compl_subset_compl.mpr (B_subset_flowerSet hδ)) hBnull
    have hshape : ∀ x ∈ B, shape (flowerSigma U ((n : ℝ) + 1) B W) U x
        = V ((n : ℝ) + 1) ∩ (U : Set SL3) := by
      intro x hxB
      have h := shape_flower (U := U) (B := B) hCSprop hW0 hsep hδ (v := 1)
        ((Work.EKLContract.Lemmas.V_open_one ((n : ℝ) + 1) hδ).2) U.one_mem (b := x) hxB
        (x := x) (by rw [one_smul])
      rw [h]
      ext u
      constructor
      · rintro ⟨huU, huv⟩; rw [mul_one] at huv; exact ⟨huv, huU⟩
      · rintro ⟨huv, huU⟩; exact ⟨huU, by rwa [mul_one]⟩
    exact flower_null_ae hI hBmeas hBnull hCSprop hδ hpla hZnull hshape
  have hall : ∀ᵐ x ∂μ, ∀ n : ℕ,
      ν x ((V ((n : ℝ) + 1) ∩ (U : Set SL3)) \ {1}) = 0 :=
    MeasureTheory.ae_all_iff.mpr key
  have hXae : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hI.conull
  filter_upwards [hall, hXae] with x hx hxX
  -- `U ∖ {1}` is the union of the boxes
  have hUeq : ((U : Set SL3) \ {1})
      = Set.iUnion (fun n : ℕ => ((V ((n : ℝ) + 1) ∩ (U : Set SL3)) \ {1})) := by
    ext u
    simp only [Set.mem_sdiff, Set.mem_singleton_iff, Set.mem_iUnion]
    constructor
    · rintro ⟨huU, hu1⟩
      obtain ⟨M, hM⟩ : ∃ M : ℝ, ∀ i j,
          |(u : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < M := by
        refine ⟨(Finset.univ.sup' Finset.univ_nonempty (fun p : Fin 3 × Fin 3 =>
          |(u : Matrix (Fin 3) (Fin 3) ℝ) p.1 p.2
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) p.1 p.2|)) + 1, ?_⟩
        intro i j
        have hle := Finset.le_sup' (f := fun p : Fin 3 × Fin 3 =>
          |(u : Matrix (Fin 3) (Fin 3) ℝ) p.1 p.2
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) p.1 p.2|) (Finset.mem_univ (i, j))
        linarith
      obtain ⟨N, hN⟩ := exists_nat_gt M
      exact ⟨N, ⟨⟨fun i j => lt_of_lt_of_le (hM i j) (by linarith), huU⟩, hu1⟩⟩
    · rintro ⟨n, huU, hu1⟩
      exact ⟨huU.2, hu1⟩
  have hzeroU : ν x ((U : Set SL3) \ {1}) = 0 := by
    rw [hUeq]
    exact measure_iUnion_null fun n => hx n
  exact eq_dirac_one_of hUcl (hI.carried x hxX) hzeroU (hI.normalised x hxX)

end Work.EKLRelCross
