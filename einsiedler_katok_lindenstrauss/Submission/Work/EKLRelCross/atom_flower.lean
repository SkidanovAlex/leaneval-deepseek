import Mathlib
import Submission.Work.EKLRelCross.flower
import Submission.Work.EKLContract.All

/-!
# `Work.EKLRelCross.atom_flower` — the atom of the flower σ-algebra at a plaque point

Let `U ≤ SL₃(ℝ)` be a subgroup, `B ⊆ X₃` a `U`-cross-section (no non-trivial `u ∈ U` maps a point
of `B` back into `B`), and `W : ℕ → Set X₃` a countable family with `W 0 = X₃` which *separates*
the points of `B`.  For `δ > 0`, `v ∈ V δ ∩ U` and `b ∈ B`, the atom of `x = v • b` in the
σ-algebra generated by the flower sets `n ↦ flowerSet U δ B (W n)` is exactly the plaque
`(V δ ∩ U) • b`.

The key computation (lemma `flowerSet_mem_iff_of_mem`) is that a point of the form `u • b'` with
`u ∈ V δ ∩ U` and `b' ∈ B` belongs to `flowerSet U δ B (W n)` **iff** `b' ∈ W n`: the cross-section
property makes the `V δ ∩ U`-translate of a point of `B` unique.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLRelCross

open Work.EKLContract

/-- **The flower membership of a plaque point.**  If `u ∈ V δ ∩ U` and `b' ∈ B`, then
`u • b'` lies in the flower set `flowerSet U δ B W` exactly when `b' ∈ W`.

The forward implication is where the cross-section property is used: any `w ∈ V δ⁻¹ ∩ U`
carrying `u • b'` back into `B` must satisfy `w * u = 1`, hence `w • (u • b') = b'`. -/
lemma flowerSet_mem_iff_of_mem {U : Subgroup SL3} {δ : ℝ} {B W : Set X3}
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1)
    {u : SL3} (hu : u ∈ V δ ∩ (U : Set SL3)) {b' : X3} (hb' : b' ∈ B) :
    u • b' ∈ flowerSet U δ B W ↔ b' ∈ W := by
  constructor
  · rintro ⟨w, ⟨_hwU, hwU'⟩, hwy⟩
    have hmemB : (w * u) • b' ∈ B := by rw [mul_smul]; exact hwy.1
    have h1 : w * u = 1 := hCS b' hb' (w * u) (U.mul_mem hwU' hu.2) hmemB
    have : w • (u • b') = b' := by rw [← mul_smul, h1, one_smul]
    rw [this] at hwy
    exact hwy.2
  · intro hb'W
    refine ⟨u⁻¹, ⟨?_, U.inv_mem hu.2⟩, ?_⟩
    · show (u⁻¹)⁻¹ ∈ V δ
      rw [inv_inv]
      exact hu.1
    · show u⁻¹ • (u • b') ∈ B ∩ W
      have : u⁻¹ • (u • b') = b' := by rw [← mul_smul, inv_mul_cancel, one_smul]
      rw [this]
      exact ⟨hb', hb'W⟩

theorem atom_flower {U : Subgroup Work.EKLContract.SL3} {B : Set Work.EKLContract.X3}
    (hCS : ∀ x ∈ B, ∀ u ∈ U, u • x ∈ B → u = 1)
    {W : ℕ → Set Work.EKLContract.X3} (hW0 : W 0 = Set.univ)
    (hsep : ∀ b ∈ B, ∀ b' ∈ B, (∀ n, b ∈ W n ↔ b' ∈ W n) → b = b')
    {δ : ℝ} (hδ : 0 < δ) {v : Work.EKLContract.SL3} (hv : v ∈ Work.EKLContract.V δ)
    (hvU : v ∈ U) {b : Work.EKLContract.X3} (hb : b ∈ B) :
    ∀ {x : Work.EKLContract.X3}, x = v • b →
      Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ B W) x
        = (fun u : Work.EKLContract.SL3 => u • b) '' (Work.EKLContract.V δ ∩ (U : Set Work.EKLContract.SL3)) := by
  rintro x rfl
  -- The atom at `v • b` is the class of points with the same `(W n)`-membership as `b`.
  have key : ∀ y : X3, y ∈ atom (flowerSigma U δ B W) (v • b)
      ↔ ∀ n, y ∈ flowerSet U δ B (W n) ↔ b ∈ W n := by
    intro y
    rw [show flowerSigma U δ B W
        = MeasurableSpace.generateFrom (Set.range (fun n => flowerSet U δ B (W n))) from rfl,
      mem_atom_iff_pattern]
    constructor
    · intro h n
      exact (h _ ⟨n, rfl⟩).trans (flowerSet_mem_iff_of_mem hCS ⟨hv, hvU⟩ hb)
    · intro h A hA
      obtain ⟨n, rfl⟩ := hA
      exact (h n).trans (flowerSet_mem_iff_of_mem hCS ⟨hv, hvU⟩ hb).symm
  ext y
  constructor
  · -- `atom ⊆ (V δ ∩ U) • b`: read off a translate of `y` into `B`, then separate via `W`.
    intro hy
    rw [key] at hy
    have hy0 : y ∈ flowerSet U δ B (W 0) := by rw [hy 0, hW0]; trivial
    obtain ⟨w, ⟨hw, hwU⟩, hwy⟩ := hy0
    set b' : X3 := w • y with hb'def
    have hb'B : b' ∈ B := by rw [hb'def]; exact hwy.1
    have hy_eq : y = w⁻¹ • b' := by rw [hb'def, ← mul_smul, inv_mul_cancel, one_smul]
    have hpat' : ∀ n, y ∈ flowerSet U δ B (W n) ↔ b' ∈ W n := by
      intro n
      rw [hy_eq]
      exact flowerSet_mem_iff_of_mem hCS ⟨hw, U.inv_mem hwU⟩ hb'B
    have hb'b : b' = b := hsep b' hb'B b hb (fun n => (hpat' n).symm.trans (hy n))
    refine ⟨w⁻¹, ⟨hw, U.inv_mem hwU⟩, ?_⟩
    rw [← hb'b]
    exact hy_eq.symm
  · -- `(V δ ∩ U) • b ⊆ atom`: every translate of `b` has the same flower pattern.
    rintro ⟨u, ⟨hu, huU⟩, rfl⟩
    rw [key]
    intro n
    exact flowerSet_mem_iff_of_mem hCS ⟨hu, huU⟩ hb

end Work.EKLRelCross
