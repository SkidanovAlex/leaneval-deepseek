import Mathlib
import Submission.Work.EKLRelCross.flower
import Submission.Work.EKLComp.X3Background

/-!
# `Work.EKLRelCross.meas_free_atoms` — the union of atoms over the free cross-section points

Let `W : ℕ → Set X₃` be a countable family with `W 0 = X₃` whose generated σ-algebra is the Borel
σ-algebra of `X₃`, and let `σ = flowerSigma U δ C W` be the σ-algebra generated by the flower
sets `n ↦ flowerSet U δ C (W n)`.

The lemma states that the union of the `σ`-atoms centred at the points of the *free* part of `C`,

  `⋃ c ∈ (C ∩ {x | ∀ u ∈ U, u • x = x → u = 1}), [c]_σ`,

is `σ`-measurable.

**Proof.**  The two maps

  `P x n = (x ∈ W n)`,  `F y n = (y ∈ flowerSet U δ C (W n))`

are the "patterns" of a point with respect to `W` and to the generating family of `σ`.  Because
`borel X₃ = generateFrom (range W)`, the map `P` is measurable; because moreover the atoms of the
Borel σ-algebra of `X₃` are the singletons, `P` is *injective*: two points with the same `W`-pattern
lie in the same atom of `borel X₃`, hence are equal.  As `X₃` is standard Borel, an injective
measurable map is a `MeasurableEmbedding` (`Measurable.measurableEmbedding`), so `P '' C₀` is
measurable for every Borel `C₀`; and `F` is measurable for `σ` because `F ⁻¹' {f | f n = true}` is
the generator `flowerSet U δ C (W n)`.

The hypothesis `hpat` identifies the `σ`-atom at `c ∈ C` with the fibre of `P c` under `F`:
`y ∈ [c]_σ ↔ F y = P c`.  Hence

  `⋃ c ∈ A, [c]_σ = F ⁻¹' (P '' A)`  for `A = C ∩ {free points}`,

which is `σ`-measurable as the preimage under the `σ`-measurable `F` of the measurable set
`P '' A` (measurable since `A` is Borel, by `hCmeas` and `hFree`).
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

open MeasureTheory

namespace Work.EKLRelCross

open Work.EKLContract

theorem meas_free_atoms {U : Subgroup Work.EKLContract.SL3} {C : Set Work.EKLContract.X3} {δ : ℝ}
    {W : ℕ → Set Work.EKLContract.X3} (hW0 : W 0 = Set.univ)
    (hWgen : borel Work.EKLContract.X3 = MeasurableSpace.generateFrom (Set.range W))
    (hsub : Work.EKLRelCross.flowerSigma U δ C W ≤ borel Work.EKLContract.X3)
    (hCmeas : MeasurableSet C)
    (hFree : MeasurableSet {x : Work.EKLContract.X3 | ∀ u ∈ U, u • x = x → u = 1})
    (hpat : ∀ c ∈ C, ∀ y : Work.EKLContract.X3,
      y ∈ Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c ↔
        ∀ n, (y ∈ Work.EKLRelCross.flowerSet U δ C (W n) ↔ c ∈ W n))
    (huniq : ∀ x : Work.EKLContract.X3,
      (∃ c ∈ C, x ∈ Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c) →
      ∃! c, c ∈ C ∧ x ∈ Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c) :
    @MeasurableSet Work.EKLContract.X3 (Work.EKLRelCross.flowerSigma U δ C W)
      (⋃ c ∈ (C ∩ {x : Work.EKLContract.X3 | ∀ u ∈ U, u • x = x → u = 1}),
        Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c) := by
  classical
  haveI hSB : StandardBorelSpace X3 := Work.EKLComp.X3Background.2.2.2.2
  let S : ℕ → Set X3 := fun n => flowerSet U δ C (W n)
  let P : X3 → (ℕ → Bool) := fun x n => decide (x ∈ W n)
  let F : X3 → (ℕ → Bool) := fun y n => decide (y ∈ S n)
  -- The `W`-pattern map `P` is measurable, because `W` generates the Borel σ-algebra.
  have hPmeas : Measurable P := by
    rw [measurable_pi_iff]
    intro n
    refine measurable_to_bool ?_
    have hpre : (fun x : X3 => P x n) ⁻¹' {true} = W n := by
      ext x; simp only [Set.mem_preimage, Set.mem_singleton_iff, P, Bool.decide_iff]
    rw [hpre]
    have hWn : MeasurableSet (W n) := by
      have h := MeasurableSpace.measurableSet_generateFrom (s := Set.range W)
        (Set.mem_range_self n)
      rw [← hWgen] at h; exact h
    exact hWn
  -- The `W`-pattern map `P` is injective: the atoms of the Borel σ-algebra are singletons.
  have hPinj : Function.Injective P := by
    intro x y hxy
    have hpat1 : ∀ n, (x ∈ W n ↔ y ∈ W n) := fun n =>
      decide_eq_decide.mp (congr_fun hxy n)
    have hy : y ∈ atom (MeasurableSpace.generateFrom (Set.range W)) x := by
      rw [mem_atom_iff_pattern]
      rintro A ⟨n, rfl⟩
      exact (hpat1 n).symm
    rw [← hWgen] at hy
    have hsubA : atom (borel X3) x ⊆ {x} :=
      atom_subset_of_mem (m := borel X3) (s := {x})
        (show MeasurableSet[borel X3] {x} from measurableSet_singleton x) rfl
    have : y = x := by simpa using hsubA hy
    exact this.symm
  -- Hence `P` is a measurable embedding, so it maps Borel sets to measurable sets.
  have hAmeas : MeasurableSet (C ∩ {x : X3 | ∀ u ∈ U, u • x = x → u = 1}) :=
    hCmeas.inter hFree
  have hPemb : MeasurableEmbedding P := Measurable.measurableEmbedding hPmeas hPinj
  have hPimage : MeasurableSet (P '' (C ∩ {x : X3 | ∀ u ∈ U, u • x = x → u = 1})) :=
    hPemb.measurableSet_image.2 hAmeas
  -- The flower-pattern map `F` is measurable for `σ`, its coordinates being the generators.
  have hFmeas : @Measurable X3 (ℕ → Bool) (flowerSigma U δ C W) _ F := by
    rw [show @Measurable X3 (ℕ → Bool) (flowerSigma U δ C W) _ F ↔
          ∀ n, @Measurable X3 Bool (flowerSigma U δ C W) _ (fun y => F y n) from
        @measurable_pi_iff X3 ℕ (fun _ => Bool) (flowerSigma U δ C W)
          (fun _ => (inferInstance : MeasurableSpace Bool)) F]
    intro n
    refine measurable_to_bool (mα := flowerSigma U δ C W) (f := fun y => F y n) ?_
    have hpre : (fun y : X3 => F y n) ⁻¹' {true} = S n := by
      ext y; simp only [Set.mem_preimage, Set.mem_singleton_iff, F, Bool.decide_iff]
    rw [hpre]
    exact MeasurableSpace.measurableSet_generateFrom (s := Set.range S) (Set.mem_range_self n)
  -- `hpat` says that the atom of `c ∈ C` is the `F`-fibre of its `W`-pattern.
  have hE : (⋃ c ∈ (C ∩ {x : X3 | ∀ u ∈ U, u • x = x → u = 1}),
        atom (flowerSigma U δ C W) c)
      = F ⁻¹' (P '' (C ∩ {x : X3 | ∀ u ∈ U, u • x = x → u = 1})) := by
    ext y
    simp only [Set.mem_iUnion, Set.mem_preimage, Set.mem_image]
    constructor
    · rintro ⟨c, hcA, hyc⟩
      refine ⟨c, hcA, ?_⟩
      have h := (hpat c hcA.1 y).mp hyc
      funext n
      show decide (c ∈ W n) = decide (y ∈ S n)
      exact decide_eq_decide.mpr (h n).symm
    · rintro ⟨c, hcA, hPF⟩
      refine ⟨c, hcA, (hpat c hcA.1 y).mpr (fun n => ?_)⟩
      have h2 : decide (c ∈ W n) = decide (y ∈ S n) := congr_fun hPF n
      exact (decide_eq_decide.mp h2).symm
  rw [hE]
  exact hFmeas hPimage

end Work.EKLRelCross
