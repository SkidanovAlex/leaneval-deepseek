import Mathlib
import Submission.Work.EKLContract.All
import Submission.Work.EKLRelCross.Instances
import Submission.Work.EKLComp.PlaqueToolkit
import Submission.Work.EKLProd.shape_orbitImage

/-!
# `Work.EKLRelCross.plaqueDensity`

The `μ`-average of a bounded measurable function over an orbit plaque of `U` at `x₀` is, up to
the normalising factor `(μ P)⁻¹`, the `ν x₀`-average over the box `V ε ∩ U`.  This is the
`condexp` field of `Work.EKLContract.IsLeafwise` for the plaque algebra generated by the single
orbit plaque `P = (V ε ∩ U) • x₀`, evaluated *at the base point* `x₀` instead of `μ`-a.e.

The passage from the a.e. statement to the statement at `x₀` is the usual constancy argument:
the left hand side does not depend on the point, while the right hand side is invariant under
right translation of the base point along the `U`-orbit (`ratio_translate_general` below, which
uses the `equivariant` field of `IsLeafwise`).
-/

namespace Work.EKLRelCross

open MeasureTheory Filter Topology
open scoped ENNReal
open Work.EKLContract
open Work.EKLComp

noncomputable section
set_option maxHeartbeats 1000000
set_option linter.unusedVariables false

variable {U : Subgroup SL3} {ν : X3 → Measure SL3} {X' : Set X3}

/-- `1 ∈ V ε` for `ε > 0`. -/
lemma oneMemV {ε : ℝ} (hε : 0 < ε) : (1 : SL3) ∈ V ε := by
  intro i j
  rw [Matrix.SpecialLinearGroup.coe_one, sub_self, abs_zero]
  exact hε

/-- **Shape at the base point of an orbit plaque.** -/
lemma shapePlaque_base {x₀ : X3} {ε : ℝ} (hε : 0 < ε)
    (hinj : ∀ a ∈ U, ∀ b ∈ U, a • x₀ = b • x₀ → a = b) :
    shape (plaqueSigma U x₀ ε) U x₀ = V ε ∩ (U : Set SL3) := by
  have h := Work.EKLProd.shape_orbitImage U x₀ (V ε ∩ (U : Set SL3)) Set.inter_subset_right hinj
      (1 : SL3) ⟨oneMemV hε, U.one_mem⟩
  rw [one_smul] at h
  change shape (MeasurableSpace.generateFrom
      {(fun u : SL3 => u • x₀) '' (V ε ∩ (U : Set SL3))}) U x₀ = V ε ∩ (U : Set SL3)
  rw [h]
  ext u
  simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, SetLike.mem_coe, mul_one]
  exact ⟨fun h => ⟨h.2.1, h.1⟩, fun h => ⟨h.2, h.1, h.2⟩⟩

/-- **Shape at a translate of the base point of an orbit plaque.** -/
lemma shapePlaque_translate {x₀ : X3} {ε : ℝ} {u₁ : SL3}
    (hu₁ : u₁ ∈ V ε ∩ (U : Set SL3))
    (hinj : ∀ a ∈ U, ∀ b ∈ U, a • x₀ = b • x₀ → a = b) :
    shape (plaqueSigma U x₀ ε) U (u₁ • x₀) = {u : SL3 | u ∈ U ∧ u * u₁ ∈ V ε} := by
  have h := Work.EKLProd.shape_orbitImage U x₀ (V ε ∩ (U : Set SL3)) Set.inter_subset_right hinj
      u₁ hu₁
  change shape (MeasurableSpace.generateFrom
      {(fun u : SL3 => u • x₀) '' (V ε ∩ (U : Set SL3))}) U (u₁ • x₀)
    = {u : SL3 | u ∈ U ∧ u * u₁ ∈ V ε}
  rw [h]
  ext u
  exact ⟨fun h => ⟨h.1, h.2.1⟩, fun h => ⟨h.1, h.2, U.mul_mem h.1 hu₁.2⟩⟩

/-- **The `ν`-average over the plaque shape is invariant under translating the base point**
along the `U`-orbit of `x₀`.  This is the general-function form of the indicator-function
statement `ratio_translate` (in `Submission/Work/EKLRelCross/plaque_identity_base.lean`), and is
obtained from the `equivariant` field of `IsLeafwise` together with the change of variables
`g ↦ g * u₁⁻¹`. -/
lemma ratio_translate_general {μ : Measure X3} [IsProbabilityMeasure μ]
    (hL : IsLeafwise μ U ν X') {x₀ : X3} (hX0 : x₀ ∈ X')
    {ε : ℝ} (hε : 0 < ε) {u₁ : SL3} (hu₁ : u₁ ∈ V ε ∩ (U : Set SL3))
    (hxX : u₁ • x₀ ∈ X') (hUc : IsClosed (U : Set SL3))
    (hinj : ∀ a ∈ U, ∀ b ∈ U, a • x₀ = b • x₀ → a = b)
    {f : X3 → ℝ} (hf : Measurable f) :
    (∫ u in shape (plaqueSigma U x₀ ε) U (u₁ • x₀), f (u • (u₁ • x₀)) ∂(ν (u₁ • x₀)))
        / ((ν (u₁ • x₀)) (shape (plaqueSigma U x₀ ε) U (u₁ • x₀))).toReal
      = (∫ u in shape (plaqueSigma U x₀ ε) U x₀, f (u • x₀) ∂(ν x₀))
        / ((ν x₀) (shape (plaqueSigma U x₀ ε) U x₀)).toReal := by
  obtain ⟨c, hc0, hcT, hc⟩ := hL.equivariant x₀ hX0 u₁ hu₁.2 hxX
  have hm1 : Measurable (fun g : SL3 => g * u₁) := (continuous_id.mul continuous_const).measurable
  have hm2 : Measurable (fun g : SL3 => g * u₁⁻¹) :=
    (continuous_id.mul continuous_const).measurable
  have hcomp : (fun g : SL3 => g * u₁⁻¹) ∘ (fun g : SL3 => g * u₁) = id := by
    funext g; simp
  have hmap : ν (u₁ • x₀) = c⁻¹ • (ν x₀).map (fun g : SL3 => g * u₁⁻¹) := by
    have key : (ν x₀).map (fun g : SL3 => g * u₁⁻¹) = c • (ν (u₁ • x₀)) := by
      rw [hc, Measure.map_smul, Measure.map_map hm2 hm1, hcomp, Measure.map_id] <;> try fun_prop
    rw [key, smul_smul, ENNReal.inv_mul_cancel hc0 hcT, one_smul]
  have hsh1 := shapePlaque_translate (U := U) (x₀ := x₀) (ε := ε) hu₁ hinj
  have hsh0 := shapePlaque_base (U := U) (x₀ := x₀) (ε := ε) hε hinj
  have hs1 : MeasurableSet (shape (plaqueSigma U x₀ ε) U (u₁ • x₀)) := by
    rw [hsh1]
    have h1 : {u : SL3 | u ∈ U ∧ u * u₁ ∈ V ε}
        = (U : Set SL3) ∩ ((fun g : SL3 => g * u₁) ⁻¹' V ε) := by
      ext u; rw [Set.mem_inter_iff, Set.mem_preimage, Set.mem_ofPred_eq]; rfl
    rw [h1]
    exact hUc.measurableSet.inter
      (((Work.EKLComp.isOpen_V ε).preimage (continuous_id.mul continuous_const))).measurableSet
  have hs0 : MeasurableSet (shape (plaqueSigma U x₀ ε) U x₀) := by
    rw [hsh0]
    exact (Work.EKLComp.isOpen_V ε).measurableSet.inter hUc.measurableSet
  have hmem : ∀ g : SL3, g * u₁⁻¹ ∈ shape (plaqueSigma U x₀ ε) U (u₁ • x₀)
      ↔ g ∈ shape (plaqueSigma U x₀ ε) U x₀ := by
    intro g
    rw [hsh1, hsh0]
    constructor
    · rintro ⟨hcU, hcV⟩
      refine ⟨?_, ?_⟩
      · rwa [mul_assoc, inv_mul_cancel, mul_one] at hcV
      · have h' : (g * u₁⁻¹) * u₁ ∈ U := U.mul_mem hcU hu₁.2
        rwa [mul_assoc, inv_mul_cancel, mul_one] at h'
    · rintro ⟨hhV, hhU⟩
      exact ⟨U.mul_mem hhU (U.inv_mem hu₁.2), by rwa [mul_assoc, inv_mul_cancel, mul_one]⟩
  -- the change of variables, for an arbitrary measurable `F`
  have key : ∀ (F : SL3 → ℝ), Measurable F →
      ∫ u, (shape (plaqueSigma U x₀ ε) U (u₁ • x₀)).indicator F u ∂(ν (u₁ • x₀))
        = c⁻¹.toReal * ∫ u, (shape (plaqueSigma U x₀ ε) U (u₁ • x₀)).indicator F (u * u₁⁻¹)
            ∂(ν x₀) := by
    intro F hF
    rw [hmap, MeasureTheory.integral_smul_measure, smul_eq_mul]
    congr 1
    rw [MeasureTheory.integral_map (μ := ν x₀) (φ := fun g : SL3 => g * u₁⁻¹)
      (f := (shape (plaqueSigma U x₀ ε) U (u₁ • x₀)).indicator F)
      hm2.aemeasurable (hF.indicator hs1).aestronglyMeasurable]
  -- the numerator
  have hint : ∫ u in shape (plaqueSigma U x₀ ε) U (u₁ • x₀), f (u • (u₁ • x₀)) ∂(ν (u₁ • x₀))
      = c⁻¹.toReal * ∫ u in shape (plaqueSigma U x₀ ε) U x₀, f (u • x₀) ∂(ν x₀) := by
    have hF1 : Measurable (fun u : SL3 => f (u • (u₁ • x₀))) :=
      hf.comp (continuous_id.smul continuous_const).measurable
    rw [← MeasureTheory.integral_indicator (f := fun u : SL3 => f (u • (u₁ • x₀))) hs1,
      ← MeasureTheory.integral_indicator (f := fun g : SL3 => f (g • x₀)) hs0,
      key (fun u : SL3 => f (u • (u₁ • x₀))) hF1]
    congr 1
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun g => ?_))
    simp only []
    by_cases hg : g ∈ shape (plaqueSigma U x₀ ε) U x₀
    · have hg' : g * u₁⁻¹ ∈ shape (plaqueSigma U x₀ ε) U (u₁ • x₀) := (hmem g).mpr hg
      rw [Set.indicator_of_mem hg', Set.indicator_of_mem hg]
      congr 1
      rw [← mul_smul, mul_assoc, inv_mul_cancel, mul_one]
    · have hg' : g * u₁⁻¹ ∉ shape (plaqueSigma U x₀ ε) U (u₁ • x₀) :=
        fun h => hg ((hmem g).mp h)
      rw [Set.indicator_of_notMem hg', Set.indicator_of_notMem hg]
  -- the denominator
  have hden : ν (u₁ • x₀) (shape (plaqueSigma U x₀ ε) U (u₁ • x₀))
      = c⁻¹ * ν x₀ (shape (plaqueSigma U x₀ ε) U x₀) := by
    have hpre : (fun g : SL3 => g * u₁⁻¹) ⁻¹' shape (plaqueSigma U x₀ ε) U (u₁ • x₀)
        = shape (plaqueSigma U x₀ ε) U x₀ := by
      ext g; rw [Set.mem_preimage]; exact hmem g
    rw [hmap, Measure.smul_apply, Measure.map_apply hm2 hs1, hpre, smul_eq_mul]
  have hdenR : ((ν (u₁ • x₀)) (shape (plaqueSigma U x₀ ε) U (u₁ • x₀))).toReal
      = c⁻¹.toReal * ((ν x₀) (shape (plaqueSigma U x₀ ε) U x₀)).toReal := by
    rw [hden, ENNReal.toReal_mul]
  rw [hint, hdenR]
  have hcne : (c⁻¹).toReal ≠ 0 :=
    ENNReal.toReal_ne_zero.mpr ⟨ENNReal.inv_ne_zero.mpr hcT, ENNReal.inv_ne_top.mpr hc0⟩
  rw [mul_div_mul_left _ _ hcne]

/-- **Density of `μ` along an orbit plaque.**  The conditional average of a bounded measurable
`f` over the plaque `P = (V ε ∩ U) • x₀` is the normalised `ν x₀`-average of `f` over the box
`V ε ∩ U` at the base point. -/
theorem plaqueDensity (μ : MeasureTheory.Measure Work.EKLContract.X3)
    [MeasureTheory.IsProbabilityMeasure μ]
    (U : Subgroup Work.EKLContract.SL3) (hU : IsClosed (U : Set Work.EKLContract.SL3))
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3} (hL : Work.EKLContract.IsLeafwise μ U ν X')
    {x₀ : Work.EKLContract.X3} (hx₀ : x₀ ∈ X')
    (hfree : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    {ε : ℝ} (hε : 0 < ε) (hP : μ (Work.EKLComp.orbitPlaque U x₀ ε) ≠ 0)
    (f : Work.EKLContract.X3 → ℝ) (hf : Measurable f) (hfb : ∃ C, ∀ y, |f y| ≤ C) :
    (μ (Work.EKLComp.orbitPlaque U x₀ ε)).toReal⁻¹ * ∫ y in Work.EKLComp.orbitPlaque U x₀ ε, f y ∂μ
      = (∫ u in Work.EKLContract.V ε ∩ (U : Set Work.EKLContract.SL3),
            f (u • x₀) ∂(ν x₀))
          / (ν x₀ (Work.EKLContract.V ε ∩ (U : Set Work.EKLContract.SL3))).toReal := by
  have hZ : MeasurableSet (orbitPlaque U x₀ ε) := Work.EKLProd.borelOrbitImage U hU x₀ ε
  have hav := Work.EKLComp.plaque_average_eq hL hε hU hfree hP f hf hfb
  have hXae : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff, show {a : X3 | ¬ a ∈ X'} = X'ᶜ from rfl]
    exact hL.conull
  have hPmem : ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)), x ∈ orbitPlaque U x₀ ε :=
    (MeasureTheory.ae_restrict_iff' hZ).mpr (Filter.Eventually.of_forall (fun _ hx => hx))
  -- the right hand side is independent of the point of the plaque, so the a.e. form of the
  -- `condexp` field gives the value at the base point
  have hconst : ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)),
      (μ (orbitPlaque U x₀ ε)).toReal⁻¹ * ∫ y in orbitPlaque U x₀ ε, f y ∂μ
        = (∫ u in shape (plaqueSigma U x₀ ε) U x₀, f (u • x₀) ∂(ν x₀))
          / (ν x₀ (shape (plaqueSigma U x₀ ε) U x₀)).toReal := by
    filter_upwards [hav, MeasureTheory.ae_restrict_of_ae hXae, hPmem] with x havx hxX hxP
    obtain ⟨u₁, hu₁, rfl⟩ := hxP
    rw [havx]
    exact ratio_translate_general hL hx₀ hε hu₁ hxX hU hfree hf
  rw [shapePlaque_base (U := U) (x₀ := x₀) (ε := ε) hε hfree] at hconst
  by_contra hne
  have hfalse : ∀ᵐ x ∂(μ.restrict (orbitPlaque U x₀ ε)), False := by
    filter_upwards [hconst] with x hx
    exact hne hx
  have hz : (μ.restrict (orbitPlaque U x₀ ε)) Set.univ = 0 := by
    have h := (MeasureTheory.ae_iff).mp hfalse
    simpa using h
  rw [MeasureTheory.Measure.restrict_apply (s := orbitPlaque U x₀ ε) (t := Set.univ)
    MeasurableSet.univ, Set.univ_inter] at hz
  exact hP hz

end

end Work.EKLRelCross
