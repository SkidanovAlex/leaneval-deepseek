import Mathlib
import Submission.Work.EKLRelCross.flower
import Submission.Work.EKLProd.plaque_shape_mass
import Submission.Work.EKLRelCross.flower_balls

/-!
# `Work.EKLRelCross.shape_plaque_bdd` — the shape of a plaque of a bounded cross-section

Let `m = flowerSigma U δ C W` be the flower σ-algebra of a cross-section `C` (the σ-algebra
generated by the sets `n ↦ flowerSet U δ C (W n)`), and let `c ∈ X₃` be a point whose atom is
*exactly the plaque* `(V δ ∩ U) • c` (hypothesis `hatom`), and which is *free* for the action of
`U` (`hcF`: `u • c = c` with `u ∈ U` forces `u = 1`).

Then for any `v ∈ V δ ∩ U` the shape (Pisa Def. 6.2, `Work.EKLContract.shape`) of the plaque
point `v • c` is the (open) translate of the displacement box, cut by `U`:

  `shape m U (v • c) = {g : SL₃(ℝ) | g * v ∈ V δ} ∩ U`,

and it is entrywise bounded.

The proof is a two-line computation once one observes that `atom m (v • c) = atom m c`:
`v • c` lies in the atom of `c` (it is a plaque translate), and atoms of a σ-algebra generated by
a family are exactly the "same `S`-pattern" classes (`Work.EKLRelCross.mem_atom_iff_pattern`),
so equal patterns give equal atoms.  Injectivity of the orbit map `u ↦ u • c` on `U` — which is
exactly the freeness hypothesis `hcF` — then identifies the plaque translate `u • (v • c)` with
`(u * v) • c`.

Boundedness is `u = (u * v) * v⁻¹`: `u * v` is entrywise `≤ 1 + δ` and `v⁻¹` is entrywise bounded
by the `2 × 2`-minor estimate `Work.EKLProd.inv_entries_bound`.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

noncomputable section

namespace Work.EKLRelCross

open Work.EKLContract

/-! ## 1. Atoms of a generated σ-algebra are pattern classes -/

/-- Two points of `X₃` with the same `S`-pattern have the same atom in the σ-algebra generated
by `S`. -/
lemma atom_generateFrom_eq_of_pattern {S : Set (Set X3)} {x y : X3}
    (h : ∀ A ∈ S, (y ∈ A ↔ x ∈ A)) :
    atom (MeasurableSpace.generateFrom S) y = atom (MeasurableSpace.generateFrom S) x := by
  ext z
  rw [mem_atom_iff_pattern, mem_atom_iff_pattern]
  constructor
  · intro hz A hA
    exact (hz A hA).trans (h A hA)
  · intro hz A hA
    exact (hz A hA).trans (h A hA).symm

/-- A point of the atom of `x` has the same atom as `x`, for a generated σ-algebra. -/
lemma atom_generateFrom_eq_of_mem {S : Set (Set X3)} {x y : X3}
    (hy : y ∈ atom (MeasurableSpace.generateFrom S) x) :
    atom (MeasurableSpace.generateFrom S) y = atom (MeasurableSpace.generateFrom S) x :=
  atom_generateFrom_eq_of_pattern (S := S) (x := x) (y := y) (mem_atom_iff_pattern.mp hy)

/-! ## 2. Entrywise bound for `u` with `u * v ∈ V δ` -/

/-- If `v ∈ V δ` with `δ > 0`, then the set of `u` with `u * v ∈ V δ` is entrywise bounded:
`u = (u * v) * v⁻¹`, the first factor has entries `≤ 1 + δ` and the second is controlled by the
adjugate bound `Work.EKLProd.inv_entries_bound`. -/
lemma entries_le_of_mul_mem_V {δ : ℝ} (hδ : 0 < δ) {v : SL3} (hv : v ∈ V δ) :
    ∃ K : ℝ, ∀ u : SL3, u * v ∈ V δ → ∀ i j, |(u : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ K := by
  obtain ⟨C, hC⟩ := Work.EKLProd.inv_entries_bound δ hδ
  refine ⟨3 * (1 + δ) * C, fun u huv i j => ?_⟩
  have hA : ∀ k l, |((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 1 + δ :=
    fun k l => Work.EKLProd.mem_V_entries_le huv k l
  have hB : ∀ k l, |((v⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ C :=
    fun k l => hC v hv k l
  have hcoe : ((u : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
      = ((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) *
        ((v⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel_right]
  rw [hcoe, Matrix.mul_apply]
  calc |∑ k : Fin 3, ((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k *
          ((v⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j|
      ≤ ∑ k : Fin 3, |((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k *
          ((v⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j| := Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i k| *
          |((v⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, (1 + δ) * C := by
        refine Finset.sum_le_sum (fun k _ => ?_)
        exact mul_le_mul (hA i k) (hB k j) (abs_nonneg _) (by linarith)
    _ = 3 * (1 + δ) * C := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        ring

/-! ## 3. The shape of a plaque point -/

theorem shape_plaque_bdd {U : Subgroup Work.EKLContract.SL3} {C : Set Work.EKLContract.X3}
    {δ : ℝ} {W : ℕ → Set Work.EKLContract.X3} {c : Work.EKLContract.X3}
    (hcF : ∀ u ∈ U, u • c = c → u = 1)
    {v : Work.EKLContract.SL3} (hv : v ∈ Work.EKLContract.V δ) (hvU : v ∈ U)
    (hatom : Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c
      = (fun u : Work.EKLContract.SL3 => u • c) '' (Work.EKLContract.V δ ∩ (U : Set Work.EKLContract.SL3))) :
    (∃ O : Set Work.EKLContract.SL3, IsOpen O ∧
      Work.EKLContract.shape (Work.EKLRelCross.flowerSigma U δ C W) U (v • c)
        = O ∩ (U : Set Work.EKLContract.SL3)) ∧
    (∃ K : ℝ, ∀ u ∈ Work.EKLContract.shape (Work.EKLRelCross.flowerSigma U δ C W) U (v • c),
      ∀ i j : Fin 3, |u i j| ≤ K) := by
  classical
  -- `δ > 0`, since `v ∈ V δ` and the `(0,0)`-entry of `V δ` is `< δ` around `1`.
  have hδ : 0 < δ := by
    have h := hv 0 0
    have h0 : (0 : ℝ) ≤ |(v : Matrix (Fin 3) (Fin 3) ℝ) 0 0
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) 0 0| := abs_nonneg _
    linarith
  -- `v • c` is a plaque translate of `c`, hence lies in the atom of `c`.
  have hvc_mem : v • c ∈ Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c := by
    rw [hatom]
    exact ⟨v, ⟨hv, hvU⟩, rfl⟩
  -- ... and therefore has the same atom as `c`.
  have hatom_vc : Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) (v • c)
      = Work.EKLContract.atom (Work.EKLRelCross.flowerSigma U δ C W) c :=
    atom_generateFrom_eq_of_mem
      (S := Set.range (fun n => flowerSet U δ C (W n))) hvc_mem
  -- The shape: `u ∈ U` with `u • (v • c)` in the atom of `c`, i.e. `u * v ∈ V δ ∩ U`.
  have hshape : Work.EKLContract.shape (Work.EKLRelCross.flowerSigma U δ C W) U (v • c)
      = {g : SL3 | g * v ∈ V δ} ∩ (U : Set SL3) := by
    ext u
    constructor
    · intro hu
      obtain ⟨huU, huAtom⟩ := hu
      rw [hatom_vc, hatom] at huAtom
      obtain ⟨w, hw, hwEq⟩ := huAtom
      obtain ⟨hwV, hwU⟩ := hw
      have hEq2 : w • c = (u * v) • c := by
        rw [mul_smul]
        exact hwEq
      have h1 : (u * v)⁻¹ * w = 1 := by
        refine hcF _ ?_ ?_
        · exact U.mul_mem (U.inv_mem (U.mul_mem huU hvU)) hwU
        · rw [mul_smul, hEq2, inv_smul_smul]
      refine ⟨?_, huU⟩
      show u * v ∈ V δ
      rw [inv_mul_eq_one.mp h1]
      exact hwV
    · rintro ⟨huvV, huU⟩
      refine ⟨huU, ?_⟩
      rw [hatom_vc, hatom]
      exact ⟨u * v, ⟨huvV, U.mul_mem huU hvU⟩, mul_smul u v c⟩
  refine ⟨⟨{g : SL3 | g * v ∈ V δ}, ?_, hshape⟩, ?_⟩
  · exact (isOpen_V δ).preimage (by fun_prop)
  · obtain ⟨K, hK⟩ := entries_le_of_mul_mem_V hδ hv
    refine ⟨K, fun u hu i j => ?_⟩
    have huv : u * v ∈ V δ := by
      have h2 := hu
      rw [hshape] at h2
      exact h2.1
    exact hK u huv i j

end Work.EKLRelCross
