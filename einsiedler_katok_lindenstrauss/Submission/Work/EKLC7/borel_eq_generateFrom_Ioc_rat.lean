import Mathlib

namespace Work.EKLC7

open MeasureTheory Set

/-- **The Borel σ-algebra of `ℝ` is generated by rational half-open intervals.**

Every `Ioc q r` with `q r : ℚ` is Borel (the set is a half-open interval), which gives one
inclusion.  Conversely, `Dense.borel_eq_generateFrom_Ioc_mem` applied to the dense set
`range ((↑) : ℚ → ℝ)` shows that the Borel σ-algebra is generated by the `Ioc l u` whose
endpoints lie in that range; that family is contained in the family of rational half-open
intervals, so `generateFrom_mono` gives the other inclusion. -/
theorem borel_eq_generateFrom_Ioc_rat :
    (borel ℝ) = MeasurableSpace.generateFrom {s : Set ℝ | ∃ a b : ℚ, s = Set.Ioc (a : ℝ) (b : ℝ)} := by
  refine le_antisymm ?_ ?_
  · -- `borel ℝ ≤ generateFrom {Ioc q r}`: the Borel σ-algebra is even generated by the
    -- `Ioc l u` with endpoints in the dense set `range (ℚ → ℝ)`, which is a subfamily.
    rw [Dense.borel_eq_generateFrom_Ioc_mem
      (show Dense (range ((↑) : ℚ → ℝ)) from Rat.denseRange_cast)]
    exact MeasurableSpace.generateFrom_mono (by
      rintro S ⟨l, ⟨q, rfl⟩, u, ⟨r, rfl⟩, -, hEq⟩
      exact ⟨q, r, hEq.symm⟩)
  · -- `generateFrom {Ioc q r} ≤ borel ℝ`: each rational half-open interval is Borel.
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨a, b, rfl⟩
    exact measurableSet_Ioc

end Work.EKLC7
