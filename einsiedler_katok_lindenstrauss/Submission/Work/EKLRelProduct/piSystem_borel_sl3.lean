import Mathlib
import Submission.Work.EKLContract.Defs

set_option linter.style.haveILetI false

namespace Work.EKLRelProduct

/-- In a second-countable space, the Borel σ-algebra is generated by a countable π-system which
contains the whole space: take the finite intersections of a countable basis. -/
theorem exists_countable_piSystem_borel {α : Type*} [TopologicalSpace α]
    [SecondCountableTopology α] :
    ∃ C : Set (Set α), IsPiSystem C ∧ MeasurableSpace.generateFrom C = borel α ∧
      C.Countable ∧ (Set.univ : Set α) ∈ C := by
  obtain ⟨b, hbc, -, hb⟩ := TopologicalSpace.exists_countable_basis α
  set C : Set (Set α) := (fun T : Set (Set α) => ⋂₀ T) '' {T | T.Finite ∧ T ⊆ b} with hC
  have hCmem : ∀ T : Set (Set α), T.Finite → T ⊆ b → (⋂₀ T) ∈ C :=
    fun T hTfin hTb => ⟨T, ⟨hTfin, hTb⟩, rfl⟩
  have hbC : b ⊆ C := by
    intro s hs
    have h := hCmem {s} (Set.finite_singleton s) (Set.singleton_subset_iff.mpr hs)
    rwa [Set.sInter_singleton] at h
  refine ⟨C, ?_, ?_, ?_, ?_⟩
  · rintro s ⟨S, ⟨hSfin, hSb⟩, hSeq⟩ t ⟨T, ⟨hTfin, hTb⟩, hTeq⟩ -
    subst hSeq
    subst hTeq
    exact ⟨S ∪ T, ⟨hSfin.union hTfin, Set.union_subset hSb hTb⟩, Set.sInter_union S T⟩
  · rw [hb.borel_eq_generateFrom]
    refine le_antisymm ?_ (MeasurableSpace.generateFrom_mono hbC)
    refine MeasurableSpace.generateFrom_le ?_
    rintro t ⟨T, ⟨hTfin, hTb⟩, rfl⟩
    change @MeasurableSet α (MeasurableSpace.generateFrom b) (⋂₀ T)
    rw [Set.sInter_eq_biInter]
    exact MeasurableSet.biInter hTfin.countable
      (fun x hx => MeasurableSpace.measurableSet_generateFrom (hTb hx))
  · rw [hC]
    exact Set.Countable.image (Set.countable_ofPred_finite_subset hbc) _
  · have h := hCmem ∅ Set.finite_empty (Set.empty_subset b)
    rwa [Set.sInter_empty] at h

theorem piSystem_borel_sl3 :
    ∃ C : Set (Set Work.EKLContract.SL3),
      IsPiSystem C ∧ MeasurableSpace.generateFrom C = borel Work.EKLContract.SL3 ∧
      C.Countable ∧ (Set.univ : Set Work.EKLContract.SL3) ∈ C ∧
      ∃ Bs : ℕ → Set Work.EKLContract.SL3, (⋃ i, Bs i) = Set.univ ∧ ∀ i, Bs i ∈ C := by
  haveI : SecondCountableTopology (Matrix (Fin 3) (Fin 3) ℝ) :=
    (inferInstance : SecondCountableTopology (Fin 3 → Fin 3 → ℝ))
  haveI : SecondCountableTopology Work.EKLContract.SL3 :=
    TopologicalSpace.Subtype.secondCountableTopology
      ({A : Matrix (Fin 3) (Fin 3) ℝ | A.det = 1})
  obtain ⟨C, hpi, hgen, hcount, huniv⟩ :=
    exists_countable_piSystem_borel (α := Work.EKLContract.SL3)
  exact ⟨C, hpi, hgen, hcount, huniv,
    ⟨fun _ => Set.univ, by simp [Set.iUnion_const], fun _ => huniv⟩⟩

end Work.EKLRelProduct
