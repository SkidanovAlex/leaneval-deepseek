/-!
# `Work.EKLC6Core.exists_desc_subordinate` — L1 of C6 (Pisa 7.37/7.38)

For a probability measure `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)`, a closed `aDiag t`-normalised subgroup
`U ≤ SL₃(ℝ)` contracted by `aDiag t` (and `aDiag t`-invariant `μ`), there is, for every
`ε > 0`, a countably generated σ-algebra `A` and a set `Z` with `IsPlaqueAlgebra U Z A`,
`μ Zᶜ < ε` and `comap (aDiag t ·) A ≤ A`.

The strategy (Pisa Prop. 7.37, proof 7.38): cover a `μ`-large part of `X₃` by a countable
family of pairwise disjoint *bounded open plaques* (images of `V r ∩ U`), stable under
`aDiag t` up to the family.  The σ-algebra generated by the family then has exactly these
plaques as atoms on `Z = ⋃ₙ Pₙ`, and `aDiag t ⁻¹` of a generator is again measurable.

This file proves the *algebraic* half of that reduction.
-/

open MeasureTheory Topology Filter
open scoped ENNReal

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## Elementary neighbourhood facts -/

/-- `V r` is an open set of bounded entries: `|g i j| ≤ 1 + r` for `g ∈ V r`. -/
theorem mem_V_entries_le {r : ℝ} (hr : 0 < r) {g : SL3} (hg : g ∈ V r) (i j : Fin 3) :
    |g i j| ≤ 1 + r := by
  have h : |g i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < r := hg i j
  have h1 : |g i j| ≤ |g i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
      + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
    simpa using abs_add_le (g i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
      ((1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
  have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
    rw [Matrix.one_apply]; split <;> simp
  linarith

/-- Entries of a product are bounded by `3 * sA * sB`. -/
theorem mul_entries_le {A B : Matrix (Fin 3) (Fin 3) ℝ} (i j : Fin 3) {sA sB : ℝ}
    (hA : ∀ k l, |A k l| ≤ sA)
    (hB : ∀ k l, |B k l| ≤ sB) (hsA : 0 ≤ sA) (hsB : 0 ≤ sB) : |(A * B) i j| ≤ 3 * sA * sB := by
  rw [Matrix.mul_apply]
  calc |∑ k : Fin 3, A i k * B k j| ≤ ∑ k : Fin 3, |A i k * B k j| :=
        Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |A i k| * |B k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, sA * sB :=
        Finset.sum_le_sum (fun k _ => mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hsA)
    _ = 3 * (sA * sB) := by simp [Finset.sum_const, Fintype.card_fin]
    _ = 3 * sA * sB := by ring

/-! ## Orbit plaques -/

/-- The orbit plaque of `U` at `x₀`: the image of the displacement neighbourhood `V r` under
the orbit map of `U`. -/
def orbitPlaque (U : Subgroup SL3) (x₀ : X3) (r : ℝ) : Set X3 :=
  (fun u : SL3 => u • x₀) '' (V r ∩ (U : Set SL3))

/-- Every orbit plaque of a closed subgroup is Borel. -/
theorem measurableSet_orbitPlaque (U : Subgroup SL3) (hU : IsClosed (U : Set SL3)) (x₀ : X3)
    (r : ℝ) : MeasurableSet (orbitPlaque U x₀ r) :=
  Work.EKLProd.borelOrbitImage U hU x₀ r

/-- An orbit plaque is contained in the `U`-orbit of each of its points. -/
theorem orbitPlaque_subset_orb (U : Subgroup SL3) (x₀ : X3) (r : ℝ) {x : X3}
    (hx : x ∈ orbitPlaque U x₀ r) :
    orbitPlaque U x₀ r ⊆ (fun u : SL3 => u • x) '' (U : Set SL3) := by
  rintro y ⟨u, hu, rfl⟩
  obtain ⟨u₀, hu₀, rfl⟩ := hx
  refine ⟨u * u₀⁻¹, U.mul_mem hu.2 (U.inv_mem hu₀.2), ?_⟩
  show (u * u₀⁻¹) • (u₀ • x₀) = u • x₀
  rw [mul_smul, inv_smul_smul]

/-! ## The atom of a point of a piece -/

/-- **The atom of a point of a piece.**  For a pairwise disjoint family `P` and `x ∈ P k`, the
atom of `x` in the σ-algebra generated by `range P` is `P k`. -/
theorem atom_generateFrom_range_disjoint (P : ℕ → Set X3)
    (hdisj : ∀ m n, m ≠ n → Disjoint (P m) (P n)) {x : X3} {k : ℕ} (hx : x ∈ P k) :
    atom (MeasurableSpace.generateFrom (Set.range P)) x = P k := by
  set m := MeasurableSpace.generateFrom (Set.range P) with hm
  have hmem : ∀ n, MeasurableSet[m] (P n) := fun n =>
    MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  have hsub : atom m x ⊆ P k := Set.sInter_subset_of_mem ⟨hmem k, hx⟩
  have hprof : ∀ {y : X3}, y ∈ P k → ∀ n, (y ∈ P n ↔ x ∈ P n) := by
    intro y hy n
    have h1 : y ∈ P n ↔ n = k := by
      constructor
      · intro hyn
        by_contra hne
        exact Set.disjoint_left.mp (hdisj n k hne) hyn hy
      · rintro rfl; exact hy
    have h2 : x ∈ P n ↔ n = k := by
      constructor
      · intro hxn
        by_contra hne
        exact Set.disjoint_left.mp (hdisj n k hne) hxn hx
      · rintro rfl; exact hx
    rw [h1, h2]
  have hatom_eq : ∀ {y : X3}, (∀ n, (y ∈ P n ↔ x ∈ P n)) → atom m x = atom m y := by
    intro y hy
    have hiff : ∀ s, MeasurableSet[m] s → (x ∈ s ↔ y ∈ s) := by
      intro s hs
      induction s, hs using MeasurableSpace.generateFrom_induction (C := Set.range P) with
      | hC t ht _ =>
          obtain ⟨n, rfl⟩ := ht
          exact (hy n).symm
      | empty => simp
      | compl t ht ih => simpa [Set.mem_compl_iff] using ih.not
      | iUnion f hf ihf =>
          simp only [Set.mem_iUnion]
          exact exists_congr fun n => ihf n
    have hset : {t : Set X3 | MeasurableSet[m] t ∧ x ∈ t}
        = {t : Set X3 | MeasurableSet[m] t ∧ y ∈ t} := by
      ext t
      constructor
      · rintro ⟨ht, hxt⟩; exact ⟨ht, (hiff t ht).mp hxt⟩
      · rintro ⟨ht, hyt⟩; exact ⟨ht, (hiff t ht).mpr hyt⟩
    rw [atom, atom, hset]
  have hsuper : P k ⊆ atom m x := by
    intro y hy
    rw [hatom_eq (hprof hy)]
    exact Set.mem_sInter.mpr fun t ht => ht.2
  exact Set.Subset.antisymm hsub hsuper

/-! ## The shape of a point of a piece -/

/-- **The shape of a point of a free orbit plaque.**  If `x = u₀ • x₀` with `u₀ ∈ V r ∩ U` and
the orbit map at `x₀` is injective on `U`, then, for any σ-algebra whose atom at `x` is the
plaque, the shape of `x` is `{u ∈ U | u * u₀ ∈ V r}`. -/
theorem shape_piece {U : Subgroup SL3} {x₀ x : X3} {u₀ : SL3} {r : ℝ}
    (hfree : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    {m : MeasurableSpace X3} (hatom : atom m x = orbitPlaque U x₀ r)
    (hu₀ : u₀ ∈ U) (hu₀V : u₀ ∈ V r) (hx : x = u₀ • x₀) :
    shape m U x = {u : SL3 | u ∈ U ∧ u * u₀ ∈ V r} := by
  have hshape : shape m U x = {u : SL3 | u ∈ U ∧ u • x ∈ orbitPlaque U x₀ r} := by
    rw [shape, hatom]
  rw [hshape]
  ext u
  constructor
  · rintro ⟨huU, hu⟩
    obtain ⟨v, ⟨hvV, hvU⟩, hv⟩ := hu
    refine ⟨huU, ?_⟩
    have hvu : v = u * u₀ := hfree v hvU (u * u₀) (U.mul_mem huU hu₀) (by
      have h1 : v • x₀ = u • x := hv
      rw [h1, hx, mul_smul])
    rw [hvu] at hvV
    exact hvV
  · rintro ⟨huU, huV⟩
    refine ⟨huU, ⟨u * u₀, ⟨huV, U.mul_mem huU hu₀⟩, ?_⟩⟩
    show (u * u₀) • x₀ = u • x
    rw [hx, mul_smul]

/-- The shape of a piece, in the form required by `IsPlaqueAlgebra`: `O ∩ U` with `O` open. -/
theorem shape_piece_eq {U : Subgroup SL3} {x₀ x : X3} {u₀ : SL3} {r : ℝ}
    (hfree : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    {m : MeasurableSpace X3} (hatom : atom m x = orbitPlaque U x₀ r)
    (hu₀ : u₀ ∈ U) (hu₀V : u₀ ∈ V r) (hx : x = u₀ • x₀) :
    ∃ O : Set SL3, IsOpen O ∧ shape m U x = O ∩ (U : Set SL3) := by
  refine ⟨{g : SL3 | g * u₀ ∈ V r}, ?_, ?_⟩
  · exact (isOpen_V r).preimage (by fun_prop)
  · rw [shape_piece hfree hatom hu₀ hu₀V hx]
    ext u
    constructor
    · rintro ⟨huU, huV⟩
      exact ⟨huV, huU⟩
    · rintro ⟨huV, huU⟩
      exact ⟨huU, huV⟩

/-- The shape of a piece is bounded entrywise. -/
theorem shape_piece_entries {U : Subgroup SL3} {x₀ x : X3} {u₀ : SL3} {r : ℝ}
    (hr : 0 < r)
    (hfree : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂)
    {m : MeasurableSpace X3} (hatom : atom m x = orbitPlaque U x₀ r)
    (hu₀ : u₀ ∈ U) (hu₀V : u₀ ∈ V r) (hx : x = u₀ • x₀) :
    ∃ C : ℝ, ∀ u ∈ shape m U x, ∀ i j, |u i j| ≤ C := by
  obtain ⟨C, hC⟩ := Work.EKLProd.inv_entries_bound r hr
  have hC0 : 0 ≤ C := by
    have h1 : (1 : SL3) ∈ V r := by
      intro i j
      have : (1 : SL3) i j = (1 : Matrix (Fin 3) (Fin 3) ℝ) i j := rfl
      rw [this, sub_self, abs_zero]; exact hr
    have := hC 1 h1 0 0
    have h2 : ((1 : SL3)⁻¹) 0 0 = 1 := by simp
    rw [h2] at this
    have : (1 : ℝ) ≤ C := by simpa using this
    linarith
  refine ⟨3 * (1 + r) * C, ?_⟩
  intro u hu i j
  rw [shape_piece hfree hatom hu₀ hu₀V hx] at hu
  obtain ⟨huU, huV⟩ := hu
  have hA : ∀ k l, |((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ 1 + r :=
    fun k l => mem_V_entries_le hr huV k l
  have hB : ∀ k l, |((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) k l| ≤ C := fun k l => hC u₀ hu₀V k l
  have h := mul_entries_le (A := ((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ))
    (B := ((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ)) i j hA hB (by linarith) hC0
  have h2 : ((u : Matrix (Fin 3) (Fin 3) ℝ))
      = ((u * u₀ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) * ((u₀⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) := by
    rw [← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel_right]
  rw [h2]
  exact h

/-! ## Almost every orbit is free -/

/-- **Poincaré recurrence** for the contracting element: for a probability measure `μ` preserved
by `x ↦ aDiag t • x`, a.e. point `x` has every neighbourhood of `x` visited infinitely often by
its forward orbit. -/
theorem ae_frequently_visit (μ : Measure X3) [IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ) (hmp : MeasurePreserving (fun x : X3 => aDiag t • x) μ μ) :
    ∀ᵐ x ∂μ, ∀ s ∈ 𝓝 x,
      ∃ᶠ n in Filter.atTop, (fun y : X3 => aDiag t • y)^[n] x ∈ s :=
  (hmp.conservative).ae_frequently_mem_of_mem_nhds

/-- **(U2): a.e. free orbits** (Pisa 7.12), with the uniform injectivity of the `U`-action
supplied as a hypothesis instead of `P_X3`.

If `u ≠ 1` fixes `x`, then `aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ≠ 1` fixes `aDiag t ^ n • x` for
all `n`, and these conjugates converge to `1`; Poincaré recurrence produces `n` with
`aDiag t ^ n • x` back in a compact neighbourhood of `x`, where uniform injectivity forbids a
non-trivial element of a small `V δ` from fixing the point. -/
theorem ae_free_orbit_of_uniform_injective
    (hinj : ∀ K : Set X3, IsCompact K →
      ∃ δ > 0, ∀ x ∈ K, ∀ g ∈ V δ, g • x = x → g = 1)
    (μ : Measure X3) [IsProbabilityMeasure μ] (U : Subgroup SL3) (hU : IsHoro U)
    (t : Fin 3 → ℝ) (hmp : MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto
      (fun n : ℕ => aDiag t ^ n * u * (aDiag t ^ n)⁻¹) Filter.atTop (nhds 1)) :
    ∀ᵐ x ∂μ, ∀ u ∈ U, u • x = x → u = 1 := by
  filter_upwards [ae_frequently_visit μ t hmp] with x hx
  intro u hu hux
  by_contra hne
  obtain ⟨K, hKc, hKn⟩ := exists_compact_mem_nhds x
  obtain ⟨δ, hδ, hloc⟩ := hinj K hKc
  have hV : V δ ∈ 𝓝 (1 : SL3) :=
    (Work.EKLContract.Lemmas.V_open_one δ hδ).1.mem_nhds
      (Work.EKLContract.Lemmas.V_open_one δ hδ).2
  have hev : ∀ᶠ n in Filter.atTop, aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ∈ V δ :=
    (hcontr u hu).eventually_mem hV
  have hfreq : ∃ᶠ n in Filter.atTop, (fun y : X3 => aDiag t • y)^[n] x ∈ interior K :=
    hx (interior K) (interior_mem_nhds.mpr hKn)
  obtain ⟨n, hnK, hnV⟩ := (hfreq.and_eventually hev).exists
  have hfix : (aDiag t ^ n * u * (aDiag t ^ n)⁻¹) • ((fun y : X3 => aDiag t • y)^[n] x)
      = (fun y : X3 => aDiag t • y)^[n] x := by
    rw [smul_iterate, mul_smul, mul_smul, inv_smul_smul, hux]
  have hconj : aDiag t ^ n * u * (aDiag t ^ n)⁻¹ = 1 :=
    hloc _ (interior_subset hnK) _ hnV hfix
  exact hne (by
    calc u = (aDiag t ^ n)⁻¹ * (aDiag t ^ n * u * (aDiag t ^ n)⁻¹) * (aDiag t ^ n) := by
          group
      _ = 1 := by rw [hconj]; group)

/-! ## The assembly -/

/-- **The assembly in geometric (parameter-set) form.**

A countable family `B` of Borel sets is given together with a set `Z` such that
* on `Z` the atoms of `σ(B)` are bounded open free `U`-plaques, each contained in `Z`
  (the plaque being described by its parameter set `U₀ = O ∩ U` with `O` open);
* `Z` is `σ(B)`-measurable and `μ Zᶜ < ε`;
* `aDiag t ⁻¹' (B m)` is `σ(B)`-measurable for every `m`.

This is the form produced by the geometric grid construction, where the atoms are the
components of the `U`-leaves of `X₃ \ C` and `U₀` is the shape of the component. -/
theorem exists_desc_subordinate_of_plaque_coding (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t : Fin 3 → ℝ) (ε : ENNReal) (hε : 0 < ε)
    (B : ℕ → Set X3) (Z : Set X3)
    (hB : ∀ m, MeasurableSet (B m))
    (hZ : @MeasurableSet X3 (MeasurableSpace.generateFrom (Set.range B)) Z)
    (hsmall : μ Zᶜ < ε)
    (hatom : ∀ x ∈ Z, ∃ (U₀ O : Set SL3), IsOpen O ∧ U₀ = O ∩ (U : Set SL3) ∧
      (∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂) ∧
      atom (MeasurableSpace.generateFrom (Set.range B)) x = (fun u : SL3 => u • x) '' U₀ ∧
      (fun u : SL3 => u • x) '' U₀ ⊆ Z ∧
      (∃ K : ℝ, ∀ u ∈ U₀, ∀ i j, |u i j| ≤ K))
    (hcompat : ∀ m, @MeasurableSet X3 (MeasurableSpace.generateFrom (Set.range B))
      ((fun x : X3 => aDiag t • x) ⁻¹' (B m))) :
    ∃ A : MeasurableSpace X3, ∃ Z' : Set X3,
      IsPlaqueAlgebra U Z' A ∧ μ Z'ᶜ < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  set m := MeasurableSpace.generateFrom (Set.range B) with hm
  have hle : m ≤ borel X3 := MeasurableSpace.generateFrom_le fun s hs => by
    obtain ⟨n, rfl⟩ := hs
    exact hB n
  refine ⟨m, Z, ⟨hle, ⟨Set.range B, Set.countable_range B, rfl⟩, hZ, ?_⟩, hsmall, ?_⟩
  · intro x hx
    obtain ⟨U₀, O, hO, hU₀, hfree, hatomx, hsub, hK⟩ := hatom x hx
    have hstep : ∀ u : SL3, u ∈ shape m U x ↔ (u ∈ U ∧ u ∈ U₀) := by
      intro u
      rw [shape, hatomx]
      constructor
      · rintro ⟨huU, hu⟩
        obtain ⟨v, hv, hvx⟩ := hu
        have hvU : v ∈ U := (hU₀ ▸ hv).2
        have hvx' : u • x = v • x := hvx.symm
        have hvu : v = u := (hfree u huU v hvU hvx').symm
        exact ⟨huU, by rw [← hvu]; exact hv⟩
      · rintro ⟨huU, huU₀⟩
        exact ⟨huU, ⟨u, huU₀, rfl⟩⟩
    have hshape : shape m U x = {u : SL3 | u ∈ U ∧ u ∈ U₀} := by
      ext u; exact hstep u
    refine ⟨by rw [hatomx]; exact hsub, ?_, ?_, ?_⟩
    · rw [hatomx]
      rintro y ⟨u, hu, rfl⟩
      exact ⟨u, (hU₀ ▸ hu).2, rfl⟩
    · refine ⟨O, hO, ?_⟩
      rw [hshape]
      ext u
      constructor
      · rintro ⟨huU, huU₀⟩
        rw [hU₀] at huU₀
        exact huU₀
      · intro hu
        exact ⟨hu.2, by rw [hU₀]; exact hu⟩
    · obtain ⟨K, hKb⟩ := hK
      refine ⟨K, ?_⟩
      intro u hu i j
      rw [hshape] at hu
      exact hKb u hu.2 i j
  · rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨u, hu, hus⟩
    obtain ⟨n, rfl⟩ := hu
    rw [← hus]
    exact hcompat n

/-- **The general assembly (coding form).**  A countable family `B` of Borel sets that
(a) has the free bounded open plaques as its profile classes on `Z`,
(b) generates a σ-algebra containing `Z` and closed under `aDiag t ⁻¹` (checked on generators),
(c) leaves at most `ε` outside `Z`,
yields the descending subordinate plaque algebra.  (The countable family `P` of the tiling
version is the special case where `B` enumerates the plaques.) -/
theorem exists_desc_subordinate_of_coding (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t : Fin 3 → ℝ) (ε : ENNReal) (hε : 0 < ε)
    (B : ℕ → Set X3) (Z : Set X3)
    (hB : ∀ m, MeasurableSet (B m))
    (hZ : @MeasurableSet X3 (MeasurableSpace.generateFrom (Set.range B)) Z)
    (hsmall : μ Zᶜ < ε)
    (hatom : ∀ x ∈ Z, ∃ (x₀ : X3) (r : ℝ), 0 < r ∧
      (∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂) ∧
      atom (MeasurableSpace.generateFrom (Set.range B)) x = orbitPlaque U x₀ r ∧
      orbitPlaque U x₀ r ⊆ Z)
    (hcompat : ∀ m, @MeasurableSet X3 (MeasurableSpace.generateFrom (Set.range B))
      ((fun x : X3 => aDiag t • x) ⁻¹' (B m))) :
    ∃ A : MeasurableSpace X3, ∃ Z' : Set X3,
      IsPlaqueAlgebra U Z' A ∧ μ Z'ᶜ < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  set m := MeasurableSpace.generateFrom (Set.range B) with hm
  have hle : m ≤ borel X3 := MeasurableSpace.generateFrom_le fun s hs => by
    obtain ⟨n, rfl⟩ := hs
    exact hB n
  refine ⟨m, Z, ⟨hle, ⟨Set.range B, Set.countable_range B, rfl⟩, hZ, ?_⟩, hsmall, ?_⟩
  · intro x hx
    obtain ⟨x₀, r, hr, hfr, hatomx, hPZ⟩ := hatom x hx
    have hatom' : atom m x = orbitPlaque U x₀ r := hatomx
    have hxmem : x ∈ orbitPlaque U x₀ r := by
      rw [← hatom']; exact Set.mem_sInter.mpr fun s hs => hs.2
    obtain ⟨u₀, ⟨hu₀V, hu₀U⟩, hu₀x⟩ :=
      (by rw [← hatom']; exact Set.mem_sInter.mpr fun s hs => hs.2 : x ∈ orbitPlaque U x₀ r)
    exact ⟨by rw [hatom']; exact hPZ,
      by rw [hatom']; exact orbitPlaque_subset_orb U x₀ r hxmem,
      shape_piece_eq hfr hatom' hu₀U hu₀V hu₀x.symm,
      shape_piece_entries hr hfr hatom' hu₀U hu₀V hu₀x.symm⟩
  · rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨u, hu, hus⟩
    obtain ⟨n, rfl⟩ := hu
    rw [← hus]
    exact hcompat n



/-- **The assembly.**  A countable family of pairwise disjoint free orbit plaques that tiles the
complement of a forward-invariant `μ`-null set `C`, compatibly with `aDiag t`, yields the
descending subordinate plaque algebra. -/
theorem exists_desc_subordinate_of_tiling (μ : Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t : Fin 3 → ℝ) (ε : ENNReal) (hε : 0 < ε)
    (C : Set X3) (hCnull : μ C = 0) (hCfwd : ∀ x ∈ C, aDiag t • x ∈ C)
    (P : ℕ → Set X3)
    (hfree : ∀ n, ∃ (x : X3) (r : ℝ), 0 < r ∧
      (∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x = u₂ • x → u₁ = u₂) ∧ P n = orbitPlaque U x r)
    (hdisj : ∀ m n, m ≠ n → Disjoint (P m) (P n))
    (hcover : (⋃ n, P n) = Cᶜ)
    (hcompat : ∀ n, ∃ S : Set ℕ,
      (fun x : X3 => aDiag t • x) ⁻¹' (P n) = ⋃ m ∈ S, P m) :
    ∃ A : MeasurableSpace X3, ∃ Z : Set X3,
      IsPlaqueAlgebra U Z A ∧ μ Zᶜ < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  set m := MeasurableSpace.generateFrom (Set.range P) with hm
  have hgen : ∀ n, MeasurableSet[m] (P n) := fun n =>
    MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  refine ⟨m, ⋃ n, P n, ⟨?_, ⟨Set.range P, Set.countable_range P, rfl⟩, ?_, ?_⟩, ?_, ?_⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨n, rfl⟩
    obtain ⟨x, r, hr, hfr, hPn⟩ := hfree n
    rw [hPn]
    exact measurableSet_orbitPlaque U hU.1 x r
  · exact MeasurableSet.iUnion hgen
  · intro x hx
    obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hx
    have hatom : atom m x = P k := atom_generateFrom_range_disjoint P hdisj hk
    obtain ⟨x₀, r, hr, hfr, hPk⟩ := hfree k
    obtain ⟨u₀, ⟨hu₀V, hu₀U⟩, hu₀x⟩ := (by rw [← hPk]; exact hk : x ∈ orbitPlaque U x₀ r)
    have hxk : x ∈ orbitPlaque U x₀ r := ⟨u₀, ⟨hu₀V, hu₀U⟩, hu₀x⟩
    have hatom' : atom m x = orbitPlaque U x₀ r := by rw [hatom, hPk]
    exact ⟨by rw [hatom]; exact Set.subset_iUnion P k,
      by rw [hatom, hPk]; exact orbitPlaque_subset_orb U x₀ r hxk,
      shape_piece_eq hfr hatom' hu₀U hu₀V hu₀x.symm,
      shape_piece_entries hr hfr hatom' hu₀U hu₀V hu₀x.symm⟩
  · have hcompl : (⋃ n, P n)ᶜ = C := by rw [hcover, compl_compl]
    rw [hcompl]
    exact lt_of_le_of_lt (le_of_eq hCnull) hε
  · rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨u, hu, hus⟩
    obtain ⟨n, rfl⟩ := hu
    obtain ⟨S, hS⟩ := hcompat n
    rw [← hus, hS]
    exact MeasurableSet.iUnion fun m =>
      MeasurableSet.iUnion fun _ => hgen m


/-! ## The degenerate case `U = ⊥`

These two lemmas are local copies (with distinct names) of `Work.EKLC6Core.atom_borel_singleton`
and `Work.EKLC6Core.bot_plaque` from `exists_gen_plaque.lean`, kept here so that this module
does not depend on that (large) module. -/

/-- In a `T1` Borel space the atom of the Borel σ-algebra at `x` is the singleton `{x}`. -/
theorem atomBorelSingleton (x : X3) : atom (borel X3) x = {x} := by
  haveI : IsClosed (Γ3 : Set SL3) := Work.EKLContract.Lemmas.isClosed_Γ3
  haveI : SecondCountableTopology SL3 := Work.EKLContract.Lemmas.SL3Topology.2
  haveI : T1Space X3 := inferInstance
  refine Set.Subset.antisymm ?_ ?_
  · exact Set.sInter_subset_of_mem ⟨(isClosed_singleton (x := x)).measurableSet, rfl⟩
  · intro y hy
    rw [Set.mem_singleton_iff] at hy
    rw [hy]
    exact Set.mem_sInter.mpr (fun t ht => ht.2)

/-- `IsPlaqueAlgebra` holds for the trivial subgroup, with the Borel σ-algebra and the whole
space: the atoms are singletons, which are the trivial-group orbit of the point. -/
theorem botPlaque : IsPlaqueAlgebra (⊥ : Subgroup SL3) Set.univ (borel X3) := by
  haveI : IsClosed (Γ3 : Set SL3) := Work.EKLContract.Lemmas.isClosed_Γ3
  haveI : SecondCountableTopology SL3 := Work.EKLContract.Lemmas.SL3Topology.2
  haveI : SecondCountableTopology X3 := inferInstance
  haveI : T1Space X3 := inferInstance
  refine ⟨le_rfl, ?_, MeasurableSet.univ, ?_⟩
  · obtain ⟨b, hbc, -, hb⟩ := TopologicalSpace.exists_countable_basis X3
    exact ⟨b, hbc, hb.borel_eq_generateFrom⟩
  · intro x hx
    have hatom : atom (borel X3) x = {x} := atomBorelSingleton x
    have hshape : shape (borel X3) (⊥ : Subgroup SL3) x = ((⊥ : Subgroup SL3) : Set SL3) := by
      ext u
      simp only [shape, Set.mem_ofPred_eq, SetLike.mem_coe, hatom]
      constructor
      · rintro ⟨hu, -⟩; exact hu
      · intro hu
        exact ⟨hu, by rw [Subgroup.mem_bot.mp hu, one_smul]; exact Set.mem_singleton x⟩
    refine ⟨by rw [hatom]; exact Set.singleton_subset_iff.mpr hx, ?_, ?_, ?_⟩
    · rw [hatom]
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      exact ⟨1, Subgroup.mem_bot.mpr rfl, one_smul SL3 x⟩
    · refine ⟨Set.univ, isOpen_univ, ?_⟩
      rw [hshape, Set.univ_inter]
    · refine ⟨1, ?_⟩
      intro u hu i j
      rw [hshape] at hu
      have hu1 : u = 1 := Subgroup.mem_bot.mp hu
      rw [hu1]
      rw [show ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) = 1 from rfl, Matrix.one_apply]
      split <;> simp


/-! ## The `aDiag t`-descent of the σ-algebra `⨆ₙ comap (aDiag t ·)^[n] M`

This is the (elementary, geometry-free) reason why an algebra in "descending" form is
`aDiag t`-decreasing. -/

/-- `comap (aDiag t ·) (⨆ₙ comap ((aDiag t ·)^[n]) M) ≤ ⨆ₙ comap ((aDiag t ·)^[n]) M`. -/
theorem comap_iSup_comap_iterate_le (t : Fin 3 → ℝ) (M : MeasurableSpace X3) :
    MeasurableSpace.comap (fun x : X3 => aDiag t • x)
        (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M) ≤
      ⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M := by
  rw [MeasurableSpace.comap_iSup]
  refine iSup_le fun n => ?_
  rw [MeasurableSpace.comap_comp]
  rw [← Function.iterate_succ]
  exact le_iSup (fun n : ℕ =>
    MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M) (n + 1)


/-! ## Atom-invariance of the shape (used in the completion of the geometric core)

For the descending σ-algebra `A = ⨆ₙ comap ((aDiag t·)^[n]) M` the shape of the atom of `x` is
`⋂ₙ Vₙ(x)` with `Vₙ(x) = a^{-n} (shape M U (a^n x)) a^n`; an intersection of open subsets of `U`
which is not *a priori* open.  Its openness is nevertheless a property of the *atom*: if
`y = u • x` lies in the same atom, the shape at `y` is the right translate of the shape at `x`
by `u⁻¹` (a homeomorphism of `U`), so openness, and (for free `x`) entrywise boundedness, are
preserved.  Hence the set of points where the shape of the atom is open is a union of atoms,
which is what lets one cut the (Borel, but not `A`-measurable) set where the orbit stays away
from the plaque boundaries down to an `A`-measurable set of large measure. -/

/-- **The shape of an atom is computed by right translation along the atom.**  If `u ∈ U` and
`u • x` lies in the same atom of `A` as `x`, then
`shape A U (u • x) = shape A U x * {u⁻¹}`. -/
theorem shape_eq_translate_of_atom_eq {A : MeasurableSpace X3} {U : Subgroup SL3}
    {x : X3} {u : SL3} (hu : u ∈ U) (hatom : atom A (u • x) = atom A x) :
    shape A U (u • x) = (fun s : SL3 => s * u⁻¹) '' shape A U x := by
  ext v
  constructor
  · rintro ⟨hvU, hv⟩
    have h : v • (u • x) ∈ atom A (u • x) := hv
    rw [hatom, ← mul_smul] at h
    exact ⟨v * u, ⟨U.mul_mem hvU hu, h⟩, mul_inv_cancel_right v u⟩
  · rintro ⟨a, ha, rfl⟩
    refine ⟨U.mul_mem ha.1 (U.inv_mem hu), ?_⟩
    have h1 : (a * u⁻¹) • (u • x) = a • x := by rw [mul_smul, inv_smul_smul]
    rw [h1]
    simpa [hatom] using ha.2

/-- Points of an atom have the same atom. -/
theorem atom_eq_of_mem_atom' {A : MeasurableSpace X3} {x y : X3} (hy : y ∈ atom A x) :
    atom A y = atom A x := by
  refine Set.Subset.antisymm ?_ ?_
  · intro z hz
    rw [atom, Set.mem_sInter] at hz ⊢
    intro s hs
    exact hz s ⟨hs.1, hy s hs⟩
  · intro z hz
    rw [atom, Set.mem_sInter] at hz ⊢
    intro s hs
    have hxs : x ∈ s := by
      by_contra hcon
      exact (hy sᶜ ⟨hs.1.compl, hcon⟩) hs.2
    exact hz s ⟨hs.1, hxs⟩

/-- **Relative openness of the shape is an atom property.**  If `u ∈ U` and `u • x` lies in the
same atom of `A` as `x`, then the shape at `u • x` is the right translate (by `u⁻¹`) of the shape
at `x`, so if one is the trace of an open set the other is too. -/
theorem exists_isOpen_shape_of_mem_atom {A : MeasurableSpace X3} {U : Subgroup SL3} {x : X3}
    {u : SL3} (hu : u ∈ U) (hatom : atom A (u • x) = atom A x)
    (h : ∃ O : Set SL3, IsOpen O ∧ shape A U x = O ∩ (U : Set SL3)) :
    ∃ O : Set SL3, IsOpen O ∧ shape A U (u • x) = O ∩ (U : Set SL3) := by
  obtain ⟨O, hO, hEq⟩ := h
  refine ⟨{s : SL3 | s * u ∈ O}, hO.preimage (by fun_prop), ?_⟩
  rw [shape_eq_translate_of_atom_eq hu hatom, hEq]
  ext s
  constructor
  · rintro ⟨a, ⟨haO, haU⟩, rfl⟩
    exact ⟨by simpa using haO, U.mul_mem haU (U.inv_mem hu)⟩
  · rintro ⟨hsO, hsU⟩
    refine ⟨s * u, ⟨hsO, U.mul_mem hsU hu⟩, ?_⟩
    group

/-- **The set where the shape is relatively open is a union of atoms** (for an atom structure
whose atoms lie inside `U`-orbits).  This is the `A`-saturation of the good set, and it is what
lets the (Borel, but possibly not `A`-measurable) set of points where the orbit stays away from
the plaque boundaries be cut down to an `A`-measurable set of the same measure. -/
theorem isAtomSaturated_exists_isOpen_shape {A : MeasurableSpace X3} {U : Subgroup SL3}
    (horb : ∀ x : X3, atom A x ⊆ (fun u : SL3 => u • x) '' (U : Set SL3)) :
    ∀ x ∈ {x : X3 | ∃ O : Set SL3, IsOpen O ∧ shape A U x = O ∩ (U : Set SL3)},
      atom A x ⊆ {x : X3 | ∃ O : Set SL3, IsOpen O ∧ shape A U x = O ∩ (U : Set SL3)} := by
  intro x hx y hy
  obtain ⟨u, hu, hyu⟩ := horb x hy
  subst hyu
  exact exists_isOpen_shape_of_mem_atom hu (atom_eq_of_mem_atom' hy) hx

/-! ### Transferring the plaque conditions from a good set `H` to a saturated set `Z`

The endgame (Pisa 7.37/7.38, `PLAN_L1_desc_subordinate.md` session 4) produces a set `Z` which is
`A`-measurable and `A`-saturated and *every* atom of whose points meets a Borel "good" set `H`
(the points whose orbit keeps the margin of Pisa 7.31).  The plaque conditions
(`atom_A x ⊆ U • x`, relative openness of `shape A U x`, entrywise boundedness of `shape A U x`)
are then *inherited* from `H`: an atom of `Z` is an atom of `H`, and the shape is a right
translate along the atom (`shape_eq_translate_of_atom_eq`). -/

/-- `x ∈ atom A x`. -/
theorem mem_atom_self (A : MeasurableSpace X3) (x : X3) : x ∈ atom A x := by
  rw [atom, Set.mem_sInter]
  exact fun s hs => hs.2

/-- **Inheritance of the openness of the shape.** -/
theorem exists_isOpen_shape_of_forall_exists_atom_eq {A : MeasurableSpace X3} {U : Subgroup SL3}
    {Z H : Set X3} (hatom : ∀ x ∈ Z, ∃ y ∈ H, atom A x = atom A y)
    (horb : ∀ y ∈ H, atom A y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3))
    (hopen : ∀ y ∈ H, ∃ O : Set SL3, IsOpen O ∧ shape A U y = O ∩ (U : Set SL3)) :
    ∀ x ∈ Z, ∃ O : Set SL3, IsOpen O ∧ shape A U x = O ∩ (U : Set SL3) := by
  intro x hx
  obtain ⟨y, hyH, hxy⟩ := hatom x hx
  have hxatom : x ∈ atom A y := by rw [← hxy]; exact mem_atom_self A x
  obtain ⟨u, huU, hux⟩ := horb y hyH hxatom
  subst hux
  exact exists_isOpen_shape_of_mem_atom huU (atom_eq_of_mem_atom' hxatom) (hopen y hyH)

/-- **Inheritance of the orbit clause.** -/
theorem atom_subset_orb_of_forall_exists_atom_eq {A : MeasurableSpace X3} {U : Subgroup SL3}
    {Z H : Set X3} (hatom : ∀ x ∈ Z, ∃ y ∈ H, atom A x = atom A y)
    (horb : ∀ y ∈ H, atom A y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3)) :
    ∀ x ∈ Z, atom A x ⊆ (fun u : SL3 => u • x) '' (U : Set SL3) := by
  intro x hx z hz
  obtain ⟨y, hyH, hxy⟩ := hatom x hx
  have hxatom : x ∈ atom A y := by rw [← hxy]; exact mem_atom_self A x
  obtain ⟨u, huU, hux⟩ := horb y hyH hxatom
  have hzy : z ∈ atom A y := by rw [← hxy]; exact hz
  obtain ⟨w, hwU, hwz⟩ := horb y hyH hzy
  refine ⟨w * u⁻¹, U.mul_mem hwU (U.inv_mem huU), ?_⟩
  show (w * u⁻¹) • x = z
  rw [← hux, mul_smul, inv_smul_smul]
  exact hwz

/-- **Inheritance of the entrywise bound on the shape.** -/
theorem exists_bound_shape_of_forall_exists_atom_eq {A : MeasurableSpace X3} {U : Subgroup SL3}
    {Z H : Set X3} {ρ : ℝ}
    (hatom : ∀ x ∈ Z, ∃ y ∈ H, ∃ u ∈ Work.EKLComp.Uball U ρ, x = u • y ∧ atom A x = atom A y)
    (hbd : ∀ y ∈ H, ∃ C : ℝ, ∀ v ∈ shape A U y, ∀ i j, |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ C)
    {D : ℝ} (hD : ∀ g ∈ Work.EKLComp.Uball U ρ, ∀ i j,
      |(((g⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ)) i j| ≤ D) (hD0 : 0 ≤ D) :
    ∀ x ∈ Z, ∃ C : ℝ, ∀ v ∈ shape A U x, ∀ i j,
      |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ C := by
  intro x hx
  obtain ⟨y, hyH, u, huU, hux, hatomeq⟩ := hatom x hx
  obtain ⟨C, hC⟩ := hbd y hyH
  refine ⟨3 * C * D, fun v hv i j => ?_⟩
  subst hux
  rw [shape_eq_translate_of_atom_eq huU.1 hatomeq] at hv
  obtain ⟨v', hv', rfl⟩ := hv
  have hcoe : (((v' * u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ))
      = ((v' : SL3) : Matrix (Fin 3) (Fin 3) ℝ) * ((u⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) := by
    rw [Matrix.SpecialLinearGroup.coe_mul]
  rw [hcoe]
  exact mul_entries_le i j (fun k l => hC v' hv' k l)
    (fun k l => hD u huU k l) (le_trans (abs_nonneg _) (hC v' hv' 0 0)) hD0

