/-! ### The assembly: `IsPlaqueAlgebra` on `Z` from a good set `H` of large measure

The endgame of Pisa 7.37/7.38 as corrected in `PLAN_L1_desc_subordinate.md` (sessions 4/5):

* `H` is the (Borel) *good set* — the points whose orbit keeps the margin of Pisa 7.31;
* `Z` is an `A`-measurable, `A`-saturated set (`A = descSig t M`) every atom of which meets `H`
  (produced from `H` by the compact-code construction
  `Work.EKLC6Core.exists_measurable_saturated_large_descSig`);
* the plaque conditions at the points of `H` (openness and boundedness of the `M`-shape, and the
  orbit margin) transfer to `Z` by `atom_A x = atom_A y` plus the right-translation formula for
  the shape along an atom (the inheritance package above).

This shows that the only geometric input still needed is the good set `H` with `μ H > 1 - ε`,
the openness/boundedness of the `M`-shapes there, and the orbit margin — Pisa 7.27 + 7.31 for the
cut σ-algebra. -/

/-- `atom m x = (fun u => u • x) '' shape m U x` — the atom is the shape transported to `x`. -/
theorem atom_eq_smul_shape {m : MeasurableSpace X3} {U : Subgroup SL3} {x : X3}
    (h : atom m x ⊆ (fun u : SL3 => u • x) '' (U : Set SL3)) :
    atom m x = (fun u : SL3 => u • x) '' shape m U x := by
  refine Set.Subset.antisymm ?_ ?_
  · rintro z hz
    obtain ⟨u, huU, rfl⟩ := h hz
    exact ⟨u, ⟨huU, hz⟩, rfl⟩
  · rintro z ⟨u, ⟨huU, hu⟩, rfl⟩
    exact hu

/-- **The assembly.** -/
theorem isPlaqueAlgebra_descSig_of_good_set {U : Subgroup SL3} {t : Fin 3 → ℝ} (hU : IsHoro U)
    {M : MeasurableSpace X3} {b : Set (Set X3)} (hb : b.Countable)
    (hMb : M = MeasurableSpace.generateFrom b) (hMle : M ≤ borel X3)
    {H Z : Set X3} {ρ c mu lam : ℝ} (hρ : 0 < ρ) (hc : 0 < c)
    (hlam0 : 0 ≤ lam) (hlam_mu : lam < mu) (hmu1 : mu < 1)
    (hrate : ∀ n : ℕ, ∀ u : SL3, u ∈ U → u ∈ Work.EKLComp.Uball U ρ →
      aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ∈ Work.EKLComp.Uball U (ρ * lam ^ n))
    (hopenM : ∀ y : X3, ∃ W : Set SL3, IsOpen W ∧ shape M U y = W ∩ (U : Set SL3))
    (hbddH : ∀ y ∈ H, shape M U y ⊆ Work.EKLComp.Uball U ρ)
    (hmarginH : ∀ y ∈ H, ∀ n : ℕ,
      Work.EKLComp.Uball U (c * mu ^ n) ⊆ shape M U (((fun x : X3 => aDiag t • x)^[n]) y))
    (horbM : ∀ y : X3, atom M y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3))
    (hZmeas : MeasurableSet[descSig t M] Z)
    (hsat : ∀ x ∈ Z, atom (descSig t M) x ⊆ Z)
    (hmeet : ∀ x ∈ Z, ∃ y ∈ H, atom (descSig t M) x = atom (descSig t M) y) :
    IsPlaqueAlgebra U Z (descSig t M) := by
  have hAle : descSig t M ≤ borel X3 := descSig_le_borel M hMle
  have horbH : ∀ y ∈ H, atom (descSig t M) y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3) :=
    fun y _ => (atom_descSig_le t M y).trans (horbM y)
  obtain ⟨b', hb'c, hb'eq⟩ := descSig_countably_generated hb hMb
  -- the shape of the atom is open at the points of `H` (Pisa 7.31 + the margin at `H`)
  have hopenH : ∀ y ∈ H, ∃ O : Set SL3, IsOpen O ∧
      shape (descSig t M) U y = O ∩ (U : Set SL3) := by
    intro y hy
    exact isOpen_shape_pastSig_of_margin (N := 0) hU hlam0 hlam_mu hmu1 hc hρ hrate
      (fun n => hopenM (((fun x : X3 => aDiag t • x)^[n]) y)) (hbddH y hy)
      (fun n _ => hmarginH y hy n)
  -- the shape of the `M`-atom is bounded at the points of `H`, hence so is the `A`-shape
  have hbddA : ∀ y ∈ H, shape (descSig t M) U y ⊆ Work.EKLComp.Uball U ρ := by
    intro y hy u hu
    exact hbddH y hy ⟨hu.1, atom_descSig_le t M y hu.2⟩
  -- the atom-mates of a point of `H` are within `Uball U ρ`
  have hatombd : ∀ y ∈ H, atom (descSig t M) y ⊆
      (fun u : SL3 => u • y) '' (Work.EKLComp.Uball U ρ) := by
    intro y hy z hz
    rw [atom_eq_smul_shape (horbH y hy)] at hz
    obtain ⟨u, hu, rfl⟩ := hz
    exact ⟨u, hbddA y hy hu, rfl⟩
  obtain ⟨D, hD⟩ := Work.EKLProd.inv_entries_bound ρ hρ
  have hD0 : 0 ≤ D :=
    le_trans (abs_nonneg _) (hD 1 (Work.EKLContract.Lemmas.V_open_one ρ hρ).2 0 0)
  refine ⟨hAle, ⟨b', hb'c, hb'eq⟩, hZmeas, fun x hx => ?_⟩
  refine ⟨hsat x hx, atom_subset_orb_of_forall_exists_atom_eq hmeet horbH x hx,
    exists_isOpen_shape_of_forall_exists_atom_eq hmeet horbH hopenH x hx, ?_⟩
  refine exists_bound_shape_of_forall_exists_atom_eq (A := descSig t M) (U := U)
    (H := H) (Z := Z) (ρ := ρ)
    ?_ ?_ (fun g hg i j => hD g (hg.2 : g ∈ Work.EKLContract.V ρ) i j) hD0 x hx
  · intro x' hx'
    obtain ⟨y, hyH, hxy⟩ := hmeet x' hx'
    have hx'atom : x' ∈ atom (descSig t M) y := by rw [← hxy]; exact mem_atom_self _ x'
    obtain ⟨u, hu, hux⟩ := hatombd y hyH hx'atom
    exact ⟨y, hyH, u, hu, hux.symm, hxy⟩
  · intro y hy
    refine ⟨1 + ρ, fun v hv i j => ?_⟩
    have h1 : |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ρ := (hbddA y hy hv).2 i j
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    calc |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
        = |(((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
          rw [sub_add_cancel]
      _ ≤ |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| :=
          abs_add_le _ _
      _ ≤ ρ + 1 := add_le_add (le_of_lt h1) h2
      _ = 1 + ρ := by ring

/-! ### The reduction of the target to the geometric interface

`exists_desc_subordinate_of_good_set` below is `Work.EKLC6Core.exists_desc_subordinate` reduced to
the *only* remaining input: a countably generated `M = σ (range b) ≤ borel`, a Borel good set `H`
with `μ H > 1 - ε` on which the `M`-shapes are open and bounded and along whose orbits the margin
of Pisa 7.31 holds, the contraction rate of `U`, and the orbit clause.  Everything else — the
compact-code `Z`, the saturation, the inheritance of the plaque conditions, and the descending
condition `comap (aDiag t ·) A ≤ A` — is proved. -/

/-- **The target from the geometric interface.**  The hypotheses are: the `M`-structure at the
good set `H` (openness and boundedness of the `M`-shapes, and the orbit margin of Pisa 7.31), the
contraction rate of `U`, the orbit clause, and the `Z`-data produced from `H` by the compact-code
construction (`Work.EKLC6Core.exists_measurable_saturated_large_descSig`, which returns exactly
`hZmeas`, `hsat` and `hmeet'`). -/
theorem exists_desc_subordinate_of_good_set {U : Subgroup SL3} {t : Fin 3 → ℝ}
    {μ : Measure X3} [IsProbabilityMeasure μ] (hU : IsHoro U)
    {M : MeasurableSpace X3} {b : Set (Set X3)} (hb : b.Countable)
    (hMb : M = MeasurableSpace.generateFrom b) (hMle : M ≤ borel X3)
    {H Z : Set X3} (hZmeas : MeasurableSet[descSig t M] Z)
    (hsat : ∀ x ∈ Z, atom (descSig t M) x ⊆ Z)
    (hmeet' : ∀ x ∈ Z, ∃ y ∈ H, y ∈ atom (descSig t M) x)
    {ε : ENNReal} (hZμ : μ Zᶜ < ε)
    {ρ c mu lam : ℝ} (hρ : 0 < ρ) (hc : 0 < c) (hlam0 : 0 ≤ lam) (hlam_mu : lam < mu)
    (hmu1 : mu < 1)
    (hrate : ∀ n : ℕ, ∀ u : SL3, u ∈ U → u ∈ Work.EKLComp.Uball U ρ →
      aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ∈ Work.EKLComp.Uball U (ρ * lam ^ n))
    (hopenM : ∀ y : X3, ∃ W : Set SL3, IsOpen W ∧ shape M U y = W ∩ (U : Set SL3))
    (hbddH : ∀ y ∈ H, shape M U y ⊆ Work.EKLComp.Uball U ρ)
    (hmarginH : ∀ y ∈ H, ∀ n : ℕ,
      Work.EKLComp.Uball U (c * mu ^ n) ⊆ shape M U (((fun x : X3 => aDiag t • x)^[n]) y))
    (horbM : ∀ y : X3, atom M y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3)) :
    ∃ A : MeasurableSpace X3, ∃ Z' : Set X3,
      IsPlaqueAlgebra U Z' A ∧ μ Z'ᶜ < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  exact ⟨descSig t M, Z, isPlaqueAlgebra_descSig_of_good_set hU hb hMb hMle hρ hc hlam0 hlam_mu
      hmu1 hrate hopenM hbddH hmarginH horbM hZmeas hsat (fun x hx => by
        obtain ⟨y, hyH, hyx⟩ := hmeet' x hx
        exact ⟨y, hyH, (atom_eq_of_mem_atom' hyx).symm⟩),
    hZμ, comap_iSup_comap_iterate_le t M⟩

