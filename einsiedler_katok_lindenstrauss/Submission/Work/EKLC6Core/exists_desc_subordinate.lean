/-! ### The cut-based path to the target (session 9)

The declartions below assemble the target from the *cut* structure `Work.EKLC6Core.CutData`
(Pisa 7.38) via the good set `Work.EKLC6Core.CutGood` of `Work.EKLC6Core.cutHDefs`: the pieces are
the cell/bad atoms of the cut σ-algebra, the good set is the set of points whose orbit stays deep
inside the cells, and the σ-algebra of the conclusion is the descending one
`A = ⨆ₙ comap ((aDiag t ·)^[n]) M`.

`isPlaqueAlgebra_descSig_of_CutGood` is the assembly, with the geometric facts (openness of the
`M`-shapes along the orbit, boundedness at the good points, the shrinking-ball margin, and the
orbit clause) as explicit hypotheses: exactly what the cut construction provides. -/

/-- **The assembly from the cut good set.**  Suppose `M = σ b` is countably generated and Borel,
`H ⊆ Z` is a *good* set on which the `M`-shapes along the orbit are relatively open, the `M`-shape
at the good points is bounded by `Uball U ρ`, the margin `Uball U (c μⁿ) ⊆ shape M U (aⁿ y)` holds
for `n ≥ N`, and the `M`-atoms at the good points lie in the `U`-orbits.  Suppose moreover that
`Z` is `M`-measurable (`descSig t M`-measurable), saturated, and that every atom of a point of `Z`
is the atom of a point of `H`.  Then `descSig t M` is a plaque algebra for `U` on `Z`. -/
theorem isPlaqueAlgebra_descSig_of_CutGood {U : Subgroup SL3} {t : Fin 3 → ℝ} (hU : IsHoro U)
    {M : MeasurableSpace X3} {b : Set (Set X3)} (hb : b.Countable)
    (hMb : M = MeasurableSpace.generateFrom b) (hMle : M ≤ borel X3)
    {H Z : Set X3} {ρ c mu lam : ℝ} {N : ℕ} (hρ : 0 < ρ) (hc : 0 < c)
    (hlam0 : 0 ≤ lam) (hlam_mu : lam < mu) (hmu1 : mu < 1)
    (hrate : ∀ n : ℕ, ∀ u : SL3, u ∈ U → u ∈ Work.EKLComp.Uball U ρ →
      aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ∈ Work.EKLComp.Uball U (ρ * lam ^ n))
    (hopenM : ∀ y ∈ H, ∀ n : ℕ, ∃ W : Set SL3, IsOpen W ∧
      shape M U (((fun x : X3 => aDiag t • x)^[n]) y) = W ∩ (U : Set SL3))
    (hbddH : ∀ y ∈ H, shape M U y ⊆ Work.EKLComp.Uball U ρ)
    (hmarginH : ∀ y ∈ H, ∀ n : ℕ, N ≤ n → Work.EKLComp.Uball U (c * mu ^ n) ⊆
      shape M U (((fun x : X3 => aDiag t • x)^[n]) y))
    (horbM : ∀ y ∈ H, atom M y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3))
    (hZmeas : MeasurableSet[descSig t M] Z)
    (hsat : ∀ x ∈ Z, atom (descSig t M) x ⊆ Z)
    (hmeet : ∀ x ∈ Z, ∃ y ∈ H, atom (descSig t M) x = atom (descSig t M) y) :
    IsPlaqueAlgebra U Z (descSig t M) := by
  have hAle : descSig t M ≤ borel X3 := descSig_le_borel M hMle
  have horbH : ∀ y ∈ H, atom (descSig t M) y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3) :=
    fun y hy => (atom_descSig_le t M y).trans (horbM y hy)
  obtain ⟨b', hb'c, hb'eq⟩ := descSig_countably_generated hb hMb
  -- the shape of the atom is open at the points of `H`
  have hopenH : ∀ y ∈ H, ∃ O : Set SL3, IsOpen O ∧
      shape (descSig t M) U y = O ∩ (U : Set SL3) := by
    intro y hy
    exact isOpen_shape_pastSig_of_margin (N := N) hU hlam0 hlam_mu hmu1 hc hρ hrate
      (fun n => hopenM y hy n) (hbddH y hy) (fun n hn => hmarginH y hy n hn)
  -- the shape of the `M`-atom is bounded at the points of `H`, hence so is the `A`-shape
  have hbddA : ∀ y ∈ H, shape (descSig t M) U y ⊆ Work.EKLComp.Uball U ρ := by
    intro y hy u hu
    exact hbddH y hy ⟨hu.1, atom_descSig_le t M y hu.2⟩
  -- the atom-mates of a point of `H` are within `Uball U ρ`
  have hatombd : ∀ y ∈ H, atom (descSig t M) y ⊆
      (fun u : SL3 => u • y) '' (Work.EKLComp.Uball U ρ) := by
    intro y hy z hz
    rw [atom_eq_smul_shape (horbH y hy)] at hz
    obtain ⟨u, hu, rfl⟩ := hz
    exact ⟨u, hbddA y hy hu, rfl⟩
  obtain ⟨D, hD⟩ := Work.EKLProd.inv_entries_bound ρ hρ
  have hD0 : 0 ≤ D :=
    le_trans (abs_nonneg _) (hD 1 (Work.EKLContract.Lemmas.V_open_one ρ hρ).2 0 0)
  refine ⟨hAle, ⟨b', hb'c, hb'eq⟩, hZmeas, fun x hx => ?_⟩
  refine ⟨hsat x hx, atom_subset_orb_of_forall_exists_atom_eq hmeet horbH x hx,
    exists_isOpen_shape_of_forall_exists_atom_eq hmeet horbH hopenH x hx, ?_⟩
  refine exists_bound_shape_of_forall_exists_atom_eq (A := descSig t M) (U := U)
    (H := H) (Z := Z) (ρ := ρ)
    ?_ ?_ (fun g hg i j => hD g (hg.2 : g ∈ Work.EKLContract.V ρ) i j) hD0 x hx
  · intro x' hx'
    obtain ⟨y, hyH, hxy⟩ := hmeet x' hx'
    have hx'atom : x' ∈ atom (descSig t M) y := by rw [← hxy]; exact mem_atom_self _ x'
    obtain ⟨u, hu, hux⟩ := hatombd y hyH hx'atom
    exact ⟨y, hyH, u, hu, hux.symm, hxy⟩
  · intro y hy
    refine ⟨1 + ρ, fun v hv i j => ?_⟩
    have h1 : |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ρ := (hbddA y hy hv).2 i j
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    calc |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
        = |(((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
          rw [sub_add_cancel]
      _ ≤ |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| :=
          abs_add_le _ _
      _ ≤ ρ + 1 := add_le_add (le_of_lt h1) h2
      _ = 1 + ρ := by ring

/-- **`Work.EKLC6Core.exists_desc_subordinate`** — L1 of C6 (Pisa 7.37/7.38). -/
theorem exists_desc_subordinate (μ : MeasureTheory.Measure Work.EKLContract.X3)
    [MeasureTheory.IsProbabilityMeasure μ] (U : Subgroup Work.EKLContract.SL3)
    (hU : Work.EKLContract.IsHoro U) (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto
      (fun n : ℕ => Work.EKLContract.aDiag t ^ n * u * (Work.EKLContract.aDiag t ^ n)⁻¹)
      Filter.atTop (nhds 1)) :
    ∀ ε : ENNReal, 0 < ε →
      ∃ A : MeasurableSpace Work.EKLContract.X3,
      ∃ Z : Set Work.EKLContract.X3,
      Work.EKLContract.IsPlaqueAlgebra U Z A ∧ μ (Zᶜ) < ε ∧
        MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A ≤ A :=
  Work.EKLC6Core.exists_desc_subordinate_from_cut μ U hU t hmp hcontr

