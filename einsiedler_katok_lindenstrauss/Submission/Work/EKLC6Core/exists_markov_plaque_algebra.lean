/-!
# `Work.EKLC6Core.exists_markov_plaque_algebra`

The Markov-plaque-algebra core used by `Work.EKLC6Core.exists_gen_plaque_erg`: a σ-algebra whose
atoms on a conull set are bounded `Uminus t`-plaques, which is `aDiag t`-decreasing, whose atoms
off the conull set are singletons, and whose shapes admit a single entrywise bound.

## Architecture of the proof

1. `mem_atom_generateFrom_iff''` : the atoms of `σ(S)` are the membership-pattern classes of `S`.
2. `exists_refine_singletons` : *refinement by singletons off a saturated set*.
3. `markov_of_core` : the target from the geometric core.
4. `exists_desc_plaque_algebra_uniform` : the geometric core (Pisa 7.37/7.38), assembled from the
   countable cell cover `Work.EKLC6Core.cell_relthin_cover2` together with the *orbit-depth* input:
   along a.e. orbit the orbit point is `c μ^n`-deep inside its cell for some `μ` strictly above the
   contraction rate `λ` of `aDiag t` on `Uminus t`.  The depth is produced in two steps
   (`margin_rate_of_depth` here):
   * the *relative* depth (`Work.EKLC6Core.cell_relative_depth`, from the relative thinness of the
     cell collar, `Work.EKLC6Core.cell_relthin_cover2`), giving `V (γ^n injCap (φ^n x))`-depth,
   * the *sublinear growth* of the depth (`Work.EKLC6Core.ae_injCap_depth`), giving
     `injCap (φ^n x) ≥ e^{-δn}` for every `δ > 0` eventually;
   with `γ e^{-δ} > μ` the two combine into the absolute margin at rate `μ`.
-/

namespace Work.EKLC6Core

open MeasureTheory Filter Topology
open scoped ENNReal
open Work.EKLContract

/-- **Membership in an atom of a σ-algebra generated by an arbitrary family.**  Two points lie in
the same atom of `σ(S)` iff they have the same membership pattern in the family `S`. -/
lemma mem_atom_generateFrom_iff'' {S : Set (Set X3)} (x y : X3) :
    y ∈ atom (MeasurableSpace.generateFrom S) x ↔ ∀ s ∈ S, (y ∈ s ↔ x ∈ s) := by
  classical
  constructor
  · intro hy s hs
    refine ⟨fun hys => ?_, fun hxs => ?_⟩
    · by_contra hxs
      exact (Set.mem_sInter.mp hy sᶜ
        ⟨(MeasurableSpace.measurableSet_generateFrom hs).compl, by simpa using hxs⟩)
        (by simpa using hys)
    · exact Set.mem_sInter.mp hy s ⟨MeasurableSpace.measurableSet_generateFrom hs, hxs⟩
  · intro h
    refine Set.mem_sInter.mpr ?_
    rintro t ⟨ht, hxt⟩
    have key : x ∈ t ↔ y ∈ t :=
      MeasurableSpace.generateFrom_induction S (fun t _ => x ∈ t ↔ y ∈ t)
        (fun t ht' _ => (h t ht').symm)
        (by simp)
        (fun t _ ht' => ht'.not)
        (fun g _ hg => by
          simp only [Set.mem_iUnion]
          exact exists_congr hg)
        t ht
    exact key.mp hxt

/-- Atoms are antitone in the σ-algebra. -/
theorem atom_mono'' {m m' : MeasurableSpace X3} (h : m ≤ m') (x : X3) :
    atom m' x ⊆ atom m x := by
  intro y hy
  rw [atom] at hy ⊢
  rintro s ⟨hs, hxs⟩
  exact hy s ⟨h s hs, hxs⟩

/-- Every point lies in its own atom. -/
theorem mem_atom_self'' (m : MeasurableSpace X3) (x : X3) : x ∈ atom m x := by
  rw [atom]
  exact Set.mem_sInter.mpr fun s hs => hs.2

/-- **Refinement by singletons off a saturated set.**

`A` is a countably generated sub-`σ`-algebra of the Borel `σ`-algebra of `X₃`, `φ` is Borel
measurable and `A` is `φ`-decreasing (`comap φ A ≤ A`); `Z` is `A`-measurable, `A`-saturated
(`atom A x ⊆ Z` for `x ∈ Z`) and forward invariant under `φ`.  Let `W` be a countable family of
Borel subsets of `Zᶜ` covering `Zᶜ` and separating its points.  Then there is a σ-algebra `M ≥ A`
with

* `M` countably generated and `M ≤ borel X₃`,
* `comap φ M ≤ M`,
* `atom M x = atom A x` for `x ∈ Z`,
* `atom M x = {x}` for `x ∉ Z`.

The added generators are the sets `φ^{-k}(W n)`. -/
theorem exists_refine_singletons {A : MeasurableSpace X3} {Z : Set X3} {φ : X3 → X3}
    (W : ℕ → Set X3)
    (hWmeas : ∀ n, @MeasurableSet X3 instMeasurableSpaceX3 (W n))
    (hWsub : ∀ n, W n ⊆ Zᶜ)
    (hWcov : ∀ x, x ∉ Z → ∃ n, x ∈ W n)
    (hWsep : ∀ x, x ∉ Z → ∀ y, y ∉ Z → x ≠ y → ∃ n, x ∈ W n ∧ y ∉ W n)
    (hAle : A ≤ instMeasurableSpaceX3)
    (hφ : @Measurable X3 X3 instMeasurableSpaceX3 instMeasurableSpaceX3 φ)
    (hAcg : ∃ b : Set (Set X3), b.Countable ∧ A = MeasurableSpace.generateFrom b)
    (hdec : MeasurableSpace.comap φ A ≤ A)
    (hZ : @MeasurableSet X3 A Z) (hsat : ∀ x ∈ Z, atom A x ⊆ Z)
    (hfwd : ∀ x ∈ Z, φ x ∈ Z) :
    ∃ M : MeasurableSpace X3, @MeasurableSet X3 M Z ∧ M ≤ instMeasurableSpaceX3 ∧
      (∃ b, b.Countable ∧ M = MeasurableSpace.generateFrom b) ∧
      MeasurableSpace.comap φ M ≤ M ∧
      (∀ x ∈ Z, atom M x = atom A x) ∧
      (∀ x, x ∉ Z → atom M x = {x}) := by
  classical
  obtain ⟨b, hbc, hAeq⟩ := hAcg
  set R : Set (Set X3) := Set.range (fun p : ℕ × ℕ => (φ^[p.1]) ⁻¹' (W p.2)) with hRdef
  have hRc : R.Countable := Set.countable_range _
  -- the atom relation is preserved by `φ`
  have hpres : ∀ u : X3, ∀ y ∈ atom A u, φ y ∈ atom A (φ u) := by
    intro u y hy
    rw [atom, Set.mem_sInter] at hy ⊢
    rintro s ⟨hs, hus⟩
    exact hy (φ ⁻¹' s) ⟨hdec (φ ⁻¹' s)
      (MeasurableSpace.measurableSet_comap.mpr ⟨s, hs, rfl⟩), hus⟩
  have hpresN : ∀ k : ℕ, ∀ u : X3, ∀ y ∈ atom A u,
      (φ^[k]) y ∈ atom A ((φ^[k]) u) := by
    intro k
    induction k with
    | zero => intro u y hy; simpa using hy
    | succ m ih =>
      intro u y hy
      have h1 := hpres u y hy
      have h2 := ih (φ u) (φ y) h1
      simpa [Function.iterate_succ_apply] using h2
  -- the σ-algebra presentation
  have hMeq : A ⊔ MeasurableSpace.generateFrom R
      = MeasurableSpace.generateFrom (b ∪ R) := by
    rw [hAeq]
    refine le_antisymm (sup_le (MeasurableSpace.generateFrom_mono Set.subset_union_left)
      (MeasurableSpace.generateFrom_mono Set.subset_union_right)) ?_
    refine MeasurableSpace.generateFrom_le ?_
    rintro s (hs | hs)
    · exact MeasurableSpace.le_def.mp le_sup_left s (MeasurableSpace.measurableSet_generateFrom hs)
    · exact MeasurableSpace.le_def.mp le_sup_right s (MeasurableSpace.measurableSet_generateFrom hs)
  refine ⟨A ⊔ MeasurableSpace.generateFrom R, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact MeasurableSpace.le_def.mp le_sup_left Z hZ
  · refine sup_le hAle ?_
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨⟨k, n⟩, rfl⟩
    exact (hφ.iterate k) (hWmeas n)
  · exact ⟨b ∪ R, hbc.union hRc, hMeq⟩
  · rw [MeasurableSpace.comap_sup]
    refine sup_le (le_trans hdec le_sup_left) ?_
    rw [MeasurableSpace.comap_generateFrom]
    refine le_trans (MeasurableSpace.generateFrom_mono ?_) le_sup_right
    rintro s ⟨t, ⟨⟨k, n⟩, rfl⟩, rfl⟩
    refine ⟨(k + 1, n), ?_⟩
    ext x
    simp [Function.iterate_succ_apply]
  · intro x hx
    refine le_antisymm ?_ ?_
    · -- `atom M x ⊆ atom A x`
      intro y hy
      exact atom_mono'' le_sup_left x hy
    · -- `atom A x ⊆ atom M x`
      intro y hy
      have hy' : y ∈ atom (MeasurableSpace.generateFrom b) x := hAeq ▸ hy
      rw [hMeq]
      refine (mem_atom_generateFrom_iff'' x y).mpr ?_
      rintro s (hs | hs)
      · exact (mem_atom_generateFrom_iff'' x y).mp hy' s hs
      · obtain ⟨⟨k, n⟩, rfl⟩ := hs
        simp only [Set.mem_preimage]
        have hxk : (φ^[k]) x ∈ Z := by
          induction k with
          | zero => simpa using hx
          | succ m ih => simpa [Function.iterate_succ_apply'] using hfwd _ ih
        have hyk : (φ^[k]) y ∈ Z := by
          have hmem : (φ^[k]) y ∈ atom A ((φ^[k]) x) := hpresN k x y hy
          exact hsat _ hxk hmem
        have hxW : (φ^[k]) x ∉ W n := fun h => by
          have h1 := hWsub n h
          rw [Set.mem_compl_iff] at h1
          exact h1 hxk
        have hyW : (φ^[k]) y ∉ W n := fun h => by
          have h1 := hWsub n h
          rw [Set.mem_compl_iff] at h1
          exact h1 hyk
        exact ⟨fun h => absurd h hyW, fun h => absurd h hxW⟩
  · -- singletons off `Z`
    have hWmem : ∀ n : ℕ, W n ∈ b ∪ R := fun n =>
      Set.subset_union_right ⟨(0, n), by ext z; simp⟩
    intro x hx
    refine Set.eq_singleton_iff_unique_mem.mpr ⟨mem_atom_self'' _ x, ?_⟩
    intro y hy
    by_contra hyx
    have hxy : x ≠ y := fun h => hyx h.symm
    rw [hMeq] at hy
    by_cases hyZ : y ∈ Z
    · obtain ⟨n, hxn⟩ := hWcov x hx
      have hyn : y ∉ W n := fun h => by
        have h1 := hWsub n h
        rw [Set.mem_compl_iff] at h1
        exact h1 hyZ
      exact hyn (((mem_atom_generateFrom_iff'' x y).mp hy (W n) (hWmem n)).mpr hxn)
    · obtain ⟨n, hxn, hyn⟩ := hWsep x hx y hyZ hxy
      exact hyn (((mem_atom_generateFrom_iff'' x y).mp hy (W n) (hWmem n)).mpr hxn)

/-- **The target from the geometric core.**  The core is
`exists_desc_plaque_algebra_uniform`: an `aDiag t`-decreasing plaque algebra for `Uminus t` on a
conull, saturated, forward-invariant set with a uniform entrywise shape bound.  The
`atom M x = {x}` clause off the conull set is produced by `exists_refine_singletons`. -/
theorem markov_of_core {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hcore : ∃ (A : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z A ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A ∧
      (∀ x ∈ Z, (fun x : X3 => aDiag t • x) x ∈ Z) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom A x → ∀ i j, |u i j| ≤ C)) :
    ∃ (M : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z M ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) M ≤ M ∧
      (∀ x : X3, x ∉ Z → atom M x = {x}) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom M x → ∀ i j, |u i j| ≤ C) := by
  obtain ⟨A, Z, C, hplq, hZμ, hdec, hfwd, hbnd⟩ := hcore
  obtain ⟨hAle, hAcg, hZmeas, hplaque⟩ := hplq
  have hBc : @MeasurableSet X3 instMeasurableSpaceX3 (Zᶜ) := (hAle Z hZmeas).compl
  obtain ⟨W, hWmeas, hWsub, hWcov, hWsep⟩ := separating_family_borel hBc
  have hφ : @Measurable X3 X3 instMeasurableSpaceX3 instMeasurableSpaceX3
      (fun x : X3 => aDiag t • x) := by
    letI : MeasurableSpace X3 := instMeasurableSpaceX3
    exact (ContinuousConstSMul.continuous_const_smul (aDiag t)).measurable
  have hsat : ∀ x ∈ Z, atom A x ⊆ Z := fun x hx => (hplaque x hx).1
  obtain ⟨M, hMZ, hMle, hMcg, hMdec, hatomZ, hsing⟩ :=
    exists_refine_singletons W hWmeas hWsub hWcov hWsep hAle hφ hAcg hdec hZmeas hsat hfwd
  refine ⟨M, Z, C, ?_, hZμ, hMdec, hsing, ?_⟩
  · refine ⟨hMle, hMcg, hMZ, ?_⟩
    intro x hx
    obtain ⟨h1, h2, h3, h4⟩ := hplaque x hx
    have hshape : shape M (Uminus t) x = shape A (Uminus t) x := by
      simp only [shape, hatomZ x hx]
    refine ⟨?_, ?_, hshape ▸ h3, hshape ▸ h4⟩
    · rw [hatomZ x hx]; exact h1
    · rw [hatomZ x hx]; exact h2
  · intro x hx u hu hux i j
    have hshape : shape M (Uminus t) x = shape A (Uminus t) x := by
      simp only [shape, hatomZ x hx]
    have h3 : u ∈ shape A (Uminus t) x := by
      rw [← hshape]

      exact ⟨hu, hux⟩
    have h4 : u • x ∈ atom A x := by
      have h5 := h3
      simp only [shape, Set.mem_setOf_eq] at h5
      exact h5.2
    exact hbnd x hx u hu h4 i j
/-! ## The geometric core from the cell cover and the orbit depth -/

/-- **The absolute orbit depth from the relative depth and the sublinear growth of the depth.**

Let `φ x = aDiag t • x` and suppose that along the orbit of `x` the orbit point is
`c γ^n · injCap (φ^n x)`-deep inside its cell, while the capped injectivity radius grows at most
sublinearly: `injCap (φ^n x) ≥ e^{-δ n}` eventually.  Then the orbit point is `ρ^n`-deep for
every rate `ρ < γ · e^{-δ}`.

This is the only place where the two independent geometric inputs are combined: the *relative*
depth (produced by the relative thinness of the cell collar) and the *absence of fast plunging*
into the cusp (produced by the pointwise Lyapunov bound for `injCap` plus the ergodic theorem). -/
theorem margin_rate_of_depth {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    {Q : ℕ → Set X3} {c γ ρ δ : ℝ} (hc : 0 < c) (hγ : 0 < γ) (hδ : 0 < δ) (hρ : 0 < ρ)
    (hργ : ρ < γ * Real.exp (-δ))
    (hrel : ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
      ∀ v : SL3, v ∈ V (c * γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x)) →
        v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k)
    (hnop : ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop,
      Real.exp (-(δ * n)) ≤ injCap (((fun y : X3 => aDiag t • y)^[n]) x)) :
    ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
      ∀ v : SL3, v ∈ V (ρ ^ n) → v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k := by
  classical
  have hG0 : 0 < γ * Real.exp (-δ) := mul_pos hγ (Real.exp_pos _)
  have hq0 : 0 ≤ ρ / (γ * Real.exp (-δ)) := le_of_lt (div_pos hρ hG0)
  have hq1 : ρ / (γ * Real.exp (-δ)) < 1 := (div_lt_one hG0).mpr hργ
  have hpow : Filter.Tendsto (fun n : ℕ => (ρ / (γ * Real.exp (-δ))) ^ n) Filter.atTop
      (nhds 0) := tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hq1
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp
    (hpow.eventually (isOpen_Iio.mem_nhds (show (0 : ℝ) < c from hc)))
  filter_upwards [hrel, hnop] with x hxrel hxnop
  obtain ⟨N₁, hN₁⟩ := Filter.eventually_atTop.mp hxrel
  obtain ⟨N₂, hN₂⟩ := Filter.eventually_atTop.mp hxnop
  refine Filter.eventually_atTop.mpr ⟨max N (max N₁ N₂), fun n hn k hk v hv => ?_⟩
  have hmax : max N₁ N₂ ≤ n := le_trans (le_max_right N (max N₁ N₂)) hn
  have hnN : N ≤ n := le_trans (le_max_left N (max N₁ N₂)) hn
  have hnN₁ : N₁ ≤ n := le_trans (le_max_left N₁ N₂) hmax
  have hnN₂ : N₂ ≤ n := le_trans (le_max_right N₁ N₂) hmax
  have hnr : (ρ / (γ * Real.exp (-δ))) ^ n ≤ c := le_of_lt (hN n hnN)
  have hnop' : Real.exp (-(δ * n)) ≤ injCap (((fun y : X3 => aDiag t • y)^[n]) x) := hN₂ n hnN₂
  -- `ρ^n = (ρ / (γ e^{-δ}))^n · γ^n · e^{-δ n} ≤ c γ^n injCap (φ^n x)`
  have hexp : Real.exp (-δ) ^ n = Real.exp (-(δ * n)) := by
    rw [← Real.exp_nat_mul]
    congr 1
    ring
  have hdiv : (ρ / (γ * Real.exp (-δ))) ^ n * (γ * Real.exp (-δ)) ^ n = ρ ^ n := by
    rw [← mul_pow, div_mul_cancel₀ _ (ne_of_gt hG0)]
  have hmul : (γ * Real.exp (-δ)) ^ n = γ ^ n * Real.exp (-(δ * n)) := by
    rw [mul_pow, hexp]
  have hρpow : ρ ^ n = (ρ / (γ * Real.exp (-δ))) ^ n * (γ ^ n * Real.exp (-(δ * n))) := by
    rw [← hdiv, hmul]
  have hkey : ρ ^ n ≤ c * γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x) := by
    rw [hρpow]
    have hγn : 0 ≤ γ ^ n := pow_nonneg hγ.le n
    have h1 : (ρ / (γ * Real.exp (-δ))) ^ n * (γ ^ n * Real.exp (-(δ * n)))
        ≤ c * (γ ^ n * Real.exp (-(δ * n))) := by
      exact mul_le_mul_of_nonneg_right hnr (mul_nonneg hγn (Real.exp_pos _).le)
    have h2 : c * (γ ^ n * Real.exp (-(δ * n))) ≤ c * (γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x)) := by
      exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hnop' hγn) hc.le
    calc (ρ / (γ * Real.exp (-δ))) ^ n * (γ ^ n * Real.exp (-(δ * n)))
        ≤ c * (γ ^ n * Real.exp (-(δ * n))) := h1
      _ ≤ c * (γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x)) := h2
      _ = c * γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x) := by ring
  exact hN₁ n hnN₁ k hk v (Work.Misiurewicz.V_mono hkey hv)

/-! ## Two elementary "a.e. to Borel-conull" lemmas -/

/-- **A Borel set of full measure outside of which an a.e. statement holds.** -/
lemma exists_compl_null_of_ae {μ : MeasureTheory.Measure X3} {P : X3 → Prop}
    (h : ∀ᵐ x ∂μ, P x) :
    ∃ T : Set X3, @MeasurableSet X3 instMeasurableSpaceX3 T ∧ μ T = 0 ∧ ∀ x ∉ T, P x := by
  refine ⟨MeasureTheory.toMeasurable μ {x | ¬ P x},
    MeasureTheory.measurableSet_toMeasurable μ _, ?_, ?_⟩
  · rw [MeasureTheory.measure_toMeasurable]
    exact MeasureTheory.ae_iff.mp h
  · intro x hx
    by_contra hc
    exact hx (MeasureTheory.subset_toMeasurable μ _ hc)

/-- **A Borel set of full measure outside of which each member of a countable family of a.e.
statements holds.** -/
lemma exists_compl_null_of_forall_nat {μ : MeasureTheory.Measure X3} {P : ℕ → X3 → Prop}
    (h : ∀ n : ℕ, ∀ᵐ x ∂μ, P n x) :
    ∃ T : Set X3, @MeasurableSet X3 instMeasurableSpaceX3 T ∧ μ T = 0 ∧
      ∀ x ∉ T, ∀ n : ℕ, P n x := by
  refine ⟨⋃ n : ℕ, MeasureTheory.toMeasurable μ {x | ¬ P n x},
    MeasurableSet.iUnion fun n => MeasureTheory.measurableSet_toMeasurable μ _, ?_, ?_⟩
  · refine MeasureTheory.measure_iUnion_null fun n => ?_
    rw [MeasureTheory.measure_toMeasurable]
    exact MeasureTheory.ae_iff.mp (h n)
  · intro x hx n
    by_contra hc
    exact hx (Set.mem_iUnion.mpr ⟨n, MeasureTheory.subset_toMeasurable μ _ hc⟩)

/-! ## The atom mate of a point of a cell is reached by a small element of `U` -/

/-- **Small orbit mate.**  If `y` lies in the cell `Q k` and `x` lies in the atom of `y` for the
cut σ-algebra `MSigCut U Q d g O`, then `x = u • y` for an element `u ∈ U` which is *uniformly*
close to the identity: `u ∈ V (1 / 2)`.

Indeed `x ∈ atom (MSigCut …) y` means that `x` is the image of `u * liftR k y` for some `u ∈ U`
with `u * liftR k y` in the lifted ball `V (d k) · g k`; since `liftR k y ∈ V (d k / 2) · g k`,
the element `u` differs from the identity by at most `6 d k + 15 (d k)² ≤ 2⁻¹`. -/
lemma exists_smul_mem_V_half_of_mem_atom_MSigCut {U : Subgroup SL3}
    {Q : ℕ → Set X3} {d : ℕ → ℝ} {g : ℕ → SL3} {O : ℕ → Set SL3}
    (hopen : ∀ k, IsOpen (Q k)) (hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l))
    (hdpos : ∀ k, 0 < d k) (hdsmall : ∀ k, d k ≤ 1 / 16)
    (hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (d k / 2)))
    (hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * d k) → v₂ ∈ V (4 * d k) →
      v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂)
    (hOopen : ∀ m, IsOpen (O m))
    (hOsep : ∀ z w : SL3, (∀ m, (z ∈ satUC U (O m) ↔ w ∈ satUC U (O m))) →
      w ∈ satUC U ({z} : Set SL3))
    {k : ℕ} {y x : X3} (hy : y ∈ Q k)
    (hx : x ∈ atom (MSigCut U Q d g O) y) :
    ∃ u ∈ U, u ∈ V (1 / 2) ∧ x = u • y := by
  classical
  let R : RawCells U :=
    { Q := Q, d := d, g := g, O := O, hopen := hopen, hdisj := hdisj, hdpos := hdpos,
      hdsmall := hdsmall, hsub := hsub, hinj := hinj, hOopen := hOopen, hOsep := hOsep }
  have hx' : x ∈ atom (MSigCut U R.Q R.d R.g R.O) y := hx
  rw [atom_MSigCut R hy] at hx'
  obtain ⟨⟨g', hg'mem, hg'x⟩, -⟩ := hx'
  obtain ⟨u, huU, hgu⟩ := hg'mem.1
  obtain ⟨w, hw, hwg⟩ := hg'mem.2
  obtain ⟨w₀, hw₀, hw₀g⟩ := liftR_mem_half R k hy
  change w * R.g k = g' at hwg
  change w₀ * R.g k = R.liftR k y at hw₀g
  have huw : u * w₀ = w := by
    refine mul_right_cancel (b := R.g k) ?_
    rw [mul_assoc, hw₀g, ← hgu, ← hwg]
  have hw₀inv : w₀⁻¹ ∈ V (10 * (d k / 2)) :=
    Work.EKLComp.inv_mem_V (by linarith [hdpos k]) (by linarith [hdsmall k]) hw₀
  have hueq : u = w * w₀⁻¹ := eq_mul_inv_iff_mul_eq.mpr huw
  have huV : u ∈ V (1 / 2) := by
    rw [hueq]
    refine V_mono' ?_ (V_mul_subset_V (s := d k) (t := 10 * (d k / 2))
      (le_of_lt (hdpos k)) (by linarith [hdpos k]) hw hw₀inv)
    nlinarith [hdpos k, hdsmall k, sq_nonneg (d k)]
  refine ⟨u, huU, huV, ?_⟩
  rw [← hg'x, hgu, atomMSig_smul_mkX, liftR_mkX R k hy]

/-! ## The geometric core from the cell cover and the orbit depth -/

/-! ## A self-contained copy of the "past σ-algebra" bookkeeping

The original API (`Work.EKLC6Core.pastSig` and its three lemmas) lives in
`Submission.Work.EKLC6Core.exists_desc_plaque_algebra`, a module which also imports
`Submission.Work.EKLC6Core.adapted_partition` and hence (transitively)
`Submission.Work.EKLC6Core.thin_boundary_partition`.  The latter defines the global name
`Work.EKLC6Core.measurableSet_Vball`, which `Submission.Work.EKLC6Core.cell_relthin_cover2` also
defines: a file importing both cannot be elaborated.  Since this file needs the cells of
`cell_relthin_cover2`, the four elementary facts below are reproduced here (under the local name
`pastSigA`) so that no import of this file drags in `thin_boundary_partition`. -/

/-- The "past" σ-algebra of `M` along the diagonal flow `aDiag t`: the join of the pullbacks of
`M` by the forward iterates of `x ↦ aDiag t • x`. -/
@[instance_reducible] noncomputable def pastSigA (t : Fin 3 → ℝ) (M : MeasurableSpace X3) :
    MeasurableSpace X3 :=
  ⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M

/-- The pullback of the Borel σ-algebra along one step of the flow is contained in it. -/
theorem comap_action_borel_le' (t : Fin 3 → ℝ) :
    MeasurableSpace.comap (fun x : X3 => aDiag t • x) (borel X3) ≤ borel X3 := by
  change MeasurableSpace.comap (fun x : X3 => aDiag t • x)
      (MeasurableSpace.generateFrom {s : Set X3 | IsOpen s}) ≤
    MeasurableSpace.generateFrom {s : Set X3 | IsOpen s}
  rw [MeasurableSpace.comap_generateFrom]
  refine MeasurableSpace.generateFrom_le ?_
  rintro s ⟨V, hV, rfl⟩
  exact MeasurableSpace.measurableSet_generateFrom
    ((show IsOpen V from hV).preimage (continuous_const_smul (aDiag t)))

/-- The pullback of the Borel σ-algebra along an iterate of the flow is contained in it. -/
theorem comap_action_pow_borel_le' (t : Fin 3 → ℝ) (n : ℕ) :
    MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) (borel X3) ≤ borel X3 := by
  induction n with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ', ← MeasurableSpace.comap_comp]
    exact le_trans (MeasurableSpace.comap_mono (comap_action_borel_le' t)) ih

theorem pastSigA_le_borel {t : Fin 3 → ℝ} {M : MeasurableSpace X3} (hM : M ≤ borel X3) :
    pastSigA t M ≤ borel X3 :=
  iSup_le fun n => le_trans (MeasurableSpace.comap_mono hM) (comap_action_pow_borel_le' t n)

theorem pastSigA_self_le (t : Fin 3 → ℝ) (M : MeasurableSpace X3) : M ≤ pastSigA t M := by
  have h := le_iSup (fun n : ℕ => MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M) 0
  rwa [Function.iterate_zero, MeasurableSpace.comap_id] at h

theorem pastSigA_countably_generated {t : Fin 3 → ℝ} {M : MeasurableSpace X3}
    {b : Set (Set X3)} (hb : b.Countable) (hMb : M = MeasurableSpace.generateFrom b) :
    ∃ b' : Set (Set X3), b'.Countable ∧ pastSigA t M = MeasurableSpace.generateFrom b' := by
  refine ⟨⋃ n : ℕ, (fun s : Set X3 => ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' s) '' b, ?_, ?_⟩
  · exact Set.countable_iUnion fun n => hb.image _
  · refine le_antisymm ?_ ?_
    · refine iSup_le fun n => ?_
      have h1 : MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M =
          MeasurableSpace.generateFrom ((fun s : Set X3 =>
            ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' s) '' b) := by
        rw [hMb, MeasurableSpace.comap_generateFrom]
      rw [h1]
      exact MeasurableSpace.generateFrom_mono
        (Set.subset_iUnion (fun n : ℕ =>
          (fun s : Set X3 => ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' s) '' b) n)
    · rw [hMb]
      refine MeasurableSpace.generateFrom_le ?_
      intro s hs
      rw [Set.mem_iUnion] at hs
      obtain ⟨n, hs'⟩ := hs
      obtain ⟨t', ht', heq⟩ := hs'
      rw [← heq]
      refine MeasurableSpace.le_def.mp (le_iSup (fun n : ℕ =>
        MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n])
          (MeasurableSpace.generateFrom b)) n) _ ?_
      rw [MeasurableSpace.comap_generateFrom]
      exact MeasurableSpace.measurableSet_generateFrom (Set.mem_image_of_mem _ ht')

/-- **Atoms of a σ-algebra generated by a sequence, in terms of the sequence.** -/
theorem mem_atom_generateFrom_range_iff' {B : ℕ → Set X3} {x y : X3} :
    y ∈ atom (MeasurableSpace.generateFrom (Set.range B)) x ↔ ∀ n : ℕ, (y ∈ B n ↔ x ∈ B n) := by
  rw [mem_atom_generateFrom_iff'']
  constructor
  · intro h n
    exact h (B n) (Set.mem_range_self n)
  · rintro h s ⟨n, rfl⟩
    exact h n

/-- If an `ℝ≥0∞` number is below `(k + 1)⁻¹` for every `k`, it vanishes. -/
lemma eq_zero_of_forall_lt_inv_succ' {a : ℝ≥0∞}
    (h : ∀ n : ℕ, a < ((n : ℝ≥0∞) + 1)⁻¹) : a = 0 := by
  by_contra hne
  obtain ⟨n, hn⟩ := ENNReal.exists_inv_nat_lt hne
  have hle : ((n : ℝ≥0∞) + 1)⁻¹ ≤ (n : ℝ≥0∞)⁻¹ := by
    rw [← Nat.cast_add_one]
    exact ENNReal.inv_le_inv' (by exact_mod_cast Nat.le_succ n)
  exact absurd (lt_trans (lt_of_lt_of_le (h n) hle) hn) (lt_irrefl a)

/-- **A conull, `A`-measurable, saturated set all of whose atoms meet a full-measure Borel set.**

`A` is countably generated and contained in the Borel σ-algebra, and `H` is a Borel set of full
`μ`-measure.  Then there is an `A`-measurable `Z` with `μ Zᶜ = 0` which is a union of `A`-atoms
(so `atom A x ⊆ Z` for `x ∈ Z`) and every `A`-atom of a point of `Z` is the atom of a point of
`H`.

This is the conull (ε → 0) form of `Work.Topology.exists_measurable_saturated_large`, applied at
the levels `ε k = (k + 1)⁻¹` and taking the union of the resulting sets. -/
theorem exists_measurable_saturated_conull_sat {A : MeasurableSpace X3}
    (hAle : A ≤ borel X3)
    (hgen : ∃ b : Set (Set X3), b.Countable ∧ A = MeasurableSpace.generateFrom b)
    (μ : @MeasureTheory.Measure X3 instMeasurableSpaceX3)
    [MeasureTheory.IsProbabilityMeasure μ]
    {H : Set X3} (hH : @MeasurableSet X3 instMeasurableSpaceX3 H) (hH1 : μ H = 1) :
    ∃ Z : Set X3, @MeasurableSet X3 A Z ∧ μ Zᶜ = 0 ∧
      (∀ x ∈ Z, atom A x ⊆ Z) ∧
      (∀ x ∈ Z, ∃ y ∈ H, atom A x = atom A y) := by
  classical
  letI : MeasurableSpace X3 := instMeasurableSpaceX3
  -- a generating sequence of `A`
  obtain ⟨b, hbc, hbA⟩ := hgen
  obtain ⟨B, hBgen, hBmeas⟩ : ∃ B : ℕ → Set X3,
      MeasurableSpace.generateFrom (Set.range B) = A ∧ ∀ n, @MeasurableSet X3 A (B n) := by
    obtain ⟨f, hf⟩ := (hbc.insert Set.univ).exists_eq_range
      ⟨Set.univ, Set.mem_insert _ _⟩
    refine ⟨f, ?_, ?_⟩
    · rw [hbA, ← hf, MeasurableSpace.generateFrom_insert_univ]
    · intro n
      have hmem : f n ∈ insert Set.univ b := by rw [hf]; exact Set.mem_range_self n
      rcases Set.mem_insert_iff.mp hmem with h | h
      · rw [h]; exact @MeasurableSet.univ X3 A
      · rw [hbA]; exact MeasurableSpace.measurableSet_generateFrom h
  have hprob : MeasureTheory.IsProbabilityMeasure (μ.trim hAle) :=
    MeasureTheory.IsProbabilityMeasure.mk (by
      rw [MeasureTheory.trim_measurableSet_eq (μ := μ) hAle (@MeasurableSet.univ X3 A),
        MeasureTheory.measure_univ])
  haveI := hprob
  have hH1' : (μ.trim hAle) H = 1 := by
    refine le_antisymm ?_ ?_
    · calc (μ.trim hAle) H ≤ (μ.trim hAle) Set.univ :=
          MeasureTheory.measure_mono (Set.subset_univ H)
        _ = 1 := MeasureTheory.measure_univ
    · calc (1 : ℝ≥0∞) = μ H := hH1.symm
        _ ≤ (μ.trim hAle) H := MeasureTheory.le_trim (μ := μ) hAle
  have hkey : ∀ k : ℕ, ∃ Z : Set X3, @MeasurableSet X3 A Z ∧
      (∀ x ∈ Z, ∀ z : X3, (∀ n : ℕ, (z ∈ B n ↔ x ∈ B n)) → z ∈ Z) ∧
      (∀ x ∈ Z, ∃ y ∈ H, ∀ n : ℕ, (x ∈ B n ↔ y ∈ B n)) ∧
      μ Zᶜ < ((k : ℝ≥0∞) + 1)⁻¹ := by
    intro k
    have hpos : (0 : ℝ≥0∞) < ((k : ℝ≥0∞) + 1)⁻¹ := by
      rw [ENNReal.inv_pos]; simp
    have hlt : 1 - ((k : ℝ≥0∞) + 1)⁻¹ < (μ.trim hAle) H := by
      rw [hH1']
      exact ENNReal.sub_lt_self (by simp) (by simp) hpos.ne'
    obtain ⟨Z, hZ1, hZ2, hZ3, hZ4⟩ :=
      @Work.Topology.exists_measurable_saturated_large X3 _ _ _ instMeasurableSpaceX3 _ A hAle
        B hBmeas H hH (μ.trim hAle) hprob ((k : ℝ≥0∞) + 1)⁻¹ hpos hlt
    refine ⟨Z, hZ1, hZ3, hZ2, ?_⟩
    rw [MeasureTheory.trim_measurableSet_eq (μ := μ) hAle hZ1.compl] at hZ4
    exact hZ4
  choose Z hZmeas hZsat hZmeet hZμ using hkey
  refine ⟨⋃ k : ℕ, Z k, MeasurableSet.iUnion hZmeas, ?_, ?_, ?_⟩
  · have hle : ∀ k : ℕ, μ (⋃ k, Z k)ᶜ < ((k : ℝ≥0∞) + 1)⁻¹ := by
      intro k
      calc μ (⋃ k, Z k)ᶜ ≤ μ (Z k)ᶜ := MeasureTheory.measure_mono (by
            rw [Set.compl_iUnion]
            exact Set.iInter_subset (fun k => (Z k)ᶜ) k)
        _ < _ := hZμ k
    exact eq_zero_of_forall_lt_inv_succ' hle
  · intro x hx z hz
    obtain ⟨k, hxk⟩ := Set.mem_iUnion.mp hx
    have hpat : ∀ n : ℕ, (z ∈ B n ↔ x ∈ B n) := by
      have hz' : z ∈ atom (MeasurableSpace.generateFrom (Set.range B)) x := by
        rw [hBgen]; exact hz
      exact mem_atom_generateFrom_range_iff'.mp hz'
    exact Set.mem_iUnion.mpr ⟨k, hZsat k x hxk z hpat⟩
  · intro x hx
    obtain ⟨k, hxk⟩ := Set.mem_iUnion.mp hx
    obtain ⟨y, hyH, hpat⟩ := hZmeet k x hxk
    refine ⟨y, hyH, ?_⟩
    rw [← hBgen]
    ext z
    constructor
    · intro hz
      exact mem_atom_generateFrom_range_iff'.mpr
        (fun n => (mem_atom_generateFrom_range_iff'.mp hz n).trans (hpat n))
    · intro hz
      exact mem_atom_generateFrom_range_iff'.mpr
        (fun n => (mem_atom_generateFrom_range_iff'.mp hz n).trans (hpat n).symm)

/-- **The relative openness of the shape of the descending σ-algebra at a good point.**

This is `Work.EKLC6Core.shape_pastSig_open_of_cell_margin` reproduced here (it is not imported
in order to avoid the `measurableSet_Vball` name clash described above), with the final step
`Work.EKLC6Core.isOpen_shape_pastSig_of_margin` (`margin_shape.lean`) in place of
`shape_open_of_finite_margin`; both are the same finite-margin argument. -/
theorem shape_open_of_cell_data
    {U : Subgroup SL3} (hU : IsHoro U) (t : Fin 3 → ℝ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto
      (fun n : ℕ => aDiag t ^ n * u * (aDiag t ^ n)⁻¹) Filter.atTop (nhds 1))
    {Q : ℕ → Set X3} {d : ℕ → ℝ} {g : ℕ → SL3} {O : ℕ → Set SL3}
    (hopen : ∀ k, IsOpen (Q k)) (hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l))
    (hdpos : ∀ k, 0 < d k) (hdsmall : ∀ k, d k ≤ 1 / 16)
    (hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (d k / 2)))
    (hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * d k) → v₂ ∈ V (4 * d k) →
      v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂)
    (hOopen : ∀ m, IsOpen (O m))
    (hOsep : ∀ z w : SL3, (∀ m, (z ∈ satUC U (O m) ↔ w ∈ satUC U (O m))) →
      w ∈ satUC U ({z} : Set SL3))
    {x : X3}
    (hmem : ∀ n : ℕ, ∃ k : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k)
    (hfree : ∀ n : ℕ, ∀ u ∈ U,
      u • (((fun y : X3 => aDiag t • y)^[n]) x) = (((fun y : X3 => aDiag t • y)^[n]) x) → u = 1)
    {c μ lam : ℝ} (hc : 0 < c) (hlam0 : 0 < lam) (hlam1 : lam < 1) (hlμ : lam < μ) (hμ1 : μ < 1)
    (hlammax : ∀ i j : Fin 3, t i < t j → Real.exp (t i - t j) ≤ lam)
    (hmarg : ∃ N : ℕ, ∀ n ≥ N, Work.EKLComp.Uball U (c * μ ^ n) ⊆
      shape (MSigCut U Q d g O) U (((fun y : X3 => aDiag t • y)^[n]) x)) :
    ∃ W : Set SL3, IsOpen W ∧
      shape (pastSigA t (MSigCut U Q d g O)) U x = W ∩ (U : Set SL3) := by
  classical
  let R : RawCells U :=
    { Q := Q, d := d, g := g, O := O, hopen := hopen, hdisj := hdisj, hdpos := hdpos,
      hdsmall := hdsmall, hsub := hsub, hinj := hinj, hOopen := hOopen, hOsep := hOsep }
  have hMeq : MSigCut U Q d g O = MSigCut U R.Q R.d R.g R.O := rfl
  -- (1) relative openness of the shape at each orbit point
  have hopen' : ∀ n : ℕ, ∃ W : Set SL3, IsOpen W ∧
      shape (MSigCut U R.Q R.d R.g R.O) U
        (((fun y : X3 => aDiag t • y)^[n]) x) = W ∩ (U : Set SL3) := by
    intro n
    obtain ⟨k, hk⟩ := hmem n
    obtain ⟨W, hW, hWeq⟩ := shape_trace_open (U := U) (Q := R.Q k) (R.hopen k)
      (isOpen_liftedC (R.d k) (R.g k))
      (R.liftR k (((fun y : X3 => aDiag t • y)^[n]) x))
      (((fun y : X3 => aDiag t • y)^[n]) x)
    exact ⟨W, hW, by rw [shape_MSigCut R hk (hfree n), hWeq]⟩
  -- (2) uniform ball bound at time 0
  have hbddk : shape (MSigCut U R.Q R.d R.g R.O) U
      (((fun y : X3 => aDiag t • y)^[0]) x) ⊆ Work.EKLComp.Uball U (1 / 2) := by
    obtain ⟨k, hk⟩ := hmem 0
    have hkx : x ∈ Q k := by simpa only [Function.iterate_zero, id_eq] using hk
    have hfree0 : ∀ u ∈ U, u • x = x → u = 1 := by
      intro u huU hu
      exact hfree 0 u huU (by simpa only [Function.iterate_zero, id_eq] using hu)
    intro u hu
    simp only [Function.iterate_zero, id_eq] at hu
    rw [shape_MSigCut R hkx hfree0] at hu
    obtain ⟨huU, hgl, -⟩ := hu
    obtain ⟨v, hv, hv_eq⟩ := hgl
    obtain ⟨w, hw, hw_eq⟩ := liftR_mem_half R k hk
    have hv_eq' : v * R.g k = u * R.liftR k x := by simpa using hv_eq
    have hw_eq' : w * R.g k = R.liftR k x := by simpa using hw_eq
    have h1 : v * R.g k = (u * w) * R.g k := by rw [mul_assoc, hw_eq', ← hv_eq']
    have huv : v = u * w := mul_right_cancel h1
    have hueq : u = v * w⁻¹ := by rw [huv, mul_inv_cancel_right]
    exact mem_Uball_half_of (U := U) (R.hdpos k) (R.hdsmall k) huU hueq hv hw
  -- (3) margin hypothesis in `R`-form
  have hmarg' : ∃ N : ℕ, ∀ n ≥ N, Work.EKLComp.Uball U (c * μ ^ n) ⊆
      shape (MSigCut U R.Q R.d R.g R.O) U
        (((fun y : X3 => aDiag t • y)^[n]) x) := by
    rw [← hMeq]; exact hmarg
  -- (4) the finite-margin openness theorem
  obtain ⟨N₀, hN₀⟩ := hmarg'
  obtain ⟨O', hO'open, hO'eq⟩ :=
    isOpen_shape_pastSig_of_margin (U := U) (t := t) hU (lam := lam) (mu := μ)
      (le_of_lt hlam0) hlμ hμ1 (M := MSigCut U R.Q R.d R.g R.O) (x := x) (c := c) (ρ := 1 / 2)
      hc (by norm_num)
      (fun n u _ hu => conj_pow_mem_Uball hU hcontr hlam0 hlammax hu n)
      hopen' hbddk (fun n hn => hN₀ n hn)
  refine ⟨O', hO'open, ?_⟩
  rw [hMeq]
  rw [show pastSigA t (MSigCut U R.Q R.d R.g R.O) =
      (⨆ n : ℕ, MeasurableSpace.comap
        ((fun y : X3 => aDiag t • y)^[n]) (MSigCut U R.Q R.d R.g R.O)) from rfl]
  exact hO'eq

/-- **The core from a cell cover and an orbit margin.**  The assembly described in
`NOTES_ASSEMBLY_SESSION3.md`: from the countable cell cover, the separating family `O` and the
a.e. orbit margin at the absolute rate `μ0` (with `λ < μ0 < 1`, `λ` a contraction rate of
`aDiag t` on `Uminus t`) one obtains the core: an `aDiag t`-decreasing σ-algebra `A ≤ borel X₃`,
conull on a saturated forward-invariant set `Z`, with bounded open `Uminus t`-plaques as atoms
and a single entrywise bound `C` on the shapes.

The proof proceeds in five steps.

1. `A := pastSig t (MSigCut (Uminus t) Q d g O)`; it is Borel, countably generated, satisfies
   `M ≤ A` (`M := MSigCut …`), and is `aDiag t`-decreasing.
2. A Borel conull set `H` on which *all* the pointwise hypotheses hold: the whole orbit of a point
   of `H` is free and stays in the cells, and the orbit margin holds.
3. At every `y ∈ H` the four pointwise facts about `A` hold: the atom lies in the `Uminus t`-orbit
   of `y`, the shape of the atom is the trace on `Uminus t` of an open set (this is
   `shape_pastSig_open_of_cell_margin`, whose margin hypothesis comes from
   `margin_mem_atom_pointwise`), and the shape is contained in `Uball (Uminus t) (1 / 2)`.
4. `exists_measurable_saturated_conull_pastSigA` produces an `A`-measurable conull `Z₁` which is a
   union of `A`-atoms, every atom of which meets `H`; the hull `Z := ⋂ₙ (aDiag t ·)^-n Z₁` is then
   `A`-measurable, conull, saturated and forward invariant.
5. Every `x ∈ Z` has an atom mate `y ∈ H`, reached by an element of `Uball (Uminus t) (1 / 2)`
   (`exists_smul_mem_V_half_of_mem_atom_MSigCut`); the four pointwise facts therefore transfer from
   `H` to `Z` (right translation by a *fixed* ball), and the entrywise bound is uniform because
   `exists_bound_shape_uniform_of_atom_eq` keeps the constant. -/
theorem core_of_cell_data {μ : MeasureTheory.Measure X3} [MeasureTheory.IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ) (hErg : IsAErgodic μ)
    {Q : ℕ → Set X3} {d : ℕ → ℝ} {g : ℕ → SL3} {O : ℕ → Set SL3}
    (hopen : ∀ k, IsOpen (Q k)) (hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l))
    (hcover : μ (Set.iUnion fun k => Q k)ᶜ = 0)
    (hdpos : ∀ k, 0 < d k) (hdsmall : ∀ k, d k ≤ 1 / 16)
    (hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (d k / 2)))
    (hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * d k) → v₂ ∈ V (4 * d k) →
      v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂)
    (hOopen : ∀ m, IsOpen (O m))
    (hOvis : ∀ z : SL3, ∃ m, z ∈ satUC (Uminus t) (O m))
    (hOsep : ∀ z w : SL3, (∀ m, (z ∈ satUC (Uminus t) (O m) ↔ w ∈ satUC (Uminus t) (O m))) →
      w ∈ satUC (Uminus t) ({z} : Set SL3))
    {lam μ0 : ℝ} (hlam0 : 0 < lam) (hlam1 : lam < 1)
    (hlammax : ∀ i j : Fin 3, t i < t j → Real.exp (t i - t j) ≤ lam)
    (hlμ : lam < μ0) (hμ01 : μ0 < 1)
    (hmarg : ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
      ∀ v : SL3, v ∈ V (μ0 ^ n) → v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k) :
    ∃ (A : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z A ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A ∧
      (∀ x ∈ Z, (fun x : X3 => aDiag t • x) x ∈ Z) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom A x → ∀ i j, |u i j| ≤ C) := by
  classical
  obtain ⟨hU, hcontr⟩ := uminus_isHoro t
  have hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ := hErg.1 t
  -- the two σ-algebras
  let M : MeasurableSpace X3 := MSigCut (Uminus t) Q d g O
  let A : MeasurableSpace X3 := pastSigA t M
  letI : MeasurableSpace X3 := instMeasurableSpaceX3
  have hMdef : M = MSigCut (Uminus t) Q d g O := rfl
  have hAdef : A = pastSigA t M := rfl
  have hMle : M ≤ instMeasurableSpaceX3 := by
    rw [hMdef]; exact MSigCut_le_borel_of hopen hOopen
  have hMA : M ≤ A := by rw [hAdef]; exact pastSigA_self_le t M
  have hAle : A ≤ instMeasurableSpaceX3 := by rw [hAdef]; exact pastSigA_le_borel hMle
  have hMgen : ∃ b : Set (Set X3), b.Countable ∧ M = MeasurableSpace.generateFrom b := by
    refine ⟨Set.range Q ∪ Set.range (fun p : ℕ × ℕ => genCut (Uminus t) Q d g O p.1 p.2),
      (Set.countable_range Q).union (Set.countable_range _), ?_⟩
    rw [hMdef]
    rfl
  have hAcg : ∃ b : Set (Set X3), b.Countable ∧ A = MeasurableSpace.generateFrom b := by
    obtain ⟨b, hbc, hMb⟩ := hMgen
    rw [hAdef]
    exact pastSigA_countably_generated hbc hMb
  -- `A` is decreasing for the flow
  have hdecA : MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
    rw [hAdef]
    change MeasurableSpace.comap (fun x : X3 => aDiag t • x)
        (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M) ≤
      (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M)
    rw [MeasurableSpace.comap_iSup]
    refine iSup_le fun n => ?_
    have heq : MeasurableSpace.comap (fun x : X3 => aDiag t • x)
        (MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M)
        = MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n + 1]) M := by
      rw [MeasurableSpace.comap_comp, ← Function.iterate_succ]
    rw [heq]
    exact le_iSup (fun n : ℕ => MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M) (n + 1)
  have hdecAiter : ∀ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) A ≤ A := by
    intro n
    induction n with
    | zero => exact le_of_eq (by rw [Function.iterate_zero, MeasurableSpace.comap_id])
    | succ m ih =>
      have heq : MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[m + 1]) A
          = MeasurableSpace.comap (fun x : X3 => aDiag t • x)
              (MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[m]) A) := by
        rw [MeasurableSpace.comap_comp, ← Function.iterate_succ]
      rw [heq]
      exact le_trans (MeasurableSpace.comap_mono ih) hdecA
  -- the atoms of `A` are preserved by the flow
  have hpres : ∀ u : X3, ∀ y ∈ atom A u,
      (fun x : X3 => aDiag t • x) y ∈ atom A ((fun x : X3 => aDiag t • x) u) := by
    intro u y hy
    rw [atom, Set.mem_sInter] at hy ⊢
    rintro s ⟨hs, hus⟩
    exact hy ((fun x : X3 => aDiag t • x) ⁻¹' s)
      ⟨hdecA _ (MeasurableSpace.measurableSet_comap.mpr ⟨s, hs, rfl⟩), hus⟩
  have hpresN : ∀ k : ℕ, ∀ u : X3, ∀ y ∈ atom A u,
      ((fun x : X3 => aDiag t • x)^[k]) y ∈
        atom A (((fun x : X3 => aDiag t • x)^[k]) u) := by
    intro k
    induction k with
    | zero => intro u y hy; simpa using hy
    | succ m ih =>
      intro u y hy
      have h1 := hpres u y hy
      have h2 := ih _ _ h1
      simpa [Function.iterate_succ_apply] using h2
  -- a Borel conull set carrying the pointwise hypotheses
  have hfree_ae : ∀ᵐ x ∂μ, x ∈ cutFree (Uminus t) :=
    ae_free_orbit_of_contraction (Uminus t) hU t hmp hcontr
  have hcutinv : (fun y : X3 => aDiag t • y) ⁻¹' cutFree (Uminus t) = cutFree (Uminus t) :=
    (cutFree_transfer hU t).2.1
  have hpre : ∀ n : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) ⁻¹' cutFree (Uminus t) = cutFree (Uminus t) := by
    intro n
    induction n with
    | zero => rw [Function.iterate_zero, Set.preimage_id]
    | succ m ih => rw [Function.iterate_succ', Set.preimage_comp, hcutinv, ih]
  have hfreeN : ∃ T : Set X3, MeasurableSet T ∧ μ T = 0 ∧
      ∀ x ∉ T, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ cutFree (Uminus t) := by
    refine exists_compl_null_of_forall_nat fun n => ?_
    have h : ∀ᵐ x ∂μ, x ∈ ((fun y : X3 => aDiag t • y)^[n]) ⁻¹' cutFree (Uminus t) := by
      rw [hpre n]; exact hfree_ae
    exact h
  have hcoverN : ∃ T : Set X3, MeasurableSet T ∧ μ T = 0 ∧
      ∀ x ∉ T, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k : ℕ, Q k :=
    exists_compl_null_of_ae (ae_orbit_mem_iUnion_cellsW (t := t) hmp Q hcover)
  have hTmarg : ∃ T : Set X3, MeasurableSet T ∧ μ T = 0 ∧
      ∀ x ∉ T, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
        ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
        ∀ v : SL3, v ∈ V (μ0 ^ n) →
          v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k :=
    exists_compl_null_of_ae hmarg
  obtain ⟨T₁, hT₁m, hT₁μ, hT₁⟩ := hfreeN
  obtain ⟨T₂, hT₂m, hT₂μ, hT₂⟩ := hcoverN
  obtain ⟨T₃, hT₃m, hT₃μ, hT₃⟩ := hTmarg
  set H : Set X3 := (T₁ ∪ T₂ ∪ T₃)ᶜ with hHdef
  have hHmeas : MeasurableSet H := ((hT₁m.union hT₂m).union hT₃m).compl
  have hHμ : μ H = 1 := by
    have h0 : μ (T₁ ∪ T₂ ∪ T₃) = 0 :=
      MeasureTheory.measure_union_null (MeasureTheory.measure_union_null hT₁μ hT₂μ) hT₃μ
    have h4 : μ (T₁ ∪ T₂ ∪ T₃)ᶜ = μ Set.univ - μ (T₁ ∪ T₂ ∪ T₃) :=
      MeasureTheory.measure_compl ((hT₁m.union hT₂m).union hT₃m) (measure_ne_top μ _)
    rw [hHdef, h4, h0, MeasureTheory.measure_univ, tsub_zero]
  have hH₁ : ∀ x ∈ H, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ cutFree (Uminus t) := by
    intro x hx n
    rw [hHdef, Set.mem_compl_iff] at hx
    exact hT₁ x (fun hc => hx (Or.inl (Or.inl hc))) n
  have hH₂ : ∀ x ∈ H, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k : ℕ, Q k := by
    intro x hx n
    rw [hHdef, Set.mem_compl_iff] at hx
    exact hT₂ x (fun hc => hx (Or.inl (Or.inr hc))) n
  have hH₃ : ∀ x ∈ H, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
      ∀ v : SL3, v ∈ V (μ0 ^ n) →
        v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k := by
    intro x hx
    rw [hHdef, Set.mem_compl_iff] at hx
    exact hT₃ x (fun hc => hx (Or.inr hc))
  -- the pointwise facts at the points of `H`
  have hfreeH : ∀ y ∈ H, ∀ u ∈ Uminus t, u • y = y → u = 1 := by
    intro y hy
    have h : y ∈ cutFree (Uminus t) := by
      have h0 := hH₁ y hy 0
      simpa using h0
    exact h
  have hcellH : ∀ y ∈ H, ∃ k : ℕ, y ∈ Q k := by
    intro y hy
    exact Set.mem_iUnion.mp (by simpa using hH₂ y hy 0)
  have hatomOrbH : ∀ y ∈ H, atom A y ⊆ (fun u : SL3 => u • y) '' (Uminus t : Set SL3) := by
    intro y hy
    obtain ⟨k, hk⟩ := hcellH y hy
    have hfacts := cellsData_atom_facts (U := Uminus t) hopen hdisj hdpos hdsmall hsub hinj
      hOopen hOvis hOsep hk (hfreeH y hy)
    exact (atom_mono'' hMA y).trans hfacts.2.1
  have hshapeBddH : ∀ y ∈ H, shape A (Uminus t) y ⊆ Work.EKLComp.Uball (Uminus t) (1 / 2) := by
    intro y hy
    obtain ⟨k, hk⟩ := hcellH y hy
    have hfacts := cellsData_atom_facts (U := Uminus t) hopen hdisj hdpos hdsmall hsub hinj
      hOopen hOvis hOsep hk (hfreeH y hy)
    intro u hu
    exact hfacts.2.2.2 ⟨hu.1, atom_mono'' hMA y hu.2⟩
  have hmargAtH : ∀ y ∈ H, ∃ N : ℕ, ∀ n ≥ N,
      Work.EKLComp.Uball (Uminus t) (1 * μ0 ^ n) ⊆ shape M (Uminus t)
        (((fun y : X3 => aDiag t • y)^[n]) y) := by
    intro y hy
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (hH₃ y hy)
    refine ⟨N, fun n hn u hu => ⟨hu.1, ?_⟩⟩
    obtain ⟨k, hk⟩ := Set.mem_iUnion.mp (hH₂ y hy n)
    refine margin_mem_atom_pointwise (μ := μ) (U := Uminus t) hopen hdisj hcover hdpos hdsmall
      hsub hinj hOopen hOsep (k := k) (n := n) hk one_pos (lt_trans hlam0 hlμ) hμ01 ?_ hu.1 ?_
    · intro v hv
      exact hN n hn k hk v (by simpa using hv)
    · exact hu.2
  have hopenH : ∀ y ∈ H, ∃ W : Set SL3, IsOpen W ∧
      shape A (Uminus t) y = W ∩ (Uminus t : Set SL3) := by
    intro y hy
    obtain ⟨N, hN⟩ := hmargAtH y hy
    refine shape_open_of_cell_data (U := Uminus t) hU t hcontr hopen hdisj hdpos hdsmall
      hsub hinj hOopen hOsep (fun n => Set.mem_iUnion.mp (hH₂ y hy n))
      (fun n u hu => ?_) one_pos hlam0 hlam1 hlμ hμ01 hlammax ⟨N, hN⟩
    have h := hH₁ y hy n
    exact h u hu
  have hbdH : ∀ y ∈ H, ∀ v ∈ shape A (Uminus t) y, ∀ i j : Fin 3,
      |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 3 / 2 := by
    intro y hy v hv i j
    have h1 := hshapeBddH y hy hv
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    have hlt : |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| < 3 / 2 := by
      calc |(v : Matrix (Fin 3) (Fin 3) ℝ) i j|
          = |((v : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
              + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by ring_nf
        _ ≤ |(v : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
              + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
        _ < 1 / 2 + 1 := add_lt_add_of_lt_of_le (h1.2 i j) h2
        _ = 3 / 2 := by norm_num
    exact le_of_lt hlt
  -- the `A`-measurable conull saturated set whose atoms meet `H`
  obtain ⟨Z₁, hZ₁meas, hZ₁μ, hZ₁sat, hZ₁meet⟩ :=
    exists_measurable_saturated_conull_sat hAle hAcg μ hHmeas hHμ
  -- the hull
  set Z : Set X3 := ⋂ n : ℕ, ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' Z₁ with hZdef
  have hZmeas : @MeasurableSet X3 A Z := by
    rw [hZdef]
    exact MeasurableSet.iInter fun n =>
      hdecAiter n _ (MeasurableSpace.measurableSet_comap.mpr ⟨Z₁, hZ₁meas, rfl⟩)
  have hZμ : μ Zᶜ = 0 := by
    have hsub : Zᶜ ⊆ ⋃ n : ℕ, ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' Z₁ᶜ := by
      intro x hx
      rw [Set.mem_compl_iff] at hx
      by_contra hcon
      exact hx (by
        rw [hZdef, Set.mem_iInter]
        intro n
        by_contra hn
        exact hcon (Set.mem_iUnion.mpr ⟨n, by simpa using hn⟩))
    refine le_antisymm ?_ bot_le
    calc μ Zᶜ ≤ μ (⋃ n : ℕ, ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' Z₁ᶜ) :=
          MeasureTheory.measure_mono hsub
      _ ≤ ∑' n : ℕ, μ (((fun x : X3 => aDiag t • x)^[n]) ⁻¹' Z₁ᶜ) :=
          MeasureTheory.measure_iUnion_le _
      _ = 0 := ENNReal.tsum_eq_zero.mpr fun n => (hmp.iterate n).preimage_null hZ₁μ
  have hZsat : ∀ x ∈ Z, atom A x ⊆ Z := by
    intro x hx y hy
    rw [hZdef, Set.mem_iInter] at hx ⊢
    intro n
    exact hZ₁sat _ (hx n) (hpresN n x y hy)
  have hfwd : ∀ x ∈ Z, (fun x : X3 => aDiag t • x) x ∈ Z := by
    intro x hx
    rw [hZdef, Set.mem_iInter] at hx ⊢
    intro n
    have h1 : ((fun x : X3 => aDiag t • x)^[n + 1]) x ∈ Z₁ := hx (n + 1)
    simpa [Function.iterate_succ_apply] using h1
  have hmeet : ∀ x ∈ Z, ∃ y ∈ H, atom A x = atom A y := by
    intro x hx
    have hxZ₁ : x ∈ Z₁ := by
      have h := Set.mem_iInter.mp (by rw [← hZdef]; exact hx) 0
      simpa using h
    exact hZ₁meet x hxZ₁
  -- the small orbit mate
  have hsmall : ∀ x ∈ Z, ∃ y ∈ H, ∃ u ∈ Work.EKLComp.Uball (Uminus t) (1 / 2),
      x = u • y ∧ atom A x = atom A y := by
    intro x hx
    obtain ⟨y, hyH, hatomeq⟩ := hmeet x hx
    have hxaty : x ∈ atom A y := by rw [← hatomeq]; exact mem_atom_self_c A x
    have hxyM : x ∈ atom M y := atom_mono'' hMA y hxaty
    obtain ⟨k, hk⟩ := hcellH y hyH
    obtain ⟨u, huU, huV, hux⟩ := exists_smul_mem_V_half_of_mem_atom_MSigCut hopen hdisj hdpos
      hdsmall hsub hinj hOopen hOsep hk hxyM
    exact ⟨y, hyH, u, ⟨huU, huV⟩, hux, hatomeq⟩
  -- the uniform entrywise bound on `Z`
  have hD : ∀ gg ∈ Work.EKLComp.Uball (Uminus t) (1 / 2), ∀ i j : Fin 3,
      |(((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ)) i j| ≤ 9 := by
    intro gg hg i j
    have h1 : gg⁻¹ ∈ Work.EKLComp.Uball (Uminus t) (Work.EKLComp.ivent (1 / 2)) :=
      Work.EKLComp.Uball_inv (U := Uminus t) (a := 1 / 2) (by norm_num) gg hg
    have h2 : |((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < Work.EKLComp.ivent (1 / 2) := h1.2 i j
    have h3 : Work.EKLComp.ivent (1 / 2) = 31 / 4 := by
      rw [Work.EKLComp.ivent]; norm_num
    have h4 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    have h5 : |((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
        ≤ Work.EKLComp.ivent (1 / 2) + 1 := by
      calc |((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
          = |(((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
              - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
              + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by ring_nf
        _ ≤ |((gg⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
              - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
              + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
        _ ≤ Work.EKLComp.ivent (1 / 2) + 1 := add_le_add (le_of_lt h2) h4
    rw [h3] at h5; linarith
  have hboundU : ∀ x ∈ Z, ∀ v ∈ shape A (Uminus t) x, ∀ i j : Fin 3,
      |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 3 * |(3 : ℝ) / 2| * 9 :=
    exists_bound_shape_uniform_of_atom_eq hsmall hbdH hD (by norm_num)
  refine ⟨A, Z, 3 * |(3 : ℝ) / 2| * 9, ?_, hZμ, hdecA, hfwd, ?_⟩
  · refine ⟨hAle, hAcg, hZmeas, fun x hx => ⟨hZsat x hx, ?_, ?_, ?_⟩⟩
    · exact atom_subset_orb_of_forall_exists_atom_eq_c hmeet hatomOrbH x hx
    · exact exists_isOpen_shape_of_forall_exists_atom_eq_c hmeet hatomOrbH hopenH x hx
    · exact ⟨_, hboundU x hx⟩
  · intro x hx u hu hux i j
    exact hboundU x hx u ⟨hu, hux⟩ i j

/-- **The geometric core.** -/
theorem exists_desc_plaque_algebra_uniform {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hErg : IsAErgodic μ) :
    ∃ (A : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z A ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A ∧
      (∀ x ∈ Z, (fun x : X3 => aDiag t • x) x ∈ Z) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom A x → ∀ i j, |u i j| ≤ C) := by
  classical
  have hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ := hErg.1 t
  have hU : IsHoro (Uminus t) := (uminus_isHoro t).1
  obtain ⟨lam, hlam0, hlam1, hlammax⟩ := exists_contract_rate t
  -- the rates: `lam < μ0 < 1`, `μ0 < γ < 1`, `μ0 < γ e^{-δ}`
  set μ0 : ℝ := (lam + 1) / 2 with hμ0def
  have hμ00 : 0 < μ0 := by rw [hμ0def]; linarith
  have hlμ0 : lam < μ0 := by rw [hμ0def]; linarith
  have hμ01 : μ0 < 1 := by rw [hμ0def]; linarith
  set γ : ℝ := (μ0 + 1) / 2 with hγdef
  have hγ0 : 0 < γ := by rw [hγdef]; linarith
  have hγ1 : γ < 1 := by rw [hγdef]; linarith
  have hμ0γ : μ0 < γ := by rw [hγdef]; linarith
  -- a small `δ` with `μ0 < γ * exp (-δ)`
  obtain ⟨N, hN⟩ : ∃ N : ℕ, ∀ n : ℕ, N ≤ n → μ0 < γ * Real.exp (-(1 / ((n : ℝ) + 1))) := by
    have h0 : Filter.Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)
    have h1 : Filter.Tendsto (fun n : ℕ => Real.exp (-(1 / ((n : ℝ) + 1)))) Filter.atTop
        (nhds (Real.exp 0)) := by
      have hc : Filter.Tendsto (fun n : ℕ => -(1 / ((n : ℝ) + 1))) Filter.atTop (nhds 0) := by
        simpa using h0.neg
      exact Real.continuous_exp.continuousAt.tendsto.comp hc
    have h2 : Filter.Tendsto (fun n : ℕ => γ * Real.exp (-(1 / ((n : ℝ) + 1)))) Filter.atTop
        (nhds (γ * 1)) := by
      have h := h1.const_mul γ
      simpa [Real.exp_zero] using h
    have h3 : (γ * 1 : ℝ) = γ := mul_one γ
    have hlt : μ0 < γ * 1 := by rw [h3]; exact hμ0γ
    obtain ⟨M, hM⟩ := Filter.eventually_atTop.mp
      (h2.eventually (isOpen_Ioi.mem_nhds hlt))
    exact ⟨M, fun n hn => hM n hn⟩
  set δ : ℝ := 1 / ((N : ℝ) + 1) with hδdef
  have hδ0 : 0 < δ := by rw [hδdef]; positivity
  have hδγ : μ0 < γ * Real.exp (-δ) := by rw [hδdef]; exact hN N le_rfl
  -- the cell cover with the relative collar estimate
  obtain ⟨Q, d, gc, C₀, α, hopen, hdisj, hcover, hδc, hsub, hinj, hC₀, hα, hthin⟩ :=
    cell_relthin_cover2_alt (μ := μ)
  -- the separating family
  obtain ⟨O, hOopen, hOvis, hOsep⟩ := exists_base_sat_sep (Uminus t) hU.1
  -- the relative orbit depth and the absence of fast plunging
  have hrel0 := cell_relative_depth t hmp hdisj hC₀ hα hthin hγ0 hγ1
  have hrel : ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop, ∀ k : ℕ,
      ((fun y : X3 => aDiag t • y)^[n]) x ∈ Q k →
      ∀ v : SL3,
        v ∈ V (1 * γ ^ n * injCap (((fun y : X3 => aDiag t • y)^[n]) x)) →
        v • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ Q k := by
    filter_upwards [hrel0] with x hx
    filter_upwards [hx] with n hn k hk v hv
    exact hn k hk v (by simpa using hv)
  have hnop : ∀ᵐ x ∂μ, ∀ᶠ n : ℕ in Filter.atTop,
      Real.exp (-(δ * n)) ≤ injCap (((fun y : X3 => aDiag t • y)^[n]) x) :=
    (ae_injCap_depth t hmp).mono fun x hx => hx δ hδ0
  have hmarg := margin_rate_of_depth (μ := μ) t (c := 1) (γ := γ) (ρ := μ0) (δ := δ)
    one_pos hγ0 hδ0 hμ00 hδγ hrel hnop
  exact core_of_cell_data (μ := μ) t hErg hopen hdisj hcover (fun k => (hδc k).1)
    (fun k => (hδc k).2) hsub hinj hOopen (fun z => hOvis z) (fun z w h => hOsep z w h)
    hlam0 hlam1 hlammax hlμ0 hμ01 hmarg

theorem exists_markov_plaque_algebra {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ) (hErg : Work.EKLContract.IsAErgodic μ) :
    ∃ (M : MeasurableSpace Work.EKLContract.X3) (Z : Set Work.EKLContract.X3) (C : ℝ),
      Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z M ∧
      μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) M ≤ M ∧
      (∀ x : Work.EKLContract.X3, x ∉ Z → Work.EKLContract.atom M x = {x}) ∧
      (∀ x ∈ Z, ∀ u ∈ Work.EKLC6Core.Uminus t,
        u • x ∈ Work.EKLContract.atom M x → ∀ i j, |u i j| ≤ C) :=
  markov_of_core t (exists_desc_plaque_algebra_uniform t hErg)

end Work.EKLC6Core
