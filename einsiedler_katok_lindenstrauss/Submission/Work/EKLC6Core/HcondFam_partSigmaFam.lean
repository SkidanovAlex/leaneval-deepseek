import Mathlib
import Submission.Work.EKLComp.Hcond
import Submission.Work.EKLC6Core.condExp_partSigmaFam_poly
import Submission.Work.EKLC6Core.integral_partition_indicator
import Submission.Work.EKLC6Core.negMulLog_chain_rule

namespace Work.EKLC6Core

/-- **Chain rule for conditional Shannon entropy.**  For two finite measurable partitions `A`, `B`
of a probability space, the conditional entropy of `A` given the σ-algebra generated by `B` is the
difference of the joint entropy of `A ∨ B` (computed on the product index type `ι × κ`, where the
atom is `A i ∩ B j`) and the entropy of `B`:

  `H_μ(A | partSigmaFam B) = H_μ(A ∨ B) - H_μ(B)`,
  `H_μ(A ∨ B) = ∑_{i,j} negMulLog (μ (A i ∩ B j)).toReal`, `H_μ(B) = ∑_j negMulLog (μ (B j)).toReal`.

Suggested route: first show that for measurable `S`,
`condExp (partSigmaFam B) μ (S.indicator 1) =ᵐ Σ_j (B j).indicator (fun _ => (μ (B j)).toReal⁻¹ * (μ (S ∩ B j)).toReal)`
(the sets measurable for `partSigmaFam B` are exactly the unions `⋃ j ∈ J, B j`, so it suffices to
check the set integrals on those; the case `μ (B j) = 0` is handled by nullity of `B j`).  Then
integrate `negMulLog` over each atom `B j`, use `Real.negMulLog_mul` with
`Σ_i (μ (A i ∩ B j)).toReal = (μ (B j)).toReal` (`IsMPart.sum_measure_inter`) and
`(μ (B j)).toReal⁻¹ * (μ (B j)).toReal = 1` when `μ (B j) ≠ 0`. -/
theorem HcondFam_partSigmaFam {X : Type*} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X)
    [MeasureTheory.IsProbabilityMeasure μ] {ι κ : Type*} [Fintype ι] [Fintype κ]
    (A : ι → Set X) (B : κ → Set X)
    (hA : Work.EKLComp.Core.IsMPart A) (hB : Work.EKLComp.Core.IsMPart B) :
    Work.EKLComp.Core.HcondFam X μ A (Work.EKLComp.Core.partSigmaFam B)
      = Work.EKLContract.Hfam μ (fun p : ι × κ => A p.1 ∩ B p.2) - Work.EKLContract.Hfam μ B := by
  classical
  -- The row sums of the joint partition: `∑ i, μ (A i ∩ B j) = μ (B j)`.
  have hrow : ∀ j : κ, ∑ i : ι, (μ (A i ∩ B j)).toReal = (μ (B j)).toReal := by
    intro j
    have h1 : ∑ i : ι, μ (A i ∩ B j) = μ (B j) := by
      rw [show (∑ i : ι, μ (A i ∩ B j)) = ∑ i : ι, μ (B j ∩ A i) from
        Finset.sum_congr rfl fun i _ => by rw [Set.inter_comm]]
      exact Work.EKLComp.Core.IsMPart.sum_measure_inter μ hA (hB.measurable j)
    rw [← ENNReal.toReal_sum (fun i _ => MeasureTheory.measure_ne_top μ _), h1]
  -- Step 1: `condExp (partSigmaFam B) μ 1_{A i}` is the atomwise conditional probability.
  have hcond : ∀ i : ι, MeasureTheory.condExp (Work.EKLComp.Core.partSigmaFam B) μ
      ((A i).indicator (fun _ => (1 : ℝ)))
      =ᵐ[μ] fun x => ∑ j : κ, (B j).indicator
        (fun _ => ((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal) x :=
    fun i => condExp_indicator_partSigmaFam_poly μ B hB (A i) (hA.measurable i)
  -- Step 2: pass the a.e. equalities through the (finite) sum over `i`.
  have hsum_ae : (fun x => ∑ i : ι, Real.negMulLog
        (MeasureTheory.condExp (Work.EKLComp.Core.partSigmaFam B) μ
          ((A i).indicator (fun _ => (1 : ℝ))) x))
      =ᵐ[μ] (fun x => ∑ i : ι, Real.negMulLog
        (∑ j : κ, (B j).indicator
          (fun _ => ((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal) x)) := by
    filter_upwards [Finset.eventually_all Finset.univ |>.mpr (fun i _ => hcond i)] with x hx
    exact Finset.sum_congr rfl (fun i _ => by rw [hx i (Finset.mem_univ i)])
  -- Step 3: on each atom the integrand is the constant `∑ i, negMulLog (μ (A i ∩ B j) / μ (B j))`.
  have hpoint : (fun x => ∑ i : ι, Real.negMulLog
        (∑ j : κ, (B j).indicator
          (fun _ => ((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal) x))
      = fun x => ∑ j : κ, (B j).indicator
        (fun _ => ∑ i : ι, Real.negMulLog
          (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) x :=
    sum_negMulLog_indicator_atoms_poly hB
      (fun i j => ((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)
  -- Step 4: integrate the resulting "height function" of the partition `B`.
  have hint : ∫ x, (∑ j : κ, (B j).indicator
        (fun _ => ∑ i : ι, Real.negMulLog
          (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) x) ∂μ
      = ∑ j : κ, (∑ i : ι, Real.negMulLog
          (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) * (μ (B j)).toReal :=
    integral_partition_indicator μ hB
      (fun j => ∑ i : ι, Real.negMulLog
        (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal))
  -- Step 5: per-atom chain rule `b * ∑ i, negMulLog (c i / b) = ∑ i, negMulLog (c i) - negMulLog b`.
  have hchain : ∀ j : κ, (∑ i : ι, Real.negMulLog
        (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) * (μ (B j)).toReal
      = (∑ i : ι, Real.negMulLog ((μ (A i ∩ B j)).toReal))
        - Real.negMulLog ((μ (B j)).toReal) := by
    intro j
    have h := negMulLog_chain_rule ((μ (B j)).toReal)
      (fun i : ι => (μ (A i ∩ B j)).toReal) (fun i => ENNReal.toReal_nonneg) (hrow j).symm
    rw [mul_comm (∑ i : ι, Real.negMulLog
      (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) ((μ (B j)).toReal)]
    exact h
  -- Step 6: assemble the two sums into the difference of the entropies.
  have hfinal : (∑ j : κ, (∑ i : ι, Real.negMulLog
        (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) * (μ (B j)).toReal)
      = Work.EKLContract.Hfam μ (fun p : ι × κ => A p.1 ∩ B p.2)
        - Work.EKLContract.Hfam μ B := by
    have e1 : (∑ j : κ, (∑ i : ι, Real.negMulLog
          (((μ (B j)).toReal)⁻¹ * (μ (A i ∩ B j)).toReal)) * (μ (B j)).toReal)
        = ∑ j : κ, ((∑ i : ι, Real.negMulLog ((μ (A i ∩ B j)).toReal))
            - Real.negMulLog ((μ (B j)).toReal)) :=
      Finset.sum_congr rfl (fun j _ => hchain j)
    have e2 : (∑ j : κ, ∑ i : ι, Real.negMulLog ((μ (A i ∩ B j)).toReal))
        = Work.EKLContract.Hfam μ (fun p : ι × κ => A p.1 ∩ B p.2) := by
      rw [Work.EKLContract.Hfam, Fintype.sum_prod_type, Finset.sum_comm]
    have e3 : (∑ j : κ, Real.negMulLog ((μ (B j)).toReal)) = Work.EKLContract.Hfam μ B := by
      rw [Work.EKLContract.Hfam]
    rw [e1, Finset.sum_sub_distrib, e2, e3]
  rw [Work.EKLComp.Core.HcondFam]
  rw [MeasureTheory.integral_congr_ae hsum_ae]
  rw [hpoint]
  rw [hint]
  exact hfinal

end Work.EKLC6Core
