import Mathlib
import Submission.Work.EKLC6Core.cutSetup
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq

/-!
# `Work.EKLC6Core.atom_gen_cut` — the atoms of the cut σ-algebra (Pisa 7.38, step 3)

Let `S` be the cut data (`CutData μ U ε`: finitely many disjoint open cells `cell i` with a
locally `U`-equivariant lift `lift i`, together with an open "bad" piece), and let `O : ℕ → Set SL3`
be a countable family of open sets whose `U`-saturations cover `SL₃(ℝ)` (`hvis`) and which
**separates the left `U`-cosets** (`hsep`: two group elements with the same `sat`-signature are
`U`-congruent).  Let `M` be the σ-algebra generated by the *cell-wise* generators

`genCell S O i m = mkX '' (sat U (O m) ∩ shift (V (10 ρ)) (g i)) ∩ cell i`

together with the bad piece.  Then for `y ∈ cell i`:

`atom_M y = {w ∈ cell i | ∃ u ∈ U, lift i w = u * lift i y}`.

Mathematically the point of the cell-wise indexing (as opposed to `gen S O m = ⋃ i genCell …`) is
that the cell index is recorded by the σ-algebra: `cell i = ⋃ m, genCell S O i m` is an
`M`-measurable set, so the atom can never be bigger than `cell i`.  Inside the cell the lift
turns the `genCell`-pattern of a point into the `sat U (O m)`-pattern of its lift, which the
separation hypothesis `hsep` resolves into membership in the left `U`-orbit.

The proof uses no measure theory: it is purely about the σ-algebra and the lift.
-/

open MeasureTheory Topology

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3} {ε : ℝ}

/-- **`sat U A` is invariant under left multiplication by `U`.** -/
lemma mem_sat_mul_iff {u : SL3} (hu : u ∈ U) (A : Set SL3) (h : SL3) :
    u * h ∈ sat U A ↔ h ∈ sat U A := by
  constructor
  · rintro ⟨v, hv, a, ha, hva⟩
    refine ⟨u⁻¹ * v, U.mul_mem (U.inv_mem hu) hv, a, ha, ?_⟩
    calc u⁻¹ * v * a = u⁻¹ * (v * a) := by rw [mul_assoc]
      _ = u⁻¹ * (u * h) := by rw [hva]
      _ = h := by group
  · rintro ⟨v, hv, a, ha, hva⟩
    refine ⟨u * v, U.mul_mem hu hv, a, ha, ?_⟩
    calc u * v * a = u * (v * a) := by rw [mul_assoc]
      _ = u * h := by rw [hva]

/-- The `U`-saturation of a singleton is the left `U`-coset. -/
lemma mem_sat_singleton {z h : SL3} :
    h ∈ sat U ({z} : Set SL3) ↔ ∃ u ∈ U, u * z = h := by
  rw [sat]
  constructor
  · rintro ⟨u, hu, o, ho, huo⟩
    rw [Set.mem_singleton_iff] at ho
    subst ho
    exact ⟨u, hu, huo⟩
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u, hu, z, rfl, rfl⟩

/-- **The generator pattern of a point of a cell is the `sat`-pattern of its lift.** -/
lemma genCell_mem_iff (S : CutData μ U ε) (O : ℕ → Set SL3) (i : Fin S.N) (m : ℕ)
    {x : X3} (hx : x ∈ S.cell i) :
    x ∈ genCell S O i m ↔ S.lift i x ∈ sat U (O m) := by
  constructor
  · rintro ⟨⟨o, ho, hox⟩, -⟩
    have h1 : o = S.lift i x := S.lift_uniq i x hx o hox ho.2
    rw [← h1]
    exact ho.1
  · intro h
    exact ⟨⟨S.lift i x, ⟨h, S.lift_bdd i x hx⟩, S.lift_mk i x hx⟩, hx⟩

/-- **Each cell is the countable union of its generators.**  This is the reason the cell index
must occur in the generator indexing: it makes the cells measurable for the cut σ-algebra. -/
lemma cell_eq_iUnion_genCell (S : CutData μ U ε) (O : ℕ → Set SL3)
    (hvis : ∀ z : SL3, ∃ m, z ∈ sat U (O m)) (i : Fin S.N) :
    S.cell i = ⋃ m, genCell S O i m := by
  ext x
  constructor
  · intro hx
    obtain ⟨m, hm⟩ := hvis (S.lift i x)
    exact Set.mem_iUnion.mpr ⟨m, (genCell_mem_iff S O i m hx).mpr hm⟩
  · rintro hx
    obtain ⟨m, hm⟩ := Set.mem_iUnion.mp hx
    exact hm.2

theorem atom_gen_cut {μ : MeasureTheory.Measure Work.EKLContract.X3}
    {U : Subgroup Work.EKLContract.SL3} {ε : ℝ}
    (S : Work.EKLC6Core.CutData μ U ε) (O : ℕ → Set Work.EKLContract.SL3)
    (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : Work.EKLContract.SL3, ∃ m, z ∈ Work.EKLC6Core.sat U (O m))
    (hsep : ∀ z w : Work.EKLContract.SL3,
      (∀ m, (z ∈ Work.EKLC6Core.sat U (O m) ↔ w ∈ Work.EKLC6Core.sat U (O m))) →
      w ∈ Work.EKLC6Core.sat U ({z} : Set Work.EKLContract.SL3))
    (i : Fin S.N) (y : Work.EKLContract.X3) (hy : y ∈ S.cell i) :
    Work.EKLContract.atom (MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => Work.EKLC6Core.genCell S O p.1 p.2)
        ∪ {S.bad})) y
      = {w : Work.EKLContract.X3 | w ∈ S.cell i ∧
          ∃ u ∈ (U : Set Work.EKLContract.SL3), S.lift i w = u * S.lift i y} := by
  classical
  have hcell : S.cell i = ⋃ m, genCell S O i m := cell_eq_iUnion_genCell S O hvis i
  -- the "membership pattern" description of the atom
  have key : ∀ w : X3, w ∈ atom (MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => genCell S O p.1 p.2) ∪ {S.bad})) y ↔
      (∀ i' m, (w ∈ genCell S O i' m ↔ y ∈ genCell S O i' m)) ∧
        (w ∈ S.bad ↔ y ∈ S.bad) := by
    intro w
    rw [mem_atom_generateFrom_iff (x := y)]
    constructor
    · intro h
      exact ⟨fun i' m => h _ (Or.inl ⟨(i', m), rfl⟩), h _ (Or.inr rfl)⟩
    · rintro ⟨h1, h2⟩ A (⟨⟨i', m⟩, rfl⟩ | rfl)
      · exact h1 i' m
      · exact h2
  ext w
  constructor
  · -- `⊆`: the cell membership, then the lift relation via the separation hypothesis
    intro hw
    obtain ⟨hpat, -⟩ := (key w).mp hw
    have hmeas : MeasurableSet[MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => genCell S O p.1 p.2) ∪ {S.bad})] (S.cell i) := by
      rw [hcell]
      exact MeasurableSet.iUnion fun m =>
        MeasurableSpace.measurableSet_generateFrom (Or.inl ⟨(i, m), rfl⟩)
    have hwcell : w ∈ S.cell i := atom_subset_of_mem hmeas hy hw
    have hsat : ∀ m, S.lift i y ∈ sat U (O m) ↔ S.lift i w ∈ sat U (O m) := by
      intro m
      rw [← genCell_mem_iff S O i m hy, ← genCell_mem_iff S O i m hwcell]
      exact (hpat i m).symm
    obtain ⟨u, hu, hux⟩ := mem_sat_singleton.mp (hsep (S.lift i y) (S.lift i w) hsat)
    exact ⟨hwcell, u, hu, hux.symm⟩
  · -- `⊇`: a point of the cell whose lift is `U`-related to `lift i y` has the same pattern
    rintro ⟨hwcell, u, hu, hlift⟩
    have hybad : y ∉ S.bad := fun h => (Set.disjoint_left.mp (S.hbad_disj i)) hy h
    have hwbad : w ∉ S.bad := fun h => (Set.disjoint_left.mp (S.hbad_disj i)) hwcell h
    refine (key w).mpr ⟨?_, ⟨fun h => absurd h hwbad, fun h => absurd h hybad⟩⟩
    intro i' m
    by_cases hi : i' = i
    · rw [hi, genCell_mem_iff S O i m hwcell, genCell_mem_iff S O i m hy, hlift]
      exact mem_sat_mul_iff hu (O m) (S.lift i y)
    · have hw' : w ∉ genCell S O i' m := fun h =>
        (Set.disjoint_left.mp (S.hdisj i' i hi)) h.2 hwcell
      have hy' : y ∉ genCell S O i' m := fun h =>
        (Set.disjoint_left.mp (S.hdisj i' i hi)) h.2 hy
      exact ⟨fun h => absurd h hw', fun h => absurd h hy'⟩

end Work.EKLC6Core
