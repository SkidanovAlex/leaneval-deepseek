import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLC6Core.uminus_isHoro
import Submission.Work.EKLContract.Lemmas.isHoro_Upar

/-!
# Charts for the contracted horospherical subgroup `Uminus t`

`Work.EKLC6Core.Uminus t` is the subgroup of `SL₃(ℝ)` generated by the root groups `U_ij` with
`t i < t j`; sorting `t p ≤ t q ≤ t r`, it is one of

* `Uij hpq ⊔ Uij hpr ⊔ Uij hqr` (all three increasing pairs contracted, `t p < t q < t r`),
* `Uij hpq ⊔ Uij hpr` (same source `p`, `t p < t q = t r`),
* `Uij hpr ⊔ Uij hqr` (same target `r`, `t p = t q < t r`),
* `⊥` (`t` constant).

This module fixes, for each of the three non-degenerate order types, the chart taking the
coordinates of the unitriangular matrix

`1 + x₀ E_pq + x₁ E_qr + x₂ E_pr`   (with the irrelevant entries set to `0`)

to the corresponding element of `SL₃(ℝ)`, expressed through `uparShape` so that the group law and
the `toMat` bookkeeping of `Work.EKLContract.Lemmas.isHoro_Upar` apply verbatim.  It also fixes

* the group operation `uminusOp3` on the three coordinates of the Heisenberg-type group (the
  matrix entries of a product: `(x₀,x₁,x₂) * (y₀,y₁,y₂) = (x₀+y₀, x₁+y₁, x₂+y₂+x₀y₁)`; the other
  two charts are additive in their coordinates),
* the diagonal by which conjugation by `aDiag (-t)` acts on the coordinates, namely
  `exp (t j - t i)` on the entry `(i,j)`.

These are the objects the measure-theoretic assembly
(`Work.EKLC6Core.exists_haar_of_chart`) is instantiated with.
-/

open MeasureTheory

namespace Work.EKLC6Core

open Work.EKLContract
open Work.EKLContract.Lemmas

noncomputable section

/-! ## The three-dimensional order type `t p < t q < t r` -/

/-- The chart `(x₀,x₁,x₂) ↦ u_pq(x₀) · u_qr(x₁) · u_pr(x₂ - x₀x₁)` of
`Uminus t = Uij hpq ⊔ Uij hpr ⊔ Uij hqr` for `t p < t q < t r`.  Its matrix has entries
`x₀, x₁, x₂` at `(p,q), (q,r), (p,r)` (`toMat_uparShape`). -/
def uminusChart3 (p q r : Fin 3) (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r) :
    (Fin 3 → ℝ) → SL3 :=
  fun x => uparShape hpr hpq hqr (x 2 - x 0 * x 1) (x 0) (x 1)

/-- The group law of the three coordinates: the entries of the product of
`1 + x₀E_pq + x₁E_qr + x₂E_pr` with `1 + y₀E_pq + y₁E_qr + y₂E_pr`. -/
def uminusOp3 (x y : Fin 3 → ℝ) : Fin 3 → ℝ :=
  ![x 0 + y 0, x 1 + y 1, x 2 + y 2 + x 0 * y 1]

/-- The diagonal action of conjugation by `aDiag (-t)` on the coordinates `(x₀,x₁,x₂)`, i.e.
`exp (t j - t i)` on the entry `(i,j)`. -/
def uminusLam3 (t : Fin 3 → ℝ) (p q r : Fin 3) : Fin 3 → ℝ :=
  ![Real.exp (t q - t p), Real.exp (t r - t q), Real.exp (t r - t p)]

/-! ## The order type `t p < t q = t r` (same source) -/

/-- The chart `(x₀,x₁) ↦ u_pq(x₀) · u_pr(x₁)` of `Uminus t = Uij hpq ⊔ Uij hpr` for
`t p < t q = t r`; the `(p,q)`- and `(p,r)`-entries of the matrix are `x₀` and `x₁`. -/
def uminusChartSS (p q r : Fin 3) (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r) :
    (Fin 2 → ℝ) → SL3 :=
  fun x => uparShape hpr hpq hqr (x 1) (x 0) 0

/-- The diagonal action of conjugation by `aDiag (-t)` on the two coordinates
`(x₀,x₁) = (entry (p,q), entry (p,r))`. -/
def uminusLamSS (t : Fin 3 → ℝ) (p q r : Fin 3) : Fin 2 → ℝ :=
  ![Real.exp (t q - t p), Real.exp (t r - t p)]

/-! ## The order type `t p = t q < t r` (same target) -/

/-- The chart `(x₀,x₁) ↦ u_pr(x₀) · u_qr(x₁)` of `Uminus t = Uij hpr ⊔ Uij hqr` for
`t p = t q < t r`; the `(p,r)`- and `(q,r)`-entries of the matrix are `x₀` and `x₁`. -/
def uminusChartST (p q r : Fin 3) (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r) :
    (Fin 2 → ℝ) → SL3 :=
  fun x => uparShape hpr hpq hqr (x 0) 0 (x 1)

/-- The diagonal action of conjugation by `aDiag (-t)` on the two coordinates
`(x₀,x₁) = (entry (p,r), entry (q,r))`. -/
def uminusLamST (t : Fin 3 → ℝ) (p q r : Fin 3) : Fin 2 → ℝ :=
  ![Real.exp (t r - t p), Real.exp (t r - t q)]

end

end Work.EKLC6Core
