import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLContract.All

/-!
# `Uminus t = G⁻(t)` is an admissible (horospherical) subgroup

`Work.EKLC6Core.Uminus t = ⨆_{t i < t j} U_ij` is the subgroup of `SL₃(ℝ)` generated by the root
groups *contracted* by `aDiag t` — the stable horospherical subgroup `G⁻(t)` of Pisa §7 / EKL §2.

The frozen contract `Work.EKLContract.IsHoro U` asks that `U` be **closed**, **normalised** by the
diagonal group `A = {aDiag t}` and **contracted** by *some* `aDiag t'`.  Here we prove the sharp
form: `Uminus t` is closed, normalised by `A`, and contracted by `aDiag t` itself:

  `∀ u ∈ Uminus t, aDiag t ^ n · u · (aDiag t ^ n)⁻¹ → 1`.

## Strategy

The set of contracted pairs `{(i,j) : t i < t j}` is the strict part of the total preorder
induced by `t` on `Fin 3`; in particular it is *transitive*, and it is one of exactly four
shapes, according to the sorted order `t p ≤ t q ≤ t r` of the three values of `t`:

* `t p < t q < t r`          → `Uminus t = U_ij ⊔ U_ik ⊔ U_jk` (`Upar`, the `U_(ab)` of EKL §4);
* `t p < t q = t r`          → `Uminus t = U_ij ⊔ U_ik` (same *source* `i = p`);
* `t p = t q < t r`          → `Uminus t = U_ik ⊔ U_jk` (same *target* `k = r`);
* `t p = t q = t r`          → `Uminus t = ⊥`.

Each shape is handled by the corresponding theorem already proved by the fleet
(`Work.EKLContract.Lemmas.isHoro_Upar`, `isHoro_sup_same_source`, `isHoro_sup_same_target`,
`Work.EKLContract.isHoro_bot`).  The single combinatorial input, isolated in
`pair_of_lt_sorted`, is that any pair `(i,j)` with `t i < t j` is one of `(p,q)`, `(p,r)`,
`(q,r)` — it is *uniform* in the four shapes, which is what keeps the case analysis short.

Contraction is proved without any case analysis: the set
`{u : aDiag t ^ n · u · (aDiag t ^ n)⁻¹ → 1}` is a subgroup of `SL₃(ℝ)` (closure under
multiplication and inversion is continuity of the group operations), it contains every
contracted root group `U_ij`, hence contains `Uminus t`.
-/

open MeasureTheory Filter Topology
open scoped ENNReal
open LeanEval.Dynamics.EinsiedlerKatokLindenstrauss

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {t : Fin 3 → ℝ}

/-! ## Combinatorics of the ordering induced by `t` -/

/-- The values of `t` admit a sorted enumeration of the three indices. -/
theorem exists_sorted (t : Fin 3 → ℝ) :
    ∃ p q r : Fin 3, p ≠ q ∧ p ≠ r ∧ q ≠ r ∧ t p ≤ t q ∧ t q ≤ t r := by
  rcases le_total (t 0) (t 1) with h01 | h01
  · rcases le_total (t 1) (t 2) with h12 | h12
    · exact ⟨0, 1, 2, by decide, by decide, by decide, h01, h12⟩
    · rcases le_total (t 0) (t 2) with h02 | h02
      · exact ⟨0, 2, 1, by decide, by decide, by decide, h02, h12⟩
      · exact ⟨2, 0, 1, by decide, by decide, by decide, h02, h01⟩
  · rcases le_total (t 1) (t 2) with h12 | h12
    · rcases le_total (t 0) (t 2) with h02 | h02
      · exact ⟨1, 0, 2, by decide, by decide, by decide, h01, h02⟩
      · exact ⟨1, 2, 0, by decide, by decide, by decide, h12, h02⟩
    · exact ⟨2, 1, 0, by decide, by decide, by decide, h12, h01⟩

/-- `U_ij` depends on the indices `i`, `j` only through their values (the proof of `i ≠ j` is
irrelevant).  This is what lets a combinatorial statement about indices be transported to the
root subgroups. -/
theorem Uij_congr {i j i' j' : Fin 3} (hi : i = i') (hj : j = j') (h : i ≠ j) (h' : i' ≠ j') :
    Uij h = Uij h' := by
  cases hi; cases hj
  exact congrArg Uij (Subsingleton.elim h h')

/-- **The only combinatorial input.**  With the sorted enumeration `t p ≤ t q ≤ t r`, every pair
`(i,j)` with `t i < t j` is one of the three increasing pairs `(p,q)`, `(p,r)`, `(q,r)`.  In
other words the contracted relation is contained in the "increasing" relation of the sorted
order — independent of which of the four order types `t` realises. -/
theorem pair_of_lt_sorted {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h1 : t p ≤ t q) (h2 : t q ≤ t r) {i j : Fin 3} (hlt : t i < t j) :
    (i = p ∧ (j = q ∨ j = r)) ∨ (i = q ∧ j = r) := by
  have hcover : ∀ k : Fin 3, k = p ∨ k = q ∨ k = r :=
    Work.EKLContract.Lemmas.fin3_cover hpq hpr hqr.symm
  have hmax : ∀ k : Fin 3, t k ≤ t r := by
    intro k
    rcases hcover k with h | h | h
    · rw [h]; linarith
    · rw [h]; linarith
    · rw [h]
  have hiv : i = p ∨ i = q := by
    rcases hcover i with hi | hi | hi
    · exact Or.inl hi
    · exact Or.inr hi
    · rw [hi] at hlt
      have := hmax j
      linarith
  rcases hiv with hi | hi
  · refine Or.inl ⟨hi, ?_⟩
    rw [hi] at hlt
    rcases hcover j with hj | hj | hj
    · rw [hj] at hlt; linarith
    · exact Or.inl hj
    · exact Or.inr hj
  · refine Or.inr ⟨hi, ?_⟩
    rw [hi] at hlt
    rcases hcover j with hj | hj | hj
    · rw [hj] at hlt; linarith
    · rw [hj] at hlt; linarith
    · exact hj

/-! ## Membership in `Uminus t` -/

/-- A contracted root element lies in `Uminus t`. -/
theorem mem_uminus_of_uij (t : Fin 3 → ℝ) {i j : Fin 3} (hij : i ≠ j) (hlt : t i < t j)
    (s : ℝ) : uij hij s ∈ Uminus t := by
  rw [Uminus]
  refine le_iSup (fun i : Fin 3 => ⨆ (j : Fin 3) (hij : i ≠ j) (hlt : t i < t j), Uij hij) i ?_
  refine le_iSup (fun j : Fin 3 => ⨆ (hij : i ≠ j) (hlt : t i < t j), Uij hij) j ?_
  refine le_iSup (fun hij' : i ≠ j => ⨆ (hlt : t i < t j), Uij hij') hij ?_
  refine le_iSup (fun _hlt : t i < t j => Uij hij) hlt ?_
  exact Subgroup.subset_closure ⟨s, rfl⟩

/-- A contracted root group is contained in `Uminus t`. -/
theorem Uij_le_uminus (t : Fin 3 → ℝ) {i j : Fin 3} (hij : i ≠ j) (hlt : t i < t j) :
    Uij hij ≤ Uminus t := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro x ⟨s, rfl⟩
  exact mem_uminus_of_uij t hij hlt s

/-! ## `Uminus t` in each of the four order types -/

/-- `t p < t q < t r`: `Uminus t` is the full `U_(ab)`-type subgroup, generated by the three
increasing root groups. -/
theorem uminus_eq_three {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h1 : t p < t q) (h2 : t q < t r) :
    Uminus t = Uij hpq ⊔ Uij hpr ⊔ Uij hqr := by
  refine le_antisymm ?_ ?_
  · rw [Uminus]
    refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => iSup_le fun hlt => ?_
    rcases pair_of_lt_sorted hpq hqr hpr (le_of_lt h1) (le_of_lt h2) hlt with
      ⟨hi, hj⟩ | ⟨hi, hj⟩
    · rcases hj with hj | hj
      · rw [Uij_congr hi hj hij hpq]; exact le_trans le_sup_left le_sup_left
      · rw [Uij_congr hi hj hij hpr]; exact le_trans le_sup_right le_sup_left
    · rw [Uij_congr hi hj hij hqr]; exact le_sup_right
  · refine sup_le (sup_le ?_ ?_) ?_
    · exact Uij_le_uminus t hpq h1
    · exact Uij_le_uminus t hpr (by linarith)
    · exact Uij_le_uminus t hqr h2

/-- `t p < t q = t r`: the two contracted root groups share their *source* `p`. -/
theorem uminus_eq_same_source {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h1 : t p < t q) (h2 : t q = t r) :
    Uminus t = Uij hpq ⊔ Uij hpr := by
  refine le_antisymm ?_ ?_
  · rw [Uminus]
    refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => iSup_le fun hlt => ?_
    rcases pair_of_lt_sorted hpq hqr hpr (le_of_lt h1) (le_of_eq h2) hlt with
      ⟨hi, hj⟩ | ⟨hi, hj⟩
    · rcases hj with hj | hj
      · rw [Uij_congr hi hj hij hpq]; exact le_sup_left
      · rw [Uij_congr hi hj hij hpr]; exact le_sup_right
    · rw [hi, hj] at hlt; linarith
  · exact sup_le (Uij_le_uminus t hpq h1) (Uij_le_uminus t hpr (by rw [← h2]; exact h1))

/-- `t p = t q < t r`: the two contracted root groups share their *target* `r`. -/
theorem uminus_eq_same_target {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h1 : t p = t q) (h2 : t q < t r) :
    Uminus t = Uij hpr ⊔ Uij hqr := by
  refine le_antisymm ?_ ?_
  · rw [Uminus]
    refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => iSup_le fun hlt => ?_
    rcases pair_of_lt_sorted hpq hqr hpr (le_of_eq h1) (le_of_lt h2) hlt with
      ⟨hi, hj⟩ | ⟨hi, hj⟩
    · rcases hj with hj | hj
      · rw [hi, hj] at hlt; linarith
      · rw [Uij_congr hi hj hij hpr]; exact le_sup_left
    · rw [Uij_congr hi hj hij hqr]; exact le_sup_right
  · exact sup_le (Uij_le_uminus t hpr (by rw [h1]; exact h2)) (Uij_le_uminus t hqr h2)

/-- `t p = t q = t r`: no root group is contracted and `Uminus t` is trivial. -/
theorem uminus_eq_bot {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (h1 : t p = t q) (h2 : t q = t r) :
    Uminus t = ⊥ := by
  refine le_antisymm ?_ bot_le
  rw [Uminus]
  refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => iSup_le fun hlt => ?_
  rcases pair_of_lt_sorted hpq hqr hpr (le_of_eq h1) (le_of_eq h2) hlt with
    ⟨hi, hj⟩ | ⟨hi, hj⟩
  · rcases hj with hj | hj
    · rw [hi, hj] at hlt; linarith
    · rw [hi, hj] at hlt; linarith
  · rw [hi, hj] at hlt; linarith

/-! ## Contraction along the whole of `Uminus t` -/

/-- **Contraction.**  Every element of `Uminus t` is contracted to `1` by the flow `aDiag t`:
the contraction condition is closed under multiplication and inversion (the group operations of
`SL₃(ℝ)` are continuous), so the set of such elements is a subgroup, and it contains every
contracted root group `U_ij`, hence `Uminus t`. -/
theorem tendsto_conj_mem_uminus (t : Fin 3 → ℝ) :
    ∀ u ∈ Uminus t,
      Tendsto (fun n : ℕ => aDiag t ^ n * u * (aDiag t ^ n)⁻¹) atTop (𝓝 1) := by
  let S : Subgroup SL3 :=
    { carrier := {x | Tendsto (fun n : ℕ => aDiag t ^ n * x * (aDiag t ^ n)⁻¹) atTop (𝓝 1)}
      one_mem' := by
        show Tendsto (fun n : ℕ => aDiag t ^ n * (1 : SL3) * (aDiag t ^ n)⁻¹) atTop (𝓝 1)
        simpa only [mul_one, mul_inv_cancel] using (tendsto_const_nhds (x := (1 : SL3)))
      mul_mem' := by
        intro x y hx hy
        simp only [Set.mem_ofPred_eq] at hx hy ⊢
        have h := hx.mul hy
        simp only [mul_one] at h
        exact h.congr' (Eventually.of_forall fun n => by group)
      inv_mem' := by
        intro x hx
        simp only [Set.mem_ofPred_eq] at hx ⊢
        have h := hx.inv
        simp only [inv_one] at h
        exact h.congr' (Eventually.of_forall fun n => by group) }
  have hle : Uminus t ≤ S := by
    rw [Uminus]
    refine iSup_le fun i => iSup_le fun j => iSup_le fun hij => iSup_le fun hlt => ?_
    refine (Subgroup.closure_le S).mpr ?_
    rintro x ⟨s, rfl⟩
    exact Work.EKLContract.Lemmas.horoUij_tendsto_conj t hij hlt s
  intro u hu
  exact hle hu

/-! ## The target -/

theorem uminus_isHoro (t : Fin 3 → ℝ) :
    Work.EKLContract.IsHoro (Work.EKLC6Core.Uminus t) ∧
    (∀ u ∈ Work.EKLC6Core.Uminus t,
      Filter.Tendsto
        (fun n : ℕ => Work.EKLContract.aDiag t ^ n * u * (Work.EKLContract.aDiag t ^ n)⁻¹)
        Filter.atTop (nhds 1)) := by
  obtain ⟨p, q, r, hpq, hpr, hqr, h1, h2⟩ := exists_sorted t
  refine ⟨?_, tendsto_conj_mem_uminus t⟩
  rcases lt_or_eq_of_le h1 with h1' | h1'
  · rcases lt_or_eq_of_le h2 with h2' | h2'
    · rw [uminus_eq_three hpq hqr hpr h1' h2']
      have hUp : IsHoro (Uij hpr ⊔ Uij hpq ⊔ Uij hqr) :=
        Work.EKLContract.Lemmas.isHoro_Upar hpr hpq hqr
      rw [sup_comm (Uij hpr) (Uij hpq)] at hUp
      exact hUp
    · rw [uminus_eq_same_source hpq hqr hpr h1' h2']
      exact Work.EKLContract.Lemmas.isHoro_sup_same_source hpq hpr
  · rcases lt_or_eq_of_le h2 with h2' | h2'
    · rw [uminus_eq_same_target hpq hqr hpr h1' h2']
      exact Work.EKLContract.Lemmas.isHoro_sup_same_target hpr hqr
    · rw [uminus_eq_bot hpq hqr hpr h1' h2']
      exact Work.EKLContract.isHoro_bot

end Work.EKLC6Core
