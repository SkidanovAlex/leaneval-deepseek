import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLC6Core.CellSysDefs
import Submission.Work.EKLContract.Interfaces

/-!
# `Work.EKLC6Core.PlaqueCellDefs` — the raw cell family and its packaged facts

The definitions used by the conull plaque family: a raw countable family of small disjoint open
cells with injective centres (`CellBase`), its packaged `σ`-algebraic content (`CellFacts`: the
atoms inside a cell stay in the `U`-orbit, the shapes are traces of open sets and are bounded),
and the *margin* (`Margin`), the analytic input that replaces the (in general unavailable)
thin-boundary Borel--Cantelli argument.  Kept in a separate module so that the lemma files about
these structures can be imported by `Work.EKLC6Core.exists_plaque_family_conull` without a build
cycle.
-/

open MeasureTheory Filter Topology
open scoped ENNReal Pointwise

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## A cell family without thinness, and the margin input

The `CellSys` of `CellSysDefs` carries two fields that are not needed for the conull plaque
family: the unused goodness field `hgood` (the margin `ae_margin_cellsys` derives the local
`U`-equivariance of the canonical lift from `hinj` alone) and the thin-boundary field `hthin`.
The latter is *not* available in general: a verified sibling lemma
(`Work.EKLC6Core.cellSys_thin_mass_decay`) shows that any `CellSys` forces the mass of the set on
which `V δ` acts non-freely to decay polynomially in `δ`, and a weighted union of closed geodesics
(`t = (-1,1,0)`, hyperbolic elements of `SL₂(ℤ)` of trace `2R_n`, `R_n = 2^{2^n}`) is an
`aDiag t`-invariant probability whose non-free mass decays only like `1 / log (1/δ)`.

So we work with the cell family alone (`CellBase`), and take the *margin* — the statement that the
orbit points are far enough inside their cells for the `U`-perturbations to stay in place — as an
input.  The σ-algebra content (the atoms of `MSig2` inside a cell are `U`-orbit pieces, the shapes
are traces of open sets and are bounded) is proved for the same raw data in the workspace
(`Work.EKLC6Core.atom_MSig`, `shape_MSig*` above, `shape_MSig_uball`). -/

/-- The clipped cylinder generator of a raw cell family. -/
def genC2 (U : Subgroup SL3) (Q : ℕ → Set X3) (δ : ℕ → ℝ) (g : ℕ → SL3)
    (O : ℕ → Set SL3) (k m : ℕ) : Set X3 :=
  mkX '' (satU U (O m) ∩ lifted (δ k) (g k)) ∩ Q k

/-- The σ-algebra generated by the cells and the clipped cylinders. -/
def MSig2 (U : Subgroup SL3) (Q : ℕ → Set X3) (δ : ℕ → ℝ) (g : ℕ → SL3)
    (O : ℕ → Set SL3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom
    (Set.range Q ∪ Set.range (fun p : ℕ × ℕ => genC2 U Q δ g O p.1 p.2))

/-- **A raw cell family.**  Countably many pairwise disjoint small open cells covering a `μ`-conull
set, each lying in a `V (δ k / 2)`-ball about a centre `mkX (g k)` on which the orbit map
`v ↦ v • mkX (g k)` is injective on `V (4 δ k)`.  (The `CellSys` of `CellSysDefs` with the unused
`hgood` field and the unsatisfiable-in-general thin-boundary field removed.)

## How to construct one

`X₃` is *not* compact (there is a cusp), so no single scale works: the injectivity radius
`inj x := sup {r | mkX is injective on V r • x}` tends to `0` in the cusp.  But every point has
`inj x > 0` (a discrete lattice has isolated identity, cf. the proof of
`Work.EKLC6Core.badPt_measure_small_aux`).  Fix a scale `ρ > 0` and put
`Good ρ := {x | inj x ≥ 60 ρ}`.  A point of `Good ρ` is a legitimate centre at radius `ρ`
(injectivity at `4ρ`), so the balls `(V (ρ/2)) • x`, `x ∈ Good ρ`, cover `Good ρ`.  `Good ρ` is
closed and bounded, hence compact, and `X₃` is second countable, so countably many such balls
cover `Good ρ` (e.g. take `D` a countable dense set and the centres `D ∩ Good (2ρ)`, using the
openness of `{inj > 0}`).  Since `⋃_{ρ = 2^{-n}} Good (2^{-n}) = X₃`, the union of the cells over
all scales covers a conull set.  Disjointness and openness: enumerate the whole countable family
and subtract from the `k`-th cell the *closures* of the earlier ones; the lost set is the union of
the frontiers, which is `μ`-null *provided* each cell has a thin frontier — which is exactly what
the (proved) `Work.EKLC6Core.cut_cells` / `Work.EKLC6Core.adapted_partition` machinery provides at
each fixed scale, e.g. by iterating `Work.EKLC6Core.adapted_partition μ ε` (which returns
pairwise disjoint open cells inside `V ρ`-balls, with centres of injectivity `60 ρ`, with
`μ (⋃ frontier)`-collars of measure `≤ c η` for every `η > 0`, hence a null union of frontiers,
and covering all but `ε` of the mass) over the sequence `ε = 2^{-n}` and subtracting the closures
of the previous stages.  No decay rate of `μ` is needed, and `hmp`, `t`, `U` play no role. -/
structure CellBase (μ : MeasureTheory.Measure X3) (U : Subgroup SL3) where
  /-- the cells -/
  Q : ℕ → Set X3
  hopen : ∀ k, IsOpen (Q k)
  hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l)
  hcover : μ ((⋃ k, Q k))ᶜ = 0
  /-- the radii -/
  δ : ℕ → ℝ
  hδpos : ∀ k, 0 < δ k
  hδsmall : ∀ k, δ k ≤ 1 / 16
  /-- the centres, as lifts -/
  g : ℕ → SL3
  hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (δ k / 2))
  /-- injectivity of the orbit map on `V (4 δ k)` -/
  hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * δ k) → v₂ ∈ V (4 * δ k) →
    v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂

/-- **The packaged σ-algebraic and analytic content of a raw cell family.**  The atoms of `MSig2`
inside a cell stay in the `U`-orbit, the shapes are traces of open sets and are entrywise
bounded, and along almost every orbit the `U`-perturbations of size `c (1/2)^n` at time `n` stay
inside the atom (the *margin*). -/
structure CellFacts {μ : MeasureTheory.Measure X3} {U : Subgroup SL3} (t : Fin 3 → ℝ)
    (S : CellBase μ U) where
  /-- a countable family of open sets of `SL₃(ℝ)` separating the left `U`-cosets -/
  O : ℕ → Set SL3
  hOopen : ∀ m, IsOpen (O m)
  hOsep : ∀ g g' : SL3, (∀ m, (∃ u ∈ U, u * g ∈ O m) ↔ (∃ u ∈ U, u * g' ∈ O m)) →
    ∃ u ∈ U, g' = u * g
  hmeas : ∀ k m, MeasurableSet (genC2 U S.Q S.δ S.g O k m)
  /-- the shapes of the `MSig2`-atoms inside a cell are traces of open sets, at the *free* points
  (the non-free points carry the whole `U`-stabilizer in their shape, so no boundedness statement
  can hold there; the free set is conull, `Work.EKLC6Core.ae_free_orbit_of_contraction`) -/
  hshape_open : ∀ k (y : X3), y ∈ S.Q k → (∀ u ∈ U, u • y = y → u = 1) →
    ∃ W : Set SL3, IsOpen W ∧
      shape (MSig2 U S.Q S.δ S.g O) U y = W ∩ (U : Set SL3)
  /-- the shapes are entrywise bounded at the free points -/
  hshape_bdd : ∀ k (y : X3), y ∈ S.Q k → (∀ u ∈ U, u • y = y → u = 1) → ∃ C : ℝ,
    ∀ u ∈ shape (MSig2 U S.Q S.δ S.g O) U y, ∀ i j, |u i j| ≤ C
  /-- the atoms inside a cell stay in the `U`-orbit -/
  hatom_orb : ∀ k (y : X3), y ∈ S.Q k →
    atom (MSig2 U S.Q S.δ S.g O) y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3)
/-- **The margin** at rate `ρ`: along almost every orbit, the `U`-perturbations of size `c ρ ^ n`
at time `n` keep the orbit point inside its `MSig2`-atom.  This is the analytic input replacing
the (in general unavailable) thin-boundary Borel--Cantelli argument. -/
def Margin {μ : MeasureTheory.Measure X3} {U : Subgroup SL3} (t : Fin 3 → ℝ)
    (S : CellBase μ U) (F : CellFacts t S) (ρ : ℝ) : Prop :=
  ∀ᵐ x ∂μ, ∃ (N : ℕ) (c : ℝ), 0 < c ∧ ∀ n : ℕ, N ≤ n → ∀ u ∈ U,
    u ∈ V (c * ρ ^ n) → u • ((fun y : X3 => aDiag t • y)^[n]) x ∈
      atom (MSig2 U S.Q S.δ S.g F.O) (((fun y : X3 => aDiag t • y)^[n]) x)



/-- The displacement neighbourhoods are open. -/
theorem isOpen_V' (r : ℝ) : IsOpen (V r) := by
  have h : V r = ⋂ i : Fin 3, ⋂ j : Fin 3,
      {g : SL3 | |(g : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < r} := by
    ext g; simp [V]
  rw [h]
  exact isOpen_iInter_of_finite fun i => isOpen_iInter_of_finite fun j =>
    isOpen_lt (by fun_prop) continuous_const

/-- The lifted ball is open. -/
theorem isOpen_lifted' (δ : ℝ) (g : SL3) : IsOpen (lifted δ g) := by
  have h : lifted δ g = (fun v : SL3 => v * g) '' (V δ) := rfl
  rw [h]
  exact (Homeomorph.mulRight g).isOpenMap (V δ) (isOpen_V' δ)

/-- The action of `SL₃(ℝ)` on `X₃` is the quotient of the left regular action. -/
theorem smul_mkX_eq (g h : SL3) : g • mkX h = mkX (g * h) := rfl

/-- Entrywise bounds multiply. -/
theorem mul_entries_le {A B : Matrix (Fin 3) (Fin 3) ℝ} (i j : Fin 3) {sA sB : ℝ}
    (hA : ∀ k l, |A k l| ≤ sA) (hB : ∀ k l, |B k l| ≤ sB) (hsA : 0 ≤ sA) (hsB : 0 ≤ sB) :
    |(A * B) i j| ≤ 3 * sA * sB := by
  rw [Matrix.mul_apply]
  calc |∑ k : Fin 3, A i k * B k j| ≤ ∑ k : Fin 3, |A i k * B k j| :=
        Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |A i k| * |B k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, sA * sB :=
        Finset.sum_le_sum (fun k _ => mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hsA)
    _ = 3 * (sA * sB) := by simp [Finset.sum_const, Fintype.card_fin]
    _ = 3 * sA * sB := by ring

/-- Entries of elements of a `V`-ball are bounded by `1 + δ`. -/
theorem entries_V_bound {δ : ℝ} (hδ : 0 < δ) {v : SL3} (hv : v ∈ V δ) (i j : Fin 3) :
    |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 + δ := by
  have h : |(v : Matrix (Fin 3) (Fin 3) ℝ) i j
      - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < δ := hv i j
  have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
    rw [Matrix.one_apply]; split <;> simp
  calc |(v : Matrix (Fin 3) (Fin 3) ℝ) i j|
      = |((v : Matrix (Fin 3) (Fin 3) ℝ) i j
          - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by ring_nf
    _ ≤ |(v : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
        + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
    _ ≤ δ + 1 := add_le_add (le_of_lt h) h2
    _ = 1 + δ := by ring

/-- The elements of a lifted ball have bounded entries. -/
theorem exists_entries_bound_lifted (δ : ℝ) (hδ : 0 < δ) (g : SL3) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ w ∈ lifted δ g, ∀ i j, |(w : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ M := by
  refine ⟨3 * (1 + δ) * ((∑ i : Fin 3, ∑ j : Fin 3,
      |(g : Matrix (Fin 3) (Fin 3) ℝ) i j|) + 1), by positivity, ?_⟩
  intro w hw i j
  obtain ⟨v, hv, rfl⟩ := hw
  refine mul_entries_le i j (fun k l => entries_V_bound hδ hv k l)
    (fun k l => ?_) (by linarith) (by positivity)
  have h1 : |(g : Matrix (Fin 3) (Fin 3) ℝ) k l|
      ≤ ∑ j : Fin 3, |(g : Matrix (Fin 3) (Fin 3) ℝ) k j| :=
    Finset.single_le_sum (s := Finset.univ) (f := fun j => |(g : Matrix (Fin 3) (Fin 3) ℝ) k j|)
      (fun j _ => abs_nonneg _) (Finset.mem_univ l)
  have h2 : (∑ j : Fin 3, |(g : Matrix (Fin 3) (Fin 3) ℝ) k j|)
      ≤ ∑ i : Fin 3, ∑ j : Fin 3, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j| :=
    Finset.single_le_sum (s := Finset.univ)
      (f := fun i => ∑ j : Fin 3, |(g : Matrix (Fin 3) (Fin 3) ℝ) i j|)
      (fun i _ => Finset.sum_nonneg fun j _ => abs_nonneg _) (Finset.mem_univ k)
  linarith

/-- The entries of the inverse of a matrix are bounded. -/
theorem exists_entries_bound_inv (a : SL3) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ i j, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ M :=
  ⟨(∑ i : Fin 3, ∑ j : Fin 3, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|) + 1,
    by positivity, fun i j => by
      have h1 : |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
          ≤ ∑ j' : Fin 3, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j'| :=
        Finset.single_le_sum
          (f := fun j' => |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j'|)
          (fun j' _ => abs_nonneg _) (Finset.mem_univ j)
      have h2 : (∑ j' : Fin 3, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j'|)
          ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i' j'| :=
        Finset.single_le_sum
          (f := fun i' => ∑ j' : Fin 3, |((a⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i' j'|)
          (fun i' _ => Finset.sum_nonneg fun j' _ => abs_nonneg _) (Finset.mem_univ i)
      linarith⟩


end Work.EKLC6Core
