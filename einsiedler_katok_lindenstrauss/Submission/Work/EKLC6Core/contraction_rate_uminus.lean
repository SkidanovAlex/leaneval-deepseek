import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLC6Core.box_iInter_conjBox
import Submission.Work.EKLC6Core.uminus_isHoro

/-!
# `EKLC6Core.contraction_rate_uminus` — uniform contraction rate on `Uminus t`

`Uminus t = ⨆_{t i < t j} U_ij` is the subgroup of `SL₃(ℝ)` generated by the root groups
contracted by the diagonal flow `aDiag t` (the stable horospherical subgroup `G⁻(t)`).  This
module gives the *quantitative* form of the contraction: there is a single rate `α > 0` so that
every `u ∈ Uminus t` which is `ρ`-close to the identity (i.e. `u ∈ V ρ`) is pushed by
`aDiag t ^ n` into the `e^{-α n} ρ`-neighbourhood of the identity:

`aDiag t ^ n · u · (aDiag t ^ n)⁻¹ ∈ V (e^{-α n} ρ)`.

## Proof

`aDiag s` is diagonal, so conjugation scales the `(i,j)`-entry by `e^{s i - s j}`
(`boxi_conj_pow_apply`).  Two facts about the entries of `u ∈ Uminus t` are extracted from the
qualitative contraction `tendsto_conj_mem_uminus` (the `(i,j)`-entry of the conjugate tends to
`δᵢⱼ`):

* `uᵢᵢ = 1` (the diagonal entries are fixed by conjugation);
* `uᵢⱼ = 0` whenever `t j ≤ t i` (`i ≠ j`): if `t i > t j` the exponential factor grows without
  bound, and if `t i = t j` it is constant, so the limit `0` forces the entry to vanish.

Thus for `u ∈ V ρ` every non-vanishing off-diagonal entry sits at a pair with `t i < t j`, where
the conjugation factor `e^{n (t i - t j)} ≤ e^{-α n}` for `α = min{t j - t i : t i < t j} > 0`
(any positive lower bound on the finitely many positive gaps); the diagonal entries are exactly
`1`.  Hence every entry of the conjugate is within `e^{-α n} ρ` of `δᵢⱼ`.
-/

open Filter Topology
open LeanEval.Dynamics.EinsiedlerKatokLindenstrauss

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## The set of "contraction gaps" -/

/-- The finset of contraction gaps `t j - t i` over the pairs `(i,j)` with `t i < t j`, together
with a forced element `1` (so that the finset is nonempty and its minimum is positive even when
there are no contracted pairs at all — the case `Uminus t = ⊥`). -/
def gapSet (t : Fin 3 → ℝ) : Finset ℝ :=
  insert 1 (((Finset.univ : Finset (Fin 3 × Fin 3)).filter
    (fun p => p.1 ≠ p.2 ∧ t p.1 < t p.2)).image (fun p => t p.2 - t p.1))

theorem gapSet_nonempty (t : Fin 3 → ℝ) : (gapSet t).Nonempty :=
  ⟨1, Finset.mem_insert_self 1 _⟩

theorem gapSet_pos (t : Fin 3 → ℝ) {x : ℝ} (hx : x ∈ gapSet t) : 0 < x := by
  rw [gapSet, Finset.mem_insert] at hx
  rcases hx with hx | hx
  · rw [hx]; norm_num
  · rw [Finset.mem_image] at hx
    obtain ⟨p, hp, rfl⟩ := hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hp
    obtain ⟨hne, hlt⟩ := hp
    linarith

theorem gapSet_min_le (t : Fin 3 → ℝ) {i j : Fin 3} (hij : i ≠ j) (hlt : t i < t j) :
    (gapSet t).min' (gapSet_nonempty t) ≤ t j - t i := by
  refine Finset.min'_le _ _ ?_
  rw [gapSet, Finset.mem_insert]
  right
  rw [Finset.mem_image]
  refine ⟨(i, j), ?_, rfl⟩
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨hij, hlt⟩

/-! ## The entry facts for `u ∈ Uminus t` -/

/-- The diagonal entries of an element of `Uminus t` are `1`, and its `(i,j)`-entry vanishes
whenever `t j ≤ t i` (`i ≠ j`).  Both are read off from the qualitative contraction
`aDiag t ^ n · u · (aDiag t ^ n)⁻¹ → 1` via the entrywise formula `boxi_conj_pow_apply`. -/
theorem uminus_entry_facts (t : Fin 3 → ℝ) {u : SL3} (hu : u ∈ Uminus t) :
    (∀ i : Fin 3, u i i = 1) ∧ (∀ i j : Fin 3, i ≠ j → t j ≤ t i → u i j = 0) := by
  have hcontr := tendsto_conj_mem_uminus t
  have hlim : ∀ i j : Fin 3,
      Tendsto (fun n : ℕ => Real.exp ((n:ℝ) * (t i - t j)) * u i j) atTop
        (nhds ((1 : SL3) i j)) := by
    intro i j
    have hc : Continuous (fun x : SL3 => x i j) := by fun_prop
    have h1 : Tendsto (fun n : ℕ => (aDiag t ^ n * u * (aDiag t ^ n)⁻¹ : SL3) i j) atTop
        (nhds (((1 : SL3)) i j)) := (hc.tendsto 1).comp (hcontr u hu)
    simpa [boxi_conj_pow_apply] using h1
  refine ⟨?_, ?_⟩
  · intro i
    have h := hlim i i
    have hconst : (fun n : ℕ => Real.exp ((n:ℝ) * (t i - t i)) * u i i) = fun _ => u i i := by
      funext n; rw [sub_self, mul_zero, Real.exp_zero, one_mul]
    rw [hconst, show ((1:SL3) i i) = 1 from Matrix.one_apply_eq i] at h
    exact tendsto_nhds_unique tendsto_const_nhds h
  · intro i j hij hle
    have h := hlim i j
    rcases lt_or_eq_of_le hle with hlt | heq
    · rw [show ((1:SL3) i j) = 0 from Matrix.one_apply_ne hij] at h
      exact boxi_eq_zero_of_tendsto_exp_mul (c := t i - t j) (by linarith) h
    · have hconst : (fun n : ℕ => Real.exp ((n:ℝ) * (t i - t j)) * u i j) = fun _ => u i j := by
        funext n; rw [← heq, sub_self, mul_zero, Real.exp_zero, one_mul]
      rw [hconst, show ((1:SL3) i j) = 0 from Matrix.one_apply_ne hij] at h
      exact tendsto_nhds_unique tendsto_const_nhds h

/-! ## The contraction rate -/

theorem contraction_rate_uminus (t : Fin 3 → ℝ) :
    ∃ α : ℝ, 0 < α ∧
      ∀ (n : ℕ) (ρ : ℝ), 0 < ρ → ∀ u ∈ Work.EKLC6Core.Uminus t,
        u ∈ Work.EKLContract.V ρ →
          Work.EKLContract.aDiag t ^ n * u * (Work.EKLContract.aDiag t ^ n)⁻¹ ∈
            Work.EKLContract.V (Real.exp (-(α * (n : ℝ))) * ρ) := by
  refine ⟨(gapSet t).min' (gapSet_nonempty t), ?_, ?_⟩
  · exact gapSet_pos t (Finset.min'_mem _ _)
  · intro n ρ hρ u hu huV
    obtain ⟨hdiag, hzero⟩ := uminus_entry_facts t hu
    intro i j
    rw [boxi_conj_pow_apply]
    by_cases hij : i = j
    · subst hij
      rw [hdiag i, mul_one, Matrix.one_apply_eq]
      simp only [sub_self, mul_zero, Real.exp_zero, sub_self, abs_zero]
      exact mul_pos (Real.exp_pos _) hρ
    · rw [show (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = 0 from Matrix.one_apply_ne hij]
      rw [sub_zero]
      by_cases hlt : t i < t j
      · rw [abs_mul, abs_of_pos (Real.exp_pos _)]
        have huij : |u i j| < ρ := by
          have hv := huV i j
          rw [show ((1:Matrix (Fin 3) (Fin 3) ℝ) i j) = 0 from Matrix.one_apply_ne hij] at hv
          simpa using hv
        have hb : Real.exp ((n:ℝ) * (t i - t j)) ≤
            Real.exp (-((gapSet t).min' (gapSet_nonempty t) * (n:ℝ))) := by
          rw [Real.exp_le_exp]
          have hα := gapSet_min_le t hij hlt
          have h1 : t i - t j ≤ -((gapSet t).min' (gapSet_nonempty t)) := by linarith
          calc (n:ℝ) * (t i - t j)
              ≤ (n:ℝ) * (-((gapSet t).min' (gapSet_nonempty t))) :=
                mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg n)
            _ = -((gapSet t).min' (gapSet_nonempty t) * (n:ℝ)) := by ring
        calc Real.exp ((n:ℝ)*(t i - t j)) * |u i j|
            < Real.exp ((n:ℝ)*(t i - t j)) * ρ := mul_lt_mul_of_pos_left huij (Real.exp_pos _)
          _ ≤ Real.exp (-((gapSet t).min' (gapSet_nonempty t) * (n:ℝ))) * ρ :=
              mul_le_mul_of_nonneg_right hb hρ.le
      · push Not at hlt
        rw [hzero i j hij hlt, mul_zero, abs_zero]
        exact mul_pos (Real.exp_pos _) hρ

end Work.EKLC6Core
