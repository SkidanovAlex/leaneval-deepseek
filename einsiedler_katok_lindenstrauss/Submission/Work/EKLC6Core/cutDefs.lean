namespace Work.EKLC6Core

open Work.EKLContract
open Work.EKLComp

/-- **The cut data** (Pisa 7.38, steps 1+2): a finite family of pairwise disjoint open cells
covering a `μ`-conull set, each inside the ball `(V (2ρ)) • mkX (g i)`, with `μ`-thin boundary,
together with the locally `U`-equivariant lift `lift i` on each cell. -/
structure CutD (μ : MeasureTheory.Measure X3) (U : Subgroup SL3) where
  N : ℕ
  Q : Fin N → Set X3
  hopen : ∀ i, IsOpen (Q i)
  hdisj : ∀ i j, i ≠ j → Disjoint (Q i) (Q j)
  hcov : μ (⋃ i, Q i)ᶜ = 0
  ρ : ℝ
  hρ : 0 < ρ
  cthin : ℝ
  hcthin : 0 < cthin
  hthinU : ∀ η : ℝ, 0 < η →
    μ (⋃ i, (fun p : SL3 × X3 => p.1 • p.2) '' ((V η) ×ˢ (frontier (Q i))))
      ≤ ENNReal.ofReal (cthin * η)
  g : Fin N → SL3
  hsub : ∀ i, Q i ⊆ (fun u : SL3 => u • mkX (g i)) '' (V (2 * ρ))
  lift : Fin N → X3 → SL3
  lift_mk : ∀ i y, y ∈ Q i → mkX (lift i y) = y
  lift_mem : ∀ i y (hy : y ∈ Q i), ∃ v ∈ V (200 * ρ), lift i y = v * g i
  lift_uniq : ∀ i y (hy : y ∈ Q i) (w : SL3), mkX w = y →
    (∃ v ∈ V (400 * ρ), w = v * g i) → w = lift i y

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}

/-- **The generator family of the cut σ-algebra.**  For a family `W` of `U`-saturated open
subsets of `SL₃(ℝ)` and a cut datum `S`, the `(i,m)`-th generator is the set of points of the
cell `i` whose lift lies in the `m`-th transversal piece. -/
def genCCutD (S : CutD μ U) (W : ℕ → Set SL3) (i : Fin S.N) (m : ℕ) : Set X3 :=
  mkX '' (W m ∩ {h : SL3 | ∃ v ∈ V (200 * S.ρ), h = v * S.g i}) ∩ S.Q i

/-- The cut σ-algebra: generated by the cells and the transversal cuts. -/
def MSigCutD (S : CutD μ U) (W : ℕ → Set SL3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom (Set.range S.Q ∪ Set.range (fun p : Fin S.N × ℕ => genCCutD S W p.1 p.2))

/-- **The past σ-algebra** of the cut algebra: `A = ⨆ n, comap ((aDiag t ·)^[n]) M`.  It is
`aDiag t`-decreasing by construction. -/
def pastSigCutD (t : Fin 3 → ℝ) (M : MeasurableSpace X3) : MeasurableSpace X3 :=
  ⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M

end Work.EKLC6Core
