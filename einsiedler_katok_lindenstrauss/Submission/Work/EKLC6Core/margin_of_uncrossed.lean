import Mathlib
import Submission.Work.EKLC6Core.CellSysDefs
import Submission.Work.EKLC6Core.atom_MSig
import Submission.Work.EKLC6Core.genC_mem_iff
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq
import Submission.Work.EKLContract.Lemmas.aDiag_conj_uij

/-!
# `Work.EKLC6Core.margin_of_uncrossed` — the uncrossed margin lies in the atom

Let `μ` be an `aDiag t`-invariant probability on `X₃ = SL₃(ℝ)/SL₃(ℤ)`, `S : CellSys μ U` a cell
system (countably many pairwise disjoint small open cells `S.Q k` covering a conull set, each
inside a `V (S.δ k / 2)`-ball around a centre `mkX (S.g k)`, with injectivity of
`v ↦ v • mkX (S.g k)` on `V (4 * S.δ k)`, the goodness condition `S.hgood`, and `μ`-thin
boundaries), `O : ℕ → Set SL₃(ℝ)` a countable family separating the left `U`-cosets, and let
`rate ∈ (0,1)`, `C > 0`.

Assume the cell system is **uncrossed** at the geometric scales `C * rate ^ n` along the orbit
`y_n = aDiag t^[n] · x`: for `μ`-a.e. `x` there is `N` such that for all `n ≥ N`, all `k` with
`y_n ∈ S.Q k` and all `v ∈ V (C * rate ^ n)` one has `v • y_n ∈ S.Q k`.

Then for `μ`-a.e. `x` and all sufficiently large `n`, *every* `u ∈ U` with `u ∈ V (C * rate ^ n)`
sends the orbit point `y_n` into its own atom of the σ-algebra `MSig S O` generated by the cells
and the clipped cylinder generators.

## Structure of the proof

Write `y = y_n`, and let `y ∈ S.Q k`.

1. **The margin is bounded by the cell radius.**  From the uncrossedness hypothesis (applied to
   *all* of `V ε`, `ε = C * rate ^ n`) we get `ε ≤ 2 * S.δ k`
   (`Work.EKLC6Core.margin_le_cellDelta`).  Indeed, if `2 δ < ε` with `v ∈ V (δ/2)` a lift of `y`
   and `A = v - 1`, the transvection `u = u_ij(c)`, `c := (δ/2 - A i j)/(1 + A j j)`, lies in
   `V ε` (its only non-trivial entry is `c`, and `|c| < 2 δ < ε`), so `u • y ∈ S.Q k`; on the
   other hand `u * v` differs from the identity by `< 4 δ` in every entry but has `(i,j)`-entry
   exactly `δ/2`, so `S.hinj` applied to `u * v` and to a lift `v' ∈ V (δ/2)` of `u • y` gives
   `u * v = v'`, whence `δ/2 = |(u*v) i j| < δ/2`.
2. **The generator patterns of `y` and `u • y` agree.**  Both points lie in the same cell `S.Q k`
   (`hc` from the uncrossedness hypothesis), so the cells `S.Q k'` cannot separate them
   (disjointness); and for the clipped generators, `genC_mem_iff` reduces membership of `z` in
   `genC S O k m` to membership of `lift S k z` in `satU U (O m)`, while the margin bound makes
   the canonical lift `U`-equivariant (`lift_smul_eq`): `lift S k (u • y) = u * lift S k y`.  Since
   `satU U (O m)` is invariant under left multiplication by `u ∈ U` (`mem_satU_mul_iff`), the two
   membership patterns coincide.
3. **Patterns determine atoms** (`mem_atom_generateFrom_iff`): a point is in the atom of `y` for
   `MeasurableSpace.generateFrom (fam S O)` exactly when it has the same membership pattern.
-/

open MeasureTheory Filter Topology
open scoped ENNReal

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}

/-! ## Matrix calculus -/

theorem mul_sub_one_eq' (A B : Matrix (Fin 3) (Fin 3) ℝ) :
    A * B - 1 = (A - 1) * (B - 1) + (A - 1) + (B - 1) := by
  noncomm_ring

theorem mul_entries_le_three' {A B : Matrix (Fin 3) (Fin 3) ℝ} (i j : Fin 3) {sA sB : ℝ}
    (hA : ∀ k l, |A k l| ≤ sA) (hB : ∀ k l, |B k l| ≤ sB) (hsA : 0 ≤ sA) (hsB : 0 ≤ sB) :
    |(A * B) i j| ≤ 3 * sA * sB := by
  rw [Matrix.mul_apply]
  calc |∑ k : Fin 3, A i k * B k j| ≤ ∑ k : Fin 3, |A i k * B k j| :=
        Finset.abs_sum_le_sum_abs _ _
    _ = ∑ k : Fin 3, |A i k| * |B k j| := by simp [abs_mul]
    _ ≤ ∑ _k : Fin 3, sA * sB :=
        Finset.sum_le_sum (fun k _ => mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hsA)
    _ = 3 * (sA * sB) := by simp [Finset.sum_const, Fintype.card_fin]
    _ = 3 * sA * sB := by ring

/-- Entrywise, the product of two elements of `V sA` and `V sB` differs from the identity by at
most `sA + sB + 3 sA sB`. -/
theorem abs_mul_sub_one_lt {A B : Matrix (Fin 3) (Fin 3) ℝ} (i j : Fin 3)
    {sA sB : ℝ} (hA : ∀ k l, |A k l - (1 : Matrix (Fin 3) (Fin 3) ℝ) k l| < sA)
    (hB : ∀ k l, |B k l - (1 : Matrix (Fin 3) (Fin 3) ℝ) k l| < sB)
    (hsA : 0 ≤ sA) (hsB : 0 ≤ sB) :
    |(A * B) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < sA + sB + 3 * sA * sB := by
  have hcoe : (A * B) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j
      = ((A - 1) * (B - 1)) i j + (A - 1) i j + (B - 1) i j := by
    have h := congrFun (congrFun (mul_sub_one_eq' A B) i) j
    simpa [Matrix.sub_apply, Matrix.add_apply] using h
  have hAb : ∀ k l, |(A - 1) k l| ≤ sA :=
    fun k l => le_of_lt (by simpa [Matrix.sub_apply] using hA k l)
  have hBb : ∀ k l, |(B - 1) k l| ≤ sB :=
    fun k l => le_of_lt (by simpa [Matrix.sub_apply] using hB k l)
  have hsum : |((A - 1) * (B - 1)) i j| ≤ 3 * sA * sB :=
    mul_entries_le_three' i j hAb hBb hsA hsB
  have hsub : |(A - 1) i j| + |(B - 1) i j| < sA + sB :=
    add_lt_add (by simpa [Matrix.sub_apply] using hA i j)
      (by simpa [Matrix.sub_apply] using hB i j)
  have habs3 : |((A - 1) * (B - 1)) i j + (A - 1) i j + (B - 1) i j|
      ≤ |((A - 1) * (B - 1)) i j| + |(A - 1) i j| + |(B - 1) i j| := by
    calc |((A - 1) * (B - 1)) i j + (A - 1) i j + (B - 1) i j|
        = |(((A - 1) * (B - 1)) i j + (A - 1) i j) + (B - 1) i j| := by ring_nf
      _ ≤ |((A - 1) * (B - 1)) i j + (A - 1) i j| + |(B - 1) i j| := abs_add_le _ _
      _ ≤ (|((A - 1) * (B - 1)) i j| + |(A - 1) i j|) + |(B - 1) i j| := by
            linarith [abs_add_le (((A - 1) * (B - 1)) i j) ((A - 1) i j)]
  rw [hcoe]
  linarith

/-- Entries of `single i j a * M`. -/
theorem single_mul_apply' (i j : Fin 3) (a : ℝ) (M : Matrix (Fin 3) (Fin 3) ℝ)
    (p q : Fin 3) :
    (Matrix.single i j a * M) p q = if p = i then a * M j q else 0 := by
  rw [Matrix.mul_apply]
  by_cases hp : p = i
  · rw [hp]
    rw [Finset.sum_eq_single j
      (fun b _ hb => by
        rw [Matrix.single_apply, if_neg (by rintro ⟨-, h⟩; exact hb h.symm)]
        ring)
      (fun hj => absurd (Finset.mem_univ j) hj)]
    rw [Matrix.single_apply, if_pos ⟨rfl, rfl⟩, if_pos rfl]
  · rw [if_neg hp]
    refine Finset.sum_eq_zero (fun l _ => ?_)
    rw [Matrix.single_apply, if_neg (by rintro ⟨hpi, -⟩; exact hp hpi.symm)]
    ring

/-- The transvection `u_ij(a)` lies in `V δ` as soon as `|a| < δ`. -/
theorem uij_mem_V {i j : Fin 3} (hij : i ≠ j) {a δ : ℝ} (ha : |a| < δ) (hδ : 0 < δ) :
    uij hij a ∈ V δ := by
  intro p q
  have hcoe : (uij hij a : Matrix (Fin 3) (Fin 3) ℝ) = toMat (uij hij a) := rfl
  have h : |toMat (uij hij a) p q - (1 : Matrix (Fin 3) (Fin 3) ℝ) p q| < δ := by
    rw [Work.EKLContract.Lemmas.toMat_uij, Matrix.add_apply, add_sub_cancel_left,
      Matrix.single_apply]
    by_cases hpq : i = p ∧ j = q
    · rw [if_pos hpq]; simpa using ha
    · rw [if_neg hpq]; simpa using hδ
  simpa [hcoe] using h

/-! ## The canonical lift -/

/-- The canonical lift `lift S k y` of a point of a cell is `v * S.g k` with `v ∈ V (S.δ k / 2)`
and `v • mkX (S.g k) = y`. -/
lemma lift_spec (S : CellSys μ U) {k : ℕ} {y : X3} (hy : y ∈ S.Q k) :
    ∃ v ∈ V (S.δ k / 2), lift S k y = v * S.g k ∧ v • mkX (S.g k) = y := by
  classical
  have h := Classical.choose_spec (S.hsub k hy)
  exact ⟨Classical.choose (S.hsub k hy), h.1, by simp [lift, dif_pos hy], h.2⟩

/-- **Local `U`-equivariance of the canonical lift.**  If `u ∈ V ε` with `ε ≤ 2 * S.δ k` and the
perturbed point `u • y` still lies in the same cell `S.Q k`, then the canonical lift of `u • y` is
`u` times the canonical lift of `y`. -/
lemma lift_smul_eq (S : CellSys μ U) {k : ℕ} {y : X3} (hy : y ∈ S.Q k) {u : SL3} {ε : ℝ}
    (hu : u ∈ V ε) (hε : ε ≤ 2 * S.δ k) (hyu : u • y ∈ S.Q k) :
    lift S k (u • y) = u * lift S k y := by
  obtain ⟨v, hv, hlift, hvk⟩ := lift_spec S hy
  obtain ⟨v', hv', hlift', hv'k⟩ := lift_spec S hyu
  have hδpos : 0 < S.δ k := S.hδpos k
  have hεpos : 0 < ε := lt_of_le_of_lt (abs_nonneg _) (hu ⟨0, by decide⟩ ⟨0, by decide⟩)
  have hbpos : 0 < S.δ k / 2 := by linarith
  have hw4 : u * v ∈ V (4 * S.δ k) := by
    intro z w
    have key := abs_mul_sub_one_lt (A := (u : Matrix (Fin 3) (Fin 3) ℝ))
      (B := (v : Matrix (Fin 3) (Fin 3) ℝ)) z w (sA := ε) (sB := S.δ k / 2)
      (fun p q => hu p q) (fun p q => hv p q) (le_of_lt hεpos) (le_of_lt hbpos)
    have hcoe : ((u * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
        = (u : Matrix (Fin 3) (Fin 3) ℝ) * (v : Matrix (Fin 3) (Fin 3) ℝ) :=
      Matrix.SpecialLinearGroup.coe_mul u v
    have hδle : S.δ k ≤ 1 / 16 := S.hδsmall k
    have hbound : ε + S.δ k / 2 + 3 * ε * (S.δ k / 2) ≤ 4 * S.δ k := by nlinarith
    rw [hcoe]
    linarith
  have hsame : u * v = v' := by
    refine S.hinj k (u * v) v' hw4 (V_mono' (by linarith) hv') ?_
    calc (u * v) • mkX (S.g k) = u • (v • mkX (S.g k)) := by rw [mul_smul]
      _ = u • y := by rw [hvk]
      _ = v' • mkX (S.g k) := hv'k.symm
  rw [hlift', ← hsame, hlift]
  group

/-! ## `U`-invariance of the saturated pieces -/

/-- `satU U A` is invariant under left multiplication by elements of `U`. -/
lemma mem_satU_mul_iff {U : Subgroup SL3} {u : SL3} (hu : u ∈ U) (A : Set SL3) (h : SL3) :
    u * h ∈ satU U A ↔ h ∈ satU U A := by
  constructor
  · rintro ⟨v, hv, a, ha, hva⟩
    exact ⟨u⁻¹ * v, U.mul_mem (U.inv_mem hu) hv, a, ha, by rw [mul_assoc, hva]; group⟩
  · rintro ⟨v, hv, a, ha, hva⟩
    exact ⟨u * v, U.mul_mem hu hv, a, ha, by rw [mul_assoc, hva]⟩

/-! ## The orbit stays in the cells -/

/-- If the cells cover a `μ`-conull set, then for `μ`-a.e. `x` the whole forward orbit of `x`
lies in the union of the cells. -/
lemma ae_orbit_mem_iUnion_countable {t : Fin 3 → ℝ} {μ : MeasureTheory.Measure X3}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ) (Q : ℕ → Set X3)
    (hcov : μ (⋃ k, Q k)ᶜ = 0) :
    ∀ᵐ x ∂μ, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k, Q k := by
  rw [MeasureTheory.ae_iff]
  have hset : {x : X3 | ¬ ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k, Q k}
      = ⋃ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) ⁻¹' (⋃ k, Q k)ᶜ := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_preimage, Set.mem_compl_iff,
      not_forall]
  rw [hset]
  exact measure_iUnion_null fun n => (hmp.iterate n).preimage_null hcov

/-! ## The margin is bounded by the cell radius -/

/-- **If no `V ε`-perturbation moves `y ∈ S.Q k` out of its cell, then `ε ≤ 2 * S.δ k`.**

This is proved by the sharp computation with the transvection `u = u_ij(c)`: with `v ∈ V (δ/2)`
a lift of `y`, `c := (δ/2 - A i j)/(1 + A j j)` (`A := v - 1`) is small enough that `u ∈ V ε`
whenever `2 δ < ε`, so `u • y ∈ S.Q k`; but then `u * v ∈ V (4 δ)` has `(i,j)`-entry `δ/2`, which
together with `S.hinj` and a lift `v' ∈ V (δ/2)` of `u • y` is contradictory. -/
theorem margin_le_cellDelta (S : CellSys μ U) {k : ℕ} {y : X3} (hy : y ∈ S.Q k) {ε : ℝ}
    (h : ∀ v : SL3, v ∈ V ε → v • y ∈ S.Q k) : ε ≤ 2 * S.δ k := by
  by_contra hcon
  rw [not_le] at hcon
  obtain ⟨v, hv, hvy⟩ := S.hsub k hy
  have hvy : v • mkX (S.g k) = y := hvy
  have hδpos : 0 < S.δ k := S.hδpos k
  have hδ16 : S.δ k ≤ 1 / 16 := S.hδsmall k
  have hδ2 : (S.δ k) ^ 2 ≤ S.δ k / 16 := by nlinarith [hδpos, hδ16]
  have hεpos : 0 < ε := by linarith
  obtain ⟨i, j, hij⟩ : ∃ i j : Fin 3, i ≠ j := ⟨0, 1, by decide⟩
  set A : Matrix (Fin 3) (Fin 3) ℝ := (v : Matrix (Fin 3) (Fin 3) ℝ) - 1 with hAdef
  have hAb : ∀ p q : Fin 3, |A p q| < S.δ k / 2 := by
    intro p q
    have hpq := hv p q
    simpa [hAdef, Matrix.sub_apply] using hpq
  have hden_pos : 0 < 1 + A j j := by
    have h := abs_lt.mp (hAb j j)
    linarith [h.1, hδ16]
  have hnum : |S.δ k / 2 - A i j| < S.δ k := by
    have h := abs_lt.mp (hAb i j)
    rw [abs_lt]
    constructor <;> linarith [h.1, h.2, hδpos]
  set c : ℝ := (S.δ k / 2 - A i j) / (1 + A j j) with hcdef
  have hc_abs : |c| < 2 * S.δ k := by
    rw [hcdef, abs_div, abs_of_pos hden_pos, div_lt_iff₀ hden_pos]
    have h := abs_lt.mp (hAb j j)
    nlinarith [hnum, h.1, hδpos, hδ2]
  have hc_lt : |c| < ε := by linarith
  have huV : uij hij c ∈ V ε := uij_mem_V hij hc_lt hεpos
  have hmemQ : (uij hij c) • y ∈ S.Q k := h _ huV
  obtain ⟨v', hv', hv'eq⟩ := S.hsub k hmemQ
  have hcoe_uv : ((uij hij c * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
      = (uij hij c : Matrix (Fin 3) (Fin 3) ℝ) * (v : Matrix (Fin 3) (Fin 3) ℝ) :=
    Matrix.SpecialLinearGroup.coe_mul _ _
  have huc : ∀ p q : Fin 3, |(uij hij c : Matrix (Fin 3) (Fin 3) ℝ) p q
      - (1 : Matrix (Fin 3) (Fin 3) ℝ) p q| < 2 * S.δ k := by
    intro p q
    exact uij_mem_V hij hc_abs (by linarith [hδpos]) p q
  have hw4 : uij hij c * v ∈ V (4 * S.δ k) := by
    intro z w
    have key := abs_mul_sub_one_lt (A := (uij hij c : Matrix (Fin 3) (Fin 3) ℝ))
      (B := (v : Matrix (Fin 3) (Fin 3) ℝ)) z w (sA := 2 * S.δ k) (sB := S.δ k / 2)
      (fun p q => huc p q) (fun p q => hv p q) (by linarith [hδpos]) (by linarith [hδpos])
    rw [hcoe_uv]
    have hb : 2 * S.δ k + S.δ k / 2 + 3 * (2 * S.δ k) * (S.δ k / 2) ≤ 4 * S.δ k := by
      nlinarith [hδpos, hδ2]
    linarith
  have hventry : (v : Matrix (Fin 3) (Fin 3) ℝ) i j = A i j := by
    rw [hAdef, Matrix.sub_apply, Matrix.one_apply_ne hij, sub_zero]
  have hvjentry : (v : Matrix (Fin 3) (Fin 3) ℝ) j j = A j j + 1 := by
    rw [hAdef, Matrix.sub_apply, Matrix.one_apply_eq]
    ring
  have hsingle : (uij hij c : Matrix (Fin 3) (Fin 3) ℝ) = 1 + Matrix.single i j c := by
    rw [show (uij hij c : Matrix (Fin 3) (Fin 3) ℝ) = toMat (uij hij c) from rfl, Work.EKLContract.Lemmas.toMat_uij]
  have hwentry : (uij hij c * v) i j = S.δ k / 2 := by
    have h1 : ((uij hij c * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
        = (v : Matrix (Fin 3) (Fin 3) ℝ) i j
          + c * (v : Matrix (Fin 3) (Fin 3) ℝ) j j := by
      rw [hcoe_uv, hsingle, add_mul, one_mul, Matrix.add_apply, single_mul_apply']
      simp
    have h2 : ((uij hij c * v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j = S.δ k / 2 := by
      rw [h1, hventry, hvjentry, hcdef]
      have hden : (1 + A j j) ≠ 0 := ne_of_gt hden_pos
      have hcancel : (S.δ k / 2 - A i j) / (1 + A j j) * (1 + A j j) = S.δ k / 2 - A i j :=
        div_mul_cancel₀ _ hden
      have hcomm : A j j + 1 = 1 + A j j := by ring
      rw [hcomm, hcancel]
      ring
    simpa using h2
  have hv'4 : v' ∈ V (4 * S.δ k) := V_mono' (by linarith [hδpos]) hv'
  have heq : uij hij c * v = v' :=
    S.hinj k _ _ hw4 hv'4 (by rw [mul_smul, hvy]; exact hv'eq.symm)
  have hv'entry : |v' i j| < S.δ k / 2 := by
    have h1 := hv' i j
    rw [Matrix.one_apply_ne hij, sub_zero] at h1
    exact h1
  rw [heq] at hwentry
  rw [hwentry] at hv'entry
  rw [abs_of_pos (by linarith [hδpos] : (0 : ℝ) < S.δ k / 2)] at hv'entry
  exact absurd hv'entry (lt_irrefl (S.δ k / 2))

/-! ## The main theorem -/

theorem margin_of_uncrossed {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] {U : Subgroup Work.EKLContract.SL3}
    {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    (S : Work.EKLC6Core.CellSys μ U) (O : ℕ → Set Work.EKLContract.SL3)
    (hOsep : ∀ g g' : Work.EKLContract.SL3,
      (∀ m, (∃ u ∈ U, u * g ∈ O m) ↔ (∃ u ∈ U, u * g' ∈ O m)) → ∃ u ∈ U, g' = u * g)
    (hmeas : ∀ k m, MeasurableSet (Work.EKLC6Core.genC S O k m))
    {rate C : ℝ} (hrate0 : 0 < rate) (hrate1 : rate < 1) (hC : 0 < C)
    (hunc : ∀ᵐ x ∂μ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ k : ℕ,
      ((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x ∈ S.Q k →
      ∀ v : Work.EKLContract.SL3, v ∈ Work.EKLContract.V (C * rate ^ n) →
        v • (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) ∈ S.Q k) :
    ∀ᵐ x ∂μ, ∀ᶠ n in Filter.atTop, ∀ u ∈ U,
      u ∈ Work.EKLContract.V (C * rate ^ n) →
        u • (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) ∈
          Work.EKLContract.atom (Work.EKLC6Core.MSig S O)
            (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) := by
  classical
  filter_upwards [hunc, ae_orbit_mem_iUnion_countable (t := t) hmp S.Q S.hcover]
    with x huncx hcovx
  obtain ⟨N, hN⟩ := huncx
  filter_upwards [Filter.eventually_ge_atTop N] with n hn
  intro u huU huV
  obtain ⟨k, hk⟩ := Set.mem_iUnion.mp (hcovx n)
  have hyu : u • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ S.Q k := hN n hn k hk u huV
  have hδ : C * rate ^ n ≤ 2 * S.δ k :=
    margin_le_cellDelta S hk (fun v hv => hN n hn k hk v hv)
  rw [MSig, mem_atom_generateFrom_iff]
  intro A hA
  rcases hA with ⟨k', rfl⟩ | ⟨⟨k', m⟩, rfl⟩
  · by_cases hkk : k' = k
    · rw [hkk]; exact iff_of_true hyu hk
    · exact iff_of_false (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc hyu)
        (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc hk)
  · by_cases hkk : k' = k
    · rw [hkk]
      rw [genC_mem_iff S O k m hyu, genC_mem_iff S O k m hk,
        lift_smul_eq S hk huV hδ hyu]
      exact mem_satU_mul_iff huU (O m) (lift S k (((fun y : X3 => aDiag t • y)^[n]) x))
