import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLC6Core.contraction_rate_uminus

/-!
# `EKLC6Core.uminus_entry_zero`

If `u` lies in `Uminus t = ⨆_{t i < t j} U_ij`, the subgroup of `SL₃(ℝ)` generated by the root
groups contracted by `aDiag t`, then its `(i,j)`-entry vanishes whenever `t j ≤ t i` (`i ≠ j`):
the complementary position is either expanded by `aDiag t` (if `t j < t i`) or fixed (if
`t j = t i`), so the contraction `aDiag t ^ n · u · (aDiag t ^ n)⁻¹ → 1` forces it to be `0`.

This is the second half of `Work.EKLC6Core.uminus_entry_facts`
(`Submission/Work/EKLC6Core/contraction_rate_uminus.lean`), stated on its own.
-/

namespace Work.EKLC6Core

theorem uminus_entry_zero {t : Fin 3 → ℝ} {u : Work.EKLContract.SL3}
    (hu : u ∈ Work.EKLC6Core.Uminus t) {i j : Fin 3} (hij : i ≠ j) (hle : t j ≤ t i) :
    (u : Matrix (Fin 3) (Fin 3) ℝ) i j = 0
:= (uminus_entry_facts t hu).2 i j hij hle

end Work.EKLC6Core
