import Mathlib
import Submission.Work.EKLC6Core.CellWDefs
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq
import Submission.Work.EKLC6Core.margin_le_cellDeltaW
import Submission.Work.EKLC6Core.liftW_smul_eq
import Submission.Work.EKLC6Core.genCW_mem_iff

/-!
# `Work.EKLC6Core.cellW_margin` — the uncrossed margin lies in the `MSigW`-atom

Let `μ` be an `aDiag t`-invariant probability on `X₃ = SL₃(ℝ)/SL₃(ℤ)`, `S : CellW μ U` a cell
system (countably many pairwise disjoint small open cells `S.Q k` covering a conull set, each
inside a `V (S.δ k / 2)`-ball around a centre `mkX (S.g k)`, with injectivity of
`v ↦ v • mkX (S.g k)` on `V (4 * S.δ k)`), `O : ℕ → Set SL₃(ℝ)` a countable family separating the
left `U`-cosets, and `c > 0`, `lam ∈ (0,1)`.

Assume the cell system is **uncrossed** at the geometric scales `c * lam ^ n` along the orbit
`y_n = aDiag t^[n] · x`: for `μ`-a.e. `x` there is `N` such that for all `n ≥ N`, all `k` with
`y_n ∈ S.Q k` and all `v ∈ V (c * lam ^ n)` one has `v • y_n ∈ S.Q k`.

Then for `μ`-a.e. `x` and all sufficiently large `n`, *every* `u ∈ U` with `u ∈ V (c * lam ^ n)`
sends the orbit point `y_n` into its own atom of the σ-algebra `MSigW S O` generated by the cells
and the clipped cylinder generators.  This is the `CellW` (usable-residue) form of
`Work.EKLC6Core.margin_of_uncrossed`.

## Structure of the proof

Write `y = y_n` and let `y ∈ S.Q k` (which happens a.e. for every `n`, by `S.hcover` and
`ae_orbit_mem_iUnion_cellsW`).

1. **The margin is bounded by the cell radius.**  Uncrossedness applied to *all* of `V ε`,
   `ε = c * lam ^ n`, gives `ε ≤ 2 * S.δ k` (`Work.EKLC6Core.margin_le_cellDeltaW`), by the sharp
   transvection computation.
2. **The canonical lift is locally `U`-equivariant**: for `u ∈ V ε`, `ε ≤ 2 * S.δ k`, with
   `u • y` still in `S.Q k`, one has `liftW S k (u • y) = u * liftW S k y`
   (`Work.EKLC6Core.liftW_smul_eq`), because `u * v ∈ V (4 * S.δ k)` for `v ∈ V (S.δ k / 2)` and
   `mkX` is injective there (`S.hinj`).
3. **The generator patterns of `y` and `u • y` agree.**  Both points lie in the same cell `S.Q k`,
   so the cells `S.Q k'` cannot separate them (disjointness); and for the clipped generators,
   `genCW_mem_iff` reduces membership of `z ∈ S.Q k` in `genCW S O k m` to membership of
   `liftW S k z` in `satU U (O m)`, while step 2 makes the canonical lift `U`-equivariant; since
   `satU U (O m)` is invariant under left multiplication by `u ∈ U` (`mem_satU_mul_iffW`), the two
   patterns coincide.
4. **Patterns determine atoms** (`mem_atom_generateFrom_iff`): a point is in the atom of `y` for
   `MeasurableSpace.generateFrom (famW S O)` exactly when it has the same membership pattern.
-/

open MeasureTheory Filter Topology
open scoped ENNReal Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## `U`-invariance of the saturated pieces -/

/-- `satU U A` is invariant under left multiplication by elements of `U`. -/
theorem mem_satU_mul_iffW {U : Subgroup SL3} {u : SL3} (hu : u ∈ U) (A : Set SL3) (h : SL3) :
    u * h ∈ satU U A ↔ h ∈ satU U A := by
  constructor
  · rintro ⟨v, hv, a, ha, hva⟩
    exact ⟨u⁻¹ * v, U.mul_mem (U.inv_mem hu) hv, a, ha, by rw [mul_assoc, hva]; group⟩
  · rintro ⟨v, hv, a, ha, hva⟩
    exact ⟨u * v, U.mul_mem hu hv, a, ha, by rw [mul_assoc, hva]⟩

/-! ## The orbit stays in the cells -/

/-- If the cells cover a `μ`-conull set, then for `μ`-a.e. `x` the whole forward orbit of `x`
lies in the union of the cells. -/
lemma ae_orbit_mem_iUnion_cellsW {t : Fin 3 → ℝ} {μ : MeasureTheory.Measure X3}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) μ μ) (Q : ℕ → Set X3)
    (hcov : μ (⋃ k, Q k)ᶜ = 0) :
    ∀ᵐ x ∂μ, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k, Q k := by
  rw [MeasureTheory.ae_iff]
  have hset : {x : X3 | ¬ ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k, Q k}
      = ⋃ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) ⁻¹' (⋃ k, Q k)ᶜ := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_preimage, Set.mem_compl_iff,
      not_forall]
  rw [hset]
  exact measure_iUnion_null fun n => (hmp.iterate n).preimage_null hcov

/-! ## The main theorem -/

theorem cellW_margin {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] {U : Subgroup Work.EKLContract.SL3} {t : Fin 3 → ℝ}
    (S : Work.EKLC6Core.CellW μ U) (O : ℕ → Set Work.EKLContract.SL3)
    (hOsep : ∀ g g' : Work.EKLContract.SL3,
      (∀ m, (∃ u ∈ U, u * g ∈ O m) ↔ (∃ u ∈ U, u * g' ∈ O m)) → ∃ u ∈ U, g' = u * g)
    (hmeas : ∀ k m, MeasurableSet (Work.EKLC6Core.genCW S O k m))
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {c lam : ℝ} (hc : 0 < c) (hlam0 : 0 < lam) (hlam1 : lam < 1)
    (hunc : ∀ᵐ x ∂μ, ∀ᶠ n in Filter.atTop, ∀ k : ℕ,
      (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) ∈ S.Q k →
      ∀ v : Work.EKLContract.SL3, v ∈ Work.EKLContract.V (c * lam ^ n) →
        v • (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) ∈ S.Q k) :
    ∀ᵐ x ∂μ, ∀ᶠ n in Filter.atTop, ∀ u ∈ U,
      u ∈ Work.EKLContract.V (c * lam ^ n) →
        u • (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) ∈
          Work.EKLContract.atom (Work.EKLC6Core.MSigW S O)
            (((fun y : Work.EKLContract.X3 => Work.EKLContract.aDiag t • y)^[n]) x) := by
  classical
  filter_upwards [hunc, ae_orbit_mem_iUnion_cellsW (t := t) hmp S.Q S.hcover]
    with x huncx hcovx
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp huncx
  filter_upwards [Filter.eventually_ge_atTop N] with n hn
  intro u huU huV
  obtain ⟨k, hk⟩ := Set.mem_iUnion.mp (hcovx n)
  have hyu : u • (((fun y : X3 => aDiag t • y)^[n]) x) ∈ S.Q k := hN n hn k hk u huV
  have hδ : c * lam ^ n ≤ 2 * S.δ k :=
    margin_le_cellDeltaW S hk (fun v hv => hN n hn k hk v hv)
  rw [MSigW, mem_atom_generateFrom_iff]
  intro A hA
  rcases hA with ⟨k', rfl⟩ | ⟨⟨k', m⟩, rfl⟩
  · by_cases hkk : k' = k
    · rw [hkk]; exact iff_of_true hyu hk
    · exact iff_of_false (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc hyu)
        (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc hk)
  · by_cases hkk : k' = k
    · rw [hkk]
      rw [genCW_mem_iff S O k m hyu, genCW_mem_iff S O k m hk,
        liftW_smul_eq S hk huV hδ hyu]
      exact mem_satU_mul_iffW huU (O m) (liftW S k (((fun y : X3 => aDiag t • y)^[n]) x))
    · exact iff_of_false (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc.2 hyu)
        (fun hc => Set.disjoint_left.mp (S.hdisj k' k hkk) hc.2 hk)

end Work.EKLC6Core
