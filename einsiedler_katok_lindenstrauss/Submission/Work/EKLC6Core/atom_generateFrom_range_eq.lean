import Mathlib
import Submission.Work.EKLContract.Interfaces

open MeasureTheory

set_option warn.classDefReducibility false
set_option linter.unusedVariables false

/-!
# `Work.EKLC6Core.atom_generateFrom_range_eq`

The atoms of a σ-algebra generated by a countable family of sets are the "same membership
pattern" classes.  Concretely, for a family `b : ℕ → Set X₃` and a point `x`,

`atom (generateFrom (range b)) x = {y | ∀ n, (y ∈ b n ↔ x ∈ b n)}`.

The proof is the standard one: every measurable set of `generateFrom (range b)` is constant on
pattern classes (`patternSigma` below is the σ-algebra of sets determined by the pattern of `x`,
and it contains `range b`), while the pattern class of `x` is itself generated-measurable, being
a countable intersection of the `b n` and their complements.
-/

namespace Work.EKLC6Core

open Work.EKLContract

/-- The σ-algebra of sets whose membership is determined by the `S`-pattern of a fixed point. -/
def patternSigma (S : Set (Set X3)) (x : X3) : MeasurableSpace X3 where
  MeasurableSet' A := ∀ y : X3, (∀ A' ∈ S, (y ∈ A' ↔ x ∈ A')) → (y ∈ A ↔ x ∈ A)
  measurableSet_empty := by intro y _; simp
  measurableSet_compl := by intro A hA y hy; simpa using (hA y hy).not
  measurableSet_iUnion := by
    intro f hf y hy
    simp only [Set.mem_iUnion]
    exact exists_congr (fun n => hf n y hy)

lemma patternSigma_le (S : Set (Set X3)) (x : X3) :
    MeasurableSpace.generateFrom S ≤ patternSigma S x :=
  MeasurableSpace.generateFrom_le (m := patternSigma S x) (fun t ht => fun y hy => hy t ht)

lemma atom_subset_of_mem {m : MeasurableSpace X3} {s : Set X3} {x : X3}
    (hs : MeasurableSet[m] s) (hx : x ∈ s) : atom m x ⊆ s :=
  fun _ hy => hy s ⟨hs, hx⟩

/-- **Atoms of a generated σ-algebra are the "same pattern" classes.** -/
lemma mem_atom_generateFrom_iff {S : Set (Set X3)} {x y : X3} :
    y ∈ atom (MeasurableSpace.generateFrom S) x ↔ ∀ A ∈ S, (y ∈ A ↔ x ∈ A) := by
  constructor
  · intro hy A hA
    have hmA : MeasurableSet[MeasurableSpace.generateFrom S] A :=
      MeasurableSpace.measurableSet_generateFrom hA
    refine ⟨fun hyA => ?_, fun hxA => atom_subset_of_mem hmA hxA hy⟩
    by_contra hxA
    exact (atom_subset_of_mem hmA.compl hxA hy) hyA
  · intro h
    rw [atom]
    intro A hA
    exact ((MeasurableSpace.le_def.mp (patternSigma_le S x)) A hA.1 y h).2 hA.2

theorem atom_generateFrom_range_eq (b : ℕ → Set Work.EKLContract.X3) (x : Work.EKLContract.X3) :
    Work.EKLContract.atom (MeasurableSpace.generateFrom (Set.range b)) x =
      {y | ∀ n, (y ∈ b n ↔ x ∈ b n)} := by
  ext y
  rw [mem_atom_generateFrom_iff]
  constructor
  · intro h n
    exact h (b n) ⟨n, rfl⟩
  · rintro h A ⟨n, rfl⟩
    exact h n

end Work.EKLC6Core
