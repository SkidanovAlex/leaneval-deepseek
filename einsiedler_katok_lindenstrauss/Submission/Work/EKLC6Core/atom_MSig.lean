import Mathlib
import Submission.Work.EKLC6Core.CellSysDefs

/-!
# `Work.EKLC6Core.atom_MSig`

The atoms of the σ-algebra `MSig S O` generated by a cell system `S` and a family `O` of subsets
of `SL₃(ℝ)` are the pieces of `U`-orbits cut out by the lifted ball of the containing cell: for
`y ∈ S.Q k`,

    atom (MSig S O) y = mkX '' (U · lift S k y ∩ lifted (δ k) (g k)) ∩ S.Q k.

## Proof

* `atomMSig_mem_atom_generateFrom`: for **any** family `b` of subsets of `X₃`, the atom of `x`
  with respect to `MeasurableSpace.generateFrom b` is the "pattern class"
  `{z | ∀ s ∈ b, (z ∈ s ↔ x ∈ s)}` of `x`.  The non-obvious inclusion is that the pattern class
  lies in *every* `generateFrom b`-measurable set containing `x`: the pattern map
  `z ↦ {s ∈ b | z ∈ s}` satisfies `generateFrom b ≤ comap patt ⊤` (each `s ∈ b` is the pullback of
  `{T | s ∈ T}`), so no measurable set can separate two points with the same pattern.
* `atomMSig_mem_genC_iff`: inside the cell `Q k` — where `mkX` is injective on the lifted ball
  `lifted (δ k) (g k)` and where the lift of a point is characterised as the unique element of
  that ball mapping to it — membership in the clipped generator `genC S O k m` is membership of
  the lift in the `U`-saturation `satU U (O m)` of `O m`.  Combined with `hOsep`, equality of
  patterns therefore forces the two lifts to lie in the same `U`-orbit.
-/

open MeasureTheory Filter Topology
open scoped ENNReal Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}

/-! ## Elementary facts about the projection and the lift -/

/-- The projection `mkX : SL₃(ℝ) → X₃` is equivariant for the left action: this is definitional,
because the action on the coset space is the quotient of the left regular action. -/
theorem atomMSig_smul_mkX (g h : SL3) : mkX (g * h) = g • mkX h := rfl

/-- The lift of a point of a cell lies in the lifted ball of that cell. -/
theorem atomMSig_lift_mem (S : CellSys μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    lift S k y ∈ lifted (S.δ k) (S.g k) := by
  classical
  obtain ⟨hch1, -⟩ := Classical.choose_spec (S.hsub k hy)
  have hch1' : Classical.choose (S.hsub k hy) ∈ V (S.δ k) := V_mono' (by linarith [S.hδpos k]) hch1
  rw [lift, dif_pos hy]
  exact ⟨Classical.choose (S.hsub k hy), hch1', rfl⟩

/-- The lift of a point of a cell maps back to that point. -/
theorem atomMSig_mkX_lift (S : CellSys μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    mkX (lift S k y) = y := by
  classical
  obtain ⟨-, hch2⟩ := Classical.choose_spec (S.hsub k hy)
  have hch2' : Classical.choose (S.hsub k hy) • mkX (S.g k) = y := hch2
  rw [lift, dif_pos hy, atomMSig_smul_mkX]
  exact hch2'

/-- `mkX` is injective on a lifted ball. -/
theorem atomMSig_mkX_inj_lifted (S : CellSys μ U) (k : ℕ) {a b : SL3}
    (ha : a ∈ lifted (S.δ k) (S.g k)) (hb : b ∈ lifted (S.δ k) (S.g k))
    (h : mkX a = mkX b) : a = b := by
  obtain ⟨v₁, hv₁, h1⟩ := ha
  obtain ⟨v₂, hv₂, h2⟩ := hb
  have h1' : v₁ * S.g k = a := h1
  have h2' : v₂ * S.g k = b := h2
  have hv4 : v₁ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₁
  have hv4' : v₂ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₂
  have hmk : v₁ • mkX (S.g k) = v₂ • mkX (S.g k) := by
    rw [← atomMSig_smul_mkX v₁ (S.g k), ← atomMSig_smul_mkX v₂ (S.g k), h1', h2', h]
  have hv : v₁ = v₂ := S.hinj k v₁ v₂ hv4 hv4' hmk
  rw [← h1', ← h2', hv]

/-! ## The `U`-saturation -/

/-- `satU U O` is exactly the set of `g` some `U`-translate of which lies in `O` (valid because
`U` is a subgroup). -/
theorem atomMSig_mem_satU_iff (O : Set SL3) (g : SL3) :
    g ∈ satU U O ↔ ∃ u ∈ U, u * g ∈ O := by
  constructor
  · rintro ⟨u, huU, o, hoO, rfl⟩
    exact ⟨u⁻¹, U.inv_mem huU, by rw [inv_mul_cancel_left]; exact hoO⟩
  · rintro ⟨u, huU, hu⟩
    exact ⟨u⁻¹, U.inv_mem huU, u * g, hu, by rw [inv_mul_cancel_left]⟩

/-- Left `U`-multiplication does not change membership of `satU U O`. -/
theorem atomMSig_satU_mul_iff (O : Set SL3) {u g : SL3} (hu : u ∈ U) :
    u * g ∈ satU U O ↔ g ∈ satU U O := by
  rw [atomMSig_mem_satU_iff, atomMSig_mem_satU_iff]
  constructor
  · rintro ⟨u', hu'U, hu'⟩
    exact ⟨u' * u, U.mul_mem hu'U hu, by rw [mul_assoc]; exact hu'⟩
  · rintro ⟨u', hu'U, hu'⟩
    exact ⟨u' * u⁻¹, U.mul_mem hu'U (U.inv_mem hu), by rw [mul_assoc, inv_mul_cancel_left]; exact hu'⟩

/-! ## Atoms of a generated σ-algebra -/

/-- The pattern of a point with respect to a family `b` of subsets of `X₃`: the family of members
of `b` containing the point. -/
def atomMSig_patt (b : Set (Set X3)) (x : X3) : Set (Set X3) := {s ∈ b | x ∈ s}

/-- **The atom of a generated σ-algebra is the pattern class.**  For any family `b` of subsets of
`X₃`, a point `z` lies in the atom of `x` for `MeasurableSpace.generateFrom b` if and only if `z`
and `x` are contained in exactly the same members of `b`. -/
theorem atomMSig_mem_atom_generateFrom {b : Set (Set X3)} {x z : X3} :
    z ∈ atom (MeasurableSpace.generateFrom b) x ↔ ∀ s ∈ b, (z ∈ s ↔ x ∈ s) := by
  constructor
  · intro hz s hs
    refine ⟨fun hzs => ?_, fun hxs => ?_⟩
    · by_contra hxs
      exact Set.mem_sInter.mp hz sᶜ
        ⟨(MeasurableSpace.measurableSet_generateFrom hs).compl, hxs⟩ hzs
    · exact Set.mem_sInter.mp hz s ⟨MeasurableSpace.measurableSet_generateFrom hs, hxs⟩
  · intro h
    rw [atom]
    refine Set.mem_sInter.mpr fun s hs => ?_
    obtain ⟨hmeas, hxs⟩ := hs
    have hle : MeasurableSpace.generateFrom b ≤ MeasurableSpace.comap (atomMSig_patt b) ⊤ := by
      refine MeasurableSpace.generateFrom_le fun t ht => ?_
      rw [MeasurableSpace.measurableSet_comap]
      exact ⟨{T : Set (Set X3) | t ∈ T}, trivial, by
        ext w
        rw [Set.mem_preimage, Set.mem_ofPred_eq, atomMSig_patt, Set.mem_ofPred_eq]
        exact ⟨fun h => h.2, fun h => ⟨ht, h⟩⟩⟩
    have hpat : atomMSig_patt b z = atomMSig_patt b x := by
      ext t
      simp only [atomMSig_patt, Set.mem_ofPred_eq]
      exact ⟨fun ⟨htb, hzt⟩ => ⟨htb, (h t htb).1 hzt⟩, fun ⟨htb, hxt⟩ => ⟨htb, (h t htb).2 hxt⟩⟩
    have hsc : MeasurableSet[MeasurableSpace.comap (atomMSig_patt b) ⊤] s := hle s hmeas
    rw [MeasurableSpace.measurableSet_comap] at hsc
    obtain ⟨t, -, ht⟩ := hsc
    rw [← ht] at hxs ⊢
    rw [Set.mem_preimage] at hxs ⊢
    rw [hpat]
    exact hxs

/-! ## Membership in the clipped generators -/

/-- Inside a cell, membership in a clipped generator is membership of the lift in the saturation
of the generator set. -/
theorem atomMSig_mem_genC_iff (S : CellSys μ U) (O : ℕ → Set SL3) {k m : ℕ} {z : X3}
    (hz : z ∈ S.Q k) :
    z ∈ genC S O k m ↔ lift S k z ∈ satU U (O m) := by
  constructor
  · intro h
    obtain ⟨⟨w, ⟨hwsat, hwl⟩, hwz⟩, -⟩ := h
    have hw : w = lift S k z :=
      atomMSig_mkX_inj_lifted S k hwl (atomMSig_lift_mem S k hz)
        (by rw [hwz, atomMSig_mkX_lift S k hz])
    rwa [hw] at hwsat
  · intro h
    exact ⟨⟨lift S k z, ⟨h, atomMSig_lift_mem S k hz⟩, atomMSig_mkX_lift S k hz⟩, hz⟩

/-! ## The main theorem -/

theorem atom_MSig {μ : MeasureTheory.Measure Work.EKLContract.X3} {U : Subgroup Work.EKLContract.SL3}
    (S : Work.EKLC6Core.CellSys μ U) (O : ℕ → Set Work.EKLContract.SL3)
    (hOsep : ∀ g g' : Work.EKLContract.SL3,
      (∀ m, (∃ u ∈ U, u * g ∈ O m) ↔ (∃ u ∈ U, u * g' ∈ O m)) → ∃ u ∈ U, g' = u * g)
    (hmeas : ∀ k m, MeasurableSet (Work.EKLC6Core.genC S O k m))
    {k : ℕ} {y : Work.EKLContract.X3} (hy : y ∈ S.Q k) :
    Work.EKLContract.atom (Work.EKLC6Core.MSig S O) y
      = Work.EKLContract.mkX '' ({g : Work.EKLContract.SL3 | ∃ u ∈ U, g = u * Work.EKLC6Core.lift S k y}
          ∩ Work.EKLC6Core.lifted (S.δ k) (S.g k)) ∩ S.Q k := by
  classical
  have key : ∀ z : X3, z ∈ atom (MSig S O) y ↔ ∀ s ∈ fam S O, (z ∈ s ↔ y ∈ s) := by
    intro z
    show z ∈ atom (MeasurableSpace.generateFrom (fam S O)) y ↔ _
    exact atomMSig_mem_atom_generateFrom
  ext z
  constructor
  · -- every point of the atom lies in the piece of the `U`-orbit of the lift of `y`
    intro hz
    have hp : ∀ s ∈ fam S O, (z ∈ s ↔ y ∈ s) := (key z).mp hz
    have hzQ : z ∈ S.Q k := (hp (S.Q k) (Or.inl ⟨k, rfl⟩)).mpr hy
    have hgen : ∀ m, z ∈ genC S O k m ↔ y ∈ genC S O k m :=
      fun m => hp (genC S O k m) (Or.inr ⟨(k, m), rfl⟩)
    have hsat : ∀ m, lift S k z ∈ satU U (O m) ↔ lift S k y ∈ satU U (O m) :=
      fun m => ((atomMSig_mem_genC_iff S O hzQ).symm.trans (hgen m)).trans
        (atomMSig_mem_genC_iff S O hy)
    have hsat' : ∀ m, (∃ u ∈ U, u * lift S k z ∈ O m) ↔ (∃ u ∈ U, u * lift S k y ∈ O m) :=
      fun m => ((atomMSig_mem_satU_iff (U := U) (O m) (lift S k z)).symm.trans (hsat m)).trans
        (atomMSig_mem_satU_iff (U := U) (O m) (lift S k y))
    obtain ⟨u, huU, huy⟩ := hOsep (lift S k z) (lift S k y) hsat'
    have hwit : lift S k z = u⁻¹ * lift S k y := by rw [huy, inv_mul_cancel_left]
    exact ⟨⟨lift S k z, ⟨⟨u⁻¹, U.inv_mem huU, hwit⟩, atomMSig_lift_mem S k hzQ⟩,
      atomMSig_mkX_lift S k hzQ⟩, hzQ⟩
  · -- and conversely every point of that piece has the same pattern as `y`
    intro hz
    obtain ⟨⟨w, ⟨hwW, hwl⟩, hwz⟩, hzQ⟩ := hz
    obtain ⟨u, huU, hwu⟩ := hwW
    have hℓw : lift S k z = w :=
      atomMSig_mkX_inj_lifted S k (atomMSig_lift_mem S k hzQ) hwl
        (by rw [atomMSig_mkX_lift S k hzQ, hwz])
    have hℓ : lift S k z = u * lift S k y := by rw [hℓw, hwu]
    refine (key z).mpr fun s hs => ?_
    rcases hs with ⟨j, hj⟩ | ⟨⟨i, m⟩, him⟩
    · rw [← hj]
      by_cases hjk : j = k
      · rw [hjk]; exact ⟨fun _ => hy, fun _ => hzQ⟩
      · exact iff_of_false (Set.disjoint_left.mp (S.hdisj k j (Ne.symm hjk)) hzQ)
          (Set.disjoint_left.mp (S.hdisj k j (Ne.symm hjk)) hy)
    · rw [← him]
      by_cases hik : i = k
      · rw [hik, atomMSig_mem_genC_iff S O hzQ, atomMSig_mem_genC_iff S O hy, hℓ,
          atomMSig_satU_mul_iff (U := U) (O m) huU]
      · exact iff_of_false
          (fun h => Set.disjoint_left.mp (S.hdisj i k hik) h.2 hzQ)
          (fun h => Set.disjoint_left.mp (S.hdisj i k hik) h.2 hy)

end Work.EKLC6Core
