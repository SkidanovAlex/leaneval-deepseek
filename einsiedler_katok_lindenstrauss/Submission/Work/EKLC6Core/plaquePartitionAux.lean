import Mathlib
import Submission.Work.EKLC6Core.PlaquePartitionData
import Submission.Work.EKLC6Core.BiGenChain.hPart_le_hPart_add_Hcond
import Submission.Work.EKLC6Core.Hcond_mono

/-!
# `Work.EKLC6Core.plaquePartitionAux` — auxiliary notions for `HasPlaquePartition`

This module fixes the vocabulary in which the geometric input of
`Work.EKLC6Core.hasPlaquePartition` (Pisa 7.37/7.38 + 7.43) is stated, and records an elementary
fact about the *modulo `μ`* behaviour of the conditional entropy `Hcond`.

* `pastSigFinPart t P = ⨆ₙ comap ((aDiag t ·)^[n]) (partSigma P)` — the past σ-algebra of the
  finite partition `P`.  Choosing `M := partSigma P` in `HasPlaquePartition` makes both
  σ-algebra inclusions `partSigma P ≤ M ≤ pastSigFinPart t P` automatic, so the whole content of
  `HasPlaquePartition μ t` is the *existence of a finite partition* `P` together with two
  properties of `P`:

  - `IsPlaqueAlgebra (Uminus t) Z (pastSigFinPart t P)` for a `μ`-conull `Z` (the geometry of
    Pisa 7.37/7.38), and
  - `GeneratesModMu μ t P`: the *bi-infinite* coding of `P` generates the Borel σ-algebra modulo
    `μ` (the "generator mod μ" property of Pisa 7.43).

  The *exact* σ-algebra form of the second property is **false** as soon as `aDiag t ·` has two
  distinct fixed points: two fixed points always lie in one part of a finite partition, hence
  have identical `Tⁿ(P_i)`-membership patterns for all `n ∈ ℤ`, while the Borel σ-algebra
  separates them.  The modulo-`μ` form is the one that survives, and it is what the entropy
  comparison actually needs (`Hcond_le_zero_of_diff_null`).

* `SigWrap` is the wrapper for a σ-algebra occurring as a local hypothesis (Lean's type class
  search prefers such a hypothesis over the global instance; see `EKLContract/NOTES.md`).
-/

open MeasureTheory Filter
open scoped ENNReal

noncomputable section

set_option linter.unusedVariables false

namespace Work.EKLC6Core

open Work.EKLContract

/-- Wrapper for a σ-algebra occurring as a local hypothesis, so that it is not picked up by type
class search in place of the ambient instance. -/
structure SigWrap (X : Type*) where
  m : MeasurableSpace X

/-- The *past* σ-algebra of a finite partition under the diagonal flow,
`⨆ₙ comap ((aDiag t ·)^[n]) (partSigma P)`.  This is the σ-algebra `A` of Pisa 7.43. -/
def pastSigFinPart (t : Fin 3 → ℝ) (P : FinPart X3) : MeasurableSpace X3 :=
  ⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) (partSigma P)

/-- The *bi-infinite* orbit σ-algebra of a finite partition: the σ-algebra generated by all
"cells" `Tⁿ(P_i)`, `n ∈ ℤ`, where `T x = aDiag t • x`. -/
def biOrbitFinPart (t : Fin 3 → ℝ) (P : FinPart X3) : MeasurableSpace X3 :=
  ⨆ n : ℕ, (MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) (partSigma P) ⊔
    MeasurableSpace.comap ((fun x : X3 => aDiag (-t) • x)^[n]) (partSigma P))

/-- **The generator property modulo `μ`.**  Every Borel set agrees, up to `μ`-null sets, with a
set measurable for the bi-infinite orbit σ-algebra of `P` (i.e. `P` is a generator for `aDiag t ·`
modulo `μ`, in the sense of Pisa 7.43). -/
def GeneratesModMu (μ : MeasureTheory.Measure X3) (t : Fin 3 → ℝ) (P : FinPart X3) : Prop :=
  ∀ E : Set X3, MeasurableSet E → ∃ E' : Set X3, MeasurableSet[biOrbitFinPart t P] E' ∧
    μ (E \ E') = 0 ∧ μ (E' \ E) = 0

theorem pastSigFinPart_le (t : Fin 3 → ℝ) (P : FinPart X3) :
    pastSigFinPart t P ≤ Work.EKLContract.instMeasurableSpaceX3 := by
  rw [pastSigFinPart]
  refine iSup_le fun n => ?_
  have h1 : partSigma P ≤ (Work.EKLContract.instMeasurableSpaceX3 : MeasurableSpace X3) := by
    rw [partSigma]
    refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨i, rfl⟩
    exact P.measurable i
  have h2 : MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n])
      (Work.EKLContract.instMeasurableSpaceX3 : MeasurableSpace X3) ≤
      Work.EKLContract.instMeasurableSpaceX3 :=
    measurable_iff_comap_le.mp (((continuous_const_smul (aDiag t)).measurable).iterate n)
  exact le_trans (MeasurableSpace.comap_mono h1) h2

theorem pastSigFinPart_le_biOrbitFinPart (t : Fin 3 → ℝ) (P : FinPart X3) :
    pastSigFinPart t P ≤ biOrbitFinPart t P := by
  rw [pastSigFinPart, biOrbitFinPart]
  refine iSup_le fun n => ?_
  exact le_trans le_sup_left (le_iSup (fun n : ℕ =>
    (MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) (partSigma P) ⊔
      MeasurableSpace.comap ((fun x : X3 => aDiag (-t) • x)^[n]) (partSigma P))) n)

/-- **Conditional entropy is `≤ 0` for a partition measurable modulo `μ`.**  If every part of the
finite partition `P` differs from an `m`-measurable set by a `μ`-null set (with `m ≤ mX`), then
`H_μ(P | m) ≤ 0`. -/
theorem Hcond_le_zero_of_diff_null {X : Type*} [mX : MeasurableSpace X] {μ : Measure X}
    [IsProbabilityMeasure μ] (P : FinPart X) (S : SigWrap X) (hm : S.m ≤ mX)
    (h : ∀ i, ∃ s : Set X, MeasurableSet[S.m] s ∧ μ (P.parts i \ s) = 0 ∧ μ (s \ P.parts i) = 0) :
    Hcond μ P S.m ≤ 0 := by
  rw [Hcond]
  choose s hs hd1 hd2 using h
  have hcongr : ∀ i, condExp S.m μ ((P.parts i).indicator (fun _ => (1 : ℝ))) =ᵐ[μ]
      ((s i).indicator (fun _ => (1 : ℝ))) := by
    intro i
    have h1 : ((P.parts i).indicator (fun _ => (1 : ℝ))) =ᵐ[μ]
        ((s i).indicator (fun _ => (1 : ℝ))) := by
      rw [Filter.EventuallyEq, ae_iff]
      refine measure_mono_null ?_ (measure_union_null (hd1 i) (hd2 i))
      intro x hx
      rw [Set.mem_setOf_eq] at hx
      by_cases hxs : x ∈ s i <;> by_cases hxp : x ∈ P.parts i <;>
        simp [Set.indicator_of_mem, Set.indicator_of_notMem, hxs, hxp] at hx ⊢
    refine (condExp_congr_ae h1).trans ?_
    have hind := condExp_indicator (μ := μ) (m := S.m) (m0 := mX)
      (integrable_const (1 : ℝ)) (hs i)
    rw [condExp_const hm (1 : ℝ)] at hind
    exact hind
  have hsum : ∀ᵐ x ∂μ,
      (∑ i, Real.negMulLog (condExp S.m μ ((P.parts i).indicator (fun _ => (1 : ℝ))) x)) = 0 := by
    have hall : ∀ᵐ x ∂μ, ∀ i, condExp S.m μ ((P.parts i).indicator (fun _ => (1 : ℝ))) x =
        (s i).indicator (fun _ => (1 : ℝ)) x := Filter.eventually_all.2 hcongr
    filter_upwards [hall] with x hx
    refine Finset.sum_eq_zero fun i _ => ?_
    rw [hx i]
    by_cases hxs : x ∈ s i
    · rw [Set.indicator_of_mem hxs, Real.negMulLog_one]
    · rw [Set.indicator_of_notMem hxs, Real.negMulLog_zero]
  rw [integral_congr_ae hsum, integral_zero]

end Work.EKLC6Core

end
