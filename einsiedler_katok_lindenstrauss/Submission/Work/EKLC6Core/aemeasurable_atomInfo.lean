import Mathlib
import Submission.Work.EKLC6Core.growth_le_HcondSig
import Submission.Work.EKLC6Core.uminus_isHoro
import Submission.Work.EKLC6Core.measurable_apply_section
import Submission.Work.EKLC6Core.measurableSet_shapeGraph

/-!
# `EKLC6Core.aemeasurable_atomInfo` — measurability of the atom information

The pointwise "surprisal"

`atomInfo A U ν t x = - log ( (ν x (shape A U x)).toReal / (ν x (shape (comap (aDiag t ·) A) U x)).toReal )`

of the `A`-atom of `x` has to be an honest measurable function of `x` before it can be integrated
(the consumers `HcondSig_le_lintegral_atomInfo`, `lintegral_atomInfo_le`, `growth_le_atomInfo`
all take `∫⁻ ofReal (atomInfo ·)`).

The two ingredients are

* `aemeasurable_shape_mass_of_seq`: for a σ-algebra `generateFrom (range E)` generated by a
  *sequence* of Borel sets and a weakly measurable family of leafwise measures `ν`, finite on
  compacta along `X'`, the function `x ↦ ν x (shape (generateFrom (range E)) U x)` is a.e.
  measurable.  Its graph is Borel — the atoms of a countably generated σ-algebra are the "bit
  classes" of the generating sequence — and the section evaluation of a Borel subset of
  `X₃ × SL₃` against a weakly measurable family finite on compacta is measurable
  (`measurable_apply_section`);
* `A ≤ borel X₃` and countable generation pass to `comap (aDiag t ·)`.

Measurability of the quotient, the logarithm and the negation is then immediate.
-/

open MeasureTheory Filter Topology
open scoped ENNReal

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ### Elementary σ-algebra bookkeeping -/

/-- A countably generated sub-σ-algebra `A ≤ borel X₃` is generated by a *sequence* of Borel sets.
The enumeration is `MeasurableSpace.natGeneratingSequence`, available once `A` is installed as the
ambient measurable structure. -/
theorem exists_generating_sequence {A : MeasurableSpace X3} (hA : A ≤ borel X3)
    (hcount : ∃ b : Set (Set X3), b.Countable ∧ A = MeasurableSpace.generateFrom b) :
    ∃ E : ℕ → Set X3, (∀ n, @MeasurableSet X3 (borel X3) (E n)) ∧
      A = MeasurableSpace.generateFrom (Set.range E) := by
  obtain ⟨b, hbcount, hAeq⟩ := hcount
  letI : MeasurableSpace X3 := A
  haveI : MeasurableSpace.CountablyGenerated X3 := ⟨b, hbcount, hAeq⟩
  refine ⟨MeasurableSpace.natGeneratingSequence X3, ?_, ?_⟩
  · intro n
    exact hA _ (MeasurableSpace.measurableSet_natGeneratingSequence n)
  · exact (MeasurableSpace.generateFrom_natGeneratingSequence X3).symm

/-- The action of `aDiag t` on `X₃` is Borel measurable (both σ-algebras being `borel X₃`). -/
theorem measurable_smul_aDiag (t : Fin 3 → ℝ) :
    @Measurable X3 X3 (borel X3) (borel X3) (fun y : X3 => aDiag t • y) :=
  (continuous_const_smul (aDiag t)).measurable

/-- The pull-back of a sub-σ-algebra of `borel X₃` along the continuous map `y ↦ aDiag t • y` is
again a sub-σ-algebra of `borel X₃`. -/
theorem comap_le_borel_of_le {A : MeasurableSpace X3} (hA : A ≤ borel X3) (t : Fin 3 → ℝ) :
    MeasurableSpace.comap (fun y : X3 => aDiag t • y) A ≤ borel X3 := by
  intro s hs
  rw [MeasurableSpace.measurableSet_comap] at hs
  obtain ⟨u, huA, rfl⟩ := hs
  exact measurable_smul_aDiag t (hA u huA)

/-! ### Measurability of the mass of the atom shape -/

/-- **Measurability of the mass of the `A`-atom shape**, for `A` generated by a sequence `E` of
Borel sets. -/
theorem aemeasurable_shape_mass_of_seq {μ : Measure X3} [IsProbabilityMeasure μ]
    {U : Subgroup SL3} (hU : IsClosed (U : Set SL3))
    {ν : X3 → Measure SL3} {X' : Set X3} (hL : IsLeafwise μ U ν X')
    {E : ℕ → Set X3} (hE : ∀ n, MeasurableSet (E n)) :
    AEMeasurable (fun x => ν x (shape (MeasurableSpace.generateFrom (Set.range E)) U x)) μ := by
  classical
  -- the graph of the shape map is Borel, and its sections are the shapes
  have hSmeas : MeasurableSet
      {p : X3 × SL3 | p.2 ∈ shape (MeasurableSpace.generateFrom (Set.range E)) U p.1} :=
    measurableSet_shapeGraph hU hE
  have hSect : ∀ x : X3, Prod.mk x ⁻¹' {p : X3 × SL3 |
      p.2 ∈ shape (MeasurableSpace.generateFrom (Set.range E)) U p.1}
        = shape (MeasurableSpace.generateFrom (Set.range E)) U x := by
    intro x
    ext u
    simp
  -- restrict `ν` to `X'`, where it is finite on compacta
  set κ : X3 → Measure SL3 := fun x => if x ∈ X' then ν x else 0 with hκdef
  have hκfin : ∀ x, IsFiniteMeasureOnCompacts (κ x) := by
    intro x
    by_cases hx : x ∈ X'
    · rw [hκdef]
      simp only [hx, if_true]
      exact hL.radon x hx
    · rw [hκdef]
      simp only [hx, if_false]
      infer_instance
  have hκmeas : ∀ f : CompactlySupportedContinuousMap SL3 ℝ,
      Measurable fun x => ∫ g, f g ∂(κ x) := by
    intro f
    have h1 : Measurable fun x => ∫ g, f g ∂(ν x) := hL.measurable f
    have h2 : (fun x => ∫ g, f g ∂(κ x))
        = fun x => if x ∈ X' then ∫ g, f g ∂(ν x) else 0 := by
      funext x
      by_cases hx : x ∈ X'
      · rw [hκdef]; simp [hx]
      · rw [hκdef]; simp [hx]
    rw [h2]
    exact Measurable.ite hL.meas_dom h1 measurable_const
  have hmain : Measurable fun x => κ x (Prod.mk x ⁻¹' {p : X3 × SL3 |
      p.2 ∈ shape (MeasurableSpace.generateFrom (Set.range E)) U p.1}) :=
    measurable_apply_section hκmeas hκfin hSmeas
  refine (hmain.aemeasurable).congr ?_
  have haeX' : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff]
    have hset : {a : X3 | ¬ a ∈ X'} = X'ᶜ := by
      ext a
      simp
    rw [hset]
    exact hL.conull
  filter_upwards [haeX'] with x hx
  rw [hSect x, hκdef]
  simp only [hx, if_true]

/-! ### The target -/

theorem aemeasurable_atomInfo {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3} (t : Fin 3 → ℝ)
    (hErg : Work.EKLContract.IsAErgodic μ)
    (hL : Work.EKLContract.IsLeafwise μ (Work.EKLC6Core.Uminus t) ν X')
    {A : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A) (hZ : μ Zᶜ = 0) :
    AEMeasurable (Work.EKLC6Core.atomInfo A (Work.EKLC6Core.Uminus t) ν t) μ := by
  classical
  have hUclosed : IsClosed ((Uminus t : Subgroup SL3) : Set SL3) := (uminus_isHoro t).1.1
  -- a Borel generating sequence for `A`
  obtain ⟨E, hEmeas, hAgen⟩ := exists_generating_sequence hplq.1 hplq.2.1
  have hV : @AEMeasurable X3 ℝ≥0∞ _ (borel X3)
      (fun x => ν x (shape A (Uminus t) x)) μ := by
    have h := aemeasurable_shape_mass_of_seq (μ := μ) (U := Uminus t) hUclosed hL hEmeas
    rw [← hAgen] at h
    exact h
  -- the pull-back σ-algebra is again countably generated over a Borel sub-σ-algebra
  have hA' : MeasurableSpace.comap (fun y : X3 => aDiag t • y) A ≤ borel X3 :=
    comap_le_borel_of_le hplq.1 t
  have hcount' : ∃ b' : Set (Set X3), b'.Countable ∧
      MeasurableSpace.comap (fun y : X3 => aDiag t • y) A = MeasurableSpace.generateFrom b' := by
    obtain ⟨b, hbc, hbA⟩ := hplq.2.1
    exact ⟨Set.preimage (fun y : X3 => aDiag t • y) '' b, hbc.image _, by
      rw [hbA, MeasurableSpace.comap_generateFrom]⟩
  obtain ⟨E', hE'meas, hA'gen⟩ := exists_generating_sequence hA' hcount'
  have hW : @AEMeasurable X3 ℝ≥0∞ _ (borel X3)
      (fun x => ν x (shape (MeasurableSpace.comap (fun y : X3 => aDiag t • y) A)
        (Uminus t) x)) μ := by
    have h := aemeasurable_shape_mass_of_seq (μ := μ) (U := Uminus t) hUclosed hL hE'meas
    rw [← hA'gen] at h
    exact h
  -- combine: real-valued masses, quotient, logarithm, negation
  have hVr : @AEMeasurable X3 ℝ _ (borel X3)
      (fun x => (ν x (shape A (Uminus t) x)).toReal) μ := hV.ennreal_toReal
  have hWr : @AEMeasurable X3 ℝ _ (borel X3)
      (fun x => (ν x (shape (MeasurableSpace.comap (fun y : X3 => aDiag t • y) A)
        (Uminus t) x)).toReal) μ := hW.ennreal_toReal
  have hratio := hVr.div hWr
  have hlog := Real.measurable_log.comp_aemeasurable hratio
  exact hlog.neg

end Work.EKLC6Core

end
