import Mathlib
import Submission.Work.EKLContract.Interfaces

/-!
# `Work.EKLC6Core.atom_iSup_comap_iterate_eq`

The atom of the σ-algebra `⨆ n, φ^[n] ⁻¹' M` generated by the pullbacks of a fixed σ-algebra
`M` along the iterates of a self-map `φ` is the set of points `y` whose `n`-th iterate lies in the
`M`-atom of the `n`-th iterate of `x`, for every `n`.

Two ingredients:

* `mem_atom_iff` — membership in an atom is "no `m`-measurable set separates the points";
* `atom_iSup_eq` — the atom of a supremum of σ-algebras is the intersection of the atoms of the
  factors (via `MeasurableSpace.forall_generateFrom_mem_iff_mem_iff` and
  `MeasurableSpace.iSup_generateFrom`).

The pullback step `atom (comap f m) x = f ⁻¹' atom m (f x)` is proved inline (`atom_comap'`); it is
the elementary consequence of `MeasurableSpace.measurableSet_comap` and needs no hypothesis on `f`
whatsoever (not even measurability).
-/

open MeasureTheory

set_option warn.classDefReducibility false

namespace Work.EKLC6Core

open Work.EKLContract

/-- Membership in an atom: `y` lies in the atom of `x` for `m` exactly when no `m`-measurable set
separates `x` from `y`. -/
lemma mem_atom_iff {m : MeasurableSpace X3} {x y : X3} :
    y ∈ atom m x ↔ ∀ s, MeasurableSet[m] s → (x ∈ s ↔ y ∈ s) := by
  constructor
  · intro hy s hs
    exact ⟨fun hx => hy s ⟨hs, hx⟩, fun hys => by
      by_contra hx
      exact (hy sᶜ ⟨hs.compl, hx⟩) hys⟩
  · intro h s hs
    exact (h s hs.1).1 hs.2

/-- **Atoms of a supremum of σ-algebras** are the intersections of the atoms of the factors:
`[x]_{⨆ i, m i} = {y | ∀ i, y ∈ [x]_{m i}}`. -/
lemma atom_iSup_eq {ι : Type*} (m : ι → MeasurableSpace X3) (x : X3) :
    atom (⨆ i, m i) x = {y | ∀ i, y ∈ atom (m i) x} := by
  have hgen : (⨆ i, m i) =
      MeasurableSpace.generateFrom (⋃ i, {t | MeasurableSet[m i] t}) := by
    rw [← MeasurableSpace.iSup_generateFrom]
    exact iSup_congr fun i => (@MeasurableSpace.generateFrom_measurableSet X3 (m i)).symm
  ext y
  simp only [Set.mem_ofPred_eq]
  have key : y ∈ atom (MeasurableSpace.generateFrom (⋃ i, {t | MeasurableSet[m i] t})) x ↔
      ∀ s ∈ ⋃ i, {t | MeasurableSet[m i] t}, (x ∈ s ↔ y ∈ s) :=
    mem_atom_iff.trans MeasurableSpace.forall_generateFrom_mem_iff_mem_iff
  rw [hgen, key]
  constructor
  · intro h i
    rw [mem_atom_iff]
    intro s hs
    exact h s (Set.mem_iUnion.mpr ⟨i, hs⟩)
  · intro h s hs
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hs
    exact (mem_atom_iff.mp (h i)) s hi

/-- The atom of a pullback σ-algebra is the preimage of the atom of the target point:
`[x]_{comap f m} = f ⁻¹' [f x]_m`.  No hypothesis on `f` is needed. -/
lemma atom_comap' (f : X3 → X3) (m : MeasurableSpace X3) (x : X3) :
    atom (MeasurableSpace.comap f m) x = f ⁻¹' atom m (f x) := by
  ext y
  rw [Set.mem_preimage]
  constructor
  · intro hy
    rw [atom, Set.mem_sInter] at hy
    rw [atom, Set.mem_sInter]
    intro t ht
    exact hy (f ⁻¹' t) ⟨(MeasurableSpace.measurableSet_comap).mpr ⟨t, ht.1, rfl⟩, ht.2⟩
  · intro hy
    rw [atom, Set.mem_sInter] at hy
    rw [atom, Set.mem_sInter]
    intro s hs
    obtain ⟨t, ht, rfl⟩ := (MeasurableSpace.measurableSet_comap).mp hs.1
    exact hy t ⟨ht, hs.2⟩

theorem atom_iSup_comap_iterate_eq (M : MeasurableSpace Work.EKLContract.X3)
    (φ : Work.EKLContract.X3 → Work.EKLContract.X3) (x : Work.EKLContract.X3) :
    Work.EKLContract.atom (⨆ n : ℕ, MeasurableSpace.comap (φ^[n]) M) x =
      {y | ∀ n : ℕ, φ^[n] y ∈ Work.EKLContract.atom M (φ^[n] x)} := by
  rw [atom_iSup_eq]
  ext y
  constructor
  · intro h n
    have h' := h n
    rw [atom_comap', Set.mem_preimage] at h'
    exact h'
  · intro h n
    rw [atom_comap', Set.mem_preimage]
    exact h n

end Work.EKLC6Core
