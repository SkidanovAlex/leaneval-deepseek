/-!
# `Work.EKLC6Core.exists_gen_plaque_erg` — a *generating* plaque algebra (Pisa 7.37–7.43)

For an `A`-ergodic probability measure `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)` and every `t : Fin 3 → ℝ`
there is a countably generated σ-algebra `A ≤ borel X₃` and a conull set `Z` such that

* `A` is a plaque algebra for the contracted horospherical subgroup `U = Uminus t = G⁻(t)`
  on `Z` (`IsPlaqueAlgebra (Uminus t) Z A`);
* `A` is `aDiag t`-*decreasing*: `comap (aDiag t ·) A ≤ A`;
* `A` *generates* under the flow: `⨆_n comap ((aDiag (-t))·)^[n] A = borel X₃`.

## Structure of the proof

Write `φ x = aDiag t • x`, `ψ x = aDiag (-t) • x` (the inverse of `φ`) and `U = Uminus t`.

The *geometric* input is `Work.EKLC6Core.exists_markov_plaque_algebra`, a σ-algebra `M` which is
`φ`-decreasing, whose atoms on a conull `Z` are bounded `U`-plaques (with a single entrywise bound
`C`), and whose atoms off `Z` are singletons.  Everything in this file is bookkeeping:

* **The atoms of the join are singletons.**  Let `J = ⨆ n, comap (ψ^[n]) M`.  By
  `atom_iSup_comap_iterate_eq`, `y ∈ [x]_J` means `ψ^n y ∈ [ψ^n x]_M` for all `n`.
  * if some `ψ^m x ∉ Z`, then `[ψ^m x]_M = {ψ^m x}` and injectivity of `ψ` gives `y = x`;
  * otherwise all `ψ^n x ∈ Z`, so (the atoms being `U`-plaques with entrywise bound `C`)
    `ψ^n y = u n • (ψ^n x)` with `|(u n) i j| ≤ C`, whence
    `y = (aDiag t^n · u n · aDiag (-t)^n) • x`; by uniform contraction of `U`
    (`Work.EKLC6Core.uniform_contraction_horo`) the conjugates tend to `1`, and comparing the two
    limits of the constant sequence `n ↦ y` gives `y = x`.
* **A countably generated σ-algebra on a Polish space with singleton atoms is the Borel
  σ-algebra** (`Work.Topology.eq_borel_of_separates`).
-/

open MeasureTheory
open Work.EKLContract

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

/-! ## 1. The diagonal maps and their iterates -/

/-- `aDiag (n • t) = (aDiag t) ^ n`. -/
theorem gen_aDiag_nsmul (t : Fin 3 → ℝ) (n : ℕ) : aDiag (n • t) = aDiag t ^ n := by
  induction n with
  | zero => simp [aDiag_zero]
  | succ m ih =>
      rw [show (m + 1) • t = t + m • t from by rw [succ_nsmul, add_comm], ← aDiag_add, ih,
        pow_succ']

/-- The `n`-th iterate of `x ↦ aDiag t • x` is multiplication by `aDiag t ^ n`. -/
theorem gen_iterate_aDiag_smul (t : Fin 3 → ℝ) (n : ℕ) (y : X3) :
    ((fun x : X3 => aDiag t • x)^[n]) y = aDiag t ^ n • y := by
  induction n with
  | zero => simp
  | succ m ih => rw [Function.iterate_succ_apply', ih, ← mul_smul, pow_succ']

/-- `aDiag (-t) ^ n = (aDiag t ^ n)⁻¹`. -/
theorem gen_aDiag_neg_pow (t : Fin 3 → ℝ) (n : ℕ) : aDiag (-t) ^ n = (aDiag t ^ n)⁻¹ := by
  rw [aDiag_neg_eq_inv, inv_pow]

/-- The `n`-th iterate of `x ↦ aDiag (-t) • x` is multiplication by `(aDiag t ^ n)⁻¹`. -/
theorem gen_iterate_aDiag_neg_smul (t : Fin 3 → ℝ) (n : ℕ) (y : X3) :
    ((fun x : X3 => aDiag (-t) • x)^[n]) y = (aDiag t ^ n)⁻¹ • y := by
  rw [gen_iterate_aDiag_smul (-t) n y, gen_aDiag_neg_pow]

/-- `aDiag t ^ n` undoes the `n`-th iterate of `x ↦ aDiag (-t) • x`. -/
theorem gen_smul_iterate_aDiag_neg (t : Fin 3 → ℝ) (n : ℕ) (y : X3) :
    aDiag t ^ n • (((fun x : X3 => aDiag (-t) • x)^[n]) y) = y := by
  rw [gen_iterate_aDiag_neg_smul, ← mul_smul, mul_inv_cancel, one_smul]

/-! ## 2. Elementary σ-algebra bookkeeping -/

/-- The atom contains its point. -/
theorem gen_mem_atom_self (m : MeasurableSpace X3) (x : X3) : x ∈ atom m x :=
  Set.mem_sInter.mpr fun _ hs => hs.2

/-- Atoms are antitone in the σ-algebra. -/
theorem gen_atom_mono_of_le {m m' : MeasurableSpace X3} (h : m ≤ m') (x : X3) :
    atom m' x ⊆ atom m x := by
  intro y hy
  rw [atom, Set.mem_sInter] at hy ⊢
  rintro s ⟨hs, hxs⟩
  exact hy s ⟨h s hs, hxs⟩

/-- A singleton atom at `x` separates `x` from every other point, by an `m`-measurable set. -/
theorem gen_sep_of_atom_singleton {J : MeasurableSpace X3} {x y : X3}
    (h : atom J x = {x}) (hyx : y ≠ x) :
    ∃ s : Set X3, MeasurableSet[J] s ∧ x ∈ s ∧ y ∉ s := by
  by_contra hcon
  have hcon' : ∀ s : Set X3, MeasurableSet[J] s → x ∈ s → y ∈ s := by
    intro s hs hxs
    by_contra hys
    exact hcon ⟨s, hs, hxs, hys⟩
  have hy : y ∈ atom J x := by
    rw [atom]
    exact Set.mem_sInter.mpr fun s hs => hcon' s hs.1 hs.2
  rw [h] at hy
  exact hyx (Set.mem_singleton_iff.mp hy)

/-- A countably generated σ-algebra is generated by a single sequence of sets. -/
theorem gen_exists_seq_generating_of_countable {M : MeasurableSpace X3}
    (h : ∃ b : Set (Set X3), b.Countable ∧ M = MeasurableSpace.generateFrom b) :
    ∃ e : ℕ → Set X3, M = MeasurableSpace.generateFrom (Set.range e) := by
  letI : MeasurableSpace X3 := M
  haveI : MeasurableSpace.CountablyGenerated X3 := MeasurableSpace.CountablyGenerated.mk h
  exact ⟨MeasurableSpace.natGeneratingSequence X3,
    (MeasurableSpace.generateFrom_natGeneratingSequence X3).symm⟩

/-- The supremum of the pullbacks of a countably generated σ-algebra along the iterates of a map
is countably generated. -/
theorem gen_exists_countable_generating_iSup_comap_iterate {M : MeasurableSpace X3} (ψ : X3 → X3)
    (hM : ∃ e : ℕ → Set X3, M = MeasurableSpace.generateFrom (Set.range e)) :
    ∃ b' : Set (Set X3), b'.Countable ∧
      (⨆ n : ℕ, MeasurableSpace.comap (ψ^[n]) M) = MeasurableSpace.generateFrom b' := by
  obtain ⟨e, he⟩ := hM
  refine ⟨Set.range fun p : ℕ × ℕ => (ψ^[p.1]) ⁻¹' (e p.2), Set.countable_range _, ?_⟩
  rw [he]
  refine le_antisymm (iSup_le fun n => ?_) (MeasurableSpace.generateFrom_le ?_)
  · rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_mono ?_
    rintro s ⟨t, ⟨m, rfl⟩, rfl⟩
    exact ⟨(n, m), rfl⟩
  · rintro s ⟨p, rfl⟩
    exact le_iSup (fun n : ℕ => MeasurableSpace.comap (ψ^[n])
      (MeasurableSpace.generateFrom (Set.range e))) p.1 _
      (show MeasurableSet[MeasurableSpace.comap (ψ^[p.1])
            (MeasurableSpace.generateFrom (Set.range e))] ((ψ^[p.1]) ⁻¹' (e p.2)) from
        MeasurableSpace.measurableSet_comap.mpr
          ⟨e p.2, MeasurableSpace.measurableSet_generateFrom ⟨p.2, rfl⟩, rfl⟩)

/-- The supremum of the pullbacks along the iterates of a map of a sub-σ-algebra of the Borel sets
stays inside the Borel sets. -/
theorem gen_iSup_comap_iterate_le_borel {M : MeasurableSpace X3} (ψ : X3 → X3)
    (hψ : ∀ n : ℕ, ∀ s : Set X3,
      MeasurableSet[Work.EKLContract.instMeasurableSpaceX3] s →
      MeasurableSet[Work.EKLContract.instMeasurableSpaceX3] ((ψ^[n]) ⁻¹' s))
    (hM : M ≤ borel X3) :
    (⨆ n : ℕ, MeasurableSpace.comap (ψ^[n]) M) ≤ borel X3 := by
  refine iSup_le fun n => ?_
  intro s hs
  obtain ⟨s', hs', rfl⟩ := (MeasurableSpace.measurableSet_comap (f := ψ^[n]) (m := M)).mp hs
  exact hψ n s' (hM s' hs')

/-! ## 3. The atoms of the join are singletons -/

/-- The iterates of `x ↦ aDiag (-t) • x` are Borel measurable. -/
theorem gen_measurable_iterate_diag_neg (t : Fin 3 → ℝ) (n : ℕ) (s : Set X3)
    (hs : MeasurableSet[Work.EKLContract.instMeasurableSpaceX3] s) :
    MeasurableSet[Work.EKLContract.instMeasurableSpaceX3]
      (((fun x : X3 => aDiag (-t) • x)^[n]) ⁻¹' s) := by
  have hc : Continuous (fun x : X3 => aDiag (-t) • x) := by fun_prop
  exact (hc.measurable.iterate n) hs

/-- **The separation step.**  If the atoms of `M` on the conull set `Z` are bounded
`Uminus t`-plaques (uniform entrywise bound `C`) and its atoms off `Z` are singletons, then the
atoms of `⨆ n, comap (ψ^[n]) M` (with `ψ x = aDiag (-t) • x` the inverse of the diagonal map)
are singletons. -/
theorem gen_atom_iSup_comap_iterate_neg_eq_singleton {t : Fin 3 → ℝ}
    {M : MeasurableSpace X3} {Z : Set X3} {C : ℝ}
    (hplq : IsPlaqueAlgebra (Uminus t) Z M)
    (hsing : ∀ x : X3, x ∉ Z → atom M x = {x})
    (hbnd : ∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom M x → ∀ i j, |u i j| ≤ C)
    (x : X3) :
    atom (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag (-t) • x)^[n]) M) x = {x} := by
  classical
  set ψ : X3 → X3 := fun y => aDiag (-t) • y with hψdef
  set J : MeasurableSpace X3 := ⨆ n : ℕ, MeasurableSpace.comap (ψ^[n]) M with hJdef
  have hatom : atom J x = {y : X3 | ∀ n : ℕ, ψ^[n] y ∈ atom M (ψ^[n] x)} :=
    atom_iSup_comap_iterate_eq M ψ x
  have hatom' : ∀ y : X3, y ∈ atom J x ↔ ∀ n : ℕ, ψ^[n] y ∈ atom M (ψ^[n] x) :=
    fun y => by rw [hatom]; exact Iff.rfl
  refine Set.eq_singleton_iff_unique_mem.mpr ⟨gen_mem_atom_self J x, ?_⟩
  intro y hy
  have hy' : ∀ n : ℕ, ψ^[n] y ∈ atom M (ψ^[n] x) := (hatom' y).mp hy
  by_cases hcase : ∃ m : ℕ, ψ^[m] x ∉ Z
  · -- some backward iterate of `x` lies off `Z`, where the atoms are singletons
    obtain ⟨m, hm⟩ := hcase
    have hle : MeasurableSpace.comap (ψ^[m]) M ≤ J :=
      le_iSup (fun n : ℕ => MeasurableSpace.comap (ψ^[n]) M) m
    have hmem : y ∈ atom (MeasurableSpace.comap (ψ^[m]) M) x :=
      gen_atom_mono_of_le hle x hy
    rw [atom_comap', Set.mem_preimage, hsing (ψ^[m] x) hm, Set.mem_singleton_iff] at hmem
    have hψinj : Function.Injective ψ := by
      rw [hψdef]
      exact MulAction.injective (aDiag (-t))
    exact hψinj.iterate m hmem
  · -- every backward iterate of `x` lies in `Z`
    have hn : ∀ m : ℕ, ψ^[m] x ∈ Z := fun m => not_not.mp (not_exists.mp hcase m)
    have hxZ : x ∈ Z := by simpa using hn 0
    have hU : ∀ n : ℕ, atom M (ψ^[n] x) ⊆
        (fun u : SL3 => u • (ψ^[n] x)) '' (Uminus t : Set SL3) :=
      fun n => (hplq.2.2.2 (ψ^[n] x) (hn n)).2.1
    choose u huU hux using fun n => hU n (hy' n)
    have hux' : ∀ n : ℕ, u n • (ψ^[n] x) = ψ^[n] y := fun n => by simpa using hux n
    have hbnd' : ∀ n : ℕ, ∀ i j, |u n i j| ≤ C :=
      fun n i j => hbnd (ψ^[n] x) (hn n) (u n) (huU n) (by rw [hux' n]; exact hy' n) i j
    have hnorm : ∀ n : ℕ, aDiag t ^ n * u n * (aDiag t ^ n)⁻¹ ∈ Uminus t := by
      intro n
      have h := (uminus_isHoro t).1.2.1 (n • t) (u n) (huU n)
      rwa [gen_aDiag_nsmul] at h
    have hy_eq : ∀ n : ℕ, y = (aDiag t ^ n * u n * (aDiag t ^ n)⁻¹) • x := by
      intro n
      have hψy : ψ^[n] y = (aDiag t ^ n)⁻¹ • y := by
        rw [hψdef]
        exact gen_iterate_aDiag_neg_smul t n y
      have hψx : ψ^[n] x = (aDiag t ^ n)⁻¹ • x := by
        rw [hψdef]
        exact gen_iterate_aDiag_neg_smul t n x
      have hundo : aDiag t ^ n • (ψ^[n] y) = y := by
        rw [hψdef]
        exact gen_smul_iterate_aDiag_neg t n y
      calc y = aDiag t ^ n • (ψ^[n] y) := hundo.symm
        _ = aDiag t ^ n • (u n • (ψ^[n] x)) := by rw [hux' n]
        _ = (aDiag t ^ n * u n) • (ψ^[n] x) := by rw [mul_smul]
        _ = (aDiag t ^ n * u n) • ((aDiag t ^ n)⁻¹ • x) := by rw [hψx]
        _ = (aDiag t ^ n * u n * (aDiag t ^ n)⁻¹) • x := by rw [← mul_smul]
    -- the uniform contraction
    obtain ⟨hsupp, hunif⟩ :=
      uniform_contraction_horo (U := Uminus t) (t := t) (uminus_isHoro t).2
    have hC1 : (1 : ℝ) ≤ C := by
      have h := hbnd x hxZ (1 : SL3) (Uminus t).one_mem
        (by rw [one_smul]; exact gen_mem_atom_self M x) (0 : Fin 3) (0 : Fin 3)
      have h2 : |(1 : SL3) (0 : Fin 3) (0 : Fin 3)| = 1 := by
        rw [Matrix.SpecialLinearGroup.coe_one, Matrix.one_apply_eq, abs_one]
      rwa [h2] at h
    have hVmem : ∀ n : ℕ, u n ∈ V (C + 1) := by
      intro n i j
      by_cases hij : i = j
      · subst hij
        have h1 : (u n : Matrix (Fin 3) (Fin 3) ℝ) i i =
            (1 : Matrix (Fin 3) (Fin 3) ℝ) i i := hsupp (u n) (huU n) i i le_rfl
        rw [h1, sub_self, abs_zero]
        linarith
      · have h1 : (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = 0 := Matrix.one_apply_ne hij
        have h2 : |(u n : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ C := hbnd' n i j
        rw [h1, sub_zero]
        linarith
    have hconv : ∀ δ : ℝ, 0 < δ →
        ∀ᶠ n in Filter.atTop, aDiag t ^ n * u n * (aDiag t ^ n)⁻¹ ∈ V δ := by
      intro δ hδ
      obtain ⟨N, hN⟩ := hunif (C + 1) (by linarith) δ hδ
      exact Filter.eventually_atTop.mpr ⟨N, fun n hn' => hN n hn' (u n) (huU n) (hVmem n)⟩
    have htend : Filter.Tendsto (fun n : ℕ => aDiag t ^ n * u n * (aDiag t ^ n)⁻¹)
        Filter.atTop (nhds 1) :=
      Work.EKLComp.V_hasBasis_nhds_one.tendsto_right_iff.mpr hconv
    haveI : T2Space X3 := Work.EKLComp.X3Background.1
    have hcont : Continuous (fun u : SL3 => u • x) := by fun_prop
    have htend2 : Filter.Tendsto (fun n : ℕ => (aDiag t ^ n * u n * (aDiag t ^ n)⁻¹) • x)
        Filter.atTop (nhds ((1 : SL3) • x)) :=
      (hcont.tendsto (1 : SL3)).comp htend
    have hconst : (fun n : ℕ => (aDiag t ^ n * u n * (aDiag t ^ n)⁻¹) • x) = fun _ => y := by
      funext n
      exact (hy_eq n).symm
    have hfin : y = (1 : SL3) • x :=
      tendsto_nhds_unique (by rw [hconst]; exact tendsto_const_nhds) htend2
    simpa using hfin

/-! ## 4. The assembly -/

/-- **The target from the geometric core** (see the module docstring). -/
theorem exists_gen_plaque_erg_of_core {μ : MeasureTheory.Measure X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hcore : ∃ (M : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z M ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) M ≤ M ∧
      (∀ x : X3, x ∉ Z → atom M x = {x}) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom M x → ∀ i j, |u i j| ≤ C)) :
    ∃ A : MeasurableSpace X3, ∃ Z : Set X3,
      IsPlaqueAlgebra (Uminus t) Z A ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A ∧
      (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag (-t) • x)^[n]) A)
        = instMeasurableSpaceX3 := by
  classical
  obtain ⟨M, Z, C, hplq, hZ, hdec, hsing, hbnd⟩ := hcore
  haveI : PolishSpace X3 := Work.EKLComp.X3Background.2.2.2.1
  set ψ : X3 → X3 := fun y => aDiag (-t) • y with hψdef
  set J : MeasurableSpace X3 := ⨆ n : ℕ, MeasurableSpace.comap (ψ^[n]) M with hJdef
  have hψmeas : ∀ n : ℕ, ∀ s : Set X3,
      MeasurableSet[Work.EKLContract.instMeasurableSpaceX3] s →
      MeasurableSet[Work.EKLContract.instMeasurableSpaceX3] ((ψ^[n]) ⁻¹' s) := by
    intro n s hs
    have h1 := gen_measurable_iterate_diag_neg t n s hs
    rwa [hψdef]
  have hJle : J ≤ borel X3 := gen_iSup_comap_iterate_le_borel ψ hψmeas hplq.1
  have hJgen : ∃ b' : Set (Set X3), b'.Countable ∧
      J = MeasurableSpace.generateFrom b' := by
    rw [hJdef]
    exact gen_exists_countable_generating_iSup_comap_iterate ψ
      (gen_exists_seq_generating_of_countable hplq.2.1)
  have hJcg : @MeasurableSpace.CountablyGenerated X3 J :=
    @MeasurableSpace.CountablyGenerated.mk X3 J hJgen
  have hJsep : ∀ x y : X3, x ≠ y →
      ∃ s : Set X3, @MeasurableSet X3 J s ∧ x ∈ s ∧ y ∉ s :=
    fun x y hxy =>
      gen_sep_of_atom_singleton
        (gen_atom_iSup_comap_iterate_neg_eq_singleton hplq hsing hbnd x) (Ne.symm hxy)
  have hEq : J = borel X3 := by
    -- pin the ambient measurable structure of `X₃` to the global (Borel) one: the bound
    -- `M : MeasurableSpace X₃` would otherwise be picked up by type class search.
    letI : MeasurableSpace X3 := Work.EKLContract.instMeasurableSpaceX3
    exact Work.Topology.eq_borel_of_separates hJle hJcg hJsep
  rw [hJdef] at hEq
  rw [hψdef] at hEq
  refine ⟨M, Z, hplq, hZ, hdec, ?_⟩
  rw [show (instMeasurableSpaceX3 : MeasurableSpace X3) = borel X3 from rfl]
  exact hEq

end Work.EKLC6Core

namespace Work.EKLC6Core

open MeasureTheory

/-- **`Work.EKLC6Core.exists_gen_plaque_erg`** — a generating `aDiag t`-descending plaque
algebra (Pisa 7.37/7.38 + 7.43). -/
theorem exists_gen_plaque_erg {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ) (hErg : Work.EKLContract.IsAErgodic μ)
    (haerg : ∀ E : Set Work.EKLContract.X3, MeasurableSet E →
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) ⁻¹' E =ᵐ[μ] E →
      μ E = 0 ∨ μ Eᶜ = 0) :
    ∃ A : MeasurableSpace Work.EKLContract.X3, ∃ Z : Set Work.EKLContract.X3,
      Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A ∧ μ Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A ≤ A ∧
      (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A)
        = Work.EKLContract.instMeasurableSpaceX3 := by
  exact exists_gen_plaque_erg_of_core t (exists_markov_plaque_algebra t hErg)

end Work.EKLC6Core
