import Mathlib
import Submission.Work.EKLContract.Defs
import Submission.Work.EKLContract.Lemmas.SL3Topology
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq

/-!
# `Work.EKLC6Core.measurableSet_shapeGraph`

The *graph* of the shape map is Borel measurable: for a closed subgroup `U ≤ SL₃(ℝ)` and any
countably generated σ-algebra `m = σ(E₀, E₁, …)` on `X₃` (generated by a sequence of measurable
sets), the set

  `{(x, u) ∈ X₃ × SL₃(ℝ) | u ∈ shape m U x}`

is Borel.

## Proof

`shape m U x = {u ∈ U | u • x ∈ [x]_m}`, and by `atom_generateFrom_range_eq` the atom of `x` for
a σ-algebra generated by a countable family is the "same membership pattern" class

  `[x]_m = {y | ∀ n, (y ∈ E n ↔ x ∈ E n)}`.

Hence the graph is

  `{p | p.2 ∈ U} ∩ ⋂ n {p | (p.2 • p.1 ∈ E n ↔ p.1 ∈ E n)}`,

an intersection of countably many measurable sets: `{p | p.2 ∈ U}` is the preimage of the closed
(hence Borel) set `U` under `Prod.snd`; the condition `p.2 • p.1 ∈ E n` is the preimage of the
measurable set `E n` under the (jointly) measurable action map `p ↦ p.2 • p.1`; and `p.1 ∈ E n`
is the preimage of `E n` under `Prod.fst`.

The only non-formal input is the joint measurability of the action: `SL₃(ℝ)` acts continuously on
`X₃ = SL₃(ℝ)/Γ₃` (`QuotientGroup.instContinuousSMul`), so the action is Borel as soon as one of the
two spaces is second countable (`ContinuousSMul.measurableSMul₂`, applied through
`MeasurableSMul₂.toMeasurableSMul`); for `SL₃(ℝ)` this is `Work.EKLContract.Lemmas.SL3Topology`.
-/

open MeasureTheory Set

-- the `haveI` below is an instance, not data
set_option linter.style.haveILetI false

namespace Work.EKLC6Core

open Work.EKLContract

/-- The "atom graph" of a σ-algebra generated by a sequence of measurable sets is Borel: the set
of pairs `(x, u)` with `u • x ∈ [x]_{σ(E)}`.  This is the substantive half of
`measurableSet_shapeGraph`; the remaining factor `u ∈ U` is a closed condition. -/
lemma measurableSet_atomGraph {b : ℕ → Set Work.EKLContract.X3}
    (hb : ∀ n, MeasurableSet (b n)) :
    MeasurableSet {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
      p.2 • p.1 ∈ Work.EKLContract.atom (MeasurableSpace.generateFrom (Set.range b)) p.1} := by
  -- `SL₃(ℝ)` is second countable, so continuous actions on `X₃` are Borel
  haveI : SecondCountableTopology Work.EKLContract.SL3 :=
    Work.EKLContract.Lemmas.SL3Topology.2
  have hset : {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
        p.2 • p.1 ∈ Work.EKLContract.atom (MeasurableSpace.generateFrom (Set.range b)) p.1}
      = ⋂ n, {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
          (p.2 • p.1 ∈ b n ↔ p.1 ∈ b n)} := by
    ext p
    simp only [Set.mem_ofPred_eq, Set.mem_iInter]
    rw [atom_generateFrom_range_eq b p.1]
    simp only [Set.mem_ofPred_eq]
  rw [hset]
  refine MeasurableSet.iInter fun n => ?_
  have hAn : MeasurableSet {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
      p.2 • p.1 ∈ b n} :=
    (hb n).preimage (by fun_prop)
  have hBn : MeasurableSet {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
      p.1 ∈ b n} :=
    (hb n).preimage measurable_fst
  have hiff : {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
        (p.2 • p.1 ∈ b n ↔ p.1 ∈ b n)}
      = ({p : Work.EKLContract.X3 × Work.EKLContract.SL3 | p.2 • p.1 ∈ b n}
          ∩ {p : Work.EKLContract.X3 × Work.EKLContract.SL3 | p.1 ∈ b n})
        ∪ ({p : Work.EKLContract.X3 × Work.EKLContract.SL3 | p.2 • p.1 ∈ b n}ᶜ
          ∩ {p : Work.EKLContract.X3 × Work.EKLContract.SL3 | p.1 ∈ b n}ᶜ) := by
    ext p
    simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, Set.mem_union, Set.mem_compl_iff]
    tauto
  rw [hiff]
  exact (hAn.inter hBn).union (hAn.compl.inter hBn.compl)

theorem measurableSet_shapeGraph {U : Subgroup Work.EKLContract.SL3}
    (hU : IsClosed (U : Set Work.EKLContract.SL3))
    {E : ℕ → Set Work.EKLContract.X3} (hE : ∀ n, MeasurableSet (E n)) :
    MeasurableSet {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
      p.2 ∈ Work.EKLContract.shape (MeasurableSpace.generateFrom (Set.range E)) U p.1} := by
  have hset : {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
        p.2 ∈ Work.EKLContract.shape (MeasurableSpace.generateFrom (Set.range E)) U p.1}
      = ({p : Work.EKLContract.X3 × Work.EKLContract.SL3 | p.2 ∈ (U : Set Work.EKLContract.SL3)}
          ∩ {p : Work.EKLContract.X3 × Work.EKLContract.SL3 |
              p.2 • p.1 ∈ Work.EKLContract.atom
                (MeasurableSpace.generateFrom (Set.range E)) p.1}) := by
    ext p
    simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, Work.EKLContract.shape, SetLike.mem_coe]
  rw [hset]
  exact (hU.measurableSet.preimage measurable_snd).inter (measurableSet_atomGraph hE)

end Work.EKLC6Core
