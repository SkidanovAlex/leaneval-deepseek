import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLContract.Interfaces
import Submission.Work.EKLC6Core.uminus_isHoro
import Submission.Work.EKLC6Core.margin_shape
import Submission.Work.EKLC6Core.cutSetup
import Submission.Work.EKLComp.LeafDefs

/-!
# `Work.EKLC6Core.CellsData` — the geometric input of the descending plaque algebra

This module isolates, in one structure, the geometric/analytic input which the construction of
the descending plaque algebra of Pisa 7.37/7.38 consumes, and derives the target from it.

## Why a *countable* family of cells (and not a finite partition plus a "bad" piece)

The `CutData` route (`Work.EKLC6Core.exists_desc_plaque_algebra`) produces, for every `e > 0`, a
plaque algebra on a set `Z` with `mu Zᶜ < e`.  Its `Z` is always contained in the union of the
(finitely many) cut cells, so `mu Zᶜ ≥ mu bad > 0`, and it cannot be upgraded to a *conull* `Z`
without cutting the exceptional piece as well.  Cutting it requires cells at *smaller* scales
(the injectivity radius tends to `0` in the cusp), i.e. a countable family of cells at varying
scales — and then the single-scale thin-boundary/Borel–Cantelli argument is unavailable
(`Work.EKLC6Core.cellSys_thin_mass_decay`).  The right input is therefore the countable cell
family *together with* the a.e. "margin" statement (Pisa 7.31/(7.38a)): along almost every orbit
the orbit point is deep inside its cell at the geometric scale.

## Contents

* `CellsData` — the data: countably many pairwise disjoint small open cells covering a conull
  set, with the injectivity condition at their centres and a separating family `O`; the entrywise
  bound `rho`; the conull good set `G` (free, saturated, orbits in the cells, with the openness of
  the descending shape); and the σ-algebraic facts about the atoms of `MSigCut` at the good points
  of the cells.
* `cellsData_core` — the derivation of the target (`IsPlaqueAlgebra`, conull, `aDiag t`-decreasing,
  forward invariant, uniform entrywise bound) from `CellsData`.
-/

open MeasureTheory
open scoped ENNReal
open Work.EKLContract

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

/-! ## Local vocabulary

The definitions below are local copies of the standard vocabulary of the cut construction, so
that this module does not depend on the (concurrently edited) sibling modules beyond the frozen
interfaces. -/

/-- The lifted ball `V d · g` around a point of `SL3(R)`. -/
def liftedC (d : ℝ) (g : SL3) : Set SL3 := (fun v : SL3 => v * g) '' (V d)

theorem isOpen_liftedC (d : ℝ) (g : SL3) : IsOpen (liftedC d g) := by
  rw [liftedC]
  exact (Homeomorph.mulRight g).isOpenMap _ (isOpen_V d)

/-- The left `U`-saturation of a set `O` of group elements (the `sat` of the cut vocabulary). -/
def satUC (U : Subgroup SL3) (O : Set SL3) : Set SL3 := {h | ∃ u ∈ U, ∃ o ∈ O, u * o = h}

theorem isOpen_satUC {U : Subgroup SL3} {O : Set SL3} (hO : IsOpen O) : IsOpen (satUC U O) :=
  isOpen_sat hO

/-- The projection to the quotient is an open map. -/
theorem isOpenMap_mkX_c : IsOpenMap (mkX : SL3 → X3) := isOpenMap_mkX

/-- The clipped cylinder generator of a raw cell family. -/
def genCut (U : Subgroup SL3) (Q : ℕ → Set X3) (d : ℕ → ℝ) (g : ℕ → SL3)
    (O : ℕ → Set SL3) (k m : ℕ) : Set X3 :=
  mkX '' (satUC U (O m) ∩ liftedC (d k) (g k)) ∩ Q k

/-- The σ-algebra generated by a raw cell family and the clipped cylinders. -/
def MSigCut (U : Subgroup SL3) (Q : ℕ → Set X3) (d : ℕ → ℝ) (g : ℕ → SL3)
    (O : ℕ → Set SL3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom
    (Set.range Q ∪ Set.range (fun p : ℕ × ℕ => genCut U Q d g O p.1 p.2))

/-- The past σ-algebra of a countably generated σ-algebra along `aDiag t` is countably generated.
(The proof is the standard presentation of the iterated pullbacks.) -/
theorem countablyGenerated_pastSigA_c (t : Fin 3 → ℝ) (b : ℕ → Set X3) :
    (⨆ n : ℕ, MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n])
        (MeasurableSpace.generateFrom (Set.range b)))
      = MeasurableSpace.generateFrom
          (Set.range (fun p : ℕ × ℕ => ((fun x : X3 => aDiag t • x)^[p.1]) ⁻¹' (b p.2))) := by
  refine le_antisymm (iSup_le fun n => ?_) ?_
  · rw [MeasurableSpace.comap_generateFrom]
    refine MeasurableSpace.generateFrom_mono ?_
    rintro s ⟨t', ht', rfl⟩
    obtain ⟨m, rfl⟩ := ht'
    exact ⟨(n, m), rfl⟩
  · refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨p, rfl⟩
    exact le_iSup (fun n : ℕ => MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n])
      (MeasurableSpace.generateFrom (Set.range b))) p.1 _
      (MeasurableSpace.measurableSet_comap.mpr
        ⟨b p.2, MeasurableSpace.measurableSet_generateFrom ⟨p.2, rfl⟩, rfl⟩)

/-- **The geometric input.**  `Q` are the cells, `d` their scales, `g` their centres, `O` a
separating countable family of open subsets of `SL3(R)`; `rho` is the uniform entrywise shape
bound; `G` is the conull good set, and `hGopen` is the analytic input (the shape of the atom of
the descending σ-algebra is relatively open at good points). -/
structure CellsData (mu : MeasureTheory.Measure X3) (t : Fin 3 → ℝ) where
  /-- the cells -/
  Q : ℕ → Set X3
  /-- the cell scales -/
  d : ℕ → ℝ
  /-- the cell centres, as lifts -/
  g : ℕ → SL3
  /-- a countable family of open sets separating the left `Uminus t`-cosets -/
  O : ℕ → Set SL3
  /-- the uniform entrywise shape bound -/
  rho : ℝ
  hrho : 0 < rho
  hopen : ∀ k, IsOpen (Q k)
  hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l)
  hcover : mu (⋃ k, Q k)ᶜ = 0
  hdpos : ∀ k, 0 < d k
  hdsmall : ∀ k, d k ≤ 1 / 16
  hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (d k / 2))
  hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * d k) → v₂ ∈ V (4 * d k) →
    v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂
  hOopen : ∀ m, IsOpen (O m)
  hOsep : ∀ z w : SL3, (∀ m, (∃ u ∈ Uminus t, u * z ∈ O m) ↔
      (∃ u ∈ Uminus t, u * w ∈ O m)) → ∃ u ∈ Uminus t, w = u * z
  /-- the good set -/
  G : Set X3
  hGmu : mu Gᶜ = 0
  /-- `G` is measurable for the descending σ-algebra -/
  hGmeas : @MeasurableSet X3 (⨆ n : ℕ, MeasurableSpace.comap
    ((fun y : X3 => aDiag t • y)^[n]) (MSigCut (Uminus t) Q d g O)) G
  /-- `G` is saturated -/
  hGsat : ∀ x ∈ G, atom (⨆ n : ℕ, MeasurableSpace.comap
    ((fun y : X3 => aDiag t • y)^[n]) (MSigCut (Uminus t) Q d g O)) x ⊆ G
  /-- the good points have free `Uminus t`-orbits -/
  hGfree : ∀ y ∈ G, ∀ u ∈ Uminus t, u • y = y → u = 1
  /-- the orbit of a good point stays in the cells -/
  hGcell : ∀ x ∈ G, ∀ n : ℕ, ((fun y : X3 => aDiag t • y)^[n]) x ∈ ⋃ k, Q k
  /-- **the analytic input**: at a good point the shape of the atom of the *descending*
  σ-algebra is relatively open in `Uminus t`.  (This is Pisa 7.31/7.38: the orbit of a.e. point
  is eventually deep inside its cells at the geometric scale; it is stated here in the form the
  assembly consumes, namely as the openness of the shape of the descending atom.) -/
  hGopen : ∀ x ∈ G, ∃ W : Set SL3, IsOpen W ∧
    shape (⨆ n : ℕ, MeasurableSpace.comap ((fun y : X3 => aDiag t • y)^[n])
      (MSigCut (Uminus t) Q d g O)) (Uminus t) x = W ∩ (Uminus t : Set SL3)
  /-- the shape of an atom of `MSigCut` at a good point of a cell is a trace of an open set -/
  hshape_open : ∀ k (y : X3), y ∈ Q k → y ∈ G → ∃ W : Set SL3, IsOpen W ∧
    shape (MSigCut (Uminus t) Q d g O) (Uminus t) y = W ∩ (Uminus t : Set SL3)
  /-- the shape of an atom of `MSigCut` at a good point of a cell is bounded by `Uball rho` -/
  hshape_bound : ∀ k (y : X3), y ∈ Q k → y ∈ G →
    shape (MSigCut (Uminus t) Q d g O) (Uminus t) y ⊆ Work.EKLComp.Uball (Uminus t) rho
  /-- an atom of `MSigCut` at a good point of a cell is contained in that cell -/
  hatom_cell : ∀ k (y : X3), y ∈ Q k → y ∈ G → atom (MSigCut (Uminus t) Q d g O) y ⊆ Q k
  /-- an atom of `MSigCut` at a good point of a cell is contained in the `Uminus t`-orbit -/
  hatom_orb : ∀ k (y : X3), y ∈ Q k → y ∈ G →
    atom (MSigCut (Uminus t) Q d g O) y ⊆ (fun u : SL3 => u • y) '' (Uminus t : Set SL3)

namespace CellsData

variable {mu : MeasureTheory.Measure X3} {t : Fin 3 → ℝ} (D : CellsData mu t)

/-- The enumeration of the generating family of `MSigCut`: the cells and the clipped cylinders. -/
def famSeq : ℕ → Set X3 :=
  fun n => if n.unpair.2 = 0 then D.Q n.unpair.1
    else genCut (Uminus t) D.Q D.d D.g D.O n.unpair.1 (n.unpair.2 - 1)

theorem range_famSeq :
    Set.range D.famSeq = Set.range D.Q ∪
      Set.range (fun p : ℕ × ℕ => genCut (Uminus t) D.Q D.d D.g D.O p.1 p.2) := by
  ext s
  simp only [Set.mem_union, Set.mem_range]
  constructor
  · rintro ⟨n, rfl⟩
    by_cases h : n.unpair.2 = 0
    · exact Or.inl ⟨n.unpair.1, by rw [famSeq, if_pos h]⟩
    · exact Or.inr ⟨(n.unpair.1, n.unpair.2 - 1), by rw [famSeq, if_neg h]⟩
  · rintro (⟨k, rfl⟩ | ⟨⟨k, m⟩, rfl⟩)
    · exact ⟨Nat.pair k 0, by rw [famSeq, if_pos (by simp)]; simp⟩
    · exact ⟨Nat.pair k (m + 1), by rw [famSeq, if_neg (by simp)]; simp⟩

theorem MSigCut_eq : MSigCut (Uminus t) D.Q D.d D.g D.O
    = MeasurableSpace.generateFrom (Set.range D.famSeq) := by
  rw [MSigCut, range_famSeq]

end CellsData

/-- The `MSigCut`-generators are open. -/
theorem isOpen_genCut {mu : MeasureTheory.Measure X3} {t : Fin 3 → ℝ} (D : CellsData mu t)
    (k m : ℕ) : IsOpen (genCut (Uminus t) D.Q D.d D.g D.O k m) := by
  refine IsOpen.inter ?_ (D.hopen k)
  exact isOpenMap_mkX_c _ ((isOpen_satUC (D.hOopen m)).inter
    (isOpen_liftedC (D.d k) (D.g k)))

/-- The cut σ-algebra of a raw cell family is a sub-σ-algebra of the Borel σ-algebra. -/
theorem MSigCut_le_borel_of {U : Subgroup SL3} {Q : ℕ → Set X3} {d : ℕ → ℝ} {g : ℕ → SL3}
    {O : ℕ → Set SL3} (hopen : ∀ k, IsOpen (Q k)) (hOopen : ∀ m, IsOpen (O m)) :
    MSigCut U Q d g O ≤ Work.EKLContract.instMeasurableSpaceX3 := by
  rw [MSigCut]
  refine MeasurableSpace.generateFrom_le ?_
  intro s hs
  show @MeasurableSet X3 Work.EKLContract.instMeasurableSpaceX3 s
  rcases hs with ⟨k, rfl⟩ | ⟨⟨k, m⟩, rfl⟩
  · exact (hopen k).measurableSet
  · refine MeasurableSet.inter ?_ (hopen k).measurableSet
    exact (isOpenMap_mkX_c _ ((isOpen_satUC (hOopen m)).inter
      (isOpen_liftedC (d k) (g k)))).measurableSet

/-- Atoms are antitone in the σ-algebra. -/
theorem atom_mono_cells {m m' : MeasurableSpace X3} (h : m ≤ m') (x : X3) :
    atom m' x ⊆ atom m x := by
  intro y hy
  rw [atom] at hy ⊢
  rintro s ⟨hs, hxs⟩
  exact hy s ⟨h s hs, hxs⟩

/-- **The target from the geometric input.**  From the countable cell data (cells covering a
conull set, with the margin along a.e. orbit) one obtains the descending plaque algebra: on the
conull set `Z = nf(G)` the atoms are bounded open `Uminus t`-plaques with a single entrywise
bound, `Z` is forward invariant and the σ-algebra `A = sup_n comap (phi^n) MSigCut` is
`aDiag t`-decreasing. -/
theorem cellsData_core {mu : MeasureTheory.Measure X3} [MeasureTheory.IsProbabilityMeasure mu]
    {t : Fin 3 → ℝ}
    (hmp : MeasureTheory.MeasurePreserving (fun x : X3 => aDiag t • x) mu mu)
    (D : CellsData mu t) :
    ∃ (A : MeasurableSpace X3) (Z : Set X3) (C : ℝ),
      IsPlaqueAlgebra (Uminus t) Z A ∧ mu Zᶜ = 0 ∧
      MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A ∧
      (∀ x ∈ Z, (fun x : X3 => aDiag t • x) x ∈ Z) ∧
      (∀ x ∈ Z, ∀ u ∈ Uminus t, u • x ∈ atom A x → ∀ i j, |u i j| ≤ C) := by
  classical
  set U : Subgroup SL3 := Uminus t with hUdef
  set M : MeasurableSpace X3 := MSigCut U D.Q D.d D.g D.O with hMdef
  set phi : X3 → X3 := fun y => aDiag t • y with hphidef
  set A : MeasurableSpace X3 := ⨆ n : ℕ, MeasurableSpace.comap (phi^[n]) M with hAdef
  letI : MeasurableSpace X3 := Work.EKLContract.instMeasurableSpaceX3
  -- `M` is a sub-σ-algebra of the Borel one
  have hMle : M ≤ Work.EKLContract.instMeasurableSpaceX3 := by
    rw [hMdef, MSigCut]
    refine MeasurableSpace.generateFrom_le ?_
    intro s hs
    show @MeasurableSet X3 Work.EKLContract.instMeasurableSpaceX3 s
    rcases hs with ⟨k, rfl⟩ | ⟨⟨k, m⟩, rfl⟩
    · exact (D.hopen k).measurableSet
    · exact (isOpen_genCut D k m).measurableSet
  -- `A` is decreasing for the flow
  have hdecA : MeasurableSpace.comap phi A ≤ A := by
    rw [hAdef, MeasurableSpace.comap_iSup]
    refine iSup_le fun n => ?_
    have heq : MeasurableSpace.comap phi (MeasurableSpace.comap (phi^[n]) M)
        = MeasurableSpace.comap (phi^[n + 1]) M := by
      rw [MeasurableSpace.comap_comp, ← Function.iterate_succ]
    rw [heq]
    exact le_iSup (fun n : ℕ => MeasurableSpace.comap (phi^[n]) M) (n + 1)
  have hdecAiter : ∀ n : ℕ, MeasurableSpace.comap (phi^[n]) A ≤ A := by
    intro n
    induction n with
    | zero => exact le_of_eq (by rw [Function.iterate_zero, MeasurableSpace.comap_id])
    | succ m ih =>
      have heq : MeasurableSpace.comap (phi^[m + 1]) A
          = MeasurableSpace.comap phi (MeasurableSpace.comap (phi^[m]) A) := by
        rw [MeasurableSpace.comap_comp, ← Function.iterate_succ]
      rw [heq]
      exact le_trans (MeasurableSpace.comap_mono ih) hdecA
  have hAle : A ≤ Work.EKLContract.instMeasurableSpaceX3 := by
    rw [hAdef]
    refine iSup_le fun n => ?_
    refine le_trans (MeasurableSpace.comap_mono hMle) ?_
    have hcont : Continuous phi := ContinuousConstSMul.continuous_const_smul (aDiag t)
    exact measurable_iff_comap_le.mp (hcont.measurable.iterate n)
  have hMA : M ≤ A := by
    rw [hAdef]
    exact le_trans (le_of_eq (by rw [Function.iterate_zero, MeasurableSpace.comap_id]))
      (le_iSup (fun n : ℕ => MeasurableSpace.comap (phi^[n]) M) 0)
  have hAM : ∀ x : X3, atom A x ⊆ atom M x := fun x => atom_mono_cells hMA x
  -- `A` is countably generated
  have hAcg : ∃ b : Set (Set X3), b.Countable ∧ A = MeasurableSpace.generateFrom b := by
    refine ⟨Set.range (fun p : ℕ × ℕ => (phi^[p.1]) ⁻¹' (D.famSeq p.2)), Set.countable_range _, ?_⟩
    rw [hAdef, hMdef, D.MSigCut_eq, hphidef]
    exact countablyGenerated_pastSigA_c t D.famSeq
  -- the atom relation is preserved by `phi`
  have hpres : ∀ u : X3, ∀ y ∈ atom A u, phi y ∈ atom A (phi u) := by
    intro u y hy
    rw [atom, Set.mem_sInter] at hy ⊢
    rintro s ⟨hs, hus⟩
    exact hy (phi ⁻¹' s) ⟨hdecA (phi ⁻¹' s)
      (MeasurableSpace.measurableSet_comap.mpr ⟨s, hs, rfl⟩), hus⟩
  have hpresN : ∀ k : ℕ, ∀ u : X3, ∀ y ∈ atom A u, (phi^[k]) y ∈ atom A ((phi^[k]) u) := by
    intro k
    induction k with
    | zero => intro u y hy; simpa using hy
    | succ m ih =>
      intro u y hy
      have h1 : phi y ∈ atom A (phi u) := hpres u y hy
      have h2 : (phi^[m]) (phi y) ∈ atom A ((phi^[m]) (phi u)) := ih (phi u) (phi y) h1
      simpa [Function.iterate_succ_apply] using h2
  -- the good set
  set Z0 : Set X3 := Set.iUnion (fun k : ℕ => D.Q k ∩ D.G) with hZ0def
  have hZ0c : mu Z0ᶜ = 0 := by
    have hsub : Z0ᶜ ⊆ (Set.iUnion (fun k : ℕ => D.Q k))ᶜ ∪ D.Gᶜ := by
      intro x hx
      rw [Set.mem_compl_iff] at hx
      by_cases hxG : x ∈ D.G
      · refine Or.inl ?_
        rw [Set.mem_compl_iff]
        intro hxu
        obtain ⟨k, hk⟩ := Set.mem_iUnion.mp hxu
        exact hx (Set.mem_iUnion.mpr ⟨k, hk, hxG⟩)
      · exact Or.inr (by simpa using hxG)
    refine le_antisymm ?_ bot_le
    calc mu Z0ᶜ ≤ mu ((Set.iUnion (fun k : ℕ => D.Q k))ᶜ ∪ D.Gᶜ) := measure_mono hsub
      _ ≤ mu (Set.iUnion (fun k : ℕ => D.Q k))ᶜ + mu D.Gᶜ := measure_union_le _ _
      _ = 0 := by
          rw [show mu (Set.iUnion (fun k : ℕ => D.Q k))ᶜ = 0 from D.hcover,
            show mu D.Gᶜ = 0 from D.hGmu, add_zero]
  have hZ0meas : @MeasurableSet X3 A Z0 := by
    refine MeasurableSet.iUnion (fun k => ?_)
    refine MeasurableSet.inter ?_ ?_
    · exact MeasurableSpace.le_def.mp hMA _ (by
        rw [hMdef]
        exact MeasurableSpace.measurableSet_generateFrom (Or.inl ⟨k, rfl⟩))
    · rw [hAdef]; exact D.hGmeas
  have hZ0sat : ∀ x ∈ Z0, atom A x ⊆ Z0 := by
    intro x hx y hy
    obtain ⟨k, hxQ, hxG⟩ := Set.mem_iUnion.mp hx
    exact Set.mem_iUnion.mpr ⟨k, D.hatom_cell k x hxQ hxG (hAM x hy), D.hGsat x hxG hy⟩
  -- the forward invariant hull
  refine ⟨A, Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0), 1 + D.rho, ?_, ?_, hdecA, ?_, ?_⟩
  · -- `IsPlaqueAlgebra`
    have hZmeas : @MeasurableSet X3 A (Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0)) := by
      refine MeasurableSet.iInter (fun n => ?_)
      exact hdecAiter n _ (MeasurableSpace.measurableSet_comap.mpr ⟨Z0, hZ0meas, rfl⟩)
    have hZsat : ∀ x ∈ Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0),
        atom A x ⊆ Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0) := by
      intro x hx y hy
      rw [Set.mem_iInter]
      rw [Set.mem_iInter] at hx
      intro n
      exact hZ0sat _ (hx n) (hpresN n x y hy)
    refine ⟨hAle, hAcg, hZmeas, ?_⟩
    intro x hx
    have hx' : ∀ n : ℕ, (phi^[n]) x ∈ Z0 := by
      rw [Set.mem_iInter] at hx
      exact hx
    have hxZ0 : x ∈ Z0 := by simpa [Function.iterate_zero_apply] using hx' 0
    obtain ⟨k, hxQ, hxG⟩ := Set.mem_iUnion.mp hxZ0
    have hshape_open : ∃ W : Set SL3, IsOpen W ∧ shape A U x = W ∩ (U : Set SL3) := by
      rw [hAdef]
      exact D.hGopen x hxG
    refine ⟨hZsat x (by rw [Set.mem_iInter]; exact hx'), ?_, hshape_open, ?_⟩
    · -- `atom A x` is contained in the `U`-orbit
      intro z hz
      exact D.hatom_orb k x hxQ hxG (hAM x hz)
    · -- entrywise bounded
      refine ⟨1 + D.rho, fun u hu i j => ?_⟩
      have huA : u ∈ U ∧ u • x ∈ atom A x := hu
      have hu' : u ∈ shape M U x := ⟨huA.1, hAM x huA.2⟩
      have h1 : |(u : Matrix (Fin 3) (Fin 3) ℝ) i j
          - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < D.rho :=
        (D.hshape_bound k x hxQ hxG hu').2 i j
      have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
        rw [Matrix.one_apply]; split <;> simp
      calc |(u : Matrix (Fin 3) (Fin 3) ℝ) i j|
          = |((u : Matrix (Fin 3) (Fin 3) ℝ) i j
              - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
              + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by rw [sub_add_cancel]
        _ ≤ |((u : Matrix (Fin 3) (Fin 3) ℝ) i j
              - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)|
              + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
        _ ≤ D.rho + 1 := by linarith
        _ = 1 + D.rho := by ring
  · -- `mu Zᶜ = 0`
    have hsub : (Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0))ᶜ
        ⊆ Set.iUnion (fun n : ℕ => (phi^[n]) ⁻¹' Z0ᶜ) := by
      intro x hx
      rw [Set.mem_compl_iff] at hx
      have hx'' : ¬ ∀ n : ℕ, (phi^[n]) x ∈ Z0 :=
        fun h => hx (by rw [Set.mem_iInter]; exact h)
      obtain ⟨n, hn⟩ := not_forall.mp hx''
      exact Set.mem_iUnion.mpr ⟨n, by simpa using hn⟩
    have h0 : ∀ n : ℕ, mu ((phi^[n]) ⁻¹' Z0ᶜ) = 0 := fun n => by
      have h := (hmp.iterate n).preimage_null hZ0c
      rwa [show (fun x : X3 => aDiag t • x)^[n] = phi^[n] from by rw [hphidef]] at h
    refine le_antisymm ?_ bot_le
    calc mu (Set.iInter (fun n : ℕ => (phi^[n]) ⁻¹' Z0))ᶜ
        ≤ mu (Set.iUnion (fun n : ℕ => (phi^[n]) ⁻¹' Z0ᶜ)) := measure_mono hsub
      _ ≤ ∑' n : ℕ, mu ((phi^[n]) ⁻¹' Z0ᶜ) := measure_iUnion_le _
      _ = 0 := by
          have hle : (∑' n : ℕ, mu ((phi^[n]) ⁻¹' Z0ᶜ)) ≤ ∑' n : ℕ, (0 : ℝ≥0∞) :=
            ENNReal.tsum_le_tsum (fun n => le_of_eq (h0 n))
          have hz : (∑' n : ℕ, (0 : ℝ≥0∞)) = 0 := tsum_zero
          rw [hz] at hle
          exact le_antisymm hle bot_le
  · -- forward invariance
    intro x hx
    have hx' : ∀ n : ℕ, (phi^[n]) x ∈ Z0 := by
      rw [Set.mem_iInter] at hx
      exact hx
    rw [Set.mem_iInter]
    intro n
    have h1 : (phi^[n + 1]) x ∈ Z0 := hx' (n + 1)
    simpa [Function.iterate_succ_apply] using h1
  · -- the uniform entrywise bound
    intro x hx u hu hux i j
    have hx' : ∀ n : ℕ, (phi^[n]) x ∈ Z0 := by
      rw [Set.mem_iInter] at hx
      exact hx
    have hxZ0 : x ∈ Z0 := by simpa [Function.iterate_zero_apply] using hx' 0
    obtain ⟨k, hxQ, hxG⟩ := Set.mem_iUnion.mp hxZ0
    have huA : u ∈ U ∧ u • x ∈ atom A x := ⟨hu, hux⟩
    have hu' : u ∈ shape M U x := ⟨huA.1, hAM x huA.2⟩
    have h1 : |(u : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < D.rho :=
      (D.hshape_bound k x hxQ hxG hu').2 i j
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    calc |(u : Matrix (Fin 3) (Fin 3) ℝ) i j|
        = |((u : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)
            + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by rw [sub_add_cancel]
      _ ≤ |((u : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j)|
            + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
      _ ≤ D.rho + 1 := by linarith
      _ = 1 + D.rho := by ring

end Work.EKLC6Core
