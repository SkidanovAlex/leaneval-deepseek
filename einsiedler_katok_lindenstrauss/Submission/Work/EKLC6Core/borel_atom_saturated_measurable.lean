import Mathlib
import Submission.Work.EKLContract.Defs
import Submission.Work.EKLComp.LeafDefs

/-!
# `Work.EKLC6Core.borel_atom_saturated_measurable`

Let `m` be a countably generated sub-`σ`-algebra of the Borel `σ`-algebra of
`X₃ = SL₃(ℝ)/SL₃(ℤ)`.  Then every Borel set `s ⊆ X₃` that is a *union of `m`-atoms* is
`m`-measurable.  (This is the standard "the atoms of a countably generated `σ`-algebra are the
measurable sets of the quotient of a standard Borel space" fact; it is used to convert the
Borel sets occurring in the plaque/flower constructions of Pisa §6–7 into `m`-measurable ones.)

## Proof

Choose a generating sequence `b : ℕ → Set X₃` of `m` (so `m = σ(b)`), and let

`f x := (fun n ↦ decide (x ∈ b n)) : ℕ → Bool`

be the associated *pattern map* into the Cantor space `ℕ → Bool`.  Since `m` is countably
generated, the `m`-atom of `x` is exactly the fibre `f ⁻¹' {f x}`
(`mem_atom_generateFrom_range_iff`); hence the saturation hypothesis

`∀ x ∈ s, atom m x ⊆ s`

says precisely "`f y = f x` and `x ∈ s` imply `y ∈ s`", so that `f '' s` and `f '' sᶜ`
are disjoint.

Both `f '' s` and `f '' sᶜ` are images of Borel sets under the Borel map `f` from the standard
Borel space `X₃`, hence **analytic** (`MeasurableSet.analyticSet_image`).  By the **Lusin
separation theorem** (`AnalyticSet.measurablySeparable`) two disjoint analytic sets are
contained in disjoint Borel sets, so there is a Borel `u` with `f '' s ⊆ u` and
`u ∩ f '' sᶜ = ∅`; together these give `s = f ⁻¹' u`.  Finally `f` is `m`-measurable, so
`f ⁻¹' u` — and therefore `s` — is `m`-measurable.
-/

open MeasureTheory Set

-- the two `letI`/`haveI` below are instances, not data
set_option linter.style.haveILetI false

namespace Work.EKLC6Core

open Work.EKLContract

/-- **Atoms of a `σ`-algebra generated by a countable family.**  If `m = σ(b)` for a sequence
`b : ℕ → Set X₃`, then the atom of `x` is the set of points having the same "membership pattern"
in the family `b` as `x` does. -/
lemma mem_atom_generateFrom_range_iff {b : ℕ → Set X3} (x y : X3) :
    y ∈ atom (MeasurableSpace.generateFrom (Set.range b)) x ↔ ∀ n, (y ∈ b n ↔ x ∈ b n) := by
  classical
  have hmem : ∀ n, MeasurableSet[MeasurableSpace.generateFrom (Set.range b)] (b n) :=
    fun n => MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  constructor
  · intro hy n
    refine ⟨fun hyn => ?_, fun hxn => ?_⟩
    · by_contra hxn
      exact (Set.mem_sInter.mp hy _ ⟨(hmem n).compl, hxn⟩) hyn
    · exact Set.mem_sInter.mp hy _ ⟨hmem n, hxn⟩
  · intro h
    refine Set.mem_sInter.mpr ?_
    rintro t ⟨ht, hxt⟩
    have key : x ∈ t ↔ y ∈ t :=
      MeasurableSpace.generateFrom_induction (Set.range b) (fun t _ => x ∈ t ↔ y ∈ t)
        (fun t ht' _ => by
          rcases ht' with ⟨n, rfl⟩
          exact (h n).symm)
        (by simp)
        (fun t _ ht' => ht'.not)
        (fun g _ hg => by
          simp only [Set.mem_iUnion]
          exact exists_congr hg)
        t ht
    exact key.mp hxt

/-- **Separating the fibres of a Borel map** (Lusin separation, in the form used here).

Let `f : X → Z` be a Borel map from a standard Borel space to a second countable Hausdorff
space, and let `s ⊆ X` be Borel and *saturated in the fibres of `f`* (if `x ∈ s` and `f y = f x`
then `y ∈ s`).  Then `s` is the preimage of a Borel set of `Z`.

Indeed `f '' s` and `f '' sᶜ` are disjoint analytic sets, hence contained in disjoint Borel
sets by the Lusin separation theorem. -/
theorem exists_measurableSet_eq_preimage_of_fiber_saturated {X Z : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] [TopologicalSpace Z] [MeasurableSpace Z] [OpensMeasurableSpace Z]
    [T2Space Z] [SecondCountableTopology Z] {f : X → Z} (hf : Measurable f) {s : Set X}
    (hs : MeasurableSet s) (hsat : ∀ x ∈ s, ∀ y, f y = f x → y ∈ s) :
    ∃ u : Set Z, MeasurableSet u ∧ s = f ⁻¹' u := by
  have h1 : AnalyticSet (f '' s) := hs.analyticSet_image hf
  have h2 : AnalyticSet (f '' sᶜ) := hs.compl.analyticSet_image hf
  have hdj : Disjoint (f '' s) (f '' sᶜ) := by
    rw [Set.disjoint_left]
    rintro z ⟨x, hx, hfx⟩ ⟨y, hy, hfy⟩
    exact hy (hsat x hx y (by rw [hfy, hfx]))
  obtain ⟨u, hsu, hdu, hmu⟩ := h1.measurablySeparable h2 hdj
  refine ⟨u, hmu, ?_⟩
  ext x
  constructor
  · intro hx
    exact hsu ⟨x, hx, rfl⟩
  · intro hx
    by_contra hxs
    exact (Set.disjoint_left.mp hdu) ⟨x, hxs, rfl⟩ hx

theorem borel_atom_saturated_measurable {m : MeasurableSpace Work.EKLContract.X3}
    (hm : m ≤ borel Work.EKLContract.X3)
    (hgen : @MeasurableSpace.CountablyGenerated Work.EKLContract.X3 m)
    {s : Set Work.EKLContract.X3}
    (hs : @MeasurableSet Work.EKLContract.X3 (borel Work.EKLContract.X3) s)
    (hsat : ∀ x ∈ s, Work.EKLContract.atom m x ⊆ s) :
    @MeasurableSet Work.EKLContract.X3 m s := by
  classical
  -- work with `m` as the ambient measurable structure
  letI : MeasurableSpace X3 := m
  haveI : MeasurableSpace.CountablyGenerated X3 := hgen
  -- a generating sequence of `m`
  let b : ℕ → Set X3 := MeasurableSpace.natGeneratingSequence X3
  have hbgen : MeasurableSpace.generateFrom (Set.range b) = m :=
    MeasurableSpace.generateFrom_natGeneratingSequence X3
  have hbmeas : ∀ n, MeasurableSet[m] (b n) := fun n =>
    MeasurableSpace.measurableSet_natGeneratingSequence n
  -- the pattern map
  let f : X3 → (ℕ → Bool) := fun x n => decide (x ∈ b n)
  have hf : Measurable f := by
    rw [measurable_pi_iff]
    intro n
    refine measurable_to_bool ?_
    have h1 : (fun x : X3 => decide (x ∈ b n)) ⁻¹' {true} = b n := by
      ext x; simp [decide_eq_true_eq]
    rw [h1]
    exact hbmeas n
  -- `f` is Borel as well (`m ≤ borel X₃`)
  have hf_borel : @Measurable X3 (ℕ → Bool) (borel X3) _ f := hf.mono hm le_rfl
  -- the atoms of `m` are the fibres of `f`
  have hfib : ∀ x y : X3, y ∈ atom m x ↔ f y = f x := by
    intro x y
    rw [← hbgen, mem_atom_generateFrom_range_iff]
    constructor
    · intro h
      funext n
      exact decide_eq_decide.mpr (h n)
    · intro h n
      exact decide_eq_decide.mp (congr_fun h n)
  -- saturation of `s` in the fibres of `f`
  have hsat' : ∀ x ∈ s, ∀ y, f y = f x → y ∈ s := fun x hx y hy =>
    hsat x hx ((hfib x y).mpr hy)
  -- separate `f '' s` from `f '' sᶜ` in the Borel structure of `X₃`
  obtain ⟨u, hmu, hsu⟩ : ∃ u : Set (ℕ → Bool), MeasurableSet u ∧ s = f ⁻¹' u :=
    @exists_measurableSet_eq_preimage_of_fiber_saturated X3 (ℕ → Bool) (borel X3) _ _ _ _ _ _
      f hf_borel s hs hsat'
  rw [hsu]
  exact hf hmu

end Work.EKLC6Core
