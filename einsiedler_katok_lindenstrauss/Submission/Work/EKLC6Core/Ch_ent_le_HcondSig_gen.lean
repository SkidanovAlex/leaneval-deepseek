/-!
# `Work.EKLC6Core.Ch_ent_le_HcondSig_gen`

Pisa 7.40 / 7.6(ii) (equality case): for a probability `μ` on `X₃ = SL₃(ℝ)/SL₃(ℤ)` preserved by
`T = (aDiag t ·)`, a `μ`-conull descending plaque algebra `A` for `Uminus t` whose backward
iterates generate the Borel σ-algebra, the Kolmogorov–Sinai entropy of `T` is at most the
conditional entropy of `A` given `comap T A`.

## What is in this file

* `Ch_genM`, `Ch_HcondSig_mono_left`, `Ch_FinPart_n_ne_zero`, `Ch_Refines_of_partSigma_le'`,
  `Ch_hPart_le_of_partSigma_le` — elementary bookkeeping (`HcondSig` is monotone in its first
  σ-algebra, `hPart` is monotone under refinement, `partSigma` inclusions give `Refines`).
* `Ch_growthFun_uminus_nonneg`, `Ch_GeoData`, `ent_le_HcondSig_of_genData_modMu`,
  `Ch_ent_le_HcondSig_gen_of_geoData` — **the mod-`μ` countable-generator route** (Pisa 7.6(ii)
  equality in the countable form), proved here, axiom-clean and independent of the rest of the
  tree.  `ent_le_HcondSig_of_genData_modMu` reduces the target to a countable Borel family `P`
  which generates modulo `μ` (`GeneratesModMuSet`) and has finite entropy
  (`HcondSig μ (σ P) ⊥ ≠ ⊤`); `Ch_ent_le_HcondSig_gen_of_geoData` then closes the target from
  the geometric data `Ch_GeoData μ t` (= Pisa 7.43 in the mod-`μ` form) using
  `HcondSig_eq_growth_along` twice to compare with the *given* plaque algebra `A`.
  The ergodic case of that route (prepared, see `_erg_helper_draft.txt`) additionally uses
  `Ch_countable_partition_plaque_finiteEnt_erg` and `Ch_HcondSig_le_tsum_negMulLog`.
* the target itself.

## The two routes and their status

1. *This file's route* (`Ch_GeoData`) needs, besides the target's hypotheses, a countably
   generated `T`-decreasing plaque algebra whose backward iterates generate the Borel σ-algebra
   and, crucially, a countable partition `P` with `GeneratesModMuSet μ t P` and
   `HcondSig μ (σ P) ⊥ ≠ ⊤`.  Without an ergodicity/aperiodicity hypothesis this is **false**:
   if `T` is the identity (or a.e. periodic) on a positive-measure splitting (e.g. atomless) set,
   then `biOrbit t P` has every atom of `P` saturated on that set, so no countable `P` satisfies
   `GeneratesModMuSet` (`Submission/Work/EKLC6Core/_refute_Ch_countable_partition_plaque_modMu.lean`,
   machine-checked).  Hence `Ch_GeoData` is only usable together with `IsAErgodic μ` and
   `0 < ent μ T`; this is what `Ch_ent_le_HcondSig_gen_erg` does, using
   `Ch_countable_partition_plaque_finiteEnt_erg` (Pisa 7.43 + 7.50 in the ergodic case) and
   `Ch_HcondSig_le_tsum_negMulLog`.  The non-ergodic case is *not* covered by this route (the
   a.e. periodic part cannot be split by a countable partition, while the target is still true
   there because both sides contribute zero).
2. *The tree's route* (`Work.EKLC6Core.ent_le_HcondSig_of_gen`, whose statement is this one) goes
   through `ent μ T ≤ ofReal (∫ growthFun) ≤ ∫⁻ ofReal (atomInfo A …) = HcondSig μ A (comap T A)`;
   that is the proof used below for the target.  Its single remaining gap is the finite-partition
   geometric input `Work.EKLC6Core.exists_finPart_plaquePast_generating`
   (`hasPlaquePartition` ⟵ `ent_le_growth_of_aerg` ⟵ …).

The target is therefore proved here modulo that one input, and would become `sorry`-free
automatically as soon as it is discharged.
-/

open MeasureTheory Filter Topology
open scoped ENNReal

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

set_option linter.unusedVariables false

/-- The σ-algebra generated by a countable family, top-level so that it is not captured by
instance search. -/
def Ch_genM (P : ℕ → Set Work.EKLContract.X3) : MeasurableSpace Work.EKLContract.X3 :=
  MeasurableSpace.generateFrom (Set.range P)

/-- `HcondSig μ · C` is monotone in the first σ-algebra. -/
theorem Ch_HcondSig_mono_left {X : Type*} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X)
    [MeasureTheory.IsProbabilityMeasure μ] (A B C : MeasurableSpace X) (h : A ≤ B) :
    @HcondSig X mX μ A C ≤ @HcondSig X mX μ B C := by
  refine iSup_le fun P => ?_
  exact le_iSup (fun Q : {Q : @FinPart X mX // @partSigma X mX Q ≤ B} =>
    ENNReal.ofReal (@Hcond X mX μ Q.1 C)) ⟨P.1, le_trans P.2 h⟩

/-- A finite partition of a space carrying a probability measure has at least one part. -/
theorem Ch_FinPart_n_ne_zero {X : Type*} [mX : MeasurableSpace X] (μ : MeasureTheory.Measure X)
    [MeasureTheory.IsProbabilityMeasure μ] (P : @FinPart X mX) : P.n ≠ 0 := by
  intro h0
  have hemp : (⋃ i : Fin P.n, P.parts i) = (∅ : Set X) := by
    ext y
    constructor
    · intro hy
      obtain ⟨i, _⟩ := Set.mem_iUnion.mp hy
      exact Fin.elim0 (Fin.cast h0 i)
    · intro hy; exact absurd hy (Set.notMem_empty y)
  have huniv : (Set.univ : Set X) = (∅ : Set X) := by rw [← P.cover, hemp]
  have h1 : μ (Set.univ : Set X) = 1 := measure_univ
  rw [huniv, measure_empty] at h1
  exact one_ne_zero h1.symm

/-- `Refines Q P` (Q finer than P) from `partSigma P ≤ partSigma Q`. -/
theorem Ch_Refines_of_partSigma_le' {P Q : Work.EKLContract.FinPart Work.EKLContract.X3}
    (hQne : Q.n ≠ 0) (h : Work.EKLContract.partSigma Q ≤ Work.EKLContract.partSigma P) :
    Work.EKLContract.Refines P Q := by
  intro i
  by_cases hne : (P.parts i).Nonempty
  · obtain ⟨x, hx⟩ := hne
    have hxQ : x ∈ ⋃ j, Q.parts j := by rw [Q.cover]; exact Set.mem_univ x
    obtain ⟨j, hj⟩ := Set.mem_iUnion.mp hxQ
    refine ⟨j, ?_⟩
    have hSmeas : (Work.EKLContract.partSigma P).MeasurableSet' (P.parts i ∩ Q.parts j) :=
      (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self i)).inter
        ((MeasurableSpace.le_def.mp h) _ (MeasurableSpace.measurableSet_generateFrom
          (Set.mem_range_self j)))
    obtain ⟨J, hJ⟩ :=
      (@Work.EKLComp.partSigma_eq_unions_atoms Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P (P.parts i ∩ Q.parts j)).mp hSmeas
    have hiJ : i ∈ J := by
      have hx' : x ∈ ⋃ j' ∈ J, P.parts j' := by rw [← hJ]; exact ⟨hx, hj⟩
      obtain ⟨j', hj'J, hxj'⟩ := Set.mem_iUnion₂.mp hx'
      have hji : j' = i := by
        by_contra hne'
        exact Set.disjoint_left.mp (P.disjoint hne') hxj' hx
      rwa [hji] at hj'J
    intro y hy
    have hy' : y ∈ ⋃ j' ∈ J, P.parts j' := Set.mem_iUnion₂.mpr ⟨i, hiJ, hy⟩
    rw [← hJ] at hy'
    exact hy'.2
  · exact ⟨⟨0, Nat.pos_of_ne_zero hQne⟩, fun y hy => absurd ⟨y, hy⟩ hne⟩

/-- `hPart` is monotone under refinement of the partition, in the `partSigma` form. -/
theorem Ch_hPart_le_of_partSigma_le {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {P Q : Work.EKLContract.FinPart Work.EKLContract.X3}
    (h : Work.EKLContract.partSigma P ≤ Work.EKLContract.partSigma Q) :
    Work.EKLContract.hPart μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) P
      ≤ Work.EKLContract.hPart μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) Q :=
  Work.EKLComp.hPart_le_of_refines' μ hmp.measurable
    (Ch_Refines_of_partSigma_le' (P := Q) (Q := P) (hQne := Ch_FinPart_n_ne_zero μ P) h)


/-! ## The assembly -/

/-- **Pisa 7.6(ii) equality case, countable-generator form (modulo `μ`).**

Let `T = (aDiag t ·)`. Given a countable Borel family `P` which generates the Borel σ-algebra
modulo `μ` (in the bi-infinite sense of `GeneratesModMuSet`) with `HcondSig μ (σ P) ⊥ ≠ ⊤`, the
entropy of `T` is at most the conditional entropy of the past σ-algebra of `P` given its image
under `T`. -/
theorem ent_le_HcondSig_of_genData_modMu {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    (P : ℕ → Set Work.EKLContract.X3) (hPmeas : ∀ n, MeasurableSet (P n))
    (hgen : GeneratesModMuSet μ t P)
    (hfin : @Work.EKLC6Core.HcondSig Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 μ
      (Ch_genM P)
      (⊥ : MeasurableSpace Work.EKLContract.X3) ≠ ⊤) :
    Work.EKLContract.ent μ (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ
          (pastSigSet t P)
          (MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
            (pastSigSet t P)) := by
  let T : Work.EKLContract.X3 → Work.EKLContract.X3 := fun x => Work.EKLContract.aDiag t • x
  have hMle : Ch_genM P ≤ Work.EKLContract.instMeasurableSpaceX3 :=
    MeasurableSpace.generateFrom_le fun s hs => by
      obtain ⟨n, rfl⟩ := hs; exact hPmeas n
  have hT : Measurable T := (continuous_const_smul (Work.EKLContract.aDiag t)).measurable
  obtain ⟨F, hF1, hF2, hF3⟩ :=
    Work.EKLGen.exists_finPart_chain_of_generating (X := Work.EKLContract.X3) P hPmeas
  have hF1' : ∀ l, @Work.EKLContract.partSigma Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 (F l) ≤ Ch_genM P := hF1
  have hF3' : (⨆ l, @Work.EKLContract.partSigma Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 (F l)) = Ch_genM P := hF3
  have hFmono : ∀ i j : ℕ, i ≤ j → @Work.EKLContract.partSigma Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 (F i)
      ≤ @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F j) := by
    intro i j hij
    exact Nat.le_induction le_rfl (fun n _ ih => le_trans ih (hF2 n)) j hij
  have hent : Work.EKLContract.ent μ T
      ≤ ⨆ l, ENNReal.ofReal (Work.EKLContract.hPart μ T (F l)) :=
    Ch_ent_le_iSup_hPart_of_modMu_gen (μ := μ) t hmp P hPmeas hgen F hF1 hF2 hF3
  have hab : ∀ l, ENNReal.ofReal (Work.EKLContract.hPart μ T (F l))
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
          (MeasurableSpace.comap T (pastSigFinPart t (F l))) := by
    intro l
    have hpart : Work.EKLContract.hPart μ T (F l)
        = Work.EKLContract.Hcond μ (F l)
            (MeasurableSpace.comap T (pastSigFinPart t (F l))) := by
      rw [Work.EKLComp.hPart_Hcond (mX := Work.EKLContract.instMeasurableSpaceX3) μ T hT
        hmp (F l)]
      congr 1
      exact (comap_pastFinPart_eq t (F l)).symm
    rw [hpart]
    exact le_iSup (fun Q : {Q : @Work.EKLContract.FinPart Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 //
        @Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 Q ≤ Ch_genM P} =>
      ENNReal.ofReal (Work.EKLContract.Hcond μ Q.1
        (MeasurableSpace.comap T (pastSigFinPart t (F l))))) ⟨F l, hF1' l⟩
  have ha_mono : Monotone (fun l => ENNReal.ofReal (Work.EKLContract.hPart μ T (F l))) :=
    fun i j hij => ENNReal.ofReal_le_ofReal
      (Ch_hPart_le_of_partSigma_le (μ := μ) t hmp (hFmono i j hij))
  have hb_mono : Antitone (fun l => @Work.EKLC6Core.HcondSig Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
      (MeasurableSpace.comap T (pastSigFinPart t (F l)))) :=
    fun i j hij => Ch_HcondSig_antitone_cond (mX := Work.EKLContract.instMeasurableSpaceX3)
      (M := Ch_genM P) μ (MeasurableSpace.comap_mono (comap_past_le_of_le t (hFmono i j hij)))
  have hsup_le : (⨆ l, ENNReal.ofReal (Work.EKLContract.hPart μ T (F l)))
      ≤ ⨅ l, @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
          (MeasurableSpace.comap T (pastSigFinPart t (F l))) := by
    refine iSup_le fun l => le_iInf fun l' => ?_
    exact le_trans (le_trans (ha_mono (le_max_left l l')) (hab (l ⊔ l')))
      (hb_mono (le_max_right l l'))
  have hCmono : Monotone (fun l => MeasurableSpace.comap T (pastSigFinPart t (F l))) :=
    fun i j hij => MeasurableSpace.comap_mono (comap_past_le_of_le t (hFmono i j hij))
  have hCle : ∀ l, MeasurableSpace.comap T (pastSigFinPart t (F l))
      ≤ Work.EKLContract.instMeasurableSpaceX3 := fun l =>
    le_trans (MeasurableSpace.comap_mono (pastSigFinPart_le t (F l))) hT.comap_le
  have hpast_le : ∀ l, pastSigFinPart t (F l) ≤ pastSigSet t P := by
    intro l
    rw [pastSigFinPart, pastSigSet]
    refine iSup_le fun n => ?_
    exact le_trans (MeasurableSpace.comap_mono (hF1' l))
      (le_iSup (fun m : ℕ => MeasurableSpace.comap (T^[m])
        (MeasurableSpace.generateFrom (Set.range P))) n)
  have hpast_sup : (⨆ l, pastSigFinPart t (F l)) = pastSigSet t P := by
    refine le_antisymm (iSup_le hpast_le) ?_
    rw [pastSigSet]
    refine iSup_le fun n => ?_
    have hsig : MeasurableSpace.generateFrom (Set.range P)
        = (⨆ l, (@Work.EKLContract.partSigma Work.EKLContract.X3
            Work.EKLContract.instMeasurableSpaceX3 (F l))) := hF3'.symm
    rw [hsig, MeasurableSpace.comap_iSup]
    refine iSup_le fun l => ?_
    exact le_trans (le_iSup (fun m : ℕ => MeasurableSpace.comap (T^[m])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F l))) n)
      (le_iSup (fun l : ℕ => pastSigFinPart t (F l)) l)
  have hCsup : (⨆ l, MeasurableSpace.comap T (pastSigFinPart t (F l)))
      = MeasurableSpace.comap T (pastSigSet t P) := by
    rw [← MeasurableSpace.comap_iSup, hpast_sup]
  have hfin' : @Work.EKLC6Core.HcondSig Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
      (MeasurableSpace.comap T (pastSigFinPart t (F 0))) ≠ ⊤ :=
    ne_top_of_le_ne_top hfin
      (Ch_HcondSig_antitone_cond (mX := Work.EKLContract.instMeasurableSpaceX3)
        (M := Ch_genM P) μ (bot_le :
          (⊥ : MeasurableSpace Work.EKLContract.X3)
            ≤ MeasurableSpace.comap T (pastSigFinPart t (F 0))))
  have hlevy : (⨅ l, @Work.EKLC6Core.HcondSig Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
        (MeasurableSpace.comap T (pastSigFinPart t (F l))))
      = @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
          (MeasurableSpace.comap T (pastSigSet t P)) := by
    rw [← hCsup]
    exact Ch_HcondSig_iInf_sigma (mX := Work.EKLContract.instMeasurableSpaceX3) μ (Ch_genM P)
      ⟨Set.range P, Set.countable_range P, rfl⟩ hMle
      (fun l => MeasurableSpace.comap T (pastSigFinPart t (F l))) hCmono hCle hfin'
  have hMpast : Ch_genM P ≤ pastSigSet t P := by
    have h0 : MeasurableSpace.comap (T^[0]) (MeasurableSpace.generateFrom (Set.range P))
        = Ch_genM P := by
      rw [Function.iterate_zero, MeasurableSpace.comap_id]
      rfl
    rw [pastSigSet]
    exact le_trans (le_of_eq h0.symm) (le_iSup (fun n : ℕ => MeasurableSpace.comap (T^[n])
      (MeasurableSpace.generateFrom (Set.range P))) 0)
  calc Work.EKLContract.ent μ T
      ≤ ⨆ l, ENNReal.ofReal (Work.EKLContract.hPart μ T (F l)) := hent
    _ ≤ ⨅ l, @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
          (MeasurableSpace.comap T (pastSigFinPart t (F l))) := hsup_le
    _ = @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (Ch_genM P)
          (MeasurableSpace.comap T (pastSigSet t P)) := hlevy
    _ ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ (pastSigSet t P)
          (MeasurableSpace.comap T (pastSigSet t P)) :=
        Ch_HcondSig_mono_left (X := Work.EKLContract.X3)
          (mX := Work.EKLContract.instMeasurableSpaceX3) μ (Ch_genM P)
          (pastSigSet t P) (MeasurableSpace.comap T (pastSigSet t P)) hMpast

/-! ## The geometric core as a predicate -/

/-- **The geometric core of Pisa 7.43** (mod-`μ` form, no ergodicity hypothesis): a countable
partition `P` with finite entropy, whose past σ-algebra is a plaque algebra for `Uminus t` on a
`μ`-conull set, and which is a generator for `aDiag t ·` modulo `μ`. -/
def Ch_GeoData (μ : MeasureTheory.Measure Work.EKLContract.X3) (t : Fin 3 → ℝ) : Prop :=
  ∃ (P : ℕ → Set Work.EKLContract.X3) (Z : Set Work.EKLContract.X3),
    (∀ n : ℕ, MeasurableSet (P n)) ∧
    (∀ m n : ℕ, m ≠ n → Disjoint (P m) (P n)) ∧
    μ (⋃ n, P n)ᶜ = 0 ∧
    μ Zᶜ = 0 ∧
    GeneratesModMuSet μ t P ∧
    Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z (pastSigSet t P) ∧
    (@Work.EKLC6Core.HcondSig Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
      (MeasurableSpace.generateFrom (Set.range P))
      (⊥ : MeasurableSpace Work.EKLContract.X3) ≠ ⊤)

/-- On the conull domain of a leaf-wise system for `Uminus t`, the contracted box
`conjBox (Uminus t) t` is contained in the normalising box `Box1 (Uminus t)`, whose `ν x`-mass
is `1`; hence `growthFun (Uminus t) ν t` is non-negative almost everywhere. -/
theorem Ch_growthFun_uminus_nonneg {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3}
    (hL : Work.EKLContract.IsLeafwise μ (Work.EKLC6Core.Uminus t) ν X') :
    ∀ᵐ x ∂μ, 0 ≤ Work.EKLC6Core.growthFun (Work.EKLC6Core.Uminus t) ν t x := by
  have hU : Work.EKLContract.IsHoro (Work.EKLC6Core.Uminus t) :=
    (Work.EKLC6Core.uminus_isHoro t).1
  have hsub : Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t ⊆
      Work.EKLContract.Box1 (Work.EKLC6Core.Uminus t) :=
    (Work.EKLC6Core.box_conjBox_subset hU (Work.EKLC6Core.tendsto_conj_mem_uminus t)).1
  have hmem : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff]
    exact hL.conull
  filter_upwards [hmem] with x hx
  have hle : ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t) ≤ 1 := by
    calc ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)
        ≤ ν x (Work.EKLContract.Box1 (Work.EKLC6Core.Uminus t)) :=
          MeasureTheory.measure_mono hsub
      _ = 1 := hL.normalised x hx
  have hle' : (ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal ≤ 1 := by
    calc (ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal
        ≤ (1 : ℝ≥0∞).toReal := ENNReal.toReal_mono (by simp) hle
      _ = 1 := by simp
  have hlog : Real.log ((ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal) ≤ 0 :=
    Real.log_nonpos ENNReal.toReal_nonneg hle'
  simp only [Work.EKLC6Core.growthFun]
  linarith

/-! ## The main theorem modulo the geometric core -/

theorem Ch_ent_le_HcondSig_gen_of_geoData {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
