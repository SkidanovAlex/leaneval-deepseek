/-!
### Helpers for the assembly: the sign of `growthFun` and the `∫⁻`/`Integrable` bridge

These two lemmas used to live in `Work.EKLC6Core.integrable_growthFun_uminus` (deleted from the
workspace); they are steps 2 of the assembly recorded above and are reproduced here so that the
wiring can be done without that file.  Both are proved, no `sorry`.
-/

/-- On the conull domain of a leaf-wise system for the contracted subgroup `Uminus t`, the
contracted box `conjBox (Uminus t) t` is contained in the normalising box `Box1 (Uminus t)`,
whose `ν x`-mass is `1`; hence `growthFun (Uminus t) ν t ≥ 0` almost everywhere — the entropy
contribution of Pisa 7.6 is a non-negative observable, so its integrability is exactly the
finiteness of its `ℝ≥0∞`-valued integral. -/
theorem growthFun_uminus_nonneg {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3}
    (hL : Work.EKLContract.IsLeafwise μ (Work.EKLC6Core.Uminus t) ν X') :
    ∀ᵐ x ∂μ, 0 ≤ Work.EKLC6Core.growthFun (Work.EKLC6Core.Uminus t) ν t x := by
  have hU : Work.EKLContract.IsHoro (Work.EKLC6Core.Uminus t) :=
    (Work.EKLC6Core.uminus_isHoro t).1
  have hsub : Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t ⊆
      Work.EKLContract.Box1 (Work.EKLC6Core.Uminus t) :=
    (Work.EKLC6Core.box_conjBox_subset hU (Work.EKLC6Core.tendsto_conj_mem_uminus t)).1
  have hmem : ∀ᵐ x ∂μ, x ∈ X' := by
    rw [MeasureTheory.ae_iff]
    exact hL.conull
  filter_upwards [hmem] with x hx
  have hle : ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t) ≤ 1 := by
    calc ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)
        ≤ ν x (Work.EKLContract.Box1 (Work.EKLC6Core.Uminus t)) :=
          MeasureTheory.measure_mono hsub
      _ = 1 := hL.normalised x hx
  have hle' : (ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal ≤ 1 := by
    calc (ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal
        ≤ (1 : ℝ≥0∞).toReal := ENNReal.toReal_mono (by simp) hle
      _ = 1 := by simp
  have hlog : Real.log ((ν x (Work.EKLC6Core.conjBox (Work.EKLC6Core.Uminus t) t)).toReal) ≤ 0 :=
    Real.log_nonpos ENNReal.toReal_nonneg hle'
  simp only [Work.EKLC6Core.growthFun]
  linarith

/-- The `∫⁻`-finiteness of the entropy contribution of `Uminus t` is equivalent to the
integrability of `growthFun (Uminus t) ν t`: with the a.e. non-negativity of
`growthFun_uminus_nonneg`, `MeasureTheory.lintegral_ofReal_ne_top_iff_integrable` applies. -/
theorem integrable_growthFun_uminus_of_lintegral_ne_top
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3}
    (hL : Work.EKLContract.IsLeafwise μ (Work.EKLC6Core.Uminus t) ν X')
    (hmeas : Measurable (Work.EKLC6Core.growthFun (Work.EKLC6Core.Uminus t) ν t))
    (hfin : MeasureTheory.lintegral μ
      (fun x => ENNReal.ofReal (Work.EKLC6Core.growthFun (Work.EKLC6Core.Uminus t) ν t x)) ≠ ⊤) :
    MeasureTheory.Integrable (Work.EKLC6Core.growthFun (Work.EKLC6Core.Uminus t) ν t) μ :=
  (MeasureTheory.lintegral_ofReal_ne_top_iff_integrable hmeas.aestronglyMeasurable
    (growthFun_uminus_nonneg t hL)).mp hfin


