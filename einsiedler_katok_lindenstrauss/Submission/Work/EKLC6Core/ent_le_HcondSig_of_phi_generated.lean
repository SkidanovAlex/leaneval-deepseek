namespace Work.EKLC6Core

open Work.EKLContract

/-- Borel measurability of the diagonal action on `X₃`, stated at the top level so that the
`MeasurableSpace X₃` instance is the Borel one: inside a proof that binds a local hypothesis
`A : MeasurableSpace X₃`, typeclass search would otherwise capture `A` (see the formalisation
note in `EKLC6Core/Hcond_mono.lean`). -/
private theorem measurable_aDiag_smul_X3 (t : Fin 3 → ℝ) :
    Measurable (fun y : X3 => aDiag t • y) :=
  (continuous_const_smul (aDiag t)).measurable

/-! ## Proven reductions: a capturing partition bounds `ent` by `HcondSig`

These are the two halves of the "one-step generator route" of the status note, made precise.

* `ent_le_ofReal_hPart_of_orbit_contains`: if `P` is a finite partition with `partSigma P ≤ A`
  whose (one-sided) `aDiag t`-orbit σ-algebra contains `A`, then
  `ent μ (aDiag t ·) ≤ ofReal (hPart μ (aDiag t ·) P)`.
* `ofReal_hPart_le_HcondSig_of_capture`: if in addition
  `comap T A ≤ ⋁_{n≥1} comap (T^[n]) (partSigma P)` (the "capture"), then
  `ofReal (hPart μ (aDiag t ·) P) ≤ HcondSig μ A (comap T A)`.

Combining them (`ent_le_HcondSig_of_capture`) shows that the requested target follows as soon as
one has a *capturing generating partition* inside `A`: a finite `P` with `partSigma P ≤ A`,
`A ≤ ⋁_n comap (T^[n]) (partSigma P)` and `comap T A ≤ ⋁_{n≥1} comap (T^[n]) (partSigma P)`.
For `P` the atom partition of `σ(S)`, both conditions hold as soon as `σ(S)` has **finitely**
many atoms: then `⋁_n comap (T^[n]) (partSigma P) = ⋁_n comap (T^[n]) σ(S) = A` by `hAg`, whence
`comap T A = ⋁_{n≥1} comap (T^[n]) σ(S)`.  For a general countable family `S` the existence of
such a `P` is exactly the "generating partition" input of Pisa Prop. 7.43, which the geometry
(`EKLC6Core.exists_desc_subordinate`, `EKLComp.prop92`) is being built to supply.

The proofs use `EKLGen.exists_partSigma_tendsto` (the chain `F l ↑ A` supplied by the
plaque-algebra structure), `ent_eq_iSup_hPart_of_biGen` (Kolmogorov–Sinai for a two-sidedly
generating σ-algebra), `BiGenChain.hPart_le_hPart_add_Hcond` (the chain rule
`hPart μ T Q ≤ hPart μ T P + H_μ(Q | ⋁_n comap (T^[n]) (partSigma P))`), `hPart_Hcond`, and the
monotonicity of `Hcond` in the conditioning σ-algebra.

The instances are written explicitly (`@FinPart X₃ instMeasurableSpaceX3` etc.) because a local
hypothesis `A : MeasurableSpace X₃` is an instance candidate and would otherwise be captured by
typeclass search — the trap documented in `EKLC6Core/Hcond_mono.lean`. -/

/-- **First half.** If the one-sided `aDiag t`-orbit σ-algebra of a finite partition `P` with
`partSigma P ≤ A` contains `A`, then `ent μ (aDiag t ·) ≤ ofReal (hPart μ (aDiag t ·) P)`. -/
theorem ent_le_ofReal_hPart_of_orbit_contains
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {A : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A) (hZ : μ Zᶜ = 0)
    (hbil : (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) A ⊔
        MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A)
        = Work.EKLContract.instMeasurableSpaceX3)
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    (hPA : @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P ≤ A)
    (horb : A ≤ ⨆ n : ℕ, MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)) :
    @Work.EKLContract.ent Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ ENNReal.ofReal (@Work.EKLContract.hPart Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ
          (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) P) := by
  have hTU : @Measurable Work.EKLContract.X3 Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 Work.EKLContract.instMeasurableSpaceX3
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x) :=
    measurable_aDiag_smul_X3 (-t)
  have hinv : Function.LeftInverse
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) := by
    intro x
    exact Work.EKLContract.aDiag_neg_smul t x
  obtain ⟨F, hF1, hF2, hF3⟩ :=
    Work.EKLGen.exists_partSigma_tendsto (U := Work.EKLC6Core.Uminus t) hplq
  have hKS := Work.EKLC6Core.ent_eq_iSup_hPart_of_biGen
    (X := Work.EKLContract.X3) (mX := Work.EKLContract.instMeasurableSpaceX3) μ
    (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
    (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)
    hinv hmp hTU A hbil F hF2 hF3
  rw [hKS]
  refine iSup_le fun l => ENNReal.ofReal_le_ofReal ?_
  have hchain := Work.EKLC6Core.BiGenChain.hPart_le_hPart_add_Hcond
    (X := Work.EKLContract.X3) (mX := Work.EKLContract.instMeasurableSpaceX3)
    μ (T := fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) hmp P (F l)
  have hc1 : @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (F l)
        (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
          (@Work.EKLContract.partSigma Work.EKLContract.X3
            Work.EKLContract.instMeasurableSpaceX3 P))
      ≤ @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (F l) A :=
    Work.EKLC6Core.Hcond_mono (mX := Work.EKLContract.instMeasurableSpaceX3) μ (F l) A
      (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P)) horb
  have hc2 : @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (F l) A
      ≤ @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (F l)
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 (F l)) :=
    Work.EKLC6Core.Hcond_mono (mX := Work.EKLContract.instMeasurableSpaceX3) μ (F l)
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 (F l)) A (hF1 l)
  have hc0 : @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ (F l)
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 (F l)) = 0 :=
    Work.EKLC6Core.BiGenAux.Hcond_partSigma_eq_zero
      (mX := Work.EKLContract.instMeasurableSpaceX3) μ (F l)
  show @Work.EKLContract.hPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) (F l)
    ≤ @Work.EKLContract.hPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) P
  linarith [hchain, hc1, hc2, hc0]

/-- **Second half (the capture).** For a finite partition `P` with `partSigma P ≤ A` whose
`T`-orbit σ-algebra captures `comap T A`, one has
`ofReal (hPart μ (aDiag t ·) P) ≤ HcondSig μ A (comap T A)`. -/
theorem ofReal_hPart_le_HcondSig_of_capture
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {A : MeasurableSpace Work.EKLContract.X3}
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    (hPA : @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P ≤ A)
    (hcap : MeasurableSpace.comap
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A ≤
      ⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P)) :
    ENNReal.ofReal (@Work.EKLContract.hPart Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) P)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ A
          (MeasurableSpace.comap
            (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) := by
  have hTmeas : @Measurable Work.EKLContract.X3 Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 Work.EKLContract.instMeasurableSpaceX3
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) :=
    measurable_aDiag_smul_X3 t
  have hpart := Work.EKLComp.hPart_Hcond
    (X := Work.EKLContract.X3) (mX := Work.EKLContract.instMeasurableSpaceX3)
    μ (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) hTmeas hmp P
  have hanti : @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ P
        (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
          (@Work.EKLContract.partSigma Work.EKLContract.X3
            Work.EKLContract.instMeasurableSpaceX3 P))
      ≤ @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ P
        (MeasurableSpace.comap
          (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) :=
    Work.EKLC6Core.Hcond_mono (mX := Work.EKLContract.instMeasurableSpaceX3) μ P
      (MeasurableSpace.comap (fun x : Work.EKLContract.X3 =>
        Work.EKLContract.aDiag t • x) A)
      (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P)) hcap
  have hle : @Work.EKLContract.hPart Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) P
      ≤ @Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ P
        (MeasurableSpace.comap
          (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) := by
    rw [hpart]; exact hanti
  refine le_trans (ENNReal.ofReal_le_ofReal hle) (le_iSup
    (fun Q : {P : @Work.EKLContract.FinPart Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 //
        @Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P ≤ A} =>
      ENNReal.ofReal (@Work.EKLContract.Hcond Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 μ Q.1 (MeasurableSpace.comap
          (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A)))
    ⟨P, hPA⟩)

/-- **Combined helper.** If there is a finite partition `P` with `partSigma P ≤ A` whose
`aDiag t`-orbit σ-algebra contains `A` (`hor b`) and captures `comap T A` (`hcap`), then the
requested target holds.  (Taking `P` the atom partition of `σ(S)` supplies both whenever `σ(S)`
has finitely many atoms: `hAg` gives `⋁_n comap (T^[n]) σ(S) = A` and hence
`comap T A = ⋁_{n≥1} comap (T^[n]) σ(S)`.) -/
theorem ent_le_HcondSig_of_capture
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {A : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A) (hZ : μ Zᶜ = 0)
    (hbil : (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) A ⊔
        MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A)
        = Work.EKLContract.instMeasurableSpaceX3)
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    (hPA : @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P ≤ A)
    (horb : A ≤ ⨆ n : ℕ, MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P))
    (hcap : MeasurableSpace.comap
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A ≤
      ⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P)) :
    @Work.EKLContract.ent Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 μ A
          (MeasurableSpace.comap
            (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) :=
  le_trans
    (ent_le_ofReal_hPart_of_orbit_contains (μ := μ) t hmp hplq hZ hbil P hPA horb)
    (ofReal_hPart_le_HcondSig_of_capture (μ := μ) t hmp P hPA hcap)

/-! ## Instantiation: a generating *finite* partition inside `A` proves the target

This wires `ent_le_HcondSig_of_capture` to the output shape of the fleet's machinery.  The
geometric constructions (`EKLC6Core.exists_desc_subordinate`, whose proof produces
`A = ⨆ₙ comap (T^[n]) (generateFrom (Set.range G))` for a countable coding family `G`;
`EKLComp.prop92`) present the σ-algebra as the `T`-orbit σ-algebra of a family.  The two facts
below are all that is needed on top of the target's hypotheses `hAg`, `hgenS`, `hplq`, `hZ`:

* `horb` (`A ≤ ⋁ₙ comap (T^[n]) (partSigma P)`) and
* `hcap` (`comap T A ≤ ⋁ₙ comap (T^[n+1]) (partSigma P)`)

both follow from `generateFrom (range S) ≤ partSigma P` together with `hAg` and
`partSigma P ≤ A`: indeed `A = ⋁ₙ comap (T^[n]) σ(S)` and `comap T A = ⋁ₙ comap (T^[n+1]) σ(S)`,
so it suffices to have `σ(S)` inside `partSigma P`, and `partSigma P ≤ A` keeps `P` inside the
sup defining `HcondSig`.  Hence, whenever `σ(S)` is generated by a *finite* partition lying in
`A`, the target holds. -/
theorem ent_le_HcondSig_of_generating_finPart
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {A : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A) (hZ : μ Zᶜ = 0)
    (S : ℕ → Set Work.EKLContract.X3) (hS : ∀ n, MeasurableSet (S n))
    (hAg : (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
        (MeasurableSpace.generateFrom (Set.range S))) = A)
    (hgenS : (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
        (MeasurableSpace.generateFrom (Set.range S))) = Work.EKLContract.instMeasurableSpaceX3)
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    (hSP : MeasurableSpace.generateFrom (Set.range S) ≤
      @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)
    (hPA : @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P ≤ A) :
    @Work.EKLContract.ent Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ A
          (MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) := by
  -- `σ(S) ≤ A` is the `n = 0` term of `hAg`
  have hSigle : MeasurableSpace.generateFrom (Set.range S) ≤ A := by
    rw [← hAg]
    refine le_trans ?_ (le_iSup (fun n : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
      (MeasurableSpace.generateFrom (Set.range S))) 0)
    rw [Function.iterate_zero, MeasurableSpace.comap_id]
  -- the two capture hypotheses
  have horb : A ≤ ⨆ n : ℕ, MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P) := by
    rw [← hAg]
    refine iSup_le fun n => le_trans (MeasurableSpace.comap_mono hSP) ?_
    exact le_iSup (fun m : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[m])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)) n
  have hcap : MeasurableSpace.comap
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A ≤
      ⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P) := by
    rw [← hAg, MeasurableSpace.comap_iSup]
    refine iSup_le fun n => ?_
    rw [MeasurableSpace.comap_comp]
    have hidx : ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
        ∘ (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
        = (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1] := by
      funext x
      exact (Function.iterate_succ_apply
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) n x).symm
    rw [hidx]
    refine le_trans (MeasurableSpace.comap_mono hSP) ?_
    exact le_iSup (fun m : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[m + 1])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)) n
  -- the two-sided generation for the Kolmogorov–Sinai step
  have hbil : (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) A ⊔
        MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A)
        = Work.EKLContract.instMeasurableSpaceX3 := by
    refine le_antisymm (iSup_le fun n => sup_le ?_ ?_) ?_
    · exact le_trans (MeasurableSpace.comap_mono hplq.1)
        ((measurable_aDiag_smul_X3 t).iterate n).comap_le
    · exact le_trans (MeasurableSpace.comap_mono hplq.1)
        ((measurable_aDiag_smul_X3 (-t)).iterate n).comap_le
    · rw [← hgenS]
      refine iSup_le fun n => ?_
      refine le_trans (MeasurableSpace.comap_mono hSigle) ?_
      have hsup : MeasurableSpace.comap
            ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A ≤
          MeasurableSpace.comap
              ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) A ⊔
            MeasurableSpace.comap
              ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A :=
        le_sup_right
      refine le_trans hsup ?_
      exact le_iSup (fun n : ℕ => MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) A ⊔
        MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) A) n
  exact ent_le_HcondSig_of_capture t hmp hplq hZ hbil P hPA horb hcap

/-! ## Instantiation for the fleet's `pastSigCutD` presentation

The geometric constructions present the plaque algebra as `A = pastSigCutD t M = ⨆ₙ comap (T^[n]) M`
(`EKLC6Core.cutDefs.pastSigCutD`; this is the shape produced in
`EKLC6Core.exists_desc_subordinate` and in `EKLC6Core.isPlaqueAlgebra_pastSig_of_good_set`).
The previous lemma, restated in that vocabulary: the target holds for `A = pastSigCutD t M` as soon
as `M` is sandwiched between a finite partition and `A`, i.e. `M ≤ partSigma P ≤ pastSigCutD t M`,
and the inverse orbit of `M` generates the Borel σ-algebra.  Both capture hypotheses then hold
(because `⨆ₙ comap (T^[n]) M ⊆ ⨆ₙ comap (T^[n]) (partSigma P)` and likewise one level up), so
no further input is needed beyond the partition `P`. -/
theorem ent_le_HcondSig_of_pastSig
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ] (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {M : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z
      (Work.EKLC6Core.pastSigCutD t M)) (hZ : μ Zᶜ = 0)
    (hgenM : (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n]) M)
        = Work.EKLContract.instMeasurableSpaceX3)
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    (hMP : M ≤ @Work.EKLContract.partSigma Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 P)
    (hPA : @Work.EKLContract.partSigma Work.EKLContract.X3
      Work.EKLContract.instMeasurableSpaceX3 P ≤ Work.EKLC6Core.pastSigCutD t M) :
    @Work.EKLContract.ent Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
          (Work.EKLC6Core.pastSigCutD t M)
          (MeasurableSpace.comap
            (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
            (Work.EKLC6Core.pastSigCutD t M)) := by
  have hAle : Work.EKLC6Core.pastSigCutD t M ≤ Work.EKLContract.instMeasurableSpaceX3 := hplq.1
  -- `M ≤ pastSigCutD t M` (the `n = 0` term)
  have hMle : M ≤ Work.EKLC6Core.pastSigCutD t M := by
    rw [Work.EKLC6Core.pastSigCutD]
    refine le_trans (le_of_eq ?_) (le_iSup (fun n : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n]) M) 0)
    rw [Function.iterate_zero, MeasurableSpace.comap_id]
  -- the two-sided generation
  have hbil : (⨆ n : ℕ, MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
          (Work.EKLC6Core.pastSigCutD t M) ⊔
        MeasurableSpace.comap
          ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
          (Work.EKLC6Core.pastSigCutD t M))
        = Work.EKLContract.instMeasurableSpaceX3 := by
    refine le_antisymm (iSup_le fun n => sup_le ?_ ?_) ?_
    · exact le_trans (MeasurableSpace.comap_mono hAle)
        ((measurable_aDiag_smul_X3 t).iterate n).comap_le
    · exact le_trans (MeasurableSpace.comap_mono hAle)
        ((measurable_aDiag_smul_X3 (-t)).iterate n).comap_le
    · rw [← hgenM]
      refine iSup_le fun n => ?_
      refine le_trans (MeasurableSpace.comap_mono hMle) ?_
      have hsup : MeasurableSpace.comap
            ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
            (Work.EKLC6Core.pastSigCutD t M) ≤
          MeasurableSpace.comap
              ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
              (Work.EKLC6Core.pastSigCutD t M) ⊔
            MeasurableSpace.comap
              ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
              (Work.EKLC6Core.pastSigCutD t M) := le_sup_right
      refine le_trans hsup ?_
      exact le_iSup (fun n : ℕ => MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
          (Work.EKLC6Core.pastSigCutD t M) ⊔ MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
          (Work.EKLC6Core.pastSigCutD t M)) n
  -- the two capture hypotheses
  have horb : Work.EKLC6Core.pastSigCutD t M ≤ ⨆ n : ℕ, MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P) := by
    rw [Work.EKLC6Core.pastSigCutD]
    refine iSup_le fun n => le_trans (MeasurableSpace.comap_mono hMP) ?_
    exact le_iSup (fun m : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[m])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)) n
  have hcap : MeasurableSpace.comap
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
        (Work.EKLC6Core.pastSigCutD t M) ≤
      ⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1])
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P) := by
    rw [Work.EKLC6Core.pastSigCutD, MeasurableSpace.comap_iSup]
    refine iSup_le fun n => ?_
    rw [MeasurableSpace.comap_comp]
    have hidx : ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
        ∘ (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
        = (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n + 1] := by
      funext x
      exact (Function.iterate_succ_apply
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) n x).symm
    rw [hidx]
    refine le_trans (MeasurableSpace.comap_mono hMP) ?_
    exact le_iSup (fun m : ℕ => MeasurableSpace.comap
      ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[m + 1])
      (@Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P)) n
  exact ent_le_HcondSig_of_capture t hmp hplq hZ hbil P hPA horb hcap

theorem ent_le_HcondSig_of_phi_generated {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    (t : Fin 3 → ℝ)
    (hmp : MeasureTheory.MeasurePreserving
      (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) μ μ)
    {A : MeasurableSpace Work.EKLContract.X3} {Z : Set Work.EKLContract.X3}
    (hplq : Work.EKLContract.IsPlaqueAlgebra (Work.EKLC6Core.Uminus t) Z A) (hZ : μ Zᶜ = 0)
    (S : ℕ → Set Work.EKLContract.X3) (hS : ∀ n, MeasurableSet (S n))
    (hAg : (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)^[n])
        (MeasurableSpace.generateFrom (Set.range S))) = A)
    (hgenS : (⨆ n : ℕ, MeasurableSpace.comap
        ((fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag (-t) • x)^[n])
        (MeasurableSpace.generateFrom (Set.range S))) = Work.EKLContract.instMeasurableSpaceX3) :
    @Work.EKLContract.ent Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ
        (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x)
      ≤ @Work.EKLC6Core.HcondSig Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 μ A
          (MeasurableSpace.comap (fun x : Work.EKLContract.X3 => Work.EKLContract.aDiag t • x) A) := by
  set T : Work.EKLContract.X3 → Work.EKLContract.X3 :=
    fun x => Work.EKLContract.aDiag t • x with hT
  set U : Work.EKLContract.X3 → Work.EKLContract.X3 :=
    fun x => Work.EKLContract.aDiag (-t) • x with hU
  -- `A` is Borel (first field of the plaque algebra), so both sides of the generation
  -- hypothesis for the inverse flow are Borel σ-algebras.
  have hAle : A ≤ Work.EKLContract.instMeasurableSpaceX3 := hplq.1
  -- `generateFrom (range S)` is the `n = 0` term of the supremum defining `A`.
  have hSigle : MeasurableSpace.generateFrom (Set.range S) ≤ A := by
    rw [← hAg]
    calc MeasurableSpace.generateFrom (Set.range S)
        = MeasurableSpace.comap (T^[0]) (MeasurableSpace.generateFrom (Set.range S)) := by
          rw [Function.iterate_zero, MeasurableSpace.comap_id]
      _ ≤ ⨆ n, MeasurableSpace.comap (T^[n]) (MeasurableSpace.generateFrom (Set.range S)) :=
          le_iSup (fun n => MeasurableSpace.comap (T^[n])
            (MeasurableSpace.generateFrom (Set.range S))) 0
  refine ent_le_HcondSig_of_gen t hmp hplq hZ ?_ ?_
  · -- `A` is `aDiag t ·`-descending
    rw [← hAg, MeasurableSpace.comap_iSup]
    refine iSup_le fun n => ?_
    rw [MeasurableSpace.comap_comp]
    have hidx : (T^[n]) ∘ T = T^[n+1] := by
      funext x; exact (Function.iterate_succ_apply T n x).symm
    rw [hidx]
    exact le_iSup (fun m => MeasurableSpace.comap (T^[m])
      (MeasurableSpace.generateFrom (Set.range S))) (n + 1)
  · -- the inverse flow, together with `A`, generates the Borel σ-algebra
    refine le_antisymm ?_ ?_
    · refine iSup_le fun n => ?_
      exact (MeasurableSpace.comap_mono hAle).trans
        ((measurable_aDiag_smul_X3 (-t)).iterate n).comap_le
    · rw [← hgenS]
      refine iSup_le fun n => ?_
      exact (MeasurableSpace.comap_mono hSigle).trans
        (le_iSup (fun m => MeasurableSpace.comap (U^[m]) A) n)

end Work.EKLC6Core


/-!
## Session 10: the target is a *finiteness* statement, and the assembly is named

### The key simplification (new, and proved in the workspace)

In the setting of the target — `hmp`, a leaf-wise system `hL : IsLeafwise μ (Uminus t) ν X'`
(this exists by `Work.EKLC6Core.exists_leafwise_growthFun_measurable`), `hplq`, `hZ`, and
