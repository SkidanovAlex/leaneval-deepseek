import Mathlib
import Submission.Work.EKLC6Core.PlaqueCellDefs
import Submission.Work.EKLC6Core.atom_MSig
import Submission.Work.EKLC6Core.exists_base_sat_sep
import Submission.Work.EKLC6Core.uminus_isHoro

/-!
# `Work.EKLC6Core.CellBaseCore`

Vocabulary and elementary facts about an arbitrary **raw cell family** `S : CellBase μ U`
(`Work.EKLC6Core.exists_plaque_family_conull`): the pointwise lift `lift2`, its elementary
properties, the generating family `fam2` of the σ-algebra `MSig2`, the characterisation of
membership in a clipped generator inside its cell, and the openness/measurability of the clipped
generators when the cylinder sets `O m` are open.

This is the `CellBase` analogue of the `CellSys`-based material in `CellSysDefs`/`atom_MSig`
(`lift`, `lift_mem`, `mkX_lift`, `mkX_inj_lifted`, `fam`, `atomMSig_mem_genC_iff`); the raw cell
family lacks the (unused) `hgood` field and the (in general unavailable) thin-boundary field of
`CellSys`, so the two developments are kept separate.  Nothing here uses `hgood`, `hthin`, or any
hypothesis on `μ`, `t`, `U` beyond what is stated.
-/

open MeasureTheory Filter Topology
open scoped ENNReal Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}

/-- The lift of a point of a cell of a raw cell family: an element of the lifted ball
`V (δ k) · g k` mapping to `y`. -/
noncomputable def lift2 (S : CellBase μ U) (k : ℕ) (y : X3) : SL3 := by
  classical
  exact if h : y ∈ S.Q k then Classical.choose (S.hsub k h) * S.g k else 1

/-- The lift of a point of a cell lies in the lifted ball of that cell. -/
theorem lift2_mem (S : CellBase μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    lift2 S k y ∈ lifted (S.δ k) (S.g k) := by
  classical
  obtain ⟨hch1, -⟩ := Classical.choose_spec (S.hsub k hy)
  have hch1' : Classical.choose (S.hsub k hy) ∈ V (S.δ k) :=
    V_mono' (by linarith [S.hδpos k]) hch1
  rw [lift2, dif_pos hy]
  exact ⟨Classical.choose (S.hsub k hy), hch1', rfl⟩

/-- The lift of a point of a cell maps back to that point. -/
theorem mkX_lift2 (S : CellBase μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    mkX (lift2 S k y) = y := by
  classical
  obtain ⟨-, hch2⟩ := Classical.choose_spec (S.hsub k hy)
  have hch2' : Classical.choose (S.hsub k hy) • mkX (S.g k) = y := hch2
  rw [lift2, dif_pos hy, atomMSig_smul_mkX]
  exact hch2'

/-- `mkX` is injective on a lifted ball. -/
theorem mkX_inj_lifted2 (S : CellBase μ U) (k : ℕ) {a b : SL3}
    (ha : a ∈ lifted (S.δ k) (S.g k)) (hb : b ∈ lifted (S.δ k) (S.g k))
    (h : mkX a = mkX b) : a = b := by
  obtain ⟨v₁, hv₁, h1⟩ := ha
  obtain ⟨v₂, hv₂, h2⟩ := hb
  have h1' : v₁ * S.g k = a := h1
  have h2' : v₂ * S.g k = b := h2
  have hv4 : v₁ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₁
  have hv4' : v₂ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₂
  have hmk : v₁ • mkX (S.g k) = v₂ • mkX (S.g k) := by
    rw [← atomMSig_smul_mkX v₁ (S.g k), ← atomMSig_smul_mkX v₂ (S.g k), h1', h2', h]
  have hv : v₁ = v₂ := S.hinj k v₁ v₂ hv4 hv4' hmk
  rw [← h1', ← h2', hv]

/-- The generating family of the σ-algebra `MSig2`: the cells together with the clipped
cylinders. -/
def fam2 (U : Subgroup SL3) (Q : ℕ → Set X3) (δ : ℕ → ℝ) (g : ℕ → SL3) (O : ℕ → Set SL3) :
    Set (Set X3) :=
  Set.range Q ∪ Set.range (fun p : ℕ × ℕ => genC2 U Q δ g O p.1 p.2)

/-- `MSig2` is generated by `fam2`. -/
theorem MSig2_eq_generateFrom_fam2 (U : Subgroup SL3) (Q : ℕ → Set X3) (δ : ℕ → ℝ)
    (g : ℕ → SL3) (O : ℕ → Set SL3) :
    MSig2 U Q δ g O = MeasurableSpace.generateFrom (fam2 U Q δ g O) := rfl

/-- Inside a cell, membership in the `(k,m)`-th clipped generator is membership of the lift in
the `U`-saturation of `O m`. -/
theorem mem_genC2_iff (S : CellBase μ U) (O : ℕ → Set SL3) {k m : ℕ} {z : X3}
    (hz : z ∈ S.Q k) :
    z ∈ genC2 U S.Q S.δ S.g O k m ↔ lift2 S k z ∈ satU U (O m) := by
  constructor
  · intro h
    obtain ⟨⟨w, ⟨hwsat, hwl⟩, hwz⟩, -⟩ := h
    have hw : w = lift2 S k z :=
      mkX_inj_lifted2 S k hwl (lift2_mem S k hz)
        (by rw [hwz, mkX_lift2 S k hz])
    rwa [hw] at hwsat
  · intro h
    exact ⟨⟨lift2 S k z, ⟨h, lift2_mem S k hz⟩, mkX_lift2 S k hz⟩, hz⟩

/-- The clipped generators of a raw cell family are open, hence Borel, as soon as the cylinder
sets `O m` are open. -/
theorem isOpen_genC2 (S : CellBase μ U) (O : ℕ → Set SL3) (hOopen : ∀ m, IsOpen (O m))
    (k m : ℕ) : IsOpen (genC2 U S.Q S.δ S.g O k m) := by
  refine IsOpen.inter ?_ (S.hopen k)
  exact isOpenMap_mkX _
    (IsOpen.inter (isOpen_sat (U := U) (hOopen m)) (isOpen_lifted' (S.δ k) (S.g k)))

/-- The clipped generators of a raw cell family are measurable for open cylinder sets. -/
theorem measurableSet_genC2 (S : CellBase μ U) (O : ℕ → Set SL3) (hOopen : ∀ m, IsOpen (O m))
    (k m : ℕ) : MeasurableSet (genC2 U S.Q S.δ S.g O k m) :=
  (isOpen_genC2 S O hOopen k m).measurableSet

/-- **The atom identity for a raw cell family.**  The atom of `MSig2` through a point `y` of the
`k`-th cell is the piece of the `U`-orbit of the lift `lift2 S k y` lying in the lifted ball of
the cell, intersected with the cell.  (This is the `CellBase` analogue of `atom_MSig`; `hmeas` is
kept in the signature for uniformity with `atom_MSig` although the argument does not use it.) -/
theorem atom_MSig2_self {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}
    (S : CellBase μ U) (O : ℕ → Set SL3)
    (hOsep : ∀ g g' : SL3,
      (∀ m, (∃ u ∈ U, u * g ∈ O m) ↔ (∃ u ∈ U, u * g' ∈ O m)) → ∃ u ∈ U, g' = u * g)
    (hmeas : ∀ k m, MeasurableSet (genC2 U S.Q S.δ S.g O k m))
    {k : ℕ} {y : X3} (hy : y ∈ S.Q k) :
    atom (MSig2 U S.Q S.δ S.g O) y
      = mkX '' ({g : SL3 | ∃ u ∈ U, g = u * lift2 S k y} ∩ lifted (S.δ k) (S.g k)) ∩ S.Q k := by
  classical
  have key : ∀ z : X3, z ∈ atom (MSig2 U S.Q S.δ S.g O) y ↔
      ∀ s ∈ fam2 U S.Q S.δ S.g O, (z ∈ s ↔ y ∈ s) := by
    intro z
    have h : MSig2 U S.Q S.δ S.g O = MeasurableSpace.generateFrom (fam2 U S.Q S.δ S.g O) :=
      MSig2_eq_generateFrom_fam2 U S.Q S.δ S.g O
    rw [h]
    exact atomMSig_mem_atom_generateFrom
  ext z
  constructor
  · -- every point of the atom lies in the piece of the `U`-orbit of the lift of `y`
    intro hz
    have hp : ∀ s ∈ fam2 U S.Q S.δ S.g O, (z ∈ s ↔ y ∈ s) := (key z).mp hz
    have hzQ : z ∈ S.Q k := (hp (S.Q k) (Or.inl ⟨k, rfl⟩)).mpr hy
    have hgen : ∀ m, z ∈ genC2 U S.Q S.δ S.g O k m ↔ y ∈ genC2 U S.Q S.δ S.g O k m :=
      fun m => hp (genC2 U S.Q S.δ S.g O k m) (Or.inr ⟨(k, m), rfl⟩)
    have hsat : ∀ m, lift2 S k z ∈ satU U (O m) ↔ lift2 S k y ∈ satU U (O m) :=
      fun m => ((mem_genC2_iff S O hzQ).symm.trans (hgen m)).trans (mem_genC2_iff S O hy)
    have hsat' : ∀ m, (∃ u ∈ U, u * lift2 S k z ∈ O m) ↔ (∃ u ∈ U, u * lift2 S k y ∈ O m) :=
      fun m => ((atomMSig_mem_satU_iff (U := U) (O m) (lift2 S k z)).symm.trans (hsat m)).trans
        (atomMSig_mem_satU_iff (U := U) (O m) (lift2 S k y))
    obtain ⟨u, huU, huy⟩ := hOsep (lift2 S k z) (lift2 S k y) hsat'
    have hwit : lift2 S k z = u⁻¹ * lift2 S k y := by rw [huy, inv_mul_cancel_left]
    exact ⟨⟨lift2 S k z, ⟨⟨u⁻¹, U.inv_mem huU, hwit⟩, lift2_mem S k hzQ⟩,
      mkX_lift2 S k hzQ⟩, hzQ⟩
  · -- and conversely every point of that piece has the same pattern as `y`
    intro hz
    obtain ⟨⟨w, ⟨hwW, hwl⟩, hwz⟩, hzQ⟩ := hz
    obtain ⟨u, huU, hwu⟩ := hwW
    have hℓw : lift2 S k z = w :=
      mkX_inj_lifted2 S k (lift2_mem S k hzQ) hwl
        (by rw [mkX_lift2 S k hzQ, hwz])
    have hℓ : lift2 S k z = u * lift2 S k y := by rw [hℓw, hwu]
    refine (key z).mpr fun s hs => ?_
    rcases hs with ⟨j, hj⟩ | ⟨⟨i, m⟩, him⟩
    · rw [← hj]
      by_cases hjk : j = k
      · rw [hjk]; exact ⟨fun _ => hy, fun _ => hzQ⟩
      · exact iff_of_false (Set.disjoint_left.mp (S.hdisj k j (Ne.symm hjk)) hzQ)
          (Set.disjoint_left.mp (S.hdisj k j (Ne.symm hjk)) hy)
    · rw [← him]
      by_cases hik : i = k
      · rw [hik, mem_genC2_iff S O hzQ, mem_genC2_iff S O hy, hℓ,
          atomMSig_satU_mul_iff (U := U) (O m) huU]
      · exact iff_of_false
          (fun h => Set.disjoint_left.mp (S.hdisj i k hik) h.2 hzQ)
          (fun h => Set.disjoint_left.mp (S.hdisj i k hik) h.2 hy)

end Work.EKLC6Core
