import Mathlib
import Submission.Work.EKLC6Core.cutSetup
import Submission.Work.EKLC6Core.atom_gen_cut

/-!
# `Work.EKLC6Core.shape_cut_bad` — the atoms/shape of the cut σ-algebra on the bad piece

Let `S` be the cut data (`CutData μ U ε`) and let `O : ℕ → Set SL3` be a countable family whose
`U`-saturations cover `SL₃(ℝ)`, separating left `U`-cosets.  Write `M` for the σ-algebra generated
by the cell-wise generators `genCell S O i m` (`⊆ S.cell i`) together with the exceptional piece
`S.bad`.

The claim is that on the exceptional piece the cut σ-algebra is *trivial*: for `y ∈ S.bad`,

* `atom_M y = S.bad`, and
* `shape_M U y = U ∩ {v | v • y ∈ S.bad}`.

The reason is that `S.bad` is disjoint from every cell, hence from every generator `genCell S O i m`;
so every point of `S.bad` has the constant membership pattern "in no generator, in `S.bad`".  By
`Work.EKLC6Core.mem_atom_generateFrom_iff` (atoms of a σ-algebra generated by an arbitrary family
are exactly the "same membership pattern" classes — here the family is countable, though the lemma
needs no countability) that pattern class *is* `S.bad`.  The shape statement is then immediate.
-/

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

theorem shape_cut_bad {μ : MeasureTheory.Measure Work.EKLContract.X3}
    {U : Subgroup Work.EKLContract.SL3} {ε : ℝ}
    (S : Work.EKLC6Core.CutData μ U ε) (O : ℕ → Set Work.EKLContract.SL3)
    (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : Work.EKLContract.SL3, ∃ m, z ∈ Work.EKLC6Core.sat U (O m))
    (hsep : ∀ z w : Work.EKLContract.SL3,
      (∀ m, (z ∈ Work.EKLC6Core.sat U (O m) ↔ w ∈ Work.EKLC6Core.sat U (O m))) →
      w ∈ Work.EKLC6Core.sat U ({z} : Set Work.EKLContract.SL3))
    (y : Work.EKLContract.X3) (hy : y ∈ S.bad) :
    Work.EKLContract.atom (MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => Work.EKLC6Core.genCell S O p.1 p.2) ∪ {S.bad})) y = S.bad ∧
    Work.EKLContract.shape (MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => Work.EKLC6Core.genCell S O p.1 p.2) ∪ {S.bad})) U y
      = (U : Set Work.EKLContract.SL3) ∩
        {v : Work.EKLContract.SL3 | v • y ∈ S.bad} := by
  classical
  -- name the cut σ-algebra `M`
  set M : MeasurableSpace X3 := MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => genCell S O p.1 p.2) ∪ {S.bad}) with hM
  -- the atom of `y` is its "membership pattern" class in the generating family
  have key : ∀ w : X3, w ∈ atom M y ↔
      (∀ p : Fin S.N × ℕ, (w ∈ genCell S O p.1 p.2 ↔ y ∈ genCell S O p.1 p.2)) ∧
      (w ∈ S.bad ↔ y ∈ S.bad) := by
    intro w
    rw [hM]
    rw [mem_atom_generateFrom_iff]
    constructor
    · intro h
      exact ⟨fun p => h _ (Or.inl ⟨p, rfl⟩), h _ (Or.inr rfl)⟩
    · rintro ⟨h1, h2⟩ A hA
      rcases hA with ⟨⟨i, m⟩, rfl⟩ | hA
      · exact h1 (i, m)
      · subst hA; exact h2
  -- since `S.bad` is disjoint from every cell, hence from every generator, every point of `S.bad`
  -- has the same pattern as `y`; conversely a point with this pattern lies in `S.bad`
  have hatom : atom M y = S.bad := by
    ext w
    constructor
    · intro hw
      exact ((key w).mp hw).2.mpr hy
    · intro hw
      refine (key w).mpr ⟨?_, ⟨fun _ => hy, fun _ => hw⟩⟩
      rintro ⟨i, m⟩
      exact ⟨fun h => absurd hw (Set.disjoint_left.mp (S.hbad_disj i) h.2),
             fun h => absurd hy (Set.disjoint_left.mp (S.hbad_disj i) h.2)⟩
  have hshape : shape M U y = (U : Set SL3) ∩ {v : SL3 | v • y ∈ S.bad} := by
    ext u
    simp [shape, hatom]
  exact ⟨hatom, hshape⟩

end Work.EKLC6Core
