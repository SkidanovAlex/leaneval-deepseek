import Mathlib
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq

/-!
# `Work.EKLC6Core.atom_partSigma_finPart`

The atoms of the σ-algebra `partSigma P` generated by a finite partition `P` are exactly the
parts of `P`: every point `x` lies in exactly one part `P.parts i`, and its atom is that part.

This is immediate from `atom_generateFrom_range_eq` / `mem_atom_generateFrom_iff`, which say that
the atom of a generated σ-algebra consists of the points with the same membership pattern, plus
the fact that the parts of a `FinPart` are pairwise disjoint and cover.
-/

namespace Work.EKLC6Core

open Work.EKLContract

theorem atom_partSigma_finPart
    (P : @Work.EKLContract.FinPart Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    {i : Fin P.n} {x : Work.EKLContract.X3} (hx : x ∈ P.parts i) :
    Work.EKLContract.atom
        (@Work.EKLContract.partSigma Work.EKLContract.X3
          Work.EKLContract.instMeasurableSpaceX3 P) x = P.parts i := by
  rw [show @Work.EKLContract.partSigma Work.EKLContract.X3
        Work.EKLContract.instMeasurableSpaceX3 P
      = MeasurableSpace.generateFrom (Set.range P.parts) from rfl]
  ext y
  rw [mem_atom_generateFrom_iff]
  constructor
  · intro h
    exact (h (P.parts i) ⟨i, rfl⟩).mpr hx
  · intro hy A hA
    obtain ⟨j, rfl⟩ := hA
    constructor
    · intro hyj
      rcases eq_or_ne j i with rfl | hji
      · exact hx
      · exact absurd hy (Set.disjoint_left.mp (P.disjoint hji) hyj)
    · intro hxj
      rcases eq_or_ne j i with rfl | hji
      · exact hy
      · exact absurd hx (Set.disjoint_left.mp (P.disjoint hji) hxj)

end Work.EKLC6Core
