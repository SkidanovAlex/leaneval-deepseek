import Mathlib
import Submission.Work.EKLC6Core.cutHelpers
import Submission.Work.Topology.exists_measurable_saturated_large
import Submission.Work.EKLC6Core.atom_generateFrom_range_eq

/-!
# `Work.EKLC6Core.cutCodeZ` — the measurable saturated set of the cut

This file proves the step-4 target of `PLAN_L1_desc_subordinate.md` for the *descending*
σ-algebra `descSig t M = ⨆ₙ comap ((aDiag t ·)^[n]) M` of `Work.EKLC6Core.cutHelpers`.

`H ⊆ X₃` is a Borel set of probability `> 1 - ε`, `B0` is a countable family of Borel sets and
`A := descSig t (σ (range B0))`.  Then there is an `A`-measurable set `Z`, a union of `A`-atoms,
such that every `A`-atom of a point of `Z` meets `H` and `μ Zᶜ < ε`.

The `A`-saturation of `H` is a priori only analytic (coanalytic), so it need not be
`A`-measurable; the *code* construction of `Work.Topology.exists_measurable_saturated_large`
replaces it by a measurable union of `A`-atoms of the same measure.

The `A`-atoms of a generated σ-algebra are the "same membership pattern" classes
(`atom_generateFrom_range_eq`), which is what turns the abstract lemma's two code clauses into
the two atom clauses of the statement.  Concretely, with the enumerated code family

`descSigCode t B0 k = ((aDiag t ·)^[Nat.unpair k.1]) ⁻¹' (B0 (Nat.unpair k.2))`

we have `descSig t (σ (range B0)) = σ (range (descSigCode t B0))`, and every member of that
family is `descSig t (σ (range B0))`-measurable.

TYPING WARNING (as for `exists_measurable_saturated_large_pastSig_borel`): do **not** bind a
local `(M : MeasurableSpace X₃)` — typeclass search picks up every local hypothesis of a class
type, so a statement containing `{M : MeasurableSpace X₃}` silently elaborates `μ : Measure X₃`
as `@Measure X₃ M`.  Here the σ-algebra is always written out and `μ`'s type is pinned
explicitly.

The abstract result has its own `μ` typed with respect to its σ-algebra argument `A`, so the
Borel measure `μ` cannot be passed to it directly: one passes the trimmed measure
`μ.trim hAle` (`hAle : A ≤ borel X₃`) and converts back with `MeasureTheory.trim_measurableSet_eq`
at the end.
-/

open MeasureTheory Set Topology
open scoped ENNReal

set_option linter.style.haveILetI false
set_option warn.classDefReducibility false
set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## The enumerated code family of `descSig` -/

/-- The two-parameter family `((aDiag t ·)^[n]) ⁻¹' (B0 m)`, enumerated by `Nat.unpair`. -/
def descSigCode (t : Fin 3 → ℝ) (B0 : ℕ → Set X3) (k : ℕ) : Set X3 :=
  ((fun x : X3 => aDiag t • x)^[(Nat.unpair k).1]) ⁻¹' (B0 (Nat.unpair k).2)

/-- The enumerated index `Nat.pair n m` decodes to the `(n,m)`-th member. -/
lemma descSigCode_pair (t : Fin 3 → ℝ) (B0 : ℕ → Set X3) (n m : ℕ) :
    descSigCode t B0 (Nat.pair n m) = ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' (B0 m) := by
  rw [descSigCode, Nat.unpair_pair]

/-- The range of the enumerated family is the two-parameter family. -/
lemma range_descSigCode (t : Fin 3 → ℝ) (B0 : ℕ → Set X3) :
    Set.range (descSigCode t B0) =
      ⋃ n : ℕ, (fun s : Set X3 => ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' s) '' Set.range B0 := by
  ext S
  constructor
  · rintro ⟨k, rfl⟩
    exact Set.mem_iUnion.mpr ⟨(Nat.unpair k).1,
      Set.mem_image_of_mem _ ⟨(Nat.unpair k).2, rfl⟩⟩
  · intro hS
    obtain ⟨n, s, ⟨m, hm⟩, hs⟩ := Set.mem_iUnion.mp hS
    refine ⟨Nat.pair n m, ?_⟩
    rw [descSigCode_pair, hm]
    exact hs

/-- Every member of the enumerated family is `descSig t M`-measurable. -/
lemma measurableSet_descSigCode {t : Fin 3 → ℝ} {M : MeasurableSpace X3} {B0 : ℕ → Set X3}
    (hB0 : ∀ n, @MeasurableSet _ M (B0 n)) (k : ℕ) :
    @MeasurableSet _ (descSig t M) (descSigCode t B0 k) := by
  refine MeasurableSpace.le_def.mp (le_iSup (fun n : ℕ => MeasurableSpace.comap
    ((fun x : X3 => aDiag t • x)^[n]) M) (Nat.unpair k).1) _ ?_
  exact MeasurableSpace.measurableSet_comap.mpr ⟨B0 (Nat.unpair k).2, hB0 _, rfl⟩

/-- **`descSig t M` is generated by the enumerated family**, when `M = σ(range B0)`. -/
lemma descSig_eq_generateFrom_descSigCode {t : Fin 3 → ℝ} {M : MeasurableSpace X3}
    {B0 : ℕ → Set X3} (hB0 : ∀ n, @MeasurableSet _ M (B0 n))
    (hM : M = MeasurableSpace.generateFrom (Set.range B0)) :
    descSig t M = MeasurableSpace.generateFrom (Set.range (descSigCode t B0)) := by
  refine le_antisymm ?_ ?_
  · refine iSup_le fun n => ?_
    have h1 : MeasurableSpace.comap ((fun x : X3 => aDiag t • x)^[n]) M =
        MeasurableSpace.generateFrom
          ((fun s : Set X3 => ((fun x : X3 => aDiag t • x)^[n]) ⁻¹' s) '' Set.range B0) := by
      rw [hM, MeasurableSpace.comap_generateFrom]
    rw [h1]
    refine MeasurableSpace.generateFrom_mono ?_
    intro S hS
    rw [range_descSigCode t B0]
    exact Set.mem_iUnion.mpr ⟨n, hS⟩
  · refine MeasurableSpace.generateFrom_le fun S hS => ?_
    obtain ⟨k, rfl⟩ := hS
    exact measurableSet_descSigCode hB0 k

/-! ## The statement -/

/-- **The `descSig t (σ(range B0))`-measurable, saturated part of a large Borel set.**

`H ⊆ X₃` is Borel and carries more than `1 - ε` of the probability `μ` on the ambient Borel
σ-algebra; `Z` is measurable in `A := descSig t (σ (range B0))`, is a union of `A`-atoms, every
`A`-atom of a point of `Z` meets `H`, and `μ Zᶜ < ε`. -/
theorem cutCodeZ {t : Fin 3 → ℝ} (B0 : ℕ → Set Work.EKLContract.X3)
    (hB0 : ∀ n, @MeasurableSet _ (borel Work.EKLContract.X3) (B0 n))
    {H : Set Work.EKLContract.X3} (hH : @MeasurableSet _ (borel Work.EKLContract.X3) H)
    (μ : @MeasureTheory.Measure Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3)
    [MeasureTheory.IsProbabilityMeasure μ]
    {ε : ENNReal} (hε : 0 < ε) (hHμ : 1 - ε < μ H) :
    ∃ Z : Set Work.EKLContract.X3,
      @MeasurableSet _
        (Work.EKLC6Core.descSig t (MeasurableSpace.generateFrom (Set.range B0))) Z ∧
      (∀ x ∈ Z, Work.EKLContract.atom
        (Work.EKLC6Core.descSig t (MeasurableSpace.generateFrom (Set.range B0))) x ⊆ Z) ∧
      (∀ x ∈ Z, (Work.EKLContract.atom
        (Work.EKLC6Core.descSig t (MeasurableSpace.generateFrom (Set.range B0))) x ∩ H).Nonempty) ∧
      μ Zᶜ < ε := by
  -- `B0` is measurable for the σ-algebra it generates, which in turn is coarser than Borel
  have hB0M : ∀ n, @MeasurableSet _ (MeasurableSpace.generateFrom (Set.range B0)) (B0 n) :=
    fun n => MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  have hMb : MeasurableSpace.generateFrom (Set.range B0) ≤ borel X3 :=
    MeasurableSpace.generateFrom_le fun s hs => by
      obtain ⟨n, rfl⟩ := hs
      exact hB0 n
  have hAle : descSig t (MeasurableSpace.generateFrom (Set.range B0)) ≤ borel X3 :=
    descSig_le_borel _ hMb
  have hAeq : descSig t (MeasurableSpace.generateFrom (Set.range B0)) =
      MeasurableSpace.generateFrom (Set.range (descSigCode t B0)) :=
    descSig_eq_generateFrom_descSigCode hB0M rfl
  -- the trimmed measure is a probability, and still gives `H` more than `1 - ε`
  have hprob : MeasureTheory.IsProbabilityMeasure (μ.trim hAle) :=
    MeasureTheory.IsProbabilityMeasure.mk (by
      rw [MeasureTheory.trim_measurableSet_eq (μ := μ) hAle MeasurableSet.univ,
        MeasureTheory.measure_univ])
  have hHμ' : 1 - ε < (μ.trim hAle) H := lt_of_lt_of_le hHμ (MeasureTheory.le_trim hAle)
  haveI := hprob
  obtain ⟨Z, hZmeas, hZsub, hZsat, hZμ⟩ :=
    Work.Topology.exists_measurable_saturated_large
      (A := descSig t (MeasurableSpace.generateFrom (Set.range B0))) hAle
      (fun k => measurableSet_descSigCode hB0M k) hH (μ.trim hAle) ε hε hHμ'
  refine ⟨Z, hZmeas, ?_, ?_, ?_⟩
  · -- `A`-atoms are the code classes, and `Z` is a union of such classes
    intro x hx z hz
    rw [hAeq, atom_generateFrom_range_eq (descSigCode t B0) x] at hz
    exact hZsat x hx z hz
  · -- every atom of a point of `Z` meets `H` (the code of an `H`-point it contains)
    intro x hx
    obtain ⟨y, hyH, hy⟩ := hZsub hx
    refine ⟨y, ?_, hyH⟩
    rw [hAeq, atom_generateFrom_range_eq (descSigCode t B0) x]
    exact fun n => (hy n).symm
  · -- back from the trimmed measure to `μ`
    rw [← MeasureTheory.trim_measurableSet_eq (μ := μ) hAle hZmeas.compl]
    exact hZμ

end Work.EKLC6Core
