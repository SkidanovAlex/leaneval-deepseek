/-!
# `Work.EKLC6Core.cutAssembly` — the cut-based proof of `Work.EKLC6Core.exists_desc_subordinate`

The target (Pisa 7.37/7.38) is assembled from the *cut* structure `Work.EKLC6Core.CutData`:

* `M = MCut S O` is the σ-algebra of the cut (cell-wise cylinder generators together with the
  exceptional piece `bad`), generated by open sets, hence Borel and countably generated;
* `Z` is produced from a Borel *good set* `H ⊆ CutGood S t C μ0 N` by the code-map construction
  `Work.EKLC6Core.cutCodeZ`: `Z` is `descSig t M`-measurable, saturated, and every atom of `Z`
  meets `H`;
* the plaque conditions at the points of `H` (openness of the `M`-shapes along the orbit,
  boundedness at the good points, the shrinking-`U`-ball margin, and the orbit clause) come from
  the cut lemmas `shape_cut_bad`/`isOpen_shape_cut_cell` (cell and bad points), `cutHShapeCell`
  (the exact shape), `cutHMargin` (the margin, using the unipotence `cutHUnipotent` and the
  uncrossedness `cutHUncross` hidden inside it);
* the inheritance package of `Work.EKLC6Core.cutHelpers` transfers everything from `H` to `Z`.
-/

open MeasureTheory Set Topology Filter
open scoped ENNReal Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option warn.classDefReducibility false
set_option maxHeartbeats 1000000

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3} {ε : ℝ}

/-! ## The assembly -/

/-- **The assembly from the cut good set.**  With the geometric facts at the good set `H` as
hypotheses, the descending σ-algebra of the cut is a plaque algebra on any `H`-saturating
`descSig t M`-measurable set `Z`. -/
theorem isPlaqueAlgebra_descSig {U : Subgroup SL3} {t : Fin 3 → ℝ} (hU : IsHoro U)
    (M : MeasurableSpace X3) {b : Set (Set X3)} (hb : b.Countable)
    (hMb : M = MeasurableSpace.generateFrom b) (hMle : M ≤ borel X3)
    {H Z : Set X3} {ρ c mu lam : ℝ} {N : ℕ} (hρ : 0 < ρ) (hc : 0 < c)
    (hlam0 : 0 ≤ lam) (hlam_mu : lam < mu) (hmu1 : mu < 1)
    (hrate : ∀ n : ℕ, ∀ u : SL3, u ∈ U → u ∈ Work.EKLComp.Uball U ρ →
      aDiag t ^ n * u * (aDiag t ^ n)⁻¹ ∈ Work.EKLComp.Uball U (ρ * lam ^ n))
    (hopenM : ∀ y ∈ H, ∀ n : ℕ, ∃ W : Set SL3, IsOpen W ∧
      shape M U (((fun x : X3 => aDiag t • x)^[n]) y) = W ∩ (U : Set SL3))
    (hbddH : ∀ y ∈ H, shape M U y ⊆ Work.EKLComp.Uball U ρ)
    (hmarginH : ∀ y ∈ H, ∀ n : ℕ, N ≤ n → Work.EKLComp.Uball U (c * mu ^ n) ⊆
      shape M U (((fun x : X3 => aDiag t • x)^[n]) y))
    (horbM : ∀ y ∈ H, atom M y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3))
    (hZmeas : MeasurableSet[descSig t M] Z)
    (hsat : ∀ x ∈ Z, atom (descSig t M) x ⊆ Z)
    (hmeet : ∀ x ∈ Z, ∃ y ∈ H, atom (descSig t M) x = atom (descSig t M) y) :
    IsPlaqueAlgebra U Z (descSig t M) := by
  have hAle : descSig t M ≤ borel X3 := descSig_le_borel M hMle
  have horbH : ∀ y ∈ H, atom (descSig t M) y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3) :=
    fun y hy => (atom_descSig_le t M y).trans (horbM y hy)
  obtain ⟨b', hb'c, hb'eq⟩ := descSig_countably_generated hb hMb
  have hopenH : ∀ y ∈ H, ∃ O : Set SL3, IsOpen O ∧
      shape (descSig t M) U y = O ∩ (U : Set SL3) := by
    intro y hy
    exact Work.EKLC6Core.isOpen_shape_pastSig_of_margin (N := N) hU hlam0 hlam_mu hmu1 hc hρ
      hrate (fun n => hopenM y hy n) (hbddH y hy) (fun n hn => hmarginH y hy n hn)
  have hbddA : ∀ y ∈ H, shape (descSig t M) U y ⊆ Work.EKLComp.Uball U ρ := by
    intro y hy u hu
    exact hbddH y hy ⟨hu.1, atom_descSig_le t M y hu.2⟩
  have hatombd : ∀ y ∈ H, atom (descSig t M) y ⊆
      (fun u : SL3 => u • y) '' (Work.EKLComp.Uball U ρ) := by
    intro y hy z hz
    rw [atom_eq_smul_shape_c (horbH y hy)] at hz
    obtain ⟨u, hu, rfl⟩ := hz
    exact ⟨u, hbddA y hy hu, rfl⟩
  obtain ⟨D, hD⟩ := Work.EKLProd.inv_entries_bound ρ hρ
  have hD0 : 0 ≤ D :=
    le_trans (abs_nonneg _) (hD 1 (Work.EKLContract.Lemmas.V_open_one ρ hρ).2 0 0)
  refine ⟨hAle, ⟨b', hb'c, hb'eq⟩, hZmeas, fun x hx => ?_⟩
  refine ⟨hsat x hx, atom_subset_orb_of_forall_exists_atom_eq_c hmeet horbH x hx,
    exists_isOpen_shape_of_forall_exists_atom_eq_c hmeet horbH hopenH x hx, ?_⟩
  refine exists_bound_shape_of_forall_exists_atom_eq_c (A := descSig t M) (U := U)
    (H := H) (Z := Z) (ρ := ρ)
    ?_ ?_ (fun g hg i j => hD g (hg.2 : g ∈ Work.EKLContract.V ρ) i j) hD0 x hx
  · intro x' hx'
    obtain ⟨y, hyH, hxy⟩ := hmeet x' hx'
    have hx'atom : x' ∈ atom (descSig t M) y := by rw [← hxy]; exact mem_atom_self_c _ x'
    obtain ⟨u, hu, hux⟩ := hatombd y hyH hx'atom
    exact ⟨y, hyH, u, hu, hux.symm, hxy⟩
  · intro y hy
    refine ⟨1 + ρ, fun v hv i j => ?_⟩
    have h1 : |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < ρ := (hbddA y hy hv).2 i j
    have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
      rw [Matrix.one_apply]; split <;> simp
    calc |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j|
        = |(((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
          rw [sub_add_cancel]
      _ ≤ |((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ) i j
            - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| :=
          abs_add_le _ _
      _ ≤ ρ + 1 := add_le_add (le_of_lt h1) h2
      _ = 1 + ρ := by ring

/-! ## Monotonicity of the good set -/

theorem CutGood_mono {S : CutData μ U ε} {t : Fin 3 → ℝ} {C μ0 : ℝ} {N N' : ℕ} (h : N ≤ N') :
    CutGood S t C μ0 N ⊆ CutGood S t C μ0 N' := by
  intro y hy
  exact mem_CutGood.mpr ⟨CutGood_subset_cell hy, CutGood_orbit_mem hy, CutGood_free hy,
    fun n hn => CutGood_deep hy (le_trans h hn)⟩

/-! ## The geometric hypotheses at the good set of a cut -/

/-- Entries of elements of `V δ` are at most `1 + δ`. -/
theorem entries_V_bound_c {δ : ℝ} (hδ : 0 < δ) {v : SL3} (hv : v ∈ V δ) (i j : Fin 3) :
    |(v : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 + δ := by
  have h : |(v : Matrix (Fin 3) (Fin 3) ℝ) i j
      - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| < δ := hv i j
  have h2 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| ≤ 1 := by
    rw [Matrix.one_apply]; split <;> simp
  calc |(v : Matrix (Fin 3) (Fin 3) ℝ) i j|
      = |((v : Matrix (Fin 3) (Fin 3) ℝ) i j
          - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) + (1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := by
        ring_nf
    _ ≤ |(v : Matrix (Fin 3) (Fin 3) ℝ) i j - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j|
        + |(1 : Matrix (Fin 3) (Fin 3) ℝ) i j| := abs_add_le _ _
    _ ≤ δ + 1 := add_le_add (le_of_lt h) h2
    _ = 1 + δ := by ring

/-- **The `M`-shapes are relatively open along the orbit of a good point.** -/
theorem cutDataOpenAt_shape {S : CutData μ U ε} {O : ℕ → Set SL3} (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : SL3, ∃ m, z ∈ sat U (O m))
    (hsep : ∀ z w : SL3, (∀ m, (z ∈ sat U (O m) ↔ w ∈ sat U (O m))) → w ∈ sat U ({z}))
    {t : Fin 3 → ℝ} {C μ0 : ℝ} {N : ℕ} {y : X3} (hy : y ∈ CutGood S t C μ0 N) (n : ℕ) :
    ∃ W : Set SL3, IsOpen W ∧
      shape (MCut S O) U (((fun x : X3 => aDiag t • x)^[n]) y) = W ∩ (U : Set SL3) := by
  rcases CutGood_orbit_mem hy n with hmem | hmem
  · obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hmem
    exact isOpen_shape_cut_cell S O hOopen hvis hsep i _ hi
  · obtain ⟨-, hshape⟩ := shape_cut_bad S O hOopen hvis hsep _ hmem
    refine ⟨{u : SL3 | u • (((fun x : X3 => aDiag t • x)^[n]) y) ∈ S.bad},
      S.hbad_open.preimage (by fun_prop), ?_⟩
    rw [hshape]
    ext u
    exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

/-- **The `M`-shape at a good point is bounded.** -/
theorem shape_bdd_at {S : CutData μ U ε} {O : ℕ → Set SL3} (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : SL3, ∃ m, z ∈ sat U (O m))
    (hsep : ∀ z w : SL3, (∀ m, (z ∈ sat U (O m) ↔ w ∈ sat U (O m))) → w ∈ sat U ({z}))
    {t : Fin 3 → ℝ} {C μ0 : ℝ} {N : ℕ} {y : X3} (hy : y ∈ CutGood S t C μ0 N)
    {K : ℝ} (hK : ∀ g ∈ V (10 * S.ρ), ∀ i j,
      |(((g⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ)) i j| ≤ K) :
    shape (MCut S O) U y ⊆ Work.EKLComp.Uball U (3 * (1 + 10 * S.ρ) * K + 2) := by
  classical
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (CutGood_subset_cell hy)
  have hfree : y ∈ cutFree U := CutGood_free hy 0
  have hshape := cutHShapeCell S O hOopen hvis hsep hi hfree
  have hK0 : 0 ≤ K := by
    have h1 : (1 : SL3) ∈ V (10 * S.ρ) := by
      intro a b
      have h10 : (0 : ℝ) < 10 * S.ρ := by linarith [S.hρ]
      have : ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) a b
          = (1 : Matrix (Fin 3) (Fin 3) ℝ) a b := rfl
      rw [this, sub_self, abs_zero]
      exact h10
    have h2 := hK 1 h1 0 0
    have h3 : (1 : ℝ) ≤ K := by simpa using h2
    linarith
  intro u hu
  rw [hshape] at hu
  have huU : u ∈ U := hu.1
  have hulift : u * S.lift i y ∈ shift (V (10 * S.ρ)) (S.g i) := hu.2.2
  obtain ⟨v, hv, hvgi⟩ := hulift
  obtain ⟨w, hw, hwgi⟩ := S.lift_bdd i y hi
  have hwgi' : S.lift i y = w * S.g i := hwgi.symm
  have hu_eq : u = v * w⁻¹ := by
    have h2 : S.lift i y = w * S.g i := hwgi'
    calc u = u * S.lift i y * (S.lift i y)⁻¹ := by group
      _ = v * S.g i * (w * S.g i)⁻¹ := by rw [hvgi, h2]
      _ = v * w⁻¹ := by group
  refine ⟨huU, fun a b => ?_⟩
  have hρ10 : (0 : ℝ) < 10 * S.ρ := by linarith [S.hρ]
  have h1 : |((v * w⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ) a b|
      ≤ 3 * (1 + 10 * S.ρ) * K := by
    have hcoe : (((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ)
        = ((v : SL3) : Matrix (Fin 3) (Fin 3) ℝ)
          * (((w⁻¹ : SL3) : Matrix (Fin 3) (Fin 3) ℝ)) := by
      rw [Matrix.SpecialLinearGroup.coe_mul]
    rw [hcoe]
    exact mul_entries_le_c a b (fun k l => entries_V_bound_c hρ10 hv k l)
      (fun k l => hK w hw k l) (by linarith) hK0
  have h2 : ((u : SL3) : Matrix (Fin 3) (Fin 3) ℝ) a b
      = (((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b := by rw [hu_eq]
  have h3 : |(1 : Matrix (Fin 3) (Fin 3) ℝ) a b| ≤ 1 := by
    rw [Matrix.one_apply]; split <;> simp
  have h4 : |(((u : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b
      - (1 : Matrix (Fin 3) (Fin 3) ℝ) a b| ≤ 3 * (1 + 10 * S.ρ) * K + 1 := by
    rw [h2]
    calc |(((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b
          - (1 : Matrix (Fin 3) (Fin 3) ℝ) a b|
        = |(((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b
            + (-(1 : Matrix (Fin 3) (Fin 3) ℝ) a b)| := by ring_nf
      _ ≤ |(((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b|
          + |(-(1 : Matrix (Fin 3) (Fin 3) ℝ) a b)| := abs_add_le _ _
      _ = |(((v * w⁻¹ : SL3)) : Matrix (Fin 3) (Fin 3) ℝ) a b|
          + |(1 : Matrix (Fin 3) (Fin 3) ℝ) a b| := by rw [abs_neg]
      _ ≤ 3 * (1 + 10 * S.ρ) * K + 1 := add_le_add h1 h3
  linarith

/-- **The `M`-atoms at a good point lie in the `U`-orbit.** -/
theorem atom_subset_orb_at {S : CutData μ U ε} {O : ℕ → Set SL3} (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : SL3, ∃ m, z ∈ sat U (O m))
    (hsep : ∀ z w : SL3, (∀ m, (z ∈ sat U (O m) ↔ w ∈ sat U (O m))) → w ∈ sat U ({z}))
    {t : Fin 3 → ℝ} {C μ0 : ℝ} {N : ℕ} {y : X3} (hy : y ∈ CutGood S t C μ0 N) :
    atom (MCut S O) y ⊆ (fun u : SL3 => u • y) '' (U : Set SL3) := by
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (CutGood_subset_cell hy)
  have hatom : atom (MCut S O) y
      = {w : X3 | w ∈ S.cell i ∧ ∃ u ∈ U, S.lift i w = u * S.lift i y} := by
    have h1 : atom (MCut S O) y = atom (MeasurableSpace.generateFrom (Set.range
        (fun p : Fin S.N × ℕ => genCell S O p.1 p.2) ∪ {S.bad})) y := rfl
    rw [h1]
    exact atom_gen_cut S O hOopen hvis hsep i y hi
  intro w hw
  rw [hatom] at hw
  obtain ⟨hwc, u, huU, hlift⟩ := hw
  refine ⟨u, huU, ?_⟩
  calc u • y = u • mkX (S.lift i y) := by rw [S.lift_mk i y hi]
    _ = mkX (u * S.lift i y) := (Work.EKLContract.Lemmas.mkX_mul u (S.lift i y)).symm
    _ = mkX (S.lift i w) := by rw [hlift]
    _ = w := S.lift_mk i w hwc

/-- **The shrinking-ball margin at a good point.** -/
theorem uball_subset_shape_at {μ : MeasureTheory.Measure X3} [MeasureTheory.IsProbabilityMeasure μ]
    {S : CutData μ U ε} {O : ℕ → Set SL3}
    (hOopen : ∀ m, IsOpen (O m))
    (hvis : ∀ z : SL3, ∃ m, z ∈ sat U (O m))
    (hsep : ∀ z w : SL3, (∀ m, (z ∈ sat U (O m) ↔ w ∈ sat U (O m))) → w ∈ sat U ({z}))
    (huni : ∀ u ∈ U, ((u : Matrix (Fin 3) (Fin 3) ℝ) - 1) ^ 3 = 0)
    {t : Fin 3 → ℝ} {C μ0 : ℝ} (hC : 0 < C) (hμ0 : 0 < μ0)
    {N n : ℕ} {y : X3} (hy : y ∈ CutGood S t C μ0 N) (hn : N ≤ n)
    {c : ℝ} (hc : 0 < c) (hcm : 20 * c ≤ C) (hC1 : C * μ0 ^ n ≤ 1)
    (hρn : c * μ0 ^ n ≤ 10 * S.ρ) :
    Work.EKLComp.Uball U (c * μ0 ^ n) ⊆
      shape (MCut S O) U (((fun x : X3 => aDiag t • x)^[n]) y) := by
  intro u hu
  exact ⟨hu.1, cutHMargin S O hOopen hvis hsep huni hC hμ0 hC1 hy hn hc hcm hρn hu.1 hu.2⟩

/-! ## The final assembly -/

/-- There are arbitrarily small scaling factors: for every `ε > 0` there is `0 < η ≤ 1/2` with
`ofReal η < ε`. -/
theorem exists_eta (ε : ENNReal) (hε : 0 < ε) :
    ∃ η : ℝ, 0 < η ∧ η ≤ 1 / 2 ∧ ENNReal.ofReal η < ε := by
  by_cases htop : ε = ⊤
  · exact ⟨1 / 2, by norm_num, le_rfl, by rw [htop]; exact ENNReal.ofReal_lt_top⟩
  · have hpos : 0 < ε.toReal := ENNReal.toReal_pos hε.ne' htop
    refine ⟨min (ε.toReal / 2) (1 / 2), lt_min (by linarith) (by norm_num), min_le_right _ _, ?_⟩
    calc ENNReal.ofReal (min (ε.toReal / 2) (1 / 2))
        ≤ ENNReal.ofReal (ε.toReal / 2) := ENNReal.ofReal_le_ofReal (min_le_left _ _)
      _ < ENNReal.ofReal ε.toReal := by
          rw [ENNReal.ofReal_lt_ofReal_iff hpos]
          linarith
      _ = ε := ENNReal.ofReal_toReal htop

/-- The arithmetic thresholds: for `μ0 ∈ (0,1)` and any constants `C, c`, all sufficiently large
`n` satisfy `C μ0ⁿ ≤ 1` and `c μ0ⁿ ≤ 10 S.ρ`. -/
theorem exists_N_arith {S : CutData μ U ε} {C c μ0 : ℝ} (hμ0 : 0 < μ0) (hμ01 : μ0 < 1) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → C * μ0 ^ n ≤ 1 ∧ c * μ0 ^ n ≤ 10 * S.ρ := by
  have h1 : Filter.Tendsto (fun n : ℕ => C * μ0 ^ n) Filter.atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hμ0.le hμ01).const_mul C
  have h2 : Filter.Tendsto (fun n : ℕ => c * μ0 ^ n) Filter.atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hμ0.le hμ01).const_mul c
  obtain ⟨N1, hN1⟩ := Filter.eventually_atTop.mp (h1.eventually (isOpen_Iio.mem_nhds zero_lt_one))
  obtain ⟨N2, hN2⟩ := Filter.eventually_atTop.mp (h2.eventually
    (isOpen_Iio.mem_nhds (by linarith [S.hρ] : (0:ℝ) < 10 * S.ρ)))
  exact ⟨max N1 N2, fun n hn => ⟨le_of_lt (hN1 n (le_trans (le_max_left _ _) hn)),
    le_of_lt (hN2 n (le_trans (le_max_right _ _) hn))⟩⟩

/-- **The target from a cut datum.** -/
theorem exists_desc_subordinate_of_cut (μ : MeasureTheory.Measure X3) [IsProbabilityMeasure μ]
    (U : Subgroup SL3) (hU : IsHoro U) (t : Fin 3 → ℝ)
    (hmp : MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto
      (fun n : ℕ => aDiag t ^ n * u * (aDiag t ^ n)⁻¹) Filter.atTop (nhds 1))
    {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1 / 2) (S : CutData μ U η) (ε : ENNReal) (hε : 0 < ε)
    (hεη : ENNReal.ofReal η < ε) :
    ∃ A : MeasurableSpace X3, ∃ Z : Set X3,
      IsPlaqueAlgebra U Z A ∧ μ Zᶜ < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  classical
  obtain ⟨lam, hlam0, hlam1, hlam⟩ := exists_contract_rate t
  have hmu0 : 0 < max ((1 + lam) / 2) (1 / 2) := lt_max_of_lt_right (by norm_num)
  have hmu1 : max ((1 + lam) / 2) (1 / 2) < 1 :=
    max_lt (by linarith) (by norm_num)
  have hlamm : lam < max ((1 + lam) / 2) (1 / 2) :=
    lt_max_of_lt_left (by linarith)
  obtain ⟨O, hOopen, hOvis, hOsep⟩ := exists_base_sat_sep U hU.1
  have huni : ∀ u ∈ U, ((u : Matrix (Fin 3) (Fin 3) ℝ) - 1) ^ 3 = 0 :=
    cutHUnipotent hcontr
  have hfree : ∀ᵐ x ∂μ, x ∈ cutFree U := ae_free_orbit_of_contraction U hU t hmp hcontr
  -- the good set
  obtain ⟨N₁, H, hHmeas, hHsub, hHμ⟩ := cutHGoodExists (μ := μ) (U := U) S (t := t) hmp hfree
    (C := 1) (μ0 := max ((1 + lam) / 2) (1 / 2)) one_pos hmu0 hmu1 S.hbad_small
  -- the arithmetic level
  obtain ⟨N₂, hN₂⟩ := exists_N_arith (S := S) (C := 1) (c := 1 / 20) hmu0 hmu1
  set N : ℕ := max N₁ N₂ with hNdef
  have hHsub' : H ⊆ CutGood S t 1 (max ((1 + lam) / 2) (1 / 2)) N :=
    hHsub.trans (CutGood_mono (le_max_left _ _))
  have hHμcompl : μ Hᶜ < ENNReal.ofReal η := hHμ
  -- an enumeration of the generating family
  obtain ⟨b, hbopen, hbrange⟩ := exists_enum_famAtom S O hOopen
  have hbmeas : ∀ n : ℕ, MeasurableSet (b n) := fun n => (hbopen n).measurableSet
  have hMeq : MCut S O = MeasurableSpace.generateFrom (Set.range b) := by
    rw [MCut, hbrange]
  -- the code map
  have hHle1 : μ H ≤ 1 := by
    calc μ H ≤ μ Set.univ := measure_mono (Set.subset_univ H)
      _ = 1 := measure_univ
  have hcompl : μ Hᶜ = 1 - μ H := by
    rw [measure_compl hHmeas (by simp [hHle1]), measure_univ]
  have hHμ' : 1 - ENNReal.ofReal η < μ H := by
    refine ENNReal.sub_lt_of_sub_lt ?_ (Or.inl ENNReal.one_ne_top) ?_
    · calc ENNReal.ofReal η ≤ ENNReal.ofReal (1 / 2) := ENNReal.ofReal_le_ofReal hη1
        _ ≤ 1 := by norm_num
    · rw [← hcompl]; exact hHμcompl
  obtain ⟨Z, hZmeas, hZsat, hZmeet, hZμ⟩ :=
    cutCodeZ b hbmeas hHmeas μ (ENNReal.ofReal_pos.mpr hη) hHμ'
  -- the entrywise bound for the shapes
  obtain ⟨K, hK⟩ := Work.EKLProd.inv_entries_bound (10 * S.ρ) (by linarith [S.hρ])
  refine ⟨descSig t (MCut S O), Z, ?_, lt_trans hZμ hεη, comap_descSig_le t (MCut S O)⟩
  rw [← hMeq] at hZmeet hZmeas hZsat
  have hZmeet' : ∀ x ∈ Z, ∃ y ∈ H, atom (descSig t (MCut S O)) x
      = atom (descSig t (MCut S O)) y := by
    intro x hx
    obtain ⟨y, hyx, hyH⟩ := hZmeet x hx
    exact ⟨y, hyH, (atom_eq_of_mem_atom_c hyx).symm⟩
  have hZmeas' : MeasurableSet[descSig t (MCut S O)] Z := hZmeas
  have hK0 : 0 ≤ K := by
    have h1 : (1 : SL3) ∈ V (10 * S.ρ) := by
      intro a b
      have h10 : (0 : ℝ) < 10 * S.ρ := by linarith [S.hρ]
      have : ((1 : SL3) : Matrix (Fin 3) (Fin 3) ℝ) a b
          = (1 : Matrix (Fin 3) (Fin 3) ℝ) a b := rfl
      rw [this, sub_self, abs_zero]
      exact h10
    have h2 := hK 1 h1 0 0
    have h3 : (1 : ℝ) ≤ K := by simpa using h2
    linarith
  refine isPlaqueAlgebra_descSig (U := U) (t := t) (M := MCut S O) (b := Set.range b)
    (H := H) (Z := Z) (ρ := 3 * (1 + 10 * S.ρ) * K + 2) (c := 1 / 20)
    (mu := max ((1 + lam) / 2) (1 / 2)) (lam := lam) (N := N)
    hU (Set.countable_range b) hMeq (MCut_le_borel S O hOopen) (by nlinarith [hK0, S.hρ]) (by norm_num)
    (le_of_lt hlam0) hlamm hmu1
    (fun n u huU hu => conj_pow_mem_Uball (U := U) (t := t) hU hcontr hlam0 hlam hu n)
    (fun y hy n => cutDataOpenAt_shape (S := S) (O := O) (t := t) (C := 1)
      (μ0 := max ((1 + lam) / 2) (1 / 2)) (N := N) (y := y) hOopen hOvis hOsep (hHsub' hy) n)
    (fun y hy => shape_bdd_at (S := S) (O := O) (t := t) (C := 1)
      (μ0 := max ((1 + lam) / 2) (1 / 2)) (N := N) (y := y) hOopen hOvis hOsep
      (hHsub' hy) hK)
    (fun y hy n hn => uball_subset_shape_at (S := S) (O := O) (t := t) (C := 1)
      (μ0 := max ((1 + lam) / 2) (1 / 2)) (N := N) (n := n) (y := y) (c := 1 / 20)
      hOopen hOvis hOsep huni one_pos hmu0 (hHsub' hy) hn (by norm_num) (by norm_num)
      (by simpa using pow_le_one₀ (le_of_lt hmu0) (le_of_lt hmu1))
      (hN₂ n (le_trans (le_max_right _ _) hn)).2)
    (fun y hy => atom_subset_orb_at (S := S) (O := O) (t := t) (C := 1)
      (μ0 := max ((1 + lam) / 2) (1 / 2)) (N := N) (y := y) hOopen hOvis hOsep (hHsub' hy))
    hZmeas' hZsat hZmeet'

/-- **`Work.EKLC6Core.exists_desc_subordinate`** from the existence of a cut datum. -/
theorem exists_desc_subordinate_from_cut (μ : MeasureTheory.Measure X3)
    [IsProbabilityMeasure μ] (U : Subgroup SL3) (hU : IsHoro U) (t : Fin 3 → ℝ)
    (hmp : MeasurePreserving (fun x : X3 => aDiag t • x) μ μ)
    (hcontr : ∀ u ∈ U, Filter.Tendsto
      (fun n : ℕ => aDiag t ^ n * u * (aDiag t ^ n)⁻¹) Filter.atTop (nhds 1)) :
    ∀ ε : ENNReal, 0 < ε →
      ∃ A : MeasurableSpace X3, ∃ Z : Set X3,
      IsPlaqueAlgebra U Z A ∧ μ (Zᶜ) < ε ∧
        MeasurableSpace.comap (fun x : X3 => aDiag t • x) A ≤ A := by
  intro ε hε
  obtain ⟨η, hη0, hη1, hηε⟩ := exists_eta ε hε
  obtain ⟨S⟩ := cutHCutData μ U η hη0
  exact exists_desc_subordinate_of_cut μ U hU t hmp hcontr hη0 hη1 S ε hε hηε

end Work.EKLC6Core
