import Mathlib
import Submission.Work.EKLC6Core.Basic
import Submission.Work.EKLC6Core.uminus_isHoro
import Submission.Work.EKLContract.Lemmas.isHoro_Upar

/-!
# `EKLC6Core.mem_uminus_of_entry_form`

The converse of `Work.EKLC6Core.uminus_entry_zero`: an element `g ∈ SL₃(ℝ)` whose diagonal
entries are `1` and whose `(i,j)`-entry vanishes whenever `t j ≤ t i` (`i ≠ j`) lies in

`Uminus t = ⨆_{t i < t j} U_ij`,

the subgroup generated by the root groups contracted by `aDiag t`.

## Proof

Sort the three values of `t`: there are indices `p, q, r` (a permutation of `Fin 3`) with
`t p ≤ t q ≤ t r` (`Work.EKLC6Core.exists_sorted`).  By `Work.EKLC6Core.pair_of_lt_sorted`,
the only off-diagonal positions that `hzero` does *not* force to vanish are `(p,q)`, `(p,r)`
and `(q,r)`; hence `g` has the shape

`1 + A E_pq + C E_qr + B E_pr`,  `A = g p q`, `C = g q r`, `B = g p r`

(`toMat_eq_shapeMat`, with `a = p`, `b = r`, `c = q`).  That matrix is the product

`u_pq(A) · u_qr(C) · u_pr(B - A C)`

(`toMat_uij_three`, the `U_(ab)`-parametrisation of the fleet s `isHoro_Upar`), and each of
the three factors lies in `Uminus t`: a factor with `t i < t j` is a contracted root element
(`mem_uminus_of_uij`), and when `t i = t j` the corresponding entry of `g` vanishes by
`hzero`, so the factor is `1`.
-/

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-! ## The underlying matrix of `u_pq(A) · u_qr(C) · u_pr(B - A C)` -/

/-- The product `u_pq(A) · u_qr(C) · u_pr(B - A C)` of the three elementary transvections of a
unitriangular matrix in the coordinates `(p, q, r)` has underlying matrix
`1 + A E_pq + C E_qr + B E_pr`; in the normal form `shapeMat` of `isHoro_Upar` this is
`shapeMat p r q A C B` (there `a = p`, `b = r`, `c = q`). -/
theorem toMat_uij_three {p q r : Fin 3} (hpq : p ≠ q) (hqr : q ≠ r) (hpr : p ≠ r)
    (A B C : ℝ) :
    toMat (uij hpq A * uij hqr C * uij hpr (B - A * C)) =
      Work.EKLContract.Lemmas.shapeMat p r q A C B := by
  have key : uij hpq A * uij hqr C * uij hpr (B - A * C)
      = Work.EKLContract.Lemmas.uparShape hpr hpq hqr (B - A * C) A C := rfl
  rw [key, Work.EKLContract.Lemmas.toMat_uparShape (a := p) (b := r) (c := q) hpr hpq hqr
    (B - A * C) A C]
  rw [show (B - A * C) + A * C = B from by ring]

/-! ## The target -/

theorem mem_uminus_of_entry_form {t : Fin 3 → ℝ} {g : Work.EKLContract.SL3}
    (hdiag : ∀ i : Fin 3, (g : Matrix (Fin 3) (Fin 3) ℝ) i i = 1)
    (hzero : ∀ i j : Fin 3, i ≠ j → t j ≤ t i →
      (g : Matrix (Fin 3) (Fin 3) ℝ) i j = 0) :
    g ∈ Work.EKLC6Core.Uminus t := by
  obtain ⟨p, q, r, hpq, hpr, hqr, h1, h2⟩ := exists_sorted t
  have hdiag : ∀ i : Fin 3, toMat g i i = 1 := fun i => hdiag i
  have hzero : ∀ i j : Fin 3, i ≠ j → t j ≤ t i → toMat g i j = 0 :=
    fun i j hij hle => hzero i j hij hle
  -- `g` has the shape `1 + A E_pq + C E_qr + B E_pr`
  have ha : toMat g = Work.EKLContract.Lemmas.shapeMat p r q
      (toMat g p q) (toMat g q r) (toMat g p r) :=
    Work.EKLContract.Lemmas.toMat_eq_shapeMat (a := p) (b := r) (c := q) hpr hpq hqr g
      (hzero q p hpq.symm h1)
      (hzero r p hpr.symm (le_trans h1 h2))
      (hzero r q hqr.symm h2)
      (hdiag p) (hdiag q) (hdiag r)
  -- ... and that shape is a product of three transvections
  have hb : toMat (uij hpq (toMat g p q) * uij hqr (toMat g q r)
      * uij hpr (toMat g p r - toMat g p q * toMat g q r))
      = Work.EKLContract.Lemmas.shapeMat p r q (toMat g p q) (toMat g q r) (toMat g p r) :=
    toMat_uij_three hpq hqr hpr (toMat g p q) (toMat g p r) (toMat g q r)
  have hg : g = uij hpq (toMat g p q) * uij hqr (toMat g q r)
      * uij hpr (toMat g p r - toMat g p q * toMat g q r) :=
    ext_toMat (ha.trans hb.symm)
  have hA : uij hpq (toMat g p q) ∈ Uminus t := by
    rcases lt_or_eq_of_le h1 with hlt | heq
    · exact mem_uminus_of_uij t hpq hlt _
    · rw [hzero p q hpq (le_of_eq heq.symm), Work.EKLContract.Lemmas.horoUij_zero hpq]
      exact Subgroup.one_mem _
  have hC : uij hqr (toMat g q r) ∈ Uminus t := by
    rcases lt_or_eq_of_le h2 with hlt | heq
    · exact mem_uminus_of_uij t hqr hlt _
    · rw [hzero q r hqr (le_of_eq heq.symm), Work.EKLContract.Lemmas.horoUij_zero hqr]
      exact Subgroup.one_mem _
  have hB : uij hpr (toMat g p r - toMat g p q * toMat g q r) ∈ Uminus t := by
    rcases lt_or_eq_of_le (le_trans h1 h2) with hlt | heq
    · exact mem_uminus_of_uij t hpr hlt _
    · have hB0 : toMat g p r = 0 := hzero p r hpr (le_of_eq heq.symm)
      have hC0 : toMat g q r = 0 := hzero q r hqr (by rw [← heq]; exact h1)
      rw [hB0, hC0]
      simp only [mul_zero, sub_zero, Work.EKLContract.Lemmas.horoUij_zero hpr]
      exact Subgroup.one_mem _
  rw [hg]
  exact mul_mem (mul_mem hA hC) hB

end Work.EKLC6Core
