import Mathlib
import Submission.Work.EKLC6Core.CellSysDefs
import Submission.Work.EKLC6Core.exists_base_sat_sep

/-!
# `Work.EKLC6Core.CellWDefs` — the usable cell system

`Work.EKLC6Core.CellSys` carries two fields that are **never used** by the atom/shape/margin
machinery and are in fact **unsatisfiable / refutable**:

* `hgood` (no lattice correction in the lifted ball) is unsatisfiable as soon as the
  `U`-periodic set is dense: if `mkX h` is `U`-periodic and `g' = w * h` with `w⁻¹ ∈ V δ`, then
  `u₀ * w⁻¹ * g' = w⁻¹ * g' * γ₀` with `u₀ ∈ U`, `u₀ ≠ 1`, `γ₀ ∈ Γ₃`, `γ₀ ≠ 1`;
* `hthin` (power-law thin boundary) fails for `aDiag t`-invariant Dirac combinations at
  super-exponentially deep cusp points.

This module isolates the *usable* residue: the cells, their scales, their centres, openness,
disjointness, conull coverage, the containment in the lifted half-ball, and the injectivity of
`mkX` on the lifted ball.  All the atom/shape lemmas (`atom_MSig`, `shape_MSig_open`,
`shape_MSig_bdd`, `shape_MSig_uball`, `margin_of_uncrossed`, `Z0_cellsys_conull`) are re-proved
for this structure (they never touch `hgood` or `hthin`).
-/

open MeasureTheory Filter Topology
open scoped ENNReal Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLC6Core

open Work.EKLContract

/-- The **usable cell system**: exactly the geometric residue of `CellSys` which the assembly
consumes. -/
structure CellW (μ : MeasureTheory.Measure X3) (U : Subgroup SL3) where
  /-- the cells -/
  Q : ℕ → Set X3
  hopen : ∀ k, IsOpen (Q k)
  hdisj : ∀ k l, k ≠ l → Disjoint (Q k) (Q l)
  hcover : μ ((⋃ k, Q k))ᶜ = 0
  /-- the radii -/
  δ : ℕ → ℝ
  hδpos : ∀ k, 0 < δ k
  hδsmall : ∀ k, δ k ≤ 1 / 16
  /-- the centres, as lifts -/
  g : ℕ → SL3
  hsub : ∀ k, Q k ⊆ (fun v : SL3 => v • mkX (g k)) '' (V (δ k / 2))
  /-- injectivity of `mkX` on the lifted ball -/
  hinj : ∀ k (v₁ v₂ : SL3), v₁ ∈ V (4 * δ k) → v₂ ∈ V (4 * δ k) →
    v₁ • mkX (g k) = v₂ • mkX (g k) → v₁ = v₂

variable {μ : MeasureTheory.Measure X3} {U : Subgroup SL3}

/-- The **clipped** cylinder generator of the `k`-th cell. -/
def genCW (S : CellW μ U) (O : ℕ → Set SL3) (k m : ℕ) : Set X3 :=
  mkX '' (satU U (O m) ∩ lifted (S.δ k) (S.g k)) ∩ S.Q k

/-- The generating family of the cell system. -/
def famW (S : CellW μ U) (O : ℕ → Set SL3) : Set (Set X3) :=
  Set.range S.Q ∪ Set.range (fun p : ℕ × ℕ => genCW S O p.1 p.2)

/-- The σ-algebra generated by the cell system and the cylinders. -/
def MSigW (S : CellW μ U) (O : ℕ → Set SL3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom (famW S O)

/-- The lift of a point of a cell. -/
noncomputable def liftW (S : CellW μ U) (k : ℕ) (y : X3) : SL3 := by
  classical
  exact if h : y ∈ S.Q k then Classical.choose (S.hsub k h) * S.g k else 1

/-- The lift of a point of a cell lies in the lifted ball. -/
theorem liftW_mem (S : CellW μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    liftW S k y ∈ lifted (S.δ k) (S.g k) := by
  classical
  obtain ⟨hch1, -⟩ := Classical.choose_spec (S.hsub k hy)
  have hch1' : Classical.choose (S.hsub k hy) ∈ V (S.δ k) := V_mono' (by linarith [S.hδpos k]) hch1
  rw [liftW, dif_pos hy]
  exact ⟨Classical.choose (S.hsub k hy), hch1', rfl⟩

/-- The lift of a point of a cell maps back to that point. -/
theorem mkX_liftW (S : CellW μ U) (k : ℕ) {y : X3} (hy : y ∈ S.Q k) :
    mkX (liftW S k y) = y := by
  classical
  obtain ⟨-, hch2⟩ := Classical.choose_spec (S.hsub k hy)
  have hch2' : Classical.choose (S.hsub k hy) • mkX (S.g k) = y := hch2
  rw [liftW, dif_pos hy]
  exact hch2'

/-- `mkX` is injective on a lifted ball. -/
theorem mkX_inj_liftedW (S : CellW μ U) (k : ℕ) {a b : SL3}
    (ha : a ∈ lifted (S.δ k) (S.g k)) (hb : b ∈ lifted (S.δ k) (S.g k))
    (h : mkX a = mkX b) : a = b := by
  obtain ⟨v₁, hv₁, h1⟩ := ha
  obtain ⟨v₂, hv₂, h2⟩ := hb
  have hv4 : v₁ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₁
  have hv4' : v₂ ∈ V (4 * S.δ k) := V_mono' (by linarith [S.hδpos k]) hv₂
  have e1 : v₁ * S.g k = a := h1
  have e2 : v₂ * S.g k = b := h2
  have h1' : v₁ • mkX (S.g k) = mkX a := by
    change mkX (v₁ * S.g k) = mkX a
    rw [e1]
  have h2' : v₂ • mkX (S.g k) = mkX b := by
    change mkX (v₂ * S.g k) = mkX b
    rw [e2]
  have hmk : v₁ • mkX (S.g k) = v₂ • mkX (S.g k) := by rw [h1', h2', h]
  have hv : v₁ = v₂ := S.hinj k v₁ v₂ hv4 hv4' hmk
  rw [← e1, ← e2, hv]

end Work.EKLC6Core
