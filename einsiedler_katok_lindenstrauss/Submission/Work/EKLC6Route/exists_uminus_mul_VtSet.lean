import Mathlib
import Submission.Work.EKLC6Route.Defs
import Submission.Work.EKLC6Core.uminus_isHoro
import Submission.Work.EKLC6Core.mem_uminus_of_entry_form
import Submission.Work.EKLC6Core.UminusChartDefs

/-!
# The big-cell decomposition `G = U⁻(t) · G⁰G⁺(t)` near the identity

For `t : Fin 3 → ℝ` and `s > 0` small, every `g ∈ V s` (i.e. every matrix within sup-norm `s`
of the identity) can be written

`g = u * k`,  `u ∈ Uminus t` with `|u - 1| ≤ 2 s`,  `k ∈ VtSet t` with `|k - 1| ≤ 2 s`.

Here `Uminus t` is the horospherical subgroup generated by the root groups `U_ij` with
`t i < t j` ("contracted" positions) and `VtSet t` is the parabolic group of matrices vanishing
at those positions.

## Method

The decomposition is the "block Gauss decomposition" `g = (1+a)(1+b)` with `a` supported on the
strictly contracted positions `C = {t i < t j}` and `b` supported on the complementary
"parabolic" positions `p = {t j ≤ t i}`.  Instead of writing explicit formulas for `a` and `b`
(which depend on the order pattern of `t` and on its ties), we solve the equation
`a + b + a·b = M` (`M = g - 1`) by a **fixed point argument in the sup-norm**:  the linear part
of the map `(a,b) ↦ a + b + ab` is the identity (the two supports `C` and `p` are complementary
direct summands of the space of `3×3` matrices) and the quadratic part is bounded by
`|ab| ≤ 3 |a| |b|`, so the map `Φ(a,b) = (π_C(M - ab), π_p(M - ab))` is a contraction of the
closed ball of radius `2s` by the Banach fixed point theorem.

The determinant of the unipotent factor is `1` because `1 + a` has zero trace, zero trace of its
square (the support condition `t i < t j` has no cycles) and zero determinant, which is plugged
into the classical identity
`2 det (1 + N) = 2 + 2 tr N + (tr N)² - tr (N²) + 2 det N` for `3 × 3` matrices.

The parabolic factor is then fixed by `(1+a) * (1+b) = g`, and it has determinant `1` for free
because `det (1+a) = 1` and `det g = 1`.
-/

open Matrix
open scoped NNReal

set_option linter.unusedVariables false

noncomputable section

namespace Work.EKLC6Route

namespace Decomp

/-- `3 × 3` real matrices, viewed as functions of the two indices (so that the sup-norm metric
of the pi type is available; `Matrix` has no metric instance of its own). -/
abbrev Mat := Fin 3 → Fin 3 → ℝ

/-- The unit matrix, as an element of `Mat`. -/
def oneMat : Mat := fun i j => if i = j then (1 : ℝ) else 0

/-- The matrix product, written on `Mat`. -/
def mmul (A B : Mat) : Mat := fun i j => ∑ k, A i k * B k j

theorem of_oneMat : Matrix.of oneMat = (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
  ext i j; simp [oneMat, Matrix.one_apply]

theorem of_mmul (A B : Mat) : Matrix.of (mmul A B) = Matrix.of A * Matrix.of B := by
  ext i j; simp [mmul, Matrix.mul_apply]

theorem of_add (A B : Mat) : Matrix.of (A + B) = Matrix.of A + Matrix.of B := by
  ext i j; simp

/-! ## The determinant of the unipotent factor -/

/-- The characteristic-polynomial identity `det (1 + N) = 1 + tr N + e₂(N) + det N` for `3 × 3`
matrices, in the form `2 det (1+N) = 2 + 2 tr N + (tr N)² - tr(N²) + 2 det N`. -/
theorem det_one_add_three (N : Mat) :
    2 * Matrix.det (1 + Matrix.of N) = 2 + 2 * (Matrix.of N).trace + (Matrix.of N).trace ^ 2
      - (Matrix.of N * Matrix.of N).trace + 2 * Matrix.det (Matrix.of N) := by
  simp (config := {decide := true}) only [Matrix.det_fin_three, Matrix.trace, Matrix.diag_apply,
    Matrix.mul_apply, Fin.sum_univ_three, Matrix.add_apply, Matrix.one_apply, reduceIte,
    Matrix.of_apply]
  ring

/-- The three factors of a cyclic product `a i j * a j l * a l i` all vanish when `a` is supported
on the strictly contracted positions (`a i j ≠ 0` forces `t i < t j`), because the three
inequalities `t i < t j < t l < t i` are incompatible. -/
theorem cycle_mul_eq_zero {t : Fin 3 → ℝ} {a : Mat} (ha : ∀ i j, ¬ (t i < t j) → a i j = 0)
    (i j l : Fin 3) : a i j * a j l * a l i = 0 := by
  by_cases h1 : a i j = 0
  · rw [h1, zero_mul, zero_mul]
  by_cases h2 : a j l = 0
  · rw [h2, mul_zero, zero_mul]
  by_cases h3 : a l i = 0
  · rw [h3, mul_zero]
  exfalso
  have hij : t i < t j := by by_contra h; exact h1 (ha i j h)
  have hjl : t j < t l := by by_contra h; exact h2 (ha j l h)
  have hli : t l < t i := by by_contra h; exact h3 (ha l i h)
  linarith

/-- **The unipotent factor has determinant one.**  If `a` vanishes off the strictly contracted
positions `t i < t j`, then `1 + a` has determinant `1`: its diagonal, hence its trace, vanishes,
`a * a` again vanishes off the contracted positions (so has zero trace), and `a` has zero
determinant. -/
theorem det_one_add_eq_one {t : Fin 3 → ℝ} {a : Mat}
    (ha : ∀ i j, ¬ (t i < t j) → a i j = 0) :
    Matrix.det (1 + Matrix.of a) = 1 := by
  have hdiag : ∀ i, a i i = 0 := fun i => ha i i (lt_irrefl (t i))
  have htr : (Matrix.of a).trace = 0 := by
    simp only [Matrix.trace, Matrix.diag_apply, Matrix.of_apply, Fin.sum_univ_three]
    rw [hdiag 0, hdiag 1, hdiag 2]
    norm_num
  have htr2 : (Matrix.of a * Matrix.of a).trace = 0 := by
    simp only [Matrix.trace, Matrix.diag_apply, Matrix.mul_apply, Matrix.of_apply]
    refine Finset.sum_eq_zero fun i _ => ?_
    refine Finset.sum_eq_zero fun k _ => ?_
    rcases lt_or_ge (t i) (t k) with hlt | hge
    · rw [ha k i (not_lt.mpr (le_of_lt hlt)), mul_zero]
    · rw [ha i k (not_lt.mpr hge), zero_mul]
  have hdet : Matrix.det (Matrix.of a) = 0 := by
    rw [Matrix.det_fin_three]
    have h1' : a 0 1 * a 1 2 * a 2 0 = 0 := cycle_mul_eq_zero ha 0 1 2
    have h2' : a 0 2 * a 1 0 * a 2 1 = 0 := by
      rw [show a 0 2 * a 1 0 * a 2 1 = a 0 2 * a 2 1 * a 1 0 by ring,
        cycle_mul_eq_zero ha 0 2 1]
    simp only [Matrix.of_apply]
    rw [hdiag 0, hdiag 1, hdiag 2, h1', h2']
    ring
  have := det_one_add_three a
  rw [htr, htr2, hdet] at this
  linarith

/-! ## Entrywise estimates for the sup-norm -/

theorem abs_apply_le_of_dist_le {A B : Mat} {r : ℝ} (h : dist A B ≤ r) (i j : Fin 3) :
    |A i j - B i j| ≤ r := by
  have h0 : 0 ≤ r := le_trans dist_nonneg h
  have h1 : dist (A i) (B i) ≤ r := (dist_pi_le_iff h0).mp h i
  have h2 : dist (A i j) (B i j) ≤ r := (dist_pi_le_iff h0).mp h1 j
  rwa [Real.dist_eq] at h2

theorem dist_le_of_abs_sub_le {A B : Mat} {r : ℝ} (hr : 0 ≤ r)
    (h : ∀ i j, |A i j - B i j| ≤ r) : dist A B ≤ r := by
  rw [dist_pi_le_iff hr]
  intro i
  rw [dist_pi_le_iff hr]
  intro j
  rw [Real.dist_eq]
  exact h i j

theorem abs_apply_le_of_dist_zero_le {A : Mat} {r : ℝ} (h : dist A 0 ≤ r) (i j : Fin 3) :
    |A i j| ≤ r := by
  simpa using abs_apply_le_of_dist_le h i j

/-! ## The two complementary projections -/

/-- The part of a matrix supported on the strictly contracted positions `t i < t j`. -/
def onC (t : Fin 3 → ℝ) (A : Mat) : Mat := fun i j => if t i < t j then A i j else 0

/-- The part of a matrix supported on the complementary ("parabolic") positions `¬ (t i < t j)`,
i.e. `t j ≤ t i`. -/
def onP (t : Fin 3 → ℝ) (A : Mat) : Mat := fun i j => if t i < t j then 0 else A i j

theorem onC_add_onP (t : Fin 3 → ℝ) (A : Mat) : onC t A + onP t A = A := by
  ext i j; by_cases h : t i < t j <;> simp [onC, onP, h]

theorem onC_sub (t : Fin 3 → ℝ) (A B : Mat) : onC t (A - B) = onC t A - onC t B := by
  ext i j; by_cases h : t i < t j <;> simp [onC, h]

theorem onP_sub (t : Fin 3 → ℝ) (A B : Mat) : onP t (A - B) = onP t A - onP t B := by
  ext i j; by_cases h : t i < t j <;> simp [onP, h]

theorem abs_onC_le (t : Fin 3 → ℝ) (A : Mat) (i j : Fin 3) : |onC t A i j| ≤ |A i j| := by
  by_cases h : t i < t j <;> simp [onC, h]

theorem abs_onP_le (t : Fin 3 → ℝ) (A : Mat) (i j : Fin 3) : |onP t A i j| ≤ |A i j| := by
  by_cases h : t i < t j <;> simp [onP, h]

theorem dist_onC_le (t : Fin 3 → ℝ) (A B : Mat) : dist (onC t A) (onC t B) ≤ dist A B := by
  refine dist_le_of_abs_sub_le dist_nonneg (fun i j => ?_)
  have h : onC t A i j - onC t B i j = onC t (A - B) i j := by
    by_cases hh : t i < t j <;> simp [onC, hh]
  rw [h]; exact le_trans (abs_onC_le t (A - B) i j) (abs_apply_le_of_dist_le (le_refl _) i j)

theorem dist_onP_le (t : Fin 3 → ℝ) (A B : Mat) : dist (onP t A) (onP t B) ≤ dist A B := by
  refine dist_le_of_abs_sub_le dist_nonneg (fun i j => ?_)
  have h : onP t A i j - onP t B i j = onP t (A - B) i j := by
    by_cases hh : t i < t j <;> simp [onP, hh]
  rw [h]; exact le_trans (abs_onP_le t (A - B) i j) (abs_apply_le_of_dist_le (le_refl _) i j)

/-! ## The quadratic estimates -/

theorem abs_mmul_entry_le {A B : Mat} {rA rB : ℝ} (hrA : 0 ≤ rA) (hrB : 0 ≤ rB)
    (hA : ∀ i j, |A i j| ≤ rA) (hB : ∀ i j, |B i j| ≤ rB) (i j : Fin 3) :
    |mmul A B i j| ≤ 3 * rA * rB := by
  simp only [mmul]
  calc |∑ k, A i k * B k j| ≤ ∑ k, |A i k * B k j| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ _k : Fin 3, rA * rB := by
        refine Finset.sum_le_sum fun k _ => ?_
        rw [abs_mul]
        exact mul_le_mul (hA i k) (hB k j) (abs_nonneg _) hrA
    _ = 3 * rA * rB := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin]; ring

theorem abs_mmul_sub_entry_le {A B A' B' : Mat} {rA rB : ℝ} (hrA : 0 ≤ rA) (hrB : 0 ≤ rB)
    (hA : ∀ i j, |A i j| ≤ rA) (hB' : ∀ i j, |B' i j| ≤ rB) (i j : Fin 3) :
    |(mmul A B - mmul A' B') i j| ≤ 3 * rA * dist B B' + 3 * rB * dist A A' := by
  have hdec : mmul A B - mmul A' B' = mmul A (B - B') + mmul (A - A') B' := by
    ext i j
    simp only [mmul, Pi.sub_apply, Pi.add_apply]
    rw [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun k _ => by ring
  have hBB' : ∀ k l, |(B - B') k l| ≤ dist B B' := fun k l => by
    simpa using abs_apply_le_of_dist_le (le_refl (dist B B')) k l
  have hAA' : ∀ k l, |(A - A') k l| ≤ dist A A' := fun k l => by
    simpa using abs_apply_le_of_dist_le (le_refl (dist A A')) k l
  rw [hdec, Pi.add_apply]
  calc |mmul A (B - B') i j + mmul (A - A') B' i j|
      ≤ |mmul A (B - B') i j| + |mmul (A - A') B' i j| := abs_add_le _ _
    _ ≤ 3 * rA * dist B B' + 3 * dist A A' * rB :=
        add_le_add (abs_mmul_entry_le hrA dist_nonneg hA hBB' i j)
          (abs_mmul_entry_le dist_nonneg hrB hAA' hB' i j)
    _ = 3 * rA * dist B B' + 3 * rB * dist A A' := by ring

theorem dist_mmul_le {R : ℝ} (hR : 0 ≤ R) {A B A' B' : Mat}
    (hA : ∀ i j, |A i j| ≤ R) (hB' : ∀ i j, |B' i j| ≤ R) :
    dist (mmul A B) (mmul A' B') ≤ 6 * R * dist (A, B) (A', B') := by
  have h1 : dist (mmul A B) (mmul A' B') ≤ 3 * R * dist B B' + 3 * R * dist A A' :=
    dist_le_of_abs_sub_le (by positivity) (fun i j => abs_mmul_sub_entry_le hR hR hA hB' i j)
  have hdx : dist A A' ≤ dist (A, B) (A', B') := by rw [Prod.dist_eq]; exact le_max_left _ _
  have hdy : dist B B' ≤ dist (A, B) (A', B') := by rw [Prod.dist_eq]; exact le_max_right _ _
  have h2 : 3 * R * dist B B' ≤ 3 * R * dist (A, B) (A', B') :=
    mul_le_mul_of_nonneg_left hdy (by positivity)
  have h3 : 3 * R * dist A A' ≤ 3 * R * dist (A, B) (A', B') :=
    mul_le_mul_of_nonneg_left hdx (by positivity)
  linarith

/-! ## The fixed point -/

/-- The fixed point map: subtract the quadratic term `a·b` from `M` and re-project. -/
def Phi (t : Fin 3 → ℝ) (M : Mat) (x : Mat × Mat) : Mat × Mat :=
  (onC t (M - mmul x.1 x.2), onP t (M - mmul x.1 x.2))

theorem pair_entry_le {R : ℝ} {z : Mat × Mat} (hz : dist z 0 ≤ R) :
    (∀ i j, |z.1 i j| ≤ R) ∧ (∀ i j, |z.2 i j| ≤ R) := by
  have h1 : dist z.1 (0 : Mat) ≤ R := by
    have h := hz; rw [Prod.dist_eq] at h; exact le_trans (le_max_left _ _) h
  have h2 : dist z.2 (0 : Mat) ≤ R := by
    have h := hz; rw [Prod.dist_eq] at h; exact le_trans (le_max_right _ _) h
  exact ⟨fun i j => abs_apply_le_of_dist_zero_le h1 i j,
    fun i j => abs_apply_le_of_dist_zero_le h2 i j⟩

theorem Phi_lipschitz (t : Fin 3 → ℝ) {M : Mat} {s : ℝ} (hs : 0 < s) (hs1 : s ≤ 1 / 100)
    (hM : ∀ i j, |M i j| ≤ s) {x y : Mat × Mat}
    (hx : dist x 0 ≤ 2 * s) (hy : dist y 0 ≤ 2 * s) :
    dist (Phi t M x) (Phi t M y) ≤ (1 / 4) * dist x y := by
  have hR : 0 ≤ 2 * s := by linarith
  obtain ⟨hx1, hx2⟩ := pair_entry_le hx
  obtain ⟨hy1, hy2⟩ := pair_entry_le hy
  have hMx : dist (mmul x.1 x.2) (mmul y.1 y.2) ≤ 6 * (2 * s) * dist x y :=
    dist_mmul_le hR hx1 hy2
  have hstep : dist (Phi t M x) (Phi t M y) ≤ dist (M - mmul x.1 x.2) (M - mmul y.1 y.2) := by
    rw [Prod.dist_eq]
    exact max_le (dist_onC_le t _ _) (dist_onP_le t _ _)
  have hstep2 : dist (M - mmul x.1 x.2) (M - mmul y.1 y.2) ≤
      dist (mmul x.1 x.2) (mmul y.1 y.2) := by
    refine dist_le_of_abs_sub_le dist_nonneg (fun i j => ?_)
    have h : (M - mmul x.1 x.2) i j - (M - mmul y.1 y.2) i j
        = mmul y.1 y.2 i j - mmul x.1 x.2 i j := by
      simp only [Pi.sub_apply]; ring
    rw [h, abs_sub_comm]
    exact abs_apply_le_of_dist_le (le_refl _) i j
  have hfin : 6 * (2 * s) * dist x y ≤ (1 / 4) * dist x y := by
    have h6 : 6 * (2 * s) ≤ (1 / 4) := by linarith
    exact mul_le_mul_of_nonneg_right h6 dist_nonneg
  linarith [hstep, hstep2, hMx, hfin]

theorem Phi_mapsTo (t : Fin 3 → ℝ) {M : Mat} {s : ℝ} (hs : 0 < s) (hs1 : s ≤ 1 / 100)
    (hM : ∀ i j, |M i j| ≤ s) :
    Set.MapsTo (Phi t M) (Metric.closedBall (0 : Mat × Mat) (2 * s))
      (Metric.closedBall (0 : Mat × Mat) (2 * s)) := by
  intro x hx
  rw [Metric.mem_closedBall] at hx ⊢
  have hR : 0 ≤ 2 * s := by linarith
  obtain ⟨hx1, hx2⟩ := pair_entry_le hx
  have hle : s + 3 * (2 * s) * (2 * s) ≤ 2 * s := by nlinarith
  have hbound : ∀ i j, |(Phi t M x).1 i j| ≤ 2 * s ∧ |(Phi t M x).2 i j| ≤ 2 * s := by
    intro i j
    have hmul : |mmul x.1 x.2 i j| ≤ 3 * (2 * s) * (2 * s) :=
      abs_mmul_entry_le hR hR hx1 hx2 i j
    have hsub : |(M - mmul x.1 x.2) i j| ≤ s + 3 * (2 * s) * (2 * s) := by
      have h : |M i j - mmul x.1 x.2 i j| ≤ |M i j| + |mmul x.1 x.2 i j| := by
        calc |M i j - mmul x.1 x.2 i j| = |M i j + (-(mmul x.1 x.2 i j))| := by ring_nf
          _ ≤ |M i j| + |-(mmul x.1 x.2 i j)| := abs_add_le _ _
          _ = |M i j| + |mmul x.1 x.2 i j| := by rw [abs_neg]
      simp only [Pi.sub_apply]
      linarith [hM i j, hmul, h]
    exact ⟨le_trans (abs_onC_le t _ i j) (le_trans hsub hle),
      le_trans (abs_onP_le t _ i j) (le_trans hsub hle)⟩
  rw [Prod.dist_eq]
  refine max_le ?_ ?_
  · refine dist_le_of_abs_sub_le hR (fun i j => ?_)
    simpa using (hbound i j).1
  · refine dist_le_of_abs_sub_le hR (fun i j => ?_)
    simpa using (hbound i j).2

/-- The Banach fixed point of `Phi` in the closed ball of radius `2s`. -/
theorem exists_fixpoint (t : Fin 3 → ℝ) {M : Mat} {s : ℝ} (hs : 0 < s) (hs1 : s ≤ 1 / 100)
    (hM : ∀ i j, |M i j| ≤ s) :
    ∃ x : Mat × Mat, x ∈ Metric.closedBall (0 : Mat × Mat) (2 * s) ∧
      Function.IsFixedPt (Phi t M) x := by
  have hmap := Phi_mapsTo t hs hs1 hM
  have hcontr : ContractingWith (1 / 4 : ℝ≥0)
      (hmap.restrict (Phi t M) (Metric.closedBall (0 : Mat × Mat) (2 * s))
        (Metric.closedBall (0 : Mat × Mat) (2 * s))) := by
    refine ⟨by norm_num, LipschitzWith.of_dist_le_mul (fun x y => ?_)⟩
    show dist (Phi t M x.1) (Phi t M y.1) ≤ (1 / 4 : ℝ) * dist (x.1) (y.1)
    exact Phi_lipschitz t hs hs1 hM x.2 y.2
  have h0 : (0 : Mat × Mat) ∈ Metric.closedBall (0 : Mat × Mat) (2 * s) := by
    rw [Metric.mem_closedBall, dist_self]
    linarith
  obtain ⟨x, hxmem, hxfix, -⟩ :=
    ContractingWith.exists_fixedPoint' (Metric.isClosed_closedBall.isComplete) hmap hcontr h0
      (by rw [edist_dist]; exact ENNReal.ofReal_ne_top)
  exact ⟨x, hxmem, hxfix⟩

/-- **The decomposition lemma.**  Every `M` with entries bounded by `s` is `a + b + a·b` with `a`
supported on the contracted positions, `b` supported on the parabolic positions, and both
bounded entrywise by `2s`. -/
theorem exists_decomp (t : Fin 3 → ℝ) {s : ℝ} (hs : 0 < s) (hs1 : s ≤ 1 / 100)
    (M : Mat) (hM : ∀ i j, |M i j| ≤ s) :
    ∃ a b : Mat, (∀ i j, ¬ (t i < t j) → a i j = 0) ∧ (∀ i j, t i < t j → b i j = 0) ∧
      a + b + mmul a b = M ∧ (∀ i j, |a i j| ≤ 2 * s) ∧ (∀ i j, |b i j| ≤ 2 * s) := by
  obtain ⟨⟨a, b⟩, hxmem, hxfix⟩ := exists_fixpoint t hs hs1 hM
  have ha : a = onC t (M - mmul a b) := (congrArg Prod.fst hxfix).symm
  have hb : b = onP t (M - mmul a b) := (congrArg Prod.snd hxfix).symm
  have hmem : dist a (0 : Mat) ≤ 2 * s ∧ dist b (0 : Mat) ≤ 2 * s := by
    have h := hxmem; rw [Metric.mem_closedBall, Prod.dist_eq] at h
    exact ⟨le_trans (le_max_left _ _) h, le_trans (le_max_right _ _) h⟩
  have e1 : a + onC t (mmul a b) = onC t M :=
    (congrArg (fun z => z + onC t (mmul a b)) ha).trans (by rw [onC_sub]; abel)
  have e2 : b + onP t (mmul a b) = onP t M :=
    (congrArg (fun z => z + onP t (mmul a b)) hb).trans (by rw [onP_sub]; abel)
  have step1 : a + b + mmul a b = a + b + (onC t (mmul a b) + onP t (mmul a b)) :=
    congrArg (fun z => a + b + z) (onC_add_onP t (mmul a b)).symm
  have step2 : a + b + (onC t (mmul a b) + onP t (mmul a b))
      = (a + onC t (mmul a b)) + (b + onP t (mmul a b)) := by abel
  have step3 : (a + onC t (mmul a b)) + (b + onP t (mmul a b)) = onC t M + onP t M := by
    rw [e1, e2]
  refine ⟨a, b, fun i j hij => ?_, fun i j hij => ?_, ?_, fun i j => ?_, fun i j => ?_⟩
  · have h1 : a i j = (onC t (M - mmul a b)) i j := congrFun (congrFun ha i) j
    rw [h1]
    show (if t i < t j then (M - mmul a b) i j else 0) = 0
    rw [if_neg hij]
  · have h1 : b i j = (onP t (M - mmul a b)) i j := congrFun (congrFun hb i) j
    rw [h1]
    show (if t i < t j then 0 else (M - mmul a b) i j) = 0
    rw [if_pos hij]
  · exact (step1.trans step2).trans (step3.trans (onC_add_onP t M))
  · exact abs_apply_le_of_dist_zero_le hmem.1 i j
  · exact abs_apply_le_of_dist_zero_le hmem.2 i j

end Decomp

open Decomp

/-- **L1 — BIGCELL, decomposition part.**  Every `g` in the star-neighbourhood `V s` of the
identity splits as `g = u * k` with `u ∈ Uminus t` and `k ∈ VtSet t` both of sup-distance
`< 40 s` from the identity, provided `s ≤ 1/100`. -/
theorem exists_uminus_mul_VtSet (t : Fin 3 → ℝ) :
    ∃ δ₀ : ℝ, 0 < δ₀ ∧ δ₀ ≤ 1 / 100 ∧ ∀ s : ℝ, 0 < s → s ≤ δ₀ →
      ∀ g ∈ Work.EKLContract.V s, ∃ u ∈ Work.EKLComp.Uball (Work.EKLC6Core.Uminus t) (40 * s),
        ∃ k ∈ Work.EKLC6Route.VtSet t ∩ Work.EKLContract.V (40 * s), g = u * k := by
  refine ⟨1 / 100, by norm_num, by norm_num, ?_⟩
  intro s hs hs1 g hg
  obtain ⟨a, b, ha, hb, heq, ha2, hb2⟩ :=
    exists_decomp t hs hs1 (fun i j => (g : Matrix (Fin 3) (Fin 3) ℝ) i j
      - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j) (fun i j => le_of_lt (hg i j))
  -- the matrix identity `g = (1 + a) * (1 + b)`
  have hAB1 : Matrix.of a + Matrix.of b + Matrix.of a * Matrix.of b
      = (g : Matrix (Fin 3) (Fin 3) ℝ) - 1 := by
    have h1 : Matrix.of (a + b + mmul a b)
        = Matrix.of a + Matrix.of b + Matrix.of a * Matrix.of b := by
      simp only [of_add, of_mmul]
    rw [← h1, heq]
    ext i j
    simp only [Matrix.of_apply, Matrix.sub_apply]
  have hmul : (1 + Matrix.of a) * (1 + Matrix.of b) = (g : Matrix (Fin 3) (Fin 3) ℝ) := by
    have h1 : (1 + Matrix.of a) * (1 + Matrix.of b)
        = 1 + (Matrix.of a + Matrix.of b + Matrix.of a * Matrix.of b) := by
      noncomm_ring
    rw [h1, hAB1]
    abel
  have hdetu : Matrix.det (1 + Matrix.of a) = 1 := det_one_add_eq_one (t := t) ha
  have hdetk : Matrix.det (1 + Matrix.of b) = 1 := by
    have h := congrArg Matrix.det hmul
    rw [Matrix.det_mul, hdetu, one_mul, Matrix.SpecialLinearGroup.det_coe] at h
    exact h
  let u : Matrix.SpecialLinearGroup (Fin 3) ℝ := ⟨1 + Matrix.of a, hdetu⟩
  let k : Matrix.SpecialLinearGroup (Fin 3) ℝ := ⟨1 + Matrix.of b, hdetk⟩
  have huk : (u : Matrix (Fin 3) (Fin 3) ℝ) = 1 + Matrix.of a := rfl
  have hkk : (k : Matrix (Fin 3) (Fin 3) ℝ) = 1 + Matrix.of b := rfl
  refine ⟨u, ⟨?_, ?_⟩, k, ⟨?_, ?_⟩, ?_⟩
  · -- `u ∈ Uminus t`
    refine Work.EKLC6Core.mem_uminus_of_entry_form (t := t) (g := u) ?_ ?_
    · intro i
      rw [huk]
      simp only [Matrix.add_apply, Matrix.one_apply_eq, Matrix.of_apply]
      rw [ha i i (lt_irrefl (t i))]
      norm_num
    · intro i j hij hji
      rw [huk]
      simp only [Matrix.add_apply, Matrix.of_apply]
      rw [Matrix.one_apply_ne hij, ha i j (not_lt.mpr hji)]
      norm_num
  · -- `u` is within `40 s` of the identity
    intro i j
    rw [huk]
    have h : (1 + Matrix.of a : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = a i j := by
      simp only [Matrix.add_apply, Matrix.of_apply]; ring
    rw [h]
    linarith [ha2 i j, hs]
  · -- `k ∈ VtSet t`
    intro i j hlt
    have hij : i ≠ j := fun h => absurd hlt (by rw [h]; exact lt_irrefl _)
    rw [hkk]
    simp only [Matrix.add_apply, Matrix.of_apply]
    rw [Matrix.one_apply_ne hij, hb i j hlt]
    norm_num
  · -- `k` is within `40 s` of the identity
    intro i j
    rw [hkk]
    have h : (1 + Matrix.of b : Matrix (Fin 3) (Fin 3) ℝ) i j
        - (1 : Matrix (Fin 3) (Fin 3) ℝ) i j = b i j := by
      simp only [Matrix.add_apply, Matrix.of_apply]; ring
    rw [h]
    linarith [hb2 i j, hs]
  · -- `g = u * k`
    have hcoe : ((u * k : Matrix.SpecialLinearGroup (Fin 3) ℝ) :
        Matrix (Fin 3) (Fin 3) ℝ) = (g : Matrix (Fin 3) (Fin 3) ℝ) := by
      rw [Matrix.SpecialLinearGroup.coe_mul, huk, hkk]
      exact hmul
    exact Subtype.ext hcoe.symm

end Work.EKLC6Route
