import Mathlib
import Submission.Work.EKLComp.Hcond

/-!
# Definitions for the finite-partition approximation of a conditional entropy

This file collects the small vocabulary used by `condEnt_finPart_approx` and its helper lemmas.

* `clip01 x = min (max x 0) 1` is the projection of `ℝ` onto `[0,1]`.
* `atomFam S k` is the atom of the finite Boolean algebra generated by a finite family of sets
  `S`, indexed by the "pattern" `k : τ → Bool`: the set of points whose membership in every
  `S p` is prescribed by `k`.
* `threshFam g N` is the family of dyadic upper level sets `{x | j / 2^N ≤ g i x}` of a family of
  functions `g : ι → X → ℝ`, indexed by `i : ι` and `j : Fin (2^N + 1)`.
-/

namespace Work.EKLEntJacobs

open Set

/-- The projection of a real number onto the unit interval, written with the two clips. -/
def clip01 (x : ℝ) : ℝ := min (max x 0) 1

@[simp] theorem clip01_nonneg (x : ℝ) : 0 ≤ clip01 x := le_min (le_max_right _ _) zero_le_one

@[simp] theorem clip01_le_one (x : ℝ) : clip01 x ≤ 1 := min_le_right _ _

theorem clip01_eq_self {x : ℝ} (h0 : 0 ≤ x) (h1 : x ≤ 1) : clip01 x = x := by
  simp only [clip01, max_eq_left h0, min_eq_left h1]

@[simp] theorem clip01_neg {x : ℝ} (hx : x ≤ 0) : clip01 x = 0 := by
  have h : max x 0 = 0 := max_eq_right hx
  simp only [clip01, h, min_eq_left zero_le_one]

@[simp] theorem clip01_one_le {x : ℝ} (hx : 1 ≤ x) : clip01 x = 1 := by
  have h : max x 0 = x := max_eq_left (by linarith)
  simp only [clip01, h, min_eq_right hx]

/-- The atom of the Boolean algebra generated by a finite family of sets `S`, with prescribed
"pattern" `k : τ → Bool`: the points lying in `S p` exactly when `k p = true`. -/
def atomFam {X τ : Type*} (S : τ → Set X) (k : τ → Bool) : Set X :=
  {x | ∀ p, x ∈ S p ↔ k p = true}

/-- The family of dyadic upper level sets `{x | j / 2^N ≤ g i x}` of a family of functions
`g : ι → X → ℝ`, at level `N`. -/
def threshFam {X ι : Type*} (g : ι → X → ℝ) (N : ℕ) : ι × Fin (2 ^ N + 1) → Set X :=
  fun p => {x | (((p.2 : ℕ) : ℝ) / (2 : ℝ) ^ N) ≤ g p.1 x}

end Work.EKLEntJacobs
