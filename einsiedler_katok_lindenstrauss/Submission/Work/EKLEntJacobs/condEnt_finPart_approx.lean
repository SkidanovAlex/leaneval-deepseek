import Mathlib
import Submission.Work.EKLComp.Entropy
import Submission.Work.EKLComp.Hpart.Hfam_join_chain
import Submission.Work.EKLEntJacobs.ApproxDefs
import Submission.Work.EKLComp.HcondFam_tendsto

/-!
# Finitely generated sub-σ-algebras approximate the conditional entropy

For a probability measure `μ` on `(X, mX)`, a sub-σ-algebra `I ≤ mX` and a finite measurable
partition `A` of `X`, the conditional entropy
`HcondFam X μ A m = ∫ ∑ᵢ -E(1_{Aᵢ}|m) log E(1_{Aᵢ}|m)`
of `A` given `m` is decreasing in `m`; the content of this file is that it is approached, up to
`ε`, by the entropies given by the **finitely generated** sub-σ-algebras of `I`.

The finitely generated sub-σ-algebras are produced explicitly, as the σ-algebras generated by the
dyadic upper level sets `{x | j / 2^N ≤ E(1_{Aᵢ}|I) x}` of the conditional expectations `gᵢ` of the
atom indicators.  The partitions `B_N` are the atoms of the Boolean algebra generated by that
finite family, and the level-`N` threshold family is a subfamily of the level-`(N+1)` one after the
identification `j / 2^N = (2j) / 2^(N+1)`, so the σ-algebras `partSigmaFam (B N)` increase.

Since the level-`N` dyadic thresholds of `gᵢ` are measurable for `partSigmaFam (B N)`, the clipped
conditional expectation `min (max gᵢ 0) 1` — which equals `gᵢ` a.e. — is measurable for the join
`M = ⨆ N, partSigmaFam (B N)`, whence `E(fᵢ | M) = E(fᵢ | I) = gᵢ` a.e. and
`HcondFam X μ A M = HcondFam X μ A I`.
Lévy's upward theorem (`HcondFam_tendsto`) then gives the convergence of
`HcondFam X μ A (partSigmaFam (B N))` to this common value, and one of the `N` satisfies the
required bound.
-/

open MeasureTheory Filter Topology
open scoped ENNReal BigOperators

noncomputable section

set_option maxHeartbeats 800000

namespace Work.EKLEntJacobs

variable {X : Type} [mX : MeasurableSpace X]

/-! ## 1. Atoms of the Boolean algebra generated by a finite family of sets -/

/-- An atom is the intersection of the sets `S p` (when `k p = true`) with the complements of the
others. -/
private theorem atomFam_iInter {X τ : Type*} (S : τ → Set X) (k : τ → Bool) :
    atomFam S k = ⋂ p : τ, (if k p = true then S p else (S p)ᶜ) := by
  ext x
  simp only [atomFam, Set.mem_setOf_eq, Set.mem_iInter]
  refine ⟨fun hx p => ?_, fun hx p => ?_⟩
  · by_cases hp : k p = true
    · simpa [hp] using (hx p).mpr hp
    · have hxp : x ∉ S p := fun hxs => hp ((hx p).mp hxs)
      simpa [hp] using hxp
  · have hp := hx p
    by_cases hk : k p = true
    · have hxs : x ∈ S p := by simpa [hk] using hp
      simp [hk, hxs]
    · have hns : x ∉ S p := by simpa [hk] using hp
      simp [hk, hns]

/-- Every atom is measurable in any σ-algebra making all the generators measurable. -/
private theorem atomFam_measurableSet {X τ : Type*} [Fintype τ] {I : MeasurableSpace X}
    {S : τ → Set X} (hS : ∀ p, @MeasurableSet X I (S p)) (k : τ → Bool) :
    @MeasurableSet X I (atomFam S k) := by
  rw [atomFam_iInter S k]
  exact MeasurableSet.iInter (fun p => by
    by_cases hp : k p = true
    · simpa [hp] using hS p
    · simpa [hp] using (hS p).compl)

/-- The atoms of a finite family of sets are pairwise disjoint. -/
private theorem atomFam_pairwise_disjoint {X τ : Type*} (S : τ → Set X) :
    Pairwise (fun k k' : τ → Bool => Disjoint (atomFam S k) (atomFam S k')) := by
  intro k k' hkk'
  rw [Set.disjoint_left]
  intro x hx hx'
  apply hkk'
  funext p
  have h1 := hx p
  have h2 := hx' p
  by_cases hp : k p = true
  · have hxs : x ∈ S p := h1.mpr hp
    have hk' : k' p = true := h2.mp hxs
    rw [hp, hk']
  · have hns : x ∉ S p := fun hxs => hp (h1.mp hxs)
    have hkf : k p = false := by cases h : k p <;> simp_all
    have hk' : k' p = false := by
      by_cases h : k' p = true
      · exact absurd (h2.mpr h) hns
      · cases h' : k' p <;> simp_all
    rw [hkf, hk']

/-- The atoms of a finite family of sets cover the whole space. -/
private theorem atomFam_iUnion {X τ : Type*} (S : τ → Set X) :
    Set.iUnion (fun k : τ → Bool => atomFam S k) = Set.univ := by
  classical
  refine Set.eq_univ_of_forall (fun x => ?_)
  rw [Set.mem_iUnion]
  refine ⟨fun p => decide (x ∈ S p), ?_⟩
  intro p
  by_cases h : x ∈ S p <;> simp [h]

/-- The atoms of a finite family of sets generate the same σ-algebra as the family itself. -/
private theorem atomFam_partSigmaFam_eq {X τ : Type*} [Fintype τ] (S : τ → Set X) :
    Work.EKLComp.Core.partSigmaFam (fun k : τ → Bool => atomFam S k) =
      MeasurableSpace.generateFrom (Set.range S) := by
  classical
  refine le_antisymm ?_ ?_
  · refine MeasurableSpace.generateFrom_le ?_
    rintro t ⟨k, rfl⟩
    show @MeasurableSet X (MeasurableSpace.generateFrom (Set.range S)) (atomFam S k)
    rw [atomFam_iInter S k]
    exact MeasurableSet.iInter (fun p => by
      by_cases hp : k p = true
      · simpa [hp] using MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self p)
      · simpa [hp] using
          (MeasurableSpace.measurableSet_generateFrom (Set.mem_range_self p)).compl)
  · refine MeasurableSpace.generateFrom_le ?_
    rintro t ⟨p, rfl⟩
    have hrep : S p = ⋃ k : {k : τ → Bool // k p = true}, atomFam S k.1 := by
      ext x
      simp only [Set.mem_iUnion]
      constructor
      · intro hx
        refine ⟨⟨fun q => decide (x ∈ S q), ?_⟩, ?_⟩
        · simpa using hx
        · intro q
          by_cases h : x ∈ S q <;> simp [h]
      · rintro ⟨k, hk⟩
        exact (hk p).mpr k.2
    rw [hrep]
    exact MeasurableSet.iUnion (fun k =>
      MeasurableSpace.measurableSet_generateFrom ⟨k.1, rfl⟩)

/-! ## 2. Measurability from the dyadic upper level sets -/

/-- If all dyadic upper level sets `{x | j / 2^N ≤ f x}`, `j ∈ {0, …, 2^N}`, are measurable for
`M`, then the projection of `f` onto `[0,1]` is `M`-measurable. -/
private theorem dyadic_threshold_measurable_aux {X : Type} [mX : MeasurableSpace X]
    (M : MeasurableSpace X) (f : X → ℝ)
    (h : ∀ (N : ℕ) (j : Fin (2 ^ N + 1)),
      @MeasurableSet X M {x : X | ((j : ℕ) : ℝ) / (2 : ℝ) ^ N ≤ f x}) :
    @Measurable X ℝ M _ (fun x => clip01 (f x)) := by
  letI : MeasurableSpace X := M
  have key : ∀ a : ℝ, MeasurableSet {x : X | a < clip01 (f x)} := by
    intro a
    rcases lt_or_ge a 0 with ha | ha
    · have hset : {x : X | a < clip01 (f x)} = Set.univ := by
        ext x
        simp only [Set.mem_setOf_eq, Set.mem_univ, iff_true]
        exact lt_of_lt_of_le ha (clip01_nonneg (f x))
      rw [hset]; exact MeasurableSet.univ
    rcases le_or_gt 1 a with ha1 | ha1
    · have hset : {x : X | a < clip01 (f x)} = ∅ := by
        ext x
        simp only [Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
        exact not_lt.mpr (le_trans (clip01_le_one (f x)) ha1)
      rw [hset]; exact MeasurableSet.empty
    -- main case: `0 ≤ a < 1`, where `a < clip01 (f x) ↔ a < f x`
    have hstep : ∀ N : ℕ, (((⌊(2 : ℝ) ^ N * a⌋₊ + 1 : ℕ)) : ℝ) / (2 : ℝ) ^ N
        ≤ a + ((1 : ℝ) / 2) ^ N := by
      intro N
      have hden : (0 : ℝ) < (2 : ℝ) ^ N := by positivity
      have hfloor : (((⌊(2 : ℝ) ^ N * a⌋₊ : ℕ)) : ℝ) ≤ (2 : ℝ) ^ N * a :=
        Nat.floor_le (by positivity)
      have hpow : ((1 : ℝ) / 2) ^ N * (2 : ℝ) ^ N = 1 := by
        rw [← mul_pow]; norm_num
      have hexp : (a + ((1 : ℝ) / 2) ^ N) * (2 : ℝ) ^ N = (2 : ℝ) ^ N * a + 1 := by
        rw [add_mul, hpow]; ring
      rw [div_le_iff₀ hden, hexp]
      push_cast
      linarith
    have hset : {x : X | a < clip01 (f x)} = ⋃ N : ℕ,
        {x : X | (((⌊(2 : ℝ) ^ N * a⌋₊ + 1 : ℕ)) : ℝ) / (2 : ℝ) ^ N ≤ f x} := by
      ext x
      simp only [Set.mem_setOf_eq, Set.mem_iUnion]
      constructor
      · intro hx
        have h1 : a < min (max (f x) 0) 1 := hx
        have h2 : a < max (f x) 0 := lt_of_lt_of_le h1 (min_le_left _ _)
        have h3 : 0 < f x := by
          rcases le_or_gt (f x) 0 with hf | hf
          · rw [max_eq_right hf] at h2
            exact absurd h2 (not_lt.mpr ha)
          · exact hf
        have haf : a < f x := by rwa [max_eq_left (le_of_lt h3)] at h2
        obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one (x := f x - a) (y := (1 : ℝ) / 2)
          (by linarith) (by norm_num)
        exact ⟨N, le_of_lt (lt_of_le_of_lt (hstep N) (by linarith))⟩
      · rintro ⟨N, hN⟩
        have hden : (0 : ℝ) < (2 : ℝ) ^ N := by positivity
        have hlt : a < (((⌊(2 : ℝ) ^ N * a⌋₊ + 1 : ℕ)) : ℝ) / (2 : ℝ) ^ N := by
          have hfl := Nat.lt_floor_add_one ((2 : ℝ) ^ N * a)
          rw [lt_div_iff₀ hden]
          push_cast
          rw [mul_comm a ((2 : ℝ) ^ N)]
          exact hfl
        have haf : a < f x := lt_of_lt_of_le hlt hN
        have hmax : a < max (f x) 0 := by
          rcases le_or_gt (f x) 0 with hf | hf
          · exact absurd (lt_of_lt_of_le haf (le_trans hf ha)) (lt_irrefl a)
          · rwa [max_eq_left (le_of_lt hf)]
        simpa only [clip01] using lt_min hmax ha1
    rw [hset]
    refine MeasurableSet.iUnion (fun N => ?_)
    have hfin : ⌊(2 : ℝ) ^ N * a⌋₊ + 1 < 2 ^ N + 1 := by
      have hlt : ⌊(2 : ℝ) ^ N * a⌋₊ < 2 ^ N := by
        rw [Nat.floor_lt' (a := (2 : ℝ) ^ N * a) (n := 2 ^ N) (by positivity),
          Nat.cast_pow, Nat.cast_ofNat]
        calc (2 : ℝ) ^ N * a < (2 : ℝ) ^ N * 1 :=
              mul_lt_mul_of_pos_left ha1 (by positivity)
          _ = (2 : ℝ) ^ N := by ring
      omega
    simpa using h N ⟨⌊(2 : ℝ) ^ N * a⌋₊ + 1, hfin⟩
  exact measurable_of_Ioi key

/-! ## 3. The conditional expectation over the join of an increasing sequence -/

/-- If the clipped conditional expectation `clip01 (E(f | I))` is measurable for the join `M` of
the increasing sequence `mseq` of sub-σ-algebras of `I`, then `E(f | M) = E(f | I)` a.e. -/
private theorem condExp_iSup_eq_of_clip_measurable_aux {X : Type} [mX : MeasurableSpace X]
    (μ : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure μ]
    {I : MeasurableSpace X} (hI : I ≤ mX)
    {mseq : ℕ → MeasurableSpace X} (hmono : Monotone mseq) (hle : ∀ N, mseq N ≤ I)
    {f : X → ℝ}
    (hclip : @Measurable X ℝ (⨆ N, mseq N) _
      (fun x => clip01 (MeasureTheory.condExp I μ f x)))
    (hbdd : ∀ᵐ x ∂μ, MeasureTheory.condExp I μ f x ∈ Set.Icc 0 1) :
    MeasureTheory.condExp (⨆ N, mseq N) μ f =ᵐ[μ] MeasureTheory.condExp I μ f := by
  have hMleI : (⨆ N, mseq N) ≤ I := iSup_le hle
  have hMleX : (⨆ N, mseq N) ≤ mX := hMleI.trans hI
  have hclip_eq : (fun x => clip01 (MeasureTheory.condExp I μ f x)) =ᵐ[μ]
      MeasureTheory.condExp I μ f := by
    filter_upwards [hbdd] with x hx
    exact clip01_eq_self hx.1 hx.2
  have hint : Integrable (fun x => clip01 (MeasureTheory.condExp I μ f x)) μ := by
    refine Integrable.of_bound (hclip.mono hMleX le_rfl).aestronglyMeasurable 1 ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg (clip01_nonneg _)]
    exact clip01_le_one _
  have hcond1 : MeasureTheory.condExp (⨆ N, mseq N) μ
        (fun x => clip01 (MeasureTheory.condExp I μ f x)) =
      fun x => clip01 (MeasureTheory.condExp I μ f x) :=
    MeasureTheory.condExp_of_stronglyMeasurable hMleX
      (Measurable.stronglyMeasurable hclip) hint
  have h2 : MeasureTheory.condExp (⨆ N, mseq N) μ f =ᵐ[μ]
      MeasureTheory.condExp (⨆ N, mseq N) μ (MeasureTheory.condExp I μ f) :=
    (MeasureTheory.condExp_condExp_of_le (μ := μ) hMleI hI).symm
  have h3 : MeasureTheory.condExp (⨆ N, mseq N) μ (MeasureTheory.condExp I μ f) =ᵐ[μ]
      MeasureTheory.condExp (⨆ N, mseq N) μ
        (fun x => clip01 (MeasureTheory.condExp I μ f x)) :=
    (MeasureTheory.condExp_congr_ae hclip_eq).symm
  have h4 : MeasureTheory.condExp (⨆ N, mseq N) μ
        (fun x => clip01 (MeasureTheory.condExp I μ f x)) =ᵐ[μ]
      MeasureTheory.condExp I μ f := by
    rw [hcond1]
    exact hclip_eq
  exact h2.trans (h3.trans h4)

/-! ## 4. The dyadic threshold families increase with the level -/

theorem threshFam_range_mono {ι : Type*} (g : ι → X → ℝ) (N : ℕ) :
    Set.range (threshFam g N) ⊆ Set.range (threshFam g (N + 1)) := by
  rintro a ⟨p, rfl⟩
  obtain ⟨i, j⟩ := p
  have hj : (j : ℕ) ≤ 2 ^ N := by have := j.isLt; omega
  have hfin : 2 * (j : ℕ) < 2 ^ (N + 1) + 1 := by
    have h : 2 * (j : ℕ) ≤ 2 ^ (N + 1) := by
      calc 2 * (j : ℕ) ≤ 2 * 2 ^ N := Nat.mul_le_mul_left 2 hj
        _ = 2 ^ (N + 1) := by rw [pow_succ]; ring
    omega
  refine ⟨(i, ⟨2 * (j : ℕ), hfin⟩), ?_⟩
  have hkey : (((2 * (j : ℕ) : ℕ) : ℝ)) / (2 : ℝ) ^ (N + 1) = ((j : ℕ) : ℝ) / (2 : ℝ) ^ N := by
    push_cast
    rw [pow_succ]
    field_simp
  ext x
  show (((2 * (j : ℕ) : ℕ) : ℝ) / (2 : ℝ) ^ (N + 1) ≤ g i x) ↔
    (((j : ℕ) : ℝ) / (2 : ℝ) ^ N ≤ g i x)
  rw [hkey]

/-! ## 5. The main theorem -/

theorem condEnt_finPart_approx {X : Type} {I : MeasurableSpace X} [mX : MeasurableSpace X]
    (μ : MeasureTheory.Measure X) [MeasureTheory.IsProbabilityMeasure μ] (hI : I ≤ mX)
    {ι : Type} [Fintype ι] {A : ι → Set X} (hA : Work.EKLComp.Core.IsMPart A)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ (κ : Type) (_ : Fintype κ) (B : κ → Set X), (∀ j, @MeasurableSet X I (B j)) ∧
      Work.EKLComp.Core.IsMPart B ∧
      Work.EKLComp.Core.HcondFam X μ A (Work.EKLComp.Core.partSigmaFam B)
        ≤ Work.EKLComp.Core.HcondFam X μ A I + ε := by
  classical
  -- the conditional expectation of the indicator of each atom
  let g : ι → X → ℝ := fun i => MeasureTheory.condExp I μ ((A i).indicator (fun _ => (1 : ℝ)))
  have hg_meas : ∀ i, @Measurable X ℝ I _ (g i) := fun i =>
    (stronglyMeasurable_condExp (μ := μ) (m := I)
      (f := (A i).indicator (fun _ => (1 : ℝ)))).measurable
  have hg_mem : ∀ i, ∀ᵐ x ∂μ, g i x ∈ Set.Icc (0 : ℝ) 1 :=
    fun i => Work.EKLComp.condExp_indicator_mem_Icc μ I hI (A i)
  have hthresh_meas : ∀ N (p : ι × Fin (2 ^ N + 1)), @MeasurableSet X I (threshFam g N p) :=
    fun N p => hg_meas p.1 measurableSet_Ici
  -- the level-`N` partitions and their σ-algebras
  let Bt : (N : ℕ) → (ι × Fin (2 ^ N + 1) → Bool) → Set X :=
    fun N k => atomFam (threshFam g N) k
  let mseq : ℕ → MeasurableSpace X := fun N => Work.EKLComp.Core.partSigmaFam (Bt N)
  have hBmeas : ∀ N (j : (ι × Fin (2 ^ N + 1) → Bool)), @MeasurableSet X I (Bt N j) :=
    fun N j => atomFam_measurableSet (hthresh_meas N) j
  have hPart : ∀ N, Work.EKLComp.Core.IsMPart (Bt N) := fun N =>
    ⟨fun k => hI _ (atomFam_measurableSet (hthresh_meas N) k),
      atomFam_pairwise_disjoint (threshFam g N), atomFam_iUnion (threshFam g N)⟩
  have hGen : ∀ N, mseq N = MeasurableSpace.generateFrom (Set.range (threshFam g N)) :=
    fun N => atomFam_partSigmaFam_eq (threshFam g N)
  have hmle : ∀ N, mseq N ≤ I := by
    intro N
    rw [hGen N]
    exact MeasurableSpace.generateFrom_le (fun t ht => by
      rcases ht with ⟨p, rfl⟩
      exact hthresh_meas N p)
  have hmleX : ∀ N, mseq N ≤ mX := fun N => (hmle N).trans hI
  have hstep : ∀ N, mseq N ≤ mseq (N + 1) := by
    intro N
    rw [hGen N, hGen (N + 1)]
    exact MeasurableSpace.generateFrom_mono (threshFam_range_mono g N)
  have hmono : Monotone mseq := monotone_nat_of_le_succ hstep
  -- the join of the σ-algebras
  have hgen_meas : ∀ N (p : ι × Fin (2 ^ N + 1)), @MeasurableSet X (mseq N) (threshFam g N p) := by
    intro N p
    rw [hGen N]
    exact MeasurableSpace.measurableSet_generateFrom ⟨p, rfl⟩
  have hgen_meas_sup : ∀ N (p : ι × Fin (2 ^ N + 1)),
      @MeasurableSet X (⨆ N, mseq N) (threshFam g N p) :=
    fun N p => (le_iSup mseq N) _ (hgen_meas N p)
  have hclip : ∀ i, @Measurable X ℝ (⨆ N, mseq N) _ (fun x => clip01 (g i x)) := fun i =>
    dyadic_threshold_measurable_aux (⨆ N, mseq N) (g i) (fun N j => hgen_meas_sup N (i, j))
  have hcondExp_iSup : ∀ i, MeasureTheory.condExp (⨆ N, mseq N) μ
      ((A i).indicator (fun _ => (1 : ℝ))) =ᵐ[μ] g i := fun i =>
    condExp_iSup_eq_of_clip_measurable_aux (μ := μ) hI hmono hmle (hclip i) (hg_mem i)
  have hHI : Work.EKLComp.Core.HcondFam X μ A (⨆ N, mseq N)
      = Work.EKLComp.Core.HcondFam X μ A I := by
    simp only [Work.EKLComp.Core.HcondFam]
    refine integral_congr_ae ?_
    have hall : ∀ᵐ x ∂μ, ∀ i, Real.negMulLog (MeasureTheory.condExp (⨆ N, mseq N) μ
        ((A i).indicator (fun _ => (1 : ℝ))) x) = Real.negMulLog (g i x) :=
      Filter.eventually_all.2 (fun i => (hcondExp_iSup i).mono (fun x hx => congrArg _ hx))
    filter_upwards [hall] with x hx
    exact Finset.sum_congr rfl (fun i _ => hx i)
  have htend : Tendsto (fun N => Work.EKLComp.Core.HcondFam X μ A (mseq N)) atTop
      (nhds (Work.EKLComp.Core.HcondFam X μ A I)) := by
    have h := Work.EKLComp.HcondFam_tendsto (μ := μ) A mseq hmono hmleX
    rwa [hHI] at h
  have hev : ∀ᶠ N in atTop, Work.EKLComp.Core.HcondFam X μ A (mseq N) <
      Work.EKLComp.Core.HcondFam X μ A I + ε :=
    htend.eventually (isOpen_Iio.mem_nhds (lt_add_of_pos_right _ hε))
  obtain ⟨N, hN⟩ := Filter.eventually_atTop.1 hev
  refine ⟨(ι × Fin (2 ^ N + 1) → Bool), inferInstance, fun k => Bt N k, ?_, ?_, ?_⟩
  · intro j
    exact hBmeas N j
  · exact hPart N
  · exact le_of_lt (hN N le_rfl)

end Work.EKLEntJacobs
