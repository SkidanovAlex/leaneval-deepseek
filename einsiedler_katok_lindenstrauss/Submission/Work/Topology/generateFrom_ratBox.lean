import Mathlib
import Submission.Work.EKLContract.Defs
import Submission.Work.Topology.exists_ratBox_subset

/-!
# The Borel σ-algebra of `SL₃(ℝ)` is generated by entrywise rational boxes

`G = SL₃(ℝ)` is realized as the subtype `{A : Matrix (Fin 3) (Fin 3) ℝ // A.det = 1}` of the
space `M` of real `3 × 3` matrices (the function space `Fin 3 → Fin 3 → ℝ` with the product
topology).  We prove

* `borel M3 = MeasurableSpace.generateFrom ratBoxM` : in the *ambient* matrix space, the family of
  entrywise closed boxes with rational bounds generates the Borel σ-algebra;
* transferring along the embedding `Subtype.val : SL₃(ℝ) → M` through
  `MeasurableSpace.comap_generateFrom` gives the same statement for `SL₃(ℝ)`, which is
  `Work.Topology.generateFrom_ratBox`.

The ambient statement is proved by two inequalities.  `σ(ratBoxM) ≤ borel M` because each rational
box is a finite product of closed intervals, hence closed.  For `borel M ≤ σ(ratBoxM)` we show that
every open set `U` is the union of the rational boxes it contains, `U = ⋃₀ {b ∈ ratBoxM | b ⊆ U}`;
this union is countable because `ratBoxM` is countable (`ℚ` is), so `U` is measurable in
`σ(ratBoxM)`.  The only topological input is that every point of an open set `U` lies in a rational
box contained in `U`.
-/

noncomputable section

namespace Work.Topology

open Work.EKLContract

/-- The ambient space of real `3 × 3` matrices. -/
abbrev M3 : Type := Matrix (Fin 3) (Fin 3) ℝ

/-- The entrywise closed box with rational bounds `a`, `b` in the ambient matrix space. -/
def boxM (a b : Matrix (Fin 3) (Fin 3) ℚ) : Set M3 :=
  {M | ∀ i j, (a i j : ℝ) ≤ M i j ∧ M i j ≤ (b i j : ℝ)}

/-- The family of all entrywise closed boxes with rational bounds in the ambient matrix space. -/
def ratBoxM : Set (Set M3) := {s | ∃ a b : Matrix (Fin 3) (Fin 3) ℚ, s = boxM a b}

/-- The entrywise closed box with rational bounds `a`, `b` in `SL₃(ℝ)`. -/
def boxSL (a b : Matrix (Fin 3) (Fin 3) ℚ) : Set SL3 :=
  {g | ∀ i j, (a i j : ℝ) ≤ g i j ∧ g i j ≤ (b i j : ℝ)}

/-- The family of all entrywise closed boxes with rational bounds in `SL₃(ℝ)`. -/
def ratBoxSL : Set (Set SL3) := {s | ∃ a b : Matrix (Fin 3) (Fin 3) ℚ, s = boxSL a b}

/-- The coercion `SL₃(ℝ) → M` used to transfer measure structures. -/
def toM3 (g : SL3) : M3 := (g : Matrix (Fin 3) (Fin 3) ℝ)

theorem boxM_eq_iInter (a b : Matrix (Fin 3) (Fin 3) ℚ) :
    boxM a b = ⋂ (i : Fin 3) (j : Fin 3),
      (fun M : M3 => M i j) ⁻¹' Set.Icc (a i j : ℝ) (b i j : ℝ) := by
  ext M
  simp only [boxM, Set.mem_ofPred_eq, Set.mem_iInter, Set.mem_preimage, Set.mem_Icc]

theorem isClosed_boxM (a b : Matrix (Fin 3) (Fin 3) ℚ) : IsClosed (boxM a b) := by
  rw [boxM_eq_iInter]
  exact isClosed_iInter fun i => isClosed_iInter fun j =>
    isClosed_Icc.preimage ((continuous_apply j).comp (continuous_apply i))

theorem ratBoxM_eq_range :
    ratBoxM = Set.range (fun p : (Fin 3 → Fin 3 → ℚ) × (Fin 3 → Fin 3 → ℚ) =>
      boxM p.1 p.2) := by
  ext s; constructor
  · rintro ⟨a, b, rfl⟩; exact ⟨(a, b), rfl⟩
  · rintro ⟨⟨a, b⟩, rfl⟩; exact ⟨a, b, rfl⟩

theorem ratBoxM_countable : ratBoxM.Countable := by
  rw [ratBoxM_eq_range]; exact Set.countable_range _

theorem boxSL_eq_preimage (a b : Matrix (Fin 3) (Fin 3) ℚ) :
    boxSL a b = toM3 ⁻¹' boxM a b := by
  ext g; rfl

theorem ratBoxSL_eq_preimage : ratBoxSL = Set.preimage toM3 '' ratBoxM := by
  ext s; constructor
  · rintro ⟨a, b, rfl⟩
    exact ⟨boxM a b, ⟨a, b, rfl⟩, (boxSL_eq_preimage a b).symm⟩
  · rintro ⟨t, ⟨a, b, rfl⟩, rfl⟩
    exact ⟨a, b, (boxSL_eq_preimage a b).symm⟩

/-- In the ambient matrix space, the rational boxes generate the Borel σ-algebra. -/
theorem borel_eq_generateFrom_ratBoxM : borel M3 = MeasurableSpace.generateFrom ratBoxM := by
  refine le_antisymm ?_ ?_
  · change MeasurableSpace.generateFrom {s : Set M3 | IsOpen s} ≤
      MeasurableSpace.generateFrom ratBoxM
    refine MeasurableSpace.generateFrom_le ?_
    intro U hU
    let S : Set (Set M3) := {b | b ∈ ratBoxM ∧ b ⊆ U}
    have hSc : S.Countable := ratBoxM_countable.mono fun b hb => hb.1
    have hUeq : U = ⋃₀ S := by
      ext x; constructor
      · intro hx
        obtain ⟨a, b, hxb, hbU⟩ := exists_ratBox_subset x hU hx
        exact ⟨boxM a b, ⟨⟨a, b, rfl⟩, hbU⟩, hxb⟩
      · rintro ⟨b, hb, hxb⟩; exact hb.2 hxb
    rw [hUeq]
    exact @MeasurableSet.sUnion M3 (MeasurableSpace.generateFrom ratBoxM) S hSc
      fun b hb => MeasurableSpace.measurableSet_generateFrom hb.1
  · refine MeasurableSpace.generateFrom_le ?_
    rintro s ⟨a, b, rfl⟩
    rw [borel_eq_generateFrom_isClosed]
    exact MeasurableSpace.measurableSet_generateFrom (isClosed_boxM a b)

theorem generateFrom_ratBox :
    MeasurableSpace.generateFrom {s : Set Work.EKLContract.SL3 |
      ∃ a b : Matrix (Fin 3) (Fin 3) ℚ,
        s = {g : Work.EKLContract.SL3 |
          ∀ i j, (a i j : ℝ) ≤ g i j ∧ g i j ≤ (b i j : ℝ)}} =
      borel Work.EKLContract.SL3 := by
  have hfam : {s : Set Work.EKLContract.SL3 |
      ∃ a b : Matrix (Fin 3) (Fin 3) ℚ,
        s = {g : Work.EKLContract.SL3 |
          ∀ i j, (a i j : ℝ) ≤ g i j ∧ g i j ≤ (b i j : ℝ)}} = ratBoxSL := rfl
  rw [hfam]
  have h1 : borel Work.EKLContract.SL3 = (borel M3).comap toM3 := borel_comap
  have h3 : ratBoxSL = Set.preimage toM3 '' ratBoxM := ratBoxSL_eq_preimage
  rw [h1, borel_eq_generateFrom_ratBoxM, MeasurableSpace.comap_generateFrom, h3]

end Work.Topology
