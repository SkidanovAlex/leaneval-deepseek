import Mathlib
import Submission.Work.EKLC6Core.Basic

namespace Work.Topology

/-- **Codes of a compact set are measurable for the σ-algebra generated by the code sets.**

`B : ℕ → Set X` is a countable family of `m`-measurable sets and `p : X → (ℕ → Bool)` is a
*code* for it, i.e. `{x | p x n = true} = B n` for every `n` (the `Bool`-valued indicator
sequence, an element of the Cantor space `ℕ → Bool`).  For a compact set `K` of codes, the set of
points whose code lies in `K` is `m`-measurable.

Reviewers' route (short): `hp` makes `p` the indicator code, hence `p` is `(m, Borel)`-measurable
(each cylinder preimage is `B n` or its complement, and the cylinders form a basis); a compact
`K` in the compact Hausdorff Cantor space `ℕ → Bool` is closed, hence Borel, hence `p ⁻¹' K` is
`m`-measurable.  (The intersection-of-cylinders description in the original plan is an
alternative that is not needed.)

Motivation (not needed for the statement): with `A = ⨆ₙ comap ((aDiag t ·)^[n]) M` countably
generated, `M ≤ borel`, and the *analytic hull* gadget
`Work.Topology.analyticSet_isCompact_inner`, this produces, for every `ε > 0`, an `A`-measurable
`A`-saturated set `Z` with `μ Zᶜ < ε` contained in the *analytic* saturation of a Borel good set
— the resolution of the coanalytic obstruction in the construction of the descending plaque
algebra of Pisa 7.37/7.38 (see `Submission/Work/EKLC6Core/PLAN_L1_desc_subordinate.md`,
session 4). -/
theorem comap_code_mem_of_isCompact {X : Type*} {m : MeasurableSpace X} (B : ℕ → Set X)
    (hB : ∀ n, @MeasurableSet X m (B n)) (p : X → (ℕ → Bool))
    (hp : ∀ n : ℕ, {x : X | p x n = true} = B n)
    {K : Set (ℕ → Bool)} (hK : IsCompact K) :
    @MeasurableSet X m (p ⁻¹' K) := by
  -- The σ-algebra on `Bool` is discrete, hence generated by the single set `{true}`.
  have htop : (⊤ : MeasurableSpace Bool) = MeasurableSpace.generateFrom {({true} : Set Bool)} := by
    refine le_antisymm ?_ le_top
    intro t _
    rw [MeasureTheory.measurableSet_generateFrom_singleton_iff]
    by_cases h1 : true ∈ t <;> by_cases h0 : false ∈ t
    · exact Or.inr (Or.inr (Or.inr (by ext b; cases b <;> simp_all)))
    · exact Or.inr (Or.inl (by ext b; cases b <;> simp_all))
    · exact Or.inr (Or.inr (Or.inl (by ext b; cases b <;> simp_all)))
    · exact Or.inl (by ext b; cases b <;> simp_all)
  -- Each coordinate of the code is `m`-measurable.
  have hcoord : ∀ n, @Measurable X Bool m (⊤ : MeasurableSpace Bool) (fun x => p x n) := by
    intro n
    rw [htop]
    apply measurable_generateFrom
    intro t ht
    rw [Set.mem_singleton_iff] at ht
    subst ht
    have hpre : (fun x => p x n) ⁻¹' ({true} : Set Bool) = B n := by
      rw [← hp n]; ext x; simp
    rw [hpre]
    exact hB n
  -- Hence `p` is measurable into the Cantor space (whose σ-algebra is generated by the
  -- coordinate projections); a compact set in a Hausdorff space is closed, hence Borel.
  have hpmeas : Measurable p := Measurable.of_eval hcoord
  exact hpmeas (hK.isClosed.measurableSet)

end Work.Topology
