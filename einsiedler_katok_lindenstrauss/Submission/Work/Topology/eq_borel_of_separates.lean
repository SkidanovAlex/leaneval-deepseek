import Mathlib

/-!
# A countably generated separating Borel sub-σ-algebra is the whole Borel σ-algebra

Let `α` be a Polish space, `borel α` its Borel σ-algebra, and `m ≤ borel α` a
sub-σ-algebra.  If `m` is countably generated and separates points, then `m = borel α`.

The proof is the Lusin–Souslin ("injective images of Borel sets are Borel") theorem applied
to the identity map.  Indeed, `m` is countably generated and separates points, hence (as a
measurable space on its own) it is *countably separated*
(`MeasurableSpace.countablySeparated_of_separatesPoints`).  The identity map
`id : (α, borel α) → (α, m)` is measurable exactly because `m ≤ borel α`, and it is injective.
Its domain is a standard Borel space since `α` is Polish and Borel.  Mathlib's version of the
Lusin–Souslin theorem (`Measurable.measurableEmbedding`) then says that an injective measurable
map from a standard Borel space into a countably separated measurable space is a
*measurable embedding*.  A measurable embedding satisfies
`MeasurableSpace.comap f m = borel α`, and for `f = id` we have `comap id m = m`; hence
`m = borel α`.

This is the technical device that lets one replace an abstract countably generated
σ-algebra on a Polish space by the Borel structure, and it is exactly what is needed to
identify the algebra of sets generated by a countable separating family with the Borel sets.
-/

namespace Work.Topology

theorem eq_borel_of_separates {α : Type*} [TopologicalSpace α] [PolishSpace α]
    [MeasurableSpace α] [BorelSpace α] {m : MeasurableSpace α}
    (hm : m ≤ borel α) (hcg : @MeasurableSpace.CountablyGenerated α m)
    (hsep : ∀ x y : α, x ≠ y → ∃ s : Set α, @MeasurableSet α m s ∧ x ∈ s ∧ y ∉ s) :
    m = borel α := by
  -- `m` separates points in the sense of the `SeparatesPoints` typeclass.
  have hsepSp : @MeasurableSpace.SeparatesPoints α m :=
    ⟨fun x y hxy => by
      by_contra hne
      obtain ⟨s, hs, hxs, hys⟩ := hsep x y hne
      exact hys (hxy s hs hxs)⟩
  -- A countably generated, separating measurable space is countably separated.
  have hCS : @MeasurableSpace.CountablySeparated α m :=
    @MeasurableSpace.countablySeparated_of_separatesPoints α m hcg hsepSp
  -- The identity map `(α, borel α) → (α, m)` is measurable because `m ≤ borel α`,
  have hf_meas : @Measurable α α (borel α) m id := fun s hs => by simpa using hm s hs
  -- ... injective,
  have hf_inj : Function.Injective (id : α → α) := fun _ _ h => h
  -- ... and its domain `(α, borel α)` is a standard Borel space (as `α` is Polish).
  have hStdB : @StandardBorelSpace α (borel α) :=
    @StandardBorelSpace.mk α (borel α)
      ⟨‹TopologicalSpace α›, @BorelSpace.mk α ‹TopologicalSpace α› (borel α) rfl, ‹PolishSpace α›⟩
  -- Lusin–Souslin: such a map is a measurable embedding ...
  have hEmbd : @MeasurableEmbedding α α (borel α) m id :=
    @Measurable.measurableEmbedding α α m id hCS (borel α) hStdB hf_meas hf_inj
  -- ... i.e. `comap id m = borel α`, and `comap id m = m`.
  have h1 := @MeasurableEmbedding.comap_eq α α (borel α) m id hEmbd
  rw [MeasurableSpace.comap_id] at h1
  exact h1

end Work.Topology
