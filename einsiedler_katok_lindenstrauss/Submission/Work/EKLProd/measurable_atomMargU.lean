import Mathlib
import Submission.Work.EKLProd.AtomProductDefs
import Submission.Work.EKLC6Core.measurable_apply_section
import Submission.Work.EKLC6Core.measurableSet_shapeGraph
import Submission.Work.EKLC6Core.aemeasurable_atomInfo
import Submission.Work.EKLRelProduct.measurable_hT_hU_pair
import Submission.Work.EKLContract.Lemmas.V_open_one

namespace Work.EKLProd

/-- **Measurability of the `U`-marginal of the joint `(T,U)`-law.**

For a weakly measurable family `κ` of Radon measures on `SL₃(ℝ)` (finite on compacta) and any
Borel set `S ⊆ SL₃(ℝ)`, the function
`y ↦ (atomMargU hf n κ y) S = (((prodFlowerΛTP hf n κ y).map Prod.snd) ↾ (V hf.R ∩ U)) S`
is measurable.

The computation unwinds the definition of `atomMargU`:

  `atomMargU hf n κ y S = (κ y) ({h | h ∈ shape (mH n) H y ∧ hU T U (h * co n y) ∈ S ∩ V hf.R ∩ U})`

(`Measure.restrict_apply`, `Measure.map_apply` and `Measure.map_map`), so that the value is the
section evaluation `κ y (Prod.mk y ⁻¹' Tset)` of the weakly measurable family `κ` against the Borel
section set
`Tset = {(y,h) | h ∈ shape (mH n) H y ∧ hU T U (h * co n y) ∈ S ∩ V hf.R ∩ U} ⊆ X₃ × SL₃(ℝ)`.
That set is Borel — its second condition is the preimage of the Borel set `S ∩ V hf.R ∩ U` under
the (jointly) measurable map `p ↦ hU T U (p.2 * co n p.1)`, and its first condition is Borel by
`Work.EKLC6Core.measurableSet_shapeGraph` (`mH n` is countably generated by the `IsPlaqueAlgebra`
field).  The section-evaluation statement `Work.EKLC6Core.measurable_apply_section` then yields the
conclusion. -/
theorem measurable_atomMargU {H T U : Subgroup Work.EKLContract.SL3}
    (hTH : T ≤ H) (hUH : U ≤ H)
    (hnorm : ∀ g ∈ T, ∀ u ∈ U, g * u * g⁻¹ ∈ U)
    (hcop : ∀ h ∈ H, ∃ g ∈ T, ∃ u ∈ U, h = g * u)
    (hdisj : ∀ g ∈ T, g ∈ U → g = 1)
    (hHc : IsClosed (H : Set Work.EKLContract.SL3))
    (hTc : IsClosed (T : Set Work.EKLContract.SL3))
    (hUc : IsClosed (U : Set Work.EKLContract.SL3))
    {μ : MeasureTheory.Measure Work.EKLContract.X3}
    (hf : Work.EKLProd.ProdFlowerFam H T U μ) (n : ℕ)
    {κ : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    (hmeas : ∀ f : CompactlySupportedContinuousMap Work.EKLContract.SL3 ℝ,
      Measurable fun y => ∫ g, f g ∂(κ y))
    (hfin : ∀ y, MeasureTheory.IsFiniteMeasureOnCompacts (κ y))
    {S : Set Work.EKLContract.SL3} (hS : MeasurableSet S) :
    Measurable fun y => Work.EKLProd.atomMargU hf n κ y S := by
  classical
  -- `mH n` is countably generated by a sequence of Borel sets, so the shape graph is Borel.
  obtain ⟨E, hE, hAgen⟩ :=
    Work.EKLC6Core.exists_generating_sequence (hf.plaqH n).1 (hf.plaqH n).2.1
  have hpair : Measurable (fun g : Work.EKLContract.SL3 =>
      (Work.EKLProd.hT T U g, Work.EKLProd.hU T U g)) :=
    Work.EKLRelProduct.measurable_hT_hU_pair hTH hUH hnorm hcop hdisj hHc hTc hUc
  have hUmeas : Measurable (fun g : Work.EKLContract.SL3 => Work.EKLProd.hU T U g) :=
    measurable_snd.comp hpair
  have hVopen : IsOpen (Work.EKLContract.V hf.R) :=
    (Work.EKLContract.Lemmas.V_open_one hf.R (by linarith [hf.one_le_R])).1
  have hBmeas : MeasurableSet (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3)) :=
    hVopen.measurableSet.inter hUc.measurableSet
  -- ## The Borel section set.
  set Tset : Set (Work.EKLContract.X3 × Work.EKLContract.SL3) :=
    {p | p.2 ∈ Work.EKLContract.shape (hf.mH n) H p.1 ∧
      Work.EKLProd.hU T U (p.2 * hf.co n p.1) ∈
        S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3))}
    with hTsetdef
  have hTset_meas : MeasurableSet Tset := by
    rw [hTsetdef]
    refine MeasurableSet.inter ?_ ?_
    · have h := Work.EKLC6Core.measurableSet_shapeGraph (U := H) hHc hE
      rw [← hAgen] at h
      exact h
    · have hmap : Measurable (fun p : Work.EKLContract.X3 × Work.EKLContract.SL3 =>
          Work.EKLProd.hU T U (p.2 * hf.co n p.1)) :=
        hUmeas.comp (measurable_snd.mul ((hf.meas_co n).comp measurable_fst))
      exact (hS.inter hBmeas).preimage hmap
  have hmain : Measurable fun y => κ y (Prod.mk y ⁻¹' Tset) :=
    Work.EKLC6Core.measurable_apply_section hmeas hfin hTset_meas
  -- ## Pointwise identification with the section evaluation.
  have hpt : ∀ y, Work.EKLProd.atomMargU hf n κ y S = κ y (Prod.mk y ⁻¹' Tset) := by
    intro y
    have hFmeas : Measurable (fun h : Work.EKLContract.SL3 =>
        Work.EKLProd.hU T U (h * hf.co n y)) :=
      hUmeas.comp (continuous_mul_const (hf.co n y)).measurable
    have hSB : MeasurableSet (S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3))) :=
      hS.inter hBmeas
    -- the `U`-marginal is the pushforward of `(κ y)|_shape` under `h ↦ hU T U (h * co n y)`
    have hFac : MeasureTheory.Measure.map Prod.snd (Work.EKLProd.prodFlowerΛTP hf n κ y)
        = MeasureTheory.Measure.map (fun h => Work.EKLProd.hU T U (h * hf.co n y))
            ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y)) := by
      calc MeasureTheory.Measure.map Prod.snd (Work.EKLProd.prodFlowerΛTP hf n κ y)
          = MeasureTheory.Measure.map Prod.snd (MeasureTheory.Measure.map
              (fun w => (Work.EKLProd.hT T U w, Work.EKLProd.hU T U w))
              (MeasureTheory.Measure.map (fun h => h * hf.co n y)
                ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y)))) := by
              rw [Work.EKLProd.prodFlowerΛTP, Work.EKLProd.prodFlowerΛ]
        _ = MeasureTheory.Measure.map (fun w => Work.EKLProd.hU T U w)
              (MeasureTheory.Measure.map (fun h => h * hf.co n y)
                ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y))) := by
              rw [MeasureTheory.Measure.map_map measurable_snd hpair]
              rfl
        _ = MeasureTheory.Measure.map (fun h => Work.EKLProd.hU T U (h * hf.co n y))
              ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y)) := by
              rw [MeasureTheory.Measure.map_map hUmeas (continuous_mul_const (hf.co n y)).measurable]
              rfl
    calc Work.EKLProd.atomMargU hf n κ y S
        = (MeasureTheory.Measure.map Prod.snd (Work.EKLProd.prodFlowerΛTP hf n κ y))
            (S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3))) := by
            rw [Work.EKLProd.atomMargU, MeasureTheory.Measure.restrict_apply hS]
      _ = (MeasureTheory.Measure.map (fun h => Work.EKLProd.hU T U (h * hf.co n y))
              ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y)))
            (S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3))) := by
            rw [hFac]
      _ = ((κ y).restrict (Work.EKLContract.shape (hf.mH n) H y))
            ((fun h => Work.EKLProd.hU T U (h * hf.co n y)) ⁻¹'
              (S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3)))) := by
            rw [MeasureTheory.Measure.map_apply hFmeas hSB]
      _ = κ y ((fun h => Work.EKLProd.hU T U (h * hf.co n y)) ⁻¹'
              (S ∩ (Work.EKLContract.V hf.R ∩ (U : Set Work.EKLContract.SL3))) ∩
              Work.EKLContract.shape (hf.mH n) H y) := by
            rw [MeasureTheory.Measure.restrict_apply (hSB.preimage hFmeas)]
      _ = κ y (Prod.mk y ⁻¹' Tset) := by
            congr 1
            ext h
            rw [hTsetdef]
            simp only [Set.mem_preimage, Set.mem_ofPred_eq, Set.mem_inter_iff]
            tauto
  rw [show (fun y => Work.EKLProd.atomMargU hf n κ y S) = fun y => κ y (Prod.mk y ⁻¹' Tset)
      from funext hpt]
  exact hmain

end Work.EKLProd
