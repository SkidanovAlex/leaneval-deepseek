import Mathlib
import Submission.Work.EKLProd.BoxFlowerDefs

/-!
# Atoms of the product-box flower σ-algebra

The atom of the product-box flower σ-algebra `boxSigma T U R C W` at a point `y` of the collar
`boxCollar T U R C` is the box plaque `boxCollar T U R {c}` over the (unique) transversal point
`c ∈ C` whose collar contains `y`.

This is the product-box analogue of `Work.EKLRelCross.atom_flower` (the ball-plaque case), and the
geometric heart of the strip-algebra computation of `Submission.Work.EKLProd.box_shape_eq`: the
hypotheses are exactly the ones supplied by a cross-section `C` together with the product box
`prodBox T U R = (V R ∩ T) * (V R ∩ U)`:

* `hbound` says that the discrepancy `g'⁻¹ * g` of two box elements lies in the displacement ball
  `Ucl H ρ`; this is the "product box is contained in the `ρ`-ball of `H`" hypothesis on the side
  length `R`;
* `hcross` says that `C` meets every `Ucl H ρ`-orbit in at most one point.

The key computation (`boxCollar_mem_iff_of_prodBox`, the analogue of
`Work.EKLRelCross.flowerSet_mem_iff_of_mem`) is that for `g ∈ prodBox T U R` and `c ∈ C` a point
`g • c` of the collar lies in the collar over `A ⊆ C` **iff** `c ∈ A`: the cross-section property
makes the transversal point of a box translate of a point of `C` unique.  Consequently the
`W`-pattern of a collar point records exactly which slices of `C` its transversal point lies in,
and `hsepW` identifies the transversal point; and the σ-algebra `boxSigma` is generated by the
collars over the slices, so its atoms are the full box plaques.
-/

open MeasureTheory Topology Filter
open scoped ENNReal Pointwise MeasureTheory

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLProd

open Work.EKLContract

/-- The atom of a σ-algebra at a point consists exactly of the points which belong to the same
measurable sets. -/
lemma box_atom_mem_iff_pattern {m : MeasurableSpace X3} {x z : X3} :
    z ∈ atom m x ↔ ∀ s, MeasurableSet[m] s → (x ∈ s ↔ z ∈ s) := by
  rw [atom, Set.mem_sInter]
  constructor
  · intro H s hs
    refine ⟨fun hxs => H s ⟨hs, hxs⟩, ?_⟩
    intro hzs
    by_contra hxs
    exact (H sᶜ ⟨hs.compl, by simpa using hxs⟩) (by simpa using hzs)
  · intro H s hs
    exact (H s hs.1).mp hs.2

/-- For the σ-algebra generated by a family `S`, the atom at `x` is the class of `x` under the
relation "belongs to exactly the same members of `S`". -/
lemma box_atom_mem_generateFrom_iff {S : Set (Set X3)} {x z : X3} :
    z ∈ atom (MeasurableSpace.generateFrom S) x ↔ ∀ s ∈ S, (x ∈ s ↔ z ∈ s) := by
  rw [box_atom_mem_iff_pattern]
  exact ⟨fun H s hs => H s (MeasurableSpace.measurableSet_generateFrom hs),
    fun H s hs => (MeasurableSpace.forall_generateFrom_mem_iff_mem_iff (S := S)).mpr H s hs⟩

/-- **Uniqueness of the transversal point.**  Two box translates of points of the cross-section `C`
which coincide have the same transversal point: the discrepancy of the two box elements lies in
`Ucl H ρ`, so the cross-section property forces it to be `1`. -/
lemma boxCollar_point_unique {H T U : Subgroup SL3} {R ρ : ℝ} {C : Set X3}
    (hbound : ∀ g ∈ prodBox T U R, ∀ g' ∈ prodBox T U R, g'⁻¹ * g ∈ Work.EKLComp.Ucl H ρ)
    (hcross : ∀ c ∈ C, ∀ v ∈ Work.EKLComp.Ucl H ρ, v • c ∈ C → v = 1)
    {g g' : SL3} (hg : g ∈ prodBox T U R) (hg' : g' ∈ prodBox T U R)
    {c c' : X3} (hc : c ∈ C) (hc' : c' ∈ C) (h : g' • c' = g • c) : c' = c := by
  have hv : g'⁻¹ * g ∈ Work.EKLComp.Ucl H ρ := hbound g hg g' hg'
  have hone : g'⁻¹ * g = 1 := by
    refine hcross c hc (g'⁻¹ * g) hv ?_
    have : (g'⁻¹ * g) • c = c' := by
      rw [mul_smul, ← h, ← mul_smul, inv_mul_cancel, one_smul]
    rw [this]; exact hc'
  have hgg : g' = g := inv_mul_eq_one.mp hone
  have hh : g' • c' = g' • c := by simpa only [hgg] using h
  calc c' = g'⁻¹ • (g' • c') := (inv_smul_smul g' c').symm
    _ = g'⁻¹ • (g' • c) := by rw [hh]
    _ = c := inv_smul_smul g' c

/-- **The collar membership of a box translate of a transversal point.**  For `g ∈ prodBox T U R`
and `c ∈ C`, a point `g • c` lies in the collar over `A ⊆ C` exactly when `c ∈ A`: the
cross-section property makes the transversal point of a box translate of a point of `C`
unique. -/
lemma boxCollar_mem_iff_of_prodBox {H T U : Subgroup SL3} {R ρ : ℝ} {C A : Set X3}
    (hbound : ∀ g ∈ prodBox T U R, ∀ g' ∈ prodBox T U R, g'⁻¹ * g ∈ Work.EKLComp.Ucl H ρ)
    (hcross : ∀ c ∈ C, ∀ v ∈ Work.EKLComp.Ucl H ρ, v • c ∈ C → v = 1)
    (hAC : A ⊆ C) {g : SL3} (hg : g ∈ prodBox T U R) {c : X3} (hc : c ∈ C) :
    g • c ∈ boxCollar T U R A ↔ c ∈ A := by
  rw [boxCollar_eq, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨g', hg', c', hc'A, hgc⟩
    have : c' = c := boxCollar_point_unique hbound hcross hg hg' hc (hAC hc'A) hgc
    rwa [this] at hc'A
  · intro hcA
    exact ⟨g, hg, c, hcA, rfl⟩

/-- **The atoms of a product-box flower** are the box plaques over the transversal points.
The product-box analogue of `Work.EKLRelCross.atom_flower`. -/
theorem box_atom {H T U : Subgroup Work.EKLContract.SL3}
    {R ρ : ℝ} {C : Set Work.EKLContract.X3}
    (hbound : ∀ g ∈ Work.EKLProd.prodBox T U R, ∀ g' ∈ Work.EKLProd.prodBox T U R,
      g'⁻¹ * g ∈ Work.EKLComp.Ucl H ρ)
    (hcross : ∀ c ∈ C, ∀ v ∈ Work.EKLComp.Ucl H ρ, v • c ∈ C → v = 1)
    {W : ℕ → Set Work.EKLContract.X3} (hW0 : W 0 = Set.univ)
    (hsepW : ∀ x ∈ C, ∀ y ∈ C, (∀ i, x ∈ W i ↔ y ∈ W i) → x = y) :
    ∀ y ∈ Work.EKLProd.boxCollar T U R C, ∃ c ∈ C,
      y ∈ Work.EKLProd.boxCollar T U R {c} ∧
      Work.EKLContract.atom (Work.EKLProd.boxSigma T U R C W) y =
        Work.EKLProd.boxCollar T U R {c} := by
  intro y hy
  rw [boxCollar_eq, Set.mem_ofPred_eq] at hy
  obtain ⟨g, hg, c₀, hc₀, hgy⟩ := hy
  subst hgy
  refine ⟨c₀, hc₀, ?_, ?_⟩
  · rw [boxCollar_eq, Set.mem_ofPred_eq]
    exact ⟨g, hg, c₀, rfl, rfl⟩
  · refine Set.Subset.antisymm ?_ ?_
    · -- `atom ⊆ boxCollar {c₀}`: read off the transversal point of `z` and separate with `W`.
      intro z hz
      have hzC : z ∈ boxCollar T U R C := by
        have hCW : C ∩ W 0 = C := by rw [hW0, Set.inter_univ]
        have hmeas : MeasurableSet[boxSigma T U R C W] (boxCollar T U R (C ∩ W 0)) :=
          MeasurableSpace.measurableSet_generateFrom ⟨0, rfl⟩
        have hy' : g • c₀ ∈ boxCollar T U R (C ∩ W 0) := by
          rw [hCW, boxCollar_eq, Set.mem_ofPred_eq]
          exact ⟨g, hg, c₀, hc₀, rfl⟩
        have hz' : z ∈ boxCollar T U R (C ∩ W 0) :=
          ((box_atom_mem_iff_pattern.mp hz) _ hmeas).mp hy'
        rwa [hCW] at hz'
      obtain ⟨g₁, hg₁, c₁, hc₁, hz₁⟩ : ∃ g₁ ∈ prodBox T U R, ∃ c₁ ∈ C, g₁ • c₁ = z := by
        simpa only [boxCollar_eq, Set.mem_ofPred_eq] using hzC
      have hc₁c₀ : c₁ = c₀ := by
        -- the `W`-pattern of a collar point records the slices containing its transversal point
        refine hsepW c₁ hc₁ c₀ hc₀ (fun i => ?_)
        have hmeas : MeasurableSet[boxSigma T U R C W] (boxCollar T U R (C ∩ W i)) :=
          MeasurableSpace.measurableSet_generateFrom ⟨i, rfl⟩
        have hpat : z ∈ boxCollar T U R (C ∩ W i) ↔
            g • c₀ ∈ boxCollar T U R (C ∩ W i) :=
          ((box_atom_mem_iff_pattern.mp hz) _ hmeas).symm
        rw [← hz₁] at hpat
        have h1 : g₁ • c₁ ∈ boxCollar T U R (C ∩ W i) ↔ c₁ ∈ W i := by
          rw [boxCollar_mem_iff_of_prodBox hbound hcross (Set.inter_subset_left) hg₁ hc₁]
          exact ⟨fun h => h.2, fun h => ⟨hc₁, h⟩⟩
        have h2 : g • c₀ ∈ boxCollar T U R (C ∩ W i) ↔ c₀ ∈ W i := by
          rw [boxCollar_mem_iff_of_prodBox hbound hcross (Set.inter_subset_left) hg hc₀]
          exact ⟨fun h => h.2, fun h => ⟨hc₀, h⟩⟩
        exact h1.symm.trans (hpat.trans h2)
      have hfin : g₁ • c₀ ∈ boxCollar T U R {c₀} := by
        rw [boxCollar_eq, Set.mem_ofPred_eq]
        exact ⟨g₁, hg₁, c₀, rfl, rfl⟩
      rwa [← hz₁, hc₁c₀]
    · -- `boxCollar {c₀} ⊆ atom`: every box translate of `c₀` has the same collar pattern.
      intro z hz
      rw [boxCollar_eq, Set.mem_ofPred_eq] at hz
      obtain ⟨g₁, hg₁, c₁, hc₁, hz₁⟩ := hz
      rw [Set.mem_singleton_iff] at hc₁
      have hz_eq : z = g₁ • c₀ := by rw [← hz₁, hc₁]
      rw [hz_eq]
      refine (box_atom_mem_generateFrom_iff
        (S := Set.range (fun i => boxCollar T U R (C ∩ W i))) (x := g • c₀)
        (z := g₁ • c₀)).mpr ?_
      rintro A ⟨i, rfl⟩
      have h1 : g₁ • c₀ ∈ boxCollar T U R (C ∩ W i) ↔ c₀ ∈ W i := by
        rw [boxCollar_mem_iff_of_prodBox hbound hcross (Set.inter_subset_left) hg₁ hc₀]
        exact ⟨fun h => h.2, fun h => ⟨hc₀, h⟩⟩
      have h2 : g • c₀ ∈ boxCollar T U R (C ∩ W i) ↔ c₀ ∈ W i := by
        rw [boxCollar_mem_iff_of_prodBox hbound hcross (Set.inter_subset_left) hg hc₀]
        exact ⟨fun h => h.2, fun h => ⟨hc₀, h⟩⟩
      exact h2.trans h1.symm

end Work.EKLProd
