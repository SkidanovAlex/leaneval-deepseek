import Mathlib
import Submission.Work.EKLContract.All

namespace Work.EKLProd

/-- The atom of a point `x` of the σ-algebra generated by a single set `Z ∋ x` is `Z`:
the σ-algebra `generateFrom {Z}` is `{∅, Z, Zᶜ, univ}`, and of these only `Z` and `univ`
contain `x`, so `[x] = Z ∩ univ = Z`. -/
theorem atom_generateFrom_singleton (Z : Set Work.EKLContract.X3) (x : Work.EKLContract.X3) (hx : x ∈ Z) :
    Work.EKLContract.atom (MeasurableSpace.generateFrom {Z}) x = Z := by
  apply Set.Subset.antisymm
  · -- `Z` itself is a measurable set containing `x`, hence `atom ⊆ Z`.
    exact Set.sInter_subset_of_mem
      ⟨MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton Z), hx⟩
  · -- Conversely every measurable set containing `x` contains `Z`: two points are separated
    -- by `generateFrom {Z}` only if they are separated by the generator `Z`.
    intro y hy
    rw [Work.EKLContract.atom, Set.mem_sInter]
    intro t ht
    exact (((MeasurableSpace.forall_generateFrom_mem_iff_mem_iff (S := {Z})).mpr
      (fun s hs => by
        rw [Set.mem_singleton_iff] at hs
        subst hs
        exact iff_of_true hx hy)) t ht.1).mp ht.2

end Work.EKLProd
