import Mathlib
import Submission.Work.EKLContract.Defs

/-!
# `Work.EKLProd.atomUnion_measurable`

Let `m` be a countably generated sub-`σ`-algebra of the Borel `σ`-algebra of
`X₃ = SL₃(ℝ)/SL₃(ℤ)` (a Polish space).  Then every Borel set `S ⊆ X₃` that is a *union of
`m`-atoms* — `atom m x ⊆ S` for all `x ∈ S` — is `m`-measurable.

## Proof

Write `m = generateFrom (range b)` for a sequence `b : ℕ → Set X₃` and let

`f x := (fun n ↦ decide (x ∈ b n)) : ℕ → Bool`

be the associated *pattern map* into the Cantor space `ℕ → Bool`.  An easy induction on
`generateFrom` shows that the `m`-atom of `x` is exactly the fibre `f ⁻¹' {f x}`
(`mem_atom_generateFrom_range_iff`); hence the saturation hypothesis says precisely that `f` is
constant along `S`: `x ∈ S` and `f y = f x` imply `y ∈ S`.

Consequently `f '' S` and `f '' Sᶜ` are disjoint.  Both are images of Borel sets under the Borel
map `f` from a standard Borel space, hence analytic (`MeasurableSet.analyticSet_image`); by the
**Lusin separation theorem** (`AnalyticSet.measurablySeparable`) two disjoint analytic sets are
contained in disjoint Borel sets.  So there is a Borel `u ⊆ (ℕ → Bool)` with `f '' S ⊆ u` and
`u ∩ f '' Sᶜ = ∅`, and these two inclusions give `S = f ⁻¹' u`.  Finally `f` is measurable with
respect to `m = generateFrom (range b)`, so `S = f ⁻¹' u` is `m`-measurable.
-/

open MeasureTheory Set

set_option linter.style.haveILetI false

namespace Work.EKLProd

open Work.EKLContract

/-- **Atoms of a `σ`-algebra generated by a countable family.**  If `m = generateFrom (range b)`
for a sequence `b : ℕ → Set X₃`, then the atom of `x` is the set of points having the same
"membership pattern" in the family `b` as `x` does. -/
lemma mem_atom_generateFrom_range_iff {b : ℕ → Set X3} (x y : X3) :
    y ∈ atom (MeasurableSpace.generateFrom (Set.range b)) x ↔ ∀ n, (y ∈ b n ↔ x ∈ b n) := by
  classical
  have hmem : ∀ n, MeasurableSet[MeasurableSpace.generateFrom (Set.range b)] (b n) :=
    fun n => MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  constructor
  · intro hy n
    refine ⟨fun hyn => ?_, fun hxn => ?_⟩
    · by_contra hxn
      exact (Set.mem_sInter.mp hy _ ⟨(hmem n).compl, hxn⟩) hyn
    · exact Set.mem_sInter.mp hy _ ⟨hmem n, hxn⟩
  · intro h
    refine Set.mem_sInter.mpr ?_
    rintro t ⟨ht, hxt⟩
    have key : x ∈ t ↔ y ∈ t :=
      MeasurableSpace.generateFrom_induction (Set.range b) (fun t _ => x ∈ t ↔ y ∈ t)
        (fun t ht' _ => by
          rcases ht' with ⟨n, rfl⟩
          exact (h n).symm)
        (by simp)
        (fun t _ ht' => ht'.not)
        (fun g _ hg => by
          simp only [Set.mem_iUnion]
          exact exists_congr hg)
        t ht
    exact key.mp hxt

/-- **Separating the fibres of a Borel map** (Lusin separation, in the form used here).

Let `f : X → Z` be a Borel map from a standard Borel space to a second countable Hausdorff
space, and let `s ⊆ X` be Borel and *saturated in the fibres of `f`* (if `x ∈ s` and `f y = f x`
then `y ∈ s`).  Then `s` is the preimage of a Borel set of `Z`.

Indeed `f '' s` and `f '' sᶜ` are disjoint analytic sets, hence contained in disjoint Borel
sets by the Lusin separation theorem. -/
lemma exists_measurableSet_eq_preimage_of_fiber_saturated {X Z : Type*} [MeasurableSpace X]
    [StandardBorelSpace X] [TopologicalSpace Z] [MeasurableSpace Z] [OpensMeasurableSpace Z]
    [T2Space Z] [SecondCountableTopology Z] {f : X → Z} (hf : Measurable f) {s : Set X}
    (hs : MeasurableSet s) (hsat : ∀ x ∈ s, ∀ y, f y = f x → y ∈ s) :
    ∃ u : Set Z, MeasurableSet u ∧ s = f ⁻¹' u := by
  have h1 : AnalyticSet (f '' s) := hs.analyticSet_image hf
  have h2 : AnalyticSet (f '' sᶜ) := hs.compl.analyticSet_image hf
  have hdj : Disjoint (f '' s) (f '' sᶜ) := by
    rw [Set.disjoint_left]
    rintro z ⟨x, hx, hfx⟩ ⟨y, hy, hfy⟩
    exact hy (hsat x hx y (by rw [hfy, hfx]))
  obtain ⟨u, hsu, hdu, hmu⟩ := h1.measurablySeparable h2 hdj
  refine ⟨u, hmu, ?_⟩
  ext x
  constructor
  · intro hx
    exact hsu ⟨x, hx, rfl⟩
  · intro hx
    by_contra hxs
    exact (Set.disjoint_left.mp hdu) ⟨x, hxs, rfl⟩ hx

theorem atomUnion_measurable [PolishSpace Work.EKLContract.X3]
    {m : MeasurableSpace Work.EKLContract.X3} (hm : m ≤ borel Work.EKLContract.X3)
    (hgen : ∃ b : ℕ → Set Work.EKLContract.X3,
      m = MeasurableSpace.generateFrom (Set.range b))
    {S : Set Work.EKLContract.X3}
    (hS : @MeasurableSet Work.EKLContract.X3 (borel Work.EKLContract.X3) S)
    (hsat : ∀ x ∈ S, Work.EKLContract.atom m x ⊆ S) :
    @MeasurableSet Work.EKLContract.X3 m S := by
  classical
  obtain ⟨b, rfl⟩ := hgen
  -- the pattern map into the Cantor space
  let f : X3 → (ℕ → Bool) := fun x n => decide (x ∈ b n)
  -- the atoms of `generateFrom (range b)` are the fibres of `f`
  have hfib : ∀ x y : X3,
      y ∈ atom (MeasurableSpace.generateFrom (Set.range b)) x ↔ f y = f x := by
    intro x y
    rw [mem_atom_generateFrom_range_iff]
    constructor
    · intro h
      funext n
      exact decide_eq_decide.mpr (h n)
    · intro h n
      exact decide_eq_decide.mp (congr_fun h n)
  -- saturation of `S` in the fibres of `f`
  have hsat' : ∀ x ∈ S, ∀ y, f y = f x → y ∈ S := fun x hx y hy =>
    hsat x hx ((hfib x y).mpr hy)
  -- `f` is measurable for the σ-algebra `generateFrom (range b)` ...
  have hf_gen : Measurable[MeasurableSpace.generateFrom (Set.range b)] f := by
    letI : MeasurableSpace X3 := MeasurableSpace.generateFrom (Set.range b)
    rw [measurable_pi_iff]
    intro n
    refine measurable_to_bool ?_
    have h1 : (fun x : X3 => f x n) ⁻¹' {true} = b n := by
      ext x
      simp [f, decide_eq_true_eq]
    rw [h1]
    exact MeasurableSpace.measurableSet_generateFrom ⟨n, rfl⟩
  -- ... hence also for the (larger) Borel σ-algebra
  have hf_borel : Measurable f := hf_gen.mono hm le_rfl
  -- separate `f '' S` from `f '' Sᶜ`
  obtain ⟨u, hmu, hsu⟩ :=
    exists_measurableSet_eq_preimage_of_fiber_saturated (X := X3) (Z := ℕ → Bool)
      hf_borel hS hsat'
  rw [hsu]
  exact hf_gen hmu

end Work.EKLProd
