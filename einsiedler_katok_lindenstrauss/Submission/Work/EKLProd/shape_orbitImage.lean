import Mathlib
import Submission.Work.EKLContract.Defs

/-!
# The shape of the orbit image of a `U`-injective set

`Work.EKLProd.shape_orbitImage` computes the shape (see `Work.EKLContract.shape`, the
definition of Pisa Def. 6.2) of the point `u₀ • x₀` with respect to the σ-algebra generated
by the *single* set `S = {u • x₀ | u ∈ B}`, where `B ⊆ U` and the orbit map of `U` through
`x₀` is injective:

  `shape (generateFrom {S}) U (u₀ • x₀) = {u ∈ U | u * u₀ ∈ B}`   (for any `u₀ ∈ B`).

Two ingredients:

* the atom of `u₀ • x₀` for the σ-algebra generated by the single set `S ∋ u₀ • x₀` is `S`
  itself (a σ-algebra generated by one set is `{∅, S, Sᶜ, univ}`, so `S` is the smallest
  measurable set containing `u₀ • x₀`);
* `u • (u₀ • x₀) = (u * u₀) • x₀ ∈ S` iff `u * u₀ ∈ B`, using injectivity of the orbit map
  on `U` (both `u * u₀` and the witness lie in `U`).
-/

open Work.EKLContract MeasureTheory

set_option linter.style.haveILetI false
set_option linter.unusedTactic false

noncomputable section

namespace Work.EKLProd

theorem shape_orbitImage (U : Subgroup Work.EKLContract.SL3) (x₀ : Work.EKLContract.X3) (B : Set Work.EKLContract.SL3) (hB : B ⊆ U) (hinj : ∀ u₁ ∈ U, ∀ u₂ ∈ U, u₁ • x₀ = u₂ • x₀ → u₁ = u₂) (u₀ : Work.EKLContract.SL3) (hu₀ : u₀ ∈ B) :
    Work.EKLContract.shape (MeasurableSpace.generateFrom {((fun u : Work.EKLContract.SL3 => u • x₀) '' B)}) U (u₀ • x₀) = {u : Work.EKLContract.SL3 | u ∈ U ∧ u * u₀ ∈ B} := by
  set S : Set Work.EKLContract.X3 := (fun u : Work.EKLContract.SL3 => u • x₀) '' B with hSdef
  have hu₀U : u₀ ∈ U := hB hu₀
  have hxS : u₀ • x₀ ∈ S := ⟨u₀, hu₀, rfl⟩
  have hmS : MeasurableSet[MeasurableSpace.generateFrom {S}] S :=
    MeasurableSpace.measurableSet_generateFrom (Set.mem_singleton S)
  -- the atom of `u₀ • x₀` is `S`
  have hatom : Work.EKLContract.atom (MeasurableSpace.generateFrom {S}) (u₀ • x₀) = S := by
    apply Set.Subset.antisymm
    · exact Set.sInter_subset_of_mem ⟨hmS, hxS⟩
    · intro y hy
      rw [Work.EKLContract.atom]
      rw [Set.mem_sInter]
      intro t ht
      obtain ⟨htmeas, hxt⟩ := ht
      rcases (MeasureTheory.measurableSet_generateFrom_singleton_iff (s := S) (t := t)).mp
        htmeas with h | h | h | h
      · rw [h] at hxt; exact absurd hxt (Set.notMem_empty _)
      · rw [h]; exact hy
      · rw [h] at hxt; exact absurd hxS hxt
      · rw [h]; exact Set.mem_univ y
  ext u
  simp only [Work.EKLContract.shape, hatom, Set.mem_ofPred_eq]
  constructor
  · rintro ⟨huU, hmem⟩
    refine ⟨huU, ?_⟩
    rw [Set.mem_image] at hmem
    obtain ⟨v, hvB, hv⟩ := hmem
    have hvU : v ∈ U := hB hvB
    have huU' : u * u₀ ∈ U := U.mul_mem huU hu₀U
    have hvu : v • x₀ = (u * u₀) • x₀ := by rw [mul_smul]; exact hv
    rwa [hinj v hvU (u * u₀) huU' hvu] at hvB
  · rintro ⟨huU, hmem⟩
    refine ⟨huU, ?_⟩
    rw [Set.mem_image]
    exact ⟨u * u₀, hmem, mul_smul u u₀ x₀⟩

end Work.EKLProd
