import Mathlib
import Submission.Work.EKLContract.All

open MeasureTheory

set_option linter.style.haveILetI false

namespace Work.EKLProd

/-- Conditional expectation against the σ-algebra generated by a single measurable set `Z`, under
the restricted measure `μ.restrict Z`, is the constant `(μ Z).toReal⁻¹ * ∫_Z f dμ` almost
everywhere.

The σ-algebra `generateFrom {Z}` has `{∅, Z, Zᶜ, univ}` as its measurable sets
(`MeasureTheory.measurableSet_generateFrom_singleton_iff`), and `μ.restrict Z` is concentrated on
`Z`; on the two "small" sets `∅` and `Zᶜ` both integrals vanish, while on `Z` and `univ` both
integrals equal `∫_Z f dμ` (resp. its multiple by `(μ Z).toReal`). Hence the constant function
`c := (μ Z).toReal⁻¹ * ∫_Z f dμ` satisfies the defining integral identity of the conditional
expectation on every measurable set, and the uniqueness lemma
`MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq` applies. -/
theorem condExp_generateFrom_singleton {α : Type*} [mα : MeasurableSpace α] (μ : MeasureTheory.Measure α) (Z : Set α) (hZ : MeasurableSet Z) [MeasureTheory.IsFiniteMeasure μ] (hμZ : μ Z ≠ 0) (f : α → ℝ) (hf : MeasureTheory.Integrable f μ) :
    ∀ᵐ x ∂(μ.restrict Z), MeasureTheory.condExp (MeasurableSpace.generateFrom {Z}) (μ.restrict Z) f x = (μ Z).toReal⁻¹ * ∫ y in Z, f y ∂μ := by
  -- The σ-algebra generated by `Z` is a sub-σ-algebra of the ambient one.
  have hm : MeasurableSpace.generateFrom {Z} ≤ mα := MeasurableSpace.generateFrom_singleton_le hZ
  -- `(μ Z).toReal` is nonzero: `μ Z ≠ 0` and `μ Z < ∞`.
  have htoReal : (μ Z).toReal ≠ 0 := ENNReal.toReal_ne_zero.mpr ⟨hμZ, measure_ne_top μ Z⟩
  -- `f` is integrable with respect to the restricted measure.
  have hfν : MeasureTheory.Integrable f (μ.restrict Z) := hf.mono_measure Measure.restrict_le_self
  -- The uniqueness criterion for conditional expectations, applied to the constant function.
  have key : (fun _ : α => (μ Z).toReal⁻¹ * ∫ y in Z, f y ∂μ)
      =ᵐ[μ.restrict Z] MeasureTheory.condExp (MeasurableSpace.generateFrom {Z}) (μ.restrict Z) f := by
    refine MeasureTheory.ae_eq_condExp_of_forall_setIntegral_eq hm hfν ?_ ?_ ?_
    · -- a constant is integrable on any set of finite measure
      intro s hs hfin
      haveI : MeasureTheory.IsFiniteMeasure ((μ.restrict Z).restrict s) :=
        MeasureTheory.isFiniteMeasure_restrict.2 hfin.ne
      exact integrable_const _
    · -- the defining integral identity, by the four-case description of the σ-algebra
      intro s hs hfin
      rcases MeasureTheory.measurableSet_generateFrom_singleton_iff.mp hs with rfl | rfl | rfl | rfl
      · -- `s = ∅`
        simp
      · -- `s = Z`
        rw [MeasureTheory.setIntegral_const, Measure.real_def, Measure.restrict_apply_self,
          Measure.restrict_restrict hZ, Set.inter_self, smul_eq_mul]
        rw [← mul_assoc, mul_inv_cancel₀ htoReal, one_mul]
      · -- `s = Zᶜ`
        simp [Measure.real_def, Set.compl_inter_self, Measure.restrict_restrict hZ.compl,
          Measure.restrict_empty]
      · -- `s = univ`
        rw [MeasureTheory.setIntegral_const, Measure.real_def, Measure.restrict_apply_univ,
          Measure.restrict_univ, smul_eq_mul]
        rw [← mul_assoc, mul_inv_cancel₀ htoReal, one_mul]
    · -- a constant function is a.e. strongly measurable for any σ-algebra
      exact stronglyMeasurable_const.aestronglyMeasurable
  exact key.symm

end Work.EKLProd
