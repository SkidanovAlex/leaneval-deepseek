import Mathlib
import Submission.Work.EKLProd.ProdFlowerDefs
import Submission.Work.EKLProd.ProdFlowerLemmas
import Submission.Work.EKLProd.prodPlaqueAux
import Submission.Work.EKLComp.LeafDefs

/-!
# Product-box flowers: vocabulary

This module fixes the vocabulary of the product-box flower construction used by
`Work.EKLProd.prodFlowerFam_exists` (the geometric input of the frozen component `P_Product`).

Given closed subgroups `T, U ≤ H ≤ SL₃(ℝ)` with `H = T · U`, `T ⊓ U = ⊥` and `T` normalising `U`,
a *product-box flower* of radius `R > 0` is built from a transversal `C ⊆ X₃`:

* `boxParam T U R C = ((V R ∩ T) × (V R ∩ U)) × C` — the parametrising set;
* `boxParamMap (t, u, c) = (t * u) • c` — the parametrising map, injective on `boxParam T U R C`
  as soon as `C` meets every `H`-orbit at most once (in the displacement ball `Ucl H ρ`, where
  `ρ` dominates the entry size of `prodBox T U R · (prodBox T U R)⁻¹`) and the points of `C` have
  free `H`-orbits;
* `boxCollar T U R C = boxParamMap '' boxParam T U R C = ⋃_{c ∈ C} (prodBox T U R) • c` — the
  union of the box plaques over the transversal (the *collar*, the analogue of `collar U R C`
  with `Uball U R` replaced by the product box);
* `boxSigma T U R C W = generateFrom (range (fun i => boxCollar T U R (C ∩ W i)))` — the flower
  σ-algebra, generated by the collars over the slices `C ∩ W i` of a countable separating family
  `W`; its atoms are the box plaques `(prodBox T U R) • c`.

`BoxFlowerFam1` packages a single such flower (with its two strip algebras and its measurable
plaque coordinate) in the shape needed for the countable assembly of
`Work.EKLProd.prodFlowerFam_exists`.

## Why the `T × U` parametrisation

The collar is the image of the *Borel* set `boxParam T U R C` under the continuous map
`boxParamMap`; injectivity of that map on the parameter set (uniqueness of the decomposition
`T ⊓ U = ⊥` together with the cross-section property of `C`) makes the image Borel
(Lusin–Suslin, `MeasurableSet.image_of_continuousOn_injOn`) and makes the inverse measurable
(`ContinuousOn.measurableEmbedding`), which is how the plaque coordinate `co` of a flower is
obtained.  Using `prodBox T U R = (V R ∩ T) * (V R ∩ U)` directly would require knowing that this
product of Borel sets is Borel, which is the same Lusin–Suslin argument; the parametrised form
makes it explicit.
-/

open MeasureTheory Topology Filter
open scoped Pointwise ENNReal

set_option warn.classDefReducibility false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

noncomputable section

namespace Work.EKLProd

open Work.EKLContract

/-- The parametrising set of a product-box flower: pairs `(t, u)` from the product box and a
point of the transversal. -/
def boxParam (T U : Subgroup SL3) (R : ℝ) (C : Set X3) : Set (SL3 × SL3 × X3) :=
  (V R ∩ (T : Set SL3)) ×ˢ ((V R ∩ (U : Set SL3)) ×ˢ C)

/-- The parametrising map of a product-box flower: `(t, u, c) ↦ (t * u) • c`. -/
def boxParamMap : SL3 × SL3 × X3 → X3 := fun p => (p.1 * p.2.1) • p.2.2

/-- The product-box collar of a transversal `C`: the union of the box plaques over `C`. -/
def boxCollar (T U : Subgroup SL3) (R : ℝ) (C : Set X3) : Set X3 :=
  boxParamMap '' boxParam T U R C

/-- The flower σ-algebra of a product-box flower: generated by the collars over the slices
`C ∩ W i` of a countable family `W`. -/
def boxSigma (T U : Subgroup SL3) (R : ℝ) (C : Set X3) (W : ℕ → Set X3) : MeasurableSpace X3 :=
  MeasurableSpace.generateFrom (Set.range (fun i => boxCollar T U R (C ∩ W i)))

theorem boxCollar_eq (T U : Subgroup SL3) (R : ℝ) (C : Set X3) :
    boxCollar T U R C = {x : X3 | ∃ g ∈ prodBox T U R, ∃ c ∈ C, g • c = x} := by
  ext x
  constructor
  · rintro ⟨p, hp, rfl⟩
    obtain ⟨hp1, hp2, hpc⟩ := hp
    exact ⟨p.1 * p.2.1, ⟨p.1, ⟨hp1.1, hp1.2⟩, p.2.1, ⟨hp2.1, hp2.2⟩, rfl⟩, p.2.2, hpc, rfl⟩
  · rintro ⟨g, hg, c, hc, rfl⟩
    obtain ⟨t, ht, u, hu, rfl⟩ := hg
    exact ⟨(t, (u, c)), ⟨⟨ht.1, ht.2⟩, ⟨hu.1, hu.2⟩, hc⟩, rfl⟩

/-- The points of `X₃` whose `H`-orbit map is injective (free `H`-orbits). -/
def FreeOrbit (H : Subgroup SL3) : Set X3 :=
  {x | ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₁ • x = h₂ • x → h₁ = h₂}

@[simp] theorem mem_FreeOrbit {H : Subgroup SL3} {x : X3} :
    x ∈ FreeOrbit H ↔ ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₁ • x = h₂ • x → h₁ = h₂ := Iff.rfl

/-- A **single product-box flower**: the datum produced locally at every free point of `X₃` and
assembled into `Work.EKLProd.ProdFlowerFam`. -/
structure BoxFlowerFam1 (H T U : Subgroup SL3) (μ : Measure X3) (R : ℝ) where
  /-- the domain of the flower (a union of box plaques) -/
  Z : Set X3
  /-- a measurable base for the flower -/
  G : Set X3
  /-- the `H`-plaque algebra of the flower -/
  mH : MeasurableSpace X3
  /-- the `T`-strip algebra of the flower -/
  mT : MeasurableSpace X3
  /-- the `U`-strip algebra of the flower -/
  mU : MeasurableSpace X3
  /-- the plaque coordinate of the flower, relative to the base point of the atom -/
  co : X3 → SL3
  measG : @MeasurableSet Work.EKLContract.X3 instMeasurableSpaceX3 G
  GZ : G ⊆ Z
  Zpos : μ Z ≠ 0
  plaqH : IsPlaqueAlgebra H Z mH
  plaqT : IsPlaqueAlgebra T Z mT
  plaqU : IsPlaqueAlgebra U Z mU
  alignT : mH ≤ mT
  alignU : mH ≤ mU
  meas_co : @Measurable Work.EKLContract.X3 Work.EKLContract.SL3 instMeasurableSpaceX3 instMeasurableSpaceSL3 co
  co_mem : ∀ x ∈ Z, co x ∈ prodBox T U R
  freeZ : ∀ x ∈ Z, ∀ h₁ ∈ H, ∀ h₂ ∈ H, h₁ • x = h₂ • x → h₁ = h₂
  co_smul : ∀ x ∈ Z, ∀ h ∈ H, h • x ∈ atom mH x → co (h • x) = h * co x
  shapeH : ∀ x ∈ Z, shape mH H x = {g : SL3 | g ∈ H ∧ g * co x ∈ prodBox T U R}
  shapeT : ∀ x ∈ Z, shape mT T x = {g : SL3 | g ∈ T ∧ g * co x ∈ prodBox T U R}
  shapeU : ∀ x ∈ Z, shape mU U x = {g : SL3 | g ∈ U ∧ g * co x ∈ prodBox T U R}
  meas_tp : @Measurable Work.EKLContract.X3 Work.EKLContract.SL3 instMeasurableSpaceX3 instMeasurableSpaceSL3 (fun x : X3 => hT T U (co x))
  meas_up : @Measurable Work.EKLContract.X3 Work.EKLContract.SL3 instMeasurableSpaceX3 instMeasurableSpaceSL3 (fun x : X3 => hU T U (co x))

end Work.EKLProd
