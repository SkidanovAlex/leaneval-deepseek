import Mathlib
import Submission.Work.EKLContract.Defs
import Submission.Work.EKLProd.setIntegral_indicator_comp_eq_toReal

/-!
# `Work.EKLProd.leafwise_null_transfer_gen`

Transfer of `μ`-nullity to leafwise nullity for a *general* plaque algebra.

`Work.EKLProd.null_transfer` and `Work.EKLComp.leafwise_null_local` do this for the σ-algebra
generated by a single orbit plaque `(u ↦ u • x₀) '' (V ε ∩ U)`.  Here `m` is *any* plaque
algebra for `U` with carrier `Z` (Pisa Def. 6.2 / Thm 6.3(iv)), and only
`(μ.restrict Z) N = 0` is assumed — `N` need not be measurable.

The proof reads the `condexp` axiom of `IsLeafwise` in its raw form: for every bounded Borel `f`,
for `(μ.restrict Z)`-a.e. `x`,

`condExp m (μ.restrict Z) f x = (∫_{shape m U x} f (u • x) ∂ν x) / (ν x (shape m U x)).toReal`.

Applied to `f = 1_M` for a measurable superset `M ⊇ N` of `(μ.restrict Z)`-measure zero, the
conditional expectation vanishes a.e. (`condExp_congr_ae` + `condExp_zero`); since the shape has
finite positive `ν x`-mass a.e. by hypothesis, the numerator vanishes a.e.  The numerator is
`(ν x (shape m U x ∩ (u ↦ u • x) ⁻¹' M)).toReal`
(`setIntegral_indicator_comp_eq_toReal`), and finiteness of the shape upgrades this to
`ν x (shape m U x ∩ (u ↦ u • x) ⁻¹' M) = 0`.  Monotonicity in `M ⊇ N` finishes.
-/

open MeasureTheory

set_option linter.style.haveILetI false

-- `{m : MeasurableSpace X3}` is a local hypothesis of a class type, hence takes part in
-- instance search; the *statement* of the auxiliary lemma below therefore names the ambient
-- Borel structure explicitly.  Inside tactic blocks the fix of `EKLComp/slicing_identity` is
-- used: a local instance which keeps `instMeasurableSpaceX3` in charge of instance search.
namespace Work.EKLProd

/-- Core case of `leafwise_null_transfer_gen`: the null set is measurable. -/
private theorem leafwise_null_transfer_core {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    {U : Subgroup Work.EKLContract.SL3}
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3} (hν : Work.EKLContract.IsLeafwise μ U ν X')
    {Z : Set Work.EKLContract.X3} {m : MeasurableSpace Work.EKLContract.X3}
    (hm : Work.EKLContract.IsPlaqueAlgebra U Z m)
    (hmass : ∀ᵐ x ∂(μ.restrict Z), 0 < (ν x) (Work.EKLContract.shape m U x) ∧
      (ν x) (Work.EKLContract.shape m U x) < ⊤)
    {N : Set Work.EKLContract.X3}
    (hNmeas : @MeasurableSet Work.EKLContract.X3 Work.EKLContract.instMeasurableSpaceX3 N)
    (hN : (μ.restrict Z) N = 0) :
    ∀ᵐ x ∂(μ.restrict Z),
      ν x {u : Work.EKLContract.SL3 | u ∈ Work.EKLContract.shape m U x ∧ u • x ∈ N} = 0 := by
  letI : MeasurableSpace Work.EKLContract.X3 := Work.EKLContract.instMeasurableSpaceX3
  set F : Work.EKLContract.X3 → ℝ := N.indicator (fun _ => (1 : ℝ)) with hFdef
  have hFmeas : Measurable F := Measurable.indicator measurable_const hNmeas
  have hFb : ∃ C, ∀ y, |F y| ≤ C := ⟨1, fun y => by
    by_cases hy : y ∈ N
    · rw [hFdef, Set.indicator_of_mem hy]; norm_num
    · rw [hFdef, Set.indicator_of_notMem hy]; norm_num⟩
  -- `F` vanishes a.e., so its conditional expectation w.r.t. `m` vanishes a.e.
  have hFae : ∀ᵐ y ∂(μ.restrict Z), F y = 0 := by
    rw [MeasureTheory.ae_iff]
    refine MeasureTheory.measure_mono_null ?_ hN
    intro y hy
    rw [hFdef] at hy
    by_contra hyN
    exact hy (Set.indicator_of_notMem hyN _)
  have hcond0 : ∀ᵐ x ∂(μ.restrict Z), MeasureTheory.condExp m (μ.restrict Z) F x = 0 := by
    have h := MeasureTheory.condExp_congr_ae (m := m) (μ := μ.restrict Z) hFae
    filter_upwards [h] with x hx
    simpa using hx
  have hform := hν.condexp Z m hm F hFmeas hFb
  filter_upwards [hform, hcond0, hmass] with x hx hcx hmx
  have hden : (ν x (Work.EKLContract.shape m U x)).toReal ≠ 0 :=
    ENNReal.toReal_ne_zero.mpr ⟨ne_of_gt hmx.1, ne_of_lt hmx.2⟩
  -- the leafwise numerator vanishes
  have hnum : ∫ u in Work.EKLContract.shape m U x, F (u • x) ∂(ν x) = 0 := by
    rw [hcx] at hx
    exact (div_eq_zero_iff.mp hx.symm).resolve_right hden
  have hcont : Continuous (fun u : Work.EKLContract.SL3 => u • x) :=
    continuous_id.smul continuous_const
  have hconv : ∫ u in Work.EKLContract.shape m U x, F (u • x) ∂(ν x)
      = (ν x (Work.EKLContract.shape m U x
          ∩ {u : Work.EKLContract.SL3 | u • x ∈ N})).toReal := by
    rw [hFdef]
    exact Work.EKLProd.setIntegral_indicator_comp_eq_toReal hcont.measurable hNmeas _
  rw [hconv] at hnum
  have hlt : ν x (Work.EKLContract.shape m U x
      ∩ {u : Work.EKLContract.SL3 | u • x ∈ N}) < ⊤ :=
    lt_of_le_of_lt (MeasureTheory.measure_mono Set.inter_subset_left) hmx.2
  have hset : {u : Work.EKLContract.SL3 | u ∈ Work.EKLContract.shape m U x ∧ u • x ∈ N}
      = Work.EKLContract.shape m U x ∩ {u : Work.EKLContract.SL3 | u • x ∈ N} :=
    by ext u; exact Iff.rfl
  rw [hset]
  rw [ENNReal.toReal_eq_zero_iff] at hnum
  rcases hnum with h | h
  · exact h
  · exact absurd h (ne_of_lt hlt)

theorem leafwise_null_transfer_gen {μ : MeasureTheory.Measure Work.EKLContract.X3}
    [MeasureTheory.IsProbabilityMeasure μ]
    {U : Subgroup Work.EKLContract.SL3}
    {ν : Work.EKLContract.X3 → MeasureTheory.Measure Work.EKLContract.SL3}
    {X' : Set Work.EKLContract.X3} (hν : Work.EKLContract.IsLeafwise μ U ν X')
    {Z : Set Work.EKLContract.X3} {m : MeasurableSpace Work.EKLContract.X3}
    (hm : Work.EKLContract.IsPlaqueAlgebra U Z m)
    (hmass : ∀ᵐ x ∂(μ.restrict Z), 0 < (ν x) (Work.EKLContract.shape m U x) ∧
      (ν x) (Work.EKLContract.shape m U x) < ⊤)
    {N : Set Work.EKLContract.X3} (hN : (μ.restrict Z) N = 0) :
    ∀ᵐ x ∂(μ.restrict Z),
      ν x {u : Work.EKLContract.SL3 | u ∈ Work.EKLContract.shape m U x ∧ u • x ∈ N} = 0 := by
  letI : MeasurableSpace Work.EKLContract.X3 := Work.EKLContract.instMeasurableSpaceX3
  -- replace `N` by a measurable `μ.restrict Z`-null superset `M`
  obtain ⟨M, hNM, hMmeas, hMzero⟩ := MeasureTheory.exists_measurable_superset_of_null hN
  filter_upwards [leafwise_null_transfer_core hν hm hmass hMmeas hMzero] with x hx
  refine le_antisymm ?_ zero_le
  refine le_trans (MeasureTheory.measure_mono ?_) (le_of_eq hx)
  intro u hu
  exact ⟨hu.1, hNM hu.2⟩

end Work.EKLProd
