import Mathlib
import Submission.Work.EKLContract.Defs
import Submission.Work.EKLContract.Diag

namespace Work.EKLContract.Lemmas

open Work.EKLContract

/-- The transvections `u_ij(s)` form a one-parameter subgroup of `SL₃(ℝ)`: `u_ij(0) = 1`,
`u_ij(s)u_ij(t) = u_ij(s+t)` and `u_ij(s)⁻¹ = u_ij(-s)`. -/
def rangeUij {i j : Fin 3} (h : i ≠ j) : Subgroup SL3 :=
  { carrier := Set.range fun s : ℝ => uij h s
    one_mem' := ⟨0, by simp [uij, Matrix.SpecialLinearGroup.transvection_coeff_zero]⟩
    mul_mem' := by
      rintro a b ⟨s, rfl⟩ ⟨t, rfl⟩
      exact ⟨s + t, by simp [uij, Matrix.SpecialLinearGroup.transvection_add]⟩
    inv_mem' := by
      rintro a ⟨s, rfl⟩
      exact ⟨-s, by simp [uij, Matrix.SpecialLinearGroup.transvection_inv]⟩ }

/-- The carrier of `rangeUij h` is, by construction, the range of `s ↦ u_ij(s)`. -/
theorem coe_rangeUij {i j : Fin 3} (h : i ≠ j) :
    (rangeUij h : Set SL3) = Set.range (fun s : ℝ => uij h s) := rfl

/-- The range of `s ↦ u_ij(s)` is a subgroup (restated in existential form). -/
theorem range_uij_subgroup {i j : Fin 3} (h : i ≠ j) :
    ∃ S : Subgroup SL3, (S : Set SL3) = Set.range (fun s : ℝ => uij h s) :=
  ⟨rangeUij h, rfl⟩

/-- `U_ij ≤ rangeUij h`: the subgroup generated by the range is contained in the range
once the range is known to be a subgroup. -/
theorem Uij_le_rangeUij {i j : Fin 3} (h : i ≠ j) : Uij h ≤ rangeUij h :=
  (Subgroup.closure_le _).2 (fun _ hx => hx)

/-- `rangeUij h ≤ U_ij`: every transvection lies in the subgroup it generates. -/
theorem rangeUij_le_Uij {i j : Fin 3} (h : i ≠ j) : rangeUij h ≤ Uij h :=
  fun _ hx => Subgroup.subset_closure hx

/-- `U_ij = {u_ij(s) | s ∈ ℝ}` as subgroups. -/
theorem Uij_eq_rangeUij {i j : Fin 3} (h : i ≠ j) : Uij h = rangeUij h :=
  le_antisymm (Uij_le_rangeUij h) (rangeUij_le_Uij h)

/-- Membership in `U_ij`: an element of the root subgroup is exactly a transvection
`u_ij(s)`, because the range of `s ↦ u_ij(s)` is already a subgroup. -/
theorem mem_Uij_iff {i j : Fin 3} (h : i ≠ j) (g : SL3) :
    g ∈ (Work.EKLContract.Uij h : Set Work.EKLContract.SL3) ↔
      ∃ s : ℝ, Work.EKLContract.uij h s = g := by
  rw [show ((Work.EKLContract.Uij h : Subgroup Work.EKLContract.SL3) : Set Work.EKLContract.SL3)
      = (rangeUij h : Set Work.EKLContract.SL3) from
    congrArg (fun T : Subgroup SL3 => (T : Set SL3)) (Uij_eq_rangeUij h),
    coe_rangeUij h]
  exact Iff.rfl

theorem Uij_range {i j : Fin 3} (h : i ≠ j) : ((Work.EKLContract.Uij h : Subgroup Work.EKLContract.SL3) : Set Work.EKLContract.SL3) = Set.range (fun s : ℝ => Work.EKLContract.uij h s) := by
  rw [show ((Work.EKLContract.Uij h : Subgroup Work.EKLContract.SL3) : Set Work.EKLContract.SL3)
      = (rangeUij h : Set Work.EKLContract.SL3) from
    congrArg (fun T : Subgroup SL3 => (T : Set SL3)) (Uij_eq_rangeUij h),
    coe_rangeUij h]

end Work.EKLContract.Lemmas
