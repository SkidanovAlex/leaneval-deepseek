import Mathlib
import Submission.NK.NeukirchUchida.LocalGaloisCompletion
import Submission.NK.RingTheory.Valuation.krasner_valuation_of_isSepClosed
import Submission.Commons.RingTheory.Henselian.adicCompletionIntegers_henselianLocalRing

/-!
# The algebraic elements of a place completion lie in a simple extension of the base

Let `K` be a number field, `p` a finite place of `K`, `K'` a separable closure of `K` and `A` a
place of `K'` above `p`.  Write `L` for the completion of `K'` at `A` and `F` for the `p`-adic
completion of `K`, embedded in `L` by `adicCompletionToPlaceCompletion`.

The main result of this file is that every element `x ∈ L` which is algebraic over `F` lies in
the subfield generated by `F` and a *single* element of `K'` (embedded in `L`):

`∃ y : K', x ∈ Subfield.closure (range (adicCompletionToPlaceCompletion …) ∪ {placeCompletionCoe A y})`.

The proof is Krasner's lemma (`NK.RingTheory.Valuation.krasner_valuation_of_isSepClosed`).
The place completion `L` is separably closed, `F` has characteristic zero, and the ring of
integers of `F` is Henselian (`Commons.RingTheory.Henselian.adicCompletionIntegers_henselianLocalRing`);
the hypothesis `hW` identifies the two integer rings.  Krasner's lemma requires an element `y'`
of `K'` (whose image in `L` is) closer to `x` than every other `F`-conjugate of `x`; such a `y'`
exists because `K'` is dense in `L` (`denseRange_placeCompletionCoe`) and `x` has only finitely
many conjugates in `L`.
-/

set_option linter.style.haveILetI false

open scoped Valued Pointwise Topology
open Polynomial Filter

namespace NK.NeukirchUchida

theorem exists_mem_subfieldClosure_of_eval_eq_zero {K K' : Type*} [Field K]
    [NumberField K] [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
    (hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
        (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p)
    {x : NK.NeukirchUchida.placeCompletion A}
    (hx : ∃ q : Polynomial (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p), q ≠ 0 ∧
      Polynomial.eval₂ (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) x q = 0) :
    ∃ y : K', x ∈ Subfield.closure
      (Set.range (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) ∪
        {NK.NeukirchUchida.placeCompletionCoe A y}) := by
  classical
  -- The `p`-adic completion `F` of `K` and the completion `L` of `K'` at `A`.
  let F := IsDedekindDomain.HeightOneSpectrum.adicCompletion K p
  let L := placeCompletion A
  -- `L` is separably closed.
  haveI hSep : IsSepClosed L := isSepClosed_placeCompletion p A hA
  -- `L` is an `F`-algebra through the canonical map.
  letI hAlg : Algebra F L := (adicCompletionToPlaceCompletion p A hA).toAlgebra
  -- `F` has characteristic zero, hence every algebraic element is separable.
  haveI hCZ : CharZero F :=
    charZero_of_injective_algebraMap (RingHom.injective (algebraMap K F))
  -- The ring of integers of `F` is Henselian.
  haveI hHen : HenselianLocalRing
      (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p) :=
    Commons.RingTheory.Henselian.adicCompletionIntegers_henselianLocalRing (K := K) p
  -- `x` is algebraic over `F`, hence separable over `F`.
  obtain ⟨q, hq0, hqx⟩ := hx
  have halg : IsAlgebraic F x := ⟨q, hq0, hqx⟩
  have hxint : IsIntegral F x := halg.isIntegral
  have hxsep : IsSeparable F x := (minpoly.irreducible hxint).separable
  -- The valuation of the place completion.
  let v := Valued.v (R := L) (Γ₀ := A.ValueGroup)
  -- The `F`-conjugates of `x` in `L` other than `x` itself.
  let T : Finset L := ((minpoly F x).rootSet L).toFinset.erase x
  have hval_ne : ∀ z : L, z ≠ x → v.restrict (x - z) ≠ 0 := by
    intro z hz h0
    have h1 : v (x - z) = 0 := by
      rw [← Valuation.embedding_restrict v (x - z), h0, map_zero]
    have h2 : x - z = 0 := (Valuation.zero_iff v).mp h1
    exact hz (sub_eq_zero.mp h2).symm
  -- A positive separation of `x` from its conjugates.
  have hsep_exists : ∃ γ : (MonoidWithZeroHom.ofClass v).ValueGroup₀,
      γ ≠ 0 ∧ ∀ z ∈ T, γ ≤ v.restrict (x - z) := by
    by_cases h : T.Nonempty
    · let vals : Finset (MonoidWithZeroHom.ofClass v).ValueGroup₀ :=
        T.image fun z => v.restrict (x - z)
      have hvals : vals.Nonempty := Finset.image_nonempty.mpr h
      refine ⟨vals.min' hvals, ?_, ?_⟩
      · obtain ⟨z, hz, hzγ⟩ := Finset.mem_image.mp (Finset.min'_mem vals hvals)
        rw [← hzγ]
        exact hval_ne z (Finset.mem_erase.mp hz).1
      · intro z hz
        exact Finset.min'_le vals _ (Finset.mem_image_of_mem _ hz)
    · exact ⟨1, one_ne_zero, fun z hz => absurd ⟨z, hz⟩ h⟩
  obtain ⟨γ, hγ_ne, hγ_le⟩ := hsep_exists
  -- The corresponding neighbourhood of `x`, met by an element of `K'` by density.
  have hmem_nhds : {z : L | v.restrict (z - x) < γ} ∈ 𝓝 x :=
    (Valued.mem_nhds (R := L) (s := {z : L | v.restrict (z - x) < γ}) (x := x)).mpr
      ⟨Units.mk0 γ hγ_ne, fun y hy => by rw [Units.val_mk0] at hy; exact hy⟩
  obtain ⟨y', hy'⟩ := (denseRange_placeCompletionCoe A).mem_nhds hmem_nhds
  have hy'x : v.restrict (x - placeCompletionCoe A y') < γ := by
    rw [Valuation.map_sub_swap]; exact hy'
  -- The approximating element is integral over `F`.
  have hyInt : IsIntegral F (placeCompletionCoe A y') :=
    IsIntegral.map_of_comp_eq (algebraMap K F) (placeCompletionCoe A)
      (RingHom.ext fun z => adicCompletionToPlaceCompletion_algebraMap p A hA z)
      (Algebra.IsIntegral.isIntegral y')
  -- Krasner's closeness condition.
  have hclose : ∀ x' : L, IsConjRoot F x x' → x ≠ x' →
      (placeCompletionIntegers A).valuation (x - placeCompletionCoe A y') <
        (placeCompletionIntegers A).valuation (x - x') := by
    intro x' hconj hne
    have hx'root : x' ∈ (minpoly F x).rootSet L :=
      (isConjRoot_iff_mem_minpoly_rootSet hxint).mp hconj
    have hx'T : x' ∈ T := by
      simp only [T, Finset.mem_erase, Set.mem_toFinset]
      exact ⟨hne.symm, hx'root⟩
    have hlt : v.restrict (x - placeCompletionCoe A y') < v.restrict (x - x') :=
      lt_of_lt_of_le hy'x (hγ_le x' hx'T)
    have hlt' : v (x - placeCompletionCoe A y') < v (x - x') :=
      (Valuation.isEquiv_restrict v).lt_iff_lt.mpr hlt
    exact (Valuation.isEquiv_valuation_valuationSubring v).lt_iff_lt.mp hlt'
  -- Krasner's lemma.
  have hkras : x ∈ IntermediateField.adjoin F ({placeCompletionCoe A y'} : Set L) :=
    NK.RingTheory.Valuation.krasner_valuation_of_isSepClosed
      (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers K p)
      (placeCompletionIntegers A) hW hxsep hyInt hclose
  refine ⟨y', ?_⟩
  have hmem : x ∈ (IntermediateField.adjoin F ({placeCompletionCoe A y'} : Set L)).toSubfield :=
    hkras
  rw [IntermediateField.adjoin_toSubfield] at hmem
  exact hmem

end NK.NeukirchUchida
