import Mathlib
import Submission.NK.BrauerHasse.Profinite

set_option maxHeartbeats 1600000

open CategoryTheory

namespace NK.BrauerHasse

set_option autoImplicit false

universe u

variable {K K' : Type u} [Field K] [Field K'] [Algebra K K'] [IsSepClosure K K']

section transition

variable (p : ℕ) (U : Subgroup Gal(K'/K)) (A : ValuationSubring K')

/-- Composition of the quotient maps on the local levels. -/
private lemma localLevelQuotHom_comp {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'}
    (h₁ : L₁ ≤ L₂) (h₂ : L₂ ≤ L₃) :
    (localLevelQuotHom U A h₁).comp (localLevelQuotHom U A h₂) =
      localLevelQuotHom U A (h₁.trans h₂) := by
  simp only [localLevelQuotHom]
  rw [QuotientGroup.map_comp_map (N := L₃.fixingSubgroup.subgroupOf (U ⊓ stabSubgroup A))
      (M := L₂.fixingSubgroup.subgroupOf (U ⊓ stabSubgroup A))
      (O := L₁.fixingSubgroup.subgroupOf (U ⊓ stabSubgroup A))
      (f := MonoidHom.id ↥(U ⊓ stabSubgroup A)) (g := MonoidHom.id ↥(U ⊓ stabSubgroup A))]
  simp

/-- The transition maps of the local filtered system compose. -/
private lemma localLevelMap_comp {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'}
    (h₁ : L₁ ≤ L₂) (h₂ : L₂ ≤ L₃) :
    localLevelMap p U A h₁ ≫ localLevelMap p U A h₂ = localLevelMap p U A (h₁.trans h₂) := by
  simp only [localLevelMap]
  rw [← H2.map_comp, localLevelQuotHom_comp]

/-- Elementwise form of `localLevelMap_comp`. -/
private lemma localLevelMap_comp_apply {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'}
    (h₁ : L₁ ≤ L₂) (h₂ : L₂ ≤ L₃) (a : LocalLevelH2 p U A L₁) :
    localLevelMap p U A h₂ (localLevelMap p U A h₁ a) =
      localLevelMap p U A (h₁.trans h₂) a := by
  have h := ModuleCat.comp_apply (localLevelMap p U A h₁) (localLevelMap p U A h₂) a
  rw [localLevelMap_comp p U A h₁ h₂] at h
  exact h.symm

/-- The transition map depends only on the two levels, not on the proof of the inclusion. -/
private lemma localLevelMap_congr {L L' : FiniteGaloisIntermediateField K K'} {h h' : L ≤ L'} :
    localLevelMap p U A h = localLevelMap p U A h' := by
  simp only [localLevelMap]

/-- The transition map of an identity inclusion is the identity. -/
private lemma localLevelMap_self (L : FiniteGaloisIntermediateField K K') :
    localLevelMap p U A (le_refl L) = 𝟙 (LocalLevelH2 p U A L) := by
  simp only [localLevelMap]
  rw [show localLevelQuotHom U A (le_refl L) = MonoidHom.id _ from by
    simp only [localLevelQuotHom]; exact QuotientGroup.map_id _ _]
  rw [H2.map_id]

end transition

section relation

variable (p : ℕ) (U : Subgroup Gal(K'/K)) (A : ValuationSubring K')

/-- The disjoint union of the local levels. -/
private abbrev LocalLevelTot := Σ L : FiniteGaloisIntermediateField K K', LocalLevelH2 p U A L

/-- The generating relation of the colimit: an element of a level and its inflation to a larger
level.  This is (definitionally) the relation appearing in the definition of `LocalH2`. -/
private def localRel (x y : LocalLevelTot p U A) : Prop :=
  ∃ h : x.1 ≤ y.1, y.2 = localLevelMap p U A h x.2

/-- The equivalence relation generated by `localRel`: two elements of the disjoint union of the
levels are equivalent when they agree after inflation to a common upper bound. -/
private def localEqv (x y : LocalLevelTot p U A) : Prop :=
  ∃ (M : FiniteGaloisIntermediateField K K') (hx : x.1 ≤ M) (hy : y.1 ≤ M),
    localLevelMap p U A hx x.2 = localLevelMap p U A hy y.2

private lemma localEqv_refl (x : LocalLevelTot p U A) : localEqv p U A x x :=
  ⟨x.1, le_refl _, le_refl _, rfl⟩

private lemma localEqv_symm {x y : LocalLevelTot p U A} (h : localEqv p U A x y) :
    localEqv p U A y x := by
  obtain ⟨M, hx, hy, he⟩ := h
  exact ⟨M, hy, hx, he.symm⟩

/-- The transition maps only depend on the two levels, so they agree on any two inclusions. -/
private lemma localLevelMap_congr_apply {L L' : FiniteGaloisIntermediateField K K'}
    {h h' : L ≤ L'} (a : LocalLevelH2 p U A L) :
    localLevelMap p U A h a = localLevelMap p U A h' a :=
  congrArg (fun f => f a) (localLevelMap_congr p U A (h := h) (h' := h'))

private lemma localEqv_trans {x y z : LocalLevelTot p U A} (hxy : localEqv p U A x y)
    (hyz : localEqv p U A y z) : localEqv p U A x z := by
  obtain ⟨M₁, hx₁, hy₁, he₁⟩ := hxy
  obtain ⟨M₂, hy₂, hz₂, he₂⟩ := hyz
  have u₁ : M₁ ≤ M₁ ⊔ M₂ := le_sup_left
  have u₂ : M₂ ≤ M₁ ⊔ M₂ := le_sup_right
  refine ⟨M₁ ⊔ M₂, hx₁.trans u₁, hz₂.trans u₂, ?_⟩
  calc localLevelMap p U A (hx₁.trans u₁) x.2
      = localLevelMap p U A u₁ (localLevelMap p U A hx₁ x.2) :=
        (localLevelMap_comp_apply p U A hx₁ u₁ x.2).symm
    _ = localLevelMap p U A u₁ (localLevelMap p U A hy₁ y.2) :=
        congrArg (fun t => localLevelMap p U A u₁ t) he₁
    _ = localLevelMap p U A (hy₁.trans u₁) y.2 :=
        localLevelMap_comp_apply p U A hy₁ u₁ y.2
    _ = localLevelMap p U A (hy₂.trans u₂) y.2 :=
        localLevelMap_congr_apply p U A y.2
    _ = localLevelMap p U A u₂ (localLevelMap p U A hy₂ y.2) :=
        (localLevelMap_comp_apply p U A hy₂ u₂ y.2).symm
    _ = localLevelMap p U A u₂ (localLevelMap p U A hz₂ z.2) :=
        congrArg (fun t => localLevelMap p U A u₂ t) he₂
    _ = localLevelMap p U A (hz₂.trans u₂) z.2 :=
        localLevelMap_comp_apply p U A hz₂ u₂ z.2

private lemma localEqv_of_rel {x y : LocalLevelTot p U A} (h : localRel p U A x y) :
    localEqv p U A x y := by
  obtain ⟨hxy, hy⟩ := h
  refine ⟨y.1, hxy, le_refl y.1, ?_⟩
  rw [hy, localLevelMap_self p U A y.1]
  rw [ModuleCat.id_apply]

private lemma localEqv_of_eqvGen {x y : LocalLevelTot p U A}
    (h : Relation.EqvGen (localRel p U A) x y) : localEqv p U A x y := by
  induction h with
  | rel x y hxy => exact localEqv_of_rel p U A hxy
  | refl x => exact localEqv_refl p U A x
  | symm x y _ ih => exact localEqv_symm p U A ih
  | trans x y z _ _ ih₁ ih₂ => exact localEqv_trans p U A ih₁ ih₂

/-- `EqvGen` of a relation coincides with `EqvGen` of its own `EqvGen`. -/
private lemma eqvGen_idem {α : Type*} {r : α → α → Prop} {x y : α}
    (h : Relation.EqvGen (Relation.EqvGen r) x y) : Relation.EqvGen r x y := by
  induction h with
  | rel x y hxy => exact hxy
  | refl x => exact Relation.EqvGen.refl x
  | symm x y _ ih => exact Relation.EqvGen.symm _ _ ih
  | trans x y z _ _ ih₁ ih₂ => exact Relation.EqvGen.trans _ _ _ ih₁ ih₂

/-- Two classes of `LocalH2` coming from local levels are equal exactly when the two elements
agree after inflation to a common upper bound. -/
private lemma localEqv_of_quot_eq {x y : LocalLevelTot p U A}
    (h : Quot.mk (Relation.EqvGen (localRel p U A)) x =
      Quot.mk (Relation.EqvGen (localRel p U A)) y) : localEqv p U A x y :=
  localEqv_of_eqvGen p U A (eqvGen_idem (Quot.eqvGen_exact h))

end relation

theorem local_ofLevel_eq_iff {K K' : Type u} [Field K] [Field K']
    [Algebra K K'] [IsSepClosure K K'] (p : ℕ) {U : Subgroup Gal(K'/K)}
    {A : ValuationSubring K'} {L L' : FiniteGaloisIntermediateField K K'}
    (a : NK.BrauerHasse.LocalLevelH2 p U A L) (b : NK.BrauerHasse.LocalLevelH2 p U A L') :
    NK.BrauerHasse.LocalH2.ofLevel p U A L a = NK.BrauerHasse.LocalH2.ofLevel p U A L' b ↔
      ∃ (M : FiniteGaloisIntermediateField K K') (h₁ : L ≤ M) (h₂ : L' ≤ M),
        (NK.BrauerHasse.localLevelMap p U A h₁) a =
          (NK.BrauerHasse.localLevelMap p U A h₂) b := by
  constructor
  · intro h
    have hq : Quot.mk (Relation.EqvGen (localRel p U A)) (⟨L, a⟩ : LocalLevelTot p U A) =
        Quot.mk (Relation.EqvGen (localRel p U A)) ⟨L', b⟩ := h
    obtain ⟨M, hx, hy, he⟩ := localEqv_of_quot_eq p U A hq
    exact ⟨M, hx, hy, he⟩
  · rintro ⟨M, h₁, h₂, he⟩
    rw [← LocalH2.ofLevel_levelMap (p := p) (U := U) (A := A) h₁ a,
      ← LocalH2.ofLevel_levelMap (p := p) (U := U) (A := A) h₂ b, he]

end NK.BrauerHasse
