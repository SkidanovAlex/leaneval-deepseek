# The cyclic case implies the general case (Čebotarev, existence form), at an arbitrary universe

The universe-polymorphic copy of
`NK.ChebotarevGeneral.infinite_frobSet_of_abelian`
(`Submission/Work/ChebotarevGeneral/Infinity.lean`):

* `NK.UniverseWeakNU.AbelianChebotarevDensityU` — the abelian case of Čebotarev's density theorem
  for number fields in `Type u` — implies
* `NK.UniverseWeakNU.ChebotarevInfiniteU` — the existence form, for a finite Galois extension
  `N/K` with the **base field `K` in the bottom universe** and the top field `N` in `Type u`:
  every `σ : Gal(N/K)` is a Frobenius element at infinitely many primes of `K`.

The argument is Deuring's transfer in its *existence* form, exactly as at `Type 0`.  Let `H = ⟨σ⟩`
and `M = N^H`; the extension `N/M` is cyclic, so the abelian case — applied to the two fields
`↥M` and `N`, both in `Type u` — gives that the set `S` of primes of `M` at which `σ` is a
Frobenius element of `N/M` has Dirichlet density `1/|H| > 0`, hence a partial Dirichlet series over
`S` tending to `+∞`.  If the Frobenius set of `σ` over `K` were finite, then every prime of `M`
above a prime outside it would have residue degree at least two over `K` (ascent of Frobenius); the
primes of `M` above the finite Frobenius set contribute at most their finite cardinality and the
primes of residue degree at least two contribute a bounded amount
(`NK.ChebotarevGeneral.summable_zetaWeight_of_inertiaDeg_ge_two`), contradicting the divergence.

The auxiliary lemmas of the `Type 0` proof are restated here with the same universes as the
argument needs them (`finite_setOf_liesOverU`, `two_le_inertiaDeg'_of_not_isFrobAtPrimeU`,
`comm_of_fixingSubgroup_eq_zpowersU`, `hasDirichletDensity_frobSetSub_of_abelianU`); the remaining
ingredients of the `Type 0` chapter are already universe-polymorphic and are imported unchanged.
-/
import Mathlib
import Submission.NK.UniverseWeakNU.ChebotarevU

namespace NK.UniverseWeakNU

set_option linter.style.haveILetI false

noncomputable section

universe u v

open NK.Chebotarev Filter
open scoped Topology

/-! ## Elementary group theory -/

/-- The cyclic subgroup generated by `σ` is commutative, for the elements of a fixing subgroup.
Universe-polymorphic copy of `NK.ChebotarevGeneral.comm_of_fixingSubgroup_eq_zpowers`. -/
theorem comm_of_fixingSubgroup_eq_zpowersU {K N : Type*} [Field K] [Field N] [Algebra K N]
    {M : IntermediateField K N} {σ : Gal(N/K)}
    (hM : M.fixingSubgroup = Subgroup.zpowers σ) {a b : Gal(N/K)}
    (ha : a ∈ M.fixingSubgroup) (hb : b ∈ M.fixingSubgroup) : a * b = b * a := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hM ▸ ha)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hM ▸ hb)
  rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm]

/-! ## The primes above a fixed prime are finite -/

/-- **Only finitely many primes of `M` lie above a given prime of `K`.**  Universe-polymorphic
copy of `NK.ChebotarevGeneral.finite_setOf_liesOver`. -/
theorem finite_setOf_liesOverU {K M : Type*} [Field K] [NumberField K] [Field M] [NumberField M]
    [Algebra K M] [FiniteDimensional K M] (𝔭 : PrimeIdeal K) :
    {𝒬 : PrimeIdeal M | 𝒬.asIdeal.LiesOver 𝔭.asIdeal}.Finite := by
  have hfin : (𝔭.asIdeal.primesOver (NumberField.RingOfIntegers M)).Finite :=
    Commons.NumberTheory.NumberField.finite_primesOver 𝔭.asIdeal 𝔭.isPrime 𝔭.ne_bot
  refine Set.Finite.of_finite_image (s := {𝒬 : PrimeIdeal M | 𝒬.asIdeal.LiesOver 𝔭.asIdeal})
    (f := fun 𝒬 => 𝒬.asIdeal) ?_ ?_
  · exact hfin.subset (by
      rintro _ ⟨𝒬, h𝒬, rfl⟩
      exact ⟨inferInstance, h𝒬⟩)
  · intro 𝒬 _ 𝒬' _ h
    exact IsDedekindDomain.HeightOneSpectrum.ext h

/-! ## The ascent half of the transfer -/

/-- **A prime of an intermediate field with residue degree one over `𝔭` at which the image of `σ`
is a Frobenius element forces `𝔭` to be in the Frobenius set of `σ`.**  Universe-polymorphic copy
of `NK.ChebotarevGeneral.two_le_inertiaDeg'_of_not_isFrobAtPrime`. -/
theorem two_le_inertiaDeg'_of_not_isFrobAtPrimeU {K N : Type*} [Field K] [NumberField K] [Field N]
    [NumberField N] [Algebra K N] [FiniteDimensional K N] [IsGalois K N]
    {M : IntermediateField K N} {σ : Gal(N/K)} (hσ : σ ∈ M.fixingSubgroup)
    {𝔭 : PrimeIdeal K} {𝒬 : PrimeIdeal ↥M} (hQ : 𝒬.asIdeal.LiesOver 𝔭.asIdeal)
    (hnot : ¬ IsFrobAtPrime (K := K) (L := N) 𝔭 σ)
    (hfrob : IsFrobAtPrime (K := ↥M) (L := N) 𝒬 (M.fixingSubgroupEquiv ⟨σ, hσ⟩)) :
    2 ≤ 𝔭.asIdeal.inertiaDeg' 𝒬.asIdeal := by
  by_contra h
  haveI := hQ
  have hpos : 0 < 𝔭.asIdeal.inertiaDeg' 𝒬.asIdeal :=
    Ideal.inertiaDeg'_pos 𝔭.asIdeal 𝒬.asIdeal
  have h1 : 𝔭.asIdeal.inertiaDeg' 𝒬.asIdeal = 1 := by omega
  exact hnot (NK.ChebotarevGeneral.exists_isFrobAt_of_isFrobAtPrime_under M hQ h1 hσ hfrob)

/-! ## The abelian case at the cyclic level -/

/-- **The abelian case of Čebotarev, applied at the cyclic level `N/N^⟨σ⟩`**, at an arbitrary
universe.  Universe-polymorphic copy of
`NK.ChebotarevGeneral.hasDirichletDensity_frobSetSub_of_abelian`:  for `σ : Gal(N/K)` the
intermediate field `M = N^⟨σ⟩` satisfies `Gal(N/M) = ⟨σ⟩`, so the abelian case — applied to the
extension `N/↥M` of fields in `Type u` — gives the density `1/ord(σ)` of the primes of `M` at which
`σ` is a Frobenius element of `N/M`. -/
theorem hasDirichletDensity_frobSetSub_of_abelianU {K : Type v} {N : Type u} [Field K]
    [NumberField K] [Field N] [NumberField N] [Algebra K N] [FiniteDimensional K N] [IsGalois K N]
    (h_ab : AbelianChebotarevDensityU.{u}) (σ : Gal(N/K)) :
    NumberField.Set.HasDirichletDensity
      (NK.ChebotarevGeneral.frobSetSub (K := K) (N := N)
        (IntermediateField.fixedField (Subgroup.zpowers σ)) σ
        (by rw [IntermediateField.fixingSubgroup_fixedField]; exact Subgroup.mem_zpowers σ))
      (1 / (Nat.card (Subgroup.zpowers σ) : ℝ)) := by
  classical
  set H : Subgroup Gal(N/K) := Subgroup.zpowers σ with hH
  set M : IntermediateField K N := IntermediateField.fixedField H with hM
  have hfix : M.fixingSubgroup = H := by
    rw [hM, hH]
    exact IntermediateField.fixingSubgroup_fixedField H
  have hσ : σ ∈ M.fixingSubgroup := by rw [hfix]; exact Subgroup.mem_zpowers σ
  have hcomm : ∀ a b : Gal(N/↥M), a * b = b * a := by
    intro a b
    obtain ⟨x, rfl⟩ := M.fixingSubgroupEquiv.surjective a
    obtain ⟨y, rfl⟩ := M.fixingSubgroupEquiv.surjective b
    rw [← map_mul, ← map_mul]
    exact congrArg M.fixingSubgroupEquiv
      (Subtype.ext (comm_of_fixingSubgroup_eq_zpowersU hfix x.2 y.2))
  have hdens := h_ab ↥M N hcomm (M.fixingSubgroupEquiv ⟨σ, hσ⟩)
  have hcard : Nat.card (Gal(N/↥M)) = Nat.card (Subgroup.zpowers σ) := by
    have h1 : Nat.card (Gal(N/↥M)) = Nat.card ↥(M.fixingSubgroup) :=
      (Nat.card_congr M.fixingSubgroupEquiv.toEquiv).symm
    rw [h1, hfix, hH]
  rw [hcard] at hdens
  exact hdens

/-! ## A set of positive density has a divergent partial Dirichlet series -/

/-- **A set of positive Dirichlet density has a partial Dirichlet series tending to `+∞`.** -/
theorem tendsto_primeIdealZetaSum_of_hasDirichletDensityU {K : Type*} [Field K] [NumberField K]
    {S : Set (PrimeIdeal K)} {δ : ℝ} (h : NumberField.Set.HasDirichletDensity S δ) (hδ : 0 < δ) :
    Tendsto (fun s : ℝ => NumberField.Set.primeIdealZetaSum S s) (𝓝[>] (1 : ℝ)) atTop :=
  NK.ChebotarevGeneral.tendsto_primeIdealZetaSum_of_hasDirichletDensity h hδ

/-! ## The existence form of Čebotarev's theorem -/

/-- **The cyclic case implies the general case, in existence form, at an arbitrary universe.**

The abelian case of Čebotarev's density theorem at `Type u` implies the existence form
`NK.UniverseWeakNU.ChebotarevInfiniteU`:  for a finite Galois extension `N/K` of number fields
with the base field `K` in the bottom universe and `N : Type u`, every `σ : Gal(N/K)` is a
Frobenius element at infinitely many primes of `K`. -/
theorem chebotarevInfiniteU_of_abelianU (h : AbelianChebotarevDensityU.{u}) :
    ChebotarevInfiniteU.{u} := by
  classical
  intro K N _ _ _ _ _ _ _ σ
  -- the cyclic level `M = N^⟨σ⟩`
  set H : Subgroup Gal(N/K) := Subgroup.zpowers σ with hH
  set M : IntermediateField K N := IntermediateField.fixedField H with hM
  have hfix : M.fixingSubgroup = H := by
    rw [hM, hH]
    exact IntermediateField.fixingSubgroup_fixedField H
  have hσ : σ ∈ M.fixingSubgroup := by rw [hfix]; exact Subgroup.mem_zpowers σ
  set S : Set (PrimeIdeal ↥M) :=
    NK.ChebotarevGeneral.frobSetSub (K := K) (N := N) M σ hσ with hS
  -- the abelian case gives density `1/|H|` for the primes of `M` at which `σ` is a Frobenius
  have hd : NumberField.Set.HasDirichletDensity S (1 / (Nat.card (Subgroup.zpowers σ) : ℝ)) := by
    rw [hS]
    exact hasDirichletDensity_frobSetSub_of_abelianU (K := K) (N := N) h σ
  have hδ : 0 < 1 / (Nat.card (Subgroup.zpowers σ) : ℝ) := by
    have h1 : 0 < Nat.card ↥(Subgroup.zpowers σ) := Nat.card_pos
    positivity
  have htend : Tendsto (fun s : ℝ => NumberField.Set.primeIdealZetaSum S s) (𝓝[>] (1 : ℝ)) atTop :=
    tendsto_primeIdealZetaSum_of_hasDirichletDensityU hd hδ
  -- suppose that `σ` is a Frobenius element at only finitely many primes of `K`
  by_contra hfin
  -- the finitely many primes of `M` above the primes of `K` at which `σ` is a Frobenius
  set A : Set (PrimeIdeal ↥M) :=
    {𝒬 | ∃ 𝔭 ∈ NK.ChebotarevGeneral.frobSet (K := K) (N := N) σ,
      𝒬.asIdeal.LiesOver 𝔭.asIdeal} with hA
  have hAfin : A.Finite := by
    rw [hA]
    refine (Set.Finite.biUnion (Set.not_infinite.mp hfin)
      (fun 𝔭 _ => finite_setOf_liesOverU (K := K) (M := ↥M) 𝔭)).subset ?_
    rintro 𝒬 ⟨𝔭, h𝔭, hlies⟩
    exact Set.mem_biUnion h𝔭 hlies
  -- the remaining primes of `S`
  set T : Set (PrimeIdeal ↥M) := S \ A with hT
  -- the primes of residue degree at least two contribute a bounded amount
  set C : ℝ := ∑' 𝒬 : PrimeIdeal ↥M,
    (if 2 ≤ (Ideal.under (NumberField.RingOfIntegers K) 𝒬.asIdeal).inertiaDeg' 𝒬.asIdeal
      then ((Ideal.absNorm 𝒬.asIdeal : ℝ) ^ (-(3 / 4 : ℝ))) else 0) with hC
  have hsumm : Summable (fun 𝒬 : PrimeIdeal ↥M =>
      if 2 ≤ (Ideal.under (NumberField.RingOfIntegers K) 𝒬.asIdeal).inertiaDeg' 𝒬.asIdeal
        then ((Ideal.absNorm 𝒬.asIdeal : ℝ) ^ (-(3 / 4 : ℝ))) else 0) :=
    NK.ChebotarevGeneral.summable_zetaWeight_of_inertiaDeg_ge_two (K := K) (M := ↥M)
      (by norm_num)
  -- every prime of `T` has residue degree at least two
  have hdeg : ∀ 𝒬 ∈ T,
      2 ≤ (Ideal.under (NumberField.RingOfIntegers K) 𝒬.asIdeal).inertiaDeg' 𝒬.asIdeal := by
    intro 𝒬 h𝒬
    rw [hT] at h𝒬
    have hmemS : 𝒬 ∈ S := h𝒬.1
    have hnotA : 𝒬 ∉ A := h𝒬.2
    have hfrob : IsFrobAtPrime (K := ↥M) (L := N) 𝒬 (M.fixingSubgroupEquiv ⟨σ, hσ⟩) := hmemS
    have hlies : 𝒬.asIdeal.LiesOver (Ideal.under (NumberField.RingOfIntegers K) 𝒬.asIdeal) :=
      (Ideal.liesOver_iff _ _).mpr rfl
    have hnot : ¬ IsFrobAtPrime (K := K) (L := N)
        (IsDedekindDomain.HeightOneSpectrum.under (NumberField.RingOfIntegers K) 𝒬) σ := by
      intro hcon
      refine hnotA ?_
      rw [hA]
      refine ⟨IsDedekindDomain.HeightOneSpectrum.under (NumberField.RingOfIntegers K) 𝒬,
        hcon, ?_⟩
      rwa [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
    have hres := two_le_inertiaDeg'_of_not_isFrobAtPrimeU (M := M) hσ hlies hnot hfrob
    rwa [IsDedekindDomain.HeightOneSpectrum.under_asIdeal] at hres
  -- the primes of `T` contribute at most `C`
  have h2C : ∀ s : ℝ, 1 < s → NumberField.Set.primeIdealZetaSum T s ≤ C := by
    intro s hs
    have hsumM : Summable (fun 𝒬 : PrimeIdeal ↥M =>
        (Ideal.absNorm 𝒬.asIdeal : ℝ) ^ (-s)) :=
      Commons.NumberTheory.NumberField.Set.summable_primeIdealZetaSum hs
    have hsumA : Summable (fun b : T => (Ideal.absNorm b.1.asIdeal : ℝ) ^ (-s)) :=
      hsumM.subtype _
    have hsumB : Summable (fun b : T =>
        if 2 ≤ (Ideal.under (NumberField.RingOfIntegers K) b.1.asIdeal).inertiaDeg' b.1.asIdeal
          then ((Ideal.absNorm b.1.asIdeal : ℝ) ^ (-(3 / 4 : ℝ))) else 0) := hsumm.subtype _
    rw [NumberField.Set.primeIdealZetaSum_def, hC]
    refine le_trans (Summable.tsum_le_tsum (fun b => ?_) hsumA hsumB) ?_
    · rw [if_pos (hdeg b.1 b.2)]
      refine Real.rpow_le_rpow_of_exponent_le ?_ (by linarith)
      exact_mod_cast (Nat.one_le_iff_ne_zero.mpr fun h0 =>
        b.1.ne_bot (Ideal.absNorm_eq_zero_iff.mp h0))
    · refine Summable.tsum_subtype_le _ _ (fun a => ?_) hsumm
      by_cases hc : 2 ≤ (Ideal.under (NumberField.RingOfIntegers K) a.asIdeal).inertiaDeg' a.asIdeal
      · simp only [hc, ↓reduceIte]
        exact Real.rpow_nonneg (by positivity) _
      · simp only [hc, ↓reduceIte]
        exact le_refl 0
  -- hence the partial Dirichlet series over `S` is bounded
  have hupper : ∀ s : ℝ, 1 < s → NumberField.Set.primeIdealZetaSum S s ≤
      (S ∩ A).ncard + C := by
    intro s hs
    have hsumM : Summable (fun 𝒬 : PrimeIdeal ↥M =>
        (Ideal.absNorm 𝒬.asIdeal : ℝ) ^ (-s)) :=
      Commons.NumberTheory.NumberField.Set.summable_primeIdealZetaSum hs
    have hsplit := Commons.NumberTheory.NumberField.Set.primeIdealZetaSum_union_of_disjoint
      (S := S ∩ A) (T := T) (Set.disjoint_left.mpr fun x hx hx' => by
        rw [hT] at hx'; exact hx'.2 hx.2) s
      (hsumM.subtype _) (hsumM.subtype _)
    have hunion : (S ∩ A) ∪ T = S := by
      rw [hT]
      exact Set.inter_union_sdiff S A
    rw [hunion] at hsplit
    rw [hsplit]
    have h1 : NumberField.Set.primeIdealZetaSum (S ∩ A) s ≤ ((S ∩ A).ncard : ℝ) :=
      NumberField.Set.primeIdealZetaSum_le_card_of_finite (hAfin.subset Set.inter_subset_right)
        (by linarith)
    have h2 := h2C s hs
    linarith
  -- contradiction: the series tends to `+∞` but is bounded
  obtain ⟨s, hsbig, hs1⟩ := ((htend.eventually_ge_atTop ((S ∩ A).ncard + C + 1)).and
    (self_mem_nhdsWithin : Set.Ioi (1 : ℝ) ∈ 𝓝[>] (1 : ℝ))).exists
  have hs1' : 1 < s := hs1
  have := hupper s hs1'
  linarith

end

end NK.UniverseWeakNU
