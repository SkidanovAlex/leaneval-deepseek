import Mathlib
import Submission.NK.CFTLib.normQuotientSetup
import Submission.NK.CFTLib.exists_pow_mem_TUnits_mul_unitsNorm
import Submission.NK.CFTLib.tUnits_generated_by_globalUnits
import Submission.NK.CFTLib.ker_tUnitsVal_ofFinite
import Submission.NK.CFTLib.normPrincipalPreimage_iff_expUnit
import Submission.NK.CFTLib.SSet_ofFinite_eq

/-!
# The class-group part of the norm quotient

This file proves `NK.CFTLib.exists_normQuotientClPart_surjection`: the "class-group part" of the
norm quotient `normQuotient F K = (Fˣ ∩ N_{K/F} 𝕀_K) / N_{K/F} Kˣ` has `p`-rank at most `|T|`, where
`T` is a finite set of primes of `F` which split completely in `K` and which (by `ClassCond`)
generate the `p`-part of the class group of `K`.

The mathematical content is that every `x ∈ H = Fˣ ∩ N_{K/F} 𝕀_K` has an `m`-th power (`m` coprime
to `p`) lying in the image of the `T`-units, and the `T`-units modulo the global units are generated
by at most `|T|` elements (Dirichlet's `S`-unit theorem in the form
`NK.CFTLib.tUnits_generated_by_globalUnits`).  Since `m` is invertible modulo `p`, this bounds the
`𝔽_p`-dimension of the class-group part.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open scoped NumberField RestrictedProduct IsMulCommutative
open NumberField IsDedekindDomain
open CategoryTheory TensorProduct

noncomputable section

namespace NK.CFTLib

/-! ## Two general lemmas -/

/-- **A quotient is generated modulo `p` by `|S|` elements.**  If every element of an abelian group
`A` is congruent modulo the subgroup `B` to an element of the subgroup generated by the finite set
`S`, up to an `m`-th power with `m` coprime to `p`, then the `p`-rank of `A ⧸ B` is at most
`|S|`. -/
theorem pRank_quotient_le_card_of_smul_mem {p : ℕ} [Fact p.Prime] {A : Type} [AddCommGroup A]
    (B : AddSubgroup A) (S : Finset A) (m : ℕ) (hm : Nat.Coprime m p)
    (h : ∀ x : A, ∃ y ∈ AddSubgroup.closure (S : Set A), ∃ z ∈ B, (m : ℤ) • x = y + z) :
    pRank p (A ⧸ B) ≤ S.card := by
  classical
  haveI hBn : B.Normal := AddSubgroup.Normal.mk fun n hn g => by
    rw [add_comm g n, add_assoc, add_neg_cancel, add_zero]; exact hn
  obtain ⟨a', b', hab⟩ : ∃ a' b' : ℤ, a' * (m : ℤ) + b' * (p : ℤ) = 1 := by
    refine ⟨Nat.gcdA m p, Nat.gcdB m p, ?_⟩
    have hg := Nat.gcd_eq_gcd_ab m p
    rw [hm.gcd_eq_one] at hg
    norm_num at hg
    linarith
  have hcoef : ((a' * (m : ℤ) : ℤ) : ZMod p) = 1 := by
    have h1 : ((a' * (m : ℤ) + b' * (p : ℤ) : ℤ) : ZMod p) = 1 := by
      rw [hab, Int.cast_one]
    have hp : ((p : ℤ) : ZMod p) = 0 := by
      push_cast
      exact ZMod.natCast_self p
    rw [Int.cast_add, Int.cast_mul, Int.cast_mul, hp, mul_zero, add_zero] at h1
    rw [Int.cast_mul]
    exact h1
  have hgen : ∀ x : A, (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B x) ∈
      Submodule.span (ZMod p) (Set.range fun i : S =>
        (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B (i : A))) := by
    intro x
    obtain ⟨y, hy, z, hz, hxyz⟩ := h x
    have hmul : (m : ℤ) • QuotientAddGroup.mk' B x = QuotientAddGroup.mk' B y := by
      have h1 : QuotientAddGroup.mk' B ((m : ℤ) • x)
          = QuotientAddGroup.mk' B y + QuotientAddGroup.mk' B z := by
        rw [hxyz, map_add]
      rw [map_zsmul] at h1
      rw [show QuotientAddGroup.mk' B z = 0 from
        (QuotientAddGroup.eq_zero_iff z).mpr hz, add_zero] at h1
      exact h1
    have hkey : (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B x)
        = (a' : ZMod p) • ((1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B y)) := by
      calc (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B x)
          = (((a' * (m : ℤ) : ℤ) : ZMod p)) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B x) := by
            rw [hcoef]
        _ = (a' • (m : ZMod p)) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B x) := by
            congr 1
            rw [zsmul_eq_mul, Int.cast_mul, Int.cast_natCast]
        _ = (m : ZMod p) ⊗ₜ[ℤ] (a' • QuotientAddGroup.mk' B x) := by
            rw [TensorProduct.smul_tmul]
        _ = (1 : ZMod p) ⊗ₜ[ℤ] ((m : ℤ) • (a' • QuotientAddGroup.mk' B x)) := by
            rw [show (m : ZMod p) = (m : ℤ) • (1 : ZMod p) from by
              rw [zsmul_eq_mul, mul_one, Int.cast_natCast]]
            rw [TensorProduct.smul_tmul]
        _ = (1 : ZMod p) ⊗ₜ[ℤ] (a' • ((m : ℤ) • QuotientAddGroup.mk' B x)) := by
            congr 1
            have h1 : (m : ℤ) • (a' • QuotientAddGroup.mk' B x)
                = (a' * (m : ℤ)) • QuotientAddGroup.mk' B x := by
              rw [← mul_smul, mul_comm (m : ℤ) a']
            have h2 : a' • ((m : ℤ) • QuotientAddGroup.mk' B x)
                = (a' * (m : ℤ)) • QuotientAddGroup.mk' B x := by rw [← mul_smul]
            rw [h1, h2]
        _ = (1 : ZMod p) ⊗ₜ[ℤ] (a' • (QuotientAddGroup.mk' B y)) := by rw [hmul]
        _ = (a' : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B y) := by
            rw [show (a' : ZMod p) = (a' : ℤ) • (1 : ZMod p) from by
              rw [zsmul_eq_mul, mul_one]]
            rw [TensorProduct.smul_tmul]
        _ = (a' : ZMod p) • ((1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B y)) := by
            rw [TensorProduct.tmul_eq_smul_one_tmul]
    rw [hkey]
    refine Submodule.smul_mem _ _ ?_
    let psi : A →+ TensorProduct ℤ (ZMod p) (A ⧸ B) :=
      (TensorProduct.mk ℤ (ZMod p) (A ⧸ B) (1 : ZMod p)).toAddMonoidHom.comp
        (QuotientAddGroup.mk' B)
    have hpsi : ∀ u : A, psi u = (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B u) := fun u => by
      simp [psi]
    have hle : AddSubgroup.closure (S : Set A) ≤
        (Submodule.span (ZMod p) (Set.range fun i : S =>
          (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B (i : A)))).toAddSubgroup.comap psi := by
      rw [AddSubgroup.closure_le]
      intro s hs
      change psi s ∈ Submodule.span (ZMod p) (Set.range fun i : S =>
        (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B (i : A)))
      rw [hpsi]
      exact Submodule.subset_span ⟨⟨s, hs⟩, rfl⟩
    have hy2 := hle hy
    change psi y ∈ Submodule.span (ZMod p) (Set.range fun i : S =>
      (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B (i : A))) at hy2
    rw [hpsi] at hy2
    exact hy2
  have hspan : Submodule.span (ZMod p) (Set.range fun i : S =>
        (1 : ZMod p) ⊗ₜ[ℤ] (QuotientAddGroup.mk' B (i : A))) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact Submodule.zero_mem _
    | add u v hu hv => exact Submodule.add_mem _ hu hv
    | tmul c q =>
        obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective B q
        rw [TensorProduct.tmul_eq_smul_one_tmul]
        exact Submodule.smul_mem _ c (hgen x)
  rw [pRank, ← Fintype.card_coe S]
  exact finrank_le_of_span_eq_top hspan

/-- **A subgroup is generated by its kernel part plus at most `|ι|` further elements, inside
itself.**  Let `A ≤ B ≤ G` be subgroups of a commutative group, and `φ : Additive B →+ ℤ^ι` a
homomorphism whose kernel is exactly `A` (viewed inside `G`).  Then `B` is generated, inside `B`, by
`A` and at most `|ι|` elements of `B`.

This is `NK.CFTLib.exists_finset_closure_le_of_ker` with the extra information that the generators
can be found *inside* `B` (in the original the generators are elements of `G`). -/
theorem exists_finset_closure_le_of_ker_subset {G : Type*} [CommGroup G] {A B : Subgroup G}
    (hAB : A ≤ B) {ι : Type*} [Fintype ι] [DecidableEq ι] (φ : Additive B →+ (ι → ℤ))
    (hker : ∀ x : Additive B, φ x = 0 ↔ ((Additive.toMul x : B) : G) ∈ A) :
    ∃ s : Finset B, s.card ≤ Fintype.card ι ∧
      ∀ y : B, y ∈ Subgroup.closure ((A.subgroupOf B : Set B) ∪ (s : Set B)) := by
  classical
  obtain ⟨m, snf⟩ :=
    Submodule.smithNormalForm (Pi.basisFun ℤ ι) (LinearMap.range φ.toIntLinearMap)
  have hm : m ≤ Fintype.card ι := by
    simpa using Fintype.card_le_of_embedding snf.f
  have hex : ∀ i : Fin m, ∃ y : B, φ (Additive.ofMul y) =
      ((snf.bN i : LinearMap.range φ.toIntLinearMap) : ι → ℤ) := by
    intro i
    obtain ⟨y, hy⟩ := LinearMap.mem_range.mp ((snf.bN i).2)
    exact ⟨Additive.toMul y, by rw [ofMul_toMul]; exact hy⟩
  choose a ha using hex
  refine ⟨Finset.univ.image a, ?_, ?_⟩
  · calc (Finset.univ.image a).card ≤ (Finset.univ : Finset (Fin m)).card := Finset.card_image_le
      _ = m := by simp
      _ ≤ Fintype.card ι := hm
  · intro x
    set xb : B := x with hxb
    have hz : φ (Additive.ofMul xb) ∈ LinearMap.range φ.toIntLinearMap :=
      LinearMap.mem_range.mpr ⟨Additive.ofMul xb, rfl⟩
    set z : LinearMap.range φ.toIntLinearMap := ⟨φ (Additive.ofMul xb), hz⟩ with hzdef
    set c : Fin m → ℤ := fun i => snf.bN.repr z i with hc
    set y : B := ∏ i : Fin m, (a i) ^ (c i) with hydef
    have hy_mem : y ∈ Subgroup.closure
        ((Finset.univ.image a : Finset B) : Set B) := by
      have heq : y = ∏ i : Fin m, (a i) ^ (c i) := by rw [hydef]
      rw [heq]
      refine Subgroup.prod_mem _ (fun i _ => ?_)
      exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by simp)) _
    have hsum : (∑ i : Fin m, c i • ((snf.bN i : LinearMap.range φ.toIntLinearMap) : ι → ℤ))
        = φ (Additive.ofMul xb) := by
      have hbasis : (∑ i : Fin m, c i • snf.bN i
          : LinearMap.range φ.toIntLinearMap) = z := Module.Basis.sum_repr snf.bN z
      have hcoe := congrArg
        (fun w : LinearMap.range φ.toIntLinearMap => (w : ι → ℤ)) hbasis
      simp only [Submodule.coe_sum, Submodule.coe_smul] at hcoe
      exact hcoe
    have h1 : Additive.ofMul y = ∑ i : Fin m, c i • Additive.ofMul (a i) := by
      have := ofMul_prod (Finset.univ : Finset (Fin m)) (fun i => (a i) ^ (c i))
      simpa [hydef] using this
    have hφy : φ (Additive.ofMul y) = φ (Additive.ofMul xb) := by
      rw [h1, map_sum]
      simp only [map_zsmul, ha]
      exact hsum
    have hzero : φ (Additive.ofMul (xb * y⁻¹)) = 0 := by
      have hsub : φ (Additive.ofMul xb - Additive.ofMul y) = 0 := by
        rw [map_sub, hφy, sub_self]
      rwa [show Additive.ofMul (xb * y⁻¹) = Additive.ofMul xb - Additive.ofMul y from by
        rw [ofMul_mul, ofMul_inv]; abel]
    have hA : ((xb * y⁻¹ : B) : G) ∈ A := (hker (Additive.ofMul (xb * y⁻¹))).mp hzero
    have ha0 : xb * y⁻¹ ∈ A.subgroupOf B := by
      rw [Subgroup.mem_subgroupOf]; exact hA
    have hx_eq : xb = (xb * y⁻¹) * y := by group
    rw [hx_eq]
    exact mul_mem (Subgroup.subset_closure (Or.inl ha0))
      (Subgroup.closure_mono Set.subset_union_right hy_mem)

theorem exists_normQuotientClPart_surjection (F K : Type) [Field F] [NumberField F] [Field K]
    [NumberField K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K] (p : ℕ) [Fact p.Prime]
    (hG : IsPGroup p (K ≃ₐ[F] K))
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F)))
    (hunr : _root_.CFTLib.IsUnramified F K) (hT : _root_.CFTLib.SplitsAt F K T)
    (hclass : _root_.CFTLib.ClassCond F K p T) :
    ∃ (Q : Type) (_ : AddCommGroup Q) (f : NK.CFTLib.normQuotient F K →+ Q),
      Function.Surjective f ∧ f.ker = NK.CFTLib.normQuotientUnitImage F K ∧
        NK.CFTLib.pRank p Q ≤ T.card := by
  classical
  -- The finite set of places of `F` lying above `T`.
  let T' : Set (NK.GlobalCFT.Place F) :=
    {w | ∃ q ∈ T, w = NK.GlobalCFT.Place.ofFinite q}
  have hSSet : NK.GlobalCFTdeep.SSet T' = (T : Set _) := by
    show NK.GlobalCFTdeep.SSet {w : NK.GlobalCFT.Place F |
      ∃ q ∈ T, w = NK.GlobalCFT.Place.ofFinite q} = (T : Set _)
    exact SSet_ofFinite_eq F T
  haveI : Fintype (NK.GlobalCFTdeep.SSet T') :=
    Fintype.ofEquiv _ (Set.equivOfEq hSSet).symm
  have hcard : Fintype.card (NK.GlobalCFTdeep.SSet T') = T.card := by
    rw [← Fintype.card_congr (Set.equivOfEq hSSet).symm]
    exact Fintype.card_coe T
  -- Units of `𝓞 F` lie in `H = normPrincipalPreimage F K`.
  have hglobH : NK.GlobalCFTdeep.globalUnits F ≤ normPrincipalPreimage F K := by
    intro a ha
    rw [normPrincipalPreimage_iff_expUnit F K hunr]
    intro v
    have hzero : NK.GlobalCFTdeep.expUnit v a = 0 := by
      obtain ⟨u, rfl⟩ := ha
      rw [NK.GlobalCFTdeep.expUnit_eq_zero_iff]
      rw [show ((Units.map (algebraMap (𝓞 F) F).toMonoidHom u : Fˣ) : F) =
        algebraMap (𝓞 F) F (u : 𝓞 F) from rfl]
      rw [HeightOneSpectrum.valuation_eq_one_iff_notMem]
      intro hmem
      exact v.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem v.asIdeal hmem (Units.isUnit u))
    rw [hzero]
    exact dvd_zero _
  -- The subgroup of `T`-units inside `H`, and the valuation map on it.
  let Bgrp : Subgroup Fˣ := normPrincipalPreimage F K ⊓ NK.GlobalCFTdeep.TUnits T'
  let φ : Additive ↥Bgrp →+ (NK.GlobalCFTdeep.SSet T' → ℤ) :=
    (NK.GlobalCFTdeep.tUnitsVal T').toAddMonoidHom.comp
      (MonoidHom.toAdditive (Subgroup.inclusion inf_le_right))
  have hkerφ : ∀ x : Additive ↥Bgrp, φ x = 0 ↔
      ((Additive.toMul x : ↥Bgrp) : Fˣ) ∈ NK.GlobalCFTdeep.globalUnits F := by
    intro x
    rw [show φ x = NK.GlobalCFTdeep.tUnitsVal T'
        (Additive.ofMul (Subgroup.inclusion inf_le_right (Additive.toMul x))) from rfl]
    rw [NK.GlobalCFTdeep.ker_tUnitsVal_apply]
    rfl
  have hglob_le : NK.GlobalCFTdeep.globalUnits F ≤ Bgrp := by
    intro a ha
    exact ⟨hglobH ha, NK.GlobalCFTdeep.globalUnits_le_TUnits T' ha⟩
  obtain ⟨s, hsc, hgen⟩ := exists_finset_closure_le_of_ker_subset hglob_le φ hkerφ
  -- The `m`-th power statement.
  obtain ⟨m, hmcop, hmain⟩ := exists_pow_mem_TUnits_mul_unitsNorm F K p hG T hunr hT hclass
  -- The extra generators, as elements of `H`.
  let iota : ↥Bgrp →* ↥(normPrincipalPreimage F K) :=
    { toFun := fun b => ⟨(b : Fˣ), b.2.1⟩
      map_one' := rfl
      map_mul' := fun a b => rfl }
  let S : Finset (Additive ↥(normPrincipalPreimage F K)) := (s.image iota).image Additive.ofMul
  have hScard : S.card ≤ T.card := by
    calc S.card ≤ (s.image iota).card := Finset.card_image_le
      _ ≤ s.card := Finset.card_image_le
      _ ≤ Fintype.card (NK.GlobalCFTdeep.SSet T') := hsc
      _ = T.card := hcard
  -- The `p`-rank bound for the class-group part.
  have hbound : pRank p (Additive ↥(normPrincipalPreimage F K) ⧸
      ((normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)).toAddSubgroup) ≤
      T.card := by
    refine le_trans (pRank_quotient_le_card_of_smul_mem _ S m hmcop ?_) hScard
    intro x
    obtain ⟨y, hyH, hyT, z, hzN, heq⟩ := hmain (x.toMul : Fˣ) x.toMul.2
    have hzH : z ∈ normPrincipalPreimage F K :=
      unitsNormSubgroup_le_normPrincipalPreimage F K hzN
    set yb : ↥Bgrp := ⟨y, hyH, hyT⟩ with hyb
    have hyb_mem := hgen yb
    rw [Subgroup.closure_union, Subgroup.closure_eq] at hyb_mem
    obtain ⟨a, ha, t, ht, hat⟩ := Subgroup.mem_sup.mp hyb_mem
    have haGlob : (a : Fˣ) ∈ NK.GlobalCFTdeep.globalUnits F := by
      have h := ha
      rw [Subgroup.mem_subgroupOf] at h
      exact h
    have haH : (a : Fˣ) ∈ normPrincipalPreimage F K := hglobH haGlob
    have htH : (t : Fˣ) ∈ normPrincipalPreimage F K := t.2.1
    have hy_eq : (⟨y, hyH⟩ : ↥(normPrincipalPreimage F K)) =
        (⟨(a : Fˣ), haH⟩ : ↥(normPrincipalPreimage F K)) *
          ⟨(t : Fˣ), htH⟩ := by
      apply Subtype.ext
      exact (congrArg (fun w : ↥Bgrp => (w : Fˣ)) hat).symm
    have hzmemB : Additive.ofMul (⟨z, hzH⟩ : ↥(normPrincipalPreimage F K)) ∈
        ((normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)).toAddSubgroup := by
      show Additive.toMul (Additive.ofMul (⟨z, hzH⟩ : ↥(normPrincipalPreimage F K))) ∈
        (normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)
      rw [Subgroup.mem_subgroupOf]
      show z ∈ unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)
      exact (le_sup_left : unitsNormSubgroup F K ≤
        unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)) hzN
    have hamemB : Additive.ofMul (⟨(a : Fˣ), haH⟩ : ↥(normPrincipalPreimage F K)) ∈
        ((normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)).toAddSubgroup := by
      show Additive.toMul (Additive.ofMul (⟨(a : Fˣ), haH⟩ : ↥(normPrincipalPreimage F K))) ∈
        (normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)
      rw [Subgroup.mem_subgroupOf]
      show (a : Fˣ) ∈ unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)
      exact (le_sup_right : unitsInF F ⊓ normPrincipalPreimage F K ≤
        unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)) ⟨haGlob, haH⟩
    have hts : Additive.ofMul (iota t) ∈
        AddSubgroup.closure (S : Set (Additive ↥(normPrincipalPreimage F K))) := by
      have key : ∀ u ∈ Subgroup.closure (s : Set ↥Bgrp),
          Additive.ofMul (iota u) ∈
            AddSubgroup.closure (S : Set (Additive ↥(normPrincipalPreimage F K))) := by
        intro u hu
        refine Subgroup.closure_induction
          (p := fun u _ => Additive.ofMul (iota u) ∈
            AddSubgroup.closure (S : Set (Additive ↥(normPrincipalPreimage F K))))
          ?_ ?_ ?_ ?_ hu
        · intro w hw
          exact AddSubgroup.subset_closure (Finset.mem_image.mpr ⟨iota w,
            Finset.mem_image.mpr ⟨w, hw, rfl⟩, rfl⟩)
        · simpa using AddSubgroup.zero_mem
            (AddSubgroup.closure (S : Set (Additive ↥(normPrincipalPreimage F K))))
        · intro u₁ u₂ hu₁ hu₂ ihu₁ ihu₂
          rw [map_mul, ofMul_mul]
          exact AddSubgroup.add_mem _ ihu₁ ihu₂
        · intro u₁ hu₁ ihu₁
          rw [map_inv, ofMul_inv]
          exact AddSubgroup.neg_mem _ ihu₁
      exact key t ht
    refine ⟨Additive.ofMul (iota t), hts,
      Additive.ofMul (⟨(a : Fˣ), haH⟩ : ↥(normPrincipalPreimage F K)) +
        Additive.ofMul (⟨z, hzH⟩ : ↥(normPrincipalPreimage F K)),
      AddSubgroup.add_mem _ hamemB hzmemB, ?_⟩
    have hxy : (m : ℤ) • x = Additive.ofMul ((x.toMul : ↥(normPrincipalPreimage F K)) ^ m) := by
      have h1 : m • x = m • Additive.ofMul (x.toMul : ↥(normPrincipalPreimage F K)) := by
        rw [ofMul_toMul]
      rw [show (m : ℤ) • x = m • x from by simp, h1, ← ofMul_pow]
    have hstep1 : ((x.toMul : ↥(normPrincipalPreimage F K)) ^ m) =
        (⟨y, hyH⟩ : ↥(normPrincipalPreimage F K)) * ⟨z, hzH⟩ := by
      apply Subtype.ext
      exact heq
    have hstep2 : Additive.ofMul (iota t) =
        Additive.ofMul (⟨(t : Fˣ), htH⟩ : ↥(normPrincipalPreimage F K)) := rfl
    rw [hxy, hstep1, ofMul_mul, hy_eq, ofMul_mul, hstep2]
    abel
  -- Assemble: the natural surjection onto `A ⧸ M₀`.
  let A : Type _ := Additive ↥(normPrincipalPreimage F K)
  let N₀ : AddSubgroup A :=
    ((unitsNormSubgroup F K).subgroupOf (normPrincipalPreimage F K)).toAddSubgroup
  let M₀ : AddSubgroup A :=
    ((normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)).toAddSubgroup
  have hNleM : N₀ ≤ M₀ := by
    intro x hx
    have hx1 : Additive.toMul x ∈
        (unitsNormSubgroup F K).subgroupOf (normPrincipalPreimage F K) := hx
    rw [Subgroup.mem_subgroupOf] at hx1
    show Additive.toMul x ∈ (normUnitPreimage F K).subgroupOf (normPrincipalPreimage F K)
    rw [Subgroup.mem_subgroupOf]
    show ((Additive.toMul x : ↥(normPrincipalPreimage F K)) : Fˣ) ∈
      unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)
    exact (le_sup_left : unitsNormSubgroup F K ≤
      unitsNormSubgroup F K ⊔ (unitsInF F ⊓ normPrincipalPreimage F K)) hx1
  let e : (A ⧸ N₀) ⧸ M₀.map (QuotientAddGroup.mk' N₀) ≃+ A ⧸ M₀ :=
    QuotientAddGroup.quotientQuotientEquivQuotient N₀ M₀ hNleM
  let f : NK.CFTLib.normQuotient F K →+ A ⧸ M₀ :=
    e.toAddMonoidHom.comp (QuotientAddGroup.mk' (M₀.map (QuotientAddGroup.mk' N₀)))
  refine ⟨A ⧸ M₀, inferInstance, f, ?_, ?_, ?_⟩
  · exact e.surjective.comp (QuotientAddGroup.mk'_surjective _)
  · have h1 : f.ker = (QuotientAddGroup.mk' (M₀.map (QuotientAddGroup.mk' N₀))).ker :=
      AddMonoidHom.ker_comp_of_injective _ _ e.injective
    rw [h1, QuotientAddGroup.ker_mk']
    rfl
  · show pRank p (A ⧸ M₀) ≤ T.card
    exact hbound

end NK.CFTLib
