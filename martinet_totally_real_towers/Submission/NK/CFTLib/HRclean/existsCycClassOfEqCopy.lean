namespace NK.CFTLib.HRclean.Final

open NK.CFTLib.IdeleHasse.Descent NK.GlobalCFT

open NK.GlobalCFT

/-- **The cyclic class representative of a class in `H²(Gal(M/K), Mˣ)`.**  For a finite Galois
extension `M/K` with `Gal(M/K)` cyclic generated by `g`, every class is the cyclic class of a global
element `b ∈ Kˣ` (Galois descent for the invariants together with the periodicity surjectivity
`exists_eq_cycClass`). -/
theorem exists_cycClassOf_eq {K M : Type} [Field K] [NumberField K] [Field M] [NumberField M]
    [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (g : M ≃ₐ[K] M) (hg : ∀ σ : M ≃ₐ[K] M, σ ∈ Subgroup.zpowers g)
    (β : groupCohomology (NK.HassePrinciple.unitsRep K M) 2) :
    ∃ b : Kˣ, NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := M) g hg b = β := by
  obtain ⟨a, ha, hcls⟩ := NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass
    (NK.HassePrinciple.unitsRep K M) g hg β
  -- the invariant element of `Mˣ` fixed by the Galois action
  set a' : Mˣ := Additive.toMul a with ha'
  have hfix : ∀ σ : M ≃ₐ[K] M, Units.map σ.toMonoidHom a' = a' := by
    intro σ
    have h1 := ha σ
    have h2 : (NK.HassePrinciple.unitsRep K M).ρ σ a
        = Additive.ofMul (Units.map σ.toMonoidHom (Additive.toMul a)) := rfl
    rw [h2, ← ha'] at h1
    exact Additive.ofMul.injective h1
  have hfix' : ∀ σ : M ≃ₐ[K] M, σ (a' : M) = (a' : M) := by
    intro σ
    have h1 := hfix σ
    have h2 := congrArg (fun u : Mˣ => (u : M)) h1
    rw [Units.coe_map] at h2
    exact h2
  obtain ⟨k, hk⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := K) (E := M)
    (a' : M)).mpr hfix'
  have hk0 : k ≠ 0 := by
    intro h0
    have h1 : (a' : M) = 0 := by rw [← hk, h0]; simp
    exact a'.ne_zero h1
  refine ⟨Units.mk0 k hk0, ?_⟩
  have h3 : Units.map (algebraMap K M).toMonoidHom (Units.mk0 k hk0) = a' := by
    apply Units.ext
    rw [Units.coe_map]
    simpa using hk
  have hunits : unitsImage (K := K) (F := M) (Units.mk0 k hk0) = a := by
    rw [NK.CFTLib.IdeleHasse.Descent.unitsImage, h3, ha']
    rfl
  rw [NK.CFTLib.IdeleHasse.Descent.cycClassOf]
  subst hunits
  exact hcls

end NK.CFTLib.HRclean.Final

namespace NK.CFTLib.HRclean.Final

open NK.GlobalCFT

/-- **The elementary final step of the transfer**: if the cyclic class of `x` at the level `L/K`
vanishes (equivalently: `x` is a global norm from `L`), then `x` is a local norm at every place of
`K` — in particular at `v₀`.

Proof: the localisation dictionary (`localNormSubgroup_iff_cycClass_finite` /
`..._infinite`) turns the vanishing of the localisation of the cyclic class at any place `w` of `L`
above `v₀` into membership of `localImageAt v₀ x` in the local norm subgroup; the localisation of
the zero class is zero. -/
theorem auxDescentTransfer_of_cycClassOf_eq_zero {K L : Type} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (hcycL : IsCyclic (L ≃ₐ[K] L)) (x : Kˣ) (v₀ : NK.GlobalCFT.Place K)
    (hclass : ∀ (g : L ≃ₐ[K] L) (hg : ∀ σ : L ≃ₐ[K] L, σ ∈ Subgroup.zpowers g),
      NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := L) g hg x = 0) :
    NK.CFTLib.IdeleHasse.localImageAt v₀ x ∈
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v₀ := by
  obtain ⟨g, hg⟩ := hcycL.exists_generator
  obtain ⟨w, hw⟩ := NK.GlobalCFTdeep.NormIndex.exists_place_liesOver (K := K) (L := L) v₀
  have h0 : (NK.HassePrinciple.locUnits K L w).hom
      (NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := L) g hg x) = 0 := by
    rw [hclass g hg]
    exact map_zero _
  rcases hw with ⟨w', v', rfl, rfl, hw'⟩ | ⟨q, Q, rfl, rfl, hq⟩
  · exact (NK.CFTLib.HRclean.Dict.localNormSubgroup_iff_cycClass_infinite
      (K := K) (F := L) g hg v' w' hw' x).mp h0
  · exact (NK.CFTLib.IdeleHasse.Descent.localNormSubgroup_iff_cycClass_finite
      (K := K) (F := L) g hg Q q hq x).mp h0

end NK.CFTLib.HRclean.Final
