import Mathlib
import Submission.NK.CFTLib.roquetteDefs
import Submission.NK.CFTLib.roquette_plan
import Submission.NK.GlobalCFTdeep.Herbrand.TUnitsRank
import Submission.NK.GlobalCFTdeep.Herbrand.ker_tUnitsVal
import Submission.NK.GlobalCFTdeep.Herbrand.exists_expUnit_eq_single
import Submission.NK.GlobalCFTdeep.Herbrand.finrank_tUnits
import Submission.NK.CFTLib.ker_tUnitsVal_ofFinite
import Submission.NK.CFTLib.SSet_ofFinite_eq

/-!
# The `T`-units are generated by the global units and at most `|T|` further elements

For a number field `F` and a finite set `T` of finite places, the group of `T`-units
`TUnits T ⊆ Fˣ` (the units whose valuation is trivial outside `T`) is generated by the global
units `(𝓞 F)ˣ` together with at most `|T|` further elements.

The mathematics is the standard rank computation for `S`-units: the valuation map

`tUnitsVal T : Additive (TUnits T) →ₗ[ℤ] (SSet T → ℤ)`

has kernel exactly the global units, and the image is a subgroup of the free `ℤ`-module
`ℤ^{SSet T}`, hence free of rank at most `|SSet T| = |T|` (Smith normal form).  Picking a
preimage of each basis element of the image gives the required generators.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.style.haveILetI false

open scoped NumberField
open IsDedekindDomain

noncomputable section

namespace NK.CFTLib

open NK.GlobalCFT

/-- **A subgroup of `ℤ^ι` has at most `|ι|` generators, in kernel form.**  Let `B` be a
subgroup of a commutative group `G`, `A ≤ B` a subgroup and `φ : B → ℤ^ι` a homomorphism whose
kernel is exactly `A`.  Then `B` is generated by `A` together with at most `|ι|` further
elements. -/
theorem exists_finset_closure_le_of_ker {G : Type*} [CommGroup G] {A B : Subgroup G}
    {ι : Type*} [Fintype ι] [DecidableEq ι] (φ : Additive B →+ (ι → ℤ))
    (hker : ∀ x : Additive B, φ x = 0 ↔ ((Additive.toMul x : B) : G) ∈ A) :
    ∃ s : Finset G, s.card ≤ Fintype.card ι ∧
      B ≤ Subgroup.closure ((A : Set G) ∪ (s : Set G)) := by
  classical
  -- The image of `φ` is a submodule of the free `ℤ`-module `ℤ^ι`; Smith normal form writes it
  -- as the image of a basis indexed by `Fin m` with `m ≤ |ι|`.
  obtain ⟨m, snf⟩ :=
    Submodule.smithNormalForm (Pi.basisFun ℤ ι) (LinearMap.range φ.toIntLinearMap)
  have hm : m ≤ Fintype.card ι := by
    simpa using Fintype.card_le_of_embedding snf.f
  -- Lift each basis vector of the image to an element of `B`.
  have hex : ∀ i : Fin m, ∃ y : B, φ (Additive.ofMul y) =
      ((snf.bN i : LinearMap.range φ.toIntLinearMap) : ι → ℤ) := by
    intro i
    obtain ⟨y, hy⟩ := LinearMap.mem_range.mp ((snf.bN i).2)
    exact ⟨Additive.toMul y, by rw [ofMul_toMul]; exact hy⟩
  choose a ha using hex
  set s : Finset G := Finset.univ.image (fun i : Fin m => ((a i : B) : G)) with hs
  refine ⟨s, ?_, ?_⟩
  · rw [hs]
    calc (Finset.univ.image (fun i : Fin m => ((a i : B) : G))).card
        ≤ (Finset.univ : Finset (Fin m)).card := Finset.card_image_le
      _ = m := by simp
      _ ≤ Fintype.card ι := hm
  · intro x hx
    set xb : B := ⟨x, hx⟩ with hxb
    have hz : φ (Additive.ofMul xb) ∈ LinearMap.range φ.toIntLinearMap :=
      LinearMap.mem_range.mpr ⟨Additive.ofMul xb, rfl⟩
    set z : LinearMap.range φ.toIntLinearMap := ⟨φ (Additive.ofMul xb), hz⟩ with hzdef
    set c : Fin m → ℤ := fun i => snf.bN.repr z i with hc
    set y : B := ∏ i : Fin m, (a i) ^ (c i) with hydef
    have hy_mem : (y : G) ∈ Subgroup.closure ((A : Set G) ∪ (s : Set G)) := by
      have heq : (y : G) = ∏ i : Fin m, (((a i : B) : G)) ^ (c i) := by
        rw [hydef]; simp
      rw [heq]
      refine Subgroup.prod_mem _ (fun i _ => ?_)
      exact Subgroup.zpow_mem _ (Subgroup.subset_closure (by rw [hs]; simp)) _
    -- The valuation vector of `y` is that of `x`.
    have hsum : (∑ i : Fin m, c i • ((snf.bN i : LinearMap.range φ.toIntLinearMap) : ι → ℤ))
        = φ (Additive.ofMul xb) := by
      have hbasis : (∑ i : Fin m, c i • snf.bN i
          : LinearMap.range φ.toIntLinearMap) = z := Module.Basis.sum_repr snf.bN z
      have hcoe := congrArg
        (fun w : LinearMap.range φ.toIntLinearMap => (w : ι → ℤ)) hbasis
      simp only [Submodule.coe_sum, Submodule.coe_smul] at hcoe
      exact hcoe
    have h1 : Additive.ofMul y = ∑ i : Fin m, c i • Additive.ofMul (a i) := by
      have := ofMul_prod (Finset.univ : Finset (Fin m)) (fun i => (a i) ^ (c i))
      simpa [hydef] using this
    have hφy : φ (Additive.ofMul y) = φ (Additive.ofMul xb) := by
      rw [h1, map_sum]
      simp only [map_zsmul, ha]
      exact hsum
    have hzero : φ (Additive.ofMul (xb * y⁻¹)) = 0 := by
      have hsub : φ (Additive.ofMul xb - Additive.ofMul y) = 0 := by
        rw [map_sub, hφy, sub_self]
      rwa [show Additive.ofMul (xb * y⁻¹) = Additive.ofMul xb - Additive.ofMul y from by
        rw [ofMul_mul, ofMul_inv]; abel]
    have hA : (x * (y : G)⁻¹) ∈ A := by
      have := (hker (Additive.ofMul (xb * y⁻¹))).mp hzero
      simpa using this
    have hx_eq : x = (x * (y : G)⁻¹) * (y : G) := by group
    rw [hx_eq]
    exact mul_mem (Subgroup.subset_closure (Or.inl hA)) hy_mem

/-- **The `T`-units are generated by the global units and at most `|T|` further elements.** -/
theorem tUnits_generated_by_globalUnits (F : Type) [Field F] [NumberField F]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))) :
    ∃ s : Finset Fˣ, s.card ≤ T.card ∧
      NK.GlobalCFTdeep.TUnits {w : NK.GlobalCFT.Place F | ∃ q ∈ T, w = NK.GlobalCFT.Place.ofFinite q} ≤
        Subgroup.closure (NK.GlobalCFTdeep.globalUnits F ∪ (s : Set Fˣ)) := by
  classical
  let T' : Set (NK.GlobalCFT.Place F) := {w | ∃ q ∈ T, w = NK.GlobalCFT.Place.ofFinite q}
  have hSSet : NK.GlobalCFTdeep.SSet T' = (T : Set _) := SSet_ofFinite_eq F T
  haveI : Fintype (NK.GlobalCFTdeep.SSet T') :=
    Fintype.ofEquiv _ (Set.equivOfEq hSSet).symm
  have hcard : Fintype.card (NK.GlobalCFTdeep.SSet T') = T.card := by
    rw [← Fintype.card_congr (Set.equivOfEq hSSet).symm]
    exact Fintype.card_coe T
  obtain ⟨s, hsc, hle⟩ := exists_finset_closure_le_of_ker (A := NK.GlobalCFTdeep.globalUnits F)
    (B := NK.GlobalCFTdeep.TUnits T')
    (NK.GlobalCFTdeep.tUnitsVal T').toAddMonoidHom (ker_tUnitsVal_ofFinite F T)
  exact ⟨s, by rw [← hcard]; exact hsc, hle⟩

end NK.CFTLib
