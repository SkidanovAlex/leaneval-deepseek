/-!
# The reciprocity law at the trivial modulus for an extension unramified at the finite primes

## The statement

For a finite Galois extension `L/K` of number fields which is unramified at every finite prime
(`differentIdeal (𝓞 K) (𝓞 L) = ⊤`) and an abelian reciprocity law
`NK.CFTLib.ArtinReciprocityIdeal` (the *ideal-theoretic* Artin reciprocity law at *some*
modulus; Lang, *Algebraic Number Theory*, X §1–2), the target theorem of this file is

`NK.CFTLib.artinKillsPrincipal K L 1`,

i.e. the Artin symbol of every principal ideal with a *totally positive* generator is trivial.

## What is proved here, and what is reduced

* `ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu`, `isUnramified_of_differentIdeal_eq_top_iiu`:
  the triviality of the relative different is exactly unramifiedness at every finite prime, in the
  form consumed by the reciprocity law.

* `realPlace_pos_of_forall_ringHom_pos_iiu`: total positivity at the real places, read in the
  completions (`NK.CFTLib.ArtinReciprocityIdeal.CongrOne`'s positivity condition), from the
  `∀ φ : K →+* ℝ, 0 < φ x` form used by `artinKillsPrincipal`.

* `artinKillsPrincipal_one_of_killsPrincipalRay_iiu`: **the reduction of the target theorem to the
  single statement that the Artin symbol kills the ray `P(1)`**
  (`NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1`, which at the modulus `1` is the subgroup
  generated by the principal ideals `(a)` with `a` totally positive: the congruence condition of
  `CongrOne` is vacuous because `(1 : 𝓞 K) ∉ 𝔭.asIdeal` for a height-one prime `𝔭`).  The
  reduction is the dictionary
  `NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_span_eq_artinSym_spanSingleton` between the
  ideal-theoretic and fractional-ideal Artin symbols (applied at `m = 1`, where its ramification
  hypothesis is vacuous and its congruence hypothesis automatic), together with
  `NK.CFTLib.frobAtPrime_prod_irrel` (independence of the Frobenius product from the choices).

## The remaining input (the conductor theorem for unramified extensions)

The hypothesis of that reduction, `∀ A ∈ principalRay K 1, artinSym hcomm A = 1`, is the statement
that the *finite part of the conductor* of `L/K` is `1` — the Frobenius normalisation of the
reciprocity law at the primes dividing the modulus, in the situation where those primes are
unramified.  It is *not* a formal consequence of the reciprocity law at the modulus `m` supplied
by `hARL`: that law constrains `frobAtPrime 𝔮` only for `𝔮 ∤ (m)`, whereas the ray `P(1)`
contains principal ideals whose support meets `(m)`.  Classically it is proved by the conductor
theorem (Neukirch, *Algebraic Number Theory*, V.6.1; Lang, X §2 Theorem 2, via Artin's lemma and
the transfer), or equivalently by Hilbert reciprocity (the local–global compatibility of the
Artin map).

The statement is isolated as `artinSym_eq_one_of_mem_principalRay_one_of_isUnramified` (and its
cyclic form `..._of_isUnramified_cyclic`); once either lands, the proof of the target theorem is
the one line at the end of this file.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors IsMulCommutative
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.Existence

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- The product over a `Finset` is the product of the list of its elements.  (Recorded at top
level, where the only instance in scope is the given `CommMonoid`, so that it can be rewritten
with even when further instances of a product structure are in scope at the use site.) -/
private lemma list_prod_map_eq_finset_prod_iiu {α β : Type} [CommMonoid β] (t : Finset α)
    (f : α → β) : (t.toList.map f).prod = ∏ x ∈ t, f x := by
  rw [← Multiset.prod_coe, ← Multiset.map_coe, Finset.coe_toList, Finset.prod_eq_multiset_prod]

/-! ## Unramifiedness from the triviality of the relative different -/

/-- **`differentIdeal = ⊤` makes every ramification index `1`.** -/
lemma ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu
    (hunr : differentIdeal (𝓞 K) (𝓞 L) = ⊤) (𝔭 : HeightOneSpectrum (𝓞 K)) :
    Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1 := by
  classical
  letI hMSA : MulSemiringAction (Gal(L/K)) (𝓞 L) :=
    IsIntegralClosure.MulSemiringAction (𝓞 K) K L (𝓞 L)
  haveI hGG : IsGaloisGroup (Gal(L/K)) (𝓞 K) (𝓞 L) :=
    IsGaloisGroup.of_isFractionRing (Gal(L/K)) (𝓞 K) (𝓞 L) K L
  obtain ⟨Q, hQ⟩ := NK.Chebotarev.exists_primeIdeal_liesOver (K := K) (L := L) 𝔭
  haveI : Q.asIdeal.IsPrime := Q.isPrime
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) 𝔭.asIdeal Q.asIdeal
    (Gal(L/K))]
  rw [← Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal
    (E := K) (K := L) Q.asIdeal Q.isPrime]
  rw [Ideal.dvd_iff_le]
  intro hle
  exact Q.isPrime.ne_top (top_le_iff.mp (hunr ▸ hle))

/-- **Unramifiedness in the form used by the reciprocity law.** -/
lemma isUnramified_of_differentIdeal_eq_top_iiu
    (hunr : differentIdeal (𝓞 K) (𝓞 L) = ⊤) (p : NK.Chebotarev.PrimeIdeal K) :
    NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p := by
  intro P hP
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.LiesOver p.asIdeal := hP
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal P.asIdeal
    (Gal(L/K))]
  exact ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p

/-- The element `1` of the ring of integers lies in no prime ideal. -/
lemma natCast_one_notMem_primeIdeal_iiu (𝔭 : HeightOneSpectrum (𝓞 K)) :
    ((1 : ℕ) : 𝓞 K) ∉ 𝔭.asIdeal := by
  intro h
  exact 𝔭.isPrime.ne_top (Ideal.eq_top_iff_one _ |>.mpr (by simpa using h))

/-- **Total positivity read in the completions at the real places**, from the `K →+* ℝ` form.
The composition `K → K_w → ℝ` of the algebra map with the identification `K_w ≅ ℝ` at the real
place `w` is a ring homomorphism `K →+* ℝ`; applying the hypothesis to it gives the assertion. -/
lemma realPlace_pos_of_forall_ringHom_pos_iiu {x : K} (h : ∀ φ : K →+* ℝ, 0 < φ x) :
    ∀ (w : InfinitePlace K) (hw : w.IsReal),
      0 < (InfinitePlace.Completion.ringEquivRealOfIsReal hw) (algebraMap K w.Completion x) := by
  intro w hw
  have h' : 0 < ((InfinitePlace.Completion.ringEquivRealOfIsReal hw).toRingHom.comp
      (algebraMap K w.Completion)) x :=
    h ((InfinitePlace.Completion.ringEquivRealOfIsReal hw).toRingHom.comp
      (algebraMap K w.Completion))
  simpa using h'

/-- A finite product of prime powers is nonzero. -/
lemma prod_primeIdeal_pow_ne_bot_iiu (s : Finset (NK.Chebotarev.PrimeIdeal K))
    (e : NK.Chebotarev.PrimeIdeal K → ℕ) : (∏ p ∈ s, p.asIdeal ^ e p) ≠ ⊥ := by
  classical
  refine Finset.prod_ne_zero_iff.mpr (fun p _ => ?_)
  rcases Nat.eq_zero_or_pos (e p) with h | h
  · rw [h, pow_zero, Ideal.one_eq_top]
    exact top_ne_bot
  · exact fun hc => p.ne_bot ((Ideal.pow_eq_bot h.ne').mp hc)

/-! ## Restriction of the Frobenius to an intermediate field

If `K ⊆ M ⊆ L` with `M/K` normal and `𝔭` unramified in `L/K`, then the restriction of the
Frobenius at `𝔭` in `L/K` is the Frobenius at `𝔭` in `M/K`.  Consequently
`ker (artinSym_{L/K}) ⊆ ker (artinSym_{M/K})`, which is what reduces the abelian case of the
conductor theorem at the trivial modulus to the cyclic case (applied to one subextension `M`). -/

/-- **Unramifiedness descends to an intermediate field.** -/
lemma ramificationIdxIn_eq_one_of_intermediateField_iiu (M : IntermediateField K L)
    [FiniteDimensional K M] [NumberField ↥M] [Normal K ↥M]
    (p : NK.Chebotarev.PrimeIdeal K)
    (hunr : ∀ P : NK.Chebotarev.PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
      P.asIdeal.ramificationIdx (𝓞 K) = 1)
    (P : NK.Chebotarev.PrimeIdeal ↥M) (hP : P.asIdeal.LiesOver p.asIdeal) :
    P.asIdeal.ramificationIdx (𝓞 K) = 1 := by
  obtain ⟨Q, hQ⟩ := Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver
    (K := ↥M) (L := L) P
  haveI : Q.asIdeal.LiesOver P.asIdeal := hQ
  haveI : P.asIdeal.LiesOver p.asIdeal := hP
  have hPQ : Q.asIdeal.LiesOver p.asIdeal :=
    Ideal.LiesOver.trans (𝔓 := Q.asIdeal) (P := P.asIdeal) (p := p.asIdeal)
  haveI : Q.asIdeal.LiesOver p.asIdeal := hPQ
  have htower := Ideal.ramificationIdx_tower (R := 𝓞 K) (S := 𝓞 ↥M) (T := 𝓞 L)
    (q := P.asIdeal) (r := Q.asIdeal)
  rw [hunr Q hPQ] at htower
  exact Nat.eq_one_of_dvd_one ⟨Q.asIdeal.ramificationIdx (𝓞 ↥M), htower⟩

/-- **The restriction of the Frobenius is the Frobenius of the intermediate extension.** -/
lemma restrictNormalHom_frobAtPrime_iiu (M : IntermediateField K L)
    [FiniteDimensional K M] [NumberField ↥M] [Normal K ↥M]
    (hcommL : ∀ a b : Gal(L/K), a * b = b * a)
    (hcommM : ∀ a b : Gal(↥M/K), a * b = b * a)
    (p : NK.Chebotarev.PrimeIdeal K)
    (hunr : ∀ P : NK.Chebotarev.PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
      P.asIdeal.ramificationIdx (𝓞 K) = 1) :
    (AlgEquiv.restrictNormalHom ↥M) (NK.Chebotarev.frobAtPrime (K := K) (L := L) p)
      = NK.Chebotarev.frobAtPrime (K := K) (L := ↥M) p := by
  have h1 : NK.Chebotarev.IsFrobAtPrime (K := K) (L := ↥M) p
      ((AlgEquiv.restrictNormalHom ↥M) (NK.Chebotarev.frobAtPrime (K := K) (L := L) p)) :=
    NK.CFTLib.exists_isFrobAtPrime_restrict (K := K) (L := L) M
      (NK.Chebotarev.isFrobAtPrime_frobAtPrime (K := K) (L := L) hcommL p hunr)
  have hunrM : ∀ P : NK.Chebotarev.PrimeIdeal ↥M, P.asIdeal.LiesOver p.asIdeal →
      P.asIdeal.ramificationIdx (𝓞 K) = 1 :=
    fun P hP => ramificationIdxIn_eq_one_of_intermediateField_iiu (K := K) (L := L) M p hunr P hP
  exact ((NK.Chebotarev.isFrobAtPrime_iff_frobAtPrime_eq (K := K) (L := ↥M) hcommM p hunrM
    _).mp h1).symm

/-- **The Artin symbol restricts to the Artin symbol of the intermediate extension.**  For
`K ⊆ M ⊆ L` with `M/K` normal and `L/K` unramified at every finite prime (so that every prime
occurring in `A` is unramified), the restriction of the Artin symbol of `A` in `L/K` to `M` is the
Artin symbol of `A` in `M/K`.  Hence `ker (artinSym_{L/K}) ⊆ ker (artinSym_{M/K})`. -/
lemma restrictNormalHom_artinSym_iiu (M : IntermediateField K L)
    [FiniteDimensional K M] [NumberField ↥M] [Normal K ↥M]
    (hcommL : ∀ a b : Gal(L/K), a * b = b * a)
    (hcommM : ∀ a b : Gal(↥M/K), a * b = b * a)
    (hunr : differentIdeal (𝓞 K) (𝓞 L) = ⊤)
    (A : NK.CFTLib.ArtinReciprocityIdeal.Frac K) :
    (AlgEquiv.restrictNormalHom ↥M)
        (NK.CFTLib.Arl.artinSym (K := K) (L := L) hcommL (A : FractionalIdeal (𝓞 K)⁰ K))
      = NK.CFTLib.Arl.artinSym (K := K) (L := ↥M) hcommM (A : FractionalIdeal (𝓞 K)⁰ K) := by
  classical
  let e : Gal(L/K) →* Gal(↥M/K) := AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M
  letI galL : CommMonoid (Gal(L/K)) := NK.CFTLib.Arl.galCommMonoid hcommL
  letI galM : CommMonoid (Gal(↥M/K)) := NK.CFTLib.Arl.galCommMonoid hcommM
  have hfrob : ∀ p : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      e (NK.Chebotarev.frobAtPrime (K := K) (L := L) p)
        = NK.Chebotarev.frobAtPrime (K := K) (L := ↥M) p := by
    intro p
    refine restrictNormalHom_frobAtPrime_iiu (K := K) (L := L) M hcommL hcommM p (fun P hP => ?_)
    haveI : P.asIdeal.IsPrime := P.isPrime
    haveI : P.asIdeal.LiesOver p.asIdeal := hP
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal P.asIdeal
      (Gal(L/K))]
    exact ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p
  rw [NK.CFTLib.Arl.artinSym, NK.CFTLib.Arl.artinSym, Finsupp.prod,
    map_prod]
  refine Finset.prod_congr rfl (fun p _ => ?_)
  rw [map_zpow, hfrob p]

/-! ## The dictionary: from the principal ray to `artinKillsPrincipal` -/

/-- **The target theorem from the statement that the Artin symbol kills the principal ray
`P(1)`.**

`h` is the reciprocity law at the modulus `1`.  Together with the equality of the ideal-theoretic
and fractional-ideal Artin symbols on principal ideals, and the independence of the Frobenius
product from the choices, it yields `artinKillsPrincipal K L 1`. -/
theorem artinKillsPrincipal_one_of_killsPrincipalRay_iiu
    (hcomm : ∀ a b : Gal(L/K), a * b = b * a)
    (hunr : differentIdeal (𝓞 K) (𝓞 L) = ⊤)
    (h : ∀ A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1,
      NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm A = 1) :
    NK.CFTLib.artinKillsPrincipal K L 1 := by
  classical
  haveI : IsMulCommutative (Gal(L/K)) := IsMulCommutative.of_comm hcomm
  letI galC : CommMonoid (Gal(L/K)) := NK.CFTLib.Arl.galCommMonoid hcomm
  intro a ha hpos s e σ hs hfac hσ
  -- `a` is nonzero, since `(a)` is a product of prime powers
  have ha0 : a ≠ 0 := by
    intro h0
    refine prod_primeIdeal_pow_ne_bot_iiu (K := K) s e ?_
    rw [← hfac, h0, Ideal.span_singleton_eq_bot]
  have haK : (a : K) ≠ 0 := fun hc => ha0 (RingOfIntegers.coe_injective (by simpa using hc))
  set u : Kˣ := Units.mk0 (a : K) haK with hu
  have huval : ((u : Kˣ) : K) = (a : K) := rfl
  -- at `m = 1` the ramification hypothesis of the dictionary is vacuous
  have hram1 : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
      ((1 : ℕ) : 𝓞 K) ∈ p.asIdeal := by
    intro p hp
    exact absurd (isUnramified_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p) hp
  -- the ideal-theoretic and the fractional-ideal symbols agree on `(a)`
  have hdict : NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L) (Ideal.span {a})
      = NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm
          (FractionalIdeal.spanSingleton (𝓞 K)⁰ ((u : Kˣ) : K)) := by
    have h1 := NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_span_eq_artinSym_spanSingleton
      (K := K) (L := L) (fun a b : Gal(L/K) => IsMulCommutative.is_comm.comm a b) 1 hram1 a ha
    rw [huval]
    exact h1
  -- `(a)` lies in the principal ray `P(1)`
  have hmem : NK.CFTLib.ArtinReciprocityIdeal.spanUnit u ∈
      NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 := by
    refine Subgroup.subset_closure ⟨u, ⟨?_, ?_⟩, rfl⟩
    · intro 𝔭 h𝔭
      exact absurd h𝔭 (natCast_one_notMem_primeIdeal_iiu (K := K) 𝔭)
    · have h2 : (u : K) = (a : K) := huval
      rw [h2]
      exact realPlace_pos_of_forall_ringHom_pos_iiu (K := K) hpos
  -- hence the ideal-theoretic symbol of `(a)` is trivial
  have hsym : NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L)
      (Ideal.span {a}) = 1 := by
    have h3 : NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm
        ((NK.CFTLib.ArtinReciprocityIdeal.spanUnit u :
          NK.CFTLib.ArtinReciprocityIdeal.Frac K) : FractionalIdeal (𝓞 K)⁰ K) = 1 := h _ hmem
    have h4 : ((NK.CFTLib.ArtinReciprocityIdeal.spanUnit u :
        NK.CFTLib.ArtinReciprocityIdeal.Frac K) : FractionalIdeal (𝓞 K)⁰ K)
        = FractionalIdeal.spanSingleton (𝓞 K)⁰ ((u : Kˣ) : K) :=
      NK.CFTLib.ArtinReciprocityIdeal.coe_spanUnit u
    rw [hdict, ← h4]
    exact h3
  -- the symbol computed on the given factorisation
  have hAsym : NK.CFTLib.ArtinReciprocityIdeal.artinSymbol (K := K) (L := L) (Ideal.span {a})
      = ∏ p ∈ s, NK.CFTLib.ArtinReciprocityIdeal.frobSymbol (K := K) (L := L)
          p.asIdeal ^ e p := by
    rw [hfac]
    exact NK.CFTLib.ArtinReciprocityIdeal.artinSymbol_finset_prod s e
  have hprod : (∏ p ∈ s, NK.Chebotarev.frobAtPrime (K := K) (L := L) p ^ e p) = 1 := by
    have h5 : (∏ p ∈ s, NK.CFTLib.ArtinReciprocityIdeal.frobSymbol (K := K) (L := L)
        p.asIdeal ^ e p) = 1 := by
      rw [← hAsym, hsym]
    rw [← h5]
    refine Finset.prod_congr rfl (fun p _ => ?_)
    rw [NK.CFTLib.ArtinReciprocityIdeal.frobSymbol_eq (K := K) (L := L) p
      (isUnramified_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p)]
  have hlist : (s.toList.map
      (fun p => NK.Chebotarev.frobAtPrime (K := K) (L := L) p ^ e p)).prod = 1 :=
    (list_prod_map_eq_finset_prod_iiu s
      (fun p => NK.Chebotarev.frobAtPrime (K := K) (L := L) p ^ e p)).trans hprod
  have hunr' : ∀ p ∈ s, ∀ P : NK.Chebotarev.PrimeIdeal L,
      P.asIdeal.LiesOver p.asIdeal →
      P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1 := by
    intro p _ P hP
    haveI : P.asIdeal.IsPrime := P.isPrime
    haveI : P.asIdeal.LiesOver p.asIdeal := hP
    rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal P.asIdeal
      (Gal(L/K))]
    exact ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p
  rw [NK.CFTLib.frobAtPrime_prod_irrel (K := K) (L := L) hcomm s e σ hunr' hσ, hlist]

/-! ## The index equality at the trivial modulus, and the index argument -/

/-- At the trivial modulus the coprimality condition is vacuous: `I(1) = ⊤`. -/
lemma idealCoprimeGroup_one_eq_top_iiu (K : Type) [Field K] [NumberField K] :
    NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K 1 = ⊤ := by
  rw [eq_top_iff]
  intro A _
  rw [NK.CFTLib.ArtinReciprocityIdeal.mem_idealCoprimeGroup_iff (K := K) 1 A]
  exact fun 𝔭 h𝔭 => absurd h𝔭 (natCast_one_notMem_primeIdeal_iiu (K := K) 𝔭)

/-- The trivial modulus is admissible (the defining conditions are vacuous). -/
lemma isAdmissible_one_iiu (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] : NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible K L 1 := by
  intro 𝔭 h𝔭
  exact absurd h𝔭 (natCast_one_notMem_primeIdeal_iiu (K := K) 𝔭)

/-- Unramifiedness from the `ramificationIdxIn` form. -/
lemma isUnramified_of_ramificationIdxIn_eq_one_iiu
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1)
    (p : NK.Chebotarev.PrimeIdeal K) :
    NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p := by
  intro P hP
  haveI : P.asIdeal.IsPrime := P.isPrime
  haveI : P.asIdeal.LiesOver p.asIdeal := hP
  rw [← Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal P.asIdeal
    (Gal(L/K))]
  exact hram p

/-- **The index of `P(1)·𝔑(1)` is the degree**, for a cyclic extension unramified at all finite
primes.  Both halves are cycle-free: `≤` is the second inequality of class field theory in ideal
form (`indexPrincipalRaySupNormRayLe`) and `≥` is Lang's relative index (`langCyclicRelIndex`),
both at the trivial modulus, where the modulus conditions are vacuous. -/
lemma index_principalRay_sup_normRay_one_eq_finrank_iiu [IsCyclic (L ≃ₐ[K] L)]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1) :
    (NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRay K L 1).relIndex ⊤ = Module.finrank K L := by
  have htop : NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K 1 = ⊤ :=
    idealCoprimeGroup_one_eq_top_iiu K
  have hram1 : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
      ((1 : ℕ) : 𝓞 K) ∈ p.asIdeal :=
    fun p hp => absurd (isUnramified_of_ramificationIdxIn_eq_one_iiu (K := K) (L := L) hram p) hp
  have hle : (NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRay K L 1).relIndex ⊤ ≤ Module.finrank K L := by
    have h := NK.CFTLib.ArtinReciprocityIdeal.indexPrincipalRaySupNormRayLe K L 1 (by norm_num)
    rw [htop] at h
    exact h
  have hge : Module.finrank K L ≤ (NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRay K L 1).relIndex ⊤ := by
    have h := (NK.NUV2.ARL.Gap.langCyclicRelIndex K L 1 (by norm_num) hram1
      (isAdmissible_one_iiu K L)).2
    rw [htop] at h
    exact h
  exact le_antisymm hle hge

/-- **The index argument**: for a cyclic extension unramified at every finite prime, the kernel
containment at the trivial modulus forces the Artin symbol to kill the principal ray `P(1)`. -/
lemma principalRay_le_ker_of_containment_one_iiu [IsCyclic (L ≃ₐ[K] L)]
    [IsMulCommutative (Gal(L/K))]
    (hram : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal K, Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1)
    (hker : ∀ A : NK.CFTLib.ArtinReciprocityIdeal.Frac K,
      NK.CFTLib.Arl.artinSym (K := K) (L := L)
        (fun a b : Gal(L/K) => IsMulCommutative.is_comm.comm a b) A = 1 →
      A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
          NK.CFTLib.ArtinReciprocityIdeal.normRay K L 1) :
    NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ≤
      (NK.CFTLib.ArtinReciprocityIdeal.artinSymFracHom (K := K) (L := L)
        (fun a b : Gal(L/K) => IsMulCommutative.is_comm.comm a b)).ker := by
  classical
  have hcomm : ∀ a b : Gal(L/K), a * b = b * a :=
    fun a b => IsMulCommutative.is_comm.comm a b
  let f : NK.CFTLib.ArtinReciprocityIdeal.Frac K →* Gal(L/K) :=
    NK.CFTLib.ArtinReciprocityIdeal.artinSymFracHom hcomm
  let PN : Subgroup (NK.CFTLib.ArtinReciprocityIdeal.Frac K) :=
    NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
      NK.CFTLib.ArtinReciprocityIdeal.normRay K L 1
  have hf : ∀ A : NK.CFTLib.ArtinReciprocityIdeal.Frac K,
      f A = NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm A := fun A => rfl
  have hle : f.ker ≤ PN := by
    intro A hA
    exact hker A (by rw [← hf A]; exact hA)
  have hsurj : Function.Surjective f := by
    intro σ
    obtain ⟨A, hA⟩ := NK.CFTLib.ArtinReciprocityIdeal.artinSymSurjectiveOnCoprime K L 1
      (by norm_num)
      (fun p hp => absurd (isUnramified_of_ramificationIdxIn_eq_one_iiu (K := K) (L := L) hram p) hp)
      σ
    exact ⟨(A : NK.CFTLib.ArtinReciprocityIdeal.Frac K), by rw [hf]; exact hA⟩
  have hidxker : f.ker.index = Module.finrank K L := by
    rw [Subgroup.index_eq_card, ← IsGalois.card_aut_eq_finrank (F := K) (E := L)]
    rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv,
      MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top]
  have hidxPN : PN.index = Module.finrank K L := by
    rw [← Subgroup.relIndex_top_right]
    exact index_principalRay_sup_normRay_one_eq_finrank_iiu (K := K) (L := L) hram
  have hker_le : PN ≤ f.ker := by
    have h := Subgroup.relIndex_mul_index hle
    rw [hidxPN, hidxker] at h
    have h2 : f.ker.relIndex PN * Module.finrank K L = 1 * Module.finrank K L := by
      rw [one_mul]; exact h
    exact Subgroup.relIndex_eq_one.mp (Nat.eq_of_mul_eq_mul_right Module.finrank_pos h2)
  exact le_sup_left.trans (le_antisymm hle hker_le).symm.le

/-- **The target theorem: `artinKillsPrincipal K L 1` for `L/K` unramified at the finite primes.**

The proof is: the abelian case is detected on the cyclic quotients of `Gal(L/K)`
(`iInf_subgroup_isCyclic_quotient`), for which the *cyclic* case of the conductor theorem at the
trivial modulus is available from the Lang X.2 machinery
(`NK.CFTLib.ARL.transfer_of_auxField` with Artin's lemma `NK.CFTLib.ARL.auxField_exists_one`,
plus the index argument `artinKillsPrincipal_one_of_kernelLe_principalRay`); the restriction
`restrictNormalHom_artinSym_iiu` of the Artin symbol to the fixed field of a subgroup transports the
result back. -/
theorem artinKillsPrincipal_one_of_isUnramifiedAtFinite
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsMulCommutative (L ≃ₐ[K] L)]
    (hARL : NK.CFTLib.ArtinReciprocityIdeal)
    (hunr : differentIdeal (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L) = ⊤) :
    NK.CFTLib.artinKillsPrincipal K L 1 := by
  classical
  refine artinKillsPrincipal_one_of_killsPrincipalRay_iiu (K := K) (L := L)
    (fun a b => IsMulCommutative.is_comm.comm a b) hunr ?_
  intro A hA
  -- Unramifiedness of the intermediate fields, in the `ramificationIdxIn` form.
  have hramL : ∀ p : NK.Chebotarev.PrimeIdeal K,
      Ideal.ramificationIdxIn p.asIdeal (𝓞 L) = 1 :=
    fun p => ramificationIdxIn_eq_one_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p
  -- The cyclic case for an intermediate field `M`: the transfer, the index argument, and the
  -- resulting vanishing on the principal ray.
  have hcyc : ∀ (M : IntermediateField K L) [FiniteDimensional K M] [NumberField ↥M]
      [IsGalois K ↥M] [IsCyclic (Gal(↥M/K))] [IsMulCommutative (Gal(↥M/K))],
      ∀ B ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1,
        NK.CFTLib.Arl.artinSym (K := K) (L := ↥M)
          (fun a b : Gal(↥M/K) => IsMulCommutative.is_comm.comm a b) B = 1 := by
    intro M _ _ _ _ _ B hB
    have hramM : ∀ p : NK.Chebotarev.PrimeIdeal K,
        Ideal.ramificationIdxIn p.asIdeal (𝓞 ↥M) = 1 := by
      intro p
      obtain ⟨P, hP⟩ :=
        Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver (K := K) (L := ↥M) p
      letI hMSA : MulSemiringAction (Gal(↥M/K)) (𝓞 ↥M) :=
        IsIntegralClosure.MulSemiringAction (𝓞 K) K ↥M (𝓞 ↥M)
      haveI hGG : IsGaloisGroup (Gal(↥M/K)) (𝓞 K) (𝓞 ↥M) :=
        IsGaloisGroup.of_isFractionRing (Gal(↥M/K)) (𝓞 K) (𝓞 ↥M) K ↥M
      haveI : P.asIdeal.IsPrime := P.isPrime
      haveI : P.asIdeal.LiesOver p.asIdeal := hP
      rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 ↥M) p.asIdeal P.asIdeal
        (Gal(↥M/K))]
      exact ramificationIdxIn_eq_one_of_intermediateField_iiu (K := K) (L := L) M p
        (fun Q hQ => isUnramified_of_differentIdeal_eq_top_iiu (K := K) (L := L) hunr p Q hQ) P hP
    have hker : ∀ C : NK.CFTLib.ArtinReciprocityIdeal.Frac K,
        NK.CFTLib.Arl.artinSym (K := K) (L := ↥M)
          (fun a b : Gal(↥M/K) => IsMulCommutative.is_comm.comm a b) C = 1 →
        C ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K 1 ⊔
            NK.CFTLib.ArtinReciprocityIdeal.normRay K ↥M 1 := by
      intro C hC
      refine NK.CFTLib.ARL.transfer_of_auxField K ↥M 1 (by norm_num)
        (NK.CFTLib.ARL.auxField_exists_one K ↥M 1 (by norm_num)) ?_ C ?_ hC
      · intro p hp
        exact absurd (isUnramified_of_ramificationIdxIn_eq_one_iiu (K := K) (L := ↥M) hramM p) hp
      · intro 𝔭 h𝔭
        exact absurd h𝔭 (natCast_one_notMem_primeIdeal_iiu (K := K) 𝔭)
    exact (principalRay_le_ker_of_containment_one_iiu (K := K) (L := ↥M) hramM hker) hB
  -- Detection on the cyclic quotients of `Gal(L/K)`.
  haveI : Fintype (Gal(L/K)) := Fintype.ofFinite _
  have hmem : NK.CFTLib.Arl.artinSym (K := K) (L := L)
      (fun a b => IsMulCommutative.is_comm.comm a b) (A : FractionalIdeal (𝓞 K)⁰ K) ∈
      (⨅ H : {H : Subgroup (Gal(L/K)) // IsCyclic (Gal(L/K) ⧸ H)},
        (H.1 : Subgroup (Gal(L/K)))) := by
    rw [Subgroup.mem_iInf]
    rintro ⟨H, hHcyc⟩
    haveI : H.Normal := Subgroup.normal_of_isMulCommutative H
    haveI : FiniteDimensional K ↥(IntermediateField.fixedField H) := inferInstance
    haveI : NumberField ↥(IntermediateField.fixedField H) := inferInstance
    haveI : Normal K ↥(IntermediateField.fixedField H) := inferInstance
    haveI : IsGalois K ↥(IntermediateField.fixedField H) :=
      Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
    haveI : IsCyclic (Gal(↥(IntermediateField.fixedField H)/K)) :=
      (MulEquiv.isCyclic (IsGalois.normalAutEquivQuotient H).symm).mpr hHcyc
    haveI : IsMulCommutative (Gal(↥(IntermediateField.fixedField H)/K)) :=
      IsCyclic.isMulCommutative
    have hres := restrictNormalHom_artinSym_iiu (K := K) (L := L)
      (IntermediateField.fixedField H)
      (fun a b => IsMulCommutative.is_comm.comm a b)
      (fun a b => IsMulCommutative.is_comm.comm a b) hunr A
    have hkillM : NK.CFTLib.Arl.artinSym (K := K) (L := ↥(IntermediateField.fixedField H))
        (fun a b => IsMulCommutative.is_comm.comm a b) (A : FractionalIdeal (𝓞 K)⁰ K) = 1 :=
      hcyc (IntermediateField.fixedField H) A hA
    have hres1 : (AlgEquiv.restrictNormalHom (F := K) (K₁ := L)
        ↥(IntermediateField.fixedField H))
        (NK.CFTLib.Arl.artinSym (K := K) (L := L)
          (fun a b => IsMulCommutative.is_comm.comm a b) (A : FractionalIdeal (𝓞 K)⁰ K)) = 1 := by
      rw [hres, hkillM]
    change (NK.CFTLib.Arl.artinSym (K := K) (L := L)
      (fun a b => IsMulCommutative.is_comm.comm a b) (A : FractionalIdeal (𝓞 K)⁰ K)) ∈ H
    rw [← IntermediateField.fixingSubgroup_fixedField H,
      ← IntermediateField.restrictNormalHom_ker]
    exact MonoidHom.mem_ker.mpr hres1
  haveI : Finite (Gal(L/K)) := Finite.of_fintype _
  have hbot : (⨅ H : {H : Subgroup (Gal(L/K)) // IsCyclic (Gal(L/K) ⧸ H)},
      (H.1 : Subgroup (Gal(L/K)))) = ⊥ := by
    letI : CommGroup (Gal(L/K)) :=
      { (inferInstance : Group (Gal(L/K))) with
        mul_comm := fun a b => IsMulCommutative.is_comm.comm a b }
    exact NK.CFTLib.ArtinReciprocityIdeal.iInf_subgroup_isCyclic_quotient (G := Gal(L/K))
  rw [hbot] at hmem
  exact hmem

end NK.CFTLib.Existence
