import Mathlib

namespace NK.GroupTheory.Cyclic

/-- Auxiliary counting/order fact: if `g ^ m = w` for some natural number `m` (so `w` is a
natural power of `g`) and `w ^ p = 1`, then `w` lies in the subgroup generated by
`g ^ (orderOf g / p)`, as soon as `p` divides `orderOf g`.

Indeed `g ^ (m * p) = 1`, so `orderOf g ∣ m * p`, and cancelling the factor `p` (available
because `p ∣ orderOf g`) gives `orderOf g / p ∣ m`, whence `w = g ^ m` is a power of
`g ^ (orderOf g / p)`. -/
private lemma mem_zpowers_pow_div_of_pow_eq_one {C : Type*} [Group C] {g w : C} {p : ℕ}
    (hp : 0 < p) (hpdvd : p ∣ orderOf g) (hgm : ∃ m : ℕ, g ^ m = w) (hwp : w ^ p = 1) :
    w ∈ Subgroup.zpowers (g ^ (orderOf g / p)) := by
  obtain ⟨k, hk⟩ := hgm
  have hp1 : g ^ (k * p) = 1 := by rw [pow_mul, hk, hwp]
  obtain ⟨q, hq⟩ := hpdvd
  obtain ⟨t, ht⟩ := orderOf_dvd_of_pow_eq_one hp1
  have hpq : orderOf g / p = q := by rw [hq, Nat.mul_div_cancel_left _ hp]
  have hkt : k = q * t := by
    apply Nat.mul_right_cancel hp
    rw [ht, hq]; ring
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨(t : ℤ), ?_⟩
  rw [zpow_natCast, ← hk, hpq, ← pow_mul, hkt]

/-- If `A` is a finite abelian group of order `p ^ a` (`p` prime, `a ≥ 3`), `H ≤ A` is a cyclic
subgroup of index `p`, and `H' ≤ H` is a subgroup of order `p` whose quotient `A ⧸ H'` is cyclic,
then `A` is cyclic.

Proof sketch: lift a generator of `A ⧸ H'` to `x ∈ A`, so that `A = ⟨x⟩ · H'`.  The order of `x`
divides `p ^ a` and is divisible by `p ^ (a - 1)`, hence is `p ^ (a - 1)` or `p ^ a`.  In the
second case `A = ⟨x⟩` is cyclic at once.  In the first case `x ^ p ∈ H` (as `A / H` has order
`p`), so `z := x ^ (p ^ (a - 2)) = (x ^ p) ^ (p ^ (a - 3))` lies in `H` and has order `p`; since
`H` is cyclic any element of order `p` of `H` lies in `⟨g ^ (orderOf g / p)⟩` for a generator
`g` of `H` (equivalently: `H` has a unique subgroup of order `p`), and applying this both to `z`
and to every element of `H'` (whose `p`-th powers are trivial) shows `H' = ⟨z⟩ ≤ ⟨x⟩`, whence
`A = ⟨x⟩` — contradicting `orderOf x = p ^ (a - 1) < p ^ a = Nat.card A`. -/
theorem isCyclic_of_cyclic_of_index_prime_quotient_prime {A : Type*} [CommGroup A] [Finite A]
    {p a : ℕ} (hp : p.Prime) (ha : 3 ≤ a) (H : Subgroup A) (hHcyc : IsCyclic ↥H)
    (hHcard : Nat.card ↥H = p ^ (a - 1)) (hAcard : Nat.card A = p ^ a)
    (H' : Subgroup A) (hH'le : H' ≤ H) (hH'card : Nat.card ↥H' = p)
    (hquot : IsCyclic (A ⧸ H')) : IsCyclic A := by
  -- The quotient by `H'` has cardinality `p ^ (a - 1)`.
  have hquotcard : Nat.card (A ⧸ H') = p ^ (a - 1) := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup H'
    rw [hH'card, hAcard] at h
    have hpa : p ^ a = p ^ (a - 1) * p := by
      rw [← pow_succ p (a - 1), Nat.sub_add_cancel (by omega : 1 ≤ a)]
    rw [hpa] at h
    exact Nat.mul_right_cancel hp.pos h.symm
  -- Lift a generator of `A ⧸ H'` to an element `x` of `A`.
  obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := A ⧸ H')
  obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective H' g
  rw [← hx] at hg
  -- `A` is generated by `x` and `H'`.
  have hAx : Subgroup.zpowers x ⊔ H' = ⊤ := by
    rw [eq_top_iff]
    intro a _
    have ha : (QuotientGroup.mk' H') a ∈ Subgroup.zpowers ((QuotientGroup.mk' H') x) := by
      rw [Subgroup.mem_zpowers_iff]
      obtain ⟨k, hk⟩ :=
        (Submonoid.mem_powers_iff (a : A ⧸ H') ((QuotientGroup.mk' H') x)).mp (hg a)
      exact ⟨(k : ℤ), by rw [zpow_natCast, QuotientGroup.mk'_apply]; exact hk⟩
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp ha
    have hker : a * (x ^ k)⁻¹ ∈ H' := by
      have h1 : (QuotientGroup.mk' H') (a * (x ^ k)⁻¹) = 1 := by
        rw [map_mul, map_inv, map_zpow, hk, mul_inv_cancel]
      have h2 : a * (x ^ k)⁻¹ ∈ (QuotientGroup.mk' H').ker := MonoidHom.mem_ker.mpr h1
      rwa [QuotientGroup.ker_mk'] at h2
    rw [Subgroup.mem_sup]
    exact ⟨x ^ k, Subgroup.mem_zpowers_iff.mpr ⟨k, rfl⟩, a * (x ^ k)⁻¹, hker,
      by rw [← mul_assoc, mul_comm (x ^ k) a, mul_assoc, mul_inv_cancel, mul_one]⟩
  -- The order of the generator of the quotient is `p ^ (a - 1)`, hence `p ^ (a - 1) ∣ orderOf x`.
  have hord_q : orderOf ((QuotientGroup.mk' H') x) = p ^ (a - 1) := by
    rw [orderOf_eq_card_of_forall_mem_powers hg, hquotcard]
  have hdvd1 : p ^ (a - 1) ∣ orderOf x := by
    rw [← hord_q]
    exact orderOf_map_dvd (QuotientGroup.mk' H') x
  have hdvd2 : orderOf x ∣ p ^ a := by
    rw [← hAcard]; exact orderOf_dvd_natCard x
  -- So the order of `x` is `p ^ (a - 1)` or `p ^ a`.
  have hkey : orderOf x = p ^ (a - 1) ∨ orderOf x = p ^ a := by
    obtain ⟨k, hk_le, hk_eq⟩ := (Nat.dvd_prime_pow hp).mp hdvd2
    have hge : a - 1 ≤ k := by
      rw [hk_eq] at hdvd1
      exact (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdvd1
    rcases eq_or_lt_of_le hge with h | h
    · left; rw [hk_eq, h]
    · right; rw [hk_eq]; congr 1; omega
  rcases hkey with hordx | hordx
  · -- Case `orderOf x = p ^ (a - 1)` leads to a contradiction.
    exfalso
    -- `A / H` has order `p`.
    have hqHcard : Nat.card (A ⧸ H) = p := by
      have h := Subgroup.card_eq_card_quotient_mul_card_subgroup H
      rw [hHcard, hAcard] at h
      have hpa : p ^ a = p * p ^ (a - 1) := by
        rw [← pow_succ' p (a - 1), Nat.sub_add_cancel (by omega : 1 ≤ a)]
      rw [hpa] at h
      exact Nat.mul_right_cancel (pow_pos hp.pos _) h.symm
    -- Hence `x ^ p ∈ H`.
    have hxpH : x ^ p ∈ H := by
      have h1 : (QuotientGroup.mk' H) (x ^ p) = 1 := by
        rw [map_pow]
        exact orderOf_dvd_iff_pow_eq_one.mp
          (hqHcard ▸ orderOf_dvd_natCard ((QuotientGroup.mk' H) x))
      have h2 : x ^ p ∈ (QuotientGroup.mk' H).ker := MonoidHom.mem_ker.mpr h1
      rwa [QuotientGroup.ker_mk'] at h2
    -- The element `z = x ^ (p ^ (a - 2))` lies in `H` and has order `p`.
    set z : A := x ^ (p ^ (a - 2)) with hzdef
    have hz_mem : z ∈ H := by
      have hze : z = (x ^ p) ^ (p ^ (a - 3)) := by
        rw [hzdef, ← pow_mul, ← pow_succ']
        congr 1
        rw [show a - 3 + 1 = a - 2 by omega]
      rw [hze]
      exact Subgroup.pow_mem H hxpH _
    have hz_pow : z ^ p = 1 := by
      have hpow : p ^ (a - 2) * p = p ^ (a - 1) := by
        rw [← pow_succ, show a - 2 + 1 = a - 1 by omega]
      rw [hzdef, ← pow_mul, hpow, ← hordx]
      exact pow_orderOf_eq_one x
    have hz_ne : z ≠ 1 := by
      rw [hzdef]
      intro h1
      have hdiv : p ^ (a - 1) ∣ p ^ (a - 2) := by
        rw [← hordx]
        exact orderOf_dvd_of_pow_eq_one h1
      have hle : a - 1 ≤ a - 2 := (Nat.pow_dvd_pow_iff_le_right hp.one_lt).mp hdiv
      omega
    have hordz : orderOf z = p := by
      rcases (Nat.dvd_prime hp).mp (orderOf_dvd_of_pow_eq_one hz_pow) with h | h
      · exact absurd (orderOf_eq_one_iff.mp h) hz_ne
      · exact h
    -- Every element of `H` is a natural power of a generator `g` of `H`.
    obtain ⟨g, hg⟩ := IsCyclic.exists_monoid_generator (α := ↥H)
    have hH_pow : ∀ w ∈ H, ∃ m : ℕ, (g : A) ^ m = w := by
      intro w hw
      obtain ⟨m, hm⟩ := (Submonoid.mem_powers_iff (⟨w, hw⟩ : ↥H) g).mp (hg ⟨w, hw⟩)
      exact ⟨m, by rw [← Subgroup.coe_pow]; exact congrArg Subtype.val hm⟩
    have hord_g : orderOf (g : A) = p ^ (a - 1) := by
      rw [Subgroup.orderOf_coe, orderOf_eq_card_of_forall_mem_powers hg, hHcard]
    have hpdvd : p ∣ orderOf (g : A) := by
      rw [hord_g]
      simpa using pow_dvd_pow p (show 1 ≤ a - 1 by omega)
    -- `H'` and `z` both consist of `p`-torsion, so both live in `⟨g ^ (orderOf g / p)⟩`.
    have hKpow : ((g : A) ^ (orderOf (g : A) / p)) ^ p = 1 := by
      rw [← pow_mul, Nat.div_mul_cancel hpdvd, pow_orderOf_eq_one]
    have hKcard :
        Nat.card ↥(Subgroup.zpowers ((g : A) ^ (orderOf (g : A) / p))) ≤ p := by
      rw [Nat.card_zpowers]
      exact Nat.le_of_dvd hp.pos (orderOf_dvd_of_pow_eq_one hKpow)
    have hH'le_K : H' ≤ Subgroup.zpowers ((g : A) ^ (orderOf (g : A) / p)) := by
      intro w hw
      refine mem_zpowers_pow_div_of_pow_eq_one hp.pos hpdvd (hH_pow w (hH'le hw)) ?_
      have hcoe : orderOf w = orderOf (⟨w, hw⟩ : ↥H') :=
        Subgroup.orderOf_coe (⟨w, hw⟩ : ↥H')
      have h1 : orderOf w ∣ p := by
        rw [hcoe, ← hH'card]
        exact orderOf_dvd_natCard _
      exact orderOf_dvd_iff_pow_eq_one.mp h1
    have hzK : z ∈ Subgroup.zpowers ((g : A) ^ (orderOf (g : A) / p)) :=
      mem_zpowers_pow_div_of_pow_eq_one hp.pos hpdvd (hH_pow z hz_mem) hz_pow
    -- Consequently `H' = ⟨g ^ (orderOf g / p)⟩ ∋ z`, and since `z` has order `p`, `H' = ⟨z⟩`.
    have hH'eq : H' = Subgroup.zpowers ((g : A) ^ (orderOf (g : A) / p)) :=
      Subgroup.eq_of_le_of_card_ge hH'le_K (by rw [hH'card]; exact hKcard)
    have hz_in_H' : z ∈ H' := by rw [hH'eq]; exact hzK
    have hH'eq_z : H' = Subgroup.zpowers z := by
      symm
      apply Subgroup.eq_of_le_of_card_ge
      · rw [Subgroup.zpowers_le]; exact hz_in_H'
      · rw [Nat.card_zpowers, hordz]; exact le_of_eq hH'card
    -- But `z ∈ ⟨x⟩`, so `A = ⟨x⟩ · H' = ⟨x⟩`, contradicting `orderOf x < Nat.card A`.
    have hH'le_x : H' ≤ Subgroup.zpowers x := by
      rw [hH'eq_z]
      exact Subgroup.zpowers_le.mpr
        (by rw [hzdef]; exact Subgroup.npow_mem_zpowers x (p ^ (a - 2)))
    have htop : Subgroup.zpowers x = ⊤ := by
      rw [← hAx]
      exact (sup_eq_left.mpr hH'le_x).symm
    have hcontr : p ^ (a - 1) = p ^ a := by
      rw [← hordx, orderOf_eq_card_of_zpowers_eq_top htop, hAcard]
    have hlt : p ^ (a - 1) < p ^ a := Nat.pow_lt_pow_right hp.one_lt (by omega)
    omega
  · -- Case `orderOf x = p ^ a`: `x` generates `A`.
    exact isCyclic_of_orderOf_eq_card x (by rw [hordx, hAcard])

end NK.GroupTheory.Cyclic
