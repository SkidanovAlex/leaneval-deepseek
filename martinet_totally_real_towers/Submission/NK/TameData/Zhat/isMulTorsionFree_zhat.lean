import Mathlib
import Submission.NK.TameData.Definitions
import Submission.NK.TameData.Zhat.dvd_of_dvd_chain
import Submission.NK.TameData.Zhat.dvd_of_prime_pow_factorization_dvd

/-!
# `Ẑ` is torsion-free

`Ẑ`, the profinite completion of `ℤ`, is the inverse limit of the finite quotient groups
`ℤ ⧸ mℤ`.  This file shows that it has no nontrivial torsion: if `x ^ N = 1` with `N ≠ 0`
then `x = 1`.

The argument is the one described in the docstring of the main theorem: an element of the
limit is a compatible family `(x_H)_H` over the finite index normal subgroups `H ≤ ℤ`.  We
first reduce to the subgroups `mℤ` (every `H` contains `dℤ`, `d = [ℤ : H]`), then to the
prime power subgroups `ℓ^jℤ`: choosing integers `n_j` representing the components of
`x y⁻¹` at `ℓ^jℤ`, the hypothesis gives `ℓ^j ∣ N n_j`, compatibility gives
`ℓ^j ∣ n_{j+1} - n_j`, and the divisibility chain lemma
(`NK.TameData.Zhat.dvd_of_dvd_chain`) forces `ℓ^k ∣ n_k` for all `k` — so the component
vanishes.  A final divisibility argument on the CRT components handles general `m`
(`NK.TameData.Zhat.dvd_of_prime_pow_factorization_dvd`).

## Main result

* `NK.TameData.Zhat.isMulTorsionFree_zhat` : `IsMulTorsionFree Ẑ`.
-/

open scoped Classical

namespace NK.TameData.Zhat

open ProfiniteGrp

noncomputable section

/-- The index category of the profinite completion of `ℤ`: the finite index normal subgroups of
`Multiplicative ℤ`. -/
abbrev ZIdx : Type := FiniteIndexNormalSubgroup (Multiplicative ℤ)

/-- `Multiplicative ℤ` as a group object. -/
abbrev ZGrp : GrpCat := GrpCat.of (Multiplicative ℤ)

/-- The finite index normal subgroup `mℤ ≤ Multiplicative ℤ` (for `m ≠ 0`). -/
def mZ (m : ℕ) (hm : m ≠ 0) : ZIdx :=
  @FiniteIndexNormalSubgroup.ofSubgroup (Multiplicative ℤ) _
    (AddSubgroup.toSubgroup (AddSubgroup.zmultiples (m : ℤ))) _ (by
      rw [AddSubgroup.finiteIndex_toSubgroup_iff, AddSubgroup.finiteIndex_iff,
        Int.index_zmultiples]
      simp [hm])

/-- `ofAdd n` lies in `mℤ` exactly when `m ∣ n`. -/
theorem mem_mZ (m : ℕ) (hm : m ≠ 0) (n : ℤ) :
    Multiplicative.ofAdd n ∈ (mZ m hm).toSubgroup ↔ ((m : ℤ) ∣ n) := by
  rw [mZ]
  simp only [FiniteIndexNormalSubgroup.ofSubgroup, Multiplicative.mem_toSubgroup]
  exact Int.mem_zmultiples_iff

/-- Powers of `ofAdd` in `Multiplicative ℤ`, in explicit form. -/
lemma ofAdd_pow_eq_iff (m k : ℤ) (z : Multiplicative ℤ) :
    Multiplicative.ofAdd m ^ k = z ↔ z.toAdd = m * k := by
  constructor
  · intro h
    have := congrArg Multiplicative.toAdd h
    rw [toAdd_zpow, zsmul_eq_mul, toAdd_ofAdd] at this
    rw [mul_comm]
    exact this.symm
  · intro h
    rw [← ofAdd_toAdd z, h, ← ofAdd_zsmul, zsmul_eq_mul]
    congr 1
    exact mul_comm _ _

/-- `mℤ`, as a subgroup of `Multiplicative ℤ`, is the cyclic subgroup generated by `ofAdd m`. -/
theorem mZ_toSubgroup_eq_zpowers (m : ℕ) (hm : m ≠ 0) :
    (mZ m hm).toSubgroup = Subgroup.zpowers (Multiplicative.ofAdd (m : ℤ)) := by
  ext z
  rw [mZ, FiniteIndexNormalSubgroup.ofSubgroup, Multiplicative.mem_toSubgroup,
    Int.mem_zmultiples_iff, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨k, hk⟩
    exact ⟨k, (ofAdd_pow_eq_iff (m : ℤ) k z).mpr hk⟩
  · rintro ⟨k, hk⟩
    exact ⟨k, (ofAdd_pow_eq_iff (m : ℤ) k z).mp hk⟩

/-- The subgroups `mℤ` are monotone in the expected way: `b ∣ a` gives `aℤ ≤ bℤ`. -/
theorem mZ_le_of_dvd {a b : ℕ} (ha : a ≠ 0) (hb : b ≠ 0) (h : b ∣ a) :
    mZ a ha ≤ mZ b hb := by
  change (mZ a ha).toSubgroup ≤ (mZ b hb).toSubgroup
  intro z hz
  rw [mZ_toSubgroup_eq_zpowers b hb]
  rw [mZ_toSubgroup_eq_zpowers a ha] at hz
  rw [Subgroup.mem_zpowers_iff] at hz ⊢
  obtain ⟨k, hk⟩ := hz
  obtain ⟨c, hc⟩ := h
  refine ⟨c * k, (ofAdd_pow_eq_iff b (c * k) z).mpr ?_⟩
  rw [(ofAdd_pow_eq_iff a k z).mp hk, hc, Nat.cast_mul]
  ring

/-- The transition maps of the completion diagram send the class of `ofAdd m` to itself. -/
theorem diagram_map_mk {H K : ZIdx} (h : H ≤ K) (m : ℤ) :
    (ProfiniteGrp.ProfiniteCompletion.diagram ZGrp).map (CategoryTheory.homOfLE h)
      (QuotientGroup.mk (Multiplicative.ofAdd m) : (Multiplicative ℤ) ⧸ H.toSubgroup) =
      (QuotientGroup.mk (Multiplicative.ofAdd m) : (Multiplicative ℤ) ⧸ K.toSubgroup) :=
  rfl

/-- The `H`-th component of the `N`-th power of a point of the completion is the `N`-th power
of its `H`-th component. -/
theorem val_pow (z : NK.LocalAnabelian.Zhat) (H : ZIdx) (N : ℕ) :
    (z ^ N).val H = (z.val H) ^ N := by
  induction N with
  | zero => rw [pow_zero, pow_zero]; exact ProfiniteGrp.limit_one_val _ H
  | succ n ih =>
    have h1 : (z ^ n * z).val H = (z ^ n).val H * z.val H :=
      ProfiniteGrp.limit_mul_val _ (z ^ n) z H
    rw [pow_succ z n, h1, ih, pow_succ]

/-- The component group `ℤ ⧸ mℤ` is abelian, so equal `N`-th powers give an `N`-torsion
element `a b⁻¹`. -/
theorem mul_inv_pow_eq_one {H : ZIdx} (a b : (Multiplicative ℤ) ⧸ H.toSubgroup) {N : ℕ}
    (h : a ^ N = b ^ N) : (a * b⁻¹) ^ N = 1 := by
  rw [mul_pow, inv_pow, h, mul_inv_cancel]

/-- Every element of `ℤ ⧸ mℤ` is the class of an integer. -/
lemma exists_int_rep (H : ZIdx) (a : (Multiplicative ℤ) ⧸ H.toSubgroup) :
    ∃ n : ℤ, QuotientGroup.mk (Multiplicative.ofAdd n) = a := by
  obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective H.toSubgroup a
  refine ⟨y.toAdd, ?_⟩
  rw [← hy, QuotientGroup.mk'_apply, ofAdd_toAdd]

/-- **The prime power components of `x y⁻¹` vanish.**  If `x ^ N = y ^ N` with `N ≠ 0`, then
`x` and `y` agree at every subgroup `ℓ ^ jℤ`, `ℓ` prime, `j ≥ 1`. -/
theorem prime_pow_component_eq (x y : NK.LocalAnabelian.Zhat) {N : ℕ} (hN : N ≠ 0)
    (hxy : x ^ N = y ^ N) {ℓ : ℕ} (hℓ : ℓ.Prime) :
    ∀ j : ℕ, 1 ≤ j → x.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) =
      y.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) := by
  have hsurjX : ∀ j : ℕ, 1 ≤ j → ∃ p : ℤ,
      QuotientGroup.mk (Multiplicative.ofAdd p) =
        x.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) :=
    fun j _ => exists_int_rep _ _
  have hsurjY : ∀ j : ℕ, 1 ≤ j → ∃ q : ℤ,
      QuotientGroup.mk (Multiplicative.ofAdd q) =
        y.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) :=
    fun j _ => exists_int_rep _ _
  let p : ℕ → ℤ := fun j => if hj : 1 ≤ j then Classical.choose (hsurjX j hj) else 0
  let q : ℕ → ℤ := fun j => if hj : 1 ≤ j then Classical.choose (hsurjY j hj) else 0
  have hp : ∀ j (hj : 1 ≤ j), QuotientGroup.mk (Multiplicative.ofAdd (p j)) =
      x.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) := by
    intro j hj
    have hpj : p j = Classical.choose (hsurjX j hj) := dif_pos hj
    rw [hpj]
    exact Classical.choose_spec (hsurjX j hj)
  have hq : ∀ j (hj : 1 ≤ j), QuotientGroup.mk (Multiplicative.ofAdd (q j)) =
      y.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) := by
    intro j hj
    have hqj : q j = Classical.choose (hsurjY j hj) := dif_pos hj
    rw [hqj]
    exact Classical.choose_spec (hsurjY j hj)
  set n : ℕ → ℤ := fun j => p j - q j with hn
  have hpow : ∀ j (hj : 1 ≤ j),
      (x.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero))) ^ N =
      (y.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero))) ^ N := by
    intro j hj
    have h := congrArg (fun z : NK.LocalAnabelian.Zhat =>
      z.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero))) hxy
    rw [val_pow, val_pow] at h
    exact h
  have hrep : ∀ j (hj : 1 ≤ j),
      QuotientGroup.mk (Multiplicative.ofAdd (n j)) =
        x.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)) *
        (y.val (mZ (ℓ ^ j) (pow_ne_zero j hℓ.ne_zero)))⁻¹ := by
    intro j hj
    rw [hn]
    simp only
    rw [ofAdd_sub, QuotientGroup.mk_div, hp j hj, hq j hj]
    exact div_eq_mul_inv _ _
  have h1 : ∀ k, 1 ≤ k → (ℓ : ℤ) ^ k ∣ (N : ℤ) * n k := by
    intro k hk
    have hk' : ℓ ^ k ≠ 0 := pow_ne_zero k hℓ.ne_zero
    have hw : (x.val (mZ (ℓ ^ k) hk') * (y.val (mZ (ℓ ^ k) hk'))⁻¹) ^ N = 1 :=
      mul_inv_pow_eq_one _ _ (hpow k hk)
    have hw' : (QuotientGroup.mk (Multiplicative.ofAdd (n k)) :
        (Multiplicative ℤ) ⧸ (mZ (ℓ ^ k) hk').toSubgroup) ^ N = 1 := by
      rw [hrep k hk]; exact hw
    have hw'' : QuotientGroup.mk (Multiplicative.ofAdd ((N : ℤ) * n k)) =
        (1 : (Multiplicative ℤ) ⧸ (mZ (ℓ ^ k) hk').toSubgroup) := by
      have : Multiplicative.ofAdd ((N : ℤ) * n k) = Multiplicative.ofAdd (n k) ^ N := by
        rw [← nsmul_eq_mul, ofAdd_nsmul]
      rw [this, QuotientGroup.mk_pow]
      exact hw'
    exact (mem_mZ (ℓ ^ k) hk' ((N : ℤ) * n k)).mp ((QuotientGroup.eq_one_iff _).mp hw'')
  have h2 : ∀ k, 1 ≤ k → (ℓ : ℤ) ^ k ∣ n (k + 1) - n k := by
    intro k hk
    have hk' : ℓ ^ k ≠ 0 := pow_ne_zero k hℓ.ne_zero
    have hk1 : ℓ ^ (k + 1) ≠ 0 := pow_ne_zero (k + 1) hℓ.ne_zero
    have hk1' : 1 ≤ k + 1 := le_trans hk (Nat.le_succ k)
    have hle : mZ (ℓ ^ (k + 1)) hk1 ≤ mZ (ℓ ^ k) hk' :=
      mZ_le_of_dvd hk1 hk' (Nat.pow_dvd_pow ℓ (Nat.le_succ k))
    have cx := x.2 (CategoryTheory.homOfLE hle)
    have cy := y.2 (CategoryTheory.homOfLE hle)
    have hxmem : (Multiplicative.ofAdd (p k))⁻¹ * Multiplicative.ofAdd (p (k + 1)) ∈
        (mZ (ℓ ^ k) hk').toSubgroup := by
      rw [← QuotientGroup.eq]
      rw [hp k hk, ← cx, ← hp (k + 1) hk1', diagram_map_mk]
    have hymem : (Multiplicative.ofAdd (q k))⁻¹ * Multiplicative.ofAdd (q (k + 1)) ∈
        (mZ (ℓ ^ k) hk').toSubgroup := by
      rw [← QuotientGroup.eq]
      rw [hq k hk, ← cy, ← hq (k + 1) hk1', diagram_map_mk]
    have hpx : (ℓ : ℤ) ^ k ∣ p (k + 1) - p k := by
      have hmem : Multiplicative.ofAdd (p (k + 1) - p k) ∈
          (mZ (ℓ ^ k) hk').toSubgroup := by
        have hEq : Multiplicative.ofAdd (p (k + 1) - p k) =
            (Multiplicative.ofAdd (p k))⁻¹ * Multiplicative.ofAdd (p (k + 1)) := by
          rw [ofAdd_sub, div_eq_mul_inv, mul_comm]
        rw [hEq]
        exact hxmem
      exact (mem_mZ (ℓ ^ k) hk' _).mp hmem
    have hqy : (ℓ : ℤ) ^ k ∣ q (k + 1) - q k := by
      have hmem : Multiplicative.ofAdd (q (k + 1) - q k) ∈
          (mZ (ℓ ^ k) hk').toSubgroup := by
        have hEq : Multiplicative.ofAdd (q (k + 1) - q k) =
            (Multiplicative.ofAdd (q k))⁻¹ * Multiplicative.ofAdd (q (k + 1)) := by
          rw [ofAdd_sub, div_eq_mul_inv, mul_comm]
        rw [hEq]
        exact hymem
      exact (mem_mZ (ℓ ^ k) hk' _).mp hmem
    have hsub : (ℓ : ℤ) ^ k ∣ (p (k + 1) - p k) - (q (k + 1) - q k) := dvd_sub hpx hqy
    rw [hn]
    simp only
    convert hsub using 1
    ring
  intro j hj
  have hchain := dvd_of_dvd_chain hℓ hN h1 h2
  have hk' : ℓ ^ j ≠ 0 := pow_ne_zero j hℓ.ne_zero
  have hone : QuotientGroup.mk (Multiplicative.ofAdd (n j)) =
      (1 : (Multiplicative ℤ) ⧸ (mZ (ℓ ^ j) hk').toSubgroup) :=
    (QuotientGroup.eq_one_iff _).mpr ((mem_mZ (ℓ ^ j) hk' (n j)).mpr (hchain j hj))
  have hthis := hrep j hj
  rw [hone] at hthis
  refine mul_right_cancel (b := (y.val (mZ (ℓ ^ j) hk'))⁻¹) ?_
  rw [hthis.symm, mul_inv_cancel]
  rfl

/-- **The components at the subgroups `mℤ` agree.** -/
theorem mZ_component_eq (x y : NK.LocalAnabelian.Zhat) {N : ℕ} (hN : N ≠ 0)
    (hxy : x ^ N = y ^ N) (m : ℕ) (hm : m ≠ 0) :
    x.val (mZ m hm) = y.val (mZ m hm) := by
  obtain ⟨nx, hnx⟩ : ∃ nx : ℤ,
      QuotientGroup.mk (Multiplicative.ofAdd nx) = x.val (mZ m hm) := exists_int_rep _ _
  obtain ⟨ny, hny⟩ : ∃ ny : ℤ,
      QuotientGroup.mk (Multiplicative.ofAdd ny) = y.val (mZ m hm) := exists_int_rep _ _
  have hdvd : (m : ℤ) ∣ nx - ny := by
    apply dvd_of_prime_pow_factorization_dvd hm
    intro ℓ hℓ
    by_cases he : m.factorization ℓ = 0
    · rw [he, pow_zero]; exact one_dvd _
    · have hpos : 1 ≤ m.factorization ℓ := Nat.pos_of_ne_zero he
      have he0 : ℓ ^ m.factorization ℓ ≠ 0 := pow_ne_zero _ hℓ.ne_zero
      have hdiv : ℓ ^ m.factorization ℓ ∣ m := Nat.ordProj_dvd m ℓ
      have hle : mZ m hm ≤ mZ (ℓ ^ m.factorization ℓ) he0 := mZ_le_of_dvd hm he0 hdiv
      have hcomp := prime_pow_component_eq x y hN hxy hℓ (m.factorization ℓ) hpos
      have cx := x.2 (CategoryTheory.homOfLE hle)
      have cy := y.2 (CategoryTheory.homOfLE hle)
      have hX : QuotientGroup.mk (Multiplicative.ofAdd nx) =
          x.val (mZ (ℓ ^ m.factorization ℓ) he0) := by
        rw [← cx, ← hnx, diagram_map_mk]
      have hY : QuotientGroup.mk (Multiplicative.ofAdd ny) =
          y.val (mZ (ℓ ^ m.factorization ℓ) he0) := by
        rw [← cy, ← hny, diagram_map_mk]
      have hEq : (QuotientGroup.mk (Multiplicative.ofAdd nx) :
            (Multiplicative ℤ) ⧸ (mZ (ℓ ^ m.factorization ℓ) he0).toSubgroup) =
          QuotientGroup.mk (Multiplicative.ofAdd ny) := by
        rw [hX, hY, hcomp]
      have hmem : (Multiplicative.ofAdd ny)⁻¹ * Multiplicative.ofAdd nx ∈
          (mZ (ℓ ^ m.factorization ℓ) he0).toSubgroup := QuotientGroup.eq.mp hEq.symm
      have hmem2 : Multiplicative.ofAdd (nx - ny) ∈
          (mZ (ℓ ^ m.factorization ℓ) he0).toSubgroup := by
        have hEq2 : Multiplicative.ofAdd (nx - ny) =
            (Multiplicative.ofAdd ny)⁻¹ * Multiplicative.ofAdd nx := by
          rw [ofAdd_sub, div_eq_mul_inv, mul_comm]
        rw [hEq2]
        exact hmem
      exact (mem_mZ _ he0 _).mp hmem2
  have hmem : Multiplicative.ofAdd (nx - ny) ∈ (mZ m hm).toSubgroup :=
    (mem_mZ m hm _).mpr hdvd
  have hone : QuotientGroup.mk (Multiplicative.ofAdd (nx - ny)) =
      (1 : (Multiplicative ℤ) ⧸ (mZ m hm).toSubgroup) :=
    (QuotientGroup.eq_one_iff _).mpr hmem
  have hthis : QuotientGroup.mk (Multiplicative.ofAdd (nx - ny)) =
      x.val (mZ m hm) * (y.val (mZ m hm))⁻¹ := by
    rw [ofAdd_sub, QuotientGroup.mk_div, hnx, hny]
    exact div_eq_mul_inv _ _
  rw [hone] at hthis
  refine mul_right_cancel (b := (y.val (mZ m hm))⁻¹) ?_
  rw [hthis.symm, mul_inv_cancel]
  rfl

/-- **All components agree.**  Every finite index normal subgroup `H ≤ ℤ` contains `dℤ`,
`d = [ℤ : H]`, and the components at these `mℤ` agree. -/
theorem component_eq (x y : NK.LocalAnabelian.Zhat) {N : ℕ} (hN : N ≠ 0)
    (hxy : x ^ N = y ^ N) (H : ZIdx) : x.val H = y.val H := by
  have hd : H.toSubgroup.index ≠ 0 := Subgroup.FiniteIndex.index_ne_zero
  have hmem : Multiplicative.ofAdd (H.toSubgroup.index : ℤ) ∈ H.toSubgroup := by
    have h := Subgroup.pow_index_mem H.toSubgroup (Multiplicative.ofAdd (1 : ℤ))
    rw [← ofAdd_nsmul, nsmul_eq_mul, mul_one] at h
    exact h
  have hle : mZ H.toSubgroup.index hd ≤ H := by
    change (mZ H.toSubgroup.index hd).toSubgroup ≤ H.toSubgroup
    rw [mZ_toSubgroup_eq_zpowers, Subgroup.zpowers_le]
    exact hmem
  have hme := mZ_component_eq x y hN hxy H.toSubgroup.index hd
  have cx := x.2 (CategoryTheory.homOfLE hle)
  have cy := y.2 (CategoryTheory.homOfLE hle)
  rw [← cx, ← cy, hme]

/-- `Ẑ`, the profinite completion of `ℤ`, is torsion-free (it is `∏_ℓ ℤ_ℓ`, a product of
domains).  Work from the description of `completion` as a limit over the finite-index normal
subgroups `H` of `Multiplicative ℤ` (the subgroups `mℤ`), whose elements are compatible families
`(x_H)_H`: if `x ^ N = 1` then `N • x_H = 0` for all `H`, forcing `x_H = 0` whenever `gcd m N = 1`;
compatibility over `ℓ^kℤ ⊇ ℓ^{k+1}ℤ` and the `ℓ`-adic valuation then force `x_{ℓ^k} = 0` for all
`k` (if `v_ℓ (x_{ℓ^k}) = v < k` were finite, compatibility would give `v_ℓ (x_{ℓ^j}) = v` for all
`j ≥ k`, contradicting `ℓ^j ∣ N • x_{ℓ^j}` for large `j`); and for arbitrary `H` of index `d` one
has `dℤ ⊆ H`, so the Chinese remainder property of `ℤ ⧸ dℤ` reduces `x_H` to vanishing
prime-power components. -/
theorem isMulTorsionFree_zhat : IsMulTorsionFree NK.LocalAnabelian.Zhat := by
  refine ⟨fun n hn => ?_⟩
  exact fun x y hxy => ProfiniteGrp.limit_ext _ x y fun H => component_eq x y hn hxy H

end

end NK.TameData.Zhat
