/-! ## Elementary group theory -/

/-- The cyclic subgroup generated by `σ` is commutative. -/
theorem zpowers_comm {G : Type*} [Group G] (σ : G) (a b : ↥(Subgroup.zpowers σ)) :
    a * b = b * a := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp a.2
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp b.2
  refine Subtype.ext ?_
  simp only [Subgroup.coe_mul]
  rw [← hm, ← hn, ← zpow_add, ← zpow_add, Int.add_comm]

/-! ## Conjugation invariance of the Frobenius set -/

section Conj

variable {K N : Type*} [Field K] [NumberField K] [Field N] [NumberField N] [Algebra K N]
  [FiniteDimensional K N] [IsGalois K N]

/-- **Conjugation invariance of the Frobenius predicate at a fixed prime.**  If `σ` is a Frobenius
element at a prime above `p`, then so is every conjugate of `σ`. -/
theorem isFrobAtPrime_conj {p : PrimeIdeal K} {σ τ : Gal(N/K)} (h : IsFrobAtPrime p σ) :
    IsFrobAtPrime p (τ * σ * τ⁻¹) := by
  obtain ⟨P, hP, hσ⟩ := h
  refine ⟨τ • P, ?_, IsFrobAtConj hσ⟩
  rw [smul_primeIdeal_asIdeal]
  exact Commons.NumberTheory.NumberField.liesOver_map_galRestrict p P τ

/-- The Frobenius set of an element only depends on its conjugacy class. -/
theorem frobSet_conj {σ τ : Gal(N/K)} (h : IsConj σ τ) :
    frobSet (K := K) (N := N) σ = frobSet (K := K) (N := N) τ := by
  obtain ⟨c, rfl⟩ := isConj_iff.mp h
  ext p
  simp only [frobSet, Set.mem_setOf_eq]
  constructor
  · intro hp
    have h' := isFrobAtPrime_conj (K := K) (N := N) (τ := c) hp
    have hc : c * σ * c⁻¹ = c * σ * c⁻¹ := rfl
    simpa using h'
  · intro hp
    have h' := isFrobAtPrime_conj (K := K) (N := N) (τ := c⁻¹) hp
    have hc : c⁻¹ * (c * σ * c⁻¹) * c⁻¹⁻¹ = σ := by group
    rwa [hc] at h'

/-- **The Frobenius set of a conjugacy class.**  The set of primes whose Frobenius class is the
class of `σ` is the Frobenius set of `σ`. -/
theorem frobClassSet_conjClass (σ : Gal(N/K)) :
    frobClassSet (K := K) (N := N) (conjClass σ) = frobSet (K := K) (N := N) σ := by
  ext p
  simp only [frobClassSet, frobSet, Set.mem_setOf_eq, IsFrobClassAt, mem_conjClass]
  constructor
  · rintro ⟨τ, hτ, hτp⟩
    have hmem : p ∈ frobSet (K := K) (N := N) τ := hτp
    rw [← frobSet_conj (K := K) (N := N) hτ] at hmem
    exact hmem
  · intro hp
    exact ⟨σ, IsConj.refl σ, hp⟩

/-- **The density of the Frobenius class of `σ` is positive.** -/
theorem frobDensity_pos (σ : Gal(N/K)) : 0 < frobDensity (K := K) (N := N) σ := by
  have h : 0 < (Nat.card ↥(Subgroup.centralizer ({σ} : Set (Gal(N/K)))) : ℝ) := by
    exact_mod_cast (Nat.card_pos (α := ↥(Subgroup.centralizer ({σ} : Set (Gal(N/K))))))
  rw [frobDensity]
  positivity

end Conj

/-! ## The unramified primes are finite -/

section Unramified

variable {K N : Type*} [Field K] [NumberField K] [Field N] [NumberField N] [Algebra K N]
  [FiniteDimensional K N]

/-- **Only finitely many primes of `K` ramify in `N`.** -/
theorem finite_setOf_not_isUnramified :
    {p : PrimeIdeal K | ¬ IsUnramifiedAt (K := K) (N := N) p}.Finite := by
  refine (Commons.NumberTheory.NumberField.finite_setOf_ramificationIdx_ne_one
    (K := K) (L := N)).image
      (fun q : PrimeIdeal N =>
        IsDedekindDomain.HeightOneSpectrum.under (NumberField.RingOfIntegers K) q)
    |>.subset ?_
  rintro p hp
  simp only [IsUnramifiedAt, not_forall] at hp
  obtain ⟨P, hP, heP⟩ := hp
  exact ⟨P, heP, IsDedekindDomain.HeightOneSpectrum.ext (by
    rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal, hP.over])⟩

end Unramified

/-! ## The transfer step and the reduction -/

section Reduction

variable {K N : Type} [Field K] [NumberField K] [Field N] [NumberField N] [Algebra K N]
  [FiniteDimensional K N] [IsGalois K N]

/-- The cyclic subgroup generated by `σ` is commutative, for the elements of a fixing subgroup. -/
theorem comm_of_fixingSubgroup_eq_zpowers {M : IntermediateField K N} {σ : Gal(N/K)}
    (hM : M.fixingSubgroup = Subgroup.zpowers σ) {a b : Gal(N/K)}
    (ha : a ∈ M.fixingSubgroup) (hb : b ∈ M.fixingSubgroup) : a * b = b * a := by
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hM ▸ ha)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hM ▸ hb)
  rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm]

/-- **The abelian case of Čebotarev, applied at the cyclic level `N/N^⟨σ⟩`.**  For `σ : Gal(N/K)`,
the intermediate field `M = N^⟨σ⟩` satisfies `Gal(N/M) = ⟨σ⟩`, so the abelian case applies to the
extension `N/M` and gives the density `1/ord(σ)` of the primes of `M` at which `σ` is a Frobenius
element of `N/M`. -/
theorem hasDirichletDensity_frobSetSub_of_abelian (h_ab : AbelianChebotarevDensity)
    (σ : Gal(N/K)) :
    NumberField.Set.HasDirichletDensity
      (frobSetSub (K := K) (N := N) (IntermediateField.fixedField (Subgroup.zpowers σ)) σ
        (by rw [IntermediateField.fixingSubgroup_fixedField]; exact Subgroup.mem_zpowers σ))
      (1 / (Nat.card (Subgroup.zpowers σ) : ℝ)) := by
  classical
  set H : Subgroup Gal(N/K) := Subgroup.zpowers σ with hH
  set M : IntermediateField K N := IntermediateField.fixedField H with hM
  have hfix : M.fixingSubgroup = H := by
    rw [hM, hH]
    exact IntermediateField.fixingSubgroup_fixedField H
  have hσ : σ ∈ M.fixingSubgroup := by rw [hfix]; exact Subgroup.mem_zpowers σ
  have hcomm : ∀ a b : Gal(N/↥M), a * b = b * a := by
    intro a b
    obtain ⟨x, rfl⟩ := M.fixingSubgroupEquiv.surjective a
    obtain ⟨y, rfl⟩ := M.fixingSubgroupEquiv.surjective b
    rw [← map_mul, ← map_mul]
    exact congrArg M.fixingSubgroupEquiv
      (Subtype.ext (comm_of_fixingSubgroup_eq_zpowers hfix x.2 y.2))
  have hdens := h_ab ↥M N hcomm (M.fixingSubgroupEquiv ⟨σ, hσ⟩)
  have hcard : Nat.card (Gal(N/↥M)) = Nat.card (Subgroup.zpowers σ) := by
    have h1 : Nat.card (Gal(N/↥M)) = Nat.card ↥(M.fixingSubgroup) :=
      (Nat.card_congr M.fixingSubgroupEquiv.toEquiv).symm
    rw [h1, hfix, hH]
  rw [hcard] at hdens
  exact hdens

/-- **The cyclic case implies the general case**: Čebotarev's density theorem follows from its
abelian case together with the transfer step `DeuringTransfer`. -/
theorem chebotarevDensity_of_abelian_of_transfer (h_ab : AbelianChebotarevDensity)
    (h_tr : DeuringTransfer) : ChebotarevDensity := by
  intro K N _ _ _ _ _ _ _ σ
  exact h_tr K N σ (hasDirichletDensity_frobSetSub_of_abelian (K := K) (N := N) h_ab σ)

end Reduction

end



/-! ## The two actions of the Galois group on the finite places -/

section ActionBridge

variable {K N : Type*} [Field K] [NumberField K] [Field N] [NumberField N] [Algebra K N]
  [FiniteDimensional K N] [IsGalois K N]

/-- The action of `Gal(N/K)` on the finite places used in `NK.Chebotarev` (via `Ideal.map`)
agrees with the one used in `Submission.NeukirchUchida.Local` (via `HeightOneSpectrum.mapRingEquiv`). -/
theorem smul_primeIdeal_eq_placeSmul (σ : Gal(N/K)) (P : NK.Chebotarev.PrimeIdeal N) :
    σ • P = Submission.NeukirchUchida.Local.placeSmul σ P := by
  apply IsDedekindDomain.HeightOneSpectrum.ext
  rw [NK.Chebotarev.smul_primeIdeal_asIdeal, Submission.NeukirchUchida.Local.placeSmul_asIdeal]

end ActionBridge

/-! ## The primes above a fixed prime are finite -/

section PrimesAbove

variable {K M : Type} [Field K] [NumberField K] [Field M] [NumberField M]
  [Algebra K M] [FiniteDimensional K M]

/-- **Only finitely many primes of `M` lie above a given prime of `K`.** -/
theorem finite_setOf_liesOver (𝔭 : NK.Chebotarev.PrimeIdeal K) :
    {𝒬 : NK.Chebotarev.PrimeIdeal M | 𝒬.asIdeal.LiesOver 𝔭.asIdeal}.Finite := by
  have hfin : (𝔭.asIdeal.primesOver (NumberField.RingOfIntegers M)).Finite :=
    Commons.NumberTheory.NumberField.finite_primesOver 𝔭.asIdeal 𝔭.isPrime 𝔭.ne_bot
  refine Set.Finite.of_finite_image (s := {𝒬 : NK.Chebotarev.PrimeIdeal M |
      𝒬.asIdeal.LiesOver 𝔭.asIdeal}) (f := fun 𝒬 => 𝒬.asIdeal) ?_ ?_
  · exact hfin.subset (by
      rintro _ ⟨𝒬, h𝒬, rfl⟩
      exact ⟨inferInstance, h𝒬⟩)
  · intro 𝒬 _ 𝒬' _ h
    exact IsDedekindDomain.HeightOneSpectrum.ext h

end PrimesAbove

end NK.ChebotarevGeneral
