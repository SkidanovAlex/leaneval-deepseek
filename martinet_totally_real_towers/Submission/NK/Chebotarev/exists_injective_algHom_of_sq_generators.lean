import Mathlib

namespace NK.Chebotarev

/-- Product formula for a family of elements whose squares are rational scalars.
For `S T : Finset ι`,
`(∏_{i∈S} x i) * (∏_{i∈T} x i) = (∏_{i∈S∩T} d i) · ∏_{i∈S△T} x i`,
where `S △ T` is the symmetric difference. -/
private lemma prod_monomial_mul {ι : Type*} [DecidableEq ι] {A : Type*} [CommSemiring A]
    [Algebra ℚ A] (d : ι → ℚ) (x : ι → A) (hx : ∀ i, x i ^ 2 = algebraMap ℚ A (d i))
    (S T : Finset ι) :
    (∏ i ∈ S, x i) * (∏ i ∈ T, x i)
      = algebraMap ℚ A (∏ i ∈ S ∩ T, d i) * (∏ i ∈ symmDiff S T, x i) := by
  have hdisj : Disjoint (symmDiff S T) (S ∩ T) := by
    rw [Finset.disjoint_left]
    intro a ha ha'
    rw [Finset.mem_symmDiff] at ha
    rw [Finset.mem_inter] at ha'
    tauto
  have hunion : symmDiff S T ∪ (S ∩ T) = S ∪ T := by
    ext a
    simp only [Finset.mem_union, Finset.mem_symmDiff, Finset.mem_inter]
    tauto
  have e1 : (∏ i ∈ S ∪ T, x i) * (∏ i ∈ S ∩ T, x i) = (∏ i ∈ S, x i) * (∏ i ∈ T, x i) :=
    Finset.prod_union_inter
  have e2 : (∏ i ∈ S ∪ T, x i) = (∏ i ∈ symmDiff S T, x i) * (∏ i ∈ S ∩ T, x i) := by
    rw [← hunion, Finset.prod_union hdisj]
  have e3 : (∏ i ∈ S ∩ T, x i) ^ 2 = algebraMap ℚ A (∏ i ∈ S ∩ T, d i) := by
    rw [sq, ← Finset.prod_mul_distrib]
    rw [show (∏ i ∈ S ∩ T, x i * x i) = ∏ i ∈ S ∩ T, x i ^ 2 from by
      apply Finset.prod_congr rfl; intro i _; rw [sq]]
    rw [show (∏ i ∈ S ∩ T, x i ^ 2) = ∏ i ∈ S ∩ T, algebraMap ℚ A (d i) from by
      apply Finset.prod_congr rfl; intro i _; rw [hx]]
    rw [map_prod]
  calc (∏ i ∈ S, x i) * (∏ i ∈ T, x i)
      = (∏ i ∈ S ∪ T, x i) * (∏ i ∈ S ∩ T, x i) := e1.symm
    _ = ((∏ i ∈ symmDiff S T, x i) * (∏ i ∈ S ∩ T, x i)) * (∏ i ∈ S ∩ T, x i) := by rw [e2]
    _ = (∏ i ∈ symmDiff S T, x i) * (∏ i ∈ S ∩ T, x i) ^ 2 := by ring
    _ = (∏ i ∈ symmDiff S T, x i) * algebraMap ℚ A (∏ i ∈ S ∩ T, d i) := by rw [e3]
    _ = algebraMap ℚ A (∏ i ∈ S ∩ T, d i) * (∏ i ∈ symmDiff S T, x i) := by ring

/-- If `K` is generated over `ℚ` by elements `y i` with `y i ^ 2 ∈ ℚ`, then `K` embeds
into any `ℚ`-algebra `F` containing elements `s i` with the same squares, provided that
`[K : ℚ] = 2 ^ r`.

The degree hypothesis forces the monomials `∏_{i ∈ S} y i` (`S : Finset (Fin r)`) to be a
`ℚ`-basis of `K`, so there is a well defined `ℚ`-algebra homomorphism sending `y i ↦ s i`;
since `K` is a field, such a homomorphism is injective. -/
theorem exists_injective_algHom_of_sq_generators {K F : Type*} [Field K] [Field F]
    [Algebra ℚ K] [Algebra ℚ F] (r : ℕ) (d : Fin r → ℚ) (y : Fin r → K) (s : Fin r → F)
    (hy : ∀ i, y i ^ 2 = algebraMap ℚ K (d i)) (hs : ∀ i, s i ^ 2 = algebraMap ℚ F (d i))
    (hgen : Algebra.adjoin ℚ (Set.range y) = ⊤) (hdim : Module.finrank ℚ K = 2 ^ r) :
    ∃ φ : K →ₐ[ℚ] F, Function.Injective φ := by
  classical
  let yS : Finset (Fin r) → K := fun S => ∏ i ∈ S, y i
  let sS : Finset (Fin r) → F := fun S => ∏ i ∈ S, s i
  have hyS : ∀ S, yS S = ∏ i ∈ S, y i := fun S => rfl
  have hsS : ∀ S, sS S = ∏ i ∈ S, s i := fun S => rfl
  -- The multiplication rule for the monomials, in `K` and in `F`.
  have hprodK : ∀ S T, yS S * yS T =
      algebraMap ℚ K (∏ i ∈ S ∩ T, d i) * yS (symmDiff S T) := by
    intro S T
    rw [hyS]
    exact prod_monomial_mul d y hy S T
  have hprodF : ∀ S T, sS S * sS T =
      algebraMap ℚ F (∏ i ∈ S ∩ T, d i) * sS (symmDiff S T) := by
    intro S T
    rw [hsS]
    exact prod_monomial_mul d s hs S T
  -- `K` is generated by the monomials.
  have hsub : Set.range y ⊆ Set.range yS := by
    rintro _ ⟨i, rfl⟩
    exact ⟨{i}, by simp [yS]⟩
  have hadj : Algebra.adjoin ℚ (Set.range yS) = ⊤ := by
    apply top_le_iff.mp
    rw [← hgen]
    exact Algebra.adjoin_mono hsub
  -- Hence the monomials span `K` over `ℚ`.
  have hspan : ⊤ ≤ Submodule.span ℚ (Set.range yS) := by
    have h1M : (1 : K) ∈ Submodule.span ℚ (Set.range yS) :=
      Submodule.subset_span ⟨∅, by simp [yS]⟩
    have hMmul : Submodule.span ℚ (Set.range yS) * Submodule.span ℚ (Set.range yS)
        ≤ Submodule.span ℚ (Set.range yS) := by
      rw [Submodule.span_mul_span]
      apply Submodule.span_le.mpr
      rintro z ⟨a, ⟨S, rfl⟩, b, ⟨T, rfl⟩, rfl⟩
      change yS S * yS T ∈ Submodule.span ℚ (Set.range yS)
      rw [hprodK S T, ← Algebra.smul_def]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨symmDiff S T, rfl⟩)
    have hclos : (↑(Submonoid.closure (Set.range yS)) : Set K) ⊆
        Submodule.span ℚ (Set.range yS) := by
      intro z hz
      exact Submonoid.closure_induction
        (motive := fun x _ => x ∈ Submodule.span ℚ (Set.range yS))
        (fun x hx => Submodule.subset_span hx) h1M
        (fun x' y' _ _ ihx ihy => hMmul (Submodule.mul_mem_mul ihx ihy)) hz
    have hle : Submodule.span ℚ (↑(Submonoid.closure (Set.range yS)) : Set K)
        ≤ Submodule.span ℚ (Set.range yS) := Submodule.span_le.mpr hclos
    rw [← Algebra.adjoin_eq_span] at hle
    rw [hadj] at hle
    exact hle
  -- Since the number of monomials equals `[K : ℚ]`, they form a basis.
  have hcard : Fintype.card (Finset (Fin r)) = Module.finrank ℚ K := by
    rw [Fintype.card_finset, Fintype.card_fin, hdim]
  let b : Module.Basis (Finset (Fin r)) ℚ K := basisOfTopLeSpanOfCardEqFinrank yS hspan hcard
  have hbS : ∀ S, b S = yS S := fun S => Module.Basis.mk_apply _ _ S
  -- The linear map sending the basis to the corresponding products of `s i`.
  let φlin : K →ₗ[ℚ] F := b.constr ℚ sS
  have hφS : ∀ S, φlin (yS S) = sS S := by
    intro S
    rw [← hbS S]
    exact Module.Basis.constr_basis b ℚ sS S
  have hsmul : ∀ (c : ℚ) (z : K),
      φlin (algebraMap ℚ K c * z) = algebraMap ℚ F c * φlin z := by
    intro c z
    rw [← Algebra.smul_def (R := ℚ) c z, LinearMap.map_smul, Algebra.smul_def (R := ℚ) c (φlin z)]
  -- Multiplicativity on basis vectors.
  have key : ∀ S T, φlin (yS S * yS T) = φlin (yS S) * φlin (yS T) := by
    intro S T
    rw [hprodK S T, hsmul (∏ i ∈ S ∩ T, d i) (yS (symmDiff S T)),
        hφS S, hφS T, hprodF S T, ← hφS (symmDiff S T)]
  -- Extend multiplicativity over the first variable, then over the second.
  have hA : ∀ x (T : Finset (Fin r)), φlin (x * yS T) = φlin x * φlin (yS T) := by
    intro x T
    have heq : φlin.comp (LinearMap.mulRight ℚ (yS T))
        = (LinearMap.mulRight ℚ (φlin (yS T))).comp φlin := by
      apply Module.Basis.ext b
      intro S
      simp only [LinearMap.comp_apply, LinearMap.mulRight_apply]
      rw [hbS S]
      exact key S T
    exact congrArg (fun f : K →ₗ[ℚ] F => f x) heq
  have hB : ∀ x y : K, φlin (x * y) = φlin x * φlin y := by
    intro x y
    have heq : φlin.comp (LinearMap.mulRight ℚ y)
        = (LinearMap.mulRight ℚ (φlin y)).comp φlin := by
      apply Module.Basis.ext b
      intro T
      simp only [LinearMap.comp_apply, LinearMap.mulRight_apply]
      rw [hbS T, mul_comm (yS T) y, mul_comm (φlin (yS T)) (φlin y)]
      exact hA y T
    exact congrArg (fun f : K →ₗ[ℚ] F => f x) heq
  have h1 : φlin 1 = 1 := by
    have h10 : (1 : K) = yS ∅ := by simp [yS]
    rw [h10, hφS]
    simp [sS]
  let φ : K →ₐ[ℚ] F := AlgHom.ofLinearMap φlin h1 hB
  exact ⟨φ, RingHom.injective φ.toRingHom⟩

end NK.Chebotarev
