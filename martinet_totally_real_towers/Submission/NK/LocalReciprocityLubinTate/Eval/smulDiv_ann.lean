/-
# The annihilator of a Lubin–Tate torsion point

This file computes, for a **primitive** torsion point `x ∈ Λ_n ∖ Λ_{n-1}` of the standard
Lubin–Tate group of a uniformiser `π`, the annihilator of `x` under the `𝒪[F]`-action of
`Eval/TorsionAction.lean`:

  `{a ∈ 𝒪[F] : a · x = 0} = (π^n)`.

This is the first half of Milne, *Classical Field Theory*, Theorem I.3.1 (the statement that `Λ_n`
is a free `𝒪[F]/π^n`-module of rank one) — the half that only needs the *polynomial* structure of
the action and the fact that `𝒪[F]` is a discrete valuation ring, not the group law.

## The proof

Write `f(T) = πT + T^q` for the standard Lubin–Tate series.  The bridge
`smulDiv_pi_pow` (`Eval/smulDiv_mem.lean`) evaluates the `π^m`-powers of the action:

  `π^m · x = f^{(m)}(x)`,

so for `m ≤ n`, `π^m · x = 0` if and only if `x ∈ Λ_m` (and if `m < n` this contradicts the
primitivity of `x`).  Writing an arbitrary `a ≠ 0` as `a = u π^j` with `u` a unit
(`IsDiscreteValuationRing.eq_unit_mul_pow_irreducible`) and using `a · x = u · (π^j · x)`
(`smulDiv_smul2`) together with the injectivity of the action of a *unit* on `Λ_n` (which is
`smulDiv_one` + `smulDiv_smul2`), one gets `a · x = 0 ⟹ x ∈ Λ_j ⟹ n ≤ j ⟹ a ∈ (π^n)`.

## Main results

* `NK.LocalReciprocityLubinTate.Eval.smulDiv_congr`;
* `NK.LocalReciprocityLubinTate.Eval.smulDiv_zero`;
* `NK.LocalReciprocityLubinTate.Eval.smulDiv_unit_eq_zero`;
* `NK.LocalReciprocityLubinTate.Eval.smulDiv_eq_zero_iff`.
-/
import Mathlib
import Submission.NK.LocalReciprocityLubinTate.Eval.smulDiv_mem
import Submission.NK.LocalReciprocityLubinTate.Eval.smulDiv_one
import Submission.NK.LocalReciprocityLubinTate.Eval.smulDiv_smul2
import Submission.NK.LocalReciprocityLubinTate.LubinTate.TorsionCardinality
import Submission.NK.LocalReciprocityLubinTate.Audit.natCard_quotient_maximalIdeal_pow

open scoped ValuativeRel
open Polynomial MvPowerSeries

namespace NK.LocalReciprocityLubinTate.Eval

set_option linter.style.haveILetI false

universe u

variable {F : Type u} [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

/-! ### The point `0` and congruence of points -/

/-- **Every `[a]` is divisible by `X`.**  The `a`-multiplication series of a Lubin–Tate module has
zero constant coefficient (`Eval.actionTau_add.constantCoeff_action`). -/
theorem action_eq_X_mul {F : Type u} [Field F] [ValuativeRel F] (π : O F) (q : ℕ)
    (M : LubinTateModule (O F) π q) (a : O F) :
    ∃ Ψ : MvPowerSeries (Fin 1) (O F), M.action a = MvPowerSeries.X 0 * Ψ := by
  have h0 : MvPowerSeries.constantCoeff (M.action a) = 0 := by
    have h := M.action_linear a 0 (by simp [Finsupp.degree])
    simp only [MvPowerSeries.coeff_zero_eq_constantCoeff_apply, map_mul,
      MvPowerSeries.constantCoeff_C, MvPowerSeries.constantCoeff_X] at h
    simpa using h
  have hdvd : (MvPowerSeries.X (0 : Fin 1)) ∣ M.action a := by
    rw [MvPowerSeries.X_dvd_iff]
    intro m hm
    have hm0 : m = 0 := Finsupp.ext fun i => by
      fin_cases i
      simpa using hm
    rw [hm0, MvPowerSeries.coeff_zero_eq_constantCoeff_apply, h0]
  obtain ⟨Ψ, hΨ⟩ := hdvd
  exact ⟨Ψ, hΨ⟩

/-- **The action on the zero torsion point is zero**: `a · 0 = 0`.  Indeed `[a] = X · Ψ`
(`action_eq_X_mul`), so that `[a]` evaluated at `τ` lies in the ideal generated by `τ`, which the
evaluation `evMap` at `0` kills. -/
theorem actionTau_mem_span_tau (π : O F) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (M : LubinTateModule (O F) π q) (a : O F) :
    actionTau π hπ q n hq M a ∈ Ideal.span {LTtorsionRing.tau π q n} := by
  obtain ⟨Ψ, hΨ⟩ := action_eq_X_mul π q M a
  rw [actionTau, hΨ, map_mul, evalTau_X]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (Set.mem_singleton _))

/-- The zero element is in `Λ_n`: `Λ_0 = {0}` and the division sets are nested. -/
theorem zero_mem_LTdivisionSet (π : O F) (q n : ℕ) (hq : 2 ≤ q) :
    (0 : AlgebraicClosure F) ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n := by
  refine NK.LocalReciprocityLubinTate.LTdivisionSet_mono F (π : F) q hq (Nat.zero_le n) ?_
  rw [NK.LocalReciprocityLubinTate.LTdivisionSet_zero]
  exact rfl

/-- **The action on the zero point is zero**, `a · 0 = 0`: for a torsion point `z`, the point
`smulDiv π hπ q n hq M hz a = evMap z ([a]_n)` vanishes at `z = 0` because `[a]_n` is divisible by
`τ` and `evMap 0` kills `τ`. -/
theorem smulDiv_zero (π : O F) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (M : LubinTateModule (O F) π q)
    (a : O F) :
    smulDiv π hπ q n hq M (zero_mem_LTdivisionSet (F := F) π q n hq) a = 0 := by
  show evMap π q n hq 0 (zero_mem_LTdivisionSet (F := F) π q n hq)
    (actionTau π hπ q n hq M a) = 0
  have hmem := actionTau_mem_span_tau π hπ q n hq M a
  rw [Ideal.mem_span_singleton] at hmem
  obtain ⟨w, hw⟩ := hmem
  rw [hw, map_mul, evMap_tau, zero_mul]

/-- **Points are equal when the underlying elements are**: `smulDiv` only depends on the point, not
on the proof that it lies in `Λ_n`. -/
theorem smulDiv_congr (π : O F) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (M : LubinTateModule (O F) π q) {x y : AlgebraicClosure F}
    (hx : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n)
    (hy : y ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n) (h : x = y)
    (a : O F) :
    smulDiv π hπ q n hq M hx a = smulDiv π hπ q n hq M hy a := by
  subst h
  exact congrArg (fun hh : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n =>
    smulDiv π hπ q n hq M hh a) (Subsingleton.elim hx hy)

/-! ### The action of units is injective -/

/-- **A unit acts injectively on the torsion points**: if `u · z = 0` for a unit `u ∈ 𝒪[F]ˣ` and
`z ∈ Λ_n`, then `z = 0`.  Indeed `u⁻¹ · (u · z) = z` by `smulDiv_smul2` and `smulDiv_one`, so
`u · z = 0` gives `z = 0`; the transport of the point `u · z` to `0` is `smulDiv_congr`. -/
theorem smulDiv_unit_eq_zero (π : O F) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (M : LubinTateModule (O F) π q)
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq π q)
    {z : AlgebraicClosure F}
    (hz : z ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n)
    (u : (O F)ˣ) (h : smulDiv π hπ q n hq M hz (↑u) = 0) : z = 0 := by
  have h2 := smulDiv_smul2 π hπ q n hq M hpi z hz (↑(u⁻¹)) (↑u)
  have h3 : smulDiv π hπ q n hq M
      (smulDiv_mem π hπ q n hq M hpi z hz (↑u)) (↑(u⁻¹)) = 0 := by
    rw [smulDiv_congr π hπ q n hq M _ (zero_mem_LTdivisionSet (F := F) π q n hq) h]
    exact smulDiv_zero π hπ q n hq M (↑(u⁻¹))
  rw [h3, Units.inv_mul, smulDiv_one] at h2
  exact h2.symm

/-! ### The annihilator -/

/-- **The annihilator of a primitive torsion point is `(π^n)`.**

For `x ∈ Λ_n ∖ Λ_{n-1}`, `a · x = 0` if and only if `a ∈ (π^n)`: the point `π^n · x = f^{(n)}(x)`
and `f^{(m)}(x) ≠ 0` for `m < n` because `x ∉ Λ_{n-1}`, while `a · x = u · (π^j · x)` for the
factorisation `a = u π^j` of a DVR element `a`. -/
theorem smulDiv_eq_zero_iff (π : O F) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (M : LubinTateModule (O F) π q)
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq π q)
    {x : AlgebraicClosure F}
    (hx : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n)
    (hx' : x ∉ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (n - 1))
    (hn : 1 ≤ n) (a : O F) :
    smulDiv π hπ q n hq M hx a = 0 ↔ a ∈ Ideal.span {π ^ n} := by
  constructor
  · intro h
    rcases eq_or_ne a 0 with rfl | ha0
    · exact Ideal.zero_mem _
    · obtain ⟨j, u, hu⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hπ
      -- `π^j · x = 0`, hence `x ∈ Λ_j`
      have hstep : smulDiv π hπ q n hq M hx (π ^ j) = 0 := by
        have h2 := smulDiv_smul2 π hπ q n hq M hpi x hx (↑u) (π ^ j)
        have h3 : smulDiv π hπ q n hq M
            (smulDiv_mem π hπ q n hq M hpi x hx (π ^ j)) (↑u) = 0 := by
          rw [h2, ← hu]
          exact h
        exact smulDiv_unit_eq_zero π hπ q n hq M hpi _ u h3
      -- hence `x ∈ Λ_j`
      have hxj : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q j := by
        rw [NK.LocalReciprocityLubinTate.mem_LTdivisionSet_iff (π : F) q j hq,
          ← smulDiv_pi_pow π hπ q n hq M hpi x hx j]
        exact hstep
      -- hence `n ≤ j`
      have hnj : n ≤ j := by
        by_contra hj
        push_neg at hj
        exact hx' (NK.LocalReciprocityLubinTate.LTdivisionSet_mono F (π : F) q hq
          (by omega) hxj)
      -- hence `π^n ∣ π^j ∣ a`
      rw [Ideal.mem_span_singleton]
      refine ⟨↑u * π ^ (j - n), ?_⟩
      have hpowe : π ^ n * π ^ (j - n) = π ^ j := by
        rw [← pow_add, Nat.add_sub_cancel' hnj]
      rw [hu, ← hpowe]
      ring
  · intro ha
    rw [Ideal.mem_span_singleton] at ha
    obtain ⟨c, rfl⟩ := ha
    rw [mul_comm]
    rw [← smulDiv_smul2 π hπ q n hq M hpi x hx c (π ^ n)]
    have hpown : smulDiv π hπ q n hq M hx (π ^ n) = 0 := by
      rw [smulDiv_pi_pow π hπ q n hq M hpi x hx n,
        NK.LocalReciprocityLubinTate.mem_LTdivisionSet_iff (π : F) q n hq] at *
      exact hx
    rw [smulDiv_congr π hπ q n hq M _ (zero_mem_LTdivisionSet (F := F) π q n hq) hpown,
      smulDiv_zero]

end NK.LocalReciprocityLubinTate.Eval
