import Mathlib
import Submission.NK.LocalReciprocityLubinTate.LubinTate.DivisionPoints

/-!
# The Lubin–Tate levels are Galois extensions

The `n`-th Lubin–Tate level `K_n = F(Λ_n)` is, by construction, the subfield of a fixed algebraic
closure of `F` generated by the roots of the `n`-th iterate `f^{(n)}` of the standard Lubin–Tate
polynomial `f(T) = πT + T^q`, where `Λ_n` is the set of `π^n`-division points
(`NK.LocalReciprocityLubinTate.LTdivisionSet`).

That description says exactly that `K_n` is the *splitting field* of `f^{(n)}` over `F`
(`NK.LocalReciprocityLubinTate.LTLevel`), so `K_n/F` is normal
(`Normal.of_isSplittingField`).  It is separable as well, because every algebraic extension of a
field of characteristic zero is separable.  Hence `K_n/F` is Galois
(`isGalois_iff`).  No hypothesis on `π` (in particular no irreducibility/uniformiser hypothesis,
and no coprimality of `f^{(n)}` with its derivative) is needed: only the separability consequence
of `CharZero`.
-/

universe u

namespace NK.LocalReciprocityLubinTate.LubinTate

open Polynomial

/-- **The Lubin–Tate level is the splitting field of the iterate.**

`Λ_n` is by definition the root set in the algebraic closure of the iterate `f^{(n)}`, and
`K_n = F(Λ_n)` is generated by it; since the algebraic closure splits every polynomial, `K_n` is
the splitting field of `f^{(n)}` over `F`. -/
theorem isSplittingField_LTpolyIter (F : Type u) [Field F] (π : F) (q n : ℕ) :
    IsSplittingField F ↥(LTLevel F π q n) (LTpolyIter π q n) :=
  IntermediateField.adjoin_rootSet_isSplittingField (IsAlgClosed.splits _)

/-- **The Lubin–Tate level `K_n = F(Λ_n)` is a Galois extension of `F`.**

`K_n` is the splitting field of `f^{(n)}` over `F` (`isSplittingField_LTpolyIter`), hence normal;
in characteristic zero it is moreover separable, since every algebraic extension of a field of
characteristic zero is separable.  Thus `K_n/F` is Galois. -/
theorem isGalois_LTLevel (F : Type u) [Field F] [CharZero F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : F) (q n : ℕ) (hq : 2 ≤ q) :
    IsGalois F ↥(NK.LocalReciprocityLubinTate.LTLevel F π q n) := by
  have hsplit : IsSplittingField F ↥(LTLevel F π q n) (LTpolyIter π q n) :=
    isSplittingField_LTpolyIter F π q n
  exact isGalois_iff.mpr
    ⟨inferInstance, Normal.of_isSplittingField (p := LTpolyIter π q n) (hFEp := hsplit)⟩

end NK.LocalReciprocityLubinTate.LubinTate
