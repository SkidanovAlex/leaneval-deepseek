import Mathlib
import Submission.NK.LocalReciprocityLubinTate.LubinTate.LevelSimplicity
import Submission.NK.LocalReciprocityLubinTate.LubinTate.finrank_adjoin_root_LTpolyEis
import Submission.NK.LocalReciprocityLubinTate.LubinTate.DivisionPoints
import Submission.NK.LocalReciprocityLubinTate.LubinTate.LTpolyEis_shape

namespace NK.LocalReciprocityLubinTate.LubinTate

universe u

open Polynomial

/-- **The degree of the `n`-th Lubin–Tate level under simplicity** (Milne, *CFT*, §I.3; Serre,
*Local Fields*, Ch. XV §4): if every `π^n`-division point of level `n` is contained in the field
generated by a single *primitive* division point `y ∈ Λ_n ∖ Λ_{n-1}`
(`LTLevelIsSimple F π q n`), then

`[K_n : F] = (q - 1) q ^ (n - 1)`.

Indeed such a `y` is a root of the Eisenstein factor `f^{[n-1]} = (f^{(n-2)})^{q-1} + π`, which is
monic and irreducible over `F`; hence `minpoly F y = f^{[n-1]}`, of degree `(q-1)q^{n-1}`.  By
simplicity `K_n = F(y)`, and the degree of a simple extension is the degree of the minimal
polynomial. -/
theorem finrank_LTLevel_eq_of_isSimple (F : Type u) [Field F] [CharZero F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (hn : 1 ≤ n) (h : NK.LocalReciprocityLubinTate.LTLevelIsSimple F (π : F) q n) :
    Module.finrank F ↥(NK.LocalReciprocityLubinTate.LTLevel F (π : F) q n) =
      (q - 1) * q ^ (n - 1) := by
  have hq1 : 1 ≤ q := by omega
  -- A *primitive* division point `y ∈ Λ_n ∖ Λ_{n-1}` exists, because `Λ_n` is strictly larger
  -- than `Λ_{n-1}` (`#Λ_n = q^n`, `#Λ_{n-1} = q^{n-1}`, and `n ≥ 1`).
  obtain ⟨y, hy, hpr⟩ : ∃ y : AlgebraicClosure F,
      y ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n ∧
        y ∉ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (n - 1) := by
    by_contra hc
    have hsub : NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n ⊆
        NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (n - 1) := by
      intro z hz
      by_contra hz'
      exact hc ⟨z, hz, hz'⟩
    have heq : NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n =
        NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (n - 1) :=
      Set.Subset.antisymm hsub
        (NK.LocalReciprocityLubinTate.LTdivisionSet_mono F (π : F) q hq (Nat.sub_le n 1))
    have hcard : q ^ n = q ^ (n - 1) := by
      rw [← NK.LocalReciprocityLubinTate.ncard_LTdivisionSet F π hπ q n hq,
        ← NK.LocalReciprocityLubinTate.ncard_LTdivisionSet F π hπ q (n - 1) hq, heq]
    have hlt : q ^ (n - 1) < q ^ n := by
      rw [← Nat.sub_add_cancel hn]
      exact Nat.pow_lt_pow_succ (by omega)
    omega
  -- `y` is a root of the Eisenstein factor `f^{[n-1]}`: `f^{(n)} = f^{[n-1]} · f^{(n-1)}` and
  -- `y` is not a root of `f^{(n-1)}`.
  have hfac : LTpolyIter (π : F) q n =
      LTpolyEis (π : F) q (n - 1) * LTpolyIter (π : F) q (n - 1) := by
    conv_lhs => rw [← Nat.sub_add_cancel hn]
    exact NK.LocalReciprocityLubinTate.LTpolyIter_succ_eq_mul (π : F) q (n - 1) hq1
  have hEr : (aeval y) (LTpolyEis (π : F) q (n - 1)) = 0 := by
    have hy0 : (aeval y) (LTpolyIter (π : F) q n) = 0 :=
      (NK.LocalReciprocityLubinTate.mem_LTdivisionSet_iff (π : F) q n hq).mp hy
    have hyne : (aeval y) (LTpolyIter (π : F) q (n - 1)) ≠ 0 := fun hz =>
      hpr ((NK.LocalReciprocityLubinTate.mem_LTdivisionSet_iff (π : F) q (n - 1) hq).mpr hz)
    have hprod : (aeval y) (LTpolyEis (π : F) q (n - 1)) *
        (aeval y) (LTpolyIter (π : F) q (n - 1)) = 0 := by
      have hz : (aeval y) (LTpolyEis (π : F) q (n - 1) * LTpolyIter (π : F) q (n - 1)) = 0 := by
        rw [← hfac, hy0]
      rwa [map_mul] at hz
    rcases mul_eq_zero.mp hprod with h1 | h1
    · exact h1
    · exact absurd h1 hyne
  -- `f^{[n-1]}` is monic and irreducible, so it is the minimal polynomial of `y`.
  have hirr : Irreducible (LTpolyEis (π : F) q (n - 1)) :=
    NK.LocalReciprocityLubinTate.irreducible_LTpolyEis F π hπ q (n - 1) hq
  have hmonic : (LTpolyEis (π : F) q (n - 1)).Monic :=
    (LTpolyEis_shape (π : F) q (n - 1) hq).1
  have hnat : (LTpolyEis (π : F) q (n - 1)).natDegree = (q - 1) * q ^ (n - 1) :=
    (LTpolyEis_shape (π : F) q (n - 1) hq).2.1
  have hmin : minpoly F y = LTpolyEis (π : F) q (n - 1) :=
    (minpoly.eq_of_irreducible_of_monic hirr hEr hmonic).symm
  -- Simplicity turns the level into the simple extension `F(y)`, whose degree is
  -- `deg (minpoly F y) = (q-1)q^{n-1}`.
  have hlevel : NK.LocalReciprocityLubinTate.LTLevel F (π : F) q n =
      IntermediateField.adjoin F ({y} : Set (AlgebraicClosure F)) :=
    NK.LocalReciprocityLubinTate.LTLevel_eq_adjoin_singleton_of_isSimple h hy hpr
  have hint : IsIntegral F y := Algebra.IsIntegral.isIntegral y
  rw [hlevel, IntermediateField.adjoin.finrank hint, hmin, hnat]

end NK.LocalReciprocityLubinTate.LubinTate
