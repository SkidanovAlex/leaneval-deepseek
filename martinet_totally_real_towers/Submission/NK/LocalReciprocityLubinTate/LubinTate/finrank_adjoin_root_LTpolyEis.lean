import Mathlib
import Submission.NK.LocalReciprocityLubinTate.LubinTate.DivisionPoints

/-!
# The degree of the field generated by a root of the Eisenstein factor `f^{[n]}`

Milne, *CFT*, §I.3.  For the standard Lubin–Tate polynomial `f(T) = πT + T^q` over a
nonarchimedean local field `F`, the `n`-th Eisenstein factor

`f^{[n]}(T) = f^{(n-1)}(T)^{q-1} + π`

is monic of degree `(q-1) q^(n-1)` (the shape of `f^{(n)}` is
`f^{(n)}(T) = π^n T + ⋯ + T^{q^n}`, so its `(q-1)`-st power has degree `(q-1) q^n`, dominating the
constant term `π`) and irreducible over `F`
(`NK.LocalReciprocityLubinTate.LubinTate.irreducible_LTpolyEis`).  A root `x` of `f^{[n]}` is
therefore a conjugate of a *primitive* `π^{n+1}`-division point, its minimal polynomial over `F` is
`f^{[n]}`, and

`[F(x) : F] = deg f^{[n]} = (q - 1) q^n`.

This is the degree half of Milne I.3.1 for the `n`-th level of the Lubin–Tate tower.

## Main result

* `NK.LocalReciprocityLubinTate.LubinTate.finrank_adjoin_root_LTpolyEis`
-/

namespace NK.LocalReciprocityLubinTate.LubinTate

universe u

open Polynomial

/-- **A root of the `n`-th Eisenstein factor generates an extension of degree `(q-1)q^n`**
(Milne, *CFT*, §I.3): `f^{[n]}` is monic of degree `(q-1)q^n` and irreducible over `F`, so it is
the minimal polynomial of any of its roots `x`, and `[F(x) : F] = (q-1)q^n`. -/
theorem finrank_adjoin_root_LTpolyEis (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π)
    (q n : ℕ) (hq : 2 ≤ q) {x : AlgebraicClosure F}
    (hx : (Polynomial.aeval x) (NK.LocalReciprocityLubinTate.LTpolyEis (π : F) q n) = 0) :
    Module.finrank F ↥(IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F)))
      = (q - 1) * q ^ n := by
  -- the uniformiser stays nonzero in the fraction field
  have hπF : (π : F) ≠ 0 := fun h => hπ.ne_zero (Subtype.coe_injective (by simpa using h))
  -- the iterate `f^{(n)}` is monic of degree `q^n`, hence so is its `(q-1)`-st power
  obtain ⟨hGmonic, hGnat, -, -⟩ := LTpolyIter_monic_degree (π : F) q n hq
  have hpowmonic : ((LTpolyIter (π : F) q n) ^ (q - 1)).Monic := hGmonic.pow _
  have hpowdeg : ((LTpolyIter (π : F) q n) ^ (q - 1)).natDegree = (q - 1) * q ^ n := by
    rw [natDegree_pow, hGnat]
  have hdegpos : 0 < (q - 1) * q ^ n := Nat.mul_pos (by omega) (pow_pos (by omega) n)
  -- the constant term `π` is of strictly smaller degree, so it does not affect the top
  have hlt : (Polynomial.C (π : F)).degree < ((LTpolyIter (π : F) q n) ^ (q - 1)).degree := by
    rw [Polynomial.degree_C hπF, degree_eq_natDegree hpowmonic.ne_zero, hpowdeg]
    exact_mod_cast hdegpos
  -- hence `f^{[n]}` is monic of degree `(q-1)q^n`
  have hmonic : (LTpolyEis (π : F) q n).Monic := hpowmonic.add_of_left hlt
  have hnat : (LTpolyEis (π : F) q n).natDegree = (q - 1) * q ^ n := by
    rw [LTpolyEis, natDegree_add_eq_left_of_degree_lt hlt, hpowdeg]
  -- and it is irreducible over `F` (it is Eisenstein at `π`)
  have hirr : Irreducible (LTpolyEis (π : F) q n) :=
    NK.LocalReciprocityLubinTate.irreducible_LTpolyEis F π hπ q n hq
  -- so it is the minimal polynomial of its root `x`
  have hmin : LTpolyEis (π : F) q n = minpoly F x :=
    minpoly.eq_of_irreducible_of_monic hirr hx hmonic
  -- and the degree of the simple extension is the degree of the minimal polynomial
  have hint : IsIntegral F x := Algebra.IsIntegral.isIntegral x
  calc Module.finrank F ↥(IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F)))
      = (minpoly F x).natDegree := IntermediateField.adjoin.finrank hint
    _ = (q - 1) * q ^ n := by rw [← hmin, hnat]

end NK.LocalReciprocityLubinTate.LubinTate
