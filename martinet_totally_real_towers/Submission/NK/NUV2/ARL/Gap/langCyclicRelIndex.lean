import Mathlib
import Submission.NK.NUV2.ARL.GapDefs
import Submission.NK.GlobalCFTdeep.SecondInequalitySolvable
import Submission.NK.Existence.congruenceUnits_le_normImage
import Submission.NK.CFTLib.ArtinReciprocityIdeal.indexIdealCoprimeLeNormClassIndex
import Submission.NK.CFTLib.ARL.RelNormFI
import Submission.NK.CFTLib.ARL.IdeleCongruenceLift

/-!
# Lang's cyclic norm index inequality (Lang, ANT, Ch. VII §4 Thm 8 / Ch. X §2)

For a finite cyclic extension `L/K` of number fields and a modulus `m > 0` which is divisible by
every prime ramified in `L/K` and is *admissible*, the subgroup `P(m)·𝔑(m) ≤ I(m)` generated by
the principal ray and the relative norms satisfies `[L : K] ≤ [I(m) : P(m)·𝔑(m)]`.

The proof is the idèle–ideal dictionary:

* `P(m) ≤ I(m)` and `𝔑(m) ≤ I(m)`;
* the congruence units of level `m` (idèles `≡ 1 mod m` at the primes dividing `(m)`, positive at
  the real places and local units at every finite place) are idèlic norms (admissibility at
  `𝔭 | (m)`, unramifiedness at `𝔭 ∤ (m)`, positivity at the archimedean places, and the
  local–global principle for norms of idèles, `NK.Existence.congruenceUnits_le_normImage`);
* consequently the map `θ : 𝕀 K →* I(m)/(P(m)·𝔑(m))` which sends an idèle `x` to the class of the
  ideal of `x·b` — where `b` adjusts `x` into the congruence subgroup — has kernel exactly
  `Kˣ·N_{L/K}𝕀 L`, so that
  `[I(m) : P(m)·𝔑(m)] = [𝕀 K : Kˣ·N_{L/K}𝕀 L] = [C_K : N_{L/K}C_L] = [L : K]`,
  the last equality being the unconditional index theorem for cyclic extensions.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace NK.NUV2.ARL.Gap

open NK.CFTLib.ArtinReciprocityIdeal
open NK.GlobalCFT

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L]

/-! ## 1.  The principal ray and the norm group are contained in `I(m)` -/

/-- **The relative norm of an ideal prime to `(m)` is prime to `(m)`.**  The exponent of a prime
`𝔭 ∋ (m)` of `K` in `N_{L/K}𝔅` is `∑_{𝔮 | 𝔭} f(𝔮/𝔭)·v_𝔮(𝔅)`, and every prime `𝔮 | 𝔭` also
divides `(m)`, so every term vanishes. -/
theorem relNormUnit_mem_Icoprime (m : ℕ)
    {A : (FractionalIdeal (𝓞 L)⁰ L)ˣ} (hA : A ∈ NK.CFTLib.ARL.Icoprime L m) :
    NK.CFTLib.ARL.relNormUnit (K := K) (L := L) A ∈ NK.CFTLib.ARL.Icoprime K m := by
  rw [NK.CFTLib.ARL.mem_Icoprime] at hA ⊢
  intro 𝔭 h𝔭
  have hval : ((NK.CFTLib.ARL.relNormUnit (K := K) (L := L) A :
      (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K)
      = NK.CFTLib.ARL.relNormFI (K := K) (L := L) (A : FractionalIdeal (𝓞 L)⁰ L) := rfl
  rw [hval, NK.CFTLib.ARL.count_relNormFI, NK.CFTLib.ARL.relNormExp]
  refine Finset.sum_eq_zero fun q hq => ?_
  have hmq : (m : 𝓞 L) ∈ q.asIdeal := by
    have hlies : q.asIdeal.LiesOver 𝔭.asIdeal := (Place.mem_primesOverFinite (K := K) (L := L)).mp hq
    have h := (Ideal.mem_of_liesOver q.asIdeal 𝔭.asIdeal (m : 𝓞 K)).mp h𝔭
    simpa using h
  rw [hA q hmq, mul_zero]

/-- A commutativity computation in a commutative group. -/
theorem mul_div_cancel_of_comm {G : Type*} [CommGroup G] (a b : G) : a * b / a = b := by
  rw [div_eq_mul_inv, mul_assoc, mul_comm b a⁻¹, ← mul_assoc, mul_inv_cancel, one_mul]

/-- The relative norm homomorphism on the unit of an integral ideal is the unit of the relative
norm ideal. -/
theorem relNormUnit_idealUnit_eq (𝔅 : Ideal (𝓞 L)) (h𝔅 : 𝔅 ≠ ⊥)
    (h : ((Ideal.relNorm (𝓞 K) 𝔅 : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K) ≠ 0) :
    NK.CFTLib.ARL.relNormUnit (K := K) (L := L) (idealUnit (K := L) 𝔅 h𝔅)
      = Units.mk0 ((Ideal.relNorm (𝓞 K) 𝔅 : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K) h := by
  refine Units.ext ?_
  rw [NK.CFTLib.ARL.relNormUnit]
  simp only [MonoidHom.coe_mk, OneHom.coe_mk, Units.val_mk0, idealUnit]
  rw [NK.CFTLib.ARL.relNormFI_coeIdeal (K := K) (L := L) 𝔅 h𝔅]

/-- A generator of the norm group is prime to `(m)`. -/
theorem relNorm_idealUnit_mem_Icoprime (m : ℕ) {I : Ideal (𝓞 L)} (hI : I ≠ ⊥)
    (hcop : ∀ 𝔭 : HeightOneSpectrum (𝓞 L), (m : 𝓞 L) ∈ 𝔭.asIdeal → ¬ 𝔭.asIdeal ∣ I) :
    idealUnit (K := K) (Ideal.relNorm (𝓞 K) I) (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h))
      ∈ NK.CFTLib.ARL.Icoprime K m := by
  rw [NK.CFTLib.ARL.mem_Icoprime]
  intro 𝔭 h𝔭
  show FractionalIdeal.count K 𝔭 ((Ideal.relNorm (𝓞 K) I : Ideal (𝓞 K)) :
    FractionalIdeal (𝓞 K)⁰ K) = 0
  rw [← NK.CFTLib.ARL.relNormFI_coeIdeal (K := K) (L := L) I hI,
      NK.CFTLib.ARL.count_relNormFI, NK.CFTLib.ARL.relNormExp]
  refine Finset.sum_eq_zero fun q hq => ?_
  have hmq : (m : 𝓞 L) ∈ q.asIdeal := by
    have hlies : q.asIdeal.LiesOver 𝔭.asIdeal := (Place.mem_primesOverFinite (K := K) (L := L)).mp hq
    have h := (Ideal.mem_of_liesOver q.asIdeal 𝔭.asIdeal (m : 𝓞 K)).mp h𝔭
    simpa using h
  have h0 : FractionalIdeal.count L q (I : FractionalIdeal (𝓞 L)⁰ L) = 0 := by
    by_contra hc
    exact hcop q hmq ((count_ne_zero_iff_dvd (K := L) hI q).mp hc)
  rw [h0, mul_zero]

/-- **The norm group `𝔑(m)` lies in `I(m)`.** -/
theorem normIdeals_le_Icoprime (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (m : ℕ) :
    NK.CFTLib.ARL.normIdeals K L m ≤ NK.CFTLib.ARL.Icoprime K m := by
  rw [NK.CFTLib.ARL.normIdeals, Subgroup.closure_le]
  rintro A ⟨𝔅, rfl⟩
  exact relNorm_idealUnit_mem_Icoprime (K := K) (L := L) m 𝔅.2.1 𝔅.2.2

/-- **The principal ray `P(m)` lies in `I(m)`.** -/
theorem principalRay_le_Icoprime (K : Type) [Field K] [NumberField K] (m : ℕ) :
    NK.CFTLib.ARL.principalRay K m ≤ NK.CFTLib.ARL.Icoprime K m := by
  rw [NK.CFTLib.ARL.principalRay]
  intro A hA
  obtain ⟨γ, hγ, rfl⟩ := Subgroup.mem_map.mp hA
  rw [← NK.CFTLib.ARL.idealOfUnitHom_principalIdele]
  exact mem_Icoprime_of_mem_congruence (Subgroup.mem_comap.mp hγ)

/-- **The containment `P(m) ≤ I(m)`** in the vocabulary of `LangDefs`. -/
theorem principalRay_le_idealCoprimeGroup (K : Type) [Field K] [NumberField K] (m : ℕ) :
    principalRay K m ≤ idealCoprimeGroup K m := by
  rw [principalRay_eq_ARL, idealCoprimeGroup_eq_Icoprime]
  exact principalRay_le_Icoprime K m

/-- **The containment `𝔑(m) ≤ I(m)`** in the vocabulary of `LangDefs`. -/
theorem normRay_le_idealCoprimeGroup (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] (m : ℕ) :
    normRay K L m ≤ idealCoprimeGroup K m := by
  rw [normRay_eq_normIdeals, idealCoprimeGroup_eq_Icoprime]
  exact normIdeals_le_Icoprime K L m

/-- **`P(m)·𝔑(m) ≤ I(m)`.** -/
theorem principalRay_sup_normRay_le_idealCoprimeGroup (K L : Type) [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] (m : ℕ) :
    (principalRay K m ⊔ normRay K L m) ≤ idealCoprimeGroup K m :=
  sup_le (principalRay_le_idealCoprimeGroup K m) (normRay_le_idealCoprimeGroup K L m)

/-! ## 2.  Congruence units are norms -/

/-- **The congruence units of an admissible modulus are idèlic norms.** -/
theorem congUnits_le_normImage (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (m : ℕ) (hm : 0 < m)
    (hram : ∀ p : NK.Chebotarev.PrimeIdeal K,
      ¬ IsUnramified (K := K) (L := L) p → (m : 𝓞 K) ∈ p.asIdeal)
    (hadm : IsAdmissible K L m) :
    NK.CFTLib.Arl.congruenceSubgroup K m ⊓ MonoidHom.ker (IdeleClassGroup.idealOfUnitHom K) ≤
      Idele.principalSubgroup K ⊔ Idele.normImage K L :=
  le_trans (NK.Existence.congruenceUnits_le_normImage K L m hm hram hadm) le_sup_right

/-! ## 3.  Lifting fractional ideals to congruent idèles -/

/-- A chosen lift of a fractional ideal prime to `m` to an idèle congruent to `1` modulo `m`. -/
noncomputable def idealLift (K : Type) [Field K] [NumberField K] (m : ℕ) (hm : 0 < m)
    (𝔞 : NK.CFTLib.ARL.Icoprime K m) : Idele K :=
  Classical.choose (NK.CFTLib.ARL.exists_idealOf_eq_of_mem_Icoprime (K := K) hm 𝔞)

theorem idealLift_mem (K : Type) [Field K] [NumberField K] (m : ℕ) (hm : 0 < m)
    (𝔞 : NK.CFTLib.ARL.Icoprime K m) :
    idealLift K m hm 𝔞 ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
  (Classical.choose_spec (NK.CFTLib.ARL.exists_idealOf_eq_of_mem_Icoprime (K := K) hm 𝔞)).1

theorem idealLift_ideal (K : Type) [Field K] [NumberField K] (m : ℕ) (hm : 0 < m)
    (𝔞 : NK.CFTLib.ARL.Icoprime K m) :
    IdeleClassGroup.idealOfUnitHom K (idealLift K m hm 𝔞) = (𝔞 : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
  (Classical.choose_spec (NK.CFTLib.ARL.exists_idealOf_eq_of_mem_Icoprime (K := K) hm 𝔞)).2

/-- The ideal of an idèlic norm is the relative norm of the ideal of the idèle. -/
theorem idealOfUnitHom_normIdeleHom (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] (y : Idele L) :
    IdeleClassGroup.idealOfUnitHom K (Idele.normIdeleHom K L y)
      = NK.CFTLib.ARL.relNormUnit (K := K) (L := L)
          (IdeleClassGroup.idealOfUnitHom L y) := by
  refine Units.ext ?_
  rw [NK.CFTLib.ARL.relNormUnit]
  simp only [MonoidHom.coe_mk, OneHom.coe_mk, Units.val_mk0]
  rw [IdeleClassGroup.idealOfUnitHom_apply, Units.val_mk0]
  exact NK.CFTLib.ARL.idealOf_normIdeleHom y

/-! ## 4.  The index computation -/

/-- **The lower bound for the ideal-theoretic norm index.**  If the congruence units of modulus
`m` are idèlic norms, then `[L : K] ≤ [I(m) : P(m)·𝔑(m)]`. -/
theorem finrank_le_rayNorm_relIndex (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsCyclic (L ≃ₐ[K] L)] (m : ℕ) (hm : 0 < m)
    (hW : NK.CFTLib.Arl.congruenceSubgroup K m ⊓
        MonoidHom.ker (IdeleClassGroup.idealOfUnitHom K) ≤
      Idele.principalSubgroup K ⊔ Idele.normImage K L) :
    Module.finrank K L ≤ (rayNorm K L m).relIndex (NK.CFTLib.ARL.Icoprime K m) := by
  classical
  -- ### The principal-ray generators are killed by `theta`
  have hPmem : ∀ 𝔄 ∈ NK.CFTLib.ARL.principalRay K m,
      ∀ x ∈ NK.CFTLib.Arl.congruenceSubgroup K m, IdeleClassGroup.idealOfUnitHom K x = 𝔄 →
        x ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L := by
    intro 𝔄 h𝔄 x hx hid
    obtain ⟨γ, hγ, hγeq⟩ := Subgroup.mem_map.mp h𝔄
    have hγ' : Idele.principalIdele K γ ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
      Subgroup.mem_comap.mp hγ
    have hratio : x * (Idele.principalIdele K γ)⁻¹ ∈ NK.CFTLib.Arl.congruenceSubgroup K m ⊓
        MonoidHom.ker (IdeleClassGroup.idealOfUnitHom K) := by
      have hker : IdeleClassGroup.idealOfUnitHom K (x / Idele.principalIdele K γ) = 1 := by
        rw [map_div, hid, NK.CFTLib.ARL.idealOfUnitHom_principalIdele, ← hγeq, div_eq_mul_inv, mul_inv_cancel]
      exact ⟨Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hγ'), MonoidHom.mem_ker.mpr hker⟩
    have hxA : x = (x * (Idele.principalIdele K γ)⁻¹) * Idele.principalIdele K γ := by group
    rw [hxA]
    exact Subgroup.mul_mem _ (hW hratio)
      (Subgroup.mem_sup_left (Idele.mem_principalSubgroup.mpr ⟨γ, rfl⟩))
  -- ### The norm generators are killed by `theta`
  have hNgen : ∀ (𝔅 : {I : Ideal (𝓞 L) // I ≠ ⊥ ∧
        ∀ 𝔭 : HeightOneSpectrum (𝓞 L), (m : 𝓞 L) ∈ 𝔭.asIdeal → ¬ 𝔭.asIdeal ∣ I})
      (h : ((Ideal.relNorm (𝓞 K) (𝔅 : Ideal (𝓞 L)) : Ideal (𝓞 K)) :
        FractionalIdeal (𝓞 K)⁰ K) ≠ 0),
      ∀ x ∈ NK.CFTLib.Arl.congruenceSubgroup K m,
        IdeleClassGroup.idealOfUnitHom K x
          = Units.mk0 ((Ideal.relNorm (𝓞 K) (𝔅 : Ideal (𝓞 L)) : Ideal (𝓞 K)) :
              FractionalIdeal (𝓞 K)⁰ K) h →
        x ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L := by
    intro 𝔅 h x hx hid
    have hcop : idealUnit (K := L) 𝔅.1 𝔅.2.1 ∈ NK.CFTLib.ARL.Icoprime L m := by
      rw [NK.CFTLib.ARL.mem_Icoprime]
      intro 𝔭 h𝔭
      by_contra hc
      exact 𝔅.2.2 𝔭 h𝔭 ((count_ne_zero_iff_dvd (K := L) 𝔅.2.1 𝔭).mp hc)
    set y : Idele L := idealLift L m hm ⟨idealUnit (K := L) 𝔅.1 𝔅.2.1, hcop⟩ with hydef
    have hycon : y ∈ NK.CFTLib.Arl.congruenceSubgroup L m := idealLift_mem L m hm _
    have hyid : IdeleClassGroup.idealOfUnitHom L y
        = idealUnit (K := L) 𝔅.1 𝔅.2.1 := idealLift_ideal L m hm _
    have hNycon : Idele.normIdeleHom K L y ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
      NK.CFTLib.Arl.normIdeleHom_mem_congruenceSubgroup (K := K) (L := L) m hm hycon
    have hNyid : IdeleClassGroup.idealOfUnitHom K (Idele.normIdeleHom K L y)
        = Units.mk0 ((Ideal.relNorm (𝓞 K) (𝔅 : Ideal (𝓞 L)) : Ideal (𝓞 K)) :
            FractionalIdeal (𝓞 K)⁰ K) h := by
      rw [idealOfUnitHom_normIdeleHom, hyid]
      exact relNormUnit_idealUnit_eq (K := K) (L := L) 𝔅.1 𝔅.2.1 h
    have hratio : x * (Idele.normIdeleHom K L y)⁻¹ ∈ NK.CFTLib.Arl.congruenceSubgroup K m ⊓
        MonoidHom.ker (IdeleClassGroup.idealOfUnitHom K) := by
      have hker : IdeleClassGroup.idealOfUnitHom K (x / Idele.normIdeleHom K L y) = 1 := by
        rw [map_div, hid, hNyid, div_eq_mul_inv, mul_inv_cancel]
      exact ⟨Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hNycon), MonoidHom.mem_ker.mpr hker⟩
    have hxA : x = (x * (Idele.normIdeleHom K L y)⁻¹) * Idele.normIdeleHom K L y := by group
    rw [hxA]
    refine Subgroup.mul_mem _ (hW hratio) (Subgroup.mem_sup_right ?_)
    rw [Idele.normImage_eq_map]
    exact MonoidHom.mem_range.mpr ⟨y, rfl⟩
  -- ### The closure induction over the norm group
  have keyN : ∀ 𝔄 ∈ NK.CFTLib.ARL.normIdeals K L m,
      ∀ x ∈ NK.CFTLib.Arl.congruenceSubgroup K m, IdeleClassGroup.idealOfUnitHom K x = 𝔄 →
        x ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L := by
    intro 𝔄 h𝔄
    rw [NK.CFTLib.ARL.normIdeals] at h𝔄
    refine Subgroup.closure_induction
      (p := fun g _ => ∀ x ∈ NK.CFTLib.Arl.congruenceSubgroup K m,
        IdeleClassGroup.idealOfUnitHom K x = g →
          x ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L)
      (fun g hg => by
        obtain ⟨𝔅, rfl⟩ := hg
        exact hNgen 𝔅 _) ?_ ?_ ?_ h𝔄
    · intro x hx hid
      exact hW ⟨hx, MonoidHom.mem_ker.mpr hid⟩
    · intro 𝔄₁ 𝔄₂ h₁ h₂ ih₁ ih₂ x hx hid
      have hι : 𝔄₁ ∈ NK.CFTLib.ARL.Icoprime K m := normIdeals_le_Icoprime K L m h₁
      have hzcon : idealLift K m hm ⟨𝔄₁, hι⟩ ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
        idealLift_mem K m hm ⟨𝔄₁, hι⟩
      have hzid : IdeleClassGroup.idealOfUnitHom K (idealLift K m hm ⟨𝔄₁, hι⟩) = 𝔄₁ :=
        idealLift_ideal K m hm ⟨𝔄₁, hι⟩
      have hzA : idealLift K m hm ⟨𝔄₁, hι⟩ ∈
          Idele.principalSubgroup K ⊔ Idele.normImage K L := ih₁ _ hzcon hzid
      have hx' : x * (idealLift K m hm ⟨𝔄₁, hι⟩)⁻¹ ∈
          NK.CFTLib.Arl.congruenceSubgroup K m := Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hzcon)
      have hid' : IdeleClassGroup.idealOfUnitHom K (x / idealLift K m hm ⟨𝔄₁, hι⟩) = 𝔄₂ := by
        rw [map_div, hid, hzid]
        exact mul_div_cancel_of_comm 𝔄₁ 𝔄₂
      have hxA : x = (x * (idealLift K m hm ⟨𝔄₁, hι⟩)⁻¹) * idealLift K m hm ⟨𝔄₁, hι⟩ := by group
      rw [hxA]
      exact Subgroup.mul_mem _ (ih₂ _ hx' hid') hzA
    · intro 𝔄₁ h₁ ih x hx hid
      have hmem : x⁻¹ ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L :=
        ih x⁻¹ (Subgroup.inv_mem _ hx) (by rw [map_inv, hid]; simp)
      simpa using Subgroup.inv_mem _ hmem
  -- ### The generators of the ray-norm group are killed by `theta`
  have key : ∀ 𝔄 ∈ NK.CFTLib.ArtinReciprocityIdeal.rayNorm K L m,
      ∀ x ∈ NK.CFTLib.Arl.congruenceSubgroup K m, IdeleClassGroup.idealOfUnitHom K x = 𝔄 →
        x ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L := by
    intro 𝔄 h𝔄 x hx hid
    rw [NK.CFTLib.ArtinReciprocityIdeal.rayNorm] at h𝔄
    obtain ⟨𝔄₁, h₁, 𝔄₂, h₂, hsum⟩ := Subgroup.mem_sup.mp h𝔄
    have hι : 𝔄₁ ∈ NK.CFTLib.ARL.Icoprime K m := principalRay_le_Icoprime K m h₁
    have hzcon : idealLift K m hm ⟨𝔄₁, hι⟩ ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
      idealLift_mem K m hm ⟨𝔄₁, hι⟩
    have hzid : IdeleClassGroup.idealOfUnitHom K (idealLift K m hm ⟨𝔄₁, hι⟩) = 𝔄₁ :=
      idealLift_ideal K m hm ⟨𝔄₁, hι⟩
    have hzA : idealLift K m hm ⟨𝔄₁, hι⟩ ∈
        Idele.principalSubgroup K ⊔ Idele.normImage K L := hPmem 𝔄₁ h₁ _ hzcon hzid
    have hx' : x * (idealLift K m hm ⟨𝔄₁, hι⟩)⁻¹ ∈
        NK.CFTLib.Arl.congruenceSubgroup K m := Subgroup.mul_mem _ hx (Subgroup.inv_mem _ hzcon)
    have hid' : IdeleClassGroup.idealOfUnitHom K (x / idealLift K m hm ⟨𝔄₁, hι⟩) = 𝔄₂ := by
      rw [map_div, hid, hzid, ← hsum]
      exact mul_div_cancel_of_comm 𝔄₁ 𝔄₂
    have hxA : x = (x * (idealLift K m hm ⟨𝔄₁, hι⟩)⁻¹) * idealLift K m hm ⟨𝔄₁, hι⟩ := by group
    rw [hxA]
    exact Subgroup.mul_mem _ (keyN 𝔄₂ h₂ _ hx' hid') hzA
  -- ### `theta` kills the principal idèles and the norms
  have hle : Idele.principalSubgroup K ⊔ Idele.normImage K L ≤
      (theta K L m hm).ker := by
    rw [sup_le_iff]
    refine ⟨?_, ?_⟩
    · intro x hx
      rw [MonoidHom.mem_ker]
      obtain ⟨α, rfl⟩ := Idele.mem_principalSubgroup.mp hx
      exact theta_principal_eq_one (K := K) (L := L) m hm α
    · intro x hx
      rw [MonoidHom.mem_ker]
      rw [Idele.normImage_eq_map, MonoidHom.mem_range] at hx
      obtain ⟨y, rfl⟩ := hx
      exact theta_norm_eq_one (K := K) (L := L) m hm y
  -- ### conversely `ker theta` lies in `Kˣ·N_{L/K}𝕀 L`
  have hker_le : (theta K L m hm).ker ≤
      Idele.principalSubgroup K ⊔ Idele.normImage K L := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx
    have hzid : IdeleClassGroup.idealOfUnitHom K
        (x * Idele.principalIdele K (adjId K m hm x))
        ∈ NK.CFTLib.ArtinReciprocityIdeal.rayNorm K L m := by
      have h := hx
      rw [theta_apply] at h
      have h' : QuotientGroup.mk' (NK.CFTLib.ArtinReciprocityIdeal.rayNorm K L m)
          (IdeleClassGroup.idealOfUnitHom K
            (x * Idele.principalIdele K (adjId K m hm x))) = 1 := h
      rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h'
    have hzA : x * Idele.principalIdele K (adjId K m hm x)
        ∈ Idele.principalSubgroup K ⊔ Idele.normImage K L :=
      key _ hzid _ (adjId_spec (K := K) m hm x) rfl
    have hxA : x = (x * Idele.principalIdele K (adjId K m hm x))
        * (Idele.principalIdele K (adjId K m hm x))⁻¹ := by group
    rw [hxA]
    exact Subgroup.mul_mem _ hzA (Subgroup.inv_mem _
      (Subgroup.mem_sup_left (Idele.mem_principalSubgroup.mpr ⟨_, rfl⟩)))
  -- ### The index computation
  have hsup_ne : (Idele.principalSubgroup K ⊔ Idele.normImage K L).index ≠ 0 := by
    rw [index_principalSubgroup_sup_normImage (K := K) (L := L) m,
      NK.GlobalCFTdeep.index_eq_finrank_of_isCyclic (K := K) (L := L)]
    exact (Module.finrank_pos (R := K) (M := L)).ne'
  haveI : (theta K L m hm).ker.FiniteIndex := by
    rw [Subgroup.finiteIndex_iff]
    intro h0
    exact hsup_ne (Nat.eq_zero_of_zero_dvd
      (h0 ▸ Subgroup.index_dvd_of_le hle))
  calc Module.finrank K L
      = (Idele.normClassSubgroup K L).index :=
        (NK.GlobalCFTdeep.index_eq_finrank_of_isCyclic (K := K) (L := L)).symm
    _ = (Idele.principalSubgroup K ⊔ Idele.normImage K L).index :=
        (index_principalSubgroup_sup_normImage (K := K) (L := L) m).symm
    _ ≤ (theta K L m hm).ker.index := Subgroup.index_antitone hker_le
    _ = ((NK.CFTLib.ArtinReciprocityIdeal.rayNorm K L m).subgroupOf
          (NK.CFTLib.ARL.Icoprime K m)).index :=
        (index_rayNorm_eq_ker_index (K := K) (L := L) m hm).symm
    _ = (NK.CFTLib.ArtinReciprocityIdeal.rayNorm K L m).relIndex
          (NK.CFTLib.ARL.Icoprime K m) := rfl

/-! ## 5.  The target -/

/-- **Lang's cyclic norm index inequality**: for a cyclic extension `L/K` of number fields, every
modulus `m > 0` which is divisible by all the primes ramified in `L/K` and admissible satisfies
`P(m)·𝔑(m) ≤ I(m)` and `[L:K] ≤ [I(m) : P(m)·𝔑(m)]`. -/
theorem langCyclicRelIndex (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)] :
    NK.NUV2.ARL.CyclicIndexInequality K L := by
  intro m hm hram hadm
  refine ⟨principalRay_sup_normRay_le_idealCoprimeGroup K L m, ?_⟩
  have h := finrank_le_rayNorm_relIndex K L m hm
    (congUnits_le_normImage K L m hm hram hadm)
  simpa only [principalRay_eq_ARL, normRay_eq_normIdeals, idealCoprimeGroup_eq_Icoprime, rayNorm]
    using h

end NK.NUV2.ARL.Gap
