/-!
# `Inf` is injective with range the `|G ⧸ N|`-torsion (local units, Route C, step L2)

For a finite Galois extension `L₃/L₂` of number fields, places `q₂ | q₂` and a *normal* subgroup
`N ◁ Gal(E/F)` of the local Galois group `G = Gal(E/F)` of the completions
(`F = (L₂)_{q₂}`, `E = (L₃)_{q₃}`), the inflation map

`H²(G ⧸ N, Eᴺˣ) --Inf--> H²(G, Eˣ)`

is injective and its image is the `|G ⧸ N|`-torsion subgroup of `H²(G, Eˣ)`.

Mathematically this is local class field theory together with the inflation–restriction sequence:

* `H²(Gal(E'/F'), E'ˣ)` is **cyclic of order `[E' : F']`** for every finite Galois extension of
  local fields (`≤` is the solvable dévissage, `≥` the local fundamental class, and the existence
  of a generator of order `[E' : F']` the unramified twist at level `E'`), so in particular
  `#H²(G, Eˣ) = #G` and `H²(G, Eˣ)` is cyclic;
* `H¹(N, Eˣ) = 0` (Hilbert 90 for the subgroup, `subsingleton_groupCohomology_one_res_units`), so
  `Inf` is injective and `range Inf = ker res_N`
  (`H2_inflation_injective_of_subsingleton_H1`, `H2_inflation_restriction_exact_of_subsingleton_H1`);
* `range Inf ≅ H²(G ⧸ N, Eᴺˣ)` has cardinality `[Eᴺ : F] = #(G ⧸ N)` (the additive equivalence
  `addEquiv_groupCohomology_two_quotientToInvariants_units` and `Galois.normalAutEquivQuotient`);
* `range Inf` is contained in the `#(G ⧸ N)`-torsion because `H²` of the quotient group `G ⧸ N` is
  annihilated by its order (`natCard_nsmul_H2_eq_zero`);
* in a finite cyclic group of order `m` the `n`-torsion has cardinality `n` for every `n ∣ m`
  (`natCard_ker_zsmul_id_eq`), so the two subgroups of `H²(G, Eˣ)` of cardinality `#(G ⧸ N)`, one
  contained in the other, coincide.
-/

set_option linter.style.haveILetI false

open IsDedekindDomain CategoryTheory

namespace NK.NUV2.RouteC

/-- **The `n`-torsion of a finite cyclic group of order `m` has cardinality `n`** (for `n ∣ m`).

If `A` is a finite abelian group and `u : A` has `addOrderOf u = Nat.card A` (so `A` is cyclic of
order `Nat.card A`, generated by `u`), then for every `n ∣ Nat.card A` the kernel of
multiplication by `n` on `A` has cardinality `n`.  In the proof `u` generates `A`
(`AddSubgroup.zmultiples u = ⊤` by the cardinality count), the kernel of `n` on `A` is the
`zmultiples` of `t = (m/n) • u`, and `addOrderOf t = m / gcd (m, m/n) = n`. -/
theorem natCard_ker_zsmul_id_eq {A : Type} [AddCommGroup A] [Module ℤ A]
    [Finite A] (u : A) (hu : addOrderOf u = Nat.card A) (n : ℕ) (hn : n ∣ Nat.card A) :
    Nat.card (LinearMap.ker ((n : ℤ) • (LinearMap.id : A →ₗ[ℤ] A))) = n := by
  set m := Nat.card A with hm
  haveI : Nonempty A := ⟨0⟩
  have hmpos : 0 < m := by rw [hm]; exact Nat.card_pos
  have hnpos : 0 < n := Nat.pos_of_dvd_of_pos hn hmpos
  have hcardtop : Nat.card ↥(⊤ : AddSubgroup A) = m := by
    rw [hm]; exact Nat.card_congr (Equiv.Set.univ A)
  have htop : AddSubgroup.zmultiples u = ⊤ := by
    refine AddSubgroup.eq_of_le_of_card_ge (H := AddSubgroup.zmultiples u) (K := ⊤) le_top ?_
    rw [hcardtop, Nat.card_zmultiples, hu, hm]
  have hg : ∀ x : A, x ∈ AddSubgroup.zmultiples u := by intro x; rw [htop]; trivial
  have hmu : (m : ℤ) • u = 0 := by
    have h := (addOrderOf_dvd_iff_zsmul_eq_zero (x := u) (i := (m : ℤ)))
    rw [hu, hm] at h
    exact h.mp dvd_rfl
  set q := m / n with hq
  set t : A := (q : ℤ) • u with ht
  have hnq : (n : ℤ) * (q : ℤ) = (m : ℤ) := by
    rw [← Nat.cast_mul, hq, mul_comm, Nat.div_mul_cancel hn]
  have ht_nsmul : t = q • u := by rw [ht]; simp
  have haddord : addOrderOf t = n := by
    rw [ht_nsmul, addOrderOf_nsmul, hu, hm]
    have hq_dvd : q ∣ m := ⟨n, by rw [hq, Nat.div_mul_cancel hn]⟩
    rw [Nat.gcd_eq_right hq_dvd, hq, Nat.div_div_self hn (ne_of_gt hmpos)]
  have hker_eq : (LinearMap.ker ((n : ℤ) • (LinearMap.id : A →ₗ[ℤ] A))).toAddSubgroup
      = AddSubgroup.zmultiples t := by
    ext x
    rw [Submodule.mem_toAddSubgroup, LinearMap.mem_ker, AddSubgroup.mem_zmultiples_iff]
    simp only [zsmul_eq_mul, Module.End.mul_apply, LinearMap.id_coe, id_eq,
      Module.End.intCast_apply]
    constructor
    · intro hx
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (hg x)
      rw [← hk] at hx ⊢
      rw [← mul_zsmul] at hx
      have hmcast : ((addOrderOf u : ℕ) : ℤ) = (m : ℤ) := by rw [hu, hm]
      have hdiv : (m : ℤ) ∣ (n : ℤ) * k := by
        have h := (addOrderOf_dvd_iff_zsmul_eq_zero (x := u) (i := (n : ℤ) * k)).mpr hx
        rwa [hmcast] at h
      have hqk : (q : ℤ) ∣ k := by
        have h2 : (n : ℤ) * (q : ℤ) ∣ (n : ℤ) * k := by rw [hnq]; exact hdiv
        exact (Int.mul_dvd_mul_iff_left (by exact_mod_cast (ne_of_gt hnpos))).mp h2
      obtain ⟨j, hj⟩ := hqk
      refine ⟨j, ?_⟩
      rw [ht, ← mul_zsmul, hj]
      exact congrArg (fun z : ℤ => z • u) (mul_comm j (q : ℤ))
    · intro hx
      obtain ⟨j, hj⟩ := hx
      rw [← hj]
      have hthis : (n : ℤ) * (j * (q : ℤ)) = j * (m : ℤ) := by rw [← hnq]; ring
      rw [ht, ← mul_zsmul, ← mul_zsmul, mul_assoc, hthis, mul_zsmul, hmu]
      exact zsmul_zero j
  change Nat.card ↥((LinearMap.ker ((n : ℤ) • (LinearMap.id : A →ₗ[ℤ] A))).toAddSubgroup) = n
  rw [hker_eq, Nat.card_zmultiples, haddord]

theorem inf_injective_range_eq {L₂ L₃ : Type} [Field L₂] [NumberField L₂] [Field L₃]
    [NumberField L₃] [Algebra L₂ L₃] [FiniteDimensional L₂ L₃] [IsGalois L₂ L₃]
    (q₂ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L₂))
    (q₃ : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L₃))
    (hq₃₂ : q₃.asIdeal.LiesOver q₂.asIdeal)
    (N : Subgroup (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂)) [N.Normal] :
    Function.Injective ⇑((groupCohomology.infNatTrans ℤ N 2).app
        (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom ∧
      LinearMap.range ((groupCohomology.infNatTrans ℤ N 2).app
          (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom
        = LinearMap.ker ((Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ)
            • LinearMap.id) := by
  letI : Algebra (q₂.adicCompletion L₂) (q₃.adicCompletion L₃) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap q₂ q₃ hq₃₂)
  haveI hfdE : FiniteDimensional (q₂.adicCompletion L₂) (q₃.adicCompletion L₃) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion q₂ q₃ hq₃₂
  haveI hgalE : IsGalois (q₂.adicCompletion L₂) (q₃.adicCompletion L₃) :=
    Commons.NumberTheory.NumberField.Completion.isGalois_adicCompletion q₂ q₃ hq₃₂
  haveI hfinE : Finite (groupCohomology (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂) 2) :=
    Commons.NumberTheory.NumberField.Completion.finite_groupCohomology_two_units_adicCompletion_of_isGalois
      q₂ q₃ hq₃₂
  haveI hfinG : Fintype (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) :=
    AlgEquiv.fintype (q₂.adicCompletion L₂) (q₃.adicCompletion L₃)
  -- Hilbert 90 for the subgroup `N`
  have hH1 : Subsingleton (groupCohomology
      (Rep.res N.subtype (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)) 1) :=
    Commons.NumberTheory.NumberField.Completion.subsingleton_groupCohomology_one_res_units N
  have hinj : Function.Injective ⇑((groupCohomology.infNatTrans ℤ N 2).app
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom :=
    Commons.RepresentationTheory.GroupCohomology.H2_inflation_injective_of_subsingleton_H1 N _ hH1
  -- `#H²(G, Eˣ) = #G` and cyclicity of `H²(G, Eˣ)`
  have hsolvG : Group.IsSolvable (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) :=
    NK.NUV2.LC.isSolvable_algEquiv_local q₂
  have hcardG : Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂)
      = Module.finrank (q₂.adicCompletion L₂) (q₃.adicCompletion L₃) :=
    IsGalois.card_aut_eq_finrank _ _
  have hleG := Commons.NumberTheory.NumberField.Completion.natCard_groupCohomology_two_units_le_finrank_of_solvable
    (K := L₂) (Q := q₂) (F := q₂.adicCompletion L₂) (E := q₃.adicCompletion L₃) hsolvG
  have hgeG := Commons.NumberTheory.NumberField.Completion.groupCohomology_two_units_ge_finrank
    (K := L₂) (Q := q₂) (F := q₂.adicCompletion L₂) (E := q₃.adicCompletion L₃)
  have hcardH2 : Nat.card ↥(groupCohomology
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂) 2)
      = Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) := by
    rw [hcardG]; exact le_antisymm hleG hgeG
  obtain ⟨u, hu⟩ := Commons.NumberTheory.NumberField.Completion.exists_addOrderOf_eq_finrank_groupCohomology_two_units
      (K := L₂) (Q := q₂) (F := q₂.adicCompletion L₂) (E := q₃.adicCompletion L₃)
  have hu' : addOrderOf u = Nat.card ↥(groupCohomology
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂) 2) := by
    rw [hcardH2, hcardG]; exact hu
  have hn : N.index ∣ Nat.card ↥(groupCohomology
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂) 2) := by
    rw [hcardH2]
    exact ⟨Nat.card ↥N, by rw [mul_comm, Subgroup.card_mul_index]⟩
  -- the `|G ⧸ N|`-torsion of `H²(G, Eˣ)` has cardinality `|G ⧸ N| = N.index`
  have hTcard : Nat.card ↥(LinearMap.ker ((N.index : ℤ) • LinearMap.id)) = N.index :=
    natCard_ker_zsmul_id_eq u hu' N.index hn
  -- the range of the inflation has cardinality `|G ⧸ N|`
  haveI hfdK : FiniteDimensional (q₂.adicCompletion L₂) ↥(IntermediateField.fixedField N) :=
    FiniteDimensional.of_injective
      (IntermediateField.val (IntermediateField.fixedField N)).toLinearMap
      (fun x y h => Subtype.ext h)
  haveI hgalK : IsGalois (q₂.adicCompletion L₂) ↥(IntermediateField.fixedField N) :=
    IsGalois.of_fixedField_normal_subgroup N
  have hsolvK : Group.IsSolvable (↥(IntermediateField.fixedField N) ≃ₐ[q₂.adicCompletion L₂]
      ↥(IntermediateField.fixedField N)) := NK.NUV2.LC.isSolvable_algEquiv_local q₂
  have hleK := Commons.NumberTheory.NumberField.Completion.natCard_groupCohomology_two_units_le_finrank_of_solvable
    (K := L₂) (Q := q₂) (F := q₂.adicCompletion L₂) (E := ↥(IntermediateField.fixedField N)) hsolvK
  have hgeK := Commons.NumberTheory.NumberField.Completion.groupCohomology_two_units_ge_finrank
    (K := L₂) (Q := q₂) (F := q₂.adicCompletion L₂) (E := ↥(IntermediateField.fixedField N))
  have hfinK : Module.finrank (q₂.adicCompletion L₂) ↥(IntermediateField.fixedField N)
      = Nat.card ((NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) ⧸ N) := by
    rw [← IsGalois.card_aut_eq_finrank (q₂.adicCompletion L₂) ↥(IntermediateField.fixedField N)]
    exact (Nat.card_congr (IsGalois.normalAutEquivQuotient N).toEquiv).symm
  have hcardK : Nat.card ↥(groupCohomology (Rep.ofAlgebraAutOnUnits (q₂.adicCompletion L₂)
      ↥(IntermediateField.fixedField N)) 2) = N.index := by
    rw [le_antisymm hleK hgeK, hfinK]
    rfl
  have hScard : Nat.card ↥(LinearMap.range ((groupCohomology.infNatTrans ℤ N 2).app
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom) = N.index := by
    have h1 : Nat.card ↥(groupCohomology
        ((NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂).quotientToInvariants N) 2)
        = Nat.card ↥(LinearMap.range ((groupCohomology.infNatTrans ℤ N 2).app
            (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom) :=
      Nat.card_congr (Equiv.ofInjective _ hinj)
    obtain ⟨e⟩ := Commons.NumberTheory.NumberField.Completion.addEquiv_groupCohomology_two_quotientToInvariants_units N
    have h2 : Nat.card ↥(groupCohomology
        ((NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂).quotientToInvariants N) 2)
        = Nat.card ↥(groupCohomology (Rep.ofAlgebraAutOnUnits (q₂.adicCompletion L₂)
            ↥(IntermediateField.fixedField N)) 2) := Nat.card_congr e.toEquiv
    rw [← h1, h2, hcardK]
  -- the range is contained in the torsion subgroup
  have hST : LinearMap.range ((groupCohomology.infNatTrans ℤ N 2).app
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom ≤
      LinearMap.ker ((Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ)
        • LinearMap.id) := by
    intro x hx
    rw [LinearMap.mem_range] at hx
    obtain ⟨y, rfl⟩ := hx
    rw [LinearMap.mem_ker]
    simp only [zsmul_eq_mul, Module.End.mul_apply, LinearMap.id_coe, id_eq,
      Module.End.intCast_apply]
    haveI hfinQ : Fintype ((NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) ⧸ N) :=
      Fintype.ofFinite _
    have h := Commons.RepresentationTheory.GroupCohomology.natCard_nsmul_H2_eq_zero
        ((NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂).quotientToInvariants N) y
    have hZ : (Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ) • y = 0 := by
      rw [natCast_zsmul]
      exact h
    rw [show (Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ)
          • ((groupCohomology.infNatTrans ℤ N 2).app
              (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom y
        = ((groupCohomology.infNatTrans ℤ N 2).app
              (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom
            ((Nat.card (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ) • y)
        from (map_zsmul _ _ y).symm]
    rw [hZ, map_zero]
  refine ⟨hinj, ?_⟩
  haveI hfinE2 : Finite (↑((groupCohomology.functor ℤ
      (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂) 2).obj
      (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂))) := hfinE
  refine Submodule.toAddSubgroup_injective (AddSubgroup.eq_of_le_of_card_ge ?_ ?_)
  · intro x hx
    rw [Submodule.mem_toAddSubgroup] at hx ⊢
    exact hST hx
  · exact le_of_eq ((show Nat.card ↥(LinearMap.ker ((Nat.card
        (NK.NUV2.RouteC.localGaloisGroup L₂ L₃ q₂ q₃ hq₃₂ ⧸ N) : ℤ)
        • LinearMap.id)).toAddSubgroup = N.index from hTcard).trans
      ((show Nat.card ↥(LinearMap.range ((groupCohomology.infNatTrans ℤ N 2).app
        (NK.NUV2.RouteC.localUnitsRep L₂ L₃ q₂ q₃ hq₃₂)).hom).toAddSubgroup = N.index from hScard).symm))

end NK.NUV2.RouteC
