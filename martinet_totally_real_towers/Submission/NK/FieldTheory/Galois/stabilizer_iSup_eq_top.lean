import Mathlib
import Submission.NK.Mine.Generation
import Submission.NK.FieldTheory.Galois.DecompDefs
import Submission.NK.FieldTheory.Galois.exists_mem_map_decompSubgroup
import Submission.NK.FieldTheory.Galois.iSup_decompositionSubgroup_eq_top

/-!
# The absolute Galois group of a number field is generated by its decomposition groups

Let `K` be a number field and `K'` a separable closure of `K`.  A closed subgroup `H ≤ Gal(K'/K)`
which contains the decomposition group of every place `A` of `K'` whose trace on `K` is proper is
everything.  Equivalently, the decomposition groups of the places of `K'` generate `Gal(K'/K)`.

The proof reduces to a finite level.  If `H ≠ ⊤`, closedness of `H` produces a finite Galois
intermediate field `L` and an element `x ∈ L` fixed by `H` but moved by a given `g ∉ H`.  The
image `H̄` of `H` in `Gal(L/K)` then contains the decomposition subgroup of *every* finite place
`w` of `L` (each decomposition subgroup of `K'` restricts onto a decomposition subgroup of `L`,
by surjectivity of the restriction of decomposition groups), and the decomposition subgroups of a
finite Galois extension of number fields generate the Galois group: this is
`iSup_decompositionSubgroup_eq_top` below.  Hence `g|_L ∈ H̄`, so `g|_L x = x`, a
contradiction with `g x ≠ x`.
-/

open scoped NumberField Pointwise

set_option autoImplicit false
set_option maxHeartbeats 800000
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace NK.FieldTheory.Galois

open IntermediateField

/-! ## The finite level: decomposition subgroups generate the Galois group -/

/-- **The subgroup generated by the decomposition subgroups is normal.**

The conjugate of the decomposition subgroup of a place `w` is the decomposition subgroup of the
place `g • w`, and conjugation permutes the finite places of `L`. -/
theorem normal_iSup_decompSubgroup {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    (⨆ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
      decompSubgroup (K := K) w).Normal := by
  letI : MulAction (L ≃ₐ[K] L)
      (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :=
    { smul := Submission.NeukirchUchida.Local.placeSmul
      one_smul := Submission.NeukirchUchida.Local.placeSmul_one
      mul_smul := fun a b w => Submission.NeukirchUchida.Local.placeSmul_mul a b w }
  have hEq : ∀ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L),
      decompSubgroup (K := K) w = MulAction.stabilizer (L ≃ₐ[K] L) w := fun w => rfl
  have hconj : ∀ (g : L ≃ₐ[K] L)
      (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)),
      (decompSubgroup (K := K) w).map (MulEquiv.toMonoidHom (MulAut.conj g)) =
        decompSubgroup (K := K) (g • w) := by
    intro g w
    rw [hEq w, hEq (g • w)]
    exact (MulAction.stabilizer_smul_eq_stabilizer_map_conj g w).symm
  refine Subgroup.Normal.mk fun n hn g => ?_
  have hle : (⨆ w, decompSubgroup (K := K) w).map
      (MulEquiv.toMonoidHom (MulAut.conj g)) ≤ (⨆ w, decompSubgroup (K := K) w) := by
    rw [Subgroup.map_iSup]
    refine iSup_le fun w => ?_
    rw [hconj g w]
    exact le_iSup (fun w => decompSubgroup (K := K) w) (g • w)
  exact hle (Subgroup.mem_map.mpr ⟨n, hn, MulAut.conj_apply g n⟩)

/-! ## The infinite level: generation of the absolute Galois group -/

theorem stabilizer_iSup_eq_top {K K' : Type*} [Field K] [NumberField K] [Field K']
    [Algebra K K'] [IsSepClosure K K'] (H : Subgroup Gal(K'/K)) (hH : IsClosed (H : Set Gal(K'/K)))
    (h : ∀ A : ValuationSubring K', A.comap (algebraMap K K') ≠ ⊤ →
      ∀ g : Gal(K'/K), A.comap (g : K' →+* K') = A → g ∈ H) : H = ⊤ := by
  haveI hgal : IsGalois K K' := IsSepClosure.isGalois
  rw [eq_top_iff]
  intro g _
  by_contra hg
  -- Step 1: pick `x` fixed by `H` but moved by `g`.
  have hfix : H = (IntermediateField.fixedField H).fixingSubgroup :=
    (InfiniteGalois.fixingSubgroup_fixedField (⟨H, hH⟩ : ClosedSubgroup Gal(K'/K))).symm
  have hg' : g ∉ (IntermediateField.fixedField H).fixingSubgroup := by
    rw [← hfix]
    exact hg
  obtain ⟨x, hxmem, hgx⟩ : ∃ x : K', x ∈ IntermediateField.fixedField H ∧ g x ≠ x := by
    by_contra hcon
    push Not at hcon
    exact hg'
      ((IntermediateField.mem_fixingSubgroup_iff (IntermediateField.fixedField H) g).mpr hcon)
  -- Step 2: a finite Galois intermediate field containing `x`.
  obtain ⟨L, hLfin, hLgal, hxL⟩ :=
    Commons.FieldTheory.Galois.exists_finite_galois_containing (k := K) (K := K') x
  haveI hLfinI : FiniteDimensional K L := hLfin
  haveI hLnormal : Normal K L := hLgal.to_normal
  let ρ : Gal(K'/K) →* Gal(↥L/K) := AlgEquiv.restrictNormalHom (F := K) (K₁ := K') L
  -- Step 3: the image `H̄ = ρ '' H` of `H` in `Gal(L/K)`.
  have key : ∀ h₀ : Gal(K'/K), h₀ ∈ H → ρ h₀ = ρ g → False := by
    intro h₀ hh₀ hh₀eq
    have hxfix : h₀ ((algebraMap ↥L K') ⟨x, hxL⟩) = (algebraMap ↥L K') ⟨x, hxL⟩ :=
      (IntermediateField.mem_fixedField_iff (H := H) x).mp hxmem h₀ hh₀
    have hcon := congrArg (fun (e : Gal(↥L/K)) => algebraMap ↥L K' (e ⟨x, hxL⟩)) hh₀eq
    rw [Submission.NeukirchUchida.Local.restrictNormalHom_apply_algebraMap L h₀ ⟨x, hxL⟩,
      Submission.NeukirchUchida.Local.restrictNormalHom_apply_algebraMap L g ⟨x, hxL⟩,
      hxfix] at hcon
    exact hgx hcon.symm
  have hgL : ρ g ∉ H.map ρ := fun hmem => by
    obtain ⟨h₀, hh₀, hh₀eq⟩ := Subgroup.mem_map.mp hmem
    exact key h₀ hh₀ hh₀eq
  -- Step 4: `H̄` contains every finite-level decomposition subgroup, hence is everything.
  have hgen : (⨆ w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥L),
      decompSubgroup (K := K) w) = ⊤ := iSup_decompositionSubgroup_eq_top
  have htop : H.map ρ = ⊤ := by
    refine eq_top_iff.mpr ?_
    rw [← hgen]
    refine iSup_le (fun w τ hτ => ?_)
    exact exists_mem_map_decompSubgroup (K := K) (K' := K') H h L w τ hτ
  exact hgL (htop ▸ Subgroup.mem_top (ρ g))

end NK.FieldTheory.Galois
