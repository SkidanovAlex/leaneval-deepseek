import Mathlib
import Submission.NK.TameStructureDeep.Tame.WildInertiaAux
import Submission.NK.TameStructureDeep.Tame.isProP_le_inertiaSubgroup
import Submission.NK.TameStructureDeep.Tame.isProP_correctedWildInertia

/-!
# The join of the normal pro-`p` subgroups is the wild inertia

For a number field `K`, a finite place `𝔭`, `κ = K_𝔭` and a separable closure `K'` of `κ`, let
`p = resCharAt 𝔭` be the residue characteristic,

* `V_κ = correctedWildInertia p π = Gal(K'/κ^{tr})` be the fixing subgroup of the maximal tamely
  ramified extension `κ^{tr} = κ^{ur}(π^{1/n} : (n,p) = 1)`, and
* `W_κ = wildInertiaSubgroup p = ⨆ {N ◁ G_κ : N pro-p}` be the join of the normal pro-`p`
  subgroups of `G_κ = Gal(K'/κ)`.

This file proves the classical identity `W_κ = V_κ` of NSW (7.5.7): the wild inertia *is* the
maximal normal pro-`p` subgroup, so that the group-theoretic definition (`W_κ` as a join) and the
field-theoretic one (`V_κ = Gal(K'/κ^{tr})`) agree.

The two inclusions rest on two delegated ingredients:

* `Tame.isProP_le_inertiaSubgroup`: every normal pro-`p` subgroup of `G_κ` lies in the inertia
  `I_κ = Gal(K'/κ^{ur})` (cyclotomic faithfulness, `WildInertiaAux.exists_conj_notMem_…`);
* `Tame.isProP_correctedWildInertia`: `V_κ` is pro-`p`, from the arithmetic fact that
  `κ^{ur×}/(κ^{ur×})^ℓ` is generated by the class of `π` for `ℓ ≠ p`
  (`Tame.pow_class_unramifiedClosure`).

Together with `WildInertiaAux.isProP_of_le_inertia_fixes_pow_root` (a pro-`p` subgroup of the
inertia fixes every prime-to-`p` root of `π`), the first gives `W_κ ≤ V_κ`; the second gives
`V_κ ≤ W_κ` because `V_κ` is then itself a normal pro-`p` subgroup and `W_κ` is the join of all
of them.
-/

open scoped Classical
open IntermediateField

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace NK.TameStructureDeep.Tame

noncomputable section

variable {K : Type*} [Field K] [NumberField K]
variable (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable {K' : Type*} [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']

/-- **Every normal pro-`p` subgroup of `G_κ` lies in `V_κ = Gal(K'/κ^{tr})`.**

By `isProP_le_inertiaSubgroup` such a subgroup lies in the inertia, so it fixes `κ^{ur}`, and by
`isProP_of_le_inertia_fixes_pow_root` it fixes every prime-to-`p` root of the uniformiser; these
are exactly the defining properties of `V_κ` (`mem_correctedWildInertia_of_forall`). -/
theorem isProP_le_correctedWildInertia {N : Subgroup (Gal(K'/𝔭.adicCompletion K))} (hN : N.Normal)
    (hNpro : NK.LocalTame.IsProP (NK.TameStructureDeep.Tame.resCharAt 𝔭) ↥N)
    {π : 𝔭.adicCompletionIntegers K} (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π) :
    N ≤ NK.TameStructureDeep.Tame.correctedWildInertia (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭) (π : 𝔭.adicCompletion K) := by
  have hNI : N ≤ NK.LocalAnabelian.inertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭) :=
    NK.TameStructureDeep.Tame.isProP_le_inertiaSubgroup 𝔭 hN hNpro
  intro x hx
  refine NK.TameStructureDeep.Tame.mem_correctedWildInertia_of_forall (κ := 𝔭.adicCompletion K)
    (K' := K') (p := NK.TameStructureDeep.Tame.resCharAt 𝔭)
    (NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭).ne_one x ?_ ?_
  · intro y hy
    have hxI : x ∈ NK.LocalAnabelian.inertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) := hNI hx
    rw [NK.LocalAnabelian.ResidueField.inertiaSubgroup_eq_fixingSubgroup_unramifiedClosure
      (κ := 𝔭.adicCompletion K) (K' := K') (NK.TameStructureDeep.Tame.resCharAt 𝔭)] at hxI
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp hxI y hy
  · intro n hn β hβ
    have hp : (NK.TameStructureDeep.Tame.resCharAt 𝔭).Prime :=
      NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭
    have hcop : Nat.Coprime n (NK.TameStructureDeep.Tame.resCharAt 𝔭) :=
      (Nat.Prime.coprime_iff_not_dvd hp).mpr hn |>.symm
    exact NK.TameStructureDeep.Tame.isProP_of_le_inertia_fixes_pow_root 𝔭 hNI hNpro
      (Nat.pos_of_ne_zero fun h0 => hn (by rw [h0]; exact dvd_zero _)) hcop hπ hβ hx

/-- **The join of the normal pro-`p` subgroups is contained in `V_κ`.** -/
theorem wildInertiaSubgroup_le_correctedWildInertia {π : 𝔭.adicCompletionIntegers K}
    (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π) :
    NK.LocalTame.wildInertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) ≤
      NK.TameStructureDeep.Tame.correctedWildInertia (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) (π : 𝔭.adicCompletion K) := by
  rw [NK.LocalTame.wildInertiaSubgroup]
  exact iSup_le fun N =>
    NK.TameStructureDeep.Tame.isProP_le_correctedWildInertia 𝔭 N.2.1 N.2.2 hπ

/-- **`V_κ` is contained in the join of the normal pro-`p` subgroups**, because it is itself a
normal pro-`p` subgroup: it is normal (`correctedWildInertia_normal`, from `κ^{tr}/κ` Galois) and
pro-`p` (`isProP_correctedWildInertia`). -/
theorem correctedWildInertia_le_wildInertiaSubgroup {π : 𝔭.adicCompletionIntegers K}
    (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π) :
    NK.TameStructureDeep.Tame.correctedWildInertia (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) (π : 𝔭.adicCompletion K) ≤
      NK.LocalTame.wildInertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) := by
  have hp : (NK.TameStructureDeep.Tame.resCharAt 𝔭).Prime :=
    NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭
  have hπ0 : (π : 𝔭.adicCompletion K) ≠ 0 :=
    NK.TameStructureDeep.Tame.uniformizer_ne_zero 𝔭 hπ
  haveI : (NK.TameStructureDeep.Tame.correctedWildInertia (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭) (π : 𝔭.adicCompletion K)).Normal :=
    NK.TameStructureDeep.Tame.correctedWildInertia_normal (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭) hp hπ0
  rw [NK.LocalTame.wildInertiaSubgroup]
  exact le_iSup (fun M : {M : Subgroup (Gal(K'/𝔭.adicCompletion K)) //
      M.Normal ∧ NK.LocalTame.IsProP (NK.TameStructureDeep.Tame.resCharAt 𝔭) ↥M} => M.1)
    ⟨_, inferInstance, NK.TameStructureDeep.Tame.isProP_correctedWildInertia 𝔭 hπ⟩

theorem wildInertiaSubgroup_eq_correctedWildInertia {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {π : 𝔭.adicCompletionIntegers K} (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π) :
    NK.LocalTame.wildInertiaSubgroup (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) =
      NK.TameStructureDeep.Tame.correctedWildInertia (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Tame.resCharAt 𝔭) (π : 𝔭.adicCompletion K) :=
  le_antisymm (NK.TameStructureDeep.Tame.wildInertiaSubgroup_le_correctedWildInertia 𝔭 hπ)
    (NK.TameStructureDeep.Tame.correctedWildInertia_le_wildInertiaSubgroup 𝔭 hπ)

end

end NK.TameStructureDeep.Tame
