# Every element of `κ(μ_{p'})` lies in a single `κ(ζ)`

`NK.LocalAnabelian.unramifiedClosure p` is the compositum `κ(μ_{p'})` of the fields
`κ⟮ζ⟯`, over all primitive roots of unity `ζ` of order `n` prime to `p`, inside `K'`.  The
purpose of this file is the "single generator" form of membership in that compositum:

  `exists_adjoin_primitiveRoot_of_mem_unramifiedClosure`:
  every `α ∈ κ(μ_{p'})` already lies in `κ⟮ζ⟯` for **one** primitive root of unity `ζ` of
  order `m` prime to `p`.

This is the form in which the Kummer-theoretic results of the chapter
(`irreducible_X_pow_sub_C_unramifiedClosure`, `no_pow_root_adjoin_primitiveRoot`) are
applied: an element of `κ^{ur}` is a rational function in finitely many roots of unity, and
finitely many roots of unity of prime-to-`p` order are generated by a single one.

The mathematical content is the elementary fact that a field contains, together with two
roots of unity of orders `m₁`, `m₂`, a root of unity of order `lcm m₁ m₂` generating them
both.  Mathlib's `IsPrimitiveRoot.pow_mul_pow_lcm` produces such a root out of
`ζ₁ ^ (m₁ / factorizationLCMLeft) * ζ₂ ^ (m₂ / factorizationLCMRight)`, and every root of
unity of order dividing `lcm m₁ m₂` is a power of it (`IsPrimitiveRoot.eq_pow_of_pow_eq_one`).
Hence the family `ζ ↦ κ⟮ζ⟯` is directed, and the supremum of a directed family of
intermediate fields is the union of the family (`IntermediateField.coe_iSup_of_directed`).
-/
import Mathlib
import Submission.NK.LocalAnabelian.ResidueField.Defs

open scoped Classical

set_option linter.style.haveILetI false

namespace NK.TameStructureDeep.Tame

noncomputable section

/-- **Two roots of unity generate a single one.**  Given a primitive `m₁`-th root of unity
`ζ₁` and a primitive `m₂`-th root of unity `ζ₂` (`m₁, m₂ ≠ 0`), there is a primitive
`lcm m₁ m₂`-th root of unity `ζ` such that both `κ⟮ζ₁⟯` and `κ⟮ζ₂⟯` are contained in `κ⟮ζ⟯`.

This is the "directedness" of the family of fields `κ⟮ζ⟯`: it is what makes `κ(μ_{p'})` the
union of the fields `κ⟮ζ⟯` rather than merely their compositum. -/
theorem exists_isPrimitiveRoot_lcm_adjoin_le_adjoin {κ K' : Type*} [Field κ] [Field K']
    [Algebra κ K'] {ζ₁ ζ₂ : K'} {m₁ m₂ : ℕ} (hζ₁ : IsPrimitiveRoot ζ₁ m₁)
    (hζ₂ : IsPrimitiveRoot ζ₂ m₂) (hm₁ : m₁ ≠ 0) (hm₂ : m₂ ≠ 0) :
    ∃ ζ : K', IsPrimitiveRoot ζ (m₁.lcm m₂) ∧
      IntermediateField.adjoin κ ({ζ₁} : Set K') ≤ IntermediateField.adjoin κ ({ζ} : Set K') ∧
      IntermediateField.adjoin κ ({ζ₂} : Set K') ≤ IntermediateField.adjoin κ ({ζ} : Set K') := by
  haveI : NeZero (m₁.lcm m₂) := ⟨Nat.lcm_ne_zero hm₁ hm₂⟩
  set ζ := ζ₁ ^ (m₁ / m₁.factorizationLCMLeft m₂) * ζ₂ ^ (m₂ / m₁.factorizationLCMRight m₂)
  have hζ : IsPrimitiveRoot ζ (m₁.lcm m₂) := IsPrimitiveRoot.pow_mul_pow_lcm hζ₁ hζ₂ hm₁ hm₂
  refine ⟨ζ, hζ, ?_, ?_⟩
  · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    obtain ⟨k, -, hk⟩ :=
      hζ.eq_pow_of_pow_eq_one ((hζ₁.pow_eq_one_iff_dvd _).mpr (Nat.dvd_lcm_left m₁ m₂))
    rw [← hk]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self κ ζ) k
  · rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    obtain ⟨k, -, hk⟩ :=
      hζ.eq_pow_of_pow_eq_one ((hζ₂.pow_eq_one_iff_dvd _).mpr (Nat.dvd_lcm_right m₁ m₂))
    rw [← hk]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self κ ζ) k

/-- **Membership in the unramified closure is membership in a single `κ⟮ζ⟯`.**  Every element
of `κ(μ_{p'}) = unramifiedClosure p` lies in `κ⟮ζ⟯` for some primitive root of unity `ζ` of
order `m` prime to `p`. -/
theorem exists_adjoin_primitiveRoot_of_mem_unramifiedClosure {κ K' : Type*} [Field κ] [Field K']
    [Algebra κ K'] {p : ℕ} (hp : p.Prime) {α : K'}
    (hα : α ∈ NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p) :
    ∃ (m : ℕ) (ζ : K'), ¬ p ∣ m ∧ IsPrimitiveRoot ζ m ∧
      α ∈ IntermediateField.adjoin κ ({ζ} : Set K') := by
  classical
  -- Reindex the defining double supremum by the single index type
  -- `{n // ¬ p ∣ n} × {ζ // IsPrimitiveRoot ζ n}`.
  have hclosure : NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p =
      ⨆ i : (Σ n : {n : ℕ // ¬ p ∣ n}, {ζ : K' // IsPrimitiveRoot ζ (n : ℕ)}),
        IntermediateField.adjoin κ ({i.2.1} : Set K') := by
    rw [NK.LocalAnabelian.unramifiedClosure]
    simp only [iSup_subtype', iSup_sigma']
  -- The index type is nonempty: `1` is a primitive `1`-st root of unity.
  haveI : Nonempty (Σ n : {n : ℕ // ¬ p ∣ n}, {ζ : K' // IsPrimitiveRoot ζ (n : ℕ)}) :=
    ⟨⟨⟨1, hp.not_dvd_one⟩, ⟨1, IsPrimitiveRoot.one⟩⟩⟩
  -- The family is directed: two primitive roots of order `n₁`, `n₂` are generated by a
  -- primitive root of order `lcm n₁ n₂`, which is again prime to `p`.
  have hdir : Directed (· ≤ ·)
      (fun i : (Σ n : {n : ℕ // ¬ p ∣ n}, {ζ : K' // IsPrimitiveRoot ζ (n : ℕ)}) =>
        IntermediateField.adjoin κ ({i.2.1} : Set K')) := by
    rintro ⟨⟨n₁, hn₁⟩, ⟨ζ₁, hζ₁⟩⟩ ⟨⟨n₂, hn₂⟩, ⟨ζ₂, hζ₂⟩⟩
    have hn₁' : n₁ ≠ 0 := fun h => hn₁ (h ▸ Nat.dvd_zero p)
    have hn₂' : n₂ ≠ 0 := fun h => hn₂ (h ▸ Nat.dvd_zero p)
    obtain ⟨ζ₃, hζ₃, h₁, h₂⟩ :=
      exists_isPrimitiveRoot_lcm_adjoin_le_adjoin (κ := κ) hζ₁ hζ₂ hn₁' hn₂'
    refine ⟨⟨⟨n₁.lcm n₂, ?_⟩, ⟨ζ₃, hζ₃⟩⟩, h₁, h₂⟩
    intro h
    -- `lcm n₁ n₂ ∣ n₁ * n₂`, so `p ∣ lcm n₁ n₂` would force `p ∣ n₁` or `p ∣ n₂`.
    have h1 : p ∣ n₁ * n₂ :=
      Nat.dvd_trans h (Nat.lcm_dvd (Nat.dvd_mul_right n₁ n₂) (Nat.dvd_mul_left n₂ n₁))
    rcases hp.dvd_mul.mp h1 with h2 | h2
    · exact hn₁ h2
    · exact hn₂ h2
  -- For a directed family of intermediate fields, the supremum is the union.
  rw [hclosure] at hα
  have hα' : α ∈ (↑(⨆ i : (Σ n : {n : ℕ // ¬ p ∣ n}, {ζ : K' // IsPrimitiveRoot ζ (n : ℕ)}),
      IntermediateField.adjoin κ ({i.2.1} : Set K')) : Set K') := hα
  rw [IntermediateField.coe_iSup_of_directed hdir] at hα'
  simp only [Set.mem_iUnion] at hα'
  obtain ⟨i, hi⟩ := hα'
  exact ⟨i.1.1, i.2.1, i.1.2, i.2.2, hi⟩

end

end NK.TameStructureDeep.Tame
