import Mathlib
import Submission.NK.TameStructureDeep.Tame.TameClosure
import Submission.NK.TameStructureDeep.Tame.isProPrimeToP_correctedWildInertia

open scoped Classical
open scoped Topology

namespace NK.TameStructureDeep.Tame

open IntermediateField Filter

/-- **The fixed field of a join of subgroups.**  For subgroups `H, K` of `Gal(E/F)`,
`x` is fixed by `H ⊔ K` iff it is fixed by `H` and by `K`. -/
theorem fixedField_sup_subgroup {F E : Type*} [Field F] [Field E] [Algebra F E]
    (H K : Subgroup Gal(E/F)) :
    IntermediateField.fixedField (H ⊔ K)
      = IntermediateField.fixedField H ⊓ IntermediateField.fixedField K := by
  have key : ∀ (H : Subgroup Gal(E/F)) (x : E),
      x ∈ IntermediateField.fixedField H ↔ H ≤ (IntermediateField.adjoin F {x}).fixingSubgroup := by
    intro H x
    rw [← IntermediateField.le_iff_le]
    rw [IntermediateField.adjoin_le_iff]
    simp
  ext x
  rw [IntermediateField.mem_inf, key, key, key, sup_le_iff]

/-- **The fixing subgroup of an intersection is the join of the fixing subgroups.**

For intermediate fields `T, M` of a Galois extension `K'/κ` with `M/κ` finite Galois, the subgroup
of `Gal(K'/κ)` fixing `T ⊓ M` is generated by the fixing subgroups of `T` and of `M`.  Both
subgroups are closed, and `Gal(K'/M)` is open (as `M/κ` is finite dimensional), hence the join
`T.fixingSubgroup ⊔ M.fixingSubgroup` is a neighbourhood of `1`, therefore open and closed; by the
infinite Galois correspondence (`InfiniteGalois.fixingSubgroup_fixedField`) it is the fixing
subgroup of its fixed field, which is `T ⊓ M`. -/
theorem fixingSubgroup_inf_eq_sup {κ K' : Type*} [Field κ] [Field K']
    [Algebra κ K'] [IsGalois κ K'] {T M : IntermediateField κ K'} [FiniteDimensional κ M]
    [IsGalois κ M] :
    (T.fixingSubgroup ⊔ M.fixingSubgroup : Subgroup Gal(K'/κ)) = (T ⊓ M).fixingSubgroup := by
  have hopenM : IsOpen (M.fixingSubgroup : Set Gal(K'/κ)) :=
    IntermediateField.fixingSubgroup_isOpen M
  have hmem : (M.fixingSubgroup : Set Gal(K'/κ)) ∈ 𝓝 (1 : Gal(K'/κ)) :=
    hopenM.mem_nhds (one_mem _)
  have hmem' : ((T.fixingSubgroup ⊔ M.fixingSubgroup : Subgroup Gal(K'/κ)) : Set Gal(K'/κ))
      ∈ 𝓝 (1 : Gal(K'/κ)) :=
    Filter.mem_of_superset hmem (SetLike.coe_subset_coe.mpr le_sup_right)
  have hopen : IsOpen ((T.fixingSubgroup ⊔ M.fixingSubgroup : Subgroup Gal(K'/κ)) : Set Gal(K'/κ)) :=
    Subgroup.isOpen_of_mem_nhds _ hmem'
  have hclosed : IsClosed
      ((T.fixingSubgroup ⊔ M.fixingSubgroup : Subgroup Gal(K'/κ)) : Set Gal(K'/κ)) :=
    Subgroup.isClosed_of_isOpen _ hopen
  have hfix : IntermediateField.fixedField (T.fixingSubgroup ⊔ M.fixingSubgroup) = T ⊓ M := by
    rw [fixedField_sup_subgroup, InfiniteGalois.fixedField_fixingSubgroup T,
      InfiniteGalois.fixedField_fixingSubgroup M]
  have h := InfiniteGalois.fixingSubgroup_fixedField (⟨_, hclosed⟩ : ClosedSubgroup Gal(K'/κ))
  rw [hfix] at h
  exact h.symm

/-- **The relative index of an intersection of fixing subgroups is the degree `[M : M ⊓ T]`.**

For intermediate fields `T, M` of a Galois extension `K'/κ` with `M/κ` finite dimensional **and
Galois**, the index of `T.fixingSubgroup ⊓ M.fixingSubgroup` in `T.fixingSubgroup` equals the
degree `[M : M ⊓ T]`.  Equivalently (the field-theoretic parallelogram) `[T ⊔ M : T] = [M : M ⊓ T]`.

The `IsGalois κ M` hypothesis is *necessary* (it is linear disjointness of `T` and `M` over
`T ⊓ M`): for `κ = ℚ`, `T = ℚ(∛2)`, `M = ℚ(ω∛2)` inside the splitting field of `X³ − 2` one gets
`[T ⊔ M : T] = 2` while `[M : ℚ] = 3`, so the assertion fails without it.

Route.  Write `V = T.fixingSubgroup` and `N = M.fixingSubgroup`; `M/κ` Galois makes `N` normal in
`Gal(K'/κ)`.  Then
* `(V ⊓ N).relIndex V = N.relIndex V` (`Subgroup.inf_relIndex_left`) `= [V : V ⊓ N]`;
* `N.relIndex V = N.relIndex (V ⊔ N)` (`Subgroup.relIndex_sup_right`);
* `[T ⊔ M : T] = ((T ⊔ M).fixingSubgroup).relIndex T.fixingSubgroup` by
  `IntermediateField.fixingSubgroup_sup`, and this is `(V ⊓ N).relIndex V` by
  `NK.TameStructureDeep.Tame.index_subgroupOf_fixingSubgroup`
  (in `Tame/isProPrimeToP_correctedWildInertia.lean`, applied with `U = T`, `F = T ⊔ M`);
* `[M : M ⊓ T] = ((T ⊓ M).fixingSubgroup).relIndex M.fixingSubgroup` by the same identity with
  `U = T ⊓ M`, `F = M`, and `(T ⊓ M).fixingSubgroup` is the *closure* of `V ⊔ N`; since `N` is
  open, `N.relIndex (closure (V ⊔ N)) = N.relIndex (V ⊔ N)`.

Equivalently, one may avoid the closure: the restriction `Gal((T ⊔ M)/T) → Gal(M/(M ⊓ T))` is an
isomorphism (an element fixing `T` restricts injectively to `M`, and `σ ∈ Gal(M/(M ⊓ T))` extends
to `T ⊔ M` by `t·m ↦ t·σ(m)`, well defined because `σ` fixes `T ⊓ M`), so both sides are the order
of that group. -/
theorem relIndex_inf_fixingSubgroup_eq_finrank {κ K' : Type*} [Field κ] [Field K']
    [Algebra κ K'] [IsGalois κ K'] {T M : IntermediateField κ K'} [FiniteDimensional κ M]
    [IsGalois κ M] :
    (T.fixingSubgroup ⊓ M.fixingSubgroup).relIndex T.fixingSubgroup
      = Module.finrank ↥(T ⊓ M) ↥M := by
  rw [Subgroup.inf_relIndex_left, ← Subgroup.relIndex_sup_right, fixingSubgroup_inf_eq_sup]
  exact index_subgroupOf_fixingSubgroup (inf_le_right : T ⊓ M ≤ M)

end NK.TameStructureDeep.Tame
