import Mathlib

open scoped Topology

namespace NK.RankTheoryDeep

/-- **A homomorphism into `ℤ_2` whose `n`-th reductions are continuous is continuous.**  If
`g : A →+ ℤ_[2]` is an additive homomorphism out of a topological additive group and, for every `n`,
the composite with the reduction `PadicInt.toZModPow n` equals a continuous homomorphism
`f n : A →+ ZMod (2^n)` (the target carrying its discrete topology), then `g` is continuous. -/
theorem continuous_of_toZModPow_comp {A : Type*} [AddCommGroup A] [TopologicalSpace A]
    [IsTopologicalAddGroup A] (g : A →+ PadicInt 2) (f : ∀ n : ℕ, A →+ ZMod (2^n))
    (hf : ∀ n : ℕ, Continuous ⇑(f n))
    (h : ∀ (n : ℕ) (x : A), PadicInt.toZModPow n (g x) = f n x) :
    Continuous ⇑g := by
  -- The topology of `ℤ_[2]` is generated by the reductions `toZModPow n`: the class of `y`
  -- modulo `2^n` determines `y` up to an error of norm `≤ 2^{-n}`.
  rw [continuous_iff_continuousAt]
  intro x
  rw [ContinuousAt, Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨n, hn⟩ := PadicInt.exists_pow_neg_lt 2 hε
  -- `g` is constant on the open set `{a | f n a = f n x}`, up to an error of norm `≤ 2^{-n}`.
  have hnhds : (f n) ⁻¹' {f n x} ∈ 𝓝 x :=
    ((hf n).isOpen_preimage {f n x} (isOpen_discrete _)).mem_nhds (Set.mem_preimage.mpr rfl)
  refine Filter.mem_of_superset hnhds ?_
  intro a ha
  rw [Set.mem_preimage, Set.mem_singleton_iff] at ha
  have hker : PadicInt.toZModPow n (g (a - x)) = 0 := by
    rw [map_sub g a x, map_sub (PadicInt.toZModPow (p := 2) n) (g a) (g x), h n a, h n x,
      ha, sub_self]
  have hmem : g (a - x) ∈ Ideal.span {((2 : ℕ) : ℤ_[2]) ^ n} := by
    rw [← PadicInt.ker_toZModPow (p := 2) n, RingHom.mem_ker]
    exact hker
  have hnorm : ‖g (a - x)‖ ≤ ((2 : ℕ) : ℝ) ^ (-(n : ℤ)) :=
    (PadicInt.norm_le_pow_iff_mem_span_pow (p := 2) (g (a - x)) n).mpr hmem
  calc dist (g a) (g x) = ‖g a - g x‖ := dist_eq_norm _ _
    _ = ‖g (a - x)‖ := by rw [map_sub g a x]
    _ ≤ ((2 : ℕ) : ℝ) ^ (-(n : ℤ)) := hnorm
    _ < ε := hn

end NK.RankTheoryDeep
