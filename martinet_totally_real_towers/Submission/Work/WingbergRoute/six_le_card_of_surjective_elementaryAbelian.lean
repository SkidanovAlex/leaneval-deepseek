import Mathlib
import Submission.Work.RelatorRank.All

/-!
# `Work.WingbergRoute.six_le_card_of_surjective_elementaryAbelian`

**Namespace** `Work.WingbergRoute`; module
`Submission.Work.WingbergRoute.six_le_card_of_surjective_elementaryAbelian`.

An elementary abelian `2`-quotient of rank `6` forces any generating family of the group to have
at least `6` elements.

More precisely: let `G = FreeGroup α ⧸ N` be the quotient of the free group on `α` by the normal
closure of a relator set `rel`, and suppose there is a *surjective* homomorphism
`φ : G ↠ (ℤ/2)^6`.  Since `G` is generated by the `card α` classes of the free generators, the
image `(ℤ/2)^6` is generated by `card α` elements as well.  But `(ℤ/2)^6` -- i.e.
`Fin 6 → Multiplicative (ZMod 2)` -- is the `𝔽₂`-vector space `𝔽₂^6` in multiplicative notation,
whose minimal number of generators is its dimension `6`.  Hence `6 ≤ card α`.

The algebraic content is the seed lemma
`Work.RelatorRank.GeneratorRank.le_card_of_closure_eq_top_elementaryAbelian`
(`(𝔽₂)^d` cannot be generated by fewer than `d` elements); here we only have to
* push the generators of the free group through `φ` (surjectivity of the quotient map and
  `FreeGroup.closure_range_of`), and
* reindex the generating family along the equivalence `Fintype.equivFin α`.

This is the group-theoretic side of the generator-rank lower bound `d(G_∅) ≥ 6` of the
unramified (Wingberg) route: a presentation of `G` on `α` generators surjecting onto `(ℤ/2)^6`
needs `card α ≥ 6`.
-/

namespace Work.WingbergRoute

/-- **A surjection onto `(ℤ/2)^6` forces at least `6` generators.**

If the quotient `FreeGroup α ⧸ normalClosure rel` admits a surjective homomorphism onto the
elementary abelian group `(Fin 6 → Multiplicative (ZMod 2)) ≅ (ℤ/2)^6`, then `α` has at least `6`
elements. -/
theorem six_le_card_of_surjective_elementaryAbelian
    (α : Type) [Fintype α] (rel : Finset (FreeGroup α))
    (φ : (FreeGroup α ⧸ Subgroup.normalClosure (rel : Set (FreeGroup α))) →*
      (Fin 6 → Multiplicative (ZMod 2)))
    (hφ : Function.Surjective φ) :
    6 ≤ Fintype.card α := by
  classical
  -- the composite `FreeGroup α →* (ℤ/2)^6`
  let f : FreeGroup α →* (Fin 6 → Multiplicative (ZMod 2)) :=
    φ.comp (QuotientGroup.mk' (Subgroup.normalClosure (rel : Set (FreeGroup α))))
  have hf : Function.Surjective f :=
    hφ.comp (QuotientGroup.mk'_surjective (Subgroup.normalClosure (rel : Set (FreeGroup α))))
  -- the images of the free generators generate `(ℤ/2)^6`
  have hFr : f.range = Subgroup.closure (Set.range (fun a => f (FreeGroup.of a))) := by
    rw [MonoidHom.range_eq_map, ← FreeGroup.closure_range_of α, MonoidHom.map_closure,
      ← Set.range_comp f FreeGroup.of]
    rfl
  have htop : Subgroup.closure (Set.range (fun a => f (FreeGroup.of a))) = ⊤ := by
    rw [← hFr, MonoidHom.range_eq_top]
    exact hf
  -- reindex the generating family by `Fin (card α)`
  let e := Fintype.equivFin α
  let g : Fin (Fintype.card α) → (Fin 6 → Multiplicative (ZMod 2)) :=
    fun i => f (FreeGroup.of (e.symm i))
  have hg : Subgroup.closure (Set.range g) = ⊤ := by
    have h := e.symm.surjective.range_comp (fun a => f (FreeGroup.of a))
    rw [show Set.range g = Set.range (fun a => f (FreeGroup.of a)) from h]
    exact htop
  exact Work.RelatorRank.GeneratorRank.le_card_of_closure_eq_top_elementaryAbelian g hg

end Work.WingbergRoute
