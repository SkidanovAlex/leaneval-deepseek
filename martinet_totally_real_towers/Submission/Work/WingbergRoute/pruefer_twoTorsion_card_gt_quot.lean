import Mathlib
import Submission.Work.WingbergRoute.Defs

/-!
# The `2`-torsion of the Prüfer group `ℚ/ℤ` exceeds the cokernel of doubling

This module proves `Work.WingbergRoute.pruefer_twoTorsion_card_gt_quot`, the machine-checked
counterexample recorded in `Submission/Work/WingbergRoute/Traps.lean`: the implication

```
#A[2] ≤ #(A / 2A)          (A an abelian group)
```

is **false**.  For the Prüfer group `A = ℚ/ℤ` the `2`-torsion `A[2]` has two elements `0` and
`1/2`, while `A/2A` is trivial because `ℚ/ℤ` is divisible (multiplication by `2` is surjective).

The proof is direct: `ℚ/ℤ` is `ℚ ⧸ AddSubgroup.zmultiples 1`, the doubling map is onto (witness
`q ↦ q/2`), so the subgroup generated by its range is everything and the cokernel is a
subsingleton; the `2`-torsion is described by
`QuotientAddGroup.zmultiples_nsmul_eq_nsmul_iff`, which identifies it with the two-element set
`{0, 1/2}`.
-/

namespace Work.WingbergRoute

abbrev QZ : Type := ℚ ⧸ AddSubgroup.zmultiples (1 : ℚ)

/-- **The doubling map on the Prüfer group is surjective** (`ℚ/ℤ` is divisible): a preimage of
the class of `q : ℚ` is the class of `q/2`. -/
lemma qz_two_smul_surjective : Function.Surjective (fun x : QZ => (2 : ℕ) • x) := by
  have key : ∀ q : ℚ, (2 : ℕ) • ((q / 2 : ℚ) : QZ) = ((q : ℚ) : QZ) := fun q => by
    rw [← QuotientAddGroup.mk_nsmul (AddSubgroup.zmultiples (1 : ℚ)) (q / 2) 2]
    congr 1
    ring
  intro y
  refine QuotientAddGroup.induction_on y ?_
  intro q
  exact ⟨((q / 2 : ℚ) : QZ), key q⟩

/-- **`1/2` is a nonzero element of `ℚ/ℤ`**, i.e. `1/2` is not an integer. -/
lemma qz_half_ne_zero : ((1 / 2 : ℚ) : QZ) ≠ 0 := by
  intro h
  rw [QuotientAddGroup.eq_zero_iff] at h
  rw [AddSubgroup.mem_zmultiples_iff] at h
  obtain ⟨k, hk⟩ := h
  have hk' : (k : ℚ) = 1 / 2 := by simpa using hk
  have h2 : (2 * k : ℚ) = 1 := by rw [hk']; ring
  have h3 : (2 * k : ℤ) = 1 := by exact_mod_cast h2
  omega

/-- **The `2`-torsion of the Prüfer group is exactly `{0, 1/2}`**, indexed by `Fin 2`:
`ψ` is killed by `2` if and only if it is the class of `k/2` for some `k ∈ {0, 1}`.

This is `QuotientAddGroup.zmultiples_nsmul_eq_nsmul_iff` with `R = ℚ`, `p = 1`, `n = 2`, `θ = 0`. -/
lemma qz_two_torsion_iff (ψ : QZ) :
    (2 : ℕ) • ψ = 0 ↔ ∃ k : Fin 2, ψ = ((k : ℕ) • (1 / 2 : ℚ) : QZ) := by
  have h := QuotientAddGroup.zmultiples_nsmul_eq_nsmul_iff (p := (1 : ℚ)) (n := 2)
    (ψ := ψ) (θ := 0) (by norm_num)
  simpa using h

/-- **The `2`-torsion of the Prüfer group `ℚ/ℤ` has two elements.** -/
lemma qz_two_torsion_card : Nat.card {x : QZ // (2 : ℕ) • x = 0} = 2 := by
  let g : Fin 2 → {x : QZ // (2 : ℕ) • x = 0} :=
    fun k => ⟨((k : ℕ) • (1 / 2 : ℚ) : QZ), (qz_two_torsion_iff _).mpr ⟨k, rfl⟩⟩
  have hbij : Function.Bijective g := by
    constructor
    · intro k1 k2 h
      have h' := Subtype.ext_iff.mp h
      fin_cases k1 <;> fin_cases k2
      · rfl
      · exfalso
        have hv : ((0 : ℚ) : QZ) = ((1 / 2 : ℚ) : QZ) := by simpa [g] using h'
        exact qz_half_ne_zero hv.symm
      · exfalso
        have hv : ((1 / 2 : ℚ) : QZ) = ((0 : ℚ) : QZ) := by simpa [g] using h'
        exact qz_half_ne_zero hv
      · rfl
    · rintro ⟨x, hx⟩
      obtain ⟨k, hk⟩ := (qz_two_torsion_iff x).mp hx
      exact ⟨k, Subtype.ext hk.symm⟩
  have e : {x : QZ // (2 : ℕ) • x = 0} ≃ Fin 2 := (Equiv.ofBijective g hbij).symm
  rw [Nat.card_congr e, Nat.card_fin]

theorem pruefer_twoTorsion_card_gt_quot :
    Nat.card {x : QZ // (2 : ℕ) • x = 0} >
      Nat.card (QZ ⧸ AddSubgroup.closure (Set.range (fun x : QZ => (2 : ℕ) • x))) := by
  have hH : AddSubgroup.closure (Set.range (fun x : QZ => (2 : ℕ) • x)) = ⊤ := by
    rw [qz_two_smul_surjective.range_eq, AddSubgroup.closure_univ]
  have hB : Nat.card (QZ ⧸ AddSubgroup.closure (Set.range (fun x : QZ => (2 : ℕ) • x))) = 1 := by
    rw [hH]
    exact Nat.card_eq_one_iff_unique.mpr
      ⟨QuotientAddGroup.subsingleton_quotient_top, ⟨0⟩⟩
  have hA : Nat.card {x : QZ // (2 : ℕ) • x = 0} = 2 := qz_two_torsion_card
  omega

end Work.WingbergRoute
