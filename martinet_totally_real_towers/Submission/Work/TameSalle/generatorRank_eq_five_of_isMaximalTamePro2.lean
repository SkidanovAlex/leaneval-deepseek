import Mathlib
import Submission.Work.TameSalle.Defs
import Submission.Work.RelatorRank.API
import Submission.Work.RelatorRank.Bridge
import Submission.Work.TameArithmetic.dense_generatingFamily_of_isMaximalTamePro2
import Submission.Work.TameArithmetic.generatorMinimal_of_isMaximalTamePro2

namespace Work.TameSalle

/-- **`d(Γ) = 5` for `Γ = Gal(K/ℚ)` a maximal tame pro-`2` extension of `ℚ`.**

The two halves of the generator rank are already proved in the arithmetic chapter
(`Work.TameArithmetic`):

* `dense_generatingFamily_of_isMaximalTamePro2` -- `Γ` is (topologically) generated by five
  elements (`d ≤ 5`), from the count of the `31` quadratic levels of `K`;
* `generatorMinimal_of_isMaximalTamePro2` -- `Γ` is not generated by four elements (`d ≥ 5`),
  from the surjection `Γ ↠ (ℤ/2)^5` coming from the multiquadratic field `ℚ(√q : q ∈ S)`.

`Work.RelatorRank.generatorRank_eq_of` assembles the two, `noSmallerGeneratingFamily_five_iff`
turning "not generated by four elements" into the minimality hypothesis. -/
theorem generatorRank_eq_five_of_isMaximalTamePro2 (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K]
    (hK : Work.TameArithmetic.IsMaximalTamePro2 K) :
    Work.RelatorRank.GeneratorRank (K ≃ₐ[ℚ] K) = 5 := by
  obtain ⟨gen, hgen⟩ := Work.TameArithmetic.dense_generatingFamily_of_isMaximalTamePro2 K hK
  refine Work.RelatorRank.generatorRank_eq_of ⟨gen, hgen⟩ ?_
  rw [Work.RelatorRank.noSmallerGeneratingFamily_five_iff]
  exact Work.TameArithmetic.generatorMinimal_of_isMaximalTamePro2 K hK

end Work.TameSalle
