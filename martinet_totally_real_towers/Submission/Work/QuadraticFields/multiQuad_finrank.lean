import Mathlib
import Submission.Work.QuadraticFields.QuadField
import Submission.Commons.FieldTheory.Adjoin.finrank_adjoin_sq_eq_two_pow

namespace Work.QuadraticFields

/-- **The degree of a multiquadratic field.**  If no nonempty subproduct of the entries of a finite
set `s` of rationals is a square, then `ℚ(√a : a ∈ s)` has degree `2 ^ |s|` over `ℚ`.

The proof applies Kummer theory for the extension generated by the square roots: the independence
hypothesis says exactly that the classes of the `a ∈ s` in `ℚˣ ⧸ ℚˣ²` are independent, so the
Kummer pairing with `Gal` is nondegenerate and the Galois group has cardinality `2 ^ |s|`. -/
theorem multiQuad_finrank (s : Finset ℚ)
    (hns : ∀ T : Finset s, T.Nonempty → ∀ r : ℚ, r ^ 2 ≠ ∏ i ∈ T, ((i : s) : ℚ)) :
    Module.finrank ℚ ↥(multiQuad s) = 2 ^ s.card := by
  classical
  -- every entry of `s` is a nonzero rational, since with `T = {a}` the hypothesis says that `a`
  -- is not a square
  have ha : ∀ i : s, (i : ℚ) ≠ 0 := by
    intro i hi
    have h1 := hns {i} (Finset.singleton_nonempty i) 0
    rw [Finset.prod_singleton] at h1
    rw [hi] at h1
    exact h1 (by norm_num)
  -- the chosen square roots generate `multiQuad s` over `ℚ`
  have hsq : ∀ i : s, (⟨sqrtVal (i : ℚ), sqrtVal_mem_multiQuad i.2⟩ : ↥(multiQuad s)) ^ 2
      = algebraMap ℚ ↥(multiQuad s) (i : ℚ) := by
    intro i
    apply Subtype.ext
    simp [sqrtVal_sq]
  have himg : (Subtype.val : ↥(multiQuad s) → AlgebraicClosure ℚ) ''
      Set.range (fun i : s => (⟨sqrtVal (i:ℚ), sqrtVal_mem_multiQuad i.2⟩ : ↥(multiQuad s)))
      = sqrtVal '' (s : Set ℚ) := by
    ext x
    constructor
    · rintro ⟨y, ⟨i, rfl⟩, rfl⟩
      exact ⟨(i : ℚ), i.2, rfl⟩
    · rintro ⟨a, ha', rfl⟩
      exact ⟨⟨sqrtVal a, sqrtVal_mem_multiQuad ha'⟩, ⟨⟨a, ha'⟩, rfl⟩, rfl⟩
  have hgen : IntermediateField.adjoin ℚ
      (Set.range (fun i : s =>
        (⟨sqrtVal (i:ℚ), sqrtVal_mem_multiQuad i.2⟩ : ↥(multiQuad s)))) = ⊤ := by
    refine (IntermediateField.lift_injective (F := multiQuad s)) ?_
    rw [IntermediateField.lift_adjoin, IntermediateField.lift_top, himg]
    rfl
  have h := Commons.FieldTheory.Adjoin.finrank_adjoin_sq_eq_two_pow (F := ℚ) (L := ↥(multiQuad s))
    (ι := s) (fun i : s => (i : ℚ))
    (fun i : s => (⟨sqrtVal (i:ℚ), sqrtVal_mem_multiQuad i.2⟩ : ↥(multiQuad s)))
    ha hsq hgen hns
  rw [Fintype.card_coe] at h
  exact h

end Work.QuadraticFields
