import Mathlib
import Submission.Work.QuadraticFields.QuadField

/-!
# A degree-two number field is generated by a square root of a squarefree integer

Let `K` be a number field with `[K : ℚ] = 2`.  Then there is a squarefree integer `d` and an
element `x ∈ K` with `x ^ 2 = d` (the rational number `d` viewed in `K` via `algebraMap`), and
`ℚ(x) = K`.

The proof is the classical "completing the square" argument:

* some element `x₀ ∉ ℚ` exists, because the image of `ℚ` in `K` is one-dimensional while
  `[K : ℚ] = 2`;
* `1, x₀, x₀ ^ 2` are `ℚ`-linearly dependent (three vectors in a two-dimensional space), and the
  coefficient of `x₀ ^ 2` is non-zero, giving a relation `x₀ ^ 2 = a * x₀ + b` with `a, b ∈ ℚ`;
* consequently `z = 2 * x₀ - a` satisfies `z ^ 2 = a ^ 2 + 4 * b ∈ ℚ` and `z ∉ ℚ`;
* write `z ^ 2 = d * t ^ 2` with `d` squarefree and `t ∈ ℚ`; then `x = z / t` has `x ^ 2 = d` and
  `ℚ(x) = ℚ(z) = K` by the dimension count.

## Main result

* `Work.QuadraticFields.exists_squarefree_sq_eq_of_finrank_eq_two`.
-/

namespace Work.QuadraticFields

set_option maxHeartbeats 1000000

/-- In a number field of degree `2` over `ℚ` there is an element which is not a rational number,
i.e. which does not lie in the range of `algebraMap ℚ K`. -/
lemma exists_notMem_algebraMap_range_of_finrank_eq_two {K : Type*} [Field K] [NumberField K]
    (h : Module.finrank ℚ K = 2) : ∃ x : K, x ∉ Set.range (algebraMap ℚ K) := by
  have hinj : Function.Injective (Algebra.linearMap ℚ K) := fun a b hab =>
    FaithfulSMul.algebraMap_injective ℚ K (by simpa [Algebra.linearMap_apply] using hab)
  have hfr : Module.finrank ℚ (LinearMap.range (Algebra.linearMap ℚ K)) = 1 := by
    rw [LinearMap.finrank_range_of_inj hinj, Module.finrank_self]
  have hne : LinearMap.range (Algebra.linearMap ℚ K) ≠ ⊤ := by
    intro htop
    rw [htop, finrank_top] at hfr
    omega
  obtain ⟨x, -, hx⟩ := SetLike.exists_of_lt (lt_of_le_of_ne le_top hne)
  refine ⟨x, ?_⟩
  intro hxr
  apply hx
  rw [LinearMap.mem_range]
  exact hxr

/-- `1` and an irrational element of a quadratic number field are linearly independent. -/
lemma linearIndependent_one_self_of_notMem_algebraMap_range {K : Type*} [Field K] [NumberField K]
    {x : K} (hx : x ∉ Set.range (algebraMap ℚ K)) : LinearIndependent ℚ ![1, x] := by
  rw [linearIndependent_fin2]
  constructor
  · show x ≠ 0
    intro hx0
    exact hx ⟨0, by rw [hx0, map_zero]⟩
  · intro a ha
    have ha' : algebraMap ℚ K a * x = 1 := by
      rw [Algebra.smul_def] at ha
      simpa using ha
    by_cases ha0 : a = 0
    · rw [ha0, map_zero, zero_mul] at ha'
      exact zero_ne_one ha'
    · have hane : algebraMap ℚ K a ≠ 0 := fun h0 =>
        ha0 (FaithfulSMul.algebraMap_injective ℚ K (h0.trans (map_zero _).symm))
      have hxinv : x = algebraMap ℚ K a⁻¹ := by
        calc x = (algebraMap ℚ K a)⁻¹ * (algebraMap ℚ K a * x) := by
              rw [← mul_assoc, inv_mul_cancel₀ hane, one_mul]
          _ = (algebraMap ℚ K a)⁻¹ * 1 := by rw [ha']
          _ = algebraMap ℚ K a⁻¹ := by rw [mul_one, map_inv₀]
      exact hx ⟨a⁻¹, hxinv.symm⟩

/-- Let `K` be a number field of degree `2` over `ℚ` and `x ∉ ℚ`.  Then there is `z ∉ ℚ` in `K`
whose square is a rational number.  Explicitly, if `x ^ 2 = a * x + b` with `a, b ∈ ℚ` then
`z = 2 * x - a` satisfies `z ^ 2 = a ^ 2 + 4 * b`. -/
lemma exists_sq_mem_algebraMap_range_of_notMem_algebraMap_range {K : Type*} [Field K]
    [NumberField K] (h : Module.finrank ℚ K = 2) {x : K}
    (hx : x ∉ Set.range (algebraMap ℚ K)) :
    ∃ z : K, z ∉ Set.range (algebraMap ℚ K) ∧
      ∃ q : ℚ, z ^ 2 = algebraMap ℚ K q := by
  have hv : LinearIndependent ℚ ![1, x] := linearIndependent_one_self_of_notMem_algebraMap_range hx
  have hspan_top : Submodule.span ℚ (Set.range ![1, x] : Set K) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [h, finrank_span_eq_card hv, Fintype.card_fin]
  have hx2 : x ^ 2 ∈ Submodule.span ℚ (Set.range ![1, x] : Set K) := by
    rw [hspan_top]; exact Submodule.mem_top
  have hrange : (Set.range ![1, x] : Set K) = ({1, x} : Set K) := by
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.insert_eq]
  rw [hrange] at hx2
  obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp hx2
  have hrel : x ^ 2 = algebraMap ℚ K a + algebraMap ℚ K b * x := by
    rw [Algebra.smul_def, mul_one, Algebra.smul_def] at hab
    exact hab.symm
  refine ⟨2 * x - algebraMap ℚ K b, ?_, 4 * a + b ^ 2, ?_⟩
  · intro hzr
    obtain ⟨c, hc⟩ := hzr
    have h2x : (2:K) * x = algebraMap ℚ K (c + b) := by
      rw [map_add, hc]
      ring
    have h2y : (2:K) * algebraMap ℚ K ((c + b) / 2) = algebraMap ℚ K (c + b) := by
      rw [show (2:K) = algebraMap ℚ K (2:ℚ) by simp, ← map_mul]
      congr 1
      ring
    have h2ne : (2:K) ≠ 0 := by
      rw [show (2:K) = algebraMap ℚ K (2:ℚ) by simp]
      intro h0
      have h1 : (2:ℚ) = 0 := FaithfulSMul.algebraMap_injective ℚ K (h0.trans (map_zero _).symm)
      norm_num at h1
    have hxc : x = algebraMap ℚ K ((c + b) / 2) := mul_left_cancel₀ h2ne (h2x.trans h2y.symm)
    exact hx ⟨(c + b) / 2, hxc.symm⟩
  · have hq : algebraMap ℚ K (4 * a + b ^ 2) = 4 * algebraMap ℚ K a + (algebraMap ℚ K b)^2 := by
      rw [map_add, map_mul, map_pow, map_ofNat]
    have h4 : (2 * x - algebraMap ℚ K b) ^ 2 =
        4 * x ^ 2 - 4 * x * algebraMap ℚ K b + (algebraMap ℚ K b)^2 := by ring
    rw [hq, h4, hrel]
    ring

/-- Every rational number is a squarefree integer times a square. -/
lemma exists_squarefree_int_mul_sq (q : ℚ) :
    ∃ d : ℤ, Squarefree d ∧ ∃ t : ℚ, q = (d : ℚ) * t ^ 2 := by
  obtain ⟨e, d, hd, hsq⟩ := exists_sq_mul_squarefree (q.num * (q.den : ℤ))
  refine ⟨d, hsq, (e : ℚ) / (q.den : ℚ), ?_⟩
  have hn : (q.den : ℚ) ≠ 0 := by exact_mod_cast q.den_ne_zero
  have hcast : (e : ℚ) ^ 2 * (d : ℚ) = (q.num : ℚ) * (q.den : ℚ) := by
    have := congr_arg (fun z : ℤ => (z : ℚ)) hd
    push_cast at this
    exact this
  conv_lhs => rw [show (q : ℚ) = (q.num : ℚ) / (q.den : ℚ) from (Rat.num_div_den q).symm]
  field_simp
  rw [← hcast]
  ring

/-- In a quadratic number field, an irrational element generates the whole field. -/
lemma adjoin_eq_top_of_notMem_algebraMap_range {K : Type*} [Field K] [NumberField K]
    (h : Module.finrank ℚ K = 2) {x : K} (hx : x ∉ Set.range (algebraMap ℚ K)) :
    Algebra.adjoin ℚ ({x} : Set K) = ⊤ := by
  have hv : LinearIndependent ℚ ![1, x] := linearIndependent_one_self_of_notMem_algebraMap_range hx
  have hspan : Module.finrank ℚ (Submodule.span ℚ (Set.range ![1, x] : Set K)) = 2 := by
    rw [finrank_span_eq_card hv, Fintype.card_fin]
  have hle : Submodule.span ℚ (Set.range ![1, x] : Set K) ≤
      (Algebra.adjoin ℚ ({x} : Set K)).toSubmodule := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    fin_cases i
    · change (1 : K) ∈ Algebra.adjoin ℚ ({x} : Set K)
      exact one_mem _
    · change x ∈ Algebra.adjoin ℚ ({x} : Set K)
      exact Algebra.self_mem_adjoin_singleton ℚ x
  have hfin : Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set K)).toSubmodule = 2 := by
    have h1 : Module.finrank ℚ ↥(Submodule.span ℚ (Set.range ![1, x] : Set K)) ≤
        Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set K)).toSubmodule :=
      Submodule.finrank_mono hle
    have h2 : Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set K)).toSubmodule ≤
        Module.finrank ℚ K := Submodule.finrank_le _
    rw [hspan] at h1
    rw [h] at h2
    omega
  rw [← Algebra.toSubmodule_eq_top]
  exact Submodule.eq_top_of_finrank_eq (by rw [h]; exact hfin)

theorem exists_squarefree_sq_eq_of_finrank_eq_two {K : Type*} [Field K] [NumberField K]
    (h : Module.finrank ℚ K = 2) :
    ∃ d : ℤ, Squarefree d ∧
      ∃ x : K, x ^ 2 = algebraMap ℚ K (d : ℚ) ∧ Algebra.adjoin ℚ ({x} : Set K) = ⊤ := by
  obtain ⟨x₀, hx₀⟩ := exists_notMem_algebraMap_range_of_finrank_eq_two h
  obtain ⟨z, hz, q, hzq⟩ := exists_sq_mem_algebraMap_range_of_notMem_algebraMap_range h hx₀
  obtain ⟨d, hdsq, t, ht⟩ := exists_squarefree_int_mul_sq q
  have hq0 : q ≠ 0 := by
    intro hq0
    refine hz ⟨0, ?_⟩
    have hzsq : z ^ 2 = (0 : K) := by rw [hzq, hq0, map_zero]
    rw [map_zero]
    exact (sq_eq_zero_iff.mp hzsq).symm
  have ht0 : t ≠ 0 := by
    intro ht0
    exact hq0 (by rw [ht, ht0]; ring)
  have htval : algebraMap ℚ K t ≠ 0 := fun h0 =>
    ht0 (FaithfulSMul.algebraMap_injective ℚ K (h0.trans (map_zero _).symm))
  refine ⟨d, hdsq, z / algebraMap ℚ K t, ?_, ?_⟩
  · have ht2 : t ^ 2 ≠ 0 := pow_ne_zero 2 ht0
    rw [div_pow, hzq, ← map_pow, ← map_div₀]
    congr 1
    rw [ht]
    field_simp
  · have hxr : z / algebraMap ℚ K t ∉ Set.range (algebraMap ℚ K) := by
      intro hxr'
      obtain ⟨c, hc⟩ := hxr'
      apply hz
      refine ⟨c * t, ?_⟩
      rw [map_mul, hc]
      field_simp
    exact adjoin_eq_top_of_notMem_algebraMap_range h hxr

end Work.QuadraticFields
