import Mathlib
import Submission.Work.QuadraticFields.MultiquadraticInside
import Submission.Work.QuadraticFields.Ramification
import Submission.Work.QuadraticFields.isUnramifiedAt_of_finset_sup_eq_top
import Submission.Work.QuadraticFields.normal_adjoin_sqrt
import Submission.Work.QuadraticFields.finiteDimensional_adjoin_sqrt
import Submission.Work.QuadraticFields.discr_dvd_of_sq_eq
import Submission.Work.QuadraticFields.discr_dvd_of_sq_eq_mod_four_one
import Submission.Work.QuadraticFields.ramificationIdx_eq_one_of_not_dvd_discr
import Submission.Work.QuadraticFields.IsPrimeDiscriminant_emod_four_eq_one
import Submission.Work.QuadraticFields.ramificationIdx_one_of_isPrimeDiscriminant

/-!
# `M / ℚ(∏ √a : a ∈ s)` is unramified at all finite primes

Let `M` be a Galois number field over `ℚ`, let `s` be a finite set of pairwise coprime prime
discriminants and let `x : ℤ → M` be a family of square roots, `x a ^ 2 = a`.  If the `x a`
generate `M` over `ℚ`, then `M` is unramified over the quadratic subfield
`ℚ(∏ a ∈ s, x a)`.

The proof is the inertia-group argument: a rational prime `p` ramifies in the quadratic field
`ℚ(x a)` only if `p ∣ a.natAbs`, and since the discriminants are pairwise coprime there is at most
one `a ∈ s` with `p ∣ a.natAbs`.  If there is none, all the quadratic subfields `ℚ(x a)` are
unramified at `p` and generate `M` over the base field, so `M/F` is unramified at `p`.  If there is
one, say `a₀`, then the remaining quadratic subfields together with `F` still generate `M`, because
`x a₀ = (∏ a ∈ s, x a) · (∏ a ∈ s.erase a₀, x a)⁻¹`; again unramifiedness at `p` follows.

## Main result

* `Work.QuadraticFields.isUnramifiedAtFinitePrimes_multiQuad`
-/

namespace Work.QuadraticFields

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open NumberField

noncomputable section

/-- A prime discriminant is nonzero. -/
lemma IsPrimeDiscriminant.ne_zero {d : ℤ} (hd : IsPrimeDiscriminant d) : d ≠ 0 := by
  rcases hd with h | h | h | ⟨p, hp, -, hd⟩
  · rw [h]; norm_num
  · rw [h]; norm_num
  · rw [h]; norm_num
  · rw [hd]
    exact mul_ne_zero (pow_ne_zero _ (by norm_num)) (by exact_mod_cast hp.ne_zero)

/-- If `x ^ 2 = a` for a prime discriminant `a`, then `x ≠ 0`. -/
lemma sqrt_ne_zero {M : Type*} [Field M] [Algebra ℚ M] {a : ℤ} (x : M)
    (hx : x ^ 2 = algebraMap ℚ M (a : ℚ)) (ha : IsPrimeDiscriminant a) : x ≠ 0 := by
  intro h
  have h0 : algebraMap ℚ M (a : ℚ) = 0 := by
    rw [← hx, h, zero_pow (by norm_num : (2 : ℕ) ≠ 0)]
  have hq : (a : ℚ) = 0 := (algebraMap ℚ M).injective (by simpa using h0)
  exact IsPrimeDiscriminant.ne_zero ha (by exact_mod_cast hq)

/-- **The `Algebra.adjoin` of a generator of a quadratic subfield is everything.**

Let `x : M` and let `y` be the same element viewed in the subfield `ℚ⟮x⟯`.  Then `y` alone
generates `ℚ⟮x⟯` as an algebra over `ℚ`. -/
lemma algebra_adjoin_singleton_eq_top_of_coe_eq {M : Type*} [Field M] [NumberField M]
    (x : M) (y : ↥(IntermediateField.adjoin ℚ ({x} : Set M))) (hy : (y : M) = x) :
    Algebra.adjoin ℚ ({y} : Set ↥(IntermediateField.adjoin ℚ ({x} : Set M))) = ⊤ := by
  refine IntermediateField.adjoin_eq_top_iff.mp ?_
  let L : IntermediateField ℚ M := IntermediateField.adjoin ℚ ({x} : Set M)
  change IntermediateField.adjoin ℚ ({y} : Set ↥L) = ⊤
  -- The intermediate field generated by `y` has the same image in `M` as `L` itself.
  have hmap : (IntermediateField.adjoin ℚ ({y} : Set ↥L)).map L.val = L := by
    refine le_antisymm ?_ ?_
    · rintro z ⟨w, -, rfl⟩
      exact w.2
    · rw [IntermediateField.adjoin_le_iff]
      rintro z hz
      rw [Set.mem_singleton_iff] at hz
      subst hz
      refine (IntermediateField.mem_map (S := IntermediateField.adjoin ℚ ({y} : Set ↥L))
        (f := L.val)).mpr ?_
      exact ⟨y, IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton y), hy⟩
  have htop : (⊤ : IntermediateField ℚ ↥L).map L.val = L :=
    (AlgHom.fieldRange_eq_map L.val).symm.trans (IntermediateField.fieldRange_val L)
  exact IntermediateField.map_injective L.val (hmap.trans htop.symm)

/-- The supremum of the quadratic subfields `ℚ⟮x a⟯`, `a ∈ s`, is everything when the
multiquadratic field generated by the `x a` is. -/
lemma iSup_sqrtSubfield_eq_top {M : Type*} [Field M] [Algebra ℚ M] (s : Finset ℤ) (x : ℤ → M)
    (hgen : multiquadSub s x = ⊤) : (⨆ a ∈ s, sqrtSubfield x a) = ⊤ := by
  rw [eq_top_iff, ← hgen, multiquadSub, IntermediateField.adjoin_le_iff]
  rintro y ⟨a, ha, rfl⟩
  exact le_iSup₂ (f := fun a (_ : a ∈ s) => sqrtSubfield x a) a ha
    (IntermediateField.subset_adjoin ℚ ({x a} : Set M) (Set.mem_singleton (x a)))

/-- **Removing one generator still generates everything, together with the product subfield.**

If `a₀ ∈ s` and all the `x a` are nonzero, then `ℚ(∏ a ∈ s, x a)` together with the quadratic
subfields `ℚ⟮x a⟯` for `a ∈ s.erase a₀` generate the multiquadratic field `ℚ(x a : a ∈ s)`, since
`x a₀` is the quotient of the product of all the generators by the product of the remaining
ones. -/
lemma sup_prodSubfield_iSup_erase_eq_top {M : Type*} [Field M] [Algebra ℚ M] (s : Finset ℤ)
    (x : ℤ → M) (hgen : multiquadSub s x = ⊤) {a₀ : ℤ} (ha₀ : a₀ ∈ s)
    (hnz : ∀ a ∈ s, x a ≠ 0) :
    prodSubfield s x ⊔ (⨆ a ∈ s.erase a₀, sqrtSubfield x a) = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← hgen, multiquadSub, IntermediateField.adjoin_le_iff]
  rintro y ⟨a, ha, rfl⟩
  by_cases h : a = a₀
  · subst h
    have hQ : (∏ b ∈ s.erase a, x b) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun b hb => hnz b (Finset.mem_of_mem_erase hb)
    have hmul : x a * (∏ b ∈ s.erase a, x b) = ∏ b ∈ s, x b := by
      rw [mul_comm]
      exact Finset.prod_erase_mul s (fun b => x b) ha
    have hxeq : x a = (∏ b ∈ s, x b) * (∏ b ∈ s.erase a, x b)⁻¹ := by
      rw [← hmul, mul_assoc, mul_inv_cancel₀ hQ, mul_one]
    rw [hxeq]
    refine mul_mem ?_ (inv_mem ?_)
    · exact le_sup_left (b := ⨆ b ∈ s.erase a, sqrtSubfield x b)
        (IntermediateField.subset_adjoin ℚ ({∏ b ∈ s, x b} : Set M) (Set.mem_singleton _))
    · refine le_sup_right (a := prodSubfield s x) ?_
      exact IntermediateField.prod_mem (S := ⨆ b ∈ s.erase a, sqrtSubfield x b)
        (fun b hb => le_iSup₂ (f := fun b (_ : b ∈ s.erase a) => sqrtSubfield x b) b hb
          (IntermediateField.subset_adjoin ℚ ({x b} : Set M) (Set.mem_singleton (x b))))
  · refine le_sup_right (a := prodSubfield s x) ?_
    exact le_iSup₂ (f := fun b (_ : b ∈ s.erase a₀) => sqrtSubfield x b) a
      (Finset.mem_erase.mpr ⟨h, ha⟩)
      (IntermediateField.subset_adjoin ℚ ({x a} : Set M) (Set.mem_singleton (x a)))

theorem isUnramifiedAtFinitePrimes_multiQuad {M : Type*} [Field M] [NumberField M]
    [IsGalois ℚ M] (s : Finset ℤ) (x : ℤ → M) (hx : ∀ a ∈ s, x a ^ 2 = algebraMap ℚ M (a : ℚ))
    (hgen : multiquadSub s x = ⊤) (hcard : 2 ≤ s.card)
    (hd : ∀ a ∈ s, IsPrimeDiscriminant a)
    (hcop : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → Nat.Coprime a.natAbs b.natAbs) :
    IsUnramifiedAtFinitePrimes ↥(prodSubfield s x) M := by
  have hnz : ∀ a ∈ s, x a ≠ 0 := fun a ha => sqrt_ne_zero (x a) (hx a ha) (hd a ha)
  intro 𝔭 𝔓 h𝔭prime h𝔭ne h𝔓mem
  obtain ⟨h𝔓prime, h𝔓lies⟩ := h𝔓mem
  haveI : 𝔓.IsPrime := h𝔓prime
  haveI : 𝔓.LiesOver 𝔭 := h𝔓lies
  -- The rational prime lying below `𝔓`.
  have h𝔓ne : 𝔓 ≠ ⊥ := Ideal.ne_bot_of_liesOver_of_ne_bot h𝔭ne 𝔓
  haveI : NeZero 𝔓 := ⟨h𝔓ne⟩
  set p : ℕ := Ideal.absNorm (Ideal.under ℤ 𝔓) with hpdef
  have hp : Nat.Prime p := Nat.absNorm_under_prime 𝔓
  have hp𝔓 : (p : 𝓞 M) ∈ 𝔓 := Int.absNorm_under_mem 𝔓
  -- Unramifiedness of a single quadratic subfield at `p`, when `p ∤ a.natAbs`.
  have key : ∀ a ∈ s, ¬ p ∣ a.natAbs →
      ∀ (𝔮 : Ideal (𝓞 ↥(sqrtSubfield x a))), 𝔮.IsPrime →
        ((p : 𝓞 ↥(sqrtSubfield x a)) ∈ 𝔮) → 𝔮.ramificationIdx (𝓞 ℚ) = 1 := by
    intro a ha hpd 𝔮 h𝔮prime h𝔮mem
    let y : ↥(sqrtSubfield x a) :=
      ⟨x a, IntermediateField.subset_adjoin ℚ ({x a} : Set M) (Set.mem_singleton (x a))⟩
    have hy : y ^ 2 = algebraMap ℚ ↥(sqrtSubfield x a) (a : ℚ) := by
      apply Subtype.ext
      change x a ^ 2 = algebraMap ℚ M (a : ℚ)
      exact hx a ha
    have hgeny : Algebra.adjoin ℚ ({y} : Set ↥(sqrtSubfield x a)) = ⊤ :=
      algebra_adjoin_singleton_eq_top_of_coe_eq (x a) y rfl
    haveI : 𝔮.IsPrime := h𝔮prime
    exact ramificationIdx_one_of_isPrimeDiscriminant a (hd a ha) y hy hgeny p hp hpd 𝔮 h𝔮mem
  by_cases hcase : ∃ a ∈ s, p ∣ a.natAbs
  · -- There is a (unique) generator whose discriminant is divisible by `p`; drop it.
    obtain ⟨a₀, ha₀, ha₀dvd⟩ := hcase
    have huniq : ∀ b ∈ s, p ∣ b.natAbs → b = a₀ := by
      intro b hb hbdvd
      by_contra hne
      have h1 : Nat.gcd a₀.natAbs b.natAbs = 1 := hcop a₀ ha₀ b hb (Ne.symm hne)
      have h2 : p ∣ Nat.gcd a₀.natAbs b.natAbs := Nat.dvd_gcd ha₀dvd hbdvd
      rw [h1] at h2
      exact hp.not_dvd_one h2
    refine isUnramifiedAt_of_finset_sup_eq_top (prodSubfield s x) (s.erase a₀)
      (fun a => sqrtSubfield x a) p hp
      (sup_prodSubfield_iSup_erase_eq_top s x hgen ha₀ hnz) ?_ ?_ ?_ 𝔭 𝔓 hp𝔓
    · intro a ha
      exact finiteDimensional_adjoin_sqrt (a : ℚ) (x a) (hx a (Finset.mem_of_mem_erase ha))
    · intro a ha
      exact normal_adjoin_sqrt (a : ℚ) (x a) (hx a (Finset.mem_of_mem_erase ha))
    · intro a ha 𝔮 h𝔮prime h𝔮mem
      refine key a (Finset.mem_of_mem_erase ha) ?_ 𝔮 h𝔮prime h𝔮mem
      intro hdvd
      exact (Finset.mem_erase.mp ha).1 (huniq a (Finset.mem_of_mem_erase ha) hdvd)
  · -- No generator's discriminant is divisible by `p`; keep them all.
    have hsup : prodSubfield s x ⊔ (⨆ a ∈ s, sqrtSubfield x a) = ⊤ := by
      rw [iSup_sqrtSubfield_eq_top s x hgen, sup_top_eq]
    refine isUnramifiedAt_of_finset_sup_eq_top (prodSubfield s x) s (fun a => sqrtSubfield x a)
      p hp hsup ?_ ?_ ?_ 𝔭 𝔓 hp𝔓
    · intro a ha
      exact finiteDimensional_adjoin_sqrt (a : ℚ) (x a) (hx a ha)
    · intro a ha
      exact normal_adjoin_sqrt (a : ℚ) (x a) (hx a ha)
    · intro a ha 𝔮 h𝔮prime h𝔮mem
      refine key a ha ?_ 𝔮 h𝔮prime h𝔮mem
      intro hdvd
      exact hcase ⟨a, ha, hdvd⟩

end

end Work.QuadraticFields
