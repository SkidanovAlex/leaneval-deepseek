import Mathlib
import Submission.Work.QuadraticFields.CertificateReal
import Submission.Work.QuadraticFields.isTotallyReal_quadField_iff

/-!
# The multiquadratic field `ℚ(√a : a ∈ s)` is totally real when every `a ∈ s` is nonnegative

Let `s` be a finite set of rational numbers with `a ≥ 0` for all `a ∈ s`, and let

  `multiQuad s = ℚ(√a : a ∈ s) ⊆ AlgebraicClosure ℚ`

be the multiquadratic field generated by chosen square roots `√a = sqrtVal a` of the entries
(see `Work.QuadraticFields.QuadField`).  Then `multiQuad s` is a **totally real** number field.

The mechanism is the same as in the quadratic case
(`Work.QuadraticFields.isTotallyReal_quadField_of_nonneg`), carried out for the whole generating
set at once.  Mathlib's `NumberField.maximalRealSubfield K` is the fixed field of complex
conjugation acting on the embeddings of `K` into `ℂ`:

  `x ∈ maximalRealSubfield K ↔ ∀ φ : K →+* ℂ, star (φ x) = φ x`,

and `NumberField.isTotallyReal_iff_le_maximalRealSubfield` turns total reality of a subfield `E`
into the containment `E ≤ maximalRealSubfield K`.  So it suffices to show that the generators
`sqrtVal a` (`a ∈ s`) lie in the maximal real subfield of `AlgebraicClosure ℚ`; this is an
`adjoin` induction, and at each generator it reduces to the elementary complex fact that a
complex number whose square is the image of a **nonnegative** rational number is real
(`star_eq_self_of_sq_eq_ofReal`, proved in `isTotallyReal_quadField_iff.lean`).

## Main results

* `Work.QuadraticFields.multiQuad_le_maximalRealSubfield` -- the containment
  `multiQuad s ≤ maximalRealSubfield (AlgebraicClosure ℚ)`.
* `Work.QuadraticFields.multiQuad_isTotallyReal_of_nonneg` -- total reality of `multiQuad s`.
-/

namespace Work.QuadraticFields

open NumberField

set_option autoImplicit false

noncomputable section

/-- **The multiquadratic field sits inside the maximal real subfield.**  If every `a ∈ s` is
nonnegative, then every element of `ℚ(√a : a ∈ s)` is fixed by complex conjugation of its
embeddings into `ℂ`.

Since `sqrtVal '' (s : Set ℚ)` generates `multiQuad s` over `ℚ`, it suffices to check the
generators: if `φ` is a ring hom `AlgebraicClosure ℚ →+* ℂ` and `a ∈ s`, then
`φ (√a) ^ 2 = φ a = (a : ℂ)` is the square of a nonnegative real number, so
`star (φ (√a)) = φ (√a)`.  The three closure conditions (addition, inverses, multiplication) are
transport of the corresponding relations through `φ` and `star`. -/
theorem multiQuad_le_maximalRealSubfield (s : Finset ℚ) (h : ∀ a ∈ s, 0 ≤ a) :
    (multiQuad s).toSubfield ≤ NumberField.maximalRealSubfield (AlgebraicClosure ℚ) := by
  intro x hx
  rw [NumberField.mem_maximalRealSubfield_iff]
  refine IntermediateField.adjoin_induction ℚ (s := sqrtVal '' (s : Set ℚ))
    (p := fun y _ => ∀ φ : AlgebraicClosure ℚ →+* ℂ, star (φ y) = φ y)
    ?_ ?_ ?_ ?_ ?_ hx
  · intro y hy φ
    obtain ⟨a, ha, rfl⟩ := hy
    have hsq : (φ (sqrtVal a)) ^ 2 = ((a : ℝ) : ℂ) := by
      rw [← map_pow, sqrtVal_sq]
      simp
    exact star_eq_self_of_sq_eq_ofReal (h a ha) hsq
  · intro r φ
    simp
  · intro a b ha hb iha ihb φ
    rw [map_add, star_add, iha φ, ihb φ]
  · intro a ha iha φ
    rw [map_inv₀, star_inv₀, iha φ]
  · intro a b ha hb iha ihb φ
    rw [map_mul, star_mul, iha φ, ihb φ, mul_comm]

/-- **The multiquadratic field `ℚ(√a : a ∈ s)` is totally real whenever every `a ∈ s` is
nonnegative.**

Immediate from `multiQuad_le_maximalRealSubfield` and Mathlib's criterion
`NumberField.isTotallyReal_iff_le_maximalRealSubfield`. -/
theorem multiQuad_isTotallyReal_of_nonneg (s : Finset ℚ) (h : ∀ a ∈ s, 0 ≤ a) :
    NumberField.IsTotallyReal ↥(multiQuad s) :=
  (NumberField.isTotallyReal_iff_le_maximalRealSubfield (K := AlgebraicClosure ℚ)
    (E := (multiQuad s).toSubfield)).mpr (multiQuad_le_maximalRealSubfield s h)

end

end Work.QuadraticFields
