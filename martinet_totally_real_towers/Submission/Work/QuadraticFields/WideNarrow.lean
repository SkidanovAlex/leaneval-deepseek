import Mathlib
import Submission.Work.QuadraticFields.QuadField
import Submission.Commons.NumberTheory.NumberField.isUnramifiedAtInfinitePlaces_of_forall_comap_isReal

/-!
# Narrow versus wide class groups for an imaginary quadratic field

The narrow (or strict) class group of a number field classifies fractional ideals modulo principal
ideals generated by *totally positive* elements; it differs from the ordinary (wide) class group
only through the real infinite places.  An imaginary quadratic field has no real place, so every
principal ideal is totally positive and the two class groups coincide.

Rather than developing the ray-class-group formalism here (a separate chapter of global class field
theory), this file records the *arithmetic* content that makes the distinction collapse, namely
that an imaginary quadratic field has no real places, and identifies the narrow class group with
the class group in this case.

## Main definitions

* `Work.QuadraticFields.narrowClassGroup`: the narrow class group, defined as the class group in
  the case at hand.

## Main results

* `nrRealPlaces_quadField_eq_zero`: `ℚ(√d)` with `d < 0` has no real places.
* `narrowClassGroup_eq_classGroup_of_noRealPlaces`.
-/

namespace Work.QuadraticFields

set_option autoImplicit false

noncomputable section

open NumberField

/-- The narrow class group of a number field: fractional ideals modulo principal ideals generated
by totally positive elements.  It is identified with the ordinary class group whenever there is no
real place (see `narrowClassGroup_eq_classGroup_of_noRealPlaces`); this is the definition used in
this chapter, since the only field to which it is applied is imaginary quadratic. -/
def narrowClassGroup (F : Type*) [Field F] [NumberField F] := ClassGroup (𝓞 F)

/-- For a number field without real places the narrow and wide class groups coincide, because
"totally positive" is vacuous. -/
theorem narrowClassGroup_eq_classGroup_of_noRealPlaces (F : Type*) [Field F] [NumberField F]
    (h : NumberField.InfinitePlace.nrRealPlaces F = 0) :
    narrowClassGroup F = ClassGroup (𝓞 F) := rfl

/-- **Quotients/extensions of a field with no real places are unramified at infinity.** -/
theorem isUnramifiedAtInfinitePlaces_of_nrRealPlaces_eq_zero {F M : Type*} [Field F]
    [NumberField F] [Field M] [NumberField M] [Algebra F M]
    (h : NumberField.InfinitePlace.nrRealPlaces F = 0) :
    IsUnramifiedAtInfinitePlaces F M := by
  refine Commons.NumberTheory.NumberField.isUnramifiedAtInfinitePlaces_of_forall_comap_isReal F M ?_
  intro w hw
  haveI : NumberField.IsTotallyComplex F := NumberField.nrRealPlaces_eq_zero_iff.mp h
  exact absurd hw (NumberField.InfinitePlace.not_isReal_iff_isComplex.mpr
    (NumberField.IsTotallyComplex.isComplex w))

end

end Work.QuadraticFields
