import Mathlib
import Submission.Work.QuadraticFields.Ramification
import Submission.Work.QuadraticFields.ramificationIdx_eq_one_of_inertia_le_fixingSubgroup
import Submission.Work.QuadraticFields.inertia_le_fixingSubgroup_of_ramificationIdx
import Submission.Work.QuadraticFields.fixingSubgroup_iSup_finset

/-!
# Unramifiedness of a field generated by finitely many unramified normal subfields

Let `M/ℚ` be a Galois number field, `F ⊆ M` an intermediate field, `T` a finite index set and
`L i ⊆ M` intermediate fields with `F ⊔ (⨆ i ∈ T, L i) = ⊤`.  Suppose that each `L i` is a finite
normal extension of `ℚ` in which the rational prime `p` is unramified (every prime of `𝓞 (L i)`
above `p` has ramification index one).  Then every prime `𝔓` of `𝓞 M` above `p` is unramified over
`F`.

The proof combines three ingredients:

* the fixing subgroup of the supremum `⨆ i ∈ T, L i` is the intersection of the fixing subgroups
  of the `L i` (`fixingSubgroup_iSup_finset`);
* `p` unramified in the normal extension `L i/ℚ` forces the inertia group of a prime above `p` to
  lie in the fixing subgroup of `L i` (`inertia_le_fixingSubgroup_of_ramificationIdx`);
* if an inertia group is contained in the fixing subgroup of a `K` with `F ⊔ K = ⊤`, the
  corresponding prime is unramified over `F` (`ramificationIdx_eq_one_of_inertia_le_fixingSubgroup`).

## Main result

* `Work.QuadraticFields.isUnramifiedAt_of_finset_sup_eq_top`
-/

namespace Work.QuadraticFields

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open NumberField

/-- If `M/ℚ` is Galois, `F ⊔ (⨆ i ∈ T, L i) = ⊤`, each `L i` is finite and normal over `ℚ`, and
the rational prime `p` is unramified in each `L i`, then every prime `𝔓` of `𝓞 M` over `p` is
unramified over `𝓞 F`. -/
theorem isUnramifiedAt_of_finset_sup_eq_top {M : Type*} [Field M] [NumberField M]
    [IsGalois ℚ M] (F : IntermediateField ℚ M) {ι : Type*} (T : Finset ι)
    (L : ι → IntermediateField ℚ M) (p : ℕ) (hp : Nat.Prime p) (hsup : F ⊔ (⨆ i ∈ T, L i) = ⊤)
    (hfd : ∀ i ∈ T, FiniteDimensional ℚ ↥(L i)) (hnorm : ∀ i ∈ T, Normal ℚ ↥(L i))
    (hunr : ∀ i ∈ T, ∀ (𝔮 : Ideal (NumberField.RingOfIntegers ↥(L i))), 𝔮.IsPrime →
      ((p : NumberField.RingOfIntegers ↥(L i)) ∈ 𝔮) →
      𝔮.ramificationIdx (NumberField.RingOfIntegers ℚ) = 1)
    (𝔭 : Ideal (NumberField.RingOfIntegers ↥F)) (𝔓 : Ideal (NumberField.RingOfIntegers M))
    [𝔓.IsPrime] [𝔓.LiesOver 𝔭] (h𝔓 : (p : NumberField.RingOfIntegers M) ∈ 𝔓) :
    𝔓.ramificationIdx (NumberField.RingOfIntegers ↥F) = 1 := by
  -- The inertia group of `𝔓` is contained in the fixing subgroup of `⨆ i ∈ T, L i`.
  have hle : Ideal.inertia (M ≃ₐ[ℚ] M) 𝔓 ≤ (⨆ i ∈ T, L i).fixingSubgroup := by
    rw [fixingSubgroup_iSup_finset T L]
    refine le_iInf₂ fun i hi => ?_
    haveI : FiniteDimensional ℚ ↥(L i) := hfd i hi
    haveI : Normal ℚ ↥(L i) := hnorm i hi
    exact inertia_le_fixingSubgroup_of_ramificationIdx (L i) p hp 𝔓 h𝔓 (hunr i hi)
  -- With `F ⊔ (⨆ i ∈ T, L i) = ⊤`, this forces the ramification index over `F` to be one.
  exact ramificationIdx_eq_one_of_inertia_le_fixingSubgroup F (⨆ i ∈ T, L i) hsup 𝔭 𝔓 hle

end Work.QuadraticFields
