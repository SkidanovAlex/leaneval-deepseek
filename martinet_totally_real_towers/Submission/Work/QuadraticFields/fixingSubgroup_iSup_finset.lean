import Mathlib
import Submission.Work.QuadraticFields.Ramification

/-!
# The fixing subgroup of a finite supremum of intermediate fields

For intermediate fields `L i` of a (possibly infinite) extension `M / ℚ`, the subgroup of
`Gal(M/ℚ)` fixing the field generated by the `L i` with `i ∈ T` is the intersection of the
subgroups fixing the individual `L i`:

`(⨆ i ∈ T, L i).fixingSubgroup = ⨅ i ∈ T, (L i).fixingSubgroup`.

This is the order-reversing Galois-correspondence fact (`IntermediateField.fixingSubgroup` is the
left adjoint of `IntermediateField.fixedField`, `IntermediateField.le_iff_le`), here for the
`Finset`-indexed supremum so that no finiteness of the ambient extension is required.
-/

namespace Work.QuadraticFields

/-- The fixing subgroup of a `Finset`-indexed supremum of intermediate fields is the intersection
of the fixing subgroups of its terms. -/
theorem fixingSubgroup_iSup_finset {M : Type*} [Field M] [Algebra ℚ M] {ι : Type*} (T : Finset ι)
    (L : ι → IntermediateField ℚ M) :
    (⨆ i ∈ T, L i).fixingSubgroup = ⨅ i ∈ T, (L i).fixingSubgroup := by
  apply le_antisymm
  · -- every term of the supremum is fixed, and `fixingSubgroup` is antitone
    exact le_iInf₂ fun i h => IntermediateField.fixingSubgroup_antitone
      (le_iSup₂ (f := fun i (_ : i ∈ T) => L i) i h)
  · -- an automorphism fixing every term fixes their supremum
    rw [← IntermediateField.le_iff_le (H := ⨅ i ∈ T, (L i).fixingSubgroup) (K := ⨆ i ∈ T, L i)]
    exact iSup₂_le fun i h =>
      (IntermediateField.le_iff_le (H := ⨅ j ∈ T, (L j).fixingSubgroup) (K := L i)).mpr
        ((iInf_le (f := fun j => ⨅ (_ : j ∈ T), (L j).fixingSubgroup) i).trans
          (iInf_le (f := fun (_ : i ∈ T) => (L i).fixingSubgroup) h))

end Work.QuadraticFields
