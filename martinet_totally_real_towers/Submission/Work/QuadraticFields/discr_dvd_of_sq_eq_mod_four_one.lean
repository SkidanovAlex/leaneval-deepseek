import Mathlib
import Submission.Work.QuadraticFields.MultiquadraticInside
import Submission.Commons.NumberTheory.NumberField.discr_dvd_of_isIntegral_basis
import Submission.Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr

open Polynomial

namespace Work.QuadraticFields

set_option maxHeartbeats 1000000

/-- If `x : K` generates the number field `K` over `ℚ` and satisfies `x ^ 2 = a` with `a ≡ 1 (mod 4)`,
then the discriminant of `K` divides `a`.

The proof passes to the element `y = (1 + x) / 2`, which satisfies the monic integral equation
`y ^ 2 - y - c = 0` with `a = 4 c + 1`.  Hence `ℚ[y] = ℚ[x] = K` is a power basis, whose
discriminant is `discr (T ^ 2 - T - c) = 4 c + 1 = a`, and the discriminant of `K` divides the
discriminant of any integral `ℚ`-basis. -/
theorem discr_dvd_of_sq_eq_mod_four_one {K : Type*} [Field K] [NumberField K] (a : ℤ)
    (ha : a % 4 = 1) (x : K) (hx : x ^ 2 = algebraMap ℚ K (a : ℚ))
    (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤) : NumberField.discr K ∣ a := by
  -- write `a = 4 * c + 1`
  obtain ⟨c, hc⟩ : ∃ c : ℤ, a = 4 * c + 1 :=
    ⟨a / 4, by have h := Int.mul_ediv_add_emod a 4; rw [ha] at h; omega⟩
  have hcq : (a : ℚ) = 4 * (c : ℚ) + 1 := by
    have h : ((a : ℤ) : ℚ) = ((4 * c + 1 : ℤ) : ℚ) := by rw [hc]
    push_cast at h
    linarith
  have hq_eq : algebraMap ℚ K (a : ℚ) = 4 * algebraMap ℚ K (c : ℚ) + 1 := by
    have h := congr_arg (algebraMap ℚ K) hcq
    simpa using h
  -- the element `y = (1 + x) / 2`
  set y : K := (1 + x) / 2 with hy_def
  have hy_root : y ^ 2 - y - algebraMap ℚ K (c : ℚ) = 0 := by
    rw [hy_def]
    field_simp
    ring_nf
    rw [hx, hq_eq]
    ring
  have hcast : (algebraMap ℤ K (c : ℤ)) = algebraMap ℚ K (c : ℚ) := by
    rw [IsScalarTower.algebraMap_apply ℤ ℚ K (c : ℤ)]
    simp
  have hkeyZ : Polynomial.eval₂ (algebraMap ℤ K) y (X ^ 2 - X - C (c : ℤ) : ℤ[X])
      = y ^ 2 - y - algebraMap ℤ K (c : ℤ) := by
    rw [eval₂_sub, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
  have hkeyQ : Polynomial.eval₂ (algebraMap ℚ K) y (X ^ 2 - X - C (c : ℚ) : ℚ[X])
      = y ^ 2 - y - algebraMap ℚ K (c : ℚ) := by
    rw [eval₂_sub, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
  have hyintZ : IsIntegral ℤ y :=
    ⟨X ^ 2 - X - C (c : ℤ), by monicity!, by rw [hkeyZ, hcast]; exact hy_root⟩
  have hyintQ : IsIntegral ℚ y :=
    ⟨X ^ 2 - X - C (c : ℚ), by monicity!, by rw [hkeyQ]; exact hy_root⟩
  -- `y` also generates `K` over `ℚ`
  have hy_mem : y ∈ Algebra.adjoin ℚ ({y} : Set K) := Algebra.subset_adjoin (Set.mem_singleton y)
  have h2mem : (2 : K) ∈ Algebra.adjoin ℚ ({y} : Set K) := by simp
  have hx_eq : x = 2 * y - 1 := by rw [hy_def]; field_simp; ring
  have hxmem : x ∈ Algebra.adjoin ℚ ({y} : Set K) := by
    rw [hx_eq]
    exact Subalgebra.sub_mem _ (Subalgebra.mul_mem _ h2mem hy_mem) (Subalgebra.one_mem _)
  have hgen_y : Algebra.adjoin ℚ ({y} : Set K) = ⊤ := by
    rw [eq_top_iff, ← hgen]
    exact Algebra.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hxmem)
  -- the power basis generated by `y`
  let pb : PowerBasis ℚ K := PowerBasis.ofAdjoinEqTop (K := ℚ) (S := K) hyintQ hgen_y
  have hpbgen : pb.gen = y := PowerBasis.ofAdjoinEqTop_gen hyintQ hgen_y
  have hpb_dim : pb.dim = (minpoly ℚ y).natDegree :=
    PowerBasis.ofAdjoinEqTop_dim hyintQ hgen_y
  -- `minpoly ℚ y` divides `T ^ 2 - T - c`, so `pb.dim ≤ 2`
  have hf_monic : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).Monic := by monicity!
  have hf_nat : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).natDegree = 2 := by compute_degree!
  have hmin_dvd : minpoly ℚ y ∣ (X ^ 2 - X - C (c : ℚ) : ℚ[X]) := by
    refine minpoly.dvd ℚ y ?_
    rw [Polynomial.aeval_def, hkeyQ]
    exact hy_root
  have hmin_degle : (minpoly ℚ y).natDegree ≤ 2 := by
    have h := Monic.natDegree_le_of_dvd (minpoly.monic hyintQ) hf_monic.ne_zero hmin_dvd
    rwa [hf_nat] at h
  have hpb_le : pb.dim ≤ 2 := by rw [hpb_dim]; exact hmin_degle
  have hpb_pos : 0 < pb.dim := pb.dim_pos
  -- every element of the power basis is an algebraic integer
  have hpb_int : ∀ i : Fin pb.dim, IsIntegral ℤ (pb.basis i) := by
    intro i
    rw [PowerBasis.basis_eq_pow, hpbgen]
    exact hyintZ.pow _
  -- the discriminant of `K` divides the discriminant of the integral basis `pb.basis`
  obtain ⟨m, hm⟩ :=
    Commons.NumberTheory.NumberField.discr_dvd_of_isIntegral_basis (K := K) pb.basis hpb_int
  rcases (show pb.dim = 1 ∨ pb.dim = 2 by omega) with hdim | hdim
  · -- `K` is `ℚ`: the discriminant is `1`
    have hnat1 : (minpoly ℚ y).natDegree = 1 := by rw [← hpb_dim]; exact hdim
    have hdeg1 : (minpoly ℚ y).degree = 1 := by
      rw [Polynomial.degree_eq_natDegree (minpoly.monic hyintQ).ne_zero, hnat1]
      norm_num
    have hdisc : Algebra.discr ℚ pb.basis = 1 := by
      rw [← Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr (F := ℚ) (S := K) (pb := pb)]
      rw [hpbgen]
      exact Polynomial.discr_of_degree_eq_one hdeg1
    have hmZ : (1 : ℤ) = NumberField.discr K * m := by
      have h : (1 : ℚ) = (NumberField.discr K : ℚ) * (m : ℚ) := by
        rw [← hdisc]; exact hm
      exact_mod_cast h
    exact dvd_trans ⟨m, hmZ⟩ (one_dvd a)
  · -- `K` is quadratic and the discriminant is exactly `a`
    have hnat2 : (minpoly ℚ y).natDegree = 2 := by rw [← hpb_dim]; exact hdim
    have hmin_eq : minpoly ℚ y = (X ^ 2 - X - C (c : ℚ) : ℚ[X]) := by
      refine (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hyintQ) hf_monic
        hmin_dvd ?_).symm
      rw [hf_nat, hnat2]
    have hdiscpoly : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).discr = (a : ℚ) := by
      rw [Polynomial.discr_of_degree_eq_two
        (by compute_degree! : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).degree = 2)]
      simp only [coeff_sub, coeff_X_pow, coeff_X, coeff_C]
      norm_num
      linarith [hcq]
    have hdisc : Algebra.discr ℚ pb.basis = (a : ℚ) := by
      rw [← Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr (F := ℚ) (S := K) (pb := pb)]
      rw [hpbgen, hmin_eq, hdiscpoly]
    have hmZ : a = NumberField.discr K * m := by
      have h : (a : ℚ) = (NumberField.discr K : ℚ) * (m : ℚ) := by
        rw [← hdisc]; exact hm
      exact_mod_cast h
    exact ⟨m, hmZ⟩

end Work.QuadraticFields
