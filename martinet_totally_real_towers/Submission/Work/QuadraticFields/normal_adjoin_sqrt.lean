import Mathlib
import Submission.Work.QuadraticFields.MultiquadraticInside

namespace Work.QuadraticFields

open Polynomial IntermediateField

set_option linter.style.haveILetI false

/-- **Normality of `ℚ⟮x⟯` for a square root `x` of a rational number.**

Let `M` be a field extension of `ℚ` and let `x : M` satisfy `x ^ 2 = a` with `a : ℚ`.  Then the
subextension `ℚ⟮x⟯` generated by `x` is normal over `ℚ`: indeed `E := ℚ⟮x⟯` is a splitting field
of the polynomial `X ^ 2 - C a`, because `E` is generated by the root `x` of that polynomial and
the other root `-x` lies in `E` as well. -/
theorem normal_adjoin_sqrt {M : Type*} [Field M] [Algebra ℚ M] (a : ℚ) (x : M)
    (hx : x ^ 2 = algebraMap ℚ M a) :
    Normal ℚ ↥(IntermediateField.adjoin ℚ ({x} : Set M)) := by
  let E : IntermediateField ℚ M := IntermediateField.adjoin ℚ ({x} : Set M)
  let p : ℚ[X] := X ^ 2 - C a
  -- Over `ℚ` the algebra structure on `↥E` inherited from `M` agrees with the canonical one, so
  -- we may (and do) work with the inherited structure `E.algebra'` throughout.
  letI : Algebra ℚ ↥E := E.algebra'
  have hxE : x ∈ E := IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton x)
  let ξ : ↥E := ⟨x, hxE⟩
  have hp_ne : p ≠ 0 := (monic_X_pow_sub_C a (by norm_num : (2 : ℕ) ≠ 0)).ne_zero
  -- `ξ` is a square root of `a` inside `E`.
  have hξ : ξ ^ 2 = algebraMap ℚ ↥E a := by
    apply Subtype.ext
    change x ^ 2 = E.val (algebraMap ℚ ↥E a)
    rw [hx]
    exact (E.val.commutes a).symm
  -- `p` splits in `E`.
  have hsplit : (p.map (algebraMap ℚ ↥E)).Splits := by
    have hmap : p.map (algebraMap ℚ ↥E) = (X - C ξ) * (X + C ξ) := by
      rw [show p.map (algebraMap ℚ ↥E) = X ^ 2 - C (ξ ^ 2 : ↥E) from by
        simp [p, ← hξ]]
      rw [C_pow]
      ring
    rw [hmap]
    exact Splits.mul (Splits.X_sub_C ξ) (Splits.X_add_C ξ)
  -- The roots of `p` in `M` are exactly `x` and `-x`, so `E` is generated by them.
  have hEeq : E = IntermediateField.adjoin ℚ (p.rootSet M) := by
    have hroot : p.rootSet M = {y : M | y = x ∨ y = -x} := by
      ext y
      rw [mem_rootSet_of_ne hp_ne]
      constructor
      · intro hy
        have hy2 : y ^ 2 = x ^ 2 := by
          have h1 : y ^ 2 - algebraMap ℚ M a = 0 := by simpa [p, aeval_def] using hy
          rw [sub_eq_zero] at h1
          rw [h1, ← hx]
        have h2 : (y - x) * (y + x) = 0 := by
          rw [show (y - x) * (y + x) = y ^ 2 - x ^ 2 by ring, hy2, sub_self]
        rcases mul_eq_zero.mp h2 with h | h
        · left; rw [sub_eq_zero] at h; exact h
        · right; rw [add_eq_zero_iff_eq_neg] at h; exact h
      · rintro (rfl | rfl)
        · simp [p, hx, aeval_def]
        · simp [p, hx, aeval_def]
    rw [hroot]
    apply le_antisymm
    · apply IntermediateField.adjoin_le_iff.mpr
      intro y hy
      rw [Set.mem_singleton_iff] at hy
      subst hy
      exact IntermediateField.subset_adjoin ℚ _ (by simp)
    · apply IntermediateField.adjoin_le_iff.mpr
      intro y hy
      rcases hy with rfl | rfl
      · exact IntermediateField.subset_adjoin ℚ _ (by simp)
      · exact neg_mem (IntermediateField.subset_adjoin ℚ _ (by simp))
  have hisf : p.IsSplittingField ℚ ↥E :=
    (IntermediateField.isSplittingField_iff (K := ℚ) (L := M) (F := E) (p := p)).mpr
      ⟨hsplit, hEeq⟩
  have hnorm : Normal ℚ ↥E := Normal.of_isSplittingField p
  -- Transport the statement to the canonical `ℚ`-algebra structure on `↥E`.
  have hcast : (@Normal ℚ ↥E _ _ (inferInstance : Algebra ℚ ↥E) : Prop) =
      @Normal ℚ ↥E _ _ (DivisionRing.toRatAlgebra) :=
    congrArg (fun i => @Normal ℚ ↥E _ _ i) (Subsingleton.elim _ _)
  exact hcast.mp hnorm

end Work.QuadraticFields
