import Mathlib
import Submission.Work.QuadraticFields.MultiquadraticInside
import Submission.Work.QuadraticFields.discr_dvd_of_sq_eq
import Submission.Work.QuadraticFields.discr_dvd_of_sq_eq_mod_four_one
import Submission.Work.QuadraticFields.IsPrimeDiscriminant_emod_four_eq_one
import Submission.Work.QuadraticFields.ramificationIdx_eq_one_of_not_dvd_discr

/-!
# Primes coprime to a prime discriminant are unramified

Let `K` be a number field generated over `ℚ` by an element `x` with `x ^ 2 = d`, where `d` is a
*prime discriminant* (i.e. `-4`, `8`, `-8`, or `(-1)^((q-1)/2) q` for an odd prime `q`).  Then for
every rational prime `p` which does not divide `|d|`, every prime `P` of `𝓞 K` above `p` has
ramification index one over `ℚ`.

If `d` is odd, then `d ≡ 1 (mod 4)`, `K = ℚ(√d)` is generated by the algebraic integer
`(1 + √d)/2`, and its discriminant divides `d`; hence `p ∣ discr K` would force `p ∣ |d|`.
If `d` is even, then `d ∈ {-4, 8, -8}` and `discr K ∣ 4 d` is a power of two up to sign, so the
hypothesis `p ∤ |d|` (which makes `p` odd) again rules out `p ∣ discr K`.  In both cases
`ramificationIdx_eq_one_of_not_dvd_discr` finishes the argument.
-/

namespace Work.QuadraticFields

/-- A prime discriminant which is not odd is one of `-4`, `8`, `-8`: the fourth alternative in
`IsPrimeDiscriminant` is `(-1)^((q-1)/2) * q` with `q` an odd prime, which is odd. -/
private lemma eq_neg_four_or_eight_or_neg_eight_of_isPrimeDiscriminant_of_not_odd {d : ℤ}
    (hd : IsPrimeDiscriminant d) (h : ¬ Odd d) : d = -4 ∨ d = 8 ∨ d = -8 := by
  rcases hd with h4 | h8 | hm8 | ⟨q, _hq, hqodd, hqeq⟩
  · exact Or.inl h4
  · exact Or.inr (Or.inl h8)
  · exact Or.inr (Or.inr hm8)
  · exfalso
    apply h
    rw [hqeq]
    have h1 : Odd ((-1 : ℤ) ^ ((q - 1) / 2)) := by
      rcases neg_one_pow_eq_or ℤ ((q - 1) / 2) with hh | hh
      · rw [hh]; exact ⟨0, by norm_num⟩
      · rw [hh]; exact ⟨-1, by norm_num⟩
    exact h1.mul ((Int.odd_coe_nat q).mpr hqodd)

theorem ramificationIdx_one_of_isPrimeDiscriminant {K : Type*} [Field K] [NumberField K]
    (d : ℤ) (hd : IsPrimeDiscriminant d) (x : K) (hx : x ^ 2 = algebraMap ℚ K (d : ℚ))
    (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤)
    (p : ℕ) (hp : Nat.Prime p) (hpd : ¬ p ∣ d.natAbs)
    (P : Ideal (NumberField.RingOfIntegers K)) [P.IsPrime]
    (hPp : (p : NumberField.RingOfIntegers K) ∈ P) :
    P.ramificationIdx (NumberField.RingOfIntegers ℚ) = 1 := by
  refine ramificationIdx_eq_one_of_not_dvd_discr p hp ?_ P hPp
  by_cases hodd : Odd d
  · -- `d` odd: `discr K` divides the odd number `d`
    have h4 : d % 4 = 1 := IsPrimeDiscriminant_emod_four_eq_one hd hodd
    have hdvd : NumberField.discr K ∣ d := discr_dvd_of_sq_eq_mod_four_one d h4 x hx hgen
    intro hcon
    have hp_d : (p : ℤ) ∣ d := hcon.trans hdvd
    have hnat : p ∣ d.natAbs := by
      have h := Int.natAbs_dvd_natAbs.mpr hp_d
      rwa [Int.natAbs_natCast] at h
    exact hpd hnat
  · -- `d` even: `d ∈ {-4, 8, -8}` and `discr K ∣ 4 * d` is a power of two up to sign
    have hcases := eq_neg_four_or_eight_or_neg_eight_of_isPrimeDiscriminant_of_not_odd hd hodd
    have h2d : 2 ∣ d.natAbs := by rcases hcases with h | h | h <;> rw [h] <;> norm_num
    have hdvd : NumberField.discr K ∣ 4 * d := discr_dvd_of_sq_eq d x hx hgen
    intro hcon
    have h4d : (p : ℤ) ∣ 4 * d := hcon.trans hdvd
    have hp4d : p ∣ (4 * d).natAbs := by
      have h := Int.natAbs_dvd_natAbs.mpr h4d
      rwa [Int.natAbs_natCast] at h
    rw [Int.natAbs_mul] at hp4d
    norm_num at hp4d
    rcases (hp.dvd_mul).mp hp4d with hp4 | hpq
    · have hp4' : p ∣ (2 : ℕ) ^ 2 := by simpa using hp4
      have hp2 : p = 2 :=
        (Nat.dvd_prime_two_le Nat.prime_two hp.two_le).mp (hp.dvd_of_dvd_pow hp4')
      rw [← hp2] at h2d
      exact hpd h2d
    · exact hpd hpq

end Work.QuadraticFields
