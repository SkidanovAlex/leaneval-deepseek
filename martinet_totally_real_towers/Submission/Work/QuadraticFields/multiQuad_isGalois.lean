import Mathlib
import Submission.Work.QuadraticFields.QuadField

/-!
# The multiquadratic field `ℚ(√a : a ∈ s)` is Galois over `ℚ`

The multiquadratic field `multiQuad s = ℚ(√a : a ∈ s)` (inside a fixed algebraic closure of `ℚ`)
is generated by square roots, each of which has a minimal polynomial of degree `≤ 2`; every
`ℚ`-conjugate of a generator is again one of the generators (`√a` and `-√a`), so the extension is
normal, and in characteristic zero it is separable. Hence it is Galois.

## Main results

* `Work.QuadraticFields.splits_X_sq_sub_mul_self`: `X ^ 2 - C (c * c)` splits (into `(X - C c)`
  times `(X + C c)`) over any field.
* `Work.QuadraticFields.multiQuad_gen_splits`: the minimal polynomial of a generator `√a`
  (`a ∈ s`) splits over `↥(multiQuad s)` -- this is the generator condition of
  `IntermediateField.splits_of_mem_adjoin`.
* `Work.QuadraticFields.multiQuad_isGalois`: `ℚ(√a : a ∈ s)` is Galois over `ℚ`.
-/

namespace Work.QuadraticFields

set_option autoImplicit false

open Polynomial

noncomputable section

/-- `X ^ 2 - C (c * c)` factors as `(X - C c) * (X + C c)`, hence splits. -/
theorem splits_X_sq_sub_mul_self {M : Type*} [Field M] (c : M) :
    Splits ((X ^ 2 - C (c * c) : M[X])) := by
  have h : (X ^ 2 - C (c * c) : M[X]) = (X - C c) * (X + C c) := by
    rw [map_mul]; ring
  rw [h]
  exact Splits.mul (Splits.X_sub_C c) (Splits.X_add_C c)

/-- For `a ∈ s` the minimal polynomial over `ℚ` of the chosen square root `sqrtVal a` splits
over `↥(multiQuad s)`: indeed `minpoly ℚ (sqrtVal a)` divides `X ^ 2 - C a`, and the image of
`X ^ 2 - C a` in `↥(multiQuad s)[X]` is `X ^ 2 - C (c * c)` for the element
`c = sqrtVal a ∈ multiQuad s`, which factors into two linear factors. -/
theorem multiQuad_gen_splits (s : Finset ℚ) (a : ℚ) (ha : a ∈ s) :
    IsIntegral ℚ (sqrtVal a) ∧
      Splits ((minpoly ℚ (sqrtVal a)).map (algebraMap ℚ ↥(multiQuad s))) := by
  refine ⟨?_, ?_⟩
  · exact IsIntegral.of_pow (R := ℚ) (B := AlgebraicClosure ℚ) (n := 2) (by norm_num)
      (by rw [sqrtVal_sq]; exact isIntegral_algebraMap)
  · set c : ↥(multiQuad s) := ⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ with hc_def
    have hc : c * c = algebraMap ℚ ↥(multiQuad s) a := by
      apply Subtype.ext
      rw [IntermediateField.coe_mul, IntermediateField.coe_algebraMap_apply]
      rw [← pow_two, sqrtVal_sq]
    refine Splits.of_dvd (g := (X ^ 2 - C a : ℚ[X]).map (algebraMap ℚ ↥(multiQuad s))) ?_ ?_ ?_
    · have hmap : (X ^ 2 - C a : ℚ[X]).map (algebraMap ℚ ↥(multiQuad s))
          = X ^ 2 - C (c * c) := by
        rw [hc]; simp
      rw [hmap]
      exact splits_X_sq_sub_mul_self c
    · exact ((monic_X_pow_sub_C a (by norm_num : (2 : ℕ) ≠ 0)).map _).ne_zero
    · rw [map_dvd_map']
      refine minpoly.dvd ℚ (sqrtVal a) ?_
      rw [aeval_def, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
      simp [sqrtVal_sq]

/-- **The multiquadratic field is Galois over `ℚ`.** -/
theorem multiQuad_isGalois (s : Finset ℚ) : IsGalois ℚ ↥(multiQuad s) := by
  rw [isGalois_iff]
  refine ⟨inferInstance, ?_⟩
  rw [normal_iff]
  intro x
  refine ⟨Algebra.IsIntegral.isIntegral x, ?_⟩
  -- The minimal polynomial over `ℚ` of every element of `ℚ(√a : a ∈ s)` splits, because it
  -- suffices to check this on the generators `√a` (`IntermediateField.splits_of_mem_adjoin`).
  have hgen : ∀ y ∈ (sqrtVal '' (s : Set ℚ)), IsIntegral ℚ y ∧
      Splits ((minpoly ℚ y).map (algebraMap ℚ ↥(multiQuad s))) := by
    rintro y ⟨a, ha, rfl⟩
    exact multiQuad_gen_splits s a ha
  have hxmem : (x : AlgebraicClosure ℚ) ∈
      IntermediateField.adjoin ℚ (sqrtVal '' (s : Set ℚ)) := x.2
  have h := IntermediateField.splits_of_mem_adjoin (F := ℚ) (K := AlgebraicClosure ℚ)
    (L := ↥(multiQuad s)) (S := sqrtVal '' (s : Set ℚ)) hgen hxmem
  rw [← IntermediateField.minpoly_eq x] at h
  exact h

end

end Work.QuadraticFields
