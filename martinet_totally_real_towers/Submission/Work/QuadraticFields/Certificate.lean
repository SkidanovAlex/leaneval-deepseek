import Mathlib
import Submission.Work.QuadraticFields.QuadField
import Submission.Work.QuadraticFields.MultiquadraticInside
import Submission.Work.QuadraticFields.RankTwo
import Submission.Work.QuadraticFields.MultiquadraticInside

/-!
# The explicit numerical certificate for an imaginary quadratic field with `2`-rank `≥ 5`

The genus-theory input of the unramified-`2`-tower route is: an imaginary quadratic field `F`
whose `2`-rank (the number of independent unramified quadratic extensions, equivalently the number
of independent quadratic characters of the class group) is at least `5`.  By classical genus
theory this rank is `ω(|disc F|) - 1`, so any `F` with `ω(|disc F|) ≥ 6` works.

This file fixes the explicit field

  `F = ℚ(√(-3556995))`,   `disc F = -3556995 = -3·5·13·17·29·37`,

so that `ω(|disc F|) = 6`, and exhibits `M = ℚ(√-3, √5, √13, √17, √29, √37)` as an **unramified**
extension of `F` of degree `2^5 = 32`; the subfields `F(√-3), F(√5), F(√13), F(√17), F(√29)` are
five independent unramified quadratic extensions of `F`, and `F(√37)` is the fifth... sixth
generator, with the single relation `√-3·√5·√13·√17·√29·√37 = ±√(-3556995) ∈ F`.

## Main definitions

* `Work.QuadraticFields.certPrimes`: the six prime discriminants `-3, 5, 13, 17, 29, 37`.
* `Work.QuadraticFields.certM`: the multiquadratic field `M = ℚ(√Δ : Δ ∈ certPrimes)`.
* `Work.QuadraticFields.certBase`: the subfield `F = ℚ(√-3556995) ⊆ M`.
-/

namespace Work.QuadraticFields

set_option autoImplicit false

noncomputable section

/-- The six prime discriminants of the certificate, as integers. -/
def certPrimes : Finset ℤ := {-3, 5, 13, 17, 29, 37}

/-- The same six numbers as rationals. -/
def certPrimesQ : Finset ℚ := certPrimes.image (fun d : ℤ => (d : ℚ))

/-- The five prime discriminants used as the independent generators. -/
def certPrimes5 : Finset ℤ := {-3, 5, 13, 17, 29}

theorem certPrimes_card : certPrimes.card = 6 := by
  norm_num [certPrimes]

theorem certPrimesQ_card : certPrimesQ.card = 6 := by
  rw [certPrimesQ, Finset.card_image_of_injective _ (fun a b h => by exact_mod_cast h)]
  exact certPrimes_card

/-- The product of the six prime discriminants is the discriminant `-3556995` of the base field. -/
theorem certPrimes_prod : (∏ a ∈ certPrimes, (a : ℚ)) = -3556995 := by
  norm_num [certPrimes]

theorem certPrimes_odd : ∀ a ∈ certPrimes, Odd a := by
  intro a ha
  fin_cases ha <;> decide

theorem certPrimes_isPrimeDiscriminant (a : ℤ) (ha : a ∈ certPrimes) :
    IsPrimeDiscriminant a := by
  rw [certPrimes] at ha
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl
  · exact Or.inr (Or.inr (Or.inr ⟨3, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨5, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨13, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨17, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨29, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨37, by norm_num, by norm_num, by norm_num⟩))

/-- Distinct elements of `certPrimes` have coprime absolute values. -/
theorem certPrimes_coprime (a b : ℤ) (ha : a ∈ certPrimes) (hb : b ∈ certPrimes) (hne : a ≠ b) :
    Nat.Coprime a.natAbs b.natAbs := by
  rw [Nat.coprime_iff_gcd_eq_one]
  rw [certPrimes] at ha hb
  simp only [Finset.mem_insert, Finset.mem_singleton] at ha hb
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl <;>
    rcases hb with rfl | rfl | rfl | rfl | rfl | rfl <;>
    first
      | (exfalso; exact hne rfl)
      | (norm_num)

/-- The multiquadratic field `M = ℚ(√-3, √5, √13, √17, √29, √37)` of the certificate, as an
abstract number field, generated inside `AlgebraicClosure ℚ` by the chosen square roots. -/
abbrev certM : Type := ↥(multiQuad certPrimesQ)

/-- The chosen square roots of the certificate primes inside `M`. -/
def certRoot (a : ℤ) : certM :=
  if h : a ∈ certPrimes then
    (⟨sqrtVal (a : ℚ), sqrtVal_mem_multiQuad (s := certPrimesQ)
      (Finset.mem_image.mpr ⟨a, h, rfl⟩)⟩ : certM)
  else 1

theorem certRoot_of_mem {a : ℤ} (ha : a ∈ certPrimes) :
    certRoot a = (⟨sqrtVal (a : ℚ), sqrtVal_mem_multiQuad (s := certPrimesQ)
      (Finset.mem_image.mpr ⟨a, ha, rfl⟩)⟩ : certM) :=
  dif_pos ha

theorem certRoot_sq (a : ℤ) (ha : a ∈ certPrimes) :
    certRoot a ^ 2 = algebraMap ℚ certM (a : ℚ) := by
  rw [certRoot_of_mem ha]
  apply Subtype.ext
  change sqrtVal (a : ℚ) ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) (a : ℚ)
  rw [sqrtVal_sq]

/-- The base field `F = ℚ(√-3556995)` of the certificate, realised as the subfield of `M`
generated by the product of the six chosen square roots. -/
def certF : IntermediateField ℚ certM := prodSubfield certPrimes certRoot

end

end Work.QuadraticFields
