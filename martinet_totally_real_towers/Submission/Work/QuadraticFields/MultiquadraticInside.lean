import Mathlib
import Mathlib.NumberTheory.FundamentalDiscriminant

/-!
# Prime discriminants and multiquadratic extensions inside an abstract field

This file introduces the arithmetic notion of a *prime discriminant* and the shapes of the
multiquadratic data used by the genus-theory argument: a finite family of square roots inside an
abstract number field, the quadratic subfields they generate, and the "product" quadratic
subfield.

## Main definitions

* `Work.QuadraticFields.IsPrimeDiscriminant`: `-4`, `8`, `-8`, or `(-1)^((p-1)/2) p`.
* `Work.QuadraticFields.sqrtSubfield`: `ℚ⟮x a⟯` for a chosen family of square roots.
* `Work.QuadraticFields.prodSubfield`: `ℚ⟮∏ a ∈ s, x a⟧`.
-/

namespace Work.QuadraticFields

set_option autoImplicit false

/-- An integer is a **prime discriminant** if it is `-4`, `8`, `-8`, or `(-1)^((p-1)/2) · p` for an
odd prime `p`.  Equivalently, it is a fundamental discriminant which is (up to sign) a prime. -/
def IsPrimeDiscriminant (d : ℤ) : Prop :=
  d = -4 ∨ d = 8 ∨ d = -8 ∨
    ∃ p : ℕ, p.Prime ∧ Odd p ∧ d = (-1 : ℤ) ^ ((p - 1) / 2) * (p : ℤ)

/-- The quadratic subfield `ℚ⟮x a⟯` generated by a chosen square root `x a`. -/
def sqrtSubfield {M : Type*} [Field M] [Algebra ℚ M] (x : ℤ → M) (a : ℤ) :
    IntermediateField ℚ M :=
  IntermediateField.adjoin ℚ ({x a} : Set M)

/-- The quadratic subfield generated by the product of the chosen square roots. -/
def prodSubfield {M : Type*} [Field M] [Algebra ℚ M] (s : Finset ℤ) (x : ℤ → M) :
    IntermediateField ℚ M :=
  IntermediateField.adjoin ℚ ({∏ a ∈ s, x a} : Set M)

/-- The multiquadratic field generated by all the chosen square roots. -/
def multiquadSub {M : Type*} [Field M] [Algebra ℚ M] (s : Finset ℤ) (x : ℤ → M) :
    IntermediateField ℚ M :=
  IntermediateField.adjoin ℚ (x '' (s : Set ℤ))

end Work.QuadraticFields
