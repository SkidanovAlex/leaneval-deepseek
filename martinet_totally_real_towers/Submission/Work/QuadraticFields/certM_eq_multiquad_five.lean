import Mathlib
import Submission.Work.QuadraticFields.GenusCertificate

/-!
# The five fold multiquadratic subfield together with `F` is the whole of `M`

The certificate field is `M = ℚ(√-3, √5, √13, √17, √29, √37)` and `F = ℚ(√(-3556995))` is the
quadratic subfield generated by the product of the six chosen square roots
`√-3 · √5 · √13 · √17 · √29 · √37`.  Dropping the sixth square root still leaves the whole
multiquadratic field once `F` is adjoined:

  `ℚ(√-3, √5, √13, √17, √29) ⊔ F = M`,

because `√37` is the quotient of the product of all six roots by the product of the first five.

This is the "one generator is redundant modulo the product subfield" phenomenon: for a finite
family `x a` of nonzero square roots generating `M`, the multiquadratic field generated by all of
them except one, together with the quadratic subfield generated by their product, is again all of
`M`.  The general form is recorded as `multiquadSub_erase_sup_prodSubfield_eq_top`; the statement
of the present file is its specialisation to the certificate, used to identify `M` with the
compositum of a quintic multiquadratic subfield and the quadratic base field `F`.

## Main results

* `Work.QuadraticFields.multiquadSub_erase_sup_prodSubfield_eq_top`
* `Work.QuadraticFields.certM_eq_multiquad_five`
-/

namespace Work.QuadraticFields

set_option autoImplicit false

noncomputable section

/-- **One generator is redundant modulo the product subfield.**  Let `s` be a finite family of
(nonzero) elements `x a` in a field `M`, and let `M` be generated over `ℚ` by the `x a`.  Then
adjoining the product `∏ a ∈ s, x a` to the multiquadratic field generated by the `x a`,
`a ∈ s.erase a₀`, already gives the whole of `M`: indeed
`x a₀ = (∏ a ∈ s, x a) · (∏ a ∈ s.erase a₀, x a)⁻¹`. -/
lemma multiquadSub_erase_sup_prodSubfield_eq_top {M : Type*} [Field M] [Algebra ℚ M]
    (s : Finset ℤ) (x : ℤ → M) (hgen : multiquadSub s x = ⊤) {a₀ : ℤ} (ha₀ : a₀ ∈ s)
    (hnz : ∀ a ∈ s, x a ≠ 0) :
    multiquadSub (s.erase a₀) x ⊔ prodSubfield s x = ⊤ := by
  refine le_antisymm le_top ?_
  rw [← hgen, multiquadSub, IntermediateField.adjoin_le_iff]
  rintro y ⟨a, ha, rfl⟩
  by_cases h : a = a₀
  · -- The dropped generator `x a₀` is the quotient of the full product by the remaining product.
    subst h
    have hQ : (∏ b ∈ s.erase a, x b) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun b hb => hnz b (Finset.mem_of_mem_erase hb)
    have hmul : x a * (∏ b ∈ s.erase a, x b) = ∏ b ∈ s, x b := by
      rw [mul_comm]
      exact Finset.prod_erase_mul s (fun b => x b) ha
    have hxeq : x a = (∏ b ∈ s, x b) * (∏ b ∈ s.erase a, x b)⁻¹ := by
      rw [← hmul, mul_assoc, mul_inv_cancel₀ hQ, mul_one]
    rw [hxeq]
    refine mul_mem ?_ (inv_mem ?_)
    · refine le_sup_right (a := multiquadSub (s.erase a) x) ?_
      exact IntermediateField.subset_adjoin ℚ ({∏ b ∈ s, x b} : Set M) (Set.mem_singleton _)
    · refine le_sup_left (b := prodSubfield s x) ?_
      exact IntermediateField.prod_mem (S := multiquadSub (s.erase a) x)
        (fun b hb => IntermediateField.subset_adjoin ℚ
          ((fun c : ℤ => x c) '' ((s.erase a : Finset ℤ) : Set ℤ)) ⟨b, hb, rfl⟩)
  · -- The other generators lie in the multiquadratic field of the erased family.
    refine le_sup_left (b := prodSubfield s x) ?_
    exact IntermediateField.subset_adjoin ℚ
      ((fun c : ℤ => x c) '' (((s.erase a₀) : Finset ℤ) : Set ℤ))
      ⟨a, Finset.mem_erase.mpr ⟨h, ha⟩, rfl⟩

/-- `37` is the sixth certificate prime, the one not used among the five generators. -/
theorem cert37_mem : (37 : ℤ) ∈ certPrimes := by simp [certPrimes]

/-- Erasing the sixth generator from the certificate primes leaves the five generators. -/
theorem certPrimes_erase_37 : certPrimes.erase (37 : ℤ) = certPrimes5 := by
  ext a
  simp only [Finset.mem_erase, certPrimes, certPrimes5, Finset.mem_insert,
    Finset.mem_singleton]
  constructor
  · rintro ⟨hne, h⟩
    rcases h with h | h | h | h | h | h <;> simp_all
  · rintro (h | h | h | h | h) <;> simp_all

/-- The chosen certificate roots are nonzero, being square roots of prime discriminants. -/
theorem certRoot_ne_zero (a : ℤ) (ha : a ∈ certPrimes) : certRoot a ≠ 0 :=
  sqrt_ne_zero (certRoot a) (certRoot_sq a ha) (certPrimes_isPrimeDiscriminant a ha)

/-- **The quintic multiquadratic subfield together with `F` is everything.**  Erasing the sixth
generator `√37` from `M = ℚ(√-3, √5, √13, √17, √29, √37)` is harmless as soon as the quadratic
subfield `F = ℚ(√(-3556995))` generated by the product of all six roots is adjoined, because
`√37 = √(-3556995) / (√-3 · √5 · √13 · √17 · √29)`. -/
theorem certM_eq_multiquad_five :
    (multiquadSub certPrimes5 certRoot ⊔ certF : IntermediateField ℚ certM) = ⊤ := by
  have h := multiquadSub_erase_sup_prodSubfield_eq_top certPrimes certRoot certRoot_generates
    cert37_mem certRoot_ne_zero
  rw [certPrimes_erase_37] at h
  unfold certF
  exact h

end

end Work.QuadraticFields
