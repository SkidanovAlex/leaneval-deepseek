import Mathlib
import Submission.Work.QuadraticFields.QuadField
import Submission.Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr

/-!
# The discriminant of `ℚ(√d)` for squarefree `d`

Let `K` be a number field generated over `ℚ` by an element `x` with `x ^ 2 = d`, where `d` is a
squarefree integer.  Then `K = ℚ(√d)` is the quadratic field of discriminant
`d * (if d % 4 = 1 then 1 else 4)`, the *fundamental discriminant* attached to `d`: the ring of
integers of `K` is generated over `ℤ` by `x` when `d ≢ 1 (mod 4)`, and by `(1 + x) / 2` when
`d ≡ 1 (mod 4)`; in both cases the discriminant of the corresponding power basis is computed
directly.

The proof is self-contained and does not use the discriminant–index formula.  Its two ingredients
are

* the *integral trace* computation: if `y` is integral over `ℤ` and `y = a + b x`, then
  `2 a = Tr y ∈ ℤ`, `2 b d = Tr (x y) ∈ ℤ` and `b ^ 2 d - a ^ 2 = y ^ 2 - 2 a y ∈ ℤ`; together with
  the squarefreeness of `d` this gives `2 b ∈ ℤ` (because `d ∣ n ^ 2` forces `d ∣ n`);
* the mod-`4` computation on the element `y ^ 2 - 2 a y = (n ^ 2 d - m ^ 2)/4` with `m = 2a`,
  `n = 2b`.

## Main result

* `discr_eq_of_sq_eq_squarefree`: `discr K = d * (if d % 4 = 1 then 1 else 4)`.
-/

namespace Work.QuadraticFields

open Polynomial Module

open scoped NumberField

noncomputable section

/-- An element of `ℚ` is integral over `ℤ` (inside a `ℚ`-algebra) if and only if it is an
integer. -/
theorem exists_int_of_isIntegral_algebraMap {K : Type*} [Field K] [Algebra ℚ K] {q : ℚ}
    (h : IsIntegral ℤ (algebraMap ℚ K q)) : ∃ n : ℤ, q = (n : ℚ) := by
  have h' : IsIntegral ℤ q := (isIntegral_algebraMap_iff (B := K)).mp h
  obtain ⟨n, hn⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).mp h'
  exact ⟨n, hn.symm⟩

/-- A squarefree integer is not divisible by `4`. -/
theorem emod_four_ne_zero_of_squarefree {d : ℤ} (hd : Squarefree d) : d % 4 ≠ 0 := by
  intro h
  have h4 : (4 : ℤ) ∣ d := Int.dvd_of_emod_eq_zero h
  have h22 : (2 : ℤ) * 2 ∣ d := by simpa using h4
  obtain h1 | h1 := Int.isUnit_iff.mp (hd 2 h22) <;> norm_num at h1

/-- The mod-`4` consequences of `4 ∣ n ^ 2 * d - m ^ 2` when `d ≢ 1 (mod 4)`: both `m` and `n`
are even. -/
theorem two_dvd_of_four_dvd_sq_mul_sub_sq {m n d : ℤ} (hd : d % 4 = 2 ∨ d % 4 = 3)
    (h : 4 ∣ n ^ 2 * d - m ^ 2) : 2 ∣ m ∧ 2 ∣ n := by
  have hmod : (n ^ 2 * d) % 4 = m ^ 2 % 4 := by
    rw [Int.emod_eq_emod_iff_emod_sub_eq_zero]
    exact Int.emod_eq_zero_of_dvd h
  rcases hd with hd | hd
  · rw [Int.mul_emod, Int.sq_emod_four, hd, Int.sq_emod_four] at hmod
    rcases Int.emod_two_eq_zero_or_one n with hn | hn <;>
      rcases Int.emod_two_eq_zero_or_one m with hm | hm <;> omega
  · rw [Int.mul_emod, Int.sq_emod_four, hd, Int.sq_emod_four] at hmod
    rcases Int.emod_two_eq_zero_or_one n with hn | hn <;>
      rcases Int.emod_two_eq_zero_or_one m with hm | hm <;> omega

/-- The mod-`4` consequence of `4 ∣ n ^ 2 * d - m ^ 2` when `d ≡ 1 (mod 4)`: `m` and `n` have
the same parity. -/
theorem emod_two_eq_of_four_dvd_sq_mul_sub_sq_one {m n d : ℤ} (hd : d % 4 = 1)
    (h : 4 ∣ n ^ 2 * d - m ^ 2) : m % 2 = n % 2 := by
  have hmod : (n ^ 2 * d) % 4 = m ^ 2 % 4 := by
    rw [Int.emod_eq_emod_iff_emod_sub_eq_zero]
    exact Int.emod_eq_zero_of_dvd h
  rw [Int.mul_emod, Int.sq_emod_four, hd, Int.sq_emod_four] at hmod
  rcases Int.emod_two_eq_zero_or_one n with hn | hn <;>
    rcases Int.emod_two_eq_zero_or_one m with hm | hm <;> omega

/-- If `2 a ∈ ℤ`, `2 b d ∈ ℤ` and `b ^ 2 d - a ^ 2 ∈ ℤ` with `d` squarefree, then `2 b ∈ ℤ`.

Indeed, multiplying the last relation by `4 d` gives `n ^ 2 - m ^ 2 d = 4 d c` with `m = 2a` and
`n = 2bd`, so that `d ∣ n ^ 2`; squarefreeness of `d` yields `d ∣ n`, i.e. `2 b = n / d ∈ ℤ`. -/
theorem exists_two_mul_of_sub {a b : ℚ} {d m n c : ℤ} (hd : Squarefree d)
    (h1 : 2 * a = (m : ℚ)) (h2 : 2 * b * (d : ℚ) = (n : ℚ))
    (h3 : b ^ 2 * (d : ℚ) - a ^ 2 = (c : ℚ)) : ∃ n' : ℤ, 2 * b = (n' : ℚ) := by
  have hkey : (n : ℚ) ^ 2 = (m : ℚ) ^ 2 * d + 4 * (d : ℚ) * c := by
    have h1' : (m : ℚ) = 2 * a := h1.symm
    have h2' : (n : ℚ) = 2 * b * d := h2.symm
    have h3' : (c : ℚ) = b ^ 2 * d - a ^ 2 := h3.symm
    rw [h1', h2', h3']
    ring
  have hkeyZ : n ^ 2 = m ^ 2 * d + 4 * d * c := by exact_mod_cast hkey
  have hdn : d ∣ n ^ 2 := by
    rw [hkeyZ]
    have hfac : m ^ 2 * d + 4 * d * c = d * (m ^ 2 + 4 * c) := by ring
    rw [hfac]
    exact dvd_mul_right d _
  have hdn' : d ∣ n := (hd.dvd_pow_iff_dvd two_ne_zero).mp hdn
  obtain ⟨k, hk⟩ := hdn'
  refine ⟨k, ?_⟩
  have hkq : (n : ℚ) = (d : ℚ) * k := by exact_mod_cast hk
  have hd0 : (d : ℚ) ≠ 0 := by exact_mod_cast hd.ne_zero
  have hcancel : 2 * b * (d : ℚ) = (d : ℚ) * k := by rw [h2, hkq]
  have : 2 * b = (k : ℚ) := by
    field_simp at hcancel
    linarith
  exact this


/-- **The `2`-integrality of the coordinates.**  Let `K` be a quadratic number field generated by
`x` with `x ^ 2 = d`, where `d` is squarefree, and let `v` be the `ℚ`-basis `(1, x)`.  If `y` is
integral over `ℤ` and `y = a + b x` with coordinates `a = v.repr y 0`, `b = v.repr y 1`, then
`2 a ∈ ℤ`, `2 b ∈ ℤ` and `4 ∣ n ^ 2 d - m ^ 2` where `m = 2a`, `n = 2b`.

The proof uses the integrality of the traces of `y` and `x * y`, of the norm-like element
`y ^ 2 - 2 a y = b ^ 2 d - a ^ 2`, and the trace computations `Tr 1 = 2`, `Tr x = 0`,
`Tr x ^ 2 = 2 d` for the power basis of `x`. -/
theorem exists_two_mul_repr_and_dvd {K : Type*} [Field K] [NumberField K] {d : ℤ}
    (hd : Squarefree d) {x : K} (hx : x ^ 2 = algebraMap ℚ K (d : ℚ))
    (hint : IsIntegral ℚ x) (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤)
    (hmin : minpoly ℚ x = X ^ 2 - C (d : ℚ)) (hfr : Module.finrank ℚ K = 2)
    (v : Basis (Fin 2) ℚ K) (hv0 : v 0 = 1) (hv1 : v 1 = x)
    {y : K} (hy : IsIntegral ℤ y) :
    ∃ m n : ℤ, 2 * (v.repr y 0) = (m : ℚ) ∧ 2 * (v.repr y 1) = (n : ℚ) ∧
      4 ∣ n ^ 2 * d - m ^ 2 := by
  set a := v.repr y 0 with ha
  set b := v.repr y 1 with hb
  have hdec : y = a • (1 : K) + b • x := by
    have h := v.sum_repr y
    rw [Fin.sum_univ_two, hv0, hv1, ← ha, ← hb] at h
    exact h.symm
  have hdec' : y = algebraMap ℚ K a + algebraMap ℚ K b * x := by
    rw [hdec, Algebra.smul_def, Algebra.smul_def, mul_one]
  have hIntZ : IsIntegral ℤ x := IsIntegral.of_pow (n := 2) (by norm_num) (by
    rw [hx]; simpa using isIntegral_algebraMap (R := ℤ) (A := K) (x := d))
  have hT1 : Algebra.trace ℚ K (1 : K) = 2 := by
    rw [show (1 : K) = algebraMap ℚ K (1 : ℚ) by simp, Algebra.trace_algebraMap, hfr]
    norm_num
  have hTx : Algebra.trace ℚ K x = 0 := by
    have hnc : (X ^ 2 - C (d : ℚ) : ℚ[X]).nextCoeff = 0 := by
      rw [Polynomial.nextCoeff_of_natDegree_pos (by rw [natDegree_X_pow_sub_C]; norm_num),
        natDegree_X_pow_sub_C]
      show (X ^ 2 - C (d : ℚ)).coeff 1 = 0
      rw [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C]
      norm_num
    let pb : PowerBasis ℚ K := PowerBasis.ofAdjoinEqTop' hint hgen
    have hpbgen : pb.gen = x := PowerBasis.ofAdjoinEqTop'_gen hint hgen
    rw [← hpbgen, PowerBasis.trace_gen_eq_nextCoeff_minpoly, hpbgen, hmin, hnc, neg_zero]
  have hTx2 : Algebra.trace ℚ K (x ^ 2) = 2 * (d : ℚ) := by
    rw [hx, Algebra.trace_algebraMap, hfr]
    norm_num
  obtain ⟨m, hm⟩ : ∃ m : ℤ, 2 * a = (m : ℚ) := by
    have htr : IsIntegral ℤ (Algebra.trace ℚ K y) :=
      Algebra.isIntegral_trace (L := ℚ) (F := K) hy
    have hval : Algebra.trace ℚ K y = 2 * a := by
      nth_rewrite 1 [hdec]
      rw [map_add, map_smul, map_smul, hT1, hTx, smul_zero, add_zero, smul_eq_mul, mul_comm]
    rw [hval] at htr
    exact exists_int_of_isIntegral_algebraMap htr
  obtain ⟨n, hn⟩ : ∃ n : ℤ, 2 * b * (d : ℚ) = (n : ℚ) := by
    have htr : IsIntegral ℤ (Algebra.trace ℚ K (x * y)) :=
      Algebra.isIntegral_trace (L := ℚ) (F := K) (hIntZ.mul hy)
    have hval : Algebra.trace ℚ K (x * y) = 2 * b * (d : ℚ) := by
      have hxy : x * y = algebraMap ℚ K a * x + algebraMap ℚ K b * x ^ 2 := by
        nth_rewrite 1 [hdec']; ring
      rw [hxy, ← Algebra.smul_def, ← Algebra.smul_def, map_add, map_smul, map_smul, hTx, hTx2,
        smul_zero, zero_add, smul_eq_mul]
      ring
    rw [hval] at htr
    exact exists_int_of_isIntegral_algebraMap htr
  obtain ⟨c, hc⟩ : ∃ c : ℤ, b ^ 2 * (d : ℚ) - a ^ 2 = (c : ℚ) := by
    have hwval : y ^ 2 - (2 * a) • y = algebraMap ℚ K (b ^ 2 * (d : ℚ) - a ^ 2) := by
      rw [hdec', Algebra.smul_def]
      simp only [map_sub, map_mul, map_pow, map_ofNat]
      rw [← hx]
      ring
    have hwint : IsIntegral ℤ (y ^ 2 - (2 * a) • y) := by
      have h2a : (2 * a) • y = (m : K) * y := by
        rw [hm, Algebra.smul_def]
        simp
      rw [h2a]
      exact (hy.pow 2).sub ((isIntegral_algebraMap (R := ℤ) (A := K) (x := m)).mul hy)
    rw [hwval] at hwint
    exact exists_int_of_isIntegral_algebraMap hwint
  obtain ⟨n', hn'⟩ := exists_two_mul_of_sub hd hm hn hc
  refine ⟨m, n', hm, hn', ?_⟩
  refine ⟨c, ?_⟩
  refine Int.cast_injective (α := ℚ) ?_
  have hm' : (m : ℚ) = 2 * a := hm.symm
  have hn'' : (n' : ℚ) = 2 * b := hn'.symm
  push_cast
  rw [hm', hn'', ← hc]
  ring

/-- **Coordinates of an integral element in the basis `(1, x)`.**  If `z = m + n x` with `m`, `n`
integers then the coordinates of `z` in the basis `v` with `v 0 = 1`, `v 1 = x` are `m` and
`n`. -/
theorem repr_eq_of_eq_int_add_int_mul {K : Type*} [Field K] [NumberField K] {x : K}
    (v : Basis (Fin 2) ℚ K)
    (hv0 : v 0 = 1) (hv1 : v 1 = x) {z : K} {m n : ℤ}
    (hz : z = (m : K) + (n : K) * x) : (v.repr z) 0 = (m : ℚ) ∧ (v.repr z) 1 = (n : ℚ) := by
  have h1 : v.repr ((m : K)) = (m : ℚ) • v.repr (1 : K) := by
    rw [show (m : K) = (m : ℚ) • (1 : K) by simp, map_smul]
  have h2 : v.repr ((n : K) * x) = (n : ℚ) • v.repr x := by
    rw [show (n : K) * x = (n : ℚ) • x by rw [Algebra.smul_def]; simp, map_smul]
  have h3 : v.repr z = (m : ℚ) • v.repr (1 : K) + (n : ℚ) • v.repr x := by
    rw [hz, map_add, h1, h2]
  have e1 : v.repr (1 : K) = Finsupp.single (0 : Fin 2) (1 : ℚ) := by
    rw [← hv0, Module.Basis.repr_self]
  have e2 : v.repr x = Finsupp.single (1 : Fin 2) (1 : ℚ) := by
    rw [← hv1, Module.Basis.repr_self]
  constructor
  · rw [h3, e1, e2, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply]
    simp
  · rw [h3, e1, e2, Finsupp.add_apply, Finsupp.smul_apply, Finsupp.smul_apply]
    simp

/-- The discriminant of the number field is the discriminant of any `ℚ`-basis which is a
`ℤ`-basis of the ring of integers, expressed through the integrality of the two change of basis
matrices. -/
theorem coe_discr_eq_discr_of_toMatrix {K : Type*} [Field K] [NumberField K]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι ℚ K)
    (h : ∀ i j, IsIntegral ℤ (b.toMatrix (⇑(NumberField.integralBasis K)) i j))
    (h' : ∀ i j, IsIntegral ℤ ((NumberField.integralBasis K).toMatrix (⇑b) i j)) :
    (NumberField.discr K : ℚ) = Algebra.discr ℚ (⇑b) := by
  rw [NumberField.coe_discr]
  exact (Algebra.discr_eq_discr_of_toMatrix_coeff_isIntegral K h h').symm

/-- The discriminant of the power basis of a root of `T ^ 2 - a`. -/
theorem discr_powerBasis_sq {K : Type*} [Field K] [NumberField K] (pb : PowerBasis ℚ K) (a : ℤ)
    (hmin : minpoly ℚ pb.gen = X ^ 2 - C (a : ℚ)) :
    Algebra.discr ℚ pb.basis = ((4 * a : ℤ) : ℚ) := by
  rw [← Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr (F := ℚ) (S := K) (pb := pb)]
  rw [hmin]
  have hd : Polynomial.discr (X ^ 2 - C (a : ℚ) : ℚ[X]) = ((4 * a : ℤ) : ℚ) := by
    rw [Polynomial.discr_of_degree_eq_two
      (by compute_degree! : (X ^ 2 - C (a : ℚ) : ℚ[X]).degree = 2)]
    simp only [coeff_sub, coeff_X_pow, coeff_C]
    push_cast
    ring
  exact hd

/-- The discriminant of the power basis of a root of `T ^ 2 - T - c`. -/
theorem discr_powerBasis_jordan {K : Type*} [Field K] [NumberField K] (pb : PowerBasis ℚ K)
    (c : ℤ) (hmin : minpoly ℚ pb.gen = X ^ 2 - X - C (c : ℚ)) :
    Algebra.discr ℚ pb.basis = ((4 * c + 1 : ℤ) : ℚ) := by
  rw [← Commons.FieldTheory.Discriminant.discr_powerBasis_eq_discr (F := ℚ) (S := K) (pb := pb)]
  rw [hmin]
  have hd : Polynomial.discr (X ^ 2 - X - C (c : ℚ) : ℚ[X]) = ((4 * c + 1 : ℤ) : ℚ) := by
    rw [Polynomial.discr_of_degree_eq_two
      (by compute_degree! : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).degree = 2)]
    simp only [coeff_sub, coeff_sub, coeff_X_pow, coeff_X, coeff_C]
    push_cast
    ring
  exact hd


/-- **Discriminant–index formula.**  If `b` is a `ℚ`-basis of a number field `K` all of whose
elements are algebraic integers, then `discr ℚ b = discr K · z ^ 2` for some integer `z` (the
determinant of the change of basis from an integral basis of `K`). -/
theorem exists_discr_eq_discr_mul_sq_of_int_basis {K : Type*} [Field K] [NumberField K]
    {ι : Type*} [Fintype ι] [DecidableEq ι] (b : Basis ι ℚ K)
    (hb : ∀ i : ι, IsIntegral ℤ (b i)) :
    ∃ z : ℤ, Algebra.discr ℚ b = (NumberField.discr K : ℚ) * (z : ℚ) ^ 2 := by
  classical
  let κ := Module.Free.ChooseBasisIndex ℤ (NumberField.RingOfIntegers K)
  let c : Basis κ ℚ K := NumberField.integralBasis K
  let e : κ ≃ ι := (Module.Basis.indexEquiv c b)
  let c' : Basis ι ℚ K := c.reindex e
  have hcoords : ∀ i j : ι, IsIntegral ℤ (c'.toMatrix b i j) := by
    intro i j
    let y : NumberField.RingOfIntegers K := ⟨b j, hb j⟩
    have hy_elem : algebraMap (NumberField.RingOfIntegers K) K y = b j := rfl
    rw [Module.Basis.toMatrix_apply, Module.Basis.repr_reindex_apply, ← hy_elem]
    rw [NumberField.integralBasis_repr_apply]
    exact isIntegral_algebraMap
  have hdet : IsIntegral ℤ (c'.toMatrix b).det := IsIntegral.det hcoords
  obtain ⟨z, hz⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).1 hdet
  have hz' : (z : ℚ) = (c'.toMatrix b).det := by simpa using hz
  have hc' : Algebra.discr ℚ c' = Algebra.discr ℚ c := by
    calc
      Algebra.discr ℚ c' = Algebra.discr ℚ (⇑c ∘ ⇑e.symm) := by
        congr 1
        ext x
        simp [c', Module.Basis.reindex_apply]
      _ = Algebra.discr ℚ c := Algebra.discr_reindex (A := ℚ) (B := K) c e
  have hD : Algebra.discr ℚ c' = (NumberField.discr K : ℚ) := by
    rw [hc']
    exact (NumberField.coe_discr K).symm
  refine ⟨z, ?_⟩
  calc
    Algebra.discr ℚ b
        = Algebra.discr ℚ (Matrix.vecMul (⇑c' : ι → K)
            ((c'.toMatrix b).map (algebraMap ℚ K))) := by
          rw [Module.Basis.toMatrix_map_vecMul]
    _ = ((c'.toMatrix b).det ^ 2) * Algebra.discr ℚ c' := by
          exact Algebra.discr_of_matrix_vecMul (A := ℚ) (B := K) (b := (⇑c' : ι → K))
            (P := c'.toMatrix b)
    _ = ((z : ℚ) ^ 2) * Algebra.discr ℚ c' := by
          rw [← hz']
    _ = ((z : ℚ) ^ 2) * (NumberField.discr K : ℚ) := by
          rw [hD]
    _ = (NumberField.discr K : ℚ) * (z : ℚ) ^ 2 := by ring

/-- **The case `d ≢ 1 (mod 4)`.**  If `K = ℚ(√d)` with `d` squarefree and `d ≢ 1 (mod 4)`, then
`discr K = 4 d`.

Here the ring of integers is generated by `x` itself: the integrality of the traces of `y` and
`x y` and of `y ^ 2 - 2 a y` (where `y = a + b x`) shows `2 a, 2 b ∈ ℤ`, and the mod-`4` relation
forces both to be even.  Hence `(1, x)` is a `ℤ`-basis of `𝓞 K` and `discr K` is the discriminant
`4 d` of that basis. -/
theorem discr_eq_four_mul_of_sq_eq_squarefree_of_emod {K : Type*} [Field K] [NumberField K]
    {d : ℤ} (hd : Squarefree d) (h4 : d % 4 = 2 ∨ d % 4 = 3) (x : K)
    (hx : x ^ 2 = algebraMap ℚ K (d : ℚ)) (hint : IsIntegral ℚ x)
    (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤)
    (hmin : minpoly ℚ x = X ^ 2 - C (d : ℚ)) (hfr : Module.finrank ℚ K = 2) :
    NumberField.discr K = 4 * d := by
  let pb : PowerBasis ℚ K := PowerBasis.ofAdjoinEqTop' hint hgen
  have hpbgen : pb.gen = x := PowerBasis.ofAdjoinEqTop'_gen hint hgen
  have hdim : pb.dim = 2 := by
    rw [PowerBasis.ofAdjoinEqTop'_dim hint hgen, hmin, natDegree_X_pow_sub_C]
  let v : Basis (Fin 2) ℚ K := pb.basis.reindex (finCongr hdim)
  have hv0 : v 0 = 1 := by
    rw [Module.Basis.reindex_apply]
    show pb.basis ((finCongr hdim).symm 0) = 1
    rw [PowerBasis.basis_eq_pow]
    simp
  have hv1 : v 1 = x := by
    rw [Module.Basis.reindex_apply]
    show pb.basis ((finCongr hdim).symm 1) = x
    rw [PowerBasis.basis_eq_pow, hpbgen]
    simp
  have hIntZ : IsIntegral ℤ x := IsIntegral.of_pow (n := 2) (by norm_num) (by
    rw [hx]; simpa using isIntegral_algebraMap (R := ℤ) (A := K) (x := d))
  -- ## every integral element has integer coordinates in the basis `(1, x)`
  have hcoord : ∀ z : 𝓞 K, ∃ m n : ℤ,
      algebraMap (𝓞 K) K z = (m : K) + (n : K) * x := by
    intro z
    obtain ⟨m0, n0, hm0, hn0, h4dvd⟩ :=
      exists_two_mul_repr_and_dvd hd hx hint hgen hmin hfr v hv0 hv1 z.isIntegral_coe
    have hpar := two_dvd_of_four_dvd_sq_mul_sub_sq h4 h4dvd
    obtain ⟨m1, hm1⟩ := hpar.1
    obtain ⟨n1, hn1⟩ := hpar.2
    refine ⟨m1, n1, ?_⟩
    have hcm : (v.repr (algebraMap (𝓞 K) K z)) 0 = (m1 : ℚ) := by
      have h2 : (2 : ℚ) * (v.repr (algebraMap (𝓞 K) K z)) 0 = (m0 : ℚ) := hm0
      have h3 : (m0 : ℚ) = 2 * (m1 : ℚ) := by exact_mod_cast hm1
      linarith
    have hcn : (v.repr (algebraMap (𝓞 K) K z)) 1 = (n1 : ℚ) := by
      have h2 : (2 : ℚ) * (v.repr (algebraMap (𝓞 K) K z)) 1 = (n0 : ℚ) := hn0
      have h3 : (n0 : ℚ) = 2 * (n1 : ℚ) := by exact_mod_cast hn1
      linarith
    have hsum := v.sum_repr (algebraMap (𝓞 K) K z)
    rw [Fin.sum_univ_two, hcm, hcn, hv0, hv1] at hsum
    rw [← hsum, Algebra.smul_def, Algebra.smul_def, mul_one]
    simp
  -- ## the two change of basis matrices are integral
  have hb : ∀ i : Fin 2, IsIntegral ℤ (v i) := by
    intro i
    rcases (show i = 0 ∨ i = 1 by omega) with h | h <;> rw [h]
    · rw [hv0]; exact isIntegral_one
    · rw [hv1]; exact hIntZ
  have hcomp1 : ∀ i j, IsIntegral ℤ
      (v.toMatrix (⇑(NumberField.integralBasis K)) i j) := by
    intro i j
    rw [Module.Basis.toMatrix_apply, NumberField.integralBasis_apply]
    obtain ⟨m, n, hz⟩ := hcoord (NumberField.RingOfIntegers.basis K j)
    have h := repr_eq_of_eq_int_add_int_mul v hv0 hv1 hz
    rcases (show i = 0 ∨ i = 1 by omega) with hi | hi <;> rw [hi]
    · rw [h.1]; exact isIntegral_algebraMap
    · rw [h.2]; exact isIntegral_algebraMap
  have hcomp2 : ∀ i j, IsIntegral ℤ
      ((NumberField.integralBasis K).toMatrix (⇑v) i j) := by
    intro i j
    rw [Module.Basis.toMatrix_apply]
    obtain ⟨y, hy⟩ : ∃ y : 𝓞 K, algebraMap (𝓞 K) K y = v j :=
      ⟨⟨v j, (mem_integralClosure_iff ℤ K).mpr (hb j)⟩, NumberField.RingOfIntegers.map_mk (v j) _⟩
    rw [← hy, NumberField.integralBasis_repr_apply]
    exact isIntegral_algebraMap
  have hdiscr : (NumberField.discr K : ℚ) = Algebra.discr ℚ (⇑v) :=
    coe_discr_eq_discr_of_toMatrix v hcomp1 hcomp2
  -- ## the discriminant of the basis `(1, x)`
  have hdiscv : Algebra.discr ℚ (⇑v) = 4 * (d : ℚ) := by
    have hv_eq : (⇑v : Fin 2 → K) = ⇑pb.basis ∘ ⇑(finCongr hdim).symm := by
      funext i
      rw [Module.Basis.reindex_apply]
      rfl
    have hmin' : minpoly ℚ pb.gen = X ^ 2 - C (d : ℚ) := by rw [hpbgen]; exact hmin
    rw [hv_eq, Algebra.discr_reindex (A := ℚ) (B := K) pb.basis (finCongr hdim),
      discr_powerBasis_sq pb d hmin']
    push_cast
    ring
  refine Int.cast_injective (α := ℚ) ?_
  rw [hdiscr, hdiscv]
  push_cast
  ring

/-- **The case `d ≡ 1 (mod 4)`.**  If `K = ℚ(√d)` with `d` squarefree and `d ≡ 1 (mod 4)`, then
`discr K = d`.

Here `(1 + x) / 2` is an algebraic integer generating `K` with minimal polynomial
`T ^ 2 - T - c`, `d = 4 c + 1`, so its power basis has discriminant `d` and the
discriminant–index formula exhibits `d = discr K · z ^ 2`; squarefreeness of `d` forces `z = ±1`. -/
theorem discr_eq_of_sq_eq_squarefree_of_emod_one {K : Type*} [Field K] [NumberField K]
    {d : ℤ} (hd : Squarefree d) (h4 : d % 4 = 1) (x : K)
    (hx : x ^ 2 = algebraMap ℚ K (d : ℚ))
    (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤)
    (hfr : Module.finrank ℚ K = 2) :
    NumberField.discr K = d := by
  obtain ⟨c, hc⟩ : ∃ c : ℤ, d = 4 * c + 1 :=
    ⟨d / 4, by have h := Int.mul_ediv_add_emod d 4; rw [h4] at h; omega⟩
  have hcq : (d : ℚ) = 4 * (c : ℚ) + 1 := by
    have h : ((d : ℤ) : ℚ) = ((4 * c + 1 : ℤ) : ℚ) := by rw [hc]
    push_cast at h
    linarith
  have hq_eq : algebraMap ℚ K (d : ℚ) = 4 * algebraMap ℚ K (c : ℚ) + 1 := by
    have h := congr_arg (algebraMap ℚ K) hcq
    simpa using h
  set y : K := (1 + x) / 2 with hy_def
  have hy_root : y ^ 2 - y - algebraMap ℚ K (c : ℚ) = 0 := by
    rw [hy_def]
    field_simp
    ring_nf
    rw [hx, hq_eq]
    ring
  have hcast : (algebraMap ℤ K (c : ℤ)) = algebraMap ℚ K (c : ℚ) := by
    rw [IsScalarTower.algebraMap_apply ℤ ℚ K (c : ℤ)]
    simp
  have hkeyZ : Polynomial.eval₂ (algebraMap ℤ K) y (X ^ 2 - X - C (c : ℤ) : ℤ[X])
      = y ^ 2 - y - algebraMap ℤ K (c : ℤ) := by
    rw [eval₂_sub, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
  have hyintZ : IsIntegral ℤ y :=
    ⟨X ^ 2 - X - C (c : ℤ), by monicity!, by rw [hkeyZ, hcast]; exact hy_root⟩
  have hkeyQ : Polynomial.eval₂ (algebraMap ℚ K) y (X ^ 2 - X - C (c : ℚ) : ℚ[X])
      = y ^ 2 - y - algebraMap ℚ K (c : ℚ) := by
    rw [eval₂_sub, eval₂_sub, eval₂_pow, eval₂_X, eval₂_C]
  have hyintQ : IsIntegral ℚ y :=
    ⟨X ^ 2 - X - C (c : ℚ), by monicity!, by rw [hkeyQ]; exact hy_root⟩
  have hy_mem : y ∈ Algebra.adjoin ℚ ({y} : Set K) :=
    Algebra.subset_adjoin (Set.mem_singleton y)
  have h2mem : (2 : K) ∈ Algebra.adjoin ℚ ({y} : Set K) := by simp
  have hx_eq : x = 2 * y - 1 := by rw [hy_def]; field_simp; ring
  have hxmem : x ∈ Algebra.adjoin ℚ ({y} : Set K) := by
    rw [hx_eq]
    exact Subalgebra.sub_mem _ (Subalgebra.mul_mem _ h2mem hy_mem) (Subalgebra.one_mem _)
  have hgen_y : Algebra.adjoin ℚ ({y} : Set K) = ⊤ := by
    rw [eq_top_iff, ← hgen]
    exact Algebra.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hxmem)
  -- the minimal polynomial of `y` is `T ^ 2 - T - c`
  have hmonic : (X ^ 2 - X - C (c : ℚ) : ℚ[X]).Monic := by monicity!
  have hdvd_y : minpoly ℚ y ∣ (X ^ 2 - X - C (c : ℚ) : ℚ[X]) :=
    minpoly.dvd ℚ y (by rw [Polynomial.aeval_def, hkeyQ]; exact hy_root)
  have hnat : (minpoly ℚ y).natDegree = 2 := by
    rw [← PowerBasis.ofAdjoinEqTop'_dim hyintQ hgen_y,
      ← PowerBasis.finrank (PowerBasis.ofAdjoinEqTop' hyintQ hgen_y), hfr]
  have hminy : minpoly ℚ y = X ^ 2 - X - C (c : ℚ) :=
    (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hyintQ) hmonic hdvd_y
      (by rw [hnat, show (X ^ 2 - X - C (c : ℚ) : ℚ[X]).natDegree = 2 from by compute_degree!]
          )).symm
  -- power basis of `y` and its discriminant `d`
  let pby : PowerBasis ℚ K := PowerBasis.ofAdjoinEqTop' hyintQ hgen_y
  have hpygen : pby.gen = y := PowerBasis.ofAdjoinEqTop'_gen hyintQ hgen_y
  have hminy' : minpoly ℚ pby.gen = X ^ 2 - X - C (c : ℚ) := by
    rw [hpygen]; exact hminy
  have hdisc : Algebra.discr ℚ pby.basis = (d : ℚ) := by
    rw [discr_powerBasis_jordan pby c hminy', hc]
  obtain ⟨z, hz⟩ := exists_discr_eq_discr_mul_sq_of_int_basis (K := K) pby.basis (fun i => by
    rw [PowerBasis.basis_eq_pow, hpygen]
    exact hyintZ.pow _)
  have hdz : d = NumberField.discr K * z ^ 2 := by
    refine Int.cast_injective (α := ℚ) ?_
    rw [Int.cast_mul, Int.cast_pow, ← hz, hdisc]
  have hunit : IsUnit z := hd z (⟨NumberField.discr K, by rw [hdz, pow_two]; ring⟩)
  obtain hz1 | hz1 := Int.isUnit_iff.mp hunit <;> rw [hz1] at hdz <;> simpa using hdz.symm

/-- **The discriminant of `ℚ(√d)`.**  If the number field `K` is generated over `ℚ` by an element
`x` with `x ^ 2 = d`, where `d` is a squarefree integer, then `K = ℚ(√d)` is quadratic and its
discriminant is the fundamental discriminant of `d`, namely `d` if `d ≡ 1 (mod 4)` and `4 d`
otherwise. -/
theorem discr_eq_of_sq_eq_squarefree {K : Type*} [Field K] [NumberField K] {d : ℤ}
    (hd : Squarefree d) (x : K) (hx : x ^ 2 = algebraMap ℚ K (d : ℚ))
    (hgen : Algebra.adjoin ℚ ({x} : Set K) = ⊤) :
    NumberField.discr K = d * (if d % 4 = 1 then 1 else 4) := by
  have hIntQ : IsIntegral ℚ x :=
    IsIntegral.of_pow (n := 2) (by norm_num) (by rw [hx]; exact isIntegral_algebraMap)
  have hIntZ : IsIntegral ℤ x := IsIntegral.of_pow (n := 2) (by norm_num) (by
    rw [hx]; simpa using isIntegral_algebraMap (R := ℤ) (A := K) (x := d))
  by_cases hd1 : d = 1
  · -- ## `d = 1`: `K = ℚ`
    subst hd1
    have hx1 : x ^ 2 = 1 := by rw [hx]; norm_num
    have hxpm : x = 1 ∨ x = -1 := by
      have h : (x - 1) * (x + 1) = 0 := by linear_combination hx1
      rcases mul_eq_zero.mp h with h | h
      · exact Or.inl (by linear_combination h)
      · exact Or.inr (by linear_combination h)
    have htop : (⊤ : Subalgebra ℚ K) ≤ ⊥ := by
      rw [← hgen]
      refine Algebra.adjoin_le_iff.mpr ?_
      rintro z hz
      rw [Set.mem_singleton_iff] at hz
      subst hz
      rcases hxpm with h | h <;> rw [h]
      · exact Subalgebra.one_mem _
      · exact Subalgebra.neg_mem _ (Subalgebra.one_mem _)
    have hsurj : Function.Surjective (algebraMap ℚ K) := by
      intro z
      have hz : z ∈ (⊥ : Subalgebra ℚ K) := htop Algebra.mem_top
      rwa [Algebra.mem_bot] at hz
    have hbij : Function.Bijective (Algebra.ofId ℚ K) :=
      ⟨fun a b h => (algebraMap ℚ K).injective (by simpa [Algebra.ofId_apply] using h),
        fun z => by
          obtain ⟨q, hq⟩ := hsurj z
          exact ⟨q, by simpa [Algebra.ofId_apply] using hq⟩⟩
    have e : ℚ ≃ₐ[ℚ] K := AlgEquiv.ofBijective (Algebra.ofId ℚ K) hbij
    have hdisc : NumberField.discr K = 1 := by
      rw [← NumberField.discr_eq_discr_of_algEquiv ℚ e]
      exact NumberField.discr_rat
    rw [hdisc, ite_eq_left (by norm_num : (1 : ℤ) % 4 = 1), mul_one]
  · -- ## `d ≠ 1`: `K` is quadratic
    have hx_notin : x ∉ (algebraMap ℚ K).range := by
      rintro ⟨q, hq⟩
      have hqint : IsIntegral ℤ q := (isIntegral_algebraMap_iff (B := K)).mp (hq ▸ hIntZ)
      obtain ⟨n, hn⟩ := (IsIntegrallyClosed.isIntegral_iff (R := ℤ) (K := ℚ)).mp hqint
      have h1 : algebraMap ℚ K (d : ℚ) = algebraMap ℚ K (q ^ 2) := by
        rw [← hx, ← hq, map_pow]
      have h2 : (d : ℚ) = q ^ 2 := (algebraMap ℚ K).injective h1
      have hdn : d = n ^ 2 := by
        have h3 : (d : ℚ) = (n : ℚ) ^ 2 := by
          rw [h2, ← hn]
          simp
        exact_mod_cast h3
      have hunit : IsUnit n := hd n (by rw [hdn, pow_two])
      rcases Int.isUnit_iff.mp hunit with h1 | h1
      · exact hd1 (by rw [h1] at hdn; simpa using hdn)
      · exact hd1 (by rw [h1] at hdn; simpa using hdn)
    have hmonic : (X ^ 2 - C (d : ℚ) : ℚ[X]).Monic := monic_X_pow_sub_C _ (by norm_num)
    have hdvd : minpoly ℚ x ∣ (X ^ 2 - C (d : ℚ) : ℚ[X]) := by
      rw [minpoly.dvd_iff]
      rw [map_sub, map_pow, aeval_X, aeval_C, hx, sub_self]
    have h2le : 2 ≤ (minpoly ℚ x).natDegree :=
      (minpoly.two_le_natDegree_iff hIntQ).mpr hx_notin
    have hmin : minpoly ℚ x = X ^ 2 - C (d : ℚ) :=
      (Polynomial.eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hIntQ) hmonic hdvd
        (by rw [natDegree_X_pow_sub_C]; exact h2le)).symm
    have hfr : Module.finrank ℚ K = 2 := by
      rw [PowerBasis.finrank (PowerBasis.ofAdjoinEqTop' hIntQ hgen),
        PowerBasis.ofAdjoinEqTop'_dim hIntQ hgen, hmin, natDegree_X_pow_sub_C]
    have hmod_lt : d % 4 < 4 := Int.emod_lt_of_pos d (by norm_num)
    have hmod_nn : 0 ≤ d % 4 := Int.emod_nonneg d (by norm_num)
    have hmod_ne : d % 4 ≠ 0 := emod_four_ne_zero_of_squarefree hd
    rcases (show d % 4 = 1 ∨ d % 4 = 2 ∨ d % 4 = 3 by omega) with h4 | h4 | h4
    · rw [discr_eq_of_sq_eq_squarefree_of_emod_one hd h4 x hx hgen hfr,
        ite_eq_left h4, mul_one]
    · rw [discr_eq_four_mul_of_sq_eq_squarefree_of_emod hd (Or.inl h4) x hx hIntQ hgen hmin hfr,
        ite_eq_right (by omega : ¬ d % 4 = 1)]
      ring
    · rw [discr_eq_four_mul_of_sq_eq_squarefree_of_emod hd (Or.inr h4) x hx hIntQ hgen hmin hfr,
        ite_eq_right (by omega : ¬ d % 4 = 1)]
      ring

end

