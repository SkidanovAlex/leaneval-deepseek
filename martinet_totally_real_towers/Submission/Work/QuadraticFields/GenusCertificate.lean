/-!
# The genus-theory certificate: an unramified extension of `ℚ(√-3556995)` of degree `32`

This file assembles the explicit numerical certificate of imaginary-quadratic genus theory: the
multiquadratic field `M = ℚ(√-3, √5, √13, √17, √29, √37)` is an unramified Galois extension of
`F = ℚ(√-3556995)` of degree `2^5 = 32`.  Equivalently, `F` has five independent unramified
quadratic extensions, so the `2`-rank of the unramified `2`-class group of `F` is at least `5`
(by genus theory it is exactly `ω(3556995) - 1 = 5`).

## Main results

* `cert_unramified`: `M/F` is unramified at all finite primes.
* `cert_finrank`: `[M : F] = 32`.
-/

namespace Work.QuadraticFields

set_option autoImplicit false

noncomputable section

set_option maxHeartbeats 1000000

theorem certPrimesQ_nonsquare' (T : Finset certPrimesQ) (hT : T.Nonempty) :
    ∀ r : ℚ, r ^ 2 ≠ ∏ i ∈ T, ((i : certPrimesQ) : ℚ) := by
  intro r hr
  have hsub : (T.image (fun i : certPrimesQ => (i : ℚ))) ⊆ certPrimesQ := by
    intro x hx
    obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hx
    exact j.2
  have hne : (T.image (fun i : certPrimesQ => (i : ℚ))).Nonempty := hT.image _
  have hprod : (∏ i ∈ T, ((i : certPrimesQ) : ℚ)) =
      ∏ a ∈ T.image (fun i : certPrimesQ => (i : ℚ)), a :=
    (Finset.prod_image (f := fun a : ℚ => a) (g := fun i : certPrimesQ => (i : ℚ))
      (s := T) (fun x _ y _ hxy => Subtype.ext hxy)).symm
  exact certPrimesQ_nonsquare hsub hne r (by rw [← hprod]; exact hr)

theorem certM_finrank : Module.finrank ℚ certM = 64 := by
  have h := multiQuad_finrank certPrimesQ certPrimesQ_nonsquare'
  rw [certPrimesQ_card] at h
  norm_num at h
  exact h

theorem certF_finrank : Module.finrank ℚ ↥certF = 2 := by
  have hprod : (∏ a ∈ certPrimes, certRoot a) ^ 2 = algebraMap ℚ certM (-3556995 : ℚ) := by
    rw [← Finset.prod_pow]
    rw [Finset.prod_congr rfl (fun a ha => certRoot_sq a ha)]
    rw [← map_prod]
    congr 1
    exact_mod_cast certPrimes_prod
  have hns : ∀ r : ℚ, r ^ 2 ≠ (-3556995 : ℚ) := by
    intro r hr
    have h1 : (0 : ℚ) ≤ r ^ 2 := sq_nonneg r
    rw [hr] at h1
    norm_num at h1
  have h := finrank_adjoin_sq_eq_two (M := certM) (-3556995 : ℚ) (∏ a ∈ certPrimes, certRoot a)
    hprod hns
  unfold certF prodSubfield
  exact h

/-- **Genus theory, in Kummer form.**  Let `s` be a finite family of pairwise coprime prime
discriminants, `x` a compatible choice of square roots in a Galois number field `M/ℚ` which they
generate, and let `F = ℚ(√(∏ s)) ⊆ M` be the quadratic subfield generated by the product.  Then the
multiquadratic field `M` is an unramified extension of `F`, of degree `2 ^ (|s| - 1)` over it.

With `|s| = ω(|disc F|)` — the number of prime discriminants in the factorisation of the
fundamental discriminant of `F` — this says that an imaginary quadratic field `F` has
`ω(|disc F|) - 1` independent unramified quadratic extensions: the lower bound of classical genus
theory. -/
theorem genus_lower_bound {M : Type*} [Field M] [NumberField M] [IsGalois ℚ M]
    (s : Finset ℤ) (x : ℤ → M) (hx : ∀ a ∈ s, x a ^ 2 = algebraMap ℚ M (a : ℚ))
    (hgen : multiquadSub s x = ⊤) (hcard : 2 ≤ s.card)
    (hd : ∀ a ∈ s, IsPrimeDiscriminant a)
    (hcop : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → Nat.Coprime a.natAbs b.natAbs)
    (hdegM : Module.finrank ℚ M = 2 ^ s.card)
    (hdegF : Module.finrank ℚ ↥(prodSubfield s x) = 2) :
    IsUnramifiedAtFinitePrimes ↥(prodSubfield s x) M ∧
      Module.finrank ↥(prodSubfield s x) M = 2 ^ (s.card - 1) := by
  have hunr := isUnramifiedAtFinitePrimes_multiQuad s x hx hgen hcard hd hcop
  refine ⟨hunr, ?_⟩
  have htower := Module.finrank_mul_finrank ℚ ↥(prodSubfield s x) M
  rw [hdegM, hdegF] at htower
  have hpow : 2 ^ s.card = 2 * 2 ^ (s.card - 1) := by
    rw [← pow_succ']
    congr 1
    omega
  omega

/-- **`M/F` is unramified at all finite primes.** -/
theorem cert_unramified : IsUnramifiedAtFinitePrimes ↥certF certM := by
  haveI : IsGalois ℚ certM := multiQuad_isGalois certPrimesQ
  exact isUnramifiedAtFinitePrimes_multiQuad (M := certM) certPrimes certRoot certRoot_sq
    certRoot_generates (by rw [certPrimes_card]; norm_num) certPrimes_isPrimeDiscriminant
    (fun a ha b hb hne => certPrimes_coprime a b ha hb hne)

/-- **`[M : F] = 32 = 2 ^ 5`.** -/
theorem cert_finrank : Module.finrank ↥certF certM = 32 := by
  have h := Module.finrank_mul_finrank ℚ ↥certF certM
  rw [certF_finrank, certM_finrank] at h
  omega

/-- **The explicit genus-theory certificate.**  The multiquadratic field
`M = ℚ(√-3, √5, √13, √17, √29, √37)` is an unramified extension of `F = ℚ(√-3556995)` of
degree `2 ^ 5 = 32`; equivalently `F` has five independent unramified quadratic extensions. -/
theorem cert_certificate : IsUnramifiedAtFinitePrimes ↥certF certM ∧
    Module.finrank ↥certF certM = 32 :=
  ⟨cert_unramified, cert_finrank⟩

end

end Work.QuadraticFields
