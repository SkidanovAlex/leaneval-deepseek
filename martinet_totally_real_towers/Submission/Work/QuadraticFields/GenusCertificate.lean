import Mathlib
import Submission.Work.QuadraticFields.Certificate
import Submission.Work.QuadraticFields.QuadField
import Submission.Work.QuadraticFields.MultiquadraticInside
import Submission.Work.QuadraticFields.Ramification
import Submission.Work.QuadraticFields.multiQuad_finrank
import Submission.Work.QuadraticFields.finrank_adjoin_sq_eq_two
import Submission.Work.QuadraticFields.multiQuad_isGalois
import Submission.Work.QuadraticFields.certPrimesQ_nonsquare
import Submission.Work.QuadraticFields.certRoot_generates
