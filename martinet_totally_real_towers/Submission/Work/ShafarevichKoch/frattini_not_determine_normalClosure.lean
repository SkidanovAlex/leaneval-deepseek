import Mathlib

/-!
# Frattini-type data does not determine the subgroup it generates

This is the counterexample used in the Shafarevich--Koch development to show that the data
`H ⊔ ⁅R, ⊤⁆ ⊔ closure (R²)` (with `H ≤ R`) does not force `H = R`: the "Frattini closure" of a
subgroup can already be the whole ambient group.

Concretely we work in the infinite cyclic (multiplicative) group `Multiplicative ℤ` and take

* `R = ⊤` (additively `ℤ`), and
* `H = Subgroup.zpowers (ofAdd 3)` (additively `3ℤ`).

The group is abelian, so `⁅R, ⊤⁆ = ⊥`; the squares of the elements of `R` form the subgroup
generated by `(ofAdd 1)^2 = ofAdd 2` (additively `2ℤ`), and `3ℤ ⊔ 2ℤ = ℤ`.  Hence
`R ≤ H ⊔ ⁅R, ⊤⁆ ⊔ closure (R²)`, while `H ≠ R` because `ofAdd 1 ∉ ⟨ofAdd 3⟩` (`3 ∤ 1`).
-/

namespace Work.ShafarevichKoch

theorem frattini_not_determine_normalClosure :
    ∃ R H : Subgroup (Multiplicative ℤ), H ≤ R ∧
      R ≤ H ⊔ ⁅R, ⊤⁆ ⊔
        Subgroup.closure ((fun x : Multiplicative ℤ => x ^ 2) '' (R : Set (Multiplicative ℤ))) ∧
      H ≠ R := by
  refine ⟨⊤, Subgroup.zpowers (Multiplicative.ofAdd (3 : ℤ)), le_top, ?_, ?_⟩
  · intro x _
    -- Decompose `x = (ofAdd 3)^n * ((ofAdd 1)^2)^(-n)` with `n = x.toAdd`; the first factor
    -- lies in `H`, the second in the closure of the squares of `R = ⊤`.
    set n : ℤ := Multiplicative.toAdd x with hn
    have hx : x = (Multiplicative.ofAdd (3 : ℤ)) ^ n *
        ((Multiplicative.ofAdd (1 : ℤ)) ^ (2 : ℤ)) ^ (-n) := by
      have hxn : Multiplicative.ofAdd n = x := by rw [hn]; exact ofAdd_toAdd x
      rw [← hxn, ← zpow_mul, ← ofAdd_zsmul, ← ofAdd_zsmul, ← ofAdd_add]
      rw [show n • (3 : ℤ) + (2 * (-n)) • (1 : ℤ) = n from by
            rw [zsmul_eq_mul, zsmul_eq_mul, Int.cast_id, Int.cast_id]
            ring]
    rw [hx]
    refine Subgroup.mem_sup.mpr ⟨(Multiplicative.ofAdd (3 : ℤ)) ^ n,
      Subgroup.mem_sup_left (Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩),
      ((Multiplicative.ofAdd (1 : ℤ)) ^ (2 : ℤ)) ^ (-n), Subgroup.zpow_mem _ ?_ (-n), rfl⟩
    simp only [zpow_ofNat]
    exact Subgroup.subset_closure ⟨Multiplicative.ofAdd (1 : ℤ), trivial, rfl⟩
  · -- `⟨ofAdd 3⟩ ≠ ⊤` because `ofAdd 1 ∉ ⟨ofAdd 3⟩`.
    intro h
    have hmem : Multiplicative.ofAdd (1 : ℤ) ∈
        Subgroup.zpowers (Multiplicative.ofAdd (3 : ℤ)) := by
      rw [h]; trivial
    rw [Subgroup.mem_zpowers_iff] at hmem
    obtain ⟨k, hk⟩ := hmem
    rw [← ofAdd_zsmul] at hk
    simp only [zsmul_eq_mul] at hk
    have : k * 3 = 1 := Multiplicative.ofAdd.injective hk
    omega

end Work.ShafarevichKoch
