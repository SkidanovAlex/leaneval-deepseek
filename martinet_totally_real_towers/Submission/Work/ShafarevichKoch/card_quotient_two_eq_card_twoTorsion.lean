import Mathlib

namespace Work.ShafarevichKoch

/-- For a finite additive abelian group `A`, the quotient of `A` by the subgroup generated by the
doubles `2 • x` has the same cardinality as the `2`-torsion subgroup `{x | 2 • x = 0}`.

This is the cardinality statement behind the standard (non-canonical) isomorphism
`A / 2A ≃ A[2]` for finite abelian groups: from the two short exact sequences
`0 → A[2] → A → 2A → 0` and `0 → 2A → A → A/2A → 0` we get
`|A| = |A[2]| · |2A| = |A/2A| · |2A|`, and cancelling `|2A| > 0` gives the claim. -/
theorem card_quotient_two_eq_card_twoTorsion (A : Type*) [AddCommGroup A] [Fintype A] :
    Nat.card (A ⧸ (AddSubgroup.closure (Set.range (fun x : A => (2 : ℕ) • x)))) =
      Nat.card {x : A // (2 : ℕ) • x = 0} := by
  classical
  -- the "multiplication by 2" endomorphism of `A`
  let f : A →+ A := nsmulAddMonoidHom 2
  have hf : ∀ x : A, f x = (2 : ℕ) • x := fun x => nsmulAddMonoidHom_apply 2 x
  -- the subgroup generated by the doubles is exactly the range of `f`
  have hH : (AddSubgroup.closure (Set.range (fun x : A => (2 : ℕ) • x))) = f.range := by
    refine le_antisymm ?_ ?_
    · rw [AddSubgroup.closure_le]
      rintro y ⟨x, rfl⟩
      exact ⟨x, hf x⟩
    · rintro y ⟨x, rfl⟩
      exact AddSubgroup.subset_closure ⟨x, hf x⟩
  -- the kernel of `f` is the `2`-torsion subgroup
  have hker : Nat.card f.ker = Nat.card {x : A // (2 : ℕ) • x = 0} :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun x => by simp [AddMonoidHom.mem_ker, hf x]))
  -- `|A| = |ker f| · |range f|` (first isomorphism theorem + Lagrange)
  have hA1 : Nat.card A = Nat.card f.ker * Nat.card f.range := by
    rw [AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup f.ker,
      Nat.card_congr (QuotientAddGroup.quotientKerEquivRange f).toEquiv, mul_comm]
  -- `|A| = |A / range f| · |range f|`
  have hA2 : Nat.card A = Nat.card (A ⧸ f.range) * Nat.card f.range :=
    AddSubgroup.card_eq_card_quotient_mul_card_addSubgroup f.range
  -- cancel `|range f| > 0`
  have key : Nat.card (A ⧸ f.range) = Nat.card f.ker := by
    refine Nat.mul_right_cancel (Nat.card_pos (α := f.range)) ?_
    rw [← hA2, hA1]
  rw [hH]
  exact key.trans hker

end Work.ShafarevichKoch
