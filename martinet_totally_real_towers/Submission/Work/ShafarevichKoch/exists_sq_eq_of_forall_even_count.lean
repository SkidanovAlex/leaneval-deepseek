import Mathlib
import Submission.Work.ShafarevichKoch.Defs

/-!
# `Work.ShafarevichKoch.exists_sq_eq_of_forall_even_count`

**A fractional ideal of a number field all of whose `count`s are even is a square.**

The group of invertible fractional ideals of `𝓞 F` is freely generated by the nonzero prime
ideals, with exponents given by `FractionalIdeal.count F v ·`; hence a fractional ideal is a
square iff all its exponents are even.  This is the algebraic input to the Kummer two-descent
(`Defs.lean`): it is what makes every class of `V_∅/Fˣ²` give a well-defined `2`-torsion ideal
class.

The construction is explicit: with `e v = count F v I / 2` (a finitely supported function,
since `count F · I` is), the finitely supported finprod
`J = ∏ᶠ v, (v.asIdeal)^(e v)` satisfies `J * J = ∏ᶠ v, (v.asIdeal)^(count F v I) = I`, using
`FractionalIdeal.finprod_heightOneSpectrum_factorization'`.
-/

open scoped Classical
open NumberField

namespace Work.ShafarevichKoch

theorem exists_sq_eq_of_forall_even_count (F : Type*) [Field F] [NumberField F]
    (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) (hI : I ≠ 0)
    (h : ∀ v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F),
      ∃ m : ℤ, FractionalIdeal.count F v I = 2 * m) :
    ∃ J : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F, J * J = I := by
  classical
  -- The counts of a nonzero fractional ideal vanish for all but finitely many places.
  have hsupp_count : {v | FractionalIdeal.count F v I ≠ 0}.Finite :=
    Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors (K := F) I)
  -- Hence so does the halved exponent function.
  have hsupp_e : {v | FractionalIdeal.count F v I / 2 ≠ 0}.Finite :=
    hsupp_count.subset fun v hv h0 => hv (by rw [h0, Int.zero_ediv])
  -- The finprod `fun v => (v.asIdeal)^(count/2)` is therefore finitely supported.
  have hf : Function.HasFiniteMulSupport
      (fun v => (v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (FractionalIdeal.count F v I / 2)) :=
    hsupp_e.subset fun v hv h0 => hv (by
      show (v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (FractionalIdeal.count F v I / 2) = 1
      rw [h0, zpow_zero])
  -- The square root of `I`.
  refine ⟨∏ᶠ v, (v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F) ^
      (FractionalIdeal.count F v I / 2), ?_⟩
  -- `x^e * x^e = x^(2e)`, as `x` is nonzero.
  have hzpow : ∀ v, ((v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (FractionalIdeal.count F v I / 2))
      * ((v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (FractionalIdeal.count F v I / 2))
      = ((v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (2 * (FractionalIdeal.count F v I / 2))) := by
    intro v
    rw [← zpow_add₀ (FractionalIdeal.coeIdeal_ne_zero.mpr v.ne_bot)]
    congr 1
    rw [two_mul]
  -- `2 * (count / 2) = count`, since the counts are even.
  have h2e : ∀ v, 2 * (FractionalIdeal.count F v I / 2) = FractionalIdeal.count F v I := by
    intro v
    obtain ⟨m, hm⟩ := h v
    rw [hm, Int.mul_ediv_cancel' (⟨m, by ring⟩ : (2 : ℤ) ∣ 2 * m)]
  have h2e' : ∀ v, ((v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ (2 * (FractionalIdeal.count F v I / 2)))
      = ((v.asIdeal : FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
        ^ FractionalIdeal.count F v I) := fun v => by rw [h2e v]
  rw [← finprod_mul_distrib hf hf]
  rw [finprod_congr hzpow]
  rw [finprod_congr h2e']
  exact FractionalIdeal.finprod_heightOneSpectrum_factorization' F hI

end Work.ShafarevichKoch
