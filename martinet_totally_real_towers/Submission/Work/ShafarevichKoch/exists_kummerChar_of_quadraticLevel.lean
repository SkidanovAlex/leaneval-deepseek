import Mathlib
import Submission.Work.ShafarevichKoch.GeneratorRank
import Submission.Work.ShafarevichKoch.KummerPairing
import Submission.Work.ShafarevichKoch.exists_kummerChar
import Submission.Work.ShafarevichKoch.mem_VTwo_of_unramified
import Submission.Work.ClassFieldTower.degreeTwo_sqrt_gen
import Submission.Work.ShafarevichKoch.isGalois_of_finrank_eq_two

/-!
# `Work.ShafarevichKoch.exists_kummerChar_of_quadraticLevel`

**Every unramified quadratic level of `F_∅/F` is a Kummer level `F(√x)` cut out by a continuous
character, with a square root of the *unit* `x ∈ V_∅`.**

Let `F` be a number field, `F_∅ = M.K` its maximal unramified pro-`2` extension, `G_∅ =
Gal(F_∅/F)`, and let `L ⊆ F_∅` be an unramified quadratic level (`[L : F] = 2`).  Then there is a
unit `x ∈ Fˣ` and an element `b ∈ F_∅` with

* `b * b = algebraMap F F_∅ x` (so `b` is a square root of `x`),
* `x ∈ VTwo F`, i.e. the principal fractional ideal `(x)` is a square (Koch's Kummer radical
  `V_∅` of the maximal unramified exponent-`2` extension),
* `F⟮b⟯ = L`,
* and a continuous character `χ : G_∅ → 𝔽₂` whose kernel is precisely the stabiliser of `b`:
  `χ σ = 1 ↔ σ b = b`.

This is the "Kummer lifting" of a quadratic level: it exhibits the level as the fixed field of the
open index-`2` subgroup it defines, together with a Kummer generator whose class lies in the
radical `V_∅` — the combination used to run the Shafarevich--Koch two-descent on a *given* level.

## Proof

`Work.ClassFieldTower.degreeTwo_sqrt_gen` (a purely field-theoretic statement: a degree-`2`
extension is generated by a square root, and the square can be taken to be a *nonzero* element of
the base) produces `a : Fˣ` and `b ∈ L`, `b * b = a`, `F⟮b⟯ = L`.  Since `L/F` is unramified
(`M.unramified`; `FiniteDimensional`/`NumberField`/`IsGalois` for the intermediate field are
supplied by `Module.finite_of_finrank_pos`, `NumberField.of_module_finite` and
`isGalois_of_finrank_eq_two`), the ramification criterion
`Work.ShafarevichKoch.mem_VTwo_of_unramified` gives `a ∈ VTwo F`.  The character is then the one
produced by `Work.ShafarevichKoch.exists_kummerChar` from the pair `(a, b)`; no class field theory
is used.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open Work.ClassFieldTower

noncomputable section

namespace Work.ShafarevichKoch

theorem exists_kummerChar_of_quadraticLevel (F : Type*) [Field F] [NumberField F]
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (L : Work.ShafarevichKoch.QuadraticLevel F M) :
    ∃ (x : Fˣ) (b : M.K), b * b = algebraMap F M.K (x : F) ∧
      x ∈ Work.ShafarevichKoch.VTwo F ∧
      IntermediateField.adjoin F ({b} : Set M.K) = (L.1 : IntermediateField F M.K) ∧
      ∃ χ : Work.ShafarevichKoch.ProTwoChar F M,
        ∀ σ : Work.ClassFieldTower.galoisGroup M,
          ((χ : Work.ClassFieldTower.galoisGroup M →* Multiplicative (ZMod 2)) σ = 1 ↔ σ b = b) := by
  -- A quadratic level is generated over `F` by a square root of a unit of `F`.
  obtain ⟨a, b, hbmem, hbsq, hbgen⟩ :=
    Work.ClassFieldTower.degreeTwo_sqrt_gen (K := F) (L := M.K) (by norm_num) L.1 L.2
  -- The level carries the structure of a number field, finite dimensional and Galois over `F`.
  haveI hfd : FiniteDimensional F ↥L.1 := Module.finite_of_finrank_pos (by rw [L.2]; norm_num)
  haveI hNF : NumberField ↥L.1 := NumberField.of_module_finite F ↥L.1
  haveI hgal : IsGalois F ↥L.1 := isGalois_of_finrank_eq_two F M.K L.1 L.2
  -- Unramifiedness of `L/F` puts the Kummer generator in Koch's group `V_∅`.
  have hmem : a ∈ VTwo F := by
    refine mem_VTwo_of_unramified F ↥L.1 a ⟨b, hbmem⟩ ?_ (M.unramified L.1 hfd hgal)
    apply Subtype.ext
    show b * b = algebraMap F M.K (a : F)
    exact hbsq
  -- The Kummer character of the square root `b`.
  exact ⟨a, b, hbsq, hmem, hbgen, exists_kummerChar F M a b hbsq⟩

end Work.ShafarevichKoch
