import Mathlib
import Submission.Work.ShafarevichKoch.RelationBound
import Submission.Work.ShafarevichKoch.Kc
import Submission.Work.ClassFieldTower.Defs

/-!
# `Work.ShafarevichKoch.Crux` -- the crux in normal form

This module records the *shape* of the remaining arithmetic input of the chapter (the classical
Shafarevich--Koch relation bound for `G_∅ = Gal(Kc_∅/Kc)`) in the sharpest normal form, together
with the (elementary) reductions that are proved here.

* `hasProTwoPresentation_mono` -- the relation *bound* is what matters: a pro-`2` presentation with
  `r` relators is also one with `r' ≥ r` relators (pad the list of words by `1`, which does not
  change the normal closure).  Consequently the data `∃ r ≤ 6, HasProTwoPresentation Kc 5 r` may be
  *normalised* to the single statement `HasProTwoPresentation Kc 5 6`:

  `kcProTwoPresentationInput_iff_five_six : KcProTwoPresentationInput ↔ HasProTwoPresentation Kc 5 6`.

  So the crux of the whole chapter is *exactly* one proposition, with no `∃ r ≤ …` slack:
  `HasProTwoPresentation Kc 5 6`, i.e. "`G_∅` is generated by five elements subject to six
  relations, the presented abstract group being the subgroup generated by those five elements".

* `shafarevichKochBound_Kc` -- the same numerical statement in the vocabulary of
  `Work.ClassFieldTower.Defs`: `ShafarevichKochBound Kc 5 6 = (6 ≤ 5 + d₂(O_{Kc}^×))`, which holds
  because `d₂(O_{Kc}^×) = r₁ + r₂ = 0 + 1 = 1` (`unitTwoRank_witness_eq_one`).  Thus the crux is
  literally the classical Shafarevich bound `r ≤ d + d₂(O_K^×)` evaluated at
  `d = rank₂ Cl(Kc) = 5` and `d₂ = 1`.

## What is *not* here

The proposition `HasProTwoPresentation Kc 5 6` itself: it is the classical *relation count* of the
maximal unramified pro-`2` extension of an imaginary quadratic field,
`0 ≤ df(G_∅) = r - d ≤ d₂(O_K^×) = 1`.  Its only known proofs are global class field theory
(Shafarevich 1963/64; Koch, *Galois theory of `p`-extensions*, Ch. 11 Thm 11.3;
Neukirch--Schmidt--Wingberg Ch. X §7 Cor. 10.7.7 and Ch. VIII §8 Thm 8.8.1, i.e. Wingberg's
duality `Ĥ^i(G_∅, O_{K_∅}^×) ≅ Ĥ^{3-i}(G_∅, ℤ)^∨`), from which
`df(G_∅) = d₂(E_K / N_{K_∅/K} E_{K_∅}) ≤ d₂(O_K^×)` follows by an exact-sequence dimension count
(Hajir--Maire--Ramakrishna, arXiv:2103.09508).  See `README.md` §3 for the precise accounting.

The *formal* half of the classical statement that this chapter can already reach is the *lower*
bound `0 ≤ df`, i.e. `r ≥ d`, in the general form
`Work.ShafarevichKoch.card_le_rel_card_of_finite_abelianization` (the deficiency of a finitely
generated group is at most the rank of its abelianization, an immediate consequence of the fact
that a subgroup of `ℤ^α` generated by `rel.card` elements has rank at most `rel.card`, while a
finite-index subgroup of `ℤ^α` has rank `card α`).  That lemma is about a presentation of a group
with *finite abelianization* -- for `G_∅` itself this is the `0 ≤ df` half of the classical bound
-- and it does **not** apply to the dense-subgroup presentation of `HasProTwoPresentation`; see
`README.md` §9.3.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **Monotonicity of a pro-`2` presentation in the number of relators.**  If `G_∅` has a pro-`2`
presentation with `r` relators then it has one with `r' ≥ r` relators: pad the list of words by
`1`, which does not change the normal closure. -/
theorem hasProTwoPresentation_mono {F : Type*} [Field F] [NumberField F] {d r r' : ℕ}
    (h : HasProTwoPresentation F d r) (hr : r ≤ r') : HasProTwoPresentation F d r' := by
  classical
  obtain ⟨M, g, w, hker, hdense⟩ := h
  let w' : Fin r' → FreeGroup (Fin d) :=
    fun i => if hi : (i : ℕ) < r then w ⟨(i : ℕ), hi⟩ else 1
  have hval : ∀ i : Fin r', w' i = (if hi : (i : ℕ) < r then w ⟨(i : ℕ), hi⟩ else 1) :=
    fun _ => rfl
  refine ⟨M, g, w', ?_, hdense⟩
  have hle : Subgroup.normalClosure (Set.range w') ≤ Subgroup.normalClosure (Set.range w) := by
    refine Subgroup.normalClosure_le_normal ?_
    rintro x ⟨i, rfl⟩
    by_cases hi : (i : ℕ) < r
    · have heq : w' i = w ⟨(i : ℕ), hi⟩ := by
        rw [hval i]; exact dite_eq_left hi
      rw [heq]
      exact Subgroup.subset_normalClosure ⟨⟨(i : ℕ), hi⟩, rfl⟩
    · have heq : w' i = 1 := by
        rw [hval i]; exact dite_eq_right hi
      rw [heq]
      exact Subgroup.one_mem _
  have hge : Subgroup.normalClosure (Set.range w) ≤ Subgroup.normalClosure (Set.range w') := by
    refine Subgroup.normalClosure_le_normal ?_
    rintro x ⟨j, rfl⟩
    have heq : w' ⟨(j : ℕ), lt_of_lt_of_le j.isLt hr⟩ = w j := by
      rw [hval ⟨(j : ℕ), lt_of_lt_of_le j.isLt hr⟩]; exact dite_eq_left j.isLt
    rw [← heq]
    exact Subgroup.subset_normalClosure ⟨⟨(j : ℕ), lt_of_lt_of_le j.isLt hr⟩, rfl⟩
  rw [hker, le_antisymm hle hge]

/-- **The crux in normal form.**  The input
`KcProTwoPresentationInput = ∃ r ≤ 6, HasProTwoPresentation Kc 5 r` is *equivalent* to the single
proposition `HasProTwoPresentation Kc 5 6`: the existential may be normalised because relator lists
may be padded (`hasProTwoPresentation_mono`). -/
theorem kcProTwoPresentationInput_iff_five_six :
    KcProTwoPresentationInput ↔ HasProTwoPresentation Kc 5 6 := by
  constructor
  · rintro ⟨r, hr, hpres⟩
    exact hasProTwoPresentation_mono hpres hr
  · intro h
    exact ⟨6, le_rfl, h⟩

/-- The `∃ r ≤ 6` form from the normalised `r = 6` form. -/
theorem kcProTwoPresentationInput_of_five_six (h : HasProTwoPresentation Kc 5 6) :
    KcProTwoPresentationInput :=
  kcProTwoPresentationInput_iff_five_six.mpr h

/-- The normalised `r = 6` form from the `∃ r ≤ 6` form. -/
theorem hasProTwoPresentation_six_of_input (h : KcProTwoPresentationInput) :
    HasProTwoPresentation Kc 5 6 :=
  kcProTwoPresentationInput_iff_five_six.mp h

/-- **The crux in the vocabulary of `Work.ClassFieldTower.Defs`.**  The classical Shafarevich
bound `r ≤ d + d₂(O_K^×)` at `d = rank₂ Cl(Kc) = 5` and `d₂(O_{Kc}^×) = r₁ + r₂ = 1` is the
numerical statement `6 ≤ 5 + 1`, i.e. `ShafarevichKochBound Kc 5 6`. -/
theorem shafarevichKochBound_Kc : ShafarevichKochBound Kc 5 6 := by
  have h1 : unitTwoRank Kc = 1 := unitTwoRank_witness_eq_one
  simp only [ShafarevichKochBound, h1]
  omega

/-- The numeric form of the crux: the deficiency bound `6 ≤ 5 + d₂(O_{Kc}^×)` with
`d₂(O_{Kc}^×) = 1`. -/
theorem six_le_five_add_unitTwoRank : 6 ≤ 5 + unitTwoRank Kc := by
  rw [unitTwoRank_witness_eq_one]

end Work.ShafarevichKoch
