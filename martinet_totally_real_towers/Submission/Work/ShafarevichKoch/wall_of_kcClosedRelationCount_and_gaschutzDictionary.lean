/-!
# The unramified wall from the closed relation count and Gaschütz's dictionary

**Module** `Submission.Work.ShafarevichKoch.wall_of_kcClosedRelationCount_and_gaschutzDictionary`.

This file assembles the *short* route to the unramified Golod--Shafarevich wall recorded in
`Work/ShafarevichKoch/README.md` §12: the classical Shafarevich--Koch relation count for
`Kc = ℚ(√-30030)` in its classical (pro-`2`, *closed*) normalisation (`KcClosedRelationCount`)
together with the *finite-group* relation-rank dictionary of Hopf/Gaschütz
(`Work.HopfGaschutz.GaschutzDictionary 2`) already force the maximal unramified pro-`2` extension
of `Kc` to be **infinite**.

## The argument

Assume `Gal(Kc_∅/Kc)` finite and let `G := ⟨g_1,…,g_5⟩` be the abstract subgroup generated by the
five classical generators -- a finite `2`-group.

1. the closed relation condition `ClosedRelationData 5 6 g w` says that the kernel
   `K = ker (FreeGroup (Fin 5) → G)` is generated by the six words *modulo* `K²[K,F]`: with
   `S := {w_1,…,w_6}` one has `K ≤ ⟪S⟫ · K²[K,F]`
   (`le_normalClosure_sup_relFrattini_of_finiteTwoQuotient`, applicable because Schreier's lemma
   makes `K` finitely generated);
2. hence `|K ⧸ K²[K,F]| ≤ 2^6`, i.e. `h2DimOf 2 (Fin 5) G gen ≤ 6` (the counting lemma below);
3. `GaschutzDictionary 2` turns this bound into an exact presentation of the finite `2`-group `G`
   by five generators and at most six relators;
4. the finite `p`-group Golod--Shafarevich inequality (`finitePGroupGolodShafarevich_of_commons`)
   forbids such a presentation, since `25 < 4·6 = 24`.  Contradiction.

Step 3 needs the generating set to be *minimal*, which is **proved** for `Kc` unconditionally
(`Work.ShafarevichKoch.five_le_card_of_topologicalClosure_eq_top`, from
`d(G_∅) = rank₂ Cl(Kc) = 5`).  Thus the whole distance to the wall is the two named inputs.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

open scoped Classical
open scoped commutatorElement
open scoped IsMulCommutative

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

variable {F : Type*} [Group F]

/-! ## The counting lemma

Let `K ⊴ F` and `S ⊆ K` with `K ≤ ⟪S⟫ · K²[K,F]`.  Then the relation-Frattini quotient
`Q = K ⧸ K²[K,F]` is an elementary abelian `2`-group generated by the images of the elements of
`S`, so `relFrattiniDim 2 K = log₂ |Q| ≤ |S|`.

The proof is the amended version of the one in
`Work.HopfGaschutz.relFrattiniDim_le_card_of_normalGenerates`: there the hypothesis is the equality
`K = ⟪S⟫`, here only the weaker `K ≤ ⟪S⟫ · K²[K,F]` -- exactly what the closed relation condition
supplies.  The one genuinely new point is that `⟪S⟫` is the *normal* closure: conjugation by an
element `f ∈ F` moves `s` to `f s f⁻¹`, whose image in `Q` agrees with that of `s` because
`[K,F] ⊆ K²[K,F]` is killed in `Q`.  (`hconj` below.) -/

theorem relFrattiniDim_two_le_card_of_le_normalClosure_sup
    (K : Subgroup F) [K.Normal] (S : Finset F)
    (hS : (S : Set F) ⊆ K)
    (h : K ≤ Subgroup.normalClosure (S : Set F) ⊔ Work.HopfGaschutz.relFrattini 2 K) :
    Work.HopfGaschutz.relFrattiniDim 2 K ≤ S.card := by
  classical
  have hp1 : 1 < 2 := by norm_num
  -- the lifts of `S` into `K`, and their images in the relation-Frattini quotient
  set T : Finset K := S.attach.image (fun s => (⟨s.1, hS s.2⟩ : K)) with hT
  set TQ : Finset (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) :=
    T.image (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) with hTQ
  have hmemT : ∀ (s : F) (hs : s ∈ S), (⟨s, hS hs⟩ : K) ∈ T := by
    intro s hs
    rw [hT]
    refine Finset.mem_image.mpr ⟨⟨s, hs⟩, Finset.mem_attach _ _, ?_⟩
    exact Subtype.ext rfl
  -- the quotient `K ⧸ K²[K,F]` is abelian ...
  have hcomm : ∀ x y : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) y
    rw [← commutatorElement_eq_one_iff_mul_comm]
    rw [← map_commutatorElement (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) a b]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_commutatorElement (Subgroup.subtype K) a b]
    exact Work.HopfGaschutz.commutator_mem_relFrattini 2 K a.2
  -- ... and has exponent `2`
  have hexp : ∀ x : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x ^ 2 = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (a ^ 2) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_pow]
    exact Work.HopfGaschutz.pow_mem_relFrattini 2 K a.2
  haveI hQcomm : IsMulCommutative (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) := ⟨⟨hcomm⟩⟩
  -- conjugation by `F` is trivial on the relation-Frattini quotient
  have hconj : ∀ (x : K) (f : F),
      (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K))
        (⟨f * (x : F) * f⁻¹,
          Subgroup.Normal.conj_mem (H := K) ‹K.Normal› (x : F) x.2 f⟩ : K)
        = (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) x := by
    intro x f
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq,
      Work.HopfGaschutz.mem_relFrattiniIn]
    have hmem : ⁅f, (x : F)⁻¹⁆ ∈ Work.HopfGaschutz.relFrattini 2 K := by
      have h1 : ⁅f, (x : F)⁻¹⁆ ∈ ⁅K, (⊤ : Subgroup F)⁆ := by
        have h0 : ⁅f, (x : F)⁻¹⁆ ∈ ⁅(⊤ : Subgroup F), K⁆ :=
          Subgroup.commutator_mem_commutator (Subgroup.mem_top f) (K.inv_mem x.2)
        rwa [Subgroup.commutator_comm] at h0
      exact Subgroup.mem_sup_right h1
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv, commutatorElement_def, inv_inv, mul_assoc,
      mul_inv_rev, inv_one, mul_one] using hmem
  -- the quotient is generated by the images of `S`
  have hgen : Subgroup.closure (TQ : Set (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) = ⊤ := by
    let L : Subgroup (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) :=
      Subgroup.closure (TQ : Set (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))
    let M : Subgroup K :=
      Subgroup.comap (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) L
    haveI hLnorm : L.Normal := Subgroup.normal_of_isMulCommutative L
    have hMnorm : M.Normal := Subgroup.Normal.comap hLnorm _
    -- the image of `M` in `F` is normal in `F`: conjugation is trivial on the quotient
    haveI hNnorm : (Subgroup.map (Subgroup.subtype K) M).Normal :=
      ⟨fun a ha g => by
        obtain ⟨m, hm, rfl⟩ := Subgroup.mem_map.mp ha
        refine Subgroup.mem_map.mpr ⟨⟨g * (m : F) * g⁻¹,
          Subgroup.Normal.conj_mem (H := K) ‹K.Normal› (m : F) m.2 g⟩, ?_, rfl⟩
        exact Subgroup.mem_comap.mpr
          (by rw [hconj m g]; exact Subgroup.mem_comap.mp hm)⟩
    have hHle : Subgroup.normalClosure (S : Set F) ≤ Subgroup.map (Subgroup.subtype K) M :=
      Subgroup.normalClosure_le_normal (fun s hs => by
        refine Subgroup.mem_map.mpr ⟨⟨s, hS hs⟩, ?_, rfl⟩
        exact Subgroup.mem_comap.mpr (Subgroup.subset_closure
          (Finset.mem_image.mpr ⟨⟨s, hS hs⟩, hmemT s hs, rfl⟩)))
    have hRle : Work.HopfGaschutz.relFrattini 2 K ≤ Subgroup.map (Subgroup.subtype K) M := by
      intro x hx
      refine Subgroup.mem_map.mpr ⟨⟨x, Work.HopfGaschutz.relFrattini_le 2 K hx⟩, ?_, rfl⟩
      rw [Subgroup.mem_comap]
      have h1 : (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K))
          (⟨x, Work.HopfGaschutz.relFrattini_le 2 K hx⟩ : K) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr hx
      rw [h1]
      exact Subgroup.one_mem L
    have hKle : K ≤ Subgroup.map (Subgroup.subtype K) M := le_trans h (sup_le hHle hRle)
    have hLtop : L = ⊤ := by
      rw [← top_le_iff]
      intro x _
      obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
      have ha : (a : F) ∈ Subgroup.map (Subgroup.subtype K) M := hKle a.2
      obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp ha
      have hπm : (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) m =
          (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) a :=
        congrArg (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (Subtype.ext hmx)
      rw [← hπm]
      exact Subgroup.mem_comap.mp hm
    exact hLtop
  -- ## the cardinality bound: count in the abelianization of the quotient
  have hsurjA : Function.Surjective
      (Abelianization.of (G := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) := fun x =>
    QuotientGroup.mk'_surjective (commutator (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) x
  have hcardA : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)
      = Nat.card (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) := by
    have hker : (Abelianization.of (G := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)).ker = ⊥ := by
      rw [Abelianization.ker_of,
        (commutator_eq_bot_iff (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)).mpr ⟨⟨hcomm⟩⟩]
    have hinj : Function.Injective
        (Abelianization.of (G := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) :=
      (MonoidHom.ker_eq_bot_iff _).mp hker
    exact Nat.card_congr (MulEquiv.ofBijective _ ⟨hinj, hsurjA⟩).toEquiv
  set TA : Finset (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K)) :=
    TQ.image (Abelianization.of) with hTA
  have hgenA : Subgroup.closure
      (TA : Set (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))) = ⊤ := by
    rw [hTA]
    have hmap : Subgroup.map (Abelianization.of (G := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))
          (Subgroup.closure (TQ : Set (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))) =
        Subgroup.closure
          ((TQ.image (Abelianization.of) : Finset
            (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))) :
            Set (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))) := by
      refine le_antisymm ?_ ?_
      · rw [Subgroup.map_le_iff_le_comap]
        refine (Subgroup.closure_le _).mpr fun y hy => ?_
        exact Subgroup.mem_comap.mpr
          (Subgroup.subset_closure (Finset.mem_image.mpr ⟨y, hy, rfl⟩))
      · apply (Subgroup.closure_le _).mpr
        intro y hy
        obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
        exact Subgroup.mem_map_of_mem _ (Subgroup.subset_closure hx)
    rw [← hmap, hgen, Subgroup.map_top_of_surjective _ hsurjA]
  have hexpA : ∀ x : Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K), x ^ 2 = 1 := by
    intro x
    obtain ⟨y, rfl⟩ := hsurjA x
    rw [← map_pow, hexp y, map_one]
  have hboundA : Nat.card (Abelianization (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))
      ≤ 2 ^ TA.card :=
    Work.HopfGaschutz.natCard_le_pow_card_of_closure_eq_top 2 (by norm_num) hexpA hgenA
  have hbound : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ≤ 2 ^ TQ.card := by
    rw [hcardA]
    refine le_trans hboundA (Nat.pow_le_pow_right (by norm_num) ?_)
    rw [hTA]
    exact Finset.card_image_le
  have hTQS : TQ.card ≤ S.card := by
    calc TQ.card = (T.image (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K))).card := by
          rw [hTQ]
      _ ≤ T.card := Finset.card_image_le
      _ = (S.attach.image (fun s => (⟨s.1, hS s.2⟩ : K))).card := by rw [hT]
      _ ≤ S.attach.card := Finset.card_image_le
      _ = S.card := Finset.card_attach
  rw [Work.HopfGaschutz.relFrattiniDim]
  calc Nat.log 2 (Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))
      ≤ Nat.log 2 (2 ^ S.card) :=
        Nat.log_mono_right (le_trans hbound (Nat.pow_le_pow_right (by norm_num) hTQS))
    _ = S.card := Nat.log_pow hp1 S.card

/-! ## The wall -/

theorem wall_of_kcClosedRelationCount_and_gaschutzDictionary
    (h : Work.ShafarevichKoch.KcClosedRelationCount)
    (hdict : Work.HopfGaschutz.GaschutzDictionary 2) :
    Work.ClassFieldTower.InfiniteProTwoExtension Work.ClassFieldTower.Kc := by
  classical
  obtain ⟨M, g, w, hclosed, hdense⟩ := h
  refine ⟨M, ?_⟩
  rw [← not_finite_iff_infinite]
  intro hfin
  haveI : Finite (galoisGroup M) := hfin
  haveI : Fintype (galoisGroup M) := Fintype.ofFinite _
  have hpgM : IsPGroup 2 (galoisGroup M) := M.isPGroup_galoisGroup_of_finite hfin
  -- the abstract subgroup of `G_∅` generated by the five generators
  let G : Subgroup (galoisGroup M) := (FreeGroup.lift g).range
  haveI hGfin : Finite ↥G :=
    Finite.of_injective (Subgroup.subtype G) Subtype.coe_injective
  haveI : Fintype ↥G := Fintype.ofFinite _
  have hpgG : IsPGroup 2 ↥G := hpgM.of_injective (Subgroup.subtype G) Subtype.coe_injective
  -- the five generators, as a family in `G`
  let gen : Fin 5 → ↥G := fun i => (FreeGroup.lift g).rangeRestrict (FreeGroup.of i)
  have hlift : FreeGroup.lift gen = (FreeGroup.lift g).rangeRestrict :=
    FreeGroup.ext_hom _ _ (fun i => by simp [gen])
  have hgen_top : Subgroup.closure (Set.range gen) = ⊤ := by
    rw [← FreeGroup.range_lift_eq_closure, hlift, MonoidHom.range_eq_top]
    exact MonoidHom.rangeRestrict_surjective (FreeGroup.lift g)
  have hker_gen : MonoidHom.ker (FreeGroup.lift gen) = MonoidHom.ker (FreeGroup.lift g) := by
    rw [hlift, MonoidHom.ker_rangeRestrict]
  -- the kernel is a finite-index subgroup of the f.g. free group, hence finitely generated
  haveI hquotG : Finite (FreeGroup (Fin 5) ⧸ MonoidHom.ker (FreeGroup.lift g)) :=
    Finite.of_equiv ↥G (QuotientGroup.quotientKerEquivRange (FreeGroup.lift g)).symm.toEquiv
  haveI hfiK : (MonoidHom.ker (FreeGroup.lift g)).FiniteIndex :=
    Subgroup.finiteIndex_of_finite_quotient
  have hFGK : (MonoidHom.ker (FreeGroup.lift g)).FG :=
    (Group.fg_iff_subgroup_fg (MonoidHom.ker (FreeGroup.lift g))).mp (by
      haveI : Group.FG (FreeGroup (Fin 5)) := by
        rw [Group.fg_iff]
        exact ⟨Set.range FreeGroup.of, FreeGroup.closure_range_of _, Set.finite_range _⟩
      exact Subgroup.fg_of_index_ne_zero _)
  have hqK : IsPGroup 2 (FreeGroup (Fin 5) ⧸ MonoidHom.ker (FreeGroup.lift g)) :=
    hpgG.of_equiv (QuotientGroup.quotientKerEquivRange (FreeGroup.lift g)).symm
  -- the six relators, as a finite set
  set S : Finset (FreeGroup (Fin 5)) := Finset.univ.image w with hSdef
  have hSsub : (S : Set (FreeGroup (Fin 5))) ⊆ MonoidHom.ker (FreeGroup.lift g) := by
    intro x hx
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hx
    exact hclosed.1 i
  have hScard : S.card ≤ 6 := by
    calc S.card ≤ (Finset.univ : Finset (Fin 6)).card := by
          rw [hSdef]; exact Finset.card_image_le
      _ = 6 := by simp
  have hclosedK : ∀ (Q : Type) [Group Q] [Fintype Q], IsPGroup 2 Q →
      ∀ φ : FreeGroup (Fin 5) →* Q, (∀ s ∈ S, φ s = 1) →
        MonoidHom.ker (FreeGroup.lift g) ≤ MonoidHom.ker φ := by
    intro Q _ _ hQ φ hφ
    exact hclosed.2 Q hQ φ
      (fun i => hφ (w i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩))
  -- the closed relation condition gives generation modulo the relation-Frattini subgroup
  have hcontain : MonoidHom.ker (FreeGroup.lift g) ≤
      Subgroup.normalClosure (S : Set (FreeGroup (Fin 5))) ⊔
        Work.HopfGaschutz.relFrattini 2 (MonoidHom.ker (FreeGroup.lift g)) :=
    le_normalClosure_sup_relFrattini_of_finiteTwoQuotient
      (MonoidHom.ker (FreeGroup.lift g)) hFGK hqK hquotG S hSsub hclosedK
  -- hence the relation rank of the presentation is at most six
  have hdim : Work.HopfGaschutz.h2DimOf 2 (Fin 5) ↥G gen ≤ 6 := by
    show Work.HopfGaschutz.relFrattiniDim 2 (MonoidHom.ker (FreeGroup.lift gen)) ≤ 6
    rw [hker_gen]
    exact le_trans
      (relFrattiniDim_two_le_card_of_le_normalClosure_sup _ S hSsub hcontain) hScard
  -- the five generators are minimal
  have hmin : ∀ T : Finset ↥G, Subgroup.closure (T : Set ↥G) = ⊤ →
      Fintype.card (Fin 5) ≤ T.card := by
    intro T hT
    rw [Fintype.card_fin]
    have hmaptop : Subgroup.map (Subgroup.subtype G) (⊤ : Subgroup ↥G) = G :=
      le_antisymm (Subgroup.map_subtype_le ⊤)
        (fun x hx => Subgroup.mem_map.mpr ⟨⟨x, hx⟩, Subgroup.mem_top _, rfl⟩)
    have hcl : Subgroup.closure
        ((T.image (Subgroup.subtype G) : Finset (galoisGroup M)) : Set (galoisGroup M)) = G := by
      rw [Finset.coe_image, ← MonoidHom.map_closure, hT, hmaptop]
    have hGtop : G.topologicalClosure = ⊤ := by
      have hGeq : G = Subgroup.closure (Set.range g) := FreeGroup.range_lift_eq_closure
      rw [hGeq, hdense]
    have htop : (Subgroup.closure
        ((T.image (Subgroup.subtype G) : Finset (galoisGroup M)) :
          Set (galoisGroup M))).topologicalClosure = ⊤ := by
      rw [hcl]
      exact hGtop
    calc 5 ≤ (T.image (Subgroup.subtype G)).card :=
          five_le_card_of_topologicalClosure_eq_top M _ htop
      _ ≤ T.card := Finset.card_image_le
  -- Gaschütz's dictionary turns the rank bound into an exact six-relator presentation of `G`
  obtain ⟨rel, hrelcard, hkerrel⟩ := hdict ↥G hpgG gen hgen_top hmin 6 hdim
  -- ... which the finite `2`-group Golod--Shafarevich inequality forbids
  have hiso : Nonempty (↥G ≃*
      (FreeGroup (Fin 5) ⧸ Subgroup.normalClosure (rel : Set (FreeGroup (Fin 5))))) :=
    ⟨(QuotientGroup.quotientKerEquivRange (FreeGroup.lift g)).symm.trans
      (QuotientGroup.quotientMulEquivOfEq (hker_gen.symm.trans hkerrel))⟩
  have hpgQ : ∀ (N : Subgroup ↥G) [N.Normal], Finite (↥G ⧸ N) → IsPGroup 2 (↥G ⧸ N) :=
    fun N _ _ => hpgG.of_surjective (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
  have hineq : 4 * rel.card ≤ Fintype.card (Fin 5) * Fintype.card (Fin 5) := by
    rw [Fintype.card_fin]
    omega
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  have hGinf : Infinite ↥G :=
    Submission.GroupTheory.infinite_of_presentation_of_golodShafarevich
      (Submission.GroupTheory.finitePGroupGolodShafarevich_of_commons 2)
      rel (by rw [Fintype.card_fin]; norm_num) hiso hmin hpgQ hineq
  exact @not_finite ↥G hGinf hGfin

end Work.ShafarevichKoch
