import Mathlib
import Submission.Work.ShafarevichKoch.GenusAux

namespace Work.ShafarevichKoch

/-- `𝓞 Kc = ℤ[√-30030]` has ℤ-rank `2`.  If the principal ideals generated by the natural
numbers `n` and `m` (`m ≠ 0`) coincide in `𝓞 Kc`, then `n = m`.  Hints: apply `Ideal.absNorm` to
both sides; `Ideal.absNorm_span_natCast` gives `n ^ finrank` and the ℤ-rank of `𝓞 Kc` is `2`
(`Work.ClassFieldTower.finrank_ringOfIntegers`), so `n² = m²`, and `Nat.mul_self_inj` gives
`n = m`. -/
theorem nat_eq_of_span_singleton_eq {n m : ℕ} (hm : m ≠ 0)
    (h : Ideal.span ({(n : NumberField.RingOfIntegers Work.ClassFieldTower.Kc)}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))
      = Ideal.span ({(m : NumberField.RingOfIntegers Work.ClassFieldTower.Kc)}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))) : n = m := by
  have hfr : Module.finrank ℤ (NumberField.RingOfIntegers Work.ClassFieldTower.Kc) = 2 := by
    rw [NumberField.RingOfIntegers.rank, Work.ClassFieldTower.finrank_eq_two]
  have hn :
      (Ideal.span ({(n : NumberField.RingOfIntegers Work.ClassFieldTower.Kc)}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))).absNorm = n * n := by
    rw [Ideal.absNorm_span_natCast, hfr, pow_two]
  have hm' :
      (Ideal.span ({(m : NumberField.RingOfIntegers Work.ClassFieldTower.Kc)}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))).absNorm = m * m := by
    rw [Ideal.absNorm_span_natCast, hfr, pow_two]
  have hsq : n * n = m * m := by rw [← hn, h, hm']
  exact Nat.mul_self_inj.mp hsq

end Work.ShafarevichKoch
