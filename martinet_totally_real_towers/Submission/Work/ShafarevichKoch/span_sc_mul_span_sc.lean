import Mathlib
import Submission.Work.ShafarevichKoch.GenusConj

namespace Work.ShafarevichKoch

open scoped NumberField

/-- `𝓞 Kc = ℤ[√-30030]`, `scR = √-30030`, and `a, b` are coprime divisors of
`30030 = 2·3·5·7·11·13`.  Then `⟨a, scR⟩ * ⟨b, scR⟩ = ⟨a*b, scR⟩`: the ideals generated by a
ramified prime and `√-30030` multiply by multiplying the radicands.  Hints: expand the product as
`⟨a*b, a·scR, b·scR, scR²⟩`; every generator is in `⟨a*b, scR⟩` because `a,b ∣ 30030` are coprime
and `30030` is squarefree, so `a*b ∣ 30030`; conversely use Bézout for `a, b` to write `scR` as a
combination of `a·scR` and `b·scR`. -/
theorem span_sc_mul_span_sc {a b : ℕ} (ha : a ∣ 30030) (hb : b ∣ 30030) (hab : Nat.Coprime a b) :
    Ideal.span ({(↑a : NumberField.RingOfIntegers Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))
      * Ideal.span ({(↑b : NumberField.RingOfIntegers Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))
      = Ideal.span ({(↑(a * b) : NumberField.RingOfIntegers Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc)) := by
  -- `a * b ∣ 30030`, because `a` and `b` are coprime divisors of `30030`.
  have habd : a * b ∣ 30030 := Nat.Coprime.mul_dvd_of_dvd_of_dvd hab ha hb
  -- Bézout: `u * a + v * b = 1`, which writes `scR` as a combination of `a · scR` and
  -- `b · scR`.
  obtain ⟨u, v, huv⟩ := (hab.isCoprime : IsCoprime (a : ℤ) (b : ℤ))
  have hsc : (u : 𝓞 Work.ClassFieldTower.Kc)
        * ((a : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR)
      + (v : 𝓞 Work.ClassFieldTower.Kc)
        * ((b : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR)
      = Work.ClassFieldTower.scR := by
    have h1 : ((u * (a : ℤ) + v * (b : ℤ) : ℤ) : 𝓞 Work.ClassFieldTower.Kc) = 1 := by
      rw [huv]; norm_num
    calc (u : 𝓞 Work.ClassFieldTower.Kc)
          * ((a : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR)
        + (v : 𝓞 Work.ClassFieldTower.Kc)
          * ((b : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR)
        = ((u * (a : ℤ) + v * (b : ℤ) : ℤ) : 𝓞 Work.ClassFieldTower.Kc)
            * Work.ClassFieldTower.scR := by push_cast; ring
      _ = (1 : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR := by rw [h1]
      _ = Work.ClassFieldTower.scR := by rw [one_mul]
  -- the generators of the two span factors
  have haI : (a : 𝓞 Work.ClassFieldTower.Kc) ∈ Ideal.span
      ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (𝓞 Work.ClassFieldTower.Kc)) := Ideal.subset_span (by simp)
  have hbJ : (b : 𝓞 Work.ClassFieldTower.Kc) ∈ Ideal.span
      ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (𝓞 Work.ClassFieldTower.Kc)) := Ideal.subset_span (by simp)
  have hscI : Work.ClassFieldTower.scR ∈ Ideal.span
      ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (𝓞 Work.ClassFieldTower.Kc)) := Ideal.subset_span (by simp)
  have hscJ : Work.ClassFieldTower.scR ∈ Ideal.span
      ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
        : Set (𝓞 Work.ClassFieldTower.Kc)) := Ideal.subset_span (by simp)
  refine le_antisymm ?_ ?_
  · -- `⟨a, scR⟩ * ⟨b, scR⟩ ≤ ⟨a*b, scR⟩`: expand the product into four generators.
    rw [Ideal.span_pair_mul_span_pair]
    apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · -- `a * b = ↑(a * b)`
      rw [← Nat.cast_mul]
      exact Ideal.subset_span (by simp)
    · -- `a * scR`
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp))
    · -- `scR * b`
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
    · -- `scR * scR = -30030`, and `a * b ∣ 30030`
      obtain ⟨c, hc⟩ := habd
      have habc : (30030 : 𝓞 Work.ClassFieldTower.Kc)
          = (↑(a * b) : 𝓞 Work.ClassFieldTower.Kc) * (c : 𝓞 Work.ClassFieldTower.Kc) := by
        rw [← Nat.cast_mul, ← hc]; norm_num
      rw [Work.ClassFieldTower.scR_sq, habc]
      exact neg_mem (Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp)))
  · -- `⟨a*b, scR⟩ ≤ ⟨a, scR⟩ * ⟨b, scR⟩`: `a*b` is a product of generators, and `scR` is a
    -- Bézout combination of `a·scR` and `b·scR`.
    apply Ideal.span_le.mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · rw [Nat.cast_mul]
      exact Ideal.mul_mem_mul haI hbJ
    · have hbsc : (b : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR ∈
          Ideal.span ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc))
            * Ideal.span ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc)) := by
        rw [mul_comm (b : 𝓞 Work.ClassFieldTower.Kc) Work.ClassFieldTower.scR]
        exact Ideal.mul_mem_mul hscI hbJ
      have h1 : (u : 𝓞 Work.ClassFieldTower.Kc)
            * ((a : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR) ∈
          Ideal.span ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc))
            * Ideal.span ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc)) :=
        Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul haI hscJ)
      have h2 : (v : 𝓞 Work.ClassFieldTower.Kc)
            * ((b : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR) ∈
          Ideal.span ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc))
            * Ideal.span ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc)) :=
        Ideal.mul_mem_left _ _ hbsc
      have hmem : (u : 𝓞 Work.ClassFieldTower.Kc)
            * ((a : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR)
          + (v : 𝓞 Work.ClassFieldTower.Kc)
            * ((b : 𝓞 Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR) ∈
          Ideal.span ({(↑a : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc))
            * Ideal.span ({(↑b : 𝓞 Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
              : Set (𝓞 Work.ClassFieldTower.Kc)) := Ideal.add_mem _ h1 h2
      rw [hsc] at hmem
      exact hmem

end Work.ShafarevichKoch
