import Mathlib
import Submission.Work.ShafarevichKoch.RelationBound

/-!
# `Work.ShafarevichKoch.exists_quotient_of_finite_unramified`

The Shafarevich--Koch chapter presents the maximal unramified pro-`2` group
`G_∅ = Gal(F_∅/F)` of a number field `F` by `d` generators `g_1,…,g_d` and `r` words
`w_1,…,w_r` in `d` letters (`Work.ShafarevichKoch.HasProTwoPresentation`): the kernel of the
presentation map `FreeGroup (Fin d) →* G_∅`, `x_i ↦ g_i`, is the normal closure of the `w_j`, and
the `g_i` generate `G_∅` topologically.

This file proves the *formal consequence of the presentation* that the chapter's numerical
arguments use: **every finite unramified pro-`2` extension `L/F` has `Gal(L/F)` as a quotient of
the presented abstract group** `presentedGroup d r w = FreeGroup (Fin d) ⧸ ⟪w_1,…,w_r⟫`.

The mathematics is the standard one.  Since `G_∅` is the maximal unramified pro-`2` extension of
`F`, every finite `L/F` which is Galois, unramified (`differentIdeal (𝓞 F) (𝓞 L) = ⊤`) and of
`2`-power degree embeds in `F_∅` (the universal property of `M : MaximalUnramifiedProP F 2`), so
restriction of automorphisms to the image `E` of `L` in `F_∅` gives a surjection
`ψ : G_∅ →* Gal(L/F)` with `ker ψ ⊇ Gal(F_∅/E) = E.fixingSubgroup`, an **open** subgroup of the
Krull topology on `G_∅` (because `E/F` is finite).  The subgroup generated by the `g_i` is dense
in `G_∅`, and a dense subgroup meets every coset of an open subgroup, so the `g_i` already map
onto `Gal(L/F)`; hence the map `FreeGroup (Fin d) →* Gal(L/F)`, `x_i ↦ g_i`, is surjective with
kernel containing `⟪w_1,…,w_r⟫`, and the first isomorphism theorem exhibits `Gal(L/F)` as a
quotient of `presentedGroup d r w`.

The two topology lemmas needed are proved here (`sup_eq_top_of_topologicalClosure_eq_top_of_isOpen`
and `map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker`); they are general facts about a dense
subgroup and an open subgroup of a topological group.  Note that no general
"homomorphism from a profinite group to a finite group is continuous" statement is used, and indeed
such a statement is false; continuity is replaced by the *explicit* open subgroup
`Gal(F_∅/E) ⊆ ker ψ`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

/-! ## Two lemmas on dense subgroups of topological groups -/

/-- **A dense subgroup together with an open subgroup generates a topological group.**  If `H` is
a dense subgroup and `U` an open subgroup of a topological group `G`, then `H ⊔ U = ⊤`: every
`x : G` lies in the open neighbourhood `x * U`, which meets the dense set `H`, say in
`a = x * u`, so `x = a * u⁻¹ ∈ H ⊔ U`. -/
lemma sup_eq_top_of_topologicalClosure_eq_top_of_isOpen {G : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] {H U : Subgroup G}
    (hH : H.topologicalClosure = ⊤) (hU : IsOpen (U : Set G)) : H ⊔ U = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  have hdense : Dense ((H : Set G)) := by
    rw [dense_iff_closure_eq, ← Subgroup.topologicalClosure_coe, hH]; rfl
  set s : Set G := (fun y => x * y) '' (U : Set G) with hs
  have hsopen : IsOpen s := by
    rw [hs]; exact isOpenMap_mul_left x (U : Set G) hU
  have hsne : s.Nonempty := ⟨x * 1, ⟨1, U.one_mem, by simp⟩⟩
  obtain ⟨a, ha⟩ := (hdense.denseRange_val).exists_mem_open hsopen hsne
  obtain ⟨u, hu, hau⟩ := ha
  have hx : x = (a : G) * u⁻¹ := by rw [← hau]; group
  rw [hx]
  exact Subgroup.mul_mem_sup a.2 (U.inv_mem hu)

/-- **A dense subgroup maps onto a group whenever the kernel of the map contains an open
subgroup.**  If `H` is dense in a topological group `G`, `ψ : G →* Q` has an open subgroup `U`
of `G` in its kernel, and `ψ` is surjective, then `H` already maps onto `Q`; equivalently
`H.map ψ = ⊤`.

This is the form in which the topology is used in the Galois-theoretic application: the target
`Q = Gal(L/F)` need not be finite, and `ψ` need not be continuous -- only the explicit open
subgroup `U ≤ ker ψ` is used. -/
lemma map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker {G Q : Type*} [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [Group Q] (ψ : G →* Q)
    (hψ : Function.Surjective ψ) {H U : Subgroup G} (hH : H.topologicalClosure = ⊤)
    (hUo : IsOpen (U : Set G)) (hU : U ≤ MonoidHom.ker ψ) : H.map ψ = ⊤ := by
  have htop : H ⊔ U = ⊤ := sup_eq_top_of_topologicalClosure_eq_top_of_isOpen hH hUo
  have hUb : U.map ψ = ⊥ := by
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    obtain ⟨u, hu, rfl⟩ := hx
    exact MonoidHom.mem_ker.mp (hU hu)
  have hmap : (H ⊔ U).map ψ = H.map ψ := by rw [Subgroup.map_sup, hUb, sup_bot_eq]
  rw [← hmap, htop, Subgroup.map_top_of_surjective ψ hψ]

/-! ## The quotient statement for the Shafarevich--Koch presentation -/

/-- **Every finite unramified pro-`2` extension is a quotient of the presented group.**

Let `F` be a number field, `M : MaximalUnramifiedProP F 2` its maximal unramified pro-`2`
extension, and `g : Fin d → Gal(M.K/F)`, `w : Fin r → FreeGroup (Fin d)` a pro-`2` presentation of
`G_∅ = Gal(M.K/F)` with `d` generators and `r` relations: the kernel of `x_i ↦ g_i` is the normal
closure of the words `w_j`, and the `g_i` generate `G_∅` topologically.

Then every finite Galois extension `L/F` which is unramified over `F`
(`differentIdeal (𝓞 F) (𝓞 L) = ⊤`) and whose Galois group is a `2`-group has `Gal(L/F)` as a
quotient of the abstract group `presentedGroup d r w = FreeGroup (Fin d) ⧸ ⟪w_1,…,w_r⟫`
presented by those generators and relations.  (Equivalently: `presentedGroup d r w` is the
pro-`2` completion of the abstract group it presents, and `Gal(L/F)` is one of its finite
`2`-quotients.) -/
theorem exists_quotient_of_finite_unramified (F : Type*) [Field F] [NumberField F] (d r : ℕ)
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (g : Fin d → Work.ClassFieldTower.galoisGroup M) (w : Fin r → FreeGroup (Fin d))
    (hker : MonoidHom.ker (FreeGroup.lift g) = Subgroup.normalClosure (Set.range w))
    (hdense : (Subgroup.closure (Set.range g)).topologicalClosure = ⊤)
    (L : Type) [Field L] [NumberField L] [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    (hunr : differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L) = ⊤)
    (hpg : IsPGroup 2 (L ≃ₐ[F] L)) :
    ∃ (N : Subgroup (Work.ShafarevichKoch.presentedGroup d r w)) (_ : N.Normal),
      Nonempty ((Work.ShafarevichKoch.presentedGroup d r w) ⧸ N ≃* (L ≃ₐ[F] L)) := by
  classical
  -- the embedding of `L` into `F_∅` and its image `E = ϕ(L)`
  obtain ⟨ϕ, -⟩ := M.universal L hpg hunr
  let E : IntermediateField F M.K := ϕ.fieldRange
  haveI hEnorm : Normal F ↥E := (IsGalois.of_algEquiv (ϕ.equivFieldRange)).to_normal
  haveI hEfd : FiniteDimensional F ↥E := (ϕ.equivFieldRange).toLinearEquiv.finiteDimensional
  -- restriction of automorphisms of `F_∅` to `E`, transported to `L` along `ϕ`
  let ψ : Work.ClassFieldTower.galoisGroup M →* (L ≃ₐ[F] L) :=
    (AlgEquiv.autCongr (ϕ.equivFieldRange).symm).toMonoidHom.comp (AlgEquiv.restrictNormalHom ↥E)
  have hψ : Function.Surjective ψ := by
    intro y
    obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective (F := F) (K₁ := ↥E) M.K
      ((AlgEquiv.autCongr (ϕ.equivFieldRange).symm).symm y)
    refine ⟨σ, ?_⟩
    show (AlgEquiv.autCongr (ϕ.equivFieldRange).symm) ((AlgEquiv.restrictNormalHom ↥E) σ) = y
    rw [hσ]
    exact (AlgEquiv.autCongr (ϕ.equivFieldRange).symm).apply_symm_apply y
  -- `Gal(F_∅/E)` is contained in the kernel of `ψ`, and it is open since `E/F` is finite
  have hkerψ : (E.fixingSubgroup : Subgroup (Work.ClassFieldTower.galoisGroup M)) ≤
      MonoidHom.ker ψ := by
    intro u hu
    rw [MonoidHom.mem_ker]
    have h1 : AlgEquiv.restrictNormalHom ↥E u = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker E]
      exact hu
    have h2 : ψ u = (AlgEquiv.autCongr (ϕ.equivFieldRange).symm)
        ((AlgEquiv.restrictNormalHom ↥E) u) := rfl
    rw [h2, h1]
    exact map_one _
  -- the `g_i` generate `G_∅` topologically
  have hdense' : (((FreeGroup.lift g).range : Subgroup (Work.ClassFieldTower.galoisGroup M))
      ).topologicalClosure = ⊤ := by
    rw [FreeGroup.range_lift_eq_closure]
    exact hdense
  have hmaptop : (((FreeGroup.lift g).range : Subgroup (Work.ClassFieldTower.galoisGroup M))
      ).map ψ = ⊤ :=
    map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker ψ hψ hdense'
      (IntermediateField.fixingSubgroup_isOpen E) hkerψ
  -- hence `x_i ↦ ψ (g_i)` is a surjection `FreeGroup (Fin d) →* Gal(L/F)`
  have hΦ : Function.Surjective (ψ.comp (FreeGroup.lift g)) := by
    rw [← MonoidHom.range_eq_top, MonoidHom.range_comp]
    exact hmaptop
  -- whose kernel contains the relations
  have hle : MonoidHom.ker (FreeGroup.lift g) ≤ MonoidHom.ker (ψ.comp (FreeGroup.lift g)) := by
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    simp only [MonoidHom.comp_apply, hx, map_one]
  have hle' : Subgroup.normalClosure (Set.range w) ≤
      MonoidHom.ker (ψ.comp (FreeGroup.lift g)) := by
    rw [← hker]
    exact hle
  -- first/third isomorphism theorem for the quotient by the image of the kernel
  refine ⟨Subgroup.map (QuotientGroup.mk' (Subgroup.normalClosure (Set.range w)))
      (MonoidHom.ker (ψ.comp (FreeGroup.lift g))), ?_, Nonempty.intro ?_⟩
  · exact Subgroup.Normal.map (MonoidHom.normal_ker _)
      (QuotientGroup.mk' (Subgroup.normalClosure (Set.range w)))
      (QuotientGroup.mk'_surjective _)
  · exact (QuotientGroup.quotientQuotientEquivQuotient _ _ hle').trans
      (QuotientGroup.liftEquiv (MonoidHom.ker (ψ.comp (FreeGroup.lift g)))
        (φ := ψ.comp (FreeGroup.lift g)) hΦ rfl)

end Work.ShafarevichKoch
