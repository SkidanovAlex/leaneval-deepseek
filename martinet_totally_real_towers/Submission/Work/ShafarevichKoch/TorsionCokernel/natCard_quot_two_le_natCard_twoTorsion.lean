import Mathlib
import Submission.Work.ShafarevichKoch.card_quotient_two_eq_card_twoTorsion

/-!
# `Work.ShafarevichKoch.TorsionCokernel.natCard_quot_two_le_natCard_twoTorsion`

For a `2`-primary torsion abelian group `C` whose `2`-torsion subgroup `C[2] = {x | 2 • x = 0}` is
finite, the quotient `C ⧸ 2C` (where `2C` is the subgroup generated by the doubles) has at most
as many elements as `C[2]`:

```
Nat.card (C ⧸ 2C) ≤ Nat.card C[2] .
```

This is the infinite-group refinement of the finite statement
`Work.ShafarevichKoch.card_quotient_two_eq_card_twoTorsion`, where the two cardinals are equal.
The proof passes to the finite subgroups: a `2`-primary torsion abelian group is the union of its
finite subgroups, each of which surjects onto the whole of `C ⧸ 2C` once `C ⧸ 2C` is finite, and
the finite case bounds the image of every finite subgroup by `C[2]`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical

namespace Work.ShafarevichKoch.TorsionCokernel

open Work.ShafarevichKoch (card_quotient_two_eq_card_twoTorsion)

/-- **The quotient `C ⧸ 2C` is no larger than the `2`-torsion `C[2]`.**

For a `2`-primary torsion abelian group `C` with finite `2`-torsion, the quotient of `C` by the
subgroup generated by the doubles has cardinality at most that of the `2`-torsion subgroup.  When
`C ⧸ 2C` is finite the two cardinalities are actually equal; when `C ⧸ 2C` is infinite both sides
of the inequality are `0` on the left (`Nat.card` of an infinite type is `0`). -/
theorem natCard_quot_two_le_natCard_twoTorsion {C : Type*} [AddCommGroup C]
    (htor : ∀ x : C, ∃ k : ℕ, (2 : ℕ) ^ k • x = 0)
    (hfin : Finite {x : C // (2 : ℕ) • x = 0}) :
    Nat.card (C ⧸ AddSubgroup.closure (Set.range (fun x : C => (2 : ℕ) • x))) ≤
      Nat.card {x : C // (2 : ℕ) • x = 0} := by
  classical
  set K : AddSubgroup C := AddSubgroup.closure (Set.range (fun x : C => (2:ℕ) • x)) with hK
  -- `C` is a torsion additive group.
  have hT : IsAddTorsion C := by
    intro x
    obtain ⟨k, hk⟩ := htor x
    rw [isOfFinAddOrder_iff_nsmul_eq_zero]
    rcases Nat.eq_zero_or_pos k with hk0 | hkpos
    · refine ⟨1, by norm_num, ?_⟩
      simpa [hk0] using hk
    · exact ⟨2^k, by positivity, hk⟩
  -- every element of `Q = C ⧸ 2C` is killed by `2`.
  have h2Q : ∀ q : C ⧸ K, (2:ℕ) • q = 0 := by
    intro q
    induction q using Quotient.inductionOn with
    | h c =>
      show (2:ℕ) • ((QuotientAddGroup.mk' K) c) = 0
      rw [← map_nsmul (QuotientAddGroup.mk' K) 2 c]
      rw [QuotientAddGroup.mk'_apply]
      rw [QuotientAddGroup.eq_zero_iff]
      exact AddSubgroup.subset_closure ⟨c, rfl⟩
  by_cases hQ : Finite (C ⧸ K)
  · -- `Q` is finite: pick a finite subgroup surjecting onto `Q` and apply the finite case to it.
    haveI : Fintype (C ⧸ K) := Fintype.ofFinite _
    let rep : (C ⧸ K) → C := fun q => Quotient.out q
    have hrep : ∀ q : C ⧸ K, (rep q : C ⧸ K) = q := by
      intro q; exact Quotient.out_eq q
    have hsfin : (Set.range rep).Finite := Set.finite_range rep
    let H : AddSubgroup C := AddSubgroup.closure (Set.range rep)
    haveI : Finite (Set.range rep) := hsfin.to_subtype
    haveI hFGH : AddGroup.FG ↥H := AddGroup.closure_finite_fg (Set.range rep)
    haveI hTorH : IsAddTorsion ↥H := hT.addSubgroup H
    haveI hFinH : Finite ↥H := AddCommGroup.finite_of_fg_isAddTorsion ↥H hTorH
    haveI : Fintype ↥H := Fintype.ofFinite ↥H
    -- the composite `H → Q` is surjective.
    let f : ↥H →+ (C ⧸ K) := (QuotientAddGroup.mk' K).comp H.subtype
    have hf : Function.Surjective f := by
      intro q
      refine ⟨⟨rep q, ?_⟩, ?_⟩
      · exact AddSubgroup.subset_closure ⟨q, rfl⟩
      · show (QuotientAddGroup.mk' K) (rep q) = q
        rw [QuotientAddGroup.mk'_apply]
        exact hrep q
    let N : AddSubgroup ↥H := AddSubgroup.closure (Set.range (fun x : ↥H => (2:ℕ) • x))
    -- `2 • ⊤ ≤ ker f`, since `2` kills every element of `Q`.
    have hNle : N ≤ f.ker := by
      rw [AddSubgroup.closure_le]
      rintro y ⟨x, rfl⟩
      show f ((2:ℕ) • x) = 0
      rw [map_nsmul]
      exact h2Q (f x)
    haveI : Finite (↥H ⧸ N) :=
      Finite.of_surjective (QuotientAddGroup.mk' N) (QuotientAddGroup.mk'_surjective N)
    -- `Q` is a quotient of `H ⧸ 2H`.
    let g : (↥H ⧸ N) →+ (C ⧸ K) := QuotientAddGroup.lift N f hNle
    have hg : Function.Surjective g := by
      intro q
      obtain ⟨x, hx⟩ := hf q
      refine ⟨(x : ↥H ⧸ N), ?_⟩
      rw [QuotientAddGroup.lift_mk, hx]
    have b1 : Nat.card (C ⧸ K) ≤ Nat.card (↥H ⧸ N) := Nat.card_le_card_of_surjective g hg
    -- `Nat.card (H ⧸ 2H) = Nat.card H[2] ≤ Nat.card C[2]`.
    have b2 : Nat.card (↥H ⧸ N) ≤ Nat.card {x : C // (2:ℕ) • x = 0} := by
      rw [card_quotient_two_eq_card_twoTorsion ↥H]
      haveI : Finite {x : C // (2:ℕ) • x = 0} := hfin
      have h1 : ∀ x : {x : ↥H // (2:ℕ) • x = 0}, (2:ℕ) • ((x.1 : ↥H) : C) = 0 := by
        intro x
        have hx := congrArg (fun y : ↥H => (y : C)) x.2
        simpa using hx
      refine Nat.card_le_card_of_injective
        (fun x => (⟨((x.1 : ↥H) : C), h1 x⟩ : {x : C // (2:ℕ) • x = 0})) ?_
      intro a b hab
      have h1' : ((a.1 : ↥H) : C) = ((b.1 : ↥H) : C) :=
        congrArg (fun y : {x : C // (2:ℕ) • x = 0} => (y : C)) hab
      exact Subtype.ext (Subtype.ext h1')
    exact le_trans b1 b2
  · -- `Q` is infinite: `Nat.card Q = 0` and the inequality is trivial.
    haveI : Infinite (C ⧸ K) := not_finite_iff_infinite.mp hQ
    rw [Nat.card_eq_zero_of_infinite]
    exact Nat.zero_le _

end Work.ShafarevichKoch.TorsionCokernel
