import Mathlib
import Submission.Work.HopfGaschutz.Defs

/-!
# `ClosedToRelFrattini`: the closed condition gives generation modulo `K²[K,F]`

**Namespace** `Work.ShafarevichKoch`; module
`Submission.Work.ShafarevichKoch.le_normalClosure_sup_relFrattini_of_finiteTwoQuotient`.

This file proves the pure group-theoretic input `ClosedToRelFrattini` of
`Submission/Work/ShafarevichKoch/KcClosedBound.lean`:

> Let `K ⊴ F` be finitely generated and suppose that the quotient `F ⧸ K` is a finite `2`-group.
> If `S ⊆ K` is a finite set with the property that **every** map `φ : F →* Q` into a finite
> `2`-group `Q` with `S ⊆ ker φ` kills all of `K`, then `S` generates `K` modulo the
> relation-Frattini subgroup `K²[K,F]`:
> `K ≤ ⟪S⟫^F · K²[K,F]`.

The proof is short once the right subgroup is exhibited: take `R := ⟪S⟫^F · K²[K,F]`. Then

* `R ⊴ F` and `R ≤ K`, so `F ⧸ R` is an extension of the finite `2`-group `F ⧸ K` by the quotient
  `K ⧸ R`; since `K² ⊆ R ⊆ K` and `[K,F] ⊆ R`, that quotient is abelian of exponent two and
  generated by the images of a finite generating set of `K` (which exists because `K` is finitely
  generated), hence finite. So `F ⧸ R` is a finite `2`-group;
* the quotient map `F →* F ⧸ R` kills `S`, so the hypothesis applies and gives `K ≤ R`.

Two technical points are worth recording.

* The finiteness of `K ⧸ R` is the statement that a finitely generated abelian group of exponent
  two is finite: `CommGroup.finite_of_fg_isMulTorsion` together with the identification of `K ⧸ R`
  as an abelian group of exponent two
  (`Subgroup.Normal.quotient_commutative_iff_commutator_le`).
* The hypothesis `hclosed` quantifies over finite `2`-groups in the *smallest* universe, while
  `F ⧸ R` lives in the universe of `F`.  Since a finite group is isomorphic to one in any universe
  (`Finite.exists_type_univ_nonempty_mulEquiv`), this costs nothing: we transport `F ⧸ R` down and
  apply the hypothesis to the transported group.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped IsMulCommutative commutatorElement

namespace Work.ShafarevichKoch

variable {F : Type*} [Group F]

/-- **Every finite group is isomorphic to a finite group in `Type 0`.**

This is the universe-downgrade used to apply the (universe-`0`) hypothesis `hclosed` of the main
theorem to the quotient `F ⧸ R`. -/
theorem exists_mulEquiv_type_zero (G : Type*) [Group G] [Finite G] :
    ∃ (Q : Type) (_ : Group Q) (_ : Fintype Q), Nonempty (G ≃* Q) :=
  Finite.exists_type_univ_nonempty_mulEquiv G

/-- **A finitely generated quotient of `K` by a subgroup containing `K²[K,⊤]` is finite.**

`K ⧸ R` is abelian of exponent `2` (because `K² ≤ R` and `[K,K] ≤ [K,⊤] ≤ R`) and generated by
the images of the finitely many generators of `K`, so `CommGroup.finite_of_fg_isMulTorsion`
applies. -/
theorem finite_quotient_of_relFrattini_le (K : Subgroup F) [K.Normal] (hFG : K.FG)
    (R : Subgroup F) [R.Normal] (hR : Work.HopfGaschutz.relFrattini 2 K ≤ R) :
    Finite (K ⧸ R.subgroupOf K) := by
  classical
  haveI : Group.FG ↥K := (Group.fg_iff_subgroup_fg K).mpr hFG
  haveI hRn : (R.subgroupOf K).Normal := Subgroup.Normal.subgroupOf ‹R.Normal› K
  -- `K ⧸ R` is abelian
  have hcomm : IsMulCommutative (↥K ⧸ R.subgroupOf K) := by
    refine Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr ?_
    change ⁅(⊤ : Subgroup ↥K), ⊤⁆ ≤ R.subgroupOf K
    rw [Subgroup.commutator_le]
    intro a _ b _
    rw [Subgroup.mem_subgroupOf]
    change (Subgroup.subtype K) ⁅a, b⁆ ∈ R
    rw [map_commutatorElement]
    exact hR (Work.HopfGaschutz.commutator_mem_relFrattini 2 K (k := (a : F)) (f := (b : F)) a.2)
  -- every element of `K ⧸ R` has order dividing `2`
  have htors : IsMulTorsion (↥K ⧸ R.subgroupOf K) := by
    intro x
    obtain ⟨k, rfl⟩ := QuotientGroup.mk'_surjective (R.subgroupOf K) x
    have hmem : k ^ 2 ∈ R.subgroupOf K := by
      rw [Subgroup.mem_subgroupOf, Subgroup.coe_pow]
      exact hR (Work.HopfGaschutz.pow_mem_relFrattini 2 K (k := (k : F)) k.2)
    refine isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, ?_⟩
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hmem
  haveI : IsMulCommutative (↥K ⧸ R.subgroupOf K) := hcomm
  exact CommGroup.finite_of_fg_isMulTorsion _ htors

theorem le_normalClosure_sup_relFrattini_of_finiteTwoQuotient
    {F : Type*} [Group F] (K : Subgroup F) [K.Normal] (hFG : K.FG)
    (hq : IsPGroup 2 (F ⧸ K)) (hfin : Finite (F ⧸ K)) (S : Finset F)
    (hS : (S : Set F) ⊆ K)
    (hclosed : ∀ (Q : Type) [Group Q] [Fintype Q], IsPGroup 2 Q → ∀ φ : F →* Q,
      (∀ s ∈ S, φ s = 1) → K ≤ MonoidHom.ker φ) :
    K ≤ Subgroup.normalClosure (S : Set F) ⊔ Work.HopfGaschutz.relFrattini 2 K := by
  classical
  haveI hfinK' : Finite (F ⧸ K) := hfin
  set N : Subgroup F := Subgroup.normalClosure (S : Set F) with hN
  set R : Subgroup F := N ⊔ Work.HopfGaschutz.relFrattini 2 K with hR
  haveI : N.Normal := Subgroup.normalClosure_normal
  haveI : R.Normal := by rw [hR]; exact Subgroup.sup_normal N _
  have hRle : R ≤ K := by
    rw [hR]
    exact sup_le (Subgroup.normalClosure_le_normal hS) (Work.HopfGaschutz.relFrattini_le 2 K)
  have hrel : Work.HopfGaschutz.relFrattini 2 K ≤ R := by
    rw [hR]; exact le_sup_right
  haveI hfinDefect : Finite (K ⧸ R.subgroupOf K) := finite_quotient_of_relFrattini_le K hFG R hrel
  -- elements of `K` have order at most `2` modulo `R`
  have hsqK : ∀ k : F, k ∈ K → (QuotientGroup.mk' R k) ^ 2 = 1 := by
    intro k hk
    have hmem : k ^ 2 ∈ R := hrel (Work.HopfGaschutz.pow_mem_relFrattini 2 K (k := k) hk)
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hmem
  -- `F ⧸ R` is a finite `2`-group: it is an extension of `F ⧸ K` by `K ⧸ R`
  set φ : ↥K →* F ⧸ R := (QuotientGroup.mk' R).domRestrict K with hφ
  have hφker : φ.ker = R.subgroupOf K := by
    rw [hφ, MonoidHom.ker_domRestrict, QuotientGroup.ker_mk']
  have hφrange : φ.range = K.map (QuotientGroup.mk' R) := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact Subgroup.mem_map_of_mem _ x.2
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  haveI : (K.map (QuotientGroup.mk' R)).Normal :=
    Subgroup.Normal.map ‹K.Normal› _ (QuotientGroup.mk'_surjective R)
  have hcard1 : Nat.card ((F ⧸ R) ⧸ K.map (QuotientGroup.mk' R)) = Nat.card (F ⧸ K) :=
    Nat.card_congr (QuotientGroup.quotientQuotientEquivQuotient R K hRle).toEquiv
  have hcard2 : Nat.card ↥(K.map (QuotientGroup.mk' R)) = Nat.card (K ⧸ R.subgroupOf K) := by
    rw [← hφrange, ← hφker]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv.symm
  have hcard : Nat.card (F ⧸ R) = Nat.card (F ⧸ K) * Nat.card (K ⧸ R.subgroupOf K) := by
    have h := Subgroup.card_eq_card_quotient_mul_card_subgroup (K.map (QuotientGroup.mk' R))
    rw [hcard1, hcard2] at h
    exact h
  haveI hfinR : Finite (F ⧸ R) := Nat.finite_of_card_ne_zero (by
    rw [hcard]
    exact mul_ne_zero (Finite.card_pos_iff.mpr ⟨(1 : F ⧸ K)⟩).ne'
      (Finite.card_pos_iff.mpr ⟨(1 : K ⧸ R.subgroupOf K)⟩).ne')
  have hP : IsPGroup 2 (F ⧸ R) := by
    rw [isPGroup_iff_pow_pow_eq_one]
    intro g
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective R g
    obtain ⟨n, hn⟩ := isPGroup_iff_pow_pow_eq_one.mp hq (QuotientGroup.mk' K x)
    have hx : x ^ 2 ^ n ∈ K := by
      rw [← QuotientGroup.eq_one_iff, ← QuotientGroup.mk'_apply, map_pow]
      exact hn
    refine ⟨n + 1, ?_⟩
    calc (QuotientGroup.mk' R x) ^ 2 ^ (n + 1)
        = ((QuotientGroup.mk' R x) ^ 2 ^ n) ^ 2 := by rw [pow_succ, pow_mul]
      _ = ((QuotientGroup.mk' R) (x ^ 2 ^ n)) ^ 2 := by rw [map_pow]
      _ = 1 := hsqK _ hx
  -- transport `F ⧸ R` to a finite `2`-group in `Type 0`
  obtain ⟨Q, hQg, hQf, ⟨eQ⟩⟩ := exists_mulEquiv_type_zero (F ⧸ R)
  letI := hQg
  letI := hQf
  have hPQ : IsPGroup 2 Q := hP.of_equiv eQ
  have hSker : ∀ s ∈ S, QuotientGroup.mk' R s = 1 := by
    intro s hs
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hR]
    exact Subgroup.mem_sup_left (Subgroup.subset_normalClosure (show s ∈ (S : Set F) from hs))
  have hkill : ∀ s ∈ S, (eQ.toMonoidHom.comp (QuotientGroup.mk' R)) s = 1 := by
    intro s hs
    rw [MonoidHom.comp_apply, hSker s hs]
    exact map_one eQ.toMonoidHom
  intro k hk
  have h1 : eQ (QuotientGroup.mk' R k) = 1 := by
    have h := hclosed Q hPQ (eQ.toMonoidHom.comp (QuotientGroup.mk' R)) hkill hk
    simpa using h
  have h2 : QuotientGroup.mk' R k = 1 := eQ.injective (by simpa using h1)
  rwa [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h2

end Work.ShafarevichKoch
