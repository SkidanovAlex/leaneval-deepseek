import Mathlib
import Submission.Work.ShafarevichKoch.Defs

/-!
# `Work.ShafarevichKoch.count_map_eq`

**The valuation of the extension of an ideal.**

Let `F ⊆ L` be an extension of number fields, `𝔭` a place (height one prime) of `𝓞 F`, `𝔓` a place
of `𝓞 L` above it, and `I ≠ 0` an ideal of `𝓞 F`.  The main result of this file is

`count L 𝔓 (I · 𝓞 L) = e(𝔓/𝔭) * count F 𝔭 I`,

i.e. the exponent of `𝔓` in the factorization of the extension of `I` is the ramification index
`e(𝔓/𝔭)` of `𝔓` over `𝔭` times the exponent of `𝔭` in the factorization of `I`.

In fact no Galois hypothesis is used: this is a general fact about an extension of Dedekind
domains, because (a) the extension of a place `𝔮` of `𝓞 F` is the product of the places above it
raised to their ramification indices, and (b) distinct places of `𝓞 F` have disjoint sets of places
above them.  The Galois hypotheses of the statement are inherited from the application and are not
needed for the proof.

## Proof outline

Writing `factorization J : Ideal R →₀ ℕ` for the exponent function of the unique factorization of
ideals of a Dedekind domain into prime ideals, the first observation
(`fractionalIdeal_count_coe_eq_factorization`) is that for a nonzero ideal `J`

`count K v ↑J = ((factorization J) v.asIdeal : ℤ)`,

which reduces the statement to a computation with `factorization`.  Next, for a nonzero `I` we
decompose `I` into primary powers,

`I = ∏_𝔭 𝔭 ^ (factorization I) 𝔭.asIdeal`

(`IsDedekindDomain.HeightOneSpectrum.maxPowDividing` and
`Ideal.finprod_heightOneSpectrum_factorization`); the product is indexed by the finite set of
places dividing `I`, enlarged by `𝔭` itself.  Applying the extension `I ↦ I · 𝓞 L` turns this into
a product, and `factorization` of a finite product of nonzero ideals is the sum of the
factorizations (`factorization_finset_prod_of_nonzero`).  Evaluating at `𝔓` leaves only the `𝔭`
term:

* for `𝔮 ≠ 𝔭`, the place `𝔓` does not lie above `𝔮`, so it does not occur in the factorization of
  `𝔮 · 𝓞 L` (`factorization_map_eq_zero_of_not_liesOver`);
* for `𝔮 = 𝔭` the exponent is by definition the ramification index
  (`factorization_map_eq_ramificationIdx_of_liesOver`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

section Helpers

/-- For a nonzero ideal `J` of a Dedekind domain, the `v`-adic valuation of the fractional ideal
generated by `J` is the exponent of `v` in the factorization of `J` into prime ideals. -/
theorem fractionalIdeal_count_coe_eq_factorization (R : Type*) [CommRing R] [IsDedekindDomain R]
    (K : Type*) [Field K] [Algebra R K] [IsFractionRing R K]
    (v : IsDedekindDomain.HeightOneSpectrum R) {J : Ideal R} (hJ : J ≠ 0) :
    FractionalIdeal.count K v (J : FractionalIdeal (nonZeroDivisors R) K)
      = ((factorization J) v.asIdeal : ℤ) := by
  rw [FractionalIdeal.count_coe K v hJ,
    Ideal.count_associates_factors_eq hJ v.isPrime v.ne_bot, ← factorization_eq_count]

/-- The `factorization` of a finite product of nonzero ideals of a Dedekind domain is the sum of
the `factorization`s of the factors. -/
theorem factorization_finset_prod_of_nonzero {R : Type*} [CommRing R] [IsDedekindDomain R]
    {ι : Type*} (s : Finset ι) (g : ι → Ideal R) (hg : ∀ i, g i ≠ 0) :
    factorization (∏ i ∈ s, g i) = ∑ i ∈ s, factorization (g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => rw [Finset.prod_empty, Finset.sum_empty, factorization_one]
  | insert i s hi ih =>
      have hne : (∏ j ∈ s, g j) ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => hg j
      rw [Finset.prod_insert hi, Finset.sum_insert hi, factorization_mul (hg i) hne, ih]

/-- The extension of ideals along a ring homomorphism commutes with finite products. -/
theorem ideal_map_algebraMap_finset_prod {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    {ι : Type*} (s : Finset ι) (g : ι → Ideal R) :
    Ideal.map (algebraMap R S) (∏ i ∈ s, g i)
      = ∏ i ∈ s, Ideal.map (algebraMap R S) (g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp only [Finset.prod_empty, Ideal.one_eq_top, Ideal.map_top]
  | insert i s hi ih => rw [Finset.prod_insert hi, Finset.prod_insert hi, Ideal.map_mul, ih]

/-- A prime ideal `q` of `S` which does not lie over the maximal ideal `p` of `R` has zero exponent
in the factorization of the extension of `p`. -/
theorem factorization_map_eq_zero_of_not_liesOver {R S : Type*} [CommRing R] [CommRing S]
    [IsDedekindDomain S] [Algebra R S] {p : Ideal R} (hp : p.IsMaximal) {q : Ideal S}
    (hq : q.IsPrime) (hnlies : ¬ q.LiesOver p) :
    (factorization (Ideal.map (algebraMap R S) p)) q = 0 := by
  haveI : p.IsMaximal := hp
  by_contra hne
  have hmem : q ∈ UniqueFactorizationMonoid.normalizedFactors (Ideal.map (algebraMap R S) p) := by
    rw [← Multiset.count_ne_zero, ← factorization_eq_count]
    exact hne
  exact hnlies ((Ideal.liesOver_iff_dvd_map hq.ne_top).mpr
    (UniqueFactorizationMonoid.dvd_of_mem_normalizedFactors hmem))

/-- The exponent of a prime `q` of `S` in the factorization of the extension of a prime `p` of `R`
lying below it is the ramification index of `q` over `p`. -/
theorem factorization_map_eq_ramificationIdx_of_liesOver {R S : Type*} [CommRing R] [CommRing S]
    [IsDedekindDomain S] [Algebra R S] (p : Ideal R)
    (q : IsDedekindDomain.HeightOneSpectrum S) [q.asIdeal.LiesOver p]
    (hm : Ideal.map (algebraMap R S) p ≠ ⊥) :
    (factorization (Ideal.map (algebraMap R S) p)) q.asIdeal = q.asIdeal.ramificationIdx R := by
  haveI : q.asIdeal.IsPrime := q.isPrime
  rw [IsDedekindDomain.HeightOneSpectrum.factorization_eq_multiplicity hm q,
    Ideal.IsDedekindDomain.ramificationIdx_eq_multiplicity p q.asIdeal hm]

end Helpers

/-- **The valuation of the extension of an ideal**: for a nonzero ideal `I` of `𝓞 F` and a place
`𝔓` of `𝓞 L` above `𝔭`, the exponent of `𝔓` in the factorization of `I · 𝓞 L` is the ramification
index `e(𝔓/𝔭)` times the exponent of `𝔭` in the factorization of `I`. -/
theorem count_map_eq (F L : Type*) [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
    (𝔓 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (h𝔓 : 𝔓.asIdeal ∈ 𝔭.asIdeal.primesOver (NumberField.RingOfIntegers L))
    (I : Ideal (NumberField.RingOfIntegers F)) (hI : I ≠ 0) :
    FractionalIdeal.count L 𝔓
        ((Ideal.map (algebraMap (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L)) I :
            Ideal (NumberField.RingOfIntegers L)) :
          FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers L)) L)
      = (((𝔓.asIdeal).ramificationIdx (NumberField.RingOfIntegers F) : ℕ) : ℤ)
        * FractionalIdeal.count F 𝔭
            (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers F)) F) := by
  classical
  haveI hlies : 𝔓.asIdeal.LiesOver 𝔭.asIdeal := h𝔓.2
  -- the extension of a nonzero ideal is nonzero
  have hmap0 : ∀ {J : Ideal (𝓞 F)}, J ≠ 0 → Ideal.map (algebraMap (𝓞 F) (𝓞 L)) J ≠ 0 := by
    intro J hJ
    rw [Ideal.zero_eq_bot]
    exact Ideal.map_ne_bot_of_ne_bot (R := 𝓞 F) (S := 𝓞 L) (I := J)
      (by rwa [Ideal.zero_eq_bot] at hJ)
  have hmapI : Ideal.map (algebraMap (𝓞 F) (𝓞 L)) I ≠ 0 := hmap0 hI
  have hmap𝔭 : Ideal.map (algebraMap (𝓞 F) (𝓞 L)) 𝔭.asIdeal ≠ 0 :=
    hmap0 (by simpa using 𝔭.ne_bot)
  -- the finite set of places dividing `I`, enlarged by `𝔭`
  have hfin : Function.HasFiniteMulSupport
      (fun p : IsDedekindDomain.HeightOneSpectrum (𝓞 F) => p.maxPowDividing I) :=
    Ideal.hasFiniteMulSupport hI
  set s : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F)) :=
    insert 𝔭 (Set.Finite.toFinset hfin) with hs
  have hsub : Set.Finite.toFinset hfin ⊆ s := by rw [hs]; exact Finset.subset_insert _ _
  have hmax : ∀ p : IsDedekindDomain.HeightOneSpectrum (𝓞 F),
      p.maxPowDividing I = p.asIdeal ^ (factorization I) p.asIdeal := by
    intro p
    rw [IsDedekindDomain.HeightOneSpectrum.maxPowDividing_eq_pow_multiplicity hI p,
      IsDedekindDomain.HeightOneSpectrum.factorization_eq_multiplicity hI p]
  have hprod0 : I = ∏ p ∈ s, p.maxPowDividing I := by
    rw [← finprod_eq_prod_of_mulSupport_toFinset_subset
        (fun p : IsDedekindDomain.HeightOneSpectrum (𝓞 F) => p.maxPowDividing I) hfin hsub,
      Ideal.finprod_heightOneSpectrum_factorization hI]
  -- the primary decomposition of `I`
  have hfac : I = ∏ p ∈ s, p.asIdeal ^ (factorization I) p.asIdeal := by
    conv_lhs => rw [hprod0]
    exact Finset.prod_congr rfl fun p _ => hmax p
  -- `factorization` of the extension, expanded along the primary decomposition
  have hfact : factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) I)
      = ∑ p ∈ s, (factorization I) p.asIdeal •
          factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) p.asIdeal) := by
    have hg : ∀ p : IsDedekindDomain.HeightOneSpectrum (𝓞 F),
        Ideal.map (algebraMap (𝓞 F) (𝓞 L)) (p.asIdeal ^ (factorization I) p.asIdeal) ≠ 0 :=
      fun p => hmap0 (pow_ne_zero _ (by simpa using p.ne_bot))
    conv_lhs => rw [hfac]
    rw [ideal_map_algebraMap_finset_prod,
      factorization_finset_prod_of_nonzero s
        (fun p => Ideal.map (algebraMap (𝓞 F) (𝓞 L))
          (p.asIdeal ^ (factorization I) p.asIdeal)) hg]
    exact Finset.sum_congr rfl fun p _ => by rw [Ideal.map_pow, factorization_pow]
  have hkey := congrArg (fun g : Ideal (𝓞 L) →₀ ℕ => g 𝔓.asIdeal) hfact
  simp only [Finsupp.finsetSum_apply, Finsupp.smul_apply, smul_eq_mul] at hkey
  -- all terms with `p ≠ 𝔭` vanish
  have hsum : (∑ p ∈ s, (factorization I) p.asIdeal *
        (factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) p.asIdeal)) 𝔓.asIdeal)
      = (factorization I) 𝔭.asIdeal *
        (factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) 𝔭.asIdeal)) 𝔓.asIdeal := by
    refine Finset.sum_eq_single 𝔭 (fun p _ hne => ?_) (fun hmem => ?_)
    · have hpn : p.asIdeal ≠ 𝔭.asIdeal :=
        fun h => hne (IsDedekindDomain.HeightOneSpectrum.ext h)
      have hnlies : ¬ 𝔓.asIdeal.LiesOver p.asIdeal := by
        intro h
        have h1 := (Ideal.liesOver_iff 𝔓.asIdeal p.asIdeal).mp h
        have h2 := (Ideal.liesOver_iff 𝔓.asIdeal 𝔭.asIdeal).mp hlies
        exact hpn (h1.trans h2.symm)
      rw [factorization_map_eq_zero_of_not_liesOver p.isMaximal 𝔓.isPrime hnlies, mul_zero]
    · exact absurd (Finset.mem_insert_self 𝔭 (Set.Finite.toFinset hfin)) hmem
  have hval : (factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) I)) 𝔓.asIdeal
      = (factorization I) 𝔭.asIdeal *
        (factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) 𝔭.asIdeal)) 𝔓.asIdeal := by
    rw [hkey, hsum]
  -- the remaining term is the ramification index
  have hram : (factorization (Ideal.map (algebraMap (𝓞 F) (𝓞 L)) 𝔭.asIdeal)) 𝔓.asIdeal
      = 𝔓.asIdeal.ramificationIdx (𝓞 F) := by
    rw [Ideal.zero_eq_bot] at hmap𝔭
    exact factorization_map_eq_ramificationIdx_of_liesOver 𝔭.asIdeal 𝔓 hmap𝔭
  rw [fractionalIdeal_count_coe_eq_factorization (𝓞 L) L 𝔓 hmapI,
    fractionalIdeal_count_coe_eq_factorization (𝓞 F) F 𝔭 hI, hval, hram, Nat.cast_mul]
  ring

end Work.ShafarevichKoch
