/-!
# `Work.ShafarevichKoch.card_unramifiedQuadraticLevels_le`

The number of unramified quadratic levels of the maximal unramified pro-`2` extension `F_∅` of a
number field `F` is at most the number of square classes of the Kummer radical `V_∅` of `F`, and
that number is `2 ^ (unitTwoRank F + classGroupTwoRank F)` by the elementary Kummer two-descent
`1 → O_F^×/(O_F^×)² → V_∅/F^×² → Cl(F)[2] → 1`.

Concretely: every quadratic level `L i ⊆ F_∅` of `F` is unramified over `F`
(`MaximalUnramifiedProP.unramified`), hence is generated by a square root of a Kummer class
`a i ∈ V_∅`; distinct levels have distinct square classes; the class `vClass F (a i) ∈ Cl(F)[2]`
together with the "unit part" of `a i` in `O_F^×/(O_F^×)²` determines the level.  This bounds the
number of levels by `#Cl(F)[2] · #(O_F^×/(O_F^×)²) = 2 ^ (classGroupTwoRank F + unitTwoRank F)`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

/-! ## Auxiliary lemmas on `sqClass` -/

/-- The class map `A → A/A²` is additive on products. -/
theorem cuql_sqClass_mul {A : Type*} [CommGroup A] (a b : A) :
    Work.QuadraticFields.sqClass (a * b)
      = Work.QuadraticFields.sqClass a + Work.QuadraticFields.sqClass b := by
  simp only [Work.QuadraticFields.sqClass, ModN.mkQ]
  rw [show Additive.ofMul (a * b) = Additive.ofMul a + Additive.ofMul b from by simp, map_add]

/-- A square has trivial class modulo squares. -/
theorem cuql_sqClass_sq {A : Type*} [CommGroup A] (a : A) :
    Work.QuadraticFields.sqClass (a ^ 2) = 0 := by
  rw [Work.QuadraticFields.sqClass_eq_zero_iff]
  exact Work.QuadraticFields.mem_squareSubgroup_iff.mpr ⟨a, rfl⟩

/-- The class map is equivariant for inversion. -/
theorem cuql_sqClass_inv {A : Type*} [CommGroup A] (a : A) :
    Work.QuadraticFields.sqClass a⁻¹ = -Work.QuadraticFields.sqClass a := by
  simp only [Work.QuadraticFields.sqClass, ModN.mkQ]
  rw [show Additive.ofMul a⁻¹ = -Additive.ofMul a from by simp, map_neg]

/-- **Two elements have the same class modulo squares iff they differ by a square.** -/
theorem cuql_sqClass_eq_iff {A : Type*} [CommGroup A] (a b : A) :
    Work.QuadraticFields.sqClass a = Work.QuadraticFields.sqClass b ↔ ∃ c : A, a = b * c ^ 2 := by
  constructor
  · intro h
    have h1 : Work.QuadraticFields.sqClass (a * b⁻¹) = 0 := by
      rw [cuql_sqClass_mul, cuql_sqClass_inv, h, add_neg_cancel]
    obtain ⟨c, hc⟩ := Work.QuadraticFields.mem_squareSubgroup_iff.mp
      ((Work.QuadraticFields.sqClass_eq_zero_iff).mp h1)
    refine ⟨c, ?_⟩
    have h2 : c ^ 2 * b = a := by rw [hc]; group
    rw [← h2, mul_comm]
  · rintro ⟨c, rfl⟩
    rw [cuql_sqClass_mul, cuql_sqClass_sq, add_zero]

/-- Two roots of the same element of a field coincide up to sign. -/
theorem cuql_eq_or_eq_neg {K : Type*} [Field K] {x y : K} (h : x * x = y * y) :
    x = y ∨ x = -y := by
  have h1 : (x - y) * (x + y) = 0 := by linear_combination h
  rcases mul_eq_zero.mp h1 with h2 | h2
  · exact Or.inl (sub_eq_zero.mp h2)
  · exact Or.inr (eq_neg_iff_add_eq_zero.mpr h2)

/-- **An element of `Fˣ` which becomes a square in an unramified finite Galois extension lies in
Koch's group `V_∅`**: its principal fractional ideal is a square.

This is the Kummer two-descent: write `x` as an integral element modulo a square
(`exists_integral_mul_square`), so that the square root of `x` in `L` gives an integral element
`x'` of `𝓞 F` with a square root in `L`; unramifiedness then forces `(x')` to be a square of an
integral ideal (`exists_ideal_sq_of_unramified`), and `(x) = (x') / (y)²`. -/
theorem cuql_mem_VTwo_of_unramified (F L : Type*) [Field F] [NumberField F] [Field L]
    [NumberField L] [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    (x : Fˣ) (z : L) (hz : z * z = algebraMap F L (x : F))
    (hur : differentIdeal (𝓞 F) (𝓞 L) = ⊤) : x ∈ VTwo F := by
  classical
  obtain ⟨x', hx'0, y, hy⟩ := exists_integral_mul_square F x
  have hxa : (x' : F) ≠ 0 := by
    rw [hy]; exact mul_ne_zero (Units.ne_zero x) (pow_ne_zero 2 (Units.ne_zero y))
  have hsq : ∃ b : L, b * b = (algebraMap F L) (x' : F) := by
    refine ⟨z * algebraMap F L (y : F), ?_⟩
    rw [show (z * algebraMap F L (y : F)) * (z * algebraMap F L (y : F))
        = (z * z) * (algebraMap F L (y : F)) ^ 2 by ring, hz]
    rw [show (algebraMap F L) (x : F) * (algebraMap F L) (y : F) ^ 2
        = (algebraMap F L) ((x : F) * (y : F) ^ 2) by rw [map_mul, map_pow]]
    rw [hy]
  obtain ⟨I, hI⟩ :=
    Work.ClassFieldTower.exists_ideal_sq_of_unramified (K := F) (L := L) x' hx'0 hur hsq
  have hspan_ne : Ideal.span {x'} ≠ ⊥ := fun h => hx'0 (Ideal.span_singleton_eq_bot.mp h)
  have hspan0 : ((Ideal.span {x'} : Ideal (𝓞 F)) :
      FractionalIdeal (nonZeroDivisors (𝓞 F)) F) ≠ 0 :=
    FractionalIdeal.coeIdeal_ne_zero.mpr hspan_ne
  have hI0 : I ≠ ⊥ := by
    intro h0
    have h : Ideal.span {x'} = ⊥ := by rw [← hI, h0, Ideal.bot_mul]
    exact hspan_ne h
  have hIco0 : ((I : Ideal (𝓞 F)) : FractionalIdeal (nonZeroDivisors (𝓞 F)) F) ≠ 0 :=
    FractionalIdeal.coeIdeal_ne_zero.mpr hI0
  have hcoe : ((FracIdealOf F (Units.mk0 (x' : F) hxa) : IdealUnit F) :
        FractionalIdeal (nonZeroDivisors (𝓞 F)) F)
      = ((Ideal.span {x'} : Ideal (𝓞 F)) : FractionalIdeal (nonZeroDivisors (𝓞 F)) F) := by
    rw [FracIdealOf, coe_toPrincipalIdeal, Units.val_mk0,
      FractionalIdeal.coeIdeal_span_singleton]
  have hA : FracIdealOf F (Units.mk0 (x' : F) hxa)
      = Units.mk0 ((Ideal.span {x'} : Ideal (𝓞 F)) :
          FractionalIdeal (nonZeroDivisors (𝓞 F)) F) hspan0 := by
    apply Units.ext
    rw [Units.val_mk0]
    exact hcoe
  have hsq1 : IsSquareFracIdeal F (FracIdealOf F (Units.mk0 (x' : F) hxa)) := by
    rw [hA]
    refine ⟨Units.mk0 ((I : Ideal (𝓞 F)) : FractionalIdeal (nonZeroDivisors (𝓞 F)) F) hIco0, ?_⟩
    apply Units.ext
    rw [Units.val_mul, Units.val_mk0, Units.val_mk0, ← FractionalIdeal.coeIdeal_mul, hI]
  have hxu : x = Units.mk0 (x' : F) hxa * (y ^ 2)⁻¹ := by
    have hxu' : x * y ^ 2 = Units.mk0 (x' : F) hxa := by
      apply Units.ext
      rw [Units.val_mul, Units.val_pow_eq_pow_val, Units.val_mk0]
      exact hy.symm
    rw [← hxu']
    group
  have hfac : FracIdealOf F x
      = FracIdealOf F (Units.mk0 (x' : F) hxa)
        * (FracIdealOf F y * FracIdealOf F y)⁻¹ := by
    rw [hxu, FracIdealOf_mul, FracIdealOf_inv,
      show FracIdealOf F (y ^ 2) = FracIdealOf F y * FracIdealOf F y by
        rw [pow_two, FracIdealOf_mul]]
  show IsSquareFracIdeal F (FracIdealOf F x)
  rw [hfac]
  exact isSquareFracIdeal_mul F hsq1 (isSquareFracIdeal_inv F ⟨FracIdealOf F y, rfl⟩)

/-- **The abstract group-theoretic core of the counting argument.**

Suppose `X : ι → A`, `rep : κ → A`, `ci : ι → κ`, `emb : B → A`, `u : ι → B`, `yZ : ι → A` and
`hyu k : X k * (rep (ci k))⁻¹ = emb (u k) * yZ k ^ 2`, i.e. `X k` differs from the representative
of its class by `emb (u k)`.  If `ci i = ci j` and `u i = u j * w ^ 2`, then `X i` and `X j` have
the same class modulo squares. -/
theorem cuql_sqClass_eq_of_relations {A B κ ι : Type*} [CommGroup A] [CommGroup B]
    (X : ι → A) (rep : κ → A) (ci : ι → κ) (emb : B → A) (u : ι → B) (yZ : ι → A)
    (emb_mul : ∀ p q : B, emb (p * q) = emb p * emb q)
    (emb_sq : ∀ p : B, emb (p ^ 2) = (emb p) ^ 2)
    (hyu : ∀ k, X k * (rep (ci k))⁻¹ = emb (u k) * (yZ k) ^ 2)
    {i j : ι} (hc : ci i = ci j) {w : B} (hw : u i = u j * w ^ 2) :
    Work.QuadraticFields.sqClass (X i) = Work.QuadraticFields.sqClass (X j) := by
  have hSi : Work.QuadraticFields.sqClass (X i)
      = Work.QuadraticFields.sqClass (emb (u i)) + Work.QuadraticFields.sqClass (rep (ci i)) := by
    have h1 : X i = X i * (rep (ci i))⁻¹ * rep (ci i) := by group
    rw [h1, cuql_sqClass_mul, hyu i, cuql_sqClass_mul, cuql_sqClass_sq, add_zero]
  have hSj : Work.QuadraticFields.sqClass (X j)
      = Work.QuadraticFields.sqClass (emb (u j)) + Work.QuadraticFields.sqClass (rep (ci j)) := by
    have h1 : X j = X j * (rep (ci j))⁻¹ * rep (ci j) := by group
    rw [h1, cuql_sqClass_mul, hyu j, cuql_sqClass_mul, cuql_sqClass_sq, add_zero]
  have hSu : Work.QuadraticFields.sqClass (emb (u i))
      = Work.QuadraticFields.sqClass (emb (u j)) := by
    rw [hw, emb_mul, emb_sq, cuql_sqClass_mul, cuql_sqClass_sq, add_zero]
  rw [hSi, hSj, hSu, hc]

/-! ## The two cardinality computations -/

/-- **The group of square classes of the units of `𝓞 F` has `2 ^ unitTwoRank F` elements.** -/
theorem cuql_card_units (F : Type*) [Field F] [NumberField F] :
    Nat.card (ModN (Additive (RingUnit F)) 2) = 2 ^ Work.ClassFieldTower.unitTwoRank F := by
  have hfr := Work.ClassFieldTower.unitTwoRank_eq_finrank_units_modSquares F
  haveI : Module.Finite (ZMod 2) (ModN (Additive (RingUnit F)) 2) := by
    by_contra h
    have hz : Module.finrank (ZMod 2) (ModN (Additive (RingUnit F)) 2) = 0 :=
      finrank_eq_zero_of_not_exists_basis (R := ZMod 2)
        (M := ModN (Additive (RingUnit F)) 2)
        (by rintro ⟨s, ⟨b⟩⟩; exact h (Module.Finite.of_basis b))
    have h0 : Work.ClassFieldTower.unitTwoRank F = 0 := by rw [hfr, hz]
    simp [Work.ClassFieldTower.unitTwoRank] at h0
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2) (V := ModN (Additive (RingUnit F)) 2),
    Nat.card_zmod, ← hfr]

/-- **The `2`-torsion of the class group has `2 ^ classGroupTwoRank F` elements.** -/
theorem cuql_card_classGroup_twoTorsion (F : Type*) [Field F] [NumberField F] :
    Nat.card {c : ClassGroup (𝓞 F) // c ^ 2 = 1}
      = 2 ^ Work.ClassFieldTower.classGroupTwoRank F :=
  (Work.ClassFieldTower.card_quotient_squareSubgroup_eq_card_twoTorsion
      (ClassGroup (𝓞 F))).symm.trans (Work.ClassFieldTower.two_pow_classGroupTwoRank F).symm

/-! ## The main theorem -/

theorem card_unramifiedQuadraticLevels_le (F : Type*) [Field F] [NumberField F] {ι : Type*}
    [Fintype ι] (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (L : ι → IntermediateField F M.K)
    (hNF : ∀ i, NumberField ↥(L i))
    (hfd : ∀ i, FiniteDimensional F (L i)) (hgal : ∀ i, IsGalois F (L i))
    (h2 : ∀ i, Module.finrank F (L i) = 2) (hinj : Function.Injective L) :
    Fintype.card ι ≤ 2 ^ (Work.ClassFieldTower.unitTwoRank F
      + Work.ClassFieldTower.classGroupTwoRank F) := by
  classical
  choose a b hbmem hbsq hbgen using fun i =>
    Work.ClassFieldTower.degreeTwo_sqrt_gen (K := F) (L := M.K) (by norm_num) (L i) (h2 i)
  have hmem : ∀ i, a i ∈ VTwo F := by
    intro i
    haveI : NumberField ↥(L i) := hNF i
    haveI : FiniteDimensional F ↥(L i) := hfd i
    haveI : IsGalois F ↥(L i) := hgal i
    refine cuql_mem_VTwo_of_unramified F ↥(L i) (a i) ⟨b i, hbmem i⟩ ?_
      (M.unramified (L i) (hfd i) (hgal i))
    apply Subtype.ext
    show b i * b i = algebraMap F M.K ((a i : Fˣ) : F)
    exact hbsq i
  let X : ι → VTwo F := fun i => ⟨a i, hmem i⟩
  -- A. equal square classes force the levels to coincide
  have hkey : ∀ i j, Work.QuadraticFields.sqClass (a i) = Work.QuadraticFields.sqClass (a j)
      → i = j := by
    intro i j hij
    obtain ⟨w, hw⟩ := (cuql_sqClass_eq_iff (a i) (a j)).mp hij
    have hwF : ((a i : Fˣ) : F) = ((a j : Fˣ) : F) * ((w : Fˣ) : F) ^ 2 := by
      rw [hw, Units.val_mul, Units.val_pow_eq_pow_val]
    have hsq2 : b i * b i
        = (algebraMap F M.K ((w : Fˣ) : F) * b j) * (algebraMap F M.K ((w : Fˣ) : F) * b j) := by
      calc b i * b i = algebraMap F M.K ((a i : Fˣ) : F) := hbsq i
        _ = algebraMap F M.K (((a j : Fˣ) : F) * ((w : Fˣ) : F) ^ 2) := by rw [hwF]
        _ = algebraMap F M.K ((a j : Fˣ) : F) * (algebraMap F M.K ((w : Fˣ) : F)) ^ 2 := by
              rw [map_mul, map_pow]
        _ = (b j * b j) * (algebraMap F M.K ((w : Fˣ) : F)) ^ 2 := by rw [← hbsq j]
        _ = (algebraMap F M.K ((w : Fˣ) : F) * b j)
              * (algebraMap F M.K ((w : Fˣ) : F) * b j) := by ring
    have hbijmem : b i ∈ L j := by
      rcases cuql_eq_or_eq_neg hsq2 with h | h
      · rw [h]
        exact mul_mem (IntermediateField.algebraMap_mem (L j) ((w : Fˣ) : F)) (hbmem j)
      · rw [h]
        exact neg_mem (mul_mem (IntermediateField.algebraMap_mem (L j) ((w : Fˣ) : F)) (hbmem j))
    have hle : L i ≤ L j := by
      rw [← hbgen i]
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hbijmem
    haveI : FiniteDimensional F ↥(L j) := hfd j
    exact hinj (IntermediateField.eq_of_le_of_finrank_eq hle (by rw [h2 i, h2 j]))
  -- B. the counting
  have hvClass_one : vClass F (1 : VTwo F) = 1 := by
    have h1 : (1 : IdealUnit F) * 1 = FracIdealOf F (((1 : VTwo F)) : Fˣ) := by
      rw [show (((1 : VTwo F)) : Fˣ) = 1 from Subgroup.coe_one _, FracIdealOf_one, mul_one]
    rw [vClass_eq_mk F (x := 1) (J := 1) h1]
    exact map_one (ClassGroup.mk F)
  let vC : VTwo F →* ClassGroup (𝓞 F) :=
    { toFun := fun x => vClass F x, map_one' := hvClass_one, map_mul' := vClass_mul F }
  have hsurj : ∀ c : {c : ClassGroup (𝓞 F) // c ^ 2 = 1}, ∃ x : VTwo F, vC x = c.1 :=
    fun c => vClass_surjective_twoTorsion F c.1 c.2
  let rep : {c : ClassGroup (𝓞 F) // c ^ 2 = 1} → VTwo F := fun c => Classical.choose (hsurj c)
  have hrep : ∀ c, vC (rep c) = c.1 := fun c => Classical.choose_spec (hsurj c)
  let ci : ι → {c : ClassGroup (𝓞 F) // c ^ 2 = 1} :=
    fun i => ⟨vC (X i), vClass_sq_eq_one F (X i)⟩
  have hZ : ∀ i, vC (X i * (rep (ci i))⁻¹) = 1 := by
    intro i
    rw [map_mul, map_inv, hrep (ci i)]
    exact mul_inv_cancel _
  choose u yZ hyu using fun i =>
    (vClass_eq_one_iff F (X i * (rep (ci i))⁻¹)).mp (hZ i)
  have hyu' : ∀ k, ((X k : VTwo F) : Fˣ) * (((rep (ci k) : VTwo F) : Fˣ))⁻¹
      = unitEmbed F (u k) * (yZ k) ^ 2 := by
    intro k
    simpa only [Subgroup.coe_mul, Subgroup.coe_inv] using hyu k
  let Φ : ι → {c : ClassGroup (𝓞 F) // c ^ 2 = 1} × ModN (Additive (RingUnit F)) 2 :=
    fun i => (ci i, Work.QuadraticFields.sqClass (u i))
  have hΦinj : Function.Injective Φ := by
    intro i j hij
    have hc : ci i = ci j := congrArg Prod.fst hij
    have hu : Work.QuadraticFields.sqClass (u i) = Work.QuadraticFields.sqClass (u j) :=
      congrArg Prod.snd hij
    obtain ⟨w, hw⟩ := (cuql_sqClass_eq_iff (u i) (u j)).mp hu
    apply hkey i j
    exact cuql_sqClass_eq_of_relations (X := fun k => ((X k : VTwo F) : Fˣ))
      (rep := fun c => ((rep c : VTwo F) : Fˣ)) (ci := ci) (emb := unitEmbed F) (u := u)
      (yZ := yZ) (fun p q => unitEmbed_mul F p q)
      (fun p => by rw [pow_two, unitEmbed_mul, pow_two]) hyu' hc hw
  have hcardCl : Nat.card {c : ClassGroup (𝓞 F) // c ^ 2 = 1}
      = 2 ^ Work.ClassFieldTower.classGroupTwoRank F := cuql_card_classGroup_twoTorsion F
  have hcardU : Nat.card (ModN (Additive (RingUnit F)) 2)
      = 2 ^ Work.ClassFieldTower.unitTwoRank F := cuql_card_units F
  have hne : Nat.card (ModN (Additive (RingUnit F)) 2) ≠ 0 := by
    rw [hcardU]; positivity
  haveI : Finite (ModN (Additive (RingUnit F)) 2) := (Nat.card_ne_zero.mp hne).2
  haveI : Fintype (ModN (Additive (RingUnit F)) 2) :=
    Fintype.ofFinite (ModN (Additive (RingUnit F)) 2)
  calc Fintype.card ι
      ≤ Fintype.card ({c : ClassGroup (𝓞 F) // c ^ 2 = 1}
          × ModN (Additive (RingUnit F)) 2) := Fintype.card_le_of_injective Φ hΦinj
    _ = Fintype.card {c : ClassGroup (𝓞 F) // c ^ 2 = 1}
          * Fintype.card (ModN (Additive (RingUnit F)) 2) := Fintype.card_prod _ _
    _ = 2 ^ Work.ClassFieldTower.classGroupTwoRank F
          * 2 ^ Work.ClassFieldTower.unitTwoRank F := by
          rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hcardCl, hcardU]
    _ = 2 ^ (Work.ClassFieldTower.classGroupTwoRank F
          + Work.ClassFieldTower.unitTwoRank F) := (pow_add _ _ _).symm
    _ = 2 ^ (Work.ClassFieldTower.unitTwoRank F
          + Work.ClassFieldTower.classGroupTwoRank F) := by rw [add_comm]


end Work.ShafarevichKoch
