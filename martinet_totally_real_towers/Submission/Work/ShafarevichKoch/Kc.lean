import Mathlib
import Submission.Work.ShafarevichKoch.RelationBound
import Submission.Work.ShafarevichKoch.infiniteProTwoExtension_of_hasProTwoPresentation
import Submission.Work.ClassFieldTower.Wall
import Submission.Work.ClassFieldTower.Bridge

/-!
# `Work.ShafarevichKoch.Kc` -- the concrete conclusion for `Kc = ℚ(√-30030)`

This file states the classical Shafarevich--Koch input for the explicit imaginary quadratic field
`Kc = ℚ(√-30030)` in the *presentation* form of `RelationBound.lean` and derives from it

* the infinitude of the maximal unramified pro-`2` extension of `Kc` (an infinite Hilbert
  `2`-class field tower);
* the main agent's walls `Submission.NumberField.UnramifiedPro2TowerWall` and
  `Submission.NumberField.BoundedRdTowerWall`;
* the asymptotically good family of unramified levels over `Kc`: for every `N` a finite Galois
  `L/Kc` with `[L : Kc] ≥ N`, unramified, and `rootDiscr L = rootDiscr Kc`.

The input is `KcProTwoPresentationInput` below: `G_∅` is generated by `5` elements subject to at
most `6` relations, with the presented abstract group embedded in `G_∅`.  The number `5` is
`rank₂ Cl(Kc)` (`Work.ClassFieldTower.five_le_classGroupTwoRank`) and `6 = 5 + d₂(O_K^×)` with
`d₂(O_K^×) = 1` (`Work.ClassFieldTower.unitTwoRank_witness_le_one`), i.e. these are exactly the
numerical values of the Shafarevich--Koch theorem.  Nothing here proves the input: it *is* the
classical relation count (Wingberg duality / Koch Thm 11.3), which this workspace does not
contain.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **The classical Shafarevich--Koch input for `Kc = ℚ(√-30030)`, in presentation form.**

`G_∅ = Gal(Kc_∅/Kc)` is generated by `5 = rank₂ Cl(Kc)` elements subject to at most
`6 = rank₂ Cl(Kc) + d₂(O_Kc^×)` relations, the presented abstract group being the subgroup of
`G_∅` generated by those `5` elements (see `HasProTwoPresentation`).

This is the single remaining arithmetic input for the infinitude of the Hilbert `2`-class field
tower of `Kc`; it is the numerical form of Koch (*Galois Theory of `p`-Extensions*, Ch. 11,
Thm 11.3) together with Wingberg's relation bound `r - d ≤ d₂(O_K^×)`. -/
def KcProTwoPresentationInput : Prop :=
  ∃ r : ℕ, r ≤ 6 ∧ HasProTwoPresentation Kc 5 r

/-- **The concrete conclusion: `Kc` has an infinite Hilbert `2`-class field tower.**  From the
presentation datum `HasProTwoPresentation Kc 5 r` with `r ≤ 6`, via
`infiniteProTwoExtension_of_hasProTwoPresentation` and the genus level of `Kc`
(`Work.ClassFieldTower.hasGenusLevel_witness`). -/
theorem infiniteProTwoExtension_Kc_of_hasProTwoPresentation {r : ℕ}
    (h : HasProTwoPresentation Kc 5 r) (hr : r ≤ 6) :
    Work.ClassFieldTower.InfiniteProTwoExtension Kc :=
  infiniteProTwoExtension_of_hasProTwoPresentation Kc
    Work.ClassFieldTower.hasGenusLevel_witness h hr

/-- **The concrete conclusion, from the named input.** -/
theorem infiniteProTwoExtension_Kc_of_input (h : KcProTwoPresentationInput) :
    Work.ClassFieldTower.InfiniteProTwoExtension Kc := by
  obtain ⟨r, hr, hpres⟩ := h
  exact infiniteProTwoExtension_Kc_of_hasProTwoPresentation hpres hr

/-- **The conclusion in the caller's wall form.**  The presentation datum for `Kc` implies
`Submission.NumberField.UnramifiedPro2TowerWall`, the weakest arithmetic wall of the benchmark
route. -/
theorem unramifiedPro2TowerWall_of_hasProTwoPresentation {r : ℕ}
    (h : HasProTwoPresentation Kc 5 r) (hr : r ≤ 6) :
    Submission.NumberField.UnramifiedPro2TowerWall :=
  Work.ClassFieldTower.unramifiedPro2TowerWall_of_infiniteProTwoExtension
    (infiniteProTwoExtension_Kc_of_hasProTwoPresentation h hr)

/-- **The conclusion in the caller's wall form, from the named input.** -/
theorem unramifiedPro2TowerWall_of_input (h : KcProTwoPresentationInput) :
    Submission.NumberField.UnramifiedPro2TowerWall :=
  Work.ClassFieldTower.unramifiedPro2TowerWall_of_infiniteProTwoExtension
    (infiniteProTwoExtension_Kc_of_input h)

/-- **The root-discriminant tower wall for `Kc`.** -/
theorem boundedRdTowerWall_of_input (h : KcProTwoPresentationInput) :
    Submission.NumberField.BoundedRdTowerWall :=
  Submission.NumberField.boundedRdTowerWall_of_unramifiedPro2TowerWall
    (unramifiedPro2TowerWall_of_input h)

/-- **Unramified levels of every prescribed degree with constant root discriminant.**  From the
presentation datum for `Kc`, for every `N` there is a finite Galois `L/Kc` with `[L : Kc] ≥ N`,
`differentIdeal (𝓞 Kc) (𝓞 L) = ⊤` and `rootDiscr L = rootDiscr Kc`. -/
theorem exists_unramifiedLevel_rootDiscr_of_hasProTwoPresentation {r : ℕ}
    (h : HasProTwoPresentation Kc 5 r) (hr : r ≤ 6) (N : ℕ) :
    ∃ (L : Type) (_ : Field L) (_ : NumberField L) (_ : Algebra Kc L)
      (_ : FiniteDimensional Kc L) (_ : IsGalois Kc L),
      N ≤ Module.finrank Kc L ∧ differentIdeal (𝓞 Kc) (𝓞 L) = ⊤ ∧
        NumberField.rootDiscr L = NumberField.rootDiscr Kc := by
  obtain ⟨M, hM⟩ := infiniteProTwoExtension_Kc_of_hasProTwoPresentation h hr
  exact Work.ClassFieldTower.exists_unramifiedLevel_of_infinite (F := Kc) (p := 2) M hM N

end Work.ShafarevichKoch
