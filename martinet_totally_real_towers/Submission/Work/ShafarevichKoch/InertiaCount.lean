import Mathlib
import Submission.Work.ShafarevichKoch.Conj
import Submission.Work.ShafarevichKoch.SupportedInertia
import Submission.Work.ShafarevichKoch.SupportedInertiaGeneration
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.ShafarevichKoch.card_relFrattiniQuotient_le_of_le_normalClosure_sup

/-!
# `Work.ShafarevichKoch.InertiaCount` -- the inertia classes generate `Gal(L/N)` modulo `K^2[K,G]`

This is the **finite-level counting input** of item (ii) of the counting route of `README.md`
§16.3, in the form in which it is actually *true* and *provable*.

## The point (a correction of an earlier plan)

The naive statement "`Gal(L/N)` is generated by `s` elements, one per prime of `F` above `S`,
hence has at most `2^s` quadratic characters" is **false**: if `I_P` is the inertia group at a
prime `P` over `S` and `σ ∈ Gal(L/F)`, then `σ I_P σ⁻¹ = I_{σP}` is a *different* subgroup, and
the images of `I_P` and of its conjugate in the elementary abelian quotient
`Gal(L/N) / Φ(Gal(L/N))` need **not** coincide; the `Gal(L/N)`-conjugates do coincide, but the
`Gal(L/F)`-conjugates need not.  Since the primes over a fixed prime `𝔮` of `F` form one
`Gal(L/F)`-orbit, the naive count would be `1` per prime of `F`, whereas the honest count is one
generator per `Gal(L/N)`-orbit, i.e. per prime of the *unramified* field `N`.

What *is* true, and what the Hochschild--Serre/Hopf--Gaschütz dictionary in fact consumes, is the
bound on the **relation-Frattini quotient** `K ⧸ K²[K,G]`:

> `K := N.fixingSubgroup = ⨆_{P over S} I_P` satisfies, for any family `Q i` of primes over `S`
> whose `Gal(L/F)`-conjugates cover the primes over `S`, and any one-element generating sets
> `g i` of the inertia groups `I_{Q i}`,
> `K ≤ ⟨g i : i⟩ ⊔ K²[K,G]`.

Indeed `σ (g i) σ⁻¹ = g i · [g i⁻¹, σ]` and `[g i⁻¹, σ] ∈ [K, G] ⊆ K²[K,G]`, so the conjugates
collapse *in the relation-Frattini quotient* even though they do not collapse in `K/Φ(K)`.

`card_relFrattiniQuotient_le_pow_card_of_le_closure_sup` (already in this directory) then gives

  `Nat.card (K ⧸ K²[K,G]) ≤ 2 ^ #ι`,

i.e. `dim_{𝔽₂} (K / K²[K,G]) ≤ #ι` -- exactly the "transgression image" input of the counting
engine `natCard_ker_H2Res_le_card_hom`.

The hypotheses `hQ`, `hcov` are supplied by number theory (`hcov` is transitivity of the Galois
action on the primes over a prime, `exists_conjIdeal_eq_of_liesOver`), and `hgen` is the
**cyclicity of the inertia groups**, which for tame `S` is the classical statement that the
inertia group of a tamely ramified extension is cyclic (a local-field statement, no class field
theory).  For `S` consisting of odd primes that is the only remaining input here.
-/

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped commutatorElement
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

/-- **The inertia classes generate `Gal(L/N)` modulo the relation-Frattini subgroup.**
See the module docstring. -/
theorem fixingSubgroup_le_closure_inertia_sup_relFrattini {F L : Type} [Field F] [Field L]
    [Algebra F L] [NumberField F] [NumberField L] [FiniteDimensional F L] [IsGalois F L]
    (S : Finset ℕ)
    (hsupp : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime → P ≠ ⊥ →
      P ∣ differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L) →
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (N : IntermediateField F L) [FiniteDimensional F ↥N] [IsGalois F ↥N] [NumberField ↥N]
    (hN : differentIdeal (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers ↥N) = ⊤)
    (hmax : ∀ (K : IntermediateField F L) [FiniteDimensional F ↥K] [IsGalois F ↥K]
      [NumberField ↥K], differentIdeal (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers ↥K) = ⊤ → K ≤ N)
    {ι : Type} (Q : ι → Ideal (NumberField.RingOfIntegers L))
    (hQ : ∀ i, (Q i).IsPrime ∧ ∃ q ∈ S, (Q i).LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (hcov : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime →
      (∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))) →
        ∃ (i : ι) (σ : L ≃ₐ[F] L), P = conjIdeal σ (Q i))
    (g : ι → L ≃ₐ[F] L) (hg : ∀ i, g i ∈ Ideal.inertia (L ≃ₐ[F] L) (Q i))
    (hgen : ∀ i, Subgroup.closure {g i} = Ideal.inertia (L ≃ₐ[F] L) (Q i)) :
    N.fixingSubgroup ≤
      Subgroup.closure (Set.range g) ⊔ Work.HopfGaschutz.relFrattini 2 N.fixingSubgroup := by
  haveI : (N.fixingSubgroup).Normal := inferInstance
  have hinertia_le : ∀ i, Ideal.inertia (L ≃ₐ[F] L) (Q i) ≤ N.fixingSubgroup := fun i =>
    le_trans (le_iSup (fun P : {P : Ideal (NumberField.RingOfIntegers L) // P.IsPrime ∧
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))} =>
          Ideal.inertia (L ≃ₐ[F] L) P.1) ⟨Q i, hQ i⟩)
      (iSup_inertia_le_fixingSubgroup S N hN)
  have hmain : (⨆ (P : {P : Ideal (NumberField.RingOfIntegers L) // P.IsPrime ∧
      ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}),
        Ideal.inertia (L ≃ₐ[F] L) P.1) ≤
      Subgroup.closure (Set.range g) ⊔ Work.HopfGaschutz.relFrattini 2 N.fixingSubgroup := by
    refine iSup_le fun P => ?_
    obtain ⟨i, σ, hPσ⟩ := hcov P.1 P.2.1 P.2.2
    have hI : Ideal.inertia (L ≃ₐ[F] L) P.1 =
        (Ideal.inertia (L ≃ₐ[F] L) (Q i)).map (MulAut.conj σ) := by
      rw [hPσ, inertia_conjIdeal]
    rw [hI]
    refine Subgroup.map_le_iff_le_comap.mpr fun x hx => ?_
    show MulAut.conj σ x ∈ Subgroup.closure (Set.range g) ⊔
      Work.HopfGaschutz.relFrattini 2 N.fixingSubgroup
    have hxgen : x ∈ Subgroup.closure {g i} := by rw [hgen i]; exact hx
    have hxcl : x ∈ Subgroup.closure (Set.range g) :=
      Subgroup.closure_mono (Set.singleton_subset_iff.mpr (Set.mem_range_self i)) hxgen
    have hxK : x ∈ N.fixingSubgroup := hinertia_le i hx
    have hcomm : ⁅x⁻¹, σ⁆ ∈ Work.HopfGaschutz.relFrattini 2 N.fixingSubgroup :=
      Work.HopfGaschutz.commutator_mem_relFrattini 2 N.fixingSubgroup
        (Subgroup.inv_mem _ hxK) (f := σ)
    have hconj : MulAut.conj σ x = x * ⁅x⁻¹, σ⁆ := by
      rw [MulAut.conj_apply, commutatorElement_def]
      group
    rw [hconj]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hxcl) (Subgroup.mem_sup_right hcomm)
  rw [← fixingSubgroup_eq_iSup_inertia S hsupp N hN hmax] at hmain
  exact hmain

/-- **The relation-Frattini quotient of `Gal(L/N)` has at most `2 ^ #ι` elements.**  This is
`fixingSubgroup_le_closure_inertia_sup_relFrattini` combined with the counting lemma
`natCard_relFrattiniQuotient_le_pow_card_of_le_closure_sup`: the inertia generators normally
generate `Gal(L/N)` modulo `K²[K,G]`, and the conjugates collapse there. -/
theorem card_relFrattiniQuotient_fixingSubgroup_le {F L : Type} [Field F] [Field L]
    [Algebra F L] [NumberField F] [NumberField L] [FiniteDimensional F L] [IsGalois F L]
    (S : Finset ℕ)
    (hsupp : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime → P ≠ ⊥ →
      P ∣ differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L) →
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (N : IntermediateField F L) [FiniteDimensional F ↥N] [IsGalois F ↥N] [NumberField ↥N]
    (hN : differentIdeal (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers ↥N) = ⊤)
    (hmax : ∀ (K : IntermediateField F L) [FiniteDimensional F ↥K] [IsGalois F ↥K]
      [NumberField ↥K], differentIdeal (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers ↥K) = ⊤ → K ≤ N)
    {ι : Type} [Fintype ι] (Q : ι → Ideal (NumberField.RingOfIntegers L))
    (hQ : ∀ i, (Q i).IsPrime ∧ ∃ q ∈ S, (Q i).LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (hcov : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime →
      (∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))) →
        ∃ (i : ι) (σ : L ≃ₐ[F] L), P = conjIdeal σ (Q i))
    (g : ι → L ≃ₐ[F] L) (hg : ∀ i, g i ∈ Ideal.inertia (L ≃ₐ[F] L) (Q i))
    (hgen : ∀ i, Subgroup.closure {g i} = Ideal.inertia (L ≃ₐ[F] L) (Q i)) :
    Nat.card (↥(N.fixingSubgroup) ⧸ Work.HopfGaschutz.relFrattiniIn 2 (N.fixingSubgroup)) ≤
      2 ^ Fintype.card ι := by
  classical
  haveI : (N.fixingSubgroup).Normal := inferInstance
  have hinertia_le : ∀ i, Ideal.inertia (L ≃ₐ[F] L) (Q i) ≤ N.fixingSubgroup := fun i =>
    le_trans (le_iSup (fun P : {P : Ideal (NumberField.RingOfIntegers L) // P.IsPrime ∧
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))} =>
          Ideal.inertia (L ≃ₐ[F] L) P.1) ⟨Q i, hQ i⟩)
      (iSup_inertia_le_fixingSubgroup S N hN)
  have hS : ((Finset.univ.image g : Finset (L ≃ₐ[F] L)) : Set (L ≃ₐ[F] L)) ⊆ N.fixingSubgroup := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    rintro x ⟨i, rfl⟩
    exact hinertia_le i (hg i)
  have hclosure : Subgroup.closure ((Finset.univ.image g : Finset (L ≃ₐ[F] L)) :
      Set (L ≃ₐ[F] L)) = Subgroup.closure (Set.range g) := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hle : N.fixingSubgroup ≤
      Subgroup.closure ((Finset.univ.image g : Finset (L ≃ₐ[F] L)) : Set (L ≃ₐ[F] L)) ⊔
        Work.HopfGaschutz.relFrattini 2 N.fixingSubgroup := by
    rw [hclosure]
    exact fixingSubgroup_le_closure_inertia_sup_relFrattini S hsupp N hN hmax Q hQ hcov g hg hgen
  have hcard := natCard_relFrattiniQuotient_le_pow_card_of_le_closure_sup
    (F := L ≃ₐ[F] L) (K := N.fixingSubgroup) (S := Finset.univ.image g) 2 (by norm_num) hS hle
  refine le_trans hcard (Nat.pow_le_pow_right (by norm_num) ?_)
  exact Finset.card_image_le.trans (le_of_eq Finset.card_univ)

end Work.ShafarevichKoch
