import Mathlib
import Submission.Work.ClassFieldTower.All

/-!
# `Work.ShafarevichKoch.Defs` -- the Kummer two-descent of a number field

This is the definition layer of the Shafarevich--Koch chapter
(`Submission/Work/ShafarevichKoch/`), the area that supplies the arithmetic relation count for
the maximal unramified pro-`2` extension of an imaginary quadratic field.

The chapter follows Koch, *Galois Theory of `p`-Extensions*, Chapter 11 (in the case `p = 2`),
in the form stated in Hajir--Maire--Ramakrishna, *Deficiency of `p`-class tower groups and
Minkowski units* (arXiv:2103.09508): with

`V_∅ = {x ∈ Fˣ : (x) = I²²  is a square fractional ideal}`

one has the exact sequence

`0 → 𝓞_Fˣ/(𝓞_Fˣ)² → V_∅/Fˣ² → Cl(F)[2] → 0`

and `d(V_∅/Fˣ²) = d(𝓞_Fˣ) + d(Cl(F))`.  The group `V_∅` is the *Kummer radical* of the maximal
unramified exponent-`2` extension of `F`, and the second map (`x ↦` the class of the square root
of `(x)`) is the Kummer two-descent used to bound the number of unramified quadratic extensions
of `F` by `rank₂ Cl(F)`.

## Conventions

* `FracIdealOf F x` is the principal fractional ideal `(x)` of `𝓞 F` inside `F`, as a *unit* of
  the monoid of fractional ideals (i.e. an invertible fractional ideal).
* `IsSquareFracIdeal F I` says `I = J * J` for some fractional ideal `J`.
* `VTwo F` is Koch's `V_∅` for `p = 2`: the subgroup of `Fˣ` whose elements generate a square
  fractional ideal.
* `vClass F x` is the class in `Cl(𝓞 F)` of a square root of `(x)`, for `x ∈ VTwo F`; it is a
  `2`-torsion class.  Its independence of the choice of square root is
  `Work.ShafarevichKoch.vClass_eq_mk` (proved in `IdealSquare.lean`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

section Defs

variable (F : Type*) [Field F] [NumberField F]


/-- The **monoid of invertible fractional ideals** of `𝓞 F` inside `F`.  It is a group, freely
generated by the nonzero prime ideals of `𝓞 F`, and `FracIdealOf` is a monoid homomorphism
`Fˣ → IdealUnit F`. -/
abbrev IdealUnit (F : Type*) [Field F] [NumberField F] : Type _ :=
  (FractionalIdeal (nonZeroDivisors (𝓞 F)) F)ˣ

/-- The group of units of the ring of integers `𝓞 F`. -/
abbrev RingUnit (F : Type*) [Field F] [NumberField F] : Type _ := (𝓞 F)ˣ

/-- The image of a unit of `𝓞 F` in `Fˣ`. -/
def unitEmbed (F : Type*) [Field F] [NumberField F] (u : RingUnit F) : Fˣ :=
  Units.map (algebraMap (𝓞 F) F).toMonoidHom u

@[simp] theorem unitEmbed_coe (F : Type*) [Field F] [NumberField F] (u : RingUnit F) :
    ((unitEmbed F u : Fˣ) : F) = algebraMap (𝓞 F) F (u : 𝓞 F) := rfl

@[simp] theorem unitEmbed_mul (F : Type*) [Field F] [NumberField F] (u v : RingUnit F) :
    unitEmbed F (u * v) = unitEmbed F u * unitEmbed F v := rfl

@[simp] theorem unitEmbed_one (F : Type*) [Field F] [NumberField F] :
    unitEmbed F 1 = 1 := rfl

/-- **The principal fractional ideal `(x)`**, as a unit of the monoid of fractional ideals of
`𝓞 F` inside `F`.  (`toPrincipalIdeal` is Mathlib's name for this monoid homomorphism.) -/
def FracIdealOf (x : Fˣ) : (FractionalIdeal (nonZeroDivisors (𝓞 F)) F)ˣ :=
  toPrincipalIdeal (𝓞 F) F x

theorem FracIdealOf_mul (x y : Fˣ) :
    FracIdealOf F (x * y) = FracIdealOf F x * FracIdealOf F y :=
  map_mul (toPrincipalIdeal (𝓞 F) F) x y

theorem FracIdealOf_one : FracIdealOf F 1 = 1 :=
  map_one (toPrincipalIdeal (𝓞 F) F)

theorem FracIdealOf_inv (x : Fˣ) : FracIdealOf F x⁻¹ = (FracIdealOf F x)⁻¹ :=
  map_inv (toPrincipalIdeal (𝓞 F) F) x

/-- **`I` is a square** in the monoid of fractional ideals of `𝓞 F`. -/
def IsSquareFracIdeal (I : (FractionalIdeal (nonZeroDivisors (𝓞 F)) F)ˣ) : Prop :=
  ∃ J, J * J = I

theorem isSquareFracIdeal_mul {I J : (FractionalIdeal (nonZeroDivisors (𝓞 F)) F)ˣ}
    (hI : IsSquareFracIdeal F I) (hJ : IsSquareFracIdeal F J) :
    IsSquareFracIdeal F (I * J) := by
  obtain ⟨a, ha⟩ := hI
  obtain ⟨b, hb⟩ := hJ
  exact ⟨a * b, by rw [mul_mul_mul_comm, ha, hb]⟩

theorem isSquareFracIdeal_one : IsSquareFracIdeal F 1 := ⟨1, mul_one 1⟩

theorem isSquareFracIdeal_inv {I : (FractionalIdeal (nonZeroDivisors (𝓞 F)) F)ˣ}
    (hI : IsSquareFracIdeal F I) : IsSquareFracIdeal F I⁻¹ := by
  obtain ⟨J, hJ⟩ := hI
  refine ⟨J⁻¹, ?_⟩
  have h := congrArg Inv.inv hJ
  simpa [mul_inv] using h

/-- **Koch's group `V_∅`** for `p = 2`: the `x ∈ Fˣ` whose principal fractional ideal `(x)` is a
square.  This is the Kummer radical of the maximal unramified exponent-`2` extension of `F`. -/
def VTwo : Subgroup Fˣ where
  carrier := {x | IsSquareFracIdeal F (FracIdealOf F x)}
  mul_mem' := fun hx hy => by
    show IsSquareFracIdeal F (FracIdealOf F (_ * _))
    rw [FracIdealOf_mul]
    exact isSquareFracIdeal_mul F hx hy
  one_mem' := by
    show IsSquareFracIdeal F (FracIdealOf F 1)
    rw [FracIdealOf_one]
    exact isSquareFracIdeal_one F
  inv_mem' := fun hx => by
    show IsSquareFracIdeal F (FracIdealOf F _⁻¹)
    rw [FracIdealOf_inv]
    exact isSquareFracIdeal_inv F hx

theorem mem_VTwo_iff {x : Fˣ} : x ∈ VTwo F ↔ IsSquareFracIdeal F (FracIdealOf F x) := Iff.rfl

/-- The square-root of `(x)` chosen by `Classical.choose`, for `x ∈ V_∅`. -/
theorem vClass_spec (x : VTwo F) :
    Classical.choose (x.property : IsSquareFracIdeal F (FracIdealOf F x.1))
      * Classical.choose (x.property : IsSquareFracIdeal F (FracIdealOf F x.1))
      = FracIdealOf F x.1 :=
  Classical.choose_spec (x.property : IsSquareFracIdeal F (FracIdealOf F x.1))

/-- **The Kummer two-descent class** `vClass F x ∈ Cl(𝓞 F)`: the ideal class of a square root of
`(x)`, for `x ∈ V_∅`.  It is a `2`-torsion class (`vClass_sq_eq_one`), and it depends only on `x`
(`vClass_eq_mk`), so that it induces the map `V_∅/Fˣ² → Cl(F)[2]` of the exact sequence in the
module docstring. -/
def vClass (x : VTwo F) : ClassGroup (𝓞 F) :=
  ClassGroup.mk F (Classical.choose (x.property : IsSquareFracIdeal F (FracIdealOf F x.1)))

end Defs

end Work.ShafarevichKoch
