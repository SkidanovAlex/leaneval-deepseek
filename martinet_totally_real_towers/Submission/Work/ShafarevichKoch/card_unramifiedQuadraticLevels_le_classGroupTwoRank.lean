import Mathlib
import Submission.Work.ShafarevichKoch.RelationBound
import Submission.Work.ShafarevichKoch.mem_VTwo_of_unramified
import Submission.Work.ShafarevichKoch.exists_sq_generator
import Submission.Work.ShafarevichKoch.vClass_eq_mk
import Submission.Work.ShafarevichKoch.vClass_eq_one_iff
import Submission.Work.ShafarevichKoch.vClass_mul
import Submission.Work.ShafarevichKoch.vClass_sq_eq_one
import Submission.Work.ShafarevichKoch.vClass_surjective_twoTorsion
import Submission.Work.ClassFieldTower.degreeTwo_sqrt_gen
import Submission.Work.ClassFieldTower.card_quotient_squareSubgroup_eq_card_twoTorsion
import Submission.Work.ClassFieldTower.two_pow_classGroupTwoRank

/-!
# `Work.ShafarevichKoch.card_unramifiedQuadraticLevels_le_classGroupTwoRank`

**The sharp Kummer upper bound for the number of unramified quadratic levels.**

Every unramified quadratic extension `L i` of a number field `F` inside the maximal unramified
pro-`2` extension `F_∅ = M.K` is generated by the square root of a Kummer class
`a i ∈ V_∅ = VTwo F`, and the assignment `i ↦ vClass F (a i) ∈ Cl(F)[2]` is injective **provided**
no unit of `𝓞 F` which is a square in `F_∅` is a nonsquare of `F` (the hypothesis `hunits` below).
Hence the number of such levels is at most `# Cl(F)[2] = 2 ^ classGroupTwoRank F`.

The proof has three parts.

* *Square roots.*  `Work.ClassFieldTower.degreeTwo_sqrt_gen` writes each level
  `L i = F⟮b i⟯` for an element `b i ∈ L i` with `b i * b i = a i` for a unit `a i : Fˣ`.
* *Levels are determined by the square class of their generator.*  If `a i = a j * c ^ 2` then
  `b i = ± c * b j` in `M.K`, so `b i ∈ L j`, whence `L i = F⟮b i⟯ ≤ L j` and, both levels having
  `F`-dimension `2`, `L i = L j`, i.e. `i = j` by injectivity of `L`.
* *The descent is injective.*  If `vClass F (a i) = vClass F (a j)` then
  `a i * (a j)⁻¹ = u * y ^ 2` for a unit `u` of `𝓞 F` (`vClass_eq_one_iff`); the element
  `Z = b i / (y * b j)` of `M.K` satisfies `Z * Z = u`, so by `hunits` the unit `u` is a square
  of `F`, and `a i` and `a j` have the same square class, which by the previous point forces
  `i = j`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

theorem card_unramifiedQuadraticLevels_le_classGroupTwoRank (F : Type*) [Field F]
    [NumberField F] {ι : Type*} [Fintype ι]
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (L : ι → IntermediateField F M.K) (hNF : ∀ i, NumberField ↥(L i))
    (hfd : ∀ i, FiniteDimensional F (L i)) (hgal : ∀ i, IsGalois F (L i))
    (h2 : ∀ i, Module.finrank F (L i) = 2) (hinj : Function.Injective L)
    (hunits : ∀ (u : Work.ShafarevichKoch.RingUnit F) (z : M.K),
      z * z = algebraMap F M.K (Work.ShafarevichKoch.unitEmbed F u : F) →
      ∃ y : Fˣ, Work.ShafarevichKoch.unitEmbed F u = y ^ 2) :
    Fintype.card ι ≤ 2 ^ Work.ClassFieldTower.classGroupTwoRank F := by
  classical
  -- Step 1: each level is generated by a square root of a unit of `F`.
  choose a b hbmem hbsq hbgen using fun i =>
    Work.ClassFieldTower.degreeTwo_sqrt_gen (K := F) (L := M.K) (by norm_num) (L i) (h2 i)
  -- Step 2: unramifiedness forces the Kummer classes to lie in `V_∅`.
  have hmem : ∀ i, a i ∈ VTwo F := by
    intro i
    haveI : NumberField ↥(L i) := hNF i
    haveI : FiniteDimensional F ↥(L i) := hfd i
    haveI : IsGalois F ↥(L i) := hgal i
    refine mem_VTwo_of_unramified F ↥(L i) (a i) ⟨b i, hbmem i⟩ ?_
      (M.unramified (L i) (hfd i) (hgal i))
    apply Subtype.ext
    show b i * b i = algebraMap F M.K ((a i : Fˣ) : F)
    exact hbsq i
  let X : ι → VTwo F := fun i => ⟨a i, hmem i⟩
  -- Step 3: a level is determined by the square class of a Kummer generator.
  have hlevel : ∀ i j, (∃ c : Fˣ, a i = a j * c ^ 2) → i = j := by
    intro i j hc
    obtain ⟨c, hc⟩ := hc
    have hcF : ((a i : Fˣ) : F) = ((a j : Fˣ) : F) * ((c : Fˣ) : F) ^ 2 := by
      rw [hc, Units.val_mul, Units.val_pow_eq_pow_val]
    have hsq2 : b i * b i
        = (algebraMap F M.K ((c : Fˣ) : F) * b j)
          * (algebraMap F M.K ((c : Fˣ) : F) * b j) := by
      calc b i * b i = algebraMap F M.K ((a i : Fˣ) : F) := hbsq i
        _ = algebraMap F M.K (((a j : Fˣ) : F) * ((c : Fˣ) : F) ^ 2) := by rw [hcF]
        _ = algebraMap F M.K ((a j : Fˣ) : F) * (algebraMap F M.K ((c : Fˣ) : F)) ^ 2 := by
              rw [map_mul, map_pow]
        _ = (b j * b j) * (algebraMap F M.K ((c : Fˣ) : F)) ^ 2 := by rw [hbsq j]
        _ = (algebraMap F M.K ((c : Fˣ) : F) * b j)
              * (algebraMap F M.K ((c : Fˣ) : F) * b j) := by ring
    have hbijmem : b i ∈ L j := by
      rcases (mul_self_eq_mul_self_iff.mp hsq2) with h | h
      · rw [h]
        exact mul_mem (IntermediateField.algebraMap_mem (L j) ((c : Fˣ) : F)) (hbmem j)
      · rw [h]
        exact neg_mem (mul_mem (IntermediateField.algebraMap_mem (L j) ((c : Fˣ) : F)) (hbmem j))
    have hle : L i ≤ L j := by
      rw [← hbgen i]
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hbijmem
    haveI : FiniteDimensional F ↥(L j) := hfd j
    exact hinj (IntermediateField.eq_of_le_of_finrank_eq hle (by rw [h2 i, h2 j]))
  -- Step 4: the Kummer two-descent, as a homomorphism `V_∅ → Cl(F)`.
  have hvClass_one : vClass F (1 : VTwo F) = 1 := by
    have hcoe : (((1 : VTwo F)) : Fˣ) = 1 := rfl
    have h1 : (1 : IdealUnit F) * 1 = FracIdealOf F (((1 : VTwo F)) : Fˣ) := by
      rw [hcoe, FracIdealOf_one, mul_one]
    rw [vClass_eq_mk F (x := 1) (J := 1) h1]
    exact map_one (ClassGroup.mk F)
  let vC : VTwo F →* ClassGroup (𝓞 F) :=
    { toFun := fun x => vClass F x, map_one' := hvClass_one, map_mul' := vClass_mul F }
  let ci : ι → {c : ClassGroup (𝓞 F) // c ^ 2 = 1} :=
    fun i => ⟨vC (X i), vClass_sq_eq_one F (X i)⟩
  -- Step 5: `ci` is injective, because `hunits` trivialises the kernel of the descent.
  have hci_inj : Function.Injective ci := by
    intro i j hij
    have hvceq : vC (X i) = vC (X j) := congrArg Subtype.val hij
    have hW : vC (X i * (X j)⁻¹) = 1 := by
      rw [map_mul, MonoidHom.map_inv, hvceq, mul_inv_cancel]
    obtain ⟨u, y, hyu⟩ := (vClass_eq_one_iff F (X i * (X j)⁻¹)).mp hW
    have haij : a i * (a j)⁻¹ = unitEmbed F u * y ^ 2 := by
      simpa only [X, Subgroup.coe_mul, Subgroup.coe_inv, Subtype.coe_mk] using hyu
    have haijF : ((a i : Fˣ) : F) * (((a j : Fˣ) : F))⁻¹
        = ((unitEmbed F u : Fˣ) : F) * ((y : Fˣ) : F) ^ 2 := by
      have h := congrArg (fun w : Fˣ => (w : F)) haij
      simpa only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val] using h
    have hUF : ((a i : Fˣ) : F)
        = ((unitEmbed F u : Fˣ) : F) * (((y : Fˣ) : F) ^ 2 * ((a j : Fˣ) : F)) := by
      have h2 : ((a i : Fˣ) : F)
          = (((unitEmbed F u : Fˣ) : F) * ((y : Fˣ) : F) ^ 2) * ((a j : Fˣ) : F) := by
        rw [← haijF]
        rw [mul_assoc, inv_mul_cancel₀ (Units.ne_zero (a j)), mul_one]
      rw [h2]; ring
    have hy0 : algebraMap F M.K ((y : Fˣ) : F) ≠ 0 := by
      intro h
      have h' : ((y : Fˣ) : F) = 0 :=
        FaithfulSMul.algebraMap_injective F M.K (by rw [h, map_zero])
      exact Units.ne_zero y h'
    have hbj0 : b j ≠ 0 := by
      intro h0
      have h1 : algebraMap F M.K ((a j : Fˣ) : F) = algebraMap F M.K (0 : F) := by
        rw [map_zero, ← hbsq j, h0, mul_zero]
      exact Units.ne_zero (a j) (FaithfulSMul.algebraMap_injective F M.K h1)
    have hcy0 : algebraMap F M.K ((y : Fˣ) : F) * b j ≠ 0 := mul_ne_zero hy0 hbj0
    set Z : M.K := b i * (algebraMap F M.K ((y : Fˣ) : F) * b j)⁻¹ with hZdef
    have hstep : (algebraMap F M.K ((unitEmbed F u : Fˣ) : F))
          * (algebraMap F M.K ((y : Fˣ) : F) * b j)
          * (algebraMap F M.K ((y : Fˣ) : F) * b j) = b i * b i := by
      rw [hbsq i, hUF, map_mul, map_mul, map_pow, ← hbsq j]
      ring
    have hZsq : Z * Z
        = (b i * b i) * ((algebraMap F M.K ((y : Fˣ) : F) * b j)
            * (algebraMap F M.K ((y : Fˣ) : F) * b j))⁻¹ := by
      rw [hZdef,
        show b i * (algebraMap F M.K ((y : Fˣ) : F) * b j)⁻¹
            = b i / (algebraMap F M.K ((y : Fˣ) : F) * b j) from (div_eq_mul_inv _ _).symm]
      rw [div_mul_div_comm, div_eq_mul_inv]
    have hZ : Z * Z = algebraMap F M.K ((unitEmbed F u : Fˣ) : F) := by
      have hcc : ((algebraMap F M.K ((y : Fˣ) : F) * b j)
            * (algebraMap F M.K ((y : Fˣ) : F) * b j)) ≠ 0 := mul_ne_zero hcy0 hcy0
      have hbi : b i * b i = (algebraMap F M.K ((unitEmbed F u : Fˣ) : F))
            * ((algebraMap F M.K ((y : Fˣ) : F) * b j)
              * (algebraMap F M.K ((y : Fˣ) : F) * b j)) := by
        rw [← hstep]; ring
      rw [hZsq, hbi, mul_assoc, mul_inv_cancel₀ hcc, mul_one]
    obtain ⟨y', hy'⟩ := hunits u Z hZ
    have hai_eq : a i = a j * (y' * y) ^ 2 := by
      have h3 : a i = a j * (unitEmbed F u * y ^ 2) := by
        rw [← haij]
        rw [mul_comm (a j) (a i * (a j)⁻¹), mul_assoc, inv_mul_cancel, mul_one]
      rw [hy'] at h3
      rw [mul_pow]
      exact h3
    exact hlevel i j ⟨y' * y, hai_eq⟩
  -- Step 6: count.
  have hcardCl : Nat.card {c : ClassGroup (𝓞 F) // c ^ 2 = 1}
      = 2 ^ Work.ClassFieldTower.classGroupTwoRank F :=
    (Work.ClassFieldTower.card_quotient_squareSubgroup_eq_card_twoTorsion
      (ClassGroup (𝓞 F))).symm.trans
        (Work.ClassFieldTower.two_pow_classGroupTwoRank F).symm
  calc Fintype.card ι = Nat.card ι := (Nat.card_eq_fintype_card).symm
    _ ≤ Nat.card {c : ClassGroup (𝓞 F) // c ^ 2 = 1} :=
        Nat.card_le_card_of_injective ci hci_inj
    _ = 2 ^ Work.ClassFieldTower.classGroupTwoRank F := hcardCl

end Work.ShafarevichKoch
