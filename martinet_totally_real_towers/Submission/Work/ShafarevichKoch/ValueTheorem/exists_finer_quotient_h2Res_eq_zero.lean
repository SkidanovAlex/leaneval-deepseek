import Mathlib
import Submission.Work.HopfGaschutz.Setup
import Submission.Work.HopfGaschutz.h2_freeGroup_subsingleton
import Submission.Work.ConCohomology.Functoriality
import Submission.Work.ShaBoundProcyclic.ExtensionCocycle
import Submission.Work.ShafarevichKoch.ZModTwoTrivialAction

/-!
# `Work.ShafarevichKoch.ValueTheorem.exists_finer_quotient_h2Res_eq_zero`

Every class of `H²(Q,𝔽₂)` of a finite `2`-group `Q` dies on a *finer* quotient with the same
generator number: for `Q` a finite `2`-group, `gen : Fin d → Q` a generating family and `z` a
`2`-cocycle on `Q` (trivial `𝔽₂`-coefficients), there is a finite `2`-group `Q'`, a surjection
`q : Q' →* Q` compatible with a generating family `gen' : Fin d → Q'`, and
`H2Res q (H2.mk z) = 0` in `H²(Q',𝔽₂)`.

## The construction

`z` is a factor system on `Q`, so `𝔽₂ × Q` carries the twisted product group
`(a,x)(b,y) = (a + b + z (x,y), xy)` (`Work.ShaBoundProcyclic.twistMul`, packaged as
`Work.ShafarevichKoch.ValueTheorem.Twist`).  Lift the presentation of `Q` by `gen` to the lifted
generators `f i = (0, gen i)`:

* `ρ := FreeGroup.lift f : F →* Ĝ`, `H := ρ.range ⊆ Ĝ` -- the finer quotient, *inside* `Ĝ`;
* `N := ρ.ker ◁ F` -- its relations, and `Q' := F ⧸ N` -- the finer quotient as a *small* type
  (`F = FreeGroup (Fin d)` lives in `Type 0`, and so does the quotient; the subgroup `↥H ⊆ Ĝ` does
  not, which is why the quotient is the carrier);
* `q : Q' →* Q` is `φ = FreeGroup.lift gen` descended to `F ⧸ N` (possible because `N ≤ ker φ`,
  as the second coordinate of `ρ` is `φ`).

The canonical isomorphism `Q' ≃* ↥H` (`ρbar.codRestrict`, bijective) transports the two facts
proved inside the twisted product:

* `gen' i := mk' N (of i)` generates `Q'` (`F` is generated by `of`), `q` is surjective and
  compatible with the free-group lifts;
* the first coordinate `b (x) := -x.fst` is a `1`-cochain on `↥H` with
  `d¹b (p, p') = -p'.1 - (-(p.1 + p'.1 + z (p.2, p'.2))) - p.1 = z (p.2, p'.2)`,
  i.e. `d¹b = Z2Res qh z`; transported along `Q' ≃* ↥H` it gives `Z2Res q z ∈ B²(Q')`, so
  `H2Res q (H2.mk z) = H2.mk (Z2Res q z) = 0`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000
set_option linter.unusedVariables false

namespace Work.ShafarevichKoch.ValueTheorem

open Work.ConCohomology

/-- The carrier of the twisted product `𝔽₂ × Q` attached to a `2`-cocycle `z` on `Q`. -/
structure Twist (Q : Type*) [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    (z : Work.ConCohomology.Z2 Q (ZMod 2)) where
  /-- the `𝔽₂`-coordinate -/
  fst : ZMod 2
  /-- the `Q`-coordinate -/
  snd : Q

namespace Twist

variable {Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]

/-- The cocycle, as a plain function `Q × Q → 𝔽₂`. -/
def cyc (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Q × Q → ZMod 2 :=
  (↑z : Work.ConCohomology.Cochain2 Q (ZMod 2))

/-- The cocycle condition, extracted from the subtype. -/
theorem isCocycle_cyc (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    Work.ConCohomology.IsCocycle2 (cyc z) :=
  Work.ConCohomology.mem_Z2.mp z.2

instance instMul (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Mul (Twist Q z) :=
  ⟨fun p q => ⟨p.fst + p.snd • q.fst + cyc z (p.snd, q.snd), p.snd * q.snd⟩⟩

instance instOne (z : Work.ConCohomology.Z2 Q (ZMod 2)) : One (Twist Q z) := ⟨⟨-cyc z (1, 1), 1⟩⟩

instance instInv (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Inv (Twist Q z) :=
  ⟨fun p => ⟨p.snd⁻¹ • (-cyc z (1, 1) - p.fst - cyc z (p.snd, p.snd⁻¹)), p.snd⁻¹⟩⟩

@[ext]
theorem ext {z : Work.ConCohomology.Z2 Q (ZMod 2)} {p q : Twist Q z} (h1 : p.fst = q.fst)
    (h2 : p.snd = q.snd) : p = q := by cases p; cases q; simp_all

theorem mul_assoc (z : Work.ConCohomology.Z2 Q (ZMod 2)) (p q r : Twist Q z) :
    p * q * r = p * (q * r) := by
  apply Twist.ext
  · exact congrArg Prod.fst (Work.ShaBoundProcyclic.twistMul_assoc (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd) (q.fst, q.snd) (r.fst, r.snd))
  · exact congrArg Prod.snd (Work.ShaBoundProcyclic.twistMul_assoc (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd) (q.fst, q.snd) (r.fst, r.snd))

theorem one_mul (z : Work.ConCohomology.Z2 Q (ZMod 2)) (p : Twist Q z) : 1 * p = p := by
  apply Twist.ext
  · exact congrArg Prod.fst (Work.ShaBoundProcyclic.twistOne_mul (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd))
  · exact congrArg Prod.snd (Work.ShaBoundProcyclic.twistOne_mul (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd))

theorem inv_mul (z : Work.ConCohomology.Z2 Q (ZMod 2)) (p : Twist Q z) : p⁻¹ * p = 1 := by
  apply Twist.ext
  · exact congrArg Prod.fst (Work.ShaBoundProcyclic.twistInv_mul (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd))
  · exact congrArg Prod.snd (Work.ShaBoundProcyclic.twistInv_mul (cyc z)
      (isCocycle_cyc z) (p.fst, p.snd))

instance instGroup (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Group (Twist Q z) :=
  Group.ofLeftAxioms (mul_assoc z) (one_mul z) (inv_mul z)

/-- The underlying pair of an element of the twisted product. -/
def equivProd (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Twist Q z ≃ ZMod 2 × Q where
  toFun p := (p.fst, p.snd)
  invFun p := ⟨p.1, p.2⟩
  left_inv p := by cases p; rfl
  right_inv p := by cases p; rfl

instance instFintype (z : Work.ConCohomology.Z2 Q (ZMod 2)) [Fintype Q] : Fintype (Twist Q z) :=
  Fintype.ofEquiv (ZMod 2 × Q) (equivProd z).symm

theorem natCard (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    Nat.card (Twist Q z) = 2 * Nat.card Q := by
  rw [Nat.card_congr (equivProd z), Nat.card_prod, Nat.card_zmod]

theorem isPGroup (z : Work.ConCohomology.Z2 Q (ZMod 2)) [Fintype Q] (hQ : IsPGroup 2 Q) :
    IsPGroup 2 (Twist Q z) := by
  rw [IsPGroup.iff_card]
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2) (G := Q)).mp hQ
  exact ⟨k + 1, by rw [natCard, hk, pow_succ']⟩

instance instTopologicalSpace (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    TopologicalSpace (Twist Q z) := ⊥

instance instDiscreteTopology (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    DiscreteTopology (Twist Q z) := ⟨rfl⟩

instance instIsTopologicalGroup (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    IsTopologicalGroup (Twist Q z) := inferInstance

/-- The second-coordinate projection `Ĝ →* Q`, the projection of the extension. -/
def sndHom (z : Work.ConCohomology.Z2 Q (ZMod 2)) : Twist Q z →* Q where
  toFun p := p.snd
  map_one' := rfl
  map_mul' _ _ := rfl

@[simp] theorem sndHom_apply (z : Work.ConCohomology.Z2 Q (ZMod 2)) (p : Twist Q z) :
    sndHom z p = p.snd := rfl

end Twist

theorem exists_finer_quotient_h2Res_eq_zero {d : ℕ} {Q : Type*} [Group Q] [TopologicalSpace Q]
    [DiscreteTopology Q] [IsTopologicalGroup Q] [Fintype Q] (hQ : IsPGroup 2 Q)
    (gen : Fin d → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (z : Work.ConCohomology.Z2 Q (ZMod 2)) :
    ∃ (Q' : Type) (_ : Group Q') (_ : TopologicalSpace Q') (_ : DiscreteTopology Q')
      (_ : IsTopologicalGroup Q') (_ : Fintype Q') (_ : IsPGroup 2 Q') (q : Q' →* Q)
      (gen' : Fin d → Q'),
      Function.Surjective q ∧ Subgroup.closure (Set.range gen') = ⊤ ∧
      q.comp (FreeGroup.lift gen') = FreeGroup.lift gen ∧
      Work.ConCohomology.H2Res q (continuous_of_discreteTopology) (fun _ _ => rfl)
        (Work.ConCohomology.H2.mk z) = 0 := by
  classical
  -- the presentation map of `Q`
  let φ : FreeGroup (Fin d) →* Q := FreeGroup.lift gen
  -- the lifts of the generators in the twisted product
  let f : Fin d → Twist Q z := fun i => ⟨0, gen i⟩
  -- the lifted presentation map, its range (the finer quotient inside the twisted product) and
  -- its kernel (the relations of the finer quotient)
  let ρ : FreeGroup (Fin d) →* Twist Q z := FreeGroup.lift f
  let H : Subgroup (Twist Q z) := ρ.range
  let N : Subgroup (FreeGroup (Fin d)) := ρ.ker
  -- the projection of the extension
  let σ : Twist Q z →* Q := Twist.sndHom z
  -- the second coordinate of the lifted presentation is the presentation of `Q`
  have hσρ : σ.comp ρ = φ := by
    refine MonoidHom.ext (fun w => FreeGroup.lift_unique (f := gen) (g := σ.comp ρ) ?_ (x := w))
    intro i
    show (ρ (FreeGroup.of i)).snd = gen i
    rw [FreeGroup.lift_apply_of]
  -- the relations of the finer quotient lie in the kernel of the presentation
  have hNker : N ≤ φ.ker := by
    intro w hw
    have h1 : ρ w = 1 := by simpa [N] using hw
    have h2 : φ w = σ (ρ w) := by rw [← MonoidHom.comp_apply, hσρ]
    rw [MonoidHom.mem_ker, h2, h1]
    exact map_one σ
  -- the finer quotient: the free group modulo the relations of the lifted presentation
  let Q' : Type := FreeGroup (Fin d) ⧸ N
  -- the projection of the finer quotient onto `Q`
  let q : Q' →* Q := QuotientGroup.lift N φ hNker
  -- the lifted generating family
  let gen' : Fin d → Q' := fun i => QuotientGroup.mk' N (FreeGroup.of i)
  have hqmk_hom : q.comp (QuotientGroup.mk' N) = φ := QuotientGroup.lift_comp_mk' N φ hNker
  have hqmk : ∀ w : FreeGroup (Fin d), q (QuotientGroup.mk' N w) = φ w := fun w =>
    DFunLike.congr_fun hqmk_hom w
  have hqgen : ∀ i : Fin d, q (gen' i) = gen i := by
    intro i
    rw [hqmk (FreeGroup.of i), FreeGroup.lift_apply_of]
  have hqcomp : q.comp (FreeGroup.lift gen') = FreeGroup.lift gen := by
    refine MonoidHom.ext (fun w =>
      FreeGroup.lift_unique (f := gen) (g := q.comp (FreeGroup.lift gen')) ?_ (x := w))
    intro i
    show q (FreeGroup.lift gen' (FreeGroup.of i)) = gen i
    rw [FreeGroup.lift_apply_of]
    exact hqgen i
  have hgen' : Subgroup.closure (Set.range gen') = ⊤ := by
    have hrange : Set.range gen' =
        (QuotientGroup.mk' N) '' (Set.range (FreeGroup.of : Fin d → FreeGroup (Fin d))) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨FreeGroup.of i, ⟨i, rfl⟩, rfl⟩
      · rintro ⟨w, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, rfl⟩
    rw [hrange, ← MonoidHom.map_closure (QuotientGroup.mk' N), FreeGroup.closure_range_of,
      Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)]
  have hqsurj : Function.Surjective q := by
    rw [← MonoidHom.range_eq_top]
    have hle : Subgroup.closure (Set.range gen) ≤ q.range :=
      (Subgroup.closure_le _).mpr (by rintro y ⟨i, rfl⟩; exact ⟨gen' i, hqgen i⟩)
    rw [hgen] at hle
    exact top_le_iff.mp hle
  -- the canonical identification of the finer quotient with the range of the lifted presentation
  let ρbar : Q' →* Twist Q z := QuotientGroup.lift N ρ (le_refl N)
  have hρbarmk_hom : ρbar.comp (QuotientGroup.mk' N) = ρ :=
    QuotientGroup.lift_comp_mk' N ρ (le_refl N)
  have hρbarmk : ∀ w : FreeGroup (Fin d), ρbar (QuotientGroup.mk' N w) = ρ w := fun w =>
    DFunLike.congr_fun hρbarmk_hom w
  have hψmem : ∀ x : Q', ρbar x ∈ H := by
    intro x
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective N x
    exact ⟨w, (hρbarmk w).symm⟩
  let ψ : Q' →* ↥H := ρbar.codRestrict H hψmem
  have hψsurj : Function.Surjective ψ := by
    intro h
    obtain ⟨w, hw⟩ := h.2
    refine ⟨QuotientGroup.mk' N w, Subtype.ext ?_⟩
    show ρbar (QuotientGroup.mk' N w) = (h : Twist Q z)
    rw [hρbarmk w]
    exact hw
  have hψinj : Function.Injective ψ := by
    intro a b hab
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective N a
    obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective N b
    have h1 : ρ w = ρ v := by
      have h2 : (ψ (QuotientGroup.mk' N w) : Twist Q z)
          = (ψ (QuotientGroup.mk' N v) : Twist Q z) := congrArg Subtype.val hab
      rw [show (ψ (QuotientGroup.mk' N w) : Twist Q z) = ρbar (QuotientGroup.mk' N w) from rfl,
        show (ψ (QuotientGroup.mk' N v) : Twist Q z) = ρbar (QuotientGroup.mk' N v) from rfl,
        hρbarmk w, hρbarmk v] at h2
      exact h2
    have h3 : ρ (w⁻¹ * v) = 1 := by rw [map_mul, map_inv, h1, inv_mul_cancel]
    have h4 : QuotientGroup.mk' N (w⁻¹ * v) = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff (w⁻¹ * v)).mpr (by simpa [N] using h3)
    have h5 : (QuotientGroup.mk' N w)⁻¹ * QuotientGroup.mk' N v = 1 := by
      rw [← map_inv, ← map_mul]
      exact h4
    exact inv_mul_eq_one.mp h5
  let ψe : Q' ≃* ↥H := MulEquiv.ofBijective ψ ⟨hψinj, hψsurj⟩
  -- the instances on the finer quotient
  letI : TopologicalSpace Q' := ⊥
  haveI hdiscQ' : DiscreteTopology Q' := ⟨rfl⟩
  haveI htgQ' : IsTopologicalGroup Q' := inferInstance
  haveI hfinQ' : Fintype Q' := Fintype.ofEquiv ↥H ψe.symm.toEquiv
  haveI hpgH : IsPGroup 2 ↥H := (Twist.isPGroup z hQ).to_subgroup H
  haveI hpgQ' : IsPGroup 2 Q' := hpgH.of_equiv ψe.symm
  -- the coboundary on `↥H` killing the pullback of `z`
  let qh : ↥H →* Q := σ.comp (Subgroup.subtype H)
  let b : Work.ConCohomology.Cochain1 ↥H (ZMod 2) :=
    ⟨fun p => -((p : Twist Q z).fst), IsLocallyConstant.of_discrete _⟩
  have hb : Work.ConCohomology.d1Hom ↥H (ZMod 2) b
      = Work.ConCohomology.Z2Res qh (continuous_of_discreteTopology) (fun _ _ => rfl) z := by
    refine LocallyConstant.ext (fun p => ?_)
    obtain ⟨p1, p2⟩ := p
    rw [Work.ConCohomology.d1Hom_apply, Work.ConCohomology.Z2Res_coe,
      Work.ConCohomology.cochain2Res_apply]
    show p1 • (-((p2 : Twist Q z).fst))
        - (-(((p1 : Twist Q z) * (p2 : Twist Q z)).fst)) + (-((p1 : Twist Q z).fst))
      = Twist.cyc z ((p1 : Twist Q z).snd, (p2 : Twist Q z).snd)
    have hmul : ((p1 : Twist Q z) * (p2 : Twist Q z)).fst
        = (p1 : Twist Q z).fst + (p2 : Twist Q z).fst
          + Twist.cyc z ((p1 : Twist Q z).snd, (p2 : Twist Q z).snd) := rfl
    rw [hmul, Work.ShafarevichKoch.smul_zmodTwo_eq]
    abel
  -- the same coboundary, transported to the finer quotient
  let a : Work.ConCohomology.Cochain1 Q' (ZMod 2) :=
    ⟨fun p => b (ψe p), IsLocallyConstant.of_discrete _⟩
  have hqψ : ∀ p : Q', q p = qh (ψe p) := by
    intro p
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective N p
    rw [hqmk w]
    show φ w = σ (ρ w)
    rw [← MonoidHom.comp_apply, hσρ]
  have ha : Work.ConCohomology.d1Hom Q' (ZMod 2) a
      = Work.ConCohomology.Z2Res q (continuous_of_discreteTopology) (fun _ _ => rfl) z := by
    refine LocallyConstant.ext (fun p => ?_)
    obtain ⟨p1, p2⟩ := p
    rw [Work.ConCohomology.d1Hom_apply, Work.ConCohomology.Z2Res_coe,
      Work.ConCohomology.cochain2Res_apply]
    have h1 : p1 • a p2 - a (p1 * p2) + a p1
        = b (ψe p2) - b (ψe p1 * ψe p2) + b (ψe p1) := by
      rw [Work.ShafarevichKoch.smul_zmodTwo_eq]
      rw [show a (p1 * p2) = b (ψe (p1 * p2)) from rfl, map_mul]
      rfl
    have h2 : Twist.cyc z (q p1, q p2) = b (ψe p2) - b (ψe p1 * ψe p2) + b (ψe p1) := by
      rw [hqψ p1, hqψ p2]
      rw [show Twist.cyc z (qh (ψe p1), qh (ψe p2))
          = (Work.ConCohomology.Z2Res qh (continuous_of_discreteTopology)
              (fun _ _ => rfl) z : Work.ConCohomology.Cochain2 ↥H (ZMod 2))
              (ψe p1, ψe p2) from by
        rw [Work.ConCohomology.Z2Res_coe, Work.ConCohomology.cochain2Res_apply]
        rfl]
      rw [← hb, Work.ConCohomology.d1Hom_apply, Work.ShafarevichKoch.smul_zmodTwo_eq]
    rw [h1, ← h2]
    rfl
  -- the pullback of `z` to the finer quotient is a coboundary, so its class vanishes
  have hmem : (Work.ConCohomology.Z2Res q (continuous_of_discreteTopology) (fun _ _ => rfl) z :
      Work.ConCohomology.Z2 Q' (ZMod 2)) ∈ Work.ConCohomology.B2' Q' (ZMod 2) :=
    Work.ConCohomology.mem_B2'.mpr (Work.ConCohomology.mem_B2.mpr ⟨a, ha⟩)
  have hlast : Work.ConCohomology.H2Res q (continuous_of_discreteTopology) (fun _ _ => rfl)
      (Work.ConCohomology.H2.mk z) = 0 := by
    rw [Work.ConCohomology.H2Res_mk, Work.ConCohomology.H2.mk_eq_zero_iff]
    exact hmem
  exact ⟨Q', inferInstance, ⊥, hdiscQ', htgQ', hfinQ', hpgQ', q, gen', hqsurj, hgen', hqcomp,
    hlast⟩

end Work.ShafarevichKoch.ValueTheorem
