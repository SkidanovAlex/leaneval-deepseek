import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.normalClosure_eq_sup_commutator
import Submission.Work.HopfGaschutz.relFrattiniDim_le_card_of_normalGenerates

/-!
# `|K ⧸ K²[K,F]| ≤ 2 ^ |S|` from generation modulo `K²[K,F]`

**Module** `Submission.Work.ShafarevichKoch.card_relFrattiniQuotient_le_of_le_normalClosure_sup`.

Let `K ⊴ F` be a normal subgroup and `S ⊆ K` a finite set of elements of `K` which generates `K`
*modulo the relation-Frattini subgroup* `K²[K,F]`, i.e.

  `K ≤ Subgroup.normalClosure S ⊔ relFrattini 2 K`.

Then the relation-Frattini quotient `K ⧸ K²[K,F]` is an elementary abelian `2`-group generated by
the images of the (at most `|S|`) elements of `S`, hence has at most `2 ^ |S|` elements:

  `Nat.card (K ⧸ relFrattiniIn 2 K) ≤ 2 ^ S.card`.

This is the counting step of the Shafarevich--Koch / Hopf--Gaschutz dictionary: it bounds the
relation rank of a presentation of `F ⧸ K` on `|S|` relators, and it is precisely
`relFrattiniDim_le_card_of_normalGenerates` with the hypothesis weakened from "`S` normally
generates `K`" to "`S` generates `K` modulo `K²[K,F]`" -- the form in which the classical
closed/pro-`2` relation count is delivered.

## The proof

`K²[K,F]` contains both `[K,F]` and the squares of `K`, so the quotient `Q := K ⧸ K²[K,F]` is an
abelian group of exponent dividing `2`.  Since `S ⊆ K` and `K` is normal,

  `Subgroup.normalClosure S = Subgroup.closure S ⊔ ⁅Subgroup.closure S, ⊤⁆`

(`Work.HopfGaschutz.normalClosure_eq_sup_commutator`), and `⁅closure S, ⊤⁆ ≤ ⁅K, ⊤⁆ ≤ K²[K,F]`, so the
hypothesis descends to `K ≤ Subgroup.closure S ⊔ relFrattini 2 K`: `Q` is generated by the images of
`S`.  Counting in the abelianization of `Q` (which is `Q` itself, `Q` being commutative) with the
`ZMod 2`-module lemma `Work.HopfGaschutz.natCard_le_pow_card_of_closure_eq_top` gives
`|Q| ≤ 2 ^ #(image of S) ≤ 2 ^ |S|`.

The general `p` form (hypothesis `K ≤ Subgroup.closure S ⊔ relFrattini p K` for `1 < p`) is proved
first, as `natCard_relFrattiniQuotient_le_pow_card_of_le_closure_sup`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.ShafarevichKoch

open scoped commutatorElement
open Work.HopfGaschutz

variable {F : Type*} [Group F]

/-! ## The general `p` form -/

/-- **Cardinality of the relation-Frattini quotient.**  If the normal subgroup `K ⊴ F` is generated
by the finite set `S ⊆ K` modulo the relation-Frattini subgroup `K^p [K,F]` (i.e.
`K ≤ ⟨S⟩ ⊔ K^p[K,F]`), then the quotient `K ⧸ K^p[K,F]` -- an abelian group of exponent dividing
`p`, generated by the images of `S` -- has at most `p ^ #S` elements. -/
theorem natCard_relFrattiniQuotient_le_pow_card_of_le_closure_sup (K : Subgroup F) [K.Normal]
    (S : Finset F) (p : ℕ) (hp : 1 < p) (hS : (S : Set F) ⊆ K)
    (h : K ≤ Subgroup.closure (S : Set F) ⊔ relFrattini p K) :
    Nat.card (K ⧸ relFrattiniIn p K) ≤ p ^ S.card := by
  classical
  have hp1' : 1 < p := hp
  have hsub : (S : Set F) ⊆ K := hS
  -- the lifts of `S` into `K`, and their images in the relation-Frattini quotient
  set T : Finset K := S.attach.image (fun s => (⟨s.1, hsub s.2⟩ : K)) with hT
  set TQ : Finset (K ⧸ relFrattiniIn p K) :=
    T.image (QuotientGroup.mk' (relFrattiniIn p K)) with hTQ
  have hmemT : ∀ (s : F) (hs : s ∈ S), (⟨s, hsub hs⟩ : K) ∈ T := by
    intro s hs
    rw [hT]
    refine Finset.mem_image.mpr ⟨⟨s, hs⟩, Finset.mem_attach _ _, ?_⟩
    exact Subtype.ext rfl
  -- the quotient is abelian and has exponent `p`
  have hcomm : ∀ x y : K ⧸ relFrattiniIn p K, x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) y
    rw [← commutatorElement_eq_one_iff_mul_comm]
    rw [← map_commutatorElement (QuotientGroup.mk' (relFrattiniIn p K)) a b]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ relFrattini p K
    rw [map_commutatorElement (Subgroup.subtype K) a b]
    exact commutator_mem_relFrattini p K a.2
  have hexp : ∀ x : K ⧸ relFrattiniIn p K, x ^ p = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (a ^ p) ∈ relFrattini p K
    rw [map_pow]
    exact pow_mem_relFrattini p K a.2
  -- the quotient is generated by the images of `S`
  have hgen : Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K)) = ⊤ := by
    let L : Subgroup (K ⧸ relFrattiniIn p K) :=
      Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K))
    -- `M` is the preimage of `L` in `K`
    let M : Subgroup K := Subgroup.comap (QuotientGroup.mk' (relFrattiniIn p K)) L
    have hHle : Subgroup.closure (S : Set F) ≤ Subgroup.map (Subgroup.subtype K) M := by
      apply (Subgroup.closure_le _).mpr
      intro s hs
      refine Subgroup.mem_map.mpr ⟨⟨s, hsub hs⟩, ?_, rfl⟩
      rw [Subgroup.mem_comap]
      exact Subgroup.subset_closure
        (Finset.mem_image.mpr ⟨⟨s, hsub hs⟩, hmemT s hs, rfl⟩)
    have hRle : relFrattini p K ≤ Subgroup.map (Subgroup.subtype K) M := by
      intro x hx
      refine Subgroup.mem_map.mpr ⟨⟨x, relFrattini_le p K hx⟩, ?_, rfl⟩
      rw [Subgroup.mem_comap]
      have h1 : (QuotientGroup.mk' (relFrattiniIn p K))
          (⟨x, relFrattini_le p K hx⟩ : K) = 1 :=
        (QuotientGroup.eq_one_iff _).mpr hx
      rw [h1]
      exact Subgroup.one_mem L
    have hKle : K ≤ Subgroup.map (Subgroup.subtype K) M :=
      h.trans (sup_le hHle hRle)
    have hLtop : L = ⊤ := by
      rw [← top_le_iff]
      intro x _
      obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
      have ha : (a : F) ∈ Subgroup.map (Subgroup.subtype K) M := hKle a.2
      obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp ha
      have hπm : (QuotientGroup.mk' (relFrattiniIn p K)) m =
          (QuotientGroup.mk' (relFrattiniIn p K)) a :=
        congrArg (QuotientGroup.mk' (relFrattiniIn p K)) (Subtype.ext hmx)
      rw [← hπm]
      exact Subgroup.mem_comap.mp hm
    exact hLtop
  -- ## the cardinality bound: count in the abelianization of `Q`
  have hsurjA : Function.Surjective (Abelianization.of (G := K ⧸ relFrattiniIn p K)) := fun x =>
    QuotientGroup.mk'_surjective (commutator (K ⧸ relFrattiniIn p K)) x
  have hcardA : Nat.card (K ⧸ relFrattiniIn p K)
      = Nat.card (Abelianization (K ⧸ relFrattiniIn p K)) := by
    have hker : (Abelianization.of (G := K ⧸ relFrattiniIn p K)).ker = ⊥ := by
      rw [Abelianization.ker_of, (commutator_eq_bot_iff (K ⧸ relFrattiniIn p K)).mpr ⟨⟨hcomm⟩⟩]
    have hinj : Function.Injective (Abelianization.of (G := K ⧸ relFrattiniIn p K)) :=
      (MonoidHom.ker_eq_bot_iff _).mp hker
    exact Nat.card_congr (MulEquiv.ofBijective _ ⟨hinj, hsurjA⟩).toEquiv
  set TA : Finset (Abelianization (K ⧸ relFrattiniIn p K)) :=
    TQ.image (Abelianization.of) with hTA
  have hgenA : Subgroup.closure (TA : Set (Abelianization (K ⧸ relFrattiniIn p K))) = ⊤ := by
    rw [hTA]
    have hmap : Subgroup.map (Abelianization.of (G := K ⧸ relFrattiniIn p K))
          (Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K))) =
        Subgroup.closure
          ((TQ.image (Abelianization.of) : Finset (Abelianization (K ⧸ relFrattiniIn p K))) :
            Set (Abelianization (K ⧸ relFrattiniIn p K))) := by
      refine le_antisymm ?_ ?_
      · rw [Subgroup.map_le_iff_le_comap]
        refine (Subgroup.closure_le _).mpr fun y hy => ?_
        exact Subgroup.mem_comap.mpr
          (Subgroup.subset_closure (Finset.mem_image.mpr ⟨y, hy, rfl⟩))
      · apply (Subgroup.closure_le _).mpr
        intro y hy
        obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
        exact Subgroup.mem_map_of_mem _ (Subgroup.subset_closure hx)
    rw [← hmap, hgen, Subgroup.map_top_of_surjective _ hsurjA]
  have hexpA : ∀ x : Abelianization (K ⧸ relFrattiniIn p K), x ^ p = 1 := by
    intro x
    obtain ⟨y, rfl⟩ := hsurjA x
    rw [← map_pow, hexp y, map_one]
  have hboundA : Nat.card (Abelianization (K ⧸ relFrattiniIn p K)) ≤ p ^ TA.card :=
    natCard_le_pow_card_of_closure_eq_top p (by omega) hexpA hgenA
  have hbound : Nat.card (K ⧸ relFrattiniIn p K) ≤ p ^ TQ.card := by
    rw [hcardA]
    refine le_trans hboundA (Nat.pow_le_pow_right (le_of_lt hp1') ?_)
    rw [hTA]
    exact Finset.card_image_le
  have hTQS : TQ.card ≤ S.card := by
    calc TQ.card = (T.image (QuotientGroup.mk' (relFrattiniIn p K))).card := by rw [hTQ]
      _ ≤ T.card := Finset.card_image_le
      _ = (S.attach.image (fun s => (⟨s.1, hsub s.2⟩ : K))).card := by rw [hT]
      _ ≤ S.attach.card := Finset.card_image_le
      _ = S.card := Finset.card_attach
  calc Nat.card (K ⧸ relFrattiniIn p K) ≤ p ^ TQ.card := hbound
    _ ≤ p ^ S.card := Nat.pow_le_pow_right (le_of_lt hp1') hTQS

/-! ## The requested statement -/

/-- **`|K ⧸ K²[K,F]| ≤ 2 ^ |S|` when `S` generates `K` modulo `K²[K,F]`.**  This is the counting
step which bounds the number of relators of a presentation of `F ⧸ K` on `|S|` generators. -/
theorem card_relFrattiniQuotient_le_of_le_normalClosure_sup
    {F : Type*} [Group F] (K : Subgroup F) [K.Normal] (S : Finset F)
    (hS : (S : Set F) ⊆ K)
    (h : K ≤ Subgroup.normalClosure (S : Set F) ⊔ Work.HopfGaschutz.relFrattini 2 K) :
    Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ≤ 2 ^ S.card := by
  -- `⁅⟨S⟩, ⊤⁆ ≤ ⁅K, ⊤⁆ ≤ K²[K,F]`, so the normal closure in the hypothesis may be replaced by the
  -- plain closure.
  have hcomm_le : ⁅Subgroup.closure (S : Set F), (⊤ : Subgroup F)⁆ ≤
      Work.HopfGaschutz.relFrattini 2 K := by
    refine le_trans (Subgroup.commutator_mono ((Subgroup.closure_le K).mpr hS) le_rfl) ?_
    rw [relFrattini]
    exact le_sup_right
  have hdecomp : K ≤ Subgroup.closure (S : Set F) ⊔ Work.HopfGaschutz.relFrattini 2 K := by
    refine h.trans ?_
    rw [normalClosure_eq_sup_commutator (S : Set F)]
    exact sup_le (sup_le le_sup_left (le_trans hcomm_le le_sup_right)) le_sup_right
  exact natCard_relFrattiniQuotient_le_pow_card_of_le_closure_sup K S 2 (by norm_num) hS hdecomp

end Work.ShafarevichKoch
