import Mathlib
import Submission.Work.ShafarevichKoch.Defs

/-!
# `Work.ShafarevichKoch.exists_integral_mul_square`

**Every class in `Fˣ / (Fˣ)²` has an integral representative.**

For a number field `F` and a unit `x : Fˣ` there are a nonzero integral element
`x' : 𝓞 F` and a unit `y : Fˣ` with `x' = x * y ^ 2` (all equalities in `F`).

Equivalently: the natural map `𝓞 F → F` induces a surjection
`(𝓞 F \ {0}) / (𝓞 F)ˣ² ↠ Fˣ/(Fˣ)²`; i.e. `Fˣ/(Fˣ)²` is generated by
integral elements.  This is what lets every element of Koch's group `V_∅`
(`Work.ShafarevichKoch.VTwo`) be *written down* by an honest element of `𝓞 F`
rather than as a fraction.

The proof is the obvious one: write `x = a / b` as a fraction *with denominator a
nonzerodivisor* of `𝓞 F` (`IsLocalization.surj`, valid because `F` is the
fraction field of `𝓞 F`), and clear denominators by multiplying by `b²`.
-/

open scoped NumberField

namespace Work.ShafarevichKoch

theorem exists_integral_mul_square (F : Type*) [Field F] [NumberField F] (x : Fˣ) :
    ∃ (x' : NumberField.RingOfIntegers F) (_ : x' ≠ 0) (y : Fˣ),
      ((x' : NumberField.RingOfIntegers F) : F) = (x : F) * (y : F) ^ 2 := by
  -- write `x = a / b` with `a : 𝓞 F` and `b` a nonzero element of `𝓞 F`
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors (𝓞 F)) (x : F)
  have hb : (b : 𝓞 F) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp b.2
  have hbF : (algebraMap (𝓞 F) F) (b : 𝓞 F) ≠ 0 :=
    fun h => hb ((IsFractionRing.to_map_eq_zero_iff).mp h)
  -- hence the numerator `a = x * b` is nonzero
  have ha : a ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hab
    exact mul_ne_zero (Units.ne_zero x) hbF hab
  -- clear denominators
  refine ⟨a * b, mul_ne_zero ha hb, Units.mk0 ((algebraMap (𝓞 F) F) (b : 𝓞 F)) hbF, ?_⟩
  rw [Units.val_mk0]
  show (algebraMap (𝓞 F) F) (a * b) = (x : F) * ((algebraMap (𝓞 F) F) (b : 𝓞 F)) ^ 2
  rw [map_mul, pow_two, ← mul_assoc, hab]

end Work.ShafarevichKoch
