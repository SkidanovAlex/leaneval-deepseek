import Mathlib
import Submission.Work.ShafarevichKoch.GenusConj

namespace Work.ShafarevichKoch

open Work.ClassFieldTower
open scoped NumberField

/-- `𝓞 Kc = ℤ[√-30030]`, `scR = √-30030`, and `d ∣ 30030` (so `d` is squarefree).  Then
`⟨d, scR⟩² = (d)`: the square of the ideal generated by `d` and `√-30030` is the principal ideal
generated by `d`.  Hints: `⟨d, scR⟩² = ⟨d², d·scR, scR²⟩ = ⟨d², d·scR, -30030⟩`.  The inclusion
into `(d)` uses `d ∣ 30030`; the reverse inclusion uses `gcd(d², 30030) = d`, which follows from
`gcd(d, 30030/d) = 1` (squarefreeness of `30030 = 2·3·5·7·11·13`). -/
theorem span_sc_sq_eq_of_dvd (d : ℕ) (hd : d ∣ 30030) :
    Ideal.span ({(↑d : NumberField.RingOfIntegers Work.ClassFieldTower.Kc), Work.ClassFieldTower.scR}
      : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc)) ^ 2
      = Ideal.span ({(↑d : NumberField.RingOfIntegers Work.ClassFieldTower.Kc)}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc)) := by
  -- `d` and `30030 / d` are coprime, and hence `gcd (d * d) 30030 = d`
  have hcop : Nat.Coprime d (30030 / d) :=
    Nat.coprime_of_squarefree_mul (by rw [Nat.mul_div_cancel' hd]; exact dWit_squarefree_nat)
  have hgcd : (d * d).gcd 30030 = d := by
    rw [← Nat.mul_div_cancel' hd, Nat.gcd_mul_left, hcop.gcd_eq_one, mul_one]
  -- Bézout: `d = d² · A + 30030 · B` in `ℤ`
  obtain ⟨A, B, hAB⟩ : ∃ A B : ℤ, (d : ℤ) = ((d : ℤ)) ^ 2 * A + (30030 : ℤ) * B := by
    refine ⟨(d*d).gcdA 30030, (d*d).gcdB 30030, ?_⟩
    have h := Nat.gcd_eq_gcd_ab (d * d) 30030
    rw [hgcd] at h
    push_cast at h ⊢
    linear_combination h
  -- the same identity in `𝓞 Kc`, with `30030` replaced by `-scR²`
  have hAB' : (d : 𝓞 Kc) = (A : 𝓞 Kc) * ((d : 𝓞 Kc) * (d : 𝓞 Kc))
      + (-(B : 𝓞 Kc)) * (-(30030 : 𝓞 Kc)) := by
    have h := congrArg (fun z : ℤ => (z : 𝓞 Kc)) hAB
    push_cast at h
    exact h.trans (by ring_nf)
  have hdP : (d : 𝓞 Kc) ∈ Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) :=
    Ideal.subset_span (Set.mem_insert _ _)
  have hscP : scR ∈ Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) :=
    Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton scR)))
  have hd2 : (d : 𝓞 Kc) * (d : 𝓞 Kc)
      ∈ Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) ^ 2 := by
    rw [pow_two]; exact Ideal.mul_mem_mul hdP hdP
  have hsc2 : (-(30030 : 𝓞 Kc)) ∈ Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) ^ 2 := by
    rw [← scR_sq, pow_two]; exact Ideal.mul_mem_mul hscP hscP
  -- `⟨d, scR⟩² ≤ (d)`: every generator is a multiple of `d`
  have hle : Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) ^ 2
      ≤ Ideal.span ({(d : 𝓞 Kc)} : Set (𝓞 Kc)) := by
    rw [pow_two, Ideal.span_pair_mul_span_pair]
    apply Ideal.span_le.mpr
    intro x hx
    change x ∈ Ideal.span {(d : 𝓞 Kc)}
    rw [Ideal.mem_span_singleton]
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    obtain ⟨c, hc⟩ := hd
    rcases hx with h | h | h | h
    · rw [h]; exact ⟨(d : 𝓞 Kc), by ring⟩
    · rw [h]; exact ⟨scR, by ring⟩
    · rw [h]; exact ⟨scR, by ring⟩
    · rw [h, scR_sq]
      refine ⟨-(c : 𝓞 Kc), ?_⟩
      have hcast : (30030 : 𝓞 Kc) = (d : 𝓞 Kc) * (c : 𝓞 Kc) := by
        rw [← Nat.cast_mul, ← hc]; norm_num
      rw [hcast]; ring
  -- `(d) ≤ ⟨d, scR⟩²`: Bézout writes `d` inside the ideal
  refine le_antisymm hle ?_
  apply Ideal.span_le.mpr
  intro x hx
  rw [Set.mem_singleton_iff] at hx
  subst hx
  have hsum : (A : 𝓞 Kc) * ((d : 𝓞 Kc) * (d : 𝓞 Kc))
      + (-(B : 𝓞 Kc)) * (-(30030 : 𝓞 Kc))
      ∈ Ideal.span ({(d : 𝓞 Kc), scR} : Set (𝓞 Kc)) ^ 2 :=
    Ideal.add_mem _ (Ideal.mul_mem_left _ _ hd2) (Ideal.mul_mem_left _ _ hsc2)
  rw [← hAB'] at hsum
  exact hsum

end Work.ShafarevichKoch
