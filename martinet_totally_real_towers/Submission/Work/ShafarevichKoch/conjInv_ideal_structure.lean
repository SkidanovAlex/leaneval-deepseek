/-! ## Auxiliary: the positive generator of a nonzero ideal of `ℤ` -/

/-- A nonzero ideal of `ℤ` is generated by a unique positive natural number. -/
lemma exists_nat_generator (I : Ideal ℤ) (hI : I ≠ ⊥) :
    ∃ n : ℕ, 0 < n ∧ I = Ideal.span {(n : ℤ)} := by
  refine ⟨(Submodule.IsPrincipal.generator I).natAbs, ?_, ?_⟩
  · rw [Nat.pos_iff_ne_zero]
    intro h
    exact hI ((Submodule.IsPrincipal.eq_bot_iff_generator_eq_zero I).mpr
      (Int.natAbs_eq_zero.mp h))
  · calc I = Ideal.span {Submodule.IsPrincipal.generator I} :=
          (Ideal.span_singleton_generator I).symm
      _ = Ideal.span {↑(Submodule.IsPrincipal.generator I).natAbs} :=
            Ideal.span_singleton_eq_span_singleton.mpr (Int.associated_natAbs _)

/-- Conjugation formula with the two coefficients read off in mixed styles. -/
lemma conjR_apply_nat (y : ℤ) (c : ℕ) :
    conjR ((y : 𝓞 Kc) + (c : 𝓞 Kc) * scR) = (y : 𝓞 Kc) - (c : 𝓞 Kc) * scR := by
  have h := conjR_apply y (c : ℤ)
  simpa using h

/-! ## The two coefficient ideals of an ideal of `𝓞 Kc`

An element `z` of `𝓞 Kc` is uniquely `x + y·scR` with `x y : ℤ`
(`Work.ShafarevichKoch.exists_int_coords`, `int_coords_unique`).  For an ideal `J`,
`intPart J` collects the constant terms `x` and `sPart J` the `scR`-coefficients `y`
occurring among the elements of `J`; both are ideals of `ℤ`. -/

/-- The set of constant terms of elements of `J`, as an ideal of `ℤ`. -/
def intPart (J : Ideal (𝓞 Kc)) : Ideal ℤ := J.comap (Int.castRingHom (𝓞 Kc))

lemma mem_intPart {J : Ideal (𝓞 Kc)} {x : ℤ} : x ∈ intPart J ↔ (x : 𝓞 Kc) ∈ J := Iff.rfl

/-- The set of `scR`-coefficients of elements of `J`, as an ideal of `ℤ`. -/
def sPart (J : Ideal (𝓞 Kc)) : Ideal ℤ where
  carrier := {y : ℤ | ∃ x : ℤ, (x : 𝓞 Kc) + (y : 𝓞 Kc) * scR ∈ J}
  add_mem' := fun {y1 y2} hy1 hy2 => by
    obtain ⟨x1, hx1⟩ := hy1
    obtain ⟨x2, hx2⟩ := hy2
    refine ⟨x1 + x2, ?_⟩
    have h : ((x1 + x2 : ℤ) : 𝓞 Kc) + ((y1 + y2 : ℤ) : 𝓞 Kc) * scR
        = ((x1 : 𝓞 Kc) + (y1 : 𝓞 Kc) * scR) + ((x2 : 𝓞 Kc) + (y2 : 𝓞 Kc) * scR) := by
      push_cast; ring
    rw [h]; exact J.add_mem hx1 hx2
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := fun k {y} hy => by
    obtain ⟨x, hx⟩ := hy
    refine ⟨k * x, ?_⟩
    have h : ((k * x : ℤ) : 𝓞 Kc) + ((k • y : ℤ) : 𝓞 Kc) * scR
        = (k : 𝓞 Kc) * ((x : 𝓞 Kc) + (y : 𝓞 Kc) * scR) := by
      simp only [smul_eq_mul]
      push_cast; ring
    rw [h]; exact J.mul_mem_left _ hx

lemma mem_sPart {J : Ideal (𝓞 Kc)} {y : ℤ} :
    y ∈ sPart J ↔ ∃ x : ℤ, (x : 𝓞 Kc) + (y : 𝓞 Kc) * scR ∈ J := Iff.rfl

lemma intPart_ne_bot {J : Ideal (𝓞 Kc)} (hJ : J ≠ ⊥) : intPart J ≠ ⊥ := by
  intro hbot
  obtain ⟨z, hzJ, hz0⟩ := (Submodule.ne_bot_iff J).mp hJ
  obtain ⟨x, y, hxy⟩ := exists_int_coords z
  have hmem : (x ^ 2 + 30030 * y ^ 2 : ℤ) ∈ intPart J := by
    rw [mem_intPart]
    have hmul : z * conjR z = ((x ^ 2 + 30030 * y ^ 2 : ℤ) : 𝓞 Kc) := by
      rw [hxy, conjR_apply]
      calc ((x : 𝓞 Kc) + (y : 𝓞 Kc) * scR) * ((x : 𝓞 Kc) - (y : 𝓞 Kc) * scR)
          = (x : 𝓞 Kc) ^ 2 - (y : 𝓞 Kc) ^ 2 * (scR * scR) := by ring
        _ = (x : 𝓞 Kc) ^ 2 - (y : 𝓞 Kc) ^ 2 * (-(30030 : 𝓞 Kc)) := by rw [scR_sq]
        _ = ((x ^ 2 + 30030 * y ^ 2 : ℤ) : 𝓞 Kc) := by push_cast; ring
    rw [← hmul]
    exact J.mul_mem_right _ hzJ
  rw [hbot] at hmem
  have hzero : x ^ 2 + 30030 * y ^ 2 = 0 := by simpa using hmem
  have hx2 : x ^ 2 = 0 := by nlinarith [sq_nonneg x, sq_nonneg y]
  have hy2 : y ^ 2 = 0 := by nlinarith [sq_nonneg x, sq_nonneg y]
  have hx : x = 0 := sq_eq_zero_iff.mp hx2
  have hy : y = 0 := sq_eq_zero_iff.mp hy2
  exact hz0 (by rw [hxy, hx, hy]; simp)

lemma sPart_ne_bot {J : Ideal (𝓞 Kc)} (hJ : J ≠ ⊥) : sPart J ≠ ⊥ := by
  intro hbot
  obtain ⟨z, hzJ, hz0⟩ := (Submodule.ne_bot_iff J).mp hJ
  obtain ⟨x, y, hxy⟩ := exists_int_coords z
  rcases eq_or_ne y 0 with hy | hy
  · have hx0 : x ≠ 0 := by
      intro hx; apply hz0; rw [hxy, hy, hx]; simp
    have hmem : x ∈ sPart J := by
      refine mem_sPart.mpr ⟨0, ?_⟩
      have h : ((0 : ℤ) : 𝓞 Kc) + (x : 𝓞 Kc) * scR = z * scR := by
        rw [hxy, hy]; push_cast; ring
      rw [h]; exact J.mul_mem_right _ hzJ
    rw [hbot] at hmem
    have hzero : x = 0 := by simpa using hmem
    exact hx0 hzero
  · have hmem : y ∈ sPart J := mem_sPart.mpr ⟨x, by rw [← hxy]; exact hzJ⟩
    rw [hbot] at hmem
    have hzero : y = 0 := by simpa using hmem
    exact hy hzero

/-- `Kc = ℚ(√-30030)`, `scR = √-30030 ∈ 𝓞 Kc`, and `IsConjInv J` says that the ideal `J` is
stable under the conjugation of `𝓞 Kc = ℤ[√-30030]` (`a + b·scR ∈ J → a - b·scR ∈ J`).
Structure of ambiguous ideals of this quadratic field: a conjugation-stable nonzero ideal of
`ℤ[√-30030]` is generated by `c*d` and `c*√-30030` for some `c > 0`, `d ∣ 30030`.
Hints: any nonzero ideal `J` is `⟨n, b₀⟩` with `n > 0` generating `J ∩ ℤ` and `b₀` realising the
generator `c > 0` of the set of `scR`-coefficients in `J`; reduce `b₀` mod `n` to get
`b₀ = a₀ + c·scR` with `0 ≤ a₀ < n`.  Conjugation-stability gives `n ∣ 2a₀` (so `a₀ = 0` or
`a₀ = n/2`), and ideal-closedness under multiplication by `scR` gives `c ∣ a₀`, `c ∣ n`.  The case
`a₀ = n/2` is impossible because `30030 ≡ 2 (mod 4)`: writing `a₀/c = v` it would force
`2v ∣ 30030 + v²`, impossible for `v` odd (even divisor of an odd number) and for `v` even
(`4 ∣ 30030`). Hence `a₀ = 0`, `d := n/c`, `c ∣ n` and `n ∣ 30030*c` (from `scR · (c·scR)`).
The coordinates `z = a + b·scR` of elements of `𝓞 Kc` are unique (use `Work.ClassFieldTower.int_coords_and_norm`
and `Work.ClassFieldTower.sc_not_rat`). -/
theorem conjInv_ideal_structure (J : Ideal (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))
    (hJ : J ≠ ⊥) (hinv : Work.ShafarevichKoch.IsConjInv J) :
    ∃ c d : ℕ, 0 < c ∧ d ∣ 30030 ∧
      J = Ideal.span ({(↑(c * d) : NumberField.RingOfIntegers Work.ClassFieldTower.Kc),
        (↑c : NumberField.RingOfIntegers Work.ClassFieldTower.Kc) * Work.ClassFieldTower.scR}
        : Set (NumberField.RingOfIntegers Work.ClassFieldTower.Kc)) := by
  obtain ⟨n, hn_pos, hn_eq⟩ := exists_nat_generator (intPart J) (intPart_ne_bot hJ)
  obtain ⟨c, hc_pos, hc_eq⟩ := exists_nat_generator (sPart J) (sPart_ne_bot hJ)
  have mem_int : ∀ x : ℤ, x ∈ intPart J ↔ (n : ℤ) ∣ x := fun x => by
    rw [hn_eq, Ideal.mem_span_singleton]
  have mem_s : ∀ y : ℤ, y ∈ sPart J ↔ (c : ℤ) ∣ y := fun y => by
    rw [hc_eq, Ideal.mem_span_singleton]
  have hn_int_pos : (0 : ℤ) < (n : ℤ) := by exact_mod_cast hn_pos
  have hc_int_pos : (0 : ℤ) < (c : ℤ) := by exact_mod_cast hc_pos
  have hn_mem : (n : 𝓞 Kc) ∈ J := by
    have h : (n : ℤ) ∈ intPart J := (mem_int _).mpr (dvd_refl _)
    rwa [mem_intPart] at h
  -- pick `b₀ = x₀ + c·scR ∈ J`
  have hc_mem : (c : ℤ) ∈ sPart J := (mem_s (c : ℤ)).mpr (dvd_refl _)
  obtain ⟨x₀, hx₀⟩ := mem_sPart.mp hc_mem
  have hx₀' : (x₀ : 𝓞 Kc) + (c : 𝓞 Kc) * scR ∈ J := by simpa using hx₀
  set a : ℤ := x₀ % (n : ℤ) with ha_def
  set kk : ℤ := x₀ / (n : ℤ) with hkk_def
  have ha_nn : 0 ≤ a := by
    rw [ha_def]; exact Int.emod_nonneg _ (ne_of_gt hn_int_pos)
  have ha_lt : a < (n : ℤ) := by
    rw [ha_def]; exact Int.emod_lt_of_pos _ hn_int_pos
  have hx₀_dec : (n : ℤ) * kk + a = x₀ := by
    rw [hkk_def, ha_def]; exact Int.mul_ediv_add_emod x₀ (n : ℤ)
  set b : 𝓞 Kc := (a : 𝓞 Kc) + (c : 𝓞 Kc) * scR with hb_def
  have hb_mem : b ∈ J := by
    have hkn : (kk : 𝓞 Kc) * (n : 𝓞 Kc) ∈ J := J.mul_mem_left _ hn_mem
    have h : b = ((x₀ : 𝓞 Kc) + (c : 𝓞 Kc) * scR) - (kk : 𝓞 Kc) * (n : 𝓞 Kc) := by
      rw [hb_def]
      have hx : (x₀ : 𝓞 Kc) = ((n : ℤ) * kk + a : ℤ) := by rw [hx₀_dec]
      rw [hx]; push_cast; ring
    rw [h]; exact J.sub_mem hx₀' hkn
  -- ### the structural statement `J = ⟨n, b⟩`
  have hJe : J = Ideal.span ({(n : 𝓞 Kc), b} : Set (𝓞 Kc)) := by
    refine le_antisymm ?_ ?_
    · intro z hz
      obtain ⟨x, y, hxy⟩ := exists_int_coords z
      have hz' : (x : 𝓞 Kc) + (y : 𝓞 Kc) * scR ∈ J := by rw [← hxy]; exact hz
      have hy : y ∈ sPart J := mem_sPart.mpr ⟨x, hz'⟩
      obtain ⟨ky, hky⟩ := (mem_s y).mp hy
      have hmem : x - ky * a ∈ intPart J := by
        rw [mem_intPart]
        have hsub : ((x : 𝓞 Kc) + (y : 𝓞 Kc) * scR) - (ky : 𝓞 Kc) * b ∈ J :=
          J.sub_mem hz' (J.mul_mem_left _ hb_mem)
        have heq : ((x : 𝓞 Kc) + (y : 𝓞 Kc) * scR) - (ky : 𝓞 Kc) * b
            = ((x - ky * a : ℤ) : 𝓞 Kc) := by
          rw [hb_def, hky]
          push_cast; ring
        rwa [heq] at hsub
      obtain ⟨jx, hjx⟩ := (mem_int _).mp hmem
      have hcomb : (jx : 𝓞 Kc) * (n : 𝓞 Kc) + (ky : 𝓞 Kc) * b = z := by
        rw [hxy, hb_def, hky]
        have hjx' : (x : ℤ) = (n : ℤ) * jx + ky * a := by linarith [hjx]
        rw [hjx']; push_cast; ring
      rw [← hcomb]
      refine Ideal.add_mem _ ?_ ?_
      · exact Ideal.mul_mem_left _ _
          (Ideal.subset_span (Set.mem_insert _ _))
      · exact Ideal.mul_mem_left _ _
          (Ideal.subset_span (Set.mem_insert_iff.mpr (Or.inr (Set.mem_singleton b))))
    · rw [Ideal.span_le]
      intro z hz
      rcases Set.mem_insert_iff.mp hz with h | h
      · rw [h]; exact hn_mem
      · rw [Set.mem_singleton_iff.mp h]; exact hb_mem
  -- ### conjugation-stability: `n ∣ 2a`
  have hn2a : (n : ℤ) ∣ 2 * a := by
    have hmem : (2 * a : ℤ) ∈ intPart J := by
      rw [mem_intPart]
      have hconj : conjR b ∈ J := hinv b hb_mem
      have hbc : b + conjR b = ((2 * a : ℤ) : 𝓞 Kc) := by
        rw [hb_def, conjR_apply_nat]; push_cast; ring
      rw [← hbc]; exact J.add_mem hb_mem hconj
    exact (mem_int _).mp hmem
  -- ### ideal-closedness under `·scR`: `c ∣ a`
  have hca : (c : ℤ) ∣ a := by
    have hmem : a ∈ sPart J := by
      refine mem_sPart.mpr ⟨-(30030 * (c : ℤ)), ?_⟩
      have key : scR * b ∈ J := J.mul_mem_left _ hb_mem
      have heq : scR * b = (((-(30030 * (c : ℤ)) : ℤ)) : 𝓞 Kc)
          + (a : 𝓞 Kc) * scR := by
        rw [hb_def, mul_add]
        have h3 : scR * ((c : 𝓞 Kc) * scR) = (c : 𝓞 Kc) * (scR * scR) := by ring
        rw [h3, scR_sq]; push_cast; ring
      rw [← heq]; exact key
    exact (mem_s _).mp hmem
  -- ### `c ∣ n`
  have hcn : (c : ℤ) ∣ (n : ℤ) := by
    have hmem : (n : ℤ) ∈ sPart J := by
      refine mem_sPart.mpr ⟨0, ?_⟩
      have h : ((0 : ℤ) : 𝓞 Kc) + ((n : ℤ) : 𝓞 Kc) * scR = (n : 𝓞 Kc) * scR := by
        push_cast; ring
      rw [h]; exact J.mul_mem_right scR hn_mem
    exact (mem_s _).mp hmem
  -- ### `n ∣ v·a + 30030·c` when `a = c·v`
  have hndiv : ∀ v : ℤ, a = (c : ℤ) * v → (n : ℤ) ∣ v * a + 30030 * (c : ℤ) := by
    intro v hav
    have hmem : (v * a + 30030 * (c : ℤ) : ℤ) ∈ intPart J := by
      rw [mem_intPart]
      have h1 : (v : 𝓞 Kc) * b ∈ J := J.mul_mem_left _ hb_mem
      have h2 : scR * b ∈ J := J.mul_mem_left _ hb_mem
      have heq : (v : 𝓞 Kc) * b - scR * b = ((v * a + 30030 * (c : ℤ) : ℤ) : 𝓞 Kc) := by
        rw [hb_def, mul_add, mul_add, hav]
        have h3 : scR * ((c : 𝓞 Kc) * scR) = (c : 𝓞 Kc) * (scR * scR) := by ring
        rw [h3, scR_sq]; push_cast; ring
      rw [← heq]; exact J.sub_mem h1 h2
    exact (mem_int _).mp hmem
  -- ### case analysis on `2a`
  obtain ⟨k2, hk2⟩ := hn2a
  have h2a_nn : 0 ≤ 2 * a := by linarith
  have h2a_lt : 2 * a < 2 * (n : ℤ) := by linarith
  have hk2_01 : k2 = 0 ∨ k2 = 1 := by
    have h1 : (0 : ℤ) ≤ k2 := by nlinarith [hk2, h2a_nn, hn_int_pos]
    have h2 : k2 < 2 := by nlinarith [hk2, h2a_lt, hn_int_pos]
    omega
  rcases hk2_01 with hk2_0 | hk2_1
  · -- #### case `2a = 0`, i.e. `a = 0`
    have ha0 : a = 0 := by nlinarith [hk2, hk2_0]
    have hb_eq : b = (c : 𝓞 Kc) * scR := by
      rw [hb_def, ha0]; push_cast; ring
    obtain ⟨m, hm⟩ := hcn
    have hm_pos : 0 < m := by nlinarith [hm, hn_int_pos, hc_int_pos]
    obtain ⟨d, hd⟩ : ∃ d : ℕ, m = (d : ℤ) :=
      ⟨m.toNat, (Int.toNat_of_nonneg hm_pos.le).symm⟩
    have hn_cd : n = c * d := by
      have h : (n : ℤ) = ((c * d : ℕ) : ℤ) := by rw [hm, hd]; push_cast; ring
      exact_mod_cast h
    have hdvd : d ∣ 30030 := by
      have hmem : (30030 * (c : ℤ) : ℤ) ∈ intPart J := by
        rw [mem_intPart]
        have h2 : scR * b ∈ J := J.mul_mem_left _ hb_mem
        have heq : ((30030 * (c : ℤ) : ℤ) : 𝓞 Kc) = -(scR * b) := by
          rw [hb_eq]
          have h3 : scR * ((c : 𝓞 Kc) * scR) = (c : 𝓞 Kc) * (scR * scR) := by ring
          rw [h3, scR_sq]; push_cast; ring
        rw [heq]; exact neg_mem h2
      have hndvd : (n : ℤ) ∣ 30030 * (c : ℤ) := (mem_int _).mp hmem
      have hprod : (c : ℤ) * (d : ℤ) ∣ (c : ℤ) * 30030 := by
        have hnc : (n : ℤ) = (c : ℤ) * (d : ℤ) := by rw [hn_cd]; push_cast; ring
        rw [← hnc]
        simpa [mul_comm] using hndvd
      have hdvd_int : (d : ℤ) ∣ 30030 :=
        (mul_dvd_mul_iff_left (ne_of_gt hc_int_pos)).mp hprod
      exact Int.natCast_dvd_natCast.mp (by simpa using hdvd_int)
    refine ⟨c, d, hc_pos, hdvd, ?_⟩
    rw [hJe, hb_eq, hn_cd]
  · -- #### case `2a = n`
    exfalso
    have h2a : 2 * a = (n : ℤ) := by rw [hk2, hk2_1]; ring
    have ha_pos : 0 < a := by nlinarith [h2a, hn_int_pos]
    obtain ⟨v, hv⟩ := hca
    have hv_pos : 0 < v := by nlinarith [hv, ha_pos, hc_int_pos]
    have hdiv := hndiv v hv
    have h2v : (2 * v : ℤ) ∣ v ^ 2 + 30030 := by
      have h : (c : ℤ) * (2 * v) ∣ (c : ℤ) * (v ^ 2 + 30030) := by
        have hv' : (n : ℤ) = (c : ℤ) * (2 * v) := by rw [← h2a, hv]; ring
        have hva : v * a + 30030 * (c : ℤ) = (c : ℤ) * (v ^ 2 + 30030) := by
          rw [hv]; ring
        rw [← hva, ← hv']
        exact hdiv
      exact (mul_dvd_mul_iff_left (ne_of_gt hc_int_pos)).mp h
    rcases Int.even_or_odd v with hev | hod
    · obtain ⟨w, hw⟩ := even_iff_two_dvd.mp hev
      have h2vw : (2 * v : ℤ) = 4 * w := by rw [hw]; ring
      have hv2 : v ^ 2 = 4 * w ^ 2 := by rw [hw]; ring
      have hA : (4 * w : ℤ) ∣ v ^ 2 + 30030 := by rwa [h2vw] at h2v
      have hB : (4 * w : ℤ) ∣ v ^ 2 := by rw [hv2]; exact ⟨w, by ring⟩
      have h4w : (4 * w : ℤ) ∣ 30030 := by
        have h := dvd_sub hA hB
        convert h using 1; ring
      have h4 : (4 : ℤ) ∣ 30030 :=
        dvd_trans (⟨w, by ring⟩ : (4 : ℤ) ∣ 4 * w) h4w
      norm_num at h4
    · obtain ⟨w, hw⟩ := hod
      have htwo : (2 : ℤ) ∣ v ^ 2 + 30030 :=
        dvd_trans (⟨v, by ring⟩ : (2 : ℤ) ∣ 2 * v) h2v
      have hodd : (2 : ℤ) ∣ v ^ 2 - 1 := by
        rw [hw]; exact ⟨2 * w ^ 2 + 2 * w, by ring⟩
      have h30031 : (2 : ℤ) ∣ 30031 := by
        have h := dvd_sub htwo hodd
        convert h using 1; ring
      exact absurd h30031 (by norm_num)

end

end Work.ShafarevichKoch
