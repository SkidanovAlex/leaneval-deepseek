Copyright: the martinet_totally_real_towers team.

# `#ker(H²Res) ≤ 2 ^ s` for an extension with a continuous section

**Module** `Submission.Work.ShafarevichKoch.natCard_ker_H2Res_le_two_pow_of_continuousSection`.

Let `1 → N → G → Q → 1` be a topological group extension (`Work.ConCohomology.GroupExt`), with
`𝔽₂ = ZMod 2` carrying a `G`-action that factors through `q : G → Q` (`hcompG`) and a *trivial*
action of `N` (`hcompN`).  Suppose moreover that

* the inclusion `i` is continuous (`hi`),
* `q` admits a **continuous** section `sec` (`hsec`, `hseccont`),
* the kernel lifting `E.kerLift` is continuous on `{x // q x = 1}` (`hkcont`).

Then, if `N` is normally generated by `s` elements, the kernel of the inflation
`H²Res E.q : H²(Q,𝔽₂) → H²(G,𝔽₂)` is **finite of cardinality at most `2 ^ s`**.

## Proof

By Hochschild--Serre exactness at `H²(Q,𝔽₂)` the kernel of the inflation is the image of the
transgression (this is `Work.ConCohomology.ker_H2Res_eq_range_tg`, and it is precisely here that
the three compatibility hypotheses above are used):

  `ker(H2Res) = { [tg φ] : φ ∈ Z¹(N,𝔽₂)^G }`.

Under the triviality of the `N`-action the target `𝔽₂` is an abelian group written additively, so
`Z¹(N,𝔽₂)` is the group of (`G`-equivariant) additive maps `N → 𝔽₂`; such a map is determined by
its values on a set of normal generators (`natCard_H1_le_two_pow_of_normalClosure`, or the
`Z¹`-form `finite_natCard_Z1_le_two_pow_of_normalClosure` proved below), so

  `#Z¹(N,𝔽₂) ≤ #(Fin s → 𝔽₂) = 2 ^ s` and `Z¹(N,𝔽₂)` is finite.

The transgression class map `T : Z¹(N,𝔽₂) → H²(Q,𝔽₂)`, `φ ↦ [tg φ]`, therefore exhibits
`ker(H2Res)` as a quotient of the finite type `Z¹(N,𝔽₂)`, whence it is finite with at most `2 ^ s`
elements (`Finite.of_surjective`, `Nat.card_le_card_of_surjective`).

The map `T` is total and lands in the kernel because the transgression is only a `2`-cocycle when
`φ` is a `1`-cocycle that is `G`-equivariant; the (classically decidable) branch
`IsCocycle2 (tg φ)` handles this, and the resulting `dite` map is a surjection onto the kernel by
the exactness statement above.
-/

import Mathlib
import Submission.Work.ConCohomology.All
import Submission.Work.ShafarevichKoch.natCard_H1_le_two_pow_of_normalClosure
import Submission.Work.ShafarevichKoch.natCard_H2_le_two_pow_of_inflation_eq_zero

namespace Work.ShafarevichKoch

open Work.ConCohomology

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 2000000

/-- **`Z¹` of a group generated by `s` elements, with trivial `𝔽₂`-action.**  If `N` acts trivially
on `𝔽₂` and the normal closure of the range of `x : Fin s → N` is all of `N`, then the group
`Z¹(N,𝔽₂)` of locally constant `1`-cocycles is *finite* and has at most `2 ^ s` elements.

A `1`-cocycle for a trivial action is an additive map `N → 𝔽₂`, and such a map is determined by its
values on any set of normal generators: the agreement set of two additive maps is a normal
subgroup. -/
theorem finite_natCard_Z1_le_two_pow_of_normalClosure
    {N : Type*} [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
    [DistribMulAction N (ZMod 2)] [Work.ConCohomology.IsDiscreteGModule N (ZMod 2)]
    (htriv : ∀ (n : N) (m : ZMod 2), n • m = m)
    (s : ℕ) (x : Fin s → N) (hx : Subgroup.normalClosure (Set.range x) = ⊤) :
    Finite (Work.ConCohomology.Z1 N (ZMod 2)) ∧
      Nat.card (Work.ConCohomology.Z1 N (ZMod 2)) ≤ 2 ^ s := by
  classical
  -- Evaluation at the normal generators is injective.
  have hinj : Function.Injective
      (fun z : Z1 N (ZMod 2) => fun i : Fin s => (z.1 : N → ZMod 2) (x i)) := by
    intro z w hzw
    have haddz : ∀ a b : N,
        (z.1 : N → ZMod 2) (a * b) = (z.1 : N → ZMod 2) a + (z.1 : N → ZMod 2) b :=
      fun a b => (isCocycle1_iff_of_trivial htriv _).mp (mem_Z1.mp z.2) a b
    have haddw : ∀ a b : N,
        (w.1 : N → ZMod 2) (a * b) = (w.1 : N → ZMod 2) a + (w.1 : N → ZMod 2) b :=
      fun a b => (isCocycle1_iff_of_trivial htriv _).mp (mem_Z1.mp w.2) a b
    have hz1 : (z.1 : N → ZMod 2) 1 = 0 := by
      have h := haddz 1 1
      rw [mul_one] at h
      exact (add_left_cancel (show (z.1 : N → ZMod 2) 1 + 0
        = (z.1 : N → ZMod 2) 1 + (z.1 : N → ZMod 2) 1 from by rw [add_zero]; exact h)).symm
    have hw1 : (w.1 : N → ZMod 2) 1 = 0 := by
      have h := haddw 1 1
      rw [mul_one] at h
      exact (add_left_cancel (show (w.1 : N → ZMod 2) 1 + 0
        = (w.1 : N → ZMod 2) 1 + (w.1 : N → ZMod 2) 1 from by rw [add_zero]; exact h)).symm
    have hxi : ∀ i : Fin s, (z.1 : N → ZMod 2) (x i) = (w.1 : N → ZMod 2) (x i) :=
      fun i => congrFun hzw i
    -- The difference of the two cocycles, as a multiplicative homomorphism `N → 𝔽₂`.
    let Φ : N →* Multiplicative (ZMod 2) :=
      { toFun := fun n => Multiplicative.ofAdd ((z.1 : N → ZMod 2) n - (w.1 : N → ZMod 2) n)
        map_one' := by rw [hz1, hw1, sub_self, ofAdd_zero]
        map_mul' := fun a b => by
          show Multiplicative.ofAdd _ = Multiplicative.ofAdd _ * Multiplicative.ofAdd _
          rw [← ofAdd_add]
          congr 1
          rw [haddz, haddw]
          abel }
    have hle : Subgroup.normalClosure (Set.range x) ≤ MonoidHom.ker Φ :=
      Subgroup.normalClosure_le_normal (fun n hn => by
        obtain ⟨i, rfl⟩ := hn
        refine MonoidHom.mem_ker.mpr ?_
        change Multiplicative.ofAdd
          ((z.1 : N → ZMod 2) (x i) - (w.1 : N → ZMod 2) (x i)) = 1
        rw [hxi i, sub_self, ofAdd_zero])
    rw [hx] at hle
    have hpoint : ∀ n : N, (z.1 : N → ZMod 2) n = (w.1 : N → ZMod 2) n := by
      intro n
      have hmem : Φ n = 1 := MonoidHom.mem_ker.mp (hle (Subgroup.mem_top n))
      have h2 : Multiplicative.toAdd (Φ n) = Multiplicative.toAdd (1 : Multiplicative (ZMod 2)) := by
        rw [hmem]
      have h0 : (z.1 : N → ZMod 2) n - (w.1 : N → ZMod 2) n = 0 := by simpa [Φ] using h2
      exact sub_eq_zero.mp h0
    exact Subtype.ext (LocallyConstant.ext (fun n => hpoint n))
  have hfin : Finite (Z1 N (ZMod 2)) := Finite.of_injective _ hinj
  refine ⟨hfin, ?_⟩
  have hFin : Nat.card (Fin s → ZMod 2) = 2 ^ s := by
    rw [Nat.card_fun, Nat.card_fin, Nat.card_eq_fintype_card, ZMod.card]
  rw [← hFin]
  exact Nat.card_le_card_of_injective _ hinj

/-- **The kernel of the inflation `H²(Q,𝔽₂) → H²(G,𝔽₂)` is a quotient of `Z¹(N,𝔽₂)`.**  For a
topological group extension `1 → N → G → Q → 1` with a continuous section of `q`, a continuous
inclusion `i`, continuous kernel lifting, `N` acting trivially on `𝔽₂` and the `G`-action on `𝔽₂`
factoring through `q`, the kernel of `H2Res E.q : H²(Q,𝔽₂) → H²(G,𝔽₂)` has at most `2 ^ s`
elements whenever `N` is normally generated by `s` elements.

By the Hochschild--Serre exactness at `H²(Q,𝔽₂)` (`ker_H2Res_eq_range_tg`), the kernel consists of
transgression classes `[tg φ]` of `G`-equivariant `1`-cocycles `φ` on `N`; a `1`-cocycle on `N`
(for the trivial action) is an additive map `N → 𝔽₂`, determined by its values on `s` normal
generators.  Hence `ker(H2Res)` is a quotient of a finite type of cardinality `≤ 2 ^ s`. -/
theorem natCard_ker_H2Res_le_two_pow_of_continuousSection
    {G Q N : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
    [DistribMulAction G (ZMod 2)] [DistribMulAction Q (ZMod 2)] [DistribMulAction N (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule G (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule Q (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule N (ZMod 2)]
    (E : Work.ConCohomology.GroupExt G Q N)
    (hq : Continuous E.q) (hi : Continuous E.i)
    (hcompN : ∀ (n : N) (m : ZMod 2), n • m = m)
    (hcompG : ∀ (g : G) (m : ZMod 2), g • m = E.q g • m)
    (sec : Q → G) (hsec : ∀ y : Q, E.q (sec y) = y) (hseccont : Continuous sec)
    (hkcont : Continuous fun p : {x : G // E.q x = 1} => E.kerLift p.1 p.2)
    (s : ℕ) (x : Fin s → N) (hx : Subgroup.normalClosure (Set.range x) = ⊤) :
    Finite (AddMonoidHom.ker (Work.ConCohomology.H2Res E.q hq hcompG)) ∧
      Nat.card (AddMonoidHom.ker (Work.ConCohomology.H2Res E.q hq hcompG)) ≤ 2 ^ s := by
  classical
  obtain ⟨hZ1fin, hZ1card⟩ := finite_natCard_Z1_le_two_pow_of_normalClosure hcompN s x hx
  -- The `Q`-action on `𝔽₂` is the `G`-action transported along the section `sec`.
  have hcompQ : ∀ (y : Q) (m : ZMod 2), y • m = sec y • m := fun y m => by
    rw [hcompG (sec y) m, hsec y]
  -- The transgression class of a `1`-cochain on `N`.
  let T : Z1 N (ZMod 2) → H2 Q (ZMod 2) := fun φ =>
    if h : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2))))
    then H2.mk ⟨tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)), mem_Z2.mpr h⟩
    else 0
  -- Its values are in the kernel of the inflation (by exactness), so it corestricts to `ker`.
  let g : Z1 N (ZMod 2) → AddMonoidHom.ker (H2Res E.q hq hcompG) := fun φ =>
    if h : H2Res E.q hq hcompG (T φ) = 0 then ⟨T φ, h⟩ else 0
  have hsurj : Function.Surjective g := by
    rintro ⟨y, hy⟩
    obtain ⟨z, rfl⟩ := QuotientAddGroup.mk_surjective y
    -- Exactness: `y` is the transgression of a `G`-equivariant `1`-cocycle `φ`, up to a
    -- `1`-cochain `w` on `Q`.
    obtain ⟨φ, hφ, hinv, w, hw⟩ :=
      (ker_H2Res_eq_range_tg E hq hi hcompN hcompG sec hsec hseccont hkcont z).mp hy
    have hcoc : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)))) := by
      have h := isCocycle2_tgFun E hcompN sec hsec hcompQ (φ.1 : N → ZMod 2) hφ hinv
      simpa [tgCochain_coe] using h
    -- The transgression of `φ` therefore represents the same class as `z`.
    have hT : T φ = H2.mk z := by
      show (if h : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2))))
        then H2.mk ⟨tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)), mem_Z2.mpr h⟩
        else (0 : H2 Q (ZMod 2))) = H2.mk z
      rw [dite_eq_left hcoc]
      rw [H2.mk_eq_mk_iff, mem_B2', mem_B2]
      refine ⟨w, ?_⟩
      show (d1Hom Q (ZMod 2) w : Cochain2 Q (ZMod 2))
        = (tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)) : Cochain2 Q (ZMod 2))
          - (z : Cochain2 Q (ZMod 2))
      apply LocallyConstant.coe_inj.mp
      funext p
      obtain ⟨a, b⟩ := p
      exact (congrFun hw (a, b)).symm
    refine ⟨φ, ?_⟩
    have hT0 : H2Res E.q hq hcompG (T φ) = 0 := by rw [hT]; exact hy
    show (if h : H2Res E.q hq hcompG (T φ) = 0
      then (⟨T φ, h⟩ : AddMonoidHom.ker (H2Res E.q hq hcompG)) else 0) = ⟨H2.mk z, hy⟩
    rw [dite_eq_left hT0]
    exact Subtype.ext hT
  refine ⟨Finite.of_surjective g hsurj, ?_⟩
  exact le_trans (Nat.card_le_card_of_surjective g hsurj) hZ1card

end Work.ShafarevichKoch
