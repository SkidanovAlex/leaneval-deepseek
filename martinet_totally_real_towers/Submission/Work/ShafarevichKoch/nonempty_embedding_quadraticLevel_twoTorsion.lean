import Mathlib
import Submission.Work.ShafarevichKoch.GeneratorRank
import Submission.Work.ShafarevichKoch.card_unramifiedQuadraticLevels_le_classGroupTwoRank
import Submission.Work.ShafarevichKoch.isGalois_of_finrank_eq_two
import Submission.Work.ShafarevichKoch.mem_VTwo_of_unramified
import Submission.Work.ShafarevichKoch.vClass_eq_one_iff
import Submission.Work.ShafarevichKoch.vClass_mul
import Submission.Work.ShafarevichKoch.vClass_sq_eq_one
import Submission.Work.ClassFieldTower.degreeTwo_sqrt_gen

/-!
# `Work.ShafarevichKoch.nonempty_embedding_quadraticLevel_twoTorsion`

**The Kummer two-descent as an embedding of the unramified quadratic levels into `Cl(F)[2] \\ {1}`.**

Themap is

`L ↦ vClass F a`,  where `L = F⟮b⟯`, `b² = a`  (`a ∈ V_∅ = VTwo F`),

i.e. the ideal class of a square root of the principal fractional ideal `(a)`.

* It lands in the `2`-torsion (`vClass_sq_eq_one`) and is *nontrivial*: if `vClass F a = 1` then
  `a = u · y²` with `u` a unit of `𝓞 F` (`vClass_eq_one_iff`); the hypothesis `hunits` then makes
  `a` a square of `F`, so `b ∈ F` and `L = ⊥`, contradicting `[L : F] = 2`.
* It is injective: the argument is the one of
  `card_unramifiedQuadraticLevels_le_classGroupTwoRank` (a level is determined by the square class
  of its Kummer generator, and `hunits` kills the kernel of the descent).
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

theorem nonempty_embedding_quadraticLevel_twoTorsion (F : Type*) [Field F] [NumberField F]
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (hunits : ∀ (u : Work.ShafarevichKoch.RingUnit F) (z : M.K),
      z * z = algebraMap F M.K (Work.ShafarevichKoch.unitEmbed F u : F) →
      ∃ y : Fˣ, Work.ShafarevichKoch.unitEmbed F u = y ^ 2) :
    Nonempty (Work.ShafarevichKoch.QuadraticLevel F M ↪
      {c : ClassGroup (NumberField.RingOfIntegers F) // c ^ 2 = 1 ∧ c ≠ 1}) := by
  classical
  have hchar : (2 : F) ≠ 0 := Nat.cast_ne_zero.mpr (by norm_num)
  -- Step 1: each level is generated by a square root of a unit of `F`.
  choose a b hbmem hbsq hbgen using fun (L0 : QuadraticLevel F M) =>
    Work.ClassFieldTower.degreeTwo_sqrt_gen (K := F) (L := M.K) hchar
      (L0 : IntermediateField F M.K) L0.2
  have hfd : ∀ L0 : QuadraticLevel F M, FiniteDimensional F (L0 : IntermediateField F M.K) :=
    fun L0 => Module.finite_of_finrank_pos (by rw [L0.2]; norm_num)
  have hNF : ∀ L0 : QuadraticLevel F M, NumberField ↥(L0 : IntermediateField F M.K) :=
    fun L0 => by
      haveI := hfd L0
      exact NumberField.of_module_finite F ↥(L0 : IntermediateField F M.K)
  have hgal : ∀ L0 : QuadraticLevel F M, IsGalois F (L0 : IntermediateField F M.K) :=
    fun L0 => isGalois_of_finrank_eq_two F M.K (L0 : IntermediateField F M.K) L0.2
  -- Step 2: unramifiedness forces the Kummer classes to lie in `V_∅`.
  have hmem : ∀ L0 : QuadraticLevel F M, a L0 ∈ VTwo F := by
    intro L0
    haveI : NumberField ↥(L0 : IntermediateField F M.K) := hNF L0
    haveI : FiniteDimensional F ↥(L0 : IntermediateField F M.K) := hfd L0
    haveI : IsGalois F ↥(L0 : IntermediateField F M.K) := hgal L0
    refine mem_VTwo_of_unramified F ↥(L0 : IntermediateField F M.K) (a L0)
      ⟨b L0, hbmem L0⟩ ?_
      (M.unramified (L0 : IntermediateField F M.K) (hfd L0) (hgal L0))
    apply Subtype.ext
    show b L0 * b L0 = algebraMap F M.K ((a L0 : Fˣ) : F)
    exact hbsq L0
  let X : QuadraticLevel F M → VTwo F := fun L0 => ⟨a L0, hmem L0⟩
  -- Step 3: a level is determined by the square class of its Kummer generator.
  have hlevel : ∀ L₁ L₂ : QuadraticLevel F M, (∃ c : Fˣ, a L₁ = a L₂ * c ^ 2) → L₁ = L₂ := by
    intro L₁ L₂ hc
    obtain ⟨c, hc⟩ := hc
    have hcF : ((a L₁ : Fˣ) : F) = ((a L₂ : Fˣ) : F) * ((c : Fˣ) : F) ^ 2 := by
      rw [hc, Units.val_mul, Units.val_pow_eq_pow_val]
    have hsq2 : b L₁ * b L₁
        = (algebraMap F M.K ((c : Fˣ) : F) * b L₂)
          * (algebraMap F M.K ((c : Fˣ) : F) * b L₂) := by
      calc b L₁ * b L₁ = algebraMap F M.K ((a L₁ : Fˣ) : F) := hbsq L₁
        _ = algebraMap F M.K (((a L₂ : Fˣ) : F) * ((c : Fˣ) : F) ^ 2) := by rw [hcF]
        _ = algebraMap F M.K ((a L₂ : Fˣ) : F) * (algebraMap F M.K ((c : Fˣ) : F)) ^ 2 := by
              rw [map_mul, map_pow]
        _ = (b L₂ * b L₂) * (algebraMap F M.K ((c : Fˣ) : F)) ^ 2 := by rw [hbsq L₂]
        _ = (algebraMap F M.K ((c : Fˣ) : F) * b L₂)
              * (algebraMap F M.K ((c : Fˣ) : F) * b L₂) := by ring
    have hbijmem : b L₁ ∈ (L₂ : IntermediateField F M.K) := by
      rcases (mul_self_eq_mul_self_iff.mp hsq2) with h | h
      · rw [h]
        exact mul_mem (IntermediateField.algebraMap_mem _ ((c : Fˣ) : F)) (hbmem L₂)
      · rw [h]
        exact neg_mem (mul_mem (IntermediateField.algebraMap_mem _ ((c : Fˣ) : F)) (hbmem L₂))
    have hle : (L₁ : IntermediateField F M.K) ≤ (L₂ : IntermediateField F M.K) := by
      rw [← hbgen L₁]
      refine IntermediateField.adjoin_le_iff.mpr ?_
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hbijmem
    haveI : FiniteDimensional F ↥(L₂ : IntermediateField F M.K) := hfd L₂
    exact Subtype.ext (IntermediateField.eq_of_le_of_finrank_eq hle (by rw [L₁.2, L₂.2]))
  -- Step 4: the Kummer two-descent, as a homomorphism `V_∅ → Cl(F)`.
  have hvClass_one : vClass F (1 : VTwo F) = 1 := by
    have hcoe : (((1 : VTwo F)) : Fˣ) = 1 := rfl
    have h1 : (1 : IdealUnit F) * 1 = FracIdealOf F (((1 : VTwo F)) : Fˣ) := by
      rw [hcoe, FracIdealOf_one, mul_one]
    rw [vClass_eq_mk F (x := 1) (J := 1) h1]
    exact map_one (ClassGroup.mk F)
  let vC : VTwo F →* ClassGroup (𝓞 F) :=
    { toFun := fun x => vClass F x, map_one' := hvClass_one, map_mul' := vClass_mul F }
  -- Step 5: `vClass` of the level generator is a nontrivial `2`-torsion class.
  have hne : ∀ L0 : QuadraticLevel F M, vC (X L0) ≠ 1 := by
    intro L0 hv
    obtain ⟨u, y, hyu⟩ := (vClass_eq_one_iff F (X L0)).mp hv
    have haeq : a L0 = unitEmbed F u * y ^ 2 := by
      simpa only [X, Subtype.coe_mk] using hyu
    have hUF : ((a L0 : Fˣ) : F) = ((unitEmbed F u : Fˣ) : F) * ((y : Fˣ) : F) ^ 2 := by
      rw [haeq, Units.val_mul, Units.val_pow_eq_pow_val]
    have hbbY : b L0 * b L0 = algebraMap F M.K ((unitEmbed F u : Fˣ) : F)
        * (algebraMap F M.K ((y : Fˣ) : F) * algebraMap F M.K ((y : Fˣ) : F)) := by
      rw [hbsq L0, hUF, map_mul, map_pow]
      ring
    have hy0 : algebraMap F M.K ((y : Fˣ) : F) ≠ 0 := by
      intro h
      exact Units.ne_zero y (FaithfulSMul.algebraMap_injective F M.K (by rw [h, map_zero]))
    have hZsq : (b L0 / algebraMap F M.K ((y : Fˣ) : F))
          * (b L0 / algebraMap F M.K ((y : Fˣ) : F))
        = algebraMap F M.K ((unitEmbed F u : Fˣ) : F) := by
      rw [div_mul_div_comm, hbbY, mul_div_cancel_right₀ _ (mul_ne_zero hy0 hy0)]
    obtain ⟨y', hy'⟩ := hunits u (b L0 / algebraMap F M.K ((y : Fˣ) : F)) hZsq
    have ha_sq : a L0 = (y' * y) ^ 2 := by
      rw [haeq, hy', mul_pow]
    have hb_sq : b L0 * b L0 = algebraMap F M.K ((y' * y : Fˣ) : F)
        * algebraMap F M.K ((y' * y : Fˣ) : F) := by
      rw [hbsq L0, ha_sq, Units.val_pow_eq_pow_val, map_pow, sq]
    have hbmem_bot : b L0 ∈ (⊥ : IntermediateField F M.K) := by
      rcases mul_self_eq_mul_self_iff.mp hb_sq with h | h
      · exact IntermediateField.mem_bot.mpr ⟨((y' * y : Fˣ) : F), h.symm⟩
      · exact IntermediateField.mem_bot.mpr ⟨-((y' * y : Fˣ) : F), by rw [map_neg]; exact h.symm⟩
    have hadj : IntermediateField.adjoin F ({b L0} : Set M.K) = ⊥ :=
      IntermediateField.adjoin_simple_eq_bot_iff.mpr hbmem_bot
    have hbot : (L0 : IntermediateField F M.K) = ⊥ := by
      rw [← hbgen L0, hadj]
    have hfr : Module.finrank F ↥(L0 : IntermediateField F M.K) = 1 := by
      rw [hbot, IntermediateField.finrank_bot]
    have h2 := L0.2
    omega
  let ci : QuadraticLevel F M → {c : ClassGroup (𝓞 F) // c ^ 2 = 1 ∧ c ≠ 1} :=
    fun L0 => ⟨vC (X L0), vClass_sq_eq_one F (X L0), hne L0⟩
  -- Step 6: `ci` is injective, because `hunits` trivialises the kernel of the descent.
  have hci_inj : Function.Injective ci := by
    intro L₁ L₂ hij
    have hvceq : vC (X L₁) = vC (X L₂) := congrArg Subtype.val hij
    have hW : vC (X L₁ * (X L₂)⁻¹) = 1 := by
      rw [map_mul, MonoidHom.map_inv, hvceq, mul_inv_cancel]
    obtain ⟨u, y, hyu⟩ := (vClass_eq_one_iff F (X L₁ * (X L₂)⁻¹)).mp hW
    have haij : a L₁ * (a L₂)⁻¹ = unitEmbed F u * y ^ 2 := by
      simpa only [X, Subgroup.coe_mul, Subgroup.coe_inv, Subtype.coe_mk] using hyu
    have haijF : ((a L₁ : Fˣ) : F) * (((a L₂ : Fˣ) : F))⁻¹
        = ((unitEmbed F u : Fˣ) : F) * ((y : Fˣ) : F) ^ 2 := by
      have h := congrArg (fun w : Fˣ => (w : F)) haij
      simpa only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val] using h
    have hUF : ((a L₁ : Fˣ) : F)
        = ((unitEmbed F u : Fˣ) : F) * (((y : Fˣ) : F) ^ 2 * ((a L₂ : Fˣ) : F)) := by
      have h2 : ((a L₁ : Fˣ) : F)
          = (((unitEmbed F u : Fˣ) : F) * ((y : Fˣ) : F) ^ 2) * ((a L₂ : Fˣ) : F) := by
        rw [← haijF]
        rw [mul_assoc, inv_mul_cancel₀ (Units.ne_zero (a L₂)), mul_one]
      rw [h2]; ring
    have hy0 : algebraMap F M.K ((y : Fˣ) : F) ≠ 0 := by
      intro h
      have h' : ((y : Fˣ) : F) = 0 :=
        FaithfulSMul.algebraMap_injective F M.K (by rw [h, map_zero])
      exact Units.ne_zero y h'
    have hbj0 : b L₂ ≠ 0 := by
      intro h0
      have h1 : algebraMap F M.K ((a L₂ : Fˣ) : F) = algebraMap F M.K (0 : F) := by
        rw [map_zero, ← hbsq L₂, h0, mul_zero]
      exact Units.ne_zero (a L₂) (FaithfulSMul.algebraMap_injective F M.K h1)
    have hcy0 : algebraMap F M.K ((y : Fˣ) : F) * b L₂ ≠ 0 := mul_ne_zero hy0 hbj0
    set Z : M.K := b L₁ * (algebraMap F M.K ((y : Fˣ) : F) * b L₂)⁻¹ with hZdef
    have hstep : (algebraMap F M.K ((unitEmbed F u : Fˣ) : F))
          * (algebraMap F M.K ((y : Fˣ) : F) * b L₂)
          * (algebraMap F M.K ((y : Fˣ) : F) * b L₂) = b L₁ * b L₁ := by
      rw [hbsq L₁, hUF, map_mul, map_mul, map_pow, ← hbsq L₂]
      ring
    have hZsq : Z * Z
        = (b L₁ * b L₁) * ((algebraMap F M.K ((y : Fˣ) : F) * b L₂)
            * (algebraMap F M.K ((y : Fˣ) : F) * b L₂))⁻¹ := by
      rw [hZdef,
        show b L₁ * (algebraMap F M.K ((y : Fˣ) : F) * b L₂)⁻¹
            = b L₁ / (algebraMap F M.K ((y : Fˣ) : F) * b L₂) from (div_eq_mul_inv _ _).symm]
      rw [div_mul_div_comm, div_eq_mul_inv]
    have hZ : Z * Z = algebraMap F M.K ((unitEmbed F u : Fˣ) : F) := by
      have hcc : ((algebraMap F M.K ((y : Fˣ) : F) * b L₂)
            * (algebraMap F M.K ((y : Fˣ) : F) * b L₂)) ≠ 0 := mul_ne_zero hcy0 hcy0
      have hbi : b L₁ * b L₁ = (algebraMap F M.K ((unitEmbed F u : Fˣ) : F))
            * ((algebraMap F M.K ((y : Fˣ) : F) * b L₂)
              * (algebraMap F M.K ((y : Fˣ) : F) * b L₂)) := by
        rw [← hstep]; ring
      rw [hZsq, hbi, mul_assoc, mul_inv_cancel₀ hcc, mul_one]
    obtain ⟨y', hy'⟩ := hunits u Z hZ
    have hai_eq : a L₁ = a L₂ * (y' * y) ^ 2 := by
      have h3 : a L₁ = a L₂ * (unitEmbed F u * y ^ 2) := by
        rw [← haij]
        rw [mul_comm (a L₂) (a L₁ * (a L₂)⁻¹), mul_assoc, inv_mul_cancel, mul_one]
      rw [hy'] at h3
      rw [mul_pow]
      exact h3
    exact hlevel L₁ L₂ ⟨y' * y, hai_eq⟩
  exact ⟨⟨ci, hci_inj⟩⟩

end Work.ShafarevichKoch
