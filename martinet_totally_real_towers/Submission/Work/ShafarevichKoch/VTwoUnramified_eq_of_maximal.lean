import Mathlib
import Submission.Work.ShafarevichKoch.VTwoUnramified
import Submission.Work.ClassFieldTower.Defs
import Submission.Work.ClassFieldTower.Objects

/-!
# `Work.ShafarevichKoch.VTwoUnramified_eq_of_maximal`

The unramified Kummer radical `V^{unr} = VTwoUnramified F M` of
`Submission/Work/ShafarevichKoch/VTwoUnramified.lean` is defined from *a* maximal unramified
pro-`2` extension `M` of `F`, namely

```lean
VTwoUnramified F M = {x : Fˣ | ∃ b : M.K, b ≠ 0 ∧ b * b = algebraMap F M.K (x : F)}
```

i.e. the set of `x` whose square root `√x` lies in `M.K = F_∅`.  Since `F_∅` is determined by
its universal property only up to isomorphism, this subgroup must not depend on the chosen object
`M`; that is the content of

* `VTwoUnramified_le_of_maximal` -- the comparison inequality between two choices;
* `VTwoUnramified_eq_of_maximal` -- the resulting equality, the statement requested by the
  class-field-tower chapter (so that `V^{unr}` is a genuine invariant of `F`).

## Proof

Both objects satisfy the *same* two structural clauses of `MaximalUnramifiedProP`: every finite
dimensional Galois subextension is unramified over `F` (`M.unramified`) and pro-`2`
(`M.proP`).  Hence, for `x ∈ VTwoUnramified F M` with a square root `b ∈ M.K`:

* the subfield `N = normalClosure F F⟮b⟯ M.K` is finite dimensional and Galois over `F`, so
  `M.proP` gives `IsPGroup 2 Gal(N/F)` and `M.unramified` gives `𝓓(N/F) = ⊤`;
* therefore the universal property `M'.universal` of the *other* maximal object `M'` embeds `N`
  into `M'.K` by an `F`-algebra map `φ`;
* `φ b` is then a nonzero square root of `x` in `M'.K`, i.e. `x ∈ VTwoUnramified F M'`.

Taking the normal closure (rather than `F⟮b⟯` itself) makes the two clauses applicable without
any separate argument that `F⟮b⟯/F` is Galois; this is the same device used in
`VTwoUnramified_le_VTwo`.
-/

open scoped Classical
open scoped NumberField
open NumberField

set_option linter.style.haveILetI false

noncomputable section

namespace Work.ShafarevichKoch

/-- **`V^{unr}` is monotone along the universal property.**  If `x` has a square root in a maximal
unramified pro-`2` extension `M.K` of `F`, it has one in any other such extension `M'.K`: the
square root lies in a finite dimensional Galois subextension of `M.K` (its normal closure), which
is unramified pro-`2` over `F` by the defining clauses of `M`, and therefore embeds into `M'.K`
by the universal property of `M'`. -/
theorem VTwoUnramified_le_of_maximal {F : Type*} [Field F] [NumberField F]
    (M M' : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2) :
    VTwoUnramified F M ≤ VTwoUnramified F M' := by
  intro x hx
  obtain ⟨b, hb0, hb⟩ := hx
  -- the intermediate field generated by the square root `b`
  let E : IntermediateField F M.K := IntermediateField.adjoin F ({b} : Set M.K)
  haveI hfdE : FiniteDimensional F E :=
    IntermediateField.finiteDimensional_adjoin
      (fun z _ => IsAlgebraic.isIntegral (Algebra.IsAlgebraic.isAlgebraic z))
  -- its normal closure inside `M.K` is a finite dimensional Galois level
  let N : IntermediateField F M.K := IntermediateField.normalClosure F E M.K
  haveI hfdN : FiniteDimensional F N := normalClosure.is_finiteDimensional F E M.K
  haveI hgalN : IsGalois F N := IsGalois.normalClosure F E M.K
  haveI hNumN : NumberField ↥N := NumberField.of_module_finite F ↥N
  have hbN : b ∈ N :=
    (IntermediateField.subset_adjoin F ({b} : Set M.K)).trans
      (IntermediateField.le_normalClosure E) (by simp)
  -- the two defining clauses of `M`, applied to that level
  have hpg : IsPGroup 2 (↥N ≃ₐ[F] ↥N) := M.proP N hfdN hgalN
  have hdiff : differentIdeal (𝓞 F) (𝓞 ↥N) = ⊤ := M.unramified N hfdN hgalN
  -- the universal property of `M'` embeds it into `M'.K`
  obtain ⟨φ, -⟩ := M'.universal ↥N hpg hdiff
  have hz : (⟨b, hbN⟩ : ↥N) * ⟨b, hbN⟩ = algebraMap F ↥N (x : F) := by
    ext
    simpa using hb
  refine ⟨φ ⟨b, hbN⟩, ?_, ?_⟩
  · intro h
    refine hb0 ?_
    have h1 : (⟨b, hbN⟩ : ↥N) = 0 :=
      RingHom.injective (φ : ↥N →+* M'.K) (by simpa using h)
    exact congrArg (fun y : ↥N => (y : M.K)) h1
  · calc φ ⟨b, hbN⟩ * φ ⟨b, hbN⟩ = φ (⟨b, hbN⟩ * ⟨b, hbN⟩) := by rw [map_mul]
      _ = φ (algebraMap F ↥N (x : F)) := by rw [hz]
      _ = algebraMap F M'.K (x : F) := φ.commutes (x : F)

/-- **The unramified Kummer radical is independent of the chosen maximal unramified pro-`2`
extension**: `VTwoUnramified F M` is the same subgroup of `Fˣ` for every
`M : MaximalUnramifiedProP F 2`, because membership is the existence of a square root in `F_∅`,
and any one of these objects carries exactly the square roots of the elements that become squares
in every one of them (`VTwoUnramified_le_of_maximal` applied in both directions). -/
theorem VTwoUnramified_eq_of_maximal
    {F : Type*} [Field F] [NumberField F]
    (M M' : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2) :
    Work.ShafarevichKoch.VTwoUnramified F M = Work.ShafarevichKoch.VTwoUnramified F M' :=
  le_antisymm (VTwoUnramified_le_of_maximal M M') (VTwoUnramified_le_of_maximal M' M)

end Work.ShafarevichKoch
