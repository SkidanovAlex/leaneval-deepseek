set_option maxHeartbeats 1000000

/-!
# `Work.ShafarevichKoch.ProTwoClosed` -- the pro-`2` (closed) form of the relation bound

The classical Shafarevich--Koch relation count is a theorem about **pro-`2` presentations**: the
literature produces a *continuous* surjection `F̂_d ↠ G_∅` (the free pro-`2` group onto `G_∅`)
whose kernel is *topologically* generated by `r` elements.  The workspace's interface
`HasProTwoPresentation F d r` (`RelationBound.lean`) instead asks for the *abstract* kernel
equality `ker (FreeGroup.lift g) = normalClosure (range w)`, i.e. for a presentation of the
**abstract** dense subgroup `⟨g⟩ ≤ G_∅`.

These two normalisations are *not* the same on the nose, and the difference is not vacuous: the
abstract normal closure `⟪w⟫` can be a proper subgroup of the kernel whose closure it is.  (The
simplest example is `FreeGroup (Fin 1) = ℤ`, the generator `g` of `ℤ/2` and the relation `x⁶`:
`ker = 2ℤ`, `⟪x⁶⟫ = 6ℤ ⊆ 2ℤ`, and `2ℤ = 6ℤ ⊔ (6ℤ ⊔ 4ℤ)`-style *first-order* conditions on the
relations do **not** determine `⟪x⁶⟫`; what fails is precisely the passage from "the relators
generate the kernel modulo the Frattini subgroup" to "they generate the kernel", which needs the
acting group to be a pro-`2` group; see `README.md` §9.)

This module therefore isolates the closed form and **proves that it is equivalent to the abstract
form used by the workspace**, the missing ingredient being *residual `2`-finiteness* of the
presented abstract group -- which is automatic for the abstract form
(`residuallyFiniteTwoGroup_presented`) and is exactly the extra clause that the workspace's own
sound interface `Work.ClassFieldTower.ProTwoPresentationData` carries.

## Main results

* `ClosedRelationData d r g w` -- the topologically-free encoding of "the kernel of
  `FreeGroup (Fin d) → G` is the *closed* normal closure of the `w_i`": the words hold among the
  `g_i`, and every finite `2`-quotient of the free group that kills the `w_i` kills the whole
  kernel.  (The equivalence with `\overline{⟪w⟫} = ker` is the standard description of the
  pro-`2` topology: the closed normal closure is the intersection of the kernels of all finite
  `2`-quotients killing the words.)
* `HasProTwoPresentationClosed F d r` -- the classical (pro-`2`) relation count in this encoding,
  together with residual `2`-finiteness of the presented group.
* **`ker_eq_normalClosure_of_closed`** -- the bridge: residual `2`-finiteness upgrades the closed
  condition to the abstract kernel equality.
* **`hasProTwoPresentation_iff_closed`** -- consequently the two encodings of the relation bound
  are *equivalent*: the abstract interface is neither weaker nor stronger than the classical
  theorem (modulo its built-in residual-finiteness clause).
* `infiniteProTwoExtension_of_hasProTwoPresentationClosed` -- the Golod--Shafarevich conclusion
  from the closed form.
* `kcProTwoPresentationInput_iff_closed` -- the `Kc` instance.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **The closed (pro-`2`) relation condition.**

`ClosedRelationData d r g w` says that the words `w_1,…,w_r` *hold* among `g_1,…,g_d` (each `w_i`
lies in the kernel of `FreeGroup.lift g`) and that they generate the kernel **as a closed normal
subgroup of the pro-`2` completion**: every homomorphism from `FreeGroup (Fin d)` onto a finite
`2`-group which kills all the `w_i` also kills the whole kernel.

This is the topologically-free form of `\overline{⟪w⟫} = ker (FreeGroup.lift g)`, where the closure
is taken in the pro-`2` topology: the closed normal closure of a set `S` is the intersection of the
kernels of the finite `2`-quotients killing `S`. -/
def ClosedRelationData {G : Type*} [Group G] (d r : ℕ) (g : Fin d → G)
    (w : Fin r → FreeGroup (Fin d)) : Prop :=
  (∀ i, w i ∈ MonoidHom.ker (FreeGroup.lift g)) ∧
  (∀ (Q : Type) [Group Q] [Fintype Q], IsPGroup 2 Q → ∀ φ : FreeGroup (Fin d) →* Q,
      (∀ i, φ (w i) = 1) → MonoidHom.ker (FreeGroup.lift g) ≤ MonoidHom.ker φ)

/-- **The pro-`2` (closed) form of the Shafarevich--Koch relation bound.**

There are a maximal unramified pro-`2` extension `F_∅` of `F`, elements `g : Fin d → G_∅`
generating `G_∅` topologically, and `r` words in `d` letters whose *closed* normal closure is the
kernel of `FreeGroup (Fin d) → G_∅` (`ClosedRelationData`); moreover the abstract group presented
by `d` generators and the `r` words is residually a finite `2`-group.

This is the encoding in which the classical theorem (`Sha_∅ ↪ C_∅`, Koch Ch. 11 Thm. 11.3, or
Wingberg's duality) delivers the relation count. -/
def HasProTwoPresentationClosed (F : Type*) [Field F] [NumberField F] (d r : ℕ) : Prop :=
  ∃ (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (g : Fin d → Work.ClassFieldTower.galoisGroup M) (w : Fin r → FreeGroup (Fin d)),
    ClosedRelationData d r g w ∧
    (Subgroup.closure (Set.range g)).topologicalClosure = ⊤ ∧
    Work.ClassFieldTower.ResiduallyFiniteTwoGroup (presentedGroup d r w)

/-- **The closed condition is monotone in the number of relators** (pad by `1`). -/
theorem ClosedRelationData.mono {G : Type*} [Group G] {d r r' : ℕ} {g : Fin d → G}
    {w : Fin r → FreeGroup (Fin d)} (h : ClosedRelationData d r g w) (hr : r ≤ r') :
    ∃ w' : Fin r' → FreeGroup (Fin d), ClosedRelationData d r' g w' := by
  classical
  refine ⟨fun i => if hi : (i : ℕ) < r then w ⟨(i : ℕ), hi⟩ else 1, ?_, ?_⟩
  · intro i
    by_cases hi : (i : ℕ) < r
    · simpa [dite_eq_left hi] using h.1 ⟨(i : ℕ), hi⟩
    · simp [dite_eq_right hi]
  · intro Q _ _ hQ φ hφ
    refine h.2 Q hQ φ ?_
    intro j
    have := hφ ⟨(j : ℕ), lt_of_lt_of_le j.isLt hr⟩
    simpa [dite_eq_left j.isLt] using this

/-- **The bridge from the closed to the abstract form.**

If the words `w` hold among the generators `g` and generate the kernel of `FreeGroup.lift g` only
*modulo its closure* (the closed condition), then -- provided the presented abstract group
`FreeGroup (Fin d) ⧸ ⟪w⟫` is residually a finite `2`-group -- the normal closure of the `w_i` is
already the whole kernel: every finite `2`-quotient of the free group killing the words factors
through the presented group, and residual `2`-finiteness separates the points of the presented
group from `1`. -/
theorem ker_eq_normalClosure_of_closed {d r : ℕ} {G : Type*} [Group G]
    (g : Fin d → G) (w : Fin r → FreeGroup (Fin d))
    (hw : ∀ i, w i ∈ MonoidHom.ker (FreeGroup.lift g))
    (hclosed : ∀ (Q : Type) [Group Q] [Fintype Q], IsPGroup 2 Q → ∀ φ : FreeGroup (Fin d) →* Q,
      (∀ i, φ (w i) = 1) → MonoidHom.ker (FreeGroup.lift g) ≤ MonoidHom.ker φ)
    (hres : Work.ClassFieldTower.ResiduallyFiniteTwoGroup
      (FreeGroup (Fin d) ⧸ Subgroup.normalClosure (Set.range w))) :
    MonoidHom.ker (FreeGroup.lift g) = Subgroup.normalClosure (Set.range w) := by
  have hHle : Subgroup.normalClosure (Set.range w) ≤ MonoidHom.ker (FreeGroup.lift g) :=
    Subgroup.normalClosure_le_normal (by rintro x ⟨i, rfl⟩; exact hw i)
  refine le_antisymm ?_ hHle
  intro x hx
  by_contra hxH
  let H : Subgroup (FreeGroup (Fin d)) := Subgroup.normalClosure (Set.range w)
  haveI : H.Normal := Subgroup.normalClosure_normal
  have hne : (QuotientGroup.mk' H x : FreeGroup (Fin d) ⧸ H) ≠ 1 := fun h =>
    hxH ((QuotientGroup.eq_one_iff (N := H) x).mp h)
  obtain ⟨N, hN, hfin, hpg, hsep⟩ := hres (QuotientGroup.mk' H x) hne
  haveI : N.Normal := hN
  haveI : Finite ((FreeGroup (Fin d) ⧸ H) ⧸ N) := hfin
  haveI : Fintype ((FreeGroup (Fin d) ⧸ H) ⧸ N) := Fintype.ofFinite _
  have hφone : ∀ i : Fin r, ((QuotientGroup.mk' N).comp (QuotientGroup.mk' H)) (w i) = 1 := by
    intro i
    have hmem : w i ∈ H := Subgroup.subset_normalClosure ⟨i, rfl⟩
    have h1 : (QuotientGroup.mk' H) (w i) = 1 :=
      (QuotientGroup.eq_one_iff (N := H) (w i)).mpr hmem
    rw [MonoidHom.comp_apply, h1, map_one]
  exact hsep (hclosed _ hpg _ hφone hx)

/-- **The closed form implies the abstract form.** -/
theorem hasProTwoPresentation_of_closed {F : Type*} [Field F] [NumberField F] {d r : ℕ}
    (h : HasProTwoPresentationClosed F d r) : HasProTwoPresentation F d r := by
  obtain ⟨M, g, w, hdata, hdense, hres⟩ := h
  exact ⟨M, g, w,
    ker_eq_normalClosure_of_closed g w hdata.1 hdata.2 (by simpa [presentedGroup] using hres),
    hdense⟩

/-- **The abstract form implies the closed form.**  The relators generate the kernel, so their
closed normal closure is the kernel, and the presented group is residually a finite `2`-group
(`residuallyFiniteTwoGroup_presented`). -/
theorem hasProTwoPresentationClosed_of_hasProTwoPresentation {F : Type*} [Field F] [NumberField F]
    {d r : ℕ} (h : HasProTwoPresentation F d r) : HasProTwoPresentationClosed F d r := by
  obtain ⟨M, g, w, hker, hdense⟩ := h
  have hw : ∀ i : Fin r, w i ∈ MonoidHom.ker (FreeGroup.lift g) := by
    intro i
    rw [hker]
    exact Subgroup.subset_normalClosure ⟨i, rfl⟩
  refine ⟨M, g, w, ⟨hw, ?_⟩, hdense, ?_⟩
  · intro Q _ _ hQ φ hφ
    rw [hker]
    refine Subgroup.normalClosure_le_normal ?_
    rintro y ⟨i, rfl⟩
    exact MonoidHom.mem_ker.mpr (hφ i)
  · simpa [presentedGroup] using
      (residuallyFiniteTwoGroup_presented F d r M g w hker hdense)

/-- **The two encodings of the Shafarevich--Koch relation bound are equivalent.**

The classical (pro-`2`, closed-kernel) form of the relation count and the workspace's abstract
presentation form are interchangeable: the abstract form is *not* a strictly stronger statement.
The only extra ingredient is residual `2`-finiteness of the presented group, which the abstract
form supplies automatically and which the closed form carries as a clause (it is clause `(2)` of
the workspace's sound interface `Work.ClassFieldTower.ProTwoPresentationData`). -/
theorem hasProTwoPresentation_iff_closed {F : Type*} [Field F] [NumberField F] (d r : ℕ) :
    HasProTwoPresentation F d r ↔ HasProTwoPresentationClosed F d r :=
  ⟨hasProTwoPresentationClosed_of_hasProTwoPresentation,
    hasProTwoPresentation_of_closed⟩

/-- **Golod--Shafarevich from the closed form**: the pro-`2` relation count for `Kc`, plus the
genus level, gives an infinite maximal unramified pro-`2` extension. -/
theorem infiniteProTwoExtension_of_hasProTwoPresentationClosed (F : Type*) [Field F] [NumberField F]
    {r : ℕ} (hgenus : Work.ClassFieldTower.HasGenusLevel F)
    (h : HasProTwoPresentationClosed F 5 r) (hr : r ≤ 6) :
    Work.ClassFieldTower.InfiniteProTwoExtension F :=
  infiniteProTwoExtension_of_hasProTwoPresentation F hgenus (hasProTwoPresentation_of_closed h) hr

/-- **The crux for `Kc`, in the closed form**: `KcProTwoPresentationInput` is equivalent to
`HasProTwoPresentationClosed Kc 5 6`. -/
theorem kcProTwoPresentationInput_iff_closed :
    KcProTwoPresentationInput ↔ HasProTwoPresentationClosed Kc 5 6 := by
  rw [kcProTwoPresentationInput_iff_five_six, hasProTwoPresentation_iff_closed]

/-- The `Kc` conclusion from the closed form. -/
theorem infiniteProTwoExtension_Kc_of_closed (h : HasProTwoPresentationClosed Kc 5 6) :
    Work.ClassFieldTower.InfiniteProTwoExtension Kc :=
  infiniteProTwoExtension_Kc_of_input (kcProTwoPresentationInput_iff_closed.mpr h)

/-- The caller's wall from the closed form. -/
theorem unramifiedPro2TowerWall_of_closed (h : HasProTwoPresentationClosed Kc 5 6) :
    Submission.NumberField.UnramifiedPro2TowerWall :=
  unramifiedPro2TowerWall_of_input (kcProTwoPresentationInput_iff_closed.mpr h)

/-- The root-discriminant tower wall from the closed form. -/
theorem boundedRdTowerWall_of_closed (h : HasProTwoPresentationClosed Kc 5 6) :
    Submission.NumberField.BoundedRdTowerWall :=
  boundedRdTowerWall_of_input (kcProTwoPresentationInput_iff_closed.mpr h)

end Work.ShafarevichKoch
