import Mathlib
import Submission.Work.ShafarevichKoch.Defs
import Submission.Work.ShafarevichKoch.no_sqrt_neg_one_in_maximalUnramified

/-!
# The Kummer datum of `-1` for `Kc = ℚ(√-30030)`

Three statements, all used by the Kummer pairing `VTwo Kc/Fˣ² × ...` of the Shafarevich--Koch
chapter of `Kc`:

* `-1 ∈ VTwo Kc`: the principal fractional ideal `(-1)` is the unit ideal, hence a square;
* `-1` is *not* a square in `Kcˣ` (`neg_one_not_isSquare_Kc`);
* `-1` is *not* a square in `M.K`, the maximal unramified pro-`2` extension of `Kc`
  (`no_sqrt_neg_one_in_maximalUnramified`) -- equivalently, `Kc(√-1)/Kc` is ramified, so `-1`
  does not lie in the Kummer radical `VTwo` lifted to `M.K`.

The point of the last two is that `-1` is a square in `(Kcˣ)²`-free part *at the level of `Kc`*
but not in `M.K`, so it is a nontrivial element of `VTwo Kc ⧸ (Kcˣ)²` whose Kummer character
`χ_{-1}` is *ramified*: this is the "slack" direction of the relation count.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **The principal fractional ideal generated by the unit `-1` of `𝓞 Kc` is the unit ideal.**

Indeed `(-1) = (1)` because `-1` is a unit of `𝓞 Kc`; concretely
`FractionalIdeal.spanSingleton (-1) = FractionalIdeal.spanSingleton 1` for the unit
`-1 ∈ (𝓞 Kc)⁰`. -/
theorem fracIdealOf_neg_one : FracIdealOf Kc (-1 : Kcˣ) = 1 := by
  apply Units.ext
  rw [FracIdealOf, coe_toPrincipalIdeal, Units.val_one]
  rw [← FractionalIdeal.spanSingleton_one (S := nonZeroDivisors (𝓞 Kc)) (R := 𝓞 Kc) (P := Kc)]
  exact (FractionalIdeal.spanSingleton_eq_spanSingleton (S := nonZeroDivisors (𝓞 Kc))).mpr
    ⟨-1, by norm_num⟩

/-- **`-1 ∈ VTwo Kc`**: the principal fractional ideal `(-1)` is the unit ideal, which is a
square. -/
theorem neg_one_mem_VTwo_Kc : (-1 : Kcˣ) ∈ VTwo Kc := by
  rw [mem_VTwo_iff]
  exact ⟨1, by rw [one_mul, fracIdealOf_neg_one]⟩

/-- **`-1` is not a square in `Kcˣ`.**  A square root of `-1` in `Kcˣ` would be a square root of
`-1` in `Kc = ℚ(√-30030)`, which is impossible (`neg_one_not_isSquare_Kc`). -/
theorem neg_one_not_sq_Kc_units : ¬ ∃ y : Kcˣ, (-1 : Kcˣ) = y ^ 2 := by
  rintro ⟨y, hy⟩
  refine neg_one_not_isSquare_Kc ⟨(y : Kc), ?_⟩
  have h := congrArg (fun t : Kcˣ => (t : Kc)) hy
  push_cast at h
  rw [pow_two] at h
  exact h.symm

/-- **`-1` is not a square in the maximal unramified pro-`2` extension `M.K` of `Kc`.**

This is `no_sqrt_neg_one_in_maximalUnramified`: the extension `Kc(√-1)/Kc` is ramified at the
prime above `2`, so `√-1` cannot lie in the unramified extension `M.K`.  Equivalently, the
Kummer character of `-1` (which is defined since `-1 ∈ VTwo Kc`) is not unramified. -/
theorem neg_one_not_sq_MK (M : MaximalUnramifiedProP.{0} Kc 2) :
    ¬ ∃ b : M.K, b * b = algebraMap Kc M.K (-1 : Kc) :=
  no_sqrt_neg_one_in_maximalUnramified M

/-- **The Kummer "slack" datum of `-1` for `Kc = ℚ(√-30030)`.**

`-1` lies in Koch's group `V_∅ = VTwo Kc` (its principal ideal is a square), it is not itself a
square in `Kc`, and its square root `√-1` does not lift to the maximal unramified pro-`2`
extension `M.K`; so `-1` represents a nontrivial, genuinely ramified class in `VTwo Kc ⧸ (Kcˣ)²`,
which is exactly the extra relation counted by the Shafarevich--Koch relation bound. -/
theorem neg_one_kummer_slack_Kc (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} Work.ClassFieldTower.Kc 2) :
    (-1 : Work.ClassFieldTower.Kcˣ) ∈ Work.ShafarevichKoch.VTwo Work.ClassFieldTower.Kc ∧
      (¬ (∃ y : Work.ClassFieldTower.Kcˣ, (-1 : Work.ClassFieldTower.Kcˣ) = y ^ 2)) ∧
      (¬ (∃ b : M.K, b * b = algebraMap Work.ClassFieldTower.Kc M.K (-1 : Work.ClassFieldTower.Kc))) :=
  ⟨neg_one_mem_VTwo_Kc, neg_one_not_sq_Kc_units, neg_one_not_sq_MK M⟩

end Work.ShafarevichKoch
