import Mathlib
import Submission.Work.ShafarevichKoch.SupportedInertia
import Submission.Work.ShafarevichKoch.fixingSubgroup_le_iSup_inertia

/-!
# `Work.ShafarevichKoch.SupportedInertiaGeneration` -- the finite-level inertia theorem

The two halves of the finite-level inertia-generation theorem (README §16.6--§16.9),

* `Work.ShafarevichKoch.iSup_inertia_le_fixingSubgroup` (`Submission.Work.ShafarevichKoch.SupportedInertia`),
  the inclusion `⨆ I_P ≤ Gal(L/N)`, using only `N`'s unramifiedness;
* `Work.ShafarevichKoch.fixingSubgroup_le_iSup_inertia`
  (`Submission.Work.ShafarevichKoch.fixingSubgroup_le_iSup_inertia`), the converse, which needs
  `N`'s maximality,

assemble into the theorem itself:

> for a finite Galois extension `L/F` of number fields whose relative different is supported on a
> finite set `S` of rational primes, and for `N ≤ L` the maximal Galois intermediate field with
> trivial relative different,
> `N.fixingSubgroup = ⨆ P, Ideal.inertia (L ≃ₐ[F] L) P`, the supremum over the *prime* ideals `P`
> of `𝓞 L` lying over the primes in `S`.

This is the classical statement that the maximal unramified subextension of an `S`-ramified Galois
extension is the fixed field of the subgroup generated by the inertia groups of the primes above
`S`; it is the finite-level input of item (ii) of the counting route (README §16.3), whose
pro-finite passage to `H_S = Gal(k_S/k_∅)` is the remaining step.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option autoImplicit false

noncomputable section

open scoped NumberField
open NumberField

namespace Work.ShafarevichKoch

/-- **The finite-level inertia-generation theorem** (see the module docstring). -/
theorem fixingSubgroup_eq_iSup_inertia {F L : Type} [Field F] [Field L] [Algebra F L]
    [NumberField F] [NumberField L] [FiniteDimensional F L] [IsGalois F L] (S : Finset ℕ)
    (hsupp : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime → P ≠ ⊥ →
      P ∣ differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L) →
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (N : IntermediateField F L) [FiniteDimensional F ↥N] [IsGalois F ↥N] [NumberField ↥N]
    (hN : differentIdeal (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers ↥N) = ⊤)
    (hmax : ∀ (K : IntermediateField F L) [FiniteDimensional F ↥K] [IsGalois F ↥K]
      [NumberField ↥K], differentIdeal (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers ↥K) = ⊤ → K ≤ N) :
    N.fixingSubgroup =
      ⨆ (P : {P : Ideal (NumberField.RingOfIntegers L) // P.IsPrime ∧
          ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}),
        Ideal.inertia (L ≃ₐ[F] L) P.1 :=
  le_antisymm (fixingSubgroup_le_iSup_inertia S hsupp N hN hmax)
    (iSup_inertia_le_fixingSubgroup S N hN)

end Work.ShafarevichKoch
