import Mathlib
import Submission.Work.ShafarevichKoch.Gaschutz.RelModule
import Submission.Work.ShafarevichKoch.Gaschutz.exists_mulEquiv_pi_zmodTwo_of_natCard_le

/-!
# `Work.ShafarevichKoch.Gaschutz.exists_words_spanning_of_relFrattiniIn_card`

**Namespace** `Work.ShafarevichKoch.Gaschutz`; module
`Submission.Work.ShafarevichKoch.Gaschutz.exists_words_spanning_of_relFrattiniIn_card`.

The *extraction* half of the relation-rank dictionary: if the relation-Frattini quotient
`K ⧸ K²[K,F]` of the kernel `K = ker (FreeGroup.lift g)` of the presentation map is an
elementary abelian `2`-group of order `2 ^ k` with `k ≤ r`, then `K` is generated modulo
`K²[K,F]` by `r` words, i.e. there are `w : Fin r → FreeGroup (Fin d)` with `w i ∈ K` and

  `K ≤ Subgroup.normalClosure (Set.range w) ⊔ relFrattini 2 K`.

This is the direction which turns a *bound on the relation rank* -- a cardinality statement about
`K ⧸ K²[K,F]` -- into the honest spanning statement that the Golod--Shafarevich engine and the
Shafarevich--Koch reconstruction consume; the converse counting direction is
`Work.ShafarevichKoch.card_relFrattiniQuotient_le_of_le_normalClosure_sup`.

## The proof

`V := K ⧸ K²[K,F]` is (i) finite, because its cardinality is `2 ^ k`, (ii) commutative, because
`[K,K] ≤ [K,F] ≤ K²[K,F]`, and (iii) of exponent dividing `2`, because `K² ≤ K²[K,F]`.  Hence
`Additive V` is a finite-dimensional `𝔽₂`-vector space, whose dimension `n` satisfies
`2 ^ n = |V| ≤ 2 ^ r`, so `n ≤ r`.  Taking the first `n` vectors of an `𝔽₂`-basis of `Additive V`
(and `0` above that) produces a family `v : Fin r → V` whose subgroup closure is everything: every
element of `V` is a finite `ℤ`-linear combination of basis vectors (`Basis.sum_repr`), each term of
which is an `ℕ`-multiple of a basis vector and hence lies in the closure.

Each `v i` lifts to `w i ∈ K`, and the image of `Subgroup.normalClosure (Set.range w)` under the
quotient map `q : K →* V` is `Subgroup.closure (Set.range v) = ⊤`: conjugation by the ambient free
group acts trivially on `V` (`[K,F] ≤ K²[K,F]`).  Since `ker q = K²[K,F]` is contained in the
subgroup generated by the `w i`, the preimage argument `eq_top_of_map_eq_top_of_ker_le` concludes
`K ≤ Subgroup.normalClosure (Set.range w) ⊔ relFrattini 2 K`.
-/

set_option linter.style.haveILetI false

open scoped commutatorElement

namespace Work.ShafarevichKoch.Gaschutz

/-- **A spanning family of prescribed length from the cardinality of a finite group of exponent
two.**  If `V` is a finite commutative group of exponent dividing `2` with `|V| ≤ 2 ^ r`, then `V`
is generated by `r` elements.

`Additive V` is an `𝔽₂`-vector space of dimension `n` with `2 ^ n = |V| ≤ 2 ^ r`, hence `n ≤ r`;
the family is the first `n` basis vectors followed by the identity. -/
private lemma exists_family_closure_eq_top_of_card_le {V : Type*} [Group V] [Fintype V]
    (hcomm : ∀ x y : V, x * y = y * x) (h2 : ∀ x : V, x ^ 2 = 1) {r : ℕ}
    (hcard : Nat.card V ≤ 2 ^ r) :
    ∃ v : Fin r → V, Subgroup.closure (Set.range v) = ⊤ := by
  classical
  letI : CommGroup V := { ‹Group V› with mul_comm := hcomm }
  have hzero : ∀ x : Additive V, (2 : ℕ) • x = 0 := fun x => h2 x
  letI : Module (ZMod 2) (Additive V) := AddCommGroup.zmodModule hzero
  haveI : Module.Finite (ZMod 2) (Additive V) := Module.Finite.of_finite
  let b := Module.finBasis (ZMod 2) (Additive V)
  -- the dimension is at most `r`
  have hn : Module.finrank (ZMod 2) (Additive V) ≤ r := by
    have hcardb : Nat.card (Additive V) = 2 ^ Module.finrank (ZMod 2) (Additive V) := by
      rw [Nat.card_eq_fintype_card, Module.card_fintype b, ZMod.card, Fintype.card_fin]
    have hk : 2 ^ Module.finrank (ZMod 2) (Additive V) ≤ 2 ^ r := by
      rw [← hcardb]
      exact hcard
    exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hk
  -- the family: the first `n` basis vectors, completed by `0`
  let f : Fin r → Additive V :=
    fun i => if h : (i : ℕ) < Module.finrank (ZMod 2) (Additive V) then b ⟨i, h⟩ else 0
  have hA : AddSubgroup.closure (Set.range f) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [← b.sum_repr x]
    refine AddSubgroup.sum_mem _ (fun j _ => ?_)
    have hb : b j ∈ Set.range f := by
      refine ⟨⟨j.1, lt_of_lt_of_le j.2 hn⟩, ?_⟩
      simp only [f]
      rw [dite_eq_left j.2]
    rw [← ZMod.natCast_zmod_val (b.repr x j), Nat.cast_smul_eq_nsmul]
    exact AddSubgroup.nsmul_mem _ (AddSubgroup.subset_closure hb) _
  -- transport the additive statement to `V`
  refine ⟨fun i => Additive.toMul (f i), ?_⟩
  have hT : Additive.toMul ⁻¹' Set.range (fun i => Additive.toMul (f i)) = Set.range f := by
    ext y; simp [Set.mem_range]
  have hsub : (Subgroup.closure (Set.range (fun i => Additive.toMul (f i)))).toAddSubgroup = ⊤ := by
    rw [Subgroup.toAddSubgroup_closure, hT, hA]
  exact Subgroup.toAddSubgroup.injective
    (hsub.trans (OrderIso.map_top (Subgroup.toAddSubgroup)).symm)

/-- **A subgroup which maps onto the whole quotient already contains the kernel.**  If `f : G →* H`
and `M ≤ G` satisfies `f.ker ≤ M` and `M.map f = ⊤`, then `M = ⊤`. -/
private lemma eq_top_of_map_eq_top_of_ker_le {G H : Type*} [Group G] [Group H] (f : G →* H)
    (M : Subgroup G) (hker : f.ker ≤ M) (hmap : M.map f = ⊤) : M = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx : f x ∈ M.map f := by rw [hmap]; trivial
  obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp hx
  have hmem : m⁻¹ * x ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hmx, inv_mul_cancel]
  have h2 : m⁻¹ * x ∈ M := hker hmem
  have hx' : x = m * (m⁻¹ * x) := by group
  rw [hx']
  exact M.mul_mem hm h2

/-- **The extraction statement for an abstract normal subgroup.**  If `K ⊴ F` and the
relation-Frattini quotient `K ⧸ K²[K,F]` has cardinality `2 ^ k` with `k ≤ r`, then there are `r`
elements of `K` whose normal closure, together with `K²[K,F]`, is all of `K`. -/
private lemma exists_words_spanning_of_relFrattini_card {F : Type*} [Group F] (K : Subgroup F)
    [K.Normal] {k r : ℕ} (hk : k ≤ r)
    (hcard : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) = 2 ^ k) :
    ∃ w : Fin r → F, (∀ i, w i ∈ K) ∧
      K ≤ Subgroup.normalClosure (Set.range w) ⊔ Work.HopfGaschutz.relFrattini 2 K := by
  classical
  haveI : Finite (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) :=
    Nat.finite_of_card_ne_zero (by rw [hcard]; exact pow_ne_zero _ (by norm_num))
  haveI : Fintype (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) := Fintype.ofFinite _
  -- the quotient is commutative ...
  have hcomm : ∀ x y : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) y
    rw [← commutatorElement_eq_one_iff_mul_comm]
    rw [← map_commutatorElement (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) a b]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_commutatorElement (Subgroup.subtype K) a b]
    exact Work.HopfGaschutz.commutator_mem_relFrattini 2 K a.2
  -- ... and of exponent dividing two
  have hsq : ∀ x : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x ^ 2 = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (a ^ 2) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_pow]
    exact Work.HopfGaschutz.pow_mem_relFrattini 2 K a.2
  obtain ⟨v, hv⟩ := exists_family_closure_eq_top_of_card_le (r := r) hcomm hsq
    (by rw [hcard]; exact Nat.pow_le_pow_right (by norm_num) hk)
  -- lift the generators of the quotient to elements of `K`
  choose w' hw' using fun i =>
    QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) (v i)
  refine ⟨fun i => (w' i : F), fun i => (w' i).2, ?_⟩
  set N : Subgroup F := Subgroup.normalClosure (Set.range fun i => (w' i : F)) with hN
  haveI : N.Normal := Subgroup.normalClosure_normal
  -- the images of the `w' i` generate the quotient
  have hcl : Subgroup.closure (Set.range w') ≤
      (N ⊔ Work.HopfGaschutz.relFrattini 2 K).subgroupOf K := by
    rw [Subgroup.closure_le]
    rintro x ⟨i, rfl⟩
    refine Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_left ?_)
    exact Subgroup.subset_normalClosure (Set.mem_range_self i)
  have h1 : Subgroup.map (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K))
      (Subgroup.closure (Set.range w')) = ⊤ := by
    rw [MonoidHom.map_closure]
    have hset : (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) '' Set.range w'
        = Set.range v := by
      ext y
      constructor
      · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
        exact ⟨i, (hw' i).symm⟩
      · rintro ⟨i, rfl⟩
        exact ⟨w' i, ⟨i, rfl⟩, hw' i⟩
    rw [hset]
    exact hv
  -- conclude
  have htop : (N ⊔ Work.HopfGaschutz.relFrattini 2 K).subgroupOf K = ⊤ := by
    refine eq_top_of_map_eq_top_of_ker_le (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K))
      ((N ⊔ Work.HopfGaschutz.relFrattini 2 K).subgroupOf K) ?_ ?_
    · intro x hx
      rw [QuotientGroup.ker_mk'] at hx
      exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right hx)
    · rw [eq_top_iff]
      exact le_trans (le_of_eq h1.symm) (Subgroup.map_mono hcl)
  exact Subgroup.subgroupOf_eq_top.mp htop

/-- **Extraction of a spanning family from the order of the relation-Frattini quotient.**

Let `K = MonoidHom.ker (FreeGroup.lift g)` be the kernel of the presentation map induced by a family
`g : Fin d → Γ`.  If the relation-Frattini quotient `K ⧸ K²[K,FreeGroup (Fin d)]` has order `2 ^ k`
with `k ≤ r`, then there are `r` words in `K` whose normal closure, together with `K²[K,F]`, is all
of `K`. -/
theorem exists_words_spanning_of_relFrattiniIn_card {d r : ℕ} {Γ : Type*} [Group Γ]
    (g : Fin d → Γ) {k : ℕ} (hk : k ≤ r)
    (hcard : Nat.card (MonoidHom.ker (FreeGroup.lift g) ⧸
        Work.HopfGaschutz.relFrattiniIn 2 (MonoidHom.ker (FreeGroup.lift g))) = 2 ^ k) :
    ∃ w : Fin r → FreeGroup (Fin d),
      (∀ i, w i ∈ MonoidHom.ker (FreeGroup.lift g)) ∧
      MonoidHom.ker (FreeGroup.lift g) ≤
        Subgroup.normalClosure (Set.range w) ⊔
          Work.HopfGaschutz.relFrattini 2 (MonoidHom.ker (FreeGroup.lift g)) := by
  haveI : (MonoidHom.ker (FreeGroup.lift g)).Normal := MonoidHom.normal_ker _
  exact exists_words_spanning_of_relFrattini_card (K := MonoidHom.ker (FreeGroup.lift g)) hk hcard

end Work.ShafarevichKoch.Gaschutz
