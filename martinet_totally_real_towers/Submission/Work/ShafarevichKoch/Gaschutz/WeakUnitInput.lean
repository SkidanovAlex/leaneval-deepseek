import Mathlib
import Submission.Work.ShafarevichKoch.UnitHalf.kcProTwoPresentationInput_of_unitDuality
import Submission.Work.ShafarevichKoch.KcCohomology
import Submission.Work.ShafarevichKoch.Gaschutz.Kc
import Submission.Work.ShafarevichKoch.CountZ

/-!
# `Work.ShafarevichKoch.Gaschutz.WeakUnitInput` -- the *weakest* form of the remaining input

The chapter's crux `KcProTwoPresentationInput` is, by `Gaschutz/Card.lean` and `Crux.lean`,
equivalent to the single cardinality statement `#H²(G_∅,𝔽₂) ≤ 2^6`.  The chapter proves
unconditionally that

```
#H²(G_∅,𝔽₂) = #(H²(G_∅,ℤ) / 2 H²(G_∅,ℤ)) · #H³(G_∅,ℤ)[2]
```

(`Work.ShafarevichKoch.natCard_H2_zmodTwo_eq`) and, with no class field theory at all, the `H²`-half

```
#(H²(G_∅,ℤ) / 2 H²(G_∅,ℤ)) ≤ 2^5 = 2^{d(G_∅)}
```

(`Work.ShafarevichKoch.H2Half.natCard_H2Z_quot_two_le_pow_five_Kc`).  Hence the *entire* remaining
arithmetic content of the relation bound is the `H³`-half:

```
#H³(G_∅,ℤ)[2] ≤ 2      (equivalently  dim_{𝔽₂} Br(K_∅/Kc)[2] ≤ 1 ),
```

i.e. the classical statement that the relation module of `G_∅` is generated by the single relation
coming from the unit `-1` of `Kc` (Wingberg's duality / Koch's theorem; Hajir--Maire--Ramakrishna
arXiv:2103.09508: `df(G_∅) = d₂(E_Kc / N E_{K_∅}) ≤ d₂(E_Kc) = 1`).

This module records the implication in that sharpened form, so that a future session knows the
*weakest* statement it has to prove: finiteness of `H³(G_∅,ℤ)` together with the bound `≤ 2` on its
`2`-torsion (the chapter's earlier inputs `WingbergDuality` and `WingbergUnitDuality` are
*stronger*: they identify the Pontryagin dual of `H³` with a quotient of `(𝓞 Kc)ˣ`).

## Main declarations

* `Work.ShafarevichKoch.contH2DimLe_six_of_twoTorsionH3_le_two` -- the `H³`-half of the count gives
  `dim_{𝔽₂} H²_cont(G_∅,𝔽₂) ≤ 6`;
* `Work.ShafarevichKoch.kcProTwoPresentationInput_of_twoTorsionH3_le_two` -- with the chapter's
  Gaschütz input, the crux;
* `Work.ShafarevichKoch.boundedRdTowerWall_of_twoTorsionH3_le_two` and its siblings -- the walls.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

open scoped Classical
open scoped NumberField

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **The `H³`-half of the relation count, in its weakest form.**  If `H³(G_∅,ℤ)` is finite and
its `2`-torsion has at most `2` elements, then `dim_{𝔽₂} H²_cont(G_∅,𝔽₂) ≤ 6`.

The argument is the chapter's: `#H²(G_∅,𝔽₂) = #(H²(G_∅,ℤ)/2H²(G_∅,ℤ)) · #H³(G_∅,ℤ)[2]`
(`natCard_H2_zmodTwo_eq`), the first factor is `≤ 2^5` unconditionally
(`H2Half.natCard_H2Z_quot_two_le_pow_five_Kc`), and `H²(G_∅,𝔽₂)` is an `𝔽₂`-vector space, so its
cardinality `≤ 2^6` is its `𝔽₂`-dimension bound. -/
theorem contH2DimLe_six_of_twoTorsionH3_le_two
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} Work.ClassFieldTower.Kc 2)
    (hfin2 : Finite (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hfin3 : Finite (Work.ShafarevichKoch.H3 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hB : Nat.card (Work.ShafarevichKoch.twoTorsionH3 (Work.ClassFieldTower.galoisGroup M)) ≤ 2) :
    Work.RelatorRank.ContH2DimLe (Work.ClassFieldTower.galoisGroup M) 6 := by
  haveI hfin2' : Finite (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ) := hfin2
  haveI hfin3' : Finite (Work.ShafarevichKoch.H3 (Work.ClassFieldTower.galoisGroup M) ℤ) := hfin3
  -- the unconditional `H²`-half
  have hA : Nat.card (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ ⧸
      Work.ShafarevichKoch.twoMulH2 (Work.ClassFieldTower.galoisGroup M)) ≤ 2 ^ 5 :=
    Work.ShafarevichKoch.H2Half.natCard_H2Z_quot_two_le_pow_five_Kc M
  -- the cardinality bound `#H²(G_∅,𝔽₂) ≤ 2^6`
  have hcard : Nat.card (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) (ZMod 2)) ≤ 2 ^ 6 :=
    Work.ShafarevichKoch.natCard_H2_zmodTwo_le (G := Work.ClassFieldTower.galoisGroup M) hA hB
  -- `H²(G_∅,𝔽₂)` is finite
  haveI hfin : Finite (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) (ZMod 2)) := by
    have hceq := Work.ShafarevichKoch.natCard_H2_zmodTwo_eq
      (G := Work.ClassFieldTower.galoisGroup M)
    haveI : Fintype (Work.ShafarevichKoch.H3 (Work.ClassFieldTower.galoisGroup M) ℤ) :=
      Fintype.ofFinite _
    have hne1 : Nat.card (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ ⧸
        Work.ShafarevichKoch.twoMulH2 (Work.ClassFieldTower.galoisGroup M)) ≠ 0 :=
      Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
    haveI : Finite (Work.ShafarevichKoch.twoTorsionH3 (Work.ClassFieldTower.galoisGroup M)) :=
      Finite.of_injective Subtype.val Subtype.val_injective
    have hne2 : Nat.card (Work.ShafarevichKoch.twoTorsionH3 (Work.ClassFieldTower.galoisGroup M)) ≠ 0 :=
      Nat.card_ne_zero.mpr ⟨⟨0, by simp⟩, inferInstance⟩
    exact Nat.finite_of_card_ne_zero (by rw [hceq]; exact Nat.mul_ne_zero hne1 hne2)
  -- `H²(G_∅,𝔽₂)` is an `𝔽₂`-vector space, so `# = 2 ^ finrank` and the bound `≤ 2^6` is a
  -- bound on `finrank`
  have hexp : ∀ x : Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M),
      (2 : ℕ) • x = 0 := by
    intro x
    letI := Work.RelatorRank.f2TrivialAction (Work.ClassFieldTower.galoisGroup M)
    letI : Work.ConCohomology.IsDiscreteGModule
        (Work.ClassFieldTower.galoisGroup M) (ZMod 2) :=
      Work.RelatorRank.f2Discrete (Work.ClassFieldTower.galoisGroup M)
    obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective
      (Work.ConCohomology.B2' (Work.ClassFieldTower.galoisGroup M) (ZMod 2)) x
    rw [← map_nsmul]
    rw [show (2 : ℕ) • z = 0 from by
          refine Subtype.ext ?_
          ext p
          show (2 : ℕ) • (z.1 p) = 0
          exact CharTwo.two_nsmul _,
      map_zero]
  letI : Module (ZMod 2) (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)) :=
    AddCommGroup.zmodModule (n := 2) hexp
  haveI : Module.Finite (ZMod 2)
      (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)) := Module.Finite.of_finite
  have hcardfin : Nat.card (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)) =
      2 ^ Module.finrank (ZMod 2)
        (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)) := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
  refine ⟨Module.finrank (ZMod 2)
    (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)), ?_, hcardfin⟩
  have : 2 ^ Module.finrank (ZMod 2)
      (Work.RelatorRank.contH2 (Work.ClassFieldTower.galoisGroup M)) ≤ 2 ^ 6 := by
    rw [← hcardfin]
    exact hcard
  exact (Nat.pow_le_pow_iff_right (by norm_num)).mp this

/-- **The crux from the weakest form of the unit input** (and the chapter's Gaschütz input): the
finiteness of `H³(G_∅,ℤ)` and the bound `#H³(G_∅,ℤ)[2] ≤ 2` imply `KcProTwoPresentationInput`. -/
theorem kcProTwoPresentationInput_of_twoTorsionH3_le_two
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} Work.ClassFieldTower.Kc 2)
    (hdict : Work.RelatorRank.GaschutzCohomologicalValue (Work.ClassFieldTower.galoisGroup M))
    (hfin2 : Finite (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hfin : Finite (Work.ShafarevichKoch.H3 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hB : Nat.card (Work.ShafarevichKoch.twoTorsionH3 (Work.ClassFieldTower.galoisGroup M)) ≤ 2) :
    KcProTwoPresentationInput :=
  Work.ShafarevichKoch.kcProTwoPresentationInput_of_contH2DimLe M hdict
    (contH2DimLe_six_of_twoTorsionH3_le_two M hfin2 hfin hB)

/-- **The walls, from the same weakest input.** -/
theorem boundedRdTowerWall_of_twoTorsionH3_le_two
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} Work.ClassFieldTower.Kc 2)
    (hdict : Work.RelatorRank.GaschutzCohomologicalValue (Work.ClassFieldTower.galoisGroup M))
    (hfin2 : Finite (Work.ConCohomology.H2 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hfin : Finite (Work.ShafarevichKoch.H3 (Work.ClassFieldTower.galoisGroup M) ℤ))
    (hB : Nat.card (Work.ShafarevichKoch.twoTorsionH3 (Work.ClassFieldTower.galoisGroup M)) ≤ 2) :
    Submission.NumberField.BoundedRdTowerWall :=
  boundedRdTowerWall_of_input
    (kcProTwoPresentationInput_of_twoTorsionH3_le_two M hdict hfin2 hfin hB)

end Work.ShafarevichKoch
