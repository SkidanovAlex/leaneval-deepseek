import Mathlib

namespace Work.ShafarevichKoch.Gaschutz

/-- A finite commutative group of exponent two that is generated by `r` elements has at most
`2 ^ r` elements. -/
theorem natCard_le_two_pow_of_closure_eq_top {V : Type*} [CommGroup V] [Fintype V]
    (h2 : ∀ x : V, x ^ 2 = 1) {r : ℕ} (v : Fin r → V) (hgen : Subgroup.closure (Set.range v) = ⊤) :
    Nat.card V ≤ 2 ^ r := by
  classical
  -- Every product of a subset of the generators, indexed by a `Bool`-valued function on `Fin r`.
  let φ : (Fin r → Bool) → V := fun f => ∏ i, (if f i then v i else 1)
  -- Pointwise computation: the product map is multiplicative with respect to pointwise xor.
  have hpt : ∀ (f g : Fin r → Bool) (i : Fin r),
      (if f i then v i else 1) * (if g i then v i else 1) = (if (f i != g i) then v i else 1) := by
    intro f g i
    cases hf : f i <;> cases hg : g i <;> simp_all [← pow_two]
  have hφmul : ∀ f g : Fin r → Bool, φ f * φ g = φ (fun i => (f i != g i)) := by
    intro f g
    simp only [φ]
    rw [← Finset.prod_mul_distrib]
    exact Finset.prod_congr rfl (fun i _ => hpt f g i)
  have hφone : φ (fun _ => false) = 1 := by simp [φ]
  have hφsq : ∀ f, φ f * φ f = 1 := by
    intro f
    rw [hφmul]
    have : (fun i => (f i != f i)) = (fun _ => false) := funext fun i => bne_self_eq_false (f i)
    rw [this, hφone]
  -- The image of `φ` is a subgroup of `V` containing all the generators, hence everything.
  let S : Subgroup V :=
    { carrier := Set.range φ
      mul_mem' := by
        rintro _ _ ⟨f, rfl⟩ ⟨g, rfl⟩
        exact ⟨fun i => f i != g i, (hφmul f g).symm⟩
      one_mem' := ⟨fun _ => false, hφone⟩
      inv_mem' := by
        rintro _ ⟨f, rfl⟩
        exact ⟨f, (mul_eq_one_iff_eq_inv.mp (hφsq f))⟩ }
  have hS : S = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← hgen, Subgroup.closure_le]
    intro x hx
    rcases hx with ⟨i, rfl⟩
    exact ⟨fun j => decide (j = i), by simp [φ, Finset.prod_ite_eq']⟩
  have hsurj : Function.Surjective φ := fun x => by
    have hx : x ∈ S := by rw [hS]; exact Subgroup.mem_top x
    exact Set.mem_range.mp hx
  calc Nat.card V = Fintype.card V := Nat.card_eq_fintype_card
    _ ≤ Fintype.card (Fin r → Bool) := Fintype.card_le_of_surjective φ hsurj
    _ = 2 ^ r := by rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]

end Work.ShafarevichKoch.Gaschutz
