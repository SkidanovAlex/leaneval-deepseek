import Mathlib
import Submission.Work.ShafarevichKoch.Gaschutz.RelModule
import Submission.Work.ShafarevichKoch.Gaschutz.natCard_le_two_pow_of_closure_eq_top
import Submission.Work.ShafarevichKoch.Gaschutz.exists_mulEquiv_pi_zmodTwo_of_natCard_le

/-!
# `Work.ShafarevichKoch.Gaschutz.natCard_relFrattiniQuotient_eq_two_pow_of_spanning`

The relation-Frattini quotient `K ⧸ K²[K,F]` of a normal subgroup `K ⊴ F` which is generated
modulo `K²[K,F]` by `r` words is a finite elementary abelian `2`-group of order `2 ^ k` with
`k ≤ r`.

The two ingredients are proved in the two auxiliary declarations of this file:

* `closure_mk_relFrattiniIn_eq_top` -- the **generation** step: if `K ≤ ⟪w⟫ · K²[K,F]` then the
  images of the `w i` generate `K ⧸ K²[K,F]`; the proof replaces `⟪w⟫` by `⟨w⟩` (the commutators
  `⁅w i, c⁆` all lie in `K²[K,F]`) and then uses that in the abelian quotient conjugation acts
  trivially, so that the image of the normal closure is the image of the plain closure;
* `exists_pow_card_of_spanning` -- the **counting** step, which combines the generation step with
  `Work.ShafarevichKoch.Gaschutz.natCard_le_two_pow_of_closure_eq_top` and
  `Work.ShafarevichKoch.Gaschutz.exists_mulEquiv_pi_zmodTwo_of_natCard_le`.

The requested statement is the special case `F = FreeGroup (Fin d)`, `K = ker (FreeGroup.lift g)`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

open scoped commutatorElement
open Work.HopfGaschutz

namespace Work.ShafarevichKoch.Gaschutz

/-- **The images of words generating `K` modulo `K²[K,F]` generate the relation-Frattini
quotient.**

Let `K ⊴ F` be a normal subgroup and `w : ι → K` a family of elements of `K` with
`K ≤ ⟪w⟫ · K²[K,F]`.  Then the images of the `w i` in `K ⧸ K²[K,F]` generate the whole quotient.

The two steps are

* `K ≤ ⟨w⟩ · K²[K,F]`: the normal closure `⟪w⟫` is generated by the conjugates `c * w i * c⁻¹`;
  since `c * w i * c⁻¹ = ⁅c, w i⁆ * w i` and `⁅c, w i⁆ = ⁅w i, c⁆⁻¹ ∈ ⁅K,F⁆ ≤ K²[K,F]`, the
  normal closure is contained in `⟨w⟩ · K²[K,F]`;
* in `K ⧸ K²[K,F]` the commutator subgroup dies, so the quotient of the normal closure is the
  quotient of the plain closure `⟨w⟩`, which is generated by the images of the `w i`. -/
theorem closure_mk_relFrattiniIn_eq_top {F : Type*} [Group F] {K : Subgroup F} [K.Normal]
    {ι : Type*} (w : ι → K)
    (hspan : K ≤ Subgroup.normalClosure (Set.range fun i => (w i : F)) ⊔
      Work.HopfGaschutz.relFrattini 2 K) :
    Subgroup.closure (Set.range fun i =>
      (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (w i)) = ⊤ := by
  classical
  haveI : (Work.HopfGaschutz.relFrattiniIn 2 K).Normal :=
    Work.HopfGaschutz.relFrattiniIn_normal 2 K
  set T : Subgroup F := Subgroup.closure (Set.range fun i => (w i : F)) with hT
  have hT_le : T ≤ K := by
    rw [hT]
    exact (Subgroup.closure_le K).mpr (by rintro x ⟨i, rfl⟩; exact (w i).2)
  have hR_le : Work.HopfGaschutz.relFrattini 2 K ≤ K :=
    Work.HopfGaschutz.relFrattini_le 2 K
  -- every conjugate of a generator lies in `T ⊔ K²[K,F]`
  have hconj : Group.conjugatesOfSet (Set.range fun i => (w i : F)) ⊆
      (T ⊔ Work.HopfGaschutz.relFrattini 2 K : Subgroup F) := by
    intro x hx
    obtain ⟨y, ⟨i, rfl⟩, hc⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨c, rfl⟩ := isConj_iff.mp hc
    have h1 : ⁅(w i : F), c⁆ ∈ Work.HopfGaschutz.relFrattini 2 K :=
      Work.HopfGaschutz.commutator_mem_relFrattini 2 K (w i).2
    have h2 : ⁅c, (w i : F)⁆ ∈ Work.HopfGaschutz.relFrattini 2 K := by
      rw [show ⁅c, (w i : F)⁆ = ⁅(w i : F), c⁆⁻¹ from by
        rw [commutatorElement_def, commutatorElement_def]; group]
      exact Subgroup.inv_mem _ h1
    have h3 : (w i : F) ∈ T := by
      rw [hT]; exact Subgroup.subset_closure ⟨i, rfl⟩
    have h4 : ⁅c, (w i : F)⁆ * (w i : F) ∈ T ⊔ Work.HopfGaschutz.relFrattini 2 K :=
      (T ⊔ Work.HopfGaschutz.relFrattini 2 K).mul_mem
        (Subgroup.mem_sup_right h2) (Subgroup.mem_sup_left h3)
    rwa [show ⁅c, (w i : F)⁆ * (w i : F) = c * (w i : F) * c⁻¹ from by
      rw [commutatorElement_def]; group] at h4
  have hM_le : Subgroup.normalClosure (Set.range fun i => (w i : F)) ≤
      T ⊔ Work.HopfGaschutz.relFrattini 2 K :=
    (Subgroup.closure_le _).mpr hconj
  have hK_le : K ≤ T ⊔ Work.HopfGaschutz.relFrattini 2 K := by
    have h1 : K ≤ (T ⊔ Work.HopfGaschutz.relFrattini 2 K) ⊔
        Work.HopfGaschutz.relFrattini 2 K :=
      hspan.trans (sup_le_sup hM_le le_rfl)
    rwa [sup_assoc, sup_idem] at h1
  have hTRe : T ⊔ Work.HopfGaschutz.relFrattini 2 K = K :=
    le_antisymm (sup_le hT_le hR_le) hK_le
  -- the images of the generators of `T` lie in the subgroup generated by the `w i`
  have key : ∀ t ∈ T, ∀ (ht : t ∈ K),
      (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K) ⟨t, ht⟩ :
        K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ∈
        Subgroup.closure (Set.range fun i =>
          (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (w i)) := by
    intro t htT ht
    revert ht
    refine Subgroup.closure_induction (k := Set.range fun i => (w i : F))
      (p := fun y _ => ∀ (hy : y ∈ K),
        (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K) ⟨y, hy⟩ :
          K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ∈
          Subgroup.closure (Set.range fun i =>
            (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (w i)))
      ?_ ?_ ?_ ?_ htT
    · rintro x ⟨i, rfl⟩ hy
      have heq : (⟨(w i : F), hy⟩ : K) = w i := Subtype.ext rfl
      rw [heq]
      exact Subgroup.subset_closure ⟨i, rfl⟩
    · intro hy
      have heq : (⟨1, hy⟩ : K) = 1 := Subtype.ext rfl
      rw [heq, map_one]
      exact Subgroup.one_mem _
    · intro x y hx hy ihx ihy hxy
      have hxK : x ∈ K := hT_le hx
      have hyK : y ∈ K := hT_le hy
      have heq : (⟨x * y, hxy⟩ : K) = ⟨x, hxK⟩ * ⟨y, hyK⟩ := Subtype.ext rfl
      rw [heq, map_mul]
      exact Subgroup.mul_mem _ (ihx hxK) (ihy hyK)
    · intro x hx ih hxinv
      have hxK : x ∈ K := hT_le hx
      have heq : (⟨x⁻¹, hxinv⟩ : K) = (⟨x, hxK⟩ : K)⁻¹ := Subtype.ext rfl
      rw [heq, map_inv]
      exact Subgroup.inv_mem _ (ih hxK)
  refine eq_top_iff.mpr ?_
  intro x _
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
  have hy : (y : F) ∈ T ⊔ Work.HopfGaschutz.relFrattini 2 K := by
    rw [hTRe]; exact y.2
  obtain ⟨t, htT, s, hsR, hts⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := T)
      (t := Work.HopfGaschutz.relFrattini 2 K)).mp hy
  have htK : t ∈ K := hT_le htT
  have hsK : s ∈ K := hR_le hsR
  have hys : (y : K) = ⟨t, htK⟩ * ⟨s, hsK⟩ := by
    refine Subtype.ext ?_
    show (y : F) = t * s
    exact hts.symm
  have hsN : (⟨s, hsK⟩ : K) ∈ Work.HopfGaschutz.relFrattiniIn 2 K := by
    rw [Work.HopfGaschutz.mem_relFrattiniIn]
    exact hsR
  have hmk : QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K) ⟨s, hsK⟩ = 1 := by
    rw [← MonoidHom.mem_ker, QuotientGroup.ker_mk']
    exact hsN
  rw [hys, map_mul, hmk, mul_one]
  exact key t htT htK

/-- **The relation-Frattini quotient generated by `r` words has order `2 ^ k`, `k ≤ r`.**

Let `K ⊴ F` be a normal subgroup of a group `F` and let `w : Fin r → F` be words lying in `K` such
that `K ≤ ⟪w⟫ · K²[K,F]`.  Then `K ⧸ K²[K,F]` is a finite elementary abelian `2`-group of order
`2 ^ k` with `k ≤ r`. -/
theorem exists_pow_card_of_spanning {F : Type*} [Group F] {K : Subgroup F} [K.Normal]
    {r : ℕ} (w : Fin r → F) (hw : ∀ i, w i ∈ K)
    (hspan : K ≤ Subgroup.normalClosure (Set.range w) ⊔
      Work.HopfGaschutz.relFrattini 2 K) :
    ∃ k : ℕ, k ≤ r ∧ Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) = 2 ^ k := by
  classical
  haveI : (Work.HopfGaschutz.relFrattiniIn 2 K).Normal :=
    Work.HopfGaschutz.relFrattiniIn_normal 2 K
  -- the lifts of the words into `K`
  let u : Fin r → K := fun i => ⟨w i, hw i⟩
  have hspan' : K ≤ Subgroup.normalClosure (Set.range fun i => (u i : F)) ⊔
      Work.HopfGaschutz.relFrattini 2 K := hspan
  have hgen : Subgroup.closure (Set.range fun i =>
      (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (u i)) = ⊤ :=
    closure_mk_relFrattiniIn_eq_top u hspan'
  -- the quotient is commutative
  have hcom : ∀ x y : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) y
    rw [← commutatorElement_eq_one_iff_mul_comm]
    rw [← map_commutatorElement (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) a b]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_commutatorElement (Subgroup.subtype K) a b]
    exact Work.HopfGaschutz.commutator_mem_relFrattini 2 K a.2
  letI : CommGroup (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) :=
    { toGroup := inferInstanceAs (Group (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K))
      mul_comm := hcom }
  -- the quotient has exponent `2`
  have h2 : ∀ x : K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K, x ^ 2 = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn 2 K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (a ^ 2) ∈ Work.HopfGaschutz.relFrattini 2 K
    rw [map_pow]
    exact Work.HopfGaschutz.pow_mem_relFrattini 2 K a.2
  -- it is finitely generated, hence finite
  have hfg : Group.FG (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) := by
    rw [Group.fg_iff]
    exact ⟨Set.range fun i =>
        (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K)) (u i), hgen,
      Set.finite_range _⟩
  have hfin : Finite (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) := by
    have hdvd : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ∣
        2 ^ Group.rank (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) :=
      card_dvd_exponent_pow_rank' (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) (n := 2) h2
    exact Nat.finite_of_card_ne_zero
      (Nat.pos_of_dvd_of_pos hdvd (pow_pos (by norm_num) _)).ne'
  haveI : Fintype (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) := Fintype.ofFinite _
  -- the order is at most `2 ^ r`
  have hcardle : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) ≤ 2 ^ r :=
    natCard_le_two_pow_of_closure_eq_top (V := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) h2
      (fun i => QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn 2 K) (u i)) hgen
  -- an abelian group of exponent `2` generated by `r` elements is `(ℤ/2) ^ k` with `k ≤ r`
  obtain ⟨k, hk, ⟨e⟩⟩ :=
    exists_mulEquiv_pi_zmodTwo_of_natCard_le (V := K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) h2 hcardle
  refine ⟨k, hk, ?_⟩
  have hcard : Nat.card (K ⧸ Work.HopfGaschutz.relFrattiniIn 2 K) =
      Nat.card (Multiplicative (Fin k → ZMod 2)) := Nat.card_congr e.toEquiv
  rw [hcard, Nat.card_eq_fintype_card, Fintype.card_multiplicative, Fintype.card_fun, ZMod.card 2,
    Fintype.card_fin]

/-- **The relation-Frattini quotient is finite of `2`-power order, with exponent bounded by the
number of spanning words.**

Let `K = MonoidHom.ker (FreeGroup.lift g)` and let `w` be `r` words *in* `K` which span `K` modulo
`K²[K,F]`, i.e. `K ≤ ⟪Set.range w⟫ ⊔ K²[K,FreeGroup (Fin d)]`.  Then the elementary abelian
`2`-group `K ⧸ K²[K,F]` is finite and has order `2 ^ k` with `k ≤ r`.

(The hypothesis `∀ i, w i ∈ MonoidHom.ker (FreeGroup.lift g)` is *not* removable: without it the
spanning hypothesis is satisfiable by the free generators `w` themselves, and the conclusion fails
for finitely generated groups that are not finitely presented.) -/
theorem natCard_relFrattiniQuotient_eq_two_pow_of_spanning {d r : ℕ} {Γ : Type*} [Group Γ]
    (g : Fin d → Γ) (w : Fin r → FreeGroup (Fin d))
    (hw : ∀ i, w i ∈ MonoidHom.ker (FreeGroup.lift g))
    (hspan : MonoidHom.ker (FreeGroup.lift g) ≤
      Subgroup.normalClosure (Set.range w) ⊔
        Work.HopfGaschutz.relFrattini 2 (MonoidHom.ker (FreeGroup.lift g))) :
    ∃ k : ℕ, k ≤ r ∧ Nat.card (MonoidHom.ker (FreeGroup.lift g) ⧸
      Work.HopfGaschutz.relFrattiniIn 2 (MonoidHom.ker (FreeGroup.lift g))) = 2 ^ k := by
  haveI : (MonoidHom.ker (FreeGroup.lift g)).Normal := MonoidHom.normal_ker _
  exact exists_pow_card_of_spanning (K := MonoidHom.ker (FreeGroup.lift g)) w hw hspan

end Work.ShafarevichKoch.Gaschutz
