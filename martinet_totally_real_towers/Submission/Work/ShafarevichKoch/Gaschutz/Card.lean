import Mathlib
import Submission.Work.ShafarevichKoch.Gaschutz.RelModule
import Submission.Work.ShafarevichKoch.Gaschutz.Kc
import Submission.Work.ShafarevichKoch.Gaschutz.natCard_relFrattiniQuotient_eq_two_pow_of_spanning
import Submission.Work.ShafarevichKoch.Gaschutz.exists_words_spanning_of_relFrattiniIn_card

/-!
# `Work.ShafarevichKoch.Gaschutz.Card` -- the cardinality form of the Shafarevich--Koch bound

The classical Shafarevich--Koch relation bound is the numerical statement
`r(G_∅) ≤ d + d₂(O_K^×)`.  Since the minimal number of relations of a pro-`2` presentation is the
dimension of the relation module `K/(K²[K,F])`, this is the *cardinality* statement

```
#(K ⧸ K²[K,F]) = 2 ^ k  with  k ≤ d + d₂(O_K^×) ,      K = ker (FreeGroup.lift g) ,
```

and this module proves that the crux `Work.ShafarevichKoch.HasRelModulePresentation F d r` is
*equivalent* to it, in both directions:

* `exists_natCard_relFrattiniQuotient_eq_two_pow_of_hasRelModulePresentation` -- the crux gives the
  cardinality bound (`K ⧸ K²[K,F]` is finite of order `2 ^ k`, `k ≤ r`, by
  `Work.ShafarevichKoch.Gaschutz.natCard_relFrattiniQuotient_eq_two_pow_of_spanning`);
* `exists_words_spanning_of_natCard_eq_two_pow` -- conversely the cardinality bound produces `r`
  words of `K` spanning the kernel modulo `K²[K,F]`
  (`Work.ShafarevichKoch.Gaschutz.exists_words_spanning_of_relFrattiniIn_card`), which is the
  spanning clause of the crux;
* `natCard_relFrattiniQuotient_Kc_of_relModuleBound` -- the instance for `Kc = ℚ(√-30030)`:
  `#(K ⧸ K²[K,F]) = 2 ^ k` with `k ≤ 6 = rank₂ Cl(Kc) + d₂(O_Kc^×)`.

The point of the cardinality form is that it is the *numerical* statement of the deliverable with no
cohomology and no pro-`2` completion: only the free group `FreeGroup (Fin 5)`, the kernel `K` of the
presentation map, and the subgroup `K²[K,F]` generated by the squares in `K` and the commutators of
`K` with the free group.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

open scoped Classical
open scoped NumberField

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **The cardinality form of the crux.**  From the relation-module form of the Shafarevich--Koch
bound, the relation-Frattini quotient `K ⧸ K²[K,F]` of the kernel `K = ker (FreeGroup.lift g)` is
finite of order `2 ^ k` with `k ≤ r`. -/
theorem exists_natCard_relFrattiniQuotient_eq_two_pow_of_hasRelModulePresentation
    (F : Type*) [Field F] [NumberField F] {d r : ℕ}
    (h : HasRelModulePresentation F d r) :
    ∃ (M : MaximalUnramifiedProP.{0} F 2) (g : Fin d → galoisGroup M) (k : ℕ),
      (Subgroup.closure (Set.range g)).topologicalClosure = ⊤ ∧ k ≤ r ∧
      Nat.card (relKernel g ⧸ Work.HopfGaschutz.relFrattiniIn 2 (relKernel g)) = 2 ^ k := by
  obtain ⟨M, g, w, hdense, hw, hspan, -⟩ := h
  obtain ⟨k, hk, hcard⟩ := Gaschutz.natCard_relFrattiniQuotient_eq_two_pow_of_spanning g w hw hspan
  exact ⟨M, g, k, hdense, hk, hcard⟩

/-- **The cardinality bound produces a spanning family.**  Given `#(K ⧸ K²[K,F]) = 2^k`, `k ≤ r`,
there are `r` words of `K` spanning `K` modulo `K²[K,F]`; together with the residual clause of
`HasRelModulePresentation` this is exactly the crux. -/
theorem exists_words_spanning_of_natCard_eq_two_pow {d r : ℕ} {Γ : Type*} [Group Γ]
    (g : Fin d → Γ) {k : ℕ} (hk : k ≤ r)
    (hcard : Nat.card (relKernel g ⧸ Work.HopfGaschutz.relFrattiniIn 2 (relKernel g)) = 2 ^ k) :
    ∃ w : Fin r → FreeGroup (Fin d), (∀ i, w i ∈ relKernel g) ∧
      relKernel g ≤ Subgroup.normalClosure (Set.range w) ⊔
        Work.HopfGaschutz.relFrattini 2 (relKernel g) :=
  Gaschutz.exists_words_spanning_of_relFrattiniIn_card g hk hcard

/-- **The numerical form of the crux for `Kc`**: `#(K ⧸ K²[K,F]) = 2 ^ k` with
`k ≤ 6 = rank₂ Cl(Kc) + d₂(O_Kc^×)`. -/
theorem natCard_relFrattiniQuotient_Kc_of_relModuleBound (h : KcRelModuleBound) :
    ∃ (M : MaximalUnramifiedProP.{0} Kc 2) (g : Fin 5 → galoisGroup M) (k : ℕ),
      (Subgroup.closure (Set.range g)).topologicalClosure = ⊤ ∧ k ≤ 6 ∧
      Nat.card (relKernel g ⧸ Work.HopfGaschutz.relFrattiniIn 2 (relKernel g)) = 2 ^ k :=
  exists_natCard_relFrattiniQuotient_eq_two_pow_of_hasRelModulePresentation Kc h

end Work.ShafarevichKoch
