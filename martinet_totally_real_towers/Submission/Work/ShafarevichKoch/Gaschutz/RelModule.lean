import Mathlib
import Submission.Work.ShafarevichKoch.RelationBound
import Submission.Work.ShafarevichKoch.ProTwoClosed
import Submission.Work.HopfGaschutz.closedRelationData_of_spanningModulo
import Submission.Work.ShafarevichKoch.residuallyFiniteTwoGroup_presented

/-!
# `Work.ShafarevichKoch.Gaschutz.RelModule` -- the relation-module form of the crux

The chapter's crux `Work.ShafarevichKoch.HasProTwoPresentation F d r` asks for a *presentation* of
`G_∅ = Gal(F_∅/F)`: elements `g_1,…,g_d` generating `G_∅` topologically and `r` words in `d`
letters whose normal closure is the kernel of the presentation map `FreeGroup (Fin d) →* G_∅`.

That is a statement about the *abstract* kernel `K = ker (FreeGroup.lift g)`.  This file proves the
**equivalence** of the crux with the purely group-theoretic statement that `K` is generated modulo
its *relation-Frattini subgroup* `K²[K,F]` by `r` elements:

```
Work.ShafarevichKoch.HasRelModulePresentation F d r  ↔  HasProTwoPresentation F d r .
```

The point of the reformulation is that the *classical* Shafarevich--Koch relation bound is a
statement precisely of this shape ("the maximal unramified pro-`p` extension has a presentation
with `d` generators and `r ≤ d + d₂(O_F^×)` relations"), while `HasProTwoPresentation` is the shape
the Golod--Shafarevich engine consumes.  In particular the reformulation makes the input
independent of the cohomological dictionary `r(Γ) = dim H²(Γ,𝔽_p)` (Gaschütz): either form can be
fed to the chapter, so the crux may be *proved* in whichever form the arithmetic supplies.

## The two directions

* **relation module ⟹ presentation.**  If the words `w_1,…,w_r` in `K` span
  `K/(K²[K,F])`, then every finite `2`-quotient of `FreeGroup (Fin d)` killing them kills `K`
  (`Work.HopfGaschutz.closedRelationData_of_spanningModulo`, applied to the *global* spanning
  hypothesis).  This is the classical *closed* presentation of `G_∅`, and -- because the presented
  abstract group is residually a finite `2`-group -- it upgrades to the abstract presentation of
  the crux (`Work.ShafarevichKoch.ker_eq_normalClosure_of_closed`).
* **presentation ⟹ relation module.**  Given `ker (FreeGroup.lift g) = ⟪w⟫`, the relators
  themselves generate the kernel modulo the (much smaller) relation-Frattini subgroup.

The reformulation is the chapter's sharpest *elementary* form of the arithmetic input: no pro-`2`
completion, no cohomology, only the free group `FreeGroup (Fin d)`, its kernel and the subgroup
`K²[K,F]` generated by squares inside `K` and commutators of `K` with the ambient free group.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 400000

open scoped Classical
open scoped commutatorElement

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- The kernel of the presentation map `FreeGroup (Fin d) →* Γ` attached to a generating family
`g`; the relation module of the chapter is defined modulo its relation-Frattini subgroup. -/
abbrev relKernel {d : ℕ} {Γ : Type*} [Group Γ] (g : Fin d → Γ) : Subgroup (FreeGroup (Fin d)) :=
  MonoidHom.ker (FreeGroup.lift g)

/-- The abstract group presented by `d` generators and the relators `w`. -/
abbrev relPresented {d r : ℕ} (w : Fin r → FreeGroup (Fin d)) : Type _ :=
  FreeGroup (Fin d) ⧸ Subgroup.normalClosure (Set.range w)

/-- **The relation module of `G_∅` is generated by `r` elements.**

There are a maximal unramified pro-`2` extension `F_∅` of `F`, elements `g : Fin d → G_∅`
generating `G_∅` topologically, and `r` words `w_i` in `d` letters, all lying in the kernel
`K = ker (FreeGroup.lift g)`, whose normal closure together with the relation-Frattini subgroup
`K²[K,F]` is all of `K`; moreover the abstract group presented by `d` generators and the words `w`
is residually a finite `2`-group.

In other words `K/(K²[K,F])` -- an elementary abelian `2`-group, the `𝔽₂`-dual of the relation
module -- is generated by `r` elements, i.e. `df(G_∅) ≤ r - d`.  By
`hasProTwoPresentation_iff_hasRelModulePresentation` this is *equivalent* to the crux
`HasProTwoPresentation F d r`. -/
def HasRelModulePresentation (F : Type*) [Field F] [NumberField F] (d r : ℕ) : Prop :=
  ∃ (M : MaximalUnramifiedProP.{0} F 2) (g : Fin d → galoisGroup M)
    (w : Fin r → FreeGroup (Fin d)),
    (Subgroup.closure (Set.range g)).topologicalClosure = ⊤ ∧
    (∀ i, w i ∈ relKernel g) ∧
    relKernel g ≤ Subgroup.normalClosure (Set.range w) ⊔ Work.HopfGaschutz.relFrattini 2 (relKernel g) ∧
    ResiduallyFiniteTwoGroup (relPresented w)

/-- **The relation module form implies the crux.**  Words spanning the kernel modulo `K²[K,F]`
give a *closed* pro-`2` presentation of `G_∅` with `r` relators, which upgrades to an abstract
presentation because the presented group is residually a finite `2`-group. -/
theorem hasProTwoPresentation_of_hasRelModulePresentation (F : Type*) [Field F] [NumberField F]
    {d r : ℕ} (h : HasRelModulePresentation F d r) : HasProTwoPresentation F d r := by
  classical
  obtain ⟨M, g, w, hdense, hw_mem, hspan, hres⟩ := h
  have hKnormal : (MonoidHom.ker (FreeGroup.lift g)).Normal := MonoidHom.normal_ker _
  haveI := hKnormal
  -- the relator set as a `Finset`, with its coercion to a set being `Set.range w`
  have hcoe : ((Finset.univ.image w : Finset (FreeGroup (Fin d))) : Set (FreeGroup (Fin d)))
      = Set.range w := by
    ext x
    simp [eq_comm]
  -- every finite `2`-quotient killing the words kills the kernel
  have hclosed : ClosedRelationData d r g w := by
    refine ⟨hw_mem, ?_⟩
    intro Q _ _ hQ φ hφ
    exact Work.HopfGaschutz.closedRelationData_of_spanningModulo
      (p := 2) (α := Fin d) (K := relKernel g) (S := Finset.univ.image w)
      (fun (Q' : Type) [Group Q'] [Fintype Q'] (hQ' : IsPGroup 2 Q')
        (φ' : FreeGroup (Fin d) →* Q') => by
          rw [hcoe]
          exact le_trans hspan le_sup_left)
      Q hQ φ (fun s hs => by
        obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hs
        exact hφ i)
  exact ⟨M, g, w, ker_eq_normalClosure_of_closed g w hw_mem hclosed.2 (by
    simpa [presentedGroup] using hres), hdense⟩

/-- **The crux implies the relation module form.**  From a presentation
`ker (FreeGroup.lift g) = ⟪w⟫` the relators themselves generate the kernel modulo the
relation-Frattini subgroup, and the presented group is residually a finite `2`-group by
`residuallyFiniteTwoGroup_presented`. -/
theorem hasRelModulePresentation_of_hasProTwoPresentation (F : Type*) [Field F] [NumberField F]
    {d r : ℕ} (h : HasProTwoPresentation F d r) : HasRelModulePresentation F d r := by
  classical
  obtain ⟨M, g, w, hker, hdense⟩ := h
  refine ⟨M, g, w, hdense, ?_, ?_, ?_⟩
  · intro i
    show w i ∈ MonoidHom.ker (FreeGroup.lift g)
    rw [hker]
    exact Subgroup.subset_normalClosure ⟨i, rfl⟩
  · show MonoidHom.ker (FreeGroup.lift g) ≤ Subgroup.normalClosure (Set.range w) ⊔
      Work.HopfGaschutz.relFrattini 2 (MonoidHom.ker (FreeGroup.lift g))
    rw [hker]
    exact le_sup_left
  · exact residuallyFiniteTwoGroup_presented F d r M g w hker hdense

/-- **The crux is equivalent to the relation-module statement.**  The Shafarevich--Koch relation
bound may be stated either as a presentation of `G_∅` (`HasProTwoPresentation`, the form the
Golod--Shafarevich engine consumes) or as the generation of the relation module `K/(K²[K,F])`
(`HasRelModulePresentation`, the form in which the classical theorem is proved). -/
theorem hasProTwoPresentation_iff_hasRelModulePresentation (F : Type*) [Field F] [NumberField F]
    (d r : ℕ) :
    HasProTwoPresentation F d r ↔ HasRelModulePresentation F d r :=
  ⟨hasRelModulePresentation_of_hasProTwoPresentation F,
    hasProTwoPresentation_of_hasRelModulePresentation F⟩

end Work.ShafarevichKoch
