import Mathlib
import Submission.Work.ShafarevichKoch.VTwoUnramified
import Submission.Work.ShafarevichKoch.card_vTwo_mod_squares
import Submission.Work.ShafarevichKoch.neg_one_kummer_slack_Kc
import Submission.Work.ShafarevichKoch.card_VTwoUnramified_mod_squares_Kc

/-!
# `Work.ShafarevichKoch.VTwo_eq_VTwoUnramified_sup_neg_one_Kc`

**Koch's Kummer radical of `Kc = ℚ(√-30030)` is generated by its unramified part, the square
class of `-1`, and the squares of `Kcˣ`:** as subgroups of `Kcˣ`,

  `V_∅ = V^{unr} ⊔ ⟨-1⟩ ⊔ (Kcˣ)²`

where `V_∅` is Koch's radical (the elements whose principal fractional ideal is a square),
`V^{unr} = VTwoUnramified Kc M` those of them whose square root lies in the maximal unramified
pro-`2` extension `M.K`, and `(Kcˣ)²` is `squareSubgroup Kcˣ`.

Equivalently: *every element of `V_∅` becomes unramified after multiplying by `±1`* (the two
subgroups `VTwoUnramified Kc M` and `Subgroup.closure {-1}` together already exhaust `V_∅`), and
`-1` is the unique obstruction, as recorded in `README.md` §9.4.

## Proof

By cardinality, exactly as in the module docstring of `VTwoUnramified.lean`:

* `Nat.card (V_∅ / Kc^{×2}) = 2 ^ (d₂(O_{Kc}^×) + rank₂ Cl(Kc)) = 2 ^ (1 + 5) = 64`
  (`card_vTwo_mod_squares`, `unitTwoRank_witness_eq_one`, `classGroupTwoRank_Kc`);
* `Nat.card (V^{unr} / Kc^{×2}) = 32` (`card_VTwoUnramified_mod_squares_Kc`).

Because the squares of `Kcˣ` lie in both radicals, the multiplicativity of relative indices
`S.relIndex H * H.relIndex V = S.relIndex V` (with `S = (Kcˣ)²`, `H = V^{unr}`, `V = V_∅`, and
relative indices read off the two quotient cardinalities above) gives `32 * [V : H] = 64`, i.e.
`[V : H] = 2`.  Since `-1 ∈ V` but `-1 ∉ H`, an index-two subgroup is generated by `H` together
with any element of `V \ H` (the elementary group-theoretic lemma
`le_sup_closure_of_relIndex_eq_two` below), so `V = H ⊔ Subgroup.closure {-1}`, and the squares are
absorbed because they lie in `H`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open Work.ClassFieldTower
open Work.QuadraticFields

noncomputable section

namespace Work.ShafarevichKoch

/-- **A subgroup of index two is generated by any element outside it.**  If `H` is a subgroup of
`K` of relative index `2` and `a ∈ K \ H`, then `K = H ⊔ Subgroup.closure {a}`.

(The proof uses only that `H ⊔ Subgroup.closure {a}` is a subgroup of `K` strictly containing `H`:
the existential form of the index-two condition supplies some `a' ∈ K \ H` with `b * a' ∈ H` for
all `b ∈ K \ H`, and an arbitrary `a ∈ K \ H` differs from `a'` by an element of `H` after
multiplying by itself -- this is where commutativity is used.) -/
theorem le_sup_closure_of_relIndex_eq_two {G : Type*} [CommGroup G] {H K : Subgroup G}
    (h2 : H.relIndex K = 2) {a : G} (haK : a ∈ K) (haH : a ∉ H) :
    K ≤ H ⊔ Subgroup.closure ({a} : Set G) := by
  obtain ⟨a', _ha'K, _ha'H, h⟩ := Subgroup.relIndex_eq_two_iff_exists_notMem_and.mp h2
  have hmem : a' ∈ H ⊔ Subgroup.closure ({a} : Set G) := by
    have haa' : a * a' ∈ H := (h a haK).resolve_right haH
    have h1 : a⁻¹ ∈ H ⊔ Subgroup.closure ({a} : Set G) :=
      inv_mem (Subgroup.mem_sup_right (Subgroup.subset_closure (Set.mem_singleton a)))
    have h2' : a * a' ∈ H ⊔ Subgroup.closure ({a} : Set G) := Subgroup.mem_sup_left haa'
    have heq : a' = a⁻¹ * (a * a') := by group
    rw [heq]
    exact mul_mem h1 h2'
  intro b hbK
  rcases h b hbK with hba | hbH
  · have h1 : b * a' ∈ H ⊔ Subgroup.closure ({a} : Set G) := Subgroup.mem_sup_left hba
    have h2' : a'⁻¹ ∈ H ⊔ Subgroup.closure ({a} : Set G) := inv_mem hmem
    have heq : b = (b * a') * a'⁻¹ := by group
    rw [heq]
    exact mul_mem h1 h2'
  · exact Subgroup.mem_sup_left hbH

theorem VTwo_eq_VTwoUnramified_sup_neg_one_Kc
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} Work.ClassFieldTower.Kc 2) :
    Work.ShafarevichKoch.VTwo Work.ClassFieldTower.Kc =
      Work.ShafarevichKoch.VTwoUnramified Work.ClassFieldTower.Kc M ⊔
        Subgroup.closure ({(-1 : Work.ClassFieldTower.Kcˣ)} : Set Work.ClassFieldTower.Kcˣ) ⊔
        Work.QuadraticFields.squareSubgroup Work.ClassFieldTower.Kcˣ := by
  -- Abbreviate the four subgroups of `Kcˣ` appearing in the statement.
  set V : Subgroup Kcˣ := VTwo Kc with hVdef
  set H : Subgroup Kcˣ := VTwoUnramified Kc M with hHdef
  set C : Subgroup Kcˣ := Subgroup.closure ({(-1 : Kcˣ)} : Set Kcˣ) with hCdef
  set S : Subgroup Kcˣ := squareSubgroup Kcˣ with hSdef
  -- `V^{unr} ≤ V_∅`, and the squares lie in both radicals.
  have hHV : H ≤ V := VTwoUnramified_le_VTwo Kc M
  have hSH : S ≤ H := by
    intro x hx
    obtain ⟨y, rfl⟩ := (mem_squareSubgroup_iff).mp hx
    exact sq_mem_VTwoUnramified Kc M y
  -- `-1 ∈ V_∅`.
  have hCV : C ≤ V := by
    rw [hCdef, Subgroup.closure_le, Set.singleton_subset_iff]
    exact neg_one_mem_VTwo_Kc
  -- The squares of `Kcˣ` are the range of the squaring endomorphism.
  have hSmap : S = Subgroup.map (powMonoidHom (2 : ℕ) : Kcˣ →* Kcˣ) ⊤ := by
    rw [hSdef]
    change Subgroup.closure (Set.range fun y : Kcˣ => y ^ 2) = _
    rw [sqSubgroup_eq_range, MonoidHom.range_eq_map]
  -- The two quotient cardinalities, i.e. the two relative indices of the squares.
  have hcardV : Nat.card (↥V ⧸ S.subgroupOf V) = 64 := by
    rw [hSmap]
    have h := card_vTwo_mod_squares Kc
    rw [unitTwoRank_witness_eq_one, classGroupTwoRank_Kc] at h
    norm_num at h
    exact h
  have hcardH : Nat.card (↥H ⧸ S.subgroupOf H) = 32 := by
    rw [hSmap]
    exact card_VTwoUnramified_mod_squares_Kc M
  have hrelH : S.relIndex H = 32 := by
    rw [Subgroup.relIndex, Subgroup.index_eq_card]
    exact hcardH
  have hrelV : S.relIndex V = 64 := by
    rw [Subgroup.relIndex, Subgroup.index_eq_card]
    exact hcardV
  -- Multiplicativity of relative indices gives `[V : H] = 2`.
  have hrelHV : H.relIndex V = 2 := by
    have h := Subgroup.relIndex_mul_relIndex S H V hSH hHV
    rw [hrelH, hrelV] at h
    omega
  -- Hence `H` together with `-1` (which lies outside `H`) is all of `V`.
  have hge : V ≤ H ⊔ C :=
    le_sup_closure_of_relIndex_eq_two hrelHV (show (-1 : Kcˣ) ∈ V from neg_one_mem_VTwo_Kc)
      (show (-1 : Kcˣ) ∉ H from neg_one_not_mem_VTwoUnramified_Kc M)
  exact le_antisymm (hge.trans le_sup_left) (sup_le (sup_le hHV hCV) (hSH.trans hHV))

end Work.ShafarevichKoch
