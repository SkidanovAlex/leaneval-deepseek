import Mathlib
import Submission.Work.ConCohomology.All
import Submission.Work.ShafarevichKoch.le_of_isOpen_index_two_Kc

namespace Work.ShafarevichKoch

open Work.ConCohomology

set_option maxHeartbeats 2000000

/-- **The relation rank of `Q` is bounded by the number of generators of `N`.**

Let `1 → N → G → Q → 1` be a group extension, `𝔽₂ = ZMod 2` carrying the trivial action of `N`
and a `G`-action factoring through `q : G → Q`, and suppose the inflation map
`H²Res E.q : H²(Q,𝔽₂) → H²(G,𝔽₂)` is **zero**.  If `N` is normally generated by `s` elements,
then `Nat.card (H²(Q,𝔽₂))` is a power of `2` with exponent at most `s`.

The proof is the Hochschild--Serre exactness at `H²(Q,𝔽₂)` together with the trivial-action
computation of `H¹(N,𝔽₂)`:

* `ker(inf₂) = im(tg)` (`ker_H2Res_eq_range_tg`), so the vanishing of the inflation exhibits every
  class of `H²(Q,𝔽₂)` as the transgression `tg(φ)` of a `1`-cocycle `φ` on `N`; hence `H²(Q,𝔽₂)`
  is a quotient (as a set) of `Z¹(N,𝔽₂)`;
* since `N` acts trivially on `𝔽₂`, `1`-cocycles on `N` are exactly the additive maps `N → 𝔽₂`, and
  such a map vanishing on the normal closure of the generators `x i` is zero --- the kernel of an
  additive map into an abelian group is normal.  So `Z¹(N,𝔽₂) → (Fin s → 𝔽₂)`,
  `z ↦ (z (x i))_i`, is injective and `Nat.card (Z¹(N,𝔽₂)) ≤ 2^s`;
* finally `H²(Q,𝔽₂)` is a quotient of a group all of whose elements have order dividing `2`, hence
  an `𝔽₂`-vector space; its cardinal is therefore `2^k` with `k = finrank`, and `k ≤ s`. -/
theorem natCard_H2_le_two_pow_of_inflation_eq_zero
    {G Q N : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
    [DistribMulAction G (ZMod 2)] [DistribMulAction Q (ZMod 2)] [DistribMulAction N (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule G (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule Q (ZMod 2)]
    [Work.ConCohomology.IsDiscreteGModule N (ZMod 2)]
    (E : Work.ConCohomology.GroupExt G Q N)
    (hq : Continuous E.q) (hi : Continuous E.i)
    (hcompN : ∀ (n : N) (m : ZMod 2), n • m = m)
    (hcompG : ∀ (g : G) (m : ZMod 2), g • m = E.q g • m)
    (sec : Q → G) (hsec : ∀ y : Q, E.q (sec y) = y) (hseccont : Continuous sec)
    (hkcont : Continuous fun p : {x : G // E.q x = 1} => E.kerLift p.1 p.2)
    (s : ℕ) (x : Fin s → N) (hx : Subgroup.normalClosure (Set.range x) = ⊤)
    (hinf : ∀ y : Work.ConCohomology.H2 Q (ZMod 2),
      Work.ConCohomology.H2Res E.q hq hcompG y = 0) :
    ∃ k ≤ s, Nat.card (Work.ConCohomology.H2 Q (ZMod 2)) = 2 ^ k := by
  classical
  -- The `Q`-action on `𝔽₂` is the `G`-action transported along the section `sec`.
  have hcompQ : ∀ (y : Q) (m : ZMod 2), y • m = sec y • m := fun y m => by
    rw [hcompG (sec y) m, hsec y]
  -- The transgression, followed by the class map, is a surjection `Z¹(N,𝔽₂) → H²(Q,𝔽₂)`.
  let g : Z1 N (ZMod 2) → H2 Q (ZMod 2) := fun φ =>
    if h : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2))))
      then H2.mk (⟨tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)),
        mem_Z2.mpr h⟩ : Z2 Q (ZMod 2))
      else 0
  have key : ∀ y : H2 Q (ZMod 2), ∃ φ : Z1 N (ZMod 2), g φ = y := by
    intro y
    obtain ⟨z, rfl⟩ := QuotientAddGroup.mk_surjective y
    have hz : H2Res E.q hq hcompG (H2.mk z) = 0 := hinf _
    -- Hochschild--Serre: the vanishing of the inflation makes `z` a transgression.
    have hex := (ker_H2Res_eq_range_tg E hq hi hcompN hcompG sec hsec hseccont hkcont z).mp hz
    obtain ⟨φ, hφ, hinv, w, hw⟩ := hex
    have hcoc : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)))) := by
      have h := isCocycle2_tgFun E hcompN sec hsec hcompQ (φ.1 : N → ZMod 2) hφ hinv
      simpa [tgCochain_coe] using h
    -- The cochain identity `tg φ - z = d¹w`, lifted to `Cochain2`.
    have hw' : (tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)) : Cochain2 Q (ZMod 2))
          - (z : Cochain2 Q (ZMod 2)) = d1Hom Q (ZMod 2) w := by
      apply LocallyConstant.coe_inj.mp
      funext p
      obtain ⟨a, b⟩ := p
      show (tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2))) (a, b)
        - (z.1 : Q × Q → ZMod 2) (a, b) = a • w b - w (a * b) + w a
      have h := congrFun hw (a, b)
      simp only [Pi.sub_apply, d1Fun_apply, tgCochain_apply] at h
      exact h
    refine ⟨φ, ?_⟩
    show (if h : IsCocycle2 (⇑(tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2))))
      then H2.mk (⟨tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)),
        mem_Z2.mpr h⟩ : Z2 Q (ZMod 2))
      else 0) = H2.mk z
    rw [dite_eq_left hcoc]
    rw [H2.mk_eq_mk_iff, mem_B2', mem_B2]
    refine ⟨w, ?_⟩
    show (d1Hom Q (ZMod 2) w : Cochain2 Q (ZMod 2))
      = (tgCochain E sec hsec hseccont hkcont (φ : Cochain1 N (ZMod 2)) : Cochain2 Q (ZMod 2))
        - (z : Cochain2 Q (ZMod 2))
    exact hw'.symm
  have hsurj : Function.Surjective g := fun y => key y
  -- `Z¹(N,𝔽₂)` injects into `(Fin s → 𝔽₂)`, via evaluation at the normal generators.
  have hinj : Function.Injective
      (fun z : Z1 N (ZMod 2) => fun i : Fin s => (z.1 : N → ZMod 2) (x i)) := by
    intro z w hzw
    have haddz : ∀ a b : N,
        (z.1 : N → ZMod 2) (a * b) = (z.1 : N → ZMod 2) a + (z.1 : N → ZMod 2) b :=
      fun a b => (isCocycle1_iff_of_trivial hcompN _).mp (mem_Z1.mp z.2) a b
    have haddw : ∀ a b : N,
        (w.1 : N → ZMod 2) (a * b) = (w.1 : N → ZMod 2) a + (w.1 : N → ZMod 2) b :=
      fun a b => (isCocycle1_iff_of_trivial hcompN _).mp (mem_Z1.mp w.2) a b
    have hz1 : (z.1 : N → ZMod 2) 1 = 0 := by
      have h := haddz 1 1
      rw [mul_one] at h
      exact (add_left_cancel (show (z.1 : N → ZMod 2) 1 + 0
        = (z.1 : N → ZMod 2) 1 + (z.1 : N → ZMod 2) 1 from by rw [add_zero]; exact h)).symm
    have hw1 : (w.1 : N → ZMod 2) 1 = 0 := by
      have h := haddw 1 1
      rw [mul_one] at h
      exact (add_left_cancel (show (w.1 : N → ZMod 2) 1 + 0
        = (w.1 : N → ZMod 2) 1 + (w.1 : N → ZMod 2) 1 from by rw [add_zero]; exact h)).symm
    have hxi : ∀ i : Fin s, (z.1 : N → ZMod 2) (x i) = (w.1 : N → ZMod 2) (x i) :=
      fun i => congrFun hzw i
    -- The difference of the two cocycles, as an additive map into `𝔽₂`.
    let Φ : N →* Multiplicative (ZMod 2) :=
      { toFun := fun n => Multiplicative.ofAdd ((z.1 : N → ZMod 2) n - (w.1 : N → ZMod 2) n)
        map_one' := by rw [hz1, hw1, sub_self, ofAdd_zero]
        map_mul' := fun a b => by
          show Multiplicative.ofAdd _ = Multiplicative.ofAdd _ * Multiplicative.ofAdd _
          rw [← ofAdd_add]
          congr 1
          rw [haddz, haddw]
          abel }
    have hle : Subgroup.normalClosure (Set.range x) ≤ MonoidHom.ker Φ :=
      Subgroup.normalClosure_le_normal (fun n hn => by
        obtain ⟨i, rfl⟩ := hn
        refine MonoidHom.mem_ker.mpr ?_
        change Multiplicative.ofAdd
          ((z.1 : N → ZMod 2) (x i) - (w.1 : N → ZMod 2) (x i)) = 1
        rw [hxi i, sub_self, ofAdd_zero])
    rw [hx] at hle
    have hpoint : ∀ n : N, (z.1 : N → ZMod 2) n = (w.1 : N → ZMod 2) n := by
      intro n
      have hmem : Φ n = 1 := MonoidHom.mem_ker.mp (hle (Subgroup.mem_top n))
      have h2 : Multiplicative.toAdd (Φ n) = Multiplicative.toAdd (1 : Multiplicative (ZMod 2)) := by
        rw [hmem]
      have h0 : (z.1 : N → ZMod 2) n - (w.1 : N → ZMod 2) n = 0 := by simpa [Φ] using h2
      exact sub_eq_zero.mp h0
    exact Subtype.ext (LocallyConstant.ext (fun n => hpoint n))
  have hFin : Nat.card (Fin s → ZMod 2) = 2 ^ s := by
    rw [Nat.card_fun, Nat.card_fin, Nat.card_eq_fintype_card, ZMod.card]
  have hZ1card : Nat.card (Z1 N (ZMod 2)) ≤ 2 ^ s := by
    rw [← hFin]
    exact Nat.card_le_card_of_injective _ hinj
  haveI hZ1fin : Finite (Z1 N (ZMod 2)) := Finite.of_injective _ hinj
  haveI hH2fin : Finite (H2 Q (ZMod 2)) := Finite.of_surjective g hsurj
  have hH2le : Nat.card (H2 Q (ZMod 2)) ≤ 2 ^ s :=
    le_trans (Nat.card_le_card_of_surjective g hsurj) hZ1card
  -- `H²(Q,𝔽₂)` is an `𝔽₂`-vector space.
  haveI : Module (ZMod 2) (H2 Q (ZMod 2)) :=
    QuotientAddGroup.zmodModule (n := 2) (fun xx => by
      have h0 : xx + xx = 0 := by
        apply Subtype.ext
        apply LocallyConstant.ext
        intro p
        exact CharTwo.add_self_eq_zero _
      rw [show (2 : ℕ) • xx = xx + xx from two_nsmul xx, h0]
      exact (B2' Q (ZMod 2)).zero_mem)
  have hcard : Nat.card (H2 Q (ZMod 2)) = 2 ^ Module.finrank (ZMod 2) (H2 Q (ZMod 2)) := by
    haveI : Fintype (H2 Q (ZMod 2)) := Fintype.ofFinite (H2 Q (ZMod 2))
    have h1 : Nat.card (H2 Q (ZMod 2)) = Fintype.card (H2 Q (ZMod 2)) := Nat.card_eq_fintype_card
    rw [h1, Module.card_eq_pow_finrank (K := ZMod 2) (V := H2 Q (ZMod 2))]
    have h2 : Fintype.card (ZMod 2) = 2 := ZMod.card 2
    rw [h2]
  refine ⟨Module.finrank (ZMod 2) (H2 Q (ZMod 2)), ?_, hcard⟩
  have h := hH2le
  rw [hcard] at h
  exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp h

end Work.ShafarevichKoch
