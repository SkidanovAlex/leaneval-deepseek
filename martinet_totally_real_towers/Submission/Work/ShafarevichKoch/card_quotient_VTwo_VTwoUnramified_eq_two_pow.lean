import Mathlib
import Submission.Work.ShafarevichKoch.VTwoUnramified
import Submission.Work.ShafarevichKoch.vTwo_rank_two_corrected
import Submission.Work.ClassFieldTower.Defs

/-!
# `Work.ShafarevichKoch.card_quotient_VTwo_VTwoUnramified_eq_two_pow`

The quotient `V_∅ / V^{unr}` of Koch's Kummer radical by its *unramified* part has
cardinality `2 ^ unitTwoRank F = #(O_F^×/(O_F^×)²)`.

## The mathematics

All three groups are subgroups of `Fˣ`:

* `S = (Fˣ)² = squareSubgroup Fˣ`, the subgroup generated by the squares;
* `U = VTwoUnramified F M = V^{unr}`, the `x ∈ Fˣ` with `√x ∈ F_∅`;
* `V = VTwo F = V_∅`, Koch's radical `{x ∈ Fˣ : (x) a square fractional ideal}`.

Since `S ≤ U ≤ V` (`sq_mem_VTwoUnramified`, `VTwoUnramified_le_VTwo`), the *tower* for
relative indices `S.relIndex U * U.relIndex V = S.relIndex V`
(`Subgroup.relIndex_mul_relIndex`) reads, in cardinalities of quotients,

  `#(U/S) · #(V/U) = #(V/S)`.

The hypothesis of the theorem is exactly `#(U/S) = 2 ^ classGroupTwoRank F` (this is the
*unramified* Kummer two-descent: `U/S ≅ Cl(F)[2]`), while

  `#(V/S) = 2 ^ (unitTwoRank F + classGroupTwoRank F)`

is the Kummer two-descent for Koch's radical (`card_quotient_VTwo`: `V/S ≅ O_F^×/(O_F^×)²`
extended by `Cl(F)[2]`). Cancelling the common factor `2 ^ classGroupTwoRank F` gives
`#(V/U) = 2 ^ unitTwoRank F`, as claimed: the extra `unitTwoRank F` dimensions of `V/S` over
`U/S` are precisely the classes killed by passing from `V` to `U` (the local/unit relations).
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

theorem card_quotient_VTwo_VTwoUnramified_eq_two_pow
    (F : Type*) [Field F] [NumberField F]
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2)
    (h : Nat.card (↥(Work.ShafarevichKoch.VTwoUnramified F M) ⧸
          ((Work.QuadraticFields.squareSubgroup Fˣ).comap
            (Work.ShafarevichKoch.VTwoUnramified F M).subtype))
        = 2 ^ Work.ClassFieldTower.classGroupTwoRank F) :
    Nat.card (↥(Work.ShafarevichKoch.VTwo F) ⧸
      (Work.ShafarevichKoch.VTwoUnramified F M).subgroupOf (Work.ShafarevichKoch.VTwo F))
      = 2 ^ Work.ClassFieldTower.unitTwoRank F := by
  -- the squares lie in the unramified radical
  have hSU : Work.QuadraticFields.squareSubgroup Fˣ ≤ VTwoUnramified F M := by
    rw [Work.QuadraticFields.squareSubgroup]
    exact (Subgroup.closure_le (VTwoUnramified F M)).mpr (fun x hx => by
      rw [Set.mem_range] at hx
      obtain ⟨y, rfl⟩ := hx
      exact sq_mem_VTwoUnramified F M y)
  -- the unramified radical lies in Koch's radical
  have hUV : VTwoUnramified F M ≤ VTwo F := VTwoUnramified_le_VTwo F M
  -- the tower for relative indices
  have key := Subgroup.relIndex_mul_relIndex (H := Work.QuadraticFields.squareSubgroup Fˣ)
      (K := VTwoUnramified F M) (L := VTwo F) hSU hUV
  -- `#(U/S) = 2 ^ classGroupTwoRank F` is the hypothesis
  have hSUrel : (Work.QuadraticFields.squareSubgroup Fˣ).relIndex (VTwoUnramified F M)
      = 2 ^ Work.ClassFieldTower.classGroupTwoRank F := h
  -- `#(V/S) = 2 ^ (unitTwoRank F + classGroupTwoRank F)`
  have hSVrel : (Work.QuadraticFields.squareSubgroup Fˣ).relIndex (VTwo F)
      = 2 ^ (Work.ClassFieldTower.unitTwoRank F + Work.ClassFieldTower.classGroupTwoRank F) :=
    card_quotient_VTwo F
  -- cancel the common factor `2 ^ classGroupTwoRank F`
  have heq : 2 ^ Work.ClassFieldTower.classGroupTwoRank F
        * (VTwoUnramified F M).relIndex (VTwo F)
      = 2 ^ Work.ClassFieldTower.classGroupTwoRank F
        * 2 ^ Work.ClassFieldTower.unitTwoRank F := by
    calc 2 ^ Work.ClassFieldTower.classGroupTwoRank F * (VTwoUnramified F M).relIndex (VTwo F)
        = (Work.QuadraticFields.squareSubgroup Fˣ).relIndex (VTwoUnramified F M)
            * (VTwoUnramified F M).relIndex (VTwo F) := by rw [hSUrel]
      _ = (Work.QuadraticFields.squareSubgroup Fˣ).relIndex (VTwo F) := key
      _ = 2 ^ (Work.ClassFieldTower.unitTwoRank F + Work.ClassFieldTower.classGroupTwoRank F) :=
            hSVrel
      _ = 2 ^ Work.ClassFieldTower.unitTwoRank F * 2 ^ Work.ClassFieldTower.classGroupTwoRank F :=
            pow_add 2 _ _
      _ = 2 ^ Work.ClassFieldTower.classGroupTwoRank F
            * 2 ^ Work.ClassFieldTower.unitTwoRank F := mul_comm _ _
  exact mul_left_cancel₀ (pow_ne_zero _ (by norm_num : (2:ℕ) ≠ 0)) heq

end Work.ShafarevichKoch
