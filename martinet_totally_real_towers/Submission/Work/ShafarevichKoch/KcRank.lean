import Mathlib
import Submission.Work.ShafarevichKoch.Defs
import Submission.Work.ShafarevichKoch.CardKc
import Submission.Work.ShafarevichKoch.classGroupTwoRank_Kc_le

/-!
# `Work.ShafarevichKoch.KcRank` -- the arithmetic identification for `Kc = ℚ(√-30030)`

The two halves of the *generator half* of the Shafarevich--Koch theorem for the concrete field
`Kc = ℚ(√-30030)`, both now unconditional:

* **the class-group side**: `rank₂ Cl(Kc) = 5`, i.e. the `2`-rank of the class group of `Kc` equals
  `ω(disc Kc) - 1 = 6 - 1`.  This combines the explicit `2^5` independent `2`-torsion classes of
  `Work.ClassFieldTower.five_le_classGroupTwoRank` with the genus-theory upper bound
  `classGroupTwoRank_Kc_le` (every `2`-torsion class is generated by the classes of the ramified
  primes);
* **the Kummer side**: every family of pairwise distinct unramified quadratic subextensions of
  `Kc_∅` has at most `2 ^ rank₂ Cl(Kc) = 32` members
  (`card_unramifiedQuadraticLevels_le_Kc`, sharpened here to the numerical value), so that
  `dim_{F₂} H¹(G_∅, F₂) ≤ 5`.

Together with the genus level of `Kc` (`Work.ClassFieldTower.hasGenusLevel_witness`: an unramified
exponent-`2` extension of degree `2 ^ 5`, giving `5 ≤ d(G_∅)`), this gives
`d(G_∅) = rank₂ Cl(Kc) = 5` modulo the standard identification of `d(G_∅)` with
`log₂ (1 + #{unramified quadratic extensions})` (equivalently with the number of closed
index-`2` subgroups of `G_∅`), which is the finite continuous Galois-cohomology statement
`dim_{F₂} H¹(G_∅, F₂) = d(G_∅)`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open scoped nonZeroDivisors
open scoped NumberField
open NumberField

noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-- **`rank₂ Cl(Kc) = 5`.**  The genus-theory lower bound (`five_le_classGroupTwoRank`: `2 ^ 5`
independent `2`-torsion classes, exhibited from the five ramified primes `3, 5, 7, 11, 13`) and the
genus-theory upper bound (`classGroupTwoRank_Kc_le`) pin the `2`-rank of the class group of
`Kc = ℚ(√-30030)` to `ω(disc Kc) - 1 = 5`. -/
theorem classGroupTwoRank_Kc : classGroupTwoRank Kc = 5 :=
  le_antisymm classGroupTwoRank_Kc_le five_le_classGroupTwoRank

/-- **The Kummer upper bound for `Kc`, numerically.**  Every family of pairwise distinct unramified
quadratic subextensions of `Kc_∅` has at most `32 = 2 ^ 5` members, i.e.
`dim_{F₂} H¹(G_∅, F₂) ≤ 5`. -/
theorem card_unramifiedQuadraticLevels_le_Kc_thirtytwo {ι : Type*} [Fintype ι]
    (M : MaximalUnramifiedProP.{0} Kc 2)
    (L : ι → IntermediateField Kc M.K) (hNF : ∀ i, NumberField ↥(L i))
    (hfd : ∀ i, FiniteDimensional Kc (L i)) (hgal : ∀ i, IsGalois Kc (L i))
    (h2 : ∀ i, Module.finrank Kc (L i) = 2) (hinj : Function.Injective L) :
    Fintype.card ι ≤ 2 ^ 5 := by
  refine (card_unramifiedQuadraticLevels_le_Kc M L hNF hfd hgal h2 hinj).trans ?_
  rw [classGroupTwoRank_Kc]

end Work.ShafarevichKoch
