import Mathlib
import Submission.Work.ConCohomology.All

/-!
# `#H¹(N, 𝔽₂) ≤ 2 ^ s` when `N` is generated by `s` elements

**Module** `Submission.Work.ShafarevichKoch.natCard_H1_le_two_pow_of_normalClosure`.

For a topological group `N` acting trivially on `𝔽₂ = ZMod 2`,

  `H¹(N, 𝔽₂) ≃ ContAddHom N (ZMod 2)`

(`Work.ConCohomology.H1EquivContAddHom`), the group of *continuous additive* homomorphisms
`N → 𝔽₂`.  Evaluating such a homomorphism at a generating set `x : Fin s → N` is injective
(a homomorphism to an abelian group is determined by its values on a set of generators, and the
condition `Subgroup.normalClosure (Set.range x) = ⊤` is exactly "`x` generates `N`"), so

  `#H¹(N, 𝔽₂) ≤ #(Fin s → 𝔽₂) = 2 ^ s`.

This is the counting step behind the Shafarevich--Koch / Golod--Shafarevich generator bounds: the
`𝔽₂`-dual of the generator rank bounds `H¹`, and the lemma is stated for the discrete coefficient
module `𝔽₂` with trivial action so that it applies to a profinite group `N` with `N` acting
trivially on the residue field.

## Proof

Two consequences of additivity of `φ : ContAddHom N M` are recorded first
(`ContAddHom.map_one_eq_zero`, `ContAddHom.map_inv_eq_neg`); they show that for `φ ψ` agreeing on
the generators, the set `{n | φ n = ψ n}` is a *normal* subgroup containing `Set.range x`.  Its
normal closure is therefore `⊤` (the hypothesis), so `φ = ψ`, and evaluation at the generators is
injective.  The bound follows from `Nat.card_le_card_of_injective` and
`#(Fin s → ZMod 2) = 2 ^ s`.
-/

namespace Work.ShafarevichKoch

open Work.ConCohomology

/-- An additive homomorphism from the group `G` (written multiplicatively) to `M` (written
additively) sends `1` to `0`. -/
lemma ContAddHom.map_one_eq_zero {G : Type*} [Group G] [TopologicalSpace G]
    {M : Type*} [AddCommGroup M] (φ : ContAddHom G M) : φ 1 = 0 := by
  have h2 : φ 1 = φ 1 + φ 1 := by simpa using ContAddHom.map_mul φ (1 : G) 1
  have h3 : φ 1 + 0 = φ 1 + φ 1 := by rw [← h2, add_zero]
  exact (add_left_cancel h3).symm

/-- An additive homomorphism from the group `G` to `M` sends inverses to negatives. -/
lemma ContAddHom.map_inv_eq_neg {G : Type*} [Group G] [TopologicalSpace G]
    {M : Type*} [AddCommGroup M] (φ : ContAddHom G M) (σ : G) : φ σ⁻¹ = - φ σ := by
  have h : φ σ⁻¹ + φ σ = 0 := by
    rw [add_comm, ← ContAddHom.map_mul, mul_inv_cancel, ContAddHom.map_one_eq_zero]
  exact eq_neg_of_add_eq_zero_left h

/-- **`H¹` of a group generated by `s` elements, with trivial `𝔽₂`-action.**  If the normal
closure of the range of `x : Fin s → N` is all of `N`, then `H¹(N, 𝔽₂)` has at most `2 ^ s`
elements: a continuous additive homomorphism `N → 𝔽₂` is determined by its values on the
generators. -/
theorem natCard_H1_le_two_pow_of_normalClosure
    {N : Type*} [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
    [DistribMulAction N (ZMod 2)] [Work.ConCohomology.IsDiscreteGModule N (ZMod 2)]
    (htrivN : ∀ (n : N) (m : ZMod 2), n • m = m)
    (s : ℕ) (x : Fin s → N) (hx : Subgroup.normalClosure (Set.range x) = ⊤) :
    Nat.card (Work.ConCohomology.H1 N (ZMod 2)) ≤ 2 ^ s := by
  have hcard : Nat.card (Work.ConCohomology.H1 N (ZMod 2))
      = Nat.card (ContAddHom N (ZMod 2)) :=
    Nat.card_congr (H1EquivContAddHom (G := N) (M := ZMod 2) htrivN)
  rw [hcard]
  -- Evaluation at the generators is injective.
  have hinj : Function.Injective
      (fun φ : ContAddHom N (ZMod 2) => fun i : Fin s => φ (x i)) := by
    intro φ ψ h
    have hφ1 : φ (1 : N) = 0 := ContAddHom.map_one_eq_zero φ
    have hψ1 : ψ (1 : N) = 0 := ContAddHom.map_one_eq_zero ψ
    have hx' : ∀ i : Fin s, φ (x i) = ψ (x i) := fun i => congrFun h i
    -- the agreement set of `φ` and `ψ` is a normal subgroup containing the generators
    let K : Subgroup N :=
      { carrier := {n | φ n = ψ n}
        mul_mem' := by
          intro a b ha hb
          have ha' : φ a = ψ a := ha
          have hb' : φ b = ψ b := hb
          simp only [Set.mem_ofPred_eq, ContAddHom.map_mul, ha', hb']
        one_mem' := by
          show φ 1 = ψ 1
          rw [hφ1, hψ1]
        inv_mem' := by
          intro a ha
          have ha' : φ a = ψ a := ha
          simp only [Set.mem_ofPred_eq, ContAddHom.map_inv_eq_neg, ha'] }
    have hKnormal : K.Normal :=
      ⟨fun n hn g => by
        have hn' : φ n = ψ n := hn
        show φ (g * n * g⁻¹) = ψ (g * n * g⁻¹)
        simp only [ContAddHom.map_mul, ContAddHom.map_inv_eq_neg, hn']
        abel⟩
    have hsub : Set.range x ⊆ (K : Set N) := by
      rintro _ ⟨i, rfl⟩
      exact hx' i
    have hKle : Subgroup.normalClosure (Set.range x) ≤ K :=
      Subgroup.normalClosure_le_normal hsub
    have hKtop : K = ⊤ := top_le_iff.mp (by rw [← hx]; exact hKle)
    refine ContAddHom.ext fun n => ?_
    have : n ∈ K := by rw [hKtop]; trivial
    exact this
  refine (Nat.card_le_card_of_injective _ hinj).trans (le_of_eq ?_)
  rw [Nat.card_eq_fintype_card, Fintype.card_fun, Fintype.card_fin, ZMod.card]

end Work.ShafarevichKoch
