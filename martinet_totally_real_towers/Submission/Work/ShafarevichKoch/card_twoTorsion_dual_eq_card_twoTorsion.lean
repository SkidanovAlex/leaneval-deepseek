import Mathlib
import Submission.Work.ShafarevichKoch.card_quotient_two_eq_card_twoTorsion

/-!
# `Work.ShafarevichKoch.card_twoTorsion_dual_eq_card_twoTorsion`

**The `2`-torsion of the Pontryagin dual of a finite abelian group has as many elements as the
`2`-torsion of the group itself.**

For a finite additive abelian group `A`, the group of additive characters `A →+ Additive ℂˣ` whose
square is trivial is the group of homomorphisms `A → {±1} = Hom(A, ℤ/2)`, and

`#Hom(A, ℤ/2) = #(A ⧸ 2A) = #A[2]`,

the first equality because a character into a group of exponent `2` kills `2A` (and the `𝔽₂`-dual of
a finite dimensional `𝔽₂`-vector space has the same cardinality as the space), the second by the
elementary divisor count `|A| = |A[2]| · |2A| = |A/2A| · |2A|`.

This is the counting form of the classical statement that for a finite abelian group the
`2`-torsion of the dual is dual to the quotient by the doubles (Koch, *Galois theory of
`p`-extensions*), and it is the numerical input of the Shafarevich--Koch relation count: the number
of `𝔽₂`-characters of a group of exponent `2` equals the order of the group.

The proof is assembled from four cardinality computations:

* `homsIntoTwoTorsion` : the characters of order dividing `2` are the homomorphisms into the
  `2`-torsion subgroup `cplxTwoTorsion ≤ Additive ℂˣ` of the units of `ℂ`;
* `cplxTwoTorsionEquivZModTwo` : that subgroup is cyclic of order `2`, generated by `-1`, hence
  isomorphic to `ℤ/2` (`ZMod 2`);
* `quotientHomsEquiv` : homomorphisms `A → ℤ/2` kill the subgroup `2A` generated by the doubles of
  `A` and therefore factor through `A ⧸ 2A`;
* `natCard_addMonoidHom_zmodTwo_of_exponent_two` : for a finite abelian group of exponent `2` the `𝔽₂`-dual has the
  same cardinality (self-duality of finite dimensional vector spaces over `𝔽₂`), together with
  `Work.ShafarevichKoch.card_quotient_two_eq_card_twoTorsion` for `|A ⧸ 2A| = #A[2]`.
-/

set_option linter.style.haveILetI false

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

/-! ## 1. The `2`-torsion of `ℂˣ` -/

/-- The `2`-torsion subgroup `{x ∈ ℂˣ : x² = 1}` of the units of `ℂ`, written additively. -/
def cplxTwoTorsion : AddSubgroup (Additive ℂˣ) := (nsmulAddMonoidHom (2 : ℕ)).ker

lemma mem_cplxTwoTorsion (y : Additive ℂˣ) : y ∈ cplxTwoTorsion ↔ (2 : ℕ) • y = 0 := by
  rw [cplxTwoTorsion, AddMonoidHom.mem_ker, nsmulAddMonoidHom_apply]

/-- `-1` is a `2`-torsion element of `ℂˣ`. -/
lemma neg_one_mem_cplxTwoTorsion : (Additive.ofMul (-1 : ℂˣ)) ∈ cplxTwoTorsion := by
  rw [mem_cplxTwoTorsion, two_nsmul]
  show Additive.ofMul ((-1 : ℂˣ) * (-1)) = (0 : Additive ℂˣ)
  rw [show (-1 : ℂˣ) * (-1) = 1 from by simp]
  rfl

/-- The generator `-1` of the `2`-torsion of `ℂˣ`. -/
def cplxTwoTorsionGen : cplxTwoTorsion :=
  ⟨Additive.ofMul (-1 : ℂˣ), neg_one_mem_cplxTwoTorsion⟩

lemma cplxTwoTorsionGen_ne_zero : cplxTwoTorsionGen ≠ 0 := by
  intro h
  have h1 : (Additive.ofMul (-1 : ℂˣ)) = (0 : Additive ℂˣ) := congrArg Subtype.val h
  have h2 : (-1 : ℂˣ) = 1 := Additive.ofMul.injective h1
  have h3 : ((-1 : ℂˣ) : ℂ) = ((1 : ℂˣ) : ℂ) := congrArg (fun u : ℂˣ => (u : ℂ)) h2
  norm_num at h3

/-- The generator of the `2`-torsion of `ℂˣ` is killed by `2`. -/
lemma two_smul_cplxTwoTorsionGen : (((2 : ℕ)) : ℤ) • cplxTwoTorsionGen = 0 := by
  have h : (((2 : ℕ)) : ℤ) • cplxTwoTorsionGen = (2 : ℕ) • cplxTwoTorsionGen := rfl
  rw [h]
  apply Subtype.ext
  show (2 : ℕ) • (Additive.ofMul (-1 : ℂˣ)) = (0 : Additive ℂˣ)
  rw [two_nsmul]
  show Additive.ofMul ((-1 : ℂˣ) * (-1)) = (0 : Additive ℂˣ)
  rw [show (-1 : ℂˣ) * (-1) = 1 from by simp]
  rfl

/-- The map `ℤ/2 → cplxTwoTorsion` sending `1` to `-1`; it is the (unique) isomorphism. -/
def zmodTwoToCplxTwoTorsion : ZMod 2 →+ cplxTwoTorsion :=
  ZMod.lift 2
    ⟨(zmultiplesHom cplxTwoTorsion) cplxTwoTorsionGen,
      by rw [zmultiplesHom_apply]; exact two_smul_cplxTwoTorsionGen⟩

lemma zmodTwoToCplxTwoTorsion_zero : zmodTwoToCplxTwoTorsion 0 = 0 := map_zero _

lemma zmodTwoToCplxTwoTorsion_one : zmodTwoToCplxTwoTorsion 1 = cplxTwoTorsionGen := by
  have h : ((1 : ℤ) : ZMod 2) = 1 := by norm_num
  rw [← h]
  show ((ZMod.lift 2) ⟨(zmultiplesHom cplxTwoTorsion) cplxTwoTorsionGen, _⟩)
      (((1 : ℤ)) : ZMod 2) = cplxTwoTorsionGen
  rw [ZMod.lift_coe, zmultiplesHom_apply]
  norm_num

private lemma zmod_two_eq_zero_or_one (x : ZMod 2) : x = 0 ∨ x = 1 := by revert x; decide

lemma zmodTwoToCplxTwoTorsion_injective : Function.Injective zmodTwoToCplxTwoTorsion := by
  intro x y h
  rcases zmod_two_eq_zero_or_one x with rfl | rfl <;>
    rcases zmod_two_eq_zero_or_one y with rfl | rfl
  · rfl
  · rw [zmodTwoToCplxTwoTorsion_zero, zmodTwoToCplxTwoTorsion_one] at h
    exact absurd h.symm cplxTwoTorsionGen_ne_zero
  · rw [zmodTwoToCplxTwoTorsion_zero, zmodTwoToCplxTwoTorsion_one] at h
    exact absurd h cplxTwoTorsionGen_ne_zero
  · rfl

/-- Every element of the `2`-torsion of `ℂˣ` is `1` in additive notation or is `-1`: the
`2`-torsion of the units of a domain consists of `±1`. -/
lemma eq_zero_or_eq_gen_cplxTwoTorsion (y : cplxTwoTorsion) :
    y = 0 ∨ y = cplxTwoTorsionGen := by
  have hy : (2 : ℕ) • (y : Additive ℂˣ) = 0 := (mem_cplxTwoTorsion _).mp y.2
  have hy2 : (y : Additive ℂˣ) + (y : Additive ℂˣ) = 0 := by rwa [two_nsmul] at hy
  have hmul : Additive.toMul (y : Additive ℂˣ) * Additive.toMul (y : Additive ℂˣ) = 1 := by
    have h := congrArg Additive.toMul hy2
    simpa using h
  have hC : (((Additive.toMul (y : Additive ℂˣ)) : ℂˣ) : ℂ) ^ 2 = 1 := by
    rw [sq, ← Units.val_mul, hmul, Units.val_one]
  rcases sq_eq_one_iff.mp hC with h1 | h1
  · left
    apply Subtype.ext
    have hty : Additive.toMul (y : Additive ℂˣ) = 1 := Units.ext (by simpa using h1)
    show (y : Additive ℂˣ) = (0 : Additive ℂˣ)
    apply Additive.toMul.injective
    rw [hty]
    rfl
  · right
    apply Subtype.ext
    have hty : Additive.toMul (y : Additive ℂˣ) = -1 := Units.ext (by simpa using h1)
    show (y : Additive ℂˣ) = Additive.ofMul (-1 : ℂˣ)
    apply Additive.toMul.injective
    rw [hty]
    rfl

lemma zmodTwoToCplxTwoTorsion_surjective : Function.Surjective zmodTwoToCplxTwoTorsion := by
  intro y
  rcases eq_zero_or_eq_gen_cplxTwoTorsion y with h | h
  · exact ⟨0, by rw [zmodTwoToCplxTwoTorsion_zero, h]⟩
  · exact ⟨1, by rw [zmodTwoToCplxTwoTorsion_one, h]⟩

/-- **The `2`-torsion of `ℂˣ` is isomorphic to `ℤ/2`.** -/
def cplxTwoTorsionEquivZModTwo : cplxTwoTorsion ≃+ ZMod 2 :=
  (AddEquiv.ofBijective zmodTwoToCplxTwoTorsion
    ⟨zmodTwoToCplxTwoTorsion_injective, zmodTwoToCplxTwoTorsion_surjective⟩).symm

/-! ## 2. The `𝔽₂`-dual of a finite abelian group of exponent two -/

/-- A finite abelian group of exponent `2` has as many additive characters with values in `ℤ/2` as
it has elements: it is a finite dimensional vector space over `𝔽₂ = ℤ/2` and the dual of a finite
dimensional vector space has the same dimension. -/
theorem natCard_addMonoidHom_zmodTwo_of_exponent_two {V : Type*} [AddCommGroup V] [Finite V]
    (hV : ∀ x : V, x + x = 0) : Nat.card (V →+ ZMod 2) = Nat.card V := by
  haveI : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  letI : Module (ZMod 2) V :=
    AddCommGroup.zmodModule (n := 2) (fun x => by simpa [two_nsmul] using hV x)
  haveI : Module.Finite (ZMod 2) V := Module.Finite.of_finite
  haveI : Module.Finite (ZMod 2) (Module.Dual (ZMod 2) V) := inferInstance
  rw [Nat.card_congr (AddMonoidHom.toZModLinearMapEquiv 2).toEquiv]
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Module.Dual (ZMod 2) V)]
  rw [Subspace.dual_finrank_eq (K := ZMod 2) (V := V)]
  exact (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)).symm

/-! ## 3. Characters of order dividing two are the homomorphisms into the `2`-torsion -/

/-- Additive homomorphisms `A →+ Additive ℂˣ` killed by `2` are exactly the homomorphisms into the
`2`-torsion subgroup of `ℂˣ` (the twisting of a homomorphism to a subgroup and to the ambient
group). -/
noncomputable def homsIntoTwoTorsion (A : Type*) [AddCommGroup A] :
    {φ : A →+ Additive ℂˣ // (2 : ℕ) • φ = 0} ≃ (A →+ cplxTwoTorsion) where
  toFun φ := φ.1.codRestrict cplxTwoTorsion (fun a => (mem_cplxTwoTorsion _).mpr (by
    have h := congrArg (fun ψ : A →+ Additive ℂˣ => ψ a) φ.2
    rwa [AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply] at h))
  invFun g := ⟨cplxTwoTorsion.subtype.comp g, by
    apply AddMonoidHom.ext
    intro a
    rw [AddMonoidHom.nsmul_apply, AddMonoidHom.zero_apply, AddMonoidHom.comp_apply]
    exact (mem_cplxTwoTorsion _).mp (g a).2⟩
  left_inv φ := by
    apply Subtype.ext
    apply AddMonoidHom.ext
    intro a
    rfl
  right_inv g := by
    show (cplxTwoTorsion.subtype.comp g).codRestrict cplxTwoTorsion _ = g
    apply AddMonoidHom.ext
    intro a
    apply Subtype.ext
    rfl

/-! ## 4. The subgroup generated by the doubles -/

/-- The subgroup `2A` of `A` generated by the doubles of the elements of `A`. -/
def doublesSubgroup (A : Type*) [AddCommGroup A] : AddSubgroup A :=
  AddSubgroup.closure (Set.range (fun x : A => (2 : ℕ) • x))

/-- A homomorphism into a group of exponent `2` kills every double, hence `2A`. -/
lemma doublesSubgroup_le_ker (A : Type*) [AddCommGroup A] (f : A →+ ZMod 2) :
    doublesSubgroup A ≤ f.ker := by
  rw [doublesSubgroup, AddSubgroup.closure_le]
  rintro y ⟨x, rfl⟩
  show f ((2 : ℕ) • x) = 0
  rw [map_nsmul]
  have h2 : ∀ z : ZMod 2, (2 : ℕ) • z = 0 := by
    intro z
    fin_cases z <;> decide
  exact h2 (f x)

/-- The quotient `A ⧸ 2A` has exponent `2`. -/
lemma doublesSubgroup_quotient_add_self (A : Type*) [AddCommGroup A]
    (x : A ⧸ doublesSubgroup A) : x + x = 0 := by
  rw [← two_nsmul]
  induction x using QuotientAddGroup.induction_on with
  | _ a =>
    rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
    exact AddSubgroup.subset_closure ⟨a, rfl⟩

/-- Homomorphisms into `ℤ/2` from a group of exponent `2` are the same as homomorphisms from the
quotient by `2A`: every such homomorphism kills the doubles. -/
noncomputable def quotientHomsEquiv (A : Type*) [AddCommGroup A] (N : AddSubgroup A)
    (hN : ∀ f : A →+ ZMod 2, N ≤ f.ker) :
    (A →+ ZMod 2) ≃ (A ⧸ N →+ ZMod 2) where
  toFun f := QuotientAddGroup.lift N f (hN f)
  invFun g := g.comp (QuotientAddGroup.mk' N)
  left_inv f := by
    ext a
    rw [AddMonoidHom.comp_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.lift_mk']
  right_inv g := by
    show QuotientAddGroup.lift N (g.comp (QuotientAddGroup.mk' N)) (hN _) = g
    ext x
    rw [AddMonoidHom.comp_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.lift_mk']

/-! ## 5. The count -/

/-- **The `2`-torsion of the dual of a finite abelian group and the `2`-torsion of the group have
the same number of elements.** -/
theorem card_twoTorsion_dual_eq_card_twoTorsion (A : Type*) [AddCommGroup A] [Fintype A] :
    Nat.card {φ : A →+ Additive ℂˣ // (2 : ℕ) • φ = 0} =
      Nat.card {a : A // (2 : ℕ) • a = 0} := by
  classical
  -- characters of order dividing `2` are homomorphisms into the `2`-torsion of `ℂˣ`
  have h1 : Nat.card {φ : A →+ Additive ℂˣ // (2 : ℕ) • φ = 0}
      = Nat.card (A →+ cplxTwoTorsion) :=
    Nat.card_congr (homsIntoTwoTorsion A)
  -- the `2`-torsion of `ℂˣ` is `ℤ/2`
  have h2 : Nat.card (A →+ cplxTwoTorsion) = Nat.card (A →+ ZMod 2) :=
    Nat.card_congr (AddEquiv.addMonoidHomCongrRightEquiv cplxTwoTorsionEquivZModTwo)
  -- such characters factor through the quotient by the doubles
  have h3 : Nat.card (A →+ ZMod 2) = Nat.card (A ⧸ doublesSubgroup A →+ ZMod 2) :=
    Nat.card_congr (quotientHomsEquiv A (doublesSubgroup A) (doublesSubgroup_le_ker A))
  -- self-duality of the exponent-`2` quotient over `𝔽₂`
  have h4 : Nat.card (A ⧸ doublesSubgroup A →+ ZMod 2) = Nat.card (A ⧸ doublesSubgroup A) :=
    natCard_addMonoidHom_zmodTwo_of_exponent_two (doublesSubgroup_quotient_add_self A)
  -- `|A ⧸ 2A| = #A[2]`
  have h5 : Nat.card (A ⧸ doublesSubgroup A) = Nat.card {a : A // (2 : ℕ) • a = 0} :=
    card_quotient_two_eq_card_twoTorsion A
  rw [h1, h2, h3, h4, h5]

end Work.ShafarevichKoch
