import Mathlib
import Submission.Work.ConCohomology.All
import Submission.Work.ShafarevichKoch.ZModTwoTrivialAction

/-!
# `Work.ShafarevichKoch.natCard_ker_H2Res_le_two_pow` -- the section-free counting engine

Let `1 → N → G → Q → 1` be a topological group extension (`Work.ConCohomology.GroupExt`) with
`q : G → Q` continuous, **open** and surjective and `i` continuous, and let `𝔽₂ = ZMod 2` carry the
(automatically trivial, `smul_zmodTwo_eq`) actions.  If `N` is normally generated by `s` elements,
then

  `Finite (ker (H2Res E.q)) ∧ Nat.card (ker (H2Res E.q)) ≤ 2 ^ s`,

i.e. the kernel of the inflation `H²(Q,𝔽₂) → H²(G,𝔽₂)` is finite of cardinality at most `2^s`.

## The mathematics

This is the classical Shafarevich--Koch/Hochschild--Serre counting step (Hajir--Maire--Ramakrishnan,
arXiv:2103.09508, Lemma 1.1(ii)) in the form the counting route of the chapter needs, **without a
section** of `q`.  The proof is entirely section-free:

* `exists_coboundary_of_H2Res_eq_zero`: `H2Res E.q (H2.mk z) = 0` unwinds (through `H2Res_mk`,
  `H2.mk_eq_zero_iff`, `mem_B2`) to `∃ b : Cochain1 G 𝔽₂, d¹b (x,y) = z (q x, q y)`;
* `add_sum_of_coboundary`: for such a `b` the map `n ↦ b (i n) + z (1,1)` on `N` is **additive**
  (`φ(nm) = φ(n) + φ(m)`), the two inputs being `z (1,1) = b 1` and `q (i n) = 1`;
* `i_eq_const` and `descend_wellDefined`: for two classes `z`, `z'` in the kernel whose `φ`s agree
  on `N`, the difference `b - b'` is constant on `i(N)` and descends to a function on `Q`;
* the descent is **locally constant** exactly because `q` is **open**
  (`isLocallyConstant_of_isOpenMap`), and `d¹` of the descended function is `z - z'`; hence
  `z - z' ∈ B²(Q)` and the two classes coincide;
* consequently the assignment `[z] ↦ φ` is injective modulo the obvious ambiguity, and
  `#ker(H2Res) ≤ #Hom(N,𝔽₂) = #H¹(N,𝔽₂) ≤ 2^s`
  (`natCard_H1_le_two_pow_of_normalClosure`).

## Why `IsOpenMap` and not a continuous section

The section form of the statement is
`Work.ShafarevichKoch.natCard_ker_H2Res_le_two_pow_of_continuousSection` (also proved in this
directory).  The present statement is strictly stronger, since `IsOpenMap` + `Surjective` do *not*
give a continuous section (`S¹ → S¹`, `z ↦ z²`); the section is genuinely unavailable for the
Galois comparison `Gal(k_S/F) ↠ Gal(k_∅/F)` (`README.md` §15.1).  Conversely the hypothesis is not
removable: **without `IsOpenMap` the statement is false** (`README.md` §16.2), with the
counterexample `N = 1`, `s = 0`, `Q = ℤ/4` carrying the coset topology of `ℤ/4 ↠ ℤ/2`, `G = ℤ/4`
discrete, `q = id`, `z (x,y) = (x mod 2)(y mod 2)`.

For the intended application both hypotheses are supplied by the workspace:
`continuous_restrictToEmpty` and `isOpenMap_restrictToEmpty` (`SupportedComparison.lean`,
`continuous_restrictToEmpty.lean`, `isOpenMap_restrictToEmpty.lean`), and the `GroupExt` by
`SupportedGroupExt.groupExtHSupported`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

open Work.ConCohomology

variable {G Q N : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
  [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
  [DistribMulAction G (ZMod 2)] [DistribMulAction Q (ZMod 2)] [DistribMulAction N (ZMod 2)]
  [IsDiscreteGModule G (ZMod 2)] [IsDiscreteGModule Q (ZMod 2)] [IsDiscreteGModule N (ZMod 2)]

/-- `q (i n) = 1`. -/
theorem q_i (E : GroupExt G Q N) (n : N) : E.q (E.i n) = 1 := (E.ker_eq _).mpr ⟨n, rfl⟩

/-- **The coboundary criterion.** -/
theorem exists_coboundary_of_H2Res_eq_zero (E : GroupExt G Q N) (hq : Continuous E.q)
    (hcompG : ∀ (g : G) (m : ZMod 2), g • m = E.q g • m) (z : Z2 Q (ZMod 2))
    (hz : H2Res E.q hq hcompG (H2.mk z) = 0) :
    ∃ b : Cochain1 G (ZMod 2), ∀ p r : G,
      (z.1 : Q × Q → ZMod 2) (E.q p, E.q r) = d1Fun (b : G → ZMod 2) (p, r) := by
  classical
  rw [H2Res_mk, H2.mk_eq_zero_iff, mem_B2', mem_B2] at hz
  obtain ⟨b, hb⟩ := hz
  refine ⟨b, fun p r => ?_⟩
  have h0 := congrFun (congrArg (fun f : Cochain2 G (ZMod 2) => (f : G × G → ZMod 2)) hb) (p, r)
  rw [d1Hom_apply] at h0
  rw [Z2Res_coe, cochain2Res_apply] at h0
  exact h0.symm

/-- **Additivity of `n ↦ b (i n) + z (1,1)`.** -/
theorem add_sum_of_coboundary (E : GroupExt G Q N) (z : Z2 Q (ZMod 2)) (b : Cochain1 G (ZMod 2))
    (hb : ∀ p r : G, (z.1 : Q × Q → ZMod 2) (E.q p, E.q r) = d1Fun (b : G → ZMod 2) (p, r)) :
    ∀ n m : N, (b : G → ZMod 2) (E.i (n * m)) + (z.1 : Q × Q → ZMod 2) (1, 1)
      = ((b : G → ZMod 2) (E.i n) + (z.1 : Q × Q → ZMod 2) (1, 1))
        + ((b : G → ZMod 2) (E.i m) + (z.1 : Q × Q → ZMod 2) (1, 1)) := by
  intro n m
  have hnm := hb (E.i n) (E.i m)
  rw [q_i E n, q_i E m, d1Fun_apply, smul_zmodTwo_eq] at hnm
  rw [show E.i (n * m) = E.i n * E.i m from map_mul E.i n m]
  have h2 : (2 : ZMod 2) = 0 := by decide
  linear_combination (-1 : ZMod 2) * hnm
    + ((b : G → ZMod 2) (E.i n * E.i m) - (b : G → ZMod 2) (E.i n)
        - (b : G → ZMod 2) (E.i m)) * h2

/-- **The value of `b - b'` on `i (N)`.** -/
theorem i_eq_const (E : GroupExt G Q N) (z z' : Z2 Q (ZMod 2))
    (b b' : Cochain1 G (ZMod 2))
    (hφ : ∀ n : N, (b : G → ZMod 2) (E.i n) + (z.1 : Q × Q → ZMod 2) (1, 1)
      = (b' : G → ZMod 2) (E.i n) + (z'.1 : Q × Q → ZMod 2) (1, 1)) :
    ∀ n : N, (b : G → ZMod 2) (E.i n) - (b' : G → ZMod 2) (E.i n)
      = (z'.1 : Q × Q → ZMod 2) (1, 1) - (z.1 : Q × Q → ZMod 2) (1, 1) := by
  intro n
  have h := hφ n
  have h2 : (2 : ZMod 2) = 0 := by decide
  linear_combination (-1 : ZMod 2) * h
    + ((b : G → ZMod 2) (E.i n) - (b' : G → ZMod 2) (E.i n)
        + (z.1 : Q × Q → ZMod 2) (1, 1) - (z'.1 : Q × Q → ZMod 2) (1, 1)) * h2

/-- **Well-definedness of the descent.** -/
theorem descend_wellDefined (E : GroupExt G Q N) (z z' : Z2 Q (ZMod 2))
    (b b' : Cochain1 G (ZMod 2))
    (hb : ∀ p r : G, (z.1 : Q × Q → ZMod 2) (E.q p, E.q r) = d1Fun (b : G → ZMod 2) (p, r))
    (hb' : ∀ p r : G, (z'.1 : Q × Q → ZMod 2) (E.q p, E.q r) = d1Fun (b' : G → ZMod 2) (p, r))
    (hc : ∀ n : N, (b : G → ZMod 2) (E.i n) - (b' : G → ZMod 2) (E.i n)
      = (z'.1 : Q × Q → ZMod 2) (1, 1) - (z.1 : Q × Q → ZMod 2) (1, 1))
    {x x' : G} (hxx : E.q x = E.q x') :
    (b : G → ZMod 2) x - (b' : G → ZMod 2) x
      = (b : G → ZMod 2) x' - (b' : G → ZMod 2) x' := by
  have h1 : E.q (x⁻¹ * x') = 1 := by rw [map_mul, map_inv, hxx, inv_mul_cancel]
  obtain ⟨n, hn⟩ := (E.ker_eq _).mp h1
  have hx' : x' = x * E.i n := by rw [hn, mul_inv_cancel_left]
  -- `z (a, 1) = z (1,1)`, computed from the two cocycle identities at `(a,1)` and `(1,1)`
  have hz1 : (z.1 : Q × Q → ZMod 2) (E.q x, 1) = (z.1 : Q × Q → ZMod 2) (1, 1) := by
    have ha := hb x 1
    have hb1 := hb 1 1
    rw [map_one, d1Fun_apply, smul_zmodTwo_eq, mul_one, sub_add_cancel] at ha
    rw [map_one, d1Fun_apply, smul_zmodTwo_eq, mul_one, sub_self, zero_add] at hb1
    rw [ha, hb1]
  have hz1' : (z'.1 : Q × Q → ZMod 2) (E.q x, 1) = (z'.1 : Q × Q → ZMod 2) (1, 1) := by
    have ha := hb' x 1
    have hb1 := hb' 1 1
    rw [map_one, d1Fun_apply, smul_zmodTwo_eq, mul_one, sub_add_cancel] at ha
    rw [map_one, d1Fun_apply, smul_zmodTwo_eq, mul_one, sub_self, zero_add] at hb1
    rw [ha, hb1]
  rw [hx']
  have h1' := hb x (E.i n)
  have h2' := hb' x (E.i n)
  rw [q_i E n, d1Fun_apply, smul_zmodTwo_eq] at h1' h2'
  rw [hz1] at h1'
  rw [hz1'] at h2'
  have hcn := hc n
  have h2 : (2 : ZMod 2) = 0 := by decide
  linear_combination (-1 : ZMod 2) * h1' + h2' + hcn
    + ((b' : G → ZMod 2) (E.i n) - (b : G → ZMod 2) (E.i n)) * h2

/-- **The zero set of an additive map `N → 𝔽₂` is a normal subgroup.** -/
def addHomKernel {N : Type*} [Group N] (f : N → ZMod 2) (h1 : f 1 = 0)
    (hmul : ∀ n m : N, f (n * m) = f n + f m) : Subgroup N where
  carrier := {n | f n = 0}
  mul_mem' := by
    intro a b (ha : f a = 0) (hb : f b = 0)
    show f (a * b) = 0
    rw [hmul, ha, hb, add_zero]
  one_mem' := h1
  inv_mem' := by
    intro a (ha : f a = 0)
    show f a⁻¹ = 0
    have h := hmul a a⁻¹; rw [mul_inv_cancel, h1, ha, zero_add] at h
    exact h.symm

/-- the membership characterisation -/
@[simp] theorem mem_addHomKernel {N : Type*} [Group N] (f : N → ZMod 2) (h1 : f 1 = 0)
    (hmul : ∀ n m : N, f (n * m) = f n + f m) (n : N) :
    n ∈ addHomKernel f h1 hmul ↔ f n = 0 := Iff.rfl

theorem addHomKernel_normal {N : Type*} [Group N] (f : N → ZMod 2) (h1 : f 1 = 0)
    (hmul : ∀ n m : N, f (n * m) = f n + f m) : (addHomKernel f h1 hmul).Normal := by
  refine ⟨fun n hn g => ?_⟩
  have hg : f g⁻¹ = - f g := by
    have h := hmul g g⁻¹; rw [mul_inv_cancel] at h
    have h2 : f g⁻¹ + f g = 0 := by rw [add_comm, ← h]; exact h1
    exact eq_neg_of_add_eq_zero_left h2
  have hn' : f n = 0 := hn
  show f (g * n * g⁻¹) = 0
  rw [mul_assoc, hmul g (n * g⁻¹), hmul n g⁻¹, hn', zero_add, hg, add_neg_cancel]
theorem zeroSet_normal {N : Type*} [Group N] (f : N → ZMod 2) (h1 : f 1 = 0)
    (hmul : ∀ n m : N, f (n * m) = f n + f m) :
    ({ carrier := {n | f n = 0},
        mul_mem' := fun {a b} ha hb => by
          have ha' : f a = 0 := ha; have hb' : f b = 0 := hb
          show f (a * b) = 0
          rw [hmul, ha', hb', add_zero],
        one_mem' := h1,
        inv_mem' := fun {a} ha => by
          have ha' : f a = 0 := ha
          have h := hmul a a⁻¹; rw [mul_inv_cancel, h1, ha', zero_add] at h
          exact h.symm } : Subgroup N).Normal :=
  ⟨fun n hn g => by
    have hg : f g⁻¹ = - f g := by
      have h := hmul g g⁻¹; rw [mul_inv_cancel] at h
      have h2 : f g⁻¹ + f g = 0 := by rw [add_comm, ← h]; exact h1
      exact eq_neg_of_add_eq_zero_left h2
    have hn' : f n = 0 := hn
    show f (g * n * g⁻¹) = 0
    rw [mul_assoc, hmul g (n * g⁻¹), hmul n g⁻¹, hn', zero_add, hg, add_neg_cancel]⟩

/-- **The section-free counting engine.** -/
theorem natCard_ker_H2Res_le_two_pow (E : GroupExt G Q N) (hq : Continuous E.q)
    (hop : IsOpenMap E.q) (hsurj : Function.Surjective E.q) (hi : Continuous E.i)
    (hcompG : ∀ (g : G) (m : ZMod 2), g • m = E.q g • m)
    (s : ℕ) (x : Fin s → N) (hx : Subgroup.normalClosure (Set.range x) = ⊤) :
    Finite (AddMonoidHom.ker (H2Res E.q hq hcompG)) ∧
      Nat.card (AddMonoidHom.ker (H2Res E.q hq hcompG)) ≤ 2 ^ s := by
  classical
  let Z : ↥(AddMonoidHom.ker (H2Res E.q hq hcompG)) → Z2 Q (ZMod 2) := fun y =>
    Classical.choose (QuotientAddGroup.mk_surjective y.1)
  have hZ : ∀ y, H2.mk (Z y) = y.1 := fun y =>
    Classical.choose_spec (QuotientAddGroup.mk_surjective y.1)
  have hZk : ∀ y, H2Res E.q hq hcompG (H2.mk (Z y)) = 0 := fun y => by rw [hZ y]; exact y.2
  let B : ↥(AddMonoidHom.ker (H2Res E.q hq hcompG)) → Cochain1 G (ZMod 2) := fun y =>
    Classical.choose (exists_coboundary_of_H2Res_eq_zero E hq hcompG (Z y) (hZk y))
  have hB : ∀ y p r, ((Z y).1 : Q × Q → ZMod 2) (E.q p, E.q r)
      = d1Fun ((B y) : G → ZMod 2) (p, r) := fun y =>
    Classical.choose_spec (exists_coboundary_of_H2Res_eq_zero E hq hcompG (Z y) (hZk y))
  let Φ : ↥(AddMonoidHom.ker (H2Res E.q hq hcompG)) → (Fin s → ZMod 2) := fun y i =>
    ((B y) : G → ZMod 2) (E.i (x i)) + ((Z y).1 : Q × Q → ZMod 2) (1, 1)
  have hinj : Function.Injective Φ := by
    intro y y' hyy'
    have hgen : ∀ i : Fin s,
        ((B y) : G → ZMod 2) (E.i (x i)) + ((Z y).1 : Q × Q → ZMod 2) (1, 1)
        = ((B y') : G → ZMod 2) (E.i (x i)) + ((Z y').1 : Q × Q → ZMod 2) (1, 1) :=
      fun i => congrFun hyy' i
    let Psi : N → ZMod 2 := fun n => ((B y) : G → ZMod 2) (E.i n)
      + ((Z y).1 : Q × Q → ZMod 2) (1, 1)
      - (((B y') : G → ZMod 2) (E.i n) + ((Z y').1 : Q × Q → ZMod 2) (1, 1))
    have hadd : ∀ n m : N, Psi (n * m) = Psi n + Psi m := by
      intro n m
      have h1 := add_sum_of_coboundary E (Z y) (B y) (hB y) n m
      have h2 := add_sum_of_coboundary E (Z y') (B y') (hB y') n m
      show (((B y) : G → ZMod 2) (E.i (n * m)) + ((Z y).1 : Q × Q → ZMod 2) (1, 1))
          - (((B y') : G → ZMod 2) (E.i (n * m)) + ((Z y').1 : Q × Q → ZMod 2) (1, 1))
        = (((B y) : G → ZMod 2) (E.i n) + ((Z y).1 : Q × Q → ZMod 2) (1, 1))
            - (((B y') : G → ZMod 2) (E.i n) + ((Z y').1 : Q × Q → ZMod 2) (1, 1))
          + ((((B y) : G → ZMod 2) (E.i m) + ((Z y).1 : Q × Q → ZMod 2) (1, 1))
            - (((B y') : G → ZMod 2) (E.i m) + ((Z y').1 : Q × Q → ZMod 2) (1, 1)))
      rw [h1, h2]
      abel
    have hPsi1 : Psi 1 = 0 := by
      have h := hadd 1 1
      rw [mul_one] at h
      have h' := congrArg (fun z => z - Psi 1) h
      simpa using h'.symm
    have hnormal : (addHomKernel Psi hPsi1 hadd).Normal := addHomKernel_normal Psi hPsi1 hadd
    haveI := hnormal
    have hle : Subgroup.normalClosure (Set.range x) ≤ addHomKernel Psi hPsi1 hadd :=
      Subgroup.normalClosure_le_normal (fun n hn => by
        obtain ⟨i, rfl⟩ := hn
        show Psi (x i) = 0
        have := hgen i
        simp only [Psi]
        rw [← this]
        abel)
    rw [hx] at hle
    have hφ : ∀ n : N,
        ((B y) : G → ZMod 2) (E.i n) + ((Z y).1 : Q × Q → ZMod 2) (1, 1)
        = ((B y') : G → ZMod 2) (E.i n) + ((Z y').1 : Q × Q → ZMod 2) (1, 1) := by
      intro n
      have hmem : Psi n = 0 := hle (Subgroup.mem_top n)
      have hmem' : ((B y) : G → ZMod 2) (E.i n) + ((Z y).1 : Q × Q → ZMod 2) (1, 1)
          - (((B y') : G → ZMod 2) (E.i n) + ((Z y').1 : Q × Q → ZMod 2) (1, 1)) = 0 := hmem
      exact sub_eq_zero.mp hmem'
    -- the difference `D = B y - B y'` descends to `Q`
    let D : Cochain1 G (ZMod 2) := (B y) - (B y')
    have hDcoe : ∀ g : G, (D : G → ZMod 2) g
        = ((B y) : G → ZMod 2) g - ((B y') : G → ZMod 2) g := fun g => rfl
    have hDconst : ∀ n : N, (D : G → ZMod 2) (E.i n)
        = ((Z y').1 : Q × Q → ZMod 2) (1, 1) - ((Z y).1 : Q × Q → ZMod 2) (1, 1) := by
      intro n
      rw [hDcoe]
      exact i_eq_const E (Z y) (Z y') (B y) (B y') hφ n
    have hDwell : ∀ {p p' : G}, E.q p = E.q p' →
        (D : G → ZMod 2) p = (D : G → ZMod 2) p' := by
      intro p p' hpp'
      rw [hDcoe, hDcoe]
      exact descend_wellDefined E (Z y) (Z y') (B y) (B y') (hB y) (hB y') hDconst hpp'
    let W : Q → ZMod 2 := fun a => (D : G → ZMod 2) (Classical.choose (hsurj a))
    have hWq : ∀ g : G, W (E.q g) = (D : G → ZMod 2) g := fun g =>
      hDwell (Classical.choose_spec (hsurj (E.q g)))
    have hWc : IsLocallyConstant W := by
      apply isLocallyConstant_of_isOpenMap hop hsurj
      rw [show (W ∘ E.q) = (D : G → ZMod 2) from funext hWq]
      exact (D : Cochain1 G (ZMod 2)).isLocallyConstant
    let Wc : Cochain1 Q (ZMod 2) := ⟨W, hWc⟩
    have hdW : (d1Hom Q (ZMod 2) Wc : Cochain2 Q (ZMod 2))
        = ((Z y - Z y' : Z2 Q (ZMod 2)) : Cochain2 Q (ZMod 2)) := by
      ext p
      obtain ⟨a, b⟩ := p
      obtain ⟨p₁, hp₁⟩ := hsurj a
      obtain ⟨p₂, hp₂⟩ := hsurj b
      rw [← hp₁, ← hp₂]
      show d1Fun (G := Q) (Wc : Q → ZMod 2) (E.q p₁, E.q p₂)
        = ((Z y).1 : Q × Q → ZMod 2) (E.q p₁, E.q p₂)
          - ((Z y').1 : Q × Q → ZMod 2) (E.q p₁, E.q p₂)
      rw [hB y p₁ p₂, hB y' p₁ p₂]
      rw [d1Fun_apply, d1Fun_apply, d1Fun_apply]
      change (E.q p₁) • W (E.q p₂) - W (E.q p₁ * E.q p₂) + W (E.q p₁)
        = (p₁ • (B y) p₂ - (B y) (p₁ * p₂) + (B y) p₁)
          - (p₁ • (B y') p₂ - (B y') (p₁ * p₂) + (B y') p₁)
      rw [← map_mul, hWq (p₁ * p₂), hWq p₂, hWq p₁]
      simp only [smul_zmodTwo_eq]
      rw [hDcoe p₂, hDcoe (p₁ * p₂), hDcoe p₁]
      abel
    have hB2 : (Z y - Z y' : Z2 Q (ZMod 2)) ∈ B2' Q (ZMod 2) := by
      rw [mem_B2', mem_B2]
      exact ⟨Wc, hdW⟩
    have hmk : H2.mk (Z y) = H2.mk (Z y') := by
      rw [H2.mk_eq_mk_iff]
      exact hB2
    exact Subtype.ext (by rw [← hZ y, ← hZ y', hmk])
  refine ⟨Finite.of_injective Φ hinj, ?_⟩
  have h := Nat.card_le_card_of_injective Φ hinj
  have hcard : Nat.card (Fin s → ZMod 2) = 2 ^ s := by
    rw [Nat.card_fun, Nat.card_fin, Nat.card_eq_fintype_card, ZMod.card]
  rwa [hcard] at h

end Work.ShafarevichKoch
