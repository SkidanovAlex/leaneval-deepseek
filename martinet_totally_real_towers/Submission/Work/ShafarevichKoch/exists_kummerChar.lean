import Mathlib
import Submission.Work.ShafarevichKoch.KummerPairing
import Submission.Work.ShafarevichKoch.GeneratorRank
import Submission.Work.ShafarevichKoch.isGalois_of_finrank_eq_two
import Submission.Work.ShafarevichKoch.nonempty_proTwoCharEquiv_option_quadraticLevel

/-!
# `Work.ShafarevichKoch.exists_kummerChar`

**The Kummer character of a square root of a unit.**

Let `F` be a number field, `F_∅ = M.K` its maximal unramified pro-`2` extension,
`G_∅ = Gal(F_∅/F)`, and let `b ∈ F_∅`, `x ∈ Fˣ` with `b * b = x`.  The elementary
Kummer computation (`Work.ShafarevichKoch.kummerPairing_sq`) shows that every `σ ∈ G_∅`
acts on `b` by a sign, `σ b = ± b`.  The assignment
`σ ↦ σ b / b ∈ μ₂ = {±1}` is multiplicative, so it defines a homomorphism
`G_∅ → 𝔽₂` whose kernel is the stabiliser of `b`; since the stabiliser is the fixing
subgroup of the (at most quadratic) field `F(b)`, it is open, hence the homomorphism is
continuous.

This module constructs that character and proves that its kernel is exactly the stabiliser
of `b`, i.e. `χ σ = 1 ↔ σ b = b`.  The construction goes through the already established
correspondence between continuous characters `G_∅ → 𝔽₂` and quadratic levels of `F_∅/F`
(`Work.ShafarevichKoch.exists_proTwoChar_ker_eq`): if `b ∉ F` then `F(b)` is a quadratic
level and the character cutting it out is the one sought; if `b ∈ F` the trivial character
does the job.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

open scoped Classical
open Work.ClassFieldTower

noncomputable section

namespace Work.ShafarevichKoch

variable {F : Type*} [Field F] [NumberField F]

/-- A square root `b` of the image of a unit is nonzero (the algebra map of a field is
injective). -/
lemma kummer_sq_root_ne_zero (M : MaximalUnramifiedProP.{0} F 2) (x : Fˣ) (b : M.K)
    (hb : b * b = algebraMap F M.K (x : F)) : b ≠ 0 := by
  have hx0 : (x : F) ≠ 0 := x.ne_zero
  have ha0 : algebraMap F M.K (x : F) ≠ 0 := by
    rw [← map_zero (algebraMap F M.K)]
    exact fun h => hx0 ((algebraMap F M.K).injective h)
  intro h
  rw [h, mul_zero] at hb
  exact ha0 hb.symm

/-- A square root of the image of a unit is integral over `F` (it is a root of `X ^ 2 - x`). -/
lemma isIntegral_kummer_sq_root (M : MaximalUnramifiedProP.{0} F 2) (x : Fˣ) (b : M.K)
    (hb : b * b = algebraMap F M.K (x : F)) : IsIntegral F b := by
  refine ⟨(Polynomial.X ^ 2 - Polynomial.C (x : F) : Polynomial F), ?_, ?_⟩
  · exact Polynomial.monic_X_pow_sub_C (x : F) (n := 2) (by norm_num)
  · rw [Polynomial.eval₂_sub, Polynomial.eval₂_pow, Polynomial.eval₂_X, Polynomial.eval₂_C,
      pow_two, hb, sub_self]

/-- **The field generated by a square root of a unit is at most quadratic.**  Since `b` is a
root of `X ^ 2 - x`, its minimal polynomial has degree at most `2`. -/
lemma finrank_adjoin_kummer_le_two (M : MaximalUnramifiedProP.{0} F 2) (x : Fˣ) (b : M.K)
    (hb : b * b = algebraMap F M.K (x : F)) :
    Module.finrank F (IntermediateField.adjoin F ({b} : Set M.K)) ≤ 2 := by
  have hint : IsIntegral F b := isIntegral_kummer_sq_root M x b hb
  rw [IntermediateField.adjoin.finrank hint]
  have hdvd : minpoly F b ∣ (Polynomial.X ^ 2 - Polynomial.C (x : F) : Polynomial F) := by
    apply minpoly.dvd
    simp only [map_sub, map_mul, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, pow_two, hb,
      sub_self]
  have hq : (Polynomial.X ^ 2 - Polynomial.C (x : F) : Polynomial F) ≠ 0 := by
    intro h
    have h2 := Polynomial.natDegree_X_pow_sub_C (n := 2) (r := (x : F))
    rw [h] at h2
    simp at h2
  calc (minpoly F b).natDegree
      ≤ (Polynomial.X ^ 2 - Polynomial.C (x : F) : Polynomial F).natDegree :=
        Polynomial.natDegree_le_of_dvd hdvd hq
    _ = 2 := Polynomial.natDegree_X_pow_sub_C

/-- **The stabiliser of `b` is the fixing subgroup of `F(b)`.** -/
lemma fixingSubgroup_adjoin_eq_stabilizer (M : MaximalUnramifiedProP.{0} F 2) (x : Fˣ) (b : M.K)
    (hb : b * b = algebraMap F M.K (x : F)) (σ : galoisGroup M) :
    σ ∈ (IntermediateField.adjoin F ({b} : Set M.K)).fixingSubgroup ↔ σ b = b := by
  have hbL : b ∈ IntermediateField.adjoin F ({b} : Set M.K) :=
    IntermediateField.mem_adjoin_simple_self F b
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h
    exact h b hbL
  · intro h y hy
    exact IntermediateField.adjoin_induction F (s := ({b} : Set M.K)) (p := fun y _ => σ y = y)
      (fun z hz => by
        rw [Set.mem_singleton_iff] at hz
        rw [hz]
        exact h)
      (fun c => σ.commutes c)
      (fun y z _ _ hy hz => by rw [map_add, hy, hz])
      (fun y _ hy => by rw [map_inv₀, hy])
      (fun y z _ _ hy hz => by rw [map_mul, hy, hz]) hy

theorem exists_kummerChar (F : Type*) [Field F] [NumberField F]
    (M : Work.ClassFieldTower.MaximalUnramifiedProP.{0} F 2) (x : Fˣ) (b : M.K)
    (hb : b * b = algebraMap F M.K (x : F)) :
    ∃ χ : Work.ShafarevichKoch.ProTwoChar F M,
      ∀ σ : Work.ClassFieldTower.galoisGroup M,
        ((χ : Work.ClassFieldTower.galoisGroup M →* Multiplicative (ZMod 2)) σ = 1 ↔ σ b = b) := by
  classical
  set L : IntermediateField F M.K := IntermediateField.adjoin F ({b} : Set M.K) with hL
  have hbL : b ∈ L := by
    rw [hL]
    exact IntermediateField.mem_adjoin_simple_self F b
  haveI hfinL : FiniteDimensional F L := by
    rw [hL]
    exact IntermediateField.adjoin.finiteDimensional (isIntegral_kummer_sq_root M x b hb)
  have hmem : ∀ σ : galoisGroup M, σ ∈ L.fixingSubgroup ↔ σ b = b := by
    intro σ
    rw [hL]
    exact fixingSubgroup_adjoin_eq_stabilizer M x b hb σ
  by_cases hbF : b ∈ (⊥ : IntermediateField F M.K)
  · -- `b` lies in the base field: every `σ` fixes it, so the trivial character works.
    obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hbF
    refine ⟨⟨1, continuous_const⟩, fun σ => ?_⟩
    have hfix : σ b = b := by
      rw [← hc, AlgEquiv.commutes]
    rw [hfix]
    simp
  · -- `F(b)` is a genuine quadratic level; take the character cutting it out.
    have hLne : L ≠ ⊥ := by
      intro h
      exact hbF (h ▸ hbL)
    have hfin_ne_one : Module.finrank F L ≠ 1 := fun h =>
      hLne (IntermediateField.finrank_eq_one_iff.mp h)
    have hfin_le : Module.finrank F L ≤ 2 := by
      rw [hL]
      exact finrank_adjoin_kummer_le_two M x b hb
    have hfin_pos : 0 < Module.finrank F L := Module.finrank_pos
    have hL2 : Module.finrank F L = 2 := by omega
    obtain ⟨χ, hχ⟩ := exists_proTwoChar_ker_eq M (⟨L, hL2⟩ : QuadraticLevel F M)
    have hker : χ.1.ker = L.fixingSubgroup := hχ
    refine ⟨χ, fun σ => ?_⟩
    rw [show (χ.1 σ = 1) ↔ σ ∈ L.fixingSubgroup from by
      rw [← MonoidHom.mem_ker, hker], hmem σ]

end Work.ShafarevichKoch
