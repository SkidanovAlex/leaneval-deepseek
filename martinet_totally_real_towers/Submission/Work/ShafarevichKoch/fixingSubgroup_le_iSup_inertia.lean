import Mathlib
import Submission.Work.ShafarevichKoch.SupportedTower
import Submission.Work.ShafarevichKoch.SupportedInertia

/-!
# `Work.ShafarevichKoch.fixingSubgroup_le_iSup_inertia` -- the hard half of inertia generation

The finite-level inertia-generation theorem of `README.md` §16.6/§16.9 states that for a finite
Galois extension `L/F` whose relative different is supported on a set `S` of rational primes, the
Galois group of `L` over the *maximal* unramified intermediate field `N` is the subgroup generated
by the inertia subgroups of the primes above `S`:

```lean
N.fixingSubgroup = ⨆ (P : {P : Ideal (𝓞 L) // P.IsPrime ∧ ∃ q ∈ S, P.LiesOver (span {q})}),
    Ideal.inertia (L ≃ₐ[F] L) P.1
```

`SupportedInertia.lean` proves the easy inclusion `⊇`.  This module proves the **hard inclusion**
`⊆` (`fixingSubgroup_le_iSup_inertia`): the fixed field `M` of the subgroup `H` generated by the
inertia groups at the primes over `S` is unramified over `F`, hence contained in `N`; consequently
`Gal(L/N) ≤ Gal(L/M) = H`.

The mathematical content, in the vocabulary of the workspace:

* `H := ⨆_{P ∈ 𝒫} I(P)` is **normal** in `G = Gal(L/F)`: the index set `𝒫` (the primes over `S`)
  is `G`-stable and `I(σ • P) = σ I(P) σ⁻¹`.  Hence `M := fixedField H` is Galois over `F`
  (`IsGalois.of_fixedField_normal_subgroup`), has trivial relative different — so `M ≤ N` by the
  maximality hypothesis `hmax` — and `Gal(L/M) = H` by `fixingSubgroup_fixedField`.
* `M/F` is unramified: for a prime `Q` of `𝓞 M` and `P | Q` in `𝓞 L`, the tower formula
  `e(P/F) = e(Q/F) · e(P/M)` (`Ideal.ramificationIdx_tower`) reduces the claim to `e(P/M) = e(P/F)`.
  If `P` is over some `q ∈ S` this is the cardinality identity
  `|I(P)| = e(P/F) = e(P/M)`: the inertia group of `P` in `G` is contained in `H = Gal(L/M)`
  (because `P` is one of the primes generating `H`), so the two inertia groups are the same
  subgroup (`Ideal.coe_mem_inertia`), and each has cardinality the corresponding ramification
  index (`Ideal.card_inertia_eq_ramificationIdxIn`).  The Galois-group structure needed to apply
  the cardinality identity for `M ⊆ L` is manufactured from `IsGaloisGroup.of_isScalarTower`, and
  the comparison `Gal(L/M) ≤ Gal(𝓞 L / 𝓞 M)` by
  `fixingSubgroup_le_fixingSubgroup_range_algebraMap_ringOfIntegers` below.  If instead `P` is
  *not* over `S`, then `P` is unramified over `F` by `hsupp`, and `e(Q/F) | e(P/F) = 1`.

The remaining `Q = ⊥` case is trivial because the relative different of a separable extension of
number fields is nonzero (`differentIdeal_ne_bot`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Classical
open scoped Pointwise
open scoped NumberField

open NumberField

noncomputable section

namespace Work.ShafarevichKoch

/-- **The fixing subgroup of an intermediate field acts trivially on its ring of integers.**

If `σ : Gal(L/F)` fixes `M ≤ L` pointwise, then `σ` fixes `𝓞 M ⊆ 𝓞 L ⊆ L` pointwise; in the
language of `fixingSubgroup` this says
`M.fixingSubgroup ≤ fixingSubgroup Gal(L/F) (Set.range (algebraMap (𝓞 M) (𝓞 L)))`. -/
theorem fixingSubgroup_le_fixingSubgroup_range_algebraMap_ringOfIntegers {F L : Type} [Field F]
    [Field L] [Algebra F L] [NumberField F] [NumberField L] [FiniteDimensional F L]
    (M : IntermediateField F L) [FiniteDimensional F ↥M] [NumberField ↥M] :
    M.fixingSubgroup ≤
      fixingSubgroup (L ≃ₐ[F] L) (Set.range (algebraMap (𝓞 ↥M) (𝓞 L))) := by
  intro σ hσ
  rw [mem_fixingSubgroup_iff]
  rintro y ⟨x, rfl⟩
  apply RingOfIntegers.coe_injective (K := L)
  rw [Commons.NumberTheory.RamificationInertia.coe_smul_ringOfIntegers]
  rw [AlgEquiv.smul_def]
  rw [Commons.NumberTheory.RamificationInertia.coe_algebraMap_ringOfIntegers (L := ↥M) (M := L) x]
  exact (IntermediateField.mem_fixingSubgroup_iff (K := M) σ).mp hσ _ (Subtype.mem _)

/-- **Ramification index in a Galois subextension whose Galois group contains the inertia group.**

Let `F ⊆ M ⊆ L` with `L/F` finite Galois, let `Q` be a prime of `𝓞 M` and `P | Q` a prime of
`𝓞 L` whose inertia subgroup in `Gal(L/F)` is contained in `Gal(L/M)`.  Then the ramification
index of `P` over `𝓞 M` equals its ramification index over `𝓞 F`.

Indeed both are the cardinality of the *same* inertia group `I(P) ≤ Gal(L/F)` — the
ambient one relative to `𝓞 F` and the one relative to `𝓞 M` coincide because
`I(P) ≤ Gal(L/M)` — and the cardinality identity
`|I(P)| = e` holds for both extensions (`Ideal.card_inertia_eq_ramificationIdxIn`). -/
theorem ramificationIdx_eq_of_inertia_le_fixingSubgroup {F L : Type} [Field F] [Field L]
    [Algebra F L] [NumberField F] [NumberField L] [FiniteDimensional F L] [IsGalois F L]
    (M : IntermediateField F L) [FiniteDimensional F ↥M] [NumberField ↥M]
    (Q : Ideal (𝓞 ↥M)) (P : Ideal (𝓞 L)) [P.IsPrime] [Q.IsPrime] [P.LiesOver Q]
    (hinertia : Ideal.inertia (L ≃ₐ[F] L) P ≤ M.fixingSubgroup) :
    P.ramificationIdx (𝓞 ↥M) = P.ramificationIdx (𝓞 F) := by
  set G' : Subgroup (L ≃ₐ[F] L) :=
    fixingSubgroup (L ≃ₐ[F] L) (Set.range (algebraMap (𝓞 ↥M) (𝓞 L))) with hG'
  haveI hG'gal : IsGaloisGroup G' (𝓞 ↥M) (𝓞 L) :=
    IsGaloisGroup.of_isScalarTower (L ≃ₐ[F] L) (𝓞 F) (𝓞 L) (𝓞 ↥M)
  have hle' : M.fixingSubgroup ≤ G' := by
    rw [hG']
    exact fixingSubgroup_le_fixingSubgroup_range_algebraMap_ringOfIntegers M
  have hsub : Ideal.inertia (L ≃ₐ[F] L) P ≤ G' := le_trans hinertia hle'
  have hcard : Nat.card (Ideal.inertia G' P) = Nat.card (Ideal.inertia (L ≃ₐ[F] L) P) := by
    rw [show Ideal.inertia G' P = (Ideal.inertia (L ≃ₐ[F] L) P).subgroupOf G' from
      Subgroup.ext (fun x => (Ideal.coe_mem_inertia (I := P) (G := L ≃ₐ[F] L) (H := G')).symm)]
    exact Nat.card_congr (Subgroup.subgroupOfEquivOfLe hsub).toEquiv
  calc P.ramificationIdx (𝓞 ↥M)
      = Q.ramificationIdxIn (𝓞 L) :=
        (Ideal.ramificationIdxIn_eq_ramificationIdx Q P G').symm
    _ = Nat.card (Ideal.inertia G' P) :=
        (Ideal.card_inertia_eq_ramificationIdxIn (G := G') Q P).symm
    _ = Nat.card (Ideal.inertia (L ≃ₐ[F] L) P) := hcard
    _ = (P.under (𝓞 F)).ramificationIdxIn (𝓞 L) :=
        Ideal.card_inertia_eq_ramificationIdxIn (G := L ≃ₐ[F] L) (P.under (𝓞 F)) P
    _ = P.ramificationIdx (𝓞 F) :=
        Ideal.ramificationIdxIn_eq_ramificationIdx (P.under (𝓞 F)) P (L ≃ₐ[F] L)

/-- **The subgroup generated by the inertia groups at the primes over `S` is normal.**

For `G = Gal(L/F)` acting on the primes of `𝓞 L`, the index set `𝒫` of primes lying over some
`q ∈ S` is `G`-stable, and `I(σ • P) = σ I(P) σ⁻¹` (`Ideal.inertia_smul`); hence the supremum
`⨆_{P ∈ 𝒫} I(P)` is stable under conjugation, i.e. normal. -/
theorem iSup_inertia_normal {F L : Type} [Field F] [Field L] [Algebra F L] [NumberField F]
    [NumberField L] [FiniteDimensional F L] [IsGalois F L] (S : Finset ℕ) :
    (⨆ (P : {P : Ideal (𝓞 L) // P.IsPrime ∧
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}),
      Ideal.inertia (L ≃ₐ[F] L) P.1).Normal := by
  let ι := {P : Ideal (𝓞 L) // P.IsPrime ∧
      ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}
  let H : Subgroup (L ≃ₐ[F] L) := ⨆ (P : ι), Ideal.inertia (L ≃ₐ[F] L) P.1
  have hmem : ∀ (τ : L ≃ₐ[F] L) (P : ι), (τ • P.1).IsPrime ∧
      ∃ q ∈ S, (τ • P.1).LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)) := by
    intro τ P
    obtain ⟨hP, q, hqS, hq⟩ := P.2
    exact ⟨hP.smul τ, q, hqS, by have := hq; infer_instance⟩
  change H.Normal
  rw [Subgroup.normal_iff_map_conj_eq]
  intro σ
  have hstep : ∀ P : ι, (Ideal.inertia (L ≃ₐ[F] L) P.1).map (↑(MulAut.conj σ)) =
      Ideal.inertia (L ≃ₐ[F] L) (σ • P.1) := fun P => (Ideal.inertia_smul σ P.1).symm
  rw [Subgroup.map_iSup]
  simp only [hstep]
  show (⨆ P : ι, Ideal.inertia (L ≃ₐ[F] L) (σ • P.1)) =
    (⨆ P : ι, Ideal.inertia (L ≃ₐ[F] L) P.1)
  refine le_antisymm ?_ ?_
  · exact iSup_le fun P => le_iSup (f := fun Q : ι => Ideal.inertia (L ≃ₐ[F] L) Q.1)
      (⟨σ • P.1, hmem σ P⟩ : ι)
  · refine iSup_le fun P => ?_
    have hle := le_iSup (f := fun Q : ι => Ideal.inertia (L ≃ₐ[F] L) (σ • Q.1))
      (⟨σ⁻¹ • P.1, hmem σ⁻¹ P⟩ : ι)
    rwa [smul_inv_smul] at hle

theorem fixingSubgroup_le_iSup_inertia {F L : Type} [Field F] [Field L] [Algebra F L]
    [NumberField F] [NumberField L] [FiniteDimensional F L] [IsGalois F L] (S : Finset ℕ)
    (hsupp : ∀ (P : Ideal (NumberField.RingOfIntegers L)), P.IsPrime → P ≠ ⊥ →
      P ∣ differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers L) →
        ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ)))
    (N : IntermediateField F L) [FiniteDimensional F ↥N] [IsGalois F ↥N] [NumberField ↥N]
    (hN : differentIdeal (NumberField.RingOfIntegers F)
      (NumberField.RingOfIntegers ↥N) = ⊤)
    (hmax : ∀ (K : IntermediateField F L) [FiniteDimensional F ↥K] [IsGalois F ↥K]
      [NumberField ↥K], differentIdeal (NumberField.RingOfIntegers F)
        (NumberField.RingOfIntegers ↥K) = ⊤ → K ≤ N) :
    N.fixingSubgroup ≤
      ⨆ (P : {P : Ideal (NumberField.RingOfIntegers L) // P.IsPrime ∧
          ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}),
        Ideal.inertia (L ≃ₐ[F] L) P.1 := by
  classical
  let ι := {P : Ideal (𝓞 L) // P.IsPrime ∧
      ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))}
  let H : Subgroup (L ≃ₐ[F] L) := ⨆ (P : ι), Ideal.inertia (L ≃ₐ[F] L) P.1
  have hHnormal : H.Normal := iSup_inertia_normal (F := F) (L := L) S
  haveI : H.Normal := hHnormal
  let M : IntermediateField F L := IntermediateField.fixedField H
  haveI hMgal : IsGalois F ↥M := IsGalois.of_fixedField_normal_subgroup H
  haveI hMfd : FiniteDimensional F ↥M := inferInstance
  haveI hMnum : NumberField ↥M := NumberField.of_module_finite F ↥M
  have hfix : M.fixingSubgroup = H := IntermediateField.fixingSubgroup_fixedField H
  have hunr : differentIdeal (𝓞 F) (𝓞 ↥M) = ⊤ := by
    refine Commons.NumberTheory.NumberField.differentIdeal_eq_top_of_forall_not_dvd ?_
    intro Q hQ
    haveI : Q.IsPrime := hQ
    by_cases hQbot : Q = ⊥
    · rintro ⟨c, hc⟩
      rw [hQbot] at hc
      exact differentIdeal_ne_bot (by simpa using hc)
    · have hQ1 : Q.ramificationIdx (𝓞 F) = 1 := by
        obtain ⟨P, -, hPprime, hPunder⟩ :=
          Ideal.exists_ideal_over_prime_of_isIntegral (R := 𝓞 ↥M) (S := 𝓞 L) Q ⊥ (by simp)
        haveI : P.IsPrime := hPprime
        haveI : P.LiesOver Q := Ideal.LiesOver.mk hPunder.symm
        have htower : P.ramificationIdx (𝓞 F) =
            Q.ramificationIdx (𝓞 F) * P.ramificationIdx (𝓞 ↥M) :=
          Ideal.ramificationIdx_tower Q P
        have hPne : P ≠ ⊥ := by
          intro h
          apply hQbot
          rw [← hPunder, h]
          simp
        by_cases hPmem : ∃ q ∈ S, P.LiesOver (Ideal.span ({(q : ℤ)} : Set ℤ))
        · have hA : P.ramificationIdx (𝓞 ↥M) = P.ramificationIdx (𝓞 F) :=
            ramificationIdx_eq_of_inertia_le_fixingSubgroup M Q P (by
              rw [hfix]
              exact le_iSup (fun R : ι => Ideal.inertia (L ≃ₐ[F] L) R.1)
                ⟨P, hPprime, hPmem⟩)
          rw [hA] at htower
          exact Nat.eq_of_mul_eq_mul_right (n := Q.ramificationIdx (𝓞 F))
            (m := P.ramificationIdx (𝓞 F)) (k := 1) (Ideal.ramificationIdx_pos P (𝓞 F))
            (by rw [one_mul]; exact htower.symm)
        · have hB : P.ramificationIdx (𝓞 F) = 1 := by
            refine (Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal
              P hPprime).mp ?_
            intro hdvd
            exact hPmem (hsupp P hPprime hPne hdvd)
          rw [hB] at htower
          exact Nat.dvd_one.mp ⟨P.ramificationIdx (𝓞 ↥M), htower⟩
      exact (Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal
        Q hQ).mpr hQ1
  have hMN : M ≤ N := hmax M hunr
  exact le_trans (IntermediateField.fixingSubgroup_le hMN) (le_of_eq hfix)

end Work.ShafarevichKoch
