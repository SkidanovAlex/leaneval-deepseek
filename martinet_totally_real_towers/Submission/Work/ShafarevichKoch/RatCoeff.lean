import Mathlib
import Submission.Work.ShafarevichKoch.CoeffZ

/-!
# `Work.ShafarevichKoch.RatCoeff` -- the coefficient sequence `0 → ℤ → ℚ → ℚ/ℤ → 0`

The relation bound of this chapter is read, in `CountZ.lean`, off the `ℤ`-power sequence
`0 → H²(G,ℤ)/2 → H²(G,ℤ/2) → H³(G,ℤ)[2] → 0`, which splits the crux into the *free part*
`#(H²(G,ℤ)/2H²(G,ℤ))` and the *torsion part* `#H³(G,ℤ)[2]`.  This module provides the second
coefficient sequence

`0 → ℤ → ℚ → ℚ/ℤ → 0`  (`ratCoeffSES`),

whose connecting map `δ : H¹(G,ℚ/ℤ) → H²(G,ℤ)` is an isomorphism as soon as `H¹(G,ℚ)` and
`H²(G,ℚ)` vanish (i.e. for `G` profinite, `README.md` §21.2).  Through it the *free part*
`H²(G,ℤ)/2H²(G,ℤ)` is identified with the cokernel of `2` on the **torsion** group `H¹(G,ℚ/ℤ)`,
which is what the pure-algebra bound `TorsionCokernel/natCard_quot_two_le_natCard_twoTorsion`
controls: that is why the `H²`-half of the crux is *elementary* and needs no class field theory.

## Main declarations

* `Work.ShafarevichKoch.ratTrivialAction`, `instTrivialDistribMulActionRat`,
  `instIsDiscreteGModuleRat` : `ℚ` as a trivial discrete `G`-module;
* `Work.ShafarevichKoch.QZ`, `qzTrivialAction`, `instIsDiscreteGModuleQZ` : `ℚ/ℤ`;
* `Work.ShafarevichKoch.intToRatEqHom`, `ratToQZEqHom`, `ratCoeffSES`.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false

open scoped Classical

noncomputable section

namespace Work.ShafarevichKoch

open Work.ConCohomology

/-! ## `ℚ` as a trivial discrete module -/

/-- **The trivial action of a group on `ℚ`.** -/
@[reducible] def ratTrivialAction (G : Type*) [Group G] : DistribMulAction G ℚ where
  smul _ q := q
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

/-- The trivial action on `ℚ`, registered with *low precedence* (`priority := 2000`): instance
search prefers it whenever no other action of `G` on `ℚ` exists (in particular for the Galois
groups of this chapter), but a canonical action (e.g. `ℚ` on itself) still wins.  This is
deliberate: shadowing the canonical action on `ℚ` would silently change the meaning of `•`. -/
instance (priority := 2000) instTrivialDistribMulActionRat (G : Type*) [Group G] :
    DistribMulAction G ℚ := ratTrivialAction G

/-- With the trivial action, `ℚ` is a discrete `G`-module. -/
instance (priority := 2000) instIsDiscreteGModuleRat (G : Type*) [Group G] [TopologicalSpace G] :
    IsDiscreteGModule G ℚ :=
  ⟨fun _ => IsLocallyConstant.const _⟩

/-! ## `ℚ/ℤ` -/

/-- **`ℚ/ℤ`**, as the quotient of `ℚ` by the subgroup generated by `1` (i.e. by the image of
`ℤ`). -/
abbrev QZ : Type := ℚ ⧸ AddSubgroup.zmultiples (1 : ℚ)

/-- **The trivial action of a group on `ℚ/ℤ`.** -/
@[reducible] def qzTrivialAction (G : Type*) [Group G] : DistribMulAction G QZ where
  smul _ x := x
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

instance (priority := 100) instTrivialActionQZ (G : Type*) [Group G] : DistribMulAction G QZ :=
  qzTrivialAction G

/-- With the trivial action, `ℚ/ℤ` is a discrete `G`-module. -/
instance (priority := 100) instIsDiscreteGModuleQZ (G : Type*) [Group G] [TopologicalSpace G] :
    IsDiscreteGModule G QZ :=
  ⟨fun _ => IsLocallyConstant.const _⟩

/-! ## The two maps of the sequence -/

/-- **`ℤ ↪ ℚ`** as an equivariant additive map for the trivial actions. -/
def intToRatEqHom (G : Type*) [Group G] : EqHom G ℤ ℚ where
  toAddMonoidHom := Int.castAddHom ℚ
  map_smul' := by intro σ a; rfl

/-- **`ℚ ↠ ℚ/ℤ`** as an equivariant additive map for the trivial actions. -/
def ratToQZEqHom (G : Type*) [Group G] : EqHom G ℚ QZ where
  toAddMonoidHom := QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℚ))
  map_smul' := by intro σ a; rfl

/-- **The coefficient sequence `0 → ℤ → ℚ → ℚ/ℤ → 0`** (trivial `G`-action). -/
def ratCoeffSES (G : Type*) [Group G] : CoeffSES G ℤ ℚ QZ where
  f := intToRatEqHom G
  g := ratToQZEqHom G
  injective_f := by
    intro a b h
    exact Int.cast_injective h
  surjective_g := by
    intro c
    refine QuotientAddGroup.induction_on c ?_
    intro b
    exact ⟨b, QuotientAddGroup.mk'_apply _ b⟩
  exact := by
    intro b
    have hnorm : (AddSubgroup.zmultiples (1 : ℚ)).Normal := inferInstance
    have hkey : (ratToQZEqHom G) b = 0 ↔ b ∈ AddSubgroup.zmultiples (1 : ℚ) := by
      rw [show (ratToQZEqHom G) b =
        (QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℚ))) b from rfl]
      rw [QuotientAddGroup.mk'_apply]
      exact @QuotientAddGroup.eq_zero_iff ℚ _ (AddSubgroup.zmultiples (1 : ℚ)) hnorm b
    rw [hkey]
    constructor
    · intro hb
      obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp hb
      refine ⟨n, ?_⟩
      rw [show (intToRatEqHom G) n = ((n : ℤ) : ℚ) from rfl, ← hn]
      simp
    · rintro ⟨a, rfl⟩
      show ((a : ℤ) : ℚ) ∈ AddSubgroup.zmultiples (1 : ℚ)
      exact AddSubgroup.mem_zmultiples_iff.mpr ⟨a, by simp⟩

/-- The underlying value of the `ℚ/ℤ`-part of the coefficient sequence is the quotient map. -/
@[simp] lemma ratCoeffSES_g_apply {G : Type*} [Group G] (b : ℚ) :
    (ratCoeffSES G).g b = QuotientAddGroup.mk' (AddSubgroup.zmultiples (1 : ℚ)) b := rfl

end Work.ShafarevichKoch
