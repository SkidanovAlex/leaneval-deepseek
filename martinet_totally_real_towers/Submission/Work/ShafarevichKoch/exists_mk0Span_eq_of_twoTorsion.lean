noncomputable section

namespace Work.ShafarevichKoch

open Work.ClassFieldTower

/-!
# Genus descent for `Kc = ℚ(√-30030)`

Every ideal `I ≠ 0` of `𝓞 Kc = ℤ[√-30030]` whose class is `2`-torsion (`I²` principal) is
represented by one of the ideals `⟨d, √-30030⟩`, `d ∣ 30030`.  This is Gauss's genus theory for
the imaginary quadratic field `Kc`: the `2`-torsion of the class group is generated by the classes
of the ideals above the ramified primes `2, 3, 5, 7, 11, 13`.

The proof follows the classical route through ambiguous ideals.  With `σ = conjR` the nontrivial
automorphism of `𝓞 Kc`:

* `I · σI` is `σ`-stable, so by `conjInv_ideal_structure` it equals `⟨cd, c·scR⟩` with `d ∣ 30030`;
* comparing absolute norms (`absNorm ⟨cd, c·scR⟩ = c·d·c` and `absNorm (I · σI) = (absNorm I)²`)
  yields `d · (absNorm I)² = (cd)²`, so `d = 1` by squarefreeness of `30030`: `I · σI = (c)`;
* if `α` generates `I²`, then `(α) · σI = (c) · I`.  If `α = -c` this gives `σI = I`, so `I` is
  itself ambiguous and we are done.  Otherwise `J := (σ α · (α + c)) · I` has the same class as
  `I` and is `σ`-stable (using `α · σα = c²`, which follows from the same norm comparison), and
  again `conjInv_ideal_structure` plus `mk0_span_pair_eq` finishes.
-/

local notation "conjH" => (Work.ShafarevichKoch.conjR : 𝓞 Kc →+* 𝓞 Kc)

/-- The conjugation of `𝓞 Kc` read as a ring homomorphism (the form required by `Ideal.map`). -/
lemma conjH_apply (z : 𝓞 Kc) : conjH z = Work.ShafarevichKoch.conjR z := rfl

/-- `conjH` is an involution. -/
lemma conjH_invol (z : 𝓞 Kc) : conjH (conjH z) = z := by
  simp only [conjH_apply, Work.ShafarevichKoch.conjR_invol]

/-- Conjugation of ideals is an involution. -/
lemma map_conjH_invol (J : Ideal (𝓞 Kc)) : Ideal.map conjH (Ideal.map conjH J) = J := by
  rw [Ideal.map_map]
  have h : RingHom.comp conjH conjH = RingHom.id (𝓞 Kc) := by
    ext z
    simpa using conjH_invol z
  rw [h, Ideal.map_id]

/-- Conjugation of a principal ideal. -/
lemma map_conjH_span (z : 𝓞 Kc) :
    Ideal.map conjH (Ideal.span {z}) = Ideal.span {conjH z} := by
  rw [Ideal.map_span, Set.image_singleton]

/-- Conjugation preserves nonzeroness of an ideal. -/
lemma map_conjH_ne_bot {J : Ideal (𝓞 Kc)} (hJ : J ≠ ⊥) : Ideal.map conjH J ≠ ⊥ := by
  intro hbot
  have hinj : Function.Injective conjH := fun x y h => by
    have h' : Work.ShafarevichKoch.conjR x = Work.ShafarevichKoch.conjR y := h
    exact Work.ShafarevichKoch.conjR.injective h'
  exact hJ ((Ideal.map_eq_bot_iff_of_injective hinj).mp hbot)

/-- **Ambiguous ideals have the required form.**  A conjugation-stable nonzero ideal of `𝓞 Kc` is
`⟨c·d, c·scR⟩`, and its class is `mk0Span d` for `d ∣ 30030`. -/
lemma exists_mk0Span_of_isConjInv (K : Ideal (𝓞 Kc)) (hK : K ≠ ⊥) (hinv : IsConjInv K) :
    ∃ (d : ℕ) (hd : d ∣ 30030),
      ClassGroup.mk0 ⟨K, mem_nonZeroDivisors_of_ne_zero hK⟩ = mk0Span d hd := by
  obtain ⟨c, d, hc, hd, hKeq⟩ := conjInv_ideal_structure K hK hinv
  refine ⟨d, hd, ?_⟩
  have hspan : Ideal.span ({(↑(c * d) : 𝓞 Kc), (↑c : 𝓞 Kc) * scR} : Set (𝓞 Kc)) ≠ ⊥ := by
    rw [← hKeq]; exact hK
  have hmem : Ideal.span ({(↑(c * d) : 𝓞 Kc), (↑c : 𝓞 Kc) * scR} : Set (𝓞 Kc))
      ∈ (Ideal (𝓞 Kc))⁰ := mem_nonZeroDivisors_of_ne_zero hspan
  have hunit : (⟨K, mem_nonZeroDivisors_of_ne_zero hK⟩ : (Ideal (𝓞 Kc))⁰) =
      (⟨Ideal.span ({(↑(c * d) : 𝓞 Kc), (↑c : 𝓞 Kc) * scR} : Set (𝓞 Kc)), hmem⟩ :
        (Ideal (𝓞 Kc))⁰) := Subtype.ext hKeq
  rw [hunit]
  exact mk0_span_pair_eq c d hc.ne' hd hmem

/-- **Genus descent** for `Kc = ℚ(√-30030)`: an integral ideal `I ≠ 0` whose class has order
dividing `2` is represented by `⟨d, √-30030⟩` with `d ∣ 30030`.  (`mk0Span d hd` is the class of
`spanSc d = ⟨d, scR⟩`; `h2 : (I * I).IsPrincipal` says that `I²` is principal.)

Ingredients available in the imports: `conjInv_ideal_structure` (a conjugation-stable nonzero ideal
of `𝓞 Kc` is `⟨c*d, c·scR⟩` with `c > 0`, `d ∣ 30030`), `absNorm_span_sc`
(`absNorm ⟨c*d, c·scR⟩ = c*d*c`), `absNorm_conjR` (`absNorm (conjR I) = absNorm I`),
`eq_one_of_squarefree_mul_sq_eq_sq`, `conjR_mul_self` (`z * conjR z = Algebra.norm ℤ z`),
`norm_int_pos` (`0 < Algebra.norm ℤ z` for `z ≠ 0`), `nat_eq_of_span_singleton_eq`,
`mk0_span_pair_eq`, `mk0Span_mul`, `mk0Span_sq`, `mk0Span_compl`, `mk0Span_30030`,
`squarefree_of_dvd_30030`, `isConjInv_iff_map_le`, `conjR_invol`, `Ideal.map_mul`,
`Ideal.map_span`, `Ideal.map_map`, `Ideal.map_id`.

Route: `I * conjR I` is conjugation-stable (`map conjR (I * conjR I) = conjR I * I`), so
`conjInv_ideal_structure` gives `I * conjR I = ⟨c*d, c·scR⟩`.  Norms give
`c*d*c = absNorm I * absNorm I`, hence `d * (absNorm I)² = (c*d)²`, and `d = 1` since `d` is
squarefree.  So `I * conjR I = (c)`.  Let `α` generate `I²`.  Then `(α) * conjR I = (c) * I`.
If `α + c = 0` (so `(α) = (c)`) this gives `conjR I = I` (cancel `I`), i.e. `I` is
conjugation-stable, and `conjInv_ideal_structure` applied to `I` plus `mk0_span_pair_eq` gives the
conclusion.  Otherwise `J := (conjR α * (α + c)) * I` is nonzero and conjugation-stable: with
`β := conjR α * (α + c)` one has `conjR β = α * (conjR α + c)`, `β = c * (conjR α + c)`
(using `α * conjR α = c²`, which follows from `(α) * conjR I = (c) * I` together with
`conjR_mul_self` and `norm_int_pos`) and hence
`⟨conjR β⟩ * conjR I = ⟨α⟩ * ⟨conjR α + c⟩ * conjR I = ⟨conjR α + c⟩ * (⟨α⟩ * conjR I)
= ⟨conjR α + c⟩ * (⟨c⟩ * I) = ⟨β⟩ * I`.  Finally `J` has the same class as `I` (it is `(β) * I`),
so `conjInv_ideal_structure` applied to `J` plus `mk0_span_pair_eq` gives the conclusion. -/
theorem exists_mk0Span_eq_of_twoTorsion (I : Ideal (NumberField.RingOfIntegers Work.ClassFieldTower.Kc))
    (hI : I ≠ ⊥) (h2 : (I * I).IsPrincipal) :
    ∃ (d : ℕ) (hd : d ∣ 30030),
      ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩
        = Work.ShafarevichKoch.mk0Span d hd := by
  -- `σ = conjH` maps `I` to `conjR I`.
  have hinj : Function.Injective conjH := fun x y h => by
    have h' : Work.ShafarevichKoch.conjR x = Work.ShafarevichKoch.conjR y := h
    exact Work.ShafarevichKoch.conjR.injective h'
  have hmapI_ne : Ideal.map conjH I ≠ ⊥ := by
    intro hbot
    exact hI ((Ideal.map_eq_bot_iff_of_injective hinj).mp hbot)
  -- Step 1: `I · σI` is `σ`-stable.
  have hprod_ne : I * Ideal.map conjH I ≠ ⊥ := mul_ne_zero hI hmapI_ne
  have hprod_conj : IsConjInv (I * Ideal.map conjH I) := by
    refine (isConjInv_iff_map_le _).mpr ?_
    rw [Ideal.map_mul, map_conjH_invol]
    exact le_of_eq (mul_comm _ _)
  obtain ⟨c, d, hc, hd, hstruct⟩ := conjInv_ideal_structure _ hprod_ne hprod_conj
  -- Step 2: comparing norms gives `d = 1`, i.e. `I · σI = (c)`.
  have hN0 : Ideal.absNorm I ≠ 0 := by
    intro h0
    exact hI ((Ideal.absNorm_eq_zero_iff).mp h0)
  have hnormL : Ideal.absNorm (I * Ideal.map conjH I) = Ideal.absNorm I ^ 2 := by
    rw [map_mul Ideal.absNorm, absNorm_conjR, pow_two]
  have hnormR : Ideal.absNorm (I * Ideal.map conjH I) = c * d * c := by
    rw [hstruct]; exact absNorm_span_sc c d hd
  have hsq : Ideal.absNorm I * Ideal.absNorm I = c * d * c := by
    rw [pow_two] at hnormL
    rw [← hnormL, hnormR]
  have hkey : d * (Ideal.absNorm I) ^ 2 = (c * d) ^ 2 := by
    rw [pow_two, pow_two, hsq]
    ring
  have hd1 : d = 1 :=
    eq_one_of_squarefree_mul_sq_eq_sq (squarefree_of_dvd_30030 hd) hN0 hkey
  have hprod : I * Ideal.map conjH I = Ideal.span {(↑c : 𝓞 Kc)} := by
    rw [hstruct, hd1, mul_one]
    refine le_antisymm ?_ ?_
    · rw [Ideal.span_le]
      intro z hz
      rcases hz with h | h
      · rw [h]; exact Ideal.mem_span_singleton.mpr (dvd_refl _)
      · rw [h]; exact Ideal.mem_span_singleton.mpr ⟨scR, rfl⟩
    · rw [Ideal.span_le]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]; exact Ideal.subset_span (Set.mem_insert _ _)
  -- Step 3: a generator `α` of `I²`, and the identity `(α) · σI = (c) · I`.
  obtain ⟨α, hαspan⟩ := (Submodule.isPrincipal_iff (I * I)).mp h2
  have hαspan' : I * I = Ideal.span {α} := hαspan
  have hα0 : α ≠ 0 := by
    intro h0
    have hbot : I * I = ⊥ := by rw [hαspan', h0]; simp
    exact (mul_ne_zero hI hI) hbot
  have heq : Ideal.span {α} * Ideal.map conjH I = Ideal.span {(↑c : 𝓞 Kc)} * I := by
    rw [← hαspan', mul_assoc, hprod]
    exact mul_comm _ _
  -- Step 3b: consequently `α · σα = c²`.
  have habs : Ideal.absNorm (Ideal.span {α}) = Ideal.absNorm (Ideal.span {(↑c : 𝓞 Kc)}) := by
    have h := congrArg Ideal.absNorm heq
    simp only [map_mul] at h
    rw [absNorm_conjR] at h
    exact Nat.mul_right_cancel (Nat.pos_of_ne_zero hN0) h
  have hfin : Module.finrank ℤ (𝓞 Kc) = 2 := Work.ClassFieldTower.finrank_ringOfIntegers
  have habs2 : Ideal.absNorm (Ideal.span {(↑c : 𝓞 Kc)}) = c * c := by
    rw [Ideal.absNorm_span_natCast, hfin]; ring
  have hNα : (Algebra.norm ℤ α).natAbs = c * c := by
    rw [← Ideal.absNorm_span_singleton α, habs, habs2]
  have hNpos : 0 < Algebra.norm ℤ α := norm_int_pos α hα0
  have hZ : Algebra.norm ℤ α = ((c * c : ℕ) : ℤ) := by
    have h : (((Algebra.norm ℤ α).natAbs : ℤ)) = ((c * c : ℕ) : ℤ) := by rw [hNα]
    rwa [Int.natCast_natAbs, abs_of_nonneg hNpos.le] at h
  have hαconj : α * conjH α = (↑c : 𝓞 Kc) * ↑c := by
    have h1 : α * Work.ShafarevichKoch.conjR α = (Algebra.norm ℤ α : 𝓞 Kc) :=
      Work.ShafarevichKoch.conjR_mul_self α
    rw [← conjH_apply] at h1
    rw [h1, hZ]
    push_cast
    ring
  -- Step 4: case analysis on whether `I` is already ambiguous.
  by_cases hcase : α + (↑c : 𝓞 Kc) = 0
  · -- `α = -c`, so `(α) = (c)` and `σI = I`.
    have hα_eq : α = -(↑c : 𝓞 Kc) := by linear_combination hcase
    have hspanα : Ideal.span {α} = Ideal.span {(↑c : 𝓞 Kc)} := by
      rw [hα_eq, Ideal.span_singleton_neg]
    have hmapI : Ideal.map conjH I = I := by
      have h := heq
      rw [hspanα] at h
      refine mul_left_cancel₀ ?_ h
      intro h0
      have h1 : (↑c : 𝓞 Kc) = 0 :=
        Ideal.span_singleton_eq_bot.mp
          (show (Ideal.span {(↑c : 𝓞 Kc)} : Ideal (𝓞 Kc)) = ⊥ from h0)
      exact Nat.cast_ne_zero.mpr hc.ne' h1
    exact exists_mk0Span_of_isConjInv I hI ((isConjInv_iff_map_le I).mpr (le_of_eq hmapI))
  · -- Otherwise `J := (β)·I` with `β = σα·(α + c)` is a nonzero ambiguous ideal in the class
    -- of `I`.
    set β : 𝓞 Kc := conjH α * (α + (↑c : 𝓞 Kc)) with hβdef
    have hconjα_ne : conjH α ≠ 0 := by
      intro h0
      exact hα0 (by simpa [conjH_apply] using congrArg Work.ShafarevichKoch.conjR h0)
    have hβne : β ≠ 0 := by
      rw [hβdef]
      exact mul_ne_zero hconjα_ne hcase
    have hβ1 : conjH β = α * (conjH α + (↑c : 𝓞 Kc)) := by
      rw [hβdef, map_mul, map_add, map_natCast, conjH_invol]
    have hβ2 : β = (↑c : 𝓞 Kc) * (conjH α + (↑c : 𝓞 Kc)) := by
      rw [hβdef]
      calc conjH α * (α + (↑c : 𝓞 Kc)) = conjH α * α + conjH α * ↑c := by ring
        _ = (↑c : 𝓞 Kc) * ↑c + conjH α * ↑c := by rw [mul_comm (conjH α) α, hαconj]
        _ = (↑c : 𝓞 Kc) * (conjH α + ↑c) := by ring
    set J : Ideal (𝓞 Kc) := Ideal.span ({β} : Set (𝓞 Kc)) * I with hJdef
    have hspanβ_ne : Ideal.span ({β} : Set (𝓞 Kc)) ≠ ⊥ := by
      rw [ne_eq, Ideal.span_singleton_eq_bot]; exact hβne
    have hJne : J ≠ ⊥ := by
      rw [hJdef]; exact mul_ne_zero hspanβ_ne hI
    have hJconj : IsConjInv J := by
      refine (isConjInv_iff_map_le J).mpr ?_
      have hmapJ : Ideal.map conjH J = J := by
        rw [hJdef, Ideal.map_mul, map_conjH_span, hβ1]
        calc Ideal.span {α * (conjH α + ↑c)} * Ideal.map conjH I
            = (Ideal.span {α} * Ideal.span {conjH α + ↑c}) * Ideal.map conjH I := by
                rw [Ideal.span_singleton_mul_span_singleton]
          _ = Ideal.span {conjH α + ↑c} * (Ideal.span {α} * Ideal.map conjH I) := by ring
          _ = Ideal.span {conjH α + ↑c} * (Ideal.span {(↑c : 𝓞 Kc)} * I) := by rw [heq]
          _ = (Ideal.span {conjH α + ↑c} * Ideal.span {(↑c : 𝓞 Kc)}) * I := by ring
          _ = Ideal.span {(conjH α + ↑c) * ↑c} * I := by
                rw [Ideal.span_singleton_mul_span_singleton]
          _ = Ideal.span {β} * I := by
                rw [hβ2]
                congr 1
                rw [mul_comm]
      exact le_of_eq hmapJ
    -- `J` has the same class as `I`.
    have hju : ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJne⟩
        = ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩ := by
      have hunit : (⟨J, mem_nonZeroDivisors_of_ne_zero hJne⟩ : (Ideal (𝓞 Kc))⁰)
          = (⟨Ideal.span ({β} : Set (𝓞 Kc)), mem_nonZeroDivisors_of_ne_zero hspanβ_ne⟩ :
              (Ideal (𝓞 Kc))⁰) * ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩ :=
        Subtype.ext hJdef
      have hone : ClassGroup.mk0 (⟨Ideal.span ({β} : Set (𝓞 Kc)),
          mem_nonZeroDivisors_of_ne_zero hspanβ_ne⟩ : (Ideal (𝓞 Kc))⁰) = 1 :=
        (ClassGroup.mk0_eq_one_iff _).mpr ⟨β, rfl⟩
      calc ClassGroup.mk0 ⟨J, mem_nonZeroDivisors_of_ne_zero hJne⟩
          = ClassGroup.mk0 ((⟨Ideal.span ({β} : Set (𝓞 Kc)),
                mem_nonZeroDivisors_of_ne_zero hspanβ_ne⟩ : (Ideal (𝓞 Kc))⁰)
              * ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩) := by rw [hunit]
        _ = ClassGroup.mk0 (⟨Ideal.span ({β} : Set (𝓞 Kc)),
                mem_nonZeroDivisors_of_ne_zero hspanβ_ne⟩ : (Ideal (𝓞 Kc))⁰)
              * ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩ := map_mul _ _ _
        _ = ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero hI⟩ := by rw [hone, one_mul]
    obtain ⟨d', hd', hres⟩ := exists_mk0Span_of_isConjInv J hJne hJconj
    exact ⟨d', hd', hju.symm.trans hres⟩

end Work.ShafarevichKoch
