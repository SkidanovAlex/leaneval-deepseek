import Mathlib
import Submission.Work.ClassFieldTower.TwoDescentDefs
import Submission.Work.ClassFieldTower.KummerSetup
import Submission.Work.ClassFieldTower.degreeTwo_sqrt_gen
import Submission.Work.ClassFieldTower.rootsOfUnity_two_equiv_zmod_two
import Submission.Work.ClassFieldTower.hom_units_factor_two

/-!
# Exponent-`2` Kummer theory (the field-level two-descent)

This file proves `Work.ClassFieldTower.kummer_expTwo_iso`: for a finite Galois extension `L / K`
with `(2 : K) ≠ 0` whose Galois group has exponent `2`, the subgroup `U ≤ Kˣ/(Kˣ)²` of Kummer
classes having a square root in `L` satisfies `Gal(L/K) ≃* Hom(U, 𝔽₂)` and `|Gal(L/K)| = |U|`.

The Kummer pairing and the identification of `U` with `Hom(Gal(L/K), μ₂)` are proved in
`Submission.Work.ClassFieldTower.KummerSetup`; here we assemble the final statement using the
duality theory of finite abelian groups (`CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity`
and `CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option maxHeartbeats 800000

open scoped Classical IsMulCommutative

noncomputable section

namespace Work.ClassFieldTower

/-! ### The final assembly -/

section Final

/-- A group all of whose elements square to `1` is commutative. -/
lemma mul_comm_of_sq_eq_one {A : Type*} [Group A] (h : ∀ x : A, x ^ 2 = 1) :
    ∀ x y : A, x * y = y * x := by
  intro x y
  have hx : x⁻¹ = x := inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact h x)
  have hy : y⁻¹ = y := inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact h y)
  calc x * y = (x * y)⁻¹ :=
        (inv_eq_of_mul_eq_one_right (by rw [← pow_two]; exact h (x * y))).symm
    _ = y⁻¹ * x⁻¹ := mul_inv_rev x y
    _ = y * x := by rw [hx, hy]

/-- For a finite group of exponent dividing `2`, the group of homomorphisms into `μ₂ ⊆ Lˣ` is
isomorphic to the group itself. -/
theorem nonempty_hom_rootsOfUnity_two_equiv_self {A L : Type*} [Group A] [Finite A] [Field L]
    (hA : ∀ x : A, x ^ 2 = 1) (h2L : (2 : L) ≠ 0) :
    Nonempty ((A →* rootsOfUnity 2 L) ≃* A) := by
  haveI : IsMulCommutative A := ⟨⟨mul_comm_of_sq_eq_one hA⟩⟩
  have hexp : Monoid.exponent A ∣ 2 :=
    Monoid.exponent_dvd.mpr (fun x => orderOf_dvd_iff_pow_eq_one.mpr (hA x))
  haveI : HasEnoughRootsOfUnity L 2 := by
    refine HasEnoughRootsOfUnity.of_card_le (R := L) (n := 2) ?_
    obtain ⟨e⟩ := rootsOfUnity_two_equiv_zmod_two (R := L) h2L
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card]
    simp
  haveI : HasEnoughRootsOfUnity L (Monoid.exponent A) := HasEnoughRootsOfUnity.of_dvd L hexp
  obtain ⟨e1⟩ := CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity A L
  obtain ⟨e2⟩ := hom_units_factor_two (A := A) (R := L) hA
  exact ⟨e2.symm.trans e1⟩

/-- **Exponent-`2` Kummer theory (the field-level two-descent).**

For a finite Galois extension `L/K` in characteristic `≠ 2` whose Galois group has exponent `2`
(`∀ σ, σ² = 1`), the subgroup `U ≤ Kˣ/(Kˣ)²` of Kummer classes having a square root in `L`
satisfies `Gal(L/K) ≃* Hom(U, 𝔽₂)`, so that `|Gal(L/K)| = |U|`; equivalently `L` is generated by
the square roots of the representatives of `U`, and `Gal(L/K)` is the Kummer dual of `U`.

The proof (all elementary, no class field theory; `Work.ClassFieldTower.Sq K = (Kˣ)²`) goes
through the Kummer pairing of `Submission.Work.ClassFieldTower.KummerSetup`:
`Gal(L/K) × U → μ₂`, `(σ, [a]) ↦ σ(√a)/√a`, whose kernel is `(Kˣ)²` and which is surjective
(the quadratic subextension `L ^ ker χ / K` realises any character `χ : Gal(L/K) →* μ₂`).
Hence `U ≃* (Gal(L/K) →* μ₂)`, and the duality theory of finite abelian groups
(`CommGroup.monoidHom_mulEquiv_of_hasEnoughRootsOfUnity`,
`CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity`) turns this into
`Gal(L/K) ≃* (U →* 𝔽₂)` and `|Gal(L/K)| = |U|`. -/
theorem kummer_expTwo_iso {K L : Type*} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (h2 : ∀ σ : L ≃ₐ[K] L, σ ^ 2 = 1)
    (hchar : (2 : K) ≠ 0) :
    ∃ (U : Subgroup (Kˣ ⧸ Sq K)),
      (∀ a : Kˣ, (QuotientGroup.mk' (Sq K) a) ∈ U ↔
        ∃ b : L, b * b = algebraMap K L (a : K)) ∧
      Nonempty ((L ≃ₐ[K] L) ≃* (U →* Multiplicative (ZMod 2))) ∧
      Nat.card (L ≃ₐ[K] L) = Nat.card U := by
  classical
  have h2L : (2 : L) ≠ 0 := two_ne_zero_algebraMap (K := K) hchar
  haveI : IsMulCommutative (L ≃ₐ[K] L) := ⟨⟨mul_comm_of_sq_eq_one h2⟩⟩
  have hexpG : Monoid.exponent (L ≃ₐ[K] L) ∣ 2 :=
    Monoid.exponent_dvd.mpr (fun σ => orderOf_dvd_iff_pow_eq_one.mpr (h2 σ))
  have hcard2 : Nat.card (rootsOfUnity 2 L) = 2 := by
    obtain ⟨e⟩ := rootsOfUnity_two_equiv_zmod_two (R := L) h2L
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card]
    simp
  haveI hERU2 : HasEnoughRootsOfUnity L 2 :=
    HasEnoughRootsOfUnity.of_card_le (R := L) (n := 2) (by rw [hcard2])
  haveI hERU : HasEnoughRootsOfUnity L (Monoid.exponent (L ≃ₐ[K] L)) :=
    HasEnoughRootsOfUnity.of_dvd L hexpG
  have hkerψ : ((QuotientGroup.mk' (Sq K)).comp (kummerSquareRoots K L).subtype).ker =
      (Sq K).subgroupOf (kummerSquareRoots K L) := by
    ext a
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply, Subgroup.mem_subgroupOf, QuotientGroup.mk'_apply,
      QuotientGroup.eq_one_iff]
    rfl
  have hrangeψ : ((QuotientGroup.mk' (Sq K)).comp (kummerSquareRoots K L).subtype).range =
      kummerU K L := by
    rw [kummerU, MonoidHom.range_comp, Subgroup.range_subtype]
  have hrangeθ : (kummerThetaHom (K := K) (L := L)).range = ⊤ :=
    MonoidHom.range_eq_top.mpr (kummerThetaHom_surjective hchar)
  have hiso : Nonempty (kummerU K L ≃* ((L ≃ₐ[K] L) →* rootsOfUnity 2 L)) :=
    ⟨(MulEquiv.subgroupCongr hrangeψ).symm.trans
      ((QuotientGroup.quotientKerEquivRange _).symm.trans
        ((QuotientGroup.quotientMulEquivOfEq
            (hkerψ.trans (kummerThetaHom_ker (K := K) (L := L)).symm)).trans
          ((QuotientGroup.quotientKerEquivRange (kummerThetaHom (K := K) (L := L))).trans
            ((MulEquiv.subgroupCongr hrangeθ).trans Subgroup.topEquiv))))⟩
  obtain ⟨eU⟩ := hiso
  haveI hfinHom : Finite ((L ≃ₐ[K] L) →* rootsOfUnity 2 L) :=
    Finite.of_injective
      (fun f : (L ≃ₐ[K] L) →* rootsOfUnity 2 L => fun σ => f σ) DFunLike.coe_injective
  haveI : Finite (kummerU K L) := Finite.of_injective eU.toEquiv eU.injective
  have hUexp : ∀ u : kummerU K L, u ^ 2 = 1 := by
    intro u
    have h1 : ((u : kummerU K L) : Kˣ ⧸ Sq K) ^ 2 = 1 := by
      obtain ⟨w, hw⟩ := QuotientGroup.mk'_surjective (Sq K) ((u : kummerU K L) : Kˣ ⧸ Sq K)
      rw [← hw, ← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact mem_Sq_iff.mpr ⟨w, rfl⟩
    exact Subtype.ext h1
  obtain ⟨eG⟩ := nonempty_hom_rootsOfUnity_two_equiv_self (A := L ≃ₐ[K] L) h2 h2L
  obtain ⟨eU'⟩ := nonempty_hom_rootsOfUnity_two_equiv_self (A := kummerU K L) hUexp h2L
  obtain ⟨eμ⟩ := rootsOfUnity_two_equiv_zmod_two (R := L) h2L
  refine ⟨kummerU K L, fun a => mem_kummerU_iff (K := K) (L := L), ⟨?_⟩, ?_⟩
  · exact eG.symm.trans (eU.symm.trans (eU'.symm.trans (MulEquiv.monoidHomCongrRight eμ)))
  · rw [show Nat.card (kummerU K L)
        = Nat.card ((L ≃ₐ[K] L) →* rootsOfUnity 2 L) from Nat.card_congr eU.toEquiv]
    rw [show Nat.card ((L ≃ₐ[K] L) →* rootsOfUnity 2 L)
        = Nat.card ((L ≃ₐ[K] L) →* Lˣ) from
      (fun ⟨e⟩ => (Nat.card_congr e.toEquiv).symm) (hom_units_factor_two (A := L ≃ₐ[K] L) (R := L) h2)]
    exact (CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity (L ≃ₐ[K] L) L).symm

end Final


end Work.ClassFieldTower
