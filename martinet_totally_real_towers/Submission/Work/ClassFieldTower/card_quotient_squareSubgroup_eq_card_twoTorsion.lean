import Mathlib
import Submission.Work.ClassFieldTower.Defs

namespace Work.ClassFieldTower

/-- For a finite abelian group `A`, the quotient of `A` by the subgroup generated by the squares
has the same cardinality as the group of `2`-torsion elements of `A`.  This follows from the
first isomorphism theorem applied to the squaring endomorphism `x ↦ x²` (whose kernel is the
`2`-torsion and whose image is `A²`) together with `|A| = |A²| · |A ⧸ A²|`. -/
theorem card_quotient_squareSubgroup_eq_card_twoTorsion (A : Type*) [CommGroup A] [Finite A] :
    Nat.card (A ⧸ Subgroup.closure (Set.range (fun x : A => x ^ 2))) =
      Nat.card {x : A // x ^ 2 = 1} := by
  set K : Subgroup A := Subgroup.closure (Set.range (fun x : A => x ^ 2)) with hK
  -- the squaring endomorphism of `A`
  let f : A →* A :=
    { toFun := fun x => x ^ 2
      map_one' := one_pow 2
      map_mul' := fun x y => mul_pow x y 2 }
  -- the subgroup generated by the squares is exactly the image of `f`
  have hrange : K = f.range := by
    rw [hK]
    refine le_antisymm ?_ ?_
    · rw [Subgroup.closure_le]
      rintro y ⟨x, rfl⟩
      exact MonoidHom.mem_range.mpr ⟨x, rfl⟩
    · rintro y hy
      obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hy
      exact Subgroup.subset_closure ⟨x, rfl⟩
  -- the kernel of `f` is the `2`-torsion
  have hker : Nat.card ↥f.ker = Nat.card {x : A // x ^ 2 = 1} :=
    Nat.card_congr (Equiv.subtypeEquivRight (fun x => by
      rw [MonoidHom.mem_ker]
      rfl))
  -- Lagrange for `K`
  have hA1 : Nat.card A = Nat.card (A ⧸ K) * Nat.card ↥K :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup K
  -- Lagrange for `ker f`, together with `index (ker f) = |range f| = |K|`
  have hA2 : Nat.card A = Nat.card ↥f.ker * Nat.card ↥K := by
    have h := Subgroup.card_mul_index f.ker
    rw [Subgroup.index_ker f] at h
    rw [← hrange] at h
    exact h.symm
  have hmul : Nat.card (A ⧸ K) * Nat.card ↥K = Nat.card ↥f.ker * Nat.card ↥K := by
    rw [← hA1, ← hA2]
  have hpos : 0 < Nat.card ↥K := Nat.card_pos
  rw [Nat.mul_right_cancel hpos hmul, hker]

end Work.ClassFieldTower
