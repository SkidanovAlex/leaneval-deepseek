import Mathlib
import Submission.Work.ClassFieldTower.Defs

/-!
# `d ≥ 5` for a group mapping onto `(ℤ/2)^5`

`Work.ClassFieldTower.HasMinimalPresentation G d r` says that `G` is presented by a free group on
`d` generators modulo `r` relators.  A free presentation *exhibits* a generating set of `G` with
`d` elements (the images of the free generators), so any quotient of `G` is generated by at most
`d` elements.  The elementary abelian `2`-group `(ℤ/2)^5 = Fin 5 → Multiplicative (ZMod 2)` is a
`5`-dimensional vector space over `𝔽₂` and cannot be generated by fewer than `5` elements: if `S`
is a generating finset of it, then `S` spans it as an `𝔽₂`-vector space, so
`5 = finrank ≤ #S`.

Hence a group with a presentation by `d` generators that admits a surjection onto `(ℤ/2)^5`
satisfies `5 ≤ d`.  This is the numerical input `d ≥ 5` of the Golod--Shafarevich argument for
the Hilbert `2`-class field tower of an imaginary quadratic field.
-/

namespace Work.ClassFieldTower

open scoped Classical

set_option linter.style.haveILetI false

/-- The group `Fin n → Multiplicative (ZMod 2)` (the `n`-fold product of `ℤ/2`, written
multiplicatively) is canonically isomorphic to `Multiplicative (Fin n → ZMod 2)`, whose group
operation is pointwise addition of the underlying elements of `ZMod 2`. -/
noncomputable def piMulEquivZmodTwo (n : ℕ) :
    (Fin n → Multiplicative (ZMod 2)) ≃* Multiplicative (Fin n → ZMod 2) where
  toFun x := Multiplicative.ofAdd fun i => (x i).toAdd
  invFun y := fun i => Multiplicative.ofAdd (y.toAdd i)
  left_inv x := by funext i; simp
  right_inv y := by ext : 1; simp
  map_mul' x y := by rfl

/-- **A generating finset of `(ℤ/2)^n` (written additively) has at least `n` elements.**
The group `Multiplicative (Fin n → ZMod 2)` is the additive group of the `𝔽₂`-vector space
`(ZMod 2)^n`; its subgroups are exactly its additive subgroups, which are submodules.  A finset
generating it therefore spans it, and a spanning set of a finite dimensional vector space has at
least `finrank = n` elements. -/
private theorem card_le_of_closure_eq_top_multiplicative {n : ℕ}
    (A : Finset (Multiplicative (Fin n → ZMod 2)))
    (hA : Subgroup.closure (A : Set (Multiplicative (Fin n → ZMod 2))) = ⊤) :
    n ≤ A.card := by
  classical
  have htop : Subgroup.toAddSubgroup' (⊤ : Subgroup (Multiplicative (Fin n → ZMod 2))) = ⊤ :=
    OrderIso.map_top _
  -- the generation hypothesis, transported to the additive group
  have hclos : AddSubgroup.closure
      (Multiplicative.ofAdd ⁻¹' (A : Set (Multiplicative (Fin n → ZMod 2)))) = ⊤ := by
    rw [← Subgroup.toAddSubgroup'_closure (S := (A : Set (Multiplicative (Fin n → ZMod 2)))),
      hA, htop]
  set B : Finset (Fin n → ZMod 2) := A.image Multiplicative.toAdd with hBdef
  have hBcoe : (Multiplicative.ofAdd ⁻¹' (A : Set (Multiplicative (Fin n → ZMod 2))))
      = (B : Set (Fin n → ZMod 2)) := by
    ext y
    simp only [Set.mem_preimage, Finset.mem_coe, hBdef, Finset.mem_image]
    exact ⟨fun hy => ⟨Multiplicative.ofAdd y, hy, rfl⟩,
      by rintro ⟨a, ha, rfl⟩; simpa using ha⟩
  -- `B` spans the vector space `(ZMod 2)^n`
  have hspan : Submodule.span (ZMod 2) (B : Set (Fin n → ZMod 2)) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    have hx : x ∈ AddSubgroup.closure (B : Set (Fin n → ZMod 2)) := by
      rw [← hBcoe, hclos]; trivial
    have hle : AddSubgroup.closure (B : Set (Fin n → ZMod 2))
        ≤ (Submodule.span (ZMod 2) (B : Set (Fin n → ZMod 2))).toAddSubgroup :=
      (AddSubgroup.closure_le _).mpr (fun y hy => Submodule.subset_span hy)
    exact hle hx
  have hfr : Module.finrank (ZMod 2) (Fin n → ZMod 2) ≤ B.card := by
    have h := finrank_span_le_card (R := ZMod 2) (M := Fin n → ZMod 2)
      (s := (B : Set (Fin n → ZMod 2)))
    rw [hspan, finrank_top, Finset.toFinset_coe] at h
    exact h
  rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at hfr
  exact hfr.trans (by rw [hBdef]; exact Finset.card_image_le)

/-- **A generating finset of `(ℤ/2)^n` has at least `n` elements**, in the multiplicatively
written form `Fin n → Multiplicative (ZMod 2)` used on the arithmetic side. -/
private theorem card_le_of_closure_eq_top_pi {n : ℕ}
    (A : Finset (Fin n → Multiplicative (ZMod 2)))
    (hA : Subgroup.closure (A : Set (Fin n → Multiplicative (ZMod 2))) = ⊤) :
    n ≤ A.card := by
  classical
  have hgen : Subgroup.closure
      ((A.image (piMulEquivZmodTwo n) : Finset (Multiplicative (Fin n → ZMod 2))) :
        Set (Multiplicative (Fin n → ZMod 2))) = ⊤ := by
    have h1 : Subgroup.map (piMulEquivZmodTwo n).toMonoidHom
        (Subgroup.closure (A : Set (Fin n → Multiplicative (ZMod 2))))
        = Subgroup.closure ((piMulEquivZmodTwo n).toMonoidHom ''
            (A : Set (Fin n → Multiplicative (ZMod 2)))) :=
      MonoidHom.map_closure _ _
    rw [hA, Subgroup.map_top_of_surjective _ (piMulEquivZmodTwo n).surjective] at h1
    rw [Finset.coe_image]
    exact h1.symm
  calc n ≤ (A.image (piMulEquivZmodTwo n)).card :=
        card_le_of_closure_eq_top_multiplicative _ hgen
    _ ≤ A.card := Finset.card_image_le

/-- **The generator rank is at least `5` whenever `G` maps onto `(ℤ/2)^5`.**

A free presentation of `G` by `d` generators exhibits a generating set of `G` with `d` elements
(the images of the free generators).  Its image under a surjection `G →* (ℤ/2)^5` generates
`(ℤ/2)^5`, which needs at least `5` elements; hence `5 ≤ d`. -/
theorem five_le_of_surjective_zmodTwo_five {G : Type*} [Group G] {d r : ℕ}
    (h : HasMinimalPresentation G d r) (φ : G →* (Fin 5 → Multiplicative (ZMod 2)))
    (hφ : Function.Surjective φ) : 5 ≤ d := by
  classical
  obtain ⟨α, hαfin, hαdec, rel, hcard, _hrelcard, hiso, _hmin⟩ := h
  obtain ⟨e⟩ := hiso
  -- the composite `FreeGroup α →ᴹ G`: the quotient map, followed by the inverse isomorphism
  let F : FreeGroup α →* G :=
    (e.symm : _ →* G).comp (QuotientGroup.mk' (Subgroup.normalClosure (rel : Set (FreeGroup α))))
  have hF : Function.Surjective F :=
    e.symm.surjective.comp (QuotientGroup.mk'_surjective _)
  -- the images of the free generators generate `G`
  have hclos : Subgroup.closure (Set.range (fun a : α => F (FreeGroup.of a))) = ⊤ := by
    have h1 : Subgroup.closure (F '' Set.range (FreeGroup.of : α → FreeGroup α)) = ⊤ := by
      rw [← MonoidHom.map_closure F (Set.range (FreeGroup.of : α → FreeGroup α)),
        FreeGroup.closure_range_of α, Subgroup.map_top_of_surjective _ hF]
    have h2 : Set.range (fun a : α => F (FreeGroup.of a))
        = F '' Set.range (FreeGroup.of : α → FreeGroup α) :=
      Set.range_comp' F (FreeGroup.of : α → FreeGroup α)
    rw [h2]
    exact h1
  -- a generating finset of `G` with at most `d` elements
  set S : Finset G := Finset.univ.image (fun a : α => F (FreeGroup.of a)) with hSdef
  have hSgen : Subgroup.closure (S : Set G) = ⊤ := by
    rw [hSdef, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact hclos
  have hScard : S.card ≤ d := by
    calc S.card ≤ (Finset.univ : Finset α).card := Finset.card_image_le
      _ = Fintype.card α := Finset.card_univ
      _ = d := hcard
  -- its image generates `(ℤ/2)^5`
  have hImg : Subgroup.closure ((S.image φ : Finset (Fin 5 → Multiplicative (ZMod 2))) :
      Set (Fin 5 → Multiplicative (ZMod 2))) = ⊤ := by
    rw [Finset.coe_image, ← MonoidHom.map_closure φ (S : Set G), hSgen,
      Subgroup.map_top_of_surjective _ hφ]
  calc 5 ≤ (S.image φ).card := card_le_of_closure_eq_top_pi _ hImg
    _ ≤ S.card := Finset.card_image_le
    _ ≤ d := hScard

end Work.ClassFieldTower
