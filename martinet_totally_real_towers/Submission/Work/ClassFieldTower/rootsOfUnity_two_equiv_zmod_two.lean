import Mathlib

/-!
# The square roots of unity in a field of characteristic `≠ 2`

For a field `R` with `(2 : R) ≠ 0`, the group `rootsOfUnity 2 R` of square roots of `1`
in `Rˣ` is cyclic of order two, generated by `-1` (which is `≠ 1` precisely because
`(2 : R) ≠ 0`).  Hence it is isomorphic to `Multiplicative (ZMod 2)`.

The proof is a cardinality computation: `orderOf (-1 : Rˣ) = 2`, so
`Subgroup.zpowers (-1) = rootsOfUnity 2 R` by `Subgroup.eq_of_le_of_card_ge`
(the subgroup generated by `-1` is contained in the roots of unity, and the latter
has at most `2` elements by `card_rootsOfUnity`).  Two finite cyclic groups of the
same cardinality are isomorphic (`mulEquivOfCyclicCardEq`).
-/

namespace Work.ClassFieldTower

theorem rootsOfUnity_two_equiv_zmod_two {R : Type*} [Field R] (hchar : (2 : R) ≠ 0) :
    Nonempty (rootsOfUnity 2 R ≃* Multiplicative (ZMod 2)) := by
  -- In a field with `(2 : R) ≠ 0` we have `-1 ≠ 1`.
  have hne : (-1 : Rˣ) ≠ 1 := by
    intro h
    have h' : (-1 : R) = 1 := congrArg Units.val h
    rw [neg_eq_iff_add_eq_zero] at h'
    exact hchar (by rw [← one_add_one_eq_two]; exact h')
  -- and `(-1) ^ 2 = 1`, so `-1` has order `2`.
  have hsq : (-1 : Rˣ) ^ 2 = 1 := by simp
  have hord : orderOf (-1 : Rˣ) = 2 := orderOf_eq_prime hsq hne
  -- Consequently the subgroup generated by `-1` is exactly the group of square roots of unity.
  have hzp : Subgroup.zpowers (-1 : Rˣ) = rootsOfUnity 2 R := by
    refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le_of_mem hsq) ?_
    rw [Nat.card_zpowers, hord]
    exact card_rootsOfUnity R 2
  have hcard : Nat.card (rootsOfUnity 2 R) = 2 := by
    rw [← hzp, Nat.card_zpowers, hord]
  -- Two finite cyclic groups of the same cardinality are isomorphic.
  exact ⟨mulEquivOfCyclicCardEq (G := rootsOfUnity 2 R) (G' := Multiplicative (ZMod 2))
    (by rw [hcard]; simp)⟩

end Work.ClassFieldTower
