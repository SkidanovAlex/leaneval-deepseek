import Mathlib

namespace Work.ClassFieldTower

open IntermediateField

/-- **A degree-two extension is generated by a square root.**

If `M` is an intermediate field of `L / K` with `[M : K] = 2` and `2 ≠ 0` in `K`, then `M` is
generated over `K` by an element `b` whose square lies in `K` (indeed in `Kˣ`): writing
`x ∈ M \ K` and `x * x = p * x + q` with `p q : K` (from `finrank K M = 2`), the element
`b = 2 * x - p` satisfies `b * b = 4 * q + p * p ∈ K` and `K⟮b⟯ = M`. -/
theorem degreeTwo_sqrt_gen {K L : Type*} [Field K] [Field L] [Algebra K L]
    (hchar : (2 : K) ≠ 0) (M : IntermediateField K L) (hM : Module.finrank K ↥M = 2) :
    ∃ (a : Kˣ) (b : L), b ∈ M ∧ b * b = algebraMap K L (a : K) ∧
      IntermediateField.adjoin K ({b} : Set L) = M := by
  -- `↥M` is a two-dimensional `K`-algebra, so its intermediate-field lattice is a boolean-ish
  -- simple order: every intermediate field is `⊥` or `⊤`.
  have hsimple : IsSimpleOrder (IntermediateField K ↥M) :=
    IntermediateField.isSimpleOrder_of_finrank_prime (F := K) (E := ↥M) (by rw [hM]; norm_num)
  -- `⊥ ≠ ⊤` since their `K`-dimensions are `1` and `2`.
  have hne : (⊥ : IntermediateField K ↥M) ≠ ⊤ := by
    intro h
    have h1 : Module.finrank K (⊥ : IntermediateField K ↥M) = 1 := IntermediateField.finrank_bot
    have h2 : Module.finrank K (⊤ : IntermediateField K ↥M) = 2 := by
      rw [IntermediateField.finrank_top']; exact hM
    rw [h] at h1; omega
  -- Pick `x ∈ ↥M` with `x ∉ ⊥`, i.e. `x` is not in the image of `K`.
  obtain ⟨x, -, hx⟩ := (SetLike.lt_iff_le_and_exists.mp (lt_of_le_of_ne bot_le hne)).2
  -- `1` and `x` are linearly independent over `K`.
  have hli : LinearIndependent K ![x, 1] := by
    rw [linearIndependent_fin2]
    refine ⟨one_ne_zero, fun a ha => hx ?_⟩
    have ha' : a • (1 : ↥M) = x := by simpa using ha
    exact IntermediateField.mem_bot.mpr ⟨a, by rw [← ha', Algebra.smul_def, mul_one]⟩
  -- Hence `![x, 1]` is a `K`-basis of `↥M`, and expanding `x * x` in it gives `p, q : K` with
  -- `x * x = p * x + q`.
  let B : Module.Basis (Fin 2) K ↥M := basisOfLinearIndependentOfCardEqFinrank hli (by simp [hM])
  have hB : ∀ i, B i = ![x, 1] i := fun i => by
    rw [coe_basisOfLinearIndependentOfCardEqFinrank]
  obtain ⟨p, q, hxrel⟩ : ∃ p q : K, algebraMap K ↥M p * x + algebraMap K ↥M q = x * x := by
    refine ⟨B.repr (x*x) 0, B.repr (x*x) 1, ?_⟩
    have hsum := B.sum_repr (x * x)
    rw [Fin.sum_univ_two, hB 0, hB 1] at hsum
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Algebra.smul_def, mul_one] at hsum
    exact hsum
  -- The completing-the-square element `bE = 2 * x - p`.
  set bE : ↥M := (2:↥M) * x - algebraMap K ↥M p with hbEdef
  have hq : algebraMap K ↥M (4*q + p*p)
      = 4 * algebraMap K ↥M q + algebraMap K ↥M p * algebraMap K ↥M p := by
    rw [map_add, map_mul, map_mul, map_ofNat]
  have hbE2 : bE * bE = algebraMap K ↥M (4*q + p*p) := by
    rw [hq, hbEdef]
    have step : ((2:↥M) * x - algebraMap K ↥M p) * ((2:↥M) * x - algebraMap K ↥M p)
        = 4 * (x * x) - 4 * (algebraMap K ↥M p) * x
          + (algebraMap K ↥M p) * (algebraMap K ↥M p) := by
      ring
    rw [step, ← hxrel]
    ring
  -- `bE = 2 * x - p` is not zero, because then `x = p / 2` would lie in `K = ⊥`.
  have hmul : algebraMap K ↥M ((2:K)⁻¹) * (2:↥M) = 1 := by
    rw [show (2:↥M) = algebraMap K ↥M (2:K) from by rw [map_ofNat],
      ← map_mul, inv_mul_cancel₀ hchar, map_one]
  have hx_decomp : algebraMap K ↥M ((2:K)⁻¹) * bE + algebraMap K ↥M ((2:K)⁻¹ * p) = x := by
    have h2c : (2:↥M) = algebraMap K ↥M (2:K) := by rw [map_ofNat]
    calc algebraMap K ↥M ((2:K)⁻¹) * bE + algebraMap K ↥M ((2:K)⁻¹ * p)
        = algebraMap K ↥M ((2:K)⁻¹) * ((2:↥M)*x - algebraMap K ↥M p)
            + algebraMap K ↥M ((2:K)⁻¹) * algebraMap K ↥M p := by rw [hbEdef, map_mul]
      _ = algebraMap K ↥M ((2:K)⁻¹) * ((2:↥M)*x) := by ring
      _ = (algebraMap K ↥M ((2:K)⁻¹) * (2:↥M)) * x := by rw [mul_assoc]
      _ = x := by rw [hmul, one_mul]
  have hbE_ne : bE ≠ 0 := by
    intro h
    apply hx
    have hxval : x = algebraMap K ↥M ((2:K)⁻¹ * p) := by
      rw [← hx_decomp, h, mul_zero, zero_add]
    exact IntermediateField.mem_bot.mpr ⟨(2:K)⁻¹ * p, hxval.symm⟩
  -- Thus `4 * q + p * p` — the square of `bE` — is a nonzero element of `K`.
  have haK : 4*q + p*p ≠ 0 := by
    intro h
    have hbb : bE * bE = 0 := by rw [hbE2, h, map_zero]
    exact hbE_ne (mul_self_eq_zero.mp hbb)
  -- `x` lies in `K⟮bE⟯`, and `K⟮x⟯ = ⊤` by the simple-order property, so `K⟮bE⟯ = ⊤`.
  have hx_in : x ∈ IntermediateField.adjoin K ({bE} : Set ↥M) := by
    rw [← hx_decomp]
    exact add_mem (mul_mem (_root_.algebraMap_mem _ _) (mem_adjoin_simple_self K bE))
      (_root_.algebraMap_mem _ _)
  have htop_x : IntermediateField.adjoin K ({x} : Set ↥M) = ⊤ := by
    rcases hsimple.eq_bot_or_eq_top (IntermediateField.adjoin K ({x} : Set ↥M)) with h | h
    · exact absurd h (by rw [adjoin_simple_eq_bot_iff]; exact hx)
    · exact h
  have htop_bE : IntermediateField.adjoin K ({bE} : Set ↥M) = ⊤ := by
    have hle : IntermediateField.adjoin K ({x} : Set ↥M)
        ≤ IntermediateField.adjoin K ({bE} : Set ↥M) :=
      adjoin_simple_le_iff.mpr hx_in
    rw [htop_x] at hle
    exact (le_antisymm hle le_top).symm
  -- Transport everything along the structure map `↥M →ₐ[K] L`.
  refine ⟨Units.mk0 (4*q + p*p) haK, (bE : L), bE.2, ?_, ?_⟩
  · have h1 : ((bE * bE : ↥M) : L) = (bE : L) * (bE : L) := map_mul M.val bE bE
    rw [← h1, hbE2]
    exact M.val.commutes (4*q + p*p)
  · have key : (IntermediateField.adjoin K ({bE} : Set ↥M)).map M.val
        = IntermediateField.adjoin K ({(bE:L)} : Set L) := by
      rw [IntermediateField.adjoin_map, Set.image_singleton, IntermediateField.coe_val]
    have key2 : (⊤ : IntermediateField K ↥M).map M.val = M := by
      rw [← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]
    have h := congrArg (IntermediateField.map M.val) htop_bE
    rw [key, key2] at h
    exact h

end Work.ClassFieldTower
