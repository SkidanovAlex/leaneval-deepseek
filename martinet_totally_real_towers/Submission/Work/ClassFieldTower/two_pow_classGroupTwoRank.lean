import Mathlib
import Submission.Work.ClassFieldTower.Defs

/-!
# `Work.ClassFieldTower.two_pow_classGroupTwoRank`

`classGroupTwoRank F` is defined as the base-`2` logarithm of the cardinality of
`Cl(F)/Cl(F)^2`.  The class group is finite, and `Cl(F)/Cl(F)^2` is generated by the
images of the class group, every element of which has square `1`; hence it is an
elementary abelian `2`-group, its cardinality is a power of `2`, and taking the base-`2`
logarithm is therefore lossless:

`2 ^ classGroupTwoRank F = #(Cl(F)/Cl(F)^2)`.

This is the "`Nat.log`/cardinality" compatibility used to pass between the two
presentations of the `2`-rank of the class group.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Classical

noncomputable section

namespace Work.ClassFieldTower

/-- A finite group all of whose elements are involutions has cardinality a power of `2`,
so its base-`2` logarithm recovers the cardinality: `2 ^ log_2 #G = #G`.

The proof is by cases: the quotient of a finite commutative group by the subgroup generated
by the squares is a finite group of exponent `2`, hence a finite `2`-group
(`IsPGroup.exists_card_eq`), so its cardinality is `2 ^ n` and `Nat.log_pow` finishes. -/
theorem two_pow_log_card_sq_quotient {G : Type*} [CommGroup G] [Finite G] :
    2 ^ Nat.log 2 (Nat.card (G ⧸ Subgroup.closure (Set.range (fun x : G => x ^ 2))))
      = Nat.card (G ⧸ Subgroup.closure (Set.range (fun x : G => x ^ 2))) := by
  classical
  set H : Subgroup G := Subgroup.closure (Set.range (fun x : G => x ^ 2)) with hH
  haveI : H.Normal := Subgroup.normal_of_isMulCommutative H
  haveI : Finite (G ⧸ H) :=
    Finite.of_surjective (QuotientGroup.mk' H) (QuotientGroup.mk'_surjective H)
  -- every element of `G ⧸ H` is an involution, since `H` contains all squares of `G`
  have hexp : ∀ x : G ⧸ H, x ^ 2 = 1 := by
    intro x
    refine QuotientGroup.induction_on (x := x) (C := fun y => y ^ 2 = 1) ?_
    intro g
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact Subgroup.subset_closure ⟨g, rfl⟩
  -- hence `G ⧸ H` is a finite `2`-group, so its cardinality is a power of `2`
  obtain ⟨n, hn⟩ :=
    IsPGroup.exists_card_eq (p := 2) (G := G ⧸ H) (fun g => ⟨1, by simpa using hexp g⟩)
  rw [hn, Nat.log_pow (by norm_num)]

/-- **`2 ^ classGroupTwoRank F = #(Cl(F)/Cl(F)^2)`.**

`classGroupTwoRank F` is the base-`2` logarithm of the cardinality of the quotient of the
class group by its square subgroup, so this says that the logarithm loses nothing: the
quotient is an elementary abelian `2`-group, i.e. its cardinality is a power of `2`. -/
theorem two_pow_classGroupTwoRank (F : Type*) [Field F] [NumberField F] :
    2 ^ classGroupTwoRank F = Nat.card (ClassGroup (NumberField.RingOfIntegers F) ⧸
      Subgroup.closure (Set.range (fun x : ClassGroup (NumberField.RingOfIntegers F) => x ^ 2))) := by
  classical
  have h := two_pow_log_card_sq_quotient (G := ClassGroup (NumberField.RingOfIntegers F))
  simpa [classGroupTwoRank] using h

end Work.ClassFieldTower
