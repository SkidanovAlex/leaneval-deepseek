import Mathlib
import Submission.Work.ClassFieldTower.ProTwoGenus
import Submission.Work.ClassFieldTower.WitnessField
import Submission.Work.QuadraticFields.GenusCertificate
import Submission.Work.ClassFieldTower.differentIdeal_eq_top_of_isUnramifiedAtFinitePrimes
import Submission.Work.ClassFieldTower.differentIdeal_eq_top_of_base_ringEquiv
import Submission.Work.ClassFieldTower.multiQuad_aut_pow_two

/-!
# `Work.ClassFieldTower.hasGenusLevel_witness` -- the genus level of `ℚ(√-30030)`

`HasGenusLevel F` is the pure-genus-theory (class-field-theory-free) half of the Golod--Shafarevich
input: the existence of a *finite unramified* Galois extension `L / F` of degree `2 ^ 5 = 32` whose
Galois group has exponent `2`.  This file proves it for the concrete imaginary quadratic witness
field `Kc = ℚ(√-30030)` of `Submission/Work/ClassFieldTower/WitnessField.lean`, by exhibiting the
**genus field**

  `L = ℚ(√8, √-3, √5, √-7, √-11, √13)`,

which is the multiquadratic (Kummer) field attached to the six prime discriminants

  `8, -3, 5, -7, -11, 13`   of   `disc Kc = -120120 = 8 · (-3) · 5 · (-7) · (-11) · 13`.

Its subfield `ℚ(√8 · √-3 · √5 · √-7 · √-11 · √13) = ℚ(√-120120) = ℚ(√-30030) = Kc` is the
subfield generated by the product of the six chosen square roots, and classical genus theory (here
`Work.QuadraticFields.isUnramifiedAtFinitePrimes_multiQuad`, proved in the quadratic-fields
chapter) says that `L` is unramified over it; `[L : Kc] = 64 / 2 = 32` and
`Gal(L/Kc) ≤ Gal(L/ℚ) = (ℤ/2) ^ 6` has exponent `2`.

## Main results

* `Work.ClassFieldTower.hasGenusLevel_witness : HasGenusLevel Kc`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000

open scoped Classical
open NumberField

namespace Work.ClassFieldTower

noncomputable section

/-- The six prime discriminants of the genus field of `Kc = ℚ(√-30030)`; their product is the
fundamental discriminant `-120120` of `Kc`. -/
def wPrimes : Finset ℤ := {8, -3, 5, -7, -11, 13}

/-- The same six numbers, as rationals. -/
def wPrimesQ : Finset ℚ := wPrimes.image (fun d : ℤ => (d : ℚ))

/-- The genus field `ℚ(√8, √-3, √5, √-7, √-11, √13)` of `Kc`, as a type. -/
abbrev wM : Type := ↥(Work.QuadraticFields.multiQuad wPrimesQ)

/-- The chosen square roots of the six prime discriminants, inside the genus field. -/
def wRoot (a : ℤ) : wM :=
  if h : a ∈ wPrimes then
    (⟨Work.QuadraticFields.sqrtVal (a : ℚ),
      Work.QuadraticFields.sqrtVal_mem_multiQuad (s := wPrimesQ)
        (Finset.mem_image.mpr ⟨a, h, rfl⟩)⟩ : wM)
  else 1

/-- The quadratic subfield `ℚ(∏ √d) = ℚ(√-120120) = Kc` of the genus field. -/
def wBase : IntermediateField ℚ wM := Work.QuadraticFields.prodSubfield wPrimes wRoot

theorem wRoot_of_mem {a : ℤ} (ha : a ∈ wPrimes) :
    wRoot a = (⟨Work.QuadraticFields.sqrtVal (a : ℚ),
      Work.QuadraticFields.sqrtVal_mem_multiQuad (s := wPrimesQ)
        (Finset.mem_image.mpr ⟨a, ha, rfl⟩)⟩ : wM) :=
  dite_eq_left ha

theorem wRoot_sq (a : ℤ) (ha : a ∈ wPrimes) :
    wRoot a ^ 2 = algebraMap ℚ wM (a : ℚ) := by
  rw [wRoot_of_mem ha]
  apply Subtype.ext
  change Work.QuadraticFields.sqrtVal (a : ℚ) ^ 2
      = algebraMap ℚ (AlgebraicClosure ℚ) (a : ℚ)
  rw [Work.QuadraticFields.sqrtVal_sq]

theorem wPrimes_card : wPrimes.card = 6 := by norm_num [wPrimes]

theorem wPrimesQ_card : wPrimesQ.card = 6 := by
  rw [wPrimesQ, Finset.card_image_of_injective _ (fun a b h => by exact_mod_cast h)]
  exact wPrimes_card

theorem wPrimes_prod : (∏ a ∈ wPrimes, (a : ℚ)) = -120120 := by norm_num [wPrimes]

theorem wPrimes_mem_iff {a : ℤ} :
    a ∈ wPrimes ↔ a = 8 ∨ a = -3 ∨ a = 5 ∨ a = -7 ∨ a = -11 ∨ a = 13 := by
  simp [wPrimes]

theorem wPrimes_isPrimeDiscriminant (a : ℤ) (ha : a ∈ wPrimes) :
    Work.QuadraticFields.IsPrimeDiscriminant a := by
  rw [wPrimes_mem_iff] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr (Or.inr ⟨3, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨5, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨7, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨11, by norm_num, by norm_num, by norm_num⟩))
  · exact Or.inr (Or.inr (Or.inr ⟨13, by norm_num, by norm_num, by norm_num⟩))

theorem wPrimes_coprime (a b : ℤ) (ha : a ∈ wPrimes) (hb : b ∈ wPrimes) (hne : a ≠ b) :
    Nat.Coprime a.natAbs b.natAbs := by
  rw [Nat.coprime_iff_gcd_eq_one]
  rw [wPrimes_mem_iff] at ha hb
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl <;>
    rcases hb with rfl | rfl | rfl | rfl | rfl | rfl <;>
    first | (exfalso; exact hne rfl) | (norm_num)

/-- **The chosen square roots generate the genus field.**  (Proof adapted from the delegated
lemma of the same content in `Submission/Work/ClassFieldTower/wRoot_generates.lean`; it is
reproduced here (under a primed name) because the delegated module imports this one and so cannot
be imported back.) -/
theorem wRoot_generates' :
    Work.QuadraticFields.multiquadSub wPrimes wRoot = ⊤ := by
  let L : IntermediateField ℚ (AlgebraicClosure ℚ) := Work.QuadraticFields.multiQuad wPrimesQ
  refine IntermediateField.map_injective L.val ?_
  have hgen : (Work.QuadraticFields.multiquadSub wPrimes wRoot).map (L.val) = L := by
    rw [Work.QuadraticFields.multiquadSub, IntermediateField.adjoin_map]
    congr 1
    ext y
    simp only [Set.mem_image, Finset.mem_coe]
    constructor
    · rintro ⟨x, ⟨a, ha, rfl⟩, rfl⟩
      exact ⟨(a : ℚ), Finset.mem_image.mpr ⟨a, ha, rfl⟩, by rw [wRoot_of_mem ha]; rfl⟩
    · rintro ⟨q, hq, rfl⟩
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hq
      exact ⟨wRoot a, ⟨a, ha, rfl⟩, by rw [wRoot_of_mem ha]; rfl⟩
  rw [hgen, ← AlgHom.fieldRange_eq_map, IntermediateField.fieldRange_val]

/-- **The product of any nonempty subfamily of `wPrimes` is not a rational square.**
(Proof adapted from the delegated lemma in `Submission/Work/ClassFieldTower/wPrimesQ_nonsquare.lean`;
reproduced here, with the auxiliaries inlined as `have`s, because the delegated module imports this
one and so cannot be imported back.) -/
theorem wPrimesQ_nonsquare' (T : Finset ℚ) (hT : T ⊆ wPrimesQ) (hne : T.Nonempty) :
    ∀ r : ℚ, r ^ 2 ≠ ∏ a ∈ T, a := by
  -- a prime dividing an integer exactly once prevents it from being a rational square
  have hnotsq : ∀ (p n : ℤ), Prime p → p ∣ n → ¬ p ^ 2 ∣ n → ¬ IsSquare (n : ℚ) := by
    intro p n hp h1 h2
    rw [Rat.isSquare_intCast_iff]
    rintro ⟨k, hk⟩
    apply h2
    have hpk : p ∣ k := by
      apply hp.dvd_of_dvd_pow (n := 2)
      rw [pow_two, ← hk]
      exact h1
    obtain ⟨c, hc⟩ := hpk
    rw [hk, hc]
    exact ⟨c * c, by ring⟩
  have hprime : ∀ a ∈ wPrimes, a ≠ 8 → Prime a := by
    intro a ha h8
    rw [wPrimes_mem_iff] at ha
    rcases ha with rfl | rfl | rfl | rfl | rfl | rfl
    · exact absurd rfl h8
    all_goals decide
  have hnotdvd : ∀ p d : ℤ, p ∈ wPrimes → p ≠ 8 → d ∈ wPrimes → p ≠ d → ¬ p ∣ d := by
    intro p d hp h8 hd hpd
    rw [wPrimes_mem_iff] at hp hd
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;>
      rcases hd with rfl | rfl | rfl | rfl | rfl | rfl <;>
      first
        | (exfalso; exact h8 rfl)
        | (exfalso; exact hpd rfl)
        | decide
  have htwo : ∀ d ∈ wPrimes, d ≠ 8 → ¬ (2 : ℤ) ∣ d := by
    intro d hd h8
    rw [wPrimes_mem_iff] at hd
    rcases hd with rfl | rfl | rfl | rfl | rfl | rfl
    · exact absurd rfl h8
    all_goals decide
  -- the integral form: no nonempty subproduct of `wPrimes` is an integer square
  have hint : ∀ S : Finset ℤ, S ⊆ wPrimes → S.Nonempty →
      ¬ IsSquare (((∏ d ∈ S, d : ℤ)) : ℚ) := by
    intro S hS hSne
    by_cases h8 : (8 : ℤ) ∈ S
    · -- `8 ∈ S`: the product is `8 * B` with `B` odd, and the odd exponent `3` of `2` obstructs
      set B : ℤ := ∏ d ∈ S.erase (8 : ℤ), d with hBdef
      have hA : ∏ d ∈ S, d = 8 * B := by
        rw [← Finset.mul_prod_erase S (fun d : ℤ => d) h8, hBdef]
      have hBodd : ¬ (2 : ℤ) ∣ B := by
        rw [hBdef]
        intro h2
        obtain ⟨d, hdmem, h2d⟩ :=
          (show Prime (2 : ℤ) by norm_num).dvd_finsetProd_iff (fun d : ℤ => d) |>.mp h2
        rw [Finset.mem_erase] at hdmem
        exact htwo d (hS hdmem.2) hdmem.1 h2d
      rintro hsq
      obtain ⟨m, hm⟩ := Rat.isSquare_intCast_iff.mp hsq
      have h2m : (2 : ℤ) ∣ m := by
        apply (show Prime (2 : ℤ) by norm_num).dvd_of_dvd_pow (n := 2)
        rw [pow_two, ← hm, hA]
        exact ⟨4 * B, by ring⟩
      obtain ⟨m₁, hm₁⟩ := h2m
      have hmul : 8 * B = (2 * m₁) * (2 * m₁) := by
        rw [← hm₁, ← hm, hA]
      have hkey : 2 * B = m₁ * m₁ := by
        refine mul_left_cancel₀ (show (4 : ℤ) ≠ 0 by norm_num) ?_
        rw [show (4 : ℤ) * (2 * B) = 8 * B by ring, hmul]
        ring
      refine hnotsq (2 : ℤ) (2 * B) (by norm_num) ⟨B, by ring⟩ ?_ ?_
      · rw [pow_two]
        intro h
        exact hBodd ((mul_dvd_mul_iff_left (a := (2 : ℤ)) (b := (2 : ℤ)) (c := B)
          (show (2 : ℤ) ≠ 0 by norm_num)).mp h)
      · exact ⟨(m₁ : ℚ), by
          rw [show ((2 * B : ℤ) : ℚ) = ((m₁ * m₁ : ℤ) : ℚ) by exact_mod_cast hkey,
            Int.cast_mul]⟩
    · -- `8 ∉ S`: some prime divides the product exactly once
      set p : ℤ := S.max' hSne with hpdef
      have hpS : p ∈ S := by
        rw [hpdef]
        exact Finset.max'_mem S hSne
      have hpW : p ∈ wPrimes := hS hpS
      have hpne8 : p ≠ 8 := fun h => h8 (h ▸ hpS)
      have hpprime : Prime p := hprime p hpW hpne8
      have hdvd : p ∣ ∏ d ∈ S, d := Finset.dvd_prod_of_mem (fun d : ℤ => d) hpS
      have hndvd : ¬ p ^ 2 ∣ ∏ d ∈ S, d := by
        intro h2
        rw [← Finset.mul_prod_erase S (fun d : ℤ => d) hpS] at h2
        rw [pow_two] at h2
        have hm : p ∣ ∏ d ∈ S.erase p, d := (mul_dvd_mul_iff_left hpprime.ne_zero).mp h2
        obtain ⟨d, hdmem, hpdvd⟩ := (hpprime.dvd_finsetProd_iff (fun d : ℤ => d)).mp hm
        rw [Finset.mem_erase] at hdmem
        exact hnotdvd p d hpW hpne8 (hS hdmem.2) (Ne.symm hdmem.1) hpdvd
      exact hnotsq p (∏ d ∈ S, d) hpprime hdvd hndvd
  -- transfer from `wPrimesQ` to `wPrimes`
  intro r hr
  set S : Finset ℤ := wPrimes.filter (fun d => (d : ℚ) ∈ T) with hSdef
  have hSmem : ∀ d : ℤ, d ∈ S ↔ d ∈ wPrimes ∧ (d : ℚ) ∈ T := by
    intro d
    rw [hSdef, Finset.mem_filter]
  have himg : S.image (fun d : ℤ => (d : ℚ)) = T := by
    ext a
    constructor
    · intro ha
      obtain ⟨d, hdS, hda⟩ := Finset.mem_image.mp ha
      have hdT := ((hSmem d).mp hdS).2
      rwa [hda] at hdT
    · intro ha
      have ha' : a ∈ wPrimesQ := hT ha
      simp only [wPrimesQ, Finset.mem_image] at ha'
      obtain ⟨d, hdw, hda⟩ := ha'
      exact Finset.mem_image.mpr
        ⟨d, (hSmem d).mpr ⟨hdw, by rw [hda]; exact ha⟩, hda⟩
  have hSne : S.Nonempty := by
    rw [← himg] at hne
    exact Finset.image_nonempty.mp hne
  have hprod : ∏ a ∈ T, a = ((∏ d ∈ S, d : ℤ) : ℚ) := by
    rw [← himg]
    rw [Finset.prod_image (f := fun a : ℚ => a) (g := fun d : ℤ => (d : ℚ))
      (fun x _ y _ hxy => Int.cast_injective hxy)]
    exact (Int.cast_prod (fun d : ℤ => d) S).symm
  rw [hprod] at hr
  exact hint S (fun d hd => ((hSmem d).mp hd).1) hSne ⟨r, by rw [← hr]; ring⟩

/-- **The base subfield of the genus field is `Kc`.**  (Proof adapted from the delegated lemma in
`Submission/Work/ClassFieldTower/wBase_eq_quadField.lean`, reproduced here for the same reason.) -/
theorem wBase_eq_quadField' :
    (wBase).map (Work.QuadraticFields.multiQuad wPrimesQ).val
      = Work.QuadraticFields.quadField aWit := by
  unfold wBase Work.QuadraticFields.prodSubfield
  rw [IntermediateField.adjoin_map, Set.image_singleton]
  rw [Work.QuadraticFields.quadField]
  set C : AlgebraicClosure ℚ := (Work.QuadraticFields.multiQuad wPrimesQ).val
    (∏ a ∈ wPrimes, wRoot a) with hCdef
  set Y : AlgebraicClosure ℚ := (2 : AlgebraicClosure ℚ) * Work.QuadraticFields.sqrtVal aWit
    with hYdef
  have hCprod : C = ∏ a ∈ wPrimes, Work.QuadraticFields.sqrtVal (a : ℚ) := by
    rw [hCdef, map_prod]
    refine Finset.prod_congr rfl ?_
    intro a ha
    rw [wRoot_of_mem ha]
    rfl
  have hC2 : C ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) (-120120 : ℚ) := by
    rw [hCprod, ← Finset.prod_pow]
    simp only [Work.QuadraticFields.sqrtVal_sq]
    rw [← map_prod, wPrimes_prod]
  have hS2 : Y ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) (-120120 : ℚ) := by
    rw [hYdef, mul_pow, Work.QuadraticFields.sqrtVal_sq aWit]
    have h2 : ((2 : AlgebraicClosure ℚ)) ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) (4 : ℚ) := by
      norm_num
    rw [h2, ← map_mul]
    congr 1
    norm_num [aWit, dWit]
  have hcases : C = Y ∨ C = -Y := by
    have hzero : (C - Y) * (C + Y) = 0 := by
      have h : C ^ 2 - Y ^ 2 = 0 := by rw [hC2, hS2, sub_self]
      have hfac : (C - Y) * (C + Y) = C ^ 2 - Y ^ 2 := by ring
      rw [hfac, h]
    rcases mul_eq_zero.mp hzero with h | h
    · left; exact sub_eq_zero.mp h
    · right; exact eq_neg_of_add_eq_zero_left h
  rcases hcases with h | h
  · have hCe : C = Work.QuadraticFields.sqrtVal aWit
        * algebraMap ℚ (AlgebraicClosure ℚ) (2 : ℚ) := by
      rw [h, hYdef, mul_comm]
      norm_num
    rw [hCe]
    exact IntermediateField.adjoin_simple_mul_algebraMap _ 2 (by norm_num)
  · have hCe : C = Work.QuadraticFields.sqrtVal aWit
        * algebraMap ℚ (AlgebraicClosure ℚ) (-2 : ℚ) := by
      rw [h, hYdef]
      simp only [map_neg, map_ofNat]
      ring
    rw [hCe]
    exact IntermediateField.adjoin_simple_mul_algebraMap _ (-2) (by norm_num)

/-- **The degree of the genus field over `ℚ` is `64 = 2 ^ 6`.** -/
theorem wM_finrank : Module.finrank ℚ wM = 64 := by
  have hns : ∀ T : Finset wPrimesQ, T.Nonempty → ∀ r : ℚ, r ^ 2 ≠ ∏ i ∈ T, ((i : wPrimesQ) : ℚ) := by
    intro T hT r hr
    have hsub : (T.image (fun i : wPrimesQ => (i : ℚ))) ⊆ wPrimesQ := by
      intro x hx
      obtain ⟨j, -, rfl⟩ := Finset.mem_image.mp hx
      exact j.2
    have hne : (T.image (fun i : wPrimesQ => (i : ℚ))).Nonempty := hT.image _
    have hprod : (∏ i ∈ T, ((i : wPrimesQ) : ℚ)) =
        ∏ a ∈ T.image (fun i : wPrimesQ => (i : ℚ)), a :=
      (Finset.prod_image (f := fun a : ℚ => a) (g := fun i : wPrimesQ => (i : ℚ))
        (s := T) (fun x _ y _ hxy => Subtype.ext hxy)).symm
    exact wPrimesQ_nonsquare' _ hsub hne r (by rw [← hprod]; exact hr)
  have h := Work.QuadraticFields.multiQuad_finrank wPrimesQ hns
  rw [wPrimesQ_card] at h
  norm_num at h
  exact h

/-- **The base subfield is quadratic over `ℚ`.** -/
theorem wBase_finrank : Module.finrank ℚ ↥wBase = 2 := by
  have hprod : (∏ a ∈ wPrimes, wRoot a) ^ 2 = algebraMap ℚ wM (-120120 : ℚ) := by
    rw [← Finset.prod_pow]
    rw [Finset.prod_congr rfl (fun a ha => wRoot_sq a ha)]
    rw [← map_prod]
    congr 1
    exact_mod_cast wPrimes_prod
  have hns : ∀ r : ℚ, r ^ 2 ≠ (-120120 : ℚ) := by
    intro r hr
    have h1 : (0 : ℚ) ≤ r ^ 2 := sq_nonneg r
    rw [hr] at h1
    norm_num at h1
  have h := Work.QuadraticFields.finrank_adjoin_sq_eq_two (M := wM) (-120120 : ℚ)
    (∏ a ∈ wPrimes, wRoot a) hprod hns
  unfold wBase Work.QuadraticFields.prodSubfield
  exact h

/-- **The genus field is unramified over its quadratic subfield `wBase`.**  This is classical
genus theory, in the form proved in the quadratic-fields chapter. -/
theorem wUnramified : Work.QuadraticFields.IsUnramifiedAtFinitePrimes ↥wBase wM := by
  haveI : IsGalois ℚ wM := Work.QuadraticFields.multiQuad_isGalois wPrimesQ
  exact Work.QuadraticFields.isUnramifiedAtFinitePrimes_multiQuad (M := wM) wPrimes wRoot
    wRoot_sq wRoot_generates' (by rw [wPrimes_card]; norm_num) wPrimes_isPrimeDiscriminant
    (fun a ha b hb hne => wPrimes_coprime a b ha hb hne)

/-- **The relative different of the genus field over its quadratic subfield is trivial.** -/
theorem wDifferentIdeal_eq_top : differentIdeal (𝓞 ↥wBase) (𝓞 wM) = ⊤ :=
  differentIdeal_eq_top_of_isUnramifiedAtFinitePrimes wUnramified

/-- **`[wM : wBase] = 32 = 2 ^ 5`.** -/
theorem wBase_deg : Module.finrank ↥wBase wM = 32 := by
  have h := Module.finrank_mul_finrank ℚ ↥wBase wM
  rw [wBase_finrank, wM_finrank] at h
  omega

/-- **`Kc` is the base subfield of the genus field**: the inclusion `Kc ≤ wM` of intermediate
fields of `AlgebraicClosure ℚ`. -/
theorem quadField_le_wM : Work.QuadraticFields.quadField aWit ≤
    Work.QuadraticFields.multiQuad wPrimesQ := by
  rw [Work.QuadraticFields.quadField, IntermediateField.adjoin_le_iff]
  rintro y hy
  rw [Set.mem_singleton_iff] at hy
  subst hy
  have hmem : Work.QuadraticFields.sqrtVal aWit ∈
      (wBase).map (Work.QuadraticFields.multiQuad wPrimesQ).val := by
    rw [wBase_eq_quadField']
    exact Work.QuadraticFields.sqrtVal_mem_quadField aWit
  obtain ⟨x, -, hx⟩ := (IntermediateField.mem_map wBase).mp hmem
  rw [← hx]
  exact x.2

end

/-- **THE GENUS LEVEL OF `Kc = ℚ(√-30030)`.**  The multiquadratic field

  `wM = ℚ(√8, √-3, √5, √-7, √-11, √13)`

generated by the square roots of the six prime discriminants
`8, -3, 5, -7, -11, 13` of `disc Kc = -120120 = 8 · (-3) · 5 · (-7) · (-11) · 13` is a finite
unramified Galois extension of `Kc` of degree `2 ^ 5 = 32` with Galois group of exponent `2`
(genus theory: `wM` is the genus field of the imaginary quadratic field `Kc`, and its Galois group
over `Kc` is `(ℤ/2) ^ 5`).  This supplies the generator half `5 ≤ d(G_∅)` of the
Golod--Shafarevich input for `Kc`, with no class field theory. -/
theorem hasGenusLevel_witness : HasGenusLevel Kc := by
  classical
  haveI hgalM : IsGalois ℚ wM := Work.QuadraticFields.multiQuad_isGalois wPrimesQ
  -- the base `Kc` acts on `wM` through the inclusion of intermediate fields `Kc ≤ wM`
  letI algKc : Algebra Kc wM := (IntermediateField.inclusion quadField_le_wM).toRingHom.toAlgebra
  haveI hST : IsScalarTower ℚ Kc wM :=
    IsScalarTower.of_algebraMap_eq (fun q => by apply Subtype.ext; rfl)
  haveI hfd : FiniteDimensional Kc wM := Module.Finite.right ℚ Kc wM
  haveI hgal : IsGalois Kc wM := IsGalois.tower_top_of_isGalois ℚ Kc wM
  refine ⟨wM, inferInstance, inferInstance, algKc, hfd, hgal, ?_, ?_, ?_⟩
  · -- the extension is unramified: the relative different is trivial
    have h1 : differentIdeal (𝓞 ↥wBase) (𝓞 wM) = ⊤ := wDifferentIdeal_eq_top
    let e : ↥wBase ≃ₐ[ℚ] Kc :=
      (IntermediateField.equivMap wBase (Work.QuadraticFields.multiQuad wPrimesQ).val).trans
        (IntermediateField.equivOfEq wBase_eq_quadField')
    have hcomp : ∀ x : ↥wBase, algebraMap Kc wM (e x) = algebraMap ↥wBase wM x := by
      intro x
      apply Subtype.ext
      rfl
    exact differentIdeal_eq_top_of_base_ringEquiv (e : ↥wBase ≃+* Kc) hcomp h1
  · -- the Galois group has exponent `2`: every automorphism is an involution
    intro σ
    have h := multiQuad_aut_pow_two wPrimesQ (σ.restrictScalars ℚ)
    have hfun : ∀ x : wM, σ (σ x) = x := by
      intro x
      have h2 := congrFun (congrArg (fun f : wM ≃ₐ[ℚ] wM => (f : wM → wM)) h) x
      simpa using h2
    exact AlgEquiv.ext hfun
  · -- the Galois group has order `2 ^ 5 = [wM : Kc]`
    have hcard : Nat.card (wM ≃ₐ[Kc] wM) = Module.finrank Kc wM :=
      IsGalois.card_aut_eq_finrank Kc wM
    have hfr : Module.finrank Kc wM = 32 := by
      have h := Module.finrank_mul_finrank ℚ Kc wM
      rw [wM_finrank, finrank_eq_two] at h
      omega
    rw [hcard, hfr]
    norm_num

end Work.ClassFieldTower
