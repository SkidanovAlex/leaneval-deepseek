import Mathlib
import Submission.Work.ClassFieldTower.Defs
import Submission.Work.ClassFieldTower.classGroupTwoRank_eq_finrank_modN

/-!
# `unitTwoRank F` is the `𝔽₂`-dimension of `O_F^× / (O_F^×)²`

The invariant `unitTwoRank F = NumberField.Units.rank F + 1` of the class-field-tower chapter is
the `𝔽₂`-dimension of the group of units of `𝓞 F` modulo squares:

`unitTwoRank F = finrank_{𝔽₂} (ModN (Additive (𝓞 F)ˣ) 2)`.

## The mathematics

By Dirichlet's unit theorem `(𝓞 F)ˣ` is a finitely generated abelian group whose torsion subgroup
`T = (𝓞 F)ˣ_tors` is finite cyclic of order `w` (the number of roots of unity in `F`, which is even
because `-1` is a root of unity), and `(𝓞 F)ˣ ⧸ T` is free of rank `r = NumberField.Units.rank F`.

Letting `S = G²` be the subgroup generated by the squares of a commutative group `G` and `T` its
torsion subgroup, the quotient `G ⧸ S` sits in the chain `S ≤ S ⊔ T ≤ G`:

* `[S ⊔ T : S] = [T : T ⊓ S] = [T : T²] = gcd(|T|, 2)`, because an element of the torsion
  subgroup whose square is a square of `G` is itself a square of the torsion subgroup
  (`G` is commutative, so the closure of the squares is the range of the squaring map), and the
  squaring map on a finite cyclic group has image of index `gcd(|T|, 2)`;
* `[G : S ⊔ T] = [(G ⧸ T) : (G ⧸ T)²]`, because `(S ⊔ T) ⧸ T` is the subgroup of squares of
  `G ⧸ T`;
* consequently `|G ⧸ G²| = |(G ⧸ T) ⧸ (G ⧸ T)²| · gcd(|T|, 2)`.

For the units of a number field the last factor is `gcd(w, 2) = 2`, and the torsion-free quotient
`(𝓞 F)ˣ ⧸ T` is free of rank `r`, so a free `ℤ`-module of rank `r` has exactly `2 ^ r` square
classes (`ModN.natCard_eq`).  Hence `|(𝓞 F)ˣ ⧸ (𝓞 F)ˣ²| = 2 ^ (r + 1)`, and since `(𝓞 F)ˣ ⧸ (𝓞 F)ˣ²`
is an `𝔽₂`-vector space, its `𝔽₂`-dimension is `r + 1 = unitTwoRank F`.

## Contents

* `sqSubgroup_eq_range`, `index_sqSubgroup_eq_gcd`: the subgroup of squares as the range of the
  squaring map, and the index of the squares in a finite cyclic group;
* `subgroupOf_torsion_sqSubgroup`, `map_sqSubgroup_mk'`, `index_sup_eq_index_map`,
  `relIndex_sup_torsion_eq_gcd`: the square subgroups of a subgroup and of a quotient;
* `natCard_modN_additive_torsion_eq`, `natCard_modN_additive_torsion_eq_two_mul`: the exact
  sequence `1 → T/T² → G/G² → (G/T)/(G/T)² → 1`;
* `unitTwoRank_eq_finrank_units_modSquares`: the statement of the module.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open NumberField

noncomputable section

namespace Work.ClassFieldTower

/-! ## 1. The subgroup generated by the squares -/

/-- The subgroup generated by the squares is the range of the squaring endomorphism. -/
lemma sqSubgroup_eq_range (G : Type*) [CommGroup G] :
    Subgroup.closure (Set.range (fun x : G => x ^ 2)) = (powMonoidHom 2 : G →* G).range := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro y ⟨x, rfl⟩
    exact MonoidHom.mem_range.mpr ⟨x, by rw [powMonoidHom_apply]⟩
  · rintro y ⟨x, rfl⟩
    exact Subgroup.subset_closure ⟨x, by rw [powMonoidHom_apply]⟩

/-- **The index of the squares in a finite cyclic group** is the gcd of its order with `2`:
the squaring endomorphism of a cyclic group of order `n` has image of index `gcd(n, 2)`. -/
lemma index_sqSubgroup_eq_gcd (T : Type*) [CommGroup T] [Finite T] [IsCyclic T] :
    (Subgroup.closure (Set.range (fun x : T => x ^ 2))).index = (Nat.card T).gcd 2 := by
  rw [sqSubgroup_eq_range T, IsCyclic.index_powMonoidHom_range T 2]

/-! ## 2. Squares, the torsion subgroup, and quotients -/

/-- The squares inside the torsion subgroup are the squares *of* the torsion subgroup: a torsion
element of `G` is a square in `G` if and only if it is a square of a torsion element.  This is
where commutativity of `G` is used (so that the subgroup generated by the squares is the range of
the squaring map). -/
lemma subgroupOf_torsion_sqSubgroup (G : Type*) [CommGroup G] :
    (Subgroup.closure (Set.range (fun x : G => x ^ 2))).subgroupOf (CommGroup.torsion G)
      = Subgroup.closure (Set.range (fun x : CommGroup.torsion G => x ^ 2)) := by
  ext x
  rw [Subgroup.mem_subgroupOf, sqSubgroup_eq_range, sqSubgroup_eq_range]
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hx
    rw [powMonoidHom_apply] at hy
    have htors : y ∈ CommGroup.torsion G := by
      rw [CommGroup.mem_torsion]
      have hx' : IsOfFinOrder (((x : CommGroup.torsion G)) : G) :=
        (CommGroup.mem_torsion _).mp x.2
      rw [← hy] at hx'
      exact hx'.of_pow (by norm_num)
    exact MonoidHom.mem_range.mpr ⟨⟨y, htors⟩, by
      rw [powMonoidHom_apply]
      exact Subtype.ext (by simp [hy])⟩
  · intro hx
    obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hx
    rw [powMonoidHom_apply] at hy
    exact MonoidHom.mem_range.mpr ⟨(y : G), by
      rw [powMonoidHom_apply]
      exact congrArg Subtype.val hy⟩

/-- The squares of `G` map onto the squares of a quotient `G ⧸ T`. -/
lemma map_sqSubgroup_mk' (G : Type*) [CommGroup G] (T : Subgroup G) :
    (Subgroup.closure (Set.range (fun x : G => x ^ 2))).map (QuotientGroup.mk' T)
      = Subgroup.closure (Set.range (fun y : G ⧸ T => y ^ 2)) := by
  rw [MonoidHom.map_closure]
  congr 1
  rw [← Set.range_comp]
  rw [show ⇑(QuotientGroup.mk' T) ∘ (fun x : G => x ^ 2)
      = (fun y : G ⧸ T => y ^ 2) ∘ ⇑(QuotientGroup.mk' T) from rfl]
  exact (QuotientGroup.mk'_surjective T).range_comp _

/-- The index of the squares in `S ⊔ T` is the index of the image of `S` in `G ⧸ T`. -/
lemma index_sup_eq_index_map (G : Type*) [CommGroup G] (T : Subgroup G) :
    (Subgroup.closure (Set.range (fun x : G => x ^ 2)) ⊔ T).index
      = ((Subgroup.closure (Set.range (fun x : G => x ^ 2))).map (QuotientGroup.mk' T)).index := by
  have h : Subgroup.comap (QuotientGroup.mk' T)
      (Subgroup.map (QuotientGroup.mk' T) (Subgroup.closure (Set.range (fun x : G => x ^ 2))))
      = Subgroup.closure (Set.range (fun x : G => x ^ 2)) ⊔ T := by
    rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk']
  rw [← h]
  exact Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective T)

/-- **The relative index of the squares in `S ⊔ T`**, where `T` is the torsion subgroup: it is
`gcd(|T|, 2)`, i.e. the index of `T²` in `T`. -/
lemma relIndex_sup_torsion_eq_gcd (G : Type*) [CommGroup G] [Finite (CommGroup.torsion G)]
    [IsCyclic (CommGroup.torsion G)] :
    (Subgroup.closure (Set.range (fun x : G => x ^ 2))).relIndex
      (Subgroup.closure (Set.range (fun x : G => x ^ 2)) ⊔ CommGroup.torsion G)
      = (Nat.card (CommGroup.torsion G)).gcd 2 := by
  set S : Subgroup G := Subgroup.closure (Set.range (fun x : G => x ^ 2)) with hS
  set T : Subgroup G := CommGroup.torsion G with hT
  haveI : S.Normal := Subgroup.normal_of_isMulCommutative S
  rw [Subgroup.relIndex_sup_left T S]
  show (S.subgroupOf T).index = (Nat.card T).gcd 2
  rw [show S.subgroupOf T = Subgroup.closure (Set.range (fun x : ↥T => x ^ 2)) from by
    rw [hS, hT]
    exact subgroupOf_torsion_sqSubgroup G]
  rw [index_sqSubgroup_eq_gcd ↥T]

/-! ## 3. The exact sequence `1 → T/T² → G/G² → (G/T)/(G/T)² → 1` -/

/-- **The number of square classes of `G`** for a commutative group `G` with finite cyclic torsion
subgroup `T`: it is `gcd(|T|, 2)` times the number of square classes of the torsion-free quotient
`G ⧸ T`.  Equivalently, the `𝔽₂`-vector space `G/G²` is an extension of `(G/T)/(G/T)²` by
`T/T² ≅ ℤ/gcd(|T|,2)`. -/
theorem natCard_modN_additive_torsion_eq (G : Type*) [CommGroup G] [Finite (CommGroup.torsion G)]
    [IsCyclic (CommGroup.torsion G)] :
    Nat.card (ModN (Additive G) 2)
      = Nat.card (ModN (Additive (G ⧸ CommGroup.torsion G)) 2)
        * (Nat.card (CommGroup.torsion G)).gcd 2 := by
  set S : Subgroup G := Subgroup.closure (Set.range (fun x : G => x ^ 2)) with hS
  set T : Subgroup G := CommGroup.torsion G with hT
  have hcardS : S.index = Nat.card (ModN (Additive G) 2) := by
    rw [Subgroup.index, hS, natCard_modN_two_eq_natCard_sqQuotient]
  have hQT : (S ⊔ T).index = Nat.card (ModN (Additive (G ⧸ T)) 2) := by
    rw [index_sup_eq_index_map G T, map_sqSubgroup_mk' G T, Subgroup.index_eq_card,
      ← natCard_modN_two_eq_natCard_sqQuotient (G ⧸ T)]
  have hrel : S.relIndex (S ⊔ T) = (Nat.card T).gcd 2 := by
    rw [hS, hT]
    exact relIndex_sup_torsion_eq_gcd G
  calc Nat.card (ModN (Additive G) 2)
      = S.index := hcardS.symm
    _ = S.relIndex (S ⊔ T) * (S ⊔ T).index :=
        (Subgroup.relIndex_mul_index (le_sup_left : S ≤ S ⊔ T)).symm
    _ = (Nat.card T).gcd 2 * Nat.card (ModN (Additive (G ⧸ T)) 2) := by rw [hrel, hQT]
    _ = Nat.card (ModN (Additive (G ⧸ T)) 2) * (Nat.card T).gcd 2 := by rw [mul_comm]
    _ = Nat.card (ModN (Additive (G ⧸ CommGroup.torsion G)) 2)
          * (Nat.card (CommGroup.torsion G)).gcd 2 := by rw [hT]

/-- The previous computation when the torsion subgroup has even order: the torsion contributes
exactly one `𝔽₂`-dimension. -/
theorem natCard_modN_additive_torsion_eq_two_mul (G : Type*) [CommGroup G]
    [Finite (CommGroup.torsion G)] [IsCyclic (CommGroup.torsion G)]
    (heven : Even (Nat.card (CommGroup.torsion G))) :
    Nat.card (ModN (Additive G) 2)
      = 2 * Nat.card (ModN (Additive (G ⧸ CommGroup.torsion G)) 2) := by
  rw [natCard_modN_additive_torsion_eq G, Nat.gcd_eq_right (Even.two_dvd heven), mul_comm]

/-! ## 4. The invariant of the chapter -/

/-- **`unitTwoRank F` is the `𝔽₂`-dimension of `(𝓞 F)ˣ / (𝓞 F)ˣ²`.**

`unitTwoRank F = r₁ + r₂ = NumberField.Units.rank F + 1`: the `𝔽₂`-dimension of the group of units
modulo squares, which is `r₁ + r₂` by Dirichlet's unit theorem
(`O_F^× ≅ μ_F × ℤ^{r₁+r₂-1}`, and `μ_F/μ_F² ≅ ℤ/2` in characteristic zero). -/
theorem unitTwoRank_eq_finrank_units_modSquares (F : Type*) [Field F] [NumberField F] :
    Work.ClassFieldTower.unitTwoRank F =
      Module.finrank (ZMod 2) (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2) := by
  haveI : Finite (CommGroup.torsion (NumberField.RingOfIntegers F)ˣ) :=
    (inferInstance : Finite (NumberField.Units.torsion F))
  haveI : IsCyclic (CommGroup.torsion (NumberField.RingOfIntegers F)ˣ) :=
    (inferInstance : IsCyclic (NumberField.Units.torsion F))
  -- `-1` is a root of unity, so the torsion subgroup has even order
  have hEven : Even (Nat.card (CommGroup.torsion (NumberField.RingOfIntegers F)ˣ)) := by
    simpa only [NumberField.Units.torsionOrder, NumberField.Units.torsion] using
      NumberField.Units.even_torsionOrder F
  -- the cardinality of the group of square classes is `2 ^ (rank + 1)`
  have hcard : Nat.card (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2)
      = 2 ^ (NumberField.Units.rank F + 1) := by
    rw [natCard_modN_additive_torsion_eq_two_mul (NumberField.RingOfIntegers F)ˣ hEven]
    -- the torsion-free quotient is free of rank `NumberField.Units.rank F`
    rw [show Nat.card (ModN (Additive ((NumberField.RingOfIntegers F)ˣ
          ⧸ CommGroup.torsion (NumberField.RingOfIntegers F)ˣ)) 2)
        = 2 ^ NumberField.Units.rank F from by
      rw [show (ModN (Additive ((NumberField.RingOfIntegers F)ˣ
            ⧸ CommGroup.torsion (NumberField.RingOfIntegers F)ˣ)) 2)
          = (ModN (Additive ((NumberField.RingOfIntegers F)ˣ
            ⧸ NumberField.Units.torsion F)) 2) from rfl]
      rw [ModN.natCard_eq, NumberField.Units.finrank_modTorsion]]
    rw [pow_succ, mul_comm]
  -- a finite `𝔽₂`-vector space has cardinality `2 ^ finrank`
  have hne : Nat.card (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2) ≠ 0 := by
    rw [hcard]; positivity
  haveI : Finite (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2) :=
    (Nat.card_ne_zero.mp hne).2
  haveI : Module.Finite (ZMod 2) (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2) :=
    Module.Finite.of_finite
  have hpow : 2 ^ Module.finrank (ZMod 2) (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2)
      = Nat.card (ModN (Additive (NumberField.RingOfIntegers F)ˣ) 2) := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
  rw [unitTwoRank]
  exact (Nat.pow_right_injective (by norm_num) (hpow.trans hcard)).symm

end Work.ClassFieldTower
