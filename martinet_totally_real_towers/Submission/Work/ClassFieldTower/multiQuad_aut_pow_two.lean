import Mathlib
import Submission.Work.QuadraticFields.QuadField

/-!
# Automorphisms of a multiquadratic field have order dividing two

Let `s` be a finite set of rational numbers and let

  `multiQuad s = ℚ(√a : a ∈ s) ⊆ AlgebraicClosure ℚ`

be the multiquadratic field generated by chosen square roots `√a = sqrtVal a` of the entries
(see `Work.QuadraticFields.QuadField`).  Every `ℚ`-algebra automorphism `σ` of `multiQuad s`
satisfies `σ ^ 2 = 1`: the extension is a compositum of quadratic (or trivial) extensions, so
its automorphism group has exponent `2`.

The argument is the one used for the auxiliary multiquadratic field `mqField` of
`Commons.NumberTheory.NumberField.exists_multiquadratic_totallyReal_unramifiedOutside`, with
`sqrtOf` replaced by `sqrtVal`.  Since `√a` generates `multiQuad s` over `ℚ`, it suffices to
show that `σ ^ 2` fixes each generator `√a` (`a ∈ s`) — indeed `σ (√a)` is again a square root
of `a`, hence equal to `±√a`, and in either case `σ` maps it back to `√a`.  Fixing a generating
set forces `σ ^ 2 = 1` (`IntermediateField.adjoin_induction`, then `AlgEquiv.ext`).

## Main results

* `Work.ClassFieldTower.multiQuad_gen_apply` -- an automorphism sends each generator `√a` to
  `±√a`.
* `Work.ClassFieldTower.multiQuad_aut_pow_two` -- every `ℚ`-automorphism of `multiQuad s` is
  an involution.
-/

namespace Work.ClassFieldTower

open Work.QuadraticFields

set_option autoImplicit false

noncomputable section

/-- **An automorphism of `ℚ(√a : a ∈ s)` sends a generator `√a` (`a ∈ s`) to `±√a`.**

The image of `√a` under `σ` is again a square root of `a`: it is `ℚ`-fixed in the sense that
`σ (√a) ^ 2 = σ (a) = a`.  In a field a square root of `a` is unique up to sign, which is
`Work.QuadraticFields.eq_or_eq_neg_sqrtVal`. -/
theorem multiQuad_gen_apply (s : Finset ℚ)
    (σ : ↥(Work.QuadraticFields.multiQuad s) ≃ₐ[ℚ] ↥(Work.QuadraticFields.multiQuad s))
    {a : ℚ} (ha : a ∈ s) :
    σ (⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ : ↥(multiQuad s))
        = ⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ ∨
    σ (⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ : ↥(multiQuad s))
        = -⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ := by
  set g : ↥(multiQuad s) := ⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ with hg
  -- `√a` is a square root of `a` inside `multiQuad s`
  have hg_sq : g ^ 2 = algebraMap ℚ ↥(multiQuad s) a := by
    apply Subtype.ext
    change sqrtVal a ^ 2 = algebraMap ℚ (AlgebraicClosure ℚ) a
    rw [sqrtVal_sq]
  -- hence so is its image under `σ`, since `σ` fixes `ℚ`
  have hsq : (((σ g : ↥(multiQuad s)) : AlgebraicClosure ℚ)) ^ 2
      = algebraMap ℚ (AlgebraicClosure ℚ) a := by
    calc ((σ g : ↥(multiQuad s)) : AlgebraicClosure ℚ) ^ 2
        = (multiQuad s).val ((σ g) ^ 2) := (map_pow (multiQuad s).val (σ g) 2).symm
      _ = (multiQuad s).val (σ (g ^ 2)) := by rw [← map_pow σ g 2]
      _ = (multiQuad s).val (σ (algebraMap ℚ ↥(multiQuad s) a)) := by rw [hg_sq]
      _ = (multiQuad s).val (algebraMap ℚ ↥(multiQuad s) a) := by rw [AlgEquiv.commutes]
      _ = algebraMap ℚ (AlgebraicClosure ℚ) a := rfl
  rcases eq_or_eq_neg_sqrtVal hsq with h | h
  · left; apply Subtype.ext; exact h
  · right; apply Subtype.ext; exact h

/-- **Every `ℚ`-automorphism of `ℚ(√a : a ∈ s)` is an involution.**

Since `ℚ(√a : a ∈ s)` is generated over `ℚ` by the square roots `√a` (`a ∈ s`) and each of those
is sent to `±` itself, the square `σ ^ 2` fixes every generator, hence is the identity. -/
theorem multiQuad_aut_pow_two (s : Finset ℚ)
    (σ : ↥(Work.QuadraticFields.multiQuad s) ≃ₐ[ℚ] ↥(Work.QuadraticFields.multiQuad s)) :
    σ ^ 2 = 1 := by
  -- `σ ^ 2` fixes every element of `multiQuad s`
  have key : ∀ x : ↥(multiQuad s), σ (σ x) = x := by
    intro x
    have h := IntermediateField.adjoin_induction (F := ℚ) (s := sqrtVal '' (s : Set ℚ))
      (p := fun y (_ : y ∈ IntermediateField.adjoin ℚ (sqrtVal '' (s : Set ℚ))) =>
        ∀ hy : y ∈ multiQuad s, σ (σ (⟨y, hy⟩ : ↥(multiQuad s))) = ⟨y, hy⟩)
      (by
        -- a generator `√a` is sent to `±` itself, hence fixed by `σ ^ 2`
        intro y hy hyM
        obtain ⟨a, ha, rfl⟩ := hy
        have hg : (⟨sqrtVal a, hyM⟩ : ↥(multiQuad s))
            = ⟨sqrtVal a, sqrtVal_mem_multiQuad ha⟩ := Subtype.ext rfl
        rw [hg]
        rcases multiQuad_gen_apply s σ ha with hk | hk
        · rw [hk, hk]
        · rw [hk, map_neg, hk, neg_neg])
      (by
        -- rationals are fixed by `σ`
        intro r hyM
        have h1 : (⟨algebraMap ℚ (AlgebraicClosure ℚ) r, hyM⟩ : ↥(multiQuad s))
            = algebraMap ℚ ↥(multiQuad s) r := Subtype.ext rfl
        rw [h1, AlgEquiv.commutes, AlgEquiv.commutes])
      (by
        intro y z hy hz ihy ihz hyz
        have h1 : (⟨y + z, hyz⟩ : ↥(multiQuad s)) = ⟨y, hy⟩ + ⟨z, hz⟩ := Subtype.ext rfl
        rw [h1]
        simp only [map_add, ihy hy, ihz hz])
      (by
        intro y hy ihy hyi
        have h1 : (⟨y⁻¹, hyi⟩ : ↥(multiQuad s)) = (⟨y, hy⟩ : ↥(multiQuad s))⁻¹ := Subtype.ext rfl
        rw [h1]
        simp only [map_inv₀, ihy hy])
      (by
        intro y z hy hz ihy ihz hyz
        have h1 : (⟨y * z, hyz⟩ : ↥(multiQuad s)) = ⟨y, hy⟩ * ⟨z, hz⟩ := Subtype.ext rfl
        rw [h1]
        simp only [map_mul, ihy hy, ihz hz])
      x.2
    exact h x.2
  rw [pow_two]
  apply AlgEquiv.ext
  intro x
  rw [AlgEquiv.mul_apply, AlgEquiv.one_apply]
  exact key x

end

end Work.ClassFieldTower
