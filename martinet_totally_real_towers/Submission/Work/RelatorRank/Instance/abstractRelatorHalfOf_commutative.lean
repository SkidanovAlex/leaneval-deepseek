import Mathlib
import Submission.Work.RelatorRank.API

/-!
# `Work.RelatorRank.Instance.abstractRelatorHalfOf_commutative`

**Namespace** `Work.RelatorRank.Instance`; module
`Submission.Work.RelatorRank.Instance.abstractRelatorHalfOf_commutative`.

Every **commutative** group `G` generated by `d` elements admits a presentation on those `d`
generators with at most `d + d(d-1)/2` relators:

`AbstractRelatorHalfOf G d (d + d * (d - 1) / 2)`.

This is the commutative companion of
`Work.RelatorRank.Instance.abstractRelatorHalfOf_elementaryAbelian` (the case `G = (ℤ/2)^d`): it
shows that the `∀ gen`-form of the relator bound holds for *every* commutative group, not only for
the elementary abelian `2`-groups, by the classical *abelian presentation* of a finitely generated
abelian group.

## The mathematics

Let `F = FreeGroup (Fin d)` be free on `x_1, …, x_d`, `gen : Fin d → G` a generating family and
`L = FreeGroup.lift gen : F →* G`.  Because `G` is commutative, `L` factors as

`F --ab--> FreeAbelianGroup (Fin d) = ℤ^d --φ--> G`,

where `ab` is the abelianization map (`Abelianization.of`; note `FreeAbelianGroup (Fin d)` *is*
`Additive (Abelianization (FreeGroup (Fin d)))` definitionally).  The kernel of `ab` is the
commutator subgroup of `F`, which — since `F` is free on the `x_i` — is generated as a **normal**
subgroup by the `d(d-1)/2` basic commutators `⁅x_i, x_j⁆` (`i < j`).  The kernel of `φ` is a
subgroup of `ℤ^d`, hence free abelian of rank `n ≤ d` (Smith normal form / `Submodule.smithNormalForm`
over the PID `ℤ`); picking a preimage `w_1, …, w_n ∈ F` of a basis of `ker φ` we get
`ker L = normalClosure ({⁅x_i,x_j⁆} ∪ {w_1, …, w_n})`, a set of at most `d(d-1)/2 + n ≤
d(d-1)/2 + d` relators.

The last step is the general group-theoretic lemma `normalClosure_union_eq_comap`: for a surjection
`f : F →* M`, if `normalClosure S = ker f` and `N` is generated by `f '' T`, then
`normalClosure (S ∪ T) = f ⁻¹' N`.

## Main result

* `abstractRelatorHalfOf_commutative`
-/

open scoped commutatorElement

namespace Work.RelatorRank.Instance

open Work.RelatorRank

/-! ## The standard relators of an abelian presentation: the basic commutators -/

/-- **The `d(d-1)/2` basic commutators** `⁅x_i, x_j⁆` (`i < j`) of the free group on `Fin d`
generators.  They generate the commutator subgroup of the free group as a normal subgroup. -/
noncomputable def basicRelators (d : ℕ) : Finset (FreeGroup (Fin d)) := by
  classical
  exact ((Finset.univ : Finset (Fin d × Fin d)).filter (fun p => p.1 < p.2)).image
    (fun p => ⁅FreeGroup.of p.1, FreeGroup.of p.2⁆)

/-- There are at most `d(d-1)/2` basic commutators. -/
theorem basicRelators_card_le (d : ℕ) : (basicRelators d).card ≤ d * (d - 1) / 2 := by
  classical
  calc (basicRelators d).card
      ≤ (((Finset.univ : Finset (Fin d × Fin d)).filter (fun p => p.1 < p.2))).card :=
        Finset.card_image_le
    _ = d * (d - 1) / 2 := by
        rw [Fintype.card_product_filter_lt, Nat.choose_two_right]
        simp

/-- **The commutator subgroup of the free group is generated by the basic commutators.**  The
normal closure of the `⁅x_i, x_j⁆` (`i < j`) is the whole commutator subgroup of `FreeGroup (Fin d)`.
This is proved by a double induction on the two arguments (`FreeGroup.induction_on`, which reduces
inverses to the generators) and the standard commutator identities
`⁅a*b, c⁆ = a⁅b,c⁆a⁻¹ · ⁅a,c⁆`, `⁅a, b*c⁆ = ⁅a,b⁆ · b⁅a,c⁆b⁻¹`, `⁅a⁻¹,b⁆ = a⁻¹⁅b,a⁆a`,
`⁅a,b⁻¹⁆ = b⁻¹⁅b,a⁆b`, normality doing the conjugations. -/
theorem normalClosure_basicRelators (d : ℕ) :
    Subgroup.normalClosure ((basicRelators d : Finset (FreeGroup (Fin d))) : Set (FreeGroup (Fin d)))
      = commutator (FreeGroup (Fin d)) := by
  classical
  set H : Subgroup (FreeGroup (Fin d)) :=
    Subgroup.normalClosure ((basicRelators d : Finset (FreeGroup (Fin d))) : Set (FreeGroup (Fin d)))
  have hN : H.Normal := Subgroup.normalClosure_normal
  have hconj : ∀ (n g : FreeGroup (Fin d)), n ∈ H → g * n * g⁻¹ ∈ H :=
    fun n g hn => hN.conj_mem n hn g
  have hmem : ∀ i j : Fin d, ⁅FreeGroup.of i, FreeGroup.of j⁆ ∈ H := by
    intro i j
    rcases lt_trichotomy i j with h | h | h
    · apply Subgroup.subset_normalClosure
      rw [Finset.mem_coe, basicRelators]
      exact Finset.mem_image.mpr ⟨(i, j), Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩, rfl⟩
    · subst h; rw [commutatorElement_self]; exact H.one_mem
    · have : ⁅FreeGroup.of i, FreeGroup.of j⁆ = (⁅FreeGroup.of j, FreeGroup.of i⁆)⁻¹ := by
        rw [← commutatorElement_inv]
      rw [this]
      exact H.inv_mem (Subgroup.subset_normalClosure (by
        rw [Finset.mem_coe, basicRelators]
        exact Finset.mem_image.mpr ⟨(j, i), Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩, rfl⟩))
  have key : ∀ a b : FreeGroup (Fin d), ⁅a, b⁆ ∈ H := by
    intro a
    induction a using FreeGroup.induction_on with
    | one => intro b; rw [commutatorElement_one_left]; exact H.one_mem
    | of i =>
        intro b
        induction b using FreeGroup.induction_on with
        | one => rw [commutatorElement_one_right]; exact H.one_mem
        | of j => exact hmem i j
        | inv_of j ih =>
            rw [commutatorElement_inv_right]
            have h1 : ⁅FreeGroup.of j, FreeGroup.of i⁆ ∈ H := by
              rw [← commutatorElement_inv]; exact H.inv_mem ih
            simpa using hconj _ (FreeGroup.of j)⁻¹ h1
        | mul y z ihy ihz =>
            rw [commutatorElement_mul_right_eq_mul_conj]
            have h2 : y * ⁅FreeGroup.of i, z⁆ * y⁻¹ ∈ H := hconj _ y ihz
            have h3 : ⁅FreeGroup.of i, y⁆ * y * ⁅FreeGroup.of i, z⁆ * y⁻¹
                = ⁅FreeGroup.of i, y⁆ * (y * ⁅FreeGroup.of i, z⁆ * y⁻¹) := by group
            rw [h3]
            exact H.mul_mem ihy h2
    | inv_of i ih =>
        intro b
        rw [commutatorElement_inv_left]
        have h1 : ⁅b, FreeGroup.of i⁆ ∈ H := by
          rw [← commutatorElement_inv]; exact H.inv_mem (ih b)
        simpa using hconj _ (FreeGroup.of i)⁻¹ h1
    | mul y z ihy ihz =>
        intro b
        rw [commutatorElement_mul_left_eq_conj_mul]
        have h2 : y * ⁅z, b⁆ * y⁻¹ ∈ H := hconj _ y (ihz b)
        exact H.mul_mem h2 (ihy b)
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    intro x hx
    rw [Finset.mem_coe, basicRelators] at hx
    obtain ⟨p, -, rfl⟩ := Finset.mem_image.mp hx
    exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _) (Subgroup.mem_top _)
  · show ⁅(⊤ : Subgroup (FreeGroup (Fin d))), ⊤⁆ ≤ H
    rw [Subgroup.commutator_le]
    intro a _ b _
    exact key a b

/-! ## Normal closures inside a group extension -/

/-- **A normal closure computed from the two ends of a group extension.**  Let `f : F →* M` be a
group homomorphism, let `N ≤ M` be a normal subgroup, and suppose that `normalClosure S` is the
kernel of `f` while `N` is generated by `f '' T` and is contained in the image of ... — precisely:
`normalClosure S = ker f` and `N = closure (f '' T)`.  Then `normalClosure (S ∪ T) = f ⁻¹' N`.

The two inclusions are: `S ⊆ f ⁻¹' N` (since `S ⊆ ker f`), `T ⊆ f ⁻¹' N` (by `N = closure (f '' T)`),
giving `≤`; and `N ≤ map f (normalClosure (S ∪ T))` (as `f '' T ⊆ map f _`), whence
`f ⁻¹' N ≤ (map f L).comap f = L ⊔ ker f = L` with `L = normalClosure (S ∪ T)` and `ker f ≤ L`. -/
theorem normalClosure_union_eq_comap {F M : Type*} [Group F] [Group M] (f : F →* M)
    {N : Subgroup M} [N.Normal] {S T : Set F}
    (hS : Subgroup.normalClosure S = f.ker) (hT : N = Subgroup.closure (f '' T)) :
    Subgroup.normalClosure (S ∪ T) = N.comap f := by
  apply le_antisymm
  · apply Subgroup.normalClosure_le_normal
    rintro x (hx | hx)
    · have hx' : f x = 1 := by
        have h1 : x ∈ Subgroup.normalClosure S := Subgroup.subset_normalClosure hx
        rw [hS] at h1
        simpa using h1
      simp [hx']
    · rw [hT]
      exact Subgroup.subset_closure ⟨x, hx, rfl⟩
  · intro x hx
    have hx1 : f x ∈ N := hx
    have hL : N ≤ Subgroup.map f (Subgroup.normalClosure (S ∪ T)) := by
      rw [hT, Subgroup.closure_le]
      rintro y ⟨t, ht, rfl⟩
      exact Subgroup.mem_map_of_mem f (Subgroup.subset_normalClosure (Or.inr ht))
    have hx2 : x ∈ (Subgroup.map f (Subgroup.normalClosure (S ∪ T))).comap f := hL hx1
    rw [Subgroup.comap_map_eq] at hx2
    have hSle : f.ker ≤ Subgroup.normalClosure (S ∪ T) := by
      rw [← hS]
      exact Subgroup.normalClosure_mono (Set.subset_union_left)
    exact (sup_le le_rfl hSle) hx2

/-! ## The instance -/

/-- **Every commutative group generated by `d` elements is presented by `d + d(d-1)/2` relators.**
The relators are the `d(d-1)/2` basic commutators of the free generators together with `n ≤ d`
lifts of a basis of the kernel of the induced map `ℤ^d → G` (Smith normal form for the PID `ℤ`). -/
theorem abstractRelatorHalfOf_commutative {G : Type*} [CommGroup G] (d : ℕ) :
    AbstractRelatorHalfOf G d (d + d * (d - 1) / 2) := by
  classical
  intro gen hgen
  -- The abelianization of the free group and the induced maps `ℤ^d → G`, `F → G`.
  let ab : FreeGroup (Fin d) →* Multiplicative (FreeAbelianGroup (Fin d)) := Abelianization.of
  let ψ : FreeAbelianGroup (Fin d) →+ Additive G :=
    FreeAbelianGroup.lift (fun i => Additive.ofMul (gen i))
  let φ : Multiplicative (FreeAbelianGroup (Fin d)) →* G := AddMonoidHom.toMultiplicative ψ
  have hab : Function.Surjective ab :=
    show Function.Surjective
        (Abelianization.of : FreeGroup (Fin d) →* Multiplicative (FreeAbelianGroup (Fin d)))
      from QuotientGroup.mk_surjective
  -- The lift of `gen` factors through the abelianization.
  have hcomp : FreeGroup.lift gen = φ.comp ab := by
    show FreeGroup.lift gen =
      (AddMonoidHom.toMultiplicative (FreeAbelianGroup.lift (fun i => Additive.ofMul (gen i)))).comp
        (Abelianization.of : FreeGroup (Fin d) →* Multiplicative (FreeAbelianGroup (Fin d)))
    rw [← FreeGroup.lift.apply_symm_apply
      ((AddMonoidHom.toMultiplicative (FreeAbelianGroup.lift (fun i => Additive.ofMul (gen i)))).comp
        (Abelianization.of : FreeGroup (Fin d) →* Multiplicative (FreeAbelianGroup (Fin d))))]
    congr 1
    funext i
    rw [FreeGroup.lift_symm_apply]
    show gen i = (AddMonoidHom.toMultiplicative
        (FreeAbelianGroup.lift (fun i => Additive.ofMul (gen i)))) (Abelianization.of (FreeGroup.of i))
    rw [show (Abelianization.of (FreeGroup.of i))
          = Multiplicative.ofAdd (FreeAbelianGroup.of i) from rfl]
    rw [AddMonoidHom.toMultiplicative_apply_apply]
    rw [toAdd_ofAdd]
    rw [FreeAbelianGroup.lift_apply_of]
    rfl
  have hker : (FreeGroup.lift gen).ker = (MonoidHom.ker φ).comap ab := by
    rw [hcomp]; rfl
  -- The kernel of `ψ : ℤ^d → G` is a ℤ-submodule of `ℤ^d`; a basis of it has `n ≤ d` elements.
  let N : Submodule ℤ (FreeAbelianGroup (Fin d)) :=
    AddSubgroup.toIntSubmodule (AddMonoidHom.ker ψ)
  obtain ⟨n, snf⟩ := Submodule.smithNormalForm (FreeAbelianGroup.basis (Fin d)) N
  have hn : n ≤ d := by
    have := Fintype.card_le_of_injective snf.f snf.f.injective
    simpa using this
  -- A preimage in the free group of each basis vector of `ker ψ`.
  let w : Fin n → FreeGroup (Fin d) := fun j =>
    Classical.choose (hab (Multiplicative.ofAdd (((snf.bN j : N) : FreeAbelianGroup (Fin d)))))
  have hw : ∀ j, ab (w j) = Multiplicative.ofAdd (((snf.bN j : N) : FreeAbelianGroup (Fin d))) :=
    fun j => Classical.choose_spec
      (hab (Multiplicative.ofAdd (((snf.bN j : N) : FreeAbelianGroup (Fin d)))))
  let V : Set (FreeAbelianGroup (Fin d)) :=
    Set.range (fun j : Fin n => ((snf.bN j : N) : FreeAbelianGroup (Fin d)))
  let W : Set (Multiplicative (FreeAbelianGroup (Fin d))) :=
    Set.range (fun j : Fin n => Multiplicative.ofAdd (((snf.bN j : N) : FreeAbelianGroup (Fin d))))
  -- The basis of `ker ψ` spans it.
  have hVspan : Submodule.span ℤ V = N := by
    have h1 : V = ⇑(N.subtype) '' Set.range snf.bN := by
      ext x
      constructor
      · rintro ⟨j, rfl⟩
        exact ⟨snf.bN j, ⟨j, rfl⟩, rfl⟩
      · rintro ⟨u, ⟨j, rfl⟩, rfl⟩
        exact ⟨j, rfl⟩
    calc Submodule.span ℤ V
        = Submodule.span ℤ (⇑(N.subtype) '' Set.range snf.bN) := by rw [h1]
      _ = Submodule.map N.subtype (Submodule.span ℤ (Set.range snf.bN)) :=
          (Submodule.map_span N.subtype (Set.range snf.bN)).symm
      _ = Submodule.map N.subtype ⊤ := by rw [Module.Basis.span_eq snf.bN]
      _ = N := Submodule.map_subtype_top N
  have hWmem : ∀ j : Fin n,
      Multiplicative.ofAdd (((snf.bN j : N) : FreeAbelianGroup (Fin d))) ∈ MonoidHom.ker φ := by
    intro j
    show ψ (((snf.bN j : N) : FreeAbelianGroup (Fin d))) = 0
    exact (snf.bN j).2
  -- `ker φ` is generated by the images of the chosen preimages.
  have hT : MonoidHom.ker φ = Subgroup.closure (ab '' Set.range w) := by
    rw [show ab '' Set.range w = W from by
      ext y
      constructor
      · rintro ⟨x, ⟨j, rfl⟩, rfl⟩
        exact ⟨j, (hw j).symm⟩
      · rintro ⟨j, rfl⟩
        exact ⟨w j, ⟨j, rfl⟩, hw j⟩]
    apply le_antisymm
    · intro y hy
      have hy' : Multiplicative.toAdd y ∈ AddMonoidHom.ker ψ := hy
      have hyN : Multiplicative.toAdd y ∈ N := hy'
      rw [← hVspan] at hyN
      have hmem : Multiplicative.ofAdd (Multiplicative.toAdd y) ∈ Subgroup.closure W :=
        Submodule.span_induction (p := fun a _ => Multiplicative.ofAdd a ∈ Subgroup.closure W)
          (fun x hx => by obtain ⟨j, rfl⟩ := hx; exact Subgroup.subset_closure ⟨j, rfl⟩)
          (by simp)
          (fun x y hx hy ihx ihy => by simpa using Subgroup.mul_mem _ ihx ihy)
          (fun c x hx ihx => by simpa using Subgroup.zpow_mem _ ihx c)
          hyN
      simpa using hmem
    · rw [Subgroup.closure_le]
      rintro y ⟨j, rfl⟩
      exact hWmem j
  -- The kernel of the abelianization is the normal closure of the basic commutators.
  have hS : Subgroup.normalClosure
        ((basicRelators d : Finset (FreeGroup (Fin d))) : Set (FreeGroup (Fin d))) = ab.ker := by
    rw [normalClosure_basicRelators]
    exact (Abelianization.ker_of (FreeGroup (Fin d))).symm
  refine ⟨basicRelators d ∪ (Finset.univ.image w), ?_, ?_⟩
  · have h1 : (basicRelators d ∪ (Finset.univ.image w)).card
        ≤ (basicRelators d).card + (Finset.univ.image w).card := Finset.card_union_le _ _
    have h2 : (Finset.univ.image w).card ≤ n := by
      calc (Finset.univ.image w).card ≤ (Finset.univ : Finset (Fin n)).card := Finset.card_image_le
        _ = n := by simp
    have h3 := basicRelators_card_le d
    omega
  · have hmain := normalClosure_union_eq_comap ab hS hT
    rw [hker, ← hmain]
    congr 1
    rw [Finset.coe_union, Finset.coe_image, Finset.coe_univ]
    simp

end Work.RelatorRank.Instance
