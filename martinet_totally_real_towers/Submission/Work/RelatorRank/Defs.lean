import Mathlib

/-!
# `Work.RelatorRank` -- the relation-rank chapter: definitions

**Namespace** `Work.RelatorRank`; module `Submission.Work.RelatorRank.Defs`.

This chapter isolates the group-theoretic invariant that stands between an *arithmetic* bound
on the number of relations of a pro-`p` Galois group and a *presentation* of that group on a
*concretely given* generating family -- the two halves that the workspace's
`Submission.NumberField.RelatorHalf` / `RelationRankLeSix` interface distinguishes
(see `Submission/PLAN.md` §§20--22 and `Submission/NumberField/TamePresentationDatum.lean`).

Nothing here is arithmetic: `Γ` is an arbitrary topological group (in the applications a
finitely generated pro-`p` group with the Krull topology, e.g. the Galois group
`K ≃ₐ[ℚ] K` of a number field, which Mathlib supplies with `IsTopologicalGroup` and
`CompactSpace` instances).

## The invariant

For a topological group `Γ`:

* `DenseGenerating gen` : the family `gen : ι → Γ` *densely* generates `Γ`, i.e.
  `(Subgroup.closure (Set.range gen)).topologicalClosure = ⊤`.  This is the right notion in the
  profinite setting: the abstract subgroup generated by a dense family need not be all of `Γ`
  (for `Γ = ℤ₂` the single element `1` is a dense generating family, and the abstract subgroup
  it generates is `ℤ ⊊ ℤ₂`);
* `HasDenseGeneratingFamily Γ d` : there is a dense generating family indexed by `Fin d`;
* `GeneratorRank Γ : ℕ` : the least `d` with a dense generating `d`-family (`sInf`, so `0` if
  there is no finite such family);
* `HasProP2Presentation Γ d r` : `Γ` admits a *topological* presentation with `d` generators and at
  most `r` relations: a dense generating family `gen : Fin d → Γ` whose presentation kernel
  `MonoidHom.ker (FreeGroup.lift gen)` is the normal closure of at most `r` words.
  `ProP2PresentationData` is the bundled form;
* `RelatorRankLe Γ r` : the same with the *canonical* generator number `GeneratorRank Γ` -- the
  form in which an arithmetic theorem (`dim_{𝔽₂} H²(Γ,𝔽₂) ≤ 6`) is naturally consumed;
* `RelatorRank Γ : ℕ` : the least such `r` -- the *relation rank* of `Γ`;
* `RelatorHalfOf Γ d r` : the *presentation-independent* form -- for **every** dense generating
  `d`-family there is a relator set of size `≤ r` presenting it (`Submission.NumberField.RelatorHalf`
  is the case `d = 5`, `r = 6` for `Γ = K ≃ₐ[ℚ] K`);
* `RelationRankInvariant Γ d r` : the bridge between `HasProP2Presentation Γ d r` and
  `RelatorHalfOf Γ d r` -- see `Submission/Work/RelatorRank/Bridge.lean`, where the bridge is proved
  from it, and the `README.md`, which records that this is *exactly* the missing group-theoretic
  input (the theorem `r(Γ) = dim_{𝔽₂} H²(Γ,𝔽₂)` for finitely generated pro-`2` groups).

The abstract (topology-free) analogues, indexed by the prefix `Abstract`, are provided for the
algebraic core: there `DenseGenerating` is replaced by honest generation
`Subgroup.closure (Set.range gen) = ⊤` and `Group.FG` is the finiteness hypothesis.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false

namespace Work.RelatorRank

/-! ## Dense generation in a topological group -/

/-- **Dense generation.**  A family `gen : ι → Γ` in a topological group *densely generates* `Γ`
when the topological closure of the abstract subgroup it generates is all of `Γ`.

In the profinite setting this is strictly weaker than generation: `1 ∈ ℤ₂` is a dense generating
family of `ℤ₂` whose abstract closure is `ℤ ⊊ ℤ₂`. -/
def DenseGenerating {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] {ι : Type*} (gen : ι → Γ) : Prop :=
  (Subgroup.closure (Set.range gen)).topologicalClosure = ⊤

/-- Restatement of `DenseGenerating`, for rewriting. -/
theorem denseGenerating_iff {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] {ι : Type*} (gen : ι → Γ) :
    DenseGenerating gen ↔ (Subgroup.closure (Set.range gen)).topologicalClosure = ⊤ := Iff.rfl

/-- A subgroup is dense exactly when its topological closure is `⊤`. -/
theorem topologicalClosure_eq_top_iff_dense {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] (s : Subgroup Γ) : s.topologicalClosure = ⊤ ↔ Dense (s : Set Γ) := by
  rw [dense_iff_closure_eq]
  constructor
  · intro h
    rw [← Subgroup.topologicalClosure_coe, h]
    rfl
  · intro h
    refine SetLike.coe_injective (A := Subgroup Γ) (B := Γ) ?_
    rw [Subgroup.topologicalClosure_coe, Subgroup.coe_top]
    exact h

/-- A family densely generates `Γ` iff the canonical presentation map `FreeGroup ι →* Γ`,
`xᵢ ↦ gen i`, has dense range. -/
theorem denseGenerating_iff_denseRange {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] {ι : Type*} (gen : ι → Γ) :
    DenseGenerating gen ↔ DenseRange (FreeGroup.lift gen) := by
  show DenseGenerating gen ↔ Dense (Set.range ⇑(FreeGroup.lift gen))
  rw [denseGenerating_iff, topologicalClosure_eq_top_iff_dense,
    show Set.range ⇑(FreeGroup.lift gen)
      = ((Subgroup.closure (Set.range gen) : Subgroup Γ) : Set Γ) from by
        rw [← MonoidHom.coe_range, FreeGroup.range_lift_eq_closure]]

/-- **There is a dense generating family of size `d`.** -/
def HasDenseGeneratingFamily (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d : ℕ) : Prop :=
  ∃ gen : Fin d → Γ, DenseGenerating gen

/-- `GeneratorRankLe Γ d` is `HasDenseGeneratingFamily Γ d`; the name is the one used in the
statements of the arithmetic inputs. -/
abbrev GeneratorRankLe (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d : ℕ) : Prop :=
  HasDenseGeneratingFamily Γ d

/-- **No dense generating family of size `< d`** -- the minimality hypothesis of the bridge
(`Submission.NumberField.GeneratorMinimal` is the case `d = 5`). -/
def NoSmallerGeneratingFamily (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    (d : ℕ) : Prop :=
  ∀ d' : ℕ, d' < d → ¬ HasDenseGeneratingFamily Γ d'

/-- A family is a **minimal** dense generating family when it densely generates and there is no
dense generating family of strictly smaller cardinality.  Equivalently `GeneratorRank Γ = d`
(see `Work.RelatorRank.generatorRank_eq_of`). -/
def IsMinimalDenseGeneratingFamily {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] (d : ℕ) (gen : Fin d → Γ) : Prop :=
  DenseGenerating gen ∧ NoSmallerGeneratingFamily Γ d

/-- **The generator rank** `d(Γ)`: the least size of a dense generating family (`sInf`, hence `0`
when no finite dense generating family exists). -/
noncomputable def GeneratorRank (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : ℕ :=
  sInf {d : ℕ | HasDenseGeneratingFamily Γ d}

/-! ## Topological presentations -/

/-- **A topological (pro-`p`) presentation datum** of `Γ` on `d` generators with `r` relators: a
dense generating family `gen` together with a finite relator set `rel` whose normal closure in the
*discrete* free group `FreeGroup (Fin d)` is exactly the kernel of the presentation map
`xᵢ ↦ gen i`.  The abstract group `FreeGroup (Fin d) ⧸ normalClosure rel` therefore embeds into
`Γ` with dense image.

This is the bundled form of `HasProP2Presentation`; it is the shape of
`Work.TameArithmetic.TamePro2Presentation` (which fixes `d = 5`, `r = 6` and `Γ = K ≃ₐ[ℚ] K`). -/
structure ProP2PresentationData (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d r : ℕ) where
  /-- the generating family -/
  gen : Fin d → Γ
  /-- the relator set -/
  rel : Finset (FreeGroup (Fin d))
  /-- the family densely generates -/
  dense : DenseGenerating gen
  /-- there are at most `r` relators -/
  card_le : rel.card ≤ r
  /-- the relators present `Γ` on the given generators -/
  ker_eq : MonoidHom.ker (FreeGroup.lift gen) =
    Subgroup.normalClosure (rel : Set (FreeGroup (Fin d)))

/-- **`Γ` admits a presentation by `d` generators and at most `r` relators.** -/
def HasProP2Presentation (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d r : ℕ) : Prop :=
  Nonempty (ProP2PresentationData Γ d r)

/-- `RelatorRankOfLe Γ d r` is `HasProP2Presentation Γ d r`, under the name used when the
generator number is a parameter. -/
abbrev RelatorRankOfLe (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d r : ℕ) : Prop :=
  HasProP2Presentation Γ d r

/-- **The relation-rank bound.**  `Γ` has a presentation on `GeneratorRank Γ` generators with at
most `r` relators.  Classically `RelatorRankLe Γ r` is equivalent to `dim_{𝔽₂} H²(Γ, 𝔽₂) ≤ r`
(the continuous cohomology; see `Submission/Work/RelatorRank/Cohomology.lean`), which is why an
arithmetic bound of that shape is consumed through this predicate. -/
def RelatorRankLe (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (r : ℕ) : Prop :=
  HasProP2Presentation Γ (GeneratorRank Γ) r

/-- **The relation rank** `r(Γ)`: the least number of relators in a presentation of `Γ` on
`GeneratorRank Γ` generators (`sInf`, hence `0` if there is no finite presentation on that many
generators). -/
noncomputable def RelatorRank (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : ℕ :=
  sInf {r : ℕ | RelatorRankLe Γ r}

/-- **The presentation-independent (universal) relation bound.**  Every dense generating
`d`-family of `Γ` admits a relator set of at most `r` elements presenting `Γ` on that family.

`Submission.NumberField.RelatorHalf K` is this predicate for `Γ = K ≃ₐ[ℚ] K`, `d = 5`, `r = 6`; the
point of the chapter is to compare it with `HasProP2Presentation Γ d r` (which is what an
arithmetic theorem produces, for one particular family). -/
def RelatorHalfOf (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d r : ℕ) : Prop :=
  ∀ gen : Fin d → Γ, DenseGenerating gen →
    ∃ rel : Finset (FreeGroup (Fin d)), rel.card ≤ r ∧
      MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure (rel : Set (FreeGroup (Fin d)))

/-- **The bridge hypothesis**: the number of relations of a presentation of `Γ` on `d` generators
does not depend on the chosen dense generating family.

Mathematically this is the classical theorem `r(Γ) = dim_{𝔽₂} H²(Γ, 𝔽₂)` for finitely generated
pro-`2` groups (`r` = minimal number of relations, `H²` = continuous cohomology), which makes the
minimal relation number a *presentation invariant*.  It is **not proved** in this workspace (it
needs the continuous cohomology of profinite groups, which Mathlib does not have, and the
five-term exact sequence); see `Submission/Work/RelatorRank/Bridge.lean` and the `README.md` for
the precise statement of what is missing, for the counterexample showing that the
automorphism-transitivity argument of `Submission/PLAN.md` §21 does *not* prove it, and for what
*is* proved here (invariance under automorphisms of `Γ` and under automorphisms of the free
group). -/
def RelationRankInvariant (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] (d r : ℕ) : Prop :=
  HasProP2Presentation Γ d r → RelatorHalfOf Γ d r

/-! ## The abstract (topology-free) core -/

/-- **Generation** of an abstract group by a family. -/
def Generating {G : Type*} [Group G] {ι : Type*} (gen : ι → G) : Prop :=
  Subgroup.closure (Set.range gen) = ⊤

/-- Restatement of `Generating`, for rewriting. -/
theorem generating_iff {G : Type*} [Group G] {ι : Type*} (gen : ι → G) :
    Generating gen ↔ Subgroup.closure (Set.range gen) = ⊤ := Iff.rfl

/-- There is a generating family of size `d`. -/
def HasGeneratingFamily (G : Type*) [Group G] (d : ℕ) : Prop := ∃ gen : Fin d → G, Generating gen

/-- The least size of a generating family of an abstract group (`sInf`). -/
noncomputable def GenRank (G : Type*) [Group G] : ℕ := sInf {d : ℕ | HasGeneratingFamily G d}

/-- **An abstract presentation datum**: `d` generators, at most `r` relators. -/
structure AbstractPresentationData (G : Type*) [Group G] (d r : ℕ) where
  /-- the generating family -/
  gen : Fin d → G
  /-- the relator set -/
  rel : Finset (FreeGroup (Fin d))
  /-- the family generates -/
  generating : Generating gen
  /-- there are at most `r` relators -/
  card_le : rel.card ≤ r
  /-- the relators present `G` on the given generators -/
  ker_eq : MonoidHom.ker (FreeGroup.lift gen) =
    Subgroup.normalClosure (rel : Set (FreeGroup (Fin d)))

/-- `G` admits an abstract presentation by `d` generators and at most `r` relators. -/
def HasAbstractPresentation (G : Type*) [Group G] (d r : ℕ) : Prop :=
  Nonempty (AbstractPresentationData G d r)

/-- The topology-free analogue of `RelatorHalfOf`: every generating family of size `d` of the
abstract group `G` admits at most `r` relators. -/
def AbstractRelatorHalfOf (G : Type*) [Group G] (d r : ℕ) : Prop :=
  ∀ gen : Fin d → G, Generating gen →
    ∃ rel : Finset (FreeGroup (Fin d)), rel.card ≤ r ∧
      MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure (rel : Set (FreeGroup (Fin d)))

/-- The topology-free analogue of `RelationRankInvariant`: the minimal number of relators of an
abstract presentation of `G` on `d` generators does not depend on the generating family. -/
def AbstractRelationRankInvariant (G : Type*) [Group G] (d r : ℕ) : Prop :=
  HasAbstractPresentation G d r → AbstractRelatorHalfOf G d r

end Work.RelatorRank
