import Mathlib
import Submission.Work.RelatorRank.Gaschutz.AlignDefs

/-!
# Gaschütz's alignment lemma for `p = 2`

**Namespace** `Work.RelatorRank.Gaschutz`; module
`Submission.Work.RelatorRank.Gaschutz.exists_aut_align_two`.

For a finite `2`-group `G` and two epimorphisms `f, f' : F_d ↠ G` from the free group on `d`
generators, where `d` is the minimal number of generators of `G`, there is an automorphism `σ` of
`F_d` after which `f' ∘ σ` agrees with `f` modulo the Frattini subgroup of `G`:

`∃ σ, ∀ x, f' (σ x) * (f x)⁻¹ ∈ Φ(G)`.

This is the classical Gaschütz alignment lemma, and it is proved here by the following route.

1. Both `f` and `f'` are *minimal* epimorphisms, so `|G ⧸ Φ(G)| = 2^d` (Burnside's basis theorem,
   `Commons.GroupTheory.ProPGroup.natCard_quotient_frattini_eq_pow_card`).
2. The maps `q ∘ f` and `q ∘ f'` (with `q : G →* G ⧸ Φ(G)` the quotient map) both kill the
   subgroup `gsPhiF 2 (Fin d) ≤ F_d` generated by the squares and the commutators
   (`Commons.GroupTheory.ProPGroup.map_gsPhiF_le_frattini`), hence factor through the mod-`2`
   abelianisation `alphaRed d : F_d →* Multiplicative (Fin d → ZMod 2)`; the factorisations
   `lam`, `lam'` are isomorphisms because both sides have order `2^d` (`aux_factor` below).
3. The difference `ρ = lam'⁻¹ ∘ lam` is an automorphism of `(ℤ/2)^d`, and it is induced by an
   automorphism `σ` of `F_d` (`aux_lift` below, the surjectivity of `Aut(F_d) → GL_d(𝔽₂)`).
4. For that `σ` one has `q (f' (σ x)) = q (f x)`, i.e. `f' (σ x) * (f x)⁻¹ ∈ Φ(G)`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank.Gaschutz

open scoped Classical

/-- A surjective homomorphism between finite groups of equal cardinality is bijective. -/
private theorem bijective_of_surjective_card_eq {α β : Type*} [Group α] [Group β]
    [Finite α] [Finite β] (φ : α →* β) (hφ : Function.Surjective φ)
    (hcard : Nat.card α = Nat.card β) : Function.Bijective φ := by
  refine ⟨?_, hφ⟩
  rw [← MonoidHom.ker_eq_bot_iff]
  have h1 : Nat.card (α ⧸ φ.ker) = Nat.card β := by
    rw [← Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective φ hφ).toEquiv]
  have h2 : Nat.card α = Nat.card (α ⧸ φ.ker) * Nat.card φ.ker :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup φ.ker
  have h3 : Nat.card φ.ker = 1 := by
    have h2' : Nat.card α = Nat.card α * Nat.card φ.ker := by
      calc Nat.card α = Nat.card (α ⧸ φ.ker) * Nat.card φ.ker := h2
        _ = Nat.card β * Nat.card φ.ker := by rw [h1]
        _ = Nat.card α * Nat.card φ.ker := by rw [← hcard]
    have h6 : Nat.card α * 1 = Nat.card α * Nat.card φ.ker := by rw [mul_one]; exact h2'
    have h7 : 1 = Nat.card φ.ker := Nat.eq_of_mul_eq_mul_left Nat.card_pos h6
    exact h7.symm
  haveI : Subsingleton φ.ker := (Nat.card_eq_one_iff_unique.mp h3).1
  exact Subgroup.eq_bot_of_subsingleton _

/-- The cardinality of the free elementary abelian `2`-group on `d` generators. -/
private theorem card_V (d : ℕ) : Nat.card (Multiplicative (Fin d → ZMod 2)) = 2 ^ d := by
  rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, Fintype.card_fun, ZMod.card,
    Fintype.card_fin]

/-- The order of the Frattini-like quotient `F_d ⧸ gsPhiF` of the free group. -/
private theorem card_quot_gsPhiF (d : ℕ) :
    Nat.card (FreeGroup (Fin d) ⧸ Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)) = 2 ^ d := by
  haveI : (Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)).Normal :=
    Commons.GroupTheory.ProPGroup.gsPhiF_normal 2 (Fin d)
  haveI : Finite (FreeGroup (Fin d) ⧸ Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)) :=
    Commons.GroupTheory.ProPGroup.finite_quot_gsPhiF 2 (Fin d)
  refine le_antisymm (by simpa using Commons.GroupTheory.ProPGroup.natCard_quot_gsPhiF_le 2 (Fin d)) ?_
  have hKα : Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d) ≤ (alphaRed d).ker :=
    gsPhiF_le_ker_alphaRed d
  have hsurj : Function.Surjective
      (QuotientGroup.lift (Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)) (alphaRed d) hKα) := by
    intro v
    obtain ⟨x, rfl⟩ := alphaRed_surjective d v
    exact ⟨QuotientGroup.mk' _ x, QuotientGroup.lift_mk' _ hKα x⟩
  have hle := Nat.card_le_card_of_surjective
    (QuotientGroup.lift (Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)) (alphaRed d) hKα) hsurj
  simpa only [card_V d] using hle

/-- **The factorisation of a minimal epimorphism through the mod-`2` abelianisation.**  For a
finite `2`-group `G` with a minimal generating epimorphism `f : F_d ↠ G`, the composite of `f`
with the quotient map to `G ⧸ Φ(G)` factors through the mod-`2` abelianisation, and the
factorisation is an isomorphism (both groups have order `2^d`). -/
private theorem aux_factor {G : Type} [Group G] [Fintype G] (hG : IsPGroup 2 G) {d : ℕ}
    (hd : ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ → d ≤ S.card)
    (f : FreeGroup (Fin d) →* G) (hf : Function.Surjective f) :
    ∃ lam : Multiplicative (Fin d → ZMod 2) ≃* (G ⧸ frattini G),
      (QuotientGroup.mk' (frattini G)).comp f = lam.toMonoidHom.comp (alphaRed d) := by
  classical
  let K : Subgroup (FreeGroup (Fin d)) := Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d)
  haveI hKnormal : K.Normal := Commons.GroupTheory.ProPGroup.gsPhiF_normal 2 (Fin d)
  haveI hKfinite : Finite (FreeGroup (Fin d) ⧸ K) :=
    Commons.GroupTheory.ProPGroup.finite_quot_gsPhiF 2 (Fin d)
  have hcardK : Nat.card (FreeGroup (Fin d) ⧸ K) = 2 ^ d := card_quot_gsPhiF d
  have hcardQ : Nat.card (G ⧸ frattini G) = 2 ^ d := by
    simpa using Commons.GroupTheory.ProPGroup.natCard_quotient_frattini_eq_pow_card 2 hG f hf
      (by simpa using hd)
  have hKα : K ≤ (alphaRed d).ker := gsPhiF_le_ker_alphaRed d
  have hKf : K ≤ ((QuotientGroup.mk' (frattini G)).comp f).ker := by
    intro x hx
    rw [MonoidHom.mem_ker, MonoidHom.comp_apply]
    exact (QuotientGroup.eq_one_iff (f x)).mpr
      (Commons.GroupTheory.ProPGroup.map_gsPhiF_le_frattini 2 (Fin d) hG f
        (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩))
  have hαKbij : Function.Bijective (QuotientGroup.lift K (alphaRed d) hKα) := by
    refine bijective_of_surjective_card_eq _ ?_ ?_
    · intro v
      obtain ⟨x, rfl⟩ := alphaRed_surjective d v
      exact ⟨QuotientGroup.mk' K x, QuotientGroup.lift_mk' K hKα x⟩
    · rw [hcardK, card_V d]
  have hlam0bij : Function.Bijective
      (QuotientGroup.lift K ((QuotientGroup.mk' (frattini G)).comp f) hKf) := by
    refine bijective_of_surjective_card_eq _ ?_ ?_
    · intro y
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (frattini G) y
      obtain ⟨z, rfl⟩ := hf x
      exact ⟨QuotientGroup.mk' K z, QuotientGroup.lift_mk' K hKf z⟩
    · rw [hcardK, hcardQ]
  refine ⟨(MulEquiv.ofBijective (QuotientGroup.lift K (alphaRed d) hKα) hαKbij).symm.trans
      (MulEquiv.ofBijective (QuotientGroup.lift K ((QuotientGroup.mk' (frattini G)).comp f) hKf)
        hlam0bij), ?_⟩
  have h1 : ∀ x : FreeGroup (Fin d),
      (MulEquiv.ofBijective (QuotientGroup.lift K (alphaRed d) hKα) hαKbij)
        (QuotientGroup.mk' K x) = alphaRed d x := fun x => by
    simp only [MulEquiv.ofBijective_apply, QuotientGroup.mk'_apply,
      QuotientGroup.lift_mk']
  refine MonoidHom.ext fun x => ?_
  rw [MonoidHom.comp_apply, MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe,
    MulEquiv.trans_apply]
  rw [show (MulEquiv.ofBijective (QuotientGroup.lift K (alphaRed d) hKα) hαKbij).symm (alphaRed d x)
      = QuotientGroup.mk' K x from by rw [← h1 x, MulEquiv.symm_apply_apply]]
  simp only [MulEquiv.ofBijective_apply, QuotientGroup.mk'_apply, QuotientGroup.lift_mk',
    MonoidHom.comp_apply]

/-- **The matrix form of `Aut(F_d) ↠ GL_d(𝔽₂)`.**  Every invertible `d × d` matrix over `𝔽₂` is the
image, on the mod-`2` abelianisation, of an automorphism of the free group. -/
private theorem exists_aut_of_matrix_core (d : ℕ) (M : Matrix (Fin d) (Fin d) (ZMod 2))
    (hM : M.det ≠ 0) :
    ∃ σ : FreeGroup (Fin d) ≃* FreeGroup (Fin d),
      (alphaRed d).comp σ.toMonoidHom = (matHom d M).comp (alphaRed d) := by
  classical
  let P : Matrix (Fin d) (Fin d) (ZMod 2) → Prop := fun N =>
    ∃ σ : FreeGroup (Fin d) ≃* FreeGroup (Fin d),
      (alphaRed d).comp σ.toMonoidHom = (matHom d N).comp (alphaRed d)
  have hdiag : ∀ D : Fin d → ZMod 2, (Matrix.diagonal D).det ≠ 0 → P (Matrix.diagonal D) := by
    intro D hD
    have hone : ∀ i, D i = 1 := by
      intro i
      have hprod : ∏ j, D j ≠ 0 := by rwa [Matrix.det_diagonal] at hD
      have hne : D i ≠ 0 := (Finset.prod_ne_zero_iff.mp hprod) i (Finset.mem_univ i)
      have hlt : (D i).val < 2 := ZMod.val_lt _
      have hval : (D i).val = 1 := by
        have : (D i).val ≠ 0 := fun h => hne ((ZMod.val_eq_zero _).mp h)
        omega
      rw [← ZMod.natCast_zmod_val (D i), hval]; norm_num
    have hmat : Matrix.diagonal D = 1 := by
      rw [show D = fun _ => (1 : ZMod 2) from funext hone, Matrix.diagonal_one]
    refine ⟨1, ?_⟩
    rw [hmat, matHom_id]
    ext x
    simp
  have htransvec : ∀ t : Matrix.TransvectionStruct (Fin d) (ZMod 2), P t.toMatrix := by
    rintro ⟨i, j, hij, c⟩
    rw [Matrix.TransvectionStruct.toMatrix_mk]
    by_cases hc : c = 0
    · subst hc
      rw [Matrix.transvection_zero]
      refine ⟨1, ?_⟩
      rw [matHom_id]
      ext x
      simp
    · have hc1 : c = 1 := by
        have hlt : c.val < 2 := ZMod.val_lt _
        have hval : c.val = 1 := by
          have : c.val ≠ 0 := fun h => hc ((ZMod.val_eq_zero c).mp h)
          omega
        rw [← ZMod.natCast_zmod_val c, hval]; norm_num
      subst hc1
      exact ⟨nielsenMove j i hij.symm, alphaRed_nielsenMove hij.symm⟩
  have hmul : ∀ A B, A.det ≠ 0 → B.det ≠ 0 → P A → P B → P (A * B) := by
    intro A B hA hB ⟨σA, hσA⟩ ⟨σB, hσB⟩
    have hσA' : ∀ y, alphaRed d (σA y) = matHom d A (alphaRed d y) := fun y => by
      have := DFunLike.congr_fun hσA y
      simpa only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using this
    have hσB' : ∀ y, alphaRed d (σB y) = matHom d B (alphaRed d y) := fun y => by
      have := DFunLike.congr_fun hσB y
      simpa only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using this
    refine ⟨σA * σB, ?_⟩
    refine MonoidHom.ext fun x => ?_
    rw [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe, MulAut.mul_apply,
      hσA', hσB']
    show matHom d A (matHom d B (alphaRed d x)) = matHom d (A * B) (alphaRed d x)
    rw [matHom_comp, MonoidHom.comp_apply]
  exact Matrix.diagonal_transvection_induction_of_det_ne_zero P M hM hdiag htransvec hmul

/-- **`Aut(F_d) ↠ GL_d(𝔽₂)`.**  Every automorphism of the free elementary abelian quotient
`(ℤ/2)^d` of `F_d` is induced by an automorphism of `F_d`. -/
private theorem aux_lift (d : ℕ)
    (ρ : Multiplicative (Fin d → ZMod 2) ≃* Multiplicative (Fin d → ZMod 2)) :
    ∃ σ : FreeGroup (Fin d) ≃* FreeGroup (Fin d),
      ∀ x : FreeGroup (Fin d), alphaRed d (σ x) = ρ (alphaRed d x) := by
  classical
  let linS : (Fin d → ZMod 2) →ₗ[ZMod 2] (Fin d → ZMod 2) :=
    AddMonoidHom.toZModLinearMap 2
      { toFun := fun v => (ρ (Multiplicative.ofAdd v)).toAdd
        map_zero' := by simp
        map_add' := fun v w => by rw [ofAdd_add, map_mul, toAdd_mul] }
  let linT : (Fin d → ZMod 2) →ₗ[ZMod 2] (Fin d → ZMod 2) :=
    AddMonoidHom.toZModLinearMap 2
      { toFun := fun v => (ρ.symm (Multiplicative.ofAdd v)).toAdd
        map_zero' := by simp
        map_add' := fun v w => by rw [ofAdd_add, map_mul, toAdd_mul] }
  have keyS : ∀ v, Multiplicative.ofAdd (linS v) = ρ (Multiplicative.ofAdd v) :=
    fun v => by simp [linS]
  have keyT : ∀ v, Multiplicative.ofAdd (linT v) = ρ.symm (Multiplicative.ofAdd v) :=
    fun v => by simp [linT]
  have hcomp : linS ∘ₗ linT = LinearMap.id := by
    refine LinearMap.ext fun v => ?_
    rw [LinearMap.comp_apply, LinearMap.id_apply]
    refine Equiv.injective Multiplicative.ofAdd ?_
    rw [keyS, keyT, MulEquiv.apply_symm_apply]
  let M : Matrix (Fin d) (Fin d) (ZMod 2) := LinearMap.toMatrix' linS
  let N : Matrix (Fin d) (Fin d) (ZMod 2) := LinearMap.toMatrix' linT
  have hMN : M * N = 1 := by
    rw [show M * N = LinearMap.toMatrix' (linS ∘ₗ linT) from
        (LinearMap.toMatrix'_comp linS linT).symm,
      hcomp, LinearMap.toMatrix'_id]
  have hMdet : M.det ≠ 0 := Matrix.det_ne_zero_of_right_inverse hMN
  obtain ⟨σ, hσ⟩ := exists_aut_of_matrix_core d M hMdet
  have hpt : ∀ x, alphaRed d (σ x) = Multiplicative.ofAdd (M.mulVec (alphaRed d x).toAdd) := by
    intro x
    have h1 := DFunLike.congr_fun hσ x
    simp only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] at h1
    rw [h1]
    conv_lhs => rw [show alphaRed d x = Multiplicative.ofAdd (alphaRed d x).toAdd from rfl]
    rw [matHom_apply]
  refine ⟨σ, fun x => ?_⟩
  have hmv : M.mulVec ((alphaRed d x).toAdd) = linS ((alphaRed d x).toAdd) := by
    show (LinearMap.toMatrix' linS).mulVec _ = _
    rw [← Matrix.toLin'_apply, Matrix.toLin'_toMatrix']
  rw [hpt x, hmv, keyS, show Multiplicative.ofAdd (alphaRed d x).toAdd = alphaRed d x from rfl]

theorem exists_aut_align_two {G : Type} [Group G] [Fintype G] (hG : IsPGroup 2 G) {d : ℕ}
    (hd : ∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ → d ≤ S.card)
    (f f' : FreeGroup (Fin d) →* G) (hf : Function.Surjective f) (hf' : Function.Surjective f') :
    ∃ σ : FreeGroup (Fin d) ≃* FreeGroup (Fin d),
      ∀ x : FreeGroup (Fin d), f' (σ x) * (f x)⁻¹ ∈ frattini G := by
  classical
  obtain ⟨lam, hlam⟩ := aux_factor hG hd f hf
  obtain ⟨lam', hlam'⟩ := aux_factor hG hd f' hf'
  have hq : ∀ x : FreeGroup (Fin d),
      QuotientGroup.mk' (frattini G) (f x) = lam (alphaRed d x) := by
    intro x
    have := DFunLike.congr_fun hlam x
    simpa only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using this
  have hq' : ∀ x : FreeGroup (Fin d),
      QuotientGroup.mk' (frattini G) (f' x) = lam' (alphaRed d x) := by
    intro x
    have := DFunLike.congr_fun hlam' x
    simpa only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using this
  obtain ⟨σ, hσ⟩ := aux_lift d (lam.trans lam'.symm)
  refine ⟨σ, fun x => ?_⟩
  have h1 : QuotientGroup.mk' (frattini G) (f' (σ x))
      = QuotientGroup.mk' (frattini G) (f x) := by
    rw [hq' (σ x), hσ x, hq x, MulEquiv.trans_apply, MulEquiv.apply_symm_apply]
  have hmem : f' (σ x) * (f x)⁻¹ ∈ (QuotientGroup.mk' (frattini G)).ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, h1, mul_inv_cancel]
  rwa [QuotientGroup.ker_mk'] at hmem

end Work.RelatorRank.Gaschutz
