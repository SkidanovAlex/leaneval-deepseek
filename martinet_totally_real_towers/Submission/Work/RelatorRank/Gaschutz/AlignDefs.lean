import Mathlib
import Submission.Commons.GroupTheory.ProPGroup.golod_shafarevich_presentation_card_lt

/-!
# `Work.RelatorRank.Gaschutz` -- the mod-2 abelianisation of a free group

**Namespace** `Work.RelatorRank.Gaschutz`; module
`Submission.Work.RelatorRank.Gaschutz.AlignDefs`.

This module collects the objects used in the proof of the alignment lemma
`Work.RelatorRank.Gaschutz.exists_aut_align_two`:

* `alphaRed d : FreeGroup (Fin d) →* Multiplicative (Fin d → ZMod 2)`, the universal map onto the
  free elementary abelian `2`-group (the "mod-`2` abelianisation"), surjective, with kernel
  containing `gsPhiF 2 (Fin d)` (the subgroup generated by the squares and the commutators);
* `matHom d M`, the multiplicative form of the action of a matrix `M` on `Fin d → ZMod 2`, with
  `matHom d (M * N) = (matHom d M).comp (matHom d N)`;
* the elementary Nielsen automorphisms `nielsenMove i j : a_i ↦ a_i * a_j` of the free group, and
  the computation `alphaRed_nielsenMove` that `nielsenMove i j` induces the transvection
  `1 + single j i 1` on the mod-`2` abelianisation.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank.Gaschutz

open scoped Classical

/-- **The mod-`2` abelianisation of the free group on `d` generators.**  The universal map from
`FreeGroup (Fin d)` to a group of exponent `2`; it sends the `i`-th free generator to the `i`-th
standard basis vector. -/
noncomputable def alphaRed (d : ℕ) : FreeGroup (Fin d) →* Multiplicative (Fin d → ZMod 2) :=
  FreeGroup.lift fun i => Multiplicative.ofAdd (Pi.single i 1)

@[simp]
theorem alphaRed_of {d : ℕ} (i : Fin d) :
    alphaRed d (FreeGroup.of i) = Multiplicative.ofAdd (Pi.single i 1) :=
  FreeGroup.lift_apply_of

/-- The mod-`2` abelianisation is surjective. -/
theorem alphaRed_surjective (d : ℕ) : Function.Surjective (alphaRed d) := by
  change Function.Surjective (FreeGroup.lift fun i => Multiplicative.ofAdd (Pi.single i 1))
  rw [FreeGroup.lift_surjective_iff_closure_range_eq_top, eq_top_iff]
  intro v _
  set S := Subgroup.closure (Set.range fun i : Fin d =>
    Multiplicative.ofAdd (Pi.single i 1 : Fin d → ZMod 2)) with hS
  have hgen : ∀ (i : Fin d) (c : ZMod 2),
      Multiplicative.ofAdd (Pi.single i c : Fin d → ZMod 2) ∈ S := by
    intro i c
    have hpow : Multiplicative.ofAdd (Pi.single i c) =
        (Multiplicative.ofAdd (Pi.single i 1 : Fin d → ZMod 2)) ^ c.val := by
      rw [← ofAdd_nsmul]
      congr 1
      ext j
      by_cases h : j = i
      · subst h; simp
      · simp [h]
    rw [hpow]
    exact Subgroup.pow_mem S (Subgroup.subset_closure (Set.mem_range_self i)) c.val
  have hsum : v.toAdd = ∑ i : Fin d, (Pi.single i (v.toAdd i) : Fin d → ZMod 2) := by
    ext j
    simp
  rw [show v = Multiplicative.ofAdd v.toAdd from rfl, hsum, ofAdd_sum]
  exact Subgroup.prod_mem S fun i _ => hgen i (v.toAdd i)

/-- The squares lie in the kernel of the mod-`2` abelianisation. -/
theorem alphaRed_pow_two {d : ℕ} (g : FreeGroup (Fin d)) : alphaRed d (g ^ 2) = 1 := by
  rw [map_pow]
  obtain ⟨w, hw⟩ : ∃ w : Fin d → ZMod 2, alphaRed d g = Multiplicative.ofAdd w :=
    ⟨(alphaRed d g).toAdd, rfl⟩
  rw [hw, ← ofAdd_nsmul]
  rw [show (2 : ℕ) • w = 0 from by
    rw [← Nat.cast_smul_eq_nsmul (ZMod 2) 2 w, ZMod.natCast_self, zero_smul]]
  rfl

/-- The commutators lie in the kernel of the mod-`2` abelianisation. -/
theorem alphaRed_commutator {d : ℕ} (a b : FreeGroup (Fin d)) :
    alphaRed d (a * b * a⁻¹ * b⁻¹) = 1 := by
  rw [map_mul, map_mul, map_mul, map_inv, map_inv]
  refine Multiplicative.toAdd.injective ?_
  simp only [toAdd_mul, toAdd_inv, toAdd_one]
  abel

/-- The subgroup generated by the squares and the commutators lies in the kernel of the mod-`2`
abelianisation. -/
theorem gsPhiF_le_ker_alphaRed (d : ℕ) :
    Commons.GroupTheory.ProPGroup.gsPhiF 2 (Fin d) ≤ (alphaRed d).ker := by
  rw [Commons.GroupTheory.ProPGroup.gsPhiF]
  refine (Subgroup.closure_le ((alphaRed d).ker)).mpr ?_
  rintro x (⟨a, b, rfl⟩ | ⟨g, rfl⟩)
  · exact MonoidHom.mem_ker.mpr (alphaRed_commutator a b)
  · exact MonoidHom.mem_ker.mpr (alphaRed_pow_two g)

/-- **The multiplicative action of a matrix.**  `matHom d M` is the group homomorphism
`Multiplicative (Fin d → ZMod 2) →* Multiplicative (Fin d → ZMod 2)` induced by `v ↦ M *ᵥ v`. -/
noncomputable def matHom (d : ℕ) (M : Matrix (Fin d) (Fin d) (ZMod 2)) :
    Multiplicative (Fin d → ZMod 2) →* Multiplicative (Fin d → ZMod 2) where
  toFun v := Multiplicative.ofAdd (M.mulVec v.toAdd)
  map_one' := by
    rw [show (1 : Multiplicative (Fin d → ZMod 2)).toAdd = 0 from rfl, Matrix.mulVec_zero,
      ofAdd_zero]
  map_mul' v w := by
    rw [show (v * w).toAdd = v.toAdd + w.toAdd from rfl, Matrix.mulVec_add, ofAdd_add]

theorem matHom_apply (d : ℕ) (M : Matrix (Fin d) (Fin d) (ZMod 2)) (v : Fin d → ZMod 2) :
    matHom d M (Multiplicative.ofAdd v) = Multiplicative.ofAdd (M.mulVec v) := rfl

theorem matHom_id (d : ℕ) : matHom d 1 = MonoidHom.id _ := by
  refine MonoidHom.ext fun v => ?_
  have hv : v = Multiplicative.ofAdd v.toAdd := rfl
  rw [hv, matHom_apply, Matrix.one_mulVec, MonoidHom.id_apply]

theorem matHom_comp (d : ℕ) (M N : Matrix (Fin d) (Fin d) (ZMod 2)) :
    matHom d (M * N) = (matHom d M).comp (matHom d N) := by
  refine MonoidHom.ext fun v => ?_
  have hv : v = Multiplicative.ofAdd v.toAdd := rfl
  rw [hv, MonoidHom.comp_apply, matHom_apply, matHom_apply, matHom_apply, Matrix.mulVec_mulVec]

/-- The transvection `1 + single j i 1` acts on the standard basis by adding `e_j` to `e_i`. -/
theorem transvection_mulVec_single {d : ℕ} {i j : Fin d} (hij : i ≠ j) (k : Fin d) :
    (Matrix.transvection j i (1 : ZMod 2)).mulVec (Pi.single k 1)
      = Pi.single k 1 + (if k = i then Pi.single j 1 else 0) := by
  have hupd : ∀ (l : Fin d) (c : ZMod 2),
      Function.update (0 : Fin d → ZMod 2) l c = Pi.single l c := by
    intro l c; ext x
    by_cases h : x = l
    · subst h; simp
    · simp [Function.update, h]
  rw [Matrix.transvection, Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec, hupd]
  by_cases hk : k = i
  · subst hk; simp only [Pi.single_eq_same, mul_one, ↓reduceIte]
  · simp only [Pi.single_eq_of_ne (Ne.symm hk), mul_zero, Pi.single_zero, hk, ↓reduceIte, add_zero]

/-- The homomorphism underlying the elementary Nielsen move `a_i ↦ a_i * a_j`. -/
noncomputable def nielsenFwd {d : ℕ} (i j : Fin d) : FreeGroup (Fin d) →* FreeGroup (Fin d) :=
  FreeGroup.lift fun k => if k = i then FreeGroup.of i * FreeGroup.of j else FreeGroup.of k

/-- Its inverse, `a_i ↦ a_i * a_j⁻¹`. -/
noncomputable def nielsenBwd {d : ℕ} (i j : Fin d) : FreeGroup (Fin d) →* FreeGroup (Fin d) :=
  FreeGroup.lift fun k => if k = i then FreeGroup.of i * (FreeGroup.of j)⁻¹ else FreeGroup.of k

theorem nielsenFwd_of_self {d : ℕ} (i j : Fin d) :
    nielsenFwd i j (FreeGroup.of i) = FreeGroup.of i * FreeGroup.of j := by
  rw [nielsenFwd, FreeGroup.lift_apply_of]; simp only [↓reduceIte]

theorem nielsenFwd_of_ne {d : ℕ} {i j k : Fin d} (hk : k ≠ i) :
    nielsenFwd i j (FreeGroup.of k) = FreeGroup.of k := by
  rw [nielsenFwd, FreeGroup.lift_apply_of]; simp only [hk, ↓reduceIte]

theorem nielsenBwd_of_self {d : ℕ} (i j : Fin d) :
    nielsenBwd i j (FreeGroup.of i) = FreeGroup.of i * (FreeGroup.of j)⁻¹ := by
  rw [nielsenBwd, FreeGroup.lift_apply_of]; simp only [↓reduceIte]

theorem nielsenBwd_of_ne {d : ℕ} {i j k : Fin d} (hk : k ≠ i) :
    nielsenBwd i j (FreeGroup.of k) = FreeGroup.of k := by
  rw [nielsenBwd, FreeGroup.lift_apply_of]; simp only [hk, ↓reduceIte]

theorem nielsenBwd_comp_nielsenFwd {d : ℕ} (i j : Fin d) (hij : i ≠ j) :
    (nielsenBwd i j).comp (nielsenFwd i j) = MonoidHom.id (FreeGroup (Fin d)) := by
  refine FreeGroup.ext_hom _ _ fun k => ?_
  by_cases hk : k = i
  · subst hk
    rw [MonoidHom.comp_apply, nielsenFwd_of_self, map_mul, nielsenBwd_of_self,
      nielsenBwd_of_ne (Ne.symm hij), MonoidHom.id_apply]
    group
  · rw [MonoidHom.comp_apply, nielsenFwd_of_ne hk, nielsenBwd_of_ne hk, MonoidHom.id_apply]

theorem nielsenFwd_comp_nielsenBwd {d : ℕ} (i j : Fin d) (hij : i ≠ j) :
    (nielsenFwd i j).comp (nielsenBwd i j) = MonoidHom.id (FreeGroup (Fin d)) := by
  refine FreeGroup.ext_hom _ _ fun k => ?_
  by_cases hk : k = i
  · subst hk
    rw [MonoidHom.comp_apply, nielsenBwd_of_self, map_mul, map_inv, nielsenFwd_of_self,
      nielsenFwd_of_ne (Ne.symm hij), MonoidHom.id_apply]
    group
  · rw [MonoidHom.comp_apply, nielsenBwd_of_ne hk, nielsenFwd_of_ne hk, MonoidHom.id_apply]

/-- **The elementary Nielsen automorphism** of the free group: `a_i ↦ a_i * a_j`, all other
generators fixed. -/
noncomputable def nielsenMove {d : ℕ} (i j : Fin d) (hij : i ≠ j) :
    FreeGroup (Fin d) ≃* FreeGroup (Fin d) where
  toFun := nielsenFwd i j
  invFun := nielsenBwd i j
  left_inv x := DFunLike.congr_fun (nielsenBwd_comp_nielsenFwd i j hij) x
  right_inv x := DFunLike.congr_fun (nielsenFwd_comp_nielsenBwd i j hij) x
  map_mul' := (nielsenFwd i j).map_mul

@[simp]
theorem nielsenMove_of_self {d : ℕ} {i j : Fin d} (hij : i ≠ j) :
    nielsenMove i j hij (FreeGroup.of i) = FreeGroup.of i * FreeGroup.of j := by
  rw [show nielsenMove i j hij (FreeGroup.of i) = nielsenFwd i j (FreeGroup.of i) from rfl,
    nielsenFwd_of_self]

@[simp]
theorem nielsenMove_of_ne {d : ℕ} {i j k : Fin d} (hij : i ≠ j) (hk : k ≠ i) :
    nielsenMove i j hij (FreeGroup.of k) = FreeGroup.of k := by
  rw [show nielsenMove i j hij (FreeGroup.of k) = nielsenFwd i j (FreeGroup.of k) from rfl,
    nielsenFwd_of_ne hk]

/-- **The elementary Nielsen move induces the transvection.**  Passing to the mod-`2`
abelianisation, `a_i ↦ a_i * a_j` becomes the transvection `1 + single j i 1`. -/
theorem alphaRed_nielsenMove {d : ℕ} {i j : Fin d} (hij : i ≠ j) :
    (alphaRed d).comp (nielsenMove i j hij).toMonoidHom
      = (matHom d (Matrix.transvection j i 1)).comp (alphaRed d) := by
  refine FreeGroup.ext_hom _ _ fun k => ?_
  simp only [MonoidHom.comp_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe]
  by_cases hk : k = i
  · subst hk
    rw [nielsenMove_of_self, map_mul]
    simp only [alphaRed_of, matHom_apply, transvection_mulVec_single hij k, ↓reduceIte]
    rw [ofAdd_add]
  · rw [nielsenMove_of_ne hij hk, alphaRed_of, matHom_apply, transvection_mulVec_single hij k]
    simp only [hk, ↓reduceIte, add_zero]

end Work.RelatorRank.Gaschutz
