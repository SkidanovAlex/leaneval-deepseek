import Submission.Work.RelatorRank.Gaschutz.eq_of_normalClosure_sup_frattini_eq_top
import Mathlib.GroupTheory.Frattini

/-!
# `Work.RelatorRank.Gaschutz` -- normal generation is detected modulo the Frattini subgroup

**Namespace** `Work.RelatorRank.Gaschutz`; module
`Submission.Work.RelatorRank.Gaschutz.NormalGeneration`.

This module turns the relative Gaschütz non-generator property
(`Gaschutz.eq_of_normalClosure_sup_frattini_eq_top`) into the statement that is actually needed when
one counts *relations*: the minimal number of **normal generators** of a subgroup `R ≤ F` is the
minimal number of elements whose normal closure generates `R` **modulo the Frattini subgroup of `R`**.

## The mathematical content

For `R ≤ F` a normal subgroup of a group `F` and elements `x₁,…,x_s ∈ F`, the normal closure
`⟪x₁,…,x_s⟫` is a *normal* subgroup, so `⟪x⟫ = R` is a statement about normal closures.  The
classical Burnside--Gaschütz non-generator property says that a finitely generated normal subgroup
`R` is generated by `s` elements **iff** it is generated by `s` elements modulo the Frattini
subgroup `Φ(R) ⊆ R` (the intersection of the maximal subgroups of `R`): a set of elements that
generates `R` modulo `Φ(R)` is a non-generator, hence generates `R`.  This is exactly the
"Burnside/Nakayama" step that appears when one passes from a presentation to a relation-module
computation: it converts the presentation-theoretic number `relatorNumber R` into the
group-theoretic number of generators of `R ⧸ Φ(R)`, and it is the only part of the Gaschütz
dictionary `r(Γ) = dim_{𝔽₂} H²(Γ,𝔽₂)` that needs nothing but the group structure of `R`.

**What is missing** (see the `README.md` of this chapter): the passage from `R ⧸ Φ(R)` to
`H²(Γ,𝔽₂)` is *not* the Frattini quotient one needs when `R = ker(FreeGroup (Fin d) → Γ)` for a
pro-`2` group `Γ` (the relevant congruence is `R^2[R,R]` inside the *free pro-2* group, and
`R^2[R,R] ⊆ Φ(R)` fails for abstract `R`: the chapter's README records the machine-checkable
counterexample `R = 2ℤ ⊆ ℤ = F₁`).  So this module proves the group-theoretic half of Burnside's
basis theorem, and records that the passage to cohomology needs the free pro-`p` setting.

## Main declarations

* `frattiniImage R` : the image of `frattini R` in `F` (`Φ(R)` viewed inside `F`);
* `eq_of_sup_frattiniImage_eq_top` : the non-generator property for normal closures;
* `normalClosure_eq_iff_sup_frattiniImage_eq_top` : `⟪x⟫ = R ↔ ⟪x⟫ · Φ(R) = R`;
* `relatorNumber R` : the minimal number of normal generators of `R`;
* `relatorNumber_eq_sInf_frattiniImage` : `relatorNumber` computed modulo `Φ(R)`;
* `relatorNumber_le_of_sup_frattiniImage_eq_top` : the Burnside corollary in the form used by
  the bridge (`s` generators modulo `Φ(R)` give `s` normal generators of `R`).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank.Gaschutz

open Subgroup

variable {F : Type*} [Group F]

/-- `Φ(R)` viewed as a subgroup of the ambient group `F`: the image of the Frattini subgroup of `R`
(the intersection of the maximal subgroups of `R`) along `R ↪ F`. -/
def frattiniImage (R : Subgroup F) : Subgroup F := Subgroup.map R.subtype (frattini R)

/-- `Φ(R) ≤ R`. -/
theorem frattiniImage_le (R : Subgroup F) : frattiniImage R ≤ R := Subgroup.map_subtype_le _

/-- **The non-generator property for normal closures.**  If `x ⊆ R` and the normal closure of `x`
together with `Φ(R)` is all of `R`, then the normal closure of `x` is all of `R`; i.e. `x`
generates `R` as a normal subgroup. -/
theorem eq_of_sup_frattiniImage_eq_top (R : Subgroup F) [Group.FG R] [R.Normal] {s : Set F}
    (hs : s ⊆ R) (h : Subgroup.normalClosure s ⊔ frattiniImage R = R) :
    Subgroup.normalClosure s = R :=
  eq_of_normalClosure_sup_frattini_eq_top R (Subgroup.normalClosure s)
    (Subgroup.normalClosure_le_normal hs) h

/-- **Normal generation is detected modulo the Frattini subgroup.**  For a finitely generated
normal subgroup `R ≤ F` and a subset `x ⊆ R`, the normal closure of `x` is `R` if and only if it
generates `R` modulo `Φ(R)`. -/
theorem normalClosure_eq_iff_sup_frattiniImage_eq_top (R : Subgroup F) [Group.FG R] [R.Normal]
    {s : Set F} (hs : s ⊆ R) :
    Subgroup.normalClosure s = R ↔ Subgroup.normalClosure s ⊔ frattiniImage R = R := by
  refine ⟨fun h => ?_, fun h => eq_of_sup_frattiniImage_eq_top R hs h⟩
  rw [h]
  exact sup_eq_left.mpr (frattiniImage_le R)

/-- **The relator number of a subgroup.**  The minimal number of *normal* generators of `R`: the
least `s` for which there are `x : Fin s → F` with `⟪x⟫ = R` (`sInf`, hence `0` if there is no such
finite family).  For `R = ker (FreeGroup.lift gen)` this is the least number of relators of the
presentation `⟨gen⟩`, i.e. the quantity that the bridge of this chapter has to show is independent
of the generating family `gen`. -/
noncomputable def relatorNumber (R : Subgroup F) : ℕ :=
  sInf {s : ℕ | ∃ x : Fin s → F, Subgroup.normalClosure (Set.range x) = R}

/-- A family with `⟪x⟫ = R` gives the bound `relatorNumber R ≤ s`. -/
theorem relatorNumber_le_of_normalClosure_eq (R : Subgroup F) {s : ℕ} (x : Fin s → F)
    (h : Subgroup.normalClosure (Set.range x) = R) : relatorNumber R ≤ s :=
  Nat.sInf_le ⟨x, h⟩

/-- Conversely, the relator number is attained, provided a finite normal generating set exists. -/
theorem exists_normalClosure_eq_relatorNumber (R : Subgroup F)
    (h : ∃ s : ℕ, ∃ x : Fin s → F, Subgroup.normalClosure (Set.range x) = R) :
    ∃ x : Fin (relatorNumber R) → F, Subgroup.normalClosure (Set.range x) = R :=
  Nat.sInf_mem h

/-- **The relator number is computed modulo the Frattini subgroup**: it is the least number of
elements whose normal closure generates `R` modulo `Φ(R)`. -/
theorem relatorNumber_eq_sInf_frattiniImage (R : Subgroup F) [Group.FG R] [R.Normal] :
    relatorNumber R =
      sInf {s : ℕ | ∃ x : Fin s → F,
        Subgroup.normalClosure (Set.range x) ⊔ frattiniImage R = R} := by
  have hset : {s : ℕ | ∃ x : Fin s → F, Subgroup.normalClosure (Set.range x) = R} =
      {s : ℕ | ∃ x : Fin s → F,
        Subgroup.normalClosure (Set.range x) ⊔ frattiniImage R = R} := by
    ext s
    refine ⟨fun hx => ?_, fun hx => ?_⟩
    · obtain ⟨x, hx'⟩ := hx
      exact ⟨x, by rw [hx']; exact sup_eq_left.mpr (frattiniImage_le R)⟩
    · obtain ⟨x, hx'⟩ := hx
      have hle : Subgroup.normalClosure (Set.range x) ≤ R :=
        (le_sup_left : Subgroup.normalClosure (Set.range x) ≤
          Subgroup.normalClosure (Set.range x) ⊔ frattiniImage R).trans_eq hx'
      exact ⟨x, eq_of_sup_frattiniImage_eq_top R
        (fun y hy => hle (Subgroup.subset_normalClosure hy)) hx'⟩
  simp only [relatorNumber, hset]

/-- **Burnside's corollary in the form used by the bridge.**  If `x₁,…,x_s ∈ F` generate the
finitely generated normal subgroup `R` modulo `Φ(R)`, then `⟪x₁,…,x_s⟫ = R`; in particular
`R` has at most `s` normal generators. -/
theorem relatorNumber_le_of_sup_frattiniImage_eq_top (R : Subgroup F) [Group.FG R] [R.Normal]
    {s : ℕ} (x : Fin s → F) (h : Subgroup.normalClosure (Set.range x) ⊔ frattiniImage R = R) :
    relatorNumber R ≤ s := by
  have hle : Subgroup.normalClosure (Set.range x) ≤ R :=
    (le_sup_left : Subgroup.normalClosure (Set.range x) ≤
      Subgroup.normalClosure (Set.range x) ⊔ frattiniImage R).trans_eq h
  exact relatorNumber_le_of_normalClosure_eq R x
    (eq_of_sup_frattiniImage_eq_top R (fun y hy => hle (Subgroup.subset_normalClosure hy)) h)

end Work.RelatorRank.Gaschutz
