import Mathlib
import Submission.Work.RelatorRank.ProPFrattini

/-!
# The non-generator property of the `p`-Frattini subgroup of a pro-`p` group

**Namespace** `Work.RelatorRank.ProPFrattini`; module
`Submission.Work.RelatorRank.ProPFrattini.eq_top_of_sup_pFrattini_eq_top`.

`pFrattini p Γ` is the closure of the subgroup generated by the `p`-th powers and the
commutators of `Γ` (see `Submission.Work.RelatorRank.ProPFrattini`).  For a pro-`p` group
this is the Frattini subgroup, i.e. the intersection of the open maximal subgroups, and its
elements are *non-generators*: a closed subgroup `H` with `H · Φ(Γ) = Γ` is all of `Γ`.

The proof given here is the elementary one, passing to finite quotients:

* for an open normal subgroup `U` of `Γ`, the quotient `Q = Γ ⧸ U` is a finite `p`-group and
  the image of `pFrattini p Γ` lands in the Frattini subgroup `Φ(Q) = frattini Q` (the
  intersection of the maximal subgroups, as defined in `Mathlib.GroupTheory.Frattini`);
* in a finite group, a subgroup `K` with `K ⊔ Φ(Q) = ⊤` is everything
  (`frattini_nongenerating`), because `Φ(Q)` lies in every maximal subgroup and the subgroup
  lattice of a finite group is coatomic;
* hence the image of `H` in `Γ ⧸ U` is everything, i.e. `H ⊔ U = ⊤`, for every open normal
  `U`; since every open subgroup of `Γ` contains an open normal one, that forces every open
  subgroup containing `H` to be `Γ`, and a closed subgroup of a profinite group is the
  intersection of the open subgroups containing it.

The only genuine group theory used is the classical fact that in a finite `p`-group every
maximal subgroup has index `p` (and is normal): the quotient by a maximal subgroup is a
simple `p`-group, hence abelian (its centre is a nontrivial normal subgroup), hence of prime
order.  Normality of maximal subgroups is available from
`Group.isNilpotent_of_finite_tfae`, and `IsPGroup.isNilpotent`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank.ProPFrattini

open Subgroup

/-! ## The finite `p`-group facts -/

/-- A maximal subgroup of a finite `p`-group is normal: it is normal in every finite nilpotent
group (`Group.isNilpotent_of_finite_tfae`), and finite `p`-groups are nilpotent. -/
theorem normal_of_isCoatom_of_isPGroup {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (hQ : IsPGroup p Q) {M : Subgroup Q} (hM : IsCoatom M) : M.Normal :=
  ((Group.isNilpotent_of_finite_tfae (G := Q)).out 1 3 rfl rfl).mp hQ.isNilpotent M hM

/-- The quotient of a finite `p`-group by a maximal subgroup is a simple group: any normal
subgroup of the quotient is the image of a normal subgroup of `Q` containing `M`, hence
trivial or everything by maximality of `M`. -/
theorem isSimpleGroup_quotient_of_isCoatom {Q : Type*} [Group Q] [Finite Q] {p : ℕ}
    [Fact p.Prime] (hQ : IsPGroup p Q) {M : Subgroup Q} [M.Normal] (hM : IsCoatom M) :
    IsSimpleGroup (Q ⧸ M) := by
  have hnt : Nontrivial (Q ⧸ M) := by
    obtain ⟨x, -, hxM⟩ := SetLike.exists_of_lt hM.lt_top
    refine ⟨1, QuotientGroup.mk' M x, fun h => hxM ?_⟩
    rw [← QuotientGroup.ker_mk' M, MonoidHom.mem_ker]
    exact h.symm
  refine { toNontrivial := hnt, eq_bot_or_eq_top_of_normal := fun L hL => ?_ }
  by_cases hLb : L = ⊥
  · exact Or.inl hLb
  right
  obtain ⟨z, hzL, hz1⟩ := SetLike.exists_of_lt (bot_lt_iff_ne_bot.mpr hLb)
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective M z
  have hxM : x ∉ M := by
    intro hx
    refine hz1 ?_
    rw [← QuotientGroup.ker_mk' M, MonoidHom.mem_ker] at hx
    exact hx
  have hcomap : Subgroup.comap (QuotientGroup.mk' M) L = ⊤ := by
    refine hM.2 _ (lt_of_le_of_ne ?_ ?_)
    · intro y hy
      rw [Subgroup.mem_comap]
      have hy1 : (QuotientGroup.mk' M) y = 1 := by
        rw [← QuotientGroup.ker_mk' M, MonoidHom.mem_ker] at hy
        exact hy
      rw [hy1]
      exact L.one_mem
    · intro heq
      refine hxM ?_
      have hx' : x ∈ Subgroup.comap (QuotientGroup.mk' M) L := by
        rw [Subgroup.mem_comap]; exact hzL
      exact heq ▸ hx'
  rw [← Subgroup.map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective M) L, hcomap,
    Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective M)]

/-- The quotient of a finite `p`-group by a maximal subgroup is commutative: its centre is a
nontrivial normal subgroup (`IsPGroup.bot_lt_center`), hence everything. -/
theorem isMulCommutative_quotient_of_isCoatom {Q : Type*} [Group Q] [Finite Q] {p : ℕ}
    [Fact p.Prime] (hQ : IsPGroup p Q) {M : Subgroup Q} [M.Normal] (hM : IsCoatom M) :
    IsMulCommutative (Q ⧸ M) := by
  haveI : IsSimpleGroup (Q ⧸ M) := isSimpleGroup_quotient_of_isCoatom hQ hM
  have hbot : ⊥ < Subgroup.center (Q ⧸ M) := IsPGroup.bot_lt_center (hQ.to_quotient M)
  have hZ : Subgroup.center (Q ⧸ M) = ⊤ :=
    (Subgroup.Normal.eq_bot_or_eq_top (H := Subgroup.center (Q ⧸ M))
      (inferInstance : (Subgroup.center (Q ⧸ M)).Normal)).resolve_left (ne_of_gt hbot)
  exact Subgroup.center_eq_top_iff.mp hZ

/-- The quotient of a finite `p`-group by a maximal subgroup has order `p`: it is a simple
commutative group, hence of prime order by `Group.is_simple_iff_prime_card`, and the order is
a power of `p` and different from `1`. -/
theorem card_quotient_of_isCoatom {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (hQ : IsPGroup p Q) {M : Subgroup Q} [M.Normal] (hM : IsCoatom M) :
    Nat.card (Q ⧸ M) = p := by
  haveI : IsSimpleGroup (Q ⧸ M) := isSimpleGroup_quotient_of_isCoatom hQ hM
  haveI : IsMulCommutative (Q ⧸ M) := isMulCommutative_quotient_of_isCoatom hQ hM
  have hprime : Nat.Prime (Nat.card (Q ⧸ M)) := (Group.is_simple_iff_prime_card).mp inferInstance
  have hdv : p ∣ Nat.card (Q ⧸ M) :=
    (IsPGroup.card_eq_or_dvd (hQ.to_quotient M)).resolve_left (by
      intro hcard
      exact not_subsingleton (Q ⧸ M) ((Nat.card_eq_one_iff_unique.mp hcard).1))
  rcases hprime.eq_one_or_self_of_dvd p hdv with h1 | h1
  · exact absurd h1 (Nat.Prime.ne_one (Fact.out : Nat.Prime p))
  · exact h1.symm

/-- In a finite `p`-group, every `p`-th power lies in the Frattini subgroup: for a maximal
subgroup `M` the quotient `Q ⧸ M` has order `p`, so the order of the image of `x` divides `p`
and `x ^ p ∈ M`. -/
theorem pow_mem_frattini_of_isPGroup {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (hQ : IsPGroup p Q) (x : Q) : x ^ p ∈ frattini Q := by
  rw [show x ^ p ∈ frattini Q ↔ ∀ M : Subgroup Q, IsCoatom M → x ^ p ∈ M by
    simp [frattini, Order.radical]]
  intro M hM
  haveI : M.Normal := normal_of_isCoatom_of_isPGroup hQ hM
  have hcard : Nat.card (Q ⧸ M) = p := card_quotient_of_isCoatom hQ hM
  have hdvd : orderOf ((QuotientGroup.mk' M) x) ∣ p := by
    rw [← hcard]; exact orderOf_dvd_natCard _
  have hpow : (QuotientGroup.mk' M) x ^ p = 1 := (orderOf_dvd_iff_pow_eq_one).mp hdvd
  have h1 : (QuotientGroup.mk' M) (x ^ p) = 1 := by rw [map_pow]; exact hpow
  have h2 : x ^ p ∈ (QuotientGroup.mk' M).ker := MonoidHom.mem_ker.mpr h1
  rwa [QuotientGroup.ker_mk'] at h2

/-- In a finite `p`-group, every commutator lies in the Frattini subgroup: for a maximal
subgroup `M` the quotient `Q ⧸ M` is commutative, so `⁅Q, Q⁆ ≤ M`. -/
theorem commutator_le_frattini_of_isPGroup {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (hQ : IsPGroup p Q) : _root_.commutator Q ≤ frattini Q := by
  rw [show _root_.commutator Q ≤ frattini Q ↔
      ∀ M : Subgroup Q, IsCoatom M → _root_.commutator Q ≤ M by
    simp [frattini, Order.radical]]
  intro M hM
  haveI : M.Normal := normal_of_isCoatom_of_isPGroup hQ hM
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp
    (isMulCommutative_quotient_of_isCoatom hQ hM)

/-! ## The quotient criterion -/

/-- The image of a subgroup `K` under the quotient map `Γ →* Γ ⧸ U` is everything if and only
if `K · U = Γ`. -/
theorem map_mk'_eq_top_iff {Γ : Type*} [Group Γ] (U : Subgroup Γ) [U.Normal] (K : Subgroup Γ) :
    Subgroup.map (QuotientGroup.mk' U) K = ⊤ ↔ K ⊔ U = ⊤ := by
  constructor
  · intro h
    have h1 := congrArg (Subgroup.comap (QuotientGroup.mk' U)) h
    rw [Subgroup.comap_top] at h1
    rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk'] at h1
    exact h1
  · intro h
    have h1 : Subgroup.comap (QuotientGroup.mk' U) (Subgroup.map (QuotientGroup.mk' U) K)
        = Subgroup.comap (QuotientGroup.mk' U) ⊤ := by
      rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk', h, Subgroup.comap_top]
    exact Subgroup.comap_injective (QuotientGroup.mk'_surjective U) h1

/-! ## The non-generator property -/

/-- **The non-generator property of `pFrattini` for a pro-`p` group.**  If `Γ` is a profinite
group all of whose finite quotients by open normal subgroups are `p`-groups, and `H` is a
closed subgroup with `H ⊔ pFrattini p Γ = ⊤`, then `H = ⊤`. -/
theorem eq_top_of_sup_pFrattini_eq_top {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] [CompactSpace Γ] [T2Space Γ] [TotallyDisconnectedSpace Γ] {p : ℕ}
    [Fact p.Prime] (hp : ∀ U : OpenNormalSubgroup Γ, IsPGroup p (Γ ⧸ U.toSubgroup))
    {H : Subgroup Γ} (hH : IsClosed (H : Set Γ)) (h : H ⊔ pFrattini p Γ = ⊤) : H = ⊤ := by
  -- Step 1: for every open normal `U`, the image of `H` in `Γ ⧸ U` is everything.
  have key : ∀ U : OpenNormalSubgroup Γ, H ⊔ U.toSubgroup = ⊤ := by
    intro U
    haveI : Finite (Γ ⧸ U.toSubgroup) := inferInstance
    have hmk_cont : Continuous (QuotientGroup.mk' U.toSubgroup) := by
      rw [QuotientGroup.coe_mk']
      exact QuotientGroup.continuous_mk
    have himg : Subgroup.map (QuotientGroup.mk' U.toSubgroup) (pFrattini p Γ) ≤
        frattini (Γ ⧸ U.toSubgroup) := by
      rw [Subgroup.map_le_iff_le_comap]
      refine pFrattini_le_of_closed p ?_ ?_ ?_
      · -- the comap of the Frattini subgroup is closed (the quotient is discrete)
        haveI : DiscreteTopology (Γ ⧸ U.toSubgroup) := QuotientGroup.discreteTopology U.isOpen
        rw [Subgroup.coe_comap]
        exact IsClosed.preimage hmk_cont (isClosed_discrete _)
      · -- `p`-th powers land in the Frattini subgroup of the quotient
        intro x
        rw [Subgroup.mem_comap, map_pow]
        exact pow_mem_frattini_of_isPGroup (hp U) _
      · -- commutators land in the Frattini subgroup of the quotient
        intro x hx
        rw [Subgroup.mem_comap]
        have hmap : Subgroup.map (QuotientGroup.mk' U.toSubgroup) (_root_.commutator Γ) ≤
            _root_.commutator (Γ ⧸ U.toSubgroup) := by
          change Subgroup.map (QuotientGroup.mk' U.toSubgroup)
              ⁅(⊤ : Subgroup Γ), (⊤ : Subgroup Γ)⁆ ≤
            ⁅(⊤ : Subgroup (Γ ⧸ U.toSubgroup)), (⊤ : Subgroup (Γ ⧸ U.toSubgroup))⁆
          rw [Subgroup.map_commutator,
            Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective U.toSubgroup)]
        exact commutator_le_frattini_of_isPGroup (hp U)
          (hmap (Subgroup.mem_map.mpr ⟨x, hx, rfl⟩))
    have hsup : Subgroup.map (QuotientGroup.mk' U.toSubgroup) H ⊔ frattini (Γ ⧸ U.toSubgroup)
        = ⊤ := by
      have h1 := congrArg (Subgroup.map (QuotientGroup.mk' U.toSubgroup)) h
      rw [Subgroup.map_sup,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h1
      rw [eq_top_iff, ← h1]
      exact sup_le_sup_left himg _
    have hmapH : Subgroup.map (QuotientGroup.mk' U.toSubgroup) H = ⊤ :=
      frattini_nongenerating hsup
    exact (map_mk'_eq_top_iff U.toSubgroup H).mp hmapH
  -- Step 2: every open subgroup containing `H` is everything.
  have key2 : ∀ N : Subgroup Γ, IsOpen (N : Set Γ) → H ≤ N → N = ⊤ := by
    intro N hNopen hHN
    obtain ⟨U, hU⟩ :=
      ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hNopen (hHN (one_mem H))
    rw [eq_top_iff]
    calc (⊤ : Subgroup Γ) = H ⊔ U.toSubgroup := (key U).symm
      _ ≤ N := sup_le hHN (fun x hx => hU hx)
  -- Step 3: a closed subgroup of a profinite group is the intersection of the open subgroups
  -- containing it, and all of those are `⊤`.
  have hsInf : H = sInf {N : Subgroup Γ | IsOpen (N : Set Γ) ∧ H ≤ N} := by
    simpa using ProfiniteGrp.closedSubgroup_eq_sInf_open (G := Γ) (⟨H, hH⟩ : ClosedSubgroup Γ)
  have hgoal : (sInf {N : Subgroup Γ | IsOpen (N : Set Γ) ∧ H ≤ N}) = ⊤ := by
    refine le_antisymm le_top ?_
    refine le_sInf ?_
    rintro N ⟨hNo, hHN⟩
    exact le_of_eq (key2 N hNo hHN).symm
  rw [hsInf, hgoal]

end Work.RelatorRank.ProPFrattini
