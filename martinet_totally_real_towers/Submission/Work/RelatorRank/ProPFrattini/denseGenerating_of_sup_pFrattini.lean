import Mathlib
import Submission.Work.RelatorRank.ProPFrattini.eq_top_of_sup_pFrattini_eq_top
import Submission.Work.RelatorRank.ProPFrattini.pFrattini_normal

/-!
# `pFrattini`-non-generators are dense generators

**Namespace** `Work.RelatorRank.ProPFrattini`; module
`Submission.Work.RelatorRank.ProPFrattini.denseGenerating_of_sup_pFrattini`.

The sibling module `eq_top_of_sup_pFrattini_eq_top` proves the non-generator property of the
`p`-Frattini subgroup of a pro-`p` group `Γ` for **closed** subgroups `H`:

  `H ⊔ pFrattini p Γ = ⊤ → H = ⊤`.

The statement proved here removes the closedness hypothesis at the cost of replacing `H` by a
closure: if the *closure* of `H ⊔ pFrattini p Γ` is everything then `H` is already dense.  Taking
`H = Subgroup.closure (Set.range gen)` this is exactly the statement that a `pFrattini`-surplus
generating family densely generates.

The proof is short but needs one genuinely topological input, namely that the join of two closed
subgroups is closed when one of them is normal:

* `K := (Subgroup.closure (Set.range gen)).topologicalClosure` is closed, hence compact (Γ is
  compact);
* `pFrattini p Γ` is closed (a closure) and normal (`pFrattini_normal`);
* the carrier of `K ⊔ pFrattini p Γ` is the pointwise product `K * pFrattini p Γ`
  (`Subgroup.mul_normal`), which is closed because it is the continuous image of the compact set
  `K × pFrattini p Γ` (`IsClosed.mul_left_of_isCompact`).

Consequently `⊤ = closure (H ⊔ pFrattini p Γ) ≤ K ⊔ pFrattini p Γ = ⊤`, so `K ⊔ pFrattini p Γ = ⊤`,
and the non-generator property yields `K = ⊤`.
-/

set_option linter.style.haveILetI false

namespace Work.RelatorRank.ProPFrattini

/-- **A `pFrattini`-surplus generating family densely generates.**  If `Γ` is a pro-`p` group (in the
sense that all its finite quotients by open normal subgroups are `p`-groups) and the topological
closure of `⟪gen⟫ · pFrattini p Γ` is all of `Γ`, then `gen` densely generates `Γ`. -/
theorem denseGenerating_of_sup_pFrattini {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] [CompactSpace Γ] [T2Space Γ] [TotallyDisconnectedSpace Γ] {p : ℕ}
    [Fact p.Prime] (hp : ∀ U : OpenNormalSubgroup Γ, IsPGroup p (Γ ⧸ U.toSubgroup)) {ι : Type*}
    (gen : ι → Γ)
    (h : (Subgroup.closure (Set.range gen) ⊔ pFrattini p Γ).topologicalClosure = ⊤) :
    DenseGenerating gen := by
  haveI hPn : (pFrattini p Γ).Normal := pFrattini_normal p
  -- `pFrattini p Γ` is a topological closure, hence closed.
  have hPclosed : IsClosed (pFrattini p Γ : Set Γ) := by
    rw [pFrattini]
    exact Subgroup.isClosed_topologicalClosure _
  -- `K`, the closure of the subgroup generated by `gen`, is closed, hence compact.
  have hKclosed : IsClosed
      (((Subgroup.closure (Set.range gen)).topologicalClosure : Subgroup Γ) : Set Γ) :=
    Subgroup.isClosed_topologicalClosure _
  -- The join `K ⊔ pFrattini p Γ` is closed: its carrier is the product of the compact set `K` and
  -- the closed normal subgroup `pFrattini p Γ`.
  have hsup_closed : IsClosed
      ((((Subgroup.closure (Set.range gen)).topologicalClosure : Subgroup Γ) ⊔ pFrattini p Γ :
        Subgroup Γ) : Set Γ) := by
    rw [Subgroup.mul_normal]
    exact IsClosed.mul_left_of_isCompact hPclosed hKclosed.isCompact
  -- Hence it is everything, by the hypothesis.
  have htop : ((Subgroup.closure (Set.range gen)).topologicalClosure ⊔ pFrattini p Γ :
      Subgroup Γ) = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← h]
    exact Subgroup.topologicalClosure_minimal _
      (sup_le (le_trans (Subgroup.le_topologicalClosure _) le_sup_left) le_sup_right) hsup_closed
  -- The non-generator property of `pFrattini` finishes the job.
  exact eq_top_of_sup_pFrattini_eq_top hp hKclosed htop

end Work.RelatorRank.ProPFrattini
