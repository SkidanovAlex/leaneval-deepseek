import Mathlib
import Submission.Work.RelatorRank.ProPFrattini

/-!
# Normality of the `p`-Frattini subgroup

The `p`-Frattini subgroup `pFrattini p Γ` of a topological group is the topological closure of the
abstract subgroup generated by the `p`-th powers and the commutators.  Both generators are stable
under conjugation (`(c * g * c⁻¹) ^ p = c * g ^ p * c⁻¹`, and `commutator Γ` is normal), hence so
are the abstract subgroup they generate and its topological closure.  Consequently `pFrattini p Γ`
is a normal subgroup -- the statement proved here.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.RelatorRank.ProPFrattini

open Work.RelatorRank

/-- The generating set of the `p`-Frattini subgroup is stable under conjugation. -/
theorem conj_mem_pFrattiniGenerators {Γ : Type*} [Group Γ] (p : ℕ) (c a : Γ)
    (ha : a ∈ (Set.range fun g : Γ => g ^ p) ∪ ((commutator Γ : Subgroup Γ) : Set Γ)) :
    c * a * c⁻¹ ∈ (Set.range fun g : Γ => g ^ p) ∪ ((commutator Γ : Subgroup Γ) : Set Γ) := by
  rcases ha with ⟨g, rfl⟩ | ha
  · exact Or.inl ⟨c * g * c⁻¹, conj_pow⟩
  · exact Or.inr ((inferInstance : (commutator Γ).Normal).conj_mem a ha c)

/-- The `p`-Frattini subgroup of a topological group is normal: it is the topological closure of a
normal subgroup. -/
theorem pFrattini_normal {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    (p : ℕ) : (pFrattini p Γ).Normal := by
  rw [pFrattini]
  set S : Set Γ := (Set.range fun g : Γ => g ^ p) ∪ ((commutator Γ : Subgroup Γ) : Set Γ)
  have hS : ∀ (c a : Γ), a ∈ S → c * a * c⁻¹ ∈ S := conj_mem_pFrattiniGenerators p
  -- the generating set is conjugation stable, so its normal closure is its closure
  have hconj : Group.conjugatesOfSet S ⊆ S := by
    intro x hx
    rw [Group.mem_conjugatesOfSet_iff] at hx
    obtain ⟨a, ha, h⟩ := hx
    obtain ⟨c, rfl⟩ := isConj_iff.1 h
    exact hS c a ha
  have hnc : Subgroup.normalClosure S = Subgroup.closure S := by
    rw [Subgroup.normalClosure]
    exact le_antisymm (Subgroup.closure_mono hconj)
      (Subgroup.closure_mono Group.subset_conjugatesOfSet)
  haveI : (Subgroup.closure S).Normal := by
    rw [← hnc]
    infer_instance
  exact Subgroup.is_normal_topologicalClosure _

end Work.RelatorRank.ProPFrattini
