import Submission.Work.RelatorRank.Bridge

/-!
# `Work.RelatorRank` -- the `p`-Frattini subgroup of a pro-`p` group

**Namespace** `Work.RelatorRank`; module `Submission.Work.RelatorRank.ProPFrattini`.

For a pro-`p` group the *Frattini subgroup* is the intersection of the open maximal subgroups; it is
also the closure of the subgroup generated by `p`-th powers and commutators, and it consists of
*non-generators*: a closed subgroup `H` with `H · Φ(Γ) = Γ` is all of `Γ` (Burnside's basis theorem /
Nakayama's lemma for pro-`p` groups).  This is the ingredient that makes the *generator* rank of a
pro-`p` group computable on the Frattini quotient `Γ ⧸ Φ(Γ)`, and it is the first half of the
"Burnside/Nakayama" content named in `Submission/PLAN.md` §21.

`pFrattini p Γ` is defined here as `closure (⟪{g ^ p} ∪ commutator Γ⟫)`.  This module proves

* `subset_pFrattini`, `pow_mem_pFrattini`, `commutator_le_pFrattini`;
* `pFrattini_le_of_closed`: a closed subgroup containing all `p`-th powers and all commutators
  contains `pFrattini p Γ`.

The two deeper statements -- normality of `pFrattini`, and the non-generator property for pro-`p`
groups -- are delegated to `Submission/Work/RelatorRank/ProPFrattini/`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank

variable {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]

/-- **The `p`-Frattini subgroup** of a topological group `Γ`: the topological closure of the
subgroup generated by the `p`-th powers and the commutators.  For a pro-`p` group this is the
Frattini subgroup, i.e. the intersection of the open maximal subgroups. -/
def pFrattini (p : ℕ) (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] :
    Subgroup Γ :=
  (Subgroup.closure ((Set.range fun g : Γ => g ^ p) ∪ ((commutator Γ : Subgroup Γ) : Set Γ))).topologicalClosure

/-- The generating set of `pFrattini` is contained in it. -/
theorem subset_pFrattini (p : ℕ) :
    ((Set.range fun g : Γ => g ^ p) ∪ ((commutator Γ : Subgroup Γ) : Set Γ))
      ⊆ (pFrattini p Γ : Set Γ) := by
  intro x hx
  rw [pFrattini]
  exact Subgroup.le_topologicalClosure _ (Subgroup.subset_closure hx)

/-- Every `p`-th power lies in the `p`-Frattini subgroup. -/
theorem pow_mem_pFrattini (p : ℕ) (g : Γ) : g ^ p ∈ pFrattini p Γ :=
  subset_pFrattini p (Set.mem_union_left _ ⟨g, rfl⟩)

/-- Every commutator lies in the `p`-Frattini subgroup. -/
theorem commutator_le_pFrattini (p : ℕ) : commutator Γ ≤ pFrattini p Γ :=
  fun _ hx => subset_pFrattini p (Set.mem_union_right _ hx)

/-- A closed subgroup containing all `p`-th powers and all commutators contains the `p`-Frattini
subgroup. -/
theorem pFrattini_le_of_closed (p : ℕ) {N : Subgroup Γ} (hN : IsClosed (N : Set Γ))
    (hpow : ∀ g : Γ, g ^ p ∈ N) (hcomm : commutator Γ ≤ N) : pFrattini p Γ ≤ N := by
  rw [pFrattini]
  refine Subgroup.topologicalClosure_minimal _ ?_ hN
  rw [Subgroup.closure_le]
  rintro x (hx | hx)
  · obtain ⟨g, rfl⟩ := hx
    exact hpow g
  · exact hcomm hx

end Work.RelatorRank
