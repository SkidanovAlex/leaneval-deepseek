import Submission.Work.RelatorRank.ElementaryQuotient
import Submission.Work.RelatorRank.ProPFrattini.eq_top_of_sup_pFrattini_eq_top
import Submission.Work.RelatorRank.ProPFrattini.denseGenerating_of_sup_pFrattini

/-!
# `Work.RelatorRank` -- the vocabulary of pro-`p` groups

**Namespace** `Work.RelatorRank`; module `Submission.Work.RelatorRank.ProP`.

The bridge of this chapter is about *finitely generated pro-`p` groups*.  This module fixes that
vocabulary (`IsProPGroup`, `IsFgProPGroup`) and restates the Burnside/Nakayama material of
`ProPFrattini.lean` in it.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false
set_option linter.unusedSectionVars false

namespace Work.RelatorRank

/-- **A pro-`p` group**: every finite continuous quotient `Γ ⧸ U` (with `U` an open normal
subgroup) is a finite `p`-group.  For a compact totally disconnected `Γ` this is the usual
definition of a pro-`p` group. -/
def IsProPGroup (p : ℕ) (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : Prop :=
  ∀ U : OpenNormalSubgroup Γ, IsPGroup p (Γ ⧸ U.toSubgroup)

/-- **A finitely generated pro-`p` group**: pro-`p` and admitting a finite dense generating
family. -/
def IsFgProPGroup (p : ℕ) (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : Prop :=
  IsProPGroup p Γ ∧ ∃ d : ℕ, HasDenseGeneratingFamily Γ d

theorem IsFgProPGroup.isProPGroup {p : ℕ} {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] (h : IsFgProPGroup p Γ) : IsProPGroup p Γ := h.1

theorem IsFgProPGroup.exists_hasDenseGeneratingFamily {p : ℕ} {Γ : Type*} [Group Γ]
    [TopologicalSpace Γ] [IsTopologicalGroup Γ] (h : IsFgProPGroup p Γ) :
    ∃ d : ℕ, HasDenseGeneratingFamily Γ d := h.2

/-- **Burnside/Nakayama for pro-`p` groups**, in the vocabulary of this chapter: a closed subgroup
`H` of a compact totally disconnected pro-`p` group with `H · Φ_p(Γ) = Γ` is all of `Γ`. -/
theorem eq_top_of_sup_pFrattini_of_isProPGroup {p : ℕ} [Fact p.Prime] {Γ : Type*} [Group Γ]
    [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ] [T2Space Γ]
    [TotallyDisconnectedSpace Γ] (hp : IsProPGroup p Γ) {H : Subgroup Γ}
    (hH : IsClosed (H : Set Γ)) (h : H ⊔ pFrattini p Γ = ⊤) : H = ⊤ :=
  Work.RelatorRank.ProPFrattini.eq_top_of_sup_pFrattini_eq_top hp hH h

/-- **Generation of a pro-`p` group is detected modulo its `p`-Frattini subgroup**: if the subgroup
generated by `gen` together with `pFrattini p Γ` is dense, then `gen` is dense generating. -/
theorem denseGenerating_of_sup_pFrattini_of_isProPGroup {p : ℕ} [Fact p.Prime] {Γ : Type*} [Group Γ]
    [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ] [T2Space Γ]
    [TotallyDisconnectedSpace Γ] (hp : IsProPGroup p Γ) {ι : Type*} (gen : ι → Γ)
    (h : (Subgroup.closure (Set.range gen) ⊔ pFrattini p Γ).topologicalClosure = ⊤) :
    DenseGenerating gen :=
  Work.RelatorRank.ProPFrattini.denseGenerating_of_sup_pFrattini hp gen h

end Work.RelatorRank

