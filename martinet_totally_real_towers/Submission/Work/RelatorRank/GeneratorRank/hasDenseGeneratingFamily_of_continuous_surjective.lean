import Mathlib
import Submission.Work.RelatorRank.Bridge

namespace Work.RelatorRank.GeneratorRank

/-- A continuous surjection of topological groups pushes a dense generating family forward: if
`Γ` has a dense generating family of size `d`, so does `Γ'`.

The image of the closure of the subgroup generated by the family is the closure of the subgroup
generated by the image family, and the image of a dense subgroup under a continuous surjection
is dense. -/
theorem hasDenseGeneratingFamily_of_continuous_surjective {Γ Γ' : Type*} [Group Γ]
    [TopologicalSpace Γ] [IsTopologicalGroup Γ] [Group Γ'] [TopologicalSpace Γ']
    [IsTopologicalGroup Γ'] (f : Γ →* Γ') (hf : Continuous f) (hsurj : Function.Surjective f)
    {d : ℕ} (hex : HasDenseGeneratingFamily Γ d) : HasDenseGeneratingFamily Γ' d := by
  obtain ⟨gen, hgen⟩ := hex
  refine ⟨f ∘ gen, ?_⟩
  rw [denseGenerating_iff] at hgen ⊢
  -- the closure of the subgroup generated by `f ∘ gen` is the image of the closure of the
  -- subgroup generated by `gen`
  have hcl : Subgroup.closure (Set.range (f ∘ gen))
      = (Subgroup.closure (Set.range gen)).map f := by
    rw [Set.range_comp, MonoidHom.map_closure]
  rw [hcl]
  exact DenseRange.topologicalClosure_map_subgroup hf hsurj.denseRange hgen

end Work.RelatorRank.GeneratorRank
