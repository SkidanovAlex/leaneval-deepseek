import Mathlib
import Submission.Work.RelatorRank.Consequences
import Submission.Work.RelatorRank.GeneratorRank.hasDenseGeneratingFamily_of_continuous_surjective

/-!
# `Work.RelatorRank.GeneratorRank.le_generatorRank_of_surjective_elementaryAbelian`

**Namespace** `Work.RelatorRank.GeneratorRank`; module
`Submission.Work.RelatorRank.GeneratorRank.le_generatorRank_of_surjective_elementaryAbelian`.

A continuous surjection `Γ ↠ (𝔽₂)^d` forces `d ≤ GeneratorRank Γ`: the elementary abelian quotient
of rank `d` needs at least `d` elements to generate it, and dense generating families push forward
along continuous surjections, so any dense generating family of `Γ` must have size `≥ d`.

The whole content of the proof is the *linear algebra* of the quotient: `(Fin d → Multiplicative
(ZMod 2))` is an `𝔽₂`-vector space of dimension `d` in multiplicative notation, so the subgroup
generated by `m` elements spans a subspace of dimension at most `m`; if that subgroup is all of
the group then `d ≤ m`.  The topology enters only through the (discreteness of the) topology in
which the quotient is generated -- and through the reduction `DenseGenerating` of a *discrete*
group to ordinary generation, which is `subgroup_closure_eq_top_of_denseGenerating_discrete`.
-/

namespace Work.RelatorRank.GeneratorRank

/-- **Dense generation in a discrete topological group is ordinary generation.**

`DenseGenerating gen` says that the topological closure of the subgroup generated by `gen` is
everything; in a discrete space every set is closed, so that closure is the subgroup itself. -/
lemma subgroup_closure_eq_top_of_denseGenerating_discrete {X : Type*} [Group X]
    [TopologicalSpace X] [IsTopologicalGroup X] [DiscreteTopology X] {ι : Type*} {g : ι → X}
    (h : DenseGenerating g) : Subgroup.closure (Set.range g) = ⊤ := by
  have hcl : (Subgroup.closure (Set.range g)).topologicalClosure = Subgroup.closure (Set.range g) := by
    apply SetLike.coe_injective
    rw [Subgroup.topologicalClosure_coe]
    exact closure_discrete _
  exact hcl.symm.trans h

/-- **The algebraic core.**  The elementary abelian `2`-group `(Fin d → Multiplicative (ZMod 2))`
-- that is, `(ℤ/2)^d` -- cannot be generated by fewer than `d` elements.

Viewing the group in additive notation as the `𝔽₂`-vector space `Fin d → ZMod 2` (via the
coordinatewise `Multiplicative.toAdd`), a generating family of size `m` spans a subspace of
dimension at most `m`; if the family generates, that span is everything, so
`d = finrank (Fin d → ZMod 2) ≤ m`. -/
lemma le_card_of_closure_eq_top_elementaryAbelian {m d : ℕ}
    (g : Fin m → (Fin d → Multiplicative (ZMod 2)))
    (h : Subgroup.closure (Set.range g) = ⊤) : d ≤ m := by
  classical
  -- the `𝔽₂`-span of the additive coordinates of the family
  let S : Submodule (ZMod 2) (Fin d → ZMod 2) :=
    Submodule.span (ZMod 2) (Set.range fun i : Fin m => fun j : Fin d => (g i j).toAdd)
  -- the subgroup of the target consisting of the elements whose coordinates lie in `S`
  let K : Subgroup (Fin d → Multiplicative (ZMod 2)) :=
    { carrier := {x | (fun j => (x j).toAdd) ∈ S}
      one_mem' := by
        change (fun j : Fin d => (1 : Multiplicative (ZMod 2)).toAdd) ∈ S
        simp only [toAdd_one]
        exact S.zero_mem
      mul_mem' := by
        intro x y hx hy
        simp only [Set.mem_ofPred_eq] at hx hy
        change (fun j : Fin d => (x j * y j).toAdd) ∈ S
        have hxy : (fun j : Fin d => (x j * y j).toAdd)
            = (fun j : Fin d => (x j).toAdd) + (fun j : Fin d => (y j).toAdd) := by
          funext j
          simp
        rw [hxy]
        exact S.add_mem hx hy
      inv_mem' := by
        intro x hx
        simp only [Set.mem_ofPred_eq] at hx
        change (fun j : Fin d => (x⁻¹ j).toAdd) ∈ S
        have hx' : (fun j : Fin d => ((x⁻¹) j).toAdd) = -(fun j : Fin d => (x j).toAdd) := by
          funext j
          simp
        rw [hx']
        exact S.neg_mem hx }
  -- every generator lies in `K`, so the subgroup it generates does too
  have hK : K = ⊤ := by
    have h1 : Subgroup.closure (Set.range g) ≤ K := by
      rw [Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      change (fun j : Fin d => (g i j).toAdd) ∈ S
      exact Submodule.subset_span ⟨i, rfl⟩
    rw [h] at h1
    exact top_le_iff.mp h1
  -- hence the span `S` is everything: every element is the coordinatewise `toAdd` of a group
  -- element, and *every* group element lies in `K`
  have hStop : S = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro x
    have hx : (fun j : Fin d => Multiplicative.ofAdd (x j)) ∈ K := by rw [hK]; trivial
    show x ∈ S
    exact hx
  -- `S` is spanned by `m` vectors
  have hfin : Module.finrank (ZMod 2) S ≤ m := by
    have h1 := finrank_range_le_card (R := ZMod 2) (M := (Fin d → ZMod 2))
      (fun i : Fin m => fun j : Fin d => (g i j).toAdd)
    rw [Fintype.card_fin] at h1
    simpa [S, Set.finrank] using h1
  calc d = Module.finrank (ZMod 2) (Fin d → ZMod 2) := by simp
    _ = Module.finrank (ZMod 2) (⊤ : Submodule (ZMod 2) (Fin d → ZMod 2)) := by rw [finrank_top]
    _ = Module.finrank (ZMod 2) S := by rw [hStop]
    _ ≤ m := hfin

/-- **The generator rank is at least the rank of an elementary abelian quotient.**

A continuous surjection `f : Γ ↠ (ℤ/2)^d` of topological groups forces `d ≤ GeneratorRank Γ`:
a dense generating family of `Γ` of size `m` pushes forward along `f` to one of `(ℤ/2)^d`, which
is discrete, hence generates it; and `(ℤ/2)^d` needs at least `d` generators. -/
theorem le_generatorRank_of_surjective_elementaryAbelian {Γ : Type*} [Group Γ]
    [TopologicalSpace Γ] [IsTopologicalGroup Γ] {d : ℕ}
    (f : Γ →* (Fin d → Multiplicative (ZMod 2))) (hf : Continuous f)
    (hsurj : Function.Surjective f) (hex : ∃ m : ℕ, HasDenseGeneratingFamily Γ m) :
    d ≤ GeneratorRank Γ := by
  obtain ⟨g, hg⟩ := hasDenseGeneratingFamily_of_continuous_surjective f hf hsurj
    (hasDenseGeneratingFamily_generatorRank hex)
  exact le_card_of_closure_eq_top_elementaryAbelian g
    (subgroup_closure_eq_top_of_denseGenerating_discrete hg)

end Work.RelatorRank.GeneratorRank
