import Mathlib
import Submission.Work.RelatorRank.ProP
import Submission.Work.RelatorRank.ProPFrattini.pFrattini_normal

/-!
# The Frattini quotient of a finitely generated pro-`2` group is an `𝔽₂`-vector space

**Namespace** `Work.RelatorRank.GeneratorRank`; module
`Submission.Work.RelatorRank.GeneratorRank.exists_card_frattiniQuotient_eq_two_pow`.

The quotient of a pro-`p` group by its `p`-Frattini subgroup is an elementary abelian `p`-group:
`pFrattini p Γ` is by definition the closure of the subgroup generated by the `p`-th powers and the
commutators, so in `Γ ⧸ pFrattini p Γ` every square is trivial and any two elements commute.  When
`Γ` admits a dense generating family of size `d`, that quotient is generated by the `d` images of
the family, hence is a finite elementary abelian `p`-group of order `p ^ k` with `k ≤ d`.  This
module proves the case `p = 2`:

`Work.RelatorRank.GeneratorRank.exists_card_frattiniQuotient_eq_two_pow`.

The three steps of the proof.

* `Φ := pFrattini 2 Γ` is closed and normal, and the quotient `Γ ⧸ Φ` is abelian
  (`commutator Γ ≤ Φ`) of exponent two (every square lies in `Φ`).  It is therefore an
  `𝔽₂`-vector space: the quotient carries a `ZMod 2`-module structure, obtained from the
  commutativity of the quotient alone, without introducing a second bundled group structure on
  `Γ ⧸ Φ`.
* The linear map `L : (Fin d → ZMod 2) →ₗ[ZMod 2] Additive (Γ ⧸ Φ)` sending the `i`-th standard
  basis vector to the image `b i` of `gen i` has finite image (`(Fin d → ZMod 2)` is finite), and
  that image is a subgroup containing the `b i`, so the subgroup `H` generated by the `b i` is
  finite.  `H` is dense in `Γ ⧸ Φ` -- the continuous surjection `Γ ↠ Γ ⧸ Φ` maps the dense
  subgroup generated by `gen` onto `H` -- and a finite subgroup of the `T₁` group `Γ ⧸ Φ` is
  closed, so `H = ⊤`.
* Hence the map `(Fin d → ZMod 2) → Γ ⧸ Φ`, `x ↦ (L x).toMul`, is surjective, giving
  `Nat.card (Γ ⧸ Φ) ≤ 2 ^ d`; and `Γ ⧸ Φ` is a finite `2`-group, so its cardinality is a power
  of `2` by `IsPGroup.iff_card`, whose exponent is at most `d`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.dupNamespace false

namespace Work.RelatorRank.GeneratorRank

open scoped IsMulCommutative

theorem exists_card_frattiniQuotient_eq_two_pow {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] [CompactSpace Γ] [T2Space Γ] [TotallyDisconnectedSpace Γ]
    (hp : IsProPGroup 2 Γ) {d : ℕ} (gen : Fin d → Γ) (hgen : DenseGenerating gen) :
    ∃ k : ℕ, k ≤ d ∧ Nat.card (Γ ⧸ (pFrattini 2 Γ)) = 2 ^ k := by
  classical
  set Φ : Subgroup Γ := pFrattini 2 Γ with hΦdef
  haveI hΦn : Φ.Normal := ProPFrattini.pFrattini_normal 2
  haveI hΦcl : IsClosed (Φ : Set Γ) := by
    rw [hΦdef, pFrattini]
    exact Subgroup.isClosed_topologicalClosure _
  -- Step 1: the Frattini quotient is abelian of exponent two.
  have hsq : ∀ x : Γ ⧸ Φ, x ^ 2 = 1 := by
    intro x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective Φ x
    rw [← map_pow, QuotientGroup.mk'_apply]
    exact (QuotientGroup.eq_one_iff (g ^ 2)).mpr (pow_mem_pFrattini 2 g)
  haveI hcomm : IsMulCommutative (Γ ⧸ Φ) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr (commutator_le_pFrattini 2)
  -- the `𝔽₂`-vector space structure on the quotient (exponent two plus commutativity)
  letI : AddCommGroup (Additive (Γ ⧸ Φ)) :=
    { (inferInstance : AddGroup (Additive (Γ ⧸ Φ))) with
      add_comm := fun a b => by
        show Additive.ofMul (a.toMul * b.toMul) = Additive.ofMul (b.toMul * a.toMul)
        rw [mul_comm' a.toMul b.toMul] }
  letI : Module (ZMod 2) (Additive (Γ ⧸ Φ)) :=
    AddCommGroup.zmodModule (fun x => by
      rw [two_nsmul]
      apply Additive.ext
      rw [toMul_add, toMul_zero, ← pow_two]
      exact hsq x.toMul)
  -- Step 2: the images of the dense generating family generate a finite subgroup.
  set b : Fin d → (Γ ⧸ Φ) := fun i => (QuotientGroup.mk' Φ) (gen i) with hbdef
  let L : (Fin d → ZMod 2) →ₗ[ZMod 2] Additive (Γ ⧸ Φ) :=
    Fintype.linearCombination (ZMod 2) (fun i => Additive.ofMul (b i))
  have hL_apply : ∀ x : Fin d → ZMod 2, L x = ∑ i, x i • Additive.ofMul (b i) := by
    intro x
    rw [Fintype.linearCombination_apply]
  have hL_single : ∀ i : Fin d, L (Pi.single i 1) = Additive.ofMul (b i) := by
    intro i
    rw [hL_apply]
    simp
  let K : Subgroup (Γ ⧸ Φ) :=
    { carrier := Set.range (fun x : Fin d → ZMod 2 => (L x).toMul)
      one_mem' := by
        refine ⟨0, ?_⟩
        show (L 0).toMul = 1
        rw [map_zero, toMul_zero]
      mul_mem' := by
        rintro _ _ ⟨u, rfl⟩ ⟨v, rfl⟩
        refine ⟨u + v, ?_⟩
        show (L (u + v)).toMul = (L u).toMul * (L v).toMul
        rw [map_add, toMul_add]
      inv_mem' := by
        rintro _ ⟨u, rfl⟩
        refine ⟨u, ?_⟩
        show (L u).toMul = ((L u).toMul)⁻¹
        rw [eq_inv_iff_mul_eq_one, ← pow_two]
        exact hsq _ }
  have hH_le_K : Subgroup.closure (Set.range b) ≤ K := by
    rw [Subgroup.closure_le]
    rintro _ ⟨i, rfl⟩
    refine ⟨Pi.single i 1, ?_⟩
    show (L (Pi.single i 1)).toMul = b i
    rw [hL_single, toMul_ofMul]
  have hKfin : (K : Set (Γ ⧸ Φ)).Finite := Set.finite_range _
  have hHfin : (Subgroup.closure (Set.range b) : Set (Γ ⧸ Φ)).Finite :=
    hKfin.subset (fun x hx => hH_le_K hx)
  -- Step 3: that subgroup is dense, hence -- being finite and closed -- everything.
  have hqcont : Continuous (QuotientGroup.mk' Φ : Γ → Γ ⧸ Φ) := by
    rw [QuotientGroup.coe_mk']
    exact QuotientGroup.continuous_mk
  have hgencl : closure (((Subgroup.closure (Set.range gen) : Subgroup Γ)) : Set Γ) = Set.univ :=
    ((topologicalClosure_eq_top_iff_dense (Subgroup.closure (Set.range gen))).mp hgen).closure_eq
  have himg : Set.image (QuotientGroup.mk' Φ)
        (((Subgroup.closure (Set.range gen) : Subgroup Γ)) : Set Γ)
      ⊆ ((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ)) : Set (Γ ⧸ Φ)) := by
    have h : Subgroup.map (QuotientGroup.mk' Φ) (Subgroup.closure (Set.range gen))
        ≤ Subgroup.closure (Set.range b) := by
      rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
      rintro _ ⟨i, rfl⟩
      exact Subgroup.subset_closure ⟨i, rfl⟩
    rintro _ ⟨x, hx, rfl⟩
    exact h ⟨x, hx, rfl⟩
  have hHdense : closure (((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ))) : Set (Γ ⧸ Φ))
      = Set.univ := by
    have h1 := image_closure_subset_closure_image (f := (QuotientGroup.mk' Φ : Γ → Γ ⧸ Φ))
      (s := (((Subgroup.closure (Set.range gen) : Subgroup Γ)) : Set Γ)) hqcont
    rw [hgencl, Set.image_univ, Set.range_eq_univ.mpr (QuotientGroup.mk'_surjective Φ)] at h1
    exact Set.eq_univ_of_univ_subset (h1.trans (closure_mono himg))
  have hHtop : (Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ)) = ⊤ := by
    have hclosed : IsClosed (((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ))) : Set (Γ ⧸ Φ)) :=
      hHfin.isClosed
    have hset : (((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ))) : Set (Γ ⧸ Φ))
        = Set.univ := hclosed.closure_eq.symm.trans hHdense
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ (((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ))) : Set (Γ ⧸ Φ)) := by
      rw [hset]
      exact Set.mem_univ x
    exact hx
  haveI : Finite (Γ ⧸ Φ) := by
    haveI : Finite ↥(Subgroup.closure (Set.range b)) := hHfin.to_subtype
    exact Finite.of_surjective (Subtype.val : ↥(Subgroup.closure (Set.range b)) → (Γ ⧸ Φ))
      (fun y => ⟨⟨y, by rw [hHtop]; trivial⟩, rfl⟩)
  -- Step 4: the cardinality of the quotient.
  have hP : IsPGroup 2 (Γ ⧸ Φ) := fun x => ⟨1, by simpa using hsq x⟩
  obtain ⟨k, hk⟩ := (IsPGroup.iff_card (p := 2) (G := Γ ⧸ Φ)).mp hP
  refine ⟨k, ?_, hk⟩
  have hbound : Nat.card (Γ ⧸ Φ) ≤ 2 ^ d := by
    have hrange : Set.range (fun x : Fin d → ZMod 2 => (L x).toMul) = Set.univ := by
      have h1 : ((Subgroup.closure (Set.range b) : Subgroup (Γ ⧸ Φ)) : Set (Γ ⧸ Φ))
          ⊆ Set.range (fun x : Fin d → ZMod 2 => (L x).toMul) := fun x hx => hH_le_K hx
      rw [hHtop, Subgroup.coe_top] at h1
      exact Set.eq_univ_of_univ_subset h1
    have hsurj : Function.Surjective (fun x : Fin d → ZMod 2 => (L x).toMul) :=
      Set.range_eq_univ.mp hrange
    have h := Nat.card_le_card_of_surjective (fun x : Fin d → ZMod 2 => (L x).toMul) hsurj
    rwa [Nat.card_fun, Nat.card_zmod, Nat.card_fin] at h
  have h2k : 2 ^ k ≤ 2 ^ d := by rw [← hk]; exact hbound
  exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp h2k

end Work.RelatorRank.GeneratorRank
