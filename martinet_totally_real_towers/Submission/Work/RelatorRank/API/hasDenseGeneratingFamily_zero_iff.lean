import Mathlib
import Submission.Work.RelatorRank.Bridge

/-!
# `Work.RelatorRank.API` -- generating `Γ` on zero elements

**Namespace** `Work.RelatorRank.API`; module
`Submission.Work.RelatorRank.API.hasDenseGeneratingFamily_zero_iff`.

The generator rank `0` is the degenerate case: a dense generating family indexed by `Fin 0` is a
family of *no* elements whose generated subgroup is the trivial subgroup, so the density condition
becomes `closure {1} = univ`.  In a `T1` topological group a singleton is closed, so this forces
every element of `Γ` to be `1`; conversely a subsingleton group is densely generated by the empty
family.  Hence `HasDenseGeneratingFamily Γ 0` is exactly `Subsingleton Γ`.

(`T1` is genuinely needed: in the two-point Sierpiński space, viewed as a topological group?
no -- but in a non-`T1` topological group the closure of `{1}` can be all of `Γ` without `Γ` being
a subsingleton.  The hypothesis `T1Space Γ` is therefore part of the statement.)
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.RelatorRank.API

/-- **A dense generating family of size `0` exists iff `Γ` is a subsingleton.**

`HasDenseGeneratingFamily Γ 0` says: there is `gen : Fin 0 → Γ` with
`(Subgroup.closure (Set.range gen)).topologicalClosure = ⊤`.  Since `Fin 0` is empty, the generated
subgroup is `⊥`, and `⊥` has underlying set `{1}`; so the condition is `closure {1} = univ`.  In a
`T1Space` the singleton `{1}` is closed, hence `closure {1} = {1} = univ`, i.e. `Subsingleton Γ`.
Conversely, if `Γ` is a subsingleton then `⊥ = ⊤` and the (unique) empty family densely generates. -/
theorem hasDenseGeneratingFamily_zero_iff {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] [T1Space Γ] : HasDenseGeneratingFamily Γ 0 ↔ Subsingleton Γ := by
  -- The trivial subgroup is dense iff `Γ` is a subsingleton (`T1`: singletons are closed).
  have hbot : (⊥ : Subgroup Γ).topologicalClosure = ⊤ ↔ Subsingleton Γ := by
    rw [topologicalClosure_eq_top_iff_dense, Subgroup.coe_bot, dense_iff_closure_eq]
    constructor
    · intro h
      refine ⟨fun a b => ?_⟩
      have hsub : _root_.closure ({1} : Set Γ) ⊆ {1} :=
        closure_minimal (fun x hx => hx) isClosed_singleton
      have ha : a = 1 := by
        have : a ∈ _root_.closure ({1} : Set Γ) := by rw [h]; trivial
        simpa using hsub this
      have hb : b = 1 := by
        have : b ∈ _root_.closure ({1} : Set Γ) := by rw [h]; trivial
        simpa using hsub this
      rw [ha, hb]
    · intro h
      rw [Set.eq_univ_iff_forall]
      intro x
      exact subset_closure (by simpa using (Subsingleton.elim x 1 : x = 1))
  -- An empty family generates `⊥`, so density of the generated subgroup is density of `⊥`.
  have hgen : HasDenseGeneratingFamily Γ 0 ↔ (⊥ : Subgroup Γ).topologicalClosure = ⊤ := by
    constructor
    · rintro ⟨gen, hgen⟩
      rw [denseGenerating_iff] at hgen
      rw [Set.range_eq_empty gen, Subgroup.closure_empty] at hgen
      exact hgen
    · intro h
      refine ⟨Fin.elim0, ?_⟩
      rw [denseGenerating_iff, Set.range_eq_empty Fin.elim0, Subgroup.closure_empty]
      exact h
  rw [hgen, hbot]

end Work.RelatorRank.API
