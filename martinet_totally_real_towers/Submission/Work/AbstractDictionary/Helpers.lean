import Mathlib
import Submission.Work.AbstractDictionary.Defs
import Submission.Work.ShafarevichKoch.ProTwoClosed

/-!
# `Work.AbstractDictionary` -- reindexing and the closed/abstract conversion

**Namespace** `Work.AbstractDictionary`; module `Submission.Work.AbstractDictionary.Helpers`.

`Work.ShafarevichKoch.ker_eq_normalClosure_of_closed` -- the one lemma in the workspace that turns a
*closed* (`pro-2`) presentation into an *abstract* one -- consumes the relators as a
`Fin r`-indexed family `w : Fin r → FreeGroup (Fin d)`, whereas everything in this area (and in
`Work.HopfGaschutz`) produces them as a `Finset`.  This file bridges the two shapes:

* `exists_fin_range_eq_finset` -- every finite set is the range of a `Fin s.card`-indexed family;
* `closedNormalGeneratesTwo_iff_fin` -- the `Finset`-shaped closed condition is the `Fin`-shaped
  one along such a reindexing;
* `closedRelationData_of_finset` -- the packaged conversion into
  `Work.ShafarevichKoch.ClosedRelationData`;
* `ker_eq_normalClosure_of_closedNormalGeneratesTwo` -- **the conversion**:
  `ClosedNormalGeneratesTwo` + the residual finiteness side condition
  (`Work.AbstractDictionary.ResidualTwoFinitenessPresentations`) implies the abstract kernel
  equality `ker (FreeGroup.lift g) = ⟪S⟫`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped Classical

namespace Work.AbstractDictionary

/-- **Reindexing a finite set by `Fin`.**  For every `Finset S` there is a family
`w : Fin S.card → α` whose range is exactly `S`. -/
theorem exists_fin_range_eq_finset {α : Type*} (S : Finset α) :
    ∃ w : Fin S.card → α, Set.range w = (S : Set α) := by
  classical
  refine ⟨fun i => (S.equivFin.symm i : α), ?_⟩
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact (S.equivFin.symm i).2
  · intro hx
    exact ⟨S.equivFin ⟨x, hx⟩, by simp⟩

/-- The elements of a `Finset` and of the range of a reindexing family agree. -/
theorem mem_range_iff_mem_finset {α : Type*} {S : Finset α} {w : Fin S.card → α}
    (hw : Set.range w = (S : Set α)) (i : Fin S.card) : w i ∈ S := by
  rw [← Finset.mem_coe, ← hw]
  exact ⟨i, rfl⟩

/-- The `Finset`-shaped closed normal generation condition, in the `Fin`-indexed form of
`Work.ShafarevichKoch.ClosedRelationData`. -/
theorem closedNormalGeneratesTwo_iff_fin {α : Type} {K : Subgroup (FreeGroup α)}
    {S : Finset (FreeGroup α)} {w : Fin S.card → FreeGroup α}
    (hw : Set.range w = (S : Set (FreeGroup α))) :
    ClosedNormalGeneratesTwo K S ↔
      ∀ (Q : Type) [Group Q] [Fintype Q], IsPGroup 2 Q → ∀ φ : FreeGroup α →* Q,
        (∀ i, φ (w i) = 1) → K ≤ MonoidHom.ker φ := by
  constructor
  · intro h Q _ _ hQ φ hφ
    exact h Q hQ φ fun s hs => by
      have hs' : s ∈ (S : Set (FreeGroup α)) := hs
      rw [← hw] at hs'
      obtain ⟨i, rfl⟩ := hs'
      exact hφ i
  · intro h Q _ _ hQ φ hφ
    exact h Q hQ φ fun i => hφ (w i) (mem_range_iff_mem_finset hw i)

/-- **The packaged conversion into `Work.ShafarevichKoch.ClosedRelationData`**: a `Finset`-shaped
closed condition, together with the vanishing of the relators in `G`, is the `Fin`-shaped
`ClosedRelationData` along any reindexing. -/
theorem closedRelationData_of_finset {d : ℕ} {G : Type*} [Group G] (g : Fin d → G)
    {S : Finset (FreeGroup (Fin d))} {w : Fin S.card → FreeGroup (Fin d)}
    (hw : Set.range w = (S : Set (FreeGroup (Fin d))))
    (hS : ∀ s ∈ S, FreeGroup.lift g s = 1)
    (hclosed : ClosedNormalGeneratesTwo (MonoidHom.ker (FreeGroup.lift g)) S) :
    Work.ShafarevichKoch.ClosedRelationData d S.card g w :=
  ⟨fun i => hS (w i) (mem_range_iff_mem_finset hw i),
    fun Q _ _ hQ φ hφ => (closedNormalGeneratesTwo_iff_fin hw).mp hclosed Q hQ φ hφ⟩

/-- **The closed ⟹ abstract conversion.**

The relator set `S` of a *closed* presentation of a group `G` on the generating family `g` generates
the relation kernel *abstractly* -- provided the abstract group presented by `S` is residually a
finite `2`-group.  This is `Work.ShafarevichKoch.ker_eq_normalClosure_of_closed` with the reindexing
of the relator set made explicit.

The point of the residual finiteness hypothesis: without it the statement is **false**.  For
`G = ℤ/2` generated by `x`, the kernel of `FreeGroup (Fin 1) → ℤ/2` is `2ℤ`, while the closed
condition holds for the single relator `x⁶` whose *abstract* normal closure is `6ℤ ⊊ 2ℤ`
(`Work.HopfGaschutz.Counterexample.naive_engine_fails`).  What fails there is exactly the residual
`2`-finiteness of the presented group `ℤ/6`. -/
theorem ker_eq_normalClosure_of_closedNormalGeneratesTwo {d : ℕ} {G : Type*} [Group G]
    (g : Fin d → G) {S : Finset (FreeGroup (Fin d))} {w : Fin S.card → FreeGroup (Fin d)}
    (hw : Set.range w = (S : Set (FreeGroup (Fin d))))
    (hS : ∀ s ∈ S, FreeGroup.lift g s = 1)
    (hclosed : ClosedNormalGeneratesTwo (MonoidHom.ker (FreeGroup.lift g)) S)
    (hres : Work.ClassFieldTower.ResiduallyFiniteTwoGroup
      (FreeGroup (Fin d) ⧸ Subgroup.normalClosure (S : Set (FreeGroup (Fin d))))) :
    MonoidHom.ker (FreeGroup.lift g) = Subgroup.normalClosure (S : Set (FreeGroup (Fin d))) := by
  have hdata := closedRelationData_of_finset g hw hS hclosed
  have hres' : Work.ClassFieldTower.ResiduallyFiniteTwoGroup
      (FreeGroup (Fin d) ⧸ Subgroup.normalClosure (Set.range w)) := by
    rwa [hw]
  have h := Work.ShafarevichKoch.ker_eq_normalClosure_of_closed g w hdata.1 hdata.2 hres'
  rwa [hw] at h

/-- **The closed ⟹ abstract conversion, from the named side condition.** -/
theorem ker_eq_normalClosure_of_residualTwoFiniteness {Γ : Type*} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] (hres : ResidualTwoFinitenessPresentations (Γ := Γ))
    {d : ℕ} {gen : Fin d → Γ} {S : Finset (FreeGroup (Fin d))}
    (hgen : Work.RelatorRank.DenseGenerating gen)
    (hS : ∀ s ∈ S, FreeGroup.lift gen s = 1)
    (hclosed : ClosedNormalGeneratesTwo (MonoidHom.ker (FreeGroup.lift gen)) S) :
    MonoidHom.ker (FreeGroup.lift gen) =
      Subgroup.normalClosure (S : Set (FreeGroup (Fin d))) := by
  obtain ⟨w, hw⟩ := exists_fin_range_eq_finset S
  exact ker_eq_normalClosure_of_closedNormalGeneratesTwo gen hw hS hclosed
    (hres d gen S hgen hS hclosed)

end Work.AbstractDictionary
