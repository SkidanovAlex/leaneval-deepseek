import Mathlib
import Submission.Work.AbstractDictionary.Defs
import Submission.Work.RelatorRank.Discrete

/-!
# `Work.AbstractDictionary.not_residualTwoFinitenessPresentations_trivial`

**Namespace** `Work.AbstractDictionary`; module
`Submission.Work.AbstractDictionary.not_residualTwoFinitenessPresentations_trivial`.

The residual `2`-finiteness side condition of this area,

```
Work.AbstractDictionary.ResidualTwoFinitenessPresentations Γ
```

is **not automatic**: there is a pro-`2` group `Γ`, a dense generating family `gen` and a finite
relator set `S ⊆ ker (FreeGroup.lift gen)` satisfying the *closed* relation condition
(`Work.AbstractDictionary.ClosedNormalGeneratesTwo`) for which the abstract group presented by `S`
is **not** residually a finite `2`-group.

The witness is the **trivial** group, `d = 1` and `S = {x³}`: the relation kernel is everything,
while every finite `2`-group quotient of the free group on one generator that kills `x³` is
trivial (a finite `2`-group has no element of order `3`), so the closed condition holds; on the
other hand `x` survives in the quotient by `⟪x³⟫`, whose finite `2`-group quotients all die on
`x` --- so `x` is not separated, and the group presented by `x³ = 1` is not residually a finite
`2`-group.  This is the elementary gap the side condition has to close; for the arithmetic `Γ` the
same phenomenon is the `ℤ/6` of `Work.HopfGaschutz.Counterexample` (`gen` the generator of `ℤ/2`,
`S = {x⁶}`), where the closed condition holds because a finite `2`-group has no element of order
`3` either.

Both hypotheses of the instance are honest: `S = {x³} ⊆ ker` (the kernel is everything) and the
closed condition is *proved* below, so this is a counterexample to the unconditional statement and
not an artefact of a missing hypothesis.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped Classical

namespace Work.AbstractDictionary

/-- The trivial group, as a pro-`2` group. -/
abbrev TrivialProTwo : Type := Multiplicative (ZMod 1)

/-- The only map `Fin 1 →` the trivial group. -/
def tgen : Fin 1 → TrivialProTwo := fun _ => 1

/-- The generator of the free group on one letter. -/
def tx : FreeGroup (Fin 1) := FreeGroup.of 0

/-- The relator `x³`, whose abstract normal closure is a proper subgroup of the relation kernel
while its *closed* normal closure is the whole kernel. -/
def tS : Finset (FreeGroup (Fin 1)) := {tx ^ 3}

/-- In a finite `2`-group, an element whose cube is trivial is trivial (a finite `2`-group has no
element of order `3`). -/
theorem eq_one_of_pow_three_eq_one {Q : Type*} [Group Q] (hQ : IsPGroup 2 Q) {a : Q}
    (h : a ^ 3 = 1) : a = 1 := by
  obtain ⟨n, hn⟩ := hQ a
  have hcop : Nat.Coprime 3 (2 ^ n) := (by norm_num : Nat.Coprime 3 2).pow_right n
  have hg : a ^ (Nat.gcd 3 (2 ^ n)) = 1 := (pow_gcd_eq_one (a := a) (m := 3) (n := 2 ^ n)).mpr ⟨h, hn⟩
  rwa [hcop.gcd_eq_one, pow_one] at hg

/-- The free group on one letter is generated by its generator. -/
theorem closure_singleton_tx : Subgroup.closure ({tx} : Set (FreeGroup (Fin 1))) = ⊤ := by
  have h := FreeGroup.closure_range_of (Fin 1)
  have hrange : Set.range (FreeGroup.of : Fin 1 → FreeGroup (Fin 1)) = {tx} := by
    ext y
    constructor
    · rintro ⟨i, hi⟩
      rw [Subsingleton.elim i 0] at hi
      exact hi.symm
    · rintro rfl
      exact ⟨0, rfl⟩
  rwa [hrange] at h

/-- A homomorphism out of the free group on one letter is trivial as soon as it kills the
generator. -/
theorem eq_one_of_apply_tx_eq_one {Q : Type*} [Group Q] (φ : FreeGroup (Fin 1) →* Q)
    (h : φ tx = 1) : φ = 1 := by
  ext i
  rw [Subsingleton.elim i 0]
  simpa [tx] using h

/-- **The closed relation condition holds for the relator `x³` on the trivial group**: every
finite `2`-group quotient of the free group on one letter killing `x³` is trivial. -/
theorem closedNormalGeneratesTwo_tS :
    ClosedNormalGeneratesTwo (MonoidHom.ker (FreeGroup.lift tgen)) tS := by
  intro Q _ _ hQ φ hφ
  have hx3 : φ (tx ^ 3) = 1 := hφ _ (by simp [tS])
  have hφx : φ tx = 1 := eq_one_of_pow_three_eq_one hQ (by rw [← map_pow, hx3])
  have hφ1 : φ = 1 := eq_one_of_apply_tx_eq_one φ hφx
  intro y _
  rw [hφ1]
  exact MonoidHom.mem_ker.mpr rfl

/-- **The side condition fails for the trivial pro-`2` group.**  So
`Work.AbstractDictionary.ResidualTwoFinitenessPresentations` is a genuine condition, not a
formality: without it the closed ⟹ abstract conversion of
`Work.ShafarevichKoch.ker_eq_normalClosure_of_closed` is false. -/
theorem not_residualTwoFinitenessPresentations_trivial
    [TopologicalSpace TrivialProTwo] [IsTopologicalGroup TrivialProTwo]
    [DiscreteTopology TrivialProTwo] :
    ¬ Work.AbstractDictionary.ResidualTwoFinitenessPresentations (Γ := TrivialProTwo) := by
  classical
  intro h
  have hdense : Work.RelatorRank.DenseGenerating tgen := by
    refine (Work.RelatorRank.denseGenerating_iff_generating_of_discrete tgen).mpr ?_
    show Subgroup.closure (Set.range tgen) = ⊤
    rw [eq_top_iff]
    intro y _
    rw [Subsingleton.elim y 1]
    exact Subgroup.one_mem _
  have hkill : ∀ s ∈ tS, FreeGroup.lift tgen s = 1 := fun s _ => Subsingleton.elim _ _
  have hclosed := closedNormalGeneratesTwo_tS
  -- the presented group
  have hres : Work.ClassFieldTower.ResiduallyFiniteTwoGroup
      (FreeGroup (Fin 1) ⧸ Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) :=
    h 1 tgen tS hdense hkill hclosed
  -- `x` survives in the presented group, by the `ℤ/3` character
  have hxne : QuotientGroup.mk' (Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) tx ≠ 1 := by
    intro h1
    have hxmem : tx ∈ Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1))) :=
      (QuotientGroup.eq_one_iff tx).mp h1
    let ψ : FreeGroup (Fin 1) →* Multiplicative (ZMod 3) :=
      FreeGroup.lift (fun _ => Multiplicative.ofAdd (1 : ZMod 3))
    have hψ3 : ψ (tx ^ 3) = 1 := by
      rw [map_pow]
      change (Multiplicative.ofAdd (1 : ZMod 3)) ^ 3 = 1
      decide
    have hle : Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1))) ≤ MonoidHom.ker ψ := by
      refine Subgroup.normalClosure_le_normal ?_
      intro y hy
      have hy3 : y = tx ^ 3 := by simpa [tS] using hy
      rw [hy3]
      exact MonoidHom.mem_ker.mpr hψ3
    have hx1 : ψ tx = 1 := MonoidHom.mem_ker.mp (hle hxmem)
    have hxval : ψ tx = Multiplicative.ofAdd (1 : ZMod 3) := by
      simp [ψ, tx, FreeGroup.lift_apply_of]
    rw [hxval] at hx1
    exact absurd hx1 (by decide)
  -- but every finite `2`-quotient of the presented group kills it
  obtain ⟨N, hN, hfin, hpg, hsep⟩ := hres _ hxne
  haveI : N.Normal := hN
  haveI : Fintype ((FreeGroup (Fin 1) ⧸
      Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) ⧸ N) :=
    Fintype.ofFinite _
  let φ' : FreeGroup (Fin 1) →*
      ((FreeGroup (Fin 1) ⧸ Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) ⧸ N) :=
    (QuotientGroup.mk' N).comp (QuotientGroup.mk' (Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))))
  have hφ'S : ∀ s ∈ tS, φ' s = 1 := by
    intro s hs
    have hs' : s ∈ Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1))) :=
      Subgroup.subset_normalClosure (Finset.mem_coe.mpr hs)
    have hs1 : QuotientGroup.mk' (Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) s = 1 :=
      (QuotientGroup.eq_one_iff s).mpr hs'
    simp [φ', MonoidHom.comp_apply, hs1]
  have hker_top : MonoidHom.ker (FreeGroup.lift tgen) = ⊤ := by
    refine le_antisymm le_top ?_
    intro y _
    exact MonoidHom.mem_ker.mpr (Subsingleton.elim _ _)
  have htop := hclosed _ hpg φ' hφ'S
  have hx1 : φ' tx = 1 := MonoidHom.mem_ker.mp (htop (hker_top.symm ▸ Subgroup.mem_top tx))
  have hxfinal : QuotientGroup.mk' N
      (QuotientGroup.mk' (Subgroup.normalClosure (tS : Set (FreeGroup (Fin 1)))) tx) = 1 := by
    simpa [φ', MonoidHom.comp_apply] using hx1
  exact hsep hxfinal

end Work.AbstractDictionary
