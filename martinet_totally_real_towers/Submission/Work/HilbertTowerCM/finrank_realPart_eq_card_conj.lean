import Mathlib
import Submission.Work.HilbertTowerCM.exists_isConj_of_isGalois

/-!
# `Work.HilbertTowerCM.finrank_realPart_eq_card_conj`

For a number field `L` which is Galois over `ℚ`, the degree of `L` over its maximal real
subfield `L⁺ = NumberField.maximalRealSubfield L` equals the order of the subgroup of
`Gal(L/ℚ)` generated by the *complex conjugations* of `L` -- the elements `σ` for which some
complex embedding `φ : L →+* ℂ` satisfies `ComplexEmbedding.IsConj φ σ`
(`conjugate φ = φ.comp σ`).

## Proof

Let `S` be the set of those conjugations and `H = ⟨S⟩`.  Viewing the maximal real subfield as an
intermediate field `K` of `L/ℚ`, we show `fixedField H = K` (whence, by the Galois
correspondence for a finite Galois extension, `H = Gal(L/K)`):

* `K ≤ fixedField H`: each `σ ∈ S`, with witness `φ`, fixes `K` pointwise.  For `x ∈ K` every
  complex embedding of `x` is real, so `star (ψ x) = ψ x` for `ψ = φ` and for `ψ = φ.comp σ`;
  together with `IsConj.eq x : φ (σ x) = star (φ x)` this gives `φ (σ x) = φ x`, and `σ x = x`
  since `φ` is injective.  The elements of `S` therefore fix `K`, and so does the subgroup they
  generate;
* `fixedField H ≤ K`: an element `x` fixed by all of `H` is real at every embedding `φ`: choosing
  `σ` with `IsConj φ σ` (`exists_isConj_of_isGalois`), we have `σ ∈ H`, hence `σ x = x`, so
  `star (φ x) = φ (σ x) = φ x`.

Finally `IntermediateField.finrank_fixedField_eq_card` computes
`[L : fixedField H] = |H|`, and `fixedField H = K` gives `[L : L⁺] = |H|`.

The sibling statement `Work.HilbertTowerCM.maximalRealSubfield_eq_fixedField_conj` is the
`Set`-level form of the intermediate equality `fixedField H = K` established here; the present
proof does not use it, and imports only the conjugation-existence lemma
`Work.HilbertTowerCM.exists_isConj_of_isGalois` that the argument needs.
-/

namespace Work.HilbertTowerCM

open NumberField

theorem finrank_realPart_eq_card_conj (L : Type*) [Field L] [NumberField L] [IsGalois ℚ L] :
    Module.finrank ↥(NumberField.maximalRealSubfield L) L =
      Nat.card (Subgroup.closure {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ,
        NumberField.ComplexEmbedding.IsConj φ σ}) := by
  classical
  -- `ℚ` lands in the maximal real subfield, so it can be viewed as an intermediate field of `L/ℚ`.
  have hmem : ∀ x : ℚ, algebraMap ℚ L x ∈ NumberField.maximalRealSubfield L := by
    intro x
    rw [NumberField.mem_maximalRealSubfield_iff]
    intro φ
    simp
  let K : IntermediateField ℚ L := (NumberField.maximalRealSubfield L).toIntermediateField hmem
  have hKcoe : (K : Set L) = (NumberField.maximalRealSubfield L : Set L) := rfl
  -- The set of conjugations and the subgroup it generates.
  set S : Set (L ≃ₐ[ℚ] L) := {σ | ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ σ}
    with hSdef
  -- Step 1: every conjugation in `S` fixes `K = L⁺` pointwise.
  have hS_fix : ∀ σ ∈ S, σ ∈ K.fixingSubgroup := by
    intro σ hσ
    obtain ⟨φ, hφ⟩ := hσ
    refine (IntermediateField.mem_fixingSubgroup_iff K σ).mpr ?_
    intro x hx
    have hxr : x ∈ NumberField.maximalRealSubfield L := by
      have hx' : x ∈ (K : Set L) := hx
      rw [hKcoe] at hx'
      exact hx'
    apply φ.injective
    have h1 : φ (σ x) = star (φ x) := hφ.eq x
    have h2 : star (φ x) = φ x := (NumberField.mem_maximalRealSubfield_iff x).mp hxr φ
    rw [h1, h2]
  -- Step 2: conversely, an element fixed by `H = ⟨S⟩` is real at every embedding.
  have hfixed_le : IntermediateField.fixedField (Subgroup.closure S) ≤ K := by
    intro x hx
    have hx' : ∀ f ∈ Subgroup.closure S, f x = x :=
      (IntermediateField.mem_fixedField_iff _ x).mp hx
    have hreal : x ∈ NumberField.maximalRealSubfield L := by
      refine (NumberField.mem_maximalRealSubfield_iff x).mpr ?_
      intro φ
      obtain ⟨σ, hσ⟩ := exists_isConj_of_isGalois L φ
      have hσS : σ ∈ Subgroup.closure S := Subgroup.subset_closure ⟨φ, hσ⟩
      have hxe : σ x = x := hx' σ hσS
      have heq : φ (σ x) = star (φ x) := hσ.eq x
      rw [hxe] at heq
      exact heq.symm
    have hxK : x ∈ (K : Set L) := by
      rw [hKcoe]
      exact hreal
    exact hxK
  -- The Galois correspondence (Step 1 in field form) gives the reverse inclusion.
  have hK_le : K ≤ IntermediateField.fixedField (Subgroup.closure S) :=
    (IntermediateField.le_iff_le _ _).mpr ((Subgroup.closure_le K.fixingSubgroup).mpr hS_fix)
  have hK : IntermediateField.fixedField (Subgroup.closure S) = K := le_antisymm hfixed_le hK_le
  -- Step 3: `[L : L⁺] = [L : fixedField H] = |H|`.
  have hfr : Module.finrank ↥K L = Nat.card (Subgroup.closure S) := by
    rw [← hK]
    exact IntermediateField.finrank_fixedField_eq_card (Subgroup.closure S)
  rw [show Module.finrank ↥(NumberField.maximalRealSubfield L) L = Module.finrank ↥K L from rfl,
    hfr]

end Work.HilbertTowerCM
