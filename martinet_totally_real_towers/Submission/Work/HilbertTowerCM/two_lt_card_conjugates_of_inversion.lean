import Mathlib
import Submission.Work.HilbertTowerCM.card_closure_conjugates_of_inversion

namespace Work.HilbertTowerCM

/-- **The normal closure of an inverting involution has more than two elements.**

Let `G` be a finite group, `A ≤ G` a subgroup, and `τ ∉ A` an involution (`τ * τ = 1`) with
every element of `G` lying in `A` or in the coset `A τ`, and such that `τ` inverts `A` by
conjugation.  If `A` contains an element `a` with `a ^ 2 ≠ 1`, then the subgroup generated by
the conjugates of `τ` has more than two elements.

Indeed (`Work.HilbertTowerCM.card_closure_conjugates_of_inversion`) that subgroup equals
`T ∪ T τ`, where `T = ⟨a ^ 2 | a ∈ A⟩`, so it has twice the order of `T`.  Since `1` and `a ^ 2`
are two distinct elements of `T`, we get `2 ≤ |T|`, hence `2 < 2 * |T|`. -/
theorem two_lt_card_conjugates_of_inversion {G : Type*} [Group G] [Fintype G] (A : Subgroup G)
    (τ : G) (hτ : τ ∉ A) (hτ2 : τ * τ = 1)
    (hcover : ∀ g : G, g ∈ A ∨ ∃ a : A, g = (a : G) * τ)
    (hcomm : ∀ a : A, τ * (a : G) * τ⁻¹ = (a : G)⁻¹)
    (hA : ∃ a : A, (a : G) ^ 2 ≠ 1) :
    2 < Nat.card (Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹}) := by
  obtain ⟨a, ha⟩ := hA
  -- the normal closure of `τ` has twice the order of the `A`-square subgroup `T`
  rw [card_closure_conjugates_of_inversion A τ hτ hτ2 hcover hcomm]
  set T : Subgroup G := Subgroup.closure {g : G | ∃ a : A, g = (a : G) ^ 2} with hT
  have hmem1 : (1 : G) ∈ T := by rw [hT]; exact Subgroup.one_mem _
  have hmem2 : ((a : A) : G) ^ 2 ∈ T := by
    rw [hT]; exact Subgroup.subset_closure ⟨a, rfl⟩
  have hne : (⟨1, hmem1⟩ : T) ≠ ⟨((a : A) : G) ^ 2, hmem2⟩ := by
    intro h
    exact ha (Subtype.ext_iff.mp h).symm
  -- `T` has at least two elements, namely `1` and `a ^ 2`
  have h2T : 2 ≤ Nat.card T := by
    have hinj : Function.Injective
        (fun i : Fin 2 => if i = 0 then (⟨1, hmem1⟩ : T) else ⟨((a : A) : G) ^ 2, hmem2⟩) := by
      intro i j hij
      fin_cases i <;> fin_cases j <;> simp_all
    have := Nat.card_le_card_of_injective _ hinj
    rwa [Nat.card_fin] at this
  omega

end Work.HilbertTowerCM
