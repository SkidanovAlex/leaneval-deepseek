import Mathlib

namespace Work.HilbertTowerCM

/-- If every element of `G` lies in `A` or in the coset `A τ`, then the normal closure of `τ`
(the subgroup generated by the conjugates of `τ`) is generated by `τ` together with the
commutators `a τ a⁻¹ τ⁻¹` (`a ∈ A`).

The containment `⟨[A,τ], τ⟩ ≤ ⟨x τ x⁻¹⟩` is formal.  For the converse, every conjugate `x τ x⁻¹`
with `x ∈ G` is either `(x τ x⁻¹ τ⁻¹) · τ` (when `x ∈ A`) or `a τ a⁻¹ = (a τ a⁻¹ τ⁻¹) · τ`
(when `x = a τ`, `a ∈ A`). -/
theorem closure_conjugates_eq_sup_commutators {G : Type*} [Group G] (A : Subgroup G) (τ : G)
    (hcover : ∀ g : G, g ∈ A ∨ ∃ a : A, g = (a : G) * τ) :
    Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} =
      (Subgroup.closure {c : G | ∃ a : A, c = (a : G) * τ * (a : G)⁻¹ * τ⁻¹}) ⊔
        Subgroup.zpowers τ := by
  set H : Subgroup G := Subgroup.closure {c : G | ∃ a : A, c = (a : G) * τ * (a : G)⁻¹ * τ⁻¹}
    with hH
  set R : Subgroup G := H ⊔ Subgroup.zpowers τ with hR
  set L : Subgroup G := Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} with hL
  change L = R
  have hτL : τ ∈ L := Subgroup.subset_closure ⟨1, by simp⟩
  have hgen : ∀ x : G, x * τ * x⁻¹ ∈ L := fun x => Subgroup.subset_closure ⟨x, rfl⟩
  have hτR : τ ∈ R := by rw [hR]; exact Subgroup.mem_sup_right (Subgroup.mem_zpowers τ)
  have hcommR : ∀ x : G, x ∈ A → x * τ * x⁻¹ * τ⁻¹ ∈ R := by
    intro x hx
    rw [hR]
    exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨⟨x, hx⟩, rfl⟩)
  refine le_antisymm ?_ ?_
  · -- `L ≤ R`: every conjugate of `τ` is a commutator times `τ`
    rw [hL]
    refine (Subgroup.closure_le R).mpr ?_
    rintro g ⟨x, rfl⟩
    rcases hcover x with hx | ⟨a, ha⟩
    · have h1 := hcommR x hx
      have heq : x * τ * x⁻¹ = (x * τ * x⁻¹ * τ⁻¹) * τ := by group
      rw [heq]
      exact Subgroup.mul_mem R h1 hτR
    · rw [ha]
      have h1 := hcommR (a : G) a.2
      have heq : ((a : G) * τ) * τ * ((a : G) * τ)⁻¹ =
          ((a : G) * τ * (a : G)⁻¹ * τ⁻¹) * τ := by group
      rw [heq]
      exact Subgroup.mul_mem R h1 hτR
  · -- `R ≤ L`: commutators and `τ` are products of conjugates of `τ`
    rw [hR]
    refine sup_le ?_ ?_
    · rw [hH]
      refine (Subgroup.closure_le L).mpr ?_
      rintro c ⟨a, rfl⟩
      exact Subgroup.mul_mem L (hgen (a : G)) (Subgroup.inv_mem L hτL)
    · exact Subgroup.zpowers_le.mpr hτL

end Work.HilbertTowerCM
