import Mathlib
import Submission.Work.HilbertTowerCM.two_lt_card_conjugates_of_inversion
import Submission.Work.HilbertTowerCM.not_isCMField_of_card_conj_gt_two

/-!
# A totally complex Galois number field with an inverting involution is not CM

`Work.HilbertTowerCM.not_isCMField_of_card_conj_gt_two` shows that a totally complex Galois
number field `L/ℚ` is *not* CM as soon as the subgroup

`H = ⟨{σ : Gal(L/ℚ) | ∃ φ : L →+* ℂ, IsConj φ σ}⟩`

generated by all the complex conjugations of `L` has more than two elements
(`[L : L⁺] = |H|`, and CM-ness forces `[L : L⁺] = 2`).

The present lemma supplies such a subgroup from the classical "involution inverting a
complement" configuration: if `τ` is a complex conjugation of `L` (`hconj`), `τ` is an
involution (`hτ2`), `A ≤ Gal(L/ℚ)` is a subgroup with `Gal(L/ℚ) = A ⊔ A τ` (`hτ`, `hcover`) on
which `τ` acts by inversion (`hcomm`), and `A` contains an element of order `> 2` (`hA`), then
the set of conjugates of `τ` is contained in the set of all conjugations (the latter is
invariant under conjugation, `IsConj.comp`), so the normal closure of `τ` is contained in `H`.
`Work.HilbertTowerCM.two_lt_card_conjugates_of_inversion` computes the order of that normal
closure as `2 * |⟨a ^ 2 | a ∈ A⟩| > 2`, whence `|H| > 2`.
-/

namespace Work.HilbertTowerCM

open NumberField

/-- **A totally complex Galois number field admitting an inverting involution with a complement
is not CM.**  The normal closure of the involution `τ` consists of conjugations of `L` and has
more than two elements, hence so does the subgroup they generate. -/
theorem not_isCMField_of_inverting_involution (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] [NumberField.IsTotallyComplex L] (τ : L ≃ₐ[ℚ] L) (hτ2 : τ * τ = 1)
    (hconj : ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ τ)
    (A : Subgroup (L ≃ₐ[ℚ] L)) (hτ : τ ∉ A)
    (hcover : ∀ g : L ≃ₐ[ℚ] L, g ∈ A ∨ ∃ a : A, g = (a : L ≃ₐ[ℚ] L) * τ)
    (hcomm : ∀ a : A, τ * (a : L ≃ₐ[ℚ] L) * τ⁻¹ = (a : L ≃ₐ[ℚ] L)⁻¹)
    (hA : ∃ a : A, (a : L ≃ₐ[ℚ] L) ^ 2 ≠ 1) :
    ¬ NumberField.IsCMField L := by
  intro hcm
  -- The set of complex conjugations of `L`.
  let S : Set (L ≃ₐ[ℚ] L) := {σ | ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ σ}
  -- `S` is invariant under conjugation: conjugating a conjugation gives a conjugation.
  have hSconj : ∀ (x : L ≃ₐ[ℚ] L) ⦃s : L ≃ₐ[ℚ] L⦄, s ∈ S → x * s * x⁻¹ ∈ S := by
    rintro x s ⟨φ, hφ⟩
    exact ⟨φ.comp (x⁻¹ : L ≃ₐ[ℚ] L), by
      have h := hφ.comp (x⁻¹ : L ≃ₐ[ℚ] L)
      simpa using h⟩
  -- Hence the normal closure of `τ` is contained in the subgroup generated by the conjugations.
  have hle : Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ x : L ≃ₐ[ℚ] L, g = x * τ * x⁻¹}
      ≤ Subgroup.closure S := by
    rw [Subgroup.closure_le]
    rintro g ⟨x, rfl⟩
    exact Subgroup.subset_closure (hSconj x hconj)
  -- The normal closure of `τ` has more than two elements, so the same holds for `⟨S⟩`.
  have h2 : 2 < Nat.card (Subgroup.closure S) := by
    have h1 := two_lt_card_conjugates_of_inversion A τ hτ hτ2 hcover hcomm hA
    have hcard : Nat.card (Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ x : L ≃ₐ[ℚ] L, g = x * τ * x⁻¹})
        ≤ Nat.card (Subgroup.closure S) := by
      have := Set.ncard_le_ncard (show
        (Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ x : L ≃ₐ[ℚ] L, g = x * τ * x⁻¹} : Set (L ≃ₐ[ℚ] L))
          ⊆ (Subgroup.closure S : Set (L ≃ₐ[ℚ] L)) from hle)
      rwa [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq] at this
    linarith
  exact not_isCMField_of_card_conj_gt_two L h2 hcm

end Work.HilbertTowerCM
