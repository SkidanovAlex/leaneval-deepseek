import Mathlib

namespace Work.HilbertTowerCM

/-- In a group `G` with a subgroup `A` and an element `τ` such that every element of `G` lies in
`A` or in the coset `A τ`, and such that `τ` inverts `A` by conjugation, the normal closure of `τ`
is generated by `⟨τ⟩` together with the squares of the elements of `A`.

Indeed, if `x ∈ A` then `x τ x⁻¹ = x² τ` (because `τ x τ⁻¹ = x⁻¹`), and if `x = a τ` with `a ∈ A`
then `x τ x⁻¹ = a τ a⁻¹ = a² τ`; conversely `τ = 1 · τ · 1` and
`a² = (a τ a⁻¹) · τ⁻¹ = (a² τ) · τ⁻¹` are in the normal closure of `τ`. -/
theorem closure_conjugates_eq_sup_squares {G : Type*} [Group G] (A : Subgroup G) (τ : G)
    (hcover : ∀ g : G, g ∈ A ∨ ∃ a : A, g = (a : G) * τ)
    (hcomm : ∀ a : A, τ * (a : G) * τ⁻¹ = (a : G)⁻¹) :
    Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} =
      Subgroup.closure {g : G | ∃ a : A, g = (a : G) ^ 2} ⊔ Subgroup.zpowers τ := by
  -- `τ` inverts `A`, hence `x τ x⁻¹ = x² τ` for every `x ∈ A`.
  have key : ∀ y : G, y ∈ A → y * τ * y⁻¹ = y ^ 2 * τ := by
    intro y hy
    have hy1 : τ * y * τ⁻¹ = y⁻¹ := hcomm ⟨y, hy⟩
    have h2 : τ * y⁻¹ = y * τ := by
      calc τ * y⁻¹ = (τ * y * τ⁻¹)⁻¹ * τ := by group
        _ = y * τ := by rw [hy1]; simp
    calc y * τ * y⁻¹ = y * (τ * y⁻¹) := by group
      _ = y * (y * τ) := by rw [h2]
      _ = y ^ 2 * τ := by rw [pow_two]; group
  apply le_antisymm
  · -- every conjugate of `τ` lies in `closure {a²} ⊔ zpowers τ`
    rw [Subgroup.closure_le]
    rintro g ⟨x, rfl⟩
    rcases hcover x with hx | ⟨a, ha⟩
    · rw [key x hx]
      exact Subgroup.mul_mem _
        (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨⟨x, hx⟩, rfl⟩))
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers τ))
    · subst ha
      rw [show (a : G) * τ * τ * ((a : G) * τ)⁻¹ = (a : G) * τ * (a : G)⁻¹ from by group]
      rw [key (a : G) a.2]
      exact Subgroup.mul_mem _
        (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨a, rfl⟩))
        (Subgroup.mem_sup_right (Subgroup.mem_zpowers τ))
  · -- conversely `τ` and every `a²` lie in the normal closure of `τ`
    refine sup_le ?_ ?_
    · rw [Subgroup.closure_le]
      rintro g ⟨a, rfl⟩
      have hmem : (a : G) * τ * (a : G)⁻¹ ∈
          Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} :=
        Subgroup.subset_closure ⟨(a : G), rfl⟩
      have h2 : (a : G) ^ 2 * τ ∈
          Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} := by
        rw [← key (a : G) a.2]; exact hmem
      have hτ : τ⁻¹ ∈ Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} :=
        Subgroup.inv_mem _ (Subgroup.subset_closure ⟨1, by group⟩)
      rw [show (a : G) ^ 2 = ((a : G) ^ 2 * τ) * τ⁻¹ from by group]
      exact Subgroup.mul_mem _ h2 hτ
    · rw [Subgroup.zpowers_le]
      exact Subgroup.subset_closure ⟨1, by group⟩

end Work.HilbertTowerCM
