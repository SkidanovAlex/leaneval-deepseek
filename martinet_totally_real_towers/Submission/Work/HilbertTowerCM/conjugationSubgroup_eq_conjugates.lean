import Mathlib

/-!
# The subgroup generated by the complex conjugations is the normal closure of any one of them

Let `L/ℚ` be a Galois number field and let `φ : L →+* ℂ` be a complex embedding.  Mathlib's
`NumberField.ComplexEmbedding.IsConj φ σ` says that `σ : Gal(L/ℚ)` is the complex conjugation
*under the embedding `φ`*, i.e. `conjugate φ = φ.comp σ`, equivalently `φ (σ x) = star (φ x)`.

The subgroup of `Gal(L/ℚ)` generated by all these conjugations,

`H = ⟨{σ : Gal(L/ℚ) | ∃ φ : L →+* ℂ, IsConj φ σ}⟩`,

is the group that appears in the CM criterion for the levels of the Hilbert class tower
(`Work.HilbertTowerCM.Conjugation`, `...not_isCMField_of_card_conj_gt_two`): `[L : L⁺] = |H|`,
so `L` is CM exactly when `|H| = 2`.

This module computes `H` in terms of a **single** conjugation `τ`: the set of all conjugations of
`L` is exactly the set of `Gal(L/ℚ)`-conjugates of `τ`, hence

`H = ⟨ρ⁻¹ * τ * ρ | ρ : Gal(L/ℚ)⟩ = ` the normal closure of `τ` (as a subgroup of `Gal(L/ℚ)`).

Both inclusions are formal consequences of `ComplexEmbedding.IsConj.comp` (`IsConj φ σ` implies
`IsConj (φ.comp ν) (ν⁻¹ * σ * ν)`) and of the fact that any two complex embeddings of a Galois
`L/ℚ` differ by an element of the Galois group
(`ComplexEmbedding.exists_comp_symm_eq_of_comp_eq`): if `φ = φ₀.comp ν` and `IsConj φ σ` while
`IsConj φ₀ τ`, then `IsConj (φ₀.comp ν) (ν⁻¹ * τ * ν)` as well, so `IsConj.ext` gives
`σ = ν⁻¹ * τ * ν`.  (In particular the total-complexity hypothesis is not needed for the
identity; it is kept because that is the form the CM endgame uses.)

Consequently `H` is a *normal* subgroup of `Gal(L/ℚ)`, and `L` is CM iff every conjugate
`ρ⁻¹ * τ * ρ` of `τ` equals `τ` — the two-element case of the criterion.
-/

namespace Work.HilbertTowerCM

open NumberField

/-- **The subgroup generated by the complex conjugations of `L/ℚ` is the normal closure of any one
of them.**  If `τ` is the complex conjugation under some embedding `φ₀` of the Galois number field
`L/ℚ`, then the subgroup of `Gal(L/ℚ)` generated by the conjugations `σ` at *all* embeddings
equals the subgroup generated by the `Gal(L/ℚ)`-conjugates `ρ⁻¹ * τ * ρ` of `τ`. -/
theorem conjugationSubgroup_eq_conjugates (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] [NumberField.IsTotallyComplex L] (τ : L ≃ₐ[ℚ] L) (φ₀ : L →+* ℂ)
    (hτ : NumberField.ComplexEmbedding.IsConj φ₀ τ) :
    Subgroup.closure {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ σ} =
      Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ ρ : L ≃ₐ[ℚ] L, g = ρ⁻¹ * τ * ρ} := by
  -- It suffices to show that the two *sets* are equal: the set of all conjugations of `L` is
  -- precisely the set of conjugates of the single conjugation `τ`.
  have hset : {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ σ} =
      {g : L ≃ₐ[ℚ] L | ∃ ρ : L ≃ₐ[ℚ] L, g = ρ⁻¹ * τ * ρ} := by
    ext σ
    constructor
    · -- A conjugation `σ` at the embedding `φ`: write `φ = φ₀.comp ν` with `ν` in the Galois
      -- group, then `σ` and `ν⁻¹ * τ * ν` are both conjugations at the same embedding.
      rintro ⟨φ, hφ⟩
      have hcomp : φ₀.comp (algebraMap ℚ L) = φ.comp (algebraMap ℚ L) := by ext q; simp
      obtain ⟨σ', hσ'⟩ :=
        NumberField.ComplexEmbedding.exists_comp_symm_eq_of_comp_eq (k := ℚ) φ₀ φ hcomp
      refine ⟨σ'.symm, ?_⟩
      have h1 : NumberField.ComplexEmbedding.IsConj (φ₀.comp σ'.symm) σ := by rw [hσ']; exact hφ
      have h2 : NumberField.ComplexEmbedding.IsConj (φ₀.comp σ'.symm) ((σ'.symm)⁻¹ * τ * σ'.symm) :=
        hτ.comp σ'.symm
      exact h1.ext h2
    · -- Conversely every conjugate of `τ` is a conjugation: `IsConj.comp`.
      rintro ⟨ρ, rfl⟩
      exact ⟨φ₀.comp ρ, hτ.comp ρ⟩
  rw [hset]

end Work.HilbertTowerCM
