import Mathlib
import Submission.Work.HilbertTowerCM.finrank_realPart_eq_card_conj

/-!
# A Galois level whose conjugation subgroup has order `> 2` is not CM

Let `L/ℚ` be a totally complex Galois number field and let

`H = ⟨{σ : Gal(L/ℚ) | ∃ φ : L →+* ℂ, IsConj φ σ}⟩`

be the subgroup of `Gal(L/ℚ)` generated by the complex conjugations of `L` (the complex
conjugation is only defined up to conjugacy, so the natural invariant is the subgroup it
generates).

`Work.HilbertTowerCM.finrank_realPart_eq_card_conj` computes the degree of `L` over its maximal
real subfield `L⁺` as the order of this subgroup:

`[L : L⁺] = |H|`.

By definition (`NumberField.IsCMField`) a CM field is a *quadratic* extension of its maximal real
subfield, i.e. `[L : L⁺] = 2`.  Hence `|H| > 2` forces `L` not to be CM: the conjugation subgroup
is too large for `L` to be a quadratic extension of `L⁺`.  This is the machine-checked obstruction
recorded in `Work/HilbertTowerCM/README.md` (e.g. the Hilbert class field of `ℚ(√-39)` has
`[L : L⁺] = 4`).
-/

set_option linter.style.haveILetI false

namespace Work.HilbertTowerCM

open NumberField

/-- **A totally complex Galois level with conjugation subgroup of order `> 2` is not CM.**
Indeed `[L : L⁺] = |H|` and CM-ness means `[L : L⁺] = 2`. -/
theorem not_isCMField_of_card_conj_gt_two (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] [NumberField.IsTotallyComplex L]
    (hcard : 2 < Nat.card (Subgroup.closure {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ,
      NumberField.ComplexEmbedding.IsConj φ σ})) : ¬ NumberField.IsCMField L := by
  intro hcm
  haveI := hcm
  -- CM-ness says that `L` is quadratic over its maximal real subfield.
  have hfin : Module.finrank ↥(NumberField.maximalRealSubfield L) L = 2 :=
    Algebra.IsQuadraticExtension.finrank_eq_two _ _
  -- ... and the degree over the maximal real subfield is the order of the conjugation subgroup.
  have hcard' := finrank_realPart_eq_card_conj L
  rw [hfin] at hcard'
  omega

end Work.HilbertTowerCM
