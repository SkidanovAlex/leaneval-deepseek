import Mathlib
import Submission.Work.HilbertTowerCM.realPart_finrank_eq_index_squares
import Submission.Work.HilbertTowerCM.card_closure_conjugates_of_inversion

/-!
# `Work.HilbertTowerCM.isCMField_iff_squares_bot_of_inverting`

The exact CM criterion for a totally complex Galois number field `L/ℚ` on which complex
conjugation **inverts** a co-index-`2` subgroup `A ≤ Gal(L/ℚ)`.

## The hypothesis package

`τ : Gal(L/ℚ)` is an involution (`τ * τ = 1`) which is the complex conjugation at some complex
embedding `φ₀` (`ComplexEmbedding.IsConj φ₀ τ`), `A ≤ Gal(L/ℚ)` is a subgroup with

* `τ ∉ A` and `G = A ∪ A τ` (`hcover`), i.e. `[G : A] = 2`;
* `τ a τ⁻¹ = a⁻¹` for all `a ∈ A` (`hcomm`), i.e. `τ` inverts `A` (the classical statement that
  complex conjugation acts as inversion on the abelian levels of the `2`-class field tower over
  an imaginary quadratic field);
* `[L : ℚ] = 2 |A|` (`hdeg`), i.e. `|Gal(L/ℚ)| = 2 |A|`.

## The conclusion

`L` is CM **iff** the subgroup generated by the squares of `A` is trivial, i.e. iff `A` is an
elementary abelian `2`-group:

`NumberField.IsCMField L ↔ ⟨{a² | a ∈ A}⟩ = ⊥`.

## Proof

`Work.HilbertTowerCM.card_closure_conjugates_of_inversion` shows that the normal closure of `τ`
in `G` has order `2 |T|` for `T = ⟨{a² | a ∈ A}⟩`, and the normal closure of a complex conjugation
is the subgroup generated by all complex conjugations
(`Work.HilbertTowerCM.conjugationSubgroup_eq_conjugates`), whose order is `[L : L⁺]`
(`Work.HilbertTowerCM.finrank_realPart_eq_card_conj`).  Hence

`[L : L⁺] = 2 |T|`.

Now `NumberField.IsCMField L` says exactly that `L` is a quadratic extension of its maximal real
subfield, i.e. `[L : L⁺] = 2` (the total-complexity half of the CM class is a hypothesis of the
statement).  So `L` is CM iff `2 |T| = 2` iff `|T| = 1` iff `T = ⊥`.

Note that the degree hypothesis `hdeg` is not needed: the equivalence is governed entirely by
`[L : L⁺] = 2 |A²|`.
-/

namespace Work.HilbertTowerCM

open NumberField

-- `hdeg` is part of the requested hypothesis package but is not needed: the equivalence is
-- governed by `[L : L⁺] = 2 |A²|` alone.
set_option linter.unusedVariables false in

noncomputable section

/-- **The CM criterion for an inverting complex conjugation.**  A totally complex Galois number
field `L/ℚ` on which an involution `τ` that is a complex conjugation acts by inversion on a
co-index-`2` subgroup `A ≤ Gal(L/ℚ)` is CM exactly when the subgroup generated by the squares of
`A` is trivial — equivalently, exactly when `A` is elementary abelian. -/
theorem isCMField_iff_squares_bot_of_inverting (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] [NumberField.IsTotallyComplex L] (τ : L ≃ₐ[ℚ] L) (φ₀ : L →+* ℂ)
    (hτ : NumberField.ComplexEmbedding.IsConj φ₀ τ) (hτ2 : τ * τ = 1)
    (A : Subgroup (L ≃ₐ[ℚ] L)) (hτA : τ ∉ A)
    (hcover : ∀ g : L ≃ₐ[ℚ] L, g ∈ A ∨ ∃ a : A, g = (a : L ≃ₐ[ℚ] L) * τ)
    (hcomm : ∀ a : A, τ * (a : L ≃ₐ[ℚ] L) * τ⁻¹ = (a : L ≃ₐ[ℚ] L)⁻¹)
    (hdeg : Module.finrank ℚ L = 2 * Nat.card A) :
    NumberField.IsCMField L ↔
      Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ a : A, g = (a : L ≃ₐ[ℚ] L) ^ 2} = ⊥ := by
  classical
  -- The subgroup generated by the squares of `A`.
  set T : Subgroup (L ≃ₐ[ℚ] L) :=
    Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ a : A, g = (a : L ≃ₐ[ℚ] L) ^ 2} with hTdef
  -- Reindex the normal closure of `τ` as the conjugates `x τ x⁻¹`.
  have hreindex : {g : L ≃ₐ[ℚ] L | ∃ ρ : L ≃ₐ[ℚ] L, g = ρ⁻¹ * τ * ρ} =
      {g : L ≃ₐ[ℚ] L | ∃ x : L ≃ₐ[ℚ] L, g = x * τ * x⁻¹} := by
    ext g; constructor
    · rintro ⟨ρ, rfl⟩; exact ⟨ρ⁻¹, by rw [inv_inv]⟩
    · rintro ⟨x, rfl⟩; exact ⟨x⁻¹, by rw [inv_inv]⟩
  -- The normal closure of `τ` has order `2 |T|`.
  have hcard : Nat.card (Subgroup.closure {g : L ≃ₐ[ℚ] L | ∃ x : L ≃ₐ[ℚ] L, g = x * τ * x⁻¹}) =
      2 * Nat.card T := by
    rw [hTdef]
    exact card_closure_conjugates_of_inversion (G := L ≃ₐ[ℚ] L) A τ hτA hτ2 hcover hcomm
  -- The order of the normal closure of `τ` is `[L : L⁺]`.
  have hd : Module.finrank ↥(NumberField.maximalRealSubfield L) L = 2 * Nat.card T := by
    rw [finrank_realPart_eq_card_conj L,
      conjugationSubgroup_eq_conjugates L τ φ₀ hτ, hreindex]
    exact hcard
  -- `T` is trivial iff its order is `1`.
  have hTbot : T = ⊥ ↔ Nat.card T = 1 := by
    constructor
    · intro h
      rw [h]
      exact Nat.card_eq_one_iff_exists.mpr ⟨1, fun y => by
        apply Subtype.ext
        simpa using Subgroup.mem_bot.mp y.2⟩
    · intro h
      have hs : Subsingleton T := (Nat.card_eq_one_iff_unique.mp h).1
      refine (Subgroup.eq_bot_iff_forall T).mpr (fun x hx => ?_)
      exact congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : T) ⟨1, T.one_mem⟩)
  rw [hTbot]
  -- A CM-field is a quadratic extension of its maximal real subfield, so `[L : L⁺] = 2`.
  constructor
  · intro hCM
    have h2 : 2 * Nat.card T = 2 := by
      rw [← hd]
      exact hCM.is_quadratic.finrank_eq_two'
    omega
  · intro ht
    have h2 : Module.finrank ↥(NumberField.maximalRealSubfield L) L = 2 := by
      rw [hd, ht, mul_one]
    exact NumberField.IsCMField.mk
      (is_quadratic := Algebra.IsQuadraticExtension.mk h2)

end

end Work.HilbertTowerCM
