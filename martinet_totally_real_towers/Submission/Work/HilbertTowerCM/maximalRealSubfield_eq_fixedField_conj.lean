import Mathlib
import Submission.Work.HilbertTowerCM.exists_isConj_of_isGalois

/-!
# The maximal real subfield is the fixed field of the conjugations

For a Galois number field `L/ℚ`, Mathlib's maximal real subfield

`NumberField.maximalRealSubfield L = {x | ∀ φ : L →+* ℂ, star (φ x) = φ x}`

coincides with the fixed field of the subgroup of `Gal(L/ℚ)` generated by the elements which are
the complex conjugation at *some* embedding, i.e. by `σ` with `IsConj φ σ` for some
`φ : L →+* ℂ` (`NumberField.ComplexEmbedding.IsConj φ σ` means `conjugate φ = φ.comp σ`).

The point is that the set of conjugations need not be a subgroup (it is the conjugacy class of
the complex conjugation, hence generates its normal closure), so it has to be closed up under
products: this is precisely the closure appearing in the statement.

The proof is immediate from the two definitions:
* if `x` is real at every embedding and `IsConj φ σ`, then `φ (σ x) = star (φ x) = φ x`, hence
  `σ x = x` by injectivity of `φ`; the set `{σ | σ x = x}` is the stabilizer of `x`, a subgroup,
  so it contains the whole closure;
* conversely, if `x` is fixed by every element of the closure, then in particular it is fixed by
  a conjugation `σ` at any prescribed embedding `φ` (which exists because `L/ℚ` is Galois), so
  `star (φ x) = φ (σ x) = φ x`.

This is the structural input of the CM endgame of `Work.HilbertTowerCM`: it identifies the
maximal real subfield of a level of an unramified tower with a fixed field, making
`IntermediateField.finrank_fixedField_eq_card` available for it.
-/

namespace Work.HilbertTowerCM

theorem maximalRealSubfield_eq_fixedField_conj (L : Type*) [Field L] [NumberField L]
    [IsGalois ℚ L] :
    (NumberField.maximalRealSubfield L : Set L) =
      (IntermediateField.fixedField (Subgroup.closure {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ,
        NumberField.ComplexEmbedding.IsConj φ σ}) : Set L) := by
  ext x
  simp only [SetLike.mem_coe, NumberField.mem_maximalRealSubfield_iff,
    IntermediateField.mem_fixedField_iff]
  constructor
  · -- A real element is fixed by every conjugation, hence by the closure.
    intro hx σ hσ
    have hsub : {σ : L ≃ₐ[ℚ] L | ∃ φ : L →+* ℂ, NumberField.ComplexEmbedding.IsConj φ σ}
        ⊆ (MulAction.stabilizer (L ≃ₐ[ℚ] L) x : Set (L ≃ₐ[ℚ] L)) := by
      rintro σ ⟨φ, hφ⟩
      change σ ∈ MulAction.stabilizer (L ≃ₐ[ℚ] L) x
      rw [MulAction.mem_stabilizer_iff]
      exact φ.injective ((hφ.eq x).trans (hx φ))
    have hmem := (Subgroup.closure_le (MulAction.stabilizer (L ≃ₐ[ℚ] L) x)).mpr hsub hσ
    simpa using hmem
  · -- An element fixed by the closure is real at every embedding.
    intro hx φ
    obtain ⟨σ, hσ⟩ := exists_isConj_of_isGalois L φ
    have hσx : σ x = x := hx σ (Subgroup.subset_closure ⟨φ, hσ⟩)
    rw [← hσ.eq x, hσx]

end Work.HilbertTowerCM
