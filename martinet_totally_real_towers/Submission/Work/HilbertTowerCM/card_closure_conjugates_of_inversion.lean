import Mathlib

/-!
# The normal closure of an inverting involution has twice the order of the square subgroup

Let `G` be a finite group, `A ≤ G` a subgroup, and `τ ∉ A` an involution (`τ * τ = 1`) such that

* `G = A ∪ A τ` (`hcover`), and
* `τ` inverts `A` (`hcomm`).

Then `A` has index `2` in `G` and `G = A ⋊ ⟨τ⟩`.  Writing

* `S = ⟨x τ x⁻¹ | x ∈ G⟩` for the normal closure of `τ`, and
* `T = ⟨a ^ 2 | a ∈ A⟩` for the subgroup generated by the squares of `A`,

we have `S = T ∪ T τ` (disjoint union), hence `|S| = 2 * |T|`.

Indeed every conjugate `x τ x⁻¹` equals `c ^ 2 * τ` for some `c ∈ A` (with `x ∈ A` or
`x = a τ`), while `τ ∈ S` and `a ^ 2 = (a τ a⁻¹) · τ`, so `S = ⟨T, τ⟩ = T ∪ T τ`.
-/

open scoped Pointwise

namespace Work.HilbertTowerCM

theorem card_closure_conjugates_of_inversion {G : Type*} [Group G] [Fintype G] (A : Subgroup G)
    (τ : G) (hτ : τ ∉ A) (hτ2 : τ * τ = 1)
    (hcover : ∀ g : G, g ∈ A ∨ ∃ a : A, g = (a : G) * τ)
    (hcomm : ∀ a : A, τ * (a : G) * τ⁻¹ = (a : G)⁻¹) :
    Nat.card (Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹}) =
      2 * Nat.card (Subgroup.closure {g : G | ∃ a : A, g = (a : G) ^ 2}) := by
  set S : Subgroup G := Subgroup.closure {g : G | ∃ x : G, g = x * τ * x⁻¹} with hSdef
  set T : Subgroup G := Subgroup.closure {g : G | ∃ a : A, g = (a : G) ^ 2} with hTdef
  have hτinv : τ⁻¹ = τ := inv_eq_of_mul_eq_one_right hτ2
  -- `τ` inverts every element of `A`
  have hcommA : ∀ y : G, y ∈ A → τ * y * τ = y⁻¹ := by
    intro y hy
    have := hcomm ⟨y, hy⟩
    simpa only [hτinv] using this
  have hτinvA : ∀ y : G, y ∈ A → τ * y⁻¹ * τ = y := by
    intro y hy
    have h := hcommA y⁻¹ (A.inv_mem hy)
    simpa using h
  have htauA : ∀ y : G, y ∈ A → τ * y = y⁻¹ * τ := by
    intro y hy
    calc τ * y = (τ * y * τ) * τ := by rw [mul_assoc, hτ2, mul_one]
      _ = y⁻¹ * τ := by rw [hcommA y hy]
  have hconjA : ∀ y : G, y ∈ A → y * τ * y⁻¹ = y ^ 2 * τ := by
    intro y hy
    calc y * τ * y⁻¹ = y * τ * y⁻¹ * (τ * τ) := by rw [hτ2, mul_one]
      _ = y * (τ * y⁻¹ * τ) * τ := by group
      _ = y * y * τ := by rw [hτinvA y hy]
      _ = y ^ 2 * τ := by rw [pow_two]
  have hconjA2 : ∀ y : G, y ∈ A → (y * τ) * τ * (y * τ)⁻¹ = y ^ 2 * τ := by
    intro y hy
    have hinv : (y * τ)⁻¹ = τ * y⁻¹ := by rw [mul_inv_rev, hτinv]
    calc (y * τ) * τ * (y * τ)⁻¹ = y * τ * τ * (τ * y⁻¹) := by rw [hinv]
      _ = y * τ * (τ * τ) * y⁻¹ := by group
      _ = y * τ * y⁻¹ := by rw [hτ2]; group
      _ = y ^ 2 * τ := hconjA y hy
  have hinvA : ∀ y : G, y ∈ A → (y * τ)⁻¹ = y * τ := by
    intro y hy
    rw [mul_inv_rev, hτinv, htauA y⁻¹ (A.inv_mem hy), inv_inv]
  have hτS : τ ∈ S :=
    hSdef.symm ▸ Subgroup.subset_closure (⟨(1 : G), by simp⟩ : ∃ x : G, τ = x * τ * x⁻¹)
  have hTA : T ≤ A := by
    rw [hTdef, Subgroup.closure_le]
    rintro x ⟨a, rfl⟩
    exact A.pow_mem a.2 2
  have hTS : T ≤ S := by
    rw [Subgroup.closure_le]
    rintro x ⟨a, rfl⟩
    have h : ((a : G) * τ * (a : G)⁻¹) * τ = (a : G) ^ 2 := by
      rw [hconjA (a : G) a.2, mul_assoc, hτ2, mul_one]
    rw [← h]
    exact S.mul_mem
      (hSdef.symm ▸ Subgroup.subset_closure
        (⟨(a : G), rfl⟩ : ∃ y : G, (a : G) * τ * (a : G)⁻¹ = y * τ * y⁻¹)) hτS
  have hmul_mem : ∀ x : G, x ∈ (T : Set G) * ({τ} : Set G) ↔ ∃ t ∈ T, x = t * τ := by
    intro x
    rw [Set.mul_singleton]
    constructor
    · rintro ⟨t, ht, h⟩; exact ⟨t, ht, h.symm⟩
    · rintro ⟨t, ht, h⟩; exact ⟨t, ht, h.symm⟩
  have hsqT : ∀ a : A, (a : G) ^ 2 ∈ T := fun a =>
    hTdef.symm ▸ Subgroup.subset_closure (⟨a, rfl⟩ : ∃ b : A, (a : G) ^ 2 = (b : G) ^ 2)
  -- every element of `S` lies in `T ∪ T τ`
  have hkey : ∀ g : G, g ∈ S → g ∈ (T : Set G) ∪ ((T : Set G) * ({τ} : Set G)) := by
    intro g hg
    rw [hSdef] at hg
    refine Subgroup.closure_induction
      (p := fun y _ => y ∈ (T : Set G) ∪ ((T : Set G) * ({τ} : Set G))) ?_ ?_ ?_ ?_ hg
    · rintro y ⟨x, rfl⟩
      rcases hcover x with hx | ⟨a, rfl⟩
      · refine Or.inr ?_
        rw [hmul_mem]
        exact ⟨x ^ 2, hsqT ⟨x, hx⟩, hconjA x hx⟩
      · refine Or.inr ?_
        rw [hmul_mem]
        exact ⟨(a : G) ^ 2, hsqT a, hconjA2 (a : G) a.2⟩
    · exact Or.inl T.one_mem
    · rintro x y _ _ (hx | hx) (hy | hy)
      · exact Or.inl (T.mul_mem hx hy)
      · rw [hmul_mem] at hy
        obtain ⟨s, hs, rfl⟩ := hy
        refine Or.inr ?_
        rw [hmul_mem]
        exact ⟨x * s, T.mul_mem hx hs, by group⟩
      · rw [hmul_mem] at hx
        obtain ⟨t, ht, rfl⟩ := hx
        refine Or.inr ?_
        rw [hmul_mem]
        refine ⟨t * y⁻¹, T.mul_mem ht (T.inv_mem hy), ?_⟩
        calc (t * τ) * y = t * (τ * y) := by group
          _ = t * (y⁻¹ * τ) := by rw [htauA y (hTA hy)]
          _ = (t * y⁻¹) * τ := by group
      · rw [hmul_mem] at hx hy
        obtain ⟨t, ht, rfl⟩ := hx
        obtain ⟨s, hs, rfl⟩ := hy
        refine Or.inl ?_
        have heq : (t * τ) * (s * τ) = t * s⁻¹ := by
          calc (t * τ) * (s * τ) = t * (τ * s) * τ := by group
            _ = t * (s⁻¹ * τ) * τ := by rw [htauA s (hTA hs)]
            _ = t * s⁻¹ := by rw [mul_assoc]; congr 1; rw [mul_assoc, hτ2, mul_one]
        rw [heq]
        exact T.mul_mem ht (T.inv_mem hs)
    · rintro x _ (hx | hx)
      · exact Or.inl (T.inv_mem hx)
      · rw [hmul_mem] at hx
        obtain ⟨t, ht, rfl⟩ := hx
        refine Or.inr ?_
        rw [hmul_mem]
        exact ⟨t, ht, hinvA t (hTA ht)⟩
  have hSset : (S : Set G) = (T : Set G) ∪ ((T : Set G) * ({τ} : Set G)) := by
    refine Set.Subset.antisymm ?_ ?_
    · intro g hg; exact hkey g hg
    · intro g hg
      rcases hg with hg | hg
      · exact hTS hg
      · rw [hmul_mem] at hg
        obtain ⟨t, ht, rfl⟩ := hg
        exact S.mul_mem (hTS ht) hτS
  have hdisj : Disjoint (T : Set G) ((T : Set G) * ({τ} : Set G)) := by
    rw [Set.disjoint_left]
    intro x hx hx2
    rw [hmul_mem] at hx2
    obtain ⟨t, ht, rfl⟩ := hx2
    have h : t⁻¹ * (t * τ) ∈ T := T.mul_mem (T.inv_mem ht) hx
    have hmem : τ ∈ T := by rwa [inv_mul_cancel_left] at h
    exact hτ (hTA hmem)
  have hcard : (S : Set G).ncard = (T : Set G).ncard + (T : Set G).ncard := by
    rw [hSset, Set.ncard_union_eq hdisj, Set.mul_singleton,
      Set.ncard_image_of_injective _ (mul_left_injective τ)]
  have h1 : Nat.card S = (S : Set G).ncard := Nat.card_coe_set_eq (S : Set G)
  have h2 : Nat.card T = (T : Set G).ncard := Nat.card_coe_set_eq (T : Set G)
  rw [h1, hcard, h2, Nat.two_mul]

end Work.HilbertTowerCM

