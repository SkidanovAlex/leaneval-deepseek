import Mathlib
import Submission.Work.CFT.ClassFormation.Defs

open scoped TensorProduct

namespace Work.CFT.ClassFormation

/-- **`rankP` is invariant under additive isomorphisms.**  If `A ≃+ B` then
`dim_𝔽_p (𝔽_p ⊗_ℤ A) = dim_𝔽_p (𝔽_p ⊗_ℤ B)`.  Proof: `e` induces the `ℤ`-linear isomorphism
`id ⊗ e : 𝔽_p ⊗ A ≃ₗ[ℤ] 𝔽_p ⊗ B`, which is automatically `𝔽_p`-linear for the (left) `𝔽_p`-module
structures, so `LinearEquiv.finrank_eq` applies. -/
theorem rankP_eq_of_addEquiv (p : ℕ) {A B : Type} [AddCommGroup A] [AddCommGroup B]
    (e : A ≃+ B) : Work.CFT.ClassFormation.rankP p A = Work.CFT.ClassFormation.rankP p B := by
  -- `e` is a `ℤ`-linear equivalence, so it induces one on the base-changed modules
  have F : (ZMod p ⊗[ℤ] A) ≃ₗ[ℤ] (ZMod p ⊗[ℤ] B) :=
    TensorProduct.congr (LinearEquiv.refl ℤ (ZMod p)) e.toIntLinearEquiv
  -- any additive equivalence between `ZMod p`-modules is automatically `ZMod p`-linear,
  -- since `ZMod p` is generated by `1` as an additive group (`ZMod.map_smul`, valid for all `p`,
  -- including `p = 0` where `ZMod 0 = ℤ` and `p = 1` where `ZMod 1` is the zero ring)
  have F' : (ZMod p ⊗[ℤ] A) ≃ₗ[ZMod p] (ZMod p ⊗[ℤ] B) :=
    F.toAddEquiv.toLinearEquiv fun c x ↦ ZMod.map_smul F.toAddEquiv.toAddMonoidHom c x
  exact LinearEquiv.finrank_eq F'

end Work.CFT.ClassFormation
