import Mathlib
import Submission.Work.ProPGS.CommonsBridge
import Submission.Work.HopfGaschutz.finite_quotient_relFrattiniIn

/-!
# `Work.ProPGS.exists_spanning_relFrattini_card_h2DimOf`

**Namespace** `Work.ProPGS`; module
`Submission.Work.ProPGS.exists_spanning_relFrattini_card_h2DimOf`.

The two halves of the relation-rank dictionary that *hold unconditionally* (i.e. without the open
efficiency statement `Work.HopfGaschutz.GaschutzDictionary`):

* the **extraction** statement: for `K = ker (FreeGroup.lift gen)` the relation-Frattini quotient
  `K ⧸ K^p[K,F]` is an elementary abelian `p`-group, of cardinality `p ^ h2DimOf p α Q gen`
  (`Work.HopfGaschutz.relFrattiniDim`), and a basis of it lifts to a `Finset` `S` of `K` of that
  cardinality which *spans* `K` modulo `K^p[K,F]`:

    `K ≤ Subgroup.closure (S : Set (FreeGroup α)) ⊔ relFrattini p K`.

  Note the *ordinary* (not normal) closure: this is the statement that the images of `S` generate
  the `𝔽_p`-space `K ⧸ K^p[K,F]`, which is a tautology once a basis has been chosen.  Replacing
  `Subgroup.closure` by `Subgroup.normalClosure` is the *open* efficiency problem
  (`Work.HopfGaschutz.Counterexample`, `Work.RelatorRank.Dictionary`); with the plain `closure` it
  is a theorem of this workspace.
* the **finiteness** of that quotient (`K` has finite index in the finitely generated free group
  `FreeGroup α`), in general `p` -- the `p = 2` case is
  `Work.HopfGaschutz.finite_quotient_relFrattiniIn_of_finiteIndex`; here the exponent-`2` counting
  argument is replaced by the exponent-`p` one.

## Proof shape

`V := K ⧸ K^p[K,F]` is a finite group (`finite_relFrattiniIn_quotient_of_finiteIndex`), commutative
(`[K,K] ≤ [K,F]`), of exponent dividing `p` (`K^p ≤ K^p[K,F]`), hence a finite `𝔽_p`-vector space
`Additive V`; a basis (`Module.finBasis`) has `Nat.log p (Nat.card V)` vectors
(`Nat.card V = p ^ finrank` and `Nat.log_pow`), and lifting a basis along the surjection
`K ↠ V` gives the desired spanning set.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped IsMulCommutative
open scoped commutatorElement
open Module

namespace Work.ProPGS

/-! ## Finiteness of the relation-Frattini quotient -/

/-- **Finiteness of the relation-Frattini quotient.**  For a finite-index normal subgroup `K` of a
finitely generated free group `FreeGroup α`, the elementary abelian `p`-group `K ⧸ K^p[K,F]` is
finite: it is a finitely generated commutative group of exponent dividing `p`
(`card_dvd_exponent_pow_rank'`), `K` being finitely generated by Schreier's lemma
(`Subgroup.fg_of_index_ne_zero`). -/
theorem finite_relFrattiniIn_quotient_of_finiteIndex {α : Type*} [Fintype α] (p : ℕ)
    [Fact p.Prime] (K : Subgroup (FreeGroup α)) [K.Normal] [K.FiniteIndex] :
    Finite (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K) := by
  classical
  haveI hfgF : Group.FG (FreeGroup α) := by
    rw [Group.fg_iff]
    exact ⟨Set.range FreeGroup.of, FreeGroup.closure_range_of α, Set.finite_range _⟩
  haveI hfgK : Group.FG ↥K := Subgroup.fg_of_index_ne_zero K
  have hcomm : commutator ↥K ≤ Work.HopfGaschutz.relFrattiniIn p K := by
    show ⁅⊤, ⊤⁆ ≤ Work.HopfGaschutz.relFrattiniIn p K
    rw [Subgroup.commutator_le]
    intro x _ y _
    rw [Work.HopfGaschutz.mem_relFrattiniIn]
    show ⁅(x : FreeGroup α), (y : FreeGroup α)⁆ ∈ Work.HopfGaschutz.relFrattini p K
    exact Subgroup.mem_sup_right (Subgroup.commutator_mem_commutator x.2 (Subgroup.mem_top y))
  haveI : IsMulCommutative (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  haveI : Group.FG (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K) :=
    Group.fg_of_surjective (QuotientGroup.mk'_surjective _)
  have hp : ∀ x : (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K), x ^ p = 1 := by
    intro x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn p K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    rw [Work.HopfGaschutz.mem_relFrattiniIn]
    exact Work.HopfGaschutz.pow_mem_relFrattini p K y.2
  have hcard := card_dvd_exponent_pow_rank' _ (n := p) hp
  exact Nat.finite_of_card_ne_zero
    (Nat.pos_of_dvd_of_pos hcard (pow_pos (Fact.out : p.Prime).pos _)).ne'

/-! ## Generating families of finite elementary abelian `p`-groups -/

/-- **A basis is a generating family of the predicted size.**  A finite `𝔽_p`-vector space `W` is
generated (additively) by its basis, whose cardinality is `Module.finrank (ZMod p) W`. -/
private theorem exists_injective_generating_of_module {p : ℕ} [Fact p.Prime] {W : Type*}
    [AddCommGroup W] [Module (ZMod p) W] [Module.Finite (ZMod p) W] [Fintype W] :
    ∃ v : Fin (Module.finrank (ZMod p) W) → W, Function.Injective v ∧
      AddSubgroup.closure (Set.range v) = ⊤ := by
  let b := Module.finBasis (ZMod p) W
  refine ⟨b, b.linearIndependent.injective, ?_⟩
  rw [eq_top_iff]
  intro x _
  rw [← b.sum_repr x]
  refine AddSubgroup.sum_mem _ (fun j _ => ?_)
  rw [← ZMod.natCast_zmod_val (b.repr x j), Nat.cast_smul_eq_nsmul]
  exact AddSubgroup.nsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self j)) _

/-- **A finite commutative group of exponent dividing `p` is generated by
`Nat.log p (Nat.card V)` elements.**  `Additive V` is a finite `𝔽_p`-vector space of dimension
`Nat.log p (Nat.card V)`, and a basis realises the minimal generation. -/
private theorem exists_injective_generating_family {p : ℕ} [Fact p.Prime] {V : Type*} [Group V]
    [Fintype V] (hcomm : ∀ x y : V, x * y = y * x) (hp : ∀ x : V, x ^ p = 1) :
    ∃ v : Fin (Nat.log p (Nat.card V)) → V, Function.Injective v ∧
      Subgroup.closure (Set.range v) = ⊤ := by
  classical
  letI : CommGroup V := { ‹Group V› with mul_comm := hcomm }
  have hzero : ∀ x : Additive V, p • x = 0 := fun x => hp x
  letI hmod : Module (ZMod p) (Additive V) := AddCommGroup.zmodModule hzero
  haveI hfin : Module.Finite (ZMod p) (Additive V) := Module.Finite.of_finite
  obtain ⟨v, hvinj, hvtop⟩ :=
    @exists_injective_generating_of_module p _ (Additive V) _ hmod hfin _
  have hcard : Nat.card V = p ^ Module.finrank (ZMod p) (Additive V) := by
    have h := @Module.natCard_eq_pow_finrank (ZMod p) (Additive V) _ _ hmod hfin
    simp only [Nat.card_eq_fintype_card, ZMod.card] at h
    simpa using h
  have hlog : Nat.log p (Nat.card V) = Module.finrank (ZMod p) (Additive V) := by
    rw [hcard, Nat.log_pow (Fact.out : p.Prime).one_lt]
  refine ⟨fun i => Additive.toMul (v (Fin.cast hlog i)), ?_, ?_⟩
  · intro i j hij
    refine Fin.cast_injective hlog (hvinj ?_)
    simpa using hij
  · have hrange : Set.range (fun i => v (Fin.cast hlog i)) = Set.range v := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨Fin.cast hlog i, rfl⟩
      · rintro ⟨j, rfl⟩
        exact ⟨Fin.cast hlog.symm j, by simp⟩
    have hA : AddSubgroup.closure (Set.range fun i => v (Fin.cast hlog i)) = ⊤ := by
      rw [hrange, hvtop]
    have hT : Additive.toMul ⁻¹' Set.range (fun i => Additive.toMul (v (Fin.cast hlog i)))
        = Set.range (fun i => v (Fin.cast hlog i)) := by
      ext y; simp [Set.mem_range]
    have hsub : (Subgroup.closure (Set.range fun i =>
        Additive.toMul (v (Fin.cast hlog i)))).toAddSubgroup = ⊤ := by
      rw [Subgroup.toAddSubgroup_closure, hT, hA]
    exact Subgroup.toAddSubgroup.injective
      (hsub.trans (OrderIso.map_top (Subgroup.toAddSubgroup)).symm)

/-- A subgroup which maps onto the whole quotient already contains the kernel: if `f : G →* H`,
`M ≤ G`, `f.ker ≤ M` and `M.map f = ⊤`, then `M = ⊤`. -/
private lemma eq_top_of_map_eq_top_of_ker_le {G H : Type*} [Group G] [Group H] (f : G →* H)
    (M : Subgroup G) (hker : f.ker ≤ M) (hmap : M.map f = ⊤) : M = ⊤ := by
  rw [eq_top_iff]
  intro x _
  have hx : f x ∈ M.map f := by rw [hmap]; trivial
  obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp hx
  have hmem : m⁻¹ * x ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hmx, inv_mul_cancel]
  have h2 : m⁻¹ * x ∈ M := hker hmem
  have hx' : x = m * (m⁻¹ * x) := by group
  rw [hx']
  exact M.mul_mem hm h2

/-! ## Lifting a basis of the relation-Frattini quotient to a spanning set of `K` -/

/-- **The extraction statement.**  If the relation-Frattini quotient `K ⧸ K^p[K,F]` of a normal
subgroup `K ⊴ F` is finite, then there is a finite set `S ⊆ K` with

`S.card = Nat.log p (Nat.card (K ⧸ K^p[K,F]))`,  `S ⊆ K`,  and
`K ≤ Subgroup.closure (S : Set F) ⊔ relFrattini p K`,

i.e. `S` spans `K` modulo the relation-Frattini subgroup.  The proof lifts a basis of the
`𝔽_p`-vector space `K ⧸ K^p[K,F]` along the quotient map. -/
private lemma exists_finset_spanning_of_quotient_card {F : Type*} [Group F] (K : Subgroup F)
    [K.Normal] (p : ℕ) [Fact p.Prime] [Finite (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K)] :
    ∃ S : Finset F, S.card = Nat.log p (Nat.card (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K)) ∧
      (S : Set F) ⊆ K ∧
      K ≤ Subgroup.closure (S : Set F) ⊔ Work.HopfGaschutz.relFrattini p K := by
  classical
  haveI : Fintype (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K) := Fintype.ofFinite _
  haveI hN : (Work.HopfGaschutz.relFrattiniIn p K).Normal := Work.HopfGaschutz.relFrattiniIn_normal p K
  have hcomm : ∀ x y : (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K), x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn p K) x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn p K) y
    rw [← commutatorElement_eq_one_iff_mul_comm]
    rw [← map_commutatorElement (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K)) a b]
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ Work.HopfGaschutz.relFrattini p K
    rw [map_commutatorElement (Subgroup.subtype K) a b]
    exact Work.HopfGaschutz.commutator_mem_relFrattini p K a.2
  have hpow : ∀ x : (↥K ⧸ Work.HopfGaschutz.relFrattiniIn p K), x ^ p = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn p K) x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    show (Subgroup.subtype K) (a ^ p) ∈ Work.HopfGaschutz.relFrattini p K
    rw [map_pow]
    exact Work.HopfGaschutz.pow_mem_relFrattini p K a.2
  obtain ⟨v, hvinj, hvtop⟩ := exists_injective_generating_family hcomm hpow
  choose w hw using fun i =>
    QuotientGroup.mk'_surjective (Work.HopfGaschutz.relFrattiniIn p K) (v i)
  have hinj : Function.Injective (fun i => (w i : F)) := by
    intro i j hij
    have h1 : w i = w j := Subtype.ext hij
    have h2 : (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K)) (w i)
        = (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K)) (w j) := by rw [h1]
    rw [hw i, hw j] at h2
    exact hvinj h2
  refine ⟨Finset.univ.image (fun i => (w i : F)), ?_, ?_, ?_⟩
  · rw [Finset.card_image_of_injective _ hinj, Finset.card_univ]
    simp
  · intro s hs
    obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hs
    exact (w i).2
  · set M : Subgroup F :=
        Subgroup.closure ((Finset.univ.image (fun i => (w i : F)) : Finset F) : Set F)
          ⊔ Work.HopfGaschutz.relFrattini p K with hMdef
    have hMtop : M.subgroupOf K = ⊤ := by
      refine eq_top_of_map_eq_top_of_ker_le (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K))
        (M.subgroupOf K) ?_ ?_
      · intro x hx
        rw [QuotientGroup.ker_mk'] at hx
        exact Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_right hx)
      · rw [eq_top_iff]
        have hcl : Subgroup.closure (Set.range w) ≤ M.subgroupOf K := by
          rw [Subgroup.closure_le]
          rintro x ⟨i, rfl⟩
          refine Subgroup.mem_subgroupOf.mpr (Subgroup.mem_sup_left ?_)
          show (w i : F) ∈ Subgroup.closure
            ((Finset.univ.image (fun i => (w i : F)) : Finset F) : Set F)
          refine Subgroup.subset_closure ?_
          rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
          exact ⟨i, rfl⟩
        have h1 : Subgroup.map (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K))
            (Subgroup.closure (Set.range w)) = ⊤ := by
          rw [MonoidHom.map_closure]
          have hset : (QuotientGroup.mk' (Work.HopfGaschutz.relFrattiniIn p K)) '' Set.range w
              = Set.range v := by
            ext y
            constructor
            · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
              exact ⟨i, (hw i).symm⟩
            · rintro ⟨i, rfl⟩
              exact ⟨w i, ⟨i, rfl⟩, hw i⟩
          rw [hset]
          exact hvtop
        exact le_trans (le_of_eq h1.symm) (Subgroup.map_mono hcl)
    exact Subgroup.subgroupOf_eq_top.mp hMtop

/-! ## The requested statement -/

/-- **A spanning set of the presentation kernel of the size of the relation rank.**

For `p` prime, a finite group `Q` and a generating family `gen : α → Q` (no minimality needed,
`Q` neither a `p`-group nor nontrivial), the kernel
`K = ker (FreeGroup.lift gen)` contains a finite set `S` of `Work.HopfGaschutz.h2DimOf p α Q gen`
elements which spans `K` modulo `K^p[K,F]`:

`K ≤ Subgroup.closure (S : Set (FreeGroup α)) ⊔ Work.HopfGaschutz.relFrattini p K`.

This is the "relation module" half of the relation-rank dictionary in the *plain* closure
normalisation; the transition to the normal closure (a presentation of `Q`) is the open efficiency
statement `Work.HopfGaschutz.GaschutzDictionary` and is not used here. -/
theorem exists_spanning_relFrattini_card_h2DimOf {p : ℕ} [Fact p.Prime]
    {α : Type} [Fintype α] [DecidableEq α] {Q : Type} [Group Q] [Fintype Q]
    (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤) :
    ∃ S : Finset (FreeGroup α),
      S.card = Work.HopfGaschutz.h2DimOf p α Q gen ∧
      (∀ s ∈ S, FreeGroup.lift gen s = 1) ∧
      MonoidHom.ker (FreeGroup.lift gen) ≤
        Subgroup.closure (S : Set (FreeGroup α)) ⊔
          Work.HopfGaschutz.relFrattini p (MonoidHom.ker (FreeGroup.lift gen)) := by
  classical
  have hsurj : Function.Surjective (FreeGroup.lift gen) := by
    rw [← MonoidHom.range_eq_top, FreeGroup.range_lift_eq_closure, hgen]
  haveI hquot : Finite (FreeGroup α ⧸ MonoidHom.ker (FreeGroup.lift gen)) :=
    Finite.of_equiv Q
      (QuotientGroup.quotientKerEquivOfSurjective (FreeGroup.lift gen) hsurj).symm.toEquiv
  haveI hfi : (MonoidHom.ker (FreeGroup.lift gen)).FiniteIndex :=
    Subgroup.finiteIndex_of_finite_quotient
  haveI hfin : Finite (↥(MonoidHom.ker (FreeGroup.lift gen)) ⧸
      Work.HopfGaschutz.relFrattiniIn p (MonoidHom.ker (FreeGroup.lift gen))) :=
    finite_relFrattiniIn_quotient_of_finiteIndex p (MonoidHom.ker (FreeGroup.lift gen))
  obtain ⟨S, hcard, hsub, hspan⟩ :=
    exists_finset_spanning_of_quotient_card (K := MonoidHom.ker (FreeGroup.lift gen)) p
  exact ⟨S, by simpa only [Work.HopfGaschutz.h2DimOf, Work.HopfGaschutz.relFrattiniDim]
      using hcard, fun s hs => MonoidHom.mem_ker.mpr (hsub hs), hspan⟩

end Work.ProPGS
