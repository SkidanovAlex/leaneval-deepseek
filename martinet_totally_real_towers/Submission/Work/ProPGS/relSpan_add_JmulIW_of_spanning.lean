import Mathlib
import Submission.Work.ProPGS.CommonsBridge
import Submission.Work.ProPGS.JrelK_eq_ideal_span_kappa

/-!
# `Work.ProPGS.relSpan_add_JmulIW_of_spanning` -- the pro-`p` Nakayama step

## Statement

If `Q` is a finite `p`-group, `π : FreeGroup α ↠ Q` is a surjection with kernel `K`, and
`S ⊆ K` is a finite set of relators that spans `K` modulo its relation-Frattini subgroup
`K^p[K,F]` (i.e. `K ≤ ⟪S⟫ · K^p[K,F]`), then in the group algebra `𝔽_p[FreeGroup α]`,

  `JrelK ≤ relSpan S + JrelK · IW`,

where `JrelK = ker (𝔽_p[FreeGroup α] → 𝔽_p[Q])` (the algebra map induced by `π`) and
`relSpan S` is the ideal generated by `{[s] - 1 : s ∈ S}`.  In words: modulo the free-group
augmentation ideal, the *spanning* set `S` already generates the relation ideal -- this is the
pro-`p` Gaschütz/Nakayama step, and it is what replaces the (open) statement that `S` normally
generates `K` in the *discrete* category.  Since `S ⊆ K`, the inclusion `relSpan S ≤ JrelK` is
immediate, so only `JrelK ≤ relSpan S + JrelK · IW` needs work.

## Proof

Write `Y = JrelK`, `I = IW` (the augmentation ideal of `𝔽_p[FreeGroup α]`),
`X = relSpan S + Y·I` and `J' = X + I·Y = relSpan S + Y·I + I·Y`.  The argument has two steps.

**Step 1 (`Y ≤ J'`).**  The set `N = {u : [u] - 1 ∈ J'}` is a subgroup of `FreeGroup α`
(the identities `[uv] - 1 = [u]([v] - 1) + ([u] - 1)` and `[u⁻¹] - 1 = -[u⁻¹]([u] - 1)` show
closure).  We show `K ≤ N`:

* `S ⊆ N`, and a conjugate `f s f⁻¹` has `[f s f⁻¹] - 1 = [f]([s] - 1)[f]⁻¹`, which the
  standard decomposition (split off the augmentation of `[f]⁻¹`) puts into `relSpan S + Y·I`;
* `k^p ∈ N` for `k ∈ K`: `[k^p] - 1 = ([k] - 1)·(1 + [k] + ⋯ + [k]^{p-1}) ∈ Y·I`;
* `[k,f] ∈ N` for `k ∈ K`, `f ∈ FreeGroup α`:
  `[⁅k,f⁆] - 1 = (([k]-1)([f]-1) - ([f]-1)([k]-1))·[fk]⁻¹` with `([k]-1)([f]-1) ∈ Y·I` and
  `([f]-1)([k]-1) ∈ I·Y`;
* thus `⟪S⟫ · K^p[K,F] ≤ N`, and the hypothesis says `K` is contained in that subgroup.

Since `JrelK` is spanned by `{[u] - 1 : u ∈ K}` (`JrelK_eq_ideal_span_kappa`) we get `Y ≤ J'`.

**Step 2 (`Y ≤ X`).**  Multiplying `Y ≤ X + I·Y` on the left by `I` and using `I·X ⊆ X` gives
`Y ≤ X + I^m·Y` for every `m`.  The augmentation ideal of the group algebra of the finite
`p`-group `Q` is nilpotent (`isNilpotent_augIdealG`), and since `ρ : 𝔽_p[FreeGroup α] → 𝔽_p[Q]`
sends `I` into the augmentation ideal of `𝔽_p[Q]`, there is `n` with `I^n ≤ ker ρ = Y`.  Then
`I^n·Y ≤ Y·Y ⊆ Y·I ≤ X`, so `Y ≤ X + X = X`.

## Why the `p`-group hypothesis is needed (and cannot be dropped)

Without `hQ`, the statement is *false*: for `p = 2`, `α = Fin 2`, `Q = Multiplicative (ZMod 3)`,
`π` lifting `a ↦ ofAdd 1, b ↦ 1` and `S = {a³, b², (ab)³}` one has `⟪S⟫ = ker (F ↠ A₄)` (the
`(2,3,3)`-triangle-group presentation), `Q' = A₄`, `K' = V₄` and `V₄ = V₄² · [V₄, A₄]`, so the
spanning hypothesis holds; but `K_A ⊗_A 𝔽₂ ≅ H₁(V₄, 𝔽₂) = V₄ ≠ 0`, so the conclusion fails.
In that example `Q` is not a `p`-group.  Formally, `hQ` enters only through the nilpotency of the
augmentation ideal of `𝔽_p[Q]` (Step 2).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1600000

namespace Work.ProPGS

open Commons.GroupTheory.ProPGroup
open MonoidAlgebra
open scoped commutatorElement

variable (p : ℕ) [Fact p.Prime] (α : Type) [Fintype α] [DecidableEq α]

local notation "MO" => MonoidAlgebra.of (ZMod p) (FreeGroup α)

/-- `JrelK`, the ideal of relations of the algebra map induced by `π`. -/
noncomputable abbrev JY {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    Ideal (MonoidAlgebra (ZMod p) (FreeGroup α)) := JrelK p α π

/-- The augmentation ideal of `𝔽_p[FreeGroup α]`. -/
noncomputable abbrev IY : Ideal (MonoidAlgebra (ZMod p) (FreeGroup α)) := ScratchGS.IW p α

/-- The ideal `relSpan S + JrelK · IW`, i.e. the right hand side of the goal. -/
noncomputable abbrev tgtI {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    Ideal (MonoidAlgebra (ZMod p) (FreeGroup α)) :=
  ScratchSerre.relSpan p α S + JY p α π * IY p α

/-- The larger ideal `relSpan S + JrelK · IW + IW · JrelK` used in Step 1. -/
noncomputable abbrev bigI {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    Ideal (MonoidAlgebra (ZMod p) (FreeGroup α)) :=
  tgtI p α π S + IY p α * JY p α π

private instance IY_isTwoSided : (IY p α).IsTwoSided := by
  rw [show IY p α = gsIW p α from rfl]
  infer_instance

private lemma tgtI_eq {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    tgtI p α π S = ScratchSerre.relSpan p α S + JY p α π * IY p α := rfl

private lemma bigI_eq {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    bigI p α π S = tgtI p α π S + IY p α * JY p α π := rfl

private lemma tgtI_sup {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    tgtI p α π S = ScratchSerre.relSpan p α S ⊔ JY p α π * IY p α := by
  rw [tgtI_eq, Submodule.add_eq_sup]

private lemma bigI_sup {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    bigI p α π S = tgtI p α π S ⊔ IY p α * JY p α π := by
  rw [bigI_eq, Submodule.add_eq_sup]

private lemma JY_eq {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    JY p α π = JrelK p α π := rfl

private lemma sub_one_mem_IY (g : FreeGroup α) : MO g - 1 ∈ IY p α :=
  sub_one_mem_gsIW p α g

private lemma bigI_mul_mem {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    {u v : FreeGroup α} (hu : MO u - 1 ∈ bigI p α π S) (hv : MO v - 1 ∈ bigI p α π S) :
    MO (u * v) - 1 ∈ bigI p α π S := by
  have h : MO (u * v) - 1 = MO u * (MO v - 1) + (MO u - 1) := by rw [map_mul]; noncomm_ring
  rw [h]
  exact Submodule.add_mem _ (Ideal.mul_mem_left _ (MO u) hv) hu

private lemma bigI_inv_mem {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    {u : FreeGroup α} (hu : MO u - 1 ∈ bigI p α π S) : MO (u⁻¹) - 1 ∈ bigI p α π S := by
  have h : MO (u⁻¹) - 1 = -MO (u⁻¹) * (MO u - 1) := ScratchSerre.relator_inv p α u
  rw [h, neg_mul]
  exact Submodule.neg_mem _ (Ideal.mul_mem_left _ (MO u⁻¹) hu)

private lemma bigI_one_mem {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α)) :
    MO (1 : FreeGroup α) - 1 ∈ bigI p α π S := by
  rw [map_one, MonoidAlgebra.one_def, sub_self]
  exact Submodule.zero_mem _

private lemma conj_mem_bigI {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    (hS : ∀ s ∈ S, π s = 1) {f s : FreeGroup α} (hs : s ∈ S) :
    MO (f * s * f⁻¹) - 1 ∈ bigI p α π S := by
  rw [ScratchSerre.relator_conj p α f s]
  rw [ScratchSerre.relator_mul_decomp p α s (MO f) (MO f⁻¹)]
  have hgen : MO s - 1 ∈ ScratchSerre.relSpan p α S := Ideal.subset_span ⟨s, hs, rfl⟩
  have hJ : MO f * (MO s - 1) ∈ JY p α π :=
    Ideal.mul_mem_left _ _ (relator_mem_JrelK p α π (hS s hs))
  have hdiff : MO f⁻¹ - algebraMap (ZMod p) (MonoidAlgebra (ZMod p) (FreeGroup α))
      (ScratchGS.aug p α (MO f⁻¹)) ∈ IY p α := by
    rw [ScratchGS.mem_IW_iff]
    rw [map_sub, ScratchSerre.aug_algebraMap]
    abel
  refine Submodule.add_mem _ ?_ ?_
  · exact Submodule.mem_sup_left (Submodule.mem_sup_left
      (Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hgen)))
  · exact Submodule.mem_sup_left (Submodule.mem_sup_right (Ideal.mul_mem_mul hJ hdiff))

private lemma pow_mem_bigI {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    {k : FreeGroup α} (hk : MO k - 1 ∈ JY p α π) : MO (k ^ p) - 1 ∈ bigI p α π S := by
  have hgeom : (∑ i ∈ Finset.range p, (MO k) ^ i) ∈ IY p α := by
    rw [ScratchGS.mem_IW_iff, map_sum]
    simp only [map_pow, ScratchGS.aug_of, one_pow, Finset.sum_const, Finset.card_range,
      nsmul_eq_mul, mul_one]
    exact ZMod.natCast_self p
  have h : MO (k ^ p) - 1 = (MO k - 1) * ∑ i ∈ Finset.range p, (MO k) ^ i := by
    rw [map_pow, ← mul_geom_sum]
  rw [h]
  exact Submodule.mem_sup_left (Submodule.mem_sup_right (Ideal.mul_mem_mul hk hgeom))

private lemma comm_mem_bigI {Q : Type} [Group Q] (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    {k f : FreeGroup α} (hk : MO k - 1 ∈ JY p α π) :
    MO (k * f * k⁻¹ * f⁻¹) - 1 ∈ bigI p α π S := by
  rw [commutator_sub_one_eq p α k f]
  have hAB : (MO k - 1) * (MO f - 1) ∈ JY p α π * IY p α :=
    Ideal.mul_mem_mul hk (sub_one_mem_IY p α f)
  have hBA : (MO f - 1) * (MO k - 1) ∈ IY p α * JY p α π :=
    Ideal.mul_mem_mul (sub_one_mem_IY p α f) hk
  rw [sub_mul]
  refine Submodule.sub_mem _ ?_ ?_
  · exact Submodule.mem_sup_left (Submodule.mem_sup_right (Ideal.mul_mem_right _ _ hAB))
  · exact Submodule.mem_sup_right (Ideal.mul_mem_right _ _ hBA)

/-- **Step 1**: `JrelK ≤ relSpan S + JrelK · IW + IW · JrelK`. -/
private lemma JrelK_le_bigI {Q : Type} [Group Q] (π : FreeGroup α →* Q)
    (S : Finset (FreeGroup α)) (hS : ∀ s ∈ S, π s = 1)
    (hspan : MonoidHom.ker π ≤ Subgroup.normalClosure (S : Set (FreeGroup α)) ⊔
        Work.HopfGaschutz.relFrattini p (MonoidHom.ker π)) :
    JY p α π ≤ bigI p α π S := by
  let N : Subgroup (FreeGroup α) :=
    { carrier := {u | MO u - 1 ∈ bigI p α π S}
      mul_mem' := fun ha hb => bigI_mul_mem p α π S ha hb
      one_mem' := bigI_one_mem p α π S
      inv_mem' := fun ha => bigI_inv_mem p α π S ha }
  have hmem : ∀ u : FreeGroup α, u ∈ N ↔ MO u - 1 ∈ bigI p α π S := fun u => Iff.rfl
  have hRF : Work.HopfGaschutz.relFrattini p (MonoidHom.ker π) ≤ N := by
    rw [Work.HopfGaschutz.relFrattini]
    refine sup_le ?_ ?_
    · rw [Work.HopfGaschutz.pPower, Subgroup.closure_le]
      rintro x ⟨k, hk, rfl⟩
      exact (hmem _).mpr
        (pow_mem_bigI p α π S (relator_mem_JrelK p α π (MonoidHom.mem_ker.mp hk)))
    · rw [Subgroup.commutator_def, Subgroup.closure_le]
      rintro x ⟨a, ha, b, hb, rfl⟩
      rw [commutatorElement_def]
      exact (hmem _).mpr
        (comm_mem_bigI p α π S (relator_mem_JrelK p α π (MonoidHom.mem_ker.mp ha)))
  have hNC : Subgroup.normalClosure (S : Set (FreeGroup α)) ≤ N := by
    show Subgroup.closure (Group.conjugatesOfSet (S : Set (FreeGroup α))) ≤ N
    rw [Subgroup.closure_le]
    rintro x hx
    rw [Group.mem_conjugatesOfSet_iff] at hx
    obtain ⟨s, hs, hconj⟩ := hx
    obtain ⟨f, hf⟩ := isConj_iff.mp hconj
    rw [← hf]
    exact (hmem _).mpr (conj_mem_bigI p α π S hS hs)
  have hK : MonoidHom.ker π ≤ N := le_trans hspan (sup_le hNC hRF)
  rw [JY_eq, JrelK_eq_ideal_span_kappa p α π]
  refine Ideal.span_le.mpr ?_
  rintro x ⟨u, hu, rfl⟩
  exact (hmem u).mp (hK (MonoidHom.mem_ker.mpr hu))

/-- The augmentation ideal of the group algebra of the finite `p`-group `Q` is nilpotent, and
`ρ : 𝔽_p[FreeGroup α] → 𝔽_p[Q]` carries `IW` into it; hence some power of `IW` lies in
`ker ρ = JrelK`. -/
private lemma exists_pow_IY_le {Q : Type} [Group Q] [Fintype Q] (hQ : IsPGroup p Q)
    (π : FreeGroup α →* Q) : ∃ n : ℕ, IY p α ^ n ≤ JY p α π := by
  obtain ⟨n, hn⟩ := isNilpotent_augIdealG p hQ
  refine ⟨n, ?_⟩
  have hcomp : ∀ x : MonoidAlgebra (ZMod p) (FreeGroup α),
      augG p Q (rho p α π x) = ScratchGS.aug p α x := by
    intro x
    induction x using MonoidAlgebra.induction_on with
    | of g => rw [rho_of, augG_of, ScratchGS.aug_of]
    | add a b ha hb => simp only [map_add, ha, hb]
    | smul c a ha => simp only [map_smul, ha]
  have hle : IY p α ≤ Ideal.comap (rho p α π).toRingHom (augIdealG p Q) := by
    intro x hx
    rw [Ideal.mem_comap, mem_augIdealG_iff]
    change augG p Q (rho p α π x) = 0
    rw [hcomp x]
    exact (ScratchGS.mem_IW_iff p α x).mp hx
  have hpow : ∀ m : ℕ, IY p α ^ m ≤
      Ideal.comap (rho p α π).toRingHom (augIdealG p Q ^ m) := by
    intro m
    induction m with
    | zero =>
        intro x _
        rw [Submodule.pow_zero, Ideal.one_eq_top, Ideal.comap_top]
        exact Submodule.mem_top
    | succ m ih =>
        rw [Submodule.pow_succ]
        refine Ideal.mul_le.mpr (fun a ha b hb => ?_)
        have ha' : (rho p α π).toRingHom a ∈ augIdealG p Q ^ m := Ideal.mem_comap.mp (ih ha)
        have hb' : (rho p α π).toRingHom b ∈ augIdealG p Q := Ideal.mem_comap.mp (hle hb)
        have hmul : (rho p α π).toRingHom (a * b) =
            (rho p α π).toRingHom a * (rho p α π).toRingHom b :=
          map_mul (rho p α π).toRingHom a b
        rw [Ideal.mem_comap, hmul, Submodule.pow_succ]
        exact Submodule.mul_mem_mul ha' hb'
  refine le_trans (hpow n) ?_
  rw [hn, JY_eq]
  exact le_of_eq (RingHom.ker_eq_comap_bot (rho p α π).toRingHom).symm

private lemma IY_mul_relSpan_le {Q : Type} [Group Q] (π : FreeGroup α →* Q)
    (S : Finset (FreeGroup α)) :
    IY p α * ScratchSerre.relSpan p α S ≤ ScratchSerre.relSpan p α S :=
  Ideal.mul_le.mpr (fun r _ s hs => Ideal.mul_mem_left _ r hs)

private lemma IY_mul_tgtI_le {Q : Type} [Group Q] (π : FreeGroup α →* Q)
    (S : Finset (FreeGroup α)) : IY p α * tgtI p α π S ≤ tgtI p α π S := by
  rw [tgtI_sup]
  have h2 : IY p α * (JY p α π * IY p α) ≤ JY p α π * IY p α := by
    rw [← Ideal.mul_assoc]
    exact Ideal.mul_mono_left Ideal.mul_le_right
  rw [Ideal.mul_sup]
  exact sup_le (le_trans (IY_mul_relSpan_le p α π S) le_sup_left)
    (le_trans h2 le_sup_right)

private lemma JY_le_IY {Q : Type} [Group Q] (π : FreeGroup α →* Q) : JY p α π ≤ IY p α := by
  rw [JY_eq, JrelK_eq_ideal_span_kappa p α π]
  refine Ideal.span_le.mpr ?_
  rintro x ⟨u, _, rfl⟩
  exact sub_one_mem_IY p α u

/-- **Step 2**: from `JrelK ≤ relSpan S + JrelK · IW + IW · JrelK` and the nilpotency of the
augmentation ideal of the group algebra of the finite `p`-group `Q`, deduce
`JrelK ≤ relSpan S + JrelK · IW`. -/
private lemma JrelK_le_tgtI {Q : Type} [Group Q] [Fintype Q] (hQ : IsPGroup p Q)
    (π : FreeGroup α →* Q) (S : Finset (FreeGroup α))
    (h : JY p α π ≤ bigI p α π S) : JY p α π ≤ tgtI p α π S := by
  obtain ⟨n, hn⟩ := exists_pow_IY_le p α hQ π
  have hbig : JY p α π ≤ tgtI p α π S ⊔ IY p α * JY p α π := by
    rw [bigI_sup] at h
    exact h
  have hiter : ∀ m : ℕ, JY p α π ≤ tgtI p α π S ⊔ IY p α ^ m * JY p α π := by
    intro m
    induction m with
    | zero =>
        intro x hx
        rw [Submodule.pow_zero, Ideal.one_eq_top, Ideal.top_mul]
        exact Submodule.mem_sup_right hx
    | succ m ih =>
        intro x hx
        rcases Submodule.mem_sup.mp (hbig hx) with ⟨a, ha, b, hb, rfl⟩
        have hb1 : b ∈ IY p α * (tgtI p α π S ⊔ IY p α ^ m * JY p α π) :=
          Ideal.mul_mono_right ih hb
        rw [Ideal.mul_sup] at hb1
        rcases Submodule.mem_sup.mp hb1 with ⟨c, hc, d, hd, rfl⟩
        have hc' : c ∈ tgtI p α π S := IY_mul_tgtI_le p α π S hc
        have hd' : d ∈ IY p α ^ (m + 1) * JY p α π := by
          rw [← Ideal.mul_assoc] at hd
          rwa [← Ideal.IsTwoSided.pow_succ (I := IY p α) m] at hd
        rw [← add_assoc]
        exact Submodule.add_mem _
          (Submodule.mem_sup_left (Submodule.add_mem _ ha hc'))
          (Submodule.mem_sup_right hd')
  intro x hx
  rcases Submodule.mem_sup.mp (hiter n hx) with ⟨a, ha, b, hb, rfl⟩
  have hb1 : b ∈ JY p α π * JY p α π := Ideal.mul_mono hn le_rfl hb
  have hb2 : b ∈ JY p α π * IY p α := Ideal.mul_mono_right (JY_le_IY p α π) hb1
  exact Submodule.add_mem _ ha (Submodule.mem_sup_right hb2)

theorem relSpan_add_JmulIW_of_spanning {p : ℕ} [Fact p.Prime] {α : Type} [Fintype α] [DecidableEq α]
    {Q : Type} [Group Q] [Fintype Q] (hQ : IsPGroup p Q)
    (π : FreeGroup α →* Q) (hπ : Function.Surjective π)
    (S : Finset (FreeGroup α))
    (hS : ∀ s ∈ S, π s = 1)
    (hspan : MonoidHom.ker π ≤ Subgroup.normalClosure (S : Set (FreeGroup α)) ⊔
        Work.HopfGaschutz.relFrattini p (MonoidHom.ker π)) :
    Commons.GroupTheory.ProPGroup.JrelK p α π ≤
      Commons.GroupTheory.ProPGroup.ScratchSerre.relSpan p α S +
        Commons.GroupTheory.ProPGroup.JrelK p α π * ScratchGS.IW p α := by
  have h1 : Commons.GroupTheory.ProPGroup.JrelK p α π ≤ bigI p α π S :=
    JrelK_le_bigI p α π S hS hspan
  have h2 : JY p α π ≤ tgtI p α π S := JrelK_le_tgtI p α hQ π S h1
  rw [Submodule.add_eq_sup]
  exact h2

end Work.ProPGS
