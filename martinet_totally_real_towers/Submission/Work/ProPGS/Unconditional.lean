/-!
# `Work.ProPGS.Unconditional` -- the pro-`p` Golod--Shafarevich theorem, proved

**Namespace** `Work.ProPGS`; module `Submission.Work.ProPGS.Unconditional`.

This file proves `Work.ProPGS.ProPGolodShafarevich p` -- the pro-`p` (cohomological) form of the
Golod--Shafarevich inequality for finite `p`-groups -- and therefore gives *unconditional* versions
of the headline theorems of `Submission/Work/ProPGS/Main.lean`.

## The proof

Let `Q` be a finite `p`-group with a minimal generating family `gen : α → Q`, `c = |α|`,
`π = FreeGroup.lift gen`, `K = ker π` and `ρ = Work.HopfGaschutz.h2DimOf p α Q gen = log_p |K ⧸ K^p[K,F]|`.

1. **A spanning set of size `ρ`** (`exists_spanning_relFrattini_card_h2DimOf`): there is
   `S : Finset (FreeGroup α)` with `S.card = ρ`, `S ⊆ K` and `K ≤ ⟪S⟫ · K^p[K,F]`.  This is the
   pro-`p` Gaschütz extraction: `K ⧸ K^p[K,F]` is a finite elementary abelian `p`-group of order
   `p^ρ` and one lifts a basis.
2. **The relation module is generated by `ρ` elements**
   (`relSpan_add_JmulIW_of_spanning` + `ker_Phi_le_range_dRel_of_ideal_le`): spanning `K` modulo
   `K^p[K,F]` forces `JrelK ≤ relSpan S + JrelK·IW` in the free group algebra
   (`𝔽_p[F]`), because `u ↦ [u] - 1` is additive modulo products and kills `p`-th powers and
   commutators; and that ideal inclusion is exactly the input of the Fox-resolution exactness
   argument, giving `ker Φ ≤ range (dRel S)`.
3. **The Serre recursion with `ρ`** (`finrank_Tq_le_card_mul` + `serre_equality'`): the shift
   property of `dRel` (`dRel_mem_pi_pow_of_mem_ker`) and the exactness give
   `dim T_k ≤ ρ · A(k)` and `c · A(k+1) + 1 = A(k+2) + dim T_k`, hence the power-series inequality
   `1 - c x + ρ x² > 0` on `(0,1)` (`gs_gen_bound`).
4. **Euler characteristic**: `dim ker Φ ≤ ρ · D` and `dim (α → 𝔽_p[Q]) = c · D` with
   `dim (bG) = D - 1` force `c ≤ ρ`.
5. `quad_final` finishes: `c² < 4ρ`, i.e. `4 · dim_{𝔽_p} H²(Q,𝔽_p) > d(Q)²`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 4000000

namespace Work.ProPGS

open Commons.GroupTheory.ProPGroup
open Module (finrank)

/-- **THE PRO-`p` GOLOD--SHAFAREVICH INEQUALITY.**  A nontrivial finite `p`-group with a minimal
generating family `gen : α → Q` satisfies `4 · dim_{𝔽_p} H²(Q,𝔽_p) > (d(Q))²`, expressed with
`dim_{𝔽_p} H²(Q,𝔽_p) = Work.HopfGaschutz.h2DimOf p α Q gen` (the transgression). -/
theorem proPGolodShafarevich (p : ℕ) [Fact p.Prime] : ProPGolodShafarevich p := by
  intro α _ Q _ _ _ hQ gen hmin
  obtain ⟨hgen, hminc⟩ := hmin
  classical
  set π : FreeGroup α →* Q := FreeGroup.lift gen with hπdef
  have hπ : Function.Surjective π := by
    rw [← MonoidHom.range_eq_top, FreeGroup.range_lift_eq_closure, hgen]
  -- ### 1. a spanning set of size `ρ`
  obtain ⟨S, hScard, hSker, hspan0⟩ :=
    exists_spanning_relFrattini_card_h2DimOf (p := p) gen hgen
  have hSker' : ∀ s ∈ S, π s = 1 := fun s hs => hSker s hs
  have hspan : MonoidHom.ker π ≤ Subgroup.normalClosure (S : Set (FreeGroup α)) ⊔
      Work.HopfGaschutz.relFrattini p (MonoidHom.ker π) := by
    refine le_trans hspan0 (sup_le_sup ?_ le_rfl)
    exact (Subgroup.closure_le (Subgroup.normalClosure (S : Set (FreeGroup α)))).mpr
      Subgroup.subset_normalClosure
  -- ### 2. the relation module is generated by `|S|` elements
  have hideal := relSpan_add_JmulIW_of_spanning hQ π hπ S hSker' hspan
  have hker := ker_Phi_le_range_dRel_of_ideal_le π S hπ hideal
  have hshift := dRel_mem_pi_pow_of_mem_ker hQ π hπ hminc S hSker'
  -- ### 3. the Serre recursion with `ρ = |S|`
  set r : ℕ := S.card with hrdef
  have hrcard : (r : ℕ) = Work.HopfGaschutz.h2DimOf p α Q gen := hScard
  let b : ℕ → ℕ := fun j =>
    Commons.GroupTheory.ProPGroup.ScratchSerre.Abar p Q (j + 1) -
      Commons.GroupTheory.ProPGroup.ScratchSerre.Abar p Q j
  obtain ⟨M, hM⟩ := Commons.GroupTheory.ProPGroup.isNilpotent_augIdealG p hQ
  have hMb : Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q ^ M = ⊥ := by
    have h := hM
    rwa [show Commons.GroupTheory.ProPGroup.augIdealG p Q =
      Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q from rfl] at h
  have hsig : ∀ k, Commons.GroupTheory.ProPGroup.GSGen.gsig b k =
      Commons.GroupTheory.ProPGroup.ScratchSerre.Abar p Q (k + 1) :=
    Commons.GroupTheory.ProPGroup.ScratchSerre.gsig_b_eq p Q b (fun j => rfl)
  have hbzero : ∀ j, M ≤ j → b j = 0 := by
    intro j hj
    have h1 : Commons.GroupTheory.ProPGroup.ScratchSerre.Abar p Q (j + 1) =
        Commons.GroupTheory.ProPGroup.ScratchSerre.Abar p Q j :=
      Commons.GroupTheory.ProPGroup.ScratchSerre.Abar_eq_nilp p Q M hMb (by omega) (by omega)
    simp [b, h1]
  have hA0 : finrank (ZMod p) (MonoidAlgebra (ZMod p) Q ⧸
      Submodule.restrictScalars (ZMod p) (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q ^ 0)) = 0 := by
    have h := Commons.GroupTheory.ProPGroup.ScratchSerre.Abar_zero p Q
    simpa [Commons.GroupTheory.ProPGroup.ScratchSerre.Abar] using h
  have ht0 : finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.Tq p Q α π 0) = 0 := by
    have h1 := finrank_Tq_le_card_mul hQ π hπ hminc S hker hshift 0
    rw [hA0, mul_zero] at h1
    exact Nat.eq_zero_of_le_zero h1
  have ht : ∀ k, finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.Tq p Q α π (k + 1))
      ≤ r * Commons.GroupTheory.ProPGroup.GSGen.gsig b k := by
    intro k
    have h1 := finrank_Tq_le_card_mul hQ π hπ hminc S hker hshift (k + 1)
    have h4 : finrank (ZMod p) (MonoidAlgebra (ZMod p) Q ⧸
        Submodule.restrictScalars (ZMod p)
          (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q ^ (k + 1))) =
        Commons.GroupTheory.ProPGroup.GSGen.gsig b k :=
      (hsig k).symm
    rw [h4, ← hrdef] at h1
    exact h1
  have hrec : ∀ k, Fintype.card α * Commons.GroupTheory.ProPGroup.GSGen.gsig b k + 1 =
      Commons.GroupTheory.ProPGroup.GSGen.gsig b (k + 1) +
        finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.Tq p Q α π k) := by
    intro k
    have h1 := serre_equality' hQ π hπ hminc k
    rw [hsig k, hsig (k + 1)]
    exact h1
  have hq : ∀ x : ℝ, 0 < x → x < 1 →
      0 < 1 - (Fintype.card α : ℝ) * x + (r : ℝ) * x ^ 2 := by
    intro x hx0 hx1
    have hb := Commons.GroupTheory.ProPGroup.GSGen.gs_gen_bound (Fintype.card α) r M (M + 2) b
      (fun k => finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.Tq p Q α π k))
      (by omega) hbzero ht0 ht hrec x hx0 hx1
    have hBpnn : 0 ≤ (∑ j ∈ Finset.range M, (b j : ℝ) * x ^ j) :=
      Finset.sum_nonneg (fun j _ => by positivity)
    by_contra hcon
    have hcon' : (1 - (Fintype.card α : ℝ) * x + (r : ℝ) * x ^ 2) ≤ 0 := not_lt.mp hcon
    have := mul_nonpos_of_nonneg_of_nonpos hBpnn hcon'
    linarith
  -- ### 4. Euler characteristic: `c ≤ ρ`
  have hcpos : 0 < Fintype.card α := by
    rw [Fintype.card_pos_iff]
    by_contra hnot
    haveI : IsEmpty α := not_nonempty_iff.mp hnot
    haveI : Subsingleton (FreeGroup α) := inferInstance
    have hsub : Subsingleton Q := hπ.subsingleton
    exact (not_nontrivial_iff_subsingleton (α := Q)).mpr hsub inferInstance
  set D : ℕ := finrank (ZMod p) (MonoidAlgebra (ZMod p) Q) with hD
  have hquot : finrank (ZMod p) (MonoidAlgebra (ZMod p) Q ⧸
      Submodule.restrictScalars (ZMod p) (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q)) = 1 :=
    Commons.GroupTheory.ProPGroup.ScratchSerre.finrank_quot_bG p Q
  have hbridge : finrank (ZMod p) ↥(Submodule.restrictScalars (ZMod p)
      (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q)) =
      finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q) := rfl
  have hbGfin : finrank (ZMod p) ↥(Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q) = D - 1 := by
    have h1 := Submodule.finrank_quotient_add_finrank
      (N := Submodule.restrictScalars (ZMod p) (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q))
      (M := MonoidAlgebra (ZMod p) Q)
    rw [hquot, ← hD, hbridge] at h1
    omega
  have hpi : finrank (ZMod p) (α → MonoidAlgebra (ZMod p) Q) = Fintype.card α * D := by
    rw [Module.finrank_pi_fintype (ZMod p), Finset.sum_const, Finset.card_univ, ← hD,
      smul_eq_mul]
  have hrange : finrank (ZMod p) ↥(LinearMap.range
      (Commons.GroupTheory.ProPGroup.ScratchSerre.dRel p α Q S π)) ≤ S.card * D := by
    have h1 := LinearMap.finrank_range_le
      (Commons.GroupTheory.ProPGroup.ScratchSerre.dRel p α Q S π)
    rw [Module.finrank_pi_fintype (ZMod p), Finset.sum_const, Finset.card_univ,
      Fintype.card_coe, ← hD, smul_eq_mul] at h1
    exact h1
  have hrn := LinearMap.finrank_range_add_finrank_ker
    (Commons.GroupTheory.ProPGroup.ScratchSerre.Phi p Q α π)
  rw [Commons.GroupTheory.ProPGroup.ScratchSerre.Phi_range_eq_top p Q α π hπ,
    finrank_top] at hrn
  have hkerle : finrank (ZMod p) ↥(LinearMap.ker
      (Commons.GroupTheory.ProPGroup.ScratchSerre.Phi p Q α π)) ≤
      finrank (ZMod p) ↥(LinearMap.range
        (Commons.GroupTheory.ProPGroup.ScratchSerre.dRel p α Q S π)) :=
    Submodule.finrank_mono hker
  have hineq : Fintype.card α * D ≤ r * D + (D - 1) := by
    have hle : finrank (ZMod p) ↥(LinearMap.ker
        (Commons.GroupTheory.ProPGroup.ScratchSerre.Phi p Q α π)) ≤ r * D :=
      le_trans hkerle (le_trans hrange (le_of_eq (by rw [hrdef])))
    rw [hbGfin, hpi] at hrn
    omega
  have hD1 : 1 ≤ D := by
    have h1 := Submodule.finrank_quotient_le (R := ZMod p) (M := MonoidAlgebra (ZMod p) Q)
      (Submodule.restrictScalars (ZMod p) (Commons.GroupTheory.ProPGroup.ScratchSerre.bG p Q))
    rw [hquot] at h1
    omega
  have hcr : Fintype.card α ≤ r := by
    by_contra hc
    have hle : r + 1 ≤ Fintype.card α := by omega
    have h1 := Nat.mul_le_mul_right D hle
    have h2 : (r + 1) * D = r * D + D := by ring
    omega
  -- ### 5. the quadratic conclusion
  have hmain := Commons.GroupTheory.ProPGroup.GSGen.quad_final (Fintype.card α) r hcpos hcr hq
  have hsq : (Fintype.card α) ^ 2 = Fintype.card α * Fintype.card α := pow_two _
  omega

/-- **THE PRO-`p` GOLOD--SHAFAREVICH INEQUALITY, `p = 2`.** -/
theorem proPGolodShafarevich_two : ProPGolodShafarevich 2 :=
  proPGolodShafarevich 2

/-! ## The unconditional headline theorems (the deliverable) -/

/-- **THE PRIMARY TARGET.**  No nontrivial finite `2`-group has a minimal generating family of size
five together with `Nat.card (H²(Q,𝔽₂)) ≤ 64`.

This is the exact statement requested by `fundmath3-martinet_totally_real_towers`: a finite `2`-group
with `d(Q) = 5` and `dim_{𝔽₂} H²(Q,𝔽₂) ≤ 6` does not exist, so the arithmetic bound
`dim_{𝔽₂} H²(Γ,𝔽₂) ≤ 6` on the maximal tame pro-`2` group forces `Γ` to be infinite. -/
theorem subsingleton_of_card_contH2_le_sixtyfour :
    ∀ (Q : Type) [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q] [DiscreteTopology Q]
      [Fintype Q] [Nontrivial Q], IsPGroup 2 Q →
      (gen : Fin 5 → Q) → Subgroup.closure (Set.range gen) = ⊤ →
      (∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → 5 ≤ S.card) →
      Nat.card (Work.RelatorRank.contH2 Q) ≤ 64 → False :=
  subsingleton_of_card_contH2_le_sixtyfour_of_proPGolodShafarevich proPGolodShafarevich_two

/-- **The finite `2`-group endgame** (usable form: the conclusion is `Subsingleton Q`). -/
theorem subsingleton_of_contH2_le_sixtyfour {Q : Type} [Group Q] [TopologicalSpace Q]
    [IsTopologicalGroup Q] [DiscreteTopology Q] [Fintype Q] [Nontrivial Q]
    (hQ : IsPGroup 2 Q) (gen : Fin 5 → Q)
    (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : ∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → 5 ≤ S.card)
    (h2 : Nat.card (Work.RelatorRank.contH2 Q) ≤ 64) : Subsingleton Q :=
  subsingleton_of_contH2_le_sixtyfour_of_proPGolodShafarevich proPGolodShafarevich_two
    hQ gen hgen hmin h2

/-- **The general pro-`p` Golod--Shafarevich inequality.**

  `4 · dim_{𝔽_p} H²(Q,𝔽_p) > (d(Q))²`

for a nontrivial finite `p`-group `Q` with a minimal generating family `gen : α → Q`; here
`d(Q) = Fintype.card α` and `dim_{𝔽_p} H²(Q,𝔽_p) = Work.HopfGaschutz.h2DimOf p α Q gen`.  (Equivalently: for a finitely
generated pro-`p` group `Γ` with `4 · dim H² ≤ d(Γ)²`, `Γ` is infinite -- see
`Work.ProPGS.infinite_of_dense_five_contH2_le_six` and
`Work.ProPGS.subsingleton_of_contH2_le_sixtyfour`.) -/
theorem four_mul_dim_contH2_lt_card_sq {p : ℕ} [Fact p.Prime]
    {α : Type} [Fintype α] {Q : Type} [Group Q] [Fintype Q] [Nontrivial Q]
    (hQ : IsPGroup p Q) (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : ∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → Fintype.card α ≤ S.card) :
    4 * Work.HopfGaschutz.h2DimOf p α Q gen > Fintype.card α ^ 2 :=
  four_mul_dim_contH2_lt_card_sq_of_proPGolodShafarevich (proPGolodShafarevich p)
    hQ gen hgen hmin

/-- The same with the `𝔽₂`-dimension of the genuine cohomology group `H²(Q,𝔽₂)`. -/
theorem four_mul_log_card_contH2_lt_card_sq
    {α : Type} [Fintype α] [DecidableEq α] {Q : Type} [Group Q] [TopologicalSpace Q]
    [IsTopologicalGroup Q] [DiscreteTopology Q] [TopologicalSpace (FreeGroup α)]
    [DiscreteTopology (FreeGroup α)] [Fintype Q] [Nontrivial Q]
    (hQ : IsPGroup 2 Q) (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : ∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → Fintype.card α ≤ S.card) :
    4 * Nat.log 2 (Nat.card (Work.RelatorRank.contH2 Q)) > Fintype.card α ^ 2 :=
  four_mul_log_card_contH2_lt_card_sq_of_proPGolodShafarevich proPGolodShafarevich_two
    hQ gen hgen hmin

/-- **The `d = 5`, `dim ≤ 6` endgame in the presentation (`Work.HopfGaschutz.h2DimOf`) language.** -/
theorem subsingleton_of_h2DimOf_le_six {Q : Type} [Group Q] [Fintype Q] [Nontrivial Q]
    (hQ : IsPGroup 2 Q) (gen : Fin 5 → Q)
    (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : ∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → 5 ≤ S.card)
    (h2 : Work.HopfGaschutz.h2DimOf 2 (Fin 5) Q gen ≤ 6) : False :=
  subsingleton_of_h2DimOf_le_six_of_proPGolodShafarevich proPGolodShafarevich_two hQ gen hgen hmin h2

/-- **The topological (pro-`2`) form.**  A compact, Hausdorff, totally disconnected pro-`2` group
with a dense generating five-family that cannot be thinned and with `Nat.card H²(Γ,𝔽₂) ≤ 64` is
infinite.  For the maximal tame pro-`2` extension `K` of `ℚ`, all hypotheses are supplied by the
arithmetic input and `Work.TameArithmetic`. -/
theorem infinite_of_dense_five_contH2_le_six
    {Γ : Type} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    [CompactSpace Γ] [T2Space Γ] [TotallyDisconnectedSpace Γ] [Nontrivial Γ]
    (hpro : ∀ (N : Subgroup Γ) [N.Normal], IsOpen (N : Set Γ) → IsPGroup 2 (Γ ⧸ N))
    (gen : Fin 5 → Γ) (hdense : DenseRange gen)
    (hmin : ∀ S : Finset Γ, Subgroup.closure (S : Set Γ) = ⊤ → 5 ≤ S.card)
    (h2 : Nat.card (Work.RelatorRank.contH2 Γ) ≤ 64) : Infinite Γ :=
  infinite_of_dense_five_contH2_le_six_of_proPGolodShafarevich proPGolodShafarevich_two
    hpro gen hdense hmin h2

end Work.ProPGS
