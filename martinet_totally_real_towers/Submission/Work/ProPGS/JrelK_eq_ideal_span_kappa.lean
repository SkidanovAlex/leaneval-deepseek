import Mathlib
import Submission.Work.ProPGS.CommonsBridge

/-!
# `JrelK` is the ideal spanned by the relators `of u - 1`

**Namespace** `Work.ProPGS`; module `Submission.Work.ProPGS.JrelK_eq_ideal_span_kappa`.

The kernel ideal `Commons.GroupTheory.ProPGroup.JrelK p α π` of the algebra map
`rho p α π : 𝔽_p[FreeGroup α] →ₐ[𝔽_p] 𝔽_p[Q]` induced by a group homomorphism
`π : FreeGroup α →* Q` is *exactly* the two-sided ideal generated by the elements
`of u - 1` with `u ∈ ker π`.

Both inclusions are elementary:

* `of u - 1 ∈ JrelK` whenever `π u = 1`, because `rho` is an algebra homomorphism
  (`Commons.GroupTheory.ProPGroup.relator_mem_JrelK`), so the span of these elements is
  contained in `JrelK`;
* conversely, when `π` is *surjective*, a section `s : Q → FreeGroup α` of `π` produces a
  monoid homomorphism `Q →* 𝔽_p[FreeGroup α] ⧸ ⟨of u - 1⟩`, `q ↦ of (s q)`, that
  inverts `rho`; hence anything killed by `rho` already lies in the span.  The general case
  follows by replacing `Q` with the image `π.range`.
-/

set_option linter.unusedSectionVars false

namespace Work.ProPGS

open Commons.GroupTheory.ProPGroup

variable (p : ℕ) [Fact p.Prime] (α : Type) [Fintype α] [DecidableEq α]

/-- The two-sided ideal of `FW p α` generated by the relators `of u - 1`, `u ∈ ker π`. -/
noncomputable def kappaIdeal {Q : Type} [Group Q] (π : FreeGroup α →* Q) : Ideal (FW p α) :=
  Ideal.span {x : FW p α |
    ∃ u : FreeGroup α, π u = 1 ∧
      x = MonoidAlgebra.of (ZMod p) (FreeGroup α) u - 1}

lemma kappaIdeal_le_JrelK {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    kappaIdeal p α π ≤ JrelK p α π := by
  rw [kappaIdeal, Ideal.span_le]
  rintro x ⟨u, hu, rfl⟩
  exact relator_mem_JrelK p α π hu

lemma relator_mem_kappaIdeal {Q : Type} [Group Q] (π : FreeGroup α →* Q) {u : FreeGroup α}
    (hu : π u = 1) :
    MonoidAlgebra.of (ZMod p) (FreeGroup α) u - 1 ∈ kappaIdeal p α π :=
  Ideal.subset_span ⟨u, hu, rfl⟩

/-- The relators of a homomorphism are invariant under conjugation: if `π g = π h` then
`of g - of h` lies in `kappaIdeal p α π`. -/
lemma of_sub_of_mem_kappaIdeal {Q : Type} [Group Q] (π : FreeGroup α →* Q)
    {g h : FreeGroup α} (hgh : π g = π h) :
    MonoidAlgebra.of (ZMod p) (FreeGroup α) g -
        MonoidAlgebra.of (ZMod p) (FreeGroup α) h ∈ kappaIdeal p α π := by
  have hu : π (h⁻¹ * g) = 1 := by rw [map_mul, map_inv, hgh, inv_mul_cancel]
  have hmem := relator_mem_kappaIdeal p α π hu
  have key : MonoidAlgebra.of (ZMod p) (FreeGroup α) h *
        (MonoidAlgebra.of (ZMod p) (FreeGroup α) (h⁻¹ * g) - 1) =
      MonoidAlgebra.of (ZMod p) (FreeGroup α) g -
        MonoidAlgebra.of (ZMod p) (FreeGroup α) h := by
    rw [mul_sub, mul_one, ← map_mul, mul_inv_cancel_left]
  rw [← key]
  exact Ideal.mul_mem_left _ _ hmem

/-- `kappaIdeal p α π` is a two-sided ideal (the relators are stable under conjugation). -/
instance kappaIdeal_isTwoSided {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    (kappaIdeal p α π).IsTwoSided := by
  classical
  refine Ideal.IsTwoSided.mk (fun b ha => ?_)
  induction b using MonoidAlgebra.induction_on with
  | of g =>
      refine Submodule.span_induction
        (p := fun x _ => x * MonoidAlgebra.of (ZMod p) (FreeGroup α) g ∈ kappaIdeal p α π)
        ?_ ?_ ?_ ?_ ha
      · rintro x ⟨u, hu, rfl⟩
        have hconj : π (g⁻¹ * u * g) = 1 := by
          rw [map_mul, map_mul, map_inv, hu]
          simp
        have hgen : MonoidAlgebra.of (ZMod p) (FreeGroup α) (g⁻¹ * u * g) - 1 ∈
            kappaIdeal p α π := relator_mem_kappaIdeal p α π hconj
        have hmem : MonoidAlgebra.of (ZMod p) (FreeGroup α) g *
            (MonoidAlgebra.of (ZMod p) (FreeGroup α) (g⁻¹ * u * g) - 1) ∈
            kappaIdeal p α π := Ideal.mul_mem_left _ _ hgen
        have heq : MonoidAlgebra.of (ZMod p) (FreeGroup α) g *
              (MonoidAlgebra.of (ZMod p) (FreeGroup α) (g⁻¹ * u * g) - 1) =
            (MonoidAlgebra.of (ZMod p) (FreeGroup α) u - 1) *
              MonoidAlgebra.of (ZMod p) (FreeGroup α) g := by
          rw [mul_sub, mul_one, sub_mul, one_mul, ← map_mul, ← map_mul]
          congr 1
          group
        rwa [heq] at hmem
      · simp
      · intro x y _ _ ihx ihy
        rw [add_mul]
        exact Ideal.add_mem _ ihx ihy
      · intro c x _ ih
        rw [smul_mul_assoc]
        exact Submodule.smul_mem _ c ih
  | add b1 b2 h1 h2 =>
      rw [mul_add]
      exact Ideal.add_mem _ h1 h2
  | smul c z hz =>
      rw [mul_smul_comm, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ hz

section Surjective

variable {Q : Type} [Group Q] (π : FreeGroup α →* Q)

/-- `FreeGroup α →* FW p α ⧸ kappaIdeal p α π`, `g ↦ of g`. -/
noncomputable def phiK : FreeGroup α →* (FW p α ⧸ kappaIdeal p α π) where
  toFun g := Ideal.Quotient.mk (kappaIdeal p α π) (MonoidAlgebra.of (ZMod p) (FreeGroup α) g)
  map_one' := by
    change Ideal.Quotient.mk (kappaIdeal p α π)
      (MonoidAlgebra.of (ZMod p) (FreeGroup α) 1) = 1
    rw [map_one, map_one]
  map_mul' g h := by
    change Ideal.Quotient.mk (kappaIdeal p α π)
        (MonoidAlgebra.of (ZMod p) (FreeGroup α) (g * h)) =
      Ideal.Quotient.mk (kappaIdeal p α π) (MonoidAlgebra.of (ZMod p) (FreeGroup α) g) *
      Ideal.Quotient.mk (kappaIdeal p α π) (MonoidAlgebra.of (ZMod p) (FreeGroup α) h)
    rw [map_mul, map_mul]

lemma phiK_eq_one_of_mem_ker {u : FreeGroup α} (hu : u ∈ π.ker) : phiK p α π u = 1 := by
  change Ideal.Quotient.mk (kappaIdeal p α π) (MonoidAlgebra.of (ZMod p) (FreeGroup α) u) = 1
  rw [← map_one (Ideal.Quotient.mk (kappaIdeal p α π)), Ideal.Quotient.eq]
  exact relator_mem_kappaIdeal p α π (MonoidHom.mem_ker.mp hu)

/-- `phiK` is constant on the fibres of `π`. -/
lemma phiK_eq_of_apply_eq {a b : FreeGroup α} (h : π a = π b) : phiK p α π a = phiK p α π b := by
  have hab : a * b⁻¹ ∈ π.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, h, mul_inv_cancel]
  have h1 : phiK p α π a * phiK p α π b⁻¹ = 1 := by
    rw [← map_mul]
    exact phiK_eq_one_of_mem_ker p α π hab
  have h2 : phiK p α π b⁻¹ * phiK p α π b = 1 := by
    rw [← map_mul, inv_mul_cancel, map_one]
  calc phiK p α π a = phiK p α π a * 1 := (mul_one _).symm
    _ = phiK p α π a * (phiK p α π b⁻¹ * phiK p α π b) := by rw [h2]
    _ = (phiK p α π a * phiK p α π b⁻¹) * phiK p α π b := by rw [mul_assoc]
    _ = 1 * phiK p α π b := by rw [h1]
    _ = phiK p α π b := one_mul _

/-- A section of a surjective `π` gives a monoid homomorphism `Q →* FW p α ⧸ kappaIdeal`. -/
noncomputable def psiK (hπ : Function.Surjective π) :
    Q →* (FW p α ⧸ kappaIdeal p α π) where
  toFun q := phiK p α π (Classical.choose (hπ q))
  map_one' := by
    apply phiK_eq_of_apply_eq p α π
    rw [Classical.choose_spec (hπ 1), map_one]
  map_mul' g h := by
    rw [← map_mul]
    apply phiK_eq_of_apply_eq p α π
    rw [map_mul, Classical.choose_spec (hπ g), Classical.choose_spec (hπ h),
      Classical.choose_spec (hπ (g * h))]

/-- The left inverse of `rho` on the quotient by `kappaIdeal`. -/
noncomputable def psibarK (hπ : Function.Surjective π) :
    MonoidAlgebra (ZMod p) Q →ₐ[ZMod p] (FW p α ⧸ kappaIdeal p α π) :=
  MonoidAlgebra.lift (ZMod p) (FW p α ⧸ kappaIdeal p α π) Q (psiK p α π hπ)

lemma psibarK_of (hπ : Function.Surjective π) (g : Q) :
    psibarK p α π hπ (MonoidAlgebra.of (ZMod p) Q g) = psiK p α π hπ g :=
  MonoidAlgebra.lift_of (psiK p α π hπ) g

lemma psibarK_rho (hπ : Function.Surjective π) (g : FreeGroup α) :
    psibarK p α π hπ (rho p α π (MonoidAlgebra.of (ZMod p) (FreeGroup α) g)) =
      Ideal.Quotient.mk (kappaIdeal p α π)
        (MonoidAlgebra.of (ZMod p) (FreeGroup α) g) := by
  rw [rho_of, psibarK_of]
  change phiK p α π (Classical.choose (hπ (π g))) =
    Ideal.Quotient.mk (kappaIdeal p α π) (MonoidAlgebra.of (ZMod p) (FreeGroup α) g)
  rw [phiK_eq_of_apply_eq p α π (Classical.choose_spec (hπ (π g)))]
  rfl

lemma psibarK_rho_eq (hπ : Function.Surjective π) (z : FW p α) :
    psibarK p α π hπ (rho p α π z) = Ideal.Quotient.mk (kappaIdeal p α π) z := by
  induction z using MonoidAlgebra.induction_on with
  | of g => exact psibarK_rho p α π hπ g
  | add x y hx hy => simp only [map_add, hx, hy]
  | smul r x hx =>
      rw [map_smul (rho p α π) r x, map_smul (psibarK p α π hπ) r ((rho p α π) x), hx]
      rfl

/-- For a *surjective* `π` the kernel `JrelK` is spanned by the relators. -/
theorem kappaIdeal_eq_JrelK_of_surjective (hπ : Function.Surjective π) :
    JrelK p α π = kappaIdeal p α π := by
  refine le_antisymm ?_ (kappaIdeal_le_JrelK p α π)
  intro z hz
  have hz' : rho p α π z = 0 := by simpa [JrelK] using hz
  have h := psibarK_rho_eq p α π hπ z
  rw [hz', map_zero] at h
  exact Ideal.Quotient.eq_zero_iff_mem.mp h.symm

end Surjective

/-- `JrelK` is the ideal spanned by the relators `of u - 1`, `u ∈ ker π`. -/
theorem JrelK_eq_kappaIdeal {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    JrelK p α π = kappaIdeal p α π := by
  have hsurj : Function.Surjective π.rangeRestrict := by
    intro y
    obtain ⟨g, hg⟩ := y.2
    exact ⟨g, Subtype.ext hg⟩
  have h1 : JrelK p α π.rangeRestrict = kappaIdeal p α π.rangeRestrict :=
    kappaIdeal_eq_JrelK_of_surjective p α π.rangeRestrict hsurj
  have h2 : kappaIdeal p α π.rangeRestrict = kappaIdeal p α π := by
    unfold kappaIdeal
    congr 1
    ext x
    constructor
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u, by
        have := congrArg Subtype.val hu
        rwa [MonoidHom.coe_rangeRestrict] at this, rfl⟩
    · rintro ⟨u, hu, rfl⟩
      exact ⟨u, Subtype.ext (by rw [MonoidHom.coe_rangeRestrict]; exact hu), rfl⟩
  have h3 : JrelK p α π = JrelK p α π.rangeRestrict := by
    have hincl : Function.Injective
        (MonoidAlgebra.mapDomainAlgHom (ZMod p) (ZMod p) (Subgroup.subtype π.range)) := by
      have h : Function.Injective
          (MonoidAlgebra.mapDomain (R := ZMod p) (Subgroup.subtype π.range)) :=
        MonoidAlgebra.mapDomain_injective Subtype.coe_injective
      exact h
    have hfac : ∀ x : FW p α,
        rho p α π x =
          (MonoidAlgebra.mapDomainAlgHom (ZMod p) (ZMod p) (Subgroup.subtype π.range))
            (rho p α π.rangeRestrict x) := by
      intro x
      induction x using MonoidAlgebra.induction_on with
      | of g =>
          rw [rho_of, rho_of]
          simp [MonoidAlgebra.mapDomainAlgHom_apply, MonoidAlgebra.of_apply,
            MonoidAlgebra.mapDomain_single]
      | add a b ha hb => rw [map_add, map_add, map_add, ha, hb]
      | smul c z hz => rw [map_smul, map_smul, map_smul, hz]
    rw [JrelK, JrelK, Ideal.ext_iff]
    intro x
    rw [RingHom.mem_ker, RingHom.mem_ker]
    change rho p α π x = 0 ↔ rho p α π.rangeRestrict x = 0
    rw [hfac x]
    constructor
    · intro hx
      exact hincl (by rw [hx, map_zero])
    · intro hx
      rw [hx, map_zero]
  rw [h3, h1, h2]

theorem JrelK_eq_ideal_span_kappa (p : ℕ) [Fact p.Prime] (α : Type) [Fintype α] [DecidableEq α]
    {Q : Type} [Group Q] (π : FreeGroup α →* Q) :
    Commons.GroupTheory.ProPGroup.JrelK p α π =
      Ideal.span {x : Commons.GroupTheory.ProPGroup.FW p α |
        ∃ u : FreeGroup α, π u = 1 ∧
          x = MonoidAlgebra.of (ZMod p) (FreeGroup α) u - 1} := by
  simpa only [kappaIdeal] using JrelK_eq_kappaIdeal (p := p) (α := α) π

end Work.ProPGS
