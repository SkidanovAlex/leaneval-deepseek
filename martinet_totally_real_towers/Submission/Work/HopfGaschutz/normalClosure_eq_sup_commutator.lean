import Mathlib

/-!
# The normal closure is the join of the subgroup with its commutator subgroup

For a subset `S` of a group `F` with `H := Subgroup.closure S`, the normal closure of `S` -- the
smallest normal subgroup of `F` containing `S` -- is the join of `H` with the commutator subgroup
`⁅H, ⊤⁆` of `H` with `F`:

  `Subgroup.normalClosure S = Subgroup.closure S ⊔ ⁅Subgroup.closure S, ⊤⁆`.

This is the "normal closure = subgroup · [subgroup, group]" identity, the standard input for
turning a spanning statement modulo commutators (Nakayama/relation-rank arguments) into a genuine
normal-generation statement.

Proof sketch.  `≥`: `closure S ≤ normalClosure S` since `S ⊆ normalClosure S`, and
`⁅closure S, ⊤⁆ ≤ ⁅normalClosure S, ⊤⁆ ≤ normalClosure S` since `normalClosure S` is normal
(`Subgroup.commutator_top_right_le_iff`).

`≤`: `normalClosure S` is the subgroup generated by the conjugates of `S`, so it suffices to
show each conjugate `c * a * c⁻¹` of `a ∈ S` lies in `H ⊔ ⁅H, ⊤⁆`.  Using
`c * a * c⁻¹ = ⁅c, a⁆ * a` (`commutatorElement_def`), this follows from `a ∈ H`
and `⁅c, a⁆ = ⁅a, c⁆⁻¹ ∈ ⁅H, ⊤⁆`.
-/

namespace Work.HopfGaschutz

open scoped commutatorElement

theorem normalClosure_eq_sup_commutator {F : Type*} [Group F] (S : Set F) :
    Subgroup.normalClosure S = Subgroup.closure S ⊔ ⁅Subgroup.closure S, ⊤⁆ := by
  apply le_antisymm
  · -- `normalClosure S ≤ closure S ⊔ ⁅closure S, ⊤⁆`: every conjugate of `a ∈ S` lies in the join.
    rw [Subgroup.normalClosure]
    refine (Subgroup.closure_le _).2 ?_
    intro x hx
    rw [Group.mem_conjugatesOfSet_iff] at hx
    obtain ⟨a, ha, hab⟩ := hx
    rw [isConj_iff] at hab
    obtain ⟨c, hc⟩ := hab
    rw [← hc]
    have haH : a ∈ Subgroup.closure S := Subgroup.subset_closure ha
    have hmem : ⁅a, c⁆ ∈ ⁅Subgroup.closure S, (⊤ : Subgroup F)⁆ :=
      Subgroup.commutator_mem_commutator (H₁ := Subgroup.closure S) (H₂ := ⊤) haH
        (Subgroup.mem_top c)
    have hcomm : ⁅c, a⁆ ∈ ⁅Subgroup.closure S, (⊤ : Subgroup F)⁆ := by
      have h : ⁅c, a⁆ = ⁅a, c⁆⁻¹ := by rw [commutatorElement_inv]
      rw [h]
      exact Subgroup.inv_mem _ hmem
    have hca : c * a * c⁻¹ = ⁅c, a⁆ * a := by
      rw [commutatorElement_def]; group
    rw [hca]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hcomm) (Subgroup.mem_sup_left haH)
  · -- `closure S ⊔ ⁅closure S, ⊤⁆ ≤ normalClosure S`.
    refine sup_le ?_ ?_
    · exact le_trans Subgroup.le_normalClosure
        (le_of_eq (Subgroup.normalClosure_closure_eq_normalClosure (s := S)))
    · refine le_trans (Subgroup.commutator_mono Subgroup.le_normalClosure le_rfl) ?_
      simpa [Subgroup.normalClosure_closure_eq_normalClosure] using
        (Subgroup.commutator_top_right_le_iff.mpr (Subgroup.normalClosure_normal (s := S)))

end Work.HopfGaschutz
