import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.relFrattiniDim_le_card_of_normalGenerates

/-!
# The downward direction of the relation-rank dictionary, in concrete form

**Module** `Submission.Work.HopfGaschutz.h2DimOf_le_card_of_presentation`.

For a **finite** group `G` and a presentation of `G` on the generating family `gen : α → G` with
relator set `rel` (`MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure rel`), the
presentation-theoretic relation rank `h2DimOf p α G gen` -- the `𝔽_p`-dimension of
`K ⧸ K^p[K,F]` for `K = ker (FreeGroup.lift gen)`, `F = FreeGroup α` -- is at most `rel.card`.

Nothing cohomological is used, and no Gaschütz-type input is needed: the whole content is the
elementary counting bound `relFrattiniDim_le_card_of_normalGenerates`, for which one has to know
that `K` is finitely generated.  Finiteness of `G` supplies that: `K` has finite index in
`FreeGroup α` (indeed `K.index = Nat.card G`, since `gen` generates, so `FreeGroup.lift gen` is
surjective), and a finite index subgroup of a finitely generated group is finitely generated by
Schreier's lemma (`Subgroup.fg_of_index_ne_zero`), while `FreeGroup α` is finitely generated because
`α` is finite.

Consequently this lemma is an unconditional instance of the named property
`Work.HopfGaschutz.RelationRankLowerBound p α G` of `Defs.lean`.
-/

set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

theorem h2DimOf_le_card_of_presentation {α : Type*} [Fintype α] [DecidableEq α] {G : Type*}
    [Group G] [Fintype G] (p : ℕ) (gen : α → G)
    (hgen : Subgroup.closure (Set.range gen) = ⊤) (rel : Finset (FreeGroup α))
    (h : MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure (rel : Set (FreeGroup α))) :
    h2DimOf p α G gen ≤ rel.card := by
  -- `gen` generates `G`, so the presentation hom is surjective, and `K = ker (FreeGroup.lift gen)`
  -- has index `Nat.card G` in `FreeGroup α`.
  have hsurj : Function.Surjective (FreeGroup.lift gen) := by
    rw [← MonoidHom.range_eq_top, FreeGroup.range_lift_eq_closure, hgen]
  haveI hfin : (MonoidHom.ker (FreeGroup.lift gen)).FiniteIndex :=
    ⟨by rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top]
        exact Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩⟩
  -- hence `K` is finitely generated (Schreier) and the counting bound applies, since `rel`
  -- normally generates `K` by hypothesis.
  have hK : Group.FG (MonoidHom.ker (FreeGroup.lift gen)) := inferInstance
  exact relFrattiniDim_le_card_of_normalGenerates p hK h.symm

end Work.HopfGaschutz
