import Mathlib
import Submission.Work.HopfGaschutz.ProP
import Submission.Work.HopfGaschutz.le_normalClosure_of_le_sup_relFrattini
import Submission.Work.RelatorRank.ProP
import Submission.Work.RelatorRank.ProPFrattini

/-!
# `Work.HopfGaschutz.closed_engine` -- the Nakayama step for a *closed* relation-Frattini subgroup

**Namespace** `Work.HopfGaschutz`; module `Submission.Work.HopfGaschutz.closed_engine`.

`relFrattiniClosed p R` (`ProP.lean`) is the closed relation-Frattini subgroup of a subgroup `R` of a
topological group `Γ`: the topological closure of `⟪{r ^ p : r ∈ R} ∪ {⁅r,g⁆ : r ∈ R, g ∈ Γ}⟫`.  The
finite Nakayama step of this chapter (`le_normalClosure_of_le_sup_relFrattini`) says that in a finite
`p`-group a normal subgroup generated modulo `K ^ p [K,G]` by a set `S` is generated by `S`.  This
module transfers that statement to a compact totally disconnected pro-`p` group `Γ`, i.e. it is the
*topological* engine turning a spanning statement modulo the closed relation-Frattini subgroup into a
topological-normal-generation statement.

## The proof

Everything is read off the finite quotients `Γ ⧸ U` (`U ◁ₒ Γ` open normal), which are finite
`p`-groups by hypothesis:

* the quotient map `π : Γ →* Γ ⧸ U` is continuous, the quotient is discrete, and the image of the
  *closed* normal closure `⟪S⟫̄` is the normal closure of the image of `S` (a closed subgroup with
  closed image is carried to its image, and `Subgroup.map_normalClosure`);
* the image of `relFrattiniClosed p R` lands in `relFrattini p (π R) = π R ^ p ⁅π R, π Γ⁆` (each
  generator `r ^ p`, `⁅r,g⁆` maps to a `p`-th power, resp. a commutator, in the quotient);
* hence the finite Nakayama step applies in `Γ ⧸ U` and gives `π R ≤ π ⟪S⟫̄`, i.e. `R ≤ ⟪S⟫̄ U` for
  every open normal `U`.

The passage from "modulo every open normal `U`" to the honest inclusion uses that a closed subgroup of
a compact totally disconnected group is the intersection of the open subgroups containing it
(`ProfiniteGrp.closedSubgroup_eq_sInf_open`) together with the existence of an open normal subgroup
inside any open subgroup (`ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one`).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped commutatorElement

namespace Work.HopfGaschutz

/-- **The closed engine.**  Let `Γ` be a pro-`p` group (all finite quotients by open normal
subgroups are `p`-groups) and `R ≤ Γ` a normal subgroup.  If `R` is generated modulo the closed
relation-Frattini subgroup `relFrattiniClosed p R` by a finite set `S ⊆ R`, then `S` already
topologically normally generates `R`.

The hypothesis `IsClosed (R : Set Γ)` is part of the interface; the argument does not need it, as it
reduces to the finite quotients. -/
theorem closed_engine {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    [CompactSpace Γ] [T2Space Γ] [TotallyDisconnectedSpace Γ] {p : ℕ} [Fact p.Prime]
    (hΓ : Work.RelatorRank.IsProPGroup p Γ) {R : Subgroup Γ} [R.Normal] (hR : IsClosed (R : Set Γ))
    {S : Finset Γ} (hS : (S : Set Γ) ⊆ R)
    (hspan : R ≤ (Subgroup.normalClosure (S : Set Γ)).topologicalClosure ⊔ Work.HopfGaschutz.relFrattiniClosed p R) :
    R ≤ (Subgroup.normalClosure (S : Set Γ)).topologicalClosure := by
  classical
  -- Step 1: for every open normal `U`, the inclusion holds modulo `U`.
  have key : ∀ U : OpenNormalSubgroup Γ,
      R ≤ Subgroup.normalClosure (S : Set Γ) ⊔ U.toSubgroup := by
    intro U
    let π : Γ →* Γ ⧸ U.toSubgroup := QuotientGroup.mk' U.toSubgroup
    have hsurj : Function.Surjective π := QuotientGroup.mk'_surjective U.toSubgroup
    have hcont : Continuous π := by
      rw [QuotientGroup.coe_mk']; exact QuotientGroup.continuous_mk
    haveI : Fintype (Γ ⧸ U.toSubgroup) := Fintype.ofFinite _
    haveI hnorm : (Subgroup.map π R).Normal := Subgroup.Normal.map ‹R.Normal› π hsurj
    -- The image of the closed normal closure is the image of the normal closure.
    have hMle : Subgroup.map π (Subgroup.normalClosure (S : Set Γ)).topologicalClosure
        ≤ Subgroup.map π (Subgroup.normalClosure (S : Set Γ)) := by
      rw [Subgroup.map_le_iff_le_comap]
      refine Subgroup.topologicalClosure_minimal _ (fun x hx => Subgroup.mem_map_of_mem π hx) ?_
      rw [Subgroup.coe_comap]
      exact IsClosed.preimage hcont (isClosed_discrete _)
    have hNC : Subgroup.map π (Subgroup.normalClosure (S : Set Γ))
        = Subgroup.normalClosure ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set _) := by
      rw [Subgroup.map_normalClosure (S : Set Γ) π hsurj, Finset.coe_image]
    -- The image of `relFrattiniClosed p R` lies in the relation-Frattini subgroup of `π R`.
    have hrel : Subgroup.map π (relFrattiniClosed p R) ≤ relFrattini p (Subgroup.map π R) := by
      rw [Subgroup.map_le_iff_le_comap]
      show (Subgroup.closure (_ ∪ _)).topologicalClosure ≤
        Subgroup.comap π (relFrattini p (Subgroup.map π R))
      refine Subgroup.topologicalClosure_minimal _ ?_ ?_
      · rw [Subgroup.closure_le]
        rintro x (hx | hx)
        · obtain ⟨r, hr, rfl⟩ := hx
          change π (r ^ p) ∈ relFrattini p (Subgroup.map π R)
          rw [map_pow]
          exact Subgroup.mem_sup_left (Subgroup.subset_closure
            ⟨π r, Subgroup.mem_map_of_mem π hr, rfl⟩)
        · obtain ⟨r, hr, g, rfl⟩ := hx
          change π ⁅r, g⁆ ∈ relFrattini p (Subgroup.map π R)
          rw [map_commutatorElement]
          exact Subgroup.mem_sup_right (by
            rw [Subgroup.commutator_def]
            exact Subgroup.subset_closure
              ⟨π r, Subgroup.mem_map_of_mem π hr, π g, Subgroup.mem_top _, rfl⟩)
      · rw [Subgroup.coe_comap]
        exact IsClosed.preimage hcont (isClosed_discrete _)
    -- The hypothesis descends to the quotient.
    have hmain : Subgroup.map π R ≤
        Subgroup.normalClosure ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set _) ⊔
          relFrattini p (Subgroup.map π R) := by
      have h1 := Subgroup.map_mono (f := π) hspan
      rw [Subgroup.map_sup] at h1
      refine le_trans h1 (sup_le (le_trans (le_trans hMle (le_of_eq hNC)) le_sup_left)
        (le_trans hrel le_sup_right))
    have hsub : ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set (Γ ⧸ U.toSubgroup)) ⊆
        (Subgroup.map π R : Set (Γ ⧸ U.toSubgroup)) := by
      intro x hx
      rw [Finset.coe_image] at hx
      obtain ⟨s, hs, rfl⟩ := hx
      exact Subgroup.mem_map_of_mem π (hS hs)
    -- The finite Nakayama step in `Γ ⧸ U`.
    have hfin : Subgroup.map π R ≤
        Subgroup.normalClosure ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set _) :=
      le_normalClosure_of_le_sup_relFrattini (hΓ U) hsub hmain
    -- Undo the quotient: `R ≤ ⟪S⟫ · U`.
    have hcomap : R ≤ Subgroup.comap π
        (Subgroup.normalClosure ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set _)) :=
      fun x hx => Subgroup.mem_comap.mpr (hfin (Subgroup.mem_map_of_mem π hx))
    calc R ≤ Subgroup.comap π
          (Subgroup.normalClosure ((S.image π : Finset (Γ ⧸ U.toSubgroup)) : Set _)) := hcomap
      _ = Subgroup.comap π (Subgroup.map π (Subgroup.normalClosure (S : Set Γ))) := by rw [hNC]
      _ = Subgroup.normalClosure (S : Set Γ) ⊔ U.toSubgroup := by
            rw [Subgroup.comap_map_eq, QuotientGroup.ker_mk']
  -- Step 2: a closed subgroup is the intersection of the open subgroups containing it.
  set M : Subgroup Γ := (Subgroup.normalClosure (S : Set Γ)).topologicalClosure with hM
  have hMclosed : IsClosed (M : Set Γ) := Subgroup.isClosed_topologicalClosure _
  have hsInf : M = sInf {V : Subgroup Γ | IsOpen (V : Set Γ) ∧ M ≤ V} := by
    simpa only using
      ProfiniteGrp.closedSubgroup_eq_sInf_open (G := Γ) (⟨M, hMclosed⟩ : ClosedSubgroup Γ)
  change R ≤ M
  rw [hsInf]
  refine le_sInf ?_
  rintro V ⟨hVopen, hMV⟩
  obtain ⟨U, hU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hVopen
    (hMV (Subgroup.le_topologicalClosure _ (Subgroup.one_mem _)))
  exact le_trans (key U) (sup_le (le_trans (Subgroup.le_topologicalClosure _) hMV) hU)

end Work.HopfGaschutz
