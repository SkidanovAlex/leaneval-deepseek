import Mathlib
import Submission.Work.HopfGaschutz.Defs

/-!
# The relation-Frattini condition descends along quotient maps

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.map_mk_le_pPower_sup_commutator`.

The engine `le_normalClosure_of_le_sup_relFrattini` (`le_normalClosure_of_le_sup_relFrattini.lean`)
proves, inside a finite `p`-group `G`, that `K ≤ ⟨S⟩^G · K^p[K,G]` forces `K ≤ ⟨S⟩^G`; its proof
passes to a quotient `G ⧸ L` by a maximal normal subgroup, and there it needs the *elementary*
fact that the relation-Frattini condition survives the passage to the quotient.  This file isolates
that fact:

> if `V ≤ V^p · [V,G]` holds in `G`, then the same holds for the image `V C/C` of `V` in `G ⧸ C`,
> namely `V C/C ≤ (V C/C)^p · [V C/C, G/C]`.

The proof is purely formal: `map` is monotone and commutes with `⊔`, the `p`-th power subgroup and
the commutator subgroup are functorial under a surjective homomorphism with `⊤` mapping onto `⊤`,
and `QuotientGroup.mk' C` is surjective.  No finiteness, no `p`-group hypothesis, no primality of
`p` is used -- the statement is a functoriality statement, valid for every group, every `p` and
every normal `C`.

The declaration is the one requested (statement unchanged) under the name
`Work.HopfGaschutz.map_mk_le_pPower_sup_commutator`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.HopfGaschutz

open scoped commutatorElement

/-- **Functoriality of the `p`-th power subgroup.**  The image of `V^p` under a homomorphism is
contained in the `p`-th power subgroup of the image of `V` (it is generated by the `p`-th powers of
elements of `V`, whose images are the `p`-th powers of elements of `V.map f`). -/
theorem map_pPower_le (p : ℕ) {G H : Type*} [Group G] [Group H] (f : G →* H) (V : Subgroup G) :
    (pPower p V).map f ≤ pPower p (V.map f) := by
  rw [Subgroup.map_le_iff_le_comap, pPower, Subgroup.closure_le]
  rintro x ⟨k, hk, rfl⟩
  change f (k ^ p) ∈ pPower p (V.map f)
  exact Subgroup.subset_closure ⟨f k, Subgroup.mem_map_of_mem f hk, (map_pow f k p).symm⟩

theorem map_mk_le_pPower_sup_commutator {G : Type*} [Group G] {p : ℕ} {V C : Subgroup G} [C.Normal]
    (h : V ≤ Work.HopfGaschutz.pPower p V ⊔ ⁅V, ⊤⁆) :
    V.map (QuotientGroup.mk' C) ≤
      Work.HopfGaschutz.pPower p (V.map (QuotientGroup.mk' C)) ⊔ ⁅V.map (QuotientGroup.mk' C), ⊤⁆ := by
  have hsurj : Function.Surjective (QuotientGroup.mk' C) := QuotientGroup.mk'_surjective C
  -- Monotonicity of `map` transports the hypothesis to the quotient.
  have h1 : V.map (QuotientGroup.mk' C) ≤
      (pPower p V ⊔ ⁅V, (⊤ : Subgroup G)⁆).map (QuotientGroup.mk' C) :=
    Subgroup.map_mono h
  rw [Subgroup.map_sup] at h1
  refine le_trans h1 (sup_le ?_ ?_)
  · exact le_trans (map_pPower_le p (QuotientGroup.mk' C) V) le_sup_left
  · rw [Subgroup.map_commutator, Subgroup.map_top_of_surjective _ hsurj]
    exact le_sup_right

end Work.HopfGaschutz
