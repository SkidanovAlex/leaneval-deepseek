import Mathlib

/-!
# An abelian group of exponent `p` generated by `T` has at most `p ^ |T|` elements

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.finite_and_natCard_le_pow_of_comm_exp_p`.

If `A` is an abelian group all of whose elements satisfy `a ^ p = 1` for a prime `p`, then `A` is an
`𝔽_p`-vector space, and it is generated as such by any generating set of `A`.  Hence a generating
finset `T` makes `A` finite, of cardinality at most `p ^ |T|` (it is a quotient of the space of
functions `T → 𝔽_p` of dimension `|T|`).

This is the elementary cardinality bound behind the Burnside basis / Frattini-quotient dictionary of
the `Work.HopfGaschutz` area: the Frattini quotient of a finite `p`-group is an elementary abelian
`p`-group generated by the images of any generating set.

## The proof

The map `F : (T → ZMod p) → A`, `f ↦ ∏_{t ∈ T} t ^ (f t).val`, is defined by reducing the exponents
of the standard monomials `∏ t ^ n t` modulo `p` (possible because `t ^ p = 1`).  It is surjective,
because `Set.range F` is a subgroup (it contains `1`, and is closed under multiplication and
inversion by `F 0 = 1`, `F (f + g) = F f * F g`, `F (-f) = (F f)⁻¹`) that contains `T`, so it
contains `Subgroup.closure T = ⊤`; this is the `Subgroup.closure_induction` step (`hsurj`).
`Finite.of_surjective` then gives finiteness and `Fintype.card_le_of_surjective` together with
`Fintype.card (T → ZMod p) = p ^ T.card` the cardinality bound.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

theorem finite_and_natCard_le_pow_of_comm_exp_p {A : Type*} [Group A] {p : ℕ} [Fact p.Prime]
    (hcomm : ∀ a b : A, a * b = b * a) (hpow : ∀ a : A, a ^ p = 1) {T : Finset A}
    (hT : Subgroup.closure (T : Set A) = ⊤) : Finite A ∧ Nat.card A ≤ p ^ T.card := by
  classical
  have hp : p.Prime := Fact.out
  haveI hne : NeZero p := ⟨hp.ne_zero⟩
  haveI hlt : Fact (1 < p) := ⟨hp.one_lt⟩
  letI : CommGroup A := { ‹Group A› with mul_comm := hcomm }
  -- the monomial map `f ↦ ∏ t ^ (f t).val` from exponent vectors to `A`
  set F : (↥T → ZMod p) → A := fun f => ∏ t : ↥T, (t : A) ^ (f t).val with hF
  have hF_zero : F 0 = 1 := by
    simp only [hF]
    exact Finset.prod_eq_one fun t _ => by rw [Pi.zero_apply, ZMod.val_zero, pow_zero]
  have hF_add : ∀ f g : ↥T → ZMod p, F (f + g) = F f * F g := by
    intro f g
    simp only [hF, Pi.add_apply]
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun t _ => ?_
    rw [ZMod.val_add, ← pow_eq_pow_mod ((f t).val + (g t).val) (hpow (t : A)), pow_add]
  have hF_neg : ∀ f : ↥T → ZMod p, F (-f) = (F f)⁻¹ := by
    intro f
    have h := hF_add f (-f)
    rw [add_neg_cancel, hF_zero] at h
    exact eq_inv_of_mul_eq_one_right h.symm
  -- surjectivity of `F`, by closure induction: the range of `F` is a subgroup containing `T`
  have hsurj : Function.Surjective F := by
    intro a
    have ha : a ∈ Subgroup.closure (T : Set A) := by rw [hT]; exact Subgroup.mem_top a
    refine Subgroup.closure_induction (k := (T : Set A))
      (p := fun x _ => ∃ f : ↥T → ZMod p, F f = x) ?_ ?_ ?_ ?_ ha
    · intro x hx
      refine ⟨Pi.single ⟨x, hx⟩ 1, ?_⟩
      simp only [hF]
      rw [Finset.prod_eq_single ⟨x, hx⟩
        (fun b _ hb => by rw [Pi.single_eq_of_ne hb, ZMod.val_zero, pow_zero])
        (fun h => absurd (Finset.mem_univ _) h)]
      simp only [Pi.single_eq_same, ZMod.val_one, pow_one]
    · exact ⟨0, hF_zero⟩
    · intro x y hx hy ihx ihy
      obtain ⟨f, hf⟩ := ihx
      obtain ⟨g, hg⟩ := ihy
      exact ⟨f + g, by rw [hF_add, hf, hg]⟩
    · intro x hx ih
      obtain ⟨f, hf⟩ := ih
      exact ⟨-f, by rw [hF_neg, hf]⟩
  haveI hfin : Finite A := Finite.of_surjective F hsurj
  refine ⟨hfin, ?_⟩
  haveI : Fintype A := Fintype.ofFinite A
  rw [Nat.card_eq_fintype_card]
  calc Fintype.card A ≤ Fintype.card (↥T → ZMod p) := Fintype.card_le_of_surjective F hsurj
    _ = p ^ T.card := by rw [Fintype.card_fun, ZMod.card, Fintype.card_coe]

end Work.HopfGaschutz
