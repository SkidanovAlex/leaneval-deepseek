import Mathlib
import Submission.Work.HopfGaschutz.Setup
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.normalClosure_eq_sup_commutator
import Submission.Work.HopfGaschutz.relFrattiniDim_le_card_of_normalGenerates
import Submission.Work.HopfGaschutz.normalGeneratorNumber_eq_relFrattiniDim_of_finite_pgroup
import Submission.Commons.GroupTheory.PGroup.burnside_basis
import Submission.Commons.GroupTheory.PGroup.frattini_eq_pow_sup_commutator

/-!
# `presKernel gen ≤ Φ_p(FreeGroup α)` for a minimal generating family of a finite `p`-group

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.le_relFrattini_of_minimal_generating`.

Let `Q` be a finite `p`-group, `α` a finite type and `gen : α → Q` a generating family of `Q`
which is *minimal*: every generating `Finset` of `Q` has at least `Fintype.card α` elements.  Then
the kernel `K = presKernel gen` of the induced presentation `FreeGroup α ↠ Q` is contained in the
relation-Frattini subgroup `relFrattini p ⊤ = (FreeGroup α)^p · [(FreeGroup α), (FreeGroup α)]`.

Equivalently: the Frattini quotient of the free group surjects *isomorphically* onto the Frattini
quotient of `Q`, so the kernel of the presentation is as small as it can possibly be.

## The proof

Write `F = FreeGroup α`, `q = FreeGroup.lift gen : F ↠ Q`, `Φ_F = relFrattini p ⊤ ≤ F`,
`Φ_Q = relFrattini p ⊤ ≤ Q`, `X = F ⧸ Φ_F` and `Y = Q ⧸ Φ_Q`.

* `q` carries `Φ_F` onto `Φ_Q` (`relFrattini_map_aux`), so it induces a surjection
  `φ : X ↠ Y`.
* `X` is an elementary abelian `p`-group generated by the `d = Fintype.card α` images of the free
  generators, hence finite with `|X| ≤ p ^ d` (the counting lemma `natCard_le_pow_card_of_closure_eq_top`
  of the chapter; finiteness follows because `X` is a finitely generated torsion abelian group).
* `Y` has `p ^ d` elements: for a finite `p`-group the relation-Frattini subgroup is the Frattini
  subgroup (`frattini_eq_pow_sup_commutator`), so `Y = Q ⧸ Φ(Q)` and Burnside's basis theorem
  (`burnside_basis`) produces a minimal generating set `S` of `Q` with `|Y| = p ^ |S|`; the
  minimality hypothesis forces `|S| = d`.
* Hence `p ^ d = |Y| ≤ |X| ≤ p ^ d`, so the surjection `φ` is injective.  Since `q` kills
  `presKernel gen`, its image in `X` lies in `ker φ = ⊥`, i.e. `presKernel gen ≤ Φ_F`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1000000

namespace Work.HopfGaschutz

open scoped commutatorElement

/-- The `p`-th power subgroup of the whole group is the subgroup generated by the `p`-th powers. -/
theorem pPower_top_eq_closure_range_pow {G : Type*} [Group G] (p : ℕ) :
    pPower p (⊤ : Subgroup G) = Subgroup.closure (Set.range (fun x : G => x ^ p)) := by
  rw [pPower]
  congr 1
  ext x
  simp

/-- For a finite `p`-group the relation-Frattini subgroup is the Frattini subgroup. -/
theorem relFrattini_top_eq_frattini {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime]
    (hQ : IsPGroup p Q) : relFrattini p (⊤ : Subgroup Q) = frattini Q := by
  rw [relFrattini, pPower_top_eq_closure_range_pow, ← commutator_def]
  exact (Commons.GroupTheory.PGroup.frattini_eq_pow_sup_commutator hQ).symm

theorem le_relFrattini_of_minimal_generating {α Q : Type*} [Group Q] [Fintype Q] [Fintype α]
    [DecidableEq α] {p : ℕ} [Fact p.Prime] (hQ : IsPGroup p Q)
    (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : ∀ S : Finset Q, Subgroup.closure (S : Set Q) = ⊤ → Fintype.card α ≤ S.card) :
    Work.HopfGaschutz.presKernel gen ≤ Work.HopfGaschutz.relFrattini p ⊤ := by
  classical
  haveI hFinQ : Finite Q := Finite.of_fintype Q
  haveI hFinα : Finite α := Finite.of_fintype α
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  have hppos : 0 < p := (Fact.out : p.Prime).pos
  -- the presentation map
  set q : FreeGroup α →* Q := FreeGroup.lift gen with hqdef
  have hq : Function.Surjective q :=
    FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr hgen
  -- the two relation-Frattini subgroups
  set ΦF : Subgroup (FreeGroup α) := relFrattini p (⊤ : Subgroup (FreeGroup α)) with hΦFdef
  haveI hΦFn : ΦF.Normal := by rw [hΦFdef]; infer_instance
  set ΦQ : Subgroup Q := relFrattini p (⊤ : Subgroup Q) with hΦQdef
  haveI hΦQn : ΦQ.Normal := by rw [hΦQdef]; infer_instance
  have hΦQfr : ΦQ = frattini Q := by
    rw [hΦQdef]; exact relFrattini_top_eq_frattini hQ
  -- `q` maps `Φ_F` onto `Φ_Q`
  have hmapΦ : ΦF.map q = ΦQ := by
    rw [hΦFdef, hΦQdef, ← relFrattini_map_aux p ⊤ q hq,
      Subgroup.map_top_of_surjective q hq]
  have hle : ΦF ≤ ΦQ.comap q := by
    intro x hx
    rw [Subgroup.mem_comap, ← hmapΦ]
    exact Subgroup.mem_map_of_mem q hx
  have hle' : ΦF ≤ (frattini Q).comap q := by
    rw [← hΦQfr]; exact hle
  -- the induced surjection of Frattini quotients
  set φ : (FreeGroup α) ⧸ ΦF →* Q ⧸ frattini Q :=
    QuotientGroup.map ΦF (frattini Q) q hle' with hφdef
  have hφsurj : Function.Surjective φ := by
    rw [hφdef]
    exact QuotientGroup.map_surjective_of_surjective ΦF (frattini Q) q
      (QuotientGroup.mk_surjective.comp hq) hle'
  -- ## The source Frattini quotient `X` is an elementary abelian `p`-group
  have hXcomm : ∀ a b : (FreeGroup α) ⧸ ΦF, a * b = b * a := by
    haveI : IsMulCommutative ((FreeGroup α) ⧸ ΦF) :=
      (Subgroup.Normal.quotient_commutative_iff_commutator_le (N := ΦF)).mpr (by
        rw [hΦFdef, commutator_def]
        exact le_sup_right)
    intro a b
    exact mul_comm' a b
  have hXpow : ∀ x : (FreeGroup α) ⧸ ΦF, x ^ p = 1 := by
    intro x
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective ΦF x
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hΦFdef]
    exact pow_mem_relFrattini p ⊤ (Subgroup.mem_top y)
  -- a generating set of `X` with at most `d` elements
  have hgenF : Subgroup.closure ((Finset.univ.image (FreeGroup.of : α → FreeGroup α) :
      Finset (FreeGroup α)) : Set (FreeGroup α)) = ⊤ := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact FreeGroup.closure_range_of α
  set T : Finset ((FreeGroup α) ⧸ ΦF) :=
    (Finset.univ.image (FreeGroup.of : α → FreeGroup α)).image (QuotientGroup.mk' ΦF) with hTdef
  have hTgen : Subgroup.closure (T : Set ((FreeGroup α) ⧸ ΦF)) = ⊤ := by
    have h2 : Subgroup.closure
        ((QuotientGroup.mk' ΦF) '' (Set.range (FreeGroup.of : α → FreeGroup α))) = ⊤ := by
      rw [← MonoidHom.map_closure, FreeGroup.closure_range_of,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective ΦF)]
    have himg : (QuotientGroup.mk' ΦF) '' (Set.range (FreeGroup.of : α → FreeGroup α))
        = (T : Set ((FreeGroup α) ⧸ ΦF)) := by
      rw [hTdef, Finset.coe_image, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    rwa [himg] at h2
  have hTcard : T.card ≤ Fintype.card α := by
    rw [hTdef]
    exact Finset.card_image_le.trans (Finset.card_image_le.trans (le_of_eq Finset.card_univ))
  -- the abelianization of `X` is `X` itself, since `X` is abelian
  have hsurjA : Function.Surjective (Abelianization.of (G := (FreeGroup α) ⧸ ΦF)) :=
    fun y => QuotientGroup.mk'_surjective (commutator ((FreeGroup α) ⧸ ΦF)) y
  have hkerA : (Abelianization.of (G := (FreeGroup α) ⧸ ΦF)).ker = ⊥ := by
    rw [Abelianization.ker_of,
      (commutator_eq_bot_iff ((FreeGroup α) ⧸ ΦF)).mpr ⟨⟨hXcomm⟩⟩]
  have hinjA : Function.Injective (Abelianization.of (G := (FreeGroup α) ⧸ ΦF)) :=
    (MonoidHom.ker_eq_bot_iff _).mp hkerA
  have hexpA : ∀ x : Abelianization ((FreeGroup α) ⧸ ΦF), x ^ p = 1 := by
    intro x
    obtain ⟨y, rfl⟩ := hsurjA x
    rw [← map_pow, hXpow y, map_one]
  have hgenA : Subgroup.closure
      (((T.image (Abelianization.of (G := (FreeGroup α) ⧸ ΦF))) :
        Finset (Abelianization ((FreeGroup α) ⧸ ΦF))) :
        Set (Abelianization ((FreeGroup α) ⧸ ΦF))) = ⊤ := by
    have h := MonoidHom.map_closure (Abelianization.of (G := (FreeGroup α) ⧸ ΦF))
      (T : Set ((FreeGroup α) ⧸ ΦF))
    rw [hTgen, Subgroup.map_top_of_surjective _ hsurjA] at h
    rw [Finset.coe_image]
    exact h.symm
  have hAfin : Finite (Abelianization ((FreeGroup α) ⧸ ΦF)) := by
    have hfg : Group.FG (Abelianization ((FreeGroup α) ⧸ ΦF)) :=
      Group.fg_of_surjective (f := Abelianization.of (G := (FreeGroup α) ⧸ ΦF)) hsurjA
    exact CommGroup.finite_of_fg_isMulTorsion _
      (fun g => (isOfFinOrder_iff_pow_eq_one).mpr ⟨p, hppos, hexpA g⟩)
  have hXfinite : Finite ((FreeGroup α) ⧸ ΦF) := Finite.of_injective _ hinjA
  have hXcard : Nat.card ((FreeGroup α) ⧸ ΦF) ≤ p ^ Fintype.card α := by
    rw [Nat.card_congr (MulEquiv.ofBijective _ ⟨hinjA, hsurjA⟩).toEquiv]
    have hb := natCard_le_pow_card_of_closure_eq_top
      (G := Abelianization ((FreeGroup α) ⧸ ΦF)) p hppos hexpA hgenA
    exact hb.trans (Nat.pow_le_pow_right (Fact.out : p.Prime).one_le
      (Finset.card_image_le.trans hTcard))
  -- ## The target Frattini quotient `Y` has exactly `p ^ d` elements
  have hQcard : Nat.card (Q ⧸ frattini Q) = p ^ Fintype.card α := by
    obtain ⟨S, hScard, hSclos, hSmin⟩ := Commons.GroupTheory.PGroup.burnside_basis (p := p) hQ
    have hSgen' : Subgroup.closure ((Finset.univ.image gen : Finset Q) : Set Q) = ⊤ := by
      rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
      exact hgen
    have hSle : S.card ≤ Fintype.card α :=
      (hSmin (Finset.univ.image gen) hSgen').trans
        (Finset.card_image_le.trans (le_of_eq Finset.card_univ))
    have hdS : Fintype.card α ≤ S.card := hmin S hSclos
    rw [hScard, le_antisymm hSle hdS]
  -- ## Lagrange: the kernel of `φ` is trivial
  have hLag := Subgroup.card_eq_card_quotient_mul_card_subgroup (φ.ker)
  have hiso : Nat.card (((FreeGroup α) ⧸ ΦF) ⧸ φ.ker) = Nat.card (Q ⧸ frattini Q) := by
    have hrange : φ.range = ⊤ := MonoidHom.range_eq_top.mpr hφsurj
    calc Nat.card (((FreeGroup α) ⧸ ΦF) ⧸ φ.ker)
        = Nat.card ↥φ.range := Nat.card_congr (QuotientGroup.quotientKerEquivRange φ).toEquiv
      _ = Nat.card ↥(⊤ : Subgroup (Q ⧸ frattini Q)) := by rw [hrange]
      _ = Nat.card (Q ⧸ frattini Q) := Nat.card_congr (Subgroup.topEquiv).toEquiv
  have hcardX : Nat.card ((FreeGroup α) ⧸ ΦF)
      = Nat.card (Q ⧸ frattini Q) * Nat.card ↥φ.ker := by
    rw [hLag, hiso]
  have hker_le : Nat.card ↥φ.ker ≤ 1 := by
    have h1 : Nat.card (Q ⧸ frattini Q) * Nat.card ↥φ.ker ≤ p ^ Fintype.card α := by
      rw [← hcardX]; exact hXcard
    rw [hQcard] at h1
    have h2 : p ^ Fintype.card α * Nat.card ↥φ.ker ≤ p ^ Fintype.card α * 1 := by
      simpa using h1
    exact Nat.le_of_mul_le_mul_left h2 (pow_pos hppos _)
  have hker_pos : 1 ≤ Nat.card ↥φ.ker := by
    haveI : Nonempty ↥φ.ker := ⟨⟨1, φ.ker.one_mem⟩⟩
    exact Nat.card_pos
  have hker_card_one : Nat.card ↥φ.ker = 1 := le_antisymm hker_le hker_pos
  have hker_bot : φ.ker = ⊥ := by
    haveI : Subsingleton ↥φ.ker :=
      (Finite.card_le_one_iff_subsingleton).mp (le_of_eq hker_card_one)
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    have h : (⟨x, hx⟩ : ↥φ.ker) = 1 := Subsingleton.elim _ _
    simpa using congrArg Subtype.val h
  -- ## Conclusion
  intro x hx
  have hqx : q x = 1 := by
    rw [hqdef]
    exact (mem_presKernel gen).mp hx
  have hmk : (QuotientGroup.mk' ΦF) x ∈ φ.ker := by
    rw [MonoidHom.mem_ker, hφdef, QuotientGroup.map_mk']
    simp [hqx]
  rw [hker_bot] at hmk
  have hmk1 : (QuotientGroup.mk' ΦF) x = 1 := by simpa using hmk
  have hxker : x ∈ (QuotientGroup.mk' ΦF).ker := MonoidHom.mem_ker.mpr hmk1
  rw [QuotientGroup.ker_mk'] at hxker
  rwa [hΦFdef] at hxker

end Work.HopfGaschutz
