import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.normalClosure_eq_sup_commutator

/-!
# `relFrattiniDim p K ≤ |S|` for a normal generating set `S` of `K`

**Module** `Submission.Work.HopfGaschutz.relFrattiniDim_le_card_of_normalGenerates`.

If a finite set `S` normally generates a normal subgroup `K ⊴ F`, then the relation rank
`relFrattiniDim p K = log_p |K ⧸ K^p[K,F]|` is at most `|S|`.

The mathematics is the elementary upper bound: `Q := K ⧸ K^p[K,F]` is abelian (because
`[K,K] ≤ [K,F]`) and has exponent `p` (because `K^p ≤ K^p[K,F]`), and it is generated, as an
abelian group, by the images of `S` -- indeed `K = ⟪S⟫^F = ⟨S⟩ · [⟨S⟩, F]`, and `[K,F] ≤ K^p[K,F]`.
Hence `Q` is a quotient of `(ℤ/p)^{|S|}`, so `|Q| ≤ p ^ |S|` and taking `log_p` gives the claim.

The counting is done in `ZMod p`-modules: an abelian group killed by `p` is a `ZMod p`-module
(`AddCommGroup.zmodModule`), and a finitely generated such module is a quotient of `(ZMod p)^n`
where `n` is the size of a generating set (`natCard_le_pow_card_additive`).  The quotient `Q` is
only *propositionally* commutative, so to apply the counting lemma (which lives in the commutative
setting) we pass to its abelianization, an isomorphic commutative group because `Q` is commutative.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

open scoped commutatorElement

variable {F : Type*} [Group F]

/-! ## The counting lemma -/

/-- **Counting lemma, additive form.** Let `M` be an abelian group in which every element is killed
by `p ≠ 0`. If a subgroup generated by a finite set `T` is all of `M`, then `|M| ≤ p ^ #T`:
`M` is a `ZMod p`-module generated by `#T` elements, hence a quotient of `(ZMod p)^{#T}`. -/
theorem natCard_le_pow_card_additive {M : Type*} [AddCommGroup M] (p : ℕ) (hpz : 0 < p)
    (hp : ∀ x : M, p • x = 0) {T : Finset M}
    (hT : AddSubgroup.closure (T : Set M) = ⊤) : Nat.card M ≤ p ^ T.card := by
  classical
  haveI : NeZero p := ⟨Nat.pos_iff_ne_zero.mp hpz⟩
  haveI : Module (ZMod p) M := AddCommGroup.zmodModule hp
  have hspan : Submodule.span (ZMod p) (T : Set M) = ⊤ := by
    have hle : AddSubgroup.closure (T : Set M) ≤
        (Submodule.span (ZMod p) (T : Set M)).toAddSubgroup :=
      (AddSubgroup.closure_le _).mpr fun x hx =>
        (Submodule.mem_toAddSubgroup _).mpr (Submodule.subset_span hx)
    have htop : (⊤ : AddSubgroup M) ≤ (Submodule.span (ZMod p) (T : Set M)).toAddSubgroup :=
      hT ▸ hle
    have h2 : (Submodule.span (ZMod p) (T : Set M)).toAddSubgroup = ⊤ := top_le_iff.mp htop
    exact Submodule.toAddSubgroup_eq_top.mp h2
  have hsurj : Function.Surjective (fun f : ↥T → ZMod p => ∑ t : ↥T, f t • (t : M)) := by
    intro x
    have hx : x ∈ Submodule.span (ZMod p) (T : Set M) := by
      rw [hspan]; exact Submodule.mem_top
    refine Submodule.span_induction
      (p := fun x _ => ∃ f : ↥T → ZMod p, (∑ t : ↥T, f t • (t : M)) = x) ?_ ?_ ?_ ?_ hx
    · intro t ht
      refine ⟨fun s => if (s : M) = t then 1 else 0, ?_⟩
      rw [Finset.sum_eq_single (⟨t, ht⟩ : ↥T)]
      · simp
      · intro b _ hb
        have h : (b : M) ≠ t := fun hc => hb (Subtype.ext hc)
        simp [h]
      · intro hb
        exact absurd (Finset.mem_univ _) hb
    · exact ⟨fun _ => 0, by simp⟩
    · intro x y _ _ hx hy
      obtain ⟨f, hf⟩ := hx
      obtain ⟨g, hg⟩ := hy
      refine ⟨f + g, ?_⟩
      rw [← hf, ← hg, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun t _ => by rw [Pi.add_apply, add_smul]
    · intro c x _ hx
      obtain ⟨f, hf⟩ := hx
      refine ⟨c • f, ?_⟩
      rw [← hf, Finset.smul_sum]
      exact Finset.sum_congr rfl fun t _ => by
        rw [Pi.smul_apply, smul_eq_mul, mul_smul]
  have hcard := Nat.card_le_card_of_surjective _ hsurj
  rw [Nat.card_fun, Nat.card_zmod] at hcard
  have hTc : Nat.card ↥T = T.card := by
    rw [Nat.card_eq_fintype_card, Fintype.card_coe]
  rwa [hTc] at hcard

/-- **Counting lemma, group form.** In a commutative group of exponent dividing `p ≠ 0`, a subgroup
generated by a finite set `T` has at most `p ^ #T` elements. -/
theorem natCard_le_pow_card_of_closure_eq_top {G : Type*} [CommGroup G] (p : ℕ) (hpz : 0 < p)
    (hexp : ∀ x : G, x ^ p = 1) {T : Finset G}
    (hT : Subgroup.closure (T : Set G) = ⊤) : Nat.card G ≤ p ^ T.card := by
  classical
  have hp0 : ∀ x : Additive G, p • x = 0 := by
    intro x
    obtain ⟨g, rfl⟩ := Additive.ofMul.surjective x
    rw [← ofMul_pow, hexp g, ofMul_one]
  have hT' : AddSubgroup.closure
      ((T.image Additive.ofMul : Finset (Additive G)) : Set (Additive G)) = ⊤ := by
    rw [← top_le_iff]
    intro x _
    obtain ⟨g, rfl⟩ := Additive.ofMul.surjective x
    have hg : g ∈ Subgroup.closure (T : Set G) := hT.ge (Subgroup.mem_top g)
    refine Subgroup.closure_induction
      (p := fun a _ => Additive.ofMul a ∈ AddSubgroup.closure
        ((T.image Additive.ofMul : Finset (Additive G)) : Set (Additive G))) ?_ ?_ ?_ ?_ hg
    · intro a ha
      exact AddSubgroup.subset_closure (Finset.mem_image.mpr ⟨a, ha, rfl⟩)
    · rw [ofMul_one]
      exact AddSubgroup.zero_mem _
    · intro a b _ _ ha hb
      rw [ofMul_mul]
      exact AddSubgroup.add_mem _ ha hb
    · intro a _ ha
      rw [ofMul_inv]
      exact AddSubgroup.neg_mem _ ha
  have h := natCard_le_pow_card_additive p hpz hp0 hT'
  rw [← Nat.card_congr Additive.ofMul,
    Finset.card_image_of_injective T Additive.ofMul.injective] at h
  exact h

/-! ## The main statement -/

theorem relFrattiniDim_le_card_of_normalGenerates {F : Type*} [Group F] (p : ℕ) {K : Subgroup F}
    [K.Normal] (hK : Group.FG K) {S : Finset F} (h : NormalGenerates K S) :
    relFrattiniDim p K ≤ S.card := by
  classical
  by_cases hp1 : p ≤ 1
  · rw [relFrattiniDim, Nat.log_of_left_le_one hp1]
    exact Nat.zero_le _
  · have hp1' : 1 < p := Nat.lt_of_not_le hp1
    have hsub : (S : Set F) ⊆ K := NormalGenerates.subset h
    -- the lifts of `S` into `K`, and their images in the relation-Frattini quotient
    set T : Finset K := S.attach.image (fun s => (⟨s.1, hsub s.2⟩ : K)) with hT
    set TQ : Finset (K ⧸ relFrattiniIn p K) :=
      T.image (QuotientGroup.mk' (relFrattiniIn p K)) with hTQ
    have hmemT : ∀ (s : F) (hs : s ∈ S), (⟨s, hsub hs⟩ : K) ∈ T := by
      intro s hs
      rw [hT]
      refine Finset.mem_image.mpr ⟨⟨s, hs⟩, Finset.mem_attach _ _, ?_⟩
      exact Subtype.ext rfl
    -- the quotient is abelian and has exponent `p`
    have hcomm : ∀ x y : K ⧸ relFrattiniIn p K, x * y = y * x := by
      intro x y
      obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
      obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) y
      rw [← commutatorElement_eq_one_iff_mul_comm]
      rw [← map_commutatorElement (QuotientGroup.mk' (relFrattiniIn p K)) a b]
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      show (Subgroup.subtype K) (⁅a, b⁆ : K) ∈ relFrattini p K
      rw [map_commutatorElement (Subgroup.subtype K) a b]
      exact commutator_mem_relFrattini p K a.2
    have hexp : ∀ x : K ⧸ relFrattiniIn p K, x ^ p = 1 := by
      intro x
      obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
      rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      show (Subgroup.subtype K) (a ^ p) ∈ relFrattini p K
      rw [map_pow]
      exact pow_mem_relFrattini p K a.2
    -- the quotient is generated by the images of `S`
    have hgen : Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K)) = ⊤ := by
      let L : Subgroup (K ⧸ relFrattiniIn p K) :=
        Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K))
      -- `M` is the preimage of `L` in `K`
      let M : Subgroup K := Subgroup.comap (QuotientGroup.mk' (relFrattiniIn p K)) L
      have hHle : Subgroup.closure (S : Set F) ≤ Subgroup.map (Subgroup.subtype K) M := by
        apply (Subgroup.closure_le _).mpr
        intro s hs
        refine Subgroup.mem_map.mpr ⟨⟨s, hsub hs⟩, ?_, rfl⟩
        rw [Subgroup.mem_comap]
        exact Subgroup.subset_closure
          (Finset.mem_image.mpr ⟨⟨s, hsub hs⟩, hmemT s hs, rfl⟩)
      have hRle : relFrattini p K ≤ Subgroup.map (Subgroup.subtype K) M := by
        intro x hx
        refine Subgroup.mem_map.mpr ⟨⟨x, relFrattini_le p K hx⟩, ?_, rfl⟩
        rw [Subgroup.mem_comap]
        have h1 : (QuotientGroup.mk' (relFrattiniIn p K))
            (⟨x, relFrattini_le p K hx⟩ : K) = 1 :=
          (QuotientGroup.eq_one_iff _).mpr hx
        rw [h1]
        exact Subgroup.one_mem L
      have hKle : K ≤ Subgroup.map (Subgroup.subtype K) M := by
        have hdecomp : K = Subgroup.closure (S : Set F) ⊔ ⁅Subgroup.closure (S : Set F), ⊤⁆ :=
          h.symm.trans (normalClosure_eq_sup_commutator (S : Set F))
        refine le_trans (le_of_eq hdecomp) (sup_le hHle (le_trans ?_ hRle))
        exact le_trans (Subgroup.commutator_mono ((Subgroup.closure_le K).mpr hsub) le_rfl)
          le_sup_right
      have hLtop : L = ⊤ := by
        rw [← top_le_iff]
        intro x _
        obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (relFrattiniIn p K) x
        have ha : (a : F) ∈ Subgroup.map (Subgroup.subtype K) M := hKle a.2
        obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp ha
        have hπm : (QuotientGroup.mk' (relFrattiniIn p K)) m =
            (QuotientGroup.mk' (relFrattiniIn p K)) a :=
          congrArg (QuotientGroup.mk' (relFrattiniIn p K)) (Subtype.ext hmx)
        rw [← hπm]
        exact Subgroup.mem_comap.mp hm
      exact hLtop
    -- ## the cardinality bound: count in the abelianization of `Q`
    have hsurjA : Function.Surjective (Abelianization.of (G := K ⧸ relFrattiniIn p K)) := fun x =>
      QuotientGroup.mk'_surjective (commutator (K ⧸ relFrattiniIn p K)) x
    have hcardA : Nat.card (K ⧸ relFrattiniIn p K)
        = Nat.card (Abelianization (K ⧸ relFrattiniIn p K)) := by
      have hker : (Abelianization.of (G := K ⧸ relFrattiniIn p K)).ker = ⊥ := by
        rw [Abelianization.ker_of, (commutator_eq_bot_iff (K ⧸ relFrattiniIn p K)).mpr ⟨⟨hcomm⟩⟩]
      have hinj : Function.Injective (Abelianization.of (G := K ⧸ relFrattiniIn p K)) :=
        (MonoidHom.ker_eq_bot_iff _).mp hker
      exact Nat.card_congr (MulEquiv.ofBijective _ ⟨hinj, hsurjA⟩).toEquiv
    set TA : Finset (Abelianization (K ⧸ relFrattiniIn p K)) :=
      TQ.image (Abelianization.of) with hTA
    have hgenA : Subgroup.closure (TA : Set (Abelianization (K ⧸ relFrattiniIn p K))) = ⊤ := by
      rw [hTA]
      have hmap : Subgroup.map (Abelianization.of (G := K ⧸ relFrattiniIn p K))
            (Subgroup.closure (TQ : Set (K ⧸ relFrattiniIn p K))) =
          Subgroup.closure
            ((TQ.image (Abelianization.of) : Finset (Abelianization (K ⧸ relFrattiniIn p K))) :
              Set (Abelianization (K ⧸ relFrattiniIn p K))) := by
        refine le_antisymm ?_ ?_
        · rw [Subgroup.map_le_iff_le_comap]
          refine (Subgroup.closure_le _).mpr fun y hy => ?_
          exact Subgroup.mem_comap.mpr
            (Subgroup.subset_closure (Finset.mem_image.mpr ⟨y, hy, rfl⟩))
        · apply (Subgroup.closure_le _).mpr
          intro y hy
          obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy
          exact Subgroup.mem_map_of_mem _ (Subgroup.subset_closure hx)
      rw [← hmap, hgen, Subgroup.map_top_of_surjective _ hsurjA]
    have hexpA : ∀ x : Abelianization (K ⧸ relFrattiniIn p K), x ^ p = 1 := by
      intro x
      obtain ⟨y, rfl⟩ := hsurjA x
      rw [← map_pow, hexp y, map_one]
    have hboundA : Nat.card (Abelianization (K ⧸ relFrattiniIn p K)) ≤ p ^ TA.card :=
      natCard_le_pow_card_of_closure_eq_top p (by omega) hexpA hgenA
    have hbound : Nat.card (K ⧸ relFrattiniIn p K) ≤ p ^ TQ.card := by
      rw [hcardA]
      refine le_trans hboundA (Nat.pow_le_pow_right (le_of_lt hp1') ?_)
      rw [hTA]
      exact Finset.card_image_le
    have hTQS : TQ.card ≤ S.card := by
      calc TQ.card = (T.image (QuotientGroup.mk' (relFrattiniIn p K))).card := by rw [hTQ]
        _ ≤ T.card := Finset.card_image_le
        _ = (S.attach.image (fun s => (⟨s.1, hsub s.2⟩ : K))).card := by rw [hT]
        _ ≤ S.attach.card := Finset.card_image_le
        _ = S.card := Finset.card_attach
    rw [relFrattiniDim]
    calc Nat.log p (Nat.card (K ⧸ relFrattiniIn p K))
        ≤ Nat.log p (p ^ S.card) :=
          Nat.log_mono_right (le_trans hbound (Nat.pow_le_pow_right (le_of_lt hp1') hTQS))
      _ = S.card := Nat.log_pow hp1' S.card

end Work.HopfGaschutz
