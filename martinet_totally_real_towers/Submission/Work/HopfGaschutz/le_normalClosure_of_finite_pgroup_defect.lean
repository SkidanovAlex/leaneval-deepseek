import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.eq_bot_of_eq_pow_sup_commutator

/-!
# The engine with a finite `p`-group defect

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.le_normalClosure_of_finite_pgroup_defect`.

This file proves the *general* engine of the relation-rank dictionary
(`Submission/Work/HopfGaschutz/Defs.lean`): a normal subgroup `K` of an arbitrary group `F`
which is generated modulo `K^p [K,F]` by the normal closure of a finite set `S ⊆ K` is already
generated by `S`, *provided* the defect `K ⧸ ⟨S⟩^F` is a finite `p`-group and `F ⧸ K` is a
`p`-group.

The finite case (`F` a finite `p`-group, `S = ∅` included) is the already-proved
`eq_bot_of_eq_pow_sup_commutator` / `le_normalClosure_of_le_sup_relFrattini`; here the ambient
group may be infinite, and only the *defect* `K ⧸ ⟨S⟩^F` is assumed finite.  The engine is
reduced to the finite case by a Nakayama induction on `|K ⧸ ⟨S⟩^F|` which exhibits, in any
nontrivial finite `p`-group defect `V ⧸` (with `G ⧸ V` a `p`-group), a nontrivial element of
`V ⊓ Z(G)` of order `p` and then quotients by it.

## Main results

* `finitePgroupDefect_exists_central` -- the fixed-point/Nakayama input: a nontrivial finite
  normal `p`-subgroup whose quotient is a `p`-group contains a central element of order `p`;
* `finitePgroupDefect_eq_bot` -- the engine `V ≤ V^p [V,G] → V = ⊥`;
* ★ `le_normalClosure_of_finite_pgroup_defect` -- the requested statement.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

open scoped commutatorElement

/-! ## The centre of a normal subgroup is normal -/

/-- The centre of a normal subgroup `V ⊴ G`, viewed as a subgroup of `G`, is normal in `G`:
conjugation by `g ∈ G` restricts to an automorphism of `V`, hence preserves its centre. -/
theorem finitePgroupDefect_center_map_normal {G : Type*} [Group G] {V : Subgroup G} [V.Normal] :
    (Subgroup.map V.subtype (Subgroup.center V)).Normal := by
  refine Subgroup.Normal.mk ?_
  intro z hz g
  rw [Subgroup.mem_map] at hz ⊢
  obtain ⟨z₀, hz₀, rfl⟩ := hz
  refine ⟨⟨g * (z₀:G) * g⁻¹, Subgroup.Normal.conj_mem ‹V.Normal› z₀ z₀.2 g⟩, ?_, rfl⟩
  rw [Subgroup.mem_center_iff] at hz₀ ⊢
  intro v
  have hmem : g⁻¹ * (v : G) * g ∈ V := by
    simpa only [inv_inv] using Subgroup.Normal.conj_mem ‹V.Normal› (v:G) v.2 g⁻¹
  have hw := hz₀ (⟨g⁻¹ * (v : G) * g, hmem⟩ : ↥V)
  have hw' : (g⁻¹ * (v:G) * g) * (z₀:G) = (z₀:G) * (g⁻¹ * (v:G) * g) :=
    congrArg Subtype.val hw
  apply Subtype.ext
  simp only [Subgroup.coe_mul]
  rw [show (v:G) * (g * (z₀:G) * g⁻¹) = g * ((g⁻¹ * (v:G) * g) * (z₀:G)) * g⁻¹ by group]
  rw [hw']
  group

/-! ## The Nakayama input: a central element of order `p` -/

/-- **Fixed points of a `p`-group action give a central element of order `p`.**

Let `V ⊴ G` be a nontrivial finite `p`-group such that `G ⧸ V` is a `p`-group.  Then `V` contains
an element `z` of order `p` which is central in `G`.

Concretely, the conjugation action of `G` on the centre `Z(V)` factors through the `p`-group
`G ⧸ V` (the elements of `V` commute with `Z(V)`), so by the orbit-counting fixed point theorem
`Z(V)` has a nontrivial `G`-fixed point, i.e. `Z(V) ⊓ Z(G) ≠ ⊥`; Cauchy's theorem then supplies
an element of order `p` in `Z(V) ⊓ Z(G) ⊆ V`. -/
theorem finitePgroupDefect_exists_central {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    {V : Subgroup G} [V.Normal] (hfin : Finite ↥V) (hV : IsPGroup p ↥V) (hnt : V ≠ ⊥)
    (hquot : IsPGroup p (G ⧸ V)) :
    ∃ z : G, z ∈ V ∧ z ∈ Subgroup.center G ∧ orderOf z = p := by
  classical
  set Z : Subgroup G := Subgroup.map V.subtype (Subgroup.center V) with hZdef
  have hZnorm : Z.Normal := finitePgroupDefect_center_map_normal
  have hZle : Z ≤ V := Subgroup.map_subtype_le _
  haveI : Z.Normal := hZnorm
  have hZne : Z ≠ ⊥ := by
    intro hbot
    have h2 : Subgroup.center ↥V ≤ V.subtype.ker := (Subgroup.map_eq_bot_iff _).mp hbot
    rw [Subgroup.ker_subtype] at h2
    have hc : Subgroup.center ↥V = ⊥ := le_bot_iff.mp h2
    haveI : Nontrivial ↥V := (Subgroup.nontrivial_iff_ne_bot V).mpr hnt
    have hlt := hV.bot_lt_center
    rw [hc] at hlt
    exact lt_irrefl _ hlt
  haveI : Finite ↥Z :=
    hfin.of_injective (Subgroup.inclusion hZle) (Subgroup.inclusion_injective hZle)
  have hZp : IsPGroup p ↥Z := hV.to_le hZle
  have hdvd : p ∣ Nat.card ↥Z := by
    have hntZ : Nontrivial ↥Z := (Subgroup.nontrivial_iff_ne_bot Z).mpr hZne
    obtain ⟨n, hn, hcard⟩ := (hZp.nontrivial_iff_card).mp hntZ
    rw [hcard]
    exact dvd_pow_self p (Nat.pos_iff_ne_zero.mp hn)
  have hcomm : ∀ (z : ↥Z) (v : ↥V), (v:G) * (z:G) = (z:G) * (v:G) := by
    intro z v
    obtain ⟨z₀, hz₀, hzeq⟩ := z.2
    rw [← hzeq]
    exact congrArg Subtype.val ((Subgroup.mem_center_iff.mp hz₀) v)
  have hker : V ≤ (MulAut.conjNormal (H := Z)).ker := by
    intro v hv
    rw [MonoidHom.mem_ker]
    apply MulEquiv.ext
    intro z
    apply Subtype.ext
    rw [MulAut.conjNormal_apply, MulAut.one_apply]
    have key : v * (z:G) = (z:G) * v := hcomm z ⟨v, hv⟩
    rw [key, mul_inv_cancel_right]
  letI : MulDistribMulAction (G ⧸ V) ↥Z :=
    MulDistribMulAction.compHom ↥Z (QuotientGroup.lift V (MulAut.conjNormal (H := Z)) hker)
  obtain ⟨z, hzfix, hzne⟩ := hquot.exists_fixed_point_of_prime_dvd_card_of_fixed_point ↥Z hdvd
    (a := (1 : ↥Z)) (by rw [MulAction.mem_fixedPoints]; intro q; exact smul_one q)
  have hzcent : ((z : ↥Z) : G) ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    have h1 : (QuotientGroup.mk' V g) • z = z := (MulAction.mem_fixedPoints.mp hzfix) _
    have h2 : MulAut.conjNormal g z = z := h1
    have h3 : g * ((z:↥Z):G) * g⁻¹ = ((z:↥Z):G) := by
      rw [← MulAut.conjNormal_apply g z, h2]
    calc g * ((z:↥Z):G) = g * ((z:↥Z):G) * g⁻¹ * g := by group
      _ = ((z:↥Z):G) * g := by rw [h3]
  have hz1 : ((z:↥Z):G) ≠ 1 := fun hcon => hzne (Subtype.ext hcon.symm)
  have hHne : Z ⊓ Subgroup.center G ≠ ⊥ := by
    intro hbot
    have : ((z:↥Z):G) ∈ Z ⊓ Subgroup.center G := ⟨z.2, hzcent⟩
    rw [hbot, Subgroup.mem_bot] at this
    exact hz1 this
  have hHp : IsPGroup p ↥(Z ⊓ Subgroup.center G) := hV.to_le (le_trans inf_le_left hZle)
  haveI : Finite ↥(Z ⊓ Subgroup.center G) :=
    hfin.of_injective (Subgroup.inclusion (le_trans inf_le_left hZle))
      (Subgroup.inclusion_injective _)
  have hdvdp : p ∣ Nat.card ↥(Z ⊓ Subgroup.center G) := by
    have hntH : Nontrivial ↥(Z ⊓ Subgroup.center G) :=
      (Subgroup.nontrivial_iff_ne_bot _).mpr hHne
    obtain ⟨n, hn, hcard⟩ := (hHp.nontrivial_iff_card).mp hntH
    rw [hcard]
    exact dvd_pow_self p (Nat.pos_iff_ne_zero.mp hn)
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := ↥(Z ⊓ Subgroup.center G)) p hdvdp
  exact ⟨(w : G), hZle w.2.1, w.2.2, by rw [Subgroup.orderOf_coe, hw]⟩

/-! ## The engine -/

/-- **The engine (general form).**  If `V ⊴ G` is a finite `p`-group, `G ⧸ V` is a `p`-group and
`V ≤ V^p · [V,G]`, then `V = ⊥`.

This is the `S = ∅` case of `le_normalClosure_of_finite_pgroup_defect`; the proof is a strong
induction on `|V|`, quotienting by a central element of order `p` supplied by
`finitePgroupDefect_exists_central`. -/
theorem finitePgroupDefect_eq_bot_aux {p : ℕ} [Fact p.Prime] :
    ∀ n : ℕ, ∀ (G : Type*) [Group G] (V : Subgroup G) [V.Normal],
      Nat.card ↥V = n → Finite ↥V → IsPGroup p ↥V → IsPGroup p (G ⧸ V) →
        V ≤ pPower p V ⊔ ⁅V, ⊤⁆ → V = ⊥ := by
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih G _inst V _inst2 hcard hfin hV hquot h
  classical
  by_contra hVne
  obtain ⟨z, hzV, hzcent, hzord⟩ := finitePgroupDefect_exists_central hfin hV hVne hquot
  set C : Subgroup G := Subgroup.zpowers z with hCdef
  have hCcent : C ≤ Subgroup.center G := by
    rw [hCdef]; exact Subgroup.zpowers_le.mpr hzcent
  have hCnorm : C.Normal := Subgroup.normal_of_le_center hCcent
  have hCV : C ≤ V := by rw [hCdef]; exact Subgroup.zpowers_le.mpr hzV
  have hCcard : Nat.card ↥C = p := by rw [hCdef, Nat.card_zpowers, hzord]
  haveI : C.Normal := hCnorm
  set g : ↥V →* G ⧸ C := (QuotientGroup.mk' C).domRestrict V with hgdef
  have hgker : g.ker = C.subgroupOf V := by
    rw [hgdef, MonoidHom.ker_domRestrict, QuotientGroup.ker_mk']
  have hgrange : g.range = V.map (QuotientGroup.mk' C) := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact Subgroup.mem_map_of_mem _ x.2
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  haveI : Finite ↥g.range := hfin.of_surjective g.rangeRestrict g.rangeRestrict_surjective
  have hV' : IsPGroup p ↥g.range :=
    (hV.to_quotient g.ker).of_equiv (QuotientGroup.quotientKerEquivRange g)
  have hmapnorm : (V.map (QuotientGroup.mk' C)).Normal :=
    Subgroup.Normal.map inferInstance (QuotientGroup.mk' C) (QuotientGroup.mk'_surjective C)
  haveI : (V.map (QuotientGroup.mk' C)).Normal := hmapnorm
  have hRnorm : (g.range).Normal := by
    rw [hgrange]
    exact hmapnorm
  haveI : (g.range).Normal := hRnorm
  have hquot' : IsPGroup p ((G ⧸ C) ⧸ g.range) :=
    hquot.of_equiv ((QuotientGroup.quotientMulEquivOfEq hgrange).trans
      (QuotientGroup.quotientQuotientEquivQuotient C V hCV)).symm
  have h' : g.range ≤ pPower p g.range ⊔ ⁅g.range, ⊤⁆ := by
    rw [hgrange]
    have h1 : V.map (QuotientGroup.mk' C) ≤
        (pPower p V ⊔ ⁅V, ⊤⁆).map (QuotientGroup.mk' C) := Subgroup.map_mono h
    rw [Subgroup.map_sup] at h1
    refine le_trans h1 (sup_le_sup ?_ ?_)
    · rw [pPower, pPower, MonoidHom.map_closure]
      apply Subgroup.closure_mono
      rintro y ⟨x, ⟨k, hk, rfl⟩, rfl⟩
      exact ⟨(QuotientGroup.mk' C) k, Subgroup.mem_map_of_mem _ hk, by rw [map_pow]⟩
    · rw [Subgroup.map_commutator,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective C)]
  have hcard' : Nat.card ↥g.range < n := by
    have h1 : Nat.card ↥V = Nat.card ↥g.range * Nat.card ↥C := by
      have lag := Subgroup.card_eq_card_quotient_mul_card_subgroup g.ker
      rw [Nat.card_congr (QuotientGroup.quotientKerEquivRange g).toEquiv] at lag
      rw [hgker, Nat.card_congr (Subgroup.subgroupOfEquivOfLe hCV).toEquiv] at lag
      exact lag
    rw [hcard, hCcard] at h1
    have hpos : 0 < Nat.card ↥g.range := Nat.card_pos_iff.mpr ⟨⟨1⟩, inferInstance⟩
    calc Nat.card ↥g.range < Nat.card ↥g.range * p :=
          lt_mul_of_one_lt_right hpos (Fact.out : Nat.Prime p).one_lt
      _ = n := h1.symm
  have hbot : g.range = ⊥ :=
    ih (Nat.card ↥g.range) hcard' (G ⧸ C) g.range rfl (inferInstance : Finite ↥g.range) hV'
      hquot' h'
  have hVC : V ≤ C := by
    have hmap : V.map (QuotientGroup.mk' C) = ⊥ := by rw [← hgrange]; exact hbot
    rw [Subgroup.map_eq_bot_iff] at hmap
    rwa [QuotientGroup.ker_mk'] at hmap
  have hVC' : V = C := le_antisymm hVC hCV
  have hcomm0 : ⁅V, (⊤ : Subgroup G)⁆ = ⊥ := by
    rw [hVC']
    exact Subgroup.commutator_top_right_eq_bot_iff_le_center.mpr hCcent
  have hp0 : pPower p V = ⊥ := by
    rw [hVC', hCdef, pPower]
    refine le_bot_iff.mp ?_
    rw [Subgroup.closure_le]
    rintro x ⟨k, hk, rfl⟩
    refine Subgroup.mem_bot.mpr ?_
    have hdvd : orderOf k ∣ orderOf z := orderOf_dvd_of_mem_zpowers hk
    rw [hzord] at hdvd
    exact (orderOf_dvd_iff_pow_eq_one).mp hdvd
  have hVbot : V ≤ ⊥ := by
    calc V ≤ pPower p V ⊔ ⁅V, (⊤ : Subgroup G)⁆ := h
      _ = ⊥ := by rw [hp0, hcomm0, sup_bot_eq]
  exact hVne (le_bot_iff.mp hVbot)

/-- **The engine.**  If `V ⊴ G` is a finite `p`-group, `G ⧸ V` is a `p`-group and
`V ≤ V^p · [V,G]`, then `V = ⊥`. -/
theorem finitePgroupDefect_eq_bot {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    {V : Subgroup G} [V.Normal] (hfin : Finite ↥V) (hV : IsPGroup p ↥V)
    (hquot : IsPGroup p (G ⧸ V)) (h : V ≤ pPower p V ⊔ ⁅V, ⊤⁆) : V = ⊥ :=
  finitePgroupDefect_eq_bot_aux (Nat.card ↥V) G V rfl hfin hV hquot h

/-- **The requested lemma.**  Let `K ⊴ F`, let `S ⊆ K` be a finite set, and suppose that

* `K` is generated by the normal closure of `S` modulo the relation-Frattini subgroup
  `K^p [K,F]`;
* the quotient `F ⧸ K` is a `p`-group;
* the defect `K ⧸ ⟨S⟩^F` is a finite `p`-group.

Then `S` already normally generates `K`. -/
theorem le_normalClosure_of_finite_pgroup_defect {F : Type*} [Group F] {p : ℕ} [Fact p.Prime]
    {K : Subgroup F} [K.Normal] {S : Finset F} (hS : (S : Set F) ⊆ K)
    (hquot : IsPGroup p (F ⧸ K))
    (h : K ≤ Subgroup.normalClosure (S : Set F) ⊔ relFrattini p K)
    (hfin : Finite (K ⧸ (Subgroup.normalClosure (S : Set F)).subgroupOf K))
    (hdef : IsPGroup p (K ⧸ (Subgroup.normalClosure (S : Set F)).subgroupOf K)) :
    K ≤ Subgroup.normalClosure (S : Set F) := by
  classical
  set N : Subgroup F := Subgroup.normalClosure (S : Set F) with hNdef
  have hNK : N ≤ K := Subgroup.normalClosure_le_normal hS
  haveI : N.Normal := Subgroup.normalClosure_normal
  set g : ↥K →* F ⧸ N := (QuotientGroup.mk' N).domRestrict K with hgdef
  have hgker : g.ker = N.subgroupOf K := by
    rw [hgdef, MonoidHom.ker_domRestrict, QuotientGroup.ker_mk']
  have hgrange : g.range = K.map (QuotientGroup.mk' N) := by
    ext y
    constructor
    · rintro ⟨x, rfl⟩
      exact Subgroup.mem_map_of_mem _ x.2
    · rintro ⟨x, hx, rfl⟩
      exact ⟨⟨x, hx⟩, rfl⟩
  -- the defect `K ⧸ ⟨S⟩^F` is a finite `p`-group
  haveI : (g.ker).Normal := MonoidHom.normal_ker g
  haveI : (N.subgroupOf K).Normal := inferInstance
  have hiso : ↥K ⧸ N.subgroupOf K ≃* ↥g.range :=
    (QuotientGroup.quotientMulEquivOfEq hgker).symm.trans (QuotientGroup.quotientKerEquivRange g)
  haveI : Finite (↥K ⧸ N.subgroupOf K) := hfin
  have hfinrange : Finite ↥g.range := Finite.of_equiv _ hiso.toEquiv
  have hprange : IsPGroup p ↥g.range := hdef.of_equiv hiso
  -- the ambient quotient `F ⧸ ⟨S⟩^F ⧸ (K ⧸ ⟨S⟩^F) ≅ F ⧸ K` is a `p`-group
  have hmapnorm : (K.map (QuotientGroup.mk' N)).Normal :=
    Subgroup.Normal.map inferInstance (QuotientGroup.mk' N) (QuotientGroup.mk'_surjective N)
  haveI : (K.map (QuotientGroup.mk' N)).Normal := hmapnorm
  have hRnorm : (g.range).Normal := by rw [hgrange]; exact hmapnorm
  haveI : (g.range).Normal := hRnorm
  have hquot' : IsPGroup p ((F ⧸ N) ⧸ g.range) :=
    hquot.of_equiv ((QuotientGroup.quotientMulEquivOfEq hgrange).trans
      (QuotientGroup.quotientQuotientEquivQuotient N K hNK)).symm
  -- the relation-Frattini condition descends to the defect
  have h' : g.range ≤ pPower p g.range ⊔ ⁅g.range, ⊤⁆ := by
    rw [hgrange]
    have h1 : K.map (QuotientGroup.mk' N) ≤
        (N ⊔ relFrattini p K).map (QuotientGroup.mk' N) := Subgroup.map_mono h
    rw [Subgroup.map_sup, relFrattini, Subgroup.map_sup] at h1
    have h2 : N.map (QuotientGroup.mk' N) = ⊥ := by
      rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk']
    rw [h2, bot_sup_eq] at h1
    refine le_trans h1 (sup_le_sup ?_ ?_)
    · rw [pPower, pPower, MonoidHom.map_closure]
      apply Subgroup.closure_mono
      rintro y ⟨x, ⟨k, hk, rfl⟩, rfl⟩
      exact ⟨(QuotientGroup.mk' N) k, Subgroup.mem_map_of_mem _ hk, by rw [map_pow]⟩
    · rw [Subgroup.map_commutator,
        Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N)]
  -- the engine
  have hbot : g.range = ⊥ := finitePgroupDefect_eq_bot hfinrange hprange hquot' h'
  rw [hgrange] at hbot
  rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hbot
  exact hbot

end Work.HopfGaschutz
