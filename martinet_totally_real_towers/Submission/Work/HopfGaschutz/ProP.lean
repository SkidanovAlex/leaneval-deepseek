import Mathlib
import Submission.Work.HopfGaschutz.Defs

/-!
# `Work.HopfGaschutz.ProP` -- the closed (pro-`p`) normalisation of the relation-Frattini subgroup

**Namespace** `Work.HopfGaschutz`; module `Submission.Work.HopfGaschutz.ProP`.

The finite part of this chapter works with the *discrete* relation-Frattini subgroup
`relFrattini p K = K^p[K,F]` of a normal subgroup `K` of a group `F` (`Defs.lean`).  In a
topological group the corresponding object has to be *closed*: for a closed normal subgroup
`R ≤ Γ` the closed normal closure of a finite set `S` is an intersection of open subgroups, so the
statement "`R = ⟪S⟫^Γ`" is a limit of its finite-quotient shadows, and the input to the limit is the
closed subgroup

`relFrattiniClosed p R = closure (⟪{r^p : r ∈ R} ∪ {⁅r,g⁆ : r ∈ R, g ∈ Γ}⟫)`,

the closure of `R^p[R,Γ]`.  This module defines it and records the two elementary membership
lemmas; the *engine* that turns a spanning statement modulo `relFrattiniClosed` into a
topological-normal-generation statement is `closed_engine` (this directory).
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped commutatorElement

namespace Work.HopfGaschutz

variable {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]

/-- **The closed relation-Frattini subgroup** `R^p[R,Γ]` of a subgroup `R ≤ Γ`: the topological
closure of the subgroup generated by the `p`-th powers of elements of `R` and the commutators
`⁅r,g⁆` with `r ∈ R`, `g ∈ Γ`. -/
def relFrattiniClosed (p : ℕ) (R : Subgroup Γ) : Subgroup Γ :=
  (Subgroup.closure ({x : Γ | ∃ r ∈ R, r ^ p = x} ∪ {x : Γ | ∃ r ∈ R, ∃ g : Γ, ⁅r, g⁆ = x})).topologicalClosure

@[simp] lemma mem_relFrattiniClosed_iff (p : ℕ) (R : Subgroup Γ) {x : Γ} :
    x ∈ relFrattiniClosed p R ↔
      x ∈ (Subgroup.closure ({y : Γ | ∃ r ∈ R, r ^ p = y} ∪
        {y : Γ | ∃ r ∈ R, ∃ g : Γ, ⁅r, g⁆ = y})).topologicalClosure := Iff.rfl

/-- The `p`-th powers of elements of `R` lie in the closed relation-Frattini subgroup. -/
lemma pow_mem_relFrattiniClosed (p : ℕ) (R : Subgroup Γ) {r : Γ} (hr : r ∈ R) :
    r ^ p ∈ relFrattiniClosed p R :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Or.inl ⟨r, hr, rfl⟩))

/-- The commutators `⁅r,g⁆` with `r ∈ R` lie in the closed relation-Frattini subgroup. -/
lemma commutator_mem_relFrattiniClosed (p : ℕ) (R : Subgroup Γ) {r g : Γ} (hr : r ∈ R) :
    ⁅r, g⁆ ∈ relFrattiniClosed p R :=
  Subgroup.le_topologicalClosure _ (Subgroup.subset_closure (Or.inr ⟨r, hr, g, rfl⟩))

end Work.HopfGaschutz
