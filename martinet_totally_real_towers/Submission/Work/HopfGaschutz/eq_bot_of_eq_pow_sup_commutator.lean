import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Commons.GroupTheory.PGroup.pow_mem_frattini
import Submission.Work.RelatorRank.Gaschutz.eq_of_normalClosure_sup_frattini_eq_top

/-!
# Nakayama for the relation-Frattini subgroup: `K = K^p[K,F] → K = 1`

This is the `S = ∅` case of the *engine* of `Work.HopfGaschutz.Defs`: for a finite `p`-group `G`
and a normal subgroup `M ⊴ G`, the equality `M = M^p · [M,G]` forces `M = 1`.

Classically (Koch, *Galois theory of `p`-extensions*, Ch. 11; Neukirch--Schmidt--Wingberg I §4.3),
this is the Nakayama lemma for the `𝔽_p[G]`-module `M/Φ(M)`: the hypothesis says
`M/Φ(M) = [M/Φ(M), G]`, i.e. the augmentation ideal of `𝔽_p[G]` acts surjectively, and a nonzero
module over the completed group algebra of a pro-`p` group has no such property.  The proof below
avoids modules entirely and proceeds by strong induction on `|G|`:

* `M ⊓ Z(G) ≠ 1` — a nontrivial normal subgroup of a `p`-group meets the centre (Mathlib's
  orbit-counting `IsPGroup.exists_fixed_point_of_prime_dvd_card_of_fixed_point` for the conjugation
  action of `ConjAct G` on `↥M`);
* if `M ⊓ Z(G) = M` then `[M,G] = 1`, so `M = M^p`; every `p`-th power lies in the Frattini
  subgroup of the group `↥M` (`Commons.GroupTheory.PGroup.pow_mem_frattini`), so `M ≤ Φ(M)`, and
  Gaschütz's non-generator property forces `M = 1`;
* if `M ⊓ Z(G) < M` the same statement in the smaller `p`-group `G ⧸ (M ⊓ Z(G))` gives the result
  by the induction hypothesis.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

variable {G : Type*} [Group G] [Fintype G]

/-! ## `p`-th powers lie in the Frattini subgroup -/

/-- Every `p`-th power of an element of a subgroup `M` lies in the Frattini subgroup of the group
`↥M`, viewed as a subgroup of `G` through `M.subtype`. -/
theorem pPower_le_map_frattini {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G) (M : Subgroup G) :
    pPower p M ≤ Subgroup.map M.subtype (frattini M) := by
  rw [pPower, Subgroup.closure_le]
  rintro x ⟨k, hk, rfl⟩
  refine Subgroup.mem_map.mpr ⟨⟨k ^ p, M.pow_mem hk p⟩, ?_, rfl⟩
  simpa using
    (Commons.GroupTheory.PGroup.pow_mem_frattini (p := p) (hG.to_subgroup M) (⟨k, hk⟩ : M))

/-- **The central case.**  If `M ⊴ G` is contained in the centre of `G` and `M = M^p[M,G]`, then
`M = 1`: the commutator subgroup vanishes, so `M` is generated by its `p`-th powers, hence
`M ≤ Φ(M)`, and a finitely generated group is not generated by its Frattini subgroup. -/
theorem eq_bot_of_le_center {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G) {M : Subgroup G}
    [M.Normal] (hcenter : M ≤ Subgroup.center G) (h : M = pPower p M ⊔ ⁅M, ⊤⁆) : M = ⊥ := by
  have hcomm : ⁅M, (⊤ : Subgroup G)⁆ = ⊥ := by
    refine bot_unique ?_
    rw [Subgroup.commutator_le]
    intro a ha b _
    rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
    exact (Subgroup.mem_center_iff.mp (hcenter ha) b).symm
  have hM : M = pPower p M := by
    conv_lhs => rw [h]
    rw [hcomm, sup_bot_eq]
  have hle : ⊥ ⊔ Subgroup.map M.subtype (frattini M) = M := by
    rw [bot_sup_eq]
    exact le_antisymm (Subgroup.map_subtype_le _)
      (hM.le.trans (pPower_le_map_frattini hG M))
  exact (Work.RelatorRank.Gaschutz.eq_of_normalClosure_sup_frattini_eq_top (F := G) M ⊥
    bot_le hle).symm

/-! ## A nontrivial normal subgroup of a `p`-group meets the centre -/

/-- A nontrivial normal subgroup of a finite `p`-group has nontrivial intersection with the
centre: the conjugation action of `G` on `M` is an action of a `p`-group, so the number of fixed
points is congruent to `|M|` modulo `p`, and `|M|` is divisible by `p`. -/
theorem inf_center_ne_bot {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G) {M : Subgroup G} [M.Normal]
    (hM : M ≠ ⊥) : M ⊓ Subgroup.center G ≠ ⊥ := by
  haveI hpc : IsPGroup p (ConjAct G) := hG.of_equiv ConjAct.toConjAct
  haveI hnt : Nontrivial ↥M := (Subgroup.nontrivial_iff_ne_bot M).mpr hM
  obtain ⟨n, hnpos, hn⟩ := (IsPGroup.nontrivial_iff_card (hG.to_subgroup M)).mp hnt
  have hdvd : p ∣ Nat.card ↥M := by
    rw [hn]
    exact dvd_pow_self p (Nat.pos_iff_ne_zero.mp hnpos)
  obtain ⟨b, hb, hbne⟩ :=
    IsPGroup.exists_fixed_point_of_prime_dvd_card_of_fixed_point hpc ↥M hdvd
      (a := (⟨1, M.one_mem⟩ : ↥M))
      (by rw [MulAction.mem_fixedPoints]; intro x; exact MulDistribMulAction.smul_one x)
  -- `b` is fixed by conjugation, i.e. it is central in `G`
  have hfix : ∀ g : G, g * (b : G) * g⁻¹ = (b : G) := by
    intro g
    have h1 : (ConjAct.toConjAct g) • b = b := (MulAction.mem_fixedPoints.mp hb) _
    have h2 : ((ConjAct.toConjAct g) • b : G) = (b : G) := congrArg Subtype.val h1
    rwa [ConjAct.toConjAct_smul_eq_mulAut_conj, MulAut.conj_apply] at h2
  have hcent : (b : G) ∈ Subgroup.center G := by
    rw [Subgroup.mem_center_iff]
    intro g
    have h2 : g * (b : G) * g⁻¹ * g = (b : G) * g := by rw [hfix g]
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using h2
  intro hcon
  have hmem : (b : G) ∈ M ⊓ Subgroup.center G := Subgroup.mem_inf.mpr ⟨b.2, hcent⟩
  rw [hcon, Subgroup.mem_bot] at hmem
  exact hbne (Subtype.ext hmem.symm)

/-! ## The induction on `|G|` -/

/-- Strong induction on the cardinality of the ambient `p`-group. -/
private theorem eq_bot_aux :
    ∀ n : ℕ, ∀ (G : Type*) [Group G] [Fintype G] (p : ℕ) [Fact p.Prime],
      Nat.card G = n → ∀ (hG : IsPGroup p G) (M : Subgroup G) [M.Normal],
        M = pPower p M ⊔ ⁅M, ⊤⁆ → M = ⊥ := by
  intro n
  refine Nat.strong_induction_on n ?_
  · intro n ih G _ _ p _ hcard hG M _ h
    classical
    by_contra hMne
    have hNne : M ⊓ Subgroup.center G ≠ ⊥ := inf_center_ne_bot hG hMne
    by_cases hNM : M ⊓ Subgroup.center G = M
    · -- `M` is central
      have hcenter : M ≤ Subgroup.center G :=
        fun x hx => (Subgroup.mem_inf.mp (hNM.symm ▸ hx)).2
      exact hMne (eq_bot_of_le_center hG hcenter h)
    · -- pass to the quotient by `M ⊓ Z(G)`
      set N : Subgroup G := M ⊓ Subgroup.center G with hNdef
      have hNnorm : N.Normal := by
        rw [hNdef]; exact Subgroup.normal_of_le_center inf_le_right
      letI : N.Normal := hNnorm
      have hNle : N ≤ M := by rw [hNdef]; exact inf_le_left
      -- the quotient is strictly smaller
      have hlt : Nat.card (G ⧸ N) < n := by
        have h1 : Nat.card G = Nat.card (G ⧸ N) * Nat.card ↥N :=
          Subgroup.card_eq_card_quotient_mul_card_subgroup N
        have h2 : 1 < Nat.card ↥N := (Subgroup.one_lt_card_iff_ne_bot N).mpr hNne
        have h3 : 0 < Nat.card (G ⧸ N) :=
          Nat.card_pos_iff.mpr ⟨⟨1⟩, inferInstance⟩
        have h4 : Nat.card (G ⧸ N) < Nat.card G := by
          rw [h1]
          calc Nat.card (G ⧸ N) = Nat.card (G ⧸ N) * 1 := (Nat.mul_one _).symm
            _ < Nat.card (G ⧸ N) * Nat.card ↥N := Nat.mul_lt_mul_of_pos_left h2 h3
        omega
      -- the hypothesis descends to the quotient
      have hset : (QuotientGroup.mk' N) '' {x : G | ∃ k ∈ M, k ^ p = x}
          = {x : G ⧸ N | ∃ k ∈ Subgroup.map (QuotientGroup.mk' N) M, k ^ p = x} := by
        ext y
        constructor
        · rintro ⟨x, ⟨k, hk, rfl⟩, rfl⟩
          exact ⟨(QuotientGroup.mk' N) k, Subgroup.mem_map.mpr ⟨k, hk, rfl⟩, by rw [map_pow]⟩
        · rintro ⟨k, hk, rfl⟩
          obtain ⟨m, hm, rfl⟩ := Subgroup.mem_map.mp hk
          exact ⟨m ^ p, ⟨m, hm, rfl⟩, by rw [map_pow]⟩
      have hdesc : Subgroup.map (QuotientGroup.mk' N) M
          = pPower p (Subgroup.map (QuotientGroup.mk' N) M)
            ⊔ ⁅Subgroup.map (QuotientGroup.mk' N) M, ⊤⁆ := by
        conv_lhs => rw [h]
        rw [Subgroup.map_sup, Subgroup.map_commutator,
          Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective N),
          pPower, pPower, MonoidHom.map_closure, hset]
      haveI : Fintype (G ⧸ N) := Fintype.ofFinite _
      have hMnorm : (Subgroup.map (QuotientGroup.mk' N) M).Normal :=
        (inferInstance : M.Normal).map _ (QuotientGroup.mk'_surjective N)
      letI : (Subgroup.map (QuotientGroup.mk' N) M).Normal := hMnorm
      have hih : Subgroup.map (QuotientGroup.mk' N) M = ⊥ :=
        ih (Nat.card (G ⧸ N)) hlt (G ⧸ N) p rfl (hG.to_quotient N)
          (Subgroup.map (QuotientGroup.mk' N) M) hdesc
      have hMle : M ≤ N := by
        rw [Subgroup.map_eq_bot_iff] at hih
        rwa [QuotientGroup.ker_mk'] at hih
      have hcenter : M ≤ Subgroup.center G :=
        le_trans hMle (by rw [hNdef]; exact inf_le_right)
      exact hMne (eq_bot_of_le_center hG hcenter h)

/-- **Nakayama for the relation-Frattini subgroup.**  A normal subgroup `M` of a finite `p`-group
`G` with `M = M^p · [M,G]` is trivial. -/
theorem eq_bot_of_eq_pow_sup_commutator {G : Type*} [Group G] [Fintype G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) {M : Subgroup G} [M.Normal]
    (h : M = pPower p M ⊔ ⁅M, ⊤⁆) : M = ⊥ :=
  eq_bot_aux (Nat.card G) G p rfl hG M h

end Work.HopfGaschutz
