import Mathlib
import Submission.Work.HopfGaschutz.Defs
import Submission.Work.HopfGaschutz.normalClosure_eq_sup_commutator

/-!
# The normal generator number of a normal subgroup of a finite `p`-group

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.normalGeneratorNumber_eq_relFrattiniDim_of_finite_pgroup`.

This file proves Gaschütz's theorem in its finite-`p`-group form: for a finite `p`-group `G` and a
normal subgroup `K ⊴ G`, the minimal number of elements of `K` whose *normal closure* in `G` is `K`
equals the `𝔽_p`-dimension of the relation-Frattini quotient `K ⧸ K^p[K,G]`:

  `normalGeneratorNumber K = relFrattiniDim p K`.

The mathematical content is the classical one (Gaschütz 1953; Neukirch--Schmidt--Wingberg I §4.3;
Koch, *Galois theory of `p`-extensions*, Ch. 11):

* a finite abelian group of exponent `p` is generated by `log_p |H|` elements and is not generated
  by fewer (`rank_eq_log_card_of_abelian_exp_p`), so the group-theoretic invariant
  `Group.rank` of the elementary abelian quotient `K ⧸ K^p[K,G]` is `relFrattiniDim p K`;
* a subset of `K` normally generates `K` if and only if its image generates `K ⧸ K^p[K,G]`
  (`closure_image_eq_top_iff`), the non-trivial direction being the Burnside/Gaschütz
  non-generator property (`le_of_le_sup_relFrattini_aux`), whose engine is the classical
  Nakayama statement `M = M^p[M,G] → M = ⊥` for a normal subgroup of a finite `p`-group
  (`nakayama_pgroup_aux`).

The formalisation is deliberately phrased with an *abstract* elementary abelian quotient
`ψ : K →* V` with `ker ψ = K^p[K,G]`, which keeps the quotient construction itself out of the
proofs; it is instantiated once, in the final theorem.
-/

set_option maxHeartbeats 2000000
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace Work.HopfGaschutz

open scoped commutatorElement

/-! ## Images of `pPower` and `relFrattini` -/

theorem pPower_map_aux {F N : Type*} [Group F] [Group N] (p : ℕ) (H : Subgroup F) (f : F →* N) :
    pPower p (H.map f) = (pPower p H).map f := by
  have hset : f '' {x : F | ∃ k ∈ H, k ^ p = x} = {y : N | ∃ m ∈ H.map f, m ^ p = y} := by
    ext y
    constructor
    · rintro ⟨x, ⟨k, hk, rfl⟩, rfl⟩
      exact ⟨f k, Subgroup.mem_map_of_mem f hk, by rw [map_pow]⟩
    · rintro ⟨m, hm, rfl⟩
      obtain ⟨k, hk, rfl⟩ := hm
      exact ⟨k ^ p, ⟨k, hk, rfl⟩, by rw [map_pow]⟩
  rw [pPower, pPower, MonoidHom.map_closure, hset]

theorem relFrattini_map_aux {F N : Type*} [Group F] [Group N] (p : ℕ) (H : Subgroup F) (f : F →* N)
    (hf : Function.Surjective f) :
    relFrattini p (H.map f) = (relFrattini p H).map f := by
  have h2 : (relFrattini p H).map f = (pPower p H).map f ⊔ (⁅H, (⊤ : Subgroup F)⁆).map f := by
    rw [relFrattini, Subgroup.map_sup]
  rw [relFrattini, h2, ← pPower_map_aux, Subgroup.map_commutator,
    Subgroup.map_top_of_surjective f hf]

/-! ## Two general lemmas on subgroups -/

/-- If the image of a subgroup generates the target, then the subgroup together with the kernel of
the map is everything. -/
theorem sup_ker_eq_top_of_map_eq_top {A B : Type*} [Group A] [Group B] (f : A →* B)
    {M : Subgroup A} (h : M.map f = ⊤) : M ⊔ f.ker = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  have hx : f x ∈ M.map f := by rw [h]; exact Subgroup.mem_top (f x)
  rw [Subgroup.mem_map] at hx
  obtain ⟨y, hy, hyx⟩ := hx
  have hker : y⁻¹ * x ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hyx, inv_mul_cancel]
  have hx2 : x = y * (y⁻¹ * x) := by group
  rw [hx2]
  exact Subgroup.mul_mem_sup hy hker

/-- If `a` lies in the closure of `s`, the closure does not change when `a` is added to the
generating set. -/
theorem closure_insert_eq_of_mem {A : Type*} [Group A] {s : Set A} {a : A}
    (ha : a ∈ Subgroup.closure s) : Subgroup.closure (insert a s) = Subgroup.closure s := by
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    intro y hy
    rcases Set.mem_insert_iff.mp hy with rfl | hy
    · exact ha
    · exact Subgroup.subset_closure hy
  · exact Subgroup.closure_mono (Set.subset_insert _ _)

/-- The closure of `s` computed inside a subgroup `K ≤ G` agrees with the closure in `G`, pulled
back to `K`. -/
theorem subgroupOf_closure_eq_closure_aux {G : Type*} [Group G] {K : Subgroup G} {s : Set G}
    (hs : s ⊆ K) :
    (Subgroup.closure s).subgroupOf K = Subgroup.closure (K.subtype ⁻¹' s) := by
  rw [← Subgroup.map_subtype_inj (H := K)]
  rw [Subgroup.subgroupOf_map_subtype, MonoidHom.map_closure]
  have h1 : Subgroup.closure s ⊓ K = Subgroup.closure s :=
    inf_eq_left.mpr ((Subgroup.closure_le K).mpr hs)
  have h2 : K.subtype '' (K.subtype ⁻¹' s) = s := by
    ext y
    constructor
    · rintro ⟨x, hx, rfl⟩; exact hx
    · intro hy; exact ⟨⟨y, hs hy⟩, hy, rfl⟩
  rw [h1, h2]

/-- `A.subgroupOf K ⊔ B.subgroupOf K = ⊤` as soon as `K ≤ A ⊔ B` and `A, B ≤ K`. -/
theorem subgroupOf_sup_eq_top_aux {G : Type*} [Group G] {K A B : Subgroup G} (hA : A ≤ K)
    (hB : B ≤ K) (h : K ≤ A ⊔ B) : A.subgroupOf K ⊔ B.subgroupOf K = ⊤ := by
  rw [← Subgroup.map_subtype_inj (H := K)]
  rw [Subgroup.map_sup, Subgroup.subgroupOf_map_subtype, Subgroup.subgroupOf_map_subtype,
    inf_eq_left.mpr hA, inf_eq_left.mpr hB, Subgroup.map_top, Subgroup.range_subtype]
  exact le_antisymm (sup_le hA hB) h

/-! ## The Nakayama engine for finite `p`-groups -/

/-- **Nakayama's lemma for normal subgroups of finite `p`-groups.**  If a normal subgroup `M` of a
finite `p`-group `G` satisfies `M = M^p[M,G]`, then `M = ⊥`. -/
theorem nakayama_key : ∀ k, ∀ {G : Type*} [Group G] [Fintype G] {p : ℕ} [Fact p.Prime]
      (hG : IsPGroup p G), Nat.card G = k → ∀ (M : Subgroup G) (hM : M.Normal),
      M = pPower p M ⊔ ⁅M, (⊤ : Subgroup G)⁆ → M = ⊥ := by
    classical
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro G _ _ p _ hG hcard M hMnorm hrel
      by_contra hne
      haveI : M.Normal := hMnorm
      have hp2 : 1 < p := (Fact.out (p := p.Prime)).one_lt
      have hnil : Group.IsNilpotent G := hG.isNilpotent
      have hNne : M ⊓ Subgroup.center G ≠ ⊥ := hnil.inf_center_ne_bot_of_normal hne
      haveI hnt : Nontrivial ↥(M ⊓ Subgroup.center G) := by
        obtain ⟨w, hw⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hNne
        exact ⟨w, 1, hw⟩
      have hp_dvd : p ∣ Nat.card ↥(M ⊓ Subgroup.center G) := by
        have hp : IsPGroup p ↥(M ⊓ Subgroup.center G) := (hG.to_subgroup M).to_le inf_le_left
        rcases hp.card_eq_or_dvd with h1 | h1
        · have hlt : 1 < Nat.card ↥(M ⊓ Subgroup.center G) := Finite.one_lt_card
          omega
        · exact h1
      obtain ⟨w, hwp⟩ := exists_prime_orderOf_dvd_card' p hp_dvd
      have hxM : (w : G) ∈ M := w.2.1
      have hxC : (w : G) ∈ Subgroup.center G := w.2.2
      have hxp : orderOf (w : G) = p := by
        rw [Subgroup.orderOf_coe]; exact hwp
      set W : Subgroup G := Subgroup.zpowers (w : G) with hWdef
      have hWle : W ≤ M := by rw [hWdef]; exact Subgroup.zpowers_le.mpr hxM
      have hWc : W ≤ Subgroup.center G := by rw [hWdef]; exact Subgroup.zpowers_le.mpr hxC
      haveI : W.Normal := Subgroup.normal_of_le_center hWc
      have hWcard : Nat.card ↥W = p := by
        rw [hWdef, Nat.card_eq_fintype_card, Fintype.card_zpowers, hxp]
      set M' : Subgroup (G ⧸ W) := M.map (QuotientGroup.mk' W) with hM'def
      haveI : M'.Normal := by rw [hM'def]; infer_instance
      have hG' : IsPGroup p (G ⧸ W) := hG.to_quotient W
      have hrel' : M' = pPower p M' ⊔ ⁅M', (⊤ : Subgroup (G ⧸ W))⁆ := by
        have h3 : M = relFrattini p M := hrel
        rw [hM'def]
        calc M.map (QuotientGroup.mk' W)
            = (relFrattini p M).map (QuotientGroup.mk' W) := by rw [← h3]
          _ = relFrattini p (M.map (QuotientGroup.mk' W)) :=
                (relFrattini_map_aux p M _ (QuotientGroup.mk'_surjective W)).symm
          _ = pPower p (M.map (QuotientGroup.mk' W))
                ⊔ ⁅M.map (QuotientGroup.mk' W), (⊤ : Subgroup (G ⧸ W))⁆ := rfl
      have hcardlt : Nat.card (G ⧸ W) < Nat.card G := by
        have h := Subgroup.card_eq_card_quotient_mul_card_subgroup (α := G) W
        rw [hWcard] at h
        calc Nat.card (G ⧸ W) < Nat.card (G ⧸ W) * p :=
              (Nat.lt_mul_iff_one_lt_right Nat.card_pos).mpr hp2
          _ = Nat.card G := h.symm
      have hcardlt' : Nat.card (G ⧸ W) < k := hcard ▸ hcardlt
      have hM'bot : M' = ⊥ := ih (Nat.card (G ⧸ W)) hcardlt' hG' rfl M' ‹M'.Normal› hrel'
      have hle : M ≤ W := by
        rw [hM'def] at hM'bot
        rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hM'bot
        exact hM'bot
      have hMW : M = W := le_antisymm hle hWle
      have hMcard : Nat.card ↥M = p := by rw [hMW]; exact hWcard
      have hMpow : pPower p M = ⊥ := by
        rw [Subgroup.eq_bot_iff_forall]
        intro y hy
        refine Subgroup.closure_induction (p := fun z _ => z = 1) ?_ ?_ ?_ ?_ hy
        · intro z hz
          obtain ⟨kk, hk, rfl⟩ := hz
          have hkp : (⟨kk, hk⟩ : M) ^ p = 1 := by
            rw [← hMcard, Nat.card_eq_fintype_card]
            exact pow_card_eq_one
          simpa using congrArg Subtype.val hkp
        · rfl
        · intro a b _ _ ha hb
          rw [ha, hb, one_mul]
        · intro a _ ha
          rw [ha, inv_one]
      have hMcomm : ⁅M, (⊤ : Subgroup G)⁆ = ⊥ := by
        rw [Subgroup.commutator_top_right_eq_bot_iff_le_center, hMW]
        exact hWc
      exact hne (by rw [hrel, hMpow, hMcomm, bot_sup_eq])

theorem nakayama_pgroup_aux {G : Type*} [Group G] [Fintype G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) {M : Subgroup G} [M.Normal]
    (h : M = pPower p M ⊔ ⁅M, (⊤ : Subgroup G)⁆) : M = ⊥ :=
  nakayama_key (Nat.card G) hG rfl M ‹M.Normal› h

/-! ## The Burnside--Gaschütz non-generator property -/

/-- **Gaschütz's non-generator property, relative form.**  If a normal subgroup `L ≤ K` of a finite
`p`-group `G` together with `K^p[K,G]` generates `K`, then `L = K`. -/
theorem le_of_le_sup_relFrattini_aux {G : Type*} [Group G] [Fintype G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) {K L : Subgroup G} (hKn : K.Normal) (hLn : L.Normal) (hLK : L ≤ K)
    (h : K ≤ L ⊔ relFrattini p K) : K ≤ L := by
  classical
  haveI : K.Normal := hKn
  haveI : L.Normal := hLn
  have hLbot : L.map (QuotientGroup.mk' L) = ⊥ :=
    (Subgroup.map_eq_bot_iff L).mpr (le_of_eq (QuotientGroup.ker_mk' L).symm)
  have h1 : K.map (QuotientGroup.mk' L) ≤ relFrattini p (K.map (QuotientGroup.mk' L)) := by
    have hmap : K.map (QuotientGroup.mk' L) ≤ (L ⊔ relFrattini p K).map (QuotientGroup.mk' L) :=
      Subgroup.map_mono h
    rw [Subgroup.map_sup, hLbot, bot_sup_eq] at hmap
    have h2 : (relFrattini p K).map (QuotientGroup.mk' L)
        = relFrattini p (K.map (QuotientGroup.mk' L)) :=
      (relFrattini_map_aux p K _ (QuotientGroup.mk'_surjective L)).symm
    rwa [h2] at hmap
  have h3 : K.map (QuotientGroup.mk' L)
      = relFrattini p (K.map (QuotientGroup.mk' L)) :=
    le_antisymm h1 (relFrattini_le p _)
  have hbot : K.map (QuotientGroup.mk' L) = ⊥ := nakayama_pgroup_aux (hG.to_quotient L) h3
  rw [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at hbot
  exact hbot

/-! ## The group-theoretic rank of a finite abelian group of exponent `p` -/

/-- **The rank of a finite abelian group of exponent `p` is at most `log_p` of its order.** -/
theorem rank_le_log_card_aux {p : ℕ} [Fact p.Prime] :
    ∀ n : ℕ, ∀ {H : Type*} [Group H] [Fintype H],
      (∀ a b : H, a * b = b * a) → (∀ a : H, a ^ p = 1) →
      Nat.card H = n → Group.rank H ≤ Nat.log p (Nat.card H) := by
  classical
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro H _ _ hcomm hp hcard
    by_cases h1 : Nat.card H = 1
    · haveI : Subsingleton H := (Finite.card_le_one_iff_subsingleton).mp (le_of_eq h1)
      rw [Group.rank_eq_zero, h1]
      simp
    · haveI : Nontrivial H := by
        rw [← Finite.one_lt_card_iff_nontrivial]
        have h0 : 0 < Nat.card H := Nat.card_pos
        omega
      obtain ⟨x, hx⟩ : ∃ x : H, x ≠ 1 := exists_ne 1
      have hxp : orderOf x = p := by
        have hpx : orderOf x ∣ p := orderOf_dvd_iff_pow_eq_one.mpr (hp x)
        rcases (Fact.out (p := p.Prime)).eq_one_or_self_of_dvd (orderOf x) hpx with h | h
        · exact absurd (orderOf_eq_one_iff.mp h) hx
        · exact h
      set W : Subgroup H := Subgroup.zpowers x with hWdef
      have hWcard : Nat.card ↥W = p := by
        rw [hWdef, Nat.card_eq_fintype_card, Fintype.card_zpowers, hxp]
      haveI : W.Normal := ⟨fun w hw g => by
        rw [hWdef] at hw ⊢
        obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hw
        rw [hcomm g (x ^ k), mul_assoc, mul_inv_cancel, mul_one]
        exact Subgroup.mem_zpowers_iff.mpr ⟨k, rfl⟩⟩
      have hp2 : 1 < p := (Fact.out (p := p.Prime)).one_lt
      have hHsplit : Nat.card H = Nat.card (H ⧸ W) * p := by
        have h := Subgroup.card_eq_card_quotient_mul_card_subgroup (α := H) W
        rwa [hWcard] at h
      have hcardp : ∃ k, Nat.card H = p ^ k := by
        refine IsPGroup.iff_card.mp ?_
        intro g
        exact ⟨1, by rw [pow_one, hp g]⟩
      obtain ⟨k, hk⟩ := hcardp
      have hkpos : 0 < k := by
        rcases Nat.eq_zero_or_pos k with h | h
        · rw [h, pow_zero] at hk; exact absurd hk h1
        · exact h
      have hqcard : Nat.card (H ⧸ W) = p ^ (k - 1) := by
        have h : p ^ k = Nat.card (H ⧸ W) * p := by rw [← hk]; exact hHsplit
        have hk1 : k = (k - 1) + 1 := (Nat.succ_pred_eq_of_pos hkpos).symm
        rw [hk1, pow_succ] at h
        exact (Nat.mul_right_cancel (by positivity : 0 < p) h).symm
      have hqlt : Nat.card (H ⧸ W) < n := by
        have hpos : 0 < Nat.card (H ⧸ W) := Nat.card_pos
        have hlt : Nat.card (H ⧸ W) < Nat.card (H ⧸ W) * p :=
          (Nat.lt_mul_iff_one_lt_right hpos).mpr hp2
        have h2 : Nat.card (H ⧸ W) < Nat.card H := hlt.trans_eq hHsplit.symm
        rwa [hcard] at h2
      have hqcomm : ∀ a b : H ⧸ W, a * b = b * a := by
        intro a b
        refine QuotientGroup.induction_on a ?_
        intro z
        refine QuotientGroup.induction_on b ?_
        intro z'
        rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul, hcomm z z']
      have hqexp : ∀ a : H ⧸ W, a ^ p = 1 := by
        intro a
        refine QuotientGroup.induction_on a ?_
        intro z
        rw [← QuotientGroup.mk_pow, hp z, QuotientGroup.mk_one]
      have hIH := ih (Nat.card (H ⧸ W)) hqlt hqcomm hqexp rfl
      have hrank : Group.rank H ≤ Group.rank (H ⧸ W) + 1 := by
        obtain ⟨T, hTcard, hTgen⟩ := Group.rank_spec (H ⧸ W)
        choose g hg using fun y : H ⧸ W => QuotientGroup.mk'_surjective W y
        have himg : (insert x (T.image g)).image (QuotientGroup.mk' W) = insert 1 T := by
          rw [Finset.image_insert]
          have h1' : QuotientGroup.mk' W x = 1 := by
            rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hWdef]
            exact Subgroup.mem_zpowers x
          rw [h1']
          congr 1
          ext y
          constructor
          · intro hy
            obtain ⟨z, hz, rfl⟩ := Finset.mem_image.mp hy
            obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hz
            rw [hg t]
            exact ht
          · intro hy
            exact Finset.mem_image.mpr ⟨g y, Finset.mem_image.mpr ⟨y, hy, rfl⟩, hg y⟩
        have hSgen : Subgroup.closure ((insert x (T.image g) : Finset H) : Set H) = ⊤ := by
          have hmap : Subgroup.map (QuotientGroup.mk' W)
              (Subgroup.closure ((insert x (T.image g) : Finset H) : Set H)) = ⊤ := by
            rw [MonoidHom.map_closure, ← Finset.coe_image, himg, Finset.coe_insert, ← hTgen]
            exact closure_insert_eq_of_mem (Subgroup.one_mem _)
          have hsup := sup_ker_eq_top_of_map_eq_top (QuotientGroup.mk' W) hmap
          rw [QuotientGroup.ker_mk'] at hsup
          have hWle : W ≤ Subgroup.closure ((insert x (T.image g) : Finset H) : Set H) :=
            show Subgroup.zpowers x ≤ _ from
              Subgroup.zpowers_le.mpr (Subgroup.subset_closure (by simp))
          rwa [sup_eq_left.mpr hWle] at hsup
        refine (Group.rank_le hSgen).trans ?_
        calc (insert x (T.image g)).card ≤ (T.image g).card + 1 := Finset.card_insert_le _ _
          _ ≤ T.card + 1 := by
              have := Finset.card_image_le (s := T) (f := g)
              omega
          _ = Group.rank (H ⧸ W) + 1 := by rw [hTcard]
      have hlog : Nat.log p (Nat.card (H ⧸ W)) + 1 = Nat.log p (Nat.card H) := by
        rw [hqcard, hk, Nat.log_pow hp2, Nat.log_pow hp2]
        omega
      omega

/-- **The rank of a finite abelian group of exponent `p` is `log_p` of its order.** -/
theorem rank_eq_log_card_of_abelian_exp_p {p : ℕ} [Fact p.Prime] {H : Type*} [Group H] [Fintype H]
    (hcomm : ∀ a b : H, a * b = b * a) (hpow : ∀ a : H, a ^ p = 1) :
    Group.rank H = Nat.log p (Nat.card H) := by
  refine le_antisymm ?_ ?_
  · exact rank_le_log_card_aux (Nat.card H) hcomm hpow rfl
  · letI : CommGroup H := { (inferInstance : Group H) with mul_comm := hcomm }
    have hp1 : 1 < p := (Fact.out (p := p.Prime)).one_lt
    have hdvd : Nat.card H ∣ p ^ Group.rank H := card_dvd_exponent_pow_rank' (G := H) (n := p) hpow
    have hle : Nat.card H ≤ p ^ Group.rank H :=
      Nat.le_of_dvd (pow_pos (by omega) _) hdvd
    have hloglt : Nat.log p (Nat.card H) ≤ Group.rank H :=
      (Nat.log_mono_right hle).trans_eq (Nat.log_pow hp1 _)
    omega

/-! ## The normal generation criterion modulo `K^p[K,G]` -/

/-- **A subset of `K` normally generates `K` if and only if its image generates `K ⧸ K^p[K,G]`**,
stated for an arbitrary surjection `ψ` out of `K` whose kernel is `K^p[K,G]`. -/
theorem closure_image_eq_top_iff {p : ℕ} [Fact p.Prime] {G : Type*} [Group G] {K : Subgroup G}
    [K.Normal] {V : Type*} [Group V] (ψ : K →* V) (hker : ψ.ker = relFrattiniIn p K)
    (hsurj : Function.Surjective ψ) (s : Set K) :
    Subgroup.closure (ψ '' s) = ⊤ ↔
      K ≤ Subgroup.closure (K.subtype '' s) ⊔ relFrattini p K := by
  classical
  have hRle : relFrattini p K ≤ K := relFrattini_le p K
  set L : Subgroup G := Subgroup.closure (K.subtype '' s) with hL
  have hLle : L ≤ K := (Subgroup.closure_le K).mpr (by rintro _ ⟨x, -, rfl⟩; exact x.2)
  have hLK : L.subgroupOf K = Subgroup.closure s := by
    rw [hL, subgroupOf_closure_eq_closure_aux (by rintro _ ⟨x, -, rfl⟩; exact x.2)]
    congr 1
    exact Set.preimage_image_eq s (fun x y h => Subtype.ext h)
  have hkereq : (relFrattini p K).subgroupOf K = relFrattiniIn p K := rfl
  constructor
  · intro h
    have h1 : Subgroup.map ψ (Subgroup.closure s) = ⊤ := by
      rw [MonoidHom.map_closure]
      exact h
    have h2 : Subgroup.closure s ⊔ relFrattiniIn p K = ⊤ := by
      have hthis := sup_ker_eq_top_of_map_eq_top ψ h1
      rwa [hker] at hthis
    have hle : (⊤ : Subgroup K) ≤ (L ⊔ relFrattini p K).subgroupOf K := by
      rw [← h2]
      refine sup_le ?_ ?_
      · rw [← hLK]; exact Subgroup.subgroupOf_mono K le_sup_left
      · rw [← hkereq]; exact Subgroup.subgroupOf_mono K le_sup_right
    intro x hx
    have hmem := hle (Subgroup.mem_top (⟨x, hx⟩ : K))
    rwa [Subgroup.mem_subgroupOf] at hmem
  · intro h
    have h1 : L.subgroupOf K ⊔ relFrattiniIn p K = ⊤ := by
      have hthis : L.subgroupOf K ⊔ (relFrattini p K).subgroupOf K = ⊤ :=
        subgroupOf_sup_eq_top_aux (K := K) hLle hRle h
      rw [← hkereq]
      exact hthis
    have hbot : Subgroup.map ψ (relFrattiniIn p K) = ⊥ :=
      (Subgroup.map_eq_bot_iff (relFrattiniIn p K)).mpr (le_of_eq hker.symm)
    have htop : Subgroup.map ψ (⊤ : Subgroup K) = ⊤ := by
      rw [Subgroup.map_top]
      exact (MonoidHom.range_eq_top).mpr hsurj
    have h2 : Subgroup.map ψ (L.subgroupOf K) = ⊤ := by
      calc Subgroup.map ψ (L.subgroupOf K)
          = Subgroup.map ψ (L.subgroupOf K) ⊔ ⊥ := by rw [sup_bot_eq]
        _ = Subgroup.map ψ (L.subgroupOf K) ⊔ Subgroup.map ψ (relFrattiniIn p K) := by
              rw [hbot]
        _ = Subgroup.map ψ (L.subgroupOf K ⊔ relFrattiniIn p K) := (Subgroup.map_sup _ _ _).symm
        _ = Subgroup.map ψ (⊤ : Subgroup K) := by rw [h1]
        _ = ⊤ := htop
    rw [hLK, MonoidHom.map_closure] at h2
    exact h2

/-! ## The two inequalities, for an abstract elementary abelian quotient -/

theorem log_card_le_normalGeneratorNumber_abs {G : Type*} [Group G] [Fintype G] {p : ℕ}
    [Fact p.Prime] (hG : IsPGroup p G) {K : Subgroup G} [K.Normal] {V : Type*} [Group V]
    [Fintype V] (ψ : K →* V) (hker : ψ.ker = relFrattiniIn p K) (hsurj : Function.Surjective ψ)
    (hcomm : ∀ a b : V, a * b = b * a) (hpow : ∀ a : V, a ^ p = 1) :
    Nat.log p (Nat.card V) ≤ normalGeneratorNumber K := by
  classical
  rw [← rank_eq_log_card_of_abelian_exp_p hcomm hpow]
  have hbound : ∀ S : Finset G, NormalGenerates K S → Group.rank V ≤ S.card := by
    intro S hS
    have hsub : (S : Set G) ⊆ K := NormalGenerates.subset hS
    set sK : Finset K := S.attach.image (fun x => (⟨x.1, hsub x.2⟩ : K)) with hsKdef
    have hsKcard : sK.card ≤ S.card := by
      rw [hsKdef]
      calc (S.attach.image _).card ≤ S.attach.card := Finset.card_image_le
        _ = S.card := Finset.card_attach
    have hsub' : K.subtype '' (sK : Set K) = (S : Set G) := by
      rw [hsKdef]
      ext y
      constructor
      · rintro ⟨z, hz, rfl⟩
        obtain ⟨w, _, rfl⟩ := Finset.mem_image.mp hz
        exact w.2
      · intro hy
        exact ⟨⟨y, hsub hy⟩, Finset.mem_image.mpr ⟨⟨y, hy⟩, Finset.mem_attach _ _, rfl⟩, rfl⟩
    have hnm : K ≤ Subgroup.closure (S : Set G) ⊔ ⁅Subgroup.closure (S : Set G), (⊤ : Subgroup G)⁆ :=
      hS.symm.trans_le (le_of_eq (normalClosure_eq_sup_commutator (S : Set G)))
    have hKle : K ≤ Subgroup.closure (K.subtype '' (sK : Set K)) ⊔ relFrattini p K := by
      rw [hsub']
      have hcomm_le : ⁅Subgroup.closure (S : Set G), (⊤ : Subgroup G)⁆ ≤ relFrattini p K :=
        (Subgroup.commutator_mono ((Subgroup.closure_le K).mpr hsub) le_rfl).trans le_sup_right
      exact hnm.trans (sup_le le_sup_left (hcomm_le.trans le_sup_right))
    have hcl : Subgroup.closure (ψ '' (sK : Set K)) = ⊤ :=
      (closure_image_eq_top_iff ψ hker hsurj (sK : Set K)).mpr hKle
    have hT : Subgroup.closure (((sK.image ψ) : Finset V) : Set V) = ⊤ := by
      rw [Finset.coe_image]
      exact hcl
    calc Group.rank V ≤ (sK.image ψ).card := Group.rank_le hT
      _ ≤ sK.card := Finset.card_image_le
      _ ≤ S.card := hsKcard
  have hne : ({r : ℕ | ∃ S : Finset G, S.card = r ∧ NormalGenerates K S}).Nonempty := by
    refine ⟨_, Finset.univ.filter (fun x => x ∈ K), rfl, ?_⟩
    have hset : ((Finset.univ.filter (fun x => x ∈ K) : Finset G) : Set G) = (K : Set G) := by
      ext x; simp
    rw [NormalGenerates, hset]
    exact le_antisymm (Subgroup.normalClosure_le_normal le_rfl) Subgroup.le_normalClosure
  obtain ⟨S, hScard, hSng⟩ := Nat.sInf_mem hne
  have hScard' : S.card = normalGeneratorNumber K := hScard
  rw [← hScard']
  exact hbound S hSng

theorem normalGeneratorNumber_le_log_card_abs {G : Type*} [Group G] [Fintype G] {p : ℕ}
    [Fact p.Prime] (hG : IsPGroup p G) {K : Subgroup G} [K.Normal] {V : Type*} [Group V]
    [Fintype V] (ψ : K →* V) (hker : ψ.ker = relFrattiniIn p K) (hsurj : Function.Surjective ψ)
    (hcomm : ∀ a b : V, a * b = b * a) (hpow : ∀ a : V, a ^ p = 1) :
    normalGeneratorNumber K ≤ Nat.log p (Nat.card V) := by
  classical
  rw [← rank_eq_log_card_of_abelian_exp_p hcomm hpow]
  obtain ⟨T, hTcard, hTgen⟩ := Group.rank_spec V
  choose g hg using fun y : V => hsurj y
  set sK : Finset K := T.image g with hsKdef
  have hsKcard : sK.card ≤ T.card := by
    rw [hsKdef]
    exact Finset.card_image_le
  have hsimg : ψ '' (sK : Set K) = (T : Set V) := by
    rw [hsKdef, Finset.coe_image]
    ext y
    constructor
    · rintro ⟨z, ⟨t, ht, rfl⟩, rfl⟩
      rw [hg t]
      exact ht
    · intro hy
      exact ⟨g y, ⟨y, hy, rfl⟩, hg y⟩
  have hcl : Subgroup.closure (ψ '' (sK : Set K)) = ⊤ := by
    rw [hsimg]; exact hTgen
  have hKle : K ≤ Subgroup.closure (K.subtype '' (sK : Set K)) ⊔ relFrattini p K :=
    (closure_image_eq_top_iff ψ hker hsurj (sK : Set K)).mp hcl
  set S' : Finset G := sK.image K.subtype with hS'def
  have hS'coe : (S' : Set G) = K.subtype '' (sK : Set K) := by
    rw [hS'def, Finset.coe_image]
  have hS'sub : (S' : Set G) ⊆ K := by
    rw [hS'coe]
    rintro x ⟨z, -, rfl⟩
    exact z.2
  have hS'card : S'.card ≤ T.card := by
    rw [hS'def]
    exact Finset.card_image_le.trans hsKcard
  have hgen : NormalGenerates K S' := by
    refine le_antisymm (Subgroup.normalClosure_le_normal hS'sub) ?_
    have h1 : K ≤ Subgroup.normalClosure (S' : Set G) ⊔ relFrattini p K := by
      rw [hS'coe]
      have hle : Subgroup.closure (K.subtype '' (sK : Set K))
          ≤ Subgroup.normalClosure (K.subtype '' (sK : Set K)) := by
        rw [← Subgroup.normalClosure_closure_eq_normalClosure]
        exact Subgroup.le_normalClosure
      exact le_trans hKle (sup_le_sup hle le_rfl)
    exact le_of_le_sup_relFrattini_aux hG ‹K.Normal› Subgroup.normalClosure_normal
      (Subgroup.normalClosure_le_normal hS'sub) h1
  exact (normalGeneratorNumber_le hgen).trans (hS'card.trans_eq hTcard)

/-! ## The theorem -/

theorem quotient_relFrattini_comm {G : Type*} [Group G] {p : ℕ} {K : Subgroup G} [K.Normal] :
    ∀ a b : K ⧸ relFrattiniIn p K, a * b = b * a := by
  intro a b
  refine QuotientGroup.induction_on a ?_
  intro z
  refine QuotientGroup.induction_on b ?_
  intro z'
  rw [← QuotientGroup.mk_mul, ← QuotientGroup.mk_mul]
  refine QuotientGroup.eq.mpr ?_
  have h1 : (⁅z⁻¹, z'⁆ : K) ∈ relFrattiniIn p K := by
    rw [mem_relFrattiniIn]
    exact Subgroup.mem_sup_right
      (Subgroup.commutator_mem_commutator (H₁ := K) (H₂ := (⊤ : Subgroup G))
        (K.inv_mem z.2) (Subgroup.mem_top (z' : G)))
  have h2 : z'⁻¹ * ⁅z⁻¹, z'⁆ * z' ∈ relFrattiniIn p K := by
    simpa using Subgroup.Normal.conj_mem (H := relFrattiniIn p K) inferInstance
      (⁅z⁻¹, z'⁆ : K) h1 z'⁻¹
  have heq : (z * z')⁻¹ * (z' * z) = z'⁻¹ * ⁅z⁻¹, z'⁆ * z' := by
    rw [commutatorElement_def]; group
  rw [heq]
  exact h2

theorem quotient_relFrattini_pow {G : Type*} [Group G] {p : ℕ} {K : Subgroup G} [K.Normal] :
    ∀ a : K ⧸ relFrattiniIn p K, a ^ p = 1 := by
  intro a
  refine QuotientGroup.induction_on a ?_
  intro z
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, mem_relFrattiniIn]
  exact pow_mem_relFrattini p K z.2

theorem normalGeneratorNumber_eq_relFrattiniDim_of_finite_pgroup {G : Type*} [Group G] [Fintype G]
    {p : ℕ} [Fact p.Prime] (hG : IsPGroup p G) {K : Subgroup G} [K.Normal] :
    normalGeneratorNumber K = relFrattiniDim p K := by
  classical
  refine le_antisymm ?_ ?_
  · refine normalGeneratorNumber_le_log_card_abs hG (QuotientGroup.mk' (relFrattiniIn p K))
      (QuotientGroup.ker_mk' (relFrattiniIn p K)) (QuotientGroup.mk'_surjective _)
      quotient_relFrattini_comm quotient_relFrattini_pow
  · exact log_card_le_normalGeneratorNumber_abs hG (QuotientGroup.mk' (relFrattiniIn p K))
      (QuotientGroup.ker_mk' (relFrattiniIn p K)) (QuotientGroup.mk'_surjective _)
      quotient_relFrattini_comm quotient_relFrattini_pow

