import Mathlib
import Submission.Work.HopfGaschutz.Defs

/-!
# The Nakayama / non-generator step for the relation-Frattini subgroup

**Namespace** `Work.HopfGaschutz`; module
`Submission.Work.HopfGaschutz.le_normalClosure_of_le_sup_relFrattini`.

This file proves the *engine* of the relation-rank dictionary
(`Submission/Work/HopfGaschutz/Defs.lean`): inside a finite `p`-group, a normal subgroup `P` which
is generated modulo the relation-Frattini subgroup `P^p [P,G]` by a normal subgroup `M ≤ P` is
already generated by `M`:

  `P ≤ M ⊔ (P^p ⊔ ⁅P,⊤⁆)  →  P ≤ M`.

The target statement is the special case `P = K`, `M = Subgroup.normalClosure S`: a set `S` of
elements of a normal subgroup `K` of a finite `p`-group which normally generates `K` modulo
`K^p[K,G]` already normally generates `K`.

## The mathematics

The engine is the classical Nakayama step of Gaschütz's relation-rank theory: it holds because the
defect `K ⧸ ⟪S⟫` is a `p`-group (a quotient of `G`), and for a `p`-group `V` on which a `p`-group
acts, `V = V^p[V,G]` forces `V = 1`.  The proof of that fact given here avoids group algebras and
Nakayama's lemma, and instead uses only:

* a nontrivial normal subgroup of a finite `p`-group meets its centre
  (`Group.IsNilpotent.inf_center_ne_bot_of_normal`, nilpotency of `p`-groups);
* the characterisation `⁅V,⊤⁆ = ⊥ ↔ V ≤ center G` of centrality by commutators;
* Cauchy's theorem (`exists_prime_orderOf_dvd_card'`).

Passing from `M` to `P ⧸ M` we reduce to the case `M = ⊥`, `P = V` a *minimal* nontrivial normal
subgroup of `Q`.  Then `V ⊓ Z(Q) ≠ ⊥`, so `V ≤ Z(Q)` by minimality, whence `⁅V,Q⁆ = ⊥` and the
hypothesis reads `V ≤ V^p`.  Since `V ≠ ⊥` is a `p`-group, Cauchy gives `z ∈ V` of order `p`;
`⟨z⟩ ≤ Z(Q)` is a nontrivial normal subgroup of `Q` contained in `V`, so `⟨z⟩ = V` by minimality,
and then every element of `V` is a power of `z` and hence `x ^ p = 1`: so `V^p = ⊥` and the
hypothesis forces `V ≤ ⊥`, a contradiction.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.HopfGaschutz

open scoped commutatorElement

/-- **The engine, irreducible form.**  A minimal nontrivial normal subgroup `V` of a finite
`p`-group `Q` cannot be contained in `V^p [V,Q]`: if `V ≤ V^p ⊔ ⁅V,⊤⁆` then `V = ⊥`. -/
private theorem bot_of_le_pPower_sup_commutator_of_minimal_normal
    {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime] (hQ : IsPGroup p Q)
    {V : Subgroup Q} [V.Normal] (hVne : V ≠ ⊥)
    (hmin : ∀ N : Subgroup Q, N.Normal → N ≤ V → N ≠ ⊥ → N = V)
    (h : V ≤ pPower p V ⊔ ⁅V, (⊤ : Subgroup Q)⁆) : False := by
  haveI hNil : Group.IsNilpotent Q := hQ.isNilpotent
  -- Step 1: `V` meets the centre of `Q`, hence (by minimality) is central.
  have hZne : V ⊓ Subgroup.center Q ≠ ⊥ :=
    Group.IsNilpotent.inf_center_ne_bot_of_normal (H := V) hVne
  have hZ : V ⊓ Subgroup.center Q = V := hmin _ inferInstance inf_le_left hZne
  have hcenter : V ≤ Subgroup.center Q := hZ ▸ inf_le_right
  -- Step 2: `⁅V,Q⁆ = ⊥`, so the hypothesis reads `V ≤ V^p`.
  have hcomm : ⁅V, (⊤ : Subgroup Q)⁆ = ⊥ :=
    Subgroup.commutator_top_right_eq_bot_iff_le_center.mpr hcenter
  have hpow : V ≤ pPower p V := by
    have h' := h
    rw [hcomm, sup_bot_eq] at h'
    exact h'
  -- Step 3: Cauchy's theorem, and minimality applied to the cyclic subgroup generated by an
  -- element of order `p` (which is central, hence normal in `Q`).
  have hcard : p ∣ Nat.card ↥V := by
    rcases IsPGroup.card_eq_or_dvd (hQ.to_subgroup V) with h1 | h1
    · exact absurd (Subgroup.card_eq_one.mp h1) hVne
    · exact h1
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := ↥V) p hcard
  have hz1 : z ≠ 1 := by
    intro hz0
    rw [hz0, orderOf_one] at hz
    exact (Fact.out : p.Prime).ne_one hz.symm
  have hzc : (z : Q) ∈ V := z.2
  have hzord : orderOf (z : Q) = p := by rw [Subgroup.orderOf_coe, hz]
  have hzV : Subgroup.zpowers (z : Q) = V := by
    refine hmin _
      (Subgroup.normal_of_le_center fun x hx => hcenter (Subgroup.zpowers_le.mpr hzc hx))
      (Subgroup.zpowers_le.mpr hzc) ?_
    intro hbot
    have hmem : (z : Q) ∈ (⊥ : Subgroup Q) := by
      rw [← hbot]
      exact Subgroup.mem_zpowers _
    exact hz1 (Subtype.ext (Subgroup.mem_bot.mp hmem))
  -- Step 4: every element of `V` is a power of `z`, hence has `p`-th power `1`.
  have hkey : ∀ x ∈ V, x ^ p = 1 := by
    intro x hx
    have hxz : x ∈ Subgroup.zpowers (z : Q) := by rw [hzV]; exact hx
    have hd : orderOf x ∣ p := hzord ▸ orderOf_dvd_of_mem_zpowers hxz
    exact (orderOf_dvd_iff_pow_eq_one).mp hd
  have hpbot : pPower p V = ⊥ := by
    rw [pPower]
    refine le_bot_iff.mp ?_
    rw [Subgroup.closure_le]
    rintro x ⟨k, hk, rfl⟩
    exact Subgroup.mem_bot.mpr (hkey k hk)
  -- Step 5: contradiction.
  exact hVne (le_bot_iff.mp (hpow.trans (le_of_eq hpbot)))

/-- **The engine, relative form.**  Let `Q` be a finite `p`-group and `M ≤ P` normal subgroups of
`Q`.  If `P` is contained in `M ⊔ (P^p ⊔ ⁅P,⊤⁆)`, then `P ≤ M`. -/
private theorem le_of_le_sup_pPower_sup_commutator
    {Q : Type*} [Group Q] [Finite Q] {p : ℕ} [Fact p.Prime] (hQ : IsPGroup p Q)
    {M P : Subgroup Q} [M.Normal] [P.Normal] (hMP : M ≤ P)
    (h : P ≤ M ⊔ (pPower p P ⊔ ⁅P, (⊤ : Subgroup Q)⁆)) : P ≤ M := by
  by_contra hcon
  have hMPne : M ≠ P := fun hEq => hcon (le_of_eq hEq.symm)
  -- A normal subgroup `L` with `M ≤ L ≤ P`, `L ≠ P`, maximal with these properties.
  obtain ⟨L, _, hLmax⟩ := exists_maximal_ge_of_wellFoundedGT
    (fun L : Subgroup Q => M ≤ L ∧ L ≤ P ∧ L.Normal ∧ L ≠ P) M
    ⟨le_rfl, hMP, inferInstance, hMPne⟩
  obtain ⟨hML, hLP, hLnorm, hLne⟩ := hLmax.prop
  haveI : L.Normal := hLnorm
  set q : Q →* Q ⧸ L := QuotientGroup.mk' L with hqdef
  have hker : q.ker = L := QuotientGroup.ker_mk' L
  have hsurj : Function.Surjective q := QuotientGroup.mk'_surjective L
  -- The image `P ⧸ L` is nontrivial.
  have hVne : P.map q ≠ ⊥ := by
    intro hbot
    have hPL : P ≤ L := by
      have h1 : P ≤ q.ker := (Subgroup.map_eq_bot_iff P).mp hbot
      rwa [hker] at h1
    exact hLne (le_antisymm hLP hPL)
  -- `P ⧸ L` is a minimal normal subgroup of `Q ⧸ L`.
  have hmin : ∀ N : Subgroup (Q ⧸ L), N.Normal → N ≤ P.map q → N ≠ ⊥ → N = P.map q := by
    intro N hNnorm hNV hNne
    have hN'norm : (N.comap q).Normal := hNnorm.comap q
    have hMN' : M ≤ N.comap q := by
      intro x hx
      rw [Subgroup.mem_comap]
      have hxL : x ∈ q.ker := by rw [hker]; exact hML hx
      rw [MonoidHom.mem_ker.mp hxL]
      exact N.one_mem
    have hLN' : L ≤ N.comap q := by
      intro x hx
      rw [Subgroup.mem_comap]
      have hxL : x ∈ q.ker := by rw [hker]; exact hx
      rw [MonoidHom.mem_ker.mp hxL]
      exact N.one_mem
    have hN'P : N.comap q ≤ P := by
      have h1 : Subgroup.comap q (P.map q) = P := by
        rw [Subgroup.comap_map_eq, hker]
        exact sup_eq_left.mpr hLP
      rw [← h1]
      exact Subgroup.comap_mono hNV
    by_cases hEq : N.comap q = P
    · have h1 : Subgroup.map q (N.comap q) = N := Subgroup.map_comap_eq_self_of_surjective hsurj N
      rw [hEq] at h1
      exact h1.symm
    · have hle : N.comap q ≤ L := hLmax.2 ⟨hMN', hN'P, hN'norm, hEq⟩ hLN'
      have hbot : N = ⊥ := by
        rw [← Subgroup.map_comap_eq_self_of_surjective hsurj N]
        refine le_bot_iff.mp (le_trans (Subgroup.map_mono hle) ?_)
        exact le_bot_iff.mpr ((Subgroup.map_eq_bot_iff L).mpr (le_of_eq hker.symm))
      exact absurd hbot hNne
  -- The hypothesis descends to the quotient.
  have hVle : P.map q ≤ pPower p (P.map q) ⊔ ⁅P.map q, (⊤ : Subgroup (Q ⧸ L))⁆ := by
    have h1 : P.map q ≤ (M ⊔ (pPower p P ⊔ ⁅P, (⊤ : Subgroup Q)⁆)).map q :=
      Subgroup.map_mono h
    have h2 : Subgroup.map q M = ⊥ := by
      rw [Subgroup.map_eq_bot_iff]
      rw [hker]
      exact hML
    have h3 : Subgroup.map q (pPower p P) ≤ pPower p (Subgroup.map q P) := by
      rw [Subgroup.map_le_iff_le_comap, pPower, Subgroup.closure_le]
      rintro x ⟨k, hk, rfl⟩
      change q (k ^ p) ∈ pPower p (Subgroup.map q P)
      exact Subgroup.subset_closure ⟨q k, Subgroup.mem_map_of_mem q hk, (map_pow q k p).symm⟩
    have h4 : Subgroup.map q ⁅P, (⊤ : Subgroup Q)⁆ =
        ⁅Subgroup.map q P, (⊤ : Subgroup (Q ⧸ L))⁆ := by
      rw [Subgroup.map_commutator, Subgroup.map_top_of_surjective q hsurj]
    rw [Subgroup.map_sup, Subgroup.map_sup, h2, h4] at h1
    rw [bot_sup_eq] at h1
    exact le_trans h1 (sup_le_sup h3 le_rfl)
  haveI : (P.map q).Normal := Subgroup.Normal.map inferInstance q hsurj
  exact bot_of_le_pPower_sup_commutator_of_minimal_normal (hQ.to_quotient L) hVne hmin hVle

/-- **The Nakayama step for the relation-Frattini subgroup.**  If a normal subgroup `K` of a finite
`p`-group `G` is contained in the join of the normal closure of a set `S ⊆ K` with the
relation-Frattini subgroup `K^p [K,G]`, then `S` already normally generates `K`. -/
theorem le_normalClosure_of_le_sup_relFrattini {G : Type*} [Group G] [Fintype G] {p : ℕ} [Fact p.Prime]
    (hG : IsPGroup p G) {K : Subgroup G} [K.Normal] {S : Finset G} (hS : (S : Set G) ⊆ K)
    (h : K ≤ Subgroup.normalClosure (S : Set G) ⊔ relFrattini p K) :
    K ≤ Subgroup.normalClosure (S : Set G) := by
  have hNK : Subgroup.normalClosure (S : Set G) ≤ K := Subgroup.normalClosure_le_normal hS
  have h' : K ≤ Subgroup.normalClosure (S : Set G) ⊔ (pPower p K ⊔ ⁅K, (⊤ : Subgroup G)⁆) := by
    simpa [relFrattini] using h
  exact le_of_le_sup_pPower_sup_commutator (M := Subgroup.normalClosure (S : Set G)) (P := K) hG hNK h'

end Work.HopfGaschutz
