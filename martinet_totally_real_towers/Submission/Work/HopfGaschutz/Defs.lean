import Mathlib

/-!
# `Work.HopfGaschutz` -- Hopf's formula and the relation-rank dictionary

**Namespace** `Work.HopfGaschutz`; module `Submission.Work.HopfGaschutz.Defs`.

This chapter isolates the *group theory* that converts a cohomological bound on the relation rank of
a (pro-)`p` group into an honest **presentation** of that group -- step 5 of the classical chain of
`Submission/Work/TameSalle/README.md` §4, the last structurally missing piece of the workspace's
algebra layer.  There is no number theory here.

## The invariant

Let `F` be a group, `K ⊴ F` a normal subgroup, and `p` a prime.  The classical relation-rank
dictionary (Hopf 1942; Gaschütz 1953; Koch, *Galois theory of `p`-extensions*, Ch. 11;
Neukirch--Schmidt--Wingberg I §4.3; see `Hajir--Maire--Ramakrishna`, arXiv:2103.09508, where
`r(G) := dim H²(G, ℤ/p)`)

> the minimal number of generators of `K` **as a normal subgroup** of `F` (equivalently: the minimal
> number of relators of the corresponding presentation of `F/K` on the given generators) equals
> `dim_{𝔽_p} H²(F/K, 𝔽_p)`, which the transgression computes as the `𝔽_p`-dimension of

  `K / (K^p · [K,F])`

*provided `F` is free (or free pro-`p`) and the presentation is on a minimal generating set*;
in general the dimension of `K/(K^p[K,F])` is `dim H² - (α - dim H¹)`.

## What this file defines

* `pPower p K` -- the subgroup generated by `p`-th powers of elements of `K`;
* `relFrattini p K` -- **the relation-Frattini subgroup** `K^p [K,F]`, the subgroup by which one
  quotients to obtain the `𝔽_p`-vector space `K ⧸ K^p[K,F]` whose dimension is the relation rank;
* `NormalGenerates K S` -- the finite set `S` normally generates `K`;
* `normalGeneratorNumber K` -- the minimal cardinality of such an `S`;
* `relFrattiniIn p K`, `relFrattiniDim p K` -- the quotient `K ⧸ K^p[K,F]` and its `𝔽_p`-dimension
  (`Nat.log p |K ⧸ K^p[K,F]|`, correct when the quotient is an elementary abelian `p`-group);
* `relatorRankOn α G` -- the minimal number of relators of a presentation of `G` on `α` generators;
* `h2DimOf p α G gen` -- the relation rank of the presentation of `G` induced by `gen`, computed as
  `relFrattiniDim p (ker (FreeGroup.lift gen))`; classically this is `dim_{𝔽_p} H²(G, 𝔽_p)` when
  `gen` is a minimal generating family;
* `GaschutzDictionary p` -- **the one named classical input** of the chapter (the upward direction of
  the dictionary: a bound on `dim H²` produces a presentation with that many relators);
* `RelationRankLowerBound p` -- the downward direction (a presentation always has at least
  `dim H²` relators), which is the easy direction of the dictionary.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace Work.HopfGaschutz

open scoped commutatorElement

variable {F : Type*} [Group F]

/-! ## The relation-Frattini subgroup `K^p [K,F]` -/

/-- **The `p`-th power subgroup** of `K`: the subgroup of `F` generated by the `p`-th powers of the
elements of `K`. -/
def pPower (p : ℕ) (K : Subgroup F) : Subgroup F :=
  Subgroup.closure {x : F | ∃ k ∈ K, k ^ p = x}

/-- **The relation-Frattini subgroup `K^p[K,F]`** of a normal subgroup `K ⊴ F`: the subgroup
generated by the `p`-th powers of elements of `K` together with the commutators `[K,F]`.

Its role: for `F` free and `K = ker(F ↠ Q)` the quotient `K ⧸ K^p[K,F]` is (the dual of) the
transgression image, whose dimension is `dim H²(Q,𝔽_p) + (α - dim H¹(Q,𝔽_p))`; and (this is the
*engine*, `Engine.lean`) a finite set normally generates `K` if and only if its image spans this
`𝔽_p`-vector space -- *under the hypothesis that the defect `K ⧸ ⟨S⟩^F` is a `p`-group*, which is
automatic in the pro-`p` (or finite `p`-group) setting and *not* automatic for a general normal
subgroup of a discrete free group (see `Counterexample.lean`). -/
def relFrattini (p : ℕ) (K : Subgroup F) : Subgroup F :=
  pPower p K ⊔ ⁅K, ⊤⁆

theorem pPower_le (p : ℕ) (K : Subgroup F) : pPower p K ≤ K := by
  rw [pPower, Subgroup.closure_le]
  rintro x ⟨k, hk, rfl⟩
  exact K.pow_mem hk p

theorem pPower_mono (p : ℕ) {K L : Subgroup F} (h : K ≤ L) : pPower p K ≤ pPower p L := by
  rw [pPower, Subgroup.closure_le]
  rintro x ⟨k, hk, rfl⟩
  exact Subgroup.subset_closure ⟨k, h hk, rfl⟩

/-- The set of `p`-th powers of elements of a normal subgroup is closed under conjugation. -/
theorem conj_mem_pPowerSet (p : ℕ) (K : Subgroup F) [K.Normal] {x c : F}
    (hx : x ∈ {y : F | ∃ k ∈ K, k ^ p = y}) : c * x * c⁻¹ ∈ {y : F | ∃ k ∈ K, k ^ p = y} := by
  obtain ⟨k, hk, rfl⟩ := hx
  refine ⟨c * k * c⁻¹, Subgroup.Normal.conj_mem (H := K) ‹K.Normal› k hk c, ?_⟩
  rw [conj_pow]

instance pPower_normal (p : ℕ) (K : Subgroup F) [K.Normal] : (pPower p K).Normal :=
  ⟨fun n hn g => by
    rw [pPower] at hn ⊢
    refine Subgroup.closure_induction (fun x hx => Subgroup.subset_closure (conj_mem_pPowerSet p K hx))
      ?_ ?_ ?_ hn
    · simp
    · intro x y _ _ hx hy
      rw [← conj_mul]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      rw [← conj_inv]
      exact Subgroup.inv_mem _ hx⟩

theorem relFrattini_mono (p : ℕ) {K L : Subgroup F} (h : K ≤ L) :
    relFrattini p K ≤ relFrattini p L :=
  sup_le_sup (pPower_mono p h) (Subgroup.commutator_mono h le_rfl)

instance relFrattini_normal (p : ℕ) (K : Subgroup F) [K.Normal] : (relFrattini p K).Normal :=
  Subgroup.sup_normal (pPower p K) ⁅K, ⊤⁆

theorem pow_mem_relFrattini (p : ℕ) (K : Subgroup F) {k : F} (hk : k ∈ K) :
    k ^ p ∈ relFrattini p K :=
  Subgroup.mem_sup_left (show k ^ p ∈ pPower p K from Subgroup.subset_closure ⟨k, hk, rfl⟩)

/-- The commutator `[k,f]` of `k ∈ K` with `f ∈ F` lies in `K^p[K,F]`. -/
theorem commutator_mem_relFrattini (p : ℕ) (K : Subgroup F) {k f : F} (hk : k ∈ K) :
    ⁅k, f⁆ ∈ relFrattini p K := by
  apply Subgroup.mem_sup_right
  show (⁅k, f⁆ : F) ∈ ⁅K, ⊤⁆
  rw [Subgroup.commutator_def]
  exact Subgroup.subset_closure ⟨k, hk, f, trivial, rfl⟩

theorem relFrattini_le (p : ℕ) (K : Subgroup F) [K.Normal] : relFrattini p K ≤ K := by
  refine sup_le (pPower_le p K) ?_
  rw [Subgroup.commutator_le]
  intro a ha b _
  have h2 : b * a⁻¹ * b⁻¹ ∈ K := by
    have := Subgroup.Normal.conj_mem (H := K) ‹K.Normal› a⁻¹ (K.inv_mem ha) b
    simpa only [inv_inv] using this
  have h3 : (⁅a, b⁆ : F) = a * (b * a⁻¹ * b⁻¹) := by
    rw [commutatorElement_def]
    group
  rw [h3]
  exact K.mul_mem ha h2

/-! ## Normal generation -/

/-- **`S` normally generates `K`**: the normal closure of the finite set `S` is exactly `K`. -/
def NormalGenerates (K : Subgroup F) (S : Finset F) : Prop :=
  Subgroup.normalClosure (S : Set F) = K

theorem NormalGenerates.subset {K : Subgroup F} {S : Finset F} (h : NormalGenerates K S) :
    (S : Set F) ⊆ K := by
  intro x hx
  rw [← h]
  exact Subgroup.subset_normalClosure hx

theorem NormalGenerates.le {K L : Subgroup F} {S : Finset F} (h : NormalGenerates K S)
    (hKL : K ≤ L) : Subgroup.normalClosure (S : Set F) ≤ L := by
  rw [h]; exact hKL

/-- **The normal generator number** `d_F(K)`: the minimal cardinality of a finite set normally
generating `K` (with the `sInf` convention: `0` if no finite set does).

This is the minimal number of relators of the presentation of `F/K` on the generators of `F`. -/
noncomputable def normalGeneratorNumber (K : Subgroup F) : ℕ :=
  sInf {r : ℕ | ∃ S : Finset F, S.card = r ∧ NormalGenerates K S}

theorem normalGeneratorNumber_le {K : Subgroup F} {S : Finset F} (h : NormalGenerates K S) :
    normalGeneratorNumber K ≤ S.card :=
  Nat.sInf_le ⟨S, rfl, h⟩

/-! ## The relation-Frattini quotient -/

/-- The relation-Frattini subgroup of `K`, viewed as a subgroup of `K`. -/
def relFrattiniIn (p : ℕ) (K : Subgroup F) : Subgroup K :=
  (relFrattini p K).subgroupOf K

instance relFrattiniIn_normal (p : ℕ) (K : Subgroup F) [K.Normal] : (relFrattiniIn p K).Normal :=
  Subgroup.Normal.subgroupOf (relFrattini_normal p K) K

@[simp]
theorem mem_relFrattiniIn (p : ℕ) (K : Subgroup F) (x : K) :
    x ∈ relFrattiniIn p K ↔ (x : F) ∈ relFrattini p K := Iff.rfl

/-- **The relation rank of a normal subgroup**: the `𝔽_p`-dimension of `K ⧸ K^p[K,F]`, computed as
`Nat.log p` of its cardinality.  This is the right `𝔽_p`-dimension whenever the quotient is an
elementary abelian `p`-group, which it always is; for an infinite `K` the convention
`Nat.card _ = 0` makes the definition degenerate, so statements about genuine dimensions carry a
finiteness hypothesis. -/
noncomputable def relFrattiniDim (p : ℕ) (K : Subgroup F) : ℕ :=
  Nat.log p (Nat.card (K ⧸ relFrattiniIn p K))

/-! ## Presentations and the dictionary -/

/-- **The relator rank of a group on `α` generators**: the minimal number of relators in a
presentation `G ≃* FreeGroup α ⧸ ⟪rel⟫` (`sInf`-convention: `0` if there is none). -/
noncomputable def relatorRankOn (α : Type*) (G : Type*) [Group G] : ℕ :=
  sInf {r : ℕ | ∃ rel : Finset (FreeGroup α),
    rel.card = r ∧ Nonempty (G ≃* FreeGroup α ⧸ Subgroup.normalClosure (rel : Set (FreeGroup α)))}

/-- **The relation rank of the presentation of `G` induced by a generating family `gen`**: the
`𝔽_p`-dimension of `ker (FreeGroup.lift gen) ⧸ ker^p [ker, FreeGroup α]`.

Classically (`Hopf`, `Gaschütz`) this is `dim_{𝔽_p} H²(G,𝔽_p)` when `gen` is a *minimal* generating
family of a (pro-)`p` group -- that identification is the transgression, and is recorded in
`Dictionary.lean`. -/
noncomputable def h2DimOf (p : ℕ) (α : Type*) (G : Type*) [Group G] (gen : α → G) : ℕ :=
  relFrattiniDim p (MonoidHom.ker (FreeGroup.lift gen))

/-- **The relation-rank dictionary, downward direction** (`dim H² ≤ r` for every presentation with
`r` relators): a presentation of `G` on a generating family `gen` by `rel` relators has
`h2DimOf p α G gen ≤ rel.card`.

This is the *easy* direction -- a presentation gives a two-step resolution, and the transgression
identifies `K ⧸ K^p[K,F]` with the dual of `H¹(K,𝔽_p)^G`.  It is the source of every *lower* bound on
the number of relations. -/
def RelationRankLowerBound (p : ℕ) (α : Type*) [Fintype α] [DecidableEq α]
    (G : Type*) [Group G] : Prop :=
  ∀ (gen : α → G) (rel : Finset (FreeGroup α)),
    MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure (rel : Set (FreeGroup α)) →
      h2DimOf p α G gen ≤ rel.card

/-- **The relation-rank dictionary, upward direction** (Gaschütz / Hopf): a bound on the relation
rank `dim_{𝔽_p} H²(G,𝔽_p)` of a presentation of a finite `p`-group `G` on a *minimal* generating
family `gen` produces a presentation of `G` on that same family with at most that many relators.

Classically this is `r(G) = dim_{𝔽_p} H²(G,𝔽_p)` (Gaschütz 1953; Koch, *Galois theory of
`p`-extensions*, Ch. 11; Neukirch--Schmidt--Wingberg I §4.3), read as the surjectivity of the
transgression together with Nakayama's lemma for the `𝔽_p[G]`-module `K ⧸ Φ(K)`.

**Status of this input.**  For a finite `p`-group `G`, the equality behind it
(`normalGeneratorNumber (ker (FreeGroup.lift gen)) = relFrattiniDim p (ker (FreeGroup.lift gen))`,
see `Dictionary.gaschutzDictionary_iff_minimalRelatorSet`) is *exactly* the statement that `G` is an
**efficient** `p`-group: a minimal presentation of a finite `p`-group (which exists by Rapaport's
theorem for nilpotent groups) has `d(H₁(G)) + d(H₂(G)) = dim_{𝔽_p} H²(G,𝔽_p)` relators.  Whether
every finite `p`-group is efficient is **open**: "there is no known example of a non-efficient finite
`p`-group" (Gardam, *Finite groups of arbitrary deficiency*, arXiv:1705.02040, quoting Mann, *Some
questions about `p`-groups*, J. Austral. Math. Soc. Ser. A 67 (1999), Question 18).  So this input is
**not** a theorem to be proved by better bookkeeping: it is a known open problem of finite `p`-group
theory.  What *is* a theorem is the same statement in the pro-`p` category, where it is
closed-normal generation (Nakayama over `𝔽_p[[Γ]]`), and in the finite-`p`-group-*ambient* case
(`normalGeneratorNumber_eq_relFrattiniDim_of_finite_pgroup`), which is proved in this chapter.

It is the single classical input of this chapter.  `Dictionary.lean` records exactly what is needed
for it: the *engine* `K = ⟨S⟩^F · K^p[K,F] → ⟨S⟩^F = K` holds under the extra hypothesis that the
defect `K ⧸ ⟨S⟩^F` is a `p`-group, which is automatic in the pro-`p` setting (where `K` is pro-`p`
and Nakayama for compact modules over `𝔽_p[[G]]` applies) but **not** automatic for the discrete free
group -- `Counterexample.lean` exhibits a normal subgroup `K` of `ℤ` and a spanning set `S` with
`K = ⟨S⟩^F · K^p[K,F]` but `⟨S⟩^F ≠ K`. -/
def GaschutzDictionary (p : ℕ) : Prop :=
  ∀ {α : Type} [Fintype α] [DecidableEq α] (G : Type) [Group G] [Fintype G],
    IsPGroup p G → ∀ (gen : α → G),
    Subgroup.closure (Set.range gen) = ⊤ →
    (∀ S : Finset G, Subgroup.closure (S : Set G) = ⊤ → Fintype.card α ≤ S.card) →
    ∀ r : ℕ, h2DimOf p α G gen ≤ r →
      ∃ rel : Finset (FreeGroup α), rel.card ≤ r ∧
        MonoidHom.ker (FreeGroup.lift gen) = Subgroup.normalClosure (rel : Set (FreeGroup α))

end Work.HopfGaschutz
