import Mathlib
import Submission.Work.HopfGaschutz.Setup
import Submission.Work.ConCohomology.ker_H2Res_eq_range_tg
import Submission.Work.ConCohomology.All

/-!
# `Work.HopfGaschutz.tgClass_injective` -- the transgression detects nonzero invariant cocycles

For a generating family `gen : α → Q` of a discrete topological group `Q` and
`K = presKernel gen = ker (FreeGroup.lift gen)`, the transgression

`tgClass gen hgen : Z¹(K, 𝔽₂)^{Q} ⟶ H²(Q, 𝔽₂)`

(the `𝔽₂`-coefficients carrying the trivial action, so that a `1`-cocycle on `K` is a homomorphism
`K → 𝔽₂` and `Z¹(K,𝔽₂) = H¹(K,𝔽₂)`) is **injective** as soon as the generating family is minimal in
the Frattini sense `K ≤ F^2 [F,F]`, `F = FreeGroup α`.

## The mathematics

The classical five term exact sequence of `1 → K → F → Q → 1` reads

`0 → H¹(Q) → H¹(F) → H¹(K)^{Q} --tg--> H²(Q) → H²(F)`,

so `ker(tg) = im(res)` with `res : H¹(F,𝔽₂) → H¹(K,𝔽₂)^{Q}` the restriction.  Under `K ≤ F^2[F,F]`
every homomorphism `F → 𝔽₂` -- these are exactly `H¹(F,𝔽₂)`, the action being trivial -- kills
`F^2[F,F] ⊇ K`, hence `res = 0` and `tg` is injective.

The proof below is the *cochain level* form of `ker(tg) ⊆ im(res)`, avoiding the five term sequence:
if `tg(φ)` is a coboundary `d¹w` on `Q`, then

`z x := φ (liftArg x) + w (q x)   (x : F)`

is a `1`-cocycle on `F` (`liftArg x = x (s (q x))⁻¹ ∈ K` is the defect of a section `s` of `q`),
extending `φ` on `K`; `K ≤ F^2[F,F]` then forces `φ = 0` because a `1`-cocycle `F → 𝔽₂` kills
`F^2[F,F]` (its values are additive, so `z (x²) = z x + z x = 0` and `z [x,y] = 0`).

This is the injection half of `card_contH2_eq_card_relFrattiniQuotient`
(`CohomologicalDictionary.lean`); the surjection half is `tgClass_surjective`.
-/

set_option maxHeartbeats 4000000
set_option linter.unusedVariables false

namespace Work.HopfGaschutz

open Work.ConCohomology
open scoped commutatorElement

/-! ## Elementary `𝔽₂`-lemmas and the Frattini kernel of a `1`-cocycle -/

/-- In `𝔽₂ = ℤ/2`, `m + m = 0`. -/
private lemma zmod2_add_self (m : ZMod 2) : m + m = 0 := by
  rw [← two_mul, show (2 : ZMod 2) = 0 from by decide, zero_mul]

/-- Every group acts trivially on `𝔽₂` (the chapter's `instTrivialActionF2`). -/
private lemma zmod2_smul {G : Type*} [Group G] (g : G) (m : ZMod 2) : g • m = m := rfl

/-- A `1`-cocycle with values in `𝔽₂` (trivial action) is additive. -/
private lemma Z1_add {F : Type*} [Group F] [TopologicalSpace F] [IsTopologicalGroup F]
    [IsDiscreteGModule F (ZMod 2)] (z : Z1 F (ZMod 2)) (a b : F) :
    (z : F → ZMod 2) (a * b) = (z : F → ZMod 2) a + (z : F → ZMod 2) b := by
  rw [mem_Z1.mp z.2 a b]
  rfl

/-- A `1`-cocycle with values in `𝔽₂` inverts inverses. -/
private lemma Z1_inv {F : Type*} [Group F] [TopologicalSpace F] [IsTopologicalGroup F]
    [IsDiscreteGModule F (ZMod 2)] (z : Z1 F (ZMod 2)) (a : F) :
    (z : F → ZMod 2) a⁻¹ = -((z : F → ZMod 2) a) := by
  have h0 : (z : F → ZMod 2) 1 = 0 := isCocycle1_one (mem_Z1.mp z.2)
  have h := Z1_add z a a⁻¹
  rw [mul_inv_cancel, h0] at h
  exact (neg_eq_iff_add_eq_zero.mpr h.symm).symm

/-- A `1`-cocycle with values in `𝔽₂` kills commutators. -/
private lemma Z1_comm {F : Type*} [Group F] [TopologicalSpace F] [IsTopologicalGroup F]
    [IsDiscreteGModule F (ZMod 2)] (z : Z1 F (ZMod 2)) (a b : F) :
    (z : F → ZMod 2) ⁅a, b⁆ = 0 := by
  rw [commutatorElement_def, Z1_add z (a * b * a⁻¹) b⁻¹, Z1_add z (a * b) a⁻¹, Z1_add z a b,
    Z1_inv z a, Z1_inv z b]
  abel

/-- The kernel of a `1`-cocycle `F → 𝔽₂`, as a subgroup of `F`. -/
private def Z1ker {F : Type*} [Group F] [TopologicalSpace F] [IsTopologicalGroup F]
    [IsDiscreteGModule F (ZMod 2)] (z : Z1 F (ZMod 2)) : Subgroup F where
  carrier := {x | (z : F → ZMod 2) x = 0}
  one_mem' := isCocycle1_one (mem_Z1.mp z.2)
  mul_mem' := by
    intro a b ha hb
    show (z : F → ZMod 2) (a * b) = 0
    rw [Z1_add z a b, ha, hb, add_zero]
  inv_mem' := by
    intro a ha
    show (z : F → ZMod 2) a⁻¹ = 0
    rw [Z1_inv z a, ha, neg_zero]

/-- **The Frattini subgroup is contained in the kernel of every `1`-cocycle `F → 𝔽₂`**: the values of
such a cocycle are additive, so squares satisfy `z (x²) = z x + z x = 0 ∈ 𝔽₂` and commutators
`z [x,y] = 0`, and `F²[F,F]` is generated by these. -/
private lemma relFrattini_two_top_le_Z1ker {F : Type*} [Group F] [TopologicalSpace F]
    [IsTopologicalGroup F] [IsDiscreteGModule F (ZMod 2)] (z : Z1 F (ZMod 2)) :
    Work.HopfGaschutz.relFrattini 2 ⊤ ≤ Z1ker z := by
  show pPower 2 (⊤ : Subgroup F) ⊔ ⁅(⊤ : Subgroup F), ⊤⁆ ≤ Z1ker z
  refine sup_le ?_ ?_
  · rw [pPower, Subgroup.closure_le]
    rintro x ⟨k, -, rfl⟩
    show (z : F → ZMod 2) (k ^ 2) = 0
    rw [pow_two, Z1_add z k k]
    exact zmod2_add_self _
  · rw [Subgroup.commutator_le]
    intro a _ b _
    exact Z1_comm z a b

/-! ## The descent of a `1`-cocycle along the extension -/

/-- **Cochain level `ker(tg) ⊆ im(res)`.**  Let `1 → N → G → Q → 1` be a group extension with a
section `s` of `q`, `φ` a `1`-cocycle on `N` invariant under the conjugation action of `G` and `w` a
`1`-cochain on `Q` whose coboundary is the transgression of `φ`.  Then `φ` is the restriction of a
`1`-cocycle on `G`:

`z x = φ (liftArg x) + w (q x)`,   `z ∘ i = φ`.

Indeed, writing `u x = liftArg E s hs x = x · s (q x)⁻¹ ∈ N`, the section identity

`s (q x) s (q y) s (q x q y)⁻¹ = i (u x⁻¹ · (conj x (u y))⁻¹ · u (x y))`

(equivalently `u (xy) = conj x (u y) · u x · tgArg (q x) (q y)`) turns additivity of `φ` and its
invariance under `conj x` into `z (xy) = z x + x • z y` precisely when the transgression of `φ` is the
coboundary `d¹w`.  On `N` the correction term is `w 1 = φ (u 1)`, so `z ∘ i = φ`. -/
private lemma exists_Z1_restrict_of_tg_eq_coboundary {G Q N : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [Group N] [TopologicalSpace N] [IsTopologicalGroup N]
    (E : GroupExt G Q N) (hq : Continuous E.q) (s : Q → G) (hs : ∀ y : Q, E.q (s y) = y)
    (hscont : Continuous s)
    (hkcont : Continuous fun p : {x : G // E.q x = 1} => E.kerLift p.1 p.2)
    (φ : Z1 N (ZMod 2))
    (hφinv : ∀ (g : G) (n : N), (φ : N → ZMod 2) (E.conj g n) = (φ : N → ZMod 2) n)
    (w : Cochain1 Q (ZMod 2))
    (hw : ∀ y₁ y₂ : Q, tgFun E s hs (φ : N → ZMod 2) (y₁, y₂)
        = d1Fun (w : Q → ZMod 2) (y₁, y₂)) :
    ∃ z : Z1 G (ZMod 2), ∀ n : N, (z : G → ZMod 2) (E.i n) = (φ : N → ZMod 2) n := by
  have hkey : ∀ x y : G, tgArg E s hs (E.q x) (E.q y)
      = (liftArg E s hs x)⁻¹ * (E.conj x (liftArg E s hs y))⁻¹ * liftArg E s hs (x * y) := by
    intro x y
    apply E.injective_i
    simp only [i_tgArg, map_mul, map_inv, E.i_conj, i_liftArg]
    group
  let zFun : G → ZMod 2 := fun x =>
    (φ : N → ZMod 2) (liftArg E s hs x) + (w : Q → ZMod 2) (E.q x)
  have hz_loc : IsLocallyConstant zFun :=
    (isLocallyConstant_comp_liftArg E hq s hs hscont hkcont (φ : Cochain1 N (ZMod 2))).add
      (w.isLocallyConstant.comp_continuous hq)
  have hz_coc : IsCocycle1 zFun := by
    intro x y
    have hsplit : liftArg E s hs (x * y)
        = E.conj x (liftArg E s hs y) * liftArg E s hs x * tgArg E s hs (E.q x) (E.q y) := by
      rw [hkey x y]; group
    have hcomp : (φ : N → ZMod 2) (liftArg E s hs (x * y))
        = (φ : N → ZMod 2) (liftArg E s hs y) + (φ : N → ZMod 2) (liftArg E s hs x)
          + (φ : N → ZMod 2) (tgArg E s hs (E.q x) (E.q y)) := by
      rw [hsplit, Z1_add φ (E.conj x (liftArg E s hs y) * liftArg E s hs x)
          (tgArg E s hs (E.q x) (E.q y)),
        Z1_add φ (E.conj x (liftArg E s hs y)) (liftArg E s hs x),
        hφinv x (liftArg E s hs y)]
    show zFun (x * y) = zFun x + x • zFun y
    simp only [zFun]
    rw [hcomp, map_mul, ← tgFun_eq_tgArg E s hs (φ : N → ZMod 2) (E.q x) (E.q y),
      hw (E.q x) (E.q y), d1Fun_apply]
    simp only [smul_add, zmod2_smul]
    abel
  have hK : ∀ n : N, zFun (E.i n) = (φ : N → ZMod 2) n := by
    intro n
    set t1 : N := E.kerLift (s 1) (hs 1) with ht1
    have h1 : E.i t1 = s 1 := by rw [ht1]; exact E.i_kerLift (s 1) (hs 1)
    have htg : tgArg E s hs 1 1 = t1 := by
      apply E.injective_i
      rw [i_tgArg, mul_one, ← h1]
      group
    have hw1 : (φ : N → ZMod 2) t1 = (w : Q → ZMod 2) 1 := by
      have h := hw 1 1
      rw [tgFun_eq_tgArg E s hs (φ : N → ZMod 2) 1 1, htg, d1Fun_apply, one_smul,
        one_mul] at h
      simpa using h
    have hlift : liftArg E s hs (E.i n) = n * t1⁻¹ := by
      apply E.injective_i
      rw [i_liftArg, show E.q (E.i n) = 1 from (E.ker_eq (E.i n)).mpr ⟨n, rfl⟩,
        map_mul, map_inv, h1]
    show (φ : N → ZMod 2) (liftArg E s hs (E.i n)) + (w : Q → ZMod 2) (E.q (E.i n))
      = (φ : N → ZMod 2) n
    rw [hlift, show E.q (E.i n) = 1 from (E.ker_eq (E.i n)).mpr ⟨n, rfl⟩,
      Z1_add φ n t1⁻¹, Z1_inv φ t1, hw1]
    abel
  exact ⟨⟨⟨zFun, hz_loc⟩, mem_Z1.mpr hz_coc⟩, hK⟩

/-! ## Injectivity -/

/-- **The kernel of the transgression.**  If the transgression of an invariant `1`-cocycle `φ` on the
relation kernel `K` vanishes then `φ = 0`, provided `K ≤ K^2[K,F] ⊆ F^2[F,F]`. -/
private theorem tgClass_eq_zero {α Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [TopologicalSpace (FreeGroup α)] [DiscreteTopology (FreeGroup α)] [DiscreteTopology Q]
    (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : presKernel gen ≤ relFrattini 2 ⊤)
    {φ : Z1 ↥(presKernel gen) (ZMod 2)} (hφ : IsConjInvariant gen φ)
    (h0 : tgClass gen hgen φ hφ = 0) : φ = 0 := by
  have hz : (⟨tgCochainOf gen hgen φ, mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen hφ)⟩ :
      Z2 Q (ZMod 2)) ∈ B2' Q (ZMod 2) := by
    rw [← H2.mk_eq_zero_iff]
    exact h0
  rw [mem_B2', mem_B2] at hz
  obtain ⟨w, hw⟩ := hz
  have hw' : ∀ y₁ y₂ : Q, tgFun (presExt gen) (presSection gen hgen)
      (presSection_spec gen hgen) (φ : ↥(presKernel gen) → ZMod 2) (y₁, y₂)
      = d1Fun (w : Q → ZMod 2) (y₁, y₂) := by
    intro y₁ y₂
    have h := congrFun (congrArg (fun c : Cochain2 Q (ZMod 2) => (c : Q × Q → ZMod 2)) hw)
      (y₁, y₂)
    simp only [d1Hom_apply, tgCochainOf, tgCochain_coe] at h
    exact h.symm
  obtain ⟨z, hz⟩ := exists_Z1_restrict_of_tg_eq_coboundary (presExt gen)
    continuous_of_discreteTopology (presSection gen hgen) (presSection_spec gen hgen)
    continuous_of_discreteTopology continuous_of_discreteTopology φ hφ w hw'
  have hzero : ∀ n : ↥(presKernel gen), (φ : ↥(presKernel gen) → ZMod 2) n = 0 := by
    intro n
    rw [← hz n]
    exact relFrattini_two_top_le_Z1ker z (hmin n.2)
  ext n
  exact hzero n

theorem tgClass_injective {α Q : Type*} [Group Q] [TopologicalSpace Q] [IsTopologicalGroup Q]
    [TopologicalSpace (FreeGroup α)] [DiscreteTopology (FreeGroup α)] [DiscreteTopology Q]
    (gen : α → Q) (hgen : Subgroup.closure (Set.range gen) = ⊤)
    (hmin : Work.HopfGaschutz.presKernel gen ≤ Work.HopfGaschutz.relFrattini 2 ⊤) :
    Function.Injective (fun φ : {φ : Work.ConCohomology.Z1 ↥(Work.HopfGaschutz.presKernel gen) (ZMod 2) //
        Work.HopfGaschutz.IsConjInvariant gen φ} =>
      Work.HopfGaschutz.tgClass gen hgen φ.1 φ.2) := by
  intro a b hab
  have hsub : IsConjInvariant gen (a.1 - b.1) := by
    intro g n
    show (a.1 : ↥(presKernel gen) → ZMod 2) ((presExt gen).conj g n)
        - (b.1 : ↥(presKernel gen) → ZMod 2) ((presExt gen).conj g n)
      = (a.1 : ↥(presKernel gen) → ZMod 2) n - (b.1 : ↥(presKernel gen) → ZMod 2) n
    rw [a.2 g n, b.2 g n]
  have hmem : (⟨tgCochainOf gen hgen a.1, mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen a.2)⟩ :
        Z2 Q (ZMod 2))
      - ⟨tgCochainOf gen hgen b.1, mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen b.2)⟩
      ∈ B2' Q (ZMod 2) := by
    rw [← H2.mk_eq_mk_iff]
    exact hab
  have heq : (⟨tgCochainOf gen hgen (a.1 - b.1),
        mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen hsub)⟩ : Z2 Q (ZMod 2))
      = (⟨tgCochainOf gen hgen a.1, mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen a.2)⟩ :
          Z2 Q (ZMod 2))
        - ⟨tgCochainOf gen hgen b.1, mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen b.2)⟩ := by
    apply Subtype.ext
    ext p
    obtain ⟨y1, y2⟩ := p
    simp only [tgCochainOf, tgCochain_coe, tgFun, AddSubgroup.coe_sub, LocallyConstant.coe_sub,
      Pi.sub_apply]
  have h0 : tgClass gen hgen (a.1 - b.1) hsub = 0 := by
    have h1 : tgClass gen hgen (a.1 - b.1) hsub
        = H2.mk (⟨tgCochainOf gen hgen (a.1 - b.1),
            mem_Z2.mpr (isCocycle2_tgCochainOf gen hgen hsub)⟩ : Z2 Q (ZMod 2)) := rfl
    rw [h1, H2.mk_eq_zero_iff, heq]
    exact hmem
  have hz := tgClass_eq_zero gen hgen hmin hsub h0
  exact Subtype.ext (sub_eq_zero.mp hz)

end Work.HopfGaschutz
