import Mathlib

/-!
# A field of degree two over `ℚ` is generated by a square root of a rational number

**Namespace** `Work.TameArithmetic`.

Let `L` be a field with a `ℚ`-algebra structure which is two-dimensional over `ℚ`.  Then there is
a *nonzero* rational number `D` and an element `x ∈ L` with `x * x = algebraMap ℚ L D` whose
`ℚ`-adjoin is all of `L`.

This is the abstract-field form of the classical fact that every quadratic field is `ℚ(√d)`
(`d` squarefree): choosing `x₀ ∉ ℚ`, the three elements `1, x₀, x₀ ^ 2` are `ℚ`-linearly
dependent, so that `x₀ ^ 2 = a + b * x₀` with `a, b ∈ ℚ`; then `z = 2 * x₀ - b` is still
irrational and satisfies `z ^ 2 = 4 * a + b ^ 2 ∈ ℚ`, and the dimension count shows that
`ℚ(z) = ℚ(x₀) = L`.

The proof follows the sibling chapter `Work.QuadraticFields`
(`Work.QuadraticFields.exists_squarefree_sq_eq_of_finrank_eq_two`), but is phrased for an
arbitrary field `L` carrying a *local* `Algebra ℚ L` instance rather than for a `NumberField`:
for a `NumberField` the `ℚ`-algebra structure is the global `DivisionRing.toRatAlgebra` one, so
that the corresponding `Module.finrank` hypothesis is *not* interchangeable with the one coming
from an arbitrary `Algebra ℚ L` instance (the two module structures are only propositionally
equal).  Squarefree-ness of the rational number is not needed here.
-/

set_option autoImplicit false

namespace Work.TameArithmetic

section

variable {L : Type} [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L]

/-- In a two-dimensional `ℚ`-algebra which is a field there is an element which is not "rational",
i.e. which does not lie in the range of `algebraMap ℚ L`. -/
lemma notMem_range_algebraMap_of_finrank_eq_two (h : Module.finrank ℚ L = 2) :
    ∃ x : L, x ∉ Set.range (algebraMap ℚ L) := by
  have hinj : Function.Injective (Algebra.linearMap ℚ L) := fun a b hab =>
    FaithfulSMul.algebraMap_injective ℚ L (by simpa [Algebra.linearMap_apply] using hab)
  have hfr : Module.finrank ℚ (LinearMap.range (Algebra.linearMap ℚ L)) = 1 := by
    rw [LinearMap.finrank_range_of_inj hinj, Module.finrank_self]
  have hne : LinearMap.range (Algebra.linearMap ℚ L) ≠ ⊤ := by
    intro htop
    rw [htop, finrank_top] at hfr
    omega
  obtain ⟨x, -, hx⟩ := SetLike.exists_of_lt (lt_of_le_of_ne le_top hne)
  refine ⟨x, fun hxr => hx ?_⟩
  rw [LinearMap.mem_range]
  exact hxr

/-- `1` and an irrational element of a quadratic field are linearly independent. -/
lemma linearIndependent_one_self_of_notMem_range {x : L}
    (hx : x ∉ Set.range (algebraMap ℚ L)) : LinearIndependent ℚ ![1, x] := by
  rw [linearIndependent_fin2]
  constructor
  · show x ≠ 0
    intro hx0
    exact hx ⟨0, by rw [hx0, map_zero]⟩
  · intro a ha
    have ha' : algebraMap ℚ L a * x = 1 := by
      rw [Algebra.smul_def] at ha
      simpa using ha
    by_cases ha0 : a = 0
    · rw [ha0, map_zero, zero_mul] at ha'
      exact zero_ne_one ha'
    · have hane : algebraMap ℚ L a ≠ 0 := fun h0 =>
        ha0 (FaithfulSMul.algebraMap_injective ℚ L (h0.trans (map_zero _).symm))
      have hxinv : x = algebraMap ℚ L a⁻¹ := by
        calc x = (algebraMap ℚ L a)⁻¹ * (algebraMap ℚ L a * x) := by
              rw [← mul_assoc, inv_mul_cancel₀ hane, one_mul]
          _ = (algebraMap ℚ L a)⁻¹ * 1 := by rw [ha']
          _ = algebraMap ℚ L a⁻¹ := by rw [mul_one, map_inv₀]
      exact hx ⟨a⁻¹, hxinv.symm⟩

/-- In a quadratic field, an irrational element has a rational square up to a translation: if
`x ^ 2 = a + b * x` with `a, b ∈ ℚ` then `z = 2 * x - b` is irrational and `z ^ 2 = 4 * a + b ^ 2`
is rational. -/
lemma exists_sq_mem_range_of_notMem_range (h : Module.finrank ℚ L = 2) {x : L}
    (hx : x ∉ Set.range (algebraMap ℚ L)) :
    ∃ z : L, z ∉ Set.range (algebraMap ℚ L) ∧ ∃ q : ℚ, z ^ 2 = algebraMap ℚ L q := by
  have hv : LinearIndependent ℚ ![1, x] := linearIndependent_one_self_of_notMem_range hx
  have hspan_top : Submodule.span ℚ (Set.range ![1, x] : Set L) = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [h, finrank_span_eq_card hv, Fintype.card_fin]
  have hx2 : x ^ 2 ∈ Submodule.span ℚ (Set.range ![1, x] : Set L) := by
    rw [hspan_top]; exact Submodule.mem_top
  have hrange : (Set.range ![1, x] : Set L) = ({1, x} : Set L) := by
    rw [Matrix.range_cons, Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.insert_eq]
  rw [hrange] at hx2
  obtain ⟨a, b, hab⟩ := Submodule.mem_span_pair.mp hx2
  have hrel : x ^ 2 = algebraMap ℚ L a + algebraMap ℚ L b * x := by
    rw [Algebra.smul_def, mul_one, Algebra.smul_def] at hab
    exact hab.symm
  refine ⟨2 * x - algebraMap ℚ L b, ?_, 4 * a + b ^ 2, ?_⟩
  · intro hzr
    obtain ⟨c, hc⟩ := hzr
    have h2x : (2 : L) * x = algebraMap ℚ L (c + b) := by
      rw [map_add, hc]
      ring
    have h2y : (2 : L) * algebraMap ℚ L ((c + b) / 2) = algebraMap ℚ L (c + b) := by
      rw [show (2 : L) = algebraMap ℚ L (2 : ℚ) by simp, ← map_mul]
      congr 1
      ring
    have h2ne : (2 : L) ≠ 0 := by
      rw [show (2 : L) = algebraMap ℚ L (2 : ℚ) by simp]
      intro h0
      have h1 : (2 : ℚ) = 0 := FaithfulSMul.algebraMap_injective ℚ L (h0.trans (map_zero _).symm)
      norm_num at h1
    have hxc : x = algebraMap ℚ L ((c + b) / 2) := mul_left_cancel₀ h2ne (h2x.trans h2y.symm)
    exact hx ⟨(c + b) / 2, hxc.symm⟩
  · have hq : algebraMap ℚ L (4 * a + b ^ 2) =
        4 * algebraMap ℚ L a + (algebraMap ℚ L b) ^ 2 := by
      rw [map_add, map_mul, map_pow, map_ofNat]
    have h4 : (2 * x - algebraMap ℚ L b) ^ 2 =
        4 * x ^ 2 - 4 * x * algebraMap ℚ L b + (algebraMap ℚ L b) ^ 2 := by ring
    rw [hq, h4, hrel]
    ring

/-- An irrational element of a quadratic field generates it. -/
lemma adjoin_eq_top_of_notMem_range (h : Module.finrank ℚ L = 2) {x : L}
    (hx : x ∉ Set.range (algebraMap ℚ L)) : Algebra.adjoin ℚ ({x} : Set L) = ⊤ := by
  have hv : LinearIndependent ℚ ![1, x] := linearIndependent_one_self_of_notMem_range hx
  have hspan : Module.finrank ℚ (Submodule.span ℚ (Set.range ![1, x] : Set L)) = 2 := by
    rw [finrank_span_eq_card hv, Fintype.card_fin]
  have hle : Submodule.span ℚ (Set.range ![1, x] : Set L) ≤
      (Algebra.adjoin ℚ ({x} : Set L)).toSubmodule := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    fin_cases i
    · change (1 : L) ∈ Algebra.adjoin ℚ ({x} : Set L)
      exact one_mem _
    · change x ∈ Algebra.adjoin ℚ ({x} : Set L)
      exact Algebra.self_mem_adjoin_singleton ℚ x
  have hfin : Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set L)).toSubmodule = 2 := by
    have h1 : Module.finrank ℚ ↥(Submodule.span ℚ (Set.range ![1, x] : Set L)) ≤
        Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set L)).toSubmodule :=
      Submodule.finrank_mono hle
    have h2 : Module.finrank ℚ ↥(Algebra.adjoin ℚ ({x} : Set L)).toSubmodule ≤
        Module.finrank ℚ L := Submodule.finrank_le _
    rw [hspan] at h1
    rw [h] at h2
    omega
  rw [← Algebra.toSubmodule_eq_top]
  exact Submodule.eq_top_of_finrank_eq (by rw [h]; exact hfin)

end

/-- **A field of degree `2` over `ℚ` is generated by a square root of a nonzero rational number.**
There are `D : ℚ` with `D ≠ 0` and `x : L` with `x * x = algebraMap ℚ L D` and
`Algebra.adjoin ℚ {x} = ⊤`. -/
theorem exists_sqrt_of_finrank_two {L : Type} [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L]
    (hfr : Module.finrank ℚ L = 2) :
    ∃ D : ℚ, D ≠ 0 ∧ ∃ x : L, x * x = algebraMap ℚ L D ∧ Algebra.adjoin ℚ ({x} : Set L) = ⊤ := by
  obtain ⟨x₀, hx₀⟩ := notMem_range_algebraMap_of_finrank_eq_two hfr
  obtain ⟨z, hz, q, hzq⟩ := exists_sq_mem_range_of_notMem_range hfr hx₀
  -- `q` is nonzero, since `z` is irrational whereas `0` is rational
  have hq0 : q ≠ 0 := by
    intro hq0
    refine hz ⟨0, ?_⟩
    have hzsq : z ^ 2 = (0 : L) := by rw [hzq, hq0, map_zero]
    rw [map_zero]
    exact (sq_eq_zero_iff.mp hzsq).symm
  refine ⟨q, hq0, z, ?_, adjoin_eq_top_of_notMem_range hfr hz⟩
  rw [pow_two] at hzq
  exact hzq

end Work.TameArithmetic
