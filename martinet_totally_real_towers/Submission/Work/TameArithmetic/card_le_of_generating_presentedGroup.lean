import Mathlib
import Submission.Work.TameArithmetic.Defs
import Submission.Commons.NumberTheory.NumberField.exists_multiquadratic_totallyReal_unramifiedOutside
import Submission.Work.ProPDeficiency.le_dGens_of_surjective_zmod_pow
import Submission.Work.ShafarevichKoch.exists_quotient_of_finite_unramified

/-!
# The generator count `d ≥ 5` of a pro-`2` presentation of `Γ = Gal(K/ℚ)`

**Module** `Submission.Work.TameArithmetic.card_le_of_generating_presentedGroup`.

The lemma proved here is the numerical input `d ≥ |S|` of the tame Golod--Shafarevich route:
if `K` is the maximal pro-`2` extension of `ℚ` unramified outside `S = primesS` and at the
infinite places (`IsMaximalTamePro2 K`), and `P : TamePro2Presentation K` is a pro-`2`
presentation of `Γ = Gal(K/ℚ)` by five generators and at most six relators, then the abstract
group `presentedGroup P` needs at least `5` generators: every `Finset` of `presentedGroup P`
whose generated subgroup is everything has at least `5` elements.

## The argument

* The multiquadratic field `ℚ(√q : q ∈ S)` is a finite Galois pro-`2` extension of `ℚ`, totally
  real, and its relative different is supported over `S` (commons chapter
  `Commons.NumberTheory.NumberField.exists_multiquadratic_totallyReal_unramifiedOutside`).
  By the universal property `TameUnivClause` of `K` it embeds into `K`, say `φ : ℚ(√q) →ₐ[ℚ] K`;
  its image `E = φ.fieldRange` is a finite Galois intermediate field.
* Restriction of automorphisms gives a surjection `ψ : Γ →* Gal(ℚ(√q)/ℚ)`
  (`AlgEquiv.restrictNormalHom_surjective`), and `Gal(ℚ(√q)/ℚ) ≃ (ℤ/2)^{#S}`
  (`mqField_galoisGroup`).  Composing, `Γ ↠ (ℤ/2)^{#S}`.
* The subgroup `H` of `Γ` generated by the images `P.gen i` of the five free generators is dense
  by `P.dense`; the kernel of `Γ ↠ (ℤ/2)^{#S}` contains `E.fixingSubgroup`, which is *open* in
  the Krull topology because `E/ℚ` is finite.  A dense subgroup meets every coset of an open
  subgroup, so `H` already maps onto `(ℤ/2)^{#S}`
  (`Work.ShafarevichKoch.map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker`).
* Hence `FreeGroup (Fin 5) →* (ℤ/2)^{#S}`, `x_i ↦ ψ (gen i)`, is onto, and its kernel contains
  `ker (FreeGroup.lift P.gen) = ⟪rel⟫` (`P.ker_eq`); so it factors through `presentedGroup P`,
  which therefore also maps onto `(ℤ/2)^{#S}`.
* Finally `(ℤ/2)^n` cannot be generated by fewer than `n` elements
  (`Work.ProPDeficiency.card_le_of_closure_eq_top_pi`), so any generating finset of
  `presentedGroup P` has at least `#S = 5` elements.

Everything except the arithmetic of the multiquadratic field (which is a commons lemma) is
elementary group theory and profinite-Galois bookkeeping.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped Classical

namespace Work.TameArithmetic

open Commons.NumberTheory.NumberField

/-- `Multiplicative (Fin n → ZMod 2)`, the elementary abelian `2`-group of rank `n` in its
pointwise-additive presentation, is a `2`-group. -/
lemma isPGroup_two_multiplicative_fin_zmod_two (n : ℕ) :
    IsPGroup 2 (Multiplicative (Fin n → ZMod 2)) :=
  IsPGroup.of_card (by
    rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, Fintype.card_fun,
      Fintype.card_fin, ZMod.card])

/-- **`ℚ(√q : q ∈ S)` is a pro-`2` extension of `ℚ`** for `S` a finite set of primes: its
Galois group is `(ℤ/2)^{#S}` (`mqField_galoisGroup`). -/
lemma isPGroup_two_aut_mqField (S : Finset ℕ) (hS : ∀ q ∈ S, Nat.Prime q) :
    IsPGroup 2 (↥(mqField S) ≃ₐ[ℚ] ↥(mqField S)) := by
  obtain ⟨e⟩ := mqField_galoisGroup S hS
  exact (isPGroup_two_multiplicative_fin_zmod_two S.card).of_equiv e.symm

/-- **A totally real number field is unramified at the infinite places over `ℚ`.** -/
lemma isUnramifiedAtInfinitePlaces_rat_of_isTotallyReal (L : Type) [Field L] [NumberField L]
    [Algebra ℚ L] (h : NumberField.IsTotallyReal L) : IsUnramifiedAtInfinitePlaces ℚ L :=
  Commons.NumberTheory.NumberField.isUnramifiedAtInfinitePlaces_of_forall_comap_isReal ℚ L
    (fun _ _ w' _ => h.isReal w')

/-- **The abstract group presented by `P` maps onto `(ℤ/2)^{#S}`.**

`K` is a maximal tame pro-`2` extension of `ℚ` (for `S = primesS`) and `P` a pro-`2` presentation
of `Γ = Gal(K/ℚ)` whose generators are dense.  Then the quotient
`presentedGroup P = FreeGroup (Fin 5) ⧸ ⟪rel⟫` (which maps isomorphically onto the dense subgroup
of `Γ` generated by `P.gen`) has a surjection onto the elementary abelian `2`-group of rank
`#primesS`. -/
lemma exists_surjective_presentedGroup_zmodTwo_pow {K : Type} [Field K] [Algebra ℚ K]
    [IsGalois ℚ K] (hmax : IsMaximalTamePro2 K) (P : TamePro2Presentation K) :
    ∃ f : presentedGroup P →* (Fin primesS.card → Multiplicative (ZMod 2)),
      Function.Surjective f := by
  classical
  haveI hfdM : FiniteDimensional ℚ ↥(mqField primesS) := mqField_finiteDimensional primesS
  -- the multiquadratic field embeds into `K` by the universal property of `K`
  obtain ⟨φ, -⟩ := hmax.2.1 ↥(mqField primesS) (isPGroup_two_aut_mqField primesS primesS_prime)
    (mqField_different_supp primesS primesS_prime primesS_mod_eight)
    (isUnramifiedAtInfinitePlaces_rat_of_isTotallyReal _ (mqField_isTotallyReal primesS))
  let E : IntermediateField ℚ K := φ.fieldRange
  letI hEalg : Algebra ℚ ↥E := E.algebra'
  haveI hEnorm : Normal ℚ ↥E := (IsGalois.of_algEquiv φ.equivFieldRange).to_normal
  haveI hEfd : FiniteDimensional ℚ ↥E := φ.equivFieldRange.toLinearEquiv.finiteDimensional
  -- `Gal(ℚ(√q)/ℚ) ≃ (ℤ/2)^{#S}`
  obtain ⟨e⟩ := mqField_galoisGroup primesS primesS_prime
  -- restriction of automorphisms of `K` to `E`, transported along `φ`
  let ψ : (K ≃ₐ[ℚ] K) →* (↥(mqField primesS) ≃ₐ[ℚ] ↥(mqField primesS)) :=
    (AlgEquiv.autCongr (φ.equivFieldRange).symm).toMonoidHom.comp (AlgEquiv.restrictNormalHom ↥E)
  have hψ : Function.Surjective ψ := by
    intro y
    obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective (F := ℚ) (K₁ := ↥E) K
      ((AlgEquiv.autCongr (φ.equivFieldRange).symm).symm y)
    exact ⟨σ, by
      show (AlgEquiv.autCongr (φ.equivFieldRange).symm) ((AlgEquiv.restrictNormalHom ↥E) σ) = y
      rw [hσ]
      exact (AlgEquiv.autCongr (φ.equivFieldRange).symm).apply_symm_apply y⟩
  -- the composite `Γ →* (ℤ/2)^{#S}`
  let f : (K ≃ₐ[ℚ] K) →* (Fin primesS.card → Multiplicative (ZMod 2)) :=
    (Work.ProPDeficiency.piMulEquiv primesS.card 2).symm.toMonoidHom.comp (e.toMonoidHom.comp ψ)
  have hf : Function.Surjective f :=
    (Work.ProPDeficiency.piMulEquiv primesS.card 2).symm.surjective.comp (e.surjective.comp hψ)
  -- its kernel contains the open subgroup `E.fixingSubgroup`
  have hker : (E.fixingSubgroup : Subgroup (K ≃ₐ[ℚ] K)) ≤ MonoidHom.ker f := by
    intro u hu
    rw [MonoidHom.mem_ker]
    have h1 : (AlgEquiv.restrictNormalHom ↥E) u = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker E]
      exact hu
    have h2 : ψ u = 1 := by
      rw [show ψ u = (AlgEquiv.autCongr (φ.equivFieldRange).symm)
        ((AlgEquiv.restrictNormalHom ↥E) u) from rfl, h1, map_one]
    simp only [f, MonoidHom.comp_apply, h2, map_one]
  -- density: the subgroup generated by the `gen i` already maps onto the target
  have hHmap : (Subgroup.closure (Set.range P.gen)).map f = ⊤ :=
    Work.ShafarevichKoch.map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker f hf P.dense
      (IntermediateField.fixingSubgroup_isOpen E) hker
  -- hence `FreeGroup (Fin 5) →* (ℤ/2)^{#S}`, `x_i ↦ f (gen i)`, is onto
  let Φ : FreeGroup (Fin 5) →* (Fin primesS.card → Multiplicative (ZMod 2)) :=
    f.comp (FreeGroup.lift P.gen)
  have hΦ : Function.Surjective Φ := by
    intro y
    have hy : y ∈ (Subgroup.closure (Set.range P.gen)).map f := by rw [hHmap]; trivial
    obtain ⟨x, hx, hxy⟩ := hy
    have hx' : x ∈ (FreeGroup.lift P.gen).range := by
      rw [FreeGroup.range_lift_eq_closure]
      exact hx
    obtain ⟨w, rfl⟩ := hx'
    exact ⟨w, hxy⟩
  -- it kills the relators, so it descends to the presented group
  have hle : Subgroup.normalClosure (P.rel : Set (FreeGroup (Fin 5))) ≤ MonoidHom.ker Φ := by
    rw [← P.ker_eq]
    intro x hx
    rw [MonoidHom.mem_ker] at hx ⊢
    rw [MonoidHom.comp_apply, hx, map_one]
  refine ⟨QuotientGroup.lift (Subgroup.normalClosure (P.rel : Set (FreeGroup (Fin 5)))) Φ hle,
    ?_⟩
  intro y
  obtain ⟨w, hw⟩ := hΦ y
  refine ⟨QuotientGroup.mk' _ w, ?_⟩
  simpa using hw

theorem card_le_of_generating_presentedGroup {K : Type} [Field K] [Algebra ℚ K] [IsGalois ℚ K]
    (hmax : Work.TameArithmetic.IsMaximalTamePro2 K)
    (P : Work.TameArithmetic.TamePro2Presentation K) :
    ∀ S : Finset (Work.TameArithmetic.presentedGroup P),
      Subgroup.closure (S : Set (Work.TameArithmetic.presentedGroup P)) = ⊤ → 5 ≤ S.card := by
  intro S hS
  obtain ⟨f, hf⟩ := exists_surjective_presentedGroup_zmodTwo_pow hmax P
  have himg : Subgroup.closure
      ((S.image f : Finset (Fin primesS.card → Multiplicative (ZMod 2))) :
        Set (Fin primesS.card → Multiplicative (ZMod 2))) = ⊤ := by
    rw [Finset.coe_image, ← MonoidHom.map_closure f (S : Set (presentedGroup P)), hS,
      Subgroup.map_top_of_surjective f hf]
  have h1 : primesS.card ≤ (S.image f).card :=
    Work.ProPDeficiency.card_le_of_closure_eq_top_pi _ himg
  have h2 : (S.image f).card ≤ S.card := Finset.card_image_le
  calc 5 = primesS.card := primesS_card.symm
    _ ≤ (S.image f).card := h1
    _ ≤ S.card := h2

end Work.TameArithmetic
