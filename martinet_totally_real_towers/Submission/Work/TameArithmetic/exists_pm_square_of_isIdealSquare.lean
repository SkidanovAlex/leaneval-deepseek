import Mathlib
import Submission.Work.TameArithmetic.VSDefs

/-!
# `Work.TameArithmetic.exists_pm_square_of_isIdealSquare`

Over `ℚ` the fractional ideals are principal (indeed `ℤ` is a principal ideal domain, so every
fractional ideal of `ℤ` in `ℚ = Frac ℤ` is generated by a single element), and the units of `ℤ`
are `{±1}`.  Hence an element `x ∈ ℚˣ` whose principal ideal `(x)` is the square of a fractional
ideal is `±y²` for some `y ∈ ℚˣ`.

This is the elementary first half of the computation of Koch's group
`V_S = {x ∈ ℚˣ : (x) = I², x ∈ ℚ_q^{×2} ∀ q ∈ S}`: it shows that the "ideal square" condition
alone only allows the sign ambiguity `±`, so that `V_S = {±1} · (ℚˣ)²` as soon as the local
conditions at the primes of `S` are satisfied by `-1` as well.

## The argument

Given `I` with `I * I = toPrincipalIdeal ℤ ℚ x`:
* `I` is principal, `I = spanSingleton a` with `a ∈ ℚ` (`FractionalIdeal.isPrincipal`, a PID
  instance), so `I * I = spanSingleton (a * a)`;
* `spanSingleton (a * a) = spanSingleton x` as fractional ideals, so
  `spanSingleton_eq_spanSingleton` produces `z ∈ ℤˣ` with `z • (a * a) = x`;
* `z = ±1` (`Int.units_eq_one_or`), whence `x = a * a` or `x = - (a * a)`;
* `x ≠ 0` forces `a ≠ 0`, so `a` is a unit of `ℚ`.
-/

set_option autoImplicit false

open scoped Classical

namespace Work.TameArithmetic

theorem exists_pm_square_of_isIdealSquare {x : ℚˣ} (h : Work.TameArithmetic.IsIdealSquare x) :
    ∃ y : ℚˣ, x = y * y ∨ x = - (y * y) := by
  obtain ⟨I, hI⟩ := h
  set J : FractionalIdeal (nonZeroDivisors ℤ) ℚ := I.val with hJ
  have hIpr : (J : Submodule ℤ ℚ).IsPrincipal := FractionalIdeal.isPrincipal J
  obtain ⟨a, ha⟩ := (FractionalIdeal.isPrincipal_iff (S := nonZeroDivisors ℤ) J).1 hIpr
  have hval : (J * J : FractionalIdeal (nonZeroDivisors ℤ) ℚ)
      = FractionalIdeal.spanSingleton (nonZeroDivisors ℤ) (x : ℚ) := by
    have h1 : (I * I).val = (toPrincipalIdeal ℤ ℚ x).val := congrArg Units.val hI
    simp only [Units.val_mul, coe_toPrincipalIdeal] at h1
    rw [← hJ] at h1
    exact h1
  have hsq : FractionalIdeal.spanSingleton (nonZeroDivisors ℤ) (a * a)
      = FractionalIdeal.spanSingleton (nonZeroDivisors ℤ) ((x : ℚ)) := by
    rw [← hval, ha, FractionalIdeal.spanSingleton_mul_spanSingleton]
  obtain ⟨z, hz⟩ := (FractionalIdeal.spanSingleton_eq_spanSingleton
      (S := nonZeroDivisors ℤ) (x := a * a) (y := (x : ℚ))).1 hsq
  have hazero : a ≠ 0 := by
    intro h0
    rw [h0, mul_zero, smul_zero] at hz
    exact x.ne_zero hz.symm
  refine ⟨Units.mk0 a hazero, ?_⟩
  rcases Int.units_eq_one_or z with hz1 | hzm1
  · left
    rw [hz1, one_smul] at hz
    exact Units.ext (by simp [Units.val_mk0, ← hz])
  · right
    rw [hzm1] at hz
    exact Units.ext (by simp [Units.val_mk0, ← hz])

end Work.TameArithmetic

