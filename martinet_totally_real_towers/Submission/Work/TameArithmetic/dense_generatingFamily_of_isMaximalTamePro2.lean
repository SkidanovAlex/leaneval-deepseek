import Mathlib
import Submission.Work.TameArithmetic.All
import Submission.Work.ShafarevichKoch.nonempty_proTwoCharEquiv_option_quadraticLevel

/-!
# The generator half of the tame presentation datum: `d(Γ) = 5`

`Work.TameArithmetic.dense_generatingFamily_of_isMaximalTamePro2`: for the maximal tame pro-`2`
extension `K` of `ℚ` (`S = primesS = {17,41,73,89,97}`,
`Work.TameArithmetic.IsMaximalTamePro2 K`) the Galois group `Γ = Gal(K/ℚ)` is topologically
generated by five elements.

This is the `GeneratorHalf K` of `Submission/NumberField/TamePresentationDatum.lean`, the
*elementary* half of the pro-`2` presentation datum of `Work.TameArithmetic.TameRelationBound`.

## The argument

Write `Γ = K ≃ₐ[ℚ] K` with the Krull topology, `S = primesS`.

* **Counting the quadratic levels.**  An intermediate field `E ≤ K` with
  `E.fixingSubgroup.index = 2` is a *quadratic level*.  By `IsMaximalTamePro2.2.2`
  (`TameSubClause`) the finite Galois level `↥E` is a totally real, `S`-tame quadratic number
  field, so the elementary classification `Work.TameArithmetic.quadratic_tame_classification`
  applies: `E = ℚ(√d)` for a positive squarefree `d ≡ 1 (mod 4)`, `d ≠ 1`, all of whose prime
  divisors lie in `S`.  Since a squarefree positive integer is determined by its set of prime
  divisors (`Nat.Squarefree.ext_iff`), and the subfield of `K` generated by a square root of `d`
  is determined by `d` (the two square roots of `d` are `±x`), the number of quadratic levels is
  at most the number of nonempty subsets of the five-element set `S`, i.e. `2 ^ 5 - 1 = 31`.
* **The character group.**  The continuous characters `Γ → 𝔽₂` are the quadratic levels plus the
  trivial character (kernel and fixed field are mutually inverse), so there are at most `32` of
  them.
* **The Frattini-type subgroup.**  Let `Φ = ⋂ {E.fixingSubgroup : E a quadratic level}`; it is
  open (there are finitely many levels), hence `Γ ⧸ Φ` is a finite abelian group of exponent `2`,
  i.e. a finite `2`-group.  Every character of `Γ` kills `Φ`, so
  `Hom(Γ ⧸ Φ, 𝔽₂) = Hom(Γ, 𝔽₂)` has at most `32` elements, and Burnside's basis theorem
  (`Work.ProPDeficiency.dGens_eq_pHomDim_of_isPGroup`) gives `dGens (Γ ⧸ Φ) ≤ log₂ 32 = 5`.
* **Lifting.**  Choose five elements of `Γ` lifting generators of `Γ ⧸ Φ`, and let `H` be the
  closed subgroup they generate.  Then `H · Φ = Γ`.  If `H` were proper, the pro-`2` Frattini
  argument (`exists_isOpen_index_two_le_of_isClosed`: every proper closed subgroup of `Γ` lies in
  an open subgroup of index `2`, proved by descending to a finite Galois level and using that its
  Galois group is a finite `2`-group) would produce an open index-`2` subgroup `M ≥ H`; every
  open index-`2` subgroup contains `Φ` (it is `E.fixingSubgroup` for the quadratic level
  `E = fixedField M`), so `Γ = H·Φ ≤ M ≠ Γ`, a contradiction.  Hence `H = Γ`.

## Main declarations

* `Work.TameArithmetic.IsQuadLevel`, `Work.TameArithmetic.QuadLevel` -- the quadratic levels;
* `Work.TameArithmetic.HasSqrtRoot` -- `E = ℚ(√d)` inside `K`;
* `Work.TameArithmetic.quadLevel_classification` -- the classification of quadratic levels;
* `Work.TameArithmetic.card_quadLevel_le` -- at most `31` quadratic levels;
* `Work.TameArithmetic.TameChar`, `Work.TameArithmetic.card_tameChar_le` -- at most `32`
  continuous characters;
* `Work.TameArithmetic.dense_generatingFamily_of_isMaximalTamePro2` -- the target.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1600000

open scoped Classical
open scoped NumberField
open NumberField

namespace Work.TameArithmetic

noncomputable section

open Work.ProPDeficiency

variable {K : Type} [Field K] [Algebra ℚ K] [IsGalois ℚ K]

/-! ## 1. Finiteness of a type from a nonzero cardinality -/

/-- A type with nonzero `Nat.card` is finite (classical logic: `Nat.card` vanishes exactly on
empty or infinite types). -/
theorem finite_of_natCard_ne_zero {α : Type*} (h : Nat.card α ≠ 0) : Finite α := by
  by_contra hfin
  exact h (Nat.card_eq_zero.mpr (Or.inr (not_finite_iff_infinite.mp hfin)))

/-! ## 2. Counting the quadratic levels

A *quadratic level* is an intermediate field of `K` whose fixing subgroup has index `2`; as the
subgroups of index `2` are exactly the fixing subgroups of the quadratic levels, this is the same
as "a quadratic subextension of `K/ℚ`".  The index is used (rather than `finrank`) because it is
free of the `ℚ`-algebra instance ambiguity of an intermediate field. -/

/-- **A quadratic level of `K/ℚ`**: an intermediate field whose fixing subgroup has index `2`.
(For a finite-dimensional intermediate field this is the same as `finrank ℚ E = 2`, by
`IntermediateField.finrank_eq_fixingSubgroup_index`.) -/
abbrev IsQuadLevel (E : IntermediateField ℚ K) : Prop := E.fixingSubgroup.index = 2

/-- The type of quadratic levels of `K/ℚ`. -/
abbrev QuadLevel (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K] : Type :=
  {E : IntermediateField ℚ K // IsQuadLevel E}

/-- **`E` is generated over `ℚ` by a square root of `d`**, inside `K`: there is `x ∈ K` with
`x * x = d` and `E = ℚ⟮x⟯`. -/
def HasSqrtRoot (E : IntermediateField ℚ K) (d : ℤ) : Prop :=
  ∃ x : K, x * x = algebraMap ℚ K (d : ℚ) ∧ E = IntermediateField.adjoin ℚ ({x} : Set K)

/-- The classification shape of the possible `d`: positive, squarefree, `≡ 1 (mod 4)`, not `1`,
with all prime divisors in `primesS`. -/
def IsSqrtRootDiscr (d : ℤ) : Prop :=
  0 < d ∧ Squarefree d ∧ d % 4 = 1 ∧ d ≠ 1 ∧
    ∀ p : ℕ, Nat.Prime p → (p : ℤ) ∣ d → p ∈ primesS

/-- **A quadratic level is `ℚ(√d)` for a suitable `d`.**  This is
`Work.TameArithmetic.quadratic_tame_classification` (the elementary classification of the `S`-tame
totally real quadratic fields) applied to the level `↥E`; the classification is stated for an
abstract field, so the `ℚ`-algebra structure of `↥E` is pinned to `IntermediateField.algebra'`,
the structure for which `E.finiteDimensional`/`E.isGalois` are stated. -/
theorem quadLevel_classification (hK : IsMaximalTamePro2 K) {E : IntermediateField ℚ K}
    (hE : IsQuadLevel E) : ∃ d : ℤ, IsSqrtRootDiscr d ∧ HasSqrtRoot E d := by
  have hnebot : E ≠ ⊥ := by
    intro h
    have h1 : E.fixingSubgroup = ⊤ := by rw [h, IntermediateField.fixingSubgroup_bot]
    have h2 : E.fixingSubgroup.index = 2 := hE
    rw [h1, Subgroup.index_top] at h2
    omega
  letI : Algebra ℚ ↥E := E.algebra'
  have hnorm : E.fixingSubgroup.Normal := Subgroup.normal_of_index_eq_two hE
  haveI : IsGalois ℚ ↥E := (InfiniteGalois.normal_iff_isGalois E).mp hnorm
  have hfr : Module.finrank ℚ ↥E = 2 := by
    rw [IntermediateField.finrank_eq_fixingSubgroup_index K E, hE]
  haveI : FiniteDimensional ℚ ↥E := Module.finite_of_finrank_pos (by rw [hfr]; norm_num)
  haveI : NumberField ↥E := NumberField.of_module_finite ℚ ↥E
  obtain ⟨_, hsupp, hunr⟩ := hK.2.2 ↥E (IntermediateField.val E) (fun a b hh => Subtype.ext hh)
  haveI : IsUnramifiedAtInfinitePlaces ℚ ↥E := hunr
  have htr : NumberField.IsTotallyReal ↥E :=
    Commons.NumberTheory.NumberField.isTotallyReal_of_isUnramifiedAtInfinitePlaces ℚ ↥E
  obtain ⟨d, hdpos, hdsq, hd4, hdpr, x, hx, hgen⟩ :=
    quadratic_tame_classification hfr htr hsupp
  have hroot : HasSqrtRoot E d := by
    refine ⟨(x : K), ?_, ?_⟩
    · have h1 : ((x * x : ↥E) : K) = (x : K) * (x : K) := by push_cast; ring
      rw [← h1, hx]
      exact IsScalarTower.algebraMap_apply ℚ ↥E K (d : ℚ)
    · have hle : IntermediateField.adjoin ℚ ({(x : K)} : Set K) ≤ E :=
        IntermediateField.adjoin_le_iff.mpr (by
          intro y hy
          rw [Set.mem_singleton_iff] at hy
          rw [hy]
          exact x.2)
      refine le_antisymm ?_ hle
      let L' : IntermediateField ℚ K := IntermediateField.adjoin ℚ ({(x : K)} : Set K)
      let C : IntermediateField ℚ ↥E := IntermediateField.comap (IntermediateField.val E) L'
      have hxC : x ∈ C := by
        change (x : K) ∈ L'
        exact IntermediateField.subset_adjoin ℚ ({(x : K)} : Set K) (Set.mem_singleton _)
      have hsubC : C.toSubalgebra = ⊤ := by
        apply le_antisymm le_top
        rw [← hgen]
        refine Algebra.adjoin_le_iff.mpr ?_
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact (IntermediateField.mem_toSubalgebra C x).mpr hxC
      have htop : (⊤ : IntermediateField ℚ ↥E) ≤ C := by
        intro y _
        exact (IntermediateField.mem_toSubalgebra C y).mp (by rw [hsubC]; trivial)
      intro y hy
      show y ∈ L'
      have h2 : (⟨y, hy⟩ : ↥E) ∈ C := htop trivial
      exact h2
  have hdne : d ≠ 1 := by
    intro hd1
    apply hnebot
    obtain ⟨xK, hxK, hadj⟩ := hroot
    rw [hadj]
    have hx1 : xK * xK = (1 : K) := by rw [hxK, hd1]; norm_num
    have hpm : xK = 1 ∨ xK = -1 := by
      have hh : (xK - 1) * (xK + 1) = 0 := by
        have : (xK - 1) * (xK + 1) = xK * xK - 1 := by ring
        rw [this, hx1, sub_self]
      rcases mul_eq_zero.mp hh with h | h
      · exact Or.inl (sub_eq_zero.mp h)
      · exact Or.inr (eq_neg_of_add_eq_zero_left h)
    rcases hpm with h | h
    · rw [h, ← le_bot_iff, IntermediateField.adjoin_le_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact one_mem _
    · rw [h, ← le_bot_iff, IntermediateField.adjoin_le_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact neg_mem (one_mem _)
  exact ⟨d, ⟨hdpos, hdsq, hd4, hdne, hdpr⟩, hroot⟩

/-- **A square root of `d` determines the quadratic level**: if `E = ℚ⟮x⟯` and `E' = ℚ⟮y⟯` with
`x * x = y * y = d`, then `x = ± y` (both are roots of `X² - d`), so `E = E'`. -/
theorem HasSqrtRoot.eq_of_eq {E E' : IntermediateField ℚ K} {d : ℤ}
    (h : HasSqrtRoot E d) (h' : HasSqrtRoot E' d) : E = E' := by
  obtain ⟨x, hx, rfl⟩ := h
  obtain ⟨y, hy, rfl⟩ := h'
  have hsq : x * x = y * y := by rw [hx, hy]
  have hfac : (x - y) * (x + y) = 0 := by
    have hh : (x - y) * (x + y) = x * x - y * y := by ring
    rw [hh, hsq, sub_self]
  rcases mul_eq_zero.mp hfac with h1 | h2
  · have hxy : x = y := sub_eq_zero.mp h1
    rw [hxy]
  · have hxy : x = -y := eq_neg_of_add_eq_zero_left h2
    rw [hxy]
    refine le_antisymm ?_ ?_
    · rw [IntermediateField.adjoin_le_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact IntermediateField.neg_mem _
        (IntermediateField.subset_adjoin ℚ ({y} : Set K) (Set.mem_singleton y))
    · rw [IntermediateField.adjoin_le_iff]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      have h1 : -y ∈ IntermediateField.adjoin ℚ ({-y} : Set K) :=
        IntermediateField.subset_adjoin ℚ ({-y} : Set K) (Set.mem_singleton (-y))
      simpa using IntermediateField.neg_mem _ h1

/-! ### Counting the possible `d`'s -/

/-- The map from a possible `d` to its set of prime divisors, as a nonempty subset of `primesS`. -/
def sqrtRootDiscrMap (d : {d : ℤ // IsSqrtRootDiscr d}) : ↥(primesS.powerset.erase ∅) :=
  ⟨d.1.natAbs.primeFactors, by
    obtain ⟨hdpos, hdsq, hd4, hdne, hdpr⟩ := d.2
    rw [Finset.mem_erase, Finset.mem_powerset]
    refine ⟨?_, ?_⟩
    · intro hempty
      have h0 : d.1.natAbs ≠ 0 := ne_of_gt (Int.natAbs_pos.mpr (ne_of_gt hdpos))
      have h1 : d.1.natAbs ≠ 1 := by
        intro hh
        rcases (Int.natAbs_eq_iff.mp hh) with h2 | h2
        · exact hdne h2
        · omega
      rcases (Nat.primeFactors_eq_empty.mp hempty) with h2 | h2
      · exact h0 h2
      · exact h1 h2
    · intro p hp
      rw [Nat.mem_primeFactors] at hp
      exact hdpr p hp.1 (Int.natCast_dvd.mpr hp.2.1)⟩

/-- **A squarefree positive integer is determined by its set of prime divisors**, so the map
`d ↦ primeFactors d` is injective on the possible `d`'s. -/
theorem sqrtRootDiscrMap_injective : Function.Injective sqrtRootDiscrMap := by
  intro d d' hdd'
  have h : d.1.natAbs.primeFactors = d'.1.natAbs.primeFactors := congrArg Subtype.val hdd'
  have hd0 : d.1.natAbs ≠ 0 := ne_of_gt (Int.natAbs_pos.mpr (ne_of_gt d.2.1))
  have hd0' : d'.1.natAbs ≠ 0 := ne_of_gt (Int.natAbs_pos.mpr (ne_of_gt d'.2.1))
  have hsq : Squarefree d.1.natAbs := Int.squarefree_natAbs.mpr d.2.2.1
  have hsq' : Squarefree d'.1.natAbs := Int.squarefree_natAbs.mpr d'.2.2.1
  have hnat : d.1.natAbs = d'.1.natAbs := by
    rw [Nat.Squarefree.ext_iff hsq hsq']
    intro p hp
    constructor
    · intro hpd
      have hmem : p ∈ d.1.natAbs.primeFactors := Nat.mem_primeFactors.mpr ⟨hp, hpd, hd0⟩
      rw [h] at hmem
      exact (Nat.mem_primeFactors.mp hmem).2.1
    · intro hpd
      have hmem : p ∈ d'.1.natAbs.primeFactors := Nat.mem_primeFactors.mpr ⟨hp, hpd, hd0'⟩
      rw [← h] at hmem
      exact (Nat.mem_primeFactors.mp hmem).2.1
  have h1 : (d.1.natAbs : ℤ) = d.1 := Int.natAbs_of_nonneg (le_of_lt d.2.1)
  have h2 : (d'.1.natAbs : ℤ) = d'.1 := Int.natAbs_of_nonneg (le_of_lt d'.2.1)
  exact Subtype.ext (by rw [← h1, ← h2, hnat])

instance finite_sqrtRootDiscr : Finite {d : ℤ // IsSqrtRootDiscr d} :=
  Finite.of_injective sqrtRootDiscrMap sqrtRootDiscrMap_injective

/-- **There are at most `31` possible `d`'s**: they inject into the nonempty subsets of the
five-element set `primesS`, of which there are `2 ^ 5 - 1 = 31`. -/
theorem card_sqrtRootDiscr_le : Nat.card {d : ℤ // IsSqrtRootDiscr d} ≤ 31 := by
  haveI := finite_sqrtRootDiscr
  have h := Nat.card_le_card_of_injective sqrtRootDiscrMap sqrtRootDiscrMap_injective
  have hcard : Nat.card ↥(primesS.powerset.erase ∅) = 31 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_coe, Finset.card_erase_of_mem]
    · rw [Finset.card_powerset, primesS_card]; norm_num
    · rw [Finset.mem_powerset]; exact Finset.empty_subset _
  rw [hcard] at h
  exact h

/-! ### The quadratic levels of `K` number at most `31` -/

/-- A chosen `d` for each quadratic level. -/
def quadLevelD (hK : IsMaximalTamePro2 K) (E : QuadLevel K) : {d : ℤ // IsSqrtRootDiscr d} :=
  ⟨Classical.choose (quadLevel_classification hK E.2),
    (Classical.choose_spec (quadLevel_classification hK E.2)).1⟩

/-- `quadLevelD` is injective: the discriminant determines the level. -/
theorem quadLevelD_injective (hK : IsMaximalTamePro2 K) : Function.Injective (quadLevelD hK) := by
  intro E E' h
  have hd : (quadLevelD hK E).1 = (quadLevelD hK E').1 := congrArg Subtype.val h
  have h1 : HasSqrtRoot E.1 (quadLevelD hK E).1 :=
    (Classical.choose_spec (quadLevel_classification hK E.2)).2
  have h2 : HasSqrtRoot E'.1 (quadLevelD hK E).1 := by
    rw [hd]
    exact (Classical.choose_spec (quadLevel_classification hK E'.2)).2
  exact Subtype.ext (HasSqrtRoot.eq_of_eq h1 h2)

theorem finite_quadLevel (hK : IsMaximalTamePro2 K) : Finite (QuadLevel K) :=
  Finite.of_injective (quadLevelD hK) (quadLevelD_injective hK)

/-- **`K/ℚ` has at most `31` quadratic levels.** -/
theorem card_quadLevel_le (hK : IsMaximalTamePro2 K) : Nat.card (QuadLevel K) ≤ 31 := by
  haveI := finite_sqrtRootDiscr
  exact (Nat.card_le_card_of_injective (quadLevelD hK) (quadLevelD_injective hK)).trans
    card_sqrtRootDiscr_le

/-! ## 3. The continuous characters `Γ → 𝔽₂` and the quadratic levels -/

/-- **The continuous characters of `Γ = Gal(K/ℚ)` with values in `𝔽₂`** (written
multiplicatively), i.e. `H¹(Γ, 𝔽₂)`. -/
abbrev TameChar (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K] : Type :=
  {χ : (K ≃ₐ[ℚ] K) →* Multiplicative (ZMod 2) // Continuous χ}

/-- The kernel of a continuous character is closed. -/
theorem isClosed_ker_tameChar (χ : TameChar K) :
    IsClosed ((χ.1.ker : Subgroup (K ≃ₐ[ℚ] K)) : Set (K ≃ₐ[ℚ] K)) := by
  have h1 : IsClosed (χ.1 ⁻¹' ({1} : Set (Multiplicative (ZMod 2)))) :=
    IsClosed.preimage χ.2 isClosed_singleton
  convert h1 using 1
  ext x
  simp [MonoidHom.mem_ker]

/-- The fixed field of the kernel of a continuous character has that kernel as its fixing
subgroup (the fundamental theorem of infinite Galois theory). -/
theorem fixingSubgroup_fixedField_ker (χ : TameChar K) :
    (IntermediateField.fixedField (χ.1.ker)).fixingSubgroup = χ.1.ker := by
  have h := InfiniteGalois.fixingSubgroup_fixedField (k := ℚ) (K := K)
    (⟨χ.1.ker, isClosed_ker_tameChar χ⟩ : ClosedSubgroup (K ≃ₐ[ℚ] K))
  simpa using h

/-- A nontrivial homomorphism into a two-element group is surjective. -/
theorem surjective_of_ne_one_of_card_two {G : Type*} [Group G] {A : Type*} [Group A]
    (hA : Nat.card A = 2) {χ : G →* A} (h : χ ≠ 1) : Function.Surjective χ := by
  obtain ⟨b, hbne, hb⟩ := (Nat.card_eq_two_iff' (1 : A)).mp hA
  have hex : ∃ x, χ x ≠ 1 := by
    by_contra hc
    exact h (MonoidHom.ext fun x => not_not.mp (not_exists.mp hc x))
  obtain ⟨x0, hx0⟩ := hex
  intro y
  rcases eq_or_ne y 1 with h1 | h1
  · exact ⟨1, by rw [map_one, h1]⟩
  · exact ⟨x0, by rw [hb y h1, hb (χ x0) hx0]⟩

/-- **A nontrivial continuous character cuts out a quadratic level** (the fixed field of its
kernel). -/
def quadLevelOfChar (χ : TameChar K) (h : χ.1 ≠ 1) : QuadLevel K :=
  ⟨IntermediateField.fixedField χ.1.ker, by
    show (IntermediateField.fixedField χ.1.ker).fixingSubgroup.index = 2
    rw [fixingSubgroup_fixedField_ker χ, Subgroup.index_ker,
      MonoidHom.range_eq_top.mpr
        (surjective_of_ne_one_of_card_two (by simp) h), Subgroup.card_top]
    simp⟩

/-- A continuous character is sent to the quadratic level cut out by its kernel, or to `none` if
it is trivial. -/
def tameCharToOption : TameChar K → Option (QuadLevel K) := fun χ =>
  if h : χ.1 = 1 then none else some (quadLevelOfChar χ h)

/-- The quadratic level determines the character (a homomorphism into a two-element group is
determined by its kernel, and the kernel is recovered from the fixed field). -/
theorem tameCharToOption_injective : Function.Injective (tameCharToOption (K := K)) := by
  intro χ ψ h
  by_cases hχ : χ.1 = 1
  · have h1 : tameCharToOption χ = none := by
      simp only [tameCharToOption, dif_pos hχ]
    rw [h1] at h
    have hψ : ψ.1 = 1 := by
      by_contra hne
      rw [tameCharToOption, dif_neg hne] at h
      exact absurd h (by simp)
    exact Subtype.ext (by rw [hχ, hψ])
  · have h2 : tameCharToOption χ = some (quadLevelOfChar χ hχ) := by
      simp only [tameCharToOption, dif_neg hχ]
    rw [h2] at h
    by_cases hψ : ψ.1 = 1
    · rw [tameCharToOption, dif_pos hψ] at h
      exact absurd h (by simp)
    · have h3 : tameCharToOption ψ = some (quadLevelOfChar ψ hψ) := by
        simp only [tameCharToOption, dif_neg hψ]
      rw [h3] at h
      have h4 : quadLevelOfChar χ hχ = quadLevelOfChar ψ hψ := Option.some.inj h
      have h4v : IntermediateField.fixedField χ.1.ker = IntermediateField.fixedField ψ.1.ker :=
        congrArg Subtype.val h4
      apply Subtype.ext
      apply Work.ShafarevichKoch.monoidHom_eq_of_ker_eq_card_two
        (A := Multiplicative (ZMod 2)) (by simp)
      rw [← fixingSubgroup_fixedField_ker χ, ← fixingSubgroup_fixedField_ker ψ, h4v]

/-- **`Γ` has at most `32` continuous characters to `𝔽₂`**, i.e. at most `31` quadratic levels
plus the trivial character. -/
theorem card_tameChar_le (hK : IsMaximalTamePro2 K) : Nat.card (TameChar K) ≤ 32 := by
  haveI hfin : Finite (QuadLevel K) := finite_quadLevel hK
  haveI : Fintype (QuadLevel K) := Fintype.ofFinite _
  have h1 : Nat.card (TameChar K) ≤ Nat.card (Option (QuadLevel K)) :=
    Nat.card_le_card_of_injective tameCharToOption tameCharToOption_injective
  have h2 : Nat.card (Option (QuadLevel K)) = Nat.card (QuadLevel K) + 1 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_option, Nat.card_eq_fintype_card]
  have h3 : Nat.card (QuadLevel K) ≤ 31 := card_quadLevel_le hK
  omega

/-! ## 4. The Frattini-type subgroup `Φ = ⋂ E.fixingSubgroup` -/

/-- **The intersection of the fixing subgroups of all quadratic levels**, the subgroup that every
continuous character to `𝔽₂` kills. -/
def ftSubgroup (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K] : Subgroup (K ≃ₐ[ℚ] K) :=
  ⨅ E : QuadLevel K, E.1.fixingSubgroup

theorem ftSubgroup_le (E : QuadLevel K) : ftSubgroup K ≤ E.1.fixingSubgroup :=
  iInf_le _ E

instance ftSubgroup_normal : (ftSubgroup K).Normal :=
  Subgroup.normal_iInf_normal fun E => Subgroup.normal_of_index_eq_two E.2

/-- Every `x²` lies in `Φ`, since `Γ ⧸ E.fixingSubgroup` has order `2` for every quadratic
level `E`. -/
theorem sq_mem_ftSubgroup (x : K ≃ₐ[ℚ] K) : x * x ∈ ftSubgroup K := by
  rw [ftSubgroup, Subgroup.mem_iInf]
  intro E
  haveI : E.1.fixingSubgroup.Normal := Subgroup.normal_of_index_eq_two E.2
  rw [← QuotientGroup.eq_one_iff]
  have h2 : Nat.card ((K ≃ₐ[ℚ] K) ⧸ E.1.fixingSubgroup) = 2 := by
    rw [← Subgroup.index_eq_card, E.2]
  have h3 : (QuotientGroup.mk' E.1.fixingSubgroup x)
      ^ Nat.card ((K ≃ₐ[ℚ] K) ⧸ E.1.fixingSubgroup) = 1 :=
    pow_card_eq_one' (x := QuotientGroup.mk' E.1.fixingSubgroup x)
  rw [h2] at h3
  change QuotientGroup.mk' E.1.fixingSubgroup (x * x) = 1
  rw [map_mul]
  simpa [pow_two] using h3

/-- `Φ` is open: it is the intersection of the finitely many fixing subgroups of the quadratic
levels, each of which is open. -/
theorem isOpen_ftSubgroup (hK : IsMaximalTamePro2 K) : IsOpen (ftSubgroup K : Set (K ≃ₐ[ℚ] K)) := by
  haveI hfin : Finite (QuadLevel K) := finite_quadLevel hK
  rw [ftSubgroup, Subgroup.coe_iInf]
  refine isOpen_iInter_of_finite fun E => ?_
  letI : Algebra ℚ ↥E.1 := E.1.algebra'
  have hfr : Module.finrank ℚ ↥E.1 = 2 := by
    rw [IntermediateField.finrank_eq_fixingSubgroup_index K E.1, E.2]
  haveI : FiniteDimensional ℚ ↥E.1 := Module.finite_of_finrank_pos (by rw [hfr]; norm_num)
  exact IntermediateField.fixingSubgroup_isOpen E.1

/-- `Γ ⧸ Φ` is finite: it is the quotient by the kernel of the product of the quotient maps
`Γ → Γ ⧸ E.fixingSubgroup` over the finitely many quadratic levels, hence isomorphic to a
subgroup of a finite product. -/
theorem finite_quotient_ftSubgroup (hK : IsMaximalTamePro2 K) : Finite ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := by
  haveI hfin : Finite (QuadLevel K) := finite_quadLevel hK
  haveI hnorm : ∀ E : QuadLevel K, (E.1.fixingSubgroup).Normal :=
    fun E => Subgroup.normal_of_index_eq_two E.2
  haveI hnorminf : (ftSubgroup K).Normal := ftSubgroup_normal
  let f : (K ≃ₐ[ℚ] K) →* (∀ E : QuadLevel K, (K ≃ₐ[ℚ] K) ⧸ E.1.fixingSubgroup) :=
    { toFun := fun x E => QuotientGroup.mk' E.1.fixingSubgroup x
      map_one' := by ext E; simp
      map_mul' := by intro x y; ext E; simp }
  have hker : MonoidHom.ker f = ftSubgroup K := by
    ext x
    rw [MonoidHom.mem_ker, ftSubgroup, Subgroup.mem_iInf]
    constructor
    · intro h E
      exact (QuotientGroup.eq_one_iff x).mp (congr_fun h E)
    · intro h
      funext E
      exact (QuotientGroup.eq_one_iff x).mpr (h E)
  haveI : ∀ E : QuadLevel K, Finite ((K ≃ₐ[ℚ] K) ⧸ E.1.fixingSubgroup) := fun E =>
    finite_of_natCard_ne_zero (by rw [← Subgroup.index_eq_card, E.2]; norm_num)
  haveI : Finite (∀ E : QuadLevel K, (K ≃ₐ[ℚ] K) ⧸ E.1.fixingSubgroup) := inferInstance
  haveI : Finite ↥(MonoidHom.range f) := inferInstance
  have e1 : ((K ≃ₐ[ℚ] K) ⧸ MonoidHom.ker f) ≃* ↥(MonoidHom.range f) :=
    QuotientGroup.quotientKerEquivRange f
  have e2 : ((K ≃ₐ[ℚ] K) ⧸ MonoidHom.ker f) ≃* ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) :=
    QuotientGroup.quotientMulEquivOfEq hker
  exact Finite.of_injective (e2.symm.trans e1) (e2.symm.trans e1).injective

/-- `Γ ⧸ Φ` is a `2`-group (it has exponent `2`, by `sq_mem_ftSubgroup`). -/
theorem isPGroup_quotient_ftSubgroup (hK : IsMaximalTamePro2 K) :
    IsPGroup 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := by
  haveI : Finite ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := finite_quotient_ftSubgroup hK
  haveI : (ftSubgroup K).Normal := ftSubgroup_normal
  intro y
  refine ⟨1, ?_⟩
  rw [pow_one]
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (ftSubgroup K) y
  have hx : x * x ∈ ftSubgroup K := sq_mem_ftSubgroup x
  rw [show (QuotientGroup.mk' (ftSubgroup K) x) ^ 2
      = QuotientGroup.mk' (ftSubgroup K) (x * x) from by rw [pow_two, map_mul]]
  exact (QuotientGroup.eq_one_iff (x * x)).mpr hx

/-- The characters of `Γ ⧸ Φ` are exactly the characters of `Γ` (every character kills `Φ`), so
there are at most `32` of them. -/
theorem card_homFp_quotient_le (hK : IsMaximalTamePro2 K) :
    Nat.card (HomFp 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K)) ≤ 32 := by
  haveI : Finite (QuadLevel K) := finite_quadLevel hK
  haveI : (ftSubgroup K).Normal := ftSubgroup_normal
  have hopen : IsOpen (ftSubgroup K : Set (K ≃ₐ[ℚ] K)) := isOpen_ftSubgroup hK
  haveI : DiscreteTopology ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) :=
    QuotientGroup.discreteTopology hopen
  let emb : HomFp 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) → TameChar K := fun χ =>
    ⟨χ.comp (QuotientGroup.mk' (ftSubgroup K)),
      (continuous_of_discreteTopology (f := ⇑χ)).comp QuotientGroup.continuous_mk⟩
  have hemb : Function.Injective emb := by
    intro χ ψ h
    have h1 : χ.comp (QuotientGroup.mk' (ftSubgroup K))
        = ψ.comp (QuotientGroup.mk' (ftSubgroup K)) := congrArg Subtype.val h
    refine MonoidHom.ext fun z => ?_
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (ftSubgroup K) z
    exact DFunLike.congr_fun h1 x
  have h1 : Nat.card (HomFp 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K)) ≤ Nat.card (Option (QuadLevel K)) :=
    Nat.card_le_card_of_injective
      (fun χ => tameCharToOption (emb χ))
      (tameCharToOption_injective.comp hemb)
  haveI : Fintype (QuadLevel K) := Fintype.ofFinite _
  have h2 : Nat.card (Option (QuadLevel K)) = Nat.card (QuadLevel K) + 1 := by
    rw [Nat.card_eq_fintype_card, Fintype.card_option, Nat.card_eq_fintype_card]
  have h3 : Nat.card (QuadLevel K) ≤ 31 := card_quadLevel_le hK
  omega

/-- **`Γ ⧸ Φ` is generated by at most five elements.**  By Burnside's basis theorem for finite
`2`-groups (`Work.ProPDeficiency.dGens_eq_pHomDim_of_isPGroup`) the minimal number of generators
of `Γ ⧸ Φ` is `log₂ #Hom(Γ ⧸ Φ, 𝔽₂) ≤ log₂ 32 = 5`. -/
theorem dGens_quotient_le_five (hK : IsMaximalTamePro2 K) :
    dGens ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) ≤ 5 := by
  haveI : Fact (Nat.Prime 2) := Nat.fact_prime_two
  haveI : Finite ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := finite_quotient_ftSubgroup hK
  haveI : IsPGroup 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := isPGroup_quotient_ftSubgroup hK
  rw [← dGens_eq_pHomDim_of_isPGroup (p := 2)
    (G := (K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) (isPGroup_quotient_ftSubgroup hK)]
  show Nat.log 2 (Nat.card (HomFp 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K))) ≤ 5
  calc Nat.log 2 (Nat.card (HomFp 2 ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K)))
      ≤ Nat.log 2 32 := Nat.log_mono_right (card_homFp_quotient_le hK)
    _ = 5 := by rw [show (32 : ℕ) = 2 ^ 5 by norm_num, Nat.log_pow (by norm_num)]

/-! ## 5. Every proper closed subgroup lies in an open subgroup of index `2` -/

/-- **The pro-`2` Frattini step.**  Every proper closed subgroup `H ≤ Γ` is contained in an open
subgroup of index `2`: the fixed field `L` of `H` is strictly bigger than `ℚ`, a finite Galois
level `E ⊆ K` containing a non-rational element of `L` is a finite `2`-group over `ℚ` (by
`TameSubClause`), the image of `H` in `Gal(E/ℚ)` is proper, and a maximal subgroup of a finite
`2`-group has index `2`. -/
theorem exists_isOpen_index_two_le_of_isClosed (hK : IsMaximalTamePro2 K)
    {H : Subgroup (K ≃ₐ[ℚ] K)} (hH : IsClosed (H : Set (K ≃ₐ[ℚ] K))) (hne : H ≠ ⊤) :
    ∃ M' : Subgroup (K ≃ₐ[ℚ] K), H ≤ M' ∧ M'.index = 2 ∧ IsOpen (M' : Set (K ≃ₐ[ℚ] K)) := by
  have hGalK : IsGalois ℚ K := inferInstance
  set L : IntermediateField ℚ K := IntermediateField.fixedField H with hLdef
  have hfix : L.fixingSubgroup = H := by
    have h1 := InfiniteGalois.fixingSubgroup_fixedField (k := ℚ) (K := K)
      (⟨H, hH⟩ : ClosedSubgroup (K ≃ₐ[ℚ] K))
    simpa only [hLdef] using h1
  have hLne : L ≠ ⊥ := by
    intro hb
    apply hne
    rw [← hfix, hb, IntermediateField.fixingSubgroup_bot]
  obtain ⟨x, hxL, hxbot⟩ := SetLike.exists_of_lt (lt_of_le_of_ne bot_le hLne.symm)
  have hfin : Finite ({x} : Set K) := Set.finite_singleton x
  let E : FiniteGaloisIntermediateField ℚ K :=
    FiniteGaloisIntermediateField.adjoin ℚ ({x} : Set K)
  have hxE : x ∈ E.toIntermediateField :=
    FiniteGaloisIntermediateField.subset_adjoin ℚ {x} (Set.mem_singleton x)
  letI : Algebra ℚ ↥(E.toIntermediateField) := (E.toIntermediateField).algebra'
  haveI : FiniteDimensional ℚ ↥(E.toIntermediateField) := E.finiteDimensional
  haveI : IsGalois ℚ ↥(E.toIntermediateField) := E.isGalois
  let φ : (K ≃ₐ[ℚ] K) →* (↥(E.toIntermediateField) ≃ₐ[ℚ] ↥(E.toIntermediateField)) :=
    AlgEquiv.restrictNormalHom (F := ℚ) (K₁ := K) ↥(E.toIntermediateField)
  have hφsurj : Function.Surjective φ := AlgEquiv.restrictNormalHom_surjective K
  have hJne : H.map φ ≠ ⊤ := by
    intro hJtop
    have hfx : x ∈ IntermediateField.fixedField H ⊓ E.toIntermediateField := ⟨hxL, hxE⟩
    have h2 : IntermediateField.fixedField H ⊓ (E.toIntermediateField : IntermediateField ℚ K)
        = IntermediateField.lift (IntermediateField.fixedField (H.map φ)) := by
      have h3 := InfiniteGalois.restrict_fixedField H (E.toIntermediateField)
      simpa only [φ] using h3
    rw [h2, hJtop] at hfx
    rw [InfiniteGalois.fixedField_bot, IntermediateField.lift_bot] at hfx
    exact hxbot hfx
  haveI : Fintype (↥(E.toIntermediateField) ≃ₐ[ℚ] ↥(E.toIntermediateField)) :=
    AlgEquiv.fintype ℚ ↥(E.toIntermediateField)
  have hpg : IsPGroup 2 (↥(E.toIntermediateField) ≃ₐ[ℚ] ↥(E.toIntermediateField)) := by
    haveI : NumberField ↥(E.toIntermediateField) :=
      NumberField.of_module_finite ℚ ↥(E.toIntermediateField)
    obtain ⟨h1, -, -⟩ := hK.2.2 ↥(E.toIntermediateField) (IntermediateField.val _)
      (fun a b hh => Subtype.ext hh)
    exact h1
  obtain ⟨M₀, hM₀coat, hJM₀⟩ :=
    (IsCoatomic.eq_top_or_exists_le_coatom (H.map φ)).resolve_left hJne
  have hidx : M₀.index = 2 := Commons.GroupTheory.PGroup.index_coatom_eq_prime hpg hM₀coat
  refine ⟨Subgroup.comap φ M₀, ?_, ?_, ?_⟩
  · exact (Subgroup.map_le_iff_le_comap).mp hJM₀
  · rw [Subgroup.index_comap_of_surjective _ hφsurj, hidx]
  · have hcont : Continuous φ := InfiniteGalois.restrictNormalHom_continuous (E.toIntermediateField)
    exact hcont.isOpen_preimage M₀.carrier (isOpen_discrete M₀.carrier)

/-- Every open subgroup of index `2` contains `Φ` (it is the fixing subgroup of a quadratic
level). -/
theorem ftSubgroup_le_of_index_two (hK : IsMaximalTamePro2 K) {M' : Subgroup (K ≃ₐ[ℚ] K)}
    (hidx : M'.index = 2) (hopen : IsOpen (M' : Set (K ≃ₐ[ℚ] K))) : ftSubgroup K ≤ M' := by
  have hM'closed : IsClosed (M' : Set (K ≃ₐ[ℚ] K)) := Subgroup.isClosed_of_isOpen M' hopen
  have hfix : (IntermediateField.fixedField M').fixingSubgroup = M' := by
    have h1 := InfiniteGalois.fixingSubgroup_fixedField (k := ℚ) (K := K)
      (⟨M', hM'closed⟩ : ClosedSubgroup (K ≃ₐ[ℚ] K))
    simpa using h1
  have hE : IsQuadLevel (IntermediateField.fixedField M') := by
    rw [IsQuadLevel, hfix, hidx]
  have h2 := ftSubgroup_le (K := K) (⟨IntermediateField.fixedField M', hE⟩ : QuadLevel K)
  rwa [hfix] at h2

/-! ## 6. Producing a `Fin 5`-indexed generating family from a finset -/

/-- A finset of at most five elements of a type is contained in the range of a map `Fin 5 → ·`. -/
theorem exists_fin_five_range_superset (T : Finset (K ≃ₐ[ℚ] K)) (hT : T.card ≤ 5) :
    ∃ gen : Fin 5 → (K ≃ₐ[ℚ] K), (T : Set (K ≃ₐ[ℚ] K)) ⊆ Set.range gen := by
  let e := Finset.equivFin T
  let gen : Fin 5 → (K ≃ₐ[ℚ] K) := fun i =>
    if h : (i : ℕ) < T.card then (e.symm ⟨(i : ℕ), h⟩ : K ≃ₐ[ℚ] K) else 1
  have hgen : ∀ j : Fin T.card, gen (Fin.castLE hT j) = (e.symm j : K ≃ₐ[ℚ] K) := by
    intro j
    show (if h : ((Fin.castLE hT j : Fin 5) : ℕ) < T.card then
        (e.symm ⟨((Fin.castLE hT j : Fin 5) : ℕ), h⟩ : K ≃ₐ[ℚ] K) else 1)
      = (e.symm j : K ≃ₐ[ℚ] K)
    have hcond : ((Fin.castLE hT j : Fin 5) : ℕ) < T.card := j.isLt
    rw [dif_pos hcond,
      show (⟨((Fin.castLE hT j : Fin 5) : ℕ), hcond⟩ : Fin T.card) = j from Fin.ext rfl]
  refine ⟨gen, ?_⟩
  intro y hy
  exact ⟨Fin.castLE hT (e ⟨y, hy⟩),
    by rw [hgen]; exact congrArg Subtype.val (e.symm_apply_apply ⟨y, hy⟩)⟩

/-! ## 7. The generator half -/

/-- **`Γ = Gal(K/ℚ)` is topologically generated by five elements.**

This is `Submission.NumberField.GeneratorHalf K`, the elementary half of the pro-`2` presentation
datum of the tame Golod--Shafarevich route: the five generators come from the fact that `Γ ⧸ Φ`
is a finite elementary abelian `2`-group of rank at most `5` (there are only `31` quadratic
levels), lifted along the quotient `Γ → Γ ⧸ Φ`. -/
theorem dense_generatingFamily_of_isMaximalTamePro2
    (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K]
    (hK : Work.TameArithmetic.IsMaximalTamePro2 K) :
    ∃ gen : Fin 5 → (K ≃ₐ[ℚ] K),
      (Subgroup.closure (Set.range gen)).topologicalClosure = ⊤ := by
  classical
  haveI hnorm : (ftSubgroup K).Normal := ftSubgroup_normal
  haveI hfin : Finite ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) := finite_quotient_ftSubgroup hK
  -- five generators of `Γ ⧸ Φ`
  obtain ⟨S, hSmin, hScard⟩ :=
    exists_minimalGeneratingSet (G := (K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) (Group.fg_of_finite)
  have hScard5 : S.card ≤ 5 := by
    rw [hScard]
    exact dGens_quotient_le_five hK
  have hSgen : Subgroup.closure (S : Set ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K)) = ⊤ := hSmin.1
  -- lift them to `Γ`
  let lift : ((K ≃ₐ[ℚ] K) ⧸ ftSubgroup K) → (K ≃ₐ[ℚ] K) :=
    fun y => Classical.choose (QuotientGroup.mk'_surjective (ftSubgroup K) y)
  have hlift : ∀ y, QuotientGroup.mk' (ftSubgroup K) (lift y) = y :=
    fun y => Classical.choose_spec (QuotientGroup.mk'_surjective (ftSubgroup K) y)
  let T : Finset (K ≃ₐ[ℚ] K) := S.image lift
  have hTcard : T.card ≤ 5 := le_trans Finset.card_image_le hScard5
  have hTgen : Subgroup.map (QuotientGroup.mk' (ftSubgroup K))
      (Subgroup.closure (T : Set (K ≃ₐ[ℚ] K))) = ⊤ := by
    have hkey : Subgroup.closure
        (⇑(QuotientGroup.mk' (ftSubgroup K)) '' (lift '' (S : Set _))) = ⊤ := by
      have h1 : ⇑(QuotientGroup.mk' (ftSubgroup K)) '' (lift '' (S : Set _)) = (S : Set _) := by
        rw [← Set.image_comp]
        rw [show (⇑(QuotientGroup.mk' (ftSubgroup K)) ∘ lift) = id from funext (fun y => hlift y),
          Set.image_id]
      rw [h1, hSgen]
    rw [MonoidHom.map_closure, Finset.coe_image]
    exact hkey
  have hHsup0 : Subgroup.closure (T : Set (K ≃ₐ[ℚ] K)) ⊔ ftSubgroup K = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro g
    have hg : (QuotientGroup.mk' (ftSubgroup K)) g ∈ Subgroup.map (QuotientGroup.mk' (ftSubgroup K))
        (Subgroup.closure (T : Set (K ≃ₐ[ℚ] K))) := by
      rw [hTgen]
      trivial
    obtain ⟨h, hh, hhe⟩ := hg
    have hmem : h⁻¹ * g ∈ ftSubgroup K := by
      rw [← QuotientGroup.eq]
      exact hhe
    have hge : g = h * (h⁻¹ * g) := by group
    rw [hge]
    exact Subgroup.mul_mem_sup hh hmem
  -- the closure is everything
  have hHtop : (Subgroup.closure (T : Set (K ≃ₐ[ℚ] K))).topologicalClosure = ⊤ := by
    have hHclosed : IsClosed
        ((Subgroup.closure (T : Set (K ≃ₐ[ℚ] K))).topologicalClosure : Set (K ≃ₐ[ℚ] K)) :=
      Subgroup.isClosed_topologicalClosure _
    by_contra hne
    obtain ⟨M', hle, hidx, hM'open⟩ := exists_isOpen_index_two_le_of_isClosed hK hHclosed hne
    have hΦM' : ftSubgroup K ≤ M' := ftSubgroup_le_of_index_two hK hidx hM'open
    have hHsup : (Subgroup.closure (T : Set (K ≃ₐ[ℚ] K))).topologicalClosure
        ⊔ ftSubgroup K = ⊤ := by
      refine le_antisymm le_top ?_
      rw [← hHsup0]
      exact sup_le_sup_right (Subgroup.le_topologicalClosure _) _
    have htop : (⊤ : Subgroup (K ≃ₐ[ℚ] K)) ≤ M' := by
      rw [← hHsup]
      exact sup_le hle hΦM'
    have hM'top : M' = ⊤ := top_le_iff.mp htop
    rw [hM'top, Subgroup.index_top] at hidx
    omega
  -- pad the five-element generating family
  obtain ⟨gen, hrange⟩ := exists_fin_five_range_superset T hTcard
  refine ⟨gen, ?_⟩
  refine top_le_iff.mp ?_
  rw [← hHtop]
  exact Subgroup.topologicalClosure_mono (Subgroup.closure_mono hrange)

end

