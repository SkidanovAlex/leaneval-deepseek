import Mathlib
import Submission.Work.TameArithmetic.VSDefs
import Submission.Work.TameArithmetic.isSquare_neg_one_padic

/-!
# `-1 ∈ V_S`

The element `-1 ∈ ℚˣ` lies in Koch's group `V_S` (`VSDefs.lean`) for `S = primesS`, because

* `(-1) = ℤ` is the **unit** fractional ideal of `ℤ` in `ℚ`, hence the square of the unit ideal:
  `-1 ∈ V_S` satisfies the ideal-square condition `(x) = I²` with `I = 1`;
* `-1` is a **local square** at every `q ∈ S`: each `q ∈ primesS` is `≡ 1 (mod 4)`, and for such a
  prime `ℚ_q` contains a square root of `-1` (`isSquare_neg_one_padic`, Euler's criterion plus
  Hensel).

Together with `VS_eq_pm_squares` this gives `V_S = {±1}·(ℚˣ)²`, and since `-1` is not a square in
`ℚ` it gives `V_S/ℚ^{×2} ≅ ℤ/2`, i.e. `dim_{𝔽₂} V_S/ℚ^{×2} = 1` -- the `r - d ≤ 1` relation count of
the tame Golod--Shafarevich route.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

namespace Work.TameArithmetic

/-- **The principal fractional ideal generated by the unit `-1` of `ℤ` is the unit ideal.** -/
theorem toPrincipalIdeal_neg_one : toPrincipalIdeal ℤ ℚ (-1 : ℚˣ) = 1 := by
  apply Units.ext
  rw [coe_toPrincipalIdeal, Units.val_one]
  rw [← FractionalIdeal.spanSingleton_one (S := nonZeroDivisors ℤ) (R := ℤ) (P := ℚ)]
  exact (FractionalIdeal.spanSingleton_eq_spanSingleton (S := nonZeroDivisors ℤ)).mpr
    ⟨-1, by norm_num⟩

/-- **`-1` satisfies the ideal-square condition**: `(ℤ) = ℤ · ℤ`. -/
theorem isIdealSquare_neg_one : IsIdealSquare (-1 : ℚˣ) :=
  ⟨1, by rw [one_mul, toPrincipalIdeal_neg_one]⟩

/-- **`-1` is a local square at every `q ∈ S`**: every `q ∈ primesS` is `≡ 1 (mod 4)`, and
`-1` is a square in `ℚ_q` for such `q`. -/
theorem isLocalSquareAtS_neg_one : IsLocalSquareAtS (-1 : ℚˣ) := by
  intro q hq
  refine ⟨⟨primesS_prime q hq⟩, ?_⟩
  haveI : Fact (Nat.Prime q) := ⟨primesS_prime q hq⟩
  obtain ⟨y, hy⟩ := isSquare_neg_one_padic (p := q) (primesS_mod_four q hq)
  exact ⟨y, by simpa using hy⟩

theorem neg_one_mem_VS : (-1 : ℚˣ) ∈ Work.TameArithmetic.VS :=
  ⟨isIdealSquare_neg_one, isLocalSquareAtS_neg_one⟩

end Work.TameArithmetic
