import Mathlib
import Submission.Work.TameArithmetic.All

/-!
# `Work.TameArithmetic.generatorMinimal_of_isMaximalTamePro2`

**Generator minimality of the maximal tame pro-`2` extension of `ℚ`.**  For `K` a maximal tame
pro-`2` extension of `ℚ` (for `S = primesS = {17,41,73,89,97}`, `IsMaximalTamePro2 K`) the Galois
group `Γ = Gal(K/ℚ)` cannot be topologically generated by four elements: `d(Γ) ≥ 5`.

## The argument

* The multiquadratic field `M = ℚ(√q : q ∈ S)` is a finite Galois, totally real pro-`2` extension of
  `ℚ` whose different is supported over `S`
  (`Commons.NumberTheory.NumberField.exists_multiquadratic_totallyReal_unramifiedOutside`), so by
  the universal property `TameUnivClause` of `K` it embeds into `K`, with `Gal(M/ℚ) ≃ (ℤ/2)^{#S}`.
  Composing restriction of automorphisms with this isomorphism, and using
  `Work.ProPDeficiency.piMulEquiv`, gives a **surjection**
  `f : Γ →* (Fin primesS.card → Multiplicative (ZMod 2))` whose kernel contains the open subgroup
  `E.fixingSubgroup`, where `E ⊆ K` is the image of `M` (open because `E/ℚ` is finite).
* If `gen : Fin 4 → Γ` generated `Γ` topologically, then by
  `Work.ShafarevichKoch.map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker` (a dense subgroup of
  a topological group already maps onto the quotient when the kernel contains an open subgroup)
  the four elements `f (gen i)` would generate `(ℤ/2)^{#S}`.
* But the elementary abelian `2`-group of rank `n` needs `n` generators
  (`Work.ProPDeficiency.card_le_of_closure_eq_top_pi`), so `#S ≤ 4`, while `#S = 5`.  Contradiction.

This is the `α`-minimality half (`d ≥ 5`) of the pro-`2` presentation of `Γ`: the companion
statement `card_le_of_generating_presentedGroup` proves the same for the abstract group presented
by a `TamePro2Presentation`, and this file proves the form in which the requester's assembly uses
it, directly for the topological generators of `Γ = K ≃ₐ[ℚ] K`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1600000

open scoped Classical
open Commons.NumberTheory.NumberField

namespace Work.TameArithmetic

/-- **`Γ = Gal(K/ℚ)` maps onto `(ℤ/2)^{#S}`, with an open subgroup of `Γ` in the kernel.**

The multiquadratic field `ℚ(√q : q ∈ S)` embeds into `K` (universal property of `K`); writing `E`
for its image, `E/ℚ` is finite, so `E.fixingSubgroup` is an open subgroup of `Γ` lying in the
kernel of the restriction map `Γ →* Gal(E/ℚ) ≃ (ℤ/2)^{#S}`. -/
lemma exists_surjective_galoisGroup_tame_zmodTwo {K : Type} [Field K] [Algebra ℚ K]
    [IsGalois ℚ K] (hmax : Work.TameArithmetic.IsMaximalTamePro2 K) :
    ∃ (f : (K ≃ₐ[ℚ] K) →* (Fin primesS.card → Multiplicative (ZMod 2))),
      Function.Surjective f ∧
      ∃ U : Subgroup (K ≃ₐ[ℚ] K), IsOpen (U : Set (K ≃ₐ[ℚ] K)) ∧ U ≤ MonoidHom.ker f := by
  classical
  haveI hfdM : FiniteDimensional ℚ ↥(mqField primesS) := mqField_finiteDimensional primesS
  -- the multiquadratic field embeds into `K`, by the universal property of `K`
  obtain ⟨φ, -⟩ := hmax.2.1 ↥(mqField primesS) (isPGroup_two_aut_mqField primesS primesS_prime)
    (mqField_different_supp primesS primesS_prime primesS_mod_eight)
    (isUnramifiedAtInfinitePlaces_rat_of_isTotallyReal _ (mqField_isTotallyReal primesS))
  let E : IntermediateField ℚ K := φ.fieldRange
  letI hEalg : Algebra ℚ ↥E := E.algebra'
  haveI hEnorm : Normal ℚ ↥E := (IsGalois.of_algEquiv φ.equivFieldRange).to_normal
  haveI hEfd : FiniteDimensional ℚ ↥E := φ.equivFieldRange.toLinearEquiv.finiteDimensional
  -- `Gal(ℚ(√q)/ℚ) ≃ (ℤ/2)^{#S}`
  obtain ⟨e⟩ := mqField_galoisGroup primesS primesS_prime
  -- restriction of automorphisms of `K` to the image of the multiquadratic field
  let ψ : (K ≃ₐ[ℚ] K) →* (↥(mqField primesS) ≃ₐ[ℚ] ↥(mqField primesS)) :=
    (AlgEquiv.autCongr (φ.equivFieldRange).symm).toMonoidHom.comp (AlgEquiv.restrictNormalHom ↥E)
  have hψ : Function.Surjective ψ := by
    intro y
    obtain ⟨σ, hσ⟩ := AlgEquiv.restrictNormalHom_surjective (F := ℚ) (K₁ := ↥E) K
      ((AlgEquiv.autCongr (φ.equivFieldRange).symm).symm y)
    exact ⟨σ, by
      show (AlgEquiv.autCongr (φ.equivFieldRange).symm) ((AlgEquiv.restrictNormalHom ↥E) σ) = y
      rw [hσ]
      exact (AlgEquiv.autCongr (φ.equivFieldRange).symm).apply_symm_apply y⟩
  -- the composite `Γ →* (ℤ/2)^{#S}`
  let f : (K ≃ₐ[ℚ] K) →* (Fin primesS.card → Multiplicative (ZMod 2)) :=
    (Work.ProPDeficiency.piMulEquiv primesS.card 2).symm.toMonoidHom.comp (e.toMonoidHom.comp ψ)
  have hf : Function.Surjective f :=
    (Work.ProPDeficiency.piMulEquiv primesS.card 2).symm.surjective.comp (e.surjective.comp hψ)
  -- its kernel contains the open subgroup `E.fixingSubgroup`
  have hker : (E.fixingSubgroup : Subgroup (K ≃ₐ[ℚ] K)) ≤ MonoidHom.ker f := by
    intro u hu
    rw [MonoidHom.mem_ker]
    have h1 : (AlgEquiv.restrictNormalHom ↥E) u = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker E]
      exact hu
    have h2 : ψ u = 1 := by
      rw [show ψ u = (AlgEquiv.autCongr (φ.equivFieldRange).symm)
        ((AlgEquiv.restrictNormalHom ↥E) u) from rfl, h1, map_one]
    simp only [f, MonoidHom.comp_apply, h2, map_one]
  exact ⟨f, hf, E.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen E, hker⟩

/-- **`Γ = Gal(K/ℚ)` is not topologically generated by `4` elements.**

If `gen : Fin 4 → Γ` had dense closure, then by
`Work.ShafarevichKoch.map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker` its image under the
surjection `f : Γ →* (ℤ/2)^{#S}` of `exists_surjective_galoisGroup_tame_zmodTwo` would generate the
elementary abelian `2`-group of rank `#S`, which needs `#S = 5` generators
(`Work.ProPDeficiency.card_le_of_closure_eq_top_pi`); but there are only `4` of them. -/
theorem generatorMinimal_of_isMaximalTamePro2
    (K : Type) [Field K] [Algebra ℚ K] [IsGalois ℚ K]
    (hK : Work.TameArithmetic.IsMaximalTamePro2 K) :
    ¬ ∃ gen : Fin 4 → (K ≃ₐ[ℚ] K),
      (Subgroup.closure (Set.range gen)).topologicalClosure = ⊤ := by
  refine fun ⟨gen, hgen⟩ => ?_
  obtain ⟨f, hf, U, hUo, hUk⟩ := exists_surjective_galoisGroup_tame_zmodTwo hK
  -- a dense subgroup already maps onto the finite quotient `(ℤ/2)^{#S}`
  have hmap : (Subgroup.closure (Set.range gen)).map f = ⊤ :=
    Work.ShafarevichKoch.map_eq_top_of_topologicalClosure_eq_top_of_isOpen_ker f hf hgen hUo hUk
  -- so the four elements `f (gen i)` generate `(ℤ/2)^{#S}`
  have hrange : (f '' Set.range gen) = Set.range (fun i : Fin 4 => f (gen i)) := by
    ext y
    constructor
    · rintro ⟨x, ⟨i, rfl⟩, rfl⟩
      exact ⟨i, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨gen i, ⟨i, rfl⟩, rfl⟩
  have hSgen : Subgroup.closure (Set.range (fun i : Fin 4 => f (gen i))) = ⊤ := by
    rw [← hrange, ← MonoidHom.map_closure f (Set.range gen), hmap]
  -- package the range as a finset of at most four elements
  set A : Finset (Fin primesS.card → Multiplicative (ZMod 2)) :=
    (Finset.univ : Finset (Fin 4)).image (fun i => f (gen i)) with hAdef
  have hAcoe : (A : Set (Fin primesS.card → Multiplicative (ZMod 2)))
      = Set.range (fun i : Fin 4 => f (gen i)) := by
    rw [hAdef, Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hAg : Subgroup.closure (A : Set (Fin primesS.card → Multiplicative (ZMod 2))) = ⊤ := by
    rw [hAcoe]
    exact hSgen
  -- the elementary abelian `2`-group needs `#S` generators, but only `4` are available
  have h1 : primesS.card ≤ A.card := Work.ProPDeficiency.card_le_of_closure_eq_top_pi A hAg
  have h2 : A.card ≤ 4 := by
    rw [hAdef]
    calc ((Finset.univ : Finset (Fin 4)).image (fun i => f (gen i))).card
        ≤ (Finset.univ : Finset (Fin 4)).card := Finset.card_image_le
      _ = 4 := by simp
  have h5 : primesS.card = 5 := primesS_card
  omega

end Work.TameArithmetic
