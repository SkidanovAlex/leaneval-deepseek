import Mathlib
import Submission.Work.WingbergRoute.All
import Submission.Work.RelatorRank.ProP
import Submission.Work.ClassFieldTower.unitTwoRank_eq_finrank_units_modSquares
import Submission.Work.RelatorRank.Cohomology.card_continuousHom_eq_two_pow_generatorRank

/-!
# `Work.WingbergH3` -- the H³-half of Wingberg's duality, and the constructive alternative

**Namespace** `Work.WingbergH3`.  This module fixes the vocabulary of the area; the mathematics is
in the sibling modules (`Dual.lean`, `Constructive.lean`, `H3Wall.lean`, `Obstruction.lean`,
`Wiring.lean`).

The area `Submission/Work/WingbergRoute/` reduced the *unramified* route to Martinet's theorem to
the single arithmetic input

```
Work.WingbergRoute.KcUnitDualityWall      -- the unit half of Wingberg's duality at Kc
Work.WingbergRoute.gsFDeficiencyWall      -- df(G_∅) = dim H³(G_∅,ℤ)[2] ≤ d₂(O_gsF^×) = 2
```

whose remaining content is the `i = 0` instance of Wingberg's duality
`Ĥ^i(G_∅, O_{K_∅}^×) ≅ Ĥ^{3-i}(G_∅,ℤ)^∨` (Wingberg, Compositio Math. **131** (2002); NSW Ch. VIII
§8 Thm. 8.8.1).  This area does two things:

**(1) It isolates that input and shows what it is worth.**  `H3DeficiencyWall F` below is the
H³-half in the sharpest form the route needs, `H3DeficiencyWall_iff_gsFDeficiencyWall` identifies
it with the wall of `WingbergRoute`, and `H3UnitDualityWall F` records the classical normalisation
(Wingberg's duality in degree `0`, i.e. "`H³(G_∅,ℤ)^∨` is a quotient of the *finite* group
`(𝓞 F)^×/((𝓞 F)^×)²` of order `2 ^ unitTwoRank F`").  The chain
`H3UnitDualityWall F → H3DeficiencyWall F → WingbergRoute.gsFDeficiencyWall` is machine-checked.

**(2) It develops the *constructive* alternative, which gives the consumer's requirement without
Wingberg duality at all.**  Shafarevich's own proof of the relation-rank bound
`d₂(G_∅) ≤ d₁(G_∅) + d₂(O_F^×)` (Mayer, arXiv:1605.09617, Thm. `thm:RelationRank`; HMR,
arXiv:2103.09508, §2.2 and Lemma 1) proceeds by choosing a **saturated** finite set `S` of
`d₁(G_∅) + d₂(O_F^×)` tame primes whose Frobenii span the governing extension (Chebotarev +
Gras--Munnier), so that

* the inertia module `X_S = H_S/[H_S,G_∅]H_S²` is generated by `|S|` elements (HMR Lemma 1(i),
  pure group theory given the presentation of `G_S`), and
* `H²(G_∅,𝔽₂) ≅ X_S^∨` (Salle--Koch; HMR Lemma 1(ii)),

whence `dim_{𝔽₂} H²(G_∅,𝔽₂) ≤ |S| = d₁(G_∅) + d₂(O_F^×)`.  The *purely group-theoretic* end of
this argument -- "the 𝔽₂-dual of a pro-`2` group with a dense generating family of size `m` has at
most `2 ^ m` elements" -- is proved in `Dual.lean`; the two classical inputs are the structures
`InertiaModule` (Lemma 1(i)) and `SalleKochDetects` (Lemma 1(ii)) below, bundled in
`ConstructiveDatum`.

## Main declarations

* `Work.WingbergH3.DualTwo` -- the `𝔽₂`-dual `Hom_cont(X, ℤ/2)` of a topological group;
* `Work.WingbergH3.genRankTwo`, `relRankTwo`, `deficiencyTwo` -- `d₁`, `d₂`, `df` over `𝔽₂`;
* `Work.WingbergH3.H3DeficiencyWall`, `H3UnitDualityWall`, `SharpH3Wall` -- the `H³`-half in its
  three forms;
* `Work.WingbergH3.InertiaModule`, `SalleKochDetects`, `ConstructiveDatum` -- the constructive
  route's vocabulary;
* `Work.WingbergH3.SaturatedTameSetExists`, `KochSalleDuality`,
  `SaturatedTameSetExists`, `KochSalleDuality` -- the classical theorems, named.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped Classical
open NumberField

noncomputable section

namespace Work.WingbergH3

open Work.ConCohomology Work.ShafarevichKoch Work.ClassFieldTower

/-- The imaginary quadratic field `Kc = ℚ(√-30030)` of the Shafarevich--Koch chapter and of the
`Kc` instance of the unramified route. -/
abbrev Kc : Type := Work.WingbergRoute.Kc

/-- The totally real quadratic field `gsF = ℚ(√2576450045)`; its unramified pro-`2` tower is the
instance that reaches the benchmark `Submission.exists_totallyReal_discr_le`. -/
abbrev gsF : Type := Work.WingbergRoute.gsF

/-! ## 1. The `𝔽₂`-dual and the two ranks -/

/-- **The `𝔽₂`-dual of a topological group**: the continuous homomorphisms `X → ℤ/2`, written
multiplicatively so that they live in the same shape as
`Work.RelatorRank.Cohomology.card_continuousHom_eq_two_pow_generatorRank`, which counts them.

For a pro-`2` group `X` this is exactly the `2`-torsion `X^∨[2] = Hom_cont(X, ℤ/2)` of the
Pontryagin dual `X^∨ = Hom_cont(X, ℚ₂/ℤ₂)` (every `2`-torsion character of `X` takes values in
`(ℚ₂/ℤ₂)[2] = ℤ/2`). -/
abbrev DualTwo (X : Type*) [Group X] [TopologicalSpace X] : Type _ :=
  {f : X →* Multiplicative (ZMod 2) // Continuous f}

/-- **The generator rank `d₁(Γ) = dim_{𝔽₂} H¹(Γ,𝔽₂)`** of a topological group, presented as the
base-`2` logarithm of the cardinality of `H¹(Γ,𝔽₂)`.  `Nat.card` of an infinite type is `0`, so
this is `0` when `H¹` is infinite; every statement below carries the witness that the cardinality
*is* `2 ^ d`. -/
def genRankTwo (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : ℕ :=
  Nat.log 2 (Nat.card (H1 Γ (ZMod 2)))

/-- **The relation rank `d₂(Γ) = dim_{𝔽₂} H²_cont(Γ,𝔽₂)`**, as the base-`2` logarithm of the
cardinality of the continuous cohomology `H²(Γ,𝔽₂)`. -/
def relRankTwo (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : ℕ :=
  Nat.log 2 (Nat.card (Work.RelatorRank.contH2 Γ))

/-- **The deficiency `df(Γ) = d₂(Γ) − d₁(Γ)`** of HMR (arXiv:2103.09508, Notations: "usually the
deficiency is `d − r`, but for clarity we use the opposite").  The classical relation-rank bound
of Shafarevich reads `df(G_∅) ≤ d₂(O_F^×)`, and `Work.WingbergRoute.ShafarevichBound F M` is the
equivalent form `d₂(G_∅) ≤ d₁(G_∅) + d₂(O_F^×)`. -/
def deficiencyTwo (Γ : Type*) [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] : ℤ :=
  (relRankTwo Γ : ℤ) - (genRankTwo Γ : ℤ)

/-! ## 2. The `H³`-half of Wingberg's duality, in three forms -/

/-- **The `H³`-half of Wingberg's duality, in the deficiency form** (the sharpest form the
consumers need).

There is a maximal unramified pro-`2` extension `M` of `F` with `H²(G_∅,ℤ)`, `H³(G_∅,ℤ)` finite,
`#H¹(G_∅,𝔽₂) = 2 ^ d` for some `d` (so that `H¹` is the `𝔽₂`-vector space it should be), and
`#H³(G_∅,ℤ)[2] ≤ 2 ^ d₂(O_F^×)`.

This is exactly `Work.WingbergRoute.gsFDeficiencyWall` for `F = gsF`
(`H3DeficiencyWall_iff_gsFDeficiencyWall`) and `Work.WingbergRoute.KcH3Wall` for `F = Kc`
(`H3DeficiencyWall_Kc_iff_kcH3Wall`).  The classical theorem behind it is Wingberg's duality in
degree `0`: `H³(G_∅,ℤ)^∨ ≅ Ĥ⁰(G_∅, O_{K_∅}^×)`, the group of universal norms of units, which is a
quotient of `(𝓞 K)^×`; since the roots of unity are universal norms, the true bound is
`≤ 2 ^ (d₂(O_F^×) - 1)` (`SharpH3Wall`). -/
def H3DeficiencyWall (F : Type*) [Field F] [NumberField F] : Prop :=
  ∃ M : MaximalUnramifiedProP.{0} F 2,
    Finite (H2 (galoisGroup M) ℤ) ∧ Finite (H3 (galoisGroup M) ℤ) ∧
      (∃ d : ℕ, Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d) ∧
      Nat.card (twoTorsionH3 (galoisGroup M)) ≤ 2 ^ unitTwoRank F

/-- **The `H³`-half in the classical "unit half of the duality" normalisation**: the Pontryagin
dual of `H³(G_∅,ℤ)` is a quotient of the *finite* group `(𝓞 F)^× / ((𝓞 F)^×)²`, which has
`2 ^ unitTwoRank F` elements by Dirichlet's unit theorem
(`Work.ClassFieldTower.unitTwoRank_eq_finrank_units_modSquares`).

This is the general form of `Work.WingbergRoute.KcUnitDualityWall` (where `(𝓞 Kc)^× = {±1}` is
already finite, so the "squares" clause is vacuous) and it is the normalisation in which Wingberg's
theorem is quoted: `H³(G_∅,ℤ)^∨ ≅ Ĥ⁰(G_∅, O_{K_∅}^×) = E_F / N_{F_∅/F} E_{F_∅}` with
`E_F = ℤ₂ ⊗ (𝓞 F)^×` having `E_F / E_F²` of order `2 ^ unitTwoRank F`. -/
def H3UnitDualityWall (F : Type*) [Field F] [NumberField F] : Prop :=
  ∃ M : MaximalUnramifiedProP.{0} F 2,
    Finite (H2 (galoisGroup M) ℤ) ∧ Finite (H3 (galoisGroup M) ℤ) ∧
      (∃ d : ℕ, Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d) ∧
      ∃ N : Subgroup (RingUnit F),
        (Subgroup.closure (Set.range (fun x : (RingUnit F) => x ^ 2))) ≤ N ∧
          Finite (RingUnit F ⧸ N) ∧
          Nat.card (RingUnit F ⧸ N) ≤ 2 ^ unitTwoRank F ∧
          Nonempty (PDual (H3 (galoisGroup M) ℤ) ≃+ Additive (RingUnit F ⧸ N))

/-- **The sharp form of the `H³`-half**: Wingberg's duality together with the fact that the roots
of unity are universal norms (`N_{F_∅/F}(ζ) = ζ^{[F_∅:F]} = 1` for `ζ ∈ μ₂(F)`), which removes
one `𝔽₂`-dimension from the bound:

```
df(G_∅) = dim_{𝔽₂} H³(G_∅,ℤ)[2] ≤ d₂(O_F^×) - 1 .
```

For `Kc` this reads `#H³(G_∅,ℤ)[2] ≤ 1`, i.e. `H³(G_∅,ℤ) = 0`; for the benchmark base `gsF` it reads
`≤ 2`.  The walls of this area only need `H3DeficiencyWall` (one dimension more), so nothing here
asks for the sharp form -- see `H3DeficiencyWall_of_sharpH3Wall`. -/
def SharpH3Wall (F : Type*) [Field F] [NumberField F] : Prop :=
  ∃ M : MaximalUnramifiedProP.{0} F 2,
    Finite (H2 (galoisGroup M) ℤ) ∧ Finite (H3 (galoisGroup M) ℤ) ∧
      (∃ d : ℕ, Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d) ∧
      Nat.card (twoTorsionH3 (galoisGroup M)) ≤ 2 ^ (unitTwoRank F - 1)

/-! ## 3. The constructive route: the inertia module and Salle--Koch detection -/

/-- **The inertia module `X_S` of a saturated tame set `S`** (HMR, arXiv:2103.09508, §1.1:
`X_S = H_S/[H_S,G_∅]H_S²` where `H_S ⊴ G_S` is the closed normal subgroup generated by the inertia
subgroups of the primes in `S`).

Carried as a pro-`2` group together with a *dense generating family of size `m`*: by HMR
Lemma 1(i) the `𝔽₂⟦G_∅⟧`-module `X_S` is (topologically) generated by the images of the `|S|`
inertia elements, so `m = |S|` is available.  This is the *group-theoretic* half of the
constructive route. -/
structure InertiaModule (m : ℕ) where
  /-- the module `X_S`, as a pro-`2` group -/
  X : Type
  [groupX : Group X]
  [topX : TopologicalSpace X]
  [isTopX : IsTopologicalGroup X]
  [compactX : CompactSpace X]
  [t2X : T2Space X]
  [tdX : TotallyDisconnectedSpace X]
  /-- `X` is a pro-`2` group -/
  proX : Work.RelatorRank.IsProPGroup 2 X
  /-- the dense generating family, of size `|S|` -/
  gen : Fin m → X
  /-- the family is dense -/
  dense : Work.RelatorRank.DenseGenerating gen

attribute [instance] InertiaModule.groupX InertiaModule.topX InertiaModule.isTopX
  InertiaModule.compactX InertiaModule.t2X InertiaModule.tdX

/-- **Salle--Koch detection of the relations by the inertia module**: the relation group
`H²(G_∅,𝔽₂) = Sha_∅` embeds into the `𝔽₂`-dual of `X_S`.

This is HMR Lemma 1(ii) in the case `S` saturated with `d(G_S) = d(G_∅)`: the five-term exact
sequence `H¹(G_∅) → H¹(G_S) → X_S^∨ → Sha_∅ → Sha_S` degenerates to `X_S^∨ ≅ Sha_∅ = H²(G_∅,𝔽₂)`,
and `H²(G_∅,𝔽₂)` is killed by `2`, so the isomorphism lands in the `2`-torsion of the Pontryagin
dual, i.e. in `DualTwo X_S`.  (`Sha_∅` here is the kernel of the localisation over the *empty* set
of places, which is all of `H²(G_∅,𝔽₂)`.) -/
def SalleKochDetects (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    {m : ℕ} (I : InertiaModule m) : Prop :=
  ∃ φ : Work.RelatorRank.contH2 G → DualTwo I.X, Function.Injective φ

/-- **The constructive datum**: a maximal unramified pro-`2` extension `M` of `F`, the generator
rank `d` of `G_∅`, an inertia module `X_S` generated by `|S| = d + d₂(O_F^×)` elements and the
Salle--Koch injection `H²(G_∅,𝔽₂) ↪ X_S^∨`.

Everything classical about the constructive route is in the *existence* of this datum; the
consequence `dim H² ≤ d + d₂(O_F^×)` is `contH2DimLe_of_constructiveDatum` in `Dual.lean`, and the
consequence for the consumer is `gsFWingbergWall_of_constructiveInput` in `Constructive.lean`. -/
structure ConstructiveDatum (F : Type*) [Field F] [NumberField F] where
  /-- the maximal unramified pro-`2` extension -/
  M : MaximalUnramifiedProP.{0} F 2
  /-- the generator rank of `G_∅` -/
  d : ℕ
  /-- `d` really is the generator rank: `#H¹(G_∅,𝔽₂) = 2 ^ d` -/
  hd : Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d
  /-- the inertia module of a saturated tame set of `d + d₂(O_F^×)` primes -/
  I : InertiaModule (d + unitTwoRank F)
  /-- Salle--Koch: the relations of `G_∅` are detected by `X_S` -/
  detects : SalleKochDetects (galoisGroup M) I

/-- **The constructive route's arithmetic input.**  It is *strictly* more elementary than
Wingberg's duality: nothing here mentions `H³`, idèle class groups or Tate duality. -/
def ConstructiveInput (F : Type*) [Field F] [NumberField F] : Prop :=
  Nonempty (ConstructiveDatum F)

/-! ## 4. The classical theorems behind the constructive input, named

The classical ingredients of the constructive route, each stated as its own `Prop` so that a
future session knows exactly what is left.  The *first* is pure group theory (given the
presentation of `G_S`); the others are the arithmetic input. -/

/-- **HMR Lemma 1(i) / Shafarevich's rank formula**, recorded as what supplies the *harness*
of the constructive route.  For a finite set `S` of tame primes, the inertia module
`X_S = H_S/[H_S,G_∅]H_S²` is topologically generated by the images of the inertia elements
`τ_𝔭`, `𝔭 ∈ S`, i.e. by at most `|S|` elements; equivalently (Shafarevich's rank formula
`d(G_S) = |S| - d₂(O_F^×) + d(V_S/(F^×)²)`, HMR equation `rank_formula`, quoted from NSW Ch. X §7
Cor. 10.7.7) a *saturated* `S` has `d(G_S) = |S| - d₂(O_F^×)`, so `S` of size `d₁(G_∅) + d₂(O_F^×)`
has `d(G_S) = d₁(G_∅)`.

This is a statement about the *carrier object* `X_S`, and it is precisely the part of the two
classical theorems below that concerns the covering data: neither `SaturatedTameSetExists` nor
`KochSalleDuality` is meaningful without an object generated by `|S|` elements to receive the
relations.  (The *bare* generating-family harness `InertiaModule m` is inhabited for every `m`, so
its content is entirely in the two theorems below; see `Work.WingbergH3.Constructive`.) -/
def InertiaHarness (F : Type*) [Field F] [NumberField F]
    (M : MaximalUnramifiedProP.{0} F 2) (m : ℕ) : Prop :=
  Nonempty (InertiaModule m)

