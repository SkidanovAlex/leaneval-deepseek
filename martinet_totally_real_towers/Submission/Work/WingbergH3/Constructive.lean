import Mathlib
import Submission.Work.WingbergH3.Dual
import Submission.Work.WingbergRoute.gsFWall

/-!
# `Work.WingbergH3.Constructive` -- the constructive route to the relation-rank bound

Two normalisations of the *constructive* (Shafarevich--Salle--Koch) route to
`d₂(G_∅) ≤ d₁(G_∅) + d₂(O_F^×)`, and the passage from each to the consumer's `ContH2DimLe`.

**The pro-`2` form** (`Defs.lean`, `Dual.lean`): an inertia module `X_S` generated by
`|S| = d₁ + d₂(O_F^×)` elements whose `𝔽₂`-dual receives `H²(G_∅,𝔽₂)` (`SalleKochDetects`); the
passage `#H²(G_∅,𝔽₂) ≤ 2^{|S|}` is `contH2DimLe_of_salleKochDetection`.

**The Kummer form** (`KummerCarrier` below): a finite `𝔽₂`-vector space `V` of cardinal
`≤ 2^{m}` -- classically `V = V_∅/(F^×)²`, the Kummer group of the unramified quadratic radical,
of cardinal `2^{d₂(O_F^×) + rank₂ Cl_F}` -- whose `𝔽₂`-dual receives `H²(G_∅,𝔽₂)`.  This is the
shape of Koch--Salle's injection `Sha_∅ ↪ (V_∅/(F^×)²)^∨` (Salle, *Invent. Math.* **44** (1978),
Théorème 4.1; Koch, *Galois theory of `p`-extensions*, Ch. 11 Thm. 11.3), and it needs no topology:
`#H² ≤ #V* = #V` by the elementary dual count `#V* = #V` for a finite-dimensional vector space over
a finite field.

Everything *group-theoretic* about both routes is proved here and in `Dual.lean`; what remains in
either case is the classical arithmetic identification, named as `SalleKochDetects`
(`Defs.lean`), `KummerCarrier`, `SaturatedTameSetExists` and `KochSalleDuality`.

## Main declarations

* `Work.WingbergH3.KummerCarrier`, `Work.WingbergH3.KummerCarrierInput`,
  `Work.WingbergH3.contH2DimLe_of_kummerCarrier`;
* `Work.WingbergH3.KummerDatum`, `Work.WingbergH3.KummerInput`,
  `Work.WingbergH3.shafarevichBound_of_kummerInput`;
* `Work.WingbergH3.gsFWingbergWall_of_kummerInput`,
  `Work.WingbergH3.kcWingbergWall_of_kummerInput`;
* `Work.WingbergH3.gsFWingbergWall_of_constructiveInput`,
  `Work.WingbergH3.kcWingbergWall_of_constructiveInput`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 2000000

open scoped Classical
open NumberField

noncomputable section

namespace Work.WingbergH3

open Work.ConCohomology Work.ShafarevichKoch Work.ClassFieldTower

/-! ## The Kummer form of the constructive input -/

/-- **A Kummer carrier** for the relation group `H²(G,𝔽₂)`: a finite `𝔽₂`-vector space `V` of
cardinal at most `2 ^ m` together with an injection of `H²(G,𝔽₂)` into its `𝔽₂`-dual.

Classically `V = V_∅/(F^×)²` and the injection is Salle's. -/
structure KummerCarrier (m : ℕ) (G : Type*) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] where
  /-- the Kummer group, as an `𝔽₂`-vector space -/
  V : Type
  [addV : AddCommGroup V]
  [modV : Module (ZMod 2) V]
  [finV : Finite V]
  /-- the carrier has at most `2 ^ m` elements -/
  hcard : Nat.card V ≤ 2 ^ m
  /-- the Salle--Koch detection of the relations by the dual of the carrier -/
  φ : Work.RelatorRank.contH2 G → Module.Dual (ZMod 2) V
  /-- the detection is injective -/
  inj : Function.Injective φ

attribute [instance] KummerCarrier.addV KummerCarrier.modV KummerCarrier.finV

/-- The Kummer-carrier form of the Salle--Koch input. -/
def KummerCarrierInput (G : Type*) [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    (m : ℕ) : Prop :=
  Nonempty (KummerCarrier m G)

/-- **The relation rank is bounded by the Kummer carrier.**  An injection `H²(G,𝔽₂) ↪ V*` with
`#V ≤ 2 ^ m` bounds `dim_{𝔽₂} H²(G,𝔽₂)` by `m`: for a finite-dimensional vector space over a
finite field the dual has the same cardinality (`Module.finrank_dual`), so
`#H² ≤ #V* = #V ≤ 2 ^ m`. -/
theorem contH2DimLe_of_kummerCarrier {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] {m : ℕ} (h : KummerCarrierInput G m) :
    Work.RelatorRank.ContH2DimLe G m := by
  obtain ⟨C⟩ := h
  haveI := C.finV
  haveI : Module.Finite (ZMod 2) C.V := Module.Finite.of_finite
  haveI : Finite (Module.Dual (ZMod 2) C.V) :=
    Finite.of_injective (fun f : Module.Dual (ZMod 2) C.V => (f : C.V → ZMod 2))
      (fun f g h => LinearMap.ext fun v => congrFun h v)
  have hdual : Nat.card (Module.Dual (ZMod 2) C.V) = Nat.card C.V := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Module.Dual (ZMod 2) C.V),
      Module.natCard_eq_pow_finrank (K := ZMod 2) (V := C.V), Nat.card_zmod,
      Subspace.dual_finrank_eq]
  haveI : Finite (Work.RelatorRank.contH2 G) := Finite.of_injective C.φ C.inj
  refine contH2DimLe_of_card_le inferInstance ?_
  calc Nat.card (Work.RelatorRank.contH2 G) ≤ Nat.card (Module.Dual (ZMod 2) C.V) :=
        Nat.card_le_card_of_injective C.φ C.inj
    _ = Nat.card C.V := hdual
    _ ≤ 2 ^ m := C.hcard

/-- **The Kummer datum**: a maximal unramified pro-`2` extension `M` of `F`, the generator rank `d`
of `G_∅`, and a Kummer carrier of cardinal at most `2 ^ (d + d₂(O_F^×))` receiving
`H²(G_∅,𝔽₂)` in its dual.  Classically the carrier is `V_∅/(F^×)²` and its cardinality is
`2 ^ (d₂(O_F^×) + rank₂ Cl_F) = 2 ^ (d + d₂(O_F^×))` because `d₁(G_∅) = rank₂ Cl_F`
(unramified class field theory). -/
structure KummerDatum (F : Type*) [Field F] [NumberField F] where
  /-- the maximal unramified pro-`2` extension -/
  M : MaximalUnramifiedProP.{0} F 2
  /-- the generator rank of `G_∅` -/
  d : ℕ
  /-- `d` really is the generator rank -/
  hd : Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d
  /-- the Kummer carrier -- classically `V_∅/(F^×)²` -/
  carrier : KummerCarrier (d + unitTwoRank F) (galoisGroup M)

/-- **The Kummer form of the constructive route's arithmetic input.** -/
def KummerInput (F : Type*) [Field F] [NumberField F] : Prop := Nonempty (KummerDatum F)

/-- **The Kummer input gives the relation count**: `dim_{𝔽₂} H²(G_∅,𝔽₂) ≤ d + d₂(O_F^×)`. -/
theorem shafarevichBound_of_kummerInput {F : Type} [Field F] [NumberField F]
    (h : KummerInput F) :
    ∃ M : MaximalUnramifiedProP.{0} F 2, ∃ k d : ℕ,
      Nat.card (Work.RelatorRank.contH2 (galoisGroup M)) = 2 ^ k ∧
        Nat.card (H1 (galoisGroup M) (ZMod 2)) = 2 ^ d ∧ k ≤ d + unitTwoRank F := by
  obtain ⟨D⟩ := h
  obtain ⟨k, hk, hcard⟩ := contH2DimLe_of_kummerCarrier (G := galoisGroup D.M) ⟨D.carrier⟩
  exact ⟨D.M, k, D.d, hcard, D.hd, hk⟩

/-- **The totally real wall from the Kummer input.** -/
theorem gsFWingbergWall_of_kummerInput (h : KummerInput gsF) :
    Work.WingbergRoute.gsFWingbergWall := by
  obtain ⟨M, k, d, hcard, hd, hk⟩ := shafarevichBound_of_kummerInput h
  exact ⟨M, k, d, hcard, hd, hk⟩

/-- **The `Kc` wall from the Kummer input.** -/
theorem kcWingbergWall_of_kummerInput (h : KummerInput Kc) :
    Work.WingbergRoute.KcWingbergWall := by
  obtain ⟨M, k, d, hcard, hd, hk⟩ := shafarevichBound_of_kummerInput h
  exact ⟨M, k, d, hcard, hd, hk⟩

/-! ## The pro-`2` (inertia-module) form -/

/-- **The totally real wall from the constructive input.** -/
theorem gsFWingbergWall_of_constructiveInput (h : ConstructiveInput gsF) :
    Work.WingbergRoute.gsFWingbergWall := by
  obtain ⟨D⟩ := h
  obtain ⟨k, hk, hcard⟩ := contH2DimLe_of_constructiveDatum D
  exact ⟨D.M, k, D.d, hcard, D.hd, hk⟩

/-- **The `Kc` wall from the constructive input.** -/
theorem kcWingbergWall_of_constructiveInput (h : ConstructiveInput Kc) :
    Work.WingbergRoute.KcWingbergWall := by
  obtain ⟨D⟩ := h
  obtain ⟨k, hk, hcard⟩ := contH2DimLe_of_constructiveDatum D
  exact ⟨D.M, k, D.d, hcard, D.hd, hk⟩

end Work.WingbergH3
