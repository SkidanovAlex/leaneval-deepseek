import Mathlib
import Submission.Work.ProPDeficiency.Basic

namespace Work.ProPDeficiency

-- File: Submission/Work/ProPDeficiency/dGens_freeGroup.lean, namespace `Work.ProPDeficiency`.
-- The free group on `α` is generated by `α` and by no fewer elements, so `dGens (FreeGroup α)` is
-- `Fintype.card α` (`dGens` is defined in `Submission.Work.ProPDeficiency.Basic`).
-- Suggested proof: `dGens ≤ card α` because `FreeGroup.closure_range_of` says the images of the
-- generators generate; for `card α ≤ dGens`, take a generating finset `S` with `S.card = dGens`
-- (`exists_generatingSet_card_dGens`) and restrict homs to `Multiplicative (ZMod 2)`: a hom is
-- determined by its values on `S`, so `2 ^ Fintype.card α = Nat.card (FreeGroup α →* Multiplicative (ZMod 2))`
-- (free universal property, `FreeGroup.lift`) is at most `2 ^ S.card`, hence `card α ≤ dGens`.

/-- Two group homomorphisms that agree on a generating set (a set whose closure is `⊤`) are equal. -/
theorem monoidHom_ext_of_closure_eq_top {G M : Type*} [Group G] [Group M] (f g : G →* M)
    {S : Set G} (hS : Subgroup.closure S = ⊤) (h : ∀ x ∈ S, f x = g x) : f = g := by
  ext x
  have hx : x ∈ Subgroup.closure S := by rw [hS]; trivial
  exact Subgroup.closure_induction (p := fun y _ => f y = g y)
    (fun y hy => h y hy) (by simp)
    (fun y z _ _ ihy ihz => by rw [map_mul, map_mul, ihy, ihz])
    (fun y _ ihy => by rw [map_inv, map_inv, ihy]) hx

theorem dGens_freeGroup (α : Type) [Fintype α] : dGens (FreeGroup α) = Fintype.card α := by
  classical
  -- The images of the generators form a finite generating set.
  set S₀ : Finset (FreeGroup α) := Finset.univ.image (FreeGroup.of : α → FreeGroup α) with hS₀
  have hgen₀ : IsGeneratingSet S₀ := by
    rw [isGeneratingSet_iff]
    have hcoe : (S₀ : Set (FreeGroup α)) = Set.range (FreeGroup.of : α → FreeGroup α) := by
      rw [hS₀, Finset.coe_image, Finset.coe_univ, Set.image_univ]
    rw [hcoe, FreeGroup.closure_range_of]
  refine le_antisymm ?_ ?_
  · -- Upper bound: the images of the generators generate, and there are at most `card α` of them.
    calc dGens (FreeGroup α) ≤ S₀.card := dGens_le_card hgen₀
      _ ≤ Fintype.card α := Finset.card_image_le
  · -- Lower bound: counting homomorphisms to the two-element group.
    obtain ⟨S, hSgen, hScard⟩ := exists_generatingSet_card_dGens (G := FreeGroup α) ⟨S₀, hgen₀⟩
    rw [← hScard]
    let M := Multiplicative (ZMod 2)
    have hMcard : Fintype.card M = 2 := by
      simp [M, Fintype.card_multiplicative, ZMod.card]
    -- Any hom out of `FreeGroup α` is determined by its values on the generating set `S`, so the
    -- restriction map `(α → M) → (↥S → M)` (through the universal property `FreeGroup.lift`) is
    -- injective; counting both sides gives `2 ^ card α ≤ 2 ^ S.card`.
    set Φ : (α → M) → (↥S → M) := fun φ => fun s => FreeGroup.lift φ s.1 with hΦ
    have hinj : Function.Injective Φ := by
      intro φ ψ hφψ
      have hhom : FreeGroup.lift φ = FreeGroup.lift ψ := by
        refine monoidHom_ext_of_closure_eq_top _ _ hSgen ?_
        intro x hx
        exact congr_fun hφψ ⟨x, hx⟩
      exact FreeGroup.lift.injective hhom
    have hle := Fintype.card_le_of_injective Φ hinj
    rw [Fintype.card_fun, Fintype.card_fun, hMcard, Fintype.card_coe] at hle
    exact (Nat.pow_le_pow_iff_right (by norm_num : 1 < 2)).mp hle

end Work.ProPDeficiency
