import Mathlib
import Submission.Work.ProPDeficiency.Basic
import Submission.Work.ProPDeficiency.HomRank

/-!
# A surjection onto `(𝔽_p)^n` forces `n` generators

**Namespace** `Work.ProPDeficiency`; module
`Submission.Work.ProPDeficiency.le_dGens_of_surjective_zmod_pow`.

If a finitely generated group `G` admits a surjection onto the elementary abelian `p`-group of
rank `n`, then `G` needs at least `n` generators.  This is the arithmetic form of "`d ≥ |S|`",
where the surjection comes from a multiquadratic subextension of the maximal pro-`p` extension.

The mathematical content is the classical fact that `(𝔽_p)^n` cannot be generated by fewer than
`n` elements.  We prove it through the `𝔽_p`-vector space structure: a generating set `A` of
`(𝔽_p)^n` spans it as an `𝔽_p`-vector space, and a spanning set has at least `finrank = n`
elements (`finrank_span_le_card`).  The group `(𝔽_p)^n` is written multiplicatively as
`Fin n → Multiplicative (ZMod p)`; to use the vector space structure we pass to the isomorphic
group `Multiplicative (Fin n → ZMod p)` (whose group operation is pointwise addition of the
underlying elements of `ZMod p`), where subgroups of the form `Subgroup.closure A` correspond to
additive subgroups, hence to `ZMod p`-submodules.

`dGens`, `IsGeneratingSet` and `dGens_le_of_surjective` (a surjective homomorphism cannot
increase `dGens`) are in `Submission.Work.ProPDeficiency.Basic`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.ProPDeficiency

/-- The group `Fin n → Multiplicative (ZMod p)` (with pointwise multiplication, i.e. pointwise
addition in `ZMod p`) and the group `Multiplicative (Fin n → ZMod p)` (whose multiplication is
addition in the additive group `Fin n → ZMod p`) are canonically isomorphic. -/
noncomputable def piMulEquiv (n p : ℕ) :
    (Fin n → Multiplicative (ZMod p)) ≃* Multiplicative (Fin n → ZMod p) where
  toFun x := Multiplicative.ofAdd fun i => (x i).toAdd
  invFun y := fun i => Multiplicative.ofAdd (y.toAdd i)
  left_inv x := by funext i; simp
  right_inv y := by ext : 1; simp
  map_mul' x y := by rfl

/-- **The elementary abelian `p`-group needs `n` generators.**  If a finset `A` generates the
group `Multiplicative (Fin n → ZMod p)` — that is, the additive group `(ZMod p)^n` — then
`n ≤ A.card`.

Proof: translating subgroups along `Subgroup.toAddSubgroup'`, the hypothesis says that `A` spans
`Fin n → ZMod p` as an additive subgroup, hence also as a `ZMod p`-submodule; a spanning set of
a finite dimensional vector space has at least `finrank = n` elements. -/
theorem card_le_of_closure_eq_top {p n : ℕ} [Fact p.Prime]
    (A : Finset (Multiplicative (Fin n → ZMod p)))
    (hA : Subgroup.closure (A : Set (Multiplicative (Fin n → ZMod p))) = ⊤) :
    n ≤ A.card := by
  have htop : Subgroup.toAddSubgroup' (⊤ : Subgroup (Multiplicative (Fin n → ZMod p))) = ⊤ :=
    OrderIso.map_top _
  -- Translate the generation hypothesis to the additive group `(ZMod p)^n`.
  have hclos : AddSubgroup.closure
      (Multiplicative.ofAdd ⁻¹' (A : Set (Multiplicative (Fin n → ZMod p)))) = ⊤ := by
    rw [← Subgroup.toAddSubgroup'_closure (S := (A : Set (Multiplicative (Fin n → ZMod p)))),
      hA, htop]
  set B : Finset (Fin n → ZMod p) := A.image Multiplicative.toAdd with hBdef
  have hBcoe : (Multiplicative.ofAdd ⁻¹' (A : Set (Multiplicative (Fin n → ZMod p))))
      = (B : Set (Fin n → ZMod p)) := by
    ext y
    simp only [Set.mem_preimage, Finset.mem_coe, hBdef, Finset.mem_image]
    exact ⟨fun hy => ⟨Multiplicative.ofAdd y, hy, rfl⟩, by rintro ⟨a, ha, rfl⟩; simpa using ha⟩
  -- `B` spans the `ZMod p`-vector space `(ZMod p)^n`.
  have hspan : Submodule.span (ZMod p) (B : Set (Fin n → ZMod p)) = ⊤ := by
    refine eq_top_iff.mpr fun x _ => ?_
    have hx : x ∈ AddSubgroup.closure (B : Set (Fin n → ZMod p)) := by
      rw [← hBcoe, hclos]; trivial
    have hle : AddSubgroup.closure (B : Set (Fin n → ZMod p))
        ≤ (Submodule.span (ZMod p) (B : Set (Fin n → ZMod p))).toAddSubgroup :=
      (AddSubgroup.closure_le _).mpr (fun y hy => Submodule.subset_span hy)
    exact hle hx
  have hfr : Module.finrank (ZMod p) (Fin n → ZMod p) ≤ B.card := by
    have h := finrank_span_le_card (R := ZMod p) (M := Fin n → ZMod p)
      (s := (B : Set (Fin n → ZMod p)))
    rw [hspan, finrank_top, Finset.toFinset_coe] at h
    exact h
  rw [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at hfr
  exact hfr.trans (by rw [hBdef]; exact Finset.card_image_le)

/-- **The elementary abelian `p`-group needs `n` generators**, in the multiplicatively written
form `Fin n → Multiplicative (ZMod p)` used on the arithmetic side. -/
theorem card_le_of_closure_eq_top_pi {p n : ℕ} [Fact p.Prime]
    (A : Finset (Fin n → Multiplicative (ZMod p)))
    (hA : Subgroup.closure (A : Set (Fin n → Multiplicative (ZMod p))) = ⊤) :
    n ≤ A.card := by
  have hgen : Subgroup.closure
      ((A.image (piMulEquiv n p) : Finset (Multiplicative (Fin n → ZMod p))) :
        Set (Multiplicative (Fin n → ZMod p))) = ⊤ := by
    have h1 : Subgroup.map (piMulEquiv n p).toMonoidHom (Subgroup.closure (A : Set _))
        = Subgroup.closure ((piMulEquiv n p).toMonoidHom '' (A : Set _)) :=
      MonoidHom.map_closure _ _
    rw [hA, Subgroup.map_top_of_surjective _ (piMulEquiv n p).surjective] at h1
    rw [Finset.coe_image]
    exact h1.symm
  calc n ≤ (A.image (piMulEquiv n p)).card := card_le_of_closure_eq_top _ hgen
    _ ≤ A.card := Finset.card_image_le

-- File: Submission/Work/ProPDeficiency/le_dGens_of_surjective_zmod_pow.lean, namespace `Work.ProPDeficiency`.
-- If a finitely generated group `G` admits a surjection onto the elementary abelian `p`-group of
-- rank `n`, then `G` needs at least `n` generators.  This is the arithmetic form of "`d ≥ |S|`",
-- where the surjection comes from a multiquadratic subextension of the maximal pro-`p` extension.
-- `dGens`, `IsGeneratingSet` and `dGens_le_of_surjective` (a surjective homomorphism cannot
-- increase `dGens`) are in `Submission.Work.ProPDeficiency.Basic`.
theorem le_dGens_of_surjective_zmod_pow {p n : ℕ} [Fact p.Prime] {G : Type*} [Group G]
    [Group.FG G] (f : G →* (Fin n → Multiplicative (ZMod p)))
    (hf : Function.Surjective f) : n ≤ dGens G := by
  classical
  -- A generating finset `S` of `G` of cardinality `dGens G`.
  obtain ⟨S, hSgen, hScard⟩ :=
    exists_generatingSet_card_dGens (G := G) (by
      obtain ⟨k, T, hk, hT⟩ := Group.fg_iff'.mp ‹Group.FG G›
      exact ⟨T, hT⟩)
  -- Its image generates the elementary abelian `p`-group.
  have hgen : Subgroup.closure
      ((S.image f : Finset (Fin n → Multiplicative (ZMod p))) :
        Set (Fin n → Multiplicative (ZMod p))) = ⊤ := by
    rw [Finset.coe_image, ← MonoidHom.map_closure f (S : Set G), hSgen]
    exact Subgroup.map_top_of_surjective f hf
  calc n ≤ (S.image f).card := card_le_of_closure_eq_top_pi _ hgen
    _ ≤ S.card := Finset.card_image_le
    _ = dGens G := hScard

end Work.ProPDeficiency
