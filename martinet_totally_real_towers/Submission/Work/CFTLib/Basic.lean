import Mathlib
import Submission.CFTLib.Interfaces
import Submission.Work.Tower.Unramified.Basic
import Submission.Work.Tower.Unramified.Discriminant
import Submission.Work.Tower.Unramified.Compositum
import Submission.Work.Tower.Unramified.isUnramifiedExtensionForallPrimes_sup

/-!
# Bridges between the `CFTLib` interfaces and the `Work.Tower` vocabulary

The interfaces `CFTLib.IsUnramified` / `CFTLib.SplitsAt` are phrased with `differentIdeal`,
`IsUnramifiedAtInfinitePlaces` and `Ideal.inertiaDegIn`, while the tower library
(`Submission/Work/Tower`) uses the "every prime has ramification index one" predicate
`Work.Tower.IsUnramifiedExtensionForallPrimes`.  This file records the translation and a few
transport lemmas used by `Work.CFTLib.maximalClassCond`.
-/

open NumberField
open scoped Classical nonZeroDivisors

namespace Work.CFTLib

/-! ## The subgroup of the class group generated by the primes above `T` -/

/-- The subgroup of `Cl(𝓞 K)` generated by the classes of the primes of `K` lying over a prime
in the finite set `T` of primes of `F`. -/
noncomputable def primeClassSubgroup (F K : Type) [Field F] [NumberField F] [Field K]
    [NumberField K] [Algebra F K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) : Subgroup (ClassGroup (𝓞 K)) :=
  Subgroup.closure {d : ClassGroup (𝓞 K) |
    ∃ w : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      (∃ v ∈ T, w.asIdeal.LiesOver v.asIdeal) ∧
        d = ClassGroup.mk0 ⟨w.asIdeal, mem_nonZeroDivisors_of_ne_zero w.ne_bot⟩}

variable {F K L L' : Type}

/-- `CFTLib.ClassCond` is the statement that every `p`-power class lies in
`primeClassSubgroup`. -/
theorem classCond_iff [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K] (p : ℕ)
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) :
    CFTLib.ClassCond F K p T ↔
      ∀ c : ClassGroup (𝓞 K), (∃ k : ℕ, c ^ (p ^ k) = 1) →
        c ∈ primeClassSubgroup F K T :=
  Iff.rfl

/-! ## Unramifiedness -/

/-- `differentIdeal = ⊤` gives the "every prime has ramification index one" predicate. -/
theorem forallPrimes_of_differentIdeal [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L]
    (h : differentIdeal (𝓞 F) (𝓞 L) = ⊤) :
    Work.Tower.IsUnramifiedExtensionForallPrimes F L :=
  Work.Tower.isUnramifiedExtensionForallPrimes_iff_differentIdeal_eq_top.mpr h

/-- The "every prime has ramification index one" predicate gives `differentIdeal = ⊤`. -/
theorem differentIdeal_of_forallPrimes [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L]
    (h : Work.Tower.IsUnramifiedExtensionForallPrimes F L) :
    differentIdeal (𝓞 F) (𝓞 L) = ⊤ :=
  Work.Tower.isUnramifiedExtensionForallPrimes_iff_differentIdeal_eq_top.mp h

/-- `CFTLib.IsUnramified` (finite part) implies the strong unramifiedness predicate. -/
theorem forallPrimes_of_isUnramified [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L] (h : CFTLib.IsUnramified F L) :
    Work.Tower.IsUnramifiedExtensionForallPrimes F L :=
  forallPrimes_of_differentIdeal h.1

/-- The strong unramifiedness predicate plus unramifiedness at infinity gives
`CFTLib.IsUnramified`. -/
theorem isUnramified_of_forallPrimes [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L]
    (h : Work.Tower.IsUnramifiedExtensionForallPrimes F L)
    (hinf : IsUnramifiedAtInfinitePlaces F L) : CFTLib.IsUnramified F L :=
  ⟨differentIdeal_of_forallPrimes h, hinf⟩

/-! ## Splitting -/

/-- For a Galois extension the (choice-free) value `Ideal.inertiaDegIn` is the inertia degree of
every prime above the given prime. -/
theorem inertiaDegIn_eq_of_liesOver [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    {v : IsDedekindDomain.HeightOneSpectrum (𝓞 F)} {P : Ideal (𝓞 L)}
    (hP : P.IsPrime) (hLies : P.LiesOver v.asIdeal) :
    Ideal.inertiaDegIn v.asIdeal (𝓞 L) = P.inertiaDeg (𝓞 F) := by
  have := hP
  have := hLies
  exact Ideal.inertiaDegIn_eq_inertiaDeg v.asIdeal P Gal(L/F)

/-- `CFTLib.SplitsAt`, for a Galois extension, is the statement that *every* prime above a prime
of `T` has inertia degree one. -/
theorem splitsAt_iff_forall [Field F] [NumberField F] [Field L] [NumberField L]
    [Algebra F L] [FiniteDimensional F L] [IsGalois F L]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) :
    CFTLib.SplitsAt F L T ↔
      ∀ v ∈ T, ∀ P : Ideal (𝓞 L), P.IsPrime → P.LiesOver v.asIdeal →
        P.inertiaDeg (𝓞 F) = 1 := by
  constructor
  · intro h v hv P hP hLies
    rw [← inertiaDegIn_eq_of_liesOver (F := F) (L := L) (v := v) hP hLies]
    exact h v hv
  · intro h v hv
    obtain ⟨P, hP, hle⟩ : ∃ P : Ideal (𝓞 L), P.IsPrime ∧ P.LiesOver v.asIdeal := by
      have := v.isPrime
      have := v.ne_bot
      obtain ⟨Q⟩ := (inferInstance : Nonempty (v.asIdeal.primesOver (𝓞 L)))
      exact ⟨Q.1, Q.2.1, Q.2.2⟩
    rw [inertiaDegIn_eq_of_liesOver (F := F) (L := L) (v := v) hP hle]
    exact h v hv P hP hle

end Work.CFTLib

namespace Work.CFTLib

section ToOver

variable {F A : Type} [Field F] [Field A] [Algebra F A]

/-- A subfield `E` of `A` containing `K'` is also a subfield of `A` viewed as an algebra over
`↥K'`; this records the (definitionally equal) subfield object in that presentation, so that the
tower `↥K' ⊆ ↥E` has its canonical algebra structure and degrees. -/
noncomputable def toOver {K' E : IntermediateField F A} (h : K' ≤ E) :
    IntermediateField ↥K' A :=
  { E.toSubfield with algebraMap_mem' := fun x => h x.2 }

variable {K' E : IntermediateField F A} {h : K' ≤ E}

@[simp] theorem mem_toOver {x : A} : x ∈ toOver h ↔ x ∈ E := Iff.rfl

theorem coe_toOver : (toOver h : Set A) = (E : Set A) := rfl

theorem toOver_le_iff {E₁ E₂ : IntermediateField F A} (h₁ : K' ≤ E₁) (h₂ : K' ≤ E₂) :
    toOver h₁ ≤ toOver h₂ ↔ E₁ ≤ E₂ := Iff.rfl

/-- The canonical `F`-algebra structure on the type underlying `toOver h` is induced by
`↥K'`. -/
theorem algebraMap_toOver (x : ↥K') :
    algebraMap ↥K' ↥(toOver h) x = (⟨x.1, h x.2⟩ : ↥E) := rfl

end ToOver

section Conj

variable {F : Type} [Field F] [NumberField F]

/-- **The compositum of the conjugates of a field `L'` lying over `K'`**, inside the algebraic
closure `A = AlgebraicClosure F`: the supremum of the images `σ(L')` for
`σ : Gal(K'/F)`, where `σ` is extended to an `F`-algebra automorphism of `A` by
`AlgEquiv.liftNormal`. -/
noncomputable def conjSup (p : ℕ) (K' : IntermediateField F (AlgebraicClosure F))
    (L' : IntermediateField ↥K' (AlgebraicClosure F)) :
    IntermediateField F (AlgebraicClosure F) :=
  ⨆ σ : ↥K' ≃ₐ[F] ↥K',
    (L'.restrictScalars F).map (σ.liftNormal (AlgebraicClosure F)).toAlgHom

end Conj

end Work.CFTLib
