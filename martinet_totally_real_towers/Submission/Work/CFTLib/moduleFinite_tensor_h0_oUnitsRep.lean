import Mathlib
import Submission.Work.CFTLib.RelShafReps
import Submission.Work.CFTLib.oUnits_invariants_surjective
import Submission.Work.CFTLib.rankP_h0_oUnits_le

/-!
# Finiteness of `𝔽_p ⊗_ℤ Ĥ⁰(Gal(K/F), 𝒪_Kˣ)`

For a finite Galois extension `K/F` of number fields and `G = Gal(K/F)`, the zeroth Tate
cohomology `Ĥ⁰(G, 𝒪_Kˣ)` is the quotient `(𝒪_Kˣ)^G / N_{K/F}(𝒪_Kˣ)` of the group of Galois-fixed
units, hence a quotient of `𝒪_Fˣ` (`Work.CFTLib.oUnits_invariants_surjective`).  Since the unit
group of a number field is finitely generated (Dirichlet's unit theorem), `Ĥ⁰(G, 𝒪_Kˣ)` is a
finitely generated abelian group, and so its base change `𝔽_p ⊗_ℤ Ĥ⁰(G, 𝒪_Kˣ)` is a finite
`𝔽_p`-module.  This is the finiteness input needed to speak about the `𝔽_p`-rank of
`Ĥ⁰(G, 𝒪_Kˣ)` (compare `Work.CFTLib.rankP_h0_oUnits_le`).

## Main results

* `Work.CFTLib.moduleFinite_int_of_surjective_addHom`
* `Work.CFTLib.moduleFinite_tensor_h0_oUnitsRep`
-/

open NumberField

set_option linter.style.haveILetI false

noncomputable section

namespace Work.CFTLib

/-- A `ℤ`-module that is a quotient of a finitely generated `ℤ`-module is finitely generated.

The additive homomorphism `f : M →+ N` between abelian groups is `ℤ`-linear for the (unique)
`ℤ`-module structures, which is `map_intCast_smul`. -/
lemma moduleFinite_int_of_surjective_addHom {M N : Type} [AddCommGroup M] [AddCommGroup N]
    [Module ℤ N] [Module.Finite ℤ M] (f : M →+ N) (hf : Function.Surjective f) :
    Module.Finite ℤ N := by
  let hlin : M →ₗ[ℤ] N :=
    { toFun := f
      map_add' := f.map_add
      map_smul' := fun c x => map_intCast_smul f ℤ ℤ c x }
  exact Module.Finite.of_surjective hlin hf

/-- **Finiteness of `𝔽_p ⊗_ℤ Ĥ⁰(Gal(K/F), 𝒪_Kˣ)`.**

`Ĥ⁰(G, 𝒪_Kˣ)` is a quotient of `𝒪_Fˣ`, which is finitely generated by Dirichlet's unit theorem;
base change along `ℤ → 𝔽_p` of a finitely generated `ℤ`-module is a finite `𝔽_p`-module. -/
theorem moduleFinite_tensor_h0_oUnitsRep {F K : Type} [Field F] [NumberField F] [Field K]
    [NumberField K] [Algebra F K] [FiniteDimensional F K] [IsGalois F K] (p : ℕ) [Fact p.Prime] :
    Module.Finite (ZMod p)
      (TensorProduct ℤ (ZMod p) ↑(tateCohomology (Work.CFTLib.oUnitsRep F K) 0)) := by
  classical
  -- `Ĥ⁰(G, 𝒪_Kˣ)` is the quotient of the invariants by the norms, and the invariants are `𝒪_Fˣ`
  obtain ⟨fB, hfB⟩ := oUnits_invariants_surjective (F := F) (K := K)
  have hcomp : Function.Surjective
      ((QuotientAddGroup.mk' (Work.CFT.IdeleClassGroup.norms (oUnitsRep F K))).comp fB) :=
    (QuotientAddGroup.mk'_surjective _).comp hfB
  obtain ⟨e⟩ := Work.CFT.IdeleClassGroup.tateCohomology_zero_iso (oUnitsRep F K)
  let phi : Additive (𝓞 F)ˣ →+ ↑(tateCohomology (oUnitsRep F K) 0) :=
    e.symm.toAddMonoidHom.comp
      ((QuotientAddGroup.mk' (Work.CFT.IdeleClassGroup.norms (oUnitsRep F K))).comp fB)
  have hsurj : Function.Surjective phi := e.symm.surjective.comp hcomp
  -- `𝒪_Fˣ` is finitely generated
  haveI : Module.Finite ℤ (Additive (𝓞 F)ˣ) :=
    Work.CFT.Kummer.module_finite_of_group_fg (R := ℤ) (G := (𝓞 F)ˣ)
  have hfin : Module.Finite ℤ ↑(tateCohomology (oUnitsRep F K) 0) :=
    moduleFinite_int_of_surjective_addHom phi hsurj
  haveI := hfin
  exact Module.Finite.base_change ℤ (ZMod p) ↑(tateCohomology (oUnitsRep F K) 0)

end Work.CFTLib
