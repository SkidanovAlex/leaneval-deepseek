import Mathlib
import Submission.Work.Tower.Defs
import Submission.Work.Tower.Unramified.Basic
import Submission.Work.Tower.Unramified.Discriminant

/-!
# The Frattini layer of the unramified pro-3 group of a number field

This file fixes the vocabulary of the subproject on the *maximal everywhere unramified
elementary abelian `3`-extension* of a number field `F` — the fixed field of the Frattini
subgroup `Φ(Gal(F^{ur,3}/F))` — which is the input needed by Section 3 of the paper
*Planar Point Sets with Many Unit Distances*.

## Main definitions

* `Work.Tower.FrattiniLayer.IsUnramifiedOver F L`: the finite extension `L/F` is unramified at
  every finite prime, phrased as: every prime ideal of `𝓞 L` is unramified over `𝓞 F`
  (i.e. `Algebra.IsUnramifiedAt (𝓞 F) 𝔓`).  This is the form of the notion that the
  commutative-algebra API (`FormallyUnramified`, `differentIdeal`,
  `RingTheory.DedekindDomain.LinearDisjoint`) acts on; its equivalence with the ramification
  index form `Work.Tower.IsUnramifiedExtension` is `isUnramifiedExtension_iff`.

* `Work.Tower.FrattiniLayer.IsCubicUnramified F Ω M`: the intermediate field `M` of `Ω/F` is a
  Galois extension of `F` of degree `3` which is unramified at every finite prime.

* `Work.Tower.FrattiniLayer.cubicUnramifiedSet F Ω`: the set of all such `M`.

* `Work.Tower.FrattiniLayer.frattiniLayer F Ω`: the compositum of all of them, i.e. the Frattini
  layer.  Its finiteness over `F` (the content of Section 3) is `finite_cubicUnramifiedSet`.

* `Work.Tower.FrattiniLayer.cubeIdealSubgroup L`: the subgroup of `Lˣ` consisting of elements
  generating the cube of a fractional ideal of `𝓞 L`.  Every everywhere unramified cubic
  extension of `L` is `L⟮∛α⟯` for such an `α`, and `cubeIdealSubgroup L ⧸ (Lˣ)³` is finite
  (`finite_cubeIdealSubgroup_quotient`), which bounds the number of them.
-/

open NumberField
open scoped Classical nonZeroDivisors

namespace Work
namespace Tower
namespace FrattiniLayer

/-- `L/F` is **unramified at every finite prime**: every prime ideal `𝔓` of `𝓞 L` is unramified
over `𝓞 F`.  This is the `FormallyUnramified`-flavoured form of `Work.Tower.IsUnramifiedExtension`,
to which it is equivalent for Galois extensions of number fields (`isUnramifiedExtension_iff`). -/
def IsUnramifiedOver (F L : Type*) [Field F] [Field L] [Algebra F L] : Prop :=
  ∀ (𝔓 : Ideal (𝓞 L)) [𝔓.IsPrime], Algebra.IsUnramifiedAt (𝓞 F) 𝔓

/-- The predicate `IsUnramifiedOver` agrees with `Algebra.FormallyUnramified` on the rings of
integers. -/
theorem isUnramifiedOver_iff_formallyUnramified (F L : Type*) [Field F] [Field L] [Algebra F L] :
    IsUnramifiedOver F L ↔ Algebra.FormallyUnramified (𝓞 F) (𝓞 L) := by
  rw [Algebra.formallyUnramified_iff_forall]
  constructor
  · intro h q
    exact h q.1
  · intro h 𝔓 h𝔓
    exact h ⟨𝔓, h𝔓⟩

/-- `M` is a **cubic everywhere unramified Galois extension** of `F` inside `Ω`. -/
def IsCubicUnramified (F Ω : Type*) [Field F] [Field Ω] [Algebra F Ω]
    (M : IntermediateField F Ω) : Prop :=
  Module.finrank F M = 3 ∧ IsGalois F M ∧ IsUnramifiedOver F ↥M

/-- The set of all cubic everywhere unramified Galois extensions of `F` inside `Ω`. -/
def cubicUnramifiedSet (F Ω : Type*) [Field F] [Field Ω] [Algebra F Ω] :
    Set (IntermediateField F Ω) :=
  {M | IsCubicUnramified F Ω M}

/-- The **Frattini layer** of the maximal everywhere unramified pro-`3` extension of `F`:
the compositum (computed in `Ω`) of all cubic everywhere unramified Galois extensions of `F`. -/
noncomputable def frattiniLayer (F Ω : Type*) [Field F] [Field Ω] [Algebra F Ω] :
    IntermediateField F Ω :=
  ⨆ M : cubicUnramifiedSet F Ω, (M : IntermediateField F Ω)

/-- The subgroup of third powers of a commutative group. -/
def cubePow (A : Type*) [CommGroup A] : Subgroup A := (powMonoidHom 3).range

instance (A : Type*) [CommGroup A] : (cubePow A).Normal :=
  Subgroup.normal_of_isMulCommutative _

@[simp] theorem mem_cubePow {A : Type*} [CommGroup A] {a : A} :
    a ∈ cubePow A ↔ ∃ b : A, b ^ 3 = a := by
  rw [cubePow, MonoidHom.mem_range]
  exact ⟨fun ⟨b, hb⟩ => ⟨b, hb⟩, fun ⟨b, hb⟩ => ⟨b, hb⟩⟩

/-- The subgroup of `Lˣ` of elements `α` for which the fractional ideal `(α)` generated by `α`
is the cube of a fractional ideal of `𝓞 L`. -/
def cubeIdealSubgroup (L : Type*) [Field L] [NumberField L] : Subgroup Lˣ where
  carrier := {α | ∃ 𝔞 : (FractionalIdeal (𝓞 L)⁰ L)ˣ,
    (𝔞 : FractionalIdeal (𝓞 L)⁰ L) ^ 3 = FractionalIdeal.spanSingleton ((𝓞 L)⁰) (α : L)}
  mul_mem' := by
    rintro a b ⟨𝔞, h𝔞⟩ ⟨𝔟, h𝔟⟩
    refine ⟨𝔞 * 𝔟, ?_⟩
    rw [Units.val_mul, mul_pow, h𝔞, h𝔟]
    simp [Units.val_mul]
  one_mem' := by
    refine ⟨1, ?_⟩
    rw [Units.val_one, one_pow]
    simp
  inv_mem' := by
    rintro a ⟨𝔞, h𝔞⟩
    refine ⟨𝔞⁻¹, ?_⟩
    rw [Units.val_inv_eq_inv_val, inv_pow, h𝔞]
    simp [Units.val_inv_eq_inv_val]

/-- If `L ≤ M` are intermediate fields of `Ω/F`, view `M` (whose underlying set contains `L`) as
an intermediate field of `Ω/L`.  This is the base change `F ↝ L` used to compare unramified
cubic extensions of `F` with those of `L = F⟮ζ₃⟯`. -/
def overBase {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (L M : IntermediateField F Ω) (h : L ≤ M) : IntermediateField ↥L Ω where
  __ := M.toSubfield
  algebraMap_mem' := fun x => h x.2

@[simp]
theorem coe_overBase {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (L M : IntermediateField F Ω) (h : L ≤ M) :
    (overBase L M h : Set Ω) = M := rfl

/-- The base change `E·L / L` is everywhere unramified, phrased as a predicate on the pair
`(E, L)` of intermediate fields of `Ω/F`: the algebra structure on `↥(E ⊔ L)` over `↥L` is the
inclusion. -/
def IsUnramifiedSup {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (E L : IntermediateField F Ω) : Prop :=
  letI : Algebra ↥L ↥(E ⊔ L) := (IntermediateField.inclusion (le_sup_right : L ≤ E ⊔ L)).toAlgebra
  IsUnramifiedOver ↥L ↥(E ⊔ L)

/-! ### Interface with `Work.Tower.IsUnramifiedExtensionForallPrimes`

`Work.Tower.IsUnramifiedExtensionForallPrimes F L` (from `Submission/Work/Tower/Unramified/Basic.lean`)
is `∀ 𝔓, 𝔓.ramificationIdx (𝓞 F) = 1`, and Mathlib's `Ideal.ramificationIdx_eq_one_iff` identifies this
with the primes being `Algebra.IsUnramifiedAt`.  Consequently `IsUnramifiedOver` agrees with all the
lemmas proved for that predicate in `Submission/Work/Tower/Unramified/`. -/

variable {F L : Type*}

section Interface

variable [Field F] [NumberField F] [Field L] [NumberField L] [Algebra F L] [FiniteDimensional F L]

/-- `IsUnramifiedOver` is the `Algebra.IsUnramifiedAt`-form of the strong unramifiedness
predicate `IsUnramifiedExtensionForallPrimes`. -/
theorem isUnramifiedOver_iff_forallPrimes :
    IsUnramifiedOver F L ↔ Work.Tower.IsUnramifiedExtensionForallPrimes F L :=
  (Work.Tower.IsUnramifiedExtensionForallPrimes_iff_forall_isUnramifiedAt (F := F) (L := L)).symm

/-- The given predicate `Work.Tower.IsUnramifiedExtension` agrees with `IsUnramifiedOver` for
Galois extensions of number fields. -/
theorem isUnramifiedExtension_iff [IsGalois F L] :
    Work.Tower.IsUnramifiedExtension F L ↔ IsUnramifiedOver F L :=
  (Work.Tower.isUnramifiedExtension_iff_forallPrimes (F := F) (L := L)).trans
    (isUnramifiedOver_iff_forallPrimes (F := F) (L := L)).symm

/-- `IsUnramifiedOver` is equivalent to the triviality of the relative different ideal. -/
theorem isUnramifiedOver_iff_differentIdeal_eq_top :
    IsUnramifiedOver F L ↔ differentIdeal (𝓞 F) (𝓞 L) = ⊤ :=
  (isUnramifiedOver_iff_forallPrimes (F := F) (L := L)).trans
    Work.Tower.isUnramifiedExtensionForallPrimes_iff_differentIdeal_eq_top

/-- **Unramifiedness is local in the tower**: for `F ⊆ E ⊆ L` with `L/F` unramified everywhere,
both `E/F` and `L/E` are unramified everywhere. -/
theorem isUnramifiedOver_tower {E : IntermediateField F L} [FiniteDimensional F ↥E]
    (h : IsUnramifiedOver F L) : IsUnramifiedOver F ↥E ∧ IsUnramifiedOver ↥E L := by
  have h' := (isUnramifiedOver_iff_forallPrimes (F := F) (L := L)).mp h
  have : NumberField ↥E := NumberField.of_module_finite F ↥E
  obtain ⟨g1, g2⟩ := Work.Tower.IsUnramifiedExtensionForallPrimes.tower (E := E) h'
  exact ⟨(isUnramifiedOver_iff_forallPrimes (F := F) (L := ↥E)).mpr g1,
    (isUnramifiedOver_iff_forallPrimes (F := ↥E) (L := L)).mpr g2⟩

end Interface

/-- The quotient of the group `cubeIdealSubgroup L` of elements generating a cube of a
fractional ideal by the subgroup of cubes of `Lˣ`.  This is the (finite) parameter set for the
everywhere unramified cubic extensions of `L`. -/
abbrev CubeIdealQuotient (L : Type*) [Field L] [NumberField L] : Type _ :=
  cubeIdealSubgroup L ⧸ (cubePow Lˣ).subgroupOf (cubeIdealSubgroup L)

end FrattiniLayer
end Tower
end Work
