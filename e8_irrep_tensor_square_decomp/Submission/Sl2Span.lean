import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.LinearAlgebra.Span.Basic

/-!
# The `𝔰𝔩₂`-span of a vector of finite `f`-length

If `e v = 0`, `(f ^ (n+1)) v = 0` and the commutator `[e,f]` acts on the ambient space by the
scalar `h` (`e (f w) = f (e w) + h • w`), then

* the `f`-span of `v` is the span of the finite string `{v, f v, …, f^n v}` (`span_pow_eq`),
* that span is stable under `e` (`e_mem_span_pow`),

so the `𝔰𝔩₂`-submodule generated by `v` is finite dimensional.  This is the local-finiteness input
for the integrability of a highest weight module: it feeds the argument that every weight vector of
`L(λ)` spans a finite-dimensional `𝔰𝔩₂`-module, whence the weight multiplicities of `L(λ)` are
invariant under the Weyl group.
-/

set_option maxHeartbeats 1000000

namespace Submission.Sl2Span

open scoped BigOperators

/-- Powers of `f` beyond `n` kill `v`. -/
theorem pow_apply_eq_zero {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (f : Module.End K V) (v : V) (n : ℕ) (hfv : (f ^ (n + 1)) v = 0) :
    ∀ k : ℕ, n + 1 ≤ k → (f ^ k) v = 0 := by
  intro k hk
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [show n + 1 + j = j + (n + 1) from by omega, pow_add, Module.End.mul_apply, hfv,
    map_zero]

/-- The `f`-span of `v` is the span of the finite string `{v, f v, …, f^n v}`. -/
theorem span_pow_eq {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (f : Module.End K V) (v : V) (n : ℕ) (hfv : (f ^ (n + 1)) v = 0) :
    Submodule.span K (Set.range fun k : ℕ => (f ^ k) v) =
      Submodule.span K (Set.range fun k : Fin (n + 1) => (f ^ (k : ℕ)) v) := by
  refine le_antisymm (Submodule.span_le.mpr ?_) (Submodule.span_le.mpr ?_)
  · rintro _ ⟨k, rfl⟩
    by_cases hk : k ≤ n
    · exact Submodule.subset_span ⟨⟨k, Nat.lt_succ_of_le hk⟩, rfl⟩
    · change (f ^ k) v ∈ Submodule.span K (Set.range fun k : Fin (n + 1) => (f ^ (k : ℕ)) v)
      rw [pow_apply_eq_zero f v n hfv k (by omega)]
      exact Submodule.zero_mem _
  · rintro _ ⟨k, rfl⟩
    exact Submodule.subset_span ⟨(k : ℕ), rfl⟩

/-- The `f`-span of `v` is finite dimensional. -/
theorem finite_span_pow {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (f : Module.End K V) (v : V) (n : ℕ) (hfv : (f ^ (n + 1)) v = 0) :
    Module.Finite K (Submodule.span K (Set.range fun k : ℕ => (f ^ k) v)) := by
  rw [span_pow_eq f v n hfv]
  exact FiniteDimensional.span_of_finite K (Set.finite_range _)

/-- The `f`-string span of `v` is stable under `f`. -/
theorem f_mem_span_pow {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (f : Module.End K V) (v : V) {w : V}
    (hw : w ∈ Submodule.span K (Set.range fun k : ℕ => (f ^ k) v)) :
    f w ∈ Submodule.span K (Set.range fun k : ℕ => (f ^ k) v) := by
  induction hw using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      exact Submodule.subset_span ⟨k + 1, by
        show (f ^ (k + 1)) v = f ((f ^ k) v)
        rw [pow_succ', Module.End.mul_apply]⟩
  | zero => rw [map_zero]; exact Submodule.zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact Submodule.add_mem _ hx hy
  | smul c x _ hx => rw [map_smul]; exact Submodule.smul_mem _ _ hx

/-- The span of the `f`-string of `v` is stable under `e`. -/
theorem e_mem_span_pow {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
    (e f : Module.End K V) (h : K) (v : V) (hev : e v = 0)
    (hcomm : ∀ w : V, e (f w) = f (e w) + h • w) :
    ∀ k : ℕ, e ((f ^ k) v) ∈
      Submodule.span K (Set.range fun k : ℕ => (f ^ k) v) := by
  intro k
  induction k with
  | zero => rw [pow_zero, Module.End.one_apply, hev]; exact Submodule.zero_mem _
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, hcomm]
    exact Submodule.add_mem _ (f_mem_span_pow f v ih)
      (Submodule.smul_mem _ _ (Submodule.subset_span ⟨k, rfl⟩))

end Submission.Sl2Span
