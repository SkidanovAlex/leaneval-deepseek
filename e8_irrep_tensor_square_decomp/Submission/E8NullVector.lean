import Submission.E8Integrable
import Submission.E8PBW

/-!
# The null vector `fᵢ^(λᵢ+1) v` lies in the maximal submodule

`Submission.E8Integrable` shows that `xᵢ = (Lbar i)^(kI i + 1) v` is a primitive vector of the
Verma module `V = M(ω₁+ω₈)`.  This file proves the second half of the integrability argument: the
`U(e₈)`-submodule generated by `xᵢ` is **proper**, so that `xᵢ` lies in the unique maximal
submodule `N` of `V`.

The proof uses the triangular-decomposition spanning of `U(e₈)`
(`Submission.E8PBW.S_eq_top`, `Submission.E8PBW.smul_mem_fspan`): every `u • xᵢ` lies in the span
of the `f`-monomials applied to `xᵢ`, and those are in turn contained in the subspace
`Z m₀ = span{mk (wordElt w) : m₀ ≤ content w}`.  Since the augmentation functional `ε` vanishes on
`Z m₀` (every word of content `≥ m₀ ≠ 0` is nonempty) while `ε v = 1`, the highest weight vector
`v` cannot lie in that submodule.
-/

set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

noncomputable section
open scoped BigOperators

namespace Submission.E8NullVector

open Submission.StarModule (wordElt Lop FA wordElt_nil Lop_wordElt)
open Submission.StarQuotient (Ebar Lbar Hbar J V Lbar_mk Hbar_mk Ebar_mk)
open Submission.VermaWeight
open Submission.E8Integrable

abbrev E8 : Matrix (Fin 8) (Fin 8) ℤ := CartanMatrix.E₈

/-! ## The augmentation functional on the Verma module -/

/-- The augmentation (counit) functional descended to the Verma module: it is the coefficient of
the empty word, i.e. of the highest weight vector. -/
noncomputable def eps : V →ₗ[ℂ] ℂ :=
  Submodule.liftQ (J E8) (Submission.VermaNonzero.aug.toLinearMap) (by
    intro x hx
    rw [LinearMap.mem_ker]
    exact Submission.VermaNonzero.aug_mem_J x hx)

lemma eps_mk (x : FA (Fin 8)) :
    eps (Submodule.Quotient.mk x : V) = Submission.VermaNonzero.aug x := by
  rw [show eps = Submodule.liftQ (J E8) (Submission.VermaNonzero.aug.toLinearMap) _ from rfl,
    Submodule.liftQ_apply]
  rfl

lemma eps_mk_wordElt (w : List (Fin 8)) :
    eps ((Submodule.Quotient.mk (wordElt w) : V)) = if w = [] then 1 else 0 := by
  rw [eps_mk, Submission.VermaNonzero.aug_wordElt]

@[simp] lemma eps_v : eps v = 1 := by
  have h : v = (Submodule.Quotient.mk (1 : FA (Fin 8)) : V) := rfl
  rw [h, show (1 : FA (Fin 8)) = wordElt ([] : List (Fin 8)) by rw [wordElt_nil],
    eps_mk_wordElt]
  simp

/-! ## The subspace of words of content at least `m` -/

/-- The span of the word vectors whose letter content is at least `m`. -/
def Z (m : Fin 8 → ℕ) : Submodule ℂ V :=
  Submodule.span ℂ {x : V | ∃ w : List (Fin 8), (∀ i, m i ≤ w.count i) ∧
    x = (Submodule.Quotient.mk (wordElt w) : V)}

lemma Z_le_ker_eps (m : Fin 8 → ℕ) (hm : ∃ i, m i ≠ 0) : Z m ≤ LinearMap.ker eps := by
  change Submodule.span ℂ {x : V | ∃ w : List (Fin 8), (∀ i, m i ≤ w.count i) ∧
    x = (Submodule.Quotient.mk (wordElt w) : V)} ≤ LinearMap.ker eps
  refine Submodule.span_le.mpr ?_
  rintro x ⟨w, hw, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, eps_mk_wordElt]
  have hne : w ≠ [] := by
    rintro rfl
    obtain ⟨i, hi⟩ := hm
    have := hw i
    simp at this
    exact hi this
  simp [hne]

/-- The highest weight vector does not lie in `Z m` for `m ≠ 0`. -/
lemma v_notMem_Z (m : Fin 8 → ℕ) (hm : ∃ i, m i ≠ 0) : v ∉ Z m := by
  intro hv
  have h := Z_le_ker_eps m hm hv
  rw [LinearMap.mem_ker, eps_v] at h
  exact one_ne_zero h

/-! ## The weight of the null vector and the content bound -/

/-- The multiplicity vector of the weight `ω₁+ω₈ - (kI i + 1) αᵢ`. -/
def m0 (i : Fin 8) (c : ℕ) : Fin 8 → ℕ := fun k => if k = i then c else 0

lemma count_cons_eq (i : Fin 8) (w : List (Fin 8)) (k : Fin 8) :
    (i :: w).count k = w.count k + (if k = i then 1 else 0) := by
  rw [List.count_cons]
  by_cases h : k = i
  · subst h; simp
  · simp [h, Ne.symm h]

/-- The highest weight vector lies in the weight space of multiplicity vector `0`. -/
lemma m0_zero (i : Fin 8) : m0 i 0 = fun _ : Fin 8 => 0 := by
  funext k; simp [m0]

lemma m0_succ (i : Fin 8) (c : ℕ) :
    m0 i (c + 1) = fun k => m0 i c k + (if k = i then 1 else 0) := by
  funext k
  by_cases h : k = i <;> simp [m0, h]

lemma v_mem_Wm_zero : v ∈ Wm (fun _ : Fin 8 => 0) := by
  rw [Wm_zero_eq]
  exact Submodule.mem_span_singleton_self _

/-- `Lbar i` shifts the multiplicity vector by `eᵢ`. -/
lemma Lbar_mem_Wm (i : Fin 8) {m : Fin 8 → ℕ} {x : V} (hx : x ∈ Wm m) :
    Lbar E8 i x ∈ Wm (fun k => m k + (if k = i then 1 else 0)) := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨w, hw, rfl⟩ := hy
      rw [Lbar_mk, Lop_wordElt]
      refine Submodule.subset_span ⟨i :: w, fun k => ?_, rfl⟩
      rw [count_cons_eq, hw k]
  | zero => simp
  | add a b _ _ ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [map_smul]; exact Submodule.smul_mem _ _ ha

lemma Lbar_pow_mem_Wm (i : Fin 8) (c : ℕ) {x : V} (hx : x ∈ Wm (fun _ : Fin 8 => 0)) :
    ((Lbar E8 i) ^ c) x ∈ Wm (m0 i c) := by
  induction c with
  | zero => rwa [m0_zero]
  | succ c ih =>
      rw [pow_succ', Module.End.mul_apply, m0_succ]
      exact Lbar_mem_Wm i ih

/-- The `f`-action is the action of `Lbar`. -/
lemma f_smul_eq (i : Fin 8) (y : V) : Submission.E8Weights.f i • y = Lbar E8 i y := by
  change Submission.VermaNonzero.rho lam (Submission.E8Weights.f i) y = Lbar E8 i y
  rw [Submission.VermaNonzero.rho_F]

/-- `f`-monomials shift the multiplicity vector by the content of the monomial. -/
lemma fmono_smul_mem_Wm (a : List (Fin 8)) {m : Fin 8 → ℕ} {x : V} (hx : x ∈ Wm m) :
    E8PBW.fmono a • x ∈ Wm (fun k => m k + a.count k) := by
  induction a generalizing m x with
  | nil => simpa using hx
  | cons i a ih =>
      rw [E8PBW.fmono_cons, mul_smul, f_smul_eq]
      have h2 := Lbar_mem_Wm i (ih hx)
      convert h2 using 2
      funext k
      rw [count_cons_eq]
      omega

lemma Wm_le_Z (m m' : Fin 8 → ℕ) (h : ∀ i, m' i ≤ m i) : Wm m ≤ Z m' := by
  refine Submodule.span_le.mpr ?_
  rintro x ⟨w, hw, rfl⟩
  exact Submodule.subset_span ⟨w, fun i => by rw [hw i]; exact h i, rfl⟩

/-! ## The null vector lies in the maximal submodule -/

lemma e_smul_eq (i : Fin 8) (y : V) : Submission.E8Weights.e i • y = Ebar E8 lam i y := by
  change Submission.VermaNonzero.rho lam (Submission.E8Weights.e i) y = Ebar E8 lam i y
  rw [show Submission.E8Weights.e i
      = UniversalEnvelopingAlgebra.ι ℂ (Submission.E8Weights.SerreE i) from rfl,
    Submission.VermaNonzero.rho_iota, Submission.VermaNonzero.act_E]

lemma h_smul_eq (i : Fin 8) (y : V) : Submission.E8Weights.h i • y = Hbar E8 lam i y := by
  change Submission.VermaNonzero.rho lam (Submission.E8Weights.h i) y = Hbar E8 lam i y
  rw [show Submission.E8Weights.h i
      = UniversalEnvelopingAlgebra.ι ℂ (Submission.E8Weights.SerreH i) from rfl,
    Submission.VermaNonzero.rho_iota, Submission.VermaNonzero.act_H]

/-- **The null vector `fᵢ^(λᵢ+1) v` lies in the maximal submodule** (equivalently, in every
submodule which does not contain the highest weight vector). -/
theorem nullvector_mem_of_max (N : Submodule U V) (hvN : v ∉ N)
    (hmax : ∀ N' : Submodule U V, v ∉ N' → N' ≤ N) (i : Fin 8) :
    ((Lbar E8 i) ^ (kI i + 1)) v ∈ N := by
  set x : V := ((Lbar E8 i) ^ (kI i + 1)) v with hxdef
  set mm : Fin 8 → ℕ := m0 i (kI i + 1) with hmdef
  have hxW : x ∈ Wm mm := Lbar_pow_mem_Wm i (kI i + 1) v_mem_Wm_zero
  have hmne : ∃ j, mm j ≠ 0 := ⟨i, by simp [mm, m0]⟩
  -- the `f`-span of `x` lies in `Z mm`
  have hZ : E8PBW.fspan x ≤ Z mm := by
    refine Submodule.span_le.mpr ?_
    rintro y ⟨a, rfl⟩
    exact Wm_le_Z (fun k => mm k + a.count k) mm (fun k => Nat.le_add_right _ _)
      (fmono_smul_mem_Wm a hxW)
  have hspanU : ∀ u : U, u • x ∈ Z mm := by
    intro u
    have hprim : ∀ j : Fin 8, Submission.E8Weights.e j • x = 0 := by
      intro j
      rw [e_smul_eq]
      exact Ebar_Lbar_pow_v i j
    have hwt : ∀ j : Fin 8, Submission.E8Weights.h j • x = wt mm j • x := by
      intro j
      rw [h_smul_eq]
      exact Hbar_apply_mem_Wm j hxW
    exact hZ (E8PBW.smul_mem_fspan x hprim (wt mm) hwt u)
  -- hence the whole `U(e₈)`-span of `x` lies in `Z mm`
  have hspan : ∀ y ∈ Submodule.span U ({x} : Set V), y ∈ Z mm := by
    intro y hy
    have key : ∀ y ∈ Submodule.span U ({x} : Set V), ∀ u : U, u • y ∈ Z mm := by
      intro y hy
      refine Submodule.span_induction (p := fun y _ => ∀ u : U, u • y ∈ Z mm) ?_ ?_ ?_ ?_ hy
      · rintro z hz
        rw [Set.mem_singleton_iff] at hz
        subst hz
        exact hspanU
      · intro u; simp
      · intro y1 y2 _ _ h1 h2 u
        rw [smul_add]; exact Submodule.add_mem _ (h1 u) (h2 u)
      · intro u1 z _ hz u2
        rw [← mul_smul]; exact hz (u2 * u1)
    have := key y hy 1
    simpa using this
  have hv' : v ∉ Submodule.span U ({x} : Set V) :=
    fun h => v_notMem_Z mm hmne (hspan v h)
  have hle := hmax _ hv'
  have hxmem : x ∈ Submodule.span U ({x} : Set V) :=
    Submodule.subset_span (Set.mem_singleton x)
  exact hle hxmem

lemma f_pow_smul_eq (i : Fin 8) (c : ℕ) (y : V) :
    (Submission.E8Weights.f i ^ c) • y = ((Lbar E8 i) ^ c) y := by
  induction c with
  | zero => simp
  | succ c ih =>
      rw [pow_succ', mul_smul, ih, f_smul_eq, pow_succ', Module.End.mul_apply]

/-- **Integrability, first half.**  In the quotient `L = V ⧸ N` by the maximal submodule, the
`(λᵢ+1)`-st power of the lowering operator `fᵢ` annihilates the highest weight vector. -/
theorem f_pow_smul_vbar (N : Submodule U V) (hvN : v ∉ N)
    (hmax : ∀ N' : Submodule U V, v ∉ N' → N' ≤ N) (i : Fin 8) :
    (Submission.E8Weights.f i ^ (kI i + 1)) •
      (Submodule.Quotient.mk (p := N) v) = 0 := by
  rw [← Submodule.Quotient.mk_smul, f_pow_smul_eq]
  exact (Submodule.Quotient.mk_eq_zero N).mpr (nullvector_mem_of_max N hvN hmax i)

end Submission.E8NullVector
