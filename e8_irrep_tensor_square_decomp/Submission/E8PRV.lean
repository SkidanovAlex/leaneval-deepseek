import Submission.E8TensorBound
import Submission.E8Freudenthal
import Submission.E8ConstChar
import Submission.Commons.LinearAlgebra.TensorProduct.tmul_ne_zero

/-!
# The PRV statement for `V ⊗ V`, `V = L(ω₁+ω₈)`

For `x ∈ Lwt N η` (a weight vector of `V ⧸ N`) and `vbar` the highest weight vector of `V ⧸ N`,
the vector `x ⊗ vbar` lies in the weight-`(η+λ)` space of the tensor square and is the candidate
for the PRV (Parthasarathy–Ranga Rao–Varadarajan) constituent `L(η+λ)`.

This file formalises the parts of that statement that do not need the PRV theorem itself — the
`𝔫⁺`-equivariance of `x ↦ x ⊗ vbar` and the existence of a primitive vector in the cyclically
generated submodule.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 20000
set_option linter.unusedSimpArgs false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

noncomputable section
open scoped TensorProduct BigOperators

namespace Submission.E8PRV

open Submission.E8Tensor Submission.E8TensorBound Submission.E8WeightSpaces
open Submission.E8WeightSpaces (Lwt Lw wtZ)
open Submission.VermaWeight
open UniversalEnvelopingAlgebra
open Submission.E8Character (posCon posCon_add)

variable {N : Submodule U V}

/-- The highest weight vector of `V ⧸ N` is killed by every positive root vector. -/
lemma eRoot_smul_vbar' (k : Fin 120) :
    (UniversalEnvelopingAlgebra.ι ℂ (Submission.E8Casimir.eRoot k)) • (vbar N) = 0 :=
  Submission.E8Freudenthal.eRoot_smul_vbar N k

/-- **The map `x ↦ x ⊗ vbar` is `𝔫⁺`-equivariant.** -/
lemma deriv_tmul_vbar (k : Fin 120) (a : V ⧸ N) :
    deriv (N := N) (Submission.E8Casimir.eRoot k) (a ⊗ₜ[ℂ] vbar N)
      = ((UniversalEnvelopingAlgebra.ι ℂ (Submission.E8Casimir.eRoot k)) • a) ⊗ₜ[ℂ] vbar N := by
  rw [deriv_tmul, eRoot_smul_vbar', TensorProduct.tmul_zero, add_zero]

/-- If `x ∈ Lwt N η` then `x ⊗ vbar ∈ TLwt N (η + λ)`. -/
lemma tmul_vbar_mem_TLwt {η : Fin 8 → ℤ} {a : V ⧸ N} (ha : a ∈ Lwt N η) :
    a ⊗ₜ[ℂ] vbar N ∈ TLwt N (η + Submission.E8Freudenthal.lamZ) :=
  tmul_mem_TLwt ha (Submission.E8Freudenthal.vbar_mem_Lwt_lam N)

/-- **`x ↦ x ⊗ vbar` is injective.** -/
lemma tmul_vbar_ne_zero (hvN : v ∉ N) {a : V ⧸ N} (ha : a ≠ 0) :
    a ⊗ₜ[ℂ] vbar N ≠ 0 :=
  Commons.LinearAlgebra.TensorProduct.tmul_ne_zero ha (vbar_ne_zero N hvN)

/-- **The PRV setup.**  For any non-zero weight vector `a` of `V ⧸ N`, the `U`-cyclic submodule
generated by `a ⊗ vbar` contains a non-zero primitive vector whose weight `ν` is dominant with
`ν ∈ the40` (i.e. `2λ - ν ∈ ℕΦ⁺`).

The remaining content of the PRV theorem — that this weight is *exactly* the dominant conjugate
`dc (η + λ)` of the weight `η` of `a` — is not proved here (see the roadmap in
`Submission.lean`). -/
theorem exists_primitive_in_cyclic {η : Fin 8 → ℤ} {a : V ⧸ N} (hvN : v ∉ N)
    (hmax : ∀ N' : Submodule U V, v ∉ N' → N' ≤ N) (ha : a ∈ Lwt N η) (ha0 : a ≠ 0) :
    ∃ (ν : Fin 8 → ℤ) (z : T N), ν ∈ Submission.E8Enum.the40 ∧
      z ∈ Submodule.span U ({a ⊗ₜ[ℂ] vbar N} : Set (T N)) ∧ z ≠ 0 ∧
      (∀ j, deriv (N := N) (Submission.E8Weights.SerreH j) z = (((ν j : ℤ)) : ℂ) • z) ∧
      (∀ j, deriv (N := N) (Submission.E8Weights.SerreE j) z = 0) := by
  classical
  haveI hss : IsSemisimpleModule U (T N) := isSemisimple_tensor N hvN hmax
  have hx0 : a ⊗ₜ[ℂ] vbar N ≠ 0 := tmul_vbar_ne_zero hvN ha0
  have hWne : Submodule.span U ({a ⊗ₜ[ℂ] vbar N} : Set (T N)) ≠ ⊥ := by
    intro h
    have hmem : a ⊗ₜ[ℂ] vbar N ∈ (⊥ : Submodule U (T N)) := by
      rw [← h]
      exact Submodule.subset_span (Set.mem_singleton _)
    rw [Submodule.mem_bot] at hmem
    exact hx0 hmem
  obtain ⟨S, hSle, hS⟩ :=
    (IsSemisimpleModule.eq_bot_or_exists_simple_le
      (Submodule.span U ({a ⊗ₜ[ℂ] vbar N} : Set (T N)))).resolve_left hWne
  haveI := hS
  obtain ⟨x, ν, hxS, hx0', hH, hE, hdom, hmem⟩ := exists_prim_of_simple N hvN hmax S hS
  exact ⟨ν, x, hmem, hSle hxS, hx0', hH, hE⟩

/-! ## The `2λ`-family

The first family `(η, λ)` with `η = λ` is special: `vbar ⊗ vbar` *is* primitive, because both
factors are killed by the raising operators.  This is the model case for the general PRV
statement, and the only one where the primitivity is immediate. -/

/-- **`vbar ⊗ vbar` is primitive.** -/
lemma deriv_eRoot_tmul_vbar_vbar (k : Fin 120) :
    deriv (N := N) (Submission.E8Casimir.eRoot k) (vbar N ⊗ₜ[ℂ] vbar N) = 0 := by
  rw [deriv_tmul, eRoot_smul_vbar']
  simp

/-- **`vbar ⊗ vbar` has weight `2λ`.** -/
lemma deriv_h_tmul_vbar_vbar (j : Fin 8) :
    deriv (N := N) (Submission.E8Weights.SerreH j) (vbar N ⊗ₜ[ℂ] vbar N)
      = ((((2 * Submission.E8Freudenthal.lamZ j : ℤ)) : ℂ)) • (vbar N ⊗ₜ[ℂ] vbar N) := by
  rw [deriv_h_tmul j (Submission.E8Freudenthal.vbar_mem_Lwt_lam N)
    (Submission.E8Freudenthal.vbar_mem_Lwt_lam N)]
  congr 1
  push_cast
  ring

/-- The `2λ`-weight space of the cyclic submodule generated by `vbar ⊗ vbar`: the vector itself is
primitive, so its weight is exactly `2λ` in the cone order as well (`ν ⪰ 2λ` is automatic from
primitivity in the primality direction). -/
lemma tmul_vbar_vbar_mem_TLwt :
    vbar N ⊗ₜ[ℂ] vbar N ∈ TLwt N (2 • Submission.E8Freudenthal.lamZ) := by
  have h := tmul_mem_TLwt (Submission.E8Freudenthal.vbar_mem_Lwt_lam N)
    (Submission.E8Freudenthal.vbar_mem_Lwt_lam N)
  rw [← two_nsmul] at h
  exact h

end Submission.E8PRV
