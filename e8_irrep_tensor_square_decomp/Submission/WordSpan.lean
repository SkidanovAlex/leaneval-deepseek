import Submission.E8Weights
import Submission.Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota

set_option maxHeartbeats 4000000

noncomputable section

/-!
# The word-spanning theorem for highest-weight modules of the Serre-constructed e₈

Let `v` be a vector of a `U(e₈)`-module `M` which is

* annihilated by every positive Serre generator `Eᵢ` (`Eᵢ • v = 0`), and
* a joint eigenvector of the diagonal (Cartan) generators `Hᵢ` (`Hᵢ • v = λᵢ • v`).

Then the `U(e₈)`-submodule generated by `v` is spanned by the *word vectors*
`F_{i₁} ⋯ F_{i_k} • v` obtained by applying the negative (lowering) generators to `v`
(`wordVec`, `wordSpan`).

This is the "spanning half" of the triangular decomposition of a highest-weight module (the
half that does not need Poincaré–Birkhoff–Witt).  The proof is the classical induction:
`F`-generators obviously preserve the word span, `H`-generators act diagonally on word vectors,
and `E`-generators move through the `F`'s using the Serre relation `Eᵢ Fⱼ = Fⱼ Eᵢ + δᵢⱼ Hᵢ`
(`commutator_E_F` in `Submission.E8Weights`), which never leaves the word span.  The subalgebra
of `U(e₈)` preserving the word span contains all `Eᵢ, Fᵢ, Hᵢ`; since `ι(e₈)` is generated as a
Lie algebra by those (proved here from the universal property of the free Lie algebra), it
contains `ι(e₈)` and hence, by `adjoin_range_iota`, all of `U(e₈)`.
-/

open UniversalEnvelopingAlgebra
open CartanMatrix

namespace Submission.WordSpan

open Submission.E8Weights

attribute [local instance 100] LieRing.ofAssociativeRing LieAlgebra.ofAssociativeAlgebra

/-- The word vector `F_{i₁} ⋯ F_{i_k} • v`: the letters of the word are applied from left to
right (the first letter is the outermost `F`-generator). -/
def wordVec {M : Type*} [AddCommGroup M] [Module U M] (v : M) : List (Fin 8) → M
  | [] => v
  | i :: w => f i • wordVec v w

/-- The `ℂ`-span of all word vectors applied to `v`. -/
def wordSpan {M : Type*} [AddCommGroup M] [Module ℂ M] [Module U M] (v : M) : Submodule ℂ M :=
  Submodule.span ℂ (Set.range (wordVec v))

variable {M : Type*} [AddCommGroup M] [Module ℂ M] [Module U M] [IsScalarTower ℂ U M]

lemma wordVec_mem_wordSpan (v : M) (w : List (Fin 8)) : wordVec v w ∈ wordSpan v :=
  Submodule.subset_span ⟨w, rfl⟩

@[simp] lemma f_smul_wordVec (v : M) (i : Fin 8) (w : List (Fin 8)) :
    f i • wordVec v w = wordVec v (i :: w) := rfl

lemma wordVec_cons (v : M) (i : Fin 8) (w : List (Fin 8)) :
    wordVec v (i :: w) = f i • wordVec v w := rfl

/-- The word span is preserved by the lowering generators `Fᵢ`. -/
lemma f_smul_mem_wordSpan (v : M) (i : Fin 8) {m : M} (hm : m ∈ wordSpan v) :
    f i • m ∈ wordSpan v := by
  refine Submodule.span_induction (p := fun x _ => f i • x ∈ wordSpan v) ?_ ?_ ?_ ?_ hm
  · intro x hx
    obtain ⟨w, rfl⟩ := hx
    rw [f_smul_wordVec]
    exact wordVec_mem_wordSpan v (i :: w)
  · simp
  · intro x y _ _ hx hy
    rw [smul_add]
    exact Submodule.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_comm]
    exact Submodule.smul_mem _ c hx

/-- Weight bookkeeping: on a word vector, the diagonal generator `Hⱼ` acts by the scalar
`λⱼ - ∑_{i ∈ w} Aⱼᵢ`. -/
lemma h_smul_wordVec (v : M) (lam : Fin 8 → ℂ) (hh : ∀ j, h j • v = lam j • v)
    (j : Fin 8) (w : List (Fin 8)) :
    h j • wordVec v w = (lam j - (w.map (fun i => (CartanMatrix.E₈ j i : ℂ))).sum) • wordVec v w := by
  induction w with
  | nil => simpa [wordVec] using hh j
  | cons i w ih =>
      have hstep : h j • wordVec v (i :: w)
          = f i • (h j • wordVec v w) - ((CartanMatrix.E₈ j i : ℂ) • (f i • wordVec v w)) := by
        rw [wordVec_cons, ← mul_smul, h_mul_f_comm j i, sub_smul, mul_smul, smul_assoc]
      rw [hstep, ih, wordVec_cons]
      rw [show ((i :: w).map (fun i => (CartanMatrix.E₈ j i : ℂ))).sum =
          (CartanMatrix.E₈ j i : ℂ) + (w.map (fun i => (CartanMatrix.E₈ j i : ℂ))).sum from by
        simp]
      rw [smul_comm]
      rw [← sub_smul]
      congr 1
      ring

/-- The word span is preserved by the diagonal generators `Hⱼ`. -/
lemma h_smul_mem_wordSpan (v : M) (lam : Fin 8 → ℂ) (hh : ∀ j, h j • v = lam j • v)
    (j : Fin 8) {m : M} (hm : m ∈ wordSpan v) : h j • m ∈ wordSpan v := by
  refine Submodule.span_induction (p := fun x _ => h j • x ∈ wordSpan v) ?_ ?_ ?_ ?_ hm
  · intro x hx
    obtain ⟨w, rfl⟩ := hx
    rw [h_smul_wordVec v lam hh j w]
    exact Submodule.smul_mem _ _ (wordVec_mem_wordSpan v w)
  · simp
  · intro x y _ _ hx hy
    rw [smul_add]
    exact Submodule.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_comm]
    exact Submodule.smul_mem _ c hx

/-- The key step: the word span is preserved by the raising generators `Eᵢ`, using the Serre
relation `Eᵢ Fⱼ = Fⱼ Eᵢ + δᵢⱼ Hᵢ` to move `Eᵢ` to the right through the word. -/
lemma e_smul_wordVec_mem (v : M) (lam : Fin 8 → ℂ) (he : ∀ i, e i • v = 0)
    (hh : ∀ j, h j • v = lam j • v) (i : Fin 8) (w : List (Fin 8)) :
    e i • wordVec v w ∈ wordSpan v := by
  induction w with
  | nil => rw [show wordVec v [] = v from rfl, he i]; exact Submodule.zero_mem _
  | cons k w ih =>
      have hEF : e i * f k - f k * e i = (if i = k then h i else 0) := by
        have hc := commutator_E_F i k
        simpa only [e, f, h] using hc
      have hcomm : e i * f k = f k * e i + (if i = k then h i else 0) := by
        rw [← hEF]; abel
      have hstep : e i • wordVec v (k :: w)
          = f k • (e i • wordVec v w) + (if i = k then h i • wordVec v w else 0) := by
        rw [wordVec_cons, ← mul_smul, hcomm, add_smul, mul_smul]
        by_cases hik : i = k <;> simp [hik]
      rw [hstep]
      refine Submodule.add_mem _ (f_smul_mem_wordSpan v k ih) ?_
      by_cases hik : i = k
      · subst hik
        rw [if_pos rfl, h_smul_wordVec v lam hh i w]
        exact Submodule.smul_mem _ _ (wordVec_mem_wordSpan v w)
      · rw [if_neg hik]
        exact Submodule.zero_mem _

/-- The word span is preserved by the raising generators `Eᵢ`. -/
lemma e_smul_mem_wordSpan (v : M) (lam : Fin 8 → ℂ) (he : ∀ i, e i • v = 0)
    (hh : ∀ j, h j • v = lam j • v) (i : Fin 8) {m : M} (hm : m ∈ wordSpan v) :
    e i • m ∈ wordSpan v := by
  refine Submodule.span_induction (p := fun x _ => e i • x ∈ wordSpan v) ?_ ?_ ?_ ?_ hm
  · intro x hx
    obtain ⟨w, rfl⟩ := hx
    exact e_smul_wordVec_mem v lam he hh i w
  · simp
  · intro x y _ _ hx hy
    rw [smul_add]
    exact Submodule.add_mem _ hx hy
  · intro c x _ hx
    rw [smul_comm]
    exact Submodule.smul_mem _ c hx

/-- The subalgebra of `U(e₈)` consisting of the elements which preserve the word span of `v`. -/
def wordPreserver (v : M) : Subalgebra ℂ U where
  carrier := {u : U | ∀ m ∈ wordSpan v, u • m ∈ wordSpan v}
  zero_mem' := by intro m _; rw [zero_smul]; exact Submodule.zero_mem _
  add_mem' := by
    intro a b ha hb m hm
    rw [add_smul]
    exact Submodule.add_mem _ (ha m hm) (hb m hm)
  mul_mem' := by
    intro a b ha hb m hm
    rw [mul_smul]
    exact ha _ (hb m hm)
  one_mem' := by intro m hm; simpa using hm
  algebraMap_mem' := by
    intro c m hm
    have hc : (algebraMap ℂ U c) • m = c • m := by
      rw [Algebra.algebraMap_eq_smul_one, smul_assoc, one_smul]
    rw [hc]
    exact Submodule.smul_mem _ c hm

lemma mem_wordPreserver (v : M) (u : U) :
    u ∈ wordPreserver v ↔ ∀ m ∈ wordSpan v, u • m ∈ wordSpan v := Iff.rfl

/-- A Lie subalgebra of the Serre-constructed `e₈` containing the images of the Serre generators
`Eᵢ, Fᵢ, Hᵢ` is everything: `e₈` is generated as a Lie algebra by those elements.

Proof: the quotient map `F →ₗ⁅ℂ⁆ L` (`mk'` with the bracket compatibility) is surjective, and the
Lie hom `F →ₗ⁅ℂ⁆ N` lifting the generators into `N` (universal property of the free Lie algebra)
becomes equal to it after composing with the inclusion `N ↪ L`; hence every element of `e₈` lies
in `N`. -/
theorem eq_top_of_generators (N : LieSubalgebra ℂ L)
    (hgen : ∀ g : Generators (Fin 8),
      LieSubmodule.Quotient.mk (N := J) (FreeLieAlgebra.of ℂ g) ∈ N) : N = ⊤ := by
  -- the quotient map `F → L` as a Lie hom
  let q : F →ₗ⁅ℂ⁆ L :=
    { toLinearMap := (LieSubmodule.Quotient.mk' J).toLinearMap
      map_lie' := by
        intro a b
        exact LieSubmodule.Quotient.mk_bracket (I := J) a b }
  -- the lift of the generators into `N`
  let ψ : F →ₗ⁅ℂ⁆ N := FreeLieAlgebra.lift ℂ (fun g => ⟨_, hgen g⟩)
  have hEq : N.incl.comp ψ = q := by
    apply FreeLieAlgebra.hom_ext
    intro g
    have h1 : ψ (FreeLieAlgebra.of ℂ g) = ⟨_, hgen g⟩ := by
      rw [show ψ = FreeLieAlgebra.lift ℂ (fun g => ⟨_, hgen g⟩) from rfl]
      rw [FreeLieAlgebra.lift_of_apply]
    change N.incl (ψ (FreeLieAlgebra.of ℂ g)) = q (FreeLieAlgebra.of ℂ g)
    rw [h1]
    rfl
  rw [eq_top_iff]
  intro x _
  obtain ⟨z, rfl⟩ := (LieSubmodule.Quotient.surjective_mk' (N := J)) x
  have hz := LieHom.congr_fun hEq z
  have hmem : q z ∈ N := by
    rw [← hz]
    exact (ψ z).2
  exact hmem

/-- **Word spanning.**  If `v` is annihilated by all raising generators `Eᵢ` and is a joint
eigenvector of the diagonal generators `Hᵢ` (eigenvalues `λ`), then every element of the
`U(e₈)`-submodule generated by `v` lies in the span of the word vectors
`F_{i₁} ⋯ F_{i_k} • v`. -/
theorem smul_mem_wordSpan (v : M) (lam : Fin 8 → ℂ) (he : ∀ i, e i • v = 0)
    (hh : ∀ j, h j • v = lam j • v) (u : U) {m : M} (hm : m ∈ wordSpan v) :
    u • m ∈ wordSpan v := by
  classical
  -- the Serre generators preserve the word span
  have hE : ∀ i : Fin 8, e i ∈ wordPreserver v :=
    fun i => (mem_wordPreserver v (e i)).mpr (fun m hm => e_smul_mem_wordSpan v lam he hh i hm)
  have hF : ∀ i : Fin 8, f i ∈ wordPreserver v :=
    fun i => (mem_wordPreserver v (f i)).mpr (fun m hm => f_smul_mem_wordSpan v i hm)
  have hH : ∀ i : Fin 8, h i ∈ wordPreserver v :=
    fun i => (mem_wordPreserver v (h i)).mpr (fun m hm => h_smul_mem_wordSpan v lam hh i hm)
  -- every element of `ι(e₈)` preserves the word span
  have hι : ∀ x : L, ι ℂ x ∈ wordPreserver v := by
    let N : LieSubalgebra ℂ L :=
      { carrier := {x : L | ι ℂ x ∈ wordPreserver v}
        zero_mem' := by
          change ι ℂ (0 : L) ∈ wordPreserver v
          rw [map_zero]
          exact (wordPreserver v).zero_mem
        add_mem' := by
          intro p q hp hq
          change ι ℂ (p + q) ∈ wordPreserver v
          rw [map_add]
          exact (wordPreserver v).add_mem hp hq
        smul_mem' := by
          intro c p hp
          change ι ℂ (c • p) ∈ wordPreserver v
          rw [map_smul]
          exact (wordPreserver v).toSubmodule.smul_mem c hp
        lie_mem' := by
          intro p q hp hq
          change ι ℂ ⁅p, q⁆ ∈ wordPreserver v
          rw [LieHom.map_lie (ι ℂ) p q, LieRing.of_associative_ring_bracket]
          exact (wordPreserver v).sub_mem ((wordPreserver v).mul_mem hp hq)
            ((wordPreserver v).mul_mem hq hp) }
    have hgen : ∀ g : Generators (Fin 8),
        LieSubmodule.Quotient.mk (N := J) (FreeLieAlgebra.of ℂ g) ∈ N := by
      intro g
      match g with
      | Generators.H i => exact hH i
      | Generators.E i => exact hE i
      | Generators.F i => exact hF i
    have htop : N = ⊤ := eq_top_of_generators N hgen
    intro x
    have hx : x ∈ N := by rw [htop]; trivial
    exact hx
  -- hence `U = adjoin (range ι) ≤ wordPreserver v`
  have hle : (⊤ : Subalgebra ℂ U) ≤ wordPreserver v := by
    rw [← Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota]
    exact Algebra.adjoin_le (fun y hy => by obtain ⟨z, rfl⟩ := hy; exact hι z)
  exact (mem_wordPreserver v u).mp (hle (show u ∈ (⊤ : Subalgebra ℂ U) from trivial)) m hm

section Mω

/-- If the module generated by `v` is cyclic and `v` satisfies the highest-weight conditions,
then the word span of `v` is everything. -/
theorem wordSpan_eq_top_of_cyclic (v : M) (lam : Fin 8 → ℂ) (he : ∀ i, e i • v = 0)
    (hh : ∀ j, h j • v = lam j • v) (hc : ∀ m : M, ∃ u : U, u • v = m) :
    wordSpan v = ⊤ := by
  rw [eq_top_iff]
  intro m _
  obtain ⟨u, rfl⟩ := hc m
  exact smul_mem_wordSpan v lam he hh u (wordVec_mem_wordSpan v [])

/-- Every element of the highest-weight module `M(ω₁+ω₈)` is a `ℂ`-linear combination of the
vectors `F_{i₁} ⋯ F_{i_k} • v(ω₁+ω₈)` obtained from the highest-weight vector by applying the
lowering generators. -/
theorem wordSpan_vω_eq_top : wordSpan (M := Mω) vω = ⊤ := by
  refine wordSpan_eq_top_of_cyclic vω omegaOnePlusOmegaEight
    (fun i => e_annihilates_omega i) ?_ (fun m => cyclic_omega m)
  intro j
  rw [h_acts_omega j, weightInU]
  exact algebraMap_smul_Mω _ _

/-- The word vector of `w` applied to `vω` lies in the joint weight space of the weight
`ω₁ + ω₈ - ∑_{i ∈ w} αᵢ`. -/
lemma wordVec_mem_jointWeightSpace (w : List (Fin 8)) :
    wordVec vω w ∈ jointWeightSpace
      (fun j => omegaOnePlusOmegaEight j - (w.map (fun i => (CartanMatrix.E₈ j i : ℂ))).sum) := by
  intro j
  rw [h_smul_wordVec vω omegaOnePlusOmegaEight (fun k => by
    rw [h_acts_omega k, weightInU]; exact algebraMap_smul_Mω _ _) j w]

/-- The joint weight spaces span the highest-weight module `M(ω₁+ω₈)`. -/
theorem iSup_jointWeightSpace_eq_top :
    (⨆ μ : Fin 8 → ℂ, jointWeightSpace μ) = ⊤ := by
  rw [eq_top_iff, ← wordSpan_vω_eq_top]
  change Submodule.span ℂ (Set.range (wordVec vω)) ≤ ⨆ μ : Fin 8 → ℂ, jointWeightSpace μ
  rw [Submodule.span_le]
  rintro x ⟨w, rfl⟩
  exact le_iSup (fun μ : Fin 8 → ℂ => jointWeightSpace μ)
    (fun j => omegaOnePlusOmegaEight j - (w.map (fun i => (CartanMatrix.E₈ j i : ℂ))).sum)
    (wordVec_mem_jointWeightSpace w)

end Mω

end Submission.WordSpan
