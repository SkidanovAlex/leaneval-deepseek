/-- **The root system is the union of the two standard families** `±2εᵢ ± 2εⱼ` and
`(±1,…,±1)` with an even number of minus signs. -/
theorem rootsAll_toFinset :
    rootsAll.toFinset = pairRootsList.toFinset ∪ spinorRootsList.toFinset := by decide

theorem rootsAll_length : rootsAll.length = 240 := rfl

theorem rootsAll_nodup : rootsAll.Nodup := by decide

/-- The root system is stable under negation. -/
theorem rootsAll_neg : rootsAll.all (fun a => decide (a.map (fun x => -x) ∈ rootsAll)) = true := by
  decide

