/-- **The positive roots are the roots with positive `ρ`-pairing.**  This identifies the explicit
list `posRootList` (over which the Weyl dimension formula is evaluated) with the positive roots of
the 240-element root system `rootsAll`. -/
theorem posRootList_eq_filter :
    rootsAll.filter (fun a => decide (0 < dotInt rho a)) = posRootList := by decide

/-- The product `∏_{α > 0} ⟨ω₁+ω₈+ρ, α∨⟩ / ⟨ρ, α∨⟩` as a rational number. -/
def weylDim : ℚ :=
  (posRootList.map (fun a => (dotInt lamPlusRho a : ℚ) / (dotInt rho a : ℚ))).prod

/-- **The Cartan matrix of the concrete simple roots of E₈ is (four times) `CartanMatrix.E₈`.** -/
theorem simpleRoot_cartan (i j : Fin 8) :
    dotInt (simpleRoot i) (simpleRoot j) = 4 * CartanMatrix.E₈ i j := by
  fin_cases i <;> fin_cases j <;>
    · simp only [simpleRoot, dotInt, CartanMatrix.E₈, CartanMatrix.E_eight_eq, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_succ, Matrix.cons_val_succ', List.zipWith_cons_cons, List.zipWith_nil_left,
        List.zipWith_nil_right, List.sum_cons, List.sum_nil]
      norm_num

/-- **The Weyl dimension formula at the highest weight `ω₁ + ω₈` of E₈**: the product
`∏_{α > 0} ⟨ω₁+ω₈+ρ, α∨⟩ / ⟨ρ, α∨⟩` over the 120 positive roots equals `779247`, the dimension of
`V(ω₁ + ω₈)`. -/
theorem weyl_dim_e8 : weylDim = 779247 := by
  simp only [weylDim, posRootList, List.map_cons, List.map_nil, List.prod_cons, List.prod_nil,
    dotInt, lamPlusRho, rho, List.zipWith_cons_cons, List.zipWith_nil_left,
    List.zipWith_nil_right, List.sum_cons, List.sum_nil]
  norm_num

/-- **Weyl dimension formula at `ω₁ + ω₈`, over the full root system**: evaluating
`∏_{α > 0} ⟨ω₁+ω₈+ρ, α∨⟩ / ⟨ρ, α∨⟩` over *all* positive roots of the E₈ root system `rootsAll`
gives `779247`. -/
theorem weyl_dim_e8_full :
    (((rootsAll.filter (fun a => decide (0 < dotInt rho a))).map
      (fun a => (dotInt lamPlusRho a : ℚ) / (dotInt rho a : ℚ))).prod) = 779247 := by
  rw [posRootList_eq_filter]
  exact weyl_dim_e8

/-- The Weyl vector pairs to `1` against every simple root. -/
theorem rho_duality (i : Fin 8) : dotInt rho (simpleRoot i) = 4 := by
  fin_cases i <;>
    · simp only [simpleRoot, dotInt, rho, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_succ, Matrix.cons_val_succ', List.zipWith_cons_cons, List.zipWith_nil_left,
        List.zipWith_nil_right, List.sum_cons, List.sum_nil]
      norm_num

/-- `ω₁ + ω₈` pairs to `1` against `α₁` and `α₈` and to `0` against the other simple roots. -/
theorem omega1PlusOmega8_duality (i : Fin 8) :
    dotInt omega1PlusOmega8 (simpleRoot i) =
      4 * (if i = 0 then 1 else if i = 7 then 1 else 0 : ℤ) := by
  fin_cases i <;>
    · simp only [simpleRoot, dotInt, omega1PlusOmega8, Matrix.of_apply, Matrix.cons_val_zero,
        Matrix.cons_val_succ, Matrix.cons_val_succ', List.zipWith_cons_cons, List.zipWith_nil_left,
        List.zipWith_nil_right, List.sum_cons, List.sum_nil]
      norm_num <;> decide

/-- `lamPlusRho = ω₁ + ω₈ + ρ`. -/
theorem lamPlusRho_eq : lamPlusRho = rho.zipWith (· + ·) omega1PlusOmega8 := by
  simp [lamPlusRho, rho, omega1PlusOmega8]

/-- There are 120 roots listed. -/
theorem posRootList_length : posRootList.length = 120 := rfl

/-- The 120 listed positive roots are pairwise distinct. -/
theorem posRootList_nodup : posRootList.Nodup := by decide

/-- A decidable test for "`a` is a positive root of E₈" in the doubled coordinates. -/
def rootVecOK (a : List ℤ) : Bool :=
  (a.length == 8) && (dotInt a a == 8) && decide (0 < dotInt rho a)

theorem posRootList_all : posRootList.all rootVecOK = true := by decide

/-- Every listed vector really is a root of E₈ with positive `ρ`-pairing: with the doubling, a
root `x = [x₀,…,x₇]` of the "even coordinate system" satisfies `dotInt x x = 8` (norm squared `2`
in the undoubled normalization). -/
theorem posRootList_facts :
    ∀ a ∈ posRootList, a.length = 8 ∧ dotInt a a = 8 ∧ 0 < dotInt rho a := by
  intro a ha
  have h := (List.all_eq_true.mp posRootList_all) a ha
  simp only [rootVecOK, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  exact ⟨h.1.1, h.1.2, h.2⟩

end Submission.E8RootSystem
