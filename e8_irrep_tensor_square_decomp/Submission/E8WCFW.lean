import Submission.E8WCFE

/-!
# `W`-invariance of the Euler characteristic `euler Λ`: the reduction to simple reflections

`Submission/E8WCFE.lean` proves that for a dominant `Λ` the Euler characteristic
`euler Λ = ∑_{N ∈ W} ε(N)·chV(N·Λ)` of the Verma modules on the dot-orbit of `Λ` satisfies

* `euler_top`  : `euler Λ Λ = 1`,
* `euler_support` : `euler Λ μ ≠ 0 → Λ - μ ∈ ℕΦ⁺ ∪ {0}`,
* `euler_freudenthal` : the Freudenthal recursion, *at every weight*.

The fourth hypothesis of `Submission.E8Character.eq_of_freudenthal` is `W`-invariance under the
dominant conjugate.  This file provides the two structural steps of the (still missing) proof:

* `WSum_comp_ap` — the Weyl sum of `f ∘ w` is `ε(w)` times the Weyl sum of `f` at `w x`;
* `WSum_euler_ap` — hence `WSum (euler Λ ∘ w) = WSum (euler Λ)` for every `w ∈ W`
  (`A_ρ` cannot distinguish `euler Λ` from its `W`-conjugates);
* `euler_wact_of_simple` — it therefore suffices to prove `euler Λ (sᵢ μ) = euler Λ μ` for the
  *simple* reflections `sᵢ` (the Weyl group is generated by them, and `srefMat i = wactMat [i]`).

## Why the obvious argument fails

`WSum_eq_zero_of_bounded` (`Submission/E8NoKernel.lean`) would conclude `euler Λ ∘ w = euler Λ`
from `WSum (euler Λ ∘ w - euler Λ) = 0` provided the difference has *bounded height* support.
The support of `euler Λ ∘ w - euler Λ` is contained in the union of the two cone translates

  `Λ - ℚ⁺`   and   `w⁻¹(Λ - ℚ⁺) = w⁻¹Λ - w⁻¹ℚ⁺`,

and the second one is *not* height-bounded (it is a twisted cone): for `w = sᵢ` it contains the
ray `sᵢΛ + ℕαᵢ`.  The correct tool is therefore a *cone* functional, not the height — but for
`sᵢ` the only linear functional `φ` that is nonnegative both on `ℚ⁺` and on `sᵢℚ⁺` vanishes on
`αᵢ`, so the maximality argument leaves exactly the `N = sᵢ` term of the Weyl sum:

  `H(ν) + ε(sᵢ)·H(ν + αᵢ) = 0`   for `φ`-maximal `ν ∈ supp H`,

and iterating gives `H(ν + kαᵢ) = (-ε(sᵢ))^k H(ν)`: if `H ≠ 0` then `H` is non-zero and of
constant absolute value on an infinite ray.  Killing this ray (by the finiteness of the support of
`ch L(Λ)`, or by the Freudenthal recursion) is the remaining step.

-/

set_option maxHeartbeats 2000000
set_option maxRecDepth 10000
set_option linter.unusedSimpArgs false

noncomputable section
open scoped BigOperators

namespace Submission.E8WCFW

open Commons.LinearAlgebra.Matrix.Cartan
open Submission.WCFSetup
open Submission.E8Character
open Submission.E8WCFC

/-! ## The Weyl sum of a `W`-conjugate -/

lemma ap_sub' (M : Matrix (Fin 8) (Fin 8) ℤ) (a b : Fin 8 → ℤ) :
    ap M (a - b) = ap M a - ap M b := Matrix.mulVec_sub M a b

/-- If `M' * M = 1` then `M'.det = M.det` (both are `±1` and their product is `1`). -/
lemma det_eq_of_mul_eq_one {M M' : Matrix (Fin 8) (Fin 8) ℤ} (h : M' * M = 1) :
    M'.det = M.det ∧ (M.det = 1 ∨ M.det = -1) := by
  have h1 : M'.det * M.det = 1 := by rw [← Matrix.det_mul, h, Matrix.det_one]
  have h2 := Int.mul_eq_one_iff_eq_one_or_neg_one.mp h1
  rcases h2 with ⟨ha, hb⟩ | ⟨ha, hb⟩
  · exact ⟨by rw [ha, hb], Or.inl hb⟩
  · exact ⟨by rw [ha, hb], Or.inr hb⟩

/-- **`WSum (f ∘ w) x = ε(w) · WSum f (w x)`.** -/
theorem WSum_comp_ap {f : (Fin 8 → ℤ) → ℚ} (M : Matrix (Fin 8) (Fin 8) ℤ) (hM : M ∈ WG)
    (x : Fin 8 → ℤ) :
    WSum (fun v => f (ap M v)) x = (M.det : ℚ) * WSum f (ap M x) := by
  classical
  obtain ⟨M', hM', hMM', hM'M⟩ := WG_inv hM
  obtain ⟨-, hunit⟩ := det_eq_of_mul_eq_one hM'M
  have hsq : ((M.det : ℚ)) * ((M.det : ℚ)) = 1 := by
    rcases hunit with h | h <;> rw [h] <;> norm_num
  have hleft : WSum (fun v => f (ap M v)) x
      = ∑ N ∈ WG, (N.det : ℚ) * f (ap M x - ap (M * N) rhoV) := by
    rw [WSum]
    refine Finset.sum_congr rfl fun N _ => ?_
    rw [ap_sub', ap_mul]
  rw [hleft, WSum, Finset.mul_sum]
  refine Finset.sum_bij (fun N _ => M * N) ?_ ?_ ?_ ?_
  · intro N hN; exact WG_mul hM hN
  · intro N₁ h₁ N₂ h₂ heq
    have := congrArg (fun P : Matrix (Fin 8) (Fin 8) ℤ => M' * P) heq
    simpa only [← Matrix.mul_assoc, hM'M, Matrix.one_mul] using this
  · intro P hP
    exact ⟨M' * P, WG_mul hM' hP, by rw [← Matrix.mul_assoc, hMM', Matrix.one_mul]⟩
  · intro N hN
    have hc : (((M * N).det : ℤ) : ℚ) = (M.det : ℚ) * (N.det : ℚ) := by
      rw [Matrix.det_mul]; push_cast; ring
    rw [hc,
      show ((M.det : ℚ)) * (((M.det : ℚ)) * ((N.det : ℚ)) * f (ap M x - ap (M * N) rhoV))
        = (((M.det : ℚ)) * ((M.det : ℚ))) * (((N.det : ℚ)) * f (ap M x - ap (M * N) rhoV))
        from by ring,
      hsq, one_mul]

/-- **`A_ρ` does not distinguish `euler Λ` from its `W`-conjugates.** -/
theorem WSum_euler_ap (Λ : Fin 8 → ℤ) (M : Matrix (Fin 8) (Fin 8) ℤ) (hM : M ∈ WG)
    (x : Fin 8 → ℤ) :
    WSum (fun v => euler Λ (ap M v)) x = WSum (euler Λ) x := by
  obtain ⟨M', hM', hMM', hM'M⟩ := WG_inv hM
  obtain ⟨-, hunit⟩ := det_eq_of_mul_eq_one hM'M
  have hsq : ((M.det : ℚ)) * ((M.det : ℚ)) = 1 := by
    rcases hunit with h | h <;> rw [h] <;> norm_num
  rw [WSum_comp_ap M hM x, WSum_euler Λ (ap M x), alt_ap (Λ + rhoV) x hM,
    WSum_euler Λ x, ← mul_assoc, hsq, one_mul]

/-! ## Reduction to the simple reflections -/

/-- **It suffices to check the invariance of `euler Λ` on the simple reflections.** -/
theorem euler_wact_of_simple (Λ : Fin 8 → ℤ)
    (h : ∀ (i : Fin 8) (μ : Fin 8 → ℤ), euler Λ (ap (srefMat i) μ) = euler Λ μ)
    (L : List (Fin 8)) (μ : Fin 8 → ℤ) :
    euler Λ (ap (wactMat L) μ) = euler Λ μ := by
  induction L generalizing μ with
  | nil => simp [wactMat_nil]
  | cons i L ih =>
      rw [wactMat_cons, ap_mul, ih, h i]


/-! ## The auxiliary functional `ψ` -/

def alp (i : Fin 8) : Fin 8 → ℤ := CartanMatrix.E₈ i

lemma E8c_symm (j k : Fin 8) : CartanMatrix.E₈ j k = CartanMatrix.E₈ k j :=
  E8_diag_offdiag_symm.1 j k

lemma alp_eq_mulVec (i : Fin 8) :
    alp i = Matrix.mulVec CartanMatrix.E₈ (Pi.single i 1) := by
  funext j
  simp only [alp, Matrix.mulVec, dotProduct, Pi.single_apply]
  rw [Finset.sum_eq_single i (fun b _ hb => by rw [if_neg hb, mul_zero]) (fun h => absurd
    (Finset.mem_univ i) h), if_pos rfl, mul_one, E8c_symm]

lemma coords_alp (i : Fin 8) : Submission.E8Character.coords (alp i) = Pi.single i (1 : ℤ) := by
  rw [alp_eq_mulVec, Submission.E8Character.coords_mulVec]

lemma htOf_alp (i : Fin 8) : Submission.E8Character.htOf (alp i) = 1 := by
  rw [Submission.E8Character.htOf, coords_alp]
  simp [Pi.single_apply, Finset.sum_ite_eq, Finset.mem_univ]

/-- **The functional `ψ`**: `ψ ν = htOf ν - (coords ν) i`.  It is linear, nonnegative on the
positive cone, vanishes on `αᵢ`, and is `1` on the other simple roots. -/
def psi (i : Fin 8) (ν : Fin 8 → ℤ) : ℤ :=
  Submission.E8Character.htOf ν - Submission.E8Character.coords ν i

lemma psi_alp (i k : Fin 8) : psi i (alp k) = if k = i then 0 else 1 := by
  have hc : Submission.E8Character.coords (alp k) i
      = (Pi.single k (1 : ℤ) : Fin 8 → ℤ) i := by
    rw [coords_alp]
  rw [psi, htOf_alp, hc]
  by_cases h : k = i
  · simp [Pi.single_apply, h]
  · simp [Pi.single_apply, h]

lemma psi_nonneg (i : Fin 8) {γ : Fin 8 → ℤ} (h : Submission.E8Character.posCon γ) :
    0 ≤ psi i γ := by
  have h1 : Submission.E8Character.coords γ i ≤ Submission.E8Character.htOf γ := by
    rw [Submission.E8Character.htOf]
    exact Finset.single_le_sum (fun j _ => h j) (Finset.mem_univ i)
  simp only [psi]; linarith

lemma psi_add (i : Fin 8) (γ δ : Fin 8 → ℤ) : psi i (γ + δ) = psi i γ + psi i δ := by
  simp only [psi, Submission.E8Character.htOf_add, Submission.E8Character.coords_add,
    Pi.add_apply]
  ring

lemma psi_smul (i : Fin 8) (c : ℤ) (γ : Fin 8 → ℤ) : psi i (c • γ) = c * psi i γ := by
  simp only [psi, Submission.E8Character.htOf_smul_int, Submission.E8Character.coords_smul,
    Pi.smul_apply, smul_eq_mul]
  ring

lemma coords_sub' (γ δ : Fin 8 → ℤ) :
    Submission.E8Character.coords (γ - δ)
      = Submission.E8Character.coords γ - Submission.E8Character.coords δ := by
  rw [Submission.E8Character.coords_eq, Submission.E8Character.coords_eq,
    Submission.E8Character.coords_eq, Matrix.mulVec_sub]

lemma psi_sub (i : Fin 8) (γ δ : Fin 8 → ℤ) : psi i (γ - δ) = psi i γ - psi i δ := by
  simp only [psi, Submission.E8Character.htOf_sub, coords_sub', Pi.sub_apply]; ring

/-- `sref i ν = ν - νᵢ • αᵢ`. -/
lemma sref_eq_sub (i : Fin 8) (ν : Fin 8 → ℤ)
    : Commons.LinearAlgebra.Matrix.Cartan.sref i ν = ν - ν i • alp i := by
  funext j
  simp only [Commons.LinearAlgebra.Matrix.Cartan.sref_apply, Pi.sub_apply, Pi.smul_apply,
    alp, smul_eq_mul]

lemma psi_sref (i : Fin 8) (ν : Fin 8 → ℤ)
    : psi i (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) = psi i ν := by
  rw [sref_eq_sub, psi_sub, psi_smul, psi_alp, if_pos rfl, mul_zero, sub_zero]

lemma sref_coord (i : Fin 8) (ν : Fin 8 → ℤ)
    : (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) i = - (ν i) := by
  rw [Commons.LinearAlgebra.Matrix.Cartan.sref_apply,
    Commons.LinearAlgebra.Matrix.Cartan.E8m_diag]
  ring

lemma sref_inv' (i : Fin 8) (ν : Fin 8 → ℤ)
    : Commons.LinearAlgebra.Matrix.Cartan.sref i
        (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) = ν :=
  Commons.LinearAlgebra.Matrix.Cartan.sref_invol i ν

lemma ap_srefMat (i : Fin 8) (ν : Fin 8 → ℤ)
    : ap (srefMat i) ν = Commons.LinearAlgebra.Matrix.Cartan.sref i ν := by
  rw [← wactMat_singleton]
  show (wactMat [i]).mulVec ν = _
  rw [wactMat_mulVec, Commons.LinearAlgebra.Matrix.Cartan.wact_singleton]

lemma srefMat_mem (i : Fin 8) : srefMat i ∈ WG := by
  rw [← wactMat_singleton]; exact wactMat_mem [i]


/-! ## Linearity of the simple reflection -/

lemma alp_diag (i : Fin 8) : alp i i = 2 :=
  Commons.LinearAlgebra.Matrix.Cartan.E8m_diag i

lemma sref_add' (i : Fin 8) (a b : Fin 8 → ℤ) :
    Commons.LinearAlgebra.Matrix.Cartan.sref i (a + b)
      = Commons.LinearAlgebra.Matrix.Cartan.sref i a
        + Commons.LinearAlgebra.Matrix.Cartan.sref i b := by
  funext j
  simp only [Commons.LinearAlgebra.Matrix.Cartan.sref_apply, Pi.add_apply]
  ring

lemma sref_smul' (i : Fin 8) (c : ℤ) (a : Fin 8 → ℤ) :
    Commons.LinearAlgebra.Matrix.Cartan.sref i (c • a)
      = c • Commons.LinearAlgebra.Matrix.Cartan.sref i a := by
  funext j
  simp only [Commons.LinearAlgebra.Matrix.Cartan.sref_apply, Pi.smul_apply, smul_eq_mul]
  ring

lemma sref_alp (i : Fin 8) :
    Commons.LinearAlgebra.Matrix.Cartan.sref i (alp i) = - alp i := by
  rw [sref_eq_sub, alp_diag]
  funext j
  simp only [Pi.sub_apply, Pi.neg_apply, Pi.smul_apply, smul_eq_mul]
  ring

/-- `sref i (ν + k • αᵢ) = sref i ν - k • αᵢ`. -/
lemma sref_add_smul_alp (i : Fin 8) (ν : Fin 8 → ℤ) (k : ℤ) :
    Commons.LinearAlgebra.Matrix.Cartan.sref i (ν + k • alp i)
      = Commons.LinearAlgebra.Matrix.Cartan.sref i ν - k • alp i := by
  rw [sref_add', sref_smul', sref_alp, smul_neg]
  abel

lemma sref_rhoV (i : Fin 8) :
    Commons.LinearAlgebra.Matrix.Cartan.sref i rhoV = rhoV - alp i := by
  rw [sref_eq_sub]
  simp [rhoV]

lemma posCon_rhoV_sub_ap (M : Matrix (Fin 8) (Fin 8) ℤ) (hM : M ∈ WG) :
    posCon (rhoV - ap M rhoV) := by
  obtain ⟨L, rfl⟩ := mem_WG.mp hM
  have h := posCon_dom_sub_wact L rhoZ (fun x => show (0:ℤ) ≤ 1 from by norm_num)
  have h2 : rhoV - ap (wactMat L) rhoV = rhoZ - wact L rhoZ := by
    rw [rhoV_eq, wactMat_ap]
  rwa [h2]

lemma htOf_ap_rhoV_le (M : Matrix (Fin 8) (Fin 8) ℤ) (hM : M ∈ WG) :
    htOf (ap M rhoV) ≤ htOf rhoV := by
  have h := htOf_nonneg (posCon_rhoV_sub_ap M hM)
  rw [htOf_sub] at h
  linarith

lemma htOf_smul_alp (i : Fin 8) (k : ℤ) : htOf (k • alp i) = k := by
  rw [htOf_smul_int, htOf_alp, mul_one]

/-- **The classification**: the only `M ∈ W`, `M ≠ 1` with `ψ (ρ - Mρ) = 0` is the simple
reflection `sᵢ`. -/
theorem gamma_eq_srefMat (i : Fin 8) {M : Matrix (Fin 8) (Fin 8) ℤ} (hM : M ∈ WG)
    (hM1 : M ≠ 1) (hpsi : psi i (rhoV - ap M rhoV) = 0) : M = srefMat i := by
  set γ : Fin 8 → ℤ := rhoV - ap M rhoV with hγ
  have hpos : posCon γ := posCon_rhoV_sub_ap M hM
  have hγpsi : psi i γ = 0 := by rw [hγ]; exact hpsi
  have hht : htOf γ = Submission.E8Character.coords γ i := by
    simpa only [psi] using sub_eq_zero.mp hγpsi
  have hzero : ∀ k : Fin 8, k ≠ i → Submission.E8Character.coords γ k = 0 := by
    intro k hk
    have hsum : htOf γ = ∑ l, Submission.E8Character.coords γ l := rfl
    have hmem : k ∈ Finset.univ.erase i := Finset.mem_erase.mpr ⟨hk, Finset.mem_univ k⟩
    have hle : Submission.E8Character.coords γ k
        ≤ ∑ l ∈ Finset.univ.erase i, Submission.E8Character.coords γ l :=
      Finset.single_le_sum (fun l _ => hpos l) hmem
    have heq : ∑ l ∈ Finset.univ.erase i, Submission.E8Character.coords γ l = 0 := by
      have h3 : (∑ l ∈ Finset.univ.erase i, Submission.E8Character.coords γ l)
          + Submission.E8Character.coords γ i = htOf γ := by
        rw [Finset.sum_erase_add _ _ (Finset.mem_univ i)]; exact hsum.symm
      rw [hht] at h3; linarith
    linarith [hpos k]
  set c : ℤ := Submission.E8Character.coords γ i with hc
  have hcnonneg : 0 ≤ c := hpos i
  have hγc : γ = c • alp i := by
    have hcoords : Submission.E8Character.coords γ
        = c • (Pi.single i (1 : ℤ) : Fin 8 → ℤ) := by
      funext k
      by_cases hk : k = i
      · subst hk; simp [hc, Pi.smul_apply]
      · rw [hzero k hk]
        simp [Pi.smul_apply, Pi.single_apply, hk]
    rw [← Submission.E8Character.mulVec_coords γ, hcoords, Matrix.mulVec_smul,
      ← alp_eq_mulVec]
  have hcne : c ≠ 0 := by
    intro h0
    apply hM1
    have hz : γ = 0 := by rw [hγc, h0]; simp
    have hfix : ap M rhoV = rhoV := by
      have h2 : rhoV - ap M rhoV = 0 := by rw [← hγ]; exact hz
      exact (sub_eq_zero.mp h2).symm
    obtain ⟨L, rfl⟩ := mem_WG.mp hM
    have hfix' : wact L rhoZ = rhoZ := by
      have h3 := hfix
      rwa [rhoV_eq, wactMat_ap] at h3
    rw [show (1 : Matrix (Fin 8) (Fin 8) ℤ) = wactMat ([] : List (Fin 8)) from
      wactMat_nil.symm]
    exact wactMat_eq_of_rho_eq hfix'
  have hc1 : c = 1 := by
    have h1 : Commons.LinearAlgebra.Matrix.Cartan.sref i (ap M rhoV)
        = rhoV + (c - 1) • alp i := by
      have hap : ap M rhoV = rhoV - γ := by rw [hγ]; abel
      rw [hap, hγc, show rhoV - c • alp i = rhoV + (-c) • alp i from by
        rw [neg_smul]; abel,
        sref_add_smul_alp, sref_rhoV, neg_smul]
      rw [show rhoV - alp i - -(c • alp i) = rhoV + (c - 1) • alp i from by
        rw [sub_smul, one_smul]; abel]
    have h2 : htOf (Commons.LinearAlgebra.Matrix.Cartan.sref i (ap M rhoV))
        ≤ htOf rhoV := by
      have h3 : Commons.LinearAlgebra.Matrix.Cartan.sref i (ap M rhoV)
          = ap (srefMat i * M) rhoV := by
        rw [ap_mul, ap_srefMat]
      rw [h3]
      exact htOf_ap_rhoV_le (srefMat i * M) (WG_mul (srefMat_mem i) hM)
    rw [h1, htOf_add, htOf_smul_alp, Submission.E8WCFC.htOf_rhoV] at h2
    omega
  obtain ⟨L, rfl⟩ := mem_WG.mp hM
  have hfix : wact L rhoZ = wact [i] rhoZ := by
    have h1 : ap (wactMat L) rhoV = ap (srefMat i) rhoV := by
      have hγi : γ = alp i := by rw [hγc, hc1, one_smul]
      have h2 : rhoV - ap (wactMat L) rhoV = rhoV - ap (srefMat i) rhoV := by
        funext j
        have hj := congrFun (hγ.symm.trans hγi) j
        have h4 : ap (srefMat i) rhoV = rhoV - alp i := by rw [ap_srefMat, sref_rhoV]
        rw [h4]
        simp only [Pi.sub_apply] at hj ⊢
        linarith
      funext j
      have hj := congrFun h2 j
      simp only [Pi.sub_apply] at hj ⊢
      linarith [hj]
    rw [rhoV_eq, wactMat_ap, ap_srefMat,
      ← Commons.LinearAlgebra.Matrix.Cartan.wact_singleton i] at h1
    exact h1
  exact (wactMat_eq_of_rho_eq hfix).trans (wactMat_singleton i)

lemma psi_le_of_posCon (i : Fin 8) {γ : Fin 8 → ℤ} (h : posCon γ) (ν : Fin 8 → ℤ) :
    psi i ν ≤ psi i (ν + γ) := by
  rw [psi_add]
  have := psi_nonneg i h
  linarith

lemma WSum_sub' {f g : (Fin 8 → ℤ) → ℚ} (x : Fin 8 → ℤ) :
    WSum (f - g) x = WSum f x - WSum g x := by
  simp only [WSum, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib]

lemma sref_rhoV_sub_alp (i : Fin 8) :
    rhoV - ap (srefMat i) rhoV = alp i := by
  rw [ap_srefMat, sref_rhoV]; abel

/-- **`W`-invariance of `euler Λ` on a simple reflection.** -/
theorem euler_sref (Λ : Fin 8 → ℤ) (hΛ : ∀ i, 0 ≤ Λ i) (i : Fin 8) (μ : Fin 8 → ℤ) :
    euler Λ (Commons.LinearAlgebra.Matrix.Cartan.sref i μ) = euler Λ μ := by
  classical
  set H : (Fin 8 → ℤ) → ℚ := fun ν => euler Λ (Commons.LinearAlgebra.Matrix.Cartan.sref i ν)
    - euler Λ ν with hH
  have hH_sref : ∀ ν, H (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) = - H ν := by
    intro ν
    simp only [hH]
    rw [Commons.LinearAlgebra.Matrix.Cartan.sref_invol i ν]
    ring
  have hW : ∀ x, WSum H x = 0 := by
    intro x
    have h1 : WSum (fun ν => euler Λ (ap (srefMat i) ν)) x = WSum (euler Λ) x :=
      WSum_euler_ap Λ (srefMat i) (srefMat_mem i) x
    have h3 : H = (fun ν => euler Λ (ap (srefMat i) ν)) - euler Λ := by
      funext ν; simp only [hH, Pi.sub_apply, ap_srefMat]
    rw [h3, WSum_sub', h1, sub_self]
  suffices hH0 : H = 0 by
    have h1 := congrFun hH0 μ
    exact sub_eq_zero.mp (by simpa [hH] using h1)
  by_contra hc
  have hc' : ∃ ν, H ν ≠ 0 := by
    by_contra h; push Not at h
    exact hc (funext h)
  obtain ⟨ν₁, hν₁⟩ := hc'
  have hbdd : ∀ ν, H ν ≠ 0 → psi i ν ≤ psi i Λ := by
    intro ν hν
    have h1 : euler Λ (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) ≠ 0 ∨ euler Λ ν ≠ 0 := by
      by_contra hcc; push Not at hcc
      exact hν (by simp only [hH]; rw [hcc.1, hcc.2, sub_self])
    rcases h1 with h1 | h1
    · have hp := Submission.E8WCFE.euler_support hΛ h1
      have h2 := psi_le_of_posCon i hp (Commons.LinearAlgebra.Matrix.Cartan.sref i ν)
      have h3 : Commons.LinearAlgebra.Matrix.Cartan.sref i ν + (Λ - Commons.LinearAlgebra.Matrix.Cartan.sref i ν) = Λ := by
        abel
      rw [h3, psi_sref] at h2
      exact h2
    · have hp := Submission.E8WCFE.euler_support hΛ h1
      have h2 := psi_le_of_posCon i hp ν
      have h3 : ν + (Λ - ν) = Λ := by abel
      rwa [h3] at h2
  set S : Finset ℤ := (Finset.Icc (psi i ν₁) (psi i Λ)).filter
      (fun q => ∃ ν, psi i ν = q ∧ H ν ≠ 0) with hS
  have hm₁ : psi i ν₁ ∈ S := Finset.mem_filter.mpr
    ⟨Finset.mem_Icc.mpr ⟨le_refl _, hbdd ν₁ hν₁⟩, ⟨ν₁, rfl, hν₁⟩⟩
  have hSne : S.Nonempty := ⟨psi i ν₁, hm₁⟩
  set m : ℤ := S.max' hSne with hm
  have hmS : m ∈ S := Finset.max'_mem S hSne
  obtain ⟨ν₀, hν₀ψ, hν₀H⟩ := (Finset.mem_filter.mp hmS).2
  have hSle : psi i ν₁ ≤ m := by
    rw [hm]; exact Finset.le_max' S (psi i ν₁) hm₁
  have hmax : ∀ ν, H ν ≠ 0 → psi i ν ≤ m := by
    intro ν hν
    by_cases hcase : psi i ν₁ ≤ psi i ν
    · have hmem : psi i ν ∈ S := Finset.mem_filter.mpr
        ⟨Finset.mem_Icc.mpr ⟨hcase, hbdd ν hν⟩, ν, rfl, hν⟩
      exact Finset.le_max' S _ hmem
    · push Not at hcase
      exact le_trans (le_of_lt hcase) hSle
  -- the two key relations
  have hstep : ∀ ν, psi i ν = m → H ν ≠ 0 → H (ν + alp i) = H ν := by
    intro ν hνψ hνH
    have hsum : (∑ M ∈ WG, (M.det : ℚ) * H (ν + (rhoV - ap M rhoV))) = 0 := by
      have h0 := hW (ν + rhoV)
      rw [WSum] at h0
      rw [← h0]
      refine Finset.sum_congr rfl fun M _ => ?_
      congr 2
      abel
    have hsplit : (∑ M ∈ WG, (M.det : ℚ) * H (ν + (rhoV - ap M rhoV)))
        = H ν + ∑ M ∈ WG.erase (1 : Matrix (Fin 8) (Fin 8) ℤ),
            (M.det : ℚ) * H (ν + (rhoV - ap M rhoV)) := by
      have h1 := Finset.sum_erase_add WG
        (fun M => (M.det : ℚ) * H (ν + (rhoV - ap M rhoV)))
        (WG_one : (1 : Matrix (Fin 8) (Fin 8) ℤ) ∈ WG)
      rw [← h1]
      simp only [Matrix.det_one, Int.cast_one, one_mul, ap_one, sub_self, add_zero]
      ring
    rw [hsplit] at hsum
    have hrest : (∑ M ∈ WG.erase (1 : Matrix (Fin 8) (Fin 8) ℤ),
          (M.det : ℚ) * H (ν + (rhoV - ap M rhoV))) = - H (ν + alp i) := by
      have hval : ((srefMat i).det : ℚ) * H (ν + (rhoV - ap (srefMat i) rhoV))
          = - H (ν + alp i) := by
        rw [Commons.LinearAlgebra.Matrix.Cartan.srefMat_det, sref_rhoV_sub_alp]
        norm_num
      refine (Finset.sum_eq_single (srefMat i) ?_ ?_).trans hval
      · intro M hM hMne
        have hM' : M ∈ WG := Finset.mem_of_mem_erase hM
        have hM1 : M ≠ 1 := Finset.ne_of_mem_erase hM
        by_cases hz : psi i (rhoV - ap M rhoV) = 0
        · exact absurd (gamma_eq_srefMat i hM' hM1 hz) hMne
        · have hp := posCon_rhoV_sub_ap M hM'
          have hgt : 0 < psi i (rhoV - ap M rhoV) := by
            have := psi_nonneg i hp; omega
          have hHz : H (ν + (rhoV - ap M rhoV)) = 0 := by
            by_contra hH0
            have hle := hmax _ hH0
            rw [psi_add, hνψ] at hle
            omega
          rw [hHz, mul_zero]
      · intro hnot
        have hne : srefMat i ≠ (1 : Matrix (Fin 8) (Fin 8) ℤ) := by
          intro heq
          have h2 : (srefMat i).det = (1 : Matrix (Fin 8) (Fin 8) ℤ).det := congrArg Matrix.det heq
          rw [Commons.LinearAlgebra.Matrix.Cartan.srefMat_det, Matrix.det_one] at h2
          norm_num at h2
        exact absurd (Finset.mem_erase.mpr ⟨hne, srefMat_mem i⟩) hnot
    rw [hrest] at hsum
    linarith
  have hstepm : ∀ ν, psi i ν = m → H ν ≠ 0 → H (ν - alp i) = H ν := by
    intro ν hνψ hνH
    have hs : H (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) ≠ 0 := by
      rw [hH_sref]; simpa using hνH
    have hψs : psi i (Commons.LinearAlgebra.Matrix.Cartan.sref i ν) = m := by
      rw [psi_sref, hνψ]
    have h1 := hstep _ hψs hs
    have h2 : Commons.LinearAlgebra.Matrix.Cartan.sref i ν + alp i
        = Commons.LinearAlgebra.Matrix.Cartan.sref i (ν - alp i) := by
      rw [show ν - alp i = ν + (-1 : ℤ) • alp i from by rw [neg_one_smul]; abel,
        sref_add_smul_alp, neg_one_smul]
      abel
    rw [h2, hH_sref] at h1
    rw [hH_sref] at h1
    linarith
  have hno : ∀ ν, psi i ν = m → H ν ≠ 0 → ν i ≠ 0 ∧ ν i ≠ -1 := by
    intro ν hνψ hνH
    constructor
    · intro h0
      have h3 : Commons.LinearAlgebra.Matrix.Cartan.sref i ν = ν := by
        rw [sref_eq_sub, h0, zero_smul, sub_zero]
      have h4 := hH_sref ν
      rw [h3] at h4
      exact hνH (by linarith)
    · intro hm1
      have h3 : Commons.LinearAlgebra.Matrix.Cartan.sref i ν = ν + alp i := by
        rw [sref_eq_sub, hm1, neg_one_smul]
        abel
      have h4 := hH_sref ν
      rw [h3] at h4
      have h5 := hstep ν hνψ hνH
      rw [h5] at h4
      exact hνH (by linarith)
  have hplus : ∀ k : ℕ, H (ν₀ + (k : ℤ) • alp i) ≠ 0 := by
    intro k
    induction k with
    | zero => simpa using hν₀H
    | succ k ih =>
        have hψ : psi i (ν₀ + (k : ℤ) • alp i) = m := by
          rw [psi_add, hν₀ψ, psi_smul, psi_alp, if_pos rfl, mul_zero, add_zero]
        have h1 := hstep _ hψ ih
        have hcast : ((((k : ℕ) + 1 : ℕ) : ℤ)) = (k : ℤ) + 1 := by push_cast; ring
        have he : ν₀ + ((((k : ℕ) + 1 : ℕ) : ℤ)) • alp i = (ν₀ + (k : ℤ) • alp i) + alp i := by
          rw [hcast, add_smul, one_smul]; abel
        rw [he, h1]
        exact ih
  have hminus : ∀ k : ℕ, H (ν₀ - (k : ℤ) • alp i) ≠ 0 := by
    intro k
    induction k with
    | zero => simpa using hν₀H
    | succ k ih =>
        have hψ : psi i (ν₀ - (k : ℤ) • alp i) = m := by
          rw [psi_sub, hν₀ψ, psi_smul, psi_alp, if_pos rfl, mul_zero, sub_zero]
        have h1 := hstepm _ hψ ih
        have hcast : ((((k : ℕ) + 1 : ℕ) : ℤ)) = (k : ℤ) + 1 := by push_cast; ring
        have he : ν₀ - ((((k : ℕ) + 1 : ℕ) : ℤ)) • alp i = (ν₀ - (k : ℤ) • alp i) - alp i := by
          rw [hcast, add_smul, one_smul]; abel
        rw [he, h1]
        exact ih
  have hψplus : ∀ k : ℕ, psi i (ν₀ + (k : ℤ) • alp i) = m := by
    intro k
    rw [psi_add, hν₀ψ, psi_smul, psi_alp, if_pos rfl, mul_zero, add_zero]
  have hψminus : ∀ k : ℕ, psi i (ν₀ - (k : ℤ) • alp i) = m := by
    intro k
    rw [psi_sub, hν₀ψ, psi_smul, psi_alp, if_pos rfl, mul_zero, sub_zero]
  have hcoord : ∀ k : ℤ, (ν₀ + k • alp i) i = ν₀ i + 2 * k := by
    intro k
    simp only [Pi.add_apply, Pi.smul_apply, alp, smul_eq_mul,
      Commons.LinearAlgebra.Matrix.Cartan.E8m_diag]
    ring
  have hcoordm : ∀ k : ℤ, (ν₀ - k • alp i) i = ν₀ i - 2 * k := by
    intro k
    simp only [Pi.sub_apply, Pi.smul_apply, alp, smul_eq_mul,
      Commons.LinearAlgebra.Matrix.Cartan.E8m_diag]
    ring
  have harith : ∃ k : ℕ, (ν₀ i + 2 * (k : ℤ) = 0 ∨ ν₀ i + 2 * (k : ℤ) = -1)
      ∨ (ν₀ i - 2 * (k : ℤ) = 0 ∨ ν₀ i - 2 * (k : ℤ) = -1) := by
    obtain ⟨t, ht⟩ | ⟨t, ht⟩ := Int.even_or_odd (ν₀ i)
    · by_cases h : 0 ≤ t
      · refine ⟨t.toNat, Or.inr (Or.inl ?_)⟩
        have h1 : ((t.toNat : ℕ) : ℤ) = t := Int.toNat_of_nonneg h
        rw [h1, ht]; ring
      · refine ⟨(-t).toNat, Or.inl (Or.inl ?_)⟩
        have h1 : (((-t).toNat : ℕ) : ℤ) = -t := Int.toNat_of_nonneg (by omega)
        rw [h1, ht]; ring
    · by_cases h : -1 ≤ t
      · refine ⟨(t + 1).toNat, Or.inr (Or.inr ?_)⟩
        have h1 : (((t + 1).toNat : ℕ) : ℤ) = t + 1 := Int.toNat_of_nonneg (by omega)
        rw [h1, ht]; ring
      · refine ⟨(-(t + 1)).toNat, Or.inl (Or.inr ?_)⟩
        have h1 : (((-(t + 1)).toNat : ℕ) : ℤ) = -(t + 1) :=
          Int.toNat_of_nonneg (by omega)
        rw [h1, ht]; ring
  rcases harith with ⟨k, hk | hk⟩
  · have hnk := hno (ν₀ + (k : ℤ) • alp i) (hψplus k) (hplus k)
    rcases hk with hk | hk
    · exact hnk.1 (by rw [hcoord]; omega)
    · exact hnk.2 (by rw [hcoord]; omega)
  · have hnk := hno (ν₀ - (k : ℤ) • alp i) (hψminus k) (hminus k)
    rcases hk with hk | hk
    · exact hnk.1 (by rw [hcoordm]; omega)
    · exact hnk.2 (by rw [hcoordm]; omega)

/-- **Full `W`-invariance of `euler Λ`.** -/
theorem euler_ap (Λ : Fin 8 → ℤ) (hΛ : ∀ i, 0 ≤ Λ i) (M : Matrix (Fin 8) (Fin 8) ℤ)
    (hM : M ∈ WG) (μ : Fin 8 → ℤ) : euler Λ (ap M μ) = euler Λ μ := by
  obtain ⟨L, rfl⟩ := mem_WG.mp hM
  exact euler_wact_of_simple Λ (fun i ν => by
    rw [ap_srefMat]
    exact euler_sref Λ hΛ i ν) L μ

/-- Invariance of `euler Λ` under a fold of simple reflections. -/
theorem euler_foldl_sref (Λ : Fin 8 → ℤ) (hΛ : ∀ i, 0 ≤ Λ i) :
    ∀ (L : List (Fin 8)) (μ : Fin 8 → ℤ),
      euler Λ (L.foldl (fun w i => Commons.LinearAlgebra.Matrix.Cartan.sref i w) μ)
        = euler Λ μ := by
  intro L
  induction L with
  | nil => intro μ; rfl
  | cons i L ih =>
      intro μ
      rw [List.foldl_cons]
      exact (ih _).trans (euler_sref Λ hΛ i μ)

/-- **Invariance under the dominant conjugate.** -/
theorem euler_dc (Λ : Fin 8 → ℤ) (hΛ : ∀ i, 0 ≤ Λ i) (μ : Fin 8 → ℤ) :
    euler Λ (Submission.E8Character.dc μ) = euler Λ μ :=
  euler_foldl_sref Λ hΛ (Submission.E8Character.dcList μ) μ

end Submission.E8WCFW
