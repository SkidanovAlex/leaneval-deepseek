lemma pairList_mem : ∀ p : Fin 120 × Fin 4, p ∈ pairList := by decide

/-- The search order of `classify`: the dominant conjugates that occur most often come first. -/
def clOrd : List (Fin 40) :=
  [4, 3, 7, 13, 18, 14, 16, 26, 27, 0, 1, 33, 23, 5, 2, 6, 24, 12, 22, 17, 25, 15, 11, 32, 20, 31, 9, 19, 30, 35, 38, 29, 10, 21, 34, 36, 8, 28, 37, 39]

def findD (w : Fin 8 → ℤ) : List (Fin 40) → Option (Fin 40)
  | [] => none
  | e :: l => if eqv w (ord40v e) then some e else findD w l

lemma findD_sound : ∀ {l : List (Fin 40)} {w : Fin 8 → ℤ} {e : Fin 40},
    findD w l = some e → w = ord40get e := by
  intro l
  induction l with
  | nil => intro w e h; exact absurd h (by simp [findD])
  | cons a l ih =>
    intro w e h
    simp only [findD] at h
    split at h
    · rename_i hh
      rw [Option.some.injEq] at h
      subst h
      rw [← ord40v_eq a]
      exact eqv_eq_true hh
    · exact ih h

def classify (w : Fin 8 → ℤ) : Option (Fin 40) := findD w clOrd

lemma classify_sound {w : Fin 8 → ℤ} {e : Fin 40} (h : classify w = some e) :
    w = ord40get e := findD_sound h

/-- The index of the dominant conjugate of `v` in `ord40` (or `none`). -/
def domIdx (v : Fin 8 → ℤ) : Option (Fin 40) :=
  if E8Engine.qE v ≤ 40 then classify (Submission.DcFast.dcWE v) else none

lemma domIdx_sound {v : Fin 8 → ℤ} {e : Fin 40} (h : domIdx v = some e) :
    ord40get e = dcX v := by
  by_cases hq : E8Engine.qE v ≤ 40
  · rw [domIdx, if_pos hq] at h
    rw [← classify_sound h, Submission.DcFast.dcWE_eq]
  · rw [domIdx, if_neg hq] at h
    exact absurd h (by simp)

/-- The candidate multiplicity function of `L(ord40 i)`. -/
def Mnu (i : Fin 40) (v : Fin 8 → ℤ) : ℤ := (domIdx v).elim 0 (fun e => Mtab i e)

/-! ## The grouped c-table -/

/-- The terms whose dominant conjugate is `ord40 e`. -/
def stList (d e : Fin 40) : List (Fin 120 × Fin 4) :=
  pairList.filter (fun p => sidTab d p.1 p.2 == e.1)

lemma st_sid (d e : Fin 40) {p : Fin 120 × Fin 4} (h : p ∈ stList d e) :
    sidTab d p.1 p.2 = e.1 := by
  simp only [stList, List.mem_filter] at h
  exact beq_iff_eq.mp h.2

lemma st_nodup (d e : Fin 40) : (stList d e).Nodup :=
  List.Nodup.filter _ (by decide)

lemma st_mem (d : Fin 40) (j : Fin 120) (k : Fin 4) (h : sidTab d j k < 40) :
    (j, k) ∈ stList d ⟨sidTab d j k, h⟩ := by
  rw [stList, List.mem_filter]
  exact ⟨pairList_mem _, by simp [h]⟩

/-- The grouped c-table: the sum of the `brk` values of the terms whose dominant conjugate is
`ord40 e`. -/
def ctabN (d e : Fin 40) : ℤ :=
  (stList d e).toFinset.sum (fun p => brkTab d p.1 p.2)

end Submission.E8Cert
