import Submission.E8Extract
import Submission.E8Engine
import Submission.DcFast

/-!
# Certificate data for the c-table (SESSION 28)

For every term `(d : Fin 40, j : Fin 120, k : Fin 4)` the weight `eta = ord40 d + (k+1) * pR j` is
tabulated (with `t = j*4+k`):

* `sidTab d j k` -- the index in `ord40` of the dominant conjugate of `eta`, or `40` when the
  conjugate is not one of the forty (equivalently when `qZ eta > 40`);
* `brkTab d j k` -- `brk eta j = <eta, alpha_j^vee>`.

`domIdx v` is the index of the dominant conjugate of `v` in `ord40` (or `none`); `Mnu i` is the
candidate character of `L(ord40 i)`.  The certificates (`cert_sid`, `brk_eq`, `ctab_eq`) live in
the chunked modules `Submission.Cert.C<k>` because a single `decide` over all `19200` terms exceeds
the memory cap.
-/

set_option maxHeartbeats 0
set_option maxRecDepth 1000000
set_option linter.unusedVariables false

noncomputable section
namespace Submission.E8Cert

open Submission.E8Extract Submission.E8Orbit Submission.E8Character Submission.E8Casimir
open Submission.E8Enum Submission.E8Numerics Submission.E8Engine
open Submission.WeylReflect Submission.WeylWeights

/-! ## Fast componentwise comparison of weights -/

def eqv (w v : Fin 8 → ℤ) : Bool :=
  w 0 == v 0 && w 1 == v 1 && w 2 == v 2 && w 3 == v 3 &&
  w 4 == v 4 && w 5 == v 5 && w 6 == v 6 && w 7 == v 7

lemma eqv_eq_true {w v : Fin 8 → ℤ} (h : eqv w v = true) : w = v := by
  funext i
  fin_cases i <;>
    (simp only [eqv, Bool.and_eq_true, beq_iff_eq] at h
     first
      | exact h.1.1.1.1.1.1.1
      | exact h.1.1.1.1.1.1.2
      | exact h.1.1.1.1.1.2
      | exact h.1.1.1.1.2
      | exact h.1.1.1.2
      | exact h.1.1.2
      | exact h.1.2
      | exact h.2)

