/-!
# The weights of a module generated by a primitive vector

We prove that if a module `M` over the enveloping algebra `U(e₈)` is generated by a vector `z`
which is killed by the raising operators `ι (SerreE i)` and on which the Cartan generators
`ι (SerreH i)` act by integers `ν i`, then every element `x ≠ 0` which is a joint eigenvector of
the `ι (SerreH i)`, with eigenvalues `μ i`, has `ν - μ ∈ ℕΦ⁺`, i.e. all coordinates of `ν - μ`
in the basis of simple roots are non-negative.

The proof is the classical Poincaré–Birkhoff–Witt cone argument, carried out without any PBW
basis theorem: the triangular spanning of `U(e₈)` (every element is, modulo the left ideal
generated by the raising operators, a linear combination of products `(f-word)·(h-word)`) is
proved directly from the Serre commutation relations, and the weight argument uses only
`ℤ`-scalar manipulations (so that no compatibility between the `ℂ`-action and the
`U(e₈)`-action on `M` is needed beyond what is stated).
-/

/-- The enveloping algebra of the Serre-constructed `e₈`. -/
abbrev wspU : Type := UniversalEnvelopingAlgebra ℂ L8

/-- The image of the Cartan generator `Hᵢ` in `U(e₈)`. -/
abbrev wspH (i : Fin 8) : wspU := UniversalEnvelopingAlgebra.ι ℂ (SerreH i)

/-- The image of the raising generator `Eᵢ` in `U(e₈)`. -/
abbrev wspE (i : Fin 8) : wspU := UniversalEnvelopingAlgebra.ι ℂ (SerreE i)

/-- The image of the lowering generator `Fᵢ` in `U(e₈)`. -/
abbrev wspF (i : Fin 8) : wspU := UniversalEnvelopingAlgebra.ι ℂ (SerreF i)

/-- The product of the `wspF i` over a word. -/
def wspFmono (a : List (Fin 8)) : wspU := (a.map wspF).prod

/-- The product of the `wspH i` over a word. -/
def wspHmono (b : List (Fin 8)) : wspU := (b.map wspH).prod

@[simp] lemma wspFmono_nil : wspFmono ([] : List (Fin 8)) = 1 := by
  simp [wspFmono]

@[simp] lemma wspFmono_cons (i : Fin 8) (a : List (Fin 8)) :
    wspFmono (i :: a) = wspF i * wspFmono a := by
  simp [wspFmono]

@[simp] lemma wspHmono_nil : wspHmono ([] : List (Fin 8)) = 1 := by
  simp [wspHmono]

@[simp] lemma wspHmono_cons (i : Fin 8) (b : List (Fin 8)) :
    wspHmono (i :: b) = wspH i * wspHmono b := by
  simp [wspHmono]

/-! ## The Serre relations in `U(e₈)` -/

lemma wspH_lie_wspH (i j : Fin 8) : ⁅wspH i, wspH j⁆ = 0 := by
  have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ) (SerreH i) (SerreH j)
  rw [serreLie_HH, map_zero] at h
  exact h.symm

lemma wspH_lie_wspE (i j : Fin 8) : ⁅wspH i, wspE j⁆ = ((E8 i j : ℤ) : ℂ) • wspE j := by
  have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ) (SerreH i) (SerreE j)
  rw [serreLie_H_E, map_zsmul] at h
  rw [← h, Int.cast_smul_eq_zsmul]

lemma wspH_lie_wspF (i j : Fin 8) :
    ⁅wspH i, wspF j⁆ = (((-(E8 i j) : ℤ)) : ℂ) • wspF j := by
  have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ) (SerreH i) (SerreF j)
  rw [serreLie_H_F, map_zsmul] at h
  rw [← h, Int.cast_smul_eq_zsmul]

lemma wspE_lie_wspF (i j : Fin 8) : ⁅wspE i, wspF j⁆ = if i = j then wspH i else 0 := by
  have h := LieHom.map_lie (UniversalEnvelopingAlgebra.ι ℂ) (SerreE i) (SerreF j)
  rw [serreLie_E_F, apply_ite (UniversalEnvelopingAlgebra.ι ℂ), map_zero] at h
  exact h.symm

/-- `wspH i` commutes with a Cartan monomial. -/
lemma wspH_lie_wspHmono (i : Fin 8) (b : List (Fin 8)) :
    wspH i * wspHmono b = wspHmono b * wspH i := by
  induction b with
  | nil => simp
  | cons j b ih =>
      have hc : wspH i * wspH j = wspH j * wspH i := by
        rw [← sub_eq_zero, ← Ring.lie_def]
        exact wspH_lie_wspH i j
      rw [wspHmono_cons, ← mul_assoc, hc, mul_assoc, ih, ← mul_assoc]


/-! ## The weight of an `f`-word -/

/-- The sum of the simple roots `α j`, `j ∈ a`, in `ω`-coordinates. -/
def wspWsum (a : List (Fin 8)) : Fin 8 → ℤ := fun i => (a.map (fun j => E8 i j)).sum

@[simp] lemma wspWsum_nil : wspWsum ([] : List (Fin 8)) = 0 := by
  funext i; simp [wspWsum]

@[simp] lemma wspWsum_cons (i : Fin 8) (a : List (Fin 8)) :
    wspWsum (i :: a) = (fun k => E8 k i) + wspWsum a := by
  funext k; simp [wspWsum, Pi.add_apply]

/-- The sum of the simple roots as a sum of `alpha`s. -/
lemma wspWsum_eq_sum_alpha (a : List (Fin 8)) :
    wspWsum a = (a.map (fun j => alpha j)).sum := by
  induction a with
  | nil => simp
  | cons j a ih =>
      funext k
      rw [wspWsum_cons, ih, List.map_cons, List.sum_cons, Pi.add_apply, Pi.add_apply,
        alpha_apply, E8_symm k j]

/-- Each coordinate of `coords (wspWsum a)` is non-negative. -/
lemma wspWsum_nonneg (a : List (Fin 8)) (i : Fin 8) : 0 ≤ coords (wspWsum a) i := by
  have haux : ∀ (a : List (Fin 8)) (i : Fin 8), 0 ≤ coords ((a.map (fun j => alpha j)).sum) i := by
    intro a
    induction a with
    | nil => intro i; simp [coords]
    | cons j a ih =>
        intro i
        rw [List.map_cons, List.sum_cons, coords_add, coords_alpha, Pi.add_apply,
          Pi.single_apply]
        split
        · have := ih i; omega
        · simpa using ih i
  rw [wspWsum_eq_sum_alpha]
  exact haux a i

/-! ## Integer scalars inside `U(e₈)` -/

lemma wsp_zsmul_mul (n : ℤ) (x y : wspU) : (n • x) * y = n • (x * y) := by
  rw [← Int.cast_smul_eq_zsmul ℂ n x, ← Int.cast_smul_eq_zsmul ℂ n (x * y), smul_mul_assoc]

lemma wsp_mul_zsmul (n : ℤ) (x y : wspU) : x * (n • y) = n • (x * y) := by
  rw [← Int.cast_smul_eq_zsmul ℂ n y, ← Int.cast_smul_eq_zsmul ℂ n (x * y), mul_smul_comm]

/-! ## The action of `wspH i` on `f`-monomials -/

lemma wspH_mul_wspF (i j : Fin 8) :
    wspH i * wspF j = wspF j * wspH i - (E8 i j) • wspF j := by
  have h : wspH i * wspF j - wspF j * wspH i = (-(E8 i j)) • wspF j := by
    rw [← Ring.lie_def, wspH_lie_wspF, Int.cast_smul_eq_zsmul]
  calc wspH i * wspF j = wspF j * wspH i + (wspH i * wspF j - wspF j * wspH i) := by abel
    _ = wspF j * wspH i + (-(E8 i j)) • wspF j := by rw [h]
    _ = wspF j * wspH i - (E8 i j) • wspF j := by rw [neg_zsmul, sub_eq_add_neg]

lemma wspH_mul_wspFmono (i : Fin 8) (a : List (Fin 8)) :
    wspH i * wspFmono a = wspFmono a * wspH i - (wspWsum a i) • wspFmono a := by
  induction a with
  | nil => simp
  | cons j a ih =>
      calc wspH i * wspFmono (j :: a)
          = (wspH i * wspF j) * wspFmono a := by rw [wspFmono_cons, mul_assoc]
        _ = (wspF j * wspH i - (E8 i j) • wspF j) * wspFmono a := by rw [wspH_mul_wspF]
        _ = wspF j * (wspH i * wspFmono a) - (E8 i j) • (wspF j * wspFmono a) := by
              rw [sub_mul, mul_assoc, wsp_zsmul_mul]
        _ = wspF j * (wspFmono a * wspH i - (wspWsum a i) • wspFmono a)
              - (E8 i j) • (wspF j * wspFmono a) := by rw [ih]
        _ = wspFmono (j :: a) * wspH i - (wspWsum (j :: a) i) • wspFmono (j :: a) := by
              rw [mul_sub, wsp_mul_zsmul, ← mul_assoc, ← wspFmono_cons, wspWsum_cons,
                Pi.add_apply, sub_sub, ← add_zsmul, add_comm (wspWsum a i) (E8 i j)]

/-! ## Weight vectors in `U(e₈)` -/

/-- `u` is a weight vector of weight `w` for the adjoint action of the Cartan generators. -/
def wspWeight (w : Fin 8 → ℤ) (u : wspU) : Prop :=
  ∀ i, wspH i * u - u * wspH i = (w i) • u

lemma wspWeight_zero (w : Fin 8 → ℤ) : wspWeight w (0 : wspU) := by
  intro i; simp

lemma wspWeight.add {w : Fin 8 → ℤ} {u u' : wspU} (hu : wspWeight w u)
    (hu' : wspWeight w u') : wspWeight w (u + u') := by
  intro i
  have hsplit : wspH i * (u + u') - (u + u') * wspH i
      = (wspH i * u - u * wspH i) + (wspH i * u' - u' * wspH i) := by
    rw [mul_add, add_mul]; abel
  rw [hsplit, hu i, hu' i, ← zsmul_add]

lemma wspWeight.smul (c : ℂ) {w : Fin 8 → ℤ} {u : wspU} (hu : wspWeight w u) :
    wspWeight w (c • u) := by
  intro i
  calc wspH i * (c • u) - (c • u) * wspH i
      = c • (wspH i * u) - c • (u * wspH i) := by rw [smul_mul_assoc, mul_smul_comm]
    _ = c • (wspH i * u - u * wspH i) := by rw [smul_sub]
    _ = c • ((w i) • u) := by rw [hu i]
    _ = ((w i) : ℂ) • (c • u) := by rw [Int.cast_smul_eq_zsmul, smul_comm]
    _ = (w i) • (c • u) := by rw [Int.cast_smul_eq_zsmul]

lemma wspWeight.mul {w w' : Fin 8 → ℤ} {u u' : wspU} (hu : wspWeight w u)
    (hu' : wspWeight w' u') : wspWeight (w + w') (u * u') := by
  intro i
  have hsplit : wspH i * (u * u') - (u * u') * wspH i
      = (wspH i * u - u * wspH i) * u' + u * (wspH i * u' - u' * wspH i) := by
    noncomm_ring
  rw [hsplit, hu i, hu' i, wsp_zsmul_mul, wsp_mul_zsmul, Pi.add_apply, ← add_zsmul]

lemma wspWeight_wspFmono (a : List (Fin 8)) : wspWeight (-(wspWsum a)) (wspFmono a) := by
  intro i
  rw [Pi.neg_apply, wspH_mul_wspFmono, neg_zsmul]
  abel

lemma wspWeight_wspHmono (b : List (Fin 8)) : wspWeight 0 (wspHmono b) := by
  intro i
  rw [wspH_lie_wspHmono i b, sub_self, Pi.zero_apply, zero_zsmul]

lemma wspWeight_wspFHmono (a b : List (Fin 8)) :
    wspWeight (-(wspWsum a)) (wspFmono a * wspHmono b) := by
  have h := (wspWeight_wspFmono a).mul (wspWeight_wspHmono b)
  simpa using h

/-! ## The `ℤ`-scalar action on a module over `U(e₈)` -/

/-- Left multiplication on a module over `U(e₈)` as an additive map. -/
def wspSmulAddHom {M : Type*} [AddCommGroup M] [Module wspU M] (u : wspU) : M →+ M where
  toFun m := u • m
  map_zero' := smul_zero u
  map_add' a b := smul_add u a b

/-- Left multiplication on a module over `U(e₈)` as an additive map in `u`. -/
def wspSmulAddHomHom {M : Type*} [AddCommGroup M] [Module wspU M] : wspU →+ (M →+ M) where
  toFun := wspSmulAddHom
  map_zero' := by ext m; simp [wspSmulAddHom]
  map_add' u u' := by ext m; simp [wspSmulAddHom, add_smul]

@[simp] lemma wspSmulAddHom_apply {M : Type*} [AddCommGroup M] [Module wspU M]
    (u : wspU) (m : M) : wspSmulAddHom (M := M) u m = u • m := rfl

lemma wsp_smul_zsmul {M : Type*} [AddCommGroup M] [Module wspU M] (u : wspU) (n : ℤ) (m : M) :
    u • (n • m) = n • (u • m) := by
  simpa using map_zsmul (wspSmulAddHom (M := M) u) n m

lemma wsp_zsmul_smul {M : Type*} [AddCommGroup M] [Module wspU M] (n : ℤ) (u : wspU) (m : M) :
    (n • u) • m = n • (u • m) := by
  have h := congrArg (fun (g : M →+ M) => g m) (map_zsmul (wspSmulAddHomHom (M := M)) n u)
  simpa [wspSmulAddHomHom, wspSmulAddHom, AddMonoidHom.zsmul_apply] using h

/-- The action of a weight vector of `U(e₈)` on a highest-weight-type vector. -/
lemma wsp_eigen_smul {M : Type*} [AddCommGroup M] [Module ℂ M] [Module wspU M]
    {z : M} {ν : Fin 8 → ℤ} (hH : ∀ i, wspH i • z = (ν i) • z)
    {u : wspU} {w : Fin 8 → ℤ} (hu : wspWeight w u) (i : Fin 8) :
    wspH i • (u • z) = (ν i + w i) • (u • z) := by
  have h1 : wspH i * u = u * wspH i + (w i) • u := sub_eq_iff_eq_add'.mp (hu i)
  calc wspH i • (u • z) = (wspH i * u) • z := (mul_smul _ _ _).symm
    _ = (u * wspH i + (w i) • u) • z := by rw [h1]
    _ = (u * wspH i) • z + ((w i) • u) • z := by rw [add_smul]
    _ = u • (wspH i • z) + (w i) • (u • z) := by rw [mul_smul, wsp_zsmul_smul]
    _ = u • ((ν i) • z) + (w i) • (u • z) := by rw [hH i]
    _ = (ν i) • (u • z) + (w i) • (u • z) := by rw [wsp_smul_zsmul]
    _ = (ν i + w i) • (u • z) := by rw [← add_zsmul]

/-! ## The triangular spanning of `U(e₈)` -/

/-- The span of the products `(f-word)·(h-word)`: the "cone part" of `U(e₈)`. -/
def wspCone : Submodule ℂ wspU :=
  Submodule.span ℂ {u : wspU | ∃ a b : List (Fin 8), u = wspFmono a * wspHmono b}

/-- The left ideal generated by the raising operators `wspE i`. -/
def wspRaising : Submodule ℂ wspU :=
  Submodule.span ℂ {u : wspU | ∃ (v : wspU) (i : Fin 8), u = v * wspE i}

lemma wspFmono_append (a a' : List (Fin 8)) : wspFmono (a ++ a') = wspFmono a * wspFmono a' := by
  simp [wspFmono, List.map_append, List.prod_append]

lemma wspHmono_append (b b' : List (Fin 8)) : wspHmono (b ++ b') = wspHmono b * wspHmono b' := by
  simp [wspHmono, List.map_append, List.prod_append]

lemma wspE_lie_wspH (i j : Fin 8) : ⁅wspE i, wspH j⁆ = (((-(E8 i j) : ℤ)) : ℂ) • wspE i := by
  rw [← lie_skew (wspE i) (wspH j), wspH_lie_wspE, E8_symm j i, Int.cast_neg, neg_smul]

lemma wspE_mul_wspH (i j : Fin 8) : wspE i * wspH j = wspH j * wspE i - (E8 i j) • wspE i := by
  have h : wspE i * wspH j - wspH j * wspE i = (-(E8 i j)) • wspE i := by
    rw [← Ring.lie_def, wspE_lie_wspH, Int.cast_smul_eq_zsmul]
  calc wspE i * wspH j = wspH j * wspE i + (wspE i * wspH j - wspH j * wspE i) := by abel
    _ = wspH j * wspE i + (-(E8 i j)) • wspE i := by rw [h]
    _ = wspH j * wspE i - (E8 i j) • wspE i := by rw [neg_zsmul, sub_eq_add_neg]

lemma wspE_mul_wspF (i j : Fin 8) :
    wspE i * wspF j = wspF j * wspE i + (if i = j then wspH i else 0) := by
  have h : wspE i * wspF j - wspF j * wspE i = (if i = j then wspH i else 0) := by
    rw [← Ring.lie_def]; exact wspE_lie_wspF i j
  rw [sub_eq_iff_eq_add'] at h
  exact h

/-! ### Closure properties -/

lemma wsp_mem_sup_left {u : wspU} (hu : u ∈ wspCone) : u ∈ wspCone ⊔ wspRaising :=
  (le_sup_left : wspCone ≤ wspCone ⊔ wspRaising) hu

lemma wsp_mem_sup_right {u : wspU} (hu : u ∈ wspRaising) : u ∈ wspCone ⊔ wspRaising :=
  (le_sup_right : wspRaising ≤ wspCone ⊔ wspRaising) hu

lemma wspRaising_mul_left (v : wspU) {u : wspU} (hu : u ∈ wspRaising) : v * u ∈ wspRaising := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨v', i, rfl⟩ := hu
      exact Submodule.subset_span ⟨v * v', i, by rw [mul_assoc]⟩
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha

lemma wspE_mem_wspRaising (i : Fin 8) : wspE i ∈ wspRaising :=
  Submodule.subset_span ⟨1, i, by simp⟩

lemma wspE_mul_wspHmono (i : Fin 8) (b : List (Fin 8)) : wspE i * wspHmono b ∈ wspRaising := by
  induction b with
  | nil => simpa using wspE_mem_wspRaising i
  | cons j b ih =>
      rw [wspHmono_cons, ← mul_assoc, wspE_mul_wspH, sub_mul, wsp_zsmul_mul]
      refine Submodule.sub_mem _ ?_ (Submodule.smul_mem _ _ ih)
      rw [mul_assoc]
      exact wspRaising_mul_left (wspH j) ih

lemma wspRaising_mul_wspHmono (b : List (Fin 8)) {u : wspU} (hu : u ∈ wspRaising) :
    u * wspHmono b ∈ wspRaising := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨v, i, rfl⟩ := hu
      rw [mul_assoc]
      exact wspRaising_mul_left v (wspE_mul_wspHmono i b)
  | zero => simp
  | add a b' _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ ha

lemma wspCone_mul_wspF (i : Fin 8) {u : wspU} (hu : u ∈ wspCone) : wspF i * u ∈ wspCone := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨a, b, rfl⟩ := hu
      exact Submodule.subset_span ⟨i :: a, b, by rw [wspFmono_cons, mul_assoc]⟩
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha

lemma wspCone_mul_wspH (i : Fin 8) {u : wspU} (hu : u ∈ wspCone) : wspH i * u ∈ wspCone := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨a, b, rfl⟩ := hu
      rw [← mul_assoc, wspH_mul_wspFmono, sub_mul, mul_assoc, wsp_zsmul_mul]
      refine Submodule.sub_mem _ ?_
        (Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, b, by simp⟩))
      exact Submodule.subset_span ⟨a, i :: b, by rw [wspHmono_cons]⟩
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha

lemma wspCone_mul_wspHmono (b : List (Fin 8)) {u : wspU} (hu : u ∈ wspCone) :
    u * wspHmono b ∈ wspCone := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨a, b', rfl⟩ := hu
      rw [mul_assoc]
      exact Submodule.subset_span ⟨a, b' ++ b, by rw [wspHmono_append]⟩
  | zero => simp
  | add a b' _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ ha

lemma wsp_sup_mul_wspF (i : Fin 8) {u : wspU} (hu : u ∈ wspCone ⊔ wspRaising) :
    wspF i * u ∈ wspCone ⊔ wspRaising := by
  rcases Submodule.mem_sup.mp hu with ⟨a, ha, b, hb, rfl⟩
  rw [mul_add]
  exact Submodule.add_mem _ (wsp_mem_sup_left (wspCone_mul_wspF i ha))
    (wsp_mem_sup_right (wspRaising_mul_left (wspF i) hb))

lemma wsp_sup_mul_wspH (i : Fin 8) {u : wspU} (hu : u ∈ wspCone ⊔ wspRaising) :
    wspH i * u ∈ wspCone ⊔ wspRaising := by
  rcases Submodule.mem_sup.mp hu with ⟨a, ha, b, hb, rfl⟩
  rw [mul_add]
  exact Submodule.add_mem _ (wsp_mem_sup_left (wspCone_mul_wspH i ha))
    (wsp_mem_sup_right (wspRaising_mul_left (wspH i) hb))

lemma wsp_sup_mul_wspHmono (b : List (Fin 8)) {u : wspU} (hu : u ∈ wspCone ⊔ wspRaising) :
    u * wspHmono b ∈ wspCone ⊔ wspRaising := by
  rcases Submodule.mem_sup.mp hu with ⟨a, ha, b', hb, rfl⟩
  rw [add_mul]
  exact Submodule.add_mem _ (wsp_mem_sup_left (wspCone_mul_wspHmono b ha))
    (wsp_mem_sup_right (wspRaising_mul_wspHmono b hb))

lemma wspE_mul_wspFmono (i : Fin 8) (a : List (Fin 8)) :
    wspE i * wspFmono a ∈ wspCone ⊔ wspRaising := by
  induction a with
  | nil => simpa using wsp_mem_sup_right (wspE_mem_wspRaising i)
  | cons j a ih =>
      rw [wspFmono_cons, ← mul_assoc, wspE_mul_wspF, add_mul, ite_mul, zero_mul]
      refine Submodule.add_mem _ ?_ ?_
      · rw [mul_assoc]
        exact wsp_sup_mul_wspF j ih
      · by_cases hij : i = j
        · rw [if_pos hij]
          exact wsp_mem_sup_left (wspCone_mul_wspH i (Submodule.subset_span ⟨a, [], by simp⟩))
        · rw [if_neg hij]
          exact Submodule.zero_mem _

lemma wspCone_mul_wspE (i : Fin 8) {u : wspU} (hu : u ∈ wspCone) :
    wspE i * u ∈ wspCone ⊔ wspRaising := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨a, b, rfl⟩ := hu
      rw [← mul_assoc]
      exact wsp_sup_mul_wspHmono b (wspE_mul_wspFmono i a)
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul c a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha

lemma wsp_sup_mul_wspE (i : Fin 8) {u : wspU} (hu : u ∈ wspCone ⊔ wspRaising) :
    wspE i * u ∈ wspCone ⊔ wspRaising := by
  rcases Submodule.mem_sup.mp hu with ⟨a, ha, b, hb, rfl⟩
  rw [mul_add]
  exact Submodule.add_mem _ (wspCone_mul_wspE i ha)
    (wsp_mem_sup_right (wspRaising_mul_left (wspE i) hb))

/-! ### Every element of `U(e₈)` lies in the cone part plus the raising ideal -/

/-- The subalgebra of elements multiplying `wspCone ⊔ wspRaising` into itself. -/
def wspT : Subalgebra ℂ wspU where
  carrier := {u : wspU | ∀ v ∈ wspCone ⊔ wspRaising, u * v ∈ wspCone ⊔ wspRaising}
  one_mem' := by intro v hv; simpa using hv
  mul_mem' := by intro a b ha hb v hv; rw [mul_assoc]; exact ha _ (hb v hv)
  add_mem' := by
    intro a b ha hb v hv
    rw [add_mul]; exact Submodule.add_mem _ (ha v hv) (hb v hv)
  zero_mem' := by intro v hv; rw [zero_mul]; exact Submodule.zero_mem _
  algebraMap_mem' := by
    intro c v hv
    rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
    exact Submodule.smul_mem _ _ hv

lemma wsp_iota_mem_wspT (x : L8) : UniversalEnvelopingAlgebra.ι ℂ x ∈ wspT := by
  let N : LieSubalgebra ℂ L8 :=
    { carrier := {x : L8 | UniversalEnvelopingAlgebra.ι ℂ x ∈ wspT}
      add_mem' := by
        intro x y hx hy
        change UniversalEnvelopingAlgebra.ι ℂ (x + y) ∈ wspT
        rw [map_add]; exact wspT.add_mem hx hy
      zero_mem' := by
        change UniversalEnvelopingAlgebra.ι ℂ (0 : L8) ∈ wspT
        rw [map_zero]; exact wspT.zero_mem
      smul_mem' := by
        intro c x hx
        change UniversalEnvelopingAlgebra.ι ℂ (c • x) ∈ wspT
        rw [map_smul]; exact wspT.smul_mem hx c
      lie_mem' := by
        intro x y hx hy
        change UniversalEnvelopingAlgebra.ι ℂ ⁅x, y⁆ ∈ wspT
        rw [LieHom.map_lie, Ring.lie_def]
        exact wspT.sub_mem (wspT.mul_mem hx hy) (wspT.mul_mem hy hx) }
  have htop : N = ⊤ := by
    refine Commons.Algebra.Lie.SerreConstruction.eq_top_of_lieSubalgebra_of_generators
      CartanMatrix.E₈ N ?_
    intro g
    cases g with
    | H i =>
        exact show UniversalEnvelopingAlgebra.ι ℂ (SerreH i) ∈ wspT from
          fun v hv => wsp_sup_mul_wspH i hv
    | E i =>
        exact show UniversalEnvelopingAlgebra.ι ℂ (SerreE i) ∈ wspT from
          fun v hv => wsp_sup_mul_wspE i hv
    | F i =>
        exact show UniversalEnvelopingAlgebra.ι ℂ (SerreF i) ∈ wspT from
          fun v hv => wsp_sup_mul_wspF i hv
  have : x ∈ N := by rw [htop]; trivial
  exact this

lemma wspT_eq_top : wspT = ⊤ := by
  have hle : Algebra.adjoin ℂ
      (Set.range (fun x : L8 => UniversalEnvelopingAlgebra.ι ℂ x)) ≤ wspT :=
    Algebra.adjoin_le_iff.mpr (by rintro _ ⟨x, rfl⟩; exact wsp_iota_mem_wspT x)
  refine le_antisymm le_top ?_
  intro u _
  have hu : u ∈ Algebra.adjoin ℂ
      (Set.range (fun x : L8 => UniversalEnvelopingAlgebra.ι ℂ x)) := by
    rw [Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota]; trivial
  exact hle hu

lemma wspCone_sup_wspRaising_eq_top : wspCone ⊔ wspRaising = ⊤ := by
  refine le_antisymm le_top ?_
  intro u _
  have hu : u ∈ wspT := by rw [wspT_eq_top]; trivial
  have h1 : u * 1 ∈ wspCone ⊔ wspRaising :=
    hu 1 (wsp_mem_sup_left (Submodule.subset_span ⟨[], [], by simp⟩))
  simpa using h1

/-- **Decomposition of an element of the cone part into weight vectors.** -/
lemma wspCone_decomp (u : wspU) (hu : u ∈ wspCone) :
    ∃ (s : Finset (Fin 8 → ℤ)) (g : (Fin 8 → ℤ) → wspU),
      (∀ w, wspWeight w (g w)) ∧
      (∀ w, w ∉ s → g w = 0) ∧
      (∀ w ∈ s, ∃ a : List (Fin 8), w = -(wspWsum a)) ∧
      u = ∑ w ∈ s, g w := by
  induction hu using Submodule.span_induction with
  | mem u hu =>
      obtain ⟨a, b, rfl⟩ := hu
      refine ⟨{-(wspWsum a)},
        fun w => if w = -(wspWsum a) then wspFmono a * wspHmono b else 0, ?_, ?_, ?_, ?_⟩
      · intro w
        dsimp only
        by_cases hw : w = -(wspWsum a)
        · rw [if_pos hw, hw]; exact wspWeight_wspFHmono a b
        · rw [if_neg hw]; exact wspWeight_zero w
      · intro w hw
        exact if_neg (by simpa using hw)
      · intro w hw
        rw [Finset.mem_singleton] at hw
        exact ⟨a, hw⟩
      · rw [Finset.sum_singleton, if_pos rfl]
  | zero => exact ⟨∅, fun _ => 0, fun w => wspWeight_zero w, by simp, by simp, by simp⟩
  | add x y _ _ ihx ihy =>
      obtain ⟨s₁, g₁, hw₁, hz₁, ha₁, hsum₁⟩ := ihx
      obtain ⟨s₂, g₂, hw₂, hz₂, ha₂, hsum₂⟩ := ihy
      refine ⟨s₁ ∪ s₂, fun w => g₁ w + g₂ w, fun w => (hw₁ w).add (hw₂ w), ?_, ?_, ?_⟩
      · intro w hw
        dsimp only
        rw [hz₁ w (fun h => hw (Finset.mem_union_left _ h)),
          hz₂ w (fun h => hw (Finset.mem_union_right _ h)), add_zero]
      · intro w hw
        rcases Finset.mem_union.mp hw with hw1 | hw2
        · exact ha₁ w hw1
        · exact ha₂ w hw2
      · calc x + y = (∑ w ∈ s₁, g₁ w) + (∑ w ∈ s₂, g₂ w) := by rw [hsum₁, hsum₂]
          _ = (∑ w ∈ s₁ ∪ s₂, g₁ w) + (∑ w ∈ s₁ ∪ s₂, g₂ w) := by
                rw [Finset.sum_subset Finset.subset_union_left (fun w _ hw => hz₁ w hw),
                  Finset.sum_subset Finset.subset_union_right (fun w _ hw => hz₂ w hw)]
          _ = ∑ w ∈ s₁ ∪ s₂, (g₁ w + g₂ w) := by rw [Finset.sum_add_distrib]
  | smul c x _ ihx =>
      obtain ⟨s, g, hw, hz, ha, hsum⟩ := ihx
      refine ⟨s, fun w => c • g w, fun w => (hw w).smul c, ?_, ha, ?_⟩
      · intro w hw; dsimp only; rw [hz w hw, smul_zero]
      · rw [hsum, Finset.smul_sum]

/-- The weights of a module generated by a primitive vector lie in the cone below that weight.
`M` is generated over `U(e₈)` by a vector `z` killed by all raising operators `SerreE i` and on
which the Cartan generators `SerreH i` act by the integers `ν i`; then every weight `μ` of `M`
satisfies `ν - μ ∈ ℕΦ⁺`, i.e. all `A⁻¹(ν-μ)`-coordinates are non-negative. -/
theorem weight_support_of_primitive {M : Type*} [AddCommGroup M] [Module ℂ M]
    [LieRingModule Commons.Algebra.Lie.SerreConstruction.L8 M]
    [LieModule ℂ Commons.Algebra.Lie.SerreConstruction.L8 M]
    [Module (UniversalEnvelopingAlgebra ℂ Commons.Algebra.Lie.SerreConstruction.L8) M]
    (z : M) (ν : Fin 8 → ℤ)
    (hz : ∀ m : M,
      ∃ u : UniversalEnvelopingAlgebra ℂ Commons.Algebra.Lie.SerreConstruction.L8, u • z = m)
    (hE : ∀ i, UniversalEnvelopingAlgebra.ι ℂ (Commons.Algebra.Lie.SerreConstruction.SerreE i) • z = 0)
    (hH : ∀ i, UniversalEnvelopingAlgebra.ι ℂ (Commons.Algebra.Lie.SerreConstruction.SerreH i) • z
      = ((ν i : ℤ) : ℂ) • z)
    {μ : Fin 8 → ℤ} {x : M} (hx : x ≠ 0)
    (hxw : ∀ i, UniversalEnvelopingAlgebra.ι ℂ (Commons.Algebra.Lie.SerreConstruction.SerreH i) • x
      = ((μ i : ℤ) : ℂ) • x) :
    ∀ i : Fin 8, 0 ≤ Commons.LinearAlgebra.Matrix.Cartan.coords (ν - μ) i := by
  classical
  have hHz : ∀ i, wspH i • z = (ν i) • z :=
    fun i => (hH i).trans (Int.cast_smul_eq_zsmul ℂ (ν i) z)
  have hxw' : ∀ i, wspH i • x = (μ i) • x :=
    fun i => (hxw i).trans (Int.cast_smul_eq_zsmul ℂ (μ i) x)
  let ev : wspU →+ M :=
    { toFun := fun u => u • z, map_zero' := zero_smul _ _, map_add' := fun a b => add_smul a b z }
  obtain ⟨u, hu⟩ := hz x
  have huK : u ∈ wspCone ⊔ wspRaising := by rw [wspCone_sup_wspRaising_eq_top]; trivial
  obtain ⟨p, hp, r, hr, hpr⟩ := Submodule.mem_sup.mp huK
  have hAnn : ∀ v ∈ wspRaising, v • z = 0 := by
    intro v hv
    induction hv using Submodule.span_induction with
    | mem v hv =>
        obtain ⟨v', i, rfl⟩ := hv
        rw [mul_smul, hE i, smul_zero]
    | zero => simp
    | add a b _ _ ha hb => rw [add_smul, ha, hb, add_zero]
    | smul c a _ ha => rw [Algebra.smul_def, mul_smul, ha, smul_zero]
  have hx_eq : x = p • z := by
    rw [← hu, ← hpr, add_smul, hAnn r hr, add_zero]
  obtain ⟨s, g, hwt, hzero, hineq, hsum⟩ := wspCone_decomp p hp
  have hxsum : x = ∑ w ∈ s, (g w • z) := by
    rw [hx_eq, hsum]
    exact map_sum ev g s
  -- the weight vectors of the decomposition are joint eigenvectors of distinct weights
  have hrel : ∀ i, (∑ j : {w // w ∈ s}, (ν i + j.1 i - μ i) • (g j.1 • z)) = 0 := by
    intro i
    have hL : wspH i • x = ∑ w ∈ s, (ν i + w i) • (g w • z) := by
      have h1 : wspH i • (∑ w ∈ s, (g w • z))
          = ∑ w ∈ s, wspH i • (g w • z) :=
        map_sum (wspSmulAddHom (M := M) (wspH i)) (fun w => g w • z) s
      rw [hxsum, h1]
      exact Finset.sum_congr rfl (fun w _ => wsp_eigen_smul hHz (hwt w) i)
    have hR : (μ i) • x = ∑ w ∈ s, (μ i) • (g w • z) := by
      rw [hxsum, Finset.smul_sum]
    have hsum0 : (∑ w ∈ s, ((ν i + w i) - μ i) • (g w • z)) = 0 := by
      have h0 : wspH i • x - (μ i) • x = 0 := by rw [hxw', sub_self]
      have h2 : (∑ w ∈ s, ((ν i + w i) - μ i) • (g w • z)) = wspH i • x - (μ i) • x := by
        rw [hL, hR, ← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl (fun w _ => by rw [sub_zsmul, sub_eq_add_neg])
      rw [h2, h0]
    rw [← Finset.sum_attach s (fun w => ((ν i + w i) - μ i) • (g w • z))] at hsum0
    simpa using hsum0
  have hsep : Function.Injective (fun j : {w // w ∈ s} => fun i => ν i + j.1 i) := by
    intro j j' h
    refine Subtype.ext (funext fun i => ?_)
    have h2 : ν i + j.1 i = ν i + j'.1 i := by
      have := congrFun h i
      simpa using this
    omega
  have hkey : ∀ j : {w // w ∈ s}, ∀ i, (ν i + j.1 i - μ i) • (g j.1 • z) = 0 :=
    Commons.LinearAlgebra.Eigenspace.jointEigen_zsmul_independent
      (fun i => wspSmulAddHom (M := M) (wspH i))
      (fun j : {w // w ∈ s} => g j.1 • z)
      (fun j i => ν i + j.1 i)
      (fun j i => ν i + j.1 i - μ i)
      (fun j i => wsp_eigen_smul hHz (hwt j.1) i)
      hsep
      hrel
  have hj₀ : ∃ j : {w // w ∈ s}, g j.1 • z ≠ 0 := by
    by_contra h
    push Not at h
    have hx0 : x = 0 := by
      rw [hxsum]
      exact Finset.sum_eq_zero (fun w hw => h ⟨w, hw⟩)
    exact hx hx0
  obtain ⟨j₀, hj₀⟩ := hj₀
  obtain ⟨a, ha⟩ := hineq j₀.1 j₀.2
  have hcoef : ∀ i, ν i + j₀.1 i - μ i = 0 := by
    intro i
    have h1 : (((ν i + j₀.1 i - μ i) : ℤ) : ℂ) • (g j₀.1 • z) = 0 := by
      rw [Int.cast_smul_eq_zsmul]
      exact hkey j₀ i
    rcases smul_eq_zero.mp h1 with h2 | h2
    · exact (Int.cast_eq_zero.mp h2)
    · exact absurd h2 hj₀
  have hvec : ν - μ = wspWsum a := by
    funext i
    have h1 := hcoef i
    rw [ha] at h1
    simp only [Pi.sub_apply, Pi.neg_apply] at h1 ⊢
    omega
  intro i
  rw [hvec]
  exact wspWsum_nonneg a i
end

