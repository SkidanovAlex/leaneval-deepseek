import Mathlib
import Submission.Commons.Algebra.Lie.FreeLieAlgebra.lieSpan_range_of
import Submission.Commons.Algebra.Lie.SerreConstruction.lieSpan_range_generators

namespace Commons.Algebra.Lie.SerreConstruction

/-!
# A triangular decomposition spanning statement for the Serre construction

This file proves that the free Lie algebra on the Serre generators `{H i, E i, F i}` is spanned,
as a module, by the `H`-generated subalgebra, the `E`-generated subalgebra, the `F`-generated
subalgebra, and the Lie ideal generated by all the Serre relations except the `ad F` family.
-/

section Generic

variable {R : Type*} [CommRing R]
variable {L : Type*} [LieRing L] [LieAlgebra R L]

/-- For a Lie ideal `I` and `x ∈ I`, the bracket `⁅x, y⁆` lies in `I` for every `y`. -/
theorem lieIdeal_lie_mem_left {I : LieIdeal R L} {x : L} (hx : x ∈ I) (y : L) : ⁅x, y⁆ ∈ I := by
  rw [← lie_skew]
  exact I.neg_mem (I.lie_mem (x := y) hx)

/-- **Subalgebra trick, first form.** If `W` is a bracket-closed submodule containing a Lie
subalgebra `S` generated by `s`, and `⁅x, p⁆ ∈ W` for every generator `p ∈ s`, then
`⁅x, y⁆ ∈ W` for all `y ∈ S`. -/
theorem lie_mem_of_lieSpan_of {s : Set L} {W : Submodule R L} {x : L}
    (hW : ∀ ⦃a b : L⦄, a ∈ W → b ∈ W → ⁅a, b⁆ ∈ W)
    (hSW : (LieSubalgebra.lieSpan R L s : Submodule R L) ≤ W)
    (hgen : ∀ p ∈ s, ⁅x, p⁆ ∈ W) :
    ∀ y ∈ LieSubalgebra.lieSpan R L s, ⁅x, y⁆ ∈ W := by
  let S : LieSubalgebra R L := LieSubalgebra.lieSpan R L s
  let Asub : Submodule R L :=
    { carrier := {y | y ∈ S ∧ ⁅x, y⁆ ∈ W}
      zero_mem' := ⟨S.zero_mem, by rw [lie_zero]; exact W.zero_mem⟩
      add_mem' := fun hy hz => ⟨S.add_mem hy.1 hz.1, by rw [lie_add]; exact W.add_mem hy.2 hz.2⟩
      smul_mem' := fun c y hy => ⟨S.smul_mem c hy.1, by rw [lie_smul]; exact W.smul_mem c hy.2⟩ }
  let A : LieSubalgebra R L :=
    { Asub with lie_mem' := fun hy hz =>
        ⟨S.lie_mem hy.1 hz.1, by
          rw [leibniz_lie]
          exact W.add_mem (hW hy.2 (hSW hz.1)) (hW (hSW hy.1) hz.2)⟩ }
  have hle : S ≤ A :=
    LieSubalgebra.lieSpan_le.mpr fun p hp => ⟨LieSubalgebra.subset_lieSpan hp, hgen p hp⟩
  intro y hy
  exact (hle hy).2

/-- **Subalgebra trick, second form.** Lifting a statement known on a generating set to the whole
Lie subalgebra that it generates. -/
theorem lie_mem_of_mem_lieSpan_of_mem {s : Set L} {T : LieSubalgebra R L} {W : Submodule R L}
    (hkey : ∀ y ∈ LieSubalgebra.lieSpan R L s, (∀ t ∈ T, ⁅y, t⁆ ∈ W) → ∀ w ∈ W, ⁅y, w⁆ ∈ W)
    (hgen : ∀ p ∈ s, ∀ t ∈ T, ⁅p, t⁆ ∈ W) :
    ∀ y ∈ LieSubalgebra.lieSpan R L s, ∀ t ∈ T, ⁅y, t⁆ ∈ W := by
  let S : LieSubalgebra R L := LieSubalgebra.lieSpan R L s
  let Csub : Submodule R L :=
    { carrier := {y | y ∈ S ∧ ∀ t ∈ T, ⁅y, t⁆ ∈ W}
      zero_mem' := ⟨S.zero_mem, fun t _ => by rw [zero_lie]; exact W.zero_mem⟩
      add_mem' := fun hy hz => ⟨S.add_mem hy.1 hz.1, fun t ht => by
        rw [add_lie]; exact W.add_mem (hy.2 t ht) (hz.2 t ht)⟩
      smul_mem' := fun c y hy => ⟨S.smul_mem c hy.1, fun t ht => by
        rw [smul_lie]; exact W.smul_mem c (hy.2 t ht)⟩ }
  let C : LieSubalgebra R L :=
    { Csub with lie_mem' := fun hy hz =>
        ⟨S.lie_mem hy.1 hz.1, fun t ht => by
          rw [lie_lie]
          exact W.sub_mem (hkey _ hy.1 hy.2 _ (hz.2 t ht)) (hkey _ hz.1 hz.2 _ (hy.2 t ht))⟩ }
  have hle : S ≤ C :=
    LieSubalgebra.lieSpan_le.mpr fun p hp => ⟨LieSubalgebra.subset_lieSpan hp, hgen p hp⟩
  intro y hy
  exact (hle hy).2

/-- The sum of a Lie subalgebra and a Lie ideal is closed under the Lie bracket. -/
theorem lie_mem_sup_lieIdeal {T : LieSubalgebra R L} {I : LieIdeal R L} :
    ∀ ⦃a b : L⦄, a ∈ (T : Submodule R L) ⊔ (I : Submodule R L) →
      b ∈ (T : Submodule R L) ⊔ (I : Submodule R L) →
      ⁅a, b⁆ ∈ (T : Submodule R L) ⊔ (I : Submodule R L) := by
  let W : Submodule R L := (T : Submodule R L) ⊔ (I : Submodule R L)
  have hTW : (T : Submodule R L) ≤ W := le_sup_left
  have hIW : (I : Submodule R L) ≤ W := le_sup_right
  intro a b ha hb
  obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := Submodule.mem_sup.mp ha
  obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := Submodule.mem_sup.mp hb
  have h1 : ⁅a₁, b₁⁆ ∈ W := hTW (T.lie_mem ha₁ hb₁)
  have h2 : ⁅a₁, b₂⁆ ∈ W := hIW (I.lie_mem (x := a₁) hb₂)
  have h3 : ⁅a₂, b₁⁆ ∈ W := hIW (lieIdeal_lie_mem_left ha₂ b₁)
  have h4 : ⁅a₂, b₂⁆ ∈ W := hIW (lieIdeal_lie_mem_left ha₂ b₂)
  rw [add_lie, lie_add, lie_add]
  exact W.add_mem (W.add_mem h1 h2) (W.add_mem h3 h4)

end Generic

/-- Let `FL` be the free Lie algebra over a commutative ring `R` on the Serre generators
`{H i, E i, F i}` of a Cartan matrix `CM`, and let `I' ⊆ FL` be the Lie ideal generated by the
five families of Serre relations `HH`, `EF`, `HE`, `HF`, `adE` (all the Serre relations
**except** the `adF`/`F`-side ones).  Let `hF`, `nP`, `nM` be the Lie subalgebras generated by
the `H`-generators, the `E`-generators and the `F`-generators respectively.

Then `hF ⊔ nP ⊔ nM ⊔ I' = ⊤` (a "triangular decomposition" spanning statement).

Suggested proof (no monomial induction needed, only subalgebra tricks):
for a family `P` of generators and an element `x`, the sets
`{y | y ∈ (subalgebra generated by P) ∧ ⁅x,y⁆ ∈ W}` are Lie subalgebras, so it suffices to check
closure on the generators, using the generator-level relations `HH`, `HE`, `HF`, `EF`:
first `⁅H_i, nM⁆ ⊆ nM ⊔ I'` (using `HF`); then `⁅hF, nM⁆ ⊆ nM ⊔ I'` (second subalgebra trick on
`hF`); similarly `⁅hF, nP⁆ ⊆ nP ⊔ I'` (using `HE`); then `⁅E_i, nM⁆ ⊆ nM ⊔ hF ⊔ I'` (using `EF`
and the previous step); finally `⁅nP, nM⁆ ⊆ nM ⊔ hF ⊔ I'` (subalgebra trick on `nP`).
All uses of the Jacobi identity reduce to `⁅x, ⁅y,z⁆⁆ = ⁅⁅x,y⁆,z⁆ + ⁅y,⁅x,z⁆⁆`. -/
theorem borel_side_span_top (R : Type*) [CommRing R] (B : Type*) [DecidableEq B] (CM : Matrix B B ℤ) :
    ((LieSubalgebra.lieSpan R (FreeLieAlgebra R (CartanMatrix.Generators B))
        (Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.H i))) :
        Submodule R (FreeLieAlgebra R (CartanMatrix.Generators B)))
      ⊔ (LieSubalgebra.lieSpan R (FreeLieAlgebra R (CartanMatrix.Generators B))
        (Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.E i))) :
        Submodule R (FreeLieAlgebra R (CartanMatrix.Generators B)))
      ⊔ (LieSubalgebra.lieSpan R (FreeLieAlgebra R (CartanMatrix.Generators B))
        (Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.F i))) :
        Submodule R (FreeLieAlgebra R (CartanMatrix.Generators B)))
      ⊔ (LieSubmodule.lieSpan R (FreeLieAlgebra R (CartanMatrix.Generators B))
          (((Set.range (CartanMatrix.Relations.HH R))
            ∪ (Set.range (CartanMatrix.Relations.EF R))
            ∪ (Set.range (CartanMatrix.Relations.HE R CM)))
           ∪ (Set.range (CartanMatrix.Relations.HF R CM))
           ∪ (Set.range (CartanMatrix.Relations.adE R CM))) :
        Submodule R (FreeLieAlgebra R (CartanMatrix.Generators B))))
      = ⊤ := by
  let L := FreeLieAlgebra R (CartanMatrix.Generators B)
  let genH : Set L := Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.H i))
  let genE : Set L := Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.E i))
  let genF : Set L := Set.range (fun i => FreeLieAlgebra.of R (CartanMatrix.Generators.F i))
  let Rel : Set L :=
    ((Set.range (CartanMatrix.Relations.HH R)) ∪ (Set.range (CartanMatrix.Relations.EF R))
      ∪ (Set.range (CartanMatrix.Relations.HE R CM)))
     ∪ (Set.range (CartanMatrix.Relations.HF R CM)) ∪ (Set.range (CartanMatrix.Relations.adE R CM))
  let H : LieSubalgebra R L := LieSubalgebra.lieSpan R L genH
  let P : LieSubalgebra R L := LieSubalgebra.lieSpan R L genE
  let M : LieSubalgebra R L := LieSubalgebra.lieSpan R L genF
  let I' : LieIdeal R L := LieSubmodule.lieSpan R L Rel
  let V : Submodule R L :=
    (H : Submodule R L) ⊔ (P : Submodule R L) ⊔ (M : Submodule R L) ⊔ (I' : Submodule R L)
  let WM : Submodule R L := (M : Submodule R L) ⊔ (I' : Submodule R L)
  let WP : Submodule R L := (P : Submodule R L) ⊔ (I' : Submodule R L)
  let W4 : Submodule R L := ((M : Submodule R L) ⊔ (H : Submodule R L)) ⊔ (I' : Submodule R L)
  change V = ⊤
  have hHleV : (H : Submodule R L) ≤ V := le_trans le_sup_left (le_trans le_sup_left le_sup_left)
  have hPleV : (P : Submodule R L) ≤ V := le_trans le_sup_right (le_trans le_sup_left le_sup_left)
  have hMleV : (M : Submodule R L) ≤ V := le_trans le_sup_right le_sup_left
  have hIleV : (I' : Submodule R L) ≤ V := le_sup_right
  have hMIleV : WM ≤ V := sup_le hMleV hIleV
  have hPIleV : WP ≤ V := sup_le hPleV hIleV
  have hM4 : (M : Submodule R L) ≤ W4 := le_trans le_sup_left le_sup_left
  have hH4 : (H : Submodule R L) ≤ W4 := le_trans le_sup_right le_sup_left
  have hI4 : (I' : Submodule R L) ≤ W4 := le_sup_right
  have hMI4 : WM ≤ W4 := sup_le hM4 hI4
  have hW4leV : W4 ≤ V := sup_le (sup_le hMleV hHleV) hIleV

  -- ### Global inequalities
  have hIleWM : (I' : Submodule R L) ≤ WM := le_sup_right
  have hMleWM : (M : Submodule R L) ≤ WM := le_sup_left
  have hIleWP : (I' : Submodule R L) ≤ WP := le_sup_right
  have hPleWP : (P : Submodule R L) ≤ WP := le_sup_left
  -- ### Step 1: `[H, M] ⊆ M ⊔ I'`
  have hWMclosed : ∀ ⦃a b : L⦄, a ∈ WM → b ∈ WM → ⁅a, b⁆ ∈ WM :=
    fun a b ha hb => lie_mem_sup_lieIdeal (T := M) (I := I') ha hb
  have hHMstep : ∀ i : B, ∀ m ∈ (M : Submodule R L),
      ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i), m⁆ ∈ WM := by
    intro i
    refine lie_mem_of_lieSpan_of (s := genF) (W := WM)
      (x := FreeLieAlgebra.of R (CartanMatrix.Generators.H i)) ?_ ?_ ?_
    · exact hWMclosed
    · exact hMleWM
    · intro p hp
      obtain ⟨j, rfl⟩ := hp
      have hrel : CartanMatrix.Relations.HF R CM (i, j) ∈ I' :=
        LieSubmodule.subset_lieSpan (Or.inl (Or.inr (Set.mem_range_self (i, j))))
      have hval : CartanMatrix.Relations.HF R CM (i, j)
          = ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i),
             FreeLieAlgebra.of R (CartanMatrix.Generators.F j)⁆
            + CM i j • FreeLieAlgebra.of R (CartanMatrix.Generators.F j) := by
        simp [CartanMatrix.Relations.HF]
      rw [show ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i),
             FreeLieAlgebra.of R (CartanMatrix.Generators.F j)⁆
          = CartanMatrix.Relations.HF R CM (i, j)
            - CM i j • FreeLieAlgebra.of R (CartanMatrix.Generators.F j) from by
        rw [hval]; abel]
      exact WM.sub_mem (hIleWM hrel)
        (zsmul_mem (hMleWM (LieSubalgebra.subset_lieSpan (Set.mem_range_self j))) (CM i j))
  have hHM : ∀ y ∈ (H : Submodule R L), ∀ m ∈ (M : Submodule R L), ⁅y, m⁆ ∈ WM := by
    refine lie_mem_of_mem_lieSpan_of_mem (s := genH) (T := M) (W := WM) ?_ ?_
    · intro y hy hyM w hw
      obtain ⟨m, hm, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
      rw [lie_add]
      exact WM.add_mem (hyM m hm) (hIleWM (I'.lie_mem (x := y) hc))
    · intro q hq m hm
      obtain ⟨i, rfl⟩ := hq
      exact hHMstep i m hm
  -- ### Step 2: `[H, P] ⊆ P ⊔ I'`
  have hWPclosed : ∀ ⦃a b : L⦄, a ∈ WP → b ∈ WP → ⁅a, b⁆ ∈ WP :=
    fun a b ha hb => lie_mem_sup_lieIdeal (T := P) (I := I') ha hb
  have hHPstep : ∀ i : B, ∀ p ∈ (P : Submodule R L),
      ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i), p⁆ ∈ WP := by
    intro i
    refine lie_mem_of_lieSpan_of (s := genE) (W := WP)
      (x := FreeLieAlgebra.of R (CartanMatrix.Generators.H i)) ?_ ?_ ?_
    · exact hWPclosed
    · exact hPleWP
    · intro q hq
      obtain ⟨j, rfl⟩ := hq
      have hrel : CartanMatrix.Relations.HE R CM (i, j) ∈ I' :=
        LieSubmodule.subset_lieSpan (Or.inl (Or.inl (Or.inr (Set.mem_range_self (i, j)))))
      have hval : CartanMatrix.Relations.HE R CM (i, j)
          = ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i),
             FreeLieAlgebra.of R (CartanMatrix.Generators.E j)⁆
            - CM i j • FreeLieAlgebra.of R (CartanMatrix.Generators.E j) := by
        simp [CartanMatrix.Relations.HE]
      rw [show ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.H i),
             FreeLieAlgebra.of R (CartanMatrix.Generators.E j)⁆
          = CartanMatrix.Relations.HE R CM (i, j)
            + CM i j • FreeLieAlgebra.of R (CartanMatrix.Generators.E j) from by
        rw [hval]; abel]
      exact WP.add_mem (hIleWP hrel)
        (zsmul_mem (hPleWP (LieSubalgebra.subset_lieSpan (Set.mem_range_self j))) (CM i j))
  have hHP : ∀ y ∈ (H : Submodule R L), ∀ p ∈ (P : Submodule R L), ⁅y, p⁆ ∈ WP := by
    refine lie_mem_of_mem_lieSpan_of_mem (s := genH) (T := P) (W := WP) ?_ ?_
    · intro y hy hyP w hw
      obtain ⟨q, hq, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
      rw [lie_add]
      exact WP.add_mem (hyP q hq) (hIleWP (I'.lie_mem (x := y) hc))
    · intro q hq r hr
      obtain ⟨i, rfl⟩ := hq
      exact hHPstep i r hr
  -- ### Step 3: `[M ⊔ H, ·] ⊆ W4`
  have hW4 : ∀ ⦃a b : L⦄, a ∈ W4 → b ∈ W4 → ⁅a, b⁆ ∈ W4 := by
    intro a b ha hb
    obtain ⟨u, hu, c, hc, rfl⟩ := Submodule.mem_sup.mp ha
    obtain ⟨v, hv, d, hd, rfl⟩ := Submodule.mem_sup.mp hb
    have h1 : ⁅u, d⁆ ∈ W4 := hI4 (I'.lie_mem (x := u) hd)
    have h2 : ⁅c, v⁆ ∈ W4 := hI4 (lieIdeal_lie_mem_left hc v)
    have h3 : ⁅c, d⁆ ∈ W4 := hI4 (lieIdeal_lie_mem_left hc d)
    have huv : ⁅u, v⁆ ∈ W4 := by
      obtain ⟨m, hm, h, hh, rfl⟩ := Submodule.mem_sup.mp hu
      obtain ⟨m', hm', h', hh', rfl⟩ := Submodule.mem_sup.mp hv
      have hm1 : ⁅m, m'⁆ ∈ W4 := hM4 (M.lie_mem hm hm')
      have hm2 : ⁅m, h'⁆ ∈ W4 := by
        rw [← lie_skew]
        exact hMI4 (WM.neg_mem (hHM h' hh' m hm))
      have hm3 : ⁅h, m'⁆ ∈ W4 := hMI4 (hHM h hh m' hm')
      have hm4 : ⁅h, h'⁆ ∈ W4 := hH4 (H.lie_mem hh hh')
      rw [add_lie, lie_add, lie_add]
      exact W4.add_mem (W4.add_mem hm1 hm2) (W4.add_mem hm3 hm4)
    rw [add_lie, lie_add, lie_add]
    exact W4.add_mem (W4.add_mem huv h1) (W4.add_mem h2 h3)
  -- ### Step 4: `[E_i, M] ⊆ W4`
  have hEM : ∀ i : B, ∀ m ∈ (M : Submodule R L),
      ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.E i), m⁆ ∈ W4 := by
    intro i
    refine lie_mem_of_lieSpan_of (s := genF) (W := W4)
      (x := FreeLieAlgebra.of R (CartanMatrix.Generators.E i)) ?_ ?_ ?_
    · exact hW4
    · exact hM4
    · intro p hp
      obtain ⟨j, rfl⟩ := hp
      by_cases hij : i = j
      · rw [← hij]
        have hrel : CartanMatrix.Relations.EF R (i, i) ∈ I' :=
          LieSubmodule.subset_lieSpan (Or.inl (Or.inl (Or.inl (Or.inr (Set.mem_range_self (i, i))))))
        have hval : CartanMatrix.Relations.EF R (i, i)
            = ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.E i),
               FreeLieAlgebra.of R (CartanMatrix.Generators.F i)⁆
              - FreeLieAlgebra.of R (CartanMatrix.Generators.H i) := by
          simp [CartanMatrix.Relations.EF]
        rw [show ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.E i),
               FreeLieAlgebra.of R (CartanMatrix.Generators.F i)⁆
            = CartanMatrix.Relations.EF R (i, i)
              + FreeLieAlgebra.of R (CartanMatrix.Generators.H i) from by
          rw [hval]; abel]
        exact W4.add_mem (hI4 hrel)
          (hH4 (LieSubalgebra.subset_lieSpan (Set.mem_range_self i)))
      · have hval : CartanMatrix.Relations.EF R (i, j)
            = ⁅FreeLieAlgebra.of R (CartanMatrix.Generators.E i),
               FreeLieAlgebra.of R (CartanMatrix.Generators.F j)⁆ := by
          simp [CartanMatrix.Relations.EF, hij]
        rw [← hval]
        exact hI4 (LieSubmodule.subset_lieSpan
          (Or.inl (Or.inl (Or.inl (Or.inr (Set.mem_range_self (i, j)))))))
  -- ### Step 5: `[P, M] ⊆ V`
  have hPM : ∀ y ∈ (P : Submodule R L), ∀ m ∈ (M : Submodule R L), ⁅y, m⁆ ∈ V := by
    refine lie_mem_of_mem_lieSpan_of_mem (s := genE) (T := M) (W := V) ?_ ?_
    · intro y hy hyM w hw
      obtain ⟨w1, hw1, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
      obtain ⟨w2, hw2, m, hm, rfl⟩ := Submodule.mem_sup.mp hw1
      obtain ⟨hh, hhh, q, hq, rfl⟩ := Submodule.mem_sup.mp hw2
      have h1 : ⁅y, hh⁆ ∈ V := by
        refine hPIleV ?_
        rw [← lie_skew]
        exact WP.neg_mem (hHP hh hhh y hy)
      have h2 : ⁅y, q⁆ ∈ V := hPleV (P.lie_mem hy hq)
      have h3 : ⁅y, m⁆ ∈ V := hyM m hm
      have h4 : ⁅y, c⁆ ∈ V := hIleV (I'.lie_mem (x := y) hc)
      rw [lie_add, lie_add, lie_add]
      exact V.add_mem (V.add_mem (V.add_mem h1 h2) h3) h4
    · intro q hq m hm
      obtain ⟨i, rfl⟩ := hq
      exact hW4leV (hEM i m hm)
  -- ### Step 6: linearity
  have hIV : ∀ y ∈ (I' : Submodule R L), ∀ w ∈ V, ⁅y, w⁆ ∈ V :=
    fun y hy w _ => hIleV (lieIdeal_lie_mem_left hy w)
  have hHV : ∀ y ∈ (H : Submodule R L), ∀ w ∈ V, ⁅y, w⁆ ∈ V := by
    intro y hy w hw
    obtain ⟨w1, hw1, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    obtain ⟨w2, hw2, m, hm, rfl⟩ := Submodule.mem_sup.mp hw1
    obtain ⟨hh, hhh, q, hq, rfl⟩ := Submodule.mem_sup.mp hw2
    have h1 : ⁅y, hh⁆ ∈ V := hHleV (H.lie_mem hy hhh)
    have h2 : ⁅y, q⁆ ∈ V := hPIleV (hHP y hy q hq)
    have h3 : ⁅y, m⁆ ∈ V := hMIleV (hHM y hy m hm)
    have h4 : ⁅y, c⁆ ∈ V := hIleV (I'.lie_mem (x := y) hc)
    rw [lie_add, lie_add, lie_add]
    exact V.add_mem (V.add_mem (V.add_mem h1 h2) h3) h4
  have hPV : ∀ y ∈ (P : Submodule R L), ∀ w ∈ V, ⁅y, w⁆ ∈ V := by
    intro y hy w hw
    obtain ⟨w1, hw1, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    obtain ⟨w2, hw2, m, hm, rfl⟩ := Submodule.mem_sup.mp hw1
    obtain ⟨hh, hhh, q, hq, rfl⟩ := Submodule.mem_sup.mp hw2
    have h1 : ⁅y, hh⁆ ∈ V := by
      refine hPIleV ?_
      rw [← lie_skew]
      exact WP.neg_mem (hHP hh hhh y hy)
    have h2 : ⁅y, q⁆ ∈ V := hPleV (P.lie_mem hy hq)
    have h3 : ⁅y, m⁆ ∈ V := hPM y hy m hm
    have h4 : ⁅y, c⁆ ∈ V := hIleV (I'.lie_mem (x := y) hc)
    rw [lie_add, lie_add, lie_add]
    exact V.add_mem (V.add_mem (V.add_mem h1 h2) h3) h4
  have hMV : ∀ y ∈ (M : Submodule R L), ∀ w ∈ V, ⁅y, w⁆ ∈ V := by
    intro y hy w hw
    obtain ⟨w1, hw1, c, hc, rfl⟩ := Submodule.mem_sup.mp hw
    obtain ⟨w2, hw2, m, hm, rfl⟩ := Submodule.mem_sup.mp hw1
    obtain ⟨hh, hhh, q, hq, rfl⟩ := Submodule.mem_sup.mp hw2
    have h1 : ⁅y, hh⁆ ∈ V := by
      refine hMIleV ?_
      rw [← lie_skew]
      exact WM.neg_mem (hHM hh hhh y hy)
    have h2 : ⁅y, q⁆ ∈ V := by
      rw [← lie_skew]
      exact V.neg_mem (hPM q hq y hy)
    have h3 : ⁅y, m⁆ ∈ V := hMleV (M.lie_mem hy hm)
    have h4 : ⁅y, c⁆ ∈ V := hIleV (I'.lie_mem (x := y) hc)
    rw [lie_add, lie_add, lie_add]
    exact V.add_mem (V.add_mem (V.add_mem h1 h2) h3) h4
  have hgood : ∀ ⦃a b : L⦄, a ∈ V → b ∈ V → ⁅a, b⁆ ∈ V := by
    intro a b ha hb
    obtain ⟨a1, ha1, c, hc, rfl⟩ := Submodule.mem_sup.mp ha
    obtain ⟨a2, ha2, m, hm, rfl⟩ := Submodule.mem_sup.mp ha1
    obtain ⟨hh, hhh, q, hq, rfl⟩ := Submodule.mem_sup.mp ha2
    have h1 : ⁅hh, b⁆ ∈ V := hHV hh hhh b hb
    have h2 : ⁅q, b⁆ ∈ V := hPV q hq b hb
    have h3 : ⁅m, b⁆ ∈ V := hMV m hm b hb
    have h4 : ⁅c, b⁆ ∈ V := hIV c hc b hb
    rw [add_lie, add_lie, add_lie]
    exact V.add_mem (V.add_mem (V.add_mem h1 h2) h3) h4
  -- ### Step 7: conclude
  let V' : LieSubalgebra R L := { V with lie_mem' := fun hx hy => hgood hx hy }
  have hV'top : V' = ⊤ := by
    refine le_antisymm le_top ?_
    rw [← Commons.Algebra.Lie.SerreConstruction.FreeLieAlgebra.lieSpan_of
      (R := R) (X := CartanMatrix.Generators B)]
    refine LieSubalgebra.lieSpan_le.mpr ?_
    rintro g ⟨x, rfl⟩
    cases x with
    | H i => exact hHleV (LieSubalgebra.subset_lieSpan (Set.mem_range_self i))
    | E i => exact hPleV (LieSubalgebra.subset_lieSpan (Set.mem_range_self i))
    | F i => exact hMleV (LieSubalgebra.subset_lieSpan (Set.mem_range_self i))
  have hVm : V = ⊤ := by
    have h := congrArg (fun K : LieSubalgebra R L => (K : Submodule R L)) hV'top
    rw [LieSubalgebra.top_toSubmodule] at h
    exact h
  exact hVm

end Commons.Algebra.Lie.SerreConstruction
