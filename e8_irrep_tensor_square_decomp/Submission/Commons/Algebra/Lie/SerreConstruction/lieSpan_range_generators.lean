import Mathlib.Algebra.Lie.SerreConstruction

namespace Commons.Algebra.Lie.SerreConstruction

/-- The free Lie algebra on `X` is generated, as a Lie algebra, by the image of `of`.

This is the free Lie algebra analogue of `FreeAlgebra.adjoin_range_ι`. -/
theorem FreeLieAlgebra.lieSpan_of {R : Type*} {X : Type*} [CommRing R] :
    LieSubalgebra.lieSpan R (FreeLieAlgebra R X) (Set.range (FreeLieAlgebra.of R)) = ⊤ := by
  set K : LieSubalgebra R (FreeLieAlgebra R X) :=
    LieSubalgebra.lieSpan R (FreeLieAlgebra R X) (Set.range (FreeLieAlgebra.of R)) with hK
  let g : X → K := fun x =>
    ⟨FreeLieAlgebra.of R x, LieSubalgebra.subset_lieSpan (Set.mem_range_self x)⟩
  have hφ : K.incl.comp (FreeLieAlgebra.lift R g) =
      (LieHom.id : FreeLieAlgebra R X →ₗ⁅R⁆ FreeLieAlgebra R X) := by
    apply FreeLieAlgebra.hom_ext
    intro x
    simp [g]
  rw [hK, eq_top_iff]
  intro x _
  have hx : (K.incl.comp (FreeLieAlgebra.lift R g)) x = x := by
    rw [hφ]; rfl
  rw [← hx]
  exact (FreeLieAlgebra.lift R g x).2

/-- The Serre-constructed Lie algebra (a quotient of the free Lie algebra by the Serre relations)
is generated, as a Lie algebra, by the images of the generators `H i`, `E i`, `F i`.
Note `Matrix.ToLieAlgebra R CM` is definitionally the quotient below.

Suggested proof: apply the commons lemma `Algebra/Lie/FreeLieAlgebra/lieSpan_range_of`
(the free Lie algebra is generated by `of`) and transport along the surjective quotient map
`FreeLieAlgebra R _ → FreeLieAlgebra R _ ⧸ CartanMatrix.Relations.toIdeal R CM` using
`LieSubmodule.map`/`LieSubmodule.lieSpan_le`, `LieSubmodule.map_le_iff_le_comap` and
`LieHom.range_eq_top`. -/
theorem lieSpan_range_generators {R B : Type*} [CommRing R] [DecidableEq B] (CM : Matrix B B ℤ) :
    LieSubmodule.lieSpan R
      (FreeLieAlgebra R (CartanMatrix.Generators B) ⧸ CartanMatrix.Relations.toIdeal R CM)
      (Set.range (fun g : CartanMatrix.Generators B =>
        LieSubmodule.Quotient.mk (N := CartanMatrix.Relations.toIdeal R CM)
          (FreeLieAlgebra.of R g))) = ⊤ := by
  let L := FreeLieAlgebra R (CartanMatrix.Generators B)
  let I : LieIdeal R L := CartanMatrix.Relations.toIdeal R CM
  let s : Set (L ⧸ I) :=
    Set.range (fun g : CartanMatrix.Generators B =>
      LieSubmodule.Quotient.mk (N := I) (FreeLieAlgebra.of R g))
  -- The quotient map, as a Lie algebra morphism.
  let φ : L →ₗ⁅R⁆ (L ⧸ I) :=
    { (LieSubmodule.Quotient.mk' I : L →ₗ[R] (L ⧸ I)) with
      map_lie' := fun {x y} => LieSubmodule.Quotient.mk_bracket I x y }
  have hφsurj : Function.Surjective φ := LieSubmodule.Quotient.surjective_mk' I
  -- The free Lie algebra is generated by the images of `of`.
  have hgen : LieSubalgebra.lieSpan R L (Set.range (FreeLieAlgebra.of R)) = ⊤ :=
    FreeLieAlgebra.lieSpan_of
  -- Transport generation along the surjective quotient map.
  have hs : LieSubalgebra.lieSpan R (L ⧸ I) s = ⊤ := by
    have hmap := LieSubalgebra.map_lieSpan (f := φ) (s := Set.range (FreeLieAlgebra.of R))
    rw [hgen] at hmap
    rw [← LieSubalgebra.map_top R L φ, (LieHom.range_eq_top φ).mpr hφsurj] at hmap
    have himg : φ '' Set.range (FreeLieAlgebra.of R) = s := by
      rw [← Set.range_comp]; rfl
    rw [himg] at hmap
    exact hmap.symm
  -- The `LieSubmodule` span contains the `LieSubalgebra` span.
  rw [eq_top_iff]
  have hle : (⊤ : LieSubalgebra R (L ⧸ I)) ≤
      ((LieSubmodule.lieSpan R (L ⧸ I) s : LieIdeal R (L ⧸ I)) : LieSubalgebra R (L ⧸ I)) := by
    rw [← hs]
    exact LieSubalgebra.lieSpan_le.mpr LieSubmodule.subset_lieSpan
  exact hle

end Commons.Algebra.Lie.SerreConstruction