import Mathlib
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_simple_root_weightSpace_finrank_compat

namespace Commons.Algebra.Lie.SerreConstruction

/-!
# Weight spaces of the Serre-constructed `e₈` outside the root cones are zero

The Serre construction `L8 = Matrix.ToLieAlgebra ℂ CartanMatrix.E₈` of `e₈` carries a
triangular decomposition `L8 = Hsub + Psub + Msub`, where `Hsub` is the span of the Cartan
generators, `Psub` is generated by the `E`-generators and `Msub` by the `F`-generators.
Every element of `Psub` is a finite sum of weight vectors whose weights are nonnegative
integral combinations `∑ᵢ nᵢαᵢ` of the simple roots (`n : Fin 8 → ℕ`), every element of
`Msub` is a finite sum of weight vectors of weights `-∑ᵢ nᵢαᵢ`, and `Hsub ⊆ W 0`.

Consequently a weight vector of weight `ν` which is **not** of the form `0`, `∑ᵢ nᵢαᵢ` or
`-∑ᵢ nᵢαᵢ` must be zero: the "killer" operators `ad (H i) - ν i` annihilate each of the
finitely many weight components of the triangular decomposition, while acting on `W ν` as
the nonzero scalar `∏ (ν i - ν i)`.
-/

/-- **A weight space outside the root cones is zero.**  If `ν` is a weight functional which is
neither `0` nor of the form `∑ᵢ nᵢαᵢ` nor `-∑ᵢ nᵢαᵢ` for `n : Fin 8 → ℕ`, then the
`ν`-weight space of the Serre-constructed `e₈` is zero. -/
theorem e8_W_eq_bot_of_not_cone {ν : Fin 8 → ℂ} (h0 : ν ≠ 0)
    (hpos : ∀ n : Fin 8 → ℕ, Commons.Algebra.Lie.SerreConstruction.NWtSum n ≠ ν)
    (hneg : ∀ n : Fin 8 → ℕ, -(Commons.Algebra.Lie.SerreConstruction.NWtSum n) ≠ ν) :
    Commons.Algebra.Lie.SerreConstruction.W ν = ⊥ := by
  classical
  rw [Submodule.eq_bot_iff]
  intro x hx
  -- split `x` along the triangular decomposition
  have hxmem : x ∈ (Hsub : Submodule ℂ L8) ⊔ (Psub : Submodule ℂ L8) ⊔
      (Msub : Submodule ℂ L8) := by rw [span_H_P_M_top]; trivial
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hxmem
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hy
  have hxabc : x = a + b + z := by rw [← hyz, ← hab]
  -- weight decompositions of the `n⁺`- and `n⁻`-parts
  obtain ⟨sb, hsb⟩ := Submodule.mem_iSup_iff_exists_finset.mp (Psub_le_iSup_Pm hb)
  obtain ⟨fb, hfb, hbsum⟩ := mem_iSup_finset_iff.mp hsb
  obtain ⟨sc, hsc⟩ := Submodule.mem_iSup_iff_exists_finset.mp (Msub_le_iSup_Mm hz)
  obtain ⟨fc, hfc, hcsum⟩ := mem_iSup_finset_iff.mp hsc
  -- the set of weights occurring in the decomposition
  set S : Finset (Fin 8 → ℂ) :=
    insert 0 ((sb.image NWtSum) ∪ (sc.image (fun m => -(NWtSum m)))) with hS
  have h0S : (0 : Fin 8 → ℂ) ∈ S := by rw [hS]; exact Finset.mem_insert_self 0 _
  have hbS : ∀ m ∈ sb, NWtSum m ∈ S := by
    intro m hm
    rw [hS]
    exact Finset.mem_insert.mpr (Or.inr (Finset.mem_union.mpr
      (Or.inl (Finset.mem_image.mpr ⟨m, hm, rfl⟩))))
  have hcS : ∀ m ∈ sc, (-(NWtSum m)) ∈ S := by
    intro m hm
    rw [hS]
    exact Finset.mem_insert.mpr (Or.inr (Finset.mem_union.mpr
      (Or.inr (Finset.mem_image.mpr ⟨m, hm, rfl⟩))))
  -- the killer list: none of the weights occurring in `S` equals `ν`
  set L : List (Fin 8 × ℂ) := killerList ν S with hL
  have hval : (L.map (fun p => ν p.1 - p.2)).prod ≠ 0 := by
    rw [hL]; exact killerList_prod_ne_zero
  have hTx : (L.map killer).prod x = (L.map (fun p => ν p.1 - p.2)).prod • x := by
    rw [hL]; exact list_prod_killer_apply L hx
  -- the `H`-part is killed
  have hTa : (L.map killer).prod a = 0 := by
    refine prod_killer_apply_eq_zero L (Hsub_le_W_zero ha)
      ⟨(sepCoord ν 0, (0 : Fin 8 → ℂ) (sepCoord ν 0)), ?_, rfl⟩
    rw [hL]
    exact killerList_mem h0S h0.symm
  -- the `n⁺`-part is killed
  have hTb : (L.map killer).prod b = 0 := by
    rw [hbsum, map_sum]
    refine Finset.sum_eq_zero fun m hm => ?_
    exact prod_killer_apply_eq_zero L ((hfb m hm).2)
      ⟨(sepCoord ν (NWtSum m), NWtSum m (sepCoord ν (NWtSum m))),
        by rw [hL]; exact killerList_mem (hbS m hm) (hpos m), rfl⟩
  -- the `n⁻`-part is killed
  have hTz : (L.map killer).prod z = 0 := by
    rw [hcsum, map_sum]
    refine Finset.sum_eq_zero fun m hm => ?_
    exact prod_killer_apply_eq_zero L ((hfc m hm).2)
      ⟨(sepCoord ν (-(NWtSum m)), (-(NWtSum m)) (sepCoord ν (-(NWtSum m)))),
        by rw [hL]; exact killerList_mem (hcS m hm) (hneg m), rfl⟩
  -- assemble: `λ • x = 0` with `λ ≠ 0`
  have hTx' : (L.map killer).prod x
      = (L.map killer).prod a + (L.map killer).prod b + (L.map killer).prod z := by
    rw [hxabc, map_add, map_add]
  have hkey : (L.map (fun p => ν p.1 - p.2)).prod • x = 0 := by
    rw [← hTx, hTx', hTa, hTb, hTz, zero_add, add_zero]
  have hfin := congrArg
    (fun w => ((L.map (fun p => ν p.1 - p.2)).prod)⁻¹ • w) hkey
  simpa [smul_smul, inv_mul_cancel₀ hval] using hfin

end Commons.Algebra.Lie.SerreConstruction
