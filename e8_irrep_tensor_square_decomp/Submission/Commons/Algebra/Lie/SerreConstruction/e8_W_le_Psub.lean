import Mathlib
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_simple_root_weightSpace_finrank_compat

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 8000000

namespace Commons.Algebra.Lie.SerreConstruction

/-!
# The weight space of a nonnegative weight lies in the positive nilpotent

For a nonzero `n : Fin 8 → ℕ`, the joint weight space of the Serre-constructed `e₈` at the
nonnegative weight `ν = ∑ᵢ nᵢ αᵢ = NWtSum n` is contained in the subalgebra `Psub` generated by
the `E`-generators.

The proof is the same mechanism as for a simple root
(`Commons.Algebra.Lie.SerreConstruction.W_alpha_le_span`): decompose a weight vector along the
triangular decomposition `L8 = Hsub ⊔ Psub ⊔ Msub`, then apply the "killer" operators
`ad (H i) - ν i` — they annihilate every weight component whose weight differs from `ν`, and
`ν ≠ 0` is neither `0` nor a nonpositive weight, so only the `Psub`-components of weight `ν`
survive.  Each such component lies in `Pm m = Psub ⊓ W (NWtSum m)`, hence in `Psub`.
-/

/-- `-∑ᵢ mᵢ αᵢ ≠ ∑ᵢ nᵢ αᵢ` when `n ≠ 0`. -/
lemma neg_NWtSum_ne_NWtSum {m n : Fin 8 → ℕ} (hn : n ≠ 0) : -(NWtSum m) ≠ NWtSum n := by
  intro h
  have h1 : NWtSum n + NWtSum m = 0 := by rw [← h]; abel
  rw [← NWtSum_add] at h1
  have h2 : n + m = 0 := NWtSum_eq_zero h1
  exact hn (add_eq_zero.mp h2).1

theorem e8_W_le_Psub {n : Fin 8 → ℕ} (hn : n ≠ 0) :
    (Commons.Algebra.Lie.SerreConstruction.W (Commons.Algebra.Lie.SerreConstruction.NWtSum n) :
      Submodule ℂ Commons.Algebra.Lie.SerreConstruction.L8) ≤
      (Commons.Algebra.Lie.SerreConstruction.Psub : Submodule ℂ Commons.Algebra.Lie.SerreConstruction.L8) := by
  classical
  intro x hx
  have hnu_ne_zero : NWtSum n ≠ 0 := fun h => hn (NWtSum_eq_zero h)
  have h0ne : (0 : Fin 8 → ℂ) ≠ NWtSum n := fun h => hnu_ne_zero h.symm
  have hneg : ∀ m : Fin 8 → ℕ, -(NWtSum m) ≠ NWtSum n := fun m => neg_NWtSum_ne_NWtSum hn
  -- split `x` along the triangular decomposition
  have hxmem : x ∈ (Hsub : Submodule ℂ L8) ⊔ (Psub : Submodule ℂ L8) ⊔
      (Msub : Submodule ℂ L8) := by rw [span_H_P_M_top]; trivial
  obtain ⟨y, hy, z, hz, hyz⟩ := Submodule.mem_sup.mp hxmem
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hy
  have hxabc : x = a + b + z := by rw [← hyz, ← hab]
  -- weight decompositions of the `n⁺`- and `n⁻`-parts
  obtain ⟨sb, hsb⟩ := Submodule.mem_iSup_iff_exists_finset.mp (Psub_le_iSup_Pm hb)
  obtain ⟨fb, hfb, hbsum⟩ := mem_iSup_finset_iff.mp hsb
  obtain ⟨sc, hsc⟩ := Submodule.mem_iSup_iff_exists_finset.mp (Msub_le_iSup_Mm hz)
  obtain ⟨fc, hfc, hcsum⟩ := mem_iSup_finset_iff.mp hsc
  -- the set of weights occurring in the decomposition
  set S : Finset (Fin 8 → ℂ) :=
    insert 0 ((sb.image NWtSum) ∪ (sc.image (fun m => -(NWtSum m)))) with hS
  have h0S : (0 : Fin 8 → ℂ) ∈ S := by rw [hS]; exact Finset.mem_insert_self 0 _
  have hbS : ∀ m ∈ sb, NWtSum m ∈ S := by
    intro m hm
    rw [hS]
    exact Finset.mem_insert.mpr (Or.inr (Finset.mem_union.mpr
      (Or.inl (Finset.mem_image.mpr ⟨m, hm, rfl⟩))))
  have hcS : ∀ m ∈ sc, (-(NWtSum m)) ∈ S := by
    intro m hm
    rw [hS]
    exact Finset.mem_insert.mpr (Or.inr (Finset.mem_union.mpr
      (Or.inr (Finset.mem_image.mpr ⟨m, hm, rfl⟩))))
  -- the killer list
  set L : List (Fin 8 × ℂ) := killerList (NWtSum n) S with hL
  have hval : (L.map (fun p => NWtSum n p.1 - p.2)).prod ≠ 0 := by
    rw [hL]; exact killerList_prod_ne_zero
  have hTx : (L.map killer).prod x = (L.map (fun p => NWtSum n p.1 - p.2)).prod • x := by
    rw [hL]; exact list_prod_killer_apply L hx
  -- the `H`-part is killed
  have hTa : (L.map killer).prod a = 0 := by
    refine prod_killer_apply_eq_zero L (Hsub_le_W_zero ha)
      ⟨(sepCoord (NWtSum n) 0, (0 : Fin 8 → ℂ) (sepCoord (NWtSum n) 0)), ?_, rfl⟩
    rw [hL]
    exact killerList_mem h0S h0ne
  -- the `n⁺`-part: only the `ν`-components survive
  have hTb : (L.map killer).prod b
      = (L.map (fun p => NWtSum n p.1 - p.2)).prod •
        (∑ m ∈ sb with NWtSum m = NWtSum n, fb m) := by
    rw [hbsum, map_sum, Finset.smul_sum, Finset.sum_filter]
    refine Finset.sum_congr rfl fun m hm => ?_
    by_cases hh : NWtSum m = NWtSum n
    · rw [if_pos hh, list_prod_killer_apply L (hfb m hm).2]
      congr 1
      rw [hh]
    · rw [if_neg hh]
      refine prod_killer_apply_eq_zero L ((hfb m hm).2)
        ⟨(sepCoord (NWtSum n) (NWtSum m), NWtSum m (sepCoord (NWtSum n) (NWtSum m))), ?_, rfl⟩
      rw [hL]
      exact killerList_mem (hbS m hm) hh
  -- the `n⁻`-part is killed
  have hTz : (L.map killer).prod z = 0 := by
    rw [hcsum, map_sum]
    refine Finset.sum_eq_zero fun m hm => ?_
    refine prod_killer_apply_eq_zero L ((hfc m hm).2)
      ⟨(sepCoord (NWtSum n) (-(NWtSum m)), (-(NWtSum m)) (sepCoord (NWtSum n) (-(NWtSum m)))),
        ?_, rfl⟩
    rw [hL]
    exact killerList_mem (hcS m hm) (hneg m)
  -- assemble
  have hTx' : (L.map killer).prod x
      = (L.map killer).prod a + (L.map killer).prod b + (L.map killer).prod z := by
    rw [hxabc, map_add, map_add]
  have hkey : (L.map (fun p => NWtSum n p.1 - p.2)).prod • x
      = (L.map (fun p => NWtSum n p.1 - p.2)).prod •
        (∑ m ∈ sb with NWtSum m = NWtSum n, fb m) := by
    rw [← hTx, hTx', hTa, hTb, hTz, zero_add, add_zero]
  have hxsum : x = ∑ m ∈ sb with NWtSum m = NWtSum n, fb m := by
    have h := congrArg
      (fun w => ((L.map (fun p => NWtSum n p.1 - p.2)).prod)⁻¹ • w) hkey
    simpa [smul_smul, inv_mul_cancel₀ hval] using h
  -- the surviving sum lies in `Psub`
  rw [hxsum]
  refine Submodule.sum_mem _ fun m hm => ?_
  exact (hfb m (Finset.mem_of_mem_filter m hm)).1

end Commons.Algebra.Lie.SerreConstruction
