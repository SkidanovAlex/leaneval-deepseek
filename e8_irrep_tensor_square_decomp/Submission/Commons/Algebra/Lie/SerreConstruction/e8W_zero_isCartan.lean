import Mathlib
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_isKilling
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_zero_weightSpace_finrank
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_weightSpace_iSup_eq_top
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_weightSpace_ascent
import Submission.Commons.Algebra.Lie.SerreConstruction.e8_weightSpace_descent
import Submission.Commons.Algebra.Lie.SerreConstruction.weight_norm_two
import Submission.Commons.Algebra.Lie.e8_finrank

namespace Commons.Algebra.Lie.SerreConstruction

open Commons.Algebra.Lie

noncomputable section

/-- **The zero weight space of the adjoint representation of `e₈` is a Cartan subalgebra.**
This is what makes the `LieAlgebra.IsKilling` API applicable to `e₈`.

Ingredients already in the commons: `Commons.Algebra.Lie.SerreConstruction.e8_isKilling`,
`e8W_zero_eq_span_SerreH` (the zero weight space is `span{SerreH i}`, an abelian hence nilpotent
subalgebra), `e8_weightSpace_iSup_eq_top`, `e8_weightSpace_ascent`, `e8_weightSpace_descent`,
`exists_e8W_inf_ne_bot`, `weight_norm_two`.

Self-normalizing: if `x ∈ normalizer 𝔥` then `⁅SerreH i, x⁆ ∈ 𝔥 = e8W 0`; decompose `x` into weight
components for the commuting operators `ad (SerreH i)` (possible by `exists_e8W_inf_ne_bot`-type
reasoning applied to the span of the Lie orbit), and a nonzero component `x_ν` with `ν ≠ 0` would
force `ν = 0`. -/
theorem e8W_zero_isCartan :
    ∃ H : LieSubalgebra ℂ (LieAlgebra.e₈ ℂ),
      (∀ x : LieAlgebra.e₈ ℂ, x ∈ H ↔ x ∈ Commons.Algebra.Lie.e8W 0) ∧ H.IsCartanSubalgebra := by
  classical
  -- `e8W 0` as the honest weight space `W 0`.
  have hW0 : e8W (0 : Fin 8 → ℤ) = W (0 : Fin 8 → ℂ) := by
    rw [e8W_eq_W]; congr 1; funext j; simp
  -- The subalgebra generated by the `SerreH i`; its carrier is `e8W 0`.
  set H : LieSubalgebra ℂ L8 := LieSubalgebra.lieSpan ℂ L8 (Set.range SerreH) with hHdef
  have hsq : ∀ x ∈ (Set.range SerreH), ∀ y ∈ (Set.range SerreH), ⁅x, y⁆ = 0 := by
    rintro x ⟨i, rfl⟩ y ⟨j, rfl⟩
    exact serreLie_HH i j
  have hHcoe : (H : Submodule ℂ L8) = e8W 0 := by
    rw [hHdef, e8W_zero_eq_span_SerreH]
    exact LieSubalgebra.coe_lieSpan_eq_span_of_forall_lie_eq_zero (R := ℂ) (L := L8) hsq
  have hHmem : ∀ x : L8, x ∈ H ↔ x ∈ e8W 0 := by
    intro x
    rw [← hHcoe]
    exact Iff.rfl
  refine ⟨H, hHmem, ?_, ?_⟩
  · -- `𝔥` is abelian, hence nilpotent.
    have hab : IsLieAbelian H := by
      rw [hHdef, LieSubalgebra.isLieAbelian_lieSpan_iff]
      exact hsq
    haveI : LieModule.IsTrivial H H := hab
    exact inferInstance
  · -- Self-normalizing.
    refine le_antisymm ?_ H.le_normalizer
    intro x hx
    rw [LieSubalgebra.mem_normalizer_iff] at hx
    rw [hHmem x]
    -- Decompose `x` along the weight spaces.
    have hxdec : x ∈ ⨆ μ : Fin 8 → ℤ, e8W μ := by rw [e8W_iSup_eq_top]; trivial
    obtain ⟨s, hs⟩ := Submodule.mem_iSup_iff_exists_finset.mp hxdec
    obtain ⟨f, hf, hsum⟩ := mem_iSup_finset_iff.mp hs
    -- For every `i`, a component whose `i`-th weight is nonzero vanishes.
    have key : ∀ i : Fin 8, ∀ μ ∈ s, μ i ≠ 0 → f μ = 0 := by
      intro i μ hμ hμi
      have hge : ⁅SerreH i, x⁆ ∈ e8W 0 := by
        have h1 : ⁅x, SerreH i⁆ ∈ H := by
          rw [hHdef]
          exact hx (SerreH i) (LieSubalgebra.subset_lieSpan ⟨i, rfl⟩)
        have h2 : ⁅x, SerreH i⁆ ∈ e8W 0 := (hHmem _).mp h1
        rw [← lie_skew (SerreH i) x]
        exact neg_mem h2
      have hgeW : ⁅SerreH i, x⁆ ∈ W (0 : Fin 8 → ℂ) := by rw [← hW0]; exact hge
      have h3 : ⁅SerreH i, ⁅SerreH i, x⁆⁆ = 0 := by
        have h := mem_W_iff.mp hgeW i
        simpa using h
      have step : ∀ ν ∈ s, ⁅SerreH i, ⁅SerreH i, f ν⁆⁆
          = (((ν i : ℤ) : ℂ) * ((ν i : ℤ) : ℂ)) • f ν := by
        intro ν hν
        have hfν : f ν ∈ W (fun j => ((ν j : ℤ) : ℂ)) := by
          rw [← e8W_eq_W]; exact hf ν hν
        have h1 : ⁅SerreH i, f ν⁆ = ((ν i : ℤ) : ℂ) • f ν := mem_W_iff.mp hfν i
        calc ⁅SerreH i, ⁅SerreH i, f ν⁆⁆
            = ⁅SerreH i, ((ν i : ℤ) : ℂ) • f ν⁆ := by rw [h1]
          _ = ((ν i : ℤ) : ℂ) • ⁅SerreH i, f ν⁆ := by rw [lie_smul]
          _ = ((ν i : ℤ) : ℂ) • (((ν i : ℤ) : ℂ) • f ν) := by rw [h1]
          _ = (((ν i : ℤ) : ℂ) * ((ν i : ℤ) : ℂ)) • f ν := by rw [smul_smul]
      have hsum_ad : ⁅SerreH i, ∑ ν ∈ s, f ν⁆ = ∑ ν ∈ s, ⁅SerreH i, f ν⁆ := by
        rw [show (∑ ν ∈ s, ⁅SerreH i, f ν⁆)
            = ∑ ν ∈ s, (LieAlgebra.ad ℂ L8 (SerreH i)) (f ν) from
              Finset.sum_congr rfl (fun ν _ => (LieAlgebra.ad_apply ℂ L8 (SerreH i) (f ν)).symm)]
        rw [show ⁅SerreH i, ∑ ν ∈ s, f ν⁆
            = (LieAlgebra.ad ℂ L8 (SerreH i)) (∑ ν ∈ s, f ν) from
              (LieAlgebra.ad_apply ℂ L8 (SerreH i) (∑ ν ∈ s, f ν)).symm]
        rw [map_sum]
      have hsum_ad2 : ⁅SerreH i, ∑ ν ∈ s, ⁅SerreH i, f ν⁆⁆
          = ∑ ν ∈ s, ⁅SerreH i, ⁅SerreH i, f ν⁆⁆ := by
        rw [show (∑ ν ∈ s, ⁅SerreH i, ⁅SerreH i, f ν⁆⁆)
            = ∑ ν ∈ s, (LieAlgebra.ad ℂ L8 (SerreH i)) (⁅SerreH i, f ν⁆) from
              Finset.sum_congr rfl
                (fun ν _ => (LieAlgebra.ad_apply ℂ L8 (SerreH i) ⁅SerreH i, f ν⁆).symm)]
        rw [show ⁅SerreH i, ∑ ν ∈ s, ⁅SerreH i, f ν⁆⁆
            = (LieAlgebra.ad ℂ L8 (SerreH i)) (∑ ν ∈ s, ⁅SerreH i, f ν⁆) from
              (LieAlgebra.ad_apply ℂ L8 (SerreH i) (∑ ν ∈ s, ⁅SerreH i, f ν⁆)).symm]
        rw [map_sum]
      have hcomp : ⁅SerreH i, ⁅SerreH i, x⁆⁆
          = ∑ ν ∈ s, (((ν i : ℤ) : ℂ) * ((ν i : ℤ) : ℂ)) • f ν := by
        rw [hsum, hsum_ad, hsum_ad2]
        exact Finset.sum_congr rfl step
      have h4 : (∑ ν ∈ s, (((ν i : ℤ) : ℂ) * ((ν i : ℤ) : ℂ)) • f ν) = 0 := by
        rw [← hcomp]; exact h3
      have hind := (iSupIndep_iff_finsetSum_eq_zero_imp_eq_zero e8W).mp e8W_iSupIndep
      have h5 := hind s (fun ν => (((ν i : ℤ) : ℂ) * ((ν i : ℤ) : ℂ)) • f ν)
        (fun ν hν => (e8W ν).smul_mem _ (hf ν hν)) h4 μ hμ
      have hne : (((μ i : ℤ) : ℂ) * ((μ i : ℤ) : ℂ)) ≠ 0 := by
        refine mul_ne_zero ?_ ?_ <;> exact_mod_cast hμi
      exact (smul_eq_zero.mp h5).resolve_left hne
    -- Hence every component with nonzero weight vanishes.
    have hzero : ∀ μ ∈ s, μ ≠ 0 → f μ = 0 := by
      intro μ hμ hμne
      obtain ⟨i, hi⟩ := Function.ne_iff.mp hμne
      exact key i μ hμ (by simpa using hi)
    rw [hsum]
    by_cases h0 : (0 : Fin 8 → ℤ) ∈ s
    · rw [Finset.sum_eq_single (0 : Fin 8 → ℤ)]
      · exact hf 0 h0
      · intro b hb hbne
        exact hzero b hb hbne
      · intro h; exact absurd h0 h
    · rw [Finset.sum_eq_zero]
      · exact Submodule.zero_mem _
      · intro b hb
        exact hzero b hb (by rintro rfl; exact h0 hb)

end

end Commons.Algebra.Lie.SerreConstruction
