import Mathlib.Algebra.Lie.Free
import Mathlib.Algebra.Lie.Ideal

namespace Commons.Algebra.Lie.FreeLieAlgebra

/-- The free Lie algebra is generated, as a Lie algebra, by its canonical generators `of R`.

Suggested proof (short!): let `A := LieSubmodule.lieSpan R (FreeLieAlgebra R X)
(Set.range (FreeLieAlgebra.of R))`, view `A` as a Lie algebra, let
`f : X → A := fun x => ⟨FreeLieAlgebra.of R x, LieSubmodule.subset_lieSpan _ (Set.mem_range_self x)⟩`
and `φ : FreeLieAlgebra R X →ₗ⁅R⁆ A := FreeLieAlgebra.lift R f`.  Then
`(A.incl : A →ₗ⁅R⁆ FreeLieAlgebra R X).comp φ = LieHom.id` by `FreeLieAlgebra.hom_ext`
(both sides send `of R x` to `of R x`), so every element of the free Lie algebra is in the image
of the inclusion of `A`, i.e. in `A`. -/
theorem lieSpan_range_of {R X : Type*} [CommRing R] :
    LieSubmodule.lieSpan R (FreeLieAlgebra R X)
      (Set.range (FreeLieAlgebra.of R : X → FreeLieAlgebra R X)) = ⊤ := by
  -- View the Lie submodule generated by the generators as a Lie ideal of the free Lie algebra.
  set A : LieIdeal R (FreeLieAlgebra R X) :=
    LieSubmodule.lieSpan R (FreeLieAlgebra R X)
      (Set.range (FreeLieAlgebra.of R : X → FreeLieAlgebra R X)) with hA
  -- The generators, regarded as elements of `A`.
  let f : X → A := fun x =>
    ⟨FreeLieAlgebra.of R x, by
      rw [hA]
      exact LieSubmodule.subset_lieSpan (Set.mem_range_self x)⟩
  -- The induced Lie algebra morphism out of the free Lie algebra.
  let φ : FreeLieAlgebra R X →ₗ⁅R⁆ A := FreeLieAlgebra.lift R f
  -- The inclusion of the Lie ideal `A`, viewed as a Lie algebra morphism.
  let ψ : A →ₗ⁅R⁆ FreeLieAlgebra R X := A.incl
  -- Both composites act as the identity on the generators, hence are equal by extensionality.
  have hcomp : ψ.comp φ = LieHom.id := by
    apply FreeLieAlgebra.hom_ext
    intro x
    simp [φ, ψ, f]
  -- Consequently every element of the free Lie algebra lies in `A`.
  have hgen : ∀ y : FreeLieAlgebra R X, y ∈ A := by
    intro y
    have h2 : ψ (φ y) = y := by
      have := LieHom.congr_fun hcomp y
      simpa using this
    rw [← h2]
    exact (φ y).property
  rw [hA]
  exact eq_top_iff.mpr fun x _ => hgen x

end Commons.Algebra.Lie.FreeLieAlgebra