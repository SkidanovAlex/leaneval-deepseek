import Mathlib
import Submission.Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota

namespace Commons.Algebra.Lie.UniversalEnveloping

attribute [local instance 100] LieRing.ofAssociativeRing

/-- For a Lie subalgebra `N ⊆ L`, the range of the algebra morphism `U(N) → U(L)` induced by the
inclusion is the subalgebra of `U(L)` generated by the images of the elements of `N`, i.e.
`Algebra.adjoin R (Set.range (fun x : N => ι R (x : L)))
  = (UniversalEnvelopingAlgebra.lift R ((ι R).comp (N.incl : N →ₗ⁅R⁆ L))).range`.

Recommended proof: `le_antisymm`.
* `≤` : `Algebra.adjoin_le_iff.mpr`, each generator `ι R (x : L)` equals
  `UniversalEnvelopingAlgebra.lift R f (ι R x)` (`lift_ι_apply`), hence lies in the range.
* `≥` : by `Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota` every element of
  `U(N)` is a polynomial in the `ι R y` (`y : N`); `lift R f` is an algebra map sending `ι R y`
  to `ι R (y : L)`, so its image lies in the adjoin. -/
theorem lift_incl_range {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
    (N : LieSubalgebra R L) :
    Algebra.adjoin R (Set.range (fun x : N => UniversalEnvelopingAlgebra.ι R (x : L)))
      = (UniversalEnvelopingAlgebra.lift R
          ((UniversalEnvelopingAlgebra.ι R).comp (N.incl : N →ₗ⁅R⁆ L))).range := by
  refine le_antisymm ?_ ?_
  · -- `≤`: each generator `ι R (x : L)` is the image of `ι R x` under the lift.
    rw [Algebra.adjoin_le_iff]
    rintro y ⟨x, rfl⟩
    exact (AlgHom.mem_range _).mpr
      ⟨UniversalEnvelopingAlgebra.ι R x, by
        rw [UniversalEnvelopingAlgebra.lift_ι_apply]; rfl⟩
  · -- `≥`: the image of the lift is contained in the adjoin, since `U(N)` is generated by the
    -- `ι R y` and the lift sends those into the generating set.
    intro y hy
    rw [AlgHom.mem_range] at hy
    obtain ⟨u, rfl⟩ := hy
    have htop : (Algebra.adjoin R
        (Set.range (fun x : N => UniversalEnvelopingAlgebra.ι R (x : L)))).comap
        (UniversalEnvelopingAlgebra.lift R
          ((UniversalEnvelopingAlgebra.ι R).comp (N.incl : N →ₗ⁅R⁆ L))) = ⊤ := by
      rw [eq_top_iff, ← Commons.RepresentationTheory.LieEnveloping.adjoin_range_iota
        (R := R) (L := N), Algebra.adjoin_le_iff]
      intro a ha
      refine (Subalgebra.mem_comap _ _ _).mpr ?_
      obtain ⟨x, rfl⟩ := ha
      rw [UniversalEnvelopingAlgebra.lift_ι_apply]
      exact Algebra.subset_adjoin ⟨x, rfl⟩
    have hu : u ∈ (Algebra.adjoin R
        (Set.range (fun x : N => UniversalEnvelopingAlgebra.ι R (x : L)))).comap
        (UniversalEnvelopingAlgebra.lift R
          ((UniversalEnvelopingAlgebra.ι R).comp (N.incl : N →ₗ⁅R⁆ L))) := by
      rw [htop]; trivial
    exact (Subalgebra.mem_comap _ _ _).mp hu

end Commons.Algebra.Lie.UniversalEnveloping
