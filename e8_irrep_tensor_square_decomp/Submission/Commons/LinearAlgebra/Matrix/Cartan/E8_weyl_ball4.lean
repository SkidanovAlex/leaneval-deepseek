/-! ## Equality check for vectors, and membership check for indices -/

private def eqV (a b : Fin 8 → ℤ) : Bool :=
  decide (a 0 = b 0) && decide (a 1 = b 1) && decide (a 2 = b 2) && decide (a 3 = b 3) &&
  decide (a 4 = b 4) && decide (a 5 = b 5) && decide (a 6 = b 6) && decide (a 7 = b 7)

private lemma eqV_eq_true_iff {a b : Fin 8 → ℤ} : eqV a b = true ↔ a = b := by
  simp only [eqV, Bool.and_eq_true, decide_eq_true_eq]
  constructor
  · rintro ⟨⟨⟨⟨⟨⟨⟨h0, h1⟩, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩
    funext j
    fin_cases j <;> assumption
  · intro h; subst h; simp

private def memFin (l : List (Fin 450)) (x : Fin 450) : Bool := l.any (fun y => decide (y = x))

private lemma memFin_eq_true_iff {l : List (Fin 450)} {x : Fin 450} : memFin l x = true ↔ x ∈ l := by
  simp only [memFin, List.any_eq_true, decide_eq_true_eq]
  constructor
  · rintro ⟨y, hy, rfl⟩; exact hy
  · intro h; exact ⟨x, h, rfl⟩

/-! ## The certified checks -/

private def chkM (a : Fin 450) (l : List (Fin 450)) : Bool :=
  (List.finRange 8).all (fun i =>
    eqV ((e8ball[e8nxt a i]).1) (sref i ((e8ball[a]).1)) && memFin l (e8nxt a i))

private def chk3 (a : Fin 450) : Bool :=
  (List.finRange 8).all (fun i => eqV ((e8ball[e8nxt a i]).1) (sref i ((e8ball[a]).1)))

private lemma chkM_val {a : Fin 450} {l : List (Fin 450)} (h : chkM a l = true) (i : Fin 8) :
    (e8ball[e8nxt a i]).1 = sref i ((e8ball[a]).1) := by
  simp only [chkM, List.all_eq_true] at h
  have hh := h i (List.mem_finRange i)
  rw [Bool.and_eq_true] at hh
  exact eqV_eq_true_iff.mp hh.1

private lemma chkM_mem {a : Fin 450} {l : List (Fin 450)} (h : chkM a l = true) (i : Fin 8) :
    e8nxt a i ∈ l := by
  simp only [chkM, List.all_eq_true] at h
  have hh := h i (List.mem_finRange i)
  rw [Bool.and_eq_true] at hh
  exact memFin_eq_true_iff.mp hh.2

private lemma chk3_val {a : Fin 450} (h : chk3 a = true) (i : Fin 8) :
    (e8ball[e8nxt a i]).1 = sref i ((e8ball[a]).1) := by
  simp only [chk3, List.all_eq_true] at h
  exact eqV_eq_true_iff.mp (h i (List.mem_finRange i))


