/-! ## The `L`-indexed results -/

private lemma ball_aux : ∀ L : List (Fin 8),
    (L.length ≤ 0 → ∃ a : Fin 450, a ∈ idx0 ∧ (e8ball[a]).1 = wact L rhoZ) ∧
    (L.length ≤ 1 → ∃ a : Fin 450, a ∈ idx1 ∧ (e8ball[a]).1 = wact L rhoZ) ∧
    (L.length ≤ 2 → ∃ a : Fin 450, a ∈ idx2 ∧ (e8ball[a]).1 = wact L rhoZ) ∧
    (L.length ≤ 3 → ∃ a : Fin 450, a ∈ idx3 ∧ (e8ball[a]).1 = wact L rhoZ) ∧
    (L.length ≤ 4 → ∃ a : Fin 450, (e8ball[a]).1 = wact L rhoZ) := by
  intro L
  induction L using List.reverseRecOn with
  | nil =>
      have hz0 : (195 : Fin 450) ∈ idx0 := by decide
      have hz1 : (195 : Fin 450) ∈ idx1 := by decide
      have hz2 : (195 : Fin 450) ∈ idx2 := by decide
      have hz3 : (195 : Fin 450) ∈ idx3 := by decide
      have hzv : (e8ball[(195 : Fin 450)]).1 = rhoZ := by decide
      exact ⟨fun _ => ⟨195, hz0, by simpa using hzv⟩,
             fun _ => ⟨195, hz1, by simpa using hzv⟩,
             fun _ => ⟨195, hz2, by simpa using hzv⟩,
             fun _ => ⟨195, hz3, by simpa using hzv⟩,
             fun _ => ⟨195, by simpa using hzv⟩⟩
  | append_singleton L' i ih =>
      have hlen : (L' ++ [i]).length = L'.length + 1 := by simp
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · intro h; omega
      · intro h
        have h' : L'.length ≤ 0 := by omega
        obtain ⟨a, ha, hval⟩ := ih.1 h'
        have hc : chkM a idx1 = true := List.all_eq_true.mp h0 a ha
        exact ⟨e8nxt a i, chkM_mem hc i,
          by rw [chkM_val hc i, hval, wact_append, wact_singleton]⟩
      · intro h
        have h' : L'.length ≤ 1 := by omega
        obtain ⟨a, ha, hval⟩ := ih.2.1 h'
        have hc : chkM a idx2 = true := List.all_eq_true.mp h1 a ha
        exact ⟨e8nxt a i, chkM_mem hc i,
          by rw [chkM_val hc i, hval, wact_append, wact_singleton]⟩
      · intro h
        have h' : L'.length ≤ 2 := by omega
        obtain ⟨a, ha, hval⟩ := ih.2.2.1 h'
        have hc : chkM a idx3 = true := List.all_eq_true.mp h2 a ha
        exact ⟨e8nxt a i, chkM_mem hc i,
          by rw [chkM_val hc i, hval, wact_append, wact_singleton]⟩
      · intro h
        have h' : L'.length ≤ 3 := by omega
        obtain ⟨a, ha, hval⟩ := ih.2.2.2.1 h'
        have hc : chk3 a = true := List.all_eq_true.mp h3 a ha
        exact ⟨e8nxt a i,
          by rw [chk3_val hc i, hval, wact_append, wact_singleton]⟩

private lemma wact_mem (L : List (Fin 8)) (h : L.length ≤ 4) :
    ∃ a : Fin 450, (e8ball[a]).1 = wact L rhoZ :=
  (ball_aux L).2.2.2.2 h

/-! ## The pointwise property of the list -/

private lemma e8ball_prop_all :
    e8ball.all (fun p => decide (p.2.length ≤ 4) && eqV (wact p.2 rhoZ) p.1) = true := by
  decide

private lemma e8ball_prop : ∀ p ∈ e8ball, p.2.length ≤ 4 ∧ wact p.2 rhoZ = p.1 := by
  intro p hp
  have h := List.all_eq_true.mp e8ball_prop_all p hp
  rw [Bool.and_eq_true] at h
  exact ⟨of_decide_eq_true h.1, eqV_eq_true_iff.mp h.2⟩

/-! ## The values of the list are pairwise distinct -/

/-- A mixed-radix encoding of a vector whose entries lie in `[-4, 5]`. -/
private def enc (v : Fin 8 → ℤ) : ℕ :=
  (v 0 + 4).toNat * 10000000 + (v 1 + 4).toNat * 1000000 + (v 2 + 4).toNat * 100000 +
  (v 3 + 4).toNat * 10000 + (v 4 + 4).toNat * 1000 + (v 5 + 4).toNat * 100 +
  (v 6 + 4).toNat * 10 + (v 7 + 4).toNat

/-- `incrB l` is `true` iff `l` is strictly increasing. -/
private def incrB (l : List ℕ) : Bool :=
  match l with
  | [] => true
  | [_] => true
  | a :: b :: l => (a < b) && incrB (b :: l)

private lemma pairwise_lt_of_incrB : ∀ l : List ℕ, incrB l = true → l.Pairwise (· < ·) := by
  intro l
  induction l with
  | nil => intro _; exact List.Pairwise.nil
  | cons a t ih =>
      cases t with
      | nil => intro _; exact List.Pairwise.cons (by simp) List.Pairwise.nil
      | cons b t' =>
          intro h
          simp only [incrB] at h
          rw [Bool.and_eq_true] at h
          have ih' := ih h.2
          rw [List.pairwise_cons] at ih'
          rw [List.pairwise_cons]
          refine ⟨?_, List.Pairwise.cons ih'.1 ih'.2⟩
          intro c hc
          rcases List.mem_cons.mp hc with rfl | hc
          · exact of_decide_eq_true h.1
          · exact Nat.lt_trans (of_decide_eq_true h.1) (ih'.1 c hc)

private lemma e8ball_nodup_chk : incrB ((e8ball.map Prod.fst).map enc) = true := by decide

private lemma e8ball_nodup : (e8ball.map Prod.fst).Nodup :=
  List.Nodup.of_map enc (List.Pairwise.nodup (pairwise_lt_of_incrB _ e8ball_nodup_chk))

/-! ## The main theorem -/

/-- The Weyl group elements of `E₈` of length at most `4`, as an explicit certified list.

`ballp` is a list of pairs `(v, L)` where `L` is a word in the simple reflections with
`L.length ≤ 4` and `v = wact L rhoZ`; the first components are pairwise distinct, there are exactly
`450` of them, and every word of length `≤ 4` occurs:

  `v ∈ ballp.map Prod.fst ↔ ∃ L : List (Fin 8), L.length ≤ 4 ∧ wact L rhoZ = v`.

Since `rhoZ` is regular, `wact L rhoZ = wact L' rhoZ` forces `wact L = wact L'`, and since the
parity of a word is well defined on the element (`E8_wact_sign`) the sign `(-1)^{L.length}` is the
sign `ε(w)` of the element.  Hence `∑_{(v,L) ∈ ballp} (-1)^{L.length} · f v` is the sum of `f` over
the elements of length `≤ 4` of `W(E₈)`, each once. -/
theorem E8_weyl_ball4 :
    ∃ ballp : List ((Fin 8 → ℤ) × List (Fin 8)),
      ballp.length = 450 ∧
      (∀ p ∈ ballp, p.2.length ≤ 4 ∧ wact p.2 rhoZ = p.1) ∧
      (ballp.map Prod.fst).Nodup ∧
      (∀ v : Fin 8 → ℤ,
        v ∈ ballp.map Prod.fst ↔ ∃ L : List (Fin 8), L.length ≤ 4 ∧ wact L rhoZ = v) := by
  refine ⟨e8ball, by decide, e8ball_prop, e8ball_nodup, ?_⟩
  intro v
  constructor
  · intro hv
    obtain ⟨p, hp, hpv⟩ := List.mem_map.mp hv
    obtain ⟨h1, h2⟩ := e8ball_prop p hp
    exact ⟨p.2, h1, h2.trans hpv⟩
  · rintro ⟨L, hL, rfl⟩
    obtain ⟨a, hval⟩ := wact_mem L hL
    exact List.mem_map.mpr ⟨e8ball[a], List.get_mem e8ball _, hval⟩

