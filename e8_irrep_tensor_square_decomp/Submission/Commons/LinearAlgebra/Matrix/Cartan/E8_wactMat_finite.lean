import Mathlib
import Submission.Commons.LinearAlgebra.Matrix.Cartan.E8_wact_sign
import Submission.Commons.LinearAlgebra.Matrix.Cartan.E8_posDef

namespace Commons.LinearAlgebra.Matrix.Cartan

/-!
# The Weyl group of `E₈` is finite

The Weyl group of `E₈` is generated by the eight simple reflections `sref i`, which act on the
weight lattice `ℤ⁸` (written in the fundamental-weight basis).  The set of matrices of the
elements `wact L`, i.e. of products of simple reflections, is finite.

The proof does *not* enumerate the group: it shows that the matrices obtained are determined by
their values on the eight simple roots `α i`, and that those values always lie in the finite set of
roots `{v | qZ v = 2}`.  Indeed `qZ` (the squared length for the Cartan form `A⁻¹`) is invariant
under `wact`, while `qZ (α i) = 2`; and by positive definiteness of the `E₈` Cartan matrix every
vector of squared length `2` has all coordinates bounded by `2` (`E8NormTwo.sq_le_four`).  Since
the simple roots form a `ℤ`-basis of `ℤ⁸` (the Cartan matrix is unimodular), a `ℤ`-linear map is
determined by its values on them.
-/

/-- The squared length `qZ` is invariant under the Weyl-group action. -/
lemma E8_wactMat_finite_qZ_wact (L : List (Fin 8)) (v : Fin 8 → ℤ) :
    E8NormTwo.qZ (wact L v) = E8NormTwo.qZ v := by
  rw [qZ_eq_bil, qZ_eq_bil, bil_wact]

/-- The simple roots have squared length `2`. -/
lemma E8_wactMat_finite_qZ_alpha (i : Fin 8) : E8NormTwo.qZ (alpha i) = 2 := by
  rw [qZ_eq_bil, bil_apply, E8m_diag]

/-- A standard basis vector of `ℤ⁸`, written as a `ℤ`-linear combination of the simple roots. -/
lemma E8_wactMat_finite_single_eq_sum_alpha (b : Fin 8) :
    (Pi.single b (1 : ℤ) : Fin 8 → ℤ) = ∑ i, E8i i b • alpha i := by
  conv_lhs => rw [← mulVec_coords (Pi.single b (1 : ℤ) : Fin 8 → ℤ)]
  rw [mulVec_eq_sum]
  refine Finset.sum_congr rfl (fun i _ => ?_)
  have h : coords (Pi.single b (1 : ℤ) : Fin 8 → ℤ) i = E8i i b := by
    rw [coords, Matrix.mulVec_single_one]
    rfl
  rw [h]

/-- The columns of `wactMat L` are determined by the images of the simple roots. -/
lemma E8_wactMat_finite_wactMat_eq_sum (L : List (Fin 8)) (a b : Fin 8) :
    wactMat L a b = ∑ i, E8i i b * wact L (alpha i) a := by
  change wact L (Pi.single b (1 : ℤ)) a = ∑ i, E8i i b * wact L (alpha i) a
  rw [E8_wactMat_finite_single_eq_sum_alpha b, wact_sum_smul]
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

/-- **The Weyl group of `E₈` is finite.**  The set of matrices of the elements `wact L` (words of
simple reflections acting on weights in the fundamental-weight basis) is finite.  Equivalent
statement: the number of endomorphisms of `ℤ⁸` obtained as products of the simple reflections
`sref i` is finite. -/
theorem E8_wactMat_finite :
    (Set.range (fun L : List (Fin 8) => Commons.LinearAlgebra.Matrix.Cartan.wactMat L)).Finite := by
  -- every integer with `x ^ 2 ≤ 4` is bounded, so the set of such is finite
  have hb0 : ({x : ℤ | x ^ 2 ≤ 4}).Finite := by
    refine (Finset.finite_toSet (Finset.Icc (-2 : ℤ) 2)).subset ?_
    intro x hx
    simp only [Set.mem_ofPred_eq] at hx
    simp only [Finset.mem_coe, Finset.mem_Icc]
    constructor <;> nlinarith [sq_nonneg (x - 2), sq_nonneg (x + 2)]
  -- the set of vectors with all coordinates bounded by `2`
  have hB : ({v : Fin 8 → ℤ | ∀ j, (v j) ^ 2 ≤ 4}).Finite :=
    Set.Finite.pi' (fun _ : Fin 8 => hb0)
  -- the tuples of images of the simple roots range in a finite set
  have hrange : (Set.range (fun L : List (Fin 8) => fun i : Fin 8 => wact L (alpha i))).Finite := by
    refine (Set.Finite.pi' (fun _ : Fin 8 => hB)).subset ?_
    rintro g ⟨L, rfl⟩
    intro i
    exact fun j => E8NormTwo.sq_le_four (wact L (alpha i))
      (by rw [E8_wactMat_finite_qZ_wact, E8_wactMat_finite_qZ_alpha]) j
  -- the matrix is a function of that tuple
  refine (hrange.image (fun g : Fin 8 → (Fin 8 → ℤ) =>
    fun a b => ∑ i, E8i i b * g i a)).subset ?_
  rintro M ⟨L, rfl⟩
  refine ⟨fun i => wact L (alpha i), ⟨L, rfl⟩, ?_⟩
  ext a b
  exact (E8_wactMat_finite_wactMat_eq_sum L a b).symm

end Commons.LinearAlgebra.Matrix.Cartan
