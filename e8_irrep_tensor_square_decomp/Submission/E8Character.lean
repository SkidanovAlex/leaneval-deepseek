import Submission.E8Casimir
import Submission.WeylReflect
import Submission.WeylWeights
import Submission.Commons.LinearAlgebra.Matrix.Cartan.E8_norm_two_conj_simple
import Submission.Commons.Algebra.Lie.SerreConstruction.no_dominant_singular_weight

/-!
# The weight lattice combinatorics for the character theory of `e₈`

This file develops, on top of `Submission.WeylWeights` (`sref`, `form`, `IsDominant`, …) and
`Submission.WeylReflect` (`negCount`, `dominant_of_negCount_zero`, `exists_dominant_WConj`), the
combinatorial devices used by the Freudenthal uniqueness theorem:

* the positive cone `posCon γ` (`γ ∈ ℕΦ⁺`, i.e. `γ = ∑ nᵢ αᵢ` with `nᵢ ≥ 0`), tested with the
  *integral* inverse Cartan matrix `E8inv` (so that `decide` can evaluate it);
* the height `htOf γ = ∑ᵢ (A⁻¹γ)ᵢ = ⟪γ, ρ⟫`, additive and positive on the cone;
* the **dominant conjugate** `dc v`, the output of the "reflect at a negative coordinate until
  dominant" algorithm, with the crucial easy facts `dc v - v ∈ ℕΦ⁺` (each step *adds* a positive
  multiple of a positive root) and `dc (dc v) = dc v`, together with an explicit list of simple
  reflections (`dcList v`) realizing the move.

The last point is what lets the Freudenthal uniqueness theorem avoid *generating the Weyl group*:
`m (dc v) = m v` follows by iterating the `𝔰𝔩₂` statement `m (sᵢ v) = m v` along the list
`dcList v`.

## The main theorem of this file

`eq_of_freudenthal`: **two functions `m, m' : (Fin 8 → ℤ) → ℚ` satisfying**

* `m lam = m' lam = 1` (`ha`, `ha'`),
* the support bound `lam - v = 0 ∨ posCon (lam - v)` whenever `m v ≠ 0` (`hb`, `hb'`),
* invariance under the dominant conjugate `m (dc v) = m v` (`hc`, `hc'`),
* **Freudenthal's recursion on the dominant weights**
  `(Bint lam - Bint ν) * m ν = 2 * ∑_{α>0} ∑_{k≥1} ⟪ν+kα, α∨⟫ * m (ν + k α)`
  (truncated at `k = (htOf (lam - ν)).toNat`, which is where the summands start vanishing)
  for every dominant `ν ≠ lam` in the support cone (`hd`, `hd'`),

**agree everywhere** (`∀ v, m v = m' v`).  The proof is a strong induction on the height
`htOf (lam - ν)` over dominant weights, with the two inputs

* the **Key Lemma** `no_dominant_singular_weight'` (a dominant weight strictly below `lam` in the
  cone order is off the Casimir sphere `Bint = Bint lam`), which makes the recursion's coefficient
  non-zero, and
* the `dc`-invariance `hc`, `hc'`, which takes care of the *singular* weights (the steps where the
  recursion is vacuous).

Since the coefficient is `≠ 0`, the recursion determines `m ν` from the values at the strictly
higher weights `ν + k α`, and those are handled by `hc` (`δ (η) = δ (dc η)`) together with the
support bound: for `dc η` either `lam - dc η = 0` (then the value is `1` by `ha`) or
`lam - dc η ∈ ℕΦ⁺`, and then `htOf (lam - dc η) = htOf (lam - η) - htOf (dc η - η) < n`
(using `dc_sub_posCon`), so the induction applies; if `lam - dc η ∉ ℕΦ⁺ ∪ {0}` both `m` and `m'`
vanish there by the support bound.  The map `v ↦ dc v` then handles arbitrary weights, because
`dc` lands in the dominant chamber and `lam - dc v ∈ ℕΦ⁺ ∪ {0}` whenever `v` is in the support.

## What remains (for the next session)

To apply `eq_of_freudenthal` to `L(ω₁+ω₈)` one has to produce the hypotheses for the *actual*
multiplicities:

* `ha`, `hb` — easy (the `λ`-weight space of the Verma module is one-dimensional, and every weight
  of a highest weight module is `λ - ∑ nᵢαᵢ`);
* `hd` — the **Freudenthal trace argument** for a Lie module over `e₈` with finite-dimensional
  weight spaces and `Ω` acting by the scalar `(λ, λ+2ρ)_κ`; this needs no finiteness of the module
  and is the "mechanical" half of the proof (see the roadmap docstring in `Submission.lean`);
* `hc` — **`W`-invariance of the multiplicities**, which is the genuinely missing mathematical
  input.  The elementary route is:
  1. every weight vector `u` spans a *finite-dimensional* `𝔰𝔩₂`-module under `(SerreH i, SerreE i,
     SerreF i)`: this needs `eᵢ` locally nilpotent (automatic: `eᵢ^a u = 0` once `λ - wt u - aαᵢ`
     leaves the cone `ℕΦ⁺`) and `fᵢ^{λᵢ+1} = 0` on `L(λ)`;
  2. the latter is the **integrability relation** `fᵢ^{λᵢ+1} • vbar = 0`, which follows from the
     elementary argument: `uᵢ := fᵢ^{λᵢ+1} v` is killed by every `SerreE j` (for `j ≠ i` by
     `[e_j, f_i] = 0`, for `j = i` by the `𝔰𝔩₂` computation `e f^{λ_i+1} v = 0`), so the
     submodule it generates is a highest weight module of highest weight
     `μᵢ = λ - (λᵢ+1)αᵢ`; its weights are `⪯ μᵢ`, so it does not contain the highest weight
     vector `v` (whose weight `λ` is *above* `μᵢ`), so it is proper, so it lies in the maximal
     submodule `N`, so `uᵢ ∈ N`, so `fᵢ^{λᵢ+1}` acts by `0` on `L(λ) = V/N` (by commutativity,
     since `L(λ)` is generated by `v`);
  3. applying `Commons.LinearAlgebra.End.sl2_eigenspace_finrank_symm` to the `𝔰𝔩₂`-module spanned
     by a *finite* piece of the `αᵢ`-string (finite once the support is known to be finite, which
     follows immediately from step 1 + the bound `supp ⊆ λ - ℕΦ⁺`) gives
     `dim M_ν = dim M_{sᵢν}`.
  The only place in step 2 that needs care is the weight bound `weights of U(g)·uᵢ ⪯ μᵢ`, which is
  the standard "cyclic module generated by a primitive vector = highest weight module" statement
  (`U(g) = U(n⁻)U(b)` by PBW, `U(b)uᵢ = ℂuᵢ`).
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
set_option linter.unusedSimpArgs false

open scoped BigOperators Matrix

namespace Submission.E8Character

open Submission.WeylRoots Submission.WeylReflect Submission.WeylWeights
open Submission.E8Casimir

/-- The `E₈` Cartan matrix. -/
abbrev E8 : Matrix (Fin 8) (Fin 8) ℤ := CartanMatrix.E₈

/-- The integral inverse of the `E₈` Cartan matrix. -/
abbrev E8inv : Matrix (Fin 8) (Fin 8) ℤ := Commons.LinearAlgebra.Matrix.Cartan.E8NormTwo.E8inv

lemma E8_mul_E8inv : E8 * E8inv = 1 := by decide

/-- The coordinates of a weight in the *simple root* basis: `(A⁻¹ γ)ᵢ`. -/
def coords (γ : Fin 8 → ℤ) : Fin 8 → ℤ := fun i => ∑ j, E8inv i j * γ j

/-- `γ` lies in the positive cone `ℕΦ⁺`: all its simple-root coordinates are nonnegative. -/
def posCon (γ : Fin 8 → ℤ) : Prop := ∀ i, 0 ≤ coords γ i

/-- The height `htOf γ = ∑ᵢ (A⁻¹γ)ᵢ = ⟪γ, ρ⟫`. -/
def htOf (γ : Fin 8 → ℤ) : ℤ := ∑ i, coords γ i

lemma coords_eq (γ : Fin 8 → ℤ) : coords γ = E8inv *ᵥ γ := rfl

lemma coords_mulVec (n : Fin 8 → ℤ) : coords (E8 *ᵥ n) = n := by
  have h : E8inv *ᵥ (E8 *ᵥ n) = (E8inv * E8) *ᵥ n := Matrix.mulVec_mulVec n E8inv E8
  change E8inv *ᵥ (E8 *ᵥ n) = n
  rw [h, Commons.LinearAlgebra.Matrix.Cartan.E8NormTwo.E8inv_mul_E8, Matrix.one_mulVec]

lemma mulVec_coords (γ : Fin 8 → ℤ) : E8 *ᵥ coords γ = γ := by
  have h : E8 *ᵥ (E8inv *ᵥ γ) = (E8 * E8inv) *ᵥ γ := Matrix.mulVec_mulVec γ E8 E8inv
  change E8 *ᵥ (E8inv *ᵥ γ) = γ
  rw [h, E8_mul_E8inv, Matrix.one_mulVec]

lemma htOf_eq (γ : Fin 8 → ℤ) : htOf γ = ∑ i, ∑ j, E8inv i j * γ j := rfl

lemma coords_add (γ δ : Fin 8 → ℤ) : coords (γ + δ) = coords γ + coords δ := by
  rw [coords_eq, coords_eq, coords_eq, Matrix.mulVec_add]

lemma posCon_add {γ δ : Fin 8 → ℤ} (hγ : posCon γ) (hδ : posCon δ) : posCon (γ + δ) := by
  intro i
  rw [coords_add]
  exact add_nonneg (hγ i) (hδ i)

lemma posCon_zero : posCon (0 : Fin 8 → ℤ) := by
  intro i
  simp [posCon, coords]

lemma htOf_add (γ δ : Fin 8 → ℤ) : htOf (γ + δ) = htOf γ + htOf δ := by
  simp only [htOf_eq, Pi.add_apply, mul_add, Finset.sum_add_distrib]

lemma htOf_nonneg {γ : Fin 8 → ℤ} (h : posCon γ) : 0 ≤ htOf γ :=
  Finset.sum_nonneg fun i _ => h i

lemma htOf_pos {γ : Fin 8 → ℤ} (h : posCon γ) (hne : γ ≠ 0) : 0 < htOf γ := by
  have hc : coords γ ≠ 0 := by
    intro h0
    exact hne (by rw [← mulVec_coords γ, h0, Matrix.mulVec_zero])
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hc
  have hpos : 0 < coords γ i := lt_of_le_of_ne (h i) (Ne.symm hi)
  exact Finset.sum_pos' (fun i _ => h i) ⟨i, Finset.mem_univ i, hpos⟩

/-- The simple root `αᵢ` in `ω`-coordinates (the `i`-th row of the Cartan matrix). -/
def alpha (i : Fin 8) : Fin 8 → ℤ := fun j => E8 i j

lemma alpha_eq (i : Fin 8) : alpha i = E8 *ᵥ (Pi.single i 1) := by
  rw [Matrix.mulVec_single_one]
  funext j
  simp [alpha, E8, E8_symm]

lemma posCon_alpha (i : Fin 8) : posCon (alpha i) := by
  rw [posCon]
  intro j
  rw [alpha_eq, coords_mulVec]
  simp only [Pi.single_apply]
  split <;> norm_num

lemma htOf_alpha (i : Fin 8) : htOf (alpha i) = 1 := by
  rw [htOf, alpha_eq, coords_mulVec, Finset.sum_eq_single i]
  · simp
  · intro b _ hb; simp [Pi.single_eq_of_ne hb]
  · intro h; exact absurd (Finset.mem_univ i) h

/-- `posCon γ` expressed with a natural-number vector. -/
theorem posCon_iff_exists (γ : Fin 8 → ℤ) :
    posCon γ ↔ ∃ n : Fin 8 → ℕ, γ = E8 *ᵥ (fun i => (n i : ℤ)) := by
  constructor
  · intro h
    refine ⟨fun i => (coords γ i).toNat, ?_⟩
    have h1 : (fun i => ((coords γ i).toNat : ℤ)) = coords γ :=
      funext fun i => Int.toNat_of_nonneg (h i)
    rw [h1, mulVec_coords]
  · rintro ⟨n, rfl⟩
    rw [posCon, coords_mulVec]
    intro i
    exact Int.natCast_nonneg _

lemma htOf_mulVec (n : Fin 8 → ℤ) : htOf (E8 *ᵥ n) = ∑ i, n i := by
  simp only [htOf, coords_mulVec]

/-! ## The dominant conjugate -/

/-- The positive roots, in `d`-coordinates, have nonnegative entries. -/
lemma posRootsD_all_nonneg : posRootsD.all (fun d => decide (∀ j, 0 ≤ d j)) = true := by
  decide

lemma mem_PD_nonneg {d : Fin 8 → ℤ} (hd : d ∈ PD) : ∀ j, 0 ≤ d j := by
  have h1 : d ∈ posRootsD := by simpa [PD] using hd
  have h2 := List.all_eq_true.mp posRootsD_all_nonneg
  exact of_decide_eq_true (h2 d h1)

lemma pair_nonneg_of_dominant {v : Fin 8 → ℤ} (h : Dominant v) {d : Fin 8 → ℤ} (hd : d ∈ PD) :
    0 ≤ pair v d :=
  Finset.sum_nonneg fun j _ => mul_nonneg (h j) (mem_PD_nonneg hd j)

/-- A dominant weight has no negatively paired positive root. -/
lemma negCount_eq_zero_of_dominant {v : Fin 8 → ℤ} (h : Dominant v) : negCount v = 0 := by
  rw [negCount, Finset.card_eq_zero, Finset.filter_eq_empty_iff]
  intro d hd
  exact not_lt.mpr (pair_nonneg_of_dominant h hd)

/-- A *computable* choice of a negative coordinate of a weight (needed because the certification
of the characters is done by kernel computation: `classical` choice would make `dc` noncomputable).
The proof argument is erased, so this is a genuine algorithm. -/
def pickNeg (v : Fin 8 → ℤ) (h : ∃ i, v i < 0) : Fin 8 :=
  (Finset.univ.filter (fun i => v i < 0)).min' (by
    obtain ⟨i, hi⟩ := h
    exact ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩⟩)

lemma pickNeg_spec (v : Fin 8 → ℤ) (h : ∃ i, v i < 0) : v (pickNeg v h) < 0 := by
  have hmem : pickNeg v h ∈ Finset.univ.filter (fun i => v i < 0) := Finset.min'_mem _ _
  exact (Finset.mem_filter.mp hmem).2

/-- The list of simple reflections produced by the "reflect at a negative coordinate until
dominant" algorithm. -/
def dcListAux : ℕ → (Fin 8 → ℤ) → List (Fin 8)
  | 0, _ => []
  | n + 1, v => if h : ∃ i, v i < 0 then pickNeg v h :: dcListAux n (sref (pickNeg v h) v) else []

/-- The list of simple reflections taking a weight into the dominant chamber. -/
def dcList (v : Fin 8 → ℤ) : List (Fin 8) := dcListAux (negCount v) v

/-- The **dominant conjugate** of a weight: the result of running the reflection algorithm. -/
def dc (v : Fin 8 → ℤ) : Fin 8 → ℤ := (dcList v).foldl (fun w i => sref i w) v

lemma foldl_step (L : List (Fin 8)) (v : Fin 8 → ℤ) (i : Fin 8) :
    (i :: L).foldl (fun w j => sref j w) v = L.foldl (fun w j => sref j w) (sref i v) := rfl

lemma dcListAux_eq_nil_of_dominant {v : Fin 8 → ℤ} (h : Dominant v) (n : ℕ) :
    dcListAux n v = [] := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [dcListAux]
    rw [dif_neg]
    exact fun ⟨i, hi⟩ => absurd (h i) (not_le.mpr hi)

lemma dcList_eq_nil_of_dominant {v : Fin 8 → ℤ} (h : Dominant v) : dcList v = [] :=
  dcListAux_eq_nil_of_dominant h _

lemma dc_eq_self_of_dominant {v : Fin 8 → ℤ} (h : Dominant v) : dc v = v := by
  rw [dc, dcList_eq_nil_of_dominant h]; rfl

/-- Each step of the algorithm decreases `negCount` by one. -/
lemma negCount_sref_lt {v : Fin 8 → ℤ} (h : ∃ i, v i < 0) :
    negCount (sref (pickNeg v h) v) < negCount v := by
  rw [negCount_sref _ _ (pickNeg_spec v h)]
  exact Nat.sub_lt (Finset.card_pos.mpr ⟨e (pickNeg v h), by
    rw [Finset.mem_filter]
    exact ⟨e_mem_PD (pickNeg v h), by rw [pair_e]; exact pickNeg_spec v h⟩⟩) Nat.one_pos

/-- The dominant conjugate is reachable from the weight by simple reflections. -/
theorem dc_mem_WConj (v : Fin 8 → ℤ) : WConj v (dc v) := ⟨dcList v, rfl⟩

/-- The dominant conjugate is dominant. -/
theorem dc_dominant (v : Fin 8 → ℤ) : Dominant (dc v) := by
  suffices H : ∀ n, ∀ v : Fin 8 → ℤ, negCount v ≤ n →
      Dominant ((dcListAux n v).foldl (fun w i => sref i w) v) from
    H _ v le_rfl
  intro n
  induction n with
  | zero =>
    intro v hv
    have h0 : negCount v = 0 := Nat.le_zero.mp hv
    exact dominant_of_negCount_zero h0
  | succ n ih =>
    intro v hv
    by_cases h : ∃ i, v i < 0
    · rw [dcListAux, dif_pos h, foldl_step]
      have h1 : negCount (sref (pickNeg v h) v) < negCount v := negCount_sref_lt h
      exact ih _ (Nat.lt_succ_iff.mp (lt_of_lt_of_le h1 hv))
    · simp only [not_exists, not_lt] at h
      rw [dcListAux, dif_neg (by simpa using h)]
      exact h

lemma coords_smul (k : ℤ) (γ : Fin 8 → ℤ) : coords (k • γ) = k • coords γ := by
  rw [coords_eq, coords_eq, Matrix.mulVec_smul]

lemma posCon_smul_nonneg {k : ℤ} (hk : 0 ≤ k) {γ : Fin 8 → ℤ} (h : posCon γ) :
    posCon (k • γ) := by
  intro i
  rw [coords_smul]
  exact mul_nonneg hk (h i)

/-- A single reflection at a negative coordinate increases the weight by a positive multiple of a
simple root. -/
lemma sref_sub_posCon {v : Fin 8 → ℤ} {i : Fin 8} (hi : v i < 0) :
    posCon (sref i v - v) := by
  have h : sref i v - v = (-v i) • alpha i := by
    funext j
    simp only [sref_apply, alpha, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Int.cast_id]
    ring
  rw [h]
  exact posCon_smul_nonneg (by omega) (posCon_alpha i)

/-- **The dominant conjugate lies above the weight in the dominance order**: `dc v - v ∈ ℕΦ⁺`. -/
theorem dc_sub_posCon (v : Fin 8 → ℤ) : posCon (dc v - v) := by
  suffices H : ∀ n, ∀ v : Fin 8 → ℤ, negCount v ≤ n →
      posCon ((dcListAux n v).foldl (fun w i => sref i w) v - v) from H _ v le_rfl
  intro n
  induction n with
  | zero =>
    intro v hv
    have h0 : negCount v = 0 := Nat.le_zero.mp hv
    change posCon (v - v)
    rw [sub_self]
    exact posCon_zero
  | succ n ih =>
    intro v hv
    by_cases h : ∃ i, v i < 0
    · rw [dcListAux, dif_pos h, foldl_step]
      have hlt : negCount (sref (pickNeg v h) v) ≤ n := by
        have h1 : negCount (sref (pickNeg v h) v) < negCount v := negCount_sref_lt h
        exact Nat.lt_succ_iff.mp (lt_of_lt_of_le h1 hv)
      have hsplit : (dcListAux n (sref (pickNeg v h) v)).foldl (fun w i => sref i w) (sref (pickNeg v h) v) - v
          = ((dcListAux n (sref (pickNeg v h) v)).foldl (fun w i => sref i w) (sref (pickNeg v h) v)
              - sref (pickNeg v h) v) + (sref (pickNeg v h) v - v) := by abel
      rw [hsplit]
      exact posCon_add (ih _ hlt) (sref_sub_posCon (pickNeg_spec v h))
    · simp only [not_exists, not_lt] at h
      rw [dcListAux, dif_neg (by simpa using h)]
      change posCon (v - v)
      rw [sub_self]
      exact posCon_zero

lemma htOf_dc_le (v : Fin 8 → ℤ) : htOf v ≤ htOf (dc v) := by
  have h := dc_sub_posCon v
  have h1 : htOf (dc v) = htOf v + htOf (dc v - v) := by
    conv_lhs => rw [← sub_add_cancel (dc v) v]
    rw [htOf_add]; ring
  rw [h1]
  linarith [htOf_nonneg h]

lemma htOf_dc_eq_iff (v : Fin 8 → ℤ) : htOf (dc v) = htOf v ↔ dc v = v := by
  constructor
  · intro h
    have h1 : htOf (dc v) = htOf v + htOf (dc v - v) := by
      conv_lhs => rw [← sub_add_cancel (dc v) v]
      rw [htOf_add]; ring
    have hz : htOf (dc v - v) = 0 := by omega
    by_contra hne
    exact absurd hz (ne_of_gt (htOf_pos (dc_sub_posCon v) (sub_ne_zero.mpr hne)))
  · intro h; rw [h]

lemma dc_idem (v : Fin 8 → ℤ) : dc (dc v) = dc v :=
  dc_eq_self_of_dominant (dc_dominant v)

/-! ## The Casimir sphere, the brackets, and the Freudenthal uniqueness theorem -/

/-- The Casimir sphere function `B ν = ⟪ν+ρ, ν+ρ⟫` (integral for `E₈`). -/
def Bint (ν : Fin 8 → ℤ) : ℤ := ∑ i, ∑ j, (ν i + 1) * E8inv i j * (ν j + 1)

lemma Bint_cast (ν : Fin 8 → ℤ) :
    ((Bint ν : ℤ) : ℚ)
      = ∑ i, ∑ j, (ν i + 1 : ℚ)
          * ((CartanMatrix.E₈.map (Int.castRingHom ℚ))⁻¹) i j * (ν j + 1 : ℚ) := by
  rw [Bint, Commons.LinearAlgebra.Matrix.Cartan.E8NormTwo.E8q_inv]
  push_cast
  apply Finset.sum_congr rfl; intro i _
  apply Finset.sum_congr rfl; intro j _
  simp only [Matrix.map_apply, Int.coe_castRingHom]

/-- **Key lemma**: a dominant weight strictly below `lam` (in the cone order) is not on the
Casimir sphere of `lam`. -/
theorem no_dominant_singular_weight' {lam nu : Fin 8 → ℤ} (hl : Dominant lam) (hn : Dominant nu)
    (hmu : ∃ n : Fin 8 → ℕ, (∃ i, 0 < n i) ∧ ∀ j, lam j - nu j = ∑ i, (n i : ℤ) * E8 i j) :
    Bint nu ≠ Bint lam := by
  intro h
  refine Commons.Algebra.Lie.SerreConstruction.no_dominant_singular_weight hl hn hmu ?_
  rw [← Bint_cast nu, ← Bint_cast lam, h]

/-- The bracket `⟪μ, α∨⟫` with the positive root `α = pR j`. -/
def brk (μ : Fin 8 → ℤ) (j : Fin 120) : ℤ := ∑ i, μ i * coords (pR j) i

lemma pR_coords_nonneg : ∀ j : Fin 120, ∀ i : Fin 8,
    (0 : ℤ) ≤ ∑ k, E8inv i k * pR j k := by decide

lemma posCon_pR (j : Fin 120) : posCon (pR j) := by
  intro i
  exact pR_coords_nonneg j i

lemma htOf_pR (j : Fin 120) : 1 ≤ htOf (pR j) :=
  htOf_pos (posCon_pR j) (pR_ne_zero j)

lemma htOf_smul_int (k : ℤ) (γ : Fin 8 → ℤ) : htOf (k • γ) = k * htOf γ := by
  simp only [htOf, coords_smul, Pi.smul_apply, smul_eq_mul, Finset.mul_sum]

lemma htOf_nsmul (k : ℕ) (γ : Fin 8 → ℤ) : htOf (k • γ) = (k : ℤ) * htOf γ := by
  rw [← Nat.cast_smul_eq_nsmul ℤ k γ, htOf_smul_int]

lemma htOf_sub (γ δ : Fin 8 → ℤ) : htOf (γ - δ) = htOf γ - htOf δ := by
  rw [sub_eq_add_neg, htOf_add, show htOf (-δ) = -htOf δ from ?_]
  · ring
  · simp only [htOf, coords_eq, Matrix.mulVec_neg, Pi.neg_apply, Finset.sum_neg_distrib]

lemma htOf_zero : htOf (0 : Fin 8 → ℤ) = 0 := by
  simp [htOf, coords]

lemma htOf_pR_pos (j : Fin 120) : 0 < htOf (pR j) := htOf_pR j


/-! ## Uniqueness of the Freudenthal character -/

/-- **Uniqueness of the character.**  Two functions satisfying the Freudenthal recursion on the
dominant weights, the support bound `λ - ν ∈ ℕΦ⁺`, and invariance under the dominant conjugate
`dc`, agree everywhere. -/
theorem eq_of_freudenthal {lam : Fin 8 → ℤ} (hlam : Dominant lam)
    {m m' : (Fin 8 → ℤ) → ℚ}
    (ha : m lam = 1) (ha' : m' lam = 1)
    (hb : ∀ v, m v ≠ 0 → lam - v = 0 ∨ posCon (lam - v))
    (hb' : ∀ v, m' v ≠ 0 → lam - v = 0 ∨ posCon (lam - v))
    (hc : ∀ v, m (dc v) = m v) (hc' : ∀ v, m' (dc v) = m' v)
    (hd : ∀ ν, Dominant ν → lam - ν ≠ 0 → posCon (lam - ν) →
      (Bint lam - Bint ν) * m ν
        = 2 * ∑ j : Fin 120, ∑ k ∈ Finset.Icc 1 (htOf (lam - ν)).toNat,
            (brk (ν + k • pR j) j : ℚ) * m (ν + k • pR j))
    (hd' : ∀ ν, Dominant ν → lam - ν ≠ 0 → posCon (lam - ν) →
      (Bint lam - Bint ν) * m' ν
        = 2 * ∑ j : Fin 120, ∑ k ∈ Finset.Icc 1 (htOf (lam - ν)).toNat,
            (brk (ν + k • pR j) j : ℚ) * m' (ν + k • pR j)) :
    ∀ v, m v = m' v := by
  -- the Freudenthal recursion for the difference
  have key : ∀ ν, Dominant ν → lam - ν ≠ 0 → posCon (lam - ν) →
      (Bint lam - Bint ν) * (m ν - m' ν)
        = 2 * ∑ j : Fin 120, ∑ k ∈ Finset.Icc 1 (htOf (lam - ν)).toNat,
            (brk (ν + k • pR j) j : ℚ) * (m (ν + k • pR j) - m' (ν + k • pR j)) := by
    intro ν hν hne hcon
    rw [mul_sub, hd ν hν hne hcon, hd' ν hν hne hcon, ← mul_sub]
    congr 1
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl; intro j _
    rw [← Finset.sum_sub_distrib]
    apply Finset.sum_congr rfl; intro k _
    ring
  -- the main induction over the height of `lam - ν`
  have step : ∀ n : ℕ, ∀ ν : Fin 8 → ℤ, Dominant ν → htOf (lam - ν) = (n : ℤ) → m ν = m' ν := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro ν hν hνn
      by_contra hne
      have hm : m ν ≠ 0 ∨ m' ν ≠ 0 := by
        by_contra h
        simp only [not_or, not_not] at h
        exact hne (by rw [h.1, h.2])
      have hcon : lam - ν = 0 ∨ posCon (lam - ν) := hm.elim (hb ν) (hb' ν)
      rcases hcon with h0 | hpc
      · exact hne (by rw [show ν = lam from (sub_eq_zero.mp h0).symm, ha, ha'])
      · have hne0 : lam - ν ≠ 0 := fun h =>
          hne (by rw [show ν = lam from (sub_eq_zero.mp h).symm, ha, ha'])
        -- the Casimir sphere coefficient does not vanish
        obtain ⟨nvec, hnvec⟩ := (posCon_iff_exists (lam - ν)).mp hpc
        have hnne : ∃ i, 0 < nvec i := by
          by_contra h
          simp only [not_exists, not_lt] at h
          apply hne0
          rw [hnvec]
          have hzero : (fun i => ((nvec i : ℤ))) = 0 := by
            funext i; simp [Nat.eq_zero_of_le_zero (h i)]
          rw [hzero, Matrix.mulVec_zero]
        have hA : Bint lam - Bint ν ≠ 0 := by
          intro hz
          have hz' : Bint ν = Bint lam := by linarith
          refine no_dominant_singular_weight' hlam hν ⟨nvec, hnne, ?_⟩ hz'
          intro j
          have hj := congrFun hnvec j
          simp only [Pi.sub_apply] at hj
          rw [hj]
          simp only [Matrix.mulVec, dotProduct]
          apply Finset.sum_congr rfl; intro i _
          have hs : E8 j i = E8 i j :=
            (Commons.LinearAlgebra.Matrix.Cartan.E8_diag_offdiag_symm.1 i j).symm
          rw [hs, mul_comm]
        have hrec := key ν hν hne0 hpc
        have hzero : ∑ j : Fin 120, ∑ k ∈ Finset.Icc 1 (htOf (lam - ν)).toNat,
            (brk (ν + k • pR j) j : ℚ) * (m (ν + k • pR j) - m' (ν + k • pR j)) = 0 := by
          apply Finset.sum_eq_zero; intro j _
          apply Finset.sum_eq_zero; intro k hk
          obtain ⟨hk1, hkk⟩ := Finset.mem_Icc.mp hk
          have hη : m (ν + k • pR j) = m' (ν + k • pR j) := by
            set η : Fin 8 → ℤ := ν + k • pR j with hηdef
            have hlt : htOf (lam - dc η) < (n : ℤ) := by
              have h1 : htOf (lam - η) = (n : ℤ) - (k : ℤ) * htOf (pR j) := by
                have hsplit : lam - η = (lam - ν) - k • pR j := by
                  rw [hηdef]; abel
                rw [hsplit, htOf_sub, htOf_nsmul, hνn]
              have h2 : htOf (lam - dc η) = htOf (lam - η) - htOf (dc η - η) := by
                have hsplit : lam - dc η = (lam - η) - (dc η - η) := by abel
                rw [hsplit, htOf_sub]
              rw [h2, h1]
              have hkp : 1 ≤ (k : ℤ) * htOf (pR j) := by
                have := htOf_pR j; nlinarith
              linarith [htOf_nonneg (dc_sub_posCon η)]
            have hw : Dominant (dc η) := dc_dominant η
            by_cases hneg : htOf (lam - dc η) < 0
            · have hz : m (dc η) = 0 := by
                by_contra hmw
                rcases hb (dc η) hmw with h0 | hpc'
                · rw [h0, htOf_zero] at hneg; exact lt_irrefl 0 hneg
                · linarith [htOf_nonneg hpc']
              have hz' : m' (dc η) = 0 := by
                by_contra hmw
                rcases hb' (dc η) hmw with h0 | hpc'
                · rw [h0, htOf_zero] at hneg; exact lt_irrefl 0 hneg
                · linarith [htOf_nonneg hpc']
              rw [← hc η, ← hc' η, hz, hz']
            · have hnonneg : 0 ≤ htOf (lam - dc η) := le_of_not_gt hneg
              have hlt' : (htOf (lam - dc η)).toNat < n :=
                Commons.LinearAlgebra.Matrix.Cartan.E8NormTwo.int_toNat_lt hnonneg hlt
              have hstep := ih _ hlt' (dc η) hw (Int.toNat_of_nonneg hnonneg).symm
              rw [← hc η, ← hc' η]; exact hstep
          rw [hη, sub_self, mul_zero]
        rw [hzero, mul_zero] at hrec
        exact hne (sub_eq_zero.mp ((mul_eq_zero.mp hrec).resolve_left
          (fun h => hA (by exact_mod_cast h))))
  -- reduce an arbitrary weight to its dominant conjugate
  intro v
  set w : Fin 8 → ℤ := dc v with hwdef
  have hw : Dominant w := dc_dominant v
  by_cases hneg : htOf (lam - w) < 0
  · have hz : m w = 0 := by
      by_contra hmw
      rcases hb w hmw with h0 | hpc'
      · rw [h0, htOf_zero] at hneg; exact lt_irrefl 0 hneg
      · linarith [htOf_nonneg hpc']
    have hz' : m' w = 0 := by
      by_contra hmw
      rcases hb' w hmw with h0 | hpc'
      · rw [h0, htOf_zero] at hneg; exact lt_irrefl 0 hneg
      · linarith [htOf_nonneg hpc']
    rw [← hc v, ← hc' v, hz, hz']
  · have hnonneg : 0 ≤ htOf (lam - w) := le_of_not_gt hneg
    have hstep := step (htOf (lam - w)).toNat w hw (Int.toNat_of_nonneg hnonneg).symm
    rw [← hc v, ← hc' v]; exact hstep

end Submission.E8Character
