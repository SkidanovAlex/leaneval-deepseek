import Mathlib.Tactic
import Mathlib.LinearAlgebra.Matrix.Cartan

/-!
# The `E₈` roots and the Weyl group action, in `d`-coordinates

**Coordinates.**  A weight `v : Fin 8 → ℤ` is written in the `ω`-basis of the weight lattice
(`v j = ⟨v, α_j∨⟩`, see `Submission.WeylWeights`), so that the simple reflection at node `i` acts by
`(sᵢ v) j = v j - v i * A i j` (`Submission.WeylWeights.sref`), where `A = CartanMatrix.E₈` is the
`E₈` Cartan matrix.

A *root* `α` is here stored by its **`d`-coordinates** `d j = ⟨ω_j, α∨⟩`.  The point of this
choice is that the Cartan pairing with a weight is then *integral and computational*:

  `⟨v, α∨⟩ = ∑ j, v j * d j`   (`pair`),

`α` is positive iff `0 < ∑ j, d j` (since `ρ = ∑ ω_j`), and the reflection `sᵢ` acts on the
`d`-coordinates by

  `d ↦ d - (∑ k, A i k * d k) • eᵢ`   (`rref i`),

where `eᵢ = Pi.single i 1` is the `d`-coordinate vector of the simple root `αᵢ`.

**Main results.**

* `rootsD` lists the 240 roots, `posRootsD` the 120 positive ones (`rootsD_nodup`,
  `posRootsD_nodup`, `RD_card`, `PD_card`).
* `pair_sref` — the pairing is `W`-invariant: `⟨sᵢ v, α∨⟩ = ⟨v, (sᵢα)∨⟩`.
* `PD_image_rref` — **a simple reflection permutes the positive roots, moving `αᵢ` to `-αᵢ`**:
  `PD.image (rref i) = insert (-(e i)) (PD.erase (e i))`.  This is the finite input for the
  length function of the Weyl group and for the "reflect into the dominant chamber" algorithm.
* `negCount` (the number of positive roots paired negatively with a weight) and
  `negCount_sref` — **reflecting a weight with a negative `i`-th coordinate decreases `negCount` by
  exactly one**.  This is the termination measure of the reflection algorithm.
-/

set_option maxHeartbeats 4000000
set_option maxRecDepth 10000
set_option linter.unusedSimpArgs false

noncomputable section
open scoped BigOperators

namespace Submission.WeylRoots

/-- The `E₈` Cartan matrix (Bourbaki labelling). -/
abbrev A : Matrix (Fin 8) (Fin 8) ℤ := CartanMatrix.E₈

/-- The `d`-coordinate vector of the simple root `αᵢ`, i.e. the `i`-th standard basis vector. -/
def e (i : Fin 8) : Fin 8 → ℤ := Pi.single i 1

/-- The `d`-coordinates of a root, reflected at the node `i`:
`α ↦ α - ⟨α, αᵢ∨⟩ αᵢ`, with `⟨α, αᵢ∨⟩ = ∑ k, A i k * d k`. -/
def rref (i : Fin 8) (d : Fin 8 → ℤ) : Fin 8 → ℤ :=
  d - (∑ k, A i k * d k) • e i

/-- The Cartan pairing `⟨v, α∨⟩ = ∑ j, v j * d j` of a weight `v` (in `ω`-coordinates) with a root
given by its `d`-coordinates `d`. -/
def pair (v d : Fin 8 → ℤ) : ℤ := ∑ j, v j * d j

