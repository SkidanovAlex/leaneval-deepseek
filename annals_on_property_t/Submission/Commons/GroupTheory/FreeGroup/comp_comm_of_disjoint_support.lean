import Mathlib.Data.Finset.Disjoint
import Mathlib.GroupTheory.FreeGroup.Basic

namespace Commons.GroupTheory.FreeGroup

/-- If a group homomorphism out of a free group fixes, pointwise, all the generators indexed by a
finset `S`, then it fixes pointwise every element of the subgroup generated by those generators. -/
lemma eq_of_fixes_gens_closure {n : ℕ} (f : FreeGroup (Fin n) →* FreeGroup (Fin n))
    (S : Finset (Fin n)) (hf : ∀ k ∈ S, f (FreeGroup.of k) = FreeGroup.of k) :
    ∀ x ∈ Subgroup.closure (FreeGroup.of '' (S : Set (Fin n))), f x = x := by
  intro x hx
  refine Subgroup.closure_induction (p := fun x _ => f x = x) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨k, hk, rfl⟩
    exact hf k hk
  · exact map_one f
  · intro x y hx hy ihx ihy
    rw [map_mul, ihx, ihy]
  · intro x hx ih
    rw [map_inv, ih]

/-- If a group homomorphism out of a free group fixes, pointwise, all the generators not in a
finset `A`, then it fixes pointwise every element of the subgroup generated by the generators
indexed by a finset `B` disjoint from `A`. -/
lemma eq_of_fixes_compl_closure {n : ℕ} (f : FreeGroup (Fin n) →* FreeGroup (Fin n))
    (A B : Finset (Fin n)) (hdisj : Disjoint A B) (hf : ∀ k, k ∉ A → f (FreeGroup.of k) = FreeGroup.of k) :
    ∀ x ∈ Subgroup.closure (FreeGroup.of '' (B : Set (Fin n))), f x = x :=
  eq_of_fixes_gens_closure f B fun k hk => hf k (Finset.disjoint_left.mp hdisj.symm hk)

theorem comp_comm_of_disjoint_support {n : ℕ} (g h : FreeGroup (Fin n) →* FreeGroup (Fin n)) (A B : Finset (Fin n)) (hdisj : Disjoint A B) (hgA : ∀ k ∈ A, g (FreeGroup.of k) ∈ Subgroup.closure (FreeGroup.of '' (A : Set (Fin n)))) (hgB : ∀ k, k ∉ A → g (FreeGroup.of k) = FreeGroup.of k) (hhB : ∀ k ∈ B, h (FreeGroup.of k) ∈ Subgroup.closure (FreeGroup.of '' (B : Set (Fin n)))) (hhA : ∀ k, k ∉ B → h (FreeGroup.of k) = FreeGroup.of k) : g.comp h = h.comp g := by
  apply FreeGroup.ext_hom
  intro k
  simp only [MonoidHom.comp_apply]
  by_cases hkA : k ∈ A
  · have hkB : k ∉ B := Finset.disjoint_left.mp hdisj hkA
    rw [hhA k hkB]
    exact (eq_of_fixes_gens_closure h A (fun j hj => hhA j (Finset.disjoint_left.mp hdisj hj)) (g (FreeGroup.of k)) (hgA k hkA)).symm
  · by_cases hkB : k ∈ B
    · rw [hgB k hkA]
      exact eq_of_fixes_compl_closure g A B hdisj hgB (h (FreeGroup.of k)) (hhB k hkB)
    · simp only [hgB k hkA, hhA k hkB]

end Commons.GroupTheory.FreeGroup