import Submission.Work.SignedClosure

open Submission.FreeGroupAut
set_option autoImplicit false

/-!
# The assembly bridge: reaching a signed permutation suffices for `aut_nielsen`

`aut_nielsen` asserts `Subgroup.closure (AutGen n) = ⊤`, i.e. every
automorphism lies in the subgroup generated by the elementary Nielsen moves.
The classical reduction (T1–T3 + the rebalancing protocol, scaffolded by
`RebalanceData`/`RebalanceProtocol.lean`) aims to show that every `α` can be
*right-composed* by elements of the closure — each move `α ↦ α·γ` with
`γ ∈ closure(AutGen n)` — until a signed permutation is reached.  This module
proves the *bridge* that makes that aim sufficient:

    aut_nielsen_of_reachable_signed : (∀ α, ∃ γ ∈ AutClosure n,
        IsSignedPermutation (α · γ))  ⟹  closure(AutGen n) = ⊤

Indeed `α = (α·γ)·γ⁻¹` with `α·γ` a signed permutation (hence in the closure by
`SignedClosure.signedPermutation_mem_closure`) and `γ⁻¹` in the closure, so
`α` is in the closure; since the accumulated product of the right-composed
`γ`'s lies in the closure (`mul_mem`), the hypothesis of the bridge is exactly
what a terminating descent over `RebalanceData` supplies.

This pins the remaining obligation precisely: a faithful system-level
`State`/`step` transcription (whose word content is in
`T3Rebalance.rebalance_join_reduce`/`rebalance_join_le`), the terminal-state
classification ("no protocol step ⟹ signed permutation"), and the descent
instantiating `RebalanceData` to produce the `γ ∈ AutClosure n` of the bridge.

All lemmas kernel-checked; axioms `[propext, Classical.choice, Quot.sound]`.
-/

namespace Submission.Nielsen

/-- An automorphism that is right-composed by a closure element into a signed
permutation lies itself in the closure. -/
theorem reachable_signed_mem_closure {n : ℕ}
    (α : MulAut (FreeGroup (Fin n)))
    (h : ∃ γ : MulAut (FreeGroup (Fin n)),
      γ ∈ AutClosure n ∧ IsSignedPermutation (α * γ)) :
    α ∈ AutClosure n := by
  rcases h with ⟨γ, hγ, hs⟩
  have hαγ : α * γ ∈ AutClosure n := signedPermutation_mem_closure n hs
  have hγi : γ⁻¹ ∈ AutClosure n := (AutClosure n).inv_mem hγ
  have heq : (α * γ) * γ⁻¹ = α := by
    rw [mul_assoc]
    simp
  rw [← heq]
  exact (AutClosure n).mul_mem hαγ hγi

/-- **The assembly bridge.**  If every automorphism can be right-composed by
closure elements into a signed permutation, then the elementary Nielsen moves
generate `Aut(F_n)`.  (The reduction must therefore only *reach* a signed
permutation; the last step into the closure is closed by
`SignedClosure.signedPermutation_mem_closure`.) -/
theorem aut_nielsen_of_reachable_signed (n : ℕ)
    (h : ∀ α : MulAut (FreeGroup (Fin n)),
      ∃ γ : MulAut (FreeGroup (Fin n)), γ ∈ AutClosure n ∧ IsSignedPermutation (α * γ)) :
    Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) = ⊤ := by
  apply le_antisymm
  · exact le_top
  · intro α htop
    exact reachable_signed_mem_closure α (h α)

end Submission.Nielsen
