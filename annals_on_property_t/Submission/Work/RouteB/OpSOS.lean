import Submission.Work.RouteB.EdgeLap
import Submission.Commons.GroupTheory.FreeGroup.comp_comm_of_disjoint_support

open OnPropertyT Submission.FreeGroupAut Submission.Helpers
open scoped BigOperators

set_option autoImplicit false

/-!
# `Op_n ∈ Σ²` — the paper's second half of `sq op sos`

The transvections carried by two *opposite* edges commute as automorphisms of the
free group (their supports are disjoint), and for commuting `s`, `t` the group
ring elements `1 - s`, `1 - t` generate a commutative subring.  Hence

    `Δ_p Δ_q = (1/4) ∑_{(s,t) ∈ S_p × S_q} star((1-s)(1-t)) · ((1-s)(1-t))`

is a sum of hermitian squares, and summing over the opposite pairs `(p,q) ∈ Q_n`
gives `Op_n ∈ Σ²` (Kaluba–Kielak–Nowak, Lemma `sq op sos`).
-/

namespace Submission.RouteB

variable {A : Type*} [Ring A] [StarRing A] [Algebra ℝ A] [StarModule ℝ A] [DecidableEq A]

/-- **A sum of hermitian squares scales by a nonnegative real.** -/
theorem IsSOS.smul {r : ℝ} (hr : 0 ≤ r) {x : A} (hx : IsSOS x) : IsSOS (r • x) := by
  classical
  obtain ⟨ξ, hξ⟩ := hx
  have hsum : r • x = ∑ i : ξ, star (√r • (i : A)) * (√r • (i : A)) := by
    rw [hξ, Finset.smul_sum, ← Finset.sum_coe_sort ξ (fun y : A => r • (star y * y))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [StarModule.star_smul, smul_mul_smul_comm]
    rw [show (star (√r) * √r : ℝ) = r by rw [star_trivial]; nlinarith [Real.sq_sqrt hr]]
  rw [hsum]
  exact isSOS_of_fintype _

/-- A natural number as a ring element acts as its real counterpart:
`(k : A) * x = (k : ℝ) • x`. -/
lemma real_smul_eq_natCast_mul (k : ℕ) (x : A) : (k : ℝ) • x = (k : A) * x := by
  rw [Algebra.smul_def, map_natCast]

namespace Edge

variable {m : ℕ}

local notation "R" => MonoidAlgebra ℝ (MulAut (FreeGroup (Fin m)))

theorem four_smul_cancel (x : R) : (1 / 4 : ℝ) • ((4 : R) * x) = x := by
  have h4 : (4 : R) * x = (4 : ℝ) • x := (real_smul_eq_natCast_mul 4 x).symm
  rw [h4, smul_smul, show ((1 / 4 : ℝ) * 4) = 1 by norm_num, one_smul]

/-! ## Support conditions for the transvections of an edge -/

/-- The four transvections of an ordered pair move only the `i`-th generator, and
its image lies in the subgroup generated by `a_i, a_j`. -/
lemma dirEdge_comm_conditions {i j : Fin m} (hij : i ≠ j) {x : MulAut (FreeGroup (Fin m))}
    (hx : x ∈ dirEdge i j hij) :
    ∃ k ∈ ({i, j} : Finset (Fin m)),
      (∀ l : Fin m, l ≠ k → x (FreeGroup.of l) = FreeGroup.of l) ∧
      x (FreeGroup.of k)
        ∈ Subgroup.closure (FreeGroup.of '' ({i, j} : Finset (Fin m)) : Set (FreeGroup (Fin m))) := by
  have hi : FreeGroup.of i
      ∈ Subgroup.closure (FreeGroup.of '' ({i, j} : Finset (Fin m)) : Set (FreeGroup (Fin m))) :=
    Subgroup.subset_closure ⟨i, by simp, rfl⟩
  have hj : FreeGroup.of j
      ∈ Subgroup.closure (FreeGroup.of '' ({i, j} : Finset (Fin m)) : Set (FreeGroup (Fin m))) :=
    Subgroup.subset_closure ⟨j, by simp, rfl⟩
  refine ⟨i, by simp, ?_, ?_⟩
  · rw [mem_dirEdge] at hx
    rcases hx with h | h | h | h
    · rw [h]; exact fun k hk => rho_apply_other hij hk
    · rw [h]; exact fun k hk => rhoNeg_apply_other hij hk
    · rw [h]; exact fun k hk => lam_apply_other hij hk
    · rw [h]; exact fun k hk => lamNeg_apply_other hij hk
  · rw [mem_dirEdge] at hx
    rcases hx with h | h | h | h
    · rw [h, rho_apply_self]; exact Subgroup.mul_mem _ hi hj
    · rw [h, rhoNeg_apply_self]; exact Subgroup.mul_mem _ hi (Subgroup.inv_mem _ hj)
    · rw [h, lam_apply_self]; exact Subgroup.mul_mem _ hj hi
    · rw [h, lamNeg_apply_self]; exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hj) hi

/-- The eight transvections of `{i,j}` move only one of `a_i, a_j`, and the image
of that generator lies in the subgroup generated by `a_i` and `a_j`. -/
lemma sEdgeOf_comm_conditions {i j : Fin m} (hij : i ≠ j) {x : MulAut (FreeGroup (Fin m))}
    (hx : x ∈ sEdgeOf i j hij) :
    ∃ k ∈ ({i, j} : Finset (Fin m)),
      (∀ l : Fin m, l ≠ k → x (FreeGroup.of l) = FreeGroup.of l) ∧
      x (FreeGroup.of k)
        ∈ Subgroup.closure (FreeGroup.of '' ({i, j} : Finset (Fin m)) : Set (FreeGroup (Fin m))) := by
  rw [mem_sEdgeOf] at hx
  rcases hx with hx | hx
  · exact dirEdge_comm_conditions hij hx
  · obtain ⟨k, hk, hfix, himg⟩ := dirEdge_comm_conditions (Ne.symm hij) hx
    refine ⟨k, ?_, hfix, ?_⟩
    · simpa [Finset.pair_comm] using hk
    · have : ({j, i} : Finset (Fin m)) = {i, j} := Finset.pair_comm _ _
      rwa [this] at himg

lemma SEdge_comm_conditions {p : Edge m} {x : MulAut (FreeGroup (Fin m))} (hx : x ∈ SEdge p) :
    ∃ k ∈ p.toFinset,
      (∀ l : Fin m, l ≠ k → x (FreeGroup.of l) = FreeGroup.of l) ∧
      x (FreeGroup.of k)
        ∈ Subgroup.closure (FreeGroup.of '' (p.toFinset : Set (Fin m)) :
          Set (FreeGroup (Fin m))) := by
  rw [SEdge_def] at hx
  obtain ⟨k, hk, hfix, himg⟩ := sEdgeOf_comm_conditions (ne_of_lt p.2) hx
  exact ⟨k, hk, hfix, himg⟩

/-- **The transvections of opposite edges commute.** -/
theorem SEdge_comm_of_op {p q : Edge m} (h : Op p q) {s t : MulAut (FreeGroup (Fin m))}
    (hs : s ∈ SEdge p) (ht : t ∈ SEdge q) : s * t = t * s := by
  obtain ⟨i, hi, hsfix, hsimg⟩ := SEdge_comm_conditions hs
  obtain ⟨r, hr, htfix, htimg⟩ := SEdge_comm_conditions ht
  have hdisj : Disjoint p.toFinset q.toFinset := h
  have hne : i ≠ r := fun hh => (Finset.disjoint_left.mp hdisj hi) (hh ▸ hr)
  have key := Commons.GroupTheory.FreeGroup.comp_comm_of_disjoint_support
    (s : FreeGroup (Fin m) →* FreeGroup (Fin m)) (t : FreeGroup (Fin m) →* FreeGroup (Fin m))
    p.toFinset q.toFinset hdisj
    (fun k hk => by
      by_cases hk' : k = i
      · rw [hk']; exact hsimg
      · have hf : (s : FreeGroup (Fin m) →* FreeGroup (Fin m)) (FreeGroup.of k)
            = FreeGroup.of k := hsfix k hk'
        rw [hf]
        exact Subgroup.subset_closure ⟨k, hk, rfl⟩)
    (fun k hk => hsfix k (fun hh => hk (hh ▸ hi)))
    (fun k hk => by
      by_cases hk' : k = r
      · rw [hk']; exact htimg
      · have hf : (t : FreeGroup (Fin m) →* FreeGroup (Fin m)) (FreeGroup.of k)
            = FreeGroup.of k := htfix k hk'
        rw [hf]
        exact Subgroup.subset_closure ⟨k, hk, rfl⟩)
    (fun k hk => htfix k (fun hh => hk (hh ▸ hr)))
  ext x
  exact congrFun (congrArg DFunLike.coe key) x

/-! ## The square identity on opposite edges -/

section Square

variable {G : Type*} [Group G]

/-- `1 - x` and `1 - y` commute when `x` and `y` do. -/
lemma one_sub_mul_one_sub_of_commute {x y : G} (h : x * y = y * x) :
    (1 - MonoidAlgebra.of ℝ G x) * (1 - MonoidAlgebra.of ℝ G y)
      = (1 - MonoidAlgebra.of ℝ G y) * (1 - MonoidAlgebra.of ℝ G x) := by
  have h' : MonoidAlgebra.of ℝ G x * MonoidAlgebra.of ℝ G y
      = MonoidAlgebra.of ℝ G y * MonoidAlgebra.of ℝ G x := by
    rw [← map_mul, ← map_mul, h]
  have expand : ∀ z w : MonoidAlgebra ℝ G, (1 - z) * (1 - w) = 1 - z - w + z * w := by
    intro z w; noncomm_ring
  rw [expand, expand, h']
  abel

end Square

/-- **The key identity**: for commuting group elements `s`, `t`,
`star((1-s)(1-t))·((1-s)(1-t)) = (star(1-s)(1-s))·(star(1-t)(1-t))`. -/
lemma star_one_sub_mul_one_sub {s t : MulAut (FreeGroup (Fin m))} (h : s * t = t * s) :
    star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s)
          * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t))
        * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s)
          * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t))
      = (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s)
          * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s))
        * (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t)
          * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t)) := by
  have hsq : ∀ a b : R, a * star b = star b * a → star a * star b = star b * star a →
      star (a * b) * (a * b) = (star a * a) * (star b * b) := by
    intro a b h1 h2
    calc star (a * b) * (a * b)
        = (star b * star a) * (a * b) := by rw [Submission.Helpers.star_mul]
      _ = (star a * star b) * (a * b) := by rw [← h2]
      _ = star a * (star b * a) * b := by noncomm_ring
      _ = star a * (a * star b) * b := by rw [← h1]
      _ = (star a * a) * (star b * b) := by noncomm_ring
  refine hsq _ _ ?_ ?_
  · rw [Submission.Helpers.star_sub, Submission.Helpers.star_one,
      Submission.Helpers.star_of]
    exact one_sub_mul_one_sub_of_commute (Commute.inv_right h)
  · rw [Submission.Helpers.star_sub, Submission.Helpers.star_one,
      Submission.Helpers.star_of, Submission.Helpers.star_sub,
      Submission.Helpers.star_one, Submission.Helpers.star_of]
    exact one_sub_mul_one_sub_of_commute (Commute.inv_left (Commute.inv_right h))

/-- **The paper's computation `Δ_p Δ_q = (1/4)∑ star((1-s)(1-t))((1-s)(1-t))`**
for opposite edges: the sum of squares of `(1-s)(1-t)` is `4 Δ_p Δ_q`. -/
theorem four_mul_edgeLap_mul_edgeLap {p q : Edge m}
    (hcomm : ∀ s ∈ SEdge p, ∀ t ∈ SEdge q, s * t = t * s) :
    (4 : R) * (edgeLap p * edgeLap q)
      = ∑ x ∈ (SEdge p) ×ˢ (SEdge q),
          star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))
            * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2)) := by
  have hsq : ∀ r : Edge m, (2 : R) * edgeLap r
      = ∑ s ∈ SEdge r,
          star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s)
            * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s) :=
    fun r => two_mul_laplacian_eq_sum_sq (SEdge r) (SEdge_symm r)
  calc (4 : R) * (edgeLap p * edgeLap q)
      = ((2 : R) * edgeLap p) * ((2 : R) * edgeLap q) := by noncomm_ring
    _ = (∑ s ∈ SEdge p,
            star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) s))
          * (∑ t ∈ SEdge q,
            star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) t)) := by
          rw [hsq p, hsq q]
    _ = ∑ x ∈ (SEdge p) ×ˢ (SEdge q),
          (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1))
            * (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2)) := by
          rw [Finset.sum_mul]
          rw [Finset.sum_congr rfl (fun s _ => Finset.mul_sum _ _ _)]
          exact (Finset.sum_product' (SEdge p) (SEdge q)
            (fun a b => (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) a)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) a))
              * (star (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) b)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) b)))).symm
    _ = ∑ x ∈ (SEdge p) ×ˢ (SEdge q),
          star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))
            * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2)) := by
          refine Finset.sum_congr rfl (fun x hx => ?_)
          rw [Finset.mem_product] at hx
          exact (star_one_sub_mul_one_sub (hcomm x.1 hx.1 x.2 hx.2)).symm

/-- `Δ_p Δ_q` is a sum of hermitian squares for opposite edges `p`, `q`. -/
theorem isSOS_edgeLap_mul_of_op {p q : Edge m} (h : Op p q) :
    IsSOS (edgeLap p * edgeLap q) := by
  classical
  have hsum := four_mul_edgeLap_mul_edgeLap (p := p) (q := q)
    (fun s hs t ht => SEdge_comm_of_op h hs ht)
  have hSOS : IsSOS (∑ x ∈ (SEdge p) ×ˢ (SEdge q),
      star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
            * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))
        * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
            * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))) := by
    rw [← Finset.sum_coe_sort ((SEdge p) ×ˢ (SEdge q))
      (fun x : MulAut (FreeGroup (Fin m)) × MulAut (FreeGroup (Fin m)) =>
        star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))
          * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
              * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2)))]
    exact isSOS_of_fintype _
  have key : edgeLap p * edgeLap q
      = (1 / 4 : ℝ) • (∑ x ∈ (SEdge p) ×ˢ (SEdge q),
          star ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))
            * ((1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.1)
                * (1 - MonoidAlgebra.of ℝ (MulAut (FreeGroup (Fin m))) x.2))) := by
    rw [← hsum]
    exact (four_smul_cancel (edgeLap p * edgeLap q)).symm
  rw [key]
  exact IsSOS.smul (by norm_num) hSOS

/-- **`Op_n ∈ Σ²`** (the paper's `sq op sos`, second half). -/
theorem isSOS_OpLap (m : ℕ) : IsSOS (OpLap m) := by
  classical
  rw [OpLap]
  refine IsSOS.finset_sum _ (fun x hx => ?_)
  rw [mem_Qsub_self] at hx
  exact isSOS_edgeLap_mul_of_op hx

end Edge

