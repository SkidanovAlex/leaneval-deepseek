import Submission.Work.AggregateProtocol
import Submission.Work.SignedClosure
import Submission.Work.Transpositions

open Submission.FreeGroupAut
open FreeGroup
open Commons.GroupTheory.FreeGroup
set_option autoImplicit false

/-!
# Aggregate → coordinate: identifying the balanced element and attaching moves

`AggregateProtocol.aggregate_balanced_element` extracts from the balanced
state of an interior aggregate factor the element-level structure
`es[j].toWord = A ++ B` (`|A| = |B|`), with the neighbours covering the two
halves.  This module closes the loop with the *system*: an aggregate
`a_m = Γ_m(w_1,…,w_n)` is by definition a word over the basis images
`w_i = α(a_i)`, so every factor is a basis image up to sign.  Hence:

* **Coordinate identification** (`ImageAggregate`, `aggregate_factor_coordinate`):
  the balanced factor is `es[j] = ±α(a_p)` for a coordinate `p`;
* **Sign-`+` attachments** (`balanced_attach_*`): when the balanced factor is
  the basis image itself (`es[j] = +α(a_p)`, the canonical branch), the
  right-neighbour factor of the balanced state — which begins with `B⁻¹` —
  is, depending on its sign, a basis image `w_u = α(a_u)` *beginning with*
  `B⁻¹` (then the classical combination with `α_p` is right composition by
  `lam u p`, and `N` does not increase by
  `T3RebalanceTuple.rebalance_move_N_le_left`), or the inverse of a basis
  image (then `w_u` *ends with* `B` and the move is `rhoNeg u p`, `N` does
  not increase by `rebalance_move_N_le`).  These are exactly the two places
  where `lam` and `rhoNeg` attach.

The mirrored branch (balanced factor `es[j] = -α(a_p)`, halves read on the
left neighbour with the roles of `A` and `B` exchanged) is the next step of
the protocol; it is not stated here.  The `u ≠ p` hypothesis records that the
rebalanced witness must be a *different* system element than the balanced one
("ein anderes Element des Systems") — ruling out `u = p` (the degenerate
same-coordinate configurations) is part of the protocol-level selection of
the aggregate/witness, not of the move itself.

All lemmas kernel-checked; axioms `[propext, Classical.choice, Quot.sound]`.
-/

namespace Submission.Nielsen

/-- A factor of an aggregate is a basis image `α(a_i)` or its inverse. -/
def IsImageFactor {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (g : FreeGroup (Fin n)) : Prop :=
  ∃ i : Fin n, g = α (FreeGroup.of i) ∨ g = (α (FreeGroup.of i))⁻¹

/-- The factors of the aggregate are basis images — the defining property of
the expression `Γ_m(w_1,…,w_n)` of a standard generator as a word over the
system elements `w_i = α(a_i)`. -/
def ImageAggregate {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) : Prop :=
  ∀ g ∈ es, IsImageFactor α g

/-- **Coordinate identification.**  Every factor of an image aggregate is a
basis image or its inverse: from the `j`-th factor one reads off a coordinate
`p` with `es[j] = α(a_p) ∨ es[j] = (α(a_p))⁻¹`. -/
theorem aggregate_factor_coordinate {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (himg : ImageAggregate α es)
    {j : ℕ} (hj : j < es.length) :
    ∃ p : Fin n, es[j] = α (FreeGroup.of p) ∨ es[j] = (α (FreeGroup.of p))⁻¹ := by
  exact himg (es[j]) (List.getElem_mem hj)

/-- **Balanced factor coordinate.**  Under the balanced-state hypotheses the
balanced factor `es[j]` is a basis image up to sign. -/
theorem balanced_factor_coordinate {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (himg : ImageAggregate α es) :
    ∃ p : Fin n, es[j] = α (FreeGroup.of p) ∨ es[j] = (α (FreeGroup.of p))⁻¹ := by
  exact aggregate_factor_coordinate α es himg hj

/-- `rhoNeg i j` belongs to the Nielsen generating set `AutGen n`. -/
lemma rhoNeg_mem_AutGen (n : ℕ) {i j : Fin n} (hij : i ≠ j) :
    rhoNeg i j hij ∈ (AutGen n : Set (MulAut (FreeGroup (Fin n)))) := by
  classical
  rw [AutGen]
  rw [Finset.mem_coe]
  rw [Finset.mem_union]
  left
  rw [SAutGen]
  rw [Finset.mem_image]
  refine ⟨⟨((i, j), (true, false)), hij⟩, Finset.mem_univ _, ?_⟩
  rfl

/-- `rhoNeg i j` lies in the subgroup generated by `AutGen n`. -/
lemma rhoNeg_mem_closure {n : ℕ} {i j : Fin n} (hij : i ≠ j) :
    rhoNeg i j hij ∈ AutClosure n := by
  exact Subgroup.subset_closure (rhoNeg_mem_AutGen n hij)

/-- `lam i j` lies in the subgroup generated by `AutGen n`. -/
lemma lam_mem_closure {n : ℕ} {i j : Fin n} (hij : i ≠ j) :
    lam i j hij ∈ AutClosure n := by
  exact Subgroup.subset_closure (lam_mem_AutGen n hij)

/-! ## Sign-`+` attachments: `es[j] = +α(a_p)` and the two neighbour signs -/

/-- **Attachment, neighbour `es[j+1] = -α(a_u)`.**  Balanced factor
`es[j] = α(a_p)` (word `A ++ B`, halves), right neighbour the inverse of a
basis image: then `w_u = α(a_u)` *ends with* `B`, and the classical
combination `w_u ↦ w_u · w_p⁻¹` is right composition by `rhoNeg u p`; the
total length does not increase (`rebalance_move_N_le`). -/
theorem balanced_attach_right_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = (α (FreeGroup.of u))⁻¹) (hup : u ≠ p) :
    N (α * rhoNeg u p hup) ≤ N α := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  -- w_u = (es[j+1])⁻¹, so w_u ends with B
  have hw : (α (FreeGroup.of u)).toWord = FreeGroup.invRev Z ++ B := by
    have hwu : (α (FreeGroup.of u)) = (es[j + 1])⁻¹ := by
      rw [hu]
      simp
    calc
      (α (FreeGroup.of u)).toWord = ((es[j + 1])⁻¹).toWord := by rw [hwu]
      _ = FreeGroup.invRev (es[j + 1].toWord) := by rw [FreeGroup.toWord_inv]
      _ = FreeGroup.invRev (FreeGroup.invRev B ++ Z) := by rw [hr]
      _ = FreeGroup.invRev Z ++ B := by
          rw [FreeGroup.invRev_append]
          rw [FreeGroup.invRev_invRev]
  -- w_p's word is A ++ B
  have hpw : (α (FreeGroup.of p)).toWord = A ++ B := by
    rw [← hp]
    exact hmid
  exact rebalance_move_N_le α (q := u) (p := p) hup A B (FreeGroup.invRev Z) hAB hw hpw

/-- **Attachment, neighbour `es[j+1] = +α(a_u)`.**  Balanced factor
`es[j] = α(a_p)` (word `A ++ B`, halves), right neighbour itself a basis
image: then `w_u = α(a_u)` *begins with* `B⁻¹`, and the classical combination
`w_u ↦ w_p · w_u` is right composition by `lam u p`; the total length does
not increase (`rebalance_move_N_le_left`). -/
theorem balanced_attach_right_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = α (FreeGroup.of u)) (hup : u ≠ p) :
    N (α * lam u p hup) ≤ N α := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  -- w_u = es[j+1] begins with invRev B
  have hw : (α (FreeGroup.of u)).toWord = FreeGroup.invRev B ++ Z := by
    rw [← hu]
    exact hr
  have hpw : (α (FreeGroup.of p)).toWord = A ++ B := by
    rw [← hp]
    exact hmid
  exact rebalance_move_N_le_left α (q := u) (p := p) hup A B Z hAB hw hpw

/-- Closure form of the minus attachment: the move is an element of the
subgroup generated by the Nielsen moves. -/
theorem balanced_closure_move_right_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = (α (FreeGroup.of u))⁻¹) (hup : u ≠ p) :
    ∃ γ : MulAut (FreeGroup (Fin n)), γ ∈ AutClosure n ∧ N (α * γ) ≤ N α := by
  refine ⟨rhoNeg u p hup, rhoNeg_mem_closure hup, ?_⟩
  exact balanced_attach_right_minus α es hj hj0 hjk hm hconf hnotL hnotR hp hu hup

/-- Closure form of the plus attachment: the move is an element of the
subgroup generated by the Nielsen moves. -/
theorem balanced_closure_move_right_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = α (FreeGroup.of u)) (hup : u ≠ p) :
    ∃ γ : MulAut (FreeGroup (Fin n)), γ ∈ AutClosure n ∧ N (α * γ) ≤ N α := by
  refine ⟨lam u p hup, lam_mem_closure hup, ?_⟩
  exact balanced_attach_right_plus α es hj hj0 hjk hm hconf hnotL hnotR hp hu hup


/-! ## Sign-`-` attachments (mirror): `es[j] = -α(a_p)`, left-neighbour witness

When the balanced factor is the *inverse* of a basis image
(`es[j] = (α(a_p))⁻¹`), the basis image `w_p = α(a_p)` itself has word
`invRev B ++ invRev A` (its word is the inverse of `A ++ B`): writing the
halves of `w_p` as `A' := invRev B`, `B' := invRev A` (`|A'| = |B'|`), the
*left* neighbour factor of the balanced state — whose word ends with
`invRev A = B'` — provides the witnesses: if it is `+w_v` then `w_v` *ends
with* `B'` (classical combination `w_v ↦ w_v · w_p⁻¹` = right composition by
`rhoNeg v p`), and if it is `-w_v` then `w_v` *begins with* `B'⁻¹` (= `A`)
(classical combination `w_v ↦ w_p · w_v` = right composition by `lam v p`).
These are the exact mirrors of `balanced_attach_right_minus/plus` (the roles
of the two neighbours and of the two halves are exchanged).
-/

/-- Word of a basis image whose inverse is the balanced factor: from
`g.toWord = A ++ B` and `g⁻¹ = w` we get `w.toWord = invRev B ++ invRev A`. -/
private lemma neg_image_word {n : ℕ} (g w : FreeGroup (Fin n))
    (A B : List (Fin n × Bool))
    (hbal : g.toWord = A ++ B) (hg : g⁻¹ = w) :
    w.toWord = FreeGroup.invRev B ++ FreeGroup.invRev A := by
  calc
    w.toWord = (g⁻¹).toWord := by rw [hg]
    _ = FreeGroup.invRev (g.toWord) := by rw [FreeGroup.toWord_inv]
    _ = FreeGroup.invRev (A ++ B) := by rw [hbal]
    _ = FreeGroup.invRev B ++ FreeGroup.invRev A := by rw [FreeGroup.invRev_append]

/-- **Mirror attachment, neighbour `es[j-1] = +α(a_v)`.**  Balanced factor
`es[j] = (α(a_p))⁻¹` (so `w_p = α(a_p)` has word
`A' ++ B'` with `A' := invRev B`, `B' := invRev A`), left neighbour itself a
basis image: then `w_v = α(a_v)` *ends with* `B'`, and the classical
combination `w_v ↦ w_v · w_p⁻¹` is right composition by `rhoNeg v p`; the
total length does not increase (`rebalance_move_N_le`). -/
theorem balanced_attach_left_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = α (FreeGroup.of v)) (hvp : v ≠ p) :
    N (α * rhoNeg v p hvp) ≤ N α := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  let A' : List (Fin n × Bool) := FreeGroup.invRev B
  let B' : List (Fin n × Bool) := FreeGroup.invRev A
  have hpw : (α (FreeGroup.of p)).toWord = A' ++ B' := by
    have hwp : (es[j])⁻¹ = α (FreeGroup.of p) := by
      rw [hp]
      simp
    have hw := neg_image_word (g := es[j]) (w := α (FreeGroup.of p)) A B hmid hwp
    simpa [A', B'] using hw
  have hAB' : A'.length = B'.length := by
    unfold A' B'
    rw [FreeGroup.invRev_length]
    rw [FreeGroup.invRev_length]
    exact hAB.symm
  -- w_v = es[j-1] ends with B' = invRev A
  have hq : (α (FreeGroup.of v)).toWord = X ++ B' := by
    rw [← hv]
    simpa [B'] using hl
  exact rebalance_move_N_le α (q := v) (p := p) hvp A' B' X hAB' hq hpw

/-- **Mirror attachment, neighbour `es[j-1] = -α(a_v)`.**  Balanced factor
`es[j] = (α(a_p))⁻¹`, left neighbour the inverse of a basis image: then
`w_v = α(a_v)` *begins with* `B'⁻¹` (= `A`), and the classical combination
`w_v ↦ w_p · w_v` is right composition by `lam v p`; the total length does
not increase (`rebalance_move_N_le_left`). -/
theorem balanced_attach_left_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = (α (FreeGroup.of v))⁻¹) (hvp : v ≠ p) :
    N (α * lam v p hvp) ≤ N α := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  let A' : List (Fin n × Bool) := FreeGroup.invRev B
  let B' : List (Fin n × Bool) := FreeGroup.invRev A
  have hpw : (α (FreeGroup.of p)).toWord = A' ++ B' := by
    have hwp : (es[j])⁻¹ = α (FreeGroup.of p) := by
      rw [hp]
      simp
    have hw := neg_image_word (g := es[j]) (w := α (FreeGroup.of p)) A B hmid hwp
    simpa [A', B'] using hw
  have hAB' : A'.length = B'.length := by
    unfold A' B'
    rw [FreeGroup.invRev_length]
    rw [FreeGroup.invRev_length]
    exact hAB.symm
  -- w_v = (es[j-1])⁻¹ begins with invRev B' (= A)
  have hq : (α (FreeGroup.of v)).toWord = FreeGroup.invRev B' ++ FreeGroup.invRev X := by
    have hwv : (es[j - 1])⁻¹ = α (FreeGroup.of v) := by
      rw [hv]
      simp
    calc
      (α (FreeGroup.of v)).toWord = ((es[j - 1])⁻¹).toWord := by rw [hwv]
      _ = FreeGroup.invRev (es[j - 1].toWord) := by rw [FreeGroup.toWord_inv]
      _ = FreeGroup.invRev (X ++ FreeGroup.invRev A) := by rw [hl]
      _ = A ++ FreeGroup.invRev X := by
          rw [FreeGroup.invRev_append]
          rw [FreeGroup.invRev_invRev]
      _ = FreeGroup.invRev B' ++ FreeGroup.invRev X := by
          have h : FreeGroup.invRev B' = A := by
            unfold B'
            rw [FreeGroup.invRev_invRev]
          rw [h]
  exact rebalance_move_N_le_left α (q := v) (p := p) hvp A' B' (FreeGroup.invRev X) hAB' hq hpw

/-- Closure form of the mirrored plus attachment (left neighbour `+w_v`,
move `rhoNeg v p`). -/
theorem balanced_closure_move_left_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = α (FreeGroup.of v)) (hvp : v ≠ p) :
    ∃ γ : MulAut (FreeGroup (Fin n)), γ ∈ AutClosure n ∧ N (α * γ) ≤ N α := by
  refine ⟨rhoNeg v p hvp, rhoNeg_mem_closure hvp, ?_⟩
  exact balanced_attach_left_plus α es hj hj0 hjk hm hconf hnotL hnotR hp hv hvp

/-- Closure form of the mirrored minus attachment (left neighbour `-w_v`,
move `lam v p`). -/
theorem balanced_closure_move_left_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = (α (FreeGroup.of v))⁻¹) (hvp : v ≠ p) :
    ∃ γ : MulAut (FreeGroup (Fin n)), γ ∈ AutClosure n ∧ N (α * γ) ≤ N α := by
  refine ⟨lam v p hvp, lam_mem_closure hvp, ?_⟩
  exact balanced_attach_left_minus α es hj hj0 hjk hm hconf hnotL hnotR hp hv hvp


/-! ## The `u ≠ p` selection layer

The attachments above require the witness coordinate to be a *different*
system element than the balanced one (`u ≠ p`, "ein anderes Element des
Systems").  Two facts guarantee this for genuine (non-degenerate) aggregates:

* **no adjacent inverse factors** (`SystemReduced`) — excludes the *mixed
  sign* coincidences (`es[j] = +w_p` with `es[j+1] = -w_p`, and dually), and
* **balancedness degeneracy** — a *same sign* coincidence (`es[j+1] = es[j]`)
  in the balanced state forces the balanced factor to be the trivial word, so
  a non-trivial balanced factor excludes it.

`getElem_index_congr` handles the index arithmetic `(j-1)+1 = j` needed at the
left junctions.
-/

/-- Entries of a list at equal indices are equal. -/
private lemma getElem_index_congr {α : Type*} {l : List α} {i j : ℕ} (h : i = j)
    (hi : i < l.length) (hj : j < l.length) : l[i] = l[j] := by
  subst j
  rfl

/-- The factors of a *system word*: no factor is trivial and no two adjacent
factors are inverses (the expression `Γ_m(w_1,…,w_n)` is written in reduced
form over the system alphabet). -/
def SystemReduced {n : ℕ} (es : List (FreeGroup (Fin n))) : Prop :=
  (∀ g ∈ es, g ≠ 1) ∧
    ∀ i : ℕ, ∀ hi : i + 1 < es.length,
      es[i + 1] ≠ (es[i]'(by omega))⁻¹

/-- **Mixed-sign witness selection.**  If the `i`-th factor is `+α(a_p)` and
the next factor is the inverse of a basis image, that coordinate is different
from `p`: otherwise the two factors would be adjacent inverses
(`SystemReduced`). -/
theorem adjacent_inverse_coordinate_ne {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (hred : SystemReduced es)
    {i : ℕ} (hi : i < es.length) (hip : i + 1 < es.length)
    {p u : Fin n} (hp : es[i] = α (FreeGroup.of p))
    (hu : es[i + 1] = (α (FreeGroup.of u))⁻¹) : u ≠ p := by
  intro hup
  have h : es[i + 1] = (es[i])⁻¹ := by
    rw [hu, hup, hp]
  have hne : es[i + 1] ≠ (es[i])⁻¹ := hred.2 i hip
  exact hne h

/-- Selection for the `balanced_attach_right_minus` context. -/
theorem witness_ne_right_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (hred : SystemReduced es)
    {j : ℕ} (hj : j < es.length) (hjk : j + 1 < es.length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = (α (FreeGroup.of u))⁻¹) : u ≠ p := by
  exact adjacent_inverse_coordinate_ne α es hred hj hjk hp hu

/-- Selection for the `balanced_attach_left_plus` context (witness factor is
the *left* neighbour `es[j-1] = +α(a_v)`). -/
theorem witness_ne_left_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (hred : SystemReduced es)
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hm : j - 1 < es.length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = α (FreeGroup.of v)) : v ≠ p := by
  intro hvp
  have h : es[j] = (es[j - 1])⁻¹ := by
    rw [hp, hv, hvp]
  -- es[j] = es[(j-1)+1] by index arithmetic
  have hij : (j - 1) + 1 = j := by omega
  have hj' : (j - 1) + 1 < es.length := by omega
  have hcong := getElem_index_congr (l := es) hij.symm hj hj'
  -- hcong : es[j-1] = es[(j-1)+1]
  have h' : es[(j - 1) + 1] = (es[j - 1])⁻¹ := by
    -- from h : es[j] = (es[j-1])⁻¹ and es[j] = es[(j-1)+1]
    rw [hcong] at h
    exact h
  have hne : es[(j - 1) + 1] ≠ (es[j - 1])⁻¹ := hred.2 (j - 1) hj'
  exact hne h'

/-- **Same-sign degeneracy (right).**  In the balanced state the balanced
factor cannot equal (same sign) its right neighbour unless it is the trivial
word: `es[j+1] = es[j]` forces `es[j].toWord = []`. -/
theorem balanced_same_factor_right_degenerate {n : ℕ}
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    (heq : es[j + 1] = es[j]) :
    (es[j]).toWord = [] := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  have hc := congrArg (fun g : FreeGroup (Fin n) => g.toWord) heq
  rw [hr, hmid] at hc
  have he : FreeGroup.invRev B ++ Z = A ++ B := hc
  -- A = invRev B by comparing the first |A| = |B| letters
  have ht1 : (FreeGroup.invRev B ++ Z).take B.length = FreeGroup.invRev B := by
    rw [List.take_append_of_le_length (l₁ := FreeGroup.invRev B) (l₂ := Z)
      (i := B.length) (by rw [FreeGroup.invRev_length])]
    rw [← FreeGroup.invRev_length]
    exact List.take_length
  have htA : (A ++ B).take B.length = A := by
    rw [List.take_append_of_le_length (l₁ := A) (l₂ := B) (i := B.length) (by omega)]
    rw [← hAB]
    exact List.take_length
  have htake := congrArg (fun W : List (Fin n × Bool) => W.take B.length) he
  rw [ht1] at htake
  rw [htA] at htake
  have hA : A = FreeGroup.invRev B := htake.symm
  have hword : (es[j]).toWord = FreeGroup.invRev B ++ B := by
    rw [hmid, hA]
  have hred : FreeGroup.IsReduced ((es[j]).toWord) := FreeGroup.isReduced_toWord (x := es[j])
  have hredB : FreeGroup.IsReduced (FreeGroup.invRev B ++ B) := by
    rw [hword] at hred
    exact hred
  have hrv : FreeGroup.reduce (FreeGroup.invRev B ++ B) = FreeGroup.invRev B ++ B :=
    FreeGroup.isReduced_iff_reduce_eq.mp hredB
  have hrc : FreeGroup.reduce (FreeGroup.invRev B ++ B) = [] :=
    FreeGroup.reduce_invRev_left_cancel (L := B)
  have hempty : FreeGroup.invRev B ++ B = [] := by
    rw [← hrv]
    exact hrc
  rw [hword, hempty]

/-- **Same-sign degeneracy (left).**  In the balanced state the balanced
factor cannot equal its left neighbour unless it is the trivial word. -/
theorem balanced_same_factor_left_degenerate {n : ℕ}
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    (heq : es[j - 1] = es[j]) :
    (es[j]).toWord = [] := by
  rcases aggregate_balanced_element es hj hj0 hjk hm hconf hnotL hnotR with
    ⟨A, B, X, Z, hmid, hAB, hl, hr⟩
  have hc := congrArg (fun g : FreeGroup (Fin n) => g.toWord) heq
  rw [hl, hmid] at hc
  have he : X ++ FreeGroup.invRev A = A ++ B := hc
  -- the two sides have equal length, so |X| = |B|
  have hlenX : X.length = B.length := by
    have hc' := congrArg List.length he
    rw [List.length_append, List.length_append, FreeGroup.invRev_length] at hc'
    omega
  -- B = invRev A by comparing the last |B| = |A| letters of the common word
  have hd1 : (X ++ FreeGroup.invRev A).drop B.length = FreeGroup.invRev A := by
    have hle : B.length ≤ X.length := by omega
    rw [List.drop_append_of_le_length (l₁ := X) (l₂ := FreeGroup.invRev A)
      (i := B.length) hle]
    rw [← hlenX, List.drop_length]
    simp
  have hd2 : (A ++ B).drop B.length = B := by
    rw [List.drop_append_of_le_length (l₁ := A) (l₂ := B) (i := B.length) (by omega)]
    rw [← hAB, List.drop_length]
    simp
  have hdrop := congrArg (fun W : List (Fin n × Bool) => W.drop B.length) he
  rw [hd1] at hdrop
  rw [hd2] at hdrop
  have hB : B = FreeGroup.invRev A := hdrop.symm
  have hword : (es[j]).toWord = A ++ FreeGroup.invRev A := by
    rw [hmid, hB]
  have hred : FreeGroup.IsReduced ((es[j]).toWord) := FreeGroup.isReduced_toWord (x := es[j])
  have hredA : FreeGroup.IsReduced (A ++ FreeGroup.invRev A) := by
    rw [hword] at hred
    exact hred
  have hrv : FreeGroup.reduce (A ++ FreeGroup.invRev A) = A ++ FreeGroup.invRev A :=
    FreeGroup.isReduced_iff_reduce_eq.mp hredA
  have hrc : FreeGroup.reduce (A ++ FreeGroup.invRev A) = [] :=
    reduce_append_invRev_self A
  have hempty : A ++ FreeGroup.invRev A = [] := by
    rw [← hrv]
    exact hrc
  rw [hword, hempty]

/-- Selection for the `balanced_attach_right_plus` context: a non-trivial
balanced factor never coincides (same sign) with its right neighbour. -/
theorem witness_ne_right_plus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    (hnt : (es[j]).toWord ≠ [])
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = α (FreeGroup.of u)) : u ≠ p := by
  intro hup
  apply hnt
  apply balanced_same_factor_right_degenerate es hj hj0 hjk hm hconf hnotL hnotR
  rw [hp, hu, hup]

/-- Selection for the `balanced_attach_left_minus` context: a non-trivial
balanced factor never coincides (same sign) with its left neighbour. -/
theorem witness_ne_left_minus {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n)))
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    (hnt : (es[j]).toWord ≠ [])
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = (α (FreeGroup.of v))⁻¹) : v ≠ p := by
  intro hvp
  apply hnt
  apply balanced_same_factor_left_degenerate es hj hj0 hjk hm hconf hnotL hnotR
  rw [hp, hv, hvp]


/-- A `SystemReduced` factor is non-trivial (its word is non-empty). -/
lemma SystemReduced_factor_nontrivial {n : ℕ} (es : List (FreeGroup (Fin n)))
    (hred : SystemReduced es) {j : ℕ} (hj : j < es.length) :
    (es[j]).toWord ≠ [] := by
  have hg : es[j] ≠ 1 := hred.1 (es[j]) (List.getElem_mem hj)
  intro hw
  apply hg
  have hm := FreeGroup.mk_toWord (x := es[j])
  rw [hw] at hm
  have h1 : FreeGroup.mk ([] : List (Fin n × Bool)) = (1 : FreeGroup (Fin n)) := by rfl
  rw [h1] at hm
  exact hm.symm

/-- Selection for the `balanced_attach_right_plus` context, from
`SystemReduced`: the balanced factor never coincides with its right neighbour
(a non-trivial `SystemReduced` factor cannot be the degenerate balanced
element). -/
theorem witness_ne_right_plus' {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (hred : SystemReduced es)
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p u : Fin n} (hp : es[j] = α (FreeGroup.of p))
    (hu : es[j + 1] = α (FreeGroup.of u)) : u ≠ p := by
  have hnt : (es[j]).toWord ≠ [] := SystemReduced_factor_nontrivial es hred hj
  exact witness_ne_right_plus α es hj hj0 hjk hm hconf hnotL hnotR hnt hp hu

/-- Selection for the `balanced_attach_left_minus` context, from
`SystemReduced`. -/
theorem witness_ne_left_minus' {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (es : List (FreeGroup (Fin n))) (hred : SystemReduced es)
    {j : ℕ} (hj : j < es.length) (hj0 : 0 < j) (hjk : j + 1 < es.length)
    (hm : j - 1 < es.length) (hconf : Confined (aggregateWords es) j)
    (hnotL : 2 * align ((es[j - 1]).toWord) ((es[j]).toWord) ≤ ((es[j]).toWord).length)
    (hnotR : 2 * align ((es[j]).toWord) ((es[j + 1]).toWord) ≤ ((es[j]).toWord).length)
    {p v : Fin n} (hp : es[j] = (α (FreeGroup.of p))⁻¹)
    (hv : es[j - 1] = (α (FreeGroup.of v))⁻¹) : v ≠ p := by
  have hnt : (es[j]).toWord ≠ [] := SystemReduced_factor_nontrivial es hred hj
  exact witness_ne_left_minus α es hj hj0 hjk hm hconf hnotL hnotR hnt hp hv

end Submission.Nielsen
