import Mathlib
import Submission.Work.PTCert.Glue3
import Submission.Work.PTCert.nLevel
import Submission.Work.PTCert.KleinGlue.permArith
import Submission.Work.PTCert.KleinGlue.chiSPerm
import Submission.Work.PTCert.KleinGlue.kleinAdm
import Submission.Work.PTCert.KleinGlue.kleinDist
import Submission.Work.PTCert.KleinGlue.kleinCover

/-!
# `Work.PTCert.kleinFacts` — the Klein level of the rank-5 certificate

The Klein level (`KleinLevel`, GL5) is applied to the concrete objects of `Glue2.lean`: the first
level is the sign-flip action `actN` on `EI`, the Klein group `(ℤ/2)²` is generated by the two
permutations `kg1 k`, `kg2 k` (via `kleinPerm`), acting through `kapE k`, with twist
`θ b a = a ∘ (kleinPerm k (bval b)).symm` on the characters. The base character `SkF k` (`k ≤ 5`)
has as Klein representatives the kernel list `ksL.getD k []` (as elements `kE k i`), and the kernel
checks in `KleinSem` (`kleinDistinctOK`, `kleinCoverOK`) provide exactly the three hypotheses of
`KleinLevel`.
-/

namespace Work.PTCert

open Submission.PTCert Submission.PTCert.G Submission.RouteB

open scoped BigOperators

set_option maxHeartbeats 1600000
set_option maxRecDepth 10000

noncomputable section

/-- The twist `θ_b` of the Klein action on the character group `(ℤ/2)^5`. -/
private def θK (k : ℕ) : (Fin 2 → ZMod 2) → (Fin 5 → ZMod 2) → (Fin 5 → ZMod 2) :=
  fun b a i => a ((kleinPerm k (bval b)).symm i)

/-- Indexing of the Klein representatives of the base character `k`. -/
private def klF (k : ℕ) : Fin (nK k) → EI := fun i => kE k i

/-- The Klein representatives of the base character `k` as a list. -/
private def klL (k : ℕ) : List EI := List.ofFn (klF k)

private lemma klL_length (k : ℕ) : (klL k).length = nK k := List.length_ofFn

/-- `ksRep k i` is the position in `ksL.getD k []` of the `i`-th entry of `klL k`. -/
private def ksRep (k : ℕ) (i : Fin (klL k).length) : Fin (nK k) := finCongr (klL_length k) i

/-- The entry of `klL k` corresponding to the position `i` in `ksL.getD k []`. -/
private def ksIdx (k : ℕ) (i : Fin (nK k)) : Fin (klL k).length := finCongr (klL_length k).symm i

private lemma ksRep_val (k : ℕ) (i : Fin (klL k).length) : (ksRep k i).val = i.val := rfl

private lemma ksIdx_val (k : ℕ) (i : Fin (nK k)) : (ksIdx k i).val = i.val := rfl

private lemma ksRep_ksIdx (k : ℕ) (i : Fin (nK k)) : ksRep k (ksIdx k i) = i := Fin.ext rfl

private lemma ksIdx_ksRep (k : ℕ) (i : Fin (klL k).length) : ksIdx k (ksRep k i) = i := Fin.ext rfl

private lemma klL_get (k : ℕ) (i : Fin (klL k).length) : (klL k).get i = kE k (ksRep k i) := by
  rw [List.get_eq_getElem]
  unfold klL
  rw [List.getElem_ofFn]
  rfl

private lemma klL_get_idx (k : ℕ) (i : Fin (nK k)) : (klL k).get (ksIdx k i) = kE k i := by
  rw [klL_get, ksRep_ksIdx]

/-- Every entry of the kernel Klein list `ksL.getD k []` is a genuine representative number. -/
private lemma ksBound (k : ℕ) (hk : k ≤ 5) : ∀ i < nK k, (ksL.getD k []).getD i 0 < 611 := by
  have h : ∀ i ∈ Finset.range (nK k), (ksL.getD k []).getD i 0 < 611 := by
    interval_cases k <;> decide
  exact fun i hi => h i (Finset.mem_range.mpr hi)

/-- Every four-bit mask is `maskSet` of a number `< 4` (the enumeration of the Klein group
`(ℤ/2)²` by bit masks is surjective). -/
private lemma maskSet_surj (Ψ : Finset (Fin 2)) : ∃ ψ : Fin 4, maskSet (m := 2) ψ.val = Ψ := by
  revert Ψ
  decide

private lemma Sk_lt (k : ℕ) (hk : k ≤ 5) : Sk k < 32 := by
  unfold Sk; interval_cases k <;> norm_num

/-- `χ_{S_k}` of a sign code, as computed by the kernel (`chiS5`). -/
private lemma chiS_SkF_zOfSc (hBB : BitsBridge) (k : ℕ) (hk : k ≤ 5) (sc : ℕ) (hsc : sc < 32) :
    chiS (SkF k) (zOfSc sc) = (chiS5 (Sk k) sc : ℝ) :=
  hBB.2.2.1 (Sk k) sc (Sk_lt k hk) hsc

/-! ## The main theorem -/

theorem kleinFacts (hCF : CodeFacts) (hA : ActSetup) (hNst : NStructure) (hRF : RowFacts)
    (hKL : KleinLevel) (hK : ∀ k ≤ 5, KleinSem k) (hE : ESem) (hN : NSem) (hBB : BitsBridge) :
    KleinFacts := by
  intro pv hsym k hk5
  have hA0 : ActSetup := hA
  have hAA : ActSetup := hA0
  obtain ⟨hfE_inj, hclosure, hConjAct, hActMul, hActOne, hActBij, hTab, hActCode,
    hNmul, hNone, hsgnSg, hNtab⟩ := hAA
  obtain ⟨hperm0, hpermsq, hpermmul, hbval4, hpermS⟩ := KleinGlue.permArith k hk5
  -- ## the Klein action laws
  have hkap : ∀ a b x, kapE k (a + b) x = kapE k a (kapE k b x) := by
    intro a b x
    show actE (permAut (kleinPerm k (bval (a + b)))) x
        = actE (permAut (kleinPerm k (bval a))) (actE (permAut (kleinPerm k (bval b))) x)
    rw [← hActMul (permAut (kleinPerm k (bval a))) (permAut_mem_Sg hCF _)
          (permAut (kleinPerm k (bval b))) (permAut_mem_Sg hCF _) x,
      ← Submission.RouteB.permAut_mul, ← hpermmul a b]
  have hkap0 : ∀ x, kapE k 0 x = x := by
    intro x
    show actE (permAut (kleinPerm k (bval (0 : Fin 2 → ZMod 2)))) x = x
    have hb0 : bval (0 : Fin 2 → ZMod 2) = 0 := by simp [bval]
    rw [hb0, hperm0, Submission.RouteB.permAut_one, hActOne]
  have hcomm : ∀ b a x, kapE k b (actN a x) = actN (θK k b a) (kapE k b x) := by
    intro b a x
    show actE (permAut (kleinPerm k (bval b))) (actE (signAut (zBool a)) x)
        = actE (signAut (zBool (θK k b a))) (actE (permAut (kleinPerm k (bval b))) x)
    rw [← hActMul (permAut (kleinPerm k (bval b))) (permAut_mem_Sg hCF _)
          (signAut (zBool a)) (hsgnSg a) x,
        ← hActMul (signAut (zBool (θK k b a))) (hsgnSg _)
          (permAut (kleinPerm k (bval b))) (permAut_mem_Sg hCF _) x]
    have hfun : (fun i => zBool a ((kleinPerm k (bval b)).symm i)) = zBool (θK k b a) := by
      funext i
      rfl
    have hconj := permAut_conj_signAut (kleinPerm k (bval b)) (zBool a)
    have hconj' : permAut (kleinPerm k (bval b)) * signAut (zBool a)
        = signAut (fun i => zBool a ((kleinPerm k (bval b)).symm i))
          * permAut (kleinPerm k (bval b)) := by
      have h2 := congrArg (fun z => z * permAut (kleinPerm k (bval b))) hconj
      rwa [mul_assoc, inv_mul_cancel, mul_one] at h2
    rw [hconj', hfun]
  have hθ : ∀ b a, θK k b (θK k b a) = a := by
    intro b a
    funext i
    show a ((kleinPerm k (bval b)).symm ((kleinPerm k (bval b)).symm i)) = a i
    have hsymm : (kleinPerm k (bval b)).symm = kleinPerm k (bval b) :=
      inv_eq_of_mul_eq_one_right (hpermsq b)
    have h2 : kleinPerm k (bval b) (kleinPerm k (bval b) i) = i :=
      congrFun (congrArg DFunLike.coe (hpermsq b)) i
    rw [hsymm, h2]
  have hchiθ : ∀ b a, chiS (SkF k) (θK k b a) = chiS (SkF k) a := by
    intro b a
    show chiS (SkF k) (fun i => a ((kleinPerm k (bval b)).symm i)) = chiS (SkF k) a
    exact KleinGlue.chiSPerm (SkF k) (kleinPerm k (bval b)) (hpermS b) a
  -- ## invariance of `Pmat pv`
  have hMinv : ∀ a x y, Pmat pv (actN a x) (actN a y) = Pmat pv x y :=
    fun a x y => (hRF pv).2.1 (signAut (zBool a)) (hsgnSg a) x y
  have hMkap : ∀ b x y, Pmat pv (kapE k b x) (kapE k b y) = Pmat pv x y :=
    fun b x y => (hRF pv).2.1 (permAut (kleinPerm k (bval b))) (permAut_mem_Sg hCF _) x y
  -- ## the three Klein data hypotheses from the kernel checks
  have hts : ∀ i < nK k, (ksL.getD k []).getD i 0 < 611 := ksBound k hk5
  have hksadm : ∀ y ∈ klL k, repE y = y ∧
      ∀ a, actN a y = y → chiS (SkF k) a = 1 := by
    intro y hy
    rw [klL, List.mem_ofFn] at hy
    obtain ⟨j, hj⟩ := hy
    rw [← hj]
    exact KleinGlue.kleinAdm hCF hA0 hNst hN hBB hK k hk5 hts j.val j.isLt
  have hksdist : ∀ (i j : Fin (klL k).length) (b : Fin 2 → ZMod 2),
      repE (kapE k b ((klL k).get i)) = (klL k).get j → i = j := by
    intro i j b h
    have h1 := h
    rw [klL_get k i, klL_get k j] at h1
    have h2 := KleinGlue.kleinDist hCF hA0 hNst hN hK k hk5 hts (ksRep k i).val (ksRep k j).val
      (ksRep k i).isLt (ksRep k j).isLt b h1
    exact Fin.ext (by rw [← ksRep_val k i, ← ksRep_val k j]; exact h2)
  have hkscover : ∀ x, repE x = x → (∀ a, actN a x = x → chiS (SkF k) a = 1) →
      ∃ (i : Fin (klL k).length) (b : Fin 2 → ZMod 2),
        repE (kapE k b ((klL k).get i)) = x := by
    intro x hrep hadm
    obtain ⟨i, b, hi, hb⟩ := KleinGlue.kleinCover hCF hA0 hNst hN hBB hK k hk5 hts x hrep hadm
    exact ⟨ksIdx k ⟨i, hi⟩, b, by rw [klL_get_idx k ⟨i, hi⟩]; exact hb⟩
  -- ## apply the Klein level
  have hout := hKL 5 2 actN (kapE k) (θK k) hNmul hNone hkap hkap0 hcomm hθ (SkF k) hchiθ
    (Pmat pv) hsym hMinv hMkap repE nuE hNst.1 hNst.2.1 hNst.2.2.1 (klL k)
    hksadm hksdist hkscover
  constructor
  · -- symmetry of the `ψ`-blocks
    intro ψ hψ i j
    have h1 : psiBlock pv k ψ i j = (∑ b : Fin 2 → ZMod 2, chiS (maskSet (m := 2) ψ) b *
        chiS (SkF k) (nuE (kapE k b ((klL k).get (ksIdx k j)))) *
        fourierW actN (Pmat pv) (SkF k) ((klL k).get (ksIdx k i))
          (repE (kapE k b ((klL k).get (ksIdx k j))))) := by
      simp only [psiBlock, Matrix.of_apply, ← klL_get_idx]
    have h2 : psiBlock pv k ψ j i = (∑ b : Fin 2 → ZMod 2, chiS (maskSet (m := 2) ψ) b *
        chiS (SkF k) (nuE (kapE k b ((klL k).get (ksIdx k i)))) *
        fourierW actN (Pmat pv) (SkF k) ((klL k).get (ksIdx k j))
          (repE (kapE k b ((klL k).get (ksIdx k i))))) := by
      simp only [psiBlock, Matrix.of_apply, ← klL_get_idx]
    rw [h1, h2]
    exact hout.1 (maskSet (m := 2) ψ) (ksIdx k i) (ksIdx k j)
  · -- PSD of the `ψ`-blocks implies PSD of the block
    intro hpsi
    refine hout.2 (fun Ψ => ?_)
    obtain ⟨ψ, hmask⟩ := maskSet_surj Ψ
    have hψ4 : ψ.val < 4 := ψ.isLt
    have hP : (psiBlock pv k ψ.val).PosSemidef := hpsi ψ.val hψ4
    have heq : (Matrix.of fun i j : Fin (klL k).length => ∑ b : Fin 2 → ZMod 2, chiS Ψ b *
        chiS (SkF k) (nuE (kapE k b ((klL k).get j))) *
        fourierW actN (Pmat pv) (SkF k) ((klL k).get i)
          (repE (kapE k b ((klL k).get j))))
        = (psiBlock pv k ψ.val).submatrix (ksRep k) (ksRep k) := by
      ext i j
      simp only [Matrix.submatrix_apply, Matrix.of_apply, psiBlock, ← klL_get, ← hmask]
    rw [heq]
    exact hP.submatrix (ksRep k)

end

end Work.PTCert
