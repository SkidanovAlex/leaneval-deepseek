import Submission.Work.NielsenPeel
import Submission.Work.NielsenResidualAlign
import Submission.Work.SystemReducedImage
import Submission.Work.SignedPerm
import Mathlib.Data.Finset.Card

open FreeGroup
open Commons.GroupTheory.FreeGroup
set_option autoImplicit false

/-!
# Terminal classification: short images ⟹ signed permutation

Every route to `aut_nielsen` ends the same way: a descent produces an
automorphism whose basis images have reduced length ≤ 1, and one must
conclude that it is a *signed permutation* (single basis letters up to
inversion, with all indices hit).  This module proves that classification:

    short_images_signed (α) (∀ i, |α(aᵢ)| ≤ 1) : IsSignedPermutation α

Structure of the proof.

1. **Reduction removes no letters.**  A free reduction only deletes adjacent
   inverse pairs, so every letter of the reduced word occurs in the original
   word (`redStep_mem`, `red_mem`, `reduce_mem`); consequently the letters of
   `(x·y).toWord` come from `x` or `y` (`toWord_mul_mem`) and inversion keeps
   the letter indices (`invRev_mem`).

2. **Short images are single signed letters.**  Automorphism images are
   non-trivial, so `|w_i| ≤ 1` forces `|w_i| = 1` and
   `toWord_singleton_of_norm_eq_one` gives `toWord w_i = [(σ i, s i)]`
   (`shortData`, `shortData_toWord`); `eq_of_of_singleton_true/false` then
   identify `w_i = a_{σ i}^{±1}` (`shortData_value`).

3. **Surjectivity of the coordinate map.**  The images generate `F_n`
   (`basis_generates`).  For `σ := shortCoord α hshort`, the predicate
   `coordRangeProp σ x` — every letter index of `toWord x` lies in
   `range σ` — is closed under the subgroup operations (by items 1, and
   trivially for the single-letter generators), so it holds on the whole
   subgroup generated by the images; applied to `a_k` (`toWord = [(k,true)]`)
   it yields `k ∈ range σ` for every `k` (`shortCoord_surjective`).

4. **Assembly.**  A surjective self-map of `Fin n` is injective (finite card
   argument, `shortCoord_bijective`), so `σ` is a permutation `σe`; the
   pointwise identities `w_i = ±a_{σe i}` make `α` equal to `signedAut σe s`
   (`FreeGroup.ext_hom` on the generators), i.e. `IsSignedPermutation α`.

All lemmas kernel-checked; axioms `[propext, Classical.choice, Quot.sound]`.
-/

namespace Submission.Nielsen


/-! ## 1. Reduction removes no letters -/

lemma redStep_mem {α : Type*} {L M : List (α × Bool)} (H : FreeGroup.Red.Step L M)
    {l : α × Bool} (hm : l ∈ M) : l ∈ L := by
  rcases H with ⟨L1, L2, x, b, rfl, rfl⟩
  rcases List.mem_append.mp hm with hm | hm
  · exact List.mem_append.mpr (Or.inl hm)
  · exact List.mem_append.mpr (Or.inr (by
      simp [List.mem_cons]
      exact Or.inr (Or.inr hm)))

lemma red_mem {α : Type*} {L M : List (α × Bool)} (H : FreeGroup.Red L M)
    {l : α × Bool} (hm : l ∈ M) : l ∈ L := by
  induction H with
  | refl => exact hm
  | tail hchain hstep ih =>
      exact ih (redStep_mem hstep hm)

lemma reduce_mem {α : Type*} [DecidableEq α] {L : List (α × Bool)}
    {l : α × Bool} (hm : l ∈ FreeGroup.reduce L) : l ∈ L := by
  exact red_mem (FreeGroup.reduce.red (L := L)) hm

lemma toWord_mul_mem {α : Type*} [DecidableEq α] (x y : FreeGroup α)
    {l : α × Bool} (hm : l ∈ (x * y).toWord) : l ∈ x.toWord ∨ l ∈ y.toWord := by
  rw [FreeGroup.toWord_mul] at hm
  have h := reduce_mem (L := x.toWord ++ y.toWord) hm
  exact List.mem_append.mp h

lemma invRev_mem {α : Type*} (W : List (α × Bool)) {l : α × Bool}
    (hm : l ∈ FreeGroup.invRev W) : ∃ b : Bool, (l.1, b) ∈ W := by
  have hm' : l ∈ (W.map (fun g : α × Bool => (g.1, !g.2))).reverse := by
    simpa [FreeGroup.invRev] using hm
  have hm'' : l ∈ W.map (fun g : α × Bool => (g.1, !g.2)) := by
    simpa [List.mem_reverse] using hm'
  rcases List.mem_map.mp hm'' with ⟨g, hg, hmap⟩
  refine ⟨g.2, ?_⟩
  have hg1 : g.1 = l.1 := by
    have hc := congrArg Prod.fst hmap
    simpa using hc
  rw [← hg1]
  simpa using hg

/-! ## 2. Images of short length are single signed letters -/

lemma image_norm_one {n : ℕ} (α : MulAut (FreeGroup (Fin n))) (i : Fin n)
    (h : FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) :
    FreeGroup.norm (α (FreeGroup.of i)) = 1 := by
  have hne : α (FreeGroup.of i) ≠ 1 := image_of_ne_one α i
  have hnz : FreeGroup.norm (α (FreeGroup.of i)) ≠ 0 := by
    intro hz
    exact hne (FreeGroup.norm_eq_zero.mp hz)
  omega

noncomputable def shortData {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) : Fin n → Fin n × Bool :=
  fun i => Classical.choose (toWord_singleton_of_norm_eq_one (image_of_ne_one α i)
    (image_norm_one α i (hshort i)))

lemma shortData_spec {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) (i : Fin n) :
    (α (FreeGroup.of i)).toWord = [(shortData α hshort i)] := by
  unfold shortData
  exact Classical.choose_spec (toWord_singleton_of_norm_eq_one (image_of_ne_one α i)
    (image_norm_one α i (hshort i)))

/-- the coordinate of the short image `α(a_i)` -/
noncomputable def shortCoord {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) : Fin n → Fin n :=
  fun i => (shortData α hshort i).1

/-- the sign of the short image `α(a_i)` -/
noncomputable def shortSign {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) : Fin n → Bool :=
  fun i => (shortData α hshort i).2

lemma shortCoord_eq {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) (i : Fin n) :
    (shortData α hshort i) = (shortCoord α hshort i, shortSign α hshort i) := by
  unfold shortCoord shortSign
  cases shortData α hshort i with
  | mk a b => rfl

lemma shortData_toWord {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) (i : Fin n) :
    (α (FreeGroup.of i)).toWord = [(shortCoord α hshort i, shortSign α hshort i)] := by
  rw [← shortCoord_eq α hshort i]
  exact shortData_spec α hshort i

lemma shortData_value {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) (i : Fin n) :
    α (FreeGroup.of i) =
      (if shortSign α hshort i then FreeGroup.of (shortCoord α hshort i)
        else (FreeGroup.of (shortCoord α hshort i))⁻¹) := by
  by_cases hs : shortSign α hshort i = true
  · -- sign true: word [(c, true)]
    have hw : (α (FreeGroup.of i)).toWord =
        [(shortCoord α hshort i, true)] := by
      simpa [hs] using shortData_toWord α hshort i
    have hx : α (FreeGroup.of i) = FreeGroup.of (shortCoord α hshort i) := by
      exact eq_of_of_singleton_true (α (FreeGroup.of i)) hw
    rw [if_pos hs]
    exact hx
  · -- sign false
    have hsf : shortSign α hshort i = false := Bool.eq_false_of_not_eq_true hs
    have hw : (α (FreeGroup.of i)).toWord =
        [(shortCoord α hshort i, false)] := by
      simpa [hsf] using shortData_toWord α hshort i
    have hx : α (FreeGroup.of i) = (FreeGroup.of (shortCoord α hshort i))⁻¹ := by
      exact eq_inv_of_singleton_false (α (FreeGroup.of i)) hw
    rw [if_neg (by simpa [hsf] using hs)]
    exact hx

/-! ## 3. The coordinate map is surjective -/

def coordRangeProp {n : ℕ} (σ : Fin n → Fin n) (x : FreeGroup (Fin n)) : Prop :=
  ∀ l : Fin n × Bool, l ∈ x.toWord → l.1 ∈ Set.range σ

lemma coordRange_one {n : ℕ} (σ : Fin n → Fin n) : coordRangeProp σ 1 := by
  intro l hl
  rw [FreeGroup.toWord_one] at hl
  simp at hl

lemma coordRange_mul {n : ℕ} (σ : Fin n → Fin n)
    (x y : FreeGroup (Fin n)) (hx : coordRangeProp σ x) (hy : coordRangeProp σ y) :
    coordRangeProp σ (x * y) := by
  intro l hl
  rcases toWord_mul_mem x y hl with hlx | hly
  · exact hx l hlx
  · exact hy l hly

lemma coordRange_inv {n : ℕ} (σ : Fin n → Fin n)
    (x : FreeGroup (Fin n)) (hx : coordRangeProp σ x) : coordRangeProp σ x⁻¹ := by
  intro l hl
  rw [FreeGroup.toWord_inv] at hl
  rcases invRev_mem (x.toWord) hl with ⟨b, hb⟩
  exact hx (l.1, b) hb

theorem shortCoord_surjective {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) :
    Function.Surjective (shortCoord α hshort) := by
  classical
  intro k
  let σ : Fin n → Fin n := shortCoord α hshort
  let C : Subgroup (FreeGroup (Fin n)) :=
    Subgroup.closure (Set.range (fun j : Fin n => α (FreeGroup.of j)))
  have hP : ∀ x : FreeGroup (Fin n), x ∈ C → coordRangeProp σ x := by
    intro x hx
    refine Subgroup.closure_induction
      (k := Set.range (fun j : Fin n => α (FreeGroup.of j)))
      (p := fun g _ => coordRangeProp σ g) ?mem ?one ?mul ?inv (x := x) hx
    · intro g hg
      rcases hg with ⟨j, rfl⟩
      intro l hl
      rw [shortData_toWord α hshort j] at hl
      have hls : l = (shortCoord α hshort j, shortSign α hshort j) := by
        simpa using hl
      subst l
      exact ⟨j, by simp [σ]⟩
    · exact coordRange_one σ
    · intro x y hx hy hpx hpy
      exact coordRange_mul σ x y hpx hpy
    · intro x hx hpx
      exact coordRange_inv σ x hpx
  have hmemb : FreeGroup.of k ∈ C := basis_generates n α k
  have hPk : coordRangeProp σ (FreeGroup.of k) := hP (FreeGroup.of k) hmemb
  have hsingle : (k, true) ∈ (FreeGroup.of k).toWord := by simp
  exact hPk (k, true) hsingle

/-! ## 4. Surjective coordinate maps on `Fin n` are permutations -/

lemma shortCoord_bijective {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) :
    Function.Bijective (shortCoord α hshort) := by
  classical
  let σ : Fin n → Fin n := shortCoord α hshort
  have hsurj : Function.Surjective σ := by
    simpa [σ] using shortCoord_surjective α hshort
  have himage : (Finset.univ.image σ) = (Finset.univ : Finset (Fin n)) := by
    ext y
    constructor
    · intro hy
      simp
    · intro hy
      rcases hsurj y with ⟨x, hx⟩
      rw [Finset.mem_image]
      exact ⟨x, by simp, hx⟩
  have hcard : (Finset.univ.image σ).card = (Finset.univ : Finset (Fin n)).card := by
    rw [himage]
  have hinjOn : Set.InjOn σ (↑(Finset.univ : Finset (Fin n)) : Set (Fin n)) :=
    Finset.injOn_of_card_image_eq hcard
  refine ⟨?_, hsurj⟩
  intro a b hab
  exact hinjOn (by simp) (by simp) hab

/-! ## 5. Short images make `α` a signed permutation -/

theorem short_images_signed {n : ℕ} (α : MulAut (FreeGroup (Fin n)))
    (hshort : ∀ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) ≤ 1) :
    IsSignedPermutation α := by
  classical
  let σ : Fin n → Fin n := shortCoord α hshort
  let s : Fin n → Bool := shortSign α hshort
  have hbij : Function.Bijective σ := by
    simpa [σ] using shortCoord_bijective α hshort
  let σe : Equiv.Perm (Fin n) := Equiv.ofBijective σ hbij
  have hhom : (α : FreeGroup (Fin n) →* FreeGroup (Fin n)) = (signedAutHom σe s) := by
    apply FreeGroup.ext_hom
    intro i
    change α (FreeGroup.of i) = (signedAutHom σe s) (FreeGroup.of i)
    rw [shortData_value α hshort i]
    simp [signedAutHom]
    have hσe : σe i = σ i := rfl
    rw [hσe]
  have hEq : α = signedAut σe s := by
    ext x
    change (α : FreeGroup (Fin n) →* FreeGroup (Fin n)) x =
      (signedAutHom σe s) x
    rw [← hhom]
  exact ⟨σe, s, hEq⟩
end Submission.Nielsen
