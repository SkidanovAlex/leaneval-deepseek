/-- The inclusion `closure ≤ ⊤` is trivial. -/
lemma aut_nielsen_le (n : ℕ) :
    Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) ≤ ⊤ := by
  intro g hg
  trivial

/-- Every Nielsen generator lies in the subgroup it generates. -/
lemma autGen_subset_closure (n : ℕ) :
    (AutGen n : Set (MulAut (FreeGroup (Fin n)))) ⊆
      Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) := by
  intro g hg
  exact Subgroup.subset_closure hg

/-!
**Warning.**  An earlier version of this file conjectured the "gradient-descent
reduction lemma": every automorphism which is *not* a signed permutation admits
an elementary generator `g ∈ AutGen n` with `N (α * g) < N (α)`.  That lemma is
FALSE (`Submission/Work/LongArm.lean` gives a machine-checked counterexample),
so it has been deleted.  Any future proof of `aut_nielsen` must follow the
transitive-action-on-bases route described in the module documentation (the
lexicographic / "balanced move" analysis), not a plain `N`-descent.
-/

/- The hard inclusion of Nielsen's theorem (Nielsen 1924; Lyndon–Schupp
Prop. I.4.1, Magnus–Karrass–Solitar Thm. 3.2).

    Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) = ⊤

State of the proof (as of the SignedClosure milestone):

  * the *signed-permutation base case* is fully proved in
    `Submission/Work/SignedClosure.lean`
    (`signedAut_mem_closure`, `signedPermutation_mem_closure`): every
    basis-permutation automorphism and every sign-flip automorphism lies in
    the closure;

  * still open is the classical word-combinatorial core: from any free basis
    of `F_n` which is not a signed-permutation basis one must produce an
    elementary-move sequence which is non-increasing in the total reduced
    length and strictly decreases a lexicographic energy (the classical
    "unbalanced / balanced side" analysis).  The naive total-length gradient
    descent is FALSE (`Submission/Work/LongArm.lean`), so any formal proof
    must be written from a reliable text of the classical argument.  Do NOT
    guess this lemma. -/
/-! The theorem itself is proved in `Submission/Work/NielsenTheorem.lean`
(the proof needs the energy-descent machinery of the later modules, which in
turn import this file, so it cannot live here without an import cycle):

    theorem aut_nielsen (n : ℕ) :
        Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) = ⊤

via `aut_nielsen_of_symFallTwoEnergyStep (symFallTwoEnergyStep n)`
(`Item3/SymFallTwo.lean`). -/

end

end Submission.Nielsen
