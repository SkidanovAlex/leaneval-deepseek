import Submission.FreeGroupAut
import Mathlib.GroupTheory.FreeGroup.Reduce

open Submission.FreeGroupAut
set_option autoImplicit false

/-!
# Nielsen's theorem for `Aut(F_n)`: generators of the automorphism group

The theorem needed by the property-(T) project is that the concrete symmetric
generating set `AutGen n` (right/left Nielsen transvections with exponent ±1 on
all ordered pairs `(i,j)`, `i ≠ j`, together with all single-generator
inversions `sigma i`) generates the whole automorphism group:

    theorem aut_nielsen (n : ℕ) :
        Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n)))) = ⊤

This is Nielsen's 1924 theorem (the `⊤ ≤ closure` inclusion is the content;
`closure ≤ ⊤` is trivial).  The classical proof of the `≤` inclusion is *not*
a naive gradient descent of the total reduced length `N(α) = ∑ᵢ |α(xᵢ)|`:
the naive descent statement (minimality of `N` under right composition by all
elementary generators forces every image to be a single letter) is FALSE — see
`Submission/Work/LongArm.lean`, which contains a machine-checked counterexample
(an automorphism of `F_3` whose images have reduced lengths `(2,2,3)`, with no
elementary right-composition shortening `N`, which is not a signed permutation:
the classical "peak" phenomenon).

The correct classical route shows instead that the elementary transformations
act *transitively on the free bases of `F_n`* (every basis is reachable from
the standard basis by a sequence of elementary moves — the sequence may
temporarily increase `N`, and termination is controlled by a lexicographic
measure rather than by `N` alone).  Ingredients that are already available:
  - the move calculus: `N`, the effect of a transvection on the images and on
    `N` (`mul_rho_apply_*`, `N_mul_rho`, …), the length/cancellation lemmas in
    `Submission/Work/NielsenCore.lean`, the signed-permutation normal form in
    `Submission/Work/SignedPerm.lean`, and — `Submission/Work/Transpositions.lean` —
    explicit words realising every basis transposition `τᵢⱼ = σᵢ·λᵢⱼ·λⱼᵢ⁻¹·ρᵢⱼ`
    together with `tau_mem_closure` (the permutation automorphisms lie in the
    subgroup generated by `AutGen n`).  `Submission/Work/SignedClosure.lean`
    completes the *signed-permutation base case* of the reduction: every
    signed permutation automorphism (`permAut σ * flipSign s`) lies in the
    closure (`permAut_mem_closure`, `flipSign_mem_closure`,
    `signedPermutation_mem_closure`).
  - what remains open is the word-combinatorial core of the transitivity
    theorem (the analogue of the classical "unbalanced/balanced side" analysis:
    from any non-single-letter basis one can find a *sequence* of elementary
    moves, non-increasing in total length, that strictly decreases a suitable
    lexicographic measure).

This file records the precise statements of the easy structural facts, the
definitions (`N`, the effect of a transvection on `N`) needed by any such
proof, and the target theorem `aut_nielsen`.


-/
namespace Submission.Nielsen

noncomputable section

open scoped BigOperators
open FreeGroup

/-- Total reduced length of the images of the basis under `α`. -/
def N {n : ℕ} (α : MulAut (FreeGroup (Fin n))) : ℕ :=
  ∑ i : Fin n, FreeGroup.norm (α (FreeGroup.of i))

lemma N_eq_sum {n : ℕ} (α : MulAut (FreeGroup (Fin n))) :
    N α = ∑ i : Fin n, FreeGroup.norm (α (FreeGroup.of i)) := rfl

/-- Composing with a right Nielsen transvection on the right changes only the
`i`-th image, from `w_i` to `w_i * w_j`. -/
lemma mul_rho_apply_self {n : ℕ} (α : MulAut (FreeGroup (Fin n))) (i j : Fin n) (hij : i ≠ j) :
    (α * rho i j hij) (FreeGroup.of i) = (α (FreeGroup.of i)) * (α (FreeGroup.of j)) := by
  simp [rho_apply_self]

lemma mul_rho_apply_other {n : ℕ} (α : MulAut (FreeGroup (Fin n))) {i j k : Fin n}
    (hij : i ≠ j) (hk : k ≠ i) :
    (α * rho i j hij) (FreeGroup.of k) = α (FreeGroup.of k) := by
  simp [rho_apply_other hij hk]

/-- The effect of a right transvection on the total length. -/
lemma N_mul_rho {n : ℕ} (α : MulAut (FreeGroup (Fin n))) (i j : Fin n) (hij : i ≠ j) :
    N (α * rho i j hij) = N α - FreeGroup.norm (α (FreeGroup.of i))
      + FreeGroup.norm ((α (FreeGroup.of i)) * (α (FreeGroup.of j))) := by
  classical
  let g : Fin n → ℕ := fun k => FreeGroup.norm ((α * rho i j hij) (FreeGroup.of k))
  let h : Fin n → ℕ := fun k => FreeGroup.norm (α (FreeGroup.of k))
  have hmain : ∀ k : Fin n, k ≠ i → g k = h k := by
    intro k hk
    exact congrArg FreeGroup.norm (mul_rho_apply_other (α := α) hij hk)
  have hgi : g i = FreeGroup.norm ((α (FreeGroup.of i)) * (α (FreeGroup.of j))) := by
    simpa [g] using congrArg FreeGroup.norm (mul_rho_apply_self α i j hij)
  have hhi : h i = FreeGroup.norm (α (FreeGroup.of i)) := rfl
  rw [N_eq_sum, N_eq_sum]
  have hsplit : ∀ (w : Fin n → ℕ),
      (∑ k : Fin n, w k) = (∑ k ∈ (Finset.univ.erase i : Finset (Fin n)), w k) + w i := by
    intro w
    exact (Finset.sum_erase_add (Finset.univ : Finset (Fin n)) w (Finset.mem_univ i)).symm
  rw [hsplit g, hsplit h]
  rw [hgi, hhi]
  have hrest : (∑ k ∈ (Finset.univ.erase i : Finset (Fin n)), g k)
      = ∑ k ∈ (Finset.univ.erase i : Finset (Fin n)), h k := by
    apply Finset.sum_congr rfl
    intro k hk
    exact hmain k (Finset.mem_erase.mp hk).1
  rw [hrest]
  omega

/-- Composing with a left Nielsen transvection on the right changes only the
`i`-th image, from `w_i` to `w_j * w_i`. -/
lemma mul_lam_apply_self {n : ℕ} (α : MulAut (FreeGroup (Fin n))) (i j : Fin n) (hij : i ≠ j) :
    (α * lam i j hij) (FreeGroup.of i) = (α (FreeGroup.of j)) * (α (FreeGroup.of i)) := by
  simp [lam_apply_self]

