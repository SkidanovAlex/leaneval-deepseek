import Submission.Work.Transpositions
import Submission.Work.SignedPerm
import Mathlib.GroupTheory.Perm.ClosureSwap

open Submission.FreeGroupAut
open FreeGroup
set_option autoImplicit false

/-!
# Signed permutations lie in the subgroup generated by `AutGen n`

This file proves the base case of Nielsen's reduction: every *signed
permutation* automorphism of `F_n` (an automorphism sending each basis
generator to a single basis generator or its inverse) lies in the subgroup
generated by the Nielsen generating set `AutGen n`.

Structure of the proof:

1. `permAut σ` is the automorphism permuting the basis by the permutation
   `σ : Equiv.Perm (Fin n)` (`aᵢ ↦ a_{σ i}`).  A transposition of the basis is
   exactly the automorphism `tau i j` of `Transpositions.lean`, and every
   permutation of a finite set is a product of transpositions
   (`Equiv.Perm.mem_closure_isSwap'`), so `permAut σ ∈ closure(AutGen n)`.

2. `flipSign s` is the automorphism sending `aᵢ ↦ aᵢ` when `s i = true` and
   `aᵢ ↦ aᵢ⁻¹` when `s i = false`.  It is the product (in any order) of the
   single-generator inversions `sigma i` over the indices where `s i = false`,
   and each `sigma i ∈ closure(AutGen n)`.

3. Every signed permutation factors: `signedAut σ s = permAut σ * flipSign s`,
   so it belongs to the closure as well.
-/

namespace Submission.Nielsen

noncomputable section

variable {n : ℕ}

/-- The subgroup of `Aut(F_n)` generated by `AutGen n`. -/
abbrev AutClosure (n : ℕ) : Subgroup (MulAut (FreeGroup (Fin n))) :=
  Subgroup.closure (AutGen n : Set (MulAut (FreeGroup (Fin n))))

/-- The endomorphism of `F_n` permuting the basis by `σ`. -/
def permAutHom (σ : Equiv.Perm (Fin n)) : FreeGroup (Fin n) →* FreeGroup (Fin n) :=
  FreeGroup.lift (fun k : Fin n => FreeGroup.of (σ k))

lemma permAutHom_apply_of (σ : Equiv.Perm (Fin n)) (k : Fin n) :
    permAutHom σ (FreeGroup.of k) = FreeGroup.of (σ k) := by
  simp [permAutHom]

/-- The permutation endomorphism of the identity is the identity. -/
lemma permAutHom_one : permAutHom (1 : Equiv.Perm (Fin n)) = MonoidHom.id (FreeGroup (Fin n)) := by
  apply FreeGroup.ext_hom
  intro k
  rw [permAutHom_apply_of]
  simp

/-- Composition of permutation endomorphisms is the endomorphism of the product
permutation. -/
lemma permAutHom_comp (σ τ : Equiv.Perm (Fin n)) :
    (permAutHom σ).comp (permAutHom τ) = permAutHom (σ * τ) := by
  apply FreeGroup.ext_hom
  intro k
  change (permAutHom σ) ((permAutHom τ) (FreeGroup.of k)) =
      (permAutHom (σ * τ)) (FreeGroup.of k)
  rw [permAutHom_apply_of, permAutHom_apply_of, permAutHom_apply_of]
  rw [Equiv.Perm.mul_apply]

/-- The permutation endomorphism of an inverse is the inverse endomorphism. -/
lemma permAutHom_comp_symm (σ : Equiv.Perm (Fin n)) :
    (permAutHom σ⁻¹).comp (permAutHom σ) = MonoidHom.id (FreeGroup (Fin n)) := by
  apply FreeGroup.ext_hom
  intro k
  change (permAutHom σ⁻¹) ((permAutHom σ) (FreeGroup.of k)) = FreeGroup.of k
  rw [permAutHom_apply_of, permAutHom_apply_of]
  congr 1
  calc
    σ⁻¹ (σ k) = σ.symm (σ k) := by rfl
    _ = k := Equiv.symm_apply_apply σ k

/-- The permutation endomorphism of an inverse is the inverse endomorphism
(other order). -/
lemma permAutHom_comp_symm' (σ : Equiv.Perm (Fin n)) :
    (permAutHom σ).comp (permAutHom σ⁻¹) = MonoidHom.id (FreeGroup (Fin n)) := by
  apply FreeGroup.ext_hom
  intro k
  change (permAutHom σ) ((permAutHom σ⁻¹) (FreeGroup.of k)) = FreeGroup.of k
  rw [permAutHom_apply_of, permAutHom_apply_of]
  congr 1
  calc
    σ (σ⁻¹ k) = σ (σ.symm k) := by rfl
    _ = k := Equiv.apply_symm_apply σ k

/-- The automorphism of `F_n` permuting the basis by `σ`. -/
def permAut (σ : Equiv.Perm (Fin n)) : MulAut (FreeGroup (Fin n)) where
  toFun := permAutHom σ
  invFun := permAutHom σ⁻¹
  left_inv x := by
    have h := congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x)
      (permAutHom_comp_symm σ)
    simpa using h
  right_inv x := by
    have h := congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x)
      (permAutHom_comp_symm' σ)
    simpa using h
  map_mul' x y := (permAutHom σ).map_mul x y

lemma permAut_apply_of (σ : Equiv.Perm (Fin n)) (k : Fin n) :
    (permAut σ) (FreeGroup.of k) = FreeGroup.of (σ k) := by
  change permAutHom σ (FreeGroup.of k) = FreeGroup.of (σ k)
  exact permAutHom_apply_of σ k

/-- `permAut` maps the identity to the identity automorphism. -/
lemma permAut_one : permAut (1 : Equiv.Perm (Fin n)) = 1 := by
  have hhom : (permAut (1 : Equiv.Perm (Fin n)) : FreeGroup (Fin n) →* FreeGroup (Fin n))
      = ((1 : MulAut (FreeGroup (Fin n))) : FreeGroup (Fin n) →* FreeGroup (Fin n)) := by
    apply FreeGroup.ext_hom
    intro k
    simp [permAut, permAutHom]
  ext x
  exact congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x) hhom

/-- `permAut` is a homomorphism. -/
lemma permAut_mul (σ τ : Equiv.Perm (Fin n)) :
    permAut σ * permAut τ = permAut (σ * τ) := by
  have hhom : ((permAut σ * permAut τ : MulAut (FreeGroup (Fin n))) :
        FreeGroup (Fin n) →* FreeGroup (Fin n))
      = ((permAut (σ * τ) : MulAut (FreeGroup (Fin n))) :
        FreeGroup (Fin n) →* FreeGroup (Fin n)) := by
    apply FreeGroup.ext_hom
    intro k
    change (permAut σ) ((permAut τ) (FreeGroup.of k)) = permAut (σ * τ) (FreeGroup.of k)
    rw [permAut_apply_of, permAut_apply_of, permAut_apply_of]
    rw [Equiv.Perm.mul_apply]
  ext x
  exact congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x) hhom

/-- The inverse of `permAut σ` is `permAut σ⁻¹`. -/
lemma permAut_inv (σ : Equiv.Perm (Fin n)) :
    (permAut σ)⁻¹ = permAut σ⁻¹ := by
  ext x
  rfl

/-- `permAut` of the transposition `swap i j` swaps the two basis generators. -/
lemma permAut_swap (i j : Fin n) (hij : i ≠ j) :
    permAut (Equiv.swap i j) = tau i j hij := by
  have hgen : ∀ k : Fin n,
      (permAut (Equiv.swap i j)) (FreeGroup.of k) = (tau i j hij) (FreeGroup.of k) := by
    intro k
    by_cases hki : k = i
    · subst k
      rw [permAut_apply_of, tau_apply_i i j hij]
      simp
    · by_cases hkj : k = j
      · subst k
        rw [permAut_apply_of, tau_apply_j i j hij]
        simp
      · have hksw : (Equiv.swap i j) k = k := Equiv.swap_apply_of_ne_of_ne hki hkj
        rw [permAut_apply_of, hksw]
        exact (tau_apply_other (hij := hij) (hki := hki) (hkj := hkj)).symm
  have hhom : ((permAut (Equiv.swap i j) : MulAut (FreeGroup (Fin n))) :
        FreeGroup (Fin n) →* FreeGroup (Fin n))
      = ((tau i j hij : MulAut (FreeGroup (Fin n))) :
        FreeGroup (Fin n) →* FreeGroup (Fin n)) := by
    apply FreeGroup.ext_hom
    intro k
    exact hgen k
  ext x
  exact congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x) hhom

/-- The permutations whose automorphism lies in `AutClosure n`. -/
def permAutSubgroup (n : ℕ) : Subgroup (Equiv.Perm (Fin n)) where
  carrier := {σ : Equiv.Perm (Fin n) | permAut σ ∈ AutClosure n}
  one_mem' := by
    change permAut (1 : Equiv.Perm (Fin n)) ∈ AutClosure n
    rw [permAut_one]
    exact (AutClosure n).one_mem
  mul_mem' := by
    intro σ τ hσ hτ
    change permAut σ ∈ AutClosure n at hσ
    change permAut τ ∈ AutClosure n at hτ
    change permAut (σ * τ) ∈ AutClosure n
    rw [← permAut_mul]
    exact (AutClosure n).mul_mem hσ hτ
  inv_mem' := by
    intro σ hσ
    change permAut σ ∈ AutClosure n at hσ
    change permAut σ⁻¹ ∈ AutClosure n
    rw [← permAut_inv]
    exact (AutClosure n).inv_mem hσ

/-- Every basis transposition lies in `permAutSubgroup`. -/
lemma swap_mem_permAutSubgroup (n : ℕ) {i j : Fin n} (hij : i ≠ j) :
    Equiv.swap i j ∈ permAutSubgroup n := by
  change permAut (Equiv.swap i j) ∈ AutClosure n
  rw [permAut_swap i j hij]
  exact tau_mem_closure n hij

/-- Every transposition (in the sense of `IsSwap`) lies in `permAutSubgroup`. -/
lemma isSwap_mem_permAutSubgroup (n : ℕ) {σ : Equiv.Perm (Fin n)} (hσ : σ.IsSwap) :
    σ ∈ permAutSubgroup n := by
  classical
  rcases hσ with ⟨x, y, hxy, hσ⟩
  subst σ
  exact swap_mem_permAutSubgroup n hxy

/-- Every permutation of `Fin n` lies in `permAutSubgroup` (finite case:
transpositions generate the symmetric group). -/
lemma mem_permAutSubgroup (n : ℕ) (σ : Equiv.Perm (Fin n)) : σ ∈ permAutSubgroup n := by
  classical
  have hle : Subgroup.closure {τ : Equiv.Perm (Fin n) | τ.IsSwap} ≤ permAutSubgroup n := by
    rw [Subgroup.closure_le]
    intro τ hτ
    exact isSwap_mem_permAutSubgroup n hτ
  have hσ : σ ∈ Subgroup.closure {τ : Equiv.Perm (Fin n) | τ.IsSwap} := by
    rw [mem_closure_isSwap']
    exact Set.toFinite ((MulAction.fixedBy (Fin n) σ)ᶜ)
  exact hle hσ

/-- Every basis-permutation automorphism lies in the subgroup generated by
`AutGen n`. -/
theorem permAut_mem_closure (n : ℕ) (σ : Equiv.Perm (Fin n)) :
    permAut σ ∈ AutClosure n := by
  exact mem_permAutSubgroup n σ

/-- `flipSign s`: the automorphism inverting exactly the basis generators on
which `s` is `false`. -/
def flipSign (s : Fin n → Bool) : MulAut (FreeGroup (Fin n)) :=
  signedAut (1 : Equiv.Perm (Fin n)) s

lemma flipSign_apply (s : Fin n → Bool) (k : Fin n) :
    flipSign s (FreeGroup.of k) =
      if s k then FreeGroup.of k else (FreeGroup.of k)⁻¹ := by
  unfold flipSign
  rw [signedAut_apply]
  cases s k <;> simp

/-- `sigma i` on a basis generator: invert if `i = k`, fix otherwise. -/
lemma sigma_apply_of {i k : Fin n} :
    (sigma i : MulAut (FreeGroup (Fin n))) (FreeGroup.of k) =
      if k = i then (FreeGroup.of k)⁻¹ else FreeGroup.of k := by
  by_cases hki : k = i
  · subst k
    simp [sigma_apply_self]
  · simp [hki, sigma_apply_other hki]

/-- `sigma i` on the inverse of a basis generator. -/
lemma sigma_apply_inv_of {i k : Fin n} :
    (sigma i : MulAut (FreeGroup (Fin n))) ((FreeGroup.of k)⁻¹) =
      if k = i then FreeGroup.of k else (FreeGroup.of k)⁻¹ := by
  by_cases hki : k = i
  · subst k
    have hm : (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) ((FreeGroup.of i)⁻¹)
        = ((sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) (FreeGroup.of i))⁻¹ := by
      exact (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)).map_inv (FreeGroup.of i)
    have hcalc : (sigma i) ((FreeGroup.of i)⁻¹) = FreeGroup.of i := by
      calc
        (sigma i) ((FreeGroup.of i)⁻¹)
            = (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) ((FreeGroup.of i)⁻¹) := by
              rfl
        _ = ((sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) (FreeGroup.of i))⁻¹ := hm
        _ = ((sigma i) (FreeGroup.of i))⁻¹ := by rfl
        _ = FreeGroup.of i := by
          rw [sigma_apply_self]
          simp
    rw [hcalc]
    simp
  · have hm : (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) ((FreeGroup.of k)⁻¹)
        = ((sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) (FreeGroup.of k))⁻¹ := by
      exact (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)).map_inv (FreeGroup.of k)
    have hcalc : (sigma i) ((FreeGroup.of k)⁻¹) = (FreeGroup.of k)⁻¹ := by
      calc
        (sigma i) ((FreeGroup.of k)⁻¹)
            = (sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) ((FreeGroup.of k)⁻¹) := by
              rfl
        _ = ((sigma i : FreeGroup (Fin n) →* FreeGroup (Fin n)) (FreeGroup.of k))⁻¹ := hm
        _ = ((sigma i) (FreeGroup.of k))⁻¹ := by rfl
        _ = (FreeGroup.of k)⁻¹ := by
          rw [sigma_apply_other hki]
    rw [hcalc]
    simp [hki]

/-- A product of distinct `sigma`'s inverts exactly the basis generators whose
index occurs in the list. -/
lemma listProd_sigma_apply {L : List (Fin n)} (hL : L.Nodup) (k : Fin n) :
    (List.prod (L.map (fun j : Fin n => sigma j)) : MulAut (FreeGroup (Fin n)))
        (FreeGroup.of k) =
      if k ∈ L then (FreeGroup.of k)⁻¹ else FreeGroup.of k := by
  induction L with
  | nil =>
      simp
  | cons a t ih =>
      rw [List.map_cons, List.prod_cons]
      change (sigma a : MulAut (FreeGroup (Fin n)))
          ((List.prod (t.map (fun j : Fin n => sigma j)) : MulAut (FreeGroup (Fin n)))
            (FreeGroup.of k))
        = if k ∈ a :: t then (FreeGroup.of k)⁻¹ else FreeGroup.of k
      have hnd : List.Nodup t := (List.nodup_cons.mp hL).2
      have ih' : (List.prod (t.map (fun j : Fin n => sigma j)) : MulAut (FreeGroup (Fin n)))
            (FreeGroup.of k) = if k ∈ t then (FreeGroup.of k)⁻¹ else FreeGroup.of k :=
        ih hnd
      rw [ih']
      by_cases hka : k = a
      · have hkt0 : k ∉ t := by
          intro ht
          exact (List.nodup_cons.mp hL).1 (by simpa [hka] using ht)
        rw [if_neg hkt0]
        rw [sigma_apply_of]
        rw [if_pos hka]
        rw [if_pos (by exact List.mem_cons.mpr (Or.inl hka))]
      · by_cases hkt : k ∈ t
        · rw [if_pos hkt]
          rw [sigma_apply_inv_of]
          rw [if_neg hka]
          rw [if_pos (by exact List.mem_cons.mpr (Or.inr hkt))]
        · rw [if_neg hkt]
          rw [sigma_apply_of]
          rw [if_neg hka]
          have hmem0 : ¬ k ∈ a :: t := by
            intro hm
            rcases List.mem_cons.mp hm with h | ht
            · exact hka h
            · exact hkt ht
          rw [if_neg hmem0]

/-- The indices on which `s` is `false`, as a list. -/
def badList (s : Fin n → Bool) : List (Fin n) :=
  (Finset.univ.filter (fun j : Fin n => s j = false)).toList

lemma badList_mem (s : Fin n → Bool) (k : Fin n) : k ∈ badList s ↔ s k = false := by
  classical
  unfold badList
  rw [Finset.mem_toList, Finset.mem_filter]
  simp

/-- `flipSign s` is the product of the single-generator inversions at the
`false` positions of `s`. -/
lemma flipSign_eq_listProd (s : Fin n → Bool) :
    flipSign s = List.prod ((badList s).map (fun j : Fin n => sigma j)) := by
  classical
  have hnodup : (badList s).Nodup := Finset.nodup_toList _
  have hhom : (flipSign s : FreeGroup (Fin n) →* FreeGroup (Fin n))
      = ((List.prod ((badList s).map (fun j : Fin n => sigma j)) : MulAut (FreeGroup (Fin n))) :
          FreeGroup (Fin n) →* FreeGroup (Fin n)) := by
    apply FreeGroup.ext_hom
    intro k
    change (flipSign s : MulAut (FreeGroup (Fin n))) (FreeGroup.of k)
        = (List.prod ((badList s).map (fun j : Fin n => sigma j)) : MulAut (FreeGroup (Fin n)))
            (FreeGroup.of k)
    rw [flipSign_apply]
    have hact := listProd_sigma_apply hnodup k
    rw [hact]
    by_cases hs : s k = true
    · have hnb : ¬ k ∈ badList s := by
        intro hkb
        have hsf : s k = false := (badList_mem s k).mp hkb
        rw [hs] at hsf
        exact Bool.noConfusion hsf
      rw [if_pos hs]
      rw [if_neg hnb]
    · have hsf : s k = false := Bool.eq_false_of_not_eq_true hs
      have hkb : k ∈ badList s := (badList_mem s k).mpr hsf
      rw [if_neg hs]
      rw [if_pos hkb]
  ext x
  exact congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x) hhom

/-- Any list product of `sigma i`'s lies in the subgroup generated by
`AutGen n`. -/
lemma listProd_sigma_mem_closure (n : ℕ) (L : List (Fin n)) :
    List.prod (L.map (fun j : Fin n => sigma j)) ∈ AutClosure n := by
  induction L with
  | nil =>
      rw [List.map_nil, List.prod_nil]
      exact (AutClosure n).one_mem
  | cons a t ih =>
      rw [List.map_cons, List.prod_cons]
      exact (AutClosure n).mul_mem (Subgroup.subset_closure (sigma_mem_AutGen n a)) ih

/-- Every sign flip lies in the subgroup generated by `AutGen n`. -/
theorem flipSign_mem_closure (n : ℕ) (s : Fin n → Bool) :
    flipSign s ∈ AutClosure n := by
  rw [flipSign_eq_listProd s]
  exact listProd_sigma_mem_closure n (badList s)

/-- A signed permutation factors as a basis permutation followed by sign
flips: `signedAut σ s = permAut σ * flipSign s`. -/
lemma signedAut_eq_permAut_mul_flip (σ : Equiv.Perm (Fin n)) (s : Fin n → Bool) :
    signedAut σ s = permAut σ * flipSign s := by
  have hhom : ((signedAut σ s : MulAut (FreeGroup (Fin n))) : FreeGroup (Fin n) →* FreeGroup (Fin n))
      = ((permAut σ * flipSign s : MulAut (FreeGroup (Fin n))) : FreeGroup (Fin n) →* FreeGroup (Fin n)) := by
    apply FreeGroup.ext_hom
    intro k
    change (signedAutHom σ s) (FreeGroup.of k)
        = (permAutHom σ) ((flipSign s) (FreeGroup.of k))
    cases hsk : s k with
    | true =>
        have hL : (signedAutHom σ s) (FreeGroup.of k) = FreeGroup.of (σ k) := by
          rw [signedAutHom, FreeGroup.lift_apply_of]
          simp [hsk]
        have hF : (flipSign s) (FreeGroup.of k) = FreeGroup.of k := by
          rw [flipSign_apply]
          simp [hsk]
        rw [hL, hF]
        rw [permAutHom_apply_of]
    | false =>
        have hL : (signedAutHom σ s) (FreeGroup.of k) = (FreeGroup.of (σ k))⁻¹ := by
          rw [signedAutHom, FreeGroup.lift_apply_of]
          simp [hsk]
        have hF : (flipSign s) (FreeGroup.of k) = (FreeGroup.of k)⁻¹ := by
          rw [flipSign_apply]
          simp [hsk]
        rw [hL, hF]
        rw [(permAutHom σ).map_inv]
        rw [permAutHom_apply_of]
  ext x
  exact congrArg (fun φ : FreeGroup (Fin n) →* FreeGroup (Fin n) => φ x) hhom

/-- Every signed permutation automorphism lies in the subgroup generated by
`AutGen n`. -/
theorem signedAut_mem_closure (n : ℕ) (σ : Equiv.Perm (Fin n)) (s : Fin n → Bool) :
    signedAut σ s ∈ AutClosure n := by
  rw [signedAut_eq_permAut_mul_flip σ s]
  exact (AutClosure n).mul_mem (permAut_mem_closure n σ) (flipSign_mem_closure n s)

/-- Every automorphism which is a signed permutation lies in the subgroup
generated by `AutGen n`. -/
theorem signedPermutation_mem_closure (n : ℕ) {α : MulAut (FreeGroup (Fin n))}
    (hα : IsSignedPermutation α) :
    α ∈ AutClosure n := by
  rcases hα with ⟨σ, s, rfl⟩
  exact signedAut_mem_closure n σ s

end

end Submission.Nielsen
