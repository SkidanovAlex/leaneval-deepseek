import Mathlib

namespace NK.LocalCFT.NilpotentObstruction

open commutatorElement Subgroup

/-- Auxiliary computation: if `B` is a commutative subgroup of `G` with
`B ⊔ commutator G = ⊤`, then the commutator subgroup of `G` equals its commutator
with `G`, i.e. the second and third terms of the lower central series of `G` agree:
`⁅commutator G, ⊤⁆ = commutator G`.

Indeed `⊤ = B ⊔ commutator G`, and every commutator `⁅x, y⁆` of elements
`x = b₁c₁`, `y = b₂c₂` with `bᵢ ∈ B`, `cᵢ ∈ commutator G` can be expanded using
`⁅a * b, c⁆ = a * ⁅b, c⁆ * a⁻¹ * ⁅a, c⁆` and `⁅a, b * c⁆ = ⁅a, b⁆ * b * ⁅a, c⁆ * b⁻¹`
into a product of conjugates of `⁅c, g⁆`, `c ∈ commutator G`, `g ∈ G`
(the terms `⁅b₁, b₂⁆` vanish since `B` is commutative). -/
theorem commutator_eq_sup_commutator_of_abelian_sup_eq_top {G : Type*} [Group G]
    (B : Subgroup G) (hB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x)
    (h : B ⊔ _root_.commutator G = ⊤) :
    ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ = _root_.commutator G := by
  refine le_antisymm ?_ ?_
  · exact Subgroup.commutator_mono le_top le_top
  · show ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ ≤ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆
    rw [Subgroup.commutator_le]
    intro g₁ _ g₂ _
    obtain ⟨b₁, hb₁, c₁, hc₁, rfl⟩ :=
      (Subgroup.mem_sup_of_normal_right (s := B) (t := _root_.commutator G)).mp
        (by rw [h]; exact Subgroup.mem_top g₁)
    obtain ⟨b₂, hb₂, c₂, hc₂, rfl⟩ :=
      (Subgroup.mem_sup_of_normal_right (s := B) (t := _root_.commutator G)).mp
        (by rw [h]; exact Subgroup.mem_top g₂)
    have hK : (⁅_root_.commutator G, (⊤ : Subgroup G)⁆ : Subgroup G).Normal := inferInstance
    have hc1b2 : ⁅c₁, b₂⁆ ∈ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ :=
      Subgroup.commutator_mem_commutator hc₁ (Subgroup.mem_top b₂)
    have hc1c2 : ⁅c₁, c₂⁆ ∈ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ :=
      Subgroup.commutator_mono le_rfl le_top (Subgroup.commutator_mem_commutator hc₁ hc₂)
    have hb1c2 : ⁅b₁, c₂⁆ ∈ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ := by
      rw [← Subgroup.commutator_comm (⊤ : Subgroup G) (_root_.commutator G)]
      exact Subgroup.commutator_mem_commutator (Subgroup.mem_top b₁) hc₂
    have hb1b2 : ⁅b₁, b₂⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (hB b₁ hb₁ b₂ hb₂)
    have hM : ⁅c₁, b₂⁆ * b₂ * ⁅c₁, c₂⁆ * b₂⁻¹ ∈ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ := by
      rw [mul_assoc ⁅c₁, b₂⁆ b₂ ⁅c₁, c₂⁆, mul_assoc ⁅c₁, b₂⁆ (b₂ * ⁅c₁, c₂⁆) b₂⁻¹]
      exact mul_mem hc1b2 (hK.conj_mem _ hc1c2 b₂)
    have hN : b₂ * ⁅b₁, c₂⁆ * b₂⁻¹ ∈ ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ :=
      hK.conj_mem _ hb1c2 b₂
    have h1 := commutatorElement_mul_left_eq_conj_mul b₁ c₁ (b₂ * c₂)
    have h2 := commutatorElement_mul_right_eq_mul_conj c₁ b₂ c₂
    have h3 := commutatorElement_mul_right_eq_mul_conj b₁ b₂ c₂
    rw [h1, h2, h3, hb1b2, one_mul]
    exact mul_mem (hK.conj_mem _ hM b₁) hN

/-- If a nilpotent group `G` is generated by an abelian subgroup `B` together with the
commutator subgroup of `G`, then `G` itself is abelian.

The auxiliary lemma above shows that the second and third terms of the lower central
series of `G` coincide; but `G` is nilpotent, so that series eventually reaches `⊥`, and
hence the commutator subgroup of `G` is trivial. -/
theorem isMulCommutative_of_abelian_sup_commutator_eq_top {G : Type*} [Group G]
    [Group.IsNilpotent G] (B : Subgroup G)
    (hB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x) (h : B ⊔ _root_.commutator G = ⊤) :
    ∀ x y : G, x * y = y * x := by
  have hγ : ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ = _root_.commutator G :=
    commutator_eq_sup_commutator_of_abelian_sup_eq_top B hB h
  obtain ⟨n, hn⟩ := (Subgroup.nilpotent_iff_lowerCentralSeries (G := G)).mp inferInstance
  have hper : ∀ k : ℕ, (⊤ : Subgroup G).lowerCentralSeries (k + 1) = _root_.commutator G := by
    intro k
    induction k with
    | zero => simpa using (Subgroup.top_lowerCentralSeries_one (G := G))
    | succ k ih => rw [Subgroup.lowerCentralSeries_succ, ih, hγ]
  have hant := Subgroup.lowerCentralSeries_antitone (⊤ : Subgroup G) (Nat.le_succ n)
  rw [hper n, hn] at hant
  have hbot : _root_.commutator G = ⊥ := le_bot_iff.mp hant
  intro x y
  have hmem : ⁅x, y⁆ ∈ _root_.commutator G :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
  rw [hbot] at hmem
  exact commutatorElement_eq_one_iff_mul_comm.mp (by simpa using hmem)

end NK.LocalCFT.NilpotentObstruction
