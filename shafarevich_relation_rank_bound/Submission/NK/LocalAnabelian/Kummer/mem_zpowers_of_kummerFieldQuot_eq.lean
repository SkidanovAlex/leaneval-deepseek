# Kummer theory: the fibre of `x ↦ k(x^{1/p})` is the cyclic subgroup generated by `x`

Over a field `k` containing a primitive `p`-th root of unity `ζ` (`p` a prime), the map

  `x ↦ k(x^{1/p})`

from the Kummer class group `kˣ/(kˣ)^p` to the degree-`p` extensions of `k` (realised as
subfields of a fixed separable closure `K'`) is injective up to the action of `(Z/p)ˣ`:
fields which are equal have classes generating the same subgroup of `kˣ/(kˣ)^p`.  Concretely,
if `x` and `y` are non-trivial classes with `k(y^{1/p}) = k(x^{1/p})`, then `y` is a power of `x`.

The proof is the standard one.  Pick `p`-th roots `α` of `a` and `β` of `b` in `K'` (where
`a`, `b` represent `x`, `y`).  The Kummer field `L = k(a^{1/p}) = k(b^{1/p})` is the splitting
field of `X ^ p - a`, hence is Galois of degree `p` over `k`; choosing the automorphism `σ`
of `L` with `σ α = ζ α` (Mathlib's `autEquivZmod`) and writing `σ β = ζ ^ J β`, the element
`α ^ J * β⁻¹` is fixed by `σ`.  Since `Gal(L/k)` has prime order `p`, `σ` generates it, so
`α ^ J * β⁻¹ ∈ k`, whence `a ^ J / b = (α ^ J * β⁻¹) ^ p` is a `p`-th power in `k`, i.e.
`y = x ^ J` in `kˣ/(kˣ)^p`.
-/
import Mathlib
import Submission.NK.LocalAnabelian.Kummer.Quot
import Submission.NK.LocalAnabelian.Kummer.kummerField_eq_of_div_mem_powSubgroup

set_option linter.style.haveILetI false

open Polynomial IntermediateField
open scoped Classical

namespace NK.LocalAnabelian.Kummer

variable {k K' : Type*} [Field k] [Field K'] [Algebra k K']

/-- **The Kummer field is the splitting field of `X ^ p - C a`.**

If `α ∈ K'` satisfies `α ^ p = algebraMap k K' a` and `ζ` is a primitive `p`-th root of unity
in `k`, then `k(a^{1/p})` (the subfield of `K'` generated by all `p`-th roots of `a`,
`kummerField`) is the splitting field of `X ^ p - C a`: indeed all the roots of this
polynomial are the `ζ ^ i * α`. -/
theorem kummerField_isSplittingField_of_root (p : ℕ) (hp : p.Prime) {ζ : k}
    (hζ : IsPrimitiveRoot ζ p) (a : kˣ) {α : K'}
    (hα : α ^ p = algebraMap k K' (a : k)) :
    IsSplittingField k ↥(kummerField (K' := K') p a) (X ^ p - C (a : k)) := by
  refine IntermediateField.isSplittingField_iff.mpr ⟨?_, ?_⟩
  · refine IntermediateField.splits_of_splits ?_ ?_
    · have hζ' : IsPrimitiveRoot ((algebraMap k K') ζ) p :=
        hζ.map_of_injective (algebraMap k K').injective
      have h := X_pow_sub_C_splits_of_isPrimitiveRoot hζ' hα
      simpa only [Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_C, Polynomial.map_X,
        Polynomial.map_one] using h
    · intro x hx
      rw [Polynomial.mem_rootSet_of_ne (X_pow_sub_C_ne_zero hp.pos (a : k))] at hx
      simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero] at hx
      exact mem_kummerField_of_pow_eq hx
  · rw [kummerField]
    congr 1
    ext x
    rw [Polynomial.mem_rootSet_of_ne (X_pow_sub_C_ne_zero hp.pos (a : k)), Set.mem_ofPred_eq]
    simp only [map_sub, map_pow, Polynomial.aeval_X, Polynomial.aeval_C, sub_eq_zero]

theorem mem_zpowers_of_kummerFieldQuot_eq {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] [IsSepClosure k K'] (p : ℕ) (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    {x y : KummerGroup p k} (hx : x ≠ 1) (hy : y ≠ 1)
    (h : kummerFieldQuot (K' := K') p y = kummerFieldQuot (K' := K') p x) :
    y ∈ Subgroup.zpowers x := by
  -- representatives of the two Kummer classes
  let a : kˣ := Quotient.out x
  let b : kˣ := Quotient.out y
  have hmka : (QuotientGroup.mk a : KummerGroup p k) = x := Quotient.out_eq x
  have hmkb : (QuotientGroup.mk b : KummerGroup p k) = y := Quotient.out_eq y
  have haN : a ∉ powSubgroup p k := fun hmem => hx (by
    rw [← hmka]; exact (QuotientGroup.eq_one_iff a).mpr hmem)
  have hbN : b ∉ powSubgroup p k := fun hmem => hy (by
    rw [← hmkb]; exact (QuotientGroup.eq_one_iff b).mpr hmem)
  have hfield : kummerField (K' := K') p a = kummerField (K' := K') p b := by
    simpa only [kummerFieldQuot] using h.symm
  -- the characteristic is not `p`: `ζ` is a primitive `p`-th root of unity
  haveI hNep : NeZero p := ⟨hp.ne_zero⟩
  haveI hNek : NeZero ((p : ℕ) : k) := hζ.neZero'
  haveI hNeK : NeZero ((p : ℕ) : K') := ⟨fun h0 =>
    (NeZero.ne (((p : ℕ) : k))) ((algebraMap k K').injective (by
      rw [map_natCast, h0, map_zero]))⟩
  haveI hsep : IsSepClosed K' := IsSepClosure.sep_closed k
  -- `p`-th roots of `a` and `b` in the separable closure
  obtain ⟨α, hα⟩ := IsSepClosed.exists_pow_nat_eq (k := K') (algebraMap k K' (a : k)) p
  obtain ⟨β, hβ⟩ := IsSepClosed.exists_pow_nat_eq (k := K') (algebraMap k K' (b : k)) p
  let L : IntermediateField k K' := kummerField (K' := K') p a
  have hmema : α ∈ L := mem_kummerField_of_pow_eq hα
  have hmemb : β ∈ L := by
    show β ∈ kummerField (K' := K') p a
    rw [hfield]
    exact mem_kummerField_of_pow_eq hβ
  let α' : ↥L := ⟨α, hmema⟩
  let β' : ↥L := ⟨β, hmemb⟩
  have hα' : (α' : ↥L) ^ p = algebraMap k ↥L (a : k) := by
    apply Subtype.ext
    simpa using hα
  have hβ' : (β' : ↥L) ^ p = algebraMap k ↥L (b : k) := by
    apply Subtype.ext
    simpa using hβ
  -- `X ^ p - C a` and `X ^ p - C b` are irreducible, `a`, `b` not being `p`-th powers
  have hIrredA : Irreducible (X ^ p - C (a : k)) := by
    rw [X_pow_sub_C_irreducible_iff_of_prime hp]
    intro t ht
    refine haN (MonoidHom.mem_range.mpr ⟨Units.mk0 t ?_, ?_⟩)
    · rintro rfl
      rw [zero_pow hp.ne_zero] at ht
      exact (Units.ne_zero a) ht.symm
    · ext
      simpa [Units.val_pow_eq_pow_val] using ht
  have hIrredB : Irreducible (X ^ p - C (b : k)) := by
    rw [X_pow_sub_C_irreducible_iff_of_prime hp]
    intro t ht
    refine hbN (MonoidHom.mem_range.mpr ⟨Units.mk0 t ?_, ?_⟩)
    · rintro rfl
      rw [zero_pow hp.ne_zero] at ht
      exact (Units.ne_zero b) ht.symm
    · ext
      simpa [Units.val_pow_eq_pow_val] using ht
  -- `L` is the splitting field of both `X ^ p - C a` and `X ^ p - C b`
  have hμ : (primitiveRoots p k).Nonempty := ⟨ζ, (mem_primitiveRoots hp.pos).mpr hζ⟩
  haveI hsplitA : IsSplittingField k ↥L (X ^ p - C (a : k)) :=
    kummerField_isSplittingField_of_root p hp hζ a hα
  haveI hsplitB : IsSplittingField k ↥L (X ^ p - C (b : k)) := by
    have hLb : L = kummerField (K' := K') p b := hfield
    rw [hLb]
    exact kummerField_isSplittingField_of_root p hp hζ b hβ
  haveI hfinL : FiniteDimensional k ↥L := IsSplittingField.finiteDimensional ↥L (X ^ p - C (a : k))
  haveI hgalL : IsGalois k ↥L :=
    isGalois_of_isSplittingField_X_pow_sub_C (a := (a : k)) hμ hIrredA ↥L
  have hrank : Module.finrank k ↥L = p :=
    finrank_of_isSplittingField_X_pow_sub_C (a := (a : k)) hμ hIrredA ↥L
  have hcard : Nat.card Gal(↥L/k) = p := by
    rw [IsGalois.card_aut_eq_finrank, hrank]
  -- the automorphism `σ` of `L` with `σ α = ζ α`
  let eA : Gal(↥L/k) ≃* Multiplicative (ZMod p) :=
    autEquivZmod (a := (a : k)) hIrredA ↥L hζ
  let σ : Gal(↥L/k) := eA.symm (Multiplicative.ofAdd 1)
  have hσa : σ α' = ζ • α' := by
    have h := autEquivZmod_symm_apply_natCast (a := (a : k)) hIrredA ↥L hα' hζ 1
    simpa [σ, eA, pow_one] using h
  -- write `σ β = ζ ^ J β` for the corresponding exponent `J`
  let eB : Gal(↥L/k) ≃* Multiplicative (ZMod p) :=
    autEquivZmod (a := (b : k)) hIrredB ↥L hζ
  let J : ℕ := (Multiplicative.toAdd (eB σ)).val
  have hσb : σ β' = ζ ^ J • β' := by
    have hval : ((J : ℕ) : ZMod p) = Multiplicative.toAdd (eB σ) :=
      ZMod.natCast_zmod_val _
    have h2 : σ = eB.symm (Multiplicative.ofAdd ((J : ℕ) : ZMod p)) := by
      rw [hval]
      exact (MulEquiv.symm_apply_apply eB σ).symm
    rw [h2]
    have h := autEquivZmod_symm_apply_natCast (a := (b : k)) hIrredB ↥L hβ' hζ J
    simpa [eB] using h
  have hαne : (α' : ↥L) ≠ 0 := by
    intro h0
    have h1 : (α' : ↥L) ^ p = 0 := by rw [h0, zero_pow hp.ne_zero]
    rw [hα'] at h1
    exact (Units.ne_zero a) ((algebraMap k ↥L).injective (by rw [h1, map_zero]))
  have hβne : (β' : ↥L) ≠ 0 := by
    intro h0
    have h1 : (β' : ↥L) ^ p = 0 := by rw [h0, zero_pow hp.ne_zero]
    rw [hβ'] at h1
    exact (Units.ne_zero b) ((algebraMap k ↥L).injective (by rw [h1, map_zero]))
  -- `α ^ J * β⁻¹` is fixed by `σ`
  have hσγ : σ (α' ^ J * β'⁻¹) = α' ^ J * β'⁻¹ := by
    rw [map_mul, map_pow, map_inv₀, hσa, hσb]
    rw [Algebra.smul_def, Algebra.smul_def, mul_pow, map_pow, mul_inv]
    have hζ0 : ζ ≠ 0 := hζ.ne_zero hp.ne_zero
    have hA : (algebraMap k ↥L ζ) ^ J ≠ 0 :=
      pow_ne_zero _ (fun h => hζ0 ((algebraMap k ↥L).injective (by rw [h, map_zero])))
    field_simp
  -- `σ` is non-trivial, and `Gal(L/k)` has prime order `p`, so `σ` generates it
  have hσne : σ ≠ 1 := by
    intro h1
    have hs : ζ • α' = α' := by rw [← hσa, h1]; rfl
    have hzero : (ζ - 1) • α' = 0 := by rw [sub_smul, hs, one_smul, sub_self]
    rw [Algebra.smul_def] at hzero
    have hcontra : algebraMap k ↥L (ζ - 1) = 0 := (mul_eq_zero.mp hzero).resolve_right hαne
    exact hζ.ne_one hp.one_lt (sub_eq_zero.mp ((algebraMap k ↥L).injective (by rw [hcontra, map_zero])))
  haveI : Fact p.Prime := ⟨hp⟩
  have htop : Subgroup.zpowers σ = ⊤ := zpowers_eq_top_of_prime_card hcard hσne
  have hpow : ∀ n : ℕ, (σ ^ n) (α' ^ J * β'⁻¹) = α' ^ J * β'⁻¹ := by
    intro n
    induction n with
    | zero => simp
    | succ n ih => rw [pow_succ, AlgEquiv.mul_apply, hσγ, ih]
  have hzpow : ∀ k : ℤ, (σ ^ k) (α' ^ J * β'⁻¹) = α' ^ J * β'⁻¹ := by
    intro k
    obtain ⟨n, rfl | rfl⟩ := Int.eq_nat_or_neg k
    · rw [zpow_natCast]; exact hpow n
    · rw [zpow_neg, zpow_natCast]
      change ((σ ^ n : Gal(↥L/k))).symm (α' ^ J * β'⁻¹) = α' ^ J * β'⁻¹
      rw [AlgEquiv.symm_apply_eq]
      exact (hpow n).symm
  have hmem0 : α' ^ J * β'⁻¹ ∈ IntermediateField.fixedField (⊤ : Subgroup Gal(↥L/k)) := by
    rw [IntermediateField.mem_fixedField_iff]
    intro f _
    have hf : f ∈ Subgroup.zpowers σ := by rw [htop]; exact Subgroup.mem_top f
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hf
    rw [← hk]
    exact hzpow k
  have hmem : α' ^ J * β'⁻¹ ∈ (⊥ : IntermediateField k ↥L) := by
    rwa [IsGalois.fixedField_top] at hmem0
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hmem
  -- hence `a ^ J / b` is a `p`-th power in `k`
  have hγp : (α' ^ J * β'⁻¹) ^ p = algebraMap k ↥L ((a : k) ^ J * (b : k)⁻¹) := by
    have h1 : ((α' : ↥L) ^ J) ^ p = algebraMap k ↥L ((a : k) ^ J) := by
      rw [← pow_mul, mul_comm, pow_mul, hα', ← map_pow]
    have h2 : ((β' : ↥L)⁻¹) ^ p = algebraMap k ↥L ((b : k)⁻¹) := by
      rw [inv_pow, hβ', ← map_inv₀]
    rw [mul_pow, h1, h2, ← map_mul]
  have hcp : c ^ p = (a : k) ^ J * (b : k)⁻¹ := by
    apply (algebraMap k ↥L).injective
    rw [map_pow, hc]
    exact hγp
  have hc0 : c ≠ 0 := by
    intro h0
    have h : α' ^ J * β'⁻¹ = 0 := by rw [← hc, h0, map_zero]
    exact (mul_ne_zero (pow_ne_zero _ hαne) (inv_ne_zero hβne)) h
  have hmemN : a ^ J * b⁻¹ ∈ powSubgroup p k := by
    refine MonoidHom.mem_range.mpr ⟨Units.mk0 c hc0, ?_⟩
    ext
    simpa [Units.val_pow_eq_pow_val, Units.val_mul] using hcp
  -- which means `y = x ^ J` in `kˣ / (kˣ) ^ p`
  have hxy : y = x ^ J := by
    have hmk : (QuotientGroup.mk (a ^ J * b⁻¹) : KummerGroup p k) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hmemN
    have hprod : (QuotientGroup.mk a : KummerGroup p k) ^ J * (QuotientGroup.mk b)⁻¹ = 1 := by
      rw [← QuotientGroup.mk_pow, ← QuotientGroup.mk_inv, ← QuotientGroup.mk_mul]
      exact hmk
    rw [hmka, hmkb] at hprod
    rw [mul_inv_eq_one] at hprod
    exact hprod.symm
  rw [hxy]
  exact Subgroup.mem_zpowers_iff.mpr ⟨(J : ℤ), zpow_natCast x J⟩

end NK.LocalAnabelian.Kummer
