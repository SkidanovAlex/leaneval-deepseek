import Mathlib
import Submission.NK.Reconstruct.GammaModule

/-!
# Generating the ℓ-part by `ellRank A ℓ` elements

The ℓ-rank `NK.Reconstruct.ellRank A ℓ = Nat.log ℓ (Nat.card A[ℓ])` of a finite commutative group
`A` is the number of cyclic `ℤ_ℓ`-summands of its ℓ-primary part `NK.Reconstruct.ellPart A ℓ`,
i.e. the minimal number of generators of `ellPart A ℓ`.  This file proves the corresponding
*generation* statement: if `Nat.log ℓ (Nat.card A[ℓ]) ≤ r` then `ellPart A ℓ` is generated by `r`
elements.

The proof is the elementary Nakayama-style argument for finite abelian ℓ-groups, with the
supporting group theory built here:

* `exists_gen_family_of_pow_eq_one_aux` — **a finite commutative group of exponent dividing `ℓ` is
  generated by `Nat.log ℓ` of its order many elements** (strong induction on the order, dividing
  out a subgroup of order `ℓ`);
* `eq_top_of_sup_pow_range_eq_top` — **Nakayama**: if `K ⊔ G^ℓ = ⊤` in a finite commutative group
  `G` killed by `ℓ ^ N`, then `K = ⊤` (iterate `G = K·G^ℓ` up to `G^{ℓ^N} = 1`);
* `exists_gen_family_of_le` — padding a generating family with `1`s.

The main theorem applies this to `G = ellPart A ℓ` and the quotient `G ⧸ G^ℓ`, whose order is the
order of the ℓ-torsion of `G` (hence of `A`) by the first isomorphism theorem.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSimpArgs false

namespace NK.Reconstruct

/-! ## Padding a generating family -/

/-- A generating family of size `k` can be padded to a generating family of any larger size `r`
by inserting `1`s. -/
private theorem exists_gen_family_of_le {G : Type*} [Group G] {k r : ℕ} (hkr : k ≤ r)
    (h : ∃ S : Fin k → G, Subgroup.closure (Set.range S) = ⊤) :
    ∃ S : Fin r → G, Subgroup.closure (Set.range S) = ⊤ := by
  obtain ⟨S, hS⟩ := h
  refine ⟨fun i : Fin r => if hi : (i : ℕ) < k then S ⟨(i : ℕ), hi⟩ else 1, ?_⟩
  rw [eq_top_iff, ← hS]
  refine Subgroup.closure_mono ?_
  rintro _ ⟨j, rfl⟩
  refine ⟨⟨(j : ℕ), lt_of_lt_of_le j.isLt hkr⟩, ?_⟩
  simp only [dif_pos j.isLt]

/-! ## Groups of exponent `ℓ` -/

/-- **A finite commutative group of exponent dividing `ℓ` is generated by `Nat.log ℓ` of its order
many elements.**  The proof is a strong induction on the order: if `V` is nontrivial, pick
`x ≠ 1`; since `x` has order exactly `ℓ`, the subgroup `K = ⟨x⟩` has `ℓ` elements, the quotient
`V ⧸ K` again has exponent `ℓ` and smaller order, and adding a lift of `x` to a generating family
of the quotient generates `V`. -/
private theorem exists_gen_family_of_pow_eq_one_aux (ℓ : ℕ) (hℓ : ℓ.Prime) :
    ∀ N : ℕ, ∀ (V : Type*) [CommGroup V] [Fintype V], Nat.card V = N →
      (∀ x : V, x ^ ℓ = 1) →
      ∃ k : ℕ, k ≤ Nat.log ℓ N ∧
        ∃ S : Fin k → V, Subgroup.closure (Set.range S) = ⊤ := by
  intro N
  induction N using Nat.strong_induction_on with
  | h N ih =>
    intro V _ _ hcard hV
    by_cases hsub : Subsingleton V
    · refine ⟨0, Nat.zero_le _, ?_⟩
      refine ⟨fun i : Fin 0 => i.elim0, ?_⟩
      rw [Set.range_eq_empty (fun i : Fin 0 => i.elim0), Subgroup.closure_empty]
      exact (Subgroup.eq_top_iff' _).mpr fun x => by
        rw [Subgroup.mem_bot]
        exact Subsingleton.elim x 1
    · haveI : Nontrivial V := not_subsingleton_iff_nontrivial.mp hsub
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      obtain ⟨x, hx1⟩ := exists_ne (1 : V)
      have hℓ1 : 1 < ℓ := hℓ.one_lt
      have hxℓ : x ^ ℓ = 1 := hV x
      have hord : orderOf x = ℓ := orderOf_eq_prime hxℓ hx1
      set K : Subgroup V := Subgroup.closure ({x} : Set V) with hK
      have hKcard : Nat.card K = ℓ := by
        rw [hK, ← Subgroup.zpowers_eq_closure x, Nat.card_zpowers, hord]
      have hKle : ℓ ≤ N := by
        rw [← hcard, ← hKcard]
        exact Nat.card_le_card_of_injective (Subtype.val : K → V) Subtype.val_injective
      haveI : Fintype (V ⧸ K) := Fintype.ofFinite _
      have hVK : ∀ y : V ⧸ K, y ^ ℓ = 1 := by
        intro y
        obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective y
        rw [← QuotientGroup.mk_pow, hV v, QuotientGroup.mk_one]
      have hcardq : Nat.card (V ⧸ K) = N / ℓ := by
        have h1 := Subgroup.card_eq_card_quotient_mul_card_subgroup K
        rw [hKcard, hcard, mul_comm] at h1
        exact Nat.eq_div_of_mul_eq_right (by omega) h1.symm
      have hlt : Nat.card (V ⧸ K) < N := by
        rw [hcardq]
        exact Nat.div_lt_self (by omega) hℓ1
      obtain ⟨k', hk', S', hS'⟩ := ih (Nat.card (V ⧸ K)) hlt (V ⧸ K) rfl hVK
      choose y hy using fun i => QuotientGroup.mk_surjective (S' i)
      have hsup : Subgroup.closure (Set.range y) ⊔ K = ⊤ := by
        rw [eq_top_iff]
        intro z _
        have hmap : Subgroup.map (QuotientGroup.mk' K) (Subgroup.closure (Set.range y)) = ⊤ := by
          rw [MonoidHom.map_closure]
          have hrange : (QuotientGroup.mk' K) '' Set.range y = Set.range S' := by
            ext v
            simp only [Set.mem_image, Set.mem_range, QuotientGroup.mk'_apply]
            constructor
            · rintro ⟨w, ⟨i, rfl⟩, hw⟩
              exact ⟨i, (hy i).symm.trans hw⟩
            · rintro ⟨i, rfl⟩
              exact ⟨y i, ⟨i, rfl⟩, hy i⟩
          rw [hrange, hS']
        obtain ⟨w, hw, hwz⟩ := Subgroup.mem_map.mp (hmap ▸ Subgroup.mem_top (QuotientGroup.mk z))
        rw [QuotientGroup.mk'_apply] at hwz
        exact Subgroup.mem_sup.mpr ⟨w, hw, w⁻¹ * z, QuotientGroup.eq.mp hwz, by group⟩
      refine ⟨k' + 1, ?_, ?_⟩
      · have hlog1 : 1 ≤ Nat.log ℓ N := by
          have h1 : 1 ≤ Nat.log ℓ ℓ := by
            simpa using Nat.le_log_of_pow_le (b := ℓ) (x := 1) (y := ℓ) hℓ1
              (by simp : ℓ ^ 1 ≤ ℓ)
          exact le_trans h1 (Nat.log_mono_right hKle)
        have hlogq : Nat.log ℓ (Nat.card (V ⧸ K)) = Nat.log ℓ N - 1 := by
          rw [hcardq]
          exact Nat.log_div_base ℓ N
        rw [hlogq] at hk'
        calc k' + 1 ≤ (Nat.log ℓ N - 1) + 1 := Nat.add_le_add_right hk' 1
          _ = Nat.log ℓ N := Nat.sub_add_cancel hlog1
      · refine ⟨Fin.cons x y, ?_⟩
        rw [Fin.range_cons, Set.insert_eq, Subgroup.closure_union, ← hK, sup_comm, hsup]

/-! ## Nakayama for finite abelian ℓ-groups -/

/-- **Nakayama's lemma for finite abelian `ℓ`-groups.**  If a subgroup `K` of a finite commutative
group `G` killed by `ℓ ^ N` satisfies `K ⊔ G ^ ℓ = ⊤`, then `K = ⊤`: iterating `G = K · G^ℓ` one
finds `x ∈ K · G^{ℓ ^ i}` for every `i`, and `G^{ℓ ^ N} = 1`. -/
private theorem eq_top_of_sup_pow_range_eq_top {G : Type*} [CommGroup G] (ℓ : ℕ)
    (K : Subgroup G) (h : K ⊔ (powMonoidHom ℓ : G →* G).range = ⊤)
    (hN : ∃ N : ℕ, ∀ x : G, x ^ (ℓ ^ N) = 1) : K = ⊤ := by
  obtain ⟨N, hN⟩ := hN
  have key : ∀ i : ℕ, ∀ x : G, ∃ a ∈ K, ∃ b : G, x = a * b ^ (ℓ ^ i) := by
    intro i
    induction i with
    | zero => intro x; exact ⟨1, K.one_mem, x, by simp⟩
    | succ i ih =>
      intro x
      obtain ⟨a, ha, b, hb⟩ := ih x
      have hbK : b ∈ K ⊔ (powMonoidHom ℓ : G →* G).range := by rw [h]; exact Subgroup.mem_top b
      obtain ⟨a', ha', c, hc, hbc⟩ := Subgroup.mem_sup.mp hbK
      obtain ⟨b', hb'⟩ := MonoidHom.mem_range.mp hc
      have hb'' : c = b' ^ ℓ := by rw [← hb']; rfl
      refine ⟨a * a' ^ (ℓ ^ i), K.mul_mem ha (K.pow_mem ha' _), b', ?_⟩
      rw [hb, ← hbc, hb'', mul_pow, ← pow_mul,
        show ℓ * ℓ ^ i = ℓ ^ (i + 1) from by rw [mul_comm, pow_succ]]
      group
  refine (Subgroup.eq_top_iff' _).mpr fun x => ?_
  obtain ⟨a, ha, b, hb⟩ := key N x
  rw [hb, hN b, mul_one]
  exact ha

/-! ## The main theorem -/

/-- **The ℓ-primary part of a finite commutative group is generated by `ellRank A ℓ` elements.**
Equivalently, if the ℓ-torsion of `A` has order at most `ℓ ^ r`, then `ellPart A ℓ` is generated by
`r` elements.

Indeed, `G := ellPart A ℓ` is a finite abelian ℓ-group, the quotient `G ⧸ G^ℓ` has exponent `ℓ` and
order equal to the order of the ℓ-torsion of `G` (hence of `A`) by the first isomorphism theorem,
so it is generated by `≤ Nat.log ℓ (Nat.card A[ℓ]) ≤ r` elements; lifting those generators and
padding with `1`s (Nakayama, `eq_top_of_sup_pow_range_eq_top`) generates `G`. -/
theorem exists_closure_eq_top_of_log_ellTorsion_le {A : Type*} [CommGroup A] [Fintype A] {ℓ r : ℕ}
    [Fact ℓ.Prime] (h : Nat.log ℓ (Nat.card {x : A // x ^ ℓ = 1}) ≤ r) :
    ∃ S : Fin r → ellPart A ℓ,
      Subgroup.closure (Set.range S) = (⊤ : Subgroup (ellPart A ℓ)) := by
  classical
  have hℓ : ℓ.Prime := Fact.out
  haveI : Fintype (ellPart A ℓ) := Fintype.ofFinite _
  -- The ℓ-torsion of `A` is the ℓ-torsion of its ℓ-part.
  have hcardT : Nat.card {x : A // x ^ ℓ = 1} = Nat.card {x : ellPart A ℓ // x ^ ℓ = 1} := by
    refine Nat.card_congr ⟨?_, ?_, ?_, ?_⟩
    · exact fun x => ⟨⟨x.1, (mem_ellPart_iff ℓ x.1).mpr ⟨1, by simpa using x.2⟩⟩,
        Subtype.ext (by simpa using x.2)⟩
    · exact fun x => ⟨(x.1 : A), by
        have hx := congrArg (fun z : ellPart A ℓ => (z : A)) x.2
        simpa using hx⟩
    · intro x; exact Subtype.ext rfl
    · intro x; exact Subtype.ext (Subtype.ext rfl)
  let f : ellPart A ℓ →* ellPart A ℓ := powMonoidHom ℓ
  have hker : Nat.card f.ker = Nat.card {x : ellPart A ℓ // x ^ ℓ = 1} := rfl
  haveI : Fintype (ellPart A ℓ ⧸ f.range) := Fintype.ofFinite _
  -- The quotient by the `ℓ`-th powers has the order of the ℓ-torsion (first isomorphism theorem).
  have hcardV : Nat.card (ellPart A ℓ ⧸ f.range) = Nat.card {x : A // x ^ ℓ = 1} := by
    have hq := Subgroup.card_eq_card_quotient_mul_card_subgroup f.range
    have hk' := Subgroup.card_eq_card_quotient_mul_card_subgroup f.ker
    have hiso : Nat.card (ellPart A ℓ ⧸ f.ker) = Nat.card f.range :=
      Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
    rw [hiso] at hk'
    have h1 : Nat.card (ellPart A ℓ ⧸ f.range) * Nat.card f.range
        = Nat.card f.ker * Nat.card f.range := by
      rw [← hq, hk', mul_comm]
    have hpos : 0 < Nat.card f.range := by
      rw [Nat.card_pos_iff]
      exact ⟨⟨1, f.range.one_mem⟩, inferInstance⟩
    rw [Nat.mul_right_cancel hpos h1, hker, hcardT]
  -- The quotient has exponent `ℓ`.
  have hVexp : ∀ y : (ellPart A ℓ ⧸ f.range), y ^ ℓ = 1 := by
    intro y
    obtain ⟨v, rfl⟩ := QuotientGroup.mk_surjective y
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
    exact ⟨v, rfl⟩
  obtain ⟨k, hk, S₀, hS₀⟩ := exists_gen_family_of_pow_eq_one_aux ℓ hℓ
    (Nat.card (ellPart A ℓ ⧸ f.range)) (ellPart A ℓ ⧸ f.range) rfl hVexp
  have hk_r : k ≤ r := le_trans hk (by rw [hcardV]; exact h)
  choose y hy using fun i => QuotientGroup.mk_surjective (S₀ i)
  -- Lifting the generators of the quotient generates `ellPart A ℓ` by Nakayama.
  have htop : Subgroup.closure (Set.range y) = ⊤ := by
    refine eq_top_of_sup_pow_range_eq_top ℓ _
      ?_ ⟨ellExp A ℓ, fun x => pow_ellExp_eq_one (A := A) ℓ x⟩
    rw [eq_top_iff]
    intro z _
    have hmap : Subgroup.map (QuotientGroup.mk' f.range)
        (Subgroup.closure (Set.range y)) = ⊤ := by
      rw [MonoidHom.map_closure]
      have hrange : (QuotientGroup.mk' f.range) '' Set.range y = Set.range S₀ := by
        ext v
        simp only [Set.mem_image, Set.mem_range, QuotientGroup.mk'_apply]
        constructor
        · rintro ⟨w, ⟨i, rfl⟩, hw⟩
          exact ⟨i, (hy i).symm.trans hw⟩
        · rintro ⟨i, rfl⟩
          exact ⟨y i, ⟨i, rfl⟩, hy i⟩
      rw [hrange, hS₀]
    obtain ⟨w, hw, hwz⟩ := Subgroup.mem_map.mp (hmap ▸ Subgroup.mem_top (QuotientGroup.mk z))
    rw [QuotientGroup.mk'_apply] at hwz
    exact Subgroup.mem_sup.mpr ⟨w, hw, w⁻¹ * z, QuotientGroup.eq.mp hwz, by group⟩
  exact exists_gen_family_of_le hk_r ⟨y, htop⟩

end NK.Reconstruct
