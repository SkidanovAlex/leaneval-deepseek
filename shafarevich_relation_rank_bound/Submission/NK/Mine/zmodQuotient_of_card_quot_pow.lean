import Mathlib
import Submission.NK.Mine.zmodQuotient_of_orderOf_eq

namespace NK.Mine

/-- `powSub A p k` is the subgroup of `A` generated by the `p ^ k`-th powers,
i.e. the image of the `p ^ k`-th power map. -/
noncomputable def powSub (A : Type*) [CommGroup A] (p k : ℕ) : Subgroup A :=
  (powMonoidHom (p ^ k) : A →* A).range

variable {A : Type*} [CommGroup A]

lemma mem_powSub {p k : ℕ} {x : A} : x ∈ powSub A p k ↔ ∃ y : A, y ^ (p ^ k) = x := by
  simp [powSub, MonoidHom.mem_range]

/-- For `k = 1` this is the subgroup appearing in the hypothesis of the main theorem. -/
lemma powSub_one (p : ℕ) :
    powSub A p 1 = Subgroup.closure (Set.range fun y : A => y ^ p) := by
  apply le_antisymm
  · intro x hx
    rw [powSub, pow_one] at hx
    rw [MonoidHom.mem_range] at hx
    obtain ⟨y, rfl⟩ := hx
    exact Subgroup.subset_closure ⟨y, rfl⟩
  · rw [powSub, pow_one, Subgroup.closure_le]
    rintro x ⟨y, rfl⟩
    exact MonoidHom.mem_range.mpr ⟨y, rfl⟩

/-- The `p ^ k`-th power subgroups form a decreasing sequence. -/
lemma powSub_anti {p k l : ℕ} (h : k ≤ l) : powSub A p l ≤ powSub A p k := by
  intro x hx
  rw [mem_powSub] at hx ⊢
  obtain ⟨y, rfl⟩ := hx
  refine ⟨y ^ (p ^ (l - k)), ?_⟩
  rw [← pow_mul, ← pow_add, Nat.sub_add_cancel h]

/-- In a commutative group without `p`-torsion, `x ^ (p ^ k) = 1` forces `x = 1`. -/
lemma pow_eq_one_of_pow_pow {p : ℕ} (htors : ∀ x : A, x ^ p = 1 → x = 1) :
    ∀ k (x : A), x ^ (p ^ k) = 1 → x = 1 := by
  intro k
  induction k with
  | zero => intro x hx; simpa using hx
  | succ k ih =>
      intro x hx
      rw [pow_succ, pow_mul] at hx
      exact ih x (htors _ hx)

lemma pow_pow_sub_one {p k : ℕ} (hk : 1 ≤ k) (w : A) :
    (w ^ p) ^ (p ^ (k - 1)) = w ^ (p ^ k) := by
  rw [← pow_mul, ← pow_succ', Nat.sub_add_cancel hk]

/-- If `a` is not a `p`-th power then its image in `A ⧸ powSub A p k` has order `p ^ k`. -/
lemma orderOf_mk_powSub {p k : ℕ} (hp : p.Prime) (htors : ∀ x : A, x ^ p = 1 → x = 1)
    {a : A} (ha : a ∉ powSub A p 1) (hk : 1 ≤ k) :
    orderOf (QuotientGroup.mk' (powSub A p k) a) = p ^ k := by
  have hpow : (QuotientGroup.mk' (powSub A p k) a) ^ (p ^ k) = 1 := by
    rw [← MonoidHom.map_pow, QuotientGroup.mk'_apply]
    exact (QuotientGroup.eq_one_iff _).mpr (mem_powSub.mpr ⟨a, rfl⟩)
  have hne : (QuotientGroup.mk' (powSub A p k) a) ^ (p ^ (k - 1)) ≠ 1 := by
    intro hcon
    rw [← MonoidHom.map_pow, QuotientGroup.mk'_apply] at hcon
    have hcon' : a ^ (p ^ (k - 1)) ∈ powSub A p k := (QuotientGroup.eq_one_iff _).mp hcon
    rw [mem_powSub] at hcon'
    obtain ⟨w, hw⟩ := hcon'
    have h2 : (a * (w ^ p)⁻¹) ^ (p ^ (k - 1)) = 1 := by
      rw [mul_pow, inv_pow, pow_pow_sub_one hk w, hw, mul_inv_cancel]
    have h3 : a * (w ^ p)⁻¹ = 1 := pow_eq_one_of_pow_pow htors (k - 1) _ h2
    have haeq : a = w ^ p := by
      rw [mul_eq_one_iff_eq_inv] at h3
      simpa using h3
    exact ha (mem_powSub.mpr ⟨w, by simpa using haeq.symm⟩)
  have hdvd : orderOf (QuotientGroup.mk' (powSub A p k) a) ∣ p ^ k :=
    orderOf_dvd_iff_pow_eq_one.mpr hpow
  obtain ⟨j, hjle, hjeq⟩ := (Nat.dvd_prime_pow hp).mp hdvd
  have hjk : j = k := by
    by_contra hjne
    have hjlt : j < k := lt_of_le_of_ne hjle hjne
    have hdiv : orderOf (QuotientGroup.mk' (powSub A p k) a) ∣ p ^ (k - 1) := by
      rw [hjeq]; exact pow_dvd_pow p (Nat.le_sub_one_of_lt hjlt)
    exact hne (orderOf_dvd_iff_pow_eq_one.mp hdiv)
  rw [hjeq, hjk]

/-- If `A ⧸ powSub A p 1` is finite then so is `A ⧸ powSub A p (m + 1)`: the latter is an
iterated extension of copies of the former, the layer `powSub A p (k+1) ⧸ powSub A p (k+2)`
being the image of the `p`-th power map. -/
lemma finite_quot_powSub {p : ℕ} (_hp : p.Prime) (hfin1 : Finite (A ⧸ powSub A p 1))
    (m : ℕ) : Finite (A ⧸ powSub A p (m + 1)) := by
  induction m with
  | zero => simpa using hfin1
  | succ m ih =>
    have hle1 : powSub A p (m + 2) ≤ powSub A p 1 := powSub_anti (by omega)
    let f : A ⧸ powSub A p (m + 1) →* A ⧸ powSub A p (m + 2) :=
      QuotientGroup.lift (powSub A p (m + 1))
        ((QuotientGroup.mk' (powSub A p (m + 2))).comp (powMonoidHom p))
        (fun x hx => MonoidHom.mem_ker.mpr (by
          rw [MonoidHom.comp_apply, powMonoidHom_apply, QuotientGroup.mk'_apply]
          exact (QuotientGroup.eq_one_iff _).mpr (by
            rw [mem_powSub] at hx ⊢
            obtain ⟨y, hy⟩ := hx
            exact ⟨y, by rw [pow_succ, pow_mul, hy]⟩)))
    let g : A ⧸ powSub A p (m + 2) →* A ⧸ powSub A p 1 :=
      QuotientGroup.lift (powSub A p (m + 2)) (QuotientGroup.mk' (powSub A p 1))
        (fun x hx => MonoidHom.mem_ker.mpr (by
          rw [QuotientGroup.mk'_apply]
          exact (QuotientGroup.eq_one_iff _).mpr (hle1 hx)))
    have hker : g.ker ≤ f.range := by
      intro y hy
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (powSub A p (m + 2)) y
      have hy1 : g ((QuotientGroup.mk' (powSub A p (m + 2))) x) = 1 := MonoidHom.mem_ker.mp hy
      dsimp only [g] at hy1
      rw [QuotientGroup.mk'_apply] at hy1
      rw [QuotientGroup.lift_mk'] at hy1
      have hxmem : x ∈ powSub A p 1 := (QuotientGroup.eq_one_iff x).mp hy1
      rw [mem_powSub] at hxmem
      obtain ⟨z, hz⟩ := hxmem
      rw [pow_one] at hz
      refine ⟨QuotientGroup.mk' (powSub A p (m + 1)) z, ?_⟩
      dsimp only [f]
      rw [QuotientGroup.mk'_apply, QuotientGroup.lift_mk', MonoidHom.comp_apply,
        powMonoidHom_apply, hz, QuotientGroup.mk'_apply]
    haveI : Fintype (A ⧸ powSub A p (m + 1)) := Fintype.ofFinite _
    haveI : Fintype (A ⧸ powSub A p 1) := Fintype.ofFinite _
    haveI : Fintype (A ⧸ powSub A p (m + 2)) := Group.fintypeOfKerLeRange f g hker
    exact Finite.of_fintype _

theorem zmodQuotient_of_card_quot_pow {A : Type*} [CommGroup A] {p d : ℕ} (hp : p.Prime)
    (htors : ∀ x : A, x ^ p = 1 → x = 1)
    (hcard : Nat.card (A ⧸ Subgroup.closure (Set.range fun y : A => y ^ p)) = p ^ d)
    (hd : 0 < d) (n : ℕ) :
    ∃ f : A →* Multiplicative (ZMod (p ^ n)), Function.Surjective f := by
  classical
  have hfin1 : Finite (A ⧸ powSub A p 1) := by
    rw [powSub_one]
    have hne : Nat.card (A ⧸ Subgroup.closure (Set.range fun y : A => y ^ p)) ≠ 0 := by
      rw [hcard]; exact pow_ne_zero d hp.ne_zero
    exact Finite.of_not_infinite (fun hinf => hne (Nat.card_eq_zero.mpr (Or.inr hinf)))
  obtain ⟨a, ha⟩ : ∃ a : A, a ∉ powSub A p 1 := by
    by_contra hcon
    push_neg at hcon
    have htop : powSub A p 1 = ⊤ := le_antisymm le_top (fun x _ => hcon x)
    have h1 : Nat.card (A ⧸ powSub A p 1) = 1 := by
      rw [htop, ← Subgroup.index_eq_card, Subgroup.index_top]
    rw [powSub_one, hcard] at h1
    have hlt : 1 < p ^ d := one_lt_pow₀ hp.one_lt (Nat.pos_iff_ne_zero.mp hd)
    omega
  rcases Nat.eq_zero_or_pos n with hn0 | hnpos
  · subst hn0
    haveI : Subsingleton (Multiplicative (ZMod (p ^ 0))) := by
      rw [pow_zero]
      exact ZMod.subsingleton_iff.mpr rfl
    exact ⟨1, fun y => ⟨1, Subsingleton.elim _ _⟩⟩
  · haveI hfin : Finite (A ⧸ powSub A p n) := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.pos_iff_ne_zero.mp hnpos)
      exact finite_quot_powSub hp hfin1 m
    have hord : orderOf (QuotientGroup.mk' (powSub A p n) a) = p ^ n :=
      orderOf_mk_powSub hp htors ha hnpos
    obtain ⟨g, hg⟩ := zmodQuotient_of_orderOf_eq hp (QuotientGroup.mk' (powSub A p n) a) hord
    refine ⟨g.comp (QuotientGroup.mk' (powSub A p n)), ?_⟩
    intro y
    obtain ⟨z, hz⟩ := hg y
    obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective (powSub A p n) z
    exact ⟨w, by rw [MonoidHom.comp_apply, hz]⟩

end NK.Mine
