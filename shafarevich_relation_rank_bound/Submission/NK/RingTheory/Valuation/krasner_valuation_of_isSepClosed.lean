import Mathlib
import Submission.Commons.RingTheory.Valuation.henselianLocalRing_of_isAlgebraic
import Submission.Commons.RingTheory.Valuation.comap_eq_self_iff_val_eq_of_isAlgebraic
import Submission.Commons.RingTheory.Valuation.krasner_valuation
import Submission.NK.RingTheory.Valuation.comap_valuation_le
import Submission.NK.RingTheory.Valuation.valuation_eq_of_comap_eq

/-!
# Krasner's lemma for a separably closed extension

Let `F` be a field with a henselian valuation subring `V`, let `L` be a separably closed extension
field of `F` and let `W` be an extension of `V` to `L`.  If `x ∈ L` is separable over `F` and
`y ∈ L` is closer to `x` than every other `F`-conjugate of `x` (with respect to `W`), then
`x` lies in the subfield generated by `F` and `y`.

This is Krasner's lemma in the form needed for the theory of local fields: the ambient field `L`
need not be algebraic over `F` (nor algebraically closed), only separably closed.

## Proof

Let `K = F(y)` and suppose `x ∉ K`.  Since `x` is separable over `K`, its minimal polynomial over
`K` splits in `L` with at least two roots; pick a conjugate `x' ≠ x`.  The `K`-algebra embedding
`ψ : K(x) → L` with `ψ x = x'` is produced by `algHomAdjoinIntegralEquiv`.  The restriction of `W`
to `K` is henselian (`henselianLocalRing_of_isAlgebraic`), so the extensions of `W|_K` to the
algebraic extension `K(x)` are unique (`eq_of_comap_eq_of_isAlgebraic`): this is
`W.comap ψ = W.comap (algebraMap K(x) L)`.  Since `K(x)/K` is algebraic, the value group is
torsion over the values from `K`, and the comparison of the two valuations therefore upgrades to
the equality `W (ψ z) = W z` (`valuation_eq_of_comap_eq`).  Applying this to `z = x - y` gives
`W (x' - y) = W (x - y)`, and the ultrametric inequality yields
`W (x - x') ≤ max (W (x - y)) (W (x' - y)) = W (x - y) < W (x - x')`,
contradicting the choice of `x'`.
-/

namespace NK.RingTheory.Valuation

open IntermediateField Polynomial

theorem krasner_valuation_of_isSepClosed {F L : Type*} [Field F] [Field L] [Algebra F L]
    (V : ValuationSubring F) [HenselianLocalRing V] (W : ValuationSubring L)
    (hW : W.comap (algebraMap F L) = V) [IsSepClosed L] {x y : L} (hx : IsSeparable F x)
    (hy : IsIntegral F y)
    (h : ∀ x' : L, IsConjRoot F x x' → x ≠ x' → W.valuation (x - y) < W.valuation (x - x')) :
    x ∈ IntermediateField.adjoin F ({y} : Set L) := by
  by_contra hmem
  -- `K = F⟮y⟯` is the field the conclusion is about.
  set K : IntermediateField F L := F⟮y⟯ with hKdef
  have hyK : y ∈ K := IntermediateField.mem_adjoin_simple_self F y
  -- `x` is not in the bottom subalgebra of `L` over `K`, i.e. not in `K`.
  have hxbot : x ∉ (⊥ : Subalgebra ↥K L) := by
    intro hxb
    rw [Algebra.mem_bot] at hxb
    obtain ⟨c, hc⟩ := hxb
    exact hmem (by rw [← hc]; exact c.2)
  -- separability, integrality and splitting for `x` over `K`
  have hxsepK : IsSeparable ↥K x := IsSeparable.tower_top ↥K hx
  have hxintK : IsIntegral ↥K x := IsSeparable.isIntegral hxsepK
  have hsplitK : ((minpoly ↥K x).map (algebraMap ↥K L)).Splits :=
    IsSepClosed.splits_codomain (minpoly ↥K x) hxsepK
  -- a conjugate `x' ≠ x` of `x` over `K`
  obtain ⟨x', hne, hconj⟩ := (notMem_iff_exists_ne_and_isConjRoot hxsepK hsplitK).mp hxbot
  -- the `K`-algebra embedding `K⟮x⟯ →ₐ[↥K] L` sending `x` to `x'`
  have hx'root : x' ∈ (minpoly ↥K x).aroots L := by
    rw [Polynomial.mem_aroots]
    exact ⟨minpoly.ne_zero hxintK, IsConjRoot.aeval_eq_zero hconj⟩
  let E : IntermediateField ↥K L := (↥K)⟮x⟯
  let ψ : ↥E →ₐ[↥K] L :=
    (IntermediateField.algHomAdjoinIntegralEquiv ↥K hxintK).symm ⟨x', hx'root⟩
  have hψx : ψ (IntermediateField.AdjoinSimple.gen ↥K x) = x' :=
    IntermediateField.algHomAdjoinIntegralEquiv_symm_apply_gen ↥K hxintK ⟨x', hx'root⟩
  haveI hEalg : Algebra.IsAlgebraic ↥K ↥E := IntermediateField.isAlgebraic_adjoin_simple hxintK
  -- the restriction of `W` to `K` is henselian
  have hKalg : Algebra.IsAlgebraic F ↥K := IntermediateField.isAlgebraic_adjoin_simple hy
  let WK : ValuationSubring ↥K := W.comap (algebraMap ↥K L)
  have hWK : WK.comap (algebraMap F ↥K) = V := by
    rw [ValuationSubring.comap_comap]
    rw [← IsScalarTower.algebraMap_eq F ↥K L, hW]
  haveI : HenselianLocalRing WK :=
    Commons.RingTheory.Valuation.henselianLocalRing_of_isAlgebraic hKalg V WK hWK
  -- the two extensions of `W|_K` to the algebraic extension `K⟮x⟯` agree
  have hcomapψ : (W.comap (ψ : ↥E →+* L)).comap (algebraMap ↥K ↥E) = WK := by
    rw [ValuationSubring.comap_comap]
    have hcomp : (ψ : ↥E →+* L).comp (algebraMap ↥K ↥E) = algebraMap ↥K L := by
      ext c
      exact ψ.commutes c
    rw [hcomp]
  have hcomapinc : (W.comap (algebraMap ↥E L)).comap (algebraMap ↥K ↥E) = WK := by
    rw [ValuationSubring.comap_comap, ← IsScalarTower.algebraMap_eq ↥K ↥E L]
  have hAB : W.comap (ψ : ↥E →+* L) = W.comap (algebraMap ↥E L) :=
    Commons.RingTheory.Valuation.eq_of_comap_eq_of_isAlgebraic WK _ _ hcomapψ hcomapinc
  -- hence the two valuations agree on the images
  have hval : ∀ z : ↥E, W.valuation (ψ z) = W.valuation (algebraMap ↥E L z) :=
    valuation_eq_of_comap_eq hEalg W ψ hAB
  -- the element `x - y` of `K⟮x⟯`
  have hxE : x ∈ E := IntermediateField.mem_adjoin_simple_self ↥K x
  set w : ↥E := ⟨x, hxE⟩ - algebraMap ↥K ↥E ⟨y, hyK⟩ with hwdef
  have hwgen : (⟨x, hxE⟩ : ↥E) = IntermediateField.AdjoinSimple.gen ↥K x := rfl
  have hwL : (algebraMap ↥E L w : L) = x - y := by
    rw [hwdef, map_sub]
    simp [IntermediateField.algebraMap_apply]
  have hψy : ψ (algebraMap ↥K ↥E ⟨y, hyK⟩) = y := by
    rw [ψ.commutes, IntermediateField.algebraMap_apply]
  have hψw : ψ w = x' - y := by
    rw [hwdef, map_sub, hψy, hwgen, hψx]
  have hwval : W.valuation (x' - y) = W.valuation (x - y) := by
    rw [← hψw, ← hwL]
    exact hval w
  -- the conjugate `x'` is an `F`-conjugate of `x`, so the hypothesis applies to it
  have hconjF : IsConjRoot F x x' := hconj.of_isScalarTower (IsSeparable.isIntegral hx)
  have hlt := h x' hconjF hne
  -- the ultrametric inequality contradicts the hypothesis
  have hultra : W.valuation (x - x') ≤ W.valuation (x - y) := by
    have h1 : x - x' = (x - y) - (x' - y) := by ring
    rw [h1]
    refine le_trans (W.valuation.map_sub _ _) (max_le le_rfl ?_)
    exact le_of_eq hwval
  exact absurd hlt (not_lt_of_ge hultra)

end NK.RingTheory.Valuation
