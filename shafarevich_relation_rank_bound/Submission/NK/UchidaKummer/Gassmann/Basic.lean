# The Gassmann/`I_H` algebra of Uchida's weak Neukirch–Uchida theorem

Reference: arXiv:2601.01251, §6 (*Weak Neukirch–Uchida*), final step of the proof of
`thm:uchida isomorphism`.

Let `G` be a finite group, `R` a commutative ring and `R[G]` the group algebra.
For a subgroup `H ≤ G` we write `I_H R[G]` for the `R`-submodule generated by the
elements `h·m - m` (`h ∈ H`, `m ∈ R[G]`), i.e. the left ideal of `R[G]` generated by
`{h - 1 : h ∈ H}`.  Equivalently `I_H R[G]` is the kernel of the natural map
`R[G] → R[H\G]`, so that `R[G]/I_H R[G] ≅ R[H\G]`.
-/

import Mathlib

open scoped Pointwise

noncomputable section

attribute [local instance] Classical.propDecidable

namespace NK.UchidaKummer

open MonoidAlgebra

variable {G : Type*} [Group G]

/-- **The submodule `I_H M` of §6, for `M = R[G]`.** -/
def IH (R : Type*) [CommRing R] (H : Subgroup G) : Submodule R (MonoidAlgebra R G) :=
  Submodule.span R (Set.range fun p : H × G =>
    MonoidAlgebra.single ((p.1 : G) * p.2) (1 : R) - MonoidAlgebra.single p.2 (1 : R))

variable (R : Type*) [CommRing R]

/-- The generators of `IH` lie in `IH`. -/
theorem single_mul_sub_single_mem_IH (H : Subgroup G) (h : H) (g : G) :
    MonoidAlgebra.single ((h : G) * g) (1 : R) - MonoidAlgebra.single g (1 : R) ∈ IH R H :=
  Submodule.subset_span ⟨(h, g), rfl⟩

/-- **The coset-sum functional.** -/
def cosetInd (H : Subgroup G) (g₀ : G) : MonoidAlgebra R G →ₗ[R] R where
  toFun x := (Finsupp.lsum R fun g : G =>
    if ∃ k : H, (k : G) * g₀ = g then (LinearMap.id : R →ₗ[R] R) else 0) x.coeff
  map_add' x y := by rw [MonoidAlgebra.coeff_add, map_add]
  map_smul' r x := by rw [MonoidAlgebra.coeff_smul, map_smul, RingHom.id_apply]

/-- The value of the coset-sum functional on a standard basis vector. -/
theorem cosetInd_single (H : Subgroup G) (g₀ g : G) :
    cosetInd R H g₀ (MonoidAlgebra.single g (1 : R)) =
      if ∃ k : H, (k : G) * g₀ = g then 1 else 0 := by
  show (Finsupp.lsum R fun g : G =>
    if ∃ k : H, (k : G) * g₀ = g then (LinearMap.id : R →ₗ[R] R) else 0)
      (MonoidAlgebra.single g (1 : R)).coeff = _
  rw [MonoidAlgebra.coeff_single, Finsupp.lsum_single]
  split <;> rfl

/-- The coset-sum functional vanishes on the generators of `I_H`. -/
theorem cosetInd_gen (H : Subgroup G) (g₀ g' : G) (h₀ : H) :
    cosetInd R H g₀ (MonoidAlgebra.single ((h₀ : G) * g') (1 : R)
      - MonoidAlgebra.single g' (1 : R)) = (0 : R) := by
  rw [map_sub, cosetInd_single, cosetInd_single]
  have key : (∃ k : H, (k : G) * g₀ = (h₀ : G) * g') ↔ (∃ k : H, (k : G) * g₀ = g') := by
    constructor
    · rintro ⟨k, hk⟩
      exact ⟨h₀⁻¹ * k, by rw [Subgroup.coe_mul, mul_assoc, hk]; simp⟩
    · rintro ⟨k, hk⟩
      exact ⟨h₀ * k, by rw [Subgroup.coe_mul, mul_assoc, hk]⟩
  by_cases h : ∃ k : H, (k : G) * g₀ = g'
  · rw [if_pos (key.mpr h), if_pos h, sub_self]
  · rw [if_neg (fun hh => h (key.mp hh)), if_neg h, sub_zero]

/-- The coset-sum functional vanishes on all of `I_H`. -/
theorem cosetInd_eq_zero_of_mem (H : Subgroup G) (g₀ : G) {x : MonoidAlgebra R G}
    (hx : x ∈ IH R H) : cosetInd R H g₀ x = 0 := by
  refine Submodule.span_induction (p := fun x _ => cosetInd R H g₀ x = 0) ?_ ?_ ?_ ?_ hx
  · rintro y ⟨p, rfl⟩
    exact cosetInd_gen R H g₀ p.2 p.1
  · simp
  · intro y z hy hz hy' hz'
    rw [map_add, hy', hz', add_zero]
  · intro r y hy hy'
    rw [map_smul, hy', smul_zero]

/-- **The key membership criterion for `I_H`.** -/
theorem exists_mul_eq_of_mem_IH [Nontrivial R] (H : Subgroup G) {g' g'' : G}
    (h : MonoidAlgebra.single g' (1 : R) - MonoidAlgebra.single g'' (1 : R) ∈ IH R H) :
    ∃ k : H, g' = (k : G) * g'' := by
  have h0 := cosetInd_eq_zero_of_mem R H g'' h
  rw [map_sub, cosetInd_single, cosetInd_single] at h0
  have h1 : ∃ k : H, (k : G) * g'' = g'' := ⟨1, by simp⟩
  rw [if_pos h1, sub_eq_zero] at h0
  by_contra hc
  rw [if_neg (fun hh => hc (by obtain ⟨k, hk⟩ := hh; exact ⟨k, hk.symm⟩))] at h0
  exact one_ne_zero h0.symm

/-- The reverse direction of `exists_mul_eq_of_mem_IH`. -/
theorem mem_IH_of_exists_mul_eq (H : Subgroup G) {g' g'' : G}
    (h : ∃ k : H, g' = (k : G) * g'') :
    MonoidAlgebra.single g' (1 : R) - MonoidAlgebra.single g'' (1 : R) ∈ IH R H := by
  obtain ⟨k, rfl⟩ := h
  exact single_mul_sub_single_mem_IH R H k g''

/-- **Membership criterion for `I_H` on differences of basis vectors, in `↔` form.** -/
theorem single_sub_single_mem_IH_iff [Nontrivial R] (H : Subgroup G) {g' g'' : G} :
    MonoidAlgebra.single g' (1 : R) - MonoidAlgebra.single g'' (1 : R) ∈ IH R H ↔
      ∃ k : H, g' = (k : G) * g'' :=
  ⟨exists_mul_eq_of_mem_IH R H, mem_IH_of_exists_mul_eq R H⟩

end NK.UchidaKummer
