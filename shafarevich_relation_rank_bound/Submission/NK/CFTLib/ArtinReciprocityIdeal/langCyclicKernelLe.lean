import Mathlib
import Submission.NK.CFTLib.ArtinReciprocityIdeal.LangDefs
import Submission.NK.CFTLib.ArtinReciprocityIdeal.frobAtPrime_prod_relNorm_eq_one
import Submission.NK.CFTLib.ARL.artinReciprocity_cyclotomic
import Submission.NK.CFTLib.ArtinReciprocityIdeal.CyclotomicSubextension
import Submission.NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem
import Submission.NK.CFTLib.ArtinReciprocityIdeal.exists_admissible
import Submission.NK.CFTLib.ArtinReciprocityIdeal.kernelLeOfAdmissible

/-!
# Lang's kernel containment for cyclic extensions (Lang, ANT, Ch. X §2, Theorem 2)

For a finite **cyclic** extension `L / K` of number fields, Lang's Theorem 2 (the heart of the
ideal-theoretic reciprocity law) states that for a suitable modulus `m` — admissible in the sense
of `NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible` and divisible by all the primes ramified in
`L / K` — the kernel of the ideal-theoretic Artin symbol on the ideals coprime to `(m)` is
contained in `P(m) · 𝔑(m)`:

* `P(m) = principalRay K m` is the group of principal ideals `(a)` with `a ≡ 1 mod (m)` and
  totally positive (the "principal ray"), and
* `𝔑(m) = normRay K L m` is the group generated by the relative norms of the ideals of `𝓞 L`
  coprime to `(m)`.

The existence of the modulus is `NK.CFTLib.ArtinReciprocityIdeal.exists_admissible`
(`Submission/Work/CFTLib/ArtinReciprocityIdeal/exists_admissible.lean`), and the kernel
containment for a fixed admissible modulus is
`NK.CFTLib.ArtinReciprocityIdeal.kernelLeOfAdmissible`, which is proved by the classical
argument of Lang (loc. cit., pp. 204–205) / Childress, *Class Field Theory*, Proposition 2.2
(Artin's lemma together with the cyclotomic case of the reciprocity law).  This file is the
two-line assembly of the two.
-/

namespace NK.CFTLib.ArtinReciprocityIdeal

theorem langCyclicKernelLe (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] [IsCyclic (Gal(L/K))]
    [IsMulCommutative (Gal(L/K))] :
    ∃ m : ℕ, 0 < m ∧ NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible K L m ∧
      (∀ p : NK.Chebotarev.PrimeIdeal K,
        ¬ NK.CFTLib.ArtinReciprocityIdeal.IsUnramified (K := K) (L := L) p →
        (m : NumberField.RingOfIntegers K) ∈ p.asIdeal) ∧
      ∀ A : NK.CFTLib.ArtinReciprocityIdeal.Frac K,
        NK.CFTLib.ArtinReciprocityIdeal.FracCoprime m A →
        NK.CFTLib.Arl.artinSym (K := K) (L := L) IsMulCommutative.is_comm.comm A = 1 →
        A ∈ NK.CFTLib.ArtinReciprocityIdeal.principalRay K m ⊔
            NK.CFTLib.ArtinReciprocityIdeal.normRay K L m := by
  obtain ⟨m, hm, hadm, hram⟩ := exists_admissible (K := K) (L := L)
  exact ⟨m, hm, hadm, hram,
    fun A hcop hsym => kernelLeOfAdmissible K L m hm hadm hram A hcop hsym⟩

end NK.CFTLib.ArtinReciprocityIdeal
