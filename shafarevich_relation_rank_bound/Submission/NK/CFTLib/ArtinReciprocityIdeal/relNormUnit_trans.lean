import Mathlib
import Submission.NK.CFTLib.ARL.RelNormFI

/-!
# Transitivity of the relative ideal norm

`NK.CFTLib.ARL.relNormUnit` is the relative norm as a homomorphism of the groups of fractional
ideals.  This module proves that it is transitive in a tower `K ⊆ E ⊆ M` of number fields:

  `N_{E/K}(N_{M/E} A) = N_{M/K} A`  for `A` a fractional ideal of `M`,

the fractional-ideal version of `Ideal.relNorm_relNorm`.

The proof is by reduction to prime ideals: the group of fractional ideals is generated by the
`primeUnit 𝔓`, and on a prime the claim is `relNormFI_coeIdeal` together with
`Ideal.relNorm_relNorm`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open NumberField IsDedekindDomain
open scoped NumberField nonZeroDivisors

noncomputable section

namespace NK.CFTLib.ARL

variable {K : Type} [Field K] [NumberField K]
  {E M : Type} [Field E] [NumberField E] [Field M] [NumberField M]
  [Algebra K E] [Algebra E M] [Algebra K M] [IsScalarTower K E M]
  [FiniteDimensional K E] [FiniteDimensional E M] [FiniteDimensional K M]

/-- The underlying fractional ideal of `relNormUnit A` is `relNormFI A` (definitional). -/
lemma relNormUnit_apply_e (A : (FractionalIdeal (𝓞 E)⁰ E)ˣ) :
    ((relNormUnit (K := K) (L := E) A : (FractionalIdeal (𝓞 K)⁰ K)ˣ) :
      FractionalIdeal (𝓞 K)⁰ K) = relNormFI (K := K) (L := E) (A : FractionalIdeal (𝓞 E)⁰ E) :=
  rfl

/-- The underlying fractional ideal of `relNormUnit A` is `relNormFI A` (definitional). -/
lemma relNormUnit_apply_m (A : (FractionalIdeal (𝓞 M)⁰ M)ˣ) :
    ((relNormUnit (K := E) (L := M) A : (FractionalIdeal (𝓞 E)⁰ E)ˣ) :
      FractionalIdeal (𝓞 E)⁰ E) = relNormFI (K := E) (L := M) (A : FractionalIdeal (𝓞 M)⁰ M) :=
  rfl

/-- **Two homomorphisms on the group of fractional ideals agreeing on the prime ideals agree.**
The group of fractional ideals of a Dedekind domain is generated by its prime ideals. -/
theorem units_frac_eq_of_forall_primeUnit_eq {H : Type} [CommGroup H]
    (f g : (FractionalIdeal (𝓞 K)⁰ K)ˣ →* H)
    (h : ∀ 𝔮 : HeightOneSpectrum (𝓞 K), f (primeUnit 𝔮) = g (primeUnit 𝔮)) : f = g := by
  classical
  refine MonoidHom.ext fun A => ?_
  set S : Finset (HeightOneSpectrum (𝓞 K)) :=
    (Filter.eventually_cofinite.mp (FractionalIdeal.finite_factors (K := K)
      (A : FractionalIdeal (𝓞 K)⁰ K))).toFinset with hS
  have hSmem : ∀ 𝔮, 𝔮 ∈ S ↔ FractionalIdeal.count K 𝔮 (A : FractionalIdeal (𝓞 K)⁰ K) ≠ 0 :=
    fun 𝔮 => Set.Finite.mem_toFinset _
  have hsupp : Function.mulSupport (fun 𝔮 : HeightOneSpectrum (𝓞 K) =>
      ((𝔮.asIdeal : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K) ^
        FractionalIdeal.count K 𝔮 (A : FractionalIdeal (𝓞 K)⁰ K)) ⊆ ↑S := by
    intro 𝔮 h𝔮
    exact (hSmem 𝔮).mpr fun h0 => h𝔮 (by simp only [h0, zpow_zero])
  have hfac : (∏ 𝔮 ∈ S, (primeUnit 𝔮) ^
      FractionalIdeal.count K 𝔮 (A : FractionalIdeal (𝓞 K)⁰ K)) = A := by
    apply Units.ext
    rw [Units.coe_prod]
    simp only [primeUnit_val, Units.val_zpow_eq_zpow_val]
    rw [← finprod_eq_prod_of_mulSupport_subset _ hsupp]
    exact FractionalIdeal.finprod_heightOneSpectrum_factorization' K A.ne_zero
  rw [← hfac, map_prod, map_prod]
  refine Finset.prod_congr rfl fun 𝔮 _ => ?_
  rw [map_zpow, map_zpow, h 𝔮]

/-- **Transitivity of the relative norm of fractional ideals.**  For a tower `K ⊆ E ⊆ M` of number
fields and `A` a fractional ideal of `M`,

  `N_{E/K}(N_{M/E} A) = N_{M/K} A`. -/
theorem relNormUnit_trans (A : (FractionalIdeal (𝓞 M)⁰ M)ˣ) :
    relNormUnit (K := K) (L := E) (relNormUnit (K := E) (L := M) A)
      = relNormUnit (K := K) (L := M) A := by
  classical
  let f : (FractionalIdeal (𝓞 M)⁰ M)ˣ →* (FractionalIdeal (𝓞 K)⁰ K)ˣ :=
    (relNormUnit (K := K) (L := E)).comp (relNormUnit (K := E) (L := M))
  have key : f = relNormUnit (K := K) (L := M) := by
    refine units_frac_eq_of_forall_primeUnit_eq (K := M) f _ fun 𝔓 => ?_
    show relNormUnit (K := K) (L := E)
        (relNormUnit (K := E) (L := M) (primeUnit 𝔓))
      = relNormUnit (K := K) (L := M) (primeUnit 𝔓)
    rw [relNormUnit_primeUnit (K := E) (L := M) 𝔓,
      relNormUnit_primeUnit (K := K) (L := M) 𝔓]
    have hrel : (Ideal.relNorm (𝓞 E) 𝔓.asIdeal) ≠ ⊥ :=
      fun h => 𝔓.ne_bot ((Ideal.relNorm_eq_bot_iff).mp h)
    apply Units.ext
    simp only [relNormUnit_apply_e, Units.val_mk0]
    rw [relNormFI_coeIdeal (K := K) (L := E) (Ideal.relNorm (𝓞 E) 𝔓.asIdeal) hrel]
    rw [Ideal.relNorm_relNorm (𝓞 K) (𝓞 E) 𝔓.asIdeal]
  exact congrArg (fun φ : (FractionalIdeal (𝓞 M)⁰ M)ˣ →* (FractionalIdeal (𝓞 K)⁰ K)ˣ =>
    φ A) key

end NK.CFTLib.ARL
