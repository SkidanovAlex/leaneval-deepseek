/-
Work of the Neukirch–Uchida team: the Čebotarev density theorem.
-/
import Submission.NK.Chebotarev.KroneckerWeber
import Submission.NK.Chebotarev.QuadraticGaussSumInCyclotomic

/-!
# Square roots of rationals inside cyclotomic fields

The **quadratic case of Kronecker–Weber** is the statement that every quadratic field `ℚ(√d)` is
contained in a cyclotomic field.  Since a quadratic extension of `ℚ` is generated by a square root,
this reduces to showing that `√d` lies in some `ℚ(ζ_n)`.

The arithmetic input is the quadratic Gauss sum: for an odd prime `p` and a primitive `p`-th root of
unity `ζ`, the Gauss sum `∑_{a} (a/p) ζ^a` lies in `ℚ(ζ)` and has square `(-1)^{(p-1)/2} p`, so
`√(±p) ∈ ℚ(ζ_p)` (`NK.Chebotarev.QuadraticGaussSumInCyclotomic`).  Multiplying these square roots
and adjoining `√2`, `√-2 ∈ ℚ(ζ_8)` gives `√m ∈ ℚ(ζ_{8|m|})` for every squarefree integer `m`.
-/

set_option linter.unusedSectionVars false

universe u

namespace NK.Chebotarev

/-- A cyclotomic field together with a square root of the rational number `d` in it. -/
structure SqrtInCyclotomic (d : ℚ) : Type (u + 1) where
  /-- the level of the cyclotomic field -/
  n : ℕ
  /-- the level is positive -/
  hn : 0 < n
  /-- the cyclotomic field -/
  F : Type u
  [fieldF : Field F]
  [numberFieldF : NumberField F]
  [algebraF : Algebra ℚ F]
  [cycloF : IsCyclotomicExtension {n} ℚ F]
  /-- the square root -/
  x : F
  /-- it really is a square root of `d` -/
  x_sq : x ^ 2 = algebraMap ℚ F d

attribute [instance] SqrtInCyclotomic.fieldF SqrtInCyclotomic.numberFieldF
  SqrtInCyclotomic.algebraF SqrtInCyclotomic.cycloF

end NK.Chebotarev
