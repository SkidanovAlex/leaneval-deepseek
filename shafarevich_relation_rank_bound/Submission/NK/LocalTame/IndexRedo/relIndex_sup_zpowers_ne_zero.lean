import Mathlib

/-!
# The relative index of `L` in `L ⊔ ⟨w⟩` is finite when `w ^ ℓ ∈ L`

Let `A` be a group, `L ≤ A` a normal subgroup, `ℓ` a prime and `w : A` with `w ^ ℓ ∈ L`.
Then `L` has finite index in `K := L ⊔ Subgroup.zpowers w`; equivalently
`L.relIndex K ≠ 0` (recall that `relIndex` returns `0` for infinite index).

Indeed `K / L` is generated by the image `x` of `w`, which satisfies `x ^ ℓ = 1`, so
`K / L ≃* Subgroup.zpowers x` is cyclic of order dividing `ℓ`; in particular finite and
non-trivial.  Formally we take the composite `f : K →* A ⧸ L` of the inclusion with the
quotient map: its kernel is `L.subgroupOf K` and its range is `Subgroup.zpowers x`, so
Noether's first isomorphism theorem identifies `K ⧸ L.subgroupOf K` with `⟨x⟩`.
-/

namespace NK.LocalTame.IndexRedo

theorem relIndex_sup_zpowers_ne_zero {A : Type*} [Group A] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (L : Subgroup A) [L.Normal] (w : A) (hw : w ^ ℓ ∈ L) :
    L.relIndex (L ⊔ Subgroup.zpowers w) ≠ 0 := by
  set K : Subgroup A := L ⊔ Subgroup.zpowers w with hK
  let f : K →* A ⧸ L := (QuotientGroup.mk' L).comp K.subtype
  -- the kernel of `f` is `L.subgroupOf K`
  have hker : f.ker = L.subgroupOf K := by
    rw [show f = (QuotientGroup.mk' L).comp K.subtype from rfl]
    rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
    rfl
  -- the range of `f` is the cyclic subgroup generated by the image of `w`
  have hrange : f.range = Subgroup.zpowers (QuotientGroup.mk' L w) := by
    have h1 : f.range = Subgroup.map (QuotientGroup.mk' L) K := by
      rw [show f = (QuotientGroup.mk' L).comp K.subtype from rfl]
      rw [MonoidHom.range_eq_map, ← Subgroup.map_map, ← MonoidHom.range_eq_map,
        Subgroup.range_subtype]
    rw [h1, hK, Subgroup.map_sup, MonoidHom.map_zpowers]
    have h : Subgroup.map (QuotientGroup.mk' L) L = ⊥ := by
      rw [Subgroup.map_eq_bot_iff]
      exact le_of_eq (QuotientGroup.ker_mk' L).symm
    rw [h, bot_sup_eq]
  -- the image of `w` in `A ⧸ L` has order dividing `ℓ`
  have hx : (QuotientGroup.mk' L w) ^ ℓ = 1 := by
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hw
  have hcard : Nat.card (K ⧸ L.subgroupOf K) = orderOf (QuotientGroup.mk' L w) :=
    calc Nat.card (K ⧸ L.subgroupOf K)
        = Nat.card (K ⧸ f.ker) :=
          (congrArg (fun S : Subgroup K => Nat.card (K ⧸ S)) hker).symm
      _ = Nat.card f.range := Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
      _ = Nat.card (Subgroup.zpowers (QuotientGroup.mk' L w)) :=
          congrArg (fun S : Subgroup (A ⧸ L) => Nat.card S) hrange
      _ = orderOf (QuotientGroup.mk' L w) := Nat.card_zpowers _
  show Nat.card (K ⧸ L.subgroupOf K) ≠ 0
  rw [hcard]
  exact ne_of_gt (Nat.pos_of_dvd_of_pos (orderOf_dvd_iff_pow_eq_one.mpr hx) hℓ.pos)

end NK.LocalTame.IndexRedo
