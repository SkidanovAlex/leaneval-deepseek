/-!
# Surjectivity of the `S`-units onto the product of the local unit quotients

Let `K` be a number field containing a primitive `p`-th root of unity `ζ` (`p` prime), let `S`
be a finite set of places containing all the archimedean places and all the places above `p`,
and let `a ∈ U(S)` be an `S`-unit which is a local `p`-th power of a unit at every place of a
finite set `T` of primes, disjoint from `S`, with `|S| = |T| + 1`.  Assume moreover (this is the
Kummer-theoretic content of Milne, *Class Field Theory*, Lemma 6.3) that every `S`-unit which
is a local `p`-th power of a unit at every prime of `T` lies in `⟨a⟩ · U(S)^p`.

Then every `S`-idèle can be multiplied into a `p`-th power of a local unit at every prime of
`T` by a principal idèle of an `S`-unit.  Equivalently (Milne, Lemma 6.9), the map

`U(S) ⟶ ∏_{q ∈ T} U_q / U_q^p ,  u ↦ (u_q mod p-th powers)`

is *surjective*.  This is proved by a cardinality count: the kernel of this map is `⟨a⟩·U(S)^p`
by hypothesis, `[U(S) : U(S)^p] = p ^ |S|` (`tUnits_index_powSubgroup`), the target has order
`p ^ |T|` (each `|U_q : U_q^p| = p` when `q ∤ p` and `ζ_p ∈ K_q`), and `[U(S) : ⟨a⟩U(S)^p]` is at
most `p ^ |T|` because `⟨a⟩U(S)^p/U(S)^p` is a quotient of the cyclic group `⟨a⟩/⟨a⟩^p`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open scoped NumberField RestrictedProduct
open NumberField IsDedekindDomain

noncomputable section

namespace NK.GlobalCFTdeep.SecondInequality.KummerCase

open NK.GlobalCFT

variable {K : Type} [Field K] [NumberField K]

/-! ### The local unit quotient -/

/-- The local units at a finite place, modulo the subgroup of `p`-th powers, in the form of the
unit group `𝒪_qˣ` of the ring of integers of the completion. -/
abbrev localUnitQuot (p : ℕ)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) : Type _ :=
  ↥((q.adicCompletionIntegers K).unitGroup) ⧸
    (powMonoidHom p : ↥((q.adicCompletionIntegers K).unitGroup) →*
      ↥((q.adicCompletionIntegers K).unitGroup)).range

/-- `Place.localUnits` at a finite place is the unit group of the ring of integers of the
completion. -/
theorem localUnits_eq_unitGroup
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    Place.localUnits K (Place.ofFinite q) = (q.adicCompletionIntegers K).unitGroup := by
  rw [Place.localUnits_ofFinite]
  ext x
  rw [IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers.mem_units_iff_valued_eq_one,
    show (q.adicCompletionIntegers K) =
      (Valued.v (R := q.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))).valuationSubring
      from rfl,
    Valuation.mem_unitGroup_iff]

/-- The `p`-power quotient of the local units at a finite place `q` has order `p`, when `p` is
prime to the residue characteristic of `q` and the completion `K_q` contains a primitive `p`-th
root of unity (Milne, *CFT*, Proposition 6.8). -/
theorem card_localUnitQuot
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {p : ℕ} (hp : p.Prime)
    (hnot : (p : NumberField.RingOfIntegers K) ∉ q.asIdeal)
    (hζ : ∃ ζ : q.adicCompletion K, IsPrimitiveRoot ζ p) :
    Nat.card (localUnitQuot (K := K) p q) = p := by
  rw [NK.LocalInputs.PowerQuotient.natCard_quot_powMonoidHom_eq_of_mulEquiv p
    (ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K))]
  rw [NK.GlobalCFTdeep.SecondInequality.natCard_units_quot_eq_residueUnits q hp
    (NK.GlobalCFTdeep.SecondInequality.isUnit_natCast_adicCompletionIntegers_of_notMem q hnot)]
  exact NK.GlobalCFTdeep.SecondInequality.natCard_residueUnits_quot_pow_of_dvd q hp
    (NK.GlobalCFTdeep.SecondInequality.dvd_natCard_residueUnits_of_exists_isPrimitiveRoot
      q hp hnot hζ)

/-! ### Two group-theoretic inputs -/

/-- A group generated by an element whose `p`-th power is trivial has at most `p` elements. -/
theorem natCard_le_of_zpowers_eq_top_of_pow_eq_one {G : Type*} [Group G] {p : ℕ} (hp : p.Prime)
    {g : G} (htop : Subgroup.zpowers g = ⊤) (hgp : g ^ p = 1) : Nat.card G ≤ p := by
  have h1 : Nat.card G = Nat.card ↥(⊤ : Subgroup G) :=
    (Nat.card_congr (Subgroup.topEquiv (G := G)).toEquiv).symm
  have h2 : Nat.card ↥(⊤ : Subgroup G) = Nat.card ↥(Subgroup.zpowers g) := by rw [htop]
  have h3 : Nat.card ↥(Subgroup.zpowers g) = orderOf g := Nat.card_zpowers g
  have hcard : Nat.card G = orderOf g := h1.trans (h2.trans h3)
  have hdiv : orderOf g ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hgp
  rcases (Nat.dvd_prime hp).mp hdiv with h | h
  · rw [hcard, h]
    exact le_of_lt hp.one_lt
  · rw [hcard, h]

/-- If two positive natural numbers have product `p ^ (t+1)`, the first is at most `p ^ t` and
the second at most `p`, then they are `p ^ t` and `p`. -/
theorem eq_pow_and_eq_prime_of_mul_eq {p t a b : ℕ} (hp : p.Prime) (ha : a ≤ p ^ t)
    (hb : b ≤ p) (h : a * b = p ^ (t + 1)) : a = p ^ t ∧ b = p := by
  have hp0 : 0 < p := hp.pos
  have hpt : 0 < p ^ t := pow_pos hp0 t
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [mul_zero] at h
    exact absurd h.symm (pow_ne_zero _ hp.ne_zero)
  have hle : p ^ t * b ≤ a * b := by
    rw [h, pow_succ]
    exact Nat.mul_le_mul_left _ hb
  have hge : a * b ≤ p ^ t * b := Nat.mul_le_mul_right b ha
  have hab : a * b = p ^ t * b := le_antisymm hge hle
  have h2 : p ^ t * b = p ^ t * p := by rw [← hab, h, pow_succ]
  have hb_eq : b = p := Nat.mul_left_cancel hpt h2
  have h3 : a * p = p ^ t * p := by
    have h3a : a * p = a * b := by rw [hb_eq]
    rw [h3a, h, pow_succ]
  have ha_eq : a = p ^ t := Nat.mul_right_cancel hp0 h3
  exact ⟨ha_eq, hb_eq⟩

/-! ### The map from the `S`-units to the product of the local quotients -/

/-- The `q`-component of an `S`-unit, as an element of the unit group of the ring of integers of
`K_q` (a unit of `K_q` at a place `q ∉ S` is a local unit). -/
def localUnitComponent (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (S : Finset (Place K)) (hq : Place.ofFinite q ∉ S) :
    TUnits (L := K) (S : Set (Place K)) →* ↥((q.adicCompletionIntegers K).unitGroup) where
  toFun u :=
    ⟨Units.map (algebraMap K (q.adicCompletion K)) (u : Kˣ),
      (localUnits_eq_unitGroup (K := K) q).le ((mem_TUnits.mp u.2) (Place.ofFinite q) hq)⟩
  map_one' := Subtype.ext (by simp)
  map_mul' u v := Subtype.ext (by simp)

/-- The underlying unit of `localUnitComponent`. -/
@[simp] theorem coe_localUnitComponent
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (S : Finset (Place K)) (hq : Place.ofFinite q ∉ S)
    (u : TUnits (L := K) (S : Set (Place K))) :
    ((localUnitComponent (K := K) q S hq u : ↥((q.adicCompletionIntegers K).unitGroup)) :
      (q.adicCompletion K)ˣ)
      = Units.map (algebraMap K (q.adicCompletion K)) (u : Kˣ) := rfl

/-- The `q`-component of an `S`-unit in the local `p`-power quotient `U_q/U_q^p`. -/
abbrev compAt (p : ℕ) (S : Finset (Place K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hq : Place.ofFinite q ∉ S) (u : TUnits (L := K) (S : Set (Place K))) :
    localUnitQuot (K := K) p q :=
  QuotientGroup.mk' (powMonoidHom (α := ↥((q.adicCompletionIntegers K).unitGroup)) p).range
    (localUnitComponent (K := K) q S hq u)

/-- `compAt` is multiplicative. -/
theorem compAt_mul (p : ℕ) (S : Finset (Place K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hq : Place.ofFinite q ∉ S) (u v : TUnits (L := K) (S : Set (Place K))) :
    compAt (K := K) p S q hq (u * v) =
      compAt (K := K) p S q hq u * compAt (K := K) p S q hq v := by
  rw [compAt, compAt, compAt, map_mul, map_mul]

/-- `compAt` is unital. -/
theorem compAt_one (p : ℕ) (S : Finset (Place K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hq : Place.ofFinite q ∉ S) :
    compAt (K := K) p S q hq 1 = 1 := by
  rw [compAt, map_one, map_one]

/-- `compAt` respects inverses. -/
theorem compAt_inv (p : ℕ) (S : Finset (Place K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hq : Place.ofFinite q ∉ S) (u : TUnits (L := K) (S : Set (Place K))) :
    compAt (K := K) p S q hq u⁻¹ = (compAt (K := K) p S q hq u)⁻¹ := by
  rw [compAt, compAt, map_inv, map_inv]

theorem exists_tUnits_surj {K : Type} [Field K] [NumberField K]
    {p : ℕ} (hp : p.Prime) {ζ : K} (hζ : IsPrimitiveRoot ζ p)
    (S : Finset (NK.GlobalCFT.Place K))
    (hSinf : ∀ w : NumberField.InfinitePlace K, NK.GlobalCFT.Place.ofInfinite w ∈ S)
    (hSp : ∀ q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (p : NumberField.RingOfIntegers K) ∈ q.asIdeal → NK.GlobalCFT.Place.ofFinite q ∈ S)
    (a : K) (ha : a ≠ 0)
    (haS : Units.mk0 a ha ∈ NK.GlobalCFTdeep.TUnits (L := K) (S : Set (NK.GlobalCFT.Place K)))
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))
    (hTdisj : ∀ q ∈ T, NK.GlobalCFT.Place.ofFinite q ∉ S)
    (hcardT : S.card = T.card + 1)
    (haq : ∀ q ∈ T, ∃ c : (q.adicCompletionIntegers K)ˣ,
      algebraMap K (q.adicCompletion K) a =
        ((c : q.adicCompletionIntegers K) : q.adicCompletion K) ^ p)
    (hker : ∀ b : K, ∀ hb : b ≠ 0,
      Units.mk0 b hb ∈ NK.GlobalCFTdeep.TUnits (L := K) (S : Set (NK.GlobalCFT.Place K)) →
      (∀ q ∈ T, ∃ c : (q.adicCompletionIntegers K)ˣ,
        algebraMap K (q.adicCompletion K) b =
          ((c : q.adicCompletionIntegers K) : q.adicCompletion K) ^ p) →
      Units.mk0 b hb ∈ Subgroup.closure {Units.mk0 a ha} ⊔
        Subgroup.map (powMonoidHom p)
          (NK.GlobalCFTdeep.TUnits (L := K) (S : Set (NK.GlobalCFT.Place K)))) :
    ∀ x : NK.GlobalCFT.Idele K, x ∈ NK.GlobalCFTdeep.TIdeles (S : Set (NK.GlobalCFT.Place K)) →
      ∃ u : NK.GlobalCFTdeep.TUnits (L := K) (S : Set (NK.GlobalCFT.Place K)),
        ∀ q ∈ T, ∃ c : (q.adicCompletionIntegers K)ˣ,
          x (NK.GlobalCFT.Place.ofFinite q) *
            (NK.GlobalCFT.Idele.principalIdele K (u : Kˣ) (NK.GlobalCFT.Place.ofFinite q))⁻¹
            = ((c : q.adicCompletionIntegers K) : q.adicCompletion K) ^ p := by
  classical
  -- ## Setup
  let U : Subgroup Kˣ := TUnits (L := K) (S : Set (Place K))
  let aK : Kˣ := Units.mk0 a ha
  let aU : U := ⟨aK, haS⟩
  let PU : Subgroup U := (powMonoidHom (α := U) p).range
  let HU : Subgroup U := Subgroup.closure {aU}
  let AK : Subgroup Kˣ := Subgroup.closure {aK} ⊔ Subgroup.map (powMonoidHom p) U
  let AU : Subgroup U := AK.subgroupOf U
  -- the kernel of the component map, described componentwise
  let KΦ : Subgroup U :=
    { carrier := {u | ∀ q : ↥T, compAt (K := K) p S q.1 (hTdisj q.1 q.2) u = 1}
      one_mem' := fun q => compAt_one (K := K) p S q.1 (hTdisj q.1 q.2)
      mul_mem' := fun {u v} hu hv q => by
        have h1 : localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) u ∈
            (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range :=
          (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
            (hTdisj q.1 q.2) u)).mp (hu q)
        have h2 : localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) v ∈
            (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range :=
          (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
            (hTdisj q.1 q.2) v)).mp (hv q)
        refine (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
          (hTdisj q.1 q.2) (u * v))).mpr ?_
        rw [map_mul]
        exact Subgroup.mul_mem _ h1 h2
      inv_mem' := fun {u} hu q => by
        have h1 : localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) u ∈
            (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range :=
          (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
            (hTdisj q.1 q.2) u)).mp (hu q)
        refine (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
          (hTdisj q.1 q.2) u⁻¹)).mpr ?_
        rw [map_inv]
        exact Subgroup.inv_mem _ h1 }
  let funφ : U → (∀ q : ↥T, localUnitQuot (K := K) p q.1) := fun u q =>
    compAt (K := K) p S q.1 (hTdisj q.1 q.2) u
  -- ## Local inputs
  have hSinf' : ∀ w : Place K, w.IsInfinite → w ∈ S := by
    intro w hw
    obtain ⟨w', rfl⟩ := Place.isInfinite_iff.mp hw
    exact hSinf w'
  have hnotp : ∀ q ∈ T, (p : 𝓞 K) ∉ q.asIdeal := by
    intro q hq hmem
    exact hTdisj q hq (hSp q hmem)
  have hζq : ∀ q ∈ T, ∃ ζ' : q.adicCompletion K, IsPrimitiveRoot ζ' p := by
    intro q _
    exact ⟨algebraMap K (q.adicCompletion K) ζ,
      hζ.map_of_injective (RingHom.injective (algebraMap K (q.adicCompletion K)))⟩
  have hcard_local : ∀ q ∈ T, Nat.card (localUnitQuot (K := K) p q) = p := fun q hq =>
    card_localUnitQuot q hp (hnotp q hq) (hζq q hq)
  have hcard_target : Nat.card (∀ q : ↥T, localUnitQuot (K := K) p q.1) = p ^ T.card := by
    rw [Nat.card_pi]
    rw [Finset.prod_congr rfl
      (fun q (_ : q ∈ (Finset.univ : Finset ↥T)) => hcard_local q.1 q.2)]
    simp [Finset.prod_const]
  haveI hfinite_target : Finite (∀ q : ↥T, localUnitQuot (K := K) p q.1) := by
    haveI : ∀ q : ↥T, Finite (localUnitQuot (K := K) p q.1) := fun q =>
      (Nat.card_pos_iff.mp (by rw [hcard_local q.1 q.2]; exact hp.pos)).2
    infer_instance
  -- ## The kernel of the component map is `⟨a⟩·U(S)^p`
  have hmem_aU_ker : aU ∈ KΦ := by
    intro q
    obtain ⟨c, hc⟩ := haq q.1 q.2
    let w : ↥((q.1.adicCompletionIntegers K).unitGroup) :=
      (ValuationSubring.unitGroupMulEquiv (q.1.adicCompletionIntegers K)).symm c
    have hcomp : localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) aU = w ^ p := by
      apply Subtype.ext
      rw [Subgroup.coe_pow]
      refine Units.ext ?_
      rw [Units.val_pow_eq_pow_val, ValuationSubring.coe_unitGroupMulEquiv_symm_apply,
        coe_localUnitComponent, Units.coe_map]
      rw [show ((aU : U) : Kˣ) = aK from rfl, Units.val_mk0 ha]
      exact hc
    rw [compAt, hcomp]
    exact (QuotientGroup.eq_one_iff (x := w ^ p)).mpr
      (MonoidHom.mem_range.mpr ⟨w, by rw [powMonoidHom_apply]⟩)
  have hHU_le_KΦ : HU ≤ KΦ := by
    rw [show HU = Subgroup.closure {aU} from rfl]
    refine (Subgroup.closure_le KΦ).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    exact hmem_aU_ker
  have hPU_le_KΦ : PU ≤ KΦ := by
    intro v hv
    obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hv
    rw [powMonoidHom_apply] at hy
    intro q
    rw [← hy, compAt, map_pow]
    exact (QuotientGroup.eq_one_iff (x := (localUnitComponent (K := K) q.1 S
        (hTdisj q.1 q.2) y) ^ p)).mpr
      (MonoidHom.mem_range.mpr
        ⟨localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) y, by rw [powMonoidHom_apply]⟩)
  have hker_le_KΦ : KΦ ≤ AU := by
    intro u hu
    rw [show AU = AK.subgroupOf U from rfl, Subgroup.mem_subgroupOf]
    have hloc : ∀ q ∈ T, ∃ c : (q.adicCompletionIntegers K)ˣ,
        algebraMap K (q.adicCompletion K) ((u : Kˣ) : K) =
          ((c : q.adicCompletionIntegers K) : q.adicCompletion K) ^ p := by
      intro q hq
      have h1 : compAt (K := K) p S q (hTdisj q hq) u = 1 := hu ⟨q, hq⟩
      obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp
        ((QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q S (hTdisj q hq) u)).mp h1)
      rw [powMonoidHom_apply] at hy
      refine ⟨ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) y, ?_⟩
      have hB : (((localUnitComponent (K := K) q S (hTdisj q hq) u :
          ↥((q.adicCompletionIntegers K).unitGroup)) : (q.adicCompletion K)ˣ) :
            q.adicCompletion K)
          = algebraMap K (q.adicCompletion K) ((u : Kˣ) : K) := rfl
      have hC : (((localUnitComponent (K := K) q S (hTdisj q hq) u :
          ↥((q.adicCompletionIntegers K).unitGroup)) : (q.adicCompletion K)ˣ) :
            q.adicCompletion K)
          = ((y : (q.adicCompletion K)ˣ) : q.adicCompletion K) ^ p := by
        rw [← hy, Subgroup.coe_pow, Units.val_pow_eq_pow_val]
      have hA : (((ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) y :
          q.adicCompletionIntegers K) : q.adicCompletion K))
          = ((y : (q.adicCompletion K)ˣ) : q.adicCompletion K) :=
        ValuationSubring.coe_unitGroupMulEquiv_apply (q.adicCompletionIntegers K) y
      calc algebraMap K (q.adicCompletion K) ((u : Kˣ) : K)
          = (((localUnitComponent (K := K) q S (hTdisj q hq) u :
              ↥((q.adicCompletionIntegers K).unitGroup)) : (q.adicCompletion K)ˣ) :
                q.adicCompletion K) := hB.symm
        _ = ((y : (q.adicCompletion K)ˣ) : q.adicCompletion K) ^ p := hC
        _ = (((ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) y :
              q.adicCompletionIntegers K) : q.adicCompletion K)) ^ p := by rw [hA]
    have hmk : Units.mk0 ((u : Kˣ) : K) (Units.ne_zero (u : Kˣ)) ∈ AK :=
      hker ((u : Kˣ) : K) (Units.ne_zero (u : Kˣ)) (by
        rw [show Units.mk0 ((u : Kˣ) : K) (Units.ne_zero (u : Kˣ)) = (u : Kˣ) from
          Units.ext (Units.val_mk0 _)]
        exact u.2) hloc
    rwa [show Units.mk0 ((u : Kˣ) : K) (Units.ne_zero (u : Kˣ)) = (u : Kˣ) from
      Units.ext (Units.val_mk0 _)] at hmk
  -- ## `AU = HU ⊔ PU`
  have hPU_le_AU : PU ≤ AU := by
    rw [show PU = ((Subgroup.map (powMonoidHom p) U).subgroupOf U) from
      (NK.GlobalCFTdeep.SecondInequality.subgroupOf_map_powMonoidHom p U).symm]
    exact Subgroup.subgroupOf_mono U (show Subgroup.map (powMonoidHom p) U ≤ AK from le_sup_right)
  have hHU_le_AU : HU ≤ AU := by
    rw [show HU = Subgroup.closure {aU} from rfl]
    refine (Subgroup.closure_le AU).mpr ?_
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx]
    refine Subgroup.mem_subgroupOf.mpr ?_
    exact (le_sup_left : Subgroup.closure {aK} ≤ AK) (Subgroup.subset_closure rfl)
  have hAU_le_sup : AU ≤ HU ⊔ PU := by
    intro z hz
    have hz' : (z : Kˣ) ∈ AK := Subgroup.mem_subgroupOf.mp (by
      rwa [show AU = AK.subgroupOf U from rfl] at hz)
    obtain ⟨y, hy, w, hw, hyw⟩ := Subgroup.mem_sup.mp hz'
    obtain ⟨n, hn⟩ := Subgroup.mem_closure_singleton.mp hy
    obtain ⟨t, ht, htw⟩ := Subgroup.mem_map.mp hw
    rw [powMonoidHom_apply] at htw
    have hyU : y ∈ U := by rw [← hn]; exact Subgroup.zpow_mem U haS n
    have hwU : w ∈ U := by rw [← htw]; exact Subgroup.pow_mem U ht p
    have hzy : z = (⟨y, hyU⟩ : U) * ⟨w, hwU⟩ := by
      refine Subtype.ext ?_
      rw [Subgroup.coe_mul]
      exact hyw.symm
    have hyHU : (⟨y, hyU⟩ : U) ∈ HU := by
      rw [show HU = Subgroup.closure {aU} from rfl, Subgroup.mem_closure_singleton]
      refine ⟨n, ?_⟩
      refine Subtype.ext ?_
      rw [Subgroup.coe_zpow, show ((aU : U) : Kˣ) = aK from rfl]
      exact hn
    have hwPU : (⟨w, hwU⟩ : U) ∈ PU := by
      refine MonoidHom.mem_range.mpr ⟨⟨t, ht⟩, ?_⟩
      rw [powMonoidHom_apply]
      exact Subtype.ext (by rw [Subgroup.coe_pow]; exact htw)
    rw [hzy]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hyHU) (Subgroup.mem_sup_right hwPU)
  have hAU_eq : AU = HU ⊔ PU := le_antisymm hAU_le_sup (sup_le hHU_le_AU hPU_le_AU)
  have hKΦ_eq : KΦ = AU := le_antisymm hker_le_KΦ
    (by rw [hAU_eq]; exact sup_le hHU_le_KΦ hPU_le_KΦ)
  -- ## The induced map `U ⧸ KΦ → ∏_q U_q/U_q^p` is injective
  have hconst : ∀ a b : U, QuotientGroup.leftRel KΦ a b → funφ a = funφ b := by
    intro a b hab
    have hab' : a⁻¹ * b ∈ KΦ := (QuotientGroup.leftRel_apply).mp hab
    funext q
    have hq0 : localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) (a⁻¹ * b) ∈
        (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range :=
      (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
        (hTdisj q.1 q.2) (a⁻¹ * b))).mp (hab' q)
    rw [map_mul, map_inv] at hq0
    exact (QuotientGroup.eq).mpr hq0
  let f : U ⧸ KΦ → (∀ q : ↥T, localUnitQuot (K := K) p q.1) := Quotient.lift funφ hconst
  have hf_inj : Function.Injective f := by
    intro x y hxy
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective y
    have hab : funφ a = funφ b := hxy
    refine (QuotientGroup.eq).mpr ?_
    intro q
    have hq0 : compAt (K := K) p S q.1 (hTdisj q.1 q.2) a =
        compAt (K := K) p S q.1 (hTdisj q.1 q.2) b := congrFun hab q
    have hq1 : (localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) a)⁻¹ *
        localUnitComponent (K := K) q.1 S (hTdisj q.1 q.2) b ∈
        (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range :=
      (QuotientGroup.eq).mp hq0
    refine (QuotientGroup.eq_one_iff (x := localUnitComponent (K := K) q.1 S
      (hTdisj q.1 q.2) (a⁻¹ * b))).mpr ?_
    rw [map_mul, map_inv]
    exact hq1
  -- ## The index of `KΦ`
  have hf_bound : Nat.card (U ⧸ KΦ) ≤ p ^ T.card := by
    rw [← hcard_target]
    exact Nat.card_le_card_of_injective f hf_inj
  have hUidx : AU.index ≤ p ^ T.card := by
    have h1 : AU.index = Nat.card (U ⧸ KΦ) := by
      rw [← hKΦ_eq]
      rfl
    rw [h1]
    exact hf_bound
  have hPUidx : PU.index = p ^ S.card := by
    have h := NK.GlobalCFTdeep.SecondInequality.tUnits_index_powSubgroup (K := K) p hp hζ S hSinf'
    rw [Nat.card_eq_fintype_card, Fintype.card_coe] at h
    rw [show PU = ((Subgroup.map (powMonoidHom p) U).subgroupOf U) from
      (NK.GlobalCFTdeep.SecondInequality.subgroupOf_map_powMonoidHom p U).symm]
    exact h
  have hmul : (PU.subgroupOf AU).index * AU.index = PU.index :=
    Subgroup.relIndex_mul_index hPU_le_AU
  have hAU_PU : (PU.subgroupOf AU).index ≤ p := by
    have haUAU : aU ∈ AU := hHU_le_AU (Subgroup.subset_closure rfl)
    let π : AU →* AU ⧸ PU.subgroupOf AU := QuotientGroup.mk' (PU.subgroupOf AU)
    have hgp : (π ⟨aU, haUAU⟩) ^ p = 1 := by
      rw [← map_pow]
      refine (QuotientGroup.eq_one_iff _).mpr ?_
      exact Subgroup.mem_subgroupOf.mpr (MonoidHom.mem_range.mpr ⟨aU, by
        rw [powMonoidHom_apply, Subgroup.coe_pow]⟩)
    have htop : Subgroup.zpowers (π ⟨aU, haUAU⟩) = ⊤ := by
      refine (Subgroup.eq_top_iff' _).mpr (fun y => ?_)
      obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective (PU.subgroupOf AU) y
      have hz : (z : U) ∈ HU ⊔ PU := hAU_eq ▸ z.2
      obtain ⟨y', hy', w, hw, hyw⟩ := Subgroup.mem_sup.mp hz
      obtain ⟨n, hn⟩ := Subgroup.mem_closure_singleton.mp hy'
      obtain ⟨t, htw⟩ := MonoidHom.mem_range.mp hw
      rw [powMonoidHom_apply] at htw
      have hwAU : w ∈ AU := hPU_le_AU hw
      have hywK : ((y' : U) : Kˣ) * ((w : U) : Kˣ) = ((z : U) : Kˣ) := by
        simpa using congrArg (fun t : U => (t : Kˣ)) hyw
      have hzU : (z : U) = aU ^ n * w := by
        refine Subtype.ext ?_
        show ((z : U) : Kˣ) = ↑(aU ^ n * w)
        rw [Subgroup.coe_mul, congrArg (fun t : U => (t : Kˣ)) hn]
        exact hywK.symm
      refine Subgroup.mem_zpowers_iff.mpr ⟨n, ?_⟩
      have h1 : π z = π ((⟨aU, haUAU⟩ : AU) ^ n) := by
        refine (QuotientGroup.eq).mpr ?_
        refine Subgroup.mem_subgroupOf.mpr ?_
        show ((z : U))⁻¹ * aU ^ n ∈ PU
        rw [hzU, mul_inv_rev, mul_assoc, inv_mul_cancel, mul_one]
        exact Subgroup.inv_mem _ hw
      rw [h1, map_zpow]
    have := natCard_le_of_zpowers_eq_top_of_pow_eq_one hp htop hgp
    rwa [Subgroup.index]
  have hmul' : AU.index * (PU.subgroupOf AU).index = p ^ (T.card + 1) := by
    rw [mul_comm, hmul, hPUidx, hcardT]
  have hAUpair := eq_pow_and_eq_prime_of_mul_eq (p := p) (t := T.card) hp hUidx hAU_PU hmul'
  have hAUidx : AU.index = p ^ T.card := hAUpair.1
  -- ## The map is surjective
  have hcard_quot : Nat.card (U ⧸ KΦ) = p ^ T.card := by
    rw [← hAUidx]
    have h1 : AU.index = Nat.card (U ⧸ KΦ) := by
      rw [← hKΦ_eq]
      rfl
    exact h1.symm
  haveI hfin_quot : Finite (U ⧸ KΦ) :=
    (Nat.card_pos_iff.mp (by rw [hcard_quot]; exact pow_pos hp.pos _)).2
  haveI : Fintype (U ⧸ KΦ) := Fintype.ofFinite _
  haveI : Fintype (∀ q : ↥T, localUnitQuot (K := K) p q.1) := Fintype.ofFinite _
  have hsurj_f : Function.Surjective f :=
    ((Fintype.bijective_iff_injective_and_card f).mpr ⟨hf_inj, by
      rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card, hcard_quot,
        hcard_target]⟩).2
  -- ## The conclusion
  intro x hx
  have hxq : ∀ q ∈ T, x (Place.ofFinite q) ∈ (q.adicCompletionIntegers K).unitGroup := by
    intro q hq
    exact (localUnits_eq_unitGroup (K := K) q).le
      ((mem_TIdeles.mp hx) (Place.ofFinite q) (hTdisj q hq))
  let yv : (∀ q : ↥T, localUnitQuot (K := K) p q.1) := fun q =>
    QuotientGroup.mk' (powMonoidHom (α := ↥((q.1.adicCompletionIntegers K).unitGroup)) p).range
      ⟨x (Place.ofFinite q.1), hxq q.1 q.2⟩
  obtain ⟨z, hz⟩ := hsurj_f yv
  obtain ⟨u, rfl⟩ := QuotientGroup.mk_surjective z
  have hu : funφ u = yv := hz
  refine ⟨u, fun q hq => ?_⟩
  have hq_eq : compAt (K := K) p S q (hTdisj q hq) u = yv ⟨q, hq⟩ := congrFun hu ⟨q, hq⟩
  have hmk : QuotientGroup.mk' (powMonoidHom (α :=
        ↥((q.adicCompletionIntegers K).unitGroup)) p).range
        (localUnitComponent (K := K) q S (hTdisj q hq) u) =
      QuotientGroup.mk' (powMonoidHom (α :=
        ↥((q.adicCompletionIntegers K).unitGroup)) p).range
        ⟨x (Place.ofFinite q), hxq q hq⟩ := hq_eq
  have hmem : (⟨x (Place.ofFinite q), hxq q hq⟩ :
        ↥((q.adicCompletionIntegers K).unitGroup)) *
      (localUnitComponent (K := K) q S (hTdisj q hq) u)⁻¹ ∈
      (powMonoidHom (α := ↥((q.adicCompletionIntegers K).unitGroup)) p).range := by
    have h1 : (localUnitComponent (K := K) q S (hTdisj q hq) u)⁻¹ *
        (⟨x (Place.ofFinite q), hxq q hq⟩ : ↥((q.adicCompletionIntegers K).unitGroup)) ∈
        (powMonoidHom (α := ↥((q.adicCompletionIntegers K).unitGroup)) p).range :=
      (QuotientGroup.eq).mp hmk
    rw [mul_comm]
    exact h1
  obtain ⟨w, hw⟩ := MonoidHom.mem_range.mp hmem
  rw [powMonoidHom_apply] at hw
  refine ⟨ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) w, ?_⟩
  show (((x (Place.ofFinite q) * (Idele.principalIdele K (u : Kˣ) (Place.ofFinite q))⁻¹ :
    (q.adicCompletion K)ˣ)) : q.adicCompletion K) =
    (((ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) w :
      q.adicCompletionIntegers K) : q.adicCompletion K)) ^ p
  calc (((x (Place.ofFinite q) * (Idele.principalIdele K (u : Kˣ) (Place.ofFinite q))⁻¹ :
          (q.adicCompletion K)ˣ)) : q.adicCompletion K)
      = ((((⟨x (Place.ofFinite q), hxq q hq⟩ :
              ↥((q.adicCompletionIntegers K).unitGroup)) *
            (localUnitComponent (K := K) q S (hTdisj q hq) u)⁻¹ :
              ↥((q.adicCompletionIntegers K).unitGroup)) : (q.adicCompletion K)ˣ) :
                q.adicCompletion K) := by
        simp only [Subgroup.coe_mul, Subgroup.coe_inv, coe_localUnitComponent,
          Idele.principalIdele_apply]
    _ = (((w ^ p : ↥((q.adicCompletionIntegers K).unitGroup)) :
          (q.adicCompletion K)ˣ) : q.adicCompletion K) := by rw [hw]
    _ = (((w : (q.adicCompletion K)ˣ) ^ p : (q.adicCompletion K)ˣ) :
          q.adicCompletion K) := by rw [Subgroup.coe_pow]
    _ = ((w : (q.adicCompletion K)ˣ) : q.adicCompletion K) ^ p :=
          Units.val_pow_eq_pow_val _ _
    _ = (((ValuationSubring.unitGroupMulEquiv (q.adicCompletionIntegers K) w :
          q.adicCompletionIntegers K) : q.adicCompletion K)) ^ p := by
          rw [ValuationSubring.coe_unitGroupMulEquiv_apply]

end NK.GlobalCFTdeep.SecondInequality.KummerCase

