import Mathlib
import Submission.NK.GlobalCFTdeep.SecondInequality.KummerCase.Defs
import Submission.NK.GlobalCFTdeep.SecondInequality.finrank_kummerAdjoin

namespace NK.GlobalCFTdeep.SecondInequality.KummerCase

open scoped NumberField.LiesOver
open NumberField

set_option linter.style.haveILetI false

/-- **A place of a Kummer field above an infinite place cannot be ramified when the Kummer
generator is a local `p`-th power.**

Suppose `v` is an infinite place of the number field `K` at which `b ∈ Kˣ` is a `p`-th power,
`L = kummerField p b ⊆ Ω` and `w` is an infinite place of `L` above `v`.  Then `w` is not
ramified over `v`.

If it were, `v` would be real and `w` complex, so `K_v = ℝ ⊆ ℂ = L_w`.  Since `b = c ^ p` for
some `c ∈ ℝˣ`, every `p`-th root `ρ ∈ Ω` of `b` has image `ψ ρ` in `ℂ` (`ψ = w.embedding`) — with
`z = extensionEmbedding v c`, the quotient `ψ ρ / z` is a `p`-th root of unity in `ℂ`, and the
`p`-th roots of unity in `ℂ` form a cyclic group generated by `v.embedding ζ`, which is real
because `v` is real.  Hence `ψ ρ = z · (v.embedding ζ) ^ i` is real.  Since `L` is generated over
`K` by the `p`-th roots of `b`, the whole embedding `w.embedding : L →+* ℂ` is real, contradicting
`w.IsComplex`. -/
private theorem not_isRamified_of_mem_localPow
    {K Ω : Type} [Field K] [NumberField K] [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]
    {p : ℕ} (hp : p.Prime) {ζ : K} (hζ : IsPrimitiveRoot ζ p) (b : Kˣ)
    (w : NumberField.InfinitePlace ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
    (v : NumberField.InfinitePlace K) [w.LiesOver v]
    (hb : NK.GlobalCFT.Idele.principalIdele K b (NK.GlobalCFT.Place.ofInfinite v) ∈
      NK.GlobalCFTdeep.SecondInequality.KummerCase.localPow (K := K) p
        (NK.GlobalCFT.Place.ofInfinite v))
    (hram : w.IsRamified K) : False := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  have hLdef : NK.LocalAnabelian.kummerField (K' := Ω) p b
      = IntermediateField.adjoin K {ρ : Ω | ρ ^ p = algebraMap K Ω (b : K)} := rfl
  -- the local `p`-th root of `b`
  obtain ⟨c, hc⟩ := MonoidHom.mem_range.mp hb
  have hc' : (c : v.Completion) ^ p = algebraMap K v.Completion (b : K) := by
    simpa using congrArg (fun u : (v.Completion)ˣ => (u : v.Completion)) hc
  -- `v` is real, so the embedding `v.embedding` and its composite with `w` are real
  have hvreal : v.IsReal := by
    rw [← NumberField.InfinitePlace.LiesOver.comap_eq w v]
    exact hram.isReal
  have hvconj : ComplexEmbedding.conjugate v.embedding = v.embedding :=
    ComplexEmbedding.isReal_iff.mp (InfinitePlace.isReal_iff.mp hvreal)
  have hlo : ComplexEmbedding.LiesOver w.embedding v.embedding :=
    NumberField.InfinitePlace.LiesOver.embedding_liesOver_of_isReal w hvreal
  letI := hlo
  have hbnz : v.embedding (b : K) ≠ 0 := fun h =>
    Units.ne_zero b (RingHom.injective v.embedding (h.trans (map_zero v.embedding).symm))
  -- the embedding `w` is real on the image of `K`
  have hψK : ∀ r : K,
      star (w.embedding (algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b) r))
        = w.embedding (algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b) r) := by
    intro r
    rw [ComplexEmbedding.LiesOver.over_apply w.embedding v.embedding]
    exact RingHom.congr_fun hvconj r
  -- the comparison element `z = extensionEmbedding v c ∈ ℂ`, which is real
  have hzpow : (InfinitePlace.Completion.extensionEmbedding v (c : v.Completion)) ^ p
      = v.embedding (b : K) := by
    rw [← map_pow, hc']
    simp [InfinitePlace.Completion.algebraMap_apply, InfinitePlace.Completion.extensionEmbedding_coe]
  have hzreal : star (InfinitePlace.Completion.extensionEmbedding v (c : v.Completion))
      = InfinitePlace.Completion.extensionEmbedding v (c : v.Completion) := by
    rw [← InfinitePlace.Completion.extensionEmbeddingOfIsReal_apply (v := v) hvreal (c : v.Completion)]
    exact Complex.conj_ofReal _
  -- the image of every `p`-th root of `b` is real
  have hψroot : ∀ (ρ : Ω) (hρ : ρ ^ p = algebraMap K Ω (b : K))
      (hx : ρ ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b),
      star (w.embedding ⟨ρ, hx⟩) = w.embedding ⟨ρ, hx⟩ := by
    intro ρ hρ hx
    have hpρ : (⟨ρ, hx⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b)) ^ p
        = algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b) (b : K) := by
      apply Subtype.ext
      push_cast
      exact hρ
    have hy : (w.embedding ⟨ρ, hx⟩) ^ p = v.embedding (b : K) := by
      rw [← map_pow, hpρ]
      rw [ComplexEmbedding.LiesOver.over_apply w.embedding v.embedding]
    have hz0 : InfinitePlace.Completion.extensionEmbedding v (c : v.Completion) ≠ 0 := by
      intro h0
      rw [h0, zero_pow hp.ne_zero] at hzpow
      exact hbnz hzpow.symm
    have hu : (w.embedding ⟨ρ, hx⟩
        / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion)) ^ p = 1 := by
      rw [div_pow, hy, hzpow, div_self hbnz]
    have hω : IsPrimitiveRoot
        (w.embedding (algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b) ζ)) p :=
      hζ.map_of_injective
        (f := w.embedding.comp (algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b)))
        (RingHom.injective _)
    obtain ⟨i, _hi, hui⟩ := hω.eq_pow_of_pow_eq_one hu
    have hωreal := hψK ζ
    have hureal : star (w.embedding ⟨ρ, hx⟩
          / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion))
        = w.embedding ⟨ρ, hx⟩ / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion) := by
      rw [← hui, star_pow, hωreal]
    calc star (w.embedding ⟨ρ, hx⟩)
        = star ((w.embedding ⟨ρ, hx⟩
              / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion))
            * InfinitePlace.Completion.extensionEmbedding v (c : v.Completion)) := by
          rw [div_mul_cancel₀ _ hz0]
      _ = star (w.embedding ⟨ρ, hx⟩
              / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion))
            * star (InfinitePlace.Completion.extensionEmbedding v (c : v.Completion)) := by
          rw [star_mul, mul_comm]
      _ = (w.embedding ⟨ρ, hx⟩
              / InfinitePlace.Completion.extensionEmbedding v (c : v.Completion))
            * InfinitePlace.Completion.extensionEmbedding v (c : v.Completion) := by
          rw [hureal, hzreal]
      _ = w.embedding ⟨ρ, hx⟩ := div_mul_cancel₀ _ hz0
  -- `L` is generated over `K` by the `p`-th roots of `b`, so `w.embedding` is real
  have hreal_all : ∀ x : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b),
      star (w.embedding x) = w.embedding x := by
    intro x
    have h := IntermediateField.adjoin_induction K
      (s := {ρ : Ω | ρ ^ p = algebraMap K Ω (b : K)})
      (p := fun ρ _ => ∀ hρL : ρ ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b,
        star (w.embedding ⟨ρ, hρL⟩) = w.embedding ⟨ρ, hρL⟩)
      (fun ρ hρ hρL => hψroot ρ hρ hρL)
      (fun r hxL => by
        have h1 : (⟨algebraMap K Ω r, hxL⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
            = algebraMap K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b) r := Subtype.ext rfl
        rw [h1]
        exact hψK r)
      (fun y z hy hz ihy ihz hxL => by
        have hyL : y ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b := by rw [hLdef]; exact hy
        have hzL : z ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b := by rw [hLdef]; exact hz
        have h1 : (⟨y + z, hxL⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
            = ⟨y, hyL⟩ + ⟨z, hzL⟩ := Subtype.ext rfl
        rw [h1, map_add, star_add, ihy hyL, ihz hzL])
      (fun y hy ihy hxL => by
        have hyL : y ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b := by rw [hLdef]; exact hy
        have h1 : (⟨y⁻¹, hxL⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
            = (⟨y, hyL⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))⁻¹ := Subtype.ext rfl
        have h2 : star (w.embedding ⟨y, hyL⟩) = w.embedding ⟨y, hyL⟩ := ihy hyL
        calc star (w.embedding ⟨y⁻¹, hxL⟩)
            = star ((w.embedding ⟨y, hyL⟩)⁻¹) := by rw [h1, map_inv₀ w.embedding]
          _ = (star (w.embedding ⟨y, hyL⟩))⁻¹ := map_inv₀ (starRingEnd ℂ) _
          _ = (w.embedding ⟨y, hyL⟩)⁻¹ := by rw [h2]
          _ = w.embedding ⟨y⁻¹, hxL⟩ := by rw [h1, map_inv₀ w.embedding])
      (fun y z hy hz ihy ihz hxL => by
        have hyL : y ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b := by rw [hLdef]; exact hy
        have hzL : z ∈ NK.LocalAnabelian.kummerField (K' := Ω) p b := by rw [hLdef]; exact hz
        have h1 : (⟨y * z, hxL⟩ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
            = ⟨y, hyL⟩ * ⟨z, hzL⟩ := Subtype.ext rfl
        rw [h1, map_mul, star_mul, ihy hyL, ihz hzL, mul_comm])
      x.2
    exact h x.2
  have hIsReal : ComplexEmbedding.IsReal w.embedding := by
    rw [ComplexEmbedding.isReal_iff]
    ext x
    rw [ComplexEmbedding.conjugate_coe_eq]
    exact hreal_all x
  exact (InfinitePlace.not_isComplex_iff_isReal.mpr (InfinitePlace.isReal_iff.mpr hIsReal)) hram.isComplex

/-- **At an infinite place where the Kummer generator is a local `p`-th power, the local norm is
surjective.**

`K` is a number field with a primitive `p`-th root of unity `ζ` (`p` prime), `Ω` a separable
closure of `K`, `b ∈ Kˣ`, `L = kummerField p b ⊆ Ω`, `v` an infinite place of `K`, `w` an infinite
place of `L` above `v`.  If `b` is a `p`-th power in the completion `K_v` (the hypothesis `hb`,
which unfolds to `b ∈ (K_vˣ)^p`), then the local norm `Place.localNormInfinite w v` is surjective.

Why this is true: the hypothesis says that the local extension `L_w/K_v` is trivial.  If `K_v = ℂ`
then every finite extension of `ℂ` is trivial, so `L_w = K_v` and the norm is the identity.  If
`K_v = ℝ`, then `b ∈ (ℝˣ)^p` means `b > 0` when `p = 2` (and is automatic when `p` is odd, in
which case moreover `K` has no real place at all because a real field contains no primitive `p`-th
root of unity for `p > 2`), so a `p`-th root of `b` is real, `L_w = ℝ = K_v`, and again the norm is
the identity.  In either case `Module.finrank K_v L_w = 1`, and the surjectivity follows from
`Algebra.norm_algebraMap` (a scalar `x` is the norm of its image, since the finrank is `1`). -/
theorem localNormInfinite_surjective_of_mem_localPow
    {K Ω : Type} [Field K] [NumberField K] [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]
    {p : ℕ} (hp : p.Prime) {ζ : K} (hζ : IsPrimitiveRoot ζ p) (b : Kˣ)
    [FiniteDimensional K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b)]
    [NumberField ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b)]
    (w : NumberField.InfinitePlace ↥(NK.LocalAnabelian.kummerField (K' := Ω) p b))
    (v : NumberField.InfinitePlace K) [w.LiesOver v]
    (hb : NK.GlobalCFT.Idele.principalIdele K b (NK.GlobalCFT.Place.ofInfinite v) ∈
      NK.GlobalCFTdeep.SecondInequality.KummerCase.localPow (K := K) p
        (NK.GlobalCFT.Place.ofInfinite v)) :
    Function.Surjective (NK.GlobalCFT.Place.localNormInfinite w v) := by
  -- The local extension is trivial: `w` is unramified over `v`, hence `[L_w : K_v] = 1`.
  have hfr : Module.finrank v.Completion w.Completion = 1 := by
    rcases InfinitePlace.isUnramified_or_isRamified K w with h | h
    · exact h.finrank_eq_one v
    · exact (not_isRamified_of_mem_localPow hp hζ b w v hb h).elim
  intro x
  -- Since the local degree is `1`, `algebraMap K_v L_w` is bijective and the norm is a bijection.
  have hbij := Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfr
  have hx0 : algebraMap v.Completion w.Completion (x : v.Completion) ≠ 0 := fun h => x.ne_zero
    (hbij.1 (by rw [h, map_zero]))
  refine ⟨Units.mk0 (algebraMap v.Completion w.Completion (x : v.Completion)) hx0, ?_⟩
  rw [show NK.GlobalCFT.Place.localNormInfinite w v = Units.map (Algebra.norm v.Completion) from rfl]
  ext
  simp only [Units.coe_map, Units.val_mk0]
  rw [Algebra.norm_algebraMap, hfr, pow_one]

end NK.GlobalCFTdeep.SecondInequality.KummerCase
