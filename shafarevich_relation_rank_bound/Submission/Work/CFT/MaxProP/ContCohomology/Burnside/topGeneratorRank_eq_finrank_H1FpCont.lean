import Mathlib
import Submission.Work.CFT.MaxProP.ContCohomology.Frattini
import Submission.Work.CFT.MaxProP.ContCohomology.Defs
import Submission.Work.CFT.MaxProP.ContCohomology.Burnside.pgroup_closure_powers_sup_commutators_le_frattini
import Submission.Work.CFT.MaxProP.ContCohomology.Burnside.exists_openNormalSubgroup_sup_ne_top

/-!
# Burnside's basis theorem for pro-`p` groups

For a pro-`p` group `G` the **minimal number of topological generators** equals the dimension of
the first continuous cohomology with trivial `𝔽_p` coefficients:

`d(G) = dim_{𝔽_p} H¹_cont(G, 𝔽_p)`.

The proof runs through the Frattini quotient `Q = G / Φ(G)`, where `Φ(G) = proPFrattini p G` is the
closed subgroup generated by the `p`-th powers and the commutators.

* `H¹_cont(G, 𝔽_p)` is the continuous dual of the elementary abelian `p`-group `Q`; over a finite
  field the dual has the same dimension, so `dim H¹_cont(G, 𝔽_p) = dim_{𝔽_p} Q`.
* Burnside's basis theorem identifies `d(G)` with `dim_{𝔽_p} Q`: a finitely generated pro-`p` group
  `Q = G/Φ(G)` is finite, and a set of elements generates `G` topologically iff its image generates
  `Q`.

## Main results

* `Work.CFT.MaxProP.ContCohomology.Burnside.topGeneratorRank_eq_finrank_H1FpCont`
-/

open Work.CFT.MaxProP
open scoped Classical nonZeroDivisors

noncomputable section

set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 800000
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace Work.CFT.MaxProP.ContCohomology.Burnside

/-- In a `ZMod n`-module, the additive-subgroup closure of a set equals the span. -/
theorem addSubgroup_closure_eq_span {n : ℕ} {M : Type} [AddCommGroup M] [Module (ZMod n) M]
    (S : Set M) :
    AddSubgroup.closure S = (Submodule.span (ZMod n) S).toAddSubgroup := by
  refine le_antisymm ?_ ?_
  · rw [AddSubgroup.closure_le]
    intro x hx
    exact Submodule.subset_span hx
  · rw [← (AddSubgroup.toZModSubmodule n).le_iff_le]
    rw [Submodule.toAddSubgroup_toZModSubmodule]
    exact Submodule.span_le.mpr AddSubgroup.subset_closure

/-- A subgroup of a commutative group of exponent `p` generated by finitely many elements is
finite. -/
theorem finite_closure_of_exp {p : ℕ} [NeZero p] {Q : Type} [Group Q]
    (hcomm : ∀ x y : Q, x * y = y * x) (hexp : ∀ x : Q, x ^ p = 1)
    {ι : Type} [Finite ι] (q : ι → Q) :
    Finite (Subgroup.closure (Set.range q)) := by
  letI : AddCommGroup (Additive Q) :=
    { Additive.addGroup (α := Q) with
      add_comm := fun a b => hcomm (Additive.toMul a) (Additive.toMul b) }
  haveI : Module (ZMod p) (Additive Q) :=
    AddCommGroup.zmodModule (fun x => by
      obtain ⟨y, rfl⟩ := Additive.ofMul.surjective x
      rw [← ofMul_pow, hexp y, ofMul_one])
  set S : Set (Additive Q) := Set.range (fun i => Additive.ofMul (q i)) with hS
  haveI : Module.Finite (ZMod p) (Submodule.span (ZMod p) S) :=
    Module.Finite.of_fg (Submodule.fg_span (Set.finite_range _))
  haveI : Finite (Submodule.span (ZMod p) S) := Module.finite_of_finite (ZMod p)
  have hmem : ∀ x ∈ Subgroup.closure (Set.range q),
      Additive.ofMul x ∈ Submodule.span (ZMod p) S := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem y hy => obtain ⟨i, rfl⟩ := hy; exact Submodule.subset_span ⟨i, rfl⟩
    | one => exact Submodule.zero_mem _
    | mul a b _ _ ha hb => exact Submodule.add_mem _ ha hb
    | inv a _ ha => exact Submodule.neg_mem _ ha
  let F : Subgroup.closure (Set.range q) → Submodule.span (ZMod p) S :=
    fun x => ⟨Additive.ofMul x.1, hmem x.1 x.2⟩
  refine Finite.of_injective F ?_
  intro a b h
  have h2 : Additive.ofMul (a : Q) = Additive.ofMul (b : Q) :=
    congrArg (fun z : Submodule.span (ZMod p) S => (z : Additive Q)) h
  exact Subtype.ext (Additive.ofMul.injective h2)

/-- If `f` has dense range in `G` then the images of its generators generate the closed normal
quotient `G ⧸ N`, provided that quotient is commutative of exponent `p`. -/
theorem subgroup_closure_quotient_eq_top {G : Type} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] {N : Subgroup G} [N.Normal] (hNcl : IsClosed (N : Set G))
    {p : ℕ} [NeZero p] (hcomm : ∀ x y : G ⧸ N, x * y = y * x)
    (hexp : ∀ x : G ⧸ N, x ^ p = 1)
    {d : ℕ} {f : FreeGroup (Fin d) →* G} (hf : closure (Set.range f) = Set.univ) :
    Subgroup.closure (Set.range (fun i : Fin d => (QuotientGroup.mk' N) (f (FreeGroup.of i)))) = ⊤ := by
  set q : Fin d → G ⧸ N := fun i => (QuotientGroup.mk' N) (f (FreeGroup.of i)) with hq
  haveI : Finite (Subgroup.closure (Set.range q)) := finite_closure_of_exp hcomm hexp q
  have hclosed : IsClosed ((Subgroup.closure (Set.range q) : Subgroup (G ⧸ N)) : Set (G ⧸ N)) :=
    Set.toFinite _ |>.isClosed
  have hset : (QuotientGroup.mk' N) '' Set.range f =
      ((Subgroup.closure (Set.range q) : Subgroup (G ⧸ N)) : Set (G ⧸ N)) := by
    have hl : (QuotientGroup.mk' N).comp f = FreeGroup.lift q :=
      MonoidHom.ext fun x =>
        FreeGroup.lift_unique (f := q) ((QuotientGroup.mk' N).comp f) (fun i => rfl) (x := x)
    calc (QuotientGroup.mk' N) '' Set.range f
        = Set.range ((QuotientGroup.mk' N) ∘ f) := (Set.range_comp _ _).symm
      _ = Set.range (⇑((QuotientGroup.mk' N).comp f)) := rfl
      _ = ↑((QuotientGroup.mk' N).comp f).range := (MonoidHom.coe_range _).symm
      _ = ↑(FreeGroup.lift q).range := by rw [hl]
      _ = ↑(Subgroup.closure (Set.range q)) := by rw [FreeGroup.range_lift_eq_closure]
  have hdense : Dense ((QuotientGroup.mk' N) '' Set.range f) := by
    have hdf : DenseRange (⇑f) := denseRange_iff_closure_range.mpr hf
    have hd : Dense (Set.range (⇑(QuotientGroup.mk' N) ∘ ⇑f)) :=
      (QuotientGroup.mk'_surjective N).denseRange.comp hdf QuotientGroup.continuous_mk
    rwa [Set.range_comp] at hd
  rw [hset] at hdense
  rw [dense_iff_closure_eq, IsClosed.closure_eq hclosed] at hdense
  refine SetLike.coe_injective ?_
  rw [hdense, Subgroup.coe_top]

/-- The Frattini subgroup of a finite quotient `G ⧸ U` contains the image of `proPFrattini p G`,
for `U` an open normal subgroup with `p`-group quotient. -/
theorem map_proPFrattini_le_frattini {G : Type} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] {p : ℕ} [Fact p.Prime] (U : Subgroup G) [U.Normal]
    (hUopen : IsOpen (U : Set G)) (hU : IsPGroup p (G ⧸ U)) :
    (proPFrattini p G).map (QuotientGroup.mk' U) ≤ frattini (G ⧸ U) := by
  classical
  haveI : Finite (G ⧸ U) := U.quotient_finite_of_isOpen hUopen
  haveI hUcl : IsClosed (U : Set G) := U.isClosed_of_isOpen hUopen
  haveI : T1Space (G ⧸ U) := QuotientGroup.instT1Space
  have hPC : ((Subgroup.closure {x : G | ∃ a, x = a ^ p}) ⊔
      (Subgroup.closure {x : G | ∃ a b, x = a * b * a⁻¹ * b⁻¹})).map (QuotientGroup.mk' U)
      ≤ frattini (G ⧸ U) := by
    rw [Subgroup.map_sup]
    refine sup_le ?_ ?_
    · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
      rintro x ⟨a, rfl⟩
      exact (pgroup_closure_powers_sup_commutators_le_frattini hU)
        (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨(QuotientGroup.mk' U) a,
          by rw [map_pow]⟩))
    · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
      rintro x ⟨a, b, rfl⟩
      exact (pgroup_closure_powers_sup_commutators_le_frattini hU)
        (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨(QuotientGroup.mk' U) a,
          (QuotientGroup.mk' U) b, by rw [map_mul, map_mul, map_mul, map_inv, map_inv]⟩))
  have hclosed : IsClosed ((frattini (G ⧸ U)).comap (QuotientGroup.mk' U) : Set G) :=
    (Set.toFinite ((frattini (G ⧸ U) : Set (G ⧸ U)))).isClosed.preimage QuotientGroup.continuous_mk
  rw [proPFrattini]
  calc (Subgroup.closure {x : G | ∃ a, x = a ^ p} ⊔
        Subgroup.closure {x : G | ∃ a b, x = a * b * a⁻¹ * b⁻¹}).topologicalClosure.map
          (QuotientGroup.mk' U)
      ≤ ((frattini (G ⧸ U)).comap (QuotientGroup.mk' U)).map (QuotientGroup.mk' U) :=
        Subgroup.map_mono (Subgroup.topologicalClosure_minimal _
          (Subgroup.map_le_iff_le_comap.mp hPC) hclosed)
    _ ≤ frattini (G ⧸ U) := by rw [Subgroup.map_comap_eq]; exact inf_le_right

/-- **Burnside's basis theorem for pro-`p` groups.**  For a compact totally disconnected
topological group `G` whose continuous finite quotients are `p`-groups and which is topologically
finitely generated, the minimal number of topological generators equals the `𝔽_p`-dimension of the
first continuous cohomology `H¹_cont(G, 𝔽_p)`. -/
theorem topGeneratorRank_eq_finrank_H1FpCont (p : ℕ) [Fact p.Prime] (G : Type) [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] [T2Space G]
    [TotallyDisconnectedSpace G]
    (hG : ∀ U : Work.CFT.MaxProP.OpenNormal G, IsPGroup p (G ⧸ U.carrier))
    (hfg : ∃ d : ℕ, ∃ f : FreeGroup (Fin d) →* G, closure (Set.range f) = Set.univ) :
    Work.CFT.MaxProP.topGeneratorRank G =
      Module.finrank (ZMod p) (Work.CFT.MaxProP.H1FpCont p G) := by
  haveI hne : NeZero p := ⟨(Fact.out : Nat.Prime p).ne_zero⟩
  set N : Subgroup G := proPFrattini p G with hN
  have hPnorm : (Subgroup.closure {x : G | ∃ a : G, x = a ^ p}).Normal := by
    refine ⟨fun n hn g => ?_⟩
    refine Subgroup.closure_induction (x := n) ?_ ?_ ?_ ?_ hn
    · rintro x ⟨a, rfl⟩
      exact Subgroup.subset_closure ⟨g * a * g⁻¹,
        by rw [← MulAut.conj_apply g a, ← map_pow (MulAut.conj g) a p, MulAut.conj_apply]⟩
    · simpa using Subgroup.one_mem _
    · intro x y _ _ hx hy
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ hx
  have hCnorm : (Subgroup.closure {x : G | ∃ a b : G, x = a * b * a⁻¹ * b⁻¹}).Normal := by
    refine ⟨fun n hn g => ?_⟩
    refine Subgroup.closure_induction (x := n) ?_ ?_ ?_ ?_ hn
    · rintro x ⟨a, b, rfl⟩
      exact Subgroup.subset_closure ⟨g * a * g⁻¹, g * b * g⁻¹, by group⟩
    · simpa using Subgroup.one_mem _
    · intro x y _ _ hx hy
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ hx
  haveI : (Subgroup.closure {x : G | ∃ a : G, x = a ^ p} ⊔
      Subgroup.closure {x : G | ∃ a b : G, x = a * b * a⁻¹ * b⁻¹}).Normal := inferInstance
  haveI hNnorm : N.Normal := by
    rw [hN, proPFrattini]; exact Subgroup.is_normal_topologicalClosure _
  have hNclosed : IsClosed (N : Set G) := by
    rw [hN]; exact Subgroup.isClosed_topologicalClosure _
  have hpow_mem : ∀ a : G, a ^ p ∈ N := by
    intro a
    rw [hN, proPFrattini]
    exact Subgroup.le_topologicalClosure _
      (Subgroup.mem_sup_left (Subgroup.subset_closure ⟨a, rfl⟩))
  have hcomm_mem : ∀ a b : G, a * b * a⁻¹ * b⁻¹ ∈ N := by
    intro a b
    rw [hN, proPFrattini]
    exact Subgroup.le_topologicalClosure _
      (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨a, b, rfl⟩))
  have hQexp : ∀ x : G ⧸ N, x ^ p = 1 := by
    intro x
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective N x
    rw [← map_pow (QuotientGroup.mk' N), QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hpow_mem a
  have hQcomm : ∀ x y : G ⧸ N, x * y = y * x := by
    intro x y
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective N x
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective N y
    rw [← map_mul (QuotientGroup.mk' N), ← map_mul (QuotientGroup.mk' N),
      QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_iff_div_mem]
    convert hcomm_mem a b using 1
    rw [div_eq_mul_inv, mul_inv_rev]; group
  obtain ⟨d, f, hf⟩ := hfg
  have hgen : Subgroup.closure
      (Set.range (fun i : Fin d => (QuotientGroup.mk' N) (f (FreeGroup.of i)))) = ⊤ :=
    subgroup_closure_quotient_eq_top hNclosed hQcomm hQexp hf
  haveI hfincl : Finite (Subgroup.closure
      (Set.range (fun i : Fin d => (QuotientGroup.mk' N) (f (FreeGroup.of i))))) :=
    finite_closure_of_exp hQcomm hQexp _
  haveI hfintop : Finite (↥(⊤ : Subgroup (G ⧸ N))) := hgen ▸ hfincl
  haveI hfinQ : Finite (G ⧸ N) := Finite.of_equiv _ (Subgroup.topEquiv).toEquiv
  letI : AddCommGroup (Additive (G ⧸ N)) :=
    { Additive.addGroup (α := G ⧸ N) with
      add_comm := fun a b => hQcomm (Additive.toMul a) (Additive.toMul b) }
  haveI : Module (ZMod p) (Additive (G ⧸ N)) :=
    AddCommGroup.zmodModule (fun x => by
      obtain ⟨y, rfl⟩ := Additive.ofMul.surjective x
      rw [← ofMul_pow, hQexp y, ofMul_one])
  haveI : Module.Finite (ZMod p) (Additive (G ⧸ N)) :=
    (Module.finite_iff_finite (R := ZMod p) (M := Additive (G ⧸ N))).mpr
      (Finite.of_equiv (G ⧸ N) Additive.ofMul)
  have hBurnside : Work.CFT.MaxProP.topGeneratorRank G =
      Module.finrank (ZMod p) (Additive (G ⧸ N)) := by
    refine le_antisymm ?_ ?_
    · rw [topGeneratorRank]
      set r := Module.finrank (ZMod p) (Additive (G ⧸ N)) with hr
      let B : Module.Basis (Fin r) (ZMod p) (Additive (G ⧸ N)) := Module.finBasis (ZMod p) _
      choose g hg using fun i : Fin r => QuotientGroup.mk'_surjective N (Additive.toMul (B i))
      let f₀ : FreeGroup (Fin r) →* G := FreeGroup.lift g
      have hcl_basis : Subgroup.closure (Set.range (fun i : Fin r => Additive.toMul (B i))) = ⊤ := by
        have hA : Subgroup.toAddSubgroup
            (Subgroup.closure (Set.range (fun i : Fin r => Additive.toMul (B i)))) = ⊤ := by
          rw [Subgroup.toAddSubgroup_closure]
          have hset : Additive.toMul ⁻¹' (Set.range (fun i : Fin r => Additive.toMul (B i)))
              = Set.range B := by
            ext x
            simp only [Set.mem_preimage, Set.mem_range]
            constructor
            · rintro ⟨i, hi⟩; exact ⟨i, Additive.toMul.injective hi⟩
            · rintro ⟨i, rfl⟩; exact ⟨i, rfl⟩
          rw [hset, addSubgroup_closure_eq_span (n := p), B.span_eq]
          refine (AddSubgroup.toZModSubmodule p).injective ?_
          rw [Submodule.toAddSubgroup_toZModSubmodule (n := p), OrderIso.map_top]
        exact Subgroup.toAddSubgroup.injective (by rw [hA]; simp)
      have hK : (MonoidHom.range f₀).topologicalClosure = ⊤ := by
        by_contra hne'
        set K : Subgroup G := (MonoidHom.range f₀).topologicalClosure with hKdef
        have hKclosed : IsClosed (K : Set G) := Subgroup.isClosed_topologicalClosure _
        obtain ⟨x, -, hxK⟩ := SetLike.exists_of_lt (lt_top_iff_ne_top.mpr hne')
        obtain ⟨U, hU⟩ := exists_openNormalSubgroup_sup_ne_top hKclosed hxK
        have hKmap : Subgroup.map (QuotientGroup.mk' N) K = ⊤ := by
          have h1 : Subgroup.map (QuotientGroup.mk' N) (MonoidHom.range f₀) = ⊤ := by
            have hcomp : (QuotientGroup.mk' N).comp f₀ =
                FreeGroup.lift (fun i : Fin r => (QuotientGroup.mk' N) (g i)) :=
              MonoidHom.ext fun x => FreeGroup.lift_unique
                (f := fun i : Fin r => (QuotientGroup.mk' N) (g i))
                ((QuotientGroup.mk' N).comp f₀)
                  (fun i => by
                    change (QuotientGroup.mk' N) (FreeGroup.lift g (FreeGroup.of i))
                      = (QuotientGroup.mk' N) (g i)
                    rw [FreeGroup.lift_apply_of]) (x := x)
            rw [← MonoidHom.range_comp, hcomp, FreeGroup.range_lift_eq_closure]
            rw [show Set.range (fun i : Fin r => (QuotientGroup.mk' N) (g i))
                = Set.range (fun i : Fin r => Additive.toMul (B i)) from by
              congr 1; funext i; exact hg i]
            exact hcl_basis
          have hm := Subgroup.map_mono (f := QuotientGroup.mk' N)
            (Subgroup.le_topologicalClosure (MonoidHom.range f₀))
          rw [h1] at hm
          exact top_le_iff.mp hm
        have hKN : K ⊔ N = ⊤ := by
          rw [← QuotientGroup.ker_mk' N, ← Subgroup.comap_map_eq (QuotientGroup.mk' N) K,
            hKmap, Subgroup.comap_top]
        have hU' : IsPGroup p (G ⧸ U.toSubgroup) :=
          hG ⟨U.toSubgroup, U.isNormal', U.isOpen'⟩
        have hfratt : N.map (QuotientGroup.mk' U.toSubgroup) ≤ frattini (G ⧸ U.toSubgroup) := by
          rw [hN]; exact map_proPFrattini_le_frattini U.toSubgroup U.isOpen' hU'
        have hstep : (K.map (QuotientGroup.mk' U.toSubgroup)) ⊔ frattini (G ⧸ U.toSubgroup) = ⊤ := by
          have h1 : Subgroup.map (QuotientGroup.mk' U.toSubgroup) K ⊔
              Subgroup.map (QuotientGroup.mk' U.toSubgroup) N
              ≤ K.map (QuotientGroup.mk' U.toSubgroup) ⊔ frattini (G ⧸ U.toSubgroup) :=
            sup_le_sup le_rfl hfratt
          rw [← Subgroup.map_sup, hKN,
            Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective U.toSubgroup)] at h1
          exact le_antisymm le_top h1
        have hKmap2 : K.map (QuotientGroup.mk' U.toSubgroup) = ⊤ := by
          haveI : Finite (G ⧸ U.toSubgroup) := U.toSubgroup.quotient_finite_of_isOpen U.isOpen'
          haveI : IsCoatomic (Subgroup (G ⧸ U.toSubgroup)) := Finite.to_isCoatomic
          exact frattini_nongenerating hstep
        have hKU : K ⊔ U.toSubgroup = ⊤ := by
          rw [← QuotientGroup.ker_mk' U.toSubgroup,
            ← Subgroup.comap_map_eq (QuotientGroup.mk' U.toSubgroup) K, hKmap2,
            Subgroup.comap_top]
        exact hU (hKU ▸ Subgroup.mem_top x)
      refine Nat.sInf_le (hr ▸ ?_)
      exact ⟨f₀, by rw [← MonoidHom.coe_range f₀,
        ← Subgroup.topologicalClosure_coe (s := MonoidHom.range f₀), hK, Subgroup.coe_top]⟩
    · rw [topGeneratorRank]
      refine le_csInf ⟨d, f, hf⟩ ?_
      rintro e ⟨fe, hfe⟩
      have hspan : Submodule.span (ZMod p)
          (Set.range (fun i : Fin e => Additive.ofMul ((QuotientGroup.mk' N) (fe (FreeGroup.of i)))))
          = ⊤ := by
        have hgen' := subgroup_closure_quotient_eq_top hNclosed hQcomm hQexp hfe
        have hset : Additive.toMul ⁻¹'
              (Set.range (fun i : Fin e => (QuotientGroup.mk' N) (fe (FreeGroup.of i))))
            = Set.range (fun i : Fin e =>
                Additive.ofMul ((QuotientGroup.mk' N) (fe (FreeGroup.of i)))) := by
          ext x
          simp only [Set.mem_preimage, Set.mem_range]
          constructor
          · rintro ⟨i, hi⟩; exact ⟨i, Additive.toMul.injective hi⟩
          · rintro ⟨i, rfl⟩; exact ⟨i, rfl⟩
        have hA := congrArg Subgroup.toAddSubgroup hgen'
        rw [Subgroup.toAddSubgroup_closure, hset, addSubgroup_closure_eq_span (n := p),
          OrderIso.map_top] at hA
        have h := congrArg (AddSubgroup.toZModSubmodule p) hA
        rwa [Submodule.toAddSubgroup_toZModSubmodule, OrderIso.map_top] at h
      have hfr : Module.finrank (ZMod p)
          (Submodule.span (ZMod p) (Set.range (fun i : Fin e =>
            Additive.ofMul ((QuotientGroup.mk' N) (fe (FreeGroup.of i)))))) ≤ Fintype.card (Fin e) :=
        finrank_range_le_card (R := ZMod p)
          (b := fun i : Fin e => Additive.ofMul ((QuotientGroup.mk' N) (fe (FreeGroup.of i))))
      rw [hspan, finrank_top (ZMod p), Fintype.card_fin] at hfr
      exact hfr
  have hDual : Module.finrank (ZMod p) (Work.CFT.MaxProP.H1FpCont p G) =
      Module.finrank (ZMod p) (Additive (G ⧸ N)) := by
    haveI : IsClosed (N : Set G) := hNclosed
    haveI : DiscreteTopology (G ⧸ N) := Finite.instDiscreteTopology
    have pow_eq_one : ∀ y : Multiplicative (ZMod p), y ^ p = 1 := fun y => by
      obtain ⟨a, rfl⟩ := Multiplicative.ofAdd.surjective y
      rw [← ofAdd_nsmul, ofAdd_eq_one, nsmul_eq_mul, ZMod.natCast_self, zero_mul]
    have hkill : ∀ ψ : ContinuousMonoidHom G (Multiplicative (ZMod p)),
        N ≤ ψ.toMonoidHom.ker := by
      intro ψ
      rw [hN, proPFrattini]
      refine Subgroup.topologicalClosure_minimal _ ?_ ?_
      · refine sup_le ?_ ?_
        · rw [Subgroup.closure_le]
          rintro x ⟨a, rfl⟩
          refine MonoidHom.mem_ker.mpr ?_
          rw [map_pow]
          exact pow_eq_one _
        · rw [Subgroup.closure_le]
          rintro x ⟨a, b, rfl⟩
          refine MonoidHom.mem_ker.mpr ?_
          rw [map_mul, map_mul, map_mul, map_inv, map_inv,
            mul_comm (ψ.toMonoidHom a) (ψ.toMonoidHom b)]
          group
      · exact IsClosed.preimage ψ.continuous_toFun isClosed_singleton
    have testmul : ∀ ψ₁ ψ₂ : ContinuousMonoidHom G (Multiplicative (ZMod p)),
        (ψ₁ * ψ₂).toMonoidHom = ψ₁.toMonoidHom * ψ₂.toMonoidHom := fun _ _ => rfl
    have e : ContinuousMonoidHom G (Multiplicative (ZMod p)) ≃*
        (G ⧸ N →* Multiplicative (ZMod p)) :=
      { toFun := fun ψ => QuotientGroup.lift N ψ.toMonoidHom (hkill ψ)
        invFun := fun χ => ⟨χ.comp (QuotientGroup.mk' N),
          (continuous_of_discreteTopology :
            Continuous (⇑χ : G ⧸ N → Multiplicative (ZMod p))).comp QuotientGroup.continuous_mk⟩
        left_inv := fun ψ => ContinuousMonoidHom.ext fun g => by
          show (QuotientGroup.lift N ψ.toMonoidHom (hkill ψ)) (QuotientGroup.mk' N g) = ψ g
          rw [QuotientGroup.mk'_apply, QuotientGroup.lift_mk']
          rfl
        right_inv := fun χ => QuotientGroup.monoidHom_ext N (by
          rw [QuotientGroup.lift_comp_mk'])
        map_mul' := fun ψ₁ ψ₂ => QuotientGroup.monoidHom_ext N (by
          rw [QuotientGroup.lift_comp_mk', MonoidHom.mul_comp, QuotientGroup.lift_comp_mk',
            QuotientGroup.lift_comp_mk']
          exact testmul ψ₁ ψ₂) }
    haveI : Module (ZMod p) (Additive (G ⧸ N →* Multiplicative (ZMod p))) :=
      AddCommGroup.zmodModule (fun x => by
        obtain ⟨y, rfl⟩ := Additive.ofMul.surjective x
        rw [← ofMul_pow, ofMul_eq_zero]
        ext q
        simp [pow_eq_one])
    have lin1 : Work.CFT.MaxProP.H1FpCont p G ≃ₗ[ZMod p]
        Additive (G ⧸ N →* Multiplicative (ZMod p)) :=
      AddEquiv.toLinearEquiv (MulEquiv.toAdditive e) (fun c x => ZMod.map_smul _ c x)
    have homEq : Additive (G ⧸ N →* Multiplicative (ZMod p)) ≃+
        (Additive (G ⧸ N) →+ ZMod p) :=
      { toFun := fun χ => ({ toFun := fun a => Multiplicative.toAdd (Additive.toMul χ (Additive.toMul a)), map_zero' := by simp, map_add' := fun a b => by simp [map_mul] } : Additive (G ⧸ N) →+ ZMod p)
        invFun := fun L => Additive.ofMul ({ toFun := fun q => Multiplicative.ofAdd (L (Additive.ofMul q)), map_one' := by simp, map_mul' := fun a b => by simp [map_add] } : G ⧸ N →* Multiplicative (ZMod p))
        left_inv := fun χ => by ext q; simp
        right_inv := fun L => by ext a; simp
        map_add' := fun χ₁ χ₂ => by ext a; simp }
    have lin2 : Additive (G ⧸ N →* Multiplicative (ZMod p)) ≃ₗ[ZMod p]
        Module.Dual (ZMod p) (Additive (G ⧸ N)) :=
      AddEquiv.toLinearEquiv (AddEquiv.trans homEq (AddMonoidHom.toZModLinearMapEquiv p))
        (fun c x => ZMod.map_smul _ c x)
    rw [LinearEquiv.finrank_eq lin1, LinearEquiv.finrank_eq lin2, Subspace.dual_finrank_eq]
  rw [hBurnside, hDual]

end Work.CFT.MaxProP.ContCohomology.Burnside
