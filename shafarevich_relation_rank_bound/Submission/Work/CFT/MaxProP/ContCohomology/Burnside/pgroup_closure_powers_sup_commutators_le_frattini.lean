import Mathlib

namespace Work.CFT.MaxProP.ContCohomology.Burnside

set_option linter.style.haveILetI false

/-- For a finite `p`-group `Q`, the subgroup generated by the `p`-th powers and the commutators is
contained in the Frattini subgroup `Φ(Q)` (the intersection of the maximal subgroups).

Indeed, let `M` be a maximal subgroup of `Q`.  Since `Q` is a finite `p`-group it is nilpotent,
hence `M` is normal (normalizer condition). The correspondence theorem makes the subgroup lattice of
`Q ⧸ M` simple, and `Q ⧸ M` is a nontrivial `p`-group, so Cauchy's theorem produces an element
`x` of order `p`; simplicity forces `Q ⧸ M = ⟨x⟩`.  Thus every element of `Q ⧸ M` is a power of `x`,
so its `p`-th power is `1` and it commutes with every other element; consequently the `p`-th powers
and the commutators of `Q` all lie in `M = ker(Q → Q ⧸ M)`. -/
theorem pgroup_closure_powers_sup_commutators_le_frattini {p : ℕ} [Fact p.Prime]
    {Q : Type} [Group Q] [Finite Q] (hQ : IsPGroup p Q) :
    (Subgroup.closure {x : Q | ∃ a, x = a ^ p} ⊔
      Subgroup.closure {x : Q | ∃ a b : Q, x = a * b * a⁻¹ * b⁻¹}) ≤ frattini Q := by
  haveI : Group.IsNilpotent Q := hQ.isNilpotent
  have hnc : NormalizerCondition Q := Group.normalizerCondition_of_isNilpotent
  -- It suffices to show that both closures are contained in every maximal (coatom) subgroup.
  refine le_iInf fun M => le_iInf fun hM => ?_
  -- Maximal subgroups of a nilpotent group are normal.
  haveI : M.Normal := Subgroup.NormalizerCondition.normal_of_coatom M hnc hM
  have hquot : IsPGroup p (Q ⧸ M) := hQ.to_quotient M
  -- The subgroup lattice of `Q ⧸ M` is simple (correspondence theorem).
  have hsimple : IsSimpleOrder (Subgroup (Q ⧸ M)) :=
    (QuotientGroup.comapMk'OrderIso M).isSimpleOrder_iff.mpr
      (Set.isSimpleOrder_Ici_iff_isCoatom.mpr hM)
  -- The quotient is nontrivial because `M` is a proper subgroup.
  have hnt : Nontrivial (Q ⧸ M) := by
    rw [← not_subsingleton_iff_nontrivial]
    intro hsub
    exact hM.1 (QuotientGroup.subgroup_eq_top_of_subsingleton M hsub)
  -- Cauchy's theorem, using that the order of the quotient is a positive power of `p`.
  obtain ⟨n, hn0, hn⟩ := (IsPGroup.nontrivial_iff_card hquot).mp hnt
  have hdvd : p ∣ Nat.card (Q ⧸ M) := by rw [hn]; exact dvd_pow_self p hn0.ne'
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' p hdvd
  have hx1 : x ≠ 1 := by
    intro h; rw [h, orderOf_one] at hx
    exact (Fact.out : p.Prime).ne_one hx.symm
  -- Simplicity forces `Q ⧸ M = ⟨x⟩`.
  have hzpow : Subgroup.zpowers x = ⊤ := by
    rcases eq_bot_or_eq_top (Subgroup.zpowers x) with h | h
    · exact absurd (Subgroup.mem_bot.mp (h ▸ Subgroup.mem_zpowers x)) hx1
    · exact h
  have hxp : x ^ p = 1 := by rw [← orderOf_dvd_iff_pow_eq_one, ← hx]
  -- Every element is a power of `x`, hence has `p`-th power `1` …
  have key_pow : ∀ y : Q ⧸ M, y ^ p = 1 := by
    intro y
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hzpow ▸ Subgroup.mem_top y)
    rw [← hk]
    calc (x ^ k) ^ p = (x ^ k) ^ (p : ℤ) := by rw [zpow_natCast]
      _ = x ^ (k * (p : ℤ)) := by rw [zpow_mul]
      _ = x ^ ((p : ℤ) * k) := by rw [mul_comm]
      _ = (x ^ (p : ℤ)) ^ k := by rw [zpow_mul]
      _ = (x ^ p) ^ k := by rw [zpow_natCast]
      _ = 1 ^ k := by rw [hxp]
      _ = 1 := one_zpow k
  -- … and the quotient is commutative.
  have key_comm : ∀ y z : Q ⧸ M, y * z = z * y := by
    intro y z
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hzpow ▸ Subgroup.mem_top y)
    obtain ⟨l, hl⟩ := Subgroup.mem_zpowers_iff.mp (hzpow ▸ Subgroup.mem_top z)
    rw [← hk, ← hl, ← zpow_add, ← zpow_add, add_comm]
  -- Pulling back through `Q → Q ⧸ M` (whose kernel is `M`) gives the two inclusions.
  have hpow : ∀ a : Q, a ^ p ∈ M := by
    intro a
    have hmem : a ^ p ∈ (QuotientGroup.mk' M).ker := by
      rw [MonoidHom.mem_ker, map_pow]
      exact key_pow _
    rwa [QuotientGroup.ker_mk'] at hmem
  have hcomm : ∀ a b : Q, a * b * a⁻¹ * b⁻¹ ∈ M := by
    intro a b
    have hmem : a * b * a⁻¹ * b⁻¹ ∈ (QuotientGroup.mk' M).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_mul, map_mul, map_inv, map_inv]
      rw [key_comm (QuotientGroup.mk' M a) (QuotientGroup.mk' M b)]
      group
    rwa [QuotientGroup.ker_mk'] at hmem
  refine sup_le ?_ ?_
  · rw [Subgroup.closure_le]
    rintro x ⟨a, rfl⟩
    exact hpow a
  · rw [Subgroup.closure_le]
    rintro x ⟨a, b, rfl⟩
    exact hcomm a b

end Work.CFT.MaxProP.ContCohomology.Burnside
