import Mathlib

/-!
# Unramifiedness at the infinite places passes to a finite supremum of subfields

Let `F ⊆ A` be fields, `F` a number field, and let `E i` (`i : ι`, `ι` finite) be a family of
intermediate fields, finite dimensional over `F`.  If every `E i / F` is unramified at the infinite
places, then so is the compositum `⨆ i, E i`.

The point is that an infinite place `w` of `K = ⨆ i, E i` is unramified over `F` exactly when it is
either real, or complex over a complex place of `F` (`NumberField.InfinitePlace.isUnramified_iff`).
Suppose then that `w` is complex while the place `v` of `F` below it is real, and that all the
`E i / F` are unramified at infinity.  Then for every `i` the restriction `w_i` of `w` to `E i` is
unramified over `F`; since the place of `F` below `w_i` is `v`, which is real, `w_i` itself must be
real.  In other words the chosen complex embedding `ψ = w.embedding` of `K` is real on the image of
every `E i`, and also on the image of `F` (because `v` is real).  The elements on which `ψ` is real
form a subfield `T` of `K`, and since the union of the `↑(E i)` together with `↑F` generates `K`
(`⨆ i, E i = adjoin F (⋃ i, ↑(E i))`), this subfield is everything: `T = ⊤`, i.e. `ψ` is real, i.e.
`w` is real — a contradiction.

The generation statement is used in the form `K.toSubfield = Subfield.closure (range (algebraMap F A)
∪ ⋃ i, ↑(E i))`, i.e. `Subfield.map (algebraMap ↥K A) T = K.toSubfield`, which forces `T = ⊤`.

## Main results

* `Work.CFTLib.InfinitePlace.isUnramifiedAtInfinitePlaces_iSup`
-/

open NumberField

namespace Work.CFTLib.InfinitePlace

/-- `⨆ i, E i` is the intermediate field generated by the union `⋃ i, ↑(E i)`. -/
private lemma iSup_eq_adjoin {F A : Type} [Field F] [Field A] [Algebra F A] {ι : Type}
    (E : ι → IntermediateField F A) :
    (⨆ i, E i) = IntermediateField.adjoin F (⋃ i, (E i : Set A)) := by
  apply le_antisymm
  · apply iSup_le
    intro i
    calc E i ≤ IntermediateField.adjoin F (E i : Set A) := IntermediateField.subset_adjoin F _
      _ ≤ IntermediateField.adjoin F (⋃ j, (E j : Set A)) := by
        rw [IntermediateField.adjoin_le_iff]
        exact Set.Subset.trans (Set.subset_iUnion (fun j => (E j : Set A)) i)
          (IntermediateField.subset_adjoin F _)
  · rw [IntermediateField.adjoin_le_iff]
    exact Set.iUnion_subset fun i => le_iSup E i

/-- A complex embedding is real iff it is fixed by complex conjugation. -/
private lemma isReal_iff_forall_star {K : Type*} [Field K] (φ : K →+* ℂ) :
    ComplexEmbedding.IsReal φ ↔ ∀ x, (starRingEnd ℂ) (φ x) = φ x := by
  rw [ComplexEmbedding.isReal_iff]
  constructor
  · intro h x
    have hx := RingHom.congr_fun h x
    rw [ComplexEmbedding.conjugate_coe_eq] at hx
    exact hx
  · intro h; ext x; rw [ComplexEmbedding.conjugate_coe_eq]; exact h x

/-- **The core argument.**  If the place of `F` below `w` is real, and the restriction of `w` to
every `E i` is real, then `w` is real. -/
private lemma isReal_of_comap_isReal {F A : Type} [Field F] [Field A] [Algebra F A]
    {ι : Type} (E : ι → IntermediateField F A) (w : InfinitePlace ↥(⨆ i, E i))
    (hv : (w.comap (algebraMap F ↥(⨆ i, E i))).IsReal)
    (h : ∀ i, (w.comap (IntermediateField.inclusion (le_iSup E i)).toRingHom).IsReal) :
    w.IsReal := by
  let K : IntermediateField F A := ⨆ i, E i
  let f : ↥K →+* A := algebraMap ↥K A
  -- The subfield of `K` on which the chosen embedding `w.embedding` is real.
  let T : Subfield ↥K :=
    RingHom.eqLocusField ((starRingEnd ℂ).comp w.embedding) w.embedding
  -- `K` is generated by `F` and the union of the `E i`.
  have hgen : K.toSubfield =
      Subfield.closure (Set.range (algebraMap F A) ∪ ⋃ i, (E i : Set A)) := by
    show (⨆ i, E i).toSubfield = _
    rw [iSup_eq_adjoin E, IntermediateField.adjoin_toSubfield]
  have h1 : Subfield.map f T ≤ K.toSubfield := by
    intro y hy
    rw [Subfield.mem_map] at hy
    obtain ⟨t, ht, rfl⟩ := hy
    exact t.2
  have h2 : K.toSubfield ≤ Subfield.map f T := by
    rw [hgen, Subfield.closure_le]
    apply Set.union_subset
    · -- `↑F` lies in `T`: the place `v` of `F` below `w` is real.
      intro y hy
      rw [Set.mem_range] at hy
      obtain ⟨x, rfl⟩ := hy
      refine Subfield.mem_map.mpr ⟨⟨algebraMap F A x, K.algebraMap_mem x⟩, ?_, rfl⟩
      rw [RingHom.mem_eqLocusField]
      have hv' : ComplexEmbedding.IsReal (w.embedding.comp (algebraMap F ↥K)) := by
        rw [← InfinitePlace.comap_embedding_of_isReal (algebraMap F ↥K) hv]
        exact InfinitePlace.isReal_iff.mp hv
      have hmem := (isReal_iff_forall_star _).mp hv' x
      have hx' : (⟨algebraMap F A x, K.algebraMap_mem x⟩ : ↥K) = algebraMap F ↥K x :=
        Subtype.ext (IsScalarTower.algebraMap_apply F ↥K A x).symm
      rw [hx']
      exact hmem
    · -- `↑(E i)` lies in `T`: the restriction of `w` to `E i` is real.
      intro y hy
      rw [Set.mem_iUnion] at hy
      obtain ⟨i, hy⟩ := hy
      refine Subfield.mem_map.mpr ⟨⟨y, le_iSup E i hy⟩, ?_, rfl⟩
      rw [RingHom.mem_eqLocusField]
      have hh' : ComplexEmbedding.IsReal
          (w.embedding.comp (IntermediateField.inclusion (le_iSup E i)).toRingHom) := by
        rw [← InfinitePlace.comap_embedding_of_isReal _ (h i)]
        exact InfinitePlace.isReal_iff.mp (h i)
      have hmem := (isReal_iff_forall_star _).mp hh' ⟨y, hy⟩
      have hz : (⟨y, le_iSup E i hy⟩ : ↥K) =
          (IntermediateField.inclusion (le_iSup E i)).toRingHom ⟨y, hy⟩ :=
        Subtype.ext (IntermediateField.coe_inclusion (le_iSup E i) ⟨y, hy⟩).symm
      rw [hz]
      exact hmem
  have hmap : Subfield.map f T = K.toSubfield := le_antisymm h1 h2
  have htop : T = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : f x ∈ Subfield.map f T := by
      rw [hmap]
      exact x.2
    rw [Subfield.mem_map] at hx
    obtain ⟨y, hyT, hyx⟩ := hx
    have hyx' : y = x := Subtype.ext hyx
    rwa [← hyx']
  have hxall : ∀ x : ↥K, (starRingEnd ℂ) (w.embedding x) = w.embedding x := by
    intro x
    have : x ∈ T := htop ▸ Subfield.mem_top x
    exact RingHom.mem_eqLocusField.mp this
  refine InfinitePlace.isReal_iff.mpr (ComplexEmbedding.isReal_iff.mpr ?_)
  ext x
  rw [ComplexEmbedding.conjugate_coe_eq]
  exact hxall x

theorem isUnramifiedAtInfinitePlaces_iSup (F A : Type) [Field F] [NumberField F] [Field A]
    [Algebra F A] {ι : Type} [Fintype ι]
    (E : ι → IntermediateField F A) [∀ i, FiniteDimensional F (E i)]
    [NumberField ↥(⨆ i, E i)]
    (h : ∀ i, IsUnramifiedAtInfinitePlaces F ↥(E i)) :
    IsUnramifiedAtInfinitePlaces F ↥(⨆ i, E i) := by
  refine ⟨fun w => ?_⟩
  rw [InfinitePlace.isUnramified_iff]
  by_cases hw : w.IsReal
  · exact Or.inl hw
  · right
    rw [← InfinitePlace.not_isReal_iff_isComplex]
    intro hv
    refine hw (isReal_of_comap_isReal E w hv ?_)
    intro i
    have hunr :
        (w.comap (IntermediateField.inclusion (le_iSup E i)).toRingHom).IsUnramified F :=
      (h i).isUnramified _
    rw [InfinitePlace.isUnramified_iff] at hunr
    rcases hunr with h1 | h2
    · exact h1
    · exfalso
      have hcomp : ((IntermediateField.inclusion (le_iSup E i)).toRingHom).comp
            (algebraMap F ↥(E i)) = algebraMap F ↥(⨆ i, E i) := by
        apply RingHom.ext
        intro x
        exact (IntermediateField.inclusion (le_iSup E i)).commutes x
      rw [← InfinitePlace.comap_comp, hcomp] at h2
      exact InfinitePlace.not_isComplex_iff_isReal.mpr hv h2

end Work.CFTLib.InfinitePlace
