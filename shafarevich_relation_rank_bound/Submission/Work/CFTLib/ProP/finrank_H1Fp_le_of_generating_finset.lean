import Mathlib
import Submission.Work.CFTLib.ShafDeps
import Submission.Work.CFTLib.ProP.Galois
import Submission.Work.CFTLib.ProP.isGalois_maximalUnramifiedProPF
import Submission.Work.Tower.Shafarevich.Cohomology.finrank_H1Fp_eq_finrank_hom

/-!
# `dim_{𝔽_p} H¹(Gal(K'/F), 𝔽_p) ≤ d(Gal(F^{un,p}/F))`

Let `F` be a number field, `p` a prime, `E = F^{un,p}` the maximal everywhere-unramified pro-`p`
extension of `F` and `G = Gal(E/F)`.  If `S` is a finite set of elements of `G` whose generated
subgroup is dense (equivalently, which generates `G` topologically), and if `K'` is a finite Galois
intermediate field of `E/F`, then

`dim_{𝔽_p} H¹(Gal(K'/F), 𝔽_p) ≤ |S|`.

This is the "minimal number of generators of a quotient" step of Shafarevich's relation rank
estimate: `Gal(K'/F)` is a quotient of `G`, so it is generated by the images of `S`, and the
`𝔽_p`-dual of `Gal(K'/F)` injects into functions on a generating set.

The main ingredients are
* `AlgEquiv.restrictNormalHom`: the restriction `G →* Gal(K'/F)`, surjective because `E/F` is Galois
  and `K'/F` is normal;
* `IntermediateField.fixingSubgroup_isOpen`: the kernel contains the (open, as `K'/F` is finite)
  fixing subgroup of `K'`, so the preimage of any subgroup is open;
* hence any subgroup of `Gal(K'/F)` containing the images of `S` has an open, therefore closed,
  preimage, and therefore contains the topological closure of the subgroup generated by `S`, i.e.
  is everything.
-/

open LeanEval.NumberTheory

namespace Work.CFTLib.ProP

set_option linter.style.haveILetI false

theorem finrank_H1Fp_le_of_generating_finset (F : Type) [Field F] [NumberField F] (p : ℕ)
    [Fact (Nat.Prime p)]
    (hgalE : IsGalois F ↥(LeanEval.NumberTheory.maximalUnramifiedProPF F p))
    (K' : IntermediateField F ↥(LeanEval.NumberTheory.maximalUnramifiedProPF F p))
    [FiniteDimensional F K'] [IsGalois F K'] [NumberField ↥K']
    (S : Finset (LeanEval.NumberTheory.MaxUnramifiedProPGaloisGroup F p))
    (hS : (Subgroup.closure (S : Set (LeanEval.NumberTheory.MaxUnramifiedProPGaloisGroup F p))).topologicalClosure = ⊤) :
    Module.finrank (ZMod p) (Work.Tower.Shafarevich.H1Fp p (↥K' ≃ₐ[F] ↥K')) ≤ S.card := by
  classical
  -- Work in the underlying algebra-equivalence type rather than in `MaxUnramifiedProPGaloisGroup`,
  -- whose group/topology instances are definitionally the ones of the Krull topology.
  let S' : Finset (Gal(↥(maximalUnramifiedProPF F p)/F)) :=
    show Finset (Gal(↥(maximalUnramifiedProPF F p)/F)) from S
  have hS' : (Subgroup.closure (S' : Set (Gal(↥(maximalUnramifiedProPF F p)/F)))).topologicalClosure
      = ⊤ := hS
  haveI : Normal F ↥K' := (inferInstance : IsGalois F ↥K').to_normal
  haveI : Normal F ↥(maximalUnramifiedProPF F p) := hgalE.to_normal
  -- The restriction homomorphism `Gal(E/F) →* Gal(K'/F)`.
  let π : Gal(↥(maximalUnramifiedProPF F p)/F) →* Gal(↥K'/F) := AlgEquiv.restrictNormalHom ↥K'
  have hπsurj : Function.Surjective π := by
    intro q
    obtain ⟨σ, hσ⟩ :=
      AlgEquiv.restrictNormalHom_surjective (K₁ := ↥K') (E := ↥(maximalUnramifiedProPF F p)) q
    exact ⟨σ, hσ⟩
  -- Its kernel contains the fixing subgroup of the finite extension `K'/F`, which is open.
  have hfix_le : K'.fixingSubgroup ≤ π.ker := by
    intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff] at hσ
    show π σ = 1
    exact (AlgEquiv.restrictNormal_eq_one_iff K' σ).mpr hσ
  have hkeropen : IsOpen (π.ker : Set (Gal(↥(maximalUnramifiedProPF F p)/F))) :=
    Subgroup.isOpen_mono hfix_le (IntermediateField.fixingSubgroup_isOpen K')
  -- The images of `S` generate `Gal(K'/F)`.
  have hHtop : Subgroup.closure (π '' (S' : Set (Gal(↥(maximalUnramifiedProPF F p)/F)))) = ⊤ := by
    set H : Subgroup Gal(↥K'/F) :=
      Subgroup.closure (π '' (S' : Set (Gal(↥(maximalUnramifiedProPF F p)/F)))) with hH
    have hH'open : IsOpen ((H.comap π : Subgroup Gal(↥(maximalUnramifiedProPF F p)/F)) :
        Set (Gal(↥(maximalUnramifiedProPF F p)/F))) := by
      apply Subgroup.isOpen_mono _ hkeropen
      intro x hx
      change π x ∈ H
      rw [show π x = 1 from hx]
      exact H.one_mem
    have hSle : Subgroup.closure (S' : Set (Gal(↥(maximalUnramifiedProPF F p)/F)))
        ≤ H.comap π := by
      rw [Subgroup.closure_le]
      intro s hs
      change π s ∈ H
      exact Subgroup.subset_closure ⟨s, hs, rfl⟩
    -- the preimage is open, hence closed, hence it contains the dense subgroup generated by `S`
    have hle := Subgroup.topologicalClosure_minimal _ hSle (Subgroup.isClosed_of_isOpen _ hH'open)
    rw [hS'] at hle
    have hcomap : H.comap π = ⊤ := top_le_iff.mp hle
    refine top_le_iff.mp ?_
    intro q _
    obtain ⟨x, rfl⟩ := hπsurj q
    have hx : x ∈ Subgroup.comap π H := by rw [hcomap]; exact Subgroup.mem_top x
    exact Subgroup.mem_comap.mp hx
  -- `dim H¹(Gal(K'/F), 𝔽_p) = dim Hom(Gal(K'/F), 𝔽_p)`.
  rw [Work.Tower.Shafarevich.Cohomology.finrank_H1Fp_eq_finrank_hom p (↥K' ≃ₐ[F] ↥K')]
  have hcard : Module.finrank (ZMod p) (↥S' → ZMod p) = S.card := by
    rw [Module.finrank_pi, Fintype.card_coe]
    rfl
  rw [← hcard]
  haveI : Fintype ↥S' := Finset.fintypeCoeSort S'
  haveI : Finite ↥S' := Finite.of_fintype ↥S'
  haveI : Module.Finite (ZMod p) (↥S' → ZMod p) := Module.Finite.pi
  -- Restriction of a character to the generating set is injective.
  let Φ : (Additive (Gal(↥K'/F)) →+ ZMod p) →ₗ[ZMod p] (↥S' → ZMod p) :=
    { toFun := fun f => fun s => f (Additive.ofMul (π (s : Gal(↥(maximalUnramifiedProPF F p)/F))))
      map_add' := by
        intro f g
        ext s
        simp [AddMonoidHom.add_apply]
      map_smul' := by
        intro a f
        ext s
        simp [AddMonoidHom.smul_apply] }
  apply LinearMap.finrank_le_finrank_of_injective (f := Φ)
  intro f g hfg
  have hvanish : ∀ s : ↥S', f (Additive.ofMul (π (s : Gal(↥(maximalUnramifiedProPF F p)/F))))
      = g (Additive.ofMul (π (s : Gal(↥(maximalUnramifiedProPF F p)/F)))) := by
    intro s
    have h := congrFun hfg s
    simpa [Φ] using h
  let Kerg : Subgroup (Gal(↥K'/F)) :=
    { carrier := {q | f (Additive.ofMul q) = g (Additive.ofMul q)}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        simp only [Set.mem_ofPred_eq] at ha hb ⊢
        rw [ofMul_mul]
        simp [ha, hb]
      inv_mem' := by
        intro a ha
        simp only [Set.mem_ofPred_eq] at ha ⊢
        rw [ofMul_inv]
        simp [ha] }
  have hle : Subgroup.closure (π '' (S' : Set (Gal(↥(maximalUnramifiedProPF F p)/F)))) ≤ Kerg := by
    rw [Subgroup.closure_le]
    intro q hq
    obtain ⟨s, hs, rfl⟩ := hq
    simpa [Kerg] using hvanish ⟨s, hs⟩
  have hKerg : Kerg = ⊤ := top_le_iff.mp (hHtop ▸ hle)
  refine AddMonoidHom.ext (fun x => ?_)
  obtain ⟨q, rfl⟩ := Additive.ofMul.surjective x
  have hq : f (Additive.ofMul q) = g (Additive.ofMul q) := by
    have : q ∈ Kerg := by rw [hKerg]; exact Subgroup.mem_top q
    exact this
  exact hq

end Work.CFTLib.ProP
