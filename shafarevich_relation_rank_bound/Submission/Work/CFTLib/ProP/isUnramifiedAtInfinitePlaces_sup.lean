import Mathlib
import Submission.Work.CFTLib.ShafDeps
import Submission.Work.CFTLib.Unramified.isEverywhereUnramified_iff
import Submission.Work.CFTLib.Transport.isUnramified_algEquiv

namespace Work.CFTLib.ProP

open NumberField

/-- **The compositum of two extensions unramified at the infinite places is unramified at the
infinite places.**  Mathlib has no such lemma: `IsUnramifiedAtInfinitePlaces` is closed under
subextensions (`.bot`), under the top step of a tower (`.top`) and under composition (`.trans`),
but *not* visibly under `⊔` of two intermediate fields.  (A sibling file in this workspace,
`Submission/Work/CFTLib/InfinitePlace/isUnramifiedAtInfinitePlaces_iSup.lean`, contains the
general `Fintype`-indexed version; this `⊔` case is its `Bool`-indexed special case and can be
proved independently by the sketch below.)

Proof sketch.  Use
`Work.CFTLib.Unramified.isUnramifiedAtInfinitePlaces_iff`, which identifies
`IsUnramifiedAtInfinitePlaces F K` (for a finite extension of number fields) with
`∀ w : InfinitePlace F, w.IsReal → ∀ w' : InfinitePlace K, w'.comap (algebraMap F K) = w → w'.IsReal`.
So fix `w : InfinitePlace F` real and `w' : InfinitePlace ↥(E₁ ⊔ E₂)` with
`w'.comap (algebraMap F _) = w`, and put `L := E₁ ⊔ E₂`, `φ := w'.embedding : L →+* ℂ`
(`InfinitePlace.isReal_iff`, `InfinitePlace.mk_embedding`).  One must show
`ComplexEmbedding.IsReal φ`.

1. From `w'.comap (algebraMap F L) = mk (φ.comp (algebraMap F L)) = w` and `w.IsReal`, deduce
`ComplexEmbedding.IsReal (φ.comp (algebraMap F L))`.
2. For `i = 1, 2`: the place `mk (φ.comp (algebraMap ↥E_i L))` of `↥E_i` has restriction to `F`
equal to `w` (use `IsScalarTower.algebraMap_eq F ↥E_i L`); by hypothesis (the characterisation
of step 1 applied to `h_i`) it is real, i.e.
`ComplexEmbedding.IsReal (φ.comp (algebraMap ↥E_i L))`.
3. Now `L` is generated (as a field over `F`) by `E₁` and `E₂`, so any `x : L` is a rational
function of elements of `E₁ ∪ E₂`, hence `φ x` lies in the subfield of `ℂ` generated by the
images `φ '' E₁`, `φ '' E₂`, which by 2. both lie in `ℝ`.  So `φ` is real.

Suggested formalisation of step 3, avoiding an explicit generation induction: let
`T : Subfield L := RingHom.eqLocusField (ComplexEmbedding.conjugate φ) φ` (so
`x ∈ T ↔ ComplexEmbedding.conjugate φ x = φ x ↔ IsSelfAdjoint (φ x)`, via
`RingHom.mem_eqLocusField` / `ComplexEmbedding.isReal_iff`), and let
`T' : IntermediateField F A := { Subfield.map (algebraMap ↥L A) T with algebraMap_mem' := ... }`.
Step 2 gives `(algebraMap ↥E_i ↥L).fieldRange ≤ T` (`ComplexEmbedding.conjugate_comp`; note
`ComplexEmbedding.IsReal` is `IsSelfAdjoint φ`, i.e. `ComplexEmbedding.conjugate φ = φ`), hence
`E_i ≤ T'`; then `IntermediateField.adjoin_le_iff` (together with
`IntermediateField.sup_def : E₁ ⊔ E₂ = adjoin F (E₁ ∪ E₂)`) gives `L ≤ T'`, so every `x : L`
lies in `T`, i.e. `ComplexEmbedding.conjugate φ = φ`, i.e. `IsReal φ`.
An alternative for step 3 is `Subfield.closure_induction` over
`(E₁ ⊔ E₂).toSubfield = Subfield.closure (Set.range (algebraMap F A) ∪ E₁ ∪ E₂)`
(`IntermediateField.adjoin_toSubfield`).

Note the two monotone ingredients that make the argument work: a real place restricts to a real
place (`ComplexEmbedding.IsReal.comp`), and `E₁ ⊔ E₂` is the *smallest* subfield containing both,
i.e. `IntermediateField.sup_def`.  Note also `ComplexEmbedding.IsReal` is `IsSelfAdjoint`. -/
theorem isUnramifiedAtInfinitePlaces_sup
    (F A : Type) [Field F] [NumberField F] [Field A] [Algebra F A]
    (E₁ E₂ : IntermediateField F A)
    [FiniteDimensional F ↥E₁] [FiniteDimensional F ↥E₂]
    [FiniteDimensional F ↥(E₁ ⊔ E₂)]
    [NumberField ↥E₁] [NumberField ↥E₂] [NumberField ↥(E₁ ⊔ E₂)]
    (h₁ : IsUnramifiedAtInfinitePlaces F ↥E₁) (h₂ : IsUnramifiedAtInfinitePlaces F ↥E₂) :
    IsUnramifiedAtInfinitePlaces F ↥(E₁ ⊔ E₂) := by
  refine (Work.CFTLib.Unramified.isUnramifiedAtInfinitePlaces_iff F ↥(E₁ ⊔ E₂)).mpr ?_
  intro w hw w' hw'
  set φ : ↥(E₁ ⊔ E₂) →+* ℂ := w'.embedding with hφ
  let inc₁ : ↥E₁ →+* ↥(E₁ ⊔ E₂) :=
    (IntermediateField.inclusion (le_sup_left : E₁ ≤ E₁ ⊔ E₂) : ↥E₁ →+* ↥(E₁ ⊔ E₂))
  let inc₂ : ↥E₂ →+* ↥(E₁ ⊔ E₂) :=
    (IntermediateField.inclusion (le_sup_right : E₂ ≤ E₁ ⊔ E₂) : ↥E₂ →+* ↥(E₁ ⊔ E₂))
  -- Step 1: `φ` is real after restriction to `F`.
  have hF' : ComplexEmbedding.conjugate (φ.comp (algebraMap F ↥(E₁ ⊔ E₂)))
      = φ.comp (algebraMap F ↥(E₁ ⊔ E₂)) := by
    apply InfinitePlace.isReal_mk_iff.mp
    rw [← InfinitePlace.comap_mk, hφ, InfinitePlace.mk_embedding, hw']
    exact hw
  -- Step 2, `i = 1`: `φ` restricts to a real embedding of `E₁`.
  have hcomp₁ : (φ.comp inc₁).comp (algebraMap F ↥E₁) = φ.comp (algebraMap F ↥(E₁ ⊔ E₂)) := by
    ext x
    simp only [RingHom.comp_apply]
    congr 1
  have hcomap₁ : (InfinitePlace.mk (φ.comp inc₁)).comap (algebraMap F ↥E₁) = w := by
    rw [InfinitePlace.comap_mk, hcomp₁, ← InfinitePlace.comap_mk, hφ, InfinitePlace.mk_embedding,
      hw']
  have hE₁' : ComplexEmbedding.conjugate (φ.comp inc₁) = φ.comp inc₁ := by
    have hreal : (InfinitePlace.mk (φ.comp inc₁)).IsReal :=
      (Work.CFTLib.Unramified.isUnramifiedAtInfinitePlaces_iff F ↥E₁).mp h₁ w hw
        (InfinitePlace.mk (φ.comp inc₁)) hcomap₁
    exact InfinitePlace.isReal_mk_iff.mp hreal
  -- Step 2, `i = 2`: `φ` restricts to a real embedding of `E₂`.
  have hcomp₂ : (φ.comp inc₂).comp (algebraMap F ↥E₂) = φ.comp (algebraMap F ↥(E₁ ⊔ E₂)) := by
    ext x
    simp only [RingHom.comp_apply]
    congr 1
  have hcomap₂ : (InfinitePlace.mk (φ.comp inc₂)).comap (algebraMap F ↥E₂) = w := by
    rw [InfinitePlace.comap_mk, hcomp₂, ← InfinitePlace.comap_mk, hφ, InfinitePlace.mk_embedding,
      hw']
  have hE₂' : ComplexEmbedding.conjugate (φ.comp inc₂) = φ.comp inc₂ := by
    have hreal : (InfinitePlace.mk (φ.comp inc₂)).IsReal :=
      (Work.CFTLib.Unramified.isUnramifiedAtInfinitePlaces_iff F ↥E₂).mp h₂ w hw
        (InfinitePlace.mk (φ.comp inc₂)) hcomap₂
    exact InfinitePlace.isReal_mk_iff.mp hreal
  -- Step 3: the locus where `conjugate φ` and `φ` agree contains the images of `E₁`, `E₂` and
  -- generates everything.
  set T : Subfield ↥(E₁ ⊔ E₂) := RingHom.eqLocusField (ComplexEmbedding.conjugate φ) φ with hT
  have hleF : ∀ y ∈ Set.range (algebraMap F ↥(E₁ ⊔ E₂)), y ∈ T := by
    rintro _ ⟨x, rfl⟩
    rw [hT, RingHom.mem_eqLocusField]
    simpa using RingHom.ext_iff.mp hF' x
  have hle₁ : ∀ y ∈ Set.range inc₁, y ∈ T := by
    rintro _ ⟨x, rfl⟩
    rw [hT, RingHom.mem_eqLocusField]
    simpa using RingHom.ext_iff.mp hE₁' x
  have hle₂ : ∀ y ∈ Set.range inc₂, y ∈ T := by
    rintro _ ⟨x, rfl⟩
    rw [hT, RingHom.mem_eqLocusField]
    simpa using RingHom.ext_iff.mp hE₂' x
  let T' : IntermediateField F A :=
    { Subfield.map (algebraMap ↥(E₁ ⊔ E₂) A) T with
      algebraMap_mem' := fun x => ⟨algebraMap F ↥(E₁ ⊔ E₂) x, hleF _ ⟨x, rfl⟩, by simp⟩ }
  have hT'mem : ∀ a : A, a ∈ T' ↔ ∃ y ∈ T, algebraMap ↥(E₁ ⊔ E₂) A y = a := fun a =>
    Subfield.mem_map
  have hle₁' : E₁ ≤ T' := by
    intro a ha
    exact ⟨inc₁ ⟨a, ha⟩, hle₁ _ ⟨_, rfl⟩, by simp [inc₁]⟩
  have hle₂' : E₂ ≤ T' := by
    intro a ha
    exact ⟨inc₂ ⟨a, ha⟩, hle₂ _ ⟨_, rfl⟩, by simp [inc₂]⟩
  have hsup : E₁ ⊔ E₂ ≤ T' := sup_le hle₁' hle₂'
  have hmem : ∀ x : ↥(E₁ ⊔ E₂), x ∈ T := by
    intro x
    have hx : (x : A) ∈ T' := hsup x.2
    obtain ⟨y, hy, hyx⟩ := (hT'mem (x : A)).mp hx
    have hyx' : y = x := Subtype.ext (by simpa using hyx)
    rw [← hyx']
    exact hy
  have hconj : ComplexEmbedding.conjugate φ = φ := by
    ext x
    have hx : x ∈ T := hmem x
    rw [hT, RingHom.mem_eqLocusField] at hx
    exact hx
  exact InfinitePlace.isReal_iff.mpr hconj

end Work.CFTLib.ProP
