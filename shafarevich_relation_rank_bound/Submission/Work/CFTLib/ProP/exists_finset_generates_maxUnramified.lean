import Mathlib
import Submission.Work.CFTLib.ShafDeps
import Submission.Work.CFTLib.ProP.Galois
import Submission.Work.CFTLib.ProP.fg_of_finite_frattini
import Submission.Work.CFTLib.ProP.le_maximalUnramifiedProPF
import Submission.Work.CFTLib.ProP.isGalois_maximalUnramifiedProPF
import Submission.Work.CFTLib.Unramified.isEverywhereUnramified_iff
import Submission.Work.CFTLib.ProP.maxUnramifiedAux
import Submission.Work.CFTLib.ProP.finite_quotient_of_forall_index_le
import Submission.Work.CFTLib.ProP.index_le_classNumber_of_isOpen_normal

namespace Work.CFTLib.ProP

/-!
# `Gal(F^{un,p}/F)` is topologically finitely generated, by exactly `d(G)` generators

Let `F` be a number field, `p` a prime, `E = F^{un,p} = maximalUnramifiedProPF F p` the maximal
everywhere-unramified pro-`p` extension of `F` and `G = Gal(E/F) = MaxUnramifiedProPGaloisGroup F p`.

The goal of this file is

`∃ S : Finset G, S.card = generatorRank G ∧ closure(S).topologicalClosure = ⊤`,

i.e. that `G` is topologically finitely generated and that the minimal number of topological
generators (`generatorRank G`, a defining infimum over generating `Finset`s) is *attained*.

The mathematical content is the classical theorem that `G` is finitely generated as a pro-`p`
group, which follows from finiteness of its Frattini quotient
`G ⧸ Φ(G) = G ⧸ closure(G^p·[G,G])`, itself a quotient of the maximal abelian quotient
`Gal(F^{ab,un,p}/F)` — finite by `hab : CFTLib.UnramifiedAbelianDegreeLe`.

The proof has three parts.

* *Finiteness of the Frattini quotient.*  For every open normal subgroup `N ⊇ Φ(G)`, the
  quotient `G ⧸ N` is abelian (since `Φ(G)` contains the closed commutator subgroup), and equals
  `Gal(K/F)` for `K` the fixed field of `N` (`quotient_fixedField`).  By
  `isUnramified_isPGroup_of_le_max` (transporting `le_maximalUnramifiedProPF`) `K/F` is a finite
  unramified subextension; `hab` then bounds `N.index = [K : F] ≤ h_F`
  (`index_le_classNumber_of_isOpen_normal`).  The profinite lemma
  `finite_quotient_of_forall_index_le` (a compact totally disconnected group all of whose open
  normal subgroups have index `≤ M` is finite modulo any closed normal subgroup normalized by the
  family — here `Φ(G)`) then gives `Finite (G ⧸ Φ(G))`.

* *Finite generation.*  `isProPGroup_GG` says every finite continuous quotient of `G` is a
  `p`-group, so `fg_of_finite_frattini` applied to `N = Φ(G)` produces a finite topological
  generating set `S₀`.

* *Attainment of `generatorRank`.*  `generatorRank G = sInf A` where `A` is the set of
  cardinalities of finite generating sets.  `A` is nonempty by the previous step, so
  `Nat.sInf_mem` exhibits a generating `Finset` whose cardinality is `sInf A = generatorRank G`.
-/

open NumberField

noncomputable section

set_option maxHeartbeats 800000
set_option synthInstance.maxHeartbeats 800000

/-- **`Gal(F^{un,p}/F)` is generated by `generatorRank`-many elements.** -/
theorem exists_finset_generates_maxUnramified (F : Type) [Field F] [NumberField F] (p : ℕ)
    [Fact (Nat.Prime p)] (hab : CFTLib.UnramifiedAbelianDegreeLe) :
    ∃ S : Finset (LeanEval.NumberTheory.MaxUnramifiedProPGaloisGroup F p),
      S.card = LeanEval.NumberTheory.generatorRank (LeanEval.NumberTheory.MaxUnramifiedProPGaloisGroup F p) ∧
      (Subgroup.closure (S : Set (LeanEval.NumberTheory.MaxUnramifiedProPGaloisGroup F p))).topologicalClosure = ⊤ := by
  -- Work with the (definitionally equal) presentation `GG F p = Gal(E/F)`.
  change ∃ S : Finset (GG F p),
      S.card = LeanEval.NumberTheory.generatorRank (GG F p) ∧
      (Subgroup.closure (S : Set (GG F p))).topologicalClosure = ⊤
  haveI hgalE : IsGalois F ↥(E F p) := isGalois_maximalUnramifiedProPF F p
  -- `Φ(G) = proPFrattini p G` is a closed normal subgroup of `G`.
  have hPnorm : (Subgroup.closure {x : GG F p | ∃ a : GG F p, x = a ^ p}).Normal := by
    refine ⟨fun n hn g => ?_⟩
    refine Subgroup.closure_induction (x := n) ?_ ?_ ?_ ?_ hn
    · rintro x ⟨a, rfl⟩
      exact Subgroup.subset_closure ⟨g * a * g⁻¹,
        by rw [← MulAut.conj_apply g a, ← map_pow (MulAut.conj g) a p, MulAut.conj_apply]⟩
    · simpa using Subgroup.one_mem _
    · intro x y _ _ hx hy
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ hx
  have hCnorm : (Subgroup.closure {x : GG F p | ∃ a b : GG F p,
      x = a * b * a⁻¹ * b⁻¹}).Normal := by
    refine ⟨fun n hn g => ?_⟩
    refine Subgroup.closure_induction (x := n) ?_ ?_ ?_ ?_ hn
    · rintro x ⟨a, b, rfl⟩
      exact Subgroup.subset_closure ⟨g * a * g⁻¹, g * b * g⁻¹, by group⟩
    · simpa using Subgroup.one_mem _
    · intro x y _ _ hx hy
      rw [show g * (x * y) * g⁻¹ = (g * x * g⁻¹) * (g * y * g⁻¹) by group]
      exact Subgroup.mul_mem _ hx hy
    · intro x _ hx
      rw [show g * x⁻¹ * g⁻¹ = (g * x * g⁻¹)⁻¹ by group]
      exact Subgroup.inv_mem _ hx
  haveI hΦnorm : (Work.CFT.MaxProP.proPFrattini p (GG F p)).Normal := by
    haveI : (Subgroup.closure {x : GG F p | ∃ a : GG F p, x = a ^ p} ⊔
        Subgroup.closure {x : GG F p | ∃ a b : GG F p,
          x = a * b * a⁻¹ * b⁻¹}).Normal := inferInstance
    rw [Work.CFT.MaxProP.proPFrattini]
    exact Subgroup.is_normal_topologicalClosure _
  -- Finiteness of the Frattini quotient, via the class-number bound on abelian quotients.
  have hfin : Finite ((GG F p) ⧸ Work.CFT.MaxProP.proPFrattini p (GG F p)) := by
    refine finite_quotient_of_forall_index_le (G := GG F p)
      (Φ := Work.CFT.MaxProP.proPFrattini p (GG F p))
      (M := Nat.card (ClassGroup (𝓞 F))) ?_ ?_
    · rw [Work.CFT.MaxProP.proPFrattini]
      exact Subgroup.isClosed_topologicalClosure _
    · intro N hNnorm hNopen hle
      haveI : N.Normal := hNnorm
      refine index_le_classNumber_of_isOpen_normal F p hab N hNopen ?_
      -- `N ⊇ Φ(G)` contains the commutators, so `G ⧸ N` is abelian.
      intro a b
      obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N a
      obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N b
      rw [← map_mul (QuotientGroup.mk' N), ← map_mul (QuotientGroup.mk' N),
        QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_iff_div_mem]
      convert (hle (by
        rw [Work.CFT.MaxProP.proPFrattini]
        exact Subgroup.le_topologicalClosure _
          (Subgroup.mem_sup_right (Subgroup.subset_closure ⟨x, y, rfl⟩)))) using 1
      rw [div_eq_mul_inv, mul_inv_rev]
      group
  -- `G` is topologically finitely generated (Burnside's basis theorem for pro-`p` groups).
  obtain ⟨S₀, hS₀⟩ := fg_of_finite_frattini p (GG F p) (fun U => isProPGroup_GG F p U)
    (Work.CFT.MaxProP.proPFrattini p (GG F p)) rfl hfin
  -- `generatorRank G = sInf A` is attained because `A` is nonempty.
  have hne : ({k : ℕ | ∃ S : Finset (GG F p), S.card = k ∧
      (Subgroup.closure (S : Set (GG F p))).topologicalClosure = ⊤} : Set ℕ).Nonempty :=
    ⟨S₀.card, S₀, rfl, hS₀⟩
  obtain ⟨S, hcard, hcl⟩ := Nat.sInf_mem hne
  exact ⟨S, by rw [hcard, LeanEval.NumberTheory.generatorRank], hcl⟩

end

end Work.CFTLib.ProP
