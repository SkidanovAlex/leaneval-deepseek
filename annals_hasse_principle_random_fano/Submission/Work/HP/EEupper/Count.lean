import Submission.Work.HP.MDEstimates.orthLat_detL

/-!
# The rank-two lattice count

`Work.HP.EEupper.numLattices2Mine`: the paper's "number of lattices" bound specialised to
rank `2`, obtained from the fibre count `fiberCountMine` by summing over the rank-one
sublattice generated by a shortest vector.

The fibre count is the version of `Work.HP.fiber_count` with the two remaining `sorry`-free
inputs replaced by proved ones (`Work.EEupper.memSatLatDotB`, `Work.HP.MDEstimates.orthLat_detL`),
so that the final theorem rests only on the standard axioms.
-/

set_option autoImplicit false
set_option maxHeartbeats 2000000
set_option linter.unusedSectionVars false

noncomputable section

open Finset

namespace Work.HP.EEupper

open Work.HP

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## The fibre count -/

/-- **Fibre count.**  For a primitive lattice `Λ ⊆ ℤ^ι` and `S ≥ 1`, the number of primitive
rank-`(rk Λ + 1)` lattices `L ⊇ Λ` with `λ_{rk Λ + 1}(L) ≤ S` is at most
`16^{card ι} · K · S^{card ι - rk Λ} · detL Λ`, where `K` is any constant with
`∏_{j < rk L} λ_{j+1}(L) ≤ K · detL L`. -/
theorem fiberCountMine (Kmk : ℝ) (hKmk0 : 0 ≤ Kmk) (Λ : Submodule ℤ (ι → ℤ))
    (hΛ : IsPrimLat Λ) (S : ℝ) (hS : 1 ≤ S)
    (hKmk : ∀ L : Submodule ℤ (ι → ℤ),
      (∏ j ∈ Finset.range (rk L), lam L (j + 1)) ≤ Kmk * detL L) :
    (({L : Submodule ℤ (ι → ℤ) | Λ ≤ L ∧ IsPrimLat L ∧ rk L = rk Λ + 1 ∧
        lam L (rk Λ + 1) ≤ S}.ncard : ℝ) ≤
      16 ^ (Fintype.card ι) * Kmk * S ^ (Fintype.card ι - rk Λ) * detL Λ) := by
  classical
  set m : ℕ := Fintype.card ι - rk Λ with hm
  have hrm : rk (orthLat Λ) = m := numaux.rk_orthLat Λ hΛ
  obtain ⟨b, hb_mem, hb_ind, hb_norm⟩ := FM.exists_indep_le_lam (orthLat Λ)
  set a : Fin m → (ι → ℤ) := fun j => b (Fin.cast hrm.symm j) with ha
  have ha_mem : ∀ j, a j ∈ orthLat Λ := fun j => hb_mem _
  have ha_ind : LinearIndependent ℤ a :=
    hb_ind.comp (Fin.cast hrm.symm) (Fin.cast_injective hrm.symm)
  have ha_norm : ∀ j, eNorm (a j) ≤ lam (orthLat Λ) (j.1 + 1) := by
    intro j
    have := hb_norm (Fin.cast hrm.symm j)
    simpa [ha] using this
  set F : Set (Submodule ℤ (ι → ℤ)) :=
    {L | Λ ≤ L ∧ IsPrimLat L ∧ rk L = rk Λ + 1 ∧ lam L (rk Λ + 1) ≤ S} with hF
  have hex : ∀ L ∈ F, ∃ u : ι → ℤ, u ∈ L ∧ u ∉ satLat Λ ∧ eNorm u ≤ S := by
    intro L hL
    obtain ⟨hΛL, hLprim, hrkL, hlamL⟩ := hL
    obtain ⟨f, hf_mem, hf_ind, hf_norm⟩ := FM.exists_indep_le_lam L
    have hsome : ∃ k, f k ∉ satLat Λ := by
      by_contra hcon
      push_neg at hcon
      have hspan_le : Submodule.span ℤ (Set.range f) ≤ satLat Λ :=
        Submodule.span_le.mpr (by rintro x ⟨k, rfl⟩; exact hcon k)
      have h1 : rk (Submodule.span ℤ (Set.range f)) ≤ rk (satLat Λ) :=
        Submodule.finrank_mono hspan_le
      rw [numaux.rk_span_eq hf_ind, numaux.rk_satLat Λ, hrkL] at h1
      omega
    obtain ⟨k, hk⟩ := hsome
    refine ⟨f k, hf_mem k, hk, ?_⟩
    refine le_trans (hf_norm k) ?_
    calc lam L (k.1 + 1) ≤ lam L (rk L) :=
          lam_mono_index L (by omega) le_rfl
      _ = lam L (rk Λ + 1) := by rw [hrkL]
      _ ≤ S := hlamL
  let u : (Submodule ℤ (ι → ℤ)) → (ι → ℤ) :=
    fun L => if h : L ∈ F then Classical.choose (hex L h) else 0
  have hu_mem : ∀ L ∈ F, u L ∈ L := by
    intro L hL
    simp only [u, dif_pos hL]
    exact (Classical.choose_spec (hex L hL)).1
  have hu_not : ∀ L ∈ F, u L ∉ satLat Λ := by
    intro L hL
    simp only [u, dif_pos hL]
    exact (Classical.choose_spec (hex L hL)).2.1
  have hu_norm : ∀ L ∈ F, eNorm (u L) ≤ S := by
    intro L hL
    simp only [u, dif_pos hL]
    exact (Classical.choose_spec (hex L hL)).2.2
  have hinj : Set.InjOn (fun L => fun j : Fin m => dotI (u L) (a j)) F := by
    intro L hL L' hL' heq
    have hw : ∀ j, dotI (u L - u L') (a j) = 0 := by
      intro j
      have h1 : dotI (u L) (a j) - dotI (u L') (a j) = 0 := by
        have h2 := congrFun heq j
        simp only at h2
        linarith
      rw [dotI_sub_left]
      exact h1
    have hmem : u L - u L' ∈ Λ :=
      Work.EEupper.memSatLatDotB Λ hΛ hrm ha_mem ha_ind (u L - u L') hw
    have hspan : Λ ⊔ Submodule.span ℤ ({u L} : Set (ι → ℤ))
        = Λ ⊔ Submodule.span ℤ ({u L'} : Set (ι → ℤ)) := by
      have hsplit : u L = u L' + (u L - u L') := by abel
      refine le_antisymm ?_ ?_
      · refine sup_le le_sup_left ?_
        rw [Submodule.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        rw [hx, hsplit]
        exact Submodule.add_mem _ (Submodule.mem_sup_right (Submodule.subset_span (by simp)))
          (Submodule.mem_sup_left hmem)
      · refine sup_le le_sup_left ?_
        rw [Submodule.span_le]
        intro x hx
        rw [Set.mem_singleton_iff] at hx
        have hsplit' : u L' = u L - (u L - u L') := by abel
        rw [hx, hsplit']
        exact Submodule.sub_mem _ (Submodule.mem_sup_right (Submodule.subset_span (by simp)))
          (Submodule.mem_sup_left hmem)
    have h1 : L = satLat (Λ ⊔ Submodule.span ℤ ({u L} : Set (ι → ℤ))) :=
      (numaux.eq_satLat_sup_span (Λ := Λ) (L := L) hΛ hL.2.1 hL.1 hL.2.2.1 (hu_mem L hL)
        (hu_not L hL)).symm
    have h2 : L' = satLat (Λ ⊔ Submodule.span ℤ ({u L'} : Set (ι → ℤ))) :=
      (numaux.eq_satLat_sup_span (Λ := Λ) (L := L') hΛ hL'.2.1 hL'.1 hL'.2.2.1 (hu_mem L' hL')
        (hu_not L' hL')).symm
    rw [h1, h2, hspan]
  have hbox : (fun L => fun j : Fin m => dotI (u L) (a j)) '' F ⊆
      {t : Fin m → ℤ | ∀ j, |(t j : ℝ)| ≤ S * lam (orthLat Λ) (j.1 + 1)} := by
    rintro t ⟨L, hL, rfl⟩
    intro j
    have h1 : |((dotI (u L) (a j) : ℤ) : ℝ)| ≤ eNorm (u L) * eNorm (a j) := abs_dotI_le _ _
    refine le_trans h1 ?_
    exact mul_le_mul (hu_norm L hL) (ha_norm j) (eNorm_nonneg _) (by linarith)
  have hboxfin : ({t : Fin m → ℤ | ∀ j, |(t j : ℝ)| ≤ S * lam (orthLat Λ) (j.1 + 1)}
      : Set (Fin m → ℤ)).Finite := by
    refine (Finset.finite_toSet (Fintype.piFinset (fun j : Fin m =>
      Finset.Icc (-(Nat.ceil (S * lam (orthLat Λ) (j.1 + 1)) : ℤ))
        (Nat.ceil (S * lam (orthLat Λ) (j.1 + 1)))))).subset ?_
    rintro t ht
    rw [Finset.mem_coe, Fintype.mem_piFinset]
    intro j
    rw [Finset.mem_Icc]
    have h := ht j
    have h2 : |((t j : ℤ) : ℝ)| ≤ ((Nat.ceil (S * lam (orthLat Λ) (j.1 + 1)) : ℤ) : ℝ) :=
      le_trans h (Nat.le_ceil _)
    have h4 := abs_le.mp h2
    exact ⟨by exact_mod_cast h4.1, by exact_mod_cast h4.2⟩
  have hcard1 : (F.ncard : ℝ) ≤
      (({t : Fin m → ℤ | ∀ j, |(t j : ℝ)| ≤ S * lam (orthLat Λ) (j.1 + 1)}.ncard : ℕ) : ℝ) := by
    have hmaps : ∀ L ∈ F, (fun j : Fin m => dotI (u L) (a j)) ∈
        {t : Fin m → ℤ | ∀ j, |(t j : ℝ)| ≤ S * lam (orthLat Λ) (j.1 + 1)} := by
      intro L hL j
      have h1 : |((dotI (u L) (a j) : ℤ) : ℝ)| ≤ eNorm (u L) * eNorm (a j) := abs_dotI_le _ _
      refine le_trans h1 ?_
      exact mul_le_mul (hu_norm L hL) (ha_norm j) (eNorm_nonneg _) (by linarith)
    have h := Set.ncard_le_ncard_of_injOn (fun L => fun j : Fin m => dotI (u L) (a j))
      hmaps hinj hboxfin
    exact_mod_cast h
  have hcard2 : (({t : Fin m → ℤ | ∀ j, |(t j : ℝ)| ≤ S * lam (orthLat Λ) (j.1 + 1)}.ncard
      : ℕ) : ℝ) ≤ ∏ j : Fin m, (2 * (S * lam (orthLat Λ) (j.1 + 1)) + 3) :=
    ncard_box_le m (fun j => S * lam (orthLat Λ) (j.1 + 1)) (fun j => by
      have h1 := lam_nonneg (orthLat Λ) (j.1 + 1)
      nlinarith [hS])
  have hprod : ∏ j : Fin m, (2 * (S * lam (orthLat Λ) (j.1 + 1)) + 3)
      ≤ 8 ^ m * S ^ m * (Kmk * detL (orthLat Λ)) := by
    have hstep : ∏ j : Fin m, (2 * (S * lam (orthLat Λ) (j.1 + 1)) + 3)
        ≤ ∏ j : Fin m, (8 * (S * lam (orthLat Λ) (j.1 + 1))) := by
      refine Finset.prod_le_prod₀ (f := fun j : Fin m => 2 * (S * lam (orthLat Λ) (j.1 + 1)) + 3)
        (g := fun j : Fin m => 8 * (S * lam (orthLat Λ) (j.1 + 1))) (fun j _ => by
          have h1 := lam_nonneg (orthLat Λ) (j.1 + 1)
          nlinarith [hS])
        (fun j _ => ?_)
      have h1 : 1 ≤ S * lam (orthLat Λ) (j.1 + 1) :=
        one_le_mul_of_one_le_of_one_le hS (lam_ge_one (orthLat Λ) (by omega) (by rw [hrm]; omega))
      linarith
    have hstep2 : ∏ j : Fin m, (8 * (S * lam (orthLat Λ) (j.1 + 1)))
        = 8 ^ m * (S ^ m * ∏ j : Fin m, lam (orthLat Λ) (j.1 + 1)) := by
      rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const,
        Finset.card_univ, Fintype.card_fin, Finset.prod_const, Finset.card_univ,
        Fintype.card_fin]
    have hstep3 : (∏ j : Fin m, lam (orthLat Λ) (j.1 + 1))
        ≤ Kmk * detL (orthLat Λ) := by
      have h := hKmk (orthLat Λ)
      rw [hrm] at h
      rwa [← Fin.prod_univ_eq_prod_range (fun j => lam (orthLat Λ) (j + 1)) m] at h
    rw [hstep2] at hstep
    refine hstep.trans ?_
    have h8 : (0:ℝ) ≤ 8 ^ m * S ^ m := by positivity
    calc 8 ^ m * (S ^ m * ∏ j : Fin m, lam (orthLat Λ) (j.1 + 1))
        = 8 ^ m * S ^ m * (∏ j : Fin m, lam (orthLat Λ) (j.1 + 1)) := by ring
      _ ≤ 8 ^ m * S ^ m * (Kmk * detL (orthLat Λ)) :=
          mul_le_mul_of_nonneg_left hstep3 h8
  refine le_trans hcard1 (le_trans hcard2 ?_)
  refine hprod.trans ?_
  rw [MDEstimates.orthLat_detL Λ hΛ]
  have hmle : m ≤ Fintype.card ι := by omega
  have hdet : 0 ≤ detL Λ := detL_nonneg Λ
  have h8m : (8:ℝ) ^ m ≤ 16 ^ Fintype.card ι := by
    calc (8:ℝ) ^ m ≤ 16 ^ m := pow_le_pow_left₀ (by norm_num) (by norm_num) m
      _ ≤ 16 ^ Fintype.card ι := pow_le_pow_right₀ (by norm_num) hmle
  have hbnd : 8 ^ m * S ^ m * (Kmk * detL Λ) ≤ 16 ^ Fintype.card ι * Kmk * S ^ m * detL Λ := by
    have h2 : (0:ℝ) ≤ S ^ m * (Kmk * detL Λ) := by
      have h3 : (0:ℝ) ≤ S ^ m := pow_nonneg (le_trans zero_le_one hS) m
      exact mul_nonneg h3 (mul_nonneg hKmk0 hdet)
    calc 8 ^ m * S ^ m * (Kmk * detL Λ) = 8 ^ m * (S ^ m * (Kmk * detL Λ)) := by ring
      _ ≤ 16 ^ Fintype.card ι * (S ^ m * (Kmk * detL Λ)) :=
          mul_le_mul_of_nonneg_right h8m h2
      _ = 16 ^ Fintype.card ι * Kmk * S ^ m * detL Λ := by ring
  have hSm : S ^ (Fintype.card ι - rk Λ) = S ^ m := by rw [hm]
  rw [hSm]
  exact hbnd

/-! ## The rank-two count -/

/-- The number of integer vectors of norm at most `X` is at most `(2X+3)^{n+1}`. -/
lemma ncard_norm_box_le (n : ℕ) {X : ℝ} (hX : 0 ≤ X) :
    (({v : Fin (n + 1) → ℤ | eNorm v ≤ X}.ncard : ℕ) : ℝ) ≤ (2 * X + 3) ^ (n + 1) := by
  have hsub : {v : Fin (n + 1) → ℤ | eNorm v ≤ X} ⊆
      {v : Fin (n + 1) → ℤ | ∀ j, |((v j : ℤ) : ℝ)| ≤ X} := fun v hv j =>
    le_trans (abs_coord_le_eNorm' v j) hv
  have hfin : ({v : Fin (n + 1) → ℤ | ∀ j, |((v j : ℤ) : ℝ)| ≤ X} : Set _).Finite := by
    refine (Finset.finite_toSet (Fintype.piFinset (fun _ : Fin (n + 1) =>
      Finset.Icc (-(Nat.ceil X : ℤ)) (Nat.ceil X)))).subset ?_
    intro v hv
    rw [Finset.mem_coe, Fintype.mem_piFinset]
    intro j
    rw [Finset.mem_Icc]
    have h := hv j
    have h2 : |((v j : ℤ) : ℝ)| ≤ ((Nat.ceil X : ℤ) : ℝ) := le_trans h (Nat.le_ceil X)
    have h4 := abs_le.mp h2
    exact ⟨by exact_mod_cast h4.1, by exact_mod_cast h4.2⟩
  have h1 : (({v : Fin (n + 1) → ℤ | eNorm v ≤ X}.ncard : ℕ) : ℝ) ≤
      (({v : Fin (n + 1) → ℤ | ∀ j, |((v j : ℤ) : ℝ)| ≤ X}.ncard : ℕ) : ℝ) := by
    exact_mod_cast Set.ncard_le_ncard hsub hfin
  refine h1.trans ?_
  have h2 := ncard_box_le (n + 1) (fun _ : Fin (n + 1) => X) (fun _ => hX)
  rwa [show (∏ _ : Fin (n + 1), (2 * X + 3)) = (2 * X + 3) ^ (n + 1) by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]] at h2

/-- **The paper's number-lattices bound at rank two.**  There is `K > 0` such that for all
`s : Fin 2 → ℝ` with `s j ≥ 1`, the number of primitive rank-two sublattices `L ⊆ ℤ^{n+1}` with
`λ_j(L) ≤ s j` is at most `K · s_0^{n+2} s_1^{n}`. -/
theorem numLattices2Mine (n : ℕ) (Kmk : ℝ) (hKmk0 : 0 ≤ Kmk)
    (hKmk : ∀ L : Submodule ℤ (Fin (n + 1) → ℤ),
      (∏ j ∈ Finset.range (rk L), lam L (j + 1)) ≤ Kmk * detL L) :
    ∃ K : ℝ, 0 < K ∧ ∀ s : Fin 2 → ℝ, (∀ j, 1 ≤ s j) →
      (({L : Submodule ℤ (Fin (n + 1) → ℤ) | IsPrimLat L ∧ rk L = 2 ∧
          ∀ j : Fin 2, lam L (j.1 + 1) ≤ s j}.ncard : ℝ)
        ≤ K * ∏ j : Fin 2, s j ^ (Fintype.card (Fin (n + 1)) + 3 - 2 * (j.1 + 1))) := by
  classical
  refine ⟨16 ^ (n + 1) * 5 ^ (n + 1) * (Kmk + 1), by positivity, ?_⟩
  intro s hs
  set s0 : ℝ := s 0 with hs0
  set s1 : ℝ := s 1 with hs1
  have hs0' : 1 ≤ s0 := hs 0
  have hs1' : 1 ≤ s1 := hs 1
  have hs0nn : 0 ≤ s0 := le_trans zero_le_one hs0'
  set T : Set (Submodule ℤ (Fin (n + 1) → ℤ)) :=
    {L | IsPrimLat L ∧ rk L = 2 ∧ ∀ j : Fin 2, lam L (j.1 + 1) ≤ s j} with hT
  have hprod : (∏ j : Fin 2, s j ^ (Fintype.card (Fin (n + 1)) + 3 - 2 * (j.1 + 1)))
      = s0 ^ (n + 2) * s1 ^ n := by
    rw [Fin.prod_univ_two]
    have e0 : Fintype.card (Fin (n + 1)) + 3 - 2 * (((0 : Fin 2)).1 + 1) = n + 2 := by
      rw [Fintype.card_fin]; norm_num
    have e1 : Fintype.card (Fin (n + 1)) + 3 - 2 * (((1 : Fin 2)).1 + 1) = n := by
      rw [Fintype.card_fin]; norm_num
    rw [e0, e1, ← hs0, ← hs1]
  rw [hprod]
  have hmain : (T.ncard : ℝ) ≤ 16 ^ (n + 1) * 5 ^ (n + 1) * Kmk * (s0 ^ (n + 2) * s1 ^ n) := by
    by_cases hTfin : T.Finite
    · have hwit : ∀ L ∈ T, ∃ f : Fin (n + 1) → ℤ, f ≠ 0 ∧ f ∈ L ∧ eNorm f ≤ s0 := by
        intro L hL
        obtain ⟨hLp, hLr, hLl⟩ := hL
        obtain ⟨f, hf_mem, hf_ind, hf_norm⟩ := FM.exists_indep_le_lam L
        have h2 : 0 < rk L := by rw [hLr]; norm_num
        refine ⟨f ⟨0, h2⟩, hf_ind.ne_zero ⟨0, h2⟩, hf_mem _, ?_⟩
        refine le_trans (hf_norm ⟨0, h2⟩) ?_
        have h := hLl 0
        rw [← hs0] at h
        simpa using h
      let g : (Submodule ℤ (Fin (n + 1) → ℤ)) → (Fin (n + 1) → ℤ) :=
        fun L => if h : L ∈ T then Classical.choose (hwit L h) else 0
      have hg_ne : ∀ L ∈ T, g L ≠ 0 := by
        intro L hL; simp only [g, dif_pos hL]; exact (Classical.choose_spec (hwit L hL)).1
      have hg_mem : ∀ L ∈ T, g L ∈ L := by
        intro L hL; simp only [g, dif_pos hL]; exact (Classical.choose_spec (hwit L hL)).2.1
      have hg_norm : ∀ L ∈ T, eNorm (g L) ≤ s0 := by
        intro L hL; simp only [g, dif_pos hL]; exact (Classical.choose_spec (hwit L hL)).2.2
      set B : Finset (Fin (n + 1) → ℤ) :=
        (Fintype.piFinset (fun _ : Fin (n + 1) =>
          Finset.Icc (-(Nat.ceil s0 : ℤ)) (Nat.ceil s0))).filter (fun f => eNorm f ≤ s0) with hB
      have hgB : ∀ L ∈ T, g L ∈ B := by
        intro L hL
        rw [hB]
        exact Finset.mem_filter.mpr
          ⟨mem_box_of_eNorm_le s0 (hg_norm L hL), hg_norm L hL⟩
      have hBcard : ((B.card : ℕ) : ℝ) ≤ (2 * s0 + 3) ^ (n + 1) := by
        have h1 : B.card ≤ (Fintype.piFinset (fun _ : Fin (n + 1) =>
            Finset.Icc (-(Nat.ceil s0 : ℤ)) (Nat.ceil s0))).card := by
          rw [hB]; exact Finset.card_filter_le _ _
        have h2 : (((Fintype.piFinset (fun _ : Fin (n + 1) =>
            Finset.Icc (-(Nat.ceil s0 : ℤ)) (Nat.ceil s0))).card : ℕ) : ℝ) ≤
            (2 * s0 + 3) ^ (n + 1) := by
          rw [Fintype.card_piFinset]
          push_cast
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          refine pow_le_pow_left₀ (by positivity) ?_ (n + 1)
          have := Nat.ceil_lt_add_one hs0nn
          rw [Int.card_Icc]
          have htn : ((Nat.ceil s0 : ℤ) + 1 - (-(Nat.ceil s0 : ℤ))).toNat
              = 2 * Nat.ceil s0 + 1 := by omega
          rw [htn]
          push_cast
          linarith
        exact (by exact_mod_cast h1 : ((B.card : ℕ) : ℝ) ≤
          (((Fintype.piFinset (fun _ : Fin (n + 1) =>
            Finset.Icc (-(Nat.ceil s0 : ℤ)) (Nat.ceil s0))).card : ℕ) : ℝ)).trans h2
      have hcover : T ⊆ ⋃ f ∈ (B : Set (Fin (n + 1) → ℤ)), (T ∩ {L | g L = f}) := by
        intro L hL
        exact Set.mem_iUnion.mpr ⟨g L, Set.mem_iUnion.mpr ⟨hgB L hL, hL, rfl⟩⟩
      have hunionfin : (⋃ f ∈ (B : Set (Fin (n + 1) → ℤ)), (T ∩ {L | g L = f})).Finite :=
        B.finite_toSet.biUnion fun f _ => hTfin.subset Set.inter_subset_left
      have hcard1 : (T.ncard : ℝ) ≤ ∑ f ∈ B, (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ) := by
        have h1 : T.ncard ≤ (⋃ f ∈ (B : Set (Fin (n + 1) → ℤ)), (T ∩ {L | g L = f})).ncard :=
          Set.ncard_le_ncard hcover hunionfin
        have h1R : (T.ncard : ℝ) ≤
            ((⋃ f ∈ (B : Set (Fin (n + 1) → ℤ)), (T ∩ {L | g L = f})).ncard : ℝ) := by
          exact_mod_cast h1
        have h2 : ((⋃ f ∈ (B : Set (Fin (n + 1) → ℤ)), (T ∩ {L | g L = f})).ncard : ℝ) ≤
            (((∑ f ∈ B, (T ∩ {L | g L = f}).ncard) : ℕ) : ℝ) := by
          exact_mod_cast ncard_biUnion_finset_le B (fun f => T ∩ {L | g L = f})
        have h3 : (((∑ f ∈ B, (T ∩ {L | g L = f}).ncard) : ℕ) : ℝ) =
            ∑ f ∈ B, (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ) := by push_cast; ring
        rw [h3] at h2
        exact h1R.trans h2
      have hfib : ∀ f ∈ B, (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ)
          ≤ 16 ^ (n + 1) * Kmk * s1 ^ n * s0 := by
        intro f hf
        have hf_norm : eNorm f ≤ s0 := by
          have hfB := hf
          rw [hB] at hfB
          exact (Finset.mem_filter.mp hfB).2
        by_cases hf0 : f = 0
        · have hempty : T ∩ {L | g L = f} = ∅ := by
            refine Set.eq_empty_iff_forall_notMem.mpr ?_
            rintro L hLmem
            rw [Set.mem_inter_iff] at hLmem
            exact hg_ne L hLmem.1 (by rw [hLmem.2, hf0])
          rw [hempty, Set.ncard_empty, Nat.cast_zero]
          have : (0 : ℝ) ≤ 16 ^ (n + 1) * Kmk * s1 ^ n * s0 := by positivity
          exact this
        · set Λ : Submodule ℤ (Fin (n + 1) → ℤ) :=
              satLat (Submodule.span ℤ ({f} : Set (Fin (n + 1) → ℤ))) with hΛdef
          have hΛprim : IsPrimLat Λ := isPrimLat_satLat _
          have hspan1 : Submodule.span ℤ (Set.range (fun _ : Fin 1 => f))
              = Submodule.span ℤ ({f} : Set (Fin (n + 1) → ℤ)) := by
            congr 1
            ext x
            simp
          have hind1 : LinearIndependent ℤ (fun _ : Fin 1 => f) := by
            rw [linearIndependent_unique_iff]
            exact hf0
          have hrkΛ : rk Λ = 1 := by
            rw [hΛdef, numaux.rk_satLat, ← hspan1, numaux.rk_span_eq hind1]
          have hsub : T ∩ {L | g L = f} ⊆
              {L : Submodule ℤ (Fin (n + 1) → ℤ) | Λ ≤ L ∧ IsPrimLat L ∧ rk L = rk Λ + 1 ∧
                lam L (rk Λ + 1) ≤ s1} := by
            rintro L hLmem
            rw [Set.mem_inter_iff] at hLmem
            have hL : L ∈ T := hLmem.1
            have hgL : g L = f := hLmem.2
            have hfL : f ∈ L := by
              rw [← hgL]
              exact hg_mem L hL
            obtain ⟨hLp, hLr, hLl⟩ := hL
            refine ⟨?_, hLp, by rw [hLr, hrkΛ], ?_⟩
            · rw [hΛdef]
              refine (satLat_mono ?_).trans (le_of_eq (satLat_eq_of_isPrimLat hLp))
              rw [Submodule.span_le]
              rintro x hx
              rw [Set.mem_singleton_iff] at hx
              exact hx ▸ hfL
            · have h := hLl 1
              have h' : lam L 2 ≤ s1 := by
                rw [hs1]
                simpa using h
              simpa [hrkΛ] using h'
          have hfin' : ({L : Submodule ℤ (Fin (n + 1) → ℤ) | Λ ≤ L ∧ IsPrimLat L ∧
              rk L = rk Λ + 1 ∧ lam L (rk Λ + 1) ≤ s1}).Finite := fiber_finite Λ hΛprim s1
          have h1 : (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ) ≤
              (({L : Submodule ℤ (Fin (n + 1) → ℤ) | Λ ≤ L ∧ IsPrimLat L ∧
                rk L = rk Λ + 1 ∧ lam L (rk Λ + 1) ≤ s1}).ncard : ℕ) := by
            exact_mod_cast Set.ncard_le_ncard hsub hfin'
          refine h1.trans ?_
          refine (fiberCountMine Kmk hKmk0 Λ hΛprim s1 hs1' hKmk).trans ?_
          have hdet : detL Λ ≤ s0 := by
            have h1 : detL Λ ≤ ∏ i ∈ Finset.range (rk Λ), lam Λ (i + 1) := FM.minkowski_lower Λ
            rw [hrkΛ] at h1
            simp only [Finset.range_one, Finset.prod_singleton] at h1
            have h2 : lam Λ 1 ≤ eNorm f := by
              refine lam_le_of_tuple (j := 1) (f := fun _ : Fin 1 => f) ?_ ?_ (eNorm_nonneg f)
                (fun _ => le_rfl)
              · intro k
                rw [hΛdef]
                exact le_satLat _ (Submodule.subset_span (by simp))
              · rw [linearIndependent_unique_iff]; exact hf0
            linarith
          have hexp : Fintype.card (Fin (n + 1)) - rk Λ = n := by
            rw [hrkΛ, Fintype.card_fin]; omega
          rw [hexp, Fintype.card_fin]
          exact mul_le_mul_of_nonneg_left hdet (by positivity)
      have h4 : (∑ f ∈ B, (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ)) ≤
          ∑ f ∈ B, (16 ^ (n + 1) * Kmk * s1 ^ n * s0) := Finset.sum_le_sum hfib
      have h5 : (∑ f ∈ B, (16 ^ (n + 1) * Kmk * s1 ^ n * s0))
          = (B.card : ℝ) * (16 ^ (n + 1) * Kmk * s1 ^ n * s0) := by
        rw [Finset.sum_const, nsmul_eq_mul]
      have h6 : (B.card : ℝ) ≤ 5 ^ (n + 1) * s0 ^ (n + 1) := by
        refine hBcard.trans ?_
        have hle : 2 * s0 + 3 ≤ 5 * s0 := by linarith
        calc (2 * s0 + 3) ^ (n + 1) ≤ (5 * s0) ^ (n + 1) :=
              pow_le_pow_left₀ (by linarith) hle _
          _ = 5 ^ (n + 1) * s0 ^ (n + 1) := by rw [mul_pow]
      have h7 : (0 : ℝ) ≤ 16 ^ (n + 1) * Kmk * s1 ^ n * s0 := by positivity
      calc (T.ncard : ℝ) ≤ ∑ f ∈ B, (((T ∩ {L | g L = f}).ncard : ℕ) : ℝ) := hcard1
        _ ≤ ∑ f ∈ B, (16 ^ (n + 1) * Kmk * s1 ^ n * s0) := h4
        _ = (B.card : ℝ) * (16 ^ (n + 1) * Kmk * s1 ^ n * s0) := h5
        _ ≤ (5 ^ (n + 1) * s0 ^ (n + 1)) * (16 ^ (n + 1) * Kmk * s1 ^ n * s0) :=
            mul_le_mul_of_nonneg_right h6 h7
        _ = 16 ^ (n + 1) * 5 ^ (n + 1) * Kmk * (s0 ^ (n + 2) * s1 ^ n) := by ring
    · have hzero : T.ncard = 0 := Set.Infinite.ncard hTfin
      rw [hzero, Nat.cast_zero]
      positivity
  have hle : 16 ^ (n + 1) * 5 ^ (n + 1) * Kmk ≤ 16 ^ (n + 1) * 5 ^ (n + 1) * (Kmk + 1) :=
    mul_le_mul_of_nonneg_left (by linarith) (by positivity)
  exact hmain.trans (mul_le_mul_of_nonneg_right hle (by positivity))

end Work.HP.EEupper
