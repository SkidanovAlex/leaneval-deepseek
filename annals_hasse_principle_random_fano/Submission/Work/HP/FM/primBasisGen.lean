import Mathlib
import Submission.Work.HP.Defs
import Submission.Work.HP.FM.RecDefs
import Submission.Work.HP.Lat.prim_bezout

/-!
# Completing a primitive integer vector to a `ℤ`-basis

For a primitive vector `u : Fin R → ℤ` (i.e. `Finset.univ.gcd u = 1`) there is a family
`v : Fin (R-1) → (Fin R → ℤ)` such that `(u, v₀, …, v_{R-2})` is a `ℤ`-basis of `ℤ^R`; equivalently
the map `(a, t) ↦ a • u + ∑ i, t i • v i` is a bijection `ℤ × ℤ^{R-1} → ℤ^R`.

Since a `ℤ`-basis of `ℤ^R` is also an `ℝ`-basis of `ℝ^R`, the `ℝ`-linear map
`(a, t) ↦ a • u_ℝ + ∑ i, t i • vᵢ_ℝ` is injective as well.

The construction: `ℤu ⊆ ℤ^R` is a rank-one submodule; taking the Smith normal form of the pair
`(ℤ^R, ℤu)` produces a `ℤ`-basis `bM` of `ℤ^R` together with an index `f 0` and an integer `a 0`
such that `u = γ • bM (f 0)` for a unit `γ` (the unit is exactly primitivity of `u`: the Smith
coefficient `a 0` cannot have a prime factor, by Bézout).  Reindexing `bM` so that `f 0` becomes
the index `0` and adjusting the sign gives a basis `b'` with `b' 0 = u`; then
`v i := b' (Fin.succ i)`.
-/

set_option autoImplicit false

noncomputable section

open Finset
open scoped BigOperators

namespace Work.HP.FM

/-- Recasting an integer linear combination of integer vectors, entrywise. -/
lemma primBasisGen_cast_sum_smul {ι : Type*} [Fintype ι] {N : ℕ} (t : ι → ℤ)
    (v : ι → (Fin N → ℤ)) :
    (fun k => ((∑ j, t j • v j) k : ℝ)) = ∑ j, (t j : ℝ) • (fun k => (v j k : ℝ)) := by
  ext k
  simp [Finset.sum_apply, Pi.smul_apply]

/-- The `n + 1`-indexed form of the statement: a primitive vector in `ℤ^{n+1}` is the first
element of a `ℤ`-basis. -/
lemma primBasisGen_aux {n : ℕ} (u : Fin (n + 1) → ℤ) (hu : Work.HP.IsPrim u) :
    ∃ v : Fin n → (Fin (n + 1) → ℤ),
      Function.Bijective (fun c : ℤ × (Fin n → ℤ) => c.1 • u + ∑ i, c.2 i • v i) ∧
      (∀ c : ℝ × (Fin n → ℝ),
        c.1 • (fun j => (u j : ℝ)) + ∑ i, c.2 i • (fun j => (v i j : ℝ)) = 0 → c = 0) := by
  classical
  -- `u` is nonzero, since otherwise its gcd would be `0`.
  have hu_ne : u ≠ 0 := by
    intro h
    obtain ⟨w, hw⟩ := Work.HP.Lat.prim_bezout u hu
    rw [h] at hw
    simp at hw
  -- The rank-one submodule generated by `u`.
  set N : Submodule ℤ (Fin (n + 1) → ℤ) := Submodule.span ℤ {u} with hN
  have huN : u ∈ N := Submodule.subset_span (Set.mem_singleton u)
  -- Smith normal form of the pair `(ℤ^{n+1}, ℤu)`.
  obtain ⟨k, snf⟩ := Submodule.smithNormalForm (Pi.basisFun ℤ (Fin (n + 1))) N
  -- `N` is free of rank one, so `k = 1`.
  have hk : k = 1 := by
    have hpos : 1 ≤ k := by
      rcases Nat.eq_zero_or_pos k with hk | hk
      · exfalso
        have hsum0 : (∑ i : Fin k, (snf.bN.repr ⟨u, huN⟩) i • snf.bN i) = 0 := by
          refine Finset.sum_eq_zero (fun i _ => ?_)
          exfalso
          have hi := i.isLt
          omega
        have h := Module.Basis.sum_repr snf.bN (⟨u, huN⟩ : N)
        have h0 : (⟨u, huN⟩ : N) = 0 := by rw [← h, hsum0]
        exact hu_ne (by simpa using congrArg Subtype.val h0)
      · exact hk
    have hle : k ≤ 1 := by
      by_contra hcon
      have hk2 : 2 ≤ k := by omega
      -- any two elements of `N = ℤu` are `ℤ`-linearly dependent, so a basis of `N` cannot
      -- have two elements.
      let i0 : Fin k := ⟨0, by omega⟩
      let i1 : Fin k := ⟨1, by omega⟩
      have hi01 : i0 ≠ i1 := by
        intro hh
        exact absurd (congrArg Fin.val hh) (by simp [i0, i1])
      obtain ⟨c0, hc0⟩ := (Submodule.mem_span_singleton).mp
        (show ((snf.bN i0 : N) : Fin (n + 1) → ℤ) ∈ ℤ ∙ u from by
          rw [← hN]; exact (snf.bN i0).2)
      obtain ⟨c1, hc1⟩ := (Submodule.mem_span_singleton).mp
        (show ((snf.bN i1 : N) : Fin (n + 1) → ℤ) ∈ ℤ ∙ u from by
          rw [← hN]; exact (snf.bN i1).2)
      have hb0 : c0 • (⟨u, huN⟩ : N) = snf.bN i0 := Subtype.ext (by simpa using hc0)
      have hb1 : c1 • (⟨u, huN⟩ : N) = snf.bN i1 := Subtype.ext (by simpa using hc1)
      have hkey : c1 • snf.bN i0 - c0 • snf.bN i1 = 0 := by
        rw [← hb0, ← hb1, smul_smul, smul_smul, mul_comm c1 c0, sub_self]
      have hrepr := congrArg snf.bN.repr hkey
      simp only [map_sub, map_smul, map_zero, Module.Basis.repr_self] at hrepr
      have e0 := congrArg (fun g : Fin k →₀ ℤ => g i0) hrepr
      have e1 := congrArg (fun g : Fin k →₀ ℤ => g i1) hrepr
      simp only [Finsupp.sub_apply, Finsupp.smul_apply, Finsupp.zero_apply, smul_eq_mul,
        Finsupp.single_eq_same, Finsupp.single_eq_of_ne hi01,
        Finsupp.single_eq_of_ne (Ne.symm hi01)] at e0 e1
      have hc0z : c0 = 0 := by linarith [e1]
      have hc1z : c1 = 0 := by linarith [e0]
      have hz := Module.Basis.ne_zero snf.bN i0
      rw [← hb0, hc0z, zero_smul] at hz
      exact hz rfl
    omega
  subst hk
  -- `u` in the coordinates of the rank-one basis `snf.bN`.
  set c : ℤ := (snf.bN.repr ⟨u, huN⟩) 0 with hc
  have hcu : c • snf.bN 0 = (⟨u, huN⟩ : N) := by
    have h := Module.Basis.sum_repr snf.bN (⟨u, huN⟩ : N)
    rw [Fin.sum_univ_one] at h
    rw [← hc] at h
    exact h
  have hcu' : c • ((snf.bN 0 : N) : Fin (n + 1) → ℤ) = u := by
    have h := congrArg Subtype.val hcu
    simpa using h
  -- `u` is the Smith coefficient `a 0` times the basis vector `bM (f 0)`.
  have hu_eq : u = (c * snf.a 0) • snf.bM (snf.f 0) := by
    conv_lhs => rw [← hcu']
    rw [snf.snf 0, smul_smul]
  -- Primitivity of `u` forces this coefficient to be a unit.
  obtain ⟨w, hw⟩ := Work.HP.Lat.prim_bezout u hu
  have hS : (c * snf.a 0) * (∑ j, w j * (snf.bM (snf.f 0)) j) = 1 := by
    rw [← hw, hu_eq, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    simp only [Pi.smul_apply, smul_eq_mul]
    ring
  have hunit : IsUnit (c * snf.a 0) :=
    ⟨⟨_, _, hS, by rw [mul_comm]; exact hS⟩, rfl⟩
  -- Move the basis vector `bM (f 0)` to position `0` and correct the sign, obtaining a basis
  -- whose `0`-th vector is `u`.
  let b'' : Module.Basis (Fin (n + 1)) ℤ (Fin (n + 1) → ℤ) :=
    snf.bM.reindex (Equiv.swap 0 (snf.f 0))
  have hb''0 : b'' 0 = snf.bM (snf.f 0) := by
    show (snf.bM.reindex (Equiv.swap 0 (snf.f 0))) 0 = snf.bM (snf.f 0)
    rw [Module.Basis.reindex_apply]
    congr 1
  let b' : Module.Basis (Fin (n + 1)) ℤ (Fin (n + 1) → ℤ) :=
    b''.unitsSMul (fun i => if i = 0 then IsUnit.unit hunit else 1)
  have hb'0 : b' 0 = u := by
    rw [Module.Basis.unitsSMul_apply]
    simp only [↓reduceIte, hb''0]
    exact hu_eq.symm
  -- `Fin.cons` is the inverse of the coordinate splitting along the basis `b'`.
  have hce : ∀ c : ℤ × (Fin n → ℤ),
      (Fin.consEquiv (fun _ : Fin (n + 1) => ℤ)) c
        = Fin.cons (α := fun _ : Fin (n + 1) => ℤ) c.1 c.2 :=
    fun c => funext fun i => Fin.consEquiv_apply (fun _ : Fin (n + 1) => ℤ) c i
  refine ⟨fun i : Fin n => b' (Fin.succ i), ?_, ?_⟩
  · -- Bijectivity over `ℤ`: the map is the coordinate map of the basis `b'`.
    have hfun : (fun c : ℤ × (Fin n → ℤ) => c.1 • u + ∑ i, c.2 i • b' (Fin.succ i))
        = fun c => b'.equivFun.symm ((Fin.consEquiv (fun _ : Fin (n + 1) => ℤ)) c) := by
      funext c
      rw [Module.Basis.equivFun_symm_apply, hce c, Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.cons_succ, hb'0]
    rw [hfun]
    exact (b'.equivFun.symm).bijective.comp (Fin.consEquiv _).bijective
  · -- `ℝ`-linear independence: a `ℤ`-basis of `ℤ^{n+1}` is an `ℝ`-basis of `ℝ^{n+1}`.
    intro c hc
    let w : Fin (n + 1) → (Fin (n + 1) → ℝ) := fun j k => ((b' j) k : ℝ)
    have hw0 : w 0 = (fun j => (u j : ℝ)) := by
      funext k
      simp [w, hb'0]
    have hws : ∀ i : Fin n, w (Fin.succ i) = (fun j => ((b' (Fin.succ i)) j : ℝ)) :=
      fun _ => rfl
    have hψ : (Fintype.linearCombination ℝ w)
        (Fin.cons (α := fun _ : Fin (n + 1) => ℝ) c.1 c.2) = 0 := by
      rw [Fintype.linearCombination_apply, Fin.sum_univ_succ]
      simp only [Fin.cons_zero, Fin.cons_succ, hw0, hws]
      exact hc
    -- The range of the linear combination map contains the standard basis, hence everything.
    have hsurj : Function.Surjective (Fintype.linearCombination ℝ w) := by
      rw [← LinearMap.range_eq_top]
      have hstd : Submodule.span ℝ
          (Set.range (fun k : Fin (n + 1) => (Pi.single k (1 : ℝ) : Fin (n + 1) → ℝ)))
          ≤ (Fintype.linearCombination ℝ w).range := by
        rw [Submodule.span_le]
        rintro x ⟨k, rfl⟩
        refine ⟨fun j => ((b'.repr (Pi.single k (1 : ℤ)) j : ℤ) : ℝ), ?_⟩
        rw [Fintype.linearCombination_apply, ← primBasisGen_cast_sum_smul, Module.Basis.sum_repr]
        ext i
        simp [Pi.single_apply]
      have htop : Submodule.span ℝ
          (Set.range (fun k : Fin (n + 1) => (Pi.single k (1 : ℝ) : Fin (n + 1) → ℝ))) = ⊤ := by
        rw [← (Pi.basisFun ℝ (Fin (n + 1))).span_eq]
        congr 1
        ext x
        simp [Pi.basisFun_apply]
      exact top_le_iff.mp (htop ▸ hstd)
    have hinj : Function.Injective (Fintype.linearCombination ℝ w) :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
        (f := Fintype.linearCombination ℝ w) rfl).mpr hsurj
    -- Conclude `c = 0` from the injectivity.
    have hcons : Fin.cons (α := fun _ : Fin (n + 1) => ℝ) c.1 c.2 = 0 := by
      apply hinj
      rw [hψ, map_zero]
    have hc1 : c.1 = 0 := by
      have hh := congrFun hcons 0
      simpa using hh
    have hc2 : c.2 = 0 := by
      funext i
      have hh := congrFun hcons (Fin.succ i)
      simpa using hh
    exact Prod.ext hc1 hc2

theorem primBasisGen {R : ℕ} (hR : 1 ≤ R) (u : Fin R → ℤ) (hu : Work.HP.IsPrim u) :
    ∃ v : Fin (R - 1) → (Fin R → ℤ),
      Function.Bijective (fun c : ℤ × (Fin (R - 1) → ℤ) => c.1 • u + ∑ i, c.2 i • v i) ∧
      (∀ c : ℝ × (Fin (R - 1) → ℝ),
        c.1 • (fun j => (u j : ℝ)) + ∑ i, c.2 i • (fun j => (v i j : ℝ)) = 0 → c = 0) := by
  obtain ⟨n, rfl⟩ : ∃ n, R = n + 1 := ⟨R - 1, by omega⟩
  exact primBasisGen_aux u hu

end Work.HP.FM
