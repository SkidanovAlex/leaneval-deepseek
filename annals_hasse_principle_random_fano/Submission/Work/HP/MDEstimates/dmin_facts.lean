import Mathlib
import Submission.Work.HP.Defs
import Submission.Work.HP.PairsAux
import Submission.Work.HP.HPgram
import Submission.Work.HP.Lat.detL_basis_gram
import Submission.Work.HP.Q44Child.snoc_linIndep
import Submission.Work.HP.MDEstimates.detL_one_le
import Submission.Work.HP.MDEstimates.detL_span_fin2_le
import Submission.Work.HP.MDEstimates.detL_span_fin3_le

/-!
# The basic facts about `𝔡_r(x,y) = Work.HP.dmin r {x,y}`

Browning--Le Boudec--Sawin use, for `r = 2, 3` and `ℤ`-linearly independent `x, y ∈ ℤ^{n+1}`,

* `𝔡_r(x,y) ≥ 1`  (every integral lattice has covolume at least `1`), and
* `𝔡_2(x,y) ≤ ‖x‖‖y‖`, `𝔡_3(x,y) ≤ ‖x‖‖y‖`  (a lattice generated by `x, y` — and, for `r = 3`,
  by `x, y` together with one extra coordinate vector — has covolume at most the product of the
  generator norms, by Hadamard's inequality).

The two Hadamard bounds are delegated (`detL_span_fin2_le`, `detL_span_fin3_le`); here we glue
them to the definition of `dmin` as an infimum of covolumes.
-/

set_option autoImplicit false

noncomputable section

namespace Work.HP.MDEstimates

open Work.HP

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The set whose infimum defines `dmin r S` is bounded below by `0`. -/
lemma bddBelow_dminSet (r : ℕ) (S : Set (ι → ℤ)) :
    BddBelow {D : ℝ | ∃ L : Submodule ℤ (ι → ℤ), rk L = r ∧ S ⊆ L ∧ detL L = D} :=
  ⟨0, fun _ hD => by obtain ⟨L, -, -, rfl⟩ := hD; exact detL_nonneg_gram L⟩

/-- `1 ≤ dmin r S` as soon as some rank-`r` lattice contains `S`, since every integral lattice
has covolume at least `1`. -/
lemma one_le_dmin_of_exists {r : ℕ} {S : Set (ι → ℤ)}
    (h : ∃ L : Submodule ℤ (ι → ℤ), rk L = r ∧ S ⊆ L) : 1 ≤ dmin r S := by
  rw [dmin]
  obtain ⟨L, hrk, hsub⟩ := h
  refine le_csInf ⟨detL L, ⟨L, hrk, hsub, rfl⟩⟩ ?_
  rintro D ⟨L', -, -, rfl⟩
  exact detL_one_le L'

/-- `dmin r S` is at most the covolume of any rank-`r` lattice containing `S`. -/
private lemma dmin_le_detL {r : ℕ} {S : Set (ι → ℤ)} {L : Submodule ℤ (ι → ℤ)}
    (hrk : rk L = r) (hS : S ⊆ L) : dmin r S ≤ detL L := by
  rw [dmin]
  exact csInf_le (bddBelow_dminSet r S) ⟨L, hrk, hS, rfl⟩

lemma mem_pair {α : Type*} (a b z : α) : z ∈ ({a, b} : Set α) ↔ z = a ∨ z = b := by simp

/-- A standard basis vector has Euclidean norm `1`. -/
lemma eNorm_single_one {ι : Type*} [Fintype ι] [DecidableEq ι] (i : ι) :
    eNorm (Pi.single i (1 : ℤ) : ι → ℤ) = 1 := by
  rw [eNorm]
  have h : ∑ j, (((Pi.single i (1 : ℤ) : ι → ℤ) j : ℝ)) ^ 2 = 1 := by
    rw [Finset.sum_eq_single i]
    · simp
    · intro b _ hb; simp [Pi.single_eq_of_ne hb]
    · intro hi; exact absurd (Finset.mem_univ i) hi
  rw [h, Real.sqrt_one]

/-- For `n ≥ 2` and `ℤ`-linearly independent `x, y ∈ ℤ^{n+1}` there is a rank-`3` lattice
containing both whose covolume is at most `‖x‖‖y‖`: the span of `x`, `y` and a suitable
standard basis vector. -/
lemma exists_rank3_lat_le {n : ℕ} (hn : 2 ≤ n) (x y : Fin (n + 1) → ℤ)
    (hxy : LinearIndependent ℤ ![x, y]) :
    ∃ L : Submodule ℤ (Fin (n + 1) → ℤ), rk L = 3 ∧
      ({x, y} : Set (Fin (n + 1) → ℤ)) ⊆ L ∧ detL L ≤ eNorm x * eNorm y := by
  classical
  -- an injection `Fin 3 → Fin (n+1)`, used to produce three independent coordinate vectors
  let emb : Fin 3 → Fin (n + 1) := fun t => ⟨t.1, by have := t.2; omega⟩
  have hemb : Function.Injective emb :=
    fun a b h => Fin.ext (by simpa [emb] using congrArg Fin.val h)
  have hgLI : LinearIndependent ℤ
      (fun t : Fin 3 => (Pi.single (emb t) (1 : ℤ) : Fin (n + 1) → ℤ)) := by
    have h := (Pi.basisFun ℤ (Fin (n + 1))).linearIndependent.comp emb hemb
    simpa [Function.comp_def, Pi.basisFun_apply] using h
  obtain ⟨i, hi⟩ := Work.HP.Q44Child.snoc_linIndep (k := 2)
    (f := (![x, y] : Fin 2 → (Fin (n + 1) → ℤ)))
    (g := fun t : Fin 3 => (Pi.single (emb t) (1 : ℤ) : Fin (n + 1) → ℤ)) hxy hgLI
  let v : Fin 3 → (Fin (n + 1) → ℤ) := Fin.snoc ![x, y] (Pi.single (emb i) (1 : ℤ))
  have hvLI : LinearIndependent ℤ v := hi
  have hv0 : v 0 = x := by simp [v]
  have hv1 : v 1 = y := by simp [v]
  have hv2 : eNorm (v 2) = 1 := by
    have h2 : v 2 = (Pi.single (emb i) (1 : ℤ) : Fin (n + 1) → ℤ) := by simp [v]
    rw [h2, eNorm_single_one]
  refine ⟨Submodule.span ℤ (Set.range v), ?_, ?_, ?_⟩
  · rw [rk, finrank_span_eq_card hvLI]; rfl
  · intro z hz
    rw [mem_pair] at hz
    rcases hz with rfl | rfl
    · exact Submodule.subset_span ⟨0, hv0⟩
    · exact Submodule.subset_span ⟨1, hv1⟩
  · have h := detL_span_fin3_le (v := v) hvLI
    rw [hv0, hv1, hv2] at h
    simpa using h

theorem dmin_facts (n : ℕ) (hn : 2 ≤ n) :
    (∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] → 1 ≤ Work.HP.dmin 2 {x, y}) ∧
    (∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] →
      Work.HP.dmin 2 {x, y} ≤ Work.HP.eNorm x * Work.HP.eNorm y) ∧
    (∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] → 1 ≤ Work.HP.dmin 3 {x, y}) ∧
    (∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] →
      Work.HP.dmin 3 {x, y} ≤ Work.HP.eNorm x * Work.HP.eNorm y) := by
  -- the rank-`2` witness: the span of `x` and `y`
  have key2 : ∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] →
      ∃ L : Submodule ℤ (Fin (n + 1) → ℤ), rk L = 2 ∧
        ({x, y} : Set (Fin (n + 1) → ℤ)) ⊆ L ∧ detL L ≤ eNorm x * eNorm y := by
    intro x y hxy
    refine ⟨Submodule.span ℤ (Set.range (![x, y] : Fin 2 → (Fin (n + 1) → ℤ))), ?_, ?_, ?_⟩
    · rw [rk, finrank_span_eq_card hxy]; rfl
    · intro z hz
      rw [mem_pair] at hz
      rcases hz with rfl | rfl
      · exact Submodule.subset_span (Set.mem_range_self 0)
      · exact Submodule.subset_span (Set.mem_range_self 1)
    · have h := detL_span_fin2_le (v := (![x, y] : Fin 2 → (Fin (n + 1) → ℤ))) hxy
      simpa using h
  -- the rank-`3` witness
  have key3 : ∀ x y : Fin (n + 1) → ℤ, LinearIndependent ℤ ![x, y] →
      ∃ L : Submodule ℤ (Fin (n + 1) → ℤ), rk L = 3 ∧
        ({x, y} : Set (Fin (n + 1) → ℤ)) ⊆ L ∧ detL L ≤ eNorm x * eNorm y :=
    fun x y hxy => exists_rank3_lat_le hn x y hxy
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro x y hxy
    obtain ⟨L, hrk, hsub, -⟩ := key2 x y hxy
    exact one_le_dmin_of_exists ⟨L, hrk, hsub⟩
  · intro x y hxy
    obtain ⟨L, hrk, hsub, hdet⟩ := key2 x y hxy
    exact (dmin_le_detL hrk hsub).trans hdet
  · intro x y hxy
    obtain ⟨L, hrk, hsub, -⟩ := key3 x y hxy
    exact one_le_dmin_of_exists ⟨L, hrk, hsub⟩
  · intro x y hxy
    obtain ⟨L, hrk, hsub, hdet⟩ := key3 x y hxy
    exact (dmin_le_detL hrk hsub).trans hdet

end Work.HP.MDEstimates
