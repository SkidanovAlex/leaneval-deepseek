import Mathlib
import Submission.Work.HP.Defs
import Submission.Work.HP.NA.Setup

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# Primitivity over `ℤ` reduces to primitivity modulo `W`

If the integer coefficient vector `a : Mon d n → ℤ` is primitive, i.e. the gcd of its
coordinates is `1`, then its reduction `(a m : ZMod W)` generates the unit ideal of `ZMod W`.

The key ingredient is Bézout's identity, obtained by induction over the (finite) index set:
the gcd of a finite family of integers is an integer linear combination of the family.
Reducing such a linear combination modulo `W` exhibits `1` inside the ideal generated by the
reductions, whence that ideal is everything.
-/

set_option autoImplicit false

namespace Work.HP.NA

/-- **Bézout's identity for a finite family of integers.**  The gcd of the values `f i` over a
finite set `s` is an integral linear combination `∑ i ∈ s, c i * f i` of those values. -/
theorem exists_sum_eq_finsetGcd {ι : Type*} (s : Finset ι) (f : ι → ℤ) :
    ∃ c : ι → ℤ, ∑ i ∈ s, c i * f i = s.gcd f := by
  classical
  induction s using Finset.induction with
  | empty => exact ⟨fun _ => 0, by simp⟩
  | insert b t hbt ih =>
    obtain ⟨c, hc⟩ := ih
    obtain ⟨u, v, huv⟩ := exists_gcd_eq_mul_add_mul (f b) (t.gcd f)
    refine ⟨fun i => if i = b then u else v * c i, ?_⟩
    have hsum : ∑ i ∈ t, (if i = b then (u : ℤ) else v * c i) * f i
        = v * ∑ i ∈ t, c i * f i := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hib : i ≠ b := fun h => hbt (h ▸ hi)
      rw [ite_eq_right hib]
      ring
    rw [Finset.sum_insert hbt, Finset.gcd_insert, hsum, hc, huv, mul_comm (f b) u]
    dsimp only
    rw [ite_eq_left rfl]
    ring

theorem isPrimGen_intCast_of_isPrim {d n W : ℕ} (a : Work.HP.Mon d n → ℤ) (h : Work.HP.IsPrim a) :
    Work.HP.NA.IsPrimGen W (fun m => (a m : ZMod W)) := by
  classical
  obtain ⟨c, hc⟩ := exists_sum_eq_finsetGcd (Finset.univ : Finset (Mon d n)) a
  -- Bézout identity in `ℤ`: `1` is an integral combination of the coordinates of `a`.
  have hc1 : ∑ m : Mon d n, c m * a m = 1 := hc.trans h
  -- Reduce the identity modulo `W`.
  have hsum : ∑ m : Mon d n, (c m : ZMod W) * (a m : ZMod W) = 1 := by
    have := congrArg (fun z : ℤ => (z : ZMod W)) hc1
    push_cast at this
    simpa using this
  rw [Work.HP.NA.IsPrimGen, Ideal.eq_top_iff_one, ← hsum]
  exact Submodule.sum_mem _ (fun m _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨m, rfl⟩))

end Work.HP.NA
