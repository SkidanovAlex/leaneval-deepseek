import Mathlib
import Submission.Work.HP.NA.Setup

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# Primitivity modulo a product of pairwise coprime moduli

`Work.HP.NA.IsPrimGen Q a` says that the ideal generated by the coordinates of `a` is the whole
ring `ZMod Q`.  For pairwise coprime `Q : ι → ℕ`, the Chinese remainder theorem provides a ring
equivalence `ZMod (∏ i, Q i) ≃+* ∀ i, ZMod (Q i)`; we show that primitivity is detected
coordinatewise:

`IsPrimGen (∏ i, Q i) a ↔ ∀ i, IsPrimGen (Q i) (fun j => ZMod.prodEquivPi Q hQ (a j) i)`.

Two independent facts about arbitrary rings do the work.

* `span_range_ringEquiv_eq_top_iff_aux`: a ring equivalence preserves the property that the range
  of a family generates the unit ideal.

* `span_range_pi_eq_top_iff_aux`: for a *finite* product of rings `∀ i, R i`, a family spans the
  unit ideal iff each of its coordinate projections does.  (Finiteness is essential: for `ℕ` many
  copies of `ℤ` the unit vectors span a proper direct sum.)  The easy direction pushes forward
  along the surjective projection `Pi.evalRingHom`; for the converse, if the projection of `I`
  onto the `i`-th factor is everything, some `y ∈ I` has `y i = 1`, and then
  `Pi.single i 1 = Pi.single i 1 * y ∈ I`; since the idempotents `Pi.single i 1` generate the unit
  ideal (`Ideal.span_single_eq_top`), `I` is everything.
-/

set_option autoImplicit false

namespace Work.HP.NA

/-- A ring equivalence preserves the property that the range of a family generates the unit
ideal: `Ideal.span` and `Ideal.map` commute, and `Ideal.map e I = ⊤ ↔ I = ⊤` for a bijective
ring map. -/
private lemma span_range_ringEquiv_eq_top_iff_aux {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) {J : Type*} (a : J → R) :
    Ideal.span (Set.range a) = ⊤ ↔ Ideal.span (Set.range (fun j => e (a j))) = ⊤ := by
  have key : Ideal.span (Set.range (fun j => e (a j)))
      = Ideal.map (e : R →+* S) (Ideal.span (Set.range a)) := by
    rw [Ideal.map_span]
    congr 1
    rw [← Set.range_comp]
    rfl
  rw [key]
  constructor
  · intro h; rw [h, Ideal.map_top]
  · intro h
    rw [Ideal.eq_top_iff_one]
    have h1 : (1 : S) ∈ Ideal.map (e : R →+* S) (Ideal.span (Set.range a)) := by
      rw [h]; exact Submodule.mem_top
    obtain ⟨x, hx, hx1⟩ := (Ideal.mem_map_iff_of_surjective (e : R →+* S) e.surjective).mp h1
    have hxA : (e : R → S) x = 1 := hx1
    have hx2 : x = 1 := by
      apply e.injective
      rw [hxA, map_one e]
    rw [hx2] at hx
    exact hx

/-- In a finite product of commutative rings, a family generates the unit ideal iff each of its
coordinate projections does. -/
private lemma span_range_pi_eq_top_iff_aux {ι J : Type*} [Fintype ι] {R : ι → Type*}
    [∀ i, CommRing (R i)] (f : J → (∀ i, R i)) :
    Ideal.span (Set.range f) = ⊤ ↔ ∀ i, Ideal.span (Set.range (fun j => f j i)) = ⊤ := by
  classical
  have hmap_eq : ∀ i, Ideal.map (Pi.evalRingHom R i) (Ideal.span (Set.range f))
      = Ideal.span (Set.range (fun j => f j i)) := by
    intro i
    rw [Ideal.map_span]
    congr 1
    rw [← Set.range_comp]
    rfl
  constructor
  · intro h i
    rw [← hmap_eq i, h, Ideal.map_top]
  · intro h
    have hmem : ∀ i, ∃ y ∈ Ideal.span (Set.range f), y i = 1 := by
      intro i
      have h1 : (1 : R i) ∈ Ideal.map (Pi.evalRingHom R i) (Ideal.span (Set.range f)) := by
        rw [hmap_eq i, h i]; exact Submodule.mem_top
      obtain ⟨y, hy, hy1⟩ := (Ideal.mem_map_iff_of_surjective (Pi.evalRingHom R i)
        (fun x => ⟨Pi.single i x, Pi.single_eq_same i x⟩)).mp h1
      exact ⟨y, hy, hy1⟩
    have hsingle : ∀ i, (Pi.single i (1 : R i) : (∀ i, R i)) ∈ Ideal.span (Set.range f) := by
      intro i
      obtain ⟨y, hy, hy1⟩ := hmem i
      have heq : (Pi.single i (1 : R i) : (∀ i, R i)) * y = Pi.single i (1 : R i) := by
        funext k
        rw [Pi.mul_apply]
        rcases eq_or_ne k i with rfl | hk
        · rw [Pi.single_eq_same, hy1, mul_one]
        · rw [Pi.single_eq_of_ne hk, zero_mul]
      rw [← heq]
      exact Ideal.mul_mem_left _ _ hy
    have hle : Ideal.span (Set.range (fun i => (Pi.single i (1 : R i) : ∀ i, R i)))
        ≤ Ideal.span (Set.range f) :=
      Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hsingle i)
    rw [Ideal.span_single_eq_top R] at hle
    exact top_le_iff.mp hle

theorem isPrimGen_prodEquivPi_iff {ι J : Type*} [Fintype ι] [Fintype J] (Q : ι → ℕ)
    (hQ : Pairwise (Function.onFun Nat.Coprime Q)) (a : J → ZMod (∏ i, Q i)) :
    Work.HP.NA.IsPrimGen (∏ i, Q i) a ↔
      ∀ i, Work.HP.NA.IsPrimGen (Q i) (fun j => ZMod.prodEquivPi Q hQ (a j) i) := by
  simp only [Work.HP.NA.IsPrimGen]
  exact (span_range_ringEquiv_eq_top_iff_aux (ZMod.prodEquivPi Q hQ) a).trans
    (span_range_pi_eq_top_iff_aux (R := fun i => ZMod (Q i))
      (f := fun j => ZMod.prodEquivPi Q hQ (a j)))

end Work.HP.NA
