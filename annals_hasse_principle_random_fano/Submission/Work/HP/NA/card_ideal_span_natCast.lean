import Mathlib

namespace Work.HP.NA

/-- The ideal generated by `(g : ZMod q)` in `ZMod q`, for `0 < q` and `g ∣ q`, is the
additive subgroup generated by `g`, whose cardinality is the additive order of `g`,
namely `q / gcd q g = q / g`. -/
theorem card_ideal_span_natCast (q g : ℕ) (hq : 0 < q) (hg : g ∣ q) :
    Nat.card ↥(Ideal.span ({(g : ZMod q)} : Set (ZMod q))) = q / g := by
  have hN : NeZero q := ⟨by omega⟩
  -- The ideal `span {g}` coincides as a set with the additive subgroup generated by `g`.
  have hcarrier : ((Ideal.span ({(g : ZMod q)} : Set (ZMod q)) : Ideal (ZMod q)) : Set (ZMod q))
      = ((AddSubgroup.zmultiples (g : ZMod q) : AddSubgroup (ZMod q)) : Set (ZMod q)) := by
    ext x
    simp only [SetLike.mem_coe]
    rw [Ideal.mem_span_singleton, AddSubgroup.mem_zmultiples_iff]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨(c.val : ℤ), by
        rw [zsmul_eq_mul, Int.cast_natCast, ZMod.natCast_zmod_val, hc, mul_comm]⟩
    · rintro ⟨k, hk⟩
      exact ⟨(k : ZMod q), by rw [← hk, zsmul_eq_mul, mul_comm]⟩
  rw [show Nat.card ↥(Ideal.span ({(g : ZMod q)} : Set (ZMod q)))
        = Nat.card ↥(AddSubgroup.zmultiples (g : ZMod q)) from
      Nat.card_congr (Set.equivOfEq hcarrier),
      Nat.card_zmultiples, ZMod.addOrderOf_coe g (by omega), Nat.gcd_eq_right hg]

end Work.HP.NA
