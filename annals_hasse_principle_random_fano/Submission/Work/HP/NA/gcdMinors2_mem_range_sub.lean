import Mathlib
import Submission.Work.HP.Defs

/-!
# `gcdMinors2_mem_range_sub`

Let `u v : ι → ℤ`, `c : ZMod (p^r)`, and put `w i = (v i : ZMod (p^r)) - c * (u i : ZMod (p^r))`.
Then the natural number `gcd(|gcdMinors2 u v|, p^r)`, viewed in `ZMod (p^r)`, lies in the
`ZMod (p^r)`-span of the `w i`.

The proof is an exercise in identifying the ideal generated by the `w i`.  Lifting `c` to an
integer `C` and setting `W i = v i - C * u i`, we have the exact identity
`u i * v j - u j * v i = u i * W j - u j * W i`, so the gcd `hW` of the `W i` divides every
`2 × 2` minor of `(u, v)`, hence divides `gcdMinors2 u v`.  If `h = gcd(hW, p^r)`, then `h`
divides both `hW` and `p^r`, so `h ∣ gcd(|gcdMinors2 u v|, p^r)`.  Bézout (available over `ℤ`,
a Bézout domain, for an arbitrary `Finset`) expresses `hW` as a `ℤ`-combination of the `W i` and
`h` as a `ℤ`-combination of `hW` and `p^r`; eliminating gives a `ℤ`-combination of the `W i`
congruent to `gcd(|gcdMinors2 u v|, p^r)` modulo `p^r`, which is exactly membership in the span.
-/

set_option autoImplicit false
set_option linter.unusedVariables false

namespace Work.HP.NA

open Finset

/-- If `a : ℤ` divides the integer representatives of two naturals `m, n`, then it divides the
integer representative of `Nat.gcd m n`. -/
lemma int_dvd_nat_gcd {a : ℤ} {m n : ℕ} (hm : a ∣ (m : ℤ)) (hn : a ∣ (n : ℤ)) :
    a ∣ ((Nat.gcd m n : ℕ) : ℤ) := by
  rw [Nat.gcd_eq_gcd_ab]
  exact dvd_add (Dvd.dvd.mul_right hm _) (Dvd.dvd.mul_right hn _)

/-- **Bézout representation of `gcd(|gcdMinors2 u v|, N)` modulo `N`.**

Writing `W i = v i - C * u i`, there is a `ℤ`-combination of the `W i` which is congruent to
`gcd(|gcdMinors2 u v|, N)` modulo `N`. -/
theorem gcdMinors2_bezout {ι : Type*} [Fintype ι] (u v : ι → ℤ) (C : ℤ) (N : ℕ) :
    ∃ ν : ι → ℤ, (N : ℤ) ∣ (∑ i, ν i * (v i - C * u i))
      - ((Nat.gcd (Work.HP.gcdMinors2 u v).natAbs N : ℕ) : ℤ) := by
  set W : ι → ℤ := fun i => v i - C * u i with hWdef
  set hW : ℤ := Finset.univ.gcd W with hWdef'
  have hW_eval : ∀ i, W i = v i - C * u i := fun i => by rw [hWdef]
  have hi : ∀ i, hW ∣ W i := fun i => by rw [hWdef']; exact Finset.gcd_dvd (Finset.mem_univ i)
  -- `hW` divides every 2×2 minor, hence divides `gcdMinors2 u v`
  have hW_dvd_G : hW ∣ Work.HP.gcdMinors2 u v := by
    have hminor : ∀ ij : ι × ι, hW ∣ (u ij.1 * v ij.2 - u ij.2 * v ij.1) := by
      rintro ⟨i, j⟩
      have heq : u i * v j - u j * v i = u i * W j - u j * W i := by
        rw [hW_eval i, hW_eval j]; ring
      rw [heq]
      exact dvd_sub (Dvd.dvd.mul_left (hi j) (u i)) (Dvd.dvd.mul_left (hi i) (u j))
    change hW ∣ Finset.univ.gcd (fun ij : ι × ι => u ij.1 * v ij.2 - u ij.2 * v ij.1)
    exact Finset.dvd_gcd (fun ij _ => hminor ij)
  set h : ℤ := ((Int.gcd hW (N:ℤ) : ℕ) : ℤ) with hh
  have h_dvd_hW : h ∣ hW := by rw [hh]; exact Int.gcd_dvd_left hW (N:ℤ)
  have h_dvd_N : h ∣ (N:ℤ) := by rw [hh]; exact Int.gcd_dvd_right hW (N:ℤ)
  have h_dvd_Gabs : h ∣ ((Work.HP.gcdMinors2 u v).natAbs : ℤ) :=
    Int.dvd_natAbs.mpr (h_dvd_hW.trans hW_dvd_G)
  have h_dvd_g : h ∣ ((Nat.gcd (Work.HP.gcdMinors2 u v).natAbs N : ℕ) : ℤ) :=
    int_dvd_nat_gcd h_dvd_Gabs h_dvd_N
  obtain ⟨M, hM⟩ := h_dvd_g
  -- Bézout for `h`, `hW` and `N`
  have hbez : h = hW * (Int.gcdA hW (N:ℤ)) + (N:ℤ) * (Int.gcdB hW (N:ℤ)) := by
    rw [hh]; exact Int.gcd_eq_gcd_ab hW (N:ℤ)
  -- Bézout for the gcd of the `W i`
  obtain ⟨μ, hμ⟩ := Finset.gcd_eq_sum_mul (R := ℤ) Finset.univ W
  refine ⟨fun i => μ i * (Int.gcdA hW (N:ℤ)) * M, ?_⟩
  have hsum : (∑ i, (μ i * (Int.gcdA hW (N:ℤ)) * M) * (v i - C * u i))
      = hW * (Int.gcdA hW (N:ℤ)) * M := by
    have h1 : (∑ i, (μ i * (Int.gcdA hW (N:ℤ)) * M) * (v i - C * u i))
        = ∑ i, (W i * μ i) * ((Int.gcdA hW (N:ℤ)) * M) := by
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [hW_eval i]; ring
    rw [h1, ← Finset.sum_mul]
    have h2 : ∑ i, W i * μ i = hW := by rw [hWdef', hμ]
    rw [h2]
    ring_nf
  rw [hsum, hM, hbez]
  ring_nf
  exact ⟨-(M * hW.gcdB (N:ℤ)), by ring⟩

theorem gcdMinors2_mem_range_sub {ι : Type*} [Fintype ι] {p r : ℕ}
    (u v : ι → ℤ) (i0 : ι) (hu0 : IsUnit ((u i0 : ZMod (p ^ r)))) {c : ZMod (p ^ r)}
    (hc : c * ((u i0 : ℤ) : ZMod (p ^ r)) = ((v i0 : ℤ) : ZMod (p ^ r))) :
    (((Nat.gcd (Work.HP.gcdMinors2 u v).natAbs (p ^ r)) : ℕ) : ZMod (p ^ r)) ∈
      LinearMap.range (Fintype.linearCombination (ZMod (p ^ r))
        (fun i => ((v i : ℤ) : ZMod (p ^ r)) - c * ((u i : ℤ) : ZMod (p ^ r)))) := by
  obtain ⟨C, hC⟩ := ZMod.intCast_surjective (n := p ^ r) c
  obtain ⟨ν, hν⟩ := gcdMinors2_bezout u v C (p ^ r)
  refine ⟨fun i => (ν i : ZMod (p ^ r)), ?_⟩
  rw [Fintype.linearCombination_apply]
  have hbody : ∀ i, (ν i : ZMod (p^r)) • (((v i : ℤ) : ZMod (p ^ r)) - c * ((u i : ℤ) : ZMod (p ^ r)))
      = ((ν i * (v i - C * u i) : ℤ) : ZMod (p^r)) := by
    intro i
    rw [smul_eq_mul,
      show ((v i : ℤ) : ZMod (p ^ r)) - c * ((u i : ℤ) : ZMod (p ^ r))
          = ((v i - C * u i : ℤ) : ZMod (p^r)) from by rw [Int.cast_sub, Int.cast_mul, hC],
      ← Int.cast_mul]
  rw [Finset.sum_congr rfl (fun i _ => hbody i)]
  rw [← Int.cast_sum]
  rw [← Int.cast_natCast (R := ZMod (p ^ r))]
  rw [ZMod.intCast_eq_intCast_iff_dvd_sub]
  simpa only [neg_sub] using (dvd_neg.mpr hν)

end Work.HP.NA
