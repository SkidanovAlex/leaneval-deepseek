import Mathlib
import Submission.Work.HP.Defs
import Submission.Work.HP.Lat.detLAux
import Submission.Work.HP.Lat.detL_basis_gram
import Submission.Work.HP.Lat.detL_span_gram
import Submission.Work.HP.FM.detL_LM
import Submission.Work.HP.FM.detL_sup_orthogonal

/-!
# The covolume of the primitive orthogonal lattice

The target of this file is

`Work.HP.detL_latOrth`: for a *primitive* integer vector `c : ι → ℤ`, the lattice

  `Λ_c = latOrth c = ker(⟨·, c⟩) = {y : ι → ℤ | ∑ i, y i * c i = 0}`

has covolume `‖c‖` in its real span, i.e. `detL (latOrth c) = eNorm c`.

## Proof outline

Write `m = sqN c = ∑ i, (c i)² = ‖c‖²` and `LM c = latMod c (sqN c) = {y | m ∣ ⟨y, c⟩}`, so that

  `LM c = latOrth c ⊔ ℤc`,  `latOrth c ⊓ ℤc = ⊥`,  `latOrth c ⟂ ℤc`.

The covolume is multiplicative across an orthogonal direct sum
(`Work.HP.FM.detL_sup_orthogonal`), and `detL (ℤc) = ‖c‖` (the rank-one computation below).
Moreover `LM c` is a full-rank sublattice of `ℤ^ι` of index `m`, so
`detL (LM c) = m = ‖c‖²` (`Work.HP.FM.detL_LM`). Hence

  `‖c‖² = detL (LM c) = detL (latOrth c) · ‖c‖`,

and cancelling the positive factor `‖c‖` gives `detL (latOrth c) = ‖c‖`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace Work.HP

/-! ## The structural identities `LM c = latOrth c ⊔ ℤc` with `latOrth c ⟂ ℤc` -/

/-- The congruence lattice `LM c = {y | ‖c‖² ∣ ⟨y, c⟩}` is generated by `latOrth c` and `ℤc`. -/
theorem latOrth_sup_span_singleton {ι : Type*} [Fintype ι] [DecidableEq ι] (c : ι → ℤ) :
    latOrth c ⊔ Submodule.span ℤ {c} = LM c := by
  refine le_antisymm (sup_le (latOrth_le_LM c) (span_singleton_le_LM c)) ?_
  intro y hy
  rw [mem_LM] at hy
  obtain ⟨k, hk⟩ := hy
  refine Submodule.mem_sup.mpr ⟨y + (-k) • c, ?_, k • c,
    Submodule.smul_mem _ k (Submodule.subset_span (Set.mem_singleton c)), ?_⟩
  · rw [mem_latOrth, pdot_add_left, pdot_smul_left, hk, sqN_cast_eq_pdot]
    ring
  · funext i
    simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
    ring

/-- `latOrth c` and `ℤc` are linearly disjoint when `c` is primitive. -/
theorem latOrth_inf_span_singleton {ι : Type*} [Fintype ι] [DecidableEq ι] (c : ι → ℤ)
    (hc : IsPrim c) :
    latOrth c ⊓ Submodule.span ℤ {c} = ⊥ := by
  refine le_antisymm ?_ bot_le
  intro y hy
  rw [Submodule.mem_inf, mem_latOrth, Submodule.mem_span_singleton] at hy
  obtain ⟨hy1, k, hk⟩ := hy
  rw [← hk, pdot_smul_left, ← sqN_cast_eq_pdot] at hy1
  have hm : (sqN c : ℤ) ≠ 0 := by exact_mod_cast ne_of_gt (sqN_pos hc)
  have hk0 : k = 0 := (mul_eq_zero.mp hy1).resolve_right hm
  rw [Submodule.mem_bot, ← hk, hk0, zero_smul]

/-- `latOrth c` is orthogonal to the line `ℤc`. -/
theorem latOrth_orthogonal_span_singleton {ι : Type*} [Fintype ι] [DecidableEq ι] (c : ι → ℤ) :
    ∀ x ∈ latOrth c, ∀ y ∈ Submodule.span ℤ {c}, ∑ i, x i * y i = 0 := by
  intro x hx y hy
  rw [mem_latOrth] at hx
  rw [Submodule.mem_span_singleton] at hy
  obtain ⟨k, hk⟩ := hy
  rw [← hk]
  show pdot x (k • c) = 0
  rw [pdot_smul_right, hx, mul_zero]

/-- The covolume of the rank-one lattice `ℤc` is `‖c‖`. -/
theorem detL_span_singleton_of_ne_zero {ι : Type*} [Fintype ι] (c : ι → ℤ) (hc : c ≠ 0) :
    detL (Submodule.span ℤ {c}) = eNorm c := by
  have hli : LinearIndependent ℤ (fun _ : Fin 1 => c) := by
    rw [Fintype.linearIndependent_iff]
    intro g hg i
    have hg0 : g 0 • c = 0 := by simpa only [Fin.sum_univ_one] using hg
    have h0 : g 0 = 0 := (smul_eq_zero.mp hg0).resolve_right hc
    rw [Subsingleton.elim i 0]
    exact h0
  have hrange : Set.range (fun _ : Fin 1 => c) = ({c} : Set (ι → ℤ)) := by
    ext x
    simp only [Set.mem_range, Set.mem_singleton_iff]
    exact ⟨fun ⟨_, h⟩ => h.symm, fun h => ⟨0, h.symm⟩⟩
  rw [← hrange, Lat.detL_span_gram 1 (fun _ : Fin 1 => c) hli, Matrix.det_fin_one, eNorm]
  congr 1
  exact Finset.sum_congr rfl fun a _ => by ring

/-! ## The main theorem -/

theorem detL_latOrth {ι : Type} [Fintype ι] [DecidableEq ι] (c : ι → ℤ) (hc : IsPrim c) :
    detL (latOrth c) = eNorm c := by
  have hc0 : c ≠ 0 := isPrim_ne_zero hc
  have hkey : detL (LM c) = detL (latOrth c) * detL (Submodule.span ℤ {c}) := by
    rw [← latOrth_sup_span_singleton c]
    exact FM.detL_sup_orthogonal _ _
      (latOrth_inf_span_singleton c hc) (latOrth_orthogonal_span_singleton c)
  rw [FM.detL_LM c hc, detL_span_singleton_of_ne_zero c hc0] at hkey
  have hnn : 0 ≤ eNorm c := Real.sqrt_nonneg _
  have hpos : 0 < eNorm c ^ 2 := by
    rw [eNorm_sq_eq_sqN c]
    exact_mod_cast sqN_pos hc
  have hepos : 0 < eNorm c := by nlinarith
  have h2 : detL (latOrth c) * eNorm c = eNorm c * eNorm c := by
    rw [← hkey, ← eNorm_sq_eq_sqN c]
    ring
  exact mul_right_cancel₀ (ne_of_gt hepos) h2

end Work.HP
