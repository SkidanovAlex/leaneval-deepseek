import Mathlib
import Submission.Work.HP.numaux.Defs
import Submission.Work.HP.numaux.rk_orthLatDefs
import Submission.Work.HP.numaux.castL_smul_mem_range
import Submission.Work.HP.numaux.castL_mem_spread_iff

/-!
# The double orthogonal complement of an integral lattice is its saturation

For an integral lattice `Λ ⊆ ℤ^ι` (`ι` finite), taking the *integer* orthogonal complement
twice returns the saturation (pure hull) of `Λ`:

`orthLat (orthLat Λ) = satLat Λ`.

This is the standard duality statement for a lattice equipped with a perfect bilinear form
(here the standard form `⟨a,x⟩ = ∑ᵢ aᵢxᵢ` on `ℤ^ι`, perfect because the form identifies `ℤ^ι`
with its own dual).  The formal proof passes through the rational spread
`spread Λ ⊆ ℚ^ι` of `rk_orthLatDefs`:

* `spread (orthLat Λ) = stdB.orthogonal (spread Λ)` — an integer vector is orthogonal to `Λ`
  iff its image in `ℚ^ι` is orthogonal to `spread Λ`, and `spread Λ` is spanned by the images
  of the elements of `Λ` while `stdB.orthogonal (spread Λ)` is spanned by the images of the
  integer vectors in it (every rational vector has a non-zero integer multiple in `ℤ^ι`,
  `castL_smul_mem_range`);
* `stdB.orthogonal (stdB.orthogonal V) = V` — Mathlib's
  `LinearMap.BilinForm.orthogonal_orthogonal`, since `stdB` is symmetric and nondegenerate;
* the integer points of `spread Λ` are exactly `satLat Λ` (`castL_mem_spread_iff`).

Hence for `b ∈ orthLat (orthLat Λ)`, `castL b ∈ spread (orthLat (orthLat Λ)) = spread Λ`,
so `b ∈ satLat Λ`.  The reverse inclusion is immediate: `satLat Λ` is generated by vectors
with a non-zero multiple in `Λ`, and every element of `orthLat Λ` is orthogonal to `Λ`.

The auxiliary lemmas below are kept `private` so that this module can be imported alongside
the sibling files that state the same facts under their public names.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

noncomputable section

namespace Work.HP.numaux

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-! ## Elementary facts relating the integral and the rational picture -/

/-- The standard pairing on `ℤ^ι` is the restriction of the standard bilinear form on `ℚ^ι`
along the coordinatewise inclusion. -/
private lemma dO_stdB_castL (v w : ι → ℤ) :
    stdB (ι := ι) (castL v) (castL w) = (dotI v w : ℚ) := by
  simp only [stdB_apply, dotI, castL_apply, Int.cast_sum, Int.cast_mul]

/-- The image of a vector of `Λ` under the coordinatewise inclusion lies in the rational spread
of `Λ`. -/
private lemma dO_castL_mem_spread {Λ : Submodule ℤ (ι → ℤ)} {x : ι → ℤ} (hx : x ∈ Λ) :
    castL x ∈ spread Λ := by
  rw [spread]
  exact Submodule.subset_span (Submodule.mem_map.mpr ⟨x, hx, rfl⟩)

/-- An integer vector is orthogonal to `Λ` exactly when its image in `ℚ^ι` is orthogonal to the
rational spread of `Λ` with respect to the standard bilinear form. -/
private lemma dO_castL_mem_orthogonal_spread_iff {Λ : Submodule ℤ (ι → ℤ)} {a : ι → ℤ} :
    castL a ∈ (stdB (ι := ι)).orthogonal (spread Λ) ↔ a ∈ orthLat Λ := by
  constructor
  · intro h x hx
    have h1 := (LinearMap.BilinForm.mem_orthogonal_iff.mp h) (castL x) (dO_castL_mem_spread hx)
    rw [dO_stdB_castL] at h1
    have h2 : dotI x a = 0 := by exact_mod_cast h1
    rwa [dotI_comm]
  · intro ha
    have hle : spread Λ ≤ LinearMap.ker ((stdB (ι := ι)) (castL a)) := by
      rw [spread_eq_span_image, Submodule.span_le]
      rintro n ⟨x, hx, rfl⟩
      show stdB (ι := ι) (castL a) (castL x) = 0
      rw [dO_stdB_castL]
      exact_mod_cast mem_orthLat.mp ha x hx
    intro n hn
    have h1 := hle hn
    show stdB (ι := ι) n (castL a) = 0
    rw [stdB_comm]
    exact h1

/-- For any `ℚ`-subspace `V ⊆ ℚ^ι` and any `ℤ`-submodule `I ⊆ ℚ^ι` containing a non-zero
integer multiple of every vector, the `ℚ`-span of `V ⊓ I` is `V`. -/
private lemma dO_span_restrictScalars_inf (V : Submodule ℚ (ι → ℚ))
    (I : Submodule ℤ (ι → ℚ)) (hI : ∀ y : ι → ℚ, ∃ M : ℤ, M ≠ 0 ∧ M • y ∈ I) :
    Submodule.span ℚ (↑(V.restrictScalars ℤ ⊓ I) : Set (ι → ℚ)) = V := by
  refine le_antisymm ?_ ?_
  · rw [Submodule.span_le]
    intro x hx
    exact hx.1
  · intro y hy
    obtain ⟨M, hM, hMy⟩ := hI y
    have hMyV : M • y ∈ V := V.smul_mem M hy
    have hmem : M • y ∈ (V.restrictScalars ℤ ⊓ I : Submodule ℤ (ι → ℚ)) := ⟨hMyV, hMy⟩
    have hspan : ((M : ℚ))⁻¹ • (M • y) ∈
        Submodule.span ℚ (↑(V.restrictScalars ℤ ⊓ I) : Set (ι → ℚ)) :=
      Submodule.smul_mem _ _ (Submodule.subset_span hmem)
    have hcast : ((M : ℚ))⁻¹ • (M • y) = y := by
      rw [← Int.cast_smul_eq_zsmul ℚ M y, smul_smul, inv_mul_cancel₀, one_smul]
      simp [Int.cast_ne_zero.mpr hM]
    rwa [hcast] at hspan

/-- The rational spread of the orthogonal lattice is the rational orthogonal complement of the
rational spread. -/
private lemma dO_spread_orthLat_eq_orthogonal (Λ : Submodule ℤ (ι → ℤ)) :
    spread (orthLat Λ) = (stdB (ι := ι)).orthogonal (spread Λ) := by
  have hAI : ((stdB (ι := ι)).orthogonal (spread Λ)).restrictScalars ℤ ⊓
        LinearMap.range (castL (ι := ι)) = (orthLat Λ).map (castL (ι := ι)) := by
    refine le_antisymm ?_ ?_
    · rintro y ⟨hy, z, rfl⟩
      exact Submodule.mem_map.mpr ⟨z, dO_castL_mem_orthogonal_spread_iff.mp hy, rfl⟩
    · rintro y ⟨a, ha, rfl⟩
      exact ⟨dO_castL_mem_orthogonal_spread_iff.mpr ha, ⟨a, rfl⟩⟩
  calc spread (orthLat Λ)
      = Submodule.span ℚ (↑((orthLat Λ).map (castL (ι := ι))) : Set (ι → ℚ)) := rfl
    _ = Submodule.span ℚ (↑(((stdB (ι := ι)).orthogonal (spread Λ)).restrictScalars ℤ ⊓
          LinearMap.range (castL (ι := ι))) : Set (ι → ℚ)) := by rw [hAI]
    _ = (stdB (ι := ι)).orthogonal (spread Λ) :=
        dO_span_restrictScalars_inf _ _ castL_smul_mem_range

/-! ## Nondegeneracy of the standard form -/

/-- The standard bilinear form `⟨x,y⟩ = ∑ᵢ xᵢyᵢ` on `ℚ^ι` is nondegenerate. -/
private lemma dO_stdB_nondegenerate : (stdB (ι := ι)).Nondegenerate := by
  constructor
  · intro x hx
    funext i
    have h := hx (Pi.single i 1)
    simpa [stdB_apply, Pi.single_apply] using h
  · intro x hx
    funext i
    have h := hx (Pi.single i 1)
    rw [stdB_comm (Pi.single i 1) x] at h
    simpa [stdB_apply, Pi.single_apply] using h

/-- The standard bilinear form on `ℚ^ι` is reflexive (symmetric). -/
private lemma dO_stdB_isRefl : (stdB (ι := ι)).IsRefl := by
  intro x y h
  rw [stdB_comm y x]
  exact h

/-- Taking the rational orthogonal complement of a subspace twice returns the subspace. -/
private lemma dO_stdB_orthogonal_orthogonal (V : Submodule ℚ (ι → ℚ)) :
    (stdB (ι := ι)).orthogonal ((stdB (ι := ι)).orthogonal V) = V :=
  LinearMap.BilinForm.orthogonal_orthogonal dO_stdB_nondegenerate dO_stdB_isRefl V

/-! ## The main theorem -/

theorem doubleOrth_eq_satLat {ι : Type} [Fintype ι] [DecidableEq ι] (Λ : Submodule ℤ (ι → ℤ)) :
    Work.HP.orthLat (Work.HP.orthLat Λ) = Work.HP.satLat Λ := by
  refine le_antisymm ?_ ?_
  · intro b hb
    have h1 : castL b ∈ spread (orthLat (orthLat Λ)) := dO_castL_mem_spread hb
    rw [dO_spread_orthLat_eq_orthogonal (orthLat Λ), dO_spread_orthLat_eq_orthogonal Λ,
      dO_stdB_orthogonal_orthogonal] at h1
    exact (castL_mem_spread_iff Λ b).mp h1
  · intro x hx
    obtain ⟨m, hm, hmx⟩ := mem_satLat.mp hx
    rw [mem_orthLat]
    intro a ha
    have h1 : dotI a (m • x) = 0 := (mem_orthLat.mp ha) (m • x) hmx
    rw [dotI_smul_right] at h1
    have h2 : dotI a x = 0 := (mul_eq_zero.mp h1).resolve_left hm
    rwa [dotI_comm]

end Work.HP.numaux
