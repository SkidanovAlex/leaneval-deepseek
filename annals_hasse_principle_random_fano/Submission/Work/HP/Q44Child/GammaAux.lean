import Mathlib
import Submission.Work.HP.Q44Child.SuperDefs

/-!
# Auxiliary definitions for `Work.HP.Q44Child.Gamma_span_indep`

Given a `ℤ`-basis `b` of `ℤ^5` and `Λ = span{b 0, b 1}`, the projected lattice
`ΓW Λ = π(ℤ^5) ⊆ W Λ` is generated by `Ggen b Λ : Fin 3 → W Λ`, the images of
`b 2, b 3, b 4`.

This file collects the elementary structural facts used in the proof:

* `piMap Λ : ℤ^5 →ₗ[ℤ] W Λ` is the `ℤ`-linear map `m ↦ π (toE m)`, so that
  `ΓW Λ = Submodule.map (piMap Λ) ⊤` and `Ggen b Λ j = piMap Λ (b (idx3 j))`;
* the index set `idx3 : Fin 3 → Fin 5` (`j ↦ j + 2`) is injective and misses `0, 1`;
* `Lℝ Λ` is the real span of `toE (b 0), toE (b 1)`.
-/

namespace Work.HP.Q44Child

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

noncomputable section

open scoped RealInnerProductSpace
open Module

variable {Λ : Submodule ℤ (Fin 5 → ℤ)}
variable {b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)}

/-- The `ℤ`-linear map `m ↦ π (toE m)`, where `π` is the orthogonal projection onto `W Λ`.
Its image is `ΓW Λ`. -/
def piMap (Λ : Submodule ℤ (Fin 5 → ℤ)) : (Fin 5 → ℤ) →ₗ[ℤ] W Λ where
  toFun m := ⟨proj Λ (toE m), proj_mem Λ _⟩
  map_add' m n := by
    ext i
    simp only [Submodule.coe_add, map_add]
  map_smul' c m := by
    apply Subtype.ext
    change proj Λ (toE (c • m))
      = (c • (⟨proj Λ (toE m), proj_mem Λ _⟩ : W Λ) : E5)
    rw [toE_smul]
    rw [show (c • (⟨proj Λ (toE m), proj_mem Λ _⟩ : W Λ) : E5) = c • proj Λ (toE m)
      from rfl]
    exact map_zsmul _ c _

@[simp] lemma piMap_apply (Λ : Submodule ℤ (Fin 5 → ℤ)) (m : Fin 5 → ℤ) :
    piMap Λ m = ⟨proj Λ (toE m), proj_mem Λ _⟩ := rfl

lemma gen_eq_piMap (Λ : Submodule ℤ (Fin 5 → ℤ)) (i : Fin 5) :
    gen Λ i = piMap Λ (Pi.single i (1 : ℤ)) := rfl

lemma Ggen_eq_piMap (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ))
    (Λ : Submodule ℤ (Fin 5 → ℤ)) (j : Fin 3) :
    Ggen b Λ j = piMap Λ (b (idx3 j)) := rfl

/-- The standard basis of `ℤ^5` spans everything. -/
lemma span_stdBasis_eq_top :
    (⊤ : Submodule ℤ (Fin 5 → ℤ))
      = Submodule.span ℤ (Set.range fun i : Fin 5 => Pi.single i (1 : ℤ)) := by
  have h : (fun i : Fin 5 => Pi.single i (1 : ℤ)) = Pi.basisFun ℤ (Fin 5) :=
    funext fun i => (Pi.basisFun_apply ℤ (Fin 5) i).symm
  rw [h, eq_comm]
  exact (Pi.basisFun ℤ (Fin 5)).span_eq

/-- `ΓW Λ = π(ℤ^5)` is the image of the `ℤ`-linear map `piMap Λ`. -/
lemma ΓW_eq_map_piMap (Λ : Submodule ℤ (Fin 5 → ℤ)) :
    ΓW Λ = Submodule.map (piMap Λ) ⊤ := by
  have hr : Set.range (gen Λ)
      = Set.range (fun i : Fin 5 => piMap Λ (Pi.single i (1 : ℤ))) := rfl
  rw [ΓW, hr, span_stdBasis_eq_top, Submodule.map_span, ← Set.range_comp]
  rfl

/-- The projection kills `Λ`: `piMap Λ m = 0` for `m ∈ Λ`. -/
lemma piMap_eq_zero_of_mem {m : Fin 5 → ℤ} (hm : m ∈ Λ) : piMap Λ m = 0 :=
  Subtype.ext (proj_kills_toE Λ hm)

/-! ## The index set `idx3 : Fin 3 → Fin 5`, `j ↦ j + 2` -/

@[simp] lemma idx3_val (j : Fin 3) : (idx3 j).val = j.val + 2 := rfl

lemma idx3_injective : Function.Injective idx3 := by
  intro j j' h
  have h2 : j.val + 2 = j'.val + 2 := congrArg Fin.val h
  exact Fin.ext (by omega)

lemma idx3_ne_zero (j : Fin 3) : idx3 j ≠ (0 : Fin 5) := by
  intro h
  have h2 : j.val + 2 = 0 := congrArg Fin.val h
  omega

lemma idx3_ne_one (j : Fin 3) : idx3 j ≠ (1 : Fin 5) := by
  intro h
  have h2 : j.val + 2 = 1 := congrArg Fin.val h
  omega

/-- The two "first" indices `0, 1` are different from the `idx3` indices `2, 3, 4`. -/
lemma castLE_ne_idx3 (i : Fin 2) (j : Fin 3) :
    Fin.castLE (by norm_num : 2 ≤ 5) i ≠ idx3 j := by
  intro h
  have h2 : i.val = j.val + 2 := congrArg Fin.val h
  have hi : i.val < 2 := i.isLt
  omega

@[simp] lemma idx3_zero : idx3 (0 : Fin 3) = (2 : Fin 5) := rfl
@[simp] lemma idx3_one : idx3 (1 : Fin 3) = (3 : Fin 5) := rfl
@[simp] lemma idx3_two : idx3 (2 : Fin 3) = (4 : Fin 5) := rfl

@[simp] lemma castLE_zero :
    Fin.castLE (by norm_num : 2 ≤ 5) (0 : Fin 2) = (0 : Fin 5) := rfl

@[simp] lemma castLE_one :
    Fin.castLE (by norm_num : 2 ≤ 5) (1 : Fin 2) = (1 : Fin 5) := rfl

/-! ## The real span of `Λ` -/

/-- `Lℝ Λ` is the real span of `toE (b 0), toE (b 1)` when `Λ = span{b 0, b 1}`. -/
lemma Lℝ_eq_pair
    (hb : Λ = Submodule.span ℤ (Set.range fun i : Fin 2 =>
      b (Fin.castLE (by norm_num : 2 ≤ 5) i))) :
    Lℝ Λ = Submodule.span ℝ (Set.range fun i : Fin 2 =>
      toE (b (Fin.castLE (by norm_num : 2 ≤ 5) i))) := by
  have h1 : ΛE Λ = Submodule.span ℤ (Set.range fun i : Fin 2 =>
      toE (b (Fin.castLE (by norm_num : 2 ≤ 5) i))) := by
    rw [ΛE, hb, Submodule.map_span, ← Set.range_comp]
    rfl
  rw [Lℝ, h1, Submodule.span_span_of_tower ℤ]

end

end Work.HP.Q44Child
