import Mathlib
import Submission.Work.HP.Q44Child.SuperDefs
import Submission.Work.HP.Q44Child.GammaAux
import Submission.Work.HP.Q44Child.GammaW_eq_span_Ggen
import Submission.Work.HP.Q44Child.repr_coord_eq_zero_of_mem_realSpan

/-!
# `ΓW Λ` is generated by `π(b 2), π(b 3), π(b 4)`, independently

Let `b` be a `ℤ`-basis of `ℤ^5`, let `Λ = span{b 0, b 1}`, and assume that the images
`toE (b i)` are `ℝ`-linearly independent in `E5 = ℝ^5`.  Then the projected lattice
`ΓW Λ = π(ℤ^5) ⊆ W Λ` (π the orthogonal projection onto the orthogonal complement of the
real span of `Λ`) is freely generated, over `ℤ`, by the three vectors `π(b 2), π(b 3), π(b 4)`
(`Ggen b Λ : Fin 3 → W Λ`).

* the span statement is `GammaW_eq_span_Ggen`;
* linear independence: `ℤ^5 = Λ ⊕ span{b 2, b 3, b 4}` (as `b` is a basis), so a `ℤ`-linear
  relation `∑ c_j π(b (idx3 j)) = 0` gives `π (∑ c_j • b (idx3 j)) = 0`, i.e.
  `toE (∑ c_j • b (idx3 j)) ∈ Lℝ Λ`; since `Lℝ Λ` is the `ℝ`-span of `toE (b 0), toE (b 1)`,
  all coordinates `b.repr (∑ c_j • b (idx3 j)) (idx3 j) = c j` vanish.
-/

namespace Work.HP.Q44Child

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

noncomputable section

open Module
open scoped RealInnerProductSpace

/-- Coordinate computation: the `idx3 j`-th coordinate of `∑ j', c j' • b (idx3 j')` in the
`ℤ`-basis `b` is `c j`.  (The index map `idx3 : Fin 3 → Fin 5`, `j ↦ j + 2`, is injective.) -/
lemma repr_sum_idx3_coord (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (c : Fin 3 → ℤ) (j : Fin 3) :
    (b.repr (∑ j' : Fin 3, c j' • b (idx3 j'))) (idx3 j) = c j := by
  have h1 : b.repr (∑ j' : Fin 3, c j' • b (idx3 j'))
      = ∑ j' : Fin 3, c j' • Finsupp.single (idx3 j') (1 : ℤ) := by
    rw [map_sum]
    refine Finset.sum_congr rfl fun j' _ => ?_
    rw [map_smul, Basis.repr_self]
  rw [h1]
  rw [Finsupp.finsetSum_apply]
  rw [Finset.sum_eq_single j]
  · simp
  · intro j' _ hj'
    have hne : idx3 j' ≠ idx3 j := fun h => hj' (idx3_injective h)
    rw [Finsupp.smul_apply, Finsupp.single_eq_of_ne hne.symm, smul_zero]
  · intro hj
    exact absurd (Finset.mem_univ j) hj

theorem Gamma_span_indep (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (Λ : Submodule ℤ (Fin 5 → ℤ))
    (hb : Λ = Submodule.span ℤ (Set.range fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i)))
    (hli : LinearIndependent ℝ (fun i : Fin 5 => Work.HP.Q44Child.toE (b i))) :
    Work.HP.Q44Child.ΓW Λ = Submodule.span ℤ (Set.range (Work.HP.Q44Child.Ggen b Λ)) ∧
      LinearIndependent ℤ (Work.HP.Q44Child.Ggen b Λ) := by
  refine ⟨GammaW_eq_span_Ggen b Λ hb, ?_⟩
  rw [Fintype.linearIndependent_iff]
  intro c hc j
  -- The `ℤ`-linear relation pushed through the projection `π`.
  have hΨ : piMap Λ (∑ j' : Fin 3, c j' • b (idx3 j')) = 0 := by
    rw [map_sum]
    simp only [map_smul]
    simpa only [Ggen_eq_piMap] using hc
  have hproj : proj Λ (toE (∑ j' : Fin 3, c j' • b (idx3 j'))) = 0 := by
    have h := congrArg Subtype.val hΨ
    simpa using h
  -- Hence the lattice vector lies in the real span of `Λ`.
  have hL : toE (∑ j' : Fin 3, c j' • b (idx3 j')) ∈ Lℝ Λ :=
    (proj_eq_zero_iff Λ _).mp hproj
  rw [Lℝ_eq_pair (b := b) (Λ := Λ) hb] at hL
  -- Reading coordinates in the `ℝ`-basis `toE ∘ b` kills them.
  have hcoord : b.repr (∑ j' : Fin 3, c j' • b (idx3 j')) (idx3 j) = 0 :=
    repr_coord_eq_zero_of_mem_realSpan b _ (idx3 j) (idx3_ne_zero j) (idx3_ne_one j) hL
  rw [repr_sum_idx3_coord b c j] at hcoord
  exact hcoord

end

end Work.HP.Q44Child
