import Mathlib
import Submission.Work.HP.Q44Child.SuperDefs

/-!
# `Work.HP.Q44Child.superlattice_basis`

Let `b` be a `ℤ`-basis of `ℤ^5` and let `Λ = span{b 0, b 1}` be the span of its first two
vectors.  Every rank-`3` sublattice `L ⊇ Λ` is generated, over `Λ`, by a single vector:
there is `v ∈ L` with `L = span{b 0, b 1, v}`.

The proof splits `ℤ^5 = Λ ⊕ span{b 2, b 3, b 4}` using the projections
`projOut` (onto `span{b 2, b 3, b 4}`, with kernel `Λ`) and `projIn = id - projOut`
(onto `Λ`).  Since `finrank L = 3` and `finrank Λ = 2`, the image `projOut '' L` has
`ℤ`-rank `1`, hence — being a submodule of a free `ℤ`-module — is generated by one
element `k`; a lift `v ∈ L` of `k` then satisfies `L = Λ + ℤ v`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace Work.HP.Q44Child

noncomputable section

/-- The `ℤ`-span of the first two vectors of a basis `b` of `ℤ^5`. -/
def baseLam (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) : Submodule ℤ (Fin 5 → ℤ) :=
  Submodule.span ℤ (Set.range fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i))

/-- The projection onto `span{b 2, b 3, b 4}` along `baseLam b`: the linear map sending
`b 0`, `b 1` to `0` and fixing `b 2`, `b 3`, `b 4`. -/
def projOut (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) : (Fin 5 → ℤ) →ₗ[ℤ] (Fin 5 → ℤ) :=
  (b.constr ℤ) (fun i => if (i : ℕ) < 2 then 0 else b i)

/-- The projection onto `baseLam b` along `span{b 2, b 3, b 4}`: the linear map sending
`b 0`, `b 1` to themselves and `b 2`, `b 3`, `b 4` to `0`. -/
def projIn (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) : (Fin 5 → ℤ) →ₗ[ℤ] (Fin 5 → ℤ) :=
  (b.constr ℤ) (fun i => if (i : ℕ) < 2 then b i else 0)

lemma projOut_basis (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (i : Fin 5) :
    projOut b (b i) = if (i : ℕ) < 2 then 0 else b i :=
  Module.Basis.constr_basis b ℤ (fun i => if (i : ℕ) < 2 then 0 else b i) i

lemma projIn_basis (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (i : Fin 5) :
    projIn b (b i) = if (i : ℕ) < 2 then b i else 0 :=
  Module.Basis.constr_basis b ℤ (fun i => if (i : ℕ) < 2 then b i else 0) i

/-- `projOut` and `projIn` sum to the identity. -/
lemma projIn_eq (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) :
    projIn b = LinearMap.id - projOut b := by
  apply Module.Basis.ext
  intro i
  rw [projIn_basis, LinearMap.sub_apply, LinearMap.id_apply, projOut_basis]
  by_cases h : (i : ℕ) < 2 <;> simp [h]

/-- A basis vector of index `< 2` lies in `baseLam`. -/
lemma baseLam_mem (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) {i : Fin 5} (h : (i : ℕ) < 2) :
    b i ∈ baseLam b := by
  refine Submodule.subset_span ⟨⟨i.val, h⟩, ?_⟩
  congr 1

/-- `projIn` maps `ℤ^5` into `baseLam`. -/
lemma projIn_mem (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (x : Fin 5 → ℤ) :
    projIn b x ∈ baseLam b := by
  rw [← Module.Basis.sum_repr b x, map_sum]
  simp only [map_smul]
  refine Submodule.sum_mem _ (fun i _ => Submodule.smul_mem _ _ ?_)
  rw [projIn_basis]
  split_ifs with h
  · exact baseLam_mem b h
  · exact Submodule.zero_mem _

/-- `x - projOut x` lies in `baseLam`. -/
lemma sub_projOut_mem (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) (x : Fin 5 → ℤ) :
    x - projOut b x ∈ baseLam b := by
  rw [show x - projOut b x = projIn b x by rw [projIn_eq b]; rfl]
  exact projIn_mem b x

/-- The kernel of `projOut` is `baseLam`. -/
lemma ker_projOut (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) :
    LinearMap.ker (projOut b) = baseLam b := by
  apply le_antisymm
  · intro x hx
    rw [show x = x - projOut b x by rw [show projOut b x = 0 from hx, sub_zero]]
    exact sub_projOut_mem b x
  · rw [baseLam, Submodule.span_le]
    rintro y ⟨i, rfl⟩
    fin_cases i <;> simp [LinearMap.mem_ker, projOut_basis]

/-- `baseLam` has `ℤ`-rank `2`. -/
lemma finrank_baseLam (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) :
    Module.finrank ℤ (baseLam b) = 2 := by
  rw [baseLam, finrank_span_eq_card (b := fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i))
      (b.linearIndependent.comp _ (Fin.castLE_injective (by norm_num : 2 ≤ 5))), Fintype.card_fin]

/-- Any submodule of `ℤ^5` of `ℤ`-rank `1` is generated by a single element. -/
lemma exists_generator (K : Submodule ℤ (Fin 5 → ℤ)) (hK : Module.finrank ℤ K = 1) :
    ∃ k : Fin 5 → ℤ, k ∈ K ∧ K = Submodule.span ℤ {k} := by
  obtain ⟨n, w⟩ := Submodule.basisOfPid (Pi.basisFun ℤ (Fin 5)) K
  have hn : n = 1 := by
    have h := Module.finrank_eq_card_basis w
    simp only [Fintype.card_fin] at h
    omega
  let w1 : Module.Basis (Fin 1) ℤ K := w.reindex (finCongr hn)
  refine ⟨(w1 0 : Fin 5 → ℤ), (w1 0).2, ?_⟩
  apply le_antisymm
  · intro y hy
    have h := w1.sum_repr (⟨y, hy⟩ : K)
    rw [Fin.sum_univ_one] at h
    rw [Submodule.mem_span_singleton]
    exact ⟨(w1.repr ⟨y, hy⟩) 0, by simpa using congrArg Subtype.val h⟩
  · rw [Submodule.span_le]
    rintro z hz
    rw [Set.mem_singleton_iff] at hz
    rw [hz]
    exact (w1 0).2

lemma range_castLE (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ)) :
    Set.range (fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i))
      = {b (Fin.castLE (by norm_num : 2 ≤ 5) (0 : Fin 2)),
         b (Fin.castLE (by norm_num : 2 ≤ 5) (1 : Fin 2))} := by
  ext x
  constructor
  · rintro ⟨i, rfl⟩; fin_cases i <;> simp
  · intro hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with h | h <;> exact ⟨_, h.symm⟩

/-- The image `projOut '' L` of a rank-`3` sublattice `L ⊇ baseLam` has `ℤ`-rank `1`. -/
lemma finrank_map_projOut (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ))
    (L : Submodule ℤ (Fin 5 → ℤ)) (hL : baseLam b ≤ L) (hrk : Module.finrank ℤ L = 3) :
    Module.finrank ℤ (Submodule.map (projOut b) L) = 1 := by
  let g : L →ₗ[ℤ] (Fin 5 → ℤ) := (projOut b).comp L.subtype
  have hrange : g.range = Submodule.map (projOut b) L := by
    rw [LinearMap.range_comp, Submodule.range_subtype]
  have hker : g.ker = Submodule.comap L.subtype (LinearMap.ker (projOut b)) :=
    LinearMap.ker_comp _ _
  have hkerf : Module.finrank ℤ g.ker = 2 := by
    rw [hker, ker_projOut]
    rw [LinearEquiv.finrank_eq (Submodule.comapSubtypeEquivOfLe hL)]
    exact finrank_baseLam b
  have h1 : Module.finrank ℤ (L ⧸ g.ker) + Module.finrank ℤ g.ker = Module.finrank ℤ L :=
    Submodule.finrank_quotient_add_finrank g.ker
  have h2 : Module.finrank ℤ (L ⧸ g.ker) = Module.finrank ℤ g.range :=
    LinearEquiv.finrank_eq (LinearMap.quotKerEquivRange g)
  have h3 : Module.finrank ℤ (Submodule.map (projOut b) L) = Module.finrank ℤ (L ⧸ g.ker) := by
    rw [← hrange, ← h2]
  rw [h3]
  omega

theorem superlattice_basis (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ))
    (L : Submodule ℤ (Fin 5 → ℤ))
    (hL : Submodule.span ℤ (Set.range fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i)) ≤ L)
    (hrk : Work.HP.rk L = 3) :
    ∃ v : Fin 5 → ℤ, v ∈ L ∧
      L = Submodule.span ℤ {b (Fin.castLE (by norm_num : 2 ≤ 5) (0 : Fin 2)),
        b (Fin.castLE (by norm_num : 2 ≤ 5) (1 : Fin 2)), v} := by
  have hlam : baseLam b ≤ L := hL
  have hrk' : Module.finrank ℤ L = 3 := hrk
  have hfin : Module.finrank ℤ (Submodule.map (projOut b) L) = 1 :=
    finrank_map_projOut b L hlam hrk'
  obtain ⟨k, hk, hgen⟩ := exists_generator (Submodule.map (projOut b) L) hfin
  obtain ⟨v, hvL, hvk⟩ := Submodule.mem_map.mp hk
  refine ⟨v, hvL, ?_⟩
  set A : Fin 5 → ℤ := b (Fin.castLE (by norm_num : 2 ≤ 5) (0 : Fin 2)) with hA
  set B : Fin 5 → ℤ := b (Fin.castLE (by norm_num : 2 ≤ 5) (1 : Fin 2)) with hB
  have hLamT : baseLam b ≤ Submodule.span ℤ {A, B, v} := by
    rw [baseLam, range_castLE b, hA, hB]
    apply Submodule.span_mono
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz ⊢
    tauto
  have hvT : v ∈ Submodule.span ℤ {A, B, v} := by
    apply Submodule.subset_span
    simp [Set.mem_insert_iff]
  refine le_antisymm ?_ ?_
  · intro x hx
    have hxK : projOut b x ∈ Submodule.map (projOut b) L := ⟨x, hx, rfl⟩
    rw [hgen] at hxK
    obtain ⟨m, hm⟩ := Submodule.mem_span_singleton.mp hxK
    have hker : projOut b (x - m • v) = 0 := by
      rw [map_sub, map_smul, hvk, hm, sub_self]
    have hmem : x - m • v ∈ baseLam b := by
      have h2 : x - m • v ∈ LinearMap.ker (projOut b) := LinearMap.mem_ker.mpr hker
      rwa [ker_projOut b] at h2
    have h1 : x - m • v ∈ Submodule.span ℤ {A, B, v} := hLamT hmem
    have h2 : m • v ∈ Submodule.span ℤ {A, B, v} := Submodule.smul_mem _ m hvT
    rw [show x = (x - m • v) + m • v by abel]
    exact add_mem h1 h2
  · rw [Submodule.span_le]
    rintro z (hz : z ∈ ({A, B, v} : Set (Fin 5 → ℤ)))
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · exact hlam (Submodule.subset_span ⟨(0 : Fin 2), rfl⟩)
    · exact hlam (Submodule.subset_span ⟨(1 : Fin 2), rfl⟩)
    · exact hvL

end

end Work.HP.Q44Child
