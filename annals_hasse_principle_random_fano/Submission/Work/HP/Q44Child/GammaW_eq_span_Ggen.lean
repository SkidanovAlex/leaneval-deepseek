import Mathlib
import Submission.Work.HP.Q44Child.GammaAux
import Submission.Work.HP.Q44Child.SuperDefs

namespace Work.HP.Q44Child

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

noncomputable section

open Module

/-- With `Λ = span{b 0, b 1}` for a `ℤ`-basis `b` of `ℤ^5`, the projected lattice
`ΓW Λ = π(ℤ^5) ⊆ W Λ` is generated by the three images `π(b 2), π(b 3), π(b 4)`
(`Ggen b Λ : Fin 3 → W Λ`, `Ggen b Λ j = π (b (idx3 j))`, `idx3 j = j + 2`).
Route: `ΓW_eq_map_piMap` gives `ΓW Λ = Submodule.map (piMap Λ) ⊤`; with `hb` one has
`⊤ = Λ ⊔ N` for `N := Submodule.span ℤ (Set.range fun j : Fin 3 => b (idx3 j))`, so
`Submodule.map_sup` reduces the goal to `Submodule.map (piMap Λ) Λ ⊔ Submodule.map (piMap Λ) N`;
the first summand is `⊥` (`piMap_eq_zero_of_mem` kills `Λ`) and the second is
`Submodule.span ℤ (Set.range (Ggen b Λ))` by `Submodule.map_span` and `Ggen_eq_piMap`. -/
theorem GammaW_eq_span_Ggen (b : Module.Basis (Fin 5) ℤ (Fin 5 → ℤ))
    (Λ : Submodule ℤ (Fin 5 → ℤ))
    (hb : Λ = Submodule.span ℤ (Set.range fun i : Fin 2 =>
      b (Fin.castLE (by norm_num : 2 ≤ 5) i))) :
    Work.HP.Q44Child.ΓW Λ = Submodule.span ℤ (Set.range (Work.HP.Q44Child.Ggen b Λ)) := by
  -- The `Fin 5` index set splits as the `castLE` copy of `Fin 2` together with `idx3 '' Fin 3`.
  have hset : Set.range b
      = Set.range (fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i))
        ∪ Set.range (fun j : Fin 3 => b (Work.HP.Q44Child.idx3 j)) := by
    ext x
    simp only [Set.mem_range, Set.mem_union]
    constructor
    · rintro ⟨i, rfl⟩
      by_cases hi : i.val < 2
      · exact Or.inl ⟨⟨i.val, hi⟩, congrArg b (Fin.ext rfl)⟩
      · push Not at hi
        exact Or.inr ⟨⟨i.val - 2, by omega⟩,
          congrArg b (Fin.ext (by simp only [Work.HP.Q44Child.idx3_val]; omega))⟩
    · rintro (⟨i, rfl⟩ | ⟨j, rfl⟩)
      · exact ⟨Fin.castLE (by norm_num : 2 ≤ 5) i, rfl⟩
      · exact ⟨Work.HP.Q44Child.idx3 j, rfl⟩
  -- Since `b` is a basis, `⊤ = span{b 0, b 1} ⊔ span{b 2, b 3, b 4}`.
  have htop : (⊤ : Submodule ℤ (Fin 5 → ℤ))
      = Submodule.span ℤ (Set.range fun i : Fin 2 => b (Fin.castLE (by norm_num : 2 ≤ 5) i))
        ⊔ Submodule.span ℤ (Set.range fun j : Fin 3 => b (Work.HP.Q44Child.idx3 j)) := by
    rw [← b.span_eq, hset, Submodule.span_union]
  rw [Work.HP.Q44Child.ΓW_eq_map_piMap, htop, ← hb, Submodule.map_sup]
  -- `piMap Λ` kills `Λ`.
  have hΛ0 : Submodule.map (Work.HP.Q44Child.piMap Λ) Λ = ⊥ := by
    refine le_antisymm ?_ bot_le
    rw [Submodule.map_le_iff_le_comap]
    intro m hm
    exact Work.HP.Q44Child.piMap_eq_zero_of_mem hm
  -- The image of `span{b 2, b 3, b 4}` is `span{π (b 2), π (b 3), π (b 4)}`.
  have hB : Submodule.map (Work.HP.Q44Child.piMap Λ)
        (Submodule.span ℤ (Set.range fun j : Fin 3 => b (Work.HP.Q44Child.idx3 j)))
      = Submodule.span ℤ (Set.range (Work.HP.Q44Child.Ggen b Λ)) := by
    rw [Submodule.map_span, ← Set.range_comp]
    congr 1
  rw [hΛ0, hB, bot_sup_eq]

end

end Work.HP.Q44Child
