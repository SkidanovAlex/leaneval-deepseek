import Mathlib
import Submission.Work.Q44Geom.Setup
import Submission.Work.HP.lam_basic
import Submission.Work.HP.Q44Child.lam_attained
import Submission.Work.HP.Q44Child.ballCount_le
import Submission.Work.HP.Q44Child.SuperDefs
import Submission.Work.HP.Q44Child.real_span_inter
import Submission.Work.Q44Geom.exists_close_lam_two

/-!
# `Work.Q44Geom.class_rep`

Given a primitive rank-`3` lattice `L ⊆ ℤ^5` and a primitive rank-`2` sublattice `N ≤ L` such
that `L/N` is generated by a single element (`L = ℤ z₀ + N`), we produce a generator `z` of
`L/N` whose Euclidean norm is bounded by `T + λ₂(N)`, where `T ≥ λ₃(L)`.

The construction replaces `z₀` by a translate `z = z₀ - n`, `n ∈ N`, chosen so that the
component of `toE z₀` along the real span `Lℝ N` is rounded to the nearest point of `N`
(covering radius of a rank-`2` lattice `≤ λ₂`), while the orthogonal component of a generator
has length `≤ λ₃(L)` (some of three independent short vectors of `L` has a non-zero component
outside `Lℝ N`).
-/

namespace Work.Q44Geom

open Work.HP
open Work.HP.Q44Child

/-- A lattice of rank `2` contains no three `ℤ`-linearly independent vectors. -/
lemma not_three_linIndep_rank2 (N : Submodule ℤ (Fin 5 → ℤ)) (hrk : Work.HP.rk N = 2)
    (f : Fin 3 → (Fin 5 → ℤ)) (hmem : ∀ i, f i ∈ N) : ¬ LinearIndependent ℤ f := by
  intro hf
  let g : Fin 3 → N := fun i => ⟨f i, hmem i⟩
  have hg : LinearIndependent ℤ g := by
    refine LinearIndependent.of_comp (Submodule.subtype N) ?_
    simpa [g, Function.comp_def] using hf
  have hle := hg.fintype_card_le_finrank
  rw [Fintype.card_fin] at hle
  have hrk' : Module.finrank ℤ N = 2 := hrk
  omega

theorem class_rep : ∃ C : ℝ, 0 < C ∧ ∀ (N L : Submodule ℤ (Fin 5 → ℤ)), Work.HP.IsPrimLat N →
    Work.HP.IsPrimLat L → N ≤ L → Work.HP.rk N = 2 → Work.HP.rk L = 3 →
    (∃ z : Fin 5 → ℤ, z ∈ L ∧ ∀ w ∈ L, ∃ k : ℤ, ∃ n ∈ N, w = k • z + n) →
    ∀ T : ℝ, Work.HP.lam L 3 ≤ T →
      ∃ z : Fin 5 → ℤ, z ∈ L ∧ (∀ w ∈ L, ∃ k : ℤ, ∃ n ∈ N, w = k • z + n) ∧
        Work.HP.eNorm z ≤ C * (T + Work.HP.lam N 2) := by
  refine ⟨2, by norm_num, ?_⟩
  intro N L hN hL hNL hrkN hrkL hgen T hT
  obtain ⟨z₀, hz₀L, hz₀gen⟩ := hgen
  -- three independent vectors of `L` of norm at most `lam L 3`
  obtain ⟨f, hfL, hfind, hfb⟩ :=
    Work.HP.Q44Child.lam_attained L 3 (by norm_num) (by omega)
  have hfb3 : ∀ i, Work.HP.eNorm (f i) ≤ Work.HP.lam L 3 := fun i =>
    (hfb i).trans (Work.HP.lam_mono L (by have h := i.isLt; omega) (by omega))
  -- write each `f i = kk i • z₀ + nn i`
  choose kk nn hnn using fun i => hz₀gen (f i) (hfL i)
  have hex : ∃ i : Fin 3, kk i ≠ 0 := by
    by_contra h
    push_neg at h
    exact not_three_linIndep_rank2 N hrkN f (fun i => by
      have h2 : f i = kk i • z₀ + nn i := (hnn i).2
      rw [h i, zero_smul, zero_add] at h2
      rw [h2]
      exact (hnn i).1) hfind
  obtain ⟨i₀, hk0⟩ := hex
  -- `toE (f i₀) = kk i₀ • toE z₀ + toE (nn i₀)`
  have hto : Work.HP.Q44Child.toE (f i₀)
      = kk i₀ • Work.HP.Q44Child.toE z₀ + Work.HP.Q44Child.toE (nn i₀) := by
    rw [(hnn i₀).2, map_add, map_zsmul]
  have hπ : Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE (f i₀))
      = kk i₀ • Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀) := by
    rw [hto, map_add, map_zsmul, Work.HP.Q44Child.proj_kills_toE N (hnn i₀).1, add_zero]
  -- the orthogonal component of a generator has length at most `lam L 3`
  have hq_le : ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖ ≤ Work.HP.lam L 3 := by
    have hkabs : (1 : ℝ) ≤ |(kk i₀ : ℝ)| := by
      have h1 : (1 : ℤ) ≤ |kk i₀| := Int.one_le_abs hk0
      exact_mod_cast h1
    have h1 : ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖
        ≤ ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE (f i₀))‖ := by
      have hmul : ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE (f i₀))‖
          = |(kk i₀ : ℝ)| * ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖ := by
        rw [hπ, norm_zsmul ℝ (kk i₀)
          (Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)), Real.norm_eq_abs]
      rw [hmul]
      calc ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖
          = 1 * ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖ := (one_mul _).symm
        _ ≤ |(kk i₀ : ℝ)| * ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)‖ :=
            mul_le_mul_of_nonneg_right hkabs (norm_nonneg _)
    refine h1.trans ?_
    calc ‖Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE (f i₀))‖
        ≤ ‖Work.HP.Q44Child.toE (f i₀)‖ := Work.HP.Q44Child.norm_proj_le N _
      _ = Work.HP.eNorm (f i₀) := Work.HP.Q44Child.norm_toE (f i₀)
      _ ≤ Work.HP.lam L 3 := hfb3 i₀
  -- the component of `toE z₀` in `Lℝ N`
  have hp_mem : Work.HP.Q44Child.toE z₀ - Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)
      ∈ Work.HP.Q44Child.Lℝ N := by
    have h := Submodule.sub_starProjection_mem_orthogonal
      (K := Work.HP.Q44Child.W N) (Work.HP.Q44Child.toE z₀)
    have h2 : (Work.HP.Q44Child.W N)ᗮ = Work.HP.Q44Child.Lℝ N := by
      rw [Work.HP.Q44Child.W, Submodule.orthogonal_orthogonal]
    simpa [Work.HP.Q44Child.proj, h2] using h
  obtain ⟨n, hnN, hbound⟩ := exists_close_lam_two N hrkN
    (Work.HP.Q44Child.toE z₀ - Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)) hp_mem
  refine ⟨z₀ - n, Submodule.sub_mem L hz₀L (hNL hnN), ?_, ?_⟩
  · intro w hwL
    obtain ⟨k, m, hmN, hwm⟩ := hz₀gen w hwL
    refine ⟨k, k • n + m, Submodule.add_mem N (Submodule.smul_mem N k hnN) hmN, ?_⟩
    rw [hwm]
    show k • z₀ + m = k • (z₀ - n) + (k • n + m)
    rw [smul_sub]
    abel
  · have htoz : Work.HP.Q44Child.toE (z₀ - n)
        = (Work.HP.Q44Child.toE z₀ - Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀)
            - Work.HP.Q44Child.toE n) + Work.HP.Q44Child.proj N (Work.HP.Q44Child.toE z₀) := by
      rw [map_sub]; abel
    have hnorm : Work.HP.eNorm (z₀ - n) ≤ Work.HP.lam N 2 + Work.HP.lam L 3 := by
      rw [← Work.HP.Q44Child.norm_toE (z₀ - n), htoz]
      exact (norm_add_le _ _).trans (add_le_add hbound hq_le)
    nlinarith [hnorm, hT, Work.HP.lam_nonneg N 2, Work.HP.lam_nonneg L 3]

end Work.Q44Geom
