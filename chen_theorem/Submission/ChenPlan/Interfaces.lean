import Mathlib
import Submission.Chen.Switch

/-!
# Chen's theorem: the plan (interfaces between the areas)

WRITTEN BY THE PROJECT LEAD. Do NOT edit this file. If you believe a statement here is wrong,
say so precisely in your report (a counterexample, or the step that cannot hold) instead of
proving something else.

`Submission.Chen.Switch.chen_rate_estimate_of_inputs_gen` (proved) reduces Chen's theorem to three
analytic inputs at a free sift limit. We use `M = chenSiftLimitTenth x = ⌊x^{1/10}⌋ + 1`, where the
budget `hfin` has room: with `ε = 1/100` (h1), `A = 39/25` (h2), `B = 27/10` (h3), `D = 34/5`
(`Work.NumberTheory.Chen.mertens_lower_tenth`, proved), `E = 1/32` (from `sqMass_bound_sharp`)
and `δ = 1/1000`, `hfin` evaluates to about `+0.061`.

All three inputs come from ONE general tool, the **linear (dimension-1) sieve**, stated below for
Mathlib's `BoundingSieve`, with an explicit upper envelope `Utab` (a step function) and an explicit
lower constant (`993/1000`) for `s ≥ 49/10` (h1's level `√x/(log x)^B` makes `s` slightly less than 5). The intended proof of the sieve (the Jurkat–Richert method) is:
Selberg's Λ² upper bound (sharp, `2e^γ/s`, for `s ≤ 2`; `1/σ(s)` with the Ankeny–Onishi `σ` beyond),
the fundamental lemma at large `s`, and a few iterations of the Buchstab identity
`S(A,z) = S(A,w) - Σ_{w ≤ p < z} S(A_p, p)`, alternating upper and lower bounds. The table below is
four such iterations from Selberg's bound, plus 0.5% slack. NO Rosser–Iwaniec λ± sieve is needed.

* `LinearSieveUpper`, `LinearSieveLower` : the sieve (a general library area).
* `H1Statement` : the lower sieve for shifted primes (`goodSum`), from `LinearSieveLower` + BV.
* `H2Statement` : the upper sieve summed over the window (`apMass`), from `LinearSieveUpper` + BV.
* `H3Statement` : Chen's switched `B`-term count, from `LinearSieveUpper` at `s = 3/2` + a bilinear
  (convolution) level of distribution.
* assembly : `H1 ∧ H2 ∧ H3 → chen_rate_estimate` via `chen_rate_estimate_of_inputs_gen`.
-/

open Finset
open scoped BigOperators

set_option autoImplicit false

namespace Submission.ChenPlan

/-- `V = ∏_{p ∣ P} (1 - ν(p))` for a sieve problem. -/
noncomputable def sieveV (s : BoundingSieve) : ℝ :=
  ∏ p ∈ s.prodPrimes.primeFactors, (1 - s.nu p)

/-- The remainder sum `Σ_{d ∣ P, d < D} 3^{ω(d)} |r_d|`. The weight `3^{ω(d)}` is what Selberg's Λ²
sieve (`|λ_d| ≤ 3^{ω(d)}`) and hence the Jurkat–Richert method produce. It survives the Buchstab
iterations because in `S(A_p, p)` the remainder index `m = p d` has `p` as its largest prime factor,
so each `m` is counted once. Bombieri–Vinogradov absorbs the weight by Cauchy–Schwarz. -/
noncomputable def remSum (s : BoundingSieve) (D : ℝ) : ℝ :=
  ∑ d ∈ s.prodPrimes.divisors.filter (fun d : ℕ => (d : ℝ) < D),
    (3 : ℝ) ^ d.primeFactors.card * |s.rem d|

/-- The sieve problem is **linear with constant `K`, sifting range below `z`**: every prime of `P`
is `< z`, and `∏_{p ∣ P, w ≤ p} (1 - ν(p))⁻¹ ≤ (log z / log w)(1 + K / log w)` for `2 ≤ w < z`. -/
def IsLinear (s : BoundingSieve) (z K : ℝ) : Prop :=
  (∀ p ∈ s.prodPrimes.primeFactors, (p : ℝ) < z) ∧
  ∀ w : ℝ, 2 ≤ w → w < z →
    (∏ p ∈ s.prodPrimes.primeFactors.filter (fun p : ℕ => w ≤ (p : ℝ)), (1 - s.nu p)⁻¹)
      ≤ (Real.log z / Real.log w) * (1 + K / Real.log w)

/-- The sieve problem is linear with constant `K` **uniformly over sub-ranges** below `z` (the classical
dimension condition, as in Friedlander–Iwaniec, *Opera de Cribro*, Thm 11.13 / Richert's `Ω₂(κ)`):
`∏_{p ∣ P, w ≤ p < z'} (1 - ν(p))⁻¹ ≤ (log z' / log w)(1 + K / log w)` for all `2 ≤ w < z' ≤ z`.
Added 2026-09-24: `IsLinear` alone (the axiom at the single top limit `z`) does not pass to the
Buchstab children `S(A_p, p)`, and the linear sieve is false under it in general. -/
def IsLinearRange (s : BoundingSieve) (z K : ℝ) : Prop :=
  ∀ w z' : ℝ, 2 ≤ w → w < z' → z' ≤ z →
    (∏ p ∈ s.prodPrimes.primeFactors.filter (fun p : ℕ => w ≤ (p : ℝ) ∧ (p : ℝ) < z'),
        (1 - s.nu p)⁻¹)
      ≤ (Real.log z' / Real.log w) * (1 + K / Real.log w)

/-- The matching LOWER dimension bound on every sub-range (added 2026-09-24, with `IsLinearRange` this makes
the density two-sided, `∏_{w ≤ p < z'} (1 - ν(p))⁻¹ = (log z'/log w)(1 + O(K/log w))`, the classical regular
linear sieve): `(log z' / log w)(1 - K / log w) ≤ ∏_{p ∣ P, w ≤ p < z'} (1 - ν(p))⁻¹` for all `2 ≤ w < z' ≤ z`.
All consumers here sieve by every odd prime below `z` with `ν(p) = 1/(p-1)`, so Mertens gives it. -/
def IsLinearLower (s : BoundingSieve) (z K : ℝ) : Prop :=
  ∀ w z' : ℝ, 2 ≤ w → w < z' → z' ≤ z →
    (Real.log z' / Real.log w) * (1 - K / Real.log w) ≤
      ∏ p ∈ s.prodPrimes.primeFactors.filter (fun p : ℕ => w ≤ (p : ℝ) ∧ (p : ℝ) < z'),
        (1 - s.nu p)⁻¹

/-- **Richert's two-sided dimension condition** `Ω₁ + Ω₂(1, L)` (Halberstam–Richert, *Sieve Methods*, Ch. 8, the
hypotheses of the Jurkat–Richert theorem), with `L = K` (added 2026-09-24, v6): `ν(p) ≤ 1/2` on the sifting primes, and
`|Σ_{p ∣ P, w ≤ p < z'} ν(p) log p − log(z'/w)| ≤ K` for all `2 ≤ w < z' ≤ z`. The log-weighted form excludes densities
that satisfy the product forms but drift like `K log log` (which break every sharp-sieve error bound). All consumers here
(every odd prime below `z`, `ν(p) = 1/(p-1)`) satisfy it by Mertens' first theorem. -/
def IsLinearMertens (s : BoundingSieve) (z K : ℝ) : Prop :=
  (∀ p ∈ s.prodPrimes.primeFactors, s.nu p ≤ 1 / 2) ∧
  ∀ w z' : ℝ, 2 ≤ w → w < z' → z' ≤ z →
    |(∑ p ∈ s.prodPrimes.primeFactors.filter (fun p : ℕ => w ≤ (p : ℝ) ∧ (p : ℝ) < z'),
        s.nu p * Real.log p) - Real.log (z' / w)| ≤ K

/-- The upper envelope on the grid `3/2 + k/20` (`k = 0, …, 70`): four Jurkat–Richert iterations
from Selberg's bound, rounded up, with 0.5% slack. (The limit is the Rosser–Iwaniec `F`:
`F(3/2) = 2.3748`, `F(3) = 1.1874`, `F(4) = 1.0216`.) -/
def utabList : List ℚ :=
  [2387/1000, 2310/1000, 2238/1000, 2170/1000, 2106/1000, 2046/1000, 1989/1000, 1936/1000,
   1885/1000, 1836/1000, 1790/1000, 1747/1000, 1707/1000, 1670/1000, 1635/1000, 1600/1000,
   1566/1000, 1532/1000, 1500/1000, 1470/1000, 1440/1000, 1412/1000, 1385/1000, 1359/1000,
   1334/1000, 1310/1000, 1286/1000, 1264/1000, 1242/1000, 1221/1000, 1200/1000, 1181/1000,
   1164/1000, 1149/1000, 1135/1000, 1122/1000, 1111/1000, 1100/1000, 1091/1000, 1083/1000,
   1075/1000, 1068/1000, 1062/1000, 1056/1000, 1051/1000, 1047/1000, 1043/1000, 1039/1000,
   1036/1000, 1032/1000, 1030/1000, 1027/1000, 1025/1000, 1023/1000, 1021/1000, 1019/1000,
   1018/1000, 1017/1000, 1015/1000, 1014/1000, 1013/1000, 1012/1000, 1012/1000, 1011/1000,
   1010/1000, 1010/1000, 1009/1000, 1009/1000, 1009/1000, 1008/1000, 1008/1000]

/-- The upper envelope `Utab s`, used for `s ≥ 1`:
* for `s < 3/2`, the exact Selberg/Rosser–Iwaniec value `F(s) = 2e^γ/s` with the same 0.5% slack
  (h3 sieves at `s = 3/2 - o(1)`, where a coarse cell would cost too much);
* for `s ≥ 3/2`, the table value of the grid cell `[3/2 + k/20, 3/2 + (k+1)/20)` containing `s`
  (and the last value, `1.008`, for `s ≥ 5`). -/
noncomputable def Utab (s : ℝ) : ℝ :=
  if s < 3 / 2 then (1005 / 1000 : ℝ) * (2 * Real.exp Real.eulerMascheroniConstant) / s
  else ((utabList.getD (min (⌊(s - 3 / 2) * 20⌋₊) 70) 0 : ℚ) : ℝ)

/-- **The linear sieve, upper bound** (Jurkat–Richert form with the envelope `Utab`): for every
`K` and `η > 0` there is `D₀` such that for every linear sieve problem (constant `K`, range `< z`)
with `X ≥ 0` and every level `D ≥ D₀` with `s = log D / log z ≥ 1`,
`S(A, z) ≤ X V (Utab(s) + η) + Σ_{d ∣ P, d < D} 3^{ω(d)} |r_d|`. -/
def LinearSieveUpper : Prop :=
  ∀ K : ℝ, 0 ≤ K → ∀ η : ℝ, 0 < η → ∃ D₀ z₀ : ℝ, ∀ (s : BoundingSieve) (z D : ℝ),
    D₀ ≤ D → z₀ ≤ z → 2 ≤ z → IsLinear s z K → IsLinearRange s z K → IsLinearLower s z K →
    IsLinearMertens s z K → 0 ≤ s.totalMass →
    1 ≤ Real.log D / Real.log z →
    s.siftedSum ≤ s.totalMass * sieveV s * (Utab (Real.log D / Real.log z) + η) + remSum s D

/-- **The linear sieve, lower bound for `s ≥ 49/10`**: `S(A, z) ≥ X V (993/1000 - η) - Σ 3^{ω(d)} |r_d|`
(the Rosser–Iwaniec `f(4.9) ≈ 0.9977`; four Jurkat–Richert iterations give `0.9965` at `s = 4.9`, so the
margin is ≈ 0.35%. Loosened from `199/200` on 2026-09-23 to give the sieve area headroom; h1 needs only
`0.99 + o(1)`). -/
def LinearSieveLower : Prop :=
  ∀ K : ℝ, 0 ≤ K → ∀ η : ℝ, 0 < η → ∃ D₀ z₀ : ℝ, ∀ (s : BoundingSieve) (z D : ℝ),
    D₀ ≤ D → z₀ ≤ z → 2 ≤ z → IsLinear s z K → IsLinearRange s z K → IsLinearLower s z K →
    IsLinearMertens s z K → 0 ≤ s.totalMass →
    49 / 10 ≤ Real.log D / Real.log z →
    s.totalMass * sieveV s * ((993 : ℝ) / 1000 - η) - remSum s D ≤ s.siftedSum

/-- **h1 at `M = x^{1/10}`**: `(1 - 1/100) x V(M) ≤ Σ_{p ≤ x, (p+2, P_odd(M)) = 1} log p`. -/
def H1Statement : Prop :=
  ∀ᶠ x : ℕ in Filter.atTop,
    (1 - (1 : ℝ) / 100) * (x : ℝ) * Commons.NumberTheory.Chen.ChenEight.VsieveOdd (Submission.chenSiftLimitTenth x)
      ≤ Commons.NumberTheory.Chen.ChenEight.goodSum x (Submission.chenSiftLimitTenth x)

/-- **h2 at `M = x^{1/10}`**: `Σ_{q ∈ [M, Y)} apMass(q) ≤ (39/25) x V(M)`. -/
def H2Statement : Prop :=
  ∀ᶠ x : ℕ in Filter.atTop,
    (∑ q ∈ Submission.winPrimes (Submission.chenSiftLimitTenth x) (Submission.chenWindowTop x),
        Submission.apMass x (Submission.chenSiftLimitTenth x) q)
      ≤ (39 / 25 : ℝ) * (x : ℝ) * Commons.NumberTheory.Chen.ChenEight.VsieveOdd (Submission.chenSiftLimitTenth x)

/-- **h3 at `M = x^{1/10}`**: `#B-terms · log² x ≤ (27/10) x`. -/
def H3Statement : Prop :=
  ∀ᶠ x : ℕ in Filter.atTop,
    (Submission.bTermCount x (Submission.chenSiftLimitTenth x) (Submission.chenWindowTop x) : ℝ)
        * Real.log (x : ℝ) * Real.log (x : ℝ) ≤ (27 / 10 : ℝ) * (x : ℝ)

end Submission.ChenPlan
