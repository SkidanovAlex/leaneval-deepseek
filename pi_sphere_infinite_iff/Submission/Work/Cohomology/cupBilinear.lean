import Mathlib
import Submission.Work.Cohomology.AlexanderWhitney

/-!
# Bilinearity of the Alexander–Whitney cup product

The cup product on cochains,
`(α ⌣ β)(σ) = α(σ_front) · β(σ_back)` (`Work.Cohomology.cup`), is bilinear over the coefficient
ring: it is additive and `R`-homogeneous in each variable.

Since `cup` is defined as the underlying linear map of `cupHom`, a morphism out of the `(n+m)`-chains
defined through the colimit (coproduct) universal property, the cleanest route is to prove the
corresponding identities for `cupHom` as morphisms in `ModuleCat R`.  The coproduct
`(X.chainComplex R).X (n+m)` is generated by the simplices `σ`, so two maps out of it agree as soon
as they agree after precomposition with every `X.ιChainComplex σ`
(`SSet.chainComplex_hom_ext`), and on the generators the identity reduces to the corresponding
identity in `R` between the spanning singleton maps `R →ₗ[R] R`, transported by `ModuleCat.ofHom`.

* `cupHom_add_left`, `cupHom_add_right`, `cupHom_smul_left`, `cupHom_smul_right` — bilinearity of
  `cupHom` on the nose;
* `cupBilinear` — the four bilinearity statements for `cup`.
-/

set_option backward.isDefEq.respectTransparency false

open CategoryTheory AlgebraicTopology Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

variable (R : Type) [CommRing R]

/-- The cup product is additive in its first argument. -/
theorem cupHom_add_left (X : SSet) {n m : ℕ}
    (α α' : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
    (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R) :
    cupHom R X (α + α') β = cupHom R X α β + cupHom R X α' β := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [ιChainComplex_cupHom, CategoryTheory.Preadditive.comp_add, ιChainComplex_cupHom,
    ιChainComplex_cupHom]
  congr 1
  rw [show genEval R X (α + α')
        (frontFace X n (n + m) (Nat.le_add_right n m) σ) =
      genEval R X α (frontFace X n (n + m) (Nat.le_add_right n m) σ) +
      genEval R X α' (frontFace X n (n + m) (Nat.le_add_right n m) σ) from by
    simp [genEval, LinearMap.add_apply]]
  rw [add_mul, LinearMap.toSpanSingleton_add]
  simp only [ModuleCat.hom_ofHom]

/-- The cup product is additive in its second argument. -/
theorem cupHom_add_right (X : SSet) {n m : ℕ}
    (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
    (β β' : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R) :
    cupHom R X α (β + β') = cupHom R X α β + cupHom R X α β' := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [ιChainComplex_cupHom, CategoryTheory.Preadditive.comp_add, ιChainComplex_cupHom,
    ιChainComplex_cupHom]
  congr 1
  rw [show genEval R X (β + β') (backFace X n m σ) =
      genEval R X β (backFace X n m σ) + genEval R X β' (backFace X n m σ) from by
    simp [genEval, LinearMap.add_apply]]
  rw [mul_add, LinearMap.toSpanSingleton_add]
  simp only [ModuleCat.hom_ofHom]

/-- The cup product is `R`-homogeneous in its first argument. -/
theorem cupHom_smul_left (X : SSet) {n m : ℕ} (a : R)
    (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
    (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R) :
    cupHom R X (a • α) β = a • cupHom R X α β := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [ιChainComplex_cupHom, CategoryTheory.Linear.comp_smul, ιChainComplex_cupHom]
  congr 1
  rw [show genEval R X (a • α)
        (frontFace X n (n + m) (Nat.le_add_right n m) σ) =
      a • genEval R X α (frontFace X n (n + m) (Nat.le_add_right n m) σ) from by
    simp [genEval, LinearMap.smul_apply]]
  rw [smul_mul_assoc, LinearMap.toSpanSingleton_smul]
  simp only [ModuleCat.hom_ofHom]

/-- The cup product is `R`-homogeneous in its second argument. -/
theorem cupHom_smul_right (X : SSet) {n m : ℕ} (a : R)
    (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
    (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R) :
    cupHom R X α (a • β) = a • cupHom R X α β := by
  apply SSet.chainComplex_hom_ext
  intro σ
  rw [ιChainComplex_cupHom, CategoryTheory.Linear.comp_smul, ιChainComplex_cupHom]
  congr 1
  rw [show genEval R X (a • β) (backFace X n m σ) =
      a • genEval R X β (backFace X n m σ) from by
    simp [genEval, LinearMap.smul_apply]]
  rw [mul_smul_comm, LinearMap.toSpanSingleton_smul]
  simp only [ModuleCat.hom_ofHom]

open CategoryTheory AlgebraicTopology Limits in
open scoped Simplicial in
theorem cupBilinear (R : Type) [CommRing R] (X : SSet) (n m : ℕ) :
    (∀ (α α' : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
       (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R),
      Work.Cohomology.cup R X (α + α') β = Work.Cohomology.cup R X α β + Work.Cohomology.cup R X α' β) ∧
    (∀ (a : R) (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
       (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R),
      Work.Cohomology.cup R X (a • α) β = a • Work.Cohomology.cup R X α β) ∧
    (∀ (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
       (β β' : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R),
      Work.Cohomology.cup R X α (β + β') = Work.Cohomology.cup R X α β + Work.Cohomology.cup R X α β') ∧
    (∀ (a : R) (α : (X.chainComplex (ModuleCat.of R R)).X n →ₗ[R] R)
       (β : (X.chainComplex (ModuleCat.of R R)).X m →ₗ[R] R),
      Work.Cohomology.cup R X α (a • β) = a • Work.Cohomology.cup R X α β) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro α α' β
    simp only [cup]
    rw [← ModuleCat.hom_add, cupHom_add_left]
  · intro a α β
    simp only [cup]
    rw [← ModuleCat.hom_smul, cupHom_smul_left]
  · intro α β β'
    simp only [cup]
    rw [← ModuleCat.hom_add, cupHom_add_right]
  · intro a α β
    simp only [cup]
    rw [← ModuleCat.hom_smul, cupHom_smul_right]

end

end Work.Cohomology
