import Mathlib
import Submission.Work.Cohomology.SmallChains
import Submission.Work.Cohomology.SdIter
import Submission.Work.Cohomology.exists_iter_small
import Submission.Work.Cohomology.exists_small_homotopy
import Submission.Work.Cohomology.Sd_isSmallChain

/-!
# Auxiliaries for the small-simplices theorem

This file collects the ingredients of the proof that the inclusion of the small chains of an
open cover `X = U ∪ V` into the singular chains of `X` induces an isomorphism on homology
(`Work.Cohomology.smallChains_homology_iso`).

* `sdChainMapIter_add`, `sdChainMapIter_f_apply`, `iter_sd_small` — calculus with the iterated
  barycentric subdivision;
* `mem_of_gen` — the singular chains are generated by the simplices;
* `exists_iter_small_chain` — some iterate of the subdivision sends any chain into the small
  chains;
* `smallProj`, `smallToSing_f_injective` — the inclusion of the small chains is degreewise
  injective;
* `homotopy_apply_eq` — the elementwise form of the chain homotopy `Sd^N ~ id`;
* `exists_d_eq_of_smallToSing_eq`, `exists_smallToSing_add_d` — the two elementwise statements
  which are the content of the small-simplices theorem: a cycle of small chains whose image is a
  boundary is a boundary (`El-Mono`), and every cycle of `X` differs from a small cycle by a
  boundary (`El-Epi`).
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000
set_option linter.style.haveILetI false
set_option linter.unnecessarySimpa false

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

variable {X : TopCat}

/-! ## Calculus with the iterated subdivision -/

/-- The iterates of the subdivision compose: `Sd^{a+b} = Sd^a ≫ Sd^b`. -/
theorem sdChainMapIter_add (X : TopCat) (a b : ℕ) :
    sdChainMapIter X (a + b) = sdChainMapIter X a ≫ sdChainMapIter X b := by
  induction b with
  | zero => simp [sdChainMapIter_zero]
  | succ b ih =>
    rw [Nat.add_succ, sdChainMapIter_succ, ih, sdChainMapIter_succ]
    simp only [Category.assoc]

/-- The application of an iterate, in terms of the two factors. -/
theorem sdChainMapIter_f_apply (X : TopCat) (a b n : ℕ) (x : (singularChains ℤ X).X n) :
    (ModuleCat.Hom.hom ((sdChainMapIter X (a + b)).f n)) x
      = (ModuleCat.Hom.hom ((sdChainMapIter X b).f n))
          ((ModuleCat.Hom.hom ((sdChainMapIter X a).f n)) x) := by
  rw [sdChainMapIter_add X a b]
  rfl

/-- Iterates of the subdivision preserve small chains. -/
theorem iter_sd_small (U V : Set X) {n : ℕ} {c : (singularChains ℤ X).X n} (N : ℕ)
    (hc : IsSmallChain U V c) : IsSmallChain U V ((sdChainMapIter X N).f n c) := by
  induction N with
  | zero => simpa [sdChainMapIter_zero] using hc
  | succ N ih =>
    rw [sdChainMapIter_succ]
    show IsSmallChain U V (Sd X n ((sdChainMapIter X N).f n c))
    exact Sd_mem X U V ih

/-! ## The generators span the singular chains -/

/-- **A submodule of the singular chains which contains every generator is everything.** -/
theorem mem_of_gen (X : TopCat) (n : ℕ) (P : Submodule ℤ ↥((singularChains ℤ X).X n))
    (hgen : ∀ σ : (TopCat.toSSet.obj X) _⦋n⦌, gen X n σ ∈ P) : P = ⊤ := by
  letI : Module ℤ (↥((singularChains ℤ X).X n) ⧸ P) := Submodule.Quotient.module P
  let q : (singularChains ℤ X).X n ⟶ ModuleCat.of ℤ (↥((singularChains ℤ X).X n) ⧸ P) :=
    ModuleCat.ofHom (Submodule.mkQ P)
  have hleg : ∀ σ : (TopCat.toSSet.obj X) _⦋n⦌,
      (TopCat.toSSet.obj X).ιChainComplex (R := ModuleCat.of ℤ ℤ) σ ≫ q = 0 := by
    intro σ
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_zero,
      LinearMap.zero_apply]
    show Submodule.Quotient.mk (gen X n σ) = 0
    rw [Submodule.Quotient.mk_eq_zero]
    exact hgen σ
  have hq : q = 0 := by
    apply SSet.chainComplex_hom_ext (X := TopCat.toSSet.obj X) (R := ModuleCat.of ℤ ℤ) (n := n)
    intro σ
    simpa using hleg σ
  refine Submodule.eq_top_iff'.mpr fun c => ?_
  have h2 : ModuleCat.Hom.hom q c = ModuleCat.Hom.hom (0 : (singularChains ℤ X).X n ⟶
      ModuleCat.of ℤ (↥((singularChains ℤ X).X n) ⧸ P)) c := by rw [hq]
  rw [ModuleCat.hom_zero, LinearMap.zero_apply] at h2
  have h3 : ModuleCat.Hom.hom q = Submodule.mkQ P := rfl
  rw [h3, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h2
  exact h2

/-! ## A high enough iterate lands in the small chains -/

/-- **Some iterate of the subdivision sends any chain into the small chains.** -/
theorem exists_iter_small_chain (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hcov : U ∪ V = Set.univ) (n : ℕ) (c : (singularChains ℤ X).X n) :
    ∃ N, IsSmallChain U V ((sdChainMapIter X N).f n c) := by
  let P : Submodule ℤ ↥((singularChains ℤ X).X n) :=
    ⨆ N, Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
      (smallChainSubmodule U V n)
  have hgen : ∀ σ : (TopCat.toSSet.obj X) _⦋n⦌, gen X n σ ∈ P := by
    intro σ
    obtain ⟨N, hN⟩ := exists_iter_small U V hU hV hcov n σ
    exact le_iSup (fun N => Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
      (smallChainSubmodule U V n)) N hN
  have htop : P = ⊤ := mem_of_gen X n P hgen
  have hdir : Directed (· ≤ ·)
      (fun N => Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
        (smallChainSubmodule U V n)) := by
    intro N M
    refine ⟨N + M, ?_, ?_⟩
    · rintro x hx
      rw [Submodule.mem_comap] at hx ⊢
      rw [sdChainMapIter_f_apply X N M n x]
      exact iter_sd_small U V M hx
    · rintro x hx
      rw [Submodule.mem_comap] at hx ⊢
      rw [show N + M = M + N from Nat.add_comm N M, sdChainMapIter_f_apply X M N n x]
      exact iter_sd_small U V N hx
  have hmem : c ∈ P := by
    rw [htop]
    exact Submodule.mem_top
  rw [Submodule.mem_iSup_of_directed _ hdir] at hmem
  obtain ⟨N, hN⟩ := hmem
  exact ⟨N, hN⟩

/-! ## The inclusion of the small chains is degreewise injective -/

/-- The projection from all singular chains onto the small chains which sends a simplex to itself
if it is small, and to `0` otherwise. -/
noncomputable def smallProj (U V : Set X) (n : ℕ) :
    (singularChains ℤ X).X n ⟶ (smallChains U V).X n := by
  classical
  exact ((TopCat.toSSet.obj X).isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n).desc
    (Cofan.mk _ (fun σ : (TopCat.toSSet.obj X) _⦋n⦌ =>
      if h : IsSmall U V σ then (smallSSet U V).ιChainComplex ⟨σ, h⟩ else 0))

/-- `smallProj` is a left inverse of the inclusion of the small chains; hence that inclusion is
degreewise injective. -/
theorem smallToSing_f_injective (U V : Set X) (n : ℕ) :
    Function.Injective ((smallToSing U V).f n).hom := by
  classical
  have hfac : ∀ σ : (TopCat.toSSet.obj X) _⦋n⦌,
      (TopCat.toSSet.obj X).ιChainComplex (R := ModuleCat.of ℤ ℤ) σ ≫ smallProj U V n
        = if h : IsSmall U V σ then (smallSSet U V).ιChainComplex ⟨σ, h⟩ else 0 :=
    fun σ => Cofan.IsColimit.fac _ _ _
  have hcomp : (smallToSing U V).f n ≫ smallProj U V n = 𝟙 ((smallChains U V).X n) := by
    apply SSet.chainComplex_hom_ext (X := smallSSet U V) (R := ModuleCat.of ℤ ℤ) (n := n)
    intro x
    have h1 : (smallSSet U V).ιChainComplex (R := ModuleCat.of ℤ ℤ) x ≫ (smallToSing U V).f n
        = (TopCat.toSSet.obj X).ιChainComplex (R := ModuleCat.of ℤ ℤ) x.1 := by
      have h := SSet.ι_chainComplexMap_f (f := (smallSubcomplex U V).ι) (R := ModuleCat.of ℤ ℤ)
        (X := smallSSet U V) (Y := TopCat.toSSet.obj X) (n := n) x
      simpa using h
    rw [← Category.assoc, h1, hfac]
    split_ifs with h
    · simp
    · exact absurd x.2 h
  intro a b hab
  have key := congrArg (fun (g : (smallChains U V).X n ⟶ (smallChains U V).X n) =>
      (ModuleCat.Hom.hom g) a) hcomp
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_id, LinearMap.id_apply] at key
  rw [hab] at key
  have key2 := congrArg (fun (g : (smallChains U V).X n ⟶ (smallChains U V).X n) =>
      (ModuleCat.Hom.hom g) b) hcomp
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply, ModuleCat.hom_id, LinearMap.id_apply] at key2
  exact key.symm.trans key2

/-! ## The elementwise chain homotopy formula -/

/-- **The homotopy formula**, evaluated on an element: if `T : Sd^N ~ id`, then for every chain
`x` of degree `n`,
`Sd^N x = T(∂x) + ∂(T x) + x`. -/
theorem homotopy_apply_eq (X : TopCat) (N n : ℕ)
    (T : Homotopy (sdChainMapIter X N) (𝟙 (singularChains ℤ X)))
    (x : (singularChains ℤ X).X n) :
    (ModuleCat.Hom.hom ((sdChainMapIter X N).f n)) x
      = (ModuleCat.Hom.hom (T.hom (n-1) n))
          ((ModuleCat.Hom.hom ((singularChains ℤ X).d n (n-1))) x)
        + (ModuleCat.Hom.hom ((singularChains ℤ X).d (n+1) n))
          ((ModuleCat.Hom.hom (T.hom n (n+1))) x)
        + x := by
  have h := T.comm n
  rw [dNext_nat (singularChains ℤ X) (singularChains ℤ X) n T.hom] at h
  rw [prevD_eq T.hom (show (ComplexShape.down ℕ).Rel (n+1) n from rfl)] at h
  have h2 := congrArg (fun (f : (singularChains ℤ X).X n ⟶ (singularChains ℤ X).X n) =>
    (ModuleCat.Hom.hom f) x) h
  simp only [ModuleCat.hom_add, LinearMap.add_apply, HomologicalComplex.id_f, ModuleCat.hom_id,
    LinearMap.id_apply, ModuleCat.hom_comp, LinearMap.comp_apply] at h2
  exact h2

/-! ## The two elementwise steps of the small-simplices theorem -/

/-- **El-Mono.**  A cycle of small chains whose image in the singular chains of `X` is a boundary
is itself a boundary.  This is the injectivity half of the small-simplices theorem. -/
theorem exists_d_eq_of_smallToSing_eq (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hcov : U ∪ V = Set.univ) (n : ℕ) {z : (smallChains U V).X n}
    (hz : ((smallChains U V).d n (n-1)) z = 0)
    {a : (singularChains ℤ X).X (n+1)}
    (ha : ((smallToSing U V).f n) z = ((singularChains ℤ X).d (n+1) n) a) :
    ∃ w : (smallChains U V).X (n+1), ((smallChains U V).d (n+1) n) w = z := by
  obtain ⟨N, hN⟩ := exists_iter_small_chain U V hU hV hcov (n+1) a
  obtain ⟨b, hb⟩ := hN
  obtain ⟨T, hT⟩ := exists_small_homotopy X U V N
  obtain ⟨b', hb'⟩ := hT n (((smallToSing U V).f n) z) ⟨z, rfl⟩
  have hcomm : ∀ (m : ℕ) (c : (smallChains U V).X (m+1)),
      ((singularChains ℤ X).d (m+1) m) (((smallToSing U V).f (m+1)) c)
        = ((smallToSing U V).f m) (((smallChains U V).d (m+1) m) c) := by
    intro m c
    have h := congrArg (fun (g : (smallChains U V).X (m+1) ⟶ (singularChains ℤ X).X m) =>
      g c) (HomologicalComplex.Hom.comm (smallToSing U V) (m+1) m)
    simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using h
  have hiter : ((singularChains ℤ X).d (n+1) n) (((sdChainMapIter X N).f (n+1)) a)
      = ((sdChainMapIter X N).f n) (((singularChains ℤ X).d (n+1) n) a) := by
    have h := congrArg (fun (g : (singularChains ℤ X).X (n+1) ⟶ (singularChains ℤ X).X n) =>
      g a) (HomologicalComplex.Hom.comm (sdChainMapIter X N) (n+1) n)
    simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using h
  have hzero : ((singularChains ℤ X).d n (n-1)) (((smallToSing U V).f n) z) = 0 := by
    have h := congrArg (fun (g : (smallChains U V).X n ⟶ (singularChains ℤ X).X (n-1)) =>
      g z) (HomologicalComplex.Hom.comm (smallToSing U V) n (n-1))
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply, hz, map_zero] at h
    exact h
  have key : ((smallChains U V).d (n+1) n) b = ((smallChains U V).d (n+1) n) b' + z := by
    apply smallToSing_f_injective U V n
    calc ((smallToSing U V).f n) (((smallChains U V).d (n+1) n) b)
        = ((singularChains ℤ X).d (n+1) n) (((smallToSing U V).f (n+1)) b) := (hcomm n b).symm
      _ = ((singularChains ℤ X).d (n+1) n) (((sdChainMapIter X N).f (n+1)) a) := by rw [hb]
      _ = ((sdChainMapIter X N).f n) (((singularChains ℤ X).d (n+1) n) a) := hiter
      _ = ((sdChainMapIter X N).f n) (((smallToSing U V).f n) z) := by rw [ha]
      _ = ((singularChains ℤ X).d (n+1) n) ((T.hom n (n+1)) (((smallToSing U V).f n) z))
            + ((smallToSing U V).f n) z := by
          rw [homotopy_apply_eq X N n T (((smallToSing U V).f n) z), hzero, map_zero, zero_add]
      _ = ((smallToSing U V).f n) (((smallChains U V).d (n+1) n) b')
            + ((smallToSing U V).f n) z := by
          rw [← hb', hcomm n b']
      _ = ((smallToSing U V).f n) (((smallChains U V).d (n+1) n) b' + z) := by rw [map_add]
  refine ⟨b - b', ?_⟩
  rw [map_sub, key]
  abel

/-- **El-Epi.**  Every cycle of the singular chains of `X` differs from a cycle of small chains by
a boundary.  This is the surjectivity half of the small-simplices theorem. -/
theorem exists_smallToSing_add_d (U V : Set X) (hU : IsOpen U) (hV : IsOpen V)
    (hcov : U ∪ V = Set.univ) (n : ℕ) {z : (singularChains ℤ X).X n}
    (hz : ((singularChains ℤ X).d n (n-1)) z = 0) :
    ∃ (c : (smallChains U V).X n) (b : (singularChains ℤ X).X (n+1)),
      ((smallChains U V).d n (n-1)) c = 0 ∧
        ((smallToSing U V).f n) c = z + ((singularChains ℤ X).d (n+1) n) b := by
  obtain ⟨N, hN⟩ := exists_iter_small_chain U V hU hV hcov n z
  obtain ⟨c, hc⟩ := hN
  obtain ⟨T, _hT⟩ := exists_small_homotopy X U V N
  have hcycle : ((smallChains U V).d n (n-1)) c = 0 := by
    have hcomm : ((smallToSing U V).f (n-1)) (((smallChains U V).d n (n-1)) c)
        = ((singularChains ℤ X).d n (n-1)) (((smallToSing U V).f n) c) := by
      have h := congrArg (fun (g : (smallChains U V).X n ⟶ (singularChains ℤ X).X (n-1)) =>
        g c) (HomologicalComplex.Hom.comm (smallToSing U V) n (n-1))
      simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using h.symm
    have hiter : ((singularChains ℤ X).d n (n-1)) (((sdChainMapIter X N).f n) z)
        = ((sdChainMapIter X N).f (n-1)) (((singularChains ℤ X).d n (n-1)) z) := by
      have h := congrArg (fun (g : (singularChains ℤ X).X n ⟶ (singularChains ℤ X).X (n-1)) =>
        g z) (HomologicalComplex.Hom.comm (sdChainMapIter X N) n (n-1))
      simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using h
    have h2 : ((smallToSing U V).f (n-1)) (((smallChains U V).d n (n-1)) c)
        = ((smallToSing U V).f (n-1)) 0 := by
      rw [map_zero, hcomm, hc, hiter, hz, map_zero]
    exact smallToSing_f_injective U V (n-1) h2
  refine ⟨c, ((T.hom n (n+1)) z), hcycle, ?_⟩
  calc ((smallToSing U V).f n) c
      = ((sdChainMapIter X N).f n) z := hc
    _ = ((singularChains ℤ X).d (n+1) n) ((T.hom n (n+1)) z) + z := by
        rw [homotopy_apply_eq X N n T z, hz, map_zero, zero_add]
    _ = z + ((singularChains ℤ X).d (n+1) n) ((T.hom n (n+1)) z) := by
        rw [add_comm]


end

end Work.Cohomology
