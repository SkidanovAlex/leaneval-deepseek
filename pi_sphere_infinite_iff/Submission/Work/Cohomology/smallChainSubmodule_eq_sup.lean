import Mathlib
import Submission.Work.Cohomology.SingBridge
import Submission.Work.Cohomology.SmallChains
import Submission.Work.Cohomology.HomologyPairSequence
import Submission.Work.Cohomology.existsSmallChainsContraction
import Submission.Work.Cohomology.smallLift_cov

/-!
# The small chains of a two-element cover are the sum of the chains of the members

Let `X` be a topological space and `U, V ⊆ X`.  The singular chains of a subspace are generated by
the generators `gen X n σ` of the singular simplices, so each of the submodules
`range ((inclChains X U).f n)` is spanned by the generators of the simplices of `X` whose image is
contained in `U`.  A simplex is *small* for `(U, V)` exactly when its image is contained in `U` or
in `V`, hence

  `smallChainSubmodule U V n = range ((inclChains X U).f n) ⊔ range ((inclChains X V).f n)`.

The two inclusions are proven on generators:

* `⊆`: the generators of the small chain complex are the small  simplices; a small simplex lies in
  `U` or in `V`, so its generator is in the corresponding range.  This uses the descent principle
  `Ct.mem_of_gen_SSet` for the simplicial set `smallSSet U V` together with
  `isSmallChain_gen`/`gen_mem_sup_range_incl`.
* `⊇`: a generator of `C_n(U)` is the image of the generator of a simplex of `U`, whose image in
  `X` is contained in `U`, hence small; this is `mem_of_gen` for the space `TopCat.of U` together
  with `isSmallChain_gen` and `isSmall_of_subset_range`.

This identification is what makes the Mayer–Vietoris cochain sequence of a two-element cover
transparent at the level of chains: the small chains are literally the sum of the chains supported
in the two members of the cover.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

variable {X : TopCat}

/-- A singular simplex of `A ⊆ X`, viewed as a simplex of `X`, has image contained in `A`: this is
the `Set.range` form of the smallness of such a simplex. -/
theorem range_subtypeIncl_subset {A : Set X} {n : ℕ} (τ : Simplex (TopCat.of A) n) :
    Set.range (fun z : stdSimplex ℝ (Fin (n + 1)) =>
      TopCat.toSSetObjEquivT X (Opposite.op ⦋n⦌)
        ((TopCat.toSSet.map (subtypeIncl X A)).app (Opposite.op ⦋n⦌) τ) z) ⊆ A := by
  rintro y ⟨z, rfl⟩
  exact (TopCat.toSSetObjEquivT (TopCat.of A) (Opposite.op ⦋n⦌) τ z).2

/-- If `A` is contained in one of the members of the cover `(U, V)`, then every singular simplex of
`A`, viewed as a simplex of `X`, is small for `(U, V)`. -/
theorem isSmall_of_subset_range {A U V : Set X} (hA : A ⊆ U ∨ A ⊆ V) {n : ℕ}
    (τ : Simplex (TopCat.of A) n) :
    IsSmall U V ((TopCat.toSSet.map (subtypeIncl X A)).app (Opposite.op ⦋n⦌) τ) :=
  hA.imp (fun h => (range_subtypeIncl_subset τ).trans h)
    (fun h => (range_subtypeIncl_subset τ).trans h)

/-- **The generator of a small simplex lies in the sum of the chains of the members of the cover.** -/
theorem gen_mem_sup_range_incl (U V : Set X) {n : ℕ} {σ : Simplex X n}
    (h : IsSmall U V σ) :
    gen X n σ ∈ LinearMap.range (((inclChains X U).f n).hom)
      ⊔ LinearMap.range (((inclChains X V).f n).hom) := by
  have key : ∀ A : Set X, (Set.range (fun z : stdSimplex ℝ (Fin (n + 1)) =>
        TopCat.toSSetObjEquivT X (Opposite.op ⦋n⦌) σ z) ⊆ A) →
      gen X n σ ∈ LinearMap.range (((inclChains X A).f n).hom) := by
    intro A hA
    obtain ⟨a, ha⟩ := exists_map_inclUX_of_range_subset A (Opposite.op ⦋n⦌) σ hA
    refine ⟨gen (TopCat.of A) n a, ?_⟩
    have h2 : (TopCat.toSSet.map (subtypeIncl X A)).app (Opposite.op ⦋n⦌) a
        = (TopCat.toSSet.map (inclUX A)).app (Opposite.op ⦋n⦌) a := rfl
    have h1 := chainComplexMap_ι_apply (TopCat.toSSet.map (subtypeIncl X A)) n a (1 : ℤ)
    rw [h2, ha] at h1
    exact h1
  rcases h with h | h
  · exact Submodule.mem_sup_left (key U h)
  · exact Submodule.mem_sup_right (key V h)

/-- **The small chains are the sum of the chains of the two members of the cover.** -/
theorem smallChainSubmodule_eq_sup {X : TopCat} (U V : Set X) (n : ℕ) :
    Work.Cohomology.smallChainSubmodule U V n =
      LinearMap.range (((Work.Cohomology.inclChains X U).f n).hom)
        ⊔ LinearMap.range (((Work.Cohomology.inclChains X V).f n).hom) := by
  refine le_antisymm ?_ ?_
  · -- a small chain is the sum of a chain of `U` and a chain of `V`
    intro c hc
    obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hc
    have hP : Submodule.comap (ModuleCat.Hom.hom ((smallToSing U V).f n))
        (LinearMap.range ((inclChains X U).f n).hom
          ⊔ LinearMap.range ((inclChains X V).f n).hom) = ⊤ := by
      refine Ct.mem_of_gen_SSet (Y := smallSSet U V) (n := n) _ ?_
      intro y
      refine Submodule.mem_comap.mpr ?_
      rw [smallToSing_gen y]
      exact gen_mem_sup_range_incl U V y.2
    exact Submodule.mem_comap.mp (by rw [hP]; exact Submodule.mem_top)
  · refine sup_le ?_ ?_
    · -- the chains of `U` are small
      intro c hc
      obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hc
      have hP : Submodule.comap (ModuleCat.Hom.hom ((inclChains X U).f n))
          (smallChainSubmodule U V n) = ⊤ := by
        refine mem_of_gen (TopCat.of U) n _ ?_
        intro τ
        refine Submodule.mem_comap.mpr ?_
        have hgen : (ModuleCat.Hom.hom ((inclChains X U).f n)) (gen (TopCat.of U) n τ)
            = gen X n ((TopCat.toSSet.map (subtypeIncl X U)).app (Opposite.op ⦋n⦌) τ) :=
          chainComplexMap_ι_apply (TopCat.toSSet.map (subtypeIncl X U)) n τ 1
        rw [hgen]
        exact isSmallChain_gen (isSmall_of_subset_range (A := U) (Or.inl (le_refl U)) τ)
      exact Submodule.mem_comap.mp (by rw [hP]; exact Submodule.mem_top)
    · -- the chains of `V` are small
      intro c hc
      obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hc
      have hP : Submodule.comap (ModuleCat.Hom.hom ((inclChains X V).f n))
          (smallChainSubmodule U V n) = ⊤ := by
        refine mem_of_gen (TopCat.of V) n _ ?_
        intro τ
        refine Submodule.mem_comap.mpr ?_
        have hgen : (ModuleCat.Hom.hom ((inclChains X V).f n)) (gen (TopCat.of V) n τ)
            = gen X n ((TopCat.toSSet.map (subtypeIncl X V)).app (Opposite.op ⦋n⦌) τ) :=
          chainComplexMap_ι_apply (TopCat.toSSet.map (subtypeIncl X V)) n τ 1
        rw [hgen]
        exact isSmallChain_gen (isSmall_of_subset_range (A := V) (Or.inr (le_refl V)) τ)
      exact Submodule.mem_comap.mp (by rw [hP]; exact Submodule.mem_top)

end

end Work.Cohomology
