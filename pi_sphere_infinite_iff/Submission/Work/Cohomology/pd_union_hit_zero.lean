/-!
# The degree-zero case of the surjectivity of the gluing for `Good`

`Work.Cohomology.pd_union_hit_zero` is the special case `k = N`, `m = 0` of the surjectivity
clause `Work.Cohomology.pd_union_hit` of the two-cover gluing
`Good U → Good V → Good (U∩V) → Good (U∪V)`.

Its content: for `W = U ∪ V` and every `y ∈ H_0(W)` there are a compact `K ⊆ W` and a class
`x ∈ H^N(W, W∖K)` with `x ⌢ μ_K = y`.

The point of the degree-zero case is that it needs no five-lemma/Mayer–Vietoris chase of the
general case: `H_0` of `W` is generated by the images of `H_0(U)` and `H_0(V)`, because *every*
point of `W` lies in `U` or in `V`.  Concretely:

* the Mayer–Vietoris map `C_*(U) ⊞ C_*(V) → C^{U,V}_*(M)` is surjective in degree `0`
  (`mv_degreewise`), hence so is the map it induces on `H_0` (`epi_homologyMap_of_cycles`);
* composing with the corestriction `Φ : C^{U,V}_*(M) → C_*(U ∪ V)` of `pd_small_union_iso`
  (an isomorphism on homology, and compatible with `smallOfU` and `smallOfV`) gives an
  epimorphism `H_0(U) ⊞ H_0(V) → H_0(U ∪ V)` whose two components are the inclusions;
* so every `y ∈ H_0(W)` is `a + b` with `a` in the image of `H_0(U)` and `b` in the image of
  `H_0(V)`;
* `a` (resp. `b`) is `x ⌢ μ_K` for a compact `K ⊆ U` (resp. `⊆ V`) and some `x`, by the
  surjectivity clause of `Good` for `U` (resp. `V`) in degree `0`, and pushing the class forward
  to `W` (`pd_goodD_incl`, using excision to extend it) exhibits it as a value of `goodD` on `W`;
* the two witnesses are merged by enlarging the compact sets (`pd_goodD_natural`) and adding.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

open CategoryTheory AlgebraicTopology CategoryTheory.Limits

namespace Work.Cohomology

noncomputable section

/-! ## Additivity of `goodD` in the cohomology class -/

private theorem goodD_add' {M : TopCat} [T2Space M] {N : ℕ} {c : (singularChains ℤ M).homology N}
    (W : Set M) (hW : IsOpen W) (K : Set M) (hKW : K ⊆ W) (hKc : IsCompact K)
    (k m : ℕ) (hkm : k + m = N)
    (x x' : (relComplex ℤ (TopCat.of W) (pdRelSub W K)).homology k) :
    goodD N c W hW K hKW hKc k m hkm (x + x')
      = goodD N c W hW K hKW hKc k m hkm x
        + goodD N c W hW K hKW hKc k m hkm x' := by
  simp only [goodD]
  rw [map_add, LinearMap.add_apply]

private theorem goodD_sub' {M : TopCat} [T2Space M] {N : ℕ} {c : (singularChains ℤ M).homology N}
    (W : Set M) (hW : IsOpen W) (K : Set M) (hKW : K ⊆ W) (hKc : IsCompact K)
    (k m : ℕ) (hkm : k + m = N)
    (x x' : (relComplex ℤ (TopCat.of W) (pdRelSub W K)).homology k) :
    goodD N c W hW K hKW hKc k m hkm (x - x')
      = goodD N c W hW K hKW hKc k m hkm x
        - goodD N c W hW K hKW hKc k m hkm x' := by
  simp only [goodD]
  rw [map_sub, LinearMap.sub_apply]

/-! ## The Mayer–Vietoris map is surjective on `H_0` -/

private theorem mvRight_f_zero_surj {X : TopCat} (U V : Set X) :
    Function.Surjective (ModuleCat.Hom.hom ((mvRight U V).f 0)) := by
  have hS := mv_degreewise U V 0
  have hE : Epi ((mvRight U V).f 0) := hS.epi_g
  exact (ModuleCat.epi_iff_surjective _).mp hE

private theorem mvRight_homology_zero_epi {X : TopCat} (U V : Set X) :
    Epi (HomologicalComplex.homologyMap (mvRight U V) 0) := by
  refine epi_homologyMap_of_cycles (mvRight U V) 0 ?_
  intro z _hz
  obtain ⟨c, hc⟩ := mvRight_f_zero_surj U V z
  exact ⟨c, 0, by simp, by rw [hc]; simp⟩

/-! ## Extending a class from one piece of the cover to the union -/

/-- **Pushing a realised class forward along an inclusion of open sets.**

Let `U ⊆ W ⊆ M` be open, `K ⊆ U` compact, and suppose `y ∈ H_0(U)` is `x ⌢ μ_K` for some
`x ∈ H^N(U, U∖K)`.  Then the image of `y` in `H_0(W)` is `x' ⌢ μ_K` for some `x' ∈ H^N(W, W∖K)`:
one extends `x` by the excision isomorphism `H^N(W, W∖K) ≅ H^N(U, U∖K)` and uses the naturality
`pd_goodD_incl` of the duality map in the open set. -/
private theorem hitZero_push {M : TopCat} [T2Space M] {N : ℕ}
    {c : (singularChains ℤ M).homology N}
    {U W : Set M} (hUW : U ⊆ W) (hW : IsOpen W) (hU : IsOpen U)
    {K : Set M} (hKU : K ⊆ U) (hKW : K ⊆ W) (hKc : IsCompact K)
    (y : (singularChains ℤ (TopCat.of U)).homology 0)
    (hy : ∃ x : (relComplex ℤ (TopCat.of U) (pdRelSub U K)).homology N,
        goodD N c U hU K hKU hKc N 0 (Nat.add_zero N) x = y) :
    ∃ x : (relComplex ℤ (TopCat.of W) (pdRelSub W K)).homology N,
      goodD N c W hW K hKW hKc N 0 (Nat.add_zero N) x
        = (HomologicalComplex.homologyMap
            (chainMap ℤ (TopCat.of U) (TopCat.of W) (pdIncl W U hUW)) 0) y := by
  obtain ⟨x, hx⟩ := hy
  haveI hriso : IsIso (HomologicalComplex.homologyMap
      (relComplexMap ℤ (pdRelSub U K) (pdRelSub W K) (pdIncl W U hUW)
        (fun y hy => hy)) N) :=
    pdCohExcision (M := M) (W := W) (U := U) hUW hU hW hKU hKc N
  refine ⟨CategoryTheory.inv (HomologicalComplex.homologyMap
      (relComplexMap ℤ (pdRelSub U K) (pdRelSub W K) (pdIncl W U hUW)
        (fun y hy => hy)) N) x, ?_⟩
  have hrx : (HomologicalComplex.homologyMap
      (relComplexMap ℤ (pdRelSub U K) (pdRelSub W K) (pdIncl W U hUW)
        (fun y hy => hy)) N)
      (CategoryTheory.inv (HomologicalComplex.homologyMap
        (relComplexMap ℤ (pdRelSub U K) (pdRelSub W K) (pdIncl W U hUW)
          (fun y hy => hy)) N) x) = x :=
    IsIso.inv_hom_id_apply _ x
  have hkey := pd_goodD_incl (M := M) (W := W) (V := U) hUW hW hU hKU hKW hKc N c N 0
    (Nat.add_zero N)
    (CategoryTheory.inv (HomologicalComplex.homologyMap
      (relComplexMap ℤ (pdRelSub U K) (pdRelSub W K) (pdIncl W U hUW)
        (fun y hy => hy)) N) x)
  rw [hrx, hx] at hkey
  exact hkey.symm

/-! ## The main statement -/

theorem pd_union_hit_zero {M : TopCat} [T2Space M] {N : ℕ}
    {c : (singularChains ℤ M).homology N}
    {U V : Set M} (hU : IsOpen U) (hV : IsOpen V) (hI : IsOpen (U ∩ V))
    (hUU : Good N c U hU) (hVV : Good N c V hV) (hII : Good N c (U ∩ V) hI) :
    ∀ y : (singularChains ℤ (TopCat.of ↥(U ∪ V : Set M))).homology 0,
      ∃ (K : Set M) (hKW : K ⊆ U ∪ V) (hKc : IsCompact K)
        (x : (relComplex ℤ (TopCat.of ↥(U ∪ V : Set M))
          (pdRelSub (U ∪ V : Set M) K)).homology N),
        goodD N c (U ∪ V : Set M) (hU.union hV) K hKW hKc N 0 (Nat.add_zero N) x = y := by
  intro y
  -- The corestriction of the small chains of the cover to the union.
  obtain ⟨Φ, _hΦ1, hΦ2, hΦ3, hΦ4⟩ := pd_small_union_iso (M := M) U V hU hV
  haveI hΦiso : IsIso (HomologicalComplex.homologyMap Φ 0) := hΦ2 0
  haveI hmvR : Epi (HomologicalComplex.homologyMap (mvRight U V) 0) :=
    mvRight_homology_zero_epi U V
  -- The two inclusions `H_0(U) → H_0(U∪V)` and `H_0(V) → H_0(U∪V)`.
  let T_U : pdHomSub M U 0 ⟶ pdHomSub M (U ∪ V) 0 :=
    HomologicalComplex.homologyMap
      (chainMap ℤ (TopCat.of U) (TopCat.of (U ∪ V : Set M))
        (pdIncl (U ∪ V) U Set.subset_union_left)) 0
  let T_V : pdHomSub M V 0 ⟶ pdHomSub M (U ∪ V) 0 :=
    HomologicalComplex.homologyMap
      (chainMap ℤ (TopCat.of V) (TopCat.of (U ∪ V : Set M))
        (pdIncl (U ∪ V) V Set.subset_union_right)) 0
  -- The epimorphism `H_0(U) ⊞ H_0(V) → H_0(U∪V)` assembled from Mayer–Vietoris.
  let G : pdHomBiprod M U V 0 ⟶ pdHomSub M (U ∪ V) 0 :=
    (homMVBiprodIso M U V 0).inv ≫ HomologicalComplex.homologyMap (mvRight U V) 0
      ≫ HomologicalComplex.homologyMap Φ 0
  have hGinl : (biprod.inl : pdHomSub M U 0 ⟶ pdHomBiprod M U V 0) ≫ G = T_U := by
    dsimp only [G, T_U]
    rw [← Category.assoc, homMVBiprodIso_inl, ← Category.assoc,
      ← HomologicalComplex.homologyMap_comp, mvRight, biprod.inl_desc,
      ← HomologicalComplex.homologyMap_comp, hΦ3]
  have hGinr : (biprod.inr : pdHomSub M V 0 ⟶ pdHomBiprod M U V 0) ≫ G = - T_V := by
    dsimp only [G, T_V]
    rw [← Category.assoc, homMVBiprodIso_inr, ← Category.assoc,
      ← HomologicalComplex.homologyMap_comp, mvRight, biprod.inr_desc,
      HomologicalComplex.homologyMap_neg, Preadditive.neg_comp,
      ← HomologicalComplex.homologyMap_comp, hΦ4]
  have hGform : G = biprod.fst ≫ T_U + biprod.snd ≫ (- T_V) := by
    refine biprod.hom_ext' G (biprod.fst ≫ T_U + biprod.snd ≫ (- T_V)) ?_ ?_
    · rw [hGinl, Preadditive.comp_add, biprod.inl_fst_assoc, biprod.inl_snd_assoc]
      simp
    · rw [hGinr, Preadditive.comp_add, biprod.inr_fst_assoc, biprod.inr_snd_assoc]
      simp
  have hrange_le : Submodule.map (ModuleCat.Hom.hom G) ⊤
      ≤ Submodule.map (ModuleCat.Hom.hom T_U) ⊤
        ⊔ Submodule.map (ModuleCat.Hom.hom T_V) ⊤ := by
    have hlin : ModuleCat.Hom.hom G
        = ModuleCat.Hom.hom (biprod.fst ≫ T_U)
          + ModuleCat.Hom.hom (biprod.snd ≫ (- T_V)) := by
      rw [hGform, ModuleCat.hom_add]
    rw [hlin]
    refine le_trans (Submodule.map_add_le ⊤ _ _) ?_
    apply sup_le
    · rw [ModuleCat.hom_comp, Submodule.map_comp]
      exact le_trans (Submodule.map_mono le_top) le_sup_left
    · rw [ModuleCat.hom_comp, ModuleCat.hom_neg, Submodule.map_comp]
      refine le_trans (Submodule.map_mono le_top) ?_
      rw [Submodule.map_neg]
      exact le_sup_right
  have hGepi : Epi G := by
    haveI h23 : Epi (HomologicalComplex.homologyMap (mvRight U V) 0
        ≫ HomologicalComplex.homologyMap Φ 0) := epi_comp _ _
    dsimp only [G]
    exact epi_comp _ _
  have hmapG : Submodule.map (ModuleCat.Hom.hom G) ⊤ = ⊤ := by
    rw [Submodule.map_top, LinearMap.range_eq_top]
    exact (ModuleCat.epi_iff_surjective G).mp hGepi
  have htop : (⊤ : Submodule ℤ (pdHomSub M (U ∪ V) 0))
      ≤ Submodule.map (ModuleCat.Hom.hom T_U) ⊤
        ⊔ Submodule.map (ModuleCat.Hom.hom T_V) ⊤ :=
    le_trans (le_of_eq hmapG.symm) hrange_le
  -- The surjectivity of `Good` for `U` and for `V`, transported to `W = U ∪ V`.
  have hTUm : ∀ a : pdHomSub M U 0,
      ∃ (K : Set M) (hKW : K ⊆ U ∪ V) (hKc : IsCompact K)
        (x : (relComplex ℤ (TopCat.of ↥(U ∪ V : Set M))
          (pdRelSub (U ∪ V : Set M) K)).homology N),
        goodD N c (U ∪ V : Set M) (hU.union hV) K hKW hKc N 0 (Nat.add_zero N) x
          = (HomologicalComplex.homologyMap
              (chainMap ℤ (TopCat.of U) (TopCat.of (U ∪ V : Set M))
                (pdIncl (U ∪ V) U Set.subset_union_left)) 0) a := by
    intro a
    obtain ⟨K, hKU, hKc, x, hx⟩ := (hUU N 0 (Nat.add_zero N)).1 a
    refine ⟨K, hKU.trans Set.subset_union_left, hKc, ?_⟩
    exact hitZero_push (M := M) Set.subset_union_left (hU.union hV) hU hKU
      (hKU.trans Set.subset_union_left) hKc a ⟨x, hx⟩
  have hTVm : ∀ b : pdHomSub M V 0,
      ∃ (K : Set M) (hKW : K ⊆ U ∪ V) (hKc : IsCompact K)
        (x : (relComplex ℤ (TopCat.of ↥(U ∪ V : Set M))
          (pdRelSub (U ∪ V : Set M) K)).homology N),
        goodD N c (U ∪ V : Set M) (hU.union hV) K hKW hKc N 0 (Nat.add_zero N) x
          = (HomologicalComplex.homologyMap
              (chainMap ℤ (TopCat.of V) (TopCat.of (U ∪ V : Set M))
                (pdIncl (U ∪ V) V Set.subset_union_right)) 0) b := by
    intro b
    obtain ⟨K, hKV, hKc, x, hx⟩ := (hVV N 0 (Nat.add_zero N)).1 b
    refine ⟨K, hKV.trans Set.subset_union_right, hKc, ?_⟩
    exact hitZero_push (M := M) Set.subset_union_right (hU.union hV) hV hKV
      (hKV.trans Set.subset_union_right) hKc b ⟨x, hx⟩
  -- Decompose `y` over the two pieces.
  obtain ⟨a₁, ha₁, a₂, ha₂, ha₁₂⟩ := Submodule.mem_sup.mp (htop Submodule.mem_top)
  obtain ⟨a, -, ha⟩ := Submodule.mem_map.mp ha₁
  obtain ⟨b, -, hb⟩ := Submodule.mem_map.mp ha₂
  obtain ⟨Ka, hKaW, hKac, xa, hxa⟩ := hTUm a
  obtain ⟨Kb, hKbW, hKbc, xb, hxb⟩ := hTVm b
  have hKWc : Ka ∪ Kb ⊆ U ∪ V := Set.union_subset hKaW hKbW
  refine ⟨Ka ∪ Kb, hKWc, hKac.union hKbc,
    (HomologicalComplex.homologyMap
        (pdRelComplexEnlarge (U ∪ V) (Set.subset_union_left : Ka ⊆ Ka ∪ Kb)) N) xa
      + (HomologicalComplex.homologyMap
        (pdRelComplexEnlarge (U ∪ V) (Set.subset_union_right : Kb ⊆ Ka ∪ Kb)) N) xb, ?_⟩
  rw [goodD_add',
    pd_goodD_natural N c (U ∪ V) (hU.union hV) (Set.subset_union_left : Ka ⊆ Ka ∪ Kb)
      hKaW hKWc hKac (hKac.union hKbc) N 0 (Nat.add_zero N) xa,
    pd_goodD_natural N c (U ∪ V) (hU.union hV) (Set.subset_union_right : Kb ⊆ Ka ∪ Kb)
      hKbW hKWc hKbc (hKac.union hKbc) N 0 (Nat.add_zero N) xb,
    hxa, hxb]
  have ha' : (HomologicalComplex.homologyMap
      (chainMap ℤ (TopCat.of U) (TopCat.of (U ∪ V : Set M))
        (pdIncl (U ∪ V) U Set.subset_union_left)) 0) a = a₁ := ha
  have hb' : (HomologicalComplex.homologyMap
      (chainMap ℤ (TopCat.of V) (TopCat.of (U ∪ V : Set M))
        (pdIncl (U ∪ V) V Set.subset_union_right)) 0) b = a₂ := hb
  rw [ha', hb']
  exact ha₁₂

end

end Work.Cohomology
