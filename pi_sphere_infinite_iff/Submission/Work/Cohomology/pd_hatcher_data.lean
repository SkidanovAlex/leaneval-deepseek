/-!
# The "small cycle" data for the Poincaré–Lefschetz gluing

This file proves `Work.Cohomology.pd_hatcher_data`: given a homology class `c ∈ H_N(M)` and open
sets `U, V ⊆ M` with compact `K ⊆ U`, `L ⊆ V`, there is a cycle `w` representing `c` whose
underlying chain splits as `a + b + d + j` with the four summands supported in `U ∖ L`, `U ∩ V`,
`V ∖ K` and `(K ∪ L)ᶜ` respectively.

The four sets are open and cover `M`.  The proof is the classical small-simplices argument for the
finite open cover they form: some iterate of the barycentric subdivision of any chain is a sum of
simplices each lying in one of the four sets, and the subdivision is chain homotopic to the
identity, so the class of the subdivided cycle is unchanged.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1600000
set_option linter.style.haveILetI false
set_option linter.unusedSimpArgs false

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

variable {X : TopCat}

/-! ## Smallness for a family of subsets -/

/-- A singular simplex is **small** for a family of sets if its image is contained in one of the
members of the family. -/
def IsSmallFam {ι : Type*} (c : ι → Set X) {n : SimplexCategoryᵒᵖ}
    (σ : (TopCat.toSSet.obj X).obj n) : Prop :=
  ∃ i, Set.range (fun z : stdSimplex ℝ (Fin (n.unop.len + 1)) =>
    TopCat.toSSetObjEquivT X n σ z) ⊆ c i

/-- The `ℕ`-indexed form of `IsSmallFam`, in terms of the continuous map `sdMap`. -/
theorem isSmallFam_iff {ι : Type*} {c : ι → Set X} {k : ℕ} (σ : Simplex X k) :
    IsSmallFam c σ ↔
      ∃ i, Set.range (fun z : (Delta k : TopCat) => sdMap k σ z) ⊆ c i := Iff.rfl

/-- **The submodule of chains decomposed along a family**: the submodule of `n`-chains generated by
the images of the chains of the members of the family. -/
def smallChainSubmoduleFam {ι : Type*} (c : ι → Set X) (n : ℕ) :
    Submodule ℤ ((singularChains ℤ X).X n) :=
  ⨆ i, LinearMap.range (((inclChains X (c i)).f n).hom)

/-- The submodule of a family is closed under integer multiples. -/
theorem smallChainSubmoduleFam_zsmul {ι : Type*} (c : ι → Set X) {n : ℕ}
    {x : (singularChains ℤ X).X n} (hx : x ∈ smallChainSubmoduleFam c n) (z : ℤ) :
    z • x ∈ smallChainSubmoduleFam c n :=
  AddSubgroup.zsmul_mem (smallChainSubmoduleFam c n).toAddSubgroup hx z

/-- A small simplex generates a chain in the submodule of the family. -/
theorem gen_mem_smallChainSubmoduleFam {ι : Type*} {c : ι → Set X} {n : ℕ} {σ : Simplex X n}
    (h : IsSmallFam c σ) : gen X n σ ∈ smallChainSubmoduleFam c n := by
  obtain ⟨i, hi⟩ := h
  refine le_iSup (fun i => LinearMap.range (((inclChains X (c i)).f n).hom)) i ?_
  obtain ⟨a, ha⟩ := exists_map_inclUX_of_range_subset (c i) (Opposite.op ⦋n⦌) σ hi
  refine ⟨gen (TopCat.of (c i)) n a, ?_⟩
  have h2 : (TopCat.toSSet.map (subtypeIncl X (c i))).app (Opposite.op ⦋n⦌) a
      = (TopCat.toSSet.map (inclUX (c i))).app (Opposite.op ⦋n⦌) a := rfl
  have h1 := chainComplexMap_ι_apply (TopCat.toSSet.map (subtypeIncl X (c i))) n a (1 : ℤ)
  rw [h2, ha] at h1
  exact h1

/-! ## The Lebesgue-number input for a family -/

/-- **Lebesgue number for a cover by a family.**  If the members of a family `c` are open and cover a
compact metric space, then there is `δ > 0` such that every nonempty set of diameter `< δ` is
contained in some member. -/
theorem lebesgue_delta_fam {Z : Type*} [PseudoMetricSpace Z] [CompactSpace Z] {ι : Type*}
    (c : ι → Set Z) (hopen : ∀ i, IsOpen (c i)) (hcover : (Set.univ : Set Z) ⊆ ⋃ i, c i) :
    ∃ δ > 0, ∀ S : Set Z, S.Nonempty →
      (∀ x ∈ S, ∀ y ∈ S, dist x y < δ) → ∃ i, S ⊆ c i := by
  obtain ⟨δ, hδpos, hδ⟩ := lebesgue_number_lemma_of_metric (s := Set.univ) (c := c)
    isCompact_univ hopen hcover
  refine ⟨δ, hδpos, ?_⟩
  intro S hS hdist
  obtain ⟨x, hxS⟩ := hS
  obtain ⟨i, hi⟩ := hδ x trivial
  exact ⟨i, fun y hy => hi (by rw [Metric.mem_ball, dist_comm]; exact hdist x hxS y hy)⟩

/-- **The Lebesgue-number statement for affine simplices.**  For a family of open sets covering `X`
and a singular simplex `σ` there is `δ > 0` such that every affine simplex of any dimension whose
vertex family has mesh `< δ` is, after being pushed forward by `σ`, contained in some member of the
family. -/
theorem exists_delta_affineSimplexFam {X : TopCat} {ι : Type*} (c : ι → Set X)
    (hopen : ∀ i, IsOpen (c i)) (hcover : (Set.univ : Set X) ⊆ ⋃ i, c i)
    (n : ℕ) (σ : Simplex X n) :
    ∃ δ > 0, ∀ (k : ℕ) (v : Fin (k + 1) → stdSimplex ℝ (Fin (n + 1))),
      meshVF v < δ → ∃ i, (Set.range (fun z : (Delta k : TopCat) =>
        sdMap n σ (affineSimplex v z)) ⊆ c i) := by
  set f : Delta n ⟶ X := sdMap n σ with hf
  have hcov : (Set.univ : Set (stdSimplex ℝ (Fin (n + 1)))) ⊆ ⋃ i, f ⁻¹' c i := by
    rw [← Set.preimage_iUnion]
    intro x hx
    exact hcover (Set.mem_univ (f x))
  obtain ⟨δ, hδpos, hδ⟩ := lebesgue_delta_fam (Z := stdSimplex ℝ (Fin (n + 1)))
    (fun i => f ⁻¹' c i) (fun i => (hopen i).preimage f.hom.continuous) hcov
  refine ⟨δ, hδpos, ?_⟩
  intro k v hv
  have hne : (Set.range (affineSimplex v)).Nonempty :=
    ⟨affineSimplex v (stdSimplex.vertex 0), Set.mem_range_self _⟩
  have hdiam : ∀ x ∈ Set.range (affineSimplex v), ∀ y ∈ Set.range (affineSimplex v),
      dist x y < δ := by
    rintro x ⟨s, rfl⟩ y ⟨t, rfl⟩
    exact lt_of_le_of_lt (dist_affineSimplex_le_meshVF v s t) hv
  obtain ⟨i, hi⟩ := hδ (Set.range (affineSimplex v)) hne hdiam
  refine ⟨i, ?_⟩
  rintro y ⟨z, rfl⟩
  exact hi ⟨z, rfl⟩

/-! ## Subdivision of a generator -/

/-- The push-forward of a subdivided affine simplex is a member of the submodule of the family. -/
lemma mem_smallChainSubmoduleFam_pushChain_gen_linSimplex {ι : Type*} (c : ι → Set X) (n : ℕ)
    (f : Delta n ⟶ X) (δ : ℝ)
    (hδ : ∀ v : Fin (n + 1) → stdSimplex ℝ (Fin (n + 1)), meshVF v < δ →
      ∃ i, Set.range (fun z : (Delta n : TopCat) => f (affineSimplex v z)) ⊆ c i)
    (v : Fin (n + 1) → stdSimplex ℝ (Fin (n + 1))) (hv : meshVF v < δ) :
    pushChain (Delta n) X f n (gen (Delta n) n (linSimplex v)) ∈ smallChainSubmoduleFam c n := by
  rw [pushChain_gen]
  apply gen_mem_smallChainSubmoduleFam
  rw [isSmallFam_iff, range_sdMap_toSSet_map_linSimplex n f v]
  exact hδ v hv

/-- **A high enough iterate of the subdivision of a simplex is small for the family.** -/
theorem exists_iter_small_fam {ι : Type*} (c : ι → Set X) (hopen : ∀ i, IsOpen (c i))
    (hcover : (Set.univ : Set X) ⊆ ⋃ i, c i) (n : ℕ) (σ : Simplex X n) :
    ∃ N, ((sdChainMapIter X N).f n).hom (gen X n σ) ∈ smallChainSubmoduleFam c n := by
  obtain ⟨δ, hδpos, hδ⟩ := exists_delta_affineSimplexFam c hopen hcover n σ
  have hlt : ((n : ℝ) / (n + 1)) < 1 := by
    rw [div_lt_one (by positivity)]
    linarith [Nat.cast_nonneg (α := ℝ) n]
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one hδpos hlt
  refine ⟨N, ?_⟩
  rw [sdChainMapIter_gen X n N σ]
  rw [toChain_apply]
  rw [map_sum]
  refine Submodule.sum_mem _ (fun v hv => ?_)
  rw [map_zsmul]
  exact smallChainSubmoduleFam_zsmul c
    (mem_smallChainSubmoduleFam_pushChain_gen_linSimplex c n (sdMap n σ) δ
      (fun v hv => hδ n v hv) v (lt_of_le_of_lt (mesh_sdIterLC n N v hv) hN)) _

/-! ## Subdivision preserves the submodule of a family -/

/-- The barycentric subdivision maps the submodule of a family into itself. -/
theorem Sd_mem_smallChainSubmoduleFam {ι : Type*} (c : ι → Set X) {n : ℕ}
    {x : (singularChains ℤ X).X n} (hx : x ∈ smallChainSubmoduleFam c n) :
    (Sd X n) x ∈ smallChainSubmoduleFam c n := by
  have hle : smallChainSubmoduleFam c n ≤
      Submodule.comap (Sd X n) (smallChainSubmoduleFam c n) := by
    apply iSup_le
    intro i
    rintro x ⟨a', rfl⟩
    rw [Submodule.mem_comap]
    have hnat := Sd_natural (TopCat.of (c i)) X (subtypeIncl X (c i)) n a'
    rw [show (pushChain (TopCat.of (c i)) X (subtypeIncl X (c i)) n) a'
        = ((inclChains X (c i)).f n).hom a' from rfl] at hnat
    rw [hnat]
    exact le_iSup (fun i => LinearMap.range (((inclChains X (c i)).f n).hom)) i
      ⟨Sd (TopCat.of (c i)) n a', rfl⟩
  exact hle hx

/-- Iterates of the subdivision map the submodule of a family into itself. -/
theorem iter_sd_mem_smallChainSubmoduleFam {ι : Type*} (c : ι → Set X) (N : ℕ) :
    ∀ (n : ℕ) {x : (singularChains ℤ X).X n}, x ∈ smallChainSubmoduleFam c n →
      ((sdChainMapIter X N).f n).hom x ∈ smallChainSubmoduleFam c n := by
  induction N with
  | zero => intro n x hx; simpa [sdChainMapIter_zero] using hx
  | succ N ih =>
    intro n x hx
    rw [sdChainMapIter_succ]
    exact Sd_mem_smallChainSubmoduleFam c (ih n hx)

/-- **Some iterate of the subdivision sends any chain into the submodule of the family.** -/
theorem exists_iter_small_chain_fam {ι : Type*} (c : ι → Set X) (hopen : ∀ i, IsOpen (c i))
    (hcover : (Set.univ : Set X) ⊆ ⋃ i, c i) (n : ℕ) (y : (singularChains ℤ X).X n) :
    ∃ N, ((sdChainMapIter X N).f n).hom y ∈ smallChainSubmoduleFam c n := by
  let P : Submodule ℤ ↥((singularChains ℤ X).X n) :=
    ⨆ N, Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
      (smallChainSubmoduleFam c n)
  have hgen : ∀ σ : (TopCat.toSSet.obj X) _⦋n⦌, gen X n σ ∈ P := by
    intro σ
    obtain ⟨N, hN⟩ := exists_iter_small_fam c hopen hcover n σ
    exact le_iSup (fun N => Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
      (smallChainSubmoduleFam c n)) N hN
  have htop : P = ⊤ := mem_of_gen X n P hgen
  have hdir : Directed (· ≤ ·)
      (fun N => Submodule.comap (ModuleCat.Hom.hom ((sdChainMapIter X N).f n))
        (smallChainSubmoduleFam c n)) := by
    intro N M
    refine ⟨N + M, ?_, ?_⟩
    · rintro y hy
      rw [Submodule.mem_comap] at hy ⊢
      rw [sdChainMapIter_f_apply X N M n y]
      exact iter_sd_mem_smallChainSubmoduleFam c M n hy
    · rintro y hy
      rw [Submodule.mem_comap] at hy ⊢
      rw [show N + M = M + N from Nat.add_comm N M, sdChainMapIter_f_apply X M N n y]
      exact iter_sd_mem_smallChainSubmoduleFam c N n hy
  have hmem : y ∈ P := by rw [htop]; exact Submodule.mem_top
  rw [Submodule.mem_iSup_of_directed _ hdir] at hmem
  obtain ⟨N, hN⟩ := hmem
  exact ⟨N, hN⟩

/-! ## Extracting four summands -/

/-- A member of a fourfold sup of submodules is a sum of four members. -/
theorem mem_sup_four {V : Type*} [AddCommMonoid V] [Module ℤ V] {p0 p1 p2 p3 : Submodule ℤ V} {x : V}
    (h : x ∈ p0 ⊔ p1 ⊔ p2 ⊔ p3) :
    ∃ a ∈ p0, ∃ b ∈ p1, ∃ d ∈ p2, ∃ j ∈ p3, a + b + d + j = x := by
  rw [Submodule.mem_sup] at h
  obtain ⟨y, hy, j, hj, hyj⟩ := h
  rw [Submodule.mem_sup] at hy
  obtain ⟨z, hz, d, hd, hzd⟩ := hy
  rw [Submodule.mem_sup] at hz
  obtain ⟨a, ha, b, hb, hab⟩ := hz
  exact ⟨a, ha, b, hb, d, hd, j, hj, by rw [← hyj, ← hzd, ← hab]⟩

/-! ## The main statement -/

theorem pd_hatcher_data {M : TopCat} [T2Space M] {N : ℕ}
    (c : (singularChains ℤ M).homology N) {U V : Set M} (hU : IsOpen U) (hV : IsOpen V)
    {K L : Set M} (hKc : IsCompact K) (hLc : IsCompact L) (hKU : K ⊆ U) (hLV : L ⊆ V) :
    ∃ (w : (singularChains ℤ M).cycles N),
      (HomologicalComplex.homologyπ (singularChains ℤ M) N w = c) ∧
      ∃ (a b d j : (singularChains ℤ M).X N),
        (singularChains ℤ M).iCycles N w = a + b + d + j ∧
        (∃ (a' : (singularChains ℤ (TopCat.of ↥(U \ L))).X N),
          (inclChains M (U \ L)).f N a' = a) ∧
        (∃ (b' : (singularChains ℤ (TopCat.of ↥(U ∩ V))).X N),
          (inclChains M (U ∩ V)).f N b' = b) ∧
        (∃ (d' : (singularChains ℤ (TopCat.of ↥(V \ K))).X N),
          (inclChains M (V \ K)).f N d' = d) ∧
        (∃ (j' : (singularChains ℤ (TopCat.of ↥((K ∪ L)ᶜ))).X N),
          (inclChains M ((K ∪ L)ᶜ)).f N j' = j) := by
  classical
  -- the family of the four open sets
  let c4 : Fin 4 → Set M := ![U \ L, U ∩ V, V \ K, (K ∪ L)ᶜ]
  have hcopen : ∀ i, IsOpen (c4 i) := by
    intro i
    fin_cases i
    · exact hU.sdiff hLc.isClosed
    · exact hU.inter hV
    · exact hV.sdiff hKc.isClosed
    · exact (hKc.isClosed.union hLc.isClosed).isOpen_compl
  have hcover4 : ∀ x : M, x ∈ U \ L ∨ x ∈ U ∩ V ∨ x ∈ V \ K ∨ x ∈ (K ∪ L)ᶜ := by
    intro x
    by_cases hxK : x ∈ K
    · by_cases hxL : x ∈ L
      · exact Or.inr (Or.inl ⟨hKU hxK, hLV hxL⟩)
      · exact Or.inl ⟨hKU hxK, hxL⟩
    · by_cases hxL : x ∈ L
      · by_cases hxU : x ∈ U
        · exact Or.inr (Or.inl ⟨hxU, hLV hxL⟩)
        · exact Or.inr (Or.inr (Or.inl ⟨hLV hxL, hxK⟩))
      · exact Or.inr (Or.inr (Or.inr (by
          rw [Set.mem_compl_iff, Set.mem_union]; exact fun h => h.elim hxK hxL)))
  have hcover : (Set.univ : Set M) ⊆ ⋃ i, c4 i := by
    intro x _
    rcases hcover4 x with h | h | h | h
    · exact Set.mem_iUnion.mpr ⟨0, by simpa [c4] using h⟩
    · exact Set.mem_iUnion.mpr ⟨1, by simpa [c4] using h⟩
    · exact Set.mem_iUnion.mpr ⟨2, by simpa [c4] using h⟩
    · exact Set.mem_iUnion.mpr ⟨3, by simpa [c4] using h⟩
  -- a cycle representative
  obtain ⟨z, hz⟩ := (ModuleCat.epi_iff_surjective ((singularChains ℤ M).homologyπ N)).mp
    (inferInstance) c
  -- subdivide it until it is small for the four sets
  obtain ⟨n₀, hn₀⟩ := exists_iter_small_chain_fam c4 hcopen hcover N
    ((singularChains ℤ M).iCycles N z)
  -- the homotopy `Sd^{n₀} ~ id`
  obtain ⟨T, _⟩ := exists_small_homotopy M Set.univ Set.univ n₀
  have hhom : HomologicalComplex.homologyMap (sdChainMapIter M n₀) N = 𝟙 _ := by
    rw [Homotopy.homologyMap_eq T N, HomologicalComplex.homologyMap_id]
  refine ⟨HomologicalComplex.cyclesMap (sdChainMapIter M n₀) N z, ?_, ?_⟩
  · -- the class is unchanged
    have h := congrArg
      (fun (g : (singularChains ℤ M).cycles N ⟶ (singularChains ℤ M).homology N) =>
        (ModuleCat.Hom.hom g) z)
      (HomologicalComplex.homologyπ_naturality (sdChainMapIter M n₀) N)
    simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
    rw [hz, hhom] at h
    simp only [ModuleCat.hom_id, LinearMap.id_apply] at h
    exact h.symm
  · -- the decomposition
    have hcyc : ((singularChains ℤ M).iCycles N)
        (HomologicalComplex.cyclesMap (sdChainMapIter M n₀) N z)
        = ((sdChainMapIter M n₀).f N).hom (((singularChains ℤ M).iCycles N) z) := by
      have h := congrArg
        (fun (g : (singularChains ℤ M).cycles N ⟶ (singularChains ℤ M).X N) =>
          (ModuleCat.Hom.hom g) z)
        (HomologicalComplex.cyclesMap_i (sdChainMapIter M n₀) N)
      simpa only [ModuleCat.hom_comp, LinearMap.comp_apply] using h
    rw [hcyc]
    have hx : ((sdChainMapIter M n₀).f N).hom (((singularChains ℤ M).iCycles N) z) ∈
        (LinearMap.range ((inclChains M (U \ L)).f N).hom ⊔
         LinearMap.range ((inclChains M (U ∩ V)).f N).hom ⊔
         LinearMap.range ((inclChains M (V \ K)).f N).hom ⊔
         LinearMap.range ((inclChains M ((K ∪ L)ᶜ)).f N).hom) := by
      have hlift := hn₀
      rw [smallChainSubmoduleFam, Submodule.mem_iSup] at hlift
      exact hlift _ (by
        intro i
        fin_cases i
        · exact le_sup_of_le_left (le_sup_of_le_left (le_sup_of_le_left le_rfl))
        · exact le_sup_of_le_left (le_sup_of_le_left (le_sup_of_le_right le_rfl))
        · exact le_sup_of_le_left (le_sup_of_le_right le_rfl)
        · exact le_sup_of_le_right le_rfl)
    obtain ⟨a, ha, b, hb, d, hd, j, hj, hsum⟩ := mem_sup_four hx
    refine ⟨a, b, d, j, hsum.symm, ?_, ?_, ?_, ?_⟩
    · obtain ⟨a', ha'⟩ := ha; exact ⟨a', ha'⟩
    · obtain ⟨b', hb'⟩ := hb; exact ⟨b', hb'⟩
    · obtain ⟨d', hd'⟩ := hd; exact ⟨d', hd'⟩
    · obtain ⟨j', hj'⟩ := hj; exact ⟨j', hj'⟩

end

end Work.Cohomology
