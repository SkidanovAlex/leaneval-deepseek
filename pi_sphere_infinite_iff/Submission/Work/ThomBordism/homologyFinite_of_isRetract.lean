import Mathlib
import Submission.Work.Cohomology.exists_capH
import Submission.Work.ThomBordism.finiteGoodCoverHomology

set_option synthInstance.maxHeartbeats 400000

/-!
# Finitely generated homology of a retract of a neighbourhood in `ℝ^N`

This file proves `Work.ThomBordism.homologyFinite_of_isRetract`: the "converse" half of Hatcher,
*Algebraic Topology*, Cor. A.8.  A compact set `K ⊆ ℝ^N` which is a retract of an open neighbourhood
`U ∋ K` has finitely generated singular homology in every degree.

## Strategy

* Since `U` is open, every point of `K` has a ball neighbourhood inside `U`; compactness of `K`
  produces a **finite** family of balls `B_1, …, B_m` with `K ⊆ P := ⋃ B_i ⊆ U`;
* `P` is a finite union of convex sets, hence is covered by the finitely many convex open sets `B_i`
  whose nonempty finite intersections are convex, hence contractible: this is a finite *good cover*
  `P`, so `H_k(P; ℤ)` is finitely generated by `Work.ThomBordism.finiteGoodCoverHomology`;
* the retraction restricts to `r' : P → K` and satisfies `r' ∘ (K ↪ P) = id`, so on homology the map
  induced by `r'` is a split surjection `H_k(P) → H_k(K)`, and a quotient of a finitely generated
  `ℤ`-module is finitely generated.
-/

set_option linter.style.haveILetI false

open CategoryTheory AlgebraicTopology

namespace Work.ThomBordism

noncomputable section

/-- The singular chain complex functor with `ℤ` coefficients, as a functor out of `TopCat`. -/
abbrev singC : TopCat ⥤ ChainComplex (ModuleCat ℤ) ℕ :=
  (singularChainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)

/-- `singC` is the singular chain complex of `Work.Cohomology.singularChains`. -/
theorem singC_obj_eq (X : TopCat) : singC.obj X = Work.Cohomology.singularChains ℤ X := rfl

/-! ## Finitely many convex sets give finitely generated homology -/

/-- **A space carrying a finite good family (over an arbitrary finite index type) has finitely
generated singular homology.**  This is `finiteHomology_of_goodFam` with the family reindexed by
`Fin (Fintype.card ι)`. -/
theorem fgch_finiteHomology_of_goodFam_fintype {Z : Type} [TopologicalSpace Z] {ι : Type}
    [Fintype ι] (U : ι → Set Z) (hgood : IsGoodFam U) (hcov : (⋃ i, U i) = Set.univ) (k : ℕ) :
    Module.Finite ℤ ((Work.Cohomology.singularChains ℤ (TopCat.of Z)).homology k) := by
  let g : Fin (Fintype.card ι) → ι := (Fintype.equivFin ι).symm
  have hcov' : (⋃ i : Fin (Fintype.card ι), U (g i)) = Set.univ := by
    rw [Set.eq_univ_iff_forall] at hcov ⊢
    intro x
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (hcov x)
    exact Set.mem_iUnion.mpr ⟨Fintype.equivFin ι i, by simpa [g] using hi⟩
  exact finiteHomology_of_goodFam (Fintype.card ι) Z (fun i => U (g i))
    (fgch_isGoodFam_comp hgood g) hcov' k

/-- **A finite union of open balls in `ℝ^N` has finitely generated singular homology.**  The balls
themselves form a finite good cover: they are open and convex, and so is every finite intersection. -/
theorem fgch_finiteHomology_of_iUnion_ball {N k : ℕ} {ι : Type} [Fintype ι]
    (c : ι → EuclideanSpace ℝ (Fin N)) (ρ : ι → ℝ)
    (P : Set (EuclideanSpace ℝ (Fin N))) (hP : P = ⋃ i, Metric.ball (c i) (ρ i)) :
    Module.Finite ℤ ((Work.Cohomology.singularChains ℤ (TopCat.of ↥P)).homology k) := by
  subst hP
  refine fgch_finiteHomology_of_goodFam_fintype
    (U := fun i => {y : ↥(⋃ i, Metric.ball (c i) (ρ i)) |
      (y : EuclideanSpace ℝ (Fin N)) ∈ Metric.ball (c i) (ρ i)}) ?_ ?_ k
  · refine ⟨fun i => Metric.isOpen_ball.preimage continuous_subtype_val, fun β _ f b hne => ?_⟩
    have hset : (⋂ i : β, {y : ↥(⋃ i, Metric.ball (c i) (ρ i)) |
        (y : EuclideanSpace ℝ (Fin N)) ∈ Metric.ball (c (f i)) (ρ (f i))})
        = {y : ↥(⋃ i, Metric.ball (c i) (ρ i)) |
            (y : EuclideanSpace ℝ (Fin N)) ∈ ⋂ i : β, Metric.ball (c (f i)) (ρ (f i))} := by
      ext y
      simp only [Set.mem_iInter, Set.mem_ofPred_eq]
    rw [hset]
    have hsub : (⋂ i : β, Metric.ball (c (f i)) (ρ (f i)))
        ⊆ (⋃ i, Metric.ball (c i) (ρ i)) := by
      intro z hz
      exact Set.mem_iUnion.mpr ⟨f b, Set.mem_iInter.mp hz b⟩
    refine fgch_contractibleSpace_of_subtype_subtype hsub ?_
    refine Convex.contractibleSpace (convex_iInter (fun i => convex_ball _ _)) ?_
    rw [hset] at hne
    obtain ⟨y, hy⟩ := hne
    exact ⟨(y : EuclideanSpace ℝ (Fin N)), hy⟩
  · ext y
    constructor
    · intro _; trivial
    · intro _
      obtain ⟨i, hi⟩ := Set.mem_iUnion.mp y.2
      exact Set.mem_iUnion.mpr ⟨i, hi⟩

/-! ## The retract statement -/

/-- **A compact set that is a retract of a neighbourhood in `ℝ^N` has finitely generated singular
homology** (the "converse" half of Hatcher, *Algebraic Topology*, Cor. A.8).

Proof plan (all pieces available in the workspace):
* `K` compact and `U ∋ K` open give `d := dist(K, Uᶜ) > 0` (case split off the degenerate cases
  `U = univ` and `K = ∅`, where `d = 0` by Mathlib convention but the statement is still true); for
  the axis-parallel grid of cubes of side `h` with `√N · h < d`, the union `P` of the grid cubes
  meeting `K` satisfies `K ⊆ P ⊆ U`, so the retraction restricts to `r' : ↥P → ↥K` with
  `r' ∘ (K ↪ P) = id`, and `H_k(K;ℤ)` is a direct summand of `H_k(P;ℤ)`;
* `P` is a finite axis-parallel cubical complex whose *open stars* `U_F = ⋃ {int_ℝ^N(Q) : Q ⊇ F}`
  (over the faces `F` of `P`) form a finite open cover of `P`; nonempty finite intersections of open
  stars are again open stars, and each open star deformation retracts onto the (convex, hence
  contractible) relative interior of a face; so `P` has a finite *good* cover;
* `Work.ThomBordism.finiteGoodCoverHomology` gives `Module.Finite ℤ (H_k(P;ℤ))`, and submodules of
  finitely generated `ℤ`-modules are finitely generated. -/
theorem homologyFinite_of_isRetract {N k : ℕ} (K : Set (EuclideanSpace ℝ (Fin N))) [CompactSpace ↥K]
    (U : Set (EuclideanSpace ℝ (Fin N))) (hU : IsOpen U) (hKU : K ⊆ U)
    (r : ↥U → ↥K) (hr : Continuous r) (hrfix : ∀ x : ↥K, r ⟨x.1, hKU x.2⟩ = x) :
    Module.Finite ℤ ((Work.Cohomology.chainC ℤ (TopCat.toSSet.obj (TopCat.of ↥K))).homology k) := by
  classical
  change Module.Finite ℤ ((singC.obj (TopCat.of ↥K)).homology k)
  -- ## 1. every point of `K` has a ball neighbourhood inside `U`
  have hex : ∀ x : ↥K, ∃ ε : ℝ, 0 < ε ∧ Metric.ball (x : EuclideanSpace ℝ (Fin N)) ε ⊆ U := by
    intro x
    obtain ⟨ε, hε, hsub⟩ := Metric.mem_nhds_iff.mp (hU.mem_nhds (hKU x.2))
    exact ⟨ε, hε, hsub⟩
  let rad : ↥K → ℝ := fun x => Classical.choose (hex x)
  have hrad_pos : ∀ x : ↥K, 0 < rad x := fun x => (Classical.choose_spec (hex x)).1
  have hrad_sub : ∀ x : ↥K, Metric.ball (x : EuclideanSpace ℝ (Fin N)) (rad x) ⊆ U :=
    fun x => (Classical.choose_spec (hex x)).2
  -- ## 2. a finite subcover of `K` by such balls
  have hKc : IsCompact K := isCompact_iff_compactSpace.mpr inferInstance
  obtain ⟨t, ht⟩ := hKc.elim_finite_subcover
    (fun x : ↥K => Metric.ball (x : EuclideanSpace ℝ (Fin N)) (rad x))
    (fun x => Metric.isOpen_ball)
    (fun y hy => Set.mem_iUnion.mpr ⟨⟨y, hy⟩, Metric.mem_ball_self (hrad_pos ⟨y, hy⟩)⟩)
  -- ## 3. the union `P` of the finitely many balls
  set xp : Fin t.card → ↥K := fun i => (t.equivFin.symm i).1 with hxp
  set c : Fin t.card → EuclideanSpace ℝ (Fin N) := fun i => (xp i : EuclideanSpace ℝ (Fin N))
    with hc
  set ρ : Fin t.card → ℝ := fun i => rad (xp i) with hρ
  set P : Set (EuclideanSpace ℝ (Fin N)) := ⋃ i, Metric.ball (c i) (ρ i) with hP
  have hKP : K ⊆ P := by
    intro y hy
    have hy1 : y ∈ ⋃ x ∈ t, Metric.ball (x : EuclideanSpace ℝ (Fin N)) (rad x) := ht hy
    rw [Set.mem_iUnion] at hy1
    obtain ⟨x, hx⟩ := hy1
    rw [Set.mem_iUnion] at hx
    obtain ⟨hxt, hyb⟩ := hx
    refine Set.mem_iUnion.mpr ⟨t.equivFin ⟨x, hxt⟩, ?_⟩
    have h1 : xp (t.equivFin ⟨x, hxt⟩) = x := by
      rw [hxp]; exact congrArg Subtype.val (Equiv.symm_apply_apply t.equivFin ⟨x, hxt⟩)
    have h2 : ρ (t.equivFin ⟨x, hxt⟩) = rad x := by rw [hρ]; exact congrArg rad h1
    have h3 : c (t.equivFin ⟨x, hxt⟩) = (x : EuclideanSpace ℝ (Fin N)) := by
      rw [hc]; exact congrArg Subtype.val h1
    rw [h3, h2]
    exact hyb
  have hPU : P ⊆ U := by
    intro y hy
    rw [hP] at hy
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hy
    rw [hc, hρ] at hi
    exact hrad_sub (xp i) hi
  -- ## 4. `H_k(P; ℤ)` is finitely generated
  have hPfin : Module.Finite ℤ
      ((Work.Cohomology.singularChains ℤ (TopCat.of ↥P)).homology k) :=
    fgch_finiteHomology_of_iUnion_ball c ρ P hP
  -- ## 5. the retraction restricts to `P`
  let iC : C(↥K, ↥P) :=
    { toFun := fun x => ⟨(x : EuclideanSpace ℝ (Fin N)), hKP x.2⟩
      continuous_toFun := continuous_subtype_val.subtype_mk (fun x => hKP x.2) }
  let rC : C(↥P, ↥K) :=
    { toFun := fun y => r ⟨(y : EuclideanSpace ℝ (Fin N)), hPU y.2⟩
      continuous_toFun := hr.comp (continuous_subtype_val.subtype_mk (fun y => hPU y.2)) }
  let iT : TopCat.of ↥K ⟶ TopCat.of ↥P := TopCat.ofHom iC
  let rT : TopCat.of ↥P ⟶ TopCat.of ↥K := TopCat.ofHom rC
  have hcompC : rC.comp iC = ContinuousMap.id ↥K := by
    apply ContinuousMap.ext
    intro x
    apply Subtype.ext
    change ((r ⟨(x : EuclideanSpace ℝ (Fin N)), hPU (hKP x.2)⟩ : ↥K) : EuclideanSpace ℝ (Fin N))
      = (x : EuclideanSpace ℝ (Fin N))
    have harg : (⟨(x : EuclideanSpace ℝ (Fin N)), hPU (hKP x.2)⟩ : ↥U)
        = ⟨(x : EuclideanSpace ℝ (Fin N)), hKU x.2⟩ := Subtype.ext rfl
    rw [harg, hrfix x]
  have hcomp : iT ≫ rT = 𝟙 (TopCat.of ↥K) := by
    have h := TopCat.ofHom_comp iC rC
    rw [hcompC, TopCat.ofHom_id] at h
    rw [← h]
  -- ## 6. the map on homology induced by `rT` is a split surjection
  haveI : Module.Finite ℤ ↑((singC.obj (TopCat.of ↥P)).homology k) := hPfin
  have hmap : HomologicalComplex.homologyMap (singC.map iT) k
      ≫ HomologicalComplex.homologyMap (singC.map rT) k = 𝟙 _ := by
    rw [← HomologicalComplex.homologyMap_comp]
    rw [← singC.map_comp, hcomp, singC.map_id]
    rw [HomologicalComplex.homologyMap_id]
  refine Module.Finite.of_surjective (HomologicalComplex.homologyMap (singC.map rT) k).hom ?_
  intro y
  refine ⟨(HomologicalComplex.homologyMap (singC.map iT) k).hom y, ?_⟩
  have hlin := congrArg ModuleCat.Hom.hom hmap
  rw [ModuleCat.hom_comp, ModuleCat.hom_id] at hlin
  simpa using (LinearMap.ext_iff.mp hlin) y

end

end Work.ThomBordism
