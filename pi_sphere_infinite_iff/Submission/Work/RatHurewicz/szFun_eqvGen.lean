import Mathlib
import Submission.Work.RatHurewicz.avoidAux

/-!
# The size of the support is constant on the classes of the gluing relation

`Work.RatHurewicz.szFun D a` is the size of the support of `a` when `a` is a point of a copy of
`Δ^{n+1}`, and `1` when `a` lies in a copy of the arc.  This file proves that it is an invariant of
the equivalence relation generated by the gluing relation `modelRel D`, so that it descends to a
well defined "cell dimension" of a class of `Raw D` (the generating case being
`Work.RatHurewicz.szFun_modelRel`).
-/

open scoped Topology Simplicial unitInterval

namespace Work.RatHurewicz

noncomputable section

variable {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}

theorem szFun_eqvGen {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}
    (D : Work.RatHurewicz.MData X n x₀) {a b : Work.RatHurewicz.Raw D}
    (h : Relation.EqvGen (Work.RatHurewicz.modelRel D) a b) :
    Work.RatHurewicz.szFun D a = Work.RatHurewicz.szFun D b := by
  induction h with
  | rel x y hr => exact szFun_modelRel hr
  | refl x => rfl
  | symm x y hxy ih => exact ih.symm
  | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz

end

end Work.RatHurewicz
