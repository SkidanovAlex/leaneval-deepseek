import Mathlib
import Submission.Work.Stems.Cubical.CubeFace

/-!
# `∂ ∘ ∂ = 0` for the cubical singular chains

`Work.Stems.Cubical.cubD n X` is the cubical differential, the `ℤ`-linear map on the free
`ℤ`-module `Cub n X` generated by the continuous `n`-cubes `I^n → X`, sending a cube `s` to the
alternating sum `∑ᵢ (-1)^i (s_{i,0} - s_{i,1})` of its faces.  This file proves that the square of
this differential is zero: `cubD n X ∘ cubD (n+1) X = 0`, in the pointwise form
`cubD n X (cubD (n+1) X c) = 0` for every cubical `(n+2)`-chain `c`.

The proof is the classical cubical computation.  Writing `dᵢᵇ` for the `i`-th face with value `b`,
the faces of a cube commute up to the reindexing
`dᵢᵇ dⱼᶜ = d_qᶜ d_pᵇ`,  `q = Fin.succAbove i j`, `p = Fin.predAbove j i`,
which is exactly Mathlib's `Fin.succAbove_succAbove_succAbove_predAbove` transported to cubes
(`faceCube_faceCube`, here `cubD2_faceCube_faceCube`).  The double sum is then indexed by the quadruples `(i, b, j, c)`, and the
involution
`(i, b, j, c) ↦ (Fin.succAbove i j, c, Fin.predAbove j i, b)`
acts on the quadruples producing *the same* cube with *the opposite* sign: the index change
`(i,j) ↦ (Fin.succAbove i j, Fin.predAbove j i)` is the sign-reversing involution of
`Fin.succAbove_succAbove_predAbove` / `Fin.predAbove_predAbove_succAbove`, and the parity of
`i + j` flips (`cubD2_key_sign`).  A fixed-point-free sign-reversing involution kills the sum
(`Finset.sum_involution`).

The combinatorial heart -- the face commutation relation, the parity computation and the
sign-reversing fixed-point-free involution on the index quadruples -- is the same argument as in
`Submission/Work/Stems/Hur2b/cubD_comp_cubD.lean`; it is reproduced here (under the `cubD2` name
prefix) so that the present file is self-contained and this lemma does not depend on the fate of
another area's module.
-/

open scoped unitInterval Topology

namespace Work.RatHurewicz

open Work.Stems.Cubical

variable {X : Type} [TopologicalSpace X]

/-! ## The two face values and their signs -/

/-- The two face values `0` and `1`, indexed by `Fin 2`. -/
noncomputable def cubD2Val : Fin 2 → unitInterval := ![0, 1]

/-- The sign `(-1)^k` attached to the `k`-th face end, `k : Fin 2`. -/
def cubD2Sign (k : Fin 2) : ℤ := (-1 : ℤ) ^ (k : ℕ)

@[simp] lemma cubD2Val_zero : cubD2Val (0 : Fin 2) = 0 := rfl

@[simp] lemma cubD2Val_one : cubD2Val (1 : Fin 2) = 1 := rfl

@[simp] lemma cubD2Sign_zero : cubD2Sign (0 : Fin 2) = 1 := by simp [cubD2Sign]

@[simp] lemma cubD2Sign_one : cubD2Sign (1 : Fin 2) = -1 := by simp [cubD2Sign]

/-- The difference of the two faces of a cube, as the signed sum over `Fin 2`. -/
lemma cubD2_single_sub_single (n : ℕ) (w : C(IC (n+1), X)) (i : Fin (n+1)) :
    Finsupp.single (faceCube i 0 w) (1:ℤ) - Finsupp.single (faceCube i 1 w) 1
      = ∑ b : Fin 2, cubD2Sign b • Finsupp.single (faceCube i (cubD2Val b) w) 1 := by
  rw [Fin.sum_univ_two]
  simp [cubD2Sign, cubD2Val, sub_eq_add_neg]

/-- `cubD` on a single generator, written as an iterated signed sum over the faces. -/
lemma cubD2_single_sum (n : ℕ) (w : C(IC (n+1), X)) :
    cubD n X (Finsupp.single w (1:ℤ)) =
      ∑ i : Fin (n+1), ∑ b : Fin 2,
        ((-1 : ℤ) ^ (i : ℕ) * cubD2Sign b) • Finsupp.single (faceCube i (cubD2Val b) w) 1 := by
  rw [cubD_single]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [cubD2_single_sub_single, Finset.smul_sum]
  refine Finset.sum_congr rfl fun b _ => ?_
  rw [smul_smul]

/-! ## Faces commute -/

/-- The faces of a cube commute: freezing coordinate `i` at `b` and then the `j`-th remaining
coordinate at `c` is the same as freezing first the corresponding coordinate of `Fin (n+2)` at
`c` and then coordinate `i` at `b`. -/
theorem cubD2_faceFun_faceFun {n : ℕ} (i : Fin (n+2)) (j : Fin (n+1))
    (b c : unitInterval) (u : IC n) :
    faceFun i b (faceFun j c u) =
      faceFun (Fin.succAbove i j) c (faceFun (Fin.predAbove j i) b u) := by
  simp only [faceFun, Fin.succAbove_cases_eq_insertNth]
  apply Eq.symm
  refine Fin.insertNth_eq_iff.mpr ⟨?_, ?_⟩
  · simp
  · refine Fin.insertNth_eq_iff.mpr ⟨?_, ?_⟩
    · simp only [Fin.removeNth_apply]
      rw [Fin.succAbove_succAbove_predAbove]
      simp
    · ext k
      simp only [Fin.removeNth_apply]
      rw [Fin.succAbove_succAbove_succAbove_predAbove]
      simp

/-- The same commutation for the face *cubes*. -/
lemma cubD2_faceCube_faceCube {n : ℕ} (i : Fin (n+2)) (j : Fin (n+1)) (b c : unitInterval)
    (s : C(IC (n+2), X)) :
    faceCube j c (faceCube i b s) =
      faceCube (Fin.predAbove j i) b (faceCube (Fin.succAbove i j) c s) := by
  ext u
  simp only [faceCube, ContinuousMap.comp_apply, faceCM_apply]
  rw [cubD2_faceFun_faceFun i j b c u]

/-! ## The sign of the reindexing -/

/-- The parity of `i + j` flips under `(i,j) ↦ (Fin.succAbove i j, Fin.predAbove j i)`. -/
theorem cubD2_key_sign {n : ℕ} (i : Fin (n+2)) (j : Fin (n+1)) :
    (-1:ℤ)^(i:ℕ) * (-1:ℤ)^(j:ℕ)
      = - ((-1:ℤ)^((Fin.succAbove i j : ℕ)) * (-1:ℤ)^((Fin.predAbove j i : ℕ))) := by
  rw [← pow_add, ← pow_add]
  rcases lt_or_ge j.castSucc i with h | h
  · rw [Fin.succAbove_of_castSucc_lt i j h, Fin.predAbove_of_castSucc_lt j i h]
    rw [Fin.val_castSucc, Fin.val_pred]
    have hlt : (j:ℕ) < (i:ℕ) := h
    have h2 : (i:ℕ) + (j:ℕ) = ((i:ℕ) - 1) + (j:ℕ) + 1 := by omega
    rw [h2, pow_succ]
    ring
  · rw [Fin.succAbove_of_le_castSucc i j h, Fin.predAbove_of_le_castSucc j i h]
    rw [Fin.val_succ, Fin.coe_castPred]
    have hle : (i:ℕ) ≤ (j:ℕ) := h
    have h2 : (j:ℕ) + 1 + (i:ℕ) = (i:ℕ) + (j:ℕ) + 1 := by omega
    rw [h2, pow_succ]
    ring

lemma cubD2_sign_swap {n : ℕ} (i : Fin (n+2)) (j : Fin (n+1)) :
    (-1:ℤ)^((Fin.succAbove i j : ℕ)) * (-1:ℤ)^((Fin.predAbove j i : ℕ))
      = - ((-1:ℤ)^(i:ℕ) * (-1:ℤ)^(j:ℕ)) := by
  have h := cubD2_key_sign i j
  rw [h, neg_neg]

/-- The four-factor form of `cubD2_sign_swap`, needed for the sign of a double face. -/
lemma cubD2_sign_swap4 {n : ℕ} (i : Fin (n+2)) (j : Fin (n+1)) (b c : Fin 2) :
    (-1:ℤ)^((Fin.succAbove i j : ℕ)) * (-1:ℤ)^(c:ℕ)
        * (-1:ℤ)^((Fin.predAbove j i : ℕ)) * (-1:ℤ)^(b:ℕ)
      = - ((-1:ℤ)^(i:ℕ) * (-1:ℤ)^(b:ℕ) * (-1:ℤ)^(j:ℕ) * (-1:ℤ)^(c:ℕ)) := by
  have h := cubD2_sign_swap i j
  calc (-1:ℤ)^((Fin.succAbove i j : ℕ)) * (-1:ℤ)^(c:ℕ)
          * (-1:ℤ)^((Fin.predAbove j i : ℕ)) * (-1:ℤ)^(b:ℕ)
      = ((-1:ℤ)^((Fin.succAbove i j : ℕ)) * (-1:ℤ)^((Fin.predAbove j i : ℕ))) *
          ((-1:ℤ)^(b:ℕ) * (-1:ℤ)^(c:ℕ)) := by ring
    _ = (- ((-1:ℤ)^(i:ℕ) * (-1:ℤ)^(j:ℕ))) * ((-1:ℤ)^(b:ℕ) * (-1:ℤ)^(c:ℕ)) := by rw [h]
    _ = - ((-1:ℤ)^(i:ℕ) * (-1:ℤ)^(b:ℕ) * (-1:ℤ)^(j:ℕ) * (-1:ℤ)^(c:ℕ)) := by ring

/-! ## The double boundary as a single sum over quadruples -/

/-- The `(i,b,j,c)`-term of the double boundary of an `(n+2)`-cube `s`. -/
noncomputable def cubD2Term (n : ℕ) (s : C(IC (n+2), X))
    (x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2) : Cub n X :=
  ((-1 : ℤ)^(x.1 : ℕ) * cubD2Sign x.2.1 * (-1:ℤ)^(x.2.2.1 : ℕ) * cubD2Sign x.2.2.2) •
    Finsupp.single (faceCube (Fin.predAbove x.2.2.1 x.1) (cubD2Val x.2.1)
      (faceCube (Fin.succAbove x.1 x.2.2.1) (cubD2Val x.2.2.2) s)) 1

/-- The sign-reversing involution on the index quadruples of the double boundary. -/
noncomputable def cubD2Swp (n : ℕ) (x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2) :
    Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2 :=
  (Fin.succAbove x.1 x.2.2.1, x.2.2.2, Fin.predAbove x.2.2.1 x.1, x.2.1)

/-- The double boundary of a single generator, as a sum of `cubD2Term` over the quadruples. -/
lemma cubD2_cubD_cubD_single (n : ℕ) (s : C(IC (n+2), X)) :
    cubD n X (cubD (n+1) X (Finsupp.single s (1:ℤ))) = ∑ x, cubD2Term n s x := by
  rw [cubD2_single_sum, map_sum]
  simp only [map_sum, map_smul]
  rw [show (∑ x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2, cubD2Term n s x)
        = ∑ i : Fin (n+2), ∑ b : Fin 2, ∑ j : Fin (n+1), ∑ c : Fin 2,
            cubD2Term n s (i, (b, (j, c))) by simp only [Fintype.sum_prod_type]]
  refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun b _ => ?_
  rw [cubD2_single_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun c _ => ?_
  simp only [cubD2Term]
  rw [smul_smul, cubD2_faceCube_faceCube]
  congr 1
  ring

/-- Swapping the indices negates the term. -/
lemma cubD2Term_swp (n : ℕ) (s : C(IC (n+2), X))
    (x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2) :
    cubD2Term n s (cubD2Swp n x) = - cubD2Term n s x := by
  obtain ⟨i, b, j, c⟩ := x
  simp only [cubD2Swp, cubD2Term, cubD2Sign]
  rw [Fin.succAbove_succAbove_predAbove, Fin.predAbove_predAbove_succAbove]
  rw [cubD2_faceCube_faceCube i j (cubD2Val b) (cubD2Val c) s, cubD2_sign_swap4 i j b c, neg_smul]

/-- The swap is an involution. -/
lemma cubD2Swp_involutive (n : ℕ) (x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2) :
    cubD2Swp n (cubD2Swp n x) = x := by
  obtain ⟨i, b, j, c⟩ := x
  simp [cubD2Swp, Fin.succAbove_succAbove_predAbove, Fin.predAbove_predAbove_succAbove]

/-- The swap has no fixed point. -/
lemma cubD2Swp_ne (n : ℕ) (x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2) : cubD2Swp n x ≠ x := by
  intro h
  have h1 : Fin.succAbove x.1 x.2.2.1 = x.1 := by
    have := congrArg Prod.fst h
    simpa only [cubD2Swp] using this
  exact Fin.succAbove_ne x.1 x.2.2.1 h1

/-- The double boundary of a single generator vanishes. -/
lemma cubD2_sum_zero (n : ℕ) (s : C(IC (n+2), X)) :
    (∑ x : Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2, cubD2Term n s x) = 0 := by
  have h := Finset.sum_involution
    (s := (Finset.univ : Finset (Fin (n+2) × Fin 2 × Fin (n+1) × Fin 2)))
    (f := cubD2Term n s) (fun x _ => cubD2Swp n x)
    (fun x _ => by rw [cubD2Term_swp]; simp)
    (fun x _ _ => cubD2Swp_ne n x)
    (fun x _ => Finset.mem_univ _)
    (fun x _ => cubD2Swp_involutive n x)
  simpa using h

/-! ## The differential squares to zero -/

/-- The composite `cubD n X ∘ cubD (n+1) X` of two consecutive cubical differentials is zero. -/
theorem cubD2_comp_eq_zero (n : ℕ) :
    (Work.Stems.Cubical.cubD n X).comp (Work.Stems.Cubical.cubD (n + 1) X) = 0 := by
  apply LinearMap.ext
  intro x
  have hgen : ∀ s : C(IC (n+2), X),
      cubD n X (cubD (n+1) X (Finsupp.single s (1:ℤ))) = 0 :=
    fun s => by rw [cubD2_cubD_cubD_single, cubD2_sum_zero]
  have hx : ∀ w : Cub (n+2) X, cubD n X (cubD (n+1) X w) = 0 := by
    intro w
    refine Finsupp.induction_linear (motive := fun w => cubD n X (cubD (n+1) X w) = 0) w ?_ ?_ ?_
    · simp
    · intro f g hf hg
      rw [map_add, map_add, hf, hg, zero_add]
    · intro a k
      rw [show Finsupp.single a k = k • Finsupp.single a (1:ℤ) from by
        rw [Finsupp.smul_single', mul_one]]
      simp only [map_smul]
      rw [hgen a, smul_zero]
  exact hx x

/-- `cubD ∘ cubD = 0`, in the pointwise form in which the Hurewicz development uses it. -/
theorem cubD_comp_cubD {X : Type} [TopologicalSpace X] (n : ℕ)
    (c : Work.Stems.Cubical.Cub (n + 2) X) :
    Work.Stems.Cubical.cubD n X (Work.Stems.Cubical.cubD (n + 1) X c) = 0 := by
  have h := cubD2_comp_eq_zero (X := X) n
  simpa [LinearMap.comp_apply] using LinearMap.congr_fun h c

end Work.RatHurewicz
