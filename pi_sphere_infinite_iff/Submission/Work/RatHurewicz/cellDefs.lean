import Mathlib
import Submission.Work.RatHurewicz.cycleModelDefs

/-!
# The cells of the model `Model D`, and the vocabulary of the cell-by-cell push

This module fixes the vocabulary needed to state the "push the path into the `1`-skeleton" lemmas
for the model of a cycle (`Work.RatHurewicz.MData`, `Work.RatHurewicz.Model`,
`Work.RatHurewicz.skeleton`, defined in `Submission.Work.RatHurewicz.cycleModelDefs`).

The model is the quotient of `Raw D = (Σ i, Δ^{n+1}) ⊕ (Σ i, I)` by the relation generated by the
identifications of matching faces, the gluing of the vertex `0` of each simplex to the `0`-end of
the corresponding arc, and the gluing of the `1`-ends of all the arcs.

* `centroidPt S` is the point of `Δ^{n+1}` with barycentric coordinates `1/|S|` on the vertex set
  `S` and `0` outside it;
* `ptSupport x` is the set of vertices at which `x` has a nonzero coordinate;
* `openCell D i S` is the image in `Model D` of the relative interior of the face spanned by `S`
  in the `i`-th copy of `Δ^{n+1}`;
* `closedCell D i S` is the image of the corresponding closed face;
* `cellOriginOf D i S` is the image of `centroidPt S` — the chosen origin of the cell `(i, S)`;
* `skel D k` is the `k`-skeleton of the model: the points represented by a point of some copy of
  `Δ^{n+1}` with at most `k+1` nonzero barycentric coordinates, or by a point of an arc.

The two geometric inputs on which `Work.RatHurewicz.compress_to_skeleton` rests are stated in this
vocabulary; see `Submission/Work/RatHurewicz/cellPush.lean` and
`Submission/Work/RatHurewicz/avoidOrigin.lean`.
-/

open scoped Topology Simplicial unitInterval

namespace Work.RatHurewicz

noncomputable section

variable {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}

/-- **The centroid of a face, as a point of the standard simplex.** -/
def centroidPt (S : Finset (Fin (n + 2))) (hS : S.Nonempty) : stdSimplex ℝ (Fin (n + 2)) :=
  ⟨fun k => if k ∈ S then ((S.card : ℝ))⁻¹ else 0, by
    have hcard : (0 : ℝ) < S.card := by exact_mod_cast Finset.card_pos.mpr hS
    refine ⟨fun k => ?_, ?_⟩
    · by_cases hk : k ∈ S
      · simp only [hk, if_true]; positivity
      · simp only [hk, if_false]; exact le_refl 0
    · rw [Finset.sum_ite_mem, Finset.inter_eq_right.mpr (Finset.subset_univ S), Finset.sum_const,
        nsmul_eq_mul]
      field_simp⟩

theorem centroidPt_apply (S : Finset (Fin (n + 2))) (hS : S.Nonempty) (k : Fin (n + 2)) :
    (centroidPt S hS : Fin (n + 2) → ℝ) k = if k ∈ S then ((S.card : ℝ))⁻¹ else 0 := rfl

@[simp] theorem centroidPt_apply_mem {S : Finset (Fin (n + 2))} (hS : S.Nonempty)
    {k : Fin (n+2)} (hk : k ∈ S) :
    (centroidPt S hS : Fin (n + 2) → ℝ) k = ((S.card : ℝ))⁻¹ := by
  rw [centroidPt_apply, if_pos hk]

@[simp] theorem centroidPt_apply_notMem {S : Finset (Fin (n + 2))} (hS : S.Nonempty)
    {k : Fin (n+2)} (hk : k ∉ S) : (centroidPt S hS : Fin (n + 2) → ℝ) k = 0 := by
  rw [centroidPt_apply, if_neg hk]

/-- The support of a point of the standard simplex: the vertices with a nonzero coordinate. -/
def ptSupport (x : stdSimplex ℝ (Fin (n + 2))) : Finset (Fin (n + 2)) :=
  Finset.univ.filter (fun k => (x : Fin (n + 2) → ℝ) k ≠ 0)

@[simp] theorem mem_ptSupport {x : stdSimplex ℝ (Fin (n + 2))} {k : Fin (n + 2)} :
    k ∈ ptSupport x ↔ (x : Fin (n + 2) → ℝ) k ≠ 0 :=
  Finset.mem_filter.trans ⟨fun h => h.2, fun h => ⟨Finset.mem_univ k, h⟩⟩


/-- **The weight of a point of `Raw`**: the size of the support for a point of a copy of `Δ^{n+1}`,
and `1` for a point of an arc.  This is the invariant along the gluing relation that says that a
model point has a well defined "cell dimension": the classes of `modelRel` never identify points of
copies of a simplex with points of an arc, nor points with supports of different cardinality. -/
def rawWeight (D : MData X n x₀) : Raw D → ℕ :=
  fun a => match a with
  | Sum.inl p => (ptSupport p.2).card
  | Sum.inr _ => 1

theorem rawWeight_inl (D : MData X n x₀) (i : D.Idx) (x : stdSimplex ℝ (Fin (n + 2))) :
    rawWeight D (Sum.inl ⟨i, x⟩) = (ptSupport x).card := rfl

theorem rawWeight_inr (D : MData X n x₀) (i : D.Idx) (t : unitInterval) :
    rawWeight D (Sum.inr ⟨i, t⟩) = 1 := rfl

/-- **The `k`-skeleton of the model**: the points represented by a point of a copy of `Δ^{n+1}` with
at most `k+1` nonzero barycentric coordinates, or by a point of an arc.  For `k = 1` this is
`Work.RatHurewicz.skeleton` by definitional reduction. -/
def skel (D : MData X n x₀) (k : ℕ) : Set (Model D) :=
  {z | ∃ y : Raw D, Quotient.mk'' y = z ∧
    match y with
    | Sum.inl p => (Finset.univ.filter (fun j : Fin (n + 2) => p.2 j ≠ 0)).card ≤ k + 1
    | Sum.inr _ => True}

theorem skel_one_eq_skeleton (D : MData X n x₀) : skel D 1 = skeleton D := rfl

/-- **An open cell of the model**: the image of the relative interior of the face spanned by `S` in
the `i`-th copy of `Δ^{n+1}`. -/
def openCell (D : MData X n x₀) (i : D.Idx) (S : Finset (Fin (n + 2))) : Set (Model D) :=
  {z | ∃ x : stdSimplex ℝ (Fin (n + 2)), ptSupport x = S ∧
      Quotient.mk'' (Sum.inl ⟨i, x⟩) = z}

/-- **A closed cell of the model**: the image of the closed face spanned by `S`. -/
def closedCell (D : MData X n x₀) (i : D.Idx) (S : Finset (Fin (n + 2))) : Set (Model D) :=
  ⋃ T ∈ S.powerset, openCell D i T

theorem openCell_subset_closedCell (D : MData X n x₀) (i : D.Idx) (S : Finset (Fin (n + 2))) :
    openCell D i S ⊆ closedCell D i S := by
  intro z hz
  exact Set.mem_biUnion (Finset.mem_powerset.mpr (Finset.Subset.refl S)) hz

/-- **The origin of a cell**: the image of the centroid of the face spanned by `S`. -/
def cellOriginOf (D : MData X n x₀) (i : D.Idx) (S : Finset (Fin (n + 2))) (hS : S.Nonempty) :
    Model D :=
  Quotient.mk'' (Sum.inl ⟨i, centroidPt S hS⟩)

theorem cellOrigin_mem_openCell (D : MData X n x₀) (i : D.Idx) (S : Finset (Fin (n + 2)))
    (hS : S.Nonempty) : cellOriginOf D i S hS ∈ openCell D i S := by
  refine ⟨centroidPt S hS, ?_, rfl⟩
  ext k
  rw [mem_ptSupport]
  constructor
  · intro hk; by_contra hkS
    rw [centroidPt_apply_notMem hS hkS] at hk
    exact hk rfl
  · intro hkS
    rw [centroidPt_apply_mem hS hkS]
    have : (0 : ℝ) < S.card := by exact_mod_cast Finset.card_pos.mpr hS
    positivity

end

end Work.RatHurewicz
