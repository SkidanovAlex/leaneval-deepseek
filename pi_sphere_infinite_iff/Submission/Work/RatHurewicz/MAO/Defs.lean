import Mathlib
import Submission.Work.RatHurewicz.cellDefs
import Submission.Work.RatHurewicz.cellFacts
import Submission.Work.RatHurewicz.avoidAux
import Submission.Work.RatHurewicz.AvoidOrigin.Transport
import Submission.Work.RatHurewicz.cellShape

/-!
# The strata of the model `Model D` and the link statement

This module fixes the vocabulary for the description of the *strata* of the raw model
`Work.RatHurewicz.Raw D` (the copies of `Δ^{n+1}` and the copies of the arc) and of the way the
gluing relation `Work.RatHurewicz.modelRel D` identifies *whole strata* with each other.

`Model D` is the quotient of `Raw D` by the equivalence relation generated by `modelRel D`, and
`modelRel D` relates two points that are `facept`-images of the *same* point of `Δ^n` in two
different copies.  Consequently the equivalence classes are unions of strata: if `a ~ b` then
every point of `a`'s stratum is identified with a point of `b`'s stratum.  This is
`Work.RatHurewicz.LinkTo` below, and it is the key input of the description of the local structure
of the model.
-/

open scoped Topology Simplicial unitInterval

namespace Work.RatHurewicz

noncomputable section

variable {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}

/-- **The stratum of a raw point.**  `SameStratum D y a` says that `y` is the point of the same
stratum as `a`: for a point of a copy of `Δ^{n+1}` this means "same copy, same support", and for a
point of an arc "same copy, same parameter". -/
def SameStratum (D : MData X n x₀) (y a : Raw D) : Prop :=
  (∃ (i : D.Idx) (x y' : stdSimplex ℝ (Fin (n + 2))),
      a = Sum.inl ⟨i, x⟩ ∧ y = Sum.inl ⟨i, y'⟩ ∧ ptSupport y' = ptSupport x)
  ∨ (∃ (i : D.Idx) (t : unitInterval), a = Sum.inr ⟨i, t⟩ ∧ y = Sum.inr ⟨i, t⟩)

theorem sameStratum_inl {D : MData X n x₀} {i : D.Idx} {x : stdSimplex ℝ (Fin (n + 2))}
    {y : Raw D} :
    SameStratum D y (Sum.inl ⟨i, x⟩) ↔
      ∃ (i' : D.Idx) (y' : stdSimplex ℝ (Fin (n + 2))),
        y = Sum.inl ⟨i', y'⟩ ∧ i' = i ∧ ptSupport y' = ptSupport x := by
  constructor
  · rintro (⟨i₁, x₁, y₁, h1, h2, h3⟩ | ⟨i₁, t₁, h1, h2⟩)
    · cases h1
      exact ⟨i, y₁, h2, rfl, h3⟩
    · exact absurd h1 (by simp)
  · rintro ⟨i', y', h1, h2, h3⟩
    exact Or.inl ⟨i, x, y', rfl, by rw [← h2]; exact h1, h3⟩

theorem sameStratum_inr {D : MData X n x₀} {i : D.Idx} {t : unitInterval} {y : Raw D} :
    SameStratum D y (Sum.inr ⟨i, t⟩) ↔
      ∃ (i' : D.Idx) (t' : unitInterval), y = Sum.inr ⟨i', t'⟩ ∧ i' = i ∧ t' = t := by
  constructor
  · rintro (⟨i₁, x₁, y₁, h1, h2, h3⟩ | ⟨i₁, t₁, h1, h2⟩)
    · exact absurd h1 (by simp)
    · cases h1
      exact ⟨i, t, h2, rfl, rfl⟩
  · rintro ⟨i', t', h1, h2, h3⟩
    exact Or.inr ⟨i, t, rfl, by rw [← h2, ← h3]; exact h1⟩

/-- The stratum of a point is nonempty. -/
theorem sameStratum_self (D : MData X n x₀) (a : Raw D) : SameStratum D a a := by
  rcases a with ⟨i, x⟩ | ⟨i, t⟩
  · exact Or.inl ⟨i, x, x, rfl, rfl, rfl⟩
  · exact Or.inr ⟨i, t, rfl, rfl⟩

/-- A point of a copy of `Δ^{n+1}` has a stratum contained in that copy. -/
theorem sameStratum_inl_iff {D : MData X n x₀} {i : D.Idx} {x : stdSimplex ℝ (Fin (n + 2))}
    {y : Raw D} (h : SameStratum D y (Sum.inl ⟨i, x⟩)) :
    ∃ y' : stdSimplex ℝ (Fin (n + 2)), y = Sum.inl ⟨i, y'⟩ ∧ ptSupport y' = ptSupport x := by
  obtain ⟨i', y', h1, h2, h3⟩ := sameStratum_inl.mp h
  rw [h2] at h1
  cases h1
  exact ⟨y', rfl, h3⟩

/-- Points of the same stratum have the same weight. -/
theorem sameStratum_rawWeight {D : MData X n x₀} {y a : Raw D} (h : SameStratum D y a) :
    rawWeight D y = rawWeight D a := by
  rcases h with ⟨i, x, y', h1, h2, h3⟩ | ⟨i, t, h1, h2⟩
  · rw [h1, h2, rawWeight_inl, rawWeight_inl, h3]
  · rw [h1, h2]

/-- **The link relation.**  `LinkTo D a b` says: every point of the stratum of `a` is related, in
the equivalence relation generated by the gluing, to a point of the stratum of `b`. -/
def LinkTo (D : MData X n x₀) (a b : Raw D) : Prop :=
  ∀ y, SameStratum D y a → ∃ z, SameStratum D z b ∧ Relation.EqvGen (modelRel D) y z

theorem linkTo_refl (D : MData X n x₀) (a : Raw D) : LinkTo D a a :=
  fun y hy => ⟨y, hy, Relation.EqvGen.refl y⟩

theorem linkTo_trans (D : MData X n x₀) {a b c : Raw D} (hab : LinkTo D a b) (hbc : LinkTo D b c) :
    LinkTo D a c := by
  intro y hy
  obtain ⟨z, hz, hyz⟩ := hab y hy
  obtain ⟨w, hw, hzw⟩ := hbc z hz
  exact ⟨w, hw, Relation.EqvGen.trans y z w hyz hzw⟩

/-! ## The `p`-th face of a simplex

`facept (n+1) p` is the inclusion of `Δ^n` as the set of points of `Δ^{n+1}` whose `p`-th
coordinate vanishes; the coordinate computation and the existence of a preimage for a point with
vanishing `p`-th coordinate are the combinatorial content of the gluing relation. -/

/-- The `p`-th coordinate of a point in the image of the `p`-th face map vanishes. -/
theorem facept_apply_self {n : ℕ} (p : Fin (n + 2)) (u : stdSimplex ℝ (Fin (n + 1))) :
    ((facept (n + 1) p u : stdSimplex ℝ (Fin (n + 2))) : Fin (n + 2) → ℝ) p = 0 := by
  rw [coord_facept]
  exact Finset.sum_eq_zero fun i hi => by
    rw [Finset.mem_filter] at hi
    exact absurd hi.2 (Fin.succAbove_ne p i)

/-- **The range of the `p`-th face map.**  A point of `Δ^{n+1}` whose `p`-th coordinate vanishes
is the `p`-th face point of a point of `Δ^n`. -/
theorem exists_facept_eq_of_coord_zero {n : ℕ} (p : Fin (n + 2))
    {y : stdSimplex ℝ (Fin (n + 2))} (hy : (y : Fin (n + 2) → ℝ) p = 0) :
    ∃ u : stdSimplex ℝ (Fin (n + 1)), facept (n + 1) p u = y := by
  have hsum : (∑ i : Fin (n + 1), (y : Fin (n + 2) → ℝ) (p.succAbove i)) = 1 := by
    have h2 := Fin.sum_univ_succAbove (fun k : Fin (n + 2) => (y : Fin (n + 2) → ℝ) k) p
    rw [show (∑ k : Fin (n + 2), (y : Fin (n + 2) → ℝ) k) = 1 from y.2.2, hy,
      zero_add] at h2
    exact h2.symm
  refine ⟨⟨fun i => y (p.succAbove i), fun i => y.2.1 _, hsum⟩, ?_⟩
  apply Subtype.ext
  funext k
  show ((facept (n + 1) p ⟨fun i => y (p.succAbove i), fun i => y.2.1 _, hsum⟩ :
      stdSimplex ℝ (Fin (n + 2))) : Fin (n + 2) → ℝ) k = y k
  by_cases hk : k = p
  · rw [hk, hy]
    exact facept_apply_self p ⟨fun i => y (p.succAbove i), fun i => y.2.1 _, hsum⟩
  · have h1 := facept_apply_succAbove (m := n + 1) p
      (⟨fun i => y (p.succAbove i), fun i => y.2.1 _, hsum⟩ : stdSimplex ℝ (Fin (n + 1)))
      (invSuccAbove p k)
    rw [succAbove_invSuccAbove p hk] at h1
    rw [h1]
    change y (p.succAbove (invSuccAbove p k)) = y k
    rw [succAbove_invSuccAbove p hk]

/-- The support of the preimage under a face map. -/
theorem exists_facept_eq_of_coord_zero_supp {n : ℕ} (p : Fin (n + 2))
    {y : stdSimplex ℝ (Fin (n + 2))} (hy : (y : Fin (n + 2) → ℝ) p = 0) :
    ∃ u : stdSimplex ℝ (Fin (n + 1)), facept (n + 1) p u = y ∧
      ∀ i, (i ∈ suppOf u ↔ p.succAbove i ∈ suppOf y) := by
  obtain ⟨u, hu⟩ := exists_facept_eq_of_coord_zero p hy
  exact ⟨u, hu, fun i => by
    rw [mem_suppOf, mem_suppOf, ← hu, facept_apply_succAbove]⟩


/-- **Points of a stratum are determined by their class**: two related points of the same stratum of
the model are equal. -/
theorem stratumInj {D : MData X n x₀} {y y' : Raw D} (h : SameStratum D y' y)
    (hrel : Relation.EqvGen (modelRel D) y y') : y = y' := by
  rcases y with ⟨i, x⟩ | ⟨i, t⟩
  · obtain ⟨y'', h1, h2⟩ := sameStratum_inl_iff (D := D) h
    rw [h1] at hrel
    rw [h1, eq_of_eqvGen_sameCopy hrel h2.symm]
  · obtain ⟨i', t', h1, h2, h3⟩ := sameStratum_inr.mp h
    rw [h2] at h1
    rw [h3] at h1
    rw [h1]

end

end Work.RatHurewicz
