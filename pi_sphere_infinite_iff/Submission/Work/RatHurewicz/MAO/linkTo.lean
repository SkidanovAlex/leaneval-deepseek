import Mathlib
import Submission.Work.RatHurewicz.MAO.Defs

/-!
# The equivalence classes of the model are unions of strata

If two raw points are related in the equivalence relation generated by the gluing relation
`Work.RatHurewicz.modelRel D`, then every point of the stratum of the first is identified with a
point of the stratum of the second, and conversely (`Work.RatHurewicz.LinkTo`, defined in
`Submission.Work.RatHurewicz.MAO.Defs`).

The proof is an induction on the equivalence relation (with `linkTo_refl` and `linkTo_trans` for
the refl/trans steps and the two conjuncts exchanged for the symm step).  The interesting step is a
*generating* relation, of one of the three forms of `modelRel`:

* two faces: `a = Sum.inl ⟨i, facept (n+1) p u⟩` and `b = Sum.inl ⟨j, facept (n+1) q u⟩`; here the
  required correspondence between the two strata is "the same `u` on both sides" -- a point of the
  stratum of `facept p u` is `facept p u'` for a unique `u'`, and `u'` has the same support as
  `u` exactly when the point is in the stratum of `facept q u` (`sameStratum_inl_iff`,
  `exists_facept_eq_of_coord_zero_supp`, `suppOf_facept`);
* a vertex and an arc: both strata are contained in the two-point set made of the vertex and the
  arc end (a point of the standard simplex with singleton support is the corresponding vertex);
* two arc ends: the strata are the single points.
-/

open scoped Topology Simplicial unitInterval

namespace Work.RatHurewicz.MAO

open Work.RatHurewicz

variable {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}

/-! ## Elementary facts about supports -/

/-- Membership in the image of a finite set of vertices under `Fin.succAbove`. -/
theorem mem_image_succAbove {m : ℕ} (p : Fin (m + 2)) (S : Finset (Fin (m + 1)))
    (k : Fin (m + 1)) : p.succAbove k ∈ S.image p.succAbove ↔ k ∈ S := by
  constructor
  · intro h
    obtain ⟨a, ha, hae⟩ := Finset.mem_image.mp h
    obtain rfl : a = k := Fin.succAbove_right_injective hae
    exact ha
  · intro hk
    exact Finset.mem_image.mpr ⟨k, hk, rfl⟩

/-- A point of the standard simplex whose support is a singleton is the corresponding vertex. -/
theorem eq_vertex_of_suppOf_eq_singleton {m : ℕ} {x : stdSimplex ℝ (Fin (m + 2))}
    {a : Fin (m + 2)} (h : suppOf x = {a}) : x = stdSimplex.vertex (S := ℝ) a := by
  apply Subtype.ext
  funext k
  show (x : Fin (m + 2) → ℝ) k = (stdSimplex.vertex (S := ℝ) a : stdSimplex ℝ (Fin (m + 2))) k
  rw [stdSimplex.vertex_coe, Pi.single_apply]
  by_cases hk : k = a
  · rw [hk, if_pos rfl]
    have hzero : ∀ j, j ≠ a → (x : Fin (m + 2) → ℝ) j = 0 := by
      intro j hj
      by_contra hj0
      have hjmem : j ∈ suppOf x := mem_suppOf.mpr hj0
      rw [h] at hjmem
      exact hj (Finset.mem_singleton.mp hjmem)
    have hsum : (∑ j : Fin (m + 2), (x : Fin (m + 2) → ℝ) j) = 1 := x.2.2
    rw [Finset.sum_eq_single a (fun j _ hj => hzero j hj)
      (fun ha' => absurd (Finset.mem_univ a) ha')] at hsum
    exact hsum
  · rw [if_neg hk]
    by_contra hx0
    have hxmem : k ∈ suppOf x := mem_suppOf.mpr hx0
    rw [h] at hxmem
    exact hk (Finset.mem_singleton.mp hxmem)

/-- The stratum of a vertex of a copy of `Δ^{n+1}` is that single point. -/
theorem sameStratum_vertex_eq {D : MData X n x₀} {i : D.Idx} {y : Raw D}
    (hy : SameStratum D y (Sum.inl ⟨i, stdSimplex.vertex (S := ℝ) (0 : Fin (n + 2))⟩)) :
    y = Sum.inl ⟨i, stdSimplex.vertex (S := ℝ) (0 : Fin (n + 2))⟩ := by
  obtain ⟨y', hyeq, hysupp⟩ := sameStratum_inl_iff hy
  have hvert : y' = stdSimplex.vertex (S := ℝ) (0 : Fin (n + 2)) := by
    refine eq_vertex_of_suppOf_eq_singleton (m := n) (a := (0 : Fin (n + 2))) ?_
    rw [show suppOf y' = suppOf (stdSimplex.vertex (S := ℝ) (0 : Fin (n + 2))) from hysupp,
      suppOf_vertex n (0 : Fin (n + 2))]
  rw [hyeq, hvert]

/-- The stratum of a point of an arc is that single point. -/
theorem sameStratum_arc_eq {D : MData X n x₀} {i : D.Idx} {t : unitInterval} {y : Raw D}
    (hy : SameStratum D y (Sum.inr ⟨i, t⟩)) : y = Sum.inr ⟨i, t⟩ := by
  obtain ⟨i', t', hyeq, hi', ht'⟩ := sameStratum_inr.mp hy
  rw [hyeq, hi', ht']

/-! ## The step for a generating relation -/

/-- **The two-face step.**  If the `p`-th face of the `i`-th cell is glued to the `q`-th face of
the `j`-th cell, then the strata of corresponding face points are linked in both directions. -/
theorem linkTo_face {D : MData X n x₀} {i j : D.Idx} {p q : Fin (n + 2)}
    {x : stdSimplex ℝ (Fin (n + 1))}
    (hcompat : (D.simplexMap i).comp (facept (n + 1) p) =
      (D.simplexMap j).comp (facept (n + 1) q)) :
    LinkTo D (Sum.inl ⟨i, facept (n + 1) p x⟩) (Sum.inl ⟨j, facept (n + 1) q x⟩) := by
  intro y hy
  obtain ⟨y', hyeq, hysupp⟩ := sameStratum_inl_iff hy
  have hysupp' : suppOf y' = (suppOf x).image p.succAbove := by
    rw [show suppOf y' = suppOf (facept (n + 1) p x) from hysupp, suppOf_facept n p x]
  have hpzero : (y' : Fin (n + 2) → ℝ) p = 0 := by
    by_contra hp
    have hp' : p ∈ suppOf y' := mem_suppOf.mpr hp
    rw [hysupp'] at hp'
    obtain ⟨k, -, hk⟩ := Finset.mem_image.mp hp'
    exact Fin.succAbove_ne p k hk
  obtain ⟨v, hv, hsuppv⟩ := exists_facept_eq_of_coord_zero_supp (n := n) p hpzero
  have hvsu : suppOf v = suppOf x := by
    ext k
    rw [hsuppv k, hysupp']
    exact mem_image_succAbove p (suppOf x) k
  refine ⟨Sum.inl ⟨j, facept (n + 1) q v⟩, ?_, ?_⟩
  · refine Or.inl ⟨j, facept (n + 1) q x, facept (n + 1) q v, rfl, rfl, ?_⟩
    show suppOf (facept (n + 1) q v) = suppOf (facept (n + 1) q x)
    rw [suppOf_facept n q v, suppOf_facept n q x, hvsu]
  · rw [hyeq, ← hv]
    exact Relation.EqvGen.rel _ _ (Or.inl ⟨i, j, p, q, v, rfl, rfl, hcompat⟩)

/-- **The step for a generating relation of the gluing.** -/
theorem linkTo_of_rel {D : MData X n x₀} {a b : Raw D} (h : modelRel D a b) :
    LinkTo D a b ∧ LinkTo D b a := by
  rcases h with ⟨i, j, p, q, x, rfl, rfl, hcompat⟩ | ⟨i, rfl, rfl⟩ | ⟨i, j, rfl, rfl⟩
  · exact ⟨linkTo_face hcompat, linkTo_face hcompat.symm⟩
  · refine ⟨?_, ?_⟩
    · intro y hy
      rw [sameStratum_vertex_eq (D := D) hy]
      exact ⟨Sum.inr ⟨i, 0⟩, sameStratum_self D _,
        Relation.EqvGen.rel _ _ (Or.inr (Or.inl ⟨i, rfl, rfl⟩))⟩
    · intro y hy
      rw [sameStratum_arc_eq (D := D) hy]
      exact ⟨Sum.inl ⟨i, stdSimplex.vertex (S := ℝ) (0 : Fin (n + 2))⟩, sameStratum_self D _,
        Relation.EqvGen.symm _ _
          (Relation.EqvGen.rel _ _ (Or.inr (Or.inl ⟨i, rfl, rfl⟩)))⟩
  · refine ⟨?_, ?_⟩
    · intro y hy
      rw [sameStratum_arc_eq (D := D) hy]
      exact ⟨Sum.inr ⟨j, 1⟩, sameStratum_self D _,
        Relation.EqvGen.rel _ _ (Or.inr (Or.inr ⟨i, j, rfl, rfl⟩))⟩
    · intro y hy
      rw [sameStratum_arc_eq (D := D) hy]
      exact ⟨Sum.inr ⟨i, 1⟩, sameStratum_self D _,
        Relation.EqvGen.symm _ _
          (Relation.EqvGen.rel _ _ (Or.inr (Or.inr ⟨i, j, rfl, rfl⟩)))⟩

/-! ## The link statement -/

theorem linkTo {X : Type} [TopologicalSpace X] {x₀ : X} {n : ℕ}
    (D : Work.RatHurewicz.MData X n x₀) {a b : Work.RatHurewicz.Raw D}
    (h : Relation.EqvGen (Work.RatHurewicz.modelRel D) a b) :
    Work.RatHurewicz.LinkTo D a b ∧ Work.RatHurewicz.LinkTo D b a := by
  induction h with
  | rel x y hr => exact linkTo_of_rel hr
  | refl x => exact ⟨linkTo_refl D x, linkTo_refl D x⟩
  | symm x y hxy ih => exact ⟨ih.2, ih.1⟩
  | trans x y z hxy hyz ihxy ihyz =>
      exact ⟨linkTo_trans D ihxy.1 ihyz.1, linkTo_trans D ihyz.2 ihxy.2⟩

end Work.RatHurewicz.MAO
