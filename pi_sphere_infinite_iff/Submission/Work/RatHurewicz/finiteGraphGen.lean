import Submission.Work.RatHurewicz.finiteGraphDefs
import Submission.Work.RatHurewicz.GraphPi.arcChainExists
import Submission.Work.RatHurewicz.GraphPi.arcChainEdgePath

/-!
# A finite generating set for `π₁` of the finite graph

For the graph `GraphX a b` with basepoint `gq a b (Sum.inl v₀)` we exhibit a finite set of loops
whose classes generate the fundamental group.  The main lemma (`edgePathTelescope`) says that for
any formal edge path `c` from `u` to `w`, the class of `(chosen path to u) · (edge path c) ·
(chosen path to w)⁻¹` lies in the subgroup generated by that finite set.
-/

namespace Work.RatHurewicz

open scoped unitInterval

set_option linter.unusedSectionVars false
set_option autoImplicit false

noncomputable section

namespace FinGraph

/-! ## Groupoid identities -/

lemma fgSymmTransTrans {X : Type*} [TopologicalSpace X] {p q r : X}
    (B : Path.Homotopic.Quotient p q) (Y : Path.Homotopic.Quotient q r) :
    B.symm.trans (B.trans Y) = Y := by
  rw [← Path.Homotopic.Quotient.trans_assoc, Path.Homotopic.Quotient.symm_trans,
    Path.Homotopic.Quotient.refl_trans]

lemma fgConjTelescope {X : Type*} [TopologicalSpace X] {p₀ x₁ x₂ x₃ : X}
    (A : Path.Homotopic.Quotient p₀ x₁) (Q : Path.Homotopic.Quotient x₁ x₂)
    (S : Path.Homotopic.Quotient x₂ x₃) (R : Path.Homotopic.Quotient p₀ x₂)
    (T : Path.Homotopic.Quotient p₀ x₃) :
    A.trans ((Q.trans S).trans T.symm) =
      (A.trans (Q.trans R.symm)).trans (R.trans (S.trans T.symm)) := by
  conv_lhs => rw [Path.Homotopic.Quotient.trans_assoc]
  conv_rhs => rw [Path.Homotopic.Quotient.trans_assoc]
  conv_rhs => rw [Path.Homotopic.Quotient.trans_assoc]
  conv_rhs => rw [fgSymmTransTrans]

lemma fgConjSymm {X : Type*} [TopologicalSpace X] {p₀ x₁ x₂ : X}
    (A : Path.Homotopic.Quotient p₀ x₁) (E : Path.Homotopic.Quotient x₂ x₁)
    (B : Path.Homotopic.Quotient p₀ x₂) :
    A.trans (E.symm.trans B.symm) = (B.trans (E.trans A.symm)).symm := by
  have h1 : (A.trans (E.symm.trans B.symm)).trans (B.trans (E.trans A.symm)) =
      Path.Homotopic.Quotient.refl p₀ := by
    conv_lhs => rw [Path.Homotopic.Quotient.trans_assoc]
    conv_lhs => rw [Path.Homotopic.Quotient.trans_assoc]
    conv_lhs => rw [fgSymmTransTrans]
    conv_lhs => rw [fgSymmTransTrans]
    conv_lhs => rw [Path.Homotopic.Quotient.trans_symm]
  calc A.trans (E.symm.trans B.symm)
      = (A.trans (E.symm.trans B.symm)).trans
          ((B.trans (E.trans A.symm)).trans (B.trans (E.trans A.symm)).symm) := by
        rw [Path.Homotopic.Quotient.trans_symm, Path.Homotopic.Quotient.trans_refl]
    _ = ((A.trans (E.symm.trans B.symm)).trans (B.trans (E.trans A.symm))).trans
          (B.trans (E.trans A.symm)).symm := by
        conv_rhs => rw [Path.Homotopic.Quotient.trans_assoc]
    _ = (Path.Homotopic.Quotient.refl p₀).trans (B.trans (E.trans A.symm)).symm := by rw [h1]
    _ = (B.trans (E.trans A.symm)).symm := by
        rw [Path.Homotopic.Quotient.refl_trans]

lemma loopOf_mul {X : Type} [TopologicalSpace X] {x : X} (p q : Path x x) :
    loopOf p * loopOf q = loopOf (q.trans p) := by
  rw [loopOf, loopOf, FundamentalGroup.mul_def, ← Path.Homotopic.Quotient.mk_trans, loopOf]

/-! ## The finite generating set -/

variable {E V : Type} [Fintype E] [Fintype V] [TopologicalSpace E] [DiscreteTopology E]
  [TopologicalSpace V] [DiscreteTopology V]

/-- The vertices reachable from the basepoint. -/
abbrev ReachV (a b : E → V) (v₀ : V) : Type :=
  {v : V // Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl v)))}

/-- A chosen path from the basepoint to a reachable vertex. -/
def basePath (a b : E → V) (v₀ : V) (v : ReachV a b v₀) :
    Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl v.1)) :=
  Classical.choice v.2

lemma basePath_proof_irrel {a b : E → V} {v₀ : V} {v : V}
    (h₁ h₂ : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl v)))) :
    basePath a b v₀ ⟨v, h₁⟩ = basePath a b v₀ ⟨v, h₂⟩ := by
  have h : (⟨v, h₁⟩ : ReachV a b v₀) = ⟨v, h₂⟩ := Subtype.ext rfl
  rw [h]

/-- The edges whose `a`-end is reachable. -/
abbrev ReachE (a b : E → V) (v₀ : V) : Type :=
  {e : E // Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl (a e))))}

/-- The generator loop of a reachable edge. -/
def genPath (a b : E → V) (v₀ : V) (e : ReachE a b v₀) :
    Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl v₀)) :=
  (basePath a b v₀ ⟨a e.1, e.2⟩).trans ((edgePath a b e.1).trans
    (basePath a b v₀ ⟨b e.1, ⟨(basePath a b v₀ ⟨a e.1, e.2⟩).trans (edgePath a b e.1)⟩⟩).symm)

/-- The finite generating set of the fundamental group of the graph. -/
def genSet (a b : E → V) (v₀ : V) : Set (FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))) :=
  Set.range (fun e : ReachE a b v₀ => loopOf (genPath a b v₀ e)) ∪
    {loopOf (basePath a b v₀ ⟨v₀, ⟨Path.refl _⟩⟩)}

/-- The subgroup generated by `genSet`. -/
def genSub (a b : E → V) (v₀ : V) : Subgroup (FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))) :=
  Subgroup.closure (genSet a b v₀)

lemma finite_genSet (a b : E → V) (v₀ : V) : (genSet a b v₀).Finite := by
  refine Set.Finite.union ?_ (Set.finite_singleton _)
  exact Set.finite_range _

variable (a b : E → V) (v₀ : V)

lemma genSub_trans {a b : E → V} {v₀ : V}
    {p q : FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))}
    (hp : p ∈ genSub a b v₀) (hq : q ∈ genSub a b v₀) : p.trans q ∈ genSub a b v₀ := by
  have h : q * p ∈ genSub a b v₀ := Subgroup.mul_mem _ hq hp
  rwa [FundamentalGroup.mul_def] at h

lemma genSub_symm {a b : E → V} {v₀ : V}
    {p : FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))}
    (hp : p ∈ genSub a b v₀) : p⁻¹ ∈ genSub a b v₀ := Subgroup.inv_mem _ hp

/-- The class of the chosen basepoint loop, a member of `genSet`. -/
def baseLoop (a b : E → V) (v₀ : V) : FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀)) :=
  loopOf (basePath a b v₀ ⟨v₀, ⟨Path.refl _⟩⟩)

/-- The class of the path `(path to u) · (edge path c) · (path to w)⁻¹`. -/
def conjClass (u w : V) (hu : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl u))))
    (hw : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl w))))
    (c : EdgePath a b u w) : FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀)) :=
  loopOf ((basePath a b v₀ ⟨u, hu⟩).trans
    ((EdgePath.toPath a b c).trans (basePath a b v₀ ⟨w, hw⟩).symm))

/-- The class of the chosen path from the basepoint to itself, a member of `genSet`. -/
lemma basePath_mem_genSet : loopOf (basePath a b v₀ ⟨v₀, ⟨Path.refl _⟩⟩) ∈ genSet a b v₀ :=
  Or.inr rfl

/-- **The telescoping lemma.**  For every formal edge path `c` from `u` to `w`, the class of
`(path to u) · c · (path to w)⁻¹` lies in the subgroup generated by `genSet`. -/
theorem edgePathTelescope {u w : V} (c : EdgePath a b u w) :
    ∀ (hu : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl u))))
      (hw : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl w)))),
      conjClass a b v₀ u w hu hw c ∈ genSub a b v₀ := by
  induction c with
  | refl v =>
      intro hu hw
      have hmain : conjClass a b v₀ v v hu hw (.refl v) = 1 := by
        have hbase : basePath a b v₀ ⟨v, hu⟩ = basePath a b v₀ ⟨v, hw⟩ :=
          basePath_proof_irrel hu hw
        rw [conjClass, EdgePath.toPath_refl, hbase, loopOf,
          Path.Homotopic.Quotient.mk_trans, Path.Homotopic.Quotient.mk_trans,
          Path.Homotopic.Quotient.mk_refl, Path.Homotopic.Quotient.mk_symm,
          Path.Homotopic.Quotient.refl_trans, Path.Homotopic.Quotient.trans_symm,
          ← FundamentalGroup.one_def]
      rw [hmain]
      exact Subgroup.one_mem _
  | fwd e =>
      intro hu hw
      have heq : conjClass a b v₀ (a e) (b e) hu hw (.fwd e) =
          loopOf (genPath a b v₀ ⟨e, hu⟩) := by
        simp only [conjClass, genPath, EdgePath.toPath_fwd, loopOf]
      exact Subgroup.subset_closure (Or.inl ⟨⟨e, hu⟩, heq.symm⟩)
  | bwd e =>
      intro hu hw
      have heq : conjClass a b v₀ (a e) (b e) hw hu (.fwd e) =
          loopOf (genPath a b v₀ ⟨e, hw⟩) := by
        simp only [conjClass, genPath, EdgePath.toPath_fwd, loopOf]
      have hsymm : conjClass a b v₀ (b e) (a e) hu hw (.bwd e) =
          (conjClass a b v₀ (a e) (b e) hw hu (.fwd e))⁻¹ := by
        have key := fgConjSymm (Path.Homotopic.Quotient.mk (basePath a b v₀ ⟨b e, hu⟩))
          (Path.Homotopic.Quotient.mk (edgePath a b e))
          (Path.Homotopic.Quotient.mk (basePath a b v₀ ⟨a e, hw⟩))
        simp only [conjClass, conjClass, EdgePath.toPath_bwd, EdgePath.toPath_fwd, loopOf,
          Path.Homotopic.Quotient.mk_trans, Path.Homotopic.Quotient.mk_symm]
        rw [FundamentalGroup.inv_def]
        exact key
      rw [hsymm, heq]
      refine Subgroup.inv_mem _ (Subgroup.subset_closure (Or.inl ⟨⟨e, hw⟩, ?_⟩))
      rfl
  | trans p q ihp ihq =>
      intro hu hw
      have hv : Nonempty (Path (gq a b (Sum.inl v₀)) (gq a b (Sum.inl _))) :=
        ⟨(basePath a b v₀ ⟨_, hu⟩).trans (EdgePath.toPath a b p)⟩
      have hsplit : conjClass a b v₀ _ _ hu hw (.trans p q) =
          (conjClass a b v₀ _ _ hu hv p).trans (conjClass a b v₀ _ _ hv hw q) := by
        have key := fgConjTelescope
          (Path.Homotopic.Quotient.mk (basePath a b v₀ ⟨_, hu⟩))
          (Path.Homotopic.Quotient.mk (EdgePath.toPath a b p))
          (Path.Homotopic.Quotient.mk (EdgePath.toPath a b q))
          (Path.Homotopic.Quotient.mk (basePath a b v₀ ⟨_, hv⟩))
          (Path.Homotopic.Quotient.mk (basePath a b v₀ ⟨_, hw⟩))
        simp only [conjClass, loopOf, EdgePath.toPath_trans,
          Path.Homotopic.Quotient.mk_trans, Path.Homotopic.Quotient.mk_symm]
        exact key
      rw [hsplit]
      exact Subgroup.mul_mem _ (ihq hv hw) (ihp hu hv)

/-- The generating set generates the whole fundamental group. -/
theorem genSub_eq_top : genSub a b v₀ = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro z
  obtain ⟨γ, rfl⟩ := Path.Homotopic.Quotient.mk_surjective z
  obtain ⟨c, hc⟩ := GraphPi.arcChainExists a b γ
  obtain ⟨c', hc'⟩ := GraphPi.arcChainEdgePath a b v₀ v₀ c
  have hγ : Path.Homotopic.Quotient.mk γ = loopOf (EdgePath.toPath a b c') :=
    (Path.Homotopic.Quotient.eq).mpr (hc.trans hc')
  rw [hγ]
  -- the conjugated class is in the subgroup
  have hconj : conjClass a b v₀ v₀ v₀ ⟨Path.refl _⟩ ⟨Path.refl _⟩ c' ∈ genSub a b v₀ :=
    edgePathTelescope a b v₀ c' _ _
  have hP : baseLoop a b v₀ ∈ genSub a b v₀ :=
    Subgroup.subset_closure (Or.inr rfl)
  have hsplit : conjClass a b v₀ v₀ v₀ ⟨Path.refl _⟩ ⟨Path.refl _⟩ c' =
      (baseLoop a b v₀).trans
        ((loopOf (EdgePath.toPath a b c')).trans (baseLoop a b v₀).symm) := rfl
  rw [hsplit] at hconj
  have hPP : (baseLoop a b v₀)⁻¹ ∈ genSub a b v₀ := genSub_symm hP
  have hbig : (baseLoop a b v₀)⁻¹.trans
      (((baseLoop a b v₀).trans ((loopOf (EdgePath.toPath a b c')).trans
        (baseLoop a b v₀).symm)).trans (baseLoop a b v₀)) ∈ genSub a b v₀ :=
    genSub_trans hPP (genSub_trans hconj hP)
  have hid : (baseLoop a b v₀)⁻¹.trans
      (((baseLoop a b v₀).trans ((loopOf (EdgePath.toPath a b c')).trans
        (baseLoop a b v₀).symm)).trans (baseLoop a b v₀)) =
      loopOf (EdgePath.toPath a b c') := by
    rw [FundamentalGroup.inv_def, ← Path.Homotopic.Quotient.trans_assoc,
      ← Path.Homotopic.Quotient.trans_assoc, Path.Homotopic.Quotient.symm_trans,
      Path.Homotopic.Quotient.refl_trans, Path.Homotopic.Quotient.trans_assoc,
      Path.Homotopic.Quotient.symm_trans, Path.Homotopic.Quotient.trans_refl]
  rw [hid] at hbig
  exact hbig


/-- The fundamental group of the finite graph is finitely generated. -/
theorem genSub_fg : Group.FG (FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))) := by
  have hfinite : (genSet a b v₀).Finite := finite_genSet a b v₀
  haveI : Finite (genSet a b v₀) := hfinite.to_subtype
  have h1 : Group.FG (genSub a b v₀) := Group.closure_finite_fg (genSet a b v₀)
  have h2 : Group.FG (↥(⊤ : Subgroup (FundamentalGroup (GraphX a b) (gq a b (Sum.inl v₀))))) := by
    rw [← genSub_eq_top a b v₀]
    exact h1
  exact Group.fg_of_surjective (f := (Subgroup.topEquiv (G := FundamentalGroup (GraphX a b)
    (gq a b (Sum.inl v₀)))).toMonoidHom)
    (EquivLike.surjective (Subgroup.topEquiv (G := FundamentalGroup (GraphX a b)
      (gq a b (Sum.inl v₀)))))

end FinGraph

end

