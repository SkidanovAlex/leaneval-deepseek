import Mathlib
import Submission.Work.Stems.wangUptoBounded

/-!
# The low-degree Wang step: vanishing of `H^b(E)` from the fibre

*(Area STEMS.)*  Let `p : E → Sᵇ` (`b ≥ 2`) be a Hurewicz fibration which is fibrewise trivial over
the two discs `O = sphLoopOuter b` and `G = sphLoopBig b`, let `F = p ⁻¹' {∞}` be the fibre and
`A = p ⁻¹' O ⊂ E` the outer piece.  Write `θ_low : H^{b-1}(F) → H⁰(F)` for the low-degree Wang
transgression `ρ ∘ Σ ∘ λ_G^*` (`Work.StemsB.Rat.wangThetaLow`) — equivalently, under the
identifications `γ : H^{b-1}(A) ≅ H^{b-1}(F)` and `τ : H^{b}(E,A) ≅ H⁰(F)` of the low-degree Wang
sequence, `θ_low = τ ∘ δ ∘ γ⁻¹` where `δ` is the connecting homomorphism of the pair `(E,A)`.

The statement proved here: **if `θ_low` does not kill `x` and `H^b(F) = 0`, then `H^b(E) = 0`.**

The proof is the long exact sequence of the pair `(E,A)` together with the two identifications
above; no spectral sequence is needed.

* `τ : H^b(E,A) ≅ H⁰(F)` is an isomorphism, so `H^b(E,A)` is one-dimensional over `ℚ` as soon as
  `F` is path connected: every element of `H⁰(F)` is a multiple of the unit class
  (`Work.Stems.exists_smul_oneH_rat`), hence every element of `H^b(E,A)` is a multiple of
  `τ⁻¹(1)`.  Since `θ_low x ≠ 0`, the class `δ (γ⁻¹ x)` is non-zero, so `δ` is **surjective**.
* Exactness of the pair sequence at `H^b(E,A)` (`Work.Cohomology.pair_exact₁`, degree `b-1`) then
  reads `ker (relIncl) = range δ = ⊤`, i.e. `relIncl = 0`.
* Exactness at `H^b(E)` (`Work.Cohomology.pair_exact₂`) gives
  `ker (restr) = range (relIncl) = ⊥`; combined with the vanishing `H^b(F) = 0` (which makes
  `H^b(A) = 0`, `γ` being an isomorphism) this yields `H^b(E) = 0`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits
open scoped Topology

namespace Work.Stems

noncomputable section

/-- An isomorphism of modules is injective on the underlying functions (in the form needed below,
where the iso is given by its `ModuleCat.Hom`). -/
private lemma hom_injective_of_iso {R : Type} [CommRing R] {M N : ModuleCat R} (e : M ≅ N) :
    Function.Injective (ModuleCat.Hom.hom e.hom) :=
  fun _ _ h => Work.StemsB.iso_hom_injective_R R e h

/-- `Subsingleton` transfers backwards along an isomorphism of modules. -/
private lemma subsingleton_of_iso {R : Type} [CommRing R] {M N : ModuleCat R} (e : M ≅ N)
    (h : Subsingleton ↥N) : Subsingleton ↥M :=
  ⟨fun a b => hom_injective_of_iso e
    (h.allEq ((ModuleCat.Hom.hom e.hom) a) ((ModuleCat.Hom.hom e.hom) b))⟩

theorem wangLowDegree (b : ℕ) (hb : 2 ≤ b) (hbodd : Odd b)
    (E : Type) [TopologicalSpace E] (p : C(E, Work.StemsB.SphModel b))
    (hp : Work.StemsB.IsHurewiczFibration p)
    (hT_O : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopOuter b) (Work.StemsB.dOuter b))
    (d_G : ↥(Work.StemsB.sphLoopBig b))
    (hT_G : Work.StemsB.FibrewiseTrivial p (Work.StemsB.sphLoopBig b) d_G)
    (x : Work.Thom.Coh ℚ (b - 1) ↥(p ⁻¹' {OnePoint.infty}))
    (hpc : PathConnectedSpace ↥(p ⁻¹' {OnePoint.infty}))
    (hlow : Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x ≠ 0)
    (hfib_b : Subsingleton ↥(Work.Cohomology.singularCohomology ℚ b (Work.StemsB.wangCohFsp b p))) :
    Subsingleton ↥(Work.Cohomology.singularCohomology ℚ b (TopCat.of E)) := by
  -- the three ingredients of the low-degree Wang sequence
  let tIso := Work.StemsB.Rat.wangTauSLow b hb E p hT_O d_G hT_G
  let τh := ModuleCat.Hom.hom tIso.hom
  let δ := ModuleCat.Hom.hom (Work.Cohomology.pairδ ℚ (TopCat.of E)
    (Work.StemsB.Rat.wangA b p) (b - 1))
  let γi := ModuleCat.Hom.hom (Work.StemsB.Rat.wangGammaExplicit b p hT_O (b - 1)).inv
  let relIncl := HomologicalComplex.homologyMap (Work.Cohomology.relIncl ℚ (TopCat.of E)
    (Work.StemsB.Rat.wangA b p)) ((b - 1) + 1)
  let restr := HomologicalComplex.homologyMap (Work.Cohomology.restr ℚ (TopCat.of E)
    (Work.StemsB.Rat.wangA b p)) ((b - 1) + 1)
  -- the value of the low-degree transgression on the given class
  have hτv : τh (δ (γi x)) = Work.StemsB.Rat.wangThetaLow b hb E p d_G hT_G hT_O x :=
    Work.StemsB.Rat.wangTauSLow_value b hb E p hT_O d_G hT_G x
  have hvne : τh (δ (γi x)) ≠ 0 := by rw [hτv]; exact hlow
  haveI : PathConnectedSpace (Work.StemsB.wangCohFsp b p) := hpc
  -- `δ` is surjective: `H^b(E,A) ≅ H⁰(F)` is generated by one element
  have hsurj : Function.Surjective δ := by
    intro y
    obtain ⟨c₀, hc₀⟩ := Work.Stems.exists_smul_oneH_rat (Work.StemsB.wangCohFsp b p)
      (τh (δ (γi x)))
    have hc₀ne : c₀ ≠ 0 := fun h => hvne (by rw [hc₀, h, zero_smul])
    obtain ⟨c, hc⟩ := Work.Stems.exists_smul_oneH_rat (Work.StemsB.wangCohFsp b p) (τh y)
    refine ⟨(c / c₀) • γi x, ?_⟩
    apply Work.Stems.hom_injective_of_iso tIso
    rw [map_smul δ, map_smul τh, hc₀, hc, smul_smul, div_mul_cancel₀ c hc₀ne]
  -- exactness at `H^b(E,A)`: `range δ = ker relIncl`
  have hex1 := Work.Cohomology.pair_exact₁ ℚ (TopCat.of E) (Work.StemsB.Rat.wangA b p) (b - 1)
  have hrg1 : δ.range = (ModuleCat.Hom.hom relIncl).ker :=
    ShortComplex.Exact.moduleCat_range_eq_ker hex1
  have hrelIncl0 : ModuleCat.Hom.hom relIncl = 0 :=
    LinearMap.ker_eq_top.mp (by rw [← hrg1, LinearMap.range_eq_top.mpr hsurj])
  -- exactness at `H^b(E)`: `range relIncl = ker restr`
  have hex2 := Work.Cohomology.pair_exact₂ ℚ (TopCat.of E) (Work.StemsB.Rat.wangA b p) ((b - 1) + 1)
  have hrg2 : (ModuleCat.Hom.hom relIncl).range = (ModuleCat.Hom.hom restr).ker :=
    ShortComplex.Exact.moduleCat_range_eq_ker hex2
  have hker2 : (ModuleCat.Hom.hom restr).ker = ⊥ := by
    rw [← hrg2, hrelIncl0, LinearMap.range_zero]
  -- `H^b(A) = 0` (from `H^b(F) = 0`, `γ` being an isomorphism), hence `H^b(E) = 0`
  have hsubA_b : Subsingleton ↥(Work.Cohomology.singularCohomology ℚ b
      (TopCat.of (Work.StemsB.Rat.wangA b p))) :=
    Work.Stems.subsingleton_of_iso (Work.StemsB.Rat.wangGammaExplicit b p hT_O b) hfib_b
  have hsubA_m : Subsingleton ↥(Work.Cohomology.singularCohomology ℚ ((b - 1) + 1)
      (TopCat.of (Work.StemsB.Rat.wangA b p))) :=
    Work.Stems.subsingleton_of_iso
      (Work.Stems.transIso (↥(Work.StemsB.Rat.wangA b p)) (by omega)) hsubA_b
  have hsubEm : Subsingleton ↥(Work.Cohomology.singularCohomology ℚ ((b - 1) + 1)
      (TopCat.of E)) :=
    ⟨fun y1 y2 => by
      have h1 : (ModuleCat.Hom.hom restr) y1 = 0 := hsubA_m.allEq _ _
      have h2 : (ModuleCat.Hom.hom restr) y2 = 0 := hsubA_m.allEq _ _
      have hy : (ModuleCat.Hom.hom restr) (y1 - y2) = 0 := by rw [map_sub, h1, h2, sub_zero]
      have hmem : y1 - y2 ∈ (ModuleCat.Hom.hom restr).ker := LinearMap.mem_ker.mpr hy
      rw [hker2] at hmem
      exact sub_eq_zero.mp (by simpa using hmem)⟩
  exact Work.Stems.subsingleton_of_iso
    (Work.Stems.transIso E (show b = (b - 1) + 1 by omega)) hsubEm

end

end Work.Stems
