import Mathlib
import Submission.Work.Stems.RankOneClauses
import Submission.Work.Stems.homotopyFibre_conn
import Submission.Work.Stems.RankOne.exists_sphMap_piMapN_injective
import Submission.Work.Stems.RankOne.torsion_pi_fibre_pred
import Submission.Work.Stems.RankOne.sphere_pi_generator
import Submission.Work.Stems.RankOne.subsingleton_pi_fibre_self_of_subsingleton
import Submission.Work.Stems.RankOne.cofinality_rankOne

/-!
# The bottom cell of a rank-one space: the fibre clauses

Given a space `X` whose homotopy groups vanish in degrees `≤ N` except in degree `n` (`n ≥ 3`),
where `H_n(X;ℚ) ≅ ℚ`, we produce a based map `f : Sⁿ → X` (the "bottom cell") whose homotopy fibre
`F` is `(n-2)`-connected, has torsion `π_{n-1}` and trivial `π_n`.  This is the reduction that the
odd step of the rank-one Eilenberg--MacLane computation consumes
(`Submission/Work/Stems/rankOne_oddStep.lean`).

The three clauses come from the long exact sequence of the fibration `F → Sⁿ → X`
(`Work.RatHurewicz.pair_les`), with the bottom cell `f` supplied by
`Work.Stems.RankOne.exists_sphMap_piMapN_injective` (the map is injective on `πₙ`), the top
clause `πₙ(F) = 0` by `Work.Stems.RankOne.subsingleton_pi_fibre_self_of_subsingleton`, and the
rank-one input `π_{n-1}(F)` torsion by `Work.Stems.RankOne.cofinality_rankOne` together with
`Work.Stems.RankOne.torsion_pi_fibre_pred`.
-/

open CategoryTheory CategoryTheory.Limits
open scoped Topology Topology.Homotopy unitInterval

namespace Work.Stems

noncomputable section

theorem rankOne_bottomCell {n N : ℕ} (hn : 3 ≤ n) (hN : n + 1 ≤ N) [Nonempty (Fin (n - 1))] [Nonempty (Fin n)]
    {X : Type} [TopologicalSpace X] (x₀ : X)
    (hvan : ∀ j : ℕ, j ≤ N → j ≠ n → Subsingleton (HomotopyGroup (Fin j) X x₀))
    (hH : Nonempty (Work.Serre.ratH (TopCat.of X) n ≅ ModuleCat.of ℚ ℚ)) :
    ∃ (s₀ : Work.Serre.Sph n) (f : C(Work.Serre.Sph n, X)),
      (∀ j : ℕ, j ≤ n - 2 → Subsingleton (HomotopyGroup (Fin j)
        (Work.RatHurewicz.homotopyFibre f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) ∧
      (∀ α : HomotopyGroup (Fin (n - 1)) (Work.RatHurewicz.homotopyFibre f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀), ∃ m : ℕ, 0 < m ∧ α ^ m = 1) ∧
      Subsingleton (HomotopyGroup (Fin n) (Work.RatHurewicz.homotopyFibre f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀)) := by
  -- work in the successor degree `n = m + 1`
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, (Nat.sub_add_cancel (by omega)).symm⟩
  have hm : 2 ≤ m := by omega
  haveI hfinm : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩
  -- the bottom cell: a based map `S^{m+1} → X` injective on `π_{m+1}`
  obtain ⟨s₀, f, hfs, hinjN⟩ :=
    RankOne.exists_sphMap_piMapN_injective (X := X) x₀ (n := m + 1) (N := N)
      (by omega) (by omega) hvan hH
  -- `piMapN`-injectivity is `πmap`-injectivity
  have hinjπ : Function.Injective (Work.StemsB.πmap f m s₀) := by
    rw [← Work.Serre.piMapN_eq_pimap f m s₀]
    exact hinjN
  -- the vanishing of the homotopy groups of `X`, transported to the base point `f s₀`
  have hvanle : ∀ j : ℕ, j ≤ N → j ≠ m + 1 → Subsingleton (HomotopyGroup (Fin j) X (f s₀)) := by
    intro j hjN hj
    have hpath : Path x₀ (f s₀) :=
      { toFun := fun _ => x₀
        continuous_toFun := continuous_const
        source' := rfl
        target' := hfs.symm }
    exact subsingleton_homotopyGroup_change_basepoint hpath (hvan j hjN hj)
  have hconn' : ∀ i : ℕ, i < m + 1 → Subsingleton (HomotopyGroup (Fin i) X (f s₀)) :=
    fun i hi => hvanle i (by omega) (by omega)
  -- a generator of `π_{m+1}(S^{m+1})`
  obtain ⟨γ₀, hgeninf, _hγ₀gen⟩ := RankOne.sphere_pi_generator (m + 1) (by omega) s₀
  let α : HomotopyGroup (Fin (m + 1)) X (f s₀) := Work.StemsB.πmap f m s₀ γ₀
  have hαmem : ∃ g : HomotopyGroup (Fin (m + 1)) (Work.Serre.Sph (m + 1)) s₀,
      Work.StemsB.πmap f m s₀ g = α := ⟨γ₀, rfl⟩
  have hainf : ∀ t : ℕ, 0 < t → α ^ t ≠ 1 := by
    intro t ht h1
    have h2 : γ₀ ^ t = 1 := hinjπ (by rw [map_pow, h1, map_one])
    exact hgeninf t ht h2
  -- the rank-one input: the subgroup generated by `α` is cofinite
  have hcof : ∀ γ : HomotopyGroup (Fin (m + 1)) X (f s₀),
      ∃ t : ℕ, 0 < t ∧ ∃ k : ℤ, γ ^ t = α ^ k :=
    RankOne.cofinality_rankOne (X := X) (x₀ := f s₀) (by omega) hconn' hH hainf
  refine ⟨s₀, f, ?_, ?_, ?_⟩
  · -- `F` is `(n-2)`-connected
    intro j hj
    refine subsingleton_homotopyFibre_of_inj_surj f (m - 1) (by omega) s₀ ?_ ?_ j (by omega)
    · intro i hi
      haveI : Subsingleton (HomotopyGroup (Fin i) (Work.Serre.Sph (m + 1)) s₀) :=
        sphereConnectivity (m + 1) i (by omega) s₀
      exact fun a b _ => Subsingleton.elim a b
    · intro i hi
      haveI : Subsingleton (HomotopyGroup (Fin i) X (f s₀)) := hvanle i (by omega) (by omega)
      exact fun y => ⟨Classical.arbitrary _, Subsingleton.elim _ _⟩
  · -- `π_{n-1}(F)` is torsion
    exact RankOne.torsion_pi_fibre_pred hm s₀ f α hαmem hcof
  · -- `π_n(F)` is trivial
    exact RankOne.subsingleton_pi_fibre_self_of_subsingleton hm s₀ f
      (hvanle (m + 2) (by omega) (by omega)) hinjπ

end

end Work.Stems
