import Mathlib
import Submission.Work.RatHurewicz.pair_les
import Submission.Work.Stems.homotopyFibre_conn
import Submission.Work.Stems.RankOne.exists_sphMap_piMapN_injective

/-!
# The fibre of a rank-one approximation is torsion

Let `f : S^{m+1} → X` (`m ≥ 2`), `s₀ ∈ S^{m+1}`, and let `α ∈ π_{m+1}(X, f s₀)` be in the image of
`πmap f m s₀ : π_{m+1}(S^{m+1}) → π_{m+1}(X)`.  Suppose moreover that the subgroup generated by `α`
is *cofinal* in `π_{m+1}(X)` in the weak sense that every `γ` has a positive power `γ ^ t` lying in
`⟨α⟩`.  Then `π_m` of the homotopy fibre `F` of `f` is a torsion group.

This is the group-theoretic content of the rank-one reduction: the long exact sequence of the
fibration `F → S^{m+1} --f--> X`, in the form `Work.RatHurewicz.pair_les`, presents `π_m(F)` as the
cokernel of `π_{m+1}(S^{m+1}) → π_{m+1}(X)` (the connecting map `d` is surjective because its target
`π_m(S^{m+1})` vanishes: `m < m + 1`).  Since `α` lies in the image of `πmap f m s₀`, this cokernel
is a quotient of `π_{m+1}(X)/⟨α⟩`, which is torsion by the cofinality hypothesis.
-/

namespace Work.Stems.RankOne

open scoped Topology Topology.Homotopy unitInterval

theorem torsion_pi_fibre_pred {m : ℕ} [Nonempty (Fin m)] [Nonempty (Fin (m + 1))] (hm : 2 ≤ m)
    {X : Type} [TopologicalSpace X] (s₀ : Work.Serre.Sph (m + 1)) (f : C(Work.Serre.Sph (m + 1), X))
    (α : HomotopyGroup (Fin (m + 1)) X (f s₀))
    (hα : ∃ g : HomotopyGroup (Fin (m + 1)) (Work.Serre.Sph (m + 1)) s₀,
        Work.StemsB.πmap f m s₀ g = α)
    (hcof : ∀ γ : HomotopyGroup (Fin (m + 1)) X (f s₀), ∃ t : ℕ, 0 < t ∧ ∃ k : ℤ, γ ^ t = α ^ k) :
    ∀ β : HomotopyGroup (Fin m) (Work.RatHurewicz.homotopyFibre f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀),
      ∃ t : ℕ, 0 < t ∧ β ^ t = 1 := by
  -- put `m` in successor form so that the long exact sequence computes definitionally
  obtain ⟨p, rfl⟩ : ∃ p, m = p + 2 := ⟨m - 2, by omega⟩
  obtain ⟨g, hg⟩ := hα
  -- the long exact sequence of the fibration `F → S^{m+1} → X` at `π_{m+1}(X)` and `π_m(F)`
  obtain ⟨del, d, _h1, _h2, h3, h4⟩ := Work.RatHurewicz.pair_les f s₀ (p + 1) (by omega)
  -- `π_m(S^{m+1}) = 0`
  have hsub : Subsingleton (HomotopyGroup (Fin (p + 2)) (Work.Serre.Sph (p + 2 + 1))
      ((Work.RatHurewicz.homotopyFibreFst f s₀)
        (Work.RatHurewicz.homotopyFibreBasepoint f s₀))) :=
    Work.Stems.sphereConnectivity (p + 3) (p + 2) (by omega) _
  -- hence the connecting map `d : π_{m+1}(X) → π_m(F)` is surjective
  have hsurj : Function.Surjective d := fun y => (h4 y).mp (hsub.allEq _ _)
  -- and `d` kills the subgroup generated by `α`, because `α` is in the image of `πmap f`
  have hdα : d α = 1 := (h3 α).mpr ⟨g, hg⟩
  intro β
  obtain ⟨a, ha⟩ := hsurj β
  obtain ⟨t, ht, k, hk⟩ := hcof a
  refine ⟨t, ht, ?_⟩
  rw [← ha, ← map_pow, hk, map_zpow, hdα, one_zpow]

end Work.Stems.RankOne
