import Mathlib
import Submission.Work.Kunneth.cp2cp2H8
import Submission.Work.Kunneth.kronH_unconditional
import Submission.Work.Kunneth.cp2cp2ModelCpp

/-!
# The fundamental classes of `ℂP² × ℂP²` generate `H₈`

The isomorphism `H₈(ℂP² × ℂP²;ℤ) ≅ ℤ` is `Work.Kunneth.cp2cp2HomIso_Z` / `cp2cp2HomIso_cpp`
(`cp2cp2H8.lean`).  This module records the generation statements for the two fundamental classes
used by the applications:

* `Work.Kunneth.cpFund` — the homology cross product `[ℂP²] × [ℂP²]` of `cp2cp2Fund.lean`;
* `Work.Kunneth.cppC` — its transport to the space `ℂP² × ℂP²`, i.e. the field `c` of the GEN
  interface `Work.Kunneth.cp2cp2ModelCpp`.

The argument is a two-line linear-algebra fact, used in the form
`Work.Kunneth.span_singleton_eq_top_of_detected`: a class detected by a linear functional `β` with
`β c = 1` in a `ℤ`-module with a generator `c₀` is itself a generator.  Here `β` is the Kronecker
pairing `c ↦ ⟨a² ⌣ b², c⟩`, whose value on the fundamental class is `1` (`cpa2_cpb2_pairing`,
`cppInt_a2b2`), and the generator `c₀` is supplied by the isomorphism with `ℤ`
(`Work.Projective.span_singleton_eq_top_of_iso`).

**Conventions.**  This module does *not* remove the generic `AddCommGroup.toIntModule` instance:
the statements are about `Submodule.span ℤ {c}` with the canonical scalars of the workspace, the
form in which the consumers `Work.Gen.cp2cp2NumbersOf` / `Work.Gen.Generators8Of` (and
`Work.Projective.CP2CP2Model`) state them.

## Main results

* `Work.Kunneth.span_singleton_eq_top_of_detected`
* `Work.Kunneth.cpFund_span : Submodule.span ℤ {cpFund} = ⊤`
* `Work.Kunneth.cppC_span : Submodule.span ℤ {cppC} = ⊤`
* `Work.Kunneth.cppC_generates : Submodule.span ℤ {cp2cp2ModelCpp.c} = ⊤`
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000
set_option linter.unusedSimpArgs false

open CategoryTheory CategoryTheory.Limits HomologicalComplex
open scoped MonoidalCategory TensorProduct BigOperators Simplicial

namespace Work.Kunneth

noncomputable section

open Work.Cohomology

/-- **A detected generator is a generator.**  If a `ℤ`-module `M` is generated by one element `c₀`
and `β : M →ₗ[ℤ] ℤ` satisfies `β c = 1`, then `M = ℤ c`.

(No torsion-freeness is needed: `c = m • c₀` for some `m`, so `m · β c₀ = 1` exhibits `β c₀` as a
two-sided inverse of `m`, and `c₀ = (β c₀) • c`.) -/
theorem span_singleton_eq_top_of_detected {M : ModuleCat ℤ}
    {c₀ c : ↥M} (hc₀ : Submodule.span ℤ {c₀} = ⊤) (β : ↥M →ₗ[ℤ] ℤ) (hβ : β c = 1) :
    Submodule.span ℤ {c} = ⊤ := by
  have hc : c ∈ Submodule.span ℤ {c₀} := hc₀ ▸ Submodule.mem_top
  obtain ⟨m₀, hm₀⟩ := Submodule.mem_span_singleton.mp hc
  -- convert the module scalar multiplication into the standard `ℤ`-scalar multiplication
  have hm : m₀ • c₀ = c :=
    (int_smul_eq_zsmul (inferInstance : Module ℤ ↥M) m₀ c₀).symm.trans hm₀
  have hmul : m₀ * β c₀ = 1 := by
    have h1 : β (m₀ • c₀) = m₀ * β c₀ := by
      simpa using (map_zsmul β m₀ c₀ : β (m₀ • c₀) = m₀ • β c₀)
    rw [hm, hβ] at h1
    exact h1.symm
  have hmul' : β c₀ * m₀ = 1 := by rw [mul_comm]; exact hmul
  have hgen : β c₀ • c = c₀ := by
    rw [← hm, smul_smul, hmul', one_smul]
  refine Submodule.eq_top_iff'.mpr (fun y => ?_)
  have hy : y ∈ Submodule.span ℤ {c₀} := hc₀ ▸ Submodule.mem_top
  obtain ⟨k₀, hk₀⟩ := Submodule.mem_span_singleton.mp hy
  have hk : k₀ • c₀ = y :=
    (int_smul_eq_zsmul (inferInstance : Module ℤ ↥M) k₀ c₀).symm.trans hk₀
  refine Submodule.mem_span_singleton.mpr ⟨k₀ * β c₀, ?_⟩
  refine (int_smul_eq_zsmul (inferInstance : Module ℤ ↥M) (k₀ * β c₀) c).trans ?_
  rw [← smul_smul, hgen]
  exact hk

/-- The Kronecker functional `c ↦ ⟨a² ⌣ b², c⟩` on `H₈(ℂP² × ℂP²;ℤ)`. -/
noncomputable def cpBeta : ↥((sChain cpZ).homology 8) →ₗ[ℤ] ℤ :=
  (kronH ℤ cpZ 8) (cupH' ℤ cpZ 4 4 cpa2 cpb2)

/-- **The detecting computation** `⟨a² ⌣ b², [ℂP²] × [ℂP²]⟩ = 1`. -/
theorem cpBeta_cpFund : cpBeta cpFund = 1 := cpa2_cpb2_pairing

/-- **The fundamental class `[ℂP²] × [ℂP²]` generates `H₈(ℂP² × ℂP²;ℤ)`.** -/
theorem cpFund_span : Submodule.span ℤ {cpFund} = ⊤ := by
  obtain ⟨e⟩ := cp2cp2HomIso_Z
  exact span_singleton_eq_top_of_detected (Work.Projective.span_singleton_eq_top_of_iso e)
    cpBeta cpBeta_cpFund

/-- The Kronecker functional `c ↦ ⟨a² ⌣ b², c⟩` on `H₈(ℂP² × ℂP²;ℤ)`, for the space
`ℂP² × ℂP²`. -/
noncomputable def cppBeta : ↥((sChain cppSSet).homology 8) →ₗ[ℤ] ℤ :=
  (kronH ℤ cppSSet 8) (cupH' ℤ cppSSet 4 4 (Work.Projective.kSq cppSSet cppA)
    (Work.Projective.kSq cppSSet cppB))

/-- **The transported fundamental class `cppC` generates `H₈(ℂP² × ℂP²;ℤ)`.** -/
theorem cppC_span : Submodule.span ℤ {cppC} = ⊤ := by
  obtain ⟨e⟩ := cp2cp2HomIso_cpp
  refine span_singleton_eq_top_of_detected (Work.Projective.span_singleton_eq_top_of_iso e)
    cppBeta ?_
  show Work.SignatureBordism.interForm ℤ cppSSet 4 4 cppC
    (Work.Projective.kSq cppSSet cppA) (Work.Projective.kSq cppSSet cppB) = 1
  exact cppInt_a2b2

/-- **The field `cp2cp2ModelCpp.c` of the GEN interface generates `H₈(ℂP² × ℂP²;ℤ)`** — the extra
input `Work.Gen.cp2cp2NumbersOf` / `Work.Gen.Generators8Of` ask for alongside the model. -/
theorem cppC_generates : Submodule.span ℤ {cp2cp2ModelCpp.c} = ⊤ := cppC_span

end

end Work.Kunneth
