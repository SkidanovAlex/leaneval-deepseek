import Mathlib
import Submission.Work.Cohomology.SingBridge
import Submission.Work.SSS.Statements
import Submission.Work.StemsB.SerreFiltration

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The Serre filtration as a `Work.SSS.Filtration`

This file builds the filtration `ξ` of the singular chain complex `C_*(E)` of a map `p : E → B`
whose `s`-th term is the singular chain complex of the preimage under `Sing p` of the
`(s+1)`-skeleton of `Sing B`.  (The shift by one absorbs Mathlib's convention
`X.skeleton n` = "generated by the simplices of dimension `< n`".)  This is the filtration
underlying the Serre spectral sequence; it is saturated because every `n`-simplex lies in the
`(n+1)`-skeleton.
-/

set_option autoImplicit false

open CategoryTheory CategoryTheory.Limits Simplicial
open scoped Topology

namespace Work.SSS

noncomputable section

/-- The singular simplicial set of `E`. -/
abbrev sE (E : Type) [TopologicalSpace E] : SSet := TopCat.toSSet.obj (TopCat.of E)

/-- The map of singular simplicial sets induced by a continuous map. -/
def sSingMap {E B : Type} [TopologicalSpace E] [TopologicalSpace B] (p : C(E, B)) :
    sE E ⟶ sE B :=
  TopCat.toSSet.map (TopCat.ofHom p)

/-- The singular chain complex of a simplicial set, with `ℤ` coefficients. -/
abbrev sChain (X : SSet) : ChainComplex (ModuleCat ℤ) ℕ :=
  ((SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)).obj X



/-- The first (`0`-th) vertex of a singular `s`-simplex of `B`. -/
def simplexVertex {B : Type} [TopologicalSpace B] (s : ℕ) (x : (sE B) _⦋s⦌) : B :=
  (TopCat.toSSetObjEquivT (TopCat.of B) (Opposite.op ⦋s⦌) x)
    ⟨Pi.single 0 1, single_mem_stdSimplex ℝ 0⟩

/-- Singular homology of `X` with coefficients in a `ℤ`-module `M` (trivial local coefficients). -/
abbrev HZCoeff (X : Type) [TopologicalSpace X] (M : ModuleCat ℤ) (i : ℕ) : ModuleCat ℤ :=
  (((AlgebraicTopology.singularChainComplexFunctor (ModuleCat ℤ)).obj M).obj
    (TopCat.of X)).homology i

/-- Singular homology with integral coefficients in `HZCoeff` notation. -/
theorem HZCoeff_int (X : Type) [TopologicalSpace X] (i : ℕ) :
    HZCoeff X (ModuleCat.of ℤ ℤ) i = Work.PiS.HZ X i := rfl


/-! ## Homology with coefficients: functoriality in the coefficient module -/

/-- The map on homology with coefficients induced by a map of coefficient modules. -/
def HZCoeffMap {X : Type} [TopologicalSpace X] {M N : ModuleCat ℤ} (f : M ⟶ N) (i : ℕ) :
    HZCoeff X M i ⟶ HZCoeff X N i :=
  HomologicalComplex.homologyMap
    (((AlgebraicTopology.singularChainComplexFunctor (ModuleCat ℤ)).map f).app (TopCat.of X)) i

@[simp] theorem HZCoeffMap_id {X : Type} [TopologicalSpace X] (M : ModuleCat ℤ) (i : ℕ) :
    HZCoeffMap (X := X) (𝟙 M) i = 𝟙 (HZCoeff X M i) := by
  simp [HZCoeffMap]

theorem HZCoeffMap_comp {X : Type} [TopologicalSpace X] {M N P : ModuleCat ℤ}
    (f : M ⟶ N) (g : N ⟶ P) (i : ℕ) :
    HZCoeffMap (X := X) (f ≫ g) i = HZCoeffMap (X := X) f i ≫ HZCoeffMap (X := X) g i := by
  have h1 : ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat ℤ)).map (f ≫ g)).app
        (TopCat.of X) =
      ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat ℤ)).map f).app (TopCat.of X) ≫
        ((AlgebraicTopology.singularChainComplexFunctor (ModuleCat ℤ)).map g).app (TopCat.of X) := by
    rw [Functor.map_comp, NatTrans.comp_app]
  unfold HZCoeffMap
  rw [h1, HomologicalComplex.homologyMap_comp]

/-- A surjection of `ℤ`-modules pushes forward finite generation. -/
theorem finite_of_surj {M N : ModuleCat ℤ} (f : M ⟶ N) (hf : Function.Surjective f.hom)
    (hM : Module.Finite ℤ M) : Module.Finite ℤ N :=
  Module.Finite.of_surjective f.hom hf

/-- Finiteness transfers across an isomorphism in `ModuleCat ℤ`. -/
theorem finite_of_iso {M N : ModuleCat ℤ} (e : M ≅ N) (h : Module.Finite ℤ M) :
    Module.Finite ℤ N :=
  Module.Finite.of_surjective (ModuleCat.Hom.hom e.hom)
    ((ModuleCat.epi_iff_surjective e.hom).mp inferInstance)

/-- The `s`-th term of the (shifted) Serre filtration: the preimage of the `(s+1)`-skeleton. -/
abbrev serreSub {X Y : SSet} (f : X ⟶ Y) (s : ℕ) : X.Subcomplex :=
  Work.StemsB.serreSubcomplex f (s + 1)

/-- The (shifted) Serre filtration of a simplicial set along a morphism `f`: the `s`-th term is
the preimage of the `(s+1)`-skeleton. -/
abbrev serreFiltShift {X Y : SSet} (f : X ⟶ Y) : ℕ ⥤ SSet where
  obj s := (serreSub f s).toSSet
  map {s t} h := (serreSub f s).homOfLE (Work.StemsB.serreSubcomplex_mono f
    (Nat.succ_le_succ (leOfHom h)))
  map_id P := SSet.Subcomplex.homOfLE_refl _
  map_comp h₁ h₂ := by rw [SSet.Subcomplex.homOfLE_comp]

variable {X Y : SSet} {g : X ⟶ Y}

/-- The degreewise component of the chain map induced by a degreewise injective morphism of
simplicial sets is a monomorphism. -/
theorem mono_chainComplexMap_f (n : ℕ)
    (hg : Function.Injective (g.app (Opposite.op (SimplexCategory.mk n)))) :
    Mono ((SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n) := by
  classical
  have hsplit : ∃ s : (Y.chainComplex (ModuleCat.of ℤ ℤ)).X n ⟶
      (X.chainComplex (ModuleCat.of ℤ ℤ)).X n,
      (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n ≫ s = 𝟙 _ := by
    let s : (Y.chainComplex (ModuleCat.of ℤ ℤ)).X n ⟶ (X.chainComplex (ModuleCat.of ℤ ℤ)).X n :=
      Cofan.IsColimit.desc (Y.isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n)
        (fun y => if h : ∃ x : X _⦋n⦌, g.app (Opposite.op (SimplexCategory.mk n)) x = y
          then X.ιChainComplex (Classical.choose h) else 0)
    refine ⟨s, ?_⟩
    apply X.chainComplex_hom_ext
    intro x
    have hassoc : X.ιChainComplex x ≫ (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n ≫ s =
        (X.ιChainComplex x ≫ (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n) ≫ s :=
      (Category.assoc _ _ _).symm
    rw [hassoc, SSet.ι_chainComplexMap_f]
    have hfac : Y.ιChainComplex (g.app (Opposite.op (SimplexCategory.mk n)) x) ≫ s =
        (if h : ∃ x' : X _⦋n⦌, g.app (Opposite.op (SimplexCategory.mk n)) x' =
            g.app (Opposite.op (SimplexCategory.mk n)) x
          then X.ιChainComplex (Classical.choose h) else 0) :=
      Cofan.IsColimit.fac (Y.isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n) _ _
    rw [hfac, dif_pos ⟨x, rfl⟩]
    congr 1
    exact (hg) (Classical.choose_spec (show ∃ x' : X _⦋n⦌,
      g.app (Opposite.op (SimplexCategory.mk n)) x' = g.app (Opposite.op (SimplexCategory.mk n)) x
        from ⟨x, rfl⟩))
  obtain ⟨s, hs⟩ := hsplit
  haveI : IsSplitMono ((SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n) := ⟨s, hs⟩
  exact inferInstance

/-- The degreewise component of the chain map induced by a degreewise surjective morphism of
simplicial sets is an epimorphism. -/
theorem epi_chainComplexMap_f (n : ℕ)
    (hg : Function.Surjective (g.app (Opposite.op (SimplexCategory.mk n)))) :
    Epi ((SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n) := by
  classical
  have hsplit : ∃ s : (Y.chainComplex (ModuleCat.of ℤ ℤ)).X n ⟶
      (X.chainComplex (ModuleCat.of ℤ ℤ)).X n,
      s ≫ (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n = 𝟙 _ := by
    let s : (Y.chainComplex (ModuleCat.of ℤ ℤ)).X n ⟶
        (X.chainComplex (ModuleCat.of ℤ ℤ)).X n :=
      Cofan.IsColimit.desc (Y.isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n)
        (fun y => X.ιChainComplex (Classical.choose (hg y)))
    refine ⟨s, ?_⟩
    apply Y.chainComplex_hom_ext
    intro y
    have hassoc : Y.ιChainComplex y ≫ s ≫ (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n =
        (Y.ιChainComplex y ≫ s) ≫ (SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n :=
      (Category.assoc _ _ _).symm
    rw [hassoc]
    have hfac : Y.ιChainComplex y ≫ s = X.ιChainComplex (Classical.choose (hg y)) :=
      Cofan.IsColimit.fac (Y.isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n) _ _
    rw [hfac, SSet.ι_chainComplexMap_f, Category.comp_id]
    exact congrArg Y.ιChainComplex (Classical.choose_spec (hg y))
  obtain ⟨s, hs⟩ := hsplit
  haveI : IsSplitEpi ((SSet.chainComplexMap g (ModuleCat.of ℤ ℤ)).f n) := ⟨s, hs⟩
  exact inferInstance

/-- The chain map induced by a degreewise injective morphism of simplicial sets is a
monomorphism. -/
theorem mono_chainMap_of_injective
    (hf : ∀ n, Function.Injective (g.app (Opposite.op (SimplexCategory.mk n)))) :
    Mono (((SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)).map g) := by
  apply HomologicalComplex.mono_of_mono_f
  intro n
  exact mono_chainComplexMap_f n (hf n)

/-- The Serre filtration of the singular chain complex of `E` along `p : E → B`, as a functor
`ℕ ⥤ ChainComplex (ModuleCat ℤ) ℕ`. -/
abbrev serreChainFilt {E B : Type} [TopologicalSpace E] [TopologicalSpace B] (p : C(E, B)) :
    ℕ ⥤ ChainComplex (ModuleCat ℤ) ℕ :=
  serreFiltShift (sSingMap p) ⋙ (SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)

/-- **The Serre filtration of `C_*(E)` along a continuous map `p : E → B`**, as an element of
`Work.SSS.Filtration`: the `s`-th term is the singular chain complex of the preimage under `Sing p`
of the `(s+1)`-skeleton of `Sing B`. -/
def serreFiltrationOf {E B : Type} [TopologicalSpace E] [TopologicalSpace B] (p : C(E, B)) :
    Filtration (Work.Cohomology.singularChains ℤ (TopCat.of E)) where
  F := serreChainFilt p
  mono s := mono_chainMap_of_injective (fun n => (mono_iff_injective _).mp inferInstance)
  incl s := ((SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)).map
    ((serreSub (sSingMap p) s).ι)
  mono_incl s := mono_chainMap_of_injective (fun n => (mono_iff_injective _).mp inferInstance)
  compat {s t} h := by
    have hle : serreSub (sSingMap p) s ≤ serreSub (sSingMap p) t :=
      Work.StemsB.serreSubcomplex_mono (sSingMap p) (Nat.succ_le_succ h)
    have hmap : (serreChainFilt p).map (homOfLE h) =
        ((SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)).map
          ((serreSub (sSingMap p) s).homOfLE hle) := rfl
    rw [hmap]
    erw [← Functor.map_comp, SSet.Subcomplex.homOfLE_ι]
  sat n := by
    let inc : (serreChainFilt p).obj n ⟶
        Work.Cohomology.singularChains ℤ (TopCat.of E) :=
      ((SSet.chainComplexFunctor (ModuleCat ℤ)).obj (ModuleCat.of ℤ ℤ)).map
        ((serreSub (sSingMap p) n).ι)
    change IsIso (inc.f n)
    haveI hmono : Mono (inc.f n) :=
      mono_chainComplexMap_f (g := (serreSub (sSingMap p) n).ι) n
        ((mono_iff_injective _).mp inferInstance)
    haveI hepi : Epi (inc.f n) :=
      epi_chainComplexMap_f (g := (serreSub (sSingMap p) n).ι) n (by
        intro x
        refine ⟨⟨x, ?_⟩, rfl⟩
        rw [Work.StemsB.mem_serreSubcomplex]
        exact SSet.mem_skeleton _ _ (by omega))
    exact isIso_of_mono_of_epi _

end

end Work.SSS
