import Mathlib
import Submission.Work.SSS.FibreColDefs
import Submission.Work.SSS.FirstPageCF.Zsq_quot_injects_E2
import Submission.Work.SSS.Transgression.vzQuotSurj
import Submission.Work.SSS.E2Zero.E2_zero_iso
import Submission.Work.SSS.PhiTop.Phi_iso
import Submission.Work.SSS.ModelQuot.Zs_quot_finite_of_Zsq_quot_finite
import Submission.Work.SSS.ChainExt.zof_quot_finite_of_chain

/-!
# The left-column edge statement for the Serre spectral sequence (area SSS), cycle-free

`Work.SSS.fibreColFree`: the `E²` term `E²_{0,t}` in the left column of the spectral sequence of a
saturated filtration is finitely generated as soon as `Φ_t(0) = im(H_t(F_0) → H_t(C))` is and the
`E²` terms of the next diagonal `E²_{r,t+1-r}` (`2 ≤ r ≤ t+1`) are.

This is the same statement as `Work.SSS.fibreCol`, but its proof avoids
`Submission.Work.SSS.packetOfFiltration` (which imports `Work.SSS.fibreCol` and hence cannot be
imported back).  The only use of `packetOfFiltration` in the proof of `fibreCol` was
`Work.SSS.E1Complex_d` inside the first-page computation
`Work.SSS.FirstPage.Zsq_quot_injects_E2`; the whole chain of `FirstPage` files is therefore copied
to `Submission/Work/SSS/FirstPageCF/` (namespace `Work.SSS.FirstPageCF`), importing
`Submission.Work.SSS.LESFacts` and with `E1Complex_d` re-proved (it is `ChainComplex.of_d`).

The proof is the left-column edge argument, in the chain-level model of `FibreColDefs.lean`:

* `E²_{0,t} ≅ Z_t(F_0)/V_1` (`E2_zero_iso`) and `Φ_t(0) ≅ Z_t(F_0)/V_{t+1}` (`Phi_iso`), where
  `V_s = ∂(F_sC_{t+1}) ∩ Z_t(F_0)`;
* the transgression `d_s` displays `V_s/V_{s-1}` as a quotient of `Z^s_{s,t+1}/B^s_{s,t+1}`
  (`vzQuotSurj`), which is in turn a quotient of a subquotient of the model `Z²_{s,t+1}/B²_{s,t+1}`
  of `E²_{s,t+1-s}` (`Zs_quot_finite_of_Zsq_quot_finite`), so that `V_s/V_{s-1}` is finitely
  generated whenever `E²_{s,t+1-s}` is;
* the chain `V_1 ⊆ ⋯ ⊆ V_{t+1}` is an iterated extension (`zof_quot_finite_of_chain`).
-/

set_option autoImplicit false

attribute [-instance] AddCommGroup.toIntModule

namespace Work.SSS

open CategoryTheory CategoryTheory.Limits

noncomputable section

/-- Same statement as `Work.SSS.fibreCol`, but its proof must NOT transitively import
`Submission.Work.SSS.packetOfFiltration`, because that file has to import this one to assemble
`Work.SSS.packetOfFiltration` (any such import is a build cycle).  Note
`Submission.Work.SSS.fibreCol` is unusable from there: it imports
`Submission.Work.SSS.FirstPage.Zsq_quot_injects_E2`, which imports
`Submission.Work.SSS.FirstPage.ZsqElts`, which imports `Submission.Work.SSS.packetOfFiltration`
(for `Work.SSS.E1Complex_d`).  So copy that chain of `FirstPage` files into fresh cycle-free modules
(e.g. under `Submission/Work/SSS/FirstPageCF/` with a renamed namespace, importing
`Submission.Work.SSS.LESFacts` instead and re-proving `Work.SSS.E1Complex_d`,
which is exactly `ChainComplex.of_d`), and re-run the `fibreCol` proof against the copies. -/
theorem fibreColFree (C : ChainComplex (ModuleCat ℤ) ℕ) (ξ : Work.SSS.Filtration C) (t : ℕ)
    (hE : ∀ r : ℕ, 2 ≤ r → r ≤ t + 1 → Module.Finite ℤ (Work.SSS.E2 ξ r (t + 1 - r)))
    (hP : (Work.SSS.Phi ξ t 0).FG) :
    Module.Finite ℤ (Work.SSS.E2 ξ 0 t) := by
  -- `Φ_t(0) ≅ Z_t(F_0)/V_{t+1}` is the top of the extension chain
  have hTop : Module.Finite ℤ (↥(Zof ξ t) ⧸ VZ ξ t (t + 1)) := by
    haveI : Module.Finite ℤ ↥(Phi ξ t 0) := Module.Finite.iff_fg.mpr hP
    obtain ⟨e⟩ := PhiTop.Phi_iso ξ t
    exact Module.Finite.equiv e.symm
  -- each `V_s/V_{s-1}`, `2 ≤ s ≤ t + 1`, is finitely generated by the transgression and the
  -- first-page model of `E²_{s,t+1-s}`
  have hQ : ∀ s : ℕ, 2 ≤ s → s ≤ t + 1 → Module.Finite ℤ (↥(VZ ξ t s) ⧸ VZQ ξ t s) := by
    intro s hs hst
    have hS : Module.Finite ℤ (↥(Zsq ξ s (t + 1)) ⧸ BsqZ ξ s (t + 1)) := by
      obtain ⟨g, hg⟩ := FirstPageCF.Zsq_quot_injects_E2 ξ s (t + 1) hs hst
      haveI : Module.Finite ℤ (E2 ξ s (t + 1 - s)) := hE s hs hst
      exact Module.Finite.of_injective g hg
    haveI : Module.Finite ℤ (↥(Zs ξ s (t + 1)) ⧸ BsZ ξ s (t + 1)) :=
      ModelQuot.Zs_quot_finite_of_Zsq_quot_finite ξ s (t + 1) hs hS
    obtain ⟨f, hf⟩ := Transgression.vzQuotSurj ξ t s hs
    exact Module.Finite.of_surjective f hf
  -- the extension chain over `V_1 ⊆ ⋯ ⊆ V_{t+1} ⊆ Z_t(F_0)`
  haveI : Module.Finite ℤ (↥(Zof ξ t) ⧸ VZ ξ t 1) :=
    ChainExt.zof_quot_finite_of_chain ξ t hTop hQ
  -- transfer back along `E²_{0,t} ≅ Z_t(F_0)/V_1`
  obtain ⟨e⟩ := E2Zero.E2_zero_iso ξ t
  exact Module.Finite.equiv e

end

end Work.SSS
