import Mathlib
import Submission.Work.Cohomology.CupRing
import Submission.Work.SignatureBordism.Intersection
import Submission.Work.SignatureBordism.Rationalisation

/-!
# The Künneth ring of `ℂP² × ℂP²` in the cochain model of an `SSet`

The second generator of `Ω^SO_8 ⊗ ℚ` is `ℂP² × ℂP²`, with the numbers
`(σ, p₁², p₂) = (1, 18, 9)`.  Those numbers are computed in
`Submission/Work/Projective/Product.lean` in the *abstract* Künneth ring `CPRing 2 ⊗ CPRing 2`
(`Work.Projective.hirzebruchEight_cp2cp2`, `Work.Projective.cp2cp2Tuple_eq`).  What is missing there
— and what this module records as an interface — is the identification of that ring with the
cohomology of *an actual `SSet`*: the Künneth theorem for the cup product, which says that the
cohomology ring of a product is `H^*(ℂP²;ℤ) ⊗ H^*(ℂP²;ℤ) = ℤ[a, b]/(a³, b³)` with the
fundamental class normalised by `⟨a²b², [ℂP² × ℂP²]⟩ = 1`.

The structure `Work.Projective.CP2CP2Model X` is the data of that identification for an `SSet`
`X`: the two classes `a = π₁^*h`, `b = π₂^*h` in `H²`, the fundamental class `c ∈ H₈`, the
Pontryagin classes of the tangent bundle (the Whitney sums `p₁ = 3a² + 3b²`,
`p₂ = 9·a²b²`), the fact that the middle cohomology is `ℤ⟨a², ab, b²⟩`, and the intersection
numbers of that spanning set.

Its consequences are in `Submission/Work/Projective/CP2CP2.lean`
(`Work.Projective.CP2CP2Model.sigma`, `.p1SqNumber`, `.p2Number`, `.hirzebruchEight`, `.tuple`),
and — for the concrete manifold — the whole point is that `X` is the singular complex of the
topological space `ℂP² × ℂP²`, for which the Künneth identification is *not* available in this
workspace (there is no Künneth theorem for the cup product of a product of simplicial sets).
The interface is therefore stated, not inhabited; see `README.md`.

## Conventions

Degrees are those of `Work.Cohomology`: `a, b ∈ H²`, `a² = a ⌣ a`, `ab = a ⌣ b`,
`a²b² = a² ⌣ b² ∈ H⁸`.  The intersection numbers are those of
`Work.SignatureBordism.interForm ℤ X 4 4 c`, i.e. `⟨x ⌣ y, c⟩`; no commutativity of the cup
product is assumed, which is why `int_a2b2` and `int_b2a2` are both recorded.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

namespace Work.Projective

open CategoryTheory Limits Work.Cohomology Work.SignatureBordism

noncomputable section

/-! ## The monomials of the Künneth ring -/

/-- **`a²`**: the cup square of a degree-`2` class, in degree `4`. -/
def kSq (X : SSet) (a : (cochainC ℤ X).homology 2) : (cochainC ℤ X).homology 4 :=
  cupH' ℤ X 2 2 a a

/-- **`a · b`**: the cup product of two degree-`2` classes, in degree `4`. -/
def kMul (X : SSet) (a b : (cochainC ℤ X).homology 2) : (cochainC ℤ X).homology 4 :=
  cupH' ℤ X 2 2 a b

/-- **`x · y`**: the cup product of two degree-`4` classes, in degree `8`. -/
def kTop (X : SSet) (x y : (cochainC ℤ X).homology 4) : (cochainC ℤ X).homology 8 :=
  cupH' ℤ X 4 4 x y

/-! ## The diagonalising basis of the middle form -/

/-- **The three middle classes `a² + b²`, `a² − b²`, `ab`** of the Künneth ring of `ℂP² × ℂP²`,
rationalised: the orthogonal basis in which the middle intersection form is diagonal with values
`2, -2, 1`.

(Over `ℤ` the classes `a², b²` have square `0` and pair to `1` with each other — a hyperbolic
plane — while `ab` is orthogonal to both with square `1`.  The change of basis
`{a², b²} ↦ {a² + b², a² − b²}` inverts the factor `2`, which is why the rationalisation appears.) -/
def cp2cp2Vec (X : SSet) (a b : (cochainC ℤ X).homology 2) : Fin 3 → ratCohomology 4 X :=
  ![ (1 : ℚ) ⊗ₜ[ℤ] kSq X a + (1 : ℚ) ⊗ₜ[ℤ] kSq X b,
     (1 : ℚ) ⊗ₜ[ℤ] kSq X a - (1 : ℚ) ⊗ₜ[ℤ] kSq X b,
     (1 : ℚ) ⊗ₜ[ℤ] kMul X a b ]

/-- **The diagonal values `(2, -2, 1)`** of the middle intersection form of `ℂP² × ℂP²` in the
basis `a² + b², a² − b², ab`: `⟨(a²+b²)², c⟩ = 2`, `⟨(a²−b²)², c⟩ = -2`,
`⟨(ab)², c⟩ = 1`. -/
def cp2cp2Diag : Fin 3 → ℚ := ![2, -2, 1]

/-! ## The interface -/

/-- **The Künneth ring of `ℂP² × ℂP²` in the cochain model of an `SSet` `X`.**

The data: the two hyperplane classes `a, b ∈ H²(X;ℤ)` (the pullbacks of `h` along the two
projections), the fundamental class `c ∈ H₈(X;ℤ)`, the Pontryagin classes of the tangent bundle
`p₁ = 3a² + 3b² ∈ H⁴(X;ℤ)` and `p₂ = 9·a²b² ∈ H⁸(X;ℤ)`, the fact that the middle cohomology is
generated by `a², ab, b²`, and the intersection numbers of that spanning set.

The intersection-number fields are the content of Künneth together with Poincaré duality: they say
that `a², b²` span a hyperbolic plane (both have square `0` and pair to `1` with each other) while
`ab` is orthogonal to both with square `1`.  Both orders `⟨a², b²⟩` and `⟨b², a²⟩` are recorded
because no commutativity of the cup product is assumed. -/
structure CP2CP2Model (X : SSet) where
  /-- the first Künneth class `a = π₁^* h ∈ H²(ℂP² × ℂP²;ℤ)` -/
  a : (cochainC ℤ X).homology 2
  /-- the second Künneth class `b = π₂^* h ∈ H²(ℂP² × ℂP²;ℤ)` -/
  b : (cochainC ℤ X).homology 2
  /-- the fundamental class `c ∈ H₈(ℂP² × ℂP²;ℤ)` -/
  c : (chainC ℤ X).homology 8
  /-- the first Pontryagin class `p₁(T(ℂP² × ℂP²)) ∈ H⁴` -/
  p₁ : (cochainC ℤ X).homology 4
  /-- the second Pontryagin class `p₂(T(ℂP² × ℂP²)) ∈ H⁸` -/
  p₂ : (cochainC ℤ X).homology 8
  /-- `p₁ = 3a² + 3b²` (Whitney sum of the pullbacks of `p₁(TℂP²) = 3h²`) -/
  p₁_eq : p₁ = (3 : ℤ) • (kSq X a + kSq X b)
  /-- `p₂ = 9·a²b²` (the mixed term `p₁ ⊗ p₁` of the product formula) -/
  p₂_eq : p₂ = (9 : ℤ) • kTop X (kSq X a) (kSq X b)
  /-- `H⁴(ℂP² × ℂP²;ℤ) = ℤ⟨a², ab, b²⟩` -/
  span_middle : Submodule.span ℤ {kSq X a, kMul X a b, kSq X b} = ⊤
  /-- `⟨a² ⌣ a², c⟩ = 0` -/
  int_a2a2 : interForm ℤ X 4 4 c (kSq X a) (kSq X a) = 0
  /-- `⟨a² ⌣ b², c⟩ = 1` -/
  int_a2b2 : interForm ℤ X 4 4 c (kSq X a) (kSq X b) = 1
  /-- `⟨b² ⌣ a², c⟩ = 1` -/
  int_b2a2 : interForm ℤ X 4 4 c (kSq X b) (kSq X a) = 1
  /-- `⟨b² ⌣ b², c⟩ = 0` -/
  int_b2b2 : interForm ℤ X 4 4 c (kSq X b) (kSq X b) = 0
  /-- `⟨ab ⌣ ab, c⟩ = 1` -/
  int_abab : interForm ℤ X 4 4 c (kMul X a b) (kMul X a b) = 1
  /-- `⟨a² ⌣ ab, c⟩ = 0` -/
  int_a2ab : interForm ℤ X 4 4 c (kSq X a) (kMul X a b) = 0
  /-- `⟨ab ⌣ a², c⟩ = 0` -/
  int_aba2 : interForm ℤ X 4 4 c (kMul X a b) (kSq X a) = 0
  /-- `⟨b² ⌣ ab, c⟩ = 0` -/
  int_b2ab : interForm ℤ X 4 4 c (kSq X b) (kMul X a b) = 0
  /-- `⟨ab ⌣ b², c⟩ = 0` -/
  int_abb2 : interForm ℤ X 4 4 c (kMul X a b) (kSq X b) = 0

end

end Work.Projective
