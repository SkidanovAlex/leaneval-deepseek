def lastEnt : ℕ × ℕ := (30001, 29519910398000)

def C : List (ℕ × ℕ) := Plist ++ [lastEnt]

end Commons.NumberTheory.Chebyshev.ThetaFinite

namespace Commons.NumberTheory.Chebyshev.ThetaFinite

theorem chk_head : C.head? = some (2,0) := by decide
theorem chk_bound : ∀ e ∈ C, 1530 < e.1 → 9*10^8 * e.1 ≤ e.2 := by decide
theorem chk_prim : ∀ e ∈ C, e.1 = 30001 ∨ ip e.1 = true := by decide
theorem chk_chain : ∀ p ∈ C.zip C.tail, p.2.2 = p.1.2 + termOf p.1.1 := by decide
theorem chk_incr : incr (C.map Prod.fst) = true := by decide

def psum : List (ℕ × ℕ) → ℕ → ℕ
  | [], _ => 0
  | e :: rest, N => if e.1 ≤ N then termOf e.1 + psum rest N else 0

def bnd : List (ℕ × ℕ) → ℕ → Option (ℕ × ℕ)
  | [], _ => none
  | e :: rest, N => if e.1 ≤ N then bnd rest N else some e

def pfx : List (ℕ × ℕ) → ℕ → List (ℕ × ℕ)
  | [], _ => []
  | e :: rest, N => if e.1 ≤ N then e :: pfx rest N else []

lemma psum_eq_pfx : ∀ (C : List (ℕ × ℕ)) (N : ℕ),
    psum C N = ((pfx C N).map (fun e => termOf e.1)).sum := by
  intro C N
  induction C with
  | nil => rfl
  | cons e rest ih =>
    by_cases h : e.1 ≤ N
    · simp [psum, pfx, h, ih]
    · simp [psum, pfx, h, ih]

lemma pfx_mem : ∀ {C : List (ℕ × ℕ)} {N : ℕ} {e : ℕ × ℕ}, e ∈ pfx C N → e ∈ C := by
  intro C N e
  induction C with
  | nil => simp [pfx]
  | cons f rest ih =>
    intro hm
    by_cases h : f.1 ≤ N
    · simp only [pfx, if_pos h, List.mem_cons] at hm
      rcases hm with rfl | hm
      · exact List.mem_cons_self ..
      · exact List.mem_cons_of_mem f (ih hm)
    · simp only [pfx, if_neg h] at hm
      exact absurd hm (by simp)

lemma pfx_le : ∀ {C : List (ℕ × ℕ)} {N : ℕ} {e : ℕ × ℕ}, e ∈ pfx C N → e.1 ≤ N := by
  intro C N e
  induction C with
  | nil => simp [pfx]
  | cons f rest ih =>
    intro hm
    by_cases h : f.1 ≤ N
    · simp only [pfx, if_pos h, List.mem_cons] at hm
      rcases hm with rfl | hm
      · exact h
      · exact ih hm
    · simp only [pfx, if_neg h] at hm
      exact absurd hm (by simp)

lemma pfx_sublist : ∀ (C : List (ℕ × ℕ)) (N : ℕ), (pfx C N).Sublist C := by
  intro C N
  induction C with
  | nil => exact List.Sublist.slnil
  | cons e rest ih =>
    by_cases h : e.1 ≤ N
    · simp only [pfx, if_pos h]
      exact List.Sublist.cons_cons e ih
    · simp only [pfx, if_neg h]
      exact List.nil_sublist _

lemma bnd_some_mem : ∀ {C : List (ℕ × ℕ)} {N : ℕ} {e : ℕ × ℕ}, bnd C N = some e → e ∈ C := by
  intro C N e
  induction C with
  | nil => simp [bnd]
  | cons f rest ih =>
    intro h
    by_cases hle : f.1 ≤ N
    · simp only [bnd, if_pos hle] at h
      exact List.mem_cons_of_mem f (ih h)
    · simp only [bnd, if_neg hle, Option.some.injEq] at h
      rw [h]
      exact List.mem_cons_self ..

lemma bnd_some_gt : ∀ {C : List (ℕ × ℕ)} {N : ℕ} {e : ℕ × ℕ}, bnd C N = some e → N < e.1 := by
  intro C N e
  induction C with
  | nil => simp [bnd]
  | cons f rest ih =>
    intro h
    by_cases hle : f.1 ≤ N
    · simp only [bnd, if_pos hle] at h
      exact ih h
    · simp only [bnd, if_neg hle, Option.some.injEq] at h
      rw [← h]
      omega

lemma bnd_isSome_of_mem : ∀ {C : List (ℕ × ℕ)} {N : ℕ} {e : ℕ × ℕ},
    e ∈ C → N < e.1 → (bnd C N).isSome = true := by
  intro C N e
  induction C with
  | nil => intro he _; exact absurd he (by simp)
  | cons f rest ih =>
    intro he hN
    by_cases hle : f.1 ≤ N
    · rw [show bnd (f :: rest) N = bnd rest N from by simp [bnd, hle]]
      rcases List.mem_cons.mp he with rfl | hmem
      · omega
      · exact ih hmem hN
    · rw [show bnd (f :: rest) N = some f from by simp [bnd, hle]]
      rfl

lemma bnd_spec : ∀ (C : List (ℕ × ℕ)) (N : ℕ),
    (∀ e1 e2, (e1,e2) ∈ C.zip C.tail → e2.2 = e1.2 + termOf e1.1) →
    ∀ {b : ℕ × ℕ}, bnd C N = some b → b.2 = (C.head?.map Prod.snd).getD 0 + psum C N := by
  intro C N
  induction C with
  | nil => intro _ b hb; simp [bnd] at hb
  | cons e rest ih =>
    intro hchain b hb
    by_cases hle : e.1 ≤ N
    · have hb' : bnd rest N = some b := by simpa [bnd, hle] using hb
      have hchain' : ∀ e1 e2, (e1,e2) ∈ rest.zip rest.tail → e2.2 = e1.2 + termOf e1.1 := by
        intro e1 e2 hmem
        exact hchain e1 e2 (by
          cases rest with
          | nil => exact absurd hmem (by simp)
          | cons b' bs =>
            simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons]
            exact Or.inr (by simpa using hmem))
      have hb_spec := ih hchain' hb'
      have hhead : (rest.head?.map Prod.snd).getD 0 = e.2 + termOf e.1 := by
        cases rest with
        | nil => simp [bnd] at hb'
        | cons b' bs =>
          have hmem : (e, b') ∈ (e :: b' :: bs).zip (b' :: bs) := by
            rw [List.zip_cons_cons]; exact List.mem_cons_self ..
          have := hchain e b' hmem
          simpa using this
      rw [hhead] at hb_spec
      rw [show psum (e :: rest) N = termOf e.1 + psum rest N from by simp [psum, hle]]
      rw [show ((e :: rest).head?.map Prod.snd).getD 0 = e.2 from by simp]
      linarith
    · have hbe : b = e := by
        have h2 : some e = some b := by simpa [bnd, hle] using hb
        exact (Option.some.inj h2).symm
      rw [hbe]
      rw [show psum (e :: rest) N = 0 from by simp [psum, hle]]
      rw [show ((e :: rest).head?.map Prod.snd).getD 0 = e.2 from by simp]
      simp

lemma incr_pairwise : ∀ l : List ℕ, incr l = true → l.Pairwise (· < ·) := by
  intro l
  induction l with
  | nil => intro _; simp
  | cons a t ih =>
    cases t with
    | nil => intro _; simp
    | cons b bs =>
      intro h
      simp only [incr, Bool.and_eq_true, decide_eq_true_eq] at h
      obtain ⟨hab, hrest⟩ := h
      have hpair : (b :: bs).Pairwise (· < ·) := ih hrest
      have hbx : ∀ x ∈ bs, b < x := (List.pairwise_cons.mp hpair).1
      refine List.pairwise_cons.mpr ⟨?_, hpair⟩
      intro x hx
      rcases List.mem_cons.mp hx with rfl | hxbs
      · exact hab
      · exact lt_trans hab (hbx x hxbs)

lemma incr_nodup (l : List ℕ) (h : incr l = true) : l.Nodup :=
  (incr_pairwise l h).imp (fun hlt => ne_of_lt hlt)

lemma log_sum_le_theta (N : ℕ) (l : List ℕ) (hnd : l.Nodup)
    (hpr : ∀ p ∈ l, Nat.Prime p) (hle : ∀ p ∈ l, p ≤ N) :
    ((l.map (fun p : ℕ => Real.log (p:ℝ))).sum) ≤ Chebyshev.theta (N:ℝ) := by
  rw [Chebyshev.theta_eq_sum_Icc, Nat.floor_natCast]
  have hsum : ((l.map (fun p : ℕ => Real.log (p:ℝ))).sum) = ∑ p ∈ l.toFinset, Real.log (p:ℝ) :=
    (List.sum_toFinset (l := l) (f := fun p : ℕ => Real.log (p:ℝ)) hnd).symm
  rw [hsum]
  refine Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_
  · intro p hp
    rw [List.mem_toFinset] at hp
    simp only [Finset.mem_filter, Finset.mem_Icc]
    exact ⟨⟨Nat.zero_le _, hle p hp⟩, hpr p hp⟩
  · intro p hp _
    rw [Finset.mem_filter, Finset.mem_Icc] at hp
    have hp2 : 2 ≤ p := hp.2.two_le
    have hp1 : (1:ℝ) ≤ (p:ℝ) := by
      have h : (1:ℕ) ≤ p := by omega
      exact_mod_cast h
    exact Real.log_nonneg hp1

lemma chain_curried : ∀ e1 e2 : ℕ × ℕ, (e1,e2) ∈ C.zip C.tail → e2.2 = e1.2 + termOf e1.1 := by
  intro e1 e2 hmem
  exact chk_chain (e1,e2) hmem

lemma finite_bound (N : ℕ) (h1 : 1530 ≤ N) (h2 : N ≤ 30000) : 9*10^8 * (N+1) ≤ psum C N := by
  have hmem : lastEnt ∈ C := by
    rw [C]; exact List.mem_append_right _ (List.mem_singleton_self _)
  have hlt : N < lastEnt.1 := by
    show N < (30001 : ℕ); omega
  have hisSome : (bnd C N).isSome = true := bnd_isSome_of_mem hmem hlt
  obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp hisSome
  have hb_mem : b ∈ C := bnd_some_mem hb
  have hb_gt : N < b.1 := bnd_some_gt hb
  have hb_spec : b.2 = (C.head?.map Prod.snd).getD 0 + psum C N := bnd_spec C N chain_curried hb
  have hhead0 : (C.head?.map Prod.snd).getD 0 = 0 := by rw [chk_head]; rfl
  rw [hhead0, Nat.zero_add] at hb_spec
  have hbound := chk_bound b hb_mem (by omega)
  omega

lemma psum_le_theta (N : ℕ) (h2 : N ≤ 30000) :
    (psum C N : ℝ) ≤ 10^9 * Chebyshev.theta (N:ℝ) := by
  rw [psum_eq_pfx]
  have hcast : (((pfx C N).map (fun e : ℕ × ℕ => termOf e.1)).sum : ℝ)
      = ((pfx C N).map (fun e : ℕ × ℕ => (termOf e.1 : ℝ))).sum := by
    push_cast
    rw [List.map_map]
    rfl
  rw [hcast]
  have hnodup : ((pfx C N).map Prod.fst).Nodup :=
    List.Sublist.nodup ((pfx_sublist C N).map Prod.fst) (incr_nodup _ chk_incr)
  have hstep : ((pfx C N).map (fun e : ℕ × ℕ => (termOf e.1 : ℝ))).sum
      ≤ ((pfx C N).map (fun e : ℕ × ℕ => 10^9 * Real.log (e.1 : ℝ))).sum := by
    refine List.sum_le_sum ?_
    intro e he
    have heC : e ∈ C := pfx_mem he
    have hne : e.1 ≠ 30001 := by have := pfx_le he; omega
    have hip : ip e.1 = true := (chk_prim e heC).resolve_left hne
    have hp : Nat.Prime e.1 := (ip_spec e.1 (by have := pfx_le he; omega)).mp hip
    exact termOf_le_log e.1 hp.two_le
  rw [List.sum_map_mul_left (pfx C N) (fun e : ℕ × ℕ => Real.log (e.1 : ℝ)) (10^9)] at hstep
  have htheta : ((pfx C N).map (fun e : ℕ × ℕ => Real.log (e.1 : ℝ))).sum ≤ Chebyshev.theta (N:ℝ) := by
    have h1 : ((pfx C N).map (fun e : ℕ × ℕ => Real.log (e.1 : ℝ))).sum
        = (((pfx C N).map Prod.fst).map (fun p : ℕ => Real.log (p:ℝ))).sum := by
      rw [List.map_map]; rfl
    rw [h1]
    refine log_sum_le_theta N ((pfx C N).map Prod.fst) hnodup ?_ ?_
    · intro p hp
      rw [List.mem_map] at hp
      obtain ⟨e, he, rfl⟩ := hp
      have heC : e ∈ C := pfx_mem he
      have hne : e.1 ≠ 30001 := by have := pfx_le he; omega
      have hip : ip e.1 = true := (chk_prim e heC).resolve_left hne
      exact (ip_spec e.1 (by have := pfx_le he; omega)).mp hip
    · intro p hp
      rw [List.mem_map] at hp
      obtain ⟨e, he, rfl⟩ := hp
      exact pfx_le he
  linarith

end Commons.NumberTheory.Chebyshev.ThetaFinite

namespace Commons.NumberTheory.Chebyshev

theorem theta_lower_finite_range : ∀ N : ℕ, 1530 ≤ N → N ≤ 30000 → (9 / 10 : ℝ) * ((N : ℝ) + 1) ≤ Chebyshev.theta (N : ℝ) := by
  intro N h1 h2
  have hf : (9*10^8 * (N+1) : ℝ) ≤ (ThetaFinite.psum ThetaFinite.C N : ℝ) := by
    exact_mod_cast ThetaFinite.finite_bound N h1 h2
  have ht := ThetaFinite.psum_le_theta N h2
  have key : (9*10^8 * (N+1) : ℝ) / 10^9 ≤ Chebyshev.theta (N : ℝ) := by
    rw [div_le_iff₀ (by norm_num : (0:ℝ) < 10^9)]
    linarith [le_trans hf ht]
  have hcalc : (9*10^8 * (N+1) : ℝ) / 10^9 = (9 / 10 : ℝ) * ((N : ℝ) + 1) := by
    push_cast; ring
  rwa [hcalc] at key

end Commons.NumberTheory.Chebyshev
