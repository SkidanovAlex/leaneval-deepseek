/-! ### A cheap primality criterion based on `Nat.gcd` -/

lemma sp2_prime : ∀ m ∈ sp2, Nat.Prime m := by
  have h : sp2.all (fun m => decide (Nat.Prime m)) = true := by decide
  intro m hm
  exact of_decide_eq_true ((List.all_eq_true.mp h) m hm)

lemma sp2_complete : ∀ m, m ≤ 320 → Nat.Prime m → m ∈ sp2 := by
  have h : (List.range 321).all (fun m => !(decide (Nat.Prime m)) || (sp2.contains m)) = true := by decide
  intro m hm hp
  have hm' : m ∈ List.range 321 := List.mem_range.mpr (by omega)
  have h2 := List.all_eq_true.mp h m hm'
  simp only [Bool.or_eq_true, Bool.not_eq_true', decide_eq_false_iff_not, List.contains_iff_mem] at h2
  rcases h2 with h3 | h3
  · exact absurd hp h3
  · exact h3

lemma sp2_le : ∀ m ∈ sp2, m ≤ 317 := by
  have h : sp2.all (fun m => decide (m ≤ 317)) = true := by decide
  intro m hm
  exact of_decide_eq_true ((List.all_eq_true.mp h) m hm)

lemma Mprod_eq : Mprod = ∏ q ∈ sp2.toFinset, q := by
  decide

lemma sp2_dvd_Mprod : ∀ q ∈ sp2, q ∣ Mprod := by
  intro q hq
  rw [Mprod_eq]
  exact Finset.dvd_prod_of_mem (fun q => q) (by simpa using hq)

theorem prime_of_crit {p : ℕ} (hp2 : 2 ≤ p) (hle : p ≤ 102400)
    (h : Nat.gcd p Mprod = 1 ∨ p ∈ sp2) : Nat.Prime p := by
  rcases h with h | h
  · rw [Nat.prime_def_le_sqrt]
    refine ⟨hp2, fun m hm2 hmle hmdvd => ?_⟩
    obtain ⟨q, hqprime, hqdm⟩ := Nat.exists_prime_and_dvd (show m ≠ 1 by omega)
    have hqm : q ≤ m := Nat.le_of_dvd (by omega) hqdm
    have hqp : q ∣ p := dvd_trans hqdm hmdvd
    have hq2 : 2 ≤ q := hqprime.two_le
    have hqle : q ≤ 320 := by
      have h1 : q ≤ Nat.sqrt p := le_trans hqm hmle
      have h2 : Nat.sqrt p < 321 := by rw [Nat.sqrt_lt]; norm_num; omega
      omega
    have hqmem : q ∈ sp2 := sp2_complete q hqle hqprime
    have hqM : q ∣ Mprod := sp2_dvd_Mprod q hqmem
    have hqg : q ∣ Nat.gcd p Mprod := Nat.dvd_gcd hqp hqM
    rw [h] at hqg
    exact absurd (Nat.le_of_dvd (by norm_num : (0:ℕ) < 1) hqg) (by omega)
  · exact sp2_prime p h

lemma prime_gcd_one {p : ℕ} (hp : Nat.Prime p) (h317 : 317 < p) : Nat.gcd p Mprod = 1 := by
  rw [← Nat.coprime_iff_gcd_eq_one, Mprod_eq]
  refine Nat.Coprime.prod_right fun q hq => ?_
  have hqsp : q ∈ sp2 := by simpa using hq
  have hqp : Nat.Prime q := sp2_prime q hqsp
  rw [Nat.coprime_primes hp hqp]
  intro hpq
  have := sp2_le q hqsp
  omega

lemma not_prime_of_gcd {k : ℕ} (hk : 317 < k) (h : Nat.gcd k Mprod ≠ 1) : ¬ Nat.Prime k :=
  fun hp => h (prime_gcd_one hp hk)

lemma not_prime_of_crit {k : ℕ}
    (h : (k ≤ 317 → k ∉ sp2) ∧ (317 < k → Nat.gcd k Mprod ≠ 1)) : ¬ Nat.Prime k := by
  rcases h with ⟨h1, h2⟩
  rcases le_or_gt k 317 with hk | hk
  · intro hp
    exact h1 hk (sp2_complete k (by omega) hp)
  · exact not_prime_of_gcd hk (h2 hk)

/-- Bracket numerator function of the target statement. -/
def brk (N : ℕ) : ℕ :=
  if N ≤ 100 then 79 else if N ≤ 150 then 84 else if N ≤ 250 then 86
    else if N ≤ 400 then 89 else if N ≤ 700 then 91 else if N ≤ 1100 then 93
    else if N ≤ 1530 then 94 else 96

lemma brk_mono : Monotone brk := by
  intro a b hab
  unfold brk
  split_ifs <;> omega

lemma brk_cast (N : ℕ) :
    (brk N : ℝ) = (if N ≤ 100 then (79 : ℝ) else if N ≤ 150 then 84 else
      if N ≤ 250 then 86 else if N ≤ 400 then 89 else if N ≤ 700 then 91 else
      if N ≤ 1100 then 93 else if N ≤ 1530 then 94 else 96) := by
  by_cases h1 : N ≤ 100
  · unfold brk; simp [h1]
  · by_cases h2 : N ≤ 150
    · unfold brk; simp [h1, h2]
    · by_cases h3 : N ≤ 250
      · unfold brk; simp [h1, h2, h3]
      · by_cases h4 : N ≤ 400
        · unfold brk; simp [h1, h2, h3, h4]
        · by_cases h5 : N ≤ 700
          · unfold brk; simp [h1, h2, h3, h4, h5]
          · by_cases h6 : N ≤ 1100
            · unfold brk; simp [h1, h2, h3, h4, h5, h6]
            · by_cases h7 : N ≤ 1530
              · unfold brk; simp [h1, h2, h3, h4, h5, h6, h7]
              · unfold brk; simp [h1, h2, h3, h4, h5, h6, h7]

lemma brk_div_cast (N : ℕ) :
    (brk N : ℝ) / 100 = (if N ≤ 100 then (79 : ℝ)/100 else if N ≤ 150 then 84/100 else
      if N ≤ 250 then 86/100 else if N ≤ 400 then 89/100 else if N ≤ 700 then 91/100 else
      if N ≤ 1100 then 93/100 else if N ≤ 1530 then 94/100 else 96/100) := by
  rw [brk_cast]
  by_cases h1 : N ≤ 100
  · simp [h1]
  · by_cases h2 : N ≤ 150
    · simp [h1, h2]
    · by_cases h3 : N ≤ 250
      · simp [h1, h2, h3]
      · by_cases h4 : N ≤ 400
        · simp [h1, h2, h3, h4]
        · by_cases h5 : N ≤ 700
          · simp [h1, h2, h3, h4, h5]
          · by_cases h6 : N ≤ 1100
            · simp [h1, h2, h3, h4, h5, h6]
            · by_cases h7 : N ≤ 1530
              · simp [h1, h2, h3, h4, h5, h6, h7]
              · simp [h1, h2, h3, h4, h5, h6, h7]

/-! ### Checks (by computation, Bool-valued) -/

/-! ### List helpers for the completeness argument -/

lemma mem_zip_tail_iff {α : Type} (a b : α) (l : List α) (pr : α × α) :
    pr ∈ (a :: b :: l).zip (a :: b :: l).tail ↔ pr = (a, b) ∨ pr ∈ (b :: l).zip (b :: l).tail := by
  simp only [List.tail_cons]
  rw [List.zip_cons_cons, List.mem_cons]

lemma zip_tail_subset {α : Type} (a b : α) (l : List α) :
    (b :: l).zip (b :: l).tail ⊆ (a :: b :: l).zip (a :: b :: l).tail := by
  intro pr hp
  simp only [List.tail_cons] at hp ⊢
  rw [List.zip_cons_cons]
  exact List.mem_cons_of_mem _ hp

lemma zip_subset_cons {α : Type} (a : α) (l : List α) :
    l.zip l.tail ⊆ (a :: l).zip (a :: l).tail := by
  cases l with
  | nil => intro pr hp; simp at hp
  | cons b bs => exact zip_tail_subset a b bs

lemma head_lt_of_zip_lt_aux : ∀ (a : ℕ) (t : List ℕ),
    (∀ pr ∈ (a :: t).zip (a :: t).tail, pr.1 < pr.2) → ∀ x ∈ t, a < x := by
  intro a t
  induction t generalizing a with
  | nil => intro _ x hx; exact absurd hx (by simp)
  | cons b bs ih =>
    intro h x hx
    have hab : a < b := h (a, b) ((mem_zip_tail_iff a b bs (a, b)).mpr (Or.inl rfl))
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact hab
    · have h' : ∀ pr ∈ (b :: bs).zip (b :: bs).tail, pr.1 < pr.2 := by
        intro pr hp
        exact h pr (zip_tail_subset a b bs hp)
      exact lt_trans hab (ih b h' x hx')

lemma mem_of_gap_aux : ∀ (l : List ℕ) (a : ℕ),
    (∀ x ∈ l, a < x) →
    (∀ pr ∈ l.zip l.tail, pr.1 < pr.2) →
    (∀ pr ∈ (a :: l).zip (a :: l).tail, ∀ k, pr.1 < k → k < pr.2 → ¬ Nat.Prime k) →
    ∀ N, a < N → Nat.Prime N → (∃ x ∈ l, N ≤ x) → N ∈ l := by
  intro l
  induction l with
  | nil =>
    intro a _ _ _ N _ _ hex
    obtain ⟨x, hx, _⟩ := hex
    exact absurd hx (by simp)
  | cons x t ih =>
    intro a hax hsort hgap N haN hNp hex
    have hax' : a < x := hax x (by simp)
    rcases lt_trichotomy N x with hlt | heq | hgt
    · exact absurd hNp (hgap (a, x) ((mem_zip_tail_iff a x t (a, x)).mpr (Or.inl rfl)) N haN hlt)
    · rw [heq]; exact List.mem_cons_self ..
    · have hrest : ∀ y ∈ t, x < y := head_lt_of_zip_lt_aux x t hsort
      have hsortT : ∀ pr ∈ t.zip t.tail, pr.1 < pr.2 := by
        intro pr hp
        exact hsort pr (zip_subset_cons x t hp)
      have hgap' : ∀ pr ∈ (x :: t).zip (x :: t).tail, ∀ k, pr.1 < k → k < pr.2 → ¬ Nat.Prime k := by
        intro pr hp k h1 h2
        exact hgap pr (zip_tail_subset a x t hp) k h1 h2
      rcases hex with ⟨e, he, hNe⟩
      have he' : e ∈ t := by
        rcases List.mem_cons.mp he with rfl | h
        · omega
        · exact h
      exact List.mem_cons_of_mem _ (ih x hrest hsortT hgap' N (by omega) hNp ⟨e, he', hNe⟩)

lemma prime_mem_of_gap (l : List ℕ)
    (hsort : ∀ pr ∈ l.zip l.tail, pr.1 < pr.2)
    (hgap : ∀ pr ∈ l.zip l.tail, ∀ k, pr.1 < k → k < pr.2 → ¬ Nat.Prime k)
    (hh : l.head? = some 2) :
    ∀ N, 2 ≤ N → (∃ e ∈ l, N ≤ e) → Nat.Prime N → N ∈ l := by
  intro N hN2 hex hNp
  obtain ⟨t, rfl⟩ := List.head?_eq_some_iff.mp hh
  rcases lt_or_eq_of_le hN2 with hN3 | hN3
  · rcases hex with ⟨e, he, hNe⟩
    have he' : e ∈ t := by
      rcases List.mem_cons.mp he with rfl | h
      · omega
      · exact h
    exact List.mem_cons_of_mem _
      (mem_of_gap_aux t 2 (head_lt_of_zip_lt_aux 2 t hsort)
        (fun pr hp => hsort pr (zip_subset_cons 2 t hp)) hgap N hN3 hNp ⟨e, he', hNe⟩)
  · rw [← hN3]; exact List.mem_cons_self ..

theorem CL_head : CL.head? = some (2, 0) := by decide

theorem CL_allB : (CL.zip CL.tail).all (fun pr =>
    decide (pr.2.2 = pr.1.2 + ltOf pr.1.1) && decide (pr.1.1 < pr.2.1) &&
      decide (2 ≤ pr.2.1 ∧ pr.2.1 ≤ 102400 ∧ (Nat.gcd pr.2.1 Mprod = 1 ∨ pr.2.1 ∈ sp2)) &&
      decide (60 ≤ pr.2.1 →
        brk (min (pr.2.1 - 1) 100000) * (min (pr.2.1 - 1) 100000) * 10^9 ≤ 100 * pr.2.2)) = true :=
  by decide

lemma CL_all (pr : (ℕ × ℕ) × (ℕ × ℕ)) (h : pr ∈ CL.zip CL.tail) :
    (pr.2.2 = pr.1.2 + ltOf pr.1.1) ∧ pr.1.1 < pr.2.1 ∧
      (2 ≤ pr.2.1 ∧ pr.2.1 ≤ 102400 ∧ (Nat.gcd pr.2.1 Mprod = 1 ∨ pr.2.1 ∈ sp2)) ∧
      (60 ≤ pr.2.1 →
        brk (min (pr.2.1 - 1) 100000) * (min (pr.2.1 - 1) 100000) * 10^9 ≤ 100 * pr.2.2) := by
  have h1 := List.all_eq_true.mp CL_allB pr h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
  tauto

theorem CL_headcrit : 2 ≤ (2 : ℕ) ∧ (2 : ℕ) ≤ 102400 ∧
    (Nat.gcd (2 : ℕ) Mprod = 1 ∨ (2 : ℕ) ∈ sp2) := by decide

lemma CL_chain : ∀ e1 e2, (e1, e2) ∈ CL.zip CL.tail → e2.2 = e1.2 + ltOf e1.1 :=
  fun e1 e2 h => (CL_all (e1, e2) h).1

lemma CL_ltpair : ∀ pr ∈ CL.zip CL.tail, pr.1.1 < pr.2.1 :=
  fun pr h => (CL_all pr h).2.1

lemma mem_or_head : ∀ {l : List (ℕ × ℕ)} {e : ℕ × ℕ},
    e ∈ l → l.head? = some e ∨ ∃ pr ∈ l.zip l.tail, pr.2 = e := by
  intro l
  induction l with
  | nil => intro e he; exact absurd he (by simp)
  | cons x t ih =>
    intro e he
    rcases List.mem_cons.mp he with rfl | he'
    · exact Or.inl (by simp)
    · rcases ih he' with h | ⟨pr, hpr, hpr2⟩
      · cases t with
        | nil => simp at h
        | cons y s =>
          have hy : y = e := by simpa using h
          exact Or.inr ⟨(x, y), (mem_zip_tail_iff x y s (x, y)).mpr (Or.inl rfl), by simp [hy]⟩
      · cases t with
        | nil => exact absurd hpr (by simp)
        | cons y s => exact Or.inr ⟨pr, zip_tail_subset x y s hpr, hpr2⟩

lemma CL_crit (e : ℕ × ℕ) (he : e ∈ CL) :
    2 ≤ e.1 ∧ e.1 ≤ 102400 ∧ (Nat.gcd e.1 Mprod = 1 ∨ e.1 ∈ sp2) := by
  rcases mem_or_head he with h | ⟨pr, hpr, hpr2⟩
  · rw [CL_head] at h
    simp only [Option.some.injEq] at h
    subst h
    exact CL_headcrit
  · have h2 : 60 ≤ pr.2.1 → brk (min (pr.2.1 - 1) 100000) *
        (min (pr.2.1 - 1) 100000) * 10^9 ≤ 100 * pr.2.2 := (CL_all pr hpr).2.2.2
    rw [← hpr2]
    exact (CL_all pr hpr).2.2.1

lemma CL_low : ∀ e ∈ CL, 60 ≤ e.1 →
    brk (min (e.1 - 1) 100000) * (min (e.1 - 1) 100000) * 10^9 ≤ 100 * e.2 := by
  intro e he h60
  rcases mem_or_head he with h | ⟨pr, hpr, hpr2⟩
  · rw [CL_head] at h
    simp only [Option.some.injEq] at h
    subst h
    exact absurd h60 (by decide)
  · have h60' : 60 ≤ pr.2.1 := by rw [hpr2]; exact h60
    rw [← hpr2]
    exact (CL_all pr hpr).2.2.2 h60'

lemma CL_prim (e : ℕ × ℕ) (he : e ∈ CL) : Nat.Prime e.1 :=
  let h := CL_crit e he
  prime_of_crit h.1 h.2.1 h.2.2

lemma head_lt_of_zip_lt_natpair : ∀ (a : ℕ × ℕ) (t : List (ℕ × ℕ)),
    (∀ pr ∈ (a :: t).zip (a :: t).tail, pr.1.1 < pr.2.1) → ∀ x ∈ t, a.1 < x.1 := by
  intro a t
  induction t generalizing a with
  | nil => intro _ x hx; exact absurd hx (by simp)
  | cons b bs ih =>
    intro h x hx
    have hab : a.1 < b.1 := h (a, b) ((mem_zip_tail_iff a b bs (a, b)).mpr (Or.inl rfl))
    rcases List.mem_cons.mp hx with rfl | hx'
    · exact hab
    · have h' : ∀ pr ∈ (b :: bs).zip (b :: bs).tail, pr.1.1 < pr.2.1 := by
        intro pr hp
        exact h pr (zip_tail_subset a b bs hp)
      exact lt_trans hab (ih b h' x hx')

lemma nodup_map_fst_of_zip_lt : ∀ (l : List (ℕ × ℕ)),
    (∀ pr ∈ l.zip l.tail, pr.1.1 < pr.2.1) → (l.map Prod.fst).Nodup := by
  intro l
  induction l with
  | nil => intro _; simp
  | cons x t ih =>
    intro h
    have hrest : ∀ pr ∈ t.zip t.tail, pr.1.1 < pr.2.1 := by
      intro pr hp
      exact h pr (zip_subset_cons x t hp)
    have hhead : ∀ y ∈ t, x.1 < y.1 := head_lt_of_zip_lt_natpair x t h
    rw [List.map_cons]
    refine List.nodup_cons.mpr ⟨?_, ih hrest⟩
    intro hx
    rw [List.mem_map] at hx
    obtain ⟨y, hy, hyx⟩ := hx
    have := hhead y hy
    omega

lemma CL_nodup : (CL.map Prod.fst).Nodup := nodup_map_fst_of_zip_lt CL CL_ltpair

theorem CU_head : CU.head? = some (2, 0) := by decide

theorem CU_allB : (CU.zip CU.tail).all (fun pr =>
    decide (pr.2.2 = pr.1.2 + utOf pr.1.1) && decide (pr.2.2 ≤ 10^9 * pr.1.1) &&
      decide (pr.1.1 < pr.2.1) &&
      decide (2 ≤ pr.2.1 ∧ pr.2.1 ≤ 102400 ∧ (Nat.gcd pr.2.1 Mprod = 1 ∨ pr.2.1 ∈ sp2))) = true :=
  by decide

lemma CU_all (pr : (ℕ × ℕ) × (ℕ × ℕ)) (h : pr ∈ CU.zip CU.tail) :
    (pr.2.2 = pr.1.2 + utOf pr.1.1) ∧ pr.2.2 ≤ 10^9 * pr.1.1 ∧ pr.1.1 < pr.2.1 ∧
      (2 ≤ pr.2.1 ∧ pr.2.1 ≤ 102400 ∧ (Nat.gcd pr.2.1 Mprod = 1 ∨ pr.2.1 ∈ sp2)) := by
  have h1 := List.all_eq_true.mp CU_allB pr h
  simp only [Bool.and_eq_true, decide_eq_true_eq] at h1
  tauto

theorem CU_headcrit : 2 ≤ (2 : ℕ) ∧ (2 : ℕ) ≤ 102400 ∧
    (Nat.gcd (2 : ℕ) Mprod = 1 ∨ (2 : ℕ) ∈ sp2) := by decide

lemma CU_chain : ∀ e1 e2, (e1, e2) ∈ CU.zip CU.tail → e2.2 = e1.2 + utOf e1.1 :=
  fun e1 e2 h => (CU_all (e1, e2) h).1

lemma CU_up : ∀ pr ∈ CU.zip CU.tail, pr.2.2 ≤ 10^9 * pr.1.1 :=
  fun pr h => (CU_all pr h).2.1

lemma CU_ltpair : ∀ pr ∈ CU.zip CU.tail, pr.1.1 < pr.2.1 :=
  fun pr h => (CU_all pr h).2.2.1

lemma CU_crit (e : ℕ × ℕ) (he : e ∈ CU) :
    2 ≤ e.1 ∧ e.1 ≤ 102400 ∧ (Nat.gcd e.1 Mprod = 1 ∨ e.1 ∈ sp2) := by
  rcases mem_or_head he with h | ⟨pr, hpr, hpr2⟩
  · rw [CU_head] at h
    simp only [Option.some.injEq] at h
    subst h
    exact CU_headcrit
  · rw [← hpr2]
    exact (CU_all pr hpr).2.2.2

lemma CU_prim (e : ℕ × ℕ) (he : e ∈ CU) : Nat.Prime e.1 :=
  let h := CU_crit e he
  prime_of_crit h.1 h.2.1 h.2.2

lemma CU_nodup : (CU.map Prod.fst).Nodup := nodup_map_fst_of_zip_lt CU CU_ltpair

theorem CU_gapB : ((CU.map Prod.fst).zip (CU.map Prod.fst).tail).all (fun pr =>
    decide (pr.1 < pr.2) &&
      (List.range (pr.2 - pr.1 - 1)).all (fun j => decide
        (((pr.1 + 1 + j) ≤ 317 → (pr.1 + 1 + j) ∉ sp2) ∧
         (317 < pr.1 + 1 + j → Nat.gcd (pr.1 + 1 + j) Mprod ≠ 1)))) = true := by decide

lemma CU_gapP (a b : ℕ) (h : (a, b) ∈ (CU.map Prod.fst).zip (CU.map Prod.fst).tail) :
    a < b ∧ ∀ k, a < k → k < b → ¬ Nat.Prime k := by
  have h1 := List.all_eq_true.mp CU_gapB (a, b) h
  rw [Bool.and_eq_true] at h1
  obtain ⟨hab, h2⟩ := h1
  refine ⟨of_decide_eq_true hab, ?_⟩
  intro k hak hkb
  have hk : k - a - 1 < b - a - 1 := by omega
  have h3 := List.all_eq_true.mp h2 (k - a - 1) (List.mem_range.mpr hk)
  have h4 : a + 1 + (k - a - 1) = k := by omega
  rw [h4] at h3
  exact not_prime_of_crit (of_decide_eq_true h3)

lemma CU_lt : ∀ pr ∈ (CU.map Prod.fst).zip (CU.map Prod.fst).tail, pr.1 < pr.2 :=
  fun pr h => (CU_gapP pr.1 pr.2 h).1

lemma CU_gap : ∀ pr ∈ (CU.map Prod.fst).zip (CU.map Prod.fst).tail,
    ∀ k, pr.1 < k → k < pr.2 → ¬ Nat.Prime k :=
  fun pr h => (CU_gapP pr.1 pr.2 h).2


/-! ### Generic list machinery for extracting the finite bounds -/

def psumF (f : ℕ → ℕ) : List (ℕ × ℕ) → ℕ → ℕ
  | [], _ => 0
  | e :: rest, N => if e.1 ≤ N then f e.1 + psumF f rest N else 0

lemma psumF_eq (f : ℕ → ℕ) : ∀ (C : List (ℕ × ℕ)) (N : ℕ),
    psumF f C N = ((ThetaFinite.pfx C N).map (fun e => f e.1)).sum := by
  intro C N
  induction C with
  | nil => rfl
  | cons e rest ih =>
    by_cases h : e.1 ≤ N
    · simp [psumF, ThetaFinite.pfx, h, ih]
    · simp [psumF, ThetaFinite.pfx, h, ih]

lemma bnd_spec_gen (f : ℕ → ℕ) : ∀ (C : List (ℕ × ℕ)) (N : ℕ),
    (∀ e1 e2, (e1, e2) ∈ C.zip C.tail → e2.2 = e1.2 + f e1.1) →
    ∀ {b : ℕ × ℕ}, ThetaFinite.bnd C N = some b →
      b.2 = (C.head?.map Prod.snd).getD 0 + psumF f C N := by
  intro C N
  induction C with
  | nil => intro _ b hb; simp [ThetaFinite.bnd] at hb
  | cons e rest ih =>
    intro hchain b hb
    by_cases hle : e.1 ≤ N
    · have hb' : ThetaFinite.bnd rest N = some b := by simpa [ThetaFinite.bnd, hle] using hb
      have hchain' : ∀ e1 e2, (e1, e2) ∈ rest.zip rest.tail → e2.2 = e1.2 + f e1.1 := by
        intro e1 e2 hmem
        exact hchain e1 e2 (by
          cases rest with
          | nil => exact absurd hmem (by simp)
          | cons b' bs =>
            simp only [List.tail_cons, List.zip_cons_cons, List.mem_cons]
            exact Or.inr (by simpa using hmem))
      have hb_spec := ih hchain' hb'
      have hhead : (rest.head?.map Prod.snd).getD 0 = e.2 + f e.1 := by
        cases rest with
        | nil => simp [ThetaFinite.bnd] at hb'
        | cons b' bs =>
          have hmem : (e, b') ∈ (e :: b' :: bs).zip (b' :: bs) := by
            rw [List.zip_cons_cons]; exact List.mem_cons_self ..
          have := hchain e b' hmem
          simpa using this
      rw [hhead] at hb_spec
      rw [show psumF f (e :: rest) N = f e.1 + psumF f rest N from by simp [psumF, hle]]
      rw [show ((e :: rest).head?.map Prod.snd).getD 0 = e.2 from by simp]
      linarith
    · have hbe : b = e := by
        have h2 : some e = some b := by simpa [ThetaFinite.bnd, hle] using hb
        exact (Option.some.inj h2).symm
      rw [hbe]
      rw [show psumF f (e :: rest) N = 0 from by simp [psumF, hle]]
      rw [show ((e :: rest).head?.map Prod.snd).getD 0 = e.2 from by simp]
      simp

def bnd2 : List (ℕ × ℕ) → ℕ → Option ((ℕ × ℕ) × (ℕ × ℕ))
  | [], _ => none
  | [_], _ => none
  | e1 :: e2 :: rest, N =>
      if e1.1 ≤ N then (if e2.1 ≤ N then bnd2 (e2 :: rest) N else some (e1, e2)) else none

lemma bnd2_cons (e1 e2 : ℕ × ℕ) (rest : List (ℕ × ℕ)) (N : ℕ) :
    bnd2 (e1 :: e2 :: rest) N =
      (if e1.1 ≤ N then (if e2.1 ≤ N then bnd2 (e2 :: rest) N else some (e1, e2)) else none) :=
  rfl

lemma bnd2_spec : ∀ (C : List (ℕ × ℕ)) (N : ℕ) {a b : ℕ × ℕ},
    bnd2 C N = some (a, b) → (a, b) ∈ C.zip C.tail ∧ a.1 ≤ N ∧ N < b.1 := by
  intro C
  induction C with
  | nil => intro N a b h; simp [bnd2] at h
  | cons e1 rest ih =>
    intro N a b h
    cases rest with
    | nil => simp [bnd2] at h
    | cons e2 rest' =>
      rw [bnd2_cons] at h
      by_cases h1 : e1.1 ≤ N
      · rw [if_pos h1] at h
        by_cases h2 : e2.1 ≤ N
        · rw [if_pos h2] at h
          obtain ⟨hmem, hle, hlt⟩ := ih N h
          exact ⟨zip_tail_subset e1 e2 rest' hmem, hle, hlt⟩
        · rw [if_neg h2] at h
          rw [Option.some.injEq, Prod.mk.injEq] at h
          obtain ⟨rfl, rfl⟩ := h
          exact ⟨(mem_zip_tail_iff e1 e2 rest' (e1, e2)).mpr (Or.inl rfl), h1, by omega⟩
      · rw [if_neg h1] at h
        exact absurd h (by simp)

lemma bnd2_isSome_of : ∀ (C : List (ℕ × ℕ)) (N : ℕ),
    (∀ e, C.head? = some e → e.1 ≤ N) → (∃ e ∈ C, N < e.1) → (bnd2 C N).isSome = true := by
  intro C
  induction C with
  | nil =>
    intro N hh hex
    obtain ⟨e, he, _⟩ := hex
    exact absurd he (by simp)
  | cons e1 rest ih =>
    intro N hh hex
    cases rest with
    | nil =>
      obtain ⟨e, he, hlt⟩ := hex
      rw [List.mem_singleton] at he
      have hle := hh e1 (by simp)
      rw [← he] at hle
      omega
    | cons e2 rest' =>
      have h1 : e1.1 ≤ N := hh e1 (by simp)
      rw [bnd2_cons]
      by_cases h2 : e2.1 ≤ N
      · rw [if_pos h1, if_pos h2]
        refine ih N ?_ ?_
        · intro e he
          rw [List.head?_cons, Option.some.injEq] at he
          subst he; exact h2
        · obtain ⟨e, he, hlt⟩ := hex
          rcases List.mem_cons.mp he with rfl | he'
          · omega
          · exact ⟨e, he', hlt⟩
      · rw [if_pos h1, if_neg h2]
        rfl

lemma bnd2_snd_eq_bnd : ∀ (C : List (ℕ × ℕ)) (N : ℕ) {a b : ℕ × ℕ},
    bnd2 C N = some (a, b) → ThetaFinite.bnd C N = some b := by
  intro C
  induction C with
  | nil => intro N a b h; exact absurd h (by simp [bnd2])
  | cons e1 rest ih =>
    intro N a b h
    cases rest with
    | nil => exact absurd h (by simp [bnd2])
    | cons e2 rest' =>
      rw [bnd2_cons] at h
      by_cases h1 : e1.1 ≤ N
      · rw [if_pos h1] at h
        by_cases h2 : e2.1 ≤ N
        · rw [if_pos h2] at h
          have := ih N h
          simpa [ThetaFinite.bnd, h1] using this
        · rw [if_neg h2] at h
          have hh2 : b = e2 := by
            rw [Option.some.injEq, Prod.mk.injEq] at h
            exact h.2.symm
          subst hh2
          simp [ThetaFinite.bnd, h1, h2]
      · rw [if_neg h1] at h
        exact absurd h (by simp)

lemma mem_pfx_of_mem {C : List (ℕ × ℕ)}
    (hsort : ∀ pr ∈ C.zip C.tail, pr.1.1 < pr.2.1)
    {N : ℕ} {e : ℕ × ℕ} (he : e ∈ C) (hle : e.1 ≤ N) :
    e ∈ ThetaFinite.pfx C N := by
  induction C with
  | nil => exact absurd he (by simp)
  | cons f rest ih =>
    have hrest : ∀ pr ∈ rest.zip rest.tail, pr.1.1 < pr.2.1 := by
      intro pr hp
      exact hsort pr (zip_subset_cons f rest hp)
    have hhead : ∀ x ∈ rest, f.1 < x.1 := head_lt_of_zip_lt_natpair f rest hsort
    simp only [ThetaFinite.pfx]
    by_cases h : f.1 ≤ N
    · rw [if_pos h]
      rcases List.mem_cons.mp he with rfl | he'
      · exact List.mem_cons_self ..
      · exact List.mem_cons_of_mem _ (ih hrest he')
    · rw [if_neg h]
      rcases List.mem_cons.mp he with rfl | he'
      · omega
      · have := hhead e he'
        omega

/-! ### Extraction of the finite bounds -/

lemma psumL_le_theta (N : ℕ) (hN : N ≤ 10^5) :
    (psumF ltOf CL N : ℝ) ≤ 10^9 * Chebyshev.theta (N : ℝ) := by
  rw [psumF_eq]
  have hcast : (((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => ltOf e.1)).sum : ℝ)
      = ((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => (ltOf e.1 : ℝ))).sum := by
    push_cast
    rw [List.map_map]; rfl
  rw [hcast]
  have hnodup : ((ThetaFinite.pfx CL N).map Prod.fst).Nodup :=
    List.Sublist.nodup ((ThetaFinite.pfx_sublist CL N).map Prod.fst) CL_nodup
  have hstep : ((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => (ltOf e.1 : ℝ))).sum
      ≤ ((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => 10^9 * Real.log (e.1 : ℝ))).sum := by
    refine List.sum_le_sum ?_
    intro e he
    have heC : e ∈ CL := ThetaFinite.pfx_mem he
    exact ltOf_le_log e.1 (CL_prim e heC).two_le
  rw [List.sum_map_mul_left (ThetaFinite.pfx CL N) (fun e : ℕ × ℕ => Real.log (e.1 : ℝ)) (10^9)]
    at hstep
  have htheta : ((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => Real.log (e.1 : ℝ))).sum
      ≤ Chebyshev.theta (N : ℝ) := by
    have h1 : ((ThetaFinite.pfx CL N).map (fun e : ℕ × ℕ => Real.log (e.1 : ℝ))).sum
        = (((ThetaFinite.pfx CL N).map Prod.fst).map (fun p : ℕ => Real.log (p : ℝ))).sum := by
      rw [List.map_map]; rfl
    rw [h1]
    refine ThetaFinite.log_sum_le_theta N ((ThetaFinite.pfx CL N).map Prod.fst) hnodup ?_ ?_
    · intro p hp
      rw [List.mem_map] at hp
      obtain ⟨e, he, rfl⟩ := hp
      exact CL_prim e (ThetaFinite.pfx_mem he)
    · intro p hp
      rw [List.mem_map] at hp
      obtain ⟨e, he, rfl⟩ := hp
      exact ThetaFinite.pfx_le he
  linarith

lemma finite_lower (N : ℕ) (h1 : 59 ≤ N) (h2 : N ≤ 10^5) :
    brk N * N * 10^9 ≤ 100 * psumF ltOf CL N := by
  have hsent : sentCL ∈ CL := List.mem_append_right _ (by simp)
  have hlt : N < sentCL.1 := by simp [sentCL]; omega
  have hisSome : (ThetaFinite.bnd CL N).isSome = true := ThetaFinite.bnd_isSome_of_mem hsent hlt
  obtain ⟨b, hb⟩ := Option.isSome_iff_exists.mp hisSome
  have hb_mem : b ∈ CL := ThetaFinite.bnd_some_mem hb
  have hb_gt : N < b.1 := ThetaFinite.bnd_some_gt hb
  have hb_spec : b.2 = (CL.head?.map Prod.snd).getD 0 + psumF ltOf CL N :=
    bnd_spec_gen ltOf CL N CL_chain hb
  have hhead0 : (CL.head?.map Prod.snd).getD 0 = 0 := by rw [CL_head]; rfl
  rw [hhead0, Nat.zero_add] at hb_spec
  have hb60 : 60 ≤ b.1 := by omega
  have hcheck := CL_low b hb_mem hb60
  have hhi : N ≤ min (b.1 - 1) 100000 := by omega
  have hmono : brk N * N ≤ brk (min (b.1 - 1) 100000) * (min (b.1 - 1) 100000) :=
    Nat.mul_le_mul (brk_mono hhi) hhi
  calc brk N * N * 10^9
      ≤ brk (min (b.1 - 1) 100000) * (min (b.1 - 1) 100000) * 10^9 := Nat.mul_le_mul_right _ hmono
    _ ≤ 100 * b.2 := hcheck
    _ = 100 * psumF ltOf CL N := by rw [hb_spec]

lemma finite_upper (N : ℕ) (h1 : 59 ≤ N) (h2 : N ≤ 10^5) :
    psumF utOf CU N ≤ 10^9 * N := by
  have hsent : sentCU ∈ CU := List.mem_append_right _ (by simp)
  have hlt : N < sentCU.1 := by simp [sentCU]; omega
  have hhead : ∀ e, CU.head? = some e → e.1 ≤ N := by
    intro e he
    rw [CU_head] at he
    simp only [Option.some.injEq] at he
    subst he
    simp only [Prod.fst]; omega
  have hisSome : (bnd2 CU N).isSome = true := bnd2_isSome_of CU N hhead ⟨sentCU, hsent, hlt⟩
  obtain ⟨ab, hab⟩ := Option.isSome_iff_exists.mp hisSome
  obtain ⟨a, b⟩ := ab
  obtain ⟨hmem, hle, hlt'⟩ := bnd2_spec CU N hab
  have hbnd : ThetaFinite.bnd CU N = some b := bnd2_snd_eq_bnd CU N hab
  have hb_spec : b.2 = (CU.head?.map Prod.snd).getD 0 + psumF utOf CU N :=
    bnd_spec_gen utOf CU N CU_chain hbnd
  have hhead0 : (CU.head?.map Prod.snd).getD 0 = 0 := by rw [CU_head]; rfl
  rw [hhead0, Nat.zero_add] at hb_spec
  have hcheck := CU_up (a, b) hmem
  calc psumF utOf CU N = b.2 := hb_spec.symm
    _ ≤ 10^9 * a.1 := hcheck
    _ ≤ 10^9 * N := Nat.mul_le_mul_left _ hle

lemma theta_le_psumU (N : ℕ) (hN : N ≤ 10^5) :
    10^9 * Chebyshev.theta (N : ℝ) ≤ (psumF utOf CU N : ℝ) := by
  have hθ : Chebyshev.theta (N : ℝ) = ∑ p ∈ Nat.primesLE N, Real.log (p : ℝ) :=
    Chebyshev.theta_eq_sum_primesLE_log N
  rw [hθ, Finset.mul_sum, psumF_eq]
  have hnd : ((ThetaFinite.pfx CU N).map Prod.fst).Nodup :=
    List.Sublist.nodup ((ThetaFinite.pfx_sublist CU N).map Prod.fst) CU_nodup
  have hsum : ((ThetaFinite.pfx CU N).map (fun e => utOf e.1)).sum
      = ((ThetaFinite.pfx CU N).map Prod.fst).toFinset.sum (fun p => utOf p) := by
    rw [List.sum_toFinset (fun p => utOf p) hnd, List.map_map]
    rfl
  rw [hsum]
  push_cast
  refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_) (Finset.sum_le_sum ?_)
  · intro p hp
    rw [Nat.mem_primesLE] at hp
    obtain ⟨hpN, hpprime⟩ := hp
    have hmemCU : p ∈ CU.map Prod.fst := by
      have hhead2 : (CU.map Prod.fst).head? = some 2 := by rw [List.head?_map, CU_head]; rfl
      refine prime_mem_of_gap (CU.map Prod.fst) CU_lt CU_gap hhead2 p hpprime.two_le ?_ hpprime
      exact ⟨100003,
        by rw [List.mem_map]; exact ⟨sentCU, List.mem_append_right _ (by simp), by simp [sentCU]⟩,
        by omega⟩
    rw [List.mem_map] at hmemCU
    obtain ⟨e, heC, heq⟩ := hmemCU
    rw [List.mem_toFinset, List.mem_map]
    exact ⟨e, mem_pfx_of_mem CU_ltpair heC (by omega), heq⟩
  · intro p hp _
    rw [List.mem_toFinset, List.mem_map] at hp
    obtain ⟨e, he, heq⟩ := hp
    have hpprime : Nat.Prime p := by rw [← heq]; exact CU_prim e (ThetaFinite.pfx_mem he)
    have hp2 : (2:ℝ) ≤ (p:ℝ) := by exact_mod_cast hpprime.two_le
    have : (1:ℝ) ≤ (p:ℝ) := by linarith
    positivity
  · intro p hp
    rw [List.mem_toFinset, List.mem_map] at hp
    obtain ⟨e, he, heq⟩ := hp
    have hpprime : Nat.Prime p := by rw [← heq]; exact CU_prim e (ThetaFinite.pfx_mem he)
    rw [← heq]
    exact log_le_utOf e.1 (by rw [heq]; exact hpprime.two_le)

end ThetaBracket

open ThetaBracket

theorem theta_bracket_finite_range : ∀ n : ℕ, 59 ≤ n → n ≤ 10 ^ 5 →
    (if n ≤ 100 then (79 / 100 : ℝ) else if n ≤ 150 then 84 / 100 else if n ≤ 250 then 86 / 100
      else if n ≤ 400 then 89 / 100 else if n ≤ 700 then 91 / 100 else if n ≤ 1100 then 93 / 100
      else if n ≤ 1530 then 94 / 100 else 96 / 100) * (n : ℝ) ≤ Chebyshev.theta (n : ℝ)
    ∧ Chebyshev.theta (n : ℝ) ≤ (n : ℝ) := by
  intro n h1 h2
  constructor
  · have hfl : brk n * n * 10^9 ≤ 100 * psumF ltOf CL n := finite_lower n h1 h2
    have hpl : (psumF ltOf CL n : ℝ) ≤ 10^9 * Chebyshev.theta (n : ℝ) := psumL_le_theta n h2
    have hfl' : (brk n : ℝ) * n * 10^9 ≤ 100 * (psumF ltOf CL n : ℝ) := by exact_mod_cast hfl
    have hcn : (brk n : ℝ) / 100 * n ≤ Chebyshev.theta (n : ℝ) := by
      nlinarith [hfl', hpl]
    rw [brk_div_cast n] at hcn
    exact hcn
  · have hfu : psumF utOf CU n ≤ 10^9 * n := finite_upper n h1 h2
    have hpu : 10^9 * Chebyshev.theta (n : ℝ) ≤ (psumF utOf CU n : ℝ) := theta_le_psumU n h2
    have hfu' : (psumF utOf CU n : ℝ) ≤ 10^9 * n := by exact_mod_cast hfu
    linarith [hpu, hfu']

end Commons.NumberTheory.Chebyshev

