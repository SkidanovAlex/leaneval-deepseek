/-! ### Rational bounds on `Real.log` -/

lemma log2_ge : (693147000 : ℝ) ≤ 10^9 * Real.log 2 := by
  have h := Real.log_two_gt_d9; nlinarith

lemma log2_le : 10^9 * Real.log 2 ≤ (693160000 : ℝ) := by
  have h := Real.log_two_lt_d9; nlinarith

lemma log_le_sinh_log {r : ℝ} (hr : 1 ≤ r) : Real.log r ≤ (r - r⁻¹)/2 := by
  have h0 : 0 ≤ Real.log r := Real.log_nonneg hr
  have h := (Real.self_le_sinh_iff).mpr h0
  have hr0 : 0 < r := by linarith
  have hsinh : Real.sinh (Real.log r) = (r - r⁻¹)/2 := by
    rw [Real.sinh_eq, Real.exp_log hr0, Real.exp_neg, Real.exp_log hr0]
  rwa [hsinh] at h

lemma le_div_ceil (a b : ℕ) (hb : 0 < b) : (a:ℝ)/b ≤ (((a + b - 1)/b : ℕ) : ℝ) := by
  rw [div_le_iff₀ (by exact_mod_cast hb : (0:ℝ) < (b:ℝ))]
  have h1 : a ≤ ((a + b - 1)/b) * b := by
    have h2 : (a + b - 1) % b < b := Nat.mod_lt _ hb
    have h3 : b * ((a + b - 1)/b) + (a + b - 1) % b = a + b - 1 := Nat.div_add_mod _ _
    have : a ≤ b * ((a + b - 1)/b) := by omega
    rwa [Nat.mul_comm] at this
  calc (a:ℝ) ≤ (((a + b - 1)/b : ℕ):ℝ) * (b:ℝ) := by exact_mod_cast h1

lemma div_floor_le (a b : ℕ) (hb : 0 < b) : ((a / b : ℕ) : ℝ) ≤ (a:ℝ)/b := by
  rw [le_div_iff₀ (by exact_mod_cast hb : (0:ℝ) < (b:ℝ))]
  calc (((a/b : ℕ)):ℝ) * (b:ℝ) = ((a/b * b : ℕ):ℝ) := by push_cast; ring
    _ ≤ (a:ℝ) := by exact_mod_cast Nat.div_mul_le_self a b

lemma two_pow_log2_le (p : ℕ) (hp : 2 ≤ p) : 2 ^ Nat.log2 p ≤ p := by
  have hp0 : p ≠ 0 := by omega
  rw [Nat.log2_eq_log_two]; exact Nat.pow_log_le_self 2 hp0

lemma lt_two_mul_pow_log2 (p : ℕ) (hp : 2 ≤ p) : p < 2 * 2 ^ Nat.log2 p := by
  have h := Nat.lt_pow_succ_log_self (b := 2) (by norm_num : 1 < 2) p
  rw [← Nat.log2_eq_log_two] at h
  calc p < 2 ^ (Nat.log2 p).succ := h
    _ = 2 * 2 ^ Nat.log2 p := by rw [pow_succ, Nat.mul_comm]

/-- Generic lower bound for `log p` with denominator `10^9`. -/
def ltOf (p : ℕ) : ℕ :=
  Nat.log2 p * 693147000 +
    (10 ^ 9 * (8 * (p - 2 ^ Nat.log2 p) *
      (p * p + p * (2 ^ Nat.log2 p) + (2 ^ Nat.log2 p) * (2 ^ Nat.log2 p)))) /
      (3 * (p + 2 ^ Nat.log2 p) ^ 3)

/-- Generic upper bound for `log p` with denominator `10^9`. -/
def utOf (p : ℕ) : ℕ :=
  Nat.log2 p * 693160000 +
    (10 ^ 9 * (p * p - (2 ^ Nat.log2 p) * (2 ^ Nat.log2 p)) + 2 * p * (2 ^ Nat.log2 p) - 1) /
      (2 * p * (2 ^ Nat.log2 p))

lemma arctanh_partial_le_log (p : ℕ) (hp : 2 ≤ p) :
    2*(((p:ℝ) - ((2 ^ Nat.log2 p : ℕ):ℝ))/((p:ℝ) + ((2 ^ Nat.log2 p : ℕ):ℝ))) +
      (2/3)*(((p:ℝ) - ((2 ^ Nat.log2 p : ℕ):ℝ))/((p:ℝ) + ((2 ^ Nat.log2 p : ℕ):ℝ)))^3
      ≤ Real.log ((p:ℝ)/((2 ^ Nat.log2 p : ℕ):ℝ)) := by
  set m := 2 ^ Nat.log2 p with hm
  have hm0 : 0 < m := by rw [hm]; positivity
  have hmR : (0:ℝ) < m := by exact_mod_cast hm0
  have hmle : m ≤ p := by rw [hm]; exact two_pow_log2_le p hp
  set z : ℝ := ((p:ℝ) - m) / ((p:ℝ) + m) with hz
  have hz0 : 0 ≤ z := by
    rw [hz]; apply div_nonneg
    · exact sub_nonneg.mpr (by exact_mod_cast hmle)
    · positivity
  have hz1 : z < 1 := by
    rw [hz, div_lt_one (by positivity : (0:ℝ) < (p:ℝ) + m)]
    linarith [hmR]
  have hzabs : |z| < 1 := by rw [abs_of_nonneg hz0]; exact hz1
  have hser := Real.hasSum_log_sub_log_of_abs_lt_one hzabs
  have hps : 2*z + (2/3)*z^3 ≤ Real.log (1 + z) - Real.log (1 - z) := by
    have h1 : (∑ j ∈ Finset.range 2, 2 * (1/(2*(j:ℝ)+1)) * z^(2*j+1)) ≤ Real.log (1 + z) - Real.log (1 - z) := by
      rw [← hser.tsum_eq]
      refine Summable.sum_le_tsum (Finset.range 2) ?_ hser.summable
      intro j hj
      exact mul_nonneg (by positivity) (pow_nonneg hz0 _)
    have hcalc : (∑ j ∈ Finset.range 2, 2 * (1/(2*(j:ℝ)+1)) * z^(2*j+1)) = 2*z + (2/3)*z^3 := by
      rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num
    linarith [hcalc ▸ h1]
  have hdiv : Real.log (1 + z) - Real.log (1 - z) = Real.log ((p:ℝ)/m) := by
    rw [← Real.log_div (by positivity : (1:ℝ)+z ≠ 0) (by positivity : (1:ℝ)-z ≠ 0)]
    congr 1
    rw [hz]; field_simp [ne_of_gt hmR]; ring
  rw [← hdiv]
  exact hps

lemma ltOf_le_log (p : ℕ) (hp : 2 ≤ p) : (ltOf p : ℝ) ≤ 10^9 * Real.log p := by
  have hpR : (0:ℝ) < (p:ℝ) := by exact_mod_cast (by omega : 0 < p)
  simp only [ltOf]
  set m := 2 ^ Nat.log2 p with hm
  set k := Nat.log2 p with hk
  have hm0 : 0 < m := by rw [hm]; positivity
  have hmle : m ≤ p := by rw [hm]; exact two_pow_log2_le p hp
  have hsub : ((p - m : ℕ) : ℝ) = (p:ℝ) - m := Nat.cast_sub hmle
  have hlogp : Real.log p = (k:ℝ) * Real.log 2 + Real.log ((p:ℝ)/m) := by
    rw [Real.log_div (by positivity) (by positivity)]
    have h2 : Real.log m = (k:ℝ) * Real.log 2 := by rw [hm]; push_cast; rw [Real.log_pow]
    linarith
  set Nnum := 8 * (p - m) * (p * p + p * m + m * m) with hNnum
  set Nden := 3 * (p + m) ^ 3 with hNden
  have hNdenpos : 0 < Nden := by rw [hNden]; positivity
  have hpmne : ((p:ℝ) + m) ≠ 0 := by positivity
  have hpart_eq : 2*(((p:ℝ) - m)/((p:ℝ) + m)) + (2/3)*(((p:ℝ) - m)/((p:ℝ) + m))^3 = (Nnum:ℝ)/(Nden:ℝ) := by
    rw [hNnum, hNden]
    push_cast
    rw [hsub]
    field_simp [hpmne]
    ring
  have hsplit : (ltOf p : ℕ) = k * 693147000 + (10^9 * Nnum) / Nden := by
    simp only [ltOf, ← hm, ← hk, ← hNnum, ← hNden]
  have hfloor : ((ltOf p : ℕ) : ℝ) ≤ (k:ℝ)*693147000 + 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) := by
    rw [hsplit]
    have hkcast : ((k * 693147000 : ℕ) : ℝ) = (k:ℝ) * 693147000 := by push_cast; ring
    rw [Nat.cast_add, hkcast]
    have h1 : (((10^9 * Nnum) / Nden : ℕ) : ℝ) ≤ 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) := by
      calc (((10^9 * Nnum) / Nden : ℕ) : ℝ) ≤ ((10^9 * Nnum : ℕ) : ℝ) / (Nden:ℝ) := div_floor_le _ _ hNdenpos
        _ = 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) := by push_cast; ring
    linarith
  have hup : (k:ℝ)*693147000 + 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) ≤ 10^9 * Real.log p := by
    have hk0 : (0:ℝ) ≤ (k:ℝ) := by positivity
    have h1 : (k:ℝ)*693147000 ≤ (k:ℝ) * (10^9 * Real.log 2) :=
      mul_le_mul_of_nonneg_left log2_ge hk0
    have h3 : 2*(((p:ℝ) - m)/((p:ℝ) + m)) + (2/3)*(((p:ℝ) - m)/((p:ℝ) + m))^3 ≤ Real.log ((p:ℝ)/m) :=
      arctanh_partial_le_log p hp
    have h4 : 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) ≤ 10^9 * Real.log ((p:ℝ)/m) := by
      rw [← hpart_eq]; exact mul_le_mul_of_nonneg_left h3 (by norm_num)
    rw [hlogp]
    nlinarith [h1, h4]
  exact le_trans hfloor hup

lemma log_le_utOf (p : ℕ) (hp : 2 ≤ p) : 10^9 * Real.log p ≤ (utOf p : ℝ) := by
  have hpR : (0:ℝ) < (p:ℝ) := by exact_mod_cast (by omega : 0 < p)
  simp only [utOf]
  set m := 2 ^ Nat.log2 p with hm
  set k := Nat.log2 p with hk
  have hm0 : 0 < m := by rw [hm]; positivity
  have hmR : (0:ℝ) < m := by exact_mod_cast hm0
  have hmle : m ≤ p := by rw [hm]; exact two_pow_log2_le p hp
  have hlogp : Real.log p = (k:ℝ) * Real.log 2 + Real.log ((p:ℝ)/m) := by
    rw [Real.log_div (by positivity) (by positivity)]
    have h2 : Real.log m = (k:ℝ) * Real.log 2 := by rw [hm]; push_cast; rw [Real.log_pow]
    linarith
  have hrm : 1 ≤ (p:ℝ)/m := by
    rw [le_div_iff₀ hmR, one_mul]
    exact_mod_cast hmle
  have hlog_le : Real.log ((p:ℝ)/m) ≤ ((p:ℝ)^2 - m^2)/(2*(p:ℝ)*m) := by
    have h := log_le_sinh_log hrm
    have heq : (((p:ℝ)/m) - ((p:ℝ)/m)⁻¹)/2 = ((p:ℝ)^2 - m^2)/(2*(p:ℝ)*m) := by
      field_simp [ne_of_gt hmR]
    linarith [heq ▸ h]
  have hmm : ((p*p - m*m : ℕ) : ℝ) = (p:ℝ)^2 - m^2 := by
    have h1 : m*m ≤ p*p := Nat.mul_le_mul hmle hmle
    rw [Nat.cast_sub h1]; push_cast; ring
  set Nnum := p*p - m*m with hNnum
  set Nden := 2*p*m with hNden
  have hNdenpos : 0 < Nden := by rw [hNden]; positivity
  have hlogexpr : Real.log ((p:ℝ)/m) ≤ (Nnum:ℝ)/(Nden:ℝ) := by
    rw [hmm, hNden]
    push_cast
    exact hlog_le
  have hbound : 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) ≤ (((10^9 * Nnum + Nden - 1)/Nden : ℕ) : ℝ) := by
    have h := le_div_ceil (10^9 * Nnum) Nden hNdenpos
    have heq : ((10^9 * Nnum : ℕ) : ℝ) / (Nden:ℝ) = 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) := by push_cast; ring
    rwa [heq] at h
  rw [hlogp]
  have hk0 : (0:ℝ) ≤ (k:ℝ) := by positivity
  have h1 : (k:ℝ) * (10^9 * Real.log 2) ≤ (k:ℝ) * 693160000 :=
    mul_le_mul_of_nonneg_left log2_le hk0
  have h2 : 10^9 * Real.log ((p:ℝ)/m) ≤ 10^9 * ((Nnum:ℝ)/(Nden:ℝ)) :=
    mul_le_mul_of_nonneg_left hlogexpr (by norm_num)
  push_cast
  linarith [h1, h2, hbound]
