import Submission.ZagierHoffmanProof.ABPAssemble

/-!
# The Anderson–Brownawell–Papanikolas criterion with small coefficients

The ABP criterion (`ABP_criterion`) produces a polynomial row vector `P` with coefficients in the
ambient field `L`.  For the `K̄`-descent of Dac §5.2 / Chang (Prop. 4.3.1) one needs the sharper
statement that `P` can be chosen with coefficients in the **perfect closure** of `K = F_q(θ)`
inside `L`, i.e. in `⋃_ν F_q(θ_ν)`.

This file provides:

* `ambKperf`, the subfield `K^{perf} = ⋃_ν F_q(θ_ν) ⊆ L`;
* the coefficient-membership lemmas for `frobTwist`/`keyProdPoly`/`finalP`;
* ★★ `ABP_criterion_kperf`, the criterion with the additional conclusion that the coefficients of
  `P` lie in `K^{perf}`.
-/

set_option autoImplicit false
open Polynomial Matrix
open scoped WithZero Topology

namespace ZagierHoffmanPositiveChar

variable (F : Type*) [Field F] [Finite F]

/-! ## §1. The subfield `K^{perf} = ⋃_ν F_q(θ_ν)` -/

/-- `K^{perf}`, the subfield of the ambient field generated by the constant field and all the
`q`-th roots `θ_ν` of `θ`. -/
noncomputable def ambKperf : Subfield (Ambient F) :=
  Subfield.closure (Set.range (ambCoeff F) ∪ Set.range (ambThetaNu F))

lemma ambThetaNu_mem_ambKperf (ν : ℕ) : ambThetaNu F ν ∈ ambKperf F :=
  Subfield.subset_closure (Or.inr ⟨ν, rfl⟩)

lemma ambCoeff_mem_ambKperf (c : F) : ambCoeff F c ∈ ambKperf F :=
  Subfield.subset_closure (Or.inl ⟨c, rfl⟩)

lemma ambTheta_mem_ambKperf : ambTheta F ∈ ambKperf F := by
  rw [← ambThetaNu_pow F 0, pow_zero, pow_one]
  exact ambThetaNu_mem_ambKperf F 0

/-- The evaluation of a polynomial with coefficients in `K^{perf}` at a point of `K^{perf}` stays
in `K^{perf}`. -/
lemma Polynomial.eval_mem_ambKperf {p : Polynomial (Ambient F)}
    (hp : ∀ m, p.coeff m ∈ ambKperf F) {x : Ambient F} (hx : x ∈ ambKperf F) :
    p.eval x ∈ ambKperf F := by
  rw [Polynomial.eval_eq_sum_range]
  exact Subfield.sum_mem _ fun i _ => Subfield.mul_mem _ (hp i) (Subfield.pow_mem _ hx i)

/-- `A_ν = F_q[θ_ν] ⊆ K^{perf}`. -/
lemma ambA_subset_ambKperf (ν : ℕ) : ambA F ν ⊆ (ambKperf F : Set (Ambient F)) := by
  intro x hx
  obtain ⟨p, rfl⟩ := (mem_ambA_iff F ν x).mp hx
  rw [Polynomial.eval₂_eq_sum_range]
  refine Subfield.sum_mem _ fun i _ => Subfield.mul_mem _ ?_ (Subfield.pow_mem _ ?_ i)
  · exact ambCoeff_mem_ambKperf F (p.coeff i)
  · exact ambThetaNu_mem_ambKperf F ν

/-! ## §2. Coefficient membership of the twisted products -/

/-- The Frobenius twist of a polynomial with `A_ν`-coefficients again has `A_ν`-coefficients. -/
lemma polyTwist_coeff_mem_ambA {ν : ℕ} {p : Polynomial (Ambient F)}
    (hp : ∀ m, p.coeff m ∈ ambA F ν) (j : ℕ) :
    ∀ m, (polyTwist (q := Nat.card F) j p).coeff m ∈ ambA F ν := by
  intro m
  rw [polyTwist, polyTwistHom_apply, Polynomial.coeff_map, frobPowHom_apply]
  exact ambA_pow_card_pow_mem F (hp m) j

/-- `keyProdPoly` of an `A_ν`-matrix has `A_ν`-coefficients. -/
lemma keyProdPoly_coeff_mem_ambA {ℓ : ℕ} {ν : ℕ}
    {Θ : Matrix (Fin ℓ) (Fin ℓ) (Polynomial (Ambient F))}
    (hΘ : ∀ i j m, (Θ i j).coeff m ∈ ambA F ν) (M : ℕ) :
    ∀ i j m, (keyProdPoly (q := Nat.card F) Θ M i j).coeff m ∈ ambA F ν := by
  induction M with
  | zero =>
    intro i j m
    rw [keyProdPoly_zero]
    by_cases h : i = j
    · subst h
      rw [Matrix.one_apply_eq, Polynomial.coeff_one]
      split_ifs with hm
      · exact ambA_one_mem F ν
      · exact (mem_ambA_iff F ν 0).mpr ⟨0, by simp⟩
    · rw [Matrix.one_apply_ne h, Polynomial.coeff_zero]
      exact (mem_ambA_iff F ν 0).mpr ⟨0, by simp⟩
  | succ M ih =>
    intro i j m
    rw [keyProdPoly_succ, Matrix.mul_apply, Polynomial.finsetSum_coeff]
    refine ambA_sum_mem F fun x _ => ?_
    rw [Polynomial.coeff_mul]
    refine ambA_sum_mem F fun y _ => ?_
    refine ambA_mul_mem F ?_ (ih x j y.2)
    simp only [RingHom.mapMatrix_apply, Matrix.map_apply, polyTwistHom_apply,
      Polynomial.coeff_map, frobPowHom_apply]
    exact ambA_pow_card_pow_mem F (hΘ i x y.1) (M + 1)

/-- `finalP` of an `A_ν`-matrix and `A_ν`-coefficient vector has `A_ν`-coefficients. -/
lemma finalP_coeff_mem_ambA {ℓ : ℕ} {ν : ℕ}
    {Θ : Matrix (Fin ℓ) (Fin ℓ) (Polynomial (Ambient F))}
    (hΘ : ∀ i j m, (Θ i j).coeff m ∈ ambA F ν)
    {h : Fin ℓ → Polynomial (Ambient F)} (hh : ∀ i m, (h i).coeff m ∈ ambA F ν) (M : ℕ) :
    ∀ j m, (finalP (q := Nat.card F) Θ h M j).coeff m ∈ ambA F ν := by
  intro j m
  rw [finalP, Polynomial.finsetSum_coeff]
  refine ambA_sum_mem F fun i _ => ?_
  rw [Polynomial.coeff_mul]
  refine ambA_sum_mem F fun y _ => ?_
  exact ambA_mul_mem F (polyTwist_coeff_mem_ambA F (hh i) M y.1)
    (keyProdPoly_coeff_mem_ambA F hΘ M i j y.2)

/-! ## §3. The value step and the final assembly -/

/-- **The final value step of the ABP criterion**, with the coefficient membership preserved:
if `P ψ = 0`, `P(θ) ≠ 0`, `P(θ) ϑ = 0` and all the coefficients of `P` lie in `K^{perf}`, then
after rescaling `P` by a unit of `K^{perf}` we obtain `P'` with `P' ψ = 0`, `P'(θ) = ρ` and again
`K^{perf}`-coefficients. -/
theorem final_value_step_kperf {ℓ : ℕ} (hℓ : 2 ≤ ℓ)
    {ϑ : Matrix (Fin ℓ) (Fin (ℓ - 1)) (Ambient F)}
    (hind : LinearIndependent (Ambient F) (fun i : Fin (ℓ - 1) => fun j : Fin ℓ => ϑ j i))
    {ρ : Fin ℓ → Ambient F} (hρ : Matrix.vecMul ρ ϑ = 0) (hρ0 : ρ ≠ 0)
    {θ : Ambient F} (hθ : θ ∈ ambKperf F)
    {ψ : Fin ℓ → PowerSeries (Ambient F)} {P : Fin ℓ → Polynomial (Ambient F)}
    (hPψ : ∑ j, ((P j : Polynomial (Ambient F)) : PowerSeries (Ambient F)) * ψ j = 0)
    (hPϑ : Matrix.vecMul (fun j => (P j).eval θ) ϑ = 0)
    (hP0 : (fun j => (P j).eval θ) ≠ 0)
    (hPmem : ∀ j m, (P j).coeff m ∈ ambKperf F) (hρmem : ∀ j, ρ j ∈ ambKperf F) :
    ∃ P' : Fin ℓ → Polynomial (Ambient F),
      (∑ j, ((P' j : Polynomial (Ambient F)) : PowerSeries (Ambient F)) * ψ j = 0) ∧
      (∀ j, (P' j).eval θ = ρ j) ∧ (∀ j m, (P' j).coeff m ∈ ambKperf F) := by
  classical
  obtain ⟨lam, hlam⟩ :=
    Commons.LinearAlgebra.Matrix.exists_smul_of_mul_eq_zero hℓ hind hρ hρ0 hPϑ
  have hlam0 : lam ≠ 0 := by
    intro h0
    apply hP0
    funext j
    simp [congrFun hlam j, h0]
  obtain ⟨j0, hj0⟩ : ∃ j, ρ j ≠ 0 := by
    by_contra hcon
    rw [not_exists] at hcon
    exact hρ0 (funext fun j => not_not.mp (hcon j))
  have hlam_eq : lam = (P j0).eval θ / ρ j0 := by
    have h := congrFun hlam j0
    rw [Pi.smul_apply, smul_eq_mul] at h
    rw [h, mul_div_assoc, div_self hj0, mul_one]
  have hPmem_eval : (P j0).eval θ ∈ ambKperf F :=
    Polynomial.eval_mem_ambKperf F (hPmem j0) hθ
  have hlam_mem : lam ∈ ambKperf F := by
    rw [hlam_eq]
    exact Subfield.div_mem _ hPmem_eval (hρmem j0)
  have hlinv_mem : lam⁻¹ ∈ ambKperf F := Subfield.inv_mem _ hlam_mem
  refine ⟨fun j => Polynomial.C lam⁻¹ * P j, ?_, ?_, ?_⟩
  · have h1 : (∑ j, (((Polynomial.C lam⁻¹ * P j : Polynomial (Ambient F))) :
          PowerSeries (Ambient F)) * ψ j)
        = (Polynomial.C lam⁻¹ : PowerSeries (Ambient F))
          * ∑ j, ((P j : Polynomial (Ambient F)) : PowerSeries (Ambient F)) * ψ j := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Polynomial.coe_mul, Polynomial.coe_C]
      ring
    rw [h1, hPψ, mul_zero]
  · intro j
    rw [Polynomial.eval_mul, Polynomial.eval_C]
    have h := congrFun hlam j
    rw [Pi.smul_apply, smul_eq_mul] at h
    rw [h, ← mul_assoc, inv_mul_cancel₀ hlam0, one_mul]
  · intro j m
    rw [Polynomial.coeff_C_mul]
    exact Subfield.mul_mem _ hlinv_mem (hPmem j m)

/-- **The final assembly of the ABP criterion** with `A_ν`-coefficients for the vanishing function
and the `K^{perf}`-membership of the output. -/
theorem criterion_final_kperf {ℓ : ℕ} (hℓ : 2 ≤ ℓ) {ν : ℕ}
    {Φ : Matrix (Fin ℓ) (Fin ℓ) (Polynomial (Ambient F))}
    (hΘ : ∀ i j m, (Φ.adjugate i j).coeff m ∈ ambA F ν)
    {ψ : Fin ℓ → PowerSeries (Ambient F)}
    (hfe : ψ = (frobTwistMat (q := Nat.card F) 1 ((coeHom (K := Ambient F)).mapMatrix Φ)).mulVec
      (frobTwistVec (q := Nat.card F) 1 ψ))
    {ϑ : Matrix (Fin ℓ) (Fin (ℓ - 1)) (Ambient F)}
    (hind : LinearIndependent (Ambient F) (fun i : Fin (ℓ - 1) => fun j : Fin ℓ => ϑ j i))
    {ρ : Fin ℓ → Ambient F} (hρ : Matrix.vecMul ρ ϑ = 0) (hρ0 : ρ ≠ 0)
    (hρmem : ∀ j, ρ j ∈ ambKperf F)
    {h : Fin ℓ → Polynomial (Ambient F)} {M : ℕ}
    (hhmem : ∀ j m, (h j).coeff m ∈ ambA F ν)
    (hE : ∑ i, coeHom (K := Ambient F) (h i) * ψ i = 0)
    (haux : Matrix.vecMul
      (fun j => (finalP (q := Nat.card F) Φ.adjugate h M j).eval (ambTheta F)) ϑ = 0)
    (hne : (fun j => (finalP (q := Nat.card F) Φ.adjugate h M j).eval (ambTheta F)) ≠ 0) :
    ∃ P : Fin ℓ → Polynomial (Ambient F),
      (∑ j, coeHom (K := Ambient F) (P j) * ψ j = 0) ∧
      (∀ j, (P j).eval (ambTheta F) = ρ j) ∧ (∀ j m, (P j).coeff m ∈ ambKperf F) := by
  classical
  have hPmem_ambA : ∀ j m, (finalP (q := Nat.card F) Φ.adjugate h M j).coeff m ∈ ambA F ν :=
    finalP_coeff_mem_ambA F hΘ hhmem M
  exact final_value_step_kperf F hℓ hind hρ hρ0 (ambTheta_mem_ambKperf F)
    (finalP_spec (q := Nat.card F) (Matrix.adjugate_mul Φ) hfe hE) haux hne
    (fun j m => ambA_subset_ambKperf F ν (hPmem_ambA j m)) hρmem

/-! ## §4. The criterion with `K^{perf}`-coefficients -/

/-- ★★ **The Anderson–Brownawell–Papanikolas criterion**, with the coefficients of the output
vector lying in the perfect closure `K^{perf}` of `K`. -/
theorem ABP_criterion_kperf {ℓ : ℕ} (ν : ℕ) (hℓ : 2 ≤ ℓ)
    {Φ : Matrix (Fin ℓ) (Fin ℓ) (Polynomial (Ambient F))}
    (hΦ : ∀ i j m, (Φ i j).coeff m ∈ ambA F ν)
    {ϑ : Matrix (Fin ℓ) (Fin (ℓ - 1)) (Ambient F)} (hϑ : ∀ i j, ϑ i j ∈ ambA F ν)
    {γ : ℚᵐ⁰} (hγ0 : 0 < γ) (hγ : γ < 1)
    {ψ : Fin ℓ → PowerSeries (Ambient F)} (hse : ∀ i, GSuperEntire γ (ψ i))
    (hfe : ψ = (frobTwistMat (q := Nat.card F) 1 ((coeHom (K := Ambient F)).mapMatrix Φ)).mulVec
      (frobTwistVec (q := Nat.card F) 1 ψ))
    (hind : LinearIndependent (Ambient F) (fun i : Fin (ℓ - 1) => fun j : Fin ℓ => ϑ j i))
    {ρ : Fin ℓ → Ambient F} (hρ : Matrix.vecMul ρ ϑ = 0) (hρ0 : ρ ≠ 0)
    (hρmem : ∀ j, ρ j ∈ ambKperf F)
    (hval : dotProduct ρ (fun i => evalSeriesGen (ψ i) (ambTheta F)) = 0)
    {c : Ambient F} (hc : c ≠ 0) {s : ℕ}
    (hdet : Φ.det = Polynomial.C c * (Polynomial.X - Polynomial.C (ambTheta F)) ^ s) :
    ∃ P : Fin ℓ → Polynomial (Ambient F),
      (∑ j, coeHom (K := Ambient F) (P j) * ψ j = 0) ∧
      (∀ j, (P j).eval (ambTheta F) = ρ j) ∧ (∀ j m, (P j).coeff m ∈ ambKperf F) := by
  classical
  have hℓ1 : 1 ≤ ℓ := by omega
  have hΘ : ∀ i j m, (Φ.adjugate i j).coeff m ∈ ambA F ν :=
    fun i j m => adjugate_coeff_mem F hΦ i j m
  obtain ⟨Aψ, hAψpos, hAψ⟩ :=
    exists_gauss_bound_psi F hγ0 hγ (lt_trans zero_lt_one (one_lt_ambKappa F 0)) hse
  set cc : ℚ := 2 * ℓ * auxC F ν Φ.adjugate hΘ ϑ hϑ with hcc
  have hccpos : 0 < cc := by
    rw [hcc]
    exact mul_pos (mul_pos (by norm_num) (Nat.cast_pos.mpr (by omega))) (auxC_pos F ν _ hΘ ϑ hϑ)
  set cAb : ℚ := 2 * (ℓ : ℚ) * funcEqC F Φ cc + 2 * (ℓ : ℚ) * ((Nat.card F : ℚ) - 1) with hcAb
  obtain ⟨N₀, hN₀⟩ := exists_aux_N F (c := cc) (cAb := cAb) (Aψ := Aψ) hAψpos hℓ1
  set N : ℕ := max (4 * ℓ) (max N₀ 1) with hNdef
  have hN4 : 4 * ℓ ≤ N := by rw [hNdef]; exact le_max_left _ _
  have hN1 : 1 ≤ N := by
    rw [hNdef]
    exact le_trans (le_max_right N₀ 1) (le_max_right (4 * ℓ) (max N₀ 1))
  have hNge : N₀ ≤ N := by
    rw [hNdef]
    exact le_trans (le_max_left N₀ 1) (le_max_right (4 * ℓ) (max N₀ 1))
  obtain ⟨ν', h, hν', hh0, hhmem, hhdeg, hhsz, hhaux, hhne⟩ :=
    aux_function_exists F ν hℓ Φ.adjugate hΘ ϑ hϑ hN4
  have hνle : ν ≤ ν' := le_trans (Nat.le_add_right ν (2 * N)) hν'
  obtain ⟨b, hb0, hbmem, hbfun⟩ :=
    func_eq_exists F (ν := ν') hℓ1 (fun i j m => ambA_mono F hνle (hΦ i j m)) hfe hhmem
      hccpos hhsz
  obtain ⟨b', hb'0, hb'ne, hb'fun, hb'mem, hb'sz, _⟩ :=
    exists_no_t_factor F (ι := Fin (ℓ + 1)) (ν := ν')
      (Ab := (ambKappa F ν') ^ (2 * ℓ * funcEqMu F Φ cc ν'))
      (g := fun j => frobTwist (R := Ambient F) (p := Nat.card F) (j : ℕ)
        (∑ i, coeHom (K := Ambient F) (h i) * ψ i))
      (∑ j, (b j).natDegree) b rfl hb0 hbfun (fun j k => (hbmem j k).1) (fun j k => (hbmem j k).2)
  have hroot : ∀ i : Fin N, evalSeriesGen (∑ i, coeHom (K := Ambient F) (h i) * ψ i)
      (ambThetaNu F (N + (i : ℕ))) = 0 := by
    intro i
    exact eval_auxFun_thetaNu_eq_zero F hγ0 hγ hℓ hse hfe (by omega) hind hρ hρ0 hval
      (hhaux i) hc hdet
  have hAb : (ambKappa F ν') ^ (2 * ℓ * funcEqMu F Φ cc ν') ≤ WithZero.exp cAb := by
    rw [hcAb]
    exact ambKappa_funcEqMu_le F Φ (le_of_lt hccpos) ν'
  have hsmall0 := hN₀ N hNge
  have hsmall : (ambKappa F ν') ^ (2 * ℓ * funcEqMu F Φ cc ν')
      * (WithZero.exp cc * (ambKappa F 0) ^ (auxDeg N ℓ) * Aψ)
      * ((ambKappa F N) / (ambKappa F 0)) ^ N < 1 := by
    have hY : (0 : ℚᵐ⁰) ≤ WithZero.exp cc * (ambKappa F 0) ^ (auxDeg N ℓ) * Aψ :=
      mul_nonneg
        (mul_nonneg WithZero.exp_pos.le (pow_nonneg (zero_le : (0 : ℚᵐ⁰) ≤ ambKappa F 0) _))
        hAψpos.le
    have hW : (0 : ℚᵐ⁰) ≤ ((ambKappa F N) / (ambKappa F 0)) ^ N :=
      pow_nonneg (div_nonneg zero_le zero_le) N
    exact lt_of_le_of_lt
      (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hAb hY) hW) hsmall0
  have hE0 : (∑ i, coeHom (K := Ambient F) (h i) * ψ i) = 0 :=
    auxFun_eq_zero F hγ0 hγ hℓ hse hfe (fun j k => hhsz j k) (fun j => le_of_lt (hhdeg j))
      (fun j => one_le_v_of_mem_ambA F (hb'mem j 0)) (fun j => hb'sz j 0) hb'ne hb'fun
      hAψpos hAψ hN1 hroot hsmall
  obtain ⟨i0, j0, hj0⟩ := hhne
  have hM1 : 1 ≤ N + (i0 : ℕ) := by omega
  have hdetΘ : ∀ k, 1 ≤ k → ((Φ.adjugate).det).eval (ambThetaNu F k) ≠ 0 := by
    intro k hk
    rw [Matrix.det_adjugate, Polynomial.eval_pow]
    exact pow_ne_zero _ (det_eval_ne_zero F hc hdet hk)
  have hv : (fun i => (polyTwist (q := Nat.card F) (N + (i0 : ℕ)) (h i)).eval
      (ambTheta F)) ≠ 0 := by
    intro hcon
    have h1 : (polyTwist (q := Nat.card F) (N + (i0 : ℕ)) (h j0)).eval (ambTheta F) = 0 :=
      congrFun hcon j0
    rw [eval_polyTwist] at h1
    have hpow : Nat.card F ^ (N + (i0 : ℕ)) ≠ 0 :=
      pow_ne_zero (N + (i0 : ℕ)) (FrobPow.ne_zero (Ambient F) (q := Nat.card F))
    exact hj0 ((pow_eq_zero_iff hpow).mp h1)
  exact criterion_final_kperf F (ν := ν') hℓ
    (fun i j m => ambA_mono F hνle (hΘ i j m)) hfe hind hρ hρ0 hρmem (h := h) hhmem hE0
    (hhaux i0) (finalP_eval_ne_zero F hdetΘ hM1 hv)

end ZagierHoffmanPositiveChar
