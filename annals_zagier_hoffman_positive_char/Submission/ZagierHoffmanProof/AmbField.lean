import Submission.ZagierHoffmanProof.ABPKperf

/-!
# The subfields `F_q ⊆ K = F_q(θ) ⊆ K^{perf}` of the ambient field

`Ambient F` is the completion of the perfect closure of `F_q((y))`, with `θ = y^{-(q-1)}`.  Inside
it we single out

* `ambF`, the fixed field of the `q`-th power map (`= F_q`, the `F`-image), and
* `ambK`, the subfield generated by `F_q` and `θ` (`= K = F_q(θ)`),
* `ambKperf`, the perfect closure `K^{perf} = ⋃_ν F_q(θ_ν)` (defined in `ABPKperf`).

The main result is that `ambF` is the image of `F` under `ambCoeff`, which is what makes the
"fixed field of the Frobenius" argument (`fixed_of_map_mul_eq`) applicable.
-/

set_option autoImplicit false
open Polynomial Matrix
open scoped WithZero Topology

attribute [local instance] Fintype.ofFinite

namespace ZagierHoffmanPositiveChar

variable (F : Type*) [Field F] [Finite F]

/-! ## §1. The fixed field of the `q`-th power map -/

/-- The fixed field of the `q`-th power map on the ambient field. -/
noncomputable def ambF : Subfield (Ambient F) where
  carrier := {x | x ^ Nat.card F = x}
  zero_mem' := by
    haveI : FrobPow (Ambient F) (Nat.card F) := frobPow_ambient F
    show (0 : Ambient F) ^ Nat.card F = 0
    rw [zero_pow (FrobPow.ne_zero (Ambient F) (q := Nat.card F))]
  one_mem' := by
    show (1 : Ambient F) ^ Nat.card F = 1
    rw [one_pow]
  add_mem' := by
    haveI : FrobPow (Ambient F) (Nat.card F) := frobPow_ambient F
    intro x y hx hy
    show (x + y) ^ Nat.card F = x + y
    rw [FrobPow.add_pow, hx, hy]
  mul_mem' := by
    intro x y hx hy
    show (x * y) ^ Nat.card F = x * y
    rw [mul_pow, hx, hy]
  neg_mem' := by
    intro x hx
    show (-x) ^ Nat.card F = -x
    have h1 : (-1 : Ambient F) ^ Nat.card F = -1 := by
      rw [show (-1 : Ambient F) = ambCoeff F (-1) by simp, ambCoeff_pow_card]
    rw [neg_pow, hx, h1]
    ring
  inv_mem' := by
    intro x hx
    show (x⁻¹) ^ Nat.card F = x⁻¹
    rw [inv_pow, hx]

lemma mem_ambF_iff (x : Ambient F) : x ∈ ambF F ↔ x ^ Nat.card F = x := Iff.rfl

lemma ambCoeff_mem_ambF (c : F) : ambCoeff F c ∈ ambF F := ambCoeff_pow_card F c

/-- The image of `ambCoeff` is contained in the fixed field. -/
lemma range_ambCoeff_subset_ambF :
    Set.range (ambCoeff F) ⊆ (ambF F : Set (Ambient F)) :=
  fun _ ⟨c, hc⟩ => hc ▸ ambCoeff_mem_ambF F c

/-- The image of `ambCoeff` has exactly `q` elements. -/
lemma natCard_range_ambCoeff :
    Nat.card (Set.range (ambCoeff F)) = Nat.card F :=
  Nat.card_range_of_injective (ambCoeff F).injective

/-- **The fixed field of the `q`-th power map is exactly the image of `F`.** -/
theorem eq_range_ambCoeff_of_mem_ambF {x : Ambient F} (hx : x ∈ ambF F) :
    ∃ c : F, ambCoeff F c = x := by
  classical
  have hcard : 2 ≤ Nat.card F := two_le_card_field F
  have hdeg : (Polynomial.X ^ Nat.card F - Polynomial.X :
      Polynomial (Ambient F)).natDegree = Nat.card F := by
    have h1 : (Polynomial.X : Polynomial (Ambient F)).degree
        < (Polynomial.X ^ Nat.card F : Polynomial (Ambient F)).degree := by
      rw [Polynomial.degree_X_pow, Polynomial.degree_X]
      exact_mod_cast (show 1 < Nat.card F by omega)
    rw [Polynomial.natDegree_eq_of_degree_eq (Polynomial.degree_sub_eq_left_of_degree_lt h1),
      Polynomial.natDegree_X_pow]
  have hne : (Polynomial.X ^ Nat.card F - Polynomial.X : Polynomial (Ambient F)) ≠ 0 := by
    intro h0
    rw [h0, Polynomial.natDegree_zero] at hdeg
    omega
  -- the roots of `X ^ q - X` form a finite set containing the image of `ambCoeff`
  have hsub : (Finset.univ.image (ambCoeff F))
      ⊆ (Polynomial.X ^ Nat.card F - Polynomial.X : Polynomial (Ambient F)).roots.toFinset := by
    intro y hy
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp hy
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hne, Polynomial.IsRoot.def,
      Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, ambCoeff_pow_card, sub_self]
  have hle : (Finset.univ.image (ambCoeff F)).card
      ≤ ((Polynomial.X ^ Nat.card F - Polynomial.X :
        Polynomial (Ambient F)).roots.toFinset).card :=
    Finset.card_le_card hsub
  have h2 : ((Polynomial.X ^ Nat.card F - Polynomial.X :
      Polynomial (Ambient F)).roots.toFinset).card ≤ Nat.card F :=
    le_trans (Multiset.toFinset_card_le _) (le_trans (Polynomial.card_roots' _) (le_of_eq hdeg))
  have h3 : (Finset.univ.image (ambCoeff F)).card = Nat.card F := by
    rw [Finset.card_image_of_injective _ (ambCoeff F).injective, Finset.card_univ,
      Nat.card_eq_fintype_card]
  have heq := Finset.eq_of_subset_of_card_le hsub (by rw [h3]; exact h2)
  have hxroot : x ∈ (Polynomial.X ^ Nat.card F - Polynomial.X :
      Polynomial (Ambient F)).roots.toFinset := by
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hne, Polynomial.IsRoot.def,
      Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X]
    rw [mem_ambF_iff] at hx
    rw [hx, sub_self]
  rw [← heq] at hxroot
  obtain ⟨c, -, hc⟩ := Finset.mem_image.mp hxroot
  exact ⟨c, hc⟩

lemma range_ambCoeff_eq_ambF :
    Set.range (ambCoeff F) = (ambF F : Set (Ambient F)) :=
  Set.Subset.antisymm (range_ambCoeff_subset_ambF F) fun _ hx =>
    eq_range_ambCoeff_of_mem_ambF F hx

/-! ## §2. The field `K = F_q(θ)` inside the ambient field -/

/-- The subfield `K = F_q(θ)` of the ambient field. -/
noncomputable def ambK : Subfield (Ambient F) :=
  Subfield.closure (Set.range (ambCoeff F) ∪ {ambTheta F})

lemma ambTheta_mem_ambK : ambTheta F ∈ ambK F :=
  Subfield.subset_closure (Or.inr rfl)

lemma ambCoeff_mem_ambK (c : F) : ambCoeff F c ∈ ambK F :=
  Subfield.subset_closure (Or.inl ⟨c, rfl⟩)

lemma ambF_le_ambK : ambF F ≤ ambK F := by
  intro x hx
  obtain ⟨c, hc⟩ := eq_range_ambCoeff_of_mem_ambF F hx
  rw [← hc]
  exact ambCoeff_mem_ambK F c

lemma ambA_zero_subset_ambK : ambA F 0 ⊆ (ambK F : Set (Ambient F)) := by
  intro x hx
  obtain ⟨p, rfl⟩ := (mem_ambA_iff F 0 x).mp hx
  rw [Polynomial.eval₂_eq_sum_range]
  refine Subfield.sum_mem _ fun i _ => Subfield.mul_mem _ ?_ (Subfield.pow_mem _ ?_ i)
  · exact ambCoeff_mem_ambK F (p.coeff i)
  · rw [show ambThetaNu F 0 = ambTheta F by rw [← ambThetaNu_pow F 0, pow_zero, pow_one]]
    exact ambTheta_mem_ambK F

end ZagierHoffmanPositiveChar
