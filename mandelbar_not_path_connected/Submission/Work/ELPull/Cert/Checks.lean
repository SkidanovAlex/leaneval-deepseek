/-! ## C7: the arm rotation under `F = T¹⁰` -/

/-- `T¹⁰ = F` maps the boundary rays of the arm `A` onto those of the arm `C`, modulo `1`. -/
theorem armRot_boundary_0 :
  (Tq^[10] (arm 0).1 = (arm 2).1 ∨ Tq^[10] (arm 0).1 = (arm 2).1 - 1) ∧
      (Tq^[10] (arm 0).2 = (arm 2).2 ∨ Tq^[10] (arm 0).2 = (arm 2).2 - 1)
  := by
  simp only [arm_val_0, arm_val_2]
  refine ⟨?_, ?_⟩
  · left
    rw [Tq_iterate_qq_of 10 22 37 63 (by decide) (by decide)] <;> norm_num
  · right
    rw [Tq_iterate_qq_of 10 25 22 63 (by decide) (by decide)] <;> norm_num

/-- `T¹⁰ = F` maps the boundary rays of the arm `B` onto those of the arm `A`, modulo `1`. -/
theorem armRot_boundary_1 :
  (Tq^[10] (arm 1).1 = (arm 0).1 ∨ Tq^[10] (arm 1).1 = (arm 0).1 - 1) ∧
      (Tq^[10] (arm 1).2 = (arm 0).2 ∨ Tq^[10] (arm 1).2 = (arm 0).2 - 1)
  := by
  simp only [arm_val_1, arm_val_0]
  refine ⟨?_, ?_⟩
  · left
    rw [Tq_iterate_qq_of 10 25 22 63 (by decide) (by decide)] <;> norm_num
  · left
    rw [Tq_iterate_qq_of 10 37 25 63 (by decide) (by decide)] <;> norm_num

/-- `T¹⁰ = F` maps the boundary rays of the arm `C` onto those of the arm `B`, modulo `1`. -/
theorem armRot_boundary_2 :
  (Tq^[10] (arm 2).1 = (arm 1).1 ∨ Tq^[10] (arm 2).1 = (arm 1).1 - 1) ∧
      (Tq^[10] (arm 2).2 = (arm 1).2 ∨ Tq^[10] (arm 2).2 = (arm 1).2 - 1)
  := by
  simp only [arm_val_2, arm_val_1]
  refine ⟨?_, ?_⟩
  · left
    rw [Tq_iterate_qq_of 10 37 25 63 (by decide) (by decide)] <;> norm_num
  · left
    rw [show (qq 85 63 : ℚ) = qq 22 63 + (1 : ℤ) by norm_num, Tq_iterate_add_int, Tq_iterate_qq_of 10 22 37 63 (by decide) (by decide)] <;> norm_num

/-- `F = T¹⁰` permutes the arm boundary rays by `armRot` (modulo `1`). -/
theorem armRot_boundary (Z : Fin 3) :
  (Tq^[10] (arm Z).1 = (arm (armRot Z)).1 ∨ Tq^[10] (arm Z).1 = (arm (armRot Z)).1 - 1) ∧
      (Tq^[10] (arm Z).2 = (arm (armRot Z)).2 ∨ Tq^[10] (arm Z).2 = (arm (armRot Z)).2 - 1)
  := by
  fin_cases Z
  · exact armRot_boundary_0
  · exact armRot_boundary_1
  · exact armRot_boundary_2

