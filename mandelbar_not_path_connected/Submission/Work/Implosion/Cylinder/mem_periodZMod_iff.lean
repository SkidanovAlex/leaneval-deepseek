Copyright: subproject `Submission/Work/Implosion/` of `mandelbar_not_path_connected`.

# The period lattice of the Écalle coordinate is `(πi/a)ℤ`

`Work.Implosion.periodZMod a = AddSubgroup.zmultiples (πi / a)` is the additive
subgroup of `ℂ` generated by the period `πi/a` of the Écalle coordinate, i.e. the
set of *punctures* (ends) of the Écalle cylinder.  By definition of the Écalle
multiplier coordinate `ecalE a u = exp (2 a u)`, this subgroup is exactly the
kernel of the projection `u ↦ ecalE a u`, i.e.

  `u ∈ periodZMod a ↔ ecalE a u = 1`

for `a ≠ 0`.  This is the reformulation (in terms of the `AddSubgroup` used
downstream) of the kernel computation `mem_periodLattice_iff` of `Ecalle.lean`.

It is used whenever a point of the cylinder has to be moved by a period of the
Écalle coordinate without changing the multiplier.
-/
import Mathlib
import Submission.Work.Implosion.Basic
import Submission.Work.Implosion.Ecalle
import Submission.Work.Implosion.Cylinder

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.Implosion.Cylinder

/-- Membership in `periodZMod a` is membership in the lattice `(πi/a)ℤ` generated
by the period `πi/a`. -/
theorem mem_periodZMod_iff_exists (a u : ℂ) :
    u ∈ periodZMod a ↔ ∃ n : ℤ, u = n * (Real.pi * Complex.I / a) := by
  rw [periodZMod, AddSubgroup.mem_zmultiples_iff]
  simp only [zsmul_eq_mul, eq_comm]

/-- **The period lattice is the kernel of the multiplier coordinate.**  A complex
number `u` is a period of the Écalle coordinate of `a`, i.e. `u ∈ (πi/a)ℤ`, if and
only if it does not change the multiplier: `e^{2au} = 1`. -/
theorem mem_periodZMod_iff (a u : ℂ) (ha : a ≠ 0) :
    u ∈ periodZMod a ↔ ecalE a u = 1 := by
  rw [mem_periodZMod_iff_exists a u, ecalE_eq_one_iff a u, mem_periodLattice_iff a u ha]

end Work.Implosion.Cylinder
