# The Écalle cylinder (HS Prop. 4.2, Lemma 4.3) and the transit map

The quotient of the fundamental domain of `Geometry.lean` by the dynamics is the
**Écalle cylinder** of the implosion.  Hubbard–Schleicher prove (Prop. 4.2 and the
Lemma 4.3 that follows it) that these cylinders are *bi-infinite annuli*,
`≅ ℂ/ℤ` — the two ends being the two fixed points `±a` of the normal form.

This file sets up

* the orbit relation `orbitRel f A` and the quotient `EcalleCylinder f A`;
* the **transit map** `transitMap`, induced by one iterate of `f`;
* the exact **model** of `ℂ/ℤ`: the slab `{x ≤ Re u < x+1}` modulo the translation
  `u ↦ u + 1`, realised as `ℂ^*` by `u ↦ e^{2πi u}`;
* the arithmetic fact that the period lattice of the Écalle coordinate,
  `(πi/a)ℤ`, is `ℤ`-equivariantly equivalent to `ℤ ⊂ ℂ` after rescaling — so the
  implosion cylinder is the `ℂ/ℤ` of the paper, `π/‖a‖` in coordinate size.
-/
import Submission.Work.Implosion.Ecalle
import Submission.Work.Implosion.Disp
import Submission.Work.Implosion.Geometry
import Submission.Work.Implosion.Ecalle.ecalleHeight_eq_zero

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.Implosion

open Complex

/-! ## The orbit relation and the cylinder -/

/-- The equivalence relation generated by `f` inside `A`: two points are equivalent
when they lie on a common finite orbit all of whose points are in `A`. -/
def orbitRel (f : ℂ → ℂ) (A : Set ℂ) (x y : ℂ) : Prop :=
  ∃ n : ℕ, (y = f^[n] x ∧ ∀ k ≤ n, f^[k] x ∈ A) ∨ (x = f^[n] y ∧ ∀ k ≤ n, f^[k] y ∈ A)

/-- The **Écalle cylinder** of the implosion: the fundamental domain modulo the
dynamics. -/
def EcalleCylinder (f : ℂ → ℂ) (A : Set ℂ) : Type := Quot (orbitRel f A)

theorem orbitRel_refl (f : ℂ → ℂ) (A : Set ℂ) (hA : A = Set.univ) (x : ℂ) :
    orbitRel f A x x := by
  subst hA
  exact ⟨0, Or.inl ⟨rfl, fun k _ => trivial⟩⟩

theorem orbitRel_symm (f : ℂ → ℂ) (A : Set ℂ) {x y : ℂ} (h : orbitRel f A x y) :
    orbitRel f A y x := by
  obtain ⟨n, hn | hn⟩ := h
  · exact ⟨n, Or.inr hn⟩
  · exact ⟨n, Or.inl hn⟩

/-! ## The model cylinder `ℂ/ℤ` -/

/-- The model Écalle cylinder: `ℂ` modulo the translation `u ↦ u + 1`, the `ℂ/ℤ`
of HS Prop. 4.2. -/
noncomputable abbrev ModelCylinder : Type := ℂ ⧸ AddSubgroup.zmultiples (1 : ℂ)

/-- The period lattice of the Écalle coordinate, inside `ℂ`. -/
noncomputable abbrev periodZMod (a : ℂ) : AddSubgroup ℂ := AddSubgroup.zmultiples (Real.pi * I / a)

/-- The **model cylinder theorem**: the slab `x ≤ Re u < x + 1` is a fundamental
domain for the translation `u ↦ u + 1`, i.e. every orbit meets it exactly once.  This
is the `ℂ/ℤ` of HS Prop. 4.2, and `exp_two_pi_I_strip_rep` computes the quotient as
`ℂ^*` via `u ↦ e^{2πi u}`. -/
theorem existsUnique_translate_mem_slab (u : ℂ) (x : ℝ) :
    ∃! k : ℤ, x ≤ (u + k).re ∧ (u + k).re < x + 1 := by
  refine ⟨⌈x - u.re⌉, ⟨?_, ?_⟩, ?_⟩
  · have h := Int.le_ceil (x - u.re)
    simp only [Complex.add_re, Complex.intCast_re]
    linarith
  · have h := Int.ceil_lt_add_one (x - u.re)
    simp only [Complex.add_re, Complex.intCast_re]
    linarith
  · intro k hk
    have hk1 : x - u.re ≤ (k : ℝ) := by
      have := hk.1; simp only [Complex.add_re, Complex.intCast_re] at this; linarith
    have hk2 : (k : ℝ) < x - u.re + 1 := by
      have := hk.2; simp only [Complex.add_re, Complex.intCast_re] at this; linarith
    have h1 : ⌈x - u.re⌉ ≤ k := Int.ceil_le.mpr hk1
    have h2 : k ≤ ⌈x - u.re⌉ := by
      have hlt : ((k - 1 : ℤ) : ℝ) < x - u.re := by push_cast; linarith
      have : k - 1 < ⌈x - u.re⌉ := Int.lt_ceil.mpr hlt
      omega
    exact le_antisymm h2 h1

/-! ## The model slab, orbits, and the uniformization interface -/

/-- The **model slab** `x ≤ Re u < x + 1`: a fundamental domain for the translation
`u ↦ u + 1` (`existsUnique_translate_mem_slab`), i.e. the `ℂ/ℤ` of HS Prop. 4.2. -/
def slab (x : ℝ) : Set ℂ := {u : ℂ | x ≤ u.re ∧ u.re < x + 1}

theorem mem_slab_iff (x : ℝ) (u : ℂ) : u ∈ slab x ↔ x ≤ u.re ∧ u.re < x + 1 :=
  Iff.rfl

/-- Two points lie on the same orbit of the transit map (the equivalence relation
that the Écalle cylinder quotients by). -/
def SameOrbit (a : ℂ) (h : ℂ → ℂ) (u v : ℂ) : Prop :=
  ∃ n : ℕ, v = (transitMap a h)^[n] u ∨ u = (transitMap a h)^[n] v

theorem sameOrbit_refl (a : ℂ) (h : ℂ → ℂ) (u : ℂ) : SameOrbit a h u u :=
  ⟨0, Or.inl rfl⟩

theorem sameOrbit_symm (a : ℂ) (h : ℂ → ℂ) {u v : ℂ} (huv : SameOrbit a h u v) :
    SameOrbit a h v u := by
  obtain ⟨n, hn | hn⟩ := huv
  · exact ⟨n, Or.inr hn⟩
  · exact ⟨n, Or.inl hn⟩

/-- **The uniformization of the perturbed Écalle cylinder** (HS Prop. 4.2 and the
Lemma 4.3 that follows it: `C^{in}_c`, `C^{out}_c ≅ ℂ/ℤ`).  `χ` is a cylinder
coordinate whose fibres are exactly the orbits of the transit map: this is what it
means for the quotient to *be* `ℂ/ℤ`.

In the exact translation model `χ = fun u ↦ Complex.exp (2 * Real.pi * I * u)`, and
the corresponding statement is `Cylinder.exp_two_pi_I_strip_rep` together with
`Cylinder.existsUnique_translate_mem_slab`.  For the *perturbed* map the existence
of `χ` is the perturbed-Fatou-coordinate / straightening theorem, which this chapter
does **not** formalize (see `NOTES.md` §3); what it does supply in its place is the
exact displacement formula (`Disp.ecalPt_add_modelDisp`,
`Disp.modelMap_eq_modelDisp_add_lattice`) and the quantitative estimates
(`Disp.norm_modelDisp_add_one_le_small`, `Phase.transit_phase_blowup`).
Downstream work needing the cylinder isomorphism should carry
`HasFatouCoordinate a h χ` as an explicit hypothesis. -/
def HasFatouCoordinate (a : ℂ) (h : ℂ → ℂ) (χ : ℂ → ℂ) : Prop :=
  ∀ u v : ℂ, χ u = χ v ↔ SameOrbit a h u v

theorem hasFatouCoordinate_iff_period {χ : ℂ → ℂ} {a : ℂ} {h : ℂ → ℂ}
    (hχ : HasFatouCoordinate a h χ) (u : ℂ) :
    χ (transitMap a h u) = χ u :=
  (hχ _ _).mpr (sameOrbit_symm a h ⟨1, Or.inl rfl⟩)

/-! ## Where the cut sits in the cylinder -/

/-- The **critical point** `0` (the midpoint of the cut) has Écalle **height zero**:
it lies on the equator. -/
theorem ecalleHeight_zero_at_critical (lam : ℝ) (hlam : 0 < lam) :
    ecalleHeight ((lam : ℂ) * I) 0 = 0 := by
  exact Ecalle.ecalleHeight_eq_zero lam hlam 0

/-- The **critical point** `0` has transit phase `π/(2λ)` for `a = iλ`: the cut sits
exactly *halfway* between the two consecutive punctures of the Écalle cylinder
(`norm_period`), which is why the round-trip transit phase is `≈ π/‖a‖`. -/
theorem ecallePhase_at_critical (lam : ℝ) (hlam : 0 < lam) :
    ecallePhase ((lam : ℂ) * I) 0 = Real.pi / (2 * lam) := by
  have h := ecalCoord_cutPt_re lam hlam 0 ⟨by norm_num, by norm_num⟩
  simpa [ecallePhase, cutPt] using h

end Work.Implosion
