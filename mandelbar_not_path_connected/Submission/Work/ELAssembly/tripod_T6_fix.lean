import Mathlib
import Submission.Work.ELTop.Defs
import Submission.Work.ELNest.Qp_shift
import Submission.Work.ELNest.b2_fix_of_lands

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.ELAssembly

/-!
# The branch point of the tripod at `b₂` is fixed by `T_c^[6]`

The three external rays of angles `22/63`, `25/63`, `37/63` co-land at the branch point `y` of
the tripod at `b₂`.  The angle-doubling map `T θ = -2θ mod 1` is multiplication by `-2` on
`ℝ/ℤ`, which on the cyclic subgroup generated by `1/63` is multiplication by `-2` on `ℤ/63`;
since `(-2)^6 = 64 ≡ 1 (mod 63)`, all three angles are periodic of period dividing `6`, and in
particular `T^[6] (22/63) = 22/63`.

Landing is natural under `T_c` (`Work.ELTop.landsN_map`): if the ray of angle `θ` lands at `z`
then the ray of angle `T θ` lands at `T_c z`.  Iterating six times
(`Work.ELNest.landsN_iterate`), the ray of angle `T^[6] (22/63) = 22/63` lands at
`(T_c)^[6] y`.  But the ray of angle `22/63` lands at `y` by definition of the tripod, and a ray
lands at at most one point (`Work.ELNest.landsN_unique`).  Hence `(T_c)^[6] y = y`.
-/

/-- The angle `22/63` of the first ray of the tripod is fixed by `T^[6]`: the exact orbit is
`22/63 → 19/63 → 25/63 → 13/63 → 37/63 → 52/63 → 22/63`. -/
theorem T_iterate_six_b2a : (Work.EL.T^[6]) (22 / 63) = 22 / 63 := by
  norm_num [Work.EL.T, Int.fract]

/-- **The branch point of the tripod at `b₂` is fixed by `(T_c)^[6]`.** -/
theorem tripod_T6_fix {c : ℂ} {φ : ℂ → ℂ} (hN : Work.EL.DynB c φ)
    (hB : Work.ParamRays.IsDynBottcher c φ) (T : Work.EL.Tripod hN) :
    ((LeanEval.ComplexAnalysis.Tantibar c)^[6]) T.y = T.y := by
  -- the ray of angle `T^[6] (22/63) = 22/63` lands at `(T_c)^[6] y`
  have h1 := Work.ELNest.landsN_iterate hN hB 6 T.lands₁
  rw [T_iterate_six_b2a] at h1
  -- and it also lands at `y`, so the two landing points agree
  exact Work.ELNest.landsN_unique h1 T.lands₁

end Work.ELAssembly
