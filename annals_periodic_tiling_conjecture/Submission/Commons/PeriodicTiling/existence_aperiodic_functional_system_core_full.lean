attribute [local instance] Classical.propDecidable

/-! ## B*-odd (paper §analysis, tex 1434-1447): the diagonal setup

`near_digit_Fstar` gives a pseudo-affine `Ψ*` for the post-Tetris board `F*` of a
normal-form Sudoku solution `F` (width `q² = 2^{2t}`, `t ≥ 24`):
`F* = Ψ*` wherever `Ψ* ≠ 0`, and `Ψ*` is non-vanishing on some cell.  This file
formalises the diagonal setup of the parity argument:
  (1) the board is covered by the diagonals `D(n0,m0) := {(n0+qj, m0+j) : j < q}` so a
      non-vanishing cell gives `(n0 ∈ {1..q}, m0, j0)` with `Ψ*` non-vanishing on
      `D(n0,m0)` (`exists_diag_nondegenerate`),
  (2) along any `D(n0,m0)` the `eqs` computation gives
      `F*(n0+qj, m0+j) = f_q(c0 + a0·j)` with `a0` a unit (`postTetris_diag_eqs`),
  (3) `\eqref{fq}`: wherever `Ψ* ≠ 0` on the diagonal, `f_q(c0+a0j) = Ψ*(n0+qj, m0+j)`
      (`eqs_fq_psi_on_D`), and the combined anchor `diag_psi_anchor`. -/

/-- (1) A non-vanishing cell of `Ψ*` lies on some diagonal `D(n0,m0)` at which `Ψ*` is
non-vanishing: the diagonal partition covers the cells of the board. -/
lemma exists_diag_nondegenerate {t : ℕ} (ht : 1 ≤ t) (A B C D : ZMod (2 ^ t))
    (r0 : Fin (2 ^ t * 2 ^ t)) (m0 : ℤ)
    (hΨ : pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0) :
    ∃ n0 m0' : ℤ, ∃ j0 : ℕ,
      1 ≤ n0 ∧ n0 ≤ ((2 ^ t : ℕ) : ℤ) ∧ j0 < 2 ^ t ∧
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j0 : ℤ)) (m0' + (j0 : ℤ)) ≠ 0 := by
  classical
  have hx1 : 1 ≤ rowVal r0 := by dsimp [rowVal]; omega
  have hx2 : rowVal r0 ≤ (((2 ^ t * 2 ^ t : ℕ) : ℤ)) := by
    have hnat : r0.val + 1 ≤ 2 ^ t * 2 ^ t := Nat.succ_le_of_lt r0.isLt
    change (((r0.val : ℕ) + 1 : ℤ)) ≤ (((2 ^ t * 2 ^ t : ℕ) : ℤ))
    exact_mod_cast hnat
  rcases tetris_diag_cell_exists (t := t) ht (rowVal r0) m0 hx1 hx2 with
    ⟨n0, m0', j0, hn0, hn0q, hj, hx, hm⟩
  refine ⟨n0, m0', j0, hn0, hn0q, hj, ?_⟩
  have hψ : pseudoAffineVal A B C D (rowVal r0) m0 =
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j0 : ℤ)) (m0' + (j0 : ℤ)) := by
    rw [hx, hm]
  rw [← hψ]
  exact hΨ

/-- (2) The `eqs` computation along the diagonal `D(n0,m0)` for the post-Tetris board:
`F*(r, m0+j) = f_q(c0 + a0·j)` for the row `r` with `rowVal r = n0+qj`, with `a0` a
unit mod `q`.  (Restatement of `tetris_eqs_unit` for `postTetris F`.) -/
lemma postTetris_diag_eqs {t : ℕ} (ht : 3 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (n0 m0 : ℤ) (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ)) :
    ∃ a0 c0 : ℤ,
      IsUnit (a0 : ZMod (2 ^ t)) ∧
      (∀ j : ℕ, j < 2 ^ t → ∀ r : Fin (2 ^ t * 2 ^ t),
        rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
          postTetris F r (m0 + (j : ℤ)) = fq (2 ^ t) (c0 + a0 * (j : ℤ))) := by
  classical
  have hNq : (2 ^ t) * (2 ^ t) ≤ 2 ^ t * 2 ^ t := le_rfl
  rcases tetris_eqs_unit (t := t) (N := 2 ^ t * 2 ^ t) ht hNq F hF Dp hNF n0 hn0 hn0q
      (((2 ^ t : ℕ) : ℤ) * m0 - n0) m0 rfl with ⟨a0, c0, ha0u, hval⟩
  refine ⟨a0, c0, ha0u, ?_⟩
  intro j hj r hr
  have hv := hval j hj r hr
  simpa [postTetris] using hv

/-- (3) `\eqref{fq}` along the diagonal: wherever `Ψ*` is non-vanishing on `D(n0,m0)`,
`f_q(c0+a0·j) = Ψ*(n0+qj, m0+j)` (the `eqs` value agrees with the pseudo-affine value,
both being the `F*`-value there). -/
lemma eqs_fq_psi_on_D {t : ℕ} (ht : 3 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (A B C D : ZMod (2 ^ t))
    (hΨ2 : ∀ r m, pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
      postTetris F r m = pseudoAffineVal A B C D (rowVal r) m)
    (n0 m0 : ℤ) (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ)) :
    ∃ a0 c0 : ℤ,
      IsUnit (a0 : ZMod (2 ^ t)) ∧
      (∀ j : ℕ, j < 2 ^ t → ∀ r : Fin (2 ^ t * 2 ^ t),
        rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
          pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ)) ≠ 0 →
            fq (2 ^ t) (c0 + a0 * (j : ℤ)) = pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ))) := by
  classical
  rcases postTetris_diag_eqs (t := t) ht F hF Dp hNF n0 m0 hn0 hn0q with ⟨a0, c0, ha0u, heqs⟩
  refine ⟨a0, c0, ha0u, ?_⟩
  intro j hj r hr hΨ
  have hFstar := heqs j hj r hr
  have hΨag := hΨ2 r (m0 + (j : ℤ)) hΨ
  calc
    fq (2 ^ t) (c0 + a0 * (j : ℤ)) = postTetris F r (m0 + (j : ℤ)) := hFstar.symm
    _ = pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ)) := hΨag

/-- Combined anchor of the parity argument: given the near-digit data for `F*` (a
pseudo-affine `Ψ*` agreeing with `F*` off its zeros and non-vanishing on some cell),
there is a diagonal `D(n0,m0)` (`n0 ∈ {1..q}`) on which `Ψ*` is non-vanishing and the
`\eqref{fq}` equations hold with a unit coefficient `a0`. -/
lemma diag_psi_anchor {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (A B C D : ZMod (2 ^ t))
    (hΨ1 : ∃ r0 : Fin (2 ^ t * 2 ^ t), ∃ m0 : ℤ,
      pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0)
    (hΨ2 : ∀ r m, pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
      postTetris F r m = pseudoAffineVal A B C D (rowVal r) m) :
    ∃ n0 m0 a0 c0 : ℤ,
      1 ≤ n0 ∧ n0 ≤ ((2 ^ t : ℕ) : ℤ) ∧
      IsUnit (a0 : ZMod (2 ^ t)) ∧
      (∃ j0 : ℕ, j0 < 2 ^ t ∧
        pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j0 : ℤ)) (m0 + (j0 : ℤ)) ≠ 0) ∧
      ∀ j : ℕ, j < 2 ^ t → ∀ r : Fin (2 ^ t * 2 ^ t),
        rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
          pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ)) ≠ 0 →
            fq (2 ^ t) (c0 + a0 * (j : ℤ)) =
              pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ)) := by
  classical
  have ht1 : 1 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  rcases hΨ1 with ⟨r0, m0c, hΨ0⟩
  rcases exists_diag_nondegenerate (t := t) ht1 A B C D r0 m0c hΨ0 with
    ⟨n0, m0, j0, hn0, hn0q, hj0, hΨnz⟩
  rcases eqs_fq_psi_on_D (t := t) ht3 F hF Dp hNF A B C D hΨ2 n0 m0 hn0 hn0q with
    ⟨a0, c0, ha0u, heq⟩
  refine ⟨n0, m0, a0, c0, hn0, hn0q, ha0u, ⟨j0, hj0, hΨnz⟩, heq⟩

end
end Commons.PeriodicTiling


