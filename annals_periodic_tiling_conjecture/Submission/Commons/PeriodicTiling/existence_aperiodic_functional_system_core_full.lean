set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! # General-`K` `CompBool` is weakly expressible (assembly)

From the W=2 case (`mef_weakExpressible_pair`) we assemble
`WeakExpressible K (CompBool e v p q)` for every `K`, following the paper's "general
case follows from the W=2 case in the spirit of Example equal-ex": a `K`-tuple obeys
`CompBool` iff every coordinate is `⟨p,q⟩`-periodic and `(v,{a,b})`-boolean (an
expressible — hence weakly expressible — property `A`), and every pair of DISTINCT
coordinates obeys the W=2 `CompBool` (a finite conjunction of per-pair properties,
each a pullback of the W=2 witness along the coordinate-pair selection). -/

/-! ## Selecting a pair of coordinates out of `K` and reading them as a 2-tuple

For a pair `(w, w')` of distinct coordinates of a `(K+6)`-tuple (the `K` original
coordinates followed by `6` auxiliary ones), the selection map reads the `8`-tuple
`(α_w, α_{w'}, α₀_0, …, α₀_5)` from the `(K+6)`-tuple `(α ++ α₀)`. -/

/-- Embed `w : Fin K` as a coordinate of `Fin (K+6)` (value-preserving). -/
def selCast (K : ℕ) (w : Fin K) : Fin (K + 6) :=
  ⟨w.val, by have hw := w.isLt; omega⟩

/-- Select the `8` coordinates `w, w', K, …, K+5` of a `(K+6)`-tuple. -/
def selPair (K : ℕ) (w w' : Fin K) : Fin 8 → Fin (K + 6) :=
  fun k => if hk0c : k.val = 0 then selCast K w
    else if hk1c : k.val = 1 then selCast K w'
    else ⟨K + (k.val - 2), by
      have hk8 : k.val < 8 := k.isLt
      have hle : 2 ≤ k.val := by
        by_contra h2
        have hk01 : k.val = 0 ∨ k.val = 1 := by omega
        rcases hk01 with hk0 | hk1
        · exact hk0c hk0
        · exact hk1c hk1
      omega⟩

/-- `selPair` at coordinate `0` is `w`. -/
lemma selPair_zero (K : ℕ) (w w' : Fin K) :
    selPair K w w' (0 : Fin 8) = selCast K w := by
  simp [selPair]

/-- `selPair` at coordinate `1` is `w'`. -/
lemma selPair_one (K : ℕ) (w w' : Fin K) :
    selPair K w w' (1 : Fin 8) = selCast K w' := by
  simp [selPair]

/-- `selPair` at coordinate `2 + t` (for `t : Fin 6`) is the coordinate `K + t` (in the
auxiliary block). -/
lemma selPair_natAdd (K : ℕ) (w w' : Fin K) (t : Fin 6) :
    selPair K w w' (Fin.natAdd 2 t) = ⟨K + t.val, by have ht := t.isLt; omega⟩ := by
  have hk : (Fin.natAdd 2 t).val = 2 + t.val := by simp [Fin.natAdd]
  have hk0 : 2 + t.val ≠ 0 := by omega
  have hk1 : 2 + t.val ≠ 1 := by omega
  simp [selPair, hk, hk0, hk1]

/-- `selPair` is injective for distinct `w w'`. -/
lemma selPair_injective {K : ℕ} {w w' : Fin K} (hww' : w ≠ w') :
    Function.Injective (selPair K w w') := by
  intro a b h
  apply Fin.ext
  have hv : (selPair K w w' a).val = (selPair K w w' b).val := congrArg Fin.val h
  by_cases ha2 : a.val < 2 <;> by_cases hb2 : b.val < 2
  · -- both values < 2: among {0, 1}
    have ha01 : a.val = 0 ∨ a.val = 1 := by omega
    have hb01 : b.val = 0 ∨ b.val = 1 := by omega
    rcases ha01 with ha0 | ha1 <;> rcases hb01 with hb0 | hb1
    · omega
    · exfalso
      have hva : (selPair K w w' a).val = w.val := by simp [selPair, selCast, ha0]
      have hvb : (selPair K w w' b).val = w'.val := by simp [selPair, selCast, hb1]
      rw [hva, hvb] at hv
      exact hww' (Fin.ext hv)
    · exfalso
      have hva : (selPair K w w' a).val = w'.val := by simp [selPair, selCast, ha1]
      have hvb : (selPair K w w' b).val = w.val := by simp [selPair, selCast, hb0]
      rw [hva, hvb] at hv
      exact hww' (Fin.ext hv.symm)
    · omega
  · -- a.val < 2, b.val ≥ 2
    exfalso
    have hbge : 2 ≤ b.val := by omega
    have hnb0 : ¬ b.val = 0 := by omega
    have hnb1 : ¬ b.val = 1 := by omega
    have hvb : (selPair K w w' b).val = K + (b.val - 2) := by simp [selPair, selCast, hnb0, hnb1]
    have ha01 : a.val = 0 ∨ a.val = 1 := by omega
    rcases ha01 with hb0 | hb1
    · have hva : (selPair K w w' a).val = w.val := by simp [selPair, selCast, hb0]
      rw [hva, hvb] at hv
      have hw : w.val < K := w.isLt
      omega
    · have hva : (selPair K w w' a).val = w'.val := by simp [selPair, selCast, hb1]
      rw [hva, hvb] at hv
      have hw : w'.val < K := w'.isLt
      omega
  · -- a.val ≥ 2, b.val < 2
    exfalso
    have ha_n0 : ¬ a.val = 0 := by omega
    have ha_n1 : ¬ a.val = 1 := by omega
    have hva : (selPair K w w' a).val = K + (a.val - 2) := by simp [selPair, ha_n0, ha_n1]
    have hb01 : b.val = 0 ∨ b.val = 1 := by omega
    rcases hb01 with hb0 | hb1
    · have hvb : (selPair K w w' b).val = w.val := by simp [selPair, selCast, hb0]
      rw [hva, hvb] at hv
      have hw : w.val < K := w.isLt
      omega
    · have hvb : (selPair K w w' b).val = w'.val := by simp [selPair, selCast, hb1]
      rw [hva, hvb] at hv
      have hw : w'.val < K := w'.isLt
      omega
  · -- both ≥ 2
    have hna0 : ¬ a.val = 0 := by omega
    have hna1 : ¬ a.val = 1 := by omega
    have hnb0 : ¬ b.val = 0 := by omega
    have hnb1 : ¬ b.val = 1 := by omega
    have hva : (selPair K w w' a).val = K + (a.val - 2) := by simp [selPair, selCast, hna0, hna1]
    have hvb : (selPair K w w' b).val = K + (b.val - 2) := by simp [selPair, selCast, hnb0, hnb1]
    rw [hva, hvb] at hv
    omega

/-! ## Reading the selected 8 coordinates of `α ++ α₀`

The selection map composes with the append: reading coordinates `w, w', K, …, K+5` of
`α ++ α₀` produces exactly the 8-tuple `(mef_proj α w w') ++ α₀`. -/

/-- `selCast K w` is the `castAdd 6`-embedding of `w`. -/
lemma selCast_eq_castAdd (K : ℕ) (w : Fin K) :
    selCast K w = Fin.castAdd 6 w := by
  apply Fin.ext
  simp [selCast]

/-- Appending at the embedded coordinate `w` reads the left part. -/
lemma append_left_selCast {H : Type*} [AddCommGroup H] (K : ℕ) (α : Fin K → H)
    (α₀ : Fin 6 → H) (w : Fin K) :
    Fin.append α α₀ (selCast K w) = α w := by
  rw [selCast_eq_castAdd K w]
  rw [Fin.append_left]

/-- The `natAdd 2` index as a `Fin 8`-element of value `2 + t.val`. -/
lemma natAdd_two_eq (t : Fin 6) : Fin.natAdd 2 t = (⟨2 + t.val, by have ht := t.isLt; omega⟩ : Fin 8) := by
  apply Fin.ext
  simp [Fin.natAdd]

/-- Appending at the embedded coordinate `K + j.val` reads the right part. -/
lemma append_right_selPair {H : Type*} [AddCommGroup H] (K : ℕ) (α : Fin K → H)
    (α₀ : Fin 6 → H) (j : Fin 6) :
    Fin.append α α₀ ⟨K + j.val, by have hj := j.isLt; omega⟩ = α₀ j := by
  have hj' : (⟨K + j.val, by have hj := j.isLt; omega⟩ : Fin (K + 6)) = Fin.natAdd K j := by
    apply Fin.ext
    simp [Fin.natAdd]
  rw [hj']
  rw [Fin.append_right]

/-- Reading the selected coordinates of `α ++ α₀` gives the pair-projection appended to
`α₀`. -/
lemma readSel_eq (K : ℕ) (w w' : Fin K) (hww' : w ≠ w')
    (e : ℕ) (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1)))) :
    (fun x : G => fun k : Fin 8 => (Fin.append (α x) (α₀ x)) (selPair K w w' k)) =
      (fun x : G => Fin.append (mef_proj α w w' x) (α₀ x)) := by
  funext x
  funext k
  by_cases hk0 : k.val = 0
  · have hk : k = (0 : Fin 8) := Fin.ext hk0
    rw [hk]
    change (Fin.append (α x) (α₀ x)) (selPair K w w' (0 : Fin 8)) =
      Fin.append (mef_proj α w w' x) (α₀ x) (0 : Fin 8)
    rw [selPair_zero]
    rw [append_left_selCast K (α x) (α₀ x) w]
    rw [show (0 : Fin 8) = Fin.castAdd 6 (0 : Fin 2) by
      apply Fin.ext
      simp [Fin.castAdd]]
    rw [Fin.append_left]
    simp [mef_proj]
  · by_cases hk1 : k.val = 1
    · have hk : k = (1 : Fin 8) := Fin.ext hk1
      rw [hk]
      change (Fin.append (α x) (α₀ x)) (selPair K w w' (1 : Fin 8)) =
        Fin.append (mef_proj α w w' x) (α₀ x) (1 : Fin 8)
      rw [selPair_one]
      rw [append_left_selCast K (α x) (α₀ x) w']
      rw [show (1 : Fin 8) = Fin.castAdd 6 (1 : Fin 2) by
        apply Fin.ext
        simp [Fin.castAdd]]
      rw [Fin.append_left]
      simp [mef_proj]
    · -- k.val ≥ 2
      have hkge : 2 ≤ k.val := by omega
      let j : Fin 6 := ⟨k.val - 2, by omega⟩
      have hk : k = Fin.natAdd 2 j := by
        apply Fin.ext
        simp [j, Fin.natAdd]
        omega
      rw [hk]
      change (Fin.append (α x) (α₀ x)) (selPair K w w' (Fin.natAdd 2 j)) =
        Fin.append (mef_proj α w w' x) (α₀ x) (Fin.natAdd 2 j)
      rw [selPair_natAdd K w w' j]
      rw [append_right_selPair K (α x) (α₀ x) j]
      rw [Fin.append_right]

/-! ## Per-pair weak expressibility

For a pair of distinct coordinates `w w'`, the property "the 2-projection
`(α_w, α_{w'})` obeys the W=2 `CompBool`" is weakly expressible over `K`-tuples: the
witness appends `6` auxiliary coordinates, and the expressible property reads the
`8` coordinates `(w, w', aux)` through `selPair`. -/

/-- The W=2 case as a standalone equivalence (used per pair). -/
lemma compbool2_iff_pairPstar {e : ℕ} (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (α₁ : G → (Fin 2 → ZMod (2 ^ (e + 1)))) :
    CompBool e v p q α₁ ↔ ∃ α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1))),
      PairPstar e v p q (fun x : G => Fin.append (α₁ x) (α₀ x)) := by
  constructor
  · intro hα₁
    exact mef_PairPstar_of_CompBool (e := e) he v p q h2v h2p h2q hind α₁ hα₁
  · intro h
    rcases h with ⟨α₀, hp⟩
    exact mef_CompBool_of_PairPstar (e := e) (he := he) (v := v) (p := p) (q := q) α₁ α₀ hp

/-- The pair-projection `CompBool` property is weakly expressible (distinct `w w'`). -/
theorem weakCompBool_pair {d K : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (w w' : Fin K) (hww' : w ≠ w') :
    WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      CompBool e v p q (mef_proj α w w')) := by
  classical
  let H := ZMod (2 ^ (e + 1))
  let Pstar : (G → (Fin (K + 6) → H)) → Prop := fun γ =>
    PairPstar e v p q (fun x : G => fun k : Fin 8 => γ x (selPair K w w' k))
  have hPstar_exp : ExpressibleProperty Pstar := by
    dsimp [Pstar]
    have hs := pairPstar_expressible (d := d) e he v p q gens hpos hspan
    have hsel := expressible_select (K₁ := 8) (L := K + 6) (R := selPair K w w')
      (selPair_injective hww') hs
    simpa using hsel
  refine ⟨6, ?Pstar, ?exp, ?iff⟩
  · exact fun γ : G → (Fin (K + 6) → H) => Pstar γ
  · simpa [Pstar] using hPstar_exp
  · intro α
    constructor
    · intro hα
      have hα' := (compbool2_iff_pairPstar (e := e) he v p q h2v h2p h2q hind
        (mef_proj α w w')).mp hα
      rcases hα' with ⟨α₀, hp⟩
      refine ⟨α₀, ?_⟩
      change Pstar (fun x : G => Fin.append (α x) (α₀ x))
      dsimp [Pstar]
      rw [readSel_eq K w w' hww' e α α₀]
      exact hp
    · intro hw
      rcases hw with ⟨α₀, hP⟩
      have hP' : PairPstar e v p q (fun x : G => fun k : Fin 8 =>
          (Fin.append (α x) (α₀ x)) (selPair K w w' k)) := by
        change Pstar (fun x : G => Fin.append (α x) (α₀ x)) at hP
        exact hP
      have hP'' : PairPstar e v p q (fun x : G =>
          Fin.append (mef_proj α w w' x) (α₀ x)) := by
        rwa [readSel_eq K w w' hww' e α α₀] at hP'
      exact (compbool2_iff_pairPstar (e := e) he v p q h2v h2p h2q hind
        (mef_proj α w w')).mpr ⟨α₀, hP''⟩

/-! ## Finite conjunctions of weakly expressible properties

A finite conjunction of weakly expressible properties is weakly expressible (Lemma
`closure`(iii), iterated). -/

/-- A finite conjunction of weakly expressible properties is weakly expressible. -/
theorem weakExpressible_conj_fin {H : Type*} [AddCommGroup H] {K : ℕ} {n : ℕ}
    {P : Fin n → (G → (Fin K → H)) → Prop}
    (hP : ∀ i : Fin n, WeakExpressible K (P i)) :
    WeakExpressible K (fun α : G → (Fin K → H) => ∀ i : Fin n, P i α) := by
  classical
  have hgen : ∀ (n : ℕ) (P : Fin n → (G → (Fin K → H)) → Prop),
      (∀ i : Fin n, WeakExpressible K (P i)) →
        WeakExpressible K (fun α : G → (Fin K → H) => ∀ i : Fin n, P i α) := by
    intro n
    induction n with
    | zero =>
        intro P hP
        have htrue : WeakExpressible K (fun _ : G → (Fin K → H) => True) := by
          exact expressible_weak (K := K) (H := H)
            (P := fun _ : G → (Fin K → H) => True)
            (fullProperty_expressible (H := Fin K → H))
        refine weakExpressible_congr (fun α => ?_) htrue
        constructor
        · intro _h i
          exact Fin.elim0 i
        · intro hall
          trivial
    | succ n ih =>
        intro P hP
        have hlast : WeakExpressible K (P (Fin.last n)) := hP (Fin.last n)
        have hrest : WeakExpressible K (fun α : G → (Fin K → H) =>
            ∀ i : Fin n, P (Fin.castSucc i) α) := by
          exact ih (fun i : Fin n => P (Fin.castSucc i)) (fun i => hP (Fin.castSucc i))
        have hconj : WeakExpressible K (fun α : G → (Fin K → H) =>
            P (Fin.last n) α ∧ (∀ i : Fin n, P (Fin.castSucc i) α)) := by
          exact weakExpressible_conj hlast hrest
        refine weakExpressible_congr (fun α => ?_) hconj
        constructor
        · intro h j
          refine Fin.lastCases (motive := fun j : Fin (n + 1) => P j α) ?_ ?_ j
          · exact h.1
          · intro i
            exact h.2 i
        · intro hall
          exact ⟨hall (Fin.last n), fun i => hall (Fin.castSucc i)⟩
  exact hgen n P hP

/-! ## Assembly over pair indices

The pair part is indexed by `Fin (K * K)` (via `finProdFinEquiv`). -/

/-- The pair of coordinates indexed by `pp : Fin (K*K)`. -/
def pairOf {K : ℕ} (pp : Fin (K * K)) : Fin K × Fin K := finProdFinEquiv.symm pp

/-- The per-index property is weakly expressible (equal-coordinate pairs are trivial). -/
lemma weakPair_index {d K : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (pp : Fin (K * K)) :
    WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2)) := by
  classical
  let w : Fin K := (pairOf pp).1
  let w' : Fin K := (pairOf pp).2
  by_cases hww' : w ≠ w'
  · have hw : WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
        CompBool e v p q (mef_proj α w w')) := by
      exact weakCompBool_pair (d := d) e he v p q h2v h2p h2q hind
        gens hpos hspan w w' hww'
    refine weakExpressible_congr (fun α => ?_) hw
    dsimp [w, w']
    constructor
    · intro h _hne
      exact h
    · intro h
      exact h hww'
  · -- w = w': the implication is vacuously true
    have htrue : WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) => True) := by
      exact expressible_weak (K := K)
        (P := fun _ : G → (Fin K → ZMod (2 ^ (e + 1))) => True)
        (fullProperty_expressible (H := Fin K → ZMod (2 ^ (e + 1))))
    refine weakExpressible_congr (fun α => ?_) htrue
    dsimp [w, w']
    constructor
    · intro _h hne
      exact False.elim (hww' hne)
    · intro _h
      trivial

/-- The pair part over `Fin (K * K)` is weakly expressible. -/
lemma weakPair_all {d K : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ pp : Fin (K * K), (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2)) := by
  exact weakExpressible_conj_fin (K := K) (H := ZMod (2 ^ (e + 1)))
    (n := K * K)
    (P := fun pp (α : G → (Fin K → ZMod (2 ^ (e + 1)))) =>
      (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2))
    (fun pp => weakPair_index (d := d) e he v p q h2v h2p h2q hind gens hpos hspan pp)

/-- The pair part indexed by pairs is equivalent to the `∀ w w'` form. -/
lemma weakPair_equiv {e K : ℕ} (v p q : G)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) :
    (∀ pp : Fin (K * K), (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2)) ↔
      (∀ w w' : Fin K, w ≠ w' → CompBool e v p q (mef_proj α w w')) := by
  constructor
  · intro hall w w' hne
    let pp : Fin (K * K) := finProdFinEquiv (⟨w, w'⟩ : Fin K × Fin K)
    have hpair : (pairOf pp).1 = w ∧ (pairOf pp).2 = w' := by
      dsimp [pairOf, pp]
      simp
    have hne' : (pairOf pp).1 ≠ (pairOf pp).2 := by
      rw [hpair.1, hpair.2]
      exact hne
    have hc := hall pp hne'
    rwa [hpair.1, hpair.2] at hc
  · intro hw pp
    exact hw (pairOf pp).1 (pairOf pp).2

/-- The `CompBool`-`K` property is the conjunction of the per-coordinate part and the
pair part over distinct coordinates. -/
lemma compbool_iff_per_and_pairs {e K : ℕ} (v p q : G)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) :
    CompBool e v p q α ↔
      ((∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
          IsBooleanAlt e v (coord α w)) ∧
       (∀ w w' : Fin K, w ≠ w' → CompBool e v p q (mef_proj α w w'))) := by
  constructor
  · intro hα
    have hmp := (mef_compbool_pairwise (e := e) (K := K) v p q α).mpr hα
    exact ⟨hmp.1, fun w w' _hne => hmp.2 w w'⟩
  · intro h
    rcases h with ⟨hper, hpair⟩
    have hall : ∀ w w' : Fin K, CompBool e v p q (mef_proj α w w') := by
      intro w w'
      by_cases hww' : w = w'
      · subst w'
        constructor
        · intro i
          fin_cases i
          · change periodicAlong p (coord (mef_proj α w w) (0 : Fin 2)) ∧
              periodicAlong q (coord (mef_proj α w w) (0 : Fin 2)) ∧
              IsBooleanAlt e v (coord (mef_proj α w w) (0 : Fin 2))
            rw [mef_proj_zero α w w]
            exact hper w
          · change periodicAlong p (coord (mef_proj α w w) (1 : Fin 2)) ∧
              periodicAlong q (coord (mef_proj α w w) (1 : Fin 2)) ∧
              IsBooleanAlt e v (coord (mef_proj α w w) (1 : Fin 2))
            rw [mef_proj_one α w w]
            exact hper w
        · intro i j
          fin_cases i <;> fin_cases j
          · change CompatibleFunctions (coord (mef_proj α w w) (0 : Fin 2))
              (coord (mef_proj α w w) (0 : Fin 2))
            rw [mef_proj_zero α w w]
            exact pairTranslate_refl (Set.range (coord α w))
          · change CompatibleFunctions (coord (mef_proj α w w) (0 : Fin 2))
              (coord (mef_proj α w w) (1 : Fin 2))
            rw [mef_proj_zero α w w, mef_proj_one α w w]
            exact pairTranslate_refl (Set.range (coord α w))
          · change CompatibleFunctions (coord (mef_proj α w w) (1 : Fin 2))
              (coord (mef_proj α w w) (0 : Fin 2))
            rw [mef_proj_one α w w, mef_proj_zero α w w]
            exact pairTranslate_refl (Set.range (coord α w))
          · change CompatibleFunctions (coord (mef_proj α w w) (1 : Fin 2))
              (coord (mef_proj α w w) (1 : Fin 2))
            rw [mef_proj_one α w w]
            exact pairTranslate_refl (Set.range (coord α w))
      · exact hpair w w' hww'
    exact (mef_compbool_pairwise (e := e) (K := K) v p q α).mp ⟨hper, hall⟩

/-! ## The general-`K` theorem

Assembling: the per-coordinate part is expressible, the pair part is weakly expressible
(`weakPair_all`), and `CompBool` is their conjunction; the finite conjunction and the
characterisation give the claim. -/

/-- The compatible boolean property on a `K`-tuple is weakly expressible (general
`K`; this is Proposition multi-express, `W = K`). -/
theorem mef_weakExpressible_general {d K : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) => CompBool e v p q α) := by
  classical
  have hA : WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
        IsBooleanAlt e v (coord α w)) := by
    have hAexp : ExpressibleProperty (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
        ∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
          IsBooleanAlt e v (coord α w)) := by
      exact coordinatewise_bool_expressible (d := d) (K := K) e he v p q gens hpos hspan
    exact expressible_weak (K := K) (P := fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
        IsBooleanAlt e v (coord α w)) hAexp
  have hB : WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ pp : Fin (K * K), (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2)) := by
    exact weakPair_all (d := d) e he v p q h2v h2p h2q hind gens hpos hspan
  have hconj : WeakExpressible K (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      (∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
        IsBooleanAlt e v (coord α w)) ∧
      (∀ pp : Fin (K * K), (pairOf pp).1 ≠ (pairOf pp).2 →
        CompBool e v p q (mef_proj α (pairOf pp).1 (pairOf pp).2))) := by
    exact weakExpressible_conj hA hB
  refine weakExpressible_congr (fun α => ?_) hconj
  rw [weakPair_equiv v p q α]
  exact (compbool_iff_per_and_pairs (e := e) v p q α).symm


end
