/-! # Phase 3 encode, layer 0 - the good-columns tile (WIP SCAFFOLD)

Pinned targets for encoding "Sudoku solutions with good columns" as a weakly
expressible property over the ambient group `G = Z^2 x (Z/2)^3` (arXiv:2211.15847,
tex 1128-1197).  This file is a statements-only scaffold: the one `:= by TBD` target
is a design pin, NOT finished mathematics.  Nothing imports this file and it is never
declared proven; the target must be re-proven from the library before use.

Objects defined here (all TBD-free): the ambient group `EncodeG`, its three parity
directions `encE0/encE1/encE2` (the copy of `(Z/2)^3` inside `G`), the parity
projections `par`, the reflection `R_a(t) = a + t` (paper eq (reflection); in
characteristic 2 this is `R_a(x) = a + (-1)^a x`), the coordinatewise reflection
`encReflect`, the binary map `encB`, and the good-columns boolean formula
`goodColWord` (paper axiom (ii)) with its reflection-symmetrised row/full versions
`goodColWordRefl`, `OmegaTilde_gcRow`, `OmegaTilde_gc`. -/

/-- The three parity coordinates as a `Fin 3`-indexed `(Z/2)^3`. -/
abbrev Parity3 : Type := Fin 3 → ZMod 2

/-- Ambient group of the encode: `Z^2 x (Z/2)^3`. -/
abbrev EncodeG : Type := (ℤ × ℤ) × Parity3

instance : AddCommGroup EncodeG := inferInstance

/-- The parity coordinate selector (0 = e, 1 = e', 2 = e''). -/
def par (x : EncodeG) : Parity3 := x.2

/-- The `Z^2` part of a point. -/
def planePart (x : EncodeG) : ℤ × ℤ := x.1

/-- The `k`-th standard parity vector in `(Z/2)^3`. -/
def encGen (k : Fin 3) : Parity3 := fun c => if c = k then (1 : ZMod 2) else 0

/-- The three parity directions `e, e', e''` of the ambient group. -/
def encE0 : EncodeG := (((0 : ℤ), (0 : ℤ)), encGen 0)
def encE1 : EncodeG := (((0 : ℤ), (0 : ℤ)), encGen 1)
def encE2 : EncodeG := (((0 : ℤ), (0 : ℤ)), encGen 2)

/-- Reflection `R_a(t) = a + (-1)^a t`, which in characteristic 2 is `a + t`. -/
def encReflectVal (a t : ZMod 2) : ZMod 2 := a + t

/-- Coordinatewise reflection of a boolean word. -/
def encReflect {K : ℕ} (a : ZMod 2) (w : Fin K → ZMod 2) : Fin K → ZMod 2 :=
  fun k => encReflectVal a (w k)

/-- The binary encoding map `B(eps_0,...,eps_{s0-1}) = eps_0 + 2 eps_1 + ...`. -/
def encB {s0 : ℕ} (w : Fin s0 → ZMod 2) : ZMod (2 ^ s0) :=
  (((∑ b : Fin s0, (w b).val * 2 ^ b.val) : ℕ) : ZMod (2 ^ s0))

/-- `encB` of the zero word is `0`. -/
lemma encB_zero {s0 : ℕ} : encB (fun _ : Fin s0 => (0 : ZMod 2)) = 0 := by
  dsimp [encB]
  simp

/-- The tile index type of the encode: `{0,1} x {0,...,s0-1} x {1,...,N}` (paper W). -/
abbrev TileIdx (s0 N : ℕ) : Type := Fin 2 × Fin s0 × Fin N

/-- A boolean word indexed by the tiles (a point of `{0,1}^W`). -/
abbrev boolWord (s0 N : ℕ) : Type := TileIdx s0 N → ZMod 2

/-- The `a = 0` word of a row `n` (the sigma_n-side bits). -/
def word0 {s0 N : ℕ} (ω : boolWord s0 N) (n : Fin N) : Fin s0 → ZMod 2 :=
  fun b => ω ((0 : Fin 2), b, n)

/-- The `a = 1` word of a row `n` (the Sudoku-value-side bits). -/
def word1 {s0 N : ℕ} (ω : boolWord s0 N) (n : Fin N) : Fin s0 → ZMod 2 :=
  fun b => ω ((1 : Fin 2), b, n)

/-- Paper axiom (ii) at one tile: if the decoded sigma_n-side digit is non-zero then
the two words agree. -/
def goodColWord (s0 : ℕ) (ω0 ω1 : Fin s0 → ZMod 2) : Prop :=
  encB ω0 ≠ 0 → ω0 = ω1

/-- Paper axiom (ii) after reflecting by the `e`-parity bit `w*`. -/
def goodColWordRefl (s0 : ℕ) (wStar : ZMod 2) (ω0 ω1 : Fin s0 → ZMod 2) : Prop :=
  goodColWord s0 (encReflect wStar ω0) (encReflect wStar ω1)

/-- The symmetrised good-columns set of one row `OmegaTilde` (w* = reflection bit,
then the two words of the row). -/
def OmegaTilde_gcRow (s0 : ℕ) :
    Set (ZMod 2 × (Fin s0 → ZMod 2) × (Fin s0 → ZMod 2)) :=
  {ω | goodColWordRefl s0 ω.1 ω.2.1 ω.2.2}

/-- The full-board symmetrised good-columns set (w* shared, per row the two words). -/
def OmegaTilde_gc (s0 N : ℕ) :
    Set (ZMod 2 × (Fin N → (Fin s0 → ZMod 2) × (Fin s0 → ZMod 2))) :=
  {ω | ∀ n : Fin N, goodColWordRefl s0 ω.1 (ω.2 n).1 (ω.2 n).2}

/-! ## First pinned target (WIP: statement only, `TBD`)

Only one target is pinned here - the one whose type is fully determined by the layer-0
objects and the library interfaces, and which is genuinely new: a packaged combine that
the encode's axiom (b) needs (paper tex 1169: each `alpha_{a,b,n}` is
`<((-n,1),(0,0,0))>`-periodic).  The property-`S` / `P_OmegaTilde` statement is NOT
pinned yet on purpose: writing it correctly requires first fixing two design choices
(recorded in STATUS_NOTES): (i) representing the good-columns set `OmegaTilde_gcRow` as
cube-minus-excluded-symmetric-pairs (the only `Omega`-form the sym-bool machinery
accepts), and (ii) the width transport `TileIdx s0 N ~ Fin (2*s0*N)` / the coordinate
reading inside `Fin (1 + 2*s0*N)`.  Both are mechanical once chosen. -/

/-- Target T1 (encode axiom (b), packaged combine): for any family of directions
`dir w` (to be instantiated by the row-dependent `((-n,1),(0,0,0))`), weak
expressibility over the concrete ambient group at level `e` of "every coordinate of
the tuple is periodic along its own direction".  Proof route (library): per-coordinate
`periodicAlong_expressible` + `expressible_coord_conj_fin` + `expressible_weak`. -/
theorem encode_periodic_eachCoord_weakExpressible {K : ℕ} (e : ℕ) (_he : 1 ≤ e)
    (dir : Fin K → EncodeG) :
    WeakExpressible K
      (fun α : EncodeG → (Fin K → ZMod (2 ^ (e + 1))) =>
        ∀ w : Fin K, periodicAlong (dir w) (coord α w)) := by
  have hN : 2 ≤ 2 ^ (e + 1) := by
    have h4 : 2 ≤ 2 ^ 2 := by norm_num
    exact le_trans h4 (pow_le_pow_right₀ (by norm_num) (by omega : 2 ≤ e + 1))
  have hE : ExpressibleProperty
      (fun α : EncodeG → (Fin K → ZMod (2 ^ (e + 1))) =>
        ∀ w : Fin K, periodicAlong (dir w) (coord α w)) := by
    exact expressible_coord_conj_fin (K := K)
      (P := fun w (α : EncodeG → ZMod (2 ^ (e + 1))) => periodicAlong (dir w) α)
      (fun w => periodicAlong_expressible (2 ^ (e + 1)) hN (dir w))
  exact expressible_weak (K := K)
    (P := fun α : EncodeG → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin K, periodicAlong (dir w) (coord α w)) hE


/-! ## Pinning `P_OmegaTilde_gc` — the excluded-pair form (per row, odd width `2*s0+1`)

Per STATUS_NOTES design (i): on one row the reflection-symmetrised good-columns set
`OmegaTilde_gcRow` has complement (within the cube) exactly the tuples with
`R_w*(w0) != 0  and  R_w*(w0) != R_w*(w1)` — those come in reflection pairs
`{eta, 1-eta}`; the row width `2*s0+1` (coordinates 0 = w*, 1..s0 = w0, s0+1..2s0 = w1)
is ODD, so `sb_POmegaFull_excl_weakExpressible` applies directly with `n := s0` and NO
width transport.  `rowBadEnum` is the excluded-tuple enumeration (via
`Fintype.equivFin` of the finite bad set, classically); the machinery handles each
listed tuple together with its reflection. -/

/-- The reflection bit `w*` of a row word. -/
def rowStar {R : Type} (s0 : ℕ) (tau : Fin (2 * s0 + 1) → R) : R :=
  tau ⟨0, by omega⟩

/-- The `a = 0` (sigma-side) word of a row word. -/
def rowWord0 {R : Type} (s0 : ℕ) (tau : Fin (2 * s0 + 1) → R) : Fin s0 → R :=
  fun b => tau ⟨1 + b.val, by omega⟩

/-- The `a = 1` (Sudoku-value-side) word of a row word. -/
def rowWord1 {R : Type} (s0 : ℕ) (tau : Fin (2 * s0 + 1) → R) : Fin s0 → R :=
  fun b => tau ⟨1 + s0 + b.val, by omega⟩

/-- The row lies in the good-columns set (values in `ZMod 2`). -/
def rowGood2 (s0 : ℕ) (tau : Fin (2 * s0 + 1) → ZMod 2) : Prop :=
  goodColWordRefl s0 (rowStar s0 tau) (rowWord0 s0 tau) (rowWord1 s0 tau)

/-- The bad tuples of one row (complement of the good set inside the cube). -/
def rowBad2 (s0 : ℕ) : Set (Fin (2 * s0 + 1) → ZMod 2) :=
  {tau | ¬ rowGood2 s0 tau}

/-- Lift a `{0,1}`-word to the level-`e` value space. -/
def lift2val {e : ℕ} (t : ZMod 2) : ZMod (2 ^ (e + 1)) := (t.val : ZMod (2 ^ (e + 1)))

/-- Lift a `{0,1}`-word to the level-`e` value space. -/
def lift2word {e : ℕ} {m : ℕ} (tau : Fin m → ZMod 2) : Fin m → ZMod (2 ^ (e + 1)) :=
  fun i => lift2val (e := e) (tau i)

/-- The excluded-pair enumeration of one row: every bad tuple, lifted. -/
noncomputable def rowBadEnum (s0 e : ℕ) :
    Fin (Fintype.card (rowBad2 s0)) → (Fin (2 * s0 + 1) → ZMod (2 ^ (e + 1))) :=
  fun l => lift2word (e := e) (((Fintype.equivFin (rowBad2 s0)).symm l).1)

/-! ### Ground facts for the concrete generators (all TBD-free) -/

/-- In `ZMod 2`, doubling is zero. -/
lemma encE0_add_self : encE0 + encE0 = 0 := by
  apply Prod.ext
  · ext <;> simp [encE0]
  · funext i
    exact zmod2_add_self (encGen 0 i)
lemma encE1_add_self : encE1 + encE1 = 0 := by
  apply Prod.ext
  · ext <;> simp [encE1]
  · funext i
    exact zmod2_add_self (encGen 1 i)
lemma encE2_add_self : encE2 + encE2 = 0 := by
  apply Prod.ext
  · ext <;> simp [encE2]
  · funext i
    exact zmod2_add_self (encGen 2 i)

lemma encE0_two_zsmul : (2 : ℤ) • encE0 = 0 := by
  rw [two_zsmul]
  exact encE0_add_self
lemma encE1_two_zsmul : (2 : ℤ) • encE1 = 0 := by
  rw [two_zsmul]
  exact encE1_add_self
lemma encE2_two_zsmul : (2 : ℤ) • encE2 = 0 := by
  rw [two_zsmul]
  exact encE2_add_self

/-- The parity directions are independent over `Z`. -/
lemma encE_independent (r s t : ℤ) (h : r • encE0 + s • encE1 + t • encE2 = 0) :
    Even r ∧ Even s ∧ Even t := by
  constructor
  · have h0 := congrArg (fun x : EncodeG => ((x.2 0) : ZMod 2)) h
    have hc : (r : ZMod 2) = 0 := by
      simpa [encE0, encE1, encE2, encGen, zsmul_eq_mul] using h0
    exact (even_iff_two_dvd).mpr ((ZMod.intCast_zmod_eq_zero_iff_dvd (a := r) (b := 2)).mp hc)
  · constructor
    · have h1 := congrArg (fun x : EncodeG => ((x.2 1) : ZMod 2)) h
      have hc : (s : ZMod 2) = 0 := by
        simpa [encE0, encE1, encE2, encGen, zsmul_eq_mul] using h1
      exact (even_iff_two_dvd).mpr ((ZMod.intCast_zmod_eq_zero_iff_dvd (a := s) (b := 2)).mp hc)
    · have h2 := congrArg (fun x : EncodeG => ((x.2 2) : ZMod 2)) h
      have hc : (t : ZMod 2) = 0 := by
        simpa [encE0, encE1, encE2, encGen, zsmul_eq_mul] using h2
      exact (even_iff_two_dvd).mpr ((ZMod.intCast_zmod_eq_zero_iff_dvd (a := t) (b := 2)).mp hc)

/-- Lifting `0` gives `0`. -/
lemma lift2val_zero (e : ℕ) : lift2val (e := e) (0 : ZMod 2) = 0 := by
  simp [lift2val]

/-- Lifting `1` gives `1`. -/
lemma lift2val_one (e : ℕ) : lift2val (e := e) (1 : ZMod 2) = 1 := by
  dsimp [lift2val]
  have hv : (1 : ZMod 2).val = 1 := by decide
  rw [hv]
  simp

/-- Lifted words are `{0,1}`-valued. -/
lemma rowBadEnum_01 (s0 e : ℕ) :
    ∀ l : Fin (Fintype.card (rowBad2 s0)),
      ∀ i : Fin (2 * s0 + 1), rowBadEnum s0 e l i = 0 ∨ rowBadEnum s0 e l i = 1 := by
  intro l i
  have hbit : ((Fintype.equivFin (rowBad2 s0)).symm l).1 i = 0 ∨
              ((Fintype.equivFin (rowBad2 s0)).symm l).1 i = 1 :=
    zmod2_eq_zero_or_one _
  rcases hbit with hz | ho
  · left
    dsimp [rowBadEnum, lift2word]
    rw [hz]
    exact lift2val_zero e
  · right
    dsimp [rowBadEnum, lift2word]
    rw [ho]
    exact lift2val_one e



/-! ### Pinned target T2 (per-row `P_OmegaTilde_gc`, WIP: statement only, `TBD`)

Weak expressibility over the concrete ambient group of `P_OmegaTilde` for the
good-columns constraint of one row: `sb_POmegaFull encE0 encE1 encE2` with the
excluded-pairs set `sb_OmegaExcl (rowBadEnum s0 e)`.  The proof (next session) is the
instantiation of `sb_POmegaFull_excl_weakExpressible` at `n := s0` together with the
concrete parity facts `h2v/h2p/h2q/hind` for `encE0, encE1, encE2` and a finite
spanning set `gens` of `EncodeG`. -/
theorem OmegaTilde_gcRow_weakExpressible {d s0 : ℕ} (e : ℕ) (he : 1 ≤ e) (hs0 : 1 ≤ s0)
    (gens : Fin d → EncodeG) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (hbig : 4 * s0 < 2 ^ (e + 1)) :
    WeakExpressible (2 * s0 + 1)
      (fun alpha : EncodeG → (Fin (2 * s0 + 1) → ZMod (2 ^ (e + 1))) =>
        sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (rowBadEnum s0 e)) alpha) := by
  exact sb_POmegaFull_excl_weakExpressible (d := d) (n := s0)
    (L := Fintype.card (rowBad2 s0)) e he hs0 encE0 encE1 encE2 encE0_two_zsmul
    encE1_two_zsmul encE2_two_zsmul encE_independent gens hpos hspan hbig
    (rowBadEnum s0 e) (rowBadEnum_01 s0 e)

/-! ### T3 support: lifting/bit algebra, reflection symmetry, enumeration -/

/-- `1 ≠ 0` in the level-`e` value space. -/
lemma one_ne_zmod_pow_two (e : Nat) : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := by
  intro hz
  have hd : ((2 ^ (e + 1) : Nat) : Int) ∣ (1 : Int) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (a := (1 : Int)) (b := 2 ^ (e + 1))).mp (by simpa using hz)
  have hle : ((2 ^ (e + 1) : Nat) : Int) ≤ (1 : Int) :=
    Int.le_of_dvd (by norm_num : (0 : Int) < 1) hd
  have hgeN : (2 : Nat) ≤ 2 ^ (e + 1) := by
    have hp : 2 ^ 1 ≤ 2 ^ (e + 1) := pow_le_pow_right₀ (by norm_num) (by omega : 1 ≤ e + 1)
    simpa using hp
  have hge : (2 : Int) ≤ ((2 ^ (e + 1) : Nat) : Int) := by exact_mod_cast hgeN
  omega

/-- The lift is injective. -/
lemma lift2val_injective (e : Nat) : Function.Injective (lift2val (e := e)) := by
  intro a b h
  rcases zmod2_eq_zero_or_one a with ha | ha
  · rcases zmod2_eq_zero_or_one b with hb | hb
    · rw [ha, hb]
    · exfalso
      have hz : (1 : ZMod (2 ^ (e + 1))) = 0 := by
        rw [ha, hb, lift2val_zero, lift2val_one] at h
        exact h.symm
      exact one_ne_zmod_pow_two e hz
  · rcases zmod2_eq_zero_or_one b with hb | hb
    · exfalso
      have hz : (1 : ZMod (2 ^ (e + 1))) = 0 := by
        rw [ha, hb, lift2val_zero, lift2val_one] at h
        exact h
      exact one_ne_zmod_pow_two e hz
    · rw [ha, hb]

/-- The word lift is injective. -/
lemma lift2word_injective {e m : Nat} : Function.Injective (lift2word (e := e) (m := m)) := by
  intro a b h
  funext i
  exact lift2val_injective e (congrFun h i)

/-- Reflection commutes with complement on `{0,1}` values. -/
lemma encReflectVal_compl (a t : ZMod 2) :
    encReflectVal (1 - a) (1 - t) = encReflectVal a t := by
  rcases zmod2_eq_zero_or_one a with rfl | rfl <;>
    rcases zmod2_eq_zero_or_one t with rfl | rfl <;>
      simp [encReflectVal, zmod2_add_self]

/-- Reflection of the complemented word is the reflection of the word (word level). -/
lemma encReflect_shift {s0 : Nat} (wStar : ZMod 2) (w : Fin s0 → ZMod 2) :
    encReflect (1 - wStar) (fun i => 1 - w i) = encReflect wStar w := by
  funext i
  simp [encReflect, encReflectVal_compl]

/-- The per-row good condition is reflection-invariant at the word level. -/
lemma goodColWordRefl_compl (s0 : Nat) (wStar : ZMod 2) (w0 w1 : Fin s0 → ZMod 2) :
    goodColWordRefl s0 (1 - wStar) (fun i => 1 - w0 i) (fun i => 1 - w1 i) ↔
      goodColWordRefl s0 wStar w0 w1 := by
  unfold goodColWordRefl
  rw [encReflect_shift wStar w0, encReflect_shift wStar w1]

/-- Complementing a lift is the lift of the complement. -/
lemma lift2val_compl (e : Nat) (t : ZMod 2) :
    lift2val (e := e) (1 - t) = 1 - lift2val (e := e) t := by
  rcases zmod2_eq_zero_or_one t with rfl | rfl
  · rw [sub_zero, lift2val_zero, lift2val_one]
    simp
  · rw [sub_self, lift2val_zero, lift2val_one]
    simp

/-- The whole row is good iff its complement is. -/
lemma rowGood2_reflect (s0 : Nat) (tau : Fin (2 * s0 + 1) → ZMod 2) :
    rowGood2 s0 (fun i => 1 - tau i) ↔ rowGood2 s0 tau := by
  unfold rowGood2
  have hstar : rowStar s0 (fun i => 1 - tau i) = 1 - rowStar s0 tau := rfl
  have hw0 : rowWord0 s0 (fun i => 1 - tau i) = fun b => 1 - rowWord0 s0 tau b := rfl
  have hw1 : rowWord1 s0 (fun i => 1 - tau i) = fun b => 1 - rowWord1 s0 tau b := rfl
  rw [hstar, hw0, hw1]
  exact goodColWordRefl_compl s0 (rowStar s0 tau) (rowWord0 s0 tau) (rowWord1 s0 tau)

/-- The bit conversion of a `{0,1}`-valued word. -/
def rowBits {m e : Nat} (tau : Fin m → ZMod (2 ^ (e + 1))) : Fin m → ZMod 2 :=
  fun i => if tau i = 0 then (0 : ZMod 2) else 1

/-- Lifting the bits recovers a `{0,1}`-valued word. -/
lemma lift2word_bit {e m : Nat} (tau : Fin m → ZMod (2 ^ (e + 1)))
    (h01 : ∀ i : Fin m, tau i = 0 ∨ tau i = 1) :
    lift2word (e := e) (rowBits (e := e) tau) = tau := by
  funext i
  dsimp [lift2word, rowBits]
  rcases h01 i with hz | ho
  · rw [hz]
    simp [lift2val]
  · rw [ho]
    have hnz : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zmod_pow_two e
    have hif : (if (1 : ZMod (2 ^ (e + 1))) = 0 then (0 : ZMod 2) else 1) = (1 : ZMod 2) := if_neg hnz
    rw [hif]
    exact lift2val_one e

/-- The enumeration covers every bad word. -/
lemma rowBadEnum_surj (s0 e : Nat) (b : rowBad2 s0) :
    ∃ l : Fin (Fintype.card (rowBad2 s0)), rowBadEnum s0 e l = lift2word (e := e) b.1 := by
  refine ⟨Fintype.equivFin (rowBad2 s0) b, ?_⟩
  dsimp [rowBadEnum]
  have hb : (Fintype.equivFin (rowBad2 s0)).symm (Fintype.equivFin (rowBad2 s0) b) = b := by simp
  rw [hb]


/-! ### Pinned target T3 (set identity behind T2, WIP: statement only, `TBD`)

On `{0,1}`-valued words the excluded-pairs set equals the row good-columns set: this is
the extensional identity that makes T2 literally "P of `OmegaTilde_gcRow`". -/
theorem sb_OmegaExcl_rowBadEnum_eq_gcRow {s0 e : ℕ} :
    (sb_OmegaExcl (rowBadEnum s0 e) : Set (Fin (2 * s0 + 1) → ZMod (2 ^ (e + 1)))) =
      {tau | (∀ i : Fin (2 * s0 + 1), tau i = 0 ∨ tau i = 1) ∧
        rowGood2 s0 (fun i => if tau i = 0 then (0 : ZMod 2) else 1)} := by
  classical
  ext tau
  constructor
  · intro hL
    rcases hL with ⟨h01, hexcl⟩
    refine ⟨h01, ?_⟩
    change rowGood2 s0 (rowBits (e := e) tau)
    by_contra hbad
    have hb : rowBits (e := e) tau ∈ rowBad2 s0 := by
      change ¬ rowGood2 s0 (rowBits (e := e) tau)
      exact hbad
    let b : rowBad2 s0 := ⟨rowBits (e := e) tau, hb⟩
    rcases rowBadEnum_surj s0 e b with ⟨l, hl⟩
    have htau : rowBadEnum s0 e l = tau := by
      calc
        rowBadEnum s0 e l = lift2word (e := e) b.1 := hl
        _ = lift2word (e := e) (rowBits (e := e) tau) := by rfl
        _ = tau := lift2word_bit (e := e) tau h01
    exact (hexcl l).1 (by intro i; rw [← htau])
  · intro hR
    rcases hR with ⟨h01, hgood⟩
    refine ⟨h01, ?_⟩
    intro l
    constructor
    · intro hE
      have ht : tau = rowBadEnum s0 e l := by funext i; exact hE i
      let b : rowBad2 s0 := (Fintype.equivFin (rowBad2 s0)).symm l
      have hl : rowBadEnum s0 e l = lift2word (e := e) b.1 := rfl
      have hEq : lift2word (e := e) (rowBits (e := e) tau) = lift2word (e := e) b.1 := by
        calc
          lift2word (e := e) (rowBits (e := e) tau) = tau := lift2word_bit (e := e) tau h01
          _ = rowBadEnum s0 e l := ht
          _ = lift2word (e := e) b.1 := hl
      have hbit : rowBits (e := e) tau = b.1 := lift2word_injective (e := e) hEq
      have hbad : ¬ rowGood2 s0 (rowBits (e := e) tau) := by
        intro hg
        exact b.2 (by rwa [hbit] at hg)
      exact hbad hgood
    · intro hE
      have ht : tau = (fun i => 1 - rowBadEnum s0 e l i) := by funext i; exact hE i
      let b : rowBad2 s0 := (Fintype.equivFin (rowBad2 s0)).symm l
      have hl : rowBadEnum s0 e l = lift2word (e := e) b.1 := rfl
      have hre : (fun i => 1 - rowBadEnum s0 e l i) = lift2word (e := e) (fun i => 1 - b.1 i) := by
        funext i
        exact (lift2val_compl e (b.1 i)).symm
      have hEq : lift2word (e := e) (rowBits (e := e) tau) = lift2word (e := e) (fun i => 1 - b.1 i) := by
        calc
          lift2word (e := e) (rowBits (e := e) tau) = tau := lift2word_bit (e := e) tau h01
          _ = (fun i => 1 - rowBadEnum s0 e l i) := ht
          _ = lift2word (e := e) (fun i => 1 - b.1 i) := hre
      have hbit : rowBits (e := e) tau = (fun i => 1 - b.1 i) := lift2word_injective (e := e) hEq
      have hbad : ¬ rowGood2 s0 (rowBits (e := e) tau) := by
        intro hg
        have hgprime : rowGood2 s0 (fun i => 1 - b.1 i) := by rwa [hbit] at hg
        exact b.2 ((rowGood2_reflect s0 b.1).mp hgprime)
      exact hbad hgood



end
end Commons.PeriodicTiling


