attribute [local instance] Classical.propDecidable

/-! # Phase 3 encode, layer 3 — property S (WIP)

`S` is the encode's full weakly-expressible property over the `Fin (BoardW s0 N)`-tuple
functions: the conjunction of (a) the full-board `P_OmegaTilde_gc` (T4), (b) the
per-coordinate periodicity along each tile's row-dependent direction, and (c) the
row-0 boolean periodized permutation for every row (T8).

This file starts with the ONE genuinely new piece: the `Fin (BoardW s0 N)`-indexed
direction map `rowDirMap` for axiom (b) — coordinate 0 (`alpha_*`) gets the zero
direction (periodicity along 0 is vacuous), every tile coordinate gets
`((-rowVal n, 1), (0,0,0))` with the row `n` read off the tile. -/

/-- The direction `((-rowVal n, 1), (0,0,0))` of a tile's row. -/
def rowDirOfTile {s0 N : Nat} (t : TileIdx s0 N) : EncodeG :=
  (((-(rowVal t.2.2)), (1 : Int)), fun _ : Fin 3 => 0)

/-- The tile whose coordinate is `k` (any non-zero coordinate). -/
def coordTile {s0 N : Nat} (k : Fin (BoardW s0 N)) (hk : k.val ≠ 0) : TileIdx s0 N :=
  (tileFinEquiv s0 N).symm ⟨k.val - 1, by
    have h1 : 1 ≤ k.val := by omega
    have h2 : k.val ≤ 2 * (s0 * N) := by
      have hlt := k.isLt
      dsimp [BoardW] at hlt
      omega
    omega⟩

/-- The axiom-(b) direction map: zero at coordinate 0, the row direction on tiles. -/
def rowDirMap {s0 N : Nat} (k : Fin (BoardW s0 N)) : EncodeG :=
  if h : k.val = 0 then 0 else rowDirOfTile (coordTile k h)

/-- Any coordinate whose value is zero carries the zero direction. -/
lemma rowDirMap_zero {s0 N : Nat} (k : Fin (BoardW s0 N)) (hk : k.val = 0) :
    rowDirMap k = 0 := by
  rw [rowDirMap, dif_pos hk]

/-- The characteristic lemma: the direction at a tile coordinate is the tile's row
direction (the row read off the tile). -/
lemma rowDirMap_tile {s0 N : Nat} (t : TileIdx s0 N) :
    rowDirMap (tileCoord t) = rowDirOfTile t := by
  dsimp [rowDirMap]
  rw [dif_neg (tileCoord_ne_zero t)]
  apply congrArg rowDirOfTile
  unfold coordTile
  have harg : (⟨(tileCoord t).val - 1, by
        have h0 := (tileCoord t).isLt
        have hz := tileCoord_ne_zero t
        change (1 + (tileFinEquiv s0 N t).val) - 1 < 2 * (s0 * N)
        dsimp [BoardW] at h0
        omega⟩ : Fin (2 * (s0 * N))) = tileFinEquiv s0 N t := by
    apply Fin.ext
    dsimp [tileCoord]
    omega
  rw [harg]
  simp


/-! ## The axiom-(b) instance

Axiom (b): every `alpha_{a,b,n}` (every tile coordinate) is periodic along its row
direction `((-rowVal n, 1), (0,0,0))`; coordinate 0 (`alpha_*`) is included vacuously
(direction 0).  This is exactly T1 (`encode_periodic_eachCoord_weakExpressible`)
instantiated with `dir := rowDirMap` at the full board width. -/
lemma encode_rowPeriodic_weakExpressible {s0 N : Nat} (e : Nat) (he : 1 ≤ e) :
    WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        ∀ w : Fin (BoardW s0 N), periodicAlong (rowDirMap w) (coord alpha w)) := by
  exact encode_periodic_eachCoord_weakExpressible (K := BoardW s0 N) e he (rowDirMap (s0 := s0) (N := N))



/-! ## Property S (the encode's full weakly-expressible property)

Conjunction of (a) the full-board `P_OmegaTilde_gc` (T4), (b) the per-coordinate
row-periodicity (this file), and (c) the all-rows boolean periodized permutation (T8),
as a property of the full-tuple function over `Fin (BoardW s0 N)`. -/
def encodePropS {e s0 N : Nat}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))) : Prop :=
  sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (boardBadFullEnum s0 N e)) alpha ∧
    ((∀ w : Fin (BoardW s0 N), periodicAlong (rowDirMap w) (coord alpha w)) ∧
     ∀ n : Fin N, BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX (row0Sel (e := e) alpha n))

/-- Property S is weakly expressible (conjunction of the (a), (b), (c) instances). -/
theorem encodePropS_weakExpressible {d s0 N : Nat} (e : Nat) (he : 1 ≤ e)
    (hs0 : 1 ≤ s0) (hN : 1 ≤ N)
    (gens : Fin d → EncodeG) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (hbig : 4 * (s0 * N) < 2 ^ (e + 1)) :
    WeakExpressible (BoardW s0 N) (encodePropS (e := e) (s0 := s0) (N := N)) := by
  have hA : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (boardBadFullEnum s0 N e)) alpha) := by
    exact OmegaTilde_gcFull_weakExpressible (d := d) (s0 := s0) (N := N) e he hs0 hN gens hpos hspan hbig
  have hB : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        ∀ w : Fin (BoardW s0 N), periodicAlong (rowDirMap w) (coord alpha w)) :=
    encode_rowPeriodic_weakExpressible (s0 := s0) (N := N) e he
  have hC : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        ∀ n : Fin N, BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX (row0Sel (e := e) alpha n)) := by
    exact rowAll_BoolPeriodizedPerm_weakExpressible (d := d) (s0 := s0) (N := N) e he gens hpos hspan
  have hBC : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        (∀ w : Fin (BoardW s0 N), periodicAlong (rowDirMap w) (coord alpha w)) ∧
        ∀ n : Fin N, BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX (row0Sel (e := e) alpha n)) := by
    exact weakExpressible_conj (K := BoardW s0 N) hB hC
  exact weakExpressible_conj (K := BoardW s0 N) hA hBC


end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
open scoped Pointwise
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Phase 3 encode, layer 4 — satisfiability of property S (WIP)

The paper's proof of Theorem main-aperiod-tuple-weak (tex 1176-1197) has two halves:
satisfiability (build ONE tuple obeying `S` from the standard Sudoku solution) and
aperiodicity (decode any `S`-tuple to a Sudoku solution with good columns, and feed
`main_sudoku_no_verticalPeriod`).  This file is the satisfiability half.

The construction (paper, with `sigma_n = id` for the standard solution):
- the standard Sudoku solution `F(n,m) = f_q(m)` has good columns with `sigma = id`;
- boolean functions `beta_{a,b,n} : Z^2 -> {0,1}`, for `a = 0,1`, `b : Fin s0`,
  `n : Fin N`, are defined by the binary identities
      `B(beta_{0,.,n}(i,j)) = (j * rowVal n + i  mod  q)`
      `B(beta_{1,.,n}(i,j)) = F(n, j * rowVal n + i) = f_q(j * rowVal n + i)`;
- the tuple `alpha : EncodeG -> (Fin (BoardW s0 N) -> ZMod (2^(e+1)))`:
  coordinate 0 reads the `e`-parity bit of the point; the tile `(a,b,n)` reads
  `lift2val (epsilon + beta_{a,b,n} (plane x))` (the reflection `R_eps`).

This file (as of now): Part 1 — the binary-digit library over `ZMod (2^s0)`:
`natDigit`/`zmodDigit`, the reconstruction identity (`sum of digit * 2^b = n` for
`n < 2^s0`), and the bijectivity of the binary encoding map `encB`. -/

/-! ## Part 1: binary digits -/

/-- The `b`-th binary digit of a natural number. -/
def natDigit (b n : ℕ) : ℕ := (n / 2 ^ b) % 2

/-- A binary digit is `0` or `1`. -/
lemma natDigit_le_one (b n : ℕ) : natDigit b n ≤ 1 := by
  dsimp [natDigit]
  have h := Nat.mod_lt (n / 2 ^ b) (by decide : 0 < 2)
  omega

/-- A binary digit is `0` or `1` (stronger form). -/
lemma natDigit_eq_zero_or_one (b n : ℕ) : natDigit b n = 0 ∨ natDigit b n = 1 := by
  have h := natDigit_le_one b n
  omega

/-- Digits of a small number above `b` vanish. -/
lemma natDigit_of_lt {b n : ℕ} (h : n < 2 ^ b) : natDigit b n = 0 := by
  dsimp [natDigit]
  rw [Nat.div_eq_of_lt h, Nat.zero_mod]

/-- The digit at position `0` is the parity. -/
lemma natDigit_zero (n : ℕ) : natDigit 0 n = n % 2 := by
  dsimp [natDigit]
  simp

/-- Shifting right by one moves the digits down: `natDigit (n+1) (2*m) = natDigit n m`. -/
lemma natDigit_succ_two_mul (n m : ℕ) : natDigit (n + 1) (2 * m) = natDigit n m := by
  dsimp [natDigit]
  have hdiv : (2 * m) / 2 ^ (n + 1) = m / 2 ^ n := by
    rw [pow_succ']
    rw [← Nat.div_div_eq_div_mul]
    rw [Nat.mul_div_cancel_left m (by decide : 0 < 2)]
  rw [hdiv]

/-- Digits above `0` of `w + 2*m` (for `w < 2`) are the digits of `m`. -/
lemma natDigit_succ_add_two_mul (n : ℕ) {w m : ℕ} (hw : w < 2) :
    natDigit (n + 1) (w + 2 * m) = natDigit n m := by
  dsimp [natDigit]
  have hdiv : (w + 2 * m) / 2 ^ (n + 1) = m / 2 ^ n := by
    rw [pow_succ']
    rw [← Nat.div_div_eq_div_mul]
    have h2 : (w + 2 * m) / 2 = m := by
      rw [Nat.add_mul_div_left w m (by decide : 0 < 2)]
      rw [Nat.div_eq_of_lt hw]
      simp
    rw [h2]
  rw [hdiv]

/-- The digit at `0` of `w + 2*m` (for `w < 2`) is `w`. -/
lemma natDigit_zero_add_two_mul {w m : ℕ} (hw : w < 2) : natDigit 0 (w + 2 * m) = w := by
  rw [natDigit_zero]
  have hwmod : w % 2 = w := Nat.mod_eq_of_lt hw
  have hm : (2 * m) % 2 = 0 := by
    rw [Nat.mul_mod_right]
  rw [Nat.add_mod, hwmod, hm]
  change w % 2 = w
  exact Nat.mod_eq_of_lt hw

/-- The digit expansion of `n < 2^s0` reconstructs `n`. -/
theorem nat_sum_digits (s0 n : ℕ) (hn : n < 2 ^ s0) :
    (∑ b : Fin s0, natDigit b.val n * 2 ^ b.val) = n := by
  induction s0 generalizing n with
  | zero =>
      have hn0 : n = 0 := by omega
      simp [hn0]
  | succ s0 ih =>
      have hq : n / 2 < 2 ^ s0 := by
        rw [pow_succ] at hn
        exact (Nat.div_lt_iff_lt_mul (by decide : 0 < 2)).mpr (by
          simpa [mul_comm] using hn)
      have hrec : (∑ b : Fin s0, natDigit b.val (n / 2) * 2 ^ b.val) = n / 2 :=
        ih (n / 2) hq
      have hpeel : (∑ b : Fin (s0 + 1), natDigit b.val n * 2 ^ b.val) =
          n % 2 + 2 * (∑ b : Fin s0, natDigit b.val (n / 2) * 2 ^ b.val) := by
        rw [Fin.sum_univ_succ]
        have hrest : (∑ b : Fin s0,
            natDigit (Fin.succ b).val n * 2 ^ (Fin.succ b).val) =
            2 * (∑ b : Fin s0, natDigit b.val (n / 2) * 2 ^ b.val) := by
          calc
            (∑ b : Fin s0, natDigit (Fin.succ b).val n * 2 ^ (Fin.succ b).val)
                = (∑ b : Fin s0, natDigit (b.val + 1) n * 2 ^ (b.val + 1)) := by
                    apply Finset.sum_congr rfl
                    intro b hb
                    have hv1 : (Fin.succ b).val = b.val + 1 := by simp
                    have h1 : natDigit (Fin.succ b).val n = natDigit (b.val + 1) n := by
                      rw [hv1]
                    have h2 : 2 ^ (Fin.succ b).val = 2 ^ (b.val + 1) := by rw [hv1]
                    rw [h1, h2]
            _ = (∑ b : Fin s0, natDigit b.val (n / 2) * 2 * 2 ^ b.val) := by
                    apply Finset.sum_congr rfl
                    intro b hb
                    have hdn : n = n % 2 + 2 * (n / 2) := by rw [Nat.mod_add_div]
                    have hd : natDigit (b.val + 1) n = natDigit b.val (n / 2) := by
                      conv_lhs => rw [hdn]
                      exact natDigit_succ_add_two_mul b.val (w := n % 2) (m := n / 2)
                        (Nat.mod_lt n (by decide : 0 < 2))
                    have hp : 2 ^ (b.val + 1) = 2 * 2 ^ b.val := by
                      rw [pow_succ']
                    rw [hd, hp]
                    ring
            _ = (∑ b : Fin s0, 2 * (natDigit b.val (n / 2) * 2 ^ b.val)) := by
                    apply Finset.sum_congr rfl
                    intro b hb
                    ring
            _ = 2 * (∑ b : Fin s0, natDigit b.val (n / 2) * 2 ^ b.val) := by
                    rw [Finset.mul_sum]
        have h0 : natDigit (0 : Fin (s0 + 1)).val n * 2 ^ (0 : Fin (s0 + 1)).val = n % 2 := by
          simp [natDigit_zero]
        rw [h0, hrest]
      rw [hpeel, hrec]
      exact Nat.mod_add_div n 2

/-- The geometric sum `sum_{c < s0} 2^c = 2^s0 - 1`. -/
lemma geom_sum_two_pow (s0 : ℕ) : (∑ c ∈ Finset.range s0, 2 ^ c) = 2 ^ s0 - 1 := by
  induction s0 with
  | zero => simp
  | succ s0 ih =>
      rw [Finset.sum_range_succ, ih]
      rw [pow_succ]
      omega

/-- Any word's binary value is below `2^s0`. -/
lemma wordSum_lt {s0 : ℕ} (w : Fin s0 → ZMod 2) :
    (∑ c : Fin s0, (w c).val * 2 ^ c.val) < 2 ^ s0 := by
  classical
  have hle : ∀ c : Fin s0, (w c).val * 2 ^ c.val ≤ 1 * 2 ^ c.val := by
    intro c
    have hw : (w c).val ≤ 1 := by
      have hlt := ZMod.val_lt (w c)
      omega
    exact Nat.mul_le_mul_right (2 ^ c.val) hw
  calc
    (∑ c : Fin s0, (w c).val * 2 ^ c.val) ≤ ∑ c : Fin s0, 1 * 2 ^ c.val := by
      exact Finset.sum_le_sum (fun c hc => hle c)
    _ = ∑ c : Fin s0, 2 ^ c.val := by
      apply Finset.sum_congr rfl
      intro c hc
      simp
    _ < 2 ^ s0 := by
      have hgeom : (∑ c : Fin s0, 2 ^ c.val) = 2 ^ s0 - 1 := by
        rw [Fin.sum_univ_eq_sum_range]
        exact geom_sum_two_pow s0
      rw [hgeom]
      exact Nat.sub_lt (by positivity : 0 < 2 ^ s0) (by decide : 0 < 1)

/-- The canonical representative of `encB w` is the word's binary value. -/
lemma encB_val_eq {s0 : ℕ} (w : Fin s0 → ZMod 2) :
    (encB w).val = ∑ c : Fin s0, (w c).val * 2 ^ c.val := by
  haveI : NeZero (2 ^ s0) := ⟨by positivity⟩
  change ((∑ c : Fin s0, (w c).val * 2 ^ c.val : ℕ) : ZMod (2 ^ s0)).val =
    ∑ c : Fin s0, (w c).val * 2 ^ c.val
  rw [ZMod.val_natCast (2 ^ s0)]
  rw [Nat.mod_eq_of_lt (wordSum_lt w)]

/-- Reading the digits of the binary value of a word recovers the word. -/
lemma natDigit_sum_word {s0 : ℕ} (w : Fin s0 → ZMod 2) (b : Fin s0) :
    natDigit b.val (∑ c : Fin s0, (w c).val * 2 ^ c.val) = (w b).val := by
  classical
  induction s0 with
  | zero => exact False.elim (Fin.elim0 b)
  | succ s0 ih =>
      have hw0 : (w 0).val < 2 := by
        have hlt := ZMod.val_lt (w 0)
        omega
      -- peel off the bottom bit (used in both cases of b)
      have hpeel : (∑ c : Fin (s0 + 1), (w c).val * 2 ^ c.val) =
          (w 0).val + 2 * (∑ c : Fin s0, (w (Fin.succ c)).val * 2 ^ c.val) := by
        rw [Fin.sum_univ_succ]
        have h0 : (w 0).val * 2 ^ (0 : Fin (s0 + 1)).val = (w 0).val := by
          simp
        rw [h0]
        congr 1
        calc
          (∑ c : Fin s0, (w (Fin.succ c)).val * 2 ^ (Fin.succ c).val)
              = (∑ c : Fin s0, (w (Fin.succ c)).val * 2 ^ (c.val + 1)) := by
                  apply Finset.sum_congr rfl
                  intro c hc
                  have hv : (Fin.succ c).val = c.val + 1 := by simp
                  have h1 : (w (Fin.succ c)).val = (w (Fin.succ c)).val := rfl
                  have h2 : 2 ^ (Fin.succ c).val = 2 ^ (c.val + 1) := by rw [hv]
                  rw [h1, h2]
          _ = (∑ c : Fin s0, 2 * ((w (Fin.succ c)).val * 2 ^ c.val)) := by
                  apply Finset.sum_congr rfl
                  intro c hc
                  rw [pow_succ']
                  ring
          _ = 2 * (∑ c : Fin s0, (w (Fin.succ c)).val * 2 ^ c.val) := by
                  rw [Finset.mul_sum]
      by_cases hb0 : b.val = 0
      · have hb : b = (0 : Fin (s0 + 1)) := Fin.ext hb0
        subst b
        rw [hpeel]
        exact natDigit_zero_add_two_mul hw0
      · let b' : Fin s0 := ⟨b.val - 1, by omega⟩
        have hbval : b.val = b'.val + 1 := by
          dsimp [b']
          omega
        rw [hpeel]
        rw [hbval]
        rw [natDigit_succ_add_two_mul b'.val hw0]
        let w' : Fin s0 → ZMod 2 := fun c => w (Fin.succ c)
        change natDigit b'.val (∑ c : Fin s0, (w' c).val * 2 ^ c.val) = (w b).val
        rw [ih w' b']
        congr 1
        change w (Fin.succ b') = w b
        congr 1
        apply Fin.ext
        simp [hbval]

/-- `encB` is the binary expansion: reading off digit `b` recovers `w b`. -/
lemma encB_digit {s0 : ℕ} (w : Fin s0 → ZMod 2) (b : Fin s0) :
    natDigit b.val (encB w).val = (w b).val := by
  rw [encB_val_eq]
  exact natDigit_sum_word w b

/-- The `b`-th digit of an element of `ZMod (2^s0)`. -/
def zmodDigit {s0 : ℕ} (b : Fin s0) (u : ZMod (2 ^ s0)) : ZMod 2 :=
  (natDigit b.val u.val : ZMod 2)

/-- Digits read from `encB w` reproduce `w`. -/
lemma zmodDigit_encB {s0 : ℕ} (w : Fin s0 → ZMod 2) (b : Fin s0) :
    zmodDigit b (encB w) = w b := by
  dsimp [zmodDigit]
  have hd : natDigit b.val (encB w).val = (w b).val := encB_digit w b
  rw [hd]
  exact (ZMod.natCast_zmod_val (w b))

/-- The canonical representative of `zmodDigit` is the natural digit. -/
lemma zmodDigit_val {s0 : ℕ} (b : Fin s0) (u : ZMod (2 ^ s0)) :
    (zmodDigit b u).val = natDigit b.val u.val := by
  dsimp [zmodDigit]
  rw [ZMod.val_natCast 2]
  have hle := natDigit_le_one b.val u.val
  omega

/-- `encB` reconstructs an element from its digits. -/
lemma encB_zmodDigit {s0 : ℕ} (u : ZMod (2 ^ s0)) :
    encB (fun b : Fin s0 => zmodDigit b u) = u := by
  dsimp [encB]
  haveI : NeZero (2 ^ s0) := ⟨by positivity⟩
  have hsum : (∑ b : Fin s0, (zmodDigit b u).val * 2 ^ b.val) = u.val := by
    calc
      (∑ b : Fin s0, (zmodDigit b u).val * 2 ^ b.val)
          = (∑ b : Fin s0, natDigit b.val u.val * 2 ^ b.val) := by
              apply Finset.sum_congr rfl
              intro b hb
              rw [zmodDigit_val]
      _ = u.val := nat_sum_digits s0 u.val (ZMod.val_lt u)
  rw [hsum]
  exact ZMod.natCast_zmod_val u

/-- `encB` is a bijection from the binary cube to `ZMod (2^s0)` (with inverse the
digit map). -/
theorem encB_bijective (s0 : ℕ) :
    Function.Bijective (encB : (Fin s0 → ZMod 2) → ZMod (2 ^ s0)) := by
  classical
  constructor
  · intro w1 w2 h
    funext b
    have h1 := zmodDigit_encB w1 b
    have h2 := zmodDigit_encB w2 b
    rw [h] at h1
    exact h1.symm.trans h2
  · intro u
    refine ⟨fun b : Fin s0 => zmodDigit b u, ?_⟩
    exact encB_zmodDigit u

/-- The digit map is injective from `ZMod (2^s0)` to the cube. -/
lemma zmodDigit_injective (s0 : ℕ) :
    Function.Injective (fun u : ZMod (2 ^ s0) => fun b : Fin s0 => zmodDigit b u) := by
  intro u v h
  dsimp at h
  have h1 : encB (fun b : Fin s0 => zmodDigit b u) = encB (fun b : Fin s0 => zmodDigit b v) := by
    rw [h]
  rwa [encB_zmodDigit u, encB_zmodDigit v] at h1


/-! ## Part 2: the standard-Sudoku tuple

The satisfying tuple `alphaStd` (paper tex 1177-1192).  `betaWord i j n a` is the
`{0,1}`-word of the `a`-side at the plane point `(i,j)` on the row `n`:
`a = 0` reads the binary digits of the residue `j * rowVal n + i mod q`, `a = 1` reads
the binary digits of the standard-Sudoku value `f_q(j * rowVal n + i)`.  The full word
`stdBitsWord i j eps` at parity `eps` is: coordinate 0 carries `eps`, each tile
`(a,b,n)` carries `eps + betaWord i j n a b` (the reflection `R_eps`).  The tuple
`alphaStd x` lifts that to the level-`e` value space at the point `x` (plane `(i,j)`,
parity bit `x.2 0`). -/

/-- The inverse of `encB`: the binary digits of an element of `ZMod (2^s0)`. -/
def bitsOf {s0 : ℕ} (u : ZMod (2 ^ s0)) : Fin s0 → ZMod 2 :=
  fun b => zmodDigit b u

/-- `encB` of the digits recovers the element. -/
lemma encB_bitsOf {s0 : ℕ} (u : ZMod (2 ^ s0)) : encB (bitsOf u) = u := by
  exact encB_zmodDigit u

/-- Digits of an encoded word reproduce the word. -/
lemma bitsOf_encB {s0 : ℕ} (w : Fin s0 → ZMod 2) : bitsOf (encB w) = w := by
  funext b
  exact zmodDigit_encB w b

/-- The digit map is injective. -/
lemma bitsOf_injective {s0 : ℕ} : Function.Injective (bitsOf : ZMod (2 ^ s0) → Fin s0 → ZMod 2) := by
  intro u v h
  have h1 := congrArg encB h
  rwa [encB_bitsOf, encB_bitsOf] at h1

/-- Digits of equal values are equal. -/
lemma bitsOf_congr {s0 : ℕ} {u v : ZMod (2 ^ s0)} (h : u = v) : bitsOf u = bitsOf v := by
  rw [h]

/-- The `a = 0` (residue-side) bit word of row `n` at the plane point `(i,j)`. -/
def betaWord0 {s0 N : ℕ} (i j : ℤ) (n : Fin N) : Fin s0 → ZMod 2 :=
  bitsOf ((j * rowVal n + i : ℤ) : ZMod (2 ^ s0))

/-- The `a = 1` (Sudoku-value-side) bit word of row `n` at the plane point `(i,j)`. -/
def betaWord1 {s0 N : ℕ} (i j : ℤ) (n : Fin N) : Fin s0 → ZMod 2 :=
  bitsOf (fq (2 ^ s0) (j * rowVal n + i))

/-- The combined `a`-side word (as in the encode, `a : Fin 2`). -/
def betaWord {s0 N : ℕ} (i j : ℤ) (n : Fin N) (a : Fin 2) : Fin s0 → ZMod 2 :=
  if a = 0 then betaWord0 i j n else betaWord1 i j n

/-- The word at a point of the plane with parity `eps`: coordinate 0 carries `eps`,
each tile carries the reflected bit. -/
def stdBitsWord {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) : Fin (BoardW s0 N) → ZMod 2 :=
  fun k =>
    if hk : k.val = 0 then eps
    else
      let t : TileIdx s0 N := coordTile (s0 := s0) (N := N) k hk
      eps + betaWord (i := i) (j := j) t.2.2 t.1 t.2.1

/-- The full tuple `alpha` of property S built from the standard Sudoku solution:
`alphaStd x` lifts `stdBitsWord (x.1.1) (x.1.2) (x.2 0)` to level `e`. -/
def alphaStd {e s0 N : ℕ} (x : EncodeG) : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)) :=
  fun k => lift2val (stdBitsWord (s0 := s0) (N := N) (x.1.1) (x.1.2) (x.2 0) k)

/-- The level-`e` tuple is the lift of the bit word. -/
lemma alphaStd_eq_lift {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) x = lift2word (stdBitsWord (s0 := s0) (N := N) (x.1.1) (x.1.2) (x.2 0)) := by
  funext k
  rfl

/-- `stdBitsWord` is the bit word whose lift is the tuple at the reflected point. -/
lemma stdBitsWord_coord0 {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) :
    stdBitsWord (s0 := s0) (N := N) i j eps ⟨0, by positivity⟩ = eps := by
  simp [stdBitsWord]

/-- At a tile, the word reads the reflected beta bit. -/
lemma stdBitsWord_tile {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) (t : TileIdx s0 N) :
    stdBitsWord (s0 := s0) (N := N) i j eps (tileCoord (s0 := s0) (N := N) t) =
      eps + betaWord (i := i) (j := j) t.2.2 t.1 t.2.1 := by
  dsimp [stdBitsWord]
  rw [dif_neg (tileCoord_ne_zero (s0 := s0) (N := N) t)]
  have harg : coordTile (s0 := s0) (N := N) (tileCoord (s0 := s0) (N := N) t)
      (tileCoord_ne_zero (s0 := s0) (N := N) t) = t := by
    apply (tileFinEquiv_injective (s0 := s0) (N := N))
    -- the underlying Fin indices agree: coordTile's index is (tileCoord t).val - 1
    change (tileFinEquiv s0 N) ((tileFinEquiv s0 N).symm
      (⟨(tileCoord (s0 := s0) (N := N) t).val - 1, by
        have hpos : 1 ≤ (tileCoord (s0 := s0) (N := N) t).val := by
          dsimp [tileCoord]
          omega
        have hlt := (tileCoord (s0 := s0) (N := N) t).isLt
        dsimp [BoardW] at hlt
        omega⟩ : Fin (2 * (s0 * N)))) = tileFinEquiv s0 N t
    simp [tileCoord]
  rw [harg]

/-- The beta word at `a = 0` decodes to the residue. -/
lemma encB_betaWord0 {s0 N : ℕ} (i j : ℤ) (n : Fin N) :
    encB (betaWord0 (s0 := s0) (N := N) i j n) = ((j * rowVal n + i : ℤ) : ZMod (2 ^ s0)) := by
  dsimp [betaWord0]
  exact encB_bitsOf _

/-- The beta word at `a = 1` decodes to the standard Sudoku value. -/
lemma encB_betaWord1 {s0 N : ℕ} (i j : ℤ) (n : Fin N) :
    encB (betaWord1 (s0 := s0) (N := N) i j n) = fq (2 ^ s0) (j * rowVal n + i) := by
  dsimp [betaWord1]
  exact encB_bitsOf _

/-- The two beta words agree where the residue is non-zero. -/
lemma betaWord1_eq_betaWord0_of_nonzero {s0 N : ℕ} (hs0 : 1 ≤ s0) (i j : ℤ) (n : Fin N)
    (h : ((j * rowVal n + i : ℤ) : ZMod (2 ^ s0)) ≠ 0) :
    betaWord1 (s0 := s0) (N := N) i j n = betaWord0 (s0 := s0) (N := N) i j n := by
  have hq : 1 < 2 ^ s0 := by
    have h2 : 2 ≤ 2 ^ s0 := by
      have hp : 2 ^ 1 ≤ 2 ^ s0 := pow_le_pow_right₀ (by norm_num) hs0
      simpa using hp
    omega
  have hnotd : ¬ ((2 ^ s0 : ℕ) : ℤ) ∣ (j * rowVal n + i) := by
    intro hd
    apply h
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (a := j * rowVal n + i) (b := 2 ^ s0)).mpr hd
  have hfv : fq (2 ^ s0) (j * rowVal n + i) = ((j * rowVal n + i : ℤ) : ZMod (2 ^ s0)) :=
    fq_eq_self_of_not_dvd_int (q := 2 ^ s0) hq hnotd
  have hE : encB (betaWord1 (s0 := s0) (N := N) i j n) = encB (betaWord0 (s0 := s0) (N := N) i j n) := by
    rw [encB_betaWord1, encB_betaWord0]
    exact hfv
  calc
    betaWord1 (s0 := s0) (N := N) i j n
        = bitsOf (encB (betaWord1 (s0 := s0) (N := N) i j n)) := (bitsOf_encB (betaWord1 (s0 := s0) (N := N) i j n)).symm
    _ = bitsOf (encB (betaWord0 (s0 := s0) (N := N) i j n)) := by rw [hE]
    _ = betaWord0 (s0 := s0) (N := N) i j n := bitsOf_encB (betaWord0 (s0 := s0) (N := N) i j n)



/-! ## Part 2b: elementary behaviour of `stdBitsWord` and `alphaStd` -/

/-- In `ZMod 2`, `t + 1 = 1 - t`. -/
lemma zmod2_add_one_eq_sub_one (t : ZMod 2) : t + 1 = 1 - t := by
  rcases zmod2_eq_zero_or_one t with rfl | rfl <;> simp [zmod2_add_self]

/-- `-t = t` in `ZMod 2`. -/
lemma zmod2_neg_eq (t : ZMod 2) : -t = t := by
  rcases zmod2_eq_zero_or_one t with rfl | rfl
  · simp
  · have h : (1 : ZMod 2) + 1 = 0 := zmod2_add_self 1
    exact (eq_neg_of_add_eq_zero_left h).symm

/-- Reflecting a `{0,1}`-word by the same bit appearing in its entries is identity. -/
lemma encReflect_eps_add {s0 : ℕ} (eps : ZMod 2) (w : Fin s0 → ZMod 2) :
    encReflect eps (fun b => eps + w b) = w := by
  funext b
  dsimp [encReflect, encReflectVal]
  rw [← add_assoc, zmod2_add_self, zero_add]

/-- The word at coordinate 0 is the parity bit (via `boardStar`). -/
lemma boardStar_stdBitsWord {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) :
    boardStar (s0 := s0) (N := N) (stdBitsWord (s0 := s0) (N := N) i j eps) = eps := by
  dsimp [boardStar]
  exact stdBitsWord_coord0 i j eps

/-- The `a = 0` row word of the standard bits word is `eps + betaWord0`. -/
lemma boardRowWord0_stdBitsWord {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) (n : Fin N) :
    boardRowWord0 (s0 := s0) (N := N) (stdBitsWord (s0 := s0) (N := N) i j eps) n =
      fun b => eps + betaWord0 (s0 := s0) (N := N) i j n b := by
  funext b
  dsimp [boardRowWord0, boardTile]
  rw [stdBitsWord_tile]
  have h : betaWord (i := i) (j := j) n (0 : Fin 2) = betaWord0 (s0 := s0) (N := N) i j n := by
    simp [betaWord]
  rw [h]

/-- The `a = 1` row word of the standard bits word is `eps + betaWord1`. -/
lemma boardRowWord1_stdBitsWord {s0 N : ℕ} (i j : ℤ) (eps : ZMod 2) (n : Fin N) :
    boardRowWord1 (s0 := s0) (N := N) (stdBitsWord (s0 := s0) (N := N) i j eps) n =
      fun b => eps + betaWord1 (s0 := s0) (N := N) i j n b := by
  funext b
  dsimp [boardRowWord1, boardTile]
  rw [stdBitsWord_tile]
  have h : betaWord (i := i) (j := j) n (1 : Fin 2) = betaWord1 (s0 := s0) (N := N) i j n := by
    simp [betaWord]
  rw [h]

/-- Row `n` of the standard bits word is good (good-columns axiom). -/
lemma boardRowGood2_stdBitsWord {s0 N : ℕ} (hs0 : 1 ≤ s0) (i j : ℤ) (eps : ZMod 2)
    (n : Fin N) : boardRowGood2 (s0 := s0) (N := N) (stdBitsWord (s0 := s0) (N := N) i j eps) n := by
  unfold boardRowGood2 goodColWordRefl goodColWord
  rw [boardStar_stdBitsWord, boardRowWord0_stdBitsWord, boardRowWord1_stdBitsWord]
  rw [encReflect_eps_add, encReflect_eps_add]
  intro h
  have hne : ((j * rowVal n + i : ℤ) : ZMod (2 ^ s0)) ≠ 0 := by
    intro hz
    apply h
    rw [encB_betaWord0]
    exact hz
  exact (betaWord1_eq_betaWord0_of_nonzero hs0 i j n hne).symm

/-- The full standard bits word is good (both axioms (i) and (ii)). -/
lemma boardGood2Full_stdBitsWord {s0 N : ℕ} (hs0 : 1 ≤ s0) (i j : ℤ) (eps : ZMod 2) :
    boardGood2Full (s0 := s0) (N := N) (stdBitsWord (s0 := s0) (N := N) i j eps) := by
  constructor
  · intro n
    exact boardRowGood2_stdBitsWord hs0 i j eps n
  · unfold boardScalCond
    -- the decoded row-1 words are exactly the restriction of the standard Sudoku solution
    have hline : (fun n : Fin N => rowWord1Decode (s0 := s0) (N := N)
        (stdBitsWord (s0 := s0) (N := N) i j eps) n) =
        lineRestrict (standardSudoku (2 ^ s0) N) i j := by
      funext n
      unfold rowWord1Decode
      rw [boardStar_stdBitsWord, boardRowWord1_stdBitsWord, encReflect_eps_add]
      dsimp [lineRestrict, standardSudoku, rowVal]
      exact encB_bitsOf _
    rw [hline]
    exact standardSudoku_line_mem (q := 2 ^ s0) (N := N) i j



/-! ## Part 2c: `alphaStd` level — parity shifts, periodicity, and membership in `Omega` -/

/-- `rowBits` of a lifted `{0,1}`-word is the word itself. -/
lemma rowBits_lift2word {e m : ℕ} (w : Fin m → ZMod 2) : rowBits (lift2word (e := e) w) = w := by
  funext k
  by_cases hw : w k = 0
  · simp [rowBits, lift2word, lift2val_zero, hw]
  · have h1 : w k = 1 := by
      rcases zmod2_eq_zero_or_one (w k) with h0 | h1
      · exact False.elim (hw h0)
      · exact h1
    simp [rowBits, lift2word, lift2val_one, h1, one_ne_zmod_pow_two]

/-- `alphaStd` is `{0,1}`-valued at every coordinate. -/
lemma alphaStd_01 {e s0 N : ℕ} (x : EncodeG) (k : Fin (BoardW s0 N)) :
    alphaStd (e := e) (s0 := s0) (N := N) x k = 0 ∨ alphaStd (e := e) (s0 := s0) (N := N) x k = 1 := by
  dsimp [alphaStd]
  rcases zmod2_eq_zero_or_one (stdBitsWord (s0 := s0) (N := N) (x.1.1) (x.1.2) (x.2 0) k) with h0 | h1
  · left
    rw [h0, lift2val_zero]
  · right
    rw [h1, lift2val_one]

/-- `rowBits` of the tuple recovers the underlying bits word. -/
lemma rowBits_alphaStd {e s0 N : ℕ} (x : EncodeG) :
    rowBits (alphaStd (e := e) (s0 := s0) (N := N) x) =
      stdBitsWord (s0 := s0) (N := N) (x.1.1) (x.1.2) (x.2 0) := by
  rw [alphaStd_eq_lift]
  exact rowBits_lift2word _

/-- The tuple depends only on the plane point and the `e`-parity bit. -/
lemma alphaStd_congr {e s0 N : ℕ} {x y : EncodeG}
    (h1 : x.1.1 = y.1.1) (h2 : x.1.2 = y.1.2) (h3 : x.2 0 = y.2 0) :
    alphaStd (e := e) (s0 := s0) (N := N) x = alphaStd (e := e) (s0 := s0) (N := N) y := by
  funext k
  dsimp [alphaStd]
  rw [h1, h2, h3]

/-- Flipping the parity bit reflects the tuple coordinatewise (as a complement). -/
lemma alphaStd_e0 {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) (x + encE0) =
      fun k => 1 - alphaStd (e := e) (s0 := s0) (N := N) x k := by
  funext k
  dsimp [alphaStd]
  simp [encE0, encGen]
  have hs : stdBitsWord (s0 := s0) (N := N) x.1.1 x.1.2 (x.2 0 + 1) k =
      1 - stdBitsWord (s0 := s0) (N := N) x.1.1 x.1.2 (x.2 0) k := by
    -- char-2 complement property of the bits word under a parity flip
    by_cases hk : k.val = 0
    · have hk0 : k = (⟨0, by positivity⟩ : Fin (BoardW s0 N)) := Fin.ext hk
      subst k
      simp [stdBitsWord, zmod2_add_one_eq_sub_one]
    · simp [stdBitsWord, hk, zmod2_neg_eq, sub_eq_add_neg]
      ring
  rw [hs]
  exact lift2val_compl e (stdBitsWord (s0 := s0) (N := N) x.1.1 x.1.2 (x.2 0) k)

/-- Adding `encE1` leaves the tuple unchanged. -/
lemma alphaStd_e1 {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) (x + encE1) =
      alphaStd (e := e) (s0 := s0) (N := N) x := by
  apply alphaStd_congr
  · simp [encE1]
  · simp [encE1]
  · simp [encE1, encGen]

/-- Adding `encE2` leaves the tuple unchanged. -/
lemma alphaStd_e2 {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) (x + encE2) =
      alphaStd (e := e) (s0 := s0) (N := N) x := by
  apply alphaStd_congr
  · simp [encE2]
  · simp [encE2]
  · simp [encE2, encGen]

/-- At every point the tuple lies in the excluded-pairs set (i.e. the bits are a good
board). -/
lemma alphaStd_mem_excl {e s0 N : ℕ} (hs0 : 1 ≤ s0) (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) x ∈
      (sb_OmegaExcl (boardBadFullEnum s0 N e) : Set (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))) := by
  rw [sb_OmegaExcl_boardBadFullEnum_eq_good (s0 := s0) (N := N) (e := e)]
  constructor
  · intro k
    exact alphaStd_01 (e := e) (s0 := s0) (N := N) x k
  · have hb : boardGood2Full (s0 := s0) (N := N)
        (stdBitsWord (s0 := s0) (N := N) (x.1.1) (x.1.2) (x.2 0)) := by
      exact boardGood2Full_stdBitsWord hs0 (x.1.1) (x.1.2) (x.2 0)
    rw [rowBits_alphaStd (e := e) (s0 := s0) (N := N) x]
    exact hb



/-! ## Part 2d: `CompBool` of `alphaStd` and property (a) of `S` -/

/-- Each coordinate alternates along `encE0` between `0` and `1`. -/
lemma alphaStd_coord_alt {e s0 N : ℕ} (w : Fin (BoardW s0 N)) (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) (x + encE0) w =
      0 + 1 - alphaStd (e := e) (s0 := s0) (N := N) x w := by
  have h := alphaStd_e0 (e := e) (s0 := s0) (N := N) x
  simpa using (congrFun h w)

/-- Each coordinate is periodic along `encE1`. -/
lemma alphaStd_coord_per1 {e s0 N : ℕ} (w : Fin (BoardW s0 N)) :
    periodicAlong encE1 (coord (alphaStd (e := e) (s0 := s0) (N := N)) w) := by
  intro x
  exact congrFun (alphaStd_e1 (e := e) (s0 := s0) (N := N) x) w

/-- Each coordinate is periodic along `encE2`. -/
lemma alphaStd_coord_per2 {e s0 N : ℕ} (w : Fin (BoardW s0 N)) :
    periodicAlong encE2 (coord (alphaStd (e := e) (s0 := s0) (N := N)) w) := by
  intro x
  exact congrFun (alphaStd_e2 (e := e) (s0 := s0) (N := N) x) w

/-- Each coordinate is `(encE0, {0,1})`-boolean alternating. -/
lemma alphaStd_coord_boolean {e s0 N : ℕ} (w : Fin (BoardW s0 N)) :
    IsBooleanAlt e encE0 (coord (alphaStd (e := e) (s0 := s0) (N := N)) w) := by
  refine ⟨(0 : ZMod (2 ^ (e + 1))), (1 : ZMod (2 ^ (e + 1))), ?_, ?_, ?_, ?_⟩
  · exact (evenSub e).zero_mem
  · have hp := parityIn_one e
    exact (parityIn_one_iff_odd e (1 : ZMod (2 ^ (e + 1)))).mp hp
  · intro x
    exact alphaStd_01 (e := e) (s0 := s0) (N := N) x w
  · intro x
    exact alphaStd_coord_alt w x

/-- The range of every coordinate is exactly `{0,1}`. -/
lemma alphaStd_coord_range {e s0 N : ℕ} (w : Fin (BoardW s0 N)) :
    Set.range (coord (alphaStd (e := e) (s0 := s0) (N := N)) w) =
      ({0, 1} : Set (ZMod (2 ^ (e + 1)))) := by
  exact range_eq_pair e encE0 (coord (alphaStd (e := e) (s0 := s0) (N := N)) w)
    (0 : ZMod (2 ^ (e + 1))) (1 : ZMod (2 ^ (e + 1)))
    (fun x => alphaStd_01 (e := e) (s0 := s0) (N := N) x w)
    (fun x => alphaStd_coord_alt w x)

/-- `{0,1} = 0 + {0,1}` in the value space. -/
lemma zero_add_pair_set {e : ℕ} :
    ({0, 1} : Set (ZMod (2 ^ (e + 1)))) = (({0} : Set (ZMod (2 ^ (e + 1)))) + {0, 1}) := by
  ext z
  constructor
  · intro hz
    rw [Set.mem_add]
    refine ⟨0, by simp, z, hz, by simp⟩
  · intro hz
    rw [Set.mem_add] at hz
    rcases hz with ⟨a, ha, b, hb, hsum⟩
    simp at ha
    subst a
    have hbz : b = z := by simpa using hsum
    rw [← hbz]
    exact hb

/-- Any two coordinates are compatible (both have range `{0,1}`). -/
lemma alphaStd_coords_compatible {e s0 N : ℕ} (w w' : Fin (BoardW s0 N)) :
    CompatibleFunctions (coord (alphaStd (e := e) (s0 := s0) (N := N)) w)
      (coord (alphaStd (e := e) (s0 := s0) (N := N)) w') := by
  unfold CompatibleFunctions
  rw [alphaStd_coord_range w, alphaStd_coord_range w']
  refine ⟨0, ?_⟩
  change ({0, 1} : Set (ZMod (2 ^ (e + 1)))) = (({0} : Set (ZMod (2 ^ (e + 1)))) + {0, 1})
  exact zero_add_pair_set (e := e)
lemma alphaStd_compBool {e s0 N : ℕ} :
    CompBool e encE0 encE1 encE2 (alphaStd (e := e) (s0 := s0) (N := N)) := by
  constructor
  · intro w
    constructor
    · exact alphaStd_coord_per1 (e := e) (s0 := s0) (N := N) w
    · constructor
      · exact alphaStd_coord_per2 (e := e) (s0 := s0) (N := N) w
      · exact alphaStd_coord_boolean (e := e) (s0 := s0) (N := N) w
  · intro w w'
    exact alphaStd_coords_compatible (e := e) (s0 := s0) (N := N) w w'

/-- The standard tuple obeys property (a) of `S`: `P_OmegaTilde` with the full witness
`(u = 0, b = 1, nrm = alphaStd)`. -/
lemma alphaStd_sb_POmegaFull {e s0 N : ℕ} (hs0 : 1 ≤ s0) :
    sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (boardBadFullEnum s0 N e))
      (alphaStd (e := e) (s0 := s0) (N := N)) := by
  constructor
  · exact alphaStd_compBool (e := e) (s0 := s0) (N := N)
  · refine ⟨(fun _ : Fin (BoardW s0 N) => (0 : ZMod (2 ^ (e + 1)))),
      (1 : ZMod (2 ^ (e + 1))), (fun w x => alphaStd (e := e) (s0 := s0) (N := N) x w),
      ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hp := parityIn_one e
      exact (parityIn_one_iff_odd e (1 : ZMod (2 ^ (e + 1)))).mp hp
    · intro w x
      simp
    · intro w x
      exact alphaStd_01 (e := e) (s0 := s0) (N := N) x w
    · intro w
      exact alphaStd_coord_boolean (e := e) (s0 := s0) (N := N) w
    · intro w
      exact alphaStd_coord_per1 (e := e) (s0 := s0) (N := N) w
    · intro w
      exact alphaStd_coord_per2 (e := e) (s0 := s0) (N := N) w
    · intro x
      exact alphaStd_mem_excl (e := e) (s0 := s0) (N := N) hs0 x



/-! ## Part 2e: property (b) of `S` — row periodicity of `alphaStd`

Each tile coordinate is periodic along its row direction `((-rowVal n, 1), (0,0,0))`. -/

/-- The `betaWord` of a row is invariant under the row shift. -/
lemma betaWord_shift_row {s0 N : ℕ} (i j : ℤ) (n : Fin N) (a : Fin 2) :
    betaWord (i := i - rowVal n) (j := j + 1) (n := n) (a := a) (s0 := s0) (N := N) =
      betaWord (i := i) (j := j) (n := n) (a := a) (s0 := s0) (N := N) := by
  have hval0 : betaWord0 (s0 := s0) (N := N) (i - rowVal n) (j + 1) n =
      betaWord0 (s0 := s0) (N := N) i j n := by
    dsimp [betaWord0]
    apply congrArg bitsOf
    apply congrArg (fun z : ℤ => (z : ZMod (2 ^ s0)))
    ring
  have hval1 : betaWord1 (s0 := s0) (N := N) (i - rowVal n) (j + 1) n =
      betaWord1 (s0 := s0) (N := N) i j n := by
    dsimp [betaWord1]
    apply congrArg bitsOf
    apply congrArg (fun z : ℤ => fq (2 ^ s0) z)
    ring
  by_cases ha : a = 0
  · subst a
    simp [betaWord, hval0]
  · have ha1 : a = (1 : Fin 2) := by
      fin_cases a <;> simp at ha ⊢
    subst a
    simp [betaWord, hval1]

/-- The value of a tile coordinate of `alphaStd` at a point `x`. -/
lemma alphaStd_tile_val {e s0 N : ℕ} (x : EncodeG) (t : TileIdx s0 N) :
    alphaStd (e := e) (s0 := s0) (N := N) x (tileCoord (s0 := s0) (N := N) t) =
      lift2val (x.2 0 + betaWord (i := x.1.1) (j := x.1.2) (n := t.2.2) (a := t.1)
        (s0 := s0) (N := N) (t.2.1)) := by
  dsimp [alphaStd]
  rw [stdBitsWord_tile (s0 := s0) (N := N) (i := x.1.1) (j := x.1.2) (eps := x.2 0) t]

/-- The value of coordinate 0 of `alphaStd` at a point `x`. -/
lemma alphaStd_coord0_val {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) x (⟨0, by positivity⟩ : Fin (BoardW s0 N)) = lift2val (x.2 0) := by
  dsimp [alphaStd]
  simp [stdBitsWord]

/-- Every tile coordinate is periodic along its row direction (axiom (b)). -/
lemma alphaStd_row_periodic {e s0 N : ℕ} (t : TileIdx s0 N) :
    periodicAlong (rowDirOfTile t) (coord (alphaStd (e := e) (s0 := s0) (N := N)) (tileCoord t)) := by
  intro x
  let n : Fin N := t.2.2
  have hd : rowDirOfTile t = (((-rowVal n, 1) : ℤ × ℤ), (fun _ : Fin 3 => (0 : ZMod 2))) := by
    dsimp [rowDirOfTile, n]
  change alphaStd (e := e) (s0 := s0) (N := N) (x + rowDirOfTile t) (tileCoord (s0 := s0) (N := N) t) =
    alphaStd (e := e) (s0 := s0) (N := N) x (tileCoord (s0 := s0) (N := N) t)
  rw [hd]
  let d : EncodeG := (((-rowVal n, 1) : ℤ × ℤ), (fun _ : Fin 3 => (0 : ZMod 2)))
  have hI : (x + d).1.1 = x.1.1 - rowVal n := by
    dsimp [d]
    ring
  have hJ : (x + d).1.2 = x.1.2 + 1 := by
    dsimp [d]
  have hP : (x + d).2 0 = x.2 0 := by
    dsimp [d]
    simp
  rw [alphaStd_tile_val (s0 := s0) (N := N) (x + d) t, alphaStd_tile_val (s0 := s0) (N := N) x t]
  rw [hP, hI, hJ]
  have hb := betaWord_shift_row (s0 := s0) (N := N) (i := x.1.1) (j := x.1.2)
    (n := t.2.2) (a := t.1)
  congr 1
  exact congrArg (fun w : ZMod 2 => x.2 0 + w) (congrFun hb (t.2.1))

/-- Coordinate 0 is periodic along the zero direction (vacuous part of (b)). -/
lemma alphaStd_zero_periodic {e s0 N : ℕ} :
    periodicAlong (0 : EncodeG) (coord (alphaStd (e := e) (s0 := s0) (N := N)) (⟨0, by positivity⟩ : Fin (BoardW s0 N))) := by
  intro x
  simp

/-- Property (b) of `S`: every coordinate is periodic along its row direction map. -/
lemma alphaStd_row_periodic_all {e s0 N : ℕ} :
    ∀ w : Fin (BoardW s0 N), periodicAlong (rowDirMap (s0 := s0) (N := N) w)
      (coord (alphaStd (e := e) (s0 := s0) (N := N)) w) := by
  intro w
  by_cases hw : w.val = 0
  · have hw' : w = (⟨0, by positivity⟩ : Fin (BoardW s0 N)) := Fin.ext hw
    rw [hw']
    rw [rowDirMap_zero (s0 := s0) (N := N) (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (by simp)]
    exact alphaStd_zero_periodic (e := e) (s0 := s0) (N := N)
  · let t : TileIdx s0 N := coordTile (s0 := s0) (N := N) w hw
    have hw' : w = tileCoord (s0 := s0) (N := N) t := by
      apply Fin.ext
      dsimp [t, coordTile, tileCoord]
      simp
      omega
    rw [hw']
    rw [rowDirMap_tile (s0 := s0) (N := N) t]
    exact alphaStd_row_periodic (e := e) (s0 := s0) (N := N) t


/-! ## Part 2f: property (c) of `S` — boolean periodized permutation of each row's
`a = 0` word, and the full `encodePropS` certificate for `alphaStd` -/

/-- `parityIn` of a lift of a `{0,1}`-bit is the bit itself. -/
lemma parityIn_lift2val {e : ℕ} (t : ZMod 2) : parityIn e (lift2val (e := e) t) = t := by
  rcases zmod2_eq_zero_or_one t with rfl | rfl
  · simp [parityIn_zero, lift2val_zero]
  · simp [parityIn_one, lift2val_one]

/-- The value of an `a = 0` tile coordinate of `alphaStd` is the parity plus the digit
of the residue. -/
lemma alphaStd_row0_val {e s0 N : ℕ} (x : EncodeG) (n : Fin N) (b : Fin s0) :
    alphaStd (e := e) (s0 := s0) (N := N) x (selRow0 (s0 := s0) (N := N) n b) =
      lift2val (x.2 0 + zmodDigit b ((x.1.2 * rowVal n + x.1.1 : ℤ) : ZMod (2 ^ s0))) := by
  have ht := alphaStd_tile_val (e := e) (s0 := s0) (N := N) x ((0 : Fin 2), b, n)
  change alphaStd (e := e) (s0 := s0) (N := N) x
      (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), b, n)) = _
  rw [ht]
  have hbw : betaWord (i := x.1.1) (j := x.1.2) (n := n) (a := (0 : Fin 2)) (s0 := s0) (N := N) =
      betaWord0 (s0 := s0) (N := N) x.1.1 x.1.2 n := by
    simp [betaWord]
  rw [hbw]
  rfl

/-- The natural map `Fin (2^s0)` to `ZMod (2^s0)` is bijective. -/
lemma finToZmod_bijective (s0 : ℕ) :
    Function.Bijective (fun j : Fin (2 ^ s0) => (j : ZMod (2 ^ s0))) := by
  haveI : NeZero (2 ^ s0) := ⟨by positivity⟩
  constructor
  · intro j1 j2 h
    apply Fin.ext
    have hz := congrArg ZMod.val h
    have hv1 : (j1 : ZMod (2 ^ s0)).val = j1.val := by
      rw [ZMod.val_natCast]
      exact Nat.mod_eq_of_lt j1.isLt
    have hv2 : (j2 : ZMod (2 ^ s0)).val = j2.val := by
      rw [ZMod.val_natCast]
      exact Nat.mod_eq_of_lt j2.isLt
    rwa [hv1, hv2] at hz
  · intro u
    refine ⟨⟨u.val, ZMod.val_lt u⟩, ?_⟩
    change ((u.val : ℕ) : ZMod (2 ^ s0)) = u
    exact ZMod.natCast_zmod_val u

/-- Adding a constant is a bijection. -/
lemma add_const_bijective {A : Type*} [AddGroup A] (c : A) :
    Function.Bijective (fun u : A => c + u) := by
  refine ⟨?_, ?_⟩
  · intro u v h
    exact add_left_cancel h
  · intro u
    refine ⟨-c + u, ?_⟩
    calc
      c + (-c + u) = (c + -c) + u := by rw [← add_assoc]
      _ = u := by simp

/-- The digit map from `ZMod (2^s0)` to the cube is bijective. -/
lemma digitMap_bijective (s0 : ℕ) :
    Function.Bijective (fun u : ZMod (2 ^ s0) => fun b : Fin s0 => zmodDigit b u) := by
  constructor
  · intro u v h
    exact zmodDigit_injective s0 h
  · intro w
    refine ⟨encB w, ?_⟩
    funext b
    exact zmodDigit_encB w b

/-- Translation by a residue and the digit map give a bijection of the cube. -/
lemma translate_digit_bijective {s0 : ℕ} (c : ZMod (2 ^ s0)) :
    Function.Bijective
      (fun j : Fin (2 ^ s0) => fun b : Fin s0 => zmodDigit b (c + (j : ZMod (2 ^ s0)))) := by
  have hfin := finToZmod_bijective s0
  have hshift := add_const_bijective c
  have hdigit := digitMap_bijective s0
  exact ⟨Function.Injective.comp hdigit.1 (Function.Injective.comp hshift.1 hfin.1),
         Function.Surjective.comp hdigit.2 (Function.Surjective.comp hshift.2 hfin.2)⟩

/-- The shifts along `encX` are pure horizontal shifts of the first coordinate. -/
lemma permShift_encX {s0 : ℕ} (j : Fin (2 ^ s0)) :
    permShift s0 encX j = (((((j.val : ℕ) : ℤ), (0 : ℤ)) : ℤ × ℤ), (fun _ : Fin 3 => (0 : ZMod 2))) := by
  apply Prod.ext
  · dsimp [permShift, encX]
    simp
  · funext t
    dsimp [permShift, encX]
    simp

/-- Row-`n` `a = 0` selection of the standard tuple is a parity-vector bijection along
`encX` (axiom (c), bijection part). -/
lemma alphaStd_permBijective {e s0 N : ℕ} (n : Fin N) :
    permBijective e s0 encX (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) := by
  intro x
  let c0 : ZMod (2 ^ s0) := ((x.1.2 * rowVal n + x.1.1 : ℤ) : ZMod (2 ^ s0))
  have hmap : (fun j : Fin (2 ^ s0) => fun b : Fin s0 =>
        parityIn e ((row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n)
          (x + permShift s0 encX j) b)) =
      fun j : Fin (2 ^ s0) => fun b : Fin s0 =>
        zmodDigit b (c0 + (j : ZMod (2 ^ s0))) + x.2 0 := by
    funext j b
    change parityIn e (alphaStd (e := e) (s0 := s0) (N := N) (x + permShift s0 encX j)
        (selRow0 (s0 := s0) (N := N) n b)) = zmodDigit b (c0 + (j : ZMod (2 ^ s0))) + x.2 0
    rw [alphaStd_row0_val (s0 := s0) (N := N) (x + permShift s0 encX j) n b]
    have hps := permShift_encX (s0 := s0) j
    have hI : (x + permShift s0 encX j).1.1 = x.1.1 + (j : ℤ) := by
      rw [hps]
      simp
    have hJ : (x + permShift s0 encX j).1.2 = x.1.2 := by
      rw [hps]
      simp
    have hP : (x + permShift s0 encX j).2 0 = x.2 0 := by
      rw [hps]
      simp
    rw [hI, hJ, hP]
    rw [parityIn_lift2val]
    have hres : ((x.1.2 * rowVal n + (x.1.1 + (j : ℤ)) : ℤ) : ZMod (2 ^ s0)) =
        c0 + (j : ZMod (2 ^ s0)) := by
      dsimp [c0]
      rw [show (x.1.2 * rowVal n + (x.1.1 + (j : ℤ)) : ℤ) =
          (x.1.2 * rowVal n + x.1.1) + (j : ℤ) by ring]
      simp
    rw [hres]
    abel
  rw [hmap]
  have hbio : Function.Bijective
      (fun j : Fin (2 ^ s0) => fun b : Fin s0 => zmodDigit b (c0 + (j : ZMod (2 ^ s0)))) := by
    exact translate_digit_bijective c0
  let f : Fin (2 ^ s0) → (Fin s0 → ZMod 2) :=
    fun j => fun b : Fin s0 => zmodDigit b (c0 + (j : ZMod (2 ^ s0)))
  have hid : (fun j : Fin (2 ^ s0) => fun b : Fin s0 => zmodDigit b (c0 + (j : ZMod (2 ^ s0))) + x.2 0) =
      fun j : Fin (2 ^ s0) => f j + (fun _ : Fin s0 => x.2 0) := by
    rfl
  rw [hid]
  exact (bijective_translate_iff (B := Fin s0 → ZMod 2) f (fun _ : Fin s0 => x.2 0)).mpr hbio


/-! ## Part 2g: `CompBool` of the row selections, property (c), and the full
`encodePropS` certificate -/

/-- The `a = 0` row-word coordinate functions equal the corresponding full-tuple
coordinate functions. -/
lemma row0Sel_coord_eq {e s0 N : ℕ} (n : Fin N) (b : Fin s0) :
    coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b =
      coord (alphaStd (e := e) (s0 := s0) (N := N)) (selRow0 (s0 := s0) (N := N) n b) := by
  funext x
  rfl

/-- Each `a = 0` row coordinate alternates along `encE0`. -/
lemma row0Sel_coord_boolean {e s0 N : ℕ} (n : Fin N) (b : Fin s0) :
    IsBooleanAlt e encE0 (coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b) := by
  rw [row0Sel_coord_eq n b]
  exact alphaStd_coord_boolean (e := e) (s0 := s0) (N := N) (selRow0 (s0 := s0) (N := N) n b)

/-- Each `a = 0` row coordinate is periodic along `encE1`. -/
lemma row0Sel_coord_per1 {e s0 N : ℕ} (n : Fin N) (b : Fin s0) :
    periodicAlong encE1 (coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b) := by
  rw [row0Sel_coord_eq n b]
  exact alphaStd_coord_per1 (e := e) (s0 := s0) (N := N) (selRow0 (s0 := s0) (N := N) n b)

/-- Each `a = 0` row coordinate is periodic along `encE2`. -/
lemma row0Sel_coord_per2 {e s0 N : ℕ} (n : Fin N) (b : Fin s0) :
    periodicAlong encE2 (coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b) := by
  rw [row0Sel_coord_eq n b]
  exact alphaStd_coord_per2 (e := e) (s0 := s0) (N := N) (selRow0 (s0 := s0) (N := N) n b)

/-- The row selections are pairwise compatible. -/
lemma row0Sel_coords_compatible {e s0 N : ℕ} (n : Fin N) (b b' : Fin s0) :
    CompatibleFunctions (coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b)
      (coord (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) b') := by
  rw [row0Sel_coord_eq n b, row0Sel_coord_eq n b']
  exact alphaStd_coords_compatible (e := e) (s0 := s0) (N := N)
    (selRow0 (s0 := s0) (N := N) n b) (selRow0 (s0 := s0) (N := N) n b')

/-- Each row-`n` `a = 0` selection is a compatible boolean tuple. -/
lemma row0Sel_compBool {e s0 N : ℕ} (n : Fin N) :
    CompBool e encE0 encE1 encE2 (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) := by
  constructor
  · intro b
    constructor
    · exact row0Sel_coord_per1 (e := e) (s0 := s0) (N := N) n b
    · constructor
      · exact row0Sel_coord_per2 (e := e) (s0 := s0) (N := N) n b
      · exact row0Sel_coord_boolean (e := e) (s0 := s0) (N := N) n b
  · intro b b'
    exact row0Sel_coords_compatible (e := e) (s0 := s0) (N := N) n b b'

/-- Row-`n` `a = 0` selection of the standard tuple is a boolean periodized
permutation along `encX` (axiom (c)). -/
lemma row0Sel_boolPerm {e s0 N : ℕ} (n : Fin N) :
    BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX
      (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) := by
  exact ⟨row0Sel_compBool (e := e) (s0 := s0) (N := N) n,
    alphaStd_permBijective (e := e) (s0 := s0) (N := N) n⟩

/-- Property (c) of `S`: every row is a boolean periodized permutation. -/
lemma alphaStd_boolPerm_all {e s0 N : ℕ} :
    ∀ n : Fin N, BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX
      (row0Sel (e := e) (alphaStd (e := e) (s0 := s0) (N := N)) n) := by
  intro n
  exact row0Sel_boolPerm (e := e) (s0 := s0) (N := N) n

/-- The standard tuple satisfies property `S` (all three axioms (a), (b), (c)). -/
theorem alphaStd_satisfies_encodePropS {e s0 N : ℕ} (hs0 : 1 ≤ s0) :
    encodePropS (e := e) (s0 := s0) (N := N) (alphaStd (e := e) (s0 := s0) (N := N)) := by
  unfold encodePropS
  constructor
  · exact alphaStd_sb_POmegaFull (e := e) (s0 := s0) (N := N) hs0
  · constructor
    · exact alphaStd_row_periodic_all (e := e) (s0 := s0) (N := N)
    · exact alphaStd_boolPerm_all (e := e) (s0 := s0) (N := N)

/-- Property `S` is satisfiable: the standard Sudoku solution provides a witness. -/
theorem encodePropS_satisfiable {e s0 N : ℕ} (hs0 : 1 ≤ s0) :
    ∃ alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))),
      encodePropS (e := e) (s0 := s0) (N := N) alpha := by
  refine ⟨alphaStd (e := e) (s0 := s0) (N := N), ?_⟩
  exact alphaStd_satisfies_encodePropS hs0

end
