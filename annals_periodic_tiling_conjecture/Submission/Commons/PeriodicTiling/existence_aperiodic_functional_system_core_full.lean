/-! # Phase 3 encode, layer 5 — aperiodicity of property S (WIP)

The paper's converse direction (tex 1189-1197): DECODE any tuple `alpha` obeying `S`
into a Sudoku solution `F1` with good columns, then feed `main_sudoku_no_verticalPeriod`.
Design (recorded; proofs to follow in later sessions):

1. From `sb_POmegaFull` (axiom (a)) take the normalization witness `(u, b, nrm)` with
   `b` odd, `alpha x w = u w + b * nrm w x`, `nrm w x ∈ {0,1}`, and
   `(fun w => nrm w x) ∈ sb_OmegaExcl (boardBadFullEnum s0 N e)` for every `x`.
   (Membership at level `e`; `T5'` gives `boardGood2Full (rowBits (nrm x))`, and since
   `nrm x` is `{0,1}`-valued, `rowBits (nrm x) = nrm x`, so `boardGood2Full` holds of the
   `{0,1}`-valued word `nrm x` — both axioms (i) and (ii).)
2. Axiom (b) transfers to `nrm`: each coordinate `nrm w` is periodic along
   `rowDirMap w` (`u w` constant, `b` odd and `nrm` `{0,1}`-valued force the transfer;
   `periodicAlong_of_odd_normalized` below).
3. Define the un-reflected `{0,1}` functions on the parity-zero slice of the plane:
   `beta_* (i,j) := nrm 0 ((i,j),0)` and `beta_{a,b,n} (i,j) := beta_*(i,j) + nrm_{tile (a,b,n)}((i,j),0)`
   (reflection `R_eps` in characteristic 2).  By axiom-(a) membership in `OmegaTilde`,
   the word `(beta_{a,b,n}(i,j))` lies in the FULL good set `Ω` (axiom (i): Scal-in-n of
   the reflected `a = 1` decodes; axiom (ii): the matching), and by (2) each
   `beta_{a,b,n}` is `(-rowVal n, 1)`-periodic, so the boards
   `F_a (n, jn + i) := encB (beta_{a,.,n} (i,j))` are well defined.
4. Axiom (c) (`BoolPeriodizedPerm` of the row-0 selection along `encX`) makes `F0`'s
   column values a full residue system along the `(1,0)`-direction, giving
   `F0(n,m) = sigma_n (m mod q)` for a permutation `sigma_n`; with the matching axiom
   (ii) this makes `F1` have good columns; `F1` is a Sudoku solution by axioms (i)+(ii).
5. Aperiodicity: if every coordinate of `alpha` were invariant under a finite-index
   subgroup `L` of `EncodeG`, the commons square-lattice lemma
   `Commons.GroupTheory.finiteIndex_subgroup_contains_square_lattice` gives `M > 0`
   with `M * ((1,0),(0,0,0)) ∈ L`, so every coordinate — hence `beta_*`, each
   `beta_{a,b,n}`, and `F1` — is `M`-periodic in the first plane coordinate, i.e.
   `VerticalPeriod F1 M`, contradicting `main_sudoku_no_verticalPeriod`
   (instantiate s0 := t ≥ 24 and N := 2^t * 2^t).  Hence property `S` is aperiodic in
   the finite-index-subgroup sense, completing the satisfiability + aperiodicity halves
   of the tuple-level theorem.

Pinned targets (each `:= by TBD`; statements fixed — proof routes in comments). -/

/-- From an odd multiplier `b` and a constant `u`, periodicity of `u + b*nrm` along
`v` forces periodicity of `nrm` (for `{0,1}`-valued `nrm` in `ZMod 2^(e+1)`).
Proof route: parityIn e (b*t) = parityIn e t for odd b and t ∈ {0,1}
(dev_perm.parityIn_normalized), so periodic alpha gives equal parities of nrm(x+v)
and nrm x; parity is injective on {0,1} (parityIn_zero / parityIn_one). -/
lemma periodicAlong_of_odd_normalized {e : ℕ} {v : EncodeG}
    {α nrm : EncodeG → ZMod (2 ^ (e + 1))} (u b : ZMod (2 ^ (e + 1)))
    (hb : b ∉ evenSub e)
    (hval : ∀ x : EncodeG, α x = u + b * nrm x)
    (hnrm : ∀ x : EncodeG, nrm x = 0 ∨ nrm x = 1)
    (hα : periodicAlong v α) : periodicAlong v nrm := by
  intro x
  have hper_par : parityIn e (α (x + v)) = parityIn e (α x) := congrArg (parityIn e) (hα x)
  have hp1 : parityIn e (α (x + v)) = parityIn e u + parityIn e (nrm (x + v)) := by
    rw [hval (x + v)]
    exact parityIn_normalized e hb (hnrm (x + v))
  have hp2 : parityIn e (α x) = parityIn e u + parityIn e (nrm x) := by
    rw [hval x]
    exact parityIn_normalized e hb (hnrm x)
  have hp3 : parityIn e (nrm (x + v)) = parityIn e (nrm x) := by
    rw [hp1, hp2] at hper_par
    exact add_left_cancel hper_par
  have hz : parityIn e (0 : ZMod (2 ^ (e + 1))) = 0 := parityIn_zero e
  have ho : parityIn e (1 : ZMod (2 ^ (e + 1))) = 1 := parityIn_one e
  rcases hnrm (x + v) with h0a | h1a
  · rcases hnrm x with h0b | h1b
    · rw [h0a, h0b]
    · exfalso
      rw [h0a, h1b] at hp3
      rw [hz, ho] at hp3
      exact zmod2_zero_ne_one hp3
  · rcases hnrm x with h0b | h1b
    · exfalso
      rw [h1a, h0b] at hp3
      rw [ho, hz] at hp3
      exact zmod2_zero_ne_one hp3.symm
    · rw [h1a, h1b]

/-- The `{0,1}`-valued normalization of a tuple obeying `sb_POmegaFull`, transferred
to a lemma package: extraction of `u, b, nrm`, the alpha-decomposition, and the
per-coordinate periodicity of `nrm` along the axiom-(b) directions. -/
lemma sb_POmegaFull_normalization_periodic {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (hS : encodePropS (e := e) (s0 := s0) (N := N) alpha) :
    ∃ (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
      (b : ZMod (2 ^ (e + 1)))
      (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w x, alpha x w = u w + b * nrm w x) ∧
      (∀ w x, nrm w x = 0 ∨ nrm w x = 1) ∧
      (∀ w, periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x)) ∧
      (∀ x, (fun w => nrm w x) ∈ sb_OmegaExcl (boardBadFullEnum s0 N e)) := by
  rcases hS with ⟨hPΩ, hBC⟩
  rcases hPΩ with ⟨_hComp, hw⟩
  rcases hw with ⟨u, b, nrm, hb, hval, hnrm, _hboolnrm, _hper_p, _hper_q, hΩ⟩
  refine ⟨u, b, nrm, hb, hval, hnrm, ?_, hΩ⟩
  intro w
  exact periodicAlong_of_odd_normalized (v := rowDirMap (s0 := s0) (N := N) w)
    (α := coord alpha w) (nrm := fun x : EncodeG => nrm w x) (u := u w) (b := b) hb
    (by intro x; exact hval w x) (by intro x; exact hnrm w x) (hBC.1 w)



/-! ## Part 2: the strengthened property S (coordinate 0 plane-periodic) and the slice

RESOLUTION of the decode design issue (recorded in STATUS_NOTES): the paper's converse
needs the reflection bit (coordinate 0 of the normalization) to be constant on the
parity-zero slice.  That is not forced by the axioms as stated, so we STRENGTHEN the
encoded property: coordinate 0 is required to be periodic along the two plane
directions `encX = ((1,0),(0,0,0))` and `encY = ((0,1),(0,0,0))`.  The standard tuple
already obeys this (its coordinate 0 is the parity bit, independent of the plane), so
satisfiability is preserved; the two added conjuncts are (weakly) expressible by the
single-coordinate periodicity machinery, so weak expressibility is preserved.  The
strengthened property makes `nrm` (coordinate 0) constant on the parity-zero slice
`slicePt i j := (((i,j),0),(0,0,0))`, which unblocks the F1 decode. -/

/-- The plane direction `((1,0),(0,0,0))`. -/
def encXdir : EncodeG := encX

/-- The plane direction `((0,1),(0,0,0))`. -/
def encYdir : EncodeG := (((0 : ℤ), (1 : ℤ)), (fun _ : Fin 3 => (0 : ZMod 2)))

/-- The parity-zero slice point of the plane point `(i,j)`. -/
def slicePt (i j : ℤ) : EncodeG := (((i, j) : ℤ × ℤ), (fun _ : Fin 3 => (0 : ZMod 2)))

/-- The strengthened property `S`: property `S` plus plane-periodicity of coordinate 0. -/
def encodePropSFull {e s0 N : ℕ}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))) : Prop :=
  encodePropS (e := e) (s0 := s0) (N := N) alpha ∧
    periodicAlong encXdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N))) ∧
    periodicAlong encYdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))

/-- The parity-zero coordinate of `x`. -/
def par0bit (x : EncodeG) : ZMod 2 := x.2 0

/-- The value of coordinate 0 of `alphaStd` is the parity bit. -/
lemma alphaStd_coord0 {e s0 N : ℕ} (x : EncodeG) :
    alphaStd (e := e) (s0 := s0) (N := N) x (⟨0, by positivity⟩ : Fin (BoardW s0 N)) = lift2val (par0bit x) := by
  dsimp [par0bit]
  exact alphaStd_coord0_val (e := e) (s0 := s0) (N := N) x

/-- Coordinate 0 of `alphaStd` is periodic along `encX` (it only sees the parity). -/
lemma alphaStd_coord0_periodic_encX {e s0 N : ℕ} :
    periodicAlong encXdir (coord (alphaStd (e := e) (s0 := s0) (N := N)) (⟨0, by positivity⟩ : Fin (BoardW s0 N))) := by
  intro x
  change alphaStd (e := e) (s0 := s0) (N := N) (x + encXdir) (⟨0, by positivity⟩ : Fin (BoardW s0 N)) =
    alphaStd (e := e) (s0 := s0) (N := N) x (⟨0, by positivity⟩ : Fin (BoardW s0 N))
  rw [alphaStd_coord0, alphaStd_coord0]
  congr 1
  simp [par0bit, encXdir, encX]

/-- Coordinate 0 of `alphaStd` is periodic along `encY`. -/
lemma alphaStd_coord0_periodic_encY {e s0 N : ℕ} :
    periodicAlong encYdir (coord (alphaStd (e := e) (s0 := s0) (N := N)) (⟨0, by positivity⟩ : Fin (BoardW s0 N))) := by
  intro x
  change alphaStd (e := e) (s0 := s0) (N := N) (x + encYdir) (⟨0, by positivity⟩ : Fin (BoardW s0 N)) =
    alphaStd (e := e) (s0 := s0) (N := N) x (⟨0, by positivity⟩ : Fin (BoardW s0 N))
  rw [alphaStd_coord0, alphaStd_coord0]
  congr 1
  simp [par0bit, encYdir]

/-- The standard tuple satisfies the strengthened property. -/
theorem alphaStd_satisfies_encodePropSFull {e s0 N : ℕ} (hs0 : 1 ≤ s0) :
    encodePropSFull (e := e) (s0 := s0) (N := N) (alphaStd (e := e) (s0 := s0) (N := N)) := by
  unfold encodePropSFull
  constructor
  · exact alphaStd_satisfies_encodePropS (e := e) (s0 := s0) (N := N) hs0
  · constructor
    · exact alphaStd_coord0_periodic_encX (e := e) (s0 := s0) (N := N)
    · exact alphaStd_coord0_periodic_encY (e := e) (s0 := s0) (N := N)

/-- The strengthened property is satisfiable. -/
theorem encodePropSFull_satisfiable {e s0 N : ℕ} (hs0 : 1 ≤ s0) :
    ∃ alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))),
      encodePropSFull (e := e) (s0 := s0) (N := N) alpha := by
  refine ⟨alphaStd (e := e) (s0 := s0) (N := N), ?_⟩
  exact alphaStd_satisfies_encodePropSFull hs0

/-- The strengthened property is weakly expressible (property `S` plus two
single-coordinate periodicity conjuncts). -/
theorem encodePropSFull_weakExpressible {d s0 N : ℕ} (e : ℕ) (he : 1 ≤ e)
    (hs0 : 1 ≤ s0) (hN : 1 ≤ N)
    (gens : Fin d → EncodeG) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (hbig : 4 * (s0 * N) < 2 ^ (e + 1)) :
    WeakExpressible (BoardW s0 N) (encodePropSFull (e := e) (s0 := s0) (N := N)) := by
  have hS : WeakExpressible (BoardW s0 N) (encodePropS (e := e) (s0 := s0) (N := N)) :=
    encodePropS_weakExpressible (d := d) (s0 := s0) (N := N) e he hs0 hN gens hpos hspan hbig
  have hX : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        periodicAlong encXdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) := by
    have hN' : 2 ≤ 2 ^ (e + 1) := by
      have hp := pow_le_pow_right₀ (by norm_num : 1 ≤ 2) (by omega : 1 ≤ e + 1)
      simpa using hp
    have hE : ExpressibleProperty
        (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
          periodicAlong encXdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) := by
      exact expressible_coord_lift (w := (⟨0, by positivity⟩ : Fin (BoardW s0 N)))
        (periodicAlong_expressible (2 ^ (e + 1)) hN' encXdir)
    exact expressible_weak (K := BoardW s0 N)
      (P := fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        periodicAlong encXdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) hE
  have hY : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        periodicAlong encYdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) := by
    have hN' : 2 ≤ 2 ^ (e + 1) := by
      have hp := pow_le_pow_right₀ (by norm_num : 1 ≤ 2) (by omega : 1 ≤ e + 1)
      simpa using hp
    have hE : ExpressibleProperty
        (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
          periodicAlong encYdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) := by
      exact expressible_coord_lift (w := (⟨0, by positivity⟩ : Fin (BoardW s0 N)))
        (periodicAlong_expressible (2 ^ (e + 1)) hN' encYdir)
    exact expressible_weak (K := BoardW s0 N)
      (P := fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        periodicAlong encYdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) hE
  have hXY : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        periodicAlong encXdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N))) ∧
        periodicAlong encYdir (coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))) := by
    exact weakExpressible_conj hX hY
  have hfull : WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        encodePropSFull (e := e) (s0 := s0) (N := N) alpha) := by
    unfold encodePropSFull
    exact weakExpressible_conj hS hXY
  exact hfull




/-! ## Part 3: the parity-zero slice is constant on coordinate 0 of any strengthened
solution — via invariance under the plane lattice -/

/-- From periodicity of `f` along `v`, `f` is invariant under integer multiples of `v`. -/
lemma zsmul_periodicAlong {A Z : Type*} [AddCommGroup A] {f : A → Z} (v : A)
    (h : ∀ x : A, f (x + v) = f x) (k : ℤ) (x : A) : f (x + k • v) = f x := by
  classical
  let S : AddSubgroup A :=
    { carrier := {y : A | ∀ x : A, f (x + y) = f x}
      zero_mem' := by intro x; simp
      add_mem' := by
        intro a b ha hb x
        calc
          f (x + (a + b)) = f ((x + a) + b) := by rw [add_assoc]
          _ = f (x + a) := hb (x + a)
          _ = f x := ha x
      neg_mem' := by
        intro a ha x
        have hx := ha (x + (-a))
        have hx' : (x + (-a)) + a = x := by abel
        rw [hx'] at hx
        exact hx.symm }
  have hmem : v ∈ S := h
  exact S.zsmul_mem hmem k x

/-- The slice point `(i,j)` is the integer combination of the two plane directions. -/
lemma slicePt_eq_zsmul (i j : ℤ) :
    slicePt i j = (i : ℤ) • encXdir + (j : ℤ) • encYdir := by
  apply Prod.ext
  · dsimp [slicePt, encXdir, encX, encYdir]
    apply Prod.ext
    · simp [zsmul_eq_mul]
    · simp [zsmul_eq_mul]
  · funext t
    dsimp [slicePt, encXdir, encX, encYdir]
    simp

/-- If `f` is periodic along both plane directions, it is constant on the parity-zero
slice. -/
lemma slice_const_of_periodic {Z : Type*} {f : EncodeG → Z}
    (hX : ∀ x : EncodeG, f (x + encXdir) = f x)
    (hY : ∀ x : EncodeG, f (x + encYdir) = f x) (i j : ℤ) :
    f (slicePt i j) = f (slicePt 0 0) := by
  have h1 := zsmul_periodicAlong (v := encXdir) (f := f) hX i (0 : EncodeG)
  have h3 := zsmul_periodicAlong (v := encYdir) (f := f) hY j ((i : ℤ) • encXdir)
  calc
    f (slicePt i j) = f ((i : ℤ) • encXdir + (j : ℤ) • encYdir) := by rw [slicePt_eq_zsmul]
    _ = f ((i : ℤ) • encXdir) := h3
    _ = f (0 : EncodeG) := by simpa using h1
    _ = f (slicePt 0 0) := by rfl

/-- Coordinate 0 of a strengthened-solution normalization is constant on the slice. -/
lemma nrm0_slice_const {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (i j : ℤ) :
    nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt i j) =
      nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt 0 0) := by
  exact slice_const_of_periodic
    (f := fun x : EncodeG => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x)
    hX hY i j



/-! ## Part 4: normalization of strengthened solutions, and the (now valid) row
periodicity of the un-reflected beta words -/

/-- From a strengthened solution we extract the normalization with coordinate 0
periodic along the two plane directions. -/
theorem encodePropSFull_normalization {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (hS : encodePropSFull (e := e) (s0 := s0) (N := N) alpha) :
    ∃ (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
      (b : ZMod (2 ^ (e + 1)))
      (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w x, alpha x w = u w + b * nrm w x) ∧
      (∀ w x, nrm w x = 0 ∨ nrm w x = 1) ∧
      (∀ w, periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x)) ∧
      periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x) ∧
      periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x) ∧
      (∀ x, (fun w => nrm w x) ∈ sb_OmegaExcl (boardBadFullEnum s0 N e)) := by
  rcases hS with ⟨hS1, hX0, hY0⟩
  rcases sb_POmegaFull_normalization_periodic (e := e) (s0 := s0) (N := N) hs0 alpha hS1 with
    ⟨u, b, nrm, hb, hval, hnrm, hper, hΩ⟩
  refine ⟨u, b, nrm, hb, hval, hnrm, hper, ?_, ?_, hΩ⟩
  · exact periodicAlong_of_odd_normalized (v := encXdir)
      (α := coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))
      (nrm := fun x : EncodeG => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x)
      (u := u (⟨0, by positivity⟩ : Fin (BoardW s0 N))) (b := b) hb
      (by intro x; exact hval (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x)
      (by intro x; exact hnrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x) hX0
  · exact periodicAlong_of_odd_normalized (v := encYdir)
      (α := coord alpha (⟨0, by positivity⟩ : Fin (BoardW s0 N)))
      (nrm := fun x : EncodeG => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x)
      (u := u (⟨0, by positivity⟩ : Fin (BoardW s0 N))) (b := b) hb
      (by intro x; exact hval (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x)
      (by intro x; exact hnrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x) hY0

/-- The `{0,1}`-bit of a normalized value, as an element of `ZMod 2`. -/
def bitNrm {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (w : Fin (BoardW s0 N)) (x : EncodeG) : ZMod 2 :=
  parityIn e (nrm w x)

/-- The un-reflected beta value of a tile at the slice point `(i,j)` (the reflection
bit is the constant value of coordinate 0 on the slice). -/
def betaTile {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (i j : ℤ) (t : TileIdx s0 N) : ZMod 2 :=
  bitNrm (e := e) nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt 0 0) +
    bitNrm (e := e) nrm (tileCoord (s0 := s0) (N := N) t) (slicePt i j)

/-- Shifting the slice point along the row direction of `t`. -/
lemma slicePt_add_rowDir {s0 N : ℕ} (i j : ℤ) (t : TileIdx s0 N) :
    slicePt (i - rowVal t.2.2) (j + 1) = slicePt i j + rowDirOfTile t := by
  apply Prod.ext
  · dsimp [slicePt, rowDirOfTile]
    apply Prod.ext
    · ring
    · ring
  · funext z
    dsimp [slicePt, rowDirOfTile]
    simp

/-- The beta values are periodic along the row direction of their tile (axiom (b) at
the un-reflected level; the reflection bit is slice-constant). -/
lemma betaTile_periodic {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (t : TileIdx s0 N) (i j : ℤ) :
    betaTile (e := e) (s0 := s0) (N := N) nrm (i - rowVal t.2.2) (j + 1) t =
      betaTile (e := e) (s0 := s0) (N := N) nrm i j t := by
  -- the coordinate-0 bit is the same at both slice points (it is slice-constant)
  have h0 : bitNrm (e := e) nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt (i - rowVal t.2.2) (j + 1)) =
      bitNrm (e := e) nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt i j) := by
    dsimp [bitNrm]
    have hc := nrm0_slice_const (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY (i - rowVal t.2.2) (j + 1)
    have hc' := nrm0_slice_const (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j
    congr 1
    exact hc.trans hc'.symm
  -- the tile bit is preserved by the row shift (periodicity along rowDirOfTile t)
  have ht : bitNrm (e := e) nrm (tileCoord (s0 := s0) (N := N) t) (slicePt (i - rowVal t.2.2) (j + 1)) =
      bitNrm (e := e) nrm (tileCoord (s0 := s0) (N := N) t) (slicePt i j) := by
    dsimp [bitNrm]
    congr 1
    -- nrm tile is periodic along rowDirOfTile t; the two slice points differ by that direction
    have hper_t := hper (tileCoord (s0 := s0) (N := N) t)
    have hdir : rowDirMap (s0 := s0) (N := N) (tileCoord (s0 := s0) (N := N) t) = rowDirOfTile t :=
      rowDirMap_tile (s0 := s0) (N := N) t
    have hp := hper_t (slicePt i j)
    -- hp : nrm tile (slicePt i j + rowDirMap tile) = nrm tile (slicePt i j)
    rw [hdir] at hp
    have hshift : slicePt (i - rowVal t.2.2) (j + 1) = slicePt i j + rowDirOfTile t :=
      slicePt_add_rowDir i j t
    rw [hshift]
    exact hp
  -- expand betaTile at both points and reassemble
  dsimp [betaTile]
  rw [ht]




/-! ## Part 5: from Ω̃-membership of the normalized word to the good-set content of the
un-reflected beta word -/

/-- The bit of a `{0,1}`-valued normalized value is the `rowBits`-style reading. -/
lemma bitNrm_eq {e s0 N : ℕ} {nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))}
    (w : Fin (BoardW s0 N)) (x : EncodeG) (h01 : nrm w x = 0 ∨ nrm w x = 1) :
    bitNrm (e := e) nrm w x = (if nrm w x = 0 then (0 : ZMod 2) else 1) := by
  dsimp [bitNrm]
  rcases h01 with h0 | h1
  · rw [h0]
    simp [parityIn_zero]
  · rw [h1]
    have hnz : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zmod_pow_two e
    simp [parityIn_one, hnz]

/-- The bits of the normalized word. -/
def bitWord {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (x : EncodeG) : Fin (BoardW s0 N) → ZMod 2 :=
  fun w => bitNrm (e := e) nrm w x

/-- `rowBits` of a `{0,1}`-valued level-`e` word is the word itself (bit form). -/
lemma rowBits_bitWord_of_01 {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (x : EncodeG) (h01 : ∀ w : Fin (BoardW s0 N), nrm w x = 0 ∨ nrm w x = 1) :
    rowBits (fun w : Fin (BoardW s0 N) => nrm w x) = bitWord (e := e) nrm x := by
  funext w
  dsimp [rowBits, bitWord, bitNrm]
  rcases h01 w with h0 | h1
  · simp [h0, parityIn_zero]
  · have hnz : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zmod_pow_two e
    simp [h1, parityIn_one, hnz]

/-- Membership of a `{0,1}`-valued word in the excluded set gives the full good-board
content of its bits. -/
lemma boardGood2Full_of_mem_excl {e s0 N : ℕ}
    (tau : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (h01 : ∀ i : Fin (BoardW s0 N), tau i = 0 ∨ tau i = 1)
    (h : tau ∈ (sb_OmegaExcl (boardBadFullEnum s0 N e) : Set (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))) :
    boardGood2Full (s0 := s0) (N := N) (rowBits tau) := by
  rw [sb_OmegaExcl_boardBadFullEnum_eq_good (s0 := s0) (N := N) (e := e)] at h
  exact h.2

/-- From a normalization with Ω̃-membership at every point, the bit word is a good
board at every point. -/
lemma boardGood2Full_of_normalization {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrm01 : ∀ w : Fin (BoardW s0 N), ∀ x : EncodeG, nrm w x = 0 ∨ nrm w x = 1)
    (hΩ : ∀ x : EncodeG,
      (fun w : Fin (BoardW s0 N) => nrm w x) ∈
        (sb_OmegaExcl (boardBadFullEnum s0 N e) : Set (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))))
    (x : EncodeG) :
    boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x) := by
  have hmem := hΩ x
  have hbw : boardGood2Full (s0 := s0) (N := N) (rowBits (fun w : Fin (BoardW s0 N) => nrm w x)) :=
    boardGood2Full_of_mem_excl (s0 := s0) (N := N) (e := e) (fun w : Fin (BoardW s0 N) => nrm w x)
      (fun w => hnrm01 w x) hmem
  have hrb : rowBits (fun w : Fin (BoardW s0 N) => nrm w x) = bitWord (e := e) nrm x :=
    rowBits_bitWord_of_01 (e := e) nrm x (fun w => hnrm01 w x)
  rwa [hrb] at hbw

/-- `betaTile` is the un-reflection of the tile part of the bit word: with the
coordinate-0 bit slice-constant, `betaTile i j t = bitWord⟨0⟩(p) + bitWord⟨tile⟩(p)`. -/
lemma betaTile_eq_unreflect {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (i j : ℤ) (t : TileIdx s0 N) :
    betaTile (e := e) (s0 := s0) (N := N) nrm i j t =
      bitWord (e := e) nrm (slicePt i j) (⟨0, by positivity⟩ : Fin (BoardW s0 N)) +
        bitWord (e := e) nrm (slicePt i j) (tileCoord (s0 := s0) (N := N) t) := by
  dsimp [betaTile, bitWord]
  -- coordinate-0 bit at slicePt 0 0 equals that at slicePt i j (slice-constancy)
  have hc := nrm0_slice_const (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j
  congr 1
  exact (congrArg (parityIn e) hc).symm

/-- The reflected row-0 word of the bit word equals the beta row-0 word. -/
lemma encReflect_row0_eq_beta {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (i j : ℤ) (n : Fin N) :
    encReflect (boardStar (bitWord (e := e) nrm (slicePt i j)))
        (boardRowWord0 (bitWord (e := e) nrm (slicePt i j)) n) =
      fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm i j ((0 : Fin 2), b, n) := by
  funext b
  dsimp [encReflect, encReflectVal, boardRowWord0, boardTile, boardStar]
  exact (betaTile_eq_unreflect (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j ((0 : Fin 2), b, n)).symm

/-- The reflected row-1 word of the bit word equals the beta row-1 word. -/
lemma encReflect_row1_eq_beta {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (i j : ℤ) (n : Fin N) :
    encReflect (boardStar (bitWord (e := e) nrm (slicePt i j)))
        (boardRowWord1 (bitWord (e := e) nrm (slicePt i j)) n) =
      fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n) := by
  funext b
  dsimp [encReflect, encReflectVal, boardRowWord1, boardTile, boardStar]
  exact (betaTile_eq_unreflect (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j ((1 : Fin 2), b, n)).symm

/-- The row words of the un-reflected beta word match (encoded good columns, axiom (ii)
of Ω), per row.  Proof: the bit word at `slicePt i j` is a good board; unfolding row `n`
of `boardGood2` gives `goodColWordRefl` of the reflected row words, which equal the
`betaTile` row words by `encReflect_row0_eq_beta` / `encReflect_row1_eq_beta`
(`betaTile_eq_unreflect` + slice-constancy of coordinate 0). -/
lemma beta_rowGoodColWord {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x))
    (i j : ℤ) (n : Fin N) :
    goodColWord s0 (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm i j ((0 : Fin 2), b, n))
      (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n)) := by
  have hg : boardRowGood2 (s0 := s0) (N := N) (bitWord (e := e) nrm (slicePt i j)) n :=
    (hgood (slicePt i j)).1 n
  unfold boardRowGood2 goodColWordRefl at hg
  have hre0 := encReflect_row0_eq_beta (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j n
  have hre1 := encReflect_row1_eq_beta (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j n
  rw [hre0, hre1] at hg
  exact hg


/-- The row-1 decodes of the beta word form a Scal sequence in `n` (encoded Sudoku
solution, axiom (i) of Ω), at every slice point.  Proof route: `boardScalCond` from
`boardGood2Full_of_normalization` at `slicePt i j` reads
`InScal_q (2^s0) N (n ↦ encB (encReflect (w⟨0⟩) (row-1 word of row n)))`; the reflected
row-1 word equals the `betaTile (1,·,n)` word by `encReflect_row1_eq_beta`, and
`rowWord1Decode`/`boardScalCond` unfold to that expression. -/
lemma beta_ScalCond {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x))
    (i j : ℤ) :
    InScal_q (2 ^ s0) N (fun n : Fin N => encB (fun b : Fin s0 =>
      betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n))) := by
  have hbw := (hgood (slicePt i j)).2
  unfold boardScalCond at hbw
  have hseq : (fun n : Fin N => encB (fun b : Fin s0 =>
        betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n))) =
      (fun n : Fin N => rowWord1Decode (s0 := s0) (N := N) (bitWord (e := e) nrm (slicePt i j)) n) := by
    funext n
    have hre := encReflect_row1_eq_beta (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY i j n
    unfold rowWord1Decode
    rw [← hre]
  rwa [← hseq] at hbw


/-- `betaTile` is unchanged by iterating the row-direction shift `k` times
(`betaTile_shift_nat`), for a natural number of steps. -/
lemma betaTile_shift_nat {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (t : TileIdx s0 N) (i j : ℤ) : ∀ k : ℕ,
    betaTile (e := e) (s0 := s0) (N := N) nrm (i - (k : ℤ) * rowVal t.2.2) (j + (k : ℤ)) t =
      betaTile (e := e) (s0 := s0) (N := N) nrm i j t := by
  intro k
  induction k with
  | zero => simp
  | succ k ih =>
      have h := betaTile_periodic (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper t
        (i - (k : ℤ) * rowVal t.2.2) (j + (k : ℤ))
      have h1 : (i - (k : ℤ) * rowVal t.2.2) - rowVal t.2.2 = i - ((k : ℤ) + 1) * rowVal t.2.2 := by ring
      have h2 : (j + (k : ℤ)) + 1 = j + ((k : ℤ) + 1) := by ring
      rw [h1, h2] at h
      have hk : ((k + 1 : ℕ) : ℤ) = (k : ℤ) + 1 := by norm_num
      rw [hk] at ⊢
      exact h.trans ih



/-! ## Part 6: the decoded boards

The boards `F0/F1` read the un-reflected beta words of the `a = 0/1` rows at the
`(m, 0)`-representative of the cell fibre.  Their values are independent of the fibre
representative (`betaTile_fiber`), so `F1`'s restriction to the line with parameters
`(i,j)` is exactly the `beta_ScalCond` content at `(i,j)`. -/

/-- `betaTile` read as a function of the plane point. -/
def betaTile2 {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (p : ℤ × ℤ) (t : TileIdx s0 N) : ZMod 2 :=
  betaTile (e := e) (s0 := s0) (N := N) nrm p.1 p.2 t

/-- `betaTile2` is periodic along the row direction `(-rowVal t.2.2, 1)`. -/
lemma betaTile2_periodic {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (t : TileIdx s0 N) :
    periodicAlong ((-rowVal t.2.2, (1 : ℤ)) : ℤ × ℤ)
      (fun p : ℤ × ℤ => betaTile2 (e := e) nrm p t) := by
  intro p
  change betaTile (e := e) (s0 := s0) (N := N) nrm (p.1 - rowVal t.2.2) (p.2 + 1) t =
    betaTile (e := e) (s0 := s0) (N := N) nrm p.1 p.2 t
  exact betaTile_periodic (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper t p.1 p.2

/-- The beta word at the `(m, 0)`-representative equals the beta word at any fibre
point `(i,j)` with `m = j * rowVal n + i` (row `n`, `a = 1` side). -/
lemma betaTile_fiber {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (n : Fin N) (b : Fin s0) (i j : ℤ) :
    betaTile (e := e) (s0 := s0) (N := N) nrm (j * rowVal n + i) 0 ((1 : Fin 2), b, n) =
      betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n) := by
  let t : TileIdx s0 N := ((1 : Fin 2), b, n)
  have hper2 : periodicAlong ((-rowVal t.2.2, (1 : ℤ)) : ℤ × ℤ)
      (fun p : ℤ × ℤ => betaTile2 (e := e) nrm p t) :=
    betaTile2_periodic (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper t
  have hstep := zsmul_periodicAlong (A := ℤ × ℤ) (f := fun p : ℤ × ℤ => betaTile2 (e := e) nrm p t)
    ((-rowVal t.2.2, (1 : ℤ)) : ℤ × ℤ) hper2 (-j) ((i, j) : ℤ × ℤ)
  have harg : ((i, j) : ℤ × ℤ) + (-j) • ((-rowVal t.2.2, (1 : ℤ)) : ℤ × ℤ) =
      ((j * rowVal t.2.2 + i, 0) : ℤ × ℤ) := by
    ext
    · dsimp
      ring
    · dsimp
      ring
  rw [harg] at hstep
  dsimp [t] at hstep
  change betaTile (e := e) (s0 := s0) (N := N) nrm (j * rowVal n + i) 0 ((1 : Fin 2), b, n) =
    betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n)
  exact hstep

/-- The decoded board value at row `n`, column `m`: the row-1 beta word read at the
`(m, 0)`-representative. -/
def F1val {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (m : ℤ) : ZMod (2 ^ s0) :=
  encB (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm m 0 ((1 : Fin 2), b, n))

/-- `F1val` on the line `(i,j)` equals the `beta_ScalCond` content at `(i,j)`. -/
lemma F1val_line {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (i j : ℤ) (n : Fin N) :
    F1val (e := e) (s0 := s0) (N := N) nrm n (j * rowVal n + i) =
      encB (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n)) := by
  dsimp [F1val]
  congr 1
  funext b
  exact betaTile_fiber (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper n b i j



/-- An odd integer is a unit modulo `2^s0` (for `s0 ≥ 1`). -/
lemma zmod_isUnit_of_odd_pow2 {s0 : ℕ} (hs0 : 1 ≤ s0) (c : ℤ) (hc : Odd c) :
    IsUnit (c : ZMod (2 ^ s0)) := by
  have hm : ∃ s : ℕ, (2 ^ s0 : ℕ) = 2 ^ (s + 1) := ⟨s0 - 1, by rw [Nat.sub_add_cancel hs0]⟩
  exact zmod_isUnit_of_odd (m := 2 ^ s0) (Int.natAbs_odd.mpr hc) hm

/-- An odd integer is non-zero modulo `2^s0` (it is a unit there). -/
lemma zmod_pow_two_odd_ne_zero {s0 : ℕ} (hs0 : 1 ≤ s0) (c : ℤ) (hc : Odd c) :
    (c : ZMod (2 ^ s0)) ≠ 0 := by
  have hone : (1 : ZMod (2 ^ s0)) ≠ 0 := by
    intro h
    have hd : (2 ^ s0) ∣ 1 := (ZMod.natCast_eq_zero_iff 1 (2 ^ s0)).mp (by simpa using h)
    have hle : 2 ^ s0 ≤ 1 := Nat.le_of_dvd (by omega : 0 < 1) hd
    have h2 : 2 ≤ 2 ^ s0 := by
      have hp := pow_le_pow_right₀ (by norm_num : 1 ≤ 2) hs0
      simpa using hp
    omega
  have hu : IsUnit (c : ZMod (2 ^ s0)) := zmod_isUnit_of_odd_pow2 hs0 c hc
  rcases hu with ⟨u, hu_eq⟩
  have hprod : (u : ZMod (2 ^ s0)) * ((u⁻¹ : (ZMod (2 ^ s0))ˣ) : ZMod (2 ^ s0)) = 1 :=
    Units.mul_inv u
  intro hz
  have hu0 : (u : ZMod (2 ^ s0)) = 0 := by
    rw [hu_eq]
    exact hz
  have hz0 := congrArg (fun x : ZMod (2 ^ s0) => x * ((u⁻¹ : (ZMod (2 ^ s0))ˣ) : ZMod (2 ^ s0))) hu0
  rw [hprod] at hz0
  simp at hz0
  exact hone hz0

/-- The decoded board values are non-zero (Scal values are odd multiples of `f_q`,
which never vanishes). -/
lemma F1val_ne_zero {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x))
    (n : Fin N) (m : ℤ) : F1val (e := e) (s0 := s0) (N := N) nrm n m ≠ 0 := by
  have hsc := beta_ScalCond (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY hgood m 0
  rcases hsc with ⟨a, b, c, hcodd, hg⟩
  have hz := hg n
  dsimp [F1val]
  have hz' : encB (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm m 0 ((1 : Fin 2), b, n)) =
      (c : ZMod (2 ^ s0)) * fq (2 ^ s0) (a * rowVal n + b) := by
    simpa [rowVal] using hz
  rw [hz']
  have hu : IsUnit (c : ZMod (2 ^ s0)) := zmod_isUnit_of_odd_pow2 hs0 c hcodd
  have hf : fq (2 ^ s0) (a * rowVal n + b) ≠ 0 := fq_ne_zero (two_pow_gt_one hs0) (a * rowVal n + b)
  intro hzero
  exact hf ((IsUnit.mul_right_eq_zero hu).mp hzero)



/-- The decoded Sudoku board `F1`: `F1(n,m) = encB` of the row-1 beta word at the
`(m,0)`-representative. -/
def F1board {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))) :
    SudokuBoard (2 ^ s0) N :=
  fun n m => F1val (e := e) (s0 := s0) (N := N) nrm n m

/-- The line restriction of `F1` with parameters `(i,j)` is the `beta_ScalCond` content
at `(i,j)`. -/
lemma F1board_line_eq {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (i j : ℤ) :
    lineRestrict (F1board (e := e) (s0 := s0) (N := N) nrm) i j =
      fun n : Fin N => encB (fun b : Fin s0 =>
        betaTile (e := e) (s0 := s0) (N := N) nrm i j ((1 : Fin 2), b, n)) := by
  funext n
  dsimp [F1board, lineRestrict]
  exact F1val_line (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper i j n

/-- The decoded board is a Sudoku solution (every cell is a non-zero digit and every
non-vertical line restriction is `Scal`). -/
theorem F1board_sudoku {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hper : ∀ w : Fin (BoardW s0 N),
      periodicAlong (rowDirMap (s0 := s0) (N := N) w) (fun x => nrm w x))
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x)) :
    IsSudokuSolution (2 ^ s0) N (F1board (e := e) (s0 := s0) (N := N) nrm) := by
  constructor
  · intro n m
    exact F1val_ne_zero (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper hgood n m
  · intro i j
    have hseq := F1board_line_eq (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hper i j
    rw [hseq]
    exact beta_ScalCond (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY hgood i j



/-! ## Part 7: good columns of the decoded board (step 6 bullet (c)) — PINS with routes

The σ-side structure comes from axiom (c): `BoolPeriodizedPerm e s0 encE0 encE1 encE2 encX
(row0Sel alpha n)` gives `permBijective e s0 encX (row0Sel alpha n)` (parity-vector
bijection along `encX`) and `CompBool`.  The paper's observation (tex 938): a boolean
periodized permutation along `v` with `W` coordinates makes each normalized bit periodic
along `2^W · v`.  Proof route for (L-a): bijectivity of the parity-vector map at `x` and
at `x+v`; the common set `{p(x+k·v) : k = 1, …, 2^W−1}` equals the cube minus `p(x)`
(from bijectivity at `x`) and also the cube minus `p(x + 2^W·v)` (from bijectivity at
`x+v`), forcing `p(x + 2^W·v) = p(x)` per coordinate; then, with `ñ_w = parityIn(u_w) +
parityIn(α_w)` (parityIn_normalized, u_w constant), `ñ_w` and `α_w` are `⟨2^W·v⟩`-
periodic.  For our encode: `W := s0`, `v := encX`, `q := 2^s0`. -/

/-- The σ-side parity-vector map of the row-0 selection is periodic along `q·encX`
(`q := 2^s0`), per coordinate.  Proof (pointwise): `ψ : j ↦ P(x + j.val·encX)` is
bijective at `x` (hperm), and `ψ' : j ↦ P(x + (j.val+1)·encX)` is bijective at
`x + encX`.  If `P(x + q·encX) ≠ P(x)` then, writing `last := q−1`, `ψ'(last) ≠ P x`,
so surjectivity of `ψ'` at `P x` gives `j'` with `j' ≠ last`, i.e.
`P x = P(x + (j'.val+1)·encX) = ψ(j0)` for `j0 := j'.val+1 < q`, contradicting the
injectivity of `ψ` at `0` and `j0`.  Hence `P(x + q·encX) = P x`, i.e. the parity
vector is `q·encX`-periodic; the goal's `((q : ℕ) : ℤ) • encX` equals the nsmul
`q • encX` by `simp`. -/
lemma row0Sel_parity_periodic_q {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (n : Fin N) (b : Fin s0) (x : EncodeG) :
    parityIn e ((row0Sel (e := e) alpha n) (x + ((2 ^ s0 : ℕ) : ℤ) • encX) b) =
      parityIn e ((row0Sel (e := e) alpha n) x b) := by
  let q : ℕ := 2 ^ s0
  let P : EncodeG → (Fin s0 → ZMod 2) :=
    fun y => fun bb : Fin s0 => parityIn e ((row0Sel (e := e) alpha n) y bb)
  have hqpos : 0 < q := by
    dsimp [q]
    have h := two_pow_gt_one hs0
    omega
  have hψ0 : Function.Bijective (fun j : Fin q => P (x + permShift s0 encX j)) := by
    simpa [P, q] using (hperm n x)
  have hψ1 : Function.Bijective (fun j : Fin q => P ((x + encX) + permShift s0 encX j)) := by
    simpa [P, q] using (hperm n (x + encX))
  have hψ1' : ∀ j : Fin q, P ((x + encX) + permShift s0 encX j) = P (x + (j.val + 1 : ℕ) • encX) := by
    intro j
    congr 1
    dsimp [permShift]
    rw [add_assoc]
    congr 1
    have h2 : (1 + j.val : ℕ) • encX = encX + (j.val : ℕ) • encX := by
      rw [add_nsmul, one_nsmul]
    rw [← h2]
    congr 1
    omega
  let lastq : Fin q := ⟨q - 1, by
    have hq' : 0 < q := hqpos
    omega⟩
  have hψ0_0 : P (x + permShift s0 encX (0 : Fin q)) = P x := by
    congr 1
    dsimp [permShift]
    simp
  have hlast : P ((x + encX) + permShift s0 encX lastq) = P (x + (q : ℕ) • encX) := by
    rw [hψ1' lastq]
    have hcoeff : lastq.val + 1 = q := by
      have hq1 : 1 ≤ q := by
        dsimp [q]
        exact le_of_lt (two_pow_gt_one hs0)
      dsimp [lastq]
      omega
    rw [hcoeff]
  have hper : P (x + (q : ℕ) • encX) = P x := by
    by_contra hne
    have hψ1last : P ((x + encX) + permShift s0 encX lastq) ≠ P x := by
      intro hz
      apply hne
      rw [← hlast]
      exact hz
    have hsurj := hψ1.2 (P x)
    rcases hsurj with ⟨j', hj'⟩
    have hj'ne : j' ≠ lastq := by
      intro hjl
      exact hψ1last (by simpa [hjl] using hj')
    have hk : j'.val + 1 < q := by
      have hlt := j'.isLt
      have hlastval : j'.val ≠ q - 1 := by
        intro hv
        apply hj'ne
        apply Fin.ext
        dsimp [lastq]
        exact hv
      omega
    let j0 : Fin q := ⟨j'.val + 1, hk⟩
    have hψ0j0 : P (x + permShift s0 encX j0) = P x := by
      calc
        P (x + permShift s0 encX j0) = P (x + ((j'.val + 1 : ℕ) • encX)) := by
          rfl
        _ = P ((x + encX) + permShift s0 encX j') := (hψ1' j').symm
        _ = P x := hj'
    have heq0j0 : P (x + permShift s0 encX (0 : Fin q)) = P (x + permShift s0 encX j0) := by
      rw [hψ0_0]
      exact hψ0j0.symm
    have h0j0 : (0 : Fin q) = j0 := hψ0.1 heq0j0
    have hz0 : j0.val = 0 := (congrArg (fun t : Fin q => t.val) h0j0).symm
    have hj0val : j0.val = j'.val + 1 := by dsimp [j0]
    omega
  change P (x + ((2 ^ s0 : ℕ) : ℤ) • encX) b = P x b
  have hzq : ((2 ^ s0 : ℕ) : ℤ) • encX = (2 ^ s0 : ℕ) • encX := by simp
  rw [hzq]
  change P (x + (q : ℕ) • encX) b = P x b
  exact congrFun hper b


/-- The `a = 0` (σ-side) decoded board values. -/
def F0val {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (m : ℤ) : ZMod (2 ^ s0) :=
  encB (fun b : Fin s0 => betaTile (e := e) (s0 := s0) (N := N) nrm m 0 ((0 : Fin 2), b, n))

/-- The `a = 0` decoded board. -/
def F0board {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))) :
    SudokuBoard (2 ^ s0) N :=
  fun n m => F0val (e := e) (s0 := s0) (N := N) nrm n m

/-- `F0(n,m) = F1(n,m)` whenever the σ-side value is non-zero (encoded good columns,
axiom (ii) of Ω), per cell.  Pinned: `beta_rowGoodColWord` at the `(m,0)`-representative
gives the word matching `encB(beta (0,·,n)) ≠ 0 → beta (0,·,n) = beta (1,·,n)`. -/
lemma F0_eq_F1_of_ne_zero {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x))
    (n : Fin N) (m : ℤ) : F0val (e := e) (s0 := s0) (N := N) nrm n m ≠ 0 →
      F1val (e := e) (s0 := s0) (N := N) nrm n m = F0val (e := e) (s0 := s0) (N := N) nrm n m := by
  intro hne
  dsimp [F0val] at hne
  have hmatch := beta_rowGoodColWord (e := e) (s0 := s0) (N := N) nrm hnrmX hnrmY hgood m 0 n
  unfold goodColWord at hmatch
  have heq := hmatch hne
  dsimp [F1val, F0val]
  rw [← heq]


/-! ## Part 8: (c2) — the σ-side (`a = 0`) beta words are q-horizontal-periodic -/

/-- Shifting the slice point horizontally by `q = 2^s0` is the nsmul `q • encX`. -/
lemma slicePt_horizontal_q {s0 : ℕ} (m : ℤ) :
    slicePt (m + (2 ^ s0 : ℤ)) 0 = slicePt m 0 + ((2 ^ s0 : ℕ) • encX) := by
  apply Prod.ext
  · dsimp [slicePt, encX]
    apply Prod.ext
    · simp
    · simp
  · funext t
    dsimp [slicePt, encX]
    simp

/-- The σ-side normalized bits are periodic along `q • encX` (transfer of the σ-side
parity q-periodicity to `nrm`, via `ñ_w = parityIn(u_w) + parityIn(α_w)`).
Pinned: encodePropSFull_normalization gives (u, b, nrm); row0Sel_parity_periodic_q at
n gives parityIn(α_{0,b,n}) q•encX-periodic; parityIn-normalized splitting of
α_{0,b,n} = u_{0,b,n} + b·ñ_{0,b,n} with u constant gives ñ-periodicity. -/
lemma σside_nrm_qperiodic {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hb : b ∉ evenSub e)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (n : Fin N) (bb : Fin s0) :
    periodicAlong (((2 ^ s0 : ℕ) : ℤ) • encX)
      (fun x => nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x) := by
  intro x
  let w : Fin (BoardW s0 N) := tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)
  let dir : EncodeG := ((2 ^ s0 : ℕ) : ℤ) • encX
  change nrm w (x + dir) = nrm w x
  have hp := row0Sel_parity_periodic_q (e := e) (s0 := s0) (N := N) hs0 alpha hperm n bb x
  -- hp : parityIn e (row0Sel alpha n (x + dir) bb) = parityIn e (row0Sel alpha n x bb)
  have hp' : parityIn e (alpha (x + dir) w) = parityIn e (alpha x w) := by
    simpa [w, dir, row0Sel, selRow0] using hp
  have h1 : parityIn e (alpha (x + dir) w) = parityIn e (u w) + parityIn e (nrm w (x + dir)) := by
    rw [hval w (x + dir)]
    exact parityIn_normalized e hb (hnrm01 w (x + dir))
  have h2 : parityIn e (alpha x w) = parityIn e (u w) + parityIn e (nrm w x) := by
    rw [hval w x]
    exact parityIn_normalized e hb (hnrm01 w x)
  have hpar : parityIn e (nrm w (x + dir)) = parityIn e (nrm w x) := by
    have hh : parityIn e (u w) + parityIn e (nrm w (x + dir)) =
        parityIn e (u w) + parityIn e (nrm w x) := by
      rw [← h1, ← h2]
      exact hp'
    exact add_left_cancel hh
  have hz : parityIn e (0 : ZMod (2 ^ (e + 1))) = 0 := parityIn_zero e
  have ho : parityIn e (1 : ZMod (2 ^ (e + 1))) = 1 := parityIn_one e
  rcases hnrm01 w (x + dir) with h0a | h1a
  · rcases hnrm01 w x with h0b | h1b
    · rw [h0a, h0b]
    · exfalso
      rw [h0a, h1b] at hpar
      rw [hz, ho] at hpar
      exact zmod2_zero_ne_one hpar
  · rcases hnrm01 w x with h0b | h1b
    · exfalso
      rw [h1a, h0b] at hpar
      rw [ho, hz] at hpar
      exact zmod2_zero_ne_one hpar.symm
    · rw [h1a, h1b]

lemma F0val_qperiodic {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (n : Fin N)
    (hσ : ∀ bb : Fin s0, periodicAlong (((2 ^ s0 : ℕ) : ℤ) • encX)
      (fun x => nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x))
    (m : ℤ) :
    F0val (e := e) (s0 := s0) (N := N) nrm n (m + (2 ^ s0 : ℤ)) =
      F0val (e := e) (s0 := s0) (N := N) nrm n m := by
  dsimp [F0val]
  apply congrArg encB
  funext b
  -- betaTile (m+q) 0 ((0,b,n)) = bitNrm w0 (slicePt 0 0) + bitNrm tile (slicePt (m+q) 0);
  -- both sides share the (slice-constant) reflection bit, so it suffices to compare the
  -- tile bits at the two slice points, which differ by q • encX (slicePt_horizontal_q).
  dsimp [betaTile, bitNrm]
  congr 1
  have hperb := hσ b
  have hslice := slicePt_horizontal_q (s0 := s0) m
  rw [hslice]
  apply congrArg (parityIn e)
  simpa using (hperb (slicePt m 0))

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
open scoped Pointwise
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section
attribute [local instance] Classical.propDecidable

/-! # Phase 3 encode, step 6 bullet (c3)/(c4): the σ-side decoded board `F0` has the
column structure `F0(n,m) = σ_n(m mod q)`, and `F1` has good columns. -/

/-- Moving the slice point by one unit of `encX` equals adding `encX`. -/
lemma slicePt_add_encX (a : ℤ) : slicePt a 0 + encX = slicePt (a + 1) 0 := by
  ext
  all_goals simp [slicePt, encX]

/-- `slicePt (m+k) 0 = slicePt m 0 + k • encX` (k : ℕ). -/
lemma slicePt_nsmul_encX (m : ℤ) (k : ℕ) :
    slicePt m 0 + (k : ℕ) • encX = slicePt (m + (k : ℤ)) 0 := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [add_nsmul, one_nsmul]
      rw [← add_assoc, ih]
      have harg : (m + (k : ℤ)) + 1 = m + ((k + 1 : ℕ) : ℤ) := by
        rw [Nat.cast_add, Nat.cast_one]
        ring
      rw [← harg]
      exact slicePt_add_encX (m + (k : ℤ))

/-- The σ-side (`a = 0`) `nrm`-parity word at a point `x` (row `n`). -/
def sigWord {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (x : EncodeG) : Fin s0 → ZMod 2 :=
  fun b => parityIn e (nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), b, n)) x)

/-- The constant reflection bit (value of coordinate 0 at the origin slice). -/
def reflBitWord {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1))) :
    Fin s0 → ZMod 2 :=
  fun _ => bitNrm (e := e) nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) (slicePt 0 0)

/-- The σ-side word read by `F0` at column `m` (reflection bit + tile bits). -/
def F0word {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (m : ℤ) : Fin s0 → ZMod 2 :=
  fun b => betaTile (e := e) (s0 := s0) (N := N) nrm m 0 ((0 : Fin 2), b, n)

/-- `F0val` is `encB` of `F0word`. -/
lemma F0val_eq_encB_F0word {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (m : ℤ) :
    F0val (e := e) (s0 := s0) (N := N) nrm n m = encB (F0word (e := e) (s0 := s0) (N := N) nrm n m) := by
  rfl

/-- The σ-side word is the reflection bit plus the tile bits at the slice point. -/
lemma F0word_eq {e s0 N : ℕ} (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N) (m : ℤ) :
    F0word (e := e) (s0 := s0) (N := N) nrm n m =
      reflBitWord (e := e) (s0 := s0) (N := N) nrm +
      sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt m 0) := by
  funext b
  dsimp [F0word, sigWord, betaTile, bitNrm, reflBitWord]

/-- From the normalization, the `nrm` σ-parity bit at `x` is the α-parity bit minus the
`u`-parity bit (same coordinate). -/
lemma sigWord_eq_psi_sub {e s0 N : ℕ}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (n : Fin N) (x : EncodeG) (bb : Fin s0) :
    parityIn e (nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x) =
      parityIn e (alpha x (selRow0 n bb)) - parityIn e (u (selRow0 n bb)) := by
  dsimp [selRow0]
  let t : Fin (BoardW s0 N) := tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)
  have hp := parityIn_normalized (u := u t) e hb (hnrm01 t x)
  have hα : parityIn e (alpha x t) = parityIn e (u t) + parityIn e (nrm t x) := by
    rw [hval t x]
    exact hp
  calc
    parityIn e (nrm t x) = (parityIn e (u t) + parityIn e (nrm t x)) - parityIn e (u t) := by abel
    _ = parityIn e (alpha x t) - parityIn e (u t) := by rw [hα]

/-- Subtracting a fixed word is a bijection of the word space. -/
lemma sub_const_bijective {A : Type*} [AddCommGroup A] (c : A) :
    Function.Bijective (fun u : A => u - c) := by
  exact (Equiv.subRight c).bijective


/-- The σ-side `nrm`-parity word is bijective on every window of `q := 2^s0`
consecutive columns (transfer of axiom (c) `permBijective` through the normalization). -/
lemma sigWord_window_bijective {e s0 N : ℕ}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (n : Fin N) (m : ℤ) :
    Function.Bijective (fun j : Fin (2 ^ s0) =>
      sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt (m + (j.val : ℤ)) 0)) := by
  let ψ : EncodeG → (Fin s0 → ZMod 2) :=
    fun y => fun bb : Fin s0 => parityIn e (alpha y (selRow0 n bb))
  let uW : Fin s0 → ZMod 2 := fun bb : Fin s0 => parityIn e (u (selRow0 n bb))
  have hbjψ : Function.Bijective
      (fun j : Fin (2 ^ s0) => ψ (slicePt m 0 + permShift s0 encX j)) := by
    simpa [ψ, row0Sel, selRow0] using (hperm n (slicePt m 0))
  have hword : ∀ y : EncodeG,
      sigWord (e := e) (s0 := s0) (N := N) nrm n y = ψ y - uW := by
    intro y
    funext bb
    dsimp [ψ, uW, sigWord]
    exact sigWord_eq_psi_sub (e := e) (s0 := s0) (N := N) alpha u b nrm hb hval hnrm01 n y bb
  have hbjword0 : Function.Bijective (fun j : Fin (2 ^ s0) =>
      sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt m 0 + permShift s0 encX j)) := by
    have hcomp : Function.Bijective
        ((fun v : Fin s0 → ZMod 2 => v - uW) ∘
          (fun j : Fin (2 ^ s0) => ψ (slicePt m 0 + permShift s0 encX j))) := by
      exact Function.Bijective.comp (sub_const_bijective (c := uW)) hbjψ
    have hsame : ((fun v : Fin s0 → ZMod 2 => v - uW) ∘
          (fun j : Fin (2 ^ s0) => ψ (slicePt m 0 + permShift s0 encX j))) =
        (fun j : Fin (2 ^ s0) =>
          sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt m 0 + permShift s0 encX j)) := by
      funext j
      exact (hword (slicePt m 0 + permShift s0 encX j)).symm
    rwa [hsame] at hcomp
  have harg : (fun j : Fin (2 ^ s0) =>
        sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt m 0 + permShift s0 encX j)) =
      (fun j : Fin (2 ^ s0) =>
        sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt (m + (j.val : ℤ)) 0)) := by
    funext j
    congr 1
    dsimp [permShift]
    exact slicePt_nsmul_encX m (j.val)
  rwa [harg] at hbjword0

/-- The σ-side `F0`-word is bijective on every window of `q := 2^s0` consecutive
columns. -/
lemma F0word_window_bijective {e s0 N : ℕ}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (n : Fin N) (m : ℤ) :
    Function.Bijective (fun j : Fin (2 ^ s0) =>
      F0word (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))) := by
  have hbw0 : Function.Bijective (fun j : Fin (2 ^ s0) =>
      sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt (m + (j.val : ℤ)) 0)) :=
    sigWord_window_bijective (e := e) (s0 := s0) (N := N) alpha u b nrm hb hval hnrm01 hperm n m
  have hcomp : Function.Bijective
      ((fun v : Fin s0 → ZMod 2 => reflBitWord (e := e) (s0 := s0) (N := N) nrm + v) ∘
        (fun j : Fin (2 ^ s0) =>
          sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt (m + (j.val : ℤ)) 0))) := by
    exact Function.Bijective.comp
      (add_const_bijective (c := reflBitWord (e := e) (s0 := s0) (N := N) nrm)) hbw0
  have hsame : ((fun v : Fin s0 → ZMod 2 => reflBitWord (e := e) (s0 := s0) (N := N) nrm + v) ∘
        (fun j : Fin (2 ^ s0) =>
          sigWord (e := e) (s0 := s0) (N := N) nrm n (slicePt (m + (j.val : ℤ)) 0))) =
      (fun j : Fin (2 ^ s0) =>
        F0word (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))) := by
    funext j
    exact (F0word_eq (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))).symm
  rwa [hsame] at hcomp

/-- The decoded σ-side values `F0(n,m)` are bijective on every window of
`q := 2^s0` consecutive columns. -/
lemma F0val_window_bijective {e s0 N : ℕ}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (n : Fin N) (m : ℤ) :
    Function.Bijective (fun j : Fin (2 ^ s0) =>
      F0val (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))) := by
  have hbw := F0word_window_bijective (e := e) (s0 := s0) (N := N) alpha u b nrm hb hval hnrm01 hperm n m
  have hcomp := Function.Bijective.comp (encB_bijective s0) hbw
  have hsame : (encB ∘ (fun j : Fin (2 ^ s0) =>
        F0word (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ)))) =
      (fun j : Fin (2 ^ s0) =>
        F0val (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))) := by
    funext j
    exact (F0val_eq_encB_F0word (e := e) (s0 := s0) (N := N) nrm n (m + (j.val : ℤ))).symm
  rwa [hsame] at hcomp


/-- `F0val` is invariant under integer multiples of `q := 2^s0` (given q-periodicity). -/
lemma F0val_shift_of_qperiodic {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N)
    (hper : ∀ m : ℤ, F0val (e := e) (s0 := s0) (N := N) nrm n (m + (2 ^ s0 : ℤ)) =
      F0val (e := e) (s0 := s0) (N := N) nrm n m)
    (x k : ℤ) :
    F0val (e := e) (s0 := s0) (N := N) nrm n (x + k * (2 ^ s0 : ℤ)) =
      F0val (e := e) (s0 := s0) (N := N) nrm n x := by
  have hz := zsmul_periodicAlong (A := ℤ) (v := (2 ^ s0 : ℤ))
    (f := fun m : ℤ => F0val (e := e) (s0 := s0) (N := N) nrm n m) hper k x
  simpa [zsmul_eq_mul] using hz

/-- `F0val` depends only on the class of its column modulo `q := 2^s0`. -/
lemma F0val_congr_zmod {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (n : Fin N)
    (hper : ∀ m : ℤ, F0val (e := e) (s0 := s0) (N := N) nrm n (m + (2 ^ s0 : ℤ)) =
      F0val (e := e) (s0 := s0) (N := N) nrm n m)
    {m₁ m₂ : ℤ} (h : (m₁ : ZMod (2 ^ s0)) = (m₂ : ZMod (2 ^ s0))) :
    F0val (e := e) (s0 := s0) (N := N) nrm n m₁ =
      F0val (e := e) (s0 := s0) (N := N) nrm n m₂ := by
  have hmod : m₁ ≡ m₂ [ZMOD (2 ^ s0 : ℤ)] :=
    (ZMod.intCast_eq_intCast_iff m₁ m₂ (2 ^ s0)).mp h
  have hdvd := Int.ModEq.dvd hmod
  rcases hdvd with ⟨t, ht⟩
  have hm : m₂ = m₁ + t * (2 ^ s0 : ℤ) := by
    rw [mul_comm] at ht
    rw [← ht]
    ring
  rw [hm]
  symm
  exact F0val_shift_of_qperiodic (e := e) (s0 := s0) (N := N) nrm n hper m₁ t

/-- THEOREM (c3): for each row `n`, the σ-side decoded values `m ↦ F0val n m` are a
permutation of `ZMod q` applied to `m mod q`.  So `F0board` is a "permuted column"
board (each column a full residue system). -/
theorem F0board_column_structure {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (hσ : ∀ n : Fin N, ∀ bb : Fin s0, periodicAlong (((2 ^ s0 : ℕ) : ℤ) • encX)
      (fun x => nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x))
    (n : Fin N) :
    ∃ σ : ZMod (2 ^ s0) ≃ ZMod (2 ^ s0),
      ∀ m : ℤ, F0val (e := e) (s0 := s0) (N := N) nrm n m = σ (m : ZMod (2 ^ s0)) := by
  classical
  haveI : NeZero (2 ^ s0) := ⟨pow_ne_zero s0 (by norm_num : (2 : ℕ) ≠ 0)⟩
  let f : ZMod (2 ^ s0) → ZMod (2 ^ s0) := fun r =>
    F0val (e := e) (s0 := s0) (N := N) nrm n (r.val : ℤ)
  have hper : ∀ m : ℤ, F0val (e := e) (s0 := s0) (N := N) nrm n (m + (2 ^ s0 : ℤ)) =
      F0val (e := e) (s0 := s0) (N := N) nrm n m := by
    intro m
    exact F0val_qperiodic (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY n (hσ n) m
  have hwin : Function.Bijective (fun j : Fin (2 ^ s0) =>
      F0val (e := e) (s0 := s0) (N := N) nrm n (j.val : ℤ)) := by
    have hb0 := F0val_window_bijective (e := e) (s0 := s0) (N := N) alpha u b nrm hb hval hnrm01 hperm n 0
    simpa using hb0
  have hinj : Function.Injective f := by
    intro r₁ r₂ hf
    let j₁ : Fin (2 ^ s0) := ⟨r₁.val, ZMod.val_lt r₁⟩
    let j₂ : Fin (2 ^ s0) := ⟨r₂.val, ZMod.val_lt r₂⟩
    have hfj : F0val (e := e) (s0 := s0) (N := N) nrm n (j₁.val : ℤ) =
        F0val (e := e) (s0 := s0) (N := N) nrm n (j₂.val : ℤ) := by
      simpa [f, j₁, j₂] using hf
    have hjeq : j₁ = j₂ := hwin.1 (by simpa [j₁, j₂] using hfj)
    have hval_eq : r₁.val = r₂.val := congrArg Fin.val hjeq
    calc
      r₁ = (r₁.val : ZMod (2 ^ s0)) := (ZMod.natCast_zmod_val r₁).symm
      _ = (r₂.val : ZMod (2 ^ s0)) := by rw [hval_eq]
      _ = r₂ := ZMod.natCast_zmod_val r₂
  have hsurj : Function.Surjective f := by
    intro y
    rcases hwin.2 y with ⟨j, hj⟩
    refine ⟨(j.val : ZMod (2 ^ s0)), ?_⟩
    have hv : (j.val : ZMod (2 ^ s0)).val = j.val := by
      rw [ZMod.val_natCast]
      exact Nat.mod_eq_of_lt j.isLt
    have hcast : (((j.val : ZMod (2 ^ s0)).val : ℕ) : ℤ) = (j.val : ℤ) := by
      exact_mod_cast hv
    have hmain : F0val (e := e) (s0 := s0) (N := N) nrm n (((j.val : ZMod (2 ^ s0)).val : ℕ) : ℤ) = y := by
      rw [hcast]
      exact hj
    change F0val (e := e) (s0 := s0) (N := N) nrm n (((j.val : ZMod (2 ^ s0)).val : ℕ) : ℤ) = y
    exact hmain
  refine ⟨Equiv.ofBijective f ⟨hinj, hsurj⟩, ?_⟩
  intro m
  have hz : (m : ZMod (2 ^ s0)) = (((m : ZMod (2 ^ s0)).val : ℕ) : ZMod (2 ^ s0)) := by
    simpa using (ZMod.natCast_zmod_val (a := (m : ZMod (2 ^ s0)))).symm
  have hmain : F0val (e := e) (s0 := s0) (N := N) nrm n m =
      F0val (e := e) (s0 := s0) (N := N) nrm n (((m : ZMod (2 ^ s0)).val : ℕ) : ℤ) := by
    exact F0val_congr_zmod (e := e) (s0 := s0) (N := N) nrm n hper (by simpa using hz)
  change F0val (e := e) (s0 := s0) (N := N) nrm n m =
    F0val (e := e) (s0 := s0) (N := N) nrm n (((m : ZMod (2 ^ s0)).val : ℕ) : ℤ)
  exact hmain

/-- THEOREM (c4): the decoded board `F1` has good columns (matching of the σ-side
permutation through `F0_eq_F1_of_ne_zero`, axiom (ii) of Ω). -/
theorem F1board_goodColumns {e s0 N : ℕ} (hs0 : 1 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (u : Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (hnrmX : periodicAlong encXdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hnrmY : periodicAlong encYdir (fun x => nrm (⟨0, by positivity⟩ : Fin (BoardW s0 N)) x))
    (hb : b ∉ evenSub e)
    (hval : ∀ w x, alpha x w = u w + b * nrm w x)
    (hnrm01 : ∀ w x, nrm w x = 0 ∨ nrm w x = 1)
    (hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x))
    (hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n))
    (hσ : ∀ n : Fin N, ∀ bb : Fin s0, periodicAlong (((2 ^ s0 : ℕ) : ℤ) • encX)
      (fun x => nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x)) :
    HasGoodColumns (2 ^ s0) N (F1board (e := e) (s0 := s0) (N := N) nrm) := by
  intro n
  rcases F0board_column_structure (e := e) (s0 := s0) (N := N) hs0 alpha u b nrm
    hnrmX hnrmY hb hval hnrm01 hperm hσ n with ⟨σ, hσ0⟩
  refine ⟨σ, ?_⟩
  intro m hm
  have hf0 : F0val (e := e) (s0 := s0) (N := N) nrm n m ≠ 0 := by
    rw [hσ0 m]
    exact hm
  have hf := F0_eq_F1_of_ne_zero (e := e) (s0 := s0) (N := N) hs0 nrm hnrmX hnrmY hgood n m hf0
  dsimp [F1board]
  rw [hf, hσ0 m]

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
open scoped Pointwise
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section
attribute [local instance] Classical.propDecidable

/-! # Phase 3 encode, step 6 bullet (d): aperiodicity of the decoded board `F1`.

From a finite-index subgroup `L` of `EncodeG = (ℤ×ℤ) × Parity3` under which every
coordinate of a strengthened solution `alpha` is invariant, the horizontal square-lattice
lemma gives `M > 0` with the horizontal direction `g₀ := ((M,0),(0,0,0)) ∈ L`; every
coordinate of the normalization `nrm` is then `g₀`-periodic, so `F1board` is
`VerticalPeriod (M:ℤ)`, contradicting `main_sudoku_no_verticalPeriod` (the decode gives
`F1` a Sudoku solution with good columns at width `N := 2^s0 * 2^s0`). -/

/-- The horizontal plane direction `((M,0),(0,0,0))`. -/
def hdir (M : ℕ) : EncodeG := (((M : ℤ), (0 : ℤ)), (fun _ : Fin 3 => (0 : ZMod 2)))

/-- `(M : ℕ) • encX` is the horizontal direction `hdir M`. -/
lemma hdir_eq_nsmul (M : ℕ) : hdir M = (M : ℕ) • encX := by
  ext <;> simp [hdir, encX]

/-- Moving the slice point by `M` units horizontally equals adding `hdir M`. -/
lemma slicePt_add_hdir (m : ℤ) (M : ℕ) :
    slicePt (m + (M : ℤ)) 0 = slicePt m 0 + hdir M := by
  rw [hdir_eq_nsmul]
  exact (slicePt_nsmul_encX m M).symm

/-- If the `nrm`-value of a tile is `hdir M`-periodic, the tile's beta value is
`M`-periodic in the first plane coordinate. -/
lemma betaTile_horizontal_period {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (M : ℕ) (t : TileIdx s0 N)
    (hper : periodicAlong (hdir M) (fun x => nrm (tileCoord (s0 := s0) (N := N) t) x))
    (m : ℤ) :
    betaTile (e := e) (s0 := s0) (N := N) nrm (m + (M : ℤ)) 0 t =
      betaTile (e := e) (s0 := s0) (N := N) nrm m 0 t := by
  dsimp [betaTile]
  congr 1
  dsimp [bitNrm]
  have hs : slicePt (m + (M : ℤ)) 0 = slicePt m 0 + hdir M := slicePt_add_hdir m M
  rw [hs]
  exact congrArg (parityIn e) (hper (slicePt m 0))

/-- If every coordinate of `nrm` is `hdir M`-periodic, then `F1board` has the
vertical period `(M : ℤ)`. -/
lemma F1board_verticalPeriod_of_coord_period {e s0 N : ℕ}
    (nrm : Fin (BoardW s0 N) → EncodeG → ZMod (2 ^ (e + 1)))
    (M : ℕ)
    (hper : ∀ w : Fin (BoardW s0 N), periodicAlong (hdir M) (fun x => nrm w x)) :
    VerticalPeriod (F1board (e := e) (s0 := s0) (N := N) nrm) (M : ℤ) := by
  intro r m
  dsimp [F1board, F1val]
  apply congrArg encB
  funext b
  exact betaTile_horizontal_period (e := e) (s0 := s0) (N := N) nrm M ((1 : Fin 2), b, r)
    (hper (tileCoord (s0 := s0) (N := N) ((1 : Fin 2), b, r))) m


/-- Bullet (d): a strengthened solution tuple of property `S` (at width
`N := 2^s0 * 2^s0`, `s0 ≥ 24`) has NO finite-index-subgroup period in any coordinate:
its decoded `F1` board would be a common vertical-periodic Sudoku solution with good
columns, contradicting `main_sudoku_no_verticalPeriod`. -/
theorem encodePropSFull_aperiodic {e s0 : ℕ} (hs0 : 24 ≤ s0)
    (alpha : EncodeG → (Fin (BoardW s0 (2 ^ s0 * 2 ^ s0)) → ZMod (2 ^ (e + 1))))
    (hS : encodePropSFull (e := e) (s0 := s0) (N := 2 ^ s0 * 2 ^ s0) alpha) :
    ¬ ∃ L : AddSubgroup EncodeG, L.FiniteIndex ∧
      ∀ x : EncodeG, ∀ g : EncodeG, g ∈ L →
        ∀ w : Fin (BoardW s0 (2 ^ s0 * 2 ^ s0)), alpha (x + g) w = alpha x w := by
  classical
  let N : ℕ := 2 ^ s0 * 2 ^ s0
  rintro ⟨L, hLfin, hLinv⟩
  have hmult := Commons.GroupTheory.finiteIndex_contains_horizontal (G := Parity3) L hLfin
  rcases hmult with ⟨M, hMpos, hMin⟩
  have hg0 : hdir M ∈ L := by
    have hz : ((fun _ : Fin 3 => (0 : ZMod 2)) : Parity3) = (0 : Parity3) := by
      funext z
      simp
    rw [hdir, hz]
    exact hMin
  have hs01 : 1 ≤ s0 := by omega
  rcases encodePropSFull_normalization (e := e) (s0 := s0) (N := N) hs01 alpha hS with
    ⟨u, b, nrm, hb, hval, hnrm01, hperRow, hX, hY, hΩ⟩
  have hperm : ∀ n : Fin N, permBijective e s0 encX (row0Sel (e := e) alpha n) := by
    rcases hS with ⟨hS1, _hX0, _hY0⟩
    rcases hS1 with ⟨_hPΩ, hBC⟩
    rcases hBC with ⟨_hrow, hBPP⟩
    intro n
    exact (hBPP n).2
  have hgood : ∀ x : EncodeG, boardGood2Full (s0 := s0) (N := N) (bitWord (e := e) nrm x) :=
    fun x => boardGood2Full_of_normalization (e := e) (s0 := s0) (N := N) nrm hnrm01 hΩ x
  have hσ : ∀ n : Fin N, ∀ bb : Fin s0, periodicAlong (((2 ^ s0 : ℕ) : ℤ) • encX)
      (fun x => nrm (tileCoord (s0 := s0) (N := N) ((0 : Fin 2), bb, n)) x) := by
    intro n bb
    exact σside_nrm_qperiodic (e := e) (s0 := s0) (N := N) hs01 alpha hperm u b nrm hval hb hnrm01 n bb
  have hSud : IsSudokuSolution (2 ^ s0) N (F1board (e := e) (s0 := s0) (N := N) nrm) :=
    F1board_sudoku (e := e) (s0 := s0) (N := N) hs01 nrm hX hY hperRow hgood
  have hGC : HasGoodColumns (2 ^ s0) N (F1board (e := e) (s0 := s0) (N := N) nrm) :=
    F1board_goodColumns (e := e) (s0 := s0) (N := N) hs01 alpha u b nrm hX hY hb hval hnrm01 hgood hperm hσ
  have hnrmPer : ∀ w : Fin (BoardW s0 N), periodicAlong (hdir M) (fun x => nrm w x) := by
    intro w x
    have hα := hLinv x (hdir M) hg0 w
    have h1 : u w + b * nrm w (x + hdir M) = u w + b * nrm w x := by
      rw [← hval w (x + hdir M), ← hval w x]
      exact hα
    have h2 : b * nrm w (x + hdir M) = b * nrm w x := add_left_cancel h1
    exact IsUnit.mul_left_cancel (mef_IsUnit_of_not_evenSub hb) h2
  have hVPer : VerticalPeriod (F1board (e := e) (s0 := s0) (N := N) nrm) (M : ℤ) :=
    F1board_verticalPeriod_of_coord_period (e := e) (s0 := s0) (N := N) nrm M hnrmPer
  have hMne : (M : ℤ) ≠ 0 := by exact_mod_cast (ne_of_gt hMpos)
  have hcontr : ¬ VerticalPeriod (F1board (e := e) (s0 := s0) (N := N) nrm) (M : ℤ) :=
    main_sudoku_no_verticalPeriod (t := s0) hs0
      (F := F1board (e := e) (s0 := s0) (N := N) nrm) hSud hGC (M : ℤ) hMne
  exact hcontr hVPer

end
end Commons.PeriodicTiling



open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section
attribute [local instance] Classical.propDecidable

/-! # Top layer: from the aperiodic weakly-expressible encode property to the root theorem.

The encode development (dev_encode_* → dev_c3 → dev_c4) proved:
  * `encodePropSFull_satisfiable`: the strengthened property is satisfiable (alphaStd);
  * `encodePropSFull_weakExpressible`: it is weakly expressible;
  * `encodePropSFull_aperiodic`: every tuple obeying it is aperiodic (no finite-index
    subgroup leaves all coordinates invariant) -- via the Sudoku rigidity theorem.

Here we assemble the root theorem `existence_aperiodic_functional_system_core_full`:
pick `s0 = 24`, `N = 2^s0 * 2^s0`, `e = 96`; the weak-expressibility gives an
expressible functional system `S` over `EncodeG` with codomain
`Fin (BoardW s0 N + M₀) → ZMod (2^(e+1))`, whose solutions are exactly the `Pstar`
tuples; satisfiability and aperiodicity of `S` follow from the encode theorems plus
the Fin-splitting of a tuple; finally the reassociation AddEquiv
`assoc : EncodeG ≃+ (ℤ × ℤ × Parity3)` transports `S` to the right-associated
domain of the root statement. -/

/-! ## The concrete parameters and the reassociation AddEquiv -/

/-- `s0 := 24`: the width parameter of the Sudoku rigidity theorem (`24 ≤ s0`). -/
def ps0 : ℕ := 24
/-- `N := 2^s0 * 2^s0`: the board width used by the encode chain. -/
def pN : ℕ := 2 ^ ps0 * 2 ^ ps0
/-- `e := 96`: the exponent of the value ring `ZMod (2^(e+1))`. -/
def pe : ℕ := 96

lemma ps0_h24 : 24 ≤ ps0 := by norm_num [ps0]
lemma ps0_h1 : 1 ≤ ps0 := by norm_num [ps0]
lemma pN_h1 : 1 ≤ pN := by norm_num [pN, ps0]
lemma pe_h1 : 1 ≤ pe := by norm_num [pe]
lemma hbig_ok : 4 * (ps0 * pN) < 2 ^ (pe + 1) := by
  norm_num [ps0, pN, pe]

/-- Reassociation `((a,b),p) ↦ (a,(b,p))` from `EncodeG` to the right-associated
`ℤ × ℤ × Parity3` (the root statement's domain shape). -/
def assoc : EncodeG ≃+ (ℤ × ℤ × Parity3) where
  toFun := fun x => (x.1.1, (x.1.2, x.2))
  invFun := fun y => ((y.1, y.2.1), y.2.2)
  left_inv := by intro x; rfl
  right_inv := by intro y; rfl
  map_add' := by intro x y; ext <;> rfl

/-! ## A finite spanning set of `EncodeG` (the weak-expressibility library needs one) -/

/-- The parity vector `((0,0), encGen k)` in `EncodeG`. -/
def encVec (k : Fin 3) : EncodeG := (((0 : ℤ), (0 : ℤ)), encGen k)

/-- Five generators of `EncodeG = (ℤ×ℤ) × (ZMod 2)^3`. -/
def stdGens : Fin 5 → EncodeG
  | ⟨0, _⟩ => encX
  | ⟨1, _⟩ => encYdir
  | ⟨2, _⟩ => encVec 0
  | ⟨3, _⟩ => encVec 1
  | ⟨4, _⟩ => encVec 2
  | ⟨n + 5, h⟩ => False.elim (by omega)

/-- The parity-zero-slice point of the plane point `(i,j)` with zero parity. -/
def parityElem (p : Parity3) : EncodeG := (((0 : ℤ), (0 : ℤ)), p)

/-- `parityElem` as an additive embedding `Parity3 →+ EncodeG`. -/
def parityEmbed : Parity3 →+ EncodeG where
  toFun := parityElem
  map_zero' := rfl
  map_add' := by intro a b; ext <;> rfl

/-- Projection onto the plane part as an additive homomorphism. -/
def planeHom : EncodeG →+ ℤ × ℤ where
  toFun := fun x => x.1
  map_zero' := rfl
  map_add' := by intro x y; ext <;> rfl

lemma mem_closure_stdGens_encX : encX ∈ AddSubgroup.closure (Set.range stdGens) := by
  exact AddSubgroup.subset_closure ⟨⟨0, by norm_num⟩, by simp [stdGens]⟩

lemma mem_closure_stdGens_encY : encYdir ∈ AddSubgroup.closure (Set.range stdGens) := by
  exact AddSubgroup.subset_closure ⟨⟨1, by norm_num⟩, by simp [stdGens]⟩

lemma mem_closure_stdGens_encVec (k : Fin 3) : encVec k ∈ AddSubgroup.closure (Set.range stdGens) := by
  have hk : 2 + k.val < 5 := by omega
  have hstd : stdGens ⟨2 + k.val, hk⟩ = encVec k := by
    fin_cases k <;> simp [stdGens, encVec]
  exact AddSubgroup.subset_closure ⟨⟨2 + k.val, hk⟩, hstd⟩

/-- Every parity vector is a `ℤ`-combination of the three `encGen` basis vectors. -/
lemma parity_decomp (p : Parity3) :
    (∑ k : Fin 3, (((p k).val : ℤ) • encGen k)) = p := by
  funext j
  simp
  rw [Finset.sum_eq_single j]
  · rcases zmod2_eq_zero_or_one (p j) with hp0 | hp1
    · rw [hp0]; simp [encGen]
    · rw [hp1]; simp [encGen]
  · intro b hb hbj
    have hbj' : ¬ j = b := fun hj => hbj hj.symm
    have he : encGen b j = (0 : ZMod 2) := by simp [encGen, hbj']
    rw [he]
    simp
  · intro hj
    exact False.elim (hj (Finset.mem_univ j))

/-- `parityElem p` is the same combination of the `encVec k`. -/
lemma parityElem_decomp (p : Parity3) :
    parityElem p = ∑ k : Fin 3, (((p k).val : ℤ) • encVec k) := by
  calc
    parityElem p = parityElem (∑ k : Fin 3, (((p k).val : ℤ) • encGen k)) := by rw [parity_decomp p]
    _ = ∑ k : Fin 3, parityElem (((p k).val : ℤ) • encGen k) := by
      change parityEmbed (∑ k : Fin 3, (((p k).val : ℤ) • encGen k)) = ∑ k : Fin 3, parityElem (((p k).val : ℤ) • encGen k)
      rw [map_sum parityEmbed]
      refine Finset.sum_congr rfl ?_
      intro x hx
      rfl
    _ = ∑ k : Fin 3, (((p k).val : ℤ) • encVec k) := by
      refine Finset.sum_congr rfl ?_
      intro x hx
      rfl

/-- Every element of `EncodeG` splits as plane part plus parity part. -/
lemma encodeG_decomp (x : EncodeG) :
    x = (x.1.1 : ℤ) • encX + (x.1.2 : ℤ) • encYdir + parityElem (x.2) := by
  ext
  · simp [encX, encYdir, parityElem]
  · simp [encX, encYdir, parityElem]
  · simp [encX, encYdir, parityElem]

/-- Integer multiples of a closure member are closure members. -/
lemma zsmul_mem_closure {x : EncodeG} (hx : x ∈ AddSubgroup.closure (Set.range stdGens)) (z : ℤ) :
    z • x ∈ AddSubgroup.closure (Set.range stdGens) := by
  exact (AddSubgroup.closure (Set.range stdGens)).zsmul_mem hx z

/-- Every element of `EncodeG` lies in the closure of `stdGens`. -/
lemma encodeG_mem_closure (x : EncodeG) : x ∈ AddSubgroup.closure (Set.range stdGens) := by
  rw [encodeG_decomp x]
  apply AddSubgroup.add_mem
  · apply AddSubgroup.add_mem
    · exact zsmul_mem_closure mem_closure_stdGens_encX (x.1.1)
    · exact zsmul_mem_closure mem_closure_stdGens_encY (x.1.2)
  · rw [parityElem_decomp (x.2)]
    apply AddSubgroup.sum_mem
    intro k hk
    exact zsmul_mem_closure (mem_closure_stdGens_encVec k) (x.2 k).val

/-- `stdGens` spans `EncodeG`. -/
lemma stdGens_span : FiniteSpanningSet stdGens := by
  rw [FiniteSpanningSet]
  apply le_antisymm
  · exact le_top
  · intro x hx
    exact encodeG_mem_closure x

/-! ## Splitting a tuple into its first `K` coordinates and the rest -/

/-- The first `K` coordinates of a `Fin (K+M)`-tuple. -/
def takeCoord {K M : ℕ} {H : Type} (t : Fin (K + M) → H) : Fin K → H :=
  fun w => t (Fin.castAdd M w)

/-- The last `M` coordinates of a `Fin (K+M)`-tuple. -/
def dropCoord {K M : ℕ} {H : Type} (t : Fin (K + M) → H) : Fin M → H :=
  fun w => t (Fin.natAdd K w)

/-- Appending the take/drop split recovers the tuple. -/
lemma append_take_drop {K M : ℕ} {H : Type} (t : Fin (K + M) → H) :
    Fin.append (takeCoord t) (dropCoord t) = t := by
  funext j
  refine Fin.addCases (motive := fun j : Fin (K + M) =>
      Fin.append (takeCoord t) (dropCoord t) j = t j) ?_ ?_ j
  · intro w
    simp [takeCoord]
  · intro w
    simp [dropCoord]

/-! ## The raw functional-system data over `EncodeG` (satisfiable + aperiodic) -/

/-- From the aperiodic weakly-expressible encode property we obtain the root-shaped
data over `EncodeG`: a functional system whose tiles are non-empty, which is solvable,
and all of whose solutions are aperiodic (no finite-index subgroup period). -/
theorem encodePropSFull_root_data :
    ∃ (H : Type) (_ : AddCommGroup H) (_ : Finite H),
    ∃ (M : ℕ) (J : Fin M → ℕ)
      (h : (i : Fin M) → Fin (J i) → EncodeG)
      (E : (i : Fin M) → Fin (J i) → Set H),
      (∀ i j, (E i j).Nonempty) ∧
      (∃ α : EncodeG → H, ∀ i x y, ∃! j : Fin (J i), y ∈ α (x + h i j) + E i j) ∧
      ∀ α : EncodeG → H,
        (∀ i x y, ∃! j : Fin (J i), y ∈ α (x + h i j) + E i j) →
        ¬ ∃ L : AddSubgroup EncodeG, L.FiniteIndex ∧
          ∀ x : EncodeG, ∀ g : EncodeG, g ∈ L → α (x + g) = α x := by
  classical
  let s0 : ℕ := ps0
  let N : ℕ := pN
  let e : ℕ := pe
  let K : ℕ := BoardW s0 N
  let H0 : Type := ZMod (2 ^ (e + 1))
  have hW : WeakExpressible K (encodePropSFull (e := e) (s0 := s0) (N := N)) := by
    dsimp [K, s0, N, e]
    exact encodePropSFull_weakExpressible (d := 5) (e := pe) pe_h1 ps0_h1 pN_h1 stdGens
      (by norm_num) stdGens_span hbig_ok
  rcases hW with ⟨M₀, Pstar, hPstar_exp, hiffP⟩
  rcases hPstar_exp with ⟨S, hES, hiffS⟩
  let H : Type := Fin (K + M₀) → H0
  refine ⟨H, inferInstance, inferInstance, S.M, S.J, S.h, S.E, ?_, ?_, ?_⟩
  · exact hES
  · -- solvability: extend the standard solution by the witness coordinates
    have hsat : ∃ alpha : EncodeG → (Fin K → H0), encodePropSFull (e := e) (s0 := s0) (N := N) alpha := by
      dsimp [K, s0, N, e]
      exact encodePropSFull_satisfiable (e := pe) (s0 := ps0) (N := pN) ps0_h1
    rcases hsat with ⟨alpha0, hP0⟩
    have hwit := (hiffP alpha0).mp hP0
    rcases hwit with ⟨alpha1, hPstar_ap⟩
    let sol : EncodeG → H := fun x => Fin.append (alpha0 x) (alpha1 x)
    refine ⟨sol, ?_⟩
    intro i x y
    -- sol solves S: from Pstar (sol) and expressibility
    have hsolS : Solves S sol := by
      have hstar : Pstar sol := by
        -- sol = fun x => append (alpha0 x) (alpha1 x) definitionally
        simpa [sol] using hPstar_ap
      exact (hiffS sol).mp hstar
    exact hsolS i x y
  · -- aperiodicity: restrict a solution of S to the first K coordinates and apply
    -- `encodePropSFull_aperiodic`
    intro alpha halpha
    rintro ⟨L, hLfin, hper⟩
    -- alpha is a solution of S: Pstar alpha
    have hstar : Pstar alpha := (hiffS alpha).mpr halpha
    -- restrict to the first K coordinates (H is a Fin (K+M₀)-tuple)
    let restr : EncodeG → (Fin K → H0) := fun x => takeCoord (alpha x)
    -- the restriction obeys encodePropSFull
    have hrestrP : encodePropSFull (e := e) (s0 := s0) (N := N) restr := by
      -- alpha = append (takeCoord ∘ alpha) (dropCoord ∘ alpha); Pstar(alpha) and weak-expressibility
      have hsplit : alpha = fun x : EncodeG => Fin.append (takeCoord (alpha x)) (dropCoord (alpha x)) := by
        funext x
        exact (append_take_drop (alpha x)).symm
      have hPstar_split : Pstar (fun x : EncodeG => Fin.append (takeCoord (alpha x)) (dropCoord (alpha x))) := by
        convert hstar using 1
        exact hsplit.symm
      have hP' := (hiffP restr).mpr (by
        refine ⟨fun x : EncodeG => dropCoord (alpha x), ?_⟩
        change Pstar (fun x : EncodeG => Fin.append (takeCoord (alpha x)) (dropCoord (alpha x)))
        exact hPstar_split)
      exact hP'
    -- alpha is L-periodic, so restr is L-periodic in every coordinate
    have hrestrPer : ∀ x : EncodeG, ∀ g : EncodeG, g ∈ L →
        ∀ w : Fin (BoardW s0 (2 ^ s0 * 2 ^ s0)), restr (x + g) w = restr x w := by
      intro x g hg w
      have hα := hper x g hg
      change alpha (x + g) (Fin.castAdd M₀ w) = alpha x (Fin.castAdd M₀ w)
      exact congrFun hα (Fin.castAdd M₀ w)
    have haper := encodePropSFull_aperiodic (e := e) (s0 := s0) ps0_h24 (alpha := restr) hrestrP
    exact haper ⟨L, hLfin, hrestrPer⟩

/-! ## The root theorem -/

/--
ROOT GOAL of the whole `ℤ² × finite` counterexample pipeline (Greenfeld--Tao,
arXiv:2211.15847): construction of an *aperiodic functional system*.
-/
theorem existence_aperiodic_functional_system_core_full :
    ∃ (G₁ : Type) (_ : AddCommGroup G₁) (_ : Finite G₁),
    ∃ (H : Type) (_ : AddCommGroup H) (_ : Finite H),
    ∃ (M : ℕ) (J : Fin M → ℕ)
      (h : (i : Fin M) → Fin (J i) → (ℤ × ℤ × G₁))
      (E : (i : Fin M) → Fin (J i) → Set H),
      (∀ i j, (E i j).Nonempty) ∧
      (∃ α : (ℤ × ℤ × G₁) → H,
        ∀ i x y, ∃! j : Fin (J i), y ∈ α (x + h i j) + E i j) ∧
      ∀ α : (ℤ × ℤ × G₁) → H,
        (∀ i x y, ∃! j : Fin (J i), y ∈ α (x + h i j) + E i j) →
        ¬ ∃ L : AddSubgroup (ℤ × ℤ × G₁), L.FiniteIndex ∧
          ∀ x : (ℤ × ℤ × G₁), ∀ g : (ℤ × ℤ × G₁), g ∈ L → α (x + g) = α x := by
  classical
  obtain ⟨H, hGrpH, hFinH, M, J, hG, E, hEn, hSolG, hAperG⟩ := encodePropSFull_root_data
  let D : Type := ℤ × ℤ × Parity3
  refine ⟨Parity3, inferInstance, inferInstance, H, hGrpH, hFinH, M, J, ?_, E, ?_⟩
  · -- h over the right-associated domain
    exact fun i j => assoc (hG i j)
  · constructor
    · exact hEn
    · constructor
      · -- solvability transports from EncodeG to D
        have hEQ := FunctionalSystem.solve_transport_equiv (G := EncodeG) (D := D) assoc M J hG E
        exact hEQ.mp hSolG
      · -- aperiodicity transports from EncodeG to D
        intro beta hbeta
        rintro ⟨L', hLfin', hper'⟩
        let alpha : EncodeG → H := fun x => beta (assoc x)
        have hαsol : ∀ (i : Fin M) (x : EncodeG) (y : H),
            ∃! j : Fin (J i), y ∈ alpha (x + hG i j) + E i j := by
          simpa [alpha] using
            (FunctionalSystem.solve_pointwise_transport (G := EncodeG) (D := D) assoc M J hG E beta hbeta)
        let L : AddSubgroup EncodeG := AddSubgroup.comap assoc.toAddMonoidHom L'
        have hLfin : L.FiniteIndex := Commons.GroupTheory.finiteIndex_comap_equiv assoc L' hLfin'
        have hLin : ∀ x : EncodeG, ∀ g : EncodeG, g ∈ L → alpha (x + g) = alpha x := by
          intro x g hg
          have hg' : assoc g ∈ L' := (AddSubgroup.mem_comap).mp hg
          calc
            alpha (x + g) = beta (assoc (x + g)) := rfl
            _ = beta (assoc x + assoc g) := by rw [map_add assoc]
            _ = beta (assoc x) := hper' (assoc x) (assoc g) hg'
            _ = alpha x := rfl
        exact hAperG alpha hαsol ⟨L, hLfin, hLin⟩

end
end Commons.PeriodicTiling