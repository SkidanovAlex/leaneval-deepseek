/-!
# The Sudoku framework of Greenfeld--Tao (arXiv:2211.15847)

Formal scaffolding for the ``2-adically structured'' functions used in the proof of
`existence_aperiodic_functional_system_core_full`.  This file contains the last-nonzero-digit
function `fq`, the class `InScal_q` of rescaled restrictions of `fq`, and the basic
notions of Sudoku solution and good columns.
-/

/-- If `q` does not divide `n`, removing all factors of `q` from `n` does nothing. -/
lemma Nat.divMaxPow_eq_self_of_not_dvd {p n : ℕ} (h : ¬ p ∣ n) : n.divMaxPow p = n := by
  unfold Nat.divMaxPow
  rw [Nat.maxPowDvdDiv_of_not_dvd (p := p) (n := n) h]

/-- The last nonzero digit function `f_q` on a natural number `n`:
the unit part of `n` after removing all factors of `q`, with the convention `f_q(0) = 1`.
-/
def fqOnNat (q n : ℕ) : ZMod q :=
  if n = 0 then 1 else ((Nat.divMaxPow n q : ℕ) : ZMod q)

/-- The last nonzero digit function `f_q : ℤ → ZMod q` (additively, the final nonzero digit of
`n` in base `q`, with `f_q(0) = 1`). -/
def fq (q : ℕ) (n : ℤ) : ZMod q :=
  if _h : 0 ≤ n then fqOnNat q n.toNat else -(fqOnNat q (-n).toNat)

@[simp] lemma fq_zero (q : ℕ) : fq q 0 = 1 := by
  simp [fq, fqOnNat]

lemma fqOnNat_zero (q : ℕ) : fqOnNat q 0 = 1 := by
  simp [fqOnNat]

lemma fq_natCast {q : ℕ} (n : ℕ) : fq q (n : ℤ) = fqOnNat q n := by
  simp [fq]

/-- `f_q` is invariant under multiplication of the argument by `q`. -/
lemma fqOnNat_mul_q {q : ℕ} (hq : q ≠ 0) (n : ℕ) :
    fqOnNat q (q * n) = fqOnNat q n := by
  unfold fqOnNat
  by_cases hn : n = 0
  · subst hn
    simp
  · have hqn : q * n ≠ 0 := mul_ne_zero hq hn
    simp [hn, hqn, Nat.divMaxPow_base_mul hq]

lemma fq_mul_q {q : ℕ} (hq : q ≠ 0) (n : ℕ) :
    fq q ((q : ℤ) * (n : ℤ)) = fq q (n : ℤ) := by
  rw [show ((q : ℤ) * (n : ℤ)) = ((q * n : ℕ) : ℤ) by norm_num]
  rw [fq_natCast, fq_natCast]
  exact fqOnNat_mul_q hq n

/-- On natural numbers not divisible by `q`, `f_q` agrees with the reduction modulo `q`. -/
lemma fq_eq_self_of_not_dvd {q : ℕ} {n : ℕ} (hn : ¬ (q : ℕ) ∣ n) :
    fq q (n : ℤ) = (n : ZMod q) := by
  have hn0 : n ≠ 0 := by
    intro hn0
    subst hn0
    exact hn (Nat.dvd_zero q)
  simp [fq_natCast, fqOnNat, hn0, Nat.divMaxPow_eq_self_of_not_dvd hn]

/-- `f_q` never vanishes on nonzero natural numbers (so its values lie in the digit set
`Σ = ZMod q \ {0}`). -/
lemma fqOnNat_ne_zero_of_lt {q n : ℕ} (hq : 1 < q) (hn : n ≠ 0) :
    fqOnNat q n ≠ 0 := by
  intro hz
  unfold fqOnNat at hz
  simp [hn] at hz
  have hdvd : ¬ (q : ℕ) ∣ Nat.divMaxPow n q := Nat.not_dvd_divMaxPow hq hn
  exact hdvd ((ZMod.natCast_eq_zero_iff (Nat.divMaxPow n q) q).mp hz)

lemma one_ne_zero_zmod_of_one_lt {q : ℕ} (hq : 1 < q) : (1 : ZMod q) ≠ 0 := by
  intro hz
  rw [← Nat.cast_one] at hz
  have hdvd : (q : ℕ) ∣ 1 := (CharP.cast_eq_zero_iff (ZMod q) q 1).mp hz
  have hle : q ≤ 1 := Nat.le_of_dvd (by norm_num) hdvd
  omega

/-- `f_q` never vanishes on any integer (so its values lie in the digit set). -/
lemma fq_ne_zero {q : ℕ} (hq : 1 < q) (n : ℤ) : fq q n ≠ 0 := by
  by_cases hn : 0 ≤ n
  · have hn' : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn
    rw [← hn']
    rw [fq_natCast]
    by_cases hzero : n.toNat = 0
    · rw [hzero, fqOnNat]
      exact one_ne_zero_zmod_of_one_lt hq
    · exact fqOnNat_ne_zero_of_lt hq hzero
  · have hnlt : n < 0 := lt_of_not_ge hn
    have hneg : (-n).toNat ≠ 0 := by
      intro hz
      have hle : -n ≤ 0 := (Int.toNat_eq_zero).mp hz
      omega
    have hval : fq q n = -(fqOnNat q (-n).toNat) := by
      simp [fq, hn]
    rw [hval]
    exact neg_ne_zero.mpr (fqOnNat_ne_zero_of_lt hq hneg)

/-- If `q` does not divide `m`, then `f_q(m) = m mod q`. -/
lemma fqOnNat_eq_self_of_not_dvd {q m : ℕ} (h : ¬ q ∣ m) : fqOnNat q m = (m : ZMod q) := by
  by_cases hm : m = 0
  · subst m; exact (h (Nat.dvd_zero q)).elim
  · unfold fqOnNat; simp [hm, Nat.divMaxPow_eq_self_of_not_dvd h]
/-- Multiplicativity of `f_q` on natural numbers: for `a` coprime to `q` (a unit modulo `q`),
`f_q(a·n) = a·f_q(n)` for every nonzero `n`. -/
lemma fqOnNat_unit_mul {q : ℕ} (hq : 1 < q) :
    ∀ n : ℕ, ∀ a : ℕ, Nat.Coprime a q → n ≠ 0 →
      fqOnNat q (a * n) = (a : ZMod q) * fqOnNat q n := by
  intro n
  refine Nat.strong_induction_on n ?_
  intro n ih a ha hn
  by_cases hdiv : q ∣ n
  · rcases hdiv with ⟨n1, hn_eq⟩
    subst n
    have hq0 : q ≠ 0 := by omega
    have hn1 : n1 ≠ 0 := by intro hz; subst n1; simp at hn
    have hsmall : n1 < q * n1 := by
      have hn1pos : 0 < n1 := Nat.pos_of_ne_zero hn1
      have hqge2 : 2 ≤ q := by omega
      nlinarith
    calc
      fqOnNat q (a * (q * n1)) = fqOnNat q (q * (a * n1)) := by ring_nf
      _ = fqOnNat q (a * n1) := fqOnNat_mul_q hq0 _
      _ = (a : ZMod q) * fqOnNat q n1 := ih n1 hsmall a ha hn1
      _ = (a : ZMod q) * fqOnNat q (q * n1) := by rw [fqOnNat_mul_q hq0]
  · have hnot_amul : ¬ q ∣ a * n := by
      intro hqdiv
      have hqa : q.Coprime a := ha.symm
      exact hdiv (Nat.Coprime.dvd_of_dvd_mul_right hqa (by simpa [Nat.mul_comm] using hqdiv))
    rw [fqOnNat_eq_self_of_not_dvd hnot_amul, fqOnNat_eq_self_of_not_dvd hdiv]
    norm_num

/-- For nonzero `n`, `f_q(-n) = -f_q(n)`. -/
lemma fq_neg_mul {q : ℕ} (n : ℤ) (hn : n ≠ 0) : fq q (-n) = - fq q n := by
  by_cases hnneg : n < 0
  · have hpos : 0 ≤ -n := by omega
    rw [fq, fq]
    rw [dif_pos hpos]
    rw [dif_neg (not_le.mpr hnneg)]
    simp
  · have hnpos : 0 < n := lt_of_le_of_ne (le_of_not_gt hnneg) (Ne.symm hn)
    have hnnpos : 0 ≤ n := le_of_lt hnpos
    have hneg : ¬ 0 ≤ -n := by omega
    rw [fq, fq]
    rw [dif_pos hnnpos]
    rw [dif_neg hneg]
    simp

/-- Multiplicativity of `f_q` on `ℤ` by a natural coefficient coprime to `q`. -/
lemma fq_mul_nat_coeff {q : ℕ} (hq : 1 < q) (A : ℕ) (n : ℤ)
    (hA : Nat.Coprime A q) (hn : n ≠ 0) :
    fq q ((A : ℤ) * n) = (A : ZMod q) * fq q n := by
  by_cases hn0 : 0 ≤ n
  · have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn0
    have hNnz : n.toNat ≠ 0 := by
      intro hz
      have hn0' : n = 0 := by
        apply_fun (fun k : ℕ => (k : ℤ)) at hz
        rwa [hcast] at hz
      exact hn hn0'
    rw [← hcast]
    rw [show ((A : ℤ) * (n.toNat : ℤ)) = (((A * n.toNat : ℕ) : ℤ)) by norm_num]
    rw [fq_natCast, fq_natCast]
    exact fqOnNat_unit_mul hq n.toNat A hA hNnz
  · have hnneg : n < 0 := lt_of_not_ge hn0
    let N : ℕ := (-n).toNat
    have hNcast : (N : ℤ) = -n := by
      dsimp [N]
      exact Int.toNat_of_nonneg (by omega)
    have hNnz : N ≠ 0 := by
      dsimp [N]
      intro hz
      have hcast := Int.toNat_of_nonneg (by omega : 0 ≤ -n)
      apply_fun (fun k : ℕ => (k : ℤ)) at hz
      rw [hcast] at hz
      omega
    have hn_eq : n = - (N : ℤ) := by omega
    have hAne : A ≠ 0 := by
      intro hz
      subst hz
      have hqeq : q = 1 := (Nat.coprime_zero_left q).mp hA
      omega
    have hNcast' : (N : ℤ) ≠ 0 := by exact_mod_cast hNnz
    have hANnz : (A : ℤ) * (N : ℤ) ≠ 0 := by
      exact mul_ne_zero (by exact_mod_cast hAne) hNcast'
    rw [hn_eq]
    rw [mul_neg]
    rw [fq_neg_mul ((A : ℤ) * (N : ℤ)) hANnz]
    rw [fq_neg_mul (N : ℤ) hNcast']
    have hmain := fqOnNat_unit_mul hq N A hA hNnz
    -- goal now: -fq ((A:ℤ)*(N:ℤ)) = (A:ZMod q) * (- fq (N:ℤ))
    -- rewrite fq of nat casts and use hmain
    rw [show ((A : ℤ) * (N : ℤ)) = (((A * N : ℕ) : ℤ)) by norm_num]
    rw [show (N : ℤ) = (((N : ℕ) : ℤ)) by norm_num]
    rw [fq_natCast, fq_natCast]
    -- goal: - fqOnNat (A*N) = (A:ZMod q) * - fqOnNat N
    rw [hmain]
    ring

/-- Multiplicativity of `f_q` on `ℤ`: if `a` is coprime to `q` (a unit modulo `q`) and
`n ≠ 0`, then `f_q(a·n) = a·f_q(n)`. -/
lemma fq_mul_coprime {q : ℕ} (hq : 1 < q) (a n : ℤ)
    (ha : Nat.Coprime a.natAbs q) (hn : n ≠ 0) :
    fq q (a * n) = (a : ZMod q) * fq q n := by
  by_cases ha0 : 0 ≤ a
  · let A : ℕ := a.toNat
    have hAcast : (A : ℤ) = a := by dsimp [A]; exact Int.toNat_of_nonneg ha0
    have hAC : Nat.Coprime A q := by
      dsimp [A]
      have h1 : (a.natAbs : ℤ) = a := Int.natAbs_of_nonneg ha0
      have h2 : (a.toNat : ℤ) = a := Int.toNat_of_nonneg ha0
      have hAbs : a.natAbs = a.toNat := by exact_mod_cast (h1.trans h2.symm)
      simpa [hAbs] using ha
    rw [← hAcast]
    simpa using (fq_mul_nat_coeff hq A n hAC hn)
  · let A : ℕ := (-a).toNat
    have hApos0 : 0 ≤ -a := by omega
    have hAcast : (A : ℤ) = -a := by dsimp [A]; exact Int.toNat_of_nonneg hApos0
    have hAC : Nat.Coprime A q := by
      dsimp [A]
      have h2 : ((-a).natAbs : ℤ) = -a := Int.natAbs_of_nonneg hApos0
      have hcast' : ((-a).toNat : ℤ) = -a := Int.toNat_of_nonneg hApos0
      have hEq : (a.natAbs : ℤ) = ((-a).toNat : ℤ) := by
        rw [← Int.natAbs_neg a]
        rw [h2, hcast']
      have hAbs : a.natAbs = (-a).toNat := by exact_mod_cast hEq
      simpa [hAbs] using ha
    have ha_eq : a = - (A : ℤ) := by
      have hcast : (A : ℤ) = -a := hAcast
      omega
    have hAne : A ≠ 0 := by
      intro hz
      have hA0 : A = 0 := hz
      rw [hA0] at hAC
      have hqeq : q = 1 := (Nat.coprime_zero_left q).mp hAC
      omega
    have hAnz : (A : ℤ) ≠ 0 := by exact_mod_cast hAne
    have hANnz : (A : ℤ) * n ≠ 0 := mul_ne_zero hAnz hn
    rw [ha_eq]
    rw [neg_mul]
    rw [fq_neg_mul ((A : ℤ) * n) hANnz]
    have hmain := fq_mul_nat_coeff hq A n hAC hn
    rw [hmain]
    simp


/-- Multiplicativity of `f_q` for odd multipliers when `q` is a power of two
(the setting of the Greenfeld--Tao Sudoku, where `q = 2^{s_0}`). -/
lemma fq_mul_odd {q : ℕ} (hq : 1 < q) (a n : ℤ)
    (ha : Odd a) (hqpow : ∃ s : ℕ, q = 2 ^ (s + 1)) (hn : n ≠ 0) :
    fq q (a * n) = (a : ZMod q) * fq q n := by
  rcases hqpow with ⟨t, hqeq⟩
  have htpos : 0 < t + 1 := by omega
  have hc2 : a.natAbs.Coprime 2 := (Nat.coprime_two_right).mpr (Int.natAbs_odd.mpr ha)
  have hcq : a.natAbs.Coprime (2 ^ (t + 1)) :=
    (Nat.coprime_pow_right_iff htpos a.natAbs 2).mpr hc2
  rw [← hqeq] at hcq
  exact fq_mul_coprime hq a n hcq hn


/-- `f_q` is invariant under multiplication of the argument by `q` on all integers. -/
lemma fq_qmul_int {q : ℕ} (hq : q ≠ 0) (n : ℤ) : fq q ((q : ℤ) * n) = fq q n := by
  by_cases hn : 0 ≤ n
  · have hcast : (n.toNat : ℤ) = n := Int.toNat_of_nonneg hn
    rw [← hcast]
    rw [show ((q : ℤ) * (n.toNat : ℤ)) = (((q * n.toNat : ℕ) : ℤ)) by norm_num]
    rw [fq_natCast, fq_natCast]
    exact fqOnNat_mul_q hq n.toNat
  · have hnlt : n < 0 := lt_of_not_ge hn
    let N : ℕ := (-n).toNat
    have hNcast : (N : ℤ) = -n := by
      dsimp [N]
      exact Int.toNat_of_nonneg (by omega)
    have hNnz : N ≠ 0 := by
      dsimp [N]
      intro hz
      have hcast := Int.toNat_of_nonneg (by omega : 0 ≤ -n)
      apply_fun (fun k : ℕ => (k : ℤ)) at hz
      rw [hcast] at hz
      omega
    have hn_eq : n = - (N : ℤ) := by omega
    have hNcast' : (N : ℤ) ≠ 0 := by exact_mod_cast hNnz
    have hqZ : (q : ℤ) ≠ 0 := by exact_mod_cast hq
    have hqNnz : (q : ℤ) * (N : ℤ) ≠ 0 := mul_ne_zero hqZ hNcast'
    have hstep : fq q ((q : ℤ) * (N : ℤ)) = fq q (N : ℤ) := by
      rw [show ((q : ℤ) * (N : ℤ)) = (((q * N : ℕ) : ℤ)) by norm_num]
      rw [fq_natCast, fq_natCast]
      exact fqOnNat_mul_q hq N
    rw [hn_eq]
    rw [mul_neg]
    rw [fq_neg_mul ((q : ℤ) * (N : ℤ)) hqNnz]
    rw [fq_neg_mul (N : ℤ) hNcast']
    rw [hstep]




/-- On integers not divisible by `q`, `f_q` agrees with the reduction modulo `q`. -/
lemma fq_eq_self_of_not_dvd_int {q : ℕ} (_hq : 1 < q) {n : ℤ} (hn : ¬ (q : ℤ) ∣ n) :
    fq q n = (n : ZMod q) := by
  by_cases hn0 : 0 ≤ n
  · have hnat : ¬ q ∣ n.toNat := by
      intro hd
      apply hn
      rw [← Int.toNat_of_nonneg hn0]
      exact (Int.natCast_dvd_natCast).mpr hd
    have hfNat := fq_eq_self_of_not_dvd (q := q) (n := n.toNat) hnat
    rw [fq_natCast] at hfNat
    unfold fq
    rw [dif_pos hn0]
    rw [← Int.toNat_of_nonneg hn0]
    rw [Int.cast_natCast]
    exact hfNat
  · have hnneg : n < 0 := lt_of_not_ge hn0
    let N : ℕ := (-n).toNat
    have hNcast : (N : ℤ) = -n := by
      dsimp [N]
      exact Int.toNat_of_nonneg (by omega)
    have hNnz : N ≠ 0 := by
      dsimp [N]
      intro hz
      have hcast := Int.toNat_of_nonneg (by omega : 0 ≤ -n)
      apply_fun (fun k : ℕ => (k : ℤ)) at hz
      rw [hcast] at hz
      omega
    have hn_eq : n = - (N : ℤ) := by omega
    have hNatNotDvd : ¬ q ∣ N := by
      intro hd
      apply hn
      have hdZ : (q : ℤ) ∣ (N : ℤ) := (Int.natCast_dvd_natCast).mpr hd
      rw [hn_eq]
      exact dvd_neg.mpr hdZ
    have hfNatZ : fq q (N : ℤ) = (N : ZMod q) := by
      have hf := fq_eq_self_of_not_dvd (q := q) (n := N) hNatNotDvd
      simpa [fq_natCast] using hf
    have hNcast' : (N : ℤ) ≠ 0 := by exact_mod_cast hNnz
    rw [hn_eq]
    rw [fq_neg_mul (N : ℤ) hNcast']
    rw [hfNatZ]
    simp


/-- A digit is an element of `ZMod q` that is not zero. -/
abbrev Digit (q : ℕ) := {x : ZMod q // x ≠ 0}

/-- The Sudoku board of width `N`: rows indexed by `Fin N` and columns by `ℤ`. -/
abbrev SudokuBoard (q N : ℕ) := Fin N → ℤ → ZMod q

/-- Restriction of a Sudoku board function to the non-vertical line of slope `j` and
intercept `i`: `n ↦ F(n, jn + i)`. -/
def lineRestrict {q N : ℕ} (F : SudokuBoard q N) (i j : ℤ) : Fin N → ZMod q :=
  fun n => F n (j * ((n.val : ℕ) + 1 : ℤ) + i)

/-- A function `g : Fin N → ZMod q` belongs to the class `Scal_q[N]` of
2-adically structured functions if it is a rescaled restriction of `f_q` to an affine
line: `g(n) = c · f_q(a·n + b)` for some integers `a,b` and an odd (unit) multiplier `c`. -/
def InScal_q (q N : ℕ) (g : Fin N → ZMod q) : Prop :=
  ∃ a b c : ℤ, Odd c ∧ ∀ n : Fin N,
    g n = (c : ZMod q) * fq q (a * ((n.val : ℕ) + 1 : ℤ) + b)

/-- A Sudoku solution of width `N` and base `q`: every cell is a digit and the restriction
of the function to every non-vertical line belongs to `Scal_q[N]`. -/
def IsSudokuSolution (q N : ℕ) (F : SudokuBoard q N) : Prop :=
  (∀ n m, F n m ≠ 0) ∧
  ∀ i j : ℤ, InScal_q q N (lineRestrict F i j)

/-- A Sudoku solution has *good columns* if along each column the values agree, away from
the vanishing points of a permutation, with that permutation of `ZMod q` applied to `m mod q`. -/
def HasGoodColumns (q N : ℕ) (F : SudokuBoard q N) : Prop :=
  ∀ n : Fin N, ∃ σ : ZMod q ≃ ZMod q, ∀ m : ℤ,
    σ (m : ZMod q) ≠ 0 → F n m = σ (m : ZMod q)

/-- The standard Sudoku solution `F(n,m) = f_q(m)` has width `N` (independent of `n`). -/
def standardSudoku (q N : ℕ) : SudokuBoard q N :=
  fun _ m => fq q m

/-- The restriction of the standard solution to any non-vertical line lies in `Scal_q[N]`. -/
lemma standardSudoku_line_mem {q N : ℕ} (i j : ℤ) :
    InScal_q q N (lineRestrict (standardSudoku q N) i j) := by
  refine ⟨j, i, 1, by norm_num, ?_⟩
  intro n
  simp [lineRestrict, standardSudoku]

/-- The standard solution is a genuine Sudoku solution (every cell is a digit and every
non-vertical line lies in `Scal_q[N]`). -/
lemma standardSudoku_is_sudoku {q N : ℕ} (hq : 1 < q) :
    IsSudokuSolution q N (standardSudoku q N) := by
  constructor
  · intro n m
    exact fq_ne_zero hq m
  · intro i j
    exact standardSudoku_line_mem (q := q) (N := N) i j


lemma not_dvd_int_one_of_three_le {q : ℕ} (hq : 3 ≤ q) : ¬ (q : ℤ) ∣ (1 : ℤ) := by
  intro h
  have hnat : q ∣ 1 := (Int.natCast_dvd_natCast).mp h
  have hle : q ≤ 1 := Nat.le_of_dvd (by norm_num) hnat
  omega

lemma not_dvd_int_two_of_three_le {q : ℕ} (hq : 3 ≤ q) : ¬ (q : ℤ) ∣ (2 : ℤ) := by
  intro h
  have hnat : q ∣ 2 := (Int.natCast_dvd_natCast).mp h
  have hle : q ≤ 2 := Nat.le_of_dvd (by norm_num) hnat
  omega


def IsPeriod {A : Type} (f : ℤ → A) (m : ℤ) : Prop := ∀ n : ℤ, f (n + m) = f n

lemma unit_period_contra {q : ℕ} (hq : 3 ≤ q) (f : ℤ → ZMod q)
    (hf_not_dvd : ∀ n : ℤ, ¬ (q : ℤ) ∣ n → f n = (n : ZMod q))
    {m : ℤ} (hper : IsPeriod f m) (hunit : ¬ (q : ℤ) ∣ m) : False := by
  have hmz : (m : ZMod q) ≠ 0 := by
    intro hm0
    exact hunit ((ZMod.intCast_zmod_eq_zero_iff_dvd m q).mp hm0)
  by_cases hq1 : (q : ℤ) ∣ (1 + m)
  · -- choose r = 2
    have hnot2 : ¬ (q : ℤ) ∣ (2 : ℤ) := not_dvd_int_two_of_three_le hq
    have hnotsum : ¬ (q : ℤ) ∣ (2 + m) := by
      intro hd
      have hdsub : (q : ℤ) ∣ ((2 + m) - (1 + m)) := dvd_sub hd hq1
      have hdiff : (2 + m) - (1 + m) = (1 : ℤ) := by ring
      have hd1 : (q : ℤ) ∣ (1 : ℤ) := by simpa [hdiff] using hdsub
      exact not_dvd_int_one_of_three_le hq hd1
    have heq : f (2 + m) ≠ f 2 := by
      intro h
      have hf2 := hf_not_dvd 2 hnot2
      have hfsum := hf_not_dvd (2 + m) hnotsum
      rw [hf2] at h
      rw [hfsum] at h
      have hz2 : (2 : ZMod q) + (m : ZMod q) = (2 : ZMod q) := by
        rw [Int.cast_add] at h
        norm_num at h
        simpa using h
      have hz2' : (2 : ZMod q) + (m : ZMod q) = (2 : ZMod q) + 0 := by simpa using hz2
      have hm0 : (m : ZMod q) = 0 := add_left_cancel hz2'
      exact hmz hm0
    exact heq (hper 2)
  · -- choose r = 1
    have hnot1 : ¬ (q : ℤ) ∣ (1 : ℤ) := not_dvd_int_one_of_three_le hq
    have heq : f (1 + m) ≠ f 1 := by
      intro h
      have hf1 := hf_not_dvd 1 hnot1
      have hfsum := hf_not_dvd (1 + m) hq1
      rw [hf1] at h
      rw [hfsum] at h
      have hz1 : (1 : ZMod q) + (m : ZMod q) = (1 : ZMod q) := by
        rw [Int.cast_add] at h
        norm_num at h
        simpa using h
      have hz1' : (1 : ZMod q) + (m : ZMod q) = (1 : ZMod q) + 0 := by simpa using hz1
      have hm0 : (m : ZMod q) = 0 := add_left_cancel hz1'
      exact hmz hm0
    exact heq (hper 1)


lemma period_div_of_qmul {q : ℕ} (f : ℤ → ZMod q)
    (hf_qmul : ∀ n : ℤ, f ((q : ℤ) * n) = f n)
    {m m' : ℤ} (hm : m = (q : ℤ) * m') (hper : IsPeriod f m) :
    IsPeriod f m' := by
  intro n
  have h1 := hper ((q : ℤ) * n)
  rw [hm] at h1
  have hsum : (q : ℤ) * n + (q : ℤ) * m' = (q : ℤ) * (n + m') := by ring
  rw [hsum] at h1
  rw [hf_qmul (n + m')] at h1
  rw [hf_qmul n] at h1
  exact h1

theorem lastNonzeroDigit_no_period (q : ℕ) (hq : 3 ≤ q) (f : ℤ → ZMod q)
    (_hf0 : f 0 = 1)
    (hf_qmul : ∀ n : ℤ, f ((q : ℤ) * n) = f n)
    (hf_not_dvd : ∀ n : ℤ, ¬ (q : ℤ) ∣ n → f n = (n : ZMod q)) :
    ∀ m : ℤ, m ≠ 0 → ∃ n : ℤ, f (n + m) ≠ f n := by
  intro m hm
  by_contra hnot
  have hper : IsPeriod f m := by
    intro n
    by_contra hne
    exact hnot ⟨n, hne⟩
  have hmain : ∀ n : ℕ, ∀ m : ℤ, m.natAbs = n → m ≠ 0 → ¬ IsPeriod f m := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih m hmAbs hmne hper
    by_cases hdiv : (q : ℤ) ∣ m
    · rcases hdiv with ⟨m', hm⟩
      have hm'ne : m' ≠ 0 := by
        intro hz
        have hm0 : m = 0 := by simpa [hz] using hm
        exact hmne hm0
      have hper' : IsPeriod f m' := period_div_of_qmul f hf_qmul hm hper
      have hsmall : m'.natAbs < m.natAbs := by
        rw [hm]
        rw [Int.natAbs_mul]
        rw [Int.natAbs_natCast]
        have hm'pos : 0 < m'.natAbs := (Int.natAbs_pos).mpr hm'ne
        have hqge : 2 ≤ q := by omega
        nlinarith
      exact ih m'.natAbs (by omega) m' rfl hm'ne hper'
    · exact unit_period_contra hq f hf_not_dvd hper hdiv
  exact hmain m.natAbs m rfl hm hper



/-- The concrete last-nonzero-digit function `f_q` has no nonzero period (so every
non-constant standard Sudoku column is non-periodic). -/
theorem fq_no_period {q : ℕ} (hq : 3 ≤ q) :
    ∀ m : ℤ, m ≠ 0 → ∃ n : ℤ, fq q (n + m) ≠ fq q n :=
  lastNonzeroDigit_no_period q hq (fq q) (by simp)
    (fq_qmul_int (q := q) (by omega : q ≠ 0))
    (fun n hn => fq_eq_self_of_not_dvd_int (q := q) (by omega : 1 < q) hn)


/-- A board column is *periodic* with period `m` if `F n (t + m) = F n t` for all `t`. -/
def ColumnPeriodic (q N : ℕ) (F : SudokuBoard q N) (n : Fin N) (m : ℤ) : Prop :=
  IsPeriod (fun t : ℤ => F n t) m

/-- A board column is *non-periodic* if it has no nonzero period. -/
def ColumnNonperiodic (q N : ℕ) (F : SudokuBoard q N) (n : Fin N) : Prop :=
  ∀ m : ℤ, m ≠ 0 → ¬ ColumnPeriodic q N F n m

/-- Every column of the standard Sudoku solution is non-periodic: since the standard
solution fills every column with the last-nonzero-digit function `f_q`, this is exactly
`fq_no_period`.  This is the column-level non-periodicity fact that the aperiodicity
argument will use. -/
theorem standardSudoku_column_nonperiodic {q N : ℕ} (hq : 3 ≤ q) (n : Fin N) :
    ColumnNonperiodic q N (standardSudoku q N) n := by
  intro m hm hper
  rcases fq_no_period (q := q) hq m hm with ⟨t, ht⟩
  exact ht (by simpa [standardSudoku] using hper t)

/-- All columns of the standard Sudoku solution are non-periodic. -/
theorem standardSudoku_all_columns_nonperiodic {q N : ℕ} (hq : 3 ≤ q) :
    ∀ n : Fin N, ColumnNonperiodic q N (standardSudoku q N) n := by
  intro n
  exact standardSudoku_column_nonperiodic hq n


/-- The projective-duality encoding of a Sudoku column: the point `(i,j)` of the dual lattice
is sent to the value of `F` on the cell `(n, j·n + i)` of the board. -/
def encodeColumn {q N : ℕ} (F : SudokuBoard q N) (n : Fin N) : ℤ → ℤ → ZMod q :=
  fun i j => F n (j * ((n.val : ℤ) + 1) + i)

/-- For a single column, an `i`-period of the encoded function is exactly a column period:
`f_n(i+k,j) = f_n(i,j)` for all `(i,j)` iff `F(n, m+k) = F(n, m)` for all `m`. -/
lemma encoded_i_period_iff_column_period {q N : ℕ} (F : SudokuBoard q N) (n : Fin N) (k : ℤ) :
    (∀ i j : ℤ, F n (j * ((n.val : ℤ) + 1) + (i + k)) =
      F n (j * ((n.val : ℤ) + 1) + i)) ↔ ColumnPeriodic q N F n k := by
  constructor
  · intro h
    rw [ColumnPeriodic, IsPeriod]
    intro m
    simpa using h m 0
  · intro hcol i j
    rw [ColumnPeriodic, IsPeriod] at hcol
    have h := hcol (j * ((n.val : ℤ) + 1) + i)
    convert h using 1
    ring

/-- Contrapositive form of the projective-duality step: if every column of `F` is
non-periodic, then the encoded tuple has no nonzero period in the first (`i`) coordinate. -/
theorem encoded_tuple_no_i_period_of_column_nonperiodic
    {q N : ℕ} (F : SudokuBoard q N) (hN : 0 < N)
    (hcol : ∀ n : Fin N, ColumnNonperiodic q N F n) :
    ∀ k : ℤ, k ≠ 0 →
      ∃ n : Fin N, ∃ i j : ℤ,
        F n (j * ((n.val : ℤ) + 1) + (i + k)) ≠ F n (j * ((n.val : ℤ) + 1) + i) := by
  intro k hk
  let n0 : Fin N := ⟨0, hN⟩
  have hnz := hcol n0 k hk
  rw [ColumnPeriodic, IsPeriod] at hnz
  push Not at hnz
  rcases hnz with ⟨t, ht⟩
  refine ⟨n0, t, 0, ?_⟩
  simpa using ht


/-- The `q`-adically structured line `n ↦ f_q(a·n + b)` on all of `ℤ`. -/
def qLine (q : ℕ) (a b : ℤ) : ℤ → ZMod q :=
  fun n => fq q (a * n + b)

/-- The associated affine function `n ↦ a·n + b mod q`. -/
def qAffine (q : ℕ) (a b : ℤ) : ℤ → ZMod q :=
  fun n => (a : ZMod q) * (n : ZMod q) + (b : ZMod q)

/-- The bad coset `Γ = {n : ℤ | a·n + b ≡ 0 mod q}`, the zero set of the affine function. -/
def badCoset (q : ℕ) (a b : ℤ) : Set ℤ :=
  {n | qAffine q a b n = 0}

/-- Outside of the bad coset, the structured line `f_q(a·n+b)` agrees with the affine
function `a·n + b mod q`.  This is the first line-statistics law. -/
lemma qLine_eq_qAffine_of_not_mem_badCoset {q : ℕ} (hq : 1 < q) {a b n : ℤ}
    (hn : n ∉ badCoset q a b) :
    qLine q a b n = qAffine q a b n := by
  unfold badCoset at hn
  unfold qAffine at hn
  unfold qLine qAffine at ⊢
  have hdiv : ¬ (q : ℤ) ∣ (a * n + b) := by
    intro hd
    have hz : ((a * n + b : ℤ) : ZMod q) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (a * n + b) q).mpr hd
    rw [Int.cast_add] at hz
    rw [Int.cast_mul] at hz
    exact hn hz
  rw [fq_eq_self_of_not_dvd_int (q := q) hq hdiv]
  rw [Int.cast_add, Int.cast_mul]


/-- When `a` is a unit modulo `q`, the zero set of the affine function `a·n+b` is a single
coset of `qℤ`: once one zero `n₀` is known, all zeros are exactly `n ≡ n₀ (mod q)`. -/
lemma qAffine_zero_iff_of_unit_coeff {q : ℕ} {a b n₀ : ℤ}
    (ha : IsUnit (a : ZMod q)) (hn₀ : qAffine q a b n₀ = 0) :
    ∀ n : ℤ, qAffine q a b n = 0 ↔ (q : ℤ) ∣ n - n₀ := by
  intro n
  constructor
  · intro hn
    have hd : qAffine q a b n - qAffine q a b n₀ = 0 := by
      rw [hn, hn₀]
      ring
    unfold qAffine at hd
    have hz : (a : ZMod q) * (n : ZMod q) - (a : ZMod q) * (n₀ : ZMod q) = 0 := by
      convert hd using 1
      ring
    rw [← mul_sub] at hz
    have hsub0 : (n : ZMod q) - (n₀ : ZMod q) = 0 := by
      exact IsUnit.mul_left_cancel ha (by simpa using hz)
    have hnz : ((n - n₀ : ℤ) : ZMod q) = 0 := by
      rw [Int.cast_sub]
      simp [hsub0]
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (n - n₀) q).mp hnz
  · intro hd
    have hnz : ((n - n₀ : ℤ) : ZMod q) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (n - n₀) q).mpr hd
    rw [Int.cast_sub] at hnz
    have hsub : (n : ZMod q) = (n₀ : ZMod q) := sub_eq_zero.mp hnz
    calc
      qAffine q a b n = qAffine q a b n₀ := by
        unfold qAffine
        rw [hsub]
      _ = 0 := hn₀

/-- Bad-coset version: when `a` is a unit modulo `q` and the bad coset is nonempty, it is
exactly the coset `n₀ + qℤ`. -/
lemma badCoset_eq_coset_of_unit {q : ℕ} {a b n₀ : ℤ}
    (ha : IsUnit (a : ZMod q)) (hn₀ : n₀ ∈ badCoset q a b) :
    badCoset q a b = {n : ℤ | (q : ℤ) ∣ n - n₀} := by
  ext n
  unfold badCoset at hn₀ ⊢
  exact qAffine_zero_iff_of_unit_coeff ha hn₀ n




/-- Cast arithmetic: `(a·n + b : ℤ)` reduces to the expected expression in `ZMod q`. -/
lemma intCast_zmod_of_add_mul (q : ℕ) (a b n : ℤ) :
    ((a * n + b : ℤ) : ZMod q) = (a : ZMod q) * (n : ZMod q) + (b : ZMod q) := by
  rw [Int.cast_add, Int.cast_mul]

/-- The affine function `a·n+b` vanishes at `n` modulo `q` iff `q` divides `a·n+b`. -/
lemma qAffine_zero_iff_int_dvd {q : ℕ} (a b n : ℤ) :
    qAffine q a b n = 0 ↔ (q : ℤ) ∣ a * n + b := by
  unfold qAffine
  rw [← intCast_zmod_of_add_mul q a b n]
  exact ZMod.intCast_zmod_eq_zero_iff_dvd (a * n + b) q



/-- Factor-reduction of the bad coset: if `a = r·a′` and `b = r·b′` with `r ≠ 0`, then
`a·n+b ≡ 0 (mod r·q′)` iff `a′·n+b′ ≡ 0 (mod q′)`.  Combined with the unit-coefficient
lemma this gives the general coset structure. -/
lemma badCoset_coset_of_factor {r q' : ℕ} (hr : 0 < r)
    {a b a' b' : ℤ} (ha : a = (r : ℤ) * a') (hb : b = (r : ℤ) * b')
    {n₀ : ℤ} (hn₀ : qAffine (r * q') a b n₀ = 0)
    (ha' : IsUnit (a' : ZMod q')) :
    ∀ n : ℤ, qAffine (r * q') a b n = 0 ↔ ((q' : ℕ) : ℤ) ∣ n - n₀ := by
  have hfactor (x : ℤ) :
      (q' : ℤ) ∣ x ↔ ((r * q' : ℕ) : ℤ) ∣ (r : ℤ) * x := by
    rw [Nat.cast_mul]
    have hc : (r : ℤ) ≠ 0 := by exact_mod_cast (ne_of_gt hr)
    have h := (mul_dvd_mul_iff_right (a := (q' : ℤ)) (b := x) (c := (r : ℤ)) hc)
    simpa [mul_comm, mul_left_comm, mul_assoc] using h.symm
  have hn₀dvd : qAffine q' a' b' n₀ = 0 := by
    rw [qAffine_zero_iff_int_dvd (q := r * q') a b n₀] at hn₀
    have hEq0 : a * n₀ + b = (r : ℤ) * (a' * n₀ + b') := by
      rw [ha, hb]
      ring
    rw [hEq0] at hn₀
    have hd : (q' : ℤ) ∣ a' * n₀ + b' := (hfactor (a' * n₀ + b')).mpr hn₀
    rw [qAffine_zero_iff_int_dvd (q := q') a' b' n₀]
    exact hd
  intro n
  rw [qAffine_zero_iff_int_dvd (q := r * q') a b n]
  have hEq : a * n + b = (r : ℤ) * (a' * n + b') := by
    rw [ha, hb]
    ring
  rw [hEq]
  rw [← hfactor (a' * n + b')]
  rw [← qAffine_zero_iff_int_dvd (q := q') a' b' n]
  exact qAffine_zero_iff_of_unit_coeff ha' hn₀dvd n


/-- Bad-coset version of the factor reduction. -/
lemma badCoset_eq_coset_of_factor {r q' : ℕ} (hr : 0 < r)
    {a b a' b' n₀ : ℤ} (ha : a = (r : ℤ) * a') (hb : b = (r : ℤ) * b')
    (hn₀ : n₀ ∈ badCoset (r * q') a b) (ha' : IsUnit (a' : ZMod q')) :
    badCoset (r * q') a b = {n : ℤ | ((q' : ℕ) : ℤ) ∣ n - n₀} := by
  ext n
  unfold badCoset at hn₀ ⊢
  exact badCoset_coset_of_factor hr ha hb hn₀ ha' n


/-- Companion fact: if the bad coset (with modulus `2^e · q'`) is nonempty and `a` is
divisible by `2^e`, then `b` is divisible by `2^e` as well. -/
lemma badCoset_b_dvd_power_two {e q' : ℕ} {a b a' n₀ : ℤ}
    (ha : a = ((2^e : ℕ) : ℤ) * a')
    (hn₀ : n₀ ∈ badCoset ((2^e : ℕ) * q') a b) :
    ∃ b' : ℤ, b = ((2^e : ℕ) : ℤ) * b' := by
  have hq0 : qAffine ((2^e : ℕ) * q') a b n₀ = 0 := by
    unfold badCoset at hn₀
    exact hn₀
  have hqdiv : (((2^e : ℕ) * q' : ℕ) : ℤ) ∣ a * n₀ + b :=
    (qAffine_zero_iff_int_dvd (q := (2^e : ℕ) * q') a b n₀).mp hq0
  have hdvdq : ((2^e : ℕ) : ℤ) ∣ (((2^e : ℕ) * q' : ℕ) : ℤ) := by
    rw [Nat.cast_mul]
    exact dvd_mul_right ((2^e : ℕ) : ℤ) (q' : ℤ)
  have hsum : ((2^e : ℕ) : ℤ) ∣ a * n₀ + b := dvd_trans hdvdq hqdiv
  have han0 : ((2^e : ℕ) : ℤ) ∣ a * n₀ := by
    rw [ha, mul_assoc]
    exact dvd_mul_right ((2^e : ℕ) : ℤ) (a' * n₀)
  have hb' : ((2^e : ℕ) : ℤ) ∣ b := by
    rw [show b = (a * n₀ + b) - a * n₀ by ring]
    exact dvd_sub hsum han0
  rcases hb' with ⟨b', hb_eq⟩
  exact ⟨b', by simpa using hb_eq⟩

/-- Statistics Lemma (ii), power-of-two form: when `a = 2^e · a′` with `a′` a unit
modulo `q′`, the bad coset for modulus `2^e · q′` is either empty or — once a witness
`n₀` exists — exactly the coset `n₀ + q′·ℤ`.  In the paper `q′ = q/2^ord`. -/
theorem badCoset_coset_power_two {e q' : ℕ} {a b a' n₀ : ℤ}
    (ha : a = ((2^e : ℕ) : ℤ) * a')
    (hn₀ : n₀ ∈ badCoset ((2^e : ℕ) * q') a b)
    (ha' : IsUnit (a' : ZMod q')) :
    badCoset ((2^e : ℕ) * q') a b = {n : ℤ | ((q' : ℕ) : ℤ) ∣ n - n₀} := by
  obtain ⟨b', hb⟩ := badCoset_b_dvd_power_two ha hn₀
  exact badCoset_eq_coset_of_factor (r := 2^e) (q' := q') (pow_pos (by norm_num) e) ha hb hn₀ ha'


/-- The order statistic of a line coefficient: the number of factors of `2` in `a`
(equivalently, the `2`-adic valuation of `|a|`).  For a nonempty bad coset this is the
`ord` of the paper's Statistics Lemma. -/
def twoAdicOrder (a : ℤ) : ℕ := padicValNat 2 a.natAbs

/-- Packaging of the bad-coset dichotomy: the bad coset for modulus `2^e · q'` with
`a = 2^e·a′` and `a′` a unit modulo `q′` is either empty or a single coset of `q′·ℤ`. -/
theorem badCoset_empty_or_coset_power_two {e q' : ℕ} {a b a' : ℤ}
    (ha : a = ((2^e : ℕ) : ℤ) * a') (ha' : IsUnit (a' : ZMod q')) :
    badCoset ((2^e : ℕ) * q') a b = ∅ ∨
      ∃ n₀ : ℤ, badCoset ((2^e : ℕ) * q') a b = {n : ℤ | ((q' : ℕ) : ℤ) ∣ n - n₀} := by
  by_cases hempty : badCoset ((2^e : ℕ) * q') a b = ∅
  · exact Or.inl hempty
  · right
    rw [Set.eq_empty_iff_forall_notMem] at hempty
    by_contra hno
    have hnone : ∀ n₀ : ℤ, n₀ ∈ badCoset ((2^e : ℕ) * q') a b → False := by
      intro n₀ hn₀
      obtain ⟨b', hb⟩ := badCoset_b_dvd_power_two ha hn₀
      have hcos := badCoset_eq_coset_of_factor (r := 2^e) (q' := q')
        (pow_pos (by norm_num) e) ha hb hn₀ ha'
      exact hno ⟨n₀, hcos⟩
    exact hempty hnone


/-- `padicValNat` factorization on `ℤ`: any nonzero `a` factors as
`a = 2^ord · a′` with `a′` odd, where `ord = padicValNat 2 |a|`. -/
theorem int_two_power_factorization (a : ℤ) (ha : a ≠ 0) :
    ∃ a' : ℤ, a = (((2 ^ padicValNat 2 a.natAbs) : ℕ) : ℤ) * a' ∧ Odd a'.natAbs := by
  let n : ℕ := a.natAbs
  let e : ℕ := padicValNat 2 n
  let m : ℕ := n.divMaxPow 2
  have hn : n ≠ 0 := by
    dsimp [n]
    exact Int.natAbs_ne_zero.mpr ha
  have hm : ¬ 2 ∣ m := by
    dsimp [m]
    exact Nat.not_dvd_divMaxPow (by norm_num) hn
  have hoddm : Odd m := by
    exact Nat.not_even_iff_odd.mp (fun he => hm (even_iff_two_dvd.mp he))
  have hpow : (2 ^ e : ℕ) * m = n := by
    dsimp [e, m]
    exact Nat.pow_padicValNat_mul_divMaxPow 2 n
  have hcast : (((2 ^ e : ℕ) : ℤ) * (m : ℤ)) = (n : ℤ) := by exact_mod_cast hpow
  rcases Int.natAbs_eq a with hapos | haneg
  · refine ⟨(m : ℤ), ?_, ?_⟩
    · calc
        a = (n : ℤ) := hapos
        _ = ((2 ^ e : ℕ) : ℤ) * (m : ℤ) := hcast.symm
    · simpa using hoddm
  · refine ⟨-(m : ℤ), ?_, ?_⟩
    · calc
        a = -(n : ℤ) := haneg
        _ = -(((2 ^ e : ℕ) : ℤ) * (m : ℤ)) := by rw [hcast]
        _ = ((2 ^ e : ℕ) : ℤ) * (-(m : ℤ)) := by ring
    · simpa using hoddm


/-- An odd integer is a unit modulo any power of two greater than `1`. -/
lemma zmod_isUnit_of_odd {a' : ℤ} {m : ℕ} (hodd : Odd a'.natAbs)
    (hm : ∃ s : ℕ, m = 2 ^ (s + 1)) : IsUnit (a' : ZMod m) := by
  have hc2 : a'.natAbs.Coprime 2 := (Nat.coprime_two_right).mpr hodd
  rcases hm with ⟨s, hm⟩
  have hcop : a'.natAbs.Coprime m := by
    rw [hm]
    exact (Nat.coprime_pow_right_iff (by omega : 0 < s + 1) a'.natAbs 2).mpr hc2
  have hunit : IsUnit ((a'.natAbs : ℕ) : ZMod m) :=
    (ZMod.isUnit_iff_coprime a'.natAbs m).mpr hcop
  rcases Int.natAbs_eq a' with ha | ha
  · rw [ha]
    simpa using hunit
  · rw [ha]
    simpa using (IsUnit.neg hunit)

/-- The full Statistics Lemma (ii) hypothesis set: any nonzero coefficient `a` with
`ord = ν₂(|a|)` factors as `a = 2^ord · a′` with `a′` a unit modulo `q′`, and the bad
coset for modulus `2^ord · q′` is either empty or a single coset of `q′·ℤ`. -/
theorem stats_ii_of_coefficient {ord q' : ℕ} {a b : ℤ}
    (ha : a ≠ 0) (hord : ord = padicValNat 2 a.natAbs)
    (hq' : ∃ s : ℕ, q' = 2 ^ (s + 1)) :
    ∃ a' : ℤ,
      a = (((2 ^ ord) : ℕ) : ℤ) * a' ∧ IsUnit (a' : ZMod q') ∧
      (badCoset (((2 ^ ord) : ℕ) * q') a b = ∅ ∨
        ∃ n₀ : ℤ, badCoset (((2 ^ ord) : ℕ) * q') a b =
          {n : ℤ | ((q' : ℕ) : ℤ) ∣ n - n₀}) := by
  obtain ⟨a', hfac, hodd⟩ := int_two_power_factorization a ha
  have ha_ord : a = (((2 ^ ord) : ℕ) : ℤ) * a' := by
    simpa [hord] using hfac
  have hunit : IsUnit (a' : ZMod q') := zmod_isUnit_of_odd hodd hq'
  have hdich := badCoset_empty_or_coset_power_two (e := ord) (q' := q') (a := a)
    (b := b) (a' := a') ha_ord hunit
  exact ⟨a', ha_ord, hunit, hdich⟩


/-! ## Interval counting for cosets of `q′·ℤ`

The upper-density estimate in Statistics Lemma (ii) is the statement that a bad coset,
which is a single residue class modulo `q′`, occupies density `1/q′` in large symmetric
intervals.  The counting object below is the number of points of the coset inside
`[-N, N]`. -/

/-- The number of integers `n ∈ [-N, N]` that lie in the coset `n₀ + q′·ℤ`. -/
noncomputable def intervalCount (q' : ℕ) (n₀ : ℤ) (N : ℕ) : ℕ :=
  ((Finset.Icc (-(N : ℤ)) (N : ℤ)).filter
    (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card


/-- Translation invariance of the count: the map `n ↦ n + N` carries the symmetric
interval `[-N, N]` onto `[0, 2N]` and preserves the coset condition (with the coset
parameter shifted by `N`). -/
lemma intervalCount_eq_translate {q' N : ℕ} (_hq' : 0 < q') (n₀ : ℤ) :
    intervalCount q' n₀ N =
      ((Finset.Icc (0 : ℤ) (((2 * N : ℕ) : ℤ))).filter
        (fun m : ℤ => ((q' : ℕ) : ℤ) ∣ m - (n₀ + (N : ℤ)))).card := by
  apply Finset.card_bij (fun (n : ℤ) (_ : n ∈ _) => n + (N : ℤ))
  · intro n hn
    rw [Finset.mem_filter] at hn ⊢
    rcases hn with ⟨hI, hd⟩
    constructor
    · rw [Finset.mem_Icc] at hI ⊢
      rcases hI with ⟨hl, hu⟩
      constructor <;> omega
    · have hEq : (n + (N : ℤ)) - (n₀ + (N : ℤ)) = n - n₀ := by ring
      rwa [← hEq] at hd
  · intro n1 hn1 n2 hn2 h
    omega
  · intro m hm
    rw [Finset.mem_filter] at hm
    rcases hm with ⟨hI, hd⟩
    refine ⟨m - (N : ℤ), ?_, ?_⟩
    · rw [Finset.mem_filter]
      constructor
      · rw [Finset.mem_Icc] at hI ⊢
        rcases hI with ⟨h0, hu⟩
        constructor <;> omega
      · have hEq : (m - (N : ℤ)) - n₀ = m - (n₀ + (N : ℤ)) := by ring
        rwa [← hEq] at hd
    · ring


/-- The block `[0, q′·B - 1]` with `B = 2N/q′ + 1` covers `[0, 2N]`. -/
lemma block_cover_bound {q' N : ℕ} (hq' : 0 < q') :
    2 * N + 1 ≤ q' * ((2 * N) / q' + 1) := by
  have hdiv := Nat.div_add_mod (2 * N) q'
  have hmod : (2 * N) % q' < q' := Nat.mod_lt (2 * N) hq'
  nlinarith

/-- First easy case: `q′ = 1`; the coset is all of `ℤ`, so the count is `2N+1`. -/
lemma intervalCount_one (n₀ : ℤ) (N : ℕ) : intervalCount 1 n₀ N = 2 * N + 1 := by
  simp [intervalCount, Int.card_Icc]
  rw [show ((N : ℤ) + 1 + (N : ℤ)) = (((2 * N + 1 : ℕ) : ℤ)) by norm_num; ring]
  rw [Int.toNat_natCast]



/-- In any block of fewer than `q′` consecutive integers there is at most one point of
a fixed coset `n₀ + q′·ℤ`: two distinct points would differ by a nonzero multiple of `q′`,
contradicting a difference of size `< q′`. -/
lemma interval_coset_at_most_one {q' : ℕ} (_hq' : 0 < q') (n₀ m₁ m₂ : ℤ)
    (h₁ : ((q' : ℕ) : ℤ) ∣ m₁ - n₀)
    (h₂ : ((q' : ℕ) : ℤ) ∣ m₂ - n₀)
    (hle : m₁ ≤ m₂) (hlt : m₂ - m₁ < (q' : ℤ)) :
    m₁ = m₂ := by
  by_contra hne
  have hlt1 : m₁ < m₂ := lt_of_le_of_ne hle hne
  have hd : (m₂ - n₀) - (m₁ - n₀) = m₂ - m₁ := by ring
  have hdvd : (q' : ℤ) ∣ m₂ - m₁ := by
    simpa [hd] using dvd_sub h₂ h₁
  rcases hdvd with ⟨c, hc⟩
  have hdpos : 0 < m₂ - m₁ := sub_pos.mpr hlt1
  have hcpos : 0 < c := by
    by_contra hcnonpos
    have hcle : c ≤ 0 := le_of_not_gt hcnonpos
    have hprod : (q' : ℤ) * c ≤ 0 := by
      exact mul_nonpos_of_nonneg_of_nonpos (by exact_mod_cast (Nat.zero_le q')) hcle
    have : 0 < (q' : ℤ) * c := by
      rw [← hc]
      exact hdpos
    omega
  have hcge1 : (1 : ℤ) ≤ c := Int.add_one_le_iff.mpr hcpos
  have hprod_ge : (q' : ℤ) * 1 ≤ (q' : ℤ) * c :=
    mul_le_mul_of_nonneg_left hcge1 (by exact_mod_cast (Nat.zero_le q'))
  have hge : (q' : ℤ) ≤ m₂ - m₁ := by
    calc
      (q' : ℤ) = (q' : ℤ) * 1 := by ring
      _ ≤ (q' : ℤ) * c := hprod_ge
      _ = m₂ - m₁ := hc.symm
  omega

/-- Specialized block bound: in the leading block `[0, q′-1]` there is at most one
integer in a fixed coset `n₀ + q′·ℤ`. -/
lemma filter_coset_block_le_one {q' : ℕ} (hq' : 0 < q') (n₀ : ℤ) :
    ((Finset.Icc (0 : ℤ) (((q' : ℕ) : ℤ) - 1)).filter
      (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card ≤ 1 := by
  rw [Finset.card_le_one_iff]
  intro a b ha hb
  have haI := (Finset.mem_filter.mp ha).1
  have hbI := (Finset.mem_filter.mp hb).1
  have hdiva := (Finset.mem_filter.mp ha).2
  have hdivb := (Finset.mem_filter.mp hb).2
  have hbnd (x : ℤ) : x ∈ Finset.Icc (0 : ℤ) (((q' : ℕ) : ℤ) - 1) →
      (0 : ℤ) ≤ x ∧ x ≤ ((q' : ℕ) : ℤ) - 1 := Finset.mem_Icc.mp
  have hbnda := hbnd a haI
  have hbndb := hbnd b hbI
  rcases le_total a b with hab | hba
  · have hdiff : b - a < (q' : ℤ) := by omega
    exact interval_coset_at_most_one hq' n₀ a b hdiva hdivb hab hdiff
  · have hdiff : a - b < (q' : ℤ) := by omega
    exact (interval_coset_at_most_one hq' n₀ b a hdivb hdiva hba hdiff).symm

/-- Split an integer interval at `c`: `[a, b] = [a, c-1] ∪ [c, b]` when
`a ≤ c` and `c-1 ≤ b`. -/
lemma Icc_split_at (a c b : ℤ) (h1 : a ≤ c) (h2 : c - 1 ≤ b) :
    Finset.Icc a b = Finset.Icc a (c - 1) ∪ Finset.Icc c b := by
  ext x
  rw [Finset.mem_union, Finset.mem_Icc, Finset.mem_Icc, Finset.mem_Icc]
  constructor
  · intro hx
    rcases hx with ⟨hax, hxb⟩
    by_cases hxc : x < c
    · left
      exact ⟨hax, by omega⟩
    · right
      exact ⟨le_of_not_gt hxc, hxb⟩
  · intro hx
    rcases hx with hx | hx
    · rcases hx with ⟨hax, hx1⟩
      exact ⟨hax, le_trans hx1 h2⟩
    · rcases hx with ⟨hxc, hxb⟩
      exact ⟨le_trans h1 hxc, hxb⟩

/-- The leading block `[0, q′-1]` and the tail `[q′, q′·(B+1)-1]` are disjoint. -/
lemma Icc_block_disjoint_tail {q' B : ℕ} (_hq' : 0 < q') :
    Disjoint (Finset.Icc (0 : ℤ) (((q' : ℕ) : ℤ) - 1))
      (Finset.Icc ((q' : ℕ) : ℤ) (((q' * (B + 1) : ℕ) : ℤ) - 1)) := by
  rw [Finset.disjoint_left]
  intro x hx hy
  have hx1 : x ≤ ((q' : ℕ) : ℤ) - 1 := (Finset.mem_Icc.mp hx).2
  have hy0 : ((q' : ℕ) : ℤ) ≤ x := (Finset.mem_Icc.mp hy).1
  omega

/-- Reindexing of the tail block: points `n` of the tail `[q′, q′(B+1)-1]` in the coset
`n₀ + q′ℤ` correspond bijectively, via `k = n - q′`, to points `k` of `[0, q′B-1]`
in the coset `(n₀-q′) + q′ℤ`. -/
lemma card_filter_tail_eq {q' B : ℕ} (_hq' : 0 < q') (n₀ : ℤ) :
    ((Finset.Icc ((q' : ℕ) : ℤ) (((q' * (B + 1) : ℕ) : ℤ) - 1)).filter
      (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card =
    ((Finset.Icc (0 : ℤ) (((q' * B : ℕ) : ℤ) - 1)).filter
      (fun k : ℤ => ((q' : ℕ) : ℤ) ∣ k - (n₀ - (q' : ℤ)))).card := by
  have hrel : (((q' * (B + 1) : ℕ) : ℤ)) = (((q' * B : ℕ) : ℤ) + (q' : ℤ)) := by
    have hrelN : q' * (B + 1) = q' * B + q' := by ring
    rw [hrelN, Nat.cast_add]
  apply Finset.card_bij (fun (n : ℤ) (_ : n ∈ _) => n - (q' : ℤ))
  · intro n hn
    rw [Finset.mem_filter] at hn ⊢
    rcases hn with ⟨hI, hd⟩
    constructor
    · rw [Finset.mem_Icc] at hI ⊢
      rcases hI with ⟨hqle, hle⟩
      have hle' : n ≤ (((q' * B : ℕ) : ℤ) + (q' : ℤ)) - 1 := by
        simpa [hrel] using hle
      constructor
      · exact sub_nonneg.mpr hqle
      · omega
    · have hEq : n - (q' : ℤ) - (n₀ - (q' : ℤ)) = n - n₀ := by ring
      rwa [← hEq] at hd
  · intro n1 hn1 n2 hn2 h
    omega
  · intro k hk
    rw [Finset.mem_filter] at hk
    rcases hk with ⟨hI, hd⟩
    refine ⟨k + (q' : ℤ), ?_, ?_⟩
    · rw [Finset.mem_filter]
      constructor
      · rw [Finset.mem_Icc] at hI ⊢
        rcases hI with ⟨hk0, hk1⟩
        constructor
        · omega
        · rw [hrel]
          omega
      · have hEq : (k + (q' : ℤ)) - n₀ = k - (n₀ - (q' : ℤ)) := by ring
        rwa [← hEq] at hd
    · ring

theorem coset_count_of_block_length {q' B : ℕ} (_hq' : 0 < q') (n₀ : ℤ) :
    ((Finset.Icc (0 : ℤ) (((q' * B : ℕ) : ℤ) - 1)).filter
      (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card ≤ B := by
  revert n₀
  induction B with
  | zero =>
      intro n₀
      simp
  | succ B ih =>
      intro n₀
      let P : ℤ → Prop := fun n => ((q' : ℕ) : ℤ) ∣ n - n₀
      have hrel : (((q' * (B + 1) : ℕ) : ℤ)) = (((q' * B : ℕ) : ℤ) + (q' : ℤ)) := by
        have hrelN : q' * (B + 1) = q' * B + q' := by ring
        rw [hrelN, Nat.cast_add]
      have h2 : ((q' : ℕ) : ℤ) - 1 ≤ (((q' * (B + 1) : ℕ) : ℤ) - 1) := by
        have hnat : q' ≤ q' * (B + 1) := Nat.le_mul_of_pos_right q' (by omega)
        have hz : ((q' : ℕ) : ℤ) ≤ (((q' * (B + 1) : ℕ) : ℤ)) := by exact_mod_cast hnat
        omega
      have hI := Icc_split_at (0 : ℤ) ((q' : ℕ) : ℤ) (((q' * (B + 1) : ℕ) : ℤ) - 1)
        (by omega) h2
      rw [hI]
      rw [Finset.filter_union P]
      have hdisj : Disjoint
          (Finset.filter P (Finset.Icc (0 : ℤ) (((q' : ℕ) : ℤ) - 1)))
          (Finset.filter P (Finset.Icc ((q' : ℕ) : ℤ) (((q' * (B + 1) : ℕ) : ℤ) - 1))) :=
        Disjoint.mono (Finset.filter_subset P _) (Finset.filter_subset P _)
          (Icc_block_disjoint_tail _hq')
      rw [Finset.card_union_of_disjoint hdisj]
      have hl := filter_coset_block_le_one _hq' n₀
      have htail : ((Finset.Icc ((q' : ℕ) : ℤ) (((q' * (B + 1) : ℕ) : ℤ) - 1)).filter
          (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card ≤ B := by
        have hEq := card_filter_tail_eq (q' := q') (B := B) _hq' n₀
        rw [hEq]
        exact ih (n₀ - (q' : ℤ))
      have hl' : (Finset.filter P (Finset.Icc (0 : ℤ) (((q' : ℕ) : ℤ) - 1))).card ≤ 1 := by
        simpa [P] using hl
      have htail' : (Finset.filter P (Finset.Icc ((q' : ℕ) : ℤ)
          (((q' * (B + 1) : ℕ) : ℤ) - 1))).card ≤ B := by
        simpa [P] using htail
      have hsum := Nat.add_le_add hl' htail'
      omega


theorem coset_count_upper_bound (q' : ℕ) (hq' : 0 < q') (n₀ : ℤ) (N : ℕ) :
    intervalCount q' n₀ N ≤ (2 * N) / q' + 1 := by
  let B : ℕ := (2 * N) / q' + 1
  have hcovN : (2 * N : ℕ) + 1 ≤ q' * B := by
    dsimp [B]
    exact block_cover_bound hq'
  have hcov : ((2 * N : ℕ) : ℤ) ≤ (((q' * B : ℕ) : ℤ) - 1) := by
    have hz : (((2 * N : ℕ) : ℤ) + 1) ≤ ((q' * B : ℕ) : ℤ) := by exact_mod_cast hcovN
    omega
  have hsub : Finset.Icc (0 : ℤ) (((2 * N : ℕ) : ℤ)) ⊆
      Finset.Icc (0 : ℤ) (((q' * B : ℕ) : ℤ) - 1) := by
    intro x hx
    rw [Finset.mem_Icc] at hx ⊢
    rcases hx with ⟨hx0, hxu⟩
    constructor
    · exact hx0
    · omega
  let P : ℤ → Prop := fun m : ℤ => ((q' : ℕ) : ℤ) ∣ m - (n₀ + (N : ℤ))
  have hle' : ((Finset.Icc (0 : ℤ) (((2 * N : ℕ) : ℤ))).filter P).card ≤
      ((Finset.Icc (0 : ℤ) (((q' * B : ℕ) : ℤ) - 1)).filter P).card := by
    exact Finset.card_le_card (Finset.filter_subset_filter P hsub)
  have hblock := coset_count_of_block_length (q' := q') (B := B) hq' (n₀ + (N : ℤ))
  have hmain : intervalCount q' n₀ N ≤ B := by
    rw [intervalCount_eq_translate (q' := q') (N := N) hq' n₀]
    exact le_trans hle' hblock
  simpa [B] using hmain



/-- Finite upper-density form for a bad coset: once the bad coset has been identified
(as in Statistics Lemma (ii)) with the residue class `n₀ + q′·ℤ`, the number of its points
in the symmetric interval `[-N, N]` is at most `(2N)/q′ + 1`.  This is the finite,
decidable form of the paper's `1/q′` upper density; the rewriting of the actual bad coset
into `intervalCount` happens at use sites. -/
theorem badCoset_finite_density {q' : ℕ} (hq' : 0 < q') (n₀ : ℤ) (N : ℕ) :
    intervalCount q' n₀ N ≤ (2 * N) / q' + 1 :=
  coset_count_upper_bound q' hq' n₀ N

/-- The affine approximation of a structured line `n ↦ c·f_q(a·n+b)`: `c·(a·n+b) mod q`. -/
def lineAffine (q : ℕ) (a b c : ℤ) : ℤ → ZMod q :=
  fun n => (c : ZMod q) * qAffine q a b n

/-- The structured line itself, on all of `ℤ`: `n ↦ c·f_q(a·n+b)`. -/
def lineStructured (q : ℕ) (a b c : ℤ) : ℤ → ZMod q :=
  fun n => (c : ZMod q) * fq q (a * n + b)

/-- A structured line disagrees with its affine shadow exactly on the bad coset. -/
lemma lineStructured_ne_lineAffine_iff_mem_badCoset {q : ℕ} (hq : 1 < q) {a b c n : ℤ}
    (hc : IsUnit (c : ZMod q)) :
    lineStructured q a b c n ≠ lineAffine q a b c n ↔ n ∈ badCoset q a b := by
  constructor
  · intro hne
    by_contra hbad
    have hline := qLine_eq_qAffine_of_not_mem_badCoset hq hbad
    unfold qLine at hline
    have heq : lineStructured q a b c n = lineAffine q a b c n := by
      unfold lineStructured lineAffine
      exact congrArg (fun x : ZMod q => (c : ZMod q) * x) hline
    exact hne heq
  · intro hbad heq
    unfold lineStructured lineAffine at heq
    have hb0 : qAffine q a b n = 0 := by
      unfold badCoset at hbad
      exact hbad
    have hf : fq q (a * n + b) ≠ 0 := fq_ne_zero hq (a * n + b)
    have h' : (c : ZMod q) * fq q (a * n + b) = (c : ZMod q) * 0 := by
      simpa [hb0] using heq
    exact hf (IsUnit.mul_left_cancel hc h')




/-- Forward direction: a disagreement point lies in the bad coset. -/
lemma disagreement_mem_badCoset {q : ℕ} (hq : 1 < q) {a b c n : ℤ}
    (hc : IsUnit (c : ZMod q))
    (h : lineStructured q a b c n ≠ lineAffine q a b c n) :
    n ∈ badCoset q a b :=
  (lineStructured_ne_lineAffine_iff_mem_badCoset hq hc).mp h

/-- In any window `[1, N]`, the disagreement points of a structured line are contained in
its bad coset. -/
lemma disagreement_subset_badCoset_window {q N : ℕ} [NeZero q] (hq : 1 < q) {a b c : ℤ}
    (hc : IsUnit (c : ZMod q)) :
    (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => lineStructured q a b c n ≠ lineAffine q a b c n) ⊆
      (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0) := by
  intro n hn
  rw [Finset.mem_filter] at hn ⊢
  have hb := disagreement_mem_badCoset hq hc hn.2
  unfold badCoset at hb
  exact ⟨hn.1, hb⟩


/-- Count half of the transfer bound: within the window `[1, N]` there are no more
disagreements of a structured line than zeros of its affine shadow. -/
lemma badCell_window_count_le {q N : ℕ} [NeZero q] (hq : 1 < q) {a b c : ℤ}
    (hc : IsUnit (c : ZMod q)) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => lineStructured q a b c n ≠ lineAffine q a b c n)).card ≤
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0)).card := by
  exact Finset.card_le_card (disagreement_subset_badCoset_window hq hc)


/-- Transfer bound at the use site: once the zeros of the affine shadow in the window are
known to be exactly the coset `n₀ + q′·ℤ`, the disagreement count in `[1, N]` is bounded
by `intervalCount q′ n₀ N`. -/
lemma badCell_window_count_le_interval {q q' N : ℕ} [NeZero q] (hq : 1 < q)
    {a b c n₀ : ℤ} (hc : IsUnit (c : ZMod q))
    (hcos : ∀ n : ℤ, qAffine q a b n = 0 ↔ ((q' : ℕ) : ℤ) ∣ n - n₀) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => lineStructured q a b c n ≠ lineAffine q a b c n)).card ≤
      intervalCount q' n₀ N := by
  have h1 := badCell_window_count_le (q := q) (N := N) (a := a) (b := b) (c := c) hq hc
  have hsubW : Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) ⊆
      Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ) := by
    intro n hn
    rw [Finset.mem_Icc] at hn ⊢
    rcases hn with ⟨h1n, hnN⟩
    constructor <;> omega
  have h2 : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0)).card ≤
      ((Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0)).card := by
    exact Finset.card_le_card (Finset.filter_subset_filter (fun n : ℤ => qAffine q a b n = 0) hsubW)
  have hEq : (Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0) =
      (Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀) := by
    apply Finset.filter_congr
    intro n hn
    exact hcos n
  calc
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => lineStructured q a b c n ≠ lineAffine q a b c n)).card
        ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0)).card := h1
    _ ≤ ((Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => qAffine q a b n = 0)).card := h2
    _ = ((Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)).card := by rw [hEq]
    _ = intervalCount q' n₀ N := by rfl


/-- Final finite density form at the use site: disagreement count in the window `[1, N]`
is at most `(2N)/q′ + 1`. -/
lemma badCell_window_density_bound {q q' N : ℕ} [NeZero q] (hq : 1 < q)
    (hq' : 0 < q') {a b c n₀ : ℤ} (hc : IsUnit (c : ZMod q))
    (hcos : ∀ n : ℤ, qAffine q a b n = 0 ↔ ((q' : ℕ) : ℤ) ∣ n - n₀) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => lineStructured q a b c n ≠ lineAffine q a b c n)).card ≤
      (2 * N) / q' + 1 := by
  exact le_trans (badCell_window_count_le_interval hq hc hcos)
    (badCoset_finite_density hq' n₀ N)


/-- Glue for the density bound: a bad coset of modulus `2^e·q′` whose coefficient factors
as `a = 2^e·a′` with `a′` a unit modulo `q′` and which is known nonempty at `n₀` is exactly
the coset `n₀ + q′·ℤ` (in decidable `qAffine` form). -/
lemma badCoset_coset_for_density {e q' : ℕ} (_hq' : 0 < q') {a b a' n₀ : ℤ}
    (ha : a = ((2^e : ℕ) : ℤ) * a')
    (hn₀ : n₀ ∈ badCoset ((2^e : ℕ) * q') a b)
    (ha' : IsUnit (a' : ZMod q')) :
    ∀ n : ℤ, qAffine ((2^e : ℕ) * q') a b n = 0 ↔ ((q' : ℕ) : ℤ) ∣ n - n₀ := by
  obtain ⟨b', hb⟩ := badCoset_b_dvd_power_two ha hn₀
  intro n
  exact badCoset_coset_of_factor (pow_pos (by norm_num) e) ha hb hn₀ ha' n




/-- Map a board index `n : Fin N` to the integer window coordinate `n.val + 1 ∈ [1, N]`. -/
def finToInt {N : ℕ} (n : Fin N) : ℤ :=
  (n.val : ℤ) + 1

/-- `finToInt` lands in the window `[1, N]`. -/
lemma finToInt_mem_window {N : ℕ} (n : Fin N) :
    finToInt n ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
  rw [Finset.mem_Icc]
  constructor
  · dsimp [finToInt]
    omega
  · dsimp [finToInt]
    have hlt : n.val < N := n.isLt
    omega


/-- Map an integer window coordinate back to a board index. -/
def intToFin {N : ℕ} (x : {x : ℤ // x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)}) : Fin N :=
  ⟨Int.toNat (x.1 - 1), by
    have hx1 : (1 : ℤ) ≤ x.1 := (Finset.mem_Icc.mp x.2).1
    have hx2 : x.1 ≤ (N : ℤ) := (Finset.mem_Icc.mp x.2).2
    have hnonneg : 0 ≤ x.1 - 1 := by omega
    have hlt : x.1 - 1 < (N : ℤ) := by omega
    exact (Int.toNat_lt hnonneg).mpr hlt⟩

/-- The forward-then-back identity. -/
lemma finToInt_intToFin {N : ℕ} (x : {x : ℤ // x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)}) :
    finToInt (intToFin x) = x.1 := by
  dsimp [finToInt, intToFin]
  have hx : (1 : ℤ) ≤ x.1 := (Finset.mem_Icc.mp x.2).1
  have hnonneg : 0 ≤ x.1 - 1 := by omega
  rw [Int.toNat_of_nonneg hnonneg]
  omega

/-- The back-then-forward identity. -/
lemma intToFin_finToInt {N : ℕ} (n : Fin N) :
    intToFin ⟨finToInt n, finToInt_mem_window n⟩ = n := by
  apply Fin.ext
  dsimp [intToFin, finToInt]
  have hlin : ((n.val : ℤ) + 1 - 1) = (n.val : ℤ) := by ring
  rw [hlin, Int.toNat_natCast]


/-- The canonical equivalence between the board window and the integer window. -/
def finWindowEquiv (N : ℕ) : Fin N ≃ {x : ℤ // x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)} where
  toFun n := ⟨finToInt n, finToInt_mem_window n⟩
  invFun := intToFin
  left_inv := intToFin_finToInt
  right_inv := by
    intro x
    apply Subtype.ext
    exact finToInt_intToFin x


/-- Board-coordinate disagreement count for a line with representation `(a,b,c)`. -/
def boardBadCount {q N : ℕ} [NeZero q] (a b c : ℤ) : ℕ :=
  ((Finset.univ : Finset (Fin N)).filter
    (fun n : Fin N => lineStructured q a b c (finToInt n) ≠ lineAffine q a b c (finToInt n))).card


/-- The board disagreement count equals the integer-window disagreement count, via
`finWindowEquiv`. -/
lemma boardBadCount_eq_window {q N : ℕ} [NeZero q] (a b c : ℤ) :
    boardBadCount (q := q) (N := N) a b c =
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun m : ℤ => lineStructured q a b c m ≠ lineAffine q a b c m)).card := by
  unfold boardBadCount
  apply Finset.card_bij (fun (n : Fin N) (_ : n ∈ (Finset.univ : Finset (Fin N)).filter
      (fun n : Fin N => lineStructured q a b c (finToInt n) ≠ lineAffine q a b c (finToInt n))) =>
        finToInt n)
  · intro n hn
    rw [Finset.mem_filter] at hn ⊢
    constructor
    · exact finToInt_mem_window n
    · exact hn.2
  · intro n1 hn1 n2 hn2 h
    apply Fin.ext
    have hz' : (n1.val : ℤ) + 1 = (n2.val : ℤ) + 1 := by simpa [finToInt] using h
    have hz : (n1.val : ℤ) = (n2.val : ℤ) := by omega
    exact_mod_cast hz
  · intro m hm
    rw [Finset.mem_filter] at hm
    refine ⟨intToFin ⟨m, hm.1⟩, ?_, ?_⟩
    · rw [Finset.mem_filter]
      constructor
      · simp
      · -- predicate at finToInt(intToFin m)=m equals hm.2
        have hm' : lineStructured q a b c m ≠ lineAffine q a b c m := hm.2
        rwa [finToInt_intToFin ⟨m, hm.1⟩]
    · exact finToInt_intToFin ⟨m, hm.1⟩


/-- Board-coordinate finite density bound: with the bad-coset coset description `hcos`,
the disagreement count over `Fin N` is at most `(2N)/q′ + 1`. -/
lemma boardBadCell_density_bound {q q' N : ℕ} [NeZero q] (hq : 1 < q)
    (hq' : 0 < q') {a b c n₀ : ℤ} (hc : IsUnit (c : ZMod q))
    (hcos : ∀ n : ℤ, qAffine q a b n = 0 ↔ ((q' : ℕ) : ℤ) ∣ n - n₀) :
    boardBadCount (q := q) (N := N) a b c ≤ (2 * N) / q' + 1 := by
  rw [boardBadCount_eq_window (q := q) (N := N) a b c]
  exact badCell_window_density_bound hq hq' hc hcos




/-! ## Lower density side

Dual of the upper bound: a single residue class modulo `q′` occupies at least about
`1/q′` of any large symmetric interval.  This is the lower-density input to the
good-columns / weak-digit-equidistribution half of the Sudoku argument. -/



/-- Two integers that are congruent modulo `q` and both lie in `[0, q)` are equal. -/
lemma eq_of_zmod_eq_of_lt {q : ℕ} (_hq : 0 < q) {a b : ℤ}
    (ha0 : 0 ≤ a) (haq : a < (q : ℤ))
    (hb0 : 0 ≤ b) (hbq : b < (q : ℤ))
    (h : (a : ZMod q) = (b : ZMod q)) : a = b := by
  have hmod : a ≡ b [ZMOD (q : ℤ)] := (ZMod.intCast_eq_intCast_iff a b q).mp h
  have hdvd : (q : ℤ) ∣ b - a := Int.ModEq.dvd hmod
  rcases hdvd with ⟨c, hc⟩
  have hqZ : (0 : ℤ) ≤ (q : ℤ) := by exact_mod_cast (Nat.zero_le q)
  have hc0 : c = 0 := by
    rcases lt_trichotomy c 0 with hneg | hzero | hpos
    · exfalso
      have hcle : c ≤ -1 := by omega
      have hmul : (q : ℤ) * c ≤ (q : ℤ) * (-1) :=
        mul_le_mul_of_nonneg_left hcle hqZ
      have hsmall : b - a ≤ -(q : ℤ) := by
        rw [hc]
        linarith
      have hlow : -(q : ℤ) < b - a := by omega
      omega
    · exact hzero
    · exfalso
      have hcge : 1 ≤ c := by omega
      have hmul : (q : ℤ) * 1 ≤ (q : ℤ) * c :=
        mul_le_mul_of_nonneg_left hcge hqZ
      have hbig : (q : ℤ) ≤ b - a := by
        rw [hc]
        linarith
      have hhigh : b - a < (q : ℤ) := by omega
      omega
  rw [hc0, mul_zero] at hc
  omega


/-- Residues of consecutive integers are distinct: within one block of length `q′`,
congruence modulo `q′` forces equality. -/
lemma injective_residues_on_block {q' : ℕ} (_hq' : 0 < q') (x n₀ : ℤ)
    (k₁ k₂ : Fin q')
    (h : ((x : ℤ) + (k₁.val : ℤ) - n₀ : ZMod q') =
         ((x : ℤ) + (k₂.val : ℤ) - n₀ : ZMod q')) :
    k₁ = k₂ := by
  apply Fin.ext
  push_cast at h
  have hz : ((k₁.val : ℤ) : ZMod q') = ((k₂.val : ℤ) : ZMod q') := by
    have hc := congrArg (fun z : ZMod q' => z - ((x : ZMod q') - (n₀ : ZMod q'))) h
    simpa [sub_eq_add_neg, add_comm, add_left_comm, add_assoc] using hc
  have hb1 : (0 : ℤ) ≤ (k₁.val : ℤ) ∧ (k₁.val : ℤ) < (q' : ℤ) := by omega
  have hb2 : (0 : ℤ) ≤ (k₂.val : ℤ) ∧ (k₂.val : ℤ) < (q' : ℤ) := by omega
  have heq : (k₁.val : ℤ) = (k₂.val : ℤ) :=
    eq_of_zmod_eq_of_lt (by omega : 0 < q') hb1.1 hb1.2 hb2.1 hb2.2 hz
  exact_mod_cast heq


/-- In every block of `q′` consecutive integers there is at least one point of the coset
`n₀ + q′·ℤ`. -/
lemma exists_mem_Icc_of_coset {q' : ℕ} (hq' : 0 < q') (x n₀ : ℤ) :
    ∃ m : ℤ, m ∈ Finset.Icc x (x + ((q' : ℕ) : ℤ) - 1) ∧ ((q' : ℕ) : ℤ) ∣ m - n₀ := by
  letI : NeZero q' := ⟨ne_of_gt hq'⟩
  letI : Fintype (ZMod q') := ZMod.fintype q'
  let g : Fin q' → ZMod q' := fun k => ((x : ℤ) + (k.val : ℤ) - n₀ : ZMod q')
  have hg : Function.Injective g := by
    intro k₁ k₂ h
    exact injective_residues_on_block hq' x n₀ k₁ k₂ h
  have hcard : Fintype.card (Fin q') = Fintype.card (ZMod q') := by simp
  have hbij := (Fintype.bijective_iff_injective_and_card g).mpr ⟨hg, hcard⟩
  obtain ⟨k, hk⟩ := hbij.2 0
  refine ⟨x + (k.val : ℤ), ?_, ?_⟩
  · rw [Finset.mem_Icc]
    have hk0 : (0 : ℤ) ≤ (k.val : ℤ) := by exact_mod_cast (Nat.zero_le k.val)
    have hklt : (k.val : ℤ) < (q' : ℤ) := by exact_mod_cast k.isLt
    constructor <;> omega
  · have hz : ((x + (k.val : ℤ) - n₀ : ℤ) : ZMod q') = 0 := by
      dsimp [g] at hk
      rw [Int.cast_sub, Int.cast_add]
      exact hk
    have hd := (ZMod.intCast_zmod_eq_zero_iff_dvd (x + (k.val : ℤ) - n₀) q').mp hz
    convert hd using 1

lemma block_decomp_subset {q' N K : ℕ} (_hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (j : Fin K) :
    Finset.Icc (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ))
               (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ) + (q' : ℤ) - 1) ⊆
      Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ) := by
  intro x hx
  rw [Finset.mem_Icc] at hx ⊢
  rcases hx with ⟨hl, hu⟩
  constructor
  · have hprod : 0 ≤ (j.val : ℤ) * (q' : ℤ) := by positivity
    omega
  · have h1 : (j.val + 1) * q' ≤ K * q' := Nat.mul_le_mul_right q' (by omega)
    have hcnt : (j.val + 1) * q' ≤ 2 * N := le_trans h1 hK
    have hsum : (j.val + 1) * q' = j.val * q' + q' := by ring
    have hcnt2 : j.val * q' + q' ≤ 2 * N := by
      rw [← hsum]
      exact hcnt
    have hcast : (((j.val * q' + q' : ℕ) : ℤ)) ≤ ((2 * N : ℕ) : ℤ) := by
      exact_mod_cast hcnt2
    omega

/-- Each `Fin K` block (for `K·q′ ≤ 2N`) contains a point of the coset inside `[-N, N]`. -/
lemma block_coset_point {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    ∃ m : ℤ, m ∈ Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ) ∧ ((q' : ℕ) : ℤ) ∣ m - n₀ := by
  obtain ⟨m, hmI, hd⟩ := exists_mem_Icc_of_coset hq'
    (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ)) n₀
  refine ⟨m, block_decomp_subset hq' hK j hmI, hd⟩


/-- Two disjoint `q′`-blocks indexed by `u < v` are separated in the natural order. -/
lemma block_separated_nat {q' u v : ℕ} (hq' : 0 < q') (huv : u < v) :
    (u + 1) * q' - 1 < v * q' := by
  have h1 : (u + 1) * q' ≤ v * q' := Nat.mul_le_mul_right q' (by omega)
  have hpos : 0 < (u + 1) * q' := Nat.mul_pos (by omega) hq'
  omega


/-- Choice of one coset point inside block `j` (as an integer). -/
def blockSel {q' N K : ℕ} (hq' : 0 < q') (_hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) : ℤ :=
  Classical.choose (exists_mem_Icc_of_coset hq' (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ)) n₀)

/-- `blockSel` lies in its own block. -/
lemma blockSel_mem_block {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    blockSel hq' hK n₀ j ∈
      Finset.Icc (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ))
        (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ) + (q' : ℤ) - 1) := by
  unfold blockSel
  exact (Classical.choose_spec (exists_mem_Icc_of_coset hq'
    (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ)) n₀)).1

/-- `blockSel` is in the coset. -/
lemma blockSel_coset {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    ((q' : ℕ) : ℤ) ∣ blockSel hq' hK n₀ j - n₀ := by
  unfold blockSel
  exact (Classical.choose_spec (exists_mem_Icc_of_coset hq'
    (-(N : ℤ) + (j.val : ℤ) * (q' : ℤ)) n₀)).2

/-- `blockSel` lies in the window `[-N, N]`. -/
lemma blockSel_mem_window {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    blockSel hq' hK n₀ j ∈ Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ) :=
  block_decomp_subset hq' hK j (blockSel_mem_block hq' hK n₀ j)


/-- Cast of Nat subtraction `m-1` to `ℤ` (for `0 < m`). -/
lemma intCast_sub_one {m : ℕ} (hm : 0 < m) : (((m - 1 : ℕ) : ℤ)) = (m : ℤ) - 1 := by
  rw [Nat.cast_sub (by omega : 1 ≤ m)]
  norm_num

/-- Integer separation of blocks `u < v` (translation by `-N` cancels). -/
lemma block_intervals_separated_z {q' N u v : ℕ} (hq' : 0 < q') (huv : u < v) :
    -(N : ℤ) + (((u + 1 : ℕ) : ℤ) * (q' : ℤ)) - 1 <
      -(N : ℤ) + ((v : ℕ) : ℤ) * (q' : ℤ) := by
  rw [← Nat.cast_mul, ← Nat.cast_mul]
  have hnat := block_separated_nat hq' huv
  have hpos : 0 < (u + 1) * q' := Nat.mul_pos (by omega) hq'
  have hcast := intCast_sub_one hpos
  have hz : ((((u + 1) * q' - 1 : ℕ) : ℤ)) < (((v * q' : ℕ) : ℤ)) := by
    exact_mod_cast hnat
  rw [hcast] at hz
  omega

/-- The upper endpoint of block `j`, in `(j+1)·q′` form. -/
lemma blockSel_endpoint_le {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    blockSel hq' hK n₀ j ≤ -(N : ℤ) + (((j.val + 1 : ℕ) : ℤ) * (q' : ℤ)) - 1 := by
  have hm := blockSel_mem_block hq' hK n₀ j
  rw [Finset.mem_Icc] at hm
  have heq : -(N : ℤ) + (j.val : ℤ) * (q' : ℤ) + (q' : ℤ) - 1 =
      -(N : ℤ) + (((j.val + 1 : ℕ) : ℤ) * (q' : ℤ)) - 1 := by
    have hc : (((j.val + 1 : ℕ) : ℤ)) = (j.val : ℤ) + 1 := by
      rw [Nat.cast_add]
      norm_num
    rw [hc]
    ring
  simpa [heq] using hm.2

/-- The lower endpoint of block `j` starts at `blockSel`. -/
lemma blockSel_start_le {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) (j : Fin K) :
    -(N : ℤ) + (j.val : ℤ) * (q' : ℤ) ≤ blockSel hq' hK n₀ j := by
  exact (Finset.mem_Icc.mp (blockSel_mem_block hq' hK n₀ j)).1

/-- Earlier blocks give strictly smaller chosen points. -/
lemma blockSel_lt_of_lt {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) {j₁ j₂ : Fin K} (h : j₁.val < j₂.val) :
    blockSel hq' hK n₀ j₁ < blockSel hq' hK n₀ j₂ := by
  exact lt_of_le_of_lt (blockSel_endpoint_le hq' hK n₀ j₁)
    (lt_of_lt_of_le (block_intervals_separated_z hq' h) (blockSel_start_le hq' hK n₀ j₂))


/-- `blockSel` is injective on `Fin K`. -/
lemma blockSel_injective {q' N K : ℕ} (hq' : 0 < q') (hK : K * q' ≤ 2 * N)
    (n₀ : ℤ) : Function.Injective (fun j : Fin K => blockSel hq' hK n₀ j) := by
  intro j₁ j₂ h
  by_cases hlt : j₁.val < j₂.val
  · exfalso
    exact (ne_of_lt (blockSel_lt_of_lt hq' hK n₀ hlt)) h
  · have hle : j₂.val ≤ j₁.val := le_of_not_gt hlt
    by_cases hlt2 : j₂.val < j₁.val
    · exfalso
      exact (ne_of_lt (blockSel_lt_of_lt hq' hK n₀ hlt2)) h.symm
    · have : j₂.val = j₁.val := le_antisymm hle (le_of_not_gt hlt2)
      exact Fin.ext this.symm

/-- Lower bound: the coset `n₀ + q′·ℤ` contributes at least `(2N)/q′ - 1` points to
`[-N, N]` (for `2N ≥ q′`). -/
theorem intervalCount_lower_bound {q' : ℕ} (hq' : 0 < q') (n₀ : ℤ) (N : ℕ)
    (_hN : q' ≤ 2 * N) : (2 * N) / q' - 1 ≤ intervalCount q' n₀ N := by
  let K : ℕ := (2 * N) / q'
  have hKle : K * q' ≤ 2 * N := by
    dsimp [K]
    exact Nat.div_mul_le_self (2 * N) q'
  have hinj : Function.Injective (fun j : Fin K => blockSel hq' hKle n₀ j) :=
    blockSel_injective hq' hKle n₀
  let counted : Finset ℤ := (Finset.Icc (-(N : ℤ)) ((N : ℕ) : ℤ)).filter
    (fun n : ℤ => ((q' : ℕ) : ℤ) ∣ n - n₀)
  have himg : (Finset.univ.image (fun j : Fin K => blockSel hq' hKle n₀ j)) ⊆ counted := by
    intro x hx
    rw [Finset.mem_image] at hx
    rcases hx with ⟨j, _hj, rfl⟩
    rw [Finset.mem_filter]
    exact ⟨blockSel_mem_window hq' hKle n₀ j, blockSel_coset hq' hKle n₀ j⟩
  have hcard : (Finset.univ.image (fun j : Fin K => blockSel hq' hKle n₀ j)).card = K := by
    rw [Finset.card_image_of_injective _ hinj]
    simp [K]
  have hKleCount : K ≤ counted.card := by
    calc
      K = (Finset.univ.image (fun j : Fin K => blockSel hq' hKle n₀ j)).card := hcard.symm
      _ ≤ counted.card := Finset.card_le_card himg
  have hid : counted.card = intervalCount q' n₀ N := by
    dsimp [counted, intervalCount]
  rw [hid] at hKleCount
  dsimp [K] at hKleCount
  omega
attribute [local instance] Classical.propDecidable

/-! ## Sudoku invariances (paper Proposition 7.7)

Affine reparametrization of the columns, reflection of the row index, and
multiplication by an odd scalar all send Sudoku solutions to Sudoku solutions.  The
row helpers `rowVal` (1-based row as an integer) and `reflectRow` are used by the
reflection statement and by the later shearing/normal-form machinery. -/

/-- 1-based row index as an integer. -/
def rowVal {N : ℕ} (n : Fin N) : ℤ := ((n.val : ℕ) + 1 : ℤ)

/-- Reflection of a row: 1-based `r ↦ N+1-r`. -/
def reflectRow {N : ℕ} (n : Fin N) : Fin N :=
  ⟨N - 1 - n.val, by
    have hn : n.val < N := n.isLt
    omega⟩

lemma rowVal_reflect {N : ℕ} (n : Fin N) :
    rowVal (reflectRow n) = ((N : ℤ) + 1) - rowVal n := by
  have hN : 1 ≤ N := by
    by_contra h
    have hN0 : N = 0 := by omega
    subst N
    have : n.val < 0 := n.isLt
    omega
  have hle : n.val ≤ N - 1 := by
    have : n.val < N := n.isLt
    omega
  have hcastN1 : (((N - 1 - n.val : ℕ) : ℤ)) = (N : ℤ) - 1 - (n.val : ℤ) := by
    rw [Nat.cast_sub hle]
    rw [show ((N - 1 : ℕ) : ℤ) = (N : ℤ) - 1 by
      have hNsub : (N - 1) + 1 = N := Nat.sub_add_cancel hN
      have hz : (((N - 1 + 1 : ℕ) : ℤ)) = (N : ℤ) := by rw [hNsub]
      have hz' : ((N - 1 : ℕ) : ℤ) + 1 = (N : ℤ) := by
        simpa [Nat.cast_add] using hz
      omega]
  calc
    rowVal (reflectRow n) = ((N - 1 - n.val : ℕ) : ℤ) + 1 := by
      dsimp [rowVal, reflectRow]
    _ = ((N : ℤ) - 1 - (n.val : ℤ)) + 1 := by
      rw [hcastN1]
    _ = ((N : ℤ) + 1) - rowVal n := by
      dsimp [rowVal]
      ring

lemma rowVal_reflect' {N : ℕ} (n : Fin N) :
    rowVal n = ((N : ℤ) + 1) - rowVal (reflectRow n) := by
  have h := rowVal_reflect n
  omega

/-- `Scal` membership is preserved under reflecting the row index. -/
lemma InScal_reflect {q N : ℕ} {g : Fin N → ZMod q} (hg : InScal_q q N g) :
    InScal_q q N (fun n => g (reflectRow n)) := by
  rcases hg with ⟨a, b, c, hc, hg⟩
  refine ⟨-a, a * ((N : ℤ) + 1) + b, c, hc, ?_⟩
  intro n
  calc
    g (reflectRow n) = (c : ZMod q) * fq q (a * rowVal (reflectRow n) + b) := hg (reflectRow n)
    _ = (c : ZMod q) * fq q (a * (((N : ℤ) + 1) - rowVal n) + b) := by
      rw [rowVal_reflect n]
    _ = (c : ZMod q) * fq q ((-a) * rowVal n + (a * ((N : ℤ) + 1) + b)) := by
      congr 1
      ring

/-- Multiplication of a `Scal` element by an odd scalar stays in `Scal`. -/
lemma InScal_mul_odd {q N : ℕ} {c : ℤ} (hc : Odd c) {g : Fin N → ZMod q}
    (hg : InScal_q q N g) :
    InScal_q q N (fun n => (c : ZMod q) * g n) := by
  rcases hg with ⟨a, b, c0, hc0, hg⟩
  refine ⟨a, b, c * c0, hc.mul hc0, ?_⟩
  intro n
  calc
    (c : ZMod q) * g n = (c : ZMod q) * ((c0 : ZMod q) * fq q (a * rowVal n + b)) := by
      rw [hg n]
      rfl
    _ = ((c * c0 : ℤ) : ZMod q) * fq q (a * rowVal n + b) := by
      simp [Int.cast_mul]
      ring
    _ = ((c * c0 : ℤ) : ZMod q) * fq q (a * ((n.val : ℕ) + 1 : ℤ) + b) := rfl

/-- (i) Affine invariance: any integer-affine reparametrization of the columns of a
Sudoku solution is a Sudoku solution. -/
lemma IsSudokuSolution.affine {q N : ℕ} (F : SudokuBoard q N) (hF : IsSudokuSolution q N F)
    (A B C : ℤ) :
    IsSudokuSolution q N (fun n m => F n (A * m + B * rowVal n + C)) := by
  constructor
  · intro n m
    exact hF.1 n (A * m + B * rowVal n + C)
  · intro i j
    have heq : lineRestrict (q := q) (N := N) (fun n m => F n (A * m + B * rowVal n + C)) i j =
        lineRestrict F (A * i + C) (A * j + B) := by
      funext n
      change F n (A * (j * rowVal n + i) + B * rowVal n + C) =
        F n ((A * j + B) * rowVal n + (A * i + C))
      congr 1
      ring
    rw [heq]
    exact hF.2 (A * i + C) (A * j + B)

/-- (ii) Reflection symmetry in the row index. -/
lemma IsSudokuSolution.reflection {q N : ℕ} (F : SudokuBoard q N)
    (hF : IsSudokuSolution q N F) :
    IsSudokuSolution q N (fun n m => F (reflectRow n) m) := by
  constructor
  · intro n m
    exact hF.1 (reflectRow n) m
  · intro i j
    let c : ℤ := j * ((N : ℤ) + 1) + i
    have hval : ∀ n : Fin N,
        F (reflectRow n) (j * rowVal n + i) =
          F (reflectRow n) ((-j) * rowVal (reflectRow n) + c) := by
      intro n
      congr 1
      rw [rowVal_reflect' n]
      dsimp [c]
      ring
    have heq : lineRestrict (q := q) (N := N) (fun n m => F (reflectRow n) m) i j =
        (fun n : Fin N => lineRestrict F c (-j) (reflectRow n)) := by
      funext n
      change F (reflectRow n) (j * rowVal n + i) =
        F (reflectRow n) ((-j) * rowVal (reflectRow n) + c)
      exact hval n
    rw [heq]
    exact InScal_reflect (hF.2 c (-j))

/-- (iii) Homogeneity: multiplication of a Sudoku solution (with `q = 2^t`, `t ≥ 1`) by
an odd scalar. -/
lemma IsSudokuSolution.homogeneity {t N : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (c : ℤ) (hc : Odd c) :
    IsSudokuSolution (2 ^ t) N (fun n m => (c : ZMod (2 ^ t)) * F n m) := by
  constructor
  · intro n m hz
    have hpow : ∃ s : ℕ, 2 ^ t = 2 ^ (s + 1) := by
      refine ⟨t - 1, ?_⟩
      congr 1
      omega
    have hu : IsUnit (c : ZMod (2 ^ t)) :=
      zmod_isUnit_of_odd (Int.natAbs_odd.mpr hc) hpow
    rcases hu with ⟨u, hu⟩
    have hx : F n m = 0 := by
      have hinv : (((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * (u : ZMod (2 ^ t))) = 1 := by
        simpa using congrArg (fun x : (ZMod (2 ^ t))ˣ => (x : ZMod (2 ^ t)))
          (Units.inv_mul u)
      have hmul : ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((c : ZMod (2 ^ t)) * F n m) =
          F n m := by
        calc
          ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((c : ZMod (2 ^ t)) * F n m)
              = ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((u : ZMod (2 ^ t)) * F n m) := by
                  rw [hu]
          _ = (((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * (u : ZMod (2 ^ t))) * F n m := by ring
          _ = F n m := by rw [hinv]; simp
      rw [← hmul]
      simp [hz]
    exact hF.1 n m hx
  · intro i j
    have heq : lineRestrict (q := 2 ^ t) (N := N) (fun n m => (c : ZMod (2 ^ t)) * F n m) i j =
        (fun n : Fin N => (c : ZMod (2 ^ t)) * lineRestrict F i j n) := by
      funext n
      change (c : ZMod (2 ^ t)) * F n (j * rowVal n + i) =
        (c : ZMod (2 ^ t)) * F n (j * rowVal n + i)
      rfl
    rw [heq]
    exact InScal_mul_odd (q := 2 ^ t) (N := N) hc (hF.2 i j)


end

end Commons.PeriodicTiling


/-!
# Statistics of a 2-adically structured function (Lemma "stats", arXiv:2211.15847 §9)

Lemma "stats" (tex 1204-1227) attaches to every element `g ∈ Scal_q[N]` (i.e. every
finite sequence of the form `g(n) = c·f_q(a·n+b)`, `c` odd, on rows `n = 1..N`) its
*order*, *step*, *bad coset* and *associated affine function*, with the axioms:

  (i)   `α_g` is a non-trivial affine function `n ↦ s_g·n + c_g`;
  (ii)  the bad coset `Γ_g = {n : α_g(n) = 0}` is empty or a coset of `2^{-ord}·q·ℤ`
        (structure and density established in `sudoku_framework`:
        `stats_ii_of_coefficient`, `badCoset_*`, `intervalCount_*`);
  (iii) `g(n) = α_g(n)` whenever `α_g(n) ≠ 0`;
  (iv)  one can represent `g(n) = f_q(a·n+b)` with `α_g(n) = a·n+b mod q`.

This file supplies the parts of (iii) and (iv) that the later rigidity results
(Propositions "rigid-out" and "n8", tex 1227-1275) invoke at the level of the finite
rows `Fin N` of the Sudoku framework: a row sequence whose values are `c·f_q(a·x+b)`
(`x = n.val+1`) agrees with the affine function `c·(a·x+b) mod q` at every position
whose argument is *not* a multiple of `q` (i.e. outside the bad coset), and the odd
factor `c` can be absorbed into the argument on any window that avoids the bad coset.
The order/step packaging (2-adic content of `a` etc.) is supplied by
`sudoku_framework.stats_ii_of_coefficient` and its lemmas.
-/

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

/-- `2^t > 1` whenever `t ≥ 1`. -/
lemma two_pow_gt_one {t : ℕ} (ht : 1 ≤ t) : 1 < 2 ^ t := by
  have hpow : 2 * 2 ^ (t - 1) = 2 ^ t := by
    rw [show t = 1 + (t - 1) by omega, pow_add]
    norm_num
  have hpos : 0 < 2 ^ (t - 1) := pow_pos (by norm_num : 0 < (2 : ℕ)) (t - 1)
  have h1 : 1 ≤ 2 ^ (t - 1) := by omega
  calc
    1 < 2 * 1 := by norm_num
    _ ≤ 2 * 2 ^ (t - 1) := Nat.mul_le_mul_left 2 h1
    _ = 2 ^ t := hpow

/-- Lemma "stats" (iii): a `Scal`-type row sequence with odd rescaling `c` agrees with
the affine function `c·(a·n+b) mod q`, `q = 2^t`, at every row `n` whose argument
`a·(n.val+1)+b` is not a multiple of `q` (i.e. every row outside the bad coset). -/
theorem scal_agree_affine {t N : ℕ} (ht : 1 ≤ t) (a b c : ℤ) (hc : Odd c)
    {g : Fin N → ZMod (2 ^ t)}
    (hg : ∀ n : Fin N, g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * ((n.val : ℕ) + 1 : ℤ) + b)) :
    ∀ n : Fin N, ((n.val : ℕ) + 1 : ℤ) ∉ badCoset (2 ^ t) a b →
      g n = (c : ZMod (2 ^ t)) * qAffine (2 ^ t) a b ((n.val : ℕ) + 1 : ℤ) := by
  intro n hn
  let x : ℤ := ((n.val : ℕ) + 1 : ℤ)
  have hq1 : 1 < 2 ^ t := two_pow_gt_one ht
  have hl := qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq1 (a := a) (b := b)
    (n := x) hn
  calc
    g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * x + b) := by simpa [x] using hg n
    _ = (c : ZMod (2 ^ t)) * qLine (2 ^ t) a b x := by rfl
    _ = (c : ZMod (2 ^ t)) * qAffine (2 ^ t) a b x := by rw [hl]

/-- Lemma "stats" (iii) in `InScal_q` form: every `Scal`-type sequence is represented by
coefficients `(a,b,c)` (`c` odd) and agrees with the corresponding affine function
outside the bad coset of those coefficients. -/
theorem inScal_agree_affine {t N : ℕ} (ht : 1 ≤ t) {g : Fin N → ZMod (2 ^ t)}
    (hIn : InScal_q (2 ^ t) N g) :
    ∃ a b c : ℤ, Odd c ∧
      (∀ n : Fin N, g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * ((n.val : ℕ) + 1 : ℤ) + b)) ∧
      ∀ n : Fin N, ((n.val : ℕ) + 1 : ℤ) ∉ badCoset (2 ^ t) a b →
        g n = (c : ZMod (2 ^ t)) * qAffine (2 ^ t) a b ((n.val : ℕ) + 1 : ℤ) := by
  rcases hIn with ⟨a, b, c, hc, hg⟩
  refine ⟨a, b, c, hc, hg, scal_agree_affine ht a b c hc hg⟩

/-- Lemma "stats" (iv), normalization step: over a window on which the argument
`a·n+b` never vanishes, the odd rescaling factor `c` can be absorbed, and the sequence
equals `f_q((c·a)·n + c·b)` (multiplicativity of `f_q` under odd multipliers). -/
lemma scal_absorb_c {t N : ℕ} (ht : 1 ≤ t) (a b c : ℤ) (hc : Odd c)
    {g : Fin N → ZMod (2 ^ t)}
    (hg : ∀ n : Fin N, g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * ((n.val : ℕ) + 1 : ℤ) + b)) :
    ∀ n : Fin N, a * ((n.val : ℕ) + 1 : ℤ) + b ≠ 0 →
      g n = fq (2 ^ t) ((c * a) * ((n.val : ℕ) + 1 : ℤ) + c * b) := by
  intro n hx
  let x : ℤ := ((n.val : ℕ) + 1 : ℤ)
  have hq1 : 1 < 2 ^ t := two_pow_gt_one ht
  have hqpow : ∃ s : ℕ, (2 ^ t : ℕ) = 2 ^ (s + 1) := by
    refine ⟨t - 1, ?_⟩
    congr 1
    omega
  have hmul := fq_mul_odd (q := 2 ^ t) hq1 c (a * x + b) hc hqpow (by simpa [x] using hx)
  calc
    g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * x + b) := by simpa [x] using hg n
    _ = fq (2 ^ t) (c * (a * x + b)) := by rw [hmul]
    _ = fq (2 ^ t) ((c * a) * x + c * b) := by
        congr 1
        ring


/-! ## The packaged statistics (order / step / bad coset / affine function)

The structure `ScalLineStats` is the API that Propositions "rigid-out" and "n8"
(tex 1227-1275) will `rcases`.  It attaches to the whole-line structured function
`x ↦ f_q(a·x + b)` (`q = 2^t`), for a *reduced* coefficient pair `(a,b)` (not both
divisible by `q` — Lemma "stats"' proof reduces any Scal element to this, absorbing
`c` via `scal_absorb_c`), the paper's order / step / bad coset / affine data:

  * `orderInf` and `ord`: `orderInf` records `ord_g = −∞`, equivalently `Γ_g = ∅`;
    otherwise `ord` is the finite order (the number of factors of two in `a`);
  * `step = a mod q`, `affine x = a·x + b mod q`, `badCoset` = zero set of `affine`;
  * axioms (i)-(iii): on the finite-order branch the bad coset is empty or a single
    coset of `2^{t-ord}·ℤ`, and the structured function agrees with `affine` wherever
    `affine ≠ 0`.
-/

/-- The statistics attached to a reduced pair `(a,b)` (Lemma "stats"). -/
structure ScalLineStats {t : ℕ} where
  a : ℤ
  b : ℤ
  ord : ℕ
  step : ZMod (2 ^ t)
  affine : ℤ → ZMod (2 ^ t)
  badCoset : Set ℤ
  orderInf : Prop
  hstep : step = (a : ZMod (2 ^ t))
  haffine : ∀ x : ℤ, affine x = qAffine (2 ^ t) a b x
  hbad : badCoset = {x : ℤ | qAffine (2 ^ t) a b x = 0}
  hagree : ∀ x : ℤ, x ∉ badCoset → qLine (2 ^ t) a b x = qAffine (2 ^ t) a b x
  horderInf : orderInf ↔ badCoset = ∅
  hord_lt : ¬ orderInf → ord < t
  hfactor : ¬ orderInf → ∃ a' : ℤ, a = (((2 ^ ord : ℕ) : ℤ) * a') ∧ Odd a'
  hcoset : ¬ orderInf → badCoset = ∅ ∨
      ∃ n₀ : ℤ, badCoset = {x : ℤ | (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀)}

/-- From `Odd n.natAbs` to `Odd n`. -/
lemma odd_int_of_odd_natAbs {n : ℤ} (h : Odd n.natAbs) : Odd n :=
  (Int.natAbs_odd).mp h

/-- If the bad coset (for modulus `q = 2^t`) is empty, no argument `a·x + b` is a
multiple of `q`. -/
lemma badCoset_empty_not_dvd {t : ℕ} {a b x : ℤ}
    (hΓ : badCoset (2 ^ t) a b = ∅) : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
  intro hd
  have hmem : x ∈ badCoset (2 ^ t) a b := by
    unfold badCoset
    exact (qAffine_zero_iff_int_dvd (q := 2 ^ t) a b x).mpr hd
  rw [hΓ] at hmem
  exact hmem

/-- If `a ≡ 0 (mod q)` but `b ≢ 0 (mod q)`, no argument `a·x+b` is divisible by `q`. -/
lemma not_dvd_affine_of_coeff_zero {t : ℕ} {a b x : ℤ}
    (ha : ((2 ^ t : ℕ) : ℤ) ∣ a) (hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b) :
    ¬ ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
  intro h
  have hax : ((2 ^ t : ℕ) : ℤ) ∣ a * x := by
    rcases ha with ⟨ka, hka⟩
    refine ⟨ka * x, ?_⟩
    rw [hka]
    ring
  have hb' : ((2 ^ t : ℕ) : ℤ) ∣ b := by
    rw [show b = (a * x + b) - a * x by ring]
    exact dvd_sub h hax
  exact hb hb'

/-- The `2`-adic order of a coefficient not divisible by `q = 2^t` is `< t`. -/
lemma twoAdicOrder_lt_of_not_dvd {t : ℕ} {a : ℤ} (ha : a ≠ 0)
    (hd : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a)) : twoAdicOrder a < t := by
  by_contra hnot
  have ht_le : t ≤ twoAdicOrder a := by omega
  obtain ⟨a', hfac, _hodd⟩ := int_two_power_factorization a ha
  rcases Nat.exists_eq_add_of_le ht_le with ⟨k, hk⟩
  have hval : twoAdicOrder a = t + k := hk
  refine hd ⟨((2 ^ k : ℕ) : ℤ) * a', ?_⟩
  calc
    a = (((2 ^ twoAdicOrder a : ℕ) : ℤ) * a') := by simpa [twoAdicOrder] using hfac
    _ = (((2 ^ (t + k) : ℕ) : ℤ) * a') := by rw [hval]
    _ = ((2 ^ t : ℕ) : ℤ) * (((2 ^ k : ℕ) : ℤ) * a') := by
        have hp : (((2 ^ (t + k) : ℕ) : ℤ)) = (((2 ^ t : ℕ) : ℤ) * ((2 ^ k : ℕ) : ℤ)) := by
          rw [← Nat.cast_mul]
          congr 1
          exact (pow_add (2 : ℕ) t k)
        calc
          (((2 ^ (t + k) : ℕ) : ℤ) * a') = (((2 ^ t : ℕ) : ℤ) * ((2 ^ k : ℕ) : ℤ)) * a' := by rw [hp]
          _ = ((2 ^ t : ℕ) : ℤ) * (((2 ^ k : ℕ) : ℤ) * a') := by ring

/-- Every reduced coefficient pair `(a,b)` carries the statistics of Lemma "stats":
an order (possibly the infinite order `−∞`, recorded by `orderInf`), step, bad coset and
associated affine function with the axioms (i)-(iii) of Lemma "stats".  This is the
statement Proposition "n8" uses verbatim (well-definedness of the statistics). -/
theorem scal_line_stats_exists {t : ℕ} (ht : 1 ≤ t) (a b : ℤ)
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b)) :
    ∃ S : ScalLineStats (t := t), S.a = a ∧ S.b = b := by
  classical
  have hq1 : 1 < 2 ^ t := two_pow_gt_one ht
  by_cases hΓ : badCoset (2 ^ t) a b = ∅
  · -- order −∞ branch (bad coset empty: the function is affine everywhere)
    have hagree_p : ∀ x : ℤ, x ∉ {x : ℤ | qAffine (2 ^ t) a b x = 0} →
        qLine (2 ^ t) a b x = qAffine (2 ^ t) a b x := by
      intro x hx
      have hnd : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a * x + b :=
        badCoset_empty_not_dvd (t := t) (a := a) (b := b) (x := x) hΓ
      have hfq := fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 hnd
      calc
        qLine (2 ^ t) a b x = fq (2 ^ t) (a * x + b) := rfl
        _ = ((a * x + b : ℤ) : ZMod (2 ^ t)) := hfq
        _ = qAffine (2 ^ t) a b x := by
            rw [qAffine]
            rw [intCast_zmod_of_add_mul (2 ^ t) a b x]
    have hinf_p : True ↔ {x : ℤ | qAffine (2 ^ t) a b x = 0} = ∅ := by
      constructor
      · intro _hT
        simpa [badCoset] using hΓ
      · intro _h0
        trivial
    refine ⟨ScalLineStats.mk a b 0 (a : ZMod (2 ^ t)) (qAffine (2 ^ t) a b)
      {x : ℤ | qAffine (2 ^ t) a b x = 0} True rfl (fun _ => rfl) rfl
      hagree_p hinf_p (fun hT => False.elim (hT trivial))
      (fun hT => False.elim (hT trivial)) (fun hT => False.elim (hT trivial)),
      ⟨rfl, rfl⟩⟩
  · -- finite order branch (bad coset nonempty)
    have hqa : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a := by
      intro hqa
      have hqb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b := by
        intro hb
        exact hred ⟨hqa, hb⟩
      have hΓempty : badCoset (2 ^ t) a b = ∅ := by
        ext x
        constructor
        · intro hx
          have ha0 : (a : ZMod (2 ^ t)) = 0 :=
            (ZMod.intCast_zmod_eq_zero_iff_dvd a (2 ^ t)).mpr hqa
          have hb0 : (b : ZMod (2 ^ t)) ≠ 0 := by
            intro hz
            exact hqb ((ZMod.intCast_zmod_eq_zero_iff_dvd b (2 ^ t)).mp hz)
          unfold badCoset at hx
          unfold qAffine at hx
          have hx0 : (b : ZMod (2 ^ t)) = 0 := by
            rw [ha0] at hx
            simpa using hx
          exact hb0 hx0
        · intro hx
          exact False.elim hx
      exact hΓ hΓempty
    have ha0 : a ≠ 0 := by
      intro hz
      subst a
      exact hqa (by exact dvd_zero ((2 ^ t : ℕ) : ℤ))
    let ord0 : ℕ := twoAdicOrder a
    have hord0_lt : ord0 < t := by
      dsimp [ord0]
      exact twoAdicOrder_lt_of_not_dvd (t := t) ha0 hqa
    have hfactor0 : ∃ a' : ℤ, a = (((2 ^ ord0 : ℕ) : ℤ) * a') ∧ Odd a' := by
      rcases int_two_power_factorization a ha0 with ⟨a', heq, hodd_na⟩
      refine ⟨a', ?_, odd_int_of_odd_natAbs hodd_na⟩
      dsimp [ord0]
      simpa [twoAdicOrder] using heq
    let q' : ℕ := 2 ^ (t - ord0)
    have hq'pow : ∃ s : ℕ, q' = 2 ^ (s + 1) := by
      refine ⟨t - ord0 - 1, ?_⟩
      dsimp [q']
      congr 1
      omega
    have hstat := stats_ii_of_coefficient (ord := ord0) (q' := q') (a := a) (b := b)
      ha0 (by rfl) hq'pow
    rcases hstat with ⟨a'', _hfac2, _hunit, hdich⟩
    have hmod : ((2 ^ ord0 : ℕ) * q') = 2 ^ t := by
      dsimp [q']
      rw [← pow_add]
      congr 1
      omega
    have hdich' : badCoset (2 ^ t) a b = ∅ ∨
        ∃ n₀ : ℤ, badCoset (2 ^ t) a b = {x : ℤ | ((q' : ℕ) : ℤ) ∣ x - n₀} := by
      simpa [hmod] using hdich
    rcases hdich' with hE | ⟨n₀, hC⟩
    · exact False.elim (hΓ hE)
    · have hagree_p : ∀ x : ℤ, x ∉ {x : ℤ | qAffine (2 ^ t) a b x = 0} →
          qLine (2 ^ t) a b x = qAffine (2 ^ t) a b x := by
        intro x hx
        exact qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq1 (a := a) (b := b)
          (n := x) (by simpa [badCoset] using hx)
      have hinf_p : False ↔ {x : ℤ | qAffine (2 ^ t) a b x = 0} = ∅ := by
        constructor
        · intro hf
          exact False.elim hf
        · intro h0
          exact hΓ (by simpa [badCoset] using h0)
      have hcoset_p : ¬ False → {x : ℤ | qAffine (2 ^ t) a b x = 0} = ∅ ∨
          ∃ n₀ : ℤ, {x : ℤ | qAffine (2 ^ t) a b x = 0} =
            {x : ℤ | (((2 ^ (t - ord0) : ℕ) : ℤ) ∣ x - n₀)} := by
        intro _hf
        refine Or.inr ⟨n₀, ?_⟩
        have hC' : {x : ℤ | qAffine (2 ^ t) a b x = 0} =
            {x : ℤ | ((q' : ℕ) : ℤ) ∣ x - n₀} := by
          simpa [badCoset] using hC
        simpa [q'] using hC'
      refine ⟨ScalLineStats.mk a b ord0 (a : ZMod (2 ^ t)) (qAffine (2 ^ t) a b)
        {x : ℤ | qAffine (2 ^ t) a b x = 0} False rfl (fun _ => rfl) rfl
        hagree_p hinf_p (fun _hf => hord0_lt) (fun _hf => hfactor0) hcoset_p,
        ⟨rfl, rfl⟩⟩

/-! ## Affine two-point rigidity over `ZMod (2^t)` (whole-`ℤ` `qAffine` functions)

Lemma (B) of the rigid-out plan: an affine function (over `ℤ`, values in `ZMod (2^t)`)
that vanishes at two points whose difference is odd is identically zero — every odd
integer is invertible mod `2^t` (`zmod_mul_odd_eq_zero`).  The companion even-gap lemma
turns two zeros at distance two into vanishing on the whole parity class.  These give
the "affine functions agree at an odd-separated pair ⇒ equal everywhere" and
"affine functions agree on one parity class" tools used by Proposition "rigid-out"
(tex 1227-1263), and they lift `sudoku_concat.affineOn_zero_of_odd_gap` from windows to
whole-line `qAffine` functions.
-/

/-- Difference of two affine functions is affine: `qAffine a b − qAffine A B =
qAffine (a−A) (b−B)`. -/
lemma qAffine_sub (q : ℕ) (a b A B z : ℤ) :
    qAffine q a b z - qAffine q A B z = qAffine q (a - A) (b - B) z := by
  unfold qAffine
  rw [show ((a - A : ℤ) : ZMod q) = (a : ZMod q) - (A : ZMod q) by rw [Int.cast_sub]]
  rw [show ((b - B : ℤ) : ZMod q) = (b : ZMod q) - (B : ZMod q) by rw [Int.cast_sub]]
  ring

/-- An affine function vanishing at two points with odd difference is identically zero
(Lemma (B)). -/
lemma qAffine_zero_of_odd_gap {t : ℕ} (ht : 1 ≤ t) (a0 b0 : ℤ) {x y : ℤ}
    (hodd : Odd (y - x))
    (hx : qAffine (2 ^ t) a0 b0 x = 0) (hy : qAffine (2 ^ t) a0 b0 y = 0) :
    ∀ z : ℤ, qAffine (2 ^ t) a0 b0 z = 0 := by
  let s : ZMod (2 ^ t) := (a0 : ZMod (2 ^ t))
  let c : ZMod (2 ^ t) := (b0 : ZMod (2 ^ t))
  have hx' : s * (x : ZMod (2 ^ t)) + c = 0 := by
    dsimp [s, c]
    simpa [qAffine] using hx
  have hy' : s * (y : ZMod (2 ^ t)) + c = 0 := by
    dsimp [s, c]
    simpa [qAffine] using hy
  have heq : s * (y : ZMod (2 ^ t)) = s * (x : ZMod (2 ^ t)) := by
    exact add_right_cancel (a := s * (y : ZMod (2 ^ t))) (b := c) (by rw [hy', hx'])
  have hd : s * ((y - x : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hsub : s * ((y : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr heq
    simpa [Int.cast_sub] using hsub
  have hs0 : s = 0 := by
    have hpow : ∃ s0 : ℕ, (2 ^ t : ℕ) = 2 ^ (s0 + 1) := by
      refine ⟨t - 1, ?_⟩
      congr 1
      omega
    have hu : IsUnit ((y - x : ℤ) : ZMod (2 ^ t)) :=
      zmod_isUnit_of_odd (Int.natAbs_odd.mpr hodd) hpow
    rcases hu with ⟨u, hu_val⟩
    have hsu : s * (↑u : ZMod (2 ^ t)) = 0 := by
      rwa [← hu_val] at hd
    have huinv : (↑(u⁻¹) : ZMod (2 ^ t)) * (↑u : ZMod (2 ^ t)) = 1 := by
      rw [← Units.val_mul]
      simp
    calc
      s = s * (1 : ZMod (2 ^ t)) := by rw [mul_one]
      _ = s * ((↑(u⁻¹) : ZMod (2 ^ t)) * (↑u : ZMod (2 ^ t))) := by rw [← huinv]
      _ = (s * (↑u : ZMod (2 ^ t))) * (↑(u⁻¹) : ZMod (2 ^ t)) := by ring
      _ = 0 * (↑(u⁻¹) : ZMod (2 ^ t)) := by rw [hsu]
      _ = 0 := by simp
  have hc0 : c = 0 := by
    have := hx'
    rw [hs0, zero_mul, zero_add] at this
    exact this
  intro z
  calc
    qAffine (2 ^ t) a0 b0 z = s * (z : ZMod (2 ^ t)) + c := by
        dsimp [s, c]
        simp [qAffine]
    _ = 0 := by rw [hs0, hc0]; simp

/-- An affine function vanishing at `x` and `x + 2` vanishes on the whole parity class
of `x`. -/
lemma qAffine_zero_of_even_gap {t : ℕ} (ht : 1 ≤ t) (a0 b0 : ℤ) (x : ℤ)
    (hx : qAffine (2 ^ t) a0 b0 x = 0) (hx2 : qAffine (2 ^ t) a0 b0 (x + 2) = 0) :
    ∀ z : ℤ, Even (z - x) → qAffine (2 ^ t) a0 b0 z = 0 := by
  intro z hz
  rcases hz with ⟨k, hk⟩
  let s : ZMod (2 ^ t) := (a0 : ZMod (2 ^ t))
  let c : ZMod (2 ^ t) := (b0 : ZMod (2 ^ t))
  have hx' : s * (x : ZMod (2 ^ t)) + c = 0 := by
    dsimp [s, c]
    simpa [qAffine] using hx
  have hx2' : s * ((x + 2 : ℤ) : ZMod (2 ^ t)) + c = 0 := by
    dsimp [s, c]
    simpa [qAffine] using hx2
  have heq : s * ((x + 2 : ℤ) : ZMod (2 ^ t)) = s * (x : ZMod (2 ^ t)) := by
    exact add_right_cancel (a := s * ((x + 2 : ℤ) : ZMod (2 ^ t))) (b := c) (by rw [hx2', hx'])
  have hs2 : s * ((2 : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hsub : s * (((x + 2 : ℤ) : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr heq
    have hcast : (((x + 2 : ℤ) : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = (2 : ZMod (2 ^ t)) := by
      norm_num [Int.cast_add]
    simpa [hcast] using hsub
  -- z = x + 2k
  have hk' : (z : ZMod (2 ^ t)) = (x : ZMod (2 ^ t)) + (2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) := by
    have hz' : z = x + 2 * k := by
      calc
        z = x + (z - x) := by ring
        _ = x + 2 * k := by rw [hk]; ring
    rw [hz']
    simp [Int.cast_add, Int.cast_mul]
  calc
    qAffine (2 ^ t) a0 b0 z = s * (z : ZMod (2 ^ t)) + c := by
        dsimp [s, c]
        simp [qAffine]
    _ = (s * (x : ZMod (2 ^ t)) + c) + (s * ((2 : ℤ) : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) := by
        rw [hk']
        ring
    _ = 0 := by
        rw [hx', hs2]
        simp


/-! ## Finite-order structure: the bad coset is periodic with step `2^{t-ord}`

Lemma "stats" (ii) says that on the finite-order branch (`S.orderInf = False`) the bad
coset `Γ_g` is empty or a single coset of `2^{t-ord}·ℤ`, where `ord` is the number of
factors of two in `a`, i.e. `a = 2^{ord}·a′` with `a′` odd.  The lemmas below make the
periodicity of the affine data on that coset explicit (`S.hfactor` provides `hfac`):

  * the affine function repeats with period `2^{t-ord}` (`qAffine_add_period`), hence
    membership in its zero set (the bad coset) is period-invariant;
  * away from the bad coset the structured line `qLine a b` also repeats with that
    period (the last nonzero digit of `a·x+b` only changes when `a·x+b ≡ 0 mod 2^t`).

These are the fundamental-domain tools the finite-order branch of "rigid-out" needs.
-/

/-- With `a = 2^{ord}·a′` and `ord ≤ t`, the affine function `x ↦ a·x+b mod 2^t` is
periodic with period `2^{t-ord}`. -/
lemma qAffine_add_period {t ord : ℕ} (a b a' : ℤ) (hfac : a = ((2 ^ ord : ℕ) : ℤ) * a')
    (hord : ord ≤ t) (x : ℤ) :
    qAffine (2 ^ t) a b (x + ((2 ^ (t - ord) : ℕ) : ℤ)) = qAffine (2 ^ t) a b x := by
  have hExp : ord + (t - ord) = t := by omega
  have hpd : a * ((2 ^ (t - ord) : ℕ) : ℤ) = a' * ((2 ^ t : ℕ) : ℤ) := by
    calc
      a * ((2 ^ (t - ord) : ℕ) : ℤ)
          = (((2 ^ ord : ℕ) : ℤ) * a') * ((2 ^ (t - ord) : ℕ) : ℤ) := by rw [hfac]
      _ = a' * (((2 ^ ord : ℕ) : ℤ) * ((2 ^ (t - ord) : ℕ) : ℤ)) := by ring
      _ = a' * (((2 ^ ord * 2 ^ (t - ord) : ℕ) : ℤ)) := by rw [← Int.natCast_mul]
      _ = a' * ((2 ^ t : ℕ) : ℤ) := by
          congr 1
          rw [← pow_add, hExp]
  have hdiv : ((2 ^ t : ℕ) : ℤ) ∣ a * ((2 ^ (t - ord) : ℕ) : ℤ) := by
    rw [hpd]
    exact ⟨a', by ring⟩
  have hzero : (a : ZMod (2 ^ t)) * (((2 ^ (t - ord) : ℕ) : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hz : (((a * ((2 ^ (t - ord) : ℕ) : ℤ) : ℤ)) : ZMod (2 ^ t)) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (a * ((2 ^ (t - ord) : ℕ) : ℤ)) (2 ^ t)).mpr hdiv
    simpa [Int.cast_mul] using hz
  unfold qAffine
  calc
    (a : ZMod (2 ^ t)) * ((x + ((2 ^ (t - ord) : ℕ) : ℤ) : ℤ) : ZMod (2 ^ t)) + (b : ZMod (2 ^ t))
        = (a : ZMod (2 ^ t)) * ((x : ZMod (2 ^ t)) + (((2 ^ (t - ord) : ℕ) : ℤ) : ZMod (2 ^ t))) + (b : ZMod (2 ^ t)) := by
            rw [Int.cast_add]
    _ = (a : ZMod (2 ^ t)) * (x : ZMod (2 ^ t)) + (b : ZMod (2 ^ t)) := by
            rw [mul_add, hzero]
            ring

/-- Membership in the bad coset is invariant under the period `2^{t-ord}`. -/
lemma badCoset_mem_add_period {t ord : ℕ} (a b a' : ℤ) (hfac : a = ((2 ^ ord : ℕ) : ℤ) * a')
    (hord : ord ≤ t) (x : ℤ) :
    x ∈ badCoset (2 ^ t) a b ↔ x + ((2 ^ (t - ord) : ℕ) : ℤ) ∈ badCoset (2 ^ t) a b := by
  unfold badCoset
  change qAffine (2 ^ t) a b x = 0 ↔ qAffine (2 ^ t) a b (x + ((2 ^ (t - ord) : ℕ) : ℤ)) = 0
  rw [qAffine_add_period a b a' hfac hord x]

/-- Away from the bad coset the structured line is periodic with period `2^{t-ord}`. -/
lemma qLine_add_period_of_not_mem_badCoset {t ord : ℕ} (ht : 1 ≤ t) (a b a' : ℤ)
    (hfac : a = ((2 ^ ord : ℕ) : ℤ) * a') (hord : ord ≤ t) (x : ℤ)
    (hx : x ∉ badCoset (2 ^ t) a b) :
    qLine (2 ^ t) a b (x + ((2 ^ (t - ord) : ℕ) : ℤ)) = qLine (2 ^ t) a b x := by
  have hExp : ord + (t - ord) = t := by omega
  have hpd : a * ((2 ^ (t - ord) : ℕ) : ℤ) = a' * ((2 ^ t : ℕ) : ℤ) := by
    calc
      a * ((2 ^ (t - ord) : ℕ) : ℤ)
          = (((2 ^ ord : ℕ) : ℤ) * a') * ((2 ^ (t - ord) : ℕ) : ℤ) := by rw [hfac]
      _ = a' * (((2 ^ ord : ℕ) : ℤ) * ((2 ^ (t - ord) : ℕ) : ℤ)) := by ring
      _ = a' * (((2 ^ ord * 2 ^ (t - ord) : ℕ) : ℤ)) := by rw [← Int.natCast_mul]
      _ = a' * ((2 ^ t : ℕ) : ℤ) := by
          congr 1
          rw [← pow_add, hExp]
  have hnd : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
    intro hd
    have hzero : qAffine (2 ^ t) a b x = 0 := by
      unfold qAffine
      rw [← intCast_zmod_of_add_mul (2 ^ t) a b x]
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd (a * x + b) (2 ^ t)).mpr hd
    exact hx (by simpa [badCoset] using hzero)
  have hshift : a * (x + ((2 ^ (t - ord) : ℕ) : ℤ)) + b = (a * x + b) + a' * ((2 ^ t : ℕ) : ℤ) := by
    calc
      a * (x + ((2 ^ (t - ord) : ℕ) : ℤ)) + b = a * x + a * ((2 ^ (t - ord) : ℕ) : ℤ) + b := by ring
      _ = (a * x + b) + a * ((2 ^ (t - ord) : ℕ) : ℤ) := by ring
      _ = (a * x + b) + a' * ((2 ^ t : ℕ) : ℤ) := by rw [hpd]
  have hnd2 : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a * (x + ((2 ^ (t - ord) : ℕ) : ℤ)) + b := by
    intro hd2
    rw [hshift] at hd2
    have hdivadd : ((2 ^ t : ℕ) : ℤ) ∣ a' * ((2 ^ t : ℕ) : ℤ) := ⟨a', by ring⟩
    have hd : ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
      rw [show a * x + b = (a * x + b + a' * ((2 ^ t : ℕ) : ℤ)) - a' * ((2 ^ t : ℕ) : ℤ) by ring]
      exact dvd_sub hd2 hdivadd
    exact hnd hd
  have h2 : (((2 ^ t : ℕ) : ℤ) : ZMod (2 ^ t)) = 0 :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd ((2 ^ t : ℕ) : ℤ) (2 ^ t)).mpr (dvd_refl ((2 ^ t : ℕ) : ℤ))
  calc
    qLine (2 ^ t) a b (x + ((2 ^ (t - ord) : ℕ) : ℤ))
        = fq (2 ^ t) (a * (x + ((2 ^ (t - ord) : ℕ) : ℤ)) + b) := rfl
    _ = ((a * (x + ((2 ^ (t - ord) : ℕ) : ℤ)) + b : ℤ) : ZMod (2 ^ t)) :=
        fq_eq_self_of_not_dvd_int (q := 2 ^ t) (two_pow_gt_one ht) hnd2
    _ = ((a * x + b : ℤ) : ZMod (2 ^ t)) := by
        rw [hshift]
        have hzero : (((a' * ((2 ^ t : ℕ) : ℤ)) : ℤ) : ZMod (2 ^ t)) = 0 := by
          rw [Int.cast_mul, h2]
          simp
        rw [Int.cast_add]
        rw [hzero]
        simp
    _ = fq (2 ^ t) (a * x + b) := (fq_eq_self_of_not_dvd_int (q := 2 ^ t) (two_pow_gt_one ht) hnd).symm
    _ = qLine (2 ^ t) a b x := rfl

/-! ## Parity of `f_q` values on odd arguments and odd-step progressions

The rigid-out subcase analyses (tex 1227-1263, configurations with `Γ_g` a coset of
`2ℤ` or `4ℤ`) need the following `f_q` evaluation facts: an odd integer argument gives
an odd digit, and along an arithmetic progression with odd step at least one of every two
consecutive values is odd (one of the two arguments is odd, and `q = 2^t` is even, so the
odd argument is not divisible by `q` and `f_q` returns its odd reduction).

Oddness of an element of `ZMod (2^t)` is expressed by the existence of an odd integer
representative; representatives of an element differ by multiples of `2^t` (even), so this
is the usual parity. -/

/-- An element of `ZMod q` has an odd integer representative. -/
def HasOddRep {q : ℕ} (z : ZMod q) : Prop :=
  ∃ r : ℤ, Odd r ∧ (r : ZMod q) = z

/-- An odd integer is not divisible by any power of two. -/
lemma odd_not_dvd_two_pow {t : ℕ} (ht : 1 ≤ t) {n : ℤ} (hn : Odd n) :
    ¬ ((2 ^ t : ℕ) : ℤ) ∣ n := by
  intro hd
  rcases hd with ⟨k, hk⟩
  have h2dvd : (2 : ℤ) ∣ n := by
    rw [hk]
    have hfac : ((2 ^ t : ℕ) : ℤ) = (2 : ℤ) * ((2 ^ (t - 1) : ℕ) : ℤ) := by
      rw [show t = 1 + (t - 1) by omega]
      rw [pow_add]
      norm_num
    rw [hfac]
    exact ⟨((2 ^ (t - 1) : ℕ) : ℤ) * k, by ring⟩
  have hEven : Even n := (even_iff_two_dvd).mpr h2dvd
  exact (Int.not_even_iff_odd.mpr hn) hEven

/-- `f_q` of an odd integer is an odd digit. -/
lemma fq_odd_of_odd_arg {t : ℕ} (ht : 1 ≤ t) (n : ℤ) (hn : Odd n) :
    HasOddRep (fq (2 ^ t) n) := by
  have hq1 : 1 < 2 ^ t := two_pow_gt_one ht
  have hnd : ¬ ((2 ^ t : ℕ) : ℤ) ∣ n := odd_not_dvd_two_pow ht hn
  have hfq := fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 hnd
  exact ⟨n, hn, hfq.symm⟩

/-- Along an arithmetic progression with odd step, at least one of every two consecutive
values of `f_q` is odd (one of the two arguments is odd). -/
lemma fq_step_odd {t : ℕ} (ht : 1 ≤ t) (a' m : ℤ) (ha : Odd a') :
    HasOddRep (fq (2 ^ t) m) ∨ HasOddRep (fq (2 ^ t) (m + a')) := by
  by_cases hm : Odd m
  · exact Or.inl (fq_odd_of_odd_arg ht m hm)
  · right
    have hme : Even m := by
      rcases (Int.even_or_odd m) with hE | hO
      · exact hE
      · exact False.elim (hm hO)
    have hma : Odd (m + a') := by
      rcases hme with ⟨k, hk⟩
      rcases ha with ⟨l, hl⟩
      refine ⟨k + l, ?_⟩
      omega
    exact fq_odd_of_odd_arg ht (m + a') hma

/-- If an affine function vanishes at two points of one parity (distance `2`), then it is
constant on the other parity class.  (Companion of `qAffine_zero_of_even_gap`: the
zero set is a parity class, the complementary parity class carries a constant value.) -/
lemma qAffine_odd_class_const {t : ℕ} (ht : 1 ≤ t) (A B : ℤ) (x : ℤ)
    (hx : qAffine (2 ^ t) A B x = 0) (hx2 : qAffine (2 ^ t) A B (x + 2) = 0) :
    ∀ z : ℤ, ¬ Even (z - x) → qAffine (2 ^ t) A B z = qAffine (2 ^ t) A B (x + 1) := by
  intro z hz
  let s : ZMod (2 ^ t) := (A : ZMod (2 ^ t))
  let c : ZMod (2 ^ t) := (B : ZMod (2 ^ t))
  have hx' : s * (x : ZMod (2 ^ t)) + c = 0 := by
    dsimp [s, c]
    simpa [qAffine] using hx
  have hs2 : s * ((2 : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hx2' : s * ((x + 2 : ℤ) : ZMod (2 ^ t)) + c = 0 := by
      dsimp [s, c]
      simpa [qAffine] using hx2
    have heq : s * ((x + 2 : ℤ) : ZMod (2 ^ t)) = s * (x : ZMod (2 ^ t)) := by
      exact add_right_cancel (a := s * ((x + 2 : ℤ) : ZMod (2 ^ t))) (b := c) (by rw [hx2', hx'])
    have hsub : s * (((x + 2 : ℤ) : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr heq
    have hcast : (((x + 2 : ℤ) : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = (2 : ZMod (2 ^ t)) := by
      norm_num [Int.cast_add]
    simpa [hcast] using hsub
  -- z - (x+1) is even (z and x have opposite parity): write z = x + 1 + 2k
  have hdiff : Even (z - (x + 1)) := by
    -- Odd (z - x) and x+1-x = 1: z-(x+1) = (z-x)-1 even
    have hodd : Odd (z - x) := (Int.not_even_iff_odd.mp hz)
    rcases hodd with ⟨k, hk⟩
    use k
    omega
  rcases hdiff with ⟨k, hk⟩
  have hz' : (z : ZMod (2 ^ t)) = (x + 1 : ZMod (2 ^ t)) + (((2 : ℤ) : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) := by
    have hzint : z = (x + 1) + 2 * k := by
      calc
        z = (x + 1) + (z - (x + 1)) := by ring
        _ = (x + 1) + 2 * k := by rw [hk]; ring
    rw [hzint]
    simp [Int.cast_add, Int.cast_mul]
  calc
    qAffine (2 ^ t) A B z = s * (z : ZMod (2 ^ t)) + c := by
        dsimp [s, c]
        simp [qAffine]
    _ = (s * ((x + 1 : ℤ) : ZMod (2 ^ t)) + c) + (s * ((2 : ℤ) : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) := by
        rw [hz']
        simp [Int.cast_add]
        ring
    _ = qAffine (2 ^ t) A B (x + 1) := by
        have h1 : qAffine (2 ^ t) A B (x + 1) = s * ((x + 1 : ℤ) : ZMod (2 ^ t)) + c := by
          dsimp [s, c]
          simp [qAffine]
        rw [h1]
        rw [hs2]
        ring

/-! ## Sparseness of the zero sets in a window

The covering configurations of Prop "rigid-out"'s Case 2 rest on the fact that each of
the two zero sets `Γ` (zeros of an affine function) and `Γ_g` (a bad coset, empty or a
coset of `2^{t-ord}·ℤ`, `ord < t`) meets any small window in a single parity class:
an odd-separated pair of points of either set would force the whole function to vanish
(`qAffine_zero_of_odd_gap`), resp. would contradict the even spacing of the coset. -/

/-- Two odd-separated zeros of an affine function force it to vanish everywhere. -/
lemma qAffine_zero_odd_gap_all_zero {t : ℕ} (ht : 1 ≤ t) (A B : ℤ)
    (hxy : ∃ x y : ℤ, qAffine (2 ^ t) A B x = 0 ∧ qAffine (2 ^ t) A B y = 0 ∧ Odd (y - x)) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z = 0 := by
  rcases hxy with ⟨x, y, hx, hy, hodd⟩
  exact qAffine_zero_of_odd_gap ht A B hodd hx hy

/-- Any two points of a bad coset of `2^{t-ord}·ℤ` (`ord < t`) have the same parity. -/
lemma badCoset_two_same_parity {t ord : ℕ} (hord : ord < t) (a b n0 : ℤ)
    (hcos : badCoset (2 ^ t) a b = {x : ℤ | ((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n0})
    {x y : ℤ} (hx : x ∈ badCoset (2 ^ t) a b) (hy : y ∈ badCoset (2 ^ t) a b) :
    ¬ Odd (y - x) := by
  intro hodd
  have hx' : ((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n0 := by
    rw [hcos] at hx
    exact hx
  have hy' : ((2 ^ (t - ord) : ℕ) : ℤ) ∣ y - n0 := by
    rw [hcos] at hy
    exact hy
  -- 2 divides both differences (t−ord ≥ 1), so 2 divides their difference y−x
  have ht1 : 1 ≤ t - ord := by omega
  have h2x : (2 : ℤ) ∣ x - n0 := by
    rcases hx' with ⟨k, hk⟩
    have hfac : ((2 ^ (t - ord) : ℕ) : ℤ) = (2 : ℤ) * ((2 ^ (t - ord - 1) : ℕ) : ℤ) := by
      rw [show t - ord = 1 + (t - ord - 1) by omega]
      rw [pow_add]
      norm_num
    rw [hfac] at hk
    refine ⟨((2 ^ (t - ord - 1) : ℕ) : ℤ) * k, ?_⟩
    rw [hk]
    ring
  have h2y : (2 : ℤ) ∣ y - n0 := by
    rcases hy' with ⟨k, hk⟩
    have hfac : ((2 ^ (t - ord) : ℕ) : ℤ) = (2 : ℤ) * ((2 ^ (t - ord - 1) : ℕ) : ℤ) := by
      rw [show t - ord = 1 + (t - ord - 1) by omega]
      rw [pow_add]
      norm_num
    rw [hfac] at hk
    refine ⟨((2 ^ (t - ord - 1) : ℕ) : ℤ) * k, ?_⟩
    rw [hk]
    ring
  have h2diff : (2 : ℤ) ∣ (y - n0) - (x - n0) := dvd_sub h2y h2x
  have hEven : Even (y - x) := (even_iff_two_dvd).mpr (by simpa using h2diff)
  exact (Int.not_even_iff_odd.mpr hodd) hEven

end
end Commons.PeriodicTiling

/-!
# The Sudoku concatentation lemma (Greenfeld--Tao, "A counterexample to the
periodic tiling conjecture", Annals 2024, arXiv:2211.15847, Lemma "concat").

A function on an `8 × 8` square of `ℤ²` which is affine along every line of
slope `-1, 0, 1` that meets the square is the restriction of a pseudo-affine
function `Ψ(n,m) = A n + B m + C + D (q/4) m (m - n)` with `q = 2^t`.

This file develops the self-contained algebraic core:
  * `ZMod (2^t)` lemmas (odd cancellation, the `q/2`-torsion identity,
    the order-4 kernel of the multiplication by `q/4`);
  * affine functions on integer windows (`AffineOn`) and their
    zero-propagation rules;
  * the three line families of slope `-1, 0, 1` and the fact that a
    pseudo-affine function is affine along each of them;
  * the main `concat_pseudo_affine` theorem on the normalized square
    `{0..7} × {0..7}`, plus a translation corollary over an arbitrary
    `8 × 8` window.
-/

open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

/-! ## `ZMod (2^t)` algebra -/

/-- An odd integer is cancellative in `ZMod (2^t)` (it generates the whole ring). -/
lemma zmod_mul_odd_eq_zero {t : ℕ} (ht : 1 ≤ t) {d : ℤ} (hd : Odd d)
    (s : ZMod (2 ^ t)) (h : s * (d : ZMod (2 ^ t)) = 0) : s = 0 := by
  have hna : Odd d.natAbs := hd.natAbs
  have htpos : 0 < t := by omega
  have hcopN : d.natAbs.Coprime (2 ^ t) := by
    rw [Nat.coprime_comm]
    rw [Nat.coprime_pow_left_iff htpos]
    rw [Nat.coprime_comm]
    exact Nat.coprime_two_right.mpr hna
  have hcop : IsCoprime d (2 ^ t : ℤ) := by
    rw [Int.isCoprime_iff_gcd_eq_one]
    rw [Int.gcd_def]
    simp [hcopN]
  have hinv : (d : ZMod (2 ^ t)) * (d : ZMod (2 ^ t))⁻¹ = 1 := by
    simpa using (ZMod.coe_int_mul_inv_eq_one (n := 2 ^ t) hcop)
  calc
    s = s * ((d : ZMod (2 ^ t)) * (d : ZMod (2 ^ t))⁻¹) := by rw [hinv, mul_one]
    _ = (s * (d : ZMod (2 ^ t))) * ((d : ZMod (2 ^ t))⁻¹) := by rw [mul_assoc]
    _ = 0 := by rw [h, zero_mul]

/-- Consecutive integers have even product. -/
lemma int_mul_pred_even (n : ℤ) : Even (n * (n - 1) : ℤ) := by
  by_cases he : Even n
  · exact Int.even_mul.mpr (Or.inl he)
  · have ho : Odd n := (Int.not_even_iff_odd.mp he)
    rw [Int.even_mul]
    right
    rcases ho with ⟨k, hk⟩
    use k
    omega

/-- `(q/2) • even = 0` in `ZMod q` with `q = 2^t`, `t ≥ 1`: `q/2 * 2k = q k ≡ 0`. -/
lemma zmod_half_mul_even {t : ℕ} (ht : 1 ≤ t) (e : ℤ) (he : Even e) :
    (((2 : ℤ) ^ (t - 1) : ℤ) : ZMod (2 ^ t)) * (e : ZMod (2 ^ t)) = 0 := by
  rcases he with ⟨k, hk⟩
  have heq : e = 2 * k := by
    calc
      e = k + k := hk
      _ = 2 * k := (two_mul k).symm
  have hfac : (2 : ℤ) ^ (t - 1) * (2 : ℤ) = (2 : ℤ) ^ t := by
    rw [← pow_succ]
    congr 1
    omega
  have hz : (((2 : ℤ) ^ t * k : ℤ) : ZMod (2 ^ t)) = 0 := by
    rw [Int.cast_mul]
    have hz' : (((2 : ℤ) ^ t : ℤ) : ZMod (2 ^ t)) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      exact dvd_refl ((2 : ℤ) ^ t)
    rw [hz']
    simp
  calc
    (((2 : ℤ) ^ (t - 1) : ℤ) : ZMod (2 ^ t)) * (e : ZMod (2 ^ t))
        = (((2 : ℤ) ^ (t - 1) * e : ℤ) : ZMod (2 ^ t)) := by rw [Int.cast_mul]
    _ = (((2 : ℤ) ^ t * k : ℤ) : ZMod (2 ^ t)) := by
        rw [heq]
        congr 1
        rw [← mul_assoc, hfac]
    _ = 0 := hz

/-- `(q/2) • n(n-1) = 0`, the identity behind "quadratic terms with coefficient a
multiple of `q/2` are affine as value functions". -/
lemma zmod_half_mul_pred {t : ℕ} (ht : 1 ≤ t) (n : ℤ) :
    (((2 : ℤ) ^ (t - 1) : ℤ) : ZMod (2 ^ t)) * ((n * (n - 1) : ℤ) : ZMod (2 ^ t)) = 0 :=
  zmod_half_mul_even ht (n * (n - 1)) (int_mul_pred_even n)

/-- Divisibility cancellation of a factor four against a power of two. -/
lemma pow_two_dvd_of_mul_four {t : ℕ} (ht : 2 ≤ t) {n : ℤ} :
    (((2 ^ t : ℕ) : ℤ) ∣ 4 * n) ↔ (((2 ^ (t - 2) : ℕ) : ℤ) ∣ n) := by
  have hfac : ((2 ^ t : ℕ) : ℤ) = ((4 * (2 ^ (t - 2)) : ℕ) : ℤ) := by
    congr 1
    rw [show t = 2 + (t - 2) by omega]
    rw [pow_add]
    norm_num
  rw [hfac, Int.natCast_mul]
  norm_num
  rw [Int.mul_dvd_mul_iff_left (by norm_num : (4 : ℤ) ≠ 0)]

/-- If `4 c = 0` in `ZMod (2^t)` (`t ≥ 2`), then `c` is a multiple of `q/4 = 2^{t-2}`. -/
lemma zmod_four_mul_eq_zero {t : ℕ} (ht : 2 ≤ t) (c : ZMod (2 ^ t))
    (h4 : (4 : ZMod (2 ^ t)) * c = 0) :
    ∃ d : ZMod (2 ^ t), c = (((2 ^ (t - 2) : ℕ) : ℤ) : ZMod (2 ^ t)) * d := by
  obtain ⟨n, hn⟩ := ZMod.intCast_surjective c
  have h4' : ((4 * n : ℤ) : ZMod (2 ^ t)) = 0 := by
    calc
      ((4 * n : ℤ) : ZMod (2 ^ t)) = (4 : ZMod (2 ^ t)) * (n : ZMod (2 ^ t)) := by
        simp [Int.cast_mul]
      _ = (4 : ZMod (2 ^ t)) * c := by rw [hn]
      _ = 0 := h4
  have hdvdZ : ((2 ^ t : ℕ) : ℤ) ∣ 4 * n := by
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (4 * n) (2 ^ t)).mp h4'
  have hn' : ((2 ^ (t - 2) : ℕ) : ℤ) ∣ n := (pow_two_dvd_of_mul_four ht).mp hdvdZ
  rcases hn' with ⟨m, hm⟩
  refine ⟨(m : ZMod (2 ^ t)), ?_⟩
  calc
    c = (n : ZMod (2 ^ t)) := hn.symm
    _ = ((((2 ^ (t - 2) : ℕ) : ℤ) * m : ℤ) : ZMod (2 ^ t)) := by rw [hm]
    _ = (((2 ^ (t - 2) : ℕ) : ℤ) : ZMod (2 ^ t)) * (m : ZMod (2 ^ t)) := by
      rw [Int.cast_mul]

/-! ## Affine functions on integer windows -/

/-- A function `f : ℤ → R` is affine on the window `[a,b]` if it agrees with
`s n + c` there. -/
def AffineOn {R : Type*} [CommRing R] (f : ℤ → R) (a b : ℤ) : Prop :=
  ∃ s c : R, ∀ n : ℤ, a ≤ n → n ≤ b → f n = s * (n : R) + c

/-- A subtraction of two affine functions on the same window is affine. -/
lemma affineOn_sub {R : Type*} [CommRing R] {f g : ℤ → R} {a b : ℤ}
    (hf : AffineOn f a b) (hg : AffineOn g a b) : AffineOn (fun n => f n - g n) a b := by
  rcases hf with ⟨s, c, hf'⟩
  rcases hg with ⟨s', c', hg'⟩
  refine ⟨s - s', c - c', ?_⟩
  intro n hn0 hn1
  change f n - g n = (s - s') * (n : R) + (c - c')
  rw [hf' n hn0 hn1, hg' n hn0 hn1]
  ring

/-- An addition of two affine functions on the same window is affine. -/
lemma affineOn_add {R : Type*} [CommRing R] {f g : ℤ → R} {a b : ℤ}
    (hf : AffineOn f a b) (hg : AffineOn g a b) : AffineOn (fun n => f n + g n) a b := by
  rcases hf with ⟨s, c, hf'⟩
  rcases hg with ⟨s', c', hg'⟩
  refine ⟨s + s', c + c', ?_⟩
  intro n hn0 hn1
  change f n + g n = (s + s') * (n : R) + (c + c')
  rw [hf' n hn0 hn1, hg' n hn0 hn1]
  ring

/-- An affine function on a window which vanishes at two points whose difference is odd
vanishes on the whole window (over `ZMod (2^t)`, `t ≥ 1`). -/
lemma affineOn_zero_of_odd_gap {t : ℕ} (ht : 1 ≤ t) {f : ℤ → ZMod (2 ^ t)}
    {a b x y : ℤ} (hf : AffineOn f a b)
    (hx : a ≤ x ∧ x ≤ b) (hy : a ≤ y ∧ y ≤ b)
    (hzx : f x = 0) (hzy : f y = 0) (hodd : Odd (y - x)) :
    ∀ n : ℤ, a ≤ n → n ≤ b → f n = 0 := by
  rcases hf with ⟨s, c, hf'⟩
  have hx' := hf' x hx.1 hx.2
  have hy' := hf' y hy.1 hy.2
  have hsx : s * (x : ZMod (2 ^ t)) + c = 0 := by rw [← hx', hzx]
  have hsy : s * (y : ZMod (2 ^ t)) + c = 0 := by rw [← hy', hzy]
  have h4 : s * (y : ZMod (2 ^ t)) = s * (x : ZMod (2 ^ t)) := by
    have hc : s * (y : ZMod (2 ^ t)) + c = s * (x : ZMod (2 ^ t)) + c := by
      rw [hsy, hsx]
    exact add_right_cancel hc
  have hd : s * ((y - x : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hsub : s * ((y : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr h4
    simpa [Int.cast_sub] using hsub
  have hs0 : s = 0 := zmod_mul_odd_eq_zero ht hodd s hd
  have hc0 : c = 0 := by
    have := hsx
    rw [hs0, zero_mul, zero_add] at this
    exact this
  intro n hn0 hn1
  calc
    f n = s * (n : ZMod (2 ^ t)) + c := hf' n hn0 hn1
    _ = 0 := by rw [hs0, hc0]; simp

/-- An affine function on a window vanishing at `p` and `p+4` is of the form
`(q/4) • d • (n - p)` over `ZMod (2^t)`, `t ≥ 2`. -/
lemma affineOn_of_gap_four {t : ℕ} (ht : 2 ≤ t) {f : ℤ → ZMod (2 ^ t)}
    {a b p : ℤ} (hf : AffineOn f a b)
    (hp : a ≤ p ∧ p ≤ b) (hp4 : a ≤ p + 4 ∧ p + 4 ≤ b)
    (hz1 : f p = 0) (hz2 : f (p + 4) = 0) :
    ∃ d : ZMod (2 ^ t), ∀ n : ℤ, a ≤ n → n ≤ b →
      f n = (((2 ^ (t - 2) : ℕ) : ℤ) : ZMod (2 ^ t)) * d * ((n - p : ℤ) : ZMod (2 ^ t)) := by
  rcases hf with ⟨s, c, hf'⟩
  have hfp := hf' p hp.1 hp.2
  have hsp : s * (p : ZMod (2 ^ t)) + c = 0 := by rw [← hfp, hz1]
  have h4s' : s * ((4 : ℤ) : ZMod (2 ^ t)) = 0 := by
    have hp4' := hf' (p + 4) hp4.1 hp4.2
    have hs4 : s * ((p + 4 : ℤ) : ZMod (2 ^ t)) + c = 0 := by rw [← hp4', hz2]
    have heq : s * ((p + 4 : ℤ) : ZMod (2 ^ t)) = s * (p : ZMod (2 ^ t)) := by
      have hc : s * ((p + 4 : ℤ) : ZMod (2 ^ t)) + c = s * (p : ZMod (2 ^ t)) + c := by
        rw [hs4, hsp]
      exact add_right_cancel hc
    have hsub : s * (((p + 4 : ℤ) : ZMod (2 ^ t)) - (p : ZMod (2 ^ t))) = 0 := by
      rw [mul_sub]
      exact sub_eq_zero.mpr heq
    have hcast : (((p + 4 : ℤ) : ZMod (2 ^ t)) - (p : ZMod (2 ^ t))) = (4 : ZMod (2 ^ t)) := by
      norm_num [Int.cast_add]
    simpa [hcast] using hsub
  have h4 : (4 : ZMod (2 ^ t)) * s = 0 := by
    simpa [mul_comm] using h4s'
  obtain ⟨d, hd⟩ := zmod_four_mul_eq_zero ht s h4
  have hc0 : c = - (s * (p : ZMod (2 ^ t))) := by
    apply eq_neg_of_add_eq_zero_left
    simpa [add_comm] using hsp
  refine ⟨d, ?_⟩
  intro n hn0 hn1
  have hn' := hf' n hn0 hn1
  calc
    f n = s * (n : ZMod (2 ^ t)) + c := hn'
    _ = s * ((n - p : ℤ) : ZMod (2 ^ t)) := by
      rw [hc0]
      rw [Int.cast_sub]
      ring
    _ = (((2 ^ (t - 2) : ℕ) : ℤ) : ZMod (2 ^ t)) * d * ((n - p : ℤ) : ZMod (2 ^ t)) := by
      rw [hd]


/-! ## The `q/2` and `q/4` coefficients of `ZMod (2^t)` -/

/-- `q/2 = 2^{t-1}` as an element of `ZMod (2^t)`. -/
abbrev qHalf (t : ℕ) : ZMod (2 ^ t) := ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))

/-- `q/4 = 2^{t-2}` as an element of `ZMod (2^t)`. -/
abbrev qFourth (t : ℕ) : ZMod (2 ^ t) := ((2 ^ (t - 2) : ℕ) : ZMod (2 ^ t))

/-- `2 • (q/4) = q/2`. -/
lemma qFourth_mul_two {t : ℕ} (ht : 2 ≤ t) :
    qFourth t * (2 : ZMod (2 ^ t)) = qHalf t := by
  change (((2 ^ (t - 2) : ℕ) : ZMod (2 ^ t))) * ((2 : ℕ) : ZMod (2 ^ t)) = ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))
  rw [← Nat.cast_mul]
  congr 1
  rw [← pow_succ]
  congr 1
  omega

/-- `(q/2) • even = 0` in `ZMod (2^t)`, `t ≥ 1` (nat-coefficient form). -/
lemma zmod_half_mul_even_nat {t : ℕ} (ht : 1 ≤ t) (e : ℤ) (he : Even e) :
    qHalf t * (e : ZMod (2 ^ t)) = 0 := by
  rcases he with ⟨k, hk⟩
  have heq : e = 2 * k := by
    calc
      e = k + k := hk
      _ = 2 * k := (two_mul k).symm
  have hz : qHalf t * (2 : ZMod (2 ^ t)) = 0 := by
    have h2 : (2 : ZMod (2 ^ t)) = ((2 : ℕ) : ZMod (2 ^ t)) := by norm_num
    rw [h2, ← Nat.cast_mul]
    have hp : 2 ^ (t - 1) * 2 = 2 ^ t := by
      rw [← pow_succ]
      congr 1
      omega
    rw [hp]
    exact ZMod.natCast_self (2 ^ t)
  calc
    qHalf t * (e : ZMod (2 ^ t)) = qHalf t * ((2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t))) := by
      rw [heq]
      rw [Int.cast_mul]
      norm_num
    _ = (qHalf t * (2 : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) := by rw [mul_assoc]
    _ = 0 := by rw [hz]; simp

/-- `(q/2) • (n² - n) = 0` for every integer `n`. -/
lemma zmod_half_sq_sub {t : ℕ} (ht : 1 ≤ t) (n : ℤ) :
    qHalf t * ((n * n - n : ℤ) : ZMod (2 ^ t)) = 0 := by
  have he : Even (n * n - n : ℤ) := by
    have hnn : n * n - n = n * (n - 1) := by ring
    rw [hnn]
    exact int_mul_pred_even n
  exact zmod_half_mul_even_nat ht (n * n - n) he

/-- `(q/2) • (u² - u) = 0` for every element `u` of `ZMod (2^t)`. -/
lemma zmod_half_mul_zmod_sq_sub {t : ℕ} (ht : 1 ≤ t) (u : ZMod (2 ^ t)) :
    qHalf t * (u * u - u) = 0 := by
  obtain ⟨n, hn⟩ := ZMod.intCast_surjective u
  have hc : u * u - u = ((n * n - n : ℤ) : ZMod (2 ^ t)) := by
    rw [← hn]
    norm_num [Int.cast_mul]
  rw [hc]
  exact zmod_half_sq_sub ht n

/-! ## The square and its three line families -/

/-- A square function: rows and columns indexed by `ℤ`, but only used on `{0..7}²`. -/
abbrev SqFun (t : ℕ) := ℤ → ℤ → ZMod (2 ^ t)

/-- A square function is affine along each line `m = j n + i` (`j = -1,0,1`) meeting
the square `{0..7}²`. -/
def SquareLineAffine {t : ℕ} (F : SqFun t) : Prop :=
  ∀ j i : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∃ s c : ZMod (2 ^ t),
    ∀ n m : ℤ, 0 ≤ n → n ≤ 7 → 0 ≤ m → m ≤ 7 → m = j * n + i →
      F n m = s * (n : ZMod (2 ^ t)) + c

/-- Extraction: row `i` of a square-line-affine function is affine on `{0..7}`. -/
lemma squareLineAffine_row {t : ℕ} {F : SqFun t} (h : SquareLineAffine F) (i : ℤ)
    (hi0 : 0 ≤ i) (hi1 : i ≤ 7) : AffineOn (fun n => F n i) 0 7 := by
  rcases h 0 i (Or.inr (Or.inl rfl)) with ⟨s, c, hF⟩
  refine ⟨s, c, ?_⟩
  intro n hn0 hn1
  have := hF n i hn0 hn1 hi0 hi1 (by simp)
  simpa using this

/-- Extraction: the main diagonal `(n,n)` is affine on `{0..7}`. -/
lemma squareLineAffine_diag {t : ℕ} {F : SqFun t} (h : SquareLineAffine F) :
    AffineOn (fun n => F n n) 0 7 := by
  rcases h 1 0 (Or.inr (Or.inr rfl)) with ⟨s, c, hF⟩
  refine ⟨s, c, ?_⟩
  intro n hn0 hn1
  have := hF n n hn0 hn1 hn0 hn1 (by simp)
  simpa using this

/-- Extraction: the anti-diagonal `(n, i - n)` is affine on `{0..i}`. -/
lemma squareLineAffine_antidiag {t : ℕ} {F : SqFun t} (h : SquareLineAffine F) (i : ℤ)
    (hi0 : 0 ≤ i) (hi1 : i ≤ 7) : AffineOn (fun n => F n (i - n)) 0 i := by
  rcases h (-1) i (Or.inl rfl) with ⟨s, c, hF⟩
  refine ⟨s, c, ?_⟩
  intro n hn0 hni
  have hn7 : n ≤ 7 := by omega
  have hmi0 : 0 ≤ i - n := by omega
  have hmi1 : i - n ≤ 7 := by omega
  have := hF n (i - n) hn0 hn7 hmi0 hmi1 (by omega)
  simpa using this

/-- Sum of two square-line-affine functions is square-line-affine. -/
lemma squareLineAffine_add {t : ℕ} {F G : SqFun t} (hF : SquareLineAffine F)
    (hG : SquareLineAffine G) : SquareLineAffine (fun n m => F n m + G n m) := by
  intro j i hj
  rcases hF j i hj with ⟨s, c, hF'⟩
  rcases hG j i hj with ⟨s', c', hG'⟩
  refine ⟨s + s', c + c', ?_⟩
  intro n m hn0 hn1 hm0 hm1 hm
  change F n m + G n m = (s + s') * (n : ZMod (2 ^ t)) + (c + c')
  rw [hF' n m hn0 hn1 hm0 hm1 hm, hG' n m hn0 hn1 hm0 hm1 hm]
  ring

/-- A purely affine square function is square-line-affine. -/
lemma squareLineAffine_affinePart {t : ℕ} (A B C : ZMod (2 ^ t)) :
    SquareLineAffine (fun n m => A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C) := by
  intro j i hj
  rcases hj with rfl | rfl | rfl
  · refine ⟨A - B, B * (i : ZMod (2 ^ t)) + C, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    simp [Int.cast_sub]
    ring
  · refine ⟨A, B * (i : ZMod (2 ^ t)) + C, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    simp
    ring
  · refine ⟨A + B, B * (i : ZMod (2 ^ t)) + C, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    simp
    ring

/-- The pseudo-affine correction term `(q/4) D m (m - n)` at `(n,m)`. -/
def pseudoCorr {t : ℕ} (D : ZMod (2 ^ t)) (n m : ℤ) : ZMod (2 ^ t) :=
  (qFourth t * D) * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (n : ZMod (2 ^ t)))

/-- Along a slope-`1` line `m = n + i`, the correction term is affine in `n`. -/
lemma pseudoCorr_diag_affine {t : ℕ} (ht : 2 ≤ t) (D : ZMod (2 ^ t)) (i : ℤ) :
    ∃ s c : ZMod (2 ^ t), ∀ n : ℤ, pseudoCorr D n (n + i) = s * (n : ZMod (2 ^ t)) + c := by
  refine ⟨(qFourth t * D) * (i : ZMod (2 ^ t)),
          (qFourth t * D) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t)), ?_⟩
  intro n
  simp [pseudoCorr]
  ring

/-- Along a horizontal line `m = i`, the correction term is affine in `n`. -/
lemma pseudoCorr_row_affine {t : ℕ} (ht : 2 ≤ t) (D : ZMod (2 ^ t)) (i : ℤ) :
    ∃ s c : ZMod (2 ^ t), ∀ n : ℤ, pseudoCorr D n i = s * (n : ZMod (2 ^ t)) + c := by
  refine ⟨-(qFourth t * D) * (i : ZMod (2 ^ t)),
          (qFourth t * D) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t)), ?_⟩
  intro n
  simp [pseudoCorr]
  ring

/-- Along an anti-diagonal line `m = i - n`, the correction term is affine in `n`
(the quadratic part is a multiple of `q/2`, hence invisible in `ZMod (2^t)`). -/
lemma pseudoCorr_antidiag_affine {t : ℕ} (ht : 2 ≤ t) (D : ZMod (2 ^ t)) (i : ℤ) :
    ∃ s c : ZMod (2 ^ t), ∀ n : ℤ, pseudoCorr D n (i - n) = s * (n : ZMod (2 ^ t)) + c := by
  refine ⟨qHalf t * D - (3 : ZMod (2 ^ t)) * (qFourth t * D) * (i : ZMod (2 ^ t)),
          (qFourth t * D) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t)), ?_⟩
  intro n
  let u : ZMod (2 ^ t) := (n : ZMod (2 ^ t))
  let v : ZMod (2 ^ t) := (i : ZMod (2 ^ t))
  have hc : (qFourth t * D) * (2 : ZMod (2 ^ t)) * (u * u) = (qHalf t * D) * u := by
    have hz : qHalf t * (u * u - u) = 0 := zmod_half_mul_zmod_sq_sub (by omega : 1 ≤ t) u
    calc
      (qFourth t * D) * (2 : ZMod (2 ^ t)) * (u * u)
          = ((qFourth t * (2 : ZMod (2 ^ t))) * D) * (u * u) := by ring
      _ = (qHalf t * D) * (u * u) := by rw [qFourth_mul_two ht]
      _ = (qHalf t * D) * u := by
          calc
            (qHalf t * D) * (u * u) = (qHalf t * D) * u + D * (qHalf t * (u * u - u)) := by ring
            _ = (qHalf t * D) * u := by rw [hz]; ring
  calc
    pseudoCorr D n (i - n)
        = (qFourth t * D) * ((i - n : ℤ) : ZMod (2 ^ t)) * (((i - n : ℤ) : ZMod (2 ^ t)) - (n : ZMod (2 ^ t))) := by
            simp [pseudoCorr]
    _ = (qFourth t * D) * (v - u) * (v - u - u) := by
            simp [u, v, Int.cast_sub]
    _ = (qFourth t * D) * (v * v) - (3 : ZMod (2 ^ t)) * (qFourth t * D) * v * u
          + (qFourth t * D) * (2 : ZMod (2 ^ t)) * (u * u) := by ring
    _ = (qFourth t * D) * (v * v) - (3 : ZMod (2 ^ t)) * (qFourth t * D) * v * u
          + (qHalf t * D) * u := by rw [hc]
    _ = (qHalf t * D - (3 : ZMod (2 ^ t)) * (qFourth t * D) * v) * u
          + (qFourth t * D) * (v * v) := by ring
    _ = (qHalf t * D - (3 : ZMod (2 ^ t)) * (qFourth t * D) * (i : ZMod (2 ^ t))) * (n : ZMod (2 ^ t))
          + (qFourth t * D) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t)) := by
          simp [u, v]
          ring

/-- The correction term is affine along every slope-`-1,0,1` line. -/
lemma squareLineAffine_pseudoCorr {t : ℕ} (ht : 2 ≤ t) (D : ZMod (2 ^ t)) :
    SquareLineAffine (fun n m => pseudoCorr D n m) := by
  intro j i hj
  rcases hj with rfl | rfl | rfl
  · have ⟨s, c, hv⟩ := pseudoCorr_antidiag_affine ht D i
    refine ⟨s, c, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    rw [show -1 * n + i = i - n by ring]
    exact hv n
  · have ⟨s, c, hv⟩ := pseudoCorr_row_affine ht D i
    refine ⟨s, c, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    rw [show 0 * n + i = i by ring]
    exact hv n
  · have ⟨s, c, hv⟩ := pseudoCorr_diag_affine ht D i
    refine ⟨s, c, ?_⟩
    intro n m hn0 hn1 hm0 hm1 hm
    rw [hm]
    rw [show 1 * n + i = n + i by ring]
    exact hv n

/-- Difference of two square-line-affine functions is square-line-affine. -/
lemma squareLineAffine_sub {t : ℕ} {F G : SqFun t} (hF : SquareLineAffine F)
    (hG : SquareLineAffine G) : SquareLineAffine (fun n m => F n m - G n m) := by
  intro j i hj
  rcases hF j i hj with ⟨s, c, hF'⟩
  rcases hG j i hj with ⟨s', c', hG'⟩
  refine ⟨s - s', c - c', ?_⟩
  intro n m hn0 hn1 hm0 hm1 hm
  change F n m - G n m = (s - s') * (n : ZMod (2 ^ t)) + (c - c')
  rw [hF' n m hn0 hn1 hm0 hm1 hm, hG' n m hn0 hn1 hm0 hm1 hm]
  ring

/-- A full pseudo-affine function is affine along every slope-`-1,0,1` line. -/
lemma squareLineAffine_pseudo {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) :
    SquareLineAffine (fun n m => A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C + pseudoCorr D n m) := by
  have hA : SquareLineAffine (fun n m => A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C) :=
    squareLineAffine_affinePart A B C
  have hT : SquareLineAffine (fun n m => pseudoCorr D n m) := squareLineAffine_pseudoCorr ht D
  simpa [add_comm, add_left_comm, add_assoc] using (squareLineAffine_add hA hT)

/-- An affine function on a window is determined by its value and unit slope at any
anchor point inside the window. -/
lemma affineOn_extend {R : Type*} [CommRing R] {f : ℤ → R} {a b x : ℤ}
    (hf : AffineOn f a b) (hx : a ≤ x ∧ x ≤ b) (hx1 : a ≤ x + 1 ∧ x + 1 ≤ b) :
    ∀ n : ℤ, a ≤ n → n ≤ b →
      f n = f x + ((n - x : ℤ) : R) * (f (x + 1) - f x) := by
  rcases hf with ⟨s, c, hf'⟩
  have hx0 := hf' x hx.1 hx.2
  have hx1' := hf' (x + 1) hx1.1 hx1.2
  have hs : f (x + 1) - f x = s := by
    rw [hx1', hx0]
    simp [Int.cast_add]
    ring
  intro n hn0 hn1
  have hn' := hf' n hn0 hn1
  calc
    f n = s * (n : R) + c := hn'
    _ = (s * (x : R) + c) + ((n - x : ℤ) : R) * s := by
        rw [Int.cast_sub]
        ring
    _ = f x + ((n - x : ℤ) : R) * (f (x + 1) - f x) := by
        rw [← hx0, hs]

/-- The Greenfeld--Tao concatentation lemma (Lemma "concat" in arXiv:2211.15847),
on the normalized square `{0..7} × {0..7}`: a function affine along every line of
slope `-1,0,1` meeting the square agrees on it with a pseudo-affine function
`A n + B m + C + (q/4) D m (m-n)`, `q = 2^t`, `t ≥ 2`. -/
theorem concat_pseudo_affine {t : ℕ} (ht : 2 ≤ t) (F : SqFun t)
    (hF : SquareLineAffine F) :
    ∃ A B C D : ZMod (2 ^ t), ∀ n m : ℤ, 0 ≤ n → n ≤ 7 → 0 ≤ m → m ≤ 7 →
      F n m = A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C + pseudoCorr D n m := by
  classical
  let A : ZMod (2 ^ t) := F 1 0 - F 0 0
  let B : ZMod (2 ^ t) := F 1 1 - F 1 0
  let C : ZMod (2 ^ t) := F 0 0
  let P : SqFun t := fun n m => A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C
  let F1 : SqFun t := fun n m => F n m - P n m
  have hrow0 := squareLineAffine_row hF 0 (by norm_num) (by norm_num)
  have hdiag := squareLineAffine_diag hF
  -- F agrees with P on the x-axis and the diagonal
  have hrow0P : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → F n 0 = P n 0 := by
    intro n hn0 hn1
    have hmain := affineOn_extend (f := fun n => F n 0) (a := 0) (b := 7) (x := 0)
      hrow0 ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ n hn0 hn1
    calc
      F n 0 = F 0 0 + ((n - 0 : ℤ) : ZMod (2 ^ t)) * (F 1 0 - F 0 0) := by
        convert hmain using 1 <;> norm_num
      _ = P n 0 := by
        dsimp [P, A, C]
        simp
        ring
  have hdiagP : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → F n n = P n n := by
    intro n hn0 hn1
    have hmain := affineOn_extend (f := fun n => F n n) (a := 0) (b := 7) (x := 0)
      hdiag ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ n hn0 hn1
    calc
      F n n = F 0 0 + ((n - 0 : ℤ) : ZMod (2 ^ t)) * (F 1 1 - F 0 0) := by
        convert hmain using 1 <;> norm_num
      _ = P n n := by
        dsimp [P, A, B, C]
        simp
        ring
  have hP : SquareLineAffine P := squareLineAffine_affinePart A B C
  have hF1 : SquareLineAffine F1 := by
    simpa [F1] using (squareLineAffine_sub hF hP)
  have hrow0F1 : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → F1 n 0 = 0 := by
    intro n hn0 hn1
    dsimp [F1, P]
    rw [hrow0P n hn0 hn1]
    ring
  have hdiagF1 : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → F1 n n = 0 := by
    intro n hn0 hn1
    dsimp [F1, P]
    rw [hdiagP n hn0 hn1]
    ring
  -- the anti-diagonal i = 6 of F1 vanishes (zeros at n = 3 and n = 6, gap 3)
  have hAnti6 := squareLineAffine_antidiag hF1 6 (by norm_num) (by norm_num)
  have hAnti6F1 : ∀ n : ℤ, 0 ≤ n → n ≤ 6 → F1 n (6 - n) = 0 := by
    intro n hn0 hn1
    have hz3 : (fun n => F1 n (6 - n)) 3 = 0 := by
      have := hdiagF1 3 (by norm_num) (by norm_num)
      convert this using 1 <;> norm_num
    have hz6 : (fun n => F1 n (6 - n)) 6 = 0 := by
      have := hrow0F1 6 (by norm_num) (by norm_num)
      convert this using 1 <;> norm_num
    have hodd : Odd ((6 : ℤ) - 3) := by norm_num
    have hz := affineOn_zero_of_odd_gap (t := t) (by omega : 1 ≤ t) hAnti6
      ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ hz3 hz6 hodd n hn0 hn1
    exact hz
  -- row 1 of F1 vanishes at n = 1 (diagonal) and n = 5 (anti-diagonal), gap 4
  have hrow1F1a : AffineOn (fun n => F1 n 1) 0 7 :=
    squareLineAffine_row hF1 1 (by norm_num) (by norm_num)
  have hz1 : (fun n => F1 n 1) 1 = 0 := by
    have := hdiagF1 1 (by norm_num) (by norm_num)
    simpa using this
  have hz5 : (fun n => F1 n 1) 5 = 0 := by
    have := hAnti6F1 5 (by norm_num) (by norm_num)
    convert this using 1 <;> norm_num
  obtain ⟨d, hd⟩ := affineOn_of_gap_four (t := t) ht hrow1F1a
    ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ hz1 hz5
  have hcoef : (((2 ^ (t - 2) : ℕ) : ℤ) : ZMod (2 ^ t)) = qFourth t := by
    simp
  have hd' : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → F1 n 1 = qFourth t * d * ((n - 1 : ℤ) : ZMod (2 ^ t)) := by
    intro n hn0 hn1
    rw [hd n hn0 hn1, hcoef]
  let D : ZMod (2 ^ t) := -d
  let R : SqFun t := fun n m => F1 n m - pseudoCorr D n m
  have hR : SquareLineAffine R := by
    simpa [R] using (squareLineAffine_sub hF1 (squareLineAffine_pseudoCorr ht D))
  have hrow0R : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → R n 0 = 0 := by
    intro n hn0 hn1
    dsimp [R, pseudoCorr, D]
    rw [hrow0F1 n hn0 hn1]
    simp
  have hdiagR : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → R n n = 0 := by
    intro n hn0 hn1
    dsimp [R, pseudoCorr, D]
    rw [hdiagF1 n hn0 hn1]
    simp
  have hrow1R : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → R n 1 = 0 := by
    intro n hn0 hn1
    have hn' := hd' n hn0 hn1
    have hneg : ((1 : ZMod (2 ^ t)) - (n : ZMod (2 ^ t))) = -((n - 1 : ℤ) : ZMod (2 ^ t)) := by
      have h1 : ((1 - n : ℤ) : ZMod (2 ^ t)) = (1 : ZMod (2 ^ t)) - (n : ZMod (2 ^ t)) := by
        rw [Int.cast_sub]
        simp
      rw [← h1]
      rw [show (1 - n : ℤ) = -(n - 1) by ring]
      rw [Int.cast_neg]
    have hcorr : pseudoCorr D n 1 = qFourth t * d * ((n - 1 : ℤ) : ZMod (2 ^ t)) := by
      dsimp [D]
      calc
        pseudoCorr (-d) n 1
            = (qFourth t * (-d)) * (1 : ZMod (2 ^ t)) * ((1 : ZMod (2 ^ t)) - (n : ZMod (2 ^ t))) := by
                dsimp [pseudoCorr]
                simp
        _ = (qFourth t * (-d)) * (1 : ZMod (2 ^ t)) * (-((n - 1 : ℤ) : ZMod (2 ^ t))) := by
                rw [hneg]
        _ = qFourth t * d * ((n - 1 : ℤ) : ZMod (2 ^ t)) := by ring
    dsimp [R]
    rw [hn', hcorr]
    ring
  -- R(0, m) = 0 for all rows m of the square
  have hcol0 : ∀ m : ℤ, 0 ≤ m → m ≤ 7 → R 0 m = 0 := by
    intro m hm0 hm1
    by_cases hmz : m = 0
    · subst m
      exact hrow0R 0 (by norm_num) (by norm_num)
    · have hAnti_m := squareLineAffine_antidiag hR m hm0 hm1
      have hz_a : (fun n => R n (m - n)) (m - 1) = 0 := by
        have hw := hrow1R (m - 1) (by omega) (by omega)
        have hconv : m - (m - 1) = 1 := by omega
        simpa [hconv] using hw
      have hz_b : (fun n => R n (m - n)) m = 0 := by
        have hw := hrow0R m hm0 hm1
        have hconv : m - m = 0 := by ring
        simpa [hconv] using hw
      have hodd : Odd (m - (m - 1)) := by
        have hconv : m - (m - 1) = 1 := by omega
        simpa [hconv] using (by norm_num : Odd (1 : ℤ))
      have hz := affineOn_zero_of_odd_gap (t := t) (by omega : 1 ≤ t) hAnti_m
        ⟨by omega, by omega⟩ ⟨by omega, by omega⟩ hz_a hz_b hodd 0 (by norm_num) (by omega)
      simpa using hz
  -- R(1, m) = 0 for rows m ≤ 6
  have hcol1 : ∀ m : ℤ, 0 ≤ m → m ≤ 6 → R 1 m = 0 := by
    intro m hm0 hm1
    by_cases hmz : m = 0
    · subst m
      exact hrow0R 1 (by norm_num) (by norm_num)
    · have hi : m + 1 ≤ 7 := by omega
      have hAnti_m := squareLineAffine_antidiag hR (m + 1) (by omega) hi
      have hz_a : (fun n => R n (m + 1 - n)) m = 0 := by
        have hw := hrow1R m hm0 (by omega)
        have hconv : m + 1 - m = 1 := by omega
        simpa [hconv] using hw
      have hz_b : (fun n => R n (m + 1 - n)) (m + 1) = 0 := by
        have hw := hrow0R (m + 1) (by omega) hi
        have hconv : m + 1 - (m + 1) = 0 := by ring
        simpa [hconv] using hw
      have hodd : Odd ((m + 1) - m) := by
        have hconv : (m + 1) - m = 1 := by omega
        simpa [hconv] using (by norm_num : Odd (1 : ℤ))
      have hz := affineOn_zero_of_odd_gap (t := t) (by omega : 1 ≤ t) hAnti_m
        ⟨by omega, by omega⟩ ⟨by omega, by omega⟩ hz_a hz_b hodd 1 (by norm_num) (by omega)
      simpa using hz
  -- rows 0..6 all vanish
  have hrows : ∀ m : ℤ, 0 ≤ m → m ≤ 6 → ∀ n : ℤ, 0 ≤ n → n ≤ 7 → R n m = 0 := by
    intro m hm0 hm1 n hn0 hn1
    have hrow_m := squareLineAffine_row hR m hm0 (by omega)
    have hz_a : (fun n => R n m) 0 = 0 := hcol0 m hm0 (by omega)
    have hz_b : (fun n => R n m) 1 = 0 := hcol1 m hm0 hm1
    have hodd : Odd ((1 : ℤ) - 0) := by norm_num
    have hz := affineOn_zero_of_odd_gap (t := t) (by omega : 1 ≤ t) hrow_m
      ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ hz_a hz_b hodd n hn0 hn1
    simpa using hz
  -- top row 7
  have htop : ∀ n : ℤ, 0 ≤ n → n ≤ 7 → R n 7 = 0 := by
    intro n hn0 hn1
    have hrow_7 := squareLineAffine_row hR 7 (by norm_num) (by norm_num)
    have hz_a : (fun n => R n 7) 0 = 0 := hcol0 7 (by norm_num) (by norm_num)
    have hz_b : (fun n => R n 7) 7 = 0 := hdiagR 7 (by norm_num) (by norm_num)
    have hodd : Odd ((7 : ℤ) - 0) := by norm_num
    have hz := affineOn_zero_of_odd_gap (t := t) (by omega : 1 ≤ t) hrow_7
      ⟨by norm_num, by norm_num⟩ ⟨by norm_num, by norm_num⟩ hz_a hz_b hodd n hn0 hn1
    simpa using hz
  -- R vanishes on the whole square, so F is pseudo-affine on it
  have hR0 : ∀ n m : ℤ, 0 ≤ n → n ≤ 7 → 0 ≤ m → m ≤ 7 → R n m = 0 := by
    intro n m hn0 hn1 hm0 hm1
    by_cases hm7 : m = 7
    · subst m
      exact htop n hn0 hn1
    · have hm6 : m ≤ 6 := by omega
      exact hrows m hm0 hm6 n hn0 hn1
  refine ⟨A, B, C, D, ?_⟩
  intro n m hn0 hn1 hm0 hm1
  have hRm := hR0 n m hn0 hn1 hm0 hm1
  have hlin : F n m = P n m + pseudoCorr D n m := by
    have hz : (F n m - P n m) - pseudoCorr D n m = 0 := by
      simpa [R, F1] using hRm
    have hz' : F n m - (P n m + pseudoCorr D n m) = 0 := by
      have hstep : F n m - (P n m + pseudoCorr D n m) =
          (F n m - P n m) - pseudoCorr D n m := by ring
      rw [hstep, hz]
    exact sub_eq_zero.mp hz'
  calc
    F n m = P n m + pseudoCorr D n m := hlin
    _ = A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C + pseudoCorr D n m := by
        dsimp [P]

end
end Commons.PeriodicTiling

/-!
# Proposition "rigid-out" (arXiv:2211.15847, tex 1227-1263) — first cut

Rigid-out: if a structured (Scal-type) row sequence `g(n) = f_q(a·n+b)` agrees with an
affine function `α` on an `8`-row window `{n0..n0+7}` wherever `α ≠ 0`, then it agrees
with `α` on the whole row range `{1..N}` wherever `α ≠ 0`.

This file is a deliberate FIRST CUT: it installs the reduction to the packaged
statistics (`scal_line_stats_exists`) and splits on `S.orderInf` exactly as the paper's
proof does, and leaves TODO markers at the points where the next
`sudoku_stats`/`affine` lemmas are needed.  It exists to expose precisely which
lemmas those are; it is NOT a finished result (unfinished).
-/

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

/-! ## Case-2 helper library (bad-cover / coset case analysis of Prop rigid-out).

These lemmas supply the value structure (`q/2` on a complementary parity class, agreement
propagation along a parity class, the `ZMod (2^t)` 2-torsion dichotomy) used in the
`¬h1` (Case 2) analysis below.  Developed in `dev_case2.lean`. -/
lemma zmod_two_mul_eq_zero_half {t : ℕ} (ht : 1 ≤ t) {s : ZMod (2 ^ t)}
    (hs : (2 : ZMod (2 ^ t)) * s = 0) : s = 0 ∨ s = qHalf t := by
  haveI : NeZero (2 ^ t) := ⟨pow_ne_zero t (by norm_num : (2 : ℕ) ≠ 0)⟩
  let m := s.val
  have hm : s = (m : ZMod (2 ^ t)) := by
    simpa [m] using (ZMod.natCast_zmod_val s).symm
  have h2m : ((2 * m : ℕ) : ZMod (2 ^ t)) = 0 := by
    calc
      ((2 * m : ℕ) : ZMod (2 ^ t)) = (2 : ZMod (2 ^ t)) * (m : ZMod (2 ^ t)) := by
        rw [Nat.cast_mul]
        norm_num
      _ = (2 : ZMod (2 ^ t)) * s := by rw [hm]
      _ = 0 := hs
  have hv' : (2 * m) % (2 ^ t) = 0 := by
    have hv := congrArg ZMod.val h2m
    rw [ZMod.val_natCast] at hv
    simpa using hv
  have hdvd : (2 ^ t) ∣ 2 * m := Nat.dvd_of_mod_eq_zero hv'
  rcases hdvd with ⟨k, hk⟩
  have hmk : m = 2 ^ (t - 1) * k := by
    have hfac : (2 ^ t : ℕ) = 2 * 2 ^ (t - 1) := by
      rw [show t = 1 + (t - 1) by omega, pow_add]
      norm_num
    rw [hfac] at hk
    have hmul : 2 * m = 2 * (2 ^ (t - 1) * k) := by
      calc
        2 * m = (2 * 2 ^ (t - 1)) * k := hk
        _ = 2 * (2 ^ (t - 1) * k) := by rw [mul_assoc]
    exact Nat.eq_of_mul_eq_mul_left (by norm_num : 0 < 2) hmul
  by_cases hk0 : k = 0
  · left
    rw [hm, hmk, hk0]
    simp
  · right
    have hmlt : m < 2 ^ t := ZMod.val_lt s
    have hmlt' : 2 ^ (t - 1) * k < 2 ^ (t - 1) * 2 := by
      calc
        2 ^ (t - 1) * k = m := hmk.symm
        _ < 2 ^ t := hmlt
        _ = 2 * 2 ^ (t - 1) := by
            rw [show t = 1 + (t - 1) by omega, pow_add]
            norm_num
        _ = 2 ^ (t - 1) * 2 := by rw [mul_comm]
    have hklt : k < 2 := Nat.lt_of_mul_lt_mul_left hmlt'
    have hk1 : k = 1 := by omega
    have hmv : m = 2 ^ (t - 1) := by simpa [hk1] using hmk
    calc
      s = (m : ZMod (2 ^ t)) := hm
      _ = ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) := by rw [hmv]
      _ = qHalf t := rfl

/-- `qHalf t` is annihilated by `2`. -/
lemma two_mul_qHalf {t : ℕ} (ht : 1 ≤ t) : (2 : ZMod (2 ^ t)) * qHalf t = 0 := by
  calc
    (2 : ZMod (2 ^ t)) * qHalf t
        = ((2 * 2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) := by
            rw [Nat.cast_mul]
            norm_num
    _ = (((2 ^ t : ℕ) : ZMod (2 ^ t))) := by
        congr 1
        rw [show t = 1 + (t - 1) by omega, pow_add]
        norm_num
    _ = 0 := ZMod.natCast_self (2 ^ t)

/-- `qHalf t ≠ 0` for `t ≥ 1`. -/
lemma qHalf_ne_zero {t : ℕ} (ht : 1 ≤ t) : qHalf t ≠ 0 := by
  intro h
  haveI : NeZero (2 ^ t) := ⟨pow_ne_zero t (by norm_num : (2 : ℕ) ≠ 0)⟩
  have hv' : (2 ^ (t - 1)) % (2 ^ t) = 0 := by
    have hv := congrArg ZMod.val h
    rw [ZMod.val_natCast] at hv
    simpa [qHalf] using hv
  have hdvd : (2 ^ t) ∣ 2 ^ (t - 1) := Nat.dvd_of_mod_eq_zero hv'
  rcases hdvd with ⟨k, hk⟩
  have hkpos : 0 < k := by
    by_contra hk0
    have hk0' : k = 0 := by omega
    rw [hk0', mul_zero] at hk
    exact (pow_pos (by norm_num : 0 < (2 : ℕ)) (t - 1)).ne' hk
  have hlt : 2 ^ (t - 1) < 2 ^ t :=
    Nat.pow_lt_pow_right (by norm_num : 1 < (2 : ℕ)) (by omega : t - 1 < t)
  have hge : 2 ^ t ≤ 2 ^ (t - 1) := by
    calc
      2 ^ t = 2 ^ t * 1 := by rw [mul_one]
      _ ≤ 2 ^ t * k := Nat.mul_le_mul_left (2 ^ t) hkpos
      _ = 2 ^ (t - 1) := hk.symm
  omega

/-- Difference of affine values at two points is the slope times the gap:
`α y - α x = qAffine A 0 (y-x)`. -/
lemma qAffine_diff (q : ℕ) (A B x y : ℤ) :
    qAffine q A B y - qAffine q A B x = qAffine q A 0 (y - x) := by
  unfold qAffine
  rw [Int.cast_sub]
  ring

/-- Value of the affine function one step to the right of a zero equals the slope:
`α (x+1) = A` when `α x = 0`. -/
lemma qAffine_succ_of_zero {q : ℕ} (A B x : ℤ) (hx : qAffine q A B x = 0) :
    qAffine q A B (x + 1) = (A : ZMod q) := by
  unfold qAffine
  have hxc : (A : ZMod q) * (x : ZMod q) + (B : ZMod q) = 0 := by
    simpa [qAffine] using hx
  calc
    (A : ZMod q) * (((x + 1 : ℤ) : ZMod q)) + (B : ZMod q)
        = ((A : ZMod q) * (x : ZMod q) + (B : ZMod q)) + (A : ZMod q) := by
            rw [Int.cast_add]
            ring
    _ = (A : ZMod q) := by rw [hxc]; simp

/-- If an affine function over `ZMod (2^t)` vanishes at `x` and `x+2`, then it equals
`q/2` on the complementary parity class, unless it is identically zero. -/
lemma qAffine_zero_pair_class_half {t : ℕ} (ht : 1 ≤ t) (A B x : ℤ)
    (hx : qAffine (2 ^ t) A B x = 0) (hx2 : qAffine (2 ^ t) A B (x + 2) = 0)
    (hnz : ¬ (∀ z : ℤ, qAffine (2 ^ t) A B z = 0)) :
    ∀ z : ℤ, ¬ Even (z - x) → qAffine (2 ^ t) A B z = qHalf t := by
  intro z hz
  have hcl := qAffine_odd_class_const ht A B x hx hx2 z hz
  have hx1 : qAffine (2 ^ t) A B (x + 1) = qHalf t := by
    let s : ZMod (2 ^ t) := (A : ZMod (2 ^ t))
    have hx1v : qAffine (2 ^ t) A B (x + 1) = s := qAffine_succ_of_zero (q := 2 ^ t) A B x hx
    have hs2 : (2 : ZMod (2 ^ t)) * s = 0 := by
      have hd : qAffine (2 ^ t) A B (x + 2) - qAffine (2 ^ t) A B x = 0 := by
        rw [hx2, hx]
        simp
      have hd' : qAffine (2 ^ t) A 0 2 = 0 := by
        have h := qAffine_diff (2 ^ t) A B x (x + 2)
        rw [show (x + 2 - x : ℤ) = 2 by ring] at h
        rw [← h]
        exact hd
      have hs : s * (2 : ZMod (2 ^ t)) = 0 := by
        simpa [s, qAffine] using hd'
      simpa [mul_comm] using hs
    rcases zmod_two_mul_eq_zero_half ht hs2 with h0 | hq
    · exfalso
      apply hnz
      intro z
      have hodd : Odd ((x + 1) - x) := by norm_num
      have hx1z : qAffine (2 ^ t) A B (x + 1) = 0 := by simpa [hx1v, s, h0]
      exact qAffine_zero_of_odd_gap ht A B hodd hx hx1z z
    · rw [hx1v]
      exact hq
  exact hcl.trans hx1

/-- If two affine functions agree at `x` and `x + 2` (same parity class, gap 2), they
agree on the whole parity class of `x`. -/
lemma qAffine_agree_even_gap_class {t : ℕ} (ht : 1 ≤ t) (a b A B n : ℤ)
    (hDn : qAffine (2 ^ t) a b n = qAffine (2 ^ t) A B n)
    (hDn2 : qAffine (2 ^ t) a b (n + 2) = qAffine (2 ^ t) A B (n + 2)) :
    ∀ z : ℤ, Even (z - n) → qAffine (2 ^ t) a b z = qAffine (2 ^ t) A B z := by
  intro z hz
  have hDn0 : qAffine (2 ^ t) (a - A) (b - B) n = 0 := by
    calc
      qAffine (2 ^ t) (a - A) (b - B) n
          = qAffine (2 ^ t) a b n - qAffine (2 ^ t) A B n := (qAffine_sub (2 ^ t) a b A B n).symm
      _ = 0 := sub_eq_zero.mpr hDn
  have hDn20 : qAffine (2 ^ t) (a - A) (b - B) (n + 2) = 0 := by
    calc
      qAffine (2 ^ t) (a - A) (b - B) (n + 2)
          = qAffine (2 ^ t) a b (n + 2) - qAffine (2 ^ t) A B (n + 2) := (qAffine_sub (2 ^ t) a b A B (n + 2)).symm
      _ = 0 := sub_eq_zero.mpr hDn2
  have hDz := qAffine_zero_of_even_gap ht (a - A) (b - B) n hDn0 hDn20 z hz
  -- D z = 0 means α_g z = α z
  have hdiff : qAffine (2 ^ t) a b z - qAffine (2 ^ t) A B z = 0 :=
    (qAffine_sub (2 ^ t) a b A B z).trans hDz
  exact sub_eq_zero.mp hdiff

/-- If an affine function vanishes at `z + 2` and `z + 6` (distance-4 separated zeros),
then twice its value at `z` is zero. -/
lemma qAffine_gap4_two_mul_value {t : ℕ} (ht : 1 ≤ t) (A B c : ℤ)
    (hz2 : qAffine (2 ^ t) A B (c + 2) = 0) (hz6 : qAffine (2 ^ t) A B (c + 6) = 0) :
    (2 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B c = 0 := by
  let s : ZMod (2 ^ t) := (A : ZMod (2 ^ t))
  have hz2s : qAffine (2 ^ t) A B c + (2 : ZMod (2 ^ t)) * s = 0 := by
    calc
      qAffine (2 ^ t) A B c + (2 : ZMod (2 ^ t)) * s
          = qAffine (2 ^ t) A B (c + 2) := by
              unfold qAffine
              rw [Int.cast_add]
              simp [s]
              ring
      _ = 0 := hz2
  have h4s : (4 : ZMod (2 ^ t)) * s = 0 := by
    have hd : qAffine (2 ^ t) A B (c + 6) - qAffine (2 ^ t) A B (c + 2) = 0 := by
      rw [hz6, hz2]
      simp
    have hd4 : qAffine (2 ^ t) A B (c + 6) - qAffine (2 ^ t) A B (c + 2) =
        (4 : ZMod (2 ^ t)) * s := by
      unfold qAffine
      rw [Int.cast_add]
      simp [s]
      ring
    rw [hd4] at hd
    simpa [mul_comm] using hd
  have hcneg : qAffine (2 ^ t) A B c = - ((2 : ZMod (2 ^ t)) * s) := by
    exact eq_neg_of_add_eq_zero_left hz2s
  calc
    (2 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B c
        = (2 : ZMod (2 ^ t)) * (- ((2 : ZMod (2 ^ t)) * s)) := by rw [hcneg]
    _ = - ((4 : ZMod (2 ^ t)) * s) := by ring
    _ = 0 := by rw [h4s]; simp

/-- The value of an affine function at a point whose same-parity neighbours two apart
are zeros: it is `0` or `q/2` (and nonzero forces `q/2`). -/
lemma qAffine_gap4_value_half {t : ℕ} (ht : 1 ≤ t) (A B c : ℤ)
    (hz2 : qAffine (2 ^ t) A B (c + 2) = 0) (hz6 : qAffine (2 ^ t) A B (c + 6) = 0)
    (hnz : qAffine (2 ^ t) A B c ≠ 0) :
    qAffine (2 ^ t) A B c = qHalf t := by
  rcases zmod_two_mul_eq_zero_half ht (qAffine_gap4_two_mul_value ht A B c hz2 hz6) with h0 | hq
  · exact False.elim (hnz h0)
  · exact hq

/-- Two integers at odd difference from a common base have even difference. -/
lemma even_sub_of_not_even_both {b x y : ℤ} (hx : ¬ Even (x - b)) (hy : ¬ Even (y - b)) :
    Even (y - x) := by
  have hox : Odd (x - b) := (Int.not_even_iff_odd).mp hx
  have hoy : Odd (y - b) := (Int.not_even_iff_odd).mp hy
  rcases hox with ⟨k, hk⟩
  rcases hoy with ⟨l, hl⟩
  refine ⟨l - k, ?_⟩
  calc
    y - x = (y - b) - (x - b) := by ring
    _ = (2 * l + 1) - (2 * k + 1) := by rw [hk, hl]
    _ = (l - k) + (l - k) := by ring

/-- Config-I success pattern: if `α` (zero set a full parity class of `b`, since it
vanishes at `b` and `b+2`, and is not identically zero) and `α_g` agree at two
consecutive points `xq, xq + 2` of the complementary parity class, then they agree
everywhere `α` is nonzero. -/
theorem config_I_success {t : ℕ} (ht : 1 ≤ t) (sa sb A B b xq : ℤ)
    (hα : qAffine (2 ^ t) A B b = 0) (hα2 : qAffine (2 ^ t) A B (b + 2) = 0)
    (hαnz : ¬ (∀ z : ℤ, qAffine (2 ^ t) A B z = 0))
    (hAg1 : qAffine (2 ^ t) sa sb xq = qAffine (2 ^ t) A B xq)
    (hAg2 : qAffine (2 ^ t) sa sb (xq + 2) = qAffine (2 ^ t) A B (xq + 2))
    (hpar : ¬ Even (xq - b)) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  intro z hz
  have hzne : ¬ Even (z - b) := by
    intro hEven
    exact hz (qAffine_zero_of_even_gap ht A B b hα hα2 z hEven)
  have hzq : Even (z - xq) := even_sub_of_not_even_both hpar hzne
  have hval := qAffine_agree_even_gap_class ht sa sb A B xq hAg1 hAg2 z hzq
  exact hval






/-! ## Case-2 value-structure contradictions (bad rows). -/
/-- Two divides any power of two (integer version). -/
lemma two_dvd_two_pow_int {t : ℕ} (ht : 1 ≤ t) : (2 : ℤ) ∣ ((2 ^ t : ℕ) : ℤ) := by
  have ht' : t = (t - 1) + 1 := by omega
  refine ⟨((2 ^ (t - 1) : ℕ) : ℤ), ?_⟩
  rw [ht']
  rw [pow_succ]
  simp [Nat.cast_mul, mul_comm, mul_left_comm, mul_assoc]

/-- `qHalf t = 2^{t-1}` is even for `t ≥ 2`: it has no odd integer representative. -/
lemma not_HasOddRep_qHalf {t : ℕ} (ht : 2 ≤ t) : ¬ HasOddRep (qHalf t) := by
  intro hz
  rcases hz with ⟨r, hr, hzr⟩
  have hzr'' : (r : ZMod (2 ^ t)) = (((2 ^ (t - 1) : ℕ) : ℤ) : ZMod (2 ^ t)) := by
    simpa [qHalf] using hzr
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ (((2 ^ (t - 1) : ℕ) : ℤ) - r) := by
    exact (ZMod.intCast_eq_intCast_iff_dvd_sub r ((2 ^ (t - 1) : ℕ) : ℤ) (2 ^ t)).mp hzr''
  rcases hdvd with ⟨k, hk⟩
  have h2a : (2 : ℤ) ∣ (((2 ^ (t - 1) : ℕ) : ℤ)) := by
    exact two_dvd_two_pow_int (t := t - 1) (by omega)
  have h2b : (2 : ℤ) ∣ (((2 ^ t : ℕ) : ℤ) * k) := by
    have h2t : (2 : ℤ) ∣ (((2 ^ t : ℕ) : ℤ)) := two_dvd_two_pow_int (t := t) (by omega)
    exact dvd_trans h2t (dvd_mul_right (((2 ^ t : ℕ) : ℤ)) k)
  have h2 : (2 : ℤ) ∣ r := by
    have hreq : r = (((2 ^ (t - 1) : ℕ) : ℤ)) - (((2 ^ t : ℕ) : ℤ)) * k := by omega
    rw [hreq]
    exact dvd_sub h2a h2b
  rcases h2 with ⟨w, hw⟩
  rcases hr with ⟨k', hk'⟩
  omega

/-- Value of the structured line at a bad row: `f_q(a·n+b) = f_q m` when `a·n+b = q·m`. -/
lemma qLine_bad_row {t : ℕ} (a b m n : ℤ) (hnm : a * n + b = (2 ^ t : ℤ) * m) :
    qLine (2 ^ t) a b n = fq (2 ^ t) m := by
  unfold qLine
  rw [hnm]
  exact fq_qmul_int (q := 2 ^ t) (by norm_num : (2 ^ t : ℕ) ≠ 0) m

/-- Moving from a bad row by `d` with `a·d = q·a′` adds `a′` to the quotient `m`. -/
lemma bad_row_shift_m {t : ℕ} (a b m n d a' : ℤ)
    (hnm : a * n + b = (2 ^ t : ℤ) * m) (had : a * d = (2 ^ t : ℤ) * a') :
    a * (n + d) + b = (2 ^ t : ℤ) * (m + a') := by
  calc
    a * (n + d) + b = a * n + b + a * d := by ring
    _ = (2 ^ t : ℤ) * m + (2 ^ t : ℤ) * a' := by rw [hnm, had]
    _ = (2 ^ t : ℤ) * (m + a') := by ring

/-- The next bad row at the bad-coset spacing `2^{t-o}` shifts the quotient by the odd
`a′` (`a = 2^o·a′`). -/
lemma bad_row_next_quotient {t o : ℕ} (ho : o ≤ t) {a a' b m n : ℤ}
    (hfac : a = (((2 ^ o : ℕ) : ℤ)) * a') (hnm : a * n + b = (2 ^ t : ℤ) * m) :
    a * (n + (((2 ^ (t - o) : ℕ) : ℤ))) + b = (2 ^ t : ℤ) * (m + a') := by
  have hpp : (((2 ^ o : ℕ) * (2 ^ (t - o) : ℕ) : ℕ) : ℤ) = ((2 ^ t : ℕ) : ℤ) := by
    congr 1
    rw [← pow_add]
    congr 1
    omega
  have hcast : (((2 ^ o : ℕ) : ℤ) * ((2 ^ (t - o) : ℕ) : ℤ)) =
      (((2 ^ o : ℕ) * (2 ^ (t - o) : ℕ) : ℕ) : ℤ) := by
    exact (Nat.cast_mul (2 ^ o) (2 ^ (t - o))).symm
  have had : a * (((2 ^ (t - o) : ℕ) : ℤ)) = (2 ^ t : ℤ) * a' := by
    calc
      a * (((2 ^ (t - o) : ℕ) : ℤ)) = (((2 ^ o : ℕ) : ℤ) * a') * ((2 ^ (t - o) : ℕ) : ℤ) := by
        rw [hfac]
      _ = (((2 ^ o : ℕ) : ℤ) * ((2 ^ (t - o) : ℕ) : ℤ)) * a' := by ring
      _ = (((2 ^ o : ℕ) * (2 ^ (t - o) : ℕ) : ℕ) : ℤ) * a' := by rw [hcast]
      _ = ((2 ^ t : ℕ) : ℤ) * a' := by rw [hpp]
  exact bad_row_shift_m a b m n (((2 ^ (t - o) : ℕ) : ℤ)) a' hnm had

/-- Two `f_q` values along an odd-step progression are not both `q/2` (which is even). -/
lemma bad_pair_not_both_half {t : ℕ} (ht : 2 ≤ t) {m a' : ℤ} (ha' : Odd a')
    (h1 : fq (2 ^ t) m = qHalf t) (h2 : fq (2 ^ t) (m + a') = qHalf t) : False := by
  have h := fq_step_odd (by omega : 1 ≤ t) a' m ha'
  rcases h with hO | hO
  · exact not_HasOddRep_qHalf ht (by simpa [h1] using hO)
  · exact not_HasOddRep_qHalf ht (by simpa [h2] using hO)

/-- Config-I/II/III contradiction core: if `c` is a bad row (quotient `m`), then the two
structured-line values at the bad rows `c` and `c + 2^{t-o}` cannot both equal `q/2`,
provided `a = 2^o·a′` with `a′` odd and `o ≤ t` (the bad-coset spacing). -/
theorem two_bad_rows_not_both_half {t o : ℕ} (ht : 2 ≤ t) (ho : o ≤ t)
    (a a' b c m : ℤ) (hfac : a = (((2 ^ o : ℕ) : ℤ)) * a') (ha' : Odd a')
    (hbm : a * c + b = (2 ^ t : ℤ) * m)
    (hg1 : qLine (2 ^ t) a b c = qHalf t)
    (hg2 : qLine (2 ^ t) a b (c + (((2 ^ (t - o) : ℕ) : ℤ))) = qHalf t) : False := by
  have hnq := bad_row_next_quotient (t := t) (o := o) ho (a := a) (a' := a') (b := b)
    (m := m) (n := c) hfac hbm
  have hq1 : fq (2 ^ t) m = qHalf t := by
    have hv := qLine_bad_row a b m c hbm
    exact hv.symm.trans hg1
  have hq2 : fq (2 ^ t) (m + a') = qHalf t := by
    have hv := qLine_bad_row a b (m + a') (c + (((2 ^ (t - o) : ℕ) : ℤ))) hnq
    exact hv.symm.trans hg2
  exact bad_pair_not_both_half ht ha' hq1 hq2

/-- Every element of `ZMod 2` is `0` or `1`. -/
lemma zmod2_eq_zero_or_one (z : ZMod 2) : z = 0 ∨ z = 1 := by
  haveI : NeZero 2 := ⟨by norm_num⟩
  have hv : z = (z.val : ZMod 2) := (ZMod.natCast_zmod_val z).symm
  have hlt : z.val < 2 := ZMod.val_lt z
  have hge : 0 ≤ z.val := Nat.zero_le z.val
  interval_cases z.val <;> simp [hv]

/-- A coset of spacing `≥ 8` meets an `8`-window in at most one point. -/
lemma coset_window_le_one {d : ℕ} (hd : 8 ≤ d) (n₀ n0 x y : ℤ)
    (hx : ((d : ℕ) : ℤ) ∣ x - n₀) (hy : ((d : ℕ) : ℤ) ∣ y - n₀)
    (hxw : n0 ≤ x ∧ x ≤ n0 + 7) (hyw : n0 ≤ y ∧ y ≤ n0 + 7) : x = y := by
  rcases hx with ⟨kx, hkx⟩
  rcases hy with ⟨ky, hky⟩
  have hdvd : ((d : ℕ) : ℤ) ∣ y - x := by
    refine ⟨ky - kx, ?_⟩
    calc
      y - x = (y - n₀) - (x - n₀) := by ring
      _ = ((d : ℕ) : ℤ) * ky - ((d : ℕ) : ℤ) * kx := by rw [hky, hkx]
      _ = ((d : ℕ) : ℤ) * (ky - kx) := by ring
  rcases hdvd with ⟨k, hk⟩
  have hkpos : 0 ≤ k := by
    by_contra hneg0
    have hkneg : k ≤ -1 := by omega
    have hle0 : -7 ≤ y - x := by omega
    have hlt : y - x ≤ -8 := by
      calc
        y - x = ((d : ℕ) : ℤ) * k := hk
        _ ≤ ((d : ℕ) : ℤ) * (-1) := by
            exact mul_le_mul_of_nonneg_left hkneg (by omega : 0 ≤ ((d : ℕ) : ℤ))
        _ = - ((d : ℕ) : ℤ) := by ring
        _ ≤ -8 := by omega
    omega
  by_cases hk0 : k = 0
  · subst k
    have : y - x = 0 := by simpa using hk
    omega
  · have hkge1 : 1 ≤ k := by omega
    have hge8 : 8 ≤ y - x := by
      calc
        8 ≤ ((d : ℕ) : ℤ) := by omega
        _ ≤ ((d : ℕ) : ℤ) * k := by
            have h1k : (1 : ℤ) ≤ k := by omega
            simpa using (mul_le_mul_of_nonneg_left h1k (by omega : 0 ≤ ((d : ℕ) : ℤ)))
        _ = y - x := hk.symm
    have hle7 : y - x ≤ 7 := by omega
    omega

/-- Among the four points `q0, q0+2, q0+4, q0+6`, if at most one is "bad", then two
consecutive points (in `{q0, q0+2, q0+4}`) are both not bad. -/
lemma sparse_Q_free_pair {q0 : ℤ} (bad : ℤ → Prop)
    (hsp : ∀ x y : ℤ, (x = q0 ∨ x = q0 + 2 ∨ x = q0 + 4 ∨ x = q0 + 6) →
        (y = q0 ∨ y = q0 + 2 ∨ y = q0 + 4 ∨ y = q0 + 6) → bad x → bad y → x = y) :
    ∃ x : ℤ, (x = q0 ∨ x = q0 + 2 ∨ x = q0 + 4) ∧ ¬ bad x ∧ ¬ bad (x + 2) := by
  by_cases hq0 : bad q0
  · refine ⟨q0 + 4, Or.inr (Or.inr rfl), ?_, ?_⟩
    · intro hb
      have heq := hsp q0 (q0 + 4) (Or.inl rfl) (Or.inr (Or.inr (Or.inl rfl))) hq0 hb
      omega
    · intro hb
      have heq := hsp q0 (q0 + 4 + 2) (Or.inl rfl) (Or.inr (Or.inr (Or.inr (by ring)))) hq0 hb
      omega
  · by_cases hq2 : bad (q0 + 2)
    · refine ⟨q0 + 4, Or.inr (Or.inr rfl), ?_, ?_⟩
      · intro hb
        have heq := hsp (q0 + 2) (q0 + 4) (Or.inr (Or.inl rfl)) (Or.inr (Or.inr (Or.inl rfl))) hq2 hb
        omega
      · intro hb
        have heq := hsp (q0 + 2) (q0 + 4 + 2) (Or.inr (Or.inl rfl)) (Or.inr (Or.inr (Or.inr (by ring)))) hq2 hb
        omega
    · by_cases hq4 : bad (q0 + 4)
      · refine ⟨q0, Or.inl rfl, hq0, hq2⟩
      · refine ⟨q0, Or.inl rfl, hq0, hq2⟩

/-- An odd number plus an even number is odd (complement-class parity glue). -/
lemma not_even_add_even {a b : ℤ} (ha : ¬ Even a) (hb : Even b) : ¬ Even (a + b) := by
  intro h
  rcases hb with ⟨k, hk⟩
  rcases h with ⟨l, hl⟩
  apply ha
  refine ⟨l - k, ?_⟩
  calc
    a = (a + b) - b := by ring
    _ = (l + l) - (k + k) := by rw [hl, hk]
    _ = (l - k) + (l - k) := by ring

/-- If `x` is one of `q0, q0+2, q0+4`, then `x - q0` is even. -/
lemma even_sub_of_mem_pair {q0 x : ℤ} (hx : x = q0 ∨ x = q0 + 2 ∨ x = q0 + 4) :
    Even (x - q0) := by
  rcases hx with h0 | h2 | h4
  · rw [h0]
    exact ⟨0, by norm_num⟩
  · rw [h2]
    exact ⟨1, by norm_num⟩
  · rw [h4]
    exact ⟨2, by norm_num⟩

/-- `x` is in the complementary parity class of `q0` relative to `b` iff `x − q0` is
even and `q0 − b` is odd. -/
lemma not_even_sub_of_opp {b q0 x : ℤ} (hqb : ¬ Even (q0 - b))
    (hxq : Even (x - q0)) : ¬ Even (x - b) := by
  have hxy : x - b = (q0 - b) + (x - q0) := by ring
  rw [hxy]
  exact not_even_add_even hqb hxq

/-- Config-I conclusion (the `¬h1` success pattern): if the given affine `α := qAffine A B`
vanishes at `b` and `b+2` (so on the whole parity class of `b`, and equals `q/2` on the
complementary class), and `α` is not identically zero, then `α_g := qAffine sa sb` agrees
with `α` everywhere `α` is nonzero.  `Γ_g := badCoset (2^t) sa sb` is a coset of
`2^{t-ord}·ℤ` (`ord < t`), `sa = 2^{ord}·a′` with `a′` odd; `g := qLine (2^t) sa sb`
agrees with `α` on the window wherever `α ≠ 0`, and with `α_g` off `Γ_g`. -/
theorem caseI_concl {t ord : ℕ} (ht2 : 2 ≤ t) (ht1 : 1 ≤ t)
    (A B sa sb a' : ℤ) (b n0 n₀ : ℤ)
    (hA : qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0)
    (hαnz : ¬ (∀ z : ℤ, qAffine (2 ^ t) A B z = 0))
    (hordlt : ord < t)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ)) * a') (ha' : Odd a')
    (hbmem : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀))
    (hagree2 : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hagree_g : ∀ x : ℤ, x ∉ badCoset (2 ^ t) sa sb →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) sa sb x)
    (hbwin : n0 ≤ b ∧ b + 6 ≤ n0 + 7) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 →
      qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  intro z hz
  have hcl0 : ∀ z : ℤ, Even (z - b) → qAffine (2 ^ t) A B z = 0 :=
    qAffine_zero_of_even_gap ht1 A B b hA.1 hA.2
  have hclQ : ∀ z : ℤ, ¬ Even (z - b) → qAffine (2 ^ t) A B z = qHalf t :=
    qAffine_zero_pair_class_half ht1 A B b hA.1 hA.2 hαnz
  have hzne : ¬ Even (z - b) := by
    intro hEven
    exact hz (hcl0 z hEven)
  let q0 : ℤ := if b = n0 then n0 + 1 else n0
  have hbor : b = n0 ∨ b = n0 + 1 := by omega
  have hq01 : q0 = n0 ∨ q0 = n0 + 1 := by
    rcases hbor with hb | hb
    · subst b
      dsimp [q0]
      rw [if_pos rfl]
      exact Or.inr rfl
    · subst b
      dsimp [q0]
      rw [if_neg (by omega : ¬ (n0 + 1 = n0))]
      exact Or.inl rfl
  have hqwin : n0 ≤ q0 ∧ q0 + 6 ≤ n0 + 7 := by
    rcases hbor with hb | hb
    · subst b
      dsimp [q0]
      rw [if_pos rfl]
      constructor <;> omega
    · subst b
      dsimp [q0]
      rw [if_neg (by omega : ¬ (n0 + 1 = n0))]
      constructor <;> omega
  have hqopp : ¬ Even (q0 - b) := by
    rcases hbor with hb | hb
    · subst b
      dsimp [q0]
      rw [if_pos rfl]
      have : (n0 + 1) - n0 = 1 := by ring
      rw [this]
      norm_num
    · subst b
      dsimp [q0]
      rw [if_neg (by omega : ¬ (n0 + 1 = n0))]
      have : n0 - (n0 + 1) = -1 := by ring
      rw [this]
      norm_num
  let badQ : ℤ → Prop := fun x => x ∈ badCoset (2 ^ t) sa sb
  have hbadcos : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → badQ x →
      (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀) := by
    intro x hx0 hx1 hb
    exact (hbmem x).mp hb
  let d : ℤ := ((2 ^ (t - ord) : ℕ) : ℤ)
  have hdpos : 0 < d := by
    dsimp [d]
    exact_mod_cast pow_pos (by norm_num : 0 < (2 : ℕ)) (t - ord)
  have hspacing : d = ((2 ^ (t - ord) : ℕ) : ℤ) := rfl
  -- Two bad rows c, c+d of the Q-class in the window give the parity contradiction:
  have hbig_contr : (∃ c : ℤ, (c = q0 ∨ c = q0 + 2 ∨ c = q0 + 4) ∧ badQ c ∧
        badQ (c + d) ∧ n0 ≤ c ∧ c + d ≤ n0 + 7) → False := by
    intro hbig
    rcases hbig with ⟨c, hcmem, hbc, hbc2, hcw0, hcw2⟩
    -- c is in the complementary class of b: α(c) = q/2
    have hcopp : ¬ Even (c - b) := by
      rcases hcmem with hc0 | hc2 | hc4
      · subst c; exact hqopp
      · subst c
        have hxq : Even ((q0 + 2) - q0) := ⟨1, by norm_num⟩
        exact not_even_sub_of_opp hqopp hxq
      · subst c
        have hxq : Even ((q0 + 4) - q0) := ⟨2, by norm_num⟩
        exact not_even_sub_of_opp hqopp hxq
    have hcq : qAffine (2 ^ t) A B c = qHalf t := hclQ c hcopp
    have hdev : Even d := by
      dsimp [d]
      exact (even_iff_two_dvd).mpr (two_dvd_two_pow_int (t := t - ord) (by omega))
    have hcq2 : qAffine (2 ^ t) A B (c + d) = qHalf t := by
      -- (c + d) − b = (c − b) + d; c−b odd and d even force c+d−b odd
      have hcnot : ¬ Even (c + d - b) := by
        intro hE
        rcases hE with ⟨l, hl⟩
        rcases hdev with ⟨k, hk⟩
        have : Even (c - b) := by
          refine ⟨l - k, ?_⟩
          calc
            c - b = (c + d - b) - d := by ring
            _ = (l + l) - (k + k) := by rw [hl, hk]
            _ = (l - k) + (l - k) := by ring
        exact hcopp this
      exact hclQ (c + d) hcnot
    -- window hypothesis: g(c) = g(c+d) = q/2
    have hg1 : qLine (2 ^ t) sa sb c = qHalf t := by
      have hnz0 : qAffine (2 ^ t) A B c ≠ 0 := by rw [hcq]; exact qHalf_ne_zero ht1
      have hc1 : c ≤ n0 + 7 := by omega
      have hg := hagree2 c hcw0 hc1 hnz0
      rw [hcq] at hg
      exact hg
    have hg2 : qLine (2 ^ t) sa sb (c + d) = qHalf t := by
      have hnz0 : qAffine (2 ^ t) A B (c + d) ≠ 0 := by rw [hcq2]; exact qHalf_ne_zero ht1
      have hg := hagree2 (c + d) (by omega) hcw2 hnz0
      rw [hcq2] at hg
      exact hg
    -- c ∈ Γ_g gives the quotient m
    have hz0 : (((sa * c + sb : ℤ)) : ZMod (2 ^ t)) = 0 := by
      have hmem : c ∈ badCoset (2 ^ t) sa sb := hbc
      have hzero : qAffine (2 ^ t) sa sb c = 0 := by simpa [badCoset] using hmem
      simpa [qAffine, Int.cast_add, Int.cast_mul] using hzero
    have hdivc : ∃ m : ℤ, sa * c + sb = (2 ^ t : ℤ) * m := by
      exact (ZMod.intCast_zmod_eq_zero_iff_dvd (sa * c + sb) (2 ^ t)).mp hz0
    rcases hdivc with ⟨m, hm⟩
    have hd' : (2 ^ (t - ord) : ℕ) = (2 ^ (t - ord) : ℕ) := rfl
    have hbadrows := two_bad_rows_not_both_half (t := t) (o := ord) ht2 (by omega : ord ≤ t)
      sa a' sb c m hfac ha' hm
      (by simpa [d, hspacing] using hg1) (by simpa [d, hspacing] using hg2)
    exact hbadrows
  by_cases hbig : ∃ c : ℤ, (c = q0 ∨ c = q0 + 2 ∨ c = q0 + 4) ∧ badQ c ∧
      badQ (c + d) ∧ n0 ≤ c ∧ c + d ≤ n0 + 7
  · exact False.elim (hbig_contr hbig)
  · -- no bad-row pair: the Q-window class has at most one bad point; a free consecutive
    -- pair exists, and config_I_success gives the claim.
    have hspQ : ∀ x y : ℤ,
        (x = q0 ∨ x = q0 + 2 ∨ x = q0 + 4 ∨ x = q0 + 6) →
        (y = q0 ∨ y = q0 + 2 ∨ y = q0 + 4 ∨ y = q0 + 6) → badQ x → badQ y → x = y := by
      intro x y hx4 hy4 hbx hby
      by_cases hge3 : 3 ≤ t - ord
      · -- spacing ≥ 8: coset meets the window in ≤ 1 point
        exact coset_window_le_one (d := 2 ^ (t - ord))
          (by
            have h2 := Nat.pow_le_pow_right (by norm_num : 1 ≤ (2 : ℕ)) hge3
            -- 2^3 = 8 ≤ 2^(t-ord)
            have h83 : 8 ≤ 2 ^ 3 := by norm_num
            exact le_trans h83 h2)
          n₀ n0 x y
          ((hbadcos x (by
            rcases hx4 with hx0 | hx2 | hx4' | hx6
            · rw [hx0]; exact hqwin.1
            · rw [hx2]; omega
            · rw [hx4']; omega
            · rw [hx6]; omega) (by
            rcases hx4 with hx0 | hx2 | hx4' | hx6
            · rw [hx0]; omega
            · rw [hx2]; omega
            · rw [hx4']; omega
            · rw [hx6]; omega) hbx))
          ((hbadcos y (by
            rcases hy4 with hy0 | hy2 | hy4' | hy6
            · rw [hy0]; exact hqwin.1
            · rw [hy2]; omega
            · rw [hy4']; omega
            · rw [hy6]; omega) (by
            rcases hy4 with hy0 | hy2 | hy4' | hy6
            · rw [hy0]; omega
            · rw [hy2]; omega
            · rw [hy4']; omega
            · rw [hy6]; omega) hby))
          ⟨by omega, by omega⟩ ⟨by omega, by omega⟩
      · -- spacing 2 or 4: two bad Q-window points at distance d would be an hbig witness
        by_cases hd4 : t - ord = 2
        · -- spacing 4
          have hdv : (4 : ℤ) ∣ y - x := by
            -- d = 4 divides y - x
            have hdx' : (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀) :=
              hbadcos x (by omega) (by omega) hbx
            have hdy' : (((2 ^ (t - ord) : ℕ) : ℤ) ∣ y - n₀) :=
              hbadcos y (by omega) (by omega) hby
            have hsub : (((2 ^ (t - ord) : ℕ) : ℤ) ∣ (y - n₀) - (x - n₀)) := dvd_sub hdy' hdx'
            have hd4z : ((2 ^ (t - ord) : ℕ) : ℤ) = (4 : ℤ) := by
              rw [hd4]
              norm_num
            rw [hd4z] at hsub
            convert hsub using 1 <;> ring
          rcases hdv with ⟨k, hk⟩
          have hkrange : k = 0 ∨ k = 1 ∨ k = -1 := by
            have hbnd1 : y - x ≤ 7 := by omega
            have hbnd2 : -7 ≤ y - x := by omega
            have : -7 ≤ 4 * k ∧ 4 * k ≤ 7 := by
              rw [← hk]
              constructor <;> omega
            omega
          rcases hkrange with hk0 | hk1 | hkm1
          · rw [hk0, mul_zero] at hk
            omega
          · -- y = x + 4 : hbig witness c = x
            have hk1' : y - x = 4 := by
              rw [hk1] at hk
              norm_num at hk
              exact hk
            have hyle : y ≤ q0 + 6 := by
              rcases hy4 with hy0 | hy2 | hy4c | hy6
              · rw [hy0]; omega
              · rw [hy2]; omega
              · rw [hy4c]; omega
              · rw [hy6]
            have hx3 : x = q0 ∨ x = q0 + 2 ∨ x = q0 + 4 := by
              rcases hx4 with hx0 | hx2 | hx4c | hx6
              · exact Or.inl hx0
              · exact Or.inr (Or.inl hx2)
              · exact Or.inr (Or.inr hx4c)
              · exfalso
                subst x
                omega
            exfalso
            apply hbig
            refine ⟨x, hx3, hbx, ?_, ?_, ?_⟩
            · -- x + 4 ∈ Γg : y = x + 4 ∈ Γg
              have hyeq : x + d = y := by
                dsimp [d]
                rw [hd4]
                norm_num
                omega
              rw [hyeq]
              exact hby
            · rcases hx3 with hx0 | hx2 | hx4c
              · rw [hx0]; omega
              · rw [hx2]; omega
              · rw [hx4c]; omega
            · dsimp [d]
              rw [hd4]
              norm_num
              omega
          · -- y = x - 4 : hbig witness c = y
            have hkm1' : y - x = -4 := by
              rw [hkm1] at hk
              norm_num at hk
              exact hk
            have hy3 : y = q0 ∨ y = q0 + 2 ∨ y = q0 + 4 := by
              rcases hy4 with hy0 | hy2 | hy4c | hy6
              · exact Or.inl hy0
              · exact Or.inr (Or.inl hy2)
              · exact Or.inr (Or.inr hy4c)
              · exfalso
                subst y
                omega
            exfalso
            apply hbig
            refine ⟨y, hy3, hby, ?_, ?_, ?_⟩
            · have hxeq : y + d = x := by
                dsimp [d]
                rw [hd4]
                norm_num
                omega
              rw [hxeq]
              exact hbx
            · rcases hy3 with hy0 | hy2 | hy4c
              · rw [hy0]; omega
              · rw [hy2]; omega
              · rw [hy4c]; omega
            · dsimp [d]
              rw [hd4]
              norm_num
              omega
        · -- spacing 2 (t − ord = 1)
          have hto1 : t - ord = 1 := by omega
          have hd2z : ((2 ^ (t - ord) : ℕ) : ℤ) = (2 : ℤ) := by
            rw [hto1]
            norm_num
          have hdx' : (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀) := hbadcos x (by omega) (by omega) hbx
          have hdy' : (((2 ^ (t - ord) : ℕ) : ℤ) ∣ y - n₀) := hbadcos y (by omega) (by omega) hby
          -- x + d ∈ Γ_g (spacing 2): closure
          have hxdp : badQ (x + d) := by
            dsimp [badQ]
            rw [hbmem]
            have hx2 : (2 : ℤ) ∣ x - n₀ := by
              simpa [hd2z] using hdx'
            have h2dd : (2 : ℤ) ∣ d := by
              dsimp [d]
              rw [hto1]
              norm_num
            have hsum : (x - n₀) + d = (x + d) - n₀ := by ring
            rw [hd2z, ← hsum]
            exact dvd_add hx2 h2dd
          -- if x ∈ {q0,q0+2,q0+4} then (x, x+d) is an hbig witness; else x = q0+6 and
          -- (q0+4, q0+6) is one (x − d ∈ Γ_g by spacing-2 closure).
          rcases hx4 with hx0 | hx2 | hx4c | hx6
          · exfalso
            apply hbig
            refine ⟨x, Or.inl hx0, hbx, hxdp, ?_, ?_⟩
            · rw [hx0]; exact hqwin.1
            · dsimp [d]; rw [hto1]; norm_num; omega
          · exfalso
            apply hbig
            refine ⟨x, Or.inr (Or.inl hx2), hbx, hxdp, ?_, ?_⟩
            · rw [hx2]; omega
            · dsimp [d]; rw [hto1]; norm_num; omega
          · exfalso
            apply hbig
            refine ⟨x, Or.inr (Or.inr hx4c), hbx, hxdp, ?_, ?_⟩
            · rw [hx4c]; omega
            · dsimp [d]; rw [hto1]; norm_num; omega
          · exfalso
            apply hbig
            -- witness c := x - d (= q0 + 4); c ∈ Γ_g by closure from x
            have hxminusd : badQ (x - d) := by
              dsimp [badQ]
              rw [hbmem]
              have hx2' : (2 : ℤ) ∣ x - n₀ := by simpa [hd2z] using hdx'
              have h2dd : (2 : ℤ) ∣ d := by
                dsimp [d]
                rw [hto1]
                norm_num
              have hsub : (2 : ℤ) ∣ (x - n₀) - d := dvd_sub hx2' h2dd
              have hconv : (x - n₀) - d = (x - d) - n₀ := by ring
              rw [hd2z, ← hconv]
              exact hsub
            have hd2 : d = 2 := by
              dsimp [d]
              rw [hto1]
              norm_num
            have hxmind : x - d = q0 + 4 := by
              rw [hx6, hd2]
              ring
            have hcm' : x - d = q0 ∨ x - d = q0 + 2 ∨ x - d = q0 + 4 := by
              rw [hxmind]
              exact Or.inr (Or.inr rfl)
            have hxplus : (x - d) + d = x := by ring
            have hxd2 : badQ ((x - d) + d) := by
              rwa [hxplus]
            refine ⟨x - d, hcm', hxminusd, hxd2, ?_, ?_⟩
            · rw [hxmind]; omega
            · rw [hxmind, hd2]; omega
    -- sparse_Q_free_pair gives x with x, x+2 free:
    rcases sparse_Q_free_pair (q0 := q0) badQ hspQ with ⟨x, hxmem, hxfr, hx2fr⟩
    -- x and x+2 are window points of the complementary class with α = q/2 there, and
    -- both off Γ_g, so α_g = α at both; config_I_success gives the global claim.
    have hxwin : n0 ≤ x ∧ x + 2 ≤ n0 + 7 := by
      rcases hxmem with hx0 | hx2 | hx4
      · rw [hx0]; exact ⟨hqwin.1, by omega⟩
      · rw [hx2]; exact ⟨by omega, by omega⟩
      · rw [hx4]; constructor <;> omega
    have hxopp : ¬ Even (x - b) := by
      rcases hxmem with hx0 | hx2 | hx4
      · rw [hx0]; exact hqopp
      · rw [hx2]
        have hxq : Even ((q0 + 2) - q0) := ⟨1, by norm_num⟩
        exact not_even_sub_of_opp hqopp hxq
      · rw [hx4]
        have hxq : Even ((q0 + 4) - q0) := ⟨2, by norm_num⟩
        exact not_even_sub_of_opp hqopp hxq
    have hx2opp : ¬ Even (x + 2 - b) := by
      have hxq : Even (x + 2 - x) := ⟨1, by norm_num⟩
      exact not_even_sub_of_opp hxopp hxq
    have hαx : qAffine (2 ^ t) A B x = qHalf t := hclQ x hxopp
    have hαx2 : qAffine (2 ^ t) A B (x + 2) = qHalf t := hclQ (x + 2) hx2opp
    have hqx1 : qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x := by
      have hnz0 : qAffine (2 ^ t) A B x ≠ 0 := by rw [hαx]; exact qHalf_ne_zero ht1
      exact hagree2 x hxwin.1 (by omega) hnz0
    have hqx2 : qLine (2 ^ t) sa sb (x + 2) = qAffine (2 ^ t) A B (x + 2) := by
      have hnz0 : qAffine (2 ^ t) A B (x + 2) ≠ 0 := by rw [hαx2]; exact qHalf_ne_zero ht1
      exact hagree2 (x + 2) (by omega) hxwin.2 hnz0
    have hAg1 : qAffine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x := by
      have hg := hagree_g x (by exact hxfr)
      exact hg.symm.trans hqx1
    have hAg2 : qAffine (2 ^ t) sa sb (x + 2) = qAffine (2 ^ t) A B (x + 2) := by
      have hg := hagree_g (x + 2) (by exact hx2fr)
      exact hg.symm.trans hqx2
    exact config_I_success ht1 sa sb A B b x hA.1 hA.2 hαnz hAg1 hAg2 hxopp z hz

/-- An element with an even integer representative has no odd representative. -/
lemma not_HasOddRep_of_even_rep {t : ℕ} (ht : 1 ≤ t) {z : ZMod (2 ^ t)} (n : ℤ)
    (hn : Even n) (hz : (n : ZMod (2 ^ t)) = z) : ¬ HasOddRep z := by
  intro h
  rcases h with ⟨r, hr, hzr⟩
  have hrz : (r : ZMod (2 ^ t)) = z := hzr
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ n - r := by
    exact (ZMod.intCast_eq_intCast_iff_dvd_sub r n (2 ^ t)).mp (hzr.trans hz.symm)
  have h2dvd' : (2 : ℤ) ∣ n - r := dvd_trans (two_dvd_two_pow_int (t := t) ht) hdvd
  have h2dvd : (2 : ℤ) ∣ r - n := by
    rcases h2dvd' with ⟨u, hu⟩
    refine ⟨-u, ?_⟩
    omega
  have hodd : Odd (r - n) := by
    rcases hr with ⟨k, hk⟩
    rcases hn with ⟨l, hl⟩
    refine ⟨k - l, ?_⟩
    calc
      r - n = (2 * k + 1) - (l + l) := by rw [hk, hl]
      _ = 2 * (k - l) + 1 := by ring
  rcases hodd with ⟨w, hw⟩
  rcases h2dvd with ⟨u, hu⟩
  omega

/-- Two `f_q` values along an odd-step progression are not both without odd
representatives. -/
lemma bad_pair_no_odd_rep {t : ℕ} (ht : 2 ≤ t) {m a' : ℤ} (ha' : Odd a')
    (h1 : ¬ HasOddRep (fq (2 ^ t) m)) (h2 : ¬ HasOddRep (fq (2 ^ t) (m + a'))) : False := by
  have h := fq_step_odd (by omega : 1 ≤ t) a' m ha'
  rcases h with hO | hO
  · exact h1 hO
  · exact h2 hO

/-- Two bad rows whose structured-line values both lack odd representatives contradict
the `f_q`-value structure. -/
theorem two_bad_rows_no_odd_rep {t o : ℕ} (ht : 2 ≤ t) (ho : o ≤ t)
    (a a' b c m : ℤ) (hfac : a = (((2 ^ o : ℕ) : ℤ)) * a') (ha' : Odd a')
    (hbm : a * c + b = (2 ^ t : ℤ) * m)
    (hg1 : ¬ HasOddRep (qLine (2 ^ t) a b c))
    (hg2 : ¬ HasOddRep (qLine (2 ^ t) a b (c + (((2 ^ (t - o) : ℕ) : ℤ))))) : False := by
  have hnq := bad_row_next_quotient (t := t) (o := o) ho (a := a) (a' := a') (b := b)
    (m := m) (n := c) hfac hbm
  have hq1 : ¬ HasOddRep (fq (2 ^ t) m) := by
    have hv := qLine_bad_row a b m c hbm
    intro hO
    apply hg1
    simpa [hv.symm] using hO
  have hq2 : ¬ HasOddRep (fq (2 ^ t) (m + a')) := by
    have hv := qLine_bad_row a b (m + a') (c + (((2 ^ (t - o) : ℕ) : ℤ))) hnq
    intro hO
    apply hg2
    simpa [hv.symm] using hO
  exact bad_pair_no_odd_rep ht ha' hq1 hq2

/-- Config-III contradiction: `Γ_g ⊇ {c, c+4}` and `Γ ⊇ {c+2, c+6}` (`c ∈ {b, b+2}`),
spacing of `Γ_g` is `4` (`t − ord = 2`), and `α` is not constant on the class of `b`:
the values of `g` at the two bad rows `c, c+4` are forced to be `q/2`, contradicting the
`f_q` structure. -/
theorem caseIII_contr {t ord : ℕ} (ht2 : 2 ≤ t) (ht1 : 1 ≤ t)
    (A B sa sb a' : ℤ) (b c n0 n₀ : ℤ)
    (hordlt : ord < t)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ)) * a') (ha' : Odd a')
    (hbmem : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - n₀))
    (hA : ¬ (qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0))
    (hsp4 : t - ord = 2)
    (hc : c = b ∨ c = b + 2)
    (hΓ2 : qAffine (2 ^ t) A B (c + 2) = 0) (hΓ6 : qAffine (2 ^ t) A B (c + 6) = 0)
    (hgc : c ∈ badCoset (2 ^ t) sa sb) (hgc4 : c + 4 ∈ badCoset (2 ^ t) sa sb)
    (hagree2 : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hbwin : n0 ≤ b ∧ b + 6 ≤ n0 + 7) :
    False := by
  -- α(c) ≠ 0 (else α would vanish on the whole class of b: hA)
  have hcnz : qAffine (2 ^ t) A B c ≠ 0 := by
    intro hc0
    apply hA
    have hcl := qAffine_zero_of_even_gap ht1 A B c hc0 hΓ2
    rcases hc with hb | hb
    · subst c
      constructor
      · exact hcl b (⟨0, by norm_num⟩ : Even (b - b))
      · exact hcl (b + 2) (⟨1, by norm_num⟩ : Even ((b + 2) - b))
    · subst c
      -- c = b + 2: zeros at b+2,b+4 → class of b is zero
      constructor
      · have hz : Even (b - (b + 2)) := ⟨-1, by ring⟩
        exact hcl b hz
      · exact hcl (b + 2) (⟨0, by norm_num⟩ : Even ((b + 2) - (b + 2)))
  -- α(c) = α(c+4) = q/2 (zeros at c+2,c+6 give the q/2-value)
  have hcq : qAffine (2 ^ t) A B c = qHalf t :=
    qAffine_gap4_value_half ht1 A B c hΓ2 hΓ6 hcnz
  have hc4q : qAffine (2 ^ t) A B (c + 4) = qHalf t := by
    -- α(c+4) − α(c) = 4·slope = 0 (zeros c+2,c+6)
    have hd6 : qAffine (2 ^ t) A B (c + 6) - qAffine (2 ^ t) A B (c + 2) = 0 := by
      rw [hΓ6, hΓ2]
      simp
    have hdiff4 : qAffine (2 ^ t) A 0 4 = 0 := by
      have h := qAffine_diff (2 ^ t) A B (c + 2) (c + 6)
      rw [show ((c + 6) - (c + 2) : ℤ) = 4 by ring] at h
      exact h.symm.trans hd6
    have h4 : qAffine (2 ^ t) A B (c + 4) - qAffine (2 ^ t) A B c = 0 := by
      have h := qAffine_diff (2 ^ t) A B c (c + 4)
      rw [show ((c + 4) - c : ℤ) = 4 by ring] at h
      rw [h]
      exact hdiff4
    have heq : qAffine (2 ^ t) A B (c + 4) = qAffine (2 ^ t) A B c := sub_eq_zero.mp h4
    rw [heq, hcq]
  -- window bounds on c, c+4:
  have hcw : n0 ≤ c ∧ c + 4 ≤ n0 + 7 := by
    rcases hc with hb | hb
    · subst c
      exact ⟨hbwin.1, by omega⟩
    · subst c
      exact ⟨by omega, by omega⟩
  -- window hypothesis: g(c) = g(c+4) = q/2
  have hg1 : qLine (2 ^ t) sa sb c = qHalf t := by
    have hnz0 : qAffine (2 ^ t) A B c ≠ 0 := by rw [hcq]; exact qHalf_ne_zero ht1
    have hg := hagree2 c hcw.1 (by omega) hnz0
    rwa [hcq] at hg
  have hg2 : qLine (2 ^ t) sa sb (c + 4) = qHalf t := by
    have hnz0 : qAffine (2 ^ t) A B (c + 4) ≠ 0 := by rw [hc4q]; exact qHalf_ne_zero ht1
    have hg := hagree2 (c + 4) (by omega) hcw.2 hnz0
    rwa [hc4q] at hg
  -- quotient at the bad row c:
  have hz0 : (((sa * c + sb : ℤ)) : ZMod (2 ^ t)) = 0 := by
    have hzero : qAffine (2 ^ t) sa sb c = 0 := by simpa [badCoset] using hgc
    simpa [qAffine, Int.cast_add, Int.cast_mul] using hzero
  have hdivc : ∃ m : ℤ, sa * c + sb = (2 ^ t : ℤ) * m := by
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (sa * c + sb) (2 ^ t)).mp hz0
  rcases hdivc with ⟨m, hm⟩
  -- spacing 2^{t-ord} = 4, so rows are c and c+4:
  have hrows : c + (((2 ^ (t - ord) : ℕ) : ℤ)) = c + 4 := by
    rw [hsp4]
    norm_num
  rw [← hrows] at hg2
  have hbadrows := two_bad_rows_not_both_half (t := t) (o := ord) ht2 (by omega : ord ≤ t)
    sa a' sb c m hfac ha' hm hg1 hg2
  exact hbadrows

/-- `(q/2)·u = q/2` for every odd integer `u` (`t ≥ 1`). -/
lemma qHalf_mul_odd {t : ℕ} (ht : 1 ≤ t) (u : ℤ) (hu : Odd u) :
    qHalf t * (u : ZMod (2 ^ t)) = qHalf t := by
  rcases hu with ⟨k, hk⟩
  have hz : (2 : ZMod (2 ^ t)) * qHalf t = 0 := two_mul_qHalf ht
  calc
    qHalf t * (u : ZMod (2 ^ t)) = qHalf t * ((2 * k + 1 : ℤ) : ZMod (2 ^ t)) := by rw [hk]
    _ = qHalf t * ((2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) + 1) := by
        rw [Int.cast_add, Int.cast_mul]
        norm_num
    _ = (qHalf t * (2 : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) + qHalf t := by ring
    _ = qHalf t := by
        rw [show qHalf t * (2 : ZMod (2 ^ t)) = (2 : ZMod (2 ^ t)) * qHalf t by ring]
        rw [hz]
        simp

/-- An element `q/4`-multiple with odd coefficient has no odd representative
(`t ≥ 3`, so `q/4 = 2^{t-2}` is even). -/
lemma not_HasOddRep_qFourth_mul_odd {t : ℕ} (ht : 3 ≤ t) (m : ℤ) (hm : Odd m) :
    ¬ HasOddRep (qFourth t * (m : ZMod (2 ^ t))) := by
  have hcast : qFourth t * (m : ZMod (2 ^ t)) =
      (((((2 ^ (t - 2) : ℕ) : ℤ) * m) : ℤ) : ZMod (2 ^ t)) := by
    dsimp [qFourth]
    rw [Int.cast_mul]
    simp
  rw [hcast]
  apply not_HasOddRep_of_even_rep (by omega : 1 ≤ t) (((2 ^ (t - 2) : ℕ) : ℤ) * m)
  · rw [even_iff_two_dvd]
    have h2pow : (2 : ℤ) ∣ ((2 ^ (t - 2) : ℕ) : ℤ) := two_dvd_two_pow_int (t := t - 2) (by omega)
    exact dvd_trans h2pow (dvd_mul_right ((2 ^ (t - 2) : ℕ) : ℤ) m)
  · rfl

/-- If `2·x = q/2` in `ZMod (2^t)` (`t ≥ 2`), then `x` is an odd multiple of `q/4`. -/
lemma zmod_two_mul_qHalf_eq_qFourth_mul_odd {t : ℕ} (ht : 2 ≤ t) {x : ZMod (2 ^ t)}
    (h : (2 : ZMod (2 ^ t)) * x = qHalf t) :
    ∃ u : ℤ, Odd u ∧ x = qFourth t * (u : ZMod (2 ^ t)) := by
  have hq2 : (2 : ZMod (2 ^ t)) * qFourth t = qHalf t := by
    have hq := qFourth_mul_two ht
    simpa [mul_comm] using hq
  have hdiff : (2 : ZMod (2 ^ t)) * (x - qFourth t) = 0 := by
    rw [mul_sub, h]
    rw [hq2]
    simp
  rcases zmod_two_mul_eq_zero_half (by omega : 1 ≤ t) hdiff with hy0 | hyhalf
  · refine ⟨1, by norm_num, ?_⟩
    have hx : x = qFourth t := sub_eq_zero.mp hy0
    rw [hx]
    simp
  · refine ⟨3, by norm_num, ?_⟩
    have hx : x = qHalf t + qFourth t := by
      have hsplit : x = (x - qFourth t) + qFourth t := by ring
      rw [hsplit, hyhalf]
    rw [hx]
    have hQ2 : qHalf t = qFourth t * (2 : ZMod (2 ^ t)) := (qFourth_mul_two ht).symm
    have h3 : qFourth t * ((3 : ℤ) : ZMod (2 ^ t)) = qHalf t + qFourth t := by
      have hz : ((3 : ℤ) : ZMod (2 ^ t)) = (2 : ZMod (2 ^ t)) + 1 := by norm_num
      rw [hz, mul_add, hQ2]
      simp
    exact h3.symm

/-- Two members of a coset of spacing `d` at distance `2` force `d ≤ 2`. -/
lemma two_mem_coset_spacing_le_one {d : ℕ} {a : ℤ} {x y : ℤ}
    (hx : ((d : ℕ) : ℤ) ∣ x - a) (hy : ((d : ℕ) : ℤ) ∣ y - a) (hxy : y - x = 2) :
    d ≤ 2 := by
  have hsub : ((d : ℕ) : ℤ) ∣ (y - a) - (x - a) := dvd_sub hy hx
  rcases hsub with ⟨k, hk⟩
  have hcv : (y - a) - (x - a) = y - x := by ring
  have hk2 : ((d : ℕ) : ℤ) * k = 2 := by
    calc
      ((d : ℕ) : ℤ) * k = (y - a) - (x - a) := hk.symm
      _ = y - x := hcv
      _ = 2 := hxy
  by_cases hd0 : d = 0
  · omega
  · have hdposN : 0 < d := Nat.pos_of_ne_zero hd0
    have kpos : 0 ≤ k := by
      by_contra hneg
      have hneg' : k < 0 := by omega
      have hle0 : ((d : ℕ) : ℤ) * k < 0 :=
        mul_neg_of_pos_of_neg (by exact_mod_cast hdposN) hneg'
      rw [hk2] at hle0
      omega
    have kge1 : 1 ≤ k := by
      by_contra hk0
      have hk0' : k = 0 := by omega
      rw [hk0', mul_zero] at hk2
      norm_num at hk2
    have hm : (d : ℤ) * 1 ≤ (d : ℤ) * k :=
      mul_le_mul_of_nonneg_left kge1 (le_of_lt (by exact_mod_cast hdposN))
    rw [hk2] at hm
    have hd2 : (d : ℤ) ≤ 2 := by simpa using hm
    exact_mod_cast hd2

/-- Pure affine window extension (the content of the order-`−∞` branch): if the affine
function `qAffine a b` agrees with the affine function `qAffine A B` on the `8`-integer
window `{n0..n0+7}` wherever the latter is nonzero, then it agrees with it on every
integer `z` wherever the latter is nonzero.

PROOF PLAN (needs `qAffine_zero_of_odd_gap` and `qAffine_zero_of_even_gap`, both
proved in `sudoku_stats`): let `D := qAffine (a−A) (b−B)` (difference of the two affine
functions; `qAffine_sub`).  By hypothesis `D = 0` on window points with `qAffine A B ≠ 0`.
If the window contains an odd-separated pair of points where `qAffine A B ≠ 0`, then
`qAffine_zero_of_odd_gap` gives `D ≡ 0`.  Otherwise all window points with
`qAffine A B ≠ 0` share one parity; the four window points of the other parity then
carry zeros of `qAffine A B`, so `qAffine_zero_of_even_gap` forces `qAffine A B ≡ 0` on
that whole parity class — and (since a zero of both parities would give an odd-gap pair)
`qAffine A B ≠ 0` on all window points of the surviving parity, where `D = 0`; the even-gap
lemma again gives `D ≡ 0` on that parity class, which is the parity of `z`.  This helper
is assumed for now; it is the single remaining step of the order-`−∞` branch. -/
lemma qAffine_window_extend {t : ℕ} (ht : 1 ≤ t) (a b A B n0 : ℤ)
    (hagree : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qAffine (2 ^ t) a b x = qAffine (2 ^ t) A B x) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) a b z = qAffine (2 ^ t) A B z := by
  classical
  let A0 : ℤ := a - A
  let B0 : ℤ := b - B
  have hD : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
      qAffine (2 ^ t) A0 B0 x = 0 := by
    intro x hx0 hx1 hαx
    have hEq := hagree x hx0 hx1 hαx
    calc
      qAffine (2 ^ t) A0 B0 x = qAffine (2 ^ t) a b x - qAffine (2 ^ t) A B x := by
          dsimp [A0, B0]
          exact (qAffine_sub (2 ^ t) a b A B x).symm
      _ = 0 := by rw [hEq]; ring
  intro z hαz
  -- Case 1: an odd-separated pair of window points where qAffine A B is nonzero.
  by_cases h1 : ∃ x : ℤ, n0 ≤ x ∧ x ≤ n0 + 7 ∧ qAffine (2 ^ t) A B x ≠ 0 ∧
                 ∃ y : ℤ, n0 ≤ y ∧ y ≤ n0 + 7 ∧ qAffine (2 ^ t) A B y ≠ 0 ∧ Odd (y - x)
  · rcases h1 with ⟨x, hx0, hx1, hαx, y, hy0, hy1, hαy, hodd⟩
    have hDx := hD x hx0 hx1 hαx
    have hDy := hD y hy0 hy1 hαy
    have hDz := qAffine_zero_of_odd_gap ht A0 B0 hodd hDx hDy z
    have h0 : qAffine (2 ^ t) (a - A) (b - B) z = 0 := by simpa [A0, B0] using hDz
    exact sub_eq_zero.mp ((qAffine_sub (2 ^ t) a b A B z).trans h0)
  · -- Case 2: no odd-separated nonzero pair in the window.
    have hCore : ∀ w0 : ℤ, n0 ≤ w0 → w0 ≤ n0 + 1 → Even (z - w0) →
        qAffine (2 ^ t) A0 B0 z = 0 := by
      intro w0 hw0a hw0b hzw
      have hw0win : n0 ≤ w0 ∧ w0 ≤ n0 + 7 := ⟨hw0a, by omega⟩
      have hw2win : n0 ≤ w0 + 2 ∧ w0 + 2 ≤ n0 + 7 := by omega
      let u0 : ℤ := w0 + 1
      have hu0win : n0 ≤ u0 ∧ u0 ≤ n0 + 7 := by omega
      -- (A) a nonzero window point p* of the parity of z, with p* = w0 or p* = w0+2
      have hwit : (qAffine (2 ^ t) A B w0 ≠ 0) ∨ (qAffine (2 ^ t) A B (w0 + 2) ≠ 0) := by
        by_cases hw : qAffine (2 ^ t) A B w0 ≠ 0
        · exact Or.inl hw
        · right
          by_contra hw2
          have hw0z : qAffine (2 ^ t) A B w0 = 0 := by simpa using hw
          have hα := qAffine_zero_of_even_gap ht A B w0 hw0z hw2 z hzw
          exact hαz hα
      -- (B) the other-parity window point u0 is a zero of qAffine A B
      have hu0z : qAffine (2 ^ t) A B u0 = 0 := by
        by_contra hu0nz
        rcases hwit with hw0nz | hw2nz
        · have hodd : Odd (u0 - w0) := by
            have hc : u0 - w0 = (1 : ℤ) := by dsimp [u0]; ring
            simpa [hc] using (by norm_num : Odd (1 : ℤ))
          exact (h1) ⟨w0, hw0win.1, hw0win.2, hw0nz, u0, hu0win.1, hu0win.2, hu0nz, hodd⟩
        · have hodd : Odd (u0 - (w0 + 2)) := by
            have hc : u0 - (w0 + 2) = (-1 : ℤ) := by dsimp [u0]; ring
            simpa [hc] using (by norm_num : Odd (-1 : ℤ))
          exact (h1) ⟨w0 + 2, hw2win.1, hw2win.2, hw2nz, u0, hu0win.1, hu0win.2, hu0nz, hodd⟩
      -- (C1) qAffine A B is nonzero at w0
      have hw0nz : qAffine (2 ^ t) A B w0 ≠ 0 := by
        by_contra hw0z
        rcases hwit with hw0nz | hw2nz
        · exact hw0nz hw0z
        · have hodd : Odd (u0 - w0) := by
            have hc : u0 - w0 = (1 : ℤ) := by dsimp [u0]; ring
            simpa [hc] using (by norm_num : Odd (1 : ℤ))
          have hα := qAffine_zero_of_odd_gap ht A B hodd hw0z hu0z z
          exact hαz hα
      -- (C2) qAffine A B is nonzero at w0+2
      have hw2nz : qAffine (2 ^ t) A B (w0 + 2) ≠ 0 := by
        by_contra hw2z
        have hodd : Odd (u0 - (w0 + 2)) := by
          have hc : u0 - (w0 + 2) = (-1 : ℤ) := by dsimp [u0]; ring
          simpa [hc] using (by norm_num : Odd (-1 : ℤ))
        have hα := qAffine_zero_of_odd_gap ht A B hodd hw2z hu0z z
        exact hαz hα
      -- D vanishes at w0 and w0+2, so on the whole parity class of w0 (which contains z)
      have hDw0 := hD w0 hw0win.1 hw0win.2 hw0nz
      have hDw2 := hD (w0 + 2) hw2win.1 hw2win.2 hw2nz
      have hDpar := qAffine_zero_of_even_gap ht A0 B0 w0 hDw0 hDw2 z hzw
      exact hDpar
    have hconv : qAffine (2 ^ t) A0 B0 z = 0 → qAffine (2 ^ t) a b z = qAffine (2 ^ t) A B z := by
      intro h0
      have h0' : qAffine (2 ^ t) (a - A) (b - B) z = 0 := by simpa [A0, B0] using h0
      exact sub_eq_zero.mp ((qAffine_sub (2 ^ t) a b A B z).trans h0')
    by_cases he : Even (z - n0)
    · exact hconv (hCore n0 (by norm_num) (by norm_num) he)
    · have hz1 : Even (z - (n0 + 1)) := by
        have hodd : Odd (z - n0) := (Int.not_even_iff_odd.mp he)
        rcases hodd with ⟨k, hk⟩
        use k
        omega
      exact hconv (hCore (n0 + 1) (by norm_num) (by norm_num) hz1)
lemma badRow_iff_dvd {t : ℕ} (sa sb x : ℤ) :
    x ∈ badCoset (2 ^ t) sa sb ↔ ((2 ^ t : ℕ) : ℤ) ∣ sa * x + sb := by
  have h : qAffine (2 ^ t) sa sb x = ((sa * x + sb : ℤ) : ZMod (2 ^ t)) := by
    simp [qAffine, Int.cast_add, Int.cast_mul]
  unfold badCoset
  change qAffine (2 ^ t) sa sb x = 0 ↔ ((2 ^ t : ℕ) : ℤ) ∣ sa * x + sb
  rw [h]
  exact ZMod.intCast_zmod_eq_zero_iff_dvd (sa * x + sb) (2 ^ t)

-- quotient witness of a bad row
lemma badRow_quotient {t : ℕ} (sa sb x : ℤ) (hx : x ∈ badCoset (2 ^ t) sa sb) :
    ∃ m : ℤ, sa * x + sb = (2 ^ t : ℤ) * m := by
  rcases (badRow_iff_dvd sa sb x).mp hx with ⟨m, hm⟩
  refine ⟨m, ?_⟩
  simpa using hm

-- small ℤ-parity glue
lemma odd_add_even_zz {x y : ℤ} (hx : Odd x) (hy : Even y) : Odd (x + y) := by
  rcases hx with ⟨k, hk⟩
  rcases hy with ⟨l, hl⟩
  refine ⟨k + l, ?_⟩
  rw [hk, hl]
  ring

lemma odd_neg_zz {x : ℤ} (hx : Odd x) : Odd (-x) := by
  rcases hx with ⟨k, hk⟩
  refine ⟨-k - 1, ?_⟩
  rw [hk]
  ring

lemma odd_sub_even_zz {x y : ℤ} (hx : Odd x) (hy : Even y) : Odd (x - y) := by
  rcases hx with ⟨k, hk⟩
  rcases hy with ⟨l, hl⟩
  refine ⟨k - l, ?_⟩
  rw [hk, hl]
  ring

lemma odd_diff_add_even {b x : ℤ} (hx : Odd (x - b)) {k : ℤ} (hk : Even k) :
    Odd (x + k - b) := by
  have h : Odd ((x - b) + k) := odd_add_even_zz hx hk
  convert h using 1 <;> ring

lemma not_even_of_odd {x : ℤ} (hx : Odd x) : ¬ Even x := by
  rcases hx with ⟨k, hk⟩
  intro hE
  rcases hE with ⟨l, hl⟩
  omega

-- α (with two 2-apart zeros) is qHalf on the complement class
lemma alpha_odd_class_half {t : ℕ} (ht : 1 ≤ t) (A B b : ℤ)
    (hαb : qAffine (2 ^ t) A B b = 0) (hαb2 : qAffine (2 ^ t) A B (b + 2) = 0)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0) {x : ℤ} (hx : Odd (x - b)) :
    qAffine (2 ^ t) A B x = qHalf t := by
  exact qAffine_zero_pair_class_half ht A B b hαb hαb2 hnzα x (not_even_of_odd hx)

/-- (noFP) If no two consecutive points of `Q∩W = {q, q+2, q+4, q+6}` are both outside
the bad coset (a coset of `dℤ`, `d := 2^{t-ord}`), then either `q` or `q+2` is a bad
point whose translate by `d` is again a bad point inside the window. -/
lemma noFP_q_or_q2 {t ord : ℕ} (hord : ord < t) {sa sb c0 : ℤ} (q : ℤ)
    (hcos : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hno0 : q ∈ badCoset (2 ^ t) sa sb ∨ q + 2 ∈ badCoset (2 ^ t) sa sb)
    (hno1 : q + 2 ∈ badCoset (2 ^ t) sa sb ∨ q + 4 ∈ badCoset (2 ^ t) sa sb)
    (hno2 : q + 4 ∈ badCoset (2 ^ t) sa sb ∨ q + 6 ∈ badCoset (2 ^ t) sa sb) :
    (q ∈ badCoset (2 ^ t) sa sb ∧
       q + (((2 ^ (t - ord) : ℕ) : ℤ)) ∈ badCoset (2 ^ t) sa sb ∧
       q + (((2 ^ (t - ord) : ℕ) : ℤ)) ≤ q + 6) ∨
    (q + 2 ∈ badCoset (2 ^ t) sa sb ∧
       q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ)) ∈ badCoset (2 ^ t) sa sb ∧
       q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ)) ≤ q + 6) := by
  classical
  let d : ℕ := 2 ^ (t - ord)
  have hmem (x : ℤ) : x ∈ badCoset (2 ^ t) sa sb ↔ ((d : ℕ) : ℤ) ∣ x - c0 := by
    simpa [d] using hcos x
  have hper (x : ℤ) (hx : x ∈ badCoset (2 ^ t) sa sb) :
      x + ((d : ℕ) : ℤ) ∈ badCoset (2 ^ t) sa sb := by
    rw [hmem]
    rw [hmem] at hx
    rcases hx with ⟨m, hm⟩
    refine ⟨m + 1, ?_⟩
    calc x + ((d : ℕ) : ℤ) - c0 = (x - c0) + ((d : ℕ) : ℤ) := by ring
      _ = ((d : ℕ) : ℤ) * m + ((d : ℕ) : ℤ) := by rw [hm]
      _ = ((d : ℕ) : ℤ) * (m + 1) := by ring
  -- two coset points x ≤ y at distance ≤ 6: the spacing d is ≤ y − x
  have hd_le (x : ℤ) (hx : x ∈ badCoset (2 ^ t) sa sb) (y : ℤ)
      (hy : y ∈ badCoset (2 ^ t) sa sb) (hdiff0 : 0 < y - x) :
      ((d : ℕ) : ℤ) ≤ y - x := by
    have hdvd : ((d : ℕ) : ℤ) ∣ (y - x) := by
      have h1 : ((d : ℕ) : ℤ) ∣ y - c0 := (hmem y).mp hy
      have h2 : ((d : ℕ) : ℤ) ∣ (x - c0) := (hmem x).mp hx
      have hd : ((d : ℕ) : ℤ) ∣ (y - c0) - (x - c0) := dvd_sub h1 h2
      convert hd using 1 <;> ring
    rcases hdvd with ⟨w, hw⟩
    have hdpos : 0 < ((d : ℕ) : ℤ) := by exact_mod_cast (pow_pos (by norm_num : 0 < (2 : ℕ)) (t - ord) : 0 < d)
    have hwpos : 0 < w := by
      have hyx : 0 < y - x := hdiff0
      have hw' : 0 < ((d : ℕ) : ℤ) * w := by
        rw [← hw]
        exact hyx
      exact (mul_pos_iff_of_pos_left hdpos).mp hw'
    have hw1 : 1 ≤ w := by omega
    have hle : ((d : ℕ) : ℤ) ≤ ((d : ℕ) : ℤ) * w := by
      calc ((d : ℕ) : ℤ) = ((d : ℕ) : ℤ) * 1 := by ring
        _ ≤ ((d : ℕ) : ℤ) * w := mul_le_mul_of_nonneg_left hw1 (by omega)
    calc ((d : ℕ) : ℤ) ≤ ((d : ℕ) : ℤ) * w := hle
      _ = y - x := by rw [hw]
  by_cases hq : q ∈ badCoset (2 ^ t) sa sb
  · left
    have hsecond : q + 2 ∈ badCoset (2 ^ t) sa sb ∨ q + 4 ∈ badCoset (2 ^ t) sa sb ∨
        q + 6 ∈ badCoset (2 ^ t) sa sb := by
      rcases hno1 with h1 | h3
      · exact Or.inl h1
      · exact Or.inr (Or.inl h3)
    rcases hsecond with h2 | h4 | h6
    · have hle := hd_le q hq (q + 2) h2 (by norm_num)
      exact ⟨hq, hper q hq, by omega⟩
    · have hle := hd_le q hq (q + 4) h4 (by norm_num)
      exact ⟨hq, hper q hq, by omega⟩
    · have hle := hd_le q hq (q + 6) h6 (by norm_num)
      exact ⟨hq, hper q hq, by omega⟩
  · right
    have hq2 : q + 2 ∈ badCoset (2 ^ t) sa sb := hno0.resolve_left hq
    rcases hno2 with h4 | h6
    · have hle := hd_le (q + 2) hq2 (q + 4) h4 (by norm_num)
      exact ⟨hq2, hper (q + 2) hq2, by omega⟩
    · have hle := hd_le (q + 2) hq2 (q + 6) h6 (by norm_num)
      exact ⟨hq2, hper (q + 2) hq2, by omega⟩


-- `2^m` is even for `m ≥ 1` (as an integer).
lemma even_two_pow_int {m : ℕ} (hm : 1 ≤ m) : Even (((2 ^ m : ℕ) : ℤ)) := by
  rcases Nat.exists_eq_succ_of_ne_zero (by omega : m ≠ 0) with ⟨k, hk⟩
  refine ⟨((2 ^ k : ℕ) : ℤ), ?_⟩
  rw [hk, pow_succ]
  norm_num [Nat.cast_mul]
  ring

/-- Rigid-out, finite-order Case I: the given affine `α := qAffine A B` vanishes at two
points `b, b+2` of two apart (so `α = qHalf` on the complementary class of `b`, and
`α = 0` on the class of `b`).  With the window agreement of the structured line and the
coset structure of its bad coset, `α_g := qAffine sa sb` agrees with `α` everywhere
`α ≠ 0`.  (Free pair in the complementary window class: success via `config_I_success`;
otherwise two bad rows at the coset spacing carry both values `qHalf`, contradicting
the value structure.) -/
lemma rigid_out_A0 {t : ℕ} (ht : 2 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b q c0 : ℤ) (hq0 : n0 ≤ q) (hq6 : q + 6 ≤ n0 + 7)
    (hqodd : Odd (q - b))
    (hαb : qAffine (2 ^ t) A B b = 0) (hαb2 : qAffine (2 ^ t) A B (b + 2) = 0)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0)
    (hcos : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hgl : ∀ x : ℤ, x ∉ badCoset (2 ^ t) sa sb →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) sa sb x) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  intro z hz
  have ht1 : 1 ≤ t := by omega
  have hqwin0 : n0 ≤ q := hq0
  have hqwin1 : q ≤ n0 + 7 := by omega
  by_cases hFP : ∃ j : ℕ, j ≤ 2 ∧ (q + 2 * (j : ℤ)) ∉ badCoset (2 ^ t) sa sb ∧
      (q + 2 * (j : ℤ) + 2) ∉ badCoset (2 ^ t) sa sb
  · rcases hFP with ⟨j, hj, hf0, hf2⟩
    let q0 : ℤ := q + 2 * (j : ℤ)
    have hq0odd : Odd (q0 - b) := by
      dsimp [q0]
      exact odd_diff_add_even hqodd ⟨(j : ℤ), by ring⟩
    have hαq0 : qAffine (2 ^ t) A B q0 = qHalf t :=
      alpha_odd_class_half ht1 A B b hαb hαb2 hnzα hq0odd
    have hαq0nz : qAffine (2 ^ t) A B q0 ≠ 0 := by rw [hαq0]; exact qHalf_ne_zero ht1
    have hq0win0 : n0 ≤ q0 := by dsimp [q0]; omega
    have hq0win1 : q0 ≤ n0 + 7 := by dsimp [q0]; omega
    have hAg1 : qAffine (2 ^ t) sa sb q0 = qAffine (2 ^ t) A B q0 := by
      calc qAffine (2 ^ t) sa sb q0 = qLine (2 ^ t) sa sb q0 := (hgl q0 hf0).symm
        _ = qAffine (2 ^ t) A B q0 := hwin q0 hq0win0 hq0win1 hαq0nz
    have hq02odd : Odd (q0 + 2 - b) := by
      exact odd_diff_add_even hq0odd ⟨1, by ring⟩
    have hαq02 : qAffine (2 ^ t) A B (q0 + 2) = qHalf t :=
      alpha_odd_class_half ht1 A B b hαb hαb2 hnzα hq02odd
    have hαq02nz : qAffine (2 ^ t) A B (q0 + 2) ≠ 0 := by rw [hαq02]; exact qHalf_ne_zero ht1
    have hq02win0 : n0 ≤ q0 + 2 := by dsimp [q0]; omega
    have hq02win1 : q0 + 2 ≤ n0 + 7 := by dsimp [q0]; omega
    have hAg2 : qAffine (2 ^ t) sa sb (q0 + 2) = qAffine (2 ^ t) A B (q0 + 2) := by
      calc qAffine (2 ^ t) sa sb (q0 + 2) = qLine (2 ^ t) sa sb (q0 + 2) :=
          (hgl (q0 + 2) hf2).symm
        _ = qAffine (2 ^ t) A B (q0 + 2) := hwin (q0 + 2) hq02win0 hq02win1 hαq02nz
    exact config_I_success ht1 sa sb A B b q0 hαb hαb2 hnzα hAg1 hAg2
      (not_even_of_odd hq0odd) z hz
  · -- no free pair of the complementary class: two consecutive bad rows carry qHalf.
    have hQline (x : ℤ) (hxwin0 : n0 ≤ x) (hxwin1 : x ≤ n0 + 7) (hxodd : Odd (x - b)) :
        qLine (2 ^ t) sa sb x = qHalf t := by
      have hαx : qAffine (2 ^ t) A B x = qHalf t :=
        alpha_odd_class_half ht1 A B b hαb hαb2 hnzα hxodd
      have hαxnz : qAffine (2 ^ t) A B x ≠ 0 := by rw [hαx]; exact qHalf_ne_zero ht1
      calc qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x := hwin x hxwin0 hxwin1 hαxnz
        _ = qHalf t := hαx
    have hnoFP : ∀ j : ℕ, j ≤ 2 →
        (q + 2 * (j : ℤ)) ∈ badCoset (2 ^ t) sa sb ∨
        (q + 2 * (j : ℤ) + 2) ∈ badCoset (2 ^ t) sa sb := by
      intro j hj
      by_contra h
      push_neg at h
      exact hFP ⟨j, hj, h.1, h.2⟩
    have hno0 : q ∈ badCoset (2 ^ t) sa sb ∨ q + 2 ∈ badCoset (2 ^ t) sa sb := by
      rcases hnoFP 0 (by norm_num) with h | h
      · left
        convert h using 1 <;> ring
      · right
        convert h using 1 <;> ring
    have hno1 : q + 2 ∈ badCoset (2 ^ t) sa sb ∨ q + 4 ∈ badCoset (2 ^ t) sa sb := by
      rcases hnoFP 1 (by norm_num) with h | h
      · exact Or.inl h
      · right
        convert h using 1 <;> ring
    have hno2 : q + 4 ∈ badCoset (2 ^ t) sa sb ∨ q + 6 ∈ badCoset (2 ^ t) sa sb := by
      rcases hnoFP 2 (by norm_num) with h | h
      · exact Or.inl h
      · right
        convert h using 1 <;> ring
    have hdnonneg : 0 ≤ (((2 ^ (t - ord) : ℕ) : ℤ)) := by exact_mod_cast Nat.zero_le (2 ^ (t - ord))
    rcases noFP_q_or_q2 hord q hcos hno0 hno1 hno2 with hL | hR
    · rcases hL with ⟨hxb, hxdb, hxdb6⟩
      have hdxodd : Odd (q + (((2 ^ (t - ord) : ℕ) : ℤ)) - b) := by
        apply odd_diff_add_even hqodd
        exact even_two_pow_int (by omega : 1 ≤ t - ord)
      have hx0 : n0 ≤ q + (((2 ^ (t - ord) : ℕ) : ℤ)) := by omega
      have hx1 : q + (((2 ^ (t - ord) : ℕ) : ℤ)) ≤ n0 + 7 := by omega
      have hg1 : qLine (2 ^ t) sa sb q = qHalf t := hQline q hqwin0 hqwin1 hqodd
      have hg2 : qLine (2 ^ t) sa sb (q + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t :=
        hQline (q + (((2 ^ (t - ord) : ℕ) : ℤ))) hx0 hx1 hdxodd
      rcases badRow_quotient sa sb q hxb with ⟨m, hbm⟩
      exact False.elim (two_bad_rows_not_both_half (t := t) (o := ord) ht
        (by omega : ord ≤ t) sa a' sb q m hfac hodd' hbm hg1 hg2)
    · rcases hR with ⟨hxb, hxdb, hxdb6⟩
      have hq2odd : Odd (q + 2 - b) := odd_diff_add_even hqodd ⟨1, by ring⟩
      have hd2odd : Odd (q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ)) - b) := by
        apply odd_diff_add_even hq2odd
        exact even_two_pow_int (by omega : 1 ≤ t - ord)
      have hx0 : n0 ≤ q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ)) := by omega
      have hx1 : q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ)) ≤ n0 + 7 := by omega
      have hg1 : qLine (2 ^ t) sa sb (q + 2) = qHalf t := hQline (q + 2) (by omega) (by omega) hq2odd
      have hg2 : qLine (2 ^ t) sa sb (q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t :=
        hQline (q + 2 + (((2 ^ (t - ord) : ℕ) : ℤ))) hx0 hx1 hd2odd
      rcases badRow_quotient sa sb (q + 2) hxb with ⟨m, hbm⟩
      exact False.elim (two_bad_rows_not_both_half (t := t) (o := ord) ht
        (by omega : ord ≤ t) sa a' sb (q + 2) m hfac hodd' hbm hg1 hg2)

-- values of an affine α vanishing at e and e+4 (4 apart): α(e+2) and α(e+6) are both
-- 2·slope, which (being nonzero) must be qHalf.
lemma alpha_gap4_half {t : ℕ} (ht : 1 ≤ t) (A B e : ℤ)
    (he : qAffine (2 ^ t) A B e = 0) (he4 : qAffine (2 ^ t) A B (e + 4) = 0)
    (hnz2 : qAffine (2 ^ t) A B (e + 2) ≠ 0) :
    qAffine (2 ^ t) A B (e + 2) = qHalf t ∧
    qAffine (2 ^ t) A B (e - 2) = qHalf t ∧
    qAffine (2 ^ t) A B (e + 6) = qHalf t := by
  have hdiff (u : ℤ) : qAffine (2 ^ t) A B (e + u) - qAffine (2 ^ t) A B e =
      qAffine (2 ^ t) A 0 u := by
    rw [qAffine_diff (2 ^ t) A B e (e + u)]
    congr 1 <;> ring
  have hval (u : ℤ) : qAffine (2 ^ t) A B (e + u) = qAffine (2 ^ t) A 0 u := by
    have h' : qAffine (2 ^ t) A B (e + u) - 0 = qAffine (2 ^ t) A 0 u := by
      simpa [he] using hdiff u
    simpa using h'
  have h4s : (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
    have h4 : qAffine (2 ^ t) A 0 4 = 0 := by
      rw [← hval 4]
      exact he4
    have hz : (A : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := by simpa [qAffine] using h4
    simpa [mul_comm] using hz
  have h2 : qAffine (2 ^ t) A 0 2 = qHalf t := by
    have h22 : (2 : ZMod (2 ^ t)) * qAffine (2 ^ t) A 0 2 = 0 := by
      calc (2 : ZMod (2 ^ t)) * qAffine (2 ^ t) A 0 2 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
            simp [qAffine]
            ring
        _ = 0 := h4s
    rcases zmod_two_mul_eq_zero_half ht h22 with hz | hq
    · exfalso
      apply hnz2
      rw [hval 2]
      exact hz
    · exact hq
  have hshift (w : ℤ) (hw : w = 4 ∨ w = -4) :
      qAffine (2 ^ t) A B (e + 2 + w) = qAffine (2 ^ t) A B (e + 2) := by
    rcases hw with hw4 | hwm4
    · rw [hw4]
      have hd := qAffine_diff (2 ^ t) A B (e + 2) (e + 2 + 4)
      rw [show ((e + 2 + 4 : ℤ) - (e + 2)) = 4 by ring] at hd
      have hA : qAffine (2 ^ t) A 0 4 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
        simp [qAffine]
        ring
      have h0 : qAffine (2 ^ t) A B (e + 2 + 4) - qAffine (2 ^ t) A B (e + 2) = 0 := by
        rw [hd, hA, h4s]
      exact sub_eq_zero.mp h0
    · rw [hwm4]
      have hd := qAffine_diff (2 ^ t) A B (e + 2) (e + 2 + (-4))
      rw [show ((e + 2 + (-4) : ℤ) - (e + 2)) = -4 by ring] at hd
      have hA : qAffine (2 ^ t) A 0 (-4) = (-4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
        simp [qAffine]
        ring
      have h0 : qAffine (2 ^ t) A B (e + 2 + (-4)) - qAffine (2 ^ t) A B (e + 2) = 0 := by
        rw [hd, hA]
        calc (-4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = -((4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t))) := by ring
          _ = 0 := by rw [h4s]; simp
      exact sub_eq_zero.mp h0
  have hv2 : qAffine (2 ^ t) A B (e + 2) = qHalf t := by
    rw [hval 2]
    exact h2
  have hvm2 : qAffine (2 ^ t) A B (e - 2) = qHalf t := by
    have hs := hshift (-4) (Or.inr rfl)
    calc qAffine (2 ^ t) A B (e - 2) = qAffine (2 ^ t) A B (e + 2 + (-4)) := by congr 1 <;> ring
      _ = qAffine (2 ^ t) A B (e + 2) := hs
      _ = qHalf t := hv2
  have hv6 : qAffine (2 ^ t) A B (e + 6) = qHalf t := by
    have hs := hshift 4 (Or.inl rfl)
    calc qAffine (2 ^ t) A B (e + 6) = qAffine (2 ^ t) A B (e + 2 + 4) := by congr 1 <;> ring
      _ = qAffine (2 ^ t) A B (e + 2) := hs
      _ = qHalf t := hv2
  exact ⟨hv2, hvm2, hv6⟩


/-- Rigid-out Case C: the given affine `α` vanishes at `b` and `b+4`, and the two
intermediate covered-class points `b+2, b+6` lie in the bad coset `Γg` (of spacing
`2^{t-ord}`).  Since `α` does not vanish at `b+2` (hypothesis) and `Γg` does not contain
a 2-apart pair of `P` (hypothesis), the spacing is `4`, `α(b+2) = α(b+6) = q/2`, and
the two consecutive bad rows carry both values `q/2` — contradicting the value
structure. -/
lemma rigid_out_C {t : ℕ} (ht : 2 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b c0 : ℤ) (hb0 : n0 ≤ b) (hb6 : b + 6 ≤ n0 + 7)
    (hαb : qAffine (2 ^ t) A B b = 0) (hαb4 : qAffine (2 ^ t) A B (b + 4) = 0)
    (hαb2nz : qAffine (2 ^ t) A B (b + 2) ≠ 0)
    (hnotA1 : ¬ (b ∈ badCoset (2 ^ t) sa sb ∧ b + 2 ∈ badCoset (2 ^ t) sa sb))
    (hb2g : b + 2 ∈ badCoset (2 ^ t) sa sb) (hb6g : b + 6 ∈ badCoset (2 ^ t) sa sb)
    (hcoset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  intro z hz
  have ht1 : 1 ≤ t := by omega
  rcases alpha_gap4_half ht1 A B b hαb hαb4 hαb2nz with ⟨hv2, _hvm2, hv6⟩
  -- d := 2^{t-ord} divides (b+6)-(b+2) = 4 and is not 2, so d = 4
  have hdvd4 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ 4 := by
    have h1 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 2) - c0 := (hcoset (b + 2)).mp hb2g
    have h2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 6) - c0 := (hcoset (b + 6)).mp hb6g
    have hd : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ ((b + 6) - c0) - ((b + 2) - c0) := dvd_sub h2 h1
    convert hd using 1 <;> ring
  have hnot2 : ¬ (((2 ^ (t - ord) : ℕ) : ℤ)) = 2 := by
    intro hd2
    have hb : b ∈ badCoset (2 ^ t) sa sb := by
      rw [hcoset]
      have hb2d : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 2) - c0 := (hcoset (b + 2)).mp hb2g
      have h2d : (2 : ℤ) ∣ (b + 2) - c0 := by
        simpa [hd2] using hb2d
      have h2sub : (2 : ℤ) ∣ 2 := ⟨1, by ring⟩
      have hb' : (2 : ℤ) ∣ ((b + 2) - c0) - 2 := dvd_sub h2d h2sub
      have hb'' : (2 : ℤ) ∣ b - c0 := by
        convert hb' using 1 <;> ring
      have hb3 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ b - c0 := by
        rw [hd2]
        exact hb''
      exact hb3
    exact hnotA1 ⟨hb, hb2g⟩
  have hd4 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 4 := by
    have hnat : (2 ^ (t - ord) : ℕ) ∣ 4 := by
      exact (Int.natCast_dvd_natCast).mp hdvd4
    have hle : 2 ^ (t - ord) ≤ 4 := Nat.le_of_dvd (by norm_num : 0 < 4) hnat
    have hge : 2 ≤ 2 ^ (t - ord) := by
      have : 1 ≤ t - ord := by omega
      exact pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) this
    have htord : t - ord = 2 := by
      by_contra hnot
      have hcases : t - ord = 1 ∨ 3 ≤ t - ord := by omega
      rcases hcases with h1 | h3
      · exfalso
        apply hnot2
        have hd : (2 ^ (t - ord) : ℕ) = 2 := by rw [h1]; norm_num
        exact_mod_cast hd
      · exfalso
        have h8 : 8 ≤ 2 ^ (t - ord) := by
          calc 8 = 2 ^ 3 := by norm_num
            _ ≤ 2 ^ (t - ord) := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h3
        omega
    have hdv : (2 ^ (t - ord) : ℕ) = 4 := by rw [htord]; norm_num
    exact_mod_cast hdv
  -- values of the structured line at the two bad rows b+2 and b+6:
  have hq1 : qLine (2 ^ t) sa sb (b + 2) = qHalf t := by
    have hαnz : qAffine (2 ^ t) A B (b + 2) ≠ 0 := hαb2nz
    calc qLine (2 ^ t) sa sb (b + 2) = qAffine (2 ^ t) A B (b + 2) := hwin (b + 2) (by omega) (by omega) hαnz
      _ = qHalf t := hv2
  have hq2 : qLine (2 ^ t) sa sb (b + 6) = qHalf t := by
    have hα6nz : qAffine (2 ^ t) A B (b + 6) ≠ 0 := by rw [hv6]; exact qHalf_ne_zero ht1
    calc qLine (2 ^ t) sa sb (b + 6) = qAffine (2 ^ t) A B (b + 6) := hwin (b + 6) (by omega) (by omega) hα6nz
      _ = qHalf t := hv6
  -- hg2 must be stated at b + 2 + 2^{t-ord}: which equals b + 6 by hd4
  have hg2' : qLine (2 ^ t) sa sb (b + 2 + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t := by
    have h : (b + 2 + (((2 ^ (t - ord) : ℕ) : ℤ))) = b + 6 := by omega
    rw [h]
    exact hq2
  rcases badRow_quotient sa sb (b + 2) hb2g with ⟨m, hbm⟩
  exact False.elim (two_bad_rows_not_both_half (t := t) (o := ord) ht
    (by omega : ord ≤ t) sa a' sb (b + 2) m hfac hodd' hbm hq1 hg2')

/-- Rigid-out Case D: symmetric to Case C — `α` vanishes at `b+2, b+6` (anchor
`e := b+2`, zeros four apart), and the covered points `b, b+4` are bad rows. -/
lemma rigid_out_D {t : ℕ} (ht : 2 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b c0 : ℤ) (hb0 : n0 ≤ b) (hb6 : b + 6 ≤ n0 + 7)
    (hαb2 : qAffine (2 ^ t) A B (b + 2) = 0) (hαb6 : qAffine (2 ^ t) A B (b + 6) = 0)
    (hαbnz : qAffine (2 ^ t) A B b ≠ 0)
    (hnotA1 : ¬ (b + 2 ∈ badCoset (2 ^ t) sa sb ∧ b + 4 ∈ badCoset (2 ^ t) sa sb))
    (hbg : b ∈ badCoset (2 ^ t) sa sb) (hb4g : b + 4 ∈ badCoset (2 ^ t) sa sb)
    (hcoset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  intro z hz
  have ht1 : 1 ≤ t := by omega
  -- 4·slope = 0 (zeros at b+2 and b+6), so α(b+4) = α(b) (shift by 4)
  have h4s : (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
    have hd := qAffine_diff (2 ^ t) A B (b + 2) (b + 6)
    rw [show (b + 6 - (b + 2) : ℤ) = 4 by ring] at hd
    have hz' : qAffine (2 ^ t) A 0 4 = 0 := by
      rw [← hd]
      rw [hαb6, hαb2]
      simp
    have hA : qAffine (2 ^ t) A 0 4 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
      simp [qAffine]
      ring
    rwa [hA] at hz'
  have hαb4nz : qAffine (2 ^ t) A B (b + 4) ≠ 0 := by
    intro hz4
    -- α(b+4) - α(b) = 4·slope = 0 so α(b+4) = α(b) ≠ 0
    have hd := qAffine_diff (2 ^ t) A B b (b + 4)
    rw [show (b + 4 - b : ℤ) = 4 by ring] at hd
    have hA : qAffine (2 ^ t) A 0 4 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
      simp [qAffine]
      ring
    have h04 : qAffine (2 ^ t) A B (b + 4) - qAffine (2 ^ t) A B b = 0 := by
      rw [hd, hA, h4s]
    have heq : qAffine (2 ^ t) A B (b + 4) = qAffine (2 ^ t) A B b := sub_eq_zero.mp h04
    exact hαbnz (by rw [← heq]; exact hz4)
  have hb6' : qAffine (2 ^ t) A B ((b + 2) + 4) = 0 := by
    simpa [show ((b + 2) + 4 : ℤ) = b + 6 by ring] using hαb6
  have hb4nz' : qAffine (2 ^ t) A B ((b + 2) + 2) ≠ 0 := by
    simpa [show ((b + 2) + 2 : ℤ) = b + 4 by ring] using hαb4nz
  rcases alpha_gap4_half ht1 A B (b + 2) hαb2 hb6' hb4nz' with ⟨_hv2, hvm2, _hv6⟩
  have hbval : qAffine (2 ^ t) A B b = qHalf t := by
    simpa [show ((b + 2) - 2 : ℤ) = b by ring] using hvm2
  -- values at the bad rows b and b+4:
  have hαbnz' : qAffine (2 ^ t) A B b ≠ 0 := hαbnz
  have hq1 : qLine (2 ^ t) sa sb b = qHalf t := by
    calc qLine (2 ^ t) sa sb b = qAffine (2 ^ t) A B b := hwin b (by omega) (by omega) hαbnz'
      _ = qHalf t := hbval
  have hq2 : qLine (2 ^ t) sa sb (b + 4) = qHalf t := by
    have hα4nz : qAffine (2 ^ t) A B (b + 4) ≠ 0 := hαb4nz
    calc qLine (2 ^ t) sa sb (b + 4) = qAffine (2 ^ t) A B (b + 4) := hwin (b + 4) (by omega) (by omega) hα4nz
      _ = qHalf t := by
        -- α(b+4) = α(b) = qHalf
        have hd := qAffine_diff (2 ^ t) A B b (b + 4)
        rw [show (b + 4 - b : ℤ) = 4 by ring] at hd
        have hA : qAffine (2 ^ t) A 0 4 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
          simp [qAffine]
          ring
        have h04 : qAffine (2 ^ t) A B (b + 4) - qAffine (2 ^ t) A B b = 0 := by
          rw [hd, hA, h4s]
        have heq : qAffine (2 ^ t) A B (b + 4) = qAffine (2 ^ t) A B b := sub_eq_zero.mp h04
        rw [heq, hbval]
  -- d = 4
  have hdvd4 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ 4 := by
    have h1 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ b - c0 := (hcoset b).mp hbg
    have h2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 4) - c0 := (hcoset (b + 4)).mp hb4g
    have hd : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ ((b + 4) - c0) - (b - c0) := dvd_sub h2 h1
    convert hd using 1 <;> ring
  have hnot2 : ¬ (((2 ^ (t - ord) : ℕ) : ℤ)) = 2 := by
    intro hd2
    have hb2 : b + 2 ∈ badCoset (2 ^ t) sa sb := by
      rw [hcoset]
      have hb2d : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ b - c0 := (hcoset b).mp hbg
      have h2d : (2 : ℤ) ∣ b - c0 := by
        simpa [hd2] using hb2d
      have h2add : (2 : ℤ) ∣ 2 := ⟨1, by ring⟩
      have hb2' : (2 : ℤ) ∣ (b - c0) + 2 := dvd_add h2d h2add
      have hb2'' : (2 : ℤ) ∣ (b + 2) - c0 := by
        convert hb2' using 1 <;> ring
      have hb3 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 2) - c0 := by
        rw [hd2]
        exact hb2''
      exact hb3
    exact hnotA1 ⟨hb2, hb4g⟩
  have hd4 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 4 := by
    have hnat : (2 ^ (t - ord) : ℕ) ∣ 4 := (Int.natCast_dvd_natCast).mp hdvd4
    have hle : 2 ^ (t - ord) ≤ 4 := Nat.le_of_dvd (by norm_num : 0 < 4) hnat
    have hge : 2 ≤ 2 ^ (t - ord) := by
      have : 1 ≤ t - ord := by omega
      exact pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) this
    have htord : t - ord = 2 := by
      by_contra hnot
      have hcases : t - ord = 1 ∨ 3 ≤ t - ord := by omega
      rcases hcases with h1 | h3
      · exfalso
        apply hnot2
        have hd : (2 ^ (t - ord) : ℕ) = 2 := by rw [h1]; norm_num
        exact_mod_cast hd
      · exfalso
        have h8 : 8 ≤ 2 ^ (t - ord) := by
          calc 8 = 2 ^ 3 := by norm_num
            _ ≤ 2 ^ (t - ord) := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h3
        omega
    have hdv : (2 ^ (t - ord) : ℕ) = 4 := by rw [htord]; norm_num
    exact_mod_cast hdv
  have hg2' : qLine (2 ^ t) sa sb (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t := by
    have h : (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = b + 4 := by omega
    rw [h]
    exact hq2
  rcases badRow_quotient sa sb b hbg with ⟨m, hbm⟩
  exact False.elim (two_bad_rows_not_both_half (t := t) (o := ord) ht
    (by omega : ord ≤ t) sa a' sb b m hfac hodd' hbm hq1 hg2')


-- `4·x = 0` in `ZMod (2^t)` with `t ≥ 3`: `x` has no odd representative (it is even).
lemma four_torsion_not_odd {t : ℕ} (ht : 3 ≤ t) {x : ZMod (2 ^ t)}
    (h4 : (4 : ZMod (2 ^ t)) * x = 0) : ¬ HasOddRep x := by
  intro hx
  rcases hx with ⟨r, hr, hxr⟩
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ 4 * r := by
    have hz : ((4 * r : ℤ) : ZMod (2 ^ t)) = 0 := by
      calc ((4 * r : ℤ) : ZMod (2 ^ t)) = (4 : ZMod (2 ^ t)) * (r : ZMod (2 ^ t)) := by
            simp [Int.cast_mul]
        _ = (4 : ZMod (2 ^ t)) * x := by rw [hxr]
        _ = 0 := h4
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (4 * r) (2 ^ t)).mp hz
  rcases hdvd with ⟨w, hw⟩
  have hfac : ((2 ^ t : ℕ) : ℤ) = (4 : ℤ) * ((2 ^ (t - 2) : ℕ) : ℤ) := by
    rw [show t = (t - 2) + 2 by omega, pow_add]
    norm_num [Nat.cast_mul]
    ring
  have hmul : (4 : ℤ) * r = (4 : ℤ) * (((2 ^ (t - 2) : ℕ) : ℤ) * w) := by
    calc (4 : ℤ) * r = ((2 ^ t : ℕ) : ℤ) * w := hw
      _ = ((4 : ℤ) * ((2 ^ (t - 2) : ℕ) : ℤ)) * w := by rw [hfac]
      _ = (4 : ℤ) * (((2 ^ (t - 2) : ℕ) : ℤ) * w) := by ring
  have hcancel : r = ((2 ^ (t - 2) : ℕ) : ℤ) * w :=
    (mul_left_cancel₀ (by norm_num : (4 : ℤ) ≠ 0) hmul)
  have h2r : (2 : ℤ) ∣ r := by
    rcases two_dvd_two_pow_int (t := t - 2) (by omega) with ⟨u, hu⟩
    refine ⟨u * w, ?_⟩
    calc r = ((2 ^ (t - 2) : ℕ) : ℤ) * w := hcancel
      _ = (2 * u) * w := by rw [hu]
      _ = 2 * (u * w) := by ring
  rcases h2r with ⟨w2, hw2⟩
  rcases hr with ⟨k, hk⟩
  omega

-- Two structured-line values at consecutive bad rows (spacing `2^{t-o}`) are not both
-- without an odd representative.
lemma two_bad_rows_not_both_even {t o : ℕ} (ht : 1 ≤ t) (ho : o ≤ t)
    (a a' b c m : ℤ) (hfac : a = (((2 ^ o : ℕ) : ℤ)) * a') (ha' : Odd a')
    (hbm : a * c + b = (2 ^ t : ℤ) * m)
    (h1 : ¬ HasOddRep (qLine (2 ^ t) a b c))
    (h2 : ¬ HasOddRep (qLine (2 ^ t) a b (c + (((2 ^ (t - o) : ℕ) : ℤ))))) : False := by
  have hnq := bad_row_next_quotient (t := t) (o := o) ho (a := a) (a' := a') (b := b)
    (m := m) (n := c) hfac hbm
  have hq1 : fq (2 ^ t) m = qLine (2 ^ t) a b c := by
    have hv := qLine_bad_row a b m c hbm
    exact hv.symm
  have hq2 : fq (2 ^ t) (m + a') = qLine (2 ^ t) a b (c + (((2 ^ (t - o) : ℕ) : ℤ))) := by
    have hv := qLine_bad_row a b (m + a') (c + (((2 ^ (t - o) : ℕ) : ℤ))) hnq
    exact hv.symm
  rcases fq_step_odd ht a' m ha' with hO | hO
  · exact h1 (by rwa [← hq1])
  · exact h2 (by rwa [← hq2])

/-- If at most one of the four consecutive points `q, q+2, q+4, q+6` fails `G`, two of
them at distance `2` both satisfy `G`. -/
lemma good_pair_of_at_most_one_bad {q : ℤ} (G : ℤ → Prop)
    (h01 : ¬ (¬ G q ∧ ¬ G (q + 2))) (h02 : ¬ (¬ G q ∧ ¬ G (q + 4)))
    (h03 : ¬ (¬ G q ∧ ¬ G (q + 6))) (h12 : ¬ (¬ G (q + 2) ∧ ¬ G (q + 4)))
    (h13 : ¬ (¬ G (q + 2) ∧ ¬ G (q + 6))) (h23 : ¬ (¬ G (q + 4) ∧ ¬ G (q + 6))) :
    ∃ x : ℤ, (x = q ∨ x = q + 2 ∨ x = q + 4) ∧ G x ∧ G (x + 2) := by
  by_cases g0 : G q
  · by_cases g2 : G (q + 2)
    · exact ⟨q, Or.inl rfl, g0, g2⟩
    · by_cases g4 : G (q + 4)
      · by_cases g6 : G (q + 6)
        · exact ⟨q + 4, Or.inr (Or.inr rfl), g4, by simpa [show (q + 4 + 2 : ℤ) = q + 6 by ring] using g6⟩
        · exfalso
          exact h13 ⟨g2, g6⟩
      · exfalso
        exact h12 ⟨g2, g4⟩
  · by_cases g2 : G (q + 2)
    · by_cases g4 : G (q + 4)
      · exact ⟨q + 2, Or.inr (Or.inl rfl), g2, by simpa [show (q + 2 + 2 : ℤ) = q + 4 by ring] using g4⟩
      · exfalso
        exact h02 ⟨g0, g4⟩
    · exfalso
      exact h01 ⟨g0, g2⟩

/-- A point at odd difference from a bad-coset element `b` is not in the bad coset,
when the coset has spacing `2` (`d = 2`, i.e. `t - ord = 1`). -/
lemma not_mem_of_odd_diff {t ord : ℕ} (hord : ord < t) {sa sb c0 b x : ℤ}
    (hb : b ∈ badCoset (2 ^ t) sa sb)
    (hd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 2)
    (hcos : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hodd : Odd (x - b)) : x ∉ badCoset (2 ^ t) sa sb := by
  intro hx
  have hd1 : ((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - b := by
    have h1 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ x - c0 := (hcos x).mp hx
    have h2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ b - c0 := (hcos b).mp hb
    have hd : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (x - c0) - (b - c0) := dvd_sub h1 h2
    convert hd using 1 <;> ring
  have h2 : (2 : ℤ) ∣ x - b := by
    simpa [hd2] using hd1
  rcases h2 with ⟨w, hw⟩
  rcases hodd with ⟨k, hk⟩
  omega


/-- If an affine function has slope `0` and value `qHalf` at `x`, it is constantly
`qHalf`. -/
lemma alpha_slope_zero_const {t : ℕ} (A B x : ℤ)
    (hA0 : (A : ZMod (2 ^ t)) = 0) (hαx : qAffine (2 ^ t) A B x = qHalf t) :
    ∀ y : ℤ, qAffine (2 ^ t) A B y = qHalf t := by
  intro y
  have hB : (B : ZMod (2 ^ t)) = qHalf t := by
    have : qAffine (2 ^ t) A B x = (B : ZMod (2 ^ t)) := by
      simp [qAffine, hA0]
    simpa [this] using hαx
  simp [qAffine, hA0, hB]

/-- If an affine function has slope `qHalf` and value `qHalf` at `x`, it takes value
`0` at points of the opposite class. -/
lemma alpha_slope_half_zero_at_opposite {t : ℕ} (ht : 1 ≤ t) (A B : ℤ) (x : ℤ)
    (hAx : (A : ZMod (2 ^ t)) = qHalf t) (hαx : qAffine (2 ^ t) A B x = qHalf t)
    {b : ℤ} (hbx : Odd (b - x)) : qAffine (2 ^ t) A B b = 0 := by
  have hB : (B : ZMod (2 ^ t)) = qHalf t - qHalf t * (x : ZMod (2 ^ t)) := by
    have hαx' : qAffine (2 ^ t) A B x = qHalf t * (x : ZMod (2 ^ t)) + (B : ZMod (2 ^ t)) := by
      simp [qAffine, hAx]
    rw [hαx'] at hαx
    calc (B : ZMod (2 ^ t)) = (qHalf t * (x : ZMod (2 ^ t)) + (B : ZMod (2 ^ t))) - qHalf t * (x : ZMod (2 ^ t)) := by ring
      _ = qHalf t - qHalf t * (x : ZMod (2 ^ t)) := by rw [hαx]
  have hbval : qAffine (2 ^ t) A B b = qHalf t * ((b - x : ℤ) : ZMod (2 ^ t)) + qHalf t := by
    calc qAffine (2 ^ t) A B b = qHalf t * (b : ZMod (2 ^ t)) + (B : ZMod (2 ^ t)) := by
          simp [qAffine, hAx]
      _ = qHalf t * (b : ZMod (2 ^ t)) + (qHalf t - qHalf t * (x : ZMod (2 ^ t))) := by rw [hB]
      _ = qHalf t * ((b - x : ℤ) : ZMod (2 ^ t)) + qHalf t := by
          simp [Int.cast_sub]
          ring
  rw [hbval]
  have hoddmul : qHalf t * ((b - x : ℤ) : ZMod (2 ^ t)) = qHalf t := by
    rcases hbx with ⟨k, hk⟩
    -- (b-x:ZMod) = 2k+1: rewrite via integer equality
    have hcast : ((b - x : ℤ) : ZMod (2 ^ t)) = ((2 * k + 1 : ℤ) : ZMod (2 ^ t)) := by rw [hk]
    rw [hcast]
    have hq2 : qHalf t * ((2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) + 1) = qHalf t := by
      calc qHalf t * ((2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) + 1)
          = (qHalf t * (2 : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) + qHalf t := by ring
      _ = qHalf t := by
        have hq2m : qHalf t * (2 : ZMod (2 ^ t)) = 0 := by simpa [mul_comm] using two_mul_qHalf ht
        rw [hq2m]
        simp
    simpa [Int.cast_add, Int.cast_mul] using hq2
  rw [hoddmul]
  have : qHalf t + qHalf t = (2 : ZMod (2 ^ t)) * qHalf t := by ring
  rw [this, two_mul_qHalf ht]

-- With 4-apart zeros at x0, x0+4, the affine value at any y is annihilated by 4.
lemma four_mul_affine_of_gap4_zero {t : ℕ} (ht : 1 ≤ t) (A B x0 : ℤ)
    (hx0 : qAffine (2 ^ t) A B x0 = 0) (hx4 : qAffine (2 ^ t) A B (x0 + 4) = 0) (y : ℤ) :
    (4 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B y = 0 := by
  have hd : qAffine (2 ^ t) A B (x0 + 4) - qAffine (2 ^ t) A B x0 = qAffine (2 ^ t) A 0 4 := by
    rw [qAffine_diff (2 ^ t) A B x0 (x0 + 4)]
    congr 1 <;> ring
  have hA4 : qAffine (2 ^ t) A 0 4 = (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
    simp [qAffine]
    ring
  have h4s : (4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
    have : qAffine (2 ^ t) A 0 4 = 0 := by
      rw [← hd]
      rw [hx4, hx0]
      simp
    rwa [hA4] at this
  -- α(y) = s·(y − x0): subtract α(x0) = 0
  have hd2 : qAffine (2 ^ t) A B y - qAffine (2 ^ t) A B x0 = qAffine (2 ^ t) A 0 (y - x0) :=
    qAffine_diff (2 ^ t) A B x0 y
  have hAy : qAffine (2 ^ t) A 0 (y - x0) = ((y - x0 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
    simp [qAffine]
    ring
  have hy : qAffine (2 ^ t) A B y = ((y - x0 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
    calc qAffine (2 ^ t) A B y = qAffine (2 ^ t) A B y - qAffine (2 ^ t) A B x0 := by rw [hx0]; simp
      _ = qAffine (2 ^ t) A 0 (y - x0) := hd2
      _ = ((y - x0 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := hAy
  calc
    (4 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B y
        = (4 : ZMod (2 ^ t)) * (((y - x0 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t))) := by rw [hy]
    _ = (((y - x0 : ℤ) : ZMod (2 ^ t))) * ((4 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t))) := by ring
    _ = 0 := by rw [h4s]; simp

-- Two bad rows b, b+2 (Γg = class of b, spacing 2) whose α-values are annihilated by 4:
-- contradiction (α-values have no odd representative for t ≥ 3, but consecutive bad-row
-- values cannot both be even).
lemma bad_rows_not_both_even_of_gap4_zero {t : ℕ} (ht3 : 3 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b x0 : ℤ)
    (hb0 : n0 ≤ b) (hb2 : b + 2 ≤ n0 + 7)
    (hb : b ∈ badCoset (2 ^ t) sa sb) (hb2g : b + 2 ∈ badCoset (2 ^ t) sa sb)
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0)
    (hx0 : qAffine (2 ^ t) A B x0 = 0) (hx4 : qAffine (2 ^ t) A B (x0 + 4) = 0)
    (hbodd : Odd (b - x0)) (hd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 2) : False := by
  have ht1 : 1 ≤ t := by omega
  have hbwin1 : b ≤ n0 + 7 := by omega
  have hb2win0 : n0 ≤ b + 2 := by omega
  have hb2win1 : b + 2 ≤ n0 + 7 := hb2
  have h4b : (4 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B b = 0 :=
    four_mul_affine_of_gap4_zero ht1 A B x0 hx0 hx4 b
  have h4b2 : (4 : ZMod (2 ^ t)) * qAffine (2 ^ t) A B (b + 2) = 0 :=
    four_mul_affine_of_gap4_zero ht1 A B x0 hx0 hx4 (b + 2)
  have hb2odd : Odd (b + 2 - x0) := odd_diff_add_even hbodd ⟨1, by ring⟩
  have hαbnz : qAffine (2 ^ t) A B b ≠ 0 := by
    intro hz
    have hzero : ∀ z : ℤ, qAffine (2 ^ t) A B z = 0 :=
      qAffine_zero_of_odd_gap ht1 A B hbodd hx0 hz
    exact hnzα hzero
  have hαb2nz : qAffine (2 ^ t) A B (b + 2) ≠ 0 := by
    intro hz
    have hzero : ∀ z : ℤ, qAffine (2 ^ t) A B z = 0 :=
      qAffine_zero_of_odd_gap ht1 A B hb2odd hx0 hz
    exact hnzα hzero
  have hq1 : qLine (2 ^ t) sa sb b = qAffine (2 ^ t) A B b := hwin b hb0 hbwin1 hαbnz
  have hq2 : qLine (2 ^ t) sa sb (b + 2) = qAffine (2 ^ t) A B (b + 2) :=
    hwin (b + 2) hb2win0 hb2win1 hαb2nz
  have hnot1 : ¬ HasOddRep (qLine (2 ^ t) sa sb b) := by
    rw [hq1]
    exact four_torsion_not_odd ht3 h4b
  have hnot2' : ¬ HasOddRep (qLine (2 ^ t) sa sb (b + 2)) := by
    rw [hq2]
    exact four_torsion_not_odd ht3 h4b2
  have hnot2 : ¬ HasOddRep (qLine (2 ^ t) sa sb (b + (((2 ^ (t - ord) : ℕ) : ℤ)))) := by
    have h : (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = b + 2 := by omega
    rw [h]
    exact hnot2'
  rcases badRow_quotient sa sb b hb with ⟨m, hbm⟩
  exact two_bad_rows_not_both_even ht1 (by omega : ord ≤ t) sa a' sb b m hfac hodd' hbm hnot1 hnot2


/-- Rigid-out Case A1: the bad coset `Γg` contains the pair `b, b+2` of the covered
class (so `Γg` is the whole class of `b`).  If also `α(b) = α(b+2) = 0` the situation
is Case A0; otherwise (`¬hα20`) a contradiction follows from the window agreement
(paper "case 2"). -/
lemma rigid_out_A1 {t : ℕ} (ht : 3 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b q c0 : ℤ) (hq0 : n0 ≤ q) (hq6 : q + 6 ≤ n0 + 7)
    (hqodd : Odd (q - b))
    (hb0 : n0 ≤ b) (hb6 : b + 6 ≤ n0 + 7)
    (hb : b ∈ badCoset (2 ^ t) sa sb) (hb2 : b + 2 ∈ badCoset (2 ^ t) sa sb)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0)
    (hcoset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hgl : ∀ x : ℤ, x ∉ badCoset (2 ^ t) sa sb →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) sa sb x) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  intro z hz
  have ht2 : 2 ≤ t := by omega
  have ht1 : 1 ≤ t := by omega
  by_cases hα20 : qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0
  · exact rigid_out_A0 ht2 A B sa sb ord hord a' hfac hodd' n0 b q c0 hq0 hq6 hqodd
      hα20.1 hα20.2 hnzα hcoset hwin hgl z hz
  · -- ¬hα20: contradiction (paper case 2).  The rows of Q∩W are free of Γg.
    have hnotA0 : ¬ (qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0) := hα20
    have hd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 2 := by
      have hdvd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ 2 := by
        have h1 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (b + 2) - c0 := (hcoset (b + 2)).mp hb2
        have h2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ b - c0 := (hcoset b).mp hb
        have hd : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ ((b + 2) - c0) - (b - c0) := dvd_sub h1 h2
        convert hd using 1 <;> ring
      have hnat : (2 ^ (t - ord) : ℕ) ∣ 2 := (Int.natCast_dvd_natCast).mp hdvd2
      have hge : 2 ≤ 2 ^ (t - ord) := by
        have : 1 ≤ t - ord := by omega
        exact pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) this
      have hle : 2 ^ (t - ord) ≤ 2 := Nat.le_of_dvd (by norm_num : 0 < 2) hnat
      have : 2 ^ (t - ord) = 2 := by omega
      exact_mod_cast this
    have hqodd' (j : ℕ) : Odd (q + 2 * (j : ℤ) - b) := odd_diff_add_even hqodd ⟨(j : ℤ), by ring⟩
    have hnotΓg (x : ℤ) (hxodd : Odd (x - b)) : x ∉ badCoset (2 ^ t) sa sb :=
      not_mem_of_odd_diff hord hb hd2 hcoset hxodd
    -- α_g vanishes at b, b+2 and is qHalf on the complement class of b
    have hαgb : qAffine (2 ^ t) sa sb b = 0 := by simpa [badCoset] using hb
    have hαgb2 : qAffine (2 ^ t) sa sb (b + 2) = 0 := by simpa [badCoset] using hb2
    have hnzαg : ¬ ∀ z : ℤ, qAffine (2 ^ t) sa sb z = 0 := by
      intro hz
      -- α_g ≡ 0 → sa ≡ 0 mod 2^t, contradicting hfac (odd a', ord < t)
      have hsa : (sa : ZMod (2 ^ t)) = 0 := by
        have : qAffine (2 ^ t) sa sb 0 = 0 := hz 0
        have h0 : qAffine (2 ^ t) sa sb 0 = (sb : ZMod (2 ^ t)) := by simp [qAffine]
        -- sa = 0 from hz 0 and hz 1
        have h1 : qAffine (2 ^ t) sa sb 1 = 0 := hz 1
        have hs1 : qAffine (2 ^ t) sa sb 1 = (sa : ZMod (2 ^ t)) + (sb : ZMod (2 ^ t)) := by simp [qAffine]
        rw [h0] at this
        rw [hs1] at h1
        have hsb : (sb : ZMod (2 ^ t)) = 0 := by simpa using this
        simpa [hsb] using h1
      have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ sa := by
        exact (ZMod.intCast_zmod_eq_zero_iff_dvd sa (2 ^ t)).mp hsa
      -- sa = 2^ord·a', a' odd, ord < t ⇒ 2^t ∤ sa
      have hndvd : ¬ ((2 ^ t : ℕ) : ℤ) ∣ sa := by
        intro hd
        rcases hd with ⟨w, hw⟩
        have hlt : ord < t := hord
        -- 2^ord·a' = 2^t·w → a' = 2^{t-ord}·w → 2 | a' contradiction
        have hfac' : ((2 ^ ord : ℕ) : ℤ) * a' = ((2 ^ t : ℕ) : ℤ) * w := by
          calc ((2 ^ ord : ℕ) : ℤ) * a' = sa := hfac.symm
            _ = ((2 ^ t : ℕ) : ℤ) * w := hw
        have hExp : ord + (t - ord) = t := by omega
        have hpow : ((2 ^ t : ℕ) : ℤ) = ((2 ^ ord : ℕ) : ℤ) * ((2 ^ (t - ord) : ℕ) : ℤ) := by
          rw [← Nat.cast_mul]
          congr 1
          rw [← pow_add, hExp]
        have hcancel : a' = ((2 ^ (t - ord) : ℕ) : ℤ) * w := by
          rw [hpow] at hfac'
          exact (mul_left_cancel₀ (by positivity : ((2 ^ ord : ℕ) : ℤ) ≠ 0) (by simpa [mul_assoc, mul_comm, mul_left_comm] using hfac'))
        have h2dvd : (2 : ℤ) ∣ a' := by
          rcases two_dvd_two_pow_int (t := t - ord) (by omega : 1 ≤ t - ord) with ⟨u, hu⟩
          refine ⟨u * w, ?_⟩
          calc a' = ((2 ^ (t - ord) : ℕ) : ℤ) * w := hcancel
            _ = (2 * u) * w := by rw [hu]
            _ = 2 * (u * w) := by ring
        rcases h2dvd with ⟨u2, hu2⟩
        rcases hodd' with ⟨k, hk⟩
        omega
      exact hndvd hdvd
    have hαgQ {x : ℤ} (hxodd : Odd (x - b)) : qAffine (2 ^ t) sa sb x = qHalf t := by
      have : ¬ Even (x - b) := not_even_of_odd hxodd
      exact qAffine_zero_pair_class_half ht1 sa sb b hαgb hαgb2 hnzαg x this
    -- values of the structured line at free points of Q∩W equal α-values:
    have hqLine_free (x : ℤ) (hxodd : Odd (x - b)) (hx0 : n0 ≤ x) (hx1 : x ≤ n0 + 7)
        (hαxnz : qAffine (2 ^ t) A B x ≠ 0) :
        qAffine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x := by
      calc qAffine (2 ^ t) sa sb x = qLine (2 ^ t) sa sb x := (hgl x (hnotΓg x hxodd)).symm
        _ = qAffine (2 ^ t) A B x := hwin x hx0 hx1 hαxnz
    have hqLine_free_qHalf (x : ℤ) (hxodd : Odd (x - b)) (hx0 : n0 ≤ x) (hx1 : x ≤ n0 + 7)
        (hαxnz : qAffine (2 ^ t) A B x ≠ 0) :
        qAffine (2 ^ t) A B x = qHalf t := by
      have hg : qAffine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x := hqLine_free x hxodd hx0 hx1 hαxnz
      rw [← hg]
      exact hαgQ hxodd
    -- Case split on zeros of α within Q∩W.
    by_cases h2Γ : ∃ x : ℤ, (x = q ∨ x = q + 2 ∨ x = q + 4) ∧
        qAffine (2 ^ t) A B x = 0 ∧ qAffine (2 ^ t) A B (x + 2) = 0
    · rcases h2Γ with ⟨x, hxpos, hx, hx2⟩
      -- α = qHalf on class(b), so the bad rows b, b+2 carry qHalf
      have hbqodd : Odd (b - q) := by simpa using odd_neg_zz hqodd
      have hbodd : Odd (b - x) := by
        rcases hxpos with hxq | hxq2 | hxq4
        · rw [hxq]
          simpa using hbqodd
        · rw [hxq2]
          have : Odd ((b - q) - 2) := odd_sub_even_zz hbqodd ⟨1, by ring⟩
          simpa [show (b - q) - 2 = b - (q + 2) by ring] using this
        · rw [hxq4]
          have : Odd ((b - q) - 4) := odd_sub_even_zz hbqodd ⟨2, by ring⟩
          simpa [show (b - q) - 4 = b - (q + 4) by ring] using this
      have hαb_half : qAffine (2 ^ t) A B b = qHalf t :=
        alpha_odd_class_half ht1 A B x hx hx2 hnzα hbodd
      have hb2odd : Odd (b + 2 - x) := odd_diff_add_even hbodd ⟨1, by ring⟩
      have hαb2_half : qAffine (2 ^ t) A B (b + 2) = qHalf t :=
        alpha_odd_class_half ht1 A B x hx hx2 hnzα hb2odd
      have hbwin0 : n0 ≤ b := hb0
      have hbwin1 : b ≤ n0 + 7 := by omega
      have hb2win0 : n0 ≤ b + 2 := by omega
      have hb2win1 : b + 2 ≤ n0 + 7 := by omega
      have hq1 : qLine (2 ^ t) sa sb b = qHalf t := by
        have hαnz : qAffine (2 ^ t) A B b ≠ 0 := by rw [hαb_half]; exact qHalf_ne_zero ht1
        calc qLine (2 ^ t) sa sb b = qAffine (2 ^ t) A B b := hwin b hbwin0 hbwin1 hαnz
          _ = qHalf t := hαb_half
      have hq2 : qLine (2 ^ t) sa sb (b + 2) = qHalf t := by
        have hαnz : qAffine (2 ^ t) A B (b + 2) ≠ 0 := by rw [hαb2_half]; exact qHalf_ne_zero ht1
        calc qLine (2 ^ t) sa sb (b + 2) = qAffine (2 ^ t) A B (b + 2) := hwin (b + 2) hb2win0 hb2win1 hαnz
          _ = qHalf t := hαb2_half
      have hg2' : qLine (2 ^ t) sa sb (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t := by
        have h : (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = b + 2 := by omega
        rw [h]
        exact hq2
      rcases badRow_quotient sa sb b hb with ⟨m, hbm⟩
      exact False.elim (two_bad_rows_not_both_half (t := t) (o := ord) ht2
        (by omega : ord ≤ t) sa a' sb b m hfac hodd' hbm hq1 hg2')
    · by_cases h4Γ : (qAffine (2 ^ t) A B q = 0 ∧ qAffine (2 ^ t) A B (q + 4) = 0) ∨
        (qAffine (2 ^ t) A B (q + 2) = 0 ∧ qAffine (2 ^ t) A B (q + 6) = 0)
      · rcases h4Γ with h4a | h4b
        · -- two 4-apart zeros at q, q+4: α-values at the bad rows b, b+2 are 4-torsion
          exfalso
          have hbqodd : Odd (b - q) := by simpa using odd_neg_zz hqodd
          exact bad_rows_not_both_even_of_gap4_zero ht A B sa sb ord hord a' hfac hodd' n0 b q
            hb0 (by omega) hb hb2 hwin hnzα h4a.1 h4a.2 hbqodd hd2
        · -- two 4-apart zeros at q+2, q+6
          exfalso
          have hbq2odd : Odd (b - (q + 2)) := by
            have h : Odd ((b - q) - 2) := odd_sub_even_zz (by simpa using odd_neg_zz hqodd) ⟨1, by ring⟩
            simpa [show (b - q) - 2 = b - (q + 2) by ring] using h
          have hx4' : qAffine (2 ^ t) A B ((q + 2) + 4) = 0 := by
            simpa [show (q + 2 + 4 : ℤ) = q + 6 by ring] using h4b.2
          exact bad_rows_not_both_even_of_gap4_zero ht A B sa sb ord hord a' hfac hodd' n0 b (q + 2)
            hb0 (by omega) hb hb2 hwin hnzα h4b.1 hx4' hbq2odd hd2
      · by_cases h6Γ : qAffine (2 ^ t) A B q = 0 ∧ qAffine (2 ^ t) A B (q + 6) = 0
        · -- 6-apart zeros: α(q+2) = 0 too (2·slope = 0 since 3 is invertible),
          -- contradicting ¬h2Γ
          exfalso
          have h6s : ((6 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
            have hd := qAffine_diff (2 ^ t) A B q (q + 6)
            rw [show (q + 6 - q : ℤ) = 6 by ring] at hd
            have hzero : qAffine (2 ^ t) A 0 6 = 0 := by
              rw [← hd]
              rw [h6Γ.2, h6Γ.1]
              simp
            have hA6 : qAffine (2 ^ t) A 0 6 = ((6 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
              simp [qAffine]
              ring
            rwa [hA6] at hzero
          have h2s : (2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
            have h6m : ((6 : ℤ) : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) =
                ((2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t))) * (3 : ZMod (2 ^ t)) := by
              rw [show ((6 : ℤ) : ZMod (2 ^ t)) = ((2 : ZMod (2 ^ t)) * (3 : ZMod (2 ^ t))) by norm_num]
              ring
            rw [h6m] at h6s
            exact zmod_mul_odd_eq_zero ht1 (by norm_num : Odd (3 : ℤ))
              ((2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t))) (by simpa using h6s)
          have hαq2 : qAffine (2 ^ t) A B (q + 2) = 0 := by
            have hd := qAffine_diff (2 ^ t) A B q (q + 2)
            rw [show (q + 2 - q : ℤ) = 2 by ring] at hd
            have hA2 : qAffine (2 ^ t) A 0 2 = (2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
              simp [qAffine]
              ring
            have heq : qAffine (2 ^ t) A B (q + 2) = qAffine (2 ^ t) A 0 2 + qAffine (2 ^ t) A B q :=
              (sub_eq_iff_eq_add.mp hd)
            rw [heq, hA2, h2s, h6Γ.1]
            simp
          exact h2Γ ⟨q, Or.inl rfl, h6Γ.1, hαq2⟩
        · -- at most one zero of α in Q∩W: ≥ 3 free points of Q∩W carry a distance-2 pair
          exfalso
          have hpair : ∃ x : ℤ, (x = q ∨ x = q + 2 ∨ x = q + 4) ∧
              qAffine (2 ^ t) A B x ≠ 0 ∧ qAffine (2 ^ t) A B (x + 2) ≠ 0 := by
            apply good_pair_of_at_most_one_bad (G := fun x => qAffine (2 ^ t) A B x ≠ 0)
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B q = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 2) = 0 := by simpa using h2
              exact h2Γ ⟨q, Or.inl rfl, h1', h2'⟩
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B q = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 4) = 0 := by simpa using h2
              exact h4Γ (Or.inl ⟨h1', h2'⟩)
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B q = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 6) = 0 := by simpa using h2
              exact h6Γ ⟨h1', h2'⟩
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B (q + 2) = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 4) = 0 := by simpa using h2
              have h2'' : qAffine (2 ^ t) A B ((q + 2) + 2) = 0 := by
                simpa [show ((q + 2) + 2 : ℤ) = q + 4 by ring] using h2'
              exact h2Γ ⟨q + 2, Or.inr (Or.inl rfl), h1', h2''⟩
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B (q + 2) = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 6) = 0 := by simpa using h2
              exact h4Γ (Or.inr ⟨h1', h2'⟩)
            · intro h
              rcases h with ⟨h1, h2⟩
              have h1' : qAffine (2 ^ t) A B (q + 4) = 0 := by simpa using h1
              have h2' : qAffine (2 ^ t) A B (q + 6) = 0 := by simpa using h2
              have h2'' : qAffine (2 ^ t) A B ((q + 4) + 2) = 0 := by
                simpa [show ((q + 4) + 2 : ℤ) = q + 6 by ring] using h2'
              exact h2Γ ⟨q + 4, Or.inr (Or.inr rfl), h1', h2''⟩
          rcases hpair with ⟨x, hxpos, hxnz, hx2nz⟩
          have hxodd : Odd (x - b) := by
            rcases hxpos with hxq | hxq2 | hxq4
            · rw [hxq]
              exact hqodd
            · rw [hxq2]
              exact odd_diff_add_even (x := q) (b := b) hqodd ⟨1, by ring⟩
            · rw [hxq4]
              exact odd_diff_add_even (x := q) (b := b) hqodd ⟨2, by ring⟩
          have hx2odd : Odd (x + 2 - b) := odd_diff_add_even hxodd ⟨1, by ring⟩
          have hxwin0 : n0 ≤ x := by
            rcases hxpos with hxq | hxq2 | hxq4
            · rw [hxq]; exact hq0
            · rw [hxq2]; omega
            · rw [hxq4]; omega
          have hxwin1 : x ≤ n0 + 7 := by
            rcases hxpos with hxq | hxq2 | hxq4
            · rw [hxq]; omega
            · rw [hxq2]; omega
            · rw [hxq4]; omega
          have hx2win1 : x + 2 ≤ n0 + 7 := by
            rcases hxpos with hxq | hxq2 | hxq4
            · rw [hxq]; omega
            · rw [hxq2]; omega
            · rw [hxq4]; omega
          have hαx_half : qAffine (2 ^ t) A B x = qHalf t :=
            hqLine_free_qHalf x hxodd hxwin0 hxwin1 hxnz
          have hαx2_half : qAffine (2 ^ t) A B (x + 2) = qHalf t :=
            hqLine_free_qHalf (x + 2) hx2odd (by omega) hx2win1 hx2nz
          -- α agrees with the constant qHalf on the whole class of x (the class of q)
          let bq : ℤ := ((2 ^ (t - 1) : ℕ) : ℤ)
          have hconst (u : ℤ) : qAffine (2 ^ t) 0 bq u = qHalf t := by
            simp [qAffine, bq, qHalf]
          have hAg1 : qAffine (2 ^ t) A B x = qAffine (2 ^ t) 0 bq x := by
            rw [hαx_half, hconst x]
          have hAg2 : qAffine (2 ^ t) A B (x + 2) = qAffine (2 ^ t) 0 bq (x + 2) := by
            rw [hαx2_half, hconst (x + 2)]
          have hαQ (u : ℤ) (hu : Odd (u - b)) : qAffine (2 ^ t) A B u = qHalf t := by
            have hux : Even (u - x) :=
              even_sub_of_not_even_both (b := b) (x := x) (y := u)
                (not_even_of_odd hxodd) (not_even_of_odd hu)
            have hAg := qAffine_agree_even_gap_class ht1 A B 0 bq x hAg1 hAg2 u hux
            rwa [hconst u] at hAg
          have h2s : (2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) = 0 := by
            have hd := qAffine_diff (2 ^ t) A B x (x + 2)
            rw [show (x + 2 - x : ℤ) = 2 by ring] at hd
            have hA2 : qAffine (2 ^ t) A 0 2 = (2 : ZMod (2 ^ t)) * (A : ZMod (2 ^ t)) := by
              simp [qAffine]
              ring
            have hz : qAffine (2 ^ t) A 0 2 = 0 := by
              rw [← hd]
              rw [hαx2_half, hαx_half]
              simp
            rwa [hA2] at hz
          rcases zmod_two_mul_eq_zero_half ht1 h2s with hs0 | hsq
          · -- slope 0: α ≡ qHalf, so the bad rows b, b+2 carry qHalf
            have hαconst : ∀ u : ℤ, qAffine (2 ^ t) A B u = qHalf t :=
              alpha_slope_zero_const A B q hs0 (hαQ q hqodd)
            have hαbnz : qAffine (2 ^ t) A B b ≠ 0 := by rw [hαconst b]; exact qHalf_ne_zero ht1
            have hαb2nz : qAffine (2 ^ t) A B (b + 2) ≠ 0 := by rw [hαconst (b + 2)]; exact qHalf_ne_zero ht1
            have hq1 : qLine (2 ^ t) sa sb b = qHalf t := by
              calc qLine (2 ^ t) sa sb b = qAffine (2 ^ t) A B b := hwin b hb0 (by omega) hαbnz
                _ = qHalf t := hαconst b
            have hq2 : qLine (2 ^ t) sa sb (b + 2) = qHalf t := by
              calc qLine (2 ^ t) sa sb (b + 2) = qAffine (2 ^ t) A B (b + 2) := hwin (b + 2) (by omega) (by omega) hαb2nz
                _ = qHalf t := hαconst (b + 2)
            have hg2' : qLine (2 ^ t) sa sb (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = qHalf t := by
              have h : (b + (((2 ^ (t - ord) : ℕ) : ℤ))) = b + 2 := by omega
              rw [h]
              exact hq2
            rcases badRow_quotient sa sb b hb with ⟨m, hbm⟩
            exact two_bad_rows_not_both_half (t := t) (o := ord) ht2
              (by omega : ord ≤ t) sa a' sb b m hfac hodd' hbm hq1 hg2'
          · -- slope qHalf: α(b) = α(b+2) = 0, contradicting ¬hα20
            have hbqodd : Odd (b - q) := by simpa using odd_neg_zz hqodd
            have hb2qodd : Odd (b + 2 - q) := odd_diff_add_even hbqodd ⟨1, by ring⟩
            have hαb0 : qAffine (2 ^ t) A B b = 0 :=
              alpha_slope_half_zero_at_opposite ht1 A B q hsq (hαQ q hqodd) hbqodd
            have hαb20 : qAffine (2 ^ t) A B (b + 2) = 0 :=
              alpha_slope_half_zero_at_opposite ht1 A B q hsq (hαQ q hqodd) hb2qodd
            exact hnotA0 ⟨hαb0, hαb20⟩


/-- From a 2-apart pair in the bad coset (a coset of `2^{t-ord}ℤ`, `ord < t`), the
spacing is `2`, so any point of the same parity as the pair lies in the coset. -/
lemma mem_same_parity_of_pair {t ord : ℕ} (hord : ord < t) {sa sb c0 x : ℤ}
    (hcos : ∀ y : ℤ, y ∈ badCoset (2 ^ t) sa sb ↔ (((2 ^ (t - ord) : ℕ) : ℤ) ∣ y - c0))
    (hx : x ∈ badCoset (2 ^ t) sa sb) (hx2 : x + 2 ∈ badCoset (2 ^ t) sa sb)
    {y : ℤ} (he : Even (y - x)) : y ∈ badCoset (2 ^ t) sa sb := by
  -- spacing d divides 2 and is ≥ 2, so d = 2
  have hdvd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ 2 := by
    have h1 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ (x + 2) - c0 := (hcos (x + 2)).mp hx2
    have h2 : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ x - c0 := (hcos x).mp hx
    have hd : (((2 ^ (t - ord) : ℕ) : ℤ)) ∣ ((x + 2) - c0) - (x - c0) := dvd_sub h1 h2
    convert hd using 1 <;> ring
  have hge : 2 ≤ 2 ^ (t - ord) := by
    have : 1 ≤ t - ord := by omega
    exact pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) this
  have hnat : (2 ^ (t - ord) : ℕ) ∣ 2 := (Int.natCast_dvd_natCast).mp hdvd2
  have hle : 2 ^ (t - ord) ≤ 2 := Nat.le_of_dvd (by norm_num : 0 < 2) hnat
  have hd2 : (((2 ^ (t - ord) : ℕ) : ℤ)) = 2 := by
    have : 2 ^ (t - ord) = 2 := by omega
    exact_mod_cast this
  rw [hcos]
  -- 2 ∣ y − x (given) and 2 ∣ x − c0, so 2 ∣ y − c0
  have hx' : (2 : ℤ) ∣ x - c0 := by simpa [hd2] using (hcos x).mp hx
  have hyx : (2 : ℤ) ∣ y - x := by
    rcases he with ⟨w, hw⟩
    refine ⟨w, ?_⟩
    calc y - x = w + w := by rw [hw]
      _ = 2 * w := by ring
  have hd : (2 : ℤ) ∣ (y - x) + (x - c0) := dvd_add hyx hx'
  have hy : (2 : ℤ) ∣ y - c0 := by
    convert hd using 1 <;> ring
  rw [← hd2] at hy
  exact hy

/-- Main rigidity statement: coverage of the four points `{b, b+2, b+4, b+6}` (a
parity class inside the window) by `Γ` (zeros of `α`) and `Γg` (bad coset of the
structured line) forces `α_g` to agree with `α` wherever `α ≠ 0`.  The complementary
class of the window is anchored at `q`. -/
lemma rigid_out_main_q {t : ℕ} (ht : 3 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b q c0 : ℤ) (hb0 : n0 ≤ b) (hb6 : b + 6 ≤ n0 + 7)
    (hq0 : n0 ≤ q) (hq6 : q + 6 ≤ n0 + 7) (hqodd : Odd (q - b))
    (hcoset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hgl : ∀ x : ℤ, x ∉ badCoset (2 ^ t) sa sb →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) sa sb x)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0)
    (hcov : ∀ k : ℕ, k ≤ 6 → Even k → qAffine (2 ^ t) A B (b + k) = 0 ∨
        (b + k) ∈ badCoset (2 ^ t) sa sb) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  intro z hz
  have ht2 : 2 ≤ t := by omega
  let Γg : Set ℤ := badCoset (2 ^ t) sa sb
  -- Case A0: α vanishes at an adjacent pair of P
  by_cases hA0 : (qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0) ∨
                 (qAffine (2 ^ t) A B (b + 2) = 0 ∧ qAffine (2 ^ t) A B (b + 4) = 0) ∨
                 (qAffine (2 ^ t) A B (b + 4) = 0 ∧ qAffine (2 ^ t) A B (b + 6) = 0)
  · rcases hA0 with h0 | h0 | h0
    · exact rigid_out_A0 ht2 A B sa sb ord hord a' hfac hodd' n0 b q c0 hq0 hq6 hqodd
        h0.1 h0.2 hnzα hcoset hwin hgl z hz
    · have hqodd' : Odd (q - (b + 2)) := by
        have h : Odd ((q - b) - 2) := odd_sub_even_zz hqodd ⟨1, by ring⟩
        simpa [show (q - b) - 2 = q - (b + 2) by ring] using h
      have hz2 : qAffine (2 ^ t) A B ((b + 2) + 2) = 0 := by
        simpa [show ((b + 2) + 2 : ℤ) = b + 4 by ring] using h0.2
      exact rigid_out_A0 ht2 A B sa sb ord hord a' hfac hodd' n0 (b + 2) q c0
        (by omega) (by omega) hqodd' h0.1 hz2 hnzα hcoset hwin hgl z hz
    · have hqodd' : Odd (q - (b + 4)) := by
        have h : Odd ((q - b) - 4) := odd_sub_even_zz hqodd ⟨2, by ring⟩
        simpa [show (q - b) - 4 = q - (b + 4) by ring] using h
      have hz2 : qAffine (2 ^ t) A B ((b + 4) + 2) = 0 := by
        simpa [show ((b + 4) + 2 : ℤ) = b + 6 by ring] using h0.2
      exact rigid_out_A0 ht2 A B sa sb ord hord a' hfac hodd' n0 (b + 4) q c0
        (by omega) (by omega) hqodd' h0.1 hz2 hnzα hcoset hwin hgl z hz
  · -- ¬hA0
    have hnotA0 : ¬ (qAffine (2 ^ t) A B b = 0 ∧ qAffine (2 ^ t) A B (b + 2) = 0) := by
      intro h
      exact hA0 (Or.inl h)
    by_cases hA1 : (b ∈ Γg ∧ b + 2 ∈ Γg) ∨ (b + 2 ∈ Γg ∧ b + 4 ∈ Γg) ∨
        (b + 4 ∈ Γg ∧ b + 6 ∈ Γg)
    · -- Γg contains a 2-apart pair of P: then b, b+2 ∈ Γg
      have hbb : b ∈ Γg ∧ b + 2 ∈ Γg := by
        rcases hA1 with h1 | h2 | h3
        · exact h1
        · rcases h2 with ⟨hx, hx2⟩
          have hx2' : (b + 2) + 2 ∈ Γg := by
            simpa [show ((b + 2) + 2 : ℤ) = b + 4 by ring] using hx2
          exact ⟨mem_same_parity_of_pair hord hcoset hx hx2' ⟨-1, by ring⟩, hx⟩
        · rcases h3 with ⟨hx, hx2⟩
          have hx2' : (b + 4) + 2 ∈ Γg := by
            simpa [show ((b + 4) + 2 : ℤ) = b + 6 by ring] using hx2
          have hb' : b ∈ Γg := by
            apply mem_same_parity_of_pair hord hcoset hx hx2'
            use -2
            ring
          have hb2' : b + 2 ∈ Γg := by
            apply mem_same_parity_of_pair hord hcoset hx hx2'
            use -1
            ring
          exact ⟨hb', hb2'⟩
      exact rigid_out_A1 ht A B sa sb ord hord a' hfac hodd' n0 b q c0 hq0 hq6 hqodd
        hb0 hb6 hbb.1 hbb.2 hnzα hcoset hwin hgl z hz
    · -- ¬hA1: Γg ∩ P has no 2-apart pair.  Coverage forces either config C or D.
      have hnotA1' : ¬ (b ∈ Γg ∧ b + 2 ∈ Γg) := by
        intro h
        exact hA1 (Or.inl h)
      by_cases hZb : qAffine (2 ^ t) A B b = 0
      · -- config C: α(b) = α(b+4) = 0 and b+2, b+6 ∈ Γg
        have hαb2nz : qAffine (2 ^ t) A B (b + 2) ≠ 0 := by
          intro h
          exact hnotA0 ⟨hZb, h⟩
        have hb2g : b + 2 ∈ Γg := by
          rcases hcov 2 (by norm_num) ⟨1, rfl⟩ with h | h
          · exfalso
            exact hαb2nz h
          · simpa using h
        have hαb4 : qAffine (2 ^ t) A B (b + 4) = 0 := by
          by_contra hαb4nz
          have hb4g : b + 4 ∈ Γg := by
            rcases hcov 4 (by norm_num) ⟨2, rfl⟩ with h | h
            · exact False.elim (hαb4nz h)
            · simpa using h
          exact hA1 (Or.inr (Or.inl ⟨hb2g, hb4g⟩))
        have hb6g : b + 6 ∈ Γg := by
          by_contra hb6nz
          have hαb6 : qAffine (2 ^ t) A B (b + 6) = 0 := by
            rcases hcov 6 (by norm_num) ⟨3, rfl⟩ with h | h
            · exact h
            · exact False.elim (hb6nz h)
          exact hA0 (Or.inr (Or.inr ⟨hαb4, hαb6⟩))
        exact rigid_out_C ht2 A B sa sb ord hord a' hfac hodd' n0 b c0 hb0 hb6 hZb hαb4
          hαb2nz hnotA1' hb2g hb6g hcoset hwin z hz
      · -- config D: α(b+2) = α(b+6) = 0 and b, b+4 ∈ Γg
        have hbg : b ∈ Γg := by
          rcases hcov 0 (by norm_num) (⟨0, rfl⟩ : Even 0) with h | h
          · exfalso
            exact hZb (by simpa using h)
          · simpa using h
        have hαb2 : qAffine (2 ^ t) A B (b + 2) = 0 := by
          by_contra hαb2nz
          have hb2g : b + 2 ∈ Γg := by
            rcases hcov 2 (by norm_num) ⟨1, rfl⟩ with h | h
            · exact False.elim (hαb2nz h)
            · simpa using h
          exact hA1 (Or.inl ⟨hbg, hb2g⟩)
        have hαb4nz : qAffine (2 ^ t) A B (b + 4) ≠ 0 := by
          intro h
          exact hA0 (Or.inr (Or.inl ⟨hαb2, h⟩))
        have hb4g : b + 4 ∈ Γg := by
          rcases hcov 4 (by norm_num) ⟨2, rfl⟩ with h | h
          · exfalso
            exact hαb4nz h
          · simpa using h
        by_cases hαb6 : qAffine (2 ^ t) A B (b + 6) = 0
        · exact rigid_out_D ht2 A B sa sb ord hord a' hfac hodd' n0 b c0 hb0 hb6 hαb2 hαb6
            hZb (by
              intro h
              rcases h with ⟨h1, h2⟩
              exact hA1 (Or.inr (Or.inl ⟨h1, h2⟩))) hbg hb4g hcoset hwin z hz
        · exfalso
          have hb6g : b + 6 ∈ Γg := by
            rcases hcov 6 (by norm_num) ⟨3, rfl⟩ with h | h
            · exact False.elim (hαb6 h)
            · simpa using h
          exact hA1 (Or.inr (Or.inr ⟨hb4g, hb6g⟩))


/-- Top-level rigidity statement closing `main_b` (Case 2 of Prop "rigid-out"): the
covered parity class of the window is `{b, b+2, b+4, b+6}` with `n0 ≤ b` and
`b + 6 ≤ n0 + 7` (so `b = n0` or `b = n0 + 1`). -/
theorem rigid_out_main {t : ℕ} (ht : 3 ≤ t)
    (A B sa sb : ℤ) (ord : ℕ) (hord : ord < t) (a' : ℤ)
    (hfac : sa = (((2 ^ ord : ℕ) : ℤ) * a')) (hodd' : Odd a')
    (n0 b c0 : ℤ) (hb0 : n0 ≤ b) (hb6 : b + 6 ≤ n0 + 7)
    (hcoset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) sa sb ↔
        (((2 ^ (t - ord) : ℕ) : ℤ) ∣ x - c0))
    (hwin : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) A B x)
    (hgl : ∀ x : ℤ, x ∉ badCoset (2 ^ t) sa sb →
        qLine (2 ^ t) sa sb x = qAffine (2 ^ t) sa sb x)
    (hnzα : ¬ ∀ z : ℤ, qAffine (2 ^ t) A B z = 0)
    (hcov : ∀ k : ℕ, k ≤ 6 → Even k → qAffine (2 ^ t) A B (b + k) = 0 ∨
        (b + k) ∈ badCoset (2 ^ t) sa sb) :
    ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 → qAffine (2 ^ t) sa sb z = qAffine (2 ^ t) A B z := by
  classical
  have hbcase : b = n0 ∨ b = n0 + 1 := by omega
  rcases hbcase with hb | hb
  · subst b
    exact rigid_out_main_q ht A B sa sb ord hord a' hfac hodd' n0 n0 (n0 + 1) c0
      (by omega) (by omega) (by omega) (by omega) (by norm_num) hcoset hwin hgl hnzα
      (by simpa using hcov)
  · subst b
    exact rigid_out_main_q ht A B sa sb ord hord a' hfac hodd' n0 (n0 + 1) n0 c0
      (by omega) (by omega) (by omega) (by omega) (by norm_num) hcoset hwin hgl hnzα
      (by simpa using hcov)


theorem rigid_out_reduced {t N : ℕ} (ht : 3 ≤ t) (a b A B : ℤ) (n0 : ℤ)
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b))
    (hwin1 : 1 ≤ n0) (hwin2 : n0 + 7 ≤ ((N : ℕ) : ℤ))
    (hagree : ∀ n : Fin N, n0 ≤ finToInt n → finToInt n ≤ n0 + 7 →
        qAffine (2 ^ t) A B (finToInt n) ≠ 0 →
        qLine (2 ^ t) a b (finToInt n) = qAffine (2 ^ t) A B (finToInt n)) :
    ∀ n : Fin N, qAffine (2 ^ t) A B (finToInt n) ≠ 0 →
      qLine (2 ^ t) a b (finToInt n) = qAffine (2 ^ t) A B (finToInt n) := by
  classical
  have ht1 : 1 ≤ t := by omega
  -- consume the packaged statistics of the structured line g = qLine (2^t) a b
  rcases scal_line_stats_exists ht1 a b hred with ⟨S, rfl, rfl⟩
  -- the two-branch split of Lemma "stats" / rigid-out
  by_cases hInf : S.orderInf
  · -- Γ_g = ∅ (order −∞): the structured line is affine everywhere (S.hagree + horderInf),
    -- and it agrees with the given affine function α = qAffine A B on the 8-window
    -- wherever α ≠ 0 (hagree).  Remaining work:
    --   (A) from S.horderInf.mp hInf and S.hagree derive
    --         ∀ x : ℤ, qLine (2^t) a b x = qAffine (2^t) a b x;      [trivial, write now]
    --   (B) [the real content] two affine functions (qAffine a b and qAffine A B)
    --         agreeing at the ≥ 8 (hence ≥ 2 odd-separated, since α ≠ 0 there by
    --         hypothesis on the window, but we must still rule out that they only agree
    --         at even-separated points) window rows where α ≠ 0 must agree everywhere:
    --         need an "affine functions agree at 8 rows of an interval ⇒ agree
    --         everywhere" lemma for `qAffine` (over ZMod (2^t)).
    have hbempty : S.badCoset = ∅ := (S.horderInf).mp hInf
    have hlin : ∀ x : ℤ, qLine (2 ^ t) S.a S.b x = qAffine (2 ^ t) S.a S.b x := by
      intro x
      exact S.hagree x (by rw [hbempty]; simp)
    -- hypothesis over integers of the window, converted from the row hypothesis:
    have hext := qAffine_window_extend ht1 S.a S.b A B n0
    have hagree2 : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qAffine (2 ^ t) S.a S.b x = qAffine (2 ^ t) A B x := by
      intro x hx0 hx1 hαx
      -- x lies among the rows 1..N of the board (window inside {1..N})
      have hx1z : x ≤ ((N : ℕ) : ℤ) := by omega
      have hxmem : x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
        rw [Finset.mem_Icc]
        exact ⟨by omega, hx1z⟩
      let m : Fin N := intToFin ⟨x, hxmem⟩
      have hm : finToInt m = x := finToInt_intToFin ⟨x, hxmem⟩
      have hrow : qLine (2 ^ t) S.a S.b x = qAffine (2 ^ t) A B x := by
        -- hagree on the row m, then rewrite finToInt m = x
        have hαm : qAffine (2 ^ t) A B (finToInt m) ≠ 0 := by simpa [hm] using hαx
        have hwin0 : n0 ≤ finToInt m := by omega
        have hwin1 : finToInt m ≤ n0 + 7 := by omega
        have hg := hagree m hwin0 hwin1 hαm
        simpa [hm] using hg
      -- hlin gives the structured line equals the associated affine at x:
      have hαg : qAffine (2 ^ t) S.a S.b x = qAffine (2 ^ t) A B x := by
        calc
          qAffine (2 ^ t) S.a S.b x = qLine (2 ^ t) S.a S.b x := (hlin x).symm
          _ = qAffine (2 ^ t) A B x := hrow
      exact hαg
    intro n hnα
    -- conclusion: qLine (2^t) S.a S.b (finToInt n) = qAffine (2^t) A B (finToInt n)
    have hz : qAffine (2 ^ t) A B (finToInt n) ≠ 0 := hnα
    have hq := hext hagree2 (finToInt n) hz
    -- hq : qAffine S.a S.b (finToInt n) = qAffine A B (finToInt n); combine with hlin
    calc
      qLine (2 ^ t) S.a S.b (finToInt n) = qAffine (2 ^ t) S.a S.b (finToInt n) := hlin (finToInt n)
      _ = qAffine (2 ^ t) A B (finToInt n) := hq
  · -- Γ_g ≠ ∅ (finite order, ord = S.ord < t): the bad coset Γ_g = S.badCoset is a
    -- coset of 2^{t−ord}·ℤ (S.hcoset), with a = 2^{ord}·a′, a′ odd (S.hfactor), and g
    -- agrees with α_g := qAffine S.a S.b off Γ_g (S.hagree).
    -- Hypothesis over integer window points (row-level conversion, as in the order−∞ branch):
    have hq1 : 1 < 2 ^ t := two_pow_gt_one ht1
    have hbadEq : S.badCoset = badCoset (2 ^ t) S.a S.b := by
      simpa [S.hbad, badCoset]
    have hagree2 : ∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → qAffine (2 ^ t) A B x ≠ 0 →
        qLine (2 ^ t) S.a S.b x = qAffine (2 ^ t) A B x := by
      intro x hx0 hx1 hαx
      have hx1z : x ≤ ((N : ℕ) : ℤ) := by omega
      have hxmem : x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
        rw [Finset.mem_Icc]
        exact ⟨by omega, hx1z⟩
      let m : Fin N := intToFin ⟨x, hxmem⟩
      have hm : finToInt m = x := finToInt_intToFin ⟨x, hxmem⟩
      have hαm : qAffine (2 ^ t) A B (finToInt m) ≠ 0 := by simpa [hm] using hαx
      have hwin0 : n0 ≤ finToInt m := by omega
      have hwin1 : finToInt m ≤ n0 + 7 := by omega
      have hg := hagree m hwin0 hwin1 hαm
      simpa [hm] using hg
    -- Paper's first case: window rows x,y of different parity outside Γ ∪ Γ_g where the
    -- given affine is nonzero.  Then g = α_g = α at both (whole-line agreement off Γ_g and
    -- the window hypothesis), so α_g = α everywhere (odd-gap rigidity), hence g = α on all
    -- rows with α ≠ 0.
    by_cases h1 : ∃ x : ℤ, n0 ≤ x ∧ x ≤ n0 + 7 ∧ qAffine (2 ^ t) A B x ≠ 0 ∧
                  x ∉ badCoset (2 ^ t) S.a S.b ∧
                  ∃ y : ℤ, n0 ≤ y ∧ y ≤ n0 + 7 ∧ qAffine (2 ^ t) A B y ≠ 0 ∧
                  y ∉ badCoset (2 ^ t) S.a S.b ∧ Odd (y - x)
    · rcases h1 with ⟨x, hx0, hx1, hαx, hxg, y, hy0, hy1, hαy, hyg, hodd⟩
      have hαgx : qAffine (2 ^ t) S.a S.b x = qAffine (2 ^ t) A B x := by
        calc
          qAffine (2 ^ t) S.a S.b x = qLine (2 ^ t) S.a S.b x := by
              -- agreement of g with α_g off Γ_g (S.hagree), x ∉ Γ_g
              exact (S.hagree x (by simpa [← hbadEq] using hxg)).symm
          _ = qAffine (2 ^ t) A B x := hagree2 x hx0 hx1 hαx
      have hαgy : qAffine (2 ^ t) S.a S.b y = qAffine (2 ^ t) A B y := by
        calc
          qAffine (2 ^ t) S.a S.b y = qLine (2 ^ t) S.a S.b y :=
              (S.hagree y (by simpa [← hbadEq] using hyg)).symm
          _ = qAffine (2 ^ t) A B y := hagree2 y hy0 hy1 hαy
      -- D(x) = D(y) = 0 with Odd (y−x): D ≡ 0
      have hDx : qAffine (2 ^ t) (S.a - A) (S.b - B) x = 0 := by
        exact ((qAffine_sub (2 ^ t) S.a S.b A B x).symm).trans (sub_eq_zero.mpr hαgx)
      have hDy : qAffine (2 ^ t) (S.a - A) (S.b - B) y = 0 := by
        exact ((qAffine_sub (2 ^ t) S.a S.b A B y).symm).trans (sub_eq_zero.mpr hαgy)
      have hD : ∀ z : ℤ, qAffine (2 ^ t) (S.a - A) (S.b - B) z = 0 :=
        qAffine_zero_of_odd_gap ht1 (S.a - A) (S.b - B) hodd hDx hDy
      -- hence α_g = α: a row z with α(z) ≠ 0 lies outside Γ_g (else α_g(z) = α(z) = 0),
      -- so g(z) = α_g(z) = α(z)
      have hαg_eq : ∀ z : ℤ, qAffine (2 ^ t) S.a S.b z = qAffine (2 ^ t) A B z := by
        intro z
        have h0 := hD z  -- qAffine (S.a−A)(S.b−B) z = 0
        have hdiff : qAffine (2 ^ t) S.a S.b z - qAffine (2 ^ t) A B z = 0 := by
          exact (qAffine_sub (2 ^ t) S.a S.b A B z).trans h0
        exact sub_eq_zero.mp hdiff
      intro n hnα
      have hz : qAffine (2 ^ t) A B (finToInt n) ≠ 0 := hnα
      have hznzS : finToInt n ∉ S.badCoset := by
        intro hmem
        have h0 : qAffine (2 ^ t) S.a S.b (finToInt n) = 0 := by
          rw [S.hbad] at hmem
          exact hmem
        exact hz (by simpa [hαg_eq] using h0)
      have hg := S.hagree (finToInt n) hznzS
      calc
        qLine (2 ^ t) S.a S.b (finToInt n) = qAffine (2 ^ t) S.a S.b (finToInt n) := hg
        _ = qAffine (2 ^ t) A B (finToInt n) := hαg_eq (finToInt n)
    · -- Remaining (paper Case 2): Γ ∪ Γ_g covers every cross-parity pair of window rows.
      -- First structural sentence: any two window rows that avoid both Γ (α ≠ 0) and
      -- Γ_g have the same parity (an odd-separated pair of such rows would contradict
      -- ¬h1 directly).
      have hfree_same : ∀ x y : ℤ, n0 ≤ x → x ≤ n0 + 7 → n0 ≤ y → y ≤ n0 + 7 →
          qAffine (2 ^ t) A B x ≠ 0 → x ∉ badCoset (2 ^ t) S.a S.b →
          qAffine (2 ^ t) A B y ≠ 0 → y ∉ badCoset (2 ^ t) S.a S.b →
          ¬ Odd (y - x) := by
        intro x y hx0 hx1 hy0 hy1 hαx hxg hαy hyg hodd
        exact (h1) ⟨x, hx0, hx1, hαx, hxg, ⟨y, hy0, hy1, hαy, hyg, hodd⟩⟩
      -- Second sentence (paper "only remaining cases"): the union Γ ∪ Γ_g covers at least
      -- one full parity class of the window — for either parity, no free row exists.
      -- "Free" means outside both zero sets: α ≠ 0 and outside Γ_g.
      have hcover_parity :
          (∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → Even (x - n0) →
              ¬ (qAffine (2 ^ t) A B x ≠ 0 ∧ x ∉ badCoset (2 ^ t) S.a S.b)) ∨
          (∀ x : ℤ, n0 ≤ x → x ≤ n0 + 7 → ¬ Even (x - n0) →
              ¬ (qAffine (2 ^ t) A B x ≠ 0 ∧ x ∉ badCoset (2 ^ t) S.a S.b)) := by
        by_cases hfreeA : ∃ x : ℤ, n0 ≤ x ∧ x ≤ n0 + 7 ∧ Even (x - n0) ∧
            (qAffine (2 ^ t) A B x ≠ 0 ∧ x ∉ badCoset (2 ^ t) S.a S.b)
        · right
          intro y hy0 hy1 hyB hyfree
          rcases hfreeA with ⟨x, hx0, hx1, hxA, hfreex⟩
          have hoddm : Odd (y - n0) := (Int.not_even_iff_odd.mp hyB)
          have hEvenn : Even (x - n0) := hxA
          have hodd : Odd (y - x) := by
            have hif : Odd (y - n0) ↔ Even (x - n0) := by
              constructor
              · intro _h
                exact hEvenn
              · intro _h
                exact hoddm
            have : Odd ((y - n0) - (x - n0)) := (Int.odd_sub).mpr hif
            convert this using 1 <;> ring
          have hnod : ¬ Odd (y - x) :=
            hfree_same x y hx0 hx1 hy0 hy1 hfreex.1 hfreex.2 hyfree.1 hyfree.2
          exact hnod hodd
        · left
          intro x hx0 hx1 hxA hxfree
          exact (hfreeA) ⟨x, hx0, hx1, hxA, hxfree⟩
      -- Case 2 (paper tex 1227-1264): Γ ∪ Γ_g occupies a full parity class of the
      -- window (hcover_parity).  Handle t = 1 directly (then qLine 2 a b ≡ 1 and all
      -- nonzero ZMod-2 values are 1); for t ≥ 2 run the coset/parity case analysis which
      -- concludes that the affine functions agree everywhere the given affine is nonzero.
      by_cases h2 : 2 ≤ t
      · -- t ≥ 2: full case analysis; target: whole-ℤ agreement of α_g with α off Γ.
        have T' : ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 →
            qAffine (2 ^ t) S.a S.b z = qAffine (2 ^ t) A B z := by
          by_cases hα0 : ∀ z : ℤ, qAffine (2 ^ t) A B z = 0
          · intro z hz
            exact False.elim (hz (hα0 z))
          · -- α ≢ 0: the hcover_parity case analysis.
            have hnzA : ¬ (∀ z : ℤ, qAffine (2 ^ t) A B z = 0) := hα0
            have hq1 : 1 < 2 ^ t := two_pow_gt_one (by omega : 1 ≤ t)
            -- Structure of Γ_g: a single coset of 2^{t-ord}·ℤ (finite-order branch).
            have hord : S.ord < t := S.hord_lt hInf
            rcases S.hfactor hInf with ⟨a', hfac, hodd'⟩
            have hcos1 : ¬ S.badCoset = ∅ := by
              intro hempty
              exact hInf ((S.horderInf).mpr hempty)
            rcases S.hcoset hInf with hempty | ⟨n₀, hcos⟩
            · exact False.elim (hcos1 hempty)
            -- membership in Γ_g = S.badCoset iff membership in the coset of 2^{t-ord}:
            have hbad_coset : ∀ x : ℤ, x ∈ S.badCoset ↔
                ((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n₀ := by
              intro x
              rw [hcos]
              rfl
            -- The case analysis is symmetric in the two window parity classes; factor it
            -- over the anchor b of the covered class.  main_b proves T' from coverage of
            -- the four points {b, b+2, b+4, b+6} (b and b+6 both inside the window).
            have main_b : ∀ b : ℤ, n0 ≤ b → b + 6 ≤ n0 + 7 →
                (∀ k : ℕ, k ≤ 6 → Even k →
                  qAffine (2 ^ t) A B (b + k) = 0 ∨ (b + k) ∈ badCoset (2 ^ t) S.a S.b) →
                ∀ z : ℤ, qAffine (2 ^ t) A B z ≠ 0 →
                  qAffine (2 ^ t) S.a S.b z = qAffine (2 ^ t) A B z := by
              intro b hb0 hb6 hcov
              -- membership in Γ_g = S.badCoset in coset form:
              have hmem_coset : ∀ x : ℤ, x ∈ badCoset (2 ^ t) S.a S.b ↔
                  ((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n₀ := by
                intro x
                rw [← hbadEq]
                exact hbad_coset x
              -- The full case analysis (configs I/II/III of the paper, tex 1234-1264)
              -- is assembled in `rigid_out_main` (above); its hypotheses match this
              -- context exactly (coverage of the class, coset structure, agreements).
              exact rigid_out_main ht A B S.a S.b S.ord hord a' hfac hodd' n0 b n₀ hb0 hb6
                hmem_coset hagree2
                (fun x hxnot => S.hagree x (by
                  intro hm
                  exact hxnot (by simpa [hbadEq] using hm)))
                hnzA hcov
            rcases hcover_parity with hcovE | hcovO
            · apply main_b n0 (by norm_num) (by norm_num)
              intro k hk hke
              have hx0 : n0 ≤ n0 + k := by omega
              have hx1 : n0 + k ≤ n0 + 7 := by omega
              have hEvenx : Even ((n0 + k) - n0) := by
                have hk' : ((n0 + k : ℤ) - n0) = (k : ℤ) := by ring
                rw [hk']
                rcases hke with ⟨m, hm⟩
                refine ⟨(m : ℤ), ?_⟩
                rw [hm]
                norm_num [Nat.cast_add]
              have hfree := hcovE (n0 + k) hx0 hx1 hEvenx
              by_contra hnot
              push_neg at hnot
              rcases hnot with ⟨hαnz, hxΓg⟩
              exact hfree ⟨hαnz, hxΓg⟩
            · apply main_b (n0 + 1) (by norm_num) (by omega)
              intro k hk hke
              have hx0 : n0 ≤ n0 + 1 + k := by omega
              have hx1 : n0 + 1 + k ≤ n0 + 7 := by omega
              have hNotEvenx : ¬ Even ((n0 + 1 + k) - n0) := by
                have hk' : ((n0 + 1 + k : ℤ) - n0) = ((k : ℤ) + 1) := by ring
                rw [hk']
                rw [Int.not_even_iff_odd]
                rcases hke with ⟨m, hm⟩
                refine ⟨(m : ℤ), ?_⟩
                rw [hm]
                norm_num [Nat.cast_add]
                ring
              have hfree := hcovO (n0 + 1 + k) hx0 hx1 hNotEvenx
              by_contra hnot
              push_neg at hnot
              rcases hnot with ⟨hαnz, hxΓg⟩
              exact hfree ⟨hαnz, hxΓg⟩
        intro n hnα
        have hz : qAffine (2 ^ t) A B (finToInt n) ≠ 0 := hnα
        have hT := T' (finToInt n) hz
        have hznz : finToInt n ∉ S.badCoset := by
          intro hmem
          have h0 : qAffine (2 ^ t) S.a S.b (finToInt n) = 0 := by
            rw [S.hbad] at hmem
            exact hmem
          exact hz (by simpa [hT] using h0)
        have hg := S.hagree (finToInt n) hznz
        calc
          qLine (2 ^ t) S.a S.b (finToInt n) = qAffine (2 ^ t) S.a S.b (finToInt n) := hg
          _ = qAffine (2 ^ t) A B (finToInt n) := hT
      · -- t < 2 is impossible since 3 ≤ t (the t = 1 degenerate case is vacuous).
        exfalso
        omega

end
end Commons.PeriodicTiling

open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

/-!
# Column statistics: good columns imply digit equidistribution

The first connection between the *good columns* property of a Sudoku solution and the
counting/rigidity analysis: on a column with permutation `σ`, a nonzero digit `γ` can
only be attained on the two residue classes `σ⁻¹(γ)` and `σ⁻¹(0)` of `ℤ/qℤ`.  This gives
the finite form of the paper's Lemma (good columns imply weak digit equidistribution):
each digit occurs in at most `O(1/q)` of any vertical window.
-/

/-- Congruence of two integers mod `q` is the same as divisibility of their difference. -/
lemma zmod_eq_iff_int_sub_dvd (q : ℕ) (m r : ℤ) :
    (m : ZMod q) = (r : ZMod q) ↔ ((q : ℕ) : ℤ) ∣ m - r := by
  rw [← sub_eq_zero]
  rw [← Int.cast_sub]
  exact ZMod.intCast_zmod_eq_zero_iff_dvd (m - r) q

/-- The number of integers `m ∈ [-K,K]` whose reduction mod `q` is a fixed residue
class is at most about `1/q` of the window. -/
lemma intResidue_window_le (q : ℕ) (hq : 0 < q) (r : ℤ) (K : ℕ) :
    ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun m : ℤ => (m : ZMod q) = (r : ZMod q))).card ≤
      (2 * K) / q + 1 := by
  classical
  rw [show ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun m : ℤ => (m : ZMod q) = (r : ZMod q))) =
      ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun m : ℤ => ((q : ℕ) : ℤ) ∣ m - r)) by
    apply Finset.filter_congr
    intro m hm
    exact zmod_eq_iff_int_sub_dvd q m r]
  exact coset_count_upper_bound q hq r K

/-- Number of integers `m ∈ [-K, K]` in which the column `n` of `F` takes the digit `γ`. -/
noncomputable def columnDigitCount {q N : ℕ} (F : SudokuBoard q N) (n : Fin N)
    (γ : ZMod q) (K : ℕ) : ℕ :=
  ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun m : ℤ => F n m = γ)).card

/-- For a column with permutation `σ`, the set of `m` where `F n m = γ` (for a nonzero
digit `γ`) is contained in the union of the two residue classes `σ⁻¹(γ)` and `σ⁻¹(0)`. -/
lemma goodColumn_digitSet_subset_union {q N : ℕ} {F : SudokuBoard q N} {n : Fin N}
    {σ : ZMod q ≃ ZMod q}
    (hσ : ∀ m : ℤ, σ (m : ZMod q) ≠ 0 → F n m = σ (m : ZMod q))
    {γ : ZMod q} (m : ℤ) :
    F n m = γ → (m : ZMod q) = σ.symm γ ∨ (m : ZMod q) = σ.symm 0 := by
  intro hm
  by_cases hz : σ (m : ZMod q) = 0
  · right
    have h1 : σ.symm (σ (m : ZMod q)) = σ.symm (0 : ZMod q) := congrArg σ.symm hz
    simpa using h1
  · left
    have hF := hσ m hz
    have hEq : σ (m : ZMod q) = γ := hF.symm.trans hm
    have h1 : σ.symm (σ (m : ZMod q)) = σ.symm γ := congrArg σ.symm hEq
    simpa using h1

/-- Good columns imply digit equidistribution (finite form): on any column `n` of a
Sudoku solution with good columns, each nonzero digit `γ` is attained in at most
`2 · (⌊2K/q⌋ + 1)` of the integers `m ∈ [-K, K]`; the upper density of each digit in a
column is at most `2/q`. -/
theorem goodColumns_column_digit_le {q N : ℕ} (hq : 0 < q) {F : SudokuBoard q N}
    (hgood : HasGoodColumns q N F) (n : Fin N) (γ : ZMod q) (K : ℕ) :
    columnDigitCount F n γ K ≤ 2 * ((2 * K) / q + 1) := by
  classical
  rcases hgood n with ⟨σ, hσ⟩
  let r₁ : ℤ := ZMod.cast (σ.symm γ)
  let r₀ : ℤ := ZMod.cast (σ.symm 0)
  have hr₁ : (r₁ : ZMod q) = σ.symm γ := by
    dsimp [r₁]
    exact ZMod.intCast_zmod_cast (σ.symm γ)
  have hr₀ : (r₀ : ZMod q) = σ.symm 0 := by
    dsimp [r₀]
    exact ZMod.intCast_zmod_cast (σ.symm 0)
  let win : Finset ℤ := Finset.Icc (-(K : ℤ)) (K : ℤ)
  let S : Finset ℤ := win.filter (fun m : ℤ => F n m = γ)
  let S₁ : Finset ℤ := win.filter (fun m : ℤ => (m : ZMod q) = (r₁ : ZMod q))
  let S₀ : Finset ℤ := win.filter (fun m : ℤ => (m : ZMod q) = (r₀ : ZMod q))
  have hsub : S ⊆ S₁ ∪ S₀ := by
    intro m hm
    rw [Finset.mem_union]
    rw [Finset.mem_filter] at hm
    rcases hm with ⟨hI, hmF⟩
    have hcases := goodColumn_digitSet_subset_union (σ := σ) hσ m hmF
    rcases hcases with hc | hc
    · left
      rw [Finset.mem_filter]
      constructor
      · exact hI
      · exact hc.trans hr₁.symm
    · right
      rw [Finset.mem_filter]
      constructor
      · exact hI
      · exact hc.trans hr₀.symm
  have hcard₁ : S₁.card ≤ (2 * K) / q + 1 := by
    dsimp [S₁]
    exact intResidue_window_le q hq r₁ K
  have hcard₀ : S₀.card ≤ (2 * K) / q + 1 := by
    dsimp [S₀]
    exact intResidue_window_le q hq r₀ K
  have hmain : S.card ≤ 2 * ((2 * K) / q + 1) := by
    calc
      S.card ≤ (S₁ ∪ S₀).card := Finset.card_le_card hsub
      _ ≤ S₁.card + S₀.card := Finset.card_union_le S₁ S₀
      _ ≤ (2 * K) / q + 1 + ((2 * K) / q + 1) := Nat.add_le_add hcard₁ hcard₀
      _ = 2 * ((2 * K) / q + 1) := by omega
  simpa [S, columnDigitCount, win] using hmain

/-- Zero is never a digit of a Sudoku solution column. -/
lemma columnDigitCount_zero {q N : ℕ} {F : SudokuBoard q N} (hsud : IsSudokuSolution q N F)
    (n : Fin N) (K : ℕ) : columnDigitCount F n 0 K = 0 := by
  classical
  dsimp [columnDigitCount]
  rw [Finset.card_eq_zero]
  rw [Finset.filter_eq_empty_iff]
  intro m _hm hzero
  exact (hsud.1 n m) hzero




/-- The number of integers in the symmetric window `[-K,K]` that reduce (mod `q`) to the
fixed residue `c` is at most about `1/q` of the window. -/
lemma residueClass_window_le' (q : ℕ) (hq : 0 < q) (c : ZMod q) (K : ℕ) :
    ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun i : ℤ => (i : ZMod q) = c)).card ≤
      (2 * K) / q + 1 := by
  classical
  let r : ℤ := ZMod.cast c
  have hr : (r : ZMod q) = c := ZMod.intCast_zmod_cast c
  rw [show ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun i : ℤ => (i : ZMod q) = c)) =
      ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun i : ℤ => (i : ZMod q) = (r : ZMod q))) by
    apply Finset.filter_congr
    intro i hi
    exact ⟨fun h => by simpa [hr] using h, fun h => by simpa [hr] using h⟩]
  exact intResidue_window_le q hq r K

/-- Shift-invariance of a residue condition: a column cell `(n, m = jn + i)` with
`F n m = γ` forces the intercept `i` to reduce to one of two residues modulo `q`. -/
lemma goodColumn_intercept_residue {q N : ℕ} {F : SudokuBoard q N} {n : Fin N}
    {σ : ZMod q ≃ ZMod q}
    (hσ : ∀ m : ℤ, σ (m : ZMod q) ≠ 0 → F n m = σ (m : ZMod q)) (j : ℤ)
    {γ : ZMod q} (i : ℤ) :
    F n (j * ((n.val : ℤ) + 1) + i) = γ →
      (i : ZMod q) = σ.symm γ - (j * ((n.val : ℤ) + 1) : ZMod q) ∨
      (i : ZMod q) = σ.symm 0 - (j * ((n.val : ℤ) + 1) : ZMod q) := by
  intro hF
  have hc := goodColumn_digitSet_subset_union (σ := σ) hσ (j * ((n.val : ℤ) + 1) + i) hF
  have hsplit : (j * ((n.val : ℤ) + 1) + i : ZMod q) =
      (j * ((n.val : ℤ) + 1) : ZMod q) + (i : ZMod q) := by
    simp
  rcases hc with hc | hc
  · left
    have hc' : (j * ((n.val : ℤ) + 1) : ZMod q) + (i : ZMod q) = σ.symm γ := by
      simpa [hsplit] using hc
    have hlin := congrArg (fun z : ZMod q => z - (j * ((n.val : ℤ) + 1) : ZMod q)) hc'
    simpa using hlin
  · right
    have hc' : (j * ((n.val : ℤ) + 1) : ZMod q) + (i : ZMod q) = σ.symm 0 := by
      simpa [hsplit] using hc
    have hlin := congrArg (fun z : ZMod q => z - (j * ((n.val : ℤ) + 1) : ZMod q)) hc'
    simpa using hlin

/-- Number of cells `(n, jn+i)` of slope `j` with intercept `i ∈ [-K,K]` on which the
column `n` takes the digit `γ`. -/
noncomputable def interceptDigitCount {q N : ℕ} (F : SudokuBoard q N) (j : ℤ) (γ : ZMod q)
    (K : ℕ) : ℕ :=
  ∑ n : Fin N, ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun i : ℤ => F n (j * ((n.val : ℤ) + 1) + i) = γ)).card

/-- Good columns imply digit equidistribution along every family of slope-`j` lines in the
finite intercept window `[-K,K]`: each digit is attained in at most
`N · 2 · (⌊2K/q⌋ + 1)` of the cells.  This is the finite form of the paper's
Lemma (good columns imply weak digit equidistribution) at board level. -/
theorem goodColumns_interceptWindow_le {q N : ℕ} (hq : 0 < q) {F : SudokuBoard q N}
    (hgood : HasGoodColumns q N F) (j : ℤ) (γ : ZMod q) (K : ℕ) :
    interceptDigitCount F j γ K ≤ N * (2 * ((2 * K) / q + 1)) := by
  classical
  have hstep : ∀ n : Fin N,
      ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun i : ℤ => F n (j * ((n.val : ℤ) + 1) + i) = γ)).card ≤
        2 * ((2 * K) / q + 1) := by
    intro n
    rcases hgood n with ⟨σ, hσ⟩
    let c₁ : ZMod q := σ.symm γ - (j * ((n.val : ℤ) + 1) : ZMod q)
    let c₀ : ZMod q := σ.symm 0 - (j * ((n.val : ℤ) + 1) : ZMod q)
    let win : Finset ℤ := Finset.Icc (-(K : ℤ)) (K : ℤ)
    let S₁ : Finset ℤ := win.filter (fun i : ℤ => (i : ZMod q) = c₁)
    let S₀ : Finset ℤ := win.filter (fun i : ℤ => (i : ZMod q) = c₀)
    have hsub : win.filter (fun i : ℤ => F n (j * ((n.val : ℤ) + 1) + i) = γ) ⊆ S₁ ∪ S₀ := by
      intro i hi
      rw [Finset.mem_union]
      rw [Finset.mem_filter] at hi ⊢
      rcases hi with ⟨hI, hiF⟩
      have hcases := goodColumn_intercept_residue (σ := σ) hσ j (γ := γ) i hiF
      rcases hcases with hc | hc
      · left
        exact ⟨hI, hc⟩
      · right
        rw [Finset.mem_filter]
        exact ⟨hI, hc⟩
    have hcard₁ : S₁.card ≤ (2 * K) / q + 1 := by
      dsimp [S₁]
      exact residueClass_window_le' q hq c₁ K
    have hcard₀ : S₀.card ≤ (2 * K) / q + 1 := by
      dsimp [S₀]
      exact residueClass_window_le' q hq c₀ K
    calc
      (win.filter (fun i : ℤ => F n (j * ((n.val : ℤ) + 1) + i) = γ)).card ≤ (S₁ ∪ S₀).card :=
        Finset.card_le_card hsub
      _ ≤ S₁.card + S₀.card := Finset.card_union_le S₁ S₀
      _ ≤ 2 * ((2 * K) / q + 1) := by omega
  calc
    interceptDigitCount F j γ K = ∑ n : Fin N, ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun i : ℤ => F n (j * ((n.val : ℤ) + 1) + i) = γ)).card := rfl
    _ ≤ ∑ _n : Fin N, (2 * ((2 * K) / q + 1)) := by
      apply Finset.sum_le_sum
      intro n hn
      exact hstep n
    _ = N * (2 * ((2 * K) / q + 1)) := by simp

end

end Commons.PeriodicTiling


open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Rigidity layer: the `q/2`-fibre and Lemma "rare"

Raw algebraic input to the paper's Lemma (weak digit equidistribution implies high-order
lines are rare): an affine function `α(n) = 2^o·(a′n+b′) mod 2^t` with `a′` odd attains
the value `q/2 = 2^{t-1}` exactly on one residue class modulo `2^{t-o}`; hence it attains
`q/2` at least `N / 2^{t-o}` integers of `{1,…,N}`.

The results here are finite and self-contained (Mathlib plus the Sudoku framework);
they feed the later double-counting ("rare") and the rigidity (`n8`, `rigid-out`)
layers of the Greenfeld--Tao Sudoku argument. -/

/-! ## Divisibility algebra for powers of two -/

/-- Divisibility cancellation of powers of two over `ℤ`. -/
lemma pow_two_mul_dvd_cancel {t o : ℕ} (ho : o ≤ t) {a : ℤ} :
    (2 : ℤ) ^ t ∣ (2 : ℤ) ^ o * a ↔ (2 : ℤ) ^ (t - o) ∣ a := by
  have hfac : (2 : ℤ) ^ t = (2 : ℤ) ^ o * (2 : ℤ) ^ (t - o) := by
    rw [← pow_add]
    rw [Nat.add_sub_of_le ho]
  have hc : (2 : ℤ) ^ o ≠ 0 := pow_ne_zero o (by norm_num)
  rw [hfac]
  exact mul_dvd_mul_iff_left hc

/-- `2^{t-1}` factors as `2^o · 2^{t-1-o}` when `o ≤ t-1`. -/
lemma pow_two_sub_one_factor {t o : ℕ} (ho : o ≤ t - 1) :
    (2 : ℤ) ^ (t - 1) = (2 : ℤ) ^ o * (2 : ℤ) ^ (t - 1 - o) := by
  rw [← pow_add]
  congr 1
  omega

/-- Divisibility form of the `q/2`-fibre: `2^o·(a′n+b′) ≡ 2^{t-1} (mod 2^t)` iff
`a′n+b′ ≡ 2^{t-1-o} (mod 2^{t-o})`. -/
theorem affine_qdiv2_dvd_fiber {t o : ℕ} (a' b' n : ℤ) (ho : o ≤ t - 1) :
    (((2 ^ t : ℕ) : ℤ) ∣ (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1))
      ↔ (2 : ℤ) ^ (t - o) ∣ (a' * n + b' - (2 : ℤ) ^ (t - 1 - o)) := by
  have ho_t : o ≤ t := by omega
  have hcast : (((2 ^ t : ℕ) : ℤ)) = (2 : ℤ) ^ t := by simp
  constructor
  · intro hd
    have hd' : (2 : ℤ) ^ t ∣ (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1) := by
      simpa [hcast] using hd
    have hdiff : (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1) =
        (2 : ℤ) ^ o * (a' * n + b' - (2 : ℤ) ^ (t - 1 - o)) := by
      rw [pow_two_sub_one_factor ho]
      ring
    rw [hdiff] at hd'
    exact (pow_two_mul_dvd_cancel (t := t) (o := o) ho_t).mp hd'
  · intro hd
    have hd1 : (2 : ℤ) ^ t ∣ (2 : ℤ) ^ o * (a' * n + b' - (2 : ℤ) ^ (t - 1 - o)) :=
      (pow_two_mul_dvd_cancel (t := t) (o := o) ho_t).mpr hd
    have hdiff : (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1) =
        (2 : ℤ) ^ o * (a' * n + b' - (2 : ℤ) ^ (t - 1 - o)) := by
      rw [pow_two_sub_one_factor ho]
      ring
    have hd2 : (2 : ℤ) ^ t ∣ (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1) := by
      rwa [hdiff]
    exact (by simpa [hcast] using hd2 : (((2 ^ t : ℕ) : ℤ) ∣
      (2 : ℤ) ^ o * (a' * n + b') - (2 : ℤ) ^ (t - 1)))

/-! ## Window counting for residue classes -/

/-- Congruence-mod-`Q` membership as an equality of remainders. -/
lemma int_dvd_sub_iff_emod_eq {Q : ℕ} (n n₀ : ℤ) :
    (((Q : ℕ) : ℤ) ∣ n - n₀) ↔ n % ((Q : ℕ) : ℤ) = n₀ % ((Q : ℕ) : ℤ) := by
  rw [Int.dvd_iff_emod_eq_zero]
  exact (Int.emod_eq_emod_iff_emod_sub_eq_zero (m := n) (n := ((Q : ℕ) : ℤ)) (k := n₀)).symm

/-- Any single residue class modulo `Q` occupies at least `N/Q` of the window
`{1,…,N}`. -/
lemma residueClass_Icc_count_lower (Q N : ℕ) (hQ : 0 < Q) (n₀ : ℤ) :
    N / Q ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ n - n₀)).card := by
  classical
  have hQZpos : (0 : ℤ) < (Q : ℤ) := by exact_mod_cast hQ
  have hQZnz : (Q : ℤ) ≠ 0 := by exact_mod_cast (ne_of_gt hQ)
  let r : ℤ := n₀ % (Q : ℤ)
  have hr0 : 0 ≤ r := Int.emod_nonneg n₀ hQZnz
  have hrQ : r < (Q : ℤ) := Int.emod_lt_of_pos n₀ hQZpos
  let c : ℕ := r.toNat
  have hc_eq : (c : ℤ) = r := Int.toNat_of_nonneg hr0
  have hcQ : c < Q := by
    have hcQz : (c : ℤ) < (Q : ℤ) := by simpa [← hc_eq] using hrQ
    exact_mod_cast hcQz
  -- The class of n₀ equals the class of c.
  have hclassc : ∀ n : ℤ, (((Q : ℕ) : ℤ) ∣ n - n₀) ↔ (((Q : ℕ) : ℤ) ∣ n - (c : ℤ)) := by
    intro n
    rw [int_dvd_sub_iff_emod_eq (Q := Q) n n₀]
    rw [int_dvd_sub_iff_emod_eq (Q := Q) n (c : ℤ)]
    have hcq_mod : ((c : ℤ) % (Q : ℤ)) = (c : ℤ) :=
      Int.emod_eq_of_lt (by exact_mod_cast (Nat.zero_le c)) (by exact_mod_cast hcQ)
    rw [hcq_mod]
    change (n % (Q : ℤ) = r) ↔ (n % (Q : ℤ) = (c : ℤ))
    rw [hc_eq]
  let S : Finset ℤ := (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
    (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ n - (c : ℤ))
  have hS_eq : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ n - n₀)) = S := by
    unfold S
    apply Finset.filter_congr
    intro n hn
    exact hclassc n
  rw [hS_eq]
  have hdiv_le : (N / Q) * Q ≤ N := Nat.div_mul_le_self N Q
  let φ : Fin (N / Q) → ℤ := fun k =>
    (if c = 0 then (k.val + 1) * Q else k.val * Q + c : ℕ)
  have hφ_in : ∀ k : Fin (N / Q), φ k ∈ S := by
    intro k
    have hklt : k.val < N / Q := k.isLt
    have hk1 : k.val + 1 ≤ N / Q := Nat.succ_le_of_lt hklt
    have hmul : (k.val + 1) * Q ≤ N :=
      Nat.le_trans (Nat.mul_le_mul_right Q hk1) hdiv_le
    have hlow : (1 : ℤ) ≤ φ k := by
      dsimp [φ]
      by_cases hc : c = 0
      · rw [if_pos hc]
        have hz : 0 < (k.val + 1) * Q := Nat.mul_pos (Nat.succ_pos k.val) hQ
        exact_mod_cast (Nat.succ_le_of_lt hz)
      · rw [if_neg hc]
        have hc1 : 1 ≤ c := by omega
        have htmp : c ≤ c + k.val * Q := Nat.le_add_right c (k.val * Q)
        have htarget : 1 ≤ k.val * Q + c := by
          rw [Nat.add_comm]
          exact le_trans hc1 htmp
        exact_mod_cast htarget
    have hhigh : φ k ≤ (N : ℤ) := by
      dsimp [φ]
      by_cases hc : c = 0
      · rw [if_pos hc]
        exact_mod_cast hmul
      · rw [if_neg hc]
        have hcQ' : c ≤ Q := le_of_lt hcQ
        have hA : k.val * Q + c ≤ k.val * Q + Q := Nat.add_le_add_left hcQ' (k.val * Q)
        have hB : k.val * Q + Q = (k.val + 1) * Q := by
          rw [← Nat.succ_eq_add_one, Nat.succ_mul]
        rw [hB] at hA
        exact_mod_cast (le_trans hA hmul)
    have hclass : ((Q : ℕ) : ℤ) ∣ (φ k) - (c : ℤ) := by
      dsimp [φ]
      by_cases hc : c = 0
      · rw [if_pos hc]
        rw [hc]
        refine ⟨((k.val + 1 : ℕ) : ℤ), ?_⟩
        rw [Nat.cast_mul]
        ring
      · rw [if_neg hc]
        refine ⟨((k.val : ℕ) : ℤ), ?_⟩
        rw [Nat.cast_add, Nat.cast_mul]
        ring
    rw [Finset.mem_filter]
    constructor
    · rw [Finset.mem_Icc]
      exact ⟨hlow, hhigh⟩
    · exact hclass
  have hinj : Function.Injective φ := by
    intro a b h
    apply Fin.ext
    dsimp [φ] at h
    by_cases hc : c = 0
    · rw [if_pos hc, if_pos hc] at h
      have hnat : (a.val + 1) * Q = (b.val + 1) * Q := by exact_mod_cast h
      have h1 : a.val + 1 = b.val + 1 := Nat.mul_right_cancel hQ hnat
      omega
    · rw [if_neg hc, if_neg hc] at h
      have hnat : a.val * Q + c = b.val * Q + c := by exact_mod_cast h
      have h2 : a.val * Q = b.val * Q := by omega
      have h3 : a.val = b.val := Nat.mul_right_cancel hQ h2
      omega
  have himage_sub : (Finset.univ : Finset (Fin (N / Q))).image φ ⊆ S := by
    intro x hx
    rw [Finset.mem_image] at hx
    rcases hx with ⟨k, hk, rfl⟩
    exact hφ_in k
  calc
    N / Q = (Finset.univ : Finset (Fin (N / Q))).card := by simp
    _ = ((Finset.univ : Finset (Fin (N / Q))).image φ).card := by
      rw [Finset.card_image_of_injective]
      exact hinj
    _ ≤ S.card := Finset.card_le_card himage_sub

/-- Membership in the residue class of `z.val` equals `ZMod` equality with `z`. -/
lemma zmod_eq_iff_val_dvd {Q : ℕ} (hQ : 0 < Q) (z : ZMod Q) (n : ℤ) :
    (((Q : ℕ) : ℤ) ∣ n - ((z.val : ℕ) : ℤ)) ↔ (n : ZMod Q) = z := by
  haveI : NeZero Q := ⟨ne_of_gt hQ⟩
  have hcast : ((((z.val : ℕ) : ℤ) : ZMod Q)) = z := by
    exact_mod_cast (ZMod.natCast_zmod_val z)
  constructor
  · intro h
    have hEq0 : (n : ZMod Q) = ((((z.val : ℕ) : ℤ) : ZMod Q)) :=
      (zmod_eq_iff_int_sub_dvd Q n ((z.val : ℕ) : ℤ)).mpr h
    rwa [hcast] at hEq0
  · intro h
    have hEq1 : (n : ZMod Q) = ((((z.val : ℕ) : ℤ) : ZMod Q)) := by
      rwa [← hcast] at h
    exact (zmod_eq_iff_int_sub_dvd Q n ((z.val : ℕ) : ℤ)).mp hEq1

/-- Solving a linear equation with a unit coefficient: if `(u : R) = a` then
`a·x = d ↔ x = u⁻¹·d`. -/
lemma unit_solve {R : Type} [CommRing R] {u : Rˣ} {a x d : R} (hu : (u : R) = a) :
    a * x = d ↔ x = ((u⁻¹ : Rˣ) : R) * d := by
  constructor
  · intro h
    calc
      x = ((u⁻¹ : Rˣ) : R) * ((u : R) * x) := by
        rw [← mul_assoc]
        have h1 : ((u⁻¹ : Rˣ) : R) * (u : R) = 1 := Units.inv_mul u
        rw [h1]
        simp
      _ = ((u⁻¹ : Rˣ) : R) * (a * x) := by rw [hu]
      _ = ((u⁻¹ : Rˣ) : R) * d := by rw [h]
  · intro hx
    rw [hx]
    calc
      a * (((u⁻¹ : Rˣ) : R) * d) = (a * ((u⁻¹ : Rˣ) : R)) * d := by ring
      _ = ((u : R) * ((u⁻¹ : Rˣ) : R)) * d := by rw [hu]
      _ = d := by
        have h1 : (u : R) * ((u⁻¹ : Rˣ) : R) = 1 := Units.mul_inv u
        rw [h1]
        simp

/-- With a unit coefficient `a′`, the affine congruence `a′n+b′ ≡ c′ (mod Q)` pins down
the residue class of `n`; a canonical representative is `(a′⁻¹·(c′-b′)).val`. -/
lemma linearCongruence_class {Q : ℕ} (_hQ : 0 < Q) (a' b' c' : ℤ)
    (ha' : IsUnit (a' : ZMod Q)) :
    ∃ z : ZMod Q, ∀ n : ℤ,
      (((Q : ℕ) : ℤ) ∣ a' * n + b' - c') ↔ (n : ZMod Q) = z := by
  let u : (ZMod Q)ˣ := ha'.unit
  have hu : (u : ZMod Q) = (a' : ZMod Q) := by
    exact IsUnit.unit_spec ha'
  let z : ZMod Q := ((u⁻¹ : (ZMod Q)ˣ) : ZMod Q) * ((c' - b' : ℤ) : ZMod Q)
  refine ⟨z, ?_⟩
  intro n
  have hcb : ((((c' - b' : ℤ) : ZMod Q))) = (c' : ZMod Q) - (b' : ZMod Q) := by
    simp [Int.cast_sub]
  have hstep1 : (((a' * n + b' - c' : ℤ) : ZMod Q)) = 0 ↔
      (a' : ZMod Q) * (n : ZMod Q) = ((c' - b' : ℤ) : ZMod Q) := by
    constructor
    · intro h
      have hz : (a' : ZMod Q) * (n : ZMod Q) + (b' : ZMod Q) - (c' : ZMod Q) = 0 := by
        simpa [Int.cast_add, Int.cast_mul, Int.cast_sub] using h
      rw [hcb]
      linear_combination hz
    · intro h
      have hz : (a' : ZMod Q) * (n : ZMod Q) + (b' : ZMod Q) - (c' : ZMod Q) = 0 := by
        rw [hcb] at h
        linear_combination h
      simpa [Int.cast_add, Int.cast_mul, Int.cast_sub] using hz
  have hstep2 : ((a' : ZMod Q) * (n : ZMod Q) = ((c' - b' : ℤ) : ZMod Q)) ↔
      (n : ZMod Q) = z := by
    calc
      ((a' : ZMod Q) * (n : ZMod Q) = ((c' - b' : ℤ) : ZMod Q)) ↔
        ((n : ZMod Q) = ((u⁻¹ : (ZMod Q)ˣ) : ZMod Q) * ((c' - b' : ℤ) : ZMod Q)) :=
          unit_solve (R := ZMod Q) (u := u) (a := (a' : ZMod Q)) (x := (n : ZMod Q))
            (d := ((c' - b' : ℤ) : ZMod Q)) hu
      _ ↔ (n : ZMod Q) = z := by
        simp [z]
  have hmain : (((Q : ℕ) : ℤ) ∣ a' * n + b' - c') ↔ (n : ZMod Q) = z := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd (a' * n + b' - c') Q]
    rw [hstep1]
    rw [hstep2]
  exact hmain

/-- Counting form: with `a′` a unit modulo `Q`, the number of `n ∈ {1,…,N}` with
`a′n+b′ ≡ c′ (mod Q)` is at least `N/Q`. -/
lemma linearResidue_lower {Q N : ℕ} (hQ : 0 < Q) (a' b' c' : ℤ)
    (ha' : IsUnit (a' : ZMod Q)) :
    N / Q ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ a' * n + b' - c')).card := by
  classical
  rcases linearCongruence_class hQ a' b' c' ha' with ⟨z, hz⟩
  let S : Finset ℤ := (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
    (fun n : ℤ => (((Q : ℕ) : ℤ) ∣ n - ((z.val : ℕ) : ℤ)))
  have hS_eq : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ a' * n + b' - c')) = S := by
    unfold S
    apply Finset.filter_congr
    intro n hn
    rw [hz n]
    exact (zmod_eq_iff_val_dvd hQ z n).symm
  rw [hS_eq]
  exact residueClass_Icc_count_lower Q N hQ ((z.val : ℕ) : ℤ)

/-- Convenience instance of `linearResidue_lower` for moduli that are powers of two:
an odd coefficient `a′` is a unit modulo `2^d` (`d ≥ 1`). -/
lemma oddLinearResidue_lower {d N : ℕ} (hd : 0 < d) (a' b' c' : ℤ) (ha' : Odd a') :
    N / (2 ^ d) ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => (((2 ^ d : ℕ) : ℤ) ∣ a' * n + b' - c'))).card := by
  classical
  have hQ : 0 < 2 ^ d := pow_pos (by norm_num) d
  have hunit : IsUnit (a' : ZMod (2 ^ d)) := by
    apply zmod_isUnit_of_odd
    · exact (Int.natAbs_odd).mpr ha'
    · refine ⟨d - 1, ?_⟩
      rw [show (d - 1) + 1 = d by omega]
  simpa using (linearResidue_lower (Q := 2 ^ d) (N := N) hQ a' b' c' hunit)

/-- The `q/2`-fibre of an affine function of slope `2^o` times an odd integer occupies at
least `N/2^{t-o}` points of the window `{1,…,N}`.  (Finite form of the fibre-counting
half of the paper's Lemma "rare".) -/
theorem affine_qdiv2_attained_lower {t o : ℕ} (ht : 1 ≤ t) (a' b' : ℤ) (ha' : Odd a')
    (ho : o ≤ t - 1) (N : ℕ) :
    N / (2 ^ (t - o)) ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => (((2 : ℤ) ^ o * (a' * n + b') : ℤ) : ZMod (2 ^ t)) =
        (((2 ^ (t - 1) : ℕ)) : ZMod (2 ^ t)))).card := by
  classical
  have hd : 0 < t - o := by omega
  have hcastpow : ((2 ^ (t - o) : ℕ) : ℤ) = (2 : ℤ) ^ (t - o) := by simp
  have hcastv : ((2 ^ (t - 1) : ℕ) : ℤ) = (2 : ℤ) ^ (t - 1) := by simp
  have hcastn : ((((2 ^ (t - 1) : ℕ) : ℤ) : ZMod (2 ^ t))) =
      ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) := by simp
  have hcv2 : ((2 ^ (t - 1 - o) : ℕ) : ℤ) = (2 : ℤ) ^ (t - 1 - o) := by simp
  have hmem : ∀ n : ℤ,
      ((((2 : ℤ) ^ o * (a' * n + b') : ℤ) : ZMod (2 ^ t)) =
        ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))) ↔
        ((2 : ℤ) ^ (t - o) ∣ a' * n + b' - ((2 ^ (t - 1 - o) : ℕ) : ℤ)) := by
    intro n
    have hz := zmod_eq_iff_int_sub_dvd (q := 2 ^ t)
      (m := (2 : ℤ) ^ o * (a' * n + b')) (r := ((2 ^ (t - 1) : ℕ) : ℤ))
    have hf := affine_qdiv2_dvd_fiber (t := t) (o := o) a' b' n ho
    calc
      ((((2 : ℤ) ^ o * (a' * n + b') : ℤ) : ZMod (2 ^ t)) =
        ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))) ↔
        ((((2 : ℤ) ^ o * (a' * n + b') : ℤ) : ZMod (2 ^ t)) =
          (((2 ^ (t - 1) : ℕ) : ℤ) : ZMod (2 ^ t))) := by
            rw [hcastn]
      _ ↔ ((2 ^ t : ℕ) : ℤ) ∣ (2 : ℤ) ^ o * (a' * n + b') - ((2 ^ (t - 1) : ℕ) : ℤ) := by
            exact hz
      _ ↔ (2 : ℤ) ^ (t - o) ∣ a' * n + b' - ((2 ^ (t - 1 - o) : ℕ) : ℤ) := by
            simpa [hcastv, hcv2] using hf
  let S : Finset ℤ := (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
    (fun n : ℤ => (((2 ^ (t - o) : ℕ) : ℤ) ∣ a' * n + b' - ((2 ^ (t - 1 - o) : ℕ) : ℤ)))
  have hS_eq : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => (((2 : ℤ) ^ o * (a' * n + b') : ℤ) : ZMod (2 ^ t)) =
        ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)))) = S := by
    unfold S
    apply Finset.filter_congr
    intro n hn
    rw [hmem n]
    rw [← hcastpow]
  rw [hS_eq]
  have hcnt := oddLinearResidue_lower (d := t - o) (N := N) hd a' b'
    ((2 ^ (t - 1 - o) : ℕ) : ℤ) ha'
  simpa [S] using hcnt


/-! ## Board-level lower bound: order-`o` lines attain `q/2` often

A Sudoku line `F_{i,j}(n) = F(n, jn+i)` of the board that agrees, away from the zero
set of an affine function of slope `2^o` times an odd integer, with that affine function,
attains the value `q/2 = 2^{t-1}` in at least `N/2^{t-o}` of its `N` cells. -/

/-- The line statistic: how many of the `N` cells of the line of slope `j` and intercept
`i` (rows `1..N`) carry the digit `γ`. -/
noncomputable def lineDigitCount {q N : ℕ} (F : SudokuBoard q N) (i j : ℤ) (γ : ZMod q) : ℕ :=
  ((Finset.univ : Finset (Fin N)).filter
    (fun n : Fin N => F n (j * ((n.val : ℕ) + 1 : ℤ) + i) = γ)).card

/-- A line (of slope `j`, intercept `i`) has an *order-`o` affine agreement*: there is an
odd `a′` and integer `b′` such that the line value equals the affine value
`2^o·(a′n+b′) mod 2^t` wherever that affine value is non-zero.  (For a genuinely
order-`o` `Scal` element this is exactly the agreement promised by the paper's Statistics
Lemma (iii); counting the larger set is harmless.) -/
def lineAgreesAffineOrder {t N : ℕ} (F : SudokuBoard (2 ^ t) N) (o : ℕ) (i j : ℤ) : Prop :=
  ∃ a' b' : ℤ, Odd a' ∧ ∀ n : Fin N,
    ((((2 : ℤ) ^ o * (a' * ((n.val : ℕ) + 1 : ℤ) + b') : ℤ) : ZMod (2 ^ t)) ≠ 0) →
      F n (j * ((n.val : ℕ) + 1 : ℤ) + i) =
        (((2 : ℤ) ^ o * (a' * ((n.val : ℕ) + 1 : ℤ) + b') : ℤ) : ZMod (2 ^ t))

/-- Cardinalities of filters over `Fin N` (via `finToInt`) and over the integer window
`{1,…,N}` agree for any predicate. -/
lemma finWindow_filter_card {N : ℕ} (P : ℤ → Prop) [DecidablePred P] :
    ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P (finToInt n))).card =
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter (fun m : ℤ => P m)).card := by
  classical
  apply Finset.card_bij (fun (n : Fin N) (_ : n ∈ (Finset.univ : Finset (Fin N)).filter
      (fun n : Fin N => P (finToInt n))) => finToInt n)
  · intro n hn
    rw [Finset.mem_filter] at hn ⊢
    constructor
    · exact finToInt_mem_window n
    · exact hn.2
  · intro n1 hn1 n2 hn2 h
    apply Fin.ext
    have hz' : ((n1.val : ℤ) + 1) = ((n2.val : ℤ) + 1) := by simpa [finToInt] using h
    have hz : (n1.val : ℤ) = (n2.val : ℤ) := by omega
    exact_mod_cast hz
  · intro m hm
    rw [Finset.mem_filter] at hm
    refine ⟨intToFin ⟨m, hm.1⟩, ?_, ?_⟩
    · rw [Finset.mem_filter]
      constructor
      · simp
      · have hm' : P m := hm.2
        rwa [finToInt_intToFin ⟨m, hm.1⟩]
    · exact finToInt_intToFin ⟨m, hm.1⟩

/-- `q/2 = 2^{t-1}` is a genuine digit (`≠ 0` in `ZMod 2^t`) whenever `t ≥ 1`. -/
lemma zmod_two_pow_half_ne_zero {t : ℕ} (ht : 1 ≤ t) :
    ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) ≠ 0 := by
  intro hz
  have hzInt : ((((2 ^ (t - 1) : ℕ) : ℤ) : ZMod (2 ^ t))) = 0 := by
    simpa using hz
  have hdvdZ : ((2 ^ t : ℕ) : ℤ) ∣ ((2 ^ (t - 1) : ℕ) : ℤ) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd ((2 ^ (t - 1) : ℕ) : ℤ) (2 ^ t)).mp hzInt
  have hdvd : (2 ^ t : ℕ) ∣ (2 ^ (t - 1) : ℕ) := (Int.natCast_dvd_natCast).mp hdvdZ
  have ht1 : t - 1 < t := by omega
  have hlt : 2 ^ (t - 1) < 2 ^ t := pow_lt_pow_right₀ (by norm_num) ht1
  have hpos : 0 < 2 ^ (t - 1) := pow_pos (by norm_num : 0 < (2 : ℕ)) (t - 1)
  have hle : 2 ^ t ≤ 2 ^ (t - 1) := Nat.le_of_dvd hpos hdvd
  exact (Nat.not_lt_of_ge hle) hlt

/-- A line with an order-`o` affine agreement attains the digit `q/2 = 2^{t-1}` in at
least `N/2^{t-o}` of its `N` cells.  (Lower bound half of Lemma "rare".) -/
theorem lineOrder_qdiv2_attained_lower {t N o : ℕ} (ht : 1 ≤ t) (ho : o ≤ t - 1)
    (F : SudokuBoard (2 ^ t) N) {i j : ℤ}
    (hline : lineAgreesAffineOrder F o i j) :
    N / (2 ^ (t - o)) ≤ lineDigitCount (q := 2 ^ t) F i j ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) := by
  classical
  rcases hline with ⟨a', b', ha', hagree⟩
  let γ : ZMod (2 ^ t) := ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))
  have hγ0 : γ ≠ 0 := zmod_two_pow_half_ne_zero ht
  let α : ℤ → ZMod (2 ^ t) := fun m => (((2 : ℤ) ^ o * (a' * m + b') : ℤ) : ZMod (2 ^ t))
  have hsub : ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => α (finToInt n) = γ)) ⊆
      (Finset.univ : Finset (Fin N)).filter
        (fun n : Fin N => F n (j * ((n.val : ℕ) + 1 : ℤ) + i) = γ) := by
    intro n hn
    rw [Finset.mem_filter] at hn ⊢
    constructor
    · simp
    · have hα : α (finToInt n) = γ := hn.2
      have hα0 : α (finToInt n) ≠ 0 := by
        intro hz
        exact hγ0 (hα.symm.trans hz)
      have hag := hagree n
      have hz : (((2 : ℤ) ^ o * (a' * ((n.val : ℕ) + 1 : ℤ) + b') : ℤ) : ZMod (2 ^ t)) ≠ 0 := by
        intro hzz
        exact hα0 (by simpa [α, finToInt] using hzz)
      have hcell := hag hz
      rw [hcell]
      simpa [α, finToInt, γ] using hα
  have hcount1 : ((Finset.univ : Finset (Fin N)).filter
      (fun n : Fin N => α (finToInt n) = γ)).card ≤ lineDigitCount (q := 2 ^ t) F i j γ := by
    dsimp [lineDigitCount]
    exact Finset.card_le_card hsub
  have hfib := affine_qdiv2_attained_lower (t := t) (o := o) ht a' b' ha' ho N
  have hfin : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter (fun m : ℤ => α m = γ)).card ≤
      ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => α (finToInt n) = γ)).card := by
    have heq := finWindow_filter_card (N := N) (P := fun m : ℤ => α m = γ)
    rw [heq]
  calc
    N / (2 ^ (t - o)) ≤ ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter (fun m : ℤ => α m = γ)).card := by
      simpa [γ, α] using hfib
    _ ≤ ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => α (finToInt n) = γ)).card := hfin
    _ ≤ lineDigitCount (q := 2 ^ t) F i j γ := hcount1


/-! ## The double count ("Lemma rare" finite form)

Summing the per-line lower bound over the intercepts of high order and comparing with
the board-level digit count (from good columns) bounds the number of high-order
intercepts in a window of slopes. -/

/-- Reordering: the total number of cells `(n, jn+i)` (`n` a row, `i ∈ [-K,K]`) carrying
the digit `γ` equals the sum over intercepts `i` of the per-line counts. -/
lemma interceptDigitCount_eq_line_sum {q N : ℕ} (F : SudokuBoard q N) (j : ℤ) (γ : ZMod q)
    (K : ℕ) :
    interceptDigitCount (q := q) (N := N) F j γ K =
      (∑ i ∈ (Finset.Icc (-(K : ℤ)) (K : ℤ)),
        lineDigitCount (q := q) (N := N) F i j γ) := by
  classical
  let P : Fin N → ℤ → Prop := fun n i => F n (j * ((n.val : ℕ) + 1 : ℤ) + i) = γ
  have hgen : ∀ w : Finset ℤ,
      (∑ n : Fin N, (w.filter (fun i : ℤ => P n i)).card) =
        (∑ i ∈ w, ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i)).card) := by
    intro w
    refine Finset.induction_on w ?base ?step
    · simp
    · intro i₀ w' hw' ih
      have hstep (n : Fin N) :
          ((insert i₀ w').filter (fun i : ℤ => P n i)).card =
            ((w'.filter (fun i : ℤ => P n i)).card +
              (if P n i₀ then 1 else 0)) := by
        rw [Finset.filter_insert]
        by_cases hp : P n i₀
        · rw [if_pos hp, if_pos hp]
          have hni : i₀ ∉ w'.filter (fun i : ℤ => P n i) := by
            intro hmem
            rw [Finset.mem_filter] at hmem
            exact hw' hmem.1
          rw [Finset.card_insert_of_notMem hni]
        · rw [if_neg hp, if_neg hp]
          simp
      have hL : (∑ n : Fin N, ((insert i₀ w').filter (fun i : ℤ => P n i)).card) =
          (∑ i ∈ w', ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i)).card) +
            ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i₀)).card := by
        calc
          (∑ n : Fin N, ((insert i₀ w').filter (fun i : ℤ => P n i)).card)
              = ∑ n : Fin N, ((w'.filter (fun i : ℤ => P n i)).card +
                  (if P n i₀ then 1 else 0)) := by
                  apply Finset.sum_congr rfl
                  intro n hn
                  exact hstep n
          _ = (∑ n : Fin N, (w'.filter (fun i : ℤ => P n i)).card) +
              (∑ n : Fin N, if P n i₀ then 1 else 0) := by
                  rw [Finset.sum_add_distrib]
          _ = (∑ i ∈ w', ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i)).card) +
              ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i₀)).card := by
                  rw [ih]
                  congr 1
                  rw [← Finset.card_filter (fun n : Fin N => P n i₀) (Finset.univ)]
      have hR : (∑ i ∈ (insert i₀ w'), ((Finset.univ : Finset (Fin N)).filter
          (fun n : Fin N => P n i)).card) =
          ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i₀)).card +
            (∑ i ∈ w', ((Finset.univ : Finset (Fin N)).filter (fun n : Fin N => P n i)).card) := by
          rw [Finset.sum_insert hw']
      rw [hR]
      rw [add_comm]
      exact hL
  specialize hgen (Finset.Icc (-(K : ℤ)) (K : ℤ))
  change (∑ n : Fin N, ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
      (fun i : ℤ => F n (j * ((n.val : ℕ) + 1 : ℤ) + i) = γ)).card) = _
  simpa [interceptDigitCount, lineDigitCount, P] using hgen

/-- Finite form of the paper's Lemma "rare": lines with an order-`o` affine agreement
(rescaled copies of `f_q` of high order) are rare, because each such line attains the
digit `q/2` at least `N/2^{t-o}` times while every digit appears in at most
`2/q`-density along columns (the `HasGoodColumns` digit bound). -/
theorem highOrderLines_doublecount {t N K o : ℕ} (ht : 1 ≤ t) (ho : o ≤ t - 1)
    (F : SudokuBoard (2 ^ t) N) (j : ℤ) :
    ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card *
          (N / (2 ^ (t - o))) ≤
      interceptDigitCount (q := 2 ^ t) (N := N) F j ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) K := by
  classical
  let γ : ZMod (2 ^ t) := ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))
  let S : Finset ℤ := (Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
    (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)
  have hlow : ∀ i : ℤ, i ∈ S →
      N / (2 ^ (t - o)) ≤ lineDigitCount (q := 2 ^ t) (N := N) F i j γ := by
    intro i hi
    rw [Finset.mem_filter] at hi
    exact lineOrder_qdiv2_attained_lower (t := t) (N := N) (o := o) ht ho F hi.2
  have hsum_le : (∑ i ∈ S, (N / (2 ^ (t - o)))) ≤ (∑ i ∈ S, lineDigitCount (q := 2 ^ t) (N := N) F i j γ) := by
    apply Finset.sum_le_sum
    intro i hi
    exact hlow i hi
  have hcard : S.card * (N / (2 ^ (t - o))) = (∑ i ∈ S, (N / (2 ^ (t - o)))) := by
    rw [Finset.sum_const]
    simp
  have hsubset : S ⊆ Finset.Icc (-(K : ℤ)) (K : ℤ) := by
    intro i hi
    rw [Finset.mem_filter] at hi
    exact hi.1
  have hsum2 : (∑ i ∈ S, lineDigitCount (q := 2 ^ t) (N := N) F i j γ) ≤
      (∑ i ∈ (Finset.Icc (-(K : ℤ)) (K : ℤ)), lineDigitCount (q := 2 ^ t) (N := N) F i j γ) := by
    exact Finset.sum_le_sum_of_subset_of_nonneg hsubset (by intro i hi hmem; omega)
  have hswap := interceptDigitCount_eq_line_sum (q := 2 ^ t) (N := N) F j γ K
  calc
    S.card * (N / (2 ^ (t - o))) = (∑ i ∈ S, (N / (2 ^ (t - o)))) := hcard
    _ ≤ (∑ i ∈ S, lineDigitCount (q := 2 ^ t) (N := N) F i j γ) := hsum_le
    _ ≤ (∑ i ∈ (Finset.Icc (-(K : ℤ)) (K : ℤ)), lineDigitCount (q := 2 ^ t) (N := N) F i j γ) := hsum2
    _ = interceptDigitCount (q := 2 ^ t) (N := N) F j γ K := hswap.symm



/-- Combined form of the double count over a good-columns board: the number of
order-`o` (affine-agreement) lines of slope `j` with intercept in `[-K,K]`, weighted by
`N/2^{t-o}`, is bounded by the board-level digit bound `N·(2·((2K)/q + 1))`.  (This is
the finite double-counting content of the paper's Lemma "rare" when the board has good
columns, Lemma "digitdensity": high-order lines are rare because each attains `q/2`
often while `q/2` appears at most `2/q`-densely.) -/
theorem highOrderLines_goodColumns_bound {t N K o : ℕ} (ht : 1 ≤ t) (ho : o ≤ t - 1)
    (F : SudokuBoard (2 ^ t) N) (hgood : HasGoodColumns (2 ^ t) N F) (j : ℤ) :
    ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card *
          (N / (2 ^ (t - o))) ≤
      N * (2 * ((2 * K) / (2 ^ t) + 1)) := by
  classical
  let γ : ZMod (2 ^ t) := ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))
  have hq : 0 < 2 ^ t := pow_pos (by norm_num) t
  have hL := highOrderLines_doublecount (t := t) (N := N) (K := K) (o := o) ht ho F j
  have hU := goodColumns_interceptWindow_le (q := 2 ^ t) (N := N) hq (F := F) hgood j γ K
  exact le_trans hL hU

/-! Lemma 8.1 (Statistics of a 2-adic function), items (i)-(iii) from a representative.
Developed in a scratch before splicing into sudoku_rigidity.lean. -/

/-- Multiplication by an odd integer is cancellative in `ZMod (2^t)` (`t ≥ 1`):
`a·d = 0` with `d` odd forces `a = 0`. -/
lemma zmod_two_pow_mul_eq_zero_of_odd {t : ℕ} (ht : 1 ≤ t) {d : ℤ} (hd : Odd d)
    {a : ZMod (2 ^ t)} (ha : a * (d : ZMod (2 ^ t)) = 0) : a = 0 := by
  have hpow : ∃ s : ℕ, 2 ^ t = 2 ^ (s + 1) := by
    refine ⟨t - 1, ?_⟩
    congr 1
    omega
  have hu : IsUnit (d : ZMod (2 ^ t)) := zmod_isUnit_of_odd (Int.natAbs_odd.mpr hd) hpow
  rcases hu with ⟨u, hu⟩
  have huinv : (u : ZMod (2 ^ t)) * ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) = 1 := by
    simpa using congrArg (fun x : (ZMod (2 ^ t))ˣ => (x : ZMod (2 ^ t))) (Units.mul_inv u)
  calc
    a = a * ((u : ZMod (2 ^ t)) * ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t))) := by
      rw [huinv]
      simp
    _ = (a * (u : ZMod (2 ^ t))) * ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) := by ring
    _ = (a * (d : ZMod (2 ^ t))) * ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) := by
      rw [hu]
    _ = 0 := by rw [ha]; simp

/-- The scaled affine function `(ca)·n + (cb)` equals `c·(a·n+b)` in `ZMod (2^t)`. -/
lemma qAffine_scaled_eval {t : ℕ} (a b c r : ℤ) :
    qAffine (2 ^ t) (c * a) (c * b) r =
      (c : ZMod (2 ^ t)) * ((a * r + b : ℤ) : ZMod (2 ^ t)) := by
  simp [qAffine, Int.cast_add, Int.cast_mul]
  ring

/-- The unscaled affine function `a·n+b` is the reduction of `a·n+b`. -/
lemma qAffine_eval {q : ℕ} (a b r : ℤ) :
    qAffine q a b r = ((a * r + b : ℤ) : ZMod q) := by
  unfold qAffine
  rw [← intCast_zmod_of_add_mul q a b r]

/-- (8.1 iii, c-scaled) If `g(n) = c·f_q(a·rowVal n + b)` with `c` odd, then `g`
agrees with the scaled affine function `(ca)·n + (cb)` on the window wherever that
affine function does not vanish. -/
lemma scal_agreement {t : ℕ} (ht : 1 ≤ t) {N : ℕ} {g : Fin N → ZMod (2 ^ t)}
    {a b c : ℤ} (hc : Odd c) (hg : ∀ n : Fin N,
      g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * rowVal n + b)) :
    ∀ n : Fin N, qAffine (2 ^ t) (c * a) (c * b) (rowVal n) ≠ 0 →
      g n = qAffine (2 ^ t) (c * a) (c * b) (rowVal n) := by
  intro n hα
  have hcast : qAffine (2 ^ t) (c * a) (c * b) (rowVal n) =
      (c : ZMod (2 ^ t)) * ((a * rowVal n + b : ℤ) : ZMod (2 ^ t)) :=
    qAffine_scaled_eval a b c (rowVal n)
  have hy : ((a * rowVal n + b : ℤ) : ZMod (2 ^ t)) ≠ 0 := by
    intro hz
    exact hα (by rw [hcast, hz, mul_zero])
  have hndiv : ¬ ((2 ^ t : ℕ) : ℤ) ∣ (a * rowVal n + b) := by
    intro hd
    exact hy ((ZMod.intCast_zmod_eq_zero_iff_dvd (a * rowVal n + b) (2 ^ t)).mpr hd)
  have hq1 : 1 < 2 ^ t := by
    have h2 : 2 ≤ 2 ^ t := by
      have hle := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) ht
      simpa using hle
    omega
  have hf : fq (2 ^ t) (a * rowVal n + b) = ((a * rowVal n + b : ℤ) : ZMod (2 ^ t)) :=
    fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 hndiv
  calc
    g n = (c : ZMod (2 ^ t)) * fq (2 ^ t) (a * rowVal n + b) := hg n
    _ = (c : ZMod (2 ^ t)) * ((a * rowVal n + b : ℤ) : ZMod (2 ^ t)) := by rw [hf]
    _ = qAffine (2 ^ t) (c * a) (c * b) (rowVal n) := hcast.symm

/-- (8.1 ii, c-scaled) The zero set of the scaled affine function `(ca)·n+(cb)` is the
same as the zero set of `a·n+b` (since `c` is a unit modulo `2^t`). -/
lemma badCoset_mul_odd_coeff {t : ℕ} (ht : 1 ≤ t) (a b c : ℤ) (hc : Odd c) :
    badCoset (2 ^ t) (c * a) (c * b) = badCoset (2 ^ t) a b := by
  ext r
  constructor
  · intro hz
    simp [badCoset] at hz
    have hz' : (c : ZMod (2 ^ t)) * ((a * r + b : ℤ) : ZMod (2 ^ t)) = 0 := by
      rwa [qAffine_scaled_eval a b c r] at hz
    have hy0 : ((a * r + b : ℤ) : ZMod (2 ^ t)) = 0 :=
      zmod_two_pow_mul_eq_zero_of_odd ht hc (a := ((a * r + b : ℤ) : ZMod (2 ^ t)))
        (by simpa [mul_comm] using hz')
    simp [badCoset]
    rw [qAffine_eval (q := 2 ^ t) a b r]
    exact hy0
  · intro hz
    simp [badCoset] at hz
    rw [qAffine_eval (q := 2 ^ t) a b r] at hz
    simp [badCoset]
    rw [qAffine_scaled_eval a b c r]
    simp [hz]


theorem scal_affine_agreement {t : ℕ} (ht : 1 ≤ t) {N : ℕ} {g : Fin N → ZMod (2 ^ t)}
    (hg : InScal_q (2 ^ t) N g) :
    ∃ A B : ℤ, ∀ n : Fin N,
      qAffine (2 ^ t) A B (rowVal n) ≠ 0 → g n = qAffine (2 ^ t) A B (rowVal n) := by
  rcases hg with ⟨a, b, c, hc, hg⟩
  refine ⟨c * a, c * b, ?_⟩
  exact scal_agreement ht hc hg

/-! Lemma 8.1 (ii), finite form: the zero set of the affine function `a·n+b` modulo
`2^t` (the *bad coset* `badCoset (2^t) a b`) has spacing `2^{t-o}` (`o := twoAdicOrder a`
the number of factors of two in `a`), i.e. occupies at most `(2K)/2^{t-o} + 1` points of
the window `[-K,K]`.  (If the coset is empty the bound is vacuous; when `a` is divisible
by `2^t` the exponent `t-o` underflows to `0` and the bound is the whole window.) -/

theorem scal_badCoset_spacing {t K : ℕ} (a b : ℤ) (ha : a ≠ 0) :
    ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
      (fun n : ℤ => n ∈ badCoset (2 ^ t) a b)).card
        ≤ (2 * K) / (2 ^ (t - twoAdicOrder a)) + 1 := by
  classical
  have hwin : (Finset.Icc (-(K : ℤ)) (K : ℤ)).card = 2 * K + 1 := by
    have heq : (Finset.Icc (-(K : ℤ)) (K : ℤ)) =
        (Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
          (fun n : ℤ => ((1 : ℕ) : ℤ) ∣ n - 0) := by
      ext n
      simp
    rw [heq]
    exact intervalCount_one (0 : ℤ) K
  have hsub : (Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
      (fun n : ℤ => n ∈ badCoset (2 ^ t) a b) ⊆ Finset.Icc (-(K : ℤ)) (K : ℤ) := by
    intro n hn
    exact (Finset.mem_filter.mp hn).1
  have hcnt_le : ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
      (fun n : ℤ => n ∈ badCoset (2 ^ t) a b)).card ≤ 2 * K + 1 :=
    le_trans (Finset.card_le_card hsub) (by rw [hwin])
  rcases int_two_power_factorization a ha with ⟨a', hfac, hodd'⟩
  by_cases hto : t ≤ twoAdicOrder a
  · have htmin : t - twoAdicOrder a = 0 := by omega
    simpa [htmin] using hcnt_le
  · have htgt : twoAdicOrder a < t := lt_of_not_ge hto
    let Q : ℕ := 2 ^ (t - twoAdicOrder a)
    have hQpos : 0 < Q := pow_pos (by norm_num) (t - twoAdicOrder a)
    have hmod : ((2 ^ twoAdicOrder a : ℕ) * Q : ℕ) = 2 ^ t := by
      dsimp [Q]
      rw [← pow_add]
      congr 1
      omega
    have hQ2 : ∃ s : ℕ, Q = 2 ^ (s + 1) := by
      refine ⟨t - twoAdicOrder a - 1, ?_⟩
      dsimp [Q]
      congr 1
      omega
    have hunit : IsUnit (a' : ZMod Q) := zmod_isUnit_of_odd hodd' hQ2
    have hdich := badCoset_empty_or_coset_power_two (e := twoAdicOrder a) (q' := Q)
      (a := a) (b := b) (a' := a') hfac hunit
    rcases hdich with hE | ⟨n₀, hcos⟩
    · have hE' : badCoset (2 ^ t) a b = ∅ := by
        rwa [← hmod]
      have hc0 : ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
          (fun n : ℤ => n ∈ badCoset (2 ^ t) a b)).card = 0 := by
        rw [hE']
        simp
      rw [hc0]
      exact Nat.zero_le _
    · have hcos' : badCoset (2 ^ t) a b = {n : ℤ | ((Q : ℕ) : ℤ) ∣ n - n₀} := by
        rw [← hmod]
        exact hcos
      simp [hcos']
      have hdef : intervalCount Q n₀ K =
          ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
            (fun n : ℤ => ((Q : ℕ) : ℤ) ∣ n - n₀)).card := by
        rfl
      rw [← hdef]
      simpa [Q] using coset_count_upper_bound Q hQpos n₀ K



/-! Parity layer for `f_q` values (`q = 2^t`), needed by the case analysis of the
paper's Proposition "rigid-out" (Prop 8.2): an element of `ZMod (2^t)` is *odd* when
it has an odd integer representative.  Odd arguments give odd `f_q`-values, an odd
scalar times an odd value is odd, and `0` is even. -/

/-- Oddness of an element of `ZMod (2^t)`: some odd integer represents it. -/
def ZOdd {t : ℕ} (z : ZMod (2 ^ t)) : Prop := ∃ r : ℤ, Odd r ∧ (r : ZMod (2 ^ t)) = z

lemma zodd_of_intCast {t : ℕ} (x : ℤ) (hx : Odd x) : ZOdd (x : ZMod (2 ^ t)) :=
  ⟨x, hx, rfl⟩

lemma zodd_neg {t : ℕ} {z : ZMod (2 ^ t)} (hz : ZOdd z) : ZOdd (-z) := by
  rcases hz with ⟨r, hr, hzr⟩
  refine ⟨-r, ?_, ?_⟩
  · rcases hr with ⟨k, hk⟩
    refine ⟨-k - 1, ?_⟩
    rw [hk]
    ring
  · rw [← hzr]
    simp

lemma zodd_mul_intCast {t : ℕ} {c : ℤ} (hc : Odd c) {z : ZMod (2 ^ t)} (hz : ZOdd z) :
    ZOdd ((c : ZMod (2 ^ t)) * z) := by
  rcases hz with ⟨r, hr, hzr⟩
  refine ⟨c * r, hc.mul hr, ?_⟩
  rw [← hzr]
  simp [Int.cast_mul]

/-- `2` divides `2^t` as integers, for `t ≥ 1`. -/
lemma not_zodd_zero {t : ℕ} (ht : 1 ≤ t) : ¬ ZOdd (0 : ZMod (2 ^ t)) := by
  intro hz
  rcases hz with ⟨r, hr, hzr⟩
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ r := by
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd r (2 ^ t)).mp (by simpa [← hzr])
  have h2 : (2 : ℤ) ∣ r := dvd_trans (two_dvd_two_pow_int (t := t) ht) hdvd
  rcases h2 with ⟨m, hm⟩
  rcases hr with ⟨k, hk⟩
  omega
/-! `q/2 = 2^{t-1}` is *even* in `ZMod (2^t)` for `t ≥ 2`, i.e. not `ZOdd`.  Used in the
rigid-out bad-case parity contradictions (α takes the even value `q/2` on a coset,
while a `Scal` value there must be odd). -/

lemma not_zodd_qHalf {t : ℕ} (ht : 2 ≤ t) :
    ¬ ZOdd ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) := by
  intro hz
  rcases hz with ⟨r, hr, hzr⟩
  have hzr' : (((2 ^ (t - 1) : ℕ) : ℤ) : ZMod (2 ^ t)) = (r : ZMod (2 ^ t)) := by
    simpa using hzr.symm
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ (((2 ^ (t - 1) : ℕ) : ℤ) - r) := by
    exact (zmod_eq_iff_int_sub_dvd (2 ^ t) (((2 ^ (t - 1) : ℕ) : ℤ)) r).mp hzr'
  rcases hdvd with ⟨k, hk⟩
  have h2a : (2 : ℤ) ∣ (((2 ^ (t - 1) : ℕ) : ℤ)) := by
    exact two_dvd_two_pow_int (t := t - 1) (by omega)
  have h2b : (2 : ℤ) ∣ (((2 ^ t : ℕ) : ℤ) * k) := by
    have h2t : (2 : ℤ) ∣ (((2 ^ t : ℕ) : ℤ)) := two_dvd_two_pow_int (t := t) (by omega)
    exact dvd_trans h2t (dvd_mul_right (((2 ^ t : ℕ) : ℤ)) k)
  have h2 : (2 : ℤ) ∣ r := by
    have hreq : r = (((2 ^ (t - 1) : ℕ) : ℤ)) - (((2 ^ t : ℕ) : ℤ)) * k := by omega
    rw [hreq]
    exact dvd_sub h2a h2b
  rcases h2 with ⟨w, hw⟩
  rcases hr with ⟨k', hk'⟩
  omega
lemma fq_zodd_of_odd_arg {t : ℕ} (ht : 1 ≤ t) (x : ℤ) (hx : Odd x) :
    ZOdd (fq (2 ^ t) x) := by
  have hq1 : 1 < 2 ^ t := by
    have h2 : 2 ≤ 2 ^ t := by
      have hle := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) ht
      simpa using hle
    omega
  have hndiv : ¬ ((2 ^ t : ℕ) : ℤ) ∣ x := by
    intro hd
    have h2 : (2 : ℤ) ∣ x := dvd_trans (two_dvd_two_pow_int (t := t) ht) hd
    rcases h2 with ⟨m, hm⟩
    rcases hx with ⟨k, hk⟩
    omega
  have hf : fq (2 ^ t) x = ((x : ℤ) : ZMod (2 ^ t)) :=
    fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 hndiv
  rw [hf]
  exact zodd_of_intCast x hx

/-- Two `f_q`-values at arguments of opposite parity are not both even: at least one is
odd (used repeatedly in the rigid-out case analysis). -/
lemma fq_not_both_even_of_opposite_parity {t : ℕ} (ht : 1 ≤ t) (m u : ℤ) (hu : Odd u) :
    ZOdd (fq (2 ^ t) m) ∨ ZOdd (fq (2 ^ t) (m + u)) := by
  by_cases hm : Odd m
  · left
    exact fq_zodd_of_odd_arg ht m hm
  · right
    have hm' : ¬ Odd m := hm
    have hu' : Odd (m + u) := by
      rcases hu with ⟨k, hk⟩
      rcases (Int.not_odd_iff_even.mp hm') with ⟨w, hw⟩
      refine ⟨k + w, ?_⟩
      rw [hk, hw]
      ring
    exact fq_zodd_of_odd_arg ht (m + u) hu'

/-! Prop 8.2 ("rigid-out") core: two affine functions over `ZMod (2^t)` which agree at
two points of odd separation are equal (an odd multiplier is invertible). -/

/-! Value structure of a `Scal` element on its bad rows (the affine argument is
divisible by `q = 2^t`).  At a bad row the value is `c₀·f_q(m)` with `m` the quotient;
shifting to the next bad row adds an odd amount `a′` to `m`, so the two values are not
both even.  This is the local parity obstruction behind the rigid-out bad-case
analysis. -/

/-- A `Scal` value whose affine argument is `q·m` reduces to `c₀·f_q(m)`. -/
lemma scal_value_at_bad_row {t : ℕ} (ht : 1 ≤ t) {c₀ a b m n : ℤ}
    (hnm : a * n + b = (2 ^ t : ℤ) * m) :
    (c₀ : ZMod (2 ^ t)) * fq (2 ^ t) (a * n + b) =
      (c₀ : ZMod (2 ^ t)) * fq (2 ^ t) m := by
  have hf : fq (2 ^ t) (a * n + b) = fq (2 ^ t) m := by
    rw [hnm]
    exact fq_qmul_int (q := 2 ^ t) (by norm_num : (2 ^ t : ℕ) ≠ 0) m
  rw [hf]

/-- Moving from a bad row to the next (shift `d` with `a·d = q·a′`) adds `a′` to the
quotient `m` of the affine argument by `q`. -/
lemma odd_shift_values_not_both_even {t : ℕ} (ht : 1 ≤ t) {c₀ m a' : ℤ}
    (hc : Odd c₀) (ha' : Odd a') :
    ZOdd ((c₀ : ZMod (2 ^ t)) * fq (2 ^ t) m) ∨
    ZOdd ((c₀ : ZMod (2 ^ t)) * fq (2 ^ t) (m + a')) := by
  rcases fq_not_both_even_of_opposite_parity ht m a' ha' with hl | hr
  · left
    exact zodd_mul_intCast hc hl
  · right
    exact zodd_mul_intCast hc hr

/-! If `n` is a bad row (`q | a·n + b`, quotient `m`) and `a = 2^o·a′` (`a′` odd,
`o ≤ t`), then the row `n + 2^{t-o}` — the next bad row at the bad-coset spacing — has
affine argument `q·(m + a′)`: an odd quotient shift.  Together with
`odd_shift_values_not_both_even` this gives the parity obstruction for consecutive bad
rows used by the rigid-out bad case. -/
lemma qAffine_eq_of_agree_two_points {t : ℕ} (ht : 1 ≤ t) {a1 b1 a2 b2 x y : ℤ}
    (hx : qAffine (2 ^ t) a1 b1 x = qAffine (2 ^ t) a2 b2 x)
    (hy : qAffine (2 ^ t) a1 b1 y = qAffine (2 ^ t) a2 b2 y) (hodd : Odd (y - x)) :
    qAffine (2 ^ t) a1 b1 = qAffine (2 ^ t) a2 b2 := by
  funext n
  have hx' : qAffine (2 ^ t) (a1 - a2) (b1 - b2) x = 0 := by
    calc
      qAffine (2 ^ t) (a1 - a2) (b1 - b2) x
          = qAffine (2 ^ t) a1 b1 x - qAffine (2 ^ t) a2 b2 x := by
              simp [qAffine, Int.cast_sub]
              ring
      _ = 0 := by rw [hx]; ring
  have hy' : qAffine (2 ^ t) (a1 - a2) (b1 - b2) y = 0 := by
    calc
      qAffine (2 ^ t) (a1 - a2) (b1 - b2) y
          = qAffine (2 ^ t) a1 b1 y - qAffine (2 ^ t) a2 b2 y := by
              simp [qAffine, Int.cast_sub]
              ring
      _ = 0 := by rw [hy]; ring
  -- da := (a1-a2 : ZMod), db := (b1-b2 : ZMod);  da·x+db=0, da·y+db=0
  let da : ZMod (2 ^ t) := ((a1 - a2 : ℤ) : ZMod (2 ^ t))
  let db : ZMod (2 ^ t) := ((b1 - b2 : ℤ) : ZMod (2 ^ t))
  have hdx : da * (x : ZMod (2 ^ t)) + db = 0 := by
    dsimp [da, db]
    -- qAffine (2^t) (a1-a2) (b1-b2) x = da*x + db : by unfold qAffine? qAffine(2^t)(a1-a2)(b1-b2) x = ((a1-a2):ZMod)*(x:ZMod)+(b1-b2:ZMod)
    simpa [qAffine] using hx'
  have hdy : da * (y : ZMod (2 ^ t)) + db = 0 := by
    dsimp [da, db]
    simpa [qAffine] using hy'
  have hdd : da * ((y - x : ℤ) : ZMod (2 ^ t)) = 0 := by
    calc
      da * ((y - x : ℤ) : ZMod (2 ^ t)) = da * ((y : ZMod (2 ^ t)) - (x : ZMod (2 ^ t))) := by
        simp [Int.cast_sub]
      _ = (da * (y : ZMod (2 ^ t)) + db) - (da * (x : ZMod (2 ^ t)) + db) := by ring
      _ = 0 := by rw [hdy, hdx]; ring
  have hda0 : da = 0 := zmod_two_pow_mul_eq_zero_of_odd ht hodd hdd
  have hdb0 : db = 0 := by
    calc
      db = da * (x : ZMod (2 ^ t)) + db := by rw [hda0]; simp
      _ = 0 := hdx
  -- conclusion
  have ha12 : (a1 : ZMod (2 ^ t)) = (a2 : ZMod (2 ^ t)) := by
    have hsub : ((a1 : ZMod (2 ^ t)) - (a2 : ZMod (2 ^ t))) = 0 := by
      dsimp [da] at hda0
      simpa [Int.cast_sub] using hda0
    exact sub_eq_zero.mp hsub
  have hb12 : (b1 : ZMod (2 ^ t)) = (b2 : ZMod (2 ^ t)) := by
    have hsub : ((b1 : ZMod (2 ^ t)) - (b2 : ZMod (2 ^ t))) = 0 := by
      dsimp [db] at hdb0
      simpa [Int.cast_sub] using hdb0
    exact sub_eq_zero.mp hsub
  simp [qAffine, ha12, hb12]
/-! Prop 8.2 ("rigid-out"), generic branch, assembled: given a `Scal`-agreement
`g = β` off the zero set of the affine function `β(n) := qAffine (2^t) A B n`, and
given the target affine `α(n) := qAffine (2^t) s c n`, if `g` agrees with `α` at two
rows of different parity where neither `β` nor `α` vanishes, then `β = α` and `g`
agrees with `α` everywhere (all rows) where `α` is nonzero. -/

lemma rigid_out_of_two_free_rows {t N : ℕ} (ht : 1 ≤ t) {g : Fin N → ZMod (2 ^ t)}
    (s c A B : ℤ) (hs : ∀ r : Fin N, qAffine (2 ^ t) A B (rowVal r) ≠ 0 →
      g r = qAffine (2 ^ t) A B (rowVal r))
    {r₁ r₂ : Fin N} (hpar : Odd (rowVal r₂ - rowVal r₁))
    (hAB₁ : qAffine (2 ^ t) A B (rowVal r₁) ≠ 0)
    (hAB₂ : qAffine (2 ^ t) A B (rowVal r₂) ≠ 0)
    (hα₁ : qAffine (2 ^ t) s c (rowVal r₁) ≠ 0)
    (hα₂ : qAffine (2 ^ t) s c (rowVal r₂) ≠ 0)
    (hagree₁ : g r₁ = qAffine (2 ^ t) s c (rowVal r₁))
    (hagree₂ : g r₂ = qAffine (2 ^ t) s c (rowVal r₂)) :
    ∀ r : Fin N, qAffine (2 ^ t) s c (rowVal r) ≠ 0 → g r = qAffine (2 ^ t) s c (rowVal r) := by
  have h₁ : qAffine (2 ^ t) A B (rowVal r₁) = qAffine (2 ^ t) s c (rowVal r₁) := by
    calc
      qAffine (2 ^ t) A B (rowVal r₁) = g r₁ := (hs r₁ hAB₁).symm
      _ = qAffine (2 ^ t) s c (rowVal r₁) := hagree₁
  have h₂ : qAffine (2 ^ t) A B (rowVal r₂) = qAffine (2 ^ t) s c (rowVal r₂) := by
    calc
      qAffine (2 ^ t) A B (rowVal r₂) = g r₂ := (hs r₂ hAB₂).symm
      _ = qAffine (2 ^ t) s c (rowVal r₂) := hagree₂
  have hEq : qAffine (2 ^ t) A B = qAffine (2 ^ t) s c :=
    qAffine_eq_of_agree_two_points ht h₁ h₂ hpar
  intro r hr
  have hfree : qAffine (2 ^ t) A B (rowVal r) ≠ 0 := by
    rw [hEq]
    exact hr
  calc
    g r = qAffine (2 ^ t) A B (rowVal r) := hs r hfree
    _ = qAffine (2 ^ t) s c (rowVal r) := by rw [hEq]


/-! Prop 8.2 window witness lemmas: an `8`-row window which contains a "free" row of
each parity has two opposite-parity free rows; contrapositively, if no opposite-parity
free pair exists then every even row or every odd row of the window is covered.
"Free" for the target affine `α := qAffine s c` and the scal-affine `β := qAffine A B`
means both are nonvanishing at the row. -/

/-- A row is *free* (for the affine functions `qAffine s c` and `qAffine A B`) when
neither vanishes there. -/
def freeRow {t N : ℕ} (s c A B : ℤ) (r : Fin N) : Prop :=
  qAffine (2 ^ t) s c (rowVal r) ≠ 0 ∧ qAffine (2 ^ t) A B (rowVal r) ≠ 0

lemma odd_sub_of_even_odd {a b : ℤ} (ha : Even a) (hb : Odd b) : Odd (b - a) := by
  rcases ha with ⟨k, hk⟩
  rcases hb with ⟨l, hl⟩
  refine ⟨l - k, ?_⟩
  rw [hk, hl]
  ring

lemma odd_sub_of_odd_even {a b : ℤ} (ha : Odd a) (hb : Even b) : Odd (a - b) := by
  rcases ha with ⟨k, hk⟩
  rcases hb with ⟨l, hl⟩
  refine ⟨k - l, ?_⟩
  rw [hk, hl]
  ring

lemma even_of_odd_sub_odd {a b : ℤ} (h : Odd (b - a)) (ha : Odd a) : Even b := by
  rcases ha with ⟨k, hk⟩
  rcases h with ⟨l, hl⟩
  refine ⟨l + k + 1, ?_⟩
  omega

lemma odd_of_odd_sub_even {a b : ℤ} (h : Odd (b - a)) (ha : Even a) : Odd b := by
  rcases ha with ⟨k, hk⟩
  rcases h with ⟨l, hl⟩
  refine ⟨l + k, ?_⟩
  omega

/-- Window membership of a row. -/
def rowInWindow {N : ℕ} (n0 : ℤ) (r : Fin N) : Prop :=
  n0 ≤ rowVal r ∧ rowVal r ≤ n0 + 7

/-- If a window has a free row of each parity, it has two free rows of different
parity. -/
lemma window_free_opposite_parity_rows {t N : ℕ} (s c A B : ℤ) (n0 : ℤ)
    (hEven : ∃ r : Fin N, rowInWindow n0 r ∧ Even (rowVal r) ∧ freeRow (t := t) s c A B r)
    (hOdd : ∃ r : Fin N, rowInWindow n0 r ∧ Odd (rowVal r) ∧ freeRow (t := t) s c A B r) :
    ∃ r₁ r₂ : Fin N, rowInWindow n0 r₁ ∧ rowInWindow n0 r₂ ∧
      Odd (rowVal r₂ - rowVal r₁) ∧ freeRow (t := t) s c A B r₁ ∧ freeRow (t := t) s c A B r₂ := by
  rcases hEven with ⟨r₁, hw₁, he₁, hf₁⟩
  rcases hOdd with ⟨r₂, hw₂, ho₂, hf₂⟩
  exact ⟨r₁, r₂, hw₁, hw₂, odd_sub_of_even_odd he₁ ho₂, hf₁, hf₂⟩

/-- Contrapositive (the input to the rigid-out coset analysis): if a window has no two
free rows of different parity, then all even rows or all odd rows of the window are
covered (i.e. not free). -/
lemma window_free_opposite_parity_cover {t N : ℕ} (s c A B : ℤ) (n0 : ℤ)
    (h : ¬ ∃ r₁ r₂ : Fin N, rowInWindow n0 r₁ ∧ rowInWindow n0 r₂ ∧
      Odd (rowVal r₂ - rowVal r₁) ∧ freeRow (t := t) s c A B r₁ ∧ freeRow (t := t) s c A B r₂) :
    (∀ r : Fin N, rowInWindow n0 r → Even (rowVal r) → ¬ freeRow (t := t) s c A B r) ∨
    (∀ r : Fin N, rowInWindow n0 r → Odd (rowVal r) → ¬ freeRow (t := t) s c A B r) := by
  by_cases hE : ∃ r : Fin N, rowInWindow n0 r ∧ Even (rowVal r) ∧ freeRow (t := t) s c A B r
  · by_cases hO : ∃ r : Fin N, rowInWindow n0 r ∧ Odd (rowVal r) ∧ freeRow (t := t) s c A B r
    · exfalso
      exact h (window_free_opposite_parity_rows s c A B n0 hE hO)
    · right
      intro r hr hodd hfree
      exact hO ⟨r, hr, hodd, hfree⟩
  · left
    intro r hr heven hfree
    exact hE ⟨r, hr, heven, hfree⟩

/-! The instantiation step of Prop 8.2 ("rigid-out"), generic case: with a `Scal`
element `g` agreeing with the scal-affine `β := qAffine A B` off zero(β), and with the
window agreement `g = α` (α := qAffine s c) on the 8-row window where α ≠ 0, the
existence of two free opposite-parity window rows (free of both zero sets) forces the
conclusion `g = α` everywhere α ≠ 0.  This is `rigid_out_of_two_free_rows` fed by
`window_free_opposite_parity_rows`; the (A,B) is supplied by the caller (e.g. from
`scal_affine_agreement`), and the two free rows are supplied as `hfree`. -/

theorem rigid_out_window_two_free {t N : ℕ} (ht : 1 ≤ t) {g : Fin N → ZMod (2 ^ t)}
    (s c A B n0 : ℤ)
    (hs : ∀ r : Fin N, qAffine (2 ^ t) A B (rowVal r) ≠ 0 →
      g r = qAffine (2 ^ t) A B (rowVal r))
    (hagree : ∀ r : Fin N, rowInWindow n0 r →
      qAffine (2 ^ t) s c (rowVal r) ≠ 0 → g r = qAffine (2 ^ t) s c (rowVal r))
    (hfree : ∃ r₁ r₂ : Fin N, rowInWindow n0 r₁ ∧ rowInWindow n0 r₂ ∧
      Odd (rowVal r₂ - rowVal r₁) ∧ freeRow (t := t) s c A B r₁ ∧
      freeRow (t := t) s c A B r₂) :
    ∀ r : Fin N, qAffine (2 ^ t) s c (rowVal r) ≠ 0 → g r = qAffine (2 ^ t) s c (rowVal r) := by
  rcases hfree with ⟨r₁, r₂, hw₁, hw₂, hpar, hf₁, hf₂⟩
  rcases hf₁ with ⟨hα₁, hβ₁⟩
  rcases hf₂ with ⟨hα₂, hβ₂⟩
  exact rigid_out_of_two_free_rows ht s c A B hs hpar hβ₁ hβ₂ hα₁ hα₂
    (hagree r₁ hw₁ hα₁) (hagree r₂ hw₂ hα₂)


/-! An even-spacing coset `{n | D·ℤ ∣ n − a}` (i.e. `Even D`) lies in a single parity
class: any two of its members are congruent modulo `2`.  (Rigid-out case analysis needs
this so that the window-count bounds restrict to one parity class.) -/
lemma coset_same_parity {D : ℕ} {a : ℤ} (hD : Even D) :
    ∀ n : ℤ, ((D : ℕ) : ℤ) ∣ n - a → Even (n - a) := by
  intro n h
  rcases hD with ⟨k, hk⟩
  have hDc : ((D : ℕ) : ℤ) = 2 * (k : ℤ) := by
    have hz := congrArg (fun x : ℕ => (x : ℤ)) hk
    rw [Nat.cast_add] at hz
    rw [hz]
    ring
  have h2D : (2 : ℤ) ∣ ((D : ℕ) : ℤ) := ⟨k, hDc⟩
  have h2 : (2 : ℤ) ∣ n - a := dvd_trans h2D h
  rcases h2 with ⟨w, hw⟩
  refine ⟨w, ?_⟩
  rw [hw]
  ring
/-! Rigid-out bad-case trichotomy (integer level): an 8-window parity class covered by
two even-spacing cosets is covered either by one coset alone (spacing 2) or by the two
complementary spacing-4 cosets. -/

/-- A coset of `D·ℤ` with `D ≥ 4` meets an 8-window in at most 2 points. -/
lemma coset_window_eight_le_two {D : ℕ} (hD : 4 ≤ D) (a n0 : ℤ) :
    ((Finset.Icc n0 (n0 + 7)).filter (fun m : ℤ => ((D : ℕ) : ℤ) ∣ m - a)).card ≤ 2 := by
  have hb := Commons.Data.Int.Window.coset_eight_window_card_le (D := D) (by omega : 0 < D) a n0
  have hlt : (7 : ℕ) / D ≤ 1 := by
    have hDpos : 0 < D := by omega
    have hlt' : (7 : ℕ) / D < 2 := by
      rw [Nat.div_lt_iff_lt_mul hDpos]
      omega
    omega
  omega

/-- If `x` is even, in the window, and lies in the coset of `2ℤ` through `a`, then every
even element of the window lies in that coset (a spacing-2 coset covers a whole parity
class). -/
lemma two_spacing_coset_covers_even_class {a n0 x : ℤ} (hx1 : n0 ≤ x) (hx2 : x ≤ n0 + 7)
    (hxE : Even x) (hxmem : ((2 : ℕ) : ℤ) ∣ x - a) :
    ∀ m : ℤ, n0 ≤ m → m ≤ n0 + 7 → Even m → ((2 : ℕ) : ℤ) ∣ m - a := by
  intro m hm1 hm2 hmE
  rcases hxE with ⟨u, hu⟩
  rcases hmE with ⟨v, hv⟩
  rcases hxmem with ⟨w, hw⟩
  refine ⟨v - u + w, ?_⟩
  -- m - a = 2·(v - u + w): from m - a = (m - x) + (x - a); m = v+v, x = u+u, x-a = 2w
  have hmx : m - x = (v - u) + (v - u) := by omega
  have hxa : x - a = 2 * w := hw
  calc
    m - a = (m - x) + (x - a) := by ring
    _ = ((v - u) + (v - u)) + 2 * w := by rw [hmx, hxa]
    _ = 2 * (v - u + w) := by ring
/-! General parity-class version of the spacing-2 coset coverage: a coset of `2·ℤ`
through `a` contains every window point of the same parity as any of its window points.
(Subsumes the even-class and odd-class variants used in the `D₀ = 2` branch of the
rigid-out bad case.) -/
lemma two_spacing_coset_covers_parity_class {a n0 x : ℤ} (hx1 : n0 ≤ x) (hx2 : x ≤ n0 + 7)
    (hxmem : ((2 : ℕ) : ℤ) ∣ x - a) :
    ∀ m : ℤ, n0 ≤ m → m ≤ n0 + 7 → Even (m - x) → ((2 : ℕ) : ℤ) ∣ m - a := by
  intro m hm1 hm2 hd
  rcases hxmem with ⟨w, hw⟩
  rcases hd with ⟨r, hr⟩
  refine ⟨r + w, ?_⟩
  calc
    m - a = (m - x) + (x - a) := by ring
    _ = (r + r) + 2 * w := by rw [hr, hw]; norm_num
    _ = 2 * (r + w) := by ring

lemma two_spacing_coset_covers_odd_class {a n0 x : ℤ} (hx1 : n0 ≤ x) (hx2 : x ≤ n0 + 7)
    (hxO : Odd x) (hxmem : ((2 : ℕ) : ℤ) ∣ x - a) :
    ∀ m : ℤ, n0 ≤ m → m ≤ n0 + 7 → Odd m → ((2 : ℕ) : ℤ) ∣ m - a := by
  intro m hm1 hm2 hmO
  apply two_spacing_coset_covers_parity_class hx1 hx2 hxmem m hm1 hm2
  rcases hxO with ⟨k, hk⟩
  rcases hmO with ⟨l, hl⟩
  refine ⟨l - k, ?_⟩
  rw [hk, hl]
  ring


lemma two_dvd_iff_even {x : ℤ} : (2 : ℤ) ∣ x ↔ Even x := by
  constructor
  · intro h; rcases h with ⟨r, hr⟩; refine ⟨r, ?_⟩; rw [hr]; ring
  · intro h; rcases h with ⟨r, hr⟩; refine ⟨r, ?_⟩; rw [hr]; ring

lemma odd_of_not_two_dvd {x : ℤ} (h : ¬ (2 : ℤ) ∣ x) : Odd x := by
  rcases Int.even_or_odd x with hx | hx
  · exact False.elim (h ((two_dvd_iff_even).mpr hx))
  · exact hx

lemma odd_add_even {x y : ℤ} (hx : Odd x) (hy : Even y) : Odd (x + y) := by
  rcases hx with ⟨k, hk⟩
  rcases hy with ⟨l, hl⟩
  refine ⟨k + l, ?_⟩
  rw [hk, hl]
  ring

lemma odd_not_two_dvd {x : ℤ} (hx : Odd x) : ¬ (2 : ℤ) ∣ x := by
  intro h
  rcases hx with ⟨k, hk⟩
  rcases h with ⟨l, hl⟩
  omega

lemma even_int_of_even_nat {k : ℕ} (hk : Even k) : Even (k : ℤ) := by
  rcases hk with ⟨j, hj⟩
  refine ⟨(j : ℤ), ?_⟩
  exact_mod_cast hj

/-- rigid-out bad case, spacing-2 branch: if `D₀ = 2`, the coset `C₀` is a whole parity
class; either `C₀` covers all four points of the class `{b,…,b+6}` (parity of `b` equal
to that of `a₀`), or — `C₀` missing the class — the cover forces `C₁` to contain all
four. -/
lemma bad_cover_spacing2 {D0 D1 : ℕ} (hD0 : D0 = 2) (a0 a1 n0 b : ℤ)
    (hblo : n0 ≤ b) (hbhi : b + 6 ≤ n0 + 7)
    (hcover : ∀ k : ℕ, k ≤ 6 → Even k →
       (((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨ (((D1 : ℕ) : ℤ) ∣ (b + k) - a1)) :
    (∀ k : ℕ, k ≤ 6 → Even k → ((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨
    (∀ k : ℕ, k ≤ 6 → Even k → ((D1 : ℕ) : ℤ) ∣ (b + k) - a1) := by
  have hDz : ((D0 : ℕ) : ℤ) = ((2 : ℕ) : ℤ) := by rw [hD0]
  by_cases hb0 : ((2 : ℕ) : ℤ) ∣ b - a0
  · left
    intro k hk6 hke
    rw [hDz]
    apply two_spacing_coset_covers_parity_class hblo (by omega : b ≤ n0 + 7) hb0 (b + (k : ℤ))
    · have hkz : (k : ℤ) ≤ 6 := by exact_mod_cast hk6
      omega
    · have hkz : (k : ℤ) ≤ 6 := by exact_mod_cast hk6
      omega
    · -- Even ((b + (k : ℤ)) - b): k even
      have hkez : Even (k : ℤ) := even_int_of_even_nat hke
      rcases hkez with ⟨j, hj⟩
      refine ⟨j, ?_⟩
      rw [hj]
      ring
  · right
    intro k hk6 hke
    have hkez : Even (k : ℤ) := even_int_of_even_nat hke
    have hodd : Odd ((b - a0) + (k : ℤ)) := by
      have hn0' : ¬ ((2 : ℤ) ∣ (b - a0)) := by
        intro h
        exact hb0 h
      apply odd_add_even (odd_of_not_two_dvd hn0') hkez
    have hodd' : Odd ((b + (k : ℤ)) - a0) := by
      convert hodd using 1
      ring
    have hnot0 : ¬ ((2 : ℤ) ∣ ((b + (k : ℤ)) - a0)) := odd_not_two_dvd hodd'
    rcases hcover k hk6 hke with h0 | h1
    · exfalso
      rw [hDz] at h0
      exact hnot0 h0
    · -- convert to (D1 : ℕ) : ℤ ∣ (b + k) − a1, h1 already in that form modulo (k:ℤ) vs k
      exact h1


/-- rigid-out bad case, spacing-2 branch for D1: label-swap of `bad_cover_spacing2`
(exchanging `(D0,a0)` with `(D1,a1)`). -/
lemma bad_cover_spacing2_swap {D0 D1 : ℕ} (hD1 : D1 = 2) (a0 a1 n0 b : ℤ)
    (hblo : n0 ≤ b) (hbhi : b + 6 ≤ n0 + 7)
    (hcover : ∀ k : ℕ, k ≤ 6 → Even k →
       (((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨ (((D1 : ℕ) : ℤ) ∣ (b + k) - a1)) :
    (∀ k : ℕ, k ≤ 6 → Even k → ((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨
    (∀ k : ℕ, k ≤ 6 → Even k → ((D1 : ℕ) : ℤ) ∣ (b + k) - a1) := by
  rcases bad_cover_spacing2 (D0 := D1) (D1 := D0) hD1 a1 a0 n0 b hblo hbhi
      (fun k hk6 hke => by
        rcases hcover k hk6 hke with h0 | h1
        · exact Or.inr h0
        · exact Or.inl h1) with h | h
  · right
    exact h
  · left
    exact h

/-- A coset of `D·ℤ` with `D ≥ 4` cannot contain two points two apart. -/
lemma wide_no_distance2 {D : ℕ} (hD : 4 ≤ D) (a x y : ℤ)
    (h1 : ((D : ℕ) : ℤ) ∣ x - a) (h2 : ((D : ℕ) : ℤ) ∣ y - a) (hd : y - x = 2) : False := by
  have hdvd' : ((D : ℕ) : ℤ) ∣ ((y - a) - (x - a)) := dvd_sub h2 h1
  have hdvd : ((D : ℕ) : ℤ) ∣ (y - x) := by
    convert hdvd' using 1
    ring
  rw [hd] at hdvd
  have hnat : D ∣ 2 := (Int.natCast_dvd_natCast).mp hdvd
  have hle : D ≤ 2 := Nat.le_of_dvd (by norm_num : 0 < 2) hnat
  omega

/-- rigid-out bad case, both-wide branch (`4 ≤ D₀` and `4 ≤ D₁`): the covered class
`{b, b+2, b+4, b+6}` splits into the two complementary spacing-4 cosets. -/
lemma bad_cover_wide {D0 D1 : ℕ} (hD0 : 4 ≤ D0) (hD1 : 4 ≤ D1) (a0 a1 b : ℤ)
    (hcover : ∀ k : ℕ, k ≤ 6 → Even k →
       (((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨ (((D1 : ℕ) : ℤ) ∣ (b + k) - a1)) :
    ((((D0 : ℕ) : ℤ) ∣ b - a0) ∧ (((D0 : ℕ) : ℤ) ∣ (b + 4) - a0) ∧
     (((D1 : ℕ) : ℤ) ∣ (b + 2) - a1) ∧ (((D1 : ℕ) : ℤ) ∣ (b + 6) - a1)) ∨
    ((((D0 : ℕ) : ℤ) ∣ (b + 2) - a0) ∧ (((D0 : ℕ) : ℤ) ∣ (b + 6) - a0) ∧
     (((D1 : ℕ) : ℤ) ∣ b - a1) ∧ (((D1 : ℕ) : ℤ) ∣ (b + 4) - a1)) := by
  let C0 : ℤ → Prop := fun x => ((D0 : ℕ) : ℤ) ∣ x - a0
  let C1 : ℤ → Prop := fun x => ((D1 : ℕ) : ℤ) ∣ x - a1
  have hb : C0 b ∨ C1 b := by
    have h := hcover 0 (by norm_num) (⟨0, rfl⟩ : Even 0)
    simpa [C0, C1] using h
  have hb2 : C0 (b + 2) ∨ C1 (b + 2) := by
    have h := hcover 2 (by norm_num) (⟨1, rfl⟩ : Even 2)
    simpa [C0, C1] using h
  have hb4 : C0 (b + 4) ∨ C1 (b + 4) := by
    have h := hcover 4 (by norm_num) (⟨2, rfl⟩ : Even 4)
    simpa [C0, C1] using h
  have hb6 : C0 (b + 6) ∨ C1 (b + 6) := by
    have h := hcover 6 (by norm_num) (⟨3, rfl⟩ : Even 6)
    simpa [C0, C1] using h
  have h02 : ∀ x y : ℤ, C0 x → C0 y → y - x = 2 → False := by
    intro x y h1 h2 hd
    exact wide_no_distance2 hD0 a0 x y h1 h2 hd
  have h12 : ∀ x y : ℤ, C1 x → C1 y → y - x = 2 → False := by
    intro x y h1 h2 hd
    exact wide_no_distance2 hD1 a1 x y h1 h2 hd
  by_cases hbC0 : C0 b
  · have hb2n0 : ¬ C0 (b + 2) := by
      intro h
      exact h02 b (b + 2) hbC0 h (by ring)
    have hb2C1 : C1 (b + 2) := hb2.resolve_left hb2n0
    by_cases hb4C0 : C0 (b + 4)
    · left
      have hb6n0 : ¬ C0 (b + 6) := by
        intro h
        exact h02 (b + 4) (b + 6) hb4C0 h (by ring)
      have hb6C1 : C1 (b + 6) := hb6.resolve_left hb6n0
      exact ⟨hbC0, hb4C0, hb2C1, hb6C1⟩
    · exfalso
      have hb4C1 : C1 (b + 4) := hb4.resolve_left hb4C0
      exact h12 (b + 2) (b + 4) hb2C1 hb4C1 (by ring)
  · have hbC1 : C1 b := hb.resolve_left hbC0
    have hb2n1 : ¬ C1 (b + 2) := by
      intro h
      exact h12 b (b + 2) hbC1 h (by ring)
    have hb2C0 : C0 (b + 2) := hb2.resolve_right hb2n1
    have hb4n0 : ¬ C0 (b + 4) := by
      intro h
      exact h02 (b + 2) (b + 4) hb2C0 h (by ring)
    have hb4C1 : C1 (b + 4) := hb4.resolve_left hb4n0
    have hb6n1 : ¬ C1 (b + 6) := by
      intro h
      exact h12 (b + 4) (b + 6) hb4C1 h (by ring)
    have hb6C0 : C0 (b + 6) := hb6.resolve_right hb6n1
    right
    exact ⟨hb2C0, hb6C0, hbC1, hb4C1⟩

/-- An even natural `≥ 2` is either `2` or `≥ 4`. -/
lemma even_two_or_four_le {D : ℕ} (h : 2 ≤ D) (hE : Even D) : D = 2 ∨ 4 ≤ D := by
  rcases hE with ⟨k, hk⟩
  by_cases hk1 : k = 1
  · left
    subst k
    omega
  · right
    have hk2 : 2 ≤ k := by omega
    omega

/-- rigid-out bad case, full trichotomy: the class `{b,…,b+6}` covered by two cosets of
even spacings `D₀, D₁ ≥ 2` is covered by one coset alone (a spacing-2 coset) or by the
two complementary spacing-4 cosets. -/
lemma rigid_out_bad_cases {D0 D1 : ℕ} (hD0 : 2 ≤ D0) (hD1 : 2 ≤ D1)
    (hE0 : Even D0) (hE1 : Even D1) (a0 a1 n0 b : ℤ)
    (hblo : n0 ≤ b) (hbhi : b + 6 ≤ n0 + 7)
    (hcover : ∀ k : ℕ, k ≤ 6 → Even k →
       (((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨ (((D1 : ℕ) : ℤ) ∣ (b + k) - a1)) :
    (∀ k : ℕ, k ≤ 6 → Even k → ((D0 : ℕ) : ℤ) ∣ (b + k) - a0) ∨
    (∀ k : ℕ, k ≤ 6 → Even k → ((D1 : ℕ) : ℤ) ∣ (b + k) - a1) ∨
    ((((D0 : ℕ) : ℤ) ∣ b - a0) ∧ (((D0 : ℕ) : ℤ) ∣ (b + 4) - a0) ∧
     (((D1 : ℕ) : ℤ) ∣ (b + 2) - a1) ∧ (((D1 : ℕ) : ℤ) ∣ (b + 6) - a1)) ∨
    ((((D0 : ℕ) : ℤ) ∣ (b + 2) - a0) ∧ (((D0 : ℕ) : ℤ) ∣ (b + 6) - a0) ∧
     (((D1 : ℕ) : ℤ) ∣ b - a1) ∧ (((D1 : ℕ) : ℤ) ∣ (b + 4) - a1)) := by
  rcases even_two_or_four_le hD0 hE0 with h0e | h40
  · rcases bad_cover_spacing2 h0e a0 a1 n0 b hblo hbhi hcover with hA | hA
    · exact Or.inl hA
    · exact Or.inr (Or.inl hA)
  · rcases even_two_or_four_le hD1 hE1 with h1e | h41
    · rcases bad_cover_spacing2_swap h1e a0 a1 n0 b hblo hbhi hcover with hA | hA
      · exact Or.inl hA
      · exact Or.inr (Or.inl hA)
    · rcases bad_cover_wide h40 h41 a0 a1 b hcover with hB | hB
      · exact Or.inr (Or.inr (Or.inl hB))
      · exact Or.inr (Or.inr (Or.inr hB))

/-! Row↔integer bridge for the rigid-out assembly: every integer of the window
`{1,…,N}` is the `rowVal` of a unique row, so row-level coverage (over `Fin N`) is
integer-level coverage (over the window of coordinates). -/

/-- `rowVal` agrees with the framework's `finToInt`. -/
lemma rowVal_eq_finToInt {N : ℕ} (n : Fin N) : rowVal n = finToInt n := rfl

/-- Recovering a row from an integer window coordinate. -/
lemma rowVal_intToFin {N : ℕ} (x : {x : ℤ // x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)}) :
    rowVal (intToFin x) = x.1 := by
  simpa [rowVal, finToInt] using (finToInt_intToFin x)

/-- Every integer `x ∈ {1,…,N}` is the `rowVal` of some row. -/
lemma exists_row_rowVal {N : ℕ} (x : ℤ) (hx1 : 1 ≤ x) (hxN : x ≤ (N : ℤ)) :
    ∃ r : Fin N, rowVal r = x := by
  refine ⟨intToFin ⟨x, by rw [Finset.mem_Icc]; exact ⟨hx1, hxN⟩⟩, ?_⟩
  exact rowVal_intToFin ⟨x, by rw [Finset.mem_Icc]; exact ⟨hx1, hxN⟩⟩

/-- Every integer of a legal 8-window is the `rowVal` of some row. -/
lemma exists_row_rowVal_window {N : ℕ} (n0 x : ℤ) (hn0 : 1 ≤ n0) (hx0 : n0 ≤ x)
    (hx7 : x ≤ n0 + 7) (hn7 : n0 + 7 ≤ (N : ℤ)) :
    ∃ r : Fin N, rowVal r = x := by
  have hx1 : 1 ≤ x := le_trans hn0 hx0
  have hxN : x ≤ (N : ℤ) := le_trans hx7 hn7
  exact exists_row_rowVal (N := N) x hx1 hxN

/-- Window membership of a row is membership of its coordinate in the integer window. -/
lemma rowInWindow_iff_mem {N : ℕ} (n0 : ℤ) (r : Fin N) :
    rowInWindow n0 r ↔ rowVal r ∈ Finset.Icc n0 (n0 + 7) := by
  rw [rowInWindow, Finset.mem_Icc]


/-! α-value facts for the rigid-out case lemmas: `q/2 = qHalf t` multiplied by an odd
integer stays `q/2` in `ZMod (2^t)` (`qHalf t * 2 = 0` kills the even part).  Used to
show that an affine function vanishing on a full parity class of an 8-window takes the
value `q/2` on the complementary class. -/

lemma qHalf_mul_two {t : ℕ} (ht : 1 ≤ t) : qHalf t * (2 : ZMod (2 ^ t)) = 0 := by
  dsimp [qHalf]
  have hnat : ((2 ^ (t - 1) : ℕ) * 2 : ℕ) = 2 ^ t := by
    rw [← pow_succ]
    congr 1
    omega
  change ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) * ((2 : ℕ) : ZMod (2 ^ t)) = 0
  rw [← Nat.cast_mul, hnat]
  simp

/-- `(q/2)·u = q/2` for every odd integer `u` (`t ≥ 1`). -/
lemma zmod_two_mul_zero_val {t : ℕ} (ht : 1 ≤ t) (s : ZMod (2 ^ t)) (h : s * 2 = 0) :
    s = 0 ∨ s = qHalf t := by
  haveI : NeZero (2 ^ t) := ⟨pow_ne_zero t (by norm_num)⟩
  have hs : ((s.val : ℕ) : ZMod (2 ^ t)) = s := ZMod.natCast_zmod_val s
  have h2 : (((s.val * 2 : ℕ) : ZMod (2 ^ t)) = 0) := by
    have hp : (s.val : ZMod (2 ^ t)) * (2 : ZMod (2 ^ t)) = 0 := by
      rwa [← hs] at h
    have hprod : ((s.val : ℕ) : ZMod (2 ^ t)) * (2 : ZMod (2 ^ t)) =
        (((s.val * 2 : ℕ) : ZMod (2 ^ t))) := by
      simpa using (Nat.cast_mul (s.val) (2 : ℕ)).symm
    rw [hprod] at hp
    exact hp
  have hdvdN : (2 ^ t : ℕ) ∣ (s.val * 2 : ℕ) :=
    (ZMod.natCast_eq_zero_iff (s.val * 2) (2 ^ t)).mp h2
  have h2t : (2 ^ t : ℕ) = 2 * 2 ^ (t - 1) := by
    calc
      (2 ^ t : ℕ) = 2 ^ ((t - 1) + 1) := by congr 1; omega
      _ = 2 ^ (t - 1) * 2 := by rw [pow_succ]
      _ = 2 * 2 ^ (t - 1) := by rw [mul_comm]
  have hcancel : (2 ^ (t - 1) : ℕ) ∣ s.val := by
    have hdvd2 : (2 : ℕ) * 2 ^ (t - 1) ∣ s.val * 2 := by
      simpa [h2t] using hdvdN
    have hd3 : (2 : ℕ) * 2 ^ (t - 1) ∣ (2 : ℕ) * s.val := by
      simpa [mul_comm, mul_left_comm, mul_assoc] using hdvd2
    exact (Nat.mul_dvd_mul_iff_left (a := 2) (b := 2 ^ (t - 1)) (c := s.val) (by norm_num)).mp hd3
  rcases hcancel with ⟨k, hk⟩
  have hslt : s.val < 2 ^ t := ZMod.val_lt s
  have hklt : k < 2 := by
    have hpow0 : 0 < 2 ^ (t - 1) := pow_pos (by norm_num) (t - 1)
    have hslt2 : 2 ^ (t - 1) * k < 2 ^ (t - 1) * 2 := by
      rw [hk] at hslt
      rw [h2t] at hslt
      simpa [mul_comm, mul_left_comm, mul_assoc] using hslt
    exact (Nat.mul_lt_mul_left hpow0).mp hslt2
  have hk01 : k = 0 ∨ k = 1 := by omega
  rcases hk01 with hk0 | hk1
  · left
    have hs0 : s.val = 0 := by rw [hk, hk0]; simp
    rw [← hs]
    rw [hs0]
    simp
  · right
    have hs1 : s.val = 2 ^ (t - 1) := by rw [hk, hk1]; simp
    rw [← hs]
    rw [hs1]


/-- An affine function over `ZMod (2^t)` vanishing at two points two apart takes only
the values `0` and `q/2 = qHalf t`. -/
lemma affine_two_zeros_value {t : ℕ} (ht : 1 ≤ t) {s c e : ℤ}
    (he : qAffine (2 ^ t) s c e = 0) (he2 : qAffine (2 ^ t) s c (e + 2) = 0) :
    ∀ n : ℤ, qAffine (2 ^ t) s c n = 0 ∨ qAffine (2 ^ t) s c n = qHalf t := by
  have halpha (n : ℤ) :
      qAffine (2 ^ t) s c n = (s : ZMod (2 ^ t)) * ((n - e : ℤ) : ZMod (2 ^ t)) := by
    calc
      qAffine (2 ^ t) s c n = qAffine (2 ^ t) s c n - qAffine (2 ^ t) s c e := by
        rw [he]
        ring
      _ = ((s : ZMod (2 ^ t)) * (n : ZMod (2 ^ t)) + (c : ZMod (2 ^ t))) -
            ((s : ZMod (2 ^ t)) * (e : ZMod (2 ^ t)) + (c : ZMod (2 ^ t))) := by
              simp [qAffine]
      _ = (s : ZMod (2 ^ t)) * ((n - e : ℤ) : ZMod (2 ^ t)) := by
        simp [Int.cast_sub]
        ring
  have h2s : (s : ZMod (2 ^ t)) * (2 : ZMod (2 ^ t)) = 0 := by
    have hv := halpha (e + 2)
    have hv' : qAffine (2 ^ t) s c (e + 2) = (s : ZMod (2 ^ t)) * ((2 : ℤ) : ZMod (2 ^ t)) := by
      rw [show ((e + 2) - e : ℤ) = 2 by ring] at hv
      simpa using hv
    have hz : (s : ZMod (2 ^ t)) * ((2 : ℤ) : ZMod (2 ^ t)) = 0 := by
      have hv'' := hv'
      rw [he2] at hv''
      exact hv''.symm
    simpa using hz
  have hsZ : (s : ZMod (2 ^ t)) = 0 ∨ (s : ZMod (2 ^ t)) = qHalf t :=
    zmod_two_mul_zero_val ht (s : ZMod (2 ^ t)) h2s
  intro n
  by_cases hE : Even (n - e)
  · rcases hE with ⟨u, hu⟩
    left
    -- n − e = u + u (Even)
    rw [halpha n]
    rw [hu]
    have hcast : ((u + u : ℤ) : ZMod (2 ^ t)) = (u : ZMod (2 ^ t)) + (u : ZMod (2 ^ t)) := by
      simp [Int.cast_add]
    rw [hcast]
    calc
      (s : ZMod (2 ^ t)) * ((u : ZMod (2 ^ t)) + (u : ZMod (2 ^ t)))
          = ((s : ZMod (2 ^ t)) * 2) * (u : ZMod (2 ^ t)) := by ring
      _ = 0 := by rw [h2s]; simp
  · -- n − e odd: value = s (if s = qHalf, qHalf·odd = qHalf; if s = 0, 0)
    have hO : Odd (n - e) := by
      rcases Int.even_or_odd (n - e) with hE' | hO
      · exfalso
        exact hE hE'
      · exact hO
    rcases hsZ with hs0 | hsq
    · left
      rw [halpha n]
      rw [hs0]
      simp
    · right
      rw [halpha n]
      rw [hsq]
      exact qHalf_mul_odd ht (n - e) hO

/-- Two-apart zeros plus a nonzero value at an odd-offset point force that value to be
`q/2`: the affine is `α(x) = s·(x−e)` with `2s = 0`; the odd-offset value is `s`, which
by `affine_two_zeros_value` is `0` or `qHalf`, and it is not `0`.  (Paper rigid-out
case (I).1: an affine with zero set ⊇ the even class of an 8-window takes the value
`q/2` on the complementary class.) -/
lemma affine_odd_class_value_qHalf {t : ℕ} (ht : 1 ≤ t) {s c e : ℤ}
    (he : qAffine (2 ^ t) s c e = 0) (he2 : qAffine (2 ^ t) s c (e + 2) = 0) {n : ℤ}
    (hnz : qAffine (2 ^ t) s c n ≠ 0) (hodd : Odd (n - e)) :
    qAffine (2 ^ t) s c n = qHalf t := by
  rcases affine_two_zeros_value ht he he2 n with h | h
  · exact False.elim (hnz h)
  · exact h

/-- A row is *free* (for `α := qAffine s c` and `β := qAffine A B`) iff its coordinate
lies outside both corresponding bad cosets. -/
lemma freeRow_iff_badCoset {t N : ℕ} (s c A B : ℤ) (r : Fin N) :
    freeRow (t := t) s c A B r ↔
      rowVal r ∉ badCoset (2 ^ t) s c ∧ rowVal r ∉ badCoset (2 ^ t) A B := by
  unfold freeRow badCoset
  tauto

/-- A covered row (not free) has its coordinate in the union of the two bad cosets. -/
lemma not_freeRow_iff_badCoset_union {t N : ℕ} (s c A B : ℤ) (r : Fin N) :
    ¬ freeRow (t := t) s c A B r ↔
      rowVal r ∈ badCoset (2 ^ t) s c ∨ rowVal r ∈ badCoset (2 ^ t) A B := by
  unfold freeRow badCoset
  tauto


end
