/-! ## Axiom (i): the encoded Sudoku-solution (Scal) condition

Paper axiom (i): with the reflection applied, `n ↦ B(omega_{1,0,n},...,omega_{1,s0-1,n})`
(positions `rowVal n`) lies in `Scal_q[N]`.  In the full-word convention (`w*` at
coordinate 0) the reflected 1-words are `encReflect (boardStar tau) (boardRowWord1 tau n)`;
axiom (i) is the `InScal_q (2^s0) N` condition on the decoded sequence.  Reflection
invariance (the excluded-pair machinery needs the bad set reflection-closed) holds
because reflecting the whole word leaves the reflected decodes unchanged:
`R_{1-w*}(1-t) = R_{w*}(t)`. -/

/-- The decoded row-1 word at row `n` (reflected by `w*`), into `ZMod (2^s0)`. -/
def rowWord1Decode {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) :
    ZMod (2 ^ s0) :=
  encB (encReflect (boardStar tau) (boardRowWord1 tau n))

/-- Axiom (i): the decoded row-1 words form a `Scal_q[N]`-sequence in the row. -/
def boardScalCond {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) : Prop :=
  InScal_q (2 ^ s0) N (fun n : Fin N => rowWord1Decode tau n)

/-- The full-board good word: good columns (axiom (ii)) AND the Scal condition
(axiom (i)). -/
def boardGood2Full {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) : Prop :=
  boardGood2 (s0 := s0) (N := N) tau ∧ boardScalCond tau

/-- Reflecting the whole word leaves each reflected row-1 decode unchanged. -/
lemma rowWord1Decode_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) :
    rowWord1Decode (fun i => 1 - tau i) n = rowWord1Decode tau n := by
  unfold rowWord1Decode
  have hstar : boardStar (fun i => 1 - tau i) = 1 - boardStar tau := rfl
  have hw1 : boardRowWord1 (fun i => 1 - tau i) n = fun b => 1 - boardRowWord1 tau n b := rfl
  rw [hstar, hw1]
  exact congrArg encB (encReflect_shift (boardStar tau) (boardRowWord1 tau n))

/-- The Scal condition (axiom (i)) is invariant under reflecting the word. -/
lemma boardScalCond_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) :
    boardScalCond (fun i => 1 - tau i) ↔ boardScalCond tau := by
  unfold boardScalCond
  have heq : (fun n : Fin N => rowWord1Decode (fun i => 1 - tau i) n) =
      fun n : Fin N => rowWord1Decode tau n := by
    funext n
    exact rowWord1Decode_reflect tau n
  constructor
  · intro h
    rwa [heq] at h
  · intro h
    rwa [← heq] at h



/-! ## The full bad set and its enumeration (both axioms (i) and (ii))

`boardBad2Full` is the complement of `boardGood2Full` in the cube.  Its reflection
closure uses `boardGood2Full_reflect` (axiom (ii), earlier) and `boardScalCond_reflect`
(axiom (i)): the full good predicate is reflection-invariant, so the bad set is a union
of reflection pairs and the excluded-pair machinery applies. -/

/-- The full good word is reflection-invariant. -/
lemma boardGood2Full_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) :
    boardGood2Full (fun i => 1 - tau i) ↔ boardGood2Full tau := by
  unfold boardGood2Full
  constructor
  · intro h
    exact ⟨(boardGood2_reflect (s0 := s0) (N := N) tau).mp h.1,
      (boardScalCond_reflect tau).mp h.2⟩
  · intro h
    exact ⟨(boardGood2_reflect (s0 := s0) (N := N) tau).mpr h.1,
      (boardScalCond_reflect tau).mpr h.2⟩

/-- The bad full words (complement of the full good set in the cube). -/
def boardBad2Full (s0 N : Nat) : Set (Fin (BoardW s0 N) → ZMod 2) :=
  {tau | ¬ boardGood2Full (s0 := s0) (N := N) tau}

/-- The full bad set is reflection-closed. -/
lemma boardBad2Full_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) :
    (fun i => 1 - tau i) ∈ boardBad2Full s0 N ↔ tau ∈ boardBad2Full s0 N := by
  unfold boardBad2Full
  exact Iff.not (boardGood2Full_reflect (s0 := s0) (N := N) tau)

/-- The excluded-pair enumeration of the full board: every full bad word, lifted. -/
noncomputable def boardBadFullEnum (s0 N e : Nat) :
    Fin (Fintype.card (boardBad2Full s0 N)) → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) :=
  fun l => lift2word (e := e) (((Fintype.equivFin (boardBad2Full s0 N)).symm l).1)

/-- The full-board enumeration is `{0,1}`-valued. -/
lemma boardBadFullEnum_01 (s0 N e : Nat) :
    ∀ l : Fin (Fintype.card (boardBad2Full s0 N)),
      ∀ i : Fin (BoardW s0 N), boardBadFullEnum s0 N e l i = 0 ∨ boardBadFullEnum s0 N e l i = 1 := by
  intro l i
  have hbit : ((Fintype.equivFin (boardBad2Full s0 N)).symm l).1 i = 0 ∨
              ((Fintype.equivFin (boardBad2Full s0 N)).symm l).1 i = 1 :=
    zmod2_eq_zero_or_one _
  rcases hbit with hz | ho
  · left
    dsimp [boardBadFullEnum, lift2word]
    rw [hz]
    exact lift2val_zero e
  · right
    dsimp [boardBadFullEnum, lift2word]
    rw [ho]
    exact lift2val_one e



/-! ### T4' — full `P_OmegaTilde` (both axioms) weakly expressible

Instantiation of `sb_POmegaFull_excl_weakExpressible` at `n := s0*N` with the FULL
bad enumeration `boardBadFullEnum` (mirror of T4). -/
theorem OmegaTilde_gcFull_weakExpressible {d s0 N : Nat} (e : Nat) (he : 1 ≤ e)
    (hs0 : 1 ≤ s0) (hN : 1 ≤ N)
    (gens : Fin d → EncodeG) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (hbig : 4 * (s0 * N) < 2 ^ (e + 1)) :
    WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (boardBadFullEnum s0 N e)) alpha) := by
  exact sb_POmegaFull_excl_weakExpressible (d := d) (n := s0 * N)
    (L := Fintype.card (boardBad2Full s0 N)) e he (by simpa using (Nat.mul_le_mul hs0 hN))
    encE0 encE1 encE2 encE0_two_zsmul encE1_two_zsmul encE2_two_zsmul encE_independent
    gens hpos hspan hbig (boardBadFullEnum s0 N e) (boardBadFullEnum_01 s0 N e)


/-! ### T5' support: full enumeration surjectivity -/

/-- The full-board enumeration covers every full bad word. -/
lemma boardBadFullEnum_surj (s0 N e : Nat) (b : boardBad2Full s0 N) :
    ∃ l : Fin (Fintype.card (boardBad2Full s0 N)), boardBadFullEnum s0 N e l = lift2word (e := e) b.1 := by
  refine ⟨Fintype.equivFin (boardBad2Full s0 N) b, ?_⟩
  dsimp [boardBadFullEnum]
  have hb : (Fintype.equivFin (boardBad2Full s0 N)).symm (Fintype.equivFin (boardBad2Full s0 N) b) = b := by simp
  rw [hb]

theorem sb_OmegaExcl_boardBadFullEnum_eq_good {s0 N e : Nat} :
    (sb_OmegaExcl (boardBadFullEnum s0 N e) : Set (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1)))) =
      {tau | (∀ i : Fin (BoardW s0 N), tau i = 0 ∨ tau i = 1) ∧
        boardGood2Full (s0 := s0) (N := N) (rowBits (e := e) tau)} := by
  classical
  ext tau
  constructor
  · intro hL
    rcases hL with ⟨h01, hexcl⟩
    refine ⟨h01, ?_⟩
    change boardGood2Full (s0 := s0) (N := N) (rowBits (e := e) tau)
    by_contra hbad
    have hb : rowBits (e := e) tau ∈ boardBad2Full s0 N := by
      change ¬ boardGood2Full (s0 := s0) (N := N) (rowBits (e := e) tau)
      exact hbad
    let b : boardBad2Full s0 N := ⟨rowBits (e := e) tau, hb⟩
    rcases boardBadFullEnum_surj s0 N e b with ⟨l, hl⟩
    have htau : boardBadFullEnum s0 N e l = tau := by
      calc
        boardBadFullEnum s0 N e l = lift2word (e := e) b.1 := hl
        _ = lift2word (e := e) (rowBits (e := e) tau) := by rfl
        _ = tau := lift2word_bit (e := e) tau h01
    exact (hexcl l).1 (by intro i; rw [← htau])
  · intro hR
    rcases hR with ⟨h01, hgood⟩
    refine ⟨h01, ?_⟩
    intro l
    constructor
    · intro hE
      have ht : tau = boardBadFullEnum s0 N e l := by funext i; exact hE i
      let b : boardBad2Full s0 N := (Fintype.equivFin (boardBad2Full s0 N)).symm l
      have hl : boardBadFullEnum s0 N e l = lift2word (e := e) b.1 := rfl
      have hEq : lift2word (e := e) (rowBits (e := e) tau) = lift2word (e := e) b.1 := by
        calc
          lift2word (e := e) (rowBits (e := e) tau) = tau := lift2word_bit (e := e) tau h01
          _ = boardBadFullEnum s0 N e l := ht
          _ = lift2word (e := e) b.1 := hl
      have hbit : rowBits (e := e) tau = b.1 := lift2word_injective (e := e) hEq
      have hbad : ¬ boardGood2Full (s0 := s0) (N := N) (rowBits (e := e) tau) := by
        intro hg
        exact b.2 (by rwa [hbit] at hg)
      exact hbad hgood
    · intro hE
      have ht : tau = (fun i => 1 - boardBadFullEnum s0 N e l i) := by funext i; exact hE i
      let b : boardBad2Full s0 N := (Fintype.equivFin (boardBad2Full s0 N)).symm l
      have hl : boardBadFullEnum s0 N e l = lift2word (e := e) b.1 := rfl
      have hre : (fun i => 1 - boardBadFullEnum s0 N e l i) = lift2word (e := e) (fun i => 1 - b.1 i) := by
        funext i
        exact (lift2val_compl e (b.1 i)).symm
      have hEq : lift2word (e := e) (rowBits (e := e) tau) = lift2word (e := e) (fun i => 1 - b.1 i) := by
        calc
          lift2word (e := e) (rowBits (e := e) tau) = tau := lift2word_bit (e := e) tau h01
          _ = (fun i => 1 - boardBadFullEnum s0 N e l i) := ht
          _ = lift2word (e := e) (fun i => 1 - b.1 i) := hre
      have hbit : rowBits (e := e) tau = (fun i => 1 - b.1 i) := lift2word_injective (e := e) hEq
      have hbad : ¬ boardGood2Full (s0 := s0) (N := N) (rowBits (e := e) tau) := by
        intro hg
        have hg1 : boardGood2Full (s0 := s0) (N := N) (fun i => 1 - b.1 i) := by rwa [hbit] at hg
        exact b.2 ((boardGood2Full_reflect b.1).mp hg1)
      exact hbad hgood

end
end Commons.PeriodicTiling


