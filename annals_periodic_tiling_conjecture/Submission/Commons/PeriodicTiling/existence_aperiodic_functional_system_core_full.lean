attribute [local instance] Classical.propDecidable

/-! # Phase 3 encode, layer 2 — the full board (WIP, layer 1 done in dev_encode_start)

Full-board version of the per-row `P_OmegaTilde_gc` of layer 1 (which is 100%
TBD-free).  The full board word has width `K := 2*(s0*N) + 1`, coordinate `0` is the
reflection bit `w*` (the `e`-parity coordinate), and the tiles
`(a,b,n) : Fin 2 x Fin s0 x Fin N` sit at coordinates `1 + idx` where
`idx : TileIdx s0 N ~ Fin (2*(s0*N))` is the width transport proved below.

This file (as of now): the transport `tileFinEquiv`, the board width, the coordinate-0
reading `boardStar`, and the per-tile reading `boardTile` — all TBD-free.  Next:
the full-board good/bad sets and the `P_OmegaTilde_gc` full-board weak-expressibility
statement, unfolding the per-row statements through this transport. -/

/-- The width-transport equivalence `(Fin 2 x Fin s0 x Fin N) ~ Fin (2*(s0*N))`. -/
def tileFinEquiv (s0 N : Nat) : TileIdx s0 N ≃ Fin (2 * (s0 * N)) := by
  let e1 : Fin s0 × Fin N ≃ Fin (s0 * N) := finProdFinEquiv
  let e2 : (Fin 2) × Fin (s0 * N) ≃ Fin (2 * (s0 * N)) := finProdFinEquiv
  exact (Equiv.prodCongr (Equiv.refl (Fin 2)) e1).trans e2

/-- The full board width `2*(s0*N) + 1`. -/
abbrev BoardW (s0 N : Nat) : Nat := 2 * (s0 * N) + 1

/-- The index of a tile inside the full word (strictly positive: tiles come after
coordinate 0). -/
def tileCoord {s0 N : Nat} (t : TileIdx s0 N) : Fin (BoardW s0 N) :=
  ⟨1 + (tileFinEquiv s0 N t).val, by
    have ht : (tileFinEquiv s0 N t).val < 2 * (s0 * N) := (tileFinEquiv s0 N t).isLt
    dsimp [BoardW]
    omega⟩

/-- The reflection bit `w*` of a full word (coordinate 0). -/
def boardStar {s0 N : Nat} {R : Type} (tau : Fin (BoardW s0 N) → R) : R :=
  tau ⟨0, by positivity⟩

/-- The value of a full word at a tile (coordinate `1 + idx(tile)`). -/
def boardTile {s0 N : Nat} {R : Type} (tau : Fin (BoardW s0 N) → R) (t : TileIdx s0 N) : R :=
  tau (tileCoord t)

/-- Tile coordinates are non-zero (they avoid the `w*` coordinate). -/
lemma tileCoord_ne_zero {s0 N : Nat} (t : TileIdx s0 N) : (tileCoord t).val ≠ 0 := by
  dsimp [tileCoord]
  omega

/-- Tile coordinates are strictly below the width. -/
lemma tileCoord_lt {s0 N : Nat} (t : TileIdx s0 N) : (tileCoord t).val < BoardW s0 N :=
  (tileCoord t).isLt

/-- The transport is surjective: every in-board coordinate `1 ≤ k` below the tile
region is the coordinate of some tile. -/
lemma tileFinEquiv_surj {s0 N : Nat} :
    Function.Surjective (fun t : TileIdx s0 N => tileFinEquiv s0 N t) :=
  (tileFinEquiv s0 N).surjective

/-- The transport is injective (so the reading is unambiguous). -/
lemma tileFinEquiv_injective {s0 N : Nat} :
    Function.Injective (fun t : TileIdx s0 N => tileFinEquiv s0 N t) :=
  (tileFinEquiv s0 N).injective


/-! ## Per-row reading through the transport

Unfold the layer-1 row words into the full board: for a full word `tau` and a row
`n`, the `a = 0` (sigma-side) word and the `a = 1` (Sudoku-value-side) word are read
from the tiles `(0, ·, n)` resp. `(1, ·, n)`; `w*` is `boardStar tau` (coordinate 0).
`boardRowGood2` is then exactly the layer-1 `goodColWordRefl` applied to those reads,
so the full-board good set is `forall n, boardRowGood2`. -/

/-- The `a = 0` (sigma-side) word of row `n`, read from a full word. -/
def boardRowWord0 {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) :
    Fin s0 → ZMod 2 :=
  fun b => boardTile tau ((0 : Fin 2), b, n)

/-- The `a = 1` (Sudoku-value-side) word of row `n`, read from a full word. -/
def boardRowWord1 {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) :
    Fin s0 → ZMod 2 :=
  fun b => boardTile tau ((1 : Fin 2), b, n)

/-- Row `n` of a full word is in the good-columns set. -/
def boardRowGood2 {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) : Prop :=
  goodColWordRefl s0 (boardStar tau) (boardRowWord0 tau n) (boardRowWord1 tau n)

/-- The full word is good: every row is. -/
def boardGood2 {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) : Prop :=
  ∀ n : Fin N, boardRowGood2 tau n

/-- The bad full words (complement of the good set in the cube). -/
def boardBad2 (s0 N : Nat) : Set (Fin (BoardW s0 N) → ZMod 2) :=
  {tau | ¬ boardGood2 (s0 := s0) (N := N) tau}



/-! ## Full-board bad enumeration (mirror of rowBadEnum / rowBadEnum_01) -/

/-- The excluded-pair enumeration of the full board: every bad full word, lifted. -/
noncomputable def boardBadEnum (s0 N e : Nat) :
    Fin (Fintype.card (boardBad2 s0 N)) → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) :=
  fun l => lift2word (e := e) (((Fintype.equivFin (boardBad2 s0 N)).symm l).1)

/-- The full-board enumeration is `{0,1}`-valued. -/
lemma boardBadEnum_01 (s0 N e : Nat) :
    ∀ l : Fin (Fintype.card (boardBad2 s0 N)),
      ∀ i : Fin (BoardW s0 N), boardBadEnum s0 N e l i = 0 ∨ boardBadEnum s0 N e l i = 1 := by
  intro l i
  have hbit : ((Fintype.equivFin (boardBad2 s0 N)).symm l).1 i = 0 ∨
              ((Fintype.equivFin (boardBad2 s0 N)).symm l).1 i = 1 :=
    zmod2_eq_zero_or_one _
  rcases hbit with hz | ho
  · left
    dsimp [boardBadEnum, lift2word]
    rw [hz]
    exact lift2val_zero e
  · right
    dsimp [boardBadEnum, lift2word]
    rw [ho]
    exact lift2val_one e

/-! ### Pinned target T4 (full-board `P_OmegaTilde_gc`, WIP: statement, `TBD`)

Instantiation of the sym-bool machinery at the full width `n := s0*N`
(`2*(s0*N)+1` is odd), mirroring layer-1 T2.  All ground facts (encE* order-two /
independence) come from dev_encode_start. -/
theorem OmegaTilde_gc_weakExpressible {d s0 N : Nat} (e : Nat) (he : 1 ≤ e)
    (hs0 : 1 ≤ s0) (hN : 1 ≤ N)
    (gens : Fin d → EncodeG) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (hbig : 4 * (s0 * N) < 2 ^ (e + 1)) :
    WeakExpressible (2 * (s0 * N) + 1)
      (fun alpha : EncodeG → (Fin (2 * (s0 * N) + 1) → ZMod (2 ^ (e + 1))) =>
        sb_POmegaFull encE0 encE1 encE2 (sb_OmegaExcl (boardBadEnum s0 N e)) alpha) := by
  exact sb_POmegaFull_excl_weakExpressible (d := d) (n := s0 * N)
    (L := Fintype.card (boardBad2 s0 N)) e he (by simpa using (Nat.mul_le_mul hs0 hN) : 1 ≤ s0 * N) encE0 encE1 encE2
    encE0_two_zsmul encE1_two_zsmul encE2_two_zsmul encE_independent gens hpos hspan
    hbig (boardBadEnum s0 N e) (boardBadEnum_01 s0 N e)



/-! ## Full-board set identity (mirror of layer-1 T3)

`sb_OmegaExcl` of the full-board bad enumeration equals the full-board good set on
`{0,1}`-valued words.  The per-row reflection invariance `rowGood2_reflect` lifts to
rows (`boardRowGood2_reflect`) and then to the whole board (`boardGood2_reflect`),
which makes the double exclusion `{epsilon l, 1 - epsilon l}` collapse; the rest of the
proof mirrors T3 word-for-word at width `BoardW s0 N`. -/

/-- The full-board enumeration covers every bad word. -/
lemma boardBadEnum_surj (s0 N e : Nat) (b : boardBad2 s0 N) :
    ∃ l : Fin (Fintype.card (boardBad2 s0 N)), boardBadEnum s0 N e l = lift2word (e := e) b.1 := by
  refine ⟨Fintype.equivFin (boardBad2 s0 N) b, ?_⟩
  dsimp [boardBadEnum]
  have hb : (Fintype.equivFin (boardBad2 s0 N)).symm (Fintype.equivFin (boardBad2 s0 N) b) = b := by simp
  rw [hb]

/-- Complementing a full word reflects each row's good condition. -/
lemma boardRowGood2_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) (n : Fin N) :
    boardRowGood2 (fun i => 1 - tau i) n ↔ boardRowGood2 tau n := by
  unfold boardRowGood2
  have hstar : boardStar (fun i => 1 - tau i) = 1 - boardStar tau := rfl
  have hw0 : boardRowWord0 (fun i => 1 - tau i) n = fun b => 1 - boardRowWord0 tau n b := rfl
  have hw1 : boardRowWord1 (fun i => 1 - tau i) n = fun b => 1 - boardRowWord1 tau n b := rfl
  rw [hstar, hw0, hw1]
  exact goodColWordRefl_compl s0 (boardStar tau) (boardRowWord0 tau n) (boardRowWord1 tau n)

/-- Complementing a full word preserves whether the whole board is good. -/
lemma boardGood2_reflect {s0 N : Nat} (tau : Fin (BoardW s0 N) → ZMod 2) :
    boardGood2 (s0 := s0) (N := N) (fun i => 1 - tau i) ↔ boardGood2 (s0 := s0) (N := N) tau := by
  unfold boardGood2
  constructor
  · intro h n
    exact (boardRowGood2_reflect tau n).mp (h n)
  · intro h n
    exact (boardRowGood2_reflect tau n).mpr (h n)

/-! ## Axiom (c): row-0 boolean periodized permutation through the transport

Paper axiom (c) (tex 1171): for each row `n`, the tuple `(alpha_{0,0,n}, ...,
alpha_{0,s0-1,n})` is a boolean periodized permutation in the direction
`((1,0),(0,0,0))` (= `encX`).  As a property of the full-tuple function this is the
same property applied to the selected sub-tuple `row0Sel alpha n`, read from the
tiles `(0, b, n)`.  `selRow0` is that selection; the permutation-bijection part is
expressible by `expressible_select` (this file proves it TBD-free); the full
`BoolPeriodizedPerm` (which also carries `CompBool`) is pinned below (it needs the
weak-level selection lemma for `CompBool`, to be added next). -/

/-- The `(1,0)` direction of the plane part of `EncodeG`. -/
def encX : EncodeG := (((1 : Int), (0 : Int)), fun _ : Fin 3 => 0)

/-- The `a = 0` tile coordinates of a row, as a selection into the full word. -/
def selRow0 {s0 N : Nat} (n : Fin N) : Fin s0 → Fin (BoardW s0 N) :=
  fun b => tileCoord ((0 : Fin 2), b, n)

/-- The extracted `(alpha_{0,·,n})` sub-tuple of a full-tuple function. -/
def row0Sel {e s0 N : Nat}
    (alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))))
    (n : Fin N) : EncodeG → (Fin s0 → ZMod (2 ^ (e + 1))) :=
  fun x b => alpha x (selRow0 n b)

/-- The tile-coordinate map is injective. -/
lemma tileCoord_injective {s0 N : Nat} :
    Function.Injective (tileCoord (s0 := s0) (N := N)) := by
  intro a b h
  have hv : (tileCoord a).val = (tileCoord b).val := congrArg Fin.val h
  have hf : tileFinEquiv s0 N a = tileFinEquiv s0 N b := by
    apply Fin.ext
    dsimp [tileCoord] at hv
    omega
  exact (tileFinEquiv_injective (s0 := s0) (N := N)) hf

/-- The row-0 selection is injective (different `b` read different coordinates). -/
lemma selRow0_injective {s0 N : Nat} (n : Fin N) :
    Function.Injective (selRow0 (s0 := s0) (N := N) n) := by
  intro b1 b2 h
  have ht := tileCoord_injective (s0 := s0) (N := N) h
  have hb := congrArg (fun t : TileIdx s0 N => t.2.1) ht
  exact hb

/-- The permutation-bijection part of axiom (c) is weakly expressible (via
`expressible_select` of `permBijective_expressible`). -/
lemma row0_permBijective_weakExpressible {e s0 N : Nat} (n : Fin N) :
    WeakExpressible (BoardW s0 N)
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        permBijective e s0 encX (row0Sel (e := e) alpha n)) := by
  have hEx : ExpressibleProperty
      (fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
        permBijective e s0 encX (row0Sel (e := e) alpha n)) := by
    exact expressible_select (R := selRow0 (s0 := s0) (N := N) n)
      (selRow0_injective (s0 := s0) (N := N) n) (permBijective_expressible e s0 encX)
  exact expressible_weak (K := BoardW s0 N)
    (P := fun alpha : EncodeG → (Fin (BoardW s0 N) → ZMod (2 ^ (e + 1))) =>
      permBijective e s0 encX (row0Sel (e := e) alpha n)) hEx

/-! ## Generic selection lift through weak expressibility

`weakExpressible_select` carries a weakly expressible property of `Fin K`-tuples
through an injective coordinate selection `R : Fin K → Fin L` to a weakly expressible
property of `Fin L`-tuples.  This is the paper's "lift" operation restricted to the
coordinates selected by `R`; it is the load-bearing wall under axiom (c) (T6) and the
`S`-assembly.  The construction extends `R` over the existential witness block by the
identity (`selectLift`), so the expressible witness property pulls back by
`expressible_select`. -/

/-- Extend an injective selection `R : Fin K → Fin L` to the appended width
`Fin (K + M) → Fin (L + M)`: `R` on the first block, identity on the tail. -/
def selectLift {K L M : Nat} (R : Fin K → Fin L) : Fin (K + M) → Fin (L + M) :=
  fun j => if h : j.val < K then
      Fin.castAdd M (R ⟨j.val, h⟩)
    else
      Fin.natAdd L ⟨j.val - K, by omega⟩

/-- `selectLift` on a small index reads the `R`-coordinate. -/
lemma selectLift_lt {K L M : Nat} (R : Fin K → Fin L) {j : Fin (K + M)} (h : j.val < K) :
    selectLift (K := K) (L := L) (M := M) R j = Fin.castAdd M (R ⟨j.val, h⟩) := by
  simp [selectLift, h]

/-- `selectLift` on a large index is the identity on the tail block. -/
lemma selectLift_ge {K L M : Nat} (R : Fin K → Fin L) {j : Fin (K + M)}
    (h : ¬ j.val < K) :
    selectLift (K := K) (L := L) (M := M) R j = Fin.natAdd L ⟨j.val - K, by omega⟩ := by
  simp [selectLift, h]

/-- `selectLift` is injective whenever `R` is. -/
lemma selectLift_injective {K L M : Nat} (R : Fin K → Fin L)
    (hR : Function.Injective R) :
    Function.Injective (selectLift (K := K) (L := L) (M := M) R) := by
  intro a b h
  have hv : (selectLift (K := K) (L := L) (M := M) R a).val =
      (selectLift (K := K) (L := L) (M := M) R b).val := congrArg Fin.val h
  by_cases ha : a.val < K
  · by_cases hb : b.val < K
    · have hva : (selectLift (K := K) (L := L) (M := M) R a).val = (R ⟨a.val, ha⟩).val := by
        rw [selectLift_lt R ha]
        simp
      have hvb : (selectLift (K := K) (L := L) (M := M) R b).val = (R ⟨b.val, hb⟩).val := by
        rw [selectLift_lt R hb]
        simp
      have hRval : (R ⟨a.val, ha⟩).val = (R ⟨b.val, hb⟩).val := by
        rw [hva, hvb] at hv
        exact hv
      have hReq : R ⟨a.val, ha⟩ = R ⟨b.val, hb⟩ := Fin.ext hRval
      have hsub : (⟨a.val, ha⟩ : Fin K) = (⟨b.val, hb⟩ : Fin K) := hR hReq
      have hval : a.val = b.val := congrArg (fun t : Fin K => t.val) hsub
      exact Fin.ext hval
    · exfalso
      have hva : (selectLift (K := K) (L := L) (M := M) R a).val < L := by
        rw [selectLift_lt R ha]
        exact (R ⟨a.val, ha⟩).isLt
      have hvb : L ≤ (selectLift (K := K) (L := L) (M := M) R b).val := by
        rw [selectLift_ge R hb]
        simp
      have hsmall : (selectLift (K := K) (L := L) (M := M) R b).val < L := by
        rwa [hv] at hva
      omega
  · by_cases hb : b.val < K
    · exfalso
      have hvb : (selectLift (K := K) (L := L) (M := M) R b).val < L := by
        rw [selectLift_lt R hb]
        exact (R ⟨b.val, hb⟩).isLt
      have hva : L ≤ (selectLift (K := K) (L := L) (M := M) R a).val := by
        rw [selectLift_ge R ha]
        simp
      have hsmall : (selectLift (K := K) (L := L) (M := M) R a).val < L := by
        rwa [← hv] at hvb
      omega
    · have hva : (selectLift (K := K) (L := L) (M := M) R a).val = L + (a.val - K) := by
        rw [selectLift_ge R ha]
        simp
      have hvb : (selectLift (K := K) (L := L) (M := M) R b).val = L + (b.val - K) := by
        rw [selectLift_ge R hb]
        simp
      have hdiff : a.val - K = b.val - K := by omega
      have hval : a.val = b.val := by omega
      exact Fin.ext hval

/-- Appending and then reading through `selectLift` equals appending the selected word. -/
lemma selectLift_append {K L M : Nat} (R : Fin K → Fin L) {H : Type*}
    (alpha : Fin L → H) (beta : Fin M → H) :
    (fun j : Fin (K + M) => Fin.append alpha beta (selectLift (K := K) (L := L) (M := M) R j)) =
      Fin.append (fun k : Fin K => alpha (R k)) beta := by
  funext j
  by_cases h : j.val < K
  · have hj : j = Fin.castAdd M (⟨j.val, h⟩ : Fin K) := by
      apply Fin.ext
      simp
    rw [hj]
    have hlt : (Fin.castAdd M (⟨j.val, h⟩ : Fin K)).val < K := by simpa using h
    have hl : selectLift (K := K) (L := L) (M := M) R (Fin.castAdd M (⟨j.val, h⟩ : Fin K)) =
        Fin.castAdd M (R (⟨j.val, h⟩ : Fin K)) := by
      rw [selectLift_lt (K := K) (L := L) (M := M) R (j := Fin.castAdd M (⟨j.val, h⟩ : Fin K)) hlt]
      apply congrArg (fun i : Fin K => Fin.castAdd M (R i))
      apply Fin.ext
      simp
    rw [hl]
    calc
      Fin.append alpha beta (Fin.castAdd M (R (⟨j.val, h⟩ : Fin K)))
          = alpha (R (⟨j.val, h⟩ : Fin K)) := Fin.append_left alpha beta (R (⟨j.val, h⟩ : Fin K))
      _ = (fun k : Fin K => alpha (R k)) (⟨j.val, h⟩ : Fin K) := rfl
      _ = Fin.append (fun k : Fin K => alpha (R k)) beta (Fin.castAdd M (⟨j.val, h⟩ : Fin K)) :=
          (Fin.append_left (fun k : Fin K => alpha (R k)) beta (⟨j.val, h⟩ : Fin K)).symm
  · have hj : j = Fin.natAdd K (⟨j.val - K, by omega⟩ : Fin M) := by
      apply Fin.ext
      simp
      omega
    rw [hj]
    have hge : ¬ (Fin.natAdd K (⟨j.val - K, by omega⟩ : Fin M) : Fin (K + M)).val < K := by
      simp
    have hl : selectLift (K := K) (L := L) (M := M) R (Fin.natAdd K (⟨j.val - K, by omega⟩ : Fin M)) =
        Fin.natAdd L (⟨j.val - K, by omega⟩ : Fin M) := by
      rw [selectLift_ge (K := K) (L := L) (M := M) R (j := Fin.natAdd K (⟨j.val - K, by omega⟩ : Fin M)) hge]
      apply congrArg (fun i : Fin M => Fin.natAdd L i)
      apply Fin.ext
      simp
    rw [hl]
    calc
      Fin.append alpha beta (Fin.natAdd L (⟨j.val - K, by omega⟩ : Fin M))
          = beta (⟨j.val - K, by omega⟩ : Fin M) := Fin.append_right alpha beta (⟨j.val - K, by omega⟩ : Fin M)
      _ = Fin.append (fun k : Fin K => alpha (R k)) beta (Fin.natAdd K (⟨j.val - K, by omega⟩ : Fin M)) :=
          (Fin.append_right (fun k : Fin K => alpha (R k)) beta (⟨j.val - K, by omega⟩ : Fin M)).symm

/-! Pinned target T7 (generic selection lift, WIP: statement, `TBD`). -/
lemma weakExpressible_select {e K L : Nat} (R : Fin K → Fin L) (hR : Function.Injective R)
    {P : (EncodeG → (Fin K → ZMod (2 ^ (e + 1)))) → Prop}
    (hP : WeakExpressible K P) :
    WeakExpressible L
      (fun alpha : EncodeG → (Fin L → ZMod (2 ^ (e + 1))) =>
        P (fun x : EncodeG => fun k : Fin K => alpha x (R k))) := by
  rcases hP with ⟨M, Pstar, hEx, hiff⟩
  let Qstar : (EncodeG → (Fin (L + M) → ZMod (2 ^ (e + 1)))) → Prop :=
    fun gamma => Pstar (fun x : EncodeG => fun j : Fin (K + M) =>
      gamma x (selectLift (K := K) (L := L) (M := M) R j))
  have hQEx : ExpressibleProperty Qstar := by
    exact expressible_select (R := selectLift (K := K) (L := L) (M := M) R)
      (selectLift_injective (K := K) (L := L) (M := M) R hR) hEx
  have hQ : ∀ alpha : EncodeG → (Fin L → ZMod (2 ^ (e + 1))),
      P (fun x : EncodeG => fun k : Fin K => alpha x (R k)) ↔
        ∃ beta : EncodeG → (Fin M → ZMod (2 ^ (e + 1))),
          Qstar (fun x : EncodeG => Fin.append (alpha x) (beta x)) := by
    intro alpha
    have hiffA := hiff (fun x : EncodeG => fun k : Fin K => alpha x (R k))
    have hstep : ∀ beta : EncodeG → (Fin M → ZMod (2 ^ (e + 1))),
        Pstar (fun x : EncodeG => Fin.append (fun k : Fin K => alpha x (R k)) (beta x)) ↔
          Qstar (fun x : EncodeG => Fin.append (alpha x) (beta x)) := by
      intro beta
      unfold Qstar
      have hArg : (fun x : EncodeG => fun j : Fin (K + M) =>
          Fin.append (alpha x) (beta x) (selectLift (K := K) (L := L) (M := M) R j)) =
          (fun x : EncodeG => Fin.append (fun k : Fin K => alpha x (R k)) (beta x)) := by
        funext x
        exact selectLift_append (K := K) (L := L) (M := M) R (alpha x) (beta x)
      rw [← hArg]
    exact hiffA.trans (by
      constructor
      · intro h
        rcases h with ⟨a0, ha0⟩
        refine ⟨a0, (hstep a0).mp ha0⟩
      · intro h
        rcases h with ⟨a0, ha0⟩
        refine ⟨a0, (hstep a0).mpr ha0⟩)
  refine ⟨M, Qstar, hQEx, ?_⟩
  intro alpha
  exact hQ alpha



