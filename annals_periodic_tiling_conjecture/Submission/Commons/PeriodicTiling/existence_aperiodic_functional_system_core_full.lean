attribute [local instance] Classical.propDecidable

/-! # Near-digit 9.4 — prerequisites (stats (iv): InScal ⇒ reduced qLine on finite rows)

Proposition near-digit (tex 1341) needs every *board line* `g(n) = F(n, jn+i)` (an
`InScal_q (2^t) N` row function) to be fed to `rigid_out_reduced` as an exact reduced
`qLine (2^t) a b`.  This is Lemma "stats" (iv) for row functions.  Its heart is the
`f_q` shift invariance developed here:

  `f_q(w + q^R·m) = f_q(w)`  whenever  `¬ q^R ∣ w`   (natural arguments)

— the case `q | w` (with exponent `< R`) reduces by pulling out `q`; the case `q ∤ w`
is congruence modulo `q`.  The integer form (with the divisibility hypothesis deduced
from `|w| < q^R`) powers the construction `(a', b') := (c a, c b + q^R c)` which makes
the representative argument nonzero on the (finite) row window so that the odd factor
`c` can be absorbed everywhere (see STATUS_NOTES). -/

/-- Natural `f_q` is invariant under adding a large power of `q` (`q^R`) times anything,
provided `q^R` does not divide `n` (i.e. the `q`-adic exponent of `n` is `< R`). -/
lemma fqOnNat_invar_add (q : ℕ) (hq : 1 < q) :
    ∀ n : ℕ, ∀ R : ℕ, 1 ≤ R → ∀ m : ℕ, ¬ q ^ R ∣ n →
      fqOnNat q (n + q ^ R * m) = fqOnNat q n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro R hR m hn
      have hq0 : q ≠ 0 := by omega
      have hq2 : 2 ≤ q := by omega
      by_cases hqdiv : q ∣ n
      · -- q | n: pull q out of both sides and recurse at n/q with exponent R−1
        rcases hqdiv with ⟨n1, hn_eq⟩
        have hn0 : n ≠ 0 := by
          intro hz
          apply hn
          rw [hz]
          exact dvd_zero (q ^ R)
        have hn10 : n1 ≠ 0 := by
          intro hz
          subst n1
          apply hn0
          rw [hn_eq]
          simp
        have hlt : n1 < n := by
          have hn1pos : 0 < n1 := Nat.pos_of_ne_zero hn10
          rw [hn_eq]
          nlinarith
        have hRge2 : 2 ≤ R := by
          by_contra hnot
          have hR1 : R = 1 := by omega
          apply hn
          rw [hR1, hn_eq]
          exact ⟨n1, by ring⟩
        have hqpow : q ^ R = q * q ^ (R - 1) := by
          rw [← pow_succ']
          congr 1
          omega
        have hn1 : ¬ q ^ (R - 1) ∣ n1 := by
          intro hd
          apply hn
          rw [hn_eq, hqpow]
          exact (Nat.mul_dvd_mul_iff_left (by omega : 0 < q)).mpr hd
        have hrec := ih n1 hlt (R - 1) (by omega) m hn1
        calc
          fqOnNat q (n + q ^ R * m) = fqOnNat q (q * n1 + q ^ R * m) := by rw [hn_eq]
          _ = fqOnNat q (q * (n1 + q ^ (R - 1) * m)) := by rw [hqpow]; ring_nf
          _ = fqOnNat q (n1 + q ^ (R - 1) * m) := fqOnNat_mul_q hq0 _
          _ = fqOnNat q n1 := hrec
          _ = fqOnNat q (q * n1) := (fqOnNat_mul_q hq0 _).symm
          _ = fqOnNat q n := by rw [hn_eq]
      · -- q ∤ n: both sides equal the reduction modulo q
        have hqpowdiv : q ∣ q ^ R := by
          refine ⟨q ^ (R - 1), ?_⟩
          rw [← pow_succ']
          congr 1
          omega
        have hqmul : q ∣ q ^ R * m := by rw [mul_comm]; exact dvd_mul_of_dvd_right hqpowdiv m
        have hnmod : n % q ≠ 0 := by
          intro hz
          exact hqdiv (Nat.dvd_iff_mod_eq_zero.mpr hz)
        have hqadd : ¬ q ∣ n + q ^ R * m := by
          intro hd
          have h0 : (n + q ^ R * m) % q = 0 := Nat.dvd_iff_mod_eq_zero.mp hd
          have hmod : (n + q ^ R * m) % q = n % q := by
            calc (n + q ^ R * m) % q = (n % q + (q ^ R * m) % q) % q := by rw [Nat.add_mod]
              _ = (n % q + 0) % q := by rw [Nat.mod_eq_zero_of_dvd hqmul]
              _ = n % q := by rw [add_zero, Nat.mod_mod]
          exact hnmod (by rwa [← hmod])
        have h1 : fqOnNat q (n + q ^ R * m) = ((n + q ^ R * m : ℕ) : ZMod q) :=
          fqOnNat_eq_self_of_not_dvd hqadd
        have h2 : ((n + q ^ R * m : ℕ) : ZMod q) = (n : ZMod q) := by
          have hqRm : ((q ^ R * m : ℕ) : ZMod q) = 0 :=
            (ZMod.natCast_eq_zero_iff (q ^ R * m) q).mpr hqmul
          rw [Nat.cast_add, hqRm]
          simp
        have h3 : fqOnNat q n = (n : ZMod q) := fqOnNat_eq_self_of_not_dvd hqdiv
        calc
          fqOnNat q (n + q ^ R * m) = ((n + q ^ R * m : ℕ) : ZMod q) := h1
          _ = (n : ZMod q) := h2
          _ = fqOnNat q n := h3.symm

/-- Pulling out `q`-powers is allowed for natural `f_q`: `f_q(q^k · x) = f_q(x)`. -/
lemma fqOnNat_pow_mul_q {q k : ℕ} (hq : q ≠ 0) (x : ℕ) :
    fqOnNat q (q ^ k * x) = fqOnNat q x := by
  induction k with
  | zero =>
      simp
  | succ k ih =>
      calc
        fqOnNat q (q ^ (k + 1) * x) = fqOnNat q (q * (q ^ k * x)) := by
            rw [pow_succ]
            ring
        _ = fqOnNat q (q ^ k * x) := fqOnNat_mul_q hq _
        _ = fqOnNat q x := ih

/-! ## Integer `f_q` shift invariance

`fq q (w + q^R·m) = fq q w` whenever `q^R ∤ w` (`w ≠ 0`, `1 ≤ R`): mirror the natural
proof at the `ℤ` level by well-founded induction on `w.natAbs` — if `q ∣ w`, pull `q`
out of both sides (`fq_qmul_int`) and recurse at `w/q` with exponent `R−1`; if `q ∤ w`,
both sides equal the reduction modulo `q` (`fq_eq_self_of_not_dvd_int`).  The magnitude
form `|w| < q^R` implies `q^R ∤ w`, which is how the lemma is invoked in stats-(iv). -/

/-- Integer `f_q` is invariant under adding `q^R` times an integer, provided `q^R` does
not divide `w`. -/
lemma fq_invar_add_int (q : ℕ) (hq : 1 < q) : ∀ n : ℕ, ∀ w : ℤ, w.natAbs = n → ∀ R : ℕ,
    1 ≤ R → ∀ m : ℤ, w ≠ 0 → ¬ ((q ^ R : ℕ) : ℤ) ∣ w →
    fq q (w + ((q ^ R : ℕ) : ℤ) * m) = fq q w := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro w hwabs R hR m hw hd
      have hq0 : (q : ℕ) ≠ 0 := by omega
      have hqpow : ((q ^ R : ℕ) : ℤ) = (q : ℤ) * ((q ^ (R - 1) : ℕ) : ℤ) := by
        rw [← Nat.cast_mul]
        congr 1
        rw [← pow_succ']
        congr 1
        omega
      by_cases hqdiv : (q : ℤ) ∣ w
      · -- q | w: pull q out of both sides and recurse at w/q with exponent R−1
        rcases hqdiv with ⟨w1, hw_eq⟩
        have hw10 : w1 ≠ 0 := by
          intro hz
          apply hw
          calc
            w = (q : ℤ) * w1 := hw_eq
            _ = 0 := by rw [hz]; ring
        have hw1lt : w1.natAbs < n := by
          have hq2 : 2 ≤ q := by omega
          have hwm : w.natAbs = (q : ℕ) * w1.natAbs := by
            rw [hw_eq, Int.natAbs_mul]
            simp
          have hw1pos : 0 < w1.natAbs := Nat.pos_of_ne_zero (by
            intro hz
            exact hw10 (Int.natAbs_eq_zero.mp hz))
          rw [← hwabs]
          nlinarith
        have hRge2 : 2 ≤ R := by
          by_contra hnot
          have hR1 : R = 1 := by omega
          apply hd
          rw [hR1]
          simp
          exact ⟨w1, hw_eq⟩
        have hw1d : ¬ ((q ^ (R - 1) : ℕ) : ℤ) ∣ w1 := by
          intro hd1
          apply hd
          rw [hw_eq, hqpow]
          rcases hd1 with ⟨k, hk⟩
          refine ⟨k, ?_⟩
          calc
            (q : ℤ) * w1 = (q : ℤ) * (((q ^ (R - 1) : ℕ) : ℤ) * k) := by rw [hk]
            _ = ((q : ℤ) * ((q ^ (R - 1) : ℕ) : ℤ)) * k := by ring
        have hrec := ih w1.natAbs hw1lt w1 rfl (R - 1) (by omega) m hw10 hw1d
        calc
          fq q (w + ((q ^ R : ℕ) : ℤ) * m) = fq q ((q : ℤ) * w1 + ((q ^ R : ℕ) : ℤ) * m) := by rw [hw_eq]
          _ = fq q ((q : ℤ) * (w1 + ((q ^ (R - 1) : ℕ) : ℤ) * m)) := by rw [hqpow]; ring_nf
          _ = fq q (w1 + ((q ^ (R - 1) : ℕ) : ℤ) * m) := fq_qmul_int hq0 _
          _ = fq q w1 := hrec
          _ = fq q ((q : ℤ) * w1) := (fq_qmul_int hq0 w1).symm
          _ = fq q w := by rw [hw_eq]
      · -- q ∤ w: both sides equal the reduction modulo q
        have hqRm : (q : ℤ) ∣ ((q ^ R : ℕ) : ℤ) * m := by
          rw [hqpow]
          refine ⟨((q ^ (R - 1) : ℕ) : ℤ) * m, ?_⟩
          ring_nf
        have hqadd : ¬ (q : ℤ) ∣ w + ((q ^ R : ℕ) : ℤ) * m := by
          intro hd
          apply hqdiv
          have hsub : (q : ℤ) ∣ (w + ((q ^ R : ℕ) : ℤ) * m) - ((q ^ R : ℕ) : ℤ) * m := dvd_sub hd hqRm
          convert hsub using 1 <;> ring
        have h1 : fq q (w + ((q ^ R : ℕ) : ℤ) * m) =
            ((w + ((q ^ R : ℕ) : ℤ) * m : ℤ) : ZMod q) :=
          fq_eq_self_of_not_dvd_int hq hqadd
        have hqRm0 : ((((q ^ R : ℕ) : ℤ) * m : ℤ) : ZMod q) = 0 :=
          (ZMod.intCast_zmod_eq_zero_iff_dvd (((q ^ R : ℕ) : ℤ) * m) q).mpr hqRm
        have h2 : ((w + ((q ^ R : ℕ) : ℤ) * m : ℤ) : ZMod q) = (w : ZMod q) := by
          rw [Int.cast_add, hqRm0]
          simp
        have h3 : fq q w = (w : ZMod q) := fq_eq_self_of_not_dvd_int hq hqdiv
        calc
          fq q (w + ((q ^ R : ℕ) : ℤ) * m) = ((w + ((q ^ R : ℕ) : ℤ) * m : ℤ) : ZMod q) := h1
          _ = (w : ZMod q) := h2
          _ = fq q w := h3.symm

/-- Magnitude form: if `0 < |w| < q^R` then `q^R ∤ w`, so the shift invariance applies. -/
lemma fq_invar_add_int_mag {q R : ℕ} (hq : 1 < q) (hR : 1 ≤ R) {w m : ℤ}
    (hw : w ≠ 0) (hwlt : (w.natAbs : ℤ) < ((q ^ R : ℕ) : ℤ)) :
    fq q (w + ((q ^ R : ℕ) : ℤ) * m) = fq q w := by
  have hd : ¬ ((q ^ R : ℕ) : ℤ) ∣ w := by
    intro h
    rcases h with ⟨k, hk⟩
    have hk0 : k ≠ 0 := by
      intro hz
      apply hw
      calc
        w = ((q ^ R : ℕ) : ℤ) * k := hk
        _ = 0 := by rw [hz]; ring
    have hkab0 : k.natAbs ≠ 0 := by
      intro hz
      apply hk0
      exact Int.natAbs_eq_zero.mp hz
    have hwabs : w.natAbs = q ^ R * k.natAbs := by
      rw [hk, Int.natAbs_mul]
      simp
    have hkn1 : 1 ≤ k.natAbs := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hkab0)
    have hge : q ^ R ≤ w.natAbs := by
      rw [hwabs]
      calc q ^ R = q ^ R * 1 := by rw [mul_one]
        _ ≤ q ^ R * k.natAbs := Nat.mul_le_mul_left (q ^ R) hkn1
    have hlt : w.natAbs < q ^ R := by exact_mod_cast hwlt
    omega
  exact fq_invar_add_int q hq w.natAbs w rfl R hR m hw hd

/-! ## Common `q`-power reduction and the stats-(iv) bridge

Every `InScal_q q N` row function `g` (with representative `(a₀,b₀,c)`, `c` odd) is shown
to equal `qLine q a b` on the rows for a *reduced* pair `(a,b)` (`¬ (q ∣ a ∧ q ∣ b)`):
first divide common `q`-powers out of `(a₀,b₀)` (`q_reduce_pair`, using `fq q (q·z) = fq q z`),
then absorb the odd factor `c` via the `q^R`-shift trick of Lemma "stats" (iv)
(`fq_invar_add_int_mag` off the unique zero row, `fq q (q^R·c) = fq q c = c` on it). -/

/-- `q ∣ 1` is impossible when `1 < q`. -/
lemma not_dvd_one_of_one_lt {q : ℕ} (hq : 1 < q) : ¬ (q : ℤ) ∣ (1 : ℤ) := by
  intro h
  rcases h with ⟨k, hk⟩
  have hm : (1 : ℤ).natAbs = ((q : ℤ) * k).natAbs := by rw [← hk]
  rw [Int.natAbs_mul] at hm
  simp at hm
  have hqdiv : q ∣ 1 := by
    refine ⟨k.natAbs, ?_⟩
    omega
  have hq1 : q ≤ 1 := Nat.le_of_dvd (by norm_num : 0 < 1) hqdiv
  omega

/-- Well-founded helper for `q_reduce_pair` (measure: `a.natAbs + b.natAbs`). -/
lemma q_reduce_pair_aux (q : ℕ) (hq : 1 < q) :
    ∀ S : ℕ, ∀ a b : ℤ, a.natAbs + b.natAbs = S → ∃ a' b' : ℤ,
      ¬ ((q : ℤ) ∣ a' ∧ (q : ℤ) ∣ b') ∧
        ∀ n : ℤ, fq q (a * n + b) = fq q (a' * n + b') := by
  intro S
  induction S using Nat.strong_induction_on with
  | h S ih =>
      intro a b habs
      by_cases hb : (q : ℤ) ∣ a ∧ (q : ℤ) ∣ b
      · by_cases hz : a = 0 ∧ b = 0
        · -- both zero: represent the constant function `f_q(0) = 1` as `f_q(1)`
          have hred : ¬ ((q : ℤ) ∣ (0 : ℤ) ∧ (q : ℤ) ∣ (1 : ℤ)) := by
            intro h
            exact not_dvd_one_of_one_lt hq h.2
          have hf1 : fq q (1 : ℤ) = 1 := by
            have hqnd : ¬ q ∣ 1 := by
              intro hd
              have hq1 : q ≤ 1 := Nat.le_of_dvd (by norm_num : 0 < 1) hd
              omega
            have h1 := fqOnNat_eq_self_of_not_dvd (q := q) hqnd
            simpa [fq] using h1
          refine ⟨0, 1, hred, ?_⟩
          intro n
          simp [hz.1, hz.2]
          exact hf1.symm
        · -- divide the common factor q out and recurse
          rcases hb with ⟨haq, hbq⟩
          rcases haq with ⟨a₁, ha₁⟩
          rcases hbq with ⟨b₁, hb₁⟩
          have hS : S = (q : ℕ) * (a₁.natAbs + b₁.natAbs) := by
            rw [← habs]
            have h1 : a.natAbs = (q : ℕ) * a₁.natAbs := by
              rw [ha₁, Int.natAbs_mul]
              simp
            have h2 : b.natAbs = (q : ℕ) * b₁.natAbs := by
              rw [hb₁, Int.natAbs_mul]
              simp
            rw [h1, h2]
            ring
          have hz' : ¬ (a₁ = 0 ∧ b₁ = 0) := by
            intro h
            apply hz
            constructor
            · rw [ha₁, h.1]
              ring
            · rw [hb₁, h.2]
              ring
          have hlt : a₁.natAbs + b₁.natAbs < S := by
            rw [hS]
            have hq2 : 2 ≤ q := by omega
            have hs1 : 1 ≤ a₁.natAbs + b₁.natAbs := by
              by_contra hnot
              have hsum0 : a₁.natAbs + b₁.natAbs = 0 := by omega
              have ha0 : a₁.natAbs = 0 := by omega
              have hb0 : b₁.natAbs = 0 := by omega
              apply hz'
              exact ⟨Int.natAbs_eq_zero.mp ha0, Int.natAbs_eq_zero.mp hb0⟩
            nlinarith
          have hrec := ih (a₁.natAbs + b₁.natAbs) hlt a₁ b₁ rfl
          rcases hrec with ⟨a', b', hred', hval'⟩
          refine ⟨a', b', hred', ?_⟩
          intro n
          calc
            fq q (a * n + b) = fq q ((q : ℤ) * (a₁ * n + b₁)) := by
                rw [ha₁, hb₁]
                ring
            _ = fq q (a₁ * n + b₁) := fq_qmul_int (by omega : (q : ℕ) ≠ 0) _
            _ = fq q (a' * n + b') := hval' n
      · -- already reduced
        exact ⟨a, b, hb, fun n => rfl⟩

/-- Every integer pair `(a,b)` is `f_q(a·n+b)`-equivalent to a reduced pair `(a',b')`
(`¬ (q ∣ a' ∧ q ∣ b')`), by dividing out the common `q`-powers. -/
lemma q_reduce_pair (q : ℕ) (hq : 1 < q) : ∀ a b : ℤ, ∃ a' b' : ℤ,
    ¬ ((q : ℤ) ∣ a' ∧ (q : ℤ) ∣ b') ∧
      ∀ n : ℤ, fq q (a * n + b) = fq q (a' * n + b') := by
  intro a b
  exact q_reduce_pair_aux q hq (a.natAbs + b.natAbs) a b rfl

/-- `n < 2^n` for all `n`. -/
lemma nat_lt_two_pow (n : ℕ) : n < 2 ^ n := by
  induction n with
  | zero => norm_num
  | succ n ih =>
      have hle : n + 1 ≤ 2 ^ n := Nat.succ_le_of_lt ih
      have hpos : 0 < 2 ^ n := pow_pos (by norm_num : 0 < 2) n
      calc
        n + 1 ≤ 2 ^ n := hle
        _ < 2 ^ n + 2 ^ n := by omega
        _ = 2 * 2 ^ n := by rw [two_mul]
        _ = 2 ^ (n + 1) := by rw [← pow_succ']

/-- `f_q(q^k · z) = f_q(z)` on all integers (pull out base-`q` powers). -/
lemma fq_qpow_mul_int {q : ℕ} (hq : q ≠ 0) : ∀ k : ℕ, ∀ z : ℤ,
    fq q (((q ^ k : ℕ) : ℤ) * z) = fq q z := by
  intro k
  induction k with
  | zero =>
      intro z
      simp
  | succ k ih =>
      intro z
      calc
        fq q (((q ^ (k + 1) : ℕ) : ℤ) * z) = fq q ((q : ℤ) * (((q ^ k : ℕ) : ℤ) * z)) := by
            have hc : (((q ^ (k + 1) : ℕ) : ℤ)) = (q : ℤ) * ((q ^ k : ℕ) : ℤ) := by
              rw [← Nat.cast_mul]
              congr 1
              rw [pow_succ]
              rw [Nat.mul_comm]
            rw [hc]
            ring
        _ = fq q (((q ^ k : ℕ) : ℤ) * z) := fq_qmul_int hq _
        _ = fq q z := ih z

/-- Magnitude of a linear value on the finite rows `{1..N}` is bounded by `|a|·N + |b|`. -/
lemma linear_row_mag_bound {N : ℕ} (a b x : ℤ) (hx : x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)) :
    (a * x + b).natAbs ≤ a.natAbs * N + b.natAbs := by
  have hx1 : 1 ≤ x := (Finset.mem_Icc.mp hx).1
  have hxN : x ≤ (N : ℤ) := (Finset.mem_Icc.mp hx).2
  have hxnonneg : 0 ≤ x := by omega
  have hxabs : x.natAbs ≤ N := by
    have hcast : (x.natAbs : ℤ) = x := Int.natAbs_of_nonneg hxnonneg
    have hz : (x.natAbs : ℤ) ≤ (N : ℤ) := by rw [hcast]; exact hxN
    exact_mod_cast hz
  calc
    (a * x + b).natAbs ≤ (a * x).natAbs + b.natAbs := Int.natAbs_add_le _ _
    _ = a.natAbs * x.natAbs + b.natAbs := by rw [Int.natAbs_mul]
    _ ≤ a.natAbs * N + b.natAbs := by
        exact Nat.add_le_add_right (Nat.mul_le_mul_left a.natAbs hxabs) b.natAbs

/-- Lemma "stats" (iv) for row functions: every `InScal_q (2^t) N` function equals
`qLine (2^t) a b` on its rows `{1..N}` for a *reduced* pair `(a,b)`. -/
lemma inScal_reduced_qLine {t N : ℕ} (ht : 1 ≤ t) {g : Fin N → ZMod (2 ^ t)}
    (hIn : InScal_q (2 ^ t) N g) :
    ∃ a b : ℤ, ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b) ∧
      ∀ n : Fin N, g n = qLine (2 ^ t) a b (finToInt n) := by
  classical
  let q : ℕ := 2 ^ t
  have hq : 1 < q := by dsimp [q]; exact two_pow_gt_one ht
  have hq0 : (q : ℕ) ≠ 0 := by omega
  have hqpow : ∃ s : ℕ, q = 2 ^ (s + 1) := by
    refine ⟨t - 1, ?_⟩
    dsimp [q]
    congr 1
    omega
  rcases hIn with ⟨a₀, b₀, c, hc, hg⟩
  rcases q_reduce_pair q hq a₀ b₀ with ⟨A, B, hred, hvalAB⟩
  -- the magnitude bound and the shift exponent
  let M : ℕ := c.natAbs * (A.natAbs * N + B.natAbs)
  let R : ℕ := M + 1
  have hR : 1 ≤ R := by dsimp [R]; omega
  have hMlt : M < q ^ R := by
    have hlt : M < 2 ^ R := by
      dsimp [R]
      have h := nat_lt_two_pow (M + 1)
      omega
    have hqR : q ^ R ≥ 2 ^ R := by
      have htr : R ≤ t * R := by
        have ht1 : 1 ≤ t := ht
        nlinarith
      have hp := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) htr
      have hcast : q ^ R = 2 ^ (t * R) := by
        dsimp [q]
        rw [← pow_mul]
      calc
        2 ^ R ≤ 2 ^ (t * R) := hp
        _ = q ^ R := hcast.symm
    exact lt_of_lt_of_le hlt hqR
  -- the shifted representative reproduces g on every row
  let a₁ : ℤ := c * A
  let b₁ : ℤ := c * B + ((q ^ R : ℕ) : ℤ) * c
  have hcne : c ≠ 0 := by
    rcases hc with ⟨k, hk⟩
    intro hz
    omega
  have hc_dvd : ¬ ((2 ^ t : ℕ) : ℤ) ∣ c := odd_not_dvd_two_pow ht hc
  have hcval : fq q c = (c : ZMod q) := by
    dsimp [q]
    exact fq_eq_self_of_not_dvd_int hq (by simpa [q] using hc_dvd)
  have hrow (n : Fin N) : fq q (a₁ * finToInt n + b₁) = g n := by
    let x : ℤ := finToInt n
    have hx : x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := finToInt_mem_window n
    have hmagx : (c * (A * x + B)).natAbs < q ^ R := by
      have hle : (c * (A * x + B)).natAbs ≤ M := by
        rw [Int.natAbs_mul]
        have hb := linear_row_mag_bound (a := A) (b := B) (x := x) hx
        calc
          c.natAbs * (A * x + B).natAbs ≤ c.natAbs * (A.natAbs * N + B.natAbs) :=
            Nat.mul_le_mul_left c.natAbs hb
          _ = M := rfl
      exact lt_of_le_of_lt hle hMlt
    by_cases hx0 : A * x + B = 0
    · -- the unique zero row: f_q(q^R·c) = f_q(c) = c
      change fq q (a₁ * x + b₁) = g n
      calc
        fq q (a₁ * x + b₁) = fq q (c * (A * x + B) + ((q ^ R : ℕ) : ℤ) * c) := by
            congr 1
            dsimp [a₁, b₁]
            ring
        _ = fq q (((q ^ R : ℕ) : ℤ) * c) := by
            rw [hx0]
            congr 1
            ring
        _ = fq q c := fq_qpow_mul_int hq0 R c
        _ = (c : ZMod q) := hcval
        _ = (c : ZMod q) * 1 := by rw [mul_one]
        _ = (c : ZMod q) * fq q (A * x + B) := by rw [hx0, fq_zero]
        _ = (c : ZMod q) * fq q (a₀ * x + b₀) := by rw [hvalAB x]
        _ = g n := by simpa [x, finToInt, q] using (hg n).symm
    · -- nonzero rows: shift invariance + odd multiplicativity
      change fq q (a₁ * x + b₁) = g n
      have hAx : A * x + B ≠ 0 := hx0
      have hw : c * (A * x + B) ≠ 0 := mul_ne_zero hcne hAx
      calc
        fq q (a₁ * x + b₁) = fq q (c * (A * x + B) + ((q ^ R : ℕ) : ℤ) * c) := by
            congr 1
            dsimp [a₁, b₁]
            ring
        _ = fq q (c * (A * x + B)) := fq_invar_add_int_mag hq hR hw (by exact_mod_cast hmagx)
        _ = (c : ZMod q) * fq q (A * x + B) := fq_mul_odd hq c (A * x + B) hc hqpow hAx
        _ = (c : ZMod q) * fq q (a₀ * x + b₀) := by rw [hvalAB x]
        _ = g n := by simpa [x, finToInt, q] using (hg n).symm
  -- reduce the shifted representative
  rcases q_reduce_pair q hq a₁ b₁ with ⟨a', b', hred', hval'⟩
  refine ⟨a', b', hred', ?_⟩
  intro n
  change g n = fq q (a' * finToInt n + b')
  calc
    g n = fq q (a₁ * finToInt n + b₁) := (hrow n).symm
    _ = fq q (a' * finToInt n + b') := hval' (finToInt n)

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # near-digit 9.4, step (A): square selection — board-line bad rows

The selection double count needs, for each board line `ℓ_{i,j}` (whose row function is
`InScal`, hence — by `inScal_reduced_qLine` (dev_near_digit.lean) — an exact reduced
`qLine (2^t) a b` on the rows), a bound on the number of *bad rows* in `{1..N}`: rows
where the canonical affine shadow `a·x+b` vanishes and the line may deviate from affine.
The bad rows are `badCoset (2^t) a b ∩ {1..N}`; `scal_badCoset_spacing` bounds their
count by the coset spacing `2^{t-o}` (`o := twoAdicOrder a`), and a slope-`0` (reduced)
line has no bad rows at all.  These two facts are the per-line input to the double
count over the slab `{1..N} × {1..M}`. -/

/-- A reduced line of nonzero slope has at most `(2N)/2^{t-o} + 1` bad rows in `{1..N}`,
where `o := twoAdicOrder a` is the 2-adic order of the slope. -/
lemma badRows_in_board_le {t N : ℕ} (a b : ℤ) (ha : a ≠ 0) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun x : ℤ => x ∈ badCoset (2 ^ t) a b)).card
        ≤ (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1 := by
  classical
  have hsp := scal_badCoset_spacing (t := t) (K := N) a b ha
  have hsub : (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b) ⊆
      (Finset.Icc (-(N : ℤ)) (N : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b) := by
    intro x hx
    rw [Finset.mem_filter] at hx
    rcases hx with ⟨hxIcc, hbad⟩
    rw [Finset.mem_filter]
    constructor
    · rw [Finset.mem_Icc]
      rw [Finset.mem_Icc] at hxIcc
      constructor <;> omega
    · exact hbad
  have hle : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b)).card ≤
      ((Finset.Icc (-(N : ℤ)) (N : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b)).card :=
    Finset.card_le_card hsub
  exact le_trans hle hsp

/-- A reduced slope-`0` line (`2^t ∤ b`) has empty bad coset: its affine shadow is the
nonzero constant `b`, so every row is off the bad set. -/
lemma badCoset_zero_slope {t : ℕ} {b : ℤ} (hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b) :
    badCoset (2 ^ t) 0 b = ∅ := by
  ext x
  constructor
  · intro hx
    unfold badCoset at hx
    unfold qAffine at hx
    simp at hx
    apply hb
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd b (2 ^ t)).mp hx
  · intro hx
    exact False.elim hx

/-- Slab analogue of `badRows_in_board_le`: a reduced nonzero-slope line has at most
`(2N)/2^{t-o} + 1` *bad cells* in the slab `{1..N} × {1..M}` (bad rows whose cell lies on
the line and inside the slab's column window). -/
lemma line_badCells_slab_le {t N M : ℕ} (a b i j : ℤ) (ha : a ≠ 0) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun n : ℤ => n ∈ badCoset (2 ^ t) a b ∧
        j * n + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card
      ≤ (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1 := by
  classical
  have hsub : (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => n ∈ badCoset (2 ^ t) a b ∧
          j * n + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ)) ⊆
      (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun n : ℤ => n ∈ badCoset (2 ^ t) a b) := by
    intro n hn
    rw [Finset.mem_filter] at hn ⊢
    exact ⟨hn.1, hn.2.1⟩
  exact le_trans (Finset.card_le_card hsub) (badRows_in_board_le (t := t) (N := N) a b ha)

/-- The `8 × 8` squares of the slab `{1..N} × {1..M}`: lower-left corners `(n₀,m₀)` with
`1 ≤ n₀ ≤ N−7`, `1 ≤ m₀ ≤ M−7` (empty when `N < 8` or `M < 8`). -/
def slabSquares (N M : ℕ) : Finset (ℤ × ℤ) :=
  (Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))).product (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ)))

/-- Every cell of the slab lies in at most `64` slab squares. -/
lemma card_squares_containing_le {N M : ℕ} (n m : ℤ) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
      s.1 ≤ n ∧ n ≤ s.1 + 7 ∧ s.2 ≤ m ∧ m ≤ s.2 + 7)).card ≤ 64 := by
  classical
  have hsub : (slabSquares N M).filter (fun s : ℤ × ℤ =>
        s.1 ≤ n ∧ n ≤ s.1 + 7 ∧ s.2 ≤ m ∧ m ≤ s.2 + 7) ⊆
      (Finset.Icc (n - 7) n).product (Finset.Icc (m - 7) m) := by
    intro p hp
    rw [Finset.mem_filter] at hp
    rcases hp with ⟨hpq, hc⟩
    rcases p with ⟨p1, p2⟩
    rcases hc with ⟨h1, h2, h3, h4⟩
    change (p1, p2) ∈ (Finset.Icc (n - 7) n) ×ˢ (Finset.Icc (m - 7) m)
    rw [Finset.mem_product]
    constructor
    · rw [Finset.mem_Icc]
      constructor <;> omega
    · rw [Finset.mem_Icc]
      constructor <;> omega
  have hc1 : ((Finset.Icc (n - 7) n).card : ℤ) = 8 := by
    rw [Int.card_Icc_of_le (a := n - 7) (b := n) (by omega : n - 7 ≤ n + 1)]
    ring
  have hc1' : (Finset.Icc (n - 7) n).card = 8 := by exact_mod_cast hc1
  have hc2 : ((Finset.Icc (m - 7) m).card : ℤ) = 8 := by
    rw [Int.card_Icc_of_le (a := m - 7) (b := m) (by omega : m - 7 ≤ m + 1)]
    ring
  have hc2' : (Finset.Icc (m - 7) m).card = 8 := by exact_mod_cast hc2
  have hprod : ((Finset.Icc (n - 7) n).product (Finset.Icc (m - 7) m)).card = 64 := by
    change ((Finset.Icc (n - 7) n) ×ˢ (Finset.Icc (m - 7) m)).card = 64
    rw [Finset.card_product]
    rw [hc1', hc2']
  exact le_trans (Finset.card_le_card hsub) (by rw [hprod])

/-- A square is *hit* by a set of points when it contains at least one of them; at most
`64 · |P|` slab squares are hit by `P`. -/
lemma card_squares_hit_le {N M : ℕ} (P : Finset (ℤ × ℤ)) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
      ∃ p ∈ P, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card ≤ 64 * P.card := by
  classical
  have hsub : (slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7) ⊆
      P.biUnion (fun p : ℤ × ℤ => (slabSquares N M).filter (fun s : ℤ × ℤ =>
        s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) := by
    intro s hs
    rw [Finset.mem_filter] at hs
    rcases hs with ⟨hsq, hp⟩
    rcases hp with ⟨p, hpP, hc⟩
    rw [Finset.mem_biUnion]
    exact ⟨p, hpP, by rw [Finset.mem_filter]; exact ⟨hsq, hc⟩⟩
  have hsumle : (∑ p ∈ P, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) ≤
      (∑ p ∈ P, 64) := by
    exact Finset.sum_le_sum (fun p hp => card_squares_containing_le (n := p.1) (m := p.2))
  have hsum : (∑ p ∈ P, 64) = 64 * P.card := by
    rw [Finset.sum_const]
    simp
    ring
  exact le_trans (Finset.card_le_card hsub)
    (le_trans (Finset.card_biUnion_le) (by rw [← hsum]; exact hsumle))

/-- Per-line instantiation of the slab bound: an `InScal` row function (a board line)
is an exact reduced `qLine (2^t) a b` (Lemma stats (iv), recorded by the second conjunct)
whose slab bad cells are bounded by the spacing bound when the slope is nonzero, and
vanish for slope `0`. -/
lemma inScal_line_slab_badCells_le {t N M : ℕ} (ht : 1 ≤ t)
    {g : Fin N → ZMod (2 ^ t)} (hIn : InScal_q (2 ^ t) N g) (i j : ℤ) :
    ∃ a b : ℤ, ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b) ∧
      (∀ n : Fin N, g n = qLine (2 ^ t) a b (finToInt n)) ∧
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b ∧
          j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card ≤
        (if a = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1) := by
  classical
  rcases inScal_reduced_qLine ht hIn with ⟨a, b, hred, heq⟩
  by_cases ha : a = 0
  · subst a
    have hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b := by
      intro hbq
      exact hred ⟨dvd_zero ((2 ^ t : ℕ) : ℤ), hbq⟩
    have hempty : badCoset (2 ^ t) 0 b = ∅ := badCoset_zero_slope hb
    refine ⟨0, b, hred, ?_, ?_⟩
    · intro n
      simpa using heq n
    · have hcard : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
          (fun x : ℤ => x ∈ badCoset (2 ^ t) 0 b ∧
            j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card = 0 := by
        rw [hempty]
        simp
      rw [hcard]
      simp
  · refine ⟨a, b, hred, ?_, ?_⟩
    · intro n
      simpa using heq n
    · have hbnd := line_badCells_slab_le (t := t) (N := N) (M := M) a b i j ha
      simpa [ha] using hbnd

/-! ## The fiber charge, per line

`card_squares_hit_le` charges every hit square to a point of the bad-cell set `P`, giving
`≤ 64·|P|`; for one board line the bad-cell set is the image of its bad rows (row `x` ↦
cell `(x, jx+i)` inside the slab), so its cardinality is the slab bad-cell count of the
line, which the spacing bound controls.  This is the per-line charged input to the (A)
double count; summing it over the slab lines and grouping by order feeds the rare layer. -/

/-- The slab bad cells of the line `ℓ_{i,j}` with row function `qLine (2^t) a b`: the cells
`(x, jx+i)` of the line whose row `x ∈ {1..N}` lies in the bad coset (and whose column is
inside the slab). -/
def slabBadCells (t N M : ℕ) (a b i j : ℤ) : Finset (ℤ × ℤ) :=
  ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
    (fun x : ℤ => x ∈ badCoset (2 ^ t) a b ∧
      j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).image (fun x : ℤ => (x, j * x + i))

/-- The number of slab bad cells of a line does not exceed its slab bad-cell count
(filtered image cardinality). -/
lemma slabBadCells_card_le {t N M : ℕ} (a b i j : ℤ) :
    (slabBadCells t N M a b i j).card ≤
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b ∧
          j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card := by
  classical
  unfold slabBadCells
  exact Finset.card_image_le

/-- Per-line charging: a reduced nonzero-slope line hits at most
`64 · ((2N)/2^{t-o} + 1)` slab squares (each hit square charged through the 64-per-cell
fiber to a slab bad cell, then the spacing bound). -/
lemma squaresHit_line_spacing_le {t N M : ℕ} (a b i j : ℤ) (ha : a ≠ 0) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M a b i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
      ≤ 64 * ((2 * N) / (2 ^ (t - twoAdicOrder a)) + 1) := by
  classical
  have hh := card_squares_hit_le (N := N) (M := M) (P := slabBadCells t N M a b i j)
  have hcard : (slabBadCells t N M a b i j).card ≤
      (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1 := by
    exact le_trans (slabBadCells_card_le a b i j) (line_badCells_slab_le (t := t) (N := N) (M := M) a b i j ha)
  exact le_trans hh (Nat.mul_le_mul_left 64 hcard)

/-! ## The intercept window `L_j` and the finite line family

A slope-`j` line (`|j| ≤ 1`) that meets the slab `{1..N} × {1..M}` has intercept
`i = m − jx` with `x ∈ {1..N}`, `m ∈ {1..M}`, hence `|i| ≤ M + N`.  So all slab-relevant
lines have intercepts in `slabLineIcc N M`, and the (A) sums over lines may be restricted
to this finite window (lines outside it contribute no slab cells, hence no hit squares). -/

/-- The intercept window containing every slope-`j` (`|j| ≤ 1`) line that meets the slab:
`i ∈ [-(M+N), M+N]`. -/
def slabLineIcc (N M : ℕ) : Finset ℤ :=
  Finset.Icc (-((M : ℤ) + (N : ℤ))) ((M : ℤ) + (N : ℤ))

/-- The slope-`j` line through a slab cell has intercept in the window (for `|j| ≤ 1`). -/
lemma line_intercept_in_window {N M : ℕ} (x m j : ℤ)
    (hx1 : 1 ≤ x) (hxN : x ≤ (N : ℤ)) (hm1 : 1 ≤ m) (hmM : m ≤ (M : ℤ))
    (hj : j = -1 ∨ j = 0 ∨ j = 1) :
    m - j * x ∈ slabLineIcc N M := by
  rcases hj with hj | hj | hj
  · subst j
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega
  · subst j
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega
  · subst j
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega

/-- The intercept of a slab bad cell of the line `ℓ_{i,j}` (whose rows are `qLine a b`)
lies in the window. -/
lemma intercept_of_slabBadCell {t N M : ℕ} (a b i j : ℤ) {p : ℤ × ℤ}
    (hp : p ∈ slabBadCells t N M a b i j) (hj : j = -1 ∨ j = 0 ∨ j = 1) :
    i ∈ slabLineIcc N M := by
  rw [slabBadCells] at hp
  rw [Finset.mem_image] at hp
  rcases hp with ⟨x, hxmem, hpx⟩
  rw [Finset.mem_filter] at hxmem
  rcases hxmem with ⟨hxIcc, hxbad⟩
  rw [Finset.mem_Icc] at hxIcc
  rcases hxIcc with ⟨hx1, hxN⟩
  have hcol : j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ) := hxbad.2
  rw [Finset.mem_Icc] at hcol
  rcases hcol with ⟨hc1, hcM⟩
  -- i = (jx+i) − jx : i is recovered from the cell and the line equation p.2 = j p.1 + i
  rcases hj with hj | hj | hj
  · subst j
    -- i = (x+i) - x: use the cell-column bounds
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega
  · subst j
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega
  · subst j
    rw [slabLineIcc]
    rw [Finset.mem_Icc]
    constructor <;> omega

/-- Board instantiation (template): for a Sudoku solution and one line `(i, j)`, the line
function is an exact reduced `qLine (2^t) a b` whose slab bad cells satisfy the spacing
bound.  This is the per-`(i,j)` input the slope sums instantiate over `slabLineIcc`. -/
lemma boardLine_slab_badCells_le {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) :
    ∃ a b : ℤ, ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b) ∧
      (∀ n : Fin N, F n (j * finToInt n + i) = qLine (2 ^ t) a b (finToInt n)) ∧
      ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
        (fun x : ℤ => x ∈ badCoset (2 ^ t) a b ∧
          j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card ≤
        (if a = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1) := by
  classical
  rcases inScal_line_slab_badCells_le (t := t) (N := N) (M := M) ht (hF.2 i j) i j with
    ⟨a, b, hred, heq, hbnd⟩
  refine ⟨a, b, hred, ?_, hbnd⟩
  intro n
  have hval := heq n
  simpa [lineRestrict, finToInt] using hval


/-! ## Summing the per-line charges over a finite intercept window

The (A) double count bounds the squares hit by the union of a finite family of bad-cell
sets: the union's hit set is contained in the union of the per-line hit sets
(`totalHit_le_sum`), and per line the charge is `≤ 64 · (spacing)` for a nonzero slope
(`sum_spacing_hits_le`).  Instantiating `P i := slabBadCells … (a i) (b i) i j` with the
board's reduced pairs turns this into the windowed per-slope bound. -/

/-- Squares hit by the union of a finite family of point sets: at most the sum of the
per-family hit counts. -/
lemma totalHit_le_sum {N M : ℕ} (P : ℤ → Finset (ℤ × ℤ)) (L : Finset ℤ) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ i ∈ L, ∃ p ∈ P i,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card ≤
      (∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P i, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) := by
  classical
  have hsub : (slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ i ∈ L, ∃ p ∈ P i,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7) ⊆
      L.biUnion (fun i : ℤ => (slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P i, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) := by
    intro s hs
    rw [Finset.mem_filter] at hs
    rcases hs with ⟨hsq, hw⟩
    rcases hw with ⟨i, hiL, p, hp, hc⟩
    rw [Finset.mem_biUnion]
    exact ⟨i, hiL, by rw [Finset.mem_filter]; exact ⟨hsq, ⟨p, hp, hc⟩⟩⟩
  exact le_trans (Finset.card_le_card hsub) Finset.card_biUnion_le

/-- Sum over a finite intercept window of the per-line charges: for a family of
nonzero-slope reduced lines (slope `j`, intercept `i`, pair `(a i, b i)`), the total
number of hit squares is at most `64` times the summed spacing bounds. -/
lemma sum_spacing_hits_le {t N M : ℕ} (L : Finset ℤ) (a b : ℤ → ℤ) (j : ℤ)
    (ha : ∀ i ∈ L, a i ≠ 0) :
    (∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (a i) (b i) i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
      ≤ 64 * (∑ i ∈ L, ((2 * N) / (2 ^ (t - twoAdicOrder (a i))) + 1)) := by
  classical
  have hsum := Finset.sum_le_sum (fun i hi =>
    squaresHit_line_spacing_le (t := t) (N := N) (M := M) (a i) (b i) i j (ha i hi))
  calc
    (∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (a i) (b i) i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
        ≤ (∑ i ∈ L, 64 * ((2 * N) / (2 ^ (t - twoAdicOrder (a i))) + 1)) := hsum
    _ = 64 * (∑ i ∈ L, ((2 * N) / (2 ^ (t - twoAdicOrder (a i))) + 1)) := by
        rw [Finset.mul_sum]

/-- Charged per-line bound in `if`-form: a reduced line hits at most
`64 · (if a = 0 then 0 else (2N)/2^{t-o} + 1)` slab squares — the slope-`0` case gives
`0` (empty bad coset), the nonzero-slope case is the spacing charge.  This is the
uniform per-line term that the window sums instantiate for `j ∈ {-1, 0, 1}`. -/
lemma squaresHit_line_if_le {t N M : ℕ} (a b i j : ℤ)
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b)) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M a b i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
      ≤ 64 * (if a = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder a)) + 1) := by
  classical
  by_cases ha : a = 0
  · subst a
    have hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b := by
      intro hbq
      exact hred ⟨dvd_zero ((2 ^ t : ℕ) : ℤ), hbq⟩
    have hempty : badCoset (2 ^ t) 0 b = ∅ := badCoset_zero_slope hb
    have hem : slabBadCells t N M 0 b i j = ∅ := by
      unfold slabBadCells
      rw [hempty]
      simp
    rw [hem]
    simp
  · have hh := squaresHit_line_spacing_le (t := t) (N := N) (M := M) a b i j ha
    simpa [ha] using hh

/-- Order-class decomposition of the windowed spacing sum: with the (capped) two-adic
order `o_i := min (twoAdicOrder (a i)) t` of each slope, summing the per-class spacing over
the window equals summing, over `o ∈ {0..t}`, the class spacing times the number of window
slopes in that class.  (Each class count is what the rare layer bounds.) -/
lemma spacing_sum_class_decomp {t N : ℕ} (L : Finset ℤ) (a : ℤ → ℤ) :
    (∑ i ∈ L, ((2 * N) / (2 ^ (t - min (twoAdicOrder (a i)) t)) + 1)) =
      (∑ o ∈ Finset.range (t + 1),
        ((2 * N) / (2 ^ (t - o)) + 1) *
          ((L.filter (fun i : ℤ => min (twoAdicOrder (a i)) t = o)).card)) := by
  classical
  let f : ℤ → ℕ := fun i => min (twoAdicOrder (a i)) t
  let g : ℕ → ℕ := fun o => (2 * N) / (2 ^ (t - o)) + 1
  have hfib := Commons.Data.Finset.sum_over_image_fibers (α := ℤ) (β := ℕ) L f g
  have himg : L.image f ⊆ Finset.range (t + 1) := by
    intro o ho
    rw [Finset.mem_range]
    rw [Finset.mem_image] at ho
    rcases ho with ⟨i, hi, hio⟩
    have hm : f i ≤ t := by
      dsimp [f]
      exact Nat.min_le_right (twoAdicOrder (a i)) t
    rw [← hio]
    omega
  have hzero : ∀ o ∈ Finset.range (t + 1), o ∉ L.image f →
      g o * (L.filter (fun i : ℤ => f i = o)).card = 0 := by
    intro o ho hnot
    have hem : (L.filter (fun i : ℤ => f i = o)) = ∅ := by
      ext i
      constructor
      · intro hi
        rw [Finset.mem_filter] at hi
        rcases hi with ⟨hiL, hio⟩
        exact False.elim (hnot (by rw [Finset.mem_image]; exact ⟨i, hiL, hio⟩))
      · intro hi
        exact False.elim (by simpa using hi)
    rw [hem]
    simp
  calc
    (∑ i ∈ L, ((2 * N) / (2 ^ (t - min (twoAdicOrder (a i)) t)) + 1))
        = (∑ o ∈ L.image f, g o * (L.filter (fun i : ℤ => f i = o)).card) := by
            simpa [f, g] using hfib
    _ = (∑ o ∈ Finset.range (t + 1),
          ((2 * N) / (2 ^ (t - o)) + 1) *
            ((L.filter (fun i : ℤ => min (twoAdicOrder (a i)) t = o)).card)) := by
            exact Finset.sum_subset himg hzero

/-- `(2 : ℤ)^o` equals the cast of the natural power `2^o`. -/
lemma zpow_two_pow_nat {o : ℕ} : (2 : ℤ) ^ o = ((2 ^ o : ℕ) : ℤ) := by
  induction o with
  | zero => norm_num
  | succ o ih =>
      calc
        (2 : ℤ) ^ (o + 1) = 2 * (2 : ℤ) ^ o := by rw [pow_succ']
        _ = ((2 : ℕ) : ℤ) * (((2 ^ o : ℕ) : ℤ)) := by rw [ih]; ring
        _ = (((2 ^ (o + 1) : ℕ) : ℤ)) := by
            rw [← Nat.cast_mul]
            congr 1
            rw [pow_succ']

/-- Reconciliation with the rare layer: if a board line equals `qLine (2^t)(2^o·a')(2^o·b')`
on the rows (reduced coefficients in genuine order-`o` form, `a'` odd), then it satisfies
`lineAgreesAffineOrder F o i j` — so it is counted by the good-columns rare bound at order `o`.
Rows where the line's value is needed are exactly the rows where `q ∤ (2^o(a'x+b'))`, where
`f_q` equals the reduction mod `q` (the affine value). -/
lemma lineAgreesAffineOrder_of_reduced {t N : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (i j : ℤ) (o : ℕ) (a' b' : ℤ) (ha' : Odd a')
    (heq : ∀ n : Fin N, F n (j * finToInt n + i) =
      qLine (2 ^ t) (((2 ^ o : ℕ) : ℤ) * a') (((2 ^ o : ℕ) : ℤ) * b') (finToInt n)) :
    lineAgreesAffineOrder F o i j := by
  classical
  refine ⟨a', b', ha', ?_⟩
  intro n hn
  let x : ℤ := ((n.val : ℕ) + 1 : ℤ)
  have hpow : (2 : ℤ) ^ o = ((2 ^ o : ℕ) : ℤ) := zpow_two_pow_nat
  have hI : ((2 : ℤ) ^ o * (a' * x + b') : ℤ) = ((2 ^ o : ℕ) : ℤ) * (a' * x + b') := by
    rw [hpow]
  have harg0 : ¬ ((2 ^ t : ℕ) : ℤ) ∣ (((2 ^ o : ℕ) : ℤ) * (a' * x + b')) := by
    intro hd
    apply hn
    have hz : ((((2 : ℤ) ^ o * (a' * x + b') : ℤ) : ZMod (2 ^ t))) = 0 :=
      (ZMod.intCast_zmod_eq_zero_iff_dvd (((2 : ℤ) ^ o * (a' * x + b') : ℤ)) (2 ^ t)).mpr (by
        rw [hI]
        exact hd)
    simpa [x] using hz
  have hfq : fq (2 ^ t) (((2 ^ o : ℕ) : ℤ) * (a' * x + b')) =
      ((((2 ^ o : ℕ) : ℤ) * (a' * x + b') : ℤ) : ZMod (2 ^ t)) :=
    fq_eq_self_of_not_dvd_int (two_pow_gt_one ht) harg0
  have hval := heq n
  calc
    F n (j * ((n.val : ℕ) + 1 : ℤ) + i)
        = F n (j * x + i) := by simp [x]
    _ = qLine (2 ^ t) (((2 ^ o : ℕ) : ℤ) * a') (((2 ^ o : ℕ) : ℤ) * b') (finToInt n) := hval
    _ = fq (2 ^ t) (((2 ^ o : ℕ) : ℤ) * a' * x + ((2 ^ o : ℕ) : ℤ) * b') := by
        -- qLine a b y = fq(2^t)(a·y + b) with y = finToInt n = x
        simp [qLine, x, finToInt]
    _ = fq (2 ^ t) (((2 ^ o : ℕ) : ℤ) * (a' * x + b')) := by
        congr 1
        ring
    _ = (((2 ^ o : ℕ) : ℤ) * (a' * x + b') : ℤ) := hfq
    _ = (((2 : ℤ) ^ o * (a' * x + b') : ℤ) : ZMod (2 ^ t)) := by rw [hI]

/-! ## Two-level (slope × intercept) union bounds

The (A) union bound runs over `j ∈ {-1,0,1}` and `i ∈ slabLineIcc N M`.  These two
lemmas are the structural spine: `totalHit_le_sum2` bounds the squares hit by the union of
the two-index family by the double sum of per-line hit counts, and
`sum2_spacing_hits_le` bounds that double sum by `64` times the double sum of the
`if`-form spacing terms (per line `squaresHit_line_if_le`). -/

/-- Squares hit by the union of a two-index family of point sets: at most the double sum
of the per-family hit counts. -/
lemma totalHit_le_sum2 {N M : ℕ} (P : ℤ → ℤ → Finset (ℤ × ℤ)) (J L : Finset ℤ) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ j ∈ J, ∃ i ∈ L, ∃ p ∈ P j i,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card ≤
      (∑ j ∈ J, ∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P j i, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) := by
  classical
  have hsub : (slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ j ∈ J, ∃ i ∈ L, ∃ p ∈ P j i,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7) ⊆
      (J.product L).biUnion (fun ji : ℤ × ℤ => (slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P ji.1 ji.2, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) := by
    intro s hs
    rw [Finset.mem_filter] at hs
    rcases hs with ⟨hsq, hw⟩
    rcases hw with ⟨j, hjJ, i, hiL, p, hp, hc⟩
    rw [Finset.mem_biUnion]
    refine ⟨(j, i), ?_, ?_⟩
    · change (j, i) ∈ J ×ˢ L
      rw [Finset.mem_product]
      exact ⟨hjJ, hiL⟩
    · rw [Finset.mem_filter]
      exact ⟨hsq, ⟨p, hp, hc⟩⟩
  have heqprod : (∑ ji ∈ J.product L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P ji.1 ji.2, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) =
      (∑ j ∈ J, ∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P j i, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) := by
    change (∑ ji ∈ J ×ˢ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P ji.1 ji.2, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card) =
      (∑ j ∈ J, ∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ P j i, s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
    rw [Finset.sum_product]
  exact le_trans (Finset.card_le_card hsub)
    (le_trans Finset.card_biUnion_le (le_of_eq heqprod))

/-- Two-level windowed spacing sum: for reduced families of lines (slope `j`, intercept
`i`, pair `(a j i, b j i)`), the double sum of hit counts over the window is at most
`64` times the double sum of the `if`-form spacing terms. -/
lemma sum2_spacing_hits_le {t N M : ℕ} (J L : Finset ℤ) (a b : ℤ → ℤ → ℤ)
    (hred : ∀ j ∈ J, ∀ i ∈ L, ¬ (((2 ^ t : ℕ) : ℤ) ∣ a j i ∧ ((2 ^ t : ℕ) : ℤ) ∣ b j i)) :
    (∑ j ∈ J, ∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (a j i) (b j i) i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
      ≤ 64 * (∑ j ∈ J, ∑ i ∈ L,
          (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1)) := by
  classical
  have hper (j : ℤ) (hj : j ∈ J) :
      (∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (a j i) (b j i) i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
        ≤ 64 * (∑ i ∈ L,
            (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1)) := by
    calc
      (∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
          ∃ p ∈ slabBadCells t N M (a j i) (b j i) i j,
            s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
          ≤ (∑ i ∈ L, 64 * (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1)) :=
            Finset.sum_le_sum (fun i hi =>
              squaresHit_line_if_le (t := t) (N := N) (M := M) (a j i) (b j i) i j (hred j hj i hi))
      _ = 64 * (∑ i ∈ L, (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1)) := by
          rw [Finset.mul_sum]
  calc
    (∑ j ∈ J, ∑ i ∈ L, ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (a j i) (b j i) i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
        ≤ (∑ j ∈ J, 64 * (∑ i ∈ L,
            (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1))) := by
            apply Finset.sum_le_sum
            intro j hj
            exact hper j hj
    _ = 64 * (∑ j ∈ J, ∑ i ∈ L,
          (if a j i = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder (a j i))) + 1)) := by
          rw [Finset.mul_sum]

/-! ## Board instantiation: the per-line pairs and the window restriction

The (A) hit set ranges over *all* slope-`j` lines; `boardLinePair` chooses, for each
(intercept, slope) `(i, j)`, the reduced pair of the board line `F_{i,j}` (via
`inScal_reduced_qLine` on `hF.2 i j`, which is M-independent), and
`boardHit_restrict_window` shows every hit square is realized by an intercept in
`slabLineIcc N M` — the finite family the sums run over. -/

/-- The reduced pair of the board line `F_{i,j}` (chosen representative from Lemma
stats (iv)); independent of the slab width `M`. -/
noncomputable def boardLinePair {t N : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) : ℤ × ℤ :=
  ⟨ Classical.choose (inScal_reduced_qLine (t := t) (N := N) ht (hF.2 i j)),
    Classical.choose (Classical.choose_spec (inScal_reduced_qLine (t := t) (N := N) ht (hF.2 i j)))⟩

/-- Every square hit by a slab bad cell of a slope-`j ∈ J` line is hit by one whose
intercept lies in the window `slabLineIcc N M` (finite reduction of the line family). -/
lemma boardHit_restrict_window {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (J : Finset ℤ)
    (hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ j ∈ J, ∃ i : ℤ, ∃ p ∈
          slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) ⊆
      ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ j ∈ J, ∃ i ∈ slabLineIcc N M, ∃ p ∈
          slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) := by
  classical
  intro s hs
  rw [Finset.mem_filter] at hs
  rcases hs with ⟨hsq, hw⟩
  rcases hw with ⟨j, hjJ, i, p, hp, hc⟩
  rw [Finset.mem_filter]
  refine ⟨hsq, ?_⟩
  refine ⟨j, hjJ, i, ?_, p, hp, hc⟩
  exact intercept_of_slabBadCell (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j hp (hJ j hjJ)

/-- The chosen reduced pair of each board line is genuinely reduced (Lemma stats (iv)
spec). -/
lemma boardLinePair_hred {t N : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) :
    ¬ (((2 ^ t : ℕ) : ℤ) ∣ (boardLinePair ht F hF i j).1 ∧ ((2 ^ t : ℕ) : ℤ) ∣ (boardLinePair ht F hF i j).2) := by
  classical
  let p := boardLinePair ht F hF i j
  change ¬ (((2 ^ t : ℕ) : ℤ) ∣ p.1 ∧ ((2 ^ t : ℕ) : ℤ) ∣ p.2)
  dsimp [p, boardLinePair]
  exact (Classical.choose_spec (Classical.choose_spec (inScal_reduced_qLine (t := t) (N := N) ht (hF.2 i j)))).1

/-- The board's chosen pair satisfies the `if`-form slab bad-cell bound (per line, at any
slab width `M`): slope-`0` pairs have empty bad coset, nonzero-slope pairs obey the spacing
bound. -/
lemma boardLinePair_slabBadCells_le {t N M : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) :
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
      (fun x : ℤ => x ∈ badCoset (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 ∧
        j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card ≤
      (if (boardLinePair ht F hF i j).1 = 0 then 0
       else (2 * N) / (2 ^ (t - twoAdicOrder (boardLinePair ht F hF i j).1)) + 1) := by
  classical
  let p := boardLinePair ht F hF i j
  have hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ p.1 ∧ ((2 ^ t : ℕ) : ℤ) ∣ p.2) := by
    simpa [p] using boardLinePair_hred ht F hF i j
  by_cases hp : p.1 = 0
  · have hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ p.2 := by
      intro hbq
      exact hred ⟨by rw [hp]; exact dvd_zero ((2 ^ t : ℕ) : ℤ), hbq⟩
    have hb0 : badCoset (2 ^ t) 0 p.2 = ∅ := badCoset_zero_slope hb
    have hb' : badCoset (2 ^ t) p.1 p.2 = ∅ := by rwa [hp]
    have hcard : ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
          (fun x : ℤ => x ∈ badCoset (2 ^ t) p.1 p.2 ∧
            j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card = 0 := by
      rw [hb']
      simp
    rw [hcard]
    rw [hp]
    simp
  · have hbnd := line_badCells_slab_le (t := t) (N := N) (M := M) p.1 p.2 i j hp
    simpa [p, hp] using hbnd

/-- A line with empty bad coset has no slab bad cells, hence hits no slab square.  This is
the vanishing that lets the (A) sum restrict to lines with a *nonempty* bad coset (the
genuine order-`o` lines the rare bound counts). -/
lemma empty_badCoset_hits_zero {t N M : ℕ} (a b i j : ℤ)
    (hempty : badCoset (2 ^ t) a b = ∅) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M a b i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card = 0 := by
  classical
  have hem : slabBadCells t N M a b i j = ∅ := by
    unfold slabBadCells
    rw [hempty]
    simp
  rw [hem]
  simp



attribute [local instance] Classical.propDecidable

/-! (A) step (b): a reduced pair with NONEMPTY bad coset has genuine order
`o := twoAdicOrder a < t` and `2^o | b`. -/

lemma badCoset_nonempty_not_dvd_coeff {t : ℕ} {a b : ℤ}
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b))
    (hne : badCoset (2 ^ t) a b ≠ ∅) :
    ¬ ((2 ^ t : ℕ) : ℤ) ∣ a := by
  classical
  intro hqa
  have hqb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b := by
    intro hb
    exact hred ⟨hqa, hb⟩
  have hΓ : badCoset (2 ^ t) a b = ∅ := by
    ext x
    constructor
    · intro hx
      have hd : ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
        apply (qAffine_zero_iff_int_dvd (q := 2 ^ t) a b x).mp
        simpa [badCoset] using hx
      exact not_dvd_affine_of_coeff_zero (t := t) hqa hqb hd
    · intro hx
      exact False.elim hx
  exact hne hΓ

lemma twoAdicOrder_lt_of_badCoset_nonempty {t : ℕ} (a : ℤ) (_b : ℤ) (ha : a ≠ 0)
    (hqa : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a) :
    twoAdicOrder a < t :=
  twoAdicOrder_lt_of_not_dvd (t := t) ha hqa

lemma badCoset_nonempty_dvd_const {t : ℕ} (a b : ℤ) (ha : a ≠ 0)
    (hqa : ¬ ((2 ^ t : ℕ) : ℤ) ∣ a)
    (hne : badCoset (2 ^ t) a b ≠ ∅) :
    (((2 ^ twoAdicOrder a : ℕ) : ℤ) ∣ b) := by
  classical
  have ho : twoAdicOrder a < t := twoAdicOrder_lt_of_not_dvd (t := t) ha hqa
  obtain ⟨a', hfac, _hodd_na⟩ := int_two_power_factorization a ha
  let d : ℤ := ((2 ^ twoAdicOrder a : ℕ) : ℤ)
  have hfac' : a = d * a' := by
    dsimp [d]
    simpa [twoAdicOrder] using hfac
  rcases (Set.nonempty_iff_ne_empty).mpr hne with ⟨x, hx⟩
  have hd_t : ((2 ^ t : ℕ) : ℤ) ∣ a * x + b := by
    apply (qAffine_zero_iff_int_dvd (q := 2 ^ t) a b x).mp
    simpa [badCoset] using hx
  rcases hd_t with ⟨k, hk⟩
  have hpowNat : (2 ^ t : ℕ) = 2 ^ twoAdicOrder a * 2 ^ (t - twoAdicOrder a) := by
    rw [← pow_add]
    congr 1
    omega
  have hpow : ((2 ^ t : ℕ) : ℤ) = d * ((2 ^ (t - twoAdicOrder a) : ℕ) : ℤ) := by
    dsimp [d]
    exact_mod_cast hpowNat
  refine ⟨((2 ^ (t - twoAdicOrder a) : ℕ) : ℤ) * k - a' * x, ?_⟩
  have hax : a * x = d * a' * x := by
    rw [hfac']
  have h2t : ((2 ^ t : ℕ) : ℤ) * k = d * (((2 ^ (t - twoAdicOrder a) : ℕ) : ℤ) * k) := by
    rw [hpow]
    ring
  calc
    b = (a * x + b) - a * x := by ring
    _ = ((2 ^ t : ℕ) : ℤ) * k - a * x := by rw [hk]
    _ = d * (((2 ^ (t - twoAdicOrder a) : ℕ) : ℤ) * k - a' * x) := by
        rw [h2t, hax]
        ring

/-- Combined step (b). -/
lemma badCoset_nonempty_reduced_order {t : ℕ} {a b : ℤ} (ha : a ≠ 0)
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b))
    (hne : badCoset (2 ^ t) a b ≠ ∅) :
    twoAdicOrder a < t ∧ (((2 ^ twoAdicOrder a : ℕ) : ℤ) ∣ b) := by
  constructor
  · exact twoAdicOrder_lt_of_badCoset_nonempty a b ha (badCoset_nonempty_not_dvd_coeff hred hne)
  · exact badCoset_nonempty_dvd_const a b ha (badCoset_nonempty_not_dvd_coeff hred hne) hne

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! (A) step (c): per-line and per-class hit bounds feeding the ∃-square selection. -/

/-- Per board line `(i,j)`, the number of slab squares containing a slab bad cell is at
most `64 · (if-form spacing bound)`. -/
lemma hits_line_pair_le {t N M : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
      ≤ 64 * (if (boardLinePair ht F hF i j).1 = 0 then 0
               else (2 * N) / (2 ^ (t - twoAdicOrder (boardLinePair ht F hF i j).1)) + 1) := by
  classical
  let p := boardLinePair ht F hF i j
  have hh := card_squares_hit_le (N := N) (M := M)
    (P := slabBadCells t N M p.1 p.2 i j)
  have hsc := slabBadCells_card_le (t := t) (N := N) (M := M) p.1 p.2 i j
  have hbnd := boardLinePair_slabBadCells_le (t := t) (N := N) (M := M) ht F hF i j
  calc
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
        ≤ 64 * (slabBadCells t N M p.1 p.2 i j).card := by
            simpa [p] using hh
    _ ≤ 64 * (((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).filter
          (fun x : ℤ => x ∈ badCoset (2 ^ t) p.1 p.2 ∧
            j * x + i ∈ Finset.Icc (1 : ℤ) ((M : ℕ) : ℤ))).card) := by
            exact Nat.mul_le_mul_left 64 hsc
    _ ≤ 64 * (if p.1 = 0 then 0
              else (2 * N) / (2 ^ (t - twoAdicOrder p.1)) + 1) := by
            exact Nat.mul_le_mul_left 64 (by simpa [p] using hbnd)

/-- Nonempty bad coset of a *reduced* pair forces the slope nonzero (a slope-0 reduced
pair has empty coset). -/
lemma badCoset_nonempty_ne_zero {t : ℕ} {a b : ℤ}
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b))
    (hne : badCoset (2 ^ t) a b ≠ ∅) : a ≠ 0 := by
  intro hz
  subst a
  have hb : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b := by
    intro hbq
    exact hred ⟨dvd_zero ((2 ^ t : ℕ) : ℤ), hbq⟩
  exact hne (badCoset_zero_slope hb)

/-- A board line whose (reduced) pair has nonempty bad coset and order `o` satisfies the
order-`o` affine agreement predicate `lineAgreesAffineOrder` — the bridge feeding the rare
bound: nonempty order-`o` lines (the only lines that can hit a square) are counted among
`{i : lineAgreesAffineOrder F o i j}`. -/
lemma nonempty_lineAgreesAffineOrder {t N : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) (o : ℕ)
    (hord : twoAdicOrder (boardLinePair ht F hF i j).1 = o)
    (hne : badCoset (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 ≠ ∅) :
    lineAgreesAffineOrder (t := t) (N := N) F o i j := by
  classical
  let p := boardLinePair ht F hF i j
  have hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ p.1 ∧ ((2 ^ t : ℕ) : ℤ) ∣ p.2) := by
    simpa [p] using boardLinePair_hred ht F hF i j
  have hp0 : p.1 ≠ 0 := badCoset_nonempty_ne_zero hred (by simpa [p] using hne)
  obtain ⟨a', hfac, hodd_na⟩ := int_two_power_factorization p.1 hp0
  have hodd' : Odd a' := odd_int_of_odd_natAbs hodd_na
  have hdvd : (((2 ^ twoAdicOrder p.1 : ℕ) : ℤ) ∣ p.2) := by
    exact badCoset_nonempty_dvd_const p.1 p.2 hp0
      (badCoset_nonempty_not_dvd_coeff hred (by simpa [p] using hne))
      (by simpa [p] using hne)
  rcases hdvd with ⟨b', hb⟩
  have heq : ∀ n : Fin N, F n (j * finToInt n + i) =
      qLine (2 ^ t) (((2 ^ o : ℕ) : ℤ) * a') (((2 ^ o : ℕ) : ℤ) * b') (finToInt n) := by
    intro n
    have hval : F n (j * finToInt n + i) = qLine (2 ^ t) p.1 p.2 (finToInt n) := by
      have h := (Classical.choose_spec (Classical.choose_spec
        (inScal_reduced_qLine (t := t) (N := N) ht (hF.2 i j)))).2 n
      simpa [lineRestrict, finToInt, p, boardLinePair] using h
    rw [hval]
    -- coefficients: p.1 = (2^o)*a'  and  p.2 = (2^o)*b'
    have hfac_ord : p.1 = (((2 ^ o : ℕ) : ℤ) * a') := by
      rw [← hord]
      simpa [twoAdicOrder, p] using hfac
    have hb_ord : p.2 = (((2 ^ o : ℕ) : ℤ) * b') := by
      rw [← hord]
      simpa [p] using hb
    rw [hfac_ord, hb_ord]
  exact lineAgreesAffineOrder_of_reduced (t := t) (N := N) ht F i j o a' b' hodd' heq


/-! ## Per-class hit bound (one slope `j`, one order `o`)

The hit-set of slope-`j` lines of exact genuine order `o` (nonempty bad coset, and
`twoAdicOrder (board pair slope) = o < t`) is bounded by `64·((2N)/2^{t-o}+1)` per such
line. -/

/-- Board-line hit count at a *genuine order-`o`* line (`coset ≠ ∅`, order `o`): the
`if`-form of `hits_line_pair_le` evaluates to `(2N)/2^{t-o}+1`. -/
lemma hits_line_pair_le_of_order {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) (o : ℕ)
    (hord : twoAdicOrder (boardLinePair ht F hF i j).1 = o)
    (hne : badCoset (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 ≠ ∅) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
      ≤ 64 * (((2 * N) / (2 ^ (t - o))) + 1) := by
  classical
  let p := boardLinePair ht F hF i j
  have hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ p.1 ∧ ((2 ^ t : ℕ) : ℤ) ∣ p.2) := by
    simpa [p] using boardLinePair_hred ht F hF i j
  have hp0 : p.1 ≠ 0 := badCoset_nonempty_ne_zero hred (by simpa [p] using hne)
  have hb := hits_line_pair_le (t := t) (N := N) (M := M) ht F hF i j
  have hif : (if p.1 = 0 then 0 else (2 * N) / (2 ^ (t - twoAdicOrder p.1)) + 1) =
      ((2 * N) / (2 ^ (t - o))) + 1 := by
    rw [if_neg hp0]
    rw [hord]
  calc
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
          s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
        ≤ 64 * (if p.1 = 0 then 0
                 else (2 * N) / (2 ^ (t - twoAdicOrder p.1)) + 1) := by
            simpa [p] using hb
    _ = 64 * (((2 * N) / (2 ^ (t - o))) + 1) := by
        rw [hif]

/-- Intercept class of slope-`j` lines of genuine order `o` in the window. -/
def badClass (t N M : ℕ) (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (j : ℤ) (o : ℕ) : Finset ℤ :=
  (slabLineIcc N M).filter (fun i : ℤ =>
    badCoset (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 ≠ ∅ ∧
    twoAdicOrder (boardLinePair ht F hF i j).1 = o)

/-- Squares hit by slope-`j` lines of genuine order `o` with intercept in the window:
at most `64·((2N)/2^{t-o}+1)` times the number of such lines. -/
lemma classHit_le {t N M : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (j : ℤ) (o : ℕ) :
    ((slabSquares N M).filter (fun s : ℤ × ℤ =>
        ∃ i ∈ badClass t N M ht F hF j o,
          ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
            s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card
      ≤ 64 * (((2 * N) / (2 ^ (t - o))) + 1) * (badClass t N M ht F hF j o).card := by
  classical
  have hsum := totalHit_le_sum (N := N) (M := M)
    (P := fun i : ℤ => slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j)
    (L := badClass t N M ht F hF j o)
  have hsum_le : (∑ i ∈ badClass t N M ht F hF j o,
        ((slabSquares N M).filter (fun s : ℤ × ℤ =>
          ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
            s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
      ≤ (∑ i ∈ badClass t N M ht F hF j o, 64 * (((2 * N) / (2 ^ (t - o))) + 1)) := by
    apply Finset.sum_le_sum
    intro i hi
    rw [badClass, Finset.mem_filter] at hi
    exact hits_line_pair_le_of_order (t := t) (N := N) (M := M) ht F hF i j o hi.2.2 hi.2.1
  have hconst : (∑ i ∈ badClass t N M ht F hF j o, 64 * (((2 * N) / (2 ^ (t - o))) + 1)) =
      64 * (((2 * N) / (2 ^ (t - o))) + 1) * (badClass t N M ht F hF j o).card := by
    rw [Finset.sum_const]
    simp
    ring
  exact le_trans hsum (le_trans hsum_le (le_of_eq hconst))


/-! ## Class ⊆ windowed affine-agreement set, and the rare-layer reduction

Every genuine order-`o` line (intercept in the window) satisfies
`lineAgreesAffineOrder F o i j` (`nonempty_lineAgreesAffineOrder`), and the window
`slabLineIcc N M` sits inside `Icc (-K) K` with `K := M+N` — so each order-`o` class is
counted by the rare bound at order `o`. -/

/-- The intercept window of the rare bound at width `K = M+N`. -/
def rareWindow (N M : ℕ) : Finset ℤ :=
  Finset.Icc (-(((M + N : ℕ) : ℤ))) (((M + N : ℕ) : ℤ))

/-- `slabLineIcc` equals the rare window at `K := M+N` (cast bookkeeping). -/
lemma slabLineIcc_eq_rareWindow (N M : ℕ) : slabLineIcc N M = rareWindow N M := by
  ext i
  simp [slabLineIcc, rareWindow, Nat.cast_add]

/-- Each genuine order-`o` slope-`j` line in the window is counted by the order-`o`
affine-agreement set inside the rare window: `badClass ⊆ window ∩ lineAgrees`. -/
lemma badClass_subset_lineAgrees {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (j : ℤ) (o : ℕ) :
    badClass t N M ht F hF j o ⊆
      (rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j) := by
  classical
  intro i hi
  rw [Finset.mem_filter]
  rw [badClass, Finset.mem_filter] at hi
  constructor
  · rw [slabLineIcc_eq_rareWindow] at hi
    exact hi.1
  · exact nonempty_lineAgreesAffineOrder (t := t) (N := N) ht F hF i j o hi.2.2 hi.2.1

/-- Per-order cardinality consequence of the class inclusion. -/
lemma badClass_card_le_lineAgrees {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (j : ℤ) (o : ℕ) :
    (badClass t N M ht F hF j o).card ≤
      ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card :=
  Finset.card_le_card (badClass_subset_lineAgrees ht F hF j o)


/-! ## Total hit-set bound: decompose by slope and order

Every slab square that contains a bad cell of some slope-`j ∈ J` line contains a bad cell
of a line whose (reduced) pair has *nonempty* bad coset of some order `o < t`; charging
each square to its witnessing `(j, o)` and applying `classHit_le` per class gives the
total bound below. -/

/-- The full hit set over the lines of slopes `j ∈ J` (any intercept). -/
def hitSet (t N M : ℕ) (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (J : Finset ℤ) : Finset (ℤ × ℤ) :=
  (slabSquares N M).filter (fun s : ℤ × ℤ =>
    ∃ j ∈ J, ∃ i : ℤ, ∃ p ∈
      slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j,
      s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)

/-- Total bound on the hit set in terms of the per-(slope,order) class counts. -/
lemma hitSet_card_le_classSum {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (J : Finset ℤ)
    (hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1) :
    (hitSet t N M ht F hF J).card ≤
      (∑ jo ∈ J.product (Finset.range t),
        64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * (badClass t N M ht F hF jo.1 jo.2).card) := by
  classical
  have hsub : hitSet t N M ht F hF J ⊆
      (J.product (Finset.range t)).biUnion (fun jo : ℤ × ℕ =>
        (slabSquares N M).filter (fun s : ℤ × ℤ =>
          ∃ i ∈ badClass t N M ht F hF jo.1 jo.2,
            ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i jo.1).1 (boardLinePair ht F hF i jo.1).2 i jo.1,
              s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)) := by
    intro s hs
    rw [hitSet, Finset.mem_filter] at hs
    rcases hs with ⟨hsq, hw⟩
    rcases hw with ⟨j, hjJ, i, p, hp, hc⟩
    rw [Finset.mem_biUnion]
    let o : ℕ := twoAdicOrder (boardLinePair ht F hF i j).1
    have hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ (boardLinePair ht F hF i j).1 ∧
        ((2 ^ t : ℕ) : ℤ) ∣ (boardLinePair ht F hF i j).2) :=
      boardLinePair_hred ht F hF i j
    have hne : badCoset (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 ≠ ∅ := by
      have hpim : p ∈ slabBadCells t N M (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j := hp
      rw [slabBadCells] at hpim
      rw [Finset.mem_image] at hpim
      rcases hpim with ⟨x, hxmem, _hpx⟩
      rw [Finset.mem_filter] at hxmem
      exact Set.nonempty_iff_ne_empty.mp ⟨x, hxmem.2.1⟩
    have hqa : ¬ ((2 ^ t : ℕ) : ℤ) ∣ (boardLinePair ht F hF i j).1 :=
      badCoset_nonempty_not_dvd_coeff hred hne
    have ha : (boardLinePair ht F hF i j).1 ≠ 0 := badCoset_nonempty_ne_zero hred hne
    have hlt : o < t := by
      dsimp [o]
      exact twoAdicOrder_lt_of_badCoset_nonempty (boardLinePair ht F hF i j).1
        (boardLinePair ht F hF i j).2 ha hqa
    refine ⟨(j, o), ?_, ?_⟩
    · change (j, o) ∈ J ×ˢ Finset.range t
      rw [Finset.mem_product]
      constructor
      · exact hjJ
      · rw [Finset.mem_range]
        exact hlt
    · rw [Finset.mem_filter]
      refine ⟨hsq, ?_⟩
      refine ⟨i, ?_, p, hp, hc⟩
      rw [badClass, Finset.mem_filter]
      constructor
      · exact intercept_of_slabBadCell (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 i j
          hp (hJ j hjJ)
      · constructor
        · exact hne
        · dsimp [o]
  have hsum_le : (∑ jo ∈ J.product (Finset.range t),
        ((slabSquares N M).filter (fun s : ℤ × ℤ =>
          ∃ i ∈ badClass t N M ht F hF jo.1 jo.2,
            ∃ p ∈ slabBadCells t N M (boardLinePair ht F hF i jo.1).1 (boardLinePair ht F hF i jo.1).2 i jo.1,
              s.1 ≤ p.1 ∧ p.1 ≤ s.1 + 7 ∧ s.2 ≤ p.2 ∧ p.2 ≤ s.2 + 7)).card)
      ≤ (∑ jo ∈ J.product (Finset.range t),
          64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * (badClass t N M ht F hF jo.1 jo.2).card) := by
    apply Finset.sum_le_sum
    intro jo hjo
    exact classHit_le (t := t) (N := N) (M := M) ht F hF jo.1 jo.2
  exact le_trans (Finset.card_le_card hsub) (le_trans Finset.card_biUnion_le hsum_le)


/-! ## Rare-layer arithmetic (per order and total)

The order-`o` affine-agreement lines in the window are rare (Lemma "rare" for
good-columns boards): `(N/2^{t-o})·U ≤ B` with `B := N·(2·((2K)/q + 1))`, `K := M+N`,
`q := 2^t`; combined with the `≤ 2(N/d)+1` division slack and the window bound
`U ≤ 2K+1`, each `(j,o)` class contributes at most `128·(B + 2K + 1)`. -/

/-- Division slack: `(2N)/d ≤ 2·(N/d) + 1`. -/
lemma two_mul_div_le {N d : ℕ} : (2 * N) / d ≤ 2 * (N / d) + 1 := by
  by_cases hd0 : d = 0
  · subst d
    simp
  · have hd : 0 < d := Nat.pos_of_ne_zero hd0
    let q : ℕ := N / d
    let r : ℕ := N % d
    have hsplit : N = d * q + r := by
      dsimp [q, r]
      exact (Nat.div_add_mod N d).symm
    have hmod : r < d := by
      dsimp [r]
      exact Nat.mod_lt N hd
    have h2a := congrArg (fun x : ℕ => 2 * x) hsplit
    have h2 : 2 * N = d * (2 * q) + 2 * r := by
      rw [h2a]
      ring
    rw [h2]
    rw [show d * (2 * q) + 2 * r = 2 * q * d + 2 * r by ring]
    rw [show 2 * q * d + 2 * r = 2 * r + 2 * q * d by ring]
    rw [Nat.add_mul_div_right (2 * r) (2 * q) hd]
    have hsmall : (2 * r) / d ≤ 1 := by
      have h2lt : 2 * r < 2 * d := Nat.mul_lt_mul_of_pos_left hmod (by norm_num)
      have hdiv : (2 * r) / d < 2 := Nat.div_lt_of_lt_mul (by simpa [mul_comm] using h2lt)
      omega
    omega

/-- Cardinality of the rare window `Icc (-K) K`, `K := M+N`. -/
lemma rareWindow_card (N M : ℕ) : (rareWindow N M).card = 2 * (M + N) + 1 := by
  let K : ℕ := M + N
  have hwin : (Finset.Icc (-(K : ℤ)) (K : ℤ)).card = 2 * K + 1 := by
    have heq : (Finset.Icc (-(K : ℤ)) (K : ℤ)) =
        (Finset.Icc (-(K : ℤ)) (K : ℤ)).filter (fun n : ℤ => ((1 : ℕ) : ℤ) ∣ n - 0) := by
      ext n
      simp
    rw [heq]
    exact intervalCount_one (0 : ℤ) K
  have hw : rareWindow N M = (Finset.Icc (-(K : ℤ)) (K : ℤ)) := by
    dsimp [K, rareWindow]
  rw [hw, hwin]

/-- The per-order class bound feeds the rare bound: with `U` the number of order-`o`
affine-agreement intercepts in the window,
`64·((2N)/2^{t-o}+1)·U ≤ 128·(B + 2K + 1)` (`K := M+N`, `B := N·(2·((2K)/q+1))`). -/
lemma perOrder_U_le_rare {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F) (j : ℤ) (o : ℕ) (ho : o < t) :
    64 * (((2 * N) / (2 ^ (t - o))) + 1) *
        ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card
      ≤ 128 * (N * (2 * ((2 * (M + N)) / (2 ^ t) + 1)) + (2 * (M + N) + 1)) := by
  classical
  let K : ℕ := M + N
  let B : ℕ := N * (2 * ((2 * K) / (2 ^ t) + 1))
  let c : ℕ := N / (2 ^ (t - o))
  let U : ℕ := ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card
  have hrare : U * c ≤ B := by
    have hb := highOrderLines_goodColumns_bound (t := t) (N := N) (K := K) (o := o) ht
      (by omega : o ≤ t - 1) F hgood j
    have hwin : (Finset.Icc (-(K : ℤ)) (K : ℤ)) = rareWindow N M := by
      dsimp [K, rareWindow]
    rw [hwin] at hb
    dsimp [U, c, B] at hb ⊢
    exact hb
  have hdiv : ((2 * N) / (2 ^ (t - o))) + 1 ≤ 2 * c + 2 := by
    dsimp [c]
    have h1 := two_mul_div_le (N := N) (d := 2 ^ (t - o))
    omega
  have hUwin : U ≤ 2 * K + 1 := by
    dsimp [U]
    have hle := Finset.card_filter_le (rareWindow N M) (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)
    have hcard : (rareWindow N M).card = 2 * K + 1 := by
      dsimp [K]
      exact rareWindow_card N M
    omega
  have hUc : c * U ≤ B := by
    exact (by simpa [mul_comm] using hrare)
  calc
    64 * (((2 * N) / (2 ^ (t - o))) + 1) * U
        ≤ 64 * (2 * c + 2) * U := by
            exact Nat.mul_le_mul_right U (Nat.mul_le_mul_left 64 hdiv)
    _ = 128 * (c * U + U) := by
            ring
    _ ≤ 128 * (B + U) := by
            exact Nat.mul_le_mul_left 128 (by omega)
    _ ≤ 128 * (B + (2 * K + 1)) := by
            exact Nat.mul_le_mul_left 128 (by omega)
    _ = 128 * (N * (2 * ((2 * (M + N)) / (2 ^ t) + 1)) + (2 * (M + N) + 1)) := by
            dsimp [B, K]



/-! ## Total hit-set bound after the rare layer

`hitSet.card ≤ J.card · t · 128 · rareConst t N M` for good-columns boards; the strict
inequality against `(N-7)(M-7)` for the concrete parameters is the arithmetic step (f). -/

/-- The per-order uniform rare constant `B + 2K + 1` (`K := M+N`,
`B := N·(2·((2K)/q + 1))`, `q := 2^t`). -/
def rareConst (t N M : ℕ) : ℕ :=
  N * (2 * ((2 * (M + N)) / (2 ^ t) + 1)) + (2 * (M + N) + 1)

/-- Intercept-window affine-agreement count at order `o` for slope `j` (the rare bound's
counting set). -/
def rareCount (t N M : ℕ) (F : SudokuBoard (2 ^ t) N) (j : ℤ) (o : ℕ) : ℕ :=
  ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card

/-- Per-order per-slope contribution is bounded by the uniform rare constant. -/
lemma perOrder_U_le_rare' {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F) (j : ℤ) (o : ℕ) (ho : o < t) :
    64 * (((2 * N) / (2 ^ (t - o))) + 1) * rareCount t N M F j o ≤ 128 * rareConst t N M := by
  have hb := perOrder_U_le_rare (t := t) (N := N) (M := M) ht F hF hgood j o ho
  simpa [rareCount, rareConst] using hb

/-- The per-order class count is at most the affine-agreement count. -/
lemma badClass_card_le_rareCount {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (j : ℤ) (o : ℕ) :
    (badClass t N M ht F hF j o).card ≤ rareCount t N M F j o := by
  simpa [rareCount] using badClass_card_le_lineAgrees ht F hF j o

/-- Total bound on the hit set after the rare layer:
`hitSet ≤ J.card · t · 128 · rareConst`. -/
lemma hitSet_card_le_rareTotal {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F) (J : Finset ℤ)
    (hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1) :
    (hitSet t N M ht F hF J).card ≤ J.card * t * 128 * rareConst t N M := by
  classical
  let classSum : ℕ := (∑ jo ∈ J.product (Finset.range t),
        64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * (badClass t N M ht F hF jo.1 jo.2).card)
  let Usum : ℕ := (∑ jo ∈ J.product (Finset.range t),
        64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * rareCount t N M F jo.1 jo.2)
  have h1 : (hitSet t N M ht F hF J).card ≤ classSum := by
    simpa [classSum] using hitSet_card_le_classSum ht F hF J hJ
  have h2 : classSum ≤ Usum := by
    dsimp [classSum, Usum]
    apply Finset.sum_le_sum
    intro jo hjo
    exact Nat.mul_le_mul_left (64 * (((2 * N) / (2 ^ (t - jo.2))) + 1))
      (badClass_card_le_rareCount ht F hF jo.1 jo.2)
  have h3 : Usum ≤ (J.product (Finset.range t)).card * (128 * rareConst t N M) := by
    dsimp [Usum]
    have hsum_le : (∑ jo ∈ J.product (Finset.range t),
          64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * rareCount t N M F jo.1 jo.2)
        ≤ (∑ jo ∈ J.product (Finset.range t), 128 * rareConst t N M) := by
      apply Finset.sum_le_sum
      intro jo hjo
      change jo ∈ J ×ˢ Finset.range t at hjo
      rw [Finset.mem_product] at hjo
      exact perOrder_U_le_rare' (t := t) (N := N) (M := M) ht F hF hgood jo.1 jo.2 (by
        rw [Finset.mem_range] at hjo; exact hjo.2)
    have hconst : (∑ jo ∈ J.product (Finset.range t), 128 * rareConst t N M) =
        (J.product (Finset.range t)).card * (128 * rareConst t N M) := by
      rw [Finset.sum_const]
      simp
    exact le_trans hsum_le (le_of_eq hconst)
  have hcard : (J.product (Finset.range t)).card = J.card * t := by
    change (J ×ˢ Finset.range t).card = J.card * t
    rw [Finset.card_product]
    simp
  calc
    (hitSet t N M ht F hF J).card ≤ classSum := h1
    _ ≤ Usum := h2
    _ ≤ (J.product (Finset.range t)).card * (128 * rareConst t N M) := h3
    _ = J.card * t * 128 * rareConst t N M := by
        rw [hcard]
        ring


/-! ## The square selection conclusion (∃-square, step (g))

If the total hit-set is smaller than the number of squares, some square contains no bad
cell of any slope-`j ∈ {-1,0,1}` line; the square is then *bad-cell free* in the sense
needed by the concat step of Prop. near-digit. -/

/-- Cardinality of the interval of square origins `1..n` (as `ℤ`). -/
lemma Icc_one_card (n : ℕ) : (Finset.Icc (1 : ℤ) (((n : ℕ) : ℤ))).card = n := by
  rw [Int.card_Icc]
  have hval : ((((n : ℕ) : ℤ) + 1 - 1)) = (((n : ℕ) : ℤ)) := by ring
  rw [hval]
  exact Int.toNat_natCast n

/-- Cardinality of the square-origin set: `(N-7)(M-7)` squares. -/
lemma slabSquares_card (N M : ℕ) : (slabSquares N M).card = (N - 7) * (M - 7) := by
  unfold slabSquares
  change ((Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))) ×ˢ
    (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ)))).card = (N - 7) * (M - 7)
  rw [Finset.card_product]
  rw [Icc_one_card (N - 7), Icc_one_card (M - 7)]

/-- If the hit set does not cover all squares, a square free of hits exists. -/
lemma slabSquares_notHit_exists {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (J : Finset ℤ)
    (hlt : (hitSet t N M ht F hF J).card < (slabSquares N M).card) :
    ∃ s : ℤ × ℤ, s ∈ slabSquares N M ∧ s ∉ hitSet t N M ht F hF J := by
  classical
  by_contra h
  have hall : ∀ s ∈ slabSquares N M, s ∈ hitSet t N M ht F hF J := by
    intro s hs
    by_contra hn
    exact h ⟨s, hs, hn⟩
  have hge : (slabSquares N M).card ≤ (hitSet t N M ht F hF J).card := by
    apply Finset.card_le_card
    intro s hs
    exact hall s hs
  exact (not_lt_of_ge hge) hlt


/-- Square selection for good-columns boards: if the rare-layer total is smaller than
the number of `8×8` squares, a square `{n₀..n₀+7} × {m₀..m₀+7}` inside the slab contains
no bad cell of any horizontal / diagonal / anti-diagonal line (slopes `-1,0,1`). -/
theorem exists_square_free_badCells {t N M : ℕ} (ht : 1 ≤ t)
    (hN7 : 8 ≤ N) (hM7 : 8 ≤ M)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F)
    (hineq : 3 * t * 128 * rareConst t N M < (N - 7) * (M - 7)) :
    ∃ n₀ m₀ : ℤ,
      1 ≤ n₀ ∧ n₀ + 7 ≤ (N : ℤ) ∧ 1 ≤ m₀ ∧ m₀ + 7 ≤ (M : ℤ) ∧
      ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∀ x m : ℤ,
        x ∈ Finset.Icc n₀ (n₀ + 7) → m ∈ Finset.Icc m₀ (m₀ + 7) →
          ¬ x ∈ badCoset (2 ^ t) (boardLinePair ht F hF (m - j * x) j).1
            (boardLinePair ht F hF (m - j * x) j).2 := by
  classical
  let J : Finset ℤ := ({-1, 0, 1} : Finset ℤ)
  have hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1 := by
    intro j hj
    simpa [J] using hj
  have hJcard : J.card = 3 := by
    simp [J]
  have hlt : (hitSet t N M ht F hF J).card < (slabSquares N M).card := by
    calc
      (hitSet t N M ht F hF J).card ≤ J.card * t * 128 * rareConst t N M :=
        hitSet_card_le_rareTotal ht F hF hgood J hJ
      _ = 3 * t * 128 * rareConst t N M := by rw [hJcard]
      _ < (N - 7) * (M - 7) := hineq
      _ = (slabSquares N M).card := (slabSquares_card N M).symm
  obtain ⟨s0, hs0, hnot⟩ := slabSquares_notHit_exists ht F hF J hlt
  rcases s0 with ⟨n₀, m₀⟩
  have hprod : (n₀, m₀) ∈ (Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))) ×ˢ
      (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ))) := by
    change (n₀, m₀) ∈ slabSquares N M
    simpa using hs0
  have hmemprod : (n₀, m₀) ∈
      (Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))) ×ˢ
      (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ))) := hprod
  rw [Finset.mem_product] at hmemprod
  rcases hmemprod with ⟨hn, hm⟩
  have hn1 : 1 ≤ n₀ := (Finset.mem_Icc.mp hn).1
  have hn2 : n₀ ≤ (((N - 7 : ℕ) : ℤ)) := (Finset.mem_Icc.mp hn).2
  have hm1 : 1 ≤ m₀ := (Finset.mem_Icc.mp hm).1
  have hm2 : m₀ ≤ (((M - 7 : ℕ) : ℤ)) := (Finset.mem_Icc.mp hm).2
  have hcastN : (((N - 7 : ℕ) : ℤ)) = (N : ℤ) - 7 := by
    rw [Nat.cast_sub (by omega : (7 : ℕ) ≤ N)]
    norm_num
  have hcastM : (((M - 7 : ℕ) : ℤ)) = (M : ℤ) - 7 := by
    rw [Nat.cast_sub (by omega : (7 : ℕ) ≤ M)]
    norm_num
  have hn7 : n₀ + 7 ≤ (N : ℤ) := by omega
  have hm7 : m₀ + 7 ≤ (M : ℤ) := by omega
  refine ⟨n₀, m₀, hn1, hn7, hm1, hm7, ?_⟩
  intro j hjs x m hx hm
  intro hbad
  have hxI : n₀ ≤ x ∧ x ≤ n₀ + 7 := Finset.mem_Icc.mp hx
  have hmI : m₀ ≤ m ∧ m ≤ m₀ + 7 := Finset.mem_Icc.mp hm
  have hxmem : x ∈ Finset.Icc (1 : ℤ) (((N : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hmmem : m ∈ Finset.Icc (1 : ℤ) (((M : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hcol : j * x + (m - j * x) ∈ Finset.Icc (1 : ℤ) (((M : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hmem : (n₀, m₀) ∈ hitSet t N M ht F hF J := by
    rw [hitSet, Finset.mem_filter]
    refine ⟨hs0, ?_⟩
    refine ⟨j, ?_, m - j * x, (x, m), ?_, ?_⟩
    · simpa [J] using hjs
    · rw [slabBadCells]
      rw [Finset.mem_image]
      refine ⟨x, ?_, ?_⟩
      · rw [Finset.mem_filter]
        refine ⟨hxmem, ?_⟩
        refine ⟨hbad, hcol⟩
      · congr 1
        ring
    · rw [Finset.mem_Icc] at hx hm
      exact ⟨hx.1, hx.2, hm.1, hm.2⟩
  exact hnot hmem


/-! ## Step (f): the concrete strict inequality (N = M = 2^{2t}, t ≥ 24)

`3·t·128·rareConst t (2^{2t}) (2^{2t}) < (2^{2t}−7)²` for `t ≥ 24`; hence the ∃-square
selection applies with `N = M = 2^{2t}`. -/

/-- `a·a^n = a^(n+1)`. -/
lemma pow_succ_mul (a : ℕ) (n : ℕ) : a * a ^ n = a ^ (n + 1) := by
  rw [pow_succ']

/-- `a^n·a = a^(n+1)`. -/
lemma pow_succ_mulR (a : ℕ) (n : ℕ) : a ^ n * a = a ^ (n + 1) := by
  rw [pow_succ]

/-- Strict linear-vs-exponential: `12288·t < 2^{t−2}` for `t ≥ 24`. -/
lemma two_pow_gt_12288_24 : ∀ t : ℕ, 24 ≤ t → 12288 * t < 2 ^ (t - 2) := by
  intro t ht
  let k : ℕ := t - 24
  have htk : t = 24 + k := by dsimp [k]; omega
  rw [htk]
  induction k with
  | zero => norm_num
  | succ k ih =>
      calc
        12288 * (24 + (k + 1)) ≤ 2 * (12288 * (24 + k)) := by omega
        _ < 2 * 2 ^ ((24 + k) - 2) := Nat.mul_lt_mul_of_pos_left ih (by norm_num)
        _ = 2 ^ ((24 + (k + 1)) - 2) := by
            rw [pow_succ_mul 2 ((24 + k) - 2)]
            congr 1
            omega

/-- Exact evaluation of the rare constant at `N = M = 2^{2t}`:
`2^{3t+3} + 2^{2t+1} + 2^{2t+2} + 1`. -/
lemma rareConst_eval (t : ℕ) :
    rareConst t (2 ^ (2 * t)) (2 ^ (2 * t)) =
      2 ^ (3 * t + 3) + 2 ^ (2 * t + 1) + 2 ^ (2 * t + 2) + 1 := by
  let A : ℕ := 2 ^ (2 * t)
  have h2A : 2 * A = 2 ^ (2 * t + 1) := by
    dsimp [A]
    rw [pow_succ_mul 2 (2 * t)]
  have h2AA : 2 * (A + A) = 2 ^ (2 * t + 2) := by
    have hsum : A + A = 2 * A := by omega
    rw [hsum]
    calc
      2 * (2 * A) = 2 * 2 ^ (2 * t + 1) := by rw [h2A]
      _ = 2 ^ ((2 * t + 1) + 1) := by
          rw [pow_succ_mul 2 (2 * t + 1)]
  have hdiv : (2 * (A + A)) / 2 ^ t = 2 ^ (t + 2) := by
    rw [h2AA]
    calc
      2 ^ (2 * t + 2) / 2 ^ t = 2 ^ ((2 * t + 2) - t) := by
          rw [Nat.pow_div (by omega : t ≤ 2 * t + 2) (by norm_num)]
      _ = 2 ^ (t + 2) := by
          congr 1
          omega
  have hN : A * (2 * (2 ^ (t + 2) + 1)) = 2 ^ (3 * t + 3) + 2 ^ (2 * t + 1) := by
    have h1 : 2 * (2 ^ (t + 2) + 1) = 2 ^ (t + 3) + 2 := by
      rw [mul_add]
      norm_num
      have hinner : 2 * 2 ^ (t + 2) = 2 ^ (t + 3) := by
        calc
          2 * 2 ^ (t + 2) = 2 ^ ((t + 2) + 1) := by
              rw [pow_succ_mul 2 (t + 2)]
          _ = 2 ^ (t + 3) := by rfl
      omega
    calc
      A * (2 * (2 ^ (t + 2) + 1)) = A * (2 ^ (t + 3) + 2) := by rw [h1]
      _ = A * 2 ^ (t + 3) + A * 2 := by rw [mul_add]
      _ = 2 ^ (3 * t + 3) + 2 ^ (2 * t + 1) := by
          have hfst : A * 2 ^ (t + 3) = 2 ^ (3 * t + 3) := by
            dsimp [A]
            calc
              2 ^ (2 * t) * 2 ^ (t + 3) = 2 ^ ((2 * t) + (t + 3)) := by
                  rw [← pow_add]
              _ = 2 ^ (3 * t + 3) := by
                  congr 1
                  omega
          have hsnd : A * 2 = 2 ^ (2 * t + 1) := by
            dsimp [A]
            rw [pow_succ_mulR 2 (2 * t)]
          omega

  calc
    rareConst t (2 ^ (2 * t)) (2 ^ (2 * t))
        = A * (2 * ((2 * (A + A)) / 2 ^ t + 1)) + (2 * (A + A) + 1) := by
            dsimp [rareConst, A]
    _ = A * (2 * (2 ^ (t + 2) + 1)) + (2 ^ (2 * t + 2) + 1) := by
            rw [hdiv, h2AA]
    _ = (2 ^ (3 * t + 3) + 2 ^ (2 * t + 1)) + (2 ^ (2 * t + 2) + 1) := by
            rw [hN]
    _ = 2 ^ (3 * t + 3) + 2 ^ (2 * t + 1) + 2 ^ (2 * t + 2) + 1 := by omega

/-- Crude bound on the rare constant: `≤ 2^{3t+5}`. -/
lemma rareConst_eval_le (t : ℕ) :
    rareConst t (2 ^ (2 * t)) (2 ^ (2 * t)) ≤ 2 ^ (3 * t + 5) := by
  rw [rareConst_eval]
  have h1 : 2 ^ (2 * t + 1) ≤ 2 ^ (3 * t + 3) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have h2 : 2 ^ (2 * t + 2) ≤ 2 ^ (3 * t + 3) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have h0 : (1 : ℕ) ≤ 2 ^ (3 * t + 3) := one_le_pow₀ (by norm_num)
  have hsum : 2 ^ (3 * t + 3) + 2 ^ (2 * t + 1) + 2 ^ (2 * t + 2) + 1 ≤ 4 * 2 ^ (3 * t + 3) := by
    omega
  have h4 : 4 * 2 ^ (3 * t + 3) = 2 ^ (3 * t + 5) := by
    rw [show 4 = 2 ^ 2 by norm_num]
    calc
      2 ^ 2 * 2 ^ (3 * t + 3) = 2 ^ (2 + (3 * t + 3)) := by
          rw [← pow_add]
      _ = 2 ^ (3 * t + 5) := by
          congr 1
          omega
  omega

/-- The strict rare inequality (`t ≥ 24`):
`3·t·128·2^{3t+5} < (2^{2t}−7)²`. -/
lemma pow_rare_ineq_24 : ∀ t : ℕ, 24 ≤ t →
    3 * t * 128 * 2 ^ (3 * t + 5) < (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := by
  intro t ht
  have h14 : (14 : ℕ) ≤ 2 ^ (2 * t - 1) := by
    have h : 2 ^ 4 ≤ 2 ^ (2 * t - 1) := pow_le_pow_right₀ (by norm_num) (by omega : 4 ≤ 2 * t - 1)
    norm_num at h
    exact le_trans (by norm_num : (14 : ℕ) ≤ 2 ^ 4) h
  have ha : 2 ^ (2 * t - 1) ≤ 2 ^ (2 * t) - 7 := by
    have hp : 2 ^ (2 * t) = 2 * 2 ^ (2 * t - 1) := by
      calc
        2 ^ (2 * t) = 2 ^ ((2 * t - 1) + 1) := by congr 1; omega
        _ = 2 * 2 ^ (2 * t - 1) := by rw [pow_succ_mul]
    rw [hp]
    omega
  have hsq : 2 ^ (2 * t - 1) * 2 ^ (2 * t - 1) ≤ (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := by
    exact Nat.mul_le_mul ha ha
  have hpows : 2 ^ (2 * t - 1) * 2 ^ (2 * t - 1) = 2 ^ (4 * t - 2) := by
    calc
      2 ^ (2 * t - 1) * 2 ^ (2 * t - 1) = 2 ^ ((2 * t - 1) + (2 * t - 1)) := by
          rw [← pow_add]
      _ = 2 ^ (4 * t - 2) := by
          congr 1
          omega
  have hstrict : 3 * t * 128 * 2 ^ (3 * t + 5) < 2 ^ (4 * t - 2) := by
    calc
      3 * t * 128 * 2 ^ (3 * t + 5)
          = 3 * t * 128 * (2 ^ (3 * t) * 2 ^ 5) := by
              have hp5 : 2 ^ (3 * t + 5) = 2 ^ (3 * t) * 2 ^ 5 := by
                rw [pow_add]
              rw [hp5]
      _ = (3 * t * 128 * 32) * 2 ^ (3 * t) := by
              have h25 : 2 ^ 5 = 32 := by norm_num
              rw [h25]
              ring
      _ = (12288 * t) * 2 ^ (3 * t) := by ring
      _ < 2 ^ (t - 2) * 2 ^ (3 * t) := Nat.mul_lt_mul_of_pos_right (two_pow_gt_12288_24 t ht)
          (pow_pos (by norm_num) (3 * t))
      _ = 2 ^ (4 * t - 2) := by
          calc
            2 ^ (t - 2) * 2 ^ (3 * t) = 2 ^ ((t - 2) + (3 * t)) := by
                rw [← pow_add]
            _ = 2 ^ (4 * t - 2) := by
                congr 1
                omega
  exact lt_of_lt_of_le hstrict (by simpa [hpows] using hsq)

/-- The strict inequality used by the square selection (`t ≥ 24`, `N = M = 2^{2t}`). -/
lemma rareConst_ineq_24 (t : ℕ) (ht : 24 ≤ t) :
    3 * t * 128 * rareConst t (2 ^ (2 * t)) (2 ^ (2 * t)) <
      (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := by
  have hsmall := rareConst_eval_le t
  have hpow := pow_rare_ineq_24 t ht
  calc
    3 * t * 128 * rareConst t (2 ^ (2 * t)) (2 ^ (2 * t))
        ≤ 3 * t * 128 * 2 ^ (3 * t + 5) := Nat.mul_le_mul_left (3 * t * 128) hsmall
    _ < (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := hpow

/-- Square selection instance for good-columns Sudoku solutions at `q = 2^t`, width
`N = q² = 2^{2t}`, `t ≥ 24`: an `8×8` square inside `{1..N} × {1..N}` free of bad cells
of every horizontal / diagonal / anti-diagonal line. -/
theorem near_digit_square_selection {t : ℕ} (ht : 1 ≤ t) (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ (2 * t)))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ (2 * t)) F)
    (hgood : HasGoodColumns (2 ^ t) (2 ^ (2 * t)) F) :
    ∃ n₀ m₀ : ℤ,
      1 ≤ n₀ ∧ n₀ + 7 ≤ ((2 ^ (2 * t)) : ℤ) ∧ 1 ≤ m₀ ∧ m₀ + 7 ≤ ((2 ^ (2 * t)) : ℤ) ∧
      ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∀ x m : ℤ,
        x ∈ Finset.Icc n₀ (n₀ + 7) → m ∈ Finset.Icc m₀ (m₀ + 7) →
          ¬ x ∈ badCoset (2 ^ t)
            (boardLinePair ht F hF (m - j * x) j).1
            (boardLinePair ht F hF (m - j * x) j).2 := by
  classical
  have hN7 : 8 ≤ 2 ^ (2 * t) := by
    have h : 2 ^ 3 ≤ 2 ^ (2 * t) := pow_le_pow_right₀ (by norm_num) (by omega : 3 ≤ 2 * t)
    norm_num at h
    exact h
  have hineq : 3 * t * 128 * rareConst t (2 ^ (2 * t)) (2 ^ (2 * t)) <
      (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := rareConst_ineq_24 t ht24
  exact exists_square_free_badCells (t := t) (N := 2 ^ (2 * t)) (M := 2 ^ (2 * t))
    ht hN7 hN7 F hF hgood hineq


end
end Commons.PeriodicTiling


/-!
# The concatentation lemma over an arbitrary `8 × 8` window

(arXiv:2211.15847, Lemma "concat"; companion of `sudoku_concat.lean`.)

`concat_pseudo_affine` proves the statement on the *normalized* square
`{0..7}²`.  This file transfers it to an arbitrary window
`{n0..n0+7} × {m0..m0+7}`:

  * `SquareLineAffineOn F n0 m0` : `F` is affine along every line of slope
    `-1,0,1` meeting that window;
  * shifting coordinates turns that into the normalized hypothesis
    (`squareLineAffineOn_shift`);
  * pseudo-affine functions are closed under translating the argument
    (`pseudoAffineVal`, `pseudoAffine_translate`), which converts the
    normalized conclusion into one in the window's own coordinates;

and the main theorem `concat_pseudo_affine_on`.

These are the exact forms needed by the later "near-digit" structure
proposition (Proposition "near-digit", tex line 1341), where a pseudo-affine
extension of a function agreeing with a Sudoku solution on an `8×8` window
`{n₀..n₀+7} × {m₀..m₀+7}` of the board is produced.
-/

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

/-- A square function is affine along each line `m = j n + i` (`j = -1,0,1`) meeting the
window `{n0..n0+7} × {m0..m0+7}`. -/
def SquareLineAffineOn {t : ℕ} (F : SqFun t) (n0 m0 : ℤ) : Prop :=
  ∀ j i : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∃ s c : ZMod (2 ^ t),
    ∀ n m : ℤ, n0 ≤ n → n ≤ n0 + 7 → m0 ≤ m → m ≤ m0 + 7 → m = j * n + i →
      F n m = s * (n : ZMod (2 ^ t)) + c

/-- Shifting the argument moves an `n0,m0`-window hypothesis to the normalized
square `{0..7}²`. -/
lemma squareLineAffineOn_shift {t : ℕ} {F : SqFun t} {n0 m0 : ℤ}
    (hF : SquareLineAffineOn F n0 m0) :
    SquareLineAffine (fun n m => F (n0 + n) (m0 + m)) := by
  intro j i hj
  -- intercept of the same geometric line in window coordinates
  let i' : ℤ := m0 + i - j * n0
  rcases hF j i' hj with ⟨s, c, hF'⟩
  refine ⟨s, s * (n0 : ZMod (2 ^ t)) + c, ?_⟩
  intro n m hn0 hn1 hm0 hm1 hm
  have hN0 : n0 ≤ n0 + n := by omega
  have hN1 : n0 + n ≤ n0 + 7 := by omega
  have hM0 : m0 ≤ m0 + m := by omega
  have hM1 : m0 + m ≤ m0 + 7 := by omega
  have hline : m0 + m = j * (n0 + n) + i' := by
    dsimp [i']
    rw [hm]
    ring
  have hval := hF' (n0 + n) (m0 + m) hN0 hN1 hM0 hM1 hline
  change F (n0 + n) (m0 + m) = s * (n : ZMod (2 ^ t)) + (s * (n0 : ZMod (2 ^ t)) + c)
  calc
    F (n0 + n) (m0 + m) = s * ((n0 + n : ℤ) : ZMod (2 ^ t)) + c := hval
    _ = s * (n : ZMod (2 ^ t)) + (s * (n0 : ZMod (2 ^ t)) + c) := by
        rw [Int.cast_add]
        ring

/-- The pseudo-affine value `A n + B m + C + (q/4) D m (m-n)`. -/
def pseudoAffineVal {t : ℕ} (A B C D : ZMod (2 ^ t)) (n m : ℤ) : ZMod (2 ^ t) :=
  A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C + pseudoCorr D n m

/-- Pseudo-affine functions are closed under translating the argument: the value at
`(n - n0, m - m0)` is again pseudo-affine in `(n, m)`. -/
lemma pseudoAffine_translate {t : ℕ} (A B C D : ZMod (2 ^ t)) (n0 m0 n m : ℤ) :
    pseudoAffineVal A B C D (n - n0) (m - m0) =
      pseudoAffineVal
        (A + (qFourth t * D) * (m0 : ZMod (2 ^ t)))
        (B + (qFourth t * D) * ((n0 : ZMod (2 ^ t)) - 2 * (m0 : ZMod (2 ^ t))))
        (C - A * (n0 : ZMod (2 ^ t)) - B * (m0 : ZMod (2 ^ t))
          + (qFourth t * D) * (m0 : ZMod (2 ^ t)) * ((m0 : ZMod (2 ^ t)) - (n0 : ZMod (2 ^ t))))
        D n m := by
  dsimp [pseudoAffineVal, pseudoCorr]
  simp [Int.cast_sub, Int.cast_add]
  ring

/-- The concatentation lemma over an arbitrary `8 × 8` window: a function affine along
every slope-`-1,0,1` line meeting `{n0..n0+7} × {m0..m0+7}` agrees on the window with a
pseudo-affine function of the window coordinates. -/
theorem concat_pseudo_affine_on {t : ℕ} (ht : 2 ≤ t) (n0 m0 : ℤ) (F : SqFun t)
    (hF : SquareLineAffineOn F n0 m0) :
    ∃ A B C D : ZMod (2 ^ t), ∀ n m : ℤ,
      n0 ≤ n → n ≤ n0 + 7 → m0 ≤ m → m ≤ m0 + 7 →
      F n m = A * (n : ZMod (2 ^ t)) + B * (m : ZMod (2 ^ t)) + C + pseudoCorr D n m := by
  classical
  have hG : SquareLineAffine (fun n m => F (n0 + n) (m0 + m)) := squareLineAffineOn_shift hF
  obtain ⟨A0, B0, C0, D, hG0⟩ := concat_pseudo_affine ht (fun n m => F (n0 + n) (m0 + m)) hG
  refine ⟨A0 + (qFourth t * D) * (m0 : ZMod (2 ^ t)),
          B0 + (qFourth t * D) * ((n0 : ZMod (2 ^ t)) - 2 * (m0 : ZMod (2 ^ t))),
          C0 - A0 * (n0 : ZMod (2 ^ t)) - B0 * (m0 : ZMod (2 ^ t))
            + (qFourth t * D) * (m0 : ZMod (2 ^ t)) * ((m0 : ZMod (2 ^ t)) - (n0 : ZMod (2 ^ t))),
          D, ?_⟩
  intro n m hn0 hn1 hm0 hm1
  have hi0 : 0 ≤ n - n0 := by omega
  have hi1 : n - n0 ≤ 7 := by omega
  have hj0 : 0 ≤ m - m0 := by omega
  have hj1 : m - m0 ≤ 7 := by omega
  have hval := hG0 (n - n0) (m - m0) hi0 hi1 hj0 hj1
  have hshift : F n m = pseudoAffineVal A0 B0 C0 D (n - n0) (m - m0) := by
    calc
      F n m = F (n0 + (n - n0)) (m0 + (m - m0)) := by
        rw [show n0 + (n - n0) = n by ring, show m0 + (m - m0) = m by ring]
      _ = pseudoAffineVal A0 B0 C0 D (n - n0) (m - m0) := hval
  calc
    F n m = pseudoAffineVal A0 B0 C0 D (n - n0) (m - m0) := hshift
    _ = (A0 + (qFourth t * D) * (m0 : ZMod (2 ^ t))) * (n : ZMod (2 ^ t))
          + (B0 + (qFourth t * D) * ((n0 : ZMod (2 ^ t)) - 2 * (m0 : ZMod (2 ^ t)))) * (m : ZMod (2 ^ t))
          + (C0 - A0 * (n0 : ZMod (2 ^ t)) - B0 * (m0 : ZMod (2 ^ t))
            + (qFourth t * D) * (m0 : ZMod (2 ^ t)) * ((m0 : ZMod (2 ^ t)) - (n0 : ZMod (2 ^ t))))
          + pseudoCorr D n m := by
        -- pseudoAffine_translate converts the shifted value into pseudo-affine at (n,m)
        -- with exactly the translated coefficients displayed on the right.
        simpa [pseudoAffineVal] using (pseudoAffine_translate A0 B0 C0 D n0 m0 n m)

end
end Commons.PeriodicTiling

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # near-digit 9.4, step (B): concat application — the pseudo-affine square

`near_digit_square_selection` (dev_sqb) yields an `8×8` square `Q` free of bad cells of
every slope-`{-1,0,1}` board line.  On `Q ∩ ℓ` the board line agrees with its affine
shadow (`boardLinePair_row_eq` + `qLine_eq_qAffine_of_not_mem_badCoset`), so the square
function is affine along every slope-`{-1,0,1}` line meeting `Q`
(`board_square_line_affine`).  `concat_pseudo_affine_on` then gives a pseudo-affine
`Ψ` agreeing with the board on `Q`. -/

/-- Lift a Sudoku board to a whole-`ℤ²` function (the standard `SqFun` domain of the
concat lemma): rows whose integer coordinate lies in `{1..N}` are read from the board,
other rows are `0` (never used — concat only evaluates in the window). -/
def boardToSq {t N : ℕ} (F : SudokuBoard (2 ^ t) N) : SqFun t :=
  fun n m => if h : n ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) then F (intToFin ⟨n, h⟩) m else 0

/-- The chosen reduced pair of each board line satisfies the row equation
`F r (j·finToInt r + i) = qLine (2^t) p.1 p.2 (finToInt r)` on every row `r`. -/
lemma boardLinePair_row_eq {t N : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (i j : ℤ) (r : Fin N) :
    F r (j * finToInt r + i) =
      qLine (2 ^ t) (boardLinePair ht F hF i j).1 (boardLinePair ht F hF i j).2 (finToInt r) := by
  classical
  let p := boardLinePair ht F hF i j
  have hspec := (Classical.choose_spec (Classical.choose_spec
    (inScal_reduced_qLine (t := t) (N := N) ht (hF.2 i j))))
  have heq : ∀ n : Fin N, lineRestrict F i j n = qLine (2 ^ t) p.1 p.2 (finToInt n) := by
    simpa [p, boardLinePair] using hspec.2
  have hmain : F r (j * finToInt r + i) = qLine (2 ^ t) p.1 p.2 (finToInt r) := by
    simpa [lineRestrict, finToInt] using heq r
  simpa [p] using hmain

/-- Evaluation of the lift inside the board range: at `n ∈ {1..N}`, `boardToSq F n m` is
`F` at the row whose coordinate is `n`, column `m`. -/
lemma boardToSq_eval {t N : ℕ} (F : SudokuBoard (2 ^ t) N) {n m : ℤ}
    (hn1 : 1 ≤ n) (hnN : n ≤ (N : ℤ)) :
    boardToSq F n m = F (intToFin ⟨n, Finset.mem_Icc.mpr ⟨hn1, hnN⟩⟩) m := by
  unfold boardToSq
  rw [dif_pos (Finset.mem_Icc.mpr ⟨hn1, hnN⟩)]

/-- A board whose square `Q = {n0..n0+7} × {m0..m0+7}` is free of bad cells of every
slope-`{-1,0,1}` line is affine along each such line meeting the window (with coefficients
given by the line's reduced pair). -/
lemma board_square_line_affine {t N : ℕ} (ht : 1 ≤ t) (F : SudokuBoard (2 ^ t) N)
    (hF : IsSudokuSolution (2 ^ t) N F) (n0 m0 : ℤ)
    (hn01 : 1 ≤ n0) (hn7 : n0 + 7 ≤ (N : ℤ)) (hm01 : 1 ≤ m0)
    (hfree : ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∀ x m : ℤ,
        x ∈ Finset.Icc n0 (n0 + 7) → m ∈ Finset.Icc m0 (m0 + 7) →
          ¬ x ∈ badCoset (2 ^ t)
            (boardLinePair ht F hF (m - j * x) j).1
            (boardLinePair ht F hF (m - j * x) j).2) :
    SquareLineAffineOn (boardToSq F) n0 m0 := by
  intro j i hj
  let p := boardLinePair ht F hF i j
  refine ⟨(p.1 : ZMod (2 ^ t)), (p.2 : ZMod (2 ^ t)), ?_⟩
  intro n m hn0 hn1 hm0 hm1 hline
  -- n is a board row coordinate
  have hn1b : 1 ≤ n := le_trans hn01 hn0
  have hnNb : n ≤ (N : ℤ) := le_trans hn1 hn7
  let r : Fin N := intToFin ⟨n, Finset.mem_Icc.mpr ⟨hn1b, hnNb⟩⟩
  have hrn : finToInt r = n := finToInt_intToFin ⟨n, Finset.mem_Icc.mpr ⟨hn1b, hnNb⟩⟩
  have hG : boardToSq F n m = F r m := by
    dsimp [r]
    rw [boardToSq_eval (F := F) hn1b hnNb]
  -- line equation at the row coordinate
  have hline' : m = j * finToInt r + i := by rw [hrn]; exact hline
  have hval := boardLinePair_row_eq (t := t) (N := N) ht F hF i j r
  have hFrm : F r m = qLine (2 ^ t) p.1 p.2 n := by
    rw [hline']
    simpa [p, hrn] using hval
  -- square-free at (n, m) on this line
  have hmemx : n ∈ Finset.Icc n0 (n0 + 7) := Finset.mem_Icc.mpr ⟨hn0, hn1⟩
  have hmemm : m ∈ Finset.Icc m0 (m0 + 7) := Finset.mem_Icc.mpr ⟨hm0, hm1⟩
  have hp_eq : boardLinePair ht F hF (m - j * n) j = p := by
    dsimp [p]
    congr 1
    rw [hline]
    ring
  have hnot := hfree j hj n m hmemx hmemm
  have hnot' : ¬ n ∈ badCoset (2 ^ t) p.1 p.2 := by
    rw [hp_eq] at hnot
    simpa using hnot
  have hq := two_pow_gt_one ht
  have hqline : qLine (2 ^ t) p.1 p.2 n = qAffine (2 ^ t) p.1 p.2 n :=
    qLine_eq_qAffine_of_not_mem_badCoset hq hnot'
  calc
    boardToSq F n m = F r m := hG
    _ = qLine (2 ^ t) p.1 p.2 n := hFrm
    _ = qAffine (2 ^ t) p.1 p.2 n := hqline
    _ = (p.1 : ZMod (2 ^ t)) * (n : ZMod (2 ^ t)) + (p.2 : ZMod (2 ^ t)) := rfl


/-- Evaluation of the lift at a board row: `boardToSq F (rowVal r) m` is exactly
`F r m`. -/
lemma boardToSq_eval_row {t N : ℕ} (F : SudokuBoard (2 ^ t) N) (r : Fin N) (m : ℤ) :
    boardToSq F (rowVal r) m = F r m := by
  classical
  have hmem : rowVal r ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
    simpa [rowVal_eq_finToInt] using (finToInt_mem_window (N := N) r)
  unfold boardToSq
  rw [dif_pos hmem]
  have hid : intToFin ⟨rowVal r, hmem⟩ = r := by
    simpa [rowVal_eq_finToInt] using (intToFin_finToInt (N := N) r)
  rw [hid]

/-- The square-selection output turned into a pseudo-affine function: on the free
`8×8` square, the board agrees with a pseudo-affine `Ψ(n,m) = A n + B m + C +
(q/4) D m (m-n)` evaluated at the row coordinate. -/
theorem board_square_pseudo_affine {t N : ℕ} (ht : 1 ≤ t) (ht2 : 2 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F) (n0 m0 : ℤ)
    (hn01 : 1 ≤ n0) (hn7 : n0 + 7 ≤ (N : ℤ)) (hm01 : 1 ≤ m0)
    (hfree : ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∀ x m : ℤ,
        x ∈ Finset.Icc n0 (n0 + 7) → m ∈ Finset.Icc m0 (m0 + 7) →
          ¬ x ∈ badCoset (2 ^ t)
            (boardLinePair ht F hF (m - j * x) j).1
            (boardLinePair ht F hF (m - j * x) j).2) :
    ∃ A B C D : ZMod (2 ^ t),
      ∀ r : Fin N, ∀ m : ℤ,
        n0 ≤ rowVal r → rowVal r ≤ n0 + 7 → m0 ≤ m → m ≤ m0 + 7 →
          F r m = pseudoAffineVal A B C D (rowVal r) m := by
  classical
  obtain ⟨A, B, C, D, hG⟩ :=
    concat_pseudo_affine_on ht2 n0 m0 (boardToSq F) (board_square_line_affine ht F hF n0 m0 hn01 hn7 hm01 hfree)
  refine ⟨A, B, C, D, ?_⟩
  intro r m hr0 hr7 hm0 hm1
  have hGr := hG (rowVal r) m hr0 hr7 hm0 hm1
  calc
    F r m = boardToSq F (rowVal r) m := (boardToSq_eval_row F r m).symm
    _ = pseudoAffineVal A B C D (rowVal r) m := hGr

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # near-digit 9.4, step (C): rigid-out propagation of good cells along lines

From the pseudo-affine `Ψ` produced on the free square (dev_sqconcat), a cell of the
board is *good* iff `Ψ = 0` or `F = Ψ` there.  The engine of near-digit is: eight good
consecutive cells on any slope-`{-1,0,1}` line force every cell of that line to be
good (`line_all_good_of_window_good`).  It is a direct application of Prop 8.2
(`rigid_out_reduced`, sudoku_rigid_out) to the line's reduced `qLine` representation
(`boardLinePair_row_eq`), whose target affine is the restriction of `Ψ` to the line
(`psi_line_int_coeff`). -/

/-- A cell `(r, m)` is *good* for the pseudo-affine coefficients `(A,B,C,D)`. -/
def GoodCell {t N : ℕ} (A B C D : ZMod (2 ^ t)) (F : SudokuBoard (2 ^ t) N)
    (r : Fin N) (m : ℤ) : Prop :=
  pseudoAffineVal A B C D (rowVal r) m = 0 ∨ F r m = pseudoAffineVal A B C D (rowVal r) m

/-- The restriction of the pseudo-affine function to a slope-`{-1,0,1}` line
`m = j n + i` is affine in `n` with *integer* coefficients (so that it can serve as the
target affine of `rigid_out_reduced`). -/
lemma psi_line_int_coeff {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (j i : ℤ)
    (hj : j = -1 ∨ j = 0 ∨ j = 1) :
    ∃ A0 B0 : ℤ, ∀ n : ℤ,
      pseudoAffineVal A B C D n (j * n + i) = qAffine (2 ^ t) A0 B0 n := by
  classical
  have hzmod : ∃ s0 c0 : ZMod (2 ^ t), ∀ n : ℤ,
      pseudoAffineVal A B C D n (j * n + i) = s0 * (n : ZMod (2 ^ t)) + c0 := by
    rcases hj with rfl | rfl | rfl
    · have ⟨s, c, hv⟩ := pseudoCorr_antidiag_affine ht D i
      refine ⟨A - B + s, B * (i : ZMod (2 ^ t)) + C + c, ?_⟩
      intro n
      have hm : -1 * n + i = i - n := by ring
      rw [hm]
      dsimp [pseudoAffineVal]
      rw [hv]
      simp [Int.cast_sub]
      ring
    · have ⟨s, c, hv⟩ := pseudoCorr_row_affine ht D i
      refine ⟨A + s, B * (i : ZMod (2 ^ t)) + C + c, ?_⟩
      intro n
      have hm : 0 * n + i = i := by ring
      rw [hm]
      dsimp [pseudoAffineVal]
      rw [hv]
      ring
    · have ⟨s, c, hv⟩ := pseudoCorr_diag_affine ht D i
      refine ⟨A + B + s, B * (i : ZMod (2 ^ t)) + C + c, ?_⟩
      intro n
      have hm : 1 * n + i = n + i := by ring
      rw [hm]
      dsimp [pseudoAffineVal]
      rw [hv]
      simp [Int.cast_add]
      ring
  rcases hzmod with ⟨s0, c0, hs⟩
  refine ⟨(s0.val : ℤ), (c0.val : ℤ), ?_⟩
  intro n
  calc
    pseudoAffineVal A B C D n (j * n + i) = s0 * (n : ZMod (2 ^ t)) + c0 := hs n
    _ = ((s0.val : ℕ) : ZMod (2 ^ t)) * (n : ZMod (2 ^ t))
        + ((c0.val : ℕ) : ZMod (2 ^ t)) := by
          rw [ZMod.natCast_zmod_val s0, ZMod.natCast_zmod_val c0]
    _ = qAffine (2 ^ t) (s0.val : ℤ) (c0.val : ℤ) n := by
          simp [qAffine]

/-- Eight good consecutive cells on a slope-`{-1,0,1}` line force every cell of the
line to be good (Prop 8.2 rigid-out applied to the line). -/
theorem line_all_good_of_window_good {t N : ℕ} (ht : 3 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t)) (j i n0 : ℤ) (hj : j = -1 ∨ j = 0 ∨ j = 1)
    (hwin1 : 1 ≤ n0) (hwin2 : n0 + 7 ≤ (N : ℤ))
    (hgoodwin : ∀ r : Fin N, rowInWindow n0 r → GoodCell A B C D F r (j * rowVal r + i)) :
    ∀ r : Fin N, GoodCell A B C D F r (j * rowVal r + i) := by
  classical
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  obtain ⟨A0, B0, hline⟩ := psi_line_int_coeff ht2 A B C D j i hj
  let a : ℤ := (boardLinePair ht1 F hF i j).1
  let b : ℤ := (boardLinePair ht1 F hF i j).2
  have hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a ∧ ((2 ^ t : ℕ) : ℤ) ∣ b) := by
    simpa [a, b] using boardLinePair_hred ht1 F hF i j
  have heq : ∀ r : Fin N, F r (j * finToInt r + i) = qLine (2 ^ t) a b (finToInt r) := by
    intro r
    simpa [a, b] using boardLinePair_row_eq (t := t) (N := N) ht1 F hF i j r
  have hΨline : ∀ n : ℤ, pseudoAffineVal A B C D n (j * n + i) = qAffine (2 ^ t) A0 B0 n := hline
  have hagree : ∀ r : Fin N, n0 ≤ finToInt r → finToInt r ≤ n0 + 7 →
      qAffine (2 ^ t) A0 B0 (finToInt r) ≠ 0 →
      qLine (2 ^ t) a b (finToInt r) = qAffine (2 ^ t) A0 B0 (finToInt r) := by
    intro r hr0 hr7 hα
    have hwin : rowInWindow n0 r := by
      rw [rowInWindow_iff_mem, Finset.mem_Icc]
      rw [rowVal_eq_finToInt]
      exact ⟨hr0, hr7⟩
    have hg := hgoodwin r hwin
    have hαrow : qAffine (2 ^ t) A0 B0 (rowVal r) ≠ 0 := by
      simpa [rowVal_eq_finToInt] using hα
    rcases hg with hzero | hval
    · exfalso
      apply hαrow
      rw [← hΨline (rowVal r)]
      exact hzero
    · -- hval : F r (j·rowVal r + i) = Ψ(rowVal r, j·rowVal r + i)
      calc
        qLine (2 ^ t) a b (finToInt r) = F r (j * finToInt r + i) := (heq r).symm
        _ = F r (j * rowVal r + i) := by rw [rowVal_eq_finToInt]
        _ = pseudoAffineVal A B C D (rowVal r) (j * rowVal r + i) := hval
        _ = qAffine (2 ^ t) A0 B0 (rowVal r) := hΨline (rowVal r)
        _ = qAffine (2 ^ t) A0 B0 (finToInt r) := by rw [rowVal_eq_finToInt]
  have hall := rigid_out_reduced (t := t) (N := N) ht a b A0 B0 n0 hred hwin1 hwin2 hagree
  intro r
  by_cases hΨ0 : pseudoAffineVal A B C D (rowVal r) (j * rowVal r + i) = 0
  · exact Or.inl hΨ0
  · right
    have hα : qAffine (2 ^ t) A0 B0 (finToInt r) ≠ 0 := by
      intro hz
      apply hΨ0
      have hz' : qAffine (2 ^ t) A0 B0 (rowVal r) = 0 := by
        simpa [rowVal_eq_finToInt] using hz
      rw [hΨline (rowVal r)]
      exact hz'
    have hR := hall r hα
    calc
      F r (j * rowVal r + i) = F r (j * finToInt r + i) := by rw [rowVal_eq_finToInt]
      _ = qLine (2 ^ t) a b (finToInt r) := heq r
      _ = qAffine (2 ^ t) A0 B0 (finToInt r) := hR
      _ = pseudoAffineVal A B C D (finToInt r) (j * finToInt r + i) := (hΨline (finToInt r)).symm
      _ = pseudoAffineVal A B C D (rowVal r) (j * rowVal r + i) := by rw [rowVal_eq_finToInt]


/-! ## Rectangle extension: eight good full rows of columns `[c, c+7]` give the next
column `c+8` (upward) and `c−1` (downward), via diagonal and anti-diagonal lines. -/

/-- A board row's coordinate lies in `{1..N}`. -/
lemma rowVal_bounds {N : ℕ} (r : Fin N) :
    1 ≤ rowVal r ∧ rowVal r ≤ (N : ℤ) := by
  have hw := finToInt_mem_window (N := N) r
  rw [Finset.mem_Icc] at hw
  rw [rowVal_eq_finToInt]
  exact hw

/-- If all cells of columns `c..c+7` are good, then all cells of column `c+8` are good
(upward extension; the square's top row is `c+7`, so this is the paper's "apply to the
diagonals / anti-diagonals" step). -/
theorem col_above_of_rectangle {t N : ℕ} (ht : 3 ≤ t) (hN16 : 16 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t)) (c : ℤ)
    (hcol : ∀ r : Fin N, ∀ m : ℤ, c ≤ m → m ≤ c + 7 → GoodCell A B C D F r m) :
    ∀ r : Fin N, GoodCell A B C D F r (c + 8) := by
  classical
  intro r
  let n : ℤ := rowVal r
  have hn1 : 1 ≤ n := (rowVal_bounds r).1
  have hnN : n ≤ (N : ℤ) := (rowVal_bounds r).2
  have hn8 : n ≤ 8 ∨ 9 ≤ n := by omega
  rcases hn8 with hn8 | hn9
  · -- small rows n ≤ 8: anti-diagonal of intercept i = c + 8 + n through (r, c+8),
    -- window rows n' ∈ [n+1, n+8] have columns in [c, c+7]
    let i : ℤ := c + 8 + n
    have hn0 : 1 ≤ n + 1 := by omega
    have hn7 : n + 1 + 7 ≤ (N : ℤ) := by omega
    have hwin : ∀ w : Fin N, rowInWindow (n + 1) w →
        GoodCell A B C D F w ((-1) * rowVal w + i) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      apply hcol w ((-1) * rowVal w + i)
      · omega
      · omega
    have hall := line_all_good_of_window_good (t := t) (N := N) ht F hF A B C D (-1) i (n + 1)
      (Or.inl rfl) hn0 hn7 hwin
    have hcell := hall r
    have hid : (-1) * rowVal r + i = c + 8 := by
      dsimp [i]
      omega
    rwa [hid] at hcell
  · -- large rows n ≥ 9: diagonal of intercept i = c + 8 − n through (r, c+8),
    -- window rows n' ∈ [n−8, n−1] have columns in [c, c+7]
    let i : ℤ := c + 8 - n
    have hn0 : 1 ≤ n - 8 := by omega
    have hn7 : n - 8 + 7 ≤ (N : ℤ) := by omega
    have hwin : ∀ w : Fin N, rowInWindow (n - 8) w →
        GoodCell A B C D F w (1 * rowVal w + i) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      apply hcol w (1 * rowVal w + i)
      · omega
      · omega
    have hall := line_all_good_of_window_good (t := t) (N := N) ht F hF A B C D 1 i (n - 8)
      (Or.inr (Or.inr rfl)) hn0 hn7 hwin
    have hcell := hall r
    have hid : 1 * rowVal r + i = c + 8 := by
      dsimp [i]
      omega
    rwa [hid] at hcell

/-- If all cells of columns `c..c+7` are good, then all cells of column `c−1` are good
(downward extension). -/
theorem col_below_of_rectangle {t N : ℕ} (ht : 3 ≤ t) (hN16 : 16 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t)) (c : ℤ)
    (hcol : ∀ r : Fin N, ∀ m : ℤ, c ≤ m → m ≤ c + 7 → GoodCell A B C D F r m) :
    ∀ r : Fin N, GoodCell A B C D F r (c - 1) := by
  classical
  intro r
  let n : ℤ := rowVal r
  have hn1 : 1 ≤ n := (rowVal_bounds r).1
  have hnN : n ≤ (N : ℤ) := (rowVal_bounds r).2
  have hN16z : (16 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN16
  by_cases hsmall : n + 8 ≤ (N : ℤ)
  · -- diagonal of intercept i = c − 1 − n through (r, c−1), window rows n' ∈ [n+1, n+8]
    let i : ℤ := c - 1 - n
    have hn0 : 1 ≤ n + 1 := by omega
    have hn7 : n + 1 + 7 ≤ (N : ℤ) := by omega
    have hwin : ∀ w : Fin N, rowInWindow (n + 1) w →
        GoodCell A B C D F w (1 * rowVal w + i) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      apply hcol w (1 * rowVal w + i)
      · omega
      · omega
    have hall := line_all_good_of_window_good (t := t) (N := N) ht F hF A B C D 1 i (n + 1)
      (Or.inr (Or.inr rfl)) hn0 hn7 hwin
    have hcell := hall r
    have hid : 1 * rowVal r + i = c - 1 := by
      dsimp [i]
      omega
    rwa [hid] at hcell
  · -- n ≥ N−7 ≥ 9: anti-diagonal of intercept i = c − 1 + n, window rows n' ∈ [n−8, n−1]
    have hn9 : 9 ≤ n := by omega
    let i : ℤ := c - 1 + n
    have hn0 : 1 ≤ n - 8 := by omega
    have hn7 : n - 8 + 7 ≤ (N : ℤ) := by omega
    have hwin : ∀ w : Fin N, rowInWindow (n - 8) w →
        GoodCell A B C D F w ((-1) * rowVal w + i) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      apply hcol w ((-1) * rowVal w + i)
      · omega
      · omega
    have hall := line_all_good_of_window_good (t := t) (N := N) ht F hF A B C D (-1) i (n - 8)
      (Or.inl rfl) hn0 hn7 hwin
    have hcell := hall r
    have hid : (-1) * rowVal r + i = c - 1 := by
      dsimp [i]
      omega
    rwa [hid] at hcell

/-- A rectangle `{1..N} × [c, c+7]` of good cells extends to every column: all cells of
the board are good. (Upward/downward induction with `col_above/below_of_rectangle`.) -/
theorem rectangle_extend_all {t N : ℕ} (ht : 3 ≤ t) (hN16 : 16 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t)) (m0 : ℤ)
    (hrect : ∀ r : Fin N, ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 → GoodCell A B C D F r m) :
    ∀ r : Fin N, ∀ m : ℤ, GoodCell A B C D F r m := by
  classical
  -- upward: columns ≥ m0 (induction over d : ℕ with interval [m0, m0+7+d])
  have hup : ∀ d : ℕ, ∀ r : Fin N, ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 + (d : ℤ) →
      GoodCell A B C D F r m := by
    intro d
    induction d with
    | zero =>
        intro r m hm0 hm7
        exact hrect r m hm0 (by simpa using hm7)
    | succ d ih =>
        intro r m hm0 hm_high
        by_cases hle : m ≤ m0 + 7 + (d : ℤ)
        · exact ih r m hm0 hle
        · -- m = m0 + 8 + d = (m0 + d) + 8, the column produced by the d-th rectangle
          have hsrc : ∀ r' : Fin N, ∀ m' : ℤ, m0 + (d : ℤ) ≤ m' → m' ≤ m0 + (d : ℤ) + 7 →
              GoodCell A B C D F r' m' := by
            intro r' m' hm1 hm2
            exact ih r' m' (by omega) (by omega)
          have hnew := col_above_of_rectangle (t := t) (N := N) ht hN16 F hF A B C D (m0 + (d : ℤ)) hsrc
          have htarget : m = m0 + 8 + (d : ℤ) := by omega
          rw [htarget]
          have hcol : GoodCell A B C D F r (m0 + (d : ℤ) + 8) := hnew r
          simpa [show m0 + (d : ℤ) + 8 = m0 + 8 + (d : ℤ) by omega] using hcol
  -- downward: columns ≤ m0+7 (induction over d with interval [m0−d, m0+7])
  have hdown : ∀ d : ℕ, ∀ r : Fin N, ∀ m : ℤ, m0 - (d : ℤ) ≤ m → m ≤ m0 + 7 →
      GoodCell A B C D F r m := by
    intro d
    induction d with
    | zero =>
        intro r m hm0 hm7
        exact hrect r m (by simpa using hm0) hm7
    | succ d ih =>
        intro r m hm_low hm7
        by_cases hge : m0 - (d : ℤ) ≤ m
        · exact ih r m hge hm7
        · -- m = m0 − d − 1 = (m0 − d) − 1, produced from the rectangle at m0 − d
          have hsrc : ∀ r' : Fin N, ∀ m' : ℤ, m0 - (d : ℤ) ≤ m' → m' ≤ m0 - (d : ℤ) + 7 →
              GoodCell A B C D F r' m' := by
            intro r' m' hm1 hm2
            exact ih r' m' hm1 (by omega)
          have hnew := col_below_of_rectangle (t := t) (N := N) ht hN16 F hF A B C D (m0 - (d : ℤ)) hsrc
          have htarget : m = m0 - (d : ℤ) - 1 := by omega
          rw [htarget]
          have hcol : GoodCell A B C D F r (m0 - (d : ℤ) - 1) := hnew r
          simpa using hcol
  intro r m
  by_cases hm0 : m0 ≤ m
  · -- m ≥ m0: pick d := m − m0
    by_cases hle : m ≤ m0 + 7
    · exact hrect r m hm0 hle
    · let d : ℕ := Int.toNat (m - m0)
      have hd : (d : ℤ) = m - m0 := by
        dsimp [d]
        rw [Int.toNat_of_nonneg]
        omega
      have hup' := hup d r m
      have hm' : m ≤ m0 + 7 + (d : ℤ) := by rw [hd]; omega
      exact hup' hm0 hm'
  · -- m < m0: pick d := m0 − m ≥ 1
    let d : ℕ := Int.toNat (m0 - m)
    have hd : (d : ℤ) = m0 - m := by
      dsimp [d]
      rw [Int.toNat_of_nonneg]
      omega
    have hdown' := hdown d r m
    have hm' : m0 - (d : ℤ) ≤ m := by rw [hd]; omega
    exact hdown' hm' (by omega)

/-- Good cells with non-vanishing `Ψ` force `F = Ψ`: the board agrees with the
pseudo-affine function wherever the latter is non-zero. -/
theorem agree_of_all_good {t N : ℕ} (A B C D : ZMod (2 ^ t))
    (F : SudokuBoard (2 ^ t) N)
    (hallgood : ∀ r : Fin N, ∀ m : ℤ, GoodCell A B C D F r m) :
    ∀ r : Fin N, ∀ m : ℤ, pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
      F r m = pseudoAffineVal A B C D (rowVal r) m := by
  intro r m hΨ
  rcases hallgood r m with hzero | hval
  · exfalso
    exact hΨ hzero
  · exact hval

/-! ## near-digit: assembling the pseudo-affine structure proposition -/

/-- Proposition near-digit (arXiv:2211.15847, tex 1341-1370), finite form over a
generic width `N` satisfying the square-selection inequality: every good-columns
Sudoku solution of width `N` has a pseudo-affine function
`Ψ(n,m) = A n + B m + C + (q/4) D m (m-n)` which is non-zero at some cell and agrees
with `F` at every cell where it is non-zero. -/
theorem near_digit_main_generic {t N : ℕ} (ht1 : 1 ≤ t) (ht3 : 3 ≤ t) (hN16 : 16 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F)
    (hineq : 3 * t * 128 * rareConst t N N < (N - 7) * (N - 7)) :
    ∃ A B C D : ZMod (2 ^ t),
      (∃ r0 : Fin N, ∃ m0 : ℤ,
        pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0) ∧
      ∀ r : Fin N, ∀ m : ℤ,
        pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
          F r m = pseudoAffineVal A B C D (rowVal r) m := by
  classical
  have ht2 : 2 ≤ t := by omega
  have hN8 : 8 ≤ N := by omega
  -- (A) locate the free square
  obtain ⟨n0, m0, hn01, hn7, hm01, hm7, hfree⟩ :=
    exists_square_free_badCells (t := t) (N := N) (M := N) ht1 hN8 hN8 F hF hgood hineq
  -- (B) pseudo-affine Ψ agreeing with F on the square
  obtain ⟨A, B, C, D, hOnSquare⟩ := board_square_pseudo_affine (t := t) (N := N)
    ht1 ht2 F hF n0 m0 hn01 hn7 hm01 hfree
  -- (C) every square cell is good (F = Ψ there)
  have hsquare_good : ∀ r : Fin N, ∀ m : ℤ,
      n0 ≤ rowVal r → rowVal r ≤ n0 + 7 → m0 ≤ m → m ≤ m0 + 7 →
        GoodCell A B C D F r m := by
    intro r m hr0 hr7 hm0 hm1
    right
    exact hOnSquare r m hr0 hr7 hm0 hm1
  -- each column m ∈ [m0, m0+7]: all rows good (horizontal rigid-out)
  have hrow : ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 → ∀ r : Fin N, GoodCell A B C D F r m := by
    intro m hm0 hm1 r
    have hgoodwin : ∀ w : Fin N, rowInWindow n0 w →
        GoodCell A B C D F w (0 * rowVal w + m) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      have hg := hsquare_good w m hw.1 hw.2 hm0 hm1
      simpa using hg
    have hall := line_all_good_of_window_good (t := t) (N := N) ht3 F hF A B C D 0 m n0
      (Or.inr (Or.inl rfl)) hn01 hn7 hgoodwin
    have hc := hall r
    simpa using hc
  -- rectangle → all columns → all cells good
  have hrect : ∀ r : Fin N, ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 → GoodCell A B C D F r m := by
    intro r m hm0 hm1
    exact hrow m hm0 hm1 r
  have hallgood : ∀ r : Fin N, ∀ m : ℤ, GoodCell A B C D F r m :=
    rectangle_extend_all (t := t) (N := N) ht3 hN16 F hF A B C D m0 hrect
  refine ⟨A, B, C, D, ?_, ?_⟩
  · -- Ψ ≠ 0 at (r0, m0): pick r0 := the row of coordinate n0
    have hn0N : n0 ≤ (N : ℤ) := le_trans (by omega : n0 ≤ n0 + 7) hn7
    obtain ⟨r0, hr0⟩ := exists_row_rowVal (N := N) n0 hn01 hn0N
    refine ⟨r0, m0, ?_⟩
    intro hΨ0
    have hA : n0 ≤ rowVal r0 := by omega
    have hB : rowVal r0 ≤ n0 + 7 := by omega
    have hcell := hOnSquare r0 m0 hA hB (by omega) (by omega)
    have hF0 : F r0 m0 ≠ 0 := hF.1 r0 m0
    rw [hcell] at hF0
    exact hF0 hΨ0
  · exact agree_of_all_good (N := N) A B C D F hallgood

/-- Proposition near-digit specialised to the width `N = q² = 2^{2t}` used in the
Sudoku section (`q = 2^t`, `t ≥ 24`). -/
theorem near_digit_main {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ (2 * t)))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ (2 * t)) F)
    (hgood : HasGoodColumns (2 ^ t) (2 ^ (2 * t)) F) :
    ∃ A B C D : ZMod (2 ^ t),
      (∃ r0 : Fin (2 ^ (2 * t)), ∃ m0 : ℤ,
        pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0) ∧
      ∀ r : Fin (2 ^ (2 * t)), ∀ m : ℤ,
        pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
          F r m = pseudoAffineVal A B C D (rowVal r) m := by
  classical
  have ht1 : 1 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have hN16 : 16 ≤ 2 ^ (2 * t) := by
    have h6 : 6 ≤ 2 * t := by omega
    exact le_trans (by norm_num : (16 : ℕ) ≤ 2 ^ 6) (pow_le_pow_right₀ (by norm_num) h6)
  have hineq : 3 * t * 128 * rareConst t (2 ^ (2 * t)) (2 ^ (2 * t)) <
      (2 ^ (2 * t) - 7) * (2 ^ (2 * t) - 7) := rareConst_ineq_24 t ht24
  exact near_digit_main_generic (t := t) (N := 2 ^ (2 * t)) ht1 ht3 hN16 F hF hgood hineq

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Prop is-odd (arXiv:2211.15847, tex 1356-1384)

From near-digit, a good-columns Sudoku solution agrees with a pseudo-affine
`Ψ(n,m) = A n + B m + C + (q/4) D m (m-n)` off the zeros of `Ψ`.  Prop is-odd: the
vertical coefficient `B` is odd.  This file develops the value algebra of the vertical
function `V(m) := Ψ(n₀, m)` at a fixed row coordinate `n₀` and then assembles the
good-columns contradiction. -/

/-- `(q/4)·4 = 0` in `ZMod (2^t)` (`t ≥ 2`): the quartic coefficient is 4-torsion. -/
lemma qFourth_mul_four {t : ℕ} (ht : 2 ≤ t) :
    (qFourth t : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := by
  dsimp [qFourth]
  change ((2 ^ (t - 2) : ℕ) : ZMod (2 ^ t)) * ((4 : ℕ) : ZMod (2 ^ t)) = 0
  rw [← Nat.cast_mul]
  have hpow : 2 ^ (t - 2) * 4 = 2 ^ t := by
    rw [show 4 = 2 ^ 2 by norm_num, ← pow_add]
    congr 1
    omega
  rw [hpow]
  exact ZMod.natCast_self (2 ^ t)

/-- The vertical function `V(m) := Ψ(n₀, m)` (pseudo-affine value at fixed row `n₀`). -/
def vFunc {t : ℕ} (A B C D : ZMod (2 ^ t)) (n0 : ℤ) : ℤ → ZMod (2 ^ t) :=
  fun m => pseudoAffineVal A B C D n0 m

/-- `V(m+4) = V(m) + 4B`: shifting the column by `4` adds `4B` (the quadratic part of
the pseudo-affine correction is invisible under a `4`-shift). -/
lemma vFunc_shift_four {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m : ℤ) :
    vFunc A B C D n0 (m + 4) = vFunc A B C D n0 m + (4 : ZMod (2 ^ t)) * B := by
  dsimp [vFunc, pseudoAffineVal, pseudoCorr]
  let u : ZMod (2 ^ t) := (m : ZMod (2 ^ t))
  let v : ZMod (2 ^ t) := (n0 : ZMod (2 ^ t))
  have hcast : ((m + 4 : ℤ) : ZMod (2 ^ t)) = u + (4 : ZMod (2 ^ t)) := by
    rw [Int.cast_add]
    dsimp [u]
    norm_num
  rw [hcast]
  have h4 : (qFourth t : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := qFourth_mul_four ht
  have hD : (qFourth t * D) * (u + 4) * ((u + 4) - v)
      = (qFourth t * D) * u * (u - v) := by
    have hz : (qFourth t * D) * (4 * (2 * u + 4 - v)) = 0 := by
      calc
        (qFourth t * D) * (4 * (2 * u + 4 - v))
            = ((qFourth t * D) * 4) * (2 * u + 4 - v) := by ring
        _ = ((qFourth t) * (4 : ZMod (2 ^ t)) * D) * (2 * u + 4 - v) := by ring
        _ = 0 := by rw [h4]; simp
    calc
      (qFourth t * D) * (u + 4) * ((u + 4) - v)
          = (qFourth t * D) * u * (u - v) + (qFourth t * D) * (4 * (2 * u + 4 - v)) := by ring
      _ = (qFourth t * D) * u * (u - v) := by rw [hz]; ring
  rw [hD]
  ring

/-- Iterating the `4`-shift: `V(m + 4k) = V(m) + (4k)·B` for every `k : ℕ`. -/
lemma vFunc_shift_four_mul {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t))
    (n0 m : ℤ) (k : ℕ) :
    vFunc A B C D n0 (m + 4 * (k : ℤ)) =
      vFunc A B C D n0 m + ((4 * k : ℕ) : ZMod (2 ^ t)) * B := by
  induction k with
  | zero => simp [vFunc]
  | succ k ih =>
      calc
        vFunc A B C D n0 (m + 4 * ((k + 1 : ℕ) : ℤ))
            = vFunc A B C D n0 (m + 4 * (k : ℤ) + 4) := by
                congr 1
                norm_num
                ring
        _ = vFunc A B C D n0 (m + 4 * (k : ℤ)) + (4 : ZMod (2 ^ t)) * B := by
                exact vFunc_shift_four ht A B C D n0 (m + 4 * (k : ℤ))
        _ = vFunc A B C D n0 m + ((4 * k : ℕ) : ZMod (2 ^ t)) * B
              + (4 : ZMod (2 ^ t)) * B := by rw [ih]
        _ = vFunc A B C D n0 m + ((4 * (k + 1) : ℕ) : ZMod (2 ^ t)) * B := by
                rw [Nat.mul_succ]
                norm_num
                ring

/-- For an even coefficient `B`, multiplying by `q/2` vanishes: `Even B.val` implies
`B · (qHalf t) = 0` (`t ≥ 1`). -/
lemma even_mul_qHalf_zero {t : ℕ} (ht : 1 ≤ t) (B : ZMod (2 ^ t)) (hB : Even B.val) :
    B * qHalf t = 0 := by
  haveI : NeZero (2 ^ t) := ⟨pow_ne_zero t (by norm_num)⟩
  rcases hB with ⟨k, hk⟩
  have hk2 : B.val = 2 * k := by omega
  have hprod : B.val * 2 ^ (t - 1) = 2 ^ t * k := by
    rw [hk2]
    calc
      (2 * k) * 2 ^ (t - 1) = k * (2 * 2 ^ (t - 1)) := by ring
      _ = k * 2 ^ t := by
            congr 1
            rw [show t = 1 + (t - 1) by omega, pow_add]
            norm_num
      _ = 2 ^ t * k := by ring
  have hB' : B = ((B.val : ℕ) : ZMod (2 ^ t)) := (ZMod.natCast_zmod_val B).symm
  rw [hB']
  change ((B.val : ℕ) : ZMod (2 ^ t)) * ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) = 0
  rw [← Nat.cast_mul]
  rw [hprod]
  have hz : ((2 ^ t : ℕ) : ZMod (2 ^ t)) = 0 := ZMod.natCast_self (2 ^ t)
  rw [Nat.cast_mul]
  rw [mul_comm]
  rw [hz]
  simp

/-- If `B` is even then the vertical function `V(m) := Ψ(n₀, m)` is `q/2`-periodic in
the column (for `t ≥ 3`). -/
lemma vFunc_qhalf_period_of_even {t : ℕ} (ht : 3 ≤ t) (A B C D : ZMod (2 ^ t))
    (hB : Even B.val) (n0 m : ℤ) :
    vFunc A B C D n0 (m + (qHalf t).val) = vFunc A B C D n0 m := by
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  let k : ℕ := 2 ^ (t - 3)
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  have hk4 : 4 * k = 2 ^ (t - 1) := by
    dsimp [k]
    rw [show 4 = 2 ^ 2 by norm_num, ← pow_add]
    congr 1
    omega
  have hq4 : (qHalf t).val = 4 * k := by
    rw [hk4]
    exact hval
  have hcast : (m + (qHalf t).val : ℤ) = m + 4 * (k : ℤ) := by
    have hz : ((qHalf t).val : ℤ) = ((4 * k : ℕ) : ℤ) := by exact_mod_cast hq4
    rw [hz]
    rw [Nat.cast_mul]
    norm_num
  have hv := vFunc_shift_four_mul ht2 A B C D n0 m k
  have hR : ((4 * k : ℕ) : ZMod (2 ^ t)) = qHalf t := by
    rw [show 4 * k = 2 ^ (t - 1) by exact hk4]
  calc
    vFunc A B C D n0 (m + (qHalf t).val) = vFunc A B C D n0 (m + 4 * (k : ℤ)) := by rw [hcast]
    _ = vFunc A B C D n0 m + ((4 * k : ℕ) : ZMod (2 ^ t)) * B := hv
    _ = vFunc A B C D n0 m := by
          rw [hR]
          rw [mul_comm]
          rw [even_mul_qHalf_zero ht1 B hB]
          simp

/-- The `4`-shift iterate with an integer index `k ∈ ℤ`:
`V(e + 4k) = V(e) + ((4k : ℤ) : ZMod) · B`. -/
lemma vFunc_shift_four_z {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t))
    (n0 e : ℤ) (k : ℤ) :
    vFunc A B C D n0 (e + 4 * k) = vFunc A B C D n0 e + (((4 * k : ℤ) : ZMod (2 ^ t))) * B := by
  classical
  by_cases hk : 0 ≤ k
  · let kk : ℕ := k.toNat
    have hk' : (kk : ℤ) = k := by
      dsimp [kk]
      exact Int.toNat_of_nonneg hk
    have hv := vFunc_shift_four_mul ht A B C D n0 e kk
    calc
      vFunc A B C D n0 (e + 4 * k) = vFunc A B C D n0 (e + 4 * (kk : ℤ)) := by
          rw [← hk']
      _ = vFunc A B C D n0 e + ((4 * kk : ℕ) : ZMod (2 ^ t)) * B := hv
      _ = vFunc A B C D n0 e + (((4 * k : ℤ) : ZMod (2 ^ t))) * B := by
          have hc : ((4 * kk : ℕ) : ZMod (2 ^ t)) = (((4 * k : ℤ) : ZMod (2 ^ t))) := by
            rw [← hk']
            simp
          rw [hc]
  · have hkneg : k ≤ 0 := by omega
    let kk : ℕ := (-k).toNat
    have hk' : (kk : ℤ) = -k := by
      dsimp [kk]
      exact Int.toNat_of_nonneg (by omega)
    have hk'' : k = - (kk : ℤ) := by omega
    have hv := vFunc_shift_four_mul ht A B C D n0 (e + 4 * k) kk
    have harg : e + 4 * k + 4 * (kk : ℤ) = e := by rw [hk'']; ring
    have hv' : vFunc A B C D n0 e = vFunc A B C D n0 (e + 4 * k) + ((4 * kk : ℕ) : ZMod (2 ^ t)) * B := by
      rw [harg] at hv
      exact hv
    have hz : ((4 * kk : ℕ) : ZMod (2 ^ t)) = -(((4 * k : ℤ) : ZMod (2 ^ t))) := by
      rw [hk'']
      simp
    calc
      vFunc A B C D n0 (e + 4 * k) = vFunc A B C D n0 e - ((4 * kk : ℕ) : ZMod (2 ^ t)) * B := by
          rw [hv']
          abel
      _ = vFunc A B C D n0 e + (((4 * k : ℤ) : ZMod (2 ^ t))) * B := by
          rw [hz]
          ring

/-- An odd integer is a unit in `ZMod (2^t)` (`t ≥ 1`). -/
lemma zmod_unit_of_odd_int {t : ℕ} (ht : 1 ≤ t) (u : ℤ) (hu : Odd u) :
    IsUnit (u : ZMod (2 ^ t)) := by
  have hm : ∃ s : ℕ, 2 ^ t = 2 ^ (s + 1) := by
    refine ⟨t - 1, ?_⟩
    congr 1
    omega
  exact zmod_isUnit_of_odd (Int.natAbs_odd.mpr hu) hm

/-- Cast of a product of integers into `ZMod (2^t)` is the product of the casts. -/
lemma intCast_mul_zmod {t : ℕ} (a b : ℤ) :
    (((a * b : ℤ) : ZMod (2 ^ t))) = (((a : ℤ) : ZMod (2 ^ t))) * (((b : ℤ) : ZMod (2 ^ t))) := by
  rw [Int.cast_mul]

/-- A non-vanishing point of the vertical function lies on a zero-free `8ℤ`-coset:
either every element of `m₀ + 8ℤ` is non-zero, or every element of `m₀ + 4 + 8ℤ` is. -/
lemma vertical_zero_free_8coset {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t))
    (n0 m0 : ℤ) (hV : vFunc A B C D n0 m0 ≠ 0) :
    (∀ m : ℤ, ((8 : ℤ) ∣ m - m0) → vFunc A B C D n0 m ≠ 0) ∨
    (∀ m : ℤ, ((8 : ℤ) ∣ m - (m0 + 4)) → vFunc A B C D n0 m ≠ 0) := by
  classical
  by_contra h
  push Not at h
  rcases h with ⟨h1, h2⟩
  rcases h1 with ⟨x, hx, hx0⟩
  rcases h2 with ⟨y, hy, hy0⟩
  rcases hx with ⟨tx, htx⟩
  rcases hy with ⟨ty, hty⟩
  let k : ℤ := 1 + 2 * (ty - tx)
  have hxlin : x = m0 + 8 * tx := by omega
  have hylin : y = m0 + 4 + 8 * ty := by omega
  have hdif : y - x = 4 * k := by
    dsimp [k]
    rw [hylin, hxlin]
    ring
  have hkodd : Odd k := by
    dsimp [k]
    exact ⟨ty - tx, by ring⟩
  -- V(x) = V(m0) + ((8 tx):ZMod)·B, and V(x) = 0
  have hxarg : m0 + 4 * (2 * tx) = x := by omega
  have hshx := vFunc_shift_four_z ht A B C D n0 m0 (2 * tx)
  have hcoef8 : (((4 * (2 * tx) : ℤ) : ZMod (2 ^ t))) = (((8 * tx : ℤ) : ZMod (2 ^ t))) := by
    congr 1
    ring
  have hVx_rel : vFunc A B C D n0 x = vFunc A B C D n0 m0 + (((8 * tx : ℤ) : ZMod (2 ^ t))) * B := by
    rw [← hxarg]
    rw [← hcoef8]
    exact hshx
  have hV0 : vFunc A B C D n0 m0 = -((((8 * tx : ℤ) : ZMod (2 ^ t))) * B) := by
    rw [hVx_rel] at hx0
    rw [eq_neg_iff_add_eq_zero]
    exact hx0
  -- V(y) = V(m0+4) + ((8 ty):ZMod)·B, V(m0+4) = V(m0) + 4B
  have hyarg : m0 + 4 + 4 * (2 * ty) = y := by omega
  have hshy := vFunc_shift_four_z ht A B C D n0 (m0 + 4) (2 * ty)
  have hcoef8y : (((4 * (2 * ty) : ℤ) : ZMod (2 ^ t))) = (((8 * ty : ℤ) : ZMod (2 ^ t))) := by
    congr 1
    ring
  have hVy_rel : vFunc A B C D n0 y = vFunc A B C D n0 (m0 + 4) + (((8 * ty : ℤ) : ZMod (2 ^ t))) * B := by
    rw [← hyarg]
    rw [← hcoef8y]
    exact hshy
  have hV4 : vFunc A B C D n0 (m0 + 4) = vFunc A B C D n0 m0 + (4 : ZMod (2 ^ t)) * B :=
    vFunc_shift_four ht A B C D n0 m0
  have hsum : -((((8 * tx : ℤ) : ZMod (2 ^ t))) * B) + (4 : ZMod (2 ^ t)) * B
      + (((8 * ty : ℤ) : ZMod (2 ^ t))) * B = 0 := by
    rw [← hV0, ← hV4, ← hVy_rel]
    exact hy0
  -- 4B·k = 0 and k odd ⇒ 4B = 0
  have hk4z : ((4 : ZMod (2 ^ t)) * B) * (k : ZMod (2 ^ t)) = 0 := by
    have hc : -((((8 * tx : ℤ) : ZMod (2 ^ t))) * B) + (4 : ZMod (2 ^ t)) * B
        + (((8 * ty : ℤ) : ZMod (2 ^ t))) * B = ((4 : ZMod (2 ^ t)) * B) * (k : ZMod (2 ^ t)) := by
      dsimp [k]
      simp only [Int.cast_mul, Int.cast_sub, Int.cast_add, Int.cast_ofNat]
      ring
    rw [← hc]
    exact hsum
  have h4B : (4 : ZMod (2 ^ t)) * B = 0 := by
    have hkunit : IsUnit (k : ZMod (2 ^ t)) := zmod_unit_of_odd_int (by omega : 1 ≤ t) k hkodd
    rcases (IsUnit.exists_right_inv hkunit) with ⟨a, ha⟩
    calc
      (4 : ZMod (2 ^ t)) * B = ((4 : ZMod (2 ^ t)) * B) * ((k : ZMod (2 ^ t)) * a) := by rw [ha]; simp
      _ = (((4 : ZMod (2 ^ t)) * B) * (k : ZMod (2 ^ t))) * a := by ring
      _ = 0 := by rw [hk4z]; simp
  -- V(m0) = −((8tx):ZMod)·B and (8 tx)·B = (2 tx)·(4·B) = 0
  have hkill : (((8 * tx : ℤ) : ZMod (2 ^ t))) * B = 0 := by
    have hz : (8 * tx : ℤ) = (2 * tx) * (4 : ℤ) := by ring
    rw [hz, intCast_mul_zmod (2 * tx) (4 : ℤ)]
    have hnorm : ((↑(2 * tx : ℤ) : ZMod (2 ^ t)) * (↑(4 : ℤ) : ZMod (2 ^ t))) * B
        = (↑(2 * tx : ℤ) : ZMod (2 ^ t)) * ((4 : ZMod (2 ^ t)) * B) := by
          rw [Int.cast_ofNat]
          ring
    rw [hnorm]
    rw [h4B]
    simp
  have hV0' : vFunc A B C D n0 m0 = 0 := by
    rw [hV0, hkill]
    simp
  exact hV hV0'

/-- `q/2` is a multiple of `8` for `t ≥ 4` (so an `8ℤ`-coset is `q/2`-closed). -/
lemma qhalf_mem_eight {t : ℕ} (ht : 4 ≤ t) : ((8 : ℕ) : ℤ) ∣ ((qHalf t).val : ℤ) := by
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  rw [hval]
  refine ⟨((2 ^ (t - 4) : ℕ) : ℤ), ?_⟩
  have hexp : 2 ^ (t - 4) * 8 = 2 ^ (t - 1) := by
    rw [show 8 = 2 ^ 3 by norm_num, ← pow_add]
    congr 1
    omega
  rw [← Nat.cast_mul]
  have hexp' : (8 * 2 ^ (t - 4) : ℕ) = 2 ^ (t - 1) := by rw [mul_comm, hexp]
  exact (congrArg (fun n : ℕ => (n : ℤ)) hexp').symm

/-- If `B` is even, the board is `q/2`-periodic on any zero-free `8ℤ`-coset of a row. -/
lemma board_periodic_on_coset_of_even_B {t N : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t)) (hB : Even B.val)
    (r0 : Fin N) (c : ℤ)
    (hVfree : ∀ m : ℤ, ((8 : ℤ) ∣ m - c) → vFunc A B C D (rowVal r0) m ≠ 0)
    (hagree : ∀ m : ℤ, vFunc A B C D (rowVal r0) m ≠ 0 → F r0 m = vFunc A B C D (rowVal r0) m) :
    ∀ m : ℤ, ((8 : ℤ) ∣ m - c) → F r0 m = F r0 (m + (qHalf t).val) := by
  intro m hm
  have hmq : ((8 : ℤ) ∣ (m + (qHalf t).val) - c) := by
    rcases qhalf_mem_eight ht4 with ⟨k, hk⟩
    rcases hm with ⟨w, hw⟩
    refine ⟨w + k, ?_⟩
    calc
      (m + (qHalf t).val) - c = (m - c) + ((qHalf t).val : ℤ) := by ring
      _ = (8 : ℤ) * w + ((8 : ℕ) : ℤ) * k := by rw [hw, hk]
      _ = (8 : ℤ) * (w + k) := by norm_num; ring
  have h1 := hagree m (hVfree m hm)
  have h2 := hagree (m + (qHalf t).val) (hVfree (m + (qHalf t).val) hmq)
  have hper := vFunc_qhalf_period_of_even ht3 A B C D hB (rowVal r0) m
  calc
    F r0 m = vFunc A B C D (rowVal r0) m := h1
    _ = vFunc A B C D (rowVal r0) (m + (qHalf t).val) := hper.symm
    _ = F r0 (m + (qHalf t).val) := h2.symm

/-- Two rows' `ZMod`-classes separated by a non-multiple of `q` are distinct. -/
lemma zmod_class_ne_of_ne_dvd {t : ℕ} (a b : ℤ) (h : ¬ ((2 ^ t : ℕ) : ℤ) ∣ b - a) :
    (a : ZMod (2 ^ t)) ≠ (b : ZMod (2 ^ t)) := by
  intro hEq
  apply h
  exact (zmod_eq_iff_int_sub_dvd (2 ^ t) b a).mp hEq.symm



/-- `q = 2^t` does not divide a positive integer smaller than `q`. -/
lemma not_dvd_of_pos_lt_int {q d : ℤ} (hq : 0 < q) (hd0 : 0 < d) (hdq : d < q) :
    ¬ q ∣ d := by
  intro h
  rcases h with ⟨k, hk⟩
  have hqnonneg : 0 ≤ q := le_of_lt hq
  have hk1 : 1 ≤ k := by
    by_contra hk0
    have hkneg : k ≤ 0 := by omega
    have hprod : q * k ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hqnonneg hkneg
    rw [← hk] at hprod
    omega
  have hqk : q ≤ q * k := by
    have hqk' : q * 1 ≤ q * k := mul_le_mul_of_nonneg_left hk1 hqnonneg
    simpa using hqk'
  rw [← hk] at hqk
  omega

/-- `8 < q/2` for `t ≥ 5`. -/
lemma eight_lt_qhalf {t : ℕ} (ht : 5 ≤ t) : (8 : ℤ) < ((qHalf t).val : ℤ) := by
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  rw [hval]
  have h4 : (4 : ℕ) ≤ t - 1 := by omega
  have hge : (2 ^ 4 : ℕ) ≤ 2 ^ (t - 1) := pow_le_pow_right₀ (by norm_num) h4
  exact_mod_cast (lt_of_lt_of_le (by norm_num : (8 : ℕ) < 2 ^ 4) hge)

/-- `8 < q` for `t ≥ 5` (as an integer). -/
lemma eight_lt_q {t : ℕ} (ht : 5 ≤ t) : (8 : ℤ) < ((2 ^ t : ℕ) : ℤ) := by
  have h8 : (8 : ℕ) < 2 ^ t := by
    exact lt_of_lt_of_le (by norm_num : (8 : ℕ) < 2 ^ 5) (pow_le_pow_right₀ (by norm_num) ht)
  exact_mod_cast h8

/-- `0 < q/2` for `t ≥ 1`. -/
lemma hq2_pos {t : ℕ} (ht : 1 ≤ t) : 0 < ((qHalf t).val : ℤ) := by
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  rw [hval]
  positivity

/-- `q/2 < q` for `t ≥ 1`. -/
lemma hq2_lt {t : ℕ} (ht : 1 ≤ t) : ((qHalf t).val : ℤ) < ((2 ^ t : ℕ) : ℤ) := by
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  rw [hval]
  have hlt : 2 ^ (t - 1) < 2 ^ t := by
    exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
  exact_mod_cast hlt

/-- If the board is `q/2`-periodic on a zero-free `8ℤ`-coset, then the good-column
permutation of that row vanishes on every `q/2`-pair inside the coset. -/
lemma sigma_zero_pair {t N : ℕ}
    (F : SudokuBoard (2 ^ t) N) (hgood : HasGoodColumns (2 ^ t) N F)
    (r0 : Fin N) (c q2 : ℤ) (σ : ZMod (2 ^ t) ≃ ZMod (2 ^ t))
    (hq2pos : 0 < q2) (hq2lt : q2 < ((2 ^ t : ℕ) : ℤ))
    (hσ : ∀ m : ℤ, σ (m : ZMod (2 ^ t)) ≠ 0 → F r0 m = σ (m : ZMod (2 ^ t)))
    (hper : ∀ m : ℤ, ((8 : ℤ) ∣ m - c) → F r0 m = F r0 (m + q2)) :
    ∀ m : ℤ, ((8 : ℤ) ∣ m - c) →
      σ (m : ZMod (2 ^ t)) = 0 ∨ σ ((m + q2 : ℤ) : ZMod (2 ^ t)) = 0 := by
  intro m hm
  by_contra h
  push Not at h
  have hF1 : F r0 m = σ (m : ZMod (2 ^ t)) := hσ m h.1
  have hF2 : F r0 (m + q2) = σ ((m + q2 : ℤ) : ZMod (2 ^ t)) := hσ (m + q2) h.2
  have hEq : σ (m : ZMod (2 ^ t)) = σ ((m + q2 : ℤ) : ZMod (2 ^ t)) := by
    calc
      σ (m : ZMod (2 ^ t)) = F r0 m := hF1.symm
      _ = F r0 (m + q2) := hper m hm
      _ = σ ((m + q2 : ℤ) : ZMod (2 ^ t)) := hF2
  have hz := σ.injective hEq
  have hdiv : ((2 ^ t : ℕ) : ℤ) ∣ q2 := by
    have h0 := (zmod_eq_iff_int_sub_dvd (2 ^ t) m (m + q2)).mp hz
    have hz' : ((2 ^ t : ℕ) : ℤ) ∣ -(q2) := by
      rwa [show m - (m + q2) = -q2 by ring] at h0
    exact dvd_neg.mp hz'
  have hq : 0 < ((2 ^ t : ℕ) : ℤ) := by omega
  exact not_dvd_of_pos_lt_int hq hq2pos hq2lt hdiv

/-- `q = 2·(q/2)` for `t ≥ 1`. -/
lemma qhalf_twice {t : ℕ} (ht : 1 ≤ t) : ((2 ^ t : ℕ) : ℤ) = 2 * ((qHalf t).val : ℤ) := by
  have hval : (qHalf t).val = 2 ^ (t - 1) := by
    dsimp [qHalf]
    rw [ZMod.val_natCast]
    have hlt : 2 ^ (t - 1) < 2 ^ t := by
      exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
    exact Nat.mod_eq_of_lt hlt
  rw [hval]
  have htwo : (2 * 2 ^ (t - 1) : ℤ) = (2 ^ t : ℕ) := by
    have ht' : t = 1 + (t - 1) := by omega
    calc
      (2 * 2 ^ (t - 1) : ℤ) = (2 : ℤ) ^ 1 * (2 : ℤ) ^ (t - 1) := by norm_num
      _ = (2 : ℤ) ^ (1 + (t - 1)) := by rw [pow_add]
      _ = (2 : ℤ) ^ t := by rw [show (1 + (t - 1)) = t by omega]
      _ = ((2 ^ t : ℕ) : ℤ) := by exact (Nat.cast_pow (2 : ℕ) t).symm
  exact htwo.symm


/-- Prop is-odd (finite form): the vertical coefficient `B` of the near-digit
pseudo-affine function of a good-columns Sudoku solution is odd. -/
theorem is_odd_B {t N : ℕ} (ht5 : 5 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hgood : HasGoodColumns (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t))
    (hnd : (∃ r0 : Fin N, ∃ m0 : ℤ, vFunc A B C D (rowVal r0) m0 ≠ 0) ∧
           ∀ r : Fin N, ∀ m : ℤ, vFunc A B C D (rowVal r) m ≠ 0 →
             F r m = vFunc A B C D (rowVal r) m) :
    ¬ Even B.val := by
  classical
  intro hB
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have ht4 : 4 ≤ t := by omega
  let q2 : ℤ := (qHalf t).val
  obtain ⟨r0, m0, hV0⟩ := hnd.1
  let V : ℤ → ZMod (2 ^ t) := vFunc A B C D (rowVal r0)
  have hper_base : ∀ c : ℤ, (∀ m : ℤ, ((8 : ℤ) ∣ m - c) → V m ≠ 0) →
      ∀ m : ℤ, ((8 : ℤ) ∣ m - c) → F r0 m = F r0 (m + q2) := by
    intro c hVfree m hm
    have hper0 := board_periodic_on_coset_of_even_B (t := t) (N := N) ht3 ht4 F A B C D hB r0 c hVfree
      (fun m hm' => hnd.2 r0 m hm')
    simpa [q2] using hper0 m hm
  have hq2pos : 0 < q2 := by dsimp [q2]; exact hq2_pos ht1
  have hq2lt : q2 < ((2 ^ t : ℕ) : ℤ) := by dsimp [q2]; exact hq2_lt ht1
  have hq2eq : ((2 ^ t : ℕ) : ℤ) = 2 * q2 := by dsimp [q2]; exact qhalf_twice ht1
  have hcontra : ∀ c : ℤ, (∀ m : ℤ, ((8 : ℤ) ∣ m - c) → V m ≠ 0) → False := by
    intro c hVfree
    have hper : ∀ m : ℤ, ((8 : ℤ) ∣ m - c) → F r0 m = F r0 (m + q2) := hper_base c hVfree
    obtain ⟨σ, hσ⟩ := hgood r0
    have hzero := sigma_zero_pair (t := t) (N := N) F hgood r0 c q2 σ hq2pos hq2lt hσ hper
    let z0 : ZMod (2 ^ t) := σ.symm 0
    have hz0 : σ z0 = 0 := by simp [z0]
    have hz1 := hzero c (by rw [sub_self]; exact dvd_zero (8 : ℤ))
    have hz2 := hzero (c + 8) (by use 1; ring)
    have hEq1 : (c : ZMod (2 ^ t)) = z0 ∨ ((c + q2 : ℤ) : ZMod (2 ^ t)) = z0 := by
      rcases hz1 with h | h
      · left
        apply σ.injective
        rw [h, hz0]
      · right
        apply σ.injective
        rw [h, hz0]
    have hEq2 : ((c + 8 : ℤ) : ZMod (2 ^ t)) = z0 ∨
        ((c + 8 + q2 : ℤ) : ZMod (2 ^ t)) = z0 := by
      rcases hz2 with h | h
      · left
        apply σ.injective
        rw [h, hz0]
      · right
        apply σ.injective
        rw [h, hz0]
    rcases hEq1 with h1a | h1b
    · rcases hEq2 with h2a | h2b
      · have hcl : (c : ZMod (2 ^ t)) ≠ ((c + 8 : ℤ) : ZMod (2 ^ t)) := by
          apply zmod_class_ne_of_ne_dvd (t := t) c (c + 8)
          rw [show ((c + 8 : ℤ) - c) = 8 by ring]
          exact not_dvd_of_pos_lt_int (q := ((2 ^ t : ℕ) : ℤ)) (d := 8)
            (by positivity) (by norm_num) (eight_lt_q (t := t) ht5)
        exact hcl (h1a.trans h2a.symm)
      · have hcl : (c : ZMod (2 ^ t)) ≠ ((c + 8 + q2 : ℤ) : ZMod (2 ^ t)) := by
          apply zmod_class_ne_of_ne_dvd (t := t) c (c + 8 + q2)
          rw [show ((c + 8 + q2 : ℤ) - c) = 8 + q2 by ring]
          have hpos : 0 < 8 + q2 := by
            have h8 : (8 : ℤ) < q2 := by dsimp [q2]; exact eight_lt_qhalf ht5
            omega
          have hlt : 8 + q2 < ((2 ^ t : ℕ) : ℤ) := by
            have h8 : (8 : ℤ) < q2 := by dsimp [q2]; exact eight_lt_qhalf ht5
            rw [hq2eq]
            omega
          exact not_dvd_of_pos_lt_int (q := ((2 ^ t : ℕ) : ℤ)) (d := 8 + q2) (by positivity) hpos hlt
        exact hcl (h1a.trans h2b.symm)
    · rcases hEq2 with h2a | h2b
      · have hcl : ((c + q2 : ℤ) : ZMod (2 ^ t)) ≠ ((c + 8 : ℤ) : ZMod (2 ^ t)) := by
          apply zmod_class_ne_of_ne_dvd (t := t) (c + q2) (c + 8)
          rw [show ((c + 8 : ℤ) - (c + q2)) = -(q2 - 8) by ring]
          have hpos : 0 < q2 - 8 := by
            have h8 : (8 : ℤ) < q2 := by dsimp [q2]; exact eight_lt_qhalf ht5
            omega
          have hlt : q2 - 8 < ((2 ^ t : ℕ) : ℤ) := by
            rw [hq2eq]
            omega
          have hnot : ¬ ((2 ^ t : ℕ) : ℤ) ∣ (q2 - 8) :=
            not_dvd_of_pos_lt_int (q := ((2 ^ t : ℕ) : ℤ)) (d := q2 - 8) (by positivity) hpos hlt
          intro hd
          apply hnot
          exact dvd_neg.mp hd
        exact hcl (h1b.trans h2a.symm)
      · have hcl : ((c + q2 : ℤ) : ZMod (2 ^ t)) ≠ ((c + 8 + q2 : ℤ) : ZMod (2 ^ t)) := by
          apply zmod_class_ne_of_ne_dvd (t := t) (c + q2) (c + 8 + q2)
          rw [show ((c + 8 + q2 : ℤ) - (c + q2)) = 8 by ring]
          exact not_dvd_of_pos_lt_int (q := ((2 ^ t : ℕ) : ℤ)) (d := 8)
            (by positivity) (by norm_num) (eight_lt_q (t := t) ht5)
        exact hcl (h1b.trans h2b.symm)
  have hVfree_or := vertical_zero_free_8coset ht2 A B C D (rowVal r0) m0 hV0
  rcases hVfree_or with hfree1 | hfree2
  · exact hcontra m0 hfree1
  · exact hcontra (m0 + 4) hfree2

end
