set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! ## General-`K` `CompBool` (development): the pairwise decomposition

The `W = 2` case (`mef_weakExpressible_pair`) is proven.  Following the paper ("the
general case follows from the W=2 case by applying the closure lemmas in a similar
spirit to Example equal-ex"), a `K`-tuple obeys `CompBool` iff every coordinate is
`⟨p,q⟩`-periodic and boolean, and every two-coordinate projection obeys the W=2
`CompBool`.  This file supplies the pair projection machinery and the logical
decomposition; the weak-expressibility assembly (conjunction closure at the weak
level + per-pair lifting) follows. -/

/-- The canonical projection of a `K`-tuple to the two coordinates `w, w′`. -/
def mef_proj {e : ℕ} {K : ℕ} (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (w w' : Fin K) :
    G → (Fin 2 → ZMod (2 ^ (e + 1))) :=
  fun x i => if i = (0 : Fin 2) then α x w else α x w'

/-- Coordinate `0` of the projection is coordinate `w`. -/
lemma mef_proj_zero {e : ℕ} {K : ℕ} (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (w w' : Fin K) :
    coord (mef_proj α w w') (0 : Fin 2) = coord α w := by
  funext x
  simp [mef_proj, coord]

/-- Coordinate `1` of the projection is coordinate `w′`. -/
lemma mef_proj_one {e : ℕ} {K : ℕ} (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (w w' : Fin K) :
    coord (mef_proj α w w') (1 : Fin 2) = coord α w' := by
  funext x
  simp [mef_proj, coord]

/-- `CompBool-K` iff the per-coordinate part holds and every 2-coordinate projection
obeys the W=2 `CompBool`. -/
lemma mef_compbool_pairwise {e : ℕ} {K : ℕ} (v p q : G)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) :
    ((∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
        IsBooleanAlt e v (coord α w)) ∧
     (∀ w w' : Fin K, CompBool e v p q (mef_proj α w w'))) ↔
    CompBool e v p q α := by
  constructor
  · intro h
    rcases h with ⟨hper, hpair⟩
    constructor
    · exact hper
    · intro w w'
      have h01 := (hpair w w').2 (0 : Fin 2) (1 : Fin 2)
      -- h01 : CompatibleFunctions (coord (mef_proj α w w') 0) (coord (mef_proj α w w') 1)
      rwa [mef_proj_zero α w w', mef_proj_one α w w'] at h01
  · intro h
    constructor
    · exact h.1
    · intro w w'
      constructor
      · intro i
        fin_cases i
        · change periodicAlong p (coord (mef_proj α w w') (0 : Fin 2)) ∧
            periodicAlong q (coord (mef_proj α w w') (0 : Fin 2)) ∧
            IsBooleanAlt e v (coord (mef_proj α w w') (0 : Fin 2))
          rw [mef_proj_zero α w w']
          exact h.1 w
        · change periodicAlong p (coord (mef_proj α w w') (1 : Fin 2)) ∧
            periodicAlong q (coord (mef_proj α w w') (1 : Fin 2)) ∧
            IsBooleanAlt e v (coord (mef_proj α w w') (1 : Fin 2))
          rw [mef_proj_one α w w']
          exact h.1 w'
      · intro i j
        fin_cases i <;> fin_cases j
        · change CompatibleFunctions (coord (mef_proj α w w') (0 : Fin 2))
            (coord (mef_proj α w w') (0 : Fin 2))
          rw [mef_proj_zero α w w']
          exact pairTranslate_refl (Set.range (coord α w))
        · change CompatibleFunctions (coord (mef_proj α w w') (0 : Fin 2))
            (coord (mef_proj α w w') (1 : Fin 2))
          rw [mef_proj_zero α w w', mef_proj_one α w w']
          exact h.2 w w'
        · change CompatibleFunctions (coord (mef_proj α w w') (1 : Fin 2))
            (coord (mef_proj α w w') (0 : Fin 2))
          rw [mef_proj_one α w w', mef_proj_zero α w w']
          exact pairTranslate_symm (h.2 w w')
        · change CompatibleFunctions (coord (mef_proj α w w') (1 : Fin 2))
            (coord (mef_proj α w w') (1 : Fin 2))
          rw [mef_proj_one α w w']
          exact pairTranslate_refl (Set.range (coord α w'))

end
end Commons.PeriodicTiling


