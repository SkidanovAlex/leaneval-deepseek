attribute [local instance] Classical.propDecidable

/-! # Prop norm 9.6 (arXiv:2211.15847, tex 1367-1390) — beginnings

Target (finite form, paper): if a Sudoku solution `F` agrees with the pseudo-affine
`Ψ(n,m) = An + Bm + C + (q/4)D m(m−n)` (`B` odd) off the zeros of `Ψ`, then some shearing
`F'(n,m) = c·F(n, m + α(n))` (`α` affine in the row coordinate, `c` odd) is in *normal
form*: `F'(n,m) = m + D'(q/4)m(m−n)` for all `m ∉ qℤ`.

Mathematical analysis (verified computationally over `Z/16, Z/32, Z/64`; see
STATUS_NOTES): the zero set of `Ψ` is `{m ≡ A'n+C' (mod q)}`, and after the shear
`m ↦ m + A'n + C'` the sheared function is *pointwise* pseudo-affine (NOT as a
polynomial — e.g. `q=16, Ψ=n+m+4m(m−n)` gives `Ψ''(n,m)=m(1+4n+4m) = 9m+12m(m−n)`
pointwise, difference `8m(2n−m−1) ≡ 0`).  This file develops the value-level core. -/

/-- `1 + even` is a unit in `ZMod (2^t)`: `1 + 2w` is an odd element. -/
lemma zmod_unit_one_add_two {t : ℕ} (ht : 1 ≤ t) (w : ZMod (2 ^ t)) :
    IsUnit (1 + (2 : ZMod (2 ^ t)) * w) := by
  have hm : ∃ s : ℕ, 2 ^ t = 2 ^ (s + 1) := by
    refine ⟨t - 1, ?_⟩
    congr 1
    omega
  have hunit : IsUnit (((1 + 2 * (w.val : ℕ) : ℤ) : ZMod (2 ^ t))) := by
    apply zmod_isUnit_of_odd (a' := (1 + 2 * (w.val : ℕ) : ℤ)) (m := 2 ^ t)
    · have hodd : Odd ((1 + 2 * (w.val : ℕ) : ℤ)) := ⟨(w.val : ℤ), by norm_num; ring⟩
      exact (Int.natAbs_odd).mpr hodd
    · exact hm
  have hcast : (((1 + 2 * (w.val : ℕ) : ℤ) : ZMod (2 ^ t))) = 1 + (2 : ZMod (2 ^ t)) * w := by
    have hz : (1 + 2 * (w.val : ℕ) : ℤ) = (1 : ℤ) + 2 * ((w.val : ℕ) : ℤ) := by norm_num
    rw [hz, Int.cast_add, Int.cast_mul]
    norm_num
  rwa [hcast] at hunit

lemma qFourth_eq_two_mul {t : ℕ} (ht : 3 ≤ t) (x : ZMod (2 ^ t)) :
    (qFourth t) * x = (2 : ZMod (2 ^ t)) * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * x) := by
  have hpow : (2 ^ (t - 2) : ℕ) = 2 * 2 ^ (t - 3) := by
    rw [show (2 ^ (t - 2) : ℕ) = 2 ^ ((t - 3) + 1) by congr 1; omega, pow_succ]
    rw [mul_comm]
  calc
    (qFourth t) * x = (((2 ^ (t - 2) : ℕ) : ZMod (2 ^ t))) * x := rfl
    _ = ((2 * 2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * x := by rw [hpow]
    _ = ((2 : ℕ) : ZMod (2 ^ t)) * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * x) := by
          rw [Nat.cast_mul]
          ring

/-- The row map of a `B = 1` pseudo-affine function: `u ↦ u + (q/4)D·u(u−n)`
(cells of row `n`; `u` is the column class).  The affine-plus-quadratic content of
`Ψ(n, m) = an + m + c + (q/4)D·m(m−n)` at column class `u`. -/
def rowMap {t : ℕ} (D : ZMod (2 ^ t)) (n : ZMod (2 ^ t)) (u : ZMod (2 ^ t)) : ZMod (2 ^ t) :=
  u + (qFourth t * D) * u * (u - n)

/-- The row map is injective for `t ≥ 3`: differences factor as
`(u−v)·(1 + (q/4)D(u+v−n))` with the second factor a unit. -/
lemma rowMap_injective {t : ℕ} (ht : 3 ≤ t) (D n : ZMod (2 ^ t)) :
    Function.Injective (rowMap D n) := by
  intro u v h
  have hdiff : rowMap D n u - rowMap D n v =
      (u - v) * (1 + (qFourth t * D) * (u + v - n)) := by
    dsimp [rowMap]
    ring
  have h0 : (u - v) * (1 + (qFourth t * D) * (u + v - n)) = 0 := by
    rw [← hdiff]
    exact sub_eq_zero.mpr h
  have hunit : IsUnit (1 + (qFourth t * D) * (u + v - n)) := by
    have hq := qFourth_eq_two_mul (t := t) ht (D * (u + v - n))
    have hq' : (qFourth t * D) * (u + v - n) = (2 : ZMod (2 ^ t)) * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * (u + v - n))) := by
      calc
        (qFourth t * D) * (u + v - n) = (qFourth t) * (D * (u + v - n)) := by ring
        _ = (2 : ZMod (2 ^ t)) * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * (u + v - n))) := qFourth_eq_two_mul ht (D * (u + v - n))
    rw [hq']
    exact zmod_unit_one_add_two (by omega : 1 ≤ t) (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * (u + v - n)))
  -- cancel the unit from (u − v)·unit = 0
  rcases (IsUnit.exists_left_inv hunit) with ⟨a, ha⟩
  have hcancel : (u - v) * (a * (1 + (qFourth t * D) * (u + v - n))) = 0 := by
    calc
      (u - v) * (a * (1 + (qFourth t * D) * (u + v - n)))
          = a * ((u - v) * (1 + (qFourth t * D) * (u + v - n))) := by ring
      _ = a * 0 := by rw [h0]
      _ = 0 := by simp
  have hmain : u - v = 0 := by
    calc
      u - v = (u - v) * 1 := by ring
      _ = (u - v) * (a * (1 + (qFourth t * D) * (u + v - n))) := by rw [ha]
      _ = 0 := hcancel
  exact sub_eq_zero.mp hmain

/-- `(q/4)² = 0` in `ZMod (2^t)` for `t ≥ 4`. -/
lemma qFourth_sq_zero {t : ℕ} (ht : 4 ≤ t) : (qFourth t) * (qFourth t) = 0 := by
  dsimp [qFourth]
  rw [← Nat.cast_mul]
  have hpow : 2 ^ (t - 2) * 2 ^ (t - 2) = 2 ^ t * 2 ^ (t - 4) := by
    calc
      2 ^ (t - 2) * 2 ^ (t - 2) = 2 ^ ((t - 2) + (t - 2)) := by rw [← pow_add]
      _ = 2 ^ (t + (t - 4)) := by congr 1; omega
      _ = 2 ^ t * 2 ^ (t - 4) := by rw [pow_add]
  rw [hpow, Nat.cast_mul]
  have hz : ((2 ^ t : ℕ) : ZMod (2 ^ t)) = 0 := ZMod.natCast_self (2 ^ t)
  rw [hz]
  simp

/-- Generic quadratic-with-nilpotent-g identity: `e + u + g·u·(u−n) = 0` for
`u := −e − g·e·(e+n)` whenever `g² = 0` (any commutative ring). -/
lemma ring_sol_zero {R : Type*} [CommRing R] (g e n : R) (hg2 : g * g = 0) :
    e + (-e - g * e * (e + n)) + g * (-e - g * e * (e + n)) * ((-e - g * e * (e + n)) - n) = 0 := by
  calc
    e + (-e - g * e * (e + n)) + g * (-e - g * e * (e + n)) * ((-e - g * e * (e + n)) - n)
        = (g * g) * (e * (e + n) * (2 * e + n) + g * (e * (e + n) * (e * (e + n)))) := by ring
    _ = 0 := by rw [hg2]; simp

/-- The `B = 1` pseudo-affine row value at column class `u`:
`Ψ(n, m) = A n + m + C + (q/4)D·m(m−n)` restricted to the class of `m`. -/
def normPsiRow {t : ℕ} (A C D : ZMod (2 ^ t)) (n u : ZMod (2 ^ t)) : ZMod (2 ^ t) :=
  (A * n + C) + u + (qFourth t * D) * u * (u - n)

/-- Exact solution of `Ψ(n, ·) = 0` at row `n`: the class
`u₀ := −(An+C) − (q/4)D·(An+C)·(An+C+n)` is a zero (for `t ≥ 4`). -/
lemma normPsiRow_sol {t : ℕ} (ht4 : 4 ≤ t) (A C D n : ZMod (2 ^ t)) :
    normPsiRow A C D n (-(A * n + C) - (qFourth t * D) * (A * n + C) * (A * n + C + n)) = 0 := by
  let e : ZMod (2 ^ t) := A * n + C
  let g : ZMod (2 ^ t) := qFourth t * D
  have hg2 : g * g = 0 := by
    dsimp [g]
    calc
      (qFourth t * D) * (qFourth t * D) = (qFourth t * qFourth t) * (D * D) := by ring
      _ = 0 := by rw [qFourth_sq_zero ht4]; simp
  change e + (-e - g * e * (e + n)) + g * (-e - g * e * (e + n)) * ((-e - g * e * (e + n)) - n) = 0
  exact ring_sol_zero (R := ZMod (2 ^ t)) g e n hg2

/-- Complete zero-set of the `B = 1` pseudo-affine row function at row class `n`: the
unique solution is the exact class `−(An+C) − (q/4)D(An+C)(An+C+n)`. -/
lemma normPsiRow_zero_iff {t : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A C D n u : ZMod (2 ^ t)) :
    normPsiRow A C D n u = 0 ↔
      u = -(A * n + C) - (qFourth t * D) * (A * n + C) * (A * n + C + n) := by
  let e : ZMod (2 ^ t) := A * n + C
  let sol : ZMod (2 ^ t) := -e - (qFourth t * D) * e * (e + n)
  have hsol_eq : sol = -(A * n + C) - (qFourth t * D) * (A * n + C) * (A * n + C + n) := rfl
  constructor
  · intro hz
    have hu0 : rowMap D n u = -e := by
      unfold normPsiRow at hz
      unfold rowMap at ⊢
      rw [eq_neg_iff_add_eq_zero]
      dsimp [e]
      simpa [add_assoc, add_comm, add_left_comm] using hz
    have hs0 : rowMap D n sol = -e := by
      unfold rowMap
      rw [eq_neg_iff_add_eq_zero]
      have hz0 := normPsiRow_sol (t := t) ht4 A C D n
      rw [hsol_eq.symm] at hz0
      unfold normPsiRow at hz0
      dsimp [e]
      simpa [add_assoc, add_comm, add_left_comm] using hz0
    have heq : rowMap D n u = rowMap D n sol := by rw [hu0, hs0]
    have hinj := rowMap_injective (t := t) ht3 D n heq
    rwa [← hsol_eq]
  · intro hu
    rw [hu]
    exact normPsiRow_sol (t := t) ht4 A C D n

/-- The integer-indexed `B = 1` pseudo-affine value (the object used by near-digit)
equals the row-class function: everything depends on `n`, `m` through their classes. -/
lemma pseudoAffineVal_B1_eq_normPsiRow {t : ℕ} (A C D : ZMod (2 ^ t)) (n m : ℤ) :
    pseudoAffineVal A 1 C D n m = normPsiRow A C D (n : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) := by
  dsimp [normPsiRow, pseudoAffineVal, pseudoCorr]
  ring

/-- The `B = 1` zero-set in integer coordinates: `Ψ(n,m) = 0` iff the class of `m` is
the exact solution class at the class of row `n`. -/
lemma zero_iff_exact_solution {t : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A C D : ZMod (2 ^ t)) (n m : ℤ) :
    pseudoAffineVal A 1 C D n m = 0 ↔
      (m : ZMod (2 ^ t)) =
        -(A * (n : ZMod (2 ^ t)) + C)
          - (qFourth t * D) * (A * (n : ZMod (2 ^ t)) + C)
              * (A * (n : ZMod (2 ^ t)) + C + (n : ZMod (2 ^ t))) := by
  rw [pseudoAffineVal_B1_eq_normPsiRow]
  exact normPsiRow_zero_iff (t := t) ht3 ht4 A C D (n : ZMod (2 ^ t)) (m : ZMod (2 ^ t))

/-- A unit is not a zero divisor: `a·x = 0 ↔ x = 0` for a unit `a` (any commutative
ring). -/
lemma mul_eq_zero_iff_of_isUnit {R : Type*} [CommRing R] {a : R} (ha : IsUnit a) (x : R) :
    a * x = 0 ↔ x = 0 := by
  constructor
  · intro h
    rcases (IsUnit.exists_left_inv ha) with ⟨b, hb⟩
    have hb' : b * (a * x) = 0 := by rw [h]; simp
    calc
      x = 1 * x := by simp
      _ = (b * a) * x := by rw [hb]
      _ = b * (a * x) := by ring
      _ = 0 := hb'
  · intro h
    simp [h]

/-- The row value of the *general* (`B`-weighted) pseudo-affine function at column
class `u`: `Ψ_B(n,u) = (An+C) + B·u + (q/4)D·u·(u−n)`. -/
def normPsiRowB {t : ℕ} (A B C D : ZMod (2 ^ t)) (n u : ZMod (2 ^ t)) : ZMod (2 ^ t) :=
  (A * n + C) + B * u + (qFourth t * D) * u * (u - n)

/-- Factoring out the unit `B`: `Ψ_B` with coefficients `(A,C,D) = (BAt, BCt, BDt)` is
`B` times the `B = 1` function with coefficients `(At, Ct, Dt)`. -/
lemma normPsiRowB_eq_mul_scaled {t : ℕ} (A B C D At Ct Dt : ZMod (2 ^ t))
    (hA : A = B * At) (hC : C = B * Ct) (hD : D = B * Dt) (n u : ZMod (2 ^ t)) :
    normPsiRowB A B C D n u = B * normPsiRow At Ct Dt n u := by
  unfold normPsiRowB normPsiRow
  rw [hA, hC, hD]
  ring

/-- General-`B` zero classification: when `B` is a unit and `(A,C,D) = (BAt, BCt, BDt)`,
`Ψ_B(n,u) = 0` iff `u` is the exact solution class of the scaled `B = 1` function. -/
lemma normPsiRowB_zero_iff_scaled {t : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A B C D n u : ZMod (2 ^ t)) (hB : IsUnit B)
    (At Ct Dt : ZMod (2 ^ t)) (hA : A = B * At) (hC : C = B * Ct) (hD : D = B * Dt) :
    normPsiRowB A B C D n u = 0 ↔
      u = -(At * n + Ct) - (qFourth t * Dt) * (At * n + Ct) * (At * n + Ct + n) := by
  have hfac : normPsiRowB A B C D n u = B * normPsiRow At Ct Dt n u :=
    normPsiRowB_eq_mul_scaled A B C D At Ct Dt hA hC hD n u
  rw [hfac]
  rw [mul_eq_zero_iff_of_isUnit hB]
  exact normPsiRow_zero_iff (t := t) ht3 ht4 At Ct Dt n u

/-- General-`B` zero classification, in the integer coordinates used by the board: for
`Ψ(n,m) = An + Bm + C + (q/4)D·m(m−n)` with `B` a unit, the class of `m` solves
exactly the scaled exact-solution class. -/
lemma zero_iff_exact_solution_generalB {t : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A B C D : ZMod (2 ^ t)) (n m : ℤ) (hB : IsUnit B)
    (At Ct Dt : ZMod (2 ^ t)) (hA : A = B * At) (hC : C = B * Ct) (hD : D = B * Dt) :
    pseudoAffineVal A B C D n m = 0 ↔
      (m : ZMod (2 ^ t)) =
        -(At * (n : ZMod (2 ^ t)) + Ct)
          - (qFourth t * Dt) * (At * (n : ZMod (2 ^ t)) + Ct)
              * (At * (n : ZMod (2 ^ t)) + Ct + (n : ZMod (2 ^ t))) := by
  -- pseudoAffineVal A B C D n m = (A·nb+C) + B·m̂ + hD·m̂(m̂−nb) = normPsiRowB ...
  have hval : pseudoAffineVal A B C D n m =
      normPsiRowB A B C D (n : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) := by
    dsimp [normPsiRowB, pseudoAffineVal, pseudoCorr]
    ring
  rw [hval]
  exact normPsiRowB_zero_iff_scaled (t := t) ht3 ht4 A B C D
    (n : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) hB At Ct Dt hA hC hD

/-- An element of `ZMod (2^t)` with odd value is a unit (`t ≥ 1`). -/
lemma zmod_isUnit_of_odd_val {t : ℕ} (ht : 1 ≤ t) (B : ZMod (2 ^ t)) (hB : Odd B.val) :
    IsUnit B := by
  have hBcast : B = ((B.val : ℕ) : ZMod (2 ^ t)) := (ZMod.natCast_zmod_val B).symm
  rw [hBcast]
  rw [ZMod.isUnit_iff_coprime]
  exact (Nat.coprime_pow_right_iff (by omega : 0 < t) (B.val) 2).mpr
    (Nat.coprime_two_right.mpr hB)

/-- Boundary lemma linking `is_odd_B` output (`¬ Even B.val`) to the general-`B` zero
classification: with coefficient witnesses `(A,C,D) = (B·At, B·Ct, B·Dt)`, an odd `B`
gives the exact zero-class criterion for the board pseudo-affine value. -/
lemma zero_iff_sol_of_odd_B {t : ℕ} (ht1 : 1 ≤ t) (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A B C D : ZMod (2 ^ t)) (hB : ¬ Even B.val) (n m : ℤ)
    (At Ct Dt : ZMod (2 ^ t)) (hA : A = B * At) (hC : C = B * Ct) (hD : D = B * Dt) :
    pseudoAffineVal A B C D n m = 0 ↔
      (m : ZMod (2 ^ t)) =
        -(At * (n : ZMod (2 ^ t)) + Ct)
          - (qFourth t * Dt) * (At * (n : ZMod (2 ^ t)) + Ct)
              * (At * (n : ZMod (2 ^ t)) + Ct + (n : ZMod (2 ^ t))) := by
  have hodd : Odd B.val := Nat.not_even_iff_odd.mp hB
  have hBu : IsUnit B := zmod_isUnit_of_odd_val ht1 B hodd
  exact zero_iff_exact_solution_generalB ht3 ht4 A B C D n m hBu At Ct Dt hA hC hD

/-- The half-integer square-annihilator identity: `(q/2)·x·(u²−u) = 0` for every
`u ∈ ZMod(2^t)` — since `q/2·(u²−u) = 0` (the framework lemma) and multiplication is
commutative.  This is the formal identity behind "`nb² = nb` at the `q/2` level". -/
lemma qHalf_sq_sub_annihilates {t : ℕ} (ht : 1 ≤ t) (x u : ZMod (2 ^ t)) :
    (qHalf t) * (x * (u * u - u)) = 0 := by
  have hz := zmod_half_mul_zmod_sq_sub (t := t) ht u
  calc
    (qHalf t) * (x * (u * u - u)) = x * (qHalf t * (u * u - u)) := by ring
    _ = x * 0 := by rw [hz]
    _ = 0 := by simp

/-- The integer-lift-binomial version: with an integer lift `b2` of the half-binomial
coefficient and an integer row coordinate `z`, `(q/2)·b2·(ẑ²−ẑ) = 0`.  This is the
standalone identity that makes the quadratic part of the exact solution collapse to a
linear term in the row coordinate. -/
lemma qHalf_mul_lift_binom_sq_sub {t : ℕ} (ht : 1 ≤ t) (b2 z : ℤ) :
    (qHalf t : ZMod (2 ^ t)) *
      (((b2 : ℤ) : ZMod (2 ^ t)) *
        (((z : ZMod (2 ^ t)) * (z : ZMod (2 ^ t)) - (z : ZMod (2 ^ t))))) = 0 := by
  exact qHalf_sq_sub_annihilates ht ((b2 : ℤ) : ZMod (2 ^ t)) (z : ZMod (2 ^ t))

/-- The exact solution class is affine in the row class: given the half-binomial
witness `At·(At+1) = 2·b2`, the solution `−(At·nb+Ct) − (q/4)Dt·(At·nb+Ct)(At·nb+Ct+nb)`
equals `A'·nb + C'` with the explicit shear coefficients
`A' := −At − (q/4)Dt·Ct·(2At+1) − (q/2)Dt·b2`, `C' := −Ct − (q/4)Dt·Ct²`. -/
lemma sol_affine_slope {t : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t)
    (At Ct Dt b2 : ZMod (2 ^ t)) (hb2 : At * (At + 1) = 2 * b2) :
    ∀ nb : ZMod (2 ^ t),
      -(At * nb + Ct) - (qFourth t * Dt) * (At * nb + Ct) * (At * nb + Ct + nb)
        = (-At - (qFourth t * Dt) * Ct * (2 * At + 1) - (qHalf t) * Dt * b2) * nb
            + (-Ct - (qFourth t * Dt) * Ct * Ct) := by
  intro nb
  have hquad : (At * nb + Ct) * (At * nb + Ct + nb)
      = At * (At + 1) * (nb * nb) + (2 * At * Ct + Ct) * nb + Ct * Ct := by ring
  have hqf : (qFourth t) * (2 : ZMod (2 ^ t)) = qHalf t := qFourth_mul_two ht2
  have hann := qHalf_sq_sub_annihilates ht1 (Dt * b2) nb
  have hsq : (qHalf t * (Dt * b2)) * (nb * nb) = (qHalf t * (Dt * b2)) * nb := by
    apply sub_eq_zero.mp
    calc
      (qHalf t * (Dt * b2)) * (nb * nb) - (qHalf t * (Dt * b2)) * nb
          = (qHalf t) * ((Dt * b2) * (nb * nb - nb)) := by ring
      _ = 0 := hann
  have hlin : (qFourth t * Dt) * ((2 * b2) * (nb * nb) + (2 * At * Ct + Ct) * nb + Ct * Ct)
      = (qHalf t * (Dt * b2)) * nb + (qFourth t * Dt) * ((2 * At * Ct + Ct) * nb + Ct * Ct) := by
    calc
      (qFourth t * Dt) * ((2 * b2) * (nb * nb) + (2 * At * Ct + Ct) * nb + Ct * Ct)
          = ((qFourth t * (2 : ZMod (2 ^ t))) * (Dt * b2)) * (nb * nb)
              + (qFourth t * Dt) * ((2 * At * Ct + Ct) * nb + Ct * Ct) := by ring
      _ = ((qHalf t) * (Dt * b2)) * (nb * nb)
              + (qFourth t * Dt) * ((2 * At * Ct + Ct) * nb + Ct * Ct) := by rw [hqf]
      _ = (qHalf t * (Dt * b2)) * nb + (qFourth t * Dt) * ((2 * At * Ct + Ct) * nb + Ct * Ct) := by
            rw [hsq]
  rw [mul_assoc, hquad, hb2]
  rw [hlin]
  ring

/-- Complete general-`B` zero-set in affine-slope form: for odd `B` with coefficient
witnesses `(A,C,D) = (B·At, B·Ct, B·Dt)` and half-binomial witness
`At·(At+1) = 2·b2`, the board value `Ψ(n,m) = An+Bm+C+(q/4)D·m(m−n)` vanishes iff the
class of `m` equals `A'·n̂ + C'` with the explicit shear coefficients
`A' := −At − (q/4)Dt·Ct·(2At+1) − (q/2)Dt·b2`, `C' := −Ct − (q/4)Dt·Ct²`. -/
lemma zero_iff_affine_slope_of_odd_B {t : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t)
    (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A B C D : ZMod (2 ^ t)) (hB : ¬ Even B.val) (n m : ℤ)
    (At Ct Dt b2 : ZMod (2 ^ t)) (hb2 : At * (At + 1) = 2 * b2)
    (hA : A = B * At) (hC : C = B * Ct) (hD : D = B * Dt) :
    pseudoAffineVal A B C D n m = 0 ↔
      (m : ZMod (2 ^ t)) =
        (-At - (qFourth t * Dt) * Ct * (2 * At + 1) - (qHalf t) * Dt * b2)
            * (n : ZMod (2 ^ t))
          + (-Ct - (qFourth t * Dt) * Ct * Ct) := by
  rw [zero_iff_sol_of_odd_B ht1 ht3 ht4 A B C D hB n m At Ct Dt hA hC hD]
  have haff := sol_affine_slope ht1 ht2 At Ct Dt b2 hb2 (n : ZMod (2 ^ t))
  rw [haff]

/-- Shear closure (function level): if `s(n̂) := Ap·n̂ + Cp` is a zero of the row
function at every row class `n̂` (i.e. `Ψ_B(n̂, s(n̂)) = 0`), then the sheared function
`u ↦ Ψ_B(n̂, u + s(n̂))` is pointwise the pseudo-affine row value of the same family
with explicit coefficients `B'' := B + 2(q/4)DCp + (q/2)DAp`, `D'' := D(1−2Ap)`
(and `A'' = C'' = 0`).  This is Z2: the computation that keeps the family closed
under the zero-set shear. -/
lemma shear_closure {t : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t)
    (A B C D Ap Cp n u : ZMod (2 ^ t))
    (hzero : normPsiRowB A B C D n (Ap * n + Cp) = 0) :
    normPsiRowB A B C D n (u + (Ap * n + Cp))
      = (B + (2 : ZMod (2 ^ t)) * (qFourth t * D) * Cp + (qHalf t) * D * Ap) * u
          + (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap))) * u * (u - n) := by
  unfold normPsiRowB at hzero ⊢
  have hqf : (qFourth t) * (2 : ZMod (2 ^ t)) = qHalf t := qFourth_mul_two ht2
  have hann := qHalf_sq_sub_annihilates ht1 (D * Ap) u
  -- constant (in u) part of the shear is hzero; what remains:
  have hL : (A * n + C) + B * (u + (Ap * n + Cp))
        + (qFourth t * D) * (u + (Ap * n + Cp)) * ((u + (Ap * n + Cp)) - n)
      = B * u + (qFourth t * D) * (u * u + u * (2 * (Ap * n + Cp) - n)) := by
    have hdiff : (A * n + C) + B * (u + (Ap * n + Cp))
            + (qFourth t * D) * (u + (Ap * n + Cp)) * ((u + (Ap * n + Cp)) - n)
          - ((A * n + C) + B * (Ap * n + Cp)
              + (qFourth t * D) * (Ap * n + Cp) * ((Ap * n + Cp) - n))
        = B * u + (qFourth t * D) * (u * u + u * (2 * (Ap * n + Cp) - n)) := by ring
    rw [← hdiff, hzero]
    simp
  rw [hL]
  -- L = RHS + annihilator-term, a pure ring identity once qHalf = 2·(q/4) is unfolded
  have htail : B * u + (qFourth t * D) * (u * u + u * (2 * (Ap * n + Cp) - n))
      = (B + (2 : ZMod (2 ^ t)) * (qFourth t * D) * Cp + (qHalf t) * D * Ap) * u
          + (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap))) * u * (u - n)
          + (qHalf t) * ((D * Ap) * (u * u - u)) := by
    rw [← hqf]
    ring
  rw [htail]
  rw [hann]
  simp

/-- The sheared function has zero constant and linear-in-`n` parts: at column `u = 0`
its value is `Ψ_B(n, s(n))`, which vanishes by the zero-set hypothesis (`A'' = C'' = 0`
in the paper's notation). -/
lemma shear_zero_of_zero {t : ℕ} (A B C D Ap Cp n : ZMod (2 ^ t))
    (hzero : normPsiRowB A B C D n (Ap * n + Cp) = 0) :
    normPsiRowB A B C D n (0 + (Ap * n + Cp)) = 0 := by
  simpa using hzero

/-- If `B' = B + 2w` and `B` is a unit, then so is `B'` (oddness transfers through an
even shift). -/
lemma isUnit_of_eq_add_two_mul {t : ℕ} (ht : 1 ≤ t)
    {B Bp w : ZMod (2 ^ t)} (hBp : Bp = B + (2 : ZMod (2 ^ t)) * w) (hB : IsUnit B) :
    IsUnit Bp := by
  rcases (IsUnit.exists_left_inv hB) with ⟨b, hb⟩
  have hb' : B * b = 1 := by
    calc
      B * b = b * B := by ring
      _ = 1 := hb
  have h1 : B * (1 + b * ((2 : ZMod (2 ^ t)) * w)) = B + (2 : ZMod (2 ^ t)) * w := by
    calc
      B * (1 + b * ((2 : ZMod (2 ^ t)) * w))
          = B + B * (b * ((2 : ZMod (2 ^ t)) * w)) := by ring
      _ = B + (2 : ZMod (2 ^ t)) * w := by
            have h2 : B * (b * ((2 : ZMod (2 ^ t)) * w)) = (2 : ZMod (2 ^ t)) * w := by
              calc
                B * (b * ((2 : ZMod (2 ^ t)) * w)) = (B * b) * ((2 : ZMod (2 ^ t)) * w) := by ring
                _ = (2 : ZMod (2 ^ t)) * w := by rw [hb']; simp
            rw [h2]
  have hBp' : Bp = B * (1 + b * ((2 : ZMod (2 ^ t)) * w)) := by
    rw [hBp, ← h1]
  have hunit2 : IsUnit (1 + b * ((2 : ZMod (2 ^ t)) * w)) := by
    have hred : 1 + b * ((2 : ZMod (2 ^ t)) * w) = 1 + (2 : ZMod (2 ^ t)) * (b * w) := by ring
    rw [hred]
    exact zmod_unit_one_add_two ht (b * w)
  rw [hBp']
  exact IsUnit.mul hB hunit2

/-- The sheared function's linear coefficient `B'' := B + 2(q/4)DCp + (q/2)DAp` is a
unit when `B` is: it differs from `B` by an even shift. -/
lemma shear_Bp_isUnit {t : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t)
    (B D Ap Cp : ZMod (2 ^ t)) (hB : IsUnit B) :
    IsUnit (B + (2 : ZMod (2 ^ t)) * (qFourth t * D) * Cp + (qHalf t) * D * Ap) := by
  have hqf2 : (2 : ZMod (2 ^ t)) * qFourth t = qHalf t := by
    rw [mul_comm, qFourth_mul_two ht2]
  let w : ZMod (2 ^ t) := (qFourth t * D) * (Cp + Ap)
  have hBp : B + (2 : ZMod (2 ^ t)) * (qFourth t * D) * Cp + (qHalf t) * D * Ap
      = B + (2 : ZMod (2 ^ t)) * w := by
    dsimp [w]
    rw [← hqf2]
    ring
  exact isUnit_of_eq_add_two_mul (t := t) ht1 hBp hB

/-- The integer-indexed general-`B` pseudo-affine value equals the row-class function. -/
lemma pseudoAffineVal_eq_normPsiRowB {t : ℕ} (A B C D : ZMod (2 ^ t)) (n m : ℤ) :
    pseudoAffineVal A B C D n m =
      normPsiRowB A B C D (n : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) := by
  dsimp [normPsiRowB, pseudoAffineVal, pseudoCorr]
  ring

/-- `n·(n+1)` is even (product of consecutive naturals). -/
lemma even_nat_mul_succ (n : ℕ) : Even (n * (n + 1) : ℕ) := by
  rw [even_iff_two_dvd]
  rcases Nat.even_or_odd n with h | h
  · rcases h with ⟨k, hk⟩
    rw [hk]
    exact ⟨k * (2 * k + 1), by ring⟩
  · rcases h with ⟨k, hk⟩
    rw [hk]
    exact ⟨(2 * k + 1) * (k + 1), by ring⟩

/-- Reducing an even number modulo an even modulus stays even. -/
lemma even_mod_of_even {t : ℕ} (ht : 1 ≤ t) (n : ℕ) (h : Even n) : Even (n % 2 ^ t) := by
  rw [Nat.even_iff]
  rw [Nat.even_iff] at h
  have hdvd : (2 : ℕ) ∣ 2 ^ t := by
    exact ⟨2 ^ (t - 1), by rw [← pow_succ']; congr 1; omega⟩
  have hmm := Nat.mod_mod_of_dvd (c := 2) (b := 2 ^ t) (a := n) hdvd
  rw [hmm]
  exact h

/-- `z·(z+1)` has even value in `ZMod (2^t)`. -/
lemma even_val_mul_succ {t : ℕ} (ht : 1 ≤ t) (z : ZMod (2 ^ t)) : Even ((z * (z + 1)).val) := by
  have hnat : Even (z.val * (z.val + 1) : ℕ) := even_nat_mul_succ z.val
  have hevenmod := even_mod_of_even ht (z.val * (z.val + 1)) hnat
  have hcast : ((z.val * (z.val + 1) : ℕ) % 2 ^ t) = (z * (z + 1)).val := by
    have hz : z = (((z.val : ℕ) : ZMod (2 ^ t))) := (ZMod.natCast_zmod_val z).symm
    have hprod : z * (z + 1) = (((z.val * (z.val + 1) : ℕ) : ZMod (2 ^ t))) := by
      have hone : ((1 : ℕ) : ZMod (2 ^ t)) = 1 := by norm_num
      conv_lhs => rw [hz]
      conv_lhs => rw [← hone]
      conv_lhs => rw [← Nat.cast_add]
      conv_lhs => rw [← Nat.cast_mul]
    rw [hprod]
    rw [ZMod.val_natCast]
  rw [← hcast]
  exact hevenmod

/-- Even-valued elements of `ZMod (2^t)` are twice something. -/
lemma exists_two_mul_of_even_val {t : ℕ} (z : ZMod (2 ^ t)) (hz : Even z.val) :
    ∃ c : ZMod (2 ^ t), z = (2 : ZMod (2 ^ t)) * c := by
  rcases hz with ⟨k, hk⟩
  refine ⟨(k : ZMod (2 ^ t)), ?_⟩
  have hz' : z = ((z.val : ℕ) : ZMod (2 ^ t)) := (ZMod.natCast_zmod_val z).symm
  rw [hz']
  have hk2 : z.val = 2 * k := by omega
  rw [hk2, Nat.cast_mul]
  norm_num

/-- `z·(z+1)` is twice something in `ZMod (2^t)` (`t ≥ 1`). -/
lemma exists_half_mul_succ {t : ℕ} (ht : 1 ≤ t) (z : ZMod (2 ^ t)) :
    ∃ c : ZMod (2 ^ t), z * (z + 1) = (2 : ZMod (2 ^ t)) * c := by
  exact exists_two_mul_of_even_val (z * (z + 1)) (even_val_mul_succ ht z)

lemma affine_zero_slope_data {t : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t)
    (ht3 : 3 ≤ t) (ht4 : 4 ≤ t) (A B C D : ZMod (2 ^ t)) (hB : ¬ Even B.val) :
    ∃ (At Ct Dt b2 Ap Cp : ZMod (2 ^ t)),
      A = B * At ∧ C = B * Ct ∧ D = B * Dt ∧ At * (At + 1) = 2 * b2 ∧
      Ap = -At - (qFourth t * Dt) * Ct * (2 * At + 1) - (qHalf t) * Dt * b2 ∧
      Cp = -Ct - (qFourth t * Dt) * Ct * Ct ∧
      ∀ nb : ZMod (2 ^ t), normPsiRowB A B C D nb (Ap * nb + Cp) = 0 := by
  have hodd : Odd B.val := Nat.not_even_iff_odd.mp hB
  have hBu : IsUnit B := zmod_isUnit_of_odd_val ht1 B hodd
  rcases (IsUnit.exists_left_inv hBu) with ⟨b, hb⟩
  have hb' : B * b = 1 := by
    calc
      B * b = b * B := by ring
      _ = 1 := hb
  have hA0 : A = B * (b * A) := by
    rw [← mul_assoc, hb']
    simp
  have hC0 : C = B * (b * C) := by
    rw [← mul_assoc, hb']
    simp
  have hD0 : D = B * (b * D) := by
    rw [← mul_assoc, hb']
    simp
  obtain ⟨b2, hb2⟩ := exists_half_mul_succ ht1 (b * A)
  let ApE : ZMod (2 ^ t) := -(b * A) - (qFourth t * (b * D)) * (b * C) * (2 * (b * A) + 1)
      - (qHalf t) * (b * D) * b2
  let CpE : ZMod (2 ^ t) := -(b * C) - (qFourth t * (b * D)) * (b * C) * (b * C)
  refine ⟨b * A, b * C, b * D, b2, ApE, CpE, hA0, hC0, hD0, hb2, rfl, rfl, ?_⟩
  intro nb
  let ni : ℤ := (nb.val : ℤ)
  let ui : ℤ := ((ApE * nb + CpE).val : ℤ)
  have hni : (ni : ZMod (2 ^ t)) = nb := by
    dsimp [ni]
    rw [Int.cast_natCast (nb.val)]
    exact ZMod.natCast_zmod_val nb
  have hui : (ui : ZMod (2 ^ t)) = ApE * nb + CpE := by
    dsimp [ui]
    rw [Int.cast_natCast (ApE * nb + CpE).val]
    exact ZMod.natCast_zmod_val (ApE * nb + CpE)
  have hiff := zero_iff_affine_slope_of_odd_B (t := t) ht1 ht2 ht3 ht4 A B C D hB ni ui
    (b * A) (b * C) (b * D) b2 hb2 hA0 hC0 hD0
  have hApW : (ApE : ZMod (2 ^ t))
      = -(b * A) - (qFourth t * (b * D)) * (b * C) * (2 * (b * A) + 1) - (qHalf t) * (b * D) * b2 := rfl
  have hCpW : (CpE : ZMod (2 ^ t)) = -(b * C) - (qFourth t * (b * D)) * (b * C) * (b * C) := rfl
  have hneed : (ui : ZMod (2 ^ t)) =
      ApE * (ni : ZMod (2 ^ t)) + CpE := by
    rw [hApW, hCpW]
    rw [hni]
    -- now need (ui:ZMod) = (bA-expr)·nb + Cp-expr = hui's RHS? hui RHS ApE·nb+CpE; after rw[hni] the ApE·(ni) + CpE becomes ApE·nb + CpE: rw [hApW] made LHS ApW·nb + CpW; hmm order: goal (ui:ZMod) = ApW·nb + CpW: hui : (ui:ZMod) = ApE·nb + CpE: ApE=CpE by rfl: so goal = hui's RHS mod rfl: after rw [hApW, hCpW] and rw [hni], goal (ui:ZMod) = ApW·nb + CpW; hui gives ApE·nb+CpE which IS ApW·nb+CpW by rfl of hApW/hCpW? rw wrote ApW into the goal; hui's RHS ApE·nb+CpE unfolds ApE→(ApW)? ApE is a let: hui's RHS = ApE·nb + CpE: with ApE reducible: simpa [hApW, hCpW] using hui?? then exact simpa [hApW,hCpW] using hui? goal after rw: (ui:ZMod) = ApW·nb + CpW: exact by: rw [hApW, hCpW] AT hui? hui : (ui:ZMod) = ApE·nb+CpE: rw [hApW] at hui rewrites ApE → ApW ✓ then rw[hni]? hui has nb already. so: have hneed' := hui; rw [hApW, hCpW] at hneed' gives (ui:ZMod) = ApW·nb+CpW ✓ exact hneed'.
    exact (by
      have hh := hui
      rw [hApW, hCpW] at hh
      exact hh)
  have hval : pseudoAffineVal A B C D ni ui = 0 := hiff.mpr hneed
  have hval' : normPsiRowB A B C D (ni : ZMod (2 ^ t)) (ui : ZMod (2 ^ t)) = 0 := by
    rw [← pseudoAffineVal_eq_normPsiRowB A B C D ni ui]
    exact hval
  have harg : (ui : ZMod (2 ^ t)) = ApE * (ni : ZMod (2 ^ t)) + CpE := by
    have hh := hui
    rw [← hni] at hh
    exact hh
  have hval'' : normPsiRowB A B C D (ni : ZMod (2 ^ t)) (ApE * (ni : ZMod (2 ^ t)) + CpE) = 0 := by
    rw [harg] at hval'
    exact hval'
  rw [← hni]
  exact hval''

/-- Shear-invariance (the `norm` assembly's use of Prop 7.7 "inv"): multiplying a
Sudoku solution by an odd integer after reparametrizing the columns affinely in the row
coordinate — `(n,m) ↦ c·F(n, m + B·rowVal n + C)` — gives a Sudoku solution again.
Composed from `IsSudokuSolution.affine` (column-affine reparametrization, `A := 1`) and
`IsSudokuSolution.homogeneity` (odd scalar multiplication). -/
lemma IsSudokuSolution.shear {t N : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (c B C : ℤ) (hc : Odd c) :
    IsSudokuSolution (2 ^ t) N (fun n m => (c : ZMod (2 ^ t)) * F n (m + B * rowVal n + C)) := by
  let G : SudokuBoard (2 ^ t) N := fun n m => F n (1 * m + B * rowVal n + C)
  have hG : IsSudokuSolution (2 ^ t) N G := IsSudokuSolution.affine F hF 1 B C
  have hHom : IsSudokuSolution (2 ^ t) N (fun n m => (c : ZMod (2 ^ t)) * G n m) :=
    IsSudokuSolution.homogeneity ht G hG c hc
  have hEq : (fun n m => (c : ZMod (2 ^ t)) * F n (m + B * rowVal n + C))
      = (fun n m => (c : ZMod (2 ^ t)) * F n (1 * m + B * rowVal n + C)) := by
    funext n m
    congr 1
    ring
  rw [hEq]
  simpa [G] using hHom

/-- Units of `ZMod (2^t)` have odd values (their value is coprime to `2^t`). -/
lemma odd_val_of_isUnit {t : ℕ} (ht : 1 ≤ t) (w : ZMod (2 ^ t)) (hw : IsUnit w) :
    Odd w.val := by
  have hw' : IsUnit (((w.val : ℕ) : ZMod (2 ^ t))) := by
    simpa [ZMod.natCast_zmod_val] using hw
  have hcop : (w.val).Coprime (2 ^ t) := (ZMod.isUnit_iff_coprime (w.val) (2 ^ t)).mp hw'
  exact Nat.coprime_two_right.mp ((Nat.coprime_pow_right_iff (by omega : 0 < t) (w.val) 2).mp hcop)

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # norm 9.6 — board assembly (`norm_normal_form`), WIP

From `affine_zero_slope_data` we obtain the shear slope/intercept `(Ap, Cp)` and the
class-level zero property.  The shearing function `F'(r,m) := c·F(r, m + a·rowVal r + b)`
(integer `a, b` lifting `Ap, Cp`, odd-integer-lift multiplier `c` of the unit
`B''⁻¹`) is a Sudoku solution (`IsSudokuSolution.shear`) — done below — and agrees off
`m ∉ qℤ` with the normal form `m̂ + (q/4)Dp·m̂(m̂−n̂)` (`shear_closure` + `hagree`;
still open). -/

/-- Proposition norm (finite form, WIP): a Sudoku solution agreeing with the
pseudo-affine `Ψ(n,m) = An+Bm+C+(q/4)D·m(m−n)` (`B` odd) off the zeros of `Ψ` has a
shearing in normal form: there are an affine-in-row integer shift `m ↦ m + a·rowVal r +
b`, an odd (unit) multiplier `c` and a coefficient `Dp` such that the sheared function
is a Sudoku solution and equals `m̂ + (q/4)Dp·m̂(m̂−n̂)` for all `m ∉ qℤ`. -/
theorem norm_normal_form {t N : ℕ} (ht1 : 1 ≤ t) (ht2 : 2 ≤ t) (ht3 : 3 ≤ t)
    (ht4 : 4 ≤ t) (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (A B C D : ZMod (2 ^ t)) (hB : ¬ Even B.val)
    (hagree : ∀ r : Fin N, ∀ m : ℤ, pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
      F r m = pseudoAffineVal A B C D (rowVal r) m) :
    ∃ (a b : ℤ) (c Dp : ZMod (2 ^ t)),
      IsUnit c ∧
      IsSudokuSolution (2 ^ t) N (fun r m => c * F r (m + a * rowVal r + b)) ∧
      ∀ r : Fin N, ∀ m : ℤ, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
        c * F r (m + a * rowVal r + b)
          = (m : ZMod (2 ^ t))
              + (qFourth t * Dp) * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
  classical
  rcases affine_zero_slope_data (t := t) ht1 ht2 ht3 ht4 A B C D hB with
    ⟨At, Ct, Dt, b2, Ap, Cp, hA, hC, hD, hb2, hAp, hCp, hzero⟩
  let Bp : ZMod (2 ^ t) := B + (2 : ZMod (2 ^ t)) * (qFourth t * D) * Cp + (qHalf t) * D * Ap
  have hoddB : Odd B.val := Nat.not_even_iff_odd.mp hB
  have hBunit : IsUnit B := zmod_isUnit_of_odd_val ht1 B hoddB
  have hBpU : IsUnit Bp := shear_Bp_isUnit ht1 ht2 B D Ap Cp hBunit
  rcases hBpU with ⟨u, hu⟩
  -- multiplier element: the coerced inverse of the unit u (whose coercion is Bp)
  let c : ZMod (2 ^ t) := ((u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t))
  have hcU : IsUnit c := by
    dsimp [c]
    exact ⟨u⁻¹, rfl⟩
  have hcOddN : Odd c.val := odd_val_of_isUnit ht1 c hcU
  let cZ : ℤ := (c.val : ℤ)
  have hcZodd : Odd cZ := by
    dsimp [cZ]
    exact_mod_cast hcOddN
  have hcZcast : (cZ : ZMod (2 ^ t)) = c := by
    dsimp [cZ]
    rw [Int.cast_natCast (c.val)]
    exact ZMod.natCast_zmod_val c
  let a : ℤ := (Ap.val : ℤ)
  let b : ℤ := (Cp.val : ℤ)
  have ha : (a : ZMod (2 ^ t)) = Ap := by
    dsimp [a]
    rw [Int.cast_natCast (Ap.val)]
    exact ZMod.natCast_zmod_val Ap
  have hb : (b : ZMod (2 ^ t)) = Cp := by
    dsimp [b]
    rw [Int.cast_natCast (Cp.val)]
    exact ZMod.natCast_zmod_val Cp
  have hFs : IsSudokuSolution (2 ^ t) N
      (fun r m => (cZ : ZMod (2 ^ t)) * F r (m + a * rowVal r + b)) := by
    exact IsSudokuSolution.shear ht1 F hF cZ a b hcZodd
  let Dp : ZMod (2 ^ t) := c * (D * (1 - (2 : ZMod (2 ^ t)) * Ap))
  refine ⟨a, b, c, Dp, hcU, ?_, ?_⟩
  · -- sheared function with the multiplier c (cZ lifts c):
    have hFn : (fun r m => c * F r (m + a * rowVal r + b))
        = (fun r m => (cZ : ZMod (2 ^ t)) * F r (m + a * rowVal r + b)) := by
      funext r m
      rw [hcZcast]
    rwa [hFn.symm] at hFs
  · -- VALUE IDENTITY: c·F(r, m + a·rowVal r + b) = normal form off m ∉ qℤ
    intro r m hm
    -- (1) Ψ ≠ 0 at the shifted cell
    have hΨ0 : pseudoAffineVal A B C D (rowVal r) (m + a * rowVal r + b) ≠ 0 := by
      intro hz
      apply hm
      have hiff := zero_iff_affine_slope_of_odd_B (t := t) ht1 ht2 ht3 ht4 A B C D hB
        (rowVal r) (m + a * rowVal r + b) At Ct Dt b2 hb2 hA hC hD
      have hcl := hiff.mp hz
      have hcl0 := hcl
      rw [← hAp, ← hCp] at hcl0
      have hcl' : (m : ZMod (2 ^ t)) + (a : ZMod (2 ^ t)) * (rowVal r : ZMod (2 ^ t))
            + (b : ZMod (2 ^ t))
          = Ap * (rowVal r : ZMod (2 ^ t)) + Cp := by
        simpa [Int.cast_add, Int.cast_mul] using hcl0
      have hcl'' : (m : ZMod (2 ^ t)) + Ap * (rowVal r : ZMod (2 ^ t)) + Cp
          = Ap * (rowVal r : ZMod (2 ^ t)) + Cp := by
        simpa [ha, hb] using hcl'
      have hm0 : (m : ZMod (2 ^ t)) = 0 := by
        calc
          (m : ZMod (2 ^ t)) = ((m : ZMod (2 ^ t)) + (Ap * (rowVal r : ZMod (2 ^ t)) + Cp))
              - (Ap * (rowVal r : ZMod (2 ^ t)) + Cp) := by ring
          _ = 0 := by
                have hmid : (m : ZMod (2 ^ t)) + (Ap * (rowVal r : ZMod (2 ^ t)) + Cp)
                      - (Ap * (rowVal r : ZMod (2 ^ t)) + Cp)
                    = (m : ZMod (2 ^ t)) + Ap * (rowVal r : ZMod (2 ^ t)) + Cp
                        - (Ap * (rowVal r : ZMod (2 ^ t)) + Cp) := by ring
                rw [hmid, hcl'']
                ring
      exact (by simpa using ((zmod_eq_iff_int_sub_dvd (2 ^ t) m 0).mp (by simpa using hm0)))
    -- (2) c·Bp = 1
    have hcBp : c * Bp = 1 := by
      dsimp [c]
      rw [← hu]
      exact u.inv_mul
    -- (3) the value chain
    calc
      c * F r (m + a * rowVal r + b)
          = c * pseudoAffineVal A B C D (rowVal r) (m + a * rowVal r + b) := by
              rw [hagree r (m + a * rowVal r + b) hΨ0]
      _ = c * normPsiRowB A B C D (rowVal r : ZMod (2 ^ t))
              ((m + a * rowVal r + b : ℤ) : ZMod (2 ^ t)) := by
              rw [pseudoAffineVal_eq_normPsiRowB]
      _ = c * normPsiRowB A B C D (rowVal r : ZMod (2 ^ t))
              ((m : ZMod (2 ^ t)) + (Ap * (rowVal r : ZMod (2 ^ t)) + Cp)) := by
              have hatomic : ((m + a * rowVal r + b : ℤ) : ZMod (2 ^ t))
                  = (m : ZMod (2 ^ t)) + (a : ZMod (2 ^ t)) * (rowVal r : ZMod (2 ^ t))
                      + (b : ZMod (2 ^ t)) := by
                simp [Int.cast_add, Int.cast_mul]
              rw [hatomic, ha, hb]
              ring
      _ = c * (Bp * (m : ZMod (2 ^ t))
            + (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t)))) := by
              have hsc : normPsiRowB A B C D (rowVal r : ZMod (2 ^ t))
                    ((m : ZMod (2 ^ t)) + (Ap * (rowVal r : ZMod (2 ^ t)) + Cp))
                  = Bp * (m : ZMod (2 ^ t))
                      + (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                          * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
                    dsimp [Bp]
                    exact shear_closure ht1 ht2 A B C D Ap Cp (rowVal r : ZMod (2 ^ t)) (m : ZMod (2 ^ t))
                      (hzero (rowVal r : ZMod (2 ^ t)))
              rw [hsc]
      _ = (m : ZMod (2 ^ t)) + (qFourth t * Dp) * (m : ZMod (2 ^ t))
              * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
              have hQ : c * (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                  = qFourth t * Dp := by
                dsimp [Dp]
                ring
              calc
                c * (Bp * (m : ZMod (2 ^ t))
                      + (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                          * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))))
                    = (c * Bp) * (m : ZMod (2 ^ t))
                        + c * ((qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                            * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t)))) := by ring
                _ = (m : ZMod (2 ^ t)) + c * ((qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                            * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t)))) := by
                        rw [hcBp]
                        simp
                _ = (m : ZMod (2 ^ t)) + (qFourth t * Dp) * (m : ZMod (2 ^ t))
                        * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
                        have hsplit : c * ((qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                                * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))))
                            = (qFourth t * Dp) * (m : ZMod (2 ^ t))
                                * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
                          calc
                            c * ((qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap)))
                                    * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))))
                                = (c * (qFourth t * (D * (1 - (2 : ZMod (2 ^ t)) * Ap))))
                                    * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by ring
                            _ = (qFourth t * Dp) * (m : ZMod (2 ^ t))
                                    * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by rw [hQ]
                        rw [hsplit]

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Prop tetris-iterate 9.7 (arXiv:2211.15847, tex 1394-1447) — diagonal analysis

Target: every Sudoku solution in normal form has a shearing (of its post-Tetris
version) in normal form.  The §analysis lemma list (formal cores, in order):
  (T1) normalForm_diag_affine (BELOW): restricting the normal-form value to the
       diagonal m = n + i gives the affine a·nb + b̂ with a := 1 + (q/4)D·ii,
       b̂ := ii + (q/4)D·ii².   [pure ring — proven]
  (T2) diag_a_odd: a = 1 + even is odd (q/4·x even-valued for t ≥ 3) — the oddness
       driving the digit/parity arguments.
  (T3) the normal-form board value restricted to the diagonal line F_{i,1} equals
       a·(rowVal r) + b off the bad coset {rowVal r + i ≡ 0 mod q} — from (T1) +
       norm_normal_form's identity (m ∉ qℤ means the cell (r, rowVal r + i) needs
       rowVal r + i ∉ qℤ, i.e. the off-bad-coset condition) + InScal closure gives
       F_{i,1} = f_q(ã·n + b̃) (inScal_reduced_qLine) with ã ≡ a, b̃ ≡ b mod q.
  (T4) bad-coset point values: at n_i (the rowVal ≡ −i mod q), ã·n_i + b̃ ≡ 0 mod q
       (since a·(−ii) + b̂ = 0 exactly — verify by ring), giving c̃ with ãn_i+b̃ = q·c̃.
  (T5) F*(n_i + qj, (n_i+i)/q + j) = f_q(ã·j + c̃) for j = 0..q−1 (fq_qmul_int pulls
       the q-factors) — the (eqs) computation.
  (T6) ã odd ⟹ each digit attained at most twice along j; double counting over the
       q² rows and the q-coset cover gives F* weak digit equidistribution (finite
       window bounds as in the near-digit (A) layer).
  (T7) near-digit on F* gives Ψ* = A*·nb + B*·m̂ + C* + hD*·m̂(m̂−nb); from the affine
       j ↦ Ψ*(n0 + qj, m0 + j) (T1 applied to F*'s normal form), parity of B*
       equals parity of ã (odd) via two consecutive agreement values. -/

/-- (T1) Diagonal restriction of the normal-form value: for the pseudo-affine function
`Ψ_normal(n, m) = m̂ + (q/4)D·m̂·(m̂ − nb)` in normal form, its value on the diagonal
`m = n + i` (row class `nb`, slope `i`) is affine in `nb` with slope `1 + (q/4)D·ii` and
intercept `ii + (q/4)D·ii²`. -/
lemma normalForm_diag_affine {t : ℕ} (D i : ZMod (2 ^ t)) :
    ∀ nb : ZMod (2 ^ t),
      ((nb + i) + (qFourth t * D) * (nb + i) * ((nb + i) - nb))
        = (1 + (qFourth t * D) * i) * nb + (i + (qFourth t * D) * i * i) := by
  intro nb
  ring

/-- `2y` has even value in `ZMod (2^t)`. -/
lemma even_val_mul_two {t : ℕ} (ht : 1 ≤ t) (y : ZMod (2 ^ t)) : Even ((2 * y).val) := by
  have hy : y = (((y.val : ℕ) : ZMod (2 ^ t))) := (ZMod.natCast_zmod_val y).symm
  have hcast : (2 : ZMod (2 ^ t)) * y = (((2 * y.val : ℕ) : ZMod (2 ^ t))) := by
    have h2 : ((2 : ℕ) : ZMod (2 ^ t)) = (2 : ZMod (2 ^ t)) := by norm_num
    conv_lhs => rw [hy]
    conv_lhs => rw [← h2]
    conv_lhs => rw [← Nat.cast_mul]
  rw [hcast]
  rw [ZMod.val_natCast]
  exact even_mod_of_even ht (2 * y.val) ⟨y.val, by omega⟩

/-- `2·z ≠ 1` in `ZMod (2^t)` (`t ≥ 1`). -/
lemma two_mul_ne_one {t : ℕ} (ht : 1 ≤ t) (z : ZMod (2 ^ t)) : (2 : ZMod (2 ^ t)) * z ≠ 1 := by
  intro hz
  have hev : Even (((2 : ZMod (2 ^ t)) * z).val) := even_val_mul_two ht z
  have hval1 : (1 : ZMod (2 ^ t)).val = 1 := by
    have hlt : 1 < 2 ^ t := by
      have h2t : (2 : ℕ) ≤ 2 ^ t := by
        exact pow_le_pow_right₀ (a := (2 : ℕ)) (ha := by norm_num) (m := 1) (n := t) ht
      exact lt_of_lt_of_le (by norm_num : (1 : ℕ) < 2) h2t
    have h1 : (1 : ZMod (2 ^ t)) = ((1 : ℕ) : ZMod (2 ^ t)) := by norm_num
    rw [h1, ZMod.val_natCast, Nat.mod_eq_of_lt hlt]
  rw [hz, hval1] at hev
  have hodd1 : Odd (1 : ℕ) := ⟨0, by norm_num⟩
  exact (Nat.not_even_iff_odd.mpr hodd1) hev

/-- `1 + x` has odd value when `x` has even value. -/
lemma odd_val_one_add_of_even {t : ℕ} (ht : 1 ≤ t) (x : ZMod (2 ^ t)) (hx : Even x.val) :
    Odd ((1 + x).val) := by
  have hne : ¬ Even ((1 + x).val) := by
    intro hEv
    rcases exists_two_mul_of_even_val (1 + x) hEv with ⟨w, hw⟩
    rcases exists_two_mul_of_even_val x hx with ⟨y, hy⟩
    have hone : 1 = (2 : ZMod (2 ^ t)) * (w - y) := by
      calc
        1 = (1 + x) - x := by ring
        _ = (2 : ZMod (2 ^ t)) * w - (2 : ZMod (2 ^ t)) * y := by rw [hw, hy]
        _ = (2 : ZMod (2 ^ t)) * (w - y) := by ring
    exact two_mul_ne_one ht (w - y) hone.symm
  exact (Nat.not_even_iff_odd).mp hne

/-- (T2) The diagonal slope `a := 1 + (q/4)D·i` is odd (`t ≥ 3`). -/
lemma diag_a_odd {t : ℕ} (ht1 : 1 ≤ t) (ht3 : 3 ≤ t) (D i : ZMod (2 ^ t)) :
    Odd ((1 + (qFourth t * D) * i).val) := by
  have h2 : (qFourth t * D) * i = (2 : ZMod (2 ^ t))
      * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * i)) := by
    calc
      (qFourth t * D) * i = (qFourth t) * (D * i) := by ring
      _ = (2 : ZMod (2 ^ t)) * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * i)) := qFourth_eq_two_mul ht3 (D * i)
  have hEv : Even (((qFourth t * D) * i).val) := by
    rw [h2]
    exact even_val_mul_two ht1 (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * (D * i))
  exact odd_val_one_add_of_even ht1 ((qFourth t * D) * i) hEv

/-- (T3) Diagonal-line affine identity from the normal-form hypothesis: if the board
`F` is in normal form with coefficient `Dp` (off `qℤ`), then the diagonal line
`r ↦ F r (rowVal r + i)` agrees off the bad coset `{rowVal r + i ≡ 0 mod q}` with the
affine `a·n̂ + b` where `a := 1 + (q/4)Dp·î`, `b := î + (q/4)Dp·î²`. -/
lemma normalForm_diag_line_affine {t N : ℕ}
    (F : SudokuBoard (2 ^ t) N) (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) (i : ℤ) :
    ∀ r : Fin N, ¬ (((2 ^ t : ℕ) : ℤ) ∣ (rowVal r + i)) →
      F r (rowVal r + i)
        = (1 + (qFourth t * Dp) * (i : ZMod (2 ^ t))) * (rowVal r : ZMod (2 ^ t))
            + ((i : ZMod (2 ^ t)) + (qFourth t * Dp) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t))) := by
  intro r hm
  have hv := hNF r (rowVal r + i) hm
  rw [hv]
  have hT1 := normalForm_diag_affine (t := t) Dp (i : ZMod (2 ^ t)) (rowVal r : ZMod (2 ^ t))
  have hcv : pseudoAffineVal 0 1 0 Dp (rowVal r) (rowVal r + i)
      = ((rowVal r : ZMod (2 ^ t)) + (i : ZMod (2 ^ t)))
          + (qFourth t * Dp) * ((rowVal r : ZMod (2 ^ t)) + (i : ZMod (2 ^ t)))
              * (((rowVal r : ZMod (2 ^ t)) + (i : ZMod (2 ^ t))) - (rowVal r : ZMod (2 ^ t))) := by
    dsimp [pseudoAffineVal, pseudoCorr]
    rw [Int.cast_add]
    simp
  rw [hcv]
  exact hT1

lemma int_dvd_add_iff_zmod_eq_neg (t : ℕ) (x i : ℤ) :
    (((2 ^ t : ℕ) : ℤ) ∣ x + i) ↔ (x : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t)) := by
  rw [← ZMod.intCast_zmod_eq_zero_iff_dvd (x + i) (2 ^ t)]
  constructor
  · intro h
    have hc : (x : ZMod (2 ^ t)) + (i : ZMod (2 ^ t)) = 0 := by
      simpa [Int.cast_add] using h
    exact eq_neg_of_add_eq_zero_left hc
  · intro h
    have hc : (x : ZMod (2 ^ t)) + (i : ZMod (2 ^ t)) = 0 := by
      exact add_eq_zero_iff_eq_neg.mpr h
    simpa [Int.cast_add] using hc

/-- (T4-ring) The diagonal affine with coefficients `aZ := 1 + (q/4)Dp·i`,
`bZ := i + (q/4)Dp·i²` vanishes at `-i`: `aZ·(-i) + bZ = 0`. -/
lemma diag_affine_zero_at_minus {t : ℕ} (Dp i : ZMod (2 ^ t)) :
    (1 + (qFourth t * Dp) * i) * (-i) + (i + (qFourth t * Dp) * i * i) = 0 := by
  ring

/-- `bZ = aZ·i` for the diagonal affine coefficients (`aZ := 1+(q/4)Dp·i`,
`bZ := i + (q/4)Dp·i²`). -/
lemma diag_bZ_eq_mul {t : ℕ} (Dp i : ZMod (2 ^ t)) :
    i + (qFourth t * Dp) * i * i = (1 + (qFourth t * Dp) * i) * i := by
  ring

/-- If `(A,B)` lift the diagonal coefficients `(aZ,bZ)`, the affine `qAffine A B`
factors: `qAffine A B x = aZ·(x̂ + i)`. -/
lemma qAffine_diag_factor {t : ℕ} (A B : ℤ) (Dp i : ZMod (2 ^ t))
    (hA : (A : ZMod (2 ^ t)) = 1 + (qFourth t * Dp) * i)
    (hB : (B : ZMod (2 ^ t)) = i + (qFourth t * Dp) * i * i) (x : ℤ) :
    qAffine (2 ^ t) A B x = (1 + (qFourth t * Dp) * i) * ((x : ZMod (2 ^ t)) + i) := by
  have hb : i + (qFourth t * Dp) * i * i = (1 + (qFourth t * Dp) * i) * i :=
    diag_bZ_eq_mul Dp i
  calc
    qAffine (2 ^ t) A B x = (A : ZMod (2 ^ t)) * (x : ZMod (2 ^ t)) + (B : ZMod (2 ^ t)) := rfl
    _ = (1 + (qFourth t * Dp) * i) * (x : ZMod (2 ^ t))
        + (i + (qFourth t * Dp) * i * i) := by rw [hA, hB]
    _ = (1 + (qFourth t * Dp) * i) * ((x : ZMod (2 ^ t)) + i) := by
        rw [hb]
        ring

/-- With the diagonal slope `aZ` a unit, `qAffine A B` (lifting the diagonal
coefficients) vanishes exactly at the bad row class: `qAffine A B x = 0 ↔ x̂ = -i`. -/
lemma qAffine_diag_zero_iff {t : ℕ} (A B : ℤ) (Dp i : ZMod (2 ^ t))
    (hA : (A : ZMod (2 ^ t)) = 1 + (qFourth t * Dp) * i)
    (hB : (B : ZMod (2 ^ t)) = i + (qFourth t * Dp) * i * i)
    (haU : IsUnit (1 + (qFourth t * Dp) * i)) (x : ℤ) :
    qAffine (2 ^ t) A B x = 0 ↔ (x : ZMod (2 ^ t)) = -i := by
  have hfac := qAffine_diag_factor (A := A) (B := B) (Dp := Dp) (i := i) hA hB x
  constructor
  · intro hz
    have h : (1 + (qFourth t * Dp) * i) * ((x : ZMod (2 ^ t)) + i) = 0 := by
      simpa [hfac] using hz
    rcases haU with ⟨u, hu⟩
    have hu0 : (u : ZMod (2 ^ t)) * (((x : ZMod (2 ^ t)) + i)) = 0 := by
      simpa [hu] using h
    have hz0 : ((x : ZMod (2 ^ t)) + i) = 0 := by
      calc
        ((x : ZMod (2 ^ t)) + i) = (↑(u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((u : ZMod (2 ^ t)) * ((x : ZMod (2 ^ t)) + i)) := by
            rw [← mul_assoc, u.inv_mul]
            simp
        _ = 0 := by rw [hu0]; simp
    exact eq_neg_of_add_eq_zero_left hz0
  · intro hx
    rw [hfac, hx]
    simp

/-- The diagonal-affine slope coefficient `aZ := 1 + (q/4)Dp·î` (a unit for `t ≥ 3`). -/
def diagAZ {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) : ZMod (2 ^ t) :=
  1 + (qFourth t * Dp) * (i : ZMod (2 ^ t))

/-- The diagonal-affine intercept coefficient `bZ := î + (q/4)Dp·î²`. -/
def diagBZ {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) : ZMod (2 ^ t) :=
  (i : ZMod (2 ^ t)) + (qFourth t * Dp) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t))

/-- Integer lift of `diagAZ` (a natural representative coerced to `ℤ`). -/
def diagA {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) : ℤ := (diagAZ Dp i).val

/-- Integer lift of `diagBZ`. -/
def diagB {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) : ℤ := (diagBZ Dp i).val

lemma diagA_cast {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) :
    (diagA Dp i : ZMod (2 ^ t)) = diagAZ Dp i := by
  dsimp [diagA]
  rw [Int.cast_natCast]
  exact ZMod.natCast_zmod_val (diagAZ Dp i)

lemma diagB_cast {t : ℕ} (Dp : ZMod (2 ^ t)) (i : ℤ) :
    (diagB Dp i : ZMod (2 ^ t)) = diagBZ Dp i := by
  dsimp [diagB]
  rw [Int.cast_natCast]
  exact ZMod.natCast_zmod_val (diagBZ Dp i)

/-- (T3b-rigid-out) On a normal-form board the slope-`1` diagonal line through intercept
`i` has a reduced `qLine` representation whose restriction agrees (off the diagonal bad
coset `{x̂ = -î}`) with the lifted diagonal affine `qAffine (diagA) (diagB)`. -/
theorem diag_line_reduced_rigid_out {t N : ℕ} (ht : 3 ≤ t) (hN : 8 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t)) (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) (i : ℤ) :
    ∃ a0 b0 : ℤ,
      ¬ (((2 ^ t : ℕ) : ℤ) ∣ a0 ∧ ((2 ^ t : ℕ) : ℤ) ∣ b0) ∧
      (∀ r : Fin N, lineRestrict F i 1 r = qLine (2 ^ t) a0 b0 (finToInt r)) ∧
      (∀ r : Fin N, qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt r) ≠ 0 →
        qLine (2 ^ t) a0 b0 (finToInt r) = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt r)) ∧
      (∀ x : ℤ, x ∈ badCoset (2 ^ t) (diagA Dp i) (diagB Dp i) ↔
        (x : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t))) := by
  classical
  have ht1 : 1 ≤ t := by omega
  have haZodd : Odd (diagAZ Dp i).val := by
    dsimp [diagAZ]
    exact diag_a_odd ht1 ht Dp (i : ZMod (2 ^ t))
  have haU : IsUnit (diagAZ Dp i) := zmod_isUnit_of_odd_val ht1 (diagAZ Dp i) haZodd
  have hA := diagA_cast (Dp := Dp) (i := i)
  have hB := diagB_cast (Dp := Dp) (i := i)
  have hfac (x : ℤ) : qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) x = 0 ↔
      (x : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t)) := by
    -- unfold diagA/diagB/diagAZ/diagBZ so that qAffine_diag_zero_iff applies
    change qAffine (2 ^ t) ((diagAZ Dp i).val : ℤ) ((diagBZ Dp i).val : ℤ) x = 0 ↔
      (x : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t))
    exact qAffine_diag_zero_iff (A := ((diagAZ Dp i).val : ℤ)) (B := ((diagBZ Dp i).val : ℤ))
      (Dp := Dp) (i := (i : ZMod (2 ^ t)))
      (by dsimp [diagAZ]; rw [Int.cast_natCast]; exact ZMod.natCast_zmod_val (diagAZ Dp i))
      (by dsimp [diagBZ]; rw [Int.cast_natCast]; exact ZMod.natCast_zmod_val (diagBZ Dp i))
      (by simpa [diagAZ] using haU) x
  obtain ⟨a0, b0, hred, heq⟩ := inScal_reduced_qLine ht1 (hF.2 i 1)
  refine ⟨a0, b0, hred, heq, ?_, ?_⟩
  · -- rigid-out on the window {1..8}
    have hagree : ∀ n : Fin N, (1 : ℤ) ≤ finToInt n → finToInt n ≤ (1 : ℤ) + 7 →
        qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt n) ≠ 0 →
        qLine (2 ^ t) a0 b0 (finToInt n) = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt n) := by
      intro n hn1 hn8 hα
      have hnd : ¬ (((2 ^ t : ℕ) : ℤ) ∣ (finToInt n + i)) := by
        intro hd
        have hx : (finToInt n : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t)) :=
          (int_dvd_add_iff_zmod_eq_neg t (finToInt n) i).mp hd
        exact hα ((hfac (finToInt n)).mpr hx)
      have hT3 := normalForm_diag_line_affine (t := t) (N := N) F Dp hNF i n
      have hdiv : ¬ (((2 ^ t : ℕ) : ℤ) ∣ (rowVal n + i)) := by
        simpa [rowVal_eq_finToInt] using hnd
      have hval := hT3 hdiv
      have hline : lineRestrict F i 1 n = F n (finToInt n + i) := by
        change F n ((1 : ℤ) * finToInt n + i) = F n (finToInt n + i)
        congr 1
        ring
      calc
        qLine (2 ^ t) a0 b0 (finToInt n) = lineRestrict F i 1 n := (heq n).symm
        _ = F n (finToInt n + i) := hline
        _ = F n (rowVal n + i) := by rfl
        _ = (1 + (qFourth t * Dp) * (i : ZMod (2 ^ t))) * (rowVal n : ZMod (2 ^ t))
            + ((i : ZMod (2 ^ t)) + (qFourth t * Dp) * (i : ZMod (2 ^ t)) * (i : ZMod (2 ^ t))) := hval
        _ = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt n) := by
            rw [qAffine, hA, hB]
            rfl
    have hro := rigid_out_reduced (t := t) (N := N) ht a0 b0 (diagA Dp i) (diagB Dp i) (1 : ℤ)
      hred (by norm_num) (by exact_mod_cast hN) hagree
    intro n hα
    exact hro n hα
  · intro x
    exact hfac x



/-- Oddness transfers from `ℕ` to `ℤ` through the natural cast. -/
lemma odd_intCast {n : ℕ} (hn : Odd n) : Odd (n : ℤ) := by
  rcases hn with ⟨k, hk⟩
  refine ⟨(k : ℤ), ?_⟩
  rw [hk]
  norm_num

lemma zmod_isUnit_of_odd_int {t : ℕ} (ht : 1 ≤ t) (a : ℤ) (ha : Odd a) :
    IsUnit (a : ZMod (2 ^ t)) := by
  exact zmod_isUnit_of_odd (a' := a) (m := 2 ^ t) (Int.natAbs_odd.mpr ha)
    ⟨t - 1, by
      rw [show t = (t - 1) + 1 by omega]
      rfl⟩

/-- The modulus `q = 2^t` is at least `8` for `t ≥ 3`. -/
lemma two_pow_ge_eight {t : ℕ} (ht : 3 ≤ t) : (8 : ℕ) ≤ 2 ^ t := by
  have hp : (8 : ℕ) ≤ 2 ^ 3 := by norm_num
  exact le_trans hp (pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) ht)

/-- An affine with unit slope vanishes at at most one point of `{1..8}`: if it vanishes
at `x,y` there, then `x = y`. -/
lemma unit_affine_zero_pair_eq {t : ℕ} (ht : 3 ≤ t) (A B : ℤ)
    (hAunit : IsUnit (A : ZMod (2 ^ t))) {x y : ℤ}
    (hx : qAffine (2 ^ t) A B x = 0) (hy : qAffine (2 ^ t) A B y = 0)
    (hxw : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ)) (hyw : y ∈ Finset.Icc (1 : ℤ) (8 : ℤ)) :
    x = y := by
  have hdiff : qAffine (2 ^ t) A B x - qAffine (2 ^ t) A B y
      = (A : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) := by
    simp [qAffine, Int.cast_sub]
    ring
  have hz : (A : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    rw [← hdiff]
    rw [hx, hy]
    simp
  rcases hAunit with ⟨u, hu⟩
  have hu0 : (u : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    simpa [hu] using hz
  have hw0 : ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    calc
      ((x - y : ℤ) : ZMod (2 ^ t)) =
          (↑(u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((u : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t))) := by
            rw [← mul_assoc, u.inv_mul]
            simp
      _ = 0 := by rw [hu0]; simp
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ x - y :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (x - y) (2 ^ t)).mp hw0
  exact coset_window_le_one (d := 2 ^ t) (two_pow_ge_eight ht) (n₀ := y) (n0 := 1) x y hdvd
    ⟨0, by simp⟩
    ⟨(Finset.mem_Icc.mp hxw).1, by simpa using (Finset.mem_Icc.mp hxw).2⟩
    ⟨(Finset.mem_Icc.mp hyw).1, by simpa using (Finset.mem_Icc.mp hyw).2⟩

lemma unit_affine_zero_sparse_window {t : ℕ} (ht : 3 ≤ t) (A B : ℤ)
    (hAunit : IsUnit (A : ZMod (2 ^ t))) :
    ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter
      (fun x : ℤ => qAffine (2 ^ t) A B x = 0)).card ≤ 1 := by
  rw [Finset.card_le_one]
  intro x hx y hy
  exact unit_affine_zero_pair_eq ht A B hAunit (Finset.mem_filter.mp hx).2
    (Finset.mem_filter.mp hy).2 (Finset.mem_filter.mp hx).1 (Finset.mem_filter.mp hy).1

/-- A unit-slope affine is injective on `{1..8}`. -/
lemma unit_affine_injective_window {t : ℕ} (ht : 3 ≤ t) (A B : ℤ)
    (hAunit : IsUnit (A : ZMod (2 ^ t))) {x y : ℤ}
    (hxy : x ≠ y) (hxw : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ))
    (hyw : y ∈ Finset.Icc (1 : ℤ) (8 : ℤ)) :
    qAffine (2 ^ t) A B x ≠ qAffine (2 ^ t) A B y := by
  intro hEq
  have hdiff : qAffine (2 ^ t) A B x - qAffine (2 ^ t) A B y
      = (A : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) := by
    simp [qAffine, Int.cast_sub]
    ring
  have hz : (A : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    rw [← hdiff]
    rw [hEq]
    simp
  rcases hAunit with ⟨u, hu⟩
  have hu0 : (u : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    simpa [hu] using hz
  have hw0 : ((x - y : ℤ) : ZMod (2 ^ t)) = 0 := by
    calc
      ((x - y : ℤ) : ZMod (2 ^ t)) =
          (↑(u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) * ((u : ZMod (2 ^ t)) * ((x - y : ℤ) : ZMod (2 ^ t))) := by
            rw [← mul_assoc, u.inv_mul]
            simp
      _ = 0 := by rw [hu0]; simp
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ x - y :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd (x - y) (2 ^ t)).mp hw0
  have heq : x = y :=
    coset_window_le_one (d := 2 ^ t) (two_pow_ge_eight ht) (n₀ := y) (n0 := 1) x y hdvd
      ⟨0, by simp⟩
      ⟨(Finset.mem_Icc.mp hxw).1, by simpa using (Finset.mem_Icc.mp hxw).2⟩
      ⟨(Finset.mem_Icc.mp hyw).1, by simpa using (Finset.mem_Icc.mp hyw).2⟩
  exact hxy heq

/-- If at most one point of an 8-window is blocked by `P` and at most two by `Q`, then two
free (unblocked) points of opposite parity exist (hence an odd-separated free pair). -/
lemma exists_odd_sep_free_pair_of_sparse (P Q : ℤ → Prop) [DecidablePred P] [DecidablePred Q]
    (hP : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => P x)).card ≤ 1)
    (hQ : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => Q x)).card ≤ 2) :
    ∃ x y : ℤ, x ∈ Finset.Icc (1 : ℤ) (8 : ℤ) ∧ y ∈ Finset.Icc (1 : ℤ) (8 : ℤ) ∧
      ¬ P x ∧ ¬ Q x ∧ ¬ P y ∧ ¬ Q y ∧ Odd (y - x) := by
  classical
  let W : Finset ℤ := Finset.Icc (1 : ℤ) (8 : ℤ)
  let rem : Finset ℤ := W.filter (fun x : ℤ => P x ∨ Q x)
  let free : Finset ℤ := W.filter (fun x : ℤ => ¬ P x ∧ ¬ Q x)
  have hWcard : W.card = 8 := by
    dsimp [W]
    exact Icc_one_card 8
  have hrem : rem.card ≤ 3 := by
    dsimp [rem, W]
    rw [Finset.filter_or]
    calc
      (((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => P x)) ∪
        ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => Q x))).card
          ≤ ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => P x)).card +
              ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => Q x)).card :=
            Finset.card_union_le _ _
      _ ≤ 3 := by omega
  have hfreeW : free ⊆ W := by
    intro x hx
    exact (Finset.mem_filter.mp hx).1
  have hfree_eq : free = W \ rem := by
    ext x
    constructor
    · intro hx
      rw [Finset.mem_sdiff]
      exact ⟨(Finset.mem_filter.mp hx).1, by
        intro hremx
        have hx' : ¬ P x ∧ ¬ Q x := (Finset.mem_filter.mp hx).2
        rcases (Finset.mem_filter.mp hremx).2 with hPx | hQx
        · exact hx'.1 hPx
        · exact hx'.2 hQx⟩
    · intro hx
      rcases (Finset.mem_sdiff.mp hx) with ⟨hxW, hxrem⟩
      rw [Finset.mem_filter]
      refine ⟨hxW, ?_⟩
      constructor
      · intro hPx
        exact hxrem (by
          rw [Finset.mem_filter]
          exact ⟨hxW, Or.inl hPx⟩)
      · intro hQx
        exact hxrem (by
          rw [Finset.mem_filter]
          exact ⟨hxW, Or.inr hQx⟩)
  have hremW : rem ⊆ W := by
    intro x hx
    exact (Finset.mem_filter.mp hx).1
  have hdisj : Disjoint free rem := by
    rw [Finset.disjoint_left]
    intro x hxfree hxrem
    rcases (Finset.mem_filter.mp hxfree) with ⟨_, hfr⟩
    rcases (Finset.mem_filter.mp hxrem) with ⟨_, hrm⟩
    rcases hrm with hPx | hQx
    · exact hfr.1 hPx
    · exact hfr.2 hQx
  have hWfree : W = free ∪ rem := by
    ext x
    constructor
    · intro hxW
      rw [Finset.mem_union]
      by_cases hPQ : P x ∨ Q x
      · right
        rw [Finset.mem_filter]
        exact ⟨hxW, hPQ⟩
      · left
        rw [Finset.mem_filter]
        refine ⟨hxW, ?_⟩
        constructor
        · intro hPx
          exact hPQ (Or.inl hPx)
        · intro hQx
          exact hPQ (Or.inr hQx)
    · intro hx
      rw [Finset.mem_union] at hx
      rcases hx with hxfree | hxrem
      · exact hfreeW hxfree
      · exact hremW hxrem
  have hsum : free.card + rem.card = 8 := by
    have hc := Finset.card_union_of_disjoint hdisj
    -- hc : (free ∪ rem).card = free.card + rem.card
    rw [← hWfree] at hc
    rw [← hc]
    exact hWcard
  have hfree_card : 5 ≤ free.card := by
    omega
  have hexists_even : ∃ e : ℤ, e ∈ free ∧ Even e := by
    by_contra hne
    push_neg at hne
    have hsub : free ⊆ W.filter (fun x : ℤ => Odd x) := by
      intro x hx
      rw [Finset.mem_filter]
      refine ⟨hfreeW hx, ?_⟩
      have hxodd : Odd x := by
        by_contra hnotodd
        have hxeven : Even x := by
          have hxmem : x ∈ W := hfreeW hx
          exact Int.not_odd_iff_even.mp hnotodd   -- check lemma name
        exact hne x hx hxeven
      exact hxodd
    have hle4 : free.card ≤ 4 := by
      calc
        free.card ≤ (W.filter (fun x : ℤ => Odd x)).card := Finset.card_le_card hsub
        _ = 4 := by
          dsimp [W]
          simpa using (Commons.Data.Int.Window.card_Icc_eight_even_odd (1 : ℤ)).2
    omega
  have hexists_odd : ∃ o : ℤ, o ∈ free ∧ Odd o := by
    by_contra hno
    push_neg at hno
    have hsub : free ⊆ W.filter (fun x : ℤ => Even x) := by
      intro x hx
      rw [Finset.mem_filter]
      refine ⟨hfreeW hx, ?_⟩
      by_contra hnoteven
      have hxodd : Odd x := Int.not_even_iff_odd.mp hnoteven
      exact hno x hx hxodd
    have hle4 : free.card ≤ 4 := by
      calc
        free.card ≤ (W.filter (fun x : ℤ => Even x)).card := Finset.card_le_card hsub
        _ = 4 := by
          dsimp [W]
          simpa using (Commons.Data.Int.Window.card_Icc_eight_even_odd (1 : ℤ)).1
    omega
  rcases hexists_even with ⟨e, hefree, heEven⟩
  rcases hexists_odd with ⟨o, hofree, hoOdd⟩
  have hE : e ∈ W := hfreeW hefree
  have hO : o ∈ W := hfreeW hofree
  have hEfree : ¬ P e ∧ ¬ Q e := (Finset.mem_filter.mp hefree).2
  have hOfree : ¬ P o ∧ ¬ Q o := (Finset.mem_filter.mp hofree).2
  refine ⟨e, o, hE, hO, hEfree.1, hEfree.2, hOfree.1, hOfree.2, ?_⟩
  -- Odd (o - e): o odd minus e even
  exact odd_sub_of_even_odd (a := e) (b := o) heEven hoOdd

/-- At least two distinct odd rows of `{1,3,5,7}` are not zeros of the unit-slope affine
`α := qAffine A B`. -/
lemma two_free_odd_rows {t : ℕ} (ht : 3 ≤ t) (A B : ℤ)
    (hAunit : IsUnit (A : ZMod (2 ^ t))) :
    ∃ x y : ℤ, x ∈ ({1, 3, 5, 7} : Finset ℤ) ∧ y ∈ ({1, 3, 5, 7} : Finset ℤ) ∧
      x ≠ y ∧ qAffine (2 ^ t) A B x ≠ 0 ∧ qAffine (2 ^ t) A B y ≠ 0 := by
  classical
  let S : Finset ℤ := ({1, 3, 5, 7} : Finset ℤ)
  let z : Finset ℤ := S.filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0)
  let f : Finset ℤ := S.filter (fun x : ℤ => qAffine (2 ^ t) A B x ≠ 0)
  have hZ : z.card ≤ 1 := by
    dsimp [z]
    have hsub : S.filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0) ⊆
        (Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0) := by
      intro x hx
      rw [Finset.mem_filter] at hx ⊢
      rcases hx with ⟨hxS, hx0⟩
      have hxI : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
        dsimp [S] at hxS
        simp at hxS
        rcases hxS with rfl | rfl | rfl | rfl <;> norm_num
      exact ⟨hxI, hx0⟩
    exact le_trans (Finset.card_le_card hsub) (unit_affine_zero_sparse_window ht A B hAunit)
  have hzS : z ⊆ S := by
    intro x hx
    exact (Finset.mem_filter.mp hx).1
  have hf_eq : f = S \ z := by
    ext x
    rw [Finset.mem_sdiff]
    constructor
    · intro hx
      rw [Finset.mem_filter] at hx
      exact ⟨hx.1, by intro hz; rw [Finset.mem_filter] at hz; exact hx.2 hz.2⟩
    · intro hx
      rw [Finset.mem_filter]
      exact ⟨hx.1, by intro h0; exact hx.2 (by rw [Finset.mem_filter]; exact ⟨hx.1, h0⟩)⟩
  have hfcard : 3 ≤ f.card := by
    have hScard : S.card = 4 := by
      dsimp [S]
      norm_num
    have hfc : f.card = S.card - z.card := by
      rw [hf_eq]
      rw [Finset.card_sdiff]
      have hinter : z ∩ S = z := Finset.inter_eq_left.mpr hzS
      rw [hinter]
    rw [hfc, hScard]
    omega
  have hone : 1 < f.card := by omega
  rcases (Finset.one_lt_card.mp hone) with ⟨x, hxf, y, hyf, hxy⟩
  rw [Finset.mem_filter] at hxf hyf
  exact ⟨x, y, hxf.1, hyf.1, hxy, hxf.2, hyf.2⟩

/-- At least two distinct even rows of `{2,4,6}` are not zeros of the unit-slope affine
`α := qAffine A B`. -/
lemma two_free_even_rows {t : ℕ} (ht : 3 ≤ t) (A B : ℤ)
    (hAunit : IsUnit (A : ZMod (2 ^ t))) :
    ∃ x y : ℤ, x ∈ ({2, 4, 6} : Finset ℤ) ∧ y ∈ ({2, 4, 6} : Finset ℤ) ∧
      x ≠ y ∧ qAffine (2 ^ t) A B x ≠ 0 ∧ qAffine (2 ^ t) A B y ≠ 0 := by
  classical
  let S : Finset ℤ := ({2, 4, 6} : Finset ℤ)
  let z : Finset ℤ := S.filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0)
  let f : Finset ℤ := S.filter (fun x : ℤ => qAffine (2 ^ t) A B x ≠ 0)
  have hZ : z.card ≤ 1 := by
    dsimp [z]
    have hsub : S.filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0) ⊆
        (Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => qAffine (2 ^ t) A B x = 0) := by
      intro x hx
      rw [Finset.mem_filter] at hx ⊢
      rcases hx with ⟨hxS, hx0⟩
      have hxI : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
        dsimp [S] at hxS
        simp at hxS
        rcases hxS with rfl | rfl | rfl | rfl <;> norm_num
      exact ⟨hxI, hx0⟩
    exact le_trans (Finset.card_le_card hsub) (unit_affine_zero_sparse_window ht A B hAunit)
  have hzS : z ⊆ S := by
    intro x hx
    exact (Finset.mem_filter.mp hx).1
  have hf_eq : f = S \ z := by
    ext x
    rw [Finset.mem_sdiff]
    constructor
    · intro hx
      rw [Finset.mem_filter] at hx
      exact ⟨hx.1, by intro hz; rw [Finset.mem_filter] at hz; exact hx.2 hz.2⟩
    · intro hx
      rw [Finset.mem_filter]
      exact ⟨hx.1, by intro h0; exact hx.2 (by rw [Finset.mem_filter]; exact ⟨hx.1, h0⟩)⟩
  have hfcard : 2 ≤ f.card := by
    have hScard : S.card = 3 := by
      dsimp [S]
      norm_num
    have hfc : f.card = S.card - z.card := by
      rw [hf_eq]
      rw [Finset.card_sdiff]
      have hinter : z ∩ S = z := Finset.inter_eq_left.mpr hzS
      rw [hinter]
    rw [hfc, hScard]
    omega
  have hone : 1 < f.card := by omega
  rcases (Finset.one_lt_card.mp hone) with ⟨x, hxf, y, hyf, hxy⟩
  rw [Finset.mem_filter] at hxf hyf
  exact ⟨x, y, hxf.1, hyf.1, hxy, hxf.2, hyf.2⟩

/-- Two-point closure: if a free odd-separated pair of rows exists (rows where both the
structured line's affine `β := qAffine a0 b0` and the target affine `α := qAffine A B`
are non-zero, with the rigid-out agreement `qLine a0 b0 = α` holding there), then
`β = α` as functions on all of `ℤ`. -/
lemma line_affine_eq_of_free_pair {t N : ℕ} (ht : 3 ≤ t) (hN : 8 ≤ N)
    (a0 b0 A B : ℤ)
    (hagree : ∀ x : ℤ, 1 ≤ x → x ≤ (N : ℤ) →
      qAffine (2 ^ t) A B x ≠ 0 → qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) A B x)
    {x y : ℤ} (hxw : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ)) (hyw : y ∈ Finset.Icc (1 : ℤ) (8 : ℤ))
    (hodd : Odd (y - x))
    (hfreex : qAffine (2 ^ t) a0 b0 x ≠ 0 ∧ qAffine (2 ^ t) A B x ≠ 0)
    (hfreey : qAffine (2 ^ t) a0 b0 y ≠ 0 ∧ qAffine (2 ^ t) A B y ≠ 0) :
    ∀ z : ℤ, qAffine (2 ^ t) a0 b0 z = qAffine (2 ^ t) A B z := by
  classical
  have ht1 : 1 ≤ t := by omega
  have hq : 1 < 2 ^ t := two_pow_gt_one ht1
  have hx1 : 1 ≤ x := (Finset.mem_Icc.mp hxw).1
  have hx8 : x ≤ (8 : ℤ) := (Finset.mem_Icc.mp hxw).2
  have hxN : x ≤ (N : ℤ) := by
    have h8N : (8 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN
    omega
  have hy1 : 1 ≤ y := (Finset.mem_Icc.mp hyw).1
  have hyN : y ≤ (N : ℤ) := by
    have h8N : (8 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN
    have hy8 : y ≤ (8 : ℤ) := (Finset.mem_Icc.mp hyw).2
    omega
  have hx_not_bad : x ∉ badCoset (2 ^ t) a0 b0 := by
    intro hmem
    exact hfreex.1 (by simpa [badCoset] using hmem)
  have hy_not_bad : y ∉ badCoset (2 ^ t) a0 b0 := by
    intro hmem
    exact hfreey.1 (by simpa [badCoset] using hmem)
  have hβx : qAffine (2 ^ t) a0 b0 x = qAffine (2 ^ t) A B x := by
    calc
      qAffine (2 ^ t) a0 b0 x = qLine (2 ^ t) a0 b0 x :=
        (qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq (a := a0) (b := b0) (n := x) hx_not_bad).symm
      _ = qAffine (2 ^ t) A B x := hagree x hx1 hxN hfreex.2
  have hβy : qAffine (2 ^ t) a0 b0 y = qAffine (2 ^ t) A B y := by
    calc
      qAffine (2 ^ t) a0 b0 y = qLine (2 ^ t) a0 b0 y :=
        (qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq (a := a0) (b := b0) (n := y) hy_not_bad).symm
      _ = qAffine (2 ^ t) A B y := hagree y hy1 hyN hfreey.2
  have hfeq : qAffine (2 ^ t) a0 b0 = qAffine (2 ^ t) A B :=
    qAffine_eq_of_agree_two_points ht1 hβx hβy hodd
  intro z
  exact congrFun hfeq z


/-- THE RECONCILIATION (T3b Part 2 core): if the structured line `qLine a0 b0` agrees with
the unit-slope affine `α := qAffine A B` on all rows off α's zero set, then the affines
`qAffine a0 b0` and `α` are equal everywhere.  Branch structure: `a0` odd (both slopes
units) → free odd pair; `a0` even → the statistics `S` of `(a0,b0)`: order −∞ (bad coset
empty) or a coset of spacing `2^{t-ord}` — spacing ≥ 4 → free odd pair; spacing 2
(`ord = t−1`) is ruled out by the free-row/injectivity contradiction below. -/
lemma reduced_line_affine_eq_of_agree {t N : ℕ} (ht : 3 ≤ t) (hN : 8 ≤ N)
    (a0 b0 A B : ℤ)
    (hred : ¬ (((2 ^ t : ℕ) : ℤ) ∣ a0 ∧ ((2 ^ t : ℕ) : ℤ) ∣ b0))
    (hAodd : Odd A)
    (hagree : ∀ x : ℤ, 1 ≤ x → x ≤ (N : ℤ) →
      qAffine (2 ^ t) A B x ≠ 0 → qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) A B x) :
    ∀ z : ℤ, qAffine (2 ^ t) a0 b0 z = qAffine (2 ^ t) A B z := by
  classical
  have ht1 : 1 ≤ t := by omega
  have hAunit : IsUnit (A : ZMod (2 ^ t)) := zmod_isUnit_of_odd_int ht1 A hAodd
  have hP : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter
      (fun x : ℤ => qAffine (2 ^ t) A B x = 0)).card ≤ 1 :=
    unit_affine_zero_sparse_window ht A B hAunit
  by_cases hodd : Odd a0
  · -- a0 odd: both slopes are units, both bad cosets have ≤ 1 point in the window
    have ha0unit : IsUnit (a0 : ZMod (2 ^ t)) := zmod_isUnit_of_odd_int ht1 a0 hodd
    have hQ : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter
        (fun x : ℤ => qAffine (2 ^ t) a0 b0 x = 0)).card ≤ 1 :=
      unit_affine_zero_sparse_window ht a0 b0 ha0unit
    obtain ⟨x, y, hxw, hyw, hPx, hQx, hPy, hQy, hoddsep⟩ :=
      exists_odd_sep_free_pair_of_sparse (P := fun x : ℤ => qAffine (2 ^ t) A B x = 0)
        (Q := fun x : ℤ => qAffine (2 ^ t) a0 b0 x = 0) hP (le_trans hQ (by norm_num : (1 : ℕ) ≤ 2))
    -- hPx : ¬(α x = 0) = α x ≠ 0;  hQx : ¬(β x = 0) = β x ≠ 0
    exact line_affine_eq_of_free_pair ht hN a0 b0 A B hagree hxw hyw hoddsep
      ⟨hQx, hPx⟩ ⟨hQy, hPy⟩
  · -- a0 even: consume the packaged statistics
    rcases scal_line_stats_exists ht1 a0 b0 hred with ⟨S, hSa, hSb⟩
    by_cases hinf : S.orderInf
    · -- order −∞: bad coset empty, every row has β ≠ 0
      have hB0 : S.badCoset = ∅ := (S.horderInf).mp hinf
      have hQ : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter (fun x : ℤ => False)).card ≤ 2 := by
        rw [Finset.filter_false]
        norm_num
      obtain ⟨x, y, hxw, hyw, hPx, _hQx, hPy, _hQy, hoddsep⟩ :=
        exists_odd_sep_free_pair_of_sparse (P := fun x : ℤ => qAffine (2 ^ t) A B x = 0)
          (Q := fun x : ℤ => False) hP hQ
      have hβnx (w : ℤ) : qAffine (2 ^ t) a0 b0 w ≠ 0 := by
        intro hz
        have hmem : w ∈ badCoset (2 ^ t) a0 b0 := by simpa [badCoset] using hz
        have hmemS : w ∈ S.badCoset := by simpa [S.hbad, badCoset, ← hSa, ← hSb] using hmem
        rw [hB0] at hmemS
        exact hmemS
      exact line_affine_eq_of_free_pair ht hN a0 b0 A B hagree hxw hyw hoddsep
        ⟨hβnx x, hPx⟩ ⟨hβnx y, hPy⟩
    · -- finite order ord := S.ord < t; the bad coset is a coset of spacing 2^{t−ord}
      have hnotinf : ¬ S.orderInf := hinf
      have hord : S.ord < t := S.hord_lt hnotinf
      have hcos := S.hcoset hnotinf
      rcases hcos with hB0 | ⟨n0, hB0cos⟩
      · exfalso
        exact hnotinf ((S.horderInf).mpr hB0)
      · let s : ℕ := 2 ^ (t - S.ord)
        by_cases hord1 : t - S.ord = 1
        · -- spacing 2 (ord = t−1): B₀ = badCoset(a0,b0) is a full parity class; the
          -- hypotheses force α = qHalf at two distinct free rows of the opposite parity,
          -- contradicting the injectivity of the unit-slope affine α.
          exfalso
          have hB0cos2 : S.badCoset = {x : ℤ | (2 : ℤ) ∣ x - n0} := by
            simpa [hord1] using hB0cos
          rcases S.hfactor hnotinf with ⟨a', hfac, hodd'⟩
          rw [hSa] at hfac
          have hord_eq : S.ord = t - 1 := by omega
          have ha0q : (a0 : ZMod (2 ^ t)) = qHalf t := by
            rw [hfac, hord_eq]
            rw [Int.cast_mul]
            rw [Int.cast_natCast]
            exact qHalf_mul_odd ht1 a' hodd'
          have hq1 : 1 < 2 ^ t := two_pow_gt_one ht1
          have hqHalf_ne : qHalf t ≠ 0 := qHalf_ne_zero ht1
          by_cases hn0 : Even n0
          · -- B₀ = evens (n0 even): the free rows are the odd rows
            have hzmem : (2 : ℤ) ∈ S.badCoset := by
              rw [hB0cos2]
              rcases hn0 with ⟨k, hk⟩
              refine ⟨1 - k, ?_⟩
              rw [hk]
              ring
            have hβ2 : qAffine (2 ^ t) a0 b0 (2 : ℤ) = 0 := by
              have hq : qAffine (2 ^ t) S.a S.b (2 : ℤ) = 0 := by
                simpa [S.hbad] using hzmem
              simpa [← hSa, ← hSb] using hq
            have hb0 : (b0 : ZMod (2 ^ t)) = 0 := by
              have hz : qAffine (2 ^ t) a0 b0 (2 : ℤ) = 0 := hβ2
              unfold qAffine at hz
              rw [ha0q] at hz
              have hq2 : qHalf t * ((2 : ℤ) : ZMod (2 ^ t)) = 0 := by
                simpa using qHalf_mul_two ht1
              calc
                (b0 : ZMod (2 ^ t)) =
                    (qHalf t * ((2 : ℤ) : ZMod (2 ^ t)) + (b0 : ZMod (2 ^ t)))
                      - qHalf t * ((2 : ℤ) : ZMod (2 ^ t)) := by ring
                _ = -(qHalf t * ((2 : ℤ) : ZMod (2 ^ t))) := by rw [hz]; ring
                _ = 0 := by rw [hq2]; simp
            have hβodd (x : ℤ) (hxodd : Odd x) : qAffine (2 ^ t) a0 b0 x = qHalf t := by
              calc
                qAffine (2 ^ t) a0 b0 x =
                    (a0 : ZMod (2 ^ t)) * (x : ZMod (2 ^ t)) + (b0 : ZMod (2 ^ t)) := rfl
                _ = qHalf t * (x : ZMod (2 ^ t)) + 0 := by rw [ha0q, hb0]
                _ = qHalf t := by rw [qHalf_mul_odd ht1 x hxodd]; simp
            have hα_at_free (x : ℤ) (hxodd : Odd x) (hx1 : 1 ≤ x) (hx7 : x ≤ 7)
                (hαx : qAffine (2 ^ t) A B x ≠ 0) : qAffine (2 ^ t) A B x = qHalf t := by
              have hxnotbad : x ∉ badCoset (2 ^ t) a0 b0 := by
                intro hmem
                have hz : qAffine (2 ^ t) a0 b0 x = 0 := by simpa [badCoset] using hmem
                have hqx : qAffine (2 ^ t) a0 b0 x = qHalf t := hβodd x hxodd
                exact hqHalf_ne (by rw [hqx] at hz; exact hz)
              have hxN : x ≤ (N : ℤ) := by
                have h8N : (8 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN
                omega
              have hlin : qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) A B x :=
                hagree x hx1 hxN hαx
              have hlin' : qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) a0 b0 x :=
                qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq1 (a := a0) (b := b0) (n := x) hxnotbad
              calc
                qAffine (2 ^ t) A B x = qLine (2 ^ t) a0 b0 x := hlin.symm
                _ = qAffine (2 ^ t) a0 b0 x := hlin'
                _ = qHalf t := hβodd x hxodd
            obtain ⟨x, y, hxS, hyS, hxy, hαx, hαy⟩ := two_free_odd_rows ht A B hAunit
            have hxdis : x = 1 ∨ x = 3 ∨ x = 5 ∨ x = 7 := by simpa using hxS
            have hydis : y = 1 ∨ y = 3 ∨ y = 5 ∨ y = 7 := by simpa using hyS
            have hxodd : Odd x := by rcases hxdis with rfl | rfl | rfl | rfl <;> norm_num
            have hyodd : Odd y := by rcases hydis with rfl | rfl | rfl | rfl <;> norm_num
            have hx1 : 1 ≤ x := by rcases hxdis with rfl | rfl | rfl | rfl <;> norm_num
            have hy1 : 1 ≤ y := by rcases hydis with rfl | rfl | rfl | rfl <;> norm_num
            have hx7 : x ≤ 7 := by rcases hxdis with rfl | rfl | rfl | rfl <;> norm_num
            have hy7 : y ≤ 7 := by rcases hydis with rfl | rfl | rfl | rfl <;> norm_num
            have hxI : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
              rw [Finset.mem_Icc]; exact ⟨hx1, by omega⟩
            have hyI : y ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
              rw [Finset.mem_Icc]; exact ⟨hy1, by omega⟩
            have hvalx : qAffine (2 ^ t) A B x = qHalf t := hα_at_free x hxodd hx1 hx7 hαx
            have hvaly : qAffine (2 ^ t) A B y = qHalf t := hα_at_free y hyodd hy1 hy7 hαy
            exact unit_affine_injective_window ht A B hAunit hxy hxI hyI (by rw [hvalx, hvaly])
          · -- B₀ = odds (n0 odd): the free rows are the even rows (mirror)
            have hn0odd : Odd n0 := Int.not_even_iff_odd.mp hn0
            have hzmem : (1 : ℤ) ∈ S.badCoset := by
              rw [hB0cos2]
              rcases hn0odd with ⟨k, hk⟩
              refine ⟨-k, ?_⟩
              rw [hk]
              ring
            have hβ1 : qAffine (2 ^ t) a0 b0 (1 : ℤ) = 0 := by
              have hq : qAffine (2 ^ t) S.a S.b (1 : ℤ) = 0 := by
                simpa [S.hbad] using hzmem
              simpa [← hSa, ← hSb] using hq
            have hqHalf_sq : qHalf t + qHalf t = 0 := by
              calc
                qHalf t + qHalf t = (2 : ZMod (2 ^ t)) * qHalf t := by ring
                _ = qHalf t * (2 : ZMod (2 ^ t)) := by ring
                _ = 0 := qHalf_mul_two ht1
            have hb0 : (b0 : ZMod (2 ^ t)) = qHalf t := by
              have hz : qAffine (2 ^ t) a0 b0 (1 : ℤ) = 0 := hβ1
              unfold qAffine at hz
              rw [ha0q] at hz
              have hq1m : qHalf t * ((1 : ℤ) : ZMod (2 ^ t)) = qHalf t := by
                simpa using qHalf_mul_odd ht1 (1 : ℤ) (by norm_num : Odd (1 : ℤ))
              calc
                (b0 : ZMod (2 ^ t)) =
                    (qHalf t * ((1 : ℤ) : ZMod (2 ^ t)) + (b0 : ZMod (2 ^ t)))
                      - qHalf t * ((1 : ℤ) : ZMod (2 ^ t)) := by ring
                _ = -(qHalf t * ((1 : ℤ) : ZMod (2 ^ t))) := by rw [hz]; ring
                _ = -(qHalf t) := by rw [hq1m]
                _ = qHalf t := (eq_neg_iff_add_eq_zero.mpr hqHalf_sq).symm
            have hβeven (x : ℤ) (hxev : Even x) : qAffine (2 ^ t) a0 b0 x = qHalf t := by
              calc
                qAffine (2 ^ t) a0 b0 x =
                    (a0 : ZMod (2 ^ t)) * (x : ZMod (2 ^ t)) + (b0 : ZMod (2 ^ t)) := rfl
                _ = qHalf t * (x : ZMod (2 ^ t)) + qHalf t := by rw [ha0q, hb0]
                _ = qHalf t := by
                  rcases hxev with ⟨k, hk⟩
                  rw [hk]
                  rw [Int.cast_add]
                  rw [show (k : ZMod (2 ^ t)) + (k : ZMod (2 ^ t)) =
                      (2 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) by ring]
                  rw [← mul_assoc, qHalf_mul_two ht1]
                  simp
            have hα_at_free (x : ℤ) (hxev : Even x) (hx1 : 1 ≤ x) (hx7 : x ≤ 7)
                (hαx : qAffine (2 ^ t) A B x ≠ 0) : qAffine (2 ^ t) A B x = qHalf t := by
              have hxnotbad : x ∉ badCoset (2 ^ t) a0 b0 := by
                intro hmem
                have hz : qAffine (2 ^ t) a0 b0 x = 0 := by simpa [badCoset] using hmem
                have hqx : qAffine (2 ^ t) a0 b0 x = qHalf t := hβeven x hxev
                exact hqHalf_ne (by rw [hqx] at hz; exact hz)
              have hxN : x ≤ (N : ℤ) := by
                have h8N : (8 : ℤ) ≤ (N : ℤ) := by exact_mod_cast hN
                omega
              have hlin : qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) A B x :=
                hagree x hx1 hxN hαx
              have hlin' : qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) a0 b0 x :=
                qLine_eq_qAffine_of_not_mem_badCoset (q := 2 ^ t) hq1 (a := a0) (b := b0) (n := x) hxnotbad
              calc
                qAffine (2 ^ t) A B x = qLine (2 ^ t) a0 b0 x := hlin.symm
                _ = qAffine (2 ^ t) a0 b0 x := hlin'
                _ = qHalf t := hβeven x hxev
            obtain ⟨x, y, hxS, hyS, hxy, hαx, hαy⟩ := two_free_even_rows ht A B hAunit
            have hxdis : x = 2 ∨ x = 4 ∨ x = 6 := by simpa using hxS
            have hydis : y = 2 ∨ y = 4 ∨ y = 6 := by simpa using hyS
            have hxev : Even x := by rcases hxdis with rfl | rfl | rfl <;> norm_num
            have hyev : Even y := by rcases hydis with rfl | rfl | rfl <;> norm_num
            have hx1 : 1 ≤ x := by rcases hxdis with rfl | rfl | rfl <;> norm_num
            have hy1 : 1 ≤ y := by rcases hydis with rfl | rfl | rfl <;> norm_num
            have hx7 : x ≤ 7 := by rcases hxdis with rfl | rfl | rfl <;> norm_num
            have hy7 : y ≤ 7 := by rcases hydis with rfl | rfl | rfl <;> norm_num
            have hxI : x ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
              rw [Finset.mem_Icc]; exact ⟨hx1, by omega⟩
            have hyI : y ∈ Finset.Icc (1 : ℤ) (8 : ℤ) := by
              rw [Finset.mem_Icc]; exact ⟨hy1, by omega⟩
            have hvalx : qAffine (2 ^ t) A B x = qHalf t := hα_at_free x hxev hx1 hx7 hαx
            have hvaly : qAffine (2 ^ t) A B y = qHalf t := hα_at_free y hyev hy1 hy7 hαy
            exact unit_affine_injective_window ht A B hAunit hxy hxI hyI (by rw [hvalx, hvaly])
        · -- spacing ≥ 4: at most 2 points of the bad coset in the window
          have hst : 2 ≤ t - S.ord := by omega
          have hs4 : 4 ≤ s := by
            dsimp [s]
            have h2 : 4 ≤ 2 ^ 2 := by norm_num
            exact le_trans h2 (pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) hst)
          have hQ : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter
              (fun x : ℤ => (((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n0))).card ≤ 2 := by
            have hle := Commons.Data.Int.Window.coset_eight_window_card_le
              (D := 2 ^ (t - S.ord)) (by exact pow_pos (by norm_num : 0 < 2) (t - S.ord)) n0 (1 : ℤ)
            have hle' : ((Finset.Icc (1 : ℤ) (8 : ℤ)).filter
                (fun x : ℤ => (((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n0))).card ≤
                (7 : ℕ) / (2 ^ (t - S.ord)) + 1 := by
              simpa using hle
            have hs0 : 0 < 2 ^ (t - S.ord) := pow_pos (by norm_num : 0 < 2) (t - S.ord)
            have hlt2 : 7 < 2 * (2 ^ (t - S.ord)) := by
              dsimp [s] at hs4
              have h82 : 8 ≤ (2 ^ (t - S.ord)) * 2 := by omega
              omega
            have hdivlt : 7 / (2 ^ (t - S.ord)) < 2 :=
              (Nat.div_lt_iff_lt_mul hs0).mpr hlt2
            have hdiv : (7 : ℕ) / (2 ^ (t - S.ord)) ≤ 1 := by omega
            omega
          obtain ⟨x, y, hxw, hyw, hPx, hQx, hPy, hQy, hoddsep⟩ :=
            exists_odd_sep_free_pair_of_sparse
              (P := fun x : ℤ => qAffine (2 ^ t) A B x = 0)
              (Q := fun x : ℤ => (((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n0)) hP hQ
          have hβnx (w : ℤ) (hw : ¬ (((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ w - n0)) :
              qAffine (2 ^ t) a0 b0 w ≠ 0 := by
            intro hz
            have hmem : w ∈ badCoset (2 ^ t) a0 b0 := by simpa [badCoset] using hz
            have hmemS : w ∈ S.badCoset := by simpa [S.hbad, badCoset, ← hSa, ← hSb] using hmem
            have hwS : w ∈ {x : ℤ | (((2 ^ (t - S.ord) : ℕ) : ℤ) ∣ x - n0)} := by
              simpa [hB0cos] using hmemS
            exact hw hwS
          exact line_affine_eq_of_free_pair ht hN a0 b0 A B hagree hxw hyw hoddsep
            ⟨hβnx x hQx, hPx⟩ ⟨hβnx y hQy, hPy⟩




/-- (T3b-2 instantiation) On a normal-form board the slope-`1` diagonal line through `i`
has a reduced `qLine` representation whose associated affine is exactly the lifted diagonal
affine: `qAffine a0 b0 = qAffine (diagA Dp i) (diagB Dp i)` on all of `ℤ`. -/
theorem diag_line_reduced_coeffs {t N : ℕ} (ht : 3 ≤ t) (hN : 8 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t)) (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) (i : ℤ) :
    ∃ a0 b0 : ℤ,
      ¬ (((2 ^ t : ℕ) : ℤ) ∣ a0 ∧ ((2 ^ t : ℕ) : ℤ) ∣ b0) ∧
      (∀ r : Fin N, lineRestrict F i 1 r = qLine (2 ^ t) a0 b0 (finToInt r)) ∧
      (∀ z : ℤ, qAffine (2 ^ t) a0 b0 z = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) z) := by
  classical
  have ht1 : 1 ≤ t := by omega
  obtain ⟨a0, b0, hred, heq, hro, _hΓ⟩ := diag_line_reduced_rigid_out (t := t) (N := N) ht hN F hF Dp hNF i
  have hAodd : Odd (diagA Dp i) := by
    dsimp [diagA]
    have hz : Odd (diagAZ Dp i).val := by
      dsimp [diagAZ]
      exact diag_a_odd ht1 ht Dp (i : ZMod (2 ^ t))
    exact odd_intCast hz
  have hagree : ∀ x : ℤ, 1 ≤ x → x ≤ (N : ℤ) →
      qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) x ≠ 0 →
      qLine (2 ^ t) a0 b0 x = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) x := by
    intro x hx1 hxN hαx
    have hxmem : x ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
      rw [Finset.mem_Icc]
      exact ⟨hx1, hxN⟩
    let m : Fin N := intToFin ⟨x, hxmem⟩
    have hm : finToInt m = x := finToInt_intToFin ⟨x, hxmem⟩
    have hαm : qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) (finToInt m) ≠ 0 := by
      simpa [hm] using hαx
    have hg := hro m hαm
    simpa [hm] using hg
  refine ⟨a0, b0, hred, heq, ?_⟩
  exact reduced_line_affine_eq_of_agree ht hN a0 b0 (diagA Dp i) (diagB Dp i) hred hAodd hagree



/-- (eqs) For the post-Tetris board `F*(r,m) := F r (q·m)` of a normal-form board `F` of
width `N ≥ q²`, take `n₀ ∈ {1..q}`, `m₀ ∈ ℤ`, and let `i := q·m₀ − n₀` be the intercept of
the diagonal through the post-Tetris cells `(n₀ + qj, m₀ + j)`.  The reduced coefficients
`(a0,b0)` of that diagonal (`diag_line_reduced_coeffs`) and the quotient
`c0 := (a0·n0 + b0)/q` (T4) satisfy `F r (q·(m0+j)) = f_q(c0 + a0·j)` for every `j < q`
(where `r` is the row with `rowVal r = n0 + q·j`). -/
theorem tetris_eqs {t N : ℕ} (ht : 3 ≤ t) (hNq : (2 ^ t) * (2 ^ t) ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (n0 : ℤ) (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ))
    (i m0 : ℤ) (hi : i = ((2 ^ t : ℕ) : ℤ) * m0 - n0) :
    ∃ a0 b0 c0 : ℤ,
      ¬ (((2 ^ t : ℕ) : ℤ) ∣ a0 ∧ ((2 ^ t : ℕ) : ℤ) ∣ b0) ∧
      (∀ z : ℤ, qAffine (2 ^ t) a0 b0 z = qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) z) ∧
      (a0 * n0 + b0 = ((2 ^ t : ℕ) : ℤ) * c0) ∧
      (∀ j : ℕ, j < 2 ^ t → ∀ r : Fin N,
        rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
          F r (((2 ^ t : ℕ) : ℤ) * (m0 + (j : ℤ))) = fq (2 ^ t) (c0 + a0 * (j : ℤ))) := by
  classical
  have ht1 : 1 ≤ t := by omega
  have hqpos : 0 < (2 ^ t : ℕ) := pow_pos (by norm_num : 0 < 2) t
  have hN8 : 8 ≤ N := by
    calc
      8 ≤ 2 ^ t := two_pow_ge_eight ht
      _ ≤ (2 ^ t) * (2 ^ t) := by
        have hge1 : 1 ≤ 2 ^ t := by omega
        simpa using (Nat.mul_le_mul_left (2 ^ t) hge1)
      _ ≤ N := hNq
  obtain ⟨a0, b0, hred, heq, hzagree⟩ :=
    diag_line_reduced_coeffs (t := t) (N := N) ht hN8 F hF Dp hNF i
  -- T4: q ∣ a0·n0 + b0
  have hni : (((2 ^ t : ℕ) : ℤ) ∣ n0 + i) := by
    rw [hi]
    use m0
    ring
  have hzmod : (n0 : ZMod (2 ^ t)) = - (i : ZMod (2 ^ t)) :=
    (int_dvd_add_iff_zmod_eq_neg t n0 i).mp hni
  have haZodd : Odd (diagAZ Dp i).val := by
    dsimp [diagAZ]
    exact diag_a_odd ht1 ht Dp (i : ZMod (2 ^ t))
  have haU : IsUnit (diagAZ Dp i) := zmod_isUnit_of_odd_val ht1 (diagAZ Dp i) haZodd
  have hα0 : qAffine (2 ^ t) (diagA Dp i) (diagB Dp i) n0 = 0 :=
    (qAffine_diag_zero_iff (A := diagA Dp i) (B := diagB Dp i) (Dp := Dp)
      (i := (i : ZMod (2 ^ t))) (diagA_cast (Dp := Dp) (i := i))
      (diagB_cast (Dp := Dp) (i := i)) haU n0).mpr hzmod
  have hβ0 : qAffine (2 ^ t) a0 b0 n0 = 0 := by
    rw [hzagree n0]
    exact hα0
  have hdvd : (((2 ^ t : ℕ) : ℤ) ∣ a0 * n0 + b0) :=
    (qAffine_zero_iff_int_dvd (q := 2 ^ t) a0 b0 n0).mp hβ0
  rcases hdvd with ⟨c0, hc0⟩
  refine ⟨a0, b0, c0, hred, hzagree, hc0, ?_⟩
  intro j hj r hr
  have hfin : finToInt r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) := by
    simpa [rowVal_eq_finToInt] using hr
  have hline : F r (finToInt r + i) = qLine (2 ^ t) a0 b0 (finToInt r) := by
    have hrw : finToInt r + i = (1 : ℤ) * finToInt r + i := by ring
    rw [hrw]
    exact heq r
  have harg : finToInt r + i = ((2 ^ t : ℕ) : ℤ) * (m0 + (j : ℤ)) := by
    rw [hfin, hi]
    ring
  calc
    F r (((2 ^ t : ℕ) : ℤ) * (m0 + (j : ℤ))) = F r (finToInt r + i) := by
      rw [← harg]
    _ = qLine (2 ^ t) a0 b0 (finToInt r) := hline
    _ = fq (2 ^ t) (a0 * (finToInt r) + b0) := rfl
    _ = fq (2 ^ t) (a0 * (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) + b0) := by rw [hfin]
    _ = fq (2 ^ t) (((2 ^ t : ℕ) : ℤ) * c0 + ((2 ^ t : ℕ) : ℤ) * (a0 * (j : ℤ))) := by
      congr 1
      rw [show a0 * (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) + b0 =
          (a0 * n0 + b0) + a0 * (((2 ^ t : ℕ) : ℤ) * (j : ℤ)) by ring]
      rw [hc0]
      ring
    _ = fq (2 ^ t) (((2 ^ t : ℕ) : ℤ) * (c0 + a0 * (j : ℤ))) := by
      congr 1
      ring
    _ = fq (2 ^ t) (c0 + a0 * (j : ℤ)) := fq_qmul_int
        (pow_ne_zero t (by norm_num : (2 : ℕ) ≠ 0)) (c0 + a0 * (j : ℤ))


/-- T6-injectivity: with `a0` a unit mod `q`, the residues `(c0 + a0·j) mod q` are
pairwise distinct for `j = 0, …, q−1`. -/
lemma diag_affine_residue_injective {t : ℕ} (a0 c0 : ℤ) (ha0u : IsUnit (a0 : ZMod (2 ^ t)))
    {j₁ j₂ : ℕ} (hj₁ : j₁ < 2 ^ t) (hj₂ : j₂ < 2 ^ t)
    (h : (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) =
         (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t))) :
    j₁ = j₂ := by
  classical
  have hmul : (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) =
      (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t)) := add_left_cancel h
  have hsub : (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) -
      (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t)) = 0 := sub_eq_zero.mpr hmul
  have hdiff : (a0 : ZMod (2 ^ t)) * ((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t))) = 0 := by
    calc
      (a0 : ZMod (2 ^ t)) * ((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t))) =
          (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) -
            (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t)) := by
            rw [mul_sub]
      _ = 0 := hsub
  rcases ha0u with ⟨u, hu⟩
  have hu0 : (u : ZMod (2 ^ t)) * (((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t)))) = 0 := by
    simpa [hu] using hdiff
  have hz : ((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t))) = 0 := by
    calc
      ((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t))) =
          (↑(u⁻¹ : (ZMod (2 ^ t))ˣ) : ZMod (2 ^ t)) *
            ((u : ZMod (2 ^ t)) * (((j₁ : ZMod (2 ^ t)) - (j₂ : ZMod (2 ^ t))))) := by
              rw [← mul_assoc, u.inv_mul]
              simp
      _ = 0 := by rw [hu0]; simp
  have hcast : (j₁ : ZMod (2 ^ t)) = (j₂ : ZMod (2 ^ t)) := sub_eq_zero.mp hz
  have hv := congrArg ZMod.val hcast
  rw [ZMod.val_natCast, ZMod.val_natCast] at hv
  have h1 : j₁ % 2 ^ t = j₁ := Nat.mod_eq_of_lt hj₁
  have h2 : j₂ % 2 ^ t = j₂ := Nat.mod_eq_of_lt hj₂
  rw [h1, h2] at hv
  exact hv

/-- T6: along `j = 0, …, q−1` the sequence `f_q(c0 + a0·j)` (with `a0` a unit mod `q`)
attains each digit at most twice. -/
lemma fq_digit_at_most_twice {t : ℕ} (ht : 3 ≤ t) (a0 c0 : ℤ)
    (ha0u : IsUnit (a0 : ZMod (2 ^ t))) (γ : ZMod (2 ^ t)) :
    ((Finset.range (2 ^ t)).filter
      (fun j : ℕ => fq (2 ^ t) (c0 + a0 * (j : ℤ)) = γ)).card ≤ 2 := by
  classical
  have ht1 : 1 ≤ t := by omega
  have hq1 : 1 < 2 ^ t := two_pow_gt_one ht1
  let qZ : ℤ := ((2 ^ t : ℕ) : ℤ)
  let G : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j : ℕ => ¬ (qZ ∣ c0 + a0 * (j : ℤ)) ∧ fq (2 ^ t) (c0 + a0 * (j : ℤ)) = γ)
  let B : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j : ℕ => qZ ∣ c0 + a0 * (j : ℤ))
  let S : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j : ℕ => fq (2 ^ t) (c0 + a0 * (j : ℤ)) = γ)
  have hG : G.card ≤ 1 := by
    dsimp [G]
    rw [Finset.card_le_one]
    intro j₁ hj₁ j₂ hj₂
    rw [Finset.mem_filter] at hj₁ hj₂
    have hj₁lt : j₁ < 2 ^ t := (Finset.mem_range).mp hj₁.1
    have hj₂lt : j₂ < 2 ^ t := (Finset.mem_range).mp hj₂.1
    have hd1 : (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) = γ := by
      have hw : ((c0 + a0 * (j₁ : ℤ) : ℤ) : ZMod (2 ^ t)) = γ := by
        calc
          ((c0 + a0 * (j₁ : ℤ) : ℤ) : ZMod (2 ^ t)) = fq (2 ^ t) (c0 + a0 * (j₁ : ℤ)) :=
            (fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 (by simpa [qZ] using hj₁.2.1)).symm
          _ = γ := hj₁.2.2
      simpa [Int.cast_add, Int.cast_mul] using hw
    have hd2 : (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t)) = γ := by
      have hw : ((c0 + a0 * (j₂ : ℤ) : ℤ) : ZMod (2 ^ t)) = γ := by
        calc
          ((c0 + a0 * (j₂ : ℤ) : ℤ) : ZMod (2 ^ t)) = fq (2 ^ t) (c0 + a0 * (j₂ : ℤ)) :=
            (fq_eq_self_of_not_dvd_int (q := 2 ^ t) hq1 (by simpa [qZ] using hj₂.2.1)).symm
          _ = γ := hj₂.2.2
      simpa [Int.cast_add, Int.cast_mul] using hw
    exact diag_affine_residue_injective a0 c0 ha0u hj₁lt hj₂lt (hd1.trans hd2.symm)
  have hB : B.card ≤ 1 := by
    dsimp [B]
    rw [Finset.card_le_one]
    intro j₁ hj₁ j₂ hj₂
    rw [Finset.mem_filter] at hj₁ hj₂
    have hj₁lt : j₁ < 2 ^ t := (Finset.mem_range).mp hj₁.1
    have hj₂lt : j₂ < 2 ^ t := (Finset.mem_range).mp hj₂.1
    have hz1 : (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₁ : ZMod (2 ^ t)) = 0 := by
      have hw := (ZMod.intCast_zmod_eq_zero_iff_dvd (c0 + a0 * (j₁ : ℤ)) (2 ^ t)).mpr (by simpa [qZ] using hj₁.2)
      simpa [Int.cast_add, Int.cast_mul] using hw
    have hz2 : (c0 : ZMod (2 ^ t)) + (a0 : ZMod (2 ^ t)) * (j₂ : ZMod (2 ^ t)) = 0 := by
      have hw := (ZMod.intCast_zmod_eq_zero_iff_dvd (c0 + a0 * (j₂ : ℤ)) (2 ^ t)).mpr (by simpa [qZ] using hj₂.2)
      simpa [Int.cast_add, Int.cast_mul] using hw
    exact diag_affine_residue_injective a0 c0 ha0u hj₁lt hj₂lt (hz1.trans hz2.symm)
  have hsub : S ⊆ G ∪ B := by
    intro j hj
    rw [Finset.mem_filter] at hj
    rw [Finset.mem_union]
    by_cases hbad : qZ ∣ c0 + a0 * (j : ℤ)
    · right
      rw [Finset.mem_filter]
      exact ⟨hj.1, hbad⟩
    · left
      rw [Finset.mem_filter]
      exact ⟨hj.1, ⟨hbad, hj.2⟩⟩
  calc
    S.card ≤ (G ∪ B).card := Finset.card_le_card hsub
    _ ≤ G.card + B.card := Finset.card_union_le _ _
    _ ≤ 2 := by omega


/-- The (eqs) identity with the unit coefficient isolated: for each post-Tetris diagonal
through `(n0,m0)` (intercept `i = q·m0 − n0`) there are `a0 c0 : ℤ` with `a0` a unit mod
`q` such that on the `q` rows `n0 + q·j` the post-Tetris value is `f_q(c0 + a0·j)`. -/
lemma tetris_eqs_unit {t N : ℕ} (ht : 3 ≤ t) (hNq : (2 ^ t) * (2 ^ t) ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (n0 : ℤ) (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ))
    (i m0 : ℤ) (hi : i = ((2 ^ t : ℕ) : ℤ) * m0 - n0) :
    ∃ a0 c0 : ℤ,
      IsUnit (a0 : ZMod (2 ^ t)) ∧
      (∀ j : ℕ, j < 2 ^ t → ∀ r : Fin N,
        rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
          F r (((2 ^ t : ℕ) : ℤ) * (m0 + (j : ℤ))) = fq (2 ^ t) (c0 + a0 * (j : ℤ))) := by
  classical
  have ht1 : 1 ≤ t := by omega
  rcases tetris_eqs (t := t) (N := N) ht hNq F hF Dp hNF n0 hn0 hn0q i m0 hi with
    ⟨a0, b0, c0, _hred, hzagree, _hc0, hval⟩
  have h0 := hzagree 0
  have h1 := hzagree 1
  simp [qAffine] at h0
  simp [qAffine] at h1
  have h1' : (a0 : ZMod (2 ^ t)) + ((diagB Dp i : ℤ) : ZMod (2 ^ t)) =
      ((diagA Dp i : ℤ) : ZMod (2 ^ t)) + ((diagB Dp i : ℤ) : ZMod (2 ^ t)) := by
    simpa [h0] using h1
  have ha0eq : (a0 : ZMod (2 ^ t)) = (diagA Dp i : ZMod (2 ^ t)) := add_right_cancel h1'
  have ha0u : IsUnit (a0 : ZMod (2 ^ t)) := by
    rw [ha0eq]
    change IsUnit (diagA Dp i : ZMod (2 ^ t))
    rw [diagA_cast]
    exact zmod_isUnit_of_odd_val ht1 (diagAZ Dp i)
      (by dsimp [diagAZ]; exact diag_a_odd ht1 ht Dp (i : ZMod (2 ^ t)))
  exact ⟨a0, c0, ha0u, hval⟩


/-- F*-digit bound along the (q,1)-diagonal D_i through (n0,m0) (intercept
`i = q·m0 − n0`): among the `q` post-Tetris cells `(row n0+q·j, m0+j)` (`j < q`) each
digit `γ` is attained at most twice.  The counted predicate is the row-choice-free form
`P j := ∀ r, rowVal r = n0+q·j → F r (q·(m0+j)) = γ`. -/
lemma tetris_diag_digit_bound {t N : ℕ} (ht : 3 ≤ t) (hNq : (2 ^ t) * (2 ^ t) ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (n0 m0 : ℤ) (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ))
    (i : ℤ) (hi : i = ((2 ^ t : ℕ) : ℤ) * m0 - n0)
    (γ : ZMod (2 ^ t)) :
    ((Finset.range (2 ^ t)).filter (fun j : ℕ =>
      ∀ r : Fin N, rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) →
        F r (((2 ^ t : ℕ) : ℤ) * (m0 + (j : ℤ))) = γ)).card ≤ 2 := by
  classical
  rcases tetris_eqs_unit (t := t) (N := N) ht hNq F hF Dp hNF n0 hn0 hn0q i m0 hi with
    ⟨a0, c0, ha0u, hval⟩
  let qZ : ℤ := ((2 ^ t : ℕ) : ℤ)
  have hq0 : 0 ≤ qZ := by dsimp [qZ]; exact_mod_cast (Nat.zero_le (2 ^ t))
  -- rows n0+q·j with j < q lie in {1..N}
  have hrow (j : ℕ) (hj : j < 2 ^ t) :
      n0 + qZ * (j : ℤ) ∈ Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ) := by
    rw [Finset.mem_Icc]
    constructor
    · have hj0 : 0 ≤ (j : ℤ) := by omega
      have hqjmul : 0 ≤ qZ * (j : ℤ) := mul_nonneg hq0 hj0
      omega
    · have hj' : (j : ℤ) ≤ qZ - 1 := by
        have hjlt : (j : ℤ) < qZ := by
          dsimp [qZ]
          exact_mod_cast hj
        dsimp [qZ] at hjlt
        omega
      have hmul : qZ * (j : ℤ) ≤ qZ * (qZ - 1) := mul_le_mul_of_nonneg_left hj' hq0
      have hb : qZ * (qZ - 1) ≤ qZ * qZ := by
        have hle : qZ - 1 ≤ qZ := by omega
        exact mul_le_mul_of_nonneg_left hle hq0
      have hsq : qZ * qZ ≤ (N : ℤ) := by
        have hc : qZ * qZ = (((2 ^ t * 2 ^ t : ℕ) : ℤ)) := by
          dsimp [qZ]
        rw [hc]
        exact_mod_cast hNq
      calc
        n0 + qZ * (j : ℤ) ≤ n0 + qZ * (qZ - 1) := by omega
        _ ≤ qZ + qZ * (qZ - 1) := by omega
        _ = qZ * qZ := by ring
        _ ≤ (N : ℤ) := hsq
  -- P j ↔ fq (c0 + a0·j) = γ for j < q
  have hiff (j : ℕ) (hj : j < 2 ^ t) :
      (∀ r : Fin N, rowVal r = n0 + qZ * (j : ℤ) →
        F r (qZ * (m0 + (j : ℤ))) = γ) ↔ fq (2 ^ t) (c0 + a0 * (j : ℤ)) = γ := by
    constructor
    · intro hP
      rcases exists_row_rowVal (N := N) (n0 + qZ * (j : ℤ)) (by
        rcases (Finset.mem_Icc.mp (hrow j hj)) with ⟨h1, h2⟩; exact h1) (by
        rcases (Finset.mem_Icc.mp (hrow j hj)) with ⟨h1, h2⟩; exact h2) with ⟨r0, hr0⟩
      have hv := hval j hj r0 (by simpa [qZ] using hr0)
      have hg := hP r0 hr0
      calc
        fq (2 ^ t) (c0 + a0 * (j : ℤ)) = F r0 (qZ * (m0 + (j : ℤ))) := by
          dsimp [qZ] at hv
          exact hv.symm
        _ = γ := by simpa [qZ] using hg
    · intro hfq r hr
      have hv := hval j hj r (by simpa [qZ] using hr)
      calc
        F r (qZ * (m0 + (j : ℤ))) = fq (2 ^ t) (c0 + a0 * (j : ℤ)) := by
          dsimp [qZ] at hv
          exact hv
        _ = γ := by simpa [qZ] using hfq
  -- count P = count (fq = γ)
  let S : Finset ℕ := (Finset.range (2 ^ t)).filter (fun j : ℕ =>
    ∀ r : Fin N, rowVal r = n0 + qZ * (j : ℤ) →
      F r (qZ * (m0 + (j : ℤ))) = γ)
  let T : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j : ℕ => fq (2 ^ t) (c0 + a0 * (j : ℤ)) = γ)
  have hST : S ⊆ T := by
    intro j hj
    rw [Finset.mem_filter] at hj ⊢
    exact ⟨hj.1, (hiff j ((Finset.mem_range).mp hj.1)).mp hj.2⟩
  have hTS : T ⊆ S := by
    intro j hj
    rw [Finset.mem_filter] at hj ⊢
    exact ⟨hj.1, (hiff j ((Finset.mem_range).mp hj.1)).mpr hj.2⟩
  have hT : T.card ≤ 2 := fq_digit_at_most_twice ht a0 c0 ha0u γ
  have hEq : S = T := le_antisymm hST hTS
  change S.card ≤ 2
  rw [hEq]
  exact hT


/-- Two diagonal parametrisations give the same post-Tetris cell only if they coincide:
if `n0 + q·j = n0' + q·j'` (rows in `{1..q}`, `j,j' < q`) and `m0 + j = m0' + j'`, then
`n0 = n0'`, `j = j'` and `m0 = m0'`.  This is the disjointness of the diagonal families
`D(n0,m0)`. -/
lemma tetris_diag_cell_unique {t : ℕ} (ht : 3 ≤ t)
    (n0 m0 n0' m0' : ℤ) (j j' : ℕ)
    (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ))
    (hn0' : 1 ≤ n0') (hn0'q : n0' ≤ ((2 ^ t : ℕ) : ℤ))
    (hj : j < 2 ^ t) (hj' : j' < 2 ^ t)
    (hx : n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) = n0' + ((2 ^ t : ℕ) : ℤ) * (j' : ℤ))
    (hm : m0 + (j : ℤ) = m0' + (j' : ℤ)) :
    n0 = n0' ∧ j = j' ∧ m0 = m0' := by
  classical
  have ht1 : 1 ≤ t := by omega
  let qZ : ℤ := ((2 ^ t : ℕ) : ℤ)
  have hq0 : 0 ≤ qZ := by dsimp [qZ]; exact_mod_cast (Nat.zero_le (2 ^ t))
  have hq8 : 8 ≤ qZ := by dsimp [qZ]; exact_mod_cast two_pow_ge_eight ht
  -- q | n0 − n0'
  have hsub : n0 - n0' = qZ * ((j' : ℤ) - (j : ℤ)) := by
    have hh : n0 + qZ * (j : ℤ) - (n0' + qZ * (j' : ℤ)) = 0 := by
      dsimp [qZ] at hx ⊢
      rw [hx]
      ring
    calc
      n0 - n0' = n0 + qZ * (j : ℤ) - (n0' + qZ * (j' : ℤ)) + qZ * ((j' : ℤ) - (j : ℤ)) := by ring
      _ = qZ * ((j' : ℤ) - (j : ℤ)) := by rw [hh]; ring
  have hdvd : qZ ∣ n0 - n0' := ⟨(j' : ℤ) - (j : ℤ), hsub⟩
  rcases hdvd with ⟨k, hk⟩
  have hhi : n0 - n0' ≤ qZ - 1 := by omega
  have hlo : -(qZ - 1) ≤ n0 - n0' := by omega
  have hk0 : k = 0 := by
    by_contra hkn
    have hkpos : 1 ≤ k ∨ k ≤ -1 := by omega
    rcases hkpos with hk1 | hkm1
    · have hge : qZ ≤ qZ * k := by
        have hk1' : (1 : ℤ) ≤ k := hk1
        simpa [mul_comm] using (le_mul_of_one_le_left hq0 hk1')
      have hbig : qZ ≤ n0 - n0' := by rw [hk]; exact hge
      omega
    · have hle : qZ * k ≤ -qZ := by
        have hk' : k ≤ -1 := hkm1
        have hmul : qZ * k ≤ qZ * (-1) := mul_le_mul_of_nonneg_left hk' hq0
        simpa using hmul
      have hsmall : n0 - n0' ≤ -qZ := by rw [hk]; exact hle
      have hlt : n0 - n0' < -(qZ - 1) := by omega
      omega
  have hn0eq : n0 = n0' := by
    have : n0 - n0' = 0 := by rw [hk, hk0]; simp
    omega
  have hjeqZ : (j : ℤ) = (j' : ℤ) := by
    -- cancel qZ in hx (after substituting n0' = n0)
    have hx' : ((2 ^ t : ℕ) : ℤ) * (j : ℤ) = ((2 ^ t : ℕ) : ℤ) * (j' : ℤ) := by
      have hh : n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) = n0 + ((2 ^ t : ℕ) : ℤ) * (j' : ℤ) := by
        rw [← hn0eq] at hx
        exact hx
      exact add_left_cancel hh
    have hqc : ((2 ^ t : ℕ) : ℤ) ≠ 0 := by exact_mod_cast (pow_ne_zero t (by norm_num : (2 : ℕ) ≠ 0))
    exact mul_left_cancel₀ hqc hx'
  have hjeq : j = j' := by exact_mod_cast hjeqZ
  have hmeq : m0 = m0' := by
    -- from hm: m0 + j = m0' + j': with j = j': cancel
    have hm' : m0 + (j : ℤ) = m0' + (j : ℤ) := by simpa [hjeq] using hm
    exact add_right_cancel hm'
  exact ⟨hn0eq, hjeq, hmeq⟩


/-- Partition EXISTENCE: every post-Tetris cell (row-position `x ∈ {1..q²}`, column `m`)
lies on a diagonal `D(n0,m0)` (`x = n0 + q·j`, `m = m0 + j`, `n0 ∈ {1..q}`, `j < q`).  With
`tetris_diag_cell_unique` this gives the partition of the cells by the diagonals. -/
lemma tetris_diag_cell_exists {t : ℕ} (ht : 1 ≤ t) (x m : ℤ) (hx1 : 1 ≤ x)
    (hx2 : x ≤ ((2 ^ t * 2 ^ t : ℕ) : ℤ)) :
    ∃ n0 m0' : ℤ, ∃ j : ℕ,
      1 ≤ n0 ∧ n0 ≤ ((2 ^ t : ℕ) : ℤ) ∧ j < 2 ^ t ∧
      x = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) ∧ m = m0' + (j : ℤ) := by
  classical
  have hq : 1 ≤ 2 ^ t := by
    have hp : 0 < 2 ^ t := pow_pos (by norm_num : 0 < 2) t
    omega
  have hxnonneg : 0 ≤ x := by omega
  let xn : ℕ := x.toNat
  have hxcast : (xn : ℤ) = x := by dsimp [xn]; exact Int.toNat_of_nonneg hxnonneg
  have hxn1 : 1 ≤ xn := by
    have hz : 1 ≤ (xn : ℤ) := by rw [hxcast]; exact hx1
    exact_mod_cast hz
  have hxn2 : xn ≤ 2 ^ t * 2 ^ t := by
    have hz : (xn : ℤ) ≤ ((2 ^ t * 2 ^ t : ℕ) : ℤ) := by
      rw [hxcast]
      exact hx2
    exact_mod_cast hz
  rcases Commons.Data.Nat.unique_decomp_square (2 ^ t) hq xn hxn1 hxn2 with ⟨p, hPp, _huniq⟩
  have hn0prop : 1 ≤ p.1.1 ∧ p.1.1 ≤ 2 ^ t := p.1.2
  have hjprop : p.2.1 < 2 ^ t := p.2.2
  have hdecomp : xn = p.1.1 + 2 ^ t * p.2.1 := hPp
  refine ⟨(p.1.1 : ℤ), m - (p.2.1 : ℤ), p.2.1, (by exact_mod_cast hn0prop.1), ?_, hjprop, ?_, ?_⟩
  · exact_mod_cast hn0prop.2
  · -- x = n0 + q·j
    calc
      x = (xn : ℤ) := hxcast.symm
      _ = ((p.1.1 + 2 ^ t * p.2.1 : ℕ) : ℤ) := by rw [hdecomp]
      _ = (p.1.1 : ℤ) + ((2 ^ t * p.2.1 : ℕ) : ℤ) := by rw [Nat.cast_add]
      _ = (p.1.1 : ℤ) + ((2 ^ t : ℕ) : ℤ) * (p.2.1 : ℤ) := by rw [Nat.cast_mul]
  · ring

/-! ## Window count for the post-Tetris board (finite weak digit equidistribution)

`tetris_diag_digit_bound` bounds each diagonal `D(n0,m0)`; the diagonals with
`n0 ∈ {1..q}`, `m0 ∈ [-M-q+1, M]` partition the column window
`{row positions 1..q²} × {columns -M..M}` (every window cell `(x,c)` decomposes as
`x = n0+qj`, `c = m0+j` with `m0 = c-j ∈ [-M-q+1, M]`), so each digit `γ` is attained
on at most `q · (2M+q) · 2` window cells.  This is F*'s finite weak digit
equidistribution: F*'s value at `(row r, column c)` is `F r (q·c)`. -/
lemma tetris_window_digit_count {t N : ℕ} (ht : 3 ≤ t) (hNq : (2 ^ t) * (2 ^ t) ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (M : ℕ) (γ : ZMod (2 ^ t)) :
    (((Finset.Icc (1 : ℤ) ((((2 ^ t : ℕ) : ℤ) * ((2 ^ t : ℕ) : ℤ)))).product
        (Finset.Icc (-(M : ℤ)) (M : ℤ))).filter
      (fun xc : ℤ × ℤ =>
        ∀ r : Fin N, rowVal r = xc.1 → F r (((2 ^ t : ℕ) : ℤ) * xc.2) = γ)).card
      ≤ 2 * (2 ^ t : ℕ) * (2 * M + 2 ^ t) := by
  classical
  let qN : ℕ := 2 ^ t
  let qZ : ℤ := ((2 ^ t : ℕ) : ℤ)
  let MZ : ℤ := (M : ℤ)
  have ht1 : 1 ≤ t := by omega
  have hqZpos : 0 < qZ := by
    dsimp [qZ]
    exact_mod_cast (pow_pos (by norm_num : 0 < 2) t : 0 < 2 ^ t)
  have hqZne : qZ ≠ 0 := by omega
  -- γ-cells of the window (row position x ∈ {1..q²}, F* column c ∈ [-M, M])
  let G : Finset (ℤ × ℤ) :=
    ((Finset.Icc (1 : ℤ) (qZ * qZ)).product (Finset.Icc (-MZ) MZ)).filter
      (fun xc : ℤ × ℤ => ∀ r : Fin N, rowVal r = xc.1 → F r (qZ * xc.2) = γ)
  -- diagonal index set R := {n0 ∈ {1..q}} × {m0 ∈ [-M-q+1, M]}
  let R : Finset (ℤ × ℤ) :=
    (Finset.Icc (1 : ℤ) qZ).product (Finset.Icc (-MZ - qZ + 1) MZ)
  -- per-diagonal γ-slots
  let Dslots : ℤ × ℤ → Finset ℕ := fun nm =>
    (Finset.range qN).filter (fun j : ℕ =>
      ∀ r : Fin N, rowVal r = nm.1 + qZ * (j : ℤ) →
        F r (qZ * (nm.2 + (j : ℤ))) = γ)
  -- geometric realization of the diagonal γ-slots as window cells
  let Dcells : ℤ × ℤ → Finset (ℤ × ℤ) := fun nm =>
    (Dslots nm).image (fun j : ℕ => (nm.1 + qZ * (j : ℤ), nm.2 + (j : ℤ)))
  -- (1) per-diagonal bound: each D(n0,m0) carries at most 2 γ-slots (hence ≤ 2 cells)
  have hslot (nm : ℤ × ℤ) (hn0 : 1 ≤ nm.1) (hn0q : nm.1 ≤ qZ) :
      (Dslots nm).card ≤ 2 := by
    dsimp [Dslots]
    exact tetris_diag_digit_bound (t := t) (N := N) ht hNq F hF Dp hNF nm.1 nm.2 hn0 hn0q
      (qZ * nm.2 - nm.1) (by rfl) γ
  have hDcell (nm : ℤ × ℤ) (hn0 : 1 ≤ nm.1) (hn0q : nm.1 ≤ qZ) :
      (Dcells nm).card ≤ 2 := by
    have hinj : Set.InjOn (fun j : ℕ => (nm.1 + qZ * (j : ℤ), nm.2 + (j : ℤ))) ↑(Dslots nm) := by
      intro j1 hj1 j2 hj2 heq
      have hfst : nm.1 + qZ * (j1 : ℤ) = nm.1 + qZ * (j2 : ℤ) := congrArg Prod.fst heq
      have hmul : qZ * (j1 : ℤ) = qZ * (j2 : ℤ) := add_left_cancel hfst
      have hz : (j1 : ℤ) = (j2 : ℤ) := mul_left_cancel₀ hqZne hmul
      exact_mod_cast hz
    have hcard : (Dcells nm).card = (Dslots nm).card := by
      dsimp [Dcells]
      exact Finset.card_image_of_injOn hinj
    calc
      (Dcells nm).card = (Dslots nm).card := hcard
      _ ≤ 2 := hslot nm hn0 hn0q
  -- (2) covering: every window γ-cell lies on a D(n0,m0) with (n0,m0) ∈ R
  have hcov : G ⊆ R.biUnion Dcells := by
    intro xc hxc
    rw [Finset.mem_filter] at hxc
    rcases hxc with ⟨hwin, hval⟩
    change xc ∈ (Finset.Icc (1 : ℤ) (qZ * qZ)) ×ˢ (Finset.Icc (-MZ) MZ) at hwin
    rw [Finset.mem_product] at hwin
    have hx1 : 1 ≤ xc.1 := (Finset.mem_Icc.mp hwin.1).1
    have hx2 : xc.1 ≤ qZ * qZ := (Finset.mem_Icc.mp hwin.1).2
    have hclo : -(MZ) ≤ xc.2 := (Finset.mem_Icc.mp hwin.2).1
    have hcup : xc.2 ≤ MZ := (Finset.mem_Icc.mp hwin.2).2
    have hx2' : xc.1 ≤ (((2 ^ t * 2 ^ t : ℕ) : ℤ)) := by
      simpa [qZ] using hx2
    rcases tetris_diag_cell_exists (t := t) ht1 xc.1 xc.2 hx1 hx2' with
      ⟨n0, m0', j, hn0, hn0q, hj, hx, hm⟩
    rw [Finset.mem_biUnion]
    refine ⟨(n0, m0'), ?_, ?_⟩
    · change (n0, m0') ∈ (Finset.Icc (1 : ℤ) qZ) ×ˢ (Finset.Icc (-MZ - qZ + 1) MZ)
      rw [Finset.mem_product]
      constructor
      · rw [Finset.mem_Icc]
        exact ⟨hn0, hn0q⟩
      · rw [Finset.mem_Icc]
        constructor
        · have hjle : (j : ℤ) ≤ qZ - 1 := by
            have hj' : (j : ℤ) < qZ := by
              dsimp [qZ, qN]
              exact_mod_cast hj
            omega
          have hm0 : m0' = xc.2 - (j : ℤ) := by omega
          rw [hm0]
          omega
        · have hm0' : m0' = xc.2 - (j : ℤ) := by omega
          rw [hm0']
          omega
    · rw [Finset.mem_image]
      refine ⟨j, ?_, ?_⟩
      · rw [Finset.mem_filter]
        constructor
        · rw [Finset.mem_range]
          exact hj
        · intro r hr
          have hr' : rowVal r = xc.1 := by
            rw [hx]
            exact hr
          have hv := hval r hr'
          rw [hm] at hv
          exact hv
      · dsimp
        apply Prod.ext
        · rw [hx]
        · rw [hm]
  -- (3) assemble the bound
  have h1 : G.card ≤ (R.biUnion Dcells).card := Finset.card_le_card hcov
  have h2 : (R.biUnion Dcells).card ≤ ∑ nm ∈ R, (Dcells nm).card := Finset.card_biUnion_le
  have h3 : (∑ nm ∈ R, (Dcells nm).card) ≤ ∑ nm ∈ R, (2 : ℕ) := by
    apply Finset.sum_le_sum
    intro nm hnm
    change nm ∈ (Finset.Icc (1 : ℤ) qZ) ×ˢ (Finset.Icc (-MZ - qZ + 1) MZ) at hnm
    rw [Finset.mem_product] at hnm
    have hn0 : 1 ≤ nm.1 := (Finset.mem_Icc.mp hnm.1).1
    have hn0q : nm.1 ≤ qZ := (Finset.mem_Icc.mp hnm.1).2
    exact hDcell nm hn0 hn0q
  have hIcc : (Finset.Icc (-(M : ℤ) - qZ + 1) (M : ℤ)).card = 2 * M + qN := by
    rw [Int.card_Icc]
    have hval : (M : ℤ) + 1 - (-(M : ℤ) - qZ + 1) = 2 * (M : ℤ) + qZ := by ring
    rw [hval]
    have hz : 2 * (M : ℤ) + qZ = (((2 * M + qN : ℕ) : ℤ)) := by
      dsimp [qZ, qN]
    rw [hz]
    exact Int.toNat_natCast (2 * M + qN)
  have h4 : (∑ nm ∈ R, (2 : ℕ)) = 2 * qN * (2 * M + qN) := by
    rw [Finset.sum_const]
    rw [Nat.nsmul_eq_mul]
    change (((Finset.Icc (1 : ℤ) qZ) ×ˢ (Finset.Icc (-MZ - qZ + 1) MZ)).card * 2) =
      2 * qN * (2 * M + qN)
    rw [Finset.card_product]
    rw [Icc_one_card qN]
    rw [hIcc]
    ring
  calc
    G.card ≤ (R.biUnion Dcells).card := h1
    _ ≤ ∑ nm ∈ R, (Dcells nm).card := h2
    _ ≤ ∑ nm ∈ R, (2 : ℕ) := h3
    _ = 2 * qN * (2 * M + qN) := h4
    _ = 2 * (2 ^ t : ℕ) * (2 * M + 2 ^ t) := by dsimp [qN]

/-! ## The post-Tetris-move board `F*` (paper Prop tetris-iterate)

The Tetris move replaces a Sudoku solution `F` (in normal form) by
`F*(n,m) := F(n, q·m)`.  `F*` is again a Sudoku solution: its non-vertical
line restrictions are restrictions of `F` to lines of slope `q·j` and intercept
`q·i`, which are `Scal` since `F` is a Sudoku solution; it avoids `0` since `F`
does.  (Note `q` here is the general modulus of the Sudoku board; in the Sudoku
section of the paper `q = 2^t`.) -/

/-- The post-Tetris-move board `F* := (n,m) ↦ F(n, q·m)`. -/
def postTetris {q N : ℕ} (F : SudokuBoard q N) : SudokuBoard q N :=
  fun r m => F r (((q : ℕ) : ℤ) * m)

/-- Line restrictions of the post-Tetris board are rescaled line restrictions of `F`:
`(F*)_{i,j} = F_{q·i,q·j}`. -/
lemma postTetris_lineRestrict {q N : ℕ} (F : SudokuBoard q N) (i j : ℤ) :
    lineRestrict (postTetris F) i j = lineRestrict F (((q : ℕ) : ℤ) * i) (((q : ℕ) : ℤ) * j) := by
  ext n
  simp [lineRestrict, postTetris]
  ring

/-- The post-Tetris board avoids the zero digit whenever `F` does. -/
lemma postTetris_nonzero {q N : ℕ} {F : SudokuBoard q N}
    (hF0 : ∀ n m, F n m ≠ 0) : ∀ n m, postTetris F n m ≠ 0 := by
  intro n m
  exact hF0 n (((q : ℕ) : ℤ) * m)

/-- The post-Tetris move of a Sudoku solution is again a Sudoku solution. -/
lemma postTetris_is_sudoku {q N : ℕ} (F : SudokuBoard q N)
    (hF : IsSudokuSolution q N F) : IsSudokuSolution q N (postTetris F) := by
  constructor
  · exact postTetris_nonzero hF.1
  · intro i j
    rw [postTetris_lineRestrict]
    exact hF.2 (((q : ℕ) : ℤ) * i) (((q : ℕ) : ℤ) * j)

/-- The post-Tetris window digit count: restatement of `tetris_window_digit_count`
for `F* = postTetris F` (whose value at `(row r, column c)` is `F r (q·c)`): in the
column window `{row positions 1..q²} × {columns -M..M}` each digit `γ` is attained on
at most `2·q·(2M+q)` cells. -/
lemma postTetris_window_digit_count {t N : ℕ} (ht : 3 ≤ t) (hNq : (2 ^ t) * (2 ^ t) ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (M : ℕ) (γ : ZMod (2 ^ t)) :
    (((Finset.Icc (1 : ℤ) ((((2 ^ t : ℕ) : ℤ) * ((2 ^ t : ℕ) : ℤ)))).product
        (Finset.Icc (-(M : ℤ)) (M : ℤ))).filter
      (fun xc : ℤ × ℤ =>
        ∀ r : Fin N, rowVal r = xc.1 → postTetris F r xc.2 = γ)).card
      ≤ 2 * (2 ^ t : ℕ) * (2 * M + 2 ^ t) := by
  simpa [postTetris] using
    (tetris_window_digit_count (t := t) (N := N) ht hNq F hF Dp hNF M γ)

/-! ## Bridge: slope-family digit counts of a board are bounded by its column-window
digit counts

`interceptDigitCount F j γ K` counts the cells `(r, j·rowVal r + i)` (`|i| ≤ K`) on
which the board carries the digit `γ`.  For slopes `|j| ≤ 1` every such cell lies in
the (symmetric) column window `[-(K+N), K+N]` (since `|j·rowVal r| ≤ N`), so the
intercept count is bounded by the number of `γ`-cells of the board in that window.  -/

/-- `rowVal` is injective: each row position is the position of exactly one row. -/
lemma rowVal_injective {N : ℕ} : Function.Injective (rowVal : Fin N → ℤ) := by
  intro a b h
  apply Fin.ext
  have hz : (a.val : ℤ) = (b.val : ℤ) := by
    dsimp [rowVal] at h
    omega
  exact_mod_cast hz

/-- Per-slope containment: for slopes `j ∈ {-1,0,1}`, every cell counted by
`interceptDigitCount F j γ K` lies in the column window `[-(K+N), K+N]`; summing the
per-row bound gives the claim.  (No Sudoku hypotheses.) -/
lemma interceptDigitCount_le_rowWindow {q N : ℕ} (F : SudokuBoard q N) (j : ℤ)
    (hj : j = -1 ∨ j = 0 ∨ j = 1) (γ : ZMod q) (K : ℕ) :
    interceptDigitCount F j γ K ≤
      ∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
        (fun c : ℤ => F r c = γ)).card := by
  classical
  have hrow (r : Fin N) :
      ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun i : ℤ => F r (j * ((r.val : ℕ) + 1 : ℤ) + i) = γ)).card ≤
      ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
        (fun c : ℤ => F r c = γ)).card := by
    let S : Finset ℤ := (Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
      (fun i : ℤ => F r (j * ((r.val : ℕ) + 1 : ℤ) + i) = γ)
    let T : Finset ℤ := (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
      (fun c : ℤ => F r c = γ)
    let f : ℤ → ℤ := fun i => j * ((r.val : ℕ) + 1 : ℤ) + i
    have hrN : ((r.val : ℕ) + 1 : ℤ) ≤ (N : ℤ) := by
      have hlt : (r.val : ℤ) < (N : ℤ) := by exact_mod_cast r.isLt
      have hcast : (((r.val : ℕ) + 1 : ℤ)) = (r.val : ℤ) + 1 := by norm_num
      rw [hcast]
      omega
    have hx1 : 1 ≤ ((r.val : ℕ) + 1 : ℤ) := by
      have hr0 : 0 ≤ (r.val : ℤ) := by exact_mod_cast (Nat.zero_le r.val)
      have hcast : (((r.val : ℕ) + 1 : ℤ)) = (r.val : ℤ) + 1 := by norm_num
      rw [hcast]
      omega
    have hmap : Set.MapsTo f ↑S ↑T := by
      intro i hi
      rw [Finset.mem_coe] at hi
      rw [Finset.mem_filter] at hi
      change f i ∈ T
      rw [Finset.mem_filter]
      constructor
      · rw [Finset.mem_Icc]
        rcases (Finset.mem_Icc.mp hi.1) with ⟨hlo, hup⟩
        have hK : (((K + N : ℕ) : ℤ)) = (K : ℤ) + (N : ℤ) := by
          exact_mod_cast (Nat.cast_add K N)
        rw [hK]
        rcases hj with h | h | h
        · subst j
          dsimp [f]
          constructor <;> omega
        · subst j
          dsimp [f]
          constructor <;> omega
        · subst j
          dsimp [f]
          constructor <;> omega
      · dsimp [f]
        exact hi.2
    have hinj : Set.InjOn f ↑S := by
      intro i1 hi1 i2 hi2 h
      dsimp [f] at h
      exact add_left_cancel h
    change S.card ≤ T.card
    exact Finset.card_le_card_of_injOn f hmap hinj
  calc
    interceptDigitCount F j γ K = ∑ r : Fin N, ((Finset.Icc (-(K : ℤ)) (K : ℤ)).filter
        (fun i : ℤ => F r (j * ((r.val : ℕ) + 1 : ℤ) + i) = γ)).card := rfl
    _ ≤ ∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
        (fun c : ℤ => F r c = γ)).card := by
      apply Finset.sum_le_sum
      intro r hr
      exact hrow r

/-- Row-indexed window counts re-indexed by row positions: the number of `γ`-cells of
`G` in the column window `[-(K+N), K+N]` (summed over rows) is at most the number of
window cells counted by row position.  (No Sudoku hypotheses.) -/
lemma rowWindowSum_le_windowCells {q N : ℕ} (G : SudokuBoard q N) (γ : ZMod q) (K : ℕ) :
    (∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
        (fun c : ℤ => G r c = γ)).card) ≤
      (((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).product
          (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ))).filter
        (fun xc : ℤ × ℤ => ∀ r' : Fin N, rowVal r' = xc.1 → G r' xc.2 = γ)).card := by
  classical
  let P : Finset (Sigma fun _r : Fin N => ℤ) :=
    (Finset.univ : Finset (Fin N)).sigma (fun r : Fin N =>
      (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter (fun c : ℤ => G r c = γ))
  let W : Finset (ℤ × ℤ) :=
    ((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).product
        (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ))).filter
      (fun xc : ℤ × ℤ => ∀ r' : Fin N, rowVal r' = xc.1 → G r' xc.2 = γ)
  let φ : (Sigma fun _r : Fin N => ℤ) → ℤ × ℤ := fun z => (rowVal z.1, z.2)
  have hPcard : P.card = ∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
      (fun c : ℤ => G r c = γ)).card := by
    dsimp [P]
    rw [Finset.card_sigma]
  have him : P.image φ ⊆ W := by
    intro w hw
    rw [Finset.mem_image] at hw
    rcases hw with ⟨z, hzP, hφw⟩
    rw [← hφw]
    have hzwin : z.2 ∈ Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ) := by
      have hz : z ∈ P := hzP
      dsimp [P] at hz
      rw [Finset.mem_sigma] at hz
      exact (Finset.mem_filter.mp hz.2).1
    have hzG : G z.1 z.2 = γ := by
      have hz : z ∈ P := hzP
      dsimp [P] at hz
      rw [Finset.mem_sigma] at hz
      exact (Finset.mem_filter.mp hz.2).2
    change (rowVal z.1, z.2) ∈ W
    rw [Finset.mem_filter]
    constructor
    · change (rowVal z.1, z.2) ∈
        (Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)) ×ˢ
          (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ))
      rw [Finset.mem_product]
      constructor
      · rw [Finset.mem_Icc]
        constructor
        · dsimp [rowVal]
          omega
        · have hlt : (z.1.val : ℤ) < (N : ℤ) := by exact_mod_cast z.1.isLt
          dsimp [rowVal]
          omega
      · exact hzwin
    · intro r' hr'
      have hr'z : r' = z.1 := rowVal_injective hr'
      subst r'
      exact hzG
  have hinj : Set.InjOn φ ↑P := by
    intro z1 hz1 z2 hz2 h
    apply Sigma.ext
    · exact rowVal_injective (congrArg Prod.fst h)
    · exact heq_of_eq (congrArg Prod.snd h)
  have hcard : P.card ≤ W.card := by
    calc
      P.card = (P.image φ).card := (Finset.card_image_of_injOn hinj).symm
      _ ≤ W.card := Finset.card_le_card him
  calc
    (∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
        (fun c : ℤ => G r c = γ)).card) = P.card := hPcard.symm
    _ ≤ W.card := hcard
    _ = (((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).product
        (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ))).filter
      (fun xc : ℤ × ℤ => ∀ r' : Fin N, rowVal r' = xc.1 → G r' xc.2 = γ)).card := rfl

/-- F*'s slope-family digit bound (the finite `Lemma rare` input for the post-Tetris
board): for slopes `|j| ≤ 1` and every digit `γ`,
`interceptDigitCount F* j γ K ≤ 2·q·(2·(K+N)+q)` with `N = q² = 2^{2t}` the width of
the board.  Combines the per-slope containment with the post-Tetris window count. -/
lemma postTetris_interceptDigit_le {t : ℕ} (ht : 3 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (j : ℤ) (hj : j = -1 ∨ j = 0 ∨ j = 1) (γ : ZMod (2 ^ t)) (K : ℕ) :
    interceptDigitCount (postTetris F) j γ K ≤
      2 * (2 ^ t : ℕ) * (2 * (K + 2 ^ t * 2 ^ t) + 2 ^ t) := by
  classical
  let N : ℕ := 2 ^ t * 2 ^ t
  have hNq : (2 ^ t) * (2 ^ t) ≤ N := by rfl
  have h1 := interceptDigitCount_le_rowWindow (q := 2 ^ t) (N := N)
    (F := postTetris F) j hj γ K
  have h2 := rowWindowSum_le_windowCells (q := 2 ^ t) (N := N) (G := postTetris F) γ K
  have h3 := postTetris_window_digit_count (t := t) (N := N) ht hNq F hF Dp hNF
    (K + N) γ
  calc
    interceptDigitCount (postTetris F) j γ K
        ≤ ∑ r : Fin N, ((Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ)).filter
            (fun c : ℤ => postTetris F r c = γ)).card := by
              simpa [N] using h1
    _ ≤ (((Finset.Icc (1 : ℤ) ((N : ℕ) : ℤ)).product
            (Finset.Icc (-((K + N : ℕ) : ℤ)) ((K + N : ℕ) : ℤ))).filter
          (fun xc : ℤ × ℤ => ∀ r' : Fin N, rowVal r' = xc.1 → postTetris F r' xc.2 = γ)).card := h2
    _ ≤ 2 * (2 ^ t : ℕ) * (2 * (K + N) + 2 ^ t) := by
          simpa [N] using h3
    _ = 2 * (2 ^ t : ℕ) * (2 * (K + 2 ^ t * 2 ^ t) + 2 ^ t) := by dsimp [N]

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## The F*-rare digit-bound hypothesis (finite Lemma-rare input for the post-Tetris
board), and its instance for `F* = postTetris F` at width `q² = 2^{2t}`.

`HasDigitBound t N M F` asserts the slope-family digit bound needed by the rare layer
for a board of width `N`: for slopes `j ∈ {-1,0,1}` the `q/2`-digit count along
slope-`j` lines with intercepts in the rare window `[-(M+N), M+N]` is at most
`B* := 2q(2(M+2N)+q)`.  `postTetris_hasDigitBound` proves it for the post-Tetris board
from the column-window digit count (the D-partition bound). -/

/-- The rare-layer constant for the post-Tetris board: `B* + 2K + 1`, `K := M+N`,
`B* := 2q(2(K+N)+q) = 2q(2(M+2N)+q)` (the `+2K+1` is the window-size slack of the
per-order bound). -/
def rareConstStar (t N M : ℕ) : ℕ :=
  2 * (2 ^ t) * (2 * (M + 2 * N) + 2 ^ t) + (2 * (M + N) + 1)

/-- Slope-family digit bound of a board of width `N`: for slopes `j ∈ {-1,0,1}`, the
`q/2`-digit count along the slope-`j` lines with intercepts in `[-(M+N), M+N]` is at
most `B* := 2q(2(M+2N)+q)`. -/
def HasDigitBound (t N M : ℕ) (F : SudokuBoard (2 ^ t) N) : Prop :=
  ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 →
    interceptDigitCount F j ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t)) (M + N) ≤
      2 * (2 ^ t) * (2 * (M + 2 * N) + 2 ^ t)

/-- The post-Tetris board of a normal-form Sudoku solution (width `N = q² = 2^{2t}`)
satisfies the digit bound: instantiate the column-window count at `K := M+N` and note
`(K+N) = M+2N` since `N = q²` is the board width. -/
lemma postTetris_hasDigitBound {t : ℕ} (ht : 3 ≤ t) (M : ℕ)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) :
    HasDigitBound t (2 ^ t * 2 ^ t) M (postTetris F) := by
  classical
  intro j hj
  let q2 : ZMod (2 ^ t) := ((2 ^ (t - 1) : ℕ) : ZMod (2 ^ t))
  have hb := postTetris_interceptDigit_le (t := t) ht F hF Dp hNF j hj q2 (M + 2 ^ t * 2 ^ t)
  have hc : (M + 2 ^ t * 2 ^ t) + 2 ^ t * 2 ^ t = M + 2 * (2 ^ t * 2 ^ t) := by ring
  simpa [q2, hc] using hb

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## The rare layer for boards with the slope-family digit bound `HasDigitBound`

This is the dev_sqb rare chain (perOrder_U_le_rare → hitSet_card_le_rareTotal →
exists_square_free_badCells) re-derived with the digit-bound hypothesis
`HasDigitBound t N M F` (which the post-Tetris board satisfies via
`postTetris_hasDigitBound`) in place of good columns.  The constants are
`rareConstStar t N M := B* + 2K + 1` with `K := M+N`, `B* := 2q(2(M+2N)+q)`. -/

/-- Per-order class bound under the digit bound: with `U` the number of order-`o`
affine-agreement intercepts of slope `j ∈ {-1,0,1}` in the window,
`64·((2N)/2^{t-o}+1)·U ≤ 128·rareConstStar`. -/
lemma perOrder_U_le_rare_dig {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N)
    (hdig : HasDigitBound t N M F) (j : ℤ) (hj : j = -1 ∨ j = 0 ∨ j = 1)
    (o : ℕ) (ho : o < t) :
    64 * (((2 * N) / (2 ^ (t - o))) + 1) *
        ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card
      ≤ 128 * rareConstStar t N M := by
  classical
  let K : ℕ := M + N
  let B : ℕ := 2 * (2 ^ t) * (2 * (M + 2 * N) + 2 ^ t)
  let c : ℕ := N / (2 ^ (t - o))
  let U : ℕ := ((rareWindow N M).filter (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)).card
  have hrare : U * c ≤ B := by
    have hb := highOrderLines_doublecount (t := t) (N := N) (K := K) (o := o) ht
      (by omega : o ≤ t - 1) F j
    have hwin : (Finset.Icc (-(K : ℤ)) (K : ℤ)) = rareWindow N M := by
      dsimp [K, rareWindow]
    rw [hwin] at hb
    have hd := hdig j hj
    dsimp [U, c, B, K] at hb hd ⊢
    exact le_trans hb hd
  have hdiv : ((2 * N) / (2 ^ (t - o))) + 1 ≤ 2 * c + 2 := by
    dsimp [c]
    have h1 := two_mul_div_le (N := N) (d := 2 ^ (t - o))
    omega
  have hUwin : U ≤ 2 * K + 1 := by
    dsimp [U]
    have hle := Finset.card_filter_le (rareWindow N M) (fun i : ℤ => lineAgreesAffineOrder (t := t) (N := N) F o i j)
    have hcard : (rareWindow N M).card = 2 * K + 1 := by
      dsimp [K]
      exact rareWindow_card N M
    omega
  have hUc : c * U ≤ B := by
    exact (by simpa [mul_comm] using hrare)
  calc
    64 * (((2 * N) / (2 ^ (t - o))) + 1) * U
        ≤ 64 * (2 * c + 2) * U := by
            exact Nat.mul_le_mul_right U (Nat.mul_le_mul_left 64 hdiv)
    _ = 128 * (c * U + U) := by
            ring
    _ ≤ 128 * (B + U) := by
            exact Nat.mul_le_mul_left 128 (by omega)
    _ ≤ 128 * (B + (2 * K + 1)) := by
            exact Nat.mul_le_mul_left 128 (by omega)
    _ = 128 * rareConstStar t N M := by
            dsimp [rareConstStar, B, K]

/-- Per-order per-slope contribution bounded by the uniform F*-rare constant. -/
lemma perOrder_U_le_rare_dig' {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N)
    (hdig : HasDigitBound t N M F) (j : ℤ) (hj : j = -1 ∨ j = 0 ∨ j = 1)
    (o : ℕ) (ho : o < t) :
    64 * (((2 * N) / (2 ^ (t - o))) + 1) * rareCount t N M F j o ≤ 128 * rareConstStar t N M := by
  have hb := perOrder_U_le_rare_dig (t := t) (N := N) (M := M) ht F hdig j hj o ho
  simpa [rareCount, rareConstStar] using hb

/-- Total hit-set bound after the F*-rare layer: `hitSet ≤ J.card · t · 128 · rareConstStar`. -/
lemma hitSet_card_le_rareTotal_dig {t N M : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hdig : HasDigitBound t N M F) (J : Finset ℤ)
    (hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1) :
    (hitSet t N M ht F hF J).card ≤ J.card * t * 128 * rareConstStar t N M := by
  classical
  let classSum : ℕ := (∑ jo ∈ J.product (Finset.range t),
        64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * (badClass t N M ht F hF jo.1 jo.2).card)
  let Usum : ℕ := (∑ jo ∈ J.product (Finset.range t),
        64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * rareCount t N M F jo.1 jo.2)
  have h1 : (hitSet t N M ht F hF J).card ≤ classSum := by
    simpa [classSum] using hitSet_card_le_classSum ht F hF J hJ
  have h2 : classSum ≤ Usum := by
    dsimp [classSum, Usum]
    apply Finset.sum_le_sum
    intro jo hjo
    exact Nat.mul_le_mul_left (64 * (((2 * N) / (2 ^ (t - jo.2))) + 1))
      (badClass_card_le_rareCount ht F hF jo.1 jo.2)
  have h3 : Usum ≤ (J.product (Finset.range t)).card * (128 * rareConstStar t N M) := by
    dsimp [Usum]
    have hsum_le : (∑ jo ∈ J.product (Finset.range t),
          64 * (((2 * N) / (2 ^ (t - jo.2))) + 1) * rareCount t N M F jo.1 jo.2)
        ≤ (∑ jo ∈ J.product (Finset.range t), 128 * rareConstStar t N M) := by
      apply Finset.sum_le_sum
      intro jo hjo
      change jo ∈ J ×ˢ Finset.range t at hjo
      rw [Finset.mem_product] at hjo
      exact perOrder_U_le_rare_dig' (t := t) (N := N) (M := M) ht F hdig jo.1
        (hJ jo.1 hjo.1) jo.2 (by
          rw [Finset.mem_range] at hjo
          exact hjo.2)
    have hconst : (∑ jo ∈ J.product (Finset.range t), 128 * rareConstStar t N M) =
        (J.product (Finset.range t)).card * (128 * rareConstStar t N M) := by
      rw [Finset.sum_const]
      simp
    exact le_trans hsum_le (le_of_eq hconst)
  have hcard : (J.product (Finset.range t)).card = J.card * t := by
    change (J ×ˢ Finset.range t).card = J.card * t
    rw [Finset.card_product]
    simp
  calc
    (hitSet t N M ht F hF J).card ≤ classSum := h1
    _ ≤ Usum := h2
    _ ≤ (J.product (Finset.range t)).card * (128 * rareConstStar t N M) := h3
    _ = J.card * t * 128 * rareConstStar t N M := by
        rw [hcard]
        ring


/-! ## Square selection for boards with the digit bound (F*-near-digit input)

If the rare-layer total is smaller than the number of `8×8` squares, a square
`{n₀..n₀+7} × {m₀..m₀+7}` inside the slab contains no bad cell of any horizontal /
diagonal / anti-diagonal line (slopes `-1,0,1`). -/
theorem exists_square_free_badCells_dig {t N M : ℕ} (ht : 1 ≤ t)
    (hN7 : 8 ≤ N) (hM7 : 8 ≤ M)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (hdig : HasDigitBound t N M F)
    (hineq : 3 * t * 128 * rareConstStar t N M < (N - 7) * (M - 7)) :
    ∃ n₀ m₀ : ℤ,
      1 ≤ n₀ ∧ n₀ + 7 ≤ (N : ℤ) ∧ 1 ≤ m₀ ∧ m₀ + 7 ≤ (M : ℤ) ∧
      ∀ j : ℤ, j = -1 ∨ j = 0 ∨ j = 1 → ∀ x m : ℤ,
        x ∈ Finset.Icc n₀ (n₀ + 7) → m ∈ Finset.Icc m₀ (m₀ + 7) →
          ¬ x ∈ badCoset (2 ^ t) (boardLinePair ht F hF (m - j * x) j).1
            (boardLinePair ht F hF (m - j * x) j).2 := by
  classical
  let J : Finset ℤ := ({-1, 0, 1} : Finset ℤ)
  have hJ : ∀ j ∈ J, j = -1 ∨ j = 0 ∨ j = 1 := by
    intro j hj
    simpa [J] using hj
  have hJcard : J.card = 3 := by
    simp [J]
  have hlt : (hitSet t N M ht F hF J).card < (slabSquares N M).card := by
    calc
      (hitSet t N M ht F hF J).card ≤ J.card * t * 128 * rareConstStar t N M :=
        hitSet_card_le_rareTotal_dig ht F hF hdig J hJ
      _ = 3 * t * 128 * rareConstStar t N M := by rw [hJcard]
      _ < (N - 7) * (M - 7) := hineq
      _ = (slabSquares N M).card := (slabSquares_card N M).symm
  obtain ⟨s0, hs0, hnot⟩ := slabSquares_notHit_exists ht F hF J hlt
  rcases s0 with ⟨n₀, m₀⟩
  have hprod : (n₀, m₀) ∈ (Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))) ×ˢ
      (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ))) := by
    change (n₀, m₀) ∈ slabSquares N M
    simpa using hs0
  have hmemprod : (n₀, m₀) ∈
      (Finset.Icc (1 : ℤ) (((N - 7 : ℕ) : ℤ))) ×ˢ
      (Finset.Icc (1 : ℤ) (((M - 7 : ℕ) : ℤ))) := hprod
  rw [Finset.mem_product] at hmemprod
  rcases hmemprod with ⟨hn, hm⟩
  have hn1 : 1 ≤ n₀ := (Finset.mem_Icc.mp hn).1
  have hn2 : n₀ ≤ (((N - 7 : ℕ) : ℤ)) := (Finset.mem_Icc.mp hn).2
  have hm1 : 1 ≤ m₀ := (Finset.mem_Icc.mp hm).1
  have hm2 : m₀ ≤ (((M - 7 : ℕ) : ℤ)) := (Finset.mem_Icc.mp hm).2
  have hcastN : (((N - 7 : ℕ) : ℤ)) = (N : ℤ) - 7 := by
    rw [Nat.cast_sub (by omega : (7 : ℕ) ≤ N)]
    norm_num
  have hcastM : (((M - 7 : ℕ) : ℤ)) = (M : ℤ) - 7 := by
    rw [Nat.cast_sub (by omega : (7 : ℕ) ≤ M)]
    norm_num
  have hn7 : n₀ + 7 ≤ (N : ℤ) := by omega
  have hm7 : m₀ + 7 ≤ (M : ℤ) := by omega
  refine ⟨n₀, m₀, hn1, hn7, hm1, hm7, ?_⟩
  intro j hjs x m hx hm
  intro hbad
  have hxI : n₀ ≤ x ∧ x ≤ n₀ + 7 := Finset.mem_Icc.mp hx
  have hmI : m₀ ≤ m ∧ m ≤ m₀ + 7 := Finset.mem_Icc.mp hm
  have hxmem : x ∈ Finset.Icc (1 : ℤ) (((N : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hmmem : m ∈ Finset.Icc (1 : ℤ) (((M : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hcol : j * x + (m - j * x) ∈ Finset.Icc (1 : ℤ) (((M : ℕ) : ℤ)) := by
    rw [Finset.mem_Icc]
    constructor <;> omega
  have hmem : (n₀, m₀) ∈ hitSet t N M ht F hF J := by
    rw [hitSet, Finset.mem_filter]
    refine ⟨hs0, ?_⟩
    refine ⟨j, ?_, m - j * x, (x, m), ?_, ?_⟩
    · simpa [J] using hjs
    · rw [slabBadCells]
      rw [Finset.mem_image]
      refine ⟨x, ?_, ?_⟩
      · rw [Finset.mem_filter]
        refine ⟨hxmem, ?_⟩
        refine ⟨hbad, hcol⟩
      · congr 1
        ring
    · rw [Finset.mem_Icc] at hx hm
      exact ⟨hx.1, hx.2, hm.1, hm.2⟩
  exact hnot hmem



/-! ## Near-digit for the post-Tetris board (`Ψ*`)

The paper (tex 1433): `F*` has weak digit equidistribution, so Proposition near-digit
applies to `F*` and gives a pseudo-affine `Ψ*` agreeing with `F*` off its zeros.  Here
we assemble this for the width-`q²` board from the F*-rare chain above. -/

/-- `2^t·2^t = 2^(2t)`. -/
lemma two_pow_sq (t : ℕ) : (2 ^ t) * (2 ^ t) = 2 ^ (2 * t) := by
  rw [← pow_add]
  congr 1
  omega

/-- `2^t·2^t·2^t = 2^(3t)`. -/
lemma two_pow_cube (t : ℕ) : (2 ^ t) * (2 ^ t) * (2 ^ t) = 2 ^ (3 * t) := by
  rw [← pow_add, ← pow_add]
  congr 1
  omega

/-- Value of the F*-rare constant at the square parameters `N = M = 2^t·2^t`. -/
lemma rareConstStar_eval (t : ℕ) :
    rareConstStar t (2 ^ t * 2 ^ t) (2 ^ t * 2 ^ t) =
      12 * ((2 ^ t) * (2 ^ t) * (2 ^ t)) + 6 * ((2 ^ t) * (2 ^ t)) + 1 := by
  dsimp [rareConstStar]
  ring

/-- Proposition near-digit for the post-Tetris board of a normal-form Sudoku solution of
width `q² = 2^{2t}` (`t ≥ 24`): there is a pseudo-affine function `Ψ*`, not vanishing on
some cell, which agrees with `F*` wherever `Ψ*` is non-zero. -/
theorem near_digit_Fstar {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) :
    ∃ A B C D : ZMod (2 ^ t),
      (∃ r0 : Fin (2 ^ t * 2 ^ t), ∃ m0 : ℤ,
        pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0) ∧
      ∀ r : Fin (2 ^ t * 2 ^ t), ∀ m : ℤ,
        pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
          postTetris F r m = pseudoAffineVal A B C D (rowVal r) m := by
  classical
  let N : ℕ := 2 ^ t * 2 ^ t
  have ht1 : 1 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have hp_t : 0 < 2 ^ t := pow_pos (by norm_num : 0 < 2) t
  have h1_t : 1 ≤ 2 ^ t := by omega
  have hN7 : 8 ≤ N := by
    have h8 : 8 ≤ 2 ^ t := two_pow_ge_eight ht3
    have hmul : 2 ^ t ≤ (2 ^ t) * (2 ^ t) := by
      simpa using (Nat.mul_le_mul_left (2 ^ t) h1_t)
    dsimp [N]
    exact le_trans h8 hmul
  have hN16 : 16 ≤ N := by
    have h16 : 16 ≤ 2 ^ t := by
      have h4 : (4 : ℕ) ≤ t := by omega
      exact le_trans (by norm_num : (16 : ℕ) ≤ 2 ^ 4) (pow_le_pow_right₀ (by norm_num) h4)
    have hmul : 2 ^ t ≤ (2 ^ t) * (2 ^ t) := by
      simpa using (Nat.mul_le_mul_left (2 ^ t) h1_t)
    dsimp [N]
    exact le_trans h16 hmul
  have hFs : IsSudokuSolution (2 ^ t) N (postTetris F) := by
    simpa [N] using postTetris_is_sudoku F hF
  have hdig : HasDigitBound t N N (postTetris F) := by
    simpa [N] using postTetris_hasDigitBound ht3 N F hF Dp hNF
  have hineq : 3 * t * 128 * rareConstStar t N N < (N - 7) * (N - 7) := by
    dsimp [N]
    rw [rareConstStar_eval]
    rw [two_pow_cube, two_pow_sq]
    exact Commons.Data.Nat.pow_rare_star_ineq_24 t ht24
  -- (A) locate the free square (F*-rare chain)
  obtain ⟨n0, m0, hn01, hn7, hm01, hm7, hfree⟩ :=
    exists_square_free_badCells_dig (t := t) (N := N) (M := N) ht1 hN7 hN7
      (postTetris F) hFs hdig hineq
  -- (B) pseudo-affine Ψ* agreeing with F* on the square
  obtain ⟨A, B, C, D, hOnSquare⟩ := board_square_pseudo_affine (t := t) (N := N)
    ht1 (by omega : 2 ≤ t) (postTetris F) hFs n0 m0 hn01 hn7 hm01 hfree
  -- (C) every square cell is good (F* = Ψ* there)
  have hsquare_good : ∀ r : Fin N, ∀ m : ℤ,
      n0 ≤ rowVal r → rowVal r ≤ n0 + 7 → m0 ≤ m → m ≤ m0 + 7 →
        GoodCell A B C D (postTetris F) r m := by
    intro r m hr0 hr7 hm0 hm1
    right
    exact hOnSquare r m hr0 hr7 hm0 hm1
  -- each column m ∈ [m0, m0+7]: all rows good (horizontal rigid-out)
  have hrow : ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 → ∀ r : Fin N, GoodCell A B C D (postTetris F) r m := by
    intro m hm0 hm1 r
    have hgoodwin : ∀ w : Fin N, rowInWindow n0 w →
        GoodCell A B C D (postTetris F) w (0 * rowVal w + m) := by
      intro w hw
      rw [rowInWindow_iff_mem, Finset.mem_Icc] at hw
      have hg := hsquare_good w m hw.1 hw.2 hm0 hm1
      simpa using hg
    have hall := line_all_good_of_window_good (t := t) (N := N) ht3 (postTetris F) hFs A B C D 0 m n0
      (Or.inr (Or.inl rfl)) hn01 hn7 hgoodwin
    have hc := hall r
    simpa using hc
  -- rectangle → all columns → all cells good
  have hrect : ∀ r : Fin N, ∀ m : ℤ, m0 ≤ m → m ≤ m0 + 7 → GoodCell A B C D (postTetris F) r m := by
    intro r m hm0 hm1
    exact hrow m hm0 hm1 r
  have hallgood : ∀ r : Fin N, ∀ m : ℤ, GoodCell A B C D (postTetris F) r m :=
    rectangle_extend_all (t := t) (N := N) ht3 hN16 (postTetris F) hFs A B C D m0 hrect
  refine ⟨A, B, C, D, ?_, ?_⟩
  · -- Ψ ≠ 0 at (r0, m0): pick r0 := the row of coordinate n0
    have hn0N : n0 ≤ (N : ℤ) := le_trans (by omega : n0 ≤ n0 + 7) hn7
    obtain ⟨r0, hr0⟩ := exists_row_rowVal (N := N) n0 hn01 hn0N
    refine ⟨r0, m0, ?_⟩
    intro hΨ0
    have hA : n0 ≤ rowVal r0 := by omega
    have hB : rowVal r0 ≤ n0 + 7 := by omega
    have hcell := hOnSquare r0 m0 hA hB (by omega) (by omega)
    have hF0 : postTetris F r0 m0 ≠ 0 := (hFs.1) r0 m0
    rw [hcell] at hF0
    exact hF0 hΨ0
  · exact agree_of_all_good (N := N) A B C D (postTetris F) hallgood


end
