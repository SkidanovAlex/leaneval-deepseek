set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! # Symmetric boolean constraints (Proposition sym-bool)

The compatible boolean property `CompBool e v p q` (all `K` widths, proven weakly
expressible) allows *normalized* representations `α_w = u_w + b·α̃_w` of a compatible
tuple: a common odd `b` and `(e,{0,1})`-boolean, `⟨p,q⟩`-periodic boolean functions
`α̃_w`.  On top of this one defines `P_Ω` (the boolean constraint `α̃(x) ∈ Ω` for a
reflection-symmetric set `Ω ⊆ {0,1}^W`) and shows it is weakly expressible
(`sym-bool`), following the paper (tex 887-928): for Ω of the form
`{0,1}^W ∖ {ε, 1-ε}` introduce `W-2` boolean auxiliaries β decomposed by the level
function `f(x) := Σ_w α̃_{w,ε_w}(x) ∈ {1,…,W-1}`.

This file: the *normalized representation* of a compatible boolean tuple (all `K`). -/

/-- Each coordinate's value set is a translate of the pair `{u_w, u_w + b}` for a common
odd `b`: a `CompBool` tuple has a normalization.  `w₀` is a reference coordinate. -/
lemma compbool_value_normalize {e : ℕ} (v p q : G) {K : ℕ} (w₀ : Fin K)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α) :
    ∃ (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w : Fin K, ∀ x : G, coord α w x = u w ∨ coord α w x = u w + b) ∧
      (∀ w : Fin K, ∀ x : G, coord α w (x + v) = (u w + (u w + b)) - coord α w x) := by
  classical
  let Z := ZMod (2 ^ (e + 1))
  rcases hα with ⟨hcore, hcompat⟩
  rcases hcore w₀ with ⟨hp₀, hq₀, hb₀⟩
  rcases hb₀ with ⟨a₀, b₀, hE₀, hO₀, hval₀, hsw₀⟩
  let b : Z := b₀ - a₀
  have hbO : b ∉ evenSub e := by
    dsimp [b]
    exact mef_odd_sub_even hE₀ hO₀
  -- each coordinate's range is a translate of {a₀, b₀}
  have htr : ∀ w : Fin K, ∃ t : Z, Set.range (coord α w) = t + ({a₀, b₀} : Set Z) := by
    intro w
    have hr₀ : Set.range (coord α w₀) = ({a₀, b₀} : Set Z) :=
      range_eq_pair e v (coord α w₀) a₀ b₀ hval₀ hsw₀
    have hc := hcompat w₀ w
    unfold CompatibleFunctions at hc
    rcases hc with ⟨t, ht⟩
    refine ⟨t, ?_⟩
    rwa [hr₀] at ht
  -- per-coordinate witness with the reference pair
  have hmain : ∀ w : Fin K, ∃ u : Z,
      (∀ x : G, coord α w x = u ∨ coord α w x = u + b) ∧
      (∀ x : G, coord α w (x + v) = (u + (u + b)) - coord α w x) := by
    intro w
    rcases hcore w with ⟨hpw, hqw, hbw⟩
    rcases hbw with ⟨aw, bw, hEw, hOw, hvalw, hsww⟩
    rcases htr w with ⟨t, ht⟩
    have hrw : Set.range (coord α w) = ({aw, bw} : Set Z) :=
      range_eq_pair e v (coord α w) aw bw hvalw hsww
    let u : Z := t + a₀
    have htrans : ({aw, bw} : Set Z) = t + ({a₀, b₀} : Set Z) := hrw.symm.trans ht
    -- membership of each coordinate value in {u, u + b}
    have hmem : ∀ x : G, coord α w x = u ∨ coord α w x = u + b := by
      intro x
      rcases hvalw x with hx | hx
      · rw [hx]
        have hmem1 : aw ∈ ({aw, bw} : Set Z) := by simp
        have hmt1 : aw ∈ t + ({a₀, b₀} : Set Z) := by
          rwa [htrans] at hmem1
        rcases (mem_add_element t ({a₀, b₀} : Set Z) aw).mp hmt1 with ⟨w₁, hw₁, hwz₁⟩
        simp at hw₁
        rcases hw₁ with hw₁a | hw₁b
        · rw [hw₁a] at hwz₁
          left
          dsimp [u]
          exact hwz₁
        · rw [hw₁b] at hwz₁
          right
          dsimp [u, b]
          rw [hwz₁]
          ring
      · rw [hx]
        have hmem1 : bw ∈ ({aw, bw} : Set Z) := by simp
        have hmt1 : bw ∈ t + ({a₀, b₀} : Set Z) := by
          rwa [htrans] at hmem1
        rcases (mem_add_element t ({a₀, b₀} : Set Z) bw).mp hmt1 with ⟨w₁, hw₁, hwz₁⟩
        simp at hw₁
        rcases hw₁ with hw₁a | hw₁b
        · rw [hw₁a] at hwz₁
          left
          dsimp [u]
          exact hwz₁
        · rw [hw₁b] at hwz₁
          right
          dsimp [u, b]
          rw [hwz₁]
          ring
    -- the pair sum: aw + bw = u + (u + b)
    have haw : aw = u ∨ aw = u + b := by
      have hmem1 : aw ∈ ({aw, bw} : Set Z) := by simp
      have hmt1 : aw ∈ t + ({a₀, b₀} : Set Z) := by rwa [htrans] at hmem1
      rcases (mem_add_element t ({a₀, b₀} : Set Z) aw).mp hmt1 with ⟨w₁, hw₁, hwz₁⟩
      simp at hw₁
      rcases hw₁ with hw₁a | hw₁b
      · rw [hw₁a] at hwz₁
        left
        dsimp [u]
        exact hwz₁
      · rw [hw₁b] at hwz₁
        right
        dsimp [u, b]
        rw [hwz₁]
        ring
    have hbw' : bw = u ∨ bw = u + b := by
      have hmem1 : bw ∈ ({aw, bw} : Set Z) := by simp
      have hmt1 : bw ∈ t + ({a₀, b₀} : Set Z) := by rwa [htrans] at hmem1
      rcases (mem_add_element t ({a₀, b₀} : Set Z) bw).mp hmt1 with ⟨w₁, hw₁, hwz₁⟩
      simp at hw₁
      rcases hw₁ with hw₁a | hw₁b
      · rw [hw₁a] at hwz₁
        left
        dsimp [u]
        exact hwz₁
      · rw [hw₁b] at hwz₁
        right
        dsimp [u, b]
        rw [hwz₁]
        ring
    have hsumw : aw + bw = u + (u + b) := by
      rcases haw with haw0 | haw1 <;> rcases hbw' with hbw0 | hbw1
      · -- aw = bw = u: contradiction with parity
        exfalso
        apply hOw
        rw [hbw0, ← haw0]
        exact hEw
      · -- aw = u, bw = u + b
        rw [haw0, hbw1]
      · -- aw = u + b, bw = u
        rw [haw1, hbw0]
        ring
      · -- aw = bw = u + b: contradiction with parity
        exfalso
        apply hOw
        rw [hbw1, ← haw1]
        exact hEw
    refine ⟨u, hmem, ?_⟩
    intro x
    calc
      coord α w (x + v) = aw + bw - coord α w x := hsww x
      _ = (u + (u + b)) - coord α w x := by rw [hsumw]
  refine ⟨fun w => Classical.choose (hmain w), b, hbO, ?_, ?_⟩
  · intro w x
    exact (Classical.choose_spec (hmain w)).1 x
  · intro w x
    exact (Classical.choose_spec (hmain w)).2 x


/-! ## The normalized boolean functions `α̃_w`

From the value normalization (each `coord α w` takes the two values `u w`, `u w + b`
with the alternating law) one obtains the normalized functions
`α̃ w := sb_norm u b α w` valued in `{0, 1}`: `α = u + b·α̃`, and each `α̃ w` is
`(v, {0,1})`-boolean and as periodic along `p`, `q` as `α` is. -/

/-- The normalized boolean coordinate: `0` on the `u w`-fiber, `1` on the `u w + b`-fiber. -/
noncomputable def sb_norm {e : ℕ} {K : ℕ} (u : Fin K → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1))) (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (w : Fin K) (x : G) : ZMod (2 ^ (e + 1)) :=
  if α x w = u w then 0 else 1

/-- The normalized coordinate takes only the values `0` and `1`. -/
lemma sb_norm_mem {e : ℕ} {K : ℕ} (u : Fin K → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1))) (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (w : Fin K) (x : G) : sb_norm u b α w x = 0 ∨ sb_norm u b α w x = 1 := by
  by_cases h : α x w = u w
  · left
    simp [sb_norm, h]
  · right
    simp [sb_norm, h]

/-- An odd element of `ZMod (2^(e+1))` is non-zero. -/
lemma sb_odd_ne_zero {e : ℕ} {z : ZMod (2 ^ (e + 1))} (hz : z ∉ evenSub e) : z ≠ 0 := by
  intro h0
  apply hz
  simpa [h0] using (mef_zero_even e)

/-- With the two-value normalization, `α = u + b·α̃` pointwise. -/
lemma sb_norm_value {e : ℕ} {K : ℕ} (u : Fin K → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1))) (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (hmem : ∀ w : Fin K, ∀ x : G, α x w = u w ∨ α x w = u w + b)
    (w : Fin K) (x : G) : α x w = u w + b * sb_norm u b α w x := by
  by_cases h : α x w = u w
  · rw [h]
    simp [sb_norm, h]
  · have h' : α x w = u w + b := (hmem w x).resolve_left h
    rw [h']
    simp [sb_norm, h]

/-- The normalized coordinate is `(v, {0,1})`-boolean when `α` is and obeys the
alternating law with the pair `{u w, u w + b}`. -/
lemma sb_norm_boolean {e : ℕ} (v : G) {K : ℕ} (u : Fin K → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1))) (hbO : b ∉ evenSub e)
    (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (hmem : ∀ w : Fin K, ∀ x : G, α x w = u w ∨ α x w = u w + b)
    (halt : ∀ w : Fin K, ∀ x : G, α (x + v) w = (u w + (u w + b)) - α x w)
    (w : Fin K) : IsBooleanAlt e v (fun x : G => sb_norm u b α w x) := by
  refine ⟨0, 1, ?_, ?_, ?_, ?_⟩
  · exact mef_zero_even e
  · exact (parityIn_one_iff_odd e (1 : ZMod (2 ^ (e + 1)))).mp (parityIn_one e)
  · intro x
    exact sb_norm_mem u b α w x
  · intro x
    -- g(x+v) = 1 - g x; case on whether α x w = u w
    change sb_norm u b α w (x + v) = 0 + 1 - sb_norm u b α w x
    by_cases hx : α x w = u w
    · -- g x = 0; α(x+v) w = u w + b ≠ u w, so g(x+v) = 1
      have hxv : α (x + v) w = (u w + (u w + b)) - α x w := halt w x
      rw [hx] at hxv
      have hxv' : α (x + v) w = u w + b := by
        rw [hxv]
        ring
      have hneq : ¬ α (x + v) w = u w := by
        intro hc
        have hb0 : b = 0 := by
          have hEq : u w + b = u w := hxv'.symm.trans hc
          have hb0' := congrArg (fun z : ZMod (2 ^ (e + 1)) => z - u w) hEq
          calc
            b = (u w + b) - u w := by ring
            _ = u w - u w := hb0'
            _ = 0 := by ring
        exact (sb_odd_ne_zero hbO) hb0
      have hgv : sb_norm u b α w (x + v) = 1 := by
        simp [sb_norm, hneq]
      have hgx : sb_norm u b α w x = 0 := by simp [sb_norm, hx]
      rw [hgv, hgx]
      ring
    · -- g x = 1; α x w = u w + b; α(x+v) w = u w, so g(x+v) = 0
      have hxb : α x w = u w + b := (hmem w x).resolve_left hx
      have hxv : α (x + v) w = (u w + (u w + b)) - α x w := halt w x
      rw [hxb] at hxv
      have hxv' : α (x + v) w = u w := by
        rw [hxv]
        ring
      have hgv : sb_norm u b α w (x + v) = 0 := by simp [sb_norm, hxv']
      have hgx : sb_norm u b α w x = 1 := by simp [sb_norm, hx]
      rw [hgv, hgx]
      ring

/-- If `α` is `u`-periodic then so is the normalized coordinate. -/
lemma sb_norm_periodic {e : ℕ} {K : ℕ} (u : Fin K → ZMod (2 ^ (e + 1)))
    (b : ZMod (2 ^ (e + 1))) (α : G → (Fin K → ZMod (2 ^ (e + 1))))
    (w : Fin K) (u0 : G) (hper : periodicAlong u0 (coord α w)) :
    periodicAlong u0 (fun x : G => sb_norm u b α w x) := by
  intro x
  by_cases hx : α x w = u w
  · have hx' : α (x + u0) w = u w := by
      have := hper x
      exact this.trans hx
    simp [sb_norm, hx, hx']
  · have hx' : ¬ α (x + u0) w = u w := by
      intro hc
      have := hper x
      apply hx
      exact this.symm.trans hc
    simp [sb_norm, hx, hx']

/-- A `CompBool` tuple has the full normalized representation
`α_w = u_w + b·α̃_w` with a common odd `b`, `(e,{0,1})`-boolean and
`⟨p,q⟩`-periodic boolean functions `α̃_w`. -/
lemma compbool_normalize_full {e : ℕ} (v p q : G) {K : ℕ} (w₀ : Fin K)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α) :
    ∃ (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
      (nrm : Fin K → G → ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w : Fin K, ∀ x : G, α x w = u w + b * nrm w x) ∧
      (∀ w : Fin K, ∀ x : G, nrm w x = 0 ∨ nrm w x = 1) ∧
      (∀ w : Fin K, IsBooleanAlt e v (nrm w)) ∧
      (∀ w : Fin K, periodicAlong p (nrm w)) ∧
      (∀ w : Fin K, periodicAlong q (nrm w)) := by
  classical
  rcases (compbool_value_normalize (e := e) v p q w₀ α hα) with ⟨u, b, hbO, hmem, halt⟩
  let nrm : Fin K → G → ZMod (2 ^ (e + 1)) := fun w x => sb_norm u b α w x
  refine ⟨u, b, nrm, hbO, ?_, ?_, ?_, ?_, ?_⟩
  · intro w x
    exact sb_norm_value u b α hmem w x
  · intro w x
    exact sb_norm_mem u b α w x
  · intro w
    exact sb_norm_boolean (e := e) v u b hbO α hmem halt w
  · -- periodicAlong p of nrm w from α's p-periodicity
    have hper : ∀ w : Fin K, periodicAlong p (coord α w) := fun w => (hα.1 w).1
    intro w
    exact sb_norm_periodic u b α w p (hper w)
  · have hper : ∀ w : Fin K, periodicAlong q (coord α w) := fun w => (hα.1 w).2.1
    intro w
    exact sb_norm_periodic u b α w q (hper w)


/-! ## Reflection and the symmetric boolean constraint `P_Ω`

The reflection maps on `{0,1}`-valued functions make the choice of normalization
harmless when `Ω` is symmetric: another normalization differs by the simultaneous
reflection `(u, b, nrm) ↦ (u + b, -b, 1 - nrm)`.  The property `P_Ω` is defined via a
witness normalization. -/

/-! ## Reflection and the symmetric boolean constraint `P_Ω`

The reflection maps on `{0,1}`-valued functions make the choice of normalization
harmless when `Ω` is symmetric: another normalization differs by the simultaneous
reflection `(u, b, nrm) ↦ (u + b, -b, 1 - nrm)`.  The property `P_Ω` is defined via a
witness normalization. -/

/-- The reflection `R_a` on values (`a ∈ {0,1}`): `R_0(y) = y`, `R_1(y) = 1 - y`; only
used at `a = 0, 1`. -/
def sb_reflect {Z : Type*} [AddCommGroup Z] (a : Z) (f : G → Z) (x : G) : Z :=
  a + (if a = 0 then f x else -f x)

/-- `R_0` is the identity. -/
lemma sb_reflect_zero {Z : Type*} [AddCommGroup Z] (f : G → Z) :
    (fun x : G => sb_reflect (0 : Z) f x) = f := by
  funext x
  simp [sb_reflect]

/-- `R_1` is an involution. -/
lemma sb_reflect_one_invol {e : ℕ} (f : G → ZMod (2 ^ (e + 1))) :
    (fun x : G => sb_reflect (1 : ZMod (2 ^ (e + 1))) (fun x : G => sb_reflect (1 : ZMod (2 ^ (e + 1))) f x) x) = f := by
  funext x
  simp [sb_reflect, one_ne_zero_zmod e]

/-- The value set of `R_a` applied to a `{0,1}`-valued function stays `{0,1}` (used at
`a = 0,1`).  For `a = 0` trivial; for `a = 1`, `1 - y ∈ {0,1}` when `y ∈ {0,1}`. -/
lemma sb_reflect_mem {e : ℕ} (a y : ZMod (2 ^ (e + 1))) (ha : a = 0 ∨ a = 1)
    (hy : y = 0 ∨ y = 1) : sb_reflect a (fun _ : G => y) (0 : G) = 0 ∨
      sb_reflect a (fun _ : G => y) (0 : G) = 1 := by
  rcases ha with ha0 | ha1
  · rcases hy with hy0 | hy1
    · left
      simp [sb_reflect, ha0, hy0]
    · right
      simp [sb_reflect, ha0, hy1]
  · rcases hy with hy0 | hy1
    · right
      simp [sb_reflect, ha1, hy0, one_ne_zero_zmod e]
    · left
      simp [sb_reflect, ha1, hy1, one_ne_zero_zmod e]

/-- Whether a tuple of `{0,1}`-valued functions obeys the symmetric boolean constraint
`Ω` under the chosen normalization (a witness-form of `P_Ω`). -/
def sb_POmega {e K : ℕ} (v p q : G) (Ω : Set (Fin K → ZMod (2 ^ (e + 1))))
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) : Prop :=
  CompBool e v p q α ∧
    ∃ (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
      (nrm : Fin K → G → ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w : Fin K, ∀ x : G, α x w = u w + b * nrm w x) ∧
      (∀ w : Fin K, ∀ x : G, nrm w x = 0 ∨ nrm w x = 1) ∧
      (∀ x : G, (fun w : Fin K => nrm w x) ∈ Ω)


/-! ## Uniqueness of the normalization up to the global reflection

Any two normalizations `α = u + b·nrm = u' + b'·nrm'` (with `b, b'` odd and `nrm, nrm'`
`{0,1}`-valued) of the same compatible boolean tuple differ by the *global* reflection:
either `(u', b', nrm') = (u, b, nrm)` or `(u', b', nrm') = (u + b, -b, 1 - nrm)`
(i.e. `nrm' = R_1 ∘ nrm`).  This is the reflection ambiguity of the paper's
\eqref{alphai}; since `Ω` is reflection-symmetric, the constraint `P_Ω` does not depend
on the normalization chosen. -/

/-- An odd element has `2z ≠ 0` (so `z ≠ -z`) when `e ≥ 1`. -/
lemma sb_two_mul_ne_zero {e : ℕ} (he : 1 ≤ e) {z : ZMod (2 ^ (e + 1))}
    (hz : z ∉ evenSub e) : (2 : ZMod (2 ^ (e + 1))) * z ≠ 0 := by
  intro h20
  apply hz
  apply (parityIn_zero_iff_even e z).mp
  rw [mef_parity_val e z]
  have hzn : z = ((z.val : ℕ) : ZMod (2 ^ (e + 1))) := (ZMod.natCast_zmod_val z).symm
  have h20' : (2 : ZMod (2 ^ (e + 1))) * ((z.val : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by
    rw [hzn] at h20
    exact h20
  have h20'' : (((2 * z.val : ℕ) : ZMod (2 ^ (e + 1)))) = 0 := by
    simpa [Nat.cast_mul, Nat.cast_ofNat] using h20'
  have hdiv : 2 ^ (e + 1) ∣ 2 * z.val :=
    (ZMod.natCast_eq_zero_iff (2 * z.val) (2 ^ (e + 1))).mp h20''
  rcases hdiv with ⟨k, hk⟩
  -- e+1 = (e-1)+2, so 2^(e+1) = 4 * 2^(e-1); 2*z.val = 4*X → z.val = 2*X
  let X : ℕ := 2 ^ (e - 1) * k
  have hpow : 2 ^ (e + 1) = 4 * 2 ^ (e - 1) := by
    have hsub : e + 1 = (e - 1) + 2 := by omega
    rw [hsub, pow_add]
    norm_num
    ring
  have hzEven : z.val = 2 * X := by
    apply Nat.mul_left_cancel (by norm_num : 0 < 2)
    calc
      2 * z.val = 2 ^ (e + 1) * k := hk
      _ = (4 * 2 ^ (e - 1)) * k := by rw [hpow]
      _ = 2 * (2 * (2 ^ (e - 1) * k)) := by ring
  have htwo : ((z.val : ℕ) : ZMod 2) = 0 := by
    rw [hzEven]
    rw [Nat.cast_mul]
    rw [ZMod.natCast_self 2]
    simp
  exact htwo

/-- The dichotomy of two-value-pair equalities: from `{u,u+b} = {u',u'+b'}` with
`b' ≠ 0` one gets `(u', b') = (u, b)` or `(u', b') = (u + b, -b)`. -/
lemma sb_pair_dichotomy {e : ℕ} (u u' b b' : ZMod (2 ^ (e + 1)))
    (hb' : b' ≠ 0)
    (hmem_u : u' = u ∨ u' = u + b)
    (hmem_ub : u' + b' = u ∨ u' + b' = u + b)
    (hne : u' + b' ≠ u') :
    (u' = u ∧ b' = b) ∨ (u' = u + b ∧ b' = -b) := by
  rcases hmem_u with hu0 | hu1
  · left
    constructor
    · exact hu0
    · rcases hmem_ub with hm0 | hm1
      · exfalso
        apply hne
        exact hm0.trans hu0.symm
      · have hm1' : u + b' = u + b := by simpa [hu0] using hm1
        have hb'eq : b' = b := by
          calc
            b' = (u + b') - u := by ring
            _ = (u + b) - u := by rw [hm1']
            _ = b := by ring
        exact hb'eq
  · right
    constructor
    · exact hu1
    · rcases hmem_ub with hm0 | hm1
      · have hm0' : (u + b) + b' = u := by simpa [hu1] using hm0
        have hb'eq : b' = -b := by
          calc
            b' = ((u + b) + b') - (u + b) := by ring
            _ = u - (u + b) := by rw [hm0']
            _ = -b := by ring
        exact hb'eq
      · exfalso
        apply hne
        exact hm1.trans hu1.symm

/-- Two normalizations of the same compatible boolean tuple differ by the global
reflection: either `(u', b', nrm') = (u, b, nrm)` (mode `δ = 0`) or
`u' w = u w + b`, `b' = -b`, `nrm' = 1 - nrm` for every coordinate (mode `δ = 1`). -/
lemma compbool_normalize_unique {e : ℕ} (he : 1 ≤ e) (v p q : G) {K : ℕ} (w₀ : Fin K)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α)
    (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hu : ∀ w : Fin K, ∀ x : G, α x w = u w + b * nrm w x)
    (hb : b ∉ evenSub e)
    (hnrm : ∀ w : Fin K, ∀ x : G, nrm w x = 0 ∨ nrm w x = 1)
    (u' : Fin K → ZMod (2 ^ (e + 1))) (b' : ZMod (2 ^ (e + 1)))
    (nrm' : Fin K → G → ZMod (2 ^ (e + 1)))
    (hu' : ∀ w : Fin K, ∀ x : G, α x w = u' w + b' * nrm' w x)
    (hb' : b' ∉ evenSub e)
    (hnrm' : ∀ w : Fin K, ∀ x : G, nrm' w x = 0 ∨ nrm' w x = 1) :
    ((∀ w : Fin K, u' w = u w) ∧ b' = b ∧ (∀ w x, nrm' w x = nrm w x)) ∨
    ((∀ w : Fin K, u' w = u w + b) ∧ b' = -b ∧ (∀ w x, nrm' w x = 1 - nrm w x)) := by
  classical
  let Z := ZMod (2 ^ (e + 1))
  have hb0 : b ≠ 0 := sb_odd_ne_zero hb
  have hb'0 : b' ≠ 0 := sb_odd_ne_zero hb'
  -- per-coordinate dichotomy
  have hdi : ∀ w : Fin K, (u' w = u w ∧ b' = b) ∨ (u' w = u w + b ∧ b' = -b) := by
    intro w
    rcases hα.1 w with ⟨_hpw, _hqw, hbw⟩
    rcases hbw with ⟨aw, bw, hEw, hOw, hvalsw, hsww⟩
    have hAw_ne : aw ≠ bw := by
      intro h
      apply hOw
      simpa [h] using hEw
    have hrw : Set.range (coord α w) = ({aw, bw} : Set Z) :=
      range_eq_pair e v (coord α w) aw bw hvalsw hsww
    -- aw, bw are values of coord α w, and hence lie in the two value sets
    have hawU : aw = u w ∨ aw = u w + b := by
      have hm : aw ∈ Set.range (coord α w) := by rw [hrw]; simp
      rcases hm with ⟨x, rfl⟩
      rcases hnrm w x with hn0 | hn1
      · left
        change α x w = u w
        rw [hu w x, hn0]
        simp
      · right
        change α x w = u w + b
        rw [hu w x, hn1]
        ring
    have hbwU : bw = u w ∨ bw = u w + b := by
      have hm : bw ∈ Set.range (coord α w) := by rw [hrw]; simp
      rcases hm with ⟨x, rfl⟩
      rcases hnrm w x with hn0 | hn1
      · left
        change α x w = u w
        rw [hu w x, hn0]
        simp
      · right
        change α x w = u w + b
        rw [hu w x, hn1]
        ring
    have hawU' : aw = u' w ∨ aw = u' w + b' := by
      have hm : aw ∈ Set.range (coord α w) := by rw [hrw]; simp
      rcases hm with ⟨x, rfl⟩
      rcases hnrm' w x with hn0 | hn1
      · left
        change α x w = u' w
        rw [hu' w x, hn0]
        simp
      · right
        change α x w = u' w + b'
        rw [hu' w x, hn1]
        ring
    have hbwU' : bw = u' w ∨ bw = u' w + b' := by
      have hm : bw ∈ Set.range (coord α w) := by rw [hrw]; simp
      rcases hm with ⟨x, rfl⟩
      rcases hnrm' w x with hn0 | hn1
      · left
        change α x w = u' w
        rw [hu' w x, hn0]
        simp
      · right
        change α x w = u' w + b'
        rw [hu' w x, hn1]
        ring
    -- the primed value set is exactly {aw, bw} (in some order)
    have hcaseU' : (aw = u' w ∧ bw = u' w + b') ∨ (aw = u' w + b' ∧ bw = u' w) := by
      rcases hawU' with ha0 | ha1 <;> rcases hbwU' with hb0 | hb1
      · exfalso
        apply hAw_ne
        exact ha0.trans hb0.symm
      · exact Or.inl ⟨ha0, hb1⟩
      · exact Or.inr ⟨ha1, hb0⟩
      · exfalso
        apply hAw_ne
        exact ha1.trans hb1.symm
    -- membership of u' w, u' w + b' in {u w, u w + b}
    have hmem_u' : u' w = u w ∨ u' w = u w + b := by
      rcases hcaseU' with hc | hc
      · rw [← hc.1]
        exact hawU
      · rw [← hc.2]
        exact hbwU
    have hmem_ub : u' w + b' = u w ∨ u' w + b' = u w + b := by
      rcases hcaseU' with hc | hc
      · rw [← hc.2]
        exact hbwU
      · rw [← hc.1]
        exact hawU
    have hne : u' w + b' ≠ u' w := by
      intro hc
      apply hb'0
      have := congrArg (fun z : Z => z - u' w) hc
      calc
        b' = (u' w + b') - u' w := by ring
        _ = u' w - u' w := this
        _ = 0 := by ring
    exact sb_pair_dichotomy (u w) (u' w) b b' hb'0 hmem_u' hmem_ub hne
  -- decide the global mode from the reference coordinate w₀
  by_cases hbEq : b' = b
  · -- mode δ = 0
    have hu_eq : ∀ w : Fin K, u' w = u w := by
      intro w
      rcases hdi w with hd | hd
      · exact hd.1
      · exfalso
        -- hd : u' w = u w + b ∧ b' = -b; with b' = b: b = -b, contradicting 2b ≠ 0
        apply sb_two_mul_ne_zero he hb
        have hbb : b = -b := (hd.2.symm.trans hbEq).symm
        have hsum : b + b = 0 := by
          have hc := congrArg (fun z : Z => z + b) hbb
          rw [hc]
          ring
        simpa [two_mul] using hsum
    have hnm : ∀ w x, nrm' w x = nrm w x := by
      intro w x
      -- cancel the unit b from b·nrm = b·nrm'
      have hbuni : IsUnit b := mef_IsUnit_of_not_evenSub hb
      have hc : b * nrm w x = b * nrm' w x := by
        have h1 := hu w x
        have h2 := hu' w x
        rw [hu_eq w, hbEq] at h2
        have hEq : u w + b * nrm w x = u w + b * nrm' w x := h1.symm.trans h2
        have hEq' := congrArg (fun z : Z => z - u w) hEq
        calc
          b * nrm w x = (u w + b * nrm w x) - u w := by ring
          _ = (u w + b * nrm' w x) - u w := hEq'
          _ = b * nrm' w x := by ring
      exact (hbuni.mul_left_cancel hc).symm
    left
    exact ⟨hu_eq, hbEq, hnm⟩
  · -- mode δ = 1
    have hb'neg : b' = -b := by
      rcases hdi w₀ with hd | hd
      · exfalso
        exact hbEq hd.2
      · exact hd.2
    have hu_eq_all : ∀ w : Fin K, u' w = u w + b := by
      intro w
      rcases hdi w with hd | hd
      · exfalso
        -- hd : u' w = u w ∧ b' = b; with b' = -b: b = -b → 2b = 0
        apply sb_two_mul_ne_zero he hb
        have hbb : b = -b := hd.2.symm.trans hb'neg
        have hsum : b + b = 0 := by
          have hc := congrArg (fun z : Z => z + b) hbb
          rw [hc]
          ring
        simpa [two_mul] using hsum
      · exact hd.1
    have hnm : ∀ w x, nrm' w x = 1 - nrm w x := by
      intro w x
      -- from the value equations and u' w = u w + b, b' = -b:
      --   b·nrm + b·nrm' = b, so (unit b) nrm + nrm' = 1, hence nrm' = 1 - nrm
      have hbuni : IsUnit b := mef_IsUnit_of_not_evenSub hb
      have h1 := hu w x
      have h2 := hu' w x
      rw [hu_eq_all w, hb'neg] at h2
      have hEq : u w + b * nrm w x = (u w + b) + (-b) * nrm' w x := h1.symm.trans h2
      have hEq' := congrArg (fun z : Z => z - u w) hEq
      have hsum : b * nrm w x + b * nrm' w x = b := by
        have hsum' : b * nrm w x = b + (-b) * nrm' w x := by
          calc
            b * nrm w x = (u w + b * nrm w x) - u w := by ring
            _ = ((u w + b) + (-b) * nrm' w x) - u w := hEq'
            _ = b + (-b) * nrm' w x := by ring
        rw [hsum']
        ring
      have hdist : b * (nrm w x + nrm' w x) = b * 1 := by
        rw [mul_add, mul_one]
        exact hsum
      have hsum1 : nrm w x + nrm' w x = 1 := hbuni.mul_left_cancel hdist
      calc
        nrm' w x = (nrm w x + nrm' w x) - nrm w x := by ring
        _ = 1 - nrm w x := by rw [hsum1]
    right
    exact ⟨hu_eq_all, hb'neg, hnm⟩

/-! ## Reflection symmetry makes `P_Ω` independent of the chosen normalization

When `Ω` is invariant under the global reflection `t ↦ (1 - t_w)_w`, the
`Ω`-constraint holds for one witness normalization iff it holds for any other: the two
witnesses differ by the mode-0 identity or the mode-1 global reflection
(`nrm' = 1 - nrm`), and `Ω` is closed under that reflection. -/

/-- `Ω ⊆ (ZMod (2^(e+1)))^K` is invariant under the global reflection `t ↦ 1 - t`. -/
def sb_ΩSym {e K : ℕ} (Ω : Set (Fin K → ZMod (2 ^ (e + 1)))) : Prop :=
  ∀ t : Fin K → ZMod (2 ^ (e + 1)), t ∈ Ω ↔ (fun w : Fin K => 1 - t w) ∈ Ω

/-- If the `Ω`-constraint holds for one witness normalization of a compatible tuple then
it holds for any other witness normalization (provided `Ω` is reflection-symmetric). -/
lemma sb_Omega_witness_independent {e : ℕ} (he : 1 ≤ e) (v p q : G) {K : ℕ} (w₀ : Fin K)
    (Ω : Set (Fin K → ZMod (2 ^ (e + 1)))) (hSym : sb_ΩSym Ω)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α)
    (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hu : ∀ w : Fin K, ∀ x : G, α x w = u w + b * nrm w x)
    (hb : b ∉ evenSub e)
    (hnrm : ∀ w : Fin K, ∀ x : G, nrm w x = 0 ∨ nrm w x = 1)
    (hΩ : ∀ x : G, (fun w : Fin K => nrm w x) ∈ Ω)
    (u' : Fin K → ZMod (2 ^ (e + 1))) (b' : ZMod (2 ^ (e + 1)))
    (nrm' : Fin K → G → ZMod (2 ^ (e + 1)))
    (hu' : ∀ w : Fin K, ∀ x : G, α x w = u' w + b' * nrm' w x)
    (hb' : b' ∉ evenSub e)
    (hnrm' : ∀ w : Fin K, ∀ x : G, nrm' w x = 0 ∨ nrm' w x = 1) :
    ∀ x : G, (fun w : Fin K => nrm' w x) ∈ Ω := by
  intro x
  rcases compbool_normalize_unique he v p q w₀ α hα u b nrm hu hb hnrm u' b' nrm' hu' hb' hnrm'
    with hm0 | hm1
  · rcases hm0 with ⟨_hu_eq, _hb_eq, hnm⟩
    have htuple : (fun w : Fin K => nrm' w x) = (fun w : Fin K => nrm w x) := by
      funext w
      exact hnm w x
    rw [htuple]
    exact hΩ x
  · rcases hm1 with ⟨_hu_eq, _hb_eq, hnm⟩
    have htuple : (fun w : Fin K => nrm' w x) = (fun w : Fin K => 1 - nrm w x) := by
      funext w
      exact hnm w x
    have hΩr : (fun w : Fin K => 1 - nrm w x) ∈ Ω := (hSym (fun w : Fin K => nrm w x)).mp (hΩ x)
    rw [htuple]
    exact hΩr



/-! ## The single-pair `Ω` and reflection values

For the reduction to `Ω = {0,1}^K ∖ {ε, 1−ε}` (a reflection-symmetric set), the
membership `(nrm x) ∈ Ω` means: the normalized tuple takes `{0,1}` values and differs
from `ε` and `1−ε`.  The reflection maps satisfy `R_ε(0) = ε`, `R_ε(1) = 1−ε`, and
`R_ε(R_ε(y)) = y` for `ε, y ∈ {0,1}`, so the reflected tuple `γ = R_ε(nrm x)` avoids the
constant tuples exactly when `nrm x` avoids `ε` and `1−ε`. -/

/-- The single-pair symmetric constraint set `{0,1}^K ∖ {ε, 1−ε}`. -/
def sb_OmegaPair {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1))) : Set (Fin K → ZMod (2 ^ (e + 1))) :=
  {t : Fin K → ZMod (2 ^ (e + 1)) |
    (∀ i : Fin K, t i = 0 ∨ t i = 1) ∧
    ¬ (∀ i : Fin K, t i = ε i) ∧
    ¬ (∀ i : Fin K, t i = 1 - ε i)}

/-- `R_ε(0) = ε` for `ε ∈ {0,1}`. -/
lemma sb_reflect_val_zero {e : ℕ} (ε : ZMod (2 ^ (e + 1))) (hε : ε = 0 ∨ ε = 1) :
    sb_reflect ε (fun _ : G => (0 : ZMod (2 ^ (e + 1)))) (0 : G) = ε := by
  rcases hε with h0 | h1
  · simp [sb_reflect, h0]
  · have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
    simp [sb_reflect, h1, h10]

/-- `R_ε(1) = 1 − ε` for `ε ∈ {0,1}`. -/
lemma sb_reflect_val_one {e : ℕ} (ε : ZMod (2 ^ (e + 1))) (hε : ε = 0 ∨ ε = 1) :
    sb_reflect ε (fun _ : G => (1 : ZMod (2 ^ (e + 1)))) (0 : G) = 1 - ε := by
  rcases hε with h0 | h1
  · simp [sb_reflect, h0]
  · have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
    simp [sb_reflect, h1, h10]

/-- `R_ε` is an involution on `{0,1}`. -/
lemma sb_reflect_invol_val {e : ℕ} (ε y : ZMod (2 ^ (e + 1))) (hε : ε = 0 ∨ ε = 1)
    (hy : y = 0 ∨ y = 1) :
    sb_reflect ε (fun _ : G => sb_reflect ε (fun _ : G => y) (0 : G)) (0 : G) = y := by
  rcases hε with h0 | h1
  · rcases hy with y0 | y1
    · simp [sb_reflect, h0, y0]
    · simp [sb_reflect, h0, y1]
  · have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
    rcases hy with y0 | y1
    · simp [sb_reflect, h1, h10, y0]
    · simp [sb_reflect, h1, h10, y1]


end
end Commons.PeriodicTiling

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! # The level function of a symmetric boolean constraint (Proposition sym-bool)

Let `α` obey `P_Ω` for the single-pair set `Ω = {0,1}^W ∖ {ε, 1−ε}`, normalized as
`α_i = u_i + b·ñ_i` with `(e,{0,1})`-boolean, `⟨p,q⟩`-periodic `ñ_i`.  Writing
`γ_i := R_{ε_i}(ñ_i)` (the reflection that makes the `Ω`-constraint read "γ(x) avoids the
two constant tuples"), the tuple `γ(x)` takes values in `{0,1}^K` avoiding `0`- and
`1`-vectors, so the *level* `f(x) := #{i : γ_i(x) = 1}` lies in `{1,…,K−1}`.  Each
`γ_i` remains `(v,{0,1})`-boolean and `⟨p,q⟩`-periodic, hence
`f(x+v) = K − f(x)` and `f` is `⟨p,q⟩`-periodic.  These are the properties feeding the
β-decomposition of `P*_Ω` (paper tex 887-928). -/

/-- The reflected boolean coordinate `R_{ε_i}(ñ_i)`. -/
def sb_reflFun {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G) : ZMod (2 ^ (e + 1)) :=
  sb_reflect (ε i) (fun y : G => nrm i y) x

/-- The number of `1`s among the coordinates of a tuple of `{0,1}`-valued elements. -/
def sb_levelTuple {e K : ℕ} (t : Fin K → ZMod (2 ^ (e + 1))) : ℕ :=
  (Finset.univ.filter (fun i : Fin K => t i = 1)).card

/-- For a `{0,1}`-valued tuple the set of `0`s is the complement of the set of `1`s. -/
lemma sb_ones_compl {e K : ℕ} (t : Fin K → ZMod (2 ^ (e + 1)))
    (hvals : ∀ i : Fin K, t i = 0 ∨ t i = 1) :
    (Finset.univ.filter (fun i : Fin K => t i = 0)) =
      (Finset.univ.filter (fun i : Fin K => t i = 1))ᶜ := by
  classical
  ext i
  simp
  constructor
  · intro h0 hti
    have h01 : (0 : ZMod (2 ^ (e + 1))) ≠ 1 := by exact (one_ne_zero_zmod e).symm
    exact h01 (h0.symm.trans hti)
  · intro hnot
    rcases hvals i with h0 | h1
    · exact h0
    · exfalso
      exact hnot h1

/-- The reflected tuple `1 − t` has `K − f(t)` ones. -/
lemma sb_levelTuple_reflect {e K : ℕ} (t : Fin K → ZMod (2 ^ (e + 1)))
    (hvals : ∀ i : Fin K, t i = 0 ∨ t i = 1) :
    sb_levelTuple (fun i : Fin K => 1 - t i) = K - sb_levelTuple t := by
  classical
  dsimp [sb_levelTuple]
  have hone : (Finset.univ.filter (fun i : Fin K => 1 - t i = 1)) =
      (Finset.univ.filter (fun i : Fin K => t i = 1))ᶜ := by
    ext i
    simp
    constructor
    · intro h hti
      rw [hti] at h
      exact (one_ne_zero_zmod e) (by simpa [eq_comm] using h)
    · intro hnot
      rcases hvals i with h0 | h1
      · rw [h0]
      · exfalso
        exact hnot h1
  rw [hone]
  rw [Finset.card_compl]
  simp

/-- The number of `1`s of a `{0,1}`-valued `K`-tuple avoiding the two constant tuples
lies in `{1, …, K-1}`. -/
lemma sb_levelTuple_mem {e K : ℕ} (hK : 1 ≤ K) (t : Fin K → ZMod (2 ^ (e + 1)))
    (hvals : ∀ i : Fin K, t i = 0 ∨ t i = 1)
    (hnot0 : ¬ (∀ i : Fin K, t i = 0)) (hnot1 : ¬ (∀ i : Fin K, t i = 1)) :
    1 ≤ sb_levelTuple t ∧ sb_levelTuple t ≤ K - 1 := by
  classical
  dsimp [sb_levelTuple]
  let ones : Finset (Fin K) := Finset.univ.filter (fun i : Fin K => t i = 1)
  have hone_pos : 1 ≤ ones.card := by
    have hex : ∃ i : Fin K, t i ≠ 0 := by
      push_neg at hnot0
      exact hnot0
    rcases hex with ⟨i, hne0⟩
    rcases hvals i with h0 | h1
    · exfalso
      exact hne0 h0
    · have hi : i ∈ ones := by simp [ones, h1]
      have hpos : 0 < ones.card := Finset.card_pos.mpr ⟨i, hi⟩
      omega
  have hle1 : ones.card ≤ K - 1 := by
    let zeros : Finset (Fin K) := Finset.univ.filter (fun i : Fin K => t i = 0)
    have hzpos : 1 ≤ zeros.card := by
      have hex : ∃ i : Fin K, t i ≠ 1 := by
        push_neg at hnot1
        exact hnot1
      rcases hex with ⟨i, hne1⟩
      rcases hvals i with h0 | h1
      · have hi : i ∈ zeros := by simp [zeros, h0]
        have hpos : 0 < zeros.card := Finset.card_pos.mpr ⟨i, hi⟩
        omega
      · exfalso
        exact hne1 h1
    have hzcompl : zeros = onesᶜ := by
      dsimp [zeros, ones]
      exact sb_ones_compl t hvals
    have hcard : zeros.card = K - ones.card := by
      rw [hzcompl]
      have hc := Finset.card_compl ones
      simpa using hc
    rw [hcard] at hzpos
    omega
  constructor
  · simpa [ones] using hone_pos
  · simpa [ones] using hle1

/-! ## The level of a reflected compatible boolean tuple

For functions `ñ_i` and reflection choices `ε_i ∈ {0,1}`, the tuple
`γ_i(x) := R_{ε_i}(ñ_i(x))` stays `{0,1}`-valued when `ñ_i(x)` is, and alternates
(`γ_i(x+v) = 1 - γ_i(x)`) when `ñ_i` does.  The level `f(x) := sb_level ε nrm x` then
enjoys: `f(x) ∈ {1,…,K−1}` (under cube avoidance), `f` is periodic along any direction
along which all `γ_i` are, and `f(x+v) = K − f(x)` under the alternation. -/

/-- The level of the reflected tuple at `x`: the number of coordinates of `γ(x)` equal
to `1`. -/
def sb_level {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (x : G) : ℕ :=
  sb_levelTuple (fun i : Fin K => sb_reflFun ε nrm i x)

/-- If `ñ` alternates along `v` with the pair `{0,1}` and the reflections are `{0,1}`,
then the reflected functions alternate the same way. -/
lemma sb_reflFun_alternate {e K : ℕ} (v : G) (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hnv : ∀ i : Fin K, ∀ x : G, nrm i (x + v) = 1 - nrm i x) :
    ∀ i : Fin K, ∀ x : G,
      sb_reflFun ε nrm i (x + v) = 1 - sb_reflFun ε nrm i x := by
  intro i x
  rcases hε i with h0 | h1
  · have hg1 : sb_reflFun ε nrm i (x + v) = nrm i (x + v) := by
      simp [sb_reflFun, h0, sb_reflect]
    have hg2 : 1 - sb_reflFun ε nrm i x = 1 - nrm i x := by
      simp [sb_reflFun, h0, sb_reflect]
    rw [hg1, hg2]
    exact hnv i x
  · have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
    have hg1 : sb_reflFun ε nrm i (x + v) = 1 - nrm i (x + v) := by
      simp [sb_reflFun, h1, sb_reflect, h10]
      ring
    have hg2 : 1 - sb_reflFun ε nrm i x = nrm i x := by
      simp [sb_reflFun, h1, sb_reflect, h10]
    rw [hg1, hg2]
    rw [hnv i x]
    ring

/-- The level of a `{0,1}`-valued reflected tuple avoiding the constant tuples lies in
`{1, …, K-1}` (the theorem-header membership claim for `f`). -/
lemma sb_level_mem {e K : ℕ} (hK : 1 ≤ K) (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (x : G)
    (hnrm : ∀ i : Fin K, nrm i x = 0 ∨ nrm i x = 1)
    (hnot0 : ¬ (∀ i : Fin K, sb_reflFun ε nrm i x = 0))
    (hnot1 : ¬ (∀ i : Fin K, sb_reflFun ε nrm i x = 1)) :
    1 ≤ sb_level ε nrm x ∧ sb_level ε nrm x ≤ K - 1 := by
  have hvals : ∀ i : Fin K, sb_reflFun ε nrm i x = 0 ∨ sb_reflFun ε nrm i x = 1 := by
    intro i
    rcases hε i with h0 | h1
    · rcases hnrm i with y0 | y1
      · left
        simp [sb_reflFun, h0, sb_reflect, y0]
      · right
        simp [sb_reflFun, h0, sb_reflect, y1]
    · rcases hnrm i with y0 | y1
      · right
        simp [sb_reflFun, h1, sb_reflect, one_ne_zero_zmod e, y0]
      · left
        simp [sb_reflFun, h1, sb_reflect, one_ne_zero_zmod e, y1]
  dsimp [sb_level]
  exact sb_levelTuple_mem hK (fun i : Fin K => sb_reflFun ε nrm i x) hvals hnot0 hnot1

/-- The level is periodic along any direction along which all reflected functions are. -/
lemma sb_level_periodic {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (u0 : G)
    (hper : ∀ i : Fin K, periodicAlong u0 (fun x : G => sb_reflFun ε nrm i x)) :
    periodicAlong u0 (fun x : G => sb_level ε nrm x) := by
  intro x
  dsimp [sb_level]
  have htuple : (fun i : Fin K => sb_reflFun ε nrm i (x + u0)) =
      (fun i : Fin K => sb_reflFun ε nrm i x) := by
    funext i
    exact hper i x
  exact congrArg sb_levelTuple htuple

/-- The level alternates: `f(x + v) = K − f(x)` when each reflected function does. -/
lemma sb_level_alternate {e K : ℕ} (v : G) (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hγv : ∀ i : Fin K, ∀ x : G,
      sb_reflFun ε nrm i (x + v) = 1 - sb_reflFun ε nrm i x)
    (hvals : ∀ i : Fin K, ∀ x : G,
      sb_reflFun ε nrm i x = 0 ∨ sb_reflFun ε nrm i x = 1)
    (x : G) : sb_level ε nrm (x + v) = K - sb_level ε nrm x := by
  dsimp [sb_level]
  have htuple : (fun i : Fin K => sb_reflFun ε nrm i (x + v)) =
      (fun i : Fin K => 1 - sb_reflFun ε nrm i x) := by
    funext i
    exact hγv i x
  rw [htuple]
  exact sb_levelTuple_reflect (fun i : Fin K => sb_reflFun ε nrm i x) (fun i => hvals i x)


/-! ## The β decomposition of the level

For odd `W = 2n+1 ≥ 3` (the paper first reduces to odd `W`) and a level value
`k = f(x) ∈ {1,…,2n}`, the `2n−1` Boolean helpers `β_j(x) := b·g_j(k)`
(`j = 1,…,2n−1`) have the indicator
`g_j(k) := 1_{j < k}` if `k ≤ n`, and `g_j(k) := 1_{2n+1−k ≤ j}` if `k > n`.  They
satisfy the pointwise identities `Σ_j β_j(x) = b·(f(x)−1)` and the alternation
`β_j(x+v) = b − β_j(x)` coming from `f(x+v) = (2n+1) − f(x)` (so each `β_j` is
`(v,{0,b})`-boolean), and are `⟨p,q⟩`-periodic with `f`. -/

/-- The level indicator: `g_j(k)` for odd level-width `2n+1`. -/
def sb_ind (n k j : ℕ) : ℕ :=
  if k ≤ n then (if j < k then 1 else 0) else (if 2 * n + 1 - k ≤ j then 1 else 0)

/-- The level indicator takes only the values `0, 1`. -/
lemma sb_ind_mem (n k j : ℕ) : sb_ind n k j = 0 ∨ sb_ind n k j = 1 := by
  by_cases hk : k ≤ n
  · by_cases hj : j < k
    · right
      simp [sb_ind, hk, hj]
    · left
      simp [sb_ind, hk, hj]
  · by_cases hj : 2 * n + 1 - k ≤ j
    · right
      simp [sb_ind, hk, hj]
    · left
      simp [sb_ind, hk, hj]

/-- The indicator-sum over the `2n−1` levels equals `k−1` (from the commons lemma). -/
lemma sb_ind_sum {n : ℕ} (hn : 1 ≤ n) :
    ∀ k : ℕ, 1 ≤ k → k ≤ 2 * n →
      (∑ j ∈ Finset.Icc 1 (2 * n - 1), sb_ind n k j) = k - 1 := by
  intro k hk1 hk2
  dsimp [sb_ind]
  exact Commons.Nat.Icc.levelIndicator_sum (n := n) hn k hk1 hk2

/-- The indicator flips under `k ↦ 2n+1−k` (from the commons lemma). -/
lemma sb_ind_flip {n j k : ℕ} (hn : 1 ≤ n) (hj1 : 1 ≤ j) (hj2 : j ≤ 2 * n - 1)
    (hk1 : 1 ≤ k) (hk2 : k ≤ 2 * n) :
    sb_ind n (2 * n + 1 - k) j = 1 - sb_ind n k j := by
  dsimp [sb_ind]
  simpa using (Commons.Nat.Icc.levelIndicator_flip (n := n) (j := j) (k := k) hn hj1 hj2 hk1 hk2)

/-- A `Fin m`-indexed sum in 1-based indices equals the sum over `Icc 1 m`. -/
lemma sum_fin_add_one {R : Type*} [AddCommMonoid R] {m : ℕ} (F : ℕ → R) :
    (∑ t : Fin m, F (t.val + 1)) = ∑ j ∈ Finset.Icc 1 m, F j := by
  classical
  refine Finset.sum_bij (s := (Finset.univ : Finset (Fin m))) (t := Finset.Icc 1 m)
    (f := fun t : Fin m => F (t.val + 1)) (g := F)
    (i := fun (a : Fin m) (_ : a ∈ (Finset.univ : Finset (Fin m))) => a.val + 1) ?_ ?_ ?_ ?_
  · intro a ha
    exact Finset.mem_Icc.mpr ⟨by omega, by
      have ht := a.isLt
      omega⟩
  · intro a₁ ha₁ a₂ ha₂ h
    apply Fin.ext
    change a₁.val + 1 = a₂.val + 1 at h
    omega
  · intro b hb
    have hb1 := (Finset.mem_Icc.mp hb).1
    have hbm := (Finset.mem_Icc.mp hb).2
    refine ⟨⟨b - 1, by omega⟩, by simp, ?_⟩
    change (⟨b - 1, by omega⟩ : Fin m).val + 1 = b
    simp
    omega
  · intro a ha
    rfl

/-! ## The β values and their pointwise identities -/

/-- The β-value at level `k`, index `j`: `b·g_j(k) ∈ {0, b}`. -/
def sb_betaVal {e n : ℕ} (b : ZMod (2 ^ (e + 1))) (k j : ℕ) : ZMod (2 ^ (e + 1)) :=
  b * ((sb_ind n k j : ℕ) : ZMod (2 ^ (e + 1)))

/-- The β-value takes only the two values `0` and `b`. -/
lemma sb_betaVal_mem {e n : ℕ} (b : ZMod (2 ^ (e + 1))) (k j : ℕ) :
    sb_betaVal (n := n) b k j = 0 ∨ sb_betaVal (n := n) b k j = b := by
  unfold sb_betaVal
  rcases sb_ind_mem n k j with h0 | h1
  · left
    rw [h0]
    simp
  · right
    rw [h1]
    simp

/-- The β-value flips under the level reflection: `β_j(2n+1−k) = b − β_j(k)`. -/
lemma sb_betaVal_flip {e n : ℕ} (b : ZMod (2 ^ (e + 1))) {k j : ℕ} (hn : 1 ≤ n)
    (hj1 : 1 ≤ j) (hj2 : j ≤ 2 * n - 1) (hk1 : 1 ≤ k) (hk2 : k ≤ 2 * n) :
    sb_betaVal (n := n) b (2 * n + 1 - k) j = b - sb_betaVal (n := n) b k j := by
  unfold sb_betaVal
  have hf := sb_ind_flip (n := n) (j := j) (k := k) hn hj1 hj2 hk1 hk2
  rcases sb_ind_mem n k j with h0 | h1
  · have h0' : sb_ind n (2 * n + 1 - k) j = 1 := by rw [hf, h0]
    rw [h0', h0]
    simp
  · have h1' : sb_ind n (2 * n + 1 - k) j = 0 := by rw [hf, h1]
    rw [h1', h1]
    simp

/-- The β-tuple (0-based `Fin (2n−1)` coordinates ↔ 1-based indices `j = t.val+1`). -/
def sb_betaTuple {e n : ℕ} (b : ZMod (2 ^ (e + 1))) (f : G → ℕ) (x : G) :
    Fin (2 * n - 1) → ZMod (2 ^ (e + 1)) :=
  fun t => sb_betaVal (n := n) b (f x) (t.val + 1)

/-- The pointwise sum of the β-tuple: `Σ_j β_j(x) = b·(f(x) − 1)`. -/
lemma sb_betaTuple_sum {e n : ℕ} (b : ZMod (2 ^ (e + 1))) {f : G → ℕ} {x : G}
    (hn : 1 ≤ n) (hf1 : 1 ≤ f x) (hf2 : f x ≤ 2 * n) :
    (∑ t : Fin (2 * n - 1), sb_betaTuple (n := n) b f x t) =
      b * (((f x - 1 : ℕ) : ZMod (2 ^ (e + 1)))) := by
  classical
  unfold sb_betaTuple
  rw [sum_fin_add_one (m := 2 * n - 1) (F := fun j : ℕ => sb_betaVal (n := n) b (f x) j)]
  simp only [sb_betaVal]
  rw [← Finset.mul_sum]
  rw [← Nat.cast_sum]
  have hnatsum : (∑ j ∈ Finset.Icc 1 (2 * n - 1), sb_ind n (f x) j) = f x - 1 :=
    sb_ind_sum hn (f x) hf1 hf2
  rw [hnatsum]

/-- Each β-coordinate flips under the level reflection (function form). -/
lemma sb_betaTuple_flip_fn {e n : ℕ} (v : G) (b : ZMod (2 ^ (e + 1)))
    {f : G → ℕ} (hn : 1 ≤ n) (t : Fin (2 * n - 1)) {x : G}
    (hf1 : 1 ≤ f x) (hf2 : f x ≤ 2 * n) (hfalt : f (x + v) = 2 * n + 1 - f x) :
    sb_betaTuple (n := n) b f (x + v) t = b - sb_betaTuple (n := n) b f x t := by
  dsimp [sb_betaTuple]
  rw [hfalt]
  exact sb_betaVal_flip (n := n) b (j := t.val + 1) (k := f x) hn (by omega) (by
    have ht := t.isLt
    omega) hf1 hf2

/-- Each β-coordinate is periodic along any direction along which `f` is. -/
lemma sb_betaTuple_periodic_fn {e n : ℕ} (b : ZMod (2 ^ (e + 1)))
    {f : G → ℕ} (u0 : G) (hper : periodicAlong u0 f) (t : Fin (2 * n - 1)) :
    periodicAlong u0 (fun x : G => sb_betaTuple (n := n) b f x t) := by
  intro x
  dsimp [sb_betaTuple]
  rw [hper x]

/-- Each β-coordinate is `(v,{0,b})`-boolean and alternates with the level. -/
lemma sb_betaTuple_boolean {e n : ℕ} (v : G) (b : ZMod (2 ^ (e + 1))) (hb : b ∉ evenSub e)
    {f : G → ℕ} (hn : 1 ≤ n)
    (hfval : ∀ x : G, 1 ≤ f x ∧ f x ≤ 2 * n)
    (hflip : ∀ x : G, f (x + v) = 2 * n + 1 - f x)
    (t : Fin (2 * n - 1)) :
    IsBooleanAlt e v (fun x : G => sb_betaTuple (n := n) b f x t) := by
  refine ⟨0, b, ?_, hb, ?_, ?_⟩
  · exact mef_zero_even e
  · intro x
    change sb_betaTuple (n := n) b f x t = 0 ∨ sb_betaTuple (n := n) b f x t = b
    dsimp [sb_betaTuple]
    exact sb_betaVal_mem (n := n) b (f x) (t.val + 1)
  · intro x
    change sb_betaTuple (n := n) b f (x + v) t = 0 + b - sb_betaTuple (n := n) b f x t
    rw [sb_betaTuple_flip_fn (n := n) (v := v) b (hn := hn) (t := t) (hf1 := (hfval x).1)
      (hf2 := (hfval x).2) (hfalt := hflip x)]
    ring
/-- A `(v,{a,b})`-boolean function with values in `{0,1}` is forced to have the pair
`{0,1}`: it alternates as `g(x+v) = 1 − g(x)`. -/
lemma sb_boolean_alt_of_mem01 {e : ℕ} (v : G) (g : G → ZMod (2 ^ (e + 1)))
    (hb : IsBooleanAlt e v g) (h01 : ∀ x : G, g x = 0 ∨ g x = 1) :
    ∀ x : G, g (x + v) = 1 - g x := by
  rcases hb with ⟨a, b, hE, hO, hvals, hswap⟩
  -- both a and b are values of g (at 0 or at v)
  have ha_val : a = g (0 : G) ∨ a = g v := by
    rcases hvals (0 : G) with h0a | h0b
    · left
      exact h0a.symm
    · right
      have hgv : g v = a := by
        have h1 := hswap (0 : G)
        rw [h0b] at h1
        have h1' : g (0 + v) = a + b - b := by simpa using h1
        rw [zero_add] at h1'
        calc
          g v = a + b - b := h1'
          _ = a := by ring
      exact hgv.symm
  have hb_val : b = g (0 : G) ∨ b = g v := by
    rcases hvals (0 : G) with h0a | h0b
    · right
      have hgv : g v = b := by
        have h1 := hswap (0 : G)
        rw [h0a] at h1
        have h1' : g (0 + v) = a + b - a := by simpa using h1
        rw [zero_add] at h1'
        calc
          g v = a + b - a := h1'
          _ = b := by ring
      exact hgv.symm
    · left
      exact h0b.symm
  have ha01 : a = 0 ∨ a = 1 := by
    rcases ha_val with hz | hzv
    · rcases h01 (0 : G) with h0 | h1
      · left
        exact hz.trans h0
      · right
        exact hz.trans h1
    · rcases h01 v with h0 | h1
      · left
        exact hzv.trans h0
      · right
        exact hzv.trans h1
  have hb01 : b = 0 ∨ b = 1 := by
    rcases hb_val with hz | hzv
    · rcases h01 (0 : G) with h0 | h1
      · left
        exact hz.trans h0
      · right
        exact hz.trans h1
    · rcases h01 v with h0 | h1
      · left
        exact hzv.trans h0
      · right
        exact hzv.trans h1
  -- even a = 0, odd b = 1
  have ha0 : a = 0 := by
    rcases ha01 with ha | h1
    · exact ha
    · exfalso
      have h1odd : (1 : ZMod (2 ^ (e + 1))) ∉ evenSub e :=
        (parityIn_one_iff_odd e (1 : ZMod (2 ^ (e + 1)))).mp (parityIn_one e)
      exact h1odd (by simpa [h1] using hE)
  have hb1 : b = 1 := by
    rcases hb01 with h0 | h1
    · exfalso
      exact hO (by simpa [h0] using (mef_zero_even e))
    · exact h1
  intro x
  have hx := hswap x
  rw [ha0, hb1] at hx
  simpa using hx

/-- Reflected functions `γ_i = R_{ε_i}(ñ_i)` alternate when each `ñ_i` is
`(v,{0,1})`-boolean (alternation + values in `{0,1}`) and `ε_i ∈ {0,1}`. -/
lemma sb_gamma_alternate {e K : ℕ} (v : G) (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hbool : ∀ i : Fin K, IsBooleanAlt e v (fun x : G => nrm i x))
    (h01 : ∀ i : Fin K, ∀ x : G, nrm i x = 0 ∨ nrm i x = 1) :
    ∀ i : Fin K, ∀ x : G,
      sb_reflFun ε nrm i (x + v) = 1 - sb_reflFun ε nrm i x := by
  apply sb_reflFun_alternate v ε hε nrm
  intro i x
  exact sb_boolean_alt_of_mem01 v (fun x : G => nrm i x) (hbool i) (fun x => h01 i x) x


/-! ## The combined `α ++ β` tuple (`CompBool` of width `2W − 2`)

With `W = 2n+1` α-coordinates followed by `2n−1` β-coordinates, the combined tuple
`(α ++ β)(x)` has `(2n+1)+(2n−1)` coordinates.  Reading a coordinate through the append
splits into the α- or the β-part; per-coordinate `⟨p,q⟩`-periodicity and
`(v,·)`-booleanity then come from the α-hypotheses and the β-laws. -/

/-- The combined tuple: `2n+1` α-coordinates then `2n−1` β-coordinates. -/
def sb_alphaBeta {e n : ℕ} (b : ZMod (2 ^ (e + 1))) (f : G → ℕ)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))) (x : G) :
    Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1)) :=
  Fin.append (α x) (sb_betaTuple (n := n) b f x)

/-- The `α`-part coordinate of the combined tuple is the α-coordinate. -/
lemma sb_alphaBeta_coord_alpha {e n : ℕ} (b : ZMod (2 ^ (e + 1))) {f : G → ℕ}
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))) (i : Fin (2 * n + 1)) :
    coord (sb_alphaBeta b f α) (Fin.castAdd (2 * n - 1) i) = coord α i := by
  funext x
  simp [sb_alphaBeta, coord, Fin.append_left]

/-- The `β`-part coordinate of the combined tuple is the β-coordinate. -/
lemma sb_alphaBeta_coord_beta {e n : ℕ} (b : ZMod (2 ^ (e + 1))) {f : G → ℕ}
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))) (t : Fin (2 * n - 1)) :
    coord (sb_alphaBeta b f α) (Fin.natAdd (2 * n + 1) t) =
      (fun x : G => sb_betaTuple (n := n) b f x t) := by
  funext x
  simp [sb_alphaBeta, coord, Fin.append_right]


/-- Per-coordinate `⟨p,q⟩`-periodicity and `(v,·)`-booleanity of the combined tuple. -/
lemma sb_alphaBeta_coordwise {e n : ℕ} (v p q : G) (b : ZMod (2 ^ (e + 1)))
    {f : G → ℕ} (hn : 1 ≤ n)
    (hfval : ∀ x : G, 1 ≤ f x ∧ f x ≤ 2 * n) (hflip : ∀ x : G, f (x + v) = 2 * n + 1 - f x)
    (hper_p : periodicAlong p f) (hper_q : periodicAlong q f)
    (hb : b ∉ evenSub e)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (hbool : ∀ i : Fin (2 * n + 1), IsBooleanAlt e v (coord α i))
    (hperα_p : ∀ i : Fin (2 * n + 1), periodicAlong p (coord α i))
    (hperα_q : ∀ i : Fin (2 * n + 1), periodicAlong q (coord α i)) :
    ∀ j : Fin ((2 * n + 1) + (2 * n - 1)),
      periodicAlong p (coord (sb_alphaBeta b f α) j) ∧
      periodicAlong q (coord (sb_alphaBeta b f α) j) ∧
      IsBooleanAlt e v (coord (sb_alphaBeta b f α) j) := by
  intro j
  refine Fin.addCases (motive := fun j : Fin ((2 * n + 1) + (2 * n - 1)) =>
    periodicAlong p (coord (sb_alphaBeta b f α) j) ∧
    periodicAlong q (coord (sb_alphaBeta b f α) j) ∧
    IsBooleanAlt e v (coord (sb_alphaBeta b f α) j)) ?_ ?_ j
  · intro i
    rw [sb_alphaBeta_coord_alpha b α i]
    exact ⟨hperα_p i, hperα_q i, hbool i⟩
  · intro t
    rw [sb_alphaBeta_coord_beta b α t]
    exact ⟨sb_betaTuple_periodic_fn (n := n) b p hper_p t,
      sb_betaTuple_periodic_fn (n := n) b q hper_q t,
      sb_betaTuple_boolean (n := n) v b hb hn hfval hflip t⟩

/-- The range of an α-coordinate with value pair `{u, u+b}`. -/
lemma sb_alpha_range {e : ℕ} (v : G) {n : ℕ} (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i ∨ α x i = u i + b)
    (halt : ∀ i : Fin (2 * n + 1), ∀ x : G, α (x + v) i = (u i + (u i + b)) - α x i)
    (i : Fin (2 * n + 1)) :
    Set.range (coord α i) = ({u i, u i + b} : Set (ZMod (2 ^ (e + 1)))) := by
  exact range_eq_pair e v (coord α i) (u i) (u i + b) (hu i) (halt i)

/-- The range of a β-coordinate is `{0, b}`. -/
lemma sb_beta_range {e n : ℕ} (v : G) (b : ZMod (2 ^ (e + 1))) {f : G → ℕ} (hn : 1 ≤ n)
    (hfval : ∀ x : G, 1 ≤ f x ∧ f x ≤ 2 * n) (hflip : ∀ x : G, f (x + v) = 2 * n + 1 - f x)
    (t : Fin (2 * n - 1)) :
    Set.range (fun x : G => sb_betaTuple (n := n) b f x t) =
      ({0, b} : Set (ZMod (2 ^ (e + 1)))) := by
  refine range_eq_pair e v (fun x : G => sb_betaTuple (n := n) b f x t) 0 b ?_ ?_
  · intro x
    change sb_betaTuple (n := n) b f x t = 0 ∨ sb_betaTuple (n := n) b f x t = b
    dsimp [sb_betaTuple]
    exact sb_betaVal_mem (n := n) b (f x) (t.val + 1)
  · intro x
    change sb_betaTuple (n := n) b f (x + v) t = 0 + b - sb_betaTuple (n := n) b f x t
    rw [sb_betaTuple_flip_fn (n := n) (v := v) b (hn := hn) (t := t) (hf1 := (hfval x).1)
      (hf2 := (hfval x).2) (hfalt := hflip x)]
    ring


/-- `{0,b} = (−u) + {u, u+b}`. -/
lemma sb_pair_translate_pair {Z : Type*} [AddCommGroup Z] (u b : Z) :
    ({0, b} : Set Z) = (-u) + ({u, u + b} : Set Z) := by
  ext z
  constructor
  · intro hz
    rw [mem_add_element]
    simp at hz
    rcases hz with hz0 | hzb
    · refine ⟨u, by simp, ?_⟩
      rw [hz0]
      abel
    · refine ⟨u + b, by simp, ?_⟩
      rw [hzb]
      abel
  · intro hz
    rw [mem_add_element] at hz
    rcases hz with ⟨a, ha, hza⟩
    simp at ha
    rcases ha with hau | hab
    · have hz0 : z = 0 := by rw [hza, hau]; abel
      simp [hz0]
    · have hzb : z = b := by rw [hza, hab]; abel
      simp [hzb]

/-- `{0,b}` is a translate of itself. -/
lemma sb_pair_translate_zero {Z : Type*} [AddCommGroup Z] (b : Z) :
    ({0, b} : Set Z) = (0 : Z) + ({0, b} : Set Z) := by
  ext z
  rw [mem_add_element]
  simp

/-- Pairwise compatibility of the combined tuple. -/
lemma sb_alphaBeta_compatible {e n : ℕ} (v : G) (b : ZMod (2 ^ (e + 1)))
    {f : G → ℕ} (hn : 1 ≤ n)
    (hfval : ∀ x : G, 1 ≤ f x ∧ f x ≤ 2 * n) (hflip : ∀ x : G, f (x + v) = 2 * n + 1 - f x)
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))}
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i ∨ α x i = u i + b)
    (halt : ∀ i : Fin (2 * n + 1), ∀ x : G, α (x + v) i = (u i + (u i + b)) - α x i)
    (hcompatα : ∀ i i' : Fin (2 * n + 1),
      CompatibleFunctions (coord α i) (coord α i')) :
    ∀ j j' : Fin ((2 * n + 1) + (2 * n - 1)),
      CompatibleFunctions (coord (sb_alphaBeta b f α) j) (coord (sb_alphaBeta b f α) j') := by
  classical
  intro j j'
  -- each coordinate is either in the α-part or the β-part
  have hsplit : ∀ j : Fin ((2 * n + 1) + (2 * n - 1)),
      (∃ i : Fin (2 * n + 1), j = Fin.castAdd (2 * n - 1) i) ∨
      (∃ t : Fin (2 * n - 1), j = Fin.natAdd (2 * n + 1) t) := by
    intro jj
    refine Fin.addCases (motive := fun jj : Fin ((2 * n + 1) + (2 * n - 1)) =>
      (∃ i : Fin (2 * n + 1), jj = Fin.castAdd (2 * n - 1) i) ∨
      (∃ t : Fin (2 * n - 1), jj = Fin.natAdd (2 * n + 1) t)) ?_ ?_ jj
    · intro i
      exact Or.inl ⟨i, rfl⟩
    · intro t
      exact Or.inr ⟨t, rfl⟩
  rcases hsplit j with ⟨i, rfl⟩ | ⟨t, rfl⟩ <;> rcases hsplit j' with ⟨i', rfl⟩ | ⟨t', rfl⟩
  · rw [sb_alphaBeta_coord_alpha b α i, sb_alphaBeta_coord_alpha b α i']
    exact hcompatα i i'
  · rw [sb_alphaBeta_coord_alpha b α i, sb_alphaBeta_coord_beta b α t']
    unfold CompatibleFunctions PairTranslate
    have hrβ : Set.range (fun x : G => sb_betaTuple (n := n) b f x t') =
        ({0, b} : Set (ZMod (2 ^ (e + 1)))) := sb_beta_range (n := n) v b hn hfval hflip t'
    have hrα : Set.range (coord α i) = ({u i, u i + b} : Set (ZMod (2 ^ (e + 1)))) :=
      sb_alpha_range (n := n) v α u b hu halt i
    refine ⟨-u i, ?_⟩
    rw [hrβ, hrα]
    exact sb_pair_translate_pair (u i) b
  · rw [sb_alphaBeta_coord_beta b α t, sb_alphaBeta_coord_alpha b α i']
    have hαβ : CompatibleFunctions (coord α i') (fun x : G => sb_betaTuple (n := n) b f x t) := by
      unfold CompatibleFunctions PairTranslate
      have hrβ : Set.range (fun x : G => sb_betaTuple (n := n) b f x t) =
          ({0, b} : Set (ZMod (2 ^ (e + 1)))) := sb_beta_range (n := n) v b hn hfval hflip t
      have hrα : Set.range (coord α i') = ({u i', u i' + b} : Set (ZMod (2 ^ (e + 1)))) :=
        sb_alpha_range (n := n) v α u b hu halt i'
      refine ⟨-u i', ?_⟩
      rw [hrβ, hrα]
      exact sb_pair_translate_pair (u i') b
    exact pairTranslate_symm hαβ
  · rw [sb_alphaBeta_coord_beta b α t, sb_alphaBeta_coord_beta b α t']
    unfold CompatibleFunctions PairTranslate
    refine ⟨0, ?_⟩
    have hrβ : Set.range (fun x : G => sb_betaTuple (n := n) b f x t') =
        ({0, b} : Set (ZMod (2 ^ (e + 1)))) := sb_beta_range (n := n) v b hn hfval hflip t'
    have hrβ' : Set.range (fun x : G => sb_betaTuple (n := n) b f x t) =
        ({0, b} : Set (ZMod (2 ^ (e + 1)))) := sb_beta_range (n := n) v b hn hfval hflip t
    rw [hrβ, hrβ']
    exact sb_pair_translate_zero b
/-- The combined tuple obeys `CompBool` (width `2W − 2`). -/
lemma sb_alphaBeta_compbool {e n : ℕ} (v p q : G) (b : ZMod (2 ^ (e + 1))) (hb : b ∉ evenSub e)
    {f : G → ℕ} (hn : 1 ≤ n)
    (hfval : ∀ x : G, 1 ≤ f x ∧ f x ≤ 2 * n) (hflip : ∀ x : G, f (x + v) = 2 * n + 1 - f x)
    (hper_p : periodicAlong p f) (hper_q : periodicAlong q f)
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))}
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i ∨ α x i = u i + b)
    (halt : ∀ i : Fin (2 * n + 1), ∀ x : G, α (x + v) i = (u i + (u i + b)) - α x i)
    (hboolα : ∀ i : Fin (2 * n + 1), IsBooleanAlt e v (coord α i))
    (hperα_p : ∀ i : Fin (2 * n + 1), periodicAlong p (coord α i))
    (hperα_q : ∀ i : Fin (2 * n + 1), periodicAlong q (coord α i))
    (hcompatα : ∀ i i' : Fin (2 * n + 1),
      CompatibleFunctions (coord α i) (coord α i')) :
    CompBool e v p q (sb_alphaBeta b f α) := by
  constructor
  · exact sb_alphaBeta_coordwise v p q b hn hfval hflip hper_p hper_q hb α hboolα hperα_p hperα_q
  · exact sb_alphaBeta_compatible v b hn hfval hflip u hu halt hcompatα


/-! ## The linear equation of `P*_Ω`

For `ε_i ∈ {0,1}`, the sign-encoded α-coordinate satisfies
`(−1)^{ε_i}·α_i = b·γ_i + d_i` with `γ_i := R_{ε_i}(ñ_i)` and the constant
`d_i := u_i` (if `ε_i = 0`) or `d_i := −u_i − b` (if `ε_i = 1`).  Summing gives
`Σ (−1)^{ε_i}α_i = b·f + Σ d_i` (via `Σ_i γ_i = f`, the level-sum identity) and, with
the β-sum `Σ_t β_t = b·(f−1)`, the linear equation
`Σ (−1)^{ε_i}α_i − Σ_t β_t = b + Σ_i d_i`, which is constant in `x`. -/

/-- Per-coordinate sign identity: `±α_i = b·γ_i + d_i`. -/
lemma sb_coord_sign_identity {e n : ℕ} (b : ZMod (2 ^ (e + 1)))
    {ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))}
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    {nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1))}
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))}
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + b * nrm i x)
    (i : Fin (2 * n + 1)) (x : G) :
    (if ε i = 0 then (1 : ZMod (2 ^ (e + 1))) else -1) * α x i =
      b * sb_reflFun ε nrm i x +
        (if ε i = 0 then u i else -u i - b) := by
  rcases hε i with h0 | h1
  · -- ε i = 0
    have hg : sb_reflFun ε nrm i x = nrm i x := by
      simp [sb_reflFun, h0, sb_reflect]
    rw [hg]
    simp [h0, hu i x]
    ring
  · -- ε i = 1
    have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
    have hg : sb_reflFun ε nrm i x = 1 - nrm i x := by
      simp [sb_reflFun, h1, sb_reflect, h10]
      ring
    rw [hg]
    simp [h1, h10]
    -- goal: -1 * α x i = b * (1 - nrm i x) + (-u i - b)
    rw [hu i x]
    ring

/-- The sum of a `{0,1}`-valued tuple equals (as a `ZMod` element) its level. -/
lemma sb_levelTuple_sum {e K : ℕ} (t : Fin K → ZMod (2 ^ (e + 1)))
    (hvals : ∀ i : Fin K, t i = 0 ∨ t i = 1) :
    (∑ i : Fin K, t i) = (sb_levelTuple t : ZMod (2 ^ (e + 1))) := by
  classical
  rw [sb_levelTuple]
  have hrewrite : ∀ i : Fin K, t i = (((if t i = 1 then 1 else 0) : ℕ) : ZMod (2 ^ (e + 1))) := by
    intro i
    rcases hvals i with h0 | h1
    · rw [h0]
      simp
    · rw [h1]
      simp
  calc
    (∑ i : Fin K, t i) = (∑ i : Fin K, (((if t i = 1 then 1 else 0) : ℕ) : ZMod (2 ^ (e + 1)))) := by
      refine Finset.sum_congr rfl ?_
      intro i hi
      exact hrewrite i
    _ = (((∑ i : Fin K, (if t i = 1 then 1 else 0 : ℕ))) : ZMod (2 ^ (e + 1))) := by
      simp [Nat.cast_sum]
    _ = ((((Finset.univ.filter (fun i : Fin K => t i = 1)) : Finset (Fin K)).card : ℕ) : ZMod (2 ^ (e + 1))) := by
      congr 1
      simpa using (Finset.sum_boole (s := (Finset.univ : Finset (Fin K))) (p := fun i : Fin K => t i = 1))

/-- The linear equation of `P*_Ω`: `Σ (−1)^{ε_i}α_i − Σ_t β_t` is constant in `x`
(equal to `b + Σ_i d_i`). -/
lemma sb_linear_identity {e n : ℕ} (b : ZMod (2 ^ (e + 1)))
    {ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))}
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    {nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1))}
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))}
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + b * nrm i x)
    (hn : 1 ≤ n) (x : G)
    (hγ01 : ∀ i : Fin (2 * n + 1), sb_reflFun ε nrm i x = 0 ∨ sb_reflFun ε nrm i x = 1)
    (hf1 : 1 ≤ sb_level ε nrm x) (hf2 : sb_level ε nrm x ≤ 2 * n) :
    (∑ i : Fin (2 * n + 1), (if ε i = 0 then (1 : ZMod (2 ^ (e + 1))) else -1) * α x i) -
      (∑ t : Fin (2 * n - 1), sb_betaTuple (n := n) b (sb_level ε nrm) x t) =
    b + (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - b)) := by
  classical
  let c : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)) :=
    fun i => if ε i = 0 then 1 else -1
  let d : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)) :=
    fun i => if ε i = 0 then u i else -u i - b
  let f : G → ℕ := sb_level ε nrm
  have hsign : ∀ i : Fin (2 * n + 1),
      c i * α x i = b * sb_reflFun ε nrm i x + d i := by
    intro i
    dsimp [c, d]
    exact sb_coord_sign_identity (n := n) b hε u hu i x
  -- the α-sum
  have hsumα : (∑ i : Fin (2 * n + 1), c i * α x i) =
      b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) +
        (∑ i : Fin (2 * n + 1), d i) := by
    calc
      (∑ i : Fin (2 * n + 1), c i * α x i) =
          (∑ i : Fin (2 * n + 1), (b * sb_reflFun ε nrm i x + d i)) := by
        refine Finset.sum_congr rfl ?_
        intro i hi
        exact hsign i
      _ = b * (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) +
            (∑ i : Fin (2 * n + 1), d i) := by
        rw [Finset.sum_add_distrib]
        congr 1
        rw [Finset.mul_sum]
      _ = b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) +
            (∑ i : Fin (2 * n + 1), d i) := by
        congr 1
        have hlv : (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) =
            ((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1))) := by
          dsimp [sb_level]
          exact sb_levelTuple_sum (fun i : Fin (2 * n + 1) => sb_reflFun ε nrm i x) hγ01
        rw [hlv]
  -- the β-sum
  have hsumβ : (∑ t : Fin (2 * n - 1), sb_betaTuple (n := n) b f x t) =
      b * (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1)))) := by
    dsimp [f]
    exact sb_betaTuple_sum (n := n) b (f := sb_level ε nrm) (x := x) hn hf1 hf2
  -- combine
  calc
    (∑ i : Fin (2 * n + 1), c i * α x i) -
        (∑ t : Fin (2 * n - 1), sb_betaTuple (n := n) b f x t)
        = b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) +
            (∑ i : Fin (2 * n + 1), d i) -
          b * (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1)))) := by
      rw [hsumα, hsumβ]
    _ = b + (∑ i : Fin (2 * n + 1), d i) := by
      have hsub : (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) -
          (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1)))) = 1 := by
        rw [Nat.cast_sub hf1]
        ring
      have hb : b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) -
          b * (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1)))) = b := by
        rw [← mul_sub]
        rw [hsub]
        simp
      calc
        (b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) +
              (∑ i : Fin (2 * n + 1), d i)) -
            b * (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1))))
            = (b * (((sb_level ε nrm x : ℕ) : ZMod (2 ^ (e + 1)))) -
                b * (((sb_level ε nrm x - 1 : ℕ) : ZMod (2 ^ (e + 1))))) +
                  (∑ i : Fin (2 * n + 1), d i) := by
          abel
        _ = b + (∑ i : Fin (2 * n + 1), d i) := by rw [hb]
    _ = b + (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - b)) := by
      rfl


/-! ## The `P*_Ω` property of the combined tuple

With `ε` the reflection pattern, the sign-encoded linear combination over the combined
tuple `γ := (α ++ β)` is `Σ_j coeff j · γ x j` where `coeff (castAdd i) = ±1` (the sign
of `ε i`) on the α-part and `coeff (natAdd (2n+1) t) = −1` on the β-part; the paper's
eqn (ii) is that this combination is constant in `x`. -/

/-- The sign coefficient of an α-coordinate. -/
def sb_signCoeff {e : ℕ} (ε : ZMod (2 ^ (e + 1))) : ZMod (2 ^ (e + 1)) :=
  if ε = 0 then 1 else -1

/-- The `(−1)^{ε_i}`-style coefficients on the combined `(2n+1)+(2n−1)`-tuple. -/
noncomputable def sb_linCoeff {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) :
    Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1)) :=
  fun j => if h : ∃ i : Fin (2 * n + 1), j = Fin.castAdd (2 * n - 1) i
    then sb_signCoeff (ε (Classical.choose h)) else -1

/-- The coefficient on an α-coordinate is its sign. -/
lemma sb_linCoeff_castAdd {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (i : Fin (2 * n + 1)) :
    sb_linCoeff ε (Fin.castAdd (2 * n - 1) i) = sb_signCoeff (ε i) := by
  classical
  change (if h : ∃ i' : Fin (2 * n + 1), Fin.castAdd (2 * n - 1) i = Fin.castAdd (2 * n - 1) i'
      then sb_signCoeff (ε (Classical.choose h)) else -1) = sb_signCoeff (ε i)
  by_cases hp : (∃ i' : Fin (2 * n + 1), Fin.castAdd (2 * n - 1) i = Fin.castAdd (2 * n - 1) i')
  · rw [dif_pos hp]
    have hch : Classical.choose hp = i := by
      apply Fin.ext
      have hc := congrArg Fin.val (Classical.choose_spec hp)
      simpa [Fin.castAdd] using hc
    rw [hch]
  · exfalso
    apply hp
    exact ⟨i, rfl⟩

/-- The coefficient on a β-coordinate is `−1`. -/
lemma sb_linCoeff_natAdd {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (t : Fin (2 * n - 1)) :
    sb_linCoeff ε (Fin.natAdd (2 * n + 1) t) = -1 := by
  classical
  change (if h : ∃ i' : Fin (2 * n + 1), Fin.natAdd (2 * n + 1) t = Fin.castAdd (2 * n - 1) i'
      then sb_signCoeff (ε (Classical.choose h)) else -1) = -1
  by_cases hp : (∃ i' : Fin (2 * n + 1), Fin.natAdd (2 * n + 1) t = Fin.castAdd (2 * n - 1) i')
  · exfalso
    rcases hp with ⟨i', hi⟩
    have hv := congrArg Fin.val hi
    have hv' : (2 * n + 1) + t.val = i'.val := by
      simpa [Fin.castAdd, Fin.natAdd] using hv
    have hi' : i'.val < 2 * n + 1 := i'.isLt
    omega
  · rw [dif_neg hp]
/-- The combined linear combination, split by the α- and β-parts. -/
lemma sb_linCoeff_sum {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    {γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1)))} (x : G) :
    (∑ j : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε j * γ x j) =
      (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * γ x (Fin.castAdd (2 * n - 1) i)) +
      (∑ t : Fin (2 * n - 1), (-1 : ZMod (2 ^ (e + 1))) * γ x (Fin.natAdd (2 * n + 1) t)) := by
  classical
  rw [Fin.sum_univ_add]
  congr 1
  · refine Finset.sum_congr rfl ?_
    intro i hi
    rw [sb_linCoeff_castAdd ε i]
  · refine Finset.sum_congr rfl ?_
    intro t ht
    rw [sb_linCoeff_natAdd ε t]

/-! ## From Ω-membership to the level bounds

For the single-pair `Ω = {0,1}^K ∖ {ε, 1−ε}` with `ε_i ∈ {0,1}`, membership of
`(ñ_i x)_i` in `Ω` means the reflected tuple `γ(x)` avoids the two constant tuples, so
the level `f(x)` lies in `{1,…,K−1}`. -/

/-- The reflected value equals the reflection of the value at the point. -/
lemma sb_reflFun_eval {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G) :
    sb_reflFun ε nrm i x = sb_reflect (ε i) (fun _ : G => nrm i x) (0 : G) := by
  by_cases hz : ε i = 0
  · simp [sb_reflFun, hz, sb_reflect]
  · simp [sb_reflFun, hz, sb_reflect]

/-- For `ε_i = 0` the reflected function is `ñ_i`. -/
lemma sb_reflFun_of_zero {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G) (h0 : ε i = 0) :
    sb_reflFun ε nrm i x = nrm i x := by
  rw [sb_reflFun_eval]
  simp [h0, sb_reflect]

/-- For `ε_i = 1` the reflected function is `1 − ñ_i`. -/
lemma sb_reflFun_of_one {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G) (h1 : ε i = 1) :
    sb_reflFun ε nrm i x = 1 - nrm i x := by
  have h10 : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := one_ne_zero_zmod e
  rw [sb_reflFun_eval]
  simp [h1, sb_reflect, h10]
  ring

/-- If `γ(x)` is not the zero tuple then it is not identically zero coordinatewise;
converse: all-`1` γ means `ñ = 1 − ε`. -/
lemma sb_nrm_eq_of_gamma_one {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G)
    (hgi : sb_reflFun ε nrm i x = 1) : nrm i x = 1 - ε i := by
  rcases hε i with h0 | h1
  · rw [sb_reflFun_of_zero ε nrm i x h0] at hgi
    calc
      nrm i x = 1 := hgi
      _ = 1 - ε i := by rw [h0]; ring
  · rw [sb_reflFun_of_one ε nrm i x h1] at hgi
    have hc := congrArg (fun z : ZMod (2 ^ (e + 1)) => 1 - z) hgi
    have hn : nrm i x = 0 := by
      calc
        nrm i x = 1 - (1 - nrm i x) := by ring
        _ = 1 - 1 := hc
        _ = 0 := by ring
    calc
      nrm i x = 0 := hn
      _ = 1 - ε i := by rw [h1]; ring

/-- If `γ(x)` is not the zero tuple then it is not identically zero coordinatewise;
converse: all-`1` γ means `ñ = 1 − ε`.  (Zero case: `γ = 0` gives `ñ = ε`.) -/
lemma sb_nrm_eq_of_gamma_zero {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G)
    (hgi : sb_reflFun ε nrm i x = 0) : nrm i x = ε i := by
  rcases hε i with h0 | h1
  · rw [sb_reflFun_of_zero ε nrm i x h0] at hgi
    calc
      nrm i x = 0 := hgi
      _ = ε i := by rw [h0]
  · rw [sb_reflFun_of_one ε nrm i x h1] at hgi
    have hc := congrArg (fun z : ZMod (2 ^ (e + 1)) => 1 - z) hgi
    -- 1 - (1 - nrm) = 1 - 0
    have hn : nrm i x = 1 := by
      calc
        nrm i x = 1 - (1 - nrm i x) := by ring
        _ = 1 - 0 := hc
        _ = 1 := by ring
    calc
      nrm i x = 1 := hn
      _ = ε i := by rw [h1]

/-- Ω-membership of the normalized tuple forces the level into `{1,…,K−1}`. -/
lemma sb_level_bounds_of_Omega {e K : ℕ} (hK : 1 ≤ K) (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (x : G)
    (hΩ : (fun w : Fin K => nrm w x) ∈ sb_OmegaPair ε) :
    1 ≤ sb_level ε nrm x ∧ sb_level ε nrm x ≤ K - 1 := by
  have hnot0 : ¬ (∀ i : Fin K, sb_reflFun ε nrm i x = 0) := by
    intro hall
    apply hΩ.2.1
    intro i
    exact sb_nrm_eq_of_gamma_zero ε hε nrm i x (hall i)
  have hnot1 : ¬ (∀ i : Fin K, sb_reflFun ε nrm i x = 1) := by
    intro hall
    apply hΩ.2.2
    intro i
    exact sb_nrm_eq_of_gamma_one ε hε nrm i x (hall i)
  exact sb_level_mem hK ε hε nrm x (fun i => hΩ.1 i) hnot0 hnot1

/-! ## The level laws assembled from Ω-membership

With `ñ`-values in `{0,1}`, `ñ`-booleanity along `v`, `ñ`-periodicity along `p, q` and
Ω-membership of `(ñ x)`, the level `f := sb_level ε nrm` satisfies the bounds
`1 ≤ f(x) ≤ K−1`, the alternation `f(x+v) = K − f(x)`, and the periodicities along
`p, q`. -/

/-- The reflected functions keep `{0,1}` values. -/
lemma sb_reflFun_mem {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (x : G)
    (hni : nrm i x = 0 ∨ nrm i x = 1) :
    sb_reflFun ε nrm i x = 0 ∨ sb_reflFun ε nrm i x = 1 := by
  rcases hε i with h0 | h1
  · rcases hni with y0 | y1
    · left
      simp [sb_reflFun, h0, sb_reflect, y0]
    · right
      simp [sb_reflFun, h0, sb_reflect, y1]
  · rcases hni with y0 | y1
    · right
      simp [sb_reflFun, h1, sb_reflect, one_ne_zero_zmod e, y0]
    · left
      simp [sb_reflFun, h1, sb_reflect, one_ne_zero_zmod e, y1]

/-- Reflection preserves periodicity. -/
lemma sb_reflFun_periodic {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1)))
    (nrm : Fin K → G → ZMod (2 ^ (e + 1))) (i : Fin K) (u0 : G)
    (hper : periodicAlong u0 (fun x : G => nrm i x)) :
    periodicAlong u0 (fun x : G => sb_reflFun ε nrm i x) := by
  intro x
  change sb_reflFun ε nrm i (x + u0) = sb_reflFun ε nrm i x
  by_cases hz : ε i = 0
  · have hg1 : sb_reflFun ε nrm i (x + u0) = nrm i (x + u0) := by
      simp [sb_reflFun, hz, sb_reflect]
    have hg2 : sb_reflFun ε nrm i x = nrm i x := by
      simp [sb_reflFun, hz, sb_reflect]
    rw [hg1, hg2]
    exact hper x
  · have hg1 : sb_reflFun ε nrm i (x + u0) = ε i + -nrm i (x + u0) := by
      simp [sb_reflFun, hz, sb_reflect]
    have hg2 : sb_reflFun ε nrm i x = ε i + -nrm i x := by
      simp [sb_reflFun, hz, sb_reflect]
    rw [hg1, hg2]
    have hx : nrm i (x + u0) = nrm i x := by simpa using hper x
    rw [hx]

/-- The level laws assembled from the Ω-membership and the `ñ`-structure. -/
lemma sb_level_laws {e K : ℕ} (hK : 1 ≤ K) (v p q : G)
    (ε : Fin K → ZMod (2 ^ (e + 1))) (hε : ∀ i : Fin K, ε i = 0 ∨ ε i = 1)
    (nrm : Fin K → G → ZMod (2 ^ (e + 1)))
    (hnrm : ∀ i : Fin K, ∀ x : G, nrm i x = 0 ∨ nrm i x = 1)
    (hΩ : ∀ x : G, (fun w : Fin K => nrm w x) ∈ sb_OmegaPair ε)
    (hbool : ∀ i : Fin K, IsBooleanAlt e v (fun x : G => nrm i x))
    (hper_p : ∀ i : Fin K, periodicAlong p (fun x : G => nrm i x))
    (hper_q : ∀ i : Fin K, periodicAlong q (fun x : G => nrm i x)) :
    (∀ x : G, 1 ≤ sb_level ε nrm x ∧ sb_level ε nrm x ≤ K - 1) ∧
    (∀ x : G, sb_level ε nrm (x + v) = K - sb_level ε nrm x) ∧
    periodicAlong p (fun x : G => sb_level ε nrm x) ∧
    periodicAlong q (fun x : G => sb_level ε nrm x) := by
  constructor
  · intro x
    exact sb_level_bounds_of_Omega hK ε hε nrm x (hΩ x)
  constructor
  · intro x
    exact sb_level_alternate v ε nrm (sb_gamma_alternate v ε hε nrm hbool hnrm)
      (fun i x => sb_reflFun_mem ε hε nrm i x (hnrm i x)) x
  constructor
  · exact sb_level_periodic ε nrm p (fun i => sb_reflFun_periodic ε nrm i p (hper_p i))
  · exact sb_level_periodic ε nrm q (fun i => sb_reflFun_periodic ε nrm i q (hper_q i))


/-! ## The `P*_Ω` predicate and the bundling theorem

For the combined tuple of width `(2n+1)+(2n−1)`, `P*` is `CompBool` conjoined with the
constancy of the linear combination `Σ_j sb_linCoeff ε j · γ x j`.  From a `P_Ω`-style
witness of `α` (a compatible boolean tuple with a normalization `(u, b, ñ)` whose
reflected values avoid `ε` and `1−ε`), the appended `β := sb_betaTuple b f`
(`f := sb_level ε ñ`) witnesses `P*`. -/

/-- The auxiliary property `P*` of the paper (CompBool + the constant linear
combination). -/
def sb_Pstar {e n : ℕ} (v p q : G) (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1)))) : Prop :=
  CompBool e v p q γ ∧
    ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
      (∑ j : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε j * γ x j) = z

/-- With `ñ`-values in `{0,1}`, `α = u + b·ñ` takes the two values `u` and `u + b`. -/
lemma sb_alpha_value_mem {e K : ℕ} (b : ZMod (2 ^ (e + 1)))
    (u : Fin K → ZMod (2 ^ (e + 1)))
    {nrm : Fin K → G → ZMod (2 ^ (e + 1))}
    {α : G → (Fin K → ZMod (2 ^ (e + 1)))}
    (hu : ∀ i : Fin K, ∀ x : G, α x i = u i + b * nrm i x)
    (hnrm : ∀ i : Fin K, ∀ x : G, nrm i x = 0 ∨ nrm i x = 1) :
    ∀ i : Fin K, ∀ x : G, α x i = u i ∨ α x i = u i + b := by
  intro i x
  rcases hnrm i x with n0 | n1
  · left
    rw [hu i x, n0]
    simp
  · right
    rw [hu i x, n1]
    ring

/-- The alternating law of `α` for the pair `{u, u+b}` follows from `ñ`-booleanity. -/
lemma sb_alpha_alt {e K : ℕ} (v : G) (b : ZMod (2 ^ (e + 1)))
    (u : Fin K → ZMod (2 ^ (e + 1)))
    {nrm : Fin K → G → ZMod (2 ^ (e + 1))}
    {α : G → (Fin K → ZMod (2 ^ (e + 1)))}
    (hu : ∀ i : Fin K, ∀ x : G, α x i = u i + b * nrm i x)
    (hnrm : ∀ i : Fin K, ∀ x : G, nrm i x = 0 ∨ nrm i x = 1)
    (hbool : ∀ i : Fin K, IsBooleanAlt e v (fun x : G => nrm i x)) :
    ∀ i : Fin K, ∀ x : G, α (x + v) i = (u i + (u i + b)) - α x i := by
  intro i x
  have hnvalt : nrm i (x + v) = 1 - nrm i x :=
    sb_boolean_alt_of_mem01 v (fun x : G => nrm i x) (hbool i) (fun x => hnrm i x) x
  calc
    α (x + v) i = u i + b * nrm i (x + v) := hu i (x + v)
    _ = u i + b * (1 - nrm i x) := by rw [hnvalt]
    _ = (u i + (u i + b)) - α x i := by
      rw [hu i x]
      ring


/-- From a `P_Ω`-style witness of `α`, the appended `(α ++ β)` tuple witnesses `P*`. -/
lemma sb_Pstar_bundle {e n : ℕ} (v p q : G) (b : ZMod (2 ^ (e + 1))) (hb : b ∉ evenSub e)
    {ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))}
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))} (hα : CompBool e v p q α)
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    {nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1))}
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + b * nrm i x)
    (hnrm : ∀ i : Fin (2 * n + 1), ∀ x : G, nrm i x = 0 ∨ nrm i x = 1)
    (hboolnrm : ∀ i : Fin (2 * n + 1), IsBooleanAlt e v (fun x : G => nrm i x))
    (hpernrm_p : ∀ i : Fin (2 * n + 1), periodicAlong p (fun x : G => nrm i x))
    (hpernrm_q : ∀ i : Fin (2 * n + 1), periodicAlong q (fun x : G => nrm i x))
    (hΩ : ∀ x : G, (fun w : Fin (2 * n + 1) => nrm w x) ∈ sb_OmegaPair ε)
    (hn : 1 ≤ n) :
    sb_Pstar v p q ε (sb_alphaBeta b (sb_level ε nrm) α) := by
  constructor
  · -- the CompBool part
    have hlaws := sb_level_laws (K := 2 * n + 1) (by omega) v p q ε hε nrm hnrm hΩ hboolnrm
      hpernrm_p hpernrm_q
    exact sb_alphaBeta_compbool v p q b hb (f := sb_level ε nrm) hn hlaws.1 hlaws.2.1
      hlaws.2.2.1 hlaws.2.2.2 (u := u)
      (sb_alpha_value_mem b u hu hnrm) (sb_alpha_alt v b u hu hnrm hboolnrm)
      (fun i => (hα.1 i).2.2) (fun i => (hα.1 i).1) (fun i => (hα.1 i).2.1) hα.2
  · -- the linear part
    refine ⟨b + (∑ i : Fin (2 * n + 1), if ε i = 0 then u i else -u i - b), ?_⟩
    intro x
    have hlaws := sb_level_laws (K := 2 * n + 1) (by omega) v p q ε hε nrm hnrm hΩ hboolnrm
      hpernrm_p hpernrm_q
    have hl := sb_linear_identity (n := n) b hε u hu hn x
      (fun i => sb_reflFun_mem ε hε nrm i x (hnrm i x)) (hlaws.1 x).1 (hlaws.1 x).2
    -- rewrite the combined combination to the difference of the α- and β-sums
    rw [sb_linCoeff_sum]
    have hca : ∀ i : Fin (2 * n + 1),
        (sb_alphaBeta b (sb_level ε nrm) α) x (Fin.castAdd (2 * n - 1) i) = α x i := by
      intro i
      exact congrFun (sb_alphaBeta_coord_alpha b α i) x
    have hcb : ∀ t : Fin (2 * n - 1),
        (sb_alphaBeta b (sb_level ε nrm) α) x (Fin.natAdd (2 * n + 1) t) =
          sb_betaTuple (n := n) b (sb_level ε nrm) x t := by
      intro t
      exact congrFun (sb_alphaBeta_coord_beta b α t) x
    rw [show (∑ i : Fin (2 * n + 1),
          sb_signCoeff (ε i) * (sb_alphaBeta b (sb_level ε nrm) α) x (Fin.castAdd (2 * n - 1) i)) =
        (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) by
      refine Finset.sum_congr rfl ?_
      intro i hi
      rw [hca i]]
    rw [show (∑ t : Fin (2 * n - 1),
          (-1 : ZMod (2 ^ (e + 1))) * (sb_alphaBeta b (sb_level ε nrm) α) x (Fin.natAdd (2 * n + 1) t)) =
        (∑ t : Fin (2 * n - 1), (-1 : ZMod (2 ^ (e + 1))) * sb_betaTuple (n := n) b (sb_level ε nrm) x t) by
      refine Finset.sum_congr rfl ?_
      intro t ht
      rw [hcb t]]
    simpa [sb_signCoeff, Finset.sum_neg, neg_one_mul, sub_eq_add_neg] using hl


/-! ## `P*` is weakly expressible (step (4)(b))

`P*` is the conjunction of `CompBool` (weakly expressible at every width, by
`mef_weakExpressible_general`) and the constancy of the linear combination, which is the
`express_linear_zmod`-instance of `linConstVal` with the coefficient vector
`sb_linCoeff ε` (a non-zero coefficient exists because each sign is `±1 ≠ 0`). -/

/-- The sign coefficients are non-zero. -/
lemma sb_signCoeff_ne_zero {e : ℕ} (ε : ZMod (2 ^ (e + 1))) : sb_signCoeff ε ≠ 0 := by
  unfold sb_signCoeff
  by_cases h : ε = 0
  · rw [if_pos h]
    exact one_ne_zero_zmod e
  · rw [if_neg h]
    intro hz
    have h1 : (1 : ZMod (2 ^ (e + 1))) = 0 := by
      have := congrArg (fun z : ZMod (2 ^ (e + 1)) => -z) hz
      simpa using this
    exact (one_ne_zero_zmod e) h1

/-- The combined linear-combination functional is non-zero. -/
lemma sb_linCoeff_exists_ne_zero {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) :
    ∃ w : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε w ≠ 0 := by
  refine ⟨Fin.castAdd (2 * n - 1) (⟨0, by omega⟩ : Fin (2 * n + 1)), ?_⟩
  rw [sb_linCoeff_castAdd ε (⟨0, by omega⟩ : Fin (2 * n + 1))]
  exact sb_signCoeff_ne_zero (ε (⟨0, by omega⟩ : Fin (2 * n + 1)))

/-- `P*` is weakly expressible at the combined width (conjunction of `CompBool` and the
linear-constancy). -/
theorem sb_Pstar_weakExpressible {d n : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) :
    WeakExpressible ((2 * n + 1) + (2 * n - 1))
      (fun γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) =>
        sb_Pstar v p q ε γ) := by
  classical
  let K := (2 * n + 1) + (2 * n - 1)
  have hComp : WeakExpressible K
      (fun γ : G → (Fin K → ZMod (2 ^ (e + 1))) => CompBool e v p q γ) := by
    dsimp [K]
    exact mef_weakExpressible_general (d := d) (K := (2 * n + 1) + (2 * n - 1)) e he v p q
      h2v h2p h2q hind gens hpos hspan
  have hLin : WeakExpressible K
      (fun γ : G → (Fin K → ZMod (2 ^ (e + 1))) =>
        ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
          (∑ j : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε j * γ x j) = z) := by
    dsimp [K]
    have hE : ExpressibleProperty (fun γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) →
        ZMod (2 ^ (e + 1))) => linConstVal (linFun (2 ^ (e + 1)) ((2 * n + 1) + (2 * n - 1))
          (sb_linCoeff ε)) γ) := by
      exact express_linear_zmod (N := 2 ^ (e + 1)) (W := (2 * n + 1) + (2 * n - 1))
        (c := sb_linCoeff ε) gens hspan (sb_linCoeff_exists_ne_zero ε)
    have hconv : ∀ γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))),
        (linConstVal (linFun (2 ^ (e + 1)) ((2 * n + 1) + (2 * n - 1)) (sb_linCoeff ε)) γ) ↔
          (∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
            (∑ j : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε j * γ x j) = z) := by
      intro γ
      rfl
    exact expressible_weak (K := (2 * n + 1) + (2 * n - 1))
      (P := fun γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) =>
        ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
          (∑ j : Fin ((2 * n + 1) + (2 * n - 1)), sb_linCoeff ε j * γ x j) = z)
      (by
        exact expressible_congr hconv hE)
  exact weakExpressible_conj hComp hLin


/-! ## `P_Ω` in full witness form (step (4)(c))

The property `P_Ω` used in sym-bool carries the full normalization witness: the boolean
functions `ñ` are `(v,{0,1})`-boolean and `⟨p,q⟩`-periodic (so the level laws are
available), and the Ω-constraint is on `(ñ x)`. -/

/-- `P_Ω` with the full normalization witness. -/
def sb_POmegaFull {e K : ℕ} (v p q : G) (Ω : Set (Fin K → ZMod (2 ^ (e + 1))))
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) : Prop :=
  CompBool e v p q α ∧
    ∃ (u : Fin K → ZMod (2 ^ (e + 1))) (b : ZMod (2 ^ (e + 1)))
      (nrm : Fin K → G → ZMod (2 ^ (e + 1))),
      b ∉ evenSub e ∧
      (∀ w : Fin K, ∀ x : G, α x w = u w + b * nrm w x) ∧
      (∀ w : Fin K, ∀ x : G, nrm w x = 0 ∨ nrm w x = 1) ∧
      (∀ w : Fin K, IsBooleanAlt e v (fun x : G => nrm w x)) ∧
      (∀ w : Fin K, periodicAlong p (fun x : G => nrm w x)) ∧
      (∀ w : Fin K, periodicAlong q (fun x : G => nrm w x)) ∧
      (∀ x : G, (fun w : Fin K => nrm w x) ∈ Ω)

/-- Forward half of the `P_Ω`/`P*` equivalence: a full witness of `α` gives auxiliary
`β`-coordinates witnessing `P*` of the appended tuple. -/
lemma sb_POmegaFull_forward {e n : ℕ} (v p q : G)
    {ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))}
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    {α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))}
    (hP : sb_POmegaFull v p q (sb_OmegaPair ε) α) (hn : 1 ≤ n) :
    ∃ β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))),
      sb_Pstar v p q ε (fun x : G => Fin.append (α x) (β x)) := by
  rcases hP with ⟨hα, hw⟩
  rcases hw with ⟨u, b, nrm, hb, hu, hnrm, hboolnrm, hpernrm_p, hpernrm_q, hΩ⟩
  let f : G → ℕ := sb_level ε nrm
  refine ⟨fun x : G => sb_betaTuple (n := n) b f x, ?_⟩
  change sb_Pstar v p q ε (sb_alphaBeta b f α)
  exact sb_Pstar_bundle (n := n) v p q b hb hε hα u hu hnrm hboolnrm hpernrm_p hpernrm_q
    hΩ hn


/-! ## Projecting `CompBool` of the appended tuple back to its parts

A tuple `γ := (α ++ β)` that is `CompBool` restricts to a `CompBool` tuple on each
appended part (coordinates are read through `castAdd`/`natAdd`). -/

/-- The left part of an appended `CompBool` tuple is itself `CompBool`. -/
lemma compbool_of_append_left {e n m : ℕ} (v p q : G)
    (α : G → (Fin n → ZMod (2 ^ (e + 1))))
    (β : G → (Fin m → ZMod (2 ^ (e + 1))))
    (h : CompBool e v p q (fun x : G => Fin.append (α x) (β x))) :
    CompBool e v p q α := by
  constructor
  · intro w
    have hw := h.1 (Fin.castAdd m w)
    have hceq : coord (fun x : G => Fin.append (α x) (β x)) (Fin.castAdd m w) = coord α w := by
      funext x
      simp [coord, Fin.append_left]
    simpa [hceq] using hw
  · intro w w'
    have hc := h.2 (Fin.castAdd m w) (Fin.castAdd m w')
    have hceq1 : coord (fun x : G => Fin.append (α x) (β x)) (Fin.castAdd m w) = coord α w := by
      funext x
      simp [coord, Fin.append_left]
    have hceq2 : coord (fun x : G => Fin.append (α x) (β x)) (Fin.castAdd m w') = coord α w' := by
      funext x
      simp [coord, Fin.append_left]
    simpa [hceq1, hceq2] using hc

/-- The right part of an appended `CompBool` tuple is itself `CompBool`. -/
lemma compbool_of_append_right {e n m : ℕ} (v p q : G)
    (α : G → (Fin n → ZMod (2 ^ (e + 1))))
    (β : G → (Fin m → ZMod (2 ^ (e + 1))))
    (h : CompBool e v p q (fun x : G => Fin.append (α x) (β x))) :
    CompBool e v p q β := by
  constructor
  · intro t
    have ht := h.1 (Fin.natAdd n t)
    have hceq : coord (fun x : G => Fin.append (α x) (β x)) (Fin.natAdd n t) = coord β t := by
      funext x
      simp [coord, Fin.append_right]
    simpa [hceq] using ht
  · intro t t'
    have hc := h.2 (Fin.natAdd n t) (Fin.natAdd n t')
    have hceq1 : coord (fun x : G => Fin.append (α x) (β x)) (Fin.natAdd n t) = coord β t := by
      funext x
      simp [coord, Fin.append_right]
    have hceq2 : coord (fun x : G => Fin.append (α x) (β x)) (Fin.natAdd n t') = coord β t' := by
      funext x
      simp [coord, Fin.append_right]
    simpa [hceq1, hceq2] using hc


/-! ## Reading the normalization off the appended tuple (step (4)(c)-2)

Normalizing the appended `γ := α ++ β` (reference coordinate the first α-coordinate)
yields a common odd `B`; restricting the witness to the α-coordinates (positions
`castAdd i`) and to the β-coordinates (positions `natAdd (2n+1) t`) gives the two
witness triples used by the parity argument. -/

/-- Restricting the combined normalization to the α-part. -/
lemma sb_normalize_restrict_alpha {e n : ℕ} (v p q : G)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))))
    (hγ : CompBool e v p q (fun x : G => Fin.append (α x) (β x))) :
    ∃ (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) (B : ZMod (2 ^ (e + 1)))
      (nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1))),
      B ∉ evenSub e ∧
      (∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + B * nrm i x) ∧
      (∀ i : Fin (2 * n + 1), ∀ x : G, nrm i x = 0 ∨ nrm i x = 1) ∧
      (∀ i : Fin (2 * n + 1), IsBooleanAlt e v (fun x : G => nrm i x)) ∧
      (∀ i : Fin (2 * n + 1), periodicAlong p (fun x : G => nrm i x)) ∧
      (∀ i : Fin (2 * n + 1), periodicAlong q (fun x : G => nrm i x)) := by
  let w₀ : Fin ((2 * n + 1) + (2 * n - 1)) :=
    Fin.castAdd (2 * n - 1) (⟨0, by omega⟩ : Fin (2 * n + 1))
  let γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) :=
    fun x => Fin.append (α x) (β x)
  rcases (compbool_normalize_full (e := e) v p q w₀ γ hγ) with
    ⟨U, B, Nrm, hB, hU, hnrm, hbool, hper_p, hper_q⟩
  let u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)) := fun i => U (Fin.castAdd (2 * n - 1) i)
  let nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)) :=
    fun i x => Nrm (Fin.castAdd (2 * n - 1) i) x
  refine ⟨u, B, nrm, hB, ?_, ?_, ?_, ?_, ?_⟩
  · intro i x
    have hval := hU (Fin.castAdd (2 * n - 1) i) x
    -- γ x (castAdd i) = α x i
    change α x i = U (Fin.castAdd (2 * n - 1) i) + B * Nrm (Fin.castAdd (2 * n - 1) i) x
    -- γ x (castAdd i) = (append (αx)(βx)) (castAdd i) = α x i
    rw [← show (Fin.append (α x) (β x)) (Fin.castAdd (2 * n - 1) i) = α x i by
      exact Fin.append_left (α x) (β x) i]
    exact hval
  · intro i x
    exact hnrm (Fin.castAdd (2 * n - 1) i) x
  · intro i
    exact hbool (Fin.castAdd (2 * n - 1) i)
  · intro i
    exact hper_p (Fin.castAdd (2 * n - 1) i)
  · intro i
    exact hper_q (Fin.castAdd (2 * n - 1) i)

/-- Restricting the combined normalization to the β-part (same odd `B`). -/
lemma sb_normalize_restrict_beta {e n : ℕ} (v p q : G)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))))
    (hγ : CompBool e v p q (fun x : G => Fin.append (α x) (β x))) :
    ∃ (c : Fin (2 * n - 1) → ZMod (2 ^ (e + 1))) (B : ZMod (2 ^ (e + 1)))
      (bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1))),
      B ∉ evenSub e ∧
      (∀ t : Fin (2 * n - 1), ∀ x : G, β x t = c t + B * bt t x) ∧
      (∀ t : Fin (2 * n - 1), ∀ x : G, bt t x = 0 ∨ bt t x = 1) ∧
      (∀ t : Fin (2 * n - 1), IsBooleanAlt e v (fun x : G => bt t x)) ∧
      (∀ t : Fin (2 * n - 1), periodicAlong p (fun x : G => bt t x)) ∧
      (∀ t : Fin (2 * n - 1), periodicAlong q (fun x : G => bt t x)) := by
  let w₀ : Fin ((2 * n + 1) + (2 * n - 1)) :=
    Fin.castAdd (2 * n - 1) (⟨0, by omega⟩ : Fin (2 * n + 1))
  let γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) :=
    fun x => Fin.append (α x) (β x)
  rcases (compbool_normalize_full (e := e) v p q w₀ γ hγ) with
    ⟨U, B, Nrm, hB, hU, hnrm, hbool, hper_p, hper_q⟩
  let c : Fin (2 * n - 1) → ZMod (2 ^ (e + 1)) := fun t => U (Fin.natAdd (2 * n + 1) t)
  let bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1)) :=
    fun t x => Nrm (Fin.natAdd (2 * n + 1) t) x
  refine ⟨c, B, bt, hB, ?_, ?_, ?_, ?_, ?_⟩
  · intro t x
    have hval := hU (Fin.natAdd (2 * n + 1) t) x
    change β x t = U (Fin.natAdd (2 * n + 1) t) + B * Nrm (Fin.natAdd (2 * n + 1) t) x
    rw [← show (Fin.append (α x) (β x)) (Fin.natAdd (2 * n + 1) t) = β x t by
      exact Fin.append_right (α x) (β x) t]
    exact hval
  · intro t x
    exact hnrm (Fin.natAdd (2 * n + 1) t) x
  · intro t
    exact hbool (Fin.natAdd (2 * n + 1) t)
  · intro t
    exact hper_p (Fin.natAdd (2 * n + 1) t)
  · intro t
    exact hper_q (Fin.natAdd (2 * n + 1) t)


end
end Commons.PeriodicTiling

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! # Converse of P*_Ω (the parity summit)

From `P*` of the appended tuple `γ = α ++ β` (i.e. `CompBool` of `γ` plus the
constancy of the signed linear combination) we recover `P_Ω` of `α`, for the
single-pair `Ω = sb_OmegaPair ε`, odd width `W = 2n+1 ≥ 3`, with `4n < 2^{e+1}`.

Structure (paper tex 915-922): normalizing the combined tuple gives a common odd `B`
with `α = u + B·ñ`, `β = c + B·β̃`.  The signed constancy becomes
`B·(S(x) − T(x)) = C` with `S(x) := Σ_i R_{ε_i}(ñ_i)(x)`, `T(x) := Σ_t β̃_t(x)`, so
(cancelling the unit `B`) `D(x) := S(x) − T(x)` is constant; each `R_{ε_i}(ñ_i)` and
each `β̃_t` alternates along `v`, so `D(x+v) = 2 − D(x)`, and `2·D(x) = 2`.  With the
level `f(x) := #{t : β̃_t(x) = 1} ≤ W−2` we rule out `S(x) = 0` and `S(x) = W` (they
would force `2(f(x)+1) = 0` resp. `2·f(x) = 2(W−1)` in `ZMod (2^{e+1})`, impossible
when `2(W−1) < 2^{e+1}`), so the reflected tuple avoids the two constant tuples and
`(ñ x) ∈ sb_OmegaPair ε`. -/

/-- A nonzero natural below `2^(e+1)` does not vanish in `ZMod (2^(e+1))`. -/
lemma sb_natCast_ne_zero {e : ℕ} {m : ℕ} (hm0 : 0 < m) (hm : m < 2 ^ (e + 1)) :
    (m : ZMod (2 ^ (e + 1))) ≠ 0 := by
  intro h
  have hdvd : 2 ^ (e + 1) ∣ m := (ZMod.natCast_eq_zero_iff m (2 ^ (e + 1))).mp h
  have hle : 2 ^ (e + 1) ≤ m := Nat.le_of_dvd hm0 hdvd
  omega

/-- `natCast` is injective below `2^(e+1)`. -/
lemma sb_natCast_inj {e : ℕ} {m n : ℕ} (hmn : m < n) (hn : n < 2 ^ (e + 1)) :
    (m : ZMod (2 ^ (e + 1))) ≠ (n : ZMod (2 ^ (e + 1))) := by
  intro h
  have hmnle : m ≤ n := le_of_lt hmn
  have hsub0 : (n : ZMod (2 ^ (e + 1))) - (m : ZMod (2 ^ (e + 1))) = 0 := sub_eq_zero.mpr h.symm
  have hnm_sub : (((n - m : ℕ) : ZMod (2 ^ (e + 1)))) = 0 := by
    rw [Nat.cast_sub hmnle]
    exact hsub0
  have hdvd : 2 ^ (e + 1) ∣ n - m := (ZMod.natCast_eq_zero_iff (n - m) (2 ^ (e + 1))).mp hnm_sub
  have hnm0 : 0 < n - m := Nat.sub_pos_of_lt hmn
  have hle : 2 ^ (e + 1) ≤ n - m := Nat.le_of_dvd hnm0 hdvd
  have hnm : n - m < 2 ^ (e + 1) := lt_of_le_of_lt (Nat.sub_le n m) hn
  omega

/-- The level (number of ones of a tuple) is at most the number of coordinates. -/
lemma sb_levelTuple_le_card {e K : ℕ} (t : Fin K → ZMod (2 ^ (e + 1))) :
    sb_levelTuple t ≤ K := by
  classical
  rw [sb_levelTuple]
  simpa using (Finset.card_filter_le (s := (Finset.univ : Finset (Fin K)))
    (p := fun i : Fin K => t i = 1))

/-- Sum of ones over `Fin K` equals `K`. -/
lemma sb_sum_const_one {e K : ℕ} : (∑ i : Fin K, (1 : ZMod (2 ^ (e + 1)))) = (K : ZMod (2 ^ (e + 1))) := by
  rw [Finset.sum_const]
  simp

/-- A family alternating along `v` has its sum alternating: `Σ f(x+v) = K − Σ f(x)`. -/
lemma sb_sum_family_alt {e K : ℕ} (v : G) (f : Fin K → G → ZMod (2 ^ (e + 1)))
    (hf : ∀ i : Fin K, ∀ x : G, f i (x + v) = 1 - f i x) (x : G) :
    (∑ i : Fin K, f i (x + v)) = (K : ZMod (2 ^ (e + 1))) - (∑ i : Fin K, f i x) := by
  have hbody : (∑ i : Fin K, f i (x + v)) = (∑ i : Fin K, ((1 : ZMod (2 ^ (e + 1))) - f i x)) := by
    refine Finset.sum_congr rfl ?_
    intro i hi
    exact hf i x
  rw [hbody]
  rw [Finset.sum_sub_distrib]
  rw [sb_sum_const_one]

/-- The difference `D(x) := S(x) − T(x)` alternates: `D(x+v) = 2 − D(x)`. -/
lemma sb_D_alternation {e n : ℕ} (hn : 1 ≤ n) (v : G)
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)))
    (bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1))) (x : G)
    (hRalt : ∀ i : Fin (2 * n + 1), ∀ x : G,
      sb_reflFun ε nrm i (x + v) = 1 - sb_reflFun ε nrm i x)
    (hbtalt : ∀ t : Fin (2 * n - 1), ∀ x : G, bt t (x + v) = 1 - bt t x) :
    ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i (x + v)) -
        (∑ t : Fin (2 * n - 1), bt t (x + v))) =
      (2 : ZMod (2 ^ (e + 1))) -
        ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) -
          (∑ t : Fin (2 * n - 1), bt t x)) := by
  have hS := sb_sum_family_alt v (fun i : Fin (2 * n + 1) => fun y : G => sb_reflFun ε nrm i y)
    (fun i x => hRalt i x) x
  have hT := sb_sum_family_alt v (fun t : Fin (2 * n - 1) => fun y : G => bt t y)
    (fun t x => hbtalt t x) x
  have hsub : ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) - ((2 * n - 1 : ℕ) : ZMod (2 ^ (e + 1))) =
      (2 : ZMod (2 ^ (e + 1))) := by
    have hle : 2 * n - 1 ≤ 2 * n + 1 := by omega
    have hval : (2 * n + 1 - (2 * n - 1) : ℕ) = 2 := by omega
    rw [← Nat.cast_sub hle]
    rw [hval]
    simp
  rw [hS, hT]
  have hre : (((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) - (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x)) -
        (((2 * n - 1 : ℕ) : ZMod (2 ^ (e + 1))) - (∑ t : Fin (2 * n - 1), bt t x)) =
      (((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) - ((2 * n - 1 : ℕ) : ZMod (2 ^ (e + 1)))) -
        ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) - (∑ t : Fin (2 * n - 1), bt t x)) := by
    ring
  rw [hre, hsub]

/-- The signed linear combination of the appended tuple splits into the α-sum minus the
β-sum. -/
lemma sb_lin_append_eq {e n : ℕ} (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1)))) (x : G) :
    (∑ j : Fin ((2 * n + 1) + (2 * n - 1)),
        sb_linCoeff ε j * (Fin.append (α x) (β x)) j) =
      (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) -
        (∑ t : Fin (2 * n - 1), β x t) := by
  classical
  have hsplit := sb_linCoeff_sum (ε := ε) (γ := fun y : G => Fin.append (α y) (β y)) x
  rw [hsplit]
  have hβ : (∑ t : Fin (2 * n - 1), (-1 : ZMod (2 ^ (e + 1))) * (Fin.append (α x) (β x)) (Fin.natAdd (2 * n + 1) t))
      = - (∑ t : Fin (2 * n - 1), β x t) := by
    calc
      (∑ t : Fin (2 * n - 1), (-1 : ZMod (2 ^ (e + 1))) * (Fin.append (α x) (β x)) (Fin.natAdd (2 * n + 1) t))
          = (∑ t : Fin (2 * n - 1), (-1 : ZMod (2 ^ (e + 1))) * β x t) := by
        refine Finset.sum_congr rfl ?_
        intro t ht
        congr 1
        exact Fin.append_right (α x) (β x) t
      _ = - (∑ t : Fin (2 * n - 1), β x t) := by
        rw [← Finset.mul_sum]
        simp
  have hα : (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * (Fin.append (α x) (β x)) (Fin.castAdd (2 * n - 1) i))
      = (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) := by
    refine Finset.sum_congr rfl ?_
    intro i hi
    congr 1
    exact Fin.append_left (α x) (β x) i
  rw [hα, hβ]
  ring

/-- The combined signed identity `(Σ sign·α) − (Σ β) = z` at every `x`. -/
lemma sb_Pstar_const_alpha_beta {e n : ℕ} (v p q : G)
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))))
    (hz : ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
      (∑ j : Fin ((2 * n + 1) + (2 * n - 1)),
        sb_linCoeff ε j * (Fin.append (α x) (β x)) j) = z) :
    ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
      (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) -
        (∑ t : Fin (2 * n - 1), β x t) = z := by
  rcases hz with ⟨z, hz⟩
  refine ⟨z, ?_⟩
  intro x
  rw [← sb_lin_append_eq ε α β x]
  exact hz x

/-! ## The signed sum in terms of the normalized functions

For `α_i = u_i + B·ñ_i` and `β_t = c_t + B·β̃_t`, the sign identity
`sb_coord_sign_identity` (with the same odd `B`) gives
`(Σ sign·α) − (Σ β) = B·(S(x) − T(x)) + C` with the constant
`C := Σ_i d_i − Σ_t c_t`, `d_i := (if ε_i = 0 then u_i else −u_i − B)`. -/

/-- The signed α-sum minus the β-sum expressed through the normalizations. -/
lemma sb_signed_sum_of_reps {e n : ℕ} (B : ZMod (2 ^ (e + 1)))
    {ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1))}
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)))
    (hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + B * nrm i x)
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))))
    (c : Fin (2 * n - 1) → ZMod (2 ^ (e + 1)))
    (bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1)))
    (hβ : ∀ t : Fin (2 * n - 1), ∀ x : G, β x t = c t + B * bt t x)
    (x : G) :
    ((∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) -
        (∑ t : Fin (2 * n - 1), β x t)) =
      B * ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) -
        (∑ t : Fin (2 * n - 1), bt t x)) +
      ((∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B)) -
        (∑ t : Fin (2 * n - 1), c t)) := by
  classical
  have hsign : ∀ i : Fin (2 * n + 1),
      sb_signCoeff (ε i) * α x i =
        B * sb_reflFun ε nrm i x + (if ε i = 0 then u i else -u i - B) := by
    intro i
    have hs := sb_coord_sign_identity (n := n) B hε u hu i x
    simpa [sb_signCoeff] using hs
  have hαsum : (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) =
      B * (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) +
        (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B)) := by
    calc
      (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) =
          (∑ i : Fin (2 * n + 1), (B * sb_reflFun ε nrm i x +
            (if ε i = 0 then u i else -u i - B))) := by
        refine Finset.sum_congr rfl ?_
        intro i hi
        exact hsign i
      _ = B * (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) +
            (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B)) := by
        rw [Finset.sum_add_distrib]
        congr 1
        rw [Finset.mul_sum]
  have hβsum : (∑ t : Fin (2 * n - 1), β x t) =
      (∑ t : Fin (2 * n - 1), c t) + B * (∑ t : Fin (2 * n - 1), bt t x) := by
    calc
      (∑ t : Fin (2 * n - 1), β x t) = (∑ t : Fin (2 * n - 1), (c t + B * bt t x)) := by
        refine Finset.sum_congr rfl ?_
        intro t ht
        exact hβ t x
      _ = (∑ t : Fin (2 * n - 1), c t) + B * (∑ t : Fin (2 * n - 1), bt t x) := by
        rw [Finset.sum_add_distrib]
        congr 1
        rw [Finset.mul_sum]
  calc
    ((∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) -
        (∑ t : Fin (2 * n - 1), β x t)) =
      (B * (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) +
          (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B))) -
        ((∑ t : Fin (2 * n - 1), c t) + B * (∑ t : Fin (2 * n - 1), bt t x)) := by
      rw [hαsum, hβsum]
    _ = B * ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) -
          (∑ t : Fin (2 * n - 1), bt t x)) +
        ((∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B)) -
          (∑ t : Fin (2 * n - 1), c t)) := by
      ring

/-! ## Parity contradictions

With `D(x) := S(x) − T(x)` satisfying `2·D(x) = 2` (derived below from the
constancy and the alternation), `S(x) = 0` (all reflected coordinates `0`) and
`S(x) = W` (all `1`) are impossible. -/

/-- From `2(S−T)=2` and `S=0` we get `2(T+1)=0`. -/
lemma sb_parity_S0_ring {e : ℕ} {S T : ZMod (2 ^ (e + 1))}
    (h2 : (2 : ZMod (2 ^ (e + 1))) * (S - T) = (2 : ZMod (2 ^ (e + 1))))
    (hS : S = 0) : (2 : ZMod (2 ^ (e + 1))) * (T + 1) = 0 := by
  have h2' : (2 : ZMod (2 ^ (e + 1))) * (-T) = (2 : ZMod (2 ^ (e + 1))) := by
    simpa [hS] using h2
  linear_combination -h2'


/-- From `2(W−T)=2` we get `2T = 2W − 2`. -/
lemma sb_two_mul_of_W {R : Type*} [CommRing R] {W T : R} (hA : (2 : R) * (W - T) = (2 : R)) :
    (2 : R) * T = (2 : R) * W - (2 : R) := by
  have hlin : (2 : R) * (W - T) + (2 : R) * T = (2 : R) * W := by
    rw [← mul_add]
    ring
  have hlin' : (2 : R) + (2 : R) * T = (2 : R) * W := by simpa [hA] using hlin
  have h2W : (2 : R) * W = (2 : R) + (2 : R) * T := hlin'.symm
  calc
    (2 : R) * T = ((2 : R) + (2 : R) * T) - (2 : R) := by ring
    _ = (2 : R) * W - (2 : R) := by rw [h2W]

/-- `S(x) = 0` is impossible. -/
lemma sb_case_S0 {e n : ℕ} (hn : 1 ≤ n) (h4n : 4 * n < 2 ^ (e + 1))
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)))
    (bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1))) (x : G)
    (hbt01 : ∀ t : Fin (2 * n - 1), bt t x = 0 ∨ bt t x = 1)
    (hEq2 : (2 : ZMod (2 ^ (e + 1))) *
        (((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x)) -
          ((∑ t : Fin (2 * n - 1), bt t x))) = (2 : ZMod (2 ^ (e + 1))))
    (hS : ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x)) = 0) : False := by
  classical
  let S : ZMod (2 ^ (e + 1)) := ∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x
  let T : ZMod (2 ^ (e + 1)) := ∑ t : Fin (2 * n - 1), bt t x
  change (2 : ZMod (2 ^ (e + 1))) * (S - T) = (2 : ZMod (2 ^ (e + 1))) at hEq2
  change S = 0 at hS
  have hB : (2 : ZMod (2 ^ (e + 1))) * (T + 1) = 0 := sb_parity_S0_ring hEq2 hS
  let fβ : ℕ := sb_levelTuple (fun t : Fin (2 * n - 1) => bt t x)
  have hTlv : T = (fβ : ZMod (2 ^ (e + 1))) := by
    dsimp [T, fβ]
    exact sb_levelTuple_sum (fun t : Fin (2 * n - 1) => bt t x) hbt01
  have hB' : (2 : ZMod (2 ^ (e + 1))) * ((fβ + 1 : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by
    have hT1 : T + (1 : ZMod (2 ^ (e + 1))) = ((fβ + 1 : ℕ) : ZMod (2 ^ (e + 1))) := by
      calc
        T + (1 : ZMod (2 ^ (e + 1))) = (fβ : ZMod (2 ^ (e + 1))) + (1 : ZMod (2 ^ (e + 1))) := by rw [hTlv]
        _ = ((fβ + 1 : ℕ) : ZMod (2 ^ (e + 1))) := by
          rw [Nat.cast_add]
          norm_num
    rw [hT1] at hB
    exact hB
  have hcastm : ((2 * (fβ + 1) : ℕ) : ZMod (2 ^ (e + 1))) =
      (2 : ZMod (2 ^ (e + 1))) * ((fβ + 1 : ℕ) : ZMod (2 ^ (e + 1))) := by
    rw [Nat.cast_mul]
    norm_num
  have hC : ((2 * (fβ + 1) : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by
    rw [hcastm]
    exact hB'
  have hfβ : fβ ≤ 2 * n - 1 := by
    dsimp [fβ]
    exact sb_levelTuple_le_card (fun t : Fin (2 * n - 1) => bt t x)
  have hpos : 0 < 2 * (fβ + 1) := by positivity
  have hlt : 2 * (fβ + 1) < 2 ^ (e + 1) := by
    have hle1 : fβ + 1 ≤ 2 * n := by
      have : fβ ≤ 2 * n - 1 := hfβ
      omega
    have hle2 : 2 * (fβ + 1) ≤ 4 * n := by
      calc
        2 * (fβ + 1) ≤ 2 * (2 * n) := Nat.mul_le_mul_left 2 hle1
        _ = 4 * n := by ring
    exact lt_of_le_of_lt hle2 h4n
  exact (sb_natCast_ne_zero (e := e) hpos hlt) hC

/-- `S(x) = W` is impossible: from `2(W−T)=2` and `T` a sum of `W−2` boolean values,
`2·f(x) = 2(W−1)` is impossible as `f(x) ≤ W−2 < W−1`. -/
lemma sb_case_SW {e n : ℕ} (hn : 1 ≤ n) (h4n : 4 * n < 2 ^ (e + 1))
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)))
    (bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1))) (x : G)
    (hbt01 : ∀ t : Fin (2 * n - 1), bt t x = 0 ∨ bt t x = 1)
    (hEq2 : (2 : ZMod (2 ^ (e + 1))) *
        (((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x)) -
          ((∑ t : Fin (2 * n - 1), bt t x))) = (2 : ZMod (2 ^ (e + 1))))
    (hS : ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x)) =
      ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1)))) : False := by
  classical
  let S : ZMod (2 ^ (e + 1)) := ∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x
  let T : ZMod (2 ^ (e + 1)) := ∑ t : Fin (2 * n - 1), bt t x
  change (2 : ZMod (2 ^ (e + 1))) * (S - T) = (2 : ZMod (2 ^ (e + 1))) at hEq2
  change S = ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) at hS
  have hA : (2 : ZMod (2 ^ (e + 1))) * (((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) - T) =
      (2 : ZMod (2 ^ (e + 1))) := by
    rwa [hS] at hEq2
  -- 2(W − T) = 2 ⟹ 2T = 2W − 2
  have hB : (2 : ZMod (2 ^ (e + 1))) * T =
      (2 : ZMod (2 ^ (e + 1))) * ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) -
        (2 : ZMod (2 ^ (e + 1))) := by
    exact sb_two_mul_of_W hA
  let fβ : ℕ := sb_levelTuple (fun t : Fin (2 * n - 1) => bt t x)
  have hTlv : T = (fβ : ZMod (2 ^ (e + 1))) := by
    dsimp [T, fβ]
    exact sb_levelTuple_sum (fun t : Fin (2 * n - 1) => bt t x) hbt01
  -- (2:ZM)*T = (2*fβ : ZM); RHS = (4n : ZM)
  have hCastL : (2 : ZMod (2 ^ (e + 1))) * (fβ : ZMod (2 ^ (e + 1))) =
      ((2 * fβ : ℕ) : ZMod (2 ^ (e + 1))) := by
    rw [Nat.cast_mul]
    norm_num
  have hCastR : (2 : ZMod (2 ^ (e + 1))) * ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) -
        (2 : ZMod (2 ^ (e + 1))) = ((4 * n : ℕ) : ZMod (2 ^ (e + 1))) := by
    have htwo : (2 : ZMod (2 ^ (e + 1))) = ((2 : ℕ) : ZMod (2 ^ (e + 1))) := by norm_num
    have hmul : (2 : ZMod (2 ^ (e + 1))) * ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) =
        ((2 * (2 * n + 1) : ℕ) : ZMod (2 ^ (e + 1))) := by
      rw [htwo, ← Nat.cast_mul]
    have hsubnat : 2 * (2 * n + 1) - 2 = 4 * n := by omega
    rw [hmul]
    rw [htwo]
    rw [← Nat.cast_sub (by omega : 2 ≤ 2 * (2 * n + 1))]
    rw [hsubnat]

  have hEq : (2 : ZMod (2 ^ (e + 1))) * (fβ : ZMod (2 ^ (e + 1))) =
      ((4 * n : ℕ) : ZMod (2 ^ (e + 1))) := by
    calc
      (2 : ZMod (2 ^ (e + 1))) * (fβ : ZMod (2 ^ (e + 1))) = (2 : ZMod (2 ^ (e + 1))) * T := by rw [hTlv]
      _ = (2 : ZMod (2 ^ (e + 1))) * ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) - (2 : ZMod (2 ^ (e + 1))) := hB
      _ = ((4 * n : ℕ) : ZMod (2 ^ (e + 1))) := hCastR
  have hEq' : ((2 * fβ : ℕ) : ZMod (2 ^ (e + 1))) = ((4 * n : ℕ) : ZMod (2 ^ (e + 1))) := by
    rw [hCastL] at hEq
    exact hEq
  have hfβ : fβ ≤ 2 * n - 1 := by
    dsimp [fβ]
    exact sb_levelTuple_le_card (fun t : Fin (2 * n - 1) => bt t x)
  have hmn : 2 * fβ < 4 * n := by
    have : fβ < 2 * n := by
      have h1 : fβ ≤ 2 * n - 1 := hfβ
      omega
    omega
  have hn4 : 4 * n < 2 ^ (e + 1) := h4n
  exact (sb_natCast_inj (e := e) hmn hn4) hEq'

/-! ## The converse: from `P*` of `α ++ β` to `P_Ω` of `α`

Normalizing the combined tuple `γ = α ++ β` with the common odd `B`, the signed
constancy of `P*` becomes `B·D(x) = C`; cancelling the unit `B` makes `D` constant,
and the alternation forces `2·D(x) = 2`, so `S(x) ≠ 0` and `S(x) ≠ W` for every `x`;
the reflected tuple therefore avoids both constant tuples, which is exactly
Ω-membership of `(ñ x)`. -/

/-- Converse: `P*` of the appended tuple gives `P_Ω` (single-pair Ω, odd `W = 2n+1`). -/
theorem sb_POmegaFull_of_Pstar {e n : ℕ} (hn : 1 ≤ n) (h4n : 4 * n < 2 ^ (e + 1))
    (v p q : G)
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1)
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (β : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))))
    (hP : sb_Pstar v p q ε (fun x : G => Fin.append (α x) (β x))) :
    sb_POmegaFull v p q (sb_OmegaPair ε) α := by
  classical
  let γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) :=
    fun x : G => Fin.append (α x) (β x)
  rcases hP with ⟨hγC, hz⟩
  -- normalization of the combined tuple
  let w₀ : Fin ((2 * n + 1) + (2 * n - 1)) :=
    Fin.castAdd (2 * n - 1) (⟨0, by omega⟩ : Fin (2 * n + 1))
  rcases (compbool_normalize_full (e := e) v p q w₀ γ hγC) with
    ⟨U, B, Nrm, hB, hγU, hN01, hNbool, hNper_p, hNper_q⟩
  let u : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)) := fun i => U (Fin.castAdd (2 * n - 1) i)
  let nrm : Fin (2 * n + 1) → G → ZMod (2 ^ (e + 1)) :=
    fun i x => Nrm (Fin.castAdd (2 * n - 1) i) x
  let c : Fin (2 * n - 1) → ZMod (2 ^ (e + 1)) := fun t => U (Fin.natAdd (2 * n + 1) t)
  let bt : Fin (2 * n - 1) → G → ZMod (2 ^ (e + 1)) :=
    fun t x => Nrm (Fin.natAdd (2 * n + 1) t) x
  -- the representations of the two parts
  have hu : ∀ i : Fin (2 * n + 1), ∀ x : G, α x i = u i + B * nrm i x := by
    intro i x
    have hγi := hγU (Fin.castAdd (2 * n - 1) i) x
    have hαi : (Fin.append (α x) (β x)) (Fin.castAdd (2 * n - 1) i) = α x i :=
      Fin.append_left (α x) (β x) i
    dsimp [γ] at hγi
    dsimp [u, nrm]
    rw [hαi] at hγi
    exact hγi
  have hβc : ∀ t : Fin (2 * n - 1), ∀ x : G, β x t = c t + B * bt t x := by
    intro t x
    have hγt := hγU (Fin.natAdd (2 * n + 1) t) x
    have hβt : (Fin.append (α x) (β x)) (Fin.natAdd (2 * n + 1) t) = β x t :=
      Fin.append_right (α x) (β x) t
    dsimp [γ] at hγt
    dsimp [c, bt]
    rw [hβt] at hγt
    exact hγt
  have hnrm01 : ∀ i : Fin (2 * n + 1), ∀ x : G, nrm i x = 0 ∨ nrm i x = 1 := by
    intro i x
    dsimp [nrm]
    exact hN01 (Fin.castAdd (2 * n - 1) i) x
  have hbt01 : ∀ t : Fin (2 * n - 1), ∀ x : G, bt t x = 0 ∨ bt t x = 1 := by
    intro t x
    dsimp [bt]
    exact hN01 (Fin.natAdd (2 * n + 1) t) x
  have hnrmbool : ∀ i : Fin (2 * n + 1), IsBooleanAlt e v (fun x : G => nrm i x) := by
    intro i
    dsimp [nrm]
    simpa using (hNbool (Fin.castAdd (2 * n - 1) i))
  have hbtbool : ∀ t : Fin (2 * n - 1), IsBooleanAlt e v (fun x : G => bt t x) := by
    intro t
    dsimp [bt]
    simpa using (hNbool (Fin.natAdd (2 * n + 1) t))
  have hper_p : ∀ i : Fin (2 * n + 1), periodicAlong p (fun x : G => nrm i x) := by
    intro i
    dsimp [nrm]
    simpa using (hNper_p (Fin.castAdd (2 * n - 1) i))
  have hper_q : ∀ i : Fin (2 * n + 1), periodicAlong q (fun x : G => nrm i x) := by
    intro i
    dsimp [nrm]
    simpa using (hNper_q (Fin.castAdd (2 * n - 1) i))
  -- alternations along v
  have hRalt : ∀ i : Fin (2 * n + 1), ∀ x : G,
      sb_reflFun ε nrm i (x + v) = 1 - sb_reflFun ε nrm i x := by
    exact sb_gamma_alternate v ε hε nrm hnrmbool (fun i x => hnrm01 i x)
  have hbtalt : ∀ t : Fin (2 * n - 1), ∀ x : G, bt t (x + v) = 1 - bt t x := by
    intro t x
    exact sb_boolean_alt_of_mem01 v (fun x : G => bt t x) (hbtbool t) (fun x => hbt01 t x) x
  -- the signed constancy, split through the representations
  have hcst2 : ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
      (∑ i : Fin (2 * n + 1), sb_signCoeff (ε i) * α x i) -
        (∑ t : Fin (2 * n - 1), β x t) = z := by
    have hzsimp : ∃ z : ZMod (2 ^ (e + 1)), ∀ x : G,
        (∑ j : Fin ((2 * n + 1) + (2 * n - 1)),
          sb_linCoeff ε j * (Fin.append (α x) (β x)) j) = z := by
      simpa [γ] using hz
    exact sb_Pstar_const_alpha_beta v p q ε α β hzsimp
  rcases hcst2 with ⟨z, hz⟩
  let C : ZMod (2 ^ (e + 1)) :=
    (∑ i : Fin (2 * n + 1), (if ε i = 0 then u i else -u i - B)) -
      (∑ t : Fin (2 * n - 1), c t)
  let D : G → ZMod (2 ^ (e + 1)) := fun x : G =>
    (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) - (∑ t : Fin (2 * n - 1), bt t x)
  have hBD : ∀ x : G, B * D x = z - C := by
    intro x
    have h1 := hz x
    have h2 := sb_signed_sum_of_reps (n := n) B hε α u nrm hu β c bt hβc x
    have h3' : B * D x + C = z := by
      dsimp [C, D]
      rw [h2] at h1
      exact h1
    -- B·D + C = z ⟹ B·D = z − C
    calc
      B * D x = (B * D x + C) - C := by ring
      _ = z - C := by rw [h3']
  have hBuni : IsUnit B := mef_IsUnit_of_not_evenSub hB
  have hDcst : ∀ x : G, D (x + v) = D x := by
    intro x
    have hb1 : B * D (x + v) = z - C := hBD (x + v)
    have hb2 : B * D x = z - C := hBD x
    have hEq : B * D (x + v) = B * D x := by
      calc
        B * D (x + v) = z - C := hb1
        _ = B * D x := hb2.symm
    have hEq' : D (x + v) * B = D x * B := by
      calc
        D (x + v) * B = B * D (x + v) := by rw [mul_comm]
        _ = B * D x := hEq
        _ = D x * B := by rw [mul_comm]
    exact IsUnit.mul_right_cancel hBuni hEq'
  have hDv : ∀ x : G, D (x + v) = (2 : ZMod (2 ^ (e + 1))) - D x := by
    intro x
    dsimp [D]
    exact sb_D_alternation (n := n) hn v ε nrm bt x hRalt hbtalt
  have hEq2 : ∀ x : G, (2 : ZMod (2 ^ (e + 1))) * D x = (2 : ZMod (2 ^ (e + 1))) := by
    intro x
    have hlin : D x = (2 : ZMod (2 ^ (e + 1))) - D x := by
      calc
        D x = D (x + v) := (hDcst x).symm
        _ = (2 : ZMod (2 ^ (e + 1))) - D x := hDv x
    calc
      (2 : ZMod (2 ^ (e + 1))) * D x = D x + D x := by ring
      _ = (2 : ZMod (2 ^ (e + 1))) := by
        have hadd := congrArg (fun w : ZMod (2 ^ (e + 1)) => w + D x) hlin
        rw [hadd]
        ring
  have hEq2s : ∀ x : G, (2 : ZMod (2 ^ (e + 1))) *
      ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) - (∑ t : Fin (2 * n - 1), bt t x)) =
        (2 : ZMod (2 ^ (e + 1))) := by
    intro x
    simpa [D] using hEq2 x
  have hS0 : ∀ x : G, ¬ ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) = 0) := by
    intro x hS
    exact sb_case_S0 (n := n) hn h4n ε nrm bt x (fun t => hbt01 t x) (hEq2s x) hS
  have hSW : ∀ x : G, ¬ ((∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) =
      ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1)))) := by
    intro x hS
    exact sb_case_SW (n := n) hn h4n ε nrm bt x (fun t => hbt01 t x) (hEq2s x) hS
  -- Ω-membership of the normalized tuple
  have hΩ : ∀ x : G, (fun w : Fin (2 * n + 1) => nrm w x) ∈ sb_OmegaPair ε := by
    intro x
    refine ⟨?_, ?_, ?_⟩
    · intro i
      exact hnrm01 i x
    · intro hall
      have hR0 : ∀ i : Fin (2 * n + 1), sb_reflFun ε nrm i x = 0 := by
        intro i
        rw [sb_reflFun_eval]
        rcases hε i with h0 | h1
        · have hn0 : nrm i x = 0 := by simpa [h0] using hall i
          simp [h0, hn0, sb_reflect]
        · have hn1 : nrm i x = 1 := by simpa [h1] using hall i
          simp [h1, hn1, sb_reflect, one_ne_zero_zmod e]
      apply hS0 x
      apply Finset.sum_eq_zero
      intro i hi
      exact hR0 i
    · intro hall
      have hR1 : ∀ i : Fin (2 * n + 1), sb_reflFun ε nrm i x = 1 := by
        intro i
        rw [sb_reflFun_eval]
        rcases hε i with h0 | h1
        · have hn1 : nrm i x = 1 := by
            have h10 : 1 - ε i = 1 := by rw [h0]; ring
            simpa [h10] using hall i
          simp [h0, hn1, sb_reflect]
        · have hn0 : nrm i x = 0 := by
            have h00 : 1 - ε i = 0 := by rw [h1]; ring
            simpa [h00] using hall i
          simp [h1, hn0, sb_reflect, one_ne_zero_zmod e]
      apply hSW x
      calc
        (∑ i : Fin (2 * n + 1), sb_reflFun ε nrm i x) = (∑ i : Fin (2 * n + 1), (1 : ZMod (2 ^ (e + 1)))) := by
          refine Finset.sum_congr rfl ?_
          intro i hi
          exact hR1 i
        _ = ((2 * n + 1 : ℕ) : ZMod (2 ^ (e + 1))) := by
          rw [sb_sum_const_one]
  -- assembly
  constructor
  · simpa [γ] using (compbool_of_append_left v p q α β hγC)
  · refine ⟨u, B, nrm, hB, hu, hnrm01, hnrmbool, hper_p, hper_q, hΩ⟩

/-! ## Assembly: `P_Ω` is weakly expressible (single-pair, odd `W`)

`sb_Pstar_weakExpressible` makes `P*` weakly expressible at the combined width; the
existential quantification over the `W−2` β-coordinates and the pointwise equivalence
`(∃β, P*(α++β)) ↔ P_ΩFull α` (forward: `sb_POmegaFull_forward`; converse:
`sb_POmegaFull_of_Pstar`) give `P_ΩFull` weakly expressible at width `W = 2n+1`. -/

/-- The single-pair `P_Ω` property (`Ω = sb_OmegaPair ε`, odd `W = 2n+1`) is weakly
expressible. -/
theorem sb_POmegaFull_weakExpressible {d n : ℕ} (e : ℕ) (he : 1 ≤ e) (hn : 1 ≤ n)
    (v p q : G) (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (h4n : 4 * n < 2 ^ (e + 1))
    (ε : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))
    (hε : ∀ i : Fin (2 * n + 1), ε i = 0 ∨ ε i = 1) :
    WeakExpressible (2 * n + 1) (fun α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) =>
      sb_POmegaFull v p q (sb_OmegaPair ε) α) := by
  have hPstarWE : WeakExpressible ((2 * n + 1) + (2 * n - 1))
      (fun γ : G → (Fin ((2 * n + 1) + (2 * n - 1)) → ZMod (2 ^ (e + 1))) =>
        sb_Pstar v p q ε γ) := by
    exact sb_Pstar_weakExpressible (d := d) (n := n) e he v p q h2v h2p h2q hind gens hpos hspan ε
  have hEx : WeakExpressible (2 * n + 1)
      (fun α₁ : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) =>
        ∃ α₀ : G → (Fin (2 * n - 1) → ZMod (2 ^ (e + 1))),
          sb_Pstar v p q ε (fun x : G => Fin.append (α₁ x) (α₀ x))) := by
    exact weakExpressible_existential (K := 2 * n + 1) (M₁ := 2 * n - 1) hPstarWE
  refine weakExpressible_congr (fun α => ?_) hEx
  constructor
  · intro h
    rcases h with ⟨β, hP⟩
    exact sb_POmegaFull_of_Pstar (n := n) hn h4n v p q ε hε α β hP
  · intro hPα
    exact sb_POmegaFull_forward (n := n) v p q hε hPα hn

/-! ## Reduction to general symmetric Ω (finite excluded pairs)

A reflection-symmetric Ω ⊆ {0,1}^W is the intersection of the single-pair sets
`sb_OmegaPair ε` over a finite family of excluded pairs `{ε, 1−ε}` (those pairs
disjoint from Ω).  Since `P_Ω` is independent of the normalization witness for
symmetric Ω (`sb_Omega_witness_independent`), `P_Ω` is the conjunction of the
single-pair properties, hence weakly expressible.  (Odd width `W = 2n+1`.) -/

/-- The intersection of the excluded-pair sets: the cube with each pair
`{εl, 1−εl}` removed. -/
def sb_OmegaExcl {e : ℕ} {W L : ℕ} (εs : Fin L → (Fin W → ZMod (2 ^ (e + 1)))) :
    Set (Fin W → ZMod (2 ^ (e + 1))) :=
  {t : Fin W → ZMod (2 ^ (e + 1)) |
    (∀ i : Fin W, t i = 0 ∨ t i = 1) ∧
    ∀ l : Fin L, (¬ (∀ i : Fin W, t i = εs l i)) ∧ (¬ (∀ i : Fin W, t i = 1 - εs l i))}

/-- The single-pair set is invariant under the global reflection `t ↦ 1−t`. -/
lemma sb_OmegaPair_symm {e K : ℕ} (ε : Fin K → ZMod (2 ^ (e + 1))) :
    sb_ΩSym (sb_OmegaPair ε) := by
  have hstep : ∀ t : Fin K → ZMod (2 ^ (e + 1)),
      t ∈ sb_OmegaPair ε → (fun w : Fin K => 1 - t w) ∈ sb_OmegaPair ε := by
    intro t ht
    rcases ht with ⟨hval, hnotε, hnot1ε⟩
    change (∀ i : Fin K, 1 - t i = 0 ∨ 1 - t i = 1) ∧
      (¬ ∀ i : Fin K, 1 - t i = ε i) ∧ (¬ ∀ i : Fin K, 1 - t i = 1 - ε i)
    refine ⟨?_, ?_, ?_⟩
    · intro i
      rcases hval i with h0 | h1
      · right
        rw [h0]
        ring
      · left
        rw [h1]
        ring
    · intro hmem
      apply hnot1ε
      intro i
      have hmt := hmem i
      calc
        t i = 1 - (1 - t i) := by ring
        _ = 1 - ε i := by rw [hmt]
    · intro hmem
      apply hnotε
      intro i
      have hmt := hmem i
      calc
        t i = 1 - (1 - t i) := by ring
        _ = 1 - (1 - ε i) := by rw [hmt]
        _ = ε i := by ring
  intro t
  constructor
  · exact hstep t
  · intro ht
    have ht' := hstep (fun w : Fin K => 1 - t w) ht
    have hback : (fun w : Fin K => 1 - (1 - t w)) = t := by
      funext w
      ring
    simpa [hback] using ht'

/-- The excluded-pairs set is invariant under the global reflection. -/
lemma sb_OmegaExcl_symm {e W L : ℕ} (εs : Fin L → (Fin W → ZMod (2 ^ (e + 1)))) :
    sb_ΩSym (sb_OmegaExcl εs) := by
  have hstep : ∀ t : Fin W → ZMod (2 ^ (e + 1)),
      t ∈ sb_OmegaExcl εs → (fun w : Fin W => 1 - t w) ∈ sb_OmegaExcl εs := by
    intro t ht
    rcases ht with ⟨hval, hexcl⟩
    change (∀ i : Fin W, 1 - t i = 0 ∨ 1 - t i = 1) ∧
      ∀ l : Fin L, (¬ ∀ i : Fin W, 1 - t i = εs l i) ∧
        (¬ ∀ i : Fin W, 1 - t i = 1 - εs l i)
    refine ⟨?_, ?_⟩
    · intro i
      rcases hval i with h0 | h1
      · right
        rw [h0]
        ring
      · left
        rw [h1]
        ring
    · intro l
      refine ⟨?_, ?_⟩
      · intro hmem
        apply (hexcl l).2
        intro i
        have hmt := hmem i
        calc
          t i = 1 - (1 - t i) := by ring
          _ = 1 - εs l i := by rw [hmt]
      · intro hmem
        apply (hexcl l).1
        intro i
        have hmt := hmem i
        calc
          t i = 1 - (1 - t i) := by ring
          _ = 1 - (1 - εs l i) := by rw [hmt]
          _ = εs l i := by ring
  intro t
  constructor
  · exact hstep t
  · intro ht
    have ht' := hstep (fun w : Fin W => 1 - t w) ht
    have hback : (fun w : Fin W => 1 - (1 - t w)) = t := by
      funext w
      ring
    simpa [hback] using ht'

/-- `P_Ω` is preserved by changing Ω to an extensionally equal set. -/
lemma sb_POmegaFull_congr {e K : ℕ} (v p q : G)
    {Ω₁ Ω₂ : Set (Fin K → ZMod (2 ^ (e + 1)))}
    (hΩ : ∀ t : Fin K → ZMod (2 ^ (e + 1)), t ∈ Ω₁ ↔ t ∈ Ω₂)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) :
    sb_POmegaFull v p q Ω₁ α ↔ sb_POmegaFull v p q Ω₂ α := by
  constructor
  · intro h
    rcases h with ⟨hC, u, b, nrm, hB, hu, hnrm, hbool, hp, hq, hmem⟩
    refine ⟨hC, u, b, nrm, hB, hu, hnrm, hbool, hp, hq, ?_⟩
    intro x
    exact (hΩ (fun w : Fin K => nrm w x)).mp (hmem x)
  · intro h
    rcases h with ⟨hC, u, b, nrm, hB, hu, hnrm, hbool, hp, hq, hmem⟩
    refine ⟨hC, u, b, nrm, hB, hu, hnrm, hbool, hp, hq, ?_⟩
    intro x
    exact (hΩ (fun w : Fin K => nrm w x)).mpr (hmem x)

/-- With no excluded pairs the constraint set is the whole cube. -/
lemma mem_sb_OmegaExcl_zero {e W : ℕ} (t : Fin W → ZMod (2 ^ (e + 1))) :
    t ∈ sb_OmegaExcl (L := 0) Fin.elim0 ↔ ∀ i : Fin W, t i = 0 ∨ t i = 1 := by
  simp [sb_OmegaExcl]

/-- For the whole-cube constraint, `P_Ω` is exactly the compatible boolean property. -/
lemma sb_POmegaFull_cube_iff_compbool {e K : ℕ} (v p q : G) (w₀ : Fin K)
    (α : G → (Fin K → ZMod (2 ^ (e + 1)))) :
    sb_POmegaFull v p q {t : Fin K → ZMod (2 ^ (e + 1)) | ∀ i : Fin K, t i = 0 ∨ t i = 1} α ↔
      CompBool e v p q α := by
  constructor
  · intro h
    exact h.1
  · intro hα
    rcases compbool_normalize_full (e := e) v p q w₀ α hα with
      ⟨u, b, nrm, hB, hu, hnrm, hbool, hp, hq⟩
    refine ⟨hα, u, b, nrm, hB, hu, hnrm, hbool, hp, hq, ?_⟩
    intro x
    change ∀ i : Fin K, nrm i x = 0 ∨ nrm i x = 1
    intro i
    exact hnrm i x

/-! ## The general symmetric `Ω` at odd width

For `Ω := sb_OmegaExcl εs` (the cube minus the finitely many excluded pairs
`{εs l, 1 − εs l}`) the property `P_Ω` is the conjunction of the single-pair
properties, so it is weakly expressible. -/

/-- Membership of the witnesses transfers between the single-pair sets through the
reflection symmetry (used to align the witnesses of the different `l`). -/
lemma sb_POmegaFull_conj_iff_excl {e n L : ℕ} (he : 1 ≤ e) (v p q : G)
    (εs : Fin L → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (hL : 0 < L) :
    (∀ l : Fin L, sb_POmegaFull v p q (sb_OmegaPair (εs l)) α) ↔
      sb_POmegaFull v p q (sb_OmegaExcl εs) α := by
  classical
  let w₀ : Fin (2 * n + 1) := ⟨0, by omega⟩
  constructor
  · intro hall
    let l₀ : Fin L := ⟨0, hL⟩
    have hComp : CompBool e v p q α := (hall l₀).1
    rcases (hall l₀) with ⟨_hC0, u₀, B₀, nrm₀, hB₀, hu₀, hnrm₀, hbool₀, hp₀, hq₀, hΩ₀⟩
    refine ⟨hComp, u₀, B₀, nrm₀, hB₀, hu₀, hnrm₀, hbool₀, hp₀, hq₀, ?_⟩
    intro x
    refine ⟨?_, ?_⟩
    · intro i
      exact hnrm₀ i x
    · intro l
      -- transfer the membership of (nrm₀ x) in single_l from l's own witness
      rcases (hall l) with ⟨_hCl, u_l, B_l, nrm_l, hB_l, hu_l, hnrm_l, _hbool_l, _hp_l, _hq_l, hΩ_l⟩
      have hmem := sb_Omega_witness_independent (e := e) he v p q w₀ (sb_OmegaPair (εs l))
        (sb_OmegaPair_symm (εs l)) α hComp u_l B_l nrm_l hu_l hB_l hnrm_l hΩ_l
        u₀ B₀ nrm₀ hu₀ hB₀ hnrm₀ x
      exact ⟨hmem.2.1, hmem.2.2⟩
  · intro hEx
    rcases hEx with ⟨hComp, u, B, nrm, hB, hu, hnrm, hbool, hp, hq, hmemEx⟩
    intro l
    refine ⟨hComp, u, B, nrm, hB, hu, hnrm, hbool, hp, hq, ?_⟩
    intro x
    rcases hmemEx x with ⟨hval, hexcl⟩
    exact ⟨hval, (hexcl l).1, (hexcl l).2⟩

/-- `P_Ω` for the cube-minus-excluded-pairs set (odd width `W = 2n+1`) is weakly
expressible (the full Proposition sym-bool in the single-pair-decomposed form). -/
theorem sb_POmegaFull_excl_weakExpressible {d n L : ℕ} (e : ℕ) (he : 1 ≤ e) (hn : 1 ≤ n)
    (v p q : G) (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens)
    (h4n : 4 * n < 2 ^ (e + 1))
    (εs : Fin L → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))))
    (hεs : ∀ l : Fin L, ∀ i : Fin (2 * n + 1), εs l i = 0 ∨ εs l i = 1) :
    WeakExpressible (2 * n + 1) (fun α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) =>
      sb_POmegaFull v p q (sb_OmegaExcl εs) α) := by
  classical
  by_cases hL : 0 < L
  · -- at least one excluded pair: conjunction of the single-pair properties
    have hsingle : ∀ l : Fin L, WeakExpressible (2 * n + 1)
        (fun α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) =>
          sb_POmegaFull v p q (sb_OmegaPair (εs l)) α) := by
      intro l
      exact sb_POmegaFull_weakExpressible (d := d) (n := n) e he hn v p q h2v h2p h2q hind
        gens hpos hspan h4n (εs l) (hεs l)
    have hconj : WeakExpressible (2 * n + 1)
        (fun α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) =>
          ∀ l : Fin L, sb_POmegaFull v p q (sb_OmegaPair (εs l)) α) := by
      exact weakExpressible_conj_fin (K := 2 * n + 1) hsingle
    refine weakExpressible_congr (fun α => ?_) hconj
    exact sb_POmegaFull_conj_iff_excl he v p q εs α hL
  · -- no excluded pairs: the whole cube; P_Ω is the compatible boolean property
    have hL0 : L = 0 := by omega
    subst L
    have hCube : ∀ (f : Fin 0 → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))) (α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))),
        sb_POmegaFull v p q (sb_OmegaExcl (L := 0) f) α ↔ CompBool e v p q α := by
      intro f α
      have hset : (sb_OmegaExcl (L := 0) (εs := f) : Set (Fin (2 * n + 1) → ZMod (2 ^ (e + 1)))) =
          {t : Fin (2 * n + 1) → ZMod (2 ^ (e + 1)) | ∀ i : Fin (2 * n + 1), t i = 0 ∨ t i = 1} := by
        ext t
        simp [sb_OmegaExcl]
      rw [hset]
      exact sb_POmegaFull_cube_iff_compbool v p q (⟨0, by omega⟩ : Fin (2 * n + 1)) α
    have hWE : WeakExpressible (2 * n + 1)
        (fun α : G → (Fin (2 * n + 1) → ZMod (2 ^ (e + 1))) => CompBool e v p q α) := by
      exact mef_weakExpressible_general (d := d) (K := 2 * n + 1) e he v p q h2v h2p h2q hind
        gens hpos hspan
    refine weakExpressible_congr (fun α => ?_) hWE
    exact (hCube εs α).symm

end
end Commons.PeriodicTiling

open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # The boolean periodized permutation along a direction (Prop. perm-express)

The paper's Definition "boolper" (tex 936-952): a `W`-tuple `α : G → (Fin W → ZMod (2^(e+1)))`
is a *boolean periodized permutation along `v`* if (after any normalization with an odd
common multiplier `b`) the map `j ↦ α̃ (x + jv)` is a bijection from `{0,..,2^W−1}` to
`{0,1}^W` for every `x`.  The paper's proof claim: a tuple obeys this property iff it
obeys the compatible boolean property `P` and solves the partition equation
`⊎_{j=0}^{2^W−1} α(x+jv) + (2Z/2^M Z)^W = (Z/2^M Z)^W`.

Because the parity (reduction mod 2) of `a + b·t` for odd `b` and `t ∈ {0,1}` is
`parity(a) + t`, the bijectivity of `j ↦ α̃(x+jv)` is equivalent to the bijectivity of
the *parity vector* map `j ↦ (par(α_w(x+jv)))_w` — a property that is completely
normalization-free.  This file proves the *general* claim: for any tuple `α` (no boolean
hypothesis!), the partition equation along `v` holds iff the parity-vector map is a
bijection at every `x`.  (The paper needs only the case where `α` is `P`-normalizable;
dropping the hypothesis is harmless.)  Then the partition equation is expressible by
definition (`singleEqSystem`), so the parity-bijection property is expressible too.

## Roadmap for this file
1. `permShift` — the shifts `j • v` for `j : Fin (2^W)`.
2. `evenTupleSub` — the subgroup `(2Z)^W` of the tuple group, and membership lemmas
   in terms of per-coordinate parity equality.
3. The parity-lift representative `{0,1}` of a `ZMod 2` element.
4. `permEq`/`permBijective` and the equivalence `permEq_iff_permBijective`.
5. Expressibility of `permBijective` over the tuple codomain. -/

variable {G : Type*} [AddCommGroup G]

/-- The shifts `j • v` indexed by `j : Fin (2^W)`. -/
def permShift (W : ℕ) (v : G) : Fin (2 ^ W) → G := fun j => (j.val : ℕ) • v

/-- The even-subgroup `(2Z/2^M Z)^W` of the tuple group. -/
def evenTupleSub (e W : ℕ) : AddSubgroup (Fin W → ZMod (2 ^ (e + 1))) where
  carrier := {y | ∀ w : Fin W, y w ∈ evenSub e}
  zero_mem' := by
    intro w
    exact (evenSub e).zero_mem
  add_mem' := by
    intro a b ha hb w
    exact (evenSub e).add_mem (ha w) (hb w)
  neg_mem' := by
    intro a ha w
    exact (evenSub e).neg_mem (ha w)

/-- The tuple group membership: `y ∈ t + (2Z)^W` iff every coordinate of `y` has the
same parity as the corresponding coordinate of `t`. -/
lemma mem_add_evenTupleSub_iff (e W : ℕ) (t y : Fin W → ZMod (2 ^ (e + 1))) :
    y ∈ t + (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))) ↔
      ∀ w : Fin W, parityIn e (y w) = parityIn e (t w) := by
  rw [mem_add_subgroup]
  constructor
  · intro hy w
    have hw : y w - t w ∈ evenSub e := hy w
    have hzero : parityIn e (y w - t w) = 0 := (parityIn_zero_iff_even e (y w - t w)).mpr hw
    dsimp [parityIn] at hzero
    rw [map_sub (parHom e) (y w) (t w)] at hzero
    exact sub_eq_zero.mp hzero
  · intro hpar w
    have hzero : parityIn e (y w) - parityIn e (t w) = 0 := by
      rw [hpar w]
      exact sub_self (parityIn e (t w))
    have hz' : parityIn e (y w - t w) = 0 := by
      dsimp [parityIn]
      rw [map_sub (parHom e) (y w) (t w)]
      exact hzero
    exact (parityIn_zero_iff_even e (y w - t w)).mpr hz'

/-- `0` has parity `0` in `ZMod (2^(e+1))`. -/
lemma parityIn_zero (e : ℕ) : parityIn e (0 : ZMod (2 ^ (e + 1))) = 0 := by
  exact (parityIn_zero_iff_even e 0).mpr (evenSub e).zero_mem

-- (unused helper removed)

/-- The lift of a `ZMod 2` element to its `{0,1}` representative in `ZMod (2^(e+1))`. -/
def parityLift (e : ℕ) (t : ZMod 2) : ZMod (2 ^ (e + 1)) :=
  if t = 0 then 0 else 1

/-- The lift has the given parity. -/
lemma parityIn_parityLift (e : ℕ) (t : ZMod 2) : parityIn e (parityLift e t) = t := by
  rcases zmod2_eq_zero_or_one t with h0 | h1
  · subst t
    simp [parityLift, parityIn_zero]
  · have ht0 : t ≠ 0 := by
      intro h
      rw [h1] at h
      exact zmod2_zero_ne_one h.symm
    simp [parityLift, ht0, h1, parityIn_one]

/-- The parity of a difference is zero iff the parities agree. -/
lemma parityIn_sub_eq_zero_iff (e : ℕ) (z1 z2 : ZMod (2 ^ (e + 1))) :
    parityIn e (z1 - z2) = 0 ↔ parityIn e z1 = parityIn e z2 := by
  dsimp [parityIn]
  rw [map_sub (parHom e) z1 z2]
  exact sub_eq_zero

/-! ## The partition equation and the parity-bijection property -/

/-- The partition equation `⊎_{j=0}^{2^W−1} (α (x + jv) + (2Z)^W) = (Z/2^M)^W` for
every `x`, as the single functional equation with `2^W` terms and the constant tile
`evenTupleSub`. -/
def permEq (e W : ℕ) (v : G) (α : G → (Fin W → ZMod (2 ^ (e + 1)))) : Prop :=
  singleEq (2 ^ W) (permShift W v)
    (fun _j : Fin (2 ^ W) => (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1))))) α

/-- The parity-vector bijection property: for every `x`, the map
`j ↦ (par (α_w (x + jv)))_w` is a bijection from `Fin (2^W)` to `(ZMod 2)^W`. -/
def permBijective (e W : ℕ) (v : G) (α : G → (Fin W → ZMod (2 ^ (e + 1)))) : Prop :=
  ∀ x : G, Function.Bijective
    (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (α (x + permShift W v j) w))

/-- If the parity-vector map is a bijection at `x`, then the partition equation holds
at `x`. -/
lemma permEq_of_permBijective (e W : ℕ) (v : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1)))) (x : G)
    (hbi : Function.Bijective
      (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (α (x + permShift W v j) w))) :
    ∀ y : (Fin W → ZMod (2 ^ (e + 1))),
      ∃! j : Fin (2 ^ W),
        y ∈ α (x + permShift W v j) +
          (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))) := by
  intro y
  let t : Fin W → ZMod 2 := fun w => parityIn e (y w)
  have hsurj : ∃ j : Fin (2 ^ W),
      (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (α (x + permShift W v j) w)) j = t :=
    hbi.surjective t
  rcases hsurj with ⟨j₀, hj₀⟩
  refine ⟨j₀, ?_, ?_⟩
  · exact (mem_add_evenTupleSub_iff e W (α (x + permShift W v j₀)) y).mpr (by
      intro w
      have hc := congrFun hj₀ w
      simpa [t] using hc.symm)
  · intro j hj
    have hmem := (mem_add_evenTupleSub_iff e W (α (x + permShift W v j)) y).mp hj
    apply hbi.injective
    funext w
    have hmemw : parityIn e (y w) = parityIn e (α (x + permShift W v j) w) := hmem w
    have hj₀w : parityIn e (α (x + permShift W v j₀) w) = parityIn e (y w) := by
      have hc := congrFun hj₀ w
      simpa [t] using hc
    exact hmemw.symm.trans hj₀w.symm

/-! ## The forward direction of the main equivalence -/

/-- If the partition equation holds, the parity-vector map is injective at each `x`. -/
lemma permBijective_injective_of_permEq (e W : ℕ) (v : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1)))) (x : G)
    (heq : ∀ y : (Fin W → ZMod (2 ^ (e + 1))),
      ∃! j : Fin (2 ^ W),
        y ∈ α (x + permShift W v j) +
          (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1))))) :
    Function.Injective
      (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (α (x + permShift W v j) w)) := by
  intro j j' hjj'
  let y : Fin W → ZMod (2 ^ (e + 1)) := α (x + permShift W v j)
  rcases heq y with ⟨j₀, hj₀, huniq⟩
  have hjm : y ∈ α (x + permShift W v j) +
      (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))) := by
    exact (mem_add_evenTupleSub_iff e W (α (x + permShift W v j)) y).mpr (by
      intro w
      change parityIn e (α (x + permShift W v j) w) = parityIn e (α (x + permShift W v j) w)
      rfl)
  have hjm' : y ∈ α (x + permShift W v j') +
      (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))) := by
    exact (mem_add_evenTupleSub_iff e W (α (x + permShift W v j')) y).mpr (by
      intro w
      change parityIn e (α (x + permShift W v j) w) = parityIn e (α (x + permShift W v j') w)
      exact congrFun hjj' w)
  have h1 : j = j₀ := huniq j hjm
  have h2 : j' = j₀ := huniq j' hjm'
  exact h1.trans h2.symm

/-- If the partition equation holds, the parity-vector map is surjective at each `x`. -/
lemma permBijective_surjective_of_permEq (e W : ℕ) (v : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1)))) (x : G)
    (heq : ∀ y : (Fin W → ZMod (2 ^ (e + 1))),
      ∃! j : Fin (2 ^ W),
        y ∈ α (x + permShift W v j) +
          (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1))))) :
    Function.Surjective
      (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (α (x + permShift W v j) w)) := by
  intro t
  let y : Fin W → ZMod (2 ^ (e + 1)) := fun w => parityLift e (t w)
  rcases heq y with ⟨j₀, hj₀, _⟩
  refine ⟨j₀, ?_⟩
  funext w
  have hw : parityIn e (y w) = parityIn e (α (x + permShift W v j₀) w) :=
    (mem_add_evenTupleSub_iff e W (α (x + permShift W v j₀)) y).mp hj₀ w
  calc
    parityIn e (α (x + permShift W v j₀) w) = parityIn e (y w) := hw.symm
    _ = t w := by
      change parityIn e (parityLift e (t w)) = t w
      exact parityIn_parityLift e (t w)

/-- The partition equation holds iff the parity-vector map is a bijection at every `x`.
(General claim of Prop. perm-express, with no boolean hypothesis on `α`.) -/
theorem permEq_iff_permBijective (e W : ℕ) (v : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1)))) :
    permEq e W v α ↔ permBijective e W v α := by
  constructor
  · intro heq x
    exact ⟨permBijective_injective_of_permEq e W v α x (heq x),
      permBijective_surjective_of_permEq e W v α x (heq x)⟩
  · intro hbi x y
    exact permEq_of_permBijective e W v α x (hbi x) y


/-! ## Expressibility of the parity-bijection property -/

/-- The tile `evenTupleSub` is nonempty. -/
lemma evenTupleSub_nonempty (e W : ℕ) : (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))).Nonempty := by
  refine ⟨fun _ => 0, ?_⟩
  intro w
  exact (evenSub e).zero_mem

/-- The partition equation `permEq` is expressible (it is the single-equation system). -/
theorem permEq_expressible (e W : ℕ) (v : G) :
    ExpressibleProperty (fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permEq e W v α) := by
  let S : FunctionalSystem G (Fin W → ZMod (2 ^ (e + 1))) :=
    singleEqSystem (2 ^ W) (permShift W v)
      (fun _j : Fin (2 ^ W) => (evenTupleSub e W : Set (Fin W → ZMod (2 ^ (e + 1)))))
  refine ⟨S, ?_, ?_⟩
  · intro i j
    exact evenTupleSub_nonempty e W
  · intro α
    rw [singleEq_solves]
    rfl

/-- The parity-bijection property `permBijective` is expressible. -/
theorem permBijective_expressible (e W : ℕ) (v : G) :
    ExpressibleProperty (fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permBijective e W v α) := by
  refine expressible_congr (P := fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permEq e W v α) ?_
    (permEq_expressible e W v)
  intro α
  exact permEq_iff_permBijective e W v α

/-! ## The boolean periodized permutation (paper Prop. perm-express)

The *boolean periodized permutation* property of a `W`-tuple along a direction `w`:
the tuple obeys the compatible boolean property `CompBool` (boolean along `v`, periodic
along `p,q`) and the parity-vector map `j ↦ parvec(α(x + jw))` is a bijection for every
`x`.  By `permEq_iff_permBijective` (the general claim) this is expressible; conjoined
with the weak expressibility of `CompBool` (Prop. multi-express) it is weakly
expressible — the paper's Proposition perm-express.  (The paper's version quantifies
the normalized boolean representatives; since a normalized coordinate has the form
`a_w + b·α̃_w` with `b` odd, `par(α_w) = par(a_w) + α̃_w` and the shift `par(a)` is a
fixed involution of the cube, so parity-vector bijectivity and `α̃`-bijectivity are
equivalent under the boolean hypothesis; the parity formulation avoids any
well-definedness issue with the two normalizations.) -/

/-- The boolean periodized permutation property along the direction `w`: compatible
boolean property plus the parity-vector bijection at every point. -/
def BoolPeriodizedPerm (e W : ℕ) (v p q w : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1)))) : Prop :=
  CompBool e v p q α ∧ permBijective e W w α

/-- The parity-bijection property is weakly expressible (from its expressibility). -/
theorem permBijective_weakExpressible (e W : ℕ) (v : G) :
    WeakExpressible W (fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permBijective e W v α) := by
  exact expressible_weak (K := W) (H := ZMod (2 ^ (e + 1)))
    (P := fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permBijective e W v α)
    (permBijective_expressible e W v)

/-- A boolean periodized permutation along `w` is weakly expressible
(paper Prop. perm-express). -/
theorem perm_express_weakExpressible {d W : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q w : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    WeakExpressible W (fun α : G → (Fin W → ZMod (2 ^ (e + 1))) =>
      BoolPeriodizedPerm e W v p q w α) := by
  exact weakExpressible_conj
    (P := fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => CompBool e v p q α)
    (Q := fun α : G → (Fin W → ZMod (2 ^ (e + 1))) => permBijective e W w α)
    (mef_weakExpressible_general (d := d) (K := W) e he v p q h2v h2p h2q hind gens hpos hspan)
    (permBijective_weakExpressible e W w)


/-! ## Alignment with the normalized boolean representatives

Given a `CompBool` tuple and any of its normalized representations
`α x w = u w + b · nrm w x` with `b` odd and `nrm w x ∈ {0,1}` (as produced by
`compbool_normalize_full`), the parity of `α` differs from `nrm` by the *fixed* vector
`par(u)`; translation by a fixed vector is a bijection, so the parity-vector map
(`permBijective`) is a bijection iff the normalized map `j ↦ (nrm w (x + jv))_w` is a
bijection.  This is the paper's observation that the boolean periodized permutation
property is independent of the chosen normalization (reflection symmetry). -/

/-- Parity of a sum is the sum of the parities. -/
lemma parityIn_add (e : ℕ) (z1 z2 : ZMod (2 ^ (e + 1))) :
    parityIn e (z1 + z2) = parityIn e z1 + parityIn e z2 := by
  dsimp [parityIn]
  exact map_add (parHom e) z1 z2

/-- Parity of an odd multiple of a `{0,1}`-valued element is the element's own parity. -/
lemma parityIn_odd_mul_01 (e : ℕ) {b : ZMod (2 ^ (e + 1))} (hb : b ∉ evenSub e)
    {t : ZMod (2 ^ (e + 1))} (ht : t = 0 ∨ t = 1) :
    parityIn e (b * t) = parityIn e t := by
  rcases ht with h0 | h1
  · subst t
    simp [parityIn_zero]
  · subst t
    have hb1 : parityIn e b = 1 := (parityIn_one_iff_odd e b).mpr hb
    simp [parityIn_one, hb1]

/-- Parity of `u + b·t` for `b` odd and `t ∈ {0,1}` splits. -/
lemma parityIn_normalized (e : ℕ) {u b t : ZMod (2 ^ (e + 1))} (hb : b ∉ evenSub e)
    (ht : t = 0 ∨ t = 1) :
    parityIn e (u + b * t) = parityIn e u + parityIn e t := by
  rw [parityIn_add, parityIn_odd_mul_01 e hb ht]

/-- Translating the values of a function by a fixed additive constant preserves
bijectivity. -/
lemma bijective_translate_iff {A B : Type*} [AddCommGroup B] (f : A → B) (c : B) :
    Function.Bijective (fun a => f a + c) ↔ Function.Bijective f := by
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro a1 a2 ha
      apply h.1
      exact congrArg (fun z => z + c) ha
    · intro b
      rcases h.2 (b + c) with ⟨a, ha⟩
      refine ⟨a, ?_⟩
      exact add_right_cancel ha
  · intro h
    refine ⟨?_, ?_⟩
    · intro a1 a2 ha
      apply h.1
      exact add_right_cancel ha
    · intro b
      rcases h.2 (b - c) with ⟨a, ha⟩
      refine ⟨a, ?_⟩
      calc
        f a + c = (b - c) + c := congrArg (fun z => z + c) ha
        _ = b := sub_add_cancel b c

/-- The parity-vector bijection along `v` is equivalent to the bijection of the
normalized boolean representatives `nrm` along `v`, for any valid normalization
(`α x w = u w + b · nrm w x`, `b` odd, `nrm w x ∈ {0,1}`). -/
theorem permBijective_iff_normalized {e W : ℕ} (v : G)
    (α : G → (Fin W → ZMod (2 ^ (e + 1))))
    {u : Fin W → ZMod (2 ^ (e + 1))} {b : ZMod (2 ^ (e + 1))}
    {nrm : Fin W → G → ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e)
    (hval : ∀ x : G, ∀ w : Fin W, α x w = u w + b * nrm w x)
    (hnrm01 : ∀ x : G, ∀ w : Fin W, nrm w x = 0 ∨ nrm w x = 1) :
    permBijective e W v α ↔
      ∀ x : G, Function.Bijective
        (fun j : Fin (2 ^ W) => fun w : Fin W => parityIn e (nrm w (x + permShift W v j))) := by
  constructor
  · intro hpb x
    let f : Fin (2 ^ W) → (Fin W → ZMod 2) :=
      fun j => fun w : Fin W => parityIn e (nrm w (x + permShift W v j))
    let c : Fin W → ZMod 2 := fun w => parityIn e (u w)
    have hid : (fun j : Fin (2 ^ W) => fun w : Fin W =>
        parityIn e (α (x + permShift W v j) w)) = fun j => f j + c := by
      funext j w
      change parityIn e (α (x + permShift W v j) w) =
        parityIn e (nrm w (x + permShift W v j)) + parityIn e (u w)
      rw [hval]
      rw [parityIn_normalized e hb (hnrm01 (x + permShift W v j) w)]
      rw [add_comm]
    have hg : Function.Bijective (fun j : Fin (2 ^ W) => fun w : Fin W =>
        parityIn e (α (x + permShift W v j) w)) := hpb x
    have hf : Function.Bijective f := (bijective_translate_iff (B := Fin W → ZMod 2) f c).mp (by
      rwa [← hid])
    exact hf
  · intro hbio x
    let f : Fin (2 ^ W) → (Fin W → ZMod 2) :=
      fun j => fun w : Fin W => parityIn e (nrm w (x + permShift W v j))
    let c : Fin W → ZMod 2 := fun w => parityIn e (u w)
    have hid : (fun j : Fin (2 ^ W) => fun w : Fin W =>
        parityIn e (α (x + permShift W v j) w)) = fun j => f j + c := by
      funext j w
      change parityIn e (α (x + permShift W v j) w) =
        parityIn e (nrm w (x + permShift W v j)) + parityIn e (u w)
      rw [hval]
      rw [parityIn_normalized e hb (hnrm01 (x + permShift W v j) w)]
      rw [add_comm]
    rw [hid]
    exact (bijective_translate_iff (B := Fin W → ZMod 2) f c).mpr (hbio x)



end

