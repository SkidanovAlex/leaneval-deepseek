noncomputable section

attribute [local instance] Classical.propDecidable

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]

/-! ## Weak-conjunction closure for weakly expressible tuple properties

`WeakExpressible K P` (P over `K`-tuples of `H`-values) is closed under finite
conjunctions.  Ingredients: padding expressibility by trailing dummy coordinates
(`expressible_pad`, from `liftSystem`), promotion of index equivalences to additive
equivalences of the value spaces (`addEquivFinCongr`), and coordinate-block
rearrangements (`swapTo`/`swapInv`/`swapBlocks`: `(α, a₁, a₂) ↦ (α, a₂, a₁)`).  All
lemmas are proven (0 sorries).  KEY TECHNIQUE for Fin-index arithmetic: `.val` of a
literal `⟨m, h⟩` is NOT rfl-reducible — use `simp [Fin.val_mk]` / `simpa [Fin.val_mk]`
to unfold it before `omega`/arithmetic. -/

/-- Expressible properties on `K₁`-tuples pad to `K₁+M`-tuples (trailing coordinates
free): expressibility of `P ∘ liftRestrict`. -/
theorem expressible_pad {K₁ M : ℕ} {P : (G → (Fin K₁ → H)) → Prop}
    (hP : ExpressibleProperty P) :
    ExpressibleProperty (fun γ : G → (Fin (K₁ + M) → H) => P (liftRestrict K₁ M γ)) := by
  rcases hP with ⟨S, hE, hiff⟩
  refine ⟨liftSystem K₁ M S, ?_, ?_⟩
  · exact liftSystem_E_nonempty K₁ M S hE
  · intro γ
    rw [liftSystem_solves]
    exact hiff (liftRestrict K₁ M γ)

/-- Promote an equivalence of the index types to an additive equivalence of the
function spaces. -/
def addEquivFinCongr {m n : ℕ} (φ : Fin m ≃ Fin n) : (Fin m → H) ≃+ (Fin n → H) where
  toFun t := fun i => t (φ.symm i)
  invFun t := fun i => t (φ i)
  left_inv t := by
    funext i
    simp
  right_inv t := by
    funext i
    simp
  map_add' t u := by
    funext i
    simp

/-- Move the `a₂`-block (`M₂`) before the `a₁`-block (`M₁`); positions `< K` fixed. -/
def swapTo (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) : Fin (K + (M₁ + M₂)) → H :=
  fun i => if h : i.val < K then t i
    else if hd : (i.val - K) < M₂ then t ⟨K + M₁ + (i.val - K), by
      have hi : i.val < K + (M₁ + M₂) := i.isLt
      omega⟩
    else t ⟨K + ((i.val - K) - M₂), by
      have hi : i.val < K + (M₁ + M₂) := i.isLt
      omega⟩

/-- The inverse reordering (move `a₁` before `a₂`). -/
def swapInv (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) : Fin (K + (M₁ + M₂)) → H :=
  fun i => if h : i.val < K then t i
    else if hd : (i.val - K) < M₁ then t ⟨K + M₂ + (i.val - K), by
      have hi : i.val < K + (M₁ + M₂) := i.isLt
      omega⟩
    else t ⟨K + ((i.val - K) - M₁), by
      have hi : i.val < K + (M₁ + M₂) := i.isLt
      omega⟩

/-- Evaluation of `swapTo` at a position before `K`. -/
lemma swapTo_eval_lt (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) {i : Fin (K + (M₁ + M₂))}
    (hi : i.val < K) : swapTo K M₁ M₂ t i = t i := by
  simp [swapTo, hi]

/-- Evaluation of `swapInv` at a position before `K`. -/
lemma swapInv_eval_lt (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) {i : Fin (K + (M₁ + M₂))}
    (hi : i.val < K) : swapInv K M₁ M₂ t i = t i := by
  simp [swapInv, hi]

/-- Evaluation of `swapTo` at an `a₂`-output position: `K ≤ p` with `p − K < M₂`. -/
lemma swapTo_eval_m2 (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H)
    {p : Fin (K + (M₁ + M₂))} (hge : K ≤ p.val) (hm : p.val - K < M₂) :
    swapTo K M₁ M₂ t p = t ⟨K + M₁ + (p.val - K), by omega⟩ := by
  simp [swapTo, show ¬ p.val < K by omega, hm]

/-- Evaluation of `swapTo` at an `a₁`-output position: `K ≤ p` with `M₂ ≤ p − K`. -/
lemma swapTo_eval_m1 (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H)
    {p : Fin (K + (M₁ + M₂))} (hge : K ≤ p.val) (hm : M₂ ≤ p.val - K) :
    swapTo K M₁ M₂ t p = t ⟨K + ((p.val - K) - M₂), by omega⟩ := by
  simp [swapTo, show ¬ p.val < K by omega, show ¬ p.val - K < M₂ by omega]

/-- Evaluation of `swapInv` at an `a₁`-input position: `K ≤ p` with `p − K < M₁`. -/
lemma swapInv_eval_m1 (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H)
    {p : Fin (K + (M₁ + M₂))} (hge : K ≤ p.val) (hm : p.val - K < M₁) :
    swapInv K M₁ M₂ t p = t ⟨K + M₂ + (p.val - K), by omega⟩ := by
  simp [swapInv, show ¬ p.val < K by omega, hm]

/-- Evaluation of `swapInv` at an `a₂`-input position: `K ≤ p` with `M₁ ≤ p − K`. -/
lemma swapInv_eval_m2 (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H)
    {p : Fin (K + (M₁ + M₂))} (hge : K ≤ p.val) (hm : M₁ ≤ p.val - K) :
    swapInv K M₁ M₂ t p = t ⟨K + ((p.val - K) - M₁), by omega⟩ := by
  simp [swapInv, show ¬ p.val < K by omega, show ¬ p.val - K < M₁ by omega]

lemma swapTo_inv (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) :
    swapInv K M₁ M₂ (swapTo K M₁ M₂ t) = t := by
  funext i
  by_cases hK : i.val < K
  · rw [swapInv_eval_lt K M₁ M₂ (swapTo K M₁ M₂ t) hK, swapTo_eval_lt K M₁ M₂ t hK]
  · have hge : K ≤ i.val := by omega
    by_cases ha : i.val - K < M₁
    · -- i in the a₁-block (d = i.val − K < M₁): swapInv maps i to K + M₂ + d; swapTo
      -- there (aux-part M₂ + d ≥ M₂) returns K + d = i.
      have hpa : K + M₂ + (i.val - K) < K + (M₁ + M₂) := by
        have hi : i.val < K + (M₁ + M₂) := i.isLt
        omega
      rw [swapInv_eval_m1 K M₁ M₂ (swapTo K M₁ M₂ t) hge ha]
      rw [swapTo_eval_m1 K M₁ M₂ t
        (by simpa [Fin.val_mk] using (by omega : K ≤ K + M₂ + (i.val - K)))
        (by simpa [Fin.val_mk] using (by omega : M₂ ≤ K + M₂ + (i.val - K) - K))]
      exact congrArg t (by
        apply Fin.ext
        simp [Fin.val_mk]
        omega)
    · -- i in the a₂-block (d₂ = i.val − K − M₁ < M₂): swapInv maps i to K + d₂; swapTo
      -- there (aux-part d₂ < M₂) returns K + M₁ + d₂ = i.
      have hma : M₁ ≤ i.val - K := by omega
      have hd : i.val - K - M₁ < M₂ := by omega
      have hpa : K + ((i.val - K) - M₁) < K + (M₁ + M₂) := by
        have hi : i.val < K + (M₁ + M₂) := i.isLt
        omega
      rw [swapInv_eval_m2 K M₁ M₂ (swapTo K M₁ M₂ t) hge hma]
      rw [swapTo_eval_m2 K M₁ M₂ t
        (by simpa [Fin.val_mk] using (by omega : K ≤ K + ((i.val - K) - M₁)))
        (by simpa [Fin.val_mk] using (by omega : K + ((i.val - K) - M₁) - K < M₂))]
      exact congrArg t (by
        apply Fin.ext
        simp [Fin.val_mk]
        omega)

/-- `swapTo` undoes `swapInv`. -/
lemma swapInv_to (K M₁ M₂ : ℕ) (t : Fin (K + (M₁ + M₂)) → H) :
    swapTo K M₁ M₂ (swapInv K M₁ M₂ t) = t := by
  funext i
  by_cases hK : i.val < K
  · rw [swapTo_eval_lt K M₁ M₂ (swapInv K M₁ M₂ t) hK, swapInv_eval_lt K M₁ M₂ t hK]
  · have hge : K ≤ i.val := by omega
    by_cases ha : i.val - K < M₂
    · -- i in an a₂-output position (d = i.val − K < M₂): swapTo maps i to K + M₁ + d;
      -- swapInv there (aux-part M₁ + d ≥ M₁) returns K + d = i.
      have hp : K + M₁ + (i.val - K) < K + (M₁ + M₂) := by
        have hi : i.val < K + (M₁ + M₂) := i.isLt
        omega
      rw [swapTo_eval_m2 K M₁ M₂ (swapInv K M₁ M₂ t) hge ha]
      rw [swapInv_eval_m2 K M₁ M₂ t
        (by simpa [Fin.val_mk] using (by omega : K ≤ K + M₁ + (i.val - K)))
        (by simpa [Fin.val_mk] using (by omega : M₁ ≤ K + M₁ + (i.val - K) - K))]
      exact congrArg t (by
        apply Fin.ext
        simp [Fin.val_mk]
        omega)
    · -- i in an a₁-output position (d₁ = i.val − K − M₂ < M₁): swapTo maps i to K + d₁;
      -- swapInv there (aux-part d₁ < M₁) returns K + M₂ + d₁ = i.
      have hma : M₂ ≤ i.val - K := by omega
      have hd : i.val - K - M₂ < M₁ := by omega
      have hpa : K + ((i.val - K) - M₂) < K + (M₁ + M₂) := by
        have hi : i.val < K + (M₁ + M₂) := i.isLt
        omega
      rw [swapTo_eval_m1 K M₁ M₂ (swapInv K M₁ M₂ t) hge hma]
      rw [swapInv_eval_m1 K M₁ M₂ t
        (by simpa [Fin.val_mk] using (by omega : K ≤ K + ((i.val - K) - M₂)))
        (by simpa [Fin.val_mk] using (by omega : K + ((i.val - K) - M₂) - K < M₁))]
      exact congrArg t (by
        apply Fin.ext
        simp [Fin.val_mk]
        omega)

/-- The block swap `(α, a₁, a₂) ↦ (α, a₂, a₁)` as an additive equivalence. -/
def swapBlocks (K M₁ M₂ : ℕ) : (Fin (K + (M₁ + M₂)) → H) ≃+ (Fin (K + (M₁ + M₂)) → H) where
  toFun := swapTo K M₁ M₂
  invFun := swapInv K M₁ M₂
  left_inv := swapTo_inv K M₁ M₂
  right_inv := swapInv_to K M₁ M₂
  map_add' t u := by
    funext i
    by_cases h : i.val < K
    · simp [swapTo, h]
    · by_cases hd : i.val - K < M₂
      · simp [swapTo, h, hd]
      · simp [swapTo, h, hd]

/-- The `(K+M₁)`-prefix of the reassociated `(α, a₁, a₂)`-tuple (in `(K+(M₁+M₂))`-order)
is `α ++ a₁`. -/
lemma weakconj_prefix_pp {K M₁ M₂ : ℕ} (u : Fin K → H) (v : Fin M₁ → H) (w : Fin M₂ → H) :
    firstFun (K + M₁) M₂ ((finAssocEquiv K M₁ M₂).symm (Fin.append u (Fin.append v w))) =
      Fin.append u v := by
  funext a
  refine Fin.addCases (motive := fun a : Fin (K + M₁) =>
    firstFun (K + M₁) M₂ ((finAssocEquiv K M₁ M₂).symm (Fin.append u (Fin.append v w))) a =
      Fin.append u v a) ?_ ?_ a
  · intro a0
    dsimp [firstFun]
    have hcast : Fin.cast (Nat.add_assoc K M₁ M₂) (Fin.castAdd M₂ (Fin.castAdd M₁ a0)) =
        (Fin.castAdd (M₁ + M₂) a0 : Fin (K + (M₁ + M₂))) := by
      apply Fin.ext
      simp [Fin.cast, Fin.castAdd]
    change (Fin.append u (Fin.append v w))
        (Fin.cast (Nat.add_assoc K M₁ M₂) (Fin.castAdd M₂ (Fin.castAdd M₁ a0))) =
        Fin.append u v (Fin.castAdd M₁ a0)
    rw [hcast]
    simp
  · intro b0
    dsimp [firstFun]
    have hcast : Fin.cast (Nat.add_assoc K M₁ M₂) (Fin.castAdd M₂ (Fin.natAdd K b0)) =
        (Fin.natAdd K (Fin.castAdd M₂ b0) : Fin (K + (M₁ + M₂))) := by
      apply Fin.ext
      simp [Fin.cast, Fin.castAdd, Fin.natAdd]
    change (Fin.append u (Fin.append v w))
        (Fin.cast (Nat.add_assoc K M₁ M₂) (Fin.castAdd M₂ (Fin.natAdd K b0))) =
        Fin.append u v (Fin.natAdd K b0)
    rw [hcast]
    simp

/-- Relabel `(K + (M₁ + M₂))`-functions to `((K + M₂) + M₁)`-functions (same values). -/
def weakconj_delta (K M₁ M₂ : ℕ) : (Fin (K + (M₁ + M₂)) → H) ≃+ (Fin ((K + M₂) + M₁) → H) :=
  addEquivFinCongr (finCongr (by omega : K + (M₁ + M₂) = (K + M₂) + M₁))

/-- Evaluation of `weakconj_delta`: a value-preserving relabeling (indices keep their
values under the type cast). -/
lemma delta_val (K M₁ M₂ : ℕ) (T : Fin (K + (M₁ + M₂)) → H) (j : Fin ((K + M₂) + M₁)) :
    (weakconj_delta K M₁ M₂ T) j = T (Fin.cast (by omega : (K + M₂) + M₁ = K + (M₁ + M₂)) j) := by
  change T ((finCongr (by omega : K + (M₁ + M₂) = (K + M₂) + M₁)).symm j) =
    T (Fin.cast (by omega : (K + M₂) + M₁ = K + (M₁ + M₂)) j)
  congr 1

/-- Reading `δ (swapTo T)` at an `α`-slot position (value `< K`) returns `T` at that
position (in `(K + (M₁ + M₂))`-order). -/
lemma delta_swapTo_lt (K M₁ M₂ : ℕ) (T : Fin (K + (M₁ + M₂)) → H) (a0 : Fin K) :
    (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ T)) (Fin.castAdd M₁ (Fin.castAdd M₂ a0)) =
      T (Fin.castAdd (M₁ + M₂) a0) := by
  rw [delta_val]
  change swapTo K M₁ M₂ T (Fin.cast (by omega : (K + M₂) + M₁ = K + (M₁ + M₂))
      (Fin.castAdd M₁ (Fin.castAdd M₂ a0))) = T (Fin.castAdd (M₁ + M₂) a0)
  rw [swapTo_eval_lt]
  · congr 1
  · simp [Fin.cast, Fin.castAdd]

/-- Reading `δ (swapTo T)` at an `a₂`-slot position (value `K + b0.val`) returns `T` at
the position `K + M₁ + b0.val` (the `a₂`-block in `(K + (M₁ + M₂))`-order). -/
lemma delta_swapTo_m2 (K M₁ M₂ : ℕ) (T : Fin (K + (M₁ + M₂)) → H) (b0 : Fin M₂) :
    (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ T)) (Fin.castAdd M₁ (Fin.natAdd K b0)) =
      T (Fin.natAdd K (Fin.natAdd M₁ b0)) := by
  rw [delta_val]
  change swapTo K M₁ M₂ T (Fin.cast (by omega : (K + M₂) + M₁ = K + (M₁ + M₂))
      (Fin.castAdd M₁ (Fin.natAdd K b0))) = T (Fin.natAdd K (Fin.natAdd M₁ b0))
  rw [swapTo_eval_m2]
  · congr 1
    apply Fin.ext
    simp [Fin.cast, Fin.castAdd, Fin.natAdd]
    omega
  · simp [Fin.cast, Fin.castAdd, Fin.natAdd]
  · simp [Fin.cast, Fin.castAdd, Fin.natAdd]

/-- The `(K+M₂)`-prefix of the block-swapped `(α, a₁, a₂)`-tuple is `α ++ a₂`. -/
lemma weakconj_prefix_qq {K M₁ M₂ : ℕ} (u : Fin K → H) (v : Fin M₁ → H) (w : Fin M₂ → H) :
    firstFun (K + M₂) M₁ (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ (Fin.append u (Fin.append v w)))) =
      Fin.append u w := by
  funext a
  refine Fin.addCases (motive := fun a : Fin (K + M₂) =>
    firstFun (K + M₂) M₁ (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ (Fin.append u (Fin.append v w)))) a =
      Fin.append u w a) ?_ ?_ a
  · intro a0
    dsimp [firstFun]
    rw [delta_swapTo_lt K M₁ M₂ (Fin.append u (Fin.append v w)) a0]
    simp
  · intro b0
    dsimp [firstFun]
    rw [delta_swapTo_m2 K M₁ M₂ (Fin.append u (Fin.append v w)) b0]
    simp

theorem weakExpressible_conj {K : ℕ} {P Q : (G → (Fin K → H)) → Prop}
    (hP : WeakExpressible K P) (hQ : WeakExpressible K Q) :
    WeakExpressible K (fun α : G → (Fin K → H) => P α ∧ Q α) := by
  classical
  rcases hP with ⟨M₁, P₁, hP₁_exp, hP₁_iff⟩
  rcases hQ with ⟨M₂, Q₁, hQ₁_exp, hQ₁_iff⟩
  let B := Fin (K + (M₁ + M₂)) → H
  -- the two witness conjuncts
  let PP : (G → B) → Prop := fun γ => P₁ (liftRestrict (K + M₁) M₂
    (fun x : G => (finAssocEquiv K M₁ M₂).symm (γ x)))
  let QQ : (G → B) → Prop := fun γ => Q₁ (liftRestrict (K + M₂) M₁
    (fun x : G => weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ (γ x))))
  -- expressibility of PP (pad P₁ to ((K+M₁)+M₂), then bring to (K+(M₁+M₂)))
  have hPP : ExpressibleProperty PP := by
    dsimp [PP]
    have hpad : ExpressibleProperty (fun γ : G → (Fin ((K + M₁) + M₂) → H) =>
        P₁ (liftRestrict (K + M₁) M₂ γ)) := by
      simpa using (expressible_pad (K₁ := K + M₁) (M := M₂) (P := P₁) hP₁_exp)
    simpa using (expressible_pointwise_equiv (finAssocEquiv (H := H) K M₁ M₂) hpad)
  -- expressibility of QQ (pad Q₁ to ((K+M₂)+M₁), bring to B via δ, then swap input)
  have hQQ : ExpressibleProperty QQ := by
    dsimp [QQ]
    have hpad : ExpressibleProperty (fun γ : G → (Fin ((K + M₂) + M₁) → H) =>
        Q₁ (liftRestrict (K + M₂) M₁ γ)) := by
      simpa using (expressible_pad (K₁ := K + M₂) (M := M₁) (P := Q₁) hQ₁_exp)
    -- read through δ: property over B of (fun x => padQ₁ (δ (γ x)))
    have hread : ExpressibleProperty (fun γ : G → B =>
        (fun β : G → (Fin ((K + M₂) + M₁) → H) => Q₁ (liftRestrict (K + M₂) M₁ β))
          (fun x : G => weakconj_delta K M₁ M₂ (γ x))) := by
      have hx := expressible_pointwise_equiv (weakconj_delta K M₁ M₂).symm hpad
      -- hx : Expressible (fun γ : G → B => padQ₁ (fun x => ((δ).symm).symm (γ x))); symm-symm = id
      simpa using hx
    -- now compose with swapTo (a self-additive-equivalence of B)
    have hsw : ExpressibleProperty (fun γ : G → B =>
        (fun β : G → B =>
          Q₁ (liftRestrict (K + M₂) M₁ (fun x : G => weakconj_delta K M₁ M₂ (β x))))
          (fun x : G => swapTo K M₁ M₂ (γ x))) := by
      have hy := expressible_pointwise_equiv ((swapBlocks K M₁ M₂).symm) hread
      -- hread's property at (swapBlocks.symm).symm (β) = swapBlocks (β) hmm: careful
      -- expressible_pointwise_equiv σ hP : P (fun x => σ.symm (β x)) with σ = (swapBlocks).symm
      -- σ.symm = swapBlocks, so property reads hread's body at (fun x => swapBlocks (β x)):
      simpa [swapBlocks] using hy
    simpa [swapBlocks] using hsw
  -- the combined expressible property
  have hstar : ExpressibleProperty (fun γ : G → B => PP γ ∧ QQ γ) := expressible_conj hPP hQQ
  refine ⟨M₁ + M₂, ?Pstar, ?exp, ?iff⟩
  · exact fun γ : G → (Fin (K + (M₁ + M₂)) → H) => PP γ ∧ QQ γ
  · simpa [B] using hstar
  · -- the iff: split/merge the auxiliary functions a = a₁ ++ a₂
    intro α
    constructor
    · intro hpq
      rcases hpq with ⟨hPα, hQα⟩
      rcases (hP₁_iff α).mp hPα with ⟨a₁, hP₁a⟩
      rcases (hQ₁_iff α).mp hQα with ⟨a₂, hQ₁a⟩
      let a : G → (Fin (M₁ + M₂) → H) := fun x => Fin.append (a₁ x) (a₂ x)
      refine ⟨a, ?_⟩
      constructor
      · -- PP (fun x => Fin.append (α x) (a x)): the (K+M₁)-prefix is α ++ a₁
        dsimp [PP, a]
        have hpre : liftRestrict (K + M₁) M₂
            (fun y : G => (finAssocEquiv K M₁ M₂).symm
              (Fin.append (α y) (Fin.append (a₁ y) (a₂ y)))) =
            (fun x : G => Fin.append (α x) (a₁ x)) := by
          funext x
          change firstFun (K + M₁) M₂ ((finAssocEquiv K M₁ M₂).symm
            (Fin.append (α x) (Fin.append (a₁ x) (a₂ x)))) = Fin.append (α x) (a₁ x)
          exact weakconj_prefix_pp (α x) (a₁ x) (a₂ x)
        simpa [hpre] using hP₁a
      · -- QQ (fun x => Fin.append (α x) (a x)): the (K+M₂)-prefix of the swapped tuple is
        -- α ++ a₂
        dsimp [QQ, a]
        have hpre : liftRestrict (K + M₂) M₁
            (fun y : G => weakconj_delta K M₁ M₂ (swapTo K M₁ M₂
              (Fin.append (α y) (Fin.append (a₁ y) (a₂ y))))) =
            (fun x : G => Fin.append (α x) (a₂ x)) := by
          funext x
          change firstFun (K + M₂) M₁ (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂
            (Fin.append (α x) (Fin.append (a₁ x) (a₂ x))))) = Fin.append (α x) (a₂ x)
          exact weakconj_prefix_qq (α x) (a₁ x) (a₂ x)
        simpa [hpre] using hQ₁a
    · intro hw
      rcases hw with ⟨a, hPQ⟩
      rcases hPQ with ⟨hPPa, hQQa⟩
      -- split a into a₁ (first M₁) and a₂ (last M₂)
      let a₁ : G → (Fin M₁ → H) := fun x i => a x (Fin.castAdd M₂ i)
      let a₂ : G → (Fin M₂ → H) := fun x j => a x (Fin.natAdd M₁ j)
      have hsplit : a = fun x : G => Fin.append (a₁ x) (a₂ x) := by
        funext x
        funext j
        refine Fin.addCases (motive := fun j : Fin (M₁ + M₂) => a x j = Fin.append (a₁ x) (a₂ x) j) ?_ ?_ j
        · intro i
          simp [a₁, Fin.append_left]
        · intro j
          simp [a₂, Fin.append_right]
      -- γ := fun x => Fin.append (α x) (a x)
      have hPPα : P₁ (fun x : G => Fin.append (α x) (a₁ x)) := by
        dsimp [PP] at hPPa
        have hpre : liftRestrict (K + M₁) M₂
            (fun y : G => (finAssocEquiv K M₁ M₂).symm (Fin.append (α y) (a y))) =
            (fun x : G => Fin.append (α x) (a₁ x)) := by
          funext x
          have hax : a x = Fin.append (a₁ x) (a₂ x) := by rw [hsplit]
          change firstFun (K + M₁) M₂ ((finAssocEquiv K M₁ M₂).symm
            (Fin.append (α x) (a x))) = Fin.append (α x) (a₁ x)
          rw [hax]
          exact weakconj_prefix_pp (α x) (a₁ x) (a₂ x)
        simpa [hpre] using hPPa
      have hQQα : Q₁ (fun x : G => Fin.append (α x) (a₂ x)) := by
        dsimp [QQ] at hQQa
        have hpre : liftRestrict (K + M₂) M₁
            (fun y : G => weakconj_delta K M₁ M₂ (swapTo K M₁ M₂ (Fin.append (α y) (a y)))) =
            (fun x : G => Fin.append (α x) (a₂ x)) := by
          funext x
          have hax : a x = Fin.append (a₁ x) (a₂ x) := by rw [hsplit]
          change firstFun (K + M₂) M₁ (weakconj_delta K M₁ M₂ (swapTo K M₁ M₂
            (Fin.append (α x) (a x)))) = Fin.append (α x) (a₂ x)
          rw [hax]
          exact weakconj_prefix_qq (α x) (a₁ x) (a₂ x)
        simpa [hpre] using hQQa
      exact ⟨(hP₁_iff α).mpr ⟨a₁, hPPα⟩, (hQ₁_iff α).mpr ⟨a₂, hQQα⟩⟩

end
end Commons.PeriodicTiling

open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]
variable {K₁ L : ℕ}

/-! ## Expressible properties are closed under reading a selection of coordinates

Given an injective selection `R : Fin K₁ → Fin L` of `K₁` coordinates out of `L`, an
expressible property of `K₁`-tuples lifts to the expressible property of `L`-tuples
obtained by reading the selected coordinates: the lifted system keeps the same
equations/shifts and replaces each colour set by its preimage under the selection map.
This is the tuple-space version of the paper's closure (i) ("lifting": adding dummy
coordinates is expressible) for arbitrary relabeled subsets. -/

/-- Membership in a translate of a selection-preimage tile projects to membership in the
translate of the original tile. -/
lemma mem_select_lift (R : Fin K₁ → Fin L) (t : Fin L → H) (E : Set (Fin K₁ → H))
    (y : Fin L → H) :
    (y ∈ t + {z : Fin L → H | (fun k => z (R k)) ∈ E}) ↔
      (fun k => y (R k)) ∈ (fun k => t (R k)) + E := by
  constructor
  · intro hy
    change y ∈ ({t} : Set (Fin L → H)) + {z : Fin L → H | (fun k => z (R k)) ∈ E} at hy
    rw [Set.mem_add] at hy
    rcases hy with ⟨u, hu, v, hv, hsum⟩
    simp at hu
    subst u
    change (fun k => y (R k)) ∈ ({fun k => t (R k)} : Set (Fin K₁ → H)) + E
    rw [Set.mem_add]
    refine ⟨fun k => t (R k), by simp, fun k => v (R k), ?_, ?_⟩
    · change (fun k => v (R k)) ∈ E
      exact hv
    · funext k
      exact congrFun hsum (R k)
  · intro hy
    change (fun k => y (R k)) ∈ ({fun k => t (R k)} : Set (Fin K₁ → H)) + E at hy
    rw [Set.mem_add] at hy
    rcases hy with ⟨u, hu, e, he, hsum⟩
    simp at hu
    subst u
    change y ∈ ({t} : Set (Fin L → H)) + {z : Fin L → H | (fun k => z (R k)) ∈ E}
    rw [Set.mem_add]
    refine ⟨t, by simp, fun l : Fin L => y l - t l, ?_, ?_⟩
    · change (fun k => (fun l : Fin L => y l - t l) (R k)) ∈ E
      have he' : (fun k : Fin K₁ => y (R k) - t (R k)) = e := by
        funext k
        have hk := congrFun hsum k
        rw [← hk]
        change (t (R k) + e k) - t (R k) = e k
        abel
      simpa [he'] using he
    · funext l
      simp

/-- The lifted system: same equations and shifts, colour sets the preimages under the
selection `R`. -/
def selectSystem (R : Fin K₁ → Fin L) (S : FunctionalSystem G (Fin K₁ → H)) :
    FunctionalSystem G (Fin L → H) where
  M := S.M
  J := S.J
  h := S.h
  E := fun i j => {z : Fin L → H | (fun k => z (R k)) ∈ S.E i j}

/-- Solving the lifted system is solving the original system on the selected
coordinates. -/
lemma selectSystem_solves (R : Fin K₁ → Fin L) (hR : Function.Injective R)
    (S : FunctionalSystem G (Fin K₁ → H)) (α : G → (Fin L → H)) :
    Solves (selectSystem R S) α ↔ Solves S (fun x : G => fun k => α x (R k)) := by
  unfold Solves
  constructor
  · intro h i x y₀
    let y : Fin L → H := fun l =>
      if hh : ∃ k : Fin K₁, R k = l then y₀ (Classical.choose hh) else 0
    have hy' : (fun k : Fin K₁ => y (R k)) = y₀ := by
      funext k
      have hk : ∃ k' : Fin K₁, R k' = R k := ⟨k, rfl⟩
      have hk' : Classical.choose hk = k := hR (Classical.choose_spec hk)
      simp [y, hk, hk']
    have h' : ∃! j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin L → H | (fun k => z (R k)) ∈ S.E i j}) := by
      simpa [selectSystem] using (h i x y)
    have hpq : ∀ j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin L → H | (fun k => z (R k)) ∈ S.E i j}) ↔
          y₀ ∈ (fun x : G => fun k => α x (R k)) (x + S.h i j) + S.E i j := by
      intro j
      calc
        y ∈ α (x + S.h i j) + ({z : Fin L → H | (fun k => z (R k)) ∈ S.E i j}) ↔
            (fun k => y (R k)) ∈ (fun k => α (x + S.h i j) (R k)) + S.E i j :=
              mem_select_lift R (α (x + S.h i j)) (S.E i j) y
        _ ↔ y₀ ∈ (fun x : G => fun k => α x (R k)) (x + S.h i j) + S.E i j := by
          rw [hy']
    exact FunctionalSystem.existsUnique_congr (fun j => (hpq j).symm) h'
  · intro h i x y
    have h' := h i x (fun k => y (R k))
    have hpq : ∀ j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin L → H | (fun k => z (R k)) ∈ S.E i j}) ↔
          (fun k => y (R k)) ∈ (fun x : G => fun k => α x (R k)) (x + S.h i j) + S.E i j := by
      intro j
      rw [mem_select_lift]
    exact FunctionalSystem.existsUnique_congr hpq h'

/-- Reading a selection of coordinates: expressibility of the pullback of an expressible
property along the selection. -/
theorem expressible_select {K₁ L : ℕ} (R : Fin K₁ → Fin L) (hR : Function.Injective R)
    {P : (G → (Fin K₁ → H)) → Prop} (hP : ExpressibleProperty P) :
    ExpressibleProperty (fun α : G → (Fin L → H) => P (fun x : G => fun k => α x (R k))) := by
  rcases hP with ⟨S, hE, hiff⟩
  have hE' : ∀ i j, ((selectSystem R S).E i j).Nonempty := by
    intro i j
    rcases hE i j with ⟨e, he⟩
    refine ⟨fun l : Fin L => if hh : ∃ k : Fin K₁, R k = l then e (Classical.choose hh) else 0, ?_⟩
    change (fun k : Fin K₁ => (if hh : ∃ k' : Fin K₁, R k' = R k then e (Classical.choose hh) else 0)) ∈ S.E i j
    have hback : (fun k : Fin K₁ => (if hh : ∃ k' : Fin K₁, R k' = R k then e (Classical.choose hh) else 0)) = e := by
      funext k
      have hk : ∃ k' : Fin K₁, R k' = R k := ⟨k, rfl⟩
      have hk' : Classical.choose hk = k := hR (Classical.choose_spec hk)
      simp [hk, hk']
    rw [hback]
    exact he
  refine ⟨selectSystem R S, hE', ?_⟩
  intro α
  exact (hiff (fun x : G => fun k => α x (R k))).trans (selectSystem_solves R hR S α).symm

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! ## Forward direction of multi-express, part 1: value structure in `ZMod 2^(e+1)`.

The given compatible boolean pair yields, per coordinate `i = 1,2`, witnesses
`(aᵢ, bᵢ)` with `aᵢ ∈ evenSub e`, `bᵢ ∉ evenSub e`, values in `{aᵢ, bᵢ}` and
alternation `αᵢ(x+v) = aᵢ + bᵢ - αᵢ x`.  We normalize to a common odd `b`:
pair `{aᵢ, bᵢ}` = `{uᵢ, uᵢ + b}` where `b := b₁ − a₁` (odd) and `uᵢ` is the
translate of `a₁` (u₁ = a₁, u₂ = t + a₁ from the compatibility translation).  Then
`(αᵢ(x) − uᵢ) + τ′ + τ″ ∈ {0, b, 2b, 3b}` (four distinct values, `b` odd) so the
binary decomposition `= 2βᵢ(x) + γᵢ(x)`, `βᵢ, γᵢ ∈ {0,b}`, is well defined.  This part
supplies the `ZMod`-level facts. -/

/-- `0` is even. -/
lemma mef_zero_even (e : ℕ) : (0 : ZMod (2 ^ (e + 1))) ∈ evenSub e := by
  exact (parityIn_zero_iff_even e 0).mpr (by simp [parityIn, parHom])

/-- The parity of a difference is the difference of the parities. -/
lemma mef_parity_sub (e : ℕ) (x y : ZMod (2 ^ (e + 1))) :
    parityIn e (x - y) = parityIn e x - parityIn e y := by
  dsimp [parityIn]
  exact map_sub (parHom e) x y

/-- If `a` is even and `b` is odd, then `b − a` is odd. -/
lemma mef_odd_sub_even {e : ℕ} {a b : ZMod (2 ^ (e + 1))}
    (ha : a ∈ evenSub e) (hb : b ∉ evenSub e) : b - a ∉ evenSub e := by
  intro hsub
  have hpa : parityIn e a = 0 := (parityIn_zero_iff_even e a).mp ha
  have hpb : parityIn e b = 1 := (parityIn_one_iff_odd e b).mpr hb
  have hps : parityIn e (b - a) = 0 := (parityIn_zero_iff_even e (b - a)).mp hsub
  have hcalc : parityIn e (b - a) = parityIn e b - parityIn e a := mef_parity_sub e b a
  rw [hcalc, hpa, hpb] at hps
  norm_num at hps

/-- The parity value equals the parity of the `val` representative. -/
lemma mef_parity_val (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    parityIn e z = ((z.val : ℕ) : ZMod 2) := by
  dsimp [parityIn, parHom]
  have hz : z = ((z.val : ℕ) : ZMod (2 ^ (e + 1))) := (ZMod.natCast_zmod_val z).symm
  rw [hz]
  simp

/-- An element outside the even subgroup has an odd natural representative. -/
lemma mef_odd_val_of_not_evenSub {e : ℕ} {z : ZMod (2 ^ (e + 1))}
    (hz : z ∉ evenSub e) : Odd z.val := by
  by_contra hnodd
  have hmod : z.val % 2 = 0 := by
    have h01 : z.val % 2 = 0 ∨ z.val % 2 = 1 := Nat.mod_two_eq_zero_or_one z.val
    exact h01.resolve_right (by
      intro h1
      exact hnodd (Nat.odd_iff.mpr h1))
  have h2 : (2 : ℕ) ∣ z.val := Nat.dvd_of_mod_eq_zero hmod
  have hz0 : ((z.val : ℕ) : ZMod 2) = 0 := (ZMod.natCast_eq_zero_iff z.val 2).mpr h2
  have hp0 : parityIn e z = 0 := by
    rw [mef_parity_val e z]
    exact hz0
  exact hz ((parityIn_zero_iff_even e z).mp hp0)

/-- An odd element of `ZMod (2^(e+1))` is a unit. -/
lemma mef_IsUnit_of_not_evenSub {e : ℕ} {z : ZMod (2 ^ (e + 1))}
    (hz : z ∉ evenSub e) : IsUnit z := by
  have hbodd : Odd z.val := mef_odd_val_of_not_evenSub hz
  have hcop : z.val.Coprime (2 ^ (e + 1)) := by
    exact (Nat.coprime_pow_right_iff (by omega : 0 < e + 1) z.val 2).mpr
      ((Nat.coprime_two_right).mpr hbodd)
  have hu : IsUnit (((z.val : ℕ) : ZMod (2 ^ (e + 1)))) :=
    (ZMod.isUnit_iff_coprime z.val (2 ^ (e + 1))).mpr hcop
  have hz : z = ((z.val : ℕ) : ZMod (2 ^ (e + 1))) := (ZMod.natCast_zmod_val z).symm
  rw [hz]
  exact hu

/-- Distinct small naturals stay distinct in `ZMod (2^(e+1))` (`e ≥ 1`). -/
lemma mef_natCast_ne {e : ℕ} (he : 1 ≤ e) {m n : ℕ} (hlt : m < n) (hn : n ≤ 3) :
    (m : ZMod (2 ^ (e + 1))) ≠ (n : ZMod (2 ^ (e + 1))) := by
  intro h
  have hmn : m ≤ n := le_of_lt hlt
  have hsub' : ((n - m : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by
    rw [Nat.cast_sub hmn]
    exact sub_eq_zero.mpr h.symm
  have hd : (2 ^ (e + 1) : ℕ) ∣ n - m :=
    (ZMod.natCast_eq_zero_iff (n - m) (2 ^ (e + 1))).mp hsub'
  have hpos : 0 < n - m := Nat.sub_pos_of_lt hlt
  have hle : 2 ^ (e + 1) ≤ n - m := Nat.le_of_dvd hpos hd
  have hq : 4 ≤ 2 ^ (e + 1) := by
    have h2e : 2 ≤ 2 ^ e := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) he
    calc 4 ≤ 2 * 2 := by norm_num
      _ ≤ 2 * 2 ^ e := Nat.mul_le_mul_left 2 h2e
      _ = 2 ^ (e + 1) := by rw [pow_succ]; ring
  omega

/-- The numerals `0,1,2,3` are pairwise distinct in `ZMod (2^(e+1))` (`e ≥ 1`). -/
lemma mef_numerals_distinct {e : ℕ} (he : 1 ≤ e) :
    (0 : ZMod (2 ^ (e + 1))) ≠ 1 ∧ (0 : ZMod (2 ^ (e + 1))) ≠ 2 ∧
      (0 : ZMod (2 ^ (e + 1))) ≠ 3 ∧ (1 : ZMod (2 ^ (e + 1))) ≠ 2 ∧
      (1 : ZMod (2 ^ (e + 1))) ≠ 3 ∧ (2 : ZMod (2 ^ (e + 1))) ≠ 3 := by
  have hn (a b : ℕ) (h : a < b) (hb : b ≤ 3) :
      ((a : ℕ) : ZMod (2 ^ (e + 1))) ≠ ((b : ℕ) : ZMod (2 ^ (e + 1))) :=
    mef_natCast_ne he h hb
  constructor
  · simpa using (hn 0 1 (by norm_num) (by norm_num))
  · constructor
    · simpa using (hn 0 2 (by norm_num) (by norm_num))
    · constructor
      · simpa using (hn 0 3 (by norm_num) (by norm_num))
      · constructor
        · simpa using (hn 1 2 (by norm_num) (by norm_num))
        · constructor
          · simpa using (hn 1 3 (by norm_num) (by norm_num))
          · simpa using (hn 2 3 (by norm_num) (by norm_num))

/-- `0`, `b`, `2b`, `3b` are pairwise distinct for odd `b`. -/
lemma mef_b_mul_three_distinct {e : ℕ} (he : 1 ≤ e) {b : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e) :
    b ≠ 0 ∧ (2 : ZMod (2 ^ (e + 1))) * b ≠ 0 ∧
      (3 : ZMod (2 ^ (e + 1))) * b ≠ 0 ∧
      b ≠ (2 : ZMod (2 ^ (e + 1))) * b ∧
      b ≠ (3 : ZMod (2 ^ (e + 1))) * b ∧
      (2 : ZMod (2 ^ (e + 1))) * b ≠ (3 : ZMod (2 ^ (e + 1))) * b := by
  have hub : IsUnit b := mef_IsUnit_of_not_evenSub hb
  have hd := mef_numerals_distinct (e := e) he
  have hc2 : (2 : ZMod (2 ^ (e + 1))) ≠ 0 := hd.2.1.symm
  have hc3 : (3 : ZMod (2 ^ (e + 1))) ≠ 0 := hd.2.2.1.symm
  have h12 : (1 : ZMod (2 ^ (e + 1))) ≠ (2 : ZMod (2 ^ (e + 1))) := hd.2.2.2.1
  have h13 : (1 : ZMod (2 ^ (e + 1))) ≠ (3 : ZMod (2 ^ (e + 1))) := hd.2.2.2.2.1
  have h23 : (2 : ZMod (2 ^ (e + 1))) ≠ (3 : ZMod (2 ^ (e + 1))) := hd.2.2.2.2.2
  have hb0 : b ≠ 0 := by
    intro hb0
    exact hb (by simpa [hb0] using (mef_zero_even e))
  refine ⟨hb0, ?_, ?_, ?_, ?_, ?_⟩
  · intro hz
    have hEq : (2 : ZMod (2 ^ (e + 1))) * b = (0 : ZMod (2 ^ (e + 1))) * b := by
      simpa using hz
    exact hc2 (IsUnit.mul_right_cancel hub hEq)
  · intro hz
    have hEq : (3 : ZMod (2 ^ (e + 1))) * b = (0 : ZMod (2 ^ (e + 1))) * b := by
      simpa using hz
    exact hc3 (IsUnit.mul_right_cancel hub hEq)
  · intro h
    have hEq : (1 : ZMod (2 ^ (e + 1))) * b = (2 : ZMod (2 ^ (e + 1))) * b := by
      simpa using h
    exact h12 (IsUnit.mul_right_cancel hub hEq)
  · intro h
    have hEq : (1 : ZMod (2 ^ (e + 1))) * b = (3 : ZMod (2 ^ (e + 1))) * b := by
      simpa using h
    exact h13 (IsUnit.mul_right_cancel hub hEq)
  · intro h
    have hEq : (2 : ZMod (2 ^ (e + 1))) * b = (3 : ZMod (2 ^ (e + 1))) * b := by
      simpa using h
    exact h23 (IsUnit.mul_right_cancel hub hEq)

/-! ## Forward direction, part 2: the `{0,1}`-coordinate map `χ` on `G`.

With a section `s` of `G ⧸ zSpanSubgroup v p q` and the `k`-part
`kpart v p q s g = -(s (mk g)) + g ∈ zSpanSubgroup v p q`, every `g` has a unique
`{0,1}`-coefficient triple `χ g := spanCoeff (kpart g)` (the `v`-coefficient
`χ g .1`, the `p`-coefficient `χ g .2.1`, the `q`-coefficient `χ g .2.2`).  Shifting
`g` by a span element `u` keeps the coset and shifts the kernel part by `u`
(`mef_kpart_shift_span`); the `spanCoeff_shift_*` lemmas of `multi_express` then give
the flip/invariance laws of `χ` under `v, v+p, q, p, v+q` — the seeds of `τ′`, `τ″`
alternation/periodicity. -/

/-- The `k`-part of a shift by a span element is the `k`-part shifted by it. -/
lemma mef_kpart_shift_span (v p q : G) (s : (G ⧸ zSpanSubgroup v p q) → G)
    (g : G) {u : G} (hu : u ∈ zSpanSubgroup v p q) :
    kpart v p q s (g + u) = kpart v p q s g + u := by
  have hC : QuotientAddGroup.mk (s := zSpanSubgroup v p q) (g + u) =
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) g := by
    rw [QuotientAddGroup.eq (s := zSpanSubgroup v p q) (a := g + u) (b := g)]
    have h : -(g + u) + g = -u := by abel
    rw [h]
    exact (zSpanSubgroup v p q).neg_mem hu
  calc
    kpart v p q s (g + u) = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) (g + u))) + (g + u) := rfl
    _ = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + (g + u) := by rw [hC]
    _ = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + g + u := by abel
    _ = kpart v p q s g + u := rfl

/-- The `{0,1}`-coordinate triple of the kernel part of `g`. -/
noncomputable def mef_chi (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) : ℤ × ℤ × ℤ :=
  spanCoeff v p q h2v h2p h2q (kpart v p q s g) (kpart_mem v p q s hs g)

/-- The coefficients of `χ g` are `{0,1}` and reconstruct the kernel part. -/
lemma mef_chi_spec (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    (c.1 = 0 ∨ c.1 = 1) ∧ (c.2.1 = 0 ∨ c.2.1 = 1) ∧ (c.2.2 = 0 ∨ c.2.2 = 1) ∧
      kpart v p q s g = c.1 • v + c.2.1 • p + c.2.2 • q := by
  dsimp [mef_chi]
  exact spanCoeff_spec v p q h2v h2p h2q (kpart v p q s g) (kpart_mem v p q s hs g)

/-- The `χ` coordinates of a shift by `v`: first coordinate flips. -/
lemma mef_chi_shift_v (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    let c' := mef_chi v p q h2v h2p h2q s hs (g + v)
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = c.2.2) := by
  intro c c'
  dsimp [mef_chi, c, c']
  have hshift : kpart v p q s (g + v) = kpart v p q s g + v :=
    mef_kpart_shift_span v p q s g (zSpan_mem_v v p q)
  have hk : kpart v p q s g ∈ zSpanSubgroup v p q := kpart_mem v p q s hs g
  have hk' : kpart v p q s (g + v) ∈ zSpanSubgroup v p q := kpart_mem v p q s hs (g + v)
  have hspec := spanCoeff_shift_v v p q hind h2v h2p h2q (kpart v p q s g) hk
  -- hspec speaks about spanCoeff (kpart g + v) (zSpan_add_v ...); convert via hshift
  have hsame : spanCoeff v p q h2v h2p h2q (kpart v p q s (g + v)) hk' =
      spanCoeff v p q h2v h2p h2q (kpart v p q s g + v) (zSpan_add_v v p q (kpart v p q s g) hk) := by
    exact spanCoeff_eq_of_eq v p q hind h2v h2p h2q hshift hk'
      (zSpan_add_v v p q (kpart v p q s g) hk)
  rw [hsame]
  exact hspec

/-- The `χ` coordinates of a shift by `q`: third coordinate flips. -/
lemma mef_chi_shift_q (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    let c' := mef_chi v p q h2v h2p h2q s hs (g + q)
    (c'.1 = c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = 1 - c.2.2) := by
  intro c c'
  dsimp [mef_chi, c, c']
  have hshift : kpart v p q s (g + q) = kpart v p q s g + q :=
    mef_kpart_shift_span v p q s g (zSpan_mem_q v p q)
  have hk : kpart v p q s g ∈ zSpanSubgroup v p q := kpart_mem v p q s hs g
  have hk' : kpart v p q s (g + q) ∈ zSpanSubgroup v p q := kpart_mem v p q s hs (g + q)
  have hspec := spanCoeff_shift_q v p q hind h2v h2p h2q (kpart v p q s g) hk
  have hsame : spanCoeff v p q h2v h2p h2q (kpart v p q s (g + q)) hk' =
      spanCoeff v p q h2v h2p h2q (kpart v p q s g + q) (zSpan_add_q v p q (kpart v p q s g) hk) := by
    exact spanCoeff_eq_of_eq v p q hind h2v h2p h2q hshift hk'
      (zSpan_add_q v p q (kpart v p q s g) hk)
  rw [hsame]
  exact hspec

/-- The `χ` coordinates of a shift by `v+p`: first two flip. -/
lemma mef_chi_shift_vp (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    let c' := mef_chi v p q h2v h2p h2q s hs (g + (v + p))
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = 1 - c.2.1) ∧ (c'.2.2 = c.2.2) := by
  intro c c'
  dsimp [mef_chi, c, c']
  have hvp : v + p ∈ zSpanSubgroup v p q :=
    (zSpanSubgroup v p q).add_mem (zSpan_mem_v v p q) (zSpan_mem_p v p q)
  have hshift : kpart v p q s (g + (v + p)) = kpart v p q s g + (v + p) :=
    mef_kpart_shift_span v p q s g hvp
  have hk : kpart v p q s g ∈ zSpanSubgroup v p q := kpart_mem v p q s hs g
  have hk' : kpart v p q s (g + (v + p)) ∈ zSpanSubgroup v p q := kpart_mem v p q s hs (g + (v + p))
  have hspec := spanCoeff_shift_vp v p q hind h2v h2p h2q (kpart v p q s g) hk
  have hsame : spanCoeff v p q h2v h2p h2q (kpart v p q s (g + (v + p))) hk' =
      spanCoeff v p q h2v h2p h2q (kpart v p q s g + (v + p))
        (zSpan_add_vp v p q (kpart v p q s g) hk) := by
    exact spanCoeff_eq_of_eq v p q hind h2v h2p h2q hshift hk'
      (zSpan_add_vp v p q (kpart v p q s g) hk)
  rw [hsame]
  exact hspec

/-- The `χ` coordinates of a shift by `p`: second coordinate flips. -/
lemma mef_chi_shift_p (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    let c' := mef_chi v p q h2v h2p h2q s hs (g + p)
    (c'.1 = c.1) ∧ (c'.2.1 = 1 - c.2.1) ∧ (c'.2.2 = c.2.2) := by
  intro c c'
  dsimp [mef_chi, c, c']
  have hshift : kpart v p q s (g + p) = kpart v p q s g + p :=
    mef_kpart_shift_span v p q s g (zSpan_mem_p v p q)
  have hk : kpart v p q s g ∈ zSpanSubgroup v p q := kpart_mem v p q s hs g
  have hk' : kpart v p q s (g + p) ∈ zSpanSubgroup v p q := kpart_mem v p q s hs (g + p)
  have hspec := spanCoeff_shift_p v p q hind h2v h2p h2q (kpart v p q s g) hk
  have hsame : spanCoeff v p q h2v h2p h2q (kpart v p q s (g + p)) hk' =
      spanCoeff v p q h2v h2p h2q (kpart v p q s g + p) (zSpan_add_p v p q (kpart v p q s g) hk) := by
    exact spanCoeff_eq_of_eq v p q hind h2v h2p h2q hshift hk'
      (zSpan_add_p v p q (kpart v p q s g) hk)
  rw [hsame]
  exact hspec

/-- The `χ` coordinates of a shift by `v+q`: first and third flip. -/
lemma mef_chi_shift_vq (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    let c := mef_chi v p q h2v h2p h2q s hs g
    let c' := mef_chi v p q h2v h2p h2q s hs (g + (v + q))
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = 1 - c.2.2) := by
  intro c c'
  dsimp [mef_chi, c, c']
  have hvq : v + q ∈ zSpanSubgroup v p q :=
    (zSpanSubgroup v p q).add_mem (zSpan_mem_v v p q) (zSpan_mem_q v p q)
  have hshift : kpart v p q s (g + (v + q)) = kpart v p q s g + (v + q) :=
    mef_kpart_shift_span v p q s g hvq
  have hk : kpart v p q s g ∈ zSpanSubgroup v p q := kpart_mem v p q s hs g
  have hk' : kpart v p q s (g + (v + q)) ∈ zSpanSubgroup v p q := kpart_mem v p q s hs (g + (v + q))
  have hspec := spanCoeff_shift_vq v p q hind h2v h2p h2q (kpart v p q s g) hk
  have hsame : spanCoeff v p q h2v h2p h2q (kpart v p q s (g + (v + q))) hk' =
      spanCoeff v p q h2v h2p h2q (kpart v p q s g + (v + q))
        (zSpan_add_vq v p q (kpart v p q s g) hk) := by
    exact spanCoeff_eq_of_eq v p q hind h2v h2p h2q hshift hk'
      (zSpan_add_vq v p q (kpart v p q s g) hk)
  rw [hsame]
  exact hspec

/-! ## Forward direction, part 2 continued: `τ′`, `τ″` from the `χ` coordinates.

`τ′` reads off the pair `(χ g .1, χ g .2.1)` = the `(v,p)`-coefficients, `τ″` the
pair `(χ g .1, χ g .2.2)` = the `(v,q)`-coefficients: both take the value `b` when the
two coefficients differ and `0` otherwise (values in `{0,b}`).  The `χ`-shift laws
give: `τ′(g+v) = b − τ′(g)` (alternation along `v`), `τ′` periodic along `v+p` and
`q`; `τ″(g+v) = b − τ″(g)`, `τ″` periodic along `p` and `v+q`. -/

/-- coefficient arithmetic: for `r,s ∈ {0,1}`, `1 − r ≠ s` iff `r = s`. -/
lemma mef_neq_flip {r s : ℤ} (hr : r = 0 ∨ r = 1) (hs : s = 0 ∨ s = 1) :
    (1 - r ≠ s) ↔ r = s := by
  rcases hr with rfl | rfl <;> rcases hs with rfl | rfl <;> norm_num

/-- coefficient arithmetic: for `r,s ∈ {0,1}`, `1 − r ≠ 1 − s` iff `r ≠ s`. -/
lemma mef_neq_flip_both {r s : ℤ} (hr : r = 0 ∨ r = 1) (hs : s = 0 ∨ s = 1) :
    (1 - r ≠ 1 - s) ↔ r ≠ s := by
  rcases hr with rfl | rfl <;> rcases hs with rfl | rfl <;> norm_num

/-- `τ′`: `b` on the (v,p)-coefficients differing, `0` otherwise. -/
noncomputable def mef_tau1 (e : ℕ) (b : ZMod (2 ^ (e + 1))) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) :
    G → ZMod (2 ^ (e + 1)) :=
  fun g => if (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1
    then b else 0

/-- `τ″`: `b` on the (v,q)-coefficients differing, `0` otherwise. -/
noncomputable def mef_tau2 (e : ℕ) (b : ZMod (2 ^ (e + 1))) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) :
    G → ZMod (2 ^ (e + 1)) :=
  fun g => if (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2
    then b else 0

/-- `τ′` takes only the two values `0` and `b`. -/
lemma mef_tau1_value (e : ℕ) (b : ZMod (2 ^ (e + 1))) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    mef_tau1 e b v p q h2v h2p h2q s hs g = b ∨
      mef_tau1 e b v p q h2v h2p h2q s hs g = 0 := by
  unfold mef_tau1
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1
  · left
    simp [hc]
  · right
    simp [hc]

/-- `τ″` takes only the two values `0` and `b`. -/
lemma mef_tau2_value (e : ℕ) (b : ZMod (2 ^ (e + 1))) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    mef_tau2 e b v p q h2v h2p h2q s hs g = b ∨
      mef_tau2 e b v p q h2v h2p h2q s hs g = 0 := by
  unfold mef_tau2
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2
  · left
    simp [hc]
  · right
    simp [hc]

/-- `τ′` alternates along `v`: `τ′(g+v) = b − τ′(g)`. -/
lemma mef_tau1_flip_v (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) (g : G) :
    mef_tau1 e b v p q h2v h2p h2q s hs (g + v) = b - mef_tau1 e b v p q h2v h2p h2q s hs g := by
  classical
  unfold mef_tau1
  have hspec := mef_chi_spec v p q h2v h2p h2q s hs g
  rcases hspec with ⟨hr, hs01, ht⟩
  have hcv := mef_chi_shift_v v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.1) ↔
      ¬ ((mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1) := by
    rw [hcv.1, hcv.2.1]
    have hfl : (1 - (mef_chi v p q h2v h2p h2q s hs g).1 ≠
          (mef_chi v p q h2v h2p h2q s hs g).2.1) ↔
        (mef_chi v p q h2v h2p h2q s hs g).1 = (mef_chi v p q h2v h2p h2q s hs g).2.1 :=
      mef_neq_flip hr hs01
    rw [hfl]
    by_cases h : (mef_chi v p q h2v h2p h2q s hs g).1 = (mef_chi v p q h2v h2p h2q s hs g).2.1
    · simp [h]
    · simp [h]
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1
  · -- tau1 g = b; tau1(g+v) = b - b = 0 (condition at g+v false)
    have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.1 := by
      intro hcond'
      exact (hiff.mp hcond') hc
    simp [hc, hn']
  · -- tau1 g = 0; tau1(g+v) = b (condition at g+v true)
    have hp : (mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.1 := by
      exact hiff.mpr hc
    simp [hc, hp]

/-- `τ″` alternates along `v`. -/
lemma mef_tau2_flip_v (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) (g : G) :
    mef_tau2 e b v p q h2v h2p h2q s hs (g + v) = b - mef_tau2 e b v p q h2v h2p h2q s hs g := by
  classical
  unfold mef_tau2
  have hspec := mef_chi_spec v p q h2v h2p h2q s hs g
  rcases hspec with ⟨hr, hs01, ht⟩
  have hcv := mef_chi_shift_v v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.2) ↔
      ¬ ((mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2) := by
    rw [hcv.1, hcv.2.2]
    have hfl : (1 - (mef_chi v p q h2v h2p h2q s hs g).1 ≠
          (mef_chi v p q h2v h2p h2q s hs g).2.2) ↔
        (mef_chi v p q h2v h2p h2q s hs g).1 = (mef_chi v p q h2v h2p h2q s hs g).2.2 :=
      mef_neq_flip hr ht.1
    rw [hfl]
    by_cases h : (mef_chi v p q h2v h2p h2q s hs g).1 = (mef_chi v p q h2v h2p h2q s hs g).2.2
    · simp [h]
    · simp [h]
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2
  · have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.2 := by
      intro hcond'
      exact (hiff.mp hcond') hc
    simp [hc, hn']
  · have hp : (mef_chi v p q h2v h2p h2q s hs (g + v)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + v)).2.2 := by
      exact hiff.mpr hc
    simp [hc, hp]

/-- `τ′` is periodic along `v+p`. -/
lemma mef_tau1_periodic_vp (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) :
    periodicAlong (v + p) (mef_tau1 e b v p q h2v h2p h2q s hs) := by
  classical
  intro g
  unfold mef_tau1
  have hspec := mef_chi_spec v p q h2v h2p h2q s hs g
  rcases hspec with ⟨hr, hs01, ht⟩
  have hcv := mef_chi_shift_vp v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + (v + p))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + p))).2.1) ↔
      (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1 := by
    rw [hcv.1, hcv.2.1]
    exact mef_neq_flip_both hr hs01
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1
  · have hp : (mef_chi v p q h2v h2p h2q s hs (g + (v + p))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + p))).2.1 := hiff.mpr hc
    simp [hc, hp]
  · have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + (v + p))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + p))).2.1 := by
      intro hcond'
      exact hc ((hiff.mp hcond'))
    simp [hc, hn']

/-- `τ′` is periodic along `q`. -/
lemma mef_tau1_periodic_q (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) :
    periodicAlong q (mef_tau1 e b v p q h2v h2p h2q s hs) := by
  classical
  intro g
  unfold mef_tau1
  have hcv := mef_chi_shift_q v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + q)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + q)).2.1) ↔
      (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1 := by
    rw [hcv.1, hcv.2.1]
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.1
  · have hp : (mef_chi v p q h2v h2p h2q s hs (g + q)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + q)).2.1 := hiff.mpr hc
    simp [hc, hp]
  · have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + q)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + q)).2.1 := by
      intro hcond'
      exact hc ((hiff.mp hcond'))
    simp [hc, hn']

/-- `τ″` is periodic along `p`. -/
lemma mef_tau2_periodic_p (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) :
    periodicAlong p (mef_tau2 e b v p q h2v h2p h2q s hs) := by
  classical
  intro g
  unfold mef_tau2
  have hcv := mef_chi_shift_p v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + p)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + p)).2.2) ↔
      (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2 := by
    rw [hcv.1, hcv.2.2]
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2
  · have hp : (mef_chi v p q h2v h2p h2q s hs (g + p)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + p)).2.2 := hiff.mpr hc
    simp [hc, hp]
  · have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + p)).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + p)).2.2 := by
      intro hcond'
      exact hc ((hiff.mp hcond'))
    simp [hc, hn']

/-- `τ″` is periodic along `v+q`. -/
lemma mef_tau2_periodic_vq (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (b : ZMod (2 ^ (e + 1))) :
    periodicAlong (v + q) (mef_tau2 e b v p q h2v h2p h2q s hs) := by
  classical
  intro g
  unfold mef_tau2
  have hspec := mef_chi_spec v p q h2v h2p h2q s hs g
  rcases hspec with ⟨hr, hs01, ht⟩
  have hcv := mef_chi_shift_vq v p q hind h2v h2p h2q s hs g
  dsimp at hcv
  have hiff : ((mef_chi v p q h2v h2p h2q s hs (g + (v + q))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + q))).2.2) ↔
      (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2 := by
    rw [hcv.1, hcv.2.2]
    exact mef_neq_flip_both hr ht.1
  by_cases hc : (mef_chi v p q h2v h2p h2q s hs g).1 ≠ (mef_chi v p q h2v h2p h2q s hs g).2.2
  · have hp : (mef_chi v p q h2v h2p h2q s hs (g + (v + q))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + q))).2.2 := hiff.mpr hc
    simp [hc, hp]
  · have hn' : ¬ (mef_chi v p q h2v h2p h2q s hs (g + (v + q))).1 ≠
        (mef_chi v p q h2v h2p h2q s hs (g + (v + q))).2.2 := by
      intro hcond'
      exact hc ((hiff.mp hcond'))
    simp [hc, hn']

/-! ## Forward direction, part 2c: `IsBooleanAlt` certificates for `τ′`, `τ″`

`IsBooleanAlt e v g` needs a witness pair `(a,b)` with `a ∈ evenSub e`, `b ∉ evenSub e`,
values in `{a, b}` and alternation `g(x+v) = a + b − g(x)`.  For `τ′`, `τ″` (values in
`{0, b}`, alternation `b − ·`) the pair is `(0, b)`. -/

/-- `τ′` is `(v,{0,b})`-boolean. -/
lemma mef_tau1_boolean (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (he : 1 ≤ e) (b : ZMod (2 ^ (e + 1))) (hb : b ∉ evenSub e) :
    IsBooleanAlt e v (mef_tau1 e b v p q h2v h2p h2q s hs) := by
  refine ⟨0, b, mef_zero_even e, hb, ?_, ?_⟩
  · intro x
    exact Or.symm (mef_tau1_value e b v p q h2v h2p h2q s hs x)
  · intro x
    simpa [zero_add] using (mef_tau1_flip_v v p q hind h2v h2p h2q s hs e b x)

/-- `τ″` is `(v,{0,b})`-boolean. -/
lemma mef_tau2_boolean (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C)
    (e : ℕ) (he : 1 ≤ e) (b : ZMod (2 ^ (e + 1))) (hb : b ∉ evenSub e) :
    IsBooleanAlt e v (mef_tau2 e b v p q h2v h2p h2q s hs) := by
  refine ⟨0, b, mef_zero_even e, hb, ?_, ?_⟩
  · intro x
    exact Or.symm (mef_tau2_value e b v p q h2v h2p h2q s hs x)
  · intro x
    simpa [zero_add] using (mef_tau2_flip_v v p q hind h2v h2p h2q s hs e b x)

/-! ## Forward direction, part 3: normalization of the `CompBool` pair

Given a `CompBool` 2-tuple, each coordinate `i = 0,1` is `(v,{aᵢ,bᵢ})`-boolean with
`aᵢ ∈ evenSub e`, `bᵢ ∉ evenSub e`; the coordinates are compatible, i.e. the ranges
(pairs `{a₁,b₁}`, `{a₂,b₂}`) are translates: `{a₂,b₂} = t + {a₁,b₁}`.  With
`b := b₁ − a₁` (odd) and `u₁ := a₁`, `u₂ := t + a₁`, both pairs are
`{uᵢ, uᵢ + b}`, so `σᵢ(x) := αᵢ(x) − uᵢ ∈ {0, b}` and `σᵢ(x+v) = b − σᵢ(x)` (the
alternation needed for the binary expansion in Part 4). -/

/-- Normalization of a `CompBool` 2-tuple to a common odd `b` with the two value
shifts `u₁, u₂`: the shifted functions take values in `{0,b}` and alternate along `v`. -/
lemma mef_compbool_normalize (e : ℕ) (v p q : G)
    (α : G → (Fin 2 → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α) :
    ∃ (u1 u2 b : ZMod (2 ^ (e + 1))), b ∉ evenSub e ∧
      (∀ x : G, (coord α (0 : Fin 2) x) - u1 = 0 ∨ (coord α (0 : Fin 2) x) - u1 = b) ∧
      (∀ x : G, (coord α (0 : Fin 2) (x + v)) - u1 = b - ((coord α (0 : Fin 2) x) - u1)) ∧
      (∀ x : G, (coord α (1 : Fin 2) x) - u2 = 0 ∨ (coord α (1 : Fin 2) x) - u2 = b) ∧
      (∀ x : G, (coord α (1 : Fin 2) (x + v)) - u2 = b - ((coord α (1 : Fin 2) x) - u2)) := by
  classical
  let Z := ZMod (2 ^ (e + 1))
  rcases hα with ⟨hcore, hcompat⟩
  rcases hcore (0 : Fin 2) with ⟨hp0, hq0, hb0⟩
  rcases hb0 with ⟨a1, b1, hE1, hO1, hval1, hsw1⟩
  rcases hcore (1 : Fin 2) with ⟨hp1, hq1, hb1⟩
  rcases hb1 with ⟨a2, b2, hE2, hO2, hval2, hsw2⟩
  -- compatibility: the ranges (pairs) are translates
  have hc01 := hcompat (0 : Fin 2) (1 : Fin 2)
  unfold CompatibleFunctions at hc01
  have hr0 : Set.range (coord α (0 : Fin 2)) = ({a1, b1} : Set Z) :=
    range_eq_pair e v (coord α (0 : Fin 2)) a1 b1 hval1 hsw1
  have hr1 : Set.range (coord α (1 : Fin 2)) = ({a2, b2} : Set Z) :=
    range_eq_pair e v (coord α (1 : Fin 2)) a2 b2 hval2 hsw2
  rw [hr0, hr1] at hc01
  rcases hc01 with ⟨t, ht⟩
  let u1 : Z := a1
  let b : Z := b1 - a1
  let u2 : Z := t + a1
  -- any value of coordinate 1 lies in {t + a1, t + b1}:
  have hval2t : ∀ x : G, coord α (1 : Fin 2) x = t + a1 ∨ coord α (1 : Fin 2) x = t + b1 := by
    intro x
    rcases hval2 x with hx | hx
    · rw [hx]
      have hmem : a2 ∈ ({a2, b2} : Set Z) := by simp
      have hmt : a2 ∈ t + ({a1, b1} : Set Z) := by
        rwa [ht] at hmem
      rcases (mem_add_element t ({a1, b1} : Set Z) a2).mp hmt with ⟨w, hw, hwz⟩
      simp at hw
      rcases hw with rfl | rfl
      · left
        exact hwz
      · right
        exact hwz
    · rw [hx]
      have hmem : b2 ∈ ({a2, b2} : Set Z) := by simp
      have hmt : b2 ∈ t + ({a1, b1} : Set Z) := by
        rwa [ht] at hmem
      rcases (mem_add_element t ({a1, b1} : Set Z) b2).mp hmt with ⟨w, hw, hwz⟩
      simp at hw
      rcases hw with rfl | rfl
      · left
        exact hwz
      · right
        exact hwz
  have hsum12 : a2 + b2 = u2 + (u2 + b) := by
    have ha2m : a2 = t + a1 ∨ a2 = t + b1 := by
      have hmem : a2 ∈ ({a2, b2} : Set Z) := by simp
      have hmt : a2 ∈ t + ({a1, b1} : Set Z) := by rwa [ht] at hmem
      rcases (mem_add_element t ({a1, b1} : Set Z) a2).mp hmt with ⟨w, hw, hwz⟩
      simp at hw
      rcases hw with rfl | rfl
      · left; exact hwz
      · right; exact hwz
    have hb2m : b2 = t + a1 ∨ b2 = t + b1 := by
      have hmem : b2 ∈ ({a2, b2} : Set Z) := by simp
      have hmt : b2 ∈ t + ({a1, b1} : Set Z) := by rwa [ht] at hmem
      rcases (mem_add_element t ({a1, b1} : Set Z) b2).mp hmt with ⟨w, hw, hwz⟩
      simp at hw
      rcases hw with rfl | rfl
      · left; exact hwz
      · right; exact hwz
    rcases ha2m with h1 | h1
    · rcases hb2m with h2 | h2
      · -- a2 = b2 = t + a1: impossible (a2 even, b2 odd)
        exfalso
        apply hO2
        rwa [h2, ← h1]
      · rw [h1, h2]
        dsimp [u2, b]
        ring
    · rcases hb2m with h2 | h2
      · rw [h1, h2]
        dsimp [u2, b]
        ring
      · -- a2 = b2 = t + b1: impossible
        exfalso
        apply hO2
        rwa [h2, ← h1]
  have hb_odd : b ∉ evenSub e := by
    dsimp [b]
    exact mef_odd_sub_even hE1 hO1
  refine ⟨u1, u2, b, hb_odd, ?_, ?_, ?_, ?_⟩
  · intro x
    rcases hval1 x with hx | hx
    · left
      rw [hx]
      dsimp [u1]
      simp
    · right
      rw [hx]
  · intro x
    calc
      coord α (0 : Fin 2) (x + v) - u1 = (a1 + b1 - coord α (0 : Fin 2) x) - u1 := by
          rw [hsw1 x]
      _ = b - (coord α (0 : Fin 2) x - u1) := by
          dsimp [u1, b]
          ring
  · intro x
    rcases hval2t x with hx | hx
    · left
      rw [hx]
      dsimp [u2]
      simp
    · right
      rw [hx]
      dsimp [u2, b]
      ring
  · intro x
    calc
      coord α (1 : Fin 2) (x + v) - u2 = (a2 + b2 - coord α (1 : Fin 2) x) - u2 := by
          rw [hsw2 x]
      _ = b - (coord α (1 : Fin 2) x - u2) := by
          dsimp [u2, b] at hsum12 ⊢
          rw [hsum12]
          ring

/-! ## Forward direction, part 4: the binary expansion `2β + γ`

For a value `s ∈ {0, b, 2b, 3b}` (with `b` odd, so the four values are distinct), the
unique decomposition `s = 2β + γ` with `β, γ ∈ {0, b}` is `β = b·[s ∈ {2b,3b}]`,
`γ = b·[s ∈ {b,3b}]`.  Under the reflection `s ↦ 3b − s` (which is how `s(x+v)`
relates to `s(x)`), `β` and `γ` reflect: `β(3b−s) = b − β(s)`, `γ(3b−s) = b − γ(s)`. -/

/-- The binary `2`-digit of `s` (`b` if `s ∈ {2b,3b}`, else `0`). -/
def mef_beta (e : ℕ) (b s : ZMod (2 ^ (e + 1))) : ZMod (2 ^ (e + 1)) :=
  if s = (2 : ZMod (2 ^ (e + 1))) * b ∨ s = (3 : ZMod (2 ^ (e + 1))) * b then b else 0

/-- The binary `1`-digit of `s` (`b` if `s ∈ {b,3b}`, else `0`). -/
def mef_gamma (e : ℕ) (b s : ZMod (2 ^ (e + 1))) : ZMod (2 ^ (e + 1)) :=
  if s = b ∨ s = (3 : ZMod (2 ^ (e + 1))) * b then b else 0

/-- A sum of three `{0,b}`-valued elements is one of `0, b, 2b, 3b`. -/
lemma mef_three_sum_values (e : ℕ) {b x y z : ZMod (2 ^ (e + 1))}
    (hx : x = 0 ∨ x = b) (hy : y = 0 ∨ y = b) (hz : z = 0 ∨ z = b) :
    x + y + z = 0 ∨ x + y + z = b ∨ x + y + z = (2 : ZMod (2 ^ (e + 1))) * b ∨
      x + y + z = (3 : ZMod (2 ^ (e + 1))) * b := by
  rcases hx with hx | hx <;> rcases hy with hy | hy <;> rcases hz with hz | hz
  · left
    rw [hx, hy, hz]
    simp
  · right; left
    rw [hx, hy, hz]
    ring
  · right; left
    rw [hx, hy, hz]
    ring
  · right; right; left
    rw [hx, hy, hz]
    ring
  · right; left
    rw [hx, hy, hz]
    ring
  · right; right; left
    rw [hx, hy, hz]
    ring
  · right; right; left
    rw [hx, hy, hz]
    ring
  · right; right; right
    rw [hx, hy, hz]
    ring

/-- The binary digits reconstruct `s` and are `{0,b}`-valued. -/
lemma mef_binary_digits (e : ℕ) (he : 1 ≤ e) {b s : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e)
    (hs : s = 0 ∨ s = b ∨ s = (2 : ZMod (2 ^ (e + 1))) * b ∨
      s = (3 : ZMod (2 ^ (e + 1))) * b) :
    (2 : ZMod (2 ^ (e + 1))) * mef_beta e b s + mef_gamma e b s = s ∧
      (mef_beta e b s = 0 ∨ mef_beta e b s = b) ∧
      (mef_gamma e b s = 0 ∨ mef_gamma e b s = b) := by
  have hd := mef_b_mul_three_distinct (e := e) he hb
  rcases hs with hs | hs | hs | hs
  · -- s = 0
    have hβ0 : mef_beta e b s = 0 := by
      dsimp [mef_beta, hs]
      have h1 : s ≠ (2 : ZMod (2 ^ (e + 1))) * b := by
        rw [hs]
        exact hd.2.1.symm
      have h2 : s ≠ (3 : ZMod (2 ^ (e + 1))) * b := by
        rw [hs]
        exact hd.2.2.1.symm
      simp [h1, h2]
    have hγ0 : mef_gamma e b s = 0 := by
      dsimp [mef_gamma, hs]
      have h1 : s ≠ b := by rw [hs]; exact hd.1.symm
      have h2 : s ≠ (3 : ZMod (2 ^ (e + 1))) * b := by
        rw [hs]
        exact hd.2.2.1.symm
      simp [h1, h2]
    refine ⟨?_, ?_, ?_⟩
    · rw [hβ0, hγ0, hs]
      simp
    · left
      exact hβ0
    · left
      exact hγ0
  · -- s = b
    have hβ0 : mef_beta e b s = 0 := by
      dsimp [mef_beta]
      rw [hs]
      have h1 : b ≠ (2 : ZMod (2 ^ (e + 1))) * b := hd.2.2.2.1
      have h2 : b ≠ (3 : ZMod (2 ^ (e + 1))) * b := hd.2.2.2.2.1
      simp [h1, h2]
    have hγb : mef_gamma e b s = b := by
      dsimp [mef_gamma]
      rw [hs]
      simp
    refine ⟨?_, ?_, ?_⟩
    · rw [hβ0, hγb, hs]
      simp
    · left
      exact hβ0
    · right
      exact hγb
  · -- s = 2b
    have hβb : mef_beta e b s = b := by
      dsimp [mef_beta]
      rw [hs]
      simp
    have hγ0 : mef_gamma e b s = 0 := by
      dsimp [mef_gamma]
      rw [hs]
      have h1 : (2 : ZMod (2 ^ (e + 1))) * b ≠ b := hd.2.2.2.1.symm
      have h2 : (2 : ZMod (2 ^ (e + 1))) * b ≠ (3 : ZMod (2 ^ (e + 1))) * b := hd.2.2.2.2.2
      simp [h1, h2]
    refine ⟨?_, ?_, ?_⟩
    · rw [hβb, hγ0, hs]
      ring
    · right
      exact hβb
    · left
      exact hγ0
  · -- s = 3b
    have hβb : mef_beta e b s = b := by
      dsimp [mef_beta]
      rw [hs]
      simp
    have hγb : mef_gamma e b s = b := by
      dsimp [mef_gamma]
      rw [hs]
      simp
    refine ⟨?_, ?_, ?_⟩
    · rw [hβb, hγb, hs]
      ring
    · right
      exact hβb
    · right
      exact hγb

/-- `β` reflects under `s ↦ 3b − s`. -/
lemma mef_beta_reflect (e : ℕ) (he : 1 ≤ e) {b s : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e)
    (hs : s = 0 ∨ s = b ∨ s = (2 : ZMod (2 ^ (e + 1))) * b ∨
      s = (3 : ZMod (2 ^ (e + 1))) * b) :
    mef_beta e b ((3 : ZMod (2 ^ (e + 1))) * b - s) = b - mef_beta e b s := by
  have hd := mef_b_mul_three_distinct (e := e) he hb
  have hβ2 : mef_beta e b ((2 : ZMod (2 ^ (e + 1))) * b) = b := by
    dsimp [mef_beta]
    simp
  have hβ3 : mef_beta e b ((3 : ZMod (2 ^ (e + 1))) * b) = b := by
    dsimp [mef_beta]
    simp
  have hβb : mef_beta e b b = 0 := by
    dsimp [mef_beta]
    simp [hd.2.2.2.1, hd.2.2.2.2.1]
  have hβ0 : mef_beta e b 0 = 0 := by
    dsimp [mef_beta]
    simp [hd.2.1.symm, hd.2.2.1.symm]
  rcases hs with hs | hs | hs | hs
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - 0 = (3 : ZMod (2 ^ (e + 1))) * b := by simp
    rw [harg, hβ3, hβ0]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - b = (2 : ZMod (2 ^ (e + 1))) * b := by ring
    rw [harg, hβ2, hβb]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - (2 : ZMod (2 ^ (e + 1))) * b = b := by ring
    rw [harg, hβb, hβ2]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - (3 : ZMod (2 ^ (e + 1))) * b = 0 := by ring
    rw [harg, hβ0, hβ3]
    simp

/-- `γ` reflects under `s ↦ 3b − s`. -/
lemma mef_gamma_reflect (e : ℕ) (he : 1 ≤ e) {b s : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e)
    (hs : s = 0 ∨ s = b ∨ s = (2 : ZMod (2 ^ (e + 1))) * b ∨
      s = (3 : ZMod (2 ^ (e + 1))) * b) :
    mef_gamma e b ((3 : ZMod (2 ^ (e + 1))) * b - s) = b - mef_gamma e b s := by
  have hd := mef_b_mul_three_distinct (e := e) he hb
  have hγ3 : mef_gamma e b ((3 : ZMod (2 ^ (e + 1))) * b) = b := by
    dsimp [mef_gamma]
    simp
  have hγb : mef_gamma e b b = b := by
    dsimp [mef_gamma]
    simp
  have hγ2 : mef_gamma e b ((2 : ZMod (2 ^ (e + 1))) * b) = 0 := by
    dsimp [mef_gamma]
    simp [hd.2.2.2.1.symm, hd.2.2.2.2.2]
  have hγ0 : mef_gamma e b 0 = 0 := by
    dsimp [mef_gamma]
    simp [hd.1.symm, hd.2.2.1.symm]
  rcases hs with hs | hs | hs | hs
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - 0 = (3 : ZMod (2 ^ (e + 1))) * b := by simp
    rw [harg, hγ3, hγ0]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - b = (2 : ZMod (2 ^ (e + 1))) * b := by ring
    rw [harg, hγ2, hγb]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - (2 : ZMod (2 ^ (e + 1))) * b = b := by ring
    rw [harg, hγb, hγ2]
    simp
  · rw [hs]
    have harg : (3 : ZMod (2 ^ (e + 1))) * b - (3 : ZMod (2 ^ (e + 1))) * b = 0 := by ring
    rw [harg, hγ0, hγ3]
    simp

/-- The `β` of a `{0,b}`-valued, `v`-alternating input (plus two `{0,b}`-valued,
`v`-alternating auxiliary inputs `τ1, τ2`) is `(v,{0,b})`-boolean. -/
lemma mef_beta_fun_boolean {e : ℕ} (he : 1 ≤ e) (v : G) {b : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e) (σ τ1 τ2 : G → ZMod (2 ^ (e + 1)))
    (hσv : ∀ x : G, σ x = 0 ∨ σ x = b) (hσalt : ∀ x : G, σ (x + v) = b - σ x)
    (hτ1v : ∀ x : G, τ1 x = 0 ∨ τ1 x = b) (hτ1alt : ∀ x : G, τ1 (x + v) = b - τ1 x)
    (hτ2v : ∀ x : G, τ2 x = 0 ∨ τ2 x = b) (hτ2alt : ∀ x : G, τ2 (x + v) = b - τ2 x) :
    IsBooleanAlt e v (fun x : G => mef_beta e b (σ x + τ1 x + τ2 x)) := by
  refine ⟨0, b, mef_zero_even e, hb, ?_, ?_⟩
  · intro x
    exact (mef_binary_digits e he hb
      (mef_three_sum_values e (hσv x) (hτ1v x) (hτ2v x))).2.1
  · intro x
    have hs : σ x + τ1 x + τ2 x = 0 ∨ σ x + τ1 x + τ2 x = b ∨
        σ x + τ1 x + τ2 x = (2 : ZMod (2 ^ (e + 1))) * b ∨
        σ x + τ1 x + τ2 x = (3 : ZMod (2 ^ (e + 1))) * b :=
      mef_three_sum_values e (hσv x) (hτ1v x) (hτ2v x)
    have hstep : mef_beta e b (σ (x + v) + τ1 (x + v) + τ2 (x + v)) =
        b - mef_beta e b (σ x + τ1 x + τ2 x) := by
      calc
        mef_beta e b (σ (x + v) + τ1 (x + v) + τ2 (x + v))
            = mef_beta e b ((b - σ x) + (b - τ1 x) + (b - τ2 x)) := by
                rw [hσalt x, hτ1alt x, hτ2alt x]
        _ = mef_beta e b ((3 : ZMod (2 ^ (e + 1))) * b - (σ x + τ1 x + τ2 x)) := by
                congr 1
                ring
        _ = b - mef_beta e b (σ x + τ1 x + τ2 x) :=
                mef_beta_reflect e he hb hs
    simpa [zero_add] using hstep

/-- The `γ` of a `{0,b}`-valued, `v`-alternating input (plus two `{0,b}`-valued,
`v`-alternating auxiliary inputs `τ1, τ2`) is `(v,{0,b})`-boolean. -/
lemma mef_gamma_fun_boolean {e : ℕ} (he : 1 ≤ e) (v : G) {b : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e) (σ τ1 τ2 : G → ZMod (2 ^ (e + 1)))
    (hσv : ∀ x : G, σ x = 0 ∨ σ x = b) (hσalt : ∀ x : G, σ (x + v) = b - σ x)
    (hτ1v : ∀ x : G, τ1 x = 0 ∨ τ1 x = b) (hτ1alt : ∀ x : G, τ1 (x + v) = b - τ1 x)
    (hτ2v : ∀ x : G, τ2 x = 0 ∨ τ2 x = b) (hτ2alt : ∀ x : G, τ2 (x + v) = b - τ2 x) :
    IsBooleanAlt e v (fun x : G => mef_gamma e b (σ x + τ1 x + τ2 x)) := by
  refine ⟨0, b, mef_zero_even e, hb, ?_, ?_⟩
  · intro x
    exact (mef_binary_digits e he hb
      (mef_three_sum_values e (hσv x) (hτ1v x) (hτ2v x))).2.2
  · intro x
    have hs : σ x + τ1 x + τ2 x = 0 ∨ σ x + τ1 x + τ2 x = b ∨
        σ x + τ1 x + τ2 x = (2 : ZMod (2 ^ (e + 1))) * b ∨
        σ x + τ1 x + τ2 x = (3 : ZMod (2 ^ (e + 1))) * b :=
      mef_three_sum_values e (hσv x) (hτ1v x) (hτ2v x)
    have hstep : mef_gamma e b (σ (x + v) + τ1 (x + v) + τ2 (x + v)) =
        b - mef_gamma e b (σ x + τ1 x + τ2 x) := by
      calc
        mef_gamma e b (σ (x + v) + τ1 (x + v) + τ2 (x + v))
            = mef_gamma e b ((b - σ x) + (b - τ1 x) + (b - τ2 x)) := by
                rw [hσalt x, hτ1alt x, hτ2alt x]
        _ = mef_gamma e b ((3 : ZMod (2 ^ (e + 1))) * b - (σ x + τ1 x + τ2 x)) := by
                congr 1
                ring
        _ = b - mef_gamma e b (σ x + τ1 x + τ2 x) :=
                mef_gamma_reflect e he hb hs
    simpa [zero_add] using hstep

end
end Commons.PeriodicTiling

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! ## Part 5: assembly of the `P*` octuplet (development in `mef_asm.lean`)

From a `CompBool` 2-tuple, build the six witness coordinates
`α₀ = (β₁, β₂, γ₁, γ₂, τ₁, τ₂)` and verify `PairPstar (append α α₀)`.
Obligations after `constructor` (PairPstar = 4-way conjunction):
  (1) every coordinate of the octuplet is `IsBooleanAlt e v`;
  (2) every coordinate has the required periodicity (`PairPstarPeriod`);
  (3) `linConstVal` of `pairCoeff1` (witness `u₁`);
  (4) `linConstVal` of `pairCoeff2` (witness `u₂`). -/

/-- Development version of `mef_PairPstar_of_CompBool` (same statement; moved into
`multi_express_final` once proven). -/
lemma mef_PairPstar_of_CompBool_dev {e : ℕ} (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (α : G → (Fin 2 → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α) :
    ∃ α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1))),
      PairPstar e v p q (fun x : G => Fin.append (α x) (α₀ x)) := by
  classical
  let Z := ZMod (2 ^ (e + 1))
  rcases quotient_section (zSpanSubgroup v p q) with ⟨s, hs⟩
  rcases mef_compbool_normalize e v p q α hα with ⟨u1, u2, b, hb_odd, hσ0v, hσ0alt, hσ1v, hσ1alt⟩
  let τ1 : G → Z := mef_tau1 e b v p q h2v h2p h2q s hs
  let τ2 : G → Z := mef_tau2 e b v p q h2v h2p h2q s hs
  let σ0 : G → Z := fun x => coord α (0 : Fin 2) x - u1
  let σ1 : G → Z := fun x => coord α (1 : Fin 2) x - u2
  let β1 : G → Z := fun x => mef_beta e b (σ0 x + τ1 x + τ2 x)
  let γ1 : G → Z := fun x => mef_gamma e b (σ0 x + τ1 x + τ2 x)
  let β2 : G → Z := fun x => mef_beta e b (σ1 x + τ1 x + τ2 x)
  let γ2 : G → Z := fun x => mef_gamma e b (σ1 x + τ1 x + τ2 x)
  let α₀ : G → (Fin 6 → Z) := fun x i =>
    if i = (0 : Fin 6) then β1 x
    else if i = (1 : Fin 6) then β2 x
    else if i = (2 : Fin 6) then γ1 x
    else if i = (3 : Fin 6) then γ2 x
    else if i = (4 : Fin 6) then τ1 x
    else τ2 x
  -- coordinate-extraction facts for α₀
  have hα₀ (x : G) : α₀ x (0 : Fin 6) = β1 x ∧ α₀ x (1 : Fin 6) = β2 x ∧
      α₀ x (2 : Fin 6) = γ1 x ∧ α₀ x (3 : Fin 6) = γ2 x ∧
      α₀ x (4 : Fin 6) = τ1 x ∧ α₀ x (5 : Fin 6) = τ2 x := by
    dsimp [α₀]
    simp
  let tup : G → (Fin 8 → Z) := fun x => Fin.append (α x) (α₀ x)
  -- τ/σ hypothesis collections (used by the β/γ boolean certificates)
  have hτ1v : ∀ x : G, τ1 x = 0 ∨ τ1 x = b := by
    intro x
    exact Or.symm (mef_tau1_value e b v p q h2v h2p h2q s hs x)
  have hτ1alt : ∀ x : G, τ1 (x + v) = b - τ1 x :=
    mef_tau1_flip_v v p q hind h2v h2p h2q s hs e b
  have hτ2v : ∀ x : G, τ2 x = 0 ∨ τ2 x = b := by
    intro x
    exact Or.symm (mef_tau2_value e b v p q h2v h2p h2q s hs x)
  have hτ2alt : ∀ x : G, τ2 (x + v) = b - τ2 x :=
    mef_tau2_flip_v v p q hind h2v h2p h2q s hs e b
  have hσ0v' : ∀ x : G, σ0 x = 0 ∨ σ0 x = b := by
    intro x
    simpa [σ0] using hσ0v x
  have hσ0alt' : ∀ x : G, σ0 (x + v) = b - σ0 x := by
    intro x
    simpa [σ0] using hσ0alt x
  have hσ1v' : ∀ x : G, σ1 x = 0 ∨ σ1 x = b := by
    intro x
    simpa [σ1] using hσ1v x
  have hσ1alt' : ∀ x : G, σ1 (x + v) = b - σ1 x := by
    intro x
    simpa [σ1] using hσ1alt x
  have hβ1b : IsBooleanAlt e v β1 := by
    simpa [β1] using (mef_beta_fun_boolean he v hb_odd σ0 τ1 τ2 hσ0v' hσ0alt' hτ1v hτ1alt hτ2v hτ2alt)
  have hγ1b : IsBooleanAlt e v γ1 := by
    simpa [γ1] using (mef_gamma_fun_boolean he v hb_odd σ0 τ1 τ2 hσ0v' hσ0alt' hτ1v hτ1alt hτ2v hτ2alt)
  have hβ2b : IsBooleanAlt e v β2 := by
    simpa [β2] using (mef_beta_fun_boolean he v hb_odd σ1 τ1 τ2 hσ1v' hσ1alt' hτ1v hτ1alt hτ2v hτ2alt)
  have hγ2b : IsBooleanAlt e v γ2 := by
    simpa [γ2] using (mef_gamma_fun_boolean he v hb_odd σ1 τ1 τ2 hσ1v' hσ1alt' hτ1v hτ1alt hτ2v hτ2alt)
  have hτ1b : IsBooleanAlt e v τ1 := mef_tau1_boolean v p q hind h2v h2p h2q s hs e he b hb_odd
  have hτ2b : IsBooleanAlt e v τ2 := mef_tau2_boolean v p q hind h2v h2p h2q s hs e he b hb_odd
  refine ⟨α₀, ?_⟩
  constructor
  · -- (1) every coordinate IsBooleanAlt
    intro w
    fin_cases w
    · -- coord 0 = α 0
      have hcq : coord tup (0 : Fin 8) = coord α (0 : Fin 2) := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (0 : Fin 8) = α x (0 : Fin 2)
        exact Fin.append_left (α x) (α₀ x) (0 : Fin 2)
      change IsBooleanAlt e v (coord tup (0 : Fin 8))
      rw [hcq]
      exact (hα.1 (0 : Fin 2)).2.2
    · -- coord 1 = α 1
      have hcq : coord tup (1 : Fin 8) = coord α (1 : Fin 2) := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (1 : Fin 8) = α x (1 : Fin 2)
        exact Fin.append_left (α x) (α₀ x) (1 : Fin 2)
      change IsBooleanAlt e v (coord tup (1 : Fin 8))
      rw [hcq]
      exact (hα.1 (1 : Fin 2)).2.2
    · -- coord 2 = β1 = α₀ 0
      have hcq : coord tup (2 : Fin 8) = β1 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (2 : Fin 8) = β1 x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (0 : Fin 6)) = β1 x
        rw [Fin.append_right]
        exact (hα₀ x).1
      change IsBooleanAlt e v (coord tup (2 : Fin 8))
      rw [hcq]
      exact hβ1b
    · -- coord 3 = β2 = α₀ 1
      have hcq : coord tup (3 : Fin 8) = β2 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (1 : Fin 6)) = β2 x
        rw [Fin.append_right]
        exact (hα₀ x).2.1
      change IsBooleanAlt e v (coord tup (3 : Fin 8))
      rw [hcq]
      exact hβ2b
    · -- coord 4 = γ1 = α₀ 2
      have hcq : coord tup (4 : Fin 8) = γ1 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (2 : Fin 6)) = γ1 x
        rw [Fin.append_right]
        exact (hα₀ x).2.2.1
      change IsBooleanAlt e v (coord tup (4 : Fin 8))
      rw [hcq]
      exact hγ1b
    · -- coord 5 = γ2 = α₀ 3
      have hcq : coord tup (5 : Fin 8) = γ2 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (3 : Fin 6)) = γ2 x
        rw [Fin.append_right]
        exact (hα₀ x).2.2.2.1
      change IsBooleanAlt e v (coord tup (5 : Fin 8))
      rw [hcq]
      exact hγ2b
    · -- coord 6 = τ1 = α₀ 4
      have hcq : coord tup (6 : Fin 8) = τ1 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (4 : Fin 6)) = τ1 x
        rw [Fin.append_right]
        exact (hα₀ x).2.2.2.2.1
      change IsBooleanAlt e v (coord tup (6 : Fin 8))
      rw [hcq]
      exact hτ1b
    · -- coord 7 = τ2 = α₀ 5
      have hcq : coord tup (7 : Fin 8) = τ2 := by
        dsimp [tup]
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (5 : Fin 6)) = τ2 x
        rw [Fin.append_right]
        exact (hα₀ x).2.2.2.2.2
      change IsBooleanAlt e v (coord tup (7 : Fin 8))
      rw [hcq]
      exact hτ2b
  · constructor
    · -- (2) PairPstarPeriod: coords 0,1 periodic p,q (hα); coords 6,7 = τ1,τ2 with
      -- the constructed periodicities; coords 2-5 have no requirement
      intro w
      fin_cases w
      · have hcq : coord tup (0 : Fin 8) = coord α (0 : Fin 2) := by
          dsimp [tup]
          funext x
          change (Fin.append (α x) (α₀ x)) (0 : Fin 8) = α x (0 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (0 : Fin 2)
        change PairPstarPeriod e v p q (0 : Fin 8) (coord tup (0 : Fin 8))
        rw [hcq]
        simp [PairPstarPeriod]
        exact ⟨(hα.1 (0 : Fin 2)).1, (hα.1 (0 : Fin 2)).2.1⟩
      · have hcq : coord tup (1 : Fin 8) = coord α (1 : Fin 2) := by
          dsimp [tup]
          funext x
          change (Fin.append (α x) (α₀ x)) (1 : Fin 8) = α x (1 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (1 : Fin 2)
        change PairPstarPeriod e v p q (1 : Fin 8) (coord tup (1 : Fin 8))
        rw [hcq]
        simp [PairPstarPeriod]
        exact ⟨(hα.1 (1 : Fin 2)).1, (hα.1 (1 : Fin 2)).2.1⟩
      · simp [PairPstarPeriod]
      · simp [PairPstarPeriod]
      · simp [PairPstarPeriod]
      · simp [PairPstarPeriod]
      · have hcq : coord tup (6 : Fin 8) = τ1 := by
          dsimp [tup]
          funext x
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (4 : Fin 6)) = τ1 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.1
        change PairPstarPeriod e v p q (6 : Fin 8) (coord tup (6 : Fin 8))
        rw [hcq]
        simp [PairPstarPeriod]
        exact ⟨mef_tau1_periodic_vp v p q hind h2v h2p h2q s hs e b,
          mef_tau1_periodic_q v p q hind h2v h2p h2q s hs e b⟩
      · have hcq : coord tup (7 : Fin 8) = τ2 := by
          dsimp [tup]
          funext x
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (5 : Fin 6)) = τ2 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.2
        change PairPstarPeriod e v p q (7 : Fin 8) (coord tup (7 : Fin 8))
        rw [hcq]
        simp [PairPstarPeriod]
        exact ⟨mef_tau2_periodic_p v p q hind h2v h2p h2q s hs e b,
          mef_tau2_periodic_vq v p q hind h2v h2p h2q s hs e b⟩
    · constructor
      · -- (3) linConstVal pairCoeff1, witness u1:
        -- α₁ + τ₁ + τ₂ − 2β₁ − γ₁ = u1 pointwise (binary digits on σ₁-shifted value)
        refine ⟨u1, ?_⟩
        intro x
        have h0 : (tup x) (0 : Fin 8) = coord α (0 : Fin 2) x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (0 : Fin 8) = α x (0 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (0 : Fin 2)
        have h2 : (tup x) (2 : Fin 8) = β1 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (0 : Fin 6)) = β1 x
          rw [Fin.append_right]
          exact (hα₀ x).1
        have h4 : (tup x) (4 : Fin 8) = γ1 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (2 : Fin 6)) = γ1 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.1
        have h6 : (tup x) (6 : Fin 8) = τ1 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (4 : Fin 6)) = τ1 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.1
        have h7 : (tup x) (7 : Fin 8) = τ2 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (5 : Fin 6)) = τ2 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.2
        have hs : (coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x = 0 ∨
            (coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x = b ∨
            (coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x = (2 : Z) * b ∨
            (coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x = (3 : Z) * b :=
          mef_three_sum_values e (by simpa [σ0] using hσ0v' x) (hτ1v x) (hτ2v x)
        have hdig := (mef_binary_digits e he hb_odd hs).1
        have hβ1x : β1 x = mef_beta e b ((coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x) := by
          dsimp [β1, σ0]
        have hγ1x : γ1 x = mef_gamma e b ((coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x) := by
          dsimp [γ1, σ0]
        calc
          (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) (tup x)
              = (tup x) (0 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8)
                - 2 * (tup x) (2 : Fin 8) - (tup x) (4 : Fin 8) := pairLin1_eval e (tup x)
          _ = coord α (0 : Fin 2) x + τ1 x + τ2 x - 2 * β1 x - γ1 x := by rw [h0, h6, h7, h2, h4]
          _ = coord α (0 : Fin 2) x + τ1 x + τ2 x - (2 * β1 x + γ1 x) := by ring
          _ = coord α (0 : Fin 2) x + τ1 x + τ2 x
              - (2 * mef_beta e b ((coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x)
                  + mef_gamma e b ((coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x)) := by
                  rw [hβ1x, hγ1x]
          _ = coord α (0 : Fin 2) x + τ1 x + τ2 x
              - ((coord α (0 : Fin 2) x - u1) + τ1 x + τ2 x) := by rw [hdig]
          _ = u1 := by ring
      · -- (4) linConstVal pairCoeff2, witness u2
        refine ⟨u2, ?_⟩
        intro x
        have h1 : (tup x) (1 : Fin 8) = coord α (1 : Fin 2) x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (1 : Fin 8) = α x (1 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (1 : Fin 2)
        have h3 : (tup x) (3 : Fin 8) = β2 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (1 : Fin 6)) = β2 x
          rw [Fin.append_right]
          exact (hα₀ x).2.1
        have h5 : (tup x) (5 : Fin 8) = γ2 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (3 : Fin 6)) = γ2 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.1
        have h6 : (tup x) (6 : Fin 8) = τ1 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (4 : Fin 6)) = τ1 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.1
        have h7 : (tup x) (7 : Fin 8) = τ2 x := by
          dsimp [tup]
          change (Fin.append (α x) (α₀ x)) (Fin.natAdd 2 (5 : Fin 6)) = τ2 x
          rw [Fin.append_right]
          exact (hα₀ x).2.2.2.2.2
        have hs : (coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x = 0 ∨
            (coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x = b ∨
            (coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x = (2 : Z) * b ∨
            (coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x = (3 : Z) * b :=
          mef_three_sum_values e (by simpa [σ1] using hσ1v' x) (hτ1v x) (hτ2v x)
        have hdig := (mef_binary_digits e he hb_odd hs).1
        have hβ2x : β2 x = mef_beta e b ((coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x) := by
          dsimp [β2, σ1]
        have hγ2x : γ2 x = mef_gamma e b ((coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x) := by
          dsimp [γ2, σ1]
        calc
          (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) (tup x)
              = (tup x) (1 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8)
                - 2 * (tup x) (3 : Fin 8) - (tup x) (5 : Fin 8) := pairLin2_eval e (tup x)
          _ = coord α (1 : Fin 2) x + τ1 x + τ2 x - 2 * β2 x - γ2 x := by rw [h1, h6, h7, h3, h5]
          _ = coord α (1 : Fin 2) x + τ1 x + τ2 x - (2 * β2 x + γ2 x) := by ring
          _ = coord α (1 : Fin 2) x + τ1 x + τ2 x
              - (2 * mef_beta e b ((coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x)
                  + mef_gamma e b ((coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x)) := by
                  rw [hβ2x, hγ2x]
          _ = coord α (1 : Fin 2) x + τ1 x + τ2 x
              - ((coord α (1 : Fin 2) x - u2) + τ1 x + τ2 x) := by rw [hdig]
          _ = u2 := by ring

end
end Commons.PeriodicTiling


