noncomputable section

attribute [local instance] Classical.propDecidable

variable {G : Type*} [AddCommGroup G]

/-! # Completing Proposition multi-express (W = 2 and general W)

`multi_express.lean` has established: the `P*` auxiliary octuplet property
(`PairPstar`) is expressible (`pairPstar_expressible`), the direction `P* ⇒`
pair-`CompBool` (`pairPstar_compatible`: coordinates 0 and 1 of a `P*` octuplet are
compatible), and the `⟨v,p,q⟩ ≅ (ℤ/2)³` forward machinery (`zSpanSubgroup`,
`spanCoeff`, `kpart`, `quotient_section`, `boolShift`, `shiftval_*`).

This file finishes Proposition multi-express:
  * `mef_CompBool_of_PairPstar` (PROVEN here): a `P*`-octuplet projects to the
    pair-`CompBool` property on its first two coordinates;
  * `mef_PairPstar_of_CompBool` (FORWARD, the remaining construction): any
    pair-`CompBool` tuple lifts to a `P*`-octuplet.  Per the paper (tex 860-883):
    normalize the pairs of the two boolean functions to a common `{a, b}`-translate,
    construct the auxiliary `τ′, τ″` (⟨v+p,q⟩- resp. ⟨p,v+q⟩-periodic, `(v,{0,b})`-
    boolean) on the cosets of `zSpanSubgroup v p q` via `kpart` + a `Bool`-valued
    coordinate extracted from `spanCoeff`, then binary-decompose `α_i + τ′ + τ″`
    (values in `{0, b, 2b, 3b}`, `b` odd) into `2β_i + γ_i`.
  * `mef_weakExpressible_pair` : `WeakExpressible 2 (CompBool e v p q)` via
    `weakExpressible_existential` (expressible.lean closure (iv)) from
    `pairPstar_expressible`, using the two directions above;
  * `mef_weakExpressible` (general `K`): from the pair case by the pairwise-2-
    coordinate encoding (paper: "similar spirit to Example equal-ex").
-/

/-- The first two coordinates of an appended tuple: `(append α α₀)` restricted to
`Fin 2`. -/
def mef_appendCoord (e : ℕ) (α : G → (Fin 2 → ZMod (2 ^ (e + 1))))
    (α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1)))) (x : G) : Fin 2 → ZMod (2 ^ (e + 1)) :=
  fun w => (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 w)

/-- In the appended tuple the first-two-coordinate function equals the original. -/
lemma mef_append_first_two {e : ℕ} (α : G → (Fin 2 → ZMod (2 ^ (e + 1))))
    (α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1)))) :
    (fun x : G => fun w : Fin 2 => (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 w)) = α := by
  funext x
  funext w
  exact Fin.append_left (α x) (α₀ x) w

/-- `P*` projects to `CompBool` on the first two coordinates (converse of the lift). -/
lemma mef_CompBool_of_PairPstar {e : ℕ} (he : 1 ≤ e) (v p q : G)
    (α : G → (Fin 2 → ZMod (2 ^ (e + 1))))
    (α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1))))
    (hstar : PairPstar e v p q (fun x : G => Fin.append (α x) (α₀ x))) :
    CompBool e v p q α := by
  classical
  let tup : G → (Fin 8 → ZMod (2 ^ (e + 1))) := fun x => Fin.append (α x) (α₀ x)
  have htup : PairPstar e v p q tup := by
    simpa [tup] using hstar
  have hbool : ∀ w : Fin 8, IsBooleanAlt e v (coord tup w) := htup.1
  have hper : ∀ w : Fin 8, PairPstarPeriod e v p q w (coord tup w) := htup.2.1
  have hl1 : linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) tup := htup.2.2.1
  have hl2 : linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) tup := htup.2.2.2
  constructor
  · intro w
    -- per-coordinate (bool, periodic p, periodic q) of coordinate w of α
    let j : Fin 8 := Fin.castAdd 6 w
    have hb : IsBooleanAlt e v (coord tup j) := hbool j
    have hceq : coord tup j = coord α w := by
      funext x
      change (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 w) = α x w
      exact Fin.append_left (α x) (α₀ x) w
    have hbj : IsBooleanAlt e v (coord α w) := by simpa [hceq] using hb
    have hpw := hper j
    have hj01 : j = (0 : Fin 8) ∨ j = (1 : Fin 8) := by
      fin_cases w <;> simp [j, Fin.castAdd]
    have hperw : periodicAlong p (coord tup j) ∧ periodicAlong q (coord tup j) := by
      simpa [PairPstarPeriod, hj01] using hpw
    have hperαw : periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) := by
      simpa [hceq] using hperw
    exact ⟨hperαw.1, hperαw.2, hbj⟩
  · intro w w'
    -- pairwise compatibility of α's coordinates (0 and 1 only)
    fin_cases w <;> fin_cases w'
    · -- (0,0): reflexivity
      exact pairTranslate_refl (Set.range (coord α (0 : Fin 2)))
    · -- (0,1): from pairPstar_compatible (coords 0,1 of the octuplet)
      have hc := pairPstar_compatible e he v p q tup htup
      have h0 : coord tup (0 : Fin 8) = coord α (0 : Fin 2) := by
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 (0 : Fin 2)) = α x (0 : Fin 2)
        exact Fin.append_left (α x) (α₀ x) (0 : Fin 2)
      have h1 : coord tup (1 : Fin 8) = coord α (1 : Fin 2) := by
        funext x
        change (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 (1 : Fin 2)) = α x (1 : Fin 2)
        exact Fin.append_left (α x) (α₀ x) (1 : Fin 2)
      simpa [h0, h1] using hc
    · -- (1,0): symmetry
      have hc : CompatibleFunctions (coord α (0 : Fin 2)) (coord α (1 : Fin 2)) := by
        -- redo the (0,1) case:
        have hc8 := pairPstar_compatible e he v p q tup htup
        have h0 : coord tup (0 : Fin 8) = coord α (0 : Fin 2) := by
          funext x
          change (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 (0 : Fin 2)) = α x (0 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (0 : Fin 2)
        have h1 : coord tup (1 : Fin 8) = coord α (1 : Fin 2) := by
          funext x
          change (Fin.append (α x) (α₀ x)) (Fin.castAdd 6 (1 : Fin 2)) = α x (1 : Fin 2)
          exact Fin.append_left (α x) (α₀ x) (1 : Fin 2)
        simpa [h0, h1] using hc8
      exact pairTranslate_symm hc
    · -- (1,1): reflexivity
      exact pairTranslate_refl (Set.range (coord α (1 : Fin 2)))

/-! ## The forward direction (construction) — REMAINING WORK

`mef_PairPstar_of_CompBool` is the single remaining hard step for W=2: given a
`CompBool` pair, produce the six auxiliary functions so the octuplet obeys `P*`.
The paper's construction (tex 860-868) and the in-file machinery it uses:

  (1) translate the two boolean functions to a common pair `{0, b}` (`b` odd):
      from `hα : CompBool e v p q α`, coords 0,1 give pairs `{a_i, b_i}`
      (`IsBooleanAlt`) which are translates (`pairPstar_compatible`-style argument,
      or directly `CompatibleFunctions` ⇒ `PairTranslate (range …)` ⇒ pair
      translation via `range_eq_pair`); choose one coordinate, translate the other.
  (2) `τ′, τ″` as `(v,{0,b})`-boolean with the prescribed periods: pick a section
      `s : (G ⧸ zSpanSubgroup v p q) → G` (`quotient_section`), let
      `k g := g - s (QuotientAddGroup.mk g)` (the `kpart` of the file); extract the
      `(ℤ/2)³` coordinates `(r, s₁, t) = spanCoeff v p q … (k g) …` (a `{0,1}`-valued
      triple, unique by `triple_unique`); define
        τ′(x) := if r ≠ s₁ then b else 0   (Bool arithmetic via `b`-valued functions)
        τ″(x) := if r ≠ t  then b else 0
      The `(v,{0,b})`-boolean alternation and the ⟨v+p,q⟩- / ⟨p,v+q⟩-periodicity are
      exactly the `boolShift`/`shiftval_tau'`/`shiftval_tau''` laws together with the
      `spanCoeff_shift_v/vp/q/p/vq` lemmas (shifting the argument by `v`, `v+p`, `q`,
      `p`, `v+q` flips/preserves the corresponding coordinate).
  (3) binary expansion: with `α_i ∈ {a_i, a_i + b}` (after (1): values in `{0,b}`),
      `α_i + τ′ + τ″ ∈ {0, b, 2b, 3b}` (distinct since `b` odd, `e ≥ 1`), decompose
      `α_i + τ′ + τ″ = 2β_i + γ_i` with `β_i, γ_i ∈ {0,b}`-valued; verify `β_i, γ_i`
      are `(v,{0,b})`-boolean (`β_i(x+v) = b − β_i(x)` follows from the alternation of
      `α_i + τ′ + τ″`: `(α+τ′+τ″)(x+v) = 3b − (α+τ′+τ″)(x)` and the binary expansion
      `3b − (2β+γ) = 2(b−β) + (b−γ)` since `β,γ ∈ {0,b}`), and ⟨p,q⟩-periodic.
  (4) assemble: coords of the octuplet `(α₁, α₂, β₁, β₂, γ₁, γ₂, τ′, τ″)`:
      `IsBooleanAlt` items from (1)-(3); periods from (2)-(3); item (vi) `z_i := 0`.

  The first two coordinates of the resulting octuplet must be the ORIGINAL `α₁, α₂`
  (not translated): the translation in (1) is only used to *choose the common pair
  `{0,b}` of the `τ′, τ″` construction*; since `α_i` itself has pair `{a_i, b_i}`
  with `a_i` even, set `b := b_i - a_i`-odd and write `α_i = a_i + b·α̃_i`; build
  `τ′, τ″` with pair `{0, b}` as above and `β_i, γ_i` from the binary expansion of
  `(α_i − a_i) + τ′ + τ″` — then `(vi)` holds with `z_i = a_i`.  (Details to fix on
  the exact value bookkeeping during implementation.)
-/

/-- FORWARD (REMAINING): every `CompBool` pair lifts to a `P*` octuplet. -/
lemma mef_PairPstar_of_CompBool {e : ℕ} (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (α : G → (Fin 2 → ZMod (2 ^ (e + 1)))) (hα : CompBool e v p q α) :
    ∃ α₀ : G → (Fin 6 → ZMod (2 ^ (e + 1))),
      PairPstar e v p q (fun x : G => Fin.append (α x) (α₀ x)) :=
  mef_PairPstar_of_CompBool_dev he v p q h2v h2p h2q hind α hα

/-- The W=2 compatible-boolean property is weakly expressible (needs the forward
direction `mef_PairPstar_of_CompBool`; then closure (iv)). -/
theorem mef_weakExpressible_pair {d : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    WeakExpressible 2 (fun α : G → (Fin 2 → ZMod (2 ^ (e + 1))) => CompBool e v p q α) := by
  classical
  let H := ZMod (2 ^ (e + 1))
  have hiff : ∀ α₁ : G → (Fin 2 → H), CompBool e v p q α₁ ↔
      ∃ α₀ : G → (Fin 6 → H),
        PairPstar e v p q (fun x : G => Fin.append (α₁ x) (α₀ x)) := by
    intro α₁
    constructor
    · intro hα₁
      exact mef_PairPstar_of_CompBool (e := e) he v p q h2v h2p h2q hind α₁ hα₁
    · intro h
      rcases h with ⟨α₀, hp⟩
      exact mef_CompBool_of_PairPstar (e := e) (he := he) (v := v) (p := p) (q := q) α₁ α₀ hp
  have hpstar_exp : ExpressibleProperty (PairPstar e v p q) :=
    pairPstar_expressible e he v p q gens hpos hspan
  have hw8 : WeakExpressible 8 (PairPstar e v p q) := expressible_weak (K := 8) hpstar_exp
  have hw2 : WeakExpressible 2 (fun α₁ : G → (Fin 2 → H) =>
      ∃ α₀ : G → (Fin 6 → H),
        PairPstar e v p q (fun x : G => Fin.append (α₁ x) (α₀ x))) := by
    exact weakExpressible_existential (K := 2) (M₁ := 6) (P := PairPstar e v p q) hw8
  simpa [H] using (weakExpressible_congr (K := 2) (G := G) (H := H)
    (P := fun α₁ : G → (Fin 2 → H) =>
      ∃ α₀ : G → (Fin 6 → H),
        PairPstar e v p q (fun x : G => Fin.append (α₁ x) (α₀ x)))
    (Q := fun α : G → (Fin 2 → H) => CompBool e v p q α)
    (fun α₁ => (hiff α₁).symm) hw2)

/-! The general-`K` version of Proposition multi-express (`mef_weakExpressible_general`)
is PROVEN in `Submission.Work.PeriodicTiling.mef_gk2` (pairwise-2-coordinate encoding,
paper "similar spirit to Example equal-ex").  The `W = 2` case is
`mef_weakExpressible_pair` above. -/
end
end Commons.PeriodicTiling


