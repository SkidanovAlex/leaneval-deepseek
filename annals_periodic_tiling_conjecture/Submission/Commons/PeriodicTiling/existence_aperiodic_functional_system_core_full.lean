noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## Structure of `ℓ(j) := Ψ*(n0+q·j, m0+j)` on the tetris diagonal `D(n0,m0)`

For a pseudo-affine `Ψ*(n,m) = A n + B m + C + D·(q/4)·m(m−n)` (q = 2^t), the value on
the diagonal cell `(n0+qj, m0+j)` depends on `n0+qj` only through `n0 mod q`, so
`ℓ(j) = Ψ*(n0, m0+j)` = `vFunc A B C D n0 (m0+j)` (`diag_eq_vFunc`).  The `vFunc`
machinery of the is-odd section then gives the unconditional two-step and parity
identities:
  (i) `ℓ(j+2) − ℓ(j) = 2·(B − (q/4)·D·n0)` — independent of `j` (`diag_two_step`), so
      `ℓ` is affine on each parity class of `j`;
  (ii) `ℓ(j+1) − ℓ(j) ≡ B (mod 2)` (`diag_parity_step`).
These are the algebraic facts the parity (B*-odd) argument needs. -/

/-- `q·j` vanishes in `ZMod q`. -/
lemma diag_qj_zero {t : ℕ} (j : ℤ) : (((((2 ^ t : ℕ) : ℤ) * j) : ℤ) : ZMod (2 ^ t)) = 0 := by
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd (b := 2 ^ t)]
  exact ⟨j, by ring⟩

/-- The pseudo-affine value depends on its row argument only modulo `q` (the whole-cast
form: equal when the row difference vanishes mod `q`). -/
lemma psi_n_mod {t : ℕ} (A B C D : ZMod (2 ^ t)) {n n' m : ℤ}
    (h : ((n - n' : ℤ) : ZMod (2 ^ t)) = 0) :
    pseudoAffineVal A B C D n m = pseudoAffineVal A B C D n' m := by
  dsimp [pseudoAffineVal, pseudoCorr]
  have hsub : (n : ZMod (2 ^ t)) - (n' : ZMod (2 ^ t)) = 0 := by
    rw [← Int.cast_sub]
    exact h
  have hn : (n : ZMod (2 ^ t)) = (n' : ZMod (2 ^ t)) := sub_eq_zero.mp hsub
  rw [hn]

/-- The row shift `q·j` is invisible in the pseudo-affine value: the diagonal value is
the value of the pseudo-affine function at the fixed row `n0`, column `m0+j` (equivalently
`ℓ(j) = vFunc A B C D n0 (m0+j)`). -/
lemma diag_eq_vFunc {t : ℕ} (A B C D : ZMod (2 ^ t)) (n0 m0 j : ℤ) :
    pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * j) (m0 + j)
      = vFunc A B C D n0 (m0 + j) := by
  have hpsi := psi_n_mod (t := t) A B C D (n := n0 + ((2 ^ t : ℕ) : ℤ) * j) (n' := n0)
    (m := m0 + j) (by
      have harg : (n0 + ((2 ^ t : ℕ) : ℤ) * j) - n0 = ((2 ^ t : ℕ) : ℤ) * j := by ring
      rw [harg]
      exact diag_qj_zero j)
  rw [hpsi]
  rfl

lemma vFunc_shift_two {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m : ℤ) :
    vFunc A B C D n0 (m + 2) =
      vFunc A B C D n0 m + 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) := by
  dsimp [vFunc, pseudoAffineVal, pseudoCorr]
  let u : ZMod (2 ^ t) := (m : ZMod (2 ^ t))
  let v : ZMod (2 ^ t) := (n0 : ZMod (2 ^ t))
  have hcast : ((m + 2 : ℤ) : ZMod (2 ^ t)) = u + (2 : ZMod (2 ^ t)) := by
    rw [Int.cast_add]
    dsimp [u]
    norm_num
  rw [hcast]
  have h4 : (qFourth t : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := qFourth_mul_four ht
  have hD : (qFourth t * D) * (u + 2) * ((u + 2) - v)
      = (qFourth t * D) * u * (u - v)
          - 2 * ((qFourth t * D) * v) := by
    have hz : (qFourth t * D) * (4 * u + 4) = 0 := by
      calc
        (qFourth t * D) * (4 * u + 4)
            = ((qFourth t * (4 : ZMod (2 ^ t))) * D) * (u + 1) := by ring
        _ = 0 := by
            rw [h4]
            simp
    calc
      (qFourth t * D) * (u + 2) * ((u + 2) - v)
          = (qFourth t * D) * u * (u - v)
              + (qFourth t * D) * (4 * u + 4 - 2 * v) := by ring
      _ = (qFourth t * D) * u * (u - v) - 2 * ((qFourth t * D) * v) := by
          have hsplit : (qFourth t * D) * (4 * u + 4 - 2 * v)
              = (qFourth t * D) * (4 * u + 4) - 2 * ((qFourth t * D) * v) := by ring
          rw [hsplit, hz]
          ring
  rw [hD]
  ring

/-- Two-step constancy on the diagonal: `ℓ(j+2) − ℓ(j) = 2·(B − (q/4)·D·n0)`,
independent of `j`. -/
lemma diag_two_step {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m0 j : ℤ) :
    pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j + 2)) (m0 + (j + 2))
        - pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * j) (m0 + j)
      = 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) := by
  classical
  rw [diag_eq_vFunc A B C D n0 m0 (j + 2), diag_eq_vFunc A B C D n0 m0 j]
  have hv := vFunc_shift_two ht A B C D n0 (m0 + j)
  have harg : m0 + j + 2 = m0 + (j + 2) := by ring
  rw [← harg]
  rw [hv]
  ring

/-- The difference `ell(j+1) - ell(j)` differs from `B` by a double: it is congruent
to `B` modulo 2.  Here `ell(j) := Psi(n0+q*j, m0+j)` is the pseudo-affine value on the
tetris diagonal. -/
lemma diag_parity_step {t : ℕ} (ht : 3 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m0 j : ℤ) :
    ∃ x : ZMod (2 ^ t),
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j + 1)) (m0 + (j + 1))
          - pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * j) (m0 + j)
        = B + 2 * x := by
  classical
  rw [diag_eq_vFunc A B C D n0 m0 (j + 1), diag_eq_vFunc A B C D n0 m0 j]
  dsimp [vFunc, pseudoAffineVal, pseudoCorr]
  let u : ZMod (2 ^ t) := (m0 : ZMod (2 ^ t)) + (j : ZMod (2 ^ t))
  let v : ZMod (2 ^ t) := (n0 : ZMod (2 ^ t))
  have hcast : ((m0 + (j + 1) : ℤ) : ZMod (2 ^ t)) = u + (1 : ZMod (2 ^ t)) := by
    rw [Int.cast_add]
    rw [Int.cast_add]
    dsimp [u]
    ring
  rw [hcast]
  rw [show ((m0 + j : ℤ) : ZMod (2 ^ t)) = u by rw [Int.cast_add]]
  have hD : (qFourth t * D) * (u + 1) * ((u + 1) - v)
      - (qFourth t * D) * u * (u - v)
      = (qFourth t * D) * (2 * u + 1 - v) := by ring
  have hqfour : qFourth t = (2 : ZMod (2 ^ t)) * ((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) := by
    dsimp [qFourth]
    rw [show (2 : ZMod (2 ^ t)) = ((2 : ℕ) : ZMod (2 ^ t)) by norm_num]
    rw [← Nat.cast_mul]
    congr 1
    symm
    calc
      2 * 2 ^ (t - 3) = 2 ^ 1 * 2 ^ (t - 3) := by norm_num
      _ = 2 ^ (1 + (t - 3)) := by rw [pow_add]
      _ = 2 ^ (t - 2) := by congr 1; omega
  refine ⟨(qFourth t * D) * u + ((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * D * (1 - v), ?_⟩
  have h2 : 2 * ((qFourth t * D) * u + ((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * D * (1 - v))
      = (qFourth t * D) * (2 * u) + (qFourth t * D) * (1 - v) := by
    rw [mul_add]
    congr 1
    · ring
    · calc
        2 * (((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * D * (1 - v))
            = ((2 : ZMod (2 ^ t)) * ((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t))) * (D * (1 - v)) := by ring
        _ = qFourth t * (D * (1 - v)) := by rw [← hqfour]
        _ = (qFourth t * D) * (1 - v) := by ring
  calc
    A * (n0 : ZMod (2 ^ t)) + B * (u + 1) + C
        + (qFourth t * D) * (u + 1) * ((u + 1) - v)
      - (A * (n0 : ZMod (2 ^ t)) + B * u + C
        + (qFourth t * D) * u * (u - v))
        = B + ((qFourth t * D) * (u + 1) * ((u + 1) - v)
            - (qFourth t * D) * u * (u - v)) := by ring
    _ = B + (qFourth t * D) * (2 * u + 1 - v) := by rw [hD]
    _ = B + 2 * ((qFourth t * D) * u + ((2 ^ (t - 3) : ℕ) : ZMod (2 ^ t)) * D * (1 - v)) := by
            rw [h2]
            ring

/-! ## Twin-lemma helpers for the B-even contradiction

`f_q(x) ≠ f_q(x + q/2)` for `0 ≤ x < q` (`q = 2^t`) — the helpers below are all
proven; the case-split assembly of `fq_shift_qhalf_ne` itself is in STATUS_NOTES
(fq is a Work-module definition, so this family is NOT fleet-able and must stay
in-chain). -/

/-- Distinct natural numbers below `q` give distinct `ZMod q` classes. -/
lemma zmod_natCast_inj_lt {q a b : ℕ} (ha : a < q) (hb : b < q) (hab : a ≠ b) :
    (a : ZMod q) ≠ (b : ZMod q) := by
  intro h
  have hv := congrArg ZMod.val h
  rw [ZMod.val_natCast, ZMod.val_natCast] at hv
  have h1 : a % q = a := Nat.mod_eq_of_lt ha
  have h2 : b % q = b := Nat.mod_eq_of_lt hb
  rw [h1, h2] at hv
  exact hab hv

/-- `f_q(n) = n mod q` for `0 < n < q`. -/
lemma fq_eq_of_small {q n : ℕ} (hq1 : 1 < q) (h0 : 0 < n) (hq : n < q) :
    fq q (n : ℤ) = ((n : ℕ) : ZMod q) :=
  fq_eq_self_of_not_dvd (q := q) (n := n) (Nat.not_dvd_of_pos_of_lt h0 hq)

/-- `f_q(q) = 1`. -/
lemma fq_q_self {q : ℕ} (hq : 2 ≤ q) : fq q (q : ℤ) = 1 := by
  rw [show (q : ℤ) = ((q * 1 : ℕ) : ℤ) by simp]
  rw [fq_natCast]
  rw [fqOnNat_mul_q (by omega : q ≠ 0) 1]
  have hd : Nat.divMaxPow 1 q = 1 := Nat.divMaxPow_one_left q
  unfold fqOnNat
  simp [hd]

/-- `q ∤ q + y` for `0 < y < q`. -/
lemma not_dvd_q_add {q y : ℕ} (h0 : 0 < y) (hy : y < q) : ¬ q ∣ q + y := by
  intro hd
  have hy' : q ∣ y := by
    have hsub : q + y - q = y := by omega
    have hd' : q ∣ q + y - q := Nat.dvd_sub hd (dvd_refl q)
    rwa [hsub] at hd'
  exact (Nat.not_dvd_of_pos_of_lt h0 hy) hy'

/-! ## Twin lemma (completed): `f_q(x) ≠ f_q(x + q/2)` for `0 ≤ x < q`, `q = 2^t`

Proved at the `fqOnNat` level (pure `ℕ` — this sidesteps all ℤ-cast normalisation of
the `fq` argument) and lifted to `fq` via `fq_natCast`.  Case split: `x = 0`;
`1 ≤ x < q/2` (both values are residues, `zmod_natCast_inj_lt`); `x = q/2`
(`fqOnNat_q_self` gives `f_q(q) = 1`); `q/2 < x < q` with `y := x − q/2`
(`fqOnNat_eq_self_of_not_dvd` + `not_dvd_q_add` gives `f_q(q+y) = y`).  This is the
f_q twin fact the B-even contradiction needs. -/

lemma fqOnNat_of_small {q n : ℕ} (h0 : 0 < n) (hq : n < q) :
    fqOnNat q n = ((n : ℕ) : ZMod q) :=
  fqOnNat_eq_self_of_not_dvd (q := q) (m := n) (Nat.not_dvd_of_pos_of_lt h0 hq)

-- fqOnNat q (q·1) = 1 (via fqOnNat q 1 = 1)
lemma fqOnNat_q_self {q : ℕ} (hq2 : 2 ≤ q) : fqOnNat q q = 1 := by
  calc
    fqOnNat q q = fqOnNat q (q * 1) := by congr 1; simp
    _ = fqOnNat q 1 := fqOnNat_mul_q (q := q) (by omega : q ≠ 0) 1
    _ = 1 := by
        have hd : Nat.divMaxPow 1 q = 1 := Nat.divMaxPow_one_left q
        unfold fqOnNat
        simp [hd]

theorem fqOnNat_shift_qhalf_ne {t : ℕ} (ht : 2 ≤ t) (x : ℕ) (hx : x < 2 ^ t) :
    fqOnNat (2 ^ t) x ≠ fqOnNat (2 ^ t) (x + 2 ^ (t - 1)) := by
  classical
  let q : ℕ := 2 ^ t
  let h : ℕ := 2 ^ (t - 1)
  change fqOnNat q x ≠ fqOnNat q (x + h)
  have hq1 : 1 < q := by
    dsimp [q]
    exact lt_of_lt_of_le (by norm_num : (1 : ℕ) < 2 ^ 2) (pow_le_pow_right₀ (by norm_num) ht)
  have hq2 : 2 ≤ q := by omega
  have hhpos : 0 < h := by dsimp [h]; positivity
  have hh2 : 2 ≤ h := by
    dsimp [h]
    exact le_trans (by norm_num : (2 : ℕ) ≤ 2 ^ 1) (pow_le_pow_right₀ (by norm_num) (by omega : 1 ≤ t - 1))
  have hhq : h < q := by
    dsimp [q, h]
    exact pow_lt_pow_right₀ (by norm_num) (by omega : t - 1 < t)
  have hq2' : 2 * h = q := by
    dsimp [q, h]
    calc
      2 * 2 ^ (t - 1) = 2 ^ 1 * 2 ^ (t - 1) := by norm_num
      _ = 2 ^ (1 + (t - 1)) := by rw [pow_add]
      _ = 2 ^ t := by congr 1; omega
  have hxh : x < q := by simpa [q] using hx
  by_cases hx0 : x = 0
  · subst x
    have h1 : fqOnNat q 0 = (1 : ZMod q) := by simp [fqOnNat]
    have h2 : fqOnNat q h = ((h : ℕ) : ZMod q) := fqOnNat_of_small (q := q) hhpos hhq
    have hne := zmod_natCast_inj_lt (q := q) (a := 1) (b := h) (by omega) hhq (by omega)
    simpa [h1, h2] using hne
  · have hx1 : 1 ≤ x := Nat.succ_le_of_lt (Nat.pos_of_ne_zero hx0)
    by_cases hxl : x < h
    · have hxhh : x + h < q := by omega
      have h2 : fqOnNat q (x + h) = (((x + h : ℕ) : ℕ) : ZMod q) :=
        fqOnNat_of_small (q := q) (by omega : 0 < x + h) hxhh
      have h1 : fqOnNat q x = ((x : ℕ) : ZMod q) := fqOnNat_of_small (q := q) hx1 hxh
      have hne := zmod_natCast_inj_lt (q := q) (a := x) (b := x + h) (by omega) hxhh (by omega)
      simpa [h1, h2] using hne
    · have hhx : h ≤ x := le_of_not_gt hxl
      by_cases hxeh : x = h
      · subst x
        -- fqOnNat q (h + h) vs fqOnNat q h: h+h = q
        have hsum : h + h = q := by rw [← hq2']; ring
        have hR : fqOnNat q (h + h) = (1 : ZMod q) := by
          rw [hsum]
          exact fqOnNat_q_self (q := q) hq2
        have hL : fqOnNat q h = ((h : ℕ) : ZMod q) := fqOnNat_of_small (q := q) hhpos hhq
        have hne := zmod_natCast_inj_lt (q := q) (a := h) (b := 1) hhq (by omega) (by omega)
        simpa [hL, hR] using hne
      · have hxh_gt : h < x := lt_of_le_of_ne hhx (by intro h; exact hxeh h.symm)
        have hy1 : 1 ≤ x - h := by omega
        have hyh : x - h < h := by omega
        have hyq : x - h < q := by omega
        have harg : x + h = q + (x - h) := by
          have hx2 : x = h + (x - h) := by omega
          omega
        have hR : fqOnNat q (x + h) = (((x - h : ℕ) : ℕ) : ZMod q) := by
          rw [harg]
          rw [fqOnNat_eq_self_of_not_dvd (q := q) (m := q + (x - h)) (not_dvd_q_add (by omega : 0 < x - h) hyq)]
          simp [Nat.cast_add]
        have hL0 : fqOnNat q x = ((x : ℕ) : ZMod q) := fqOnNat_of_small (q := q) hx1 hxh
        have hne2 := zmod_natCast_inj_lt (q := q) (a := x) (b := x - h) hxh hyq (by omega)
        rw [hL0, hR]
        exact hne2

theorem fq_shift_qhalf_ne {t : ℕ} (ht : 2 ≤ t) (x : ℕ) (hx : x < 2 ^ t) :
    fq (2 ^ t) (x : ℤ) ≠ fq (2 ^ t) (((x + 2 ^ (t - 1) : ℕ) : ℤ)) := by
  classical
  rw [fq_natCast, fq_natCast]
  exact fqOnNat_shift_qhalf_ne (t := t) ht x hx

/-! ## B-even: `F*` is `q/2`-periodic in the column off the Ψ*-zeros

When the vertical coefficient `B` is even, `Ψ*(n, ·)` is `q/2`-periodic in the column
for every row (dev_isodd's `vFunc_qhalf_period_of_even`); since `F* = Ψ*` off
Ψ*-zeros, `F*` inherits the `q/2`-periodicity at every cell where `Ψ*` is non-zero.
This is the engine of the B-even contradiction (the same-row collapse between a
`D(n0,m0)` slot and the cell `q/2` columns over on the same row). -/

/-- If `B` is even then `F*` is `q/2`-periodic in the column at every cell with
`Ψ* ≠ 0`. -/
lemma postTetris_periodic_qhalf_off_zeros {t N : ℕ} (ht : 3 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (hB : Even B.val)
    (hΨ2 : ∀ r : Fin N, ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
        postTetris F r m = pseudoAffineVal A B C D (rowVal r) m)
    (r : Fin N) (m : ℤ) (hΨ : pseudoAffineVal A B C D (rowVal r) m ≠ 0) :
    postTetris F r (m + (qHalf t).val) = postTetris F r m := by
  have hper := vFunc_qhalf_period_of_even (t := t) ht A B C D hB (rowVal r) m
  have hΨ' : pseudoAffineVal A B C D (rowVal r) (m + (qHalf t).val) ≠ 0 := by
    change vFunc A B C D (rowVal r) (m + (qHalf t).val) ≠ 0
    rwa [hper]
  have h2 := hΨ2 r (m + (qHalf t).val) hΨ'
  have h1 := hΨ2 r m hΨ
  calc
    postTetris F r (m + (qHalf t).val) =
        pseudoAffineVal A B C D (rowVal r) (m + (qHalf t).val) := h2
    _ = pseudoAffineVal A B C D (rowVal r) m := by simpa [vFunc] using hper
    _ = postTetris F r m := h1.symm

/-! ## Lift-ambiguity ground truth: F* row values via the diagonal lines

`postTetris_eq_diagLine`: F*(r, c) = lineRestrict F (q·c − rowVal r) 1 r — every F*
cell (r,c) is the F-cell (rowVal r, q·c), which lies on the slope-1 diagonal of
intercept q·c − rowVal r.  `postTetris_cell_eq`: every F* cell value is expressed by
the (integer, reduced) diagonal-line pair `qLine a0 b0 (rowVal r)` (per-cell content of
`eqs`).  Consequence for the lift-ambiguity analysis: within one diagonal the value is
unambiguous (it IS the F* value); across the cells of one F* row (columns c, c' with
intercepts i = q·c − x, i' = q·c' − x) the two reduced pairs differ by integer lifts
(a0' = a0 + q·u, b0' = b0 + q·v) and the periodicity collapse reads
`f_q(a0·x+b0) = f_q(a0·x+b0 + q·(u·x+v))` — the precise comparison the B-even argument
must exploit (see STATUS_NOTES). -/

/-- F*'s value at (row r, F*-column c) equals F's value on the diagonal line (slope 1)
of intercept q·c − rowVal r, at row-position rowVal r: F*(r,c) = F(r, q·c). -/
lemma postTetris_eq_diagLine {t N : ℕ} (F : SudokuBoard (2 ^ t) N) (r : Fin N) (c : ℤ) :
    postTetris F r c = lineRestrict F (((2 ^ t : ℕ) : ℤ) * c - rowVal r) 1 r := by
  dsimp [postTetris, lineRestrict, rowVal]
  congr 1
  ring

/-- Every F* cell value is given by the (integer, reduced) diagonal-line representation
`qLine a0 b0` at the row position: the ground-truth content of `eqs` at a single cell. -/
lemma postTetris_cell_eq {t N : ℕ} (ht : 3 ≤ t) (hN : 8 ≤ N)
    (F : SudokuBoard (2 ^ t) N) (hF : IsSudokuSolution (2 ^ t) N F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (r : Fin N) (c : ℤ) :
    ∃ a0 b0 : ℤ, postTetris F r c = qLine (2 ^ t) a0 b0 (rowVal r) := by
  classical
  let i : ℤ := ((2 ^ t : ℕ) : ℤ) * c - rowVal r
  rcases diag_line_reduced_coeffs (t := t) (N := N) ht hN F hF Dp hNF i with
    ⟨a0, b0, _hred, heq, _hza⟩
  refine ⟨a0, b0, ?_⟩
  have hlv := heq r
  -- heq r : lineRestrict F i 1 r = qLine a0 b0 (finToInt r)
  have hf : postTetris F r c = lineRestrict F i 1 r := by
    rw [postTetris_eq_diagLine]
  calc
    postTetris F r c = lineRestrict F i 1 r := hf
    _ = qLine (2 ^ t) a0 b0 (finToInt r) := hlv
    _ = qLine (2 ^ t) a0 b0 (rowVal r) := rfl

/-! ## Normal-form column periodicity by `q²/2` off `qℤ` (the (u,v) thread's content)

For the normal-form value `Ψ(n,m) = m + D·(q/4)·m(m−n)`, all column dependence runs
through `m mod q` (`pseudoAffineVal_nf_m_mod`), so `q²/2 = q·(q/2) ≡ 0 (mod q)` gives
`F(n, m+q²/2) = F(n,m)` for every column `m ∉ qℤ` (`normalForm_qhalfsq_periodic_offq`).
Consequently the diagonal lines `F_{i,1}` and `F_{i+q²/2,1}` of a normal-form Sudoku
solution agree off the common bad coset (`diagLines_agree_off_bad`).  The off-coset
agreement is automatic for any lifts `a0' ≡ a0, b0' ≡ b0 (mod q)` (both reduce to the
same affine residues there), so the lift difference `(u,v)` is constrained ONLY by the
bad-coset (`m ∈ qℤ`) behavior — where the Sudoku condition, not the normal form,
governs — see STATUS_NOTES for the exact open statement. -/

-- s := q·(q/2) = q²/2 ; (s : ZMod q) = 0 for t ≥ 1
lemma qhalfsq_intCast_zero {t : ℕ} (ht : 1 ≤ t) :
    (((((2 ^ t : ℕ) : ℤ) * ((qHalf t).val : ℤ)) : ℤ) : ZMod (2 ^ t)) = 0 := by
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd (b := 2 ^ t)]
  refine ⟨(qHalf t).val, ?_⟩
  -- (2^t : ℤ) · (qHalf t).val = (2^t : ℤ) · (qHalf t).val  -- witness is (qHalf t).val: need
  -- ((2^t:ℕ):ℤ) · ((qHalf t).val : ℤ) = ((2^t:ℕ):ℤ) · (qHalf t).val -- rfl? the dvd witness c with
  -- (2^t:ℤ)·c = s: c := (qHalf t).val: the product matches: rfl
  rfl

-- pseudo-affine normal form value depends on the column only mod q
lemma pseudoAffineVal_nf_m_mod {t : ℕ} (Dp : ZMod (2 ^ t)) (n m : ℤ) (s : ℤ)
    (hs : ((s : ℤ) : ZMod (2 ^ t)) = 0) :
    pseudoAffineVal (0 : ZMod (2 ^ t)) 1 0 Dp n (m + s) = pseudoAffineVal (0 : ZMod (2 ^ t)) 1 0 Dp n m := by
  have hc : ((m + s : ℤ) : ZMod (2 ^ t)) = (m : ZMod (2 ^ t)) := by
    rw [Int.cast_add]
    simp [hs]
  dsimp [pseudoAffineVal, pseudoCorr]
  rw [hc]

-- normal form: F(n, m + q²/2) = F(n, m) for columns m off qℤ
lemma normalForm_qhalfsq_periodic_offq {t N : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal (0 : ZMod (2 ^ t)) 1 0 Dp (rowVal r) m)
    (r : Fin N) (m : ℤ) (hm : ¬ (((2 ^ t : ℕ) : ℤ) ∣ m)) :
    F r (m + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val) = F r m := by
  have hm' : ¬ (((2 ^ t : ℕ) : ℤ) ∣ m + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val) := by
    intro hd
    apply hm
    have hq : ((2 ^ t : ℕ) : ℤ) ∣ ((2 ^ t : ℕ) : ℤ) * (qHalf t).val :=
      dvd_mul_right ((2 ^ t : ℕ) : ℤ) (qHalf t).val
    have hdiff : ((2 ^ t : ℕ) : ℤ) ∣
        (m + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val) - ((2 ^ t : ℕ) : ℤ) * (qHalf t).val := dvd_sub hd hq
    have hsum : m + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val - ((2 ^ t : ℕ) : ℤ) * (qHalf t).val = m := by ring
    rwa [hsum] at hdiff
  rw [hNF r m hm, hNF r (m + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val) hm']
  exact pseudoAffineVal_nf_m_mod (t := t) Dp (rowVal r) m (((2 ^ t : ℕ) : ℤ) * (qHalf t).val)
    (qhalfsq_intCast_zero ht)

-- two diagonal lines F_{i,1} and F_{i+q²/2,1} agree off the bad coset (columns off qℤ)
lemma diagLines_agree_off_bad {t N : ℕ} (ht : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal (0 : ZMod (2 ^ t)) 1 0 Dp (rowVal r) m)
    (i : ℤ) (r : Fin N) (hm : ¬ (((2 ^ t : ℕ) : ℤ) ∣ (rowVal r + i))) :
    lineRestrict F (i + ((2 ^ t : ℕ) : ℤ) * (qHalf t).val) 1 r = lineRestrict F i 1 r := by
  have hper := normalForm_qhalfsq_periodic_offq (t := t) (N := N) ht F Dp hNF r (rowVal r + i) hm
  dsimp [lineRestrict, rowVal] at hper ⊢
  simp only [one_mul, add_assoc, add_comm, add_left_comm] at hper ⊢
  exact hper

/-! ## The `4 | D` alternative (ℓ-affine): precise local content

`4 ∣ D.val` forces the pseudo-affine correction scale to vanish
(`four_dvd_val_qFourth_mul_zero`); when it vanishes the diagonal value
`ell(j) := Psi*(n0+qj, m0+j)` is affine in `j` with slope `B`
(`diag_ell_affine_of_qFD_zero`, via the one-step `vFunc_shift_one`).  This is the
formal meaning of the paper's "the affine function Psi*(n0+qj, m0+j)" (tex 1445):
it holds exactly when `4 | D`.  Whether the near-digit output for `F*` satisfies
`4 | D` is the open question documented in STATUS_NOTES (it must come from the
square-selection/concat construction of near_digit_Fstar, not from the local
diagonal algebra — the second-difference of `ell` only forces `2 | D`). -/

lemma four_dvd_val_qFourth_mul_zero {t : ℕ} (ht : 2 ≤ t) (D : ZMod (2 ^ t))
    (h : 4 ∣ D.val) : qFourth t * D = 0 := by
  have hq : (qFourth t : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := qFourth_mul_four ht
  rcases h with ⟨k, hk⟩
  have hD : D = (4 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) := by
    have hc : (D : ZMod (2 ^ t)) = ((D.val : ℕ) : ZMod (2 ^ t)) := (ZMod.natCast_zmod_val D).symm
    calc
      D = ((D.val : ℕ) : ZMod (2 ^ t)) := hc
      _ = (((4 * k : ℕ) : ℕ) : ZMod (2 ^ t)) := by rw [hk]
      _ = (4 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t)) := by
        rw [Nat.cast_mul]
        norm_num
  calc
    qFourth t * D = qFourth t * ((4 : ZMod (2 ^ t)) * (k : ZMod (2 ^ t))) := by rw [hD]
    _ = (qFourth t * (4 : ZMod (2 ^ t))) * (k : ZMod (2 ^ t)) := by ring
    _ = 0 := by rw [hq]; simp

/-- The one-step column shift of the vertical function adds `B` plus a correction
term that is a multiple of `qFourth·D` (so it vanishes when `4 | D`). -/
lemma vFunc_shift_one {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n m : ℤ) :
    vFunc A B C D n (m + 1) =
      vFunc A B C D n m + B
        + (qFourth t * D) * ((2 : ZMod (2 ^ t)) * (m : ZMod (2 ^ t)) + 1 - (n : ZMod (2 ^ t))) := by
  dsimp [vFunc, pseudoAffineVal, pseudoCorr]
  let u : ZMod (2 ^ t) := (m : ZMod (2 ^ t))
  let v : ZMod (2 ^ t) := (n : ZMod (2 ^ t))
  have hcast : ((m + 1 : ℤ) : ZMod (2 ^ t)) = u + (1 : ZMod (2 ^ t)) := by
    rw [Int.cast_add]
    dsimp [u]
    norm_num
  rw [hcast]
  ring

/-- If the correction scale vanishes (`4 | D`), the diagonal value `ell(j)` is affine
in `j` with slope `B`. -/
lemma diag_ell_affine_of_qFD_zero {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t))
    (n0 m0 : ℤ) (hD : (qFourth t * D) = 0) (j : ℤ) :
    pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j + 1)) (m0 + (j + 1))
        - pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * j) (m0 + j) = B := by
  rw [diag_eq_vFunc A B C D n0 m0 (j + 1), diag_eq_vFunc A B C D n0 m0 j]
  have hv := vFunc_shift_one (t := t) ht A B C D n0 (m0 + j)
  have harg : m0 + (j + 1) = m0 + j + 1 := by ring
  rw [harg]
  rw [hv]
  rw [hD]
  ring


/-! ## Pseudo-affine functions determine `D` only mod 4

`pseudoAffineVal_D_mod_four`: adding `4k` to `D` does not change any value of the
pseudo-affine function (since `qFourth·4 = 0`).  Hence `4 | D` is NOT a vacuous
representative choice: it is exactly the condition that the pseudo-affine function is
genuinely AFFINE (`qFourth·D = 0`, so the correction `pseudoCorr D` vanishes) — and,
via `diag_ell_affine_of_qFD_zero`, exactly the condition that the tetris-diagonal value
`ell(j) := Psi*(n0+qj, m0+j)` is affine in `j`.  The concat construction
(sudoku_concat.lean 501ff) produces `D := -d` with `F1(2,1) = qFourth·d`, so
`4 | D ⟺ F*(n0+2, m0+1) = (affine part)` at one square cell whose F-value sits on a
q-multiple column — a value-level condition that the normal-form/Scal structure does
not force (see STATUS_NOTES: mechanism (c) is the likely truth). -/

-- pseudo-affine values depend on D only through its class mod 4
lemma pseudoAffineVal_D_mod_four {t : ℕ} (ht : 2 ≤ t) (A B C D : ZMod (2 ^ t))
    (k : ZMod (2 ^ t)) (n m : ℤ) :
    pseudoAffineVal A B C (D + 4 * k) n m = pseudoAffineVal A B C D n m := by
  have h4 : (qFourth t : ZMod (2 ^ t)) * (4 : ZMod (2 ^ t)) = 0 := qFourth_mul_four ht
  dsimp [pseudoAffineVal, pseudoCorr]
  have hq : (qFourth t * (D + 4 * k)) * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (n : ZMod (2 ^ t)))
      = (qFourth t * D) * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (n : ZMod (2 ^ t))) := by
    have hsplit : qFourth t * (D + 4 * k) = qFourth t * D + qFourth t * (4 * k) := by ring
    have hz : qFourth t * (4 * k) = 0 := by
      calc
        qFourth t * (4 * k) = (qFourth t * 4) * k := by ring
        _ = 0 := by rw [h4]; simp
    rw [hsplit, hz]
    ring
  rw [hq]


/-! ## Periodic-orbit propagation (the ⟨0,M⟩-periodicity angle)

If `G` (the post-Tetris board `F*`, or any board) is `P`-periodic in the column and
agrees with `Psi` off `Psi`-zeros, then `Psi` repeats its non-zero values along the
`P`-periodic orbit of any of its zero-free cells — at cells where the orbit points are
both `Psi`-nonzero (`column_periodic_orbit_equal`), and along the whole forward orbit
when every intermediate point is `Psi`-nonzero (`column_periodic_orbit_iter`).
CAUTION (recorded in STATUS_NOTES): nonzero-ness does NOT propagate by itself — the
hypotheses must supply `Psi ≠ 0` at the orbit points; agreement alone is insufficient
since `G` may be non-zero even where `Psi` vanishes.  These lemmas are the load-bearing
first step of the descent's ⟨0,M⟩-periodicity analysis: under periodicity one looks for
zero-free column cosets (is_odd_B-style) where `Psi = F*` inherits the periodicity. -/

lemma column_periodic_orbit_equal {t N : ℕ} (P : ℕ)
    (G : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (hper : ∀ r : Fin N, ∀ m : ℤ, G r (m + (P : ℤ)) = G r m)
    (hag : ∀ r : Fin N, ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
        G r m = pseudoAffineVal A B C D (rowVal r) m)
    (r : Fin N) (m : ℤ)
    (h1 : pseudoAffineVal A B C D (rowVal r) m ≠ 0)
    (h2 : pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ)) ≠ 0) :
    pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ)) =
      pseudoAffineVal A B C D (rowVal r) m := by
  calc
    pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ)) = G r (m + (P : ℤ)) :=
      (hag r (m + (P : ℤ)) h2).symm
    _ = G r m := hper r m
    _ = pseudoAffineVal A B C D (rowVal r) m := hag r m h1

/-- Iterated version along the forward `P`-orbit: if `Psi` is non-zero at `m` and at
every intermediate `P`-step up to `m + k·P`, then `Psi(m + k·P) = Psi(m)`. -/
lemma column_periodic_orbit_iter {t N : ℕ} (P : ℕ)
    (G : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (hper : ∀ r : Fin N, ∀ m : ℤ, G r (m + (P : ℤ)) = G r m)
    (hag : ∀ r : Fin N, ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
        G r m = pseudoAffineVal A B C D (rowVal r) m)
    (r : Fin N) (m : ℤ) (k : ℕ)
    (hz : ∀ j : ℕ, j ≤ k → pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (j : ℤ)) ≠ 0) :
    pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ)) =
      pseudoAffineVal A B C D (rowVal r) m := by
  induction k with
  | zero =>
      simp
  | succ k ih =>
      -- Psi(m + (k+1)P) = Psi(m + kP) via the one-step lemma (both nonzero)
      have hz1 : pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ)) ≠ 0 := hz k (by omega)
      have hz2 : pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * ((k + 1 : ℕ) : ℤ)) ≠ 0 :=
        hz (k + 1) (by omega)
      have hshift : m + (P : ℤ) * (k : ℤ) + (P : ℤ) = m + (P : ℤ) * ((k + 1 : ℕ) : ℤ) := by
        norm_num
        ring
      have hstep := column_periodic_orbit_equal (P := P) G A B C D hper hag r
        (m + (P : ℤ) * (k : ℤ)) hz1 (by
          -- Psi at (m + kP) + P = Psi at m + (k+1)P: rewrite the argument
          rwa [hshift])
      -- hstep : Psi (m + kP + P) = Psi (m + kP): but careful which side is "m+P"
      -- column_periodic_orbit_equal with m0 := m+kP: gives Psi(m+kP + P) = Psi(m+kP)
      have hstep' : pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ) + (P : ℤ)) =
          pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ)) := hstep
      calc
        pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * ((k + 1 : ℕ) : ℤ))
            = pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ) + (P : ℤ)) := by
                rw [hshift]
        _ = pseudoAffineVal A B C D (rowVal r) (m + (P : ℤ) * (k : ℤ)) := hstep'
        _ = pseudoAffineVal A B C D (rowVal r) m := ih (by intro j hj; exact hz j (by omega))


/-! ## Periodicity slope relation (the ⟨0,P⟩-periodic descent step)

`zeroFreeCoset_period_slope`: on a row-coset where `Psi` is zero-free and F* (=
postTetris F) is `P`-periodic in the column with `8 | P`, the vertical function is
affine with slope `B`, so the periodicity forces `(P : ZMod)·B = 0` (q | P·B).
`nearDigit_zeroFreeCoset_slope`: from any `Psi`-nonzero cell (hΨ1), the
`vertical_zero_free_8coset` dichotomy produces the zero-free coset, giving the same
slope relation.  In the descent, F ⟨0,M⟩-periodic normal form has M ≡ 0 (mod q),
F* ⟨0,P⟩-periodic with P := M/q; when additionally 8 | P this forces q | P·B — a step
toward B's 2-adic structure under periodicity (the exact use in the tetris-iterate
argument under the descent remains to be assembled; 8 | P is the hypothesis to relax or
justify from the descent's iteration). -/

lemma zeroFreeCoset_period_slope {t N : ℕ} (ht : 2 ≤ t) (P : ℕ)
    (F : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (r0 : Fin N) (c : ℤ)
    (hfree : ∀ m : ℤ, ((8 : ℕ) : ℤ) ∣ m - c →
      pseudoAffineVal A B C D (rowVal r0) m ≠ 0)
    (hag : ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r0) m ≠ 0 →
        postTetris F r0 m = pseudoAffineVal A B C D (rowVal r0) m)
    (hper : ∀ m : ℤ, postTetris F r0 (m + (P : ℤ)) = postTetris F r0 m)
    (h8P : ((8 : ℕ) : ℤ) ∣ ((P : ℕ) : ℤ)) :
    (((P : ℕ) : ℤ) : ZMod (2 ^ t)) * B = 0 := by
  classical
  rcases h8P with ⟨w, hw⟩
  have hc1 : ((8 : ℕ) : ℤ) ∣ (c : ℤ) - c := by
    use 0
    ring
  have hc2 : ((8 : ℕ) : ℤ) ∣ (c + (P : ℤ)) - c := by
    rw [show (c + (P : ℤ)) - c = (P : ℤ) by ring]
    exact ⟨w, hw⟩
  have hfc : postTetris F r0 c = pseudoAffineVal A B C D (rowVal r0) c := hag c (hfree c hc1)
  have hfcp : postTetris F r0 (c + (P : ℤ)) =
      pseudoAffineVal A B C D (rowVal r0) (c + (P : ℤ)) := hag (c + (P : ℤ)) (hfree (c + (P : ℤ)) hc2)
  have heq : pseudoAffineVal A B C D (rowVal r0) (c + (P : ℤ)) =
      pseudoAffineVal A B C D (rowVal r0) c := by
    calc
      pseudoAffineVal A B C D (rowVal r0) (c + (P : ℤ)) = postTetris F r0 (c + (P : ℤ)) := hfcp.symm
      _ = postTetris F r0 c := hper c
      _ = pseudoAffineVal A B C D (rowVal r0) c := hfc
  have hw4 : (P : ℤ) = 4 * (2 * w) := by
    rw [hw]
    ring
  have hv := vFunc_shift_four_z (t := t) ht A B C D (rowVal r0) c (2 * w)
  have hval : pseudoAffineVal A B C D (rowVal r0) (c + (P : ℤ)) =
      pseudoAffineVal A B C D (rowVal r0) c + (((P : ℕ) : ℤ) : ZMod (2 ^ t)) * B := by
    rw [hw4]
    exact hv
  rw [hval] at heq
  have hz0 : pseudoAffineVal A B C D (rowVal r0) c
      + (((P : ℕ) : ℤ) : ZMod (2 ^ t)) * B
      = pseudoAffineVal A B C D (rowVal r0) c + 0 := by simpa using heq
  have hz := congrArg (fun x : ZMod (2 ^ t) => x - pseudoAffineVal A B C D (rowVal r0) c) hz0
  simpa using hz

/-- Combined: a `Psi`-nonzero cell gives (via the 8-coset dichotomy) a zero-free coset,
on which F*-`P`-periodicity (8 | P) forces `(P : ZMod)·B = 0`. -/
lemma nearDigit_zeroFreeCoset_slope {t N : ℕ} (ht : 2 ≤ t) (P : ℕ)
    (F : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (r0 : Fin N) (m0 : ℤ)
    (hV : pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0)
    (hag : ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r0) m ≠ 0 →
        postTetris F r0 m = pseudoAffineVal A B C D (rowVal r0) m)
    (hper : ∀ m : ℤ, postTetris F r0 (m + (P : ℤ)) = postTetris F r0 m)
    (h8P : ((8 : ℕ) : ℤ) ∣ ((P : ℕ) : ℤ)) :
    (((P : ℕ) : ℤ) : ZMod (2 ^ t)) * B = 0 := by
  classical
  have hV' : vFunc A B C D (rowVal r0) m0 ≠ 0 := by simpa [vFunc] using hV
  have hdich := vertical_zero_free_8coset (t := t) ht A B C D (rowVal r0) m0 hV'
  rcases hdich with hfree1 | hfree2
  · exact zeroFreeCoset_period_slope (t := t) (N := N) ht P F A B C D r0 m0 hfree1 hag hper h8P
  · exact zeroFreeCoset_period_slope (t := t) (N := N) ht P F A B C D r0 (m0 + 4) hfree2 hag hper h8P


/-! ## General-period break-point: what fails without `8 | P`

`periodic_shift_of_zeroFree`: on a `Psi`-zero-free coset with F* `P`-periodic (NO
`8 | P` hypothesis), the `P`-shifted value satisfies `Psi(m+P) = 0 ∨ Psi(m+P) =
Psi(m)`.  Without `8 | P` the `P`-shift of a coset point need not stay in the coset, so
equality cannot be concluded — the shifted point may land on a `Psi`-zero (where F*,
being a digit, is still non-zero but no longer equals `Psi`).  This is the precise
obstruction; combining the disjunction with the affine-on-4-cosets structure of `Psi`
(`vFunc_shift_four_z`) is the next step (see STATUS_NOTES). -/

lemma periodic_shift_of_zeroFree {t N : ℕ} (P : ℕ)
    (F : SudokuBoard (2 ^ t) N) (A B C D : ZMod (2 ^ t))
    (r0 : Fin N) (c : ℤ)
    (hfree : ∀ m : ℤ, ((8 : ℕ) : ℤ) ∣ m - c →
      pseudoAffineVal A B C D (rowVal r0) m ≠ 0)
    (hag : ∀ m : ℤ,
      pseudoAffineVal A B C D (rowVal r0) m ≠ 0 →
        postTetris F r0 m = pseudoAffineVal A B C D (rowVal r0) m)
    (hper : ∀ m : ℤ, postTetris F r0 (m + (P : ℤ)) = postTetris F r0 m)
    (m : ℤ) (hm : ((8 : ℕ) : ℤ) ∣ m - c) :
    pseudoAffineVal A B C D (rowVal r0) (m + (P : ℤ)) = 0 ∨
    pseudoAffineVal A B C D (rowVal r0) (m + (P : ℤ)) =
      pseudoAffineVal A B C D (rowVal r0) m := by
  classical
  have hf_m : postTetris F r0 m = pseudoAffineVal A B C D (rowVal r0) m := hag m (hfree m hm)
  have hfp : postTetris F r0 (m + (P : ℤ)) = postTetris F r0 m := hper m
  by_cases hz : pseudoAffineVal A B C D (rowVal r0) (m + (P : ℤ)) = 0
  · exact Or.inl hz
  · right
    have hf_mp : postTetris F r0 (m + (P : ℤ)) =
        pseudoAffineVal A B C D (rowVal r0) (m + (P : ℤ)) := hag (m + (P : ℤ)) hz
    calc
      pseudoAffineVal A B C D (rowVal r0) (m + (P : ℤ)) = postTetris F r0 (m + (P : ℤ)) := hf_mp.symm
      _ = postTetris F r0 m := hfp
      _ = pseudoAffineVal A B C D (rowVal r0) m := hf_m


end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## B*-odd via diagonal consistency (dev_bodd)

For the post-Tetris board `F*` of a normal-form Sudoku solution, the near-digit
pseudo-affine `Ψ*(n,m) = An+Bm+C+(q/4)D·m(m−n)` has ODD vertical coefficient `B`.  The
proof (see STATUS_NOTES "BRUTE-FORCE DISCOVERY") is a parity-class fiber argument on a
single diagonal `D(n0,m0)`, replacing the (false, paper tex 1445-1446) "≤ 3 zeros" claim.

MAIN STRUCTURE (abstract section over a diagonal function `ell : ℤ → ZMod (2^t)`):
  hstep  : ∀ j, ell (j+2) = ell j + 2·S0        (two-step constancy)
  hcons  : ∀ j < q, ell j ≠ 0 → f_q(c0+a0·j) = ell j   (fq identity off zeros)
  hnz    : ell is not identically zero on [0,q)
  ha0u   : a0 is a unit mod q
Then `ell 1 ≢ ell 0 (mod 2)`.  Applied to `ell j := Ψ*(n0+q·j, m0+j)` via
`diag_two_step`, and combined with `diag_parity_step` (`ell 1 − ell 0 = B + 2x`), this
gives `¬ Even B.val`. -/

/-- The diagonal function `ℓ(j) := Ψ*(n0+q·j, m0+j)`. -/
def diagEll {t : ℕ} (A B C D : ZMod (2 ^ t)) (n0 m0 : ℤ) : ℤ → ZMod (2 ^ t) :=
  fun j => pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * j) (m0 + j)

/-- Two-step constancy of the diagonal function (from `diag_two_step`). -/
lemma diagEll_two_step {t : ℕ} (ht2 : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m0 : ℤ) :
    ∀ j : ℤ,
      diagEll A B C D n0 m0 (j + 2) =
        diagEll A B C D n0 m0 j + 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) := by
  intro j
  have h := diag_two_step ht2 A B C D n0 m0 j
  simpa [diagEll, add_comm] using (sub_eq_iff_eq_add.mp h)

/-- The class parametrisation: for `e ≤ 1`, on the class `j = e + 2k` the diagonal
function is affine in `k` with step `2·(B − (q/4)D·n0)`. -/
lemma diagEll_class {t : ℕ} (ht2 : 2 ≤ t) (A B C D : ZMod (2 ^ t)) (n0 m0 : ℤ)
    (e k : ℕ) :
    diagEll A B C D n0 m0 (((e + 2 * k : ℕ) : ℤ))
      = diagEll A B C D n0 m0 (e : ℤ)
          + (k : ZMod (2 ^ t)) * (2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t)))) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hsum : (e + 2 * (k + 1) : ℕ) = e + 2 * k + 2 := by omega
      calc
        diagEll A B C D n0 m0 ((e + 2 * (k + 1) : ℕ) : ℤ)
            = diagEll A B C D n0 m0 (((e + 2 * k : ℕ) : ℤ) + 2) := by rw [hsum]; norm_num
        _ = diagEll A B C D n0 m0 ((e + 2 * k : ℕ) : ℤ)
              + 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) := by
                exact diagEll_two_step ht2 A B C D n0 m0 ((e + 2 * k : ℕ) : ℤ)
        _ = diagEll A B C D n0 m0 (e : ℤ)
              + (k : ZMod (2 ^ t)) * (2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))))
              + 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) := by rw [ih]
        _ = diagEll A B C D n0 m0 (e : ℤ)
              + (((k + 1 : ℕ) : ZMod (2 ^ t))) * (2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t)))) := by
                ring_nf
                rw [Nat.cast_add, Nat.cast_one]
                ring

/-- Parity of a natural coerced to `ℤ`. -/
lemma even_intCast_nat {j : ℕ} : Even (j : ℤ) ↔ j % 2 = 0 := by
  rw [Int.even_iff]
  constructor <;> intro h
  · have hc : (j : ℤ) % 2 = ((j % 2 : ℕ) : ℤ) := (Int.natCast_mod j 2).symm
    rw [hc] at h
    norm_num at h ⊢
    omega
  · have hc : (j : ℤ) % 2 = ((j % 2 : ℕ) : ℤ) := (Int.natCast_mod j 2).symm
    rw [hc]
    norm_num
    omega

/-- Parity of a natural coerced to `ℤ`. -/
lemma odd_intCast_nat {j : ℕ} : Odd (j : ℤ) ↔ j % 2 = 1 := by
  rw [Int.odd_iff]
  constructor <;> intro h
  · have hc : (j : ℤ) % 2 = ((j % 2 : ℕ) : ℤ) := (Int.natCast_mod j 2).symm
    rw [hc] at h
    norm_num at h ⊢
    omega
  · have hc : (j : ℤ) % 2 = ((j % 2 : ℕ) : ℤ) := (Int.natCast_mod j 2).symm
    rw [hc]
    norm_num
    omega

/-- Two naturals below `d` with difference divisible by `d` are equal. -/
lemma eq_of_int_dvd_sub_lt {d m n : ℕ} (hm : m < d) (hn : n < d)
    (h : ((d : ℕ) : ℤ) ∣ (m : ℤ) - (n : ℤ)) : m = n := by
  by_cases hmn : m ≤ n
  · let k : ℕ := n - m
    have hk : (m : ℤ) - (n : ℤ) = - (k : ℤ) := by
      dsimp [k]
      omega
    have hklt : k < d := by
      dsimp [k]
      omega
    have hdvd : ((d : ℕ) : ℤ) ∣ (k : ℤ) := by
      have hd : ((d : ℕ) : ℤ) ∣ - (k : ℤ) := by
        rwa [hk] at h
      rcases hd with ⟨w, hw⟩
      refine ⟨-w, ?_⟩
      have hw' : (k : ℤ) = -(((d : ℕ) : ℤ) * w) := by
        exact neg_inj.mp (by simpa using hw)
      rw [hw']
      ring
    have hdn : d ∣ k := by
      exact (Int.natCast_dvd_natCast).mp hdvd
    have hk0 : k = 0 := Nat.eq_zero_of_dvd_of_lt hdn hklt
    dsimp [k] at hk0
    omega
  · have hnm : n ≤ m := le_of_not_ge hmn
    let k : ℕ := m - n
    have hk : (m : ℤ) - (n : ℤ) = (k : ℤ) := by
      dsimp [k]
      omega
    have hklt : k < d := by
      dsimp [k]
      omega
    have hdvd : ((d : ℕ) : ℤ) ∣ (k : ℤ) := by
      rwa [hk] at h
    have hdn : d ∣ k := by
      exact (Int.natCast_dvd_natCast).mp hdvd
    have hk0 : k = 0 := Nat.eq_zero_of_dvd_of_lt hdn hklt
    dsimp [k] at hk0
    omega

/-- The map `j ↦ (c0 + a0·j mod q)` is injective on `j ∈ [0,q)` when `a0` is a unit. -/
lemma residue_inj_mod_q {t : ℕ} (a0 c0 : ℤ) (ha0u : IsUnit (a0 : ZMod (2 ^ t))) :
    ∀ j1 j2 : ℕ, j1 < 2 ^ t → j2 < 2 ^ t →
      ((c0 + a0 * (j1 : ℤ) : ZMod (2 ^ t)) = (c0 + a0 * (j2 : ℤ) : ZMod (2 ^ t))) → j1 = j2 := by
  intro j1 j2 hj1 hj2 h
  have hsub : (a0 * ((j1 : ℤ) - (j2 : ℤ)) : ZMod (2 ^ t)) = 0 := by
    have hcalc : (a0 * ((j1 : ℤ) - (j2 : ℤ)) : ZMod (2 ^ t)) =
        ((c0 + a0 * (j1 : ℤ) : ZMod (2 ^ t)) - (c0 + a0 * (j2 : ℤ) : ZMod (2 ^ t))) := by
      ring
    rw [hcalc, h]
    ring
  have hd0 : (((j1 : ℤ) - (j2 : ℤ) : ZMod (2 ^ t))) = 0 := by
    rcases ha0u with ⟨u, hu⟩
    have hsubu : (u : ZMod (2 ^ t)) * (((j1 : ℤ) - (j2 : ℤ) : ZMod (2 ^ t))) = 0 := by
      simpa [hu] using hsub
    have hmul := congrArg (fun y : ZMod (2 ^ t) => (↑(u⁻¹) : ZMod (2 ^ t)) * y) hsubu
    simpa [Units.val_mul] using hmul
  have hdvd : ((2 ^ t : ℕ) : ℤ) ∣ (j1 : ℤ) - (j2 : ℤ) := by
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd ((j1 : ℤ) - (j2 : ℤ)) (2 ^ t)).mp (by simpa using hd0)
  exact eq_of_int_dvd_sub_lt hj1 hj2 hdvd

/-- At most one index `j < q` has `q | c0 + a0·j` (a0 a unit). -/
lemma arg_zero_at_most_one {t : ℕ} (a0 c0 : ℤ) (ha0u : IsUnit (a0 : ZMod (2 ^ t)))
    (Z : Finset ℕ) (hZsub : Z ⊆ Finset.range (2 ^ t))
    (hZ : ∀ j ∈ Z, ((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j : ℤ)) :
    Z.card ≤ 1 := by
  classical
  rw [Finset.card_le_one]
  intro j1 hj1 j2 hj2
  have hd1 : ((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j1 : ℤ) := hZ j1 hj1
  have hd2 : ((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j2 : ℤ) := hZ j2 hj2
  have hz1 : (c0 + a0 * (j1 : ℤ) : ZMod (2 ^ t)) = 0 := by
    simpa using (ZMod.intCast_zmod_eq_zero_iff_dvd (c0 + a0 * (j1 : ℤ)) (2 ^ t)).mpr hd1
  have hz2 : (c0 + a0 * (j2 : ℤ) : ZMod (2 ^ t)) = 0 := by
    simpa using (ZMod.intCast_zmod_eq_zero_iff_dvd (c0 + a0 * (j2 : ℤ)) (2 ^ t)).mpr hd2
  have hj1' : j1 < 2 ^ t := Finset.mem_range.mp (hZsub hj1)
  have hj2' : j2 < 2 ^ t := Finset.mem_range.mp (hZsub hj2)
  exact residue_inj_mod_q a0 c0 ha0u j1 j2 hj1' hj2' (hz1.trans hz2.symm)

/-- The fiber bound: `f_q(c0 + a0·j) = u ≠ 0` for at most two `j < q` (a0 a unit). -/
lemma fq_progression_fiber_le_two {t : ℕ} (ht : 1 ≤ t) (a0 c0 : ℤ)
    (ha0u : IsUnit (a0 : ZMod (2 ^ t))) (u : ZMod (2 ^ t)) (hu : u ≠ 0)
    (Z : Finset ℕ) (hZsub : Z ⊆ Finset.range (2 ^ t))
    (hZ : ∀ j ∈ Z, fq (2 ^ t) (c0 + a0 * (j : ℤ)) = u) :
    Z.card ≤ 2 := by
  classical
  have hq : 1 < 2 ^ t := by
    have hp : (2 : ℕ) ^ 1 ≤ 2 ^ t := pow_le_pow_right₀ (by norm_num) ht
    norm_num at hp
    omega
  let P1 : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j => ((c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) = u))
  let P2 : Finset ℕ := (Finset.range (2 ^ t)).filter
    (fun j => ((c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) = 0))
  have hZsub' : Z ⊆ P1 ∪ P2 := by
    intro j hj
    have hjq : j < 2 ^ t := Finset.mem_range.mp (hZsub hj)
    have hfj : fq (2 ^ t) (c0 + a0 * (j : ℤ)) = u := hZ j hj
    by_cases hdiv : ((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j : ℤ)
    · have hz : (c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) = 0 := by
        simpa using (ZMod.intCast_zmod_eq_zero_iff_dvd (c0 + a0 * (j : ℤ)) (2 ^ t)).mpr hdiv
      exact Finset.mem_union.mpr (Or.inr (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjq, hz⟩))
    · have hf : fq (2 ^ t) (c0 + a0 * (j : ℤ)) = (c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) := by
        simpa using (fq_eq_self_of_not_dvd_int hq hdiv)
      have heq : (c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) = u := by
        exact hf.symm.trans hfj
      exact Finset.mem_union.mpr (Or.inl (Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hjq, heq⟩))
  have hc1 : P1.card ≤ 1 := by
    rw [Finset.card_le_one]
    intro j1 hj1 j2 hj2
    have hj1' : j1 < 2 ^ t := by simpa [P1] using (Finset.mem_filter.mp hj1).1
    have hj2' : j2 < 2 ^ t := by simpa [P1] using (Finset.mem_filter.mp hj2).1
    have h1 : (c0 + a0 * (j1 : ℤ) : ZMod (2 ^ t)) = u := by simpa [P1] using (Finset.mem_filter.mp hj1).2
    have h2 : (c0 + a0 * (j2 : ℤ) : ZMod (2 ^ t)) = u := by simpa [P1] using (Finset.mem_filter.mp hj2).2
    exact residue_inj_mod_q a0 c0 ha0u j1 j2 hj1' hj2' (by rw [h1, h2])
  have hc2 : P2.card ≤ 1 := by
    rw [Finset.card_le_one]
    intro j1 hj1 j2 hj2
    have hj1' : j1 < 2 ^ t := by simpa [P2] using (Finset.mem_filter.mp hj1).1
    have hj2' : j2 < 2 ^ t := by simpa [P2] using (Finset.mem_filter.mp hj2).1
    have h1 : (c0 + a0 * (j1 : ℤ) : ZMod (2 ^ t)) = 0 := by simpa [P2] using (Finset.mem_filter.mp hj1).2
    have h2 : (c0 + a0 * (j2 : ℤ) : ZMod (2 ^ t)) = 0 := by simpa [P2] using (Finset.mem_filter.mp hj2).2
    exact residue_inj_mod_q a0 c0 ha0u j1 j2 hj1' hj2' (by rw [h1, h2])
  calc
    Z.card ≤ (P1 ∪ P2).card := Finset.card_le_card hZsub'
    _ ≤ P1.card + P2.card := Finset.card_union_le P1 P2
    _ ≤ 1 + 1 := by omega
    _ = 2 := by norm_num

/-- For an odd multiplier `a0`, the parity of `c0 + a0·j` is the XOR of the parities
of `c0` and `j`. -/
lemma even_arg_iff {a0 c0 : ℤ} (ha0odd : Odd a0) (j : ℕ) :
    Even (c0 + a0 * (j : ℤ)) ↔ (Even (c0 : ℤ) ↔ Even (j : ℤ)) := by
  have hodd : ¬ Even (a0 : ℤ) := (Int.not_even_iff_odd).mpr ha0odd
  rw [Int.even_add, Int.even_mul]
  by_cases hj : Even (j : ℤ)
  · by_cases hc : Even (c0 : ℤ)
    · simp [hj, hc, hodd]
    · simp [hj, hc, hodd]
  · by_cases hc : Even (c0 : ℤ)
    · simp [hj, hc, hodd]
    · simp [hj, hc, hodd]

/-- The "wrong" parity class (the `j` whose argument parity mismatches a fixed parity
`ε`) is exactly one of the two residue classes of `j` modulo `2`. -/
lemma exists_wrong_class {t : ℕ} (ht1 : 1 ≤ t) (a0 c0 : ℤ)
    (ha0u : IsUnit (a0 : ZMod (2 ^ t))) (ε : Prop) :
    ∃ w : ℕ, w ≤ 1 ∧ ∀ j : ℕ, j < 2 ^ t → (j % 2 = w ↔ ¬ (Even (c0 + a0 * (j : ℤ)) ↔ ε)) := by
  have ha0odd : Odd a0 := Commons.Data.ZMod.odd_of_isUnit_intCast ht1 ha0u
  by_cases hc : Even (c0 : ℤ)
  · by_cases hε : ε
    · -- c0 even, ε true: arg parity = Even j; wrong = odd j
      refine ⟨1, by norm_num, ?_⟩
      intro j hj
      have harg : Even (c0 + a0 * (j : ℤ)) ↔ Even (j : ℤ) := by
        have harg' : Even (c0 + a0 * (j : ℤ)) ↔ (Even (c0 : ℤ) ↔ Even (j : ℤ)) := even_arg_iff ha0odd j
        tauto
      calc
        (j % 2 = 1) ↔ Odd (j : ℤ) := odd_intCast_nat.symm
        _ ↔ ¬ Even (j : ℤ) := (Int.not_even_iff_odd).symm
        _ ↔ ¬ (Even (j : ℤ) ↔ True) := by tauto
        _ ↔ ¬ (Even (c0 + a0 * (j : ℤ)) ↔ ε) := by rw [harg]; simp [hε]
    · -- c0 even, ε false: wrong = even j
      refine ⟨0, by norm_num, ?_⟩
      intro j hj
      have harg : Even (c0 + a0 * (j : ℤ)) ↔ Even (j : ℤ) := by
        have harg' : Even (c0 + a0 * (j : ℤ)) ↔ (Even (c0 : ℤ) ↔ Even (j : ℤ)) := even_arg_iff ha0odd j
        tauto
      calc
        (j % 2 = 0) ↔ Even (j : ℤ) := even_intCast_nat.symm
        _ ↔ ¬ (Even (j : ℤ) ↔ False) := by tauto
        _ ↔ ¬ (Even (c0 + a0 * (j : ℤ)) ↔ ε) := by rw [harg]; simp [hε]
  · by_cases hε : ε
    · -- c0 odd, ε true: arg parity = ¬ Even j; wrong = even j
      refine ⟨0, by norm_num, ?_⟩
      intro j hj
      have harg : Even (c0 + a0 * (j : ℤ)) ↔ ¬ Even (j : ℤ) := by
        have harg' : Even (c0 + a0 * (j : ℤ)) ↔ (Even (c0 : ℤ) ↔ Even (j : ℤ)) := even_arg_iff ha0odd j
        tauto
      calc
        (j % 2 = 0) ↔ Even (j : ℤ) := even_intCast_nat.symm
        _ ↔ ¬ (¬ Even (j : ℤ) ↔ True) := by tauto
        _ ↔ ¬ (Even (c0 + a0 * (j : ℤ)) ↔ ε) := by rw [harg]; simp [hε]
    · -- c0 odd, ε false: wrong = odd j
      refine ⟨1, by norm_num, ?_⟩
      intro j hj
      have harg : Even (c0 + a0 * (j : ℤ)) ↔ ¬ Even (j : ℤ) := by
        have harg' : Even (c0 + a0 * (j : ℤ)) ↔ (Even (c0 : ℤ) ↔ Even (j : ℤ)) := even_arg_iff ha0odd j
        tauto
      calc
        (j % 2 = 1) ↔ Odd (j : ℤ) := odd_intCast_nat.symm
        _ ↔ ¬ Even (j : ℤ) := (Int.not_even_iff_odd).symm
        _ ↔ ¬ (¬ Even (j : ℤ) ↔ False) := by tauto
        _ ↔ ¬ (Even (c0 + a0 * (j : ℤ)) ↔ ε) := by rw [harg]; simp [hε]

/-- Abstract class affineness: from the two-step relation, on each parity class the
function is affine in `k` with slope `2·S0`. -/
lemma class_affine {t : ℕ} (ell : ℤ → ZMod (2 ^ t)) (S0 : ZMod (2 ^ t))
    (hstep : ∀ j : ℤ, ell (j + 2) = ell j + 2 * S0) (e k : ℕ) :
    ell (((e + 2 * k : ℕ) : ℤ)) = ell (e : ℤ) + (k : ZMod (2 ^ t)) * (2 * S0) := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hk : (e + 2 * (k + 1) : ℕ) = e + 2 * k + 2 := by omega
      calc
        ell ((e + 2 * (k + 1) : ℕ) : ℤ)
            = ell (((e + 2 * k : ℕ) : ℤ) + 2) := by rw [hk]; norm_num
        _ = ell ((e + 2 * k : ℕ) : ℤ) + 2 * S0 := hstep ((e + 2 * k : ℕ) : ℤ)
        _ = ell (e : ℤ) + (k : ZMod (2 ^ t)) * (2 * S0) + 2 * S0 := by rw [ih]
        _ = ell (e : ℤ) + ((k + 1 : ℕ) : ZMod (2 ^ t)) * (2 * S0) := by
                rw [Nat.cast_add, Nat.cast_one]
                ring

/-- One step of the two-step parity propagation. -/
lemma parity_step_two {t : ℕ} (ell : ℤ → ZMod (2 ^ t)) (S0 : ZMod (2 ^ t))
    (hstep : ∀ j : ℤ, ell (j + 2) = ell j + 2 * S0) (j : ℤ) :
    Even ((ell j - ell 0).val) → Even ((ell (j + 2) - ell 0).val) := by
  intro h
  have htw := (Commons.Data.ZMod.even_val_iff_two_mul (ell j - ell 0)).mp h
  rcases htw with ⟨w, hw⟩
  have hw2 : (ell j - ell 0) + 2 * S0 = 2 * (w + S0) := by
    rw [hw]
    ring
  have hrew : ell (j + 2) - ell 0 = 2 * (w + S0) := by
    calc
      ell (j + 2) - ell 0 = (ell j + 2 * S0) - ell 0 := by rw [hstep]
      _ = (ell j - ell 0) + 2 * S0 := by ring
      _ = 2 * (w + S0) := hw2
  rw [hrew]
  exact (Commons.Data.ZMod.even_val_iff_two_mul (2 * (w + S0))).mpr ⟨w + S0, rfl⟩

/-- Uniform parity: if `ell 1 ≡ ell 0 (mod 2)`, then every element of a two-step class
has the parity of `ell 0`. -/
lemma parity_uniform {t : ℕ} (ell : ℤ → ZMod (2 ^ t)) (S0 : ZMod (2 ^ t))
    (hstep : ∀ j : ℤ, ell (j + 2) = ell j + 2 * S0)
    (hsame : Even ((ell 1 - ell 0).val)) :
    ∀ e k : ℕ, e ≤ 1 → Even ((ell ((e + 2 * k : ℕ) : ℤ) - ell 0).val) := by
  intro e k he
  induction k with
  | zero =>
      have he0 : e = 0 ∨ e = 1 := by omega
      rcases he0 with rfl | rfl
      · simp
      · simpa using hsame
  | succ k ih =>
      have hk : (e + 2 * (k + 1) : ℕ) = e + 2 * k + 2 := by omega
      have harg : ell ((e + 2 * (k + 1) : ℕ) : ℤ) = ell (((e + 2 * k : ℕ) : ℤ) + 2) := by
        rw [hk]
        norm_num
      rw [harg]
      exact parity_step_two ell S0 hstep ((e + 2 * k : ℕ) : ℤ) ih

/-- For an odd multiplier `a0` and `k < 2^(t-1)` the shifted index stays in range. -/
lemma w_plus_two_mul_lt {t : ℕ} (ht : 1 ≤ t) {w k : ℕ} (hw : w ≤ 1) (hk : k < 2 ^ (t - 1)) :
    w + 2 * k < 2 ^ t := by
  have hk2 : 2 * k < 2 * 2 ^ (t - 1) := Nat.mul_lt_mul_of_pos_left hk (by norm_num)
  have hp : 2 * 2 ^ (t - 1) = 2 ^ t := by
    rw [mul_comm, ← pow_succ, Nat.sub_add_cancel ht]
  have hw2 : w + 2 * k ≤ 1 + 2 * k := by omega
  have h1 : 1 + 2 * k < 2 ^ t := by
    -- 2k < 2^t, so 1 + 2k ≤ 2^t, and 2^t ≥ 2 gives strictness via parity: (2k + 1) odd vs 2^t even
    rw [hp] at hk2
    by_cases h2 : 2 * k + 1 < 2 ^ t
    · omega
    · have hle : 2 ^ t ≤ 2 * k + 1 := le_of_not_gt h2
      have hk2' : 2 * k < 2 ^ t := hk2
      omega
  omega

/-- Core parity lemma (abstract): a two-step-affine function `ell` agreeing off its
zeros with `f_q(c0 + a0·j)` (`a0` a unit mod `q`), and not identically zero on `[0,q)`,
has `ell 1 ≢ ell 0 (mod 2)`. -/
lemma diagonal_parity_odd {t : ℕ} (ht4 : 4 ≤ t)
    (ell : ℤ → ZMod (2 ^ t)) (S0 : ZMod (2 ^ t)) (a0 c0 : ℤ)
    (hstep : ∀ j : ℤ, ell (j + 2) = ell j + 2 * S0)
    (ha0u : IsUnit (a0 : ZMod (2 ^ t)))
    (hcons : ∀ j : ℕ, j < 2 ^ t → ell (j : ℤ) ≠ 0 →
      fq (2 ^ t) (c0 + a0 * (j : ℤ)) = ell (j : ℤ))
    (hnz : ∃ j0 : ℕ, j0 < 2 ^ t ∧ ell (j0 : ℤ) ≠ 0) :
    ¬ Even ((ell 1 - ell 0).val) := by
  classical
  intro hsame
  let q : ℕ := 2 ^ t
  let H : ℕ := 2 ^ (t - 1)
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  have hq : 1 < q := by
    dsimp [q]
    have hp : (2 : ℕ) ^ 1 ≤ 2 ^ t := pow_le_pow_right₀ (by norm_num) ht1
    norm_num at hp
    omega
  have hHpos : 0 < H := by dsimp [H]; positivity
  have hq2 : q = 2 * H := by
    dsimp [q, H]
    have hp : 2 * 2 ^ (t - 1) = 2 ^ t := by
      rw [mul_comm, ← pow_succ, Nat.sub_add_cancel ht1]
    exact hp.symm
  have hHle : H ≤ q := by
    rw [hq2]
    omega
  have hH8 : 8 ≤ H := by
    dsimp [H]
    have h3 : 3 ≤ t - 1 := by omega
    have hp : (8 : ℕ) ≤ 2 ^ (t - 1) := by
      have h4 : 2 ^ 3 ≤ 2 ^ (t - 1) := pow_le_pow_right₀ (by norm_num) h3
      norm_num at h4 ⊢
      exact h4
    exact hp
  -- 1. uniform parity (all `ell j` share the parity of `ell 0`)
  have hunif := parity_uniform ell S0 hstep hsame
  have hunif_range : ∀ j : ℕ, j < q → Even ((ell (j : ℤ) - ell 0).val) := by
    intro j hj
    let e : ℕ := j % 2
    let k : ℕ := j / 2
    have he : e ≤ 1 := by
      dsimp [e]
      have hm := Nat.mod_lt j (by norm_num : 0 < 2)
      omega
    have hjk : j = e + 2 * k := by
      dsimp [e, k]
      rw [← Nat.mod_add_div j 2]
      omega
    have hu := hunif e k he
    -- hu : Even ((ell ((e+2k:ℕ):ℤ) − ell0).val)
    have hcast : ((e + 2 * k : ℕ) : ℤ) = (j : ℤ) := by rw [hjk]
    simpa [hcast] using hu
  -- 2. argument parity at clean positions
  have hclean : ∀ j : ℕ, j < q → ell (j : ℤ) ≠ 0 →
      ¬ (((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j : ℤ)) →
      (Even (c0 + a0 * (j : ℤ)) ↔ Even (ell 0).val) := by
    intro j hj hnz0 hnd
    have hfj : fq (2 ^ t) (c0 + a0 * (j : ℤ)) = ell (j : ℤ) := hcons j (by simpa [q] using hj) hnz0
    have harg : (c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) = ell (j : ℤ) := by
      have hfe : fq (2 ^ t) (c0 + a0 * (j : ℤ)) = (c0 + a0 * (j : ℤ) : ZMod (2 ^ t)) := by
        simpa using (fq_eq_self_of_not_dvd_int hq hnd)
      simpa using hfe.symm.trans hfj
    have hEvenArg : Even (c0 + a0 * (j : ℤ)) ↔ Even ((ell (j : ℤ)).val) := by
      have hcast : Even ((c0 + a0 * (j : ℤ) : ZMod (2 ^ t)).val) ↔ Even (c0 + a0 * (j : ℤ)) := by
        simpa using (Commons.Data.ZMod.val_even_intCast ht1 (c0 + a0 * (j : ℤ)))
      rw [← harg]
      exact hcast.symm
    have huni : Even ((ell (j : ℤ)).val) ↔ Even ((ell 0).val) :=
      (Commons.Data.ZMod.val_even_sub_iff (ell (j : ℤ)) (ell 0)).mp (hunif_range j hj)
    exact hEvenArg.trans huni
  -- 3. zero coverage on the wrong class
  have hcover : ∀ j : ℕ, j < q → ¬ (Even (c0 + a0 * (j : ℤ)) ↔ Even (ell 0).val) →
      ell (j : ℤ) = 0 ∨ (((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j : ℤ)) := by
    intro j hj hwrong
    by_cases hj0 : ell (j : ℤ) = 0
    · exact Or.inl hj0
    · right
      by_contra hnd
      exact hwrong (hclean j hj hj0 hnd)
  rcases exists_wrong_class ht1 a0 c0 ha0u (Even (ell 0).val) with ⟨w, hwle, hwclass⟩
  -- 4. zero count on the wrong class w: ≥ H − 1
  let Z : Finset ℕ := (Finset.range H).filter (fun k => ell (((w + 2 * k : ℕ) : ℤ)) = 0)
  let Bad : Finset ℕ := (Finset.range H).filter
    (fun k => (((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * ((w + 2 * k : ℕ) : ℤ)))
  have hZsub : Z ⊆ Finset.range H := by
    intro k hk
    exact Finset.mem_filter.mp hk |>.1
  have hZcover : ∀ k : ℕ, k < H → ell (((w + 2 * k : ℕ) : ℤ)) = 0 ∨
      (((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * ((w + 2 * k : ℕ) : ℤ)) := by
    intro k hk
    let j : ℕ := w + 2 * k
    have hjl : j < q := by
      dsimp [j, q]
      exact w_plus_two_mul_lt ht1 hwle (by simpa [H] using hk)
    have hcls := hwclass j (by simpa [j, q] using hjl)
    have hmod : j % 2 = w := by
      dsimp [j]
      have hm : (w + 2 * k) % 2 = w % 2 := by
        simpa [mul_comm] using (Nat.add_mul_mod_self_left w k 2)
      rw [hm]
      omega
    have hwrg : ¬ (Even (c0 + a0 * (j : ℤ)) ↔ Even (ell 0).val) := hcls.mp hmod
    exact hcover j hjl hwrg
  have hsub : Finset.range H ⊆ Z ∪ Bad := by
    intro k hk
    have hkH : k < H := Finset.mem_range.mp hk
    rcases hZcover k hkH with hz | hb
    · exact Finset.mem_union.mpr (Or.inl (Finset.mem_filter.mpr ⟨hk, hz⟩))
    · exact Finset.mem_union.mpr (Or.inr (Finset.mem_filter.mpr ⟨hk, hb⟩))
  have hBad1 : Bad.card ≤ 1 := by
    let J : Finset ℕ := Bad.image (fun k => w + 2 * k)
    have hinj : Function.Injective (fun k : ℕ => w + 2 * k) := by
      intro k1 k2 h
      have h2 : 2 * k1 = 2 * k2 := add_left_cancel h
      exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h2
    have hJcard : J.card = Bad.card := by
      dsimp [J]
      exact Finset.card_image_of_injective Bad hinj
    have hJsub : J ⊆ Finset.range (2 ^ t) := by
      intro j hj
      rw [Finset.mem_range]
      rcases Finset.mem_image.mp hj with ⟨k, hkB, rfl⟩
      have hkH : k < H := Finset.mem_range.mp (Finset.mem_filter.mp hkB |>.1)
      exact w_plus_two_mul_lt ht1 hwle (by simpa [H] using hkH)
    have hJ : ∀ j ∈ J, ((2 ^ t : ℕ) : ℤ) ∣ c0 + a0 * (j : ℤ) := by
      intro j hj
      rcases Finset.mem_image.mp hj with ⟨k, hkB, rfl⟩
      exact (Finset.mem_filter.mp hkB).2
    have hJ1 : J.card ≤ 1 := arg_zero_at_most_one a0 c0 ha0u J hJsub hJ
    rw [← hJcard]
    exact hJ1
  have hZcard : H - 1 ≤ Z.card := by
    have hsum : H ≤ Z.card + Bad.card := by
      calc
        H = (Finset.range H).card := (Finset.card_range H).symm
        _ ≤ (Z ∪ Bad).card := Finset.card_le_card hsub
        _ ≤ Z.card + Bad.card := Finset.card_union_le Z Bad
    omega
  -- 5. many zeros on one parity class force both the class value and the slope to vanish
  have hZeros : ∀ k ∈ Z, (ell (w : ℤ)) + (2 * S0) * (k : ZMod (2 ^ t)) = 0 := by
    intro k hk
    have hz : ell (((w + 2 * k : ℕ) : ℤ)) = 0 := (Finset.mem_filter.mp hk).2
    have hcaf := class_affine ell S0 hstep w k
    -- hcaf : ell((w+2k:ℕ):ℤ) = ell(w:ℤ) + (k:ZMod)*(2*S0)
    rw [hcaf] at hz
    simpa [mul_comm] using hz
  have hclz := Commons.Data.Nat.class_zeros_many (t := t) ht4 (2 * S0) (ell (w : ℤ)) Z hZsub hZcard hZeros
  have hS0 : 2 * S0 = 0 := hclz.1
  have hw0 : ell (w : ℤ) = 0 := hclz.2
  -- 6. the other class: with the slope killed it is constant; nonzero constant gives the
  --    fiber contradiction, zero constant makes ell vanish everywhere
  let wp : ℕ := 1 - w
  have hwple : wp ≤ 1 := by omega
  have hdiff : wp ≠ w := by omega
  have hwp0 : wp = 0 ∨ wp = 1 := by omega
  have hclassc : ∀ k : ℕ, ell (((wp + 2 * k : ℕ) : ℤ)) = ell (wp : ℤ) := by
    intro k
    have hcaf := class_affine ell S0 hstep wp k
    rw [hS0] at hcaf
    simpa using hcaf
  by_cases hu' : ell (wp : ℤ) = 0
  · -- both classes vanish: ell ≡ 0 on [0,q): contradiction with hnz
    exfalso
    rcases hnz with ⟨j0, hj0, hnj0⟩
    let e0 : ℕ := j0 % 2
    let k0 : ℕ := j0 / 2
    have he0 : e0 ≤ 1 := by
      dsimp [e0]
      have hm := Nat.mod_lt j0 (by norm_num : 0 < 2)
      omega
    have hjk0 : j0 = e0 + 2 * k0 := by
      dsimp [e0, k0]
      rw [← Nat.mod_add_div j0 2]
      omega
    have hull0 : ell (0 : ℤ) = 0 ∧ ell (1 : ℤ) = 0 := by
      have hw01 : w = 0 ∨ w = 1 := by omega
      rcases hw01 with rfl | rfl
      · constructor
        · exact hw0
        · simpa [wp] using hu'
      · constructor
        · simpa [wp] using hu'
        · exact hw0
    have hz0 : ell (j0 : ℤ) = 0 := by
      have hcaf := class_affine ell S0 hstep e0 k0
      rw [hS0] at hcaf
      have hval : ell (((e0 + 2 * k0 : ℕ) : ℤ)) = ell (e0 : ℤ) := by
        simpa using hcaf
      have hull : ell (e0 : ℤ) = 0 := by
        by_cases he0z : e0 = 0
        · rw [he0z]
          exact hull0.1
        · have he0z' : e0 = 1 := by omega
          rw [he0z']
          exact hull0.2
      have hcast : ((e0 + 2 * k0 : ℕ) : ℤ) = (j0 : ℤ) := by rw [hjk0]
      rwa [← hcast, hval]
    exact hnj0 hz0
  · -- ell(wp:ℤ) ≠ 0: all H members of class wp have this value; fq fiber bound
    exfalso
    let JW : Finset ℕ := (Finset.range H).image (fun k => wp + 2 * k)
    have hinjW : Function.Injective (fun k : ℕ => wp + 2 * k) := by
      intro k1 k2 h
      have h2 : 2 * k1 = 2 * k2 := add_left_cancel h
      exact Nat.mul_left_cancel (by norm_num : (0 : ℕ) < 2) h2
    have hJsub : JW ⊆ Finset.range (2 ^ t) := by
      intro j hj
      rw [Finset.mem_range]
      rcases Finset.mem_image.mp hj with ⟨k, hkH, rfl⟩
      have hkk : k < H := Finset.mem_range.mp hkH
      exact w_plus_two_mul_lt ht1 hwple (by simpa [H] using hkk)
    have hJfq : ∀ j ∈ JW, fq (2 ^ t) (c0 + a0 * (j : ℤ)) = ell (wp : ℤ) := by
      intro j hj
      rcases Finset.mem_image.mp hj with ⟨k, hkH, rfl⟩
      have hkk : k < H := Finset.mem_range.mp hkH
      have hjl : wp + 2 * k < q := by
        exact w_plus_two_mul_lt ht1 hwple (by simpa [H] using hkk)
      have hnj : ell (((wp + 2 * k : ℕ) : ℤ)) ≠ 0 := by
        have hval0 : ell (((wp + 2 * k : ℕ) : ℤ)) = ell (wp : ℤ) := hclassc k
        rwa [hval0]
      have hf := hcons (wp + 2 * k) (by simpa [q] using hjl) hnj
      have hval' : ell ((wp : ℤ) + 2 * (k : ℤ)) = ell (wp : ℤ) := by
        simpa using (hclassc k)
      simpa [hval'] using hf
    have hcJW : JW.card ≤ 2 :=
      fq_progression_fiber_le_two ht1 a0 c0 ha0u (ell (wp : ℤ)) hu' JW hJsub hJfq
    have hcW : JW.card = H := by
      dsimp [JW]
      rw [Finset.card_image_of_injective (Finset.range H) hinjW, Finset.card_range]
    have hbig : H > 2 := by omega
    omega

/-- Arithmetic helper: `n0 + q·j ≤ q²` for `1 ≤ n0 ≤ q` and `j < q`. -/
lemma diag_row_in_range {t : ℕ} {n0 j : ℤ} (hn0 : n0 ≤ ((2 ^ t : ℕ) : ℤ)) (hn1 : 1 ≤ n0)
    (hj : j < ((2 ^ t : ℕ) : ℤ)) (hjn : 0 ≤ j) :
    n0 + ((2 ^ t : ℕ) : ℤ) * j ≤ ((2 ^ t * 2 ^ t : ℕ) : ℤ) := by
  have hqpos : 0 ≤ ((2 ^ t : ℕ) : ℤ) := by positivity
  have hjz : j ≤ ((2 ^ t : ℕ) : ℤ) - 1 := by omega
  have hm : ((2 ^ t : ℕ) : ℤ) * j ≤ ((2 ^ t : ℕ) : ℤ) * (((2 ^ t : ℕ) : ℤ) - 1) :=
    mul_le_mul_of_nonneg_left hjz hqpos
  have hsq : ((2 ^ t : ℕ) : ℤ) + ((2 ^ t : ℕ) : ℤ) * (((2 ^ t : ℕ) : ℤ) - 1) = ((2 ^ t * 2 ^ t : ℕ) : ℤ) := by
    have hn : ((2 ^ t : ℕ) : ℤ) * ((2 ^ t : ℕ) : ℤ) = ((2 ^ t * 2 ^ t : ℕ) : ℤ) := by
      rw [← Nat.cast_mul]
    calc
      ((2 ^ t : ℕ) : ℤ) + ((2 ^ t : ℕ) : ℤ) * (((2 ^ t : ℕ) : ℤ) - 1)
          = ((2 ^ t : ℕ) : ℤ) * ((2 ^ t : ℕ) : ℤ) := by ring
      _ = ((2 ^ t * 2 ^ t : ℕ) : ℤ) := hn
  omega

/-- The diagonal parity lemma at the pseudo-affine level: on a diagonal `D(n0,m0)`
(`n0 ∈ {1,…,q}`) where the pseudo-affine function does not vanish identically and the
`fq`-identity holds off its zeros (`a0` a unit), the coefficient `B` is odd. -/
lemma diag_parity_odd_pseudoAffine {t : ℕ} (ht3 : 3 ≤ t) (ht4 : 4 ≤ t)
    (A B C D : ZMod (2 ^ t)) (n0 m0 a0 c0 : ℤ)
    (hn0 : 1 ≤ n0) (hn0q : n0 ≤ ((2 ^ t : ℕ) : ℤ))
    (ha0u : IsUnit (a0 : ZMod (2 ^ t)))
    (hℓ1 : ∃ j0 : ℕ, j0 < 2 ^ t ∧
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j0 : ℤ)) (m0 + (j0 : ℤ)) ≠ 0)
    (hcons : ∀ j : ℕ, j < 2 ^ t →
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) (m0 + (j : ℤ)) ≠ 0 →
        fq (2 ^ t) (c0 + a0 * (j : ℤ)) =
          pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) (m0 + (j : ℤ))) :
    ¬ Even B.val := by
  classical
  have ht2 : 2 ≤ t := by omega
  have hstep : ∀ j : ℤ, diagEll A B C D n0 m0 (j + 2) =
      diagEll A B C D n0 m0 j + 2 * (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) :=
    diagEll_two_step ht2 A B C D n0 m0
  have hℓ1' : ∃ j0 : ℕ, j0 < 2 ^ t ∧ diagEll A B C D n0 m0 (j0 : ℤ) ≠ 0 := by
    rcases hℓ1 with ⟨j0, hj0, hℓ⟩
    exact ⟨j0, hj0, by simpa [diagEll] using hℓ⟩
  have hcons' : ∀ j : ℕ, j < 2 ^ t → diagEll A B C D n0 m0 (j : ℤ) ≠ 0 →
      fq (2 ^ t) (c0 + a0 * (j : ℤ)) = diagEll A B C D n0 m0 (j : ℤ) := by
    intro j hj hz
    have hc := hcons j hj (by simpa [diagEll] using hz)
    simpa [diagEll] using hc
  have hodd := diagonal_parity_odd (t := t) ht4 (diagEll A B C D n0 m0)
    (B - (qFourth t * D) * (n0 : ZMod (2 ^ t))) a0 c0 hstep ha0u hcons' hℓ1'
  intro hBev
  have hsame : Even (((diagEll A B C D n0 m0 1) - (diagEll A B C D n0 m0 0)).val) := by
    have htw : ∃ w : ZMod (2 ^ t), B = 2 * w :=
      (Commons.Data.ZMod.even_val_iff_two_mul B).mp hBev
    rcases htw with ⟨w, hw⟩
    rcases diag_parity_step (t := t) ht3 A B C D n0 m0 0 with ⟨x, hx⟩
    -- hx : PA(n0+q(0+1))(m0+1) − PA(n0+q·0)(m0+0) = B + 2x
    have hd : (diagEll A B C D n0 m0 1) - (diagEll A B C D n0 m0 0) = B + 2 * x := by
      dsimp [diagEll]
      simpa using hx
    have htwo : (diagEll A B C D n0 m0 1) - (diagEll A B C D n0 m0 0) = 2 * (w + x) := by
      rw [hd, hw]
      ring
    exact (Commons.Data.ZMod.even_val_iff_two_mul ((diagEll A B C D n0 m0 1) - (diagEll A B C D n0 m0 0))).mpr ⟨w + x, htwo⟩
  exact hodd hsame

/-- Near-digit on the post-Tetris board of a normal-form Sudoku solution: the vertical
coefficient `B` of the pseudo-affine function `Ψ*` is odd. -/
lemma postTetris_B_odd {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m)
    (A B C D : ZMod (2 ^ t))
    (hΨ1 : ∃ r0 : Fin (2 ^ t * 2 ^ t), ∃ m0 : ℤ,
      pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0)
    (hΨ2 : ∀ r m, pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
      postTetris F r m = pseudoAffineVal A B C D (rowVal r) m) :
    ¬ Even B.val := by
  classical
  have ht3 : 3 ≤ t := by omega
  have ht4 : 4 ≤ t := by omega
  have ht1 : 1 ≤ t := by omega
  rcases diag_psi_anchor ht24 F hF Dp hNF A B C D hΨ1 hΨ2 with
    ⟨n0, m0, a0, c0, hn0, hn0q, ha0u, hj0h, heq⟩
  -- heq : ∀ j < 2^t, ∀ r : Fin (2^t*2^t), rowVal r = n0 + q·j →
  --   Ψ(rowVal r, m0 + j) ≠ 0 → fq(c0+a0j) = Ψ(rowVal r, m0+j)
  have hℓ1 : ∃ j0 : ℕ, j0 < 2 ^ t ∧
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j0 : ℤ)) (m0 + (j0 : ℤ)) ≠ 0 := by
    rcases hj0h with ⟨j0, hj0, hΨnz⟩
    exact ⟨j0, hj0, hΨnz⟩
  have hcons : ∀ j : ℕ, j < 2 ^ t →
      pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) (m0 + (j : ℤ)) ≠ 0 →
        fq (2 ^ t) (c0 + a0 * (j : ℤ)) =
          pseudoAffineVal A B C D (n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)) (m0 + (j : ℤ)) := by
    intro j hj hnj
    let x : ℤ := n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ)
    have hx1 : 1 ≤ x := by
      dsimp [x]
      have hq0 : 0 ≤ ((2 ^ t : ℕ) : ℤ) := by positivity
      have hjm : 0 ≤ (j : ℤ) := by exact_mod_cast (Nat.zero_le j)
      have hqj : 0 ≤ ((2 ^ t : ℕ) : ℤ) * (j : ℤ) := mul_nonneg hq0 hjm
      exact le_trans hn0 (le_add_of_nonneg_right hqj)
    have hxN : x ≤ ((2 ^ t * 2 ^ t : ℕ) : ℤ) := by
      dsimp [x]
      have hjl : (j : ℤ) < ((2 ^ t : ℕ) : ℤ) := by exact_mod_cast hj
      exact diag_row_in_range hn0q hn0 hjl (by exact_mod_cast (Nat.zero_le j))
    rcases exists_row_rowVal x hx1 hxN with ⟨r, hr⟩
    have hr' : rowVal r = n0 + ((2 ^ t : ℕ) : ℤ) * (j : ℤ) := by simpa [x] using hr
    have hnj' : pseudoAffineVal A B C D (rowVal r) (m0 + (j : ℤ)) ≠ 0 := by
      rw [hr']
      simpa using hnj
    have hh := heq j hj r hr' hnj'
    simpa [hr'] using hh
  exact diag_parity_odd_pseudoAffine ht3 ht4 A B C D n0 m0 a0 c0 hn0 hn0q ha0u hℓ1 hcons

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! ## Tetris iteration (paper Prop tetris-iterate, tex 1394-1447)

`tetris_iterate`: for a normal-form Sudoku solution `F` (width `q²`, `q = 2^t`,
`t ≥ 24`), the post-Tetris board `F* := F(n, q·m)` has a shearing in normal form.
Assembly of `near_digit_Fstar` (∃ pseudo-affine `Ψ*` for `F*`), `postTetris_B_odd`
(B* odd) and `norm_normal_form`. -/

theorem tetris_iterate {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t))
    (hNF : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m) :
    ∃ (a b : ℤ) (c Dp' : ZMod (2 ^ t)),
      IsUnit c ∧
      IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t)
        (fun r m => c * postTetris F r (m + a * rowVal r + b)) ∧
      ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
        c * postTetris F r (m + a * rowVal r + b)
          = (m : ZMod (2 ^ t))
              + (qFourth t * Dp') * (m : ZMod (2 ^ t)) * ((m : ZMod (2 ^ t)) - (rowVal r : ZMod (2 ^ t))) := by
  classical
  let G : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t) := postTetris F
  have hG : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) G := by
    simpa [G] using (postTetris_is_sudoku F hF)
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have ht4 : 4 ≤ t := by omega
  rcases near_digit_Fstar ht24 F hF Dp hNF with ⟨A, B, C, D, hΨ1, hΨ2⟩
  have hBodd : ¬ Even B.val := postTetris_B_odd ht24 F hF Dp hNF A B C D hΨ1 hΨ2
  have hnorm := norm_normal_form ht1 ht2 ht3 ht4 G hG A B C D hBodd hΨ2
  rcases hnorm with ⟨a, b, c, Dp', hcU, hGshear, hnf⟩
  refine ⟨a, b, c, Dp', hcU, ?_, ?_⟩
  · simpa [G] using hGshear
  · intro r m hm
    simpa [G] using hnf r m hm

end
end Commons.PeriodicTiling


namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # main-sudoku: the descent to non-periodicity (arXiv:2211.15847, tex 1392-1399)

Assembles the end of Phase 1.  A good-columns Sudoku solution of width `q²` (`q = 2^t`,
`t ≥ 24`) has no non-zero *vertical* period `⟨0, M⟩`: near-digit → is-odd (B odd) →
normal form (shear), then the normal-form descent (tetris iteration shrinks the period
by a factor `q` forever), which is absurd.

The vertical-period / normal-form vocabulary:
- `VerticalPeriod F M` : `F r (m + M) = F r m` for every row `r` and column `m`;
- `NormalForm F Dp` : for `m ∉ qℤ`, `F r m = m̂ + (q/4)·Dp·m̂·(m̂ − n̂)`
  (`n̂ := rowVal r mod q`), exactly the value equation delivered by
  `norm_normal_form` / `tetris_iterate`. -/

/-- The normal-form value `m̂ + (q/4)·Dp·m̂·(m̂−n̂)` at a column class `m` on a row
class `n`. -/
def nfVal {t : ℕ} (Dp : ZMod (2 ^ t)) (n m : ZMod (2 ^ t)) : ZMod (2 ^ t) :=
  m + (qFourth t * Dp) * m * (m - n)

/-- `F` is in normal form with coefficient `Dp`: off the `qℤ` columns, `F` equals the
normal-form value. -/
def NormalForm {t N : ℕ} (F : SudokuBoard (2 ^ t) N) (Dp : ZMod (2 ^ t)) : Prop :=
  ∀ r : Fin N, ∀ m : ℤ, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
    F r m = nfVal Dp (rowVal r : ZMod (2 ^ t)) (m : ZMod (2 ^ t))

/-- `F` is invariant under the vertical translation `m ↦ m + M` on every row. -/
def VerticalPeriod {q N : ℕ} (F : SudokuBoard q N) (P : ℤ) : Prop :=
  ∀ r : Fin N, ∀ m : ℤ, F r (m + P) = F r m

/-- The normal-form row map `u ↦ u + (q/4)Dp·u·(u−n)`, which is injective (`t ≥ 3`,
`rowMap_injective`); the normal-form value on a row is `rowMap` of the column class. -/
lemma nfVal_eq_rowMap {t : ℕ} (Dp : ZMod (2 ^ t)) (n m : ZMod (2 ^ t)) :
    nfVal Dp n m = rowMap Dp n m := by
  dsimp [nfVal, rowMap]

/-! ## (a) shearing preserves vertical periods -/

/-- The shear `(r, m) ↦ c·F r (m + a·rowVal r + b)` preserves any vertical period. -/
lemma shear_preserves_verticalPeriod {q N : ℕ} (F : SudokuBoard q N) {P : ℤ}
    (hper : VerticalPeriod F P) (a b : ℤ) (c : ZMod q) :
    VerticalPeriod (fun r m => c * F r (m + a * rowVal r + b)) P := by
  intro r m
  have hshift : (m + P) + a * rowVal r + b = (m + a * rowVal r + b) + P := by ring
  calc
    c * F r ((m + P) + a * rowVal r + b)
        = c * F r ((m + a * rowVal r + b) + P) := by rw [hshift]
    _ = c * F r (m + a * rowVal r + b) := by rw [hper r (m + a * rowVal r + b)]

/-! ## (b) a normal-form solution with vertical period `M` satisfies `q | M` -/

/-- A normal-form Sudoku board (any width `N ≥ 1`) with a vertical period `M` has
`q = 2^t` dividing `M` (`t ≥ 3`).  Proof: pick a column `m ∈ {1,2}` with `m, m+M ∉ qℤ`;
both values are the normal-form values, hence `rowMap(m̂ + M̂) = rowMap(m̂)`, and
injectivity of the row map forces `M̂ = 0`. -/
lemma normalForm_period_dvd_q {t N : ℕ} (ht3 : 3 ≤ t) (hN : 0 < N)
    (F : SudokuBoard (2 ^ t) N) (Dp : ZMod (2 ^ t))
    (hNF : NormalForm F Dp) (M : ℤ) (hper : VerticalPeriod F M) :
    ((2 ^ t : ℕ) : ℤ) ∣ M := by
  classical
  let qz : ℤ := ((2 ^ t : ℕ) : ℤ)
  let r0 : Fin N := ⟨0, hN⟩
  have ht1 : 1 ≤ t := by omega
  have hthree : 3 ≤ 2 ^ t := by
    have h := two_pow_ge_eight ht3
    omega
  have hnot1 : ¬ qz ∣ (1 : ℤ) := by
    dsimp [qz]
    exact not_dvd_int_one_of_three_le hthree
  have hnot2 : ¬ qz ∣ (2 : ℤ) := by
    dsimp [qz]
    exact not_dvd_int_two_of_three_le hthree
  -- core: any column `m` with both `m` and `m + M` off `qℤ` witnesses `q | M`
  have hcore : ∀ m : ℤ, ¬ qz ∣ m → ¬ qz ∣ (m + M) → qz ∣ M := by
    intro m hm hmP
    have hvm := hNF r0 m hm
    have hvp := hNF r0 (m + M) hmP
    have heq : nfVal Dp (rowVal r0 : ZMod (2 ^ t)) ((m + M : ℤ) : ZMod (2 ^ t)) =
        nfVal Dp (rowVal r0 : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) := by
      rw [← hvp, hper r0 m, hvm]
    have hinj : Function.Injective (rowMap Dp (rowVal r0 : ZMod (2 ^ t))) :=
      rowMap_injective (t := t) ht3 Dp (rowVal r0 : ZMod (2 ^ t))
    have hrow : rowMap Dp (rowVal r0 : ZMod (2 ^ t)) ((m + M : ℤ) : ZMod (2 ^ t)) =
        rowMap Dp (rowVal r0 : ZMod (2 ^ t)) (m : ZMod (2 ^ t)) := by
      simpa [nfVal, rowMap] using heq
    have harg : ((m + M : ℤ) : ZMod (2 ^ t)) = (m : ZMod (2 ^ t)) := hinj hrow
    have hM0 : (M : ZMod (2 ^ t)) = 0 := by
      have harg' : (m : ZMod (2 ^ t)) + (M : ZMod (2 ^ t)) = (m : ZMod (2 ^ t)) + 0 := by
        simpa [← Int.cast_add] using harg
      exact add_left_cancel harg'
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (a := M) (b := 2 ^ t)).mp hM0
  by_cases h1 : qz ∣ M + 1
  · refine hcore 2 hnot2 ?_
    intro h2div
    have hsub : qz ∣ (2 + M) - (M + 1) := Int.dvd_sub h2div h1
    have hone : (2 + M) - (M + 1) = (1 : ℤ) := by ring
    rw [hone] at hsub
    exact hnot1 hsub
  · exact hcore 1 hnot1 (by simpa [add_comm] using h1)

/-! ## (c) the Tetris move divides the period by `q` -/

/-- If `F` has vertical period `M = q·M₁`, then `postTetris F` (the board
`(r,m) ↦ F r (q·m)`) has vertical period `M₁`. -/
lemma postTetris_verticalPeriod_div {t N : ℕ} (_ht1 : 1 ≤ t)
    (F : SudokuBoard (2 ^ t) N) {M M₁ : ℤ}
    (hM₁ : M = ((2 ^ t : ℕ) : ℤ) * M₁) (hper : VerticalPeriod F M) :
    VerticalPeriod (postTetris F) M₁ := by
  intro r m
  have hcast : ((2 ^ t : ℕ) : ℤ) * (m + M₁) = ((2 ^ t : ℕ) : ℤ) * m + M := by
    rw [hM₁]
    ring
  calc
    postTetris F r (m + M₁) = F r (((2 ^ t : ℕ) : ℤ) * (m + M₁)) := rfl
    _ = F r (((2 ^ t : ℕ) : ℤ) * m + M) := by rw [hcast]
    _ = F r (((2 ^ t : ℕ) : ℤ) * m) := hper r (((2 ^ t : ℕ) : ℤ) * m)
    _ = postTetris F r m := rfl

/-! ## (d) the descent step -/

/-- From a normal-form Sudoku solution `F` of width `q²` (`q = 2^t`, `t ≥ 24`) with a
non-zero vertical period `M`, the tetris iteration produces another normal-form Sudoku
solution `G` of the same width with vertical period `M₁ = M/q` (`M = q·M₁`, `M₁ ≠ 0`). -/
lemma normalForm_descent_step {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t)) (hNF : NormalForm F Dp)
    (M : ℤ) (hM : M ≠ 0) (hper : VerticalPeriod F M) :
    ∃ (G : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t)) (Dp' : ZMod (2 ^ t)),
      IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) G ∧ NormalForm G Dp' ∧
      ∃ M₁ : ℤ, M = ((2 ^ t : ℕ) : ℤ) * M₁ ∧ M₁ ≠ 0 ∧ VerticalPeriod G M₁ := by
  classical
  have ht1 : 1 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have hNpos : 0 < 2 ^ t * 2 ^ t :=
    Nat.mul_pos (pow_pos (by norm_num) t) (pow_pos (by norm_num) t)
  -- (i) `q | M` from normal form + periodicity
  have hdiv := normalForm_period_dvd_q (t := t) (N := 2 ^ t * 2 ^ t) ht3 hNpos F Dp hNF M hper
  rcases hdiv with ⟨M₁, hM₁⟩
  -- (ii) tetris iterate `F`
  have hNFpa : ∀ r m, ¬ (((2 ^ t : ℕ) : ℤ) ∣ m) →
      F r m = pseudoAffineVal 0 1 0 Dp (rowVal r) m := by
    intro r m hm
    simpa [pseudoAffineVal, pseudoCorr, nfVal] using hNF r m hm
  rcases tetris_iterate ht24 F hF Dp hNFpa with ⟨a, b, c, Dp', _hcU, hGsud, hGnf⟩
  let G : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t) :=
    fun r m => c * postTetris F r (m + a * rowVal r + b)
  have hGsud' : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) G := by
    simpa [G] using hGsud
  have hGnf' : NormalForm G Dp' := by
    intro r m hm
    simpa [G, nfVal] using hGnf r m hm
  -- (iii) the period divides: `postTetris F` has period `M₁`, and shear keeps it
  have hperFstar : VerticalPeriod (postTetris F) M₁ :=
    postTetris_verticalPeriod_div (t := t) (N := 2 ^ t * 2 ^ t) ht1 F (M₁ := M₁) hM₁ hper
  have hperG0 : VerticalPeriod (fun r m => c * postTetris F r (m + a * rowVal r + b)) M₁ :=
    shear_preserves_verticalPeriod (postTetris F) hperFstar a b c
  have hperG : VerticalPeriod G M₁ := by
    simpa [G] using hperG0
  -- (iv) `M₁ ≠ 0`
  have hM₁nz : M₁ ≠ 0 := by
    intro hM₁0
    apply hM
    rw [hM₁, hM₁0]
    ring
  refine ⟨G, Dp', hGsud', hGnf', M₁, hM₁, hM₁nz, hperG⟩

/-! ## (e) infinite descent: no normal-form solution has a vertical period -/

/-- A normal-form Sudoku solution of width `q²` (`q = 2^t`, `t ≥ 24`) has no non-zero
vertical period: any such period would descend `M ↦ M/q` forever (well-founded on
`|M|`), contradiction. -/
theorem normalForm_no_verticalPeriod {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (Dp : ZMod (2 ^ t)) (hNF : NormalForm F Dp)
    (M : ℤ) (hM : M ≠ 0) (hper : VerticalPeriod F M) : False := by
  classical
  have hwf : WellFounded (fun a b : ℤ => a.natAbs < b.natAbs) :=
    InvImage.wf (fun z : ℤ => z.natAbs) Nat.lt_wfRel.wf
  let P : ℤ → Prop := fun N : ℤ =>
    N ≠ 0 →
    ∀ (G : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t)),
      IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) G →
      ∀ Dp' : ZMod (2 ^ t), NormalForm G Dp' → VerticalPeriod G N → False
  have hstep : ∀ N : ℤ, (∀ N' : ℤ, N'.natAbs < N.natAbs → P N') → P N := by
    intro N ih hNnz G hGsud Dp' hGnf hperN
    rcases normalForm_descent_step ht24 G hGsud Dp' hGnf N hNnz hperN with
      ⟨G₁, Dp'', hG₁sud, hG₁nf, M₁, hM₁, hM₁nz, hperG₁⟩
    have hqge2 : 2 ≤ (2 ^ t : ℕ) := by
      have h8 := two_pow_ge_eight (by omega : 3 ≤ t)
      omega
    have h0 : 0 < M₁.natAbs := Int.natAbs_pos.mpr hM₁nz
    have hqnat : ((2 ^ t : ℕ) : ℤ).natAbs = 2 ^ t := by
      exact_mod_cast (Int.natAbs_of_nonneg (a := ((2 ^ t : ℕ) : ℤ)) (by positivity : (0 : ℤ) ≤ ((2 ^ t : ℕ) : ℤ)))
    have hNabs : N.natAbs = (2 ^ t) * M₁.natAbs := by
      calc
        N.natAbs = (((2 ^ t : ℕ) : ℤ) * M₁).natAbs := by rw [hM₁]
        _ = ((2 ^ t : ℕ) : ℤ).natAbs * M₁.natAbs := Int.natAbs_mul ((2 ^ t : ℕ) : ℤ) M₁
        _ = (2 ^ t) * M₁.natAbs := by rw [hqnat]
    have hlt : M₁.natAbs < N.natAbs := by
      rw [hNabs]
      have htwo : M₁.natAbs < 2 * M₁.natAbs := by omega
      have hle : 2 * M₁.natAbs ≤ (2 ^ t) * M₁.natAbs := Nat.mul_le_mul_right M₁.natAbs hqge2
      exact lt_of_lt_of_le htwo hle
    exact ih M₁ hlt hM₁nz G₁ hG₁sud Dp'' hG₁nf hperG₁
  exact (WellFounded.induction hwf M hstep) hM F hF Dp hNF hper

/-! ## near-digit at width `q² = 2^t · 2^t` (same content as `near_digit_main`) -/

/-- Proposition near-digit specialised to the width `N = q² = 2^t·2^t` (`t ≥ 24`), the
width used throughout the Sudoku section. -/
theorem near_digit_main_sq {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (hgood : HasGoodColumns (2 ^ t) (2 ^ t * 2 ^ t) F) :
    ∃ A B C D : ZMod (2 ^ t),
      (∃ r0 : Fin (2 ^ t * 2 ^ t), ∃ m0 : ℤ,
        pseudoAffineVal A B C D (rowVal r0) m0 ≠ 0) ∧
      ∀ r : Fin (2 ^ t * 2 ^ t), ∀ m : ℤ,
        pseudoAffineVal A B C D (rowVal r) m ≠ 0 →
          F r m = pseudoAffineVal A B C D (rowVal r) m := by
  classical
  have ht1 : 1 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have hN16 : 16 ≤ 2 ^ t * 2 ^ t := by
    have h16 : 16 ≤ 2 ^ t := by
      have h4 : (4 : ℕ) ≤ t := by omega
      exact le_trans (by norm_num : (16 : ℕ) ≤ 2 ^ 4) (pow_le_pow_right₀ (by norm_num) h4)
    have h1 : 1 ≤ 2 ^ t := by
      have h8 := two_pow_ge_eight ht3
      omega
    have hmul : 2 ^ t ≤ 2 ^ t * 2 ^ t := by
      simpa using (Nat.mul_le_mul_left (2 ^ t) h1)
    exact le_trans h16 hmul
  have hineq : 3 * t * 128 * rareConst t (2 ^ t * 2 ^ t) (2 ^ t * 2 ^ t) <
      (2 ^ t * 2 ^ t - 7) * (2 ^ t * 2 ^ t - 7) := by
    have hm := rareConst_ineq_24 t ht24
    rw [← two_pow_sq t] at hm
    exact hm
  exact near_digit_main_generic (t := t) (N := 2 ^ t * 2 ^ t) ht1 ht3 hN16 F hF hgood hineq

/-! ## main-sudoku (Phase 1 finale) -/

/-- Every Sudoku solution of width `q²` (`q = 2^t`, `t ≥ 24`) with good columns has no
non-zero vertical period.  Proof: near-digit gives the pseudo-affine agreement, is-odd
makes `B` odd, the normal-form proposition shears `F` to a normal-form solution `F₁`
(periodicity is preserved by the shear), and the normal-form descent is absurd. -/
theorem main_sudoku_no_verticalPeriod {t : ℕ} (ht24 : 24 ≤ t)
    (F : SudokuBoard (2 ^ t) (2 ^ t * 2 ^ t))
    (hF : IsSudokuSolution (2 ^ t) (2 ^ t * 2 ^ t) F)
    (hgood : HasGoodColumns (2 ^ t) (2 ^ t * 2 ^ t) F) :
    ∀ M : ℤ, M ≠ 0 → ¬ VerticalPeriod F M := by
  classical
  intro M hM hper
  have ht1 : 1 ≤ t := by omega
  have ht2 : 2 ≤ t := by omega
  have ht3 : 3 ≤ t := by omega
  have ht4 : 4 ≤ t := by omega
  have ht5 : 5 ≤ t := by omega
  rcases near_digit_main_sq ht24 F hF hgood with ⟨A, B, C, D, hnd⟩
  have hBodd : ¬ Even B.val :=
    is_odd_B ht5 F hF hgood A B C D (by simpa [vFunc] using hnd)
  rcases norm_normal_form (t := t) (N := 2 ^ t * 2 ^ t) ht1 ht2 ht3 ht4 F hF A B C D hBodd hnd.2 with
    ⟨a, b, c, Dp', _hcU, hF₁sud, hF₁nf⟩
  have hF₁nf' : NormalForm (fun r m => c * F r (m + a * rowVal r + b)) Dp' := by
    intro r m hm
    simpa [nfVal] using hF₁nf r m hm
  have hF₁per : VerticalPeriod (fun r m => c * F r (m + a * rowVal r + b)) M :=
    shear_preserves_verticalPeriod F hper a b c
  exact normalForm_no_verticalPeriod ht24
    (fun r m => c * F r (m + a * rowVal r + b)) hF₁sud Dp' hF₁nf' M hM hF₁per


/-! ## the standard solution has good columns (satisfiability witness for Phase 3) -/

/-- The standard Sudoku solution `F(n,m) = f_q(m)` has good columns (with every column
permutation the identity). -/
lemma standardSudoku_has_good_columns {q N : ℕ} (hq : 1 < q) :
    HasGoodColumns q N (standardSudoku q N) := by
  intro n
  refine ⟨Equiv.refl (ZMod q), ?_⟩
  intro m hm
  have hnotd : ¬ ((q : ℕ) : ℤ) ∣ m := by
    intro hd
    apply hm
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd (a := m) (b := q)).mpr hd
  simpa [standardSudoku] using fq_eq_self_of_not_dvd_int (q := q) hq hnotd


end
end Commons.PeriodicTiling


open scoped Pointwise

namespace Commons.PeriodicTiling

set_option autoImplicit false

variable {G : Type*} [AddCommGroup G]
variable {H : Type*} [AddCommGroup H]

/--
A *functional system* over an ambient additive group `G` and a finite codomain `H`,
in the sense of Greenfeld--Tao: a finite family of functional equations
`⊔_{j} (α (x + h i j) + E i j) = H` (one equation for each `i : Fin M`).
-/
structure FunctionalSystem (G : Type*) [AddCommGroup G] (H : Type*) [AddCommGroup H] where
  M : ℕ
  J : Fin M → ℕ
  h : (i : Fin M) → Fin (J i) → G
  E : (i : Fin M) → Fin (J i) → Set H

/-- The assertion that `α` solves the functional system `S`, i.e. for every equation index
`i`, base point `x` and colour `y`, there is exactly one `j` with `y ∈ α(x + h i j) + E i j`. -/
def Solves (S : FunctionalSystem G H) (α : G → H) : Prop :=
  ∀ (i : Fin S.M) (x : G) (y : H),
    ∃! j : Fin (S.J i), y ∈ α (x + S.h i j) + S.E i j

/-- A system is *solvable* when some function solves it. -/
def Solvable (S : FunctionalSystem G H) : Prop :=
  ∃ α : G → H, Solves S α

/-- A function is *periodic* (in the sense used throughout this project) when it is invariant
under a finite-index additive subgroup of its domain. -/
def Periodic (α : G → H) : Prop :=
  ∃ L : AddSubgroup G, L.FiniteIndex ∧
    ∀ (x : G) (g : G), g ∈ L → α (x + g) = α x

/-- A functional system is *aperiodic* when it is solvable and every solution is non-periodic. -/
def AperiodicSystem (S : FunctionalSystem G H) : Prop :=
  Solvable S ∧ ∀ α : G → H, Solves S α → ¬ Periodic α

/-- A property of functions `G → H` is *expressible* when it is exactly the solution set of
some functional system whose tiles `E i j` are all non-empty. -/
def ExpressibleProperty (P : (G → H) → Prop) : Prop :=
  ∃ S : FunctionalSystem G H,
    (∀ i j, (S.E i j).Nonempty) ∧ ∀ α : G → H, P α ↔ Solves S α

namespace FunctionalSystem

/-- Membership in a horizontally translated colour set: `y ∈ (a+u)+E` iff `y-u ∈ a+E`. -/
lemma mem_add_right_translate (u a y : H) (E : Set H) :
    (y ∈ (a + u) + E) ↔ (y - u ∈ a + E) := by
  change y ∈ ({a + u} : Set H) + E ↔ y - u ∈ ({a} : Set H) + E
  constructor
  · intro h
    rw [Set.mem_add] at h ⊢
    rcases h with ⟨w, hw, e, he, hsum⟩
    simp at hw
    subst w
    refine ⟨a, by simp, e, he, ?_⟩
    rw [← hsum]
    abel
  · intro h
    rw [Set.mem_add] at h ⊢
    rcases h with ⟨w, hw, e, he, hsum⟩
    simp at hw
    subst w
    refine ⟨a + u, by simp, e, he, ?_⟩
    calc
      a + u + e = (a + e) + u := by abel
      _ = (y - u) + u := by rw [hsum]
      _ = y := by abel

/-- `∃!` is transported along pointwise equivalences of the predicate. -/
lemma existsUnique_congr {α : Sort*} {p q : α → Prop}
    (hpq : ∀ a, p a ↔ q a) (h : ∃! a, q a) : ∃! a, p a := by
  rcases h with ⟨a, ha, huniq⟩
  refine ⟨a, (hpq a).2 ha, ?_⟩
  intro b hb
  exact huniq b ((hpq b).1 hb)

/-- Translating a solution by any `t : G` gives another solution: expressible properties are
invariant under horizontal translation. -/
lemma solves_translate (S : FunctionalSystem G H) (α : G → H) (t : G)
    (hα : Solves S α) : Solves S (fun x : G => α (x + t)) := by
  intro i x y
  have h := hα i (x + t) y
  apply existsUnique_congr
  · intro j
    change y ∈ α ((x + S.h i j) + t) + S.E i j ↔
           y ∈ α ((x + t) + S.h i j) + S.E i j
    rw [show (x + S.h i j) + t = (x + t) + S.h i j by abel]
  · exact h

/-- Adding a constant `u : H` to a solution gives another solution: expressible properties are
invariant under vertical translation. -/
lemma solves_add_const (S : FunctionalSystem G H) (α : G → H) (u : H)
    (hα : Solves S α) : Solves S (fun x : G => α x + u) := by
  intro i x y
  have h := hα i x (y - u)
  apply existsUnique_congr
  · intro j
    exact mem_add_right_translate u (α (x + S.h i j)) y (S.E i j)
  · exact h

/-- Combining horizontal and vertical translations. -/
lemma solves_translate_add (S : FunctionalSystem G H) (α : G → H) (t : G) (u : H)
    (hα : Solves S α) : Solves S (fun x : G => α (x + t) + u) := by
  intro i x y
  have h := hα i (x + t) (y - u)
  apply existsUnique_congr
  · intro j
    have harg : (x + S.h i j) + t = (x + t) + S.h i j := by abel
    calc
      y ∈ (α ((x + S.h i j) + t) + u) + S.E i j ↔
          y - u ∈ α ((x + S.h i j) + t) + S.E i j :=
            mem_add_right_translate u (α ((x + S.h i j) + t)) y (S.E i j)
      _ ↔ y - u ∈ α ((x + t) + S.h i j) + S.E i j := by
            rw [harg]
  · exact h

/-- The empty system (with `M = 0` equations) is solved by every function. -/
lemma solves_empty_of_M_zero {S : FunctionalSystem G H} (hM : S.M = 0) (α : G → H) :
    Solves S α := by
  intro i x y
  have : ¬ i < S.M := by omega
  exact False.elim (this (Fin.is_lt i))

/-- Any function is a solution of the empty system, witnessing solvability. -/
lemma solvable_of_M_zero {S : FunctionalSystem G H} (hM : S.M = 0) (α : G → H) :
    Solvable S := by
  exact ⟨α, solves_empty_of_M_zero hM α⟩

end FunctionalSystem

end Commons.PeriodicTiling


open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # The library of (weakly) expressible properties

Greenfeld--Tao, Section "A library of (weakly) expressible properties".  We build the
first concrete entries of the library in the single-function framework of
`FunctionalSystem` / `ExpressibleProperty` (cf. the paper's `(G,H)`-properties):
the trivial (full and empty) properties, the translation-invariance law, the *clock*
along a direction `v` (`α(x+v) = α(x)+1`) and the *direction-permutation* law
(`x ↦ j ↦ α(x + jv)` bijects a block of length `J` onto the codomain).

All results are expressed over an ambient additive group `G` and an additive group `H`
(codomain), matching the paper's functional-equation language. -/

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]

/-- The property given by a single functional equation with `J` terms:
for every base point `x` and every value `y`, exactly one `j` satisfies
`y ∈ α(x + h_j) + E_j`. -/
def singleEq (J : ℕ) (h : Fin J → G) (E : Fin J → Set H) (α : G → H) : Prop :=
  ∀ x : G, ∀ y : H, ∃! j : Fin J, y ∈ α (x + h j) + E j

/-- The functional system consisting of the single equation with terms `(h_j, E_j)`. -/
def singleEqSystem (J : ℕ) (h : Fin J → G) (E : Fin J → Set H) :
    FunctionalSystem G H :=
  { M := 1
    J := fun _ => J
    h := fun _i j => h j
    E := fun _i j => E j }

/-- A function solves the single-equation system iff it obeys the single equation. -/
lemma singleEq_solves (J : ℕ) (h : Fin J → G) (E : Fin J → Set H) (α : G → H) :
    Solves (singleEqSystem J h E) α ↔ singleEq J h E α := by
  unfold Solves singleEq singleEqSystem
  constructor
  · intro hs x y
    exact hs 0 x y
  · intro hs i x y
    fin_cases i
    exact hs x y

/-! ## Trivial properties -/

/-- The complete property (satisfied by every function) is expressible via the empty
system with `M = 0`. -/
lemma fullProperty_expressible : ExpressibleProperty (fun _ : G → H => True) := by
  let S : FunctionalSystem G H :=
    { M := 0
      J := fun i => 0
      h := fun i j => by exact (nomatch i)
      E := fun i j => by exact (nomatch i) }
  refine ⟨S, ?_, ?_⟩
  · intro i j
    exact (nomatch i)
  · intro α
    constructor
    · intro hα i x y
      exact (nomatch i)
    · intro hα
      trivial

/-- The empty property (satisfied by no function) is expressible via a single equation
with `J = 0` terms. -/
lemma emptyProperty_expressible : ExpressibleProperty (fun _ : G → H => False) := by
  let S : FunctionalSystem G H := singleEqSystem 0 (fun j : Fin 0 => by exact (nomatch j))
    (fun j : Fin 0 => by exact (nomatch j))
  refine ⟨S, ?_, ?_⟩
  · intro i j
    exact (nomatch j)
  · intro α
    constructor
    · intro hα
      exact False.elim hα
    · intro hs
      have h := (singleEq_solves 0 (fun j : Fin 0 => by exact (nomatch j))
        (fun j : Fin 0 => by exact (nomatch j)) α).mp hs 0 0
      rcases h with ⟨j, _, _⟩
      exact (nomatch j)

/-! ## Translation invariance of expressible properties -/

/-- Solutions of an expressible property are invariant under horizontal translation:
if `α` obeys the expressible property `P`, so does `x ↦ α(x+t)`. -/
lemma expressible_translate {P : (G → H) → Prop} (hP : ExpressibleProperty P) (α : G → H)
    (t : G) (hα : P α) : P (fun x : G => α (x + t)) := by
  rcases hP with ⟨S, hE, hiff⟩
  rw [hiff] at hα ⊢
  exact FunctionalSystem.solves_translate S α t hα

/-- Solutions of an expressible property are invariant under vertical translation:
if `α` obeys the expressible property `P`, so does `x ↦ α x + u`. -/
lemma expressible_add_const {P : (G → H) → Prop} (hP : ExpressibleProperty P) (α : G → H)
    (u : H) (hα : P α) : P (fun x : G => α x + u) := by
  rcases hP with ⟨S, hE, hiff⟩
  rw [hiff] at hα ⊢
  exact FunctionalSystem.solves_add_const S α u hα


/-! ## The clock along a direction

A function `α : G → ZMod N` is a *clock along `v`* when `α(x + v) = α(x) + 1` for every
`x` (the paper's Example "clock"; for `G = ℤ`, `v = 1` this is `α(x+1) = α(x)+1`).
The single functional equation
`(α(x) + {1}) ⊎ (α(x+v) + (ZMod N \ {0})) = ZMod N`
expresses exactly this. -/

section Clock

/-- The clock property along the direction `v` with values in `ZMod N`. -/
def clock (N : ℕ) (v : G) (α : G → ZMod N) : Prop :=
  ∀ x : G, α (x + v) = α x + 1

/-- `y ∈ a + {1}` iff `y = a + 1`. -/
lemma mem_add_singleton_one (N : ℕ) (a y : ZMod N) :
    y ∈ (a + ({1} : Set (ZMod N))) ↔ y = a + 1 := by
  change y ∈ ({a} : Set (ZMod N)) + ({1} : Set (ZMod N)) ↔ y = a + 1
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨w, hw, u, hu, hsum⟩
    simp at hw hu
    subst w
    subst u
    exact hsum.symm
  · intro h
    refine ⟨a, by simp, (1 : ZMod N), by simp, ?_⟩
    exact h.symm

/-- `y ∈ a + (ZMod N \ {0})` iff `y ≠ a` (translating the punctured group). -/
lemma mem_add_punctured (N : ℕ) (a y : ZMod N) :
    y ∈ (a + ({z : ZMod N | z ≠ 0})) ↔ y ≠ a := by
  change y ∈ ({a} : Set (ZMod N)) + ({z : ZMod N | z ≠ 0}) ↔ y ≠ a
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨w, hw, u, hu, hsum⟩
    simp at hw
    subst w
    intro hy
    have ha0 : a + u = a := by
      calc
        a + u = y := hsum
        _ = a := hy
    have hsum' : a + u = a + 0 := by simpa using ha0
    have hc : u = 0 := add_left_cancel (a := a) (b := u) (c := 0) hsum'
    exact hu hc
  · intro hne
    refine ⟨a, by simp, y - a, ?_, ?_⟩
    · intro hz
      exact hne (sub_eq_zero.mp hz)
    · abel

/-- In `ZMod N` with `N ≥ 2`, the element `1` is not zero. -/
lemma zmod_one_ne_zero_of_two_le (N : ℕ) (hN : 2 ≤ N) : (1 : ZMod N) ≠ 0 := by
  intro hz
  have hdvdZ : ((N : ℕ) : ℤ) ∣ ((1 : ℕ) : ℤ) :=
    (ZMod.intCast_zmod_eq_zero_iff_dvd ((1 : ℕ) : ℤ) N).mp (by simpa using hz)
  have hdvd : N ∣ 1 := (Int.natCast_dvd_natCast).mp hdvdZ
  have hle : N ≤ 1 := Nat.le_of_dvd (by norm_num) hdvd
  omega

/-- The clock property is expressible: it is the solution set of the single functional
equation `(α(x)+{1}) ⊎ (α(x+v)+(ZMod N\{0})) = ZMod N`. -/
theorem clock_expressible (N : ℕ) (hN : 2 ≤ N) (v : G) :
    ExpressibleProperty (clock (G := G) N v) := by
  classical
  let h : Fin 2 → G := ![0, v]
  let E : Fin 2 → Set (ZMod N) := ![{1}, {z : ZMod N | z ≠ 0}]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j
    · refine ⟨(1 : ZMod N), ?_⟩
      simp [E]
    · refine ⟨(1 : ZMod N), ?_⟩
      simp [E]
      exact zmod_one_ne_zero_of_two_le N hN
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq clock
    constructor
    · intro hclock x y
      have hc : α (x + v) = α x + 1 := hclock x
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ y = α x + 1 := by
        dsimp [p]
        simp [h, E]
        exact mem_add_singleton_one N (α x) y
      have hp1 : p (1 : Fin 2) ↔ y ≠ α (x + v) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_punctured N (α (x + v)) y
      have hp1' : p (1 : Fin 2) ↔ y ≠ α x + 1 := by
        rw [hp1, hc]
      by_cases hy : y = α x + 1
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          exact (hp1'.mp hj) hy
      · refine ⟨(1 : Fin 2), (hp1').mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · exfalso
          exact hy ((hp0).mp hj)
        · rfl
    · intro hs x
      have hmem0 (y : ZMod N) : y ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) ↔ y = α x + 1 := by
        simp [h, E]
        exact mem_add_singleton_one N (α x) y
      have hmem1 (y : ZMod N) : y ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) ↔ y ≠ α (x + v) := by
        simp [h, E]
        exact mem_add_punctured N (α (x + v)) y
      have hs' := hs x (α (x + v))
      rcases hs' with ⟨j, hj, _⟩
      fin_cases j
      · exact (hmem0 (α (x + v))).mp hj
      · exfalso
        exact ((hmem1 (α (x + v))).mp hj) rfl

end Clock

/-- `y ∈ a + {b}` iff `y = a + b`. -/
lemma mem_add_singleton (H : Type*) [AddCommGroup H] (a b y : H) :
    y ∈ (a + ({b} : Set H)) ↔ y = a + b := by
  change y ∈ ({a} : Set H) + ({b} : Set H) ↔ y = a + b
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨w, hw, u, hu, hsum⟩
    simp at hw hu
    subst w
    subst u
    exact hsum.symm
  · intro h
    refine ⟨a, by simp, b, by simp, ?_⟩
    exact h.symm

/-- Along-direction permutation: every window `{x + j·v : j = 0,…,J-1}` maps bijectively
onto the codomain (each `y` is attained by exactly one `j`). -/
def permAlong (J : ℕ) (v : G) (α : G → H) : Prop :=
  ∀ x : G, ∀ y : H, ∃! j : Fin J, y = α (x + (j : ℕ) • v)

/-- The direction-permutation property is expressible. -/
theorem permAlong_expressible (J : ℕ) (v : G) :
    ExpressibleProperty (fun α : G → H => permAlong J v α) := by
  classical
  let h : Fin J → G := fun j => (j : ℕ) • v
  let E : Fin J → Set H := fun _ => ({0} : Set H)
  have hE : ∀ j : Fin J, (E j).Nonempty := by
    intro j
    refine ⟨(0 : H), ?_⟩
    simp [E]
  refine ⟨singleEqSystem J h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq permAlong
    constructor
    · intro hs x y
      have hiff (j : Fin J) :
          y ∈ α (x + h j) + E j ↔ y = α (x + (j : ℕ) • v) := by
        dsimp [h, E]
        simpa using (mem_add_singleton H (α (x + (j : ℕ) • v)) 0 y)
      exact (existsUnique_congr (fun j => hiff j)).mpr (hs x y)
    · intro hs x y
      have hiff (j : Fin J) :
          y ∈ α (x + h j) + E j ↔ y = α (x + (j : ℕ) • v) := by
        dsimp [h, E]
        simpa using (mem_add_singleton H (α (x + (j : ℕ) • v)) 0 y)
      exact (existsUnique_congr (fun j => hiff j)).mp (hs x y)

/-- Periodicity along the direction `v`: `α(x+v) = α(x)` for every `x`. -/
def periodicAlong (v : G) (α : G → H) : Prop :=
  ∀ x : G, α (x + v) = α x


theorem periodicAlong_expressible (N : ℕ) (hN : 2 ≤ N) (v : G) :
    ExpressibleProperty (fun α : G → ZMod N => periodicAlong v α) := by
  classical
  let h : Fin 2 → G := ![0, v]
  let E : Fin 2 → Set (ZMod N) := ![{0}, {z : ZMod N | z ≠ 0}]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j
    · refine ⟨(0 : ZMod N), ?_⟩
      simp [E]
    · refine ⟨(1 : ZMod N), ?_⟩
      simp [E]
      exact zmod_one_ne_zero_of_two_le N hN
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq periodicAlong
    constructor
    · intro hper x y
      have hc : α (x + v) = α x := hper x
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ y = α x := by
        dsimp [p]
        simp [h, E]
        simpa using (mem_add_singleton (ZMod N) (α x) 0 y)
      have hp1 : p (1 : Fin 2) ↔ y ≠ α (x + v) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_punctured N (α (x + v)) y
      have hp1' : p (1 : Fin 2) ↔ y ≠ α x := by
        rw [hp1, hc]
      by_cases hy : y = α x
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          exact (hp1'.mp hj) hy
      · refine ⟨(1 : Fin 2), (hp1').mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · exfalso
          exact hy ((hp0).mp hj)
        · rfl
    · intro hs x
      have hmem0 (y : ZMod N) : y ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) ↔ y = α x := by
        simp [h, E]
        simpa using (mem_add_singleton (ZMod N) (α x) 0 y)
      have hmem1 (y : ZMod N) : y ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) ↔ y ≠ α (x + v) := by
        simp [h, E]
        exact mem_add_punctured N (α (x + v)) y
      have hs' := hs x (α (x + v))
      rcases hs' with ⟨j, hj, _⟩
      fin_cases j
      · exact (hmem0 (α (x + v))).mp hj
      · exfalso
        exact ((hmem1 (α (x + v))).mp hj) rfl


/-! ## Conjunction closure

The conjunction of expressible properties is expressible (paper Example "Closure under
conjunction"): concatenate the two witnessing systems, equation by equation, over
`Fin (M₁ + M₂)`. -/

/-- Concatenation of two functional systems: equations of `S₁` then of `S₂`. -/
def appendSystem (S₁ S₂ : FunctionalSystem G H) : FunctionalSystem G H where
  M := S₁.M + S₂.M
  J := Fin.append S₁.J S₂.J
  h := fun i => Fin.addCases
      (fun k : Fin S₁.M => fun j : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k)) =>
        S₁.h k (Fin.cast (Fin.append_left S₁.J S₂.J k) j))
      (fun k : Fin S₂.M => fun j : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k)) =>
        S₂.h k (Fin.cast (Fin.append_right S₁.J S₂.J k) j))
      i
  E := fun i => Fin.addCases
      (fun k : Fin S₁.M => fun j : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k)) =>
        S₁.E k (Fin.cast (Fin.append_left S₁.J S₂.J k) j))
      (fun k : Fin S₂.M => fun j : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k)) =>
        S₂.E k (Fin.cast (Fin.append_right S₁.J S₂.J k) j))
      i

lemma append_h_left (S₁ S₂ : FunctionalSystem G H) (k : Fin S₁.M)
    (j : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k))) :
    (appendSystem S₁ S₂).h (Fin.castAdd S₂.M k) j =
      S₁.h k (Fin.cast (Fin.append_left S₁.J S₂.J k) j) := by
  simp only [appendSystem]
  rw [Fin.addCases_left (i := k)]

lemma append_E_left (S₁ S₂ : FunctionalSystem G H) (k : Fin S₁.M)
    (j : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k))) :
    (appendSystem S₁ S₂).E (Fin.castAdd S₂.M k) j =
      S₁.E k (Fin.cast (Fin.append_left S₁.J S₂.J k) j) := by
  simp only [appendSystem]
  rw [Fin.addCases_left (i := k)]

lemma append_h_right (S₁ S₂ : FunctionalSystem G H) (k : Fin S₂.M)
    (j : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k))) :
    (appendSystem S₁ S₂).h (Fin.natAdd S₁.M k) j =
      S₂.h k (Fin.cast (Fin.append_right S₁.J S₂.J k) j) := by
  simp only [appendSystem]
  rw [Fin.addCases_right (i := k)]

lemma append_E_right (S₁ S₂ : FunctionalSystem G H) (k : Fin S₂.M)
    (j : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k))) :
    (appendSystem S₁ S₂).E (Fin.natAdd S₁.M k) j =
      S₂.E k (Fin.cast (Fin.append_right S₁.J S₂.J k) j) := by
  simp only [appendSystem]
  rw [Fin.addCases_right (i := k)]

/-- Cast between the two `Fin` types along `n = m`. -/
def finCastEquiv {n m : ℕ} (e : n = m) : Fin n ≃ Fin m where
  toFun := Fin.cast e
  invFun := Fin.cast e.symm
  left_inv := Fin.leftInverse_cast e
  right_inv := Fin.rightInverse_cast e

/-- The `∃!` quantifier transports along a bijection. -/
lemma existsUnique_comp_bijective {α β : Type*} (f : α ≃ β) (p : β → Prop) :
    (∃! b : β, p b) ↔ ∃! a : α, p (f a) := by
  constructor
  · intro hb
    rcases hb with ⟨b, hb1, hb2⟩
    refine ⟨f.symm b, ?_, ?_⟩
    · simpa using hb1
    · intro a ha
      have hfa : f a = b := hb2 (f a) ha
      calc
        a = f.symm (f a) := by simp
        _ = f.symm b := by rw [hfa]
  · intro ha
    rcases ha with ⟨a, ha1, ha2⟩
    refine ⟨f a, ha1, ?_⟩
    intro b hb
    have hpre : f.symm b = a := ha2 (f.symm b) (by simpa using hb)
    calc
      b = f (f.symm b) := by simp
      _ = f a := by rw [hpre]

/-- Solving the concatenated system is solving both systems. -/
lemma appendSystem_solves (S₁ S₂ : FunctionalSystem G H) (α : G → H) :
    Solves (appendSystem S₁ S₂) α ↔ Solves S₁ α ∧ Solves S₂ α := by
  constructor
  · intro h
    constructor
    · intro k x y
      let i : Fin (S₁.M + S₂.M) := Fin.castAdd S₂.M k
      let p₁ : Fin (S₁.J k) → Prop := fun m => y ∈ α (x + S₁.h k m) + S₁.E k m
      let g : Fin (Fin.append S₁.J S₂.J i) ≃ Fin (S₁.J k) :=
        finCastEquiv (Fin.append_left S₁.J S₂.J k)
      have hpoint : ∀ a : Fin (Fin.append S₁.J S₂.J i),
          p₁ (g a) ↔ y ∈ α (x + (appendSystem S₁ S₂).h i a) + (appendSystem S₁ S₂).E i a := by
        intro a
        constructor
        · intro hp
          rw [append_h_left S₁ S₂ k a, append_E_left S₁ S₂ k a]
          simpa [g, p₁, finCastEquiv] using hp
        · intro hm
          rw [append_h_left S₁ S₂ k a, append_E_left S₁ S₂ k a] at hm
          simpa [g, p₁, finCastEquiv] using hm
      have H := h i x y
      exact (existsUnique_comp_bijective g p₁).mpr
        ((existsUnique_congr (fun a => hpoint a)).mpr H)
    · intro k x y
      let i : Fin (S₁.M + S₂.M) := Fin.natAdd S₁.M k
      let p₂ : Fin (S₂.J k) → Prop := fun m => y ∈ α (x + S₂.h k m) + S₂.E k m
      let g : Fin (Fin.append S₁.J S₂.J i) ≃ Fin (S₂.J k) :=
        finCastEquiv (Fin.append_right S₁.J S₂.J k)
      have hpoint : ∀ a : Fin (Fin.append S₁.J S₂.J i),
          p₂ (g a) ↔ y ∈ α (x + (appendSystem S₁ S₂).h i a) + (appendSystem S₁ S₂).E i a := by
        intro a
        constructor
        · intro hp
          rw [append_h_right S₁ S₂ k a, append_E_right S₁ S₂ k a]
          simpa [g, p₂, finCastEquiv] using hp
        · intro hm
          rw [append_h_right S₁ S₂ k a, append_E_right S₁ S₂ k a] at hm
          simpa [g, p₂, finCastEquiv] using hm
      have H := h i x y
      exact (existsUnique_comp_bijective g p₂).mpr
        ((existsUnique_congr (fun a => hpoint a)).mpr H)
  · intro h i x y
    rcases h with ⟨hs₁, hs₂⟩
    refine Fin.addCases (motive := fun i : Fin (S₁.M + S₂.M) =>
        ∃! j : Fin (Fin.append S₁.J S₂.J i),
          y ∈ α (x + (appendSystem S₁ S₂).h i j) + (appendSystem S₁ S₂).E i j) ?_ ?_ i
    · intro k
      let p₁ : Fin (S₁.J k) → Prop := fun m => y ∈ α (x + S₁.h k m) + S₁.E k m
      let g : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k)) ≃ Fin (S₁.J k) :=
        finCastEquiv (Fin.append_left S₁.J S₂.J k)
      have hpoint : ∀ a : Fin (Fin.append S₁.J S₂.J (Fin.castAdd S₂.M k)),
          p₁ (g a) ↔ y ∈ α (x + (appendSystem S₁ S₂).h (Fin.castAdd S₂.M k) a) +
            (appendSystem S₁ S₂).E (Fin.castAdd S₂.M k) a := by
        intro a
        constructor
        · intro hp
          rw [append_h_left S₁ S₂ k a, append_E_left S₁ S₂ k a]
          simpa [g, p₁, finCastEquiv] using hp
        · intro hm
          rw [append_h_left S₁ S₂ k a, append_E_left S₁ S₂ k a] at hm
          simpa [g, p₁, finCastEquiv] using hm
      exact (existsUnique_congr (fun a => hpoint a)).mp
        ((existsUnique_comp_bijective g p₁).mp (hs₁ k x y))
    · intro k
      let p₂ : Fin (S₂.J k) → Prop := fun m => y ∈ α (x + S₂.h k m) + S₂.E k m
      let g : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k)) ≃ Fin (S₂.J k) :=
        finCastEquiv (Fin.append_right S₁.J S₂.J k)
      have hpoint : ∀ a : Fin (Fin.append S₁.J S₂.J (Fin.natAdd S₁.M k)),
          p₂ (g a) ↔ y ∈ α (x + (appendSystem S₁ S₂).h (Fin.natAdd S₁.M k) a) +
            (appendSystem S₁ S₂).E (Fin.natAdd S₁.M k) a := by
        intro a
        constructor
        · intro hp
          rw [append_h_right S₁ S₂ k a, append_E_right S₁ S₂ k a]
          simpa [g, p₂, finCastEquiv] using hp
        · intro hm
          rw [append_h_right S₁ S₂ k a, append_E_right S₁ S₂ k a] at hm
          simpa [g, p₂, finCastEquiv] using hm
      exact (existsUnique_congr (fun a => hpoint a)).mp
        ((existsUnique_comp_bijective g p₂).mp (hs₂ k x y))

/-- The conjunction of two expressible properties is expressible (paper Example
"Closure under conjunction"): concatenate the two witnessing systems. -/
theorem expressible_conj {P Q : (G → H) → Prop} (hP : ExpressibleProperty P)
    (hQ : ExpressibleProperty Q) :
    ExpressibleProperty (fun α : G → H => P α ∧ Q α) := by
  rcases hP with ⟨S₁, hE₁, hiff₁⟩
  rcases hQ with ⟨S₂, hE₂, hiff₂⟩
  refine ⟨appendSystem S₁ S₂, ?_, ?_⟩
  · intro i
    refine Fin.addCases (motive := fun i : Fin (S₁.M + S₂.M) =>
        ∀ j : Fin (Fin.append S₁.J S₂.J i), ((appendSystem S₁ S₂).E i j).Nonempty) ?_ ?_ i
    · intro k j
      rw [append_E_left S₁ S₂ k j]
      exact hE₁ k (Fin.cast (Fin.append_left S₁.J S₂.J k) j)
    · intro k j
      rw [append_E_right S₁ S₂ k j]
      exact hE₂ k (Fin.cast (Fin.append_right S₁.J S₂.J k) j)
  · intro α
    rw [appendSystem_solves]
    constructor
    · intro hpq
      exact ⟨(hiff₁ α).mp hpq.1, (hiff₂ α).mp hpq.2⟩
    · intro hs
      exact ⟨(hiff₁ α).mpr hs.1, (hiff₂ α).mpr hs.2⟩


/-! ## Lift closure

The paper's closure Lemma (i) (expressible case): adding dummy coordinates to a tuple
preserves expressibility.  Concretely, a function `G → (Fin K₁ → H)` is replaced by
`G → (Fin (K₁+M) → H)` (extra `M` coordinates); the lifted tiles are the preimages of
the original tiles under the projection `firstFun` onto the first `K₁` coordinates.
The product-reindexing equivalence `(Fin (K₁+M) → H) ≃ (Fin K₁ → H) × (Fin M → H)`
(`finSplitEquiv`) is the bookkeeping behind it. -/

def finSplitEquiv (K₁ M : ℕ) : (Fin (K₁ + M) → H) ≃ ((Fin K₁ → H) × (Fin M → H)) where
  toFun f := (fun a => f (Fin.castAdd M a), fun b => f (Fin.natAdd K₁ b))
  invFun p := Fin.append p.1 p.2
  left_inv f := by
    ext i
    refine Fin.addCases (motive := fun i : Fin (K₁ + M) => Fin.append
        (fun a => f (Fin.castAdd M a)) (fun b => f (Fin.natAdd K₁ b)) i = f i) ?_ ?_ i
    · intro a
      rw [Fin.append_left]
    · intro b
      rw [Fin.append_right]
  right_inv p := by
    ext a
    · simp
    · simp

/-- Projection onto the first `K₁` coordinates. -/
def firstFun (K₁ M : ℕ) (y : Fin (K₁ + M) → H) : Fin K₁ → H :=
  fun a => y (Fin.castAdd M a)

/-- Canonical extension of a `Fin K₁ → H` function by zeros on the last `M` coordinates. -/
def extendZero (K₁ M : ℕ) (y₁ : Fin K₁ → H) : Fin (K₁ + M) → H :=
  Fin.append y₁ (fun _ : Fin M => 0)

/-- `firstFun` is a left inverse to `extendZero`. -/
lemma firstFun_extendZero (K₁ M : ℕ) (y₁ : Fin K₁ → H) :
    firstFun K₁ M (extendZero K₁ M y₁) = y₁ := by
  funext a
  simp [firstFun, extendZero]

/-- Lifting a set of `K₁`-tuples to the whole `(K₁+M)`-tuples: the preimage under the
projection to the first `K₁` coordinates. -/
def liftSet (K₁ M : ℕ) (E : Set (Fin K₁ → H)) : Set (Fin (K₁ + M) → H) :=
  {y | firstFun K₁ M y ∈ E}

/-- Pointwise restriction of a function `G → (Fin (K₁+M) → H)` to the first `K₁`
coordinates. -/
def liftRestrict (K₁ M : ℕ) (α : G → (Fin (K₁ + M) → H)) : G → (Fin K₁ → H) :=
  fun x => firstFun K₁ M (α x)

/-- Membership in a translate of a lifted set projects to membership in the translate of
the original set. -/
lemma mem_add_lift (K₁ M : ℕ) (v : Fin (K₁ + M) → H) (E : Set (Fin K₁ → H))
    (y : Fin (K₁ + M) → H) :
    (y ∈ v + liftSet K₁ M E) ↔ firstFun K₁ M y ∈ firstFun K₁ M v + E := by
  change y ∈ ({v} : Set (Fin (K₁ + M) → H)) + liftSet K₁ M E ↔
    firstFun K₁ M y ∈ ({firstFun K₁ M v} : Set (Fin K₁ → H)) + E
  rw [Set.mem_add]
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, e, he, hsum⟩
    simp at hu
    subst u
    refine ⟨firstFun K₁ M v, by simp, firstFun K₁ M e, ?_, ?_⟩
    · exact he
    · have hf : firstFun K₁ M (v + e) = firstFun K₁ M y := by rw [hsum]
      have hdist : firstFun K₁ M (v + e) = firstFun K₁ M v + firstFun K₁ M e := by
        funext a
        simp [firstFun]
      rwa [hdist] at hf
  · intro h
    rcases h with ⟨w, hw, e, he, hsum⟩
    simp at hw
    subst w
    refine ⟨v, by simp, y - v, ?_, ?_⟩
    · -- e' = y - v ∈ liftSet E: firstFun(y - v) ∈ E
      have hfe : firstFun K₁ M (y - v) = e := by
        -- firstFun (y - v) = firstFun y - firstFun v; hsum : firstFun v + e = firstFun y
        have hsplit : firstFun K₁ M (y - v) = firstFun K₁ M y - firstFun K₁ M v := by
          funext a
          simp [firstFun]
        rw [hsplit]
        -- firstFun y - firstFun v = e from hsum
        rw [← hsum]
        abel
      change firstFun K₁ M (y - v) ∈ E
      rw [hfe]
      exact he
    · -- v + (y - v) = y
      funext a
      simp

/-- The system over the enlarged codomain `Fin (K₁+M) → H` whose equations are the lifts
of the equations of `S₁` (the last `M` coordinates are "dummy"). -/
def liftSystem (K₁ M : ℕ) (S₁ : FunctionalSystem G (Fin K₁ → H)) :
    FunctionalSystem G (Fin (K₁ + M) → H) where
  M := S₁.M
  J := S₁.J
  h := S₁.h
  E := fun i j => liftSet K₁ M (S₁.E i j)

/-- Lifting tiles keeps them non-empty. -/
lemma liftSystem_E_nonempty (K₁ M : ℕ) (S₁ : FunctionalSystem G (Fin K₁ → H))
    (hE₁ : ∀ i j, (S₁.E i j).Nonempty) : ∀ i j, ((liftSystem K₁ M S₁).E i j).Nonempty := by
  intro i j
  rcases hE₁ i j with ⟨e₁, he₁⟩
  refine ⟨extendZero K₁ M e₁, ?_⟩
  -- e₁ ∈ E₁ with firstFun(extendZero e₁) = e₁
  simpa [liftSystem, liftSet, firstFun_extendZero] using he₁

/-- Solving the lifted system is exactly solving the original system on the restricted
function. -/
lemma liftSystem_solves (K₁ M : ℕ) (S₁ : FunctionalSystem G (Fin K₁ → H))
    (α : G → (Fin (K₁ + M) → H)) :
    Solves (liftSystem K₁ M S₁) α ↔ Solves S₁ (liftRestrict K₁ M α) := by
  unfold Solves
  constructor
  · intro h i x y₁
    have hσ : firstFun K₁ M (extendZero K₁ M y₁) = y₁ := firstFun_extendZero K₁ M y₁
    have ht := h i x (extendZero K₁ M y₁)
    have hpoint : ∀ j : Fin (S₁.J i),
        (extendZero K₁ M y₁ ∈ α (x + S₁.h i j) + liftSet K₁ M (S₁.E i j)) ↔
        (y₁ ∈ (liftRestrict K₁ M α) (x + S₁.h i j) + S₁.E i j) := by
      intro j
      rw [mem_add_lift]
      rw [hσ]
      rfl
    exact (existsUnique_congr hpoint).mp ht
  · intro h i x y
    have ht := h i x (firstFun K₁ M y)
    have hpoint : ∀ j : Fin (S₁.J i),
        (firstFun K₁ M y ∈ (liftRestrict K₁ M α) (x + S₁.h i j) + S₁.E i j) ↔
        (y ∈ α (x + S₁.h i j) + liftSet K₁ M (S₁.E i j)) := by
      intro j
      exact (mem_add_lift K₁ M (α (x + S₁.h i j)) (S₁.E i j) y).symm
    exact (existsUnique_congr hpoint).mp ht



/-! ## Pullback closure

The paper's closure Lemma (ii) (expressible case): pulling back an expressible property
along a homomorphism of the domain is expressible.  Concretely, for `φ : G' →+ G`, a
function `α : G → H` obeys the pullback when its restriction to every coset
`x₀ + φ(G')` obeys the original property.  The pulled system has the same equations with
shifts mapped through `φ`, and base points ranging over all of `G`. -/

variable {G' : Type*} [AddCommGroup G']

def pullbackSystem (φ : G' →+ G) (S' : FunctionalSystem G' H) : FunctionalSystem G H where
  M := S'.M
  J := S'.J
  h := fun i j => φ (S'.h i j)
  E := S'.E

/-- Restriction of `α : G → H` to the coset `x₀ + φ(G')`. -/
def restrictToCoset (φ : G' →+ G) (α : G → H) (x₀ : G) : G' → H :=
  fun g' => α (x₀ + φ g')

/-- Solving the pulled-back system is solving the original system on every coset. -/
lemma pullbackSystem_solves (φ : G' →+ G) (S' : FunctionalSystem G' H) (α : G → H) :
    Solves (pullbackSystem φ S') α ↔
      ∀ x₀ : G, Solves S' (restrictToCoset φ α x₀) := by
  unfold Solves
  constructor
  · intro h x₀ i g' y
    have ht := h i (x₀ + φ g') y
    have hpoint : ∀ j : Fin (S'.J i),
        (y ∈ α ((x₀ + φ g') + φ (S'.h i j)) + S'.E i j) ↔
        (y ∈ α (x₀ + φ (g' + S'.h i j)) + S'.E i j) := by
      intro j
      rw [show (x₀ + φ g') + φ (S'.h i j) = x₀ + φ (g' + S'.h i j) by
        rw [φ.map_add]
        abel]
    exact (existsUnique_congr hpoint).mp ht
  · intro h i x y
    have ht := h x i 0 y
    have hpoint : ∀ j : Fin (S'.J i),
        (y ∈ α (x + φ (S'.h i j)) + S'.E i j) ↔
        (y ∈ α (x + φ ((0 : G') + S'.h i j)) + S'.E i j) := by
      intro j
      rw [show x + φ (S'.h i j) = x + φ ((0 : G') + S'.h i j) by
        rw [map_add]
        simp]
    exact (existsUnique_congr hpoint).mpr ht

/-- Pullback of an expressible property along a homomorphism is expressible (the paper's
closure Lemma (ii), expressible case). -/
theorem expressible_pullback (φ : G' →+ G) {P' : (G' → H) → Prop}
    (hP' : ExpressibleProperty P') :
    ExpressibleProperty (fun α : G → H => ∀ x₀ : G, P' (restrictToCoset φ α x₀)) := by
  rcases hP' with ⟨S', hE', hiff'⟩
  refine ⟨pullbackSystem φ S', ?_, ?_⟩
  · intro i j
    exact hE' i j
  · intro α
    constructor
    · intro hq
      rw [pullbackSystem_solves]
      intro x₀
      exact (hiff' (restrictToCoset φ α x₀)).mp (hq x₀)
    · intro hs
      rw [pullbackSystem_solves] at hs
      intro x₀
      exact (hiff' (restrictToCoset φ α x₀)).mpr (hs x₀)

/-! ## Transfer along codomain equivalences, and weak expressibility

The paper's Definition "Weak expressibility" and closure Lemma (iv): a property `P` over
`(G → Fin K → H)` is *weakly expressible* when it is the existential quantification of an
expressible property `Pstar` over an extension by `M` dummy coordinates.  Closure (iv)
(any existential quantification of a weakly expressible property is weakly expressible)
reduces to the associativity of `Fin.append` (reindexing `((K+M₁)+M₂)` to
`K+(M₁+M₂)`) together with the transfer of expressibility along the corresponding
pointwise additive equivalence of the codomain. -/

variable {C D : Type*} [AddCommGroup C] [AddCommGroup D]

/-- Membership in a translate is preserved by an additive equivalence and its image. -/
lemma mem_image_addEquiv (σ : C ≃+ D) (a : C) (E : Set C) (y : C) :
    (σ y ∈ σ a + (σ '' E)) ↔ (y ∈ a + E) := by
  change σ y ∈ ({σ a} : Set D) + (σ '' E) ↔ y ∈ ({a} : Set C) + E
  rw [Set.mem_add]
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, v, hv, hsum⟩
    simp at hu
    subst u
    rw [Set.mem_image] at hv
    rcases hv with ⟨e, he, hEq⟩
    have hsum' : σ a + σ e = σ y := by simpa [hEq] using hsum
    refine ⟨a, by simp, e, he, ?_⟩
    -- σ a + σ e = σ y: apply σ.symm
    have hsym := congrArg σ.symm hsum'
    -- σ.symm (σ a + σ e) = a + e
    simpa using hsym
  · intro h
    rcases h with ⟨u, hu, e, he, hsum⟩
    simp at hu
    subst u
    refine ⟨σ a, by simp, σ e, ?_, ?_⟩
    · rw [Set.mem_image]
      exact ⟨e, he, rfl⟩
    · -- σa + σe = σy from a + e = y
      rw [← map_add]
      exact congrArg σ hsum

/-- Transfer of expressibility along a pointwise additive equivalence of the codomain. -/
theorem expressible_pointwise_equiv (σ : C ≃+ D) {P : (G → C) → Prop}
    (hP : ExpressibleProperty P) :
    ExpressibleProperty (fun β : G → D => P (fun x : G => σ.symm (β x))) := by
  rcases hP with ⟨S, hE, hiff⟩
  let S' : FunctionalSystem G D :=
    { M := S.M
      J := S.J
      h := S.h
      E := fun i j => (σ '' (S.E i j)) }
  refine ⟨S', ?_, ?_⟩
  · intro i j
    rcases hE i j with ⟨e, he⟩
    refine ⟨σ e, ?_⟩
    rw [Set.mem_image]
    exact ⟨e, he, rfl⟩
  · intro β
    have hmain : Solves S' β ↔ Solves S (fun x : G => σ.symm (β x)) := by
      unfold Solves
      constructor
      · intro hD i x y
        have ht := hD i x (σ y)
        have hpoint : ∀ j : Fin (S.J i),
            (y ∈ (σ.symm ∘ β) (x + S.h i j) + S.E i j) ↔
            (σ y ∈ β (x + S.h i j) + (σ '' (S.E i j))) := by
          intro j
          have hσa : σ ((σ.symm ∘ β) (x + S.h i j)) = β (x + S.h i j) := by simp
          rw [← hσa]
          exact (mem_image_addEquiv σ ((σ.symm ∘ β) (x + S.h i j)) (S.E i j) y).symm
        exact (existsUnique_congr hpoint).mpr ht
      · intro hC i x y'
        have ht := hC i x (σ.symm y')
        have hpoint : ∀ j : Fin (S.J i),
            (y' ∈ β (x + S.h i j) + (σ '' (S.E i j))) ↔
            (σ.symm y' ∈ (σ.symm ∘ β) (x + S.h i j) + S.E i j) := by
          intro j
          have hσa : σ ((σ.symm ∘ β) (x + S.h i j)) = β (x + S.h i j) := by simp
          rw [← hσa]
          have hσy : σ (σ.symm y') = y' := by simp
          simpa [hσy] using (mem_image_addEquiv σ ((σ.symm ∘ β) (x + S.h i j)) (S.E i j) (σ.symm y'))
        exact (existsUnique_congr hpoint).mpr ht
    constructor
    · intro hq
      have hs := (hiff (fun x : G => σ.symm (β x))).mp hq
      exact hmain.mpr hs
    · intro hs'
      have hs := hmain.mp hs'
      exact (hiff (fun x : G => σ.symm (β x))).mpr hs

/-- Reassociation of the index split `((K+M₁)+M₂) ↔ (K+(M₁+M₂))`, pointwise on
functions into `H`, as an additive equivalence. -/
def finAssocEquiv (K M₁ M₂ : ℕ) : (Fin ((K + M₁) + M₂) → H) ≃+ (Fin (K + (M₁ + M₂)) → H) where
  toFun f := fun j => f (Fin.cast (Nat.add_assoc K M₁ M₂).symm j)
  invFun g := fun i => g (Fin.cast (Nat.add_assoc K M₁ M₂) i)
  left_inv f := by
    funext i
    simp
  right_inv g := by
    funext j
    simp
  map_add' f g := by
    funext j
    simp

/-- Weak expressibility: `P` over `(G → Fin K → H)` is the existential quantification of
an expressible property over an extension by `M` dummy coordinates. -/
def WeakExpressible (K : ℕ) (P : (G → (Fin K → H)) → Prop) : Prop :=
  ∃ M : ℕ, ∃ Pstar : (G → (Fin (K + M) → H)) → Prop,
    ExpressibleProperty Pstar ∧
    ∀ α : G → (Fin K → H),
      P α ↔ ∃ α₀ : G → (Fin M → H),
        Pstar (fun x : G => Fin.append (α x) (α₀ x))

/-- Existential quantification preserves weak expressibility (paper closure Lemma (iv)):
`Q α₁ := ∃ α₀, P (append α₁ α₀)` is weakly expressible whenever `P` is. -/
theorem weakExpressible_existential {K M₁ : ℕ} {P : (G → (Fin (K + M₁) → H)) → Prop}
    (hP : WeakExpressible (K + M₁) P) :
    WeakExpressible K (fun α₁ : G → (Fin K → H) =>
      ∃ α₀ : G → (Fin M₁ → H), P (fun x : G => Fin.append (α₁ x) (α₀ x))) := by
  rcases hP with ⟨M₂, Pstar, hPstar, hiffP⟩
  let σ : (Fin ((K + M₁) + M₂) → H) ≃+ (Fin (K + (M₁ + M₂)) → H) :=
    finAssocEquiv (H := H) K M₁ M₂
  let Qstar : (G → (Fin (K + (M₁ + M₂)) → H)) → Prop :=
    fun β => Pstar (fun x : G => σ.symm (β x))
  have hQstar_exp : ExpressibleProperty Qstar := by
    dsimp [Qstar]
    exact expressible_pointwise_equiv σ hPstar
  refine ⟨M₁ + M₂, Qstar, hQstar_exp, ?_⟩
  intro α₁
  constructor
  · intro hq
    rcases hq with ⟨α₀, hPα₀⟩
    have hw := (hiffP (fun x : G => Fin.append (α₁ x) (α₀ x))).mp hPα₀
    rcases hw with ⟨α₂, hPstarα⟩
    refine ⟨fun x : G => Fin.append (α₀ x) (α₂ x), ?_⟩
    change Pstar (fun x : G =>
      σ.symm (fun j : Fin (K + (M₁ + M₂)) => Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j))
    have hσx : ∀ x : G,
        σ.symm (fun j : Fin (K + (M₁ + M₂)) => Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j) =
          (fun i : Fin ((K + M₁) + M₂) => Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i) := by
      intro x
      funext i
      -- σ.symm g i = g (Fin.cast (Nat.add_assoc ...) i)
      change Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) (Fin.cast (Nat.add_assoc K M₁ M₂) i) =
        Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i
      exact (congrFun (Fin.append_assoc (α₁ x) (α₀ x) (α₂ x)) i).symm
    have harg : (fun x : G => σ.symm (fun j : Fin (K + (M₁ + M₂)) =>
        Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j)) =
        (fun x : G => fun i : Fin ((K + M₁) + M₂) =>
          Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i) := by
      funext x
      exact hσx x
    rw [harg]
    exact hPstarα
  · intro hq02
    rcases hq02 with ⟨α₀₂, hQ⟩
    let α₀ : G → (Fin M₁ → H) := fun x a => α₀₂ x (Fin.castAdd M₂ a)
    let α₂ : G → (Fin M₂ → H) := fun x b => α₀₂ x (Fin.natAdd M₁ b)
    have hsplit : α₀₂ = fun x : G => Fin.append (α₀ x) (α₂ x) := by
      funext x
      funext j
      refine Fin.addCases (motive := fun j : Fin (M₁ + M₂) =>
          α₀₂ x j = Fin.append (α₀ x) (α₂ x) j) ?_ ?_ j
      · intro a
        simp [α₀, Fin.append_left]
      · intro b
        simp [α₂, Fin.append_right]
    have hQ' : Qstar (fun x : G => Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x))) := by
      rwa [hsplit] at hQ
    have hQ'' : Pstar (fun x : G =>
        (fun i : Fin ((K + M₁) + M₂) => Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i)) := by
      change Pstar (fun x : G =>
        σ.symm (fun j : Fin (K + (M₁ + M₂)) => Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j)) at hQ'
      have hσx : ∀ x : G,
          σ.symm (fun j : Fin (K + (M₁ + M₂)) => Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j) =
            (fun i : Fin ((K + M₁) + M₂) => Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i) := by
        intro x
        funext i
        change Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) (Fin.cast (Nat.add_assoc K M₁ M₂) i) =
          Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i
        exact (congrFun (Fin.append_assoc (α₁ x) (α₀ x) (α₂ x)) i).symm
      have harg : (fun x : G => σ.symm (fun j : Fin (K + (M₁ + M₂)) =>
          Fin.append (α₁ x) (Fin.append (α₀ x) (α₂ x)) j)) =
          (fun x : G => fun i : Fin ((K + M₁) + M₂) =>
            Fin.append (Fin.append (α₁ x) (α₀ x)) (α₂ x) i) := by
        funext x
        exact hσx x
      rwa [harg] at hQ'
    have hPα₀ : P (fun x : G => Fin.append (α₁ x) (α₀ x)) := by
      have hw := (hiffP (fun x : G => Fin.append (α₁ x) (α₀ x))).mpr
        (by
          -- need ∃ α₂' : G → Fin M₂ → H, Pstar (fun x => append (append α₁x α₀x) α₂'x)
          refine ⟨α₂, ?_⟩
          -- Pstar term from hQ'':
          exact hQ'')
      exact hw
    exact ⟨α₀, hPα₀⟩


/-! ## Every expressible property is weakly expressible

With `M = 0` dummy coordinates (`Fin (K+0) ≃ Fin K`), the existential is over the
singleton `G → (Fin 0 → H)`, so expressibility implies weak expressibility (paper:
"Obviously every expressible property is weakly expressible"). -/

set_option linter.unusedSectionVars false

/-- The additive equivalence dropping the trailing zero coordinates `Fin (K+0) → Fin K`. -/
def finZeroEquiv (K : ℕ) : (Fin (K + 0) → H) ≃+ (Fin K → H) where
  toFun g := fun a => g (Fin.cast (Nat.add_zero K).symm a)
  invFun f := fun j => f (Fin.cast (Nat.add_zero K) j)
  left_inv g := by
    funext j
    exact congrArg g (Fin.leftInverse_cast (Nat.add_zero K) j)
  right_inv f := by
    funext a
    exact congrArg f (Fin.rightInverse_cast (Nat.add_zero K) a)
  map_add' g h := by
    funext a
    simp

/-- Appending the empty tuple and dropping the trailing zero coordinates is the identity. -/
lemma finZeroEquiv_append_elim0 (K : ℕ) (u : Fin K → H) :
    finZeroEquiv (K := K) (fun j : Fin (K + 0) => Fin.append u Fin.elim0 j) = u := by
  funext a
  change Fin.append u Fin.elim0 (Fin.cast (Nat.add_zero K).symm a) = u a
  rw [Fin.append_elim0]
  simp

/-- Appending any empty-coordinate function equals appending `Fin.elim0`. -/
lemma append_elim0_any (K : ℕ) (u : Fin K → H) (w : Fin 0 → H) :
    Fin.append u w = Fin.append u Fin.elim0 := by
  funext j
  let j' : Fin K := ⟨j.val, by
    have hj := j.isLt
    omega⟩
  have hj' : j = Fin.castAdd 0 j' := by
    apply Fin.ext
    simp [j']
  have hl : Fin.append u w j = u j' := by rw [hj', Fin.append_left]
  have hr : Fin.append u Fin.elim0 j = u j' := by rw [hj', Fin.append_left]
  exact hl.trans hr.symm

/-- Every expressible property is weakly expressible (`M = 0`, transport along the
`Fin (K+0) ≃ Fin K` equivalence). -/
theorem expressible_weak {K : ℕ} {P : (G → (Fin K → H)) → Prop}
    (hP : ExpressibleProperty P) : WeakExpressible K P := by
  let Pstar : (G → (Fin (K + 0) → H)) → Prop :=
    fun β => P (fun x : G => finZeroEquiv (K := K) (β x))
  have hPstar_exp : ExpressibleProperty Pstar := by
    dsimp [Pstar]
    simpa [Equiv.symm_symm] using
      (expressible_pointwise_equiv (finZeroEquiv (K := K)).symm hP)
  refine ⟨0, Pstar, hPstar_exp, ?_⟩
  intro α
  constructor
  · intro hp
    refine ⟨fun _ : G => Fin.elim0, ?_⟩
    dsimp [Pstar]
    have harg : (fun x : G => finZeroEquiv (K := K)
        (fun j : Fin (K + 0) => Fin.append (α x) Fin.elim0 j)) = α := by
      funext x
      exact finZeroEquiv_append_elim0 K (α x)
    rw [harg]
    exact hp
  · intro hw
    rcases hw with ⟨α₀, hPstarα⟩
    have hPα' : P (fun x : G => finZeroEquiv (K := K)
        (fun j : Fin (K + 0) => Fin.append (α x) (α₀ x) j)) := by
      dsimp [Pstar] at hPstarα
      exact hPstarα
    have hinner : (fun x : G => finZeroEquiv (K := K)
        (fun j : Fin (K + 0) => Fin.append (α x) (α₀ x) j)) = α := by
      funext x
      rw [append_elim0_any K (α x) (α₀ x)]
      exact finZeroEquiv_append_elim0 K (α x)
    rw [hinner] at hPα'
    exact hPα' 



/-! ## Finite spanning sets and the diagonal

The `const` primitive needs two self-contained ingredients: what it means for `d`
elements `e : Fin d → G` to generate the abelian group `G` (`AddSubgroup.closure`),
and the diagonal subgroup of `H × H`.  The load-bearing fact here is the *induction
principle along the generating set*: a function invariant under every generator is
invariant under every element (the invariance set is an additive subgroup containing
the generators, hence the whole group). -/

/-! ## Finite spanning sets and the diagonal

The `const` primitive needs two ingredients: what it means for `d` elements to generate
an abelian group, and the diagonal subgroup of `H × H`. -/

/-- The elements `e : Fin d → G` generate `G` as an abelian group. -/
def FiniteSpanningSet {d : ℕ} (e : Fin d → G) : Prop :=
  AddSubgroup.closure (Set.range e) = ⊤

/-- Each generator lies in the generated subgroup. -/
lemma span_gen_mem {d : ℕ} (e : Fin d → G) (i : Fin d) :
    e i ∈ AddSubgroup.closure (Set.range e) := by
  exact AddSubgroup.subset_closure (by exact ⟨i, rfl⟩)

/-- Under the spanning hypothesis every element of `G` lies in the generated subgroup. -/
lemma span_mem {d : ℕ} {e : Fin d → G} (hspan : FiniteSpanningSet e) (g : G) :
    g ∈ AddSubgroup.closure (Set.range e) := by
  rw [hspan]
  exact AddSubgroup.mem_top g

/-- A function invariant under each generator is invariant under every element: the
induction principle along the generating set. -/
lemma constant_of_generator_invariant {X : Type*} {d : ℕ} {e : Fin d → G}
    (hspan : FiniteSpanningSet e) {f : G → X}
    (hinv : ∀ (i : Fin d) (x : G), f (x + e i) = f x) (x₀ : G) :
    ∀ g : G, f (x₀ + g) = f x₀ := by
  let K : AddSubgroup G :=
    { carrier := {g : G | ∀ x : G, f (x + g) = f x}
      zero_mem' := by
        intro x
        simp
      add_mem' := by
        intro a b ha hb x
        calc
          f (x + (a + b)) = f ((x + a) + b) := by rw [add_assoc]
          _ = f (x + a) := hb (x + a)
          _ = f x := ha x
      neg_mem' := by
        intro a ha x
        have hx := ha (x - a)
        -- f ((x - a) + a) = f (x - a): (x - a) + a = x
        have hsum : (x - a) + a = x := by abel
        rw [hsum] at hx
        -- goal: f (x + (-a)) = f x: x + (-a) = x - a
        have hneg : x + (-a) = x - a := by abel
        rw [hneg]
        exact hx.symm }
  have hspanle : AddSubgroup.closure (Set.range e) ≤ K := by
    rw [AddSubgroup.closure_le]
    intro y hy
    rcases hy with ⟨i, rfl⟩
    intro x
    exact hinv i x
  intro g
  have hg : g ∈ K := by
    exact hspanle (span_mem hspan g)
  exact hg x₀

/-- The diagonal of `H × H`. -/
def diag (H : Type*) [AddCommGroup H] : Set (H × H) :=
  {p | p.1 = p.2}

/-- Membership in the diagonal reduces definitionally. -/
lemma mem_diag_iff (a b : H) : ((a, b) : H × H) ∈ diag H ↔ a = b := by
  simp [diag]



/-! ## Translates of the diagonal

Membership lemmas driving the `const` functional equation: a point `p` lies in the
translate `a + Δ` (resp. `a + (H×H∖Δ)`) exactly when its coordinate difference
`δ p = p.1 − p.2` agrees with (resp. differs from) `δ a`.  The difference map `sub2`
is an additive homomorphism. -/

def sub2 (H : Type*) [AddCommGroup H] : (H × H) →+ H where
  toFun p := p.1 - p.2
  map_zero' := by simp
  map_add' p q := by
    simp
    abel

/-- Membership in the diagonal, in terms of the difference homomorphism. -/
lemma mem_diag_sub2 (p : H × H) : p ∈ diag H ↔ sub2 H p = 0 := by
  simp [diag, sub2, sub_eq_zero]

/-- Membership in a translate of the diagonal: both points have the same coordinate
difference as the translating point. -/
lemma mem_add_diag (a p : H × H) :
    (p ∈ a + diag H) ↔ sub2 H p = sub2 H a := by
  change p ∈ ({a} : Set (H × H)) + diag H ↔ sub2 H p = sub2 H a
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, c, hc, hsum⟩
    simp at hu
    subst u
    have hc0 : sub2 H c = 0 := (mem_diag_sub2 c).mp hc
    calc
      sub2 H p = sub2 H (a + c) := by rw [hsum]
      _ = sub2 H a + sub2 H c := map_add (sub2 H) a c
      _ = sub2 H a := by rw [hc0, add_zero]
  · intro h
    refine ⟨a, by simp, p - a, ?_, ?_⟩
    · exact (mem_diag_sub2 (p - a)).mpr (by
        have hsub : sub2 H (p - a) = sub2 H p - sub2 H a := map_sub (sub2 H) p a
        rw [hsub, h, sub_self])
    · simp

/-- Membership in the translate of the complement of the diagonal: the coordinate
difference differs from the translating point's. -/
lemma mem_add_diag_compl (a p : H × H) :
    (p ∈ a + ((Set.univ : Set (H × H)) \ diag H)) ↔ sub2 H p ≠ sub2 H a := by
  change p ∈ ({a} : Set (H × H)) + ((Set.univ : Set (H × H)) \ diag H) ↔ sub2 H p ≠ sub2 H a
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, c, hc, hsum⟩
    simp at hu
    subst u
    have hcnd : c ∉ diag H := hc.2
    have hc0 : sub2 H c ≠ 0 := by
      intro hz
      exact hcnd ((mem_diag_sub2 c).mpr hz)
    intro heq
    have hsum' : sub2 H p = sub2 H a + sub2 H c := by
      rw [← hsum]
      exact map_add (sub2 H) a c
    have : sub2 H a = sub2 H a + sub2 H c := by rw [← hsum', heq]
    exact hc0 (by
      exact add_left_cancel (a := sub2 H a) (b := sub2 H c) (c := 0)
        (by simpa [add_zero] using this.symm))
  · intro h
    refine ⟨a, by simp, p - a, ?_, ?_⟩
    · constructor
      · trivial
      · intro hd
        have hd0 : sub2 H (p - a) = 0 := (mem_diag_sub2 (p - a)).mp hd
        have hsub : sub2 H (p - a) = sub2 H p - sub2 H a := map_sub (sub2 H) p a
        rw [hsub] at hd0
        exact h (sub_eq_zero.mp hd0)
    · simp



/-! ## The `const` primitive

The paper's Example "Differing by a constant is expressible", in two pieces: the
definition `diffConst` (the coordinate difference `sub2 (α x)` is constant) with its
coordinate reformulation, and the *single-generator* expressibility `diffConstGen e`:
the equation `(α(x)+Δ) ⊎ (α(x+e)+(H²∖Δ)) = H²` forces the coordinate difference to be
`e`-invariant.  Assembling the generators (via `expressible_conj` +
`constant_of_generator_invariant`) turns `diffConstGen` for a spanning set into
`diffConst`. -/

def diffConst (α : G → H × H) : Prop :=
  ∃ c : H, ∀ x : G, sub2 H (α x) = c

/-- `sub2 (α x) = c` is the same as `(α x).1 = (α x).2 + c`. -/
lemma sub2_const_iff_coord {α : G → H × H} {c : H} :
    (∀ x : G, sub2 H (α x) = c) ↔ ∀ x : G, (α x).1 = (α x).2 + c := by
  constructor
  · intro h x
    have hs : (α x).1 - (α x).2 = c := by simpa [sub2] using h x
    rw [sub_eq_iff_eq_add] at hs
    rw [hs]
    rw [add_comm]
  · intro h x
    -- show sub2 (α x) = c: (αx).1 - (αx).2 = c
    have hs : (α x).1 - (α x).2 = c := by
      rw [h x]
      abel
    simpa [sub2] using hs

/-- Invariance of the coordinate difference along a single direction `e`. -/
def diffConstGen (e : G) (α : G → H × H) : Prop :=
  ∀ x : G, sub2 H (α (x + e)) = sub2 H (α x)

/-- Expressing invariance of the difference along a single direction: the equation
`(α(x)+Δ) ⊎ (α(x+e)+(H²∖Δ)) = H²`. -/
theorem diffConstGen_expressible (hH : ∃ z : H, z ≠ 0) (e : G) :
    ExpressibleProperty (fun α : G → H × H => diffConstGen e α) := by
  classical
  let h : Fin 2 → G := ![0, e]
  let E : Fin 2 → Set (H × H) := ![diag H, (Set.univ : Set (H × H)) \ diag H]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j
    · refine ⟨(0, 0), ?_⟩
      simp [E, diag]
    · rcases hH with ⟨z, hz⟩
      refine ⟨(0, z), ?_⟩
      simp [E, diag]
      intro h0z
      exact hz h0z.symm
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq diffConstGen
    constructor
    · intro hinv x y
      have hc : sub2 H (α (x + e)) = sub2 H (α x) := hinv x
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ sub2 H y = sub2 H (α x) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_diag (α x) y
      have hp1 : p (1 : Fin 2) ↔ sub2 H y ≠ sub2 H (α (x + e)) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_diag_compl (α (x + e)) y
      have hp1' : p (1 : Fin 2) ↔ sub2 H y ≠ sub2 H (α x) := by
        rw [hp1, hc]
      by_cases hy : sub2 H y = sub2 H (α x)
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          exact (hp1'.mp hj) hy
      · refine ⟨(1 : Fin 2), (hp1').mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · exfalso
          exact hy ((hp0).mp hj)
        · rfl
    · intro hs x
      have hmem0 (y : H × H) : y ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) ↔
          sub2 H y = sub2 H (α x) := by
        simp [h, E]
        exact mem_add_diag (α x) y
      have hmem1 (y : H × H) : y ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) ↔
          sub2 H y ≠ sub2 H (α (x + e)) := by
        simp [h, E]
        exact mem_add_diag_compl (α (x + e)) y
      have hs' := hs x (α (x + e))
      rcases hs' with ⟨j, hj, _⟩
      fin_cases j
      · exact (hmem0 (α (x + e))).mp hj
      · exfalso
        exact ((hmem1 (α (x + e))).mp hj) rfl



/-! ## The `d`-generator conjunction (`constGen`)

The `d`-direction conjunction `constGen e` of `diffConstGen (e i)` is expressible for any
finite family `e : Fin d → G` (induction over `d`, using `expressible_conj`; no spanning
hypothesis is needed for expressibility itself — spanning is only used to conclude
`diffConst` from generator-wise invariance). -/

def constGen {d : ℕ} (e : Fin d → G) (α : G → H × H) : Prop :=
  ∀ i : Fin d, diffConstGen (e i) α

/-- A generator family of length `d+1` splits into the first generator and the tail. -/
lemma constGen_succ {d : ℕ} (e : Fin (d + 1) → G) (α : G → H × H) :
    constGen e α ↔ diffConstGen (e 0) α ∧ constGen (fun i : Fin d => e (Fin.succ i)) α := by
  unfold constGen diffConstGen
  constructor
  · intro h
    constructor
    · exact h 0
    · intro i x
      exact h (Fin.succ i) x
  · intro h i x
    by_cases hz : i = 0
    · subst i
      exact h.1 x
    · let j : Fin d := ⟨i.val - 1, by
        have hi := i.isLt
        have hne : i.val ≠ 0 := by
          intro hv
          apply hz
          apply Fin.ext
          exact hv
        omega⟩
      have hsucc : i = Fin.succ j := by
        apply Fin.ext
        simp [j]
        have hpos' : 0 < i.val := Nat.pos_of_ne_zero (by
          intro hv
          apply hz
          apply Fin.ext
          exact hv)
        omega
      rw [hsucc]
      exact h.2 j x

/-- The `d`-direction conjunction is expressible (no spanning hypothesis needed). -/
theorem constGen_expressible {d : ℕ} (e : Fin d → G) (hH : ∃ z : H, z ≠ 0) :
    ExpressibleProperty (fun α : G → H × H => constGen e α) := by
  induction d with
  | zero =>
      rcases (fullProperty_expressible (G := G) (H := H × H)) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      constructor
      · intro _hp
        exact (hiff α).mp trivial
      · intro _hs i
        exact (nomatch i)
  | succ d ih =>
      have h0 : ExpressibleProperty (fun α : G → H × H => diffConstGen (e 0) α) :=
        diffConstGen_expressible hH (e 0)
      have hr : ExpressibleProperty (fun α : G → H × H =>
          constGen (fun i : Fin d => e (Fin.succ i)) α) := ih (fun i : Fin d => e (Fin.succ i))
      rcases (expressible_conj h0 hr) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      have hsplit := constGen_succ e α
      constructor
      · intro hcα
        exact (hiff α).mp (hsplit.mp hcα)
      · intro hs
        exact hsplit.mpr ((hiff α).mpr hs)



/-! ## The `const` example over a spanning set

For a family `e : Fin d → G` that spans `G` (`FiniteSpanningSet e`), generator-wise
invariance of the coordinate difference is equivalent to `diffConst` (`constGen_iff_diffConst`,
via `constant_of_generator_invariant` applied to `x ↦ sub2 (α x)`, witness
`c = sub2 (α 0)`), so the conjunction system of `constGen_expressible` witnesses
expressibility of `diffConst` (`const_expressible`, the paper's Example "const"). -/

lemma constGen_iff_diffConst {d : ℕ} (e : Fin d → G) (hspan : FiniteSpanningSet e)
    (α : G → H × H) : constGen e α ↔ diffConst α := by
  constructor
  · intro hc
    -- f := fun x => sub2 (α x): invariant under each generator:
    have hinv : ∀ (i : Fin d) (x : G), sub2 H (α (x + e i)) = sub2 H (α x) := by
      intro i x
      exact hc i x
    have hall := constant_of_generator_invariant (e := e) hspan
      (f := fun x : G => sub2 H (α x)) hinv (0 : G)
    refine ⟨sub2 H (α 0), ?_⟩
    intro x
    simpa using hall x
  · intro hd i x
    rcases hd with ⟨c, hc⟩
    calc
      sub2 H (α (x + e i)) = c := hc (x + e i)
      _ = sub2 H (α x) := (hc x).symm

/-- Differing by a constant is expressible whenever the generators span `G` (the paper's
Example "const"). -/
theorem const_expressible {d : ℕ} (e : Fin d → G) (hspan : FiniteSpanningSet e)
    (hH : ∃ z : H, z ≠ 0) :
    ExpressibleProperty (fun α : G → H × H => diffConst α) := by
  rcases (constGen_expressible (e := e) hH) with ⟨S, hE, hiff⟩
  refine ⟨S, hE, ?_⟩
  intro α
  have hiffc := constGen_iff_diffConst e hspan α
  constructor
  · intro hd
    exact (hiff α).mp (hiffc.mpr hd)
  · intro hs
    exact hiffc.mp ((hiff α).mpr hs)



/-! ## Express-period over a general group codomain

The punctured-translate lemma over an arbitrary group `H`, and the general form of the
paper's Corollary "Expressing periodicity" (single direction): `α(x+v) = α(x)` for all
`x` is expressible by `(α(x)+{0}) ⊎ (α(x+v)+(H\{0})) = H` whenever `H` is nontrivial.
(The `ZMod N`-specialised version `periodicAlong_expressible` is above.) -/

lemma mem_add_punctured_general (a y : H) :
    y ∈ (a + ({z : H | z ≠ 0})) ↔ y ≠ a := by
  change y ∈ ({a} : Set H) + ({z : H | z ≠ 0}) ↔ y ≠ a
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨w, hw, u, hu, hsum⟩
    simp at hw
    subst w
    intro hy
    have ha0 : a + u = a := by
      calc
        a + u = y := hsum
        _ = a := hy
    have hsum' : a + u = a + 0 := by simpa using ha0
    have hc : u = 0 := add_left_cancel (a := a) (b := u) (c := 0) hsum'
    exact hu hc
  · intro hne
    refine ⟨a, by simp, y - a, ?_, ?_⟩
    · intro hz
      exact hne (sub_eq_zero.mp hz)
    · abel

/-- Periodicity along a single direction over a general group codomain `H` (`H`
nontrivial) is expressible, via `(α(x)+{0}) ⊎ (α(x+v)+(H\\{0})) = H`. -/
theorem periodicAlong_expressible_general (hH : ∃ z : H, z ≠ 0) (v : G) :
    ExpressibleProperty (fun α : G → H => periodicAlong v α) := by
  classical
  let h : Fin 2 → G := ![0, v]
  let E : Fin 2 → Set H := ![{0}, {z : H | z ≠ 0}]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j
    · refine ⟨(0 : H), ?_⟩
      simp [E]
    · rcases hH with ⟨z, hz⟩
      refine ⟨z, ?_⟩
      simp [E]
      exact hz
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq periodicAlong
    constructor
    · intro hper x y
      have hc : α (x + v) = α x := hper x
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ y = α x := by
        dsimp [p]
        simp [h, E]
        simpa using (mem_add_singleton H (α x) 0 y)
      have hp1 : p (1 : Fin 2) ↔ y ≠ α (x + v) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_punctured_general (α (x + v)) y
      have hp1' : p (1 : Fin 2) ↔ y ≠ α x := by
        rw [hp1, hc]
      by_cases hy : y = α x
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          exact (hp1'.mp hj) hy
      · refine ⟨(1 : Fin 2), (hp1').mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · exfalso
          exact hy ((hp0).mp hj)
        · rfl
    · intro hs x
      have hmem0 (y : H) : y ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) ↔ y = α x := by
        simp [h, E]
        simpa using (mem_add_singleton H (α x) 0 y)
      have hmem1 (y : H) : y ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) ↔ y ≠ α (x + v) := by
        simp [h, E]
        exact mem_add_punctured_general (α (x + v)) y
      have hs' := hs x (α (x + v))
      rcases hs' with ⟨j, hj, _⟩
      fin_cases j
      · exact (hmem0 (α (x + v))).mp hj
      · exfalso
        exact ((hmem1 (α (x + v))).mp hj) rfl



/-! ## Express-period over a spanning family

The paper's Corollary "Expressing periodicity" for `G' = G`: with generators
`e : Fin d → G` spanning `G`, the conjunction of single-direction periodicity in each
generator is expressible (`genInvariant_expressible`), and by the invariance-set
argument it coincides with constancy of `α` (`genInvariant_iff_constant`), so
expressibility of "`α` is constant" follows (`expressible_constant`).  Pulling this
back to a subgroup `G'` (for proper subgroups) is the `pullbackSystem` application. -/

def genInvariant {d : ℕ} (e : Fin d → G) (α : G → H) : Prop :=
  ∀ i : Fin d, periodicAlong (e i) α

/-- A generator family of length `d+1` splits into the first generator and the tail. -/
lemma genInvariant_succ {d : ℕ} (e : Fin (d + 1) → G) (α : G → H) :
    genInvariant e α ↔ periodicAlong (e 0) α ∧ genInvariant (fun i : Fin d => e (Fin.succ i)) α := by
  unfold genInvariant periodicAlong
  constructor
  · intro h
    constructor
    · exact h 0
    · intro i x
      exact h (Fin.succ i) x
  · intro h i x
    by_cases hz : i = 0
    · subst i
      exact h.1 x
    · let j : Fin d := ⟨i.val - 1, by
        have hne : i.val ≠ 0 := by
          intro hv
          apply hz
          apply Fin.ext
          exact hv
        have hpos : 0 < i.val := Nat.pos_of_ne_zero hne
        have hle : i.val ≤ d := by omega
        exact lt_of_lt_of_le (Nat.sub_lt hpos (by norm_num)) hle⟩
      have hsucc : i = Fin.succ j := by
        apply Fin.ext
        simp [j]
        have hpos' : 0 < i.val := Nat.pos_of_ne_zero (by
          intro hv
          apply hz
          apply Fin.ext
          exact hv)
        omega
      rw [hsucc]
      exact h.2 j x

/-- The `d`-generator periodicity conjunction is expressible. -/
theorem genInvariant_expressible {d : ℕ} (e : Fin d → G) (hH : ∃ z : H, z ≠ 0) :
    ExpressibleProperty (fun α : G → H => genInvariant e α) := by
  induction d with
  | zero =>
      rcases (fullProperty_expressible (G := G) (H := H)) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      constructor
      · intro _hp
        exact (hiff α).mp trivial
      · intro _hs i
        exact (nomatch i)
  | succ d ih =>
      have h0 : ExpressibleProperty (fun α : G → H => periodicAlong (e 0) α) :=
        periodicAlong_expressible_general hH (e 0)
      have hr : ExpressibleProperty (fun α : G → H =>
          genInvariant (fun i : Fin d => e (Fin.succ i)) α) := ih (fun i : Fin d => e (Fin.succ i))
      rcases (expressible_conj h0 hr) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      have hsplit := genInvariant_succ e α
      constructor
      · intro hcα
        exact (hiff α).mp (hsplit.mp hcα)
      · intro hs
        exact hsplit.mpr ((hiff α).mpr hs)

/-- A function is constant. -/
def αConstant (α : G → H) : Prop :=
  ∃ c : H, ∀ x : G, α x = c

/-- For a spanning family, generator-wise periodicity is the same as constancy. -/
lemma genInvariant_iff_constant {d : ℕ} (e : Fin d → G) (hspan : FiniteSpanningSet e)
    (α : G → H) : genInvariant e α ↔ αConstant α := by
  constructor
  · intro hc
    have hinv : ∀ (i : Fin d) (x : G), α (x + e i) = α x := by
      intro i x
      exact hc i x
    have hall := constant_of_generator_invariant (e := e) hspan (f := α) hinv (0 : G)
    refine ⟨α 0, ?_⟩
    intro x
    simpa using hall x
  · intro hc i x
    rcases hc with ⟨c, hc0⟩
    calc
      α (x + e i) = c := hc0 (x + e i)
      _ = α x := (hc0 x).symm

/-- The property that `α` is constant on `G` is expressible whenever generators span `G`
(the paper's Corollary "Expressing periodicity" for `G' = G`). -/
theorem expressible_constant {d : ℕ} (e : Fin d → G) (hspan : FiniteSpanningSet e)
    (hH : ∃ z : H, z ≠ 0) :
    ExpressibleProperty (fun α : G → H => αConstant α) := by
  rcases (genInvariant_expressible (e := e) hH) with ⟨S, hE, hiff⟩
  refine ⟨S, hE, ?_⟩
  intro α
  have hiffc := genInvariant_iff_constant e hspan α
  constructor
  · intro hd
    exact (hiff α).mp (hiffc.mpr hd)
  · intro hs
    exact hiffc.mp ((hiff α).mpr hs)



/-! ## Express-period over a subgroup (coset-restriction pullback)

Given `φ : G' →+ G` with `G'` spanned by `e'`, the property that `α : G → H` is constant
on every coset `x₀ + φ(G')` is expressible: it is the `expressible_pullback` along `φ`
of the constancy property `expressible_constant` on `G'` (paper Corollary
"Expressing periodicity"). -/

/-- Express-period over a subgroup: for `φ : G' →+ G` with `G'` spanned by `e'`, the
property that `α : G → H` is constant on every coset `x₀ + φ(G')` is expressible
(pullback of the constancy property from `G'`). -/
theorem express_period_subgroup {d : ℕ} (φ : G' →+ G) (e' : Fin d → G')
    (hspan' : FiniteSpanningSet e') (hH : ∃ z : H, z ≠ 0) :
    ExpressibleProperty (fun α : G → H =>
      ∀ x₀ : G, αConstant (restrictToCoset φ α x₀)) := by
  exact expressible_pullback φ (expressible_constant (G := G') (e := e') hspan' hH)



/-! ## Linear constraints: subgroup kernels and the coefficient functional

First layer of the paper's "Expressing linear constraints": for an additive
homomorphism `ℓ : C →+ D`, membership in translates of `ker ℓ` and of its complement
reduce to agreement/disagreement of the `ℓ`-values (general subgroup translate
lemmas, then kernel specialisations), and constancy of `ℓ (α x)` along a single
direction `e` — equivalently `α(x)` staying in a single coset of `ker ℓ` — is
expressible (`linModDir_expressible`, the equation
`(α(x)+kerℓ) ⊎ (α(x+e)+(C∖kerℓ)) = C`).  The coefficient functional
`linFun N W c : a ↦ Σ_w c_w · a_w` over `ZMod N`-tuples is the concrete
instance used for linear relations. -/

variable {C D : Type*} [AddCommGroup C] [AddCommGroup D]

lemma mem_add_subgroup (K : AddSubgroup C) (a p : C) :
    (p ∈ a + (K : Set C)) ↔ p - a ∈ K := by
  change p ∈ ({a} : Set C) + (K : Set C) ↔ p - a ∈ K
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, k, hk, hsum⟩
    simp at hu
    subst u
    -- p = a + k → p − a = k ∈ K
    have hpa : p - a = k := by
      rw [← hsum]
      abel
    simpa [hpa] using hk
  · intro hk
    refine ⟨a, by simp, p - a, hk, ?_⟩
    abel

/-- Membership in the translate of the complement of a subgroup. -/
lemma mem_add_subgroup_compl (K : AddSubgroup C) (a p : C) :
    (p ∈ a + ((Set.univ : Set C) \ (K : Set C))) ↔ p - a ∉ K := by
  change p ∈ ({a} : Set C) + ((Set.univ : Set C) \ (K : Set C)) ↔ p - a ∉ K
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, c, hc, hsum⟩
    simp at hu
    subst u
    have hpa : p - a = c := by
      rw [← hsum]
      abel
    rw [hpa]
    exact hc.2
  · intro hnk
    refine ⟨a, by simp, p - a, ⟨by trivial, hnk⟩, ?_⟩
    abel

/-- Membership in a translate of the kernel of a homomorphism. -/
lemma mem_add_ker_iff (ℓ : C →+ D) (a p : C) :
    (p ∈ a + ((ℓ.ker : AddSubgroup C) : Set C)) ↔ ℓ p = ℓ a := by
  rw [mem_add_subgroup]
  constructor
  · intro hk
    have hzero : ℓ (p - a) = 0 := AddMonoidHom.mem_ker.mp hk
    have hmap : ℓ (p - a) = ℓ p - ℓ a := map_sub ℓ p a
    rw [hmap] at hzero
    exact sub_eq_zero.mp hzero
  · intro heq
    have hzero : ℓ (p - a) = 0 := by rw [map_sub, heq, sub_self]
    exact AddMonoidHom.mem_ker.mpr hzero

/-- Membership in the translate of the complement of the kernel. -/
lemma mem_add_ker_compl_iff (ℓ : C →+ D) (a p : C) :
    (p ∈ a + ((Set.univ : Set C) \ ((ℓ.ker : AddSubgroup C) : Set C))) ↔ ℓ p ≠ ℓ a := by
  rw [mem_add_subgroup_compl]
  constructor
  · intro hnk heq
    have hmem : p - a ∈ (ℓ.ker : AddSubgroup C) := by
      exact AddMonoidHom.mem_ker.mpr (by rw [map_sub, heq, sub_self])
    exact hnk hmem
  · intro hne hm
    have hzero : ℓ (p - a) = 0 := AddMonoidHom.mem_ker.mp hm
    have hmap : ℓ (p - a) = ℓ p - ℓ a := map_sub ℓ p a
    rw [hmap] at hzero
    exact hne (sub_eq_zero.mp hzero)

/-- The coefficient functional on `W`-tuples over `ZMod N`: `a ↦ Σ_w c_w · a_w`. -/
def linFun (N W : ℕ) (c : Fin W → ZMod N) : (Fin W → ZMod N) →+ ZMod N where
  toFun a := ∑ w : Fin W, c w * a w
  map_zero' := by simp
  map_add' a b := by
    simp [Finset.sum_add_distrib, mul_add]

/-- Constancy of `ℓ (α x)` along a single direction `e` (values lie in a single coset of
`ker ℓ`). -/
def linModDir (ℓ : C →+ D) (e : G) (α : G → C) : Prop :=
  ∀ x : G, ℓ (α (x + e)) = ℓ (α x)

/-- Expressing constancy-mod-`ker ℓ` along a single direction: the equation
`(α(x)+kerℓ) ⊎ (α(x+e)+(C∖kerℓ)) = C`. -/
theorem linModDir_expressible (ℓ : C →+ D) (hK : ∃ a : C, ℓ a ≠ 0) (e : G) :
    ExpressibleProperty (fun α : G → C => linModDir ℓ e α) := by
  classical
  let h : Fin 2 → G := ![0, e]
  let E : Fin 2 → Set C := ![((ℓ.ker : AddSubgroup C) : Set C),
    (Set.univ : Set C) \ ((ℓ.ker : AddSubgroup C) : Set C)]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j
    · refine ⟨(0 : C), ?_⟩
      simp [E]
    · rcases hK with ⟨a, ha⟩
      refine ⟨a, ?_⟩
      simp [E]
      intro hker
      exact ha (AddMonoidHom.mem_ker.mp hker)
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq linModDir
    constructor
    · intro hper x y
      have hc : ℓ (α (x + e)) = ℓ (α x) := hper x
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ ℓ y = ℓ (α x) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_ker_iff ℓ (α x) y
      have hp1 : p (1 : Fin 2) ↔ ℓ y ≠ ℓ (α (x + e)) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_ker_compl_iff ℓ (α (x + e)) y
      have hp1' : p (1 : Fin 2) ↔ ℓ y ≠ ℓ (α x) := by
        rw [hp1, hc]
      by_cases hy : ℓ y = ℓ (α x)
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          exact (hp1'.mp hj) hy
      · refine ⟨(1 : Fin 2), (hp1').mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · exfalso
          exact hy ((hp0).mp hj)
        · rfl
    · intro hs x
      have hmem0 (y : C) : y ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) ↔ ℓ y = ℓ (α x) := by
        simp [h, E]
        exact mem_add_ker_iff ℓ (α x) y
      have hmem1 (y : C) : y ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) ↔ ℓ y ≠ ℓ (α (x + e)) := by
        simp [h, E]
        exact mem_add_ker_compl_iff ℓ (α (x + e)) y
      have hs' := hs x (α (x + e))
      rcases hs' with ⟨j, hj, _⟩
      fin_cases j
      · exact (hmem0 (α (x + e))).mp hj
      · exfalso
        exact ((hmem1 (α (x + e))).mp hj) rfl



/-! ## Linear constraints over a spanning family (`linGen`)

Generator-wise constancy of `x ↦ ℓ (α x)` (the `d`-direction conjunction of
`linModDir`, `linGen`) is expressible by induction (`linGen_expressible`, mirroring
`constGen_expressible`); under a spanning hypothesis it coincides with constancy of the
`ℓ`-image (`linGen_iff_linConstVal`, via `constant_of_generator_invariant`), giving
expressibility of "the tuple stays in a single coset of `ker ℓ`"
(`linConstVal_expressible`) — the kernel-coset form of the paper's "Expressing linear
constraints". -/

def linGen {d : ℕ} (ℓ : C →+ D) (e : Fin d → G) (α : G → C) : Prop :=
  ∀ i : Fin d, linModDir ℓ (e i) α

/-- A generator family of length `d+1` splits into the first generator and the tail. -/
lemma linGen_succ {d : ℕ} (ℓ : C →+ D) (e : Fin (d + 1) → G) (α : G → C) :
    linGen ℓ e α ↔ linModDir ℓ (e 0) α ∧ linGen ℓ (fun i : Fin d => e (Fin.succ i)) α := by
  unfold linGen linModDir
  constructor
  · intro h
    constructor
    · exact h 0
    · intro i x
      exact h (Fin.succ i) x
  · intro h i x
    by_cases hz : i = 0
    · subst i
      exact h.1 x
    · let j : Fin d := ⟨i.val - 1, by
        have hne : i.val ≠ 0 := by
          intro hv
          apply hz
          apply Fin.ext
          exact hv
        have hpos : 0 < i.val := Nat.pos_of_ne_zero hne
        have hle : i.val ≤ d := by omega
        exact lt_of_lt_of_le (Nat.sub_lt hpos (by norm_num)) hle⟩
      have hsucc : i = Fin.succ j := by
        apply Fin.ext
        simp [j]
        have hpos' : 0 < i.val := Nat.pos_of_ne_zero (by
          intro hv
          apply hz
          apply Fin.ext
          exact hv)
        omega
      rw [hsucc]
      exact h.2 j x

/-- The `d`-generator conjunction is expressible. -/
theorem linGen_expressible {d : ℕ} (ℓ : C →+ D) (e : Fin d → G)
    (hK : ∃ a : C, ℓ a ≠ 0) :
    ExpressibleProperty (fun α : G → C => linGen ℓ e α) := by
  induction d with
  | zero =>
      rcases (fullProperty_expressible (G := G) (H := C)) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      constructor
      · intro _hp
        exact (hiff α).mp trivial
      · intro _hs i
        exact (nomatch i)
  | succ d ih =>
      have h0 : ExpressibleProperty (fun α : G → C => linModDir ℓ (e 0) α) :=
        linModDir_expressible ℓ hK (e 0)
      have hr : ExpressibleProperty (fun α : G → C =>
          linGen ℓ (fun i : Fin d => e (Fin.succ i)) α) := ih (fun i : Fin d => e (Fin.succ i))
      rcases (expressible_conj h0 hr) with ⟨S, hE, hiff⟩
      refine ⟨S, hE, ?_⟩
      intro α
      have hsplit := linGen_succ ℓ e α
      constructor
      · intro hcα
        exact (hiff α).mp (hsplit.mp hcα)
      · intro hs
        exact hsplit.mpr ((hiff α).mpr hs)

/-- The `ℓ`-image of `α` is constant. -/
def linConstVal (ℓ : C →+ D) (α : G → C) : Prop :=
  ∃ c : D, ∀ x : G, ℓ (α x) = c

/-- For a spanning family, generator-wise `ℓ`-constancy is the same as constancy of the
`ℓ`-image. -/
lemma linGen_iff_linConstVal {d : ℕ} (ℓ : C →+ D) (e : Fin d → G)
    (hspan : FiniteSpanningSet e) (α : G → C) : linGen ℓ e α ↔ linConstVal ℓ α := by
  constructor
  · intro hc
    have hinv : ∀ (i : Fin d) (x : G), ℓ (α (x + e i)) = ℓ (α x) := by
      intro i x
      exact hc i x
    have hall := constant_of_generator_invariant (e := e) hspan
      (f := fun x : G => ℓ (α x)) hinv (0 : G)
    refine ⟨ℓ (α 0), ?_⟩
    intro x
    simpa using hall x
  · intro hc i x
    rcases hc with ⟨c, hc0⟩
    calc
      ℓ (α (x + e i)) = c := hc0 (x + e i)
      _ = ℓ (α x) := (hc0 x).symm

/-- The property that `x ↦ ℓ (α x)` is constant is expressible over a spanning family
(the kernel-coset form of the paper's "Expressing linear constraints"). -/
theorem linConstVal_expressible {d : ℕ} (ℓ : C →+ D) (e : Fin d → G)
    (hspan : FiniteSpanningSet e) (hK : ∃ a : C, ℓ a ≠ 0) :
    ExpressibleProperty (fun α : G → C => linConstVal ℓ α) := by
  rcases (linGen_expressible ℓ e hK) with ⟨S, hE, hiff⟩
  refine ⟨S, hE, ?_⟩
  intro α
  have hiffc := linGen_iff_linConstVal ℓ e hspan α
  constructor
  · intro hd
    exact (hiff α).mp (hiffc.mpr hd)
  · intro hs
    exact hiffc.mp ((hiff α).mpr hs)



/-! ## The `express-linear` instance over `ZMod N`

The concrete instance of the paper's "Expressing linear constraints": `linConstVal`
with the coefficient functional `ℓ := linFun N W c` on `C := Fin W → ZMod N` is the
property that `∑_w c_w · α(x)(w)` is constant in `x`.  Non-triviality of `ℓ` follows
from any non-zero coefficient (basis-vector witness via `Finset.sum_eq_single`), so
`linConstVal_expressible` applies whenever the coefficients are not all zero and the
generators span `G`. -/

lemma linFun_basis_value (N W : ℕ) (c : Fin W → ZMod N) (w₀ : Fin W) :
    (linFun N W c) (fun w : Fin W => if w = w₀ then (1 : ZMod N) else 0) = c w₀ := by
  dsimp [linFun]
  rw [Finset.sum_eq_single w₀]
  · simp
  · intro b hb hneq
    simp [hneq]
  · intro hnotin
    exact False.elim (hnotin (Finset.mem_univ w₀))

/-- Non-triviality of the coefficient functional. -/
lemma linFun_exists_ne_zero (N W : ℕ) (c : Fin W → ZMod N) (hc : ∃ w : Fin W, c w ≠ 0) :
    ∃ a : Fin W → ZMod N, linFun N W c a ≠ 0 := by
  rcases hc with ⟨w₀, hw₀⟩
  refine ⟨(fun w : Fin W => if w = w₀ then (1 : ZMod N) else 0), ?_⟩
  rw [linFun_basis_value N W c w₀]
  exact hw₀

/-- The paper's "Expressing linear constraints" over `ZMod N`: for coefficients
`c : Fin W → ZMod N` with at least one non-zero coefficient and generators `e` spanning
`G`, the property of a combined function `α : G → (Fin W → ZMod N)` that
`∑_w c_w · α(x)(w)` is constant in `x` is expressible. -/
theorem express_linear_zmod {N W d : ℕ} (c : Fin W → ZMod N) (e : Fin d → G)
    (hspan : FiniteSpanningSet e) (hc : ∃ w : Fin W, c w ≠ 0) :
    ExpressibleProperty (fun α : G → (Fin W → ZMod N) => linConstVal (linFun N W c) α) := by
  exact linConstVal_expressible (ℓ := linFun N W c) (C := Fin W → ZMod N) (D := ZMod N)
    (e := e) hspan (linFun_exists_ne_zero N W c hc)



/-! ## Boolean layer I: parity and the alternating law

The first boolean primitive: over `ZMod (2^(e+1))`, the parity homomorphism
`parHom e : ZMod (2^(e+1)) →+ ZMod 2` (reduction mod 2, via `ZMod.castHom`), the
two-element structure of `ZMod 2`, and the alternating law along a direction `v`
(`boolAltDir`: `par (α(x+v) − α x) = 1`).  `boolAltDir_expressible` shows the
double-even-tile equation `(α(x)+ker) ⊎ (α(x+v)+ker) = H` expresses exactly this
alternation — the parity kernel of the paper's `bool-expr` (funct-1) equation. -/

def parHom (e : ℕ) : ZMod (2 ^ (e + 1)) →+ ZMod 2 :=
  (ZMod.castHom (R := ZMod 2) (by
    refine ⟨2 ^ e, ?_⟩
    rw [pow_succ']) : ZMod (2 ^ (e + 1)) →+* ZMod 2).toAddMonoidHom

/-- Every element of `ZMod 2` is `0` or `1`. -/
lemma zmod2_other_eq {a b c : ZMod 2} (hab : a ≠ b) (hca : c ≠ a) : c = b := by
  rcases (zmod2_eq_zero_or_one a) with rfl | rfl <;>
  rcases (zmod2_eq_zero_or_one b) with rfl | rfl <;>
  rcases (zmod2_eq_zero_or_one c) with rfl | rfl <;>
  simp at hab hca ⊢

/-- In `ZMod 2`, subtraction of `1` swaps the two elements. -/
lemma zmod2_sub_eq_one_iff {a b : ZMod 2} : a - b = 1 ↔ a ≠ b := by
  rcases (zmod2_eq_zero_or_one a) with rfl | rfl <;>
  rcases (zmod2_eq_zero_or_one b) with rfl | rfl <;>
  simp

/-- Alternation of parity along `v`: `par(α(x+v)) ≠ par(α x)` for all `x`. -/
def boolAltDir (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1))) : Prop :=
  ∀ x : G, parHom e (α (x + v) - α x) = 1

/-- The parity-alternation equation `(α(x) + 2H) ⊎ (α(x+v) + 2H) = H` expresses
alternation of parity along `v` (the `2H = ker (parHom e)`-tile form). -/
theorem boolAltDir_expressible (e : ℕ) (v : G) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) => boolAltDir e v α) := by
  classical
  let ℓ : ZMod (2 ^ (e + 1)) →+ ZMod 2 := parHom e
  let h : Fin 2 → G := ![0, v]
  let E : Fin 2 → Set (ZMod (2 ^ (e + 1))) :=
    ![((ℓ.ker : AddSubgroup (ZMod (2 ^ (e + 1)))) : Set (ZMod (2 ^ (e + 1)))),
      ((ℓ.ker : AddSubgroup (ZMod (2 ^ (e + 1)))) : Set (ZMod (2 ^ (e + 1))))]
  have hE : ∀ j : Fin 2, (E j).Nonempty := by
    intro j
    fin_cases j <;> refine ⟨(0 : ZMod (2 ^ (e + 1))), ?_⟩ <;> simp [E]
  refine ⟨singleEqSystem 2 h E, ?_, ?_⟩
  · intro i j
    exact hE j
  · intro α
    rw [singleEq_solves]
    unfold singleEq boolAltDir
    constructor
    · intro hd x y
      -- hd : ∀ x, ℓ(α(x+v) − αx) = 1
      have hneq (x : G) : ℓ (α (x + v)) ≠ ℓ (α x) := by
        -- from hd x and map_sub:
        have hm : ℓ (α (x + v)) - ℓ (α x) = 1 := by
          rw [← map_sub]
          exact hd x
        exact zmod2_sub_eq_one_iff.mp hm
      let p : Fin 2 → Prop := fun j => y ∈ α (x + h j) + E j
      have hp0 : p (0 : Fin 2) ↔ ℓ y = ℓ (α x) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_ker_iff ℓ (α x) y
      have hp1 : p (1 : Fin 2) ↔ ℓ y = ℓ (α (x + v)) := by
        dsimp [p]
        simp [h, E]
        exact mem_add_ker_iff ℓ (α (x + v)) y
      by_cases hy : ℓ y = ℓ (α x)
      · refine ⟨(0 : Fin 2), (hp0).mpr hy, ?_⟩
        intro j hj
        fin_cases j
        · rfl
        · exfalso
          -- j = 1: ℓ y = ℓ(α(x+v)) but ℓ y = ℓ αx and these differ:
          exact (hneq x) (((hp1).mp hj).symm.trans hy)
      · refine ⟨(1 : Fin 2), (hp1).mpr ?_, ?_⟩
        · exact zmod2_other_eq (hneq x).symm hy
        · intro j hj
          fin_cases j
          · exfalso
            exact hy ((hp0).mp hj)
          · rfl
    · intro hs x
      -- Solves → alternation: show ℓ α(x+v) ≠ ℓ αx, hence the difference is 1.
      have hneq' : ℓ (α (x + v)) ≠ ℓ (α x) := by
        by_contra hEq
        -- uniqueness at y := α(x+v) is violated by both j = 0 and j = 1
        have hmem0 : α (x + v) ∈ α x + ((ℓ.ker : AddSubgroup (ZMod (2 ^ (e + 1)))) : Set (ZMod (2 ^ (e + 1)))) :=
          (mem_add_ker_iff ℓ (α x) (α (x + v))).mpr hEq
        have hmem1 : α (x + v) ∈ α (x + v) + ((ℓ.ker : AddSubgroup (ZMod (2 ^ (e + 1)))) : Set (ZMod (2 ^ (e + 1)))) := by
          rw [mem_add_ker_iff]
        have h0m : α (x + v) ∈ α (x + h (0 : Fin 2)) + E (0 : Fin 2) := by
          simpa [h, E] using hmem0
        have h1m : α (x + v) ∈ α (x + h (1 : Fin 2)) + E (1 : Fin 2) := by
          simpa [h, E] using hmem1
        rcases (hs x (α (x + v))) with ⟨jw, _hjw, huniq⟩
        have hjw0 : jw = 0 := (huniq 0 h0m).symm
        have hjw1 : jw = 1 := (huniq 1 h1m).symm
        exact (by decide : (0 : Fin 2) ≠ (1 : Fin 2)) (hjw0.symm.trans hjw1)
      -- ℓ (α (x + v)) - ℓ (α x) = 1 (values in ZMod 2 and unequal):
      have hdiff : ℓ (α (x + v)) - ℓ (α x) = 1 := zmod2_sub_eq_one_iff.mpr hneq'
      have hmap : (parHom e) (α (x + v) - α x) =
          (parHom e) (α (x + v)) - (parHom e) (α x) :=
        map_sub (parHom e) (α (x + v)) (α x)
      rw [hmap]
      exact hdiff



/-! ## Boolean layer II: the even/odd coset structure

The parity extractor `parityIn e : ZMod (2^(e+1)) → ZMod 2` (values `0` on the even
subgroup `evenSub e := ker (parHom e)`, `1` outside), with the two-coset partition of
`ZMod (2^(e+1))` into `evenSub` and the odd coset `1 + evenSub`, and the consequence of
the alternating law: `α(x)` and `α(x+v)` occupy opposite cosets. -/

def evenSub (e : ℕ) : AddSubgroup (ZMod (2 ^ (e + 1))) := (parHom e).ker

/-- The parity extractor: `0` on the even subgroup, `1` on its complement. -/
def parityIn (e : ℕ) (z : ZMod (2 ^ (e + 1))) : ZMod 2 := parHom e z

/-- `0 ≠ 1` in `ZMod 2`. -/
lemma zmod2_zero_ne_one : (0 : ZMod 2) ≠ (1 : ZMod 2) := by norm_num

/-- An element lies in the even subgroup iff its parity is `0`. -/
lemma parityIn_zero_iff_even (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    parityIn e z = 0 ↔ z ∈ evenSub e := by
  rw [evenSub]
  exact (AddMonoidHom.mem_ker (f := parHom e) (x := z)).symm

/-- An element lies outside the even subgroup iff its parity is `1`. -/
lemma parityIn_one_iff_odd (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    parityIn e z = 1 ↔ z ∉ evenSub e := by
  constructor
  · intro hz hmem
    have h0 : parityIn e z = 0 := (parityIn_zero_iff_even e z).mpr hmem
    exact zmod2_zero_ne_one (h0.symm.trans hz)
  · intro hnmem
    have h0n : parityIn e z ≠ 0 := by
      intro hz
      exact hnmem ((parityIn_zero_iff_even e z).mp hz)
    exact zmod2_other_eq zmod2_zero_ne_one h0n

/-- The parity of `1` is `1`. -/
lemma parityIn_one (e : ℕ) : parityIn e (1 : ZMod (2 ^ (e + 1))) = 1 := by
  dsimp [parityIn, parHom]
  simp

/-- An element lies in the odd coset `1 + evenSub` iff its parity is `1`. -/
lemma mem_odd_coset_iff (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    z ∈ (1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1)))) ↔ parityIn e z = 1 := by
  rw [mem_add_subgroup]
  constructor
  · intro hmem
    have hp0 : parityIn e (z - 1) = 0 := (parityIn_zero_iff_even e (z - 1)).mp hmem
    have hz : parityIn e z = parityIn e (1 : ZMod (2 ^ (e + 1))) := by
      dsimp [parityIn] at hp0
      have hmap : parHom e (z - 1) = parHom e z - parHom e (1 : ZMod (2 ^ (e + 1))) :=
        map_sub (parHom e) z 1
      rw [hmap] at hp0
      exact sub_eq_zero.mp hp0
    have h1 : parityIn e (1 : ZMod (2 ^ (e + 1))) = 1 := parityIn_one e
    rwa [h1] at hz
  · intro hpz
    have hpar0 : parityIn e (z - 1) = 0 := by
      dsimp [parityIn]
      have hmap : parHom e (z - 1) = parHom e z - parHom e (1 : ZMod (2 ^ (e + 1))) :=
        map_sub (parHom e) z 1
      rw [hmap]
      have h1 : parHom e (1 : ZMod (2 ^ (e + 1))) = 1 := by
        dsimp [parHom]
        simp
      rw [h1]
      dsimp [parityIn] at hpz
      rw [hpz, sub_self]
    exact (parityIn_zero_iff_even e (z - 1)).mpr hpar0

/-- The two cosets of `evenSub` partition `ZMod (2^(e+1))`: `0`-parity (even) and
`1`-parity (odd). -/
lemma evenSub_odd_coset_partition (e : ℕ) :
    ((evenSub e : Set (ZMod (2 ^ (e + 1)))) ∪
      ((1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1)))))) =
      Set.univ := by
  ext z
  constructor
  · intro hz
    trivial
  · intro hz
    by_cases hp : parityIn e z = 0
    · left
      exact (parityIn_zero_iff_even e z).mp hp
    · right
      exact (mem_odd_coset_iff e z).mpr (zmod2_other_eq zmod2_zero_ne_one hp)

/-- The even subgroup and the odd coset are disjoint. -/
lemma evenSub_odd_coset_disjoint (e : ℕ) :
    Disjoint ((evenSub e : Set (ZMod (2 ^ (e + 1))))) ((1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1))))) := by
  rw [Set.disjoint_left]
  intro z hzA hzB
  have hp0 : parityIn e z = 0 := (parityIn_zero_iff_even e z).mp hzA
  have hp1 : parityIn e z = 1 := (mem_odd_coset_iff e z).mp hzB
  exact zmod2_zero_ne_one (hp0.symm.trans hp1)

/-- Under the alternating law, `α(x)` and `α(x+v)` occupy opposite cosets of the even
subgroup. -/
lemma boolAltDir_opposite_cosets (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) :
    ((α x ∈ evenSub e) ∧ (α (x + v) ∉ evenSub e)) ∨
    ((α x ∉ evenSub e) ∧ (α (x + v) ∈ evenSub e)) := by
  have hpar : parityIn e (α (x + v)) ≠ parityIn e (α x) := by
    have hdiff : parityIn e (α (x + v)) - parityIn e (α x) = 1 := by
      dsimp [parityIn]
      rw [← map_sub]
      exact hd x
    exact zmod2_sub_eq_one_iff.mp hdiff
  by_cases hpx : parityIn e (α x) = 0
  · left
    constructor
    · exact (parityIn_zero_iff_even e (α x)).mp hpx
    · intro hm
      exact hpar (((parityIn_zero_iff_even e (α (x + v))).mp hm).trans hpx.symm)
  · right
    constructor
    · intro hm
      exact hpx ((parityIn_zero_iff_even e (α x)).mp hm)
    · have hv : parityIn e (α (x + v)) = 0 := by
        by_contra hv0
        have h1v : parityIn e (α (x + v)) = 1 :=
          zmod2_other_eq zmod2_zero_ne_one hv0
        have h1x : parityIn e (α x) = 1 :=
          zmod2_other_eq zmod2_zero_ne_one hpx
        exact hpar (h1v.trans h1x.symm)
      exact (parityIn_zero_iff_even e (α (x + v))).mpr hv



set_option linter.unnecessarySimpa false

/-! ## Boolean layer III: the even/odd value pair

For a function alternating along `v` (`boolAltDir`), the pair `{α(x), α(x+v)}`
contains exactly one even element: `evenVal` and `oddVal` are the even and odd
representatives of the pair, and `boolAlt_evenOdd_pair` records that the representatives
are precisely the two values (split according to the coset of `α(x)`).  These are the
`a(x)`/`b(x)` value functions whose constancy along generators (funct-2) yields the
constant `a, b` of the boolean definition. -/

def evenVal (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1))) (x : G) : ZMod (2 ^ (e + 1)) :=
  if α x ∈ evenSub e then α x else α (x + v)

/-- The odd representative of the pair `{α(x), α(x+v)}`. -/
def oddVal (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1))) (x : G) : ZMod (2 ^ (e + 1)) :=
  if α x ∈ evenSub e then α (x + v) else α x

/-- Under the alternating law the even representative is indeed even, the odd
representative odd, and the two representatives are exactly the two values
`α(x)`, `α(x+v)` (split by which coset `α(x)` occupies). -/
lemma boolAlt_evenOdd_pair (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) :
    (evenVal e v α x ∈ evenSub e) ∧ (oddVal e v α x ∉ evenSub e) ∧
      ((α x ∈ evenSub e ∧ evenVal e v α x = α x ∧ oddVal e v α x = α (x + v)) ∨
       (α x ∉ evenSub e ∧ evenVal e v α x = α (x + v) ∧ oddVal e v α x = α x)) := by
  rcases (boolAltDir_opposite_cosets e v α hd x) with hc | hc
  · -- α x even, α (x+v) odd
    refine ⟨?_, ?_, ?_⟩
    · simpa [evenVal, hc.1]
    · intro ho
      have : α (x + v) ∈ evenSub e := by simpa [oddVal, hc.1] using ho
      exact hc.2 this
    · left
      refine ⟨hc.1, ?_, ?_⟩
      · simp [evenVal, hc.1]
      · simp [oddVal, hc.1]
  · -- α x odd, α (x+v) even
    refine ⟨?_, ?_, ?_⟩
    · simpa [evenVal, hc.1] using hc.2
    · intro ho
      exact hc.1 (by simpa [oddVal, hc.1] using ho)
    · right
      refine ⟨hc.1, ?_, ?_⟩
      · simp [evenVal, hc.1]
      · simp [oddVal, hc.1]



/-! ## Boolean layer IV: fiber preservation and representative invariance

The funct-2 content: a direction `u` preserves the two-value fiber
(`boolAltPairDir`: `{α(x), α(x+v)} = {α(x+u), α(x+v+u)}`).  Under the alternating law
`boolAltDir`, the unique even (resp. odd) element of a fiber is exactly `evenVal`
(resp. `oddVal`) (`even_mem_pair_eq`, `odd_mem_pair_eq`), so a fiber-preserving
direction leaves both representatives invariant (`evenVal_invariant_dir`,
`oddVal_invariant_dir`).  These give the generator-direction invariance of `a` and `b`
needed for the spanning-family constancy. -/

def boolAltPairDir (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) : Prop :=
  ∀ x : G, ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) =
    ({α (x + u), α (x + v + u)} : Set (ZMod (2 ^ (e + 1))))

/-- The even representative lies in its fiber. -/
lemma evenVal_mem_pair (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) :
    evenVal e v α x ∈ ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) := by
  rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE, hO, hsplit⟩
  rcases hsplit with hc | hc <;> simp [hc.2.1]

/-- Any even element of the fiber `{α(x), α(x+v)}` is the even representative. -/
lemma even_mem_pair_eq (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) {z : ZMod (2 ^ (e + 1))}
    (hzmem : z ∈ ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1))))) (hz : z ∈ evenSub e) :
    z = evenVal e v α x := by
  rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE, hO, hsplit⟩
  rcases hsplit with hc | hc
  · simp at hzmem
    rcases hzmem with hz1 | hz2
    · rw [hz1, hc.2.1]
    · exfalso
      have hodd : α (x + v) ∉ evenSub e := by rwa [hc.2.2] at hO
      exact hodd (by rwa [hz2] at hz)
  · simp at hzmem
    rcases hzmem with hz1 | hz2
    · exfalso
      exact hc.1 (by rwa [hz1] at hz)
    · rw [hz2, hc.2.1]

/-- Any odd element of the fiber is the odd representative. -/
lemma odd_mem_pair_eq (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) {z : ZMod (2 ^ (e + 1))}
    (hzmem : z ∈ ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1))))) (hz : z ∉ evenSub e) :
    z = oddVal e v α x := by
  rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE, hO, hsplit⟩
  rcases hsplit with hc | hc
  · -- α x even, α (x+v) odd
    simp at hzmem
    rcases hzmem with hz1 | hz2
    · exfalso
      have hz' : α x ∉ evenSub e := by rwa [hz1] at hz
      exact hz' hc.1
    · rw [hz2, hc.2.2]
  · -- α x odd, α (x+v) even
    simp at hzmem
    rcases hzmem with hz1 | hz2
    · rw [hz1, hc.2.2]
    · exfalso
      have hev : α (x + v) ∈ evenSub e := by rwa [hc.2.1] at hE
      exact hz (by rwa [← hz2] at hev)

lemma evenVal_invariant_dir (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (hp : boolAltPairDir e v u α) (x : G) :
    evenVal e v α (x + u) = evenVal e v α x := by
  have hpair := boolAlt_evenOdd_pair e v α hd (x + u)
  have hE : evenVal e v α (x + u) ∈ evenSub e := hpair.1
  have hself : evenVal e v α (x + u) ∈
      ({α (x + u), α (x + u + v)} : Set (ZMod (2 ^ (e + 1)))) :=
    evenVal_mem_pair e v α hd (x + u)
  have hself' : evenVal e v α (x + u) ∈
      ({α (x + u), α (x + v + u)} : Set (ZMod (2 ^ (e + 1)))) := by
    rwa [show α (x + u + v) = α (x + v + u) by congr 1; abel] at hself
  have hback : evenVal e v α (x + u) ∈
      ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) := by
    rwa [← hp x] at hself'
  exact even_mem_pair_eq e v α hd x hback hE

/-- The odd representative lies in its fiber. -/
lemma oddVal_mem_pair (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) :
    oddVal e v α x ∈ ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) := by
  rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE, hO, hsplit⟩
  rcases hsplit with hc | hc <;> simp [hc.2.2]

/-- The odd representative is invariant along a fiber-preserving direction. -/
lemma oddVal_invariant_dir (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (hp : boolAltPairDir e v u α) (x : G) :
    oddVal e v α (x + u) = oddVal e v α x := by
  have hpair := boolAlt_evenOdd_pair e v α hd (x + u)
  have hO : oddVal e v α (x + u) ∉ evenSub e := hpair.2.1
  have hself : oddVal e v α (x + u) ∈
      ({α (x + u), α (x + u + v)} : Set (ZMod (2 ^ (e + 1)))) :=
    oddVal_mem_pair e v α hd (x + u)
  have hself' : oddVal e v α (x + u) ∈
      ({α (x + u), α (x + v + u)} : Set (ZMod (2 ^ (e + 1)))) := by
    rwa [show α (x + u + v) = α (x + v + u) by congr 1; abel] at hself
  have hback : oddVal e v α (x + u) ∈
      ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) := by
    rwa [← hp x] at hself'
  exact odd_mem_pair_eq e v α hd x hback hO



/-! ## Boolean layer V: constancy of the representatives and `(v,{a,b})`-booleanity

Under a spanning family of fiber-preserving directions (`boolAltPairDir` along each
generator), the representatives `evenVal`, `oddVal` are constant (`evenVal_const`,
`oddVal_const`, via `constant_of_generator_invariant`); setting `a := evenVal 0`,
`b := oddVal 0`, the alternating function is `(v,{a,b})`-boolean with `a` even and
`b` odd (`isBooleanAlt_of_alt_fiber_spanning`): every `α(x) ∈ {a, b}` and
`α(x+v) = a+b−α(x)`. -/

def IsBooleanAlt (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1))) : Prop :=
  ∃ a b : ZMod (2 ^ (e + 1)),
    a ∈ evenSub e ∧ b ∉ evenSub e ∧
    (∀ x : G, α x = a ∨ α x = b) ∧ (∀ x : G, α (x + v) = a + b - α x)

/-- Under a spanning family of fiber-preserving directions, the even representative is
constant. -/
lemma evenVal_const {d : ℕ} (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (gens : Fin d → G) (hspan : FiniteSpanningSet gens) (hd : boolAltDir e v α)
    (hp : ∀ i : Fin d, boolAltPairDir e v (gens i) α) :
    ∀ x : G, evenVal e v α x = evenVal e v α 0 := by
  have hinv : ∀ (i : Fin d) (x : G), evenVal e v α (x + gens i) = evenVal e v α x := by
    intro i x
    exact evenVal_invariant_dir e v (gens i) α hd (hp i) x
  have hall := constant_of_generator_invariant (e := gens) hspan
    (f := fun x : G => evenVal e v α x) hinv (0 : G)
  intro x
  simpa using hall x

/-- Under a spanning family of fiber-preserving directions, the odd representative is
constant. -/
lemma oddVal_const {d : ℕ} (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (gens : Fin d → G) (hspan : FiniteSpanningSet gens) (hd : boolAltDir e v α)
    (hp : ∀ i : Fin d, boolAltPairDir e v (gens i) α) :
    ∀ x : G, oddVal e v α x = oddVal e v α 0 := by
  have hinv : ∀ (i : Fin d) (x : G), oddVal e v α (x + gens i) = oddVal e v α x := by
    intro i x
    exact oddVal_invariant_dir e v (gens i) α hd (hp i) x
  have hall := constant_of_generator_invariant (e := gens) hspan
    (f := fun x : G => oddVal e v α x) hinv (0 : G)
  intro x
  simpa using hall x

/-- Alternation with the constant pair: `a + b - a = b` and `a + b - b = a`. -/
lemma bool_pair_alt {e : ℕ} (a b x : ZMod (2 ^ (e + 1))) (hx : x = a ∨ x = b) :
    a + b - x = (if x = a then b else a) := by
  rcases hx with hxa | hxb
  · rw [hxa]
    rw [if_pos rfl]
    ring
  · rw [hxb]
    by_cases hba : b = a
    · rw [if_pos hba]
      rw [hba]
      ring
    · rw [if_neg hba]
      ring

/-- A function satisfying the alternating law (`boolAltDir`) along `v`, whose fibers
`{α(x), α(x+v)}` are preserved by a spanning family of directions, is
`(v,{a,b})`-boolean with `a = evenVal 0` and `b = oddVal 0`. -/
theorem isBooleanAlt_of_alt_fiber_spanning {d : ℕ} (e : ℕ) (v : G)
    (α : G → ZMod (2 ^ (e + 1))) (gens : Fin d → G) (hspan : FiniteSpanningSet gens)
    (hd : boolAltDir e v α) (hp : ∀ i : Fin d, boolAltPairDir e v (gens i) α) :
    IsBooleanAlt e v α := by
  let a : ZMod (2 ^ (e + 1)) := evenVal e v α 0
  let b : ZMod (2 ^ (e + 1)) := oddVal e v α 0
  have hE : a ∈ evenSub e := by
    dsimp [a]
    exact (boolAlt_evenOdd_pair e v α hd 0).1
  have hO : b ∉ evenSub e := by
    dsimp [b]
    exact (boolAlt_evenOdd_pair e v α hd 0).2.1
  refine ⟨a, b, hE, hO, ?_, ?_⟩
  · intro x
    rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE2, hO2, hsplit⟩
    rcases hsplit with hc | hc
    · left
      have h1 : α x = evenVal e v α x := hc.2.1.symm
      have h2 : evenVal e v α x = a := by
        rw [evenVal_const e v α gens hspan hd hp x]
      exact h1.trans h2
    · right
      have h1 : α x = oddVal e v α x := hc.2.2.symm
      have h2 : oddVal e v α x = b := by
        rw [oddVal_const e v α gens hspan hd hp x]
      exact h1.trans h2
  · intro x
    rcases (boolAlt_evenOdd_pair e v α hd x) with ⟨hE2, hO2, hsplit⟩
    rcases hsplit with hc | hc
    · -- α x even
      have hxv : α (x + v) = oddVal e v α x := hc.2.2.symm
      have hx : α x = evenVal e v α x := hc.2.1.symm
      have hOc : oddVal e v α x = b := by
        rw [oddVal_const e v α gens hspan hd hp x]
      have hEc : evenVal e v α x = a := by
        rw [evenVal_const e v α gens hspan hd hp x]
      calc
        α (x + v) = oddVal e v α x := hxv
        _ = b := hOc
        _ = a + b - α x := by
          rw [hx, hEc]
          ring
    · -- α x odd
      have hxv : α (x + v) = evenVal e v α x := hc.2.1.symm
      have hx : α x = oddVal e v α x := hc.2.2.symm
      have hOc : oddVal e v α x = b := by
        rw [oddVal_const e v α gens hspan hd hp x]
      have hEc : evenVal e v α x = a := by
        rw [evenVal_const e v α gens hspan hd hp x]
      calc
        α (x + v) = evenVal e v α x := hxv
        _ = a := hEc
        _ = a + b - α x := by
          rw [hx, hOc]
          ring



/-! ## Boolean layer VI: booleanity implies the alternating and fiber laws

The converse of Boolean layer V: a function which is `(v,{a,b})`-boolean
(`IsBooleanAlt`) with `a` even and `b` odd satisfies the alternating law
(`boolAltDir`) along `v` and preserves its two-value fiber along *every*
direction (`boolAltPairDir` for all `u`).  Together with
`isBooleanAlt_of_alt_fiber_spanning` this shows that the alternating law plus
fiber preservation along a spanning family is *equivalent* to
`(v,{a,b})`-booleanity with even `a` and odd `b` (Proposition bool-expr). -/

/-- A `(v,{a,b})`-boolean function satisfies the alternating law (`boolAltDir`) and
preserves its fiber along every direction. -/
theorem alt_fiber_of_boolean (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hb : IsBooleanAlt e v α) :
    boolAltDir e v α ∧ ∀ u : G, boolAltPairDir e v u α := by
  rcases hb with ⟨a, b, haE, hbO, hvals, hswap⟩
  have hpa : parityIn e a = 0 := (parityIn_zero_iff_even e a).mpr haE
  have hpb : parityIn e b = 1 := (parityIn_one_iff_odd e b).mpr hbO
  have hfib : ∀ y : G, ({α y, α (y + v)} : Set (ZMod (2 ^ (e + 1)))) = ({a, b} : Set (ZMod (2 ^ (e + 1)))) := by
    intro y
    ext z
    constructor
    · intro hzmem
      simp at hzmem
      rcases hzmem with hz1 | hz2
      · rcases (hvals y) with hya | hyb
        · simp [hz1, hya]
        · simp [hz1, hyb]
      · rcases (hvals y) with hya | hyb
        · have hyv : α (y + v) = b := by rw [hswap y, hya]; ring
          simp [hz2, hyv]
        · have hyv : α (y + v) = a := by rw [hswap y, hyb]; ring
          simp [hz2, hyv]
    · intro hzmem
      simp at hzmem
      rcases hzmem with hza | hzb
      · rcases (hvals y) with hya | hyb
        · simp [hza, hya]
        · have hyv : α (y + v) = a := by rw [hswap y, hyb]; ring
          simp [hza, hyv]
      · rcases (hvals y) with hya | hyb
        · have hyv : α (y + v) = b := by rw [hswap y, hya]; ring
          simp [hzb, hyv]
        · simp [hzb, hyb]
  constructor
  · intro x
    rw [map_sub]
    rcases (hvals x) with hxa | hxb
    · have hxv : α (x + v) = b := by rw [hswap x, hxa]; ring
      rw [hxv, hxa]
      change parityIn e b - parityIn e a = (1 : ZMod 2)
      rw [hpb, hpa]
      rw [sub_zero]
    · have hxv : α (x + v) = a := by rw [hswap x, hxb]; ring
      rw [hxv, hxb]
      change parityIn e a - parityIn e b = (1 : ZMod 2)
      rw [hpa, hpb]
      exact (zmod2_sub_eq_one_iff (a := (0 : ZMod 2)) (b := (1 : ZMod 2))).mpr zmod2_zero_ne_one
  · intro u x
    calc
      ({α x, α (x + v)} : Set (ZMod (2 ^ (e + 1)))) = ({a, b} : Set (ZMod (2 ^ (e + 1)))) := hfib x
      _ = ({α (x + u), α (x + u + v)} : Set (ZMod (2 ^ (e + 1)))) := (hfib (x + u)).symm
      _ = ({α (x + u), α (x + v + u)} : Set (ZMod (2 ^ (e + 1)))) := by
        rw [show α (x + u + v) = α (x + v + u) by congr 1; abel]


end
end Commons.PeriodicTiling

open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Expressing a single boolean function (Proposition bool-expr)

The paper's Proposition "Expressing a single boolean function" (tex lines 776-794):
over a group `G` with a chosen finite generating family, the property of being
`(e,{a,b})`-boolean for some distinct `a,b` of opposite parity is expressible.
Following the paper, the system consists of the parity-alternation equation
(funct-1, already shown expressible as `boolAltDir_expressible`) together with, for
each generator `e_i`, the fiber-preservation equation (funct-2):

    ⊎_{y' ∈ {x, x+e}}  ( (α(y'+e_i) + {0}) ⊎ (α(y') + (2H \ {0})) )  =  H .

Under the alternating law, equation (funct-2) for direction `u` is equivalent to
fiber preservation along `u` (`boolAltPairDir e v u α`); together with the
spanning-family constancy of the representatives (`isBooleanAlt_of_alt_fiber_spanning`,
Boolean layer V) this yields the equivalence with `IsBooleanAlt`.

All results here take the codomain `H = ZMod (2^(e+1))`, so that `evenSub e` is the
index-two subgroup `2·H`, and the punctured cosets in (funct-2) are nonempty as soon
as `1 ≤ e` (i.e. `|H| ≥ 4`). -/

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]

/-- The nonzero even elements `evenSub e \ {0}` (the punctured subgroup). -/
def punctEven (e : ℕ) : Set (ZMod (2 ^ (e + 1))) :=
  (evenSub e : Set (ZMod (2 ^ (e + 1)))) \ ({0} : Set (ZMod (2 ^ (e + 1))))

/-- The parity of `2` is `0`: `2` is even. -/
lemma parityIn_two (e : ℕ) : parityIn e (2 : ZMod (2 ^ (e + 1))) = 0 := by
  have h2 : (2 : ZMod (2 ^ (e + 1))) = 1 + 1 := by norm_num
  calc
    parityIn e (2 : ZMod (2 ^ (e + 1))) = parityIn e (1 + 1) := by rw [h2]
    _ = parityIn e 1 + parityIn e 1 := by simp [parityIn]
    _ = (1 : ZMod 2) + 1 := by rw [parityIn_one]
    _ = 0 := by decide

/-- `2` is a nonzero element of the even subgroup (hence of the punctured even set)
whenever `e ≥ 1`. -/
lemma two_mem_punctEven (e : ℕ) (he : 1 ≤ e) :
    (2 : ZMod (2 ^ (e + 1))) ∈ punctEven e := by
  constructor
  · exact (parityIn_zero_iff_even e (2 : ZMod (2 ^ (e + 1)))).mpr (parityIn_two e)
  · intro hz
    have hnat : ((2 : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by simpa using hz
    have hd : 2 ^ (e + 1) ∣ 2 := (ZMod.natCast_eq_zero_iff 2 (2 ^ (e + 1))).mp hnat
    have hpow : 4 ≤ 2 ^ (e + 1) := by
      have h2 : 2 ≤ e + 1 := by omega
      have hp := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h2
      norm_num at hp
      exact hp
    have hle : 2 ^ (e + 1) ≤ 2 := Nat.le_of_dvd (by norm_num : 0 < 2) hd
    omega

/-- The punctured even set is nonempty for `e ≥ 1`. -/
lemma punctEven_nonempty (e : ℕ) (he : 1 ≤ e) : (punctEven e).Nonempty := by
  refine ⟨(2 : ZMod (2 ^ (e + 1))), two_mem_punctEven e he⟩

/-- Membership in a translate of a punctured subgroup:
`z ∈ c + (S \ {0})` iff `z - c ∈ S` and `z ≠ c`. -/
lemma mem_add_subgroup_diff_zero (S : AddSubgroup H) (c z : H) :
    (z ∈ c + ((S : Set H) \ ({0} : Set H))) ↔ z - c ∈ S ∧ z ≠ c := by
  change z ∈ ({c} : Set H) + ((S : Set H) \ ({0} : Set H)) ↔ z - c ∈ S ∧ z ≠ c
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, s, hs, hsum⟩
    simp at hu
    subst u
    constructor
    · have hzs : z - c = s := by rw [← hsum]; abel
      simpa [hzs] using hs.1
    · intro hz
      have hs0 : s = 0 := by
        calc s = z - c := by rw [← hsum]; abel
        _ = 0 := sub_eq_zero.mpr hz
      exact hs.2 hs0
  · intro h
    rcases h with ⟨hsub, hne⟩
    refine ⟨c, by simp, z - c, ⟨hsub, ?_⟩, ?_⟩
    · intro hz
      exact hne (sub_eq_zero.mp hz)
    · abel

/-- In `ZMod (2^(e+1))`, membership of `z - c` in the even subgroup is parity equality. -/
lemma sub_mem_evenSub_iff_parity (e : ℕ) (c z : ZMod (2 ^ (e + 1))) :
    z - c ∈ evenSub e ↔ parityIn e z = parityIn e c := by
  constructor
  · intro hz
    have hk := AddMonoidHom.mem_ker.mp hz
    have hmap : (parHom e) (z - c) = (parHom e) z - (parHom e) c := map_sub (parHom e) z c
    rw [hmap] at hk
    exact sub_eq_zero.mp hk
  · intro hp
    have hzero : (parHom e) (z - c) = 0 := by
      rw [map_sub]
      dsimp [parityIn] at hp
      rw [hp, sub_self]
    exact AddMonoidHom.mem_ker.mpr hzero

/-- Membership in the translate of the punctured even subgroup, expressed via parity. -/
lemma mem_add_punctEven_iff (e : ℕ) (c z : ZMod (2 ^ (e + 1))) :
    z ∈ c + punctEven e ↔ parityIn e z = parityIn e c ∧ z ≠ c := by
  rw [punctEven, mem_add_subgroup_diff_zero]
  constructor
  · intro h
    exact ⟨(sub_mem_evenSub_iff_parity e c z).mp h.1, h.2⟩
  · intro h
    exact ⟨(sub_mem_evenSub_iff_parity e c z).mpr h.1, h.2⟩

/-- Elements of the even subgroup have parity `0`. -/
lemma parityIn_of_mem_evenSub (e : ℕ) {z : ZMod (2 ^ (e + 1))} (hz : z ∈ evenSub e) :
    parityIn e z = 0 := (parityIn_zero_iff_even e z).mp hz

/-- Elements outside the even subgroup have parity `1`. -/
lemma parityIn_of_not_mem_evenSub (e : ℕ) {z : ZMod (2 ^ (e + 1))} (hz : z ∉ evenSub e) :
    parityIn e z = 1 := (parityIn_one_iff_odd e z).mpr hz

/-- Opposite parities give distinct elements. -/
lemma ne_of_parity_ne (e : ℕ) {z w : ZMod (2 ^ (e + 1))}
    (hz : parityIn e z = 0) (hw : parityIn e w = 1) : z ≠ w := by
  intro heq
  exact zmod2_zero_ne_one (hz.symm.trans (by rw [heq, hw]))

/-- The even subgroup and the odd coset are complementary; parity splits the group. -/
lemma mem_even_or_odd_coset (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    z ∈ evenSub e ∨ z ∈ (1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1)))) := by
  rcases (evenSub_odd_coset_partition e) with hpart
  have hz : z ∈ (evenSub e : Set (ZMod (2 ^ (e + 1)))) ∪
      ((1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1))))) := by
    rw [hpart]
    trivial
  simpa using hz

/-- Membership in the odd coset iff parity `1`. -/
lemma mem_odd_coset_iff' (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    z ∈ (1 : ZMod (2 ^ (e + 1))) + (evenSub e : Set (ZMod (2 ^ (e + 1)))) ↔ parityIn e z = 1 :=
  mem_odd_coset_iff e z


/-! ## Abstract partition lemmas

The (funct-2) membership reasoning reduces to two abstract set-theoretic facts: a
two-element set equality with distinct left elements forces the right elements to
match up to a swap (`pairdir_split`), and four colour sets built from a predicate
`P` with `P a`, `¬ P b` — the singletons `{a}`, `{b}` and the two punctured classes
`{z | P z ∧ z ≠ a}`, `{z | ¬ P z ∧ z ≠ b}` — partition the space
(`existsUnique_four_alt`). -/

/-- Two-element sets: `{p,q} = {r,s}` with `p ≠ q` forces matching up to swap. -/
lemma pairdir_split {Z : Type*} {p q r s : Z} (hneq : p ≠ q)
    (hset : ({p, q} : Set Z) = {r, s}) :
    (r = p ∧ s = q) ∨ (r = q ∧ s = p) := by
  have hr : r = p ∨ r = q := by
    have hm : r ∈ ({p, q} : Set Z) := by
      rw [hset]
      simp
    simpa using hm
  have hs : s = p ∨ s = q := by
    have hm : s ∈ ({p, q} : Set Z) := by
      rw [hset]
      simp
    simpa using hm
  rcases hr with hrp | hrq
  · left
    constructor
    · exact hrp
    · rcases hs with hsp | hsq
      · exfalso
        have hmq : q ∈ ({p, q} : Set Z) := by simp
        have hq : q ∈ ({r, s} : Set Z) := by rwa [hset] at hmq
        rw [hrp, hsp] at hq
        have hqq : q = p := by simpa using hq
        exact hneq hqq.symm
      · exact hsq
  · right
    constructor
    · exact hrq
    · rcases hs with hsp | hsq
      · exact hsp
      · exfalso
        have hmp : p ∈ ({p, q} : Set Z) := by simp
        have hp : p ∈ ({r, s} : Set Z) := by rwa [hset] at hmp
        rw [hrq, hsq] at hp
        have hpp : p = q := by simpa using hp
        exact hneq hpp

/-- Four colour sets built from a predicate `P` and two points `a` (with `P a`) and
`b` (with `¬ P b`) partition the space: for every `y` exactly one of the four sets
`{a}`, `{z | P z ∧ z ≠ a}`, `{b}`, `{z | ¬ P z ∧ z ≠ b}` contains `y`. -/
lemma existsUnique_four_alt {Z : Type*} (P : Z → Prop) (a b : Z) (hPa : P a) (hPb : ¬ P b) :
    ∀ y : Z, ∃! j : Fin 4,
      y ∈ (![{a}, {z | P z ∧ z ≠ a}, {b}, {z | ¬ P z ∧ z ≠ b}] : Fin 4 → Set Z) j := by
  intro y
  by_cases hPy : P y
  · by_cases hya : y = a
    · refine ⟨(0 : Fin 4), ?_, ?_⟩
      · simp [hya]
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · rfl
        · exfalso; exact hj'.2 hya
        · exfalso
          have hPy2 : P y := by rwa [hya.symm] at hPa
          exact hPb (by rwa [hj'] at hPy2)
        · exfalso; exact hj'.1 hPy
    · refine ⟨(1 : Fin 4), ?_, ?_⟩
      · exact ⟨hPy, hya⟩
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · exfalso; exact hya hj'
        · rfl
        · exfalso
          exact hPb (by rwa [hj'] at hPy)
        · exfalso; exact hj'.1 hPy
  · by_cases hyb : y = b
    · refine ⟨(2 : Fin 4), ?_, ?_⟩
      · simp [hyb]
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · exfalso
          exact hPy (by rwa [hj'.symm] at hPa)
        · exfalso; exact hPy hj'.1
        · rfl
        · exfalso; exact hj'.2 hyb
    · refine ⟨(3 : Fin 4), ?_, ?_⟩
      · exact ⟨hPy, hyb⟩
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · exfalso
          exact hPy (by rwa [hj'.symm] at hPa)
        · exfalso; exact hPy hj'.1
        · exfalso; exact hyb hj'
        · rfl

/-! ## The (funct-2) equation for one direction

For a direction `u` (the paper's generator `e_i`) and the alternating direction `v`
(the paper's `e`), the equation (funct-2) is the single functional equation whose
four terms (indexed by `Fin 4`) are: the singleton `{α(x+u)}`, the punctured coset
`α(x) + (evenSub \ {0})`, the singleton `{α(x+v+u)}` and the punctured coset
`α(x+v) + (evenSub \ {0})`; the corresponding shifts (relative to `x`) are `u`, `0`,
`v+u`, `v`. -/

/-- The four shifts of the (funct-2) equation for direction `u`. -/
def funct2H (v u : G) : Fin 4 → G := ![u, (0 : G), v + u, v]

/-- The four colour sets of the (funct-2) equation: two singletons `{0}` and the two
punctured even cosets. -/
def funct2E (e : ℕ) : Fin 4 → Set (ZMod (2 ^ (e + 1))) :=
  ![({0} : Set (ZMod (2 ^ (e + 1)))), punctEven e,
    ({0} : Set (ZMod (2 ^ (e + 1)))), punctEven e]

/-- The (funct-2) functional equation for direction `u`. -/
def funct2Eq (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) : Prop :=
  singleEq 4 (funct2H v u) (funct2E e) α


/-- Membership in tile 0 (singleton at shift `u`): `y = α(x+u)`. -/
lemma mem_funct2_tile0 (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) (x : G)
    (y : ZMod (2 ^ (e + 1))) :
    y ∈ α (x + funct2H v u (0 : Fin 4)) + funct2E e (0 : Fin 4) ↔ y = α (x + u) := by
  simp [funct2H, funct2E, mem_add_singleton]

/-- Membership in tile 1 (punctured coset at shift `0`). -/
lemma mem_funct2_tile1 (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) (x : G)
    (y : ZMod (2 ^ (e + 1))) :
    y ∈ α (x + funct2H v u (1 : Fin 4)) + funct2E e (1 : Fin 4) ↔
      parityIn e y = parityIn e (α x) ∧ y ≠ α x := by
  simp [funct2H, funct2E, mem_add_punctEven_iff]

/-- Membership in tile 2 (singleton at shift `v+u`): `y = α(x+v+u)`. -/
lemma mem_funct2_tile2 (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) (x : G)
    (y : ZMod (2 ^ (e + 1))) :
    y ∈ α (x + funct2H v u (2 : Fin 4)) + funct2E e (2 : Fin 4) ↔ y = α (x + v + u) := by
  simp [funct2H, funct2E, mem_add_singleton]
  rw [show x + (v + u) = x + v + u by abel]

/-- Membership in tile 3 (punctured coset at shift `v`). -/
lemma mem_funct2_tile3 (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) (x : G)
    (y : ZMod (2 ^ (e + 1))) :
    y ∈ α (x + funct2H v u (3 : Fin 4)) + funct2E e (3 : Fin 4) ↔
      parityIn e y = parityIn e (α (x + v)) ∧ y ≠ α (x + v) := by
  simp [funct2H, funct2E, mem_add_punctEven_iff]

/-- Parity is `1` iff it is not `0` (in `ZMod 2`). -/
lemma parity_eq_one_iff_ne_zero (e : ℕ) (z : ZMod (2 ^ (e + 1))) :
    parityIn e z = 1 ↔ parityIn e z ≠ 0 := by
  constructor
  · intro hp hz
    exact zmod2_zero_ne_one (hz.symm.trans hp)
  · intro hz
    exact zmod2_other_eq zmod2_zero_ne_one hz

/-- Under the alternating law the two fibre values have opposite parity. -/
lemma parity_ne_of_boolAltDir (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) :
    parityIn e (α x) ≠ parityIn e (α (x + v)) := by
  have hpar : parityIn e (α (x + v)) - parityIn e (α x) = 1 := by
    dsimp [parityIn]
    rw [← map_sub]
    exact hd x
  intro heq
  have : (1 : ZMod 2) = 0 := by
    calc
      (1 : ZMod 2) = parityIn e (α (x + v)) - parityIn e (α x) := hpar.symm
      _ = 0 := by rw [heq, sub_self]
  exact zmod2_zero_ne_one this.symm

/-- Under the alternating law the two fibre values are distinct. -/
lemma ne_of_boolAltDir (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (x : G) : α x ≠ α (x + v) := by
  intro heq
  exact parity_ne_of_boolAltDir e v α hd x (by rw [heq])

/-- From the (funct-2) equation, each fibre value `α x`, `α (x+v)` equals one of the two
singleton values `α (x+u)`, `α (x+v+u)` (given the two values have opposite parity). -/
lemma funct2_value_in_pair (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1))) (x : G)
    (hf : funct2Eq e v u α) (hc : parityIn e (α x) ≠ parityIn e (α (x + v))) :
    (α (x + u) = α x ∨ α (x + v + u) = α x) ∧
    (α (x + u) = α (x + v) ∨ α (x + v + u) = α (x + v)) := by
  constructor
  · rcases (hf x (α x)) with ⟨jx, hjx, hux⟩
    fin_cases jx
    · left; exact ((mem_funct2_tile0 e v u α x (α x)).mp hjx).symm
    · exfalso
      exact ((mem_funct2_tile1 e v u α x (α x)).mp hjx).2 rfl
    · right; exact ((mem_funct2_tile2 e v u α x (α x)).mp hjx).symm
    · exfalso
      exact hc ((mem_funct2_tile3 e v u α x (α x)).mp hjx).1
  · rcases (hf x (α (x + v))) with ⟨jb, hjb, hub⟩
    fin_cases jb
    · left; exact ((mem_funct2_tile0 e v u α x (α (x + v))).mp hjb).symm
    · exfalso
      exact hc ((mem_funct2_tile1 e v u α x (α (x + v))).mp hjb).1.symm
    · right; exact ((mem_funct2_tile2 e v u α x (α (x + v))).mp hjb).symm
    · exfalso
      exact ((mem_funct2_tile3 e v u α x (α (x + v))).mp hjb).2 rfl

/-- If `a ≠ b` then `{a,b} = {t0,t1}` follows from the matching dichotomy. -/
lemma pair_set_eq_of_split {Z : Type*} {a b t0 t1 : Z}
    (h : (t0 = a ∧ t1 = b) ∨ (t0 = b ∧ t1 = a)) :
    ({a, b} : Set Z) = {t0, t1} := by
  rcases h with ⟨ht0, ht1⟩ | ⟨ht0, ht1⟩
  · rw [ht0, ht1]
  · ext z
    constructor
    · intro hz
      rcases hz with hza | hzb
      · right; exact hza.trans ht1.symm
      · left; exact hzb.trans ht0.symm
    · intro hz
      rcases hz with hz0 | hz1
      · right; exact hz0.trans ht0
      · left; exact hz1.trans ht1

/-- The (funct-2) equation implies fiber preservation along `u`, under the alternating
law (`boolAltDir`). -/
lemma boolAltPairDir_of_funct2Eq (e : ℕ) (v u : G) (α : G → ZMod (2 ^ (e + 1)))
    (hd : boolAltDir e v α) (hf : funct2Eq e v u α) : boolAltPairDir e v u α := by
  intro x
  have hc : parityIn e (α x) ≠ parityIn e (α (x + v)) := parity_ne_of_boolAltDir e v α hd x
  have hneq : α x ≠ α (x + v) := ne_of_boolAltDir e v α hd x
  have hval := funct2_value_in_pair e v u α x hf hc
  have hsplit : (α (x + u) = α x ∧ α (x + v + u) = α (x + v)) ∨
      (α (x + u) = α (x + v) ∧ α (x + v + u) = α x) := by
    rcases hval with ⟨hx, hb⟩
    rcases hx with ht0a | ht1a
    · left
      constructor
      · exact ht0a
      · rcases hb with hb0 | hb1
        · exfalso
          exact hneq (ht0a.symm.trans hb0)
        · exact hb1
    · right
      constructor
      · rcases hb with hb0 | hb1
        · exact hb0
        · exfalso
          exact hneq (ht1a.symm.trans hb1)
      · exact ht1a
  exact pair_set_eq_of_split hsplit



/-- Fiber preservation along `u` together with the alternating law gives the (funct-2)
equation for `u`: the four tiles partition the codomain at every `x`. -/
lemma funct2Eq_of_boolAltPairDir (e : ℕ) (_he : 1 ≤ e) (v u : G)
    (α : G → ZMod (2 ^ (e + 1))) (hd : boolAltDir e v α)
    (hp : boolAltPairDir e v u α) : funct2Eq e v u α := by
  intro x y
  have hneq : α x ≠ α (x + v) := ne_of_boolAltDir e v α hd x
  have hpar : parityIn e (α x) ≠ parityIn e (α (x + v)) := parity_ne_of_boolAltDir e v α hd x
  have hsplit : (α (x + u) = α x ∧ α (x + v + u) = α (x + v)) ∨
      (α (x + u) = α (x + v) ∧ α (x + v + u) = α x) :=
    pairdir_split hneq (hp x)
  rcases hsplit with ⟨ht0, ht1⟩ | ⟨ht0, ht1⟩
  · -- split 1: α(x+u) = α x (j=0 is the fibre value a), α(x+v+u) = α(x+v) (j=2 is b)
    by_cases hya : y = α x
    · refine ⟨(0 : Fin 4), ?_, ?_⟩
      · rw [hya]
        exact (mem_funct2_tile0 e v u α x (α x)).mpr ht0.symm
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · rfl
        · exfalso
          exact ((mem_funct2_tile1 e v u α x y).mp hj').2 hya
        · exfalso
          exact hneq (hya.symm.trans (((mem_funct2_tile2 e v u α x y).mp hj').trans ht1))
        · exfalso
          have hm := (mem_funct2_tile3 e v u α x y).mp hj'
          have hm1 : parityIn e (α x) = parityIn e (α (x + v)) := by
            simpa [hya] using hm.1
          exact hpar hm1
    · by_cases hyb : y = α (x + v)
      · refine ⟨(2 : Fin 4), ?_, ?_⟩
        · rw [hyb]
          exact (mem_funct2_tile2 e v u α x (α (x + v))).mpr ht1.symm
        · intro j' hj'
          fin_cases j' <;> simp at hj'
          · exfalso
            have hm := (mem_funct2_tile0 e v u α x y).mp hj'
            exact hneq (hyb.symm.trans (hm.trans ht0)).symm
          · exfalso
            have hm := (mem_funct2_tile1 e v u α x y).mp hj'
            have hm1 : parityIn e (α (x + v)) = parityIn e (α x) := by
              simpa [hyb] using hm.1
            exact hpar hm1.symm
          · rfl
          · exfalso
            exact ((mem_funct2_tile3 e v u α x y).mp hj').2 hyb
      · by_cases hypar : parityIn e y = parityIn e (α x)
        · refine ⟨(1 : Fin 4), ?_, ?_⟩
          · exact (mem_funct2_tile1 e v u α x y).mpr ⟨hypar, hya⟩
          · intro j' hj'
            fin_cases j' <;> simp at hj'
            · exfalso
              exact hya (((mem_funct2_tile0 e v u α x y).mp hj').trans ht0)
            · rfl
            · exfalso
              exact hyb (((mem_funct2_tile2 e v u α x y).mp hj').trans ht1)
            · exfalso
              have hm := (mem_funct2_tile3 e v u α x y).mp hj'
              exact hpar (hypar.symm.trans hm.1)
        · refine ⟨(3 : Fin 4), ?_, ?_⟩
          · exact (mem_funct2_tile3 e v u α x y).mpr ⟨zmod2_other_eq hpar hypar, hyb⟩
          · intro j' hj'
            fin_cases j' <;> simp at hj'
            · exfalso
              exact hya (((mem_funct2_tile0 e v u α x y).mp hj').trans ht0)
            · exfalso
              exact hypar ((mem_funct2_tile1 e v u α x y).mp hj').1
            · exfalso
              exact hyb (((mem_funct2_tile2 e v u α x y).mp hj').trans ht1)
            · rfl
  · -- split 2: α(x+u) = α(x+v) (j=0 is b), α(x+v+u) = α x (j=2 is a)
    by_cases hya : y = α x
    · refine ⟨(2 : Fin 4), ?_, ?_⟩
      · rw [hya]
        exact (mem_funct2_tile2 e v u α x (α x)).mpr ht1.symm
      · intro j' hj'
        fin_cases j' <;> simp at hj'
        · exfalso
          have hm := (mem_funct2_tile0 e v u α x y).mp hj'
          exact hneq (hya.symm.trans (hm.trans ht0))
        · exfalso
          exact ((mem_funct2_tile1 e v u α x y).mp hj').2 hya
        · rfl
        · exfalso
          have hm := (mem_funct2_tile3 e v u α x y).mp hj'
          have hm1 : parityIn e (α x) = parityIn e (α (x + v)) := by
            simpa [hya] using hm.1
          exact hpar hm1
    · by_cases hyb : y = α (x + v)
      · refine ⟨(0 : Fin 4), ?_, ?_⟩
        · rw [hyb]
          exact (mem_funct2_tile0 e v u α x (α (x + v))).mpr ht0.symm
        · intro j' hj'
          fin_cases j' <;> simp at hj'
          · rfl
          · exfalso
            have hm := (mem_funct2_tile1 e v u α x y).mp hj'
            have hm1 : parityIn e (α (x + v)) = parityIn e (α x) := by
              simpa [hyb] using hm.1
            exact hpar hm1.symm
          · exfalso
            have hm := (mem_funct2_tile2 e v u α x y).mp hj'
            exact hneq (hyb.symm.trans (hm.trans ht1)).symm
          · exfalso
            exact ((mem_funct2_tile3 e v u α x y).mp hj').2 hyb
      · by_cases hypar : parityIn e y = parityIn e (α x)
        · refine ⟨(1 : Fin 4), ?_, ?_⟩
          · exact (mem_funct2_tile1 e v u α x y).mpr ⟨hypar, hya⟩
          · intro j' hj'
            fin_cases j' <;> simp at hj'
            · exfalso
              exact hyb (((mem_funct2_tile0 e v u α x y).mp hj').trans ht0)
            · rfl
            · exfalso
              exact hya (((mem_funct2_tile2 e v u α x y).mp hj').trans ht1)
            · exfalso
              have hm := (mem_funct2_tile3 e v u α x y).mp hj'
              exact hpar (hypar.symm.trans hm.1)
        · refine ⟨(3 : Fin 4), ?_, ?_⟩
          · exact (mem_funct2_tile3 e v u α x y).mpr ⟨zmod2_other_eq hpar hypar, hyb⟩
          · intro j' hj'
            fin_cases j' <;> simp at hj'
            · exfalso
              exact hyb (((mem_funct2_tile0 e v u α x y).mp hj').trans ht0)
            · exfalso
              exact hypar ((mem_funct2_tile1 e v u α x y).mp hj').1
            · exfalso
              exact hya (((mem_funct2_tile2 e v u α x y).mp hj').trans ht1)
            · rfl

/-! ## Expressibility of the (funct-2) and combined boolean equations -/

/-- All tiles of the (funct-2) system are nonempty for `e ≥ 1`. -/
lemma funct2E_nonempty (e : ℕ) (he : 1 ≤ e) : ∀ j : Fin 4, (funct2E e j).Nonempty := by
  intro j
  fin_cases j
  · simp [funct2E]
  · simp [funct2E]
    exact punctEven_nonempty e he
  · simp [funct2E]
  · simp [funct2E]
    exact punctEven_nonempty e he

/-- The raw (funct-2) equation for direction `u` is expressible (all tiles nonempty for
`e ≥ 1`). -/
theorem funct2Eq_expressible (e : ℕ) (he : 1 ≤ e) (v u : G) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) => funct2Eq e v u α) := by
  refine ⟨singleEqSystem 4 (funct2H v u) (funct2E e), ?_, ?_⟩
  · intro i j
    exact funct2E_nonempty e he j
  · intro α
    change singleEq 4 (funct2H v u) (funct2E e) α ↔
      Solves (singleEqSystem 4 (funct2H v u) (funct2E e)) α
    exact (singleEq_solves 4 (funct2H v u) (funct2E e) α).symm

/-- Expressible properties are closed under pointwise equivalence. -/
lemma expressible_congr {P Q : (G → H) → Prop} (hPQ : ∀ α, P α ↔ Q α)
    (hP : ExpressibleProperty P) : ExpressibleProperty Q := by
  rcases hP with ⟨S, hE, hiff⟩
  refine ⟨S, hE, ?_⟩
  intro α
  exact (hPQ α).symm.trans (hiff α)

/-- Under the alternating law, the (funct-2) equation for `u` is equivalent to fiber
preservation along `u`; hence `boolAltDir ∧ pairdir u` is expressible. -/
theorem boolAltPairDir_expressible_of_alt (e : ℕ) (he : 1 ≤ e) (v u : G) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      boolAltDir e v α ∧ boolAltPairDir e v u α) := by
  have h1 : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      boolAltDir e v α ∧ funct2Eq e v u α) := by
    exact expressible_conj (boolAltDir_expressible (e := e) (v := v))
      (funct2Eq_expressible e he v u)
  refine expressible_congr (P := fun α : G → ZMod (2 ^ (e + 1)) =>
      boolAltDir e v α ∧ funct2Eq e v u α) ?_ h1
  intro α
  constructor
  · intro h
    exact ⟨h.1, boolAltPairDir_of_funct2Eq e v u α h.1 h.2⟩
  · intro h
    exact ⟨h.1, funct2Eq_of_boolAltPairDir e he v u α h.1 h.2⟩

/-- In `Fin (n+1)`, quantification splits into the first `n` entries and the last. -/
lemma forall_fin_succ {n : ℕ} {Q : Fin (n + 1) → Prop} :
    (∀ i : Fin (n + 1), Q i) ↔ (∀ i : Fin n, Q (Fin.castSucc i)) ∧ Q (Fin.last n) := by
  constructor
  · intro h
    constructor
    · intro i
      exact h (Fin.castSucc i)
    · exact h (Fin.last n)
  · intro h i
    by_cases hi : i.val < n
    · have hcast : i = Fin.castSucc ⟨i.val, hi⟩ := by
        apply Fin.ext
        simp
      rw [hcast]
      exact h.1 ⟨i.val, hi⟩
    · have hlast : i = Fin.last n := by
        apply Fin.ext
        simp [Fin.last]
        omega
      rw [hlast]
      exact h.2

/-- Conjunction of expressible properties over a finite family is expressible. -/
lemma expressible_conj_fin {n : ℕ} (P : Fin n → (G → H) → Prop)
    (hP : ∀ i : Fin n, ExpressibleProperty (P i)) :
    ExpressibleProperty (fun α : G → H => ∀ i : Fin n, P i α) := by
  induction n with
  | zero =>
      refine expressible_congr (P := fun _ : G → H => True) ?_
        (fullProperty_expressible (G := G) (H := H))
      intro α
      simp
  | succ m ih =>
      let Q : Fin m → (G → H) → Prop := fun i α => P (Fin.castSucc i) α
      have hQ : ∀ i : Fin m, ExpressibleProperty (Q i) := by
        intro i
        exact hP (Fin.castSucc i)
      have h1 : ExpressibleProperty (fun α : G → H => ∀ i : Fin m, Q i α) := ih Q hQ
      have h2 : ExpressibleProperty (fun α : G → H => P (Fin.last m) α) := hP (Fin.last m)
      have hconj : ExpressibleProperty (fun α : G → H =>
          (∀ i : Fin m, Q i α) ∧ P (Fin.last m) α) := expressible_conj h1 h2
      refine expressible_congr (P := fun α : G → H =>
          (∀ i : Fin m, Q i α) ∧ P (Fin.last m) α) ?_ hconj
      intro α
      exact (forall_fin_succ (Q := fun i : Fin (m + 1) => P i α)).symm

/-- Booleanity (alternation plus fiber preservation along all generators) is
equivalent to `IsBooleanAlt`, provided the generators span `G`. -/
lemma bool_span_iff_isBooleanAlt {d : ℕ} (e : ℕ) (v : G)
    (α : G → ZMod (2 ^ (e + 1))) (gens : Fin d → G) (hspan : FiniteSpanningSet gens) :
    (boolAltDir e v α ∧ ∀ i : Fin d, boolAltPairDir e v (gens i) α) ↔ IsBooleanAlt e v α := by
  constructor
  · intro h
    exact isBooleanAlt_of_alt_fiber_spanning e v α gens hspan h.1 h.2
  · intro hb
    rcases alt_fiber_of_boolean e v α hb with ⟨hd, hall⟩
    constructor
    · exact hd
    · intro i
      exact hall (gens i)

/-- Proposition bool-expr: on a group generated by a finite family `gens`, the property
of being `(e,{a,b})`-boolean for some distinct `a,b` of opposite parity is expressible. -/
theorem bool_expr_expressible {d : ℕ} (e : ℕ) (he : 1 ≤ e) (v : G)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) => IsBooleanAlt e v α) := by
  have hAll : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      ∀ i : Fin d, (boolAltDir e v α ∧ boolAltPairDir e v (gens i) α)) := by
    refine expressible_conj_fin (P := fun i α =>
      boolAltDir e v α ∧ boolAltPairDir e v (gens i) α) ?_
    intro i
    exact boolAltPairDir_expressible_of_alt e he v (gens i)
  have hA : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      boolAltDir e v α ∧ ∀ i : Fin d, boolAltPairDir e v (gens i) α) := by
    refine expressible_congr (P := fun α : G → ZMod (2 ^ (e + 1)) =>
      ∀ i : Fin d, (boolAltDir e v α ∧ boolAltPairDir e v (gens i) α)) ?_ hAll
    intro α
    constructor
    · intro h
      constructor
      · exact (h ⟨0, hpos⟩).1
      · intro i
        exact (h i).2
    · intro h i
      exact ⟨h.1, h.2 i⟩
  refine expressible_congr (Q := fun α : G → ZMod (2 ^ (e + 1)) => IsBooleanAlt e v α)
    (P := fun α : G → ZMod (2 ^ (e + 1)) =>
      boolAltDir e v α ∧ ∀ i : Fin d, boolAltPairDir e v (gens i) α) ?_ hA
  · intro α
    exact bool_span_iff_isBooleanAlt e v α gens hspan

end
end Commons.PeriodicTiling


open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # An equation to force boolean compatibility (Lemma force-compat)

The paper's Lemma "An equation to force boolean compatibility" (tex 797-830):
in a cyclic `2`-group `ZMod (2^(e+1))` (`1 ≤ e`, i.e. the paper's `M = e+1 ≥ 2`),
if `{a,b}, {c,d}, {f,g}, {h',k'}, {h'',k''}` are pairs of opposite parity and `z`
satisfies the sum equation and the eight-representation condition, then
`{a,b}, {h',k'}, {h'',k''}` are translates of each other.

Following the paper, the proof normalises `a = h' = h'' = c = f = z = 0` by
translation and reduces to: odd `b, k', k'', d, g` with `b + k' + k'' = 2d + g` and
every element of `{0,b} × {0,k'} × {0,k''}` representable as `2β + γ` with
`β ∈ {0,d}`, `γ ∈ {0,g}`; then `b,k',k'' ∈ {g, g+2d}`, and the two parity cases
force either all equal or `g + 2d = -g`.

This file develops the translate-relation layer and the normalized-core algebra. -/


/-! ## Parity of `ZMod (2^(e+1))` via the canonical value

The parity extractor `parityIn e` is the reduction modulo `2`; hence membership in the
even subgroup is evenness of the canonical value, odd elements are exactly the values
with odd `val`, and odd elements are units (used to show `2 * g ≠ 0` for odd `g`). -/

/-- `parityIn e z` is the reduction of `z.val` modulo `2`. -/
lemma parityIn_eq_val (e : ℕ) (z : ZMod (2 ^ (e + 1))) : parityIn e z = (z.val : ZMod 2) := by
  unfold parityIn parHom
  simp

/-- Membership in the even subgroup is evenness of the canonical value. -/
lemma mem_evenSub_iff_even_val (e : ℕ) (z : ZMod (2 ^ (e + 1))) : z ∈ evenSub e ↔ Even z.val := by
  rw [← parityIn_zero_iff_even]
  constructor
  · intro h
    have hz := congrArg ZMod.val h
    rw [parityIn_eq_val] at hz
    change (↑z.val : ZMod 2).val = 0 at hz
    rw [ZMod.val_natCast] at hz
    exact Nat.even_iff.mpr hz
  · intro h
    have hz : z.val % 2 = 0 := Nat.even_iff.mp h
    exact (ZMod.val_injective (n := 2)) (by
      rw [parityIn_eq_val]
      change (↑z.val : ZMod 2).val = 0
      rw [ZMod.val_natCast]
      exact hz)

/-- Outside the even subgroup means the canonical value is odd. -/
lemma odd_val_of_not_mem_evenSub (e : ℕ) (z : ZMod (2 ^ (e + 1))) (hz : z ∉ evenSub e) :
    Odd z.val := by
  have hpar := parityIn_of_not_mem_evenSub e hz
  have hzval := congrArg ZMod.val hpar
  rw [parityIn_eq_val] at hzval
  change (↑z.val : ZMod 2).val = 1 at hzval
  rw [ZMod.val_natCast] at hzval
  exact Nat.odd_iff.mpr hzval

/-- Odd elements of `ZMod (2^(e+1))` are units. -/
lemma isUnit_of_not_mem_evenSub (e : ℕ) (g : ZMod (2 ^ (e + 1))) (hg : g ∉ evenSub e) :
    IsUnit g := by
  rw [← ZMod.natCast_zmod_val g]
  apply (ZMod.isUnit_iff_coprime g.val (2 ^ (e + 1))).mpr
  have hodd := odd_val_of_not_mem_evenSub e g hg
  rcases hodd with ⟨m, hm⟩
  rw [hm]
  rw [Nat.coprime_pow_right_iff (by omega : 0 < e + 1)]
  exact Nat.coprime_two_right.mpr ⟨m, rfl⟩

/-- For `e ≥ 1` an odd element is not annihilated by `2`. -/
lemma two_mul_ne_zero_of_not_mem_evenSub (e : ℕ) (he : 1 ≤ e) (g : ZMod (2 ^ (e + 1)))
    (hg : g ∉ evenSub e) : 2 * g ≠ 0 := by
  intro hz
  rcases isUnit_of_not_mem_evenSub e g hg with ⟨u, hu⟩
  have hz1 : (2 : ZMod (2 ^ (e + 1))) * (↑u : ZMod (2 ^ (e + 1))) = 0 := by
    rwa [hu.symm] at hz
  have hu1 : (↑u : ZMod (2 ^ (e + 1))) * (↑(u⁻¹) : ZMod (2 ^ (e + 1))) = 1 := by
    rw [← Units.val_mul]
    simp
  have hprod : (2 : ZMod (2 ^ (e + 1))) * (↑u : ZMod (2 ^ (e + 1))) *
      (↑(u⁻¹) : ZMod (2 ^ (e + 1))) = 0 := by
    rw [hz1]
    ring
  have h2 : (2 : ZMod (2 ^ (e + 1))) = 0 := by
    calc
      (2 : ZMod (2 ^ (e + 1))) =
          (2 : ZMod (2 ^ (e + 1))) * (↑u : ZMod (2 ^ (e + 1))) *
            (↑(u⁻¹) : ZMod (2 ^ (e + 1))) := by
        rw [show (2 : ZMod (2 ^ (e + 1))) * (↑u : ZMod (2 ^ (e + 1))) * (↑(u⁻¹) : ZMod (2 ^ (e + 1))) =
            (2 : ZMod (2 ^ (e + 1))) * ((↑u : ZMod (2 ^ (e + 1))) * (↑(u⁻¹) : ZMod (2 ^ (e + 1)))) by ring]
        rw [hu1]
        ring
      _ = 0 := hprod
  have h2ne : (2 : ZMod (2 ^ (e + 1))) ≠ 0 := by
    intro h
    have hnat : ((2 : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by simpa using h
    have hd : 2 ^ (e + 1) ∣ 2 := (ZMod.natCast_eq_zero_iff 2 (2 ^ (e + 1))).mp hnat
    have hpow : 4 ≤ 2 ^ (e + 1) := by
      have h2 : 2 ≤ e + 1 := by omega
      have hp := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h2
      norm_num at hp
      exact hp
    have hle : 2 ^ (e + 1) ≤ 2 := Nat.le_of_dvd (by norm_num : 0 < 2) hd
    omega
  exact h2ne h2

/-- In `ZMod 2`, doubling is zero. -/
lemma zmod2_add_self (x : ZMod 2) : x + x = 0 := by
  rcases (zmod2_eq_zero_or_one x) with rfl | rfl <;> decide

/-- `2 * d` is even. -/
lemma two_mul_mem_evenSub (e : ℕ) (d : ZMod (2 ^ (e + 1))) : 2 * d ∈ evenSub e := by
  rw [← parityIn_zero_iff_even]
  have h2 : (2 : ZMod (2 ^ (e + 1))) * d = d + d := by ring
  rw [h2]
  dsimp [parityIn]
  rw [map_add]
  exact zmod2_add_self (parHom e d)

variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]

/-- `B` is a translate of `A` (as colour sets). -/
def PairTranslate {Z : Type*} [AddCommGroup Z] (A B : Set Z) : Prop :=
  ∃ t : Z, B = t + A

/-- Membership in a translate: `z ∈ t + A` iff `z = t + a` for some `a ∈ A`. -/
lemma mem_add_element {Z : Type*} [AddCommGroup Z] (t : Z) (A : Set Z) (z : Z) :
    z ∈ t + A ↔ ∃ a ∈ A, z = t + a := by
  change z ∈ ({t} : Set Z) + A ↔ ∃ a ∈ A, z = t + a
  rw [Set.mem_add]
  constructor
  · intro h
    rcases h with ⟨u, hu, a, ha, hsum⟩
    simp at hu
    subst u
    exact ⟨a, ha, hsum.symm⟩
  · intro h
    rcases h with ⟨a, ha, hz⟩
    exact ⟨t, by simp, a, ha, hz.symm⟩

/-- Membership in a translate of a translate. -/
lemma mem_add_add_element {Z : Type*} [AddCommGroup Z] (s t : Z) (A : Set Z) (z : Z) :
    z ∈ s + (t + A) ↔ ∃ a ∈ A, z = s + t + a := by
  rw [mem_add_element]
  constructor
  · intro h
    rcases h with ⟨w, hw, hz⟩
    rw [mem_add_element] at hw
    rcases hw with ⟨a, ha, hwa⟩
    refine ⟨a, ha, ?_⟩
    calc z = s + w := hz
      _ = s + (t + a) := by rw [hwa]
      _ = s + t + a := by abel
  · intro h
    rcases h with ⟨a, ha, hz⟩
    refine ⟨t + a, ?_, ?_⟩
    · rw [mem_add_element]
      exact ⟨a, ha, rfl⟩
    · calc z = s + t + a := hz
      _ = s + (t + a) := by abel

/-- Translation by a sum is composition of translations. -/
lemma add_add_element {Z : Type*} [AddCommGroup Z] (s t : Z) (A : Set Z) :
    t + (s + A) = (t + s) + A := by
  ext z
  rw [mem_add_add_element, mem_add_element]

/-- Translation is reflexive. -/
lemma pairTranslate_refl {Z : Type*} [AddCommGroup Z] (A : Set Z) : PairTranslate A A := by
  refine ⟨0, ?_⟩
  ext z
  rw [mem_add_element]
  constructor
  · intro hz
    refine ⟨z, hz, by simp⟩
  · intro h
    rcases h with ⟨a, ha, hz0⟩
    have hza : z = a := by
      rw [hz0]
      simp
    simpa [hza] using ha

/-- Translation is symmetric. -/
lemma pairTranslate_symm {Z : Type*} [AddCommGroup Z] {A B : Set Z} (h : PairTranslate A B) :
    PairTranslate B A := by
  rcases h with ⟨t, ht⟩
  refine ⟨-t, ?_⟩
  ext z
  constructor
  · intro hz
    rw [ht]
    rw [mem_add_add_element]
    exact ⟨z, hz, by abel⟩
  · intro hz
    rw [ht] at hz
    rw [mem_add_add_element] at hz
    rcases hz with ⟨a, ha, hz0⟩
    have hza : z = a := by
      rw [hz0]
      abel
    simpa [hza] using ha

/-- Translation is transitive. -/
lemma pairTranslate_trans {Z : Type*} [AddCommGroup Z] {A B C : Set Z}
    (hAB : PairTranslate A B) (hBC : PairTranslate B C) : PairTranslate A C := by
  rcases hAB with ⟨s, hs⟩
  rcases hBC with ⟨t, ht⟩
  refine ⟨t + s, ?_⟩
  calc C = t + B := ht
    _ = t + (s + A) := by rw [hs]
    _ = (t + s) + A := add_add_element s t A

/-- If `c = b` or `c = -b` then `{0,b}` and `{0,c}` are translates. -/
lemma pairTranslate_zero_pair {Z : Type*} [AddCommGroup Z] {b c : Z} (hc : c = b ∨ c = -b) :
    PairTranslate ({0, b} : Set Z) ({0, c} : Set Z) := by
  rcases hc with hcb | hcb
  · refine ⟨0, ?_⟩
    rw [hcb]
    ext z
    rw [mem_add_element]
    simp
  · refine ⟨-b, ?_⟩
    rw [hcb]
    ext z
    constructor
    · intro hz
      rw [mem_add_element]
      simp at hz
      rcases hz with hz0 | hzneg
      · refine ⟨b, by simp, ?_⟩
        rw [hz0]
        abel
      · refine ⟨0, by simp, ?_⟩
        simpa [hzneg]
    · intro hz
      rw [mem_add_element] at hz
      rcases hz with ⟨a, ha, hz0⟩
      simp at ha
      change z = 0 ∨ z = -b
      rcases ha with ha0 | hab
      · right
        rw [ha0] at hz0
        simpa using hz0
      · left
        rw [hab] at hz0
        rw [hz0]
        abel



/-! ## The normalized core: membership of the odd values in `{0, 2d, g, 2d+g}`

Work in `Z = ZMod (2^(e+1))`.  After the paper's normalization
(`a = h' = h'' = c = f = z = 0`) the representation condition says: every triple
`(α, τ, τ') ∈ {0,b} × {0,k'} × {0,k''}` has `(β, γ) ∈ {0,d} × {0,g}` with
`α + τ + τ' = 2β + γ`.  Taking the triples `(b,0,0)`, `(0,k',0)`, `(0,0,k'')`
gives `b, k', k'' ∈ {0, 2d, g, 2d+g}`. -/

/-- From `v = 2β + γ` with `β ∈ {0,d}`, `γ ∈ {0,g}`: `v ∈ {0, 2d, g, 2d+g}`. -/
lemma two_val_mem_four {Z : Type*} [CommRing Z] {d g β γ v : Z}
    (hβ : β = 0 ∨ β = d) (hγ : γ = 0 ∨ γ = g) (hv : v = 2 * β + γ) :
    v ∈ ({0, 2 * d, g, 2 * d + g} : Set Z) := by
  rcases hβ with hβ0 | hβd
  · rcases hγ with hγ0 | hγg
    · have h : v = 0 := by rw [hv, hβ0, hγ0]; ring
      simp [h]
    · have h : v = g := by rw [hv, hβ0, hγg]; ring
      simp [h]
  · rcases hγ with hγ0 | hγg
    · have h : v = 2 * d := by rw [hv, hβd, hγ0]; ring
      simp [h]
    · have h : v = 2 * d + g := by rw [hv, hβd, hγg]
      simp [h]

/-- From the normalized representation condition, each of `b, k', k''` lies in
`{0, 2d, g, 2d+g}`. -/
lemma normalized_rep_membership (e : ℕ) {b k' k'' d g : ZMod (2 ^ (e + 1))}
    (href : ∀ α ∈ ({0, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ τ ∈ ({0, k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ τ' ∈ ({0, k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ β ∈ ({0, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γ ∈ ({0, g} : Set (ZMod (2 ^ (e + 1)))),
              α + τ + τ' = 2 * β + γ) :
    b ∈ ({0, 2 * d, g, 2 * d + g} : Set (ZMod (2 ^ (e + 1)))) ∧
    k' ∈ ({0, 2 * d, g, 2 * d + g} : Set (ZMod (2 ^ (e + 1)))) ∧
    k'' ∈ ({0, 2 * d, g, 2 * d + g} : Set (ZMod (2 ^ (e + 1)))) := by
  let Z := ZMod (2 ^ (e + 1))
  constructor
  · rcases href b (by simp) (0 : Z) (by simp) (0 : Z) (by simp) with ⟨β, hβ, γ, hγ, heq⟩
    have heq' : b = 2 * β + γ := by simpa using heq
    have hmem : b ∈ ({0, 2 * d, g, 2 * d + g} : Set Z) := by
      apply two_val_mem_four (v := b)
      · simp at hβ
        exact hβ
      · simp at hγ
        exact hγ
      · exact heq'
    simpa [Z] using hmem
  · constructor
    · rcases href (0 : Z) (by simp) k' (by simp) (0 : Z) (by simp) with ⟨β, hβ, γ, hγ, heq⟩
      have heq' : k' = 2 * β + γ := by simpa using heq
      have hmem : k' ∈ ({0, 2 * d, g, 2 * d + g} : Set Z) := by
        apply two_val_mem_four (v := k')
        · simp at hβ
          exact hβ
        · simp at hγ
          exact hγ
        · exact heq'
      simpa [Z] using hmem
    · rcases href (0 : Z) (by simp) (0 : Z) (by simp) k'' (by simp) with ⟨β, hβ, γ, hγ, heq⟩
      have heq' : k'' = 2 * β + γ := by simpa using heq
      have hmem : k'' ∈ ({0, 2 * d, g, 2 * d + g} : Set Z) := by
        apply two_val_mem_four (v := k'')
        · simp at hβ
          exact hβ
        · simp at hγ
          exact hγ
        · exact heq'
      simpa [Z] using hmem

/-! ## Exclusion of the even values, and the parity case analysis

An odd element of `{0, 2d, g, 2d+g}` cannot be `0` or `2d` (both even), so it lies in
`{g, 2d+g}`.  Given `b, k', k'' ∈ {g, 2d+g}` with `b + k' + k'' = 2d + g` and `g`
odd: either all three are equal, or `2d+g = -g` (the two remaining mixed parity
configurations: two values equal to `g` are impossible since they would force
`2g = 0`; one value equal to `g` forces `2d+g = -g`). -/

/-- An odd element of `{0, 2d, g, 2d+g}` lies in `{g, 2d+g}`. -/
lemma odd_mem_four_reduce (e : ℕ) {v d g : ZMod (2 ^ (e + 1))}
    (hv : v ∈ ({0, 2 * d, g, 2 * d + g} : Set (ZMod (2 ^ (e + 1)))))
    (hodd : v ∉ evenSub e) : v = g ∨ v = 2 * d + g := by
  simp at hv
  rcases hv with h0 | h2d | hg | h2dg
  · exfalso
    apply hodd
    rw [h0]
    exact zero_mem (evenSub e)
  · exfalso
    apply hodd
    rw [h2d]
    exact two_mul_mem_evenSub e d
  · exact Or.inl hg
  · exact Or.inr h2dg

/-- Mixed case analysis of three values in `{g, 2d+g}` with sum `2d+g`. -/
lemma odd_three_sum_mixed (e : ℕ) (he : 1 ≤ e) {b k' k'' d g : ZMod (2 ^ (e + 1))}
    (hg : g ∉ evenSub e)
    (hb : b = g ∨ b = 2 * d + g) (hk' : k' = g ∨ k' = 2 * d + g)
    (hk'' : k'' = g ∨ k'' = 2 * d + g)
    (hsum : b + k' + k'' = 2 * d + g) :
    (b = k' ∧ k' = k'') ∨ (2 * d + g = -g) := by
  rcases hb with hb1 | hb1
  · -- b = g
    rcases hk' with hk'1 | hk'1
    · -- k' = g
      rcases hk'' with hk''1 | hk''1
      · left
        constructor
        · rw [hb1, hk'1]
        · rw [hk'1, hk''1]
      · exfalso
        -- two g's, one 2d+g: 2g = 0, contradiction
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have h2g : (2 : ZMod (2 ^ (e + 1))) * g = 0 := by
          calc
            (2 : ZMod (2 ^ (e + 1))) * g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        exact two_mul_ne_zero_of_not_mem_evenSub e he g hg h2g
    · -- k' = 2d+g
      rcases hk'' with hk''1 | hk''1
      · exfalso
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have h2g : (2 : ZMod (2 ^ (e + 1))) * g = 0 := by
          calc
            (2 : ZMod (2 ^ (e + 1))) * g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        exact two_mul_ne_zero_of_not_mem_evenSub e he g hg h2g
      · right
        -- b = g, k' = k'' = 2d+g: 2d+g = -g
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have hz : (2 * d + g) + g = 0 := by
          calc
            (2 * d + g) + g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        calc
          (2 * d + g) = (2 * d + g) + g + (-g) := by ring
          _ = 0 + (-g) := by rw [hz]
          _ = -g := by ring
  · -- b = 2d+g
    rcases hk' with hk'1 | hk'1
    · -- k' = g
      rcases hk'' with hk''1 | hk''1
      · exfalso
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have h2g : (2 : ZMod (2 ^ (e + 1))) * g = 0 := by
          calc
            (2 : ZMod (2 ^ (e + 1))) * g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        exact two_mul_ne_zero_of_not_mem_evenSub e he g hg h2g
      · right
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have hz : (2 * d + g) + g = 0 := by
          calc
            (2 * d + g) + g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        calc
          (2 * d + g) = (2 * d + g) + g + (-g) := by ring
          _ = 0 + (-g) := by rw [hz]
          _ = -g := by ring
    · -- k' = 2d+g
      rcases hk'' with hk''1 | hk''1
      · right
        have hs := hsum
        rw [hb1, hk'1, hk''1] at hs
        have hz : (2 * d + g) + g = 0 := by
          calc
            (2 * d + g) + g = (b + k' + k'') - (2 * d + g) := by
              rw [hb1, hk'1, hk''1]
              ring
            _ = 0 := by
              rw [hsum]
              ring
        calc
          (2 * d + g) = (2 * d + g) + g + (-g) := by ring
          _ = 0 + (-g) := by rw [hz]
          _ = -g := by ring
      · left
        constructor
        · rw [hb1, hk'1]
        · rw [hk'1, hk''1]

/-! ## The normalized force-compat lemma

With `a = h' = h'' = c = f = z = 0` (the paper's normalization), the hypotheses
reduce to: odd `b, k', k'', g` satisfying the sum equation and the representation
condition; conclusion: `{0,b}`, `{0,k'}`, `{0,k''}` are pairwise translates. -/

/-- The normalized form of Lemma force-compat. -/
lemma normalized_force_compat (e : ℕ) (he : 1 ≤ e)
    {b k' k'' d g : ZMod (2 ^ (e + 1))}
    (hb : b ∉ evenSub e) (hk' : k' ∉ evenSub e) (hk'' : k'' ∉ evenSub e)
    (hg : g ∉ evenSub e)
    (hsum : b + k' + k'' = 2 * d + g)
    (href : ∀ α ∈ ({0, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ τ ∈ ({0, k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ τ' ∈ ({0, k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ β ∈ ({0, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γ ∈ ({0, g} : Set (ZMod (2 ^ (e + 1)))),
              α + τ + τ' = 2 * β + γ) :
    PairTranslate ({0, b} : Set (ZMod (2 ^ (e + 1))))
      ({0, k'} : Set (ZMod (2 ^ (e + 1)))) ∧
    PairTranslate ({0, k'} : Set (ZMod (2 ^ (e + 1))))
      ({0, k''} : Set (ZMod (2 ^ (e + 1)))) := by
  have hmem := normalized_rep_membership e href
  have hb2 : b = g ∨ b = 2 * d + g := odd_mem_four_reduce e hmem.1 hb
  have hk'2 : k' = g ∨ k' = 2 * d + g := odd_mem_four_reduce e hmem.2.1 hk'
  have hk''2 : k'' = g ∨ k'' = 2 * d + g := odd_mem_four_reduce e hmem.2.2 hk''
  have hmixed := odd_three_sum_mixed e he hg hb2 hk'2 hk''2 hsum
  rcases hmixed with hsame | hneg
  · constructor
    · rw [hsame.1]
      exact pairTranslate_refl ({0, k'} : Set (ZMod (2 ^ (e + 1))))
    · rw [hsame.2]
      exact pairTranslate_refl ({0, k''} : Set (ZMod (2 ^ (e + 1))))
  · have hb3 : PairTranslate ({0, g} : Set (ZMod (2 ^ (e + 1))))
        ({0, b} : Set (ZMod (2 ^ (e + 1)))) := by
      apply pairTranslate_zero_pair (b := g) (c := b)
      rcases hb2 with h1 | h2
      · exact Or.inl h1
      · exact Or.inr (h2.trans hneg)
    have hk'3 : PairTranslate ({0, g} : Set (ZMod (2 ^ (e + 1))))
        ({0, k'} : Set (ZMod (2 ^ (e + 1)))) := by
      apply pairTranslate_zero_pair (b := g) (c := k')
      rcases hk'2 with h1 | h2
      · exact Or.inl h1
      · exact Or.inr (h2.trans hneg)
    have hk''3 : PairTranslate ({0, g} : Set (ZMod (2 ^ (e + 1))))
        ({0, k''} : Set (ZMod (2 ^ (e + 1)))) := by
      apply pairTranslate_zero_pair (b := g) (c := k'')
      rcases hk''2 with h1 | h2
      · exact Or.inl h1
      · exact Or.inr (h2.trans hneg)
    constructor
    · exact pairTranslate_trans (pairTranslate_symm hb3) hk'3
    · exact pairTranslate_trans (pairTranslate_symm hk'3) hk''3


/-! ## Transport lemmas for the general reduction

To reduce the general (untranslated) statement to the normalized one we need: the
translate relation is invariant under simultaneous translation of both sets, any two
translates of the same set are translates, two-element sets identify with translates
of `{0, ·}`, and oddness is preserved under translation by an even element. -/

/-- `PairTranslate` is preserved by translating both sets by the same element. -/
lemma pairTranslate_add_left {Z : Type*} [AddCommGroup Z] {A B : Set Z} (t : Z)
    (h : PairTranslate A B) : PairTranslate (t + A) (t + B) := by
  rcases h with ⟨s, hs⟩
  refine ⟨s, ?_⟩
  calc t + B = t + (s + A) := by rw [hs]
    _ = (t + s) + A := add_add_element s t A
    _ = (s + t) + A := by rw [add_comm]
    _ = s + (t + A) := (add_add_element t s A).symm

/-- Any two translates of the same set are translates of each other. -/
lemma pairTranslate_translates {Z : Type*} [AddCommGroup Z] (t₁ t₂ : Z) (A : Set Z) :
    PairTranslate (t₁ + A) (t₂ + A) := by
  refine ⟨t₂ - t₁, ?_⟩
  ext z
  constructor
  · intro hz
    rw [mem_add_add_element]
    rw [mem_add_element] at hz
    rcases hz with ⟨a, ha, hz0⟩
    refine ⟨a, ha, ?_⟩
    rw [hz0]
    abel
  · intro hz
    rw [mem_add_element]
    rw [mem_add_add_element] at hz
    rcases hz with ⟨a, ha, hz0⟩
    refine ⟨a, ha, ?_⟩
    rw [hz0]
    abel

/-- A two-element set is the translate `a + {0, b-a}`. -/
lemma pair_set_eq_add {Z : Type*} [AddCommGroup Z] (a b : Z) :
    ({a, b} : Set Z) = a + ({0, b - a} : Set Z) := by
  ext z
  rw [mem_add_element]
  constructor
  · intro hz
    simp at hz
    rcases hz with hza | hzb
    · refine ⟨0, by simp, ?_⟩
      calc z = a := hza
        _ = a + 0 := by simp
    · refine ⟨b - a, by simp, ?_⟩
      calc z = b := hzb
        _ = a + (b - a) := by abel
  · intro hz
    rcases hz with ⟨w, hw, hz0⟩
    simp at hw
    rcases hw with hw0 | hwba
    · rw [hz0, hw0]
      simp
    · rw [hz0, hwba]
      change a + (b - a) = a ∨ a + (b - a) = b
      right
      abel

/-- Translating a two-element set `{0,b}` by `a` gives `{a, a+b}`. -/
lemma pair_set_add {Z : Type*} [AddCommGroup Z] (a b : Z) :
    a + ({0, b} : Set Z) = ({a, a + b} : Set Z) := by
  ext z
  rw [mem_add_element]
  constructor
  · intro hz
    rcases hz with ⟨w, hw, hz0⟩
    simp at hw
    rcases hw with hw0 | hwb
    · rw [hz0, hw0]
      simp
    · rw [hz0, hwb]
      simp
  · intro hz
    simp at hz
    rcases hz with hza | hzab
    · refine ⟨0, by simp, ?_⟩
      calc z = a := hza
        _ = a + 0 := by simp
    · refine ⟨b, by simp, ?_⟩
      calc z = a + b := hzab
        _ = a + b := rfl

/-- Oddness is preserved under translating by an even element. -/
lemma not_evenSub_sub_of_not_evenSub {Z : Type*} [AddCommGroup Z] {S : AddSubgroup Z}
    {b a : Z} (hb : b ∉ S) (ha : a ∈ S) : b - a ∉ S := by
  intro h
  apply hb
  have hba : b = (b - a) + a := by abel
  rw [hba]
  exact S.add_mem h ha

/-- Oddness is preserved under translating by an even element (symmetric form). -/
lemma not_evenSub_of_sub_not_evenSub {Z : Type*} [AddCommGroup Z] {S : AddSubgroup Z}
    {b a : Z} (hb : b - a ∉ S) (ha : a ∈ S) : b ∉ S := by
  intro h
  apply hb
  have hba : b - a = b + (-a) := by abel
  rw [hba]
  exact S.add_mem h (S.neg_mem ha)


/-! ## The general reduction (stage 1 and the universal shift identity)

Stage 1 translates the three target pairs by `-a`, `-h'`, `-h''` (and `z` by the
total shift), reducing membership ranges to `{0, b-a}`, `{0, k'-h'}`, `{0, k''-h''}`
while keeping the `(β,γ)`-ranges `{c,d}`, `{f,g}` fixed.  The universal identity
`{c,d} = β + {0, c+d-(β+β)}` (valid for `β ∈ {c,d}`) makes the stage-2 shift
`β ↦ β - beta0` independent of which of `c`, `d` the witness `beta0` equals. -/

/-- Translating the three pairs of the representation condition (stage 1). -/
lemma rep_translate (e : ℕ) {a b c d f g h' k' h'' k'' z : ZMod (2 ^ (e + 1))}
    (href : ∀ α ∈ ({a, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ τ ∈ ({h', k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ τ' ∈ ({h'', k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ β ∈ ({c, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γ ∈ ({f, g} : Set (ZMod (2 ^ (e + 1)))),
              α + τ + τ' = 2 * β + γ + z) :
    ∀ α0 ∈ ({0, b - a} : Set (ZMod (2 ^ (e + 1)))),
      ∀ τ0 ∈ ({0, k' - h'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ τ'0 ∈ ({0, k'' - h''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ β ∈ ({c, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γ ∈ ({f, g} : Set (ZMod (2 ^ (e + 1)))),
              α0 + τ0 + τ'0 = 2 * β + γ + (z - a - h' - h'') := by
  intro α0 hα0 τ0 hτ0 τ'0 hτ'0
  have hα : α0 + a ∈ ({a, b} : Set (ZMod (2 ^ (e + 1)))) := by
    simp at hα0 ⊢
    rcases hα0 with rfl | hα0b
    · simp
    · right
      rw [hα0b]
      abel
  have hτ : τ0 + h' ∈ ({h', k'} : Set (ZMod (2 ^ (e + 1)))) := by
    simp at hτ0 ⊢
    rcases hτ0 with rfl | hτ0b
    · simp
    · right
      rw [hτ0b]
      abel
  have hτ' : τ'0 + h'' ∈ ({h'', k''} : Set (ZMod (2 ^ (e + 1)))) := by
    simp at hτ'0 ⊢
    rcases hτ'0 with rfl | hτ'0b
    · simp
    · right
      rw [hτ'0b]
      abel
  rcases href (α0 + a) hα (τ0 + h') hτ (τ'0 + h'') hτ' with ⟨β, hβ, γ, hγ, heq⟩
  refine ⟨β, hβ, γ, hγ, ?_⟩
  calc
    α0 + τ0 + τ'0 = (α0 + a) + (τ0 + h') + (τ'0 + h'') - (a + h' + h'') := by abel
    _ = (2 * β + γ + z) - (a + h' + h'') := by rw [heq]
    _ = 2 * β + γ + (z - a - h' - h'') := by abel

/-- Translating the sum equation (stage 1). -/
lemma sum_translate (e : ℕ) {a b c d f g h' k' h'' k'' z : ZMod (2 ^ (e + 1))}
    (hsum : (a + b) + (h' + k') + (h'' + k'') = 2 * (c + d) + (f + g) + 2 * z) :
    (b - a) + (k' - h') + (k'' - h'') =
      2 * (c + d) + (f + g) + 2 * (z - a - h' - h'') := by
  calc
    (b - a) + (k' - h') + (k'' - h'') =
        ((a + b) + (h' + k') + (h'' + k'')) - 2 * (a + h' + h'') := by ring
    _ = (2 * (c + d) + (f + g) + 2 * z) - 2 * (a + h' + h'') := by rw [hsum]
    _ = 2 * (c + d) + (f + g) + 2 * (z - a - h' - h'') := by ring

/-- For `β ∈ {c,d}` the pair is the translate `β + {0, c+d-(β+β)}`. -/
lemma pair_eq_shift_of_mem {Z : Type*} [AddCommGroup Z] {c d β : Z}
    (hβ : β ∈ ({c, d} : Set Z)) :
    ({c, d} : Set Z) = β + ({0, c + d - (β + β)} : Set Z) := by
  simp at hβ
  rcases hβ with hβc | hβd
  · rw [hβc]
    have h := pair_set_eq_add c d
    rw [h]
    congr 1
    ext z
    simp
  · rw [hβd]
    have h := pair_set_eq_add d c
    -- {c,d} = {d,c} = d + {0, c-d}
    rw [show ({c, d} : Set Z) = ({d, c} : Set Z) by ext z; simp; tauto]
    rw [h]
    congr 1
    ext z
    simp

/-- Negating a non-even element keeps it non-even. -/
lemma neg_not_evenSub {Z : Type*} [AddCommGroup Z] {S : AddSubgroup Z} {x : Z}
    (hx : x ∉ S) : -x ∉ S := by
  intro h
  exact hx (by simpa using (S.neg_mem h))

/-- The stage-2 shifted odd value `f + g - (γ + γ)` is odd, for `γ ∈ {f,g}` with
`f` even and `g` odd. -/
lemma shifted_g_not_evenSub (e : ℕ) {f g γ : ZMod (2 ^ (e + 1))}
    (hf : f ∈ evenSub e) (hg : g ∉ evenSub e) (hγ : γ ∈ ({f, g} : Set (ZMod (2 ^ (e + 1))))) :
    f + g - (γ + γ) ∉ evenSub e := by
  simp at hγ
  rcases hγ with hγf | hγg
  · have hgf : g - f ∉ evenSub e := not_evenSub_sub_of_not_evenSub hg hf
    have hval : f + g - (γ + γ) = g - f := by
      rw [hγf]
      abel
    rwa [hval]
  · have hgf : g - f ∉ evenSub e := not_evenSub_sub_of_not_evenSub hg hf
    have hfg : f - g ∉ evenSub e := by
      intro h
      have hneg : -(f - g) ∈ evenSub e := (evenSub e).neg_mem h
      exact hgf (by simpa [neg_sub] using hneg)
    have hval : f + g - (γ + γ) = f - g := by
      rw [hγg]
      abel
    rwa [hval]


/-! ## The general force-compat lemma

Statement of the paper's Lemma "An equation to force boolean compatibility"
(tex 797-830), with the pairs oriented as (even, odd) via `evenSub`.  Proof: translate
the target pairs to be `{0, b-a}`, `{0, k'-h'}`, `{0, k''-h''}` (stage 1), shift the
`(β,γ)`-pairs by the witnesses `beta0`, `gamma0` (stage 2), apply `normalized_force_compat`,
and translate the conclusion back. -/

/-- Lemma force-compat: opposite-parity pairs `{a,b}`, `{h',k'}`, `{h'',k''}` obeying
the sum equation and the eight-representation condition are translates of each other. -/
theorem force_compat (e : ℕ) (he : 1 ≤ e)
    {a b c d f g h' k' h'' k'' z : ZMod (2 ^ (e + 1))}
    (ha : a ∈ evenSub e) (hb : b ∉ evenSub e)
    (hc : c ∈ evenSub e) (hd : d ∉ evenSub e)
    (hf : f ∈ evenSub e) (hg : g ∉ evenSub e)
    (hh' : h' ∈ evenSub e) (hk' : k' ∉ evenSub e)
    (hh'' : h'' ∈ evenSub e) (hk'' : k'' ∉ evenSub e)
    (hsum : (a + b) + (h' + k') + (h'' + k'') = 2 * (c + d) + (f + g) + 2 * z)
    (href : ∀ α ∈ ({a, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ τ ∈ ({h', k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ τ' ∈ ({h'', k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ β ∈ ({c, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γ ∈ ({f, g} : Set (ZMod (2 ^ (e + 1)))),
              α + τ + τ' = 2 * β + γ + z) :
    PairTranslate ({a, b} : Set (ZMod (2 ^ (e + 1))))
      ({h', k'} : Set (ZMod (2 ^ (e + 1)))) ∧
    PairTranslate ({h', k'} : Set (ZMod (2 ^ (e + 1))))
      ({h'', k''} : Set (ZMod (2 ^ (e + 1)))) := by
  let Z := ZMod (2 ^ (e + 1))
  -- stage 1: translate the three target pairs by -a, -h', -h'' (and z accordingly)
  have href0 : ∀ α0 ∈ ({0, b - a} : Set Z),
      ∀ τ0 ∈ ({0, k' - h'} : Set Z),
        ∀ τ'0 ∈ ({0, k'' - h''} : Set Z),
          ∃ β ∈ ({c, d} : Set Z),
            ∃ γ ∈ ({f, g} : Set Z),
              α0 + τ0 + τ'0 = 2 * β + γ + (z - a - h' - h'') := by
    simpa [Z] using rep_translate (e := e) (a := a) (b := b) (c := c) (d := d) (f := f)
      (g := g) (h' := h') (k' := k') (h'' := h'') (k'' := k'') (z := z) href
  have hsum0 : (b - a) + (k' - h') + (k'' - h'') =
      2 * (c + d) + (f + g) + 2 * (z - a - h' - h'') := by
    simpa [Z] using sum_translate (e := e) (a := a) (b := b) (c := c) (d := d) (f := f)
      (g := g) (h' := h') (k' := k') (h'' := h'') (k'' := k'') (z := z) hsum
  -- stage 2: witnesses at the triple (0,0,0)
  rcases href0 (0 : Z) (by simp) (0 : Z) (by simp) (0 : Z) (by simp) with ⟨beta0, hbeta0, gamma0, hgamma0, heq0⟩
  have hzero : 2 * beta0 + gamma0 + (z - a - h' - h'') = 0 := by
    simpa using heq0.symm
  let d0 : Z := c + d - (beta0 + beta0)
  let g0 : Z := f + g - (gamma0 + gamma0)
  -- oddness of the normalized odd values
  have hb0 : b - a ∉ evenSub e := not_evenSub_sub_of_not_evenSub hb ha
  have hk0' : k' - h' ∉ evenSub e := not_evenSub_sub_of_not_evenSub hk' hh'
  have hk0'' : k'' - h'' ∉ evenSub e := not_evenSub_sub_of_not_evenSub hk'' hh''
  have hg0 : g0 ∉ evenSub e := by
    dsimp [g0]
    exact shifted_g_not_evenSub e hf hg hgamma0
  -- normalized sum equation
  have hsum1 : (b - a) + (k' - h') + (k'' - h'') = 2 * d0 + g0 := by
    have hcd : c + d = 2 * beta0 + d0 := by
      dsimp [d0]
      ring
    have hfg : f + g = 2 * gamma0 + g0 := by
      dsimp [g0]
      ring
    calc
      (b - a) + (k' - h') + (k'' - h'') =
          2 * (c + d) + (f + g) + 2 * (z - a - h' - h'') := hsum0
      _ = 2 * d0 + g0 := by
        rw [hcd, hfg]
        calc
          2 * (2 * beta0 + d0) + (2 * gamma0 + g0) + 2 * (z - a - h' - h'') =
              2 * d0 + g0 + 2 * (2 * beta0 + gamma0 + (z - a - h' - h'')) := by ring
          _ = 2 * d0 + g0 + 2 * 0 := by rw [hzero]
          _ = 2 * d0 + g0 := by ring
  -- normalized representation condition
  have hcdβ : ({c, d} : Set Z) = beta0 + ({0, d0} : Set Z) := by
    dsimp [d0]
    exact pair_eq_shift_of_mem hbeta0
  have hfgγ : ({f, g} : Set Z) = gamma0 + ({0, g0} : Set Z) := by
    dsimp [g0]
    exact pair_eq_shift_of_mem hgamma0
  have href1 : ∀ α0 ∈ ({0, b - a} : Set Z),
      ∀ τ0 ∈ ({0, k' - h'} : Set Z),
        ∀ τ'0 ∈ ({0, k'' - h''} : Set Z),
          ∃ β1 ∈ ({0, d0} : Set Z),
            ∃ γ1 ∈ ({0, g0} : Set Z), α0 + τ0 + τ'0 = 2 * β1 + γ1 := by
    intro α0 hα0 τ0 hτ0 τ'0 hτ'0
    rcases href0 α0 hα0 τ0 hτ0 τ'0 hτ'0 with ⟨β, hβ, γ, hγ, heq1⟩
    have hβmem : β ∈ beta0 + ({0, d0} : Set Z) := by
      rwa [hcdβ] at hβ
    rw [mem_add_element] at hβmem
    rcases hβmem with ⟨β1, hβ1, hββ1⟩
    have hγmem : γ ∈ gamma0 + ({0, g0} : Set Z) := by
      rwa [hfgγ] at hγ
    rw [mem_add_element] at hγmem
    rcases hγmem with ⟨γ1, hγ1, hγγ1⟩
    refine ⟨β1, hβ1, γ1, hγ1, ?_⟩
    calc
      α0 + τ0 + τ'0 = 2 * β + γ + (z - a - h' - h'') := heq1
      _ = 2 * (beta0 + β1) + (gamma0 + γ1) + (z - a - h' - h'') := by rw [hββ1, hγγ1]
      _ = 2 * β1 + γ1 + (2 * beta0 + gamma0 + (z - a - h' - h'')) := by ring
      _ = 2 * β1 + γ1 + 0 := by rw [hzero]
      _ = 2 * β1 + γ1 := by ring
  -- apply the normalized lemma
  have hnorm : PairTranslate ({0, b - a} : Set Z) ({0, k' - h'} : Set Z) ∧
      PairTranslate ({0, k' - h'} : Set Z) ({0, k'' - h''} : Set Z) := by
    simpa [Z] using (normalized_force_compat e he (b := b - a) (k' := k' - h')
      (k'' := k'' - h'') (d := d0) (g := g0) hb0 hk0' hk0'' hg0 hsum1 href1)
  rcases hnorm with ⟨hp1, hp2⟩
  -- transport the conclusion back to the untranslated pairs
  have hA : ({a, b} : Set Z) = a + ({0, b - a} : Set Z) := by
    simpa [Z] using pair_set_eq_add a b
  have hB : ({h', k'} : Set Z) = h' + ({0, k' - h'} : Set Z) := by
    simpa [Z] using pair_set_eq_add h' k'
  have hC : ({h'', k''} : Set Z) = h'' + ({0, k'' - h''} : Set Z) := by
    simpa [Z] using pair_set_eq_add h'' k''
  have hp1' : PairTranslate (a + ({0, b - a} : Set Z)) (h' + ({0, k' - h'} : Set Z)) := by
    exact pairTranslate_trans (pairTranslate_add_left a hp1)
      (pairTranslate_translates a h' ({0, k' - h'} : Set Z))
  have hp2' : PairTranslate (h' + ({0, k' - h'} : Set Z)) (h'' + ({0, k'' - h''} : Set Z)) := by
    exact pairTranslate_trans (pairTranslate_add_left h' hp2)
      (pairTranslate_translates h' h'' ({0, k'' - h''} : Set Z))
  constructor
  · rw [hA, hB]
    exact hp1'
  · rw [hB, hC]
    exact hp2'


end
end Commons.PeriodicTiling


open scoped Pointwise

namespace Commons.PeriodicTiling
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unnecessarySimpa false
set_option linter.unusedSimpArgs false

noncomputable section

attribute [local instance] Classical.propDecidable

/-! # Expressing multiple compatible boolean functions (Proposition multi-express)

The paper's Proposition "Expressing multiple compatible boolean functions"
(tex 830-883): over a group `G` generated by a finite family, the *compatible boolean
property* on a `W`-tuple of functions `G → ZMod (2^(e+1))` — each function
`⟨p,q⟩`-periodic (`p,q` the paper's `e',e''`) and `(v,{a,b})`-boolean (`v` the
paper's `e`) with pairwise *compatible* value pairs — is weakly expressible.

Compatibility of two boolean functions is defined via their images: `α` and `β` are
compatible when `Set.range α` is a translate of `Set.range β` (for boolean functions
the image is exactly the two-element pair).  This file develops the definitions and
the elementary layer (range = pair, congruence of weak expressibility, transitivity
of compatibility); the main reduction follows the paper: express the auxiliary
`P*`-property (existential over the `β_i, γ_i, τ', τ''` gadgets, conjoined with the
linear constraint `(vi)`), then show `P` is the existential quantification of `P*`
using `force_compat` for the converse direction and the binary decomposition
`α_i + τ' + τ'' = 2β_i + γ_i` for the forward direction. -/


variable {G H : Type*} [AddCommGroup G] [AddCommGroup H]
/-- The codomain `ZMod (2^(e+1))` is nontrivial. -/
lemma zmod_two_pow_nontrivial (e : ℕ) : ∃ z : ZMod (2 ^ (e + 1)), z ≠ 0 := by
  refine ⟨1, ?_⟩
  intro h
  have hc : ((1 : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by exact_mod_cast h
  have hd : 2 ^ (e + 1) ∣ 1 := (ZMod.natCast_eq_zero_iff 1 (2 ^ (e + 1))).mp hc
  have hle : 2 ^ (e + 1) ≤ 1 := Nat.le_of_dvd (by norm_num : 0 < 1) hd
  have hp : 2 ≤ 2 ^ (e + 1) := by
    have h1 : 1 ≤ e + 1 := by omega
    have hp' := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h1
    simpa using hp'
  omega

/-- Expressibility of the `P*`-items (i)/(iv)/(v): periodic along two given directions
`p`, `q` and `(v,{a,b})`-boolean. -/
theorem periodic_pair_bool_expressible {d : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      periodicAlong p α ∧ periodicAlong q α ∧ IsBooleanAlt e v α) := by
  have hper1 : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      periodicAlong p α) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) p
  have hper2 : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      periodicAlong q α) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) q
  have hbool : ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      IsBooleanAlt e v α) := bool_expr_expressible e he v gens hpos hspan
  exact expressible_conj hper1 (expressible_conj hper2 hbool)


/-- The `w`-th coordinate function of a tuple function `G → (Fin K → H)`. -/
def coord {K : ℕ} (α : G → (Fin K → H)) (w : Fin K) : G → H := fun x => α x w

/-! ## Coordinatewise expressibility over tuple codomains

A single-function expressible property `P` on coordinate `w` of a `K`-tuple function
is expressible over the tuple codomain: the lifted system keeps the same equations and
shifts, and replaces each colour set by its *cylinder* over coordinate `w`
(`{y : Fin K → H | y w ∈ E}`); membership in the translated cylinder is exactly the
coordinate membership, so solving the lifted system is solving the original on the
`w`-th coordinate.  Conjoining over all coordinates (`expressible_conj_fin`) gives the
coordinatewise-conjunction lemma `expressible_coord_conj_fin`, the keystone for the
tuple-level propositions (multi-express, sym-bool, perm-express, and the `S`-encoding). -/

/-- Membership in a translate of a cylinder over coordinate `w`. -/
lemma mem_lift_tile {K : ℕ} (w : Fin K) (t : Fin K → H) (E : Set H) (y : Fin K → H) :
    y ∈ t + ({z : Fin K → H | z w ∈ E}) ↔ y w ∈ t w + E := by
  constructor
  · intro hy
    change y ∈ ({t} : Set (Fin K → H)) + {z : Fin K → H | z w ∈ E} at hy
    rw [Set.mem_add] at hy
    rcases hy with ⟨u, hu, v, hv, hsum⟩
    simp at hu
    subst u
    change y w ∈ ({t w} : Set H) + E
    rw [Set.mem_add]
    refine ⟨t w, by simp, v w, hv, ?_⟩
    have hw := congrArg (fun s : Fin K → H => s w) hsum
    simpa using hw
  · intro hy
    change y w ∈ ({t w} : Set H) + E at hy
    rw [Set.mem_add] at hy
    rcases hy with ⟨u, hu, e, he, hsum⟩
    simp at hu
    subst u
    change y ∈ ({t} : Set (Fin K → H)) + {z : Fin K → H | z w ∈ E}
    rw [Set.mem_add]
    refine ⟨t, by simp, fun k : Fin K => y k - t k, ?_, ?_⟩
    · change (y w - t w) ∈ E
      have he' : e = y w - t w := by
        rw [← hsum]
        abel
      rw [← he']
      exact he
    · funext k
      simp

/-- The lifted system: same equations and shifts as `S`, colour sets replaced by the
cylinders over coordinate `w`. -/
def coordSystem {K : ℕ} (w : Fin K) (S : FunctionalSystem G H) :
    FunctionalSystem G (Fin K → H) where
  M := S.M
  J := S.J
  h := S.h
  E := fun i j => {y : Fin K → H | y w ∈ S.E i j}

/-- Solving the lifted system is solving the original system on the `w`-th coordinate. -/
lemma coordSystem_solves {K : ℕ} (w : Fin K) (S : FunctionalSystem G H)
    (α : G → (Fin K → H)) :
    Solves (coordSystem w S) α ↔ Solves S (coord α w) := by
  unfold Solves
  constructor
  · intro h i x y₀
    let y : Fin K → H := fun k => if hk : k = w then y₀ else (0 : H)
    have hyw : y w = y₀ := by
      simp [y]
    have h' : ∃! j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin K → H | z w ∈ S.E i j}) := by
      simpa [coordSystem] using (h i x y)
    have hpq : ∀ j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin K → H | z w ∈ S.E i j}) ↔
          y₀ ∈ (coord α w) (x + S.h i j) + S.E i j := by
      intro j
      calc
        y ∈ α (x + S.h i j) + ({z : Fin K → H | z w ∈ S.E i j}) ↔
            y w ∈ α (x + S.h i j) w + S.E i j :=
              mem_lift_tile w (α (x + S.h i j)) (S.E i j) y
        _ ↔ y₀ ∈ (coord α w) (x + S.h i j) + S.E i j := by
          rw [hyw]
          rfl
    exact FunctionalSystem.existsUnique_congr (fun j => (hpq j).symm) h'
  · intro h i x y
    have h' := h i x (y w)
    -- h' : ∃! j, y w ∈ (coord α w) (x + S.h i j) + S.E i j
    have hpq : ∀ j : Fin (S.J i),
        y ∈ α (x + S.h i j) + ({z : Fin K → H | z w ∈ S.E i j}) ↔
          y w ∈ (coord α w) (x + S.h i j) + S.E i j := by
      intro j
      rw [mem_lift_tile]
      rfl
    exact FunctionalSystem.existsUnique_congr hpq h'

/-- A single-function expressible property lifts to the `w`-th coordinate of a
`K`-tuple function. -/
theorem expressible_coord_lift {K : ℕ} (w : Fin K) {P : (G → H) → Prop}
    (hP : ExpressibleProperty P) :
    ExpressibleProperty (fun α : G → (Fin K → H) => P (coord α w)) := by
  rcases hP with ⟨S, hE, hiff⟩
  have hE' : ∀ i j, ((coordSystem w S).E i j).Nonempty := by
    intro i j
    rcases hE i j with ⟨e, he⟩
    refine ⟨fun k : Fin K => if hk : k = w then e else (0 : H), ?_⟩
    change (fun k : Fin K => if hk : k = w then e else (0 : H)) w ∈ S.E i j
    simp [he]
  refine ⟨coordSystem w S, hE', ?_⟩
  intro α
  exact (hiff (coord α w)).trans (coordSystem_solves w S α).symm

/-- The coordinatewise conjunction of expressible single-coordinate properties is
expressible over the tuple codomain. -/
theorem expressible_coord_conj_fin {K : ℕ} (P : Fin K → (G → H) → Prop)
    (hP : ∀ w : Fin K, ExpressibleProperty (P w)) :
    ExpressibleProperty (fun α : G → (Fin K → H) => ∀ w : Fin K, P w (coord α w)) := by
  have hl : ∀ w : Fin K, ExpressibleProperty (fun α : G → (Fin K → H) =>
      P w (coord α w)) := by
    intro w
    exact expressible_coord_lift w (hP w)
  exact expressible_conj_fin (P := fun w (α : G → (Fin K → H)) => P w (coord α w)) hl

/-- Two functions are *compatible* when their images are translates of each other. -/
def CompatibleFunctions (α β : G → H) : Prop := PairTranslate (Set.range α) (Set.range β)

/-- Weakly expressible properties are closed under pointwise equivalence. -/
lemma weakExpressible_congr {K : ℕ} {P Q : (G → (Fin K → H)) → Prop}
    (hPQ : ∀ α : G → (Fin K → H), P α ↔ Q α) (hP : WeakExpressible K P) :
    WeakExpressible K Q := by
  rcases hP with ⟨M, Pstar, hPstar, hiff⟩
  refine ⟨M, Pstar, hPstar, ?_⟩
  intro α
  exact (hPQ α).symm.trans (hiff α)

/-- The range of an `(v,{a,b})`-boolean function is exactly `{a,b}`. -/
lemma range_eq_pair (e : ℕ) (v : G) (α : G → ZMod (2 ^ (e + 1))) (a b : ZMod (2 ^ (e + 1)))
    (hvals : ∀ x : G, α x = a ∨ α x = b)
    (hswap : ∀ x : G, α (x + v) = a + b - α x) :
    Set.range α = ({a, b} : Set (ZMod (2 ^ (e + 1)))) := by
  ext y
  constructor
  · intro hy
    rcases hy with ⟨x, hx⟩
    rcases hvals x with hxa | hxb
    · left
      exact hx.symm.trans hxa
    · right
      exact hx.symm.trans hxb
  · intro hy
    simp at hy
    rcases hy with hy | hy
    · -- y = a
      by_cases h0 : α (0 : G) = a
      · exact ⟨0, h0.trans hy.symm⟩
      · have h0b : α (0 : G) = b := by
          rcases hvals (0 : G) with h0a | h0b
          · exact False.elim (h0 h0a)
          · exact h0b
        refine ⟨v, ?_⟩
        have h1 := hswap (0 : G)
        rw [h0b] at h1
        have hred : a + b - b = a := by ring
        have hv : α v = a := by
          calc α v = α (0 + v) := by rw [zero_add]
            _ = a + b - b := h1
            _ = a := hred
        exact hv.trans hy.symm
    · -- y = b
      by_cases h0 : α (0 : G) = b
      · exact ⟨0, h0.trans hy.symm⟩
      · have h0a : α (0 : G) = a := by
          rcases hvals (0 : G) with h0a | h0b
          · exact h0a
          · exact False.elim (h0 h0b)
        refine ⟨v, ?_⟩
        have h1 := hswap (0 : G)
        rw [h0a] at h1
        have hred : a + b - a = b := by ring
        have hv : α v = b := by
          calc α v = α (0 + v) := by rw [zero_add]
            _ = a + b - a := h1
            _ = b := hred
        exact hv.trans hy.symm

/-! ## Boolean functions and their two-element images

For `(v,{a,b})`-boolean functions the image is the pair, so function compatibility
reduces to pair translation, and (via the `PairTranslate` calculus) is an equivalence
relation.  The `CompBool` tuple property is the paper's *compatible boolean property*. -/

/-- Compatibility of two boolean functions is translation of their value pairs. -/
lemma compatible_iff_pair_translate (e : ℕ) (v : G) (α β : G → ZMod (2 ^ (e + 1)))
    (a b c d : ZMod (2 ^ (e + 1)))
    (hαv : ∀ x : G, α x = a ∨ α x = b) (hαs : ∀ x : G, α (x + v) = a + b - α x)
    (hβv : ∀ x : G, β x = c ∨ β x = d) (hβs : ∀ x : G, β (x + v) = c + d - β x) :
    CompatibleFunctions α β ↔ PairTranslate ({a, b} : Set (ZMod (2 ^ (e + 1))))
      ({c, d} : Set (ZMod (2 ^ (e + 1)))) := by
  unfold CompatibleFunctions
  have hrα : Set.range α = ({a, b} : Set (ZMod (2 ^ (e + 1)))) :=
    range_eq_pair e v α a b hαv hαs
  have hrβ : Set.range β = ({c, d} : Set (ZMod (2 ^ (e + 1)))) :=
    range_eq_pair e v β c d hβv hβs
  rw [hrα, hrβ]

/-- Compatibility of two `IsBooleanAlt` functions is translation of their value pairs. -/
lemma compatible_iff_pair_translate' (e : ℕ) (v : G) (α β : G → ZMod (2 ^ (e + 1)))
    (hα : IsBooleanAlt e v α) (hβ : IsBooleanAlt e v β) :
    CompatibleFunctions α β ↔
      ∃ a b c d : ZMod (2 ^ (e + 1)),
        (∀ x : G, α x = a ∨ α x = b) ∧ (∀ x : G, α (x + v) = a + b - α x) ∧
        (∀ x : G, β x = c ∨ β x = d) ∧ (∀ x : G, β (x + v) = c + d - β x) ∧
        PairTranslate ({a, b} : Set (ZMod (2 ^ (e + 1))))
          ({c, d} : Set (ZMod (2 ^ (e + 1)))) := by
  rcases hα with ⟨a, b, haE, hbO, hαv, hαs⟩
  rcases hβ with ⟨c, d, hcE, hdO, hβv, hβs⟩
  constructor
  · intro hcompat
    refine ⟨a, b, c, d, hαv, hαs, hβv, hβs, ?_⟩
    exact (compatible_iff_pair_translate e v α β a b c d hαv hαs hβv hβs).mp hcompat
  · intro hw
    rcases hw with ⟨a, b, c, d, hαv, hαs, hβv, hβs, hpt⟩
    exact (compatible_iff_pair_translate e v α β a b c d hαv hαs hβv hβs).mpr hpt

/-- The *compatible boolean property* on a `K`-tuple: each coordinate is periodic along
`p,q` and `(v,{a,b})`-boolean, and the coordinates are pairwise compatible. -/
def CompBool (e : ℕ) (v p q : G) {K : ℕ} (α : G → (Fin K → ZMod (2 ^ (e + 1)))) : Prop :=
  (∀ w : Fin K, periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧
    IsBooleanAlt e v (coord α w)) ∧
  (∀ w w' : Fin K, CompatibleFunctions (coord α w) (coord α w'))

/-- The single-coordinate part of `CompBool` is expressible (Proposition bool-expr plus
express-periodicity along `p` and `q`). -/
theorem single_bool_expressible {d : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (fun α : G → ZMod (2 ^ (e + 1)) =>
      periodicAlong p α ∧ periodicAlong q α ∧ IsBooleanAlt e v α) :=
  periodic_pair_bool_expressible e he v p q gens hpos hspan


/-! ## Immediate use: the coordinatewise boolean-periodic property

Applying `expressible_coord_conj_fin` coordinatewise to the single-function result
`single_bool_expressible` gives expressibility of "every coordinate of the `K`-tuple
is `⟨p,q⟩`-periodic and `(v,{a,b})`-boolean" — the per-coordinate part of the paper's
compatible boolean property and of the `P*`-property items (i)/(iv)/(v). -/

/-- Every coordinate of a `K`-tuple being `⟨p,q⟩`-periodic and `(v,{a,b})`-boolean is
expressible. -/
theorem coordinatewise_bool_expressible {d K : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (fun α : G → (Fin K → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin K,
        periodicAlong p (coord α w) ∧ periodicAlong q (coord α w) ∧ IsBooleanAlt e v (coord α w)) := by
  exact expressible_coord_conj_fin
    (P := fun w (α₀ : G → ZMod (2 ^ (e + 1))) =>
      periodicAlong p α₀ ∧ periodicAlong q α₀ ∧ IsBooleanAlt e v α₀)
    (fun w => single_bool_expressible e he v p q gens hpos hspan)


/-! ## The W=2 auxiliary property `P*` and its expressibility

Following the paper (tex 832-849), `P*` is the property of an octuplet
`(α₁, α₂, β₁, β₂, γ₁, γ₂, τ′, τ″)` — coordinates `0..7` of a tuple function — that:
each coordinate is `(v,{a,b})`-boolean (`IsBooleanAlt e v`); `α₁,α₂` are
`⟨p,q⟩`-periodic, `τ′` is `⟨v+p,q⟩`-periodic, `τ″` is `⟨p,v+q⟩`-periodic (all other
coordinates have no periodicity requirement); and, for each `i = 1,2`, the linear
combination `α_i + τ′ + τ″ − 2β_i − γ_i` is constant (item (vi), via `linConstVal`
of the corresponding coefficient functional on the 8-tuple).  All these ingredients are
expressible, hence so is `P*`. -/

/-- Per-coordinate periodicity requirement of `P*` (items (i), (iv), (v)). -/
def PairPstarPeriod (e : ℕ) (v p q : G) (w : Fin 8) (α₀ : G → ZMod (2 ^ (e + 1))) : Prop :=
  if w = (0 : Fin 8) ∨ w = (1 : Fin 8) then periodicAlong p α₀ ∧ periodicAlong q α₀
  else if w = (6 : Fin 8) then periodicAlong (v + p) α₀ ∧ periodicAlong q α₀
  else if w = (7 : Fin 8) then periodicAlong p α₀ ∧ periodicAlong (v + q) α₀
  else True

/-- Coefficient functional of item (vi) for `i = 1`:
`α₁ + τ′ + τ″ − 2β₁ − γ₁` (coordinates 0, 2, 4, 6, 7). -/
def pairCoeff1 (e : ℕ) : Fin 8 → ZMod (2 ^ (e + 1)) :=
  fun w => if w = (0 : Fin 8) then 1
  else if w = (2 : Fin 8) then -2
  else if w = (4 : Fin 8) then -1
  else if w = (6 : Fin 8) then 1
  else if w = (7 : Fin 8) then 1
  else 0

/-- Coefficient functional of item (vi) for `i = 2`:
`α₂ + τ′ + τ″ − 2β₂ − γ₂` (coordinates 1, 3, 5, 6, 7). -/
def pairCoeff2 (e : ℕ) : Fin 8 → ZMod (2 ^ (e + 1)) :=
  fun w => if w = (1 : Fin 8) then 1
  else if w = (3 : Fin 8) then -2
  else if w = (5 : Fin 8) then -1
  else if w = (6 : Fin 8) then 1
  else if w = (7 : Fin 8) then 1
  else 0

/-- The `W=2` auxiliary property `P*` of the octuplet (paper tex 834-848). -/
def PairPstar (e : ℕ) (v p q : G) (α : G → (Fin 8 → ZMod (2 ^ (e + 1)))) : Prop :=
  (∀ w : Fin 8, IsBooleanAlt e v (coord α w)) ∧
  (∀ w : Fin 8, PairPstarPeriod e v p q w (coord α w)) ∧
  linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) α ∧
  linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) α


/-- The per-coordinate `P*` periodicity requirement is expressible at every coordinate. -/
theorem pairPstarPeriod_expressible (e : ℕ) (v p q : G) (w : Fin 8) :
    ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) => PairPstarPeriod e v p q w α₀) := by
  by_cases h01 : w = (0 : Fin 8) ∨ w = (1 : Fin 8)
  · have hper1 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong p α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) p
    have hper2 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong q α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) q
    have hc : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong p α₀ ∧ periodicAlong q α₀) := expressible_conj hper1 hper2
    refine expressible_congr (P := fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong p α₀ ∧ periodicAlong q α₀) ?_ hc
    intro α₀
    simp [PairPstarPeriod, h01]
  · by_cases h6 : w = (6 : Fin 8)
    · have hper1 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong (v + p) α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) (v + p)
      have hper2 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
        periodicAlong q α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) q
      have hc : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
          periodicAlong (v + p) α₀ ∧ periodicAlong q α₀) := expressible_conj hper1 hper2
      refine expressible_congr (P := fun α₀ : G → ZMod (2 ^ (e + 1)) =>
          periodicAlong (v + p) α₀ ∧ periodicAlong q α₀) ?_ hc
      intro α₀
      simp [PairPstarPeriod, h01, h6]
    · by_cases h7 : w = (7 : Fin 8)
      · have hper1 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
          periodicAlong p α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) p
        have hper2 : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
          periodicAlong (v + q) α₀) := periodicAlong_expressible_general (zmod_two_pow_nontrivial e) (v + q)
        have hc : ExpressibleProperty (fun α₀ : G → ZMod (2 ^ (e + 1)) =>
            periodicAlong p α₀ ∧ periodicAlong (v + q) α₀) := expressible_conj hper1 hper2
        refine expressible_congr (P := fun α₀ : G → ZMod (2 ^ (e + 1)) =>
            periodicAlong p α₀ ∧ periodicAlong (v + q) α₀) ?_ hc
        intro α₀
        simp [PairPstarPeriod, h01, h6, h7]
      · refine expressible_congr (P := fun _ : G → ZMod (2 ^ (e + 1)) => True) ?_
          (fullProperty_expressible (G := G) (H := ZMod (2 ^ (e + 1))))
        intro α₀
        simp [PairPstarPeriod, h01, h6, h7]


/-- The constant `1` is nonzero in `ZMod (2^(e+1))`. -/
lemma one_ne_zero_zmod (e : ℕ) : (1 : ZMod (2 ^ (e + 1))) ≠ 0 := by
  intro h
  have hc : ((1 : ℕ) : ZMod (2 ^ (e + 1))) = 0 := by exact_mod_cast h
  have hd : 2 ^ (e + 1) ∣ 1 := (ZMod.natCast_eq_zero_iff 1 (2 ^ (e + 1))).mp hc
  have hle : 2 ^ (e + 1) ≤ 1 := Nat.le_of_dvd (by norm_num : 0 < 1) hd
  have hp : 2 ≤ 2 ^ (e + 1) := by
    have h1 : 1 ≤ e + 1 := by omega
    have hp' := pow_le_pow_right₀ (by norm_num : (1 : ℕ) ≤ 2) h1
    simpa using hp'
  omega

/-- The functional of item (vi)-i is nonzero (witness: the tuple with `1` in coordinate
`0`). -/
lemma pairLin1_ne_zero (e : ℕ) : ∃ a : Fin 8 → ZMod (2 ^ (e + 1)),
    (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) a ≠ 0 := by
  refine ⟨fun w : Fin 8 => if w = (0 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1))), ?_⟩
  have hval : (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e))
      (fun w : Fin 8 => if w = (0 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 1 := by
    change (∑ w ∈ (Finset.univ : Finset (Fin 8)),
      pairCoeff1 e w * (if w = (0 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1))))) = 1
    have h₀ : ∀ b ∈ (Finset.univ : Finset (Fin 8)), b ≠ (0 : Fin 8) →
        pairCoeff1 e b * (if b = (0 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 0 := by
      intro b hb hne
      simp [hne]
    have h₁ : (0 : Fin 8) ∉ (Finset.univ : Finset (Fin 8)) →
        pairCoeff1 e (0 : Fin 8) *
          (if (0 : Fin 8) = (0 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 0 := by
      intro h
      exact False.elim (h (by simp))
    rw [Finset.sum_eq_single (0 : Fin 8) h₀ h₁]
    simp [pairCoeff1]
  rw [hval]
  exact one_ne_zero_zmod e

/-- The functional of item (vi)-ii is nonzero (witness: the tuple with `1` in coordinate
`1`). -/
lemma pairLin2_ne_zero (e : ℕ) : ∃ a : Fin 8 → ZMod (2 ^ (e + 1)),
    (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) a ≠ 0 := by
  refine ⟨fun w : Fin 8 => if w = (1 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1))), ?_⟩
  have hval : (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e))
      (fun w : Fin 8 => if w = (1 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 1 := by
    change (∑ w ∈ (Finset.univ : Finset (Fin 8)),
      pairCoeff2 e w * (if w = (1 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1))))) = 1
    have h₀ : ∀ b ∈ (Finset.univ : Finset (Fin 8)), b ≠ (1 : Fin 8) →
        pairCoeff2 e b * (if b = (1 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 0 := by
      intro b hb hne
      simp [hne]
    have h₁ : (1 : Fin 8) ∉ (Finset.univ : Finset (Fin 8)) →
        pairCoeff2 e (1 : Fin 8) *
          (if (1 : Fin 8) = (1 : Fin 8) then 1 else (0 : ZMod (2 ^ (e + 1)))) = 0 := by
      intro h
      exact False.elim (h (by simp))
    rw [Finset.sum_eq_single (1 : Fin 8) h₀ h₁]
    simp [pairCoeff2]
  rw [hval]
  exact one_ne_zero_zmod e

/-- Item (vi) of `P*` is expressible (two linear-constancy conditions over the
tuple codomain). -/
theorem pairPstar_lin_expressible {d : ℕ} (e : ℕ) (v p q : G)
    (gens : Fin d → G) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) α ∧
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) α) := by
  have hl1 : ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) α) :=
    linConstVal_expressible (ℓ := linFun (2 ^ (e + 1)) 8 (pairCoeff1 e))
      (e := gens) hspan (pairLin1_ne_zero e)
  have hl2 : ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) α) :=
    linConstVal_expressible (ℓ := linFun (2 ^ (e + 1)) 8 (pairCoeff2 e))
      (e := gens) hspan (pairLin2_ne_zero e)
  exact expressible_conj hl1 hl2

/-- The `W=2` auxiliary property `P*` is expressible. -/
theorem pairPstar_expressible {d : ℕ} (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (gens : Fin d → G) (hpos : 0 < d) (hspan : FiniteSpanningSet gens) :
    ExpressibleProperty (PairPstar e v p q) := by
  have hbool : ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin 8, IsBooleanAlt e v (coord α w)) := by
    exact expressible_coord_conj_fin
      (P := fun w (α₀ : G → ZMod (2 ^ (e + 1))) => IsBooleanAlt e v α₀)
      (fun w => bool_expr_expressible e he v gens hpos hspan)
  have hper : ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      ∀ w : Fin 8, PairPstarPeriod e v p q w (coord α w)) := by
    exact expressible_coord_conj_fin
      (P := fun w (α₀ : G → ZMod (2 ^ (e + 1))) => PairPstarPeriod e v p q w α₀)
      (fun w => pairPstarPeriod_expressible e v p q w)
  have hlin : ExpressibleProperty (fun α : G → (Fin 8 → ZMod (2 ^ (e + 1))) =>
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) α ∧
      linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) α) :=
    pairPstar_lin_expressible e v p q gens hspan
  exact expressible_conj hbool (expressible_conj hper hlin)


/-! ## The `z`-sum equation from the linear constraint

First component of the direction `P* ⇒` pair-`CompBool`.  Item (vi) of `P*` gives, for
each `i`, a constant `z_i` with `α_i(x)+τ′(x)+τ″(x) = 2β_i(x)+γ_i(x)+z_i` for all `x`.
Evaluating at `x` and at `x+v` and adding, and using that each boolean function
alternates (`g(x+v) = p+q−g(x)`, so `g(x)+g(x+v) = p+q`), yields the paper's sum
equation `(a_i+b_i)+(h′+k′)+(h″+k″) = 2(c_i+d_i)+(f_i+g_i)+2z_i` between the two values
of each function.  This is the hypothesis `hsum` of `force_compat`. -/

/-- Summing a function over `x, x+v`: alternation `g(x+v) = p+q-g x` gives
`g x + g (x+v) = p+q`. -/
lemma alt_pair_sum {Z : Type*} [AddCommGroup Z] (v : G) (g : G → Z) (p q : Z) (x : G)
    (hg : ∀ y : G, g (y + v) = p + q - g y) : g x + g (x + v) = p + q := by
  rw [hg x]
  abel

/-- The `z`-sum equation, derived by summing item (vi) at `x` and `x+v`. -/
lemma zsum_of_constraints (e : ℕ) (v : G)
    (α β γ τ' τ'' : G → ZMod (2 ^ (e + 1)))
    (a b c d f g h' k' h'' k'' z : ZMod (2 ^ (e + 1))) (x : G)
    (hα : ∀ y : G, α (y + v) = a + b - α y)
    (hβ : ∀ y : G, β (y + v) = c + d - β y)
    (hγ : ∀ y : G, γ (y + v) = f + g - γ y)
    (hτ' : ∀ y : G, τ' (y + v) = h' + k' - τ' y)
    (hτ'' : ∀ y : G, τ'' (y + v) = h'' + k'' - τ'' y)
    (hlin : ∀ y : G, α y + τ' y + τ'' y = 2 * β y + γ y + z) :
    (a + b) + (h' + k') + (h'' + k'') = 2 * (c + d) + (f + g) + 2 * z := by
  have hL : (α x + τ' x + τ'' x) + (α (x + v) + τ' (x + v) + τ'' (x + v)) =
      (a + b) + (h' + k') + (h'' + k'') := by
    calc
      (α x + τ' x + τ'' x) + (α (x + v) + τ' (x + v) + τ'' (x + v)) =
          (α x + α (x + v)) + (τ' x + τ' (x + v)) + (τ'' x + τ'' (x + v)) := by ring
      _ = (a + b) + (h' + k') + (h'' + k'') := by
        rw [alt_pair_sum v α a b x hα, alt_pair_sum v τ' h' k' x hτ',
          alt_pair_sum v τ'' h'' k'' x hτ'']
  have hR : (2 * β x + γ x + z) + (2 * β (x + v) + γ (x + v) + z) =
      2 * (c + d) + (f + g) + 2 * z := by
    calc
      (2 * β x + γ x + z) + (2 * β (x + v) + γ (x + v) + z) =
          2 * (β x + β (x + v)) + (γ x + γ (x + v)) + 2 * z := by ring
      _ = 2 * (c + d) + (f + g) + 2 * z := by
        have hβsum : β x + β (x + v) = c + d := alt_pair_sum v β c d x hβ
        have hγsum : γ x + γ (x + v) = f + g := alt_pair_sum v γ f g x hγ
        rw [hβsum, hγsum]
  have hadd : (α x + τ' x + τ'' x) + (α (x + v) + τ' (x + v) + τ'' (x + v)) =
      (2 * β x + γ x + z) + (2 * β (x + v) + γ (x + v) + z) := by
    rw [hlin x, hlin (x + v)]
  exact hL.symm.trans (hadd.trans hR)


/-- Evaluating the item (vi)-i functional on a tuple value:
`α₁ + τ′ + τ″ − 2β₁ − γ₁` (coordinates 0, 6, 7, 2, 4). -/
lemma pairLin1_eval (e : ℕ) (t : Fin 8 → ZMod (2 ^ (e + 1))) :
    (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) t =
      t (0 : Fin 8) + t (6 : Fin 8) + t (7 : Fin 8) - 2 * t (2 : Fin 8) - t (4 : Fin 8) := by
  change (∑ w : Fin 8, pairCoeff1 e w * t w) =
      t (0 : Fin 8) + t (6 : Fin 8) + t (7 : Fin 8) - 2 * t (2 : Fin 8) - t (4 : Fin 8)
  rw [Fin.sum_univ_eight]
  simp [pairCoeff1]
  ring

/-- Evaluating the item (vi)-ii functional on a tuple value:
`α₂ + τ′ + τ″ − 2β₂ − γ₂` (coordinates 1, 6, 7, 3, 5). -/
lemma pairLin2_eval (e : ℕ) (t : Fin 8 → ZMod (2 ^ (e + 1))) :
    (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) t =
      t (1 : Fin 8) + t (6 : Fin 8) + t (7 : Fin 8) - 2 * t (3 : Fin 8) - t (5 : Fin 8) := by
  change (∑ w : Fin 8, pairCoeff2 e w * t w) =
      t (1 : Fin 8) + t (6 : Fin 8) + t (7 : Fin 8) - 2 * t (3 : Fin 8) - t (5 : Fin 8)
  rw [Fin.sum_univ_eight]
  simp [pairCoeff2]
  ring


/-! ## Witness extraction from `P*`: the pointwise linear constraint and the sum

Item (vi) of `P*` is `linConstVal` of the two coefficient functionals.  Unpacking with
the evaluation lemmas gives the pointwise shape `αᵢ+τ′+τ″ = 2βᵢ+γᵢ+zᵢ` of `zsum_of_constraints`;
together with the `IsBooleanAlt` alternation witnesses of the five relevant coordinates
this yields the `force_compat`-ready sum equation for each `i`. -/

/-- The alternating part of an `IsBooleanAlt` witness. -/
lemma isBooleanAlt_alternating {e : ℕ} {v : G} {α : G → ZMod (2 ^ (e + 1))}
    (h : IsBooleanAlt e v α) : ∃ a b : ZMod (2 ^ (e + 1)),
      ∀ x : G, α (x + v) = a + b - α x := by
  rcases h with ⟨a, b, _haE, _hbO, _hvals, hswap⟩
  exact ⟨a, b, hswap⟩

/-- The pointwise form of item (vi) for `i = 1`, from the linear-constancy of the
`pairCoeff1` functional. -/
lemma pairPstar_lin1 (e : ℕ) (tup : G → (Fin 8 → ZMod (2 ^ (e + 1))))
    (hℓ : linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff1 e)) tup) :
    ∃ z₁ : ZMod (2 ^ (e + 1)), ∀ x : G,
      coord tup (0 : Fin 8) x + coord tup (6 : Fin 8) x + coord tup (7 : Fin 8) x =
        2 * coord tup (2 : Fin 8) x + coord tup (4 : Fin 8) x + z₁ := by
  rcases hℓ with ⟨z₁, hz₁⟩
  refine ⟨z₁, ?_⟩
  intro x
  have heval := pairLin1_eval e (tup x)
  have hz := hz₁ x
  have hmain : (tup x) (0 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) -
      2 * (tup x) (2 : Fin 8) - (tup x) (4 : Fin 8) = z₁ := by
    rwa [heval] at hz
  have hlin : (tup x) (0 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) =
      2 * (tup x) (2 : Fin 8) + (tup x) (4 : Fin 8) + z₁ := by
    calc
      (tup x) (0 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) =
          ((tup x) (0 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) -
            2 * (tup x) (2 : Fin 8) - (tup x) (4 : Fin 8)) +
            (2 * (tup x) (2 : Fin 8) + (tup x) (4 : Fin 8)) := by ring
      _ = z₁ + (2 * (tup x) (2 : Fin 8) + (tup x) (4 : Fin 8)) := by rw [hmain]
      _ = 2 * (tup x) (2 : Fin 8) + (tup x) (4 : Fin 8) + z₁ := by ring
  simpa [coord] using hlin

/-- The pointwise form of item (vi) for `i = 2`, from the linear-constancy of the
`pairCoeff2` functional. -/
lemma pairPstar_lin2 (e : ℕ) (tup : G → (Fin 8 → ZMod (2 ^ (e + 1))))
    (hℓ : linConstVal (linFun (2 ^ (e + 1)) 8 (pairCoeff2 e)) tup) :
    ∃ z₂ : ZMod (2 ^ (e + 1)), ∀ x : G,
      coord tup (1 : Fin 8) x + coord tup (6 : Fin 8) x + coord tup (7 : Fin 8) x =
        2 * coord tup (3 : Fin 8) x + coord tup (5 : Fin 8) x + z₂ := by
  rcases hℓ with ⟨z₂, hz₂⟩
  refine ⟨z₂, ?_⟩
  intro x
  have heval := pairLin2_eval e (tup x)
  have hz := hz₂ x
  have hmain : (tup x) (1 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) -
      2 * (tup x) (3 : Fin 8) - (tup x) (5 : Fin 8) = z₂ := by
    rwa [heval] at hz
  have hlin : (tup x) (1 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) =
      2 * (tup x) (3 : Fin 8) + (tup x) (5 : Fin 8) + z₂ := by
    calc
      (tup x) (1 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) =
          ((tup x) (1 : Fin 8) + (tup x) (6 : Fin 8) + (tup x) (7 : Fin 8) -
            2 * (tup x) (3 : Fin 8) - (tup x) (5 : Fin 8)) +
            (2 * (tup x) (3 : Fin 8) + (tup x) (5 : Fin 8)) := by ring
      _ = z₂ + (2 * (tup x) (3 : Fin 8) + (tup x) (5 : Fin 8)) := by rw [hmain]
      _ = 2 * (tup x) (3 : Fin 8) + (tup x) (5 : Fin 8) + z₂ := by ring
  simpa [coord] using hlin


/-- From `P*` for `i = 1`: the alternation witnesses of `α₁,β₁,γ₁,τ′,τ″` and the
`force_compat`-ready sum equation (coordinates 0, 2, 4, 6, 7). -/
lemma pairPstar_hsum1 (e : ℕ) (v p q : G) (tup : G → (Fin 8 → ZMod (2 ^ (e + 1))))
    (hstar : PairPstar e v p q tup) :
    ∃ a b c d f g h' k' h'' k'' z₁ : ZMod (2 ^ (e + 1)),
      (∀ x : G, coord tup (0 : Fin 8) (x + v) = a + b - coord tup (0 : Fin 8) x) ∧
      (∀ x : G, coord tup (2 : Fin 8) (x + v) = c + d - coord tup (2 : Fin 8) x) ∧
      (∀ x : G, coord tup (4 : Fin 8) (x + v) = f + g - coord tup (4 : Fin 8) x) ∧
      (∀ x : G, coord tup (6 : Fin 8) (x + v) = h' + k' - coord tup (6 : Fin 8) x) ∧
      (∀ x : G, coord tup (7 : Fin 8) (x + v) = h'' + k'' - coord tup (7 : Fin 8) x) ∧
      (a + b) + (h' + k') + (h'' + k'') = 2 * (c + d) + (f + g) + 2 * z₁ := by
  rcases hstar with ⟨hbool, _hper, hl1, _hl2⟩
  rcases isBooleanAlt_alternating (hbool (0 : Fin 8)) with ⟨a, b, hswap0⟩
  rcases isBooleanAlt_alternating (hbool (2 : Fin 8)) with ⟨c, d, hswap2⟩
  rcases isBooleanAlt_alternating (hbool (4 : Fin 8)) with ⟨f, g, hswap4⟩
  rcases isBooleanAlt_alternating (hbool (6 : Fin 8)) with ⟨h', k', hswap6⟩
  rcases isBooleanAlt_alternating (hbool (7 : Fin 8)) with ⟨h'', k'', hswap7⟩
  rcases pairPstar_lin1 e tup hl1 with ⟨z₁, hlin1⟩
  have hsum := zsum_of_constraints e v (coord tup (0 : Fin 8)) (coord tup (2 : Fin 8))
    (coord tup (4 : Fin 8)) (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
    a b c d f g h' k' h'' k'' z₁ (0 : G) hswap0 hswap2 hswap4 hswap6 hswap7 hlin1
  exact ⟨a, b, c, d, f, g, h', k', h'', k'', z₁, hswap0, hswap2, hswap4, hswap6, hswap7, hsum⟩

/-- From `P*` for `i = 2`: the alternation witnesses of `α₂,β₂,γ₂,τ′,τ″` and the
`force_compat`-ready sum equation (coordinates 1, 3, 5, 6, 7). -/
lemma pairPstar_hsum2 (e : ℕ) (v p q : G) (tup : G → (Fin 8 → ZMod (2 ^ (e + 1))))
    (hstar : PairPstar e v p q tup) :
    ∃ a b c d f g h' k' h'' k'' z₂ : ZMod (2 ^ (e + 1)),
      (∀ x : G, coord tup (1 : Fin 8) (x + v) = a + b - coord tup (1 : Fin 8) x) ∧
      (∀ x : G, coord tup (3 : Fin 8) (x + v) = c + d - coord tup (3 : Fin 8) x) ∧
      (∀ x : G, coord tup (5 : Fin 8) (x + v) = f + g - coord tup (5 : Fin 8) x) ∧
      (∀ x : G, coord tup (6 : Fin 8) (x + v) = h' + k' - coord tup (6 : Fin 8) x) ∧
      (∀ x : G, coord tup (7 : Fin 8) (x + v) = h'' + k'' - coord tup (7 : Fin 8) x) ∧
      (a + b) + (h' + k') + (h'' + k'') = 2 * (c + d) + (f + g) + 2 * z₂ := by
  rcases hstar with ⟨hbool, _hper, _hl1, hl2⟩
  rcases isBooleanAlt_alternating (hbool (1 : Fin 8)) with ⟨a, b, hswap1⟩
  rcases isBooleanAlt_alternating (hbool (3 : Fin 8)) with ⟨c, d, hswap3⟩
  rcases isBooleanAlt_alternating (hbool (5 : Fin 8)) with ⟨f, g, hswap5⟩
  rcases isBooleanAlt_alternating (hbool (6 : Fin 8)) with ⟨h', k', hswap6⟩
  rcases isBooleanAlt_alternating (hbool (7 : Fin 8)) with ⟨h'', k'', hswap7⟩
  rcases pairPstar_lin2 e tup hl2 with ⟨z₂, hlin2⟩
  have hsum := zsum_of_constraints e v (coord tup (1 : Fin 8)) (coord tup (3 : Fin 8))
    (coord tup (5 : Fin 8)) (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
    a b c d f g h' k' h'' k'' z₂ (0 : G) hswap1 hswap3 hswap5 hswap6 hswap7 hlin2
  exact ⟨a, b, c, d, f, g, h', k', h'', k'', z₂, hswap1, hswap3, hswap5, hswap6, hswap7, hsum⟩


/-! ## Eight-representability of the `(α_i, τ′, τ″)` triples (the `⟨v,p,q⟩ ≅ (ℤ/2)³` shift action)

To apply `force_compat` in the direction `P* ⇒` pair-`CompBool` we need, for each target
triple `(α_val, τ_val, τ″_val) ∈ {a,b}×{h′,k′}×{h″,k″}`, a point `x` with
`(α_i x, τ′ x, τ″ x) =` the target.  The shift action is: `v` flips all three functions
(they are `(v,{·,·})`-boolean), `p` flips only `τ′` (derived from `τ′`'s alternation and
its `⟨v+p,q⟩`-periodicity), `q` flips only `τ″`; hence the point
`x = x₀ + (r·v) + (s·p) + (t·q)` realizes the triple with `α` flipped `r` times, `τ′`
flipped `r+s` times (mod 2) and `τ″` flipped `r+t` times. -/

/-- Alternation along `v` plus periodicity along `v+p` gives alternation along `p`. -/
lemma alt_periodic_flip {Z : Type*} [AddCommGroup Z] (v p : G) (g : G → Z) (S : Z)
    (hg : ∀ x : G, g (x + v) = S - g x)
    (hper : ∀ x : G, g (x + (v + p)) = g x) :
    ∀ x : G, g (x + p) = S - g x := by
  intro x
  have h1 := hg (x + p)
  rw [show (x + p) + v = x + (v + p) by abel] at h1
  -- h1 : g (x + (v+p)) = S - g (x + p)
  rw [hper x] at h1
  -- h1 : g x = S - g (x + p)
  have h1' : S - g x = g (x + p) := by
    calc S - g x = S - (S - g (x + p)) := by rw [h1]
      _ = g (x + p) := by abel
  exact h1'.symm

/-- Alternation along `v` plus periodicity along `v+q` gives alternation along `q`. -/
lemma alt_periodic_flip' {Z : Type*} [AddCommGroup Z] (v q : G) (g : G → Z) (S : Z)
    (hg : ∀ x : G, g (x + v) = S - g x)
    (hper : ∀ x : G, g (x + (v + q)) = g x) :
    ∀ x : G, g (x + q) = S - g x := by
  intro x
  have h1 := hg (x + q)
  rw [show (x + q) + v = x + (v + q) by abel] at h1
  rw [hper x] at h1
  have h1' : S - g x = g (x + q) := by
    calc S - g x = S - (S - g (x + q)) := by rw [h1]
      _ = g (x + q) := by abel
  exact h1'.symm



/-- The point obtained from `x₀` by shifting by `r·v + s·p + t·q` (`Bool` coefficients). -/
def boolShift (v p q : G) (r s t : Bool) : G :=
  (if r then v else 0) + (if s then p else 0) + (if t then q else 0)

/-- Value of an `α`-type function (alternating along `v`, periodic along `p,q`) at the
shifted point: flipped exactly when `r = true`. -/
lemma shiftval_alpha {Z : Type*} [AddCommGroup Z] (v p q : G) (g : G → Z) (S : Z) (x₀ : G)
    (hg : ∀ x : G, g (x + v) = S - g x)
    (hgp : ∀ x : G, g (x + p) = g x) (hgq : ∀ x : G, g (x + q) = g x)
    (r s t : Bool) :
    g (x₀ + boolShift v p q r s t) = (if r then S - g x₀ else g x₀) := by
  rcases r <;> rcases s <;> rcases t
  · simp [boolShift]
  · simp [boolShift]
    exact hgq x₀
  · simp [boolShift]
    exact hgp x₀
  · -- x₀ + p + q
    simp [boolShift]
    calc g (x₀ + (p + q)) = g (x₀ + q + p) := by congr 1; abel
      _ = g (x₀ + q) := hgp (x₀ + q)
      _ = g x₀ := hgq x₀
  · simp [boolShift]
    exact hg x₀
  · -- x₀ + v + q
    simp [boolShift]
    calc g (x₀ + (v + q)) = g ((x₀ + v) + q) := by congr 1; abel
      _ = g (x₀ + v) := hgq (x₀ + v)
      _ = S - g x₀ := hg x₀
  · -- x₀ + v + p
    simp [boolShift]
    calc g (x₀ + (v + p)) = g ((x₀ + v) + p) := by congr 1; abel
      _ = g (x₀ + v) := hgp (x₀ + v)
      _ = S - g x₀ := hg x₀
  · -- x₀ + v + p + q
    simp [boolShift]
    calc g (x₀ + (v + p + q)) = g ((x₀ + v + q) + p) := by congr 1; abel
      _ = g (x₀ + v + q) := hgp (x₀ + v + q)
      _ = g (x₀ + v) := hgq (x₀ + v)
      _ = S - g x₀ := hg x₀


/-- Value of a `τ′`-type function (alternating along `v` and along `p`, periodic along
`q`) at the shifted point: flipped exactly when `r ≠ s` (the `v`- and `p`-shifts each
flip, the `q`-shift does not). -/
lemma shiftval_tau' {Z : Type*} [AddCommGroup Z] (v p q : G) (g : G → Z) (S : Z) (x₀ : G)
    (hg : ∀ x : G, g (x + v) = S - g x) (hgp : ∀ x : G, g (x + p) = S - g x)
    (hgq : ∀ x : G, g (x + q) = g x) (r s t : Bool) :
    g (x₀ + boolShift v p q r s t) = (if r ≠ s then S - g x₀ else g x₀) := by
  rcases r <;> rcases s <;> rcases t
  · simp [boolShift]
  · simp [boolShift]
    exact hgq x₀
  · simp [boolShift]
    exact hgp x₀
  · -- x₀ + p + q
    simp [boolShift]
    calc g (x₀ + (p + q)) = g ((x₀ + p) + q) := by congr 1; abel
      _ = g (x₀ + p) := hgq (x₀ + p)
      _ = S - g x₀ := hgp x₀
  · simp [boolShift]
    exact hg x₀
  · -- x₀ + v + q
    simp [boolShift]
    calc g (x₀ + (v + q)) = g ((x₀ + v) + q) := by congr 1; abel
      _ = g (x₀ + v) := hgq (x₀ + v)
      _ = S - g x₀ := hg x₀
  · -- x₀ + v + p
    simp [boolShift]
    calc g (x₀ + (v + p)) = g ((x₀ + v) + p) := by congr 1; abel
      _ = S - g (x₀ + v) := hgp (x₀ + v)
      _ = S - (S - g x₀) := by rw [hg x₀]
      _ = g x₀ := by abel
  · -- x₀ + v + p + q
    simp [boolShift]
    calc g (x₀ + (v + p + q)) = g ((x₀ + v + p) + q) := by congr 1; abel
      _ = g (x₀ + v + p) := hgq (x₀ + v + p)
      _ = g x₀ := by
        calc g (x₀ + v + p) = g (x₀ + (v + p)) := by congr 1; abel
          _ = g ((x₀ + v) + p) := by congr 1; abel
          _ = S - g (x₀ + v) := hgp (x₀ + v)
          _ = S - (S - g x₀) := by rw [hg x₀]
          _ = g x₀ := by abel

/-- Value of a `τ″`-type function (alternating along `v` and along `q`, periodic along
`p`) at the shifted point: flipped exactly when `r ≠ t` (the `v`- and `q`-shifts each
flip, the `p`-shift does not). -/
lemma shiftval_tau'' {Z : Type*} [AddCommGroup Z] (v p q : G) (g : G → Z) (S : Z) (x₀ : G)
    (hg : ∀ x : G, g (x + v) = S - g x) (hgp : ∀ x : G, g (x + p) = g x)
    (hgq : ∀ x : G, g (x + q) = S - g x) (r s t : Bool) :
    g (x₀ + boolShift v p q r s t) = (if r ≠ t then S - g x₀ else g x₀) := by
  rcases r <;> rcases s <;> rcases t
  · simp [boolShift]
  · simp [boolShift]
    exact hgq x₀
  · simp [boolShift]
    exact hgp x₀
  · -- x₀ + p + q
    simp [boolShift]
    calc g (x₀ + (p + q)) = g ((x₀ + q) + p) := by congr 1; abel
      _ = g (x₀ + q) := hgp (x₀ + q)
      _ = S - g x₀ := hgq x₀
  · simp [boolShift]
    exact hg x₀
  · -- x₀ + v + q
    simp [boolShift]
    calc g (x₀ + (v + q)) = g ((x₀ + v) + q) := by congr 1; abel
      _ = S - g (x₀ + v) := hgq (x₀ + v)
      _ = S - (S - g x₀) := by rw [hg x₀]
      _ = g x₀ := by abel
  · -- x₀ + v + p
    simp [boolShift]
    calc g (x₀ + (v + p)) = g ((x₀ + v) + p) := by congr 1; abel
      _ = g (x₀ + v) := hgp (x₀ + v)
      _ = S - g x₀ := hg x₀
  · -- x₀ + v + p + q
    simp [boolShift]
    calc g (x₀ + (v + p + q)) = g ((x₀ + v + q) + p) := by congr 1; abel
      _ = g (x₀ + v + q) := hgp (x₀ + v + q)
      _ = g x₀ := by
        calc g (x₀ + v + q) = g (x₀ + (v + q)) := by congr 1; abel
          _ = g ((x₀ + v) + q) := by congr 1; abel
          _ = S - g (x₀ + v) := hgq (x₀ + v)
          _ = S - (S - g x₀) := by rw [hg x₀]
          _ = g x₀ := by abel


/-- For distinct elements `u ≠ v` of the pair `{a,b}`, the flip `a+b-u` equals `v`. -/
lemma pair_flip {Z : Type*} [CommRing Z] {a b u v : Z}
    (hu : u = a ∨ u = b) (hv : v = a ∨ v = b) (hne : u ≠ v) : a + b - u = v := by
  rcases hu with hua | hub
  · rcases hv with hva | hvb
    · exfalso
      rw [hua, hva] at hne
      exact hne rfl
    · rw [hua, hvb]
      ring
  · rcases hv with hva | hvb
    · rw [hub, hva]
      ring
    · exfalso
      rw [hub, hvb] at hne
      exact hne rfl

/-- Eight-representability: for every triple `(av, tv, uv) ∈ {a,b}×{h′,k′}×{h″,k″}`
there is a point whose `(α, τ′, τ″)`-values equal the triple.  The point is
`x₀ + r·v + s·p + t·q` where the coefficients are chosen so that `v` flips `α` (only),
`v` and `p` together govern `τ′`, and `v` and `q` together govern `τ″`. -/
lemma eight_representable (e : ℕ) (v p q : G) (x₀ : G)
    (α τ' τ'' : G → ZMod (2 ^ (e + 1)))
    (a b h' k' h'' k'' : ZMod (2 ^ (e + 1)))
    (hαv : ∀ x : G, α x = a ∨ α x = b)
    (hα : ∀ x : G, α (x + v) = a + b - α x)
    (hαp : ∀ x : G, α (x + p) = α x) (hαq : ∀ x : G, α (x + q) = α x)
    (hτ'v : ∀ x : G, τ' x = h' ∨ τ' x = k')
    (hτ' : ∀ x : G, τ' (x + v) = h' + k' - τ' x)
    (hτ'p : ∀ x : G, τ' (x + p) = h' + k' - τ' x)
    (hτ'q : ∀ x : G, τ' (x + q) = τ' x)
    (hτ''v : ∀ x : G, τ'' x = h'' ∨ τ'' x = k'')
    (hτ'' : ∀ x : G, τ'' (x + v) = h'' + k'' - τ'' x)
    (hτ''p : ∀ x : G, τ'' (x + p) = τ'' x)
    (hτ''q : ∀ x : G, τ'' (x + q) = h'' + k'' - τ'' x) :
    ∀ av ∈ ({a, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ tv ∈ ({h', k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ uv ∈ ({h'', k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ x : G, α x = av ∧ τ' x = tv ∧ τ'' x = uv := by
  intro av hav tv htv uv huv
  simp at hav htv huv
  by_cases hae : α x₀ = av
  · by_cases hte : τ' x₀ = tv
    · by_cases hue : τ'' x₀ = uv
      · -- all already attained at x₀
        exact ⟨x₀, hae, hte, hue⟩
      · refine ⟨x₀ + boolShift v p q false false true, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq false false true]
          simp [hae]
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q false false true]
          simp [hte]
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q false false true]
          simp
          exact pair_flip (hτ''v x₀) huv hue
    · by_cases hue : τ'' x₀ = uv
      · refine ⟨x₀ + boolShift v p q false true false, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq false true false]
          simp [hae]
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q false true false]
          simp
          exact pair_flip (hτ'v x₀) htv hte
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q false true false]
          simp [hue]
      · refine ⟨x₀ + boolShift v p q false true true, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq false true true]
          simp [hae]
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q false true true]
          simp
          exact pair_flip (hτ'v x₀) htv hte
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q false true true]
          simp
          exact pair_flip (hτ''v x₀) huv hue
  · by_cases hte : τ' x₀ = tv
    · by_cases hue : τ'' x₀ = uv
      · refine ⟨x₀ + boolShift v p q true true true, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq true true true]
          simp
          exact pair_flip (hαv x₀) hav hae
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q true true true]
          simp [hte]
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q true true true]
          simp [hue]
      · refine ⟨x₀ + boolShift v p q true true false, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq true true false]
          simp
          exact pair_flip (hαv x₀) hav hae
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q true true false]
          simp [hte]
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q true true false]
          simp
          exact pair_flip (hτ''v x₀) huv hue
    · by_cases hue : τ'' x₀ = uv
      · refine ⟨x₀ + boolShift v p q true false true, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq true false true]
          simp
          exact pair_flip (hαv x₀) hav hae
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q true false true]
          simp
          exact pair_flip (hτ'v x₀) htv hte
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q true false true]
          simp [hue]
      · refine ⟨x₀ + boolShift v p q true false false, ?_, ?_, ?_⟩
        · rw [shiftval_alpha v p q α (a + b) x₀ hα hαp hαq true false false]
          simp
          exact pair_flip (hαv x₀) hav hae
        · rw [shiftval_tau' v p q τ' (h' + k') x₀ hτ' hτ'p hτ'q true false false]
          simp
          exact pair_flip (hτ'v x₀) htv hte
        · rw [shiftval_tau'' v p q τ'' (h'' + k'') x₀ hτ'' hτ''p hτ''q true false false]
          simp
          exact pair_flip (hτ''v x₀) huv hue


/-! ## Step (a): `force_compat`'s representation hypothesis from representability

Given the eight-representability of `(α, τ′, τ″)` and the pointwise linear constraint
`α y + τ′ y + τ″ y = 2β y + γ y + z`, every triple `(av, tv, uv)` of pair-values is
realized at a point, hence representable as `2β(x)+γ(x)+z` with `β(x) ∈ {c,d}` and
`γ(x) ∈ {f,g}` — exactly the `href` hypothesis of `force_compat`. -/

/-- The representation hypothesis of `force_compat` from the representability data. -/
lemma href_from_representable (e : ℕ) (v p q : G) (x₀ : G)
    (α β γ τ' τ'' : G → ZMod (2 ^ (e + 1)))
    (a b c d f g h' k' h'' k'' z : ZMod (2 ^ (e + 1)))
    (hαv : ∀ x : G, α x = a ∨ α x = b)
    (hα : ∀ x : G, α (x + v) = a + b - α x)
    (hαp : ∀ x : G, α (x + p) = α x) (hαq : ∀ x : G, α (x + q) = α x)
    (hτ'v : ∀ x : G, τ' x = h' ∨ τ' x = k')
    (hτ' : ∀ x : G, τ' (x + v) = h' + k' - τ' x)
    (hτ'p : ∀ x : G, τ' (x + p) = h' + k' - τ' x)
    (hτ'q : ∀ x : G, τ' (x + q) = τ' x)
    (hτ''v : ∀ x : G, τ'' x = h'' ∨ τ'' x = k'')
    (hτ'' : ∀ x : G, τ'' (x + v) = h'' + k'' - τ'' x)
    (hτ''p : ∀ x : G, τ'' (x + p) = τ'' x)
    (hτ''q : ∀ x : G, τ'' (x + q) = h'' + k'' - τ'' x)
    (hβv : ∀ x : G, β x = c ∨ β x = d) (hγv : ∀ x : G, γ x = f ∨ γ x = g)
    (hlin : ∀ y : G, α y + τ' y + τ'' y = 2 * β y + γ y + z) :
    ∀ av ∈ ({a, b} : Set (ZMod (2 ^ (e + 1)))),
      ∀ tv ∈ ({h', k'} : Set (ZMod (2 ^ (e + 1)))),
        ∀ uv ∈ ({h'', k''} : Set (ZMod (2 ^ (e + 1)))),
          ∃ βv ∈ ({c, d} : Set (ZMod (2 ^ (e + 1)))),
            ∃ γv ∈ ({f, g} : Set (ZMod (2 ^ (e + 1)))),
              av + tv + uv = 2 * βv + γv + z := by
  intro av hav tv htv uv huv
  rcases eight_representable e v p q x₀ α τ' τ'' a b h' k' h'' k''
    hαv hα hαp hαq hτ'v hτ' hτ'p hτ'q hτ''v hτ'' hτ''p hτ''q
    av hav tv htv uv huv with ⟨x, hxα, hxτ', hxτ''⟩
  have hl := hlin x
  refine ⟨β x, hβv x, γ x, hγv x, ?_⟩
  rw [← hxα, ← hxτ', ← hxτ'']
  exact hl


/-! ## `P* ⇒` pair-`CompBool`: the compatibility of `α₁` and `α₂`

From a `P*`-octuplet we extract, for `i = 1` and `i = 2`, the value-pairs and the
`force_compat` hypotheses (parity witnesses from the `IsBooleanAlt` data, the sum
equation from `zsum_of_constraints` via the pointwise linear constraint, and the
representation hypothesis from `href_from_representable` fed by `eight_representable`).
`force_compat` yields that `{a_i,b_i}` is a translate of the `τ′`-pair, so by
transitivity `{a₁,b₁}` and `{a₂,b₂}` are translates, and
`compatible_iff_pair_translate'` gives `CompatibleFunctions`. -/

/-- The two `P*`-coordinates `α₁ = coord 0` and `α₂ = coord 1` are compatible. -/
lemma pairPstar_compatible (e : ℕ) (he : 1 ≤ e) (v p q : G)
    (tup : G → (Fin 8 → ZMod (2 ^ (e + 1)))) (hstar : PairPstar e v p q tup) :
    CompatibleFunctions (coord tup (0 : Fin 8)) (coord tup (1 : Fin 8)) := by
  let Z := ZMod (2 ^ (e + 1))
  rcases hstar with ⟨hbool, hper, hl1, hl2⟩
  -- ---- witnesses at the coordinates (i = 1 side) ----
  rcases hbool (0 : Fin 8) with ⟨a1, b1, hEa1, hOa1, hval1, hswap1⟩
  rcases hbool (2 : Fin 8) with ⟨c1, d1, hEc1, hOc1, hval2, hswap2⟩
  rcases hbool (4 : Fin 8) with ⟨f1, g1, hEf1, hOg1, hval4, hswap4⟩
  rcases hbool (6 : Fin 8) with ⟨hp, kp, hEhp, hOkp, hval6, hswap6⟩
  rcases hbool (7 : Fin 8) with ⟨hpp, kpp, hEhpp, hOkpp, hval7, hswap7⟩
  -- per-coordinate periodicities from `P*` items (i),(iv),(v)
  have hper0 := hper (0 : Fin 8)
  simp [PairPstarPeriod] at hper0
  rcases hper0 with ⟨hper0p, hper0q⟩
  have hper6 := hper (6 : Fin 8)
  simp [PairPstarPeriod] at hper6
  rcases hper6 with ⟨hper6vp, hper6q⟩
  have hper7 := hper (7 : Fin 8)
  simp [PairPstarPeriod] at hper7
  rcases hper7 with ⟨hper7p, hper7vq⟩
  -- flip laws for τ′ (coord 6) and τ″ (coord 7)
  have hval6p : ∀ x : G, (coord tup (6 : Fin 8)) (x + p) =
      hp + kp - (coord tup (6 : Fin 8)) x :=
    alt_periodic_flip v p (coord tup (6 : Fin 8)) (hp + kp) hswap6 hper6vp
  have hval7q : ∀ x : G, (coord tup (7 : Fin 8)) (x + q) =
      hpp + kpp - (coord tup (7 : Fin 8)) x :=
    alt_periodic_flip' v q (coord tup (7 : Fin 8)) (hpp + kpp) hswap7 hper7vq
  -- pointwise linear constraints (items (vi))
  rcases pairPstar_lin1 e tup hl1 with ⟨z1, hlin1⟩
  rcases pairPstar_lin2 e tup hl2 with ⟨z2, hlin2⟩
  -- the sum equations
  have hsum1 : (a1 + b1) + (hp + kp) + (hpp + kpp) =
      2 * (c1 + d1) + (f1 + g1) + 2 * z1 :=
    zsum_of_constraints e v (coord tup (0 : Fin 8)) (coord tup (2 : Fin 8))
      (coord tup (4 : Fin 8)) (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
      a1 b1 c1 d1 f1 g1 hp kp hpp kpp z1 (0 : G)
      hswap1 hswap2 hswap4 hswap6 hswap7 hlin1
  -- the representation hypothesis for i = 1
  have href1 : ∀ av ∈ ({a1, b1} : Set Z), ∀ tv ∈ ({hp, kp} : Set Z),
      ∀ uv ∈ ({hpp, kpp} : Set Z),
        ∃ βv ∈ ({c1, d1} : Set Z), ∃ γv ∈ ({f1, g1} : Set Z),
          av + tv + uv = 2 * βv + γv + z1 := by
    simpa [Z] using (href_from_representable e v p q (0 : G)
      (coord tup (0 : Fin 8)) (coord tup (2 : Fin 8)) (coord tup (4 : Fin 8))
      (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
      a1 b1 c1 d1 f1 g1 hp kp hpp kpp z1
      hval1 hswap1 hper0p hper0q hval6 hswap6 hval6p hper6q
      hval7 hswap7 hper7p hval7q hval2 hval4 hlin1)
  have hfc1 := force_compat e he (a := a1) (b := b1) (c := c1) (d := d1)
    (f := f1) (g := g1) (h' := hp) (k' := kp) (h'' := hpp) (k'' := kpp) (z := z1)
    hEa1 hOa1 hEc1 hOc1 hEf1 hOg1 hEhp hOkp hEhpp hOkpp hsum1 href1
  -- ---- witnesses at the coordinates (i = 2 side) ----
  rcases hbool (1 : Fin 8) with ⟨a2, b2, hEa2, hOa2, hval2', hswap2'⟩
  rcases hbool (3 : Fin 8) with ⟨c2, d2, hEc2, hOc2, hval3, hswap3⟩
  rcases hbool (5 : Fin 8) with ⟨f2, g2, hEf2, hOg2, hval5, hswap5⟩
  have hper1 := hper (1 : Fin 8)
  simp [PairPstarPeriod] at hper1
  rcases hper1 with ⟨hper1p, hper1q⟩
  have hsum2 : (a2 + b2) + (hp + kp) + (hpp + kpp) =
      2 * (c2 + d2) + (f2 + g2) + 2 * z2 :=
    zsum_of_constraints e v (coord tup (1 : Fin 8)) (coord tup (3 : Fin 8))
      (coord tup (5 : Fin 8)) (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
      a2 b2 c2 d2 f2 g2 hp kp hpp kpp z2 (0 : G)
      hswap2' hswap3 hswap5 hswap6 hswap7 hlin2
  have href2 : ∀ av ∈ ({a2, b2} : Set Z), ∀ tv ∈ ({hp, kp} : Set Z),
      ∀ uv ∈ ({hpp, kpp} : Set Z),
        ∃ βv ∈ ({c2, d2} : Set Z), ∃ γv ∈ ({f2, g2} : Set Z),
          av + tv + uv = 2 * βv + γv + z2 := by
    simpa [Z] using (href_from_representable e v p q (0 : G)
      (coord tup (1 : Fin 8)) (coord tup (3 : Fin 8)) (coord tup (5 : Fin 8))
      (coord tup (6 : Fin 8)) (coord tup (7 : Fin 8))
      a2 b2 c2 d2 f2 g2 hp kp hpp kpp z2
      hval2' hswap2' hper1p hper1q hval6 hswap6 hval6p hper6q
      hval7 hswap7 hper7p hval7q hval3 hval5 hlin2)
  have hfc2 := force_compat e he (a := a2) (b := b2) (c := c2) (d := d2)
    (f := f2) (g := g2) (h' := hp) (k' := kp) (h'' := hpp) (k'' := kpp) (z := z2)
    hEa2 hOa2 hEc2 hOc2 hEf2 hOg2 hEhp hOkp hEhpp hOkpp hsum2 href2
  -- ---- conclude compatibility of α₁ and α₂ ----
  -- {a1,b1} translates {hp,kp} (hfc1.1); {hp,kp} translates {a2,b2} (symm of hfc2.1)
  have hAB : PairTranslate ({a1, b1} : Set Z) ({a2, b2} : Set Z) := by
    exact pairTranslate_trans hfc1.1 (pairTranslate_symm hfc2.1)
  have hb1' : IsBooleanAlt e v (coord tup (0 : Fin 8)) := hbool (0 : Fin 8)
  have hb2' : IsBooleanAlt e v (coord tup (1 : Fin 8)) := hbool (1 : Fin 8)
  exact (compatible_iff_pair_translate' e v (coord tup (0 : Fin 8))
    (coord tup (1 : Fin 8)) hb1' hb2').mpr
    ⟨a1, b1, a2, b2, hval1, hswap1, hval2', hswap2', by simpa [Z] using hAB⟩


/-! ## The `⟨v,p,q⟩ ≅ (ℤ/2)³` structure (forward direction of multi-express)

The forward direction `pair-CompBool ⇒ P*` constructs the auxiliary `τ′`, `τ″` on the
cosets of the subgroup generated by `v,p,q`, so it needs that subgroup to be a genuine
copy of `(ℤ/2)³`: the elements `v,p,q` are of order `2` and there are no other additive
relations, i.e. the kernel of `(r,s,t) ↦ r•v+s•p+t•q : ℤ³ → G` is exactly `(2ℤ)³`.
Equivalently (`hind`): any integer relation has all-even coefficients.  From this the
`{0,1}`-coefficient representation is unique. -/

/-- Subtracting two integer combinations distributes over the coefficients. -/
lemma zsmul_comb_sub {G : Type*} [AddCommGroup G] (v p q : G) (r s t r' s' t' : ℤ) :
    (r • v + s • p + t • q) - (r' • v + s' • p + t' • q) =
      (r - r') • v + (s - s') • p + (t - t') • q := by
  calc
    (r • v + s • p + t • q) - (r' • v + s' • p + t' • q) =
        (r • v - r' • v) + (s • p - s' • p) + (t • q - t' • q) := by abel
    _ = (r - r') • v + (s - s') • p + (t - t') • q := by
      have h1 : (r - r') • v = r • v - r' • v := by
        rw [sub_zsmul]
        rw [sub_eq_add_neg]
      have h2 : (s - s') • p = s • p - s' • p := by
        rw [sub_zsmul]
        rw [sub_eq_add_neg]
      have h3 : (t - t') • q = t • q - t' • q := by
        rw [sub_zsmul]
        rw [sub_eq_add_neg]
      rw [← h1, ← h2, ← h3]

/-- If the only integer relations among `v,p,q` are the even ones (so that `v,p,q`
generate a copy of `(ℤ/2)³`), then the `{0,1}`-coefficient representation of an
element is unique. -/
lemma triple_unique {G : Type*} [AddCommGroup G] (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (r s t r' s' t' : ℤ) (hr01 : r = 0 ∨ r = 1) (hs01 : s = 0 ∨ s = 1)
    (ht01 : t = 0 ∨ t = 1) (hr'01 : r' = 0 ∨ r' = 1) (hs'01 : s' = 0 ∨ s' = 1)
    (ht'01 : t' = 0 ∨ t' = 1)
    (heq : r • v + s • p + t • q = r' • v + s' • p + t' • q) :
    r = r' ∧ s = s' ∧ t = t' := by
  have hdiff : (r - r') • v + (s - s') • p + (t - t') • q = 0 := by
    have h1 : (r • v + s • p + t • q) - (r' • v + s' • p + t' • q) = 0 := by
      rw [heq]
      abel
    rw [zsmul_comb_sub] at h1
    exact h1
  rcases hind (r - r') (s - s') (t - t') hdiff with ⟨he1, he2, he3⟩
  have hrr' : r = r' := by
    rcases hr01 with rfl | rfl <;> rcases hr'01 with rfl | rfl
    · rfl
    · exfalso
      norm_num at he1
    · exfalso
      norm_num at he1
    · rfl
  have hss' : s = s' := by
    rcases hs01 with rfl | rfl <;> rcases hs'01 with rfl | rfl
    · rfl
    · exfalso
      norm_num at he2
    · exfalso
      norm_num at he2
    · rfl
  have htt' : t = t' := by
    rcases ht01 with rfl | rfl <;> rcases ht'01 with rfl | rfl
    · rfl
    · exfalso
      norm_num at he3
    · exfalso
      norm_num at he3
    · rfl
  exact ⟨hrr', hss', htt'⟩


/-! ## Step (a1): the subgroup generated by `v,p,q` and its cosets

The forward direction constructs the auxiliary `τ′`, `τ″` relative to a partition of
`G` into cosets of the subgroup `K := ⟨v,p,q⟩`.  Concretely we take
`K = zSpanSubgroup v p q`, the (additive) subgroup of integer combinations
`r•v + s•p + t•q` — an `AddSubgroup`, hence a valid object for the additive-quotient
machinery; under the `(ℤ/2)³` hypotheses (`hind` + order 2) it is the image of
`{0,1}³` with the unique-decomposition of `triple_unique`. -/

/-- The subgroup of `G` generated by `v, p, q` (integer combinations). -/
def zSpanSubgroup (v p q : G) : AddSubgroup G where
  carrier := {g : G | ∃ r s t : ℤ, g = r • v + s • p + t • q}
  zero_mem' := by
    refine ⟨0, 0, 0, ?_⟩
    simp
  add_mem' := by
    rintro a b ⟨ra, sa, ta, rfl⟩ ⟨rb, sb, tb, rfl⟩
    refine ⟨ra + rb, sa + sb, ta + tb, ?_⟩
    rw [add_zsmul, add_zsmul, add_zsmul]
    abel
  neg_mem' := by
    rintro a ⟨r, s, t, rfl⟩
    refine ⟨-r, -s, -t, ?_⟩
    rw [neg_zsmul, neg_zsmul, neg_zsmul]
    abel

/-- `v` lies in the span of `v, p, q`. -/
lemma zSpan_mem_v (v p q : G) : v ∈ zSpanSubgroup v p q := by
  refine ⟨1, 0, 0, ?_⟩
  simp

/-- `p` lies in the span of `v, p, q`. -/
lemma zSpan_mem_p (v p q : G) : p ∈ zSpanSubgroup v p q := by
  refine ⟨0, 1, 0, ?_⟩
  simp

/-- `q` lies in the span of `v, p, q`. -/
lemma zSpan_mem_q (v p q : G) : q ∈ zSpanSubgroup v p q := by
  refine ⟨0, 0, 1, ?_⟩
  simp


/-! ## The `{0,1}`-coefficient reduction of span elements

Under order-two hypotheses on `v,p,q`, every integer multiple `r • v` equals `r₀ • v`
for a `{0,1}`-coefficient `r₀ = r % 2` (write `r = (r/2)·2 + r%2` and use
`(2k)•v = k•(2•v) = 0`); consequently every element of `zSpanSubgroup v p q` has a
`{0,1}`-coefficient representation (uniqueness: `triple_unique`). -/

/-- Under `2•v = 0` every integer multiple of `v` is a `{0,1}`-multiple. -/
lemma zsmul_01_reduce {G : Type*} [AddCommGroup G] (v : G) (h2v : (2 : ℤ) • v = 0) (r : ℤ) :
    ∃ r0 : ℤ, (r0 = 0 ∨ r0 = 1) ∧ r • v = r0 • v := by
  let r0 : ℤ := r % 2
  have hr0 : r0 = 0 ∨ r0 = 1 := by
    dsimp [r0]
    exact Int.emod_two_eq_zero_or_one r
  refine ⟨r0, hr0, ?_⟩
  have hr : r = (r / 2) * 2 + r0 := by
    dsimp [r0]
    have h := (Int.emod_add_mul_ediv r 2).symm
    calc r = r % 2 + 2 * (r / 2) := h
      _ = (r / 2) * 2 + r % 2 := by rw [mul_comm, add_comm]
  rw [hr]
  rw [add_zsmul]
  have hz : ((r / 2) * 2) • v = 0 := by
    rw [← smul_smul]
    rw [h2v]
    simp
  rw [hz]
  simp

/-- Every element of the span of `v,p,q` has a `{0,1}`-coefficient representation,
provided `v,p,q` have order `2`. -/
lemma zSpan_reduce01 {G : Type*} [AddCommGroup G] (v p q : G)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (r s t : ℤ) :
    ∃ r0 s0 t0 : ℤ, (r0 = 0 ∨ r0 = 1) ∧ (s0 = 0 ∨ s0 = 1) ∧ (t0 = 0 ∨ t0 = 1) ∧
      r • v + s • p + t • q = r0 • v + s0 • p + t0 • q := by
  rcases zsmul_01_reduce v h2v r with ⟨r0, hr0, hr⟩
  rcases zsmul_01_reduce p h2p s with ⟨s0, hs0, hs⟩
  rcases zsmul_01_reduce q h2q t with ⟨t0, ht0, ht⟩
  refine ⟨r0, s0, t0, hr0, hs0, ht0, ?_⟩
  rw [hr, hs, ht]


/-! ## The quotient `G ⧸ zSpanSubgroup v p q` and a section

Every additive subgroup quotient has a (choice-based) section, and then every
`g : G` decomposes as `g = s (mk g) + k` with `k` in the subgroup — the starting point
for defining the auxiliary functions of the forward direction relative to the
coset partition of `⟨v,p,q⟩`. -/

/-- Existence of a section of the quotient map of an additive subgroup. -/
lemma quotient_section (S : AddSubgroup G) : ∃ s : (G ⧸ S) → G,
    ∀ C : G ⧸ S, QuotientAddGroup.mk (s := S) (s C) = C := by
  refine ⟨fun C => Classical.choose (QuotientAddGroup.mk_surjective (s := S) C), ?_⟩
  intro C
  exact Classical.choose_spec (QuotientAddGroup.mk_surjective (s := S) C)

/-- With a section of the quotient map, every `g : G` lies in `s(mk g) + S`. -/
lemma quotient_decompose (S : AddSubgroup G) (s : (G ⧸ S) → G)
    (hs : ∀ C : G ⧸ S, QuotientAddGroup.mk (s := S) (s C) = C) (g : G) :
    ∃ k : G, k ∈ S ∧ g = s (QuotientAddGroup.mk (s := S) g) + k := by
  let C : G ⧸ S := QuotientAddGroup.mk (s := S) g
  have hC : QuotientAddGroup.mk (s := S) (s C) = QuotientAddGroup.mk (s := S) g := by
    rw [hs C]
  have hk : -(s C) + g ∈ S := (QuotientAddGroup.eq (s := S) (a := s C) (b := g)).mp hC
  refine ⟨-(s C) + g, hk, ?_⟩
  abel

/-- Every element of `G` is a coset representative plus an element of the span of
`v,p,q`. -/
lemma zSpan_decompose (v p q : G) (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    ∃ k : G, k ∈ zSpanSubgroup v p q ∧ g = s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g) + k :=
  quotient_decompose (zSpanSubgroup v p q) s hs g


/-! ## The `{0,1}`-coefficient extractor of span elements

For `k` in `zSpanSubgroup v p q` (with `v,p,q` of order 2) the coefficient extractor
`spanCoeff` chooses a `{0,1}`-coefficient representation; `triple_unique` makes it
independent of the choice.  Shifting `k` by `v` flips the first coefficient (the seed
of the `τ′`-alternation). -/



/-- Existence of a `{0,1}`-coefficient representation of a span element (tuple form). -/
lemma spanCoeff_exists (v p q : G) (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0)
    (h2q : (2 : ℤ) • q = 0) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    ∃ c : ℤ × ℤ × ℤ, (c.1 = 0 ∨ c.1 = 1) ∧ (c.2.1 = 0 ∨ c.2.1 = 1) ∧
      (c.2.2 = 0 ∨ c.2.2 = 1) ∧ k = c.1 • v + c.2.1 • p + c.2.2 • q := by
  rcases hk with ⟨r, s, t, rfl⟩
  rcases zSpan_reduce01 v p q h2v h2p h2q r s t with ⟨r0, s0, t0, hr0, hs0, ht0, hsum⟩
  exact ⟨(r0, s0, t0), hr0, hs0, ht0, hsum⟩

/-- The chosen `{0,1}`-coefficients of a span element. -/
noncomputable def spanCoeff (v p q : G) (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0)
    (h2q : (2 : ℤ) • q = 0) (k : G) (hk : k ∈ zSpanSubgroup v p q) : ℤ × ℤ × ℤ :=
  Classical.choose (spanCoeff_exists v p q h2v h2p h2q k hk)

/-- The chosen coefficients are `{0,1}` and reconstruct `k`. -/
lemma spanCoeff_spec (v p q : G) (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0)
    (h2q : (2 : ℤ) • q = 0) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    (c.1 = 0 ∨ c.1 = 1) ∧ (c.2.1 = 0 ∨ c.2.1 = 1) ∧ (c.2.2 = 0 ∨ c.2.2 = 1) ∧
      k = c.1 • v + c.2.1 • p + c.2.2 • q := by
  simpa [spanCoeff] using (Classical.choose_spec (spanCoeff_exists v p q h2v h2p h2q k hk))


/-- Shifting a `{0,1}`-combination by `v+p` flips the `v`- and `p`-coefficients
(given `2v = 2p = 0`). -/
lemma zsmul_shift_vp {G : Type*} [AddCommGroup G] (v p q : G) (r s t : ℤ)
    (hr : r = 0 ∨ r = 1) (hs : s = 0 ∨ s = 1)
    (hv2 : (2 : ℤ) • v = 0) (hp2 : (2 : ℤ) • p = 0) :
    (r • v + s • p + t • q) + (v + p) = (1 - r) • v + (1 - s) • p + t • q := by
  have hv : v + v = 0 := by
    rw [← two_zsmul]
    exact hv2
  have hp : p + p = 0 := by
    rw [← two_zsmul]
    exact hp2
  rcases hr with rfl | rfl
  · rcases hs with rfl | rfl
    · simp
      abel
    · simp
      calc p + t • q + (v + p) = t • q + v + (p + p) := by abel
        _ = t • q + v := by rw [hp]; abel
        _ = v + t • q := by abel
  · rcases hs with rfl | rfl
    · simp
      calc v + t • q + (v + p) = t • q + (v + v) + p := by abel
        _ = t • q + p := by rw [hv]; abel
        _ = p + t • q := by abel
    · simp
      calc v + p + t • q + (v + p) = t • q + (v + v) + (p + p) := by abel
        _ = t • q := by rw [hv, hp]; abel

/-- The span is closed under adding `v`. -/
lemma zSpan_add_v (v p q : G) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    k + v ∈ zSpanSubgroup v p q := by
  exact (zSpanSubgroup v p q).add_mem hk (zSpan_mem_v v p q)

/-- Shifting a span element by `v` flips its first `{0,1}`-coefficient and leaves the
other two unchanged (uniqueness of the decomposition via `triple_unique`). -/
lemma spanCoeff_shift_v (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    let c' := spanCoeff v p q h2v h2p h2q (k + v) (zSpan_add_v v p q k hk)
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = c.2.2) := by
  let c := spanCoeff v p q h2v h2p h2q k hk
  let c' := spanCoeff v p q h2v h2p h2q (k + v) (zSpan_add_v v p q k hk)
  have hspec := spanCoeff_spec v p q h2v h2p h2q k hk
  have hspec' := spanCoeff_spec v p q h2v h2p h2q (k + v) (zSpan_add_v v p q k hk)
  rcases hspec with ⟨hr, hs, ht, hkeq⟩
  rcases hspec' with ⟨hr', hs', ht', hkeq'⟩
  have hcand01 : (1 - c.1 = 0 ∨ 1 - c.1 = 1) := by
    rcases hr with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have hcand_eq : k + v = (1 - c.1) • v + c.2.1 • p + c.2.2 • q := by
    rcases hr with h0 | h1
    · rw [h0] at hkeq ⊢
      simp at hkeq
      rw [hkeq]
      simp
      abel
    · rw [h1] at hkeq
      simp at hkeq
      have hv2 : v + v = 0 := by
        rw [← two_zsmul]
        exact h2v
      calc
        k + v = (v + c.2.1 • p + c.2.2 • q) + v := by rw [hkeq]
        _ = (v + v) + c.2.1 • p + c.2.2 • q := by abel
        _ = c.2.1 • p + c.2.2 • q := by rw [hv2]; abel
        _ = (1 - c.1) • v + c.2.1 • p + c.2.2 • q := by rw [h1]; simp
  have huniq := triple_unique v p q hind (1 - c.1) c.2.1 c.2.2 c'.1 c'.2.1 c'.2.2
    hcand01 hs ht hr' hs' ht' (by
      rw [← hcand_eq, hkeq'])
  exact ⟨huniq.1.symm, huniq.2.1.symm, huniq.2.2.symm⟩


/-- The span is closed under adding `v + p`. -/
lemma zSpan_add_vp (v p q : G) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    k + (v + p) ∈ zSpanSubgroup v p q := by
  exact (zSpanSubgroup v p q).add_mem hk
    ((zSpanSubgroup v p q).add_mem (zSpan_mem_v v p q) (zSpan_mem_p v p q))

/-- The span is closed under adding `q`. -/
lemma zSpan_add_q (v p q : G) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    k + q ∈ zSpanSubgroup v p q := by
  exact (zSpanSubgroup v p q).add_mem hk (zSpan_mem_q v p q)

/-- Shifting a span element by `v+p` flips its first two `{0,1}`-coefficients and
leaves the third unchanged. -/
lemma spanCoeff_shift_vp (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    let c' := spanCoeff v p q h2v h2p h2q (k + (v + p)) (zSpan_add_vp v p q k hk)
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = 1 - c.2.1) ∧ (c'.2.2 = c.2.2) := by
  let c := spanCoeff v p q h2v h2p h2q k hk
  let c' := spanCoeff v p q h2v h2p h2q (k + (v + p)) (zSpan_add_vp v p q k hk)
  have hspec := spanCoeff_spec v p q h2v h2p h2q k hk
  have hspec' := spanCoeff_spec v p q h2v h2p h2q (k + (v + p)) (zSpan_add_vp v p q k hk)
  rcases hspec with ⟨hr, hs, ht, hkeq⟩
  rcases hspec' with ⟨hr', hs', ht', hkeq'⟩
  have h01r : 1 - c.1 = 0 ∨ 1 - c.1 = 1 := by
    rcases hr with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have h01s : 1 - c.2.1 = 0 ∨ 1 - c.2.1 = 1 := by
    rcases hs with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have hcand_eq : k + (v + p) = (1 - c.1) • v + (1 - c.2.1) • p + c.2.2 • q := by
    rw [hkeq]
    exact zsmul_shift_vp v p q c.1 c.2.1 c.2.2 hr hs h2v h2p
  have huniq := triple_unique v p q hind (1 - c.1) (1 - c.2.1) c.2.2 c'.1 c'.2.1 c'.2.2
    h01r h01s ht hr' hs' ht' (by
      rw [← hcand_eq, hkeq'])
  exact ⟨huniq.1.symm, huniq.2.1.symm, huniq.2.2.symm⟩


/-- Shifting `t•g` by `g` flips the `{0,1}`-coefficient `t` (given `2g = 0`). -/
lemma zsmul_single_flip {G : Type*} [AddCommGroup G] (g : G) (t : ℤ)
    (ht : t = 0 ∨ t = 1) (h2 : (2 : ℤ) • g = 0) : t • g + g = (1 - t) • g := by
  have hg : g + g = 0 := by
    rw [← two_zsmul]
    exact h2
  rcases ht with rfl | rfl
  · simp
  · simp [hg]

/-- Shifting a span element by `q` flips its third `{0,1}`-coefficient and leaves the
first two unchanged. -/
lemma spanCoeff_shift_q (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    let c' := spanCoeff v p q h2v h2p h2q (k + q) (zSpan_add_q v p q k hk)
    (c'.1 = c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = 1 - c.2.2) := by
  let c := spanCoeff v p q h2v h2p h2q k hk
  let c' := spanCoeff v p q h2v h2p h2q (k + q) (zSpan_add_q v p q k hk)
  have hspec := spanCoeff_spec v p q h2v h2p h2q k hk
  have hspec' := spanCoeff_spec v p q h2v h2p h2q (k + q) (zSpan_add_q v p q k hk)
  rcases hspec with ⟨hr, hs, ht, hkeq⟩
  rcases hspec' with ⟨hr', hs', ht', hkeq'⟩
  have hcand_eq : k + q = c.1 • v + c.2.1 • p + (1 - c.2.2) • q := by
    rw [hkeq]
    calc
      c.1 • v + c.2.1 • p + c.2.2 • q + q =
          c.1 • v + c.2.1 • p + (c.2.2 • q + q) := by abel
      _ = c.1 • v + c.2.1 • p + (1 - c.2.2) • q := by
        rw [zsmul_single_flip q c.2.2 ht h2q]
  have huniq := triple_unique v p q hind c.1 c.2.1 (1 - c.2.2) c'.1 c'.2.1 c'.2.2
    hr hs (by
      rcases ht with h0 | h1
      · right
        rw [h0]
        norm_num
      · left
        rw [h1]
        norm_num) hr' hs' ht' (by
      rw [← hcand_eq, hkeq'])
  exact ⟨huniq.1.symm, huniq.2.1.symm, huniq.2.2.symm⟩

/-- The span is closed under adding `p`. -/
lemma zSpan_add_p (v p q : G) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    k + p ∈ zSpanSubgroup v p q := by
  exact (zSpanSubgroup v p q).add_mem hk (zSpan_mem_p v p q)

/-- Shifting a span element by `p` flips its second `{0,1}`-coefficient and leaves the
other two unchanged. -/
lemma spanCoeff_shift_p (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    let c' := spanCoeff v p q h2v h2p h2q (k + p) (zSpan_add_p v p q k hk)
    (c'.1 = c.1) ∧ (c'.2.1 = 1 - c.2.1) ∧ (c'.2.2 = c.2.2) := by
  let c := spanCoeff v p q h2v h2p h2q k hk
  let c' := spanCoeff v p q h2v h2p h2q (k + p) (zSpan_add_p v p q k hk)
  have hspec := spanCoeff_spec v p q h2v h2p h2q k hk
  have hspec' := spanCoeff_spec v p q h2v h2p h2q (k + p) (zSpan_add_p v p q k hk)
  rcases hspec with ⟨hr, hs, ht, hkeq⟩
  rcases hspec' with ⟨hr', hs', ht', hkeq'⟩
  have hcand_eq : k + p = c.1 • v + (1 - c.2.1) • p + c.2.2 • q := by
    rw [hkeq]
    calc
      c.1 • v + c.2.1 • p + c.2.2 • q + p =
          c.1 • v + (c.2.1 • p + p) + c.2.2 • q := by abel
      _ = c.1 • v + (1 - c.2.1) • p + c.2.2 • q := by
        rw [zsmul_single_flip p c.2.1 hs h2p]
  have h01s : 1 - c.2.1 = 0 ∨ 1 - c.2.1 = 1 := by
    rcases hs with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have huniq := triple_unique v p q hind c.1 (1 - c.2.1) c.2.2 c'.1 c'.2.1 c'.2.2
    hr h01s ht hr' hs' ht' (by
      rw [← hcand_eq, hkeq'])
  exact ⟨huniq.1.symm, huniq.2.1.symm, huniq.2.2.symm⟩


/-- Shifting a `{0,1}`-combination by `v+q` flips the `v`- and `q`-coefficients
(given `2v = 2q = 0`). -/
lemma zsmul_shift_vq {G : Type*} [AddCommGroup G] (v p q : G) (r s t : ℤ)
    (hr : r = 0 ∨ r = 1) (ht : t = 0 ∨ t = 1)
    (hv2 : (2 : ℤ) • v = 0) (hq2 : (2 : ℤ) • q = 0) :
    (r • v + s • p + t • q) + (v + q) = (1 - r) • v + s • p + (1 - t) • q := by
  have hv : v + v = 0 := by
    rw [← two_zsmul]
    exact hv2
  have hq : q + q = 0 := by
    rw [← two_zsmul]
    exact hq2
  rcases hr with rfl | rfl
  · rcases ht with rfl | rfl
    · simp
      abel
    · simp
      rw [show s • p + q + (v + q) = s • p + v + (q + q) by abel, hq]
      simp
      abel
  · rcases ht with rfl | rfl
    · simp
      rw [show v + s • p + (v + q) = (v + v) + s • p + q by abel, hv]
      simp
    · simp
      rw [show v + s • p + q + (v + q) = s • p + (v + v) + (q + q) by abel, hv, hq]
      simp

/-- The span is closed under adding `v+q`. -/
lemma zSpan_add_vq (v p q : G) (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    k + (v + q) ∈ zSpanSubgroup v p q := by
  exact (zSpanSubgroup v p q).add_mem hk
    ((zSpanSubgroup v p q).add_mem (zSpan_mem_v v p q) (zSpan_mem_q v p q))

/-- Shifting a span element by `v+q` flips its first and third `{0,1}`-coefficients
and leaves the second unchanged. -/
lemma spanCoeff_shift_vq (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    (k : G) (hk : k ∈ zSpanSubgroup v p q) :
    let c := spanCoeff v p q h2v h2p h2q k hk
    let c' := spanCoeff v p q h2v h2p h2q (k + (v + q)) (zSpan_add_vq v p q k hk)
    (c'.1 = 1 - c.1) ∧ (c'.2.1 = c.2.1) ∧ (c'.2.2 = 1 - c.2.2) := by
  let c := spanCoeff v p q h2v h2p h2q k hk
  let c' := spanCoeff v p q h2v h2p h2q (k + (v + q)) (zSpan_add_vq v p q k hk)
  have hspec := spanCoeff_spec v p q h2v h2p h2q k hk
  have hspec' := spanCoeff_spec v p q h2v h2p h2q (k + (v + q)) (zSpan_add_vq v p q k hk)
  rcases hspec with ⟨hr, hs, ht, hkeq⟩
  rcases hspec' with ⟨hr', hs', ht', hkeq'⟩
  have h01r : 1 - c.1 = 0 ∨ 1 - c.1 = 1 := by
    rcases hr with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have h01t : 1 - c.2.2 = 0 ∨ 1 - c.2.2 = 1 := by
    rcases ht with h0 | h1
    · right
      rw [h0]
      norm_num
    · left
      rw [h1]
      norm_num
  have hcand_eq : k + (v + q) = (1 - c.1) • v + c.2.1 • p + (1 - c.2.2) • q := by
    rw [hkeq]
    exact zsmul_shift_vq v p q c.1 c.2.1 c.2.2 hr ht h2v h2q
  have huniq := triple_unique v p q hind (1 - c.1) c.2.1 (1 - c.2.2) c'.1 c'.2.1 c'.2.2
    h01r hs h01t hr' hs' ht' (by
      rw [← hcand_eq, hkeq'])
  exact ⟨huniq.1.symm, huniq.2.1.symm, huniq.2.2.symm⟩


/-! ## The pointwise `τ′`/`τ″` (payoff of the coefficient-shift lemmas)

With a section `s` of `G ⧸ zSpanSubgroup v p q`, write each `g` as its `k`-part
`k(g) = -(s(mk g)) + g ∈ zSpanSubgroup v p q` plus the representative.  Shifting `g`
by any element of the span (in particular by `v, p, q, v+p, v+q`) does not change its
coset, so `k(g + shift) = k(g) + shift`, and the coefficient-shift lemmas apply
directly.  `τ′`/`τ″` read off the indicators `r ≠ s`, `t ≠ r` of the `{0,1}`-coeffs. -/

/-- The `k`-part of `g` (its span-component relative to the chosen representative). -/
noncomputable def kpart (v p q : G) (s : (G ⧸ zSpanSubgroup v p q) → G) (g : G) : G :=
  -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + g

/-- The `k`-part lies in the span. -/
lemma kpart_mem (v p q : G) (s : (G ⧸ zSpanSubgroup v p q) → G)
    (hs : ∀ C : G ⧸ zSpanSubgroup v p q,
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) (s C) = C) (g : G) :
    kpart v p q s g ∈ zSpanSubgroup v p q := by
  rcases (quotient_decompose (zSpanSubgroup v p q) s hs g) with ⟨k, hk, hdecomp⟩
  have hkpart : k = kpart v p q s g := by
    dsimp [kpart]
    calc
      k = (s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g) + k) -
          s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g) := by abel
      _ = g - s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g) := by rw [hdecomp.symm]
      _ = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + g := by abel
  rwa [← hkpart]

/-- The `k`-part of a shift by `v` is the `k`-part shifted by `v` (same coset). -/
lemma kpart_shift_v (v p q : G) (s : (G ⧸ zSpanSubgroup v p q) → G) (g : G) :
    kpart v p q s (g + v) = kpart v p q s g + v := by
  have hC : QuotientAddGroup.mk (s := zSpanSubgroup v p q) (g + v) =
      QuotientAddGroup.mk (s := zSpanSubgroup v p q) g := by
    rw [QuotientAddGroup.eq (s := zSpanSubgroup v p q) (a := g + v) (b := g)]
    have h : -(g + v) + g = -v := by abel
    rw [h]
    exact (zSpanSubgroup v p q).neg_mem (zSpan_mem_v v p q)
  calc
    kpart v p q s (g + v) = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) (g + v))) + (g + v) := rfl
    _ = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + (g + v) := by rw [hC]
    _ = -(s (QuotientAddGroup.mk (s := zSpanSubgroup v p q) g)) + g + v := by abel
    _ = kpart v p q s g + v := rfl


/-- `spanCoeff` is independent of the membership proof: equal span elements have equal
chosen coefficients (both are `{0,1}`-representations, which `triple_unique` forces to
coincide). -/
lemma spanCoeff_eq_of_eq (v p q : G)
    (hind : ∀ (r s t : ℤ), r • v + s • p + t • q = 0 → Even r ∧ Even s ∧ Even t)
    (h2v : (2 : ℤ) • v = 0) (h2p : (2 : ℤ) • p = 0) (h2q : (2 : ℤ) • q = 0)
    {k1 k2 : G} (hkeq : k1 = k2) (hk1 : k1 ∈ zSpanSubgroup v p q)
    (hk2 : k2 ∈ zSpanSubgroup v p q) :
    spanCoeff v p q h2v h2p h2q k1 hk1 = spanCoeff v p q h2v h2p h2q k2 hk2 := by
  let c1 := spanCoeff v p q h2v h2p h2q k1 hk1
  let c2 := spanCoeff v p q h2v h2p h2q k2 hk2
  have hs1 := spanCoeff_spec v p q h2v h2p h2q k1 hk1
  have hs2 := spanCoeff_spec v p q h2v h2p h2q k2 hk2
  rcases hs1 with ⟨h1r, h1s, h1t, heq1⟩
  rcases hs2 with ⟨h2r, h2s, h2t, heq2⟩
  have heq : c1.1 • v + c1.2.1 • p + c1.2.2 • q =
      c2.1 • v + c2.2.1 • p + c2.2.2 • q := by
    calc
      c1.1 • v + c1.2.1 • p + c1.2.2 • q = k1 := heq1.symm
      _ = k2 := hkeq
      _ = c2.1 • v + c2.2.1 • p + c2.2.2 • q := heq2
  have huneq := triple_unique v p q hind c1.1 c1.2.1 c1.2.2 c2.1 c2.2.1 c2.2.2
    h1r h1s h1t h2r h2s h2t heq
  apply Prod.ext
  · exact huneq.1
  · apply Prod.ext
    · exact huneq.2.1
    · exact huneq.2.2


end
end Commons.PeriodicTiling




namespace Commons.PeriodicTiling
