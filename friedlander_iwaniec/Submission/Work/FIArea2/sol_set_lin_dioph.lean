import Mathlib

namespace Work.FIArea2

/-- **The kernel of `(u,v) ↦ a·v − b·u` is generated by `(a,b)` when `gcd(a,b) = 1`.**

This is the arithmetic core of the parametrisation of the solution set of a two-variable linear
Diophantine equation: if `a` and `b` are coprime in the strong sense that `IsCoprime a b`
(i.e. they admit a Bézout combination equal to `1`), then `a·v = b·u` forces `(u,v) = t·(a,b)`
for some `t : ℤ`. -/
lemma kernel_of_isCoprime {a b u v : ℤ} (hcop : IsCoprime a b) (h : a * v = b * u) :
    ∃ t : ℤ, u = t * a ∧ v = t * b := by
  have hau : a ∣ u := by
    have h1 : a ∣ b * u := ⟨v, h.symm⟩
    exact hcop.dvd_of_dvd_mul_left h1
  have hbv : b ∣ v := by
    have h1 : b ∣ a * v := ⟨u, h⟩
    exact hcop.symm.dvd_of_dvd_mul_left h1
  obtain ⟨t1, ht1⟩ := hau
  obtain ⟨t2, ht2⟩ := hbv
  rcases eq_or_ne a 0 with ha | ha
  · subst ha
    refine ⟨t2, ?_, ?_⟩
    · rw [mul_zero]; simpa using ht1
    · rw [mul_comm]; exact ht2
  · refine ⟨t1, ?_, ?_⟩
    · rw [mul_comm]; exact ht1
    · have h' : a * v = a * (b * t1) := by rw [ht1] at h; rw [h]; ring
      have hv : v = b * t1 := mul_left_cancel₀ ha h'
      rw [mul_comm]; exact hv

/-- The arithmetic behind *FI* §9's `s`-count: for a non-zero pair `(r₁,r₂)`, the integer solutions of
`r₁s₂ − r₂s₁ = Δ` form the arithmetic progression
`(s₁,s₂) + t·(r₁/ρ, r₂/ρ)`, `ρ = (r₁,r₂)`, in exactly one way.  This is what replaces the paper's
per-`Δ` claim ("given `r₁,r₂` and any `Δ`, the number of `(s₁,s₂)` in the polar box is
`O(ϑ^{-1}(r₁,r₂))`", false for small `(r₁,r₂)`: the progression's step is `(r₁/ρ, r₂/ρ)`, of length
`|r|/ρ`, so the count is the length of the chord divided by that step).

The `h0` hypothesis is needed: at `r₁ = r₂ = 0` any `Δ = 0` has every `(s₁',s₂')` as a solution while
the parametrisation (with `0/0 = 0` in Lean) gives only `(s₁,s₂)`. -/
theorem sol_set_lin_dioph (r1 r2 Δ s1 s2 : ℤ) (h0 : (r1, r2) ≠ (0, 0))
    (h : r1 * s2 - r2 * s1 = Δ) :
    ∀ s1' s2' : ℤ, r1 * s2' - r2 * s1' = Δ ↔
      ∃ t : ℤ, s1' = s1 + t * (r1 / (r1.gcd r2 : ℤ)) ∧
              s2' = s2 + t * (r2 / (r1.gcd r2 : ℤ)) := by
  set G : ℤ := (r1.gcd r2 : ℤ) with hG
  have hg0 : G ≠ 0 := by
    intro hc
    apply h0
    have hgz : r1.gcd r2 = 0 := Nat.cast_eq_zero.mp (by rw [← hG]; exact hc)
    simpa using (Int.gcd_eq_zero_iff.mp hgz)
  have hd1 : G ∣ r1 := by rw [hG]; exact Int.gcd_dvd_left r1 r2
  have hd2 : G ∣ r2 := by rw [hG]; exact Int.gcd_dvd_right r1 r2
  have hmul1 : (r1 / G) * G = r1 := Int.ediv_mul_cancel hd1
  have hmul2 : (r2 / G) * G = r2 := Int.ediv_mul_cancel hd2
  have hbez : G = r1 * r1.gcdA r2 + r2 * r1.gcdB r2 := by
    rw [hG]; exact Int.gcd_eq_gcd_ab r1 r2
  -- the reduced pair `(r₁/G, r₂/G)` is coprime (Bézout identity divided by `G`)
  have hcop : IsCoprime (r1 / G) (r2 / G) := by
    refine ⟨r1.gcdA r2, r1.gcdB r2, ?_⟩
    have hkey : (r1.gcdA r2 * (r1 / G) + r1.gcdB r2 * (r2 / G)) * G = 1 * G := by
      calc (r1.gcdA r2 * (r1 / G) + r1.gcdB r2 * (r2 / G)) * G
          = ((r1 / G) * G) * r1.gcdA r2 + ((r2 / G) * G) * r1.gcdB r2 := by ring
        _ = r1 * r1.gcdA r2 + r2 * r1.gcdB r2 := by rw [hmul1, hmul2]
        _ = G := hbez.symm
        _ = 1 * G := by rw [one_mul]
    exact mul_right_cancel₀ hg0 hkey
  -- the solutions of the homogeneous equation `r₁v = r₂u` are the multiples of `(r₁/G, r₂/G)`
  have key : ∀ u v : ℤ, r1 * v - r2 * u = 0 →
      ∃ t : ℤ, u = t * (r1 / G) ∧ v = t * (r2 / G) := by
    intro u v huv
    have h2 : r1 * v = r2 * u := by linarith
    have h3 : G * ((r1 / G) * v) = G * ((r2 / G) * u) := by
      calc G * ((r1 / G) * v) = ((r1 / G) * G) * v := by ring
        _ = r1 * v := by rw [hmul1]
        _ = r2 * u := h2
        _ = ((r2 / G) * G) * u := by rw [hmul2]
        _ = G * ((r2 / G) * u) := by ring
    have hv : (r1 / G) * v = (r2 / G) * u := mul_left_cancel₀ hg0 h3
    exact kernel_of_isCoprime hcop hv
  intro s1' s2'
  constructor
  · intro hs'
    -- subtract the two representations of `Δ`
    have hzero : r1 * (s2' - s2) - r2 * (s1' - s1) = 0 := by
      have h' : r1 * s2' - r2 * s1' = r1 * s2 - r2 * s1 := by rw [hs', h]
      linear_combination h'
    obtain ⟨t, ht1, ht2⟩ := key (s1' - s1) (s2' - s2) hzero
    refine ⟨t, ?_, ?_⟩
    · linarith
    · linarith
  · rintro ⟨t, ht1, ht2⟩
    rw [ht1, ht2]
    have hzero : r1 * (r2 / G) - r2 * (r1 / G) = 0 := by
      have e1 : r1 * (r2 / G) = ((r1 / G) * G) * (r2 / G) := by rw [hmul1]
      have e2 : r2 * (r1 / G) = ((r2 / G) * G) * (r1 / G) := by rw [hmul2]
      rw [e1, e2]; ring
    have hmain : r1 * (s2 + t * (r2 / G)) - r2 * (s1 + t * (r1 / G)) = r1 * s2 - r2 * s1 := by
      have : r1 * (s2 + t * (r2 / G)) - r2 * (s1 + t * (r1 / G))
          = (r1 * s2 - r2 * s1) + t * (r1 * (r2 / G) - r2 * (r1 / G)) := by ring
      rw [this, hzero, mul_zero, add_zero]
    rw [hmain, h]

end Work.FIArea2
