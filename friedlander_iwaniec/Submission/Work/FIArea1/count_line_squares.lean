attribute [local instance] Classical.propDecidable

/-! ## Helpers for the diagonal line count of *FI* (5.22)

The file is self-contained: the lattice/counting lemmas it needs are proved here (in the
vocabulary of `Submission.Work.FITop.Defs`/`FITop3.Defs3`) rather than imported, so that the
statement's proof depends only on the frozen definitions. -/

/-- Membership in the box `gBox R`: the coordinate box. -/
lemma mem_gBox {R : ℤ} {w : GaussianInt} :
    w ∈ Work.FIPlan.gBox R ↔ w.re ∈ Finset.Icc (-R) R ∧ w.im ∈ Finset.Icc (-R) R := by
  rw [Work.FIPlan.gBox, Finset.mem_image]
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact ⟨(Finset.mem_product.mp hp).1, (Finset.mem_product.mp hp).2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨(w.re, w.im), Finset.mem_product.mpr ⟨h1, h2⟩, by
      exact Zsqrtd.ext (by simp) (by simp)⟩

/-- `gnorm` in coordinates, over `ℝ`. -/
lemma gnorm_cast_real (z : GaussianInt) :
    (Work.FIPlan.gnorm z : ℝ) = (z.re : ℝ) ^ 2 + (z.im : ℝ) ^ 2 := by
  have h := Work.FIArea1.gnorm_int z
  have h2 := congrArg (fun x : ℤ => (x : ℝ)) h
  push_cast at h2
  linarith [h2]

/-- The radius of the outer box is at most `3√M`. -/
lemma radM_le_three {Pa : Work.FITop.Params} (hM : 1 ≤ Pa.M) :
    ((Work.FITop.radM Pa : ℤ) : ℝ) ≤ 3 * Real.sqrt Pa.M := by
  have h3 : Real.sqrt (4 * Pa.M) = 2 * Real.sqrt Pa.M := by
    rw [show (4:ℝ) * Pa.M = 4 * Pa.M by ring, Real.sqrt_mul (by norm_num)]
    norm_num
  have hrad : ((Work.FITop.radM Pa : ℤ) : ℝ) = ((⌈Real.sqrt (4 * Pa.M)⌉₊ : ℕ) : ℝ) := by
    rw [Work.FITop.radM]; push_cast; ring
  rw [hrad, h3]
  have h2 : ((⌈2 * Real.sqrt Pa.M⌉₊ : ℕ) : ℝ) < 2 * Real.sqrt Pa.M + 1 :=
    Nat.ceil_lt_add_one (by positivity)
  have h4 : (1:ℝ) ≤ Real.sqrt Pa.M := by
    rw [← Real.sqrt_one]; exact Real.sqrt_le_sqrt (by linarith)
  linarith

/-- Every point of the outer box has `|w|² ≤ 18 M`. -/
lemma gnorm_le_of_mem_boxM {Pa : Work.FITop.Params} {w : GaussianInt}
    (hw : w ∈ Work.FITop.boxM Pa) : (Work.FIPlan.gnorm w : ℝ) ≤ 18 * Pa.M := by
  have hM : 1 ≤ Pa.M := Pa.hM1
  have hM0 : (0:ℝ) ≤ Pa.M := by linarith
  rw [Work.FITop.boxM] at hw
  rw [mem_gBox] at hw
  obtain ⟨hre, him⟩ := hw
  rw [Finset.mem_Icc] at hre him
  set R : ℝ := ((Work.FITop.radM Pa : ℤ) : ℝ) with hRdef
  have hRnn : 0 ≤ R := by
    rw [hRdef]
    exact_mod_cast (show (0:ℤ) ≤ Work.FITop.radM Pa by
      rw [Work.FITop.radM]; exact Int.natCast_nonneg _)
  have hRle : R ≤ 3 * Real.sqrt Pa.M := by rw [hRdef]; exact radM_le_three hM
  have hre2 : (w.re : ℝ) ^ 2 ≤ R ^ 2 := by
    have h1 : -(R) ≤ (w.re : ℝ) := by rw [hRdef]; exact_mod_cast hre.1
    have h2 : (w.re : ℝ) ≤ R := by rw [hRdef]; exact_mod_cast hre.2
    nlinarith
  have him2 : (w.im : ℝ) ^ 2 ≤ R ^ 2 := by
    have h1 : -(R) ≤ (w.im : ℝ) := by rw [hRdef]; exact_mod_cast him.1
    have h2 : (w.im : ℝ) ≤ R := by rw [hRdef]; exact_mod_cast him.2
    nlinarith
  rw [gnorm_cast_real]
  have hsq : R ^ 2 ≤ (3 * Real.sqrt Pa.M) ^ 2 := by nlinarith
  have hsq2 : (3 * Real.sqrt Pa.M) ^ 2 = 9 * Pa.M := by
    rw [mul_pow, Real.sq_sqrt hM0]; norm_num
  nlinarith [hre2, him2, hsq, hsq2]

/-- Coordinates of a point of the outer box are bounded by its radius. -/
lemma abs_coords_le_of_mem_boxM {Pa : Work.FITop.Params} {w : GaussianInt}
    (hw : w ∈ Work.FITop.boxM Pa) :
    |(w.re : ℝ)| ≤ ((Work.FITop.radM Pa : ℤ) : ℝ) ∧
      |(w.im : ℝ)| ≤ ((Work.FITop.radM Pa : ℤ) : ℝ) := by
  rw [Work.FITop.boxM] at hw
  rw [mem_gBox] at hw
  obtain ⟨h1, h2⟩ := hw
  rw [Finset.mem_Icc] at h1 h2
  exact ⟨abs_le.mpr ⟨by exact_mod_cast h1.1, by exact_mod_cast h1.2⟩,
         abs_le.mpr ⟨by exact_mod_cast h2.1, by exact_mod_cast h2.2⟩⟩

/-- Squarefree norm gives coprime coordinates, in `ℤ[i]`. -/
lemma isCoprime_of_sqfree {z : GaussianInt} (hsq : Squarefree (Work.FIPlan.gnorm z)) :
    IsCoprime z.re z.im := by
  have h := Work.FIArea1.coprime_coords_of_sqfree hsq
  rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_eq_natAbs]
  exact Nat.coprime_iff_gcd_eq_one.mp h

/-- `cForm` in coordinates. -/
lemma clsCForm_coords (w z : GaussianInt) :
    Work.FIPlan.cForm w z = w.re * z.re - w.im * z.im := by
  rw [Work.FIPlan.cForm, Zsqrtd.re_mul]; ring

/-- **The kernel of `cForm · z` is generated by `(s,r)`** whenever `(r,s) = 1`. -/
lemma clsMemKernel {z d : GaussianInt} (hcop : IsCoprime z.re z.im)
    (h : Work.FIPlan.cForm d z = 0) :
    ∃ k : ℤ, d = (k : GaussianInt) * (⟨z.im, z.re⟩ : GaussianInt) := by
  rw [clsCForm_coords] at h
  have h' : d.re * z.re = d.im * z.im := by linarith
  have hg : z.re.gcd z.im = 1 := Int.isCoprime_iff_gcd_eq_one.mp hcop
  have hbez : z.re * (z.re.gcdA z.im) + z.im * (z.re.gcdB z.im) = 1 := by
    have := Int.gcd_eq_gcd_ab z.re z.im
    rw [hg] at this
    norm_num at this
    linarith
  refine ⟨z.re.gcdA z.im * d.im + z.re.gcdB z.im * d.re, ?_⟩
  apply Zsqrtd.ext
  · simp only [Zsqrtd.re_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast]
    linear_combination (-d.re) * hbez + (z.re.gcdA z.im) * h'
  · simp only [Zsqrtd.im_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast]
    linear_combination (-d.im) * hbez - (z.re.gcdB z.im) * h'

/-- A finite set of integers lying in a real interval `[lo,hi]` has at most `hi - lo + 1`
elements. -/
lemma clsCardIntInterval {U : Finset ℤ} {lo hi : ℝ} (hlo : lo ≤ hi)
    (h : ∀ k ∈ U, lo ≤ (k:ℝ) ∧ (k:ℝ) ≤ hi) :
    (U.card : ℝ) ≤ hi - lo + 1 := by
  have hsub : U ⊆ Finset.Icc ⌈lo⌉ ⌊hi⌋ := by
    intro k hk
    rw [Finset.mem_Icc]
    exact ⟨(Int.ceil_le).mpr (h k hk).1, (Int.le_floor).mpr (h k hk).2⟩
  have hcard : U.card ≤ (Finset.Icc ⌈lo⌉ ⌊hi⌋).card := Finset.card_le_card hsub
  rw [Int.card_Icc] at hcard
  have hcardR : (U.card : ℝ) ≤ (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ).toNat) : ℝ) := by exact_mod_cast hcard
  have hcast : (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ).toNat : ℤ) : ℝ) = max (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ)) : ℝ) 0 := by
    have := Int.toNat_eq_max (⌊hi⌋ + 1 - ⌈lo⌉)
    exact_mod_cast this
  have h1 : ((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ) : ℝ) ≤ hi - lo + 1 := by
    have hf := Int.floor_le hi; have hc := Int.le_ceil lo
    push_cast; linarith
  have h2 : (0:ℝ) ≤ hi - lo + 1 := by linarith
  calc (U.card : ℝ) ≤ max ((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ) : ℝ) 0 := hcardR.trans_eq hcast
    _ ≤ hi - lo + 1 := max_le h1 h2

/-- A finite set of integers with `|k| ≤ L` has at most `2L + 1` elements (`L ≥ 0`). -/
lemma card_int_abs_le {U : Finset ℤ} {L : ℝ} (hL : 0 ≤ L) (h : ∀ k ∈ U, |(k:ℝ)| ≤ L) :
    (U.card : ℝ) ≤ 2 * L + 1 := by
  have h' : ∀ k ∈ U, -L ≤ (k:ℝ) ∧ (k:ℝ) ≤ L := by
    intro k hk; exact abs_le.mp (h k hk)
  have := clsCardIntInterval (U := U) (lo := -L) (hi := L) (by linarith) h'
  linarith

/-- **The per-line bound on the outer box.**  Points of `boxM Pa` on a single line
`cForm w z = v` number at most `18·(√M/√N) + 1`, when `|z|² ≥ N` and `(r,s) = 1`. -/
lemma per_c_box_bound {Pa : Work.FITop.Params} {z : GaussianInt} {T : Finset GaussianInt} {v : ℤ}
    (hcop : IsCoprime z.re z.im)
    (hNpos : 0 < Pa.N) (hNnz : (Pa.N : ℝ) ≤ (Work.FIPlan.gnorm z : ℝ))
    (hT : ∀ w ∈ T, w ∈ Work.FITop.boxM Pa ∧ Work.FIPlan.cForm w z = v) :
    (T.card : ℝ) ≤ 18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1 := by
  have hM1 : (1:ℝ) ≤ Pa.M := Pa.hM1
  have hM0 : (0:ℝ) ≤ Pa.M := by linarith
  by_cases hne : T.Nonempty
  · obtain ⟨w₀, hw₀⟩ := hne
    have hex : ∀ w ∈ T, ∃ k : ℤ, w = w₀ + (k : GaussianInt) * (⟨z.im, z.re⟩ : GaussianInt) := by
      intro w hw
      have hlin : Work.FIPlan.cForm (w - w₀) z = 0 := by
        have h1 : Work.FIPlan.cForm w z = v := (hT w hw).2
        have h2 : Work.FIPlan.cForm w₀ z = v := (hT w₀ hw₀).2
        rw [clsCForm_coords] at h1 h2 ⊢
        simp only [Zsqrtd.re_sub, Zsqrtd.im_sub]
        linarith
      obtain ⟨k, hk⟩ := clsMemKernel hcop hlin
      exact ⟨k, by rw [← hk]; abel⟩
    classical
    set kfun : GaussianInt → ℤ :=
      (fun w => if h : w ∈ T then Classical.choose (hex w h) else 0) with hkfundef
    have hkfun : ∀ w ∈ T, w = w₀ + (kfun w : GaussianInt) * (⟨z.im, z.re⟩ : GaussianInt) := by
      intro w hw
      rw [hkfundef]
      simp only
      rw [dif_pos hw]
      exact Classical.choose_spec (hex w hw)
    have hinj : Set.InjOn kfun (T : Set GaussianInt) := by
      intro a ha b hb hab
      rw [Finset.mem_coe] at ha hb
      rw [hkfun a ha, hkfun b hb, hab]
    have himg : (T.image kfun).card = T.card := Finset.card_image_of_injOn hinj
    have hk_bound : ∀ k ∈ T.image kfun,
        |(k:ℝ)| ≤ 9 * (Real.sqrt Pa.M / Real.sqrt Pa.N) := by
      intro k hk
      rw [Finset.mem_image] at hk
      obtain ⟨w, hw, rfl⟩ := hk
      have hwk := hkfun w hw
      have hb1 := abs_coords_le_of_mem_boxM (hT w hw).1
      have hb2 := abs_coords_le_of_mem_boxM (hT w₀ hw₀).1
      have hRle : ((Work.FITop.radM Pa : ℤ) : ℝ) ≤ 3 * Real.sqrt Pa.M := radM_le_three hM1
      have hwr : |(w.re:ℝ)| ≤ 3*Real.sqrt Pa.M := le_trans hb1.1 hRle
      have hw0r : |(w₀.re:ℝ)| ≤ 3*Real.sqrt Pa.M := le_trans hb2.1 hRle
      have hwi : |(w.im:ℝ)| ≤ 3*Real.sqrt Pa.M := le_trans hb1.2 hRle
      have hw0i : |(w₀.im:ℝ)| ≤ 3*Real.sqrt Pa.M := le_trans hb2.2 hRle
      have hre : (w.re : ℝ) - (w₀.re : ℝ) = (kfun w : ℝ) * (z.im : ℝ) := by
        have h := congrArg Zsqrtd.re hwk
        simp only [Zsqrtd.re_add, Zsqrtd.re_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast,
          mul_zero, zero_mul, add_zero] at h
        have h' : w.re = w₀.re + kfun w * z.im := by linarith [h]
        have h'' : (w.re : ℝ) = (w₀.re : ℝ) + (kfun w : ℝ) * (z.im : ℝ) := by
          exact_mod_cast h'
        linarith
      have him : (w.im : ℝ) - (w₀.im : ℝ) = (kfun w : ℝ) * (z.re : ℝ) := by
        have h := congrArg Zsqrtd.im hwk
        simp only [Zsqrtd.im_add, Zsqrtd.im_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast,
          zero_mul, add_zero] at h
        have h' : w.im = w₀.im + kfun w * z.re := by linarith [h]
        have h'' : (w.im : ℝ) = (w₀.im : ℝ) + (kfun w : ℝ) * (z.re : ℝ) := by
          exact_mod_cast h'
        linarith
      have h1sq : ((kfun w : ℝ) * (z.im : ℝ))^2 ≤ (6*Real.sqrt Pa.M)^2 := by
        have hb : |(kfun w : ℝ) * (z.im:ℝ)| ≤ 6*Real.sqrt Pa.M := by
          rw [← hre]
          calc |(w.re:ℝ) - (w₀.re:ℝ)| ≤ |(w.re:ℝ)| + |(w₀.re:ℝ)| := abs_sub _ _
            _ ≤ 6*Real.sqrt Pa.M := by linarith
        rw [sq_le_sq]
        rwa [abs_of_nonneg (by positivity : (0:ℝ) ≤ 6*Real.sqrt Pa.M)]
      have h2sq : ((kfun w : ℝ) * (z.re : ℝ))^2 ≤ (6*Real.sqrt Pa.M)^2 := by
        have hb : |(kfun w : ℝ) * (z.re:ℝ)| ≤ 6*Real.sqrt Pa.M := by
          rw [← him]
          calc |(w.im:ℝ) - (w₀.im:ℝ)| ≤ |(w.im:ℝ)| + |(w₀.im:ℝ)| := abs_sub _ _
            _ ≤ 6*Real.sqrt Pa.M := by linarith
        rw [sq_le_sq]
        rwa [abs_of_nonneg (by positivity : (0:ℝ) ≤ 6*Real.sqrt Pa.M)]
      have hkey : ((kfun w:ℝ))^2 * (Work.FIPlan.gnorm z : ℝ) ≤ 72 * Pa.M := by
        have hgz : (Work.FIPlan.gnorm z : ℝ) = (z.re:ℝ)^2 + (z.im:ℝ)^2 := gnorm_cast_real z
        have hsqM : (6*Real.sqrt Pa.M)^2 = 36 * Pa.M := by
          rw [mul_pow, Real.sq_sqrt hM0]; norm_num
        rw [hgz]
        nlinarith [h1sq, h2sq, hsqM]
      have hk2 : ((kfun w:ℝ))^2 ≤ 72 * Pa.M / Pa.N := by
        rw [le_div_iff₀ hNpos]
        nlinarith [hkey, hNnz, sq_nonneg ((kfun w:ℝ))]
      calc |(kfun w : ℝ)| = Real.sqrt (((kfun w : ℝ))^2) := (Real.sqrt_sq_eq_abs _).symm
        _ ≤ Real.sqrt (72 * Pa.M / Pa.N) := Real.sqrt_le_sqrt hk2
        _ ≤ 9 * (Real.sqrt Pa.M / Real.sqrt Pa.N) := by
            rw [show (72:ℝ) * Pa.M / Pa.N = 72 * (Pa.M / Pa.N) by ring,
                Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 72), Real.sqrt_div hM0]
            have h72 : Real.sqrt 72 ≤ 9 := by
              nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 72 by norm_num), Real.sqrt_nonneg 72]
            have hnn : 0 ≤ Real.sqrt Pa.M / Real.sqrt Pa.N :=
              div_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
            nlinarith
    have hL0 : 0 ≤ 9 * (Real.sqrt Pa.M / Real.sqrt Pa.N) := by positivity
    have hcard := card_int_abs_le hL0 hk_bound
    rw [himg] at hcard
    linarith
  · rw [Finset.not_nonempty_iff_eq_empty] at hne
    rw [hne]
    simp only [Finset.card_empty, Nat.cast_zero]
    have : (0:ℝ) ≤ Real.sqrt Pa.M / Real.sqrt Pa.N := by positivity
    linarith

/-- Cauchy–Schwarz on the line: `|Re(wz)| ≤ 6√(MN)` for `w ∈ boxM Pa` and `|z|² ≤ 2N`. -/
lemma cForm_abs_le {Pa : Work.FITop.Params} {z w : GaussianInt}
    (hw : w ∈ Work.FITop.boxM Pa) (hz : (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Pa.N) :
    |((Work.FIPlan.cForm w z : ℤ) : ℝ)| ≤ 6 * Real.sqrt (Pa.M * Pa.N) := by
  have hM1 : (1:ℝ) ≤ Pa.M := Pa.hM1
  have hz0 : (0:ℝ) ≤ (Work.FIPlan.gnorm z : ℝ) := by positivity
  have h1 : ((Work.FIPlan.cForm w z : ℤ) : ℝ)^2
      ≤ (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ) := by
    have h := Work.FIArea1.cForm_sq_le w z
    exact_mod_cast h
  have h2' : (Work.FIPlan.gnorm w : ℝ) ≤ 18 * Pa.M := gnorm_le_of_mem_boxM hw
  have h3 : (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ) ≤ 36 * (Pa.M * Pa.N) := by
    have h4 : (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ) ≤ (18*Pa.M)*(2*Pa.N) :=
      mul_le_mul h2' hz hz0 (by linarith)
    nlinarith [h4]
  calc |((Work.FIPlan.cForm w z : ℤ) : ℝ)|
        = Real.sqrt (((Work.FIPlan.cForm w z : ℤ) : ℝ)^2) := (Real.sqrt_sq_eq_abs _).symm
    _ ≤ Real.sqrt (36 * (Pa.M * Pa.N)) := Real.sqrt_le_sqrt (by linarith [h1, h3])
    _ = 6 * Real.sqrt (Pa.M * Pa.N) := by
        rw [show (36:ℝ) * (Pa.M * Pa.N) = 6^2 * (Pa.M * Pa.N) by norm_num,
            Real.sqrt_mul (by positivity : (0:ℝ) ≤ (6:ℝ)^2),
            Real.sqrt_sq (by norm_num : (0:ℝ) ≤ 6)]

/-- The abstract numeric inequality closing the diagonal count. -/
lemma numeric_arith {a b : ℝ} (ha : 1 ≤ a) (hb : 1 ≤ b) :
    (2 * Real.sqrt 6 * a + 3) * (18 * b + 1) ≤ 300 * a * (1 + b) := by
  have h6 : Real.sqrt 6 ≤ 3 := by
    nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 6 by norm_num), Real.sqrt_nonneg 6]
  have e1 : 2 * Real.sqrt 6 * a + 3 ≤ 9 * a := by nlinarith
  have e2 : 18 * b + 1 ≤ 19 * b := by nlinarith
  have e1nn : 0 ≤ 2 * Real.sqrt 6 * a + 3 := by positivity
  have e2nn : 0 ≤ 18 * b + 1 := by positivity
  have hmul : (2*Real.sqrt 6*a+3) * (18*b+1) ≤ (9*a) * (19*b) :=
    mul_le_mul e1 e2 e2nn (by positivity)
  have e4 : (9*a)*(19*b) ≤ 300 * a * (1+b) := by nlinarith
  linarith [hmul, e4]

/-- `D^{1/4} = √√D` for `D ≥ 0`. -/
lemma rpow_quarter_eq_sqrt_sqrt {D : ℝ} (hD : 0 ≤ D) :
    D ^ ((1:ℝ)/4) = Real.sqrt (Real.sqrt D) := by
  rw [show (1:ℝ)/4 = (1/2)*(1/2) by norm_num, Real.rpow_mul hD]
  rw [← Real.sqrt_eq_rpow D, ← Real.sqrt_eq_rpow (Real.sqrt D)]

/-- `D^{1/4} ≥ 1` for `D ≥ 1`. -/
lemma one_le_rpow_quarter {D : ℝ} (hD : 1 ≤ D) : 1 ≤ D ^ ((1:ℝ)/4) := by
  rw [rpow_quarter_eq_sqrt_sqrt (by linarith)]
  exact Real.one_le_sqrt.mpr (Real.one_le_sqrt.mpr hD)

/-- `√M/√N ≥ 1` for `1 ≤ N ≤ M`. -/
lemma one_le_sqrt_div {M N : ℝ} (hN : 1 ≤ N) (hMN : N ≤ M) :
    1 ≤ Real.sqrt M / Real.sqrt N := by
  rw [one_le_div (Real.sqrt_pos.mpr (by linarith))]
  exact Real.sqrt_le_sqrt hMN

/-- **Points on the lines `Re(wz) = c²` inside the outer box** (the diagonal half of *FI* (5.22)).

For `z` with `N < |z|² ≤ 2N` and squarefree norm, the number of `w` in the outer box
`boxM Pa = gBox (radM Pa)` for which `Re(wz)` is a square is
`≤ 300 (MN)^{1/4}(1 + √M/√N)`.

*Proof route* (elementary).  `hsq` gives `(r,s) = 1`, so for each `c` the solutions of
`cForm w z = c²` form a coset of `ℤ·(s,r)`, `w = w₀ + λ(s,r)`, with
`gnorm (w₀+λ(s,r)) = |w₀|² + 2λ(u₀s+v₀r) + λ²|z|²`.  As `w ∈ boxM` gives `|w| ≤ 3√(2M)` and
`hzlo` gives `|z| > √N`, the admissible `λ` satisfy `|λ| ≤ 9√(2M)/√N`, so each line carries at
most `1 + 18√(2M)/√N` points.  Finally `c² = Re(wz)` with `|Re(wz)| ≤ √(|w|²|z|²) ≤ 2√(MN)`, so
there are at most `4(MN)^{1/4}+1` values of `|c|`; multiplying gives the bound with the absolute
constant `300`. -/
theorem count_line_squares {Pa : Work.FITop.Params} {z : GaussianInt}
    (hzlo : (Pa.N : ℝ) < (Work.FIPlan.gnorm z : ℝ))
    (hzhi : (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Pa.N)
    (hsq : Squarefree (Work.FIPlan.gnorm z)) :
    (((Work.FITop.boxM Pa).filter
        (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ 300 * (Pa.M * Pa.N) ^ ((1 : ℝ) / 4) * (1 + Real.sqrt Pa.M / Real.sqrt Pa.N) := by
  have hM1 : (1:ℝ) ≤ Pa.M := Pa.hM1
  have hN1 : (1:ℝ) ≤ Pa.N := Pa.hN1
  have hNpos : (0:ℝ) < Pa.N := by linarith
  have hcop : IsCoprime z.re z.im := isCoprime_of_sqfree hsq
  have hNnz : (Pa.N : ℝ) ≤ (Work.FIPlan.gnorm z : ℝ) := le_of_lt hzlo
  -- the range of `|c|`
  set B : ℝ := 6 * Real.sqrt (Pa.M * Pa.N) with hBdef
  set K : ℕ := ⌈Real.sqrt B⌉₊ with hKdef
  set T : Finset ℤ := Finset.Icc (-(K:ℤ)) (K:ℤ) with hTdef
  -- per-line bound on each `c`-line
  have hAcard : ∀ c ∈ T,
      ((((Work.FITop.boxM Pa).filter (fun w => Work.FIPlan.cForm w z = c ^ 2)).card : ℝ))
        ≤ 18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1 := by
    intro c _
    refine per_c_box_bound (v := c ^ 2) hcop hNpos hNnz ?_
    intro w hw
    rw [Finset.mem_filter] at hw
    exact hw
  -- the counted set is contained in the union of the `c`-lines
  have hsub : (Work.FITop.boxM Pa).filter (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)
      ⊆ T.biUnion (fun c => (Work.FITop.boxM Pa).filter (fun w => Work.FIPlan.cForm w z = c ^ 2)) := by
    intro w hw
    rw [Finset.mem_filter] at hw
    obtain ⟨hwb, c, hc⟩ := hw
    rw [Finset.mem_biUnion]
    refine ⟨c, ?_, Finset.mem_filter.mpr ⟨hwb, hc⟩⟩
    have hb : |((Work.FIPlan.cForm w z : ℤ) : ℝ)| ≤ B := by
      rw [hBdef]; exact cForm_abs_le hwb hzhi
    have hcsq : ((c:ℤ):ℝ)^2 ≤ B := by
      have h2 : ((c:ℤ):ℝ)^2 = ((c^2 : ℤ) : ℝ) := by push_cast; ring
      rw [h2, ← hc]
      exact le_trans (le_abs_self _) hb
    have hcR : |((c:ℤ):ℝ)| ≤ (K:ℝ) := by
      have h2 : |((c:ℤ):ℝ)| ≤ Real.sqrt B := Real.abs_le_sqrt hcsq
      have h3 : Real.sqrt B ≤ (K:ℝ) := by rw [hKdef]; exact Nat.le_ceil _
      linarith
    rw [hTdef, Finset.mem_Icc]
    constructor
    · exact_mod_cast (abs_le.mp hcR).1
    · exact_mod_cast (abs_le.mp hcR).2
  -- cardinality bookkeeping
  have hcard_sum : (((Work.FITop.boxM Pa).filter
        (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ ∑ c ∈ T, (((Work.FITop.boxM Pa).filter (fun w => Work.FIPlan.cForm w z = c ^ 2)).card : ℝ) := by
    have h3 : (((Work.FITop.boxM Pa).filter
          (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
        ≤ ((T.biUnion (fun c => (Work.FITop.boxM Pa).filter
            (fun w => Work.FIPlan.cForm w z = c ^ 2))).card : ℝ) := by
      exact_mod_cast Finset.card_le_card hsub
    have h2 : ((T.biUnion (fun c => (Work.FITop.boxM Pa).filter
          (fun w => Work.FIPlan.cForm w z = c ^ 2))).card : ℝ)
        ≤ ∑ c ∈ T, (((Work.FITop.boxM Pa).filter (fun w => Work.FIPlan.cForm w z = c ^ 2)).card : ℝ) := by
      exact_mod_cast Finset.card_biUnion_le
    linarith
  have hsum_le : ∑ c ∈ T, (((Work.FITop.boxM Pa).filter (fun w => Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ (T.card : ℝ) * (18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1) := by
    have h := Finset.sum_le_sum (fun c hc => hAcard c hc)
    simp only [Finset.sum_const, nsmul_eq_mul] at h
    exact h
  have hScard : (((Work.FITop.boxM Pa).filter
        (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ (T.card : ℝ) * (18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1) := le_trans hcard_sum hsum_le
  -- cardinality of the `c`-range
  have hTcard : (T.card : ℝ) ≤ 2 * Real.sqrt 6 * (Pa.M * Pa.N) ^ ((1:ℝ)/4) + 3 := by
    have hcard : (T.card : ℝ) = 2 * (K:ℝ) + 1 := by
      rw [hTdef, Int.card_Icc]
      have hz : (K:ℤ) + 1 - (-(K:ℤ)) = ((2*K+1 : ℕ) : ℤ) := by push_cast; ring
      rw [hz, Int.toNat_natCast]
      push_cast; ring
    have hKub : (K:ℝ) ≤ Real.sqrt B + 1 := by
      have h := Nat.ceil_lt_add_one (show (0:ℝ) ≤ Real.sqrt B by positivity)
      rw [hKdef]
      linarith
    have hBexpr : Real.sqrt B = Real.sqrt 6 * (Pa.M * Pa.N) ^ ((1:ℝ)/4) := by
      rw [hBdef, Real.sqrt_mul (by norm_num : (0:ℝ) ≤ 6)]
      congr 1
      rw [rpow_quarter_eq_sqrt_sqrt (by positivity)]
    rw [hBexpr] at hKub
    rw [hcard]
    linarith
  -- assemble
  have hlast : (((Work.FITop.boxM Pa).filter
        (fun w => ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ (2 * Real.sqrt 6 * (Pa.M * Pa.N) ^ ((1:ℝ)/4) + 3)
          * (18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1) := by
    have hLnn : 0 ≤ 18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1 := by positivity
    have h1 : (T.card : ℝ) * (18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1)
        ≤ (2 * Real.sqrt 6 * (Pa.M * Pa.N) ^ ((1:ℝ)/4) + 3)
          * (18 * (Real.sqrt Pa.M / Real.sqrt Pa.N) + 1) :=
      mul_le_mul_of_nonneg_right hTcard hLnn
    linarith [hScard, h1]
  have ha : 1 ≤ (Pa.M * Pa.N) ^ ((1:ℝ)/4) :=
    one_le_rpow_quarter (by nlinarith [hM1, hN1])
  have hb : 1 ≤ Real.sqrt Pa.M / Real.sqrt Pa.N := one_le_sqrt_div hN1 Pa.hMge
  have hfin := numeric_arith ha hb
  linarith [hlast, hfin]

end Work.FIArea1
