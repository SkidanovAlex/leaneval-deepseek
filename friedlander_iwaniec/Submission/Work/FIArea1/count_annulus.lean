      _ ≤ ((D:ℝ)/(p:ℝ) + 1) * (X + 1) := mul_le_mul_of_nonneg_right hbadcard (by linarith [hX0])
  have hgood_sum : ∑ c ∈ (Finset.range (D+1)).filter (fun c => ¬ p ∣ c), ((F c).card : ℝ)
