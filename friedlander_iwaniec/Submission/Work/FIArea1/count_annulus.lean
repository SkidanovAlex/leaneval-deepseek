import Mathlib
import Submission.Work.FITop3.Defs3
import Submission.Work.FITop3.Smooth
import Submission.Work.FITop3.Smooth.sm_props
import Submission.Work.FITop3.Majorant.majorant_props
import Submission.Work.FITop3.Witness.exists_primary_norm
import Submission.Work.FIArea1.Basic

namespace Work.FIArea1

open Finset
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

/-! ## 0. The elementary Gaussian vocabulary of the line count -/

/-- The generator `(s, r)` of the kernel of `w ↦ Re(wz)` for `z = ⟨r, s⟩`. -/
def gvec (z : GaussianInt) : GaussianInt := ⟨z.im, z.re⟩

/-- The companion linear form `Im(wz) = w.re · z.im + w.im · z.re`; it is a bijection on each
coset of `ker cForm` and increases by `|z|²` along the generator `gvec z`. -/
def psi (z w : GaussianInt) : ℤ := w.re * z.im + w.im * z.re

/-! ## 1. Coordinates of `cForm` and `psi` -/

lemma cForm_coords (w z : GaussianInt) : Work.FIPlan.cForm w z = w.re * z.re - w.im * z.im := by
  rw [Work.FIPlan.cForm, Zsqrtd.re_mul]; ring

lemma psi_add (z w w' : GaussianInt) : psi z (w + w') = psi z w + psi z w' := by
  rw [psi, psi, psi]; simp only [Zsqrtd.re_add, Zsqrtd.im_add]; ring

lemma psi_sub (z w w' : GaussianInt) : psi z (w - w') = psi z w - psi z w' := by
  rw [psi, psi, psi]; simp only [Zsqrtd.re_sub, Zsqrtd.im_sub]; ring

lemma psi_gvec (z : GaussianInt) : psi z (gvec z) = (Work.FIPlan.gnorm z : ℤ) := by
  rw [psi, gvec, Work.FIArea1.gnorm_int]; ring

lemma psi_smul_gvec (z : GaussianInt) (k : ℤ) :
    psi z ((k:GaussianInt) * gvec z) = k * (Work.FIPlan.gnorm z : ℤ) := by
  rw [psi, gvec, Work.FIArea1.gnorm_int]
  simp only [Zsqrtd.re_mul, Zsqrtd.im_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast]; ring

/-! ## 2. The kernel of `w ↦ Re(wz)`: the line structure -/

/-- **The kernel of `cForm · z` is generated by `gvec z`** (the paper's "the solutions form a
coset of `ℤ(s,r)`").  Requires `gcd(r,s) = 1`, which holds for squarefree `|z|²`. -/
lemma eq_smul_gvec_of_cForm_eq_zero {z d : GaussianInt} (hcop : IsCoprime z.re z.im)
    (h : Work.FIPlan.cForm d z = 0) :
    ∃ k : ℤ, d = (k : GaussianInt) * (⟨z.im, z.re⟩ : GaussianInt) := by
  rw [cForm_coords] at h
  have h' : d.re * z.re = d.im * z.im := by linarith
  have hg : z.re.gcd z.im = 1 := Int.isCoprime_iff_gcd_eq_one.mp hcop
  have hbez : z.re * (z.re.gcdA z.im) + z.im * (z.re.gcdB z.im) = 1 := by
    have := Int.gcd_eq_gcd_ab z.re z.im
    rw [hg] at this
    norm_num at this
    linarith
  refine ⟨z.re.gcdA z.im * d.im + z.re.gcdB z.im * d.re, ?_⟩
  apply Zsqrtd.ext
  · simp only [Zsqrtd.re_mul, Zsqrtd.im_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast]
    linear_combination (-d.re) * hbez + (z.re.gcdA z.im) * h'
  · simp only [Zsqrtd.re_mul, Zsqrtd.im_mul, Zsqrtd.re_intCast, Zsqrtd.im_intCast]
    linear_combination (-d.im) * hbez - (z.re.gcdB z.im) * h'

lemma exists_smul_gvec_of_cForm_eq {z w w' : GaussianInt} (hcop : IsCoprime z.re z.im)
    (h : Work.FIPlan.cForm w z = Work.FIPlan.cForm w' z) :
    ∃ k : ℤ, w = w' + (k : GaussianInt) * gvec z := by
  have hlin : Work.FIPlan.cForm (w - w') z = 0 := by
    simp only [cForm_coords] at h ⊢
    simp only [Zsqrtd.re_sub, Zsqrtd.im_sub]; ring_nf; linarith [h]
  obtain ⟨k, hk⟩ := eq_smul_gvec_of_cForm_eq_zero hcop hlin
  refine ⟨k, ?_⟩
  rw [gvec]
  rw [← hk]
  abel

/-- On a coset of `ker (cForm · z)`, the form `psi` is injective: two points with the same
`Re(wz)` and the same `Im(wz)` coincide (and `cForm w z + i·psi z w = wz`). -/
lemma psi_eq_of_cForm_eq {z w w' : GaussianInt} (hcop : IsCoprime z.re z.im)
    (hnz : (Work.FIPlan.gnorm z : ℤ) ≠ 0)
    (hc : Work.FIPlan.cForm w z = Work.FIPlan.cForm w' z) (hp : psi z w = psi z w') : w = w' := by
  obtain ⟨k, hk⟩ := exists_smul_gvec_of_cForm_eq hcop hc
  rw [hk, psi_add, psi_smul_gvec] at hp
  have hk0 : k = 0 := by
    have : k * (Work.FIPlan.gnorm z : ℤ) = 0 := by linarith [hp]
    exact (mul_eq_zero.mp this).resolve_right hnz
  rw [hk0] at hk
  simpa using hk

lemma nz_dvd_psi_sub {z w w' : GaussianInt} (hcop : IsCoprime z.re z.im)
    (h : Work.FIPlan.cForm w z = Work.FIPlan.cForm w' z) :
    (Work.FIPlan.gnorm z : ℤ) ∣ (psi z w - psi z w') := by
  obtain ⟨k, hk⟩ := exists_smul_gvec_of_cForm_eq hcop h
  refine ⟨k, ?_⟩
  rw [hk, psi_add, psi_smul_gvec]; ring

/-! ## 3. The Lagrange identity and the norm expansion -/

/-- `|w|²|z|² = (Im wz)² + (Re wz)²`: the Lagrange identity behind the paper's case analysis. -/
lemma gnorm_mul_eq (w z : GaussianInt) :
    (Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ)
      = (psi z w)^2 + (Work.FIPlan.cForm w z)^2 := by
  rw [Work.FIArea1.gnorm_int, Work.FIArea1.gnorm_int, Work.FIPlan.cForm, Zsqrtd.re_mul]
  simp only [psi]; ring

lemma psi_sq_le (w z : GaussianInt) :
    (psi z w)^2 ≤ (Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ) := by
  rw [gnorm_mul_eq]; nlinarith [sq_nonneg (Work.FIPlan.cForm w z)]

/-- `|w + k·gvec z|² = |w|² + 2k·Im(wz) + k²|z|²`. -/
lemma gnorm_int_add_smul_gvec (w z : GaussianInt) (k : ℤ) :
    (Work.FIPlan.gnorm (w + (k:GaussianInt) * gvec z) : ℤ)
      = (Work.FIPlan.gnorm w : ℤ) + 2*k*(psi z w) + k^2 * (Work.FIPlan.gnorm z : ℤ) := by
  rw [gvec, Work.FIArea1.gnorm_int, Work.FIArea1.gnorm_int, Work.FIArea1.gnorm_int, psi]
  simp only [Zsqrtd.re_add, Zsqrtd.im_add, Zsqrtd.re_intCast, Zsqrtd.im_intCast, Zsqrtd.re_mul, Zsqrtd.im_mul]
  ring

/-- In the "case (b)" of the paper (`p ∣ Im(wz)`), the square `c² = Re(wz)` is divisible by `p`. -/
lemma p_dvd_c_of_p_dvd_psi {p : ℕ} (hp : p.Prime) {z w : GaussianInt} {c : ℤ}
    (hgz : (p:ℤ) ∣ (Work.FIPlan.gnorm z : ℤ))
    (hc : Work.FIPlan.cForm w z = c^2)
    (hpw : (p:ℤ) ∣ psi z w) : (p:ℤ) ∣ c := by
  have hL := gnorm_mul_eq w z
  have h4 : (p:ℤ) ∣ c^4 := by
    have hkey : c^4 = (Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ) - (psi z w)^2 := by
      rw [hL, hc]; ring
    rw [hkey]
    exact dvd_sub (dvd_mul_of_dvd_right hgz _)
      (by rw [pow_two]; exact dvd_mul_of_dvd_right hpw _)
  have hpi : Prime (p:ℤ) := Nat.prime_iff_prime_int.mp hp
  exact hpi.dvd_of_dvd_pow h4

/-- **Case (a)**: if `p ∤ Im(w'z)`, the admissible parameter `k` (in `w = w' + k·gvec z`) is a
single class modulo `p`; equivalently `p·|z|²` divides `Im(wz) - Im(w'z)`. -/
lemma pnz_dvd_psi_sub {p : ℕ} (hp : p.Prime) (hp2 : 2 < p) {z w w' : GaussianInt}
    (hcop : IsCoprime z.re z.im)
    (hgz : (p:ℤ) ∣ (Work.FIPlan.gnorm z : ℤ))
    (hm0 : ¬ (p:ℤ) ∣ psi z w')
    (hw : Work.FIPlan.cForm w z = Work.FIPlan.cForm w' z)
    (hgw : (p:ℤ) ∣ (Work.FIPlan.gnorm w : ℤ)) (hgw' : (p:ℤ) ∣ (Work.FIPlan.gnorm w' : ℤ)) :
    ((p:ℤ) * (Work.FIPlan.gnorm z : ℤ)) ∣ (psi z w - psi z w') := by
  obtain ⟨k, hk⟩ := exists_smul_gvec_of_cForm_eq hcop hw
  have hpsi : psi z w - psi z w' = k * (Work.FIPlan.gnorm z : ℤ) := by
    rw [hk, psi_add, psi_smul_gvec]; ring
  have hexp : (Work.FIPlan.gnorm w : ℤ)
      = (Work.FIPlan.gnorm w' : ℤ) + 2*k*(psi z w') + k^2 * (Work.FIPlan.gnorm z : ℤ) := by
    conv_lhs => rw [hk]
    exact gnorm_int_add_smul_gvec w' z k
  have hpi : Prime (p:ℤ) := Nat.prime_iff_prime_int.mp hp
  have hd : (p:ℤ) ∣ 2*k*(psi z w') := by
    have : 2*k*(psi z w') = (Work.FIPlan.gnorm w : ℤ) - (Work.FIPlan.gnorm w' : ℤ)
        - k^2*(Work.FIPlan.gnorm z : ℤ) := by linarith [hexp]
    rw [this]
    exact dvd_sub (dvd_sub hgw hgw') (dvd_mul_of_dvd_right hgz (k^2))
  have hp2' : ¬ (p:ℤ) ∣ 2 := by
    intro h
    have hh : p ∣ 2 := by
      have := Int.natCast_dvd.mp h; simpa using this
    have := Nat.le_of_dvd (by norm_num) hh
    omega
  have hpk : (p:ℤ) ∣ k := by
    have hd2 : (p:ℤ) ∣ 2 * (k * (psi z w')) := by simpa only [mul_assoc] using hd
    rcases hpi.dvd_mul.mp hd2 with h2 | hkpsi
    · exact absurd h2 hp2'
    · rcases hpi.dvd_mul.mp hkpsi with hk | hpsi
      · exact hk
      · exact absurd hpsi hm0
  obtain ⟨j, hj⟩ := hpk
  refine ⟨j, ?_⟩
  rw [hpsi, hj]; ring


/-! ## 4. Elementary lattice counts in a real interval / an arithmetic progression -/

/-- A finite set of integers lying in a real interval `[lo,hi]` has at most `hi - lo + 1`
elements. -/
lemma card_int_le_of_interval {U : Finset ℤ} {lo hi : ℝ} (hlo : lo ≤ hi)
    (h : ∀ k ∈ U, lo ≤ (k:ℝ) ∧ (k:ℝ) ≤ hi) :
    (U.card : ℝ) ≤ hi - lo + 1 := by
  have hsub : U ⊆ Finset.Icc ⌈lo⌉ ⌊hi⌋ := by
    intro k hk
    rw [Finset.mem_Icc]
    exact ⟨(Int.ceil_le).mpr (h k hk).1, (Int.le_floor).mpr (h k hk).2⟩
  have hcard : U.card ≤ (Finset.Icc ⌈lo⌉ ⌊hi⌋).card := Finset.card_le_card hsub
  rw [Int.card_Icc] at hcard
  have hcardR : (U.card : ℝ) ≤ (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ).toNat) : ℝ) := by exact_mod_cast hcard
  have hcast : (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ).toNat : ℤ) : ℝ) = max (((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ)) : ℝ) 0 := by
    have := Int.toNat_eq_max (⌊hi⌋ + 1 - ⌈lo⌉)
    exact_mod_cast this
  have h1 : ((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ) : ℝ) ≤ hi - lo + 1 := by
    have hf := Int.floor_le hi; have hc := Int.le_ceil lo
    push_cast; linarith
  have h2 : (0:ℝ) ≤ hi - lo + 1 := by linarith
  calc (U.card : ℝ) ≤ max ((⌊hi⌋ + 1 - ⌈lo⌉ : ℤ) : ℝ) 0 := hcardR.trans_eq hcast
    _ ≤ hi - lo + 1 := max_le h1 h2

/-- A finite set of integers lying in a real interval `[-R,R]` and in a single class modulo `m`
has at most `2R/m + 1` elements. -/
lemma card_int_le_shifted_ap {U : Finset ℤ} {t0 : ℤ} {m : ℕ} {R : ℝ}
    (hm : 0 < m) (hR : 0 ≤ R)
    (hdiv : ∀ t ∈ U, (m:ℤ) ∣ (t - t0))
    (hint : ∀ t ∈ U, |(t:ℝ)| ≤ R) :
    (U.card : ℝ) ≤ 2*R/m + 1 := by
  have hmZ : (m:ℤ) ≠ 0 := by
    have : (0:ℤ) < m := by exact_mod_cast hm
    omega
  have hmR : (0:ℝ) < m := by exact_mod_cast hm
  set f : ℤ → ℤ := fun t => (t - t0) / (m:ℤ) with hf
  have hfmul : ∀ t ∈ U, f t * (m:ℤ) = t - t0 := by
    intro t ht
    rw [hf]
    exact ((Int.ediv_eq_iff_eq_mul_left hmZ (hdiv t ht)).mp rfl).symm
  have hinj : Set.InjOn f (U : Set ℤ) := by
    intro a ha b hb hab
    rw [Finset.mem_coe] at ha hb
    have h1 := hfmul a ha
    have h2 := hfmul b hb
    rw [hab] at h1
    linarith [h1, h2]
  have himg : (U.image f).card = U.card := Finset.card_image_of_injOn hinj
  have hcast : ∀ t ∈ U, ((f t : ℤ) : ℝ) * (m:ℝ) = (t:ℝ) - t0 := by
    intro t ht
    have := hfmul t ht
    exact_mod_cast congrArg (fun x : ℤ => (x:ℝ)) this
  have hinterval : ∀ t' ∈ U.image f, ((-R - t0)/m : ℝ) ≤ (t':ℝ) ∧ (t':ℝ) ≤ ((R - t0)/m : ℝ) := by
    intro t' ht'
    rw [Finset.mem_image] at ht'
    obtain ⟨t, ht, rfl⟩ := ht'
    have hb := hcast t ht
    have ht1 : (-R : ℝ) ≤ t := (abs_le.mp (hint t ht)).1
    have ht2 : (t:ℝ) ≤ R := (abs_le.mp (hint t ht)).2
    have hft : ((f t : ℤ) : ℝ) = ((t:ℝ) - (t0:ℝ))/m := by
      rw [eq_div_iff (ne_of_gt hmR)]
      push_cast
      linarith [hb]
    rw [hft]
    constructor
    · rw [div_le_div_iff_of_pos_right hmR]; linarith
    · rw [div_le_div_iff_of_pos_right hmR]; linarith
  have hlo : ((-R - t0)/m : ℝ) ≤ (R - t0)/m := by
    rw [div_le_div_iff_of_pos_right hmR]; linarith
  have hmain := card_int_le_of_interval (U := U.image f) hlo hinterval
  rw [himg] at hmain
  have heq : (R - t0)/m - (-R - t0)/m = 2*R/m := by ring
  linarith [hmain, heq]

/-! ## 5. The per-`c` count on the line `cForm w z = c²` -/

/-- **The general per-line bound.**  On a coset of `ker (cForm · z)` inside the annulus
`M < |w|² ≤ 2M`, with `|z|² ≥ N`, the `psi`-coordinate takes at most `2√(2M/N) + 1` values. -/
lemma per_c_gen_bound {Pa : Work.FITop.Params} {z : GaussianInt} {T : Finset GaussianInt} {v : ℤ}
    (hcop : IsCoprime z.re z.im) (hnz : (Work.FIPlan.gnorm z : ℤ) ≠ 0)
    (hNpos : 0 < Pa.N) (hMpos : 0 < Pa.M)
    (hNnz : (Pa.N : ℝ) ≤ (Work.FIPlan.gnorm z : ℝ))
    (hT : ∀ w ∈ T, w ∈ Work.FITop3.annM Pa ∧ Work.FIPlan.cForm w z = v) :
    (T.card : ℝ) ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) + 1 := by
  have hnz0 : Work.FIPlan.gnorm z ≠ 0 := by
    intro h0; exact hnz (by rw [h0]; norm_num)
  have hnzR : (0:ℝ) < (Work.FIPlan.gnorm z : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero hnz0
  by_cases hne : T.Nonempty
  · obtain ⟨w₀, hw₀⟩ := hne
    set B : Finset ℤ := T.image (psi z) with hB
    have hinj : Set.InjOn (psi z) (T : Set GaussianInt) := by
      intro a ha b hb hab
      rw [Finset.mem_coe] at ha hb
      exact psi_eq_of_cForm_eq hcop hnz (by rw [(hT a ha).2, (hT b hb).2]) hab
    have hBcard : B.card = T.card := by rw [hB]; exact Finset.card_image_of_injOn hinj
    set R : ℝ := Real.sqrt (2 * Pa.M * (Work.FIPlan.gnorm z : ℝ)) with hR
    have hRnn : 0 ≤ R := Real.sqrt_nonneg _
    have hdiv : ∀ t ∈ B, ((Work.FIPlan.gnorm z) : ℤ) ∣ (t - psi z w₀) := by
      intro t ht
      rw [hB, Finset.mem_image] at ht
      obtain ⟨w, hw, rfl⟩ := ht
      exact nz_dvd_psi_sub hcop (by rw [(hT w hw).2, (hT w₀ hw₀).2])
    have hint : ∀ t ∈ B, |(t:ℝ)| ≤ R := by
      intro t ht
      rw [hB, Finset.mem_image] at ht
      obtain ⟨w, hw, rfl⟩ := ht
      have hgt : (Work.FIPlan.gnorm w : ℝ) ≤ 2 * Pa.M :=
        (Work.FITop3.mem_annM.mp (hT w hw).1).2.2
      have hgz0 : (0:ℝ) ≤ (Work.FIPlan.gnorm z : ℝ) := le_of_lt hnzR
      have hsq : (((psi z w : ℤ) : ℝ))^2 ≤ 2 * Pa.M * (Work.FIPlan.gnorm z : ℝ) := by
        have h1 := psi_sq_le w z
        have h2 : (((psi z w : ℤ) : ℝ))^2
            ≤ (((Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ) : ℤ) : ℝ) := by
          exact_mod_cast h1
        push_cast at h2
        calc (((psi z w : ℤ) : ℝ))^2
              ≤ (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ) := h2
          _ ≤ (2 * Pa.M) * (Work.FIPlan.gnorm z : ℝ) := mul_le_mul_of_nonneg_right hgt hgz0
      rw [hR]
      exact Real.abs_le_sqrt hsq
    have hmain := card_int_le_shifted_ap (U := B) (t0 := psi z w₀) (m := Work.FIPlan.gnorm z)
        (Nat.pos_of_ne_zero hnz0) hRnn hdiv hint
    rw [hBcard] at hmain
    have hstep : 2 * R / (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) := by
      have hsqeq : (R/(Work.FIPlan.gnorm z : ℝ))^2 = 2 * Pa.M / (Work.FIPlan.gnorm z : ℝ) := by
        rw [hR, div_pow, Real.sq_sqrt (by positivity)]
        field_simp
      have hle : 2 * Pa.M / (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Pa.M / Pa.N :=
        div_le_div_of_nonneg_left (by positivity) hNpos hNnz
      have hlift : R/(Work.FIPlan.gnorm z : ℝ) ≤ Real.sqrt (2 * Pa.M / Pa.N) := by
        have h1 : (R/(Work.FIPlan.gnorm z : ℝ))^2 ≤ (Real.sqrt (2 * Pa.M / Pa.N))^2 := by
          rw [hsqeq, Real.sq_sqrt (by positivity)]
          exact hle
        exact le_of_sq_le_sq h1 (Real.sqrt_nonneg _)
      calc 2 * R / (Work.FIPlan.gnorm z : ℝ) = 2 * (R/(Work.FIPlan.gnorm z : ℝ)) := by ring
        _ ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) := by linarith [hlift]
    linarith [hmain, hstep]
  · rw [Finset.not_nonempty_iff_eq_empty] at hne
    rw [hne]
    simp only [Finset.card_empty, Nat.cast_zero]
    have : (0:ℝ) ≤ Real.sqrt (2 * Pa.M / Pa.N) := Real.sqrt_nonneg _
    linarith

/-- **The arithmetic-progression per-line bound.**  If in addition `p ∤ c` (so `p ∤ Im(w₀ z)`, by
the Lagrange identity, for any point `w₀` of the line), the admissible parameter lies in a single
class modulo `p`, and only `2√(2M/N)/p + 1` values occur. -/
lemma per_c_ap_bound {Pa : Work.FITop.Params} {z : GaussianInt} {T : Finset GaussianInt}
    {c : ℤ} {p : ℕ}
    (hp : p.Prime) (hp2 : 2 < p)
    (hcop : IsCoprime z.re z.im) (hnz : (Work.FIPlan.gnorm z : ℤ) ≠ 0)
    (hNpos : 0 < Pa.N) (hMpos : 0 < Pa.M)
    (hNnz : (Pa.N : ℝ) ≤ (Work.FIPlan.gnorm z : ℝ))
    (hgz : (p:ℤ) ∣ (Work.FIPlan.gnorm z : ℤ))
    (hc : ¬ (p:ℤ) ∣ c)
    (hT : ∀ w ∈ T, w ∈ Work.FITop3.annM Pa ∧ Work.FIPlan.cForm w z = c^2
              ∧ (p:ℤ) ∣ (Work.FIPlan.gnorm w : ℤ)) :
    (T.card : ℝ) ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) / p + 1 := by
  have hnz0 : Work.FIPlan.gnorm z ≠ 0 := by
    intro h0; exact hnz (by rw [h0]; norm_num)
  have hnzR : (0:ℝ) < (Work.FIPlan.gnorm z : ℝ) := by
    exact_mod_cast Nat.pos_of_ne_zero hnz0
  by_cases hne : T.Nonempty
  · obtain ⟨w₀, hw₀⟩ := hne
    have hm0 : ¬ (p:ℤ) ∣ psi z w₀ := by
      intro hpsi
      exact hc (p_dvd_c_of_p_dvd_psi hp hgz (hT w₀ hw₀).2.1 hpsi)
    set B : Finset ℤ := T.image (psi z) with hB
    have hinj : Set.InjOn (psi z) (T : Set GaussianInt) := by
      intro a ha b hb hab
      rw [Finset.mem_coe] at ha hb
      exact psi_eq_of_cForm_eq hcop hnz (by rw [(hT a ha).2.1, (hT b hb).2.1]) hab
    have hBcard : B.card = T.card := by rw [hB]; exact Finset.card_image_of_injOn hinj
    set R : ℝ := Real.sqrt (2 * Pa.M * (Work.FIPlan.gnorm z : ℝ)) with hR
    have hRnn : 0 ≤ R := Real.sqrt_nonneg _
    have hdiv : ∀ t ∈ B, ((p * Work.FIPlan.gnorm z : ℕ) : ℤ) ∣ (t - psi z w₀) := by
      intro t ht
      rw [hB, Finset.mem_image] at ht
      obtain ⟨w, hw, rfl⟩ := ht
      have h := pnz_dvd_psi_sub hp hp2 hcop hgz hm0
        (by rw [(hT w hw).2.1, (hT w₀ hw₀).2.1]) (hT w hw).2.2 (hT w₀ hw₀).2.2
      simpa using h
    have hint : ∀ t ∈ B, |(t:ℝ)| ≤ R := by
      intro t ht
      rw [hB, Finset.mem_image] at ht
      obtain ⟨w, hw, rfl⟩ := ht
      have hgt : (Work.FIPlan.gnorm w : ℝ) ≤ 2 * Pa.M :=
        (Work.FITop3.mem_annM.mp (hT w hw).1).2.2
      have hgz0 : (0:ℝ) ≤ (Work.FIPlan.gnorm z : ℝ) := le_of_lt hnzR
      have hsq : (((psi z w : ℤ) : ℝ))^2 ≤ 2 * Pa.M * (Work.FIPlan.gnorm z : ℝ) := by
        have h1 := psi_sq_le w z
        have h2 : (((psi z w : ℤ) : ℝ))^2
            ≤ (((Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ) : ℤ) : ℝ) := by
          exact_mod_cast h1
        push_cast at h2
        calc (((psi z w : ℤ) : ℝ))^2
              ≤ (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ) := h2
          _ ≤ (2 * Pa.M) * (Work.FIPlan.gnorm z : ℝ) := mul_le_mul_of_nonneg_right hgt hgz0
      rw [hR]
      exact Real.abs_le_sqrt hsq
    have hmain := card_int_le_shifted_ap (U := B) (t0 := psi z w₀)
        (m := p * Work.FIPlan.gnorm z) (by positivity) hRnn hdiv hint
    rw [hBcard] at hmain
    have hpR : (0:ℝ) < (p:ℝ) := by exact_mod_cast hp.pos
    have hstep : 2 * R / ((p * Work.FIPlan.gnorm z : ℕ) : ℝ)
        ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) / p := by
      have hcast : ((p * Work.FIPlan.gnorm z : ℕ) : ℝ) = (p:ℝ) * (Work.FIPlan.gnorm z : ℝ) := by
        push_cast; ring
      rw [hcast]
      rw [show 2 * R / ((p:ℝ) * (Work.FIPlan.gnorm z : ℝ))
            = (2 * R / (Work.FIPlan.gnorm z : ℝ)) / p from by ring]
      have hsqeq : (R/(Work.FIPlan.gnorm z : ℝ))^2 = 2 * Pa.M / (Work.FIPlan.gnorm z : ℝ) := by
        rw [hR, div_pow, Real.sq_sqrt (by positivity)]
        field_simp
      have hle : 2 * Pa.M / (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Pa.M / Pa.N :=
        div_le_div_of_nonneg_left (by positivity) hNpos hNnz
      have hlift : R/(Work.FIPlan.gnorm z : ℝ) ≤ Real.sqrt (2 * Pa.M / Pa.N) := by
        have h1 : (R/(Work.FIPlan.gnorm z : ℝ))^2 ≤ (Real.sqrt (2 * Pa.M / Pa.N))^2 := by
          rw [hsqeq, Real.sq_sqrt (by positivity)]
          exact hle
        exact le_of_sq_le_sq h1 (Real.sqrt_nonneg _)
      have : 2 * R / (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) := by
        calc 2 * R / (Work.FIPlan.gnorm z : ℝ) = 2 * (R/(Work.FIPlan.gnorm z : ℝ)) := by ring
          _ ≤ 2 * Real.sqrt (2 * Pa.M / Pa.N) := by linarith [hlift]
      exact div_le_div_of_nonneg_right this (le_of_lt hpR)
    linarith [hmain, hstep]
  · rw [Finset.not_nonempty_iff_eq_empty] at hne
    rw [hne]
    simp only [Finset.card_empty, Nat.cast_zero]
    have hpR : (0:ℝ) ≤ (p:ℝ) := by positivity
    positivity

/-! ## 6. Auxiliary estimates: `M ≤ N³`, the fourth root, and the final arithmetic -/

/-- **`M ≤ N³`** from the range conditions of `Params` (`MN ≤ x` and `x^{1/4+η} < N`). -/
lemma M_le_N_cube (Pa : Work.FITop.Params) : Pa.M ≤ Pa.N ^ 3 := by
  have hc : 0 < (1:ℝ)/4 + Pa.η := by linarith [Pa.hη]
  have hx0 : 0 ≤ (Pa.x:ℝ) := by have := Pa.hx; positivity
  have hN1 : (1:ℝ) ≤ Pa.N := by exact_mod_cast Pa.hN1
  have hNpos : (0:ℝ) < Pa.N := by linarith
  have hstep1 : (Pa.x:ℝ) ≤ Pa.N ^ (1/((1:ℝ)/4 + Pa.η)) := by
    have h1 : (Pa.x:ℝ) ^ ((1:ℝ)/4 + Pa.η) ≤ Pa.N := le_of_lt Pa.hNlo
    have h2 := Real.rpow_le_rpow (Real.rpow_nonneg hx0 _) h1
      (le_of_lt (by positivity : (0:ℝ) < 1/((1:ℝ)/4 + Pa.η)))
    rwa [← Real.rpow_mul hx0, show ((1:ℝ)/4+Pa.η) * (1/((1:ℝ)/4+Pa.η)) = 1 by
      rw [mul_one_div, div_self hc.ne'], Real.rpow_one] at h2
  have haux : (Pa.x:ℝ)/Pa.N ≤ Pa.N ^ (1/((1:ℝ)/4 + Pa.η) - 1) := by
    rw [div_le_iff₀ hNpos]
    have hcombine : (Pa.N:ℝ) ^ (1/((1:ℝ)/4+Pa.η) - 1) * Pa.N
        = Pa.N ^ (1/((1:ℝ)/4+Pa.η)) := by
      rw [Real.rpow_sub hNpos, Real.rpow_one]
      field_simp
    rw [hcombine]; exact hstep1
  have hexp : 1/((1:ℝ)/4 + Pa.η) - 1 ≤ 3 := by
    rw [div_sub_one hc.ne', div_le_iff₀ hc]
    linarith [Pa.hη]
  have hstep3 : Pa.N ^ (1/((1:ℝ)/4 + Pa.η) - 1) ≤ Pa.N ^ 3 := by
    have h := Real.rpow_le_rpow_of_exponent_le hN1 hexp
    rwa [show (3:ℝ) = ((3:ℕ):ℝ) by norm_num, Real.rpow_natCast] at h
  have hMxN : Pa.M ≤ (Pa.x:ℝ)/Pa.N := by
    rw [le_div_iff₀ hNpos]; exact Pa.hMNx
  exact hMxN.trans (haux.trans hstep3)

/-- `√√x = x^{1/4}`. -/
lemma sqrt_sqrt_eq (a : ℝ) (ha : 0 ≤ a) : Real.sqrt (Real.sqrt a) = a ^ ((1:ℝ)/4) := by
  have h1 : Real.sqrt a = a ^ ((1:ℝ)/2) := Real.sqrt_eq_rpow a
  rw [h1, Real.sqrt_eq_rpow, ← Real.rpow_mul ha]
  norm_num

/-- **The scale comparison** `2√(2M/N) ≤ 3(MN)^{1/4}`, from `M ≤ N³`. -/
lemma X_le_three_A {M N : ℝ} (hM : 0 < M) (hN : 0 < N) (hMN : M ≤ N^3) :
    2 * Real.sqrt (2*M/N) ≤ 3 * ((M*N) ^ ((1:ℝ)/4)) := by
  have hs : (2 * Real.sqrt (2*M/N))^2 = 8*M/N := by
    rw [mul_pow, Real.sq_sqrt (by positivity)]; ring
  have hX4 : (2 * Real.sqrt (2*M/N))^4 = 64 * M^2 / N^2 := by
    rw [show (2 * Real.sqrt (2*M/N))^4 = ((2 * Real.sqrt (2*M/N))^2)^2 by ring, hs]
    ring
  have hA4 : (3 * ((M*N) ^ ((1:ℝ)/4)))^4 = 81 * (M*N) := by
    rw [mul_pow]
    rw [show (3:ℝ)^4 = 81 by norm_num]
    rw [show (((M*N) ^ ((1:ℝ)/4)))^4 = (M*N) by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
      norm_num]
  have hXnn : 0 ≤ 2 * Real.sqrt (2*M/N) := by positivity
  have hAnn : 0 ≤ 3 * ((M*N) ^ ((1:ℝ)/4)) := by positivity
  rw [← pow_le_pow_iff_left₀ hXnn hAnn (by norm_num : (4:ℕ) ≠ 0), hX4, hA4]
  rw [div_le_iff₀ (by positivity)]
  nlinarith [hMN, hM, hN, sq_nonneg M, sq_nonneg N, sq_nonneg (M - N^3), mul_pos hM hN]

/-- The number of multiples of `p` in `{0, 1, …, D}` is at most `D/p + 1`. -/
lemma card_range_filter_dvd_le (D p : ℕ) :
    ((Finset.range (D+1)).filter (fun c => p ∣ c)).card ≤ D/p + 1 := by
  by_cases hp : p = 0
  · subst hp
    have : (Finset.range (D+1)).filter (fun c => 0 ∣ c) ⊆ ({0} : Finset ℕ) := by
      intro c hc
      rw [Finset.mem_filter] at hc
      rw [Finset.mem_singleton]
      exact zero_dvd_iff.mp hc.2
    calc ((Finset.range (D+1)).filter (fun c => 0 ∣ c)).card ≤ ({0} : Finset ℕ).card :=
          Finset.card_le_card this
      _ = 1 := by simp
      _ ≤ D/0 + 1 := by simp
  · have hp0 : 0 < p := Nat.pos_of_ne_zero hp
    have hinj : Set.InjOn (fun c => c/p)
        (((Finset.range (D+1)).filter (fun c => p ∣ c)) : Set ℕ) := by
      intro a ha b hb hab
      simp only [Finset.mem_coe, Finset.mem_filter, Finset.mem_range] at ha hb
      have ha' : a = p * (a/p) := (Nat.mul_div_cancel' ha.2).symm
      have hb' : b = p * (b/p) := (Nat.mul_div_cancel' hb.2).symm
      have hab' : a/p = b/p := hab
      rw [ha', hb', hab']
    have himg : ((Finset.range (D+1)).filter (fun c => p ∣ c)).image (fun c => c/p)
        ⊆ Finset.range (D/p + 1) := by
      intro j hj
      rw [Finset.mem_image] at hj
      obtain ⟨c, hc, rfl⟩ := hj
      rw [Finset.mem_filter, Finset.mem_range] at hc
      rw [Finset.mem_range]
      exact lt_of_le_of_lt (Nat.div_le_div_right (Nat.lt_succ_iff.mp hc.1)) (Nat.lt_succ_self (D/p))
    calc ((Finset.range (D+1)).filter (fun c => p ∣ c)).card
        = (((Finset.range (D+1)).filter (fun c => p ∣ c)).image (fun c => c/p)).card :=
          (Finset.card_image_of_injOn hinj).symm
      _ ≤ (Finset.range (D/p + 1)).card := Finset.card_le_card himg
      _ = D/p + 1 := Finset.card_range _

/-- **The final real inequality** of the lattice count. -/
lemma arith_final {A X Y p : ℝ} (hp0 : 0 < p) (hp1 : 1 ≤ p)
    (hA1 : 1 ≤ A) (hX0 : 0 ≤ X) (hY0 : 0 ≤ Y) (hX3 : X ≤ 3*A) (hX3Y : X ≤ 3*Y) :
    (3*A+1)*(X/p+1) + (3*A/p+1)*(X+1) ≤ 200*A*(1+Y/p) := by
  have hA0 : 0 ≤ A := le_trans zero_le_one hA1
  rw [← sub_nonneg]
  have key : 0 ≤ (200*A*(1+Y/p) - ((3*A+1)*(X/p+1) + (3*A/p+1)*(X+1))) * p := by
    have expand : (200*A*(1+Y/p) - ((3*A+1)*(X/p+1) + (3*A/p+1)*(X+1))) * p
        = 200*A*Y + 200*A*p - (6*A*X + 3*A*p + X + 3*A + X*p + 2*p) := by
      field_simp
      ring
    rw [expand]
    nlinarith [hA1, hX0, hY0, hp1, hX3, hX3Y, hA0, mul_nonneg hX0 hA0,
      mul_nonneg hY0 hA0, mul_nonneg hX0 (le_of_lt hp0), mul_nonneg hA0 (le_of_lt hp0)]
  rwa [mul_nonneg_iff_of_pos_right hp0] at key


/-- **The lattice count of *FI* (5.10)** (the removal of the coprimality constraint).

For a point `z` of the inner box (`N < |z|² ≤ 2N`, squarefree norm) and a prime `p ∣ |z|²` with
`2 < p`, the number of `w` in the outer dyadic annulus `annM Pa` (`M < |w|² ≤ 2M`) with both
`p ∣ |w|²` and `Re(wz) = c²` for some integer `c` satisfies
`# ≤ 200 (MN)^{1/4}(1 + √M/(p√N))`. -/
theorem count_annulus {Pa : Work.FITop.Params} {z : GaussianInt} {p : ℕ}
    (hp : p.Prime) (hp2 : 2 < p)
    (hzlo : (Pa.N : ℝ) < (Work.FIPlan.gnorm z : ℝ))
    (hzhi : (Work.FIPlan.gnorm z : ℝ) ≤ 2 * Pa.N)
    (hsq : Squarefree (Work.FIPlan.gnorm z)) (hpd : p ∣ Work.FIPlan.gnorm z) :
    (((Work.FITop3.annM Pa).filter
        (fun w => p ∣ Work.FIPlan.gnorm w ∧ ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2)).card : ℝ)
      ≤ 200 * (Pa.M * Pa.N) ^ ((1 : ℝ) / 4)
          * (1 + Real.sqrt Pa.M / ((p : ℝ) * Real.sqrt Pa.N)) := by
  classical
  have hNpos : (0:ℝ) < Pa.N := by linarith [Pa.hN1]
  have hMpos : (0:ℝ) < Pa.M := by linarith [Pa.hM1]
  have hp0R : (0:ℝ) < p := by exact_mod_cast hp.pos
  have hp1R : (1:ℝ) ≤ p := by exact_mod_cast hp.one_le
  have hcop : IsCoprime z.re z.im := by
    rw [Int.isCoprime_iff_gcd_eq_one, Int.gcd_eq_natAbs]
    exact Work.FIArea1.coprime_coords_of_sqfree hsq
  have hnzR : (0:ℝ) < (Work.FIPlan.gnorm z : ℝ) := by linarith
  have hnz : (Work.FIPlan.gnorm z : ℤ) ≠ 0 := by
    have := hnzR.ne'
    exact_mod_cast this
  have hNnz : (Pa.N : ℝ) ≤ (Work.FIPlan.gnorm z : ℝ) := le_of_lt hzlo
  have hgz : (p:ℤ) ∣ (Work.FIPlan.gnorm z : ℤ) := by
    rw [Int.natCast_dvd_natCast]; exact hpd
  set A : ℝ := (Pa.M * Pa.N) ^ ((1:ℝ)/4) with hAdef
  set X : ℝ := 2 * Real.sqrt (2 * Pa.M / Pa.N) with hXdef
  set Y : ℝ := Real.sqrt (Pa.M / Pa.N) with hYdef
  set D : ℕ := ⌈Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N))⌉₊ with hDdef
  set S : Finset GaussianInt := (Work.FITop3.annM Pa).filter
      (fun w => p ∣ Work.FIPlan.gnorm w ∧ ∃ c : ℤ, Work.FIPlan.cForm w z = c ^ 2) with hSdef
  have hA1 : 1 ≤ A := by
    rw [hAdef]
    exact Real.one_le_rpow (by nlinarith [Pa.hM1, Pa.hN1]) (by norm_num)
  have hX0 : 0 ≤ X := by rw [hXdef]; positivity
  have hY0 : 0 ≤ Y := by rw [hYdef]; positivity
  have hX3 : X ≤ 3*A := by
    rw [hXdef, hAdef]
    exact X_le_three_A hMpos hNpos (M_le_N_cube Pa)
  have hX3Y : X ≤ 3*Y := by
    rw [hXdef, hYdef]
    have hsq2 : Real.sqrt (2 * Pa.M / Pa.N) = Real.sqrt 2 * Real.sqrt (Pa.M / Pa.N) := by
      rw [show 2 * Pa.M / Pa.N = 2 * (Pa.M / Pa.N) by ring, Real.sqrt_mul (by norm_num)]
    rw [hsq2]
    have hs2 : Real.sqrt 2 ≤ (3:ℝ)/2 := by
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    nlinarith [hs2, Real.sqrt_nonneg (Pa.M / Pa.N)]
  have hDle : (D:ℝ) ≤ 3*A := by
    rw [hDdef, hAdef]
    have hsq2 : Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N))
        = Real.sqrt 2 * Real.sqrt (Real.sqrt (Pa.M * Pa.N)) := Real.sqrt_mul (by norm_num) _
    have hsq3 : Real.sqrt (Real.sqrt (Pa.M * Pa.N)) = (Pa.M * Pa.N) ^ ((1:ℝ)/4) :=
      sqrt_sqrt_eq _ (by positivity)
    have hs2 : Real.sqrt 2 ≤ 2 := by
      nlinarith [Real.sq_sqrt (show (0:ℝ) ≤ 2 by norm_num), Real.sqrt_nonneg 2]
    have hub : Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N)) ≤ 2 * (Pa.M * Pa.N) ^ ((1:ℝ)/4) := by
      rw [hsq2, hsq3]
      nlinarith [hs2, Real.sqrt_nonneg ((Pa.M * Pa.N) ^ ((1:ℝ)/4))]
    have hlt := Nat.ceil_lt_add_one (a := Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N)))
      (Real.sqrt_nonneg _)
    rw [← hDdef] at hlt
    have hA1' : 1 ≤ (Pa.M * Pa.N) ^ ((1:ℝ)/4) :=
      Real.one_le_rpow (by nlinarith [Pa.hM1, Pa.hN1]) (by norm_num)
    linarith [hub, hlt, hA1']
  have hmem : ∀ w ∈ S, ∃ c ∈ Finset.range (D+1), Work.FIPlan.cForm w z = (c:ℤ)^2 := by
    intro w hw
    rw [hSdef, Finset.mem_filter] at hw
    obtain ⟨hwan, -, c₀, hc₀⟩ := hw
    refine ⟨c₀.natAbs, ?_, ?_⟩
    · rw [Finset.mem_range]
      have hnat : (((c₀.natAbs : ℕ) : ℝ))^2 = (c₀:ℝ)^2 := by
        have h2 : (((c₀.natAbs : ℤ) : ℝ))^2 = (c₀:ℝ)^2 := by exact_mod_cast Int.natAbs_sq c₀
        simpa using h2
      have hle2 : (c₀:ℝ)^2 ≤ 2 * Real.sqrt (Pa.M * Pa.N) := by
        have h1 := Work.FIArea1.cForm_sq_le w z
        rw [hc₀] at h1
        have hgw : (Work.FIPlan.gnorm w : ℝ) ≤ 2 * Pa.M := (Work.FITop3.mem_annM.mp hwan).2.2
        have h4 : ((c₀:ℝ)^2)^2 ≤ 4 * Pa.M * Pa.N := by
          have h2 : (((c₀^2)^2 : ℤ) : ℝ)
              ≤ (((Work.FIPlan.gnorm w : ℤ) * (Work.FIPlan.gnorm z : ℤ) : ℤ) : ℝ) := by
            exact_mod_cast h1
          push_cast at h2
          have h3 : (Work.FIPlan.gnorm w : ℝ) * (Work.FIPlan.gnorm z : ℝ)
              ≤ (2*Pa.M)*(2*Pa.N) := mul_le_mul hgw hzhi (by positivity) (by positivity)
          nlinarith [h2, h3]
        have h5 : ((c₀:ℝ)^2)^2 ≤ (2*Real.sqrt (Pa.M*Pa.N))^2 := by
          rw [mul_pow, Real.sq_sqrt (by positivity)]
          linarith [h4]
        have := abs_le_of_sq_le_sq h5 (by positivity)
        rwa [abs_of_nonneg (by positivity)] at this
      have hle2' : (((c₀.natAbs : ℕ) : ℝ))^2 ≤ 2 * Real.sqrt (Pa.M * Pa.N) := by
        rw [hnat]; exact hle2
      have hcc : (((c₀.natAbs : ℕ)) : ℝ) ≤ Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N)) :=
        (Real.le_sqrt (by positivity) (by positivity)).mpr hle2'
      have hDge : Real.sqrt (2 * Real.sqrt (Pa.M * Pa.N)) ≤ (D:ℝ) := by
        rw [hDdef]; exact Nat.le_ceil _
      have hfin : ((c₀.natAbs : ℕ) : ℝ) ≤ (D:ℝ) := le_trans hcc hDge
      have : c₀.natAbs ≤ D := by exact_mod_cast hfin
      omega
    · rw [hc₀, ← Int.natAbs_sq c₀]
  set F : ℕ → Finset GaussianInt := fun c => S.filter (fun w => Work.FIPlan.cForm w z = (c:ℤ)^2)
    with hFdef
  have hTgen : ∀ c, ∀ w ∈ F c, w ∈ Work.FITop3.annM Pa ∧ Work.FIPlan.cForm w z = (c:ℤ)^2 := by
    intro c w hw
    rw [hFdef, Finset.mem_filter] at hw
    rw [hSdef, Finset.mem_filter] at hw
    exact ⟨hw.1.1, hw.2⟩
  have hTap : ∀ c, ∀ w ∈ F c, w ∈ Work.FITop3.annM Pa ∧ Work.FIPlan.cForm w z = (c:ℤ)^2
      ∧ (p:ℤ) ∣ (Work.FIPlan.gnorm w : ℤ) := by
    intro c w hw
    rw [hFdef, Finset.mem_filter] at hw
    rw [hSdef, Finset.mem_filter] at hw
    exact ⟨hw.1.1, hw.2, by rw [Int.natCast_dvd_natCast]; exact hw.1.2.1⟩
  have hcard_le : (S.card : ℝ) ≤ ∑ c ∈ Finset.range (D+1), ((F c).card : ℝ) := by
    have hsub : S ⊆ (Finset.range (D+1)).biUnion F := by
      intro w hw
      obtain ⟨c, hc, hcw⟩ := hmem w hw
      exact Finset.mem_biUnion.mpr ⟨c, hc, by rw [hFdef, Finset.mem_filter]; exact ⟨hw, hcw⟩⟩
    calc (S.card : ℝ) ≤ (((Finset.range (D+1)).biUnion F).card : ℝ) := by
          exact_mod_cast Finset.card_le_card hsub
      _ ≤ ((∑ c ∈ Finset.range (D+1), (F c).card : ℕ) : ℝ) := by
          exact_mod_cast Finset.card_biUnion_le
      _ = ∑ c ∈ Finset.range (D+1), ((F c).card : ℝ) := by push_cast; ring
  have hbound_good : ∀ c ∈ (Finset.range (D+1)).filter (fun c => ¬ p ∣ c),
      ((F c).card : ℝ) ≤ X/p + 1 := by
    intro c hc
    rw [Finset.mem_filter] at hc
    have hcd : ¬ (p:ℤ) ∣ (c:ℤ) := fun h => hc.2 (Int.natCast_dvd_natCast.mp h)
    have h := per_c_ap_bound (Pa := Pa) (z := z) (T := F c) (c := (c:ℤ)) (p := p)
      hp hp2 hcop hnz hNpos hMpos hNnz hgz hcd (hTap c)
    rw [hXdef]; exact h
  have hbound_bad : ∀ c ∈ (Finset.range (D+1)).filter (fun c => p ∣ c),
      ((F c).card : ℝ) ≤ X + 1 := by
    intro c hc
    rw [Finset.mem_filter] at hc
    have h := per_c_gen_bound (Pa := Pa) (z := z) (T := F c) (v := (c:ℤ)^2)
      hcop hnz hNpos hMpos hNnz (hTgen c)
    rw [hXdef]; exact h
  have hsplit : ∑ c ∈ Finset.range (D+1), ((F c).card : ℝ)
      = ∑ c ∈ (Finset.range (D+1)).filter (fun c => p ∣ c), ((F c).card : ℝ)
        + ∑ c ∈ (Finset.range (D+1)).filter (fun c => ¬ p ∣ c), ((F c).card : ℝ) :=
    (Finset.sum_filter_add_sum_filter_not (Finset.range (D+1)) (fun c => p ∣ c)
