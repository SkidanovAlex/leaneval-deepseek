      _ = (((Finset.range (D+1)).filter (fun c => ¬ p ∣ c)).card : ℝ) * (X/p + 1) := by
          rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ((D:ℝ) + 1) * (X/p + 1) := by
