          have hcard := Finset.card_filter_le (Finset.range (D+1)) (fun c => ¬ p ∣ c)
          calc (((Finset.range (D+1)).filter (fun c => ¬ p ∣ c)).card : ℝ)
              ≤ ((Finset.range (D+1)).card : ℝ) := by exact_mod_cast hcard
            _ = (D:ℝ) + 1 := by rw [Finset.card_range]; push_cast; ring
  have key3 : ((D:ℝ)/(p:ℝ) + 1) * (X + 1) ≤ (3*A/p + 1) * (X + 1) := by
