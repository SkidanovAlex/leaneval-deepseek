import Mathlib
import Submission.Work.FIArea6Hecke.R.ConductorThetaDefs

namespace Work.FIArea6Hecke

/-- Reindexing an infinite sum over the multiples of a nonzero Gaussian integer `M`:
summing `F` over `M * γ` (all `γ`) is the same as summing `F` (with an indicator)
over the ideal `(M) = {ξ | M ∣ ξ}`. -/
theorem tsumIdeal (M : GaussianInt) (hM : M ≠ 0) (F : GaussianInt → ℂ) :
    (∑' γ : GaussianInt, F (M * γ))
      = ∑' ξ : GaussianInt, ({ξ : GaussianInt | M ∣ ξ} : Set GaussianInt).indicator F ξ := by
  -- multiplication by a nonzero Gaussian integer is injective (it is a domain)
  have hinj : Function.Injective (fun γ : GaussianInt => M * γ) :=
    fun a b h => mul_left_cancel₀ hM h
  -- the range of `γ ↦ M * γ` is exactly the ideal generated by `M`
  have hrange : Set.range (fun γ : GaussianInt => M * γ) = {ξ : GaussianInt | M ∣ ξ} := by
    ext ξ
    simp only [Set.mem_range, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨γ, rfl⟩; exact ⟨γ, rfl⟩
    · rintro ⟨γ, hγ⟩; exact ⟨γ, hγ.symm⟩
  -- convert the indicator sum into a sum over the subtype given by the range,
  -- then reindex along the equiv between `GaussianInt` and that range
  rw [← tsum_subtype ({ξ : GaussianInt | M ∣ ξ}) F, ← hrange]
  exact (Equiv.tsum_eq (Equiv.ofInjective (fun γ : GaussianInt => M * γ) hinj)
    (fun x : Set.range (fun γ : GaussianInt => M * γ) => F ↑x))

end Work.FIArea6Hecke
