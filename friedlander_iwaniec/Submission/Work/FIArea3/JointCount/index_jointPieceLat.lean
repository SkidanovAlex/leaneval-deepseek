import Mathlib
import Submission.Work.FIArea3.JointCount.pieces

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

namespace Work.FIArea3.JointCount

noncomputable section

attribute [local instance] Classical.propDecidable

/-!
# Index of the joint piece lattice `jointPieceLat`

We prove

  `(jointPieceLat z₁ w e).index = gnorm w * (e / gcd e (gcd (star z₁ * w).im).natAbs (star z₁ * w).re).natAbs)`

for `1 ≤ e` and `w ≠ 0`.

The argument is the elementary one.  `jointPieceLat z₁ w e` is the image of the congruence
lattice `yLat A B e` (`A = (star z₁ * w).im`, `B = (star z₁ * w).re`) under the injective additive
endomorphism `y ↦ y * w` of `ℤ[i]`; hence

  `index jointPieceLat = index (yLat A B e) * index (range (mulRight w))`,

and the two factors are `e / gcd e (gcd A.natAbs B.natAbs)` (`yLat_index_formula`) and `gnorm w`
(`mulRight_range_index`), the latter being the index of the ideal `w ℤ[i] ⊆ ℤ[i]`.

The index of `w ℤ[i]` is computed by transporting to `ℤ²` and using the general fact that the
index of the range of an integer `2 × 2` matrix acting on `ℤ²` is the absolute value of its
determinant (`index_range_toLin_det`), together with `det !![a, -b; b, a] = a² + b²`.

The index of `yLat A B e` is computed from the first isomorphism theorem: `yLat A B e` is the
kernel of the additive homomorphism `ℤ[i] → ZMod e`, `y ↦ A · im + B · re`, whose range is the
subgroup of `ZMod e` generated by `A` and `B`, of cardinality `e / gcd e A B`
(`card_closure_pair_zmod`).
-/

/-- The additive equivalence `ℤ[i] ≃+ (Fin 2 → ℤ)` sending `z` to `(z.re, z.im)`. -/
def gaussPairEquiv : GaussianInt ≃+ (Fin 2 → ℤ) where
  toFun z := ![z.re, z.im]
  invFun p := ⟨p 0, p 1⟩
  left_inv z := by cases z; rfl
  right_inv p := by funext i; fin_cases i <;> rfl
  map_add' z w := by funext i; fin_cases i <;> simp [Zsqrtd.re_add, Zsqrtd.im_add]

/-- For an integer `2 × 2` matrix `M` with nonzero determinant acting on `ℤ² = Fin 2 → ℤ`, the
index of the range is `|det M|`. -/
lemma index_range_toLin_det (M : Matrix (Fin 2) (Fin 2) ℤ) (hM : M.det ≠ 0) :
    (LinearMap.range (Matrix.toLin' M)).toAddSubgroup.index = M.det.natAbs := by
  have hdet : LinearMap.det (Matrix.toLin' M : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) ≠ 0 := by
    rw [LinearMap.det_toLin']; exact hM
  have hinj : Function.Injective (Matrix.toLin' M : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ)) := by
    rw [← LinearMap.ker_eq_bot]
    by_contra h
    exact hdet ((LinearMap.det_eq_zero_iff_ker_ne_bot).mpr h)
  set T : (Fin 2 → ℤ) →ₗ[ℤ] (Fin 2 → ℤ) := Matrix.toLin' M with hT
  have hinjT : Function.Injective T := by rw [hT]; exact hinj
  have h := Submodule.natAbs_det_equiv (N := LinearMap.range T)
      (e := LinearEquiv.ofInjective T hinjT)
  rw [show (LinearMap.range T).toAddSubgroup.index
        = Nat.card ((Fin 2 → ℤ) ⧸ LinearMap.range T) from
        (Submodule.cardQuot_apply (LinearMap.range T)).symm.trans rfl]
  rw [← h]
  congr 1
  rw [← LinearMap.det_toLin' M]
  congr 1

/-- The index of the ideal `w ℤ[i] ⊆ ℤ[i]` is `gnorm w`. -/
lemma mulRight_range_index (w : GaussianInt) (hw : w ≠ 0) :
    (AddMonoidHom.mulRight w).range.index = Work.FIPlan.gnorm w := by
  set M : Matrix (Fin 2) (Fin 2) ℤ := !![w.re, -w.im; w.im, w.re] with hM
  have hMnorm : M.det = w.norm := by
    rw [hM, Matrix.det_fin_two]; simp [Zsqrtd.norm]
  have hMdet : M.det ≠ 0 := by
    rw [hMnorm]
    intro h
    exact hw ((Zsqrtd.norm_eq_zero (d := -1) (by intro n _; nlinarith [sq_nonneg n]) w).mp h)
  have h2 : AddMonoidHom.comp (gaussPairEquiv : GaussianInt →+ (Fin 2 → ℤ))
        (AddMonoidHom.mulRight w)
      = AddMonoidHom.comp ((Matrix.toLin' M).toAddMonoidHom)
        (gaussPairEquiv : GaussianInt →+ (Fin 2 → ℤ)) := by
    ext y i
    fin_cases i <;>
      simp [gaussPairEquiv, Matrix.toLin'_apply, Matrix.mulVec, Matrix.of_apply,
        Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val',
        Zsqrtd.re_mul, Zsqrtd.im_mul, hM] <;>
      ring
  have hmap : (AddMonoidHom.mulRight w).range.map (gaussPairEquiv : GaussianInt →+ (Fin 2 → ℤ))
      = (LinearMap.range (Matrix.toLin' M)).toAddSubgroup := by
    rw [← AddMonoidHom.range_comp (gaussPairEquiv : GaussianInt →+ (Fin 2 → ℤ))
        (AddMonoidHom.mulRight w), h2, AddMonoidHom.range_comp]
    rw [AddMonoidHom.range_eq_top.mpr gaussPairEquiv.surjective, ← AddMonoidHom.range_eq_map,
      ← LinearMap.range_toAddSubgroup]
  rw [← AddSubgroup.index_map_equiv (AddMonoidHom.mulRight w).range gaussPairEquiv, hmap,
    index_range_toLin_det M hMdet, hMnorm]
  rfl

/-- The additive homomorphism `y ↦ A · y.im + B · y.re` from `ℤ[i]` to `ℤ/e`. -/
def yLatHom (A B : ℤ) (e : ℕ) : GaussianInt →+ ZMod e where
  toFun y := ((A * y.im + B * y.re : ℤ) : ZMod e)
  map_zero' := by simp
  map_add' := by intro x y; simp [Zsqrtd.re_add, Zsqrtd.im_add]; ring

/-- `yLat A B e` is the kernel of `yLatHom A B e`. -/
lemma yLatHom_ker (A B : ℤ) (e : ℕ) : (yLatHom A B e).ker = yLat A B e := by
  ext y
  change ((A * y.im + B * y.re : ℤ) : ZMod e) = 0 ↔ (e : ℤ) ∣ A * y.im + B * y.re
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- The range of `yLatHom A B e` is the subgroup of `ZMod e` generated by `A` and `B`. -/
lemma yLatHom_range (A B : ℤ) (e : ℕ) :
    (yLatHom A B e).range = AddSubgroup.closure {((B : ℤ) : ZMod e), ((A : ℤ) : ZMod e)} := by
  apply le_antisymm
  · intro z hz
    rw [AddMonoidHom.mem_range] at hz
    obtain ⟨y, rfl⟩ := hz
    rw [AddSubgroup.mem_closure_pair]
    refine ⟨y.re, y.im, ?_⟩
    rw [zsmul_eq_mul, zsmul_eq_mul]
    change (y.re : ZMod e) * ((B : ℤ) : ZMod e) + (y.im : ZMod e) * ((A : ℤ) : ZMod e)
      = ((A * y.im + B * y.re : ℤ) : ZMod e)
    push_cast
    ring
  · rw [AddSubgroup.closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl
    · exact ⟨1, by simp [yLatHom]⟩
    · exact ⟨⟨0, 1⟩, by simp [yLatHom]⟩

/-- The subgroup of `ZMod e` generated by two integers `a`, `b` has `e / gcd e a b` elements. -/
lemma card_closure_pair_zmod (a b : ℤ) (e : ℕ) (he : 1 ≤ e) :
    Nat.card (AddSubgroup.closure {((a : ℤ) : ZMod e), ((b : ℤ) : ZMod e)})
      = e / Nat.gcd e (Nat.gcd a.natAbs b.natAbs) := by
  have he0 : e ≠ 0 := by omega
  have hcl : AddSubgroup.closure {((a : ℤ) : ZMod e), ((b : ℤ) : ZMod e)}
      = AddSubgroup.zmultiples (((a.gcd b : ℕ)) : ZMod e) := by
    apply le_antisymm
    · rw [AddSubgroup.closure_le]
      intro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · obtain ⟨k, hk⟩ := Int.gcd_dvd_left a b
        change ((a : ℤ) : ZMod e) ∈ AddSubgroup.zmultiples (((a.gcd b : ℕ)) : ZMod e)
        rw [AddSubgroup.mem_zmultiples_iff]
        refine ⟨k, ?_⟩
        rw [zsmul_eq_mul]
        conv_rhs => rw [hk]
        push_cast
        ring
      · obtain ⟨k, hk⟩ := Int.gcd_dvd_right a b
        change ((b : ℤ) : ZMod e) ∈ AddSubgroup.zmultiples (((a.gcd b : ℕ)) : ZMod e)
        rw [AddSubgroup.mem_zmultiples_iff]
        refine ⟨k, ?_⟩
        rw [zsmul_eq_mul]
        conv_rhs => rw [hk]
        push_cast
        ring
    · rw [AddSubgroup.zmultiples_le, AddSubgroup.mem_closure_pair]
      refine ⟨a.gcdA b, a.gcdB b, ?_⟩
      rw [zsmul_eq_mul, zsmul_eq_mul]
      have h2 : ((a.gcd b : ℕ) : ZMod e) = ((a * a.gcdA b + b * a.gcdB b : ℤ) : ZMod e) := by
        rw [← Int.gcd_eq_gcd_ab a b]; push_cast; rfl
      rw [h2]
      push_cast
      ring
  rw [hcl, Nat.card_zmultiples, ZMod.addOrderOf_coe (a.gcd b) he0, Int.gcd_eq_natAbs]

/-- The index of the congruence lattice `yLat A B e`. -/
lemma yLat_index_formula (A B : ℤ) (e : ℕ) (he : 1 ≤ e) :
    (yLat A B e).index = e / Nat.gcd e (Nat.gcd A.natAbs B.natAbs) := by
  rw [← yLatHom_ker A B e, AddSubgroup.index_ker, yLatHom_range A B e,
    card_closure_pair_zmod B A e he, Nat.gcd_comm B.natAbs A.natAbs]

theorem index_jointPieceLat (z₁ w : GaussianInt) (e : ℕ) (he : 1 ≤ e) (hw : w ≠ 0) :
    (Work.FIArea3.JointCount.jointPieceLat z₁ w e).index =
      Work.FIPlan.gnorm w * (e / Nat.gcd e (Nat.gcd (star z₁ * w).im.natAbs (star z₁ * w).re.natAbs)) := by
  have hinj : Function.Injective (AddMonoidHom.mulRight w) := by
    intro a b hab
    simp only [AddMonoidHom.mulRight_apply] at hab
    exact mul_right_cancel₀ hw hab
  rw [show jointPieceLat z₁ w e
        = (yLat (star z₁ * w).im (star z₁ * w).re e).map (AddMonoidHom.mulRight w) from rfl]
  rw [AddSubgroup.index_map_of_injective _ hinj, mulRight_range_index w hw,
    yLat_index_formula (star z₁ * w).im (star z₁ * w).re e he, mul_comm]

end

end Work.FIArea3.JointCount
