/-
# `Work.FIArea3.JointCount.crs_cone_iff`

The cone/wedge membership characterisation for the signed-area pair `(crs (cs α) z, crs z (cs β))`:
for angles `α < β` with `β - α ≤ π` inside `[-π, π]`, a nonzero `z` lies in the closed cone
generated by the directions `α` and `β` (equivalently satisfies the two signed-area inequalities)
iff its argument lies in `[α, β]`, with the single extra possibility that `α = -π` and `z` points
along the ray of `cs α` (i.e. `arg z = π`, the same direction as `-π`).
-/
import Mathlib
import Submission.Work.FIArea3.JointCount.angSector_geom_defs

namespace Work.FIArea3.JointCount

noncomputable section

/-- `crs (cs α) z` as a function of the argument of `z`. -/
lemma crs_cs_left (α : ℝ) (z : ℂ) (hz : z ≠ 0) :
    crs (cs α) z = Real.sin (Complex.arg z - α) * ‖z‖ := by
  have hne : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
  have hre : z.re = Real.cos (Complex.arg z) * ‖z‖ := by
    rw [Complex.cos_arg hz, div_mul_cancel₀ z.re hne]
  have hsm : z.im = Real.sin (Complex.arg z) * ‖z‖ := by
    rw [Complex.sin_arg z, div_mul_cancel₀ z.im hne]
  rw [crs_apply, cs_re, cs_im, hre, hsm, Real.sin_sub]
  ring

/-- `crs z (cs β)` as a function of the argument of `z`. -/
lemma crs_cs_right (β : ℝ) (z : ℂ) (hz : z ≠ 0) :
    crs z (cs β) = Real.sin (β - Complex.arg z) * ‖z‖ := by
  have hne : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
  have hre : z.re = Real.cos (Complex.arg z) * ‖z‖ := by
    rw [Complex.cos_arg hz, div_mul_cancel₀ z.re hne]
  have hsm : z.im = Real.sin (Complex.arg z) * ‖z‖ := by
    rw [Complex.sin_arg z, div_mul_cancel₀ z.im hne]
  rw [crs_apply, cs_re, cs_im, hre, hsm, Real.sin_sub]
  ring

theorem crs_cone_iff (α β : ℝ) (hα : -Real.pi ≤ α) (hβ : β ≤ Real.pi) (hαβ : α < β)
    (hℓ : β - α ≤ Real.pi) (z : ℂ) (hz : z ≠ 0) :
    (0 ≤ crs (cs α) z ∧ 0 ≤ crs z (cs β)) ↔
      (Complex.arg z ∈ Set.Icc α β ∨ ∃ t : ℝ, 0 ≤ t ∧ z = t • cs α) := by
  have hrpos : (0 : ℝ) < ‖z‖ := norm_pos_iff.mpr hz
  have hθlo : -Real.pi < Complex.arg z := Complex.neg_pi_lt_arg z
  have hθhi : Complex.arg z ≤ Real.pi := Complex.arg_le_pi z
  constructor
  · rintro ⟨hA, hB⟩
    rw [crs_cs_left α z hz] at hA
    rw [crs_cs_right β z hz] at hB
    have hsu : 0 ≤ Real.sin (Complex.arg z - α) := nonneg_of_mul_nonneg_left hA hrpos
    have hsv : 0 ≤ Real.sin (β - Complex.arg z) := nonneg_of_mul_nonneg_left hB hrpos
    -- the left signed area forces `arg z - α ≥ 0`
    have hu : 0 ≤ Complex.arg z - α := by
      by_contra h
      push Not at h
      have hu_le : Complex.arg z - α ≤ -Real.pi := by
        by_contra h2
        push Not at h2
        exact absurd (Real.sin_neg_of_neg_of_neg_pi_lt h h2) (not_lt.mpr hsu)
      have hv_gt : Real.pi < β - Complex.arg z := by linarith
      have hv_lt : β - Complex.arg z < 2 * Real.pi := by linarith
      have hneg : Real.sin (β - Complex.arg z) < 0 := by
        have he : β - Complex.arg z = (β - Complex.arg z - Real.pi) + Real.pi := by ring
        rw [he, Real.sin_add_pi, neg_lt_zero]
        apply Real.sin_pos_of_pos_of_lt_pi <;> linarith
      linarith
    rcases lt_or_ge Real.pi (Complex.arg z - α) with hcase | hcase
    · -- `arg z - α > π`: forced to the wrap-around point `arg z - α = 2π`
      right
      have hu_upper : Complex.arg z - α ≤ 2 * Real.pi := by linarith
      have hu_eq : Complex.arg z - α = 2 * Real.pi := by
        have hw : 0 < Complex.arg z - α - Real.pi := by linarith
        have hwle : Complex.arg z - α - Real.pi ≤ Real.pi := by linarith
        have hsw : Real.sin (Complex.arg z - α - Real.pi) = 0 := by
          have h1 : Real.sin (Complex.arg z - α) = -Real.sin (Complex.arg z - α - Real.pi) := by
            have h2 := Real.sin_add_pi (Complex.arg z - α - Real.pi)
            rw [show Complex.arg z - α - Real.pi + Real.pi = Complex.arg z - α by ring] at h2
            exact h2
          have hpos : 0 ≤ Real.sin (Complex.arg z - α - Real.pi) :=
            Real.sin_nonneg_of_nonneg_of_le_pi (le_of_lt hw) hwle
          linarith
        rcases eq_or_lt_of_le hwle with hwp | hwp
        · linarith
        · exact absurd (Real.sin_pos_of_pos_of_lt_pi hw hwp) (not_lt.mpr (le_of_eq hsw))
      have hαeq : α = -Real.pi := by linarith
      have hθeq : Complex.arg z = Real.pi := by linarith
      refine ⟨‖z‖, norm_nonneg z, ?_⟩
      have hre : z.re = -‖z‖ := by
        have h := Complex.cos_arg hz
        rw [hθeq, Real.cos_pi] at h
        have hne : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
        have h2 : z.re = -1 * ‖z‖ := (div_eq_iff hne).mp h.symm
        linarith
      have him : z.im = 0 := by
        have h := Complex.sin_arg z
        rw [hθeq, Real.sin_pi] at h
        have hne : ‖z‖ ≠ 0 := norm_ne_zero_iff.mpr hz
        have h2 : z.im = 0 * ‖z‖ := (div_eq_iff hne).mp h.symm
        linarith
      apply Complex.ext
      · rw [Complex.smul_re, cs_re, hαeq, Real.cos_neg, Real.cos_pi, hre]
        ring
      · rw [Complex.smul_im, cs_im, hαeq, Real.sin_neg, Real.sin_pi, him]
        ring
    · -- `arg z - α ≤ π`: the right signed area forces `β - arg z ≥ 0`
      left
      refine ⟨by linarith, ?_⟩
      have hv : 0 ≤ β - Complex.arg z := by
        by_contra h
        push Not at h
        have hv_ge : -Real.pi ≤ β - Complex.arg z := by linarith
        rcases eq_or_lt_of_le hv_ge with heq | hlt
        · linarith [hαβ]
        · exact absurd (Real.sin_neg_of_neg_of_neg_pi_lt h hlt) (not_lt.mpr hsv)
      linarith
  · rintro (harg | ⟨t, ht0, htz⟩)
    · rw [Set.mem_Icc] at harg
      rw [crs_cs_left α z hz, crs_cs_right β z hz]
      constructor
      · exact mul_nonneg
          (Real.sin_nonneg_of_nonneg_of_le_pi (by linarith [harg.1]) (by linarith [harg.2, hℓ]))
          (le_of_lt hrpos)
      · exact mul_nonneg
          (Real.sin_nonneg_of_nonneg_of_le_pi (by linarith [harg.2]) (by linarith [harg.1, hℓ]))
          (le_of_lt hrpos)
    · constructor
      · rw [htz]
        simp only [crs_apply, cs_re, cs_im, Complex.smul_re, Complex.smul_im, smul_eq_mul]
        ring_nf
        simp
      · rw [htz]
        simp only [crs_apply, cs_re, cs_im, Complex.smul_re, Complex.smul_im, smul_eq_mul]
        have hsin : 0 ≤ Real.sin (β - α) :=
          Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) hℓ
        have he : t * Real.cos α * Real.sin β - t * Real.sin α * Real.cos β
            = t * Real.sin (β - α) := by
          rw [Real.sin_sub]; ring
        rw [he]; exact mul_nonneg ht0 hsin

end

end Work.FIArea3.JointCount
