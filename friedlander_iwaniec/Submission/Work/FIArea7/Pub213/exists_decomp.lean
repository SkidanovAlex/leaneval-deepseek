/-
# `Work.FIArea7.Pub213.exists_decomp` — the paper's "arrangement" of a Gaussian integer

*FI* p. 1027: every nonzero Gaussian integer `z` can be written `z = c · z'` with `c` in the
monoid `C` generated by the units, `1+i` and the odd natural numbers, and `z'` primary and
primitive (`Prop213Aux.IsC`, `Prop213Aux.IsPP`).

The proof peels the `(1+i)`-adic part (a step of strong induction on the norm, using
`onePlusI_dvd_iff_even_norm`: `1+i ∣ z ↔ Even z.norm`) and, in the odd-norm case, takes the
content `d = gcd (z.re) (z.im)` out (it is an odd integer, hence in `C`) leaving a primitive
`w0`, whose primary associate `z'` is again primitive.
-/
import Mathlib
import Submission.Work.FIArea7.Prop213Aux.Defs

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false

set_option autoImplicit false

open Zsqrtd

namespace Work.FIArea7.Pub213

/-! ## 1. Elementary coordinate computations -/

/-- `(d : ℤ[i]) · ⟨p,q⟩ = ⟨d·p, d·q⟩`. -/
lemma natCast_mul_mk (d : ℕ) (p q : ℤ) :
    (d : GaussianInt) * (⟨p, q⟩ : GaussianInt) = ⟨(d : ℤ) * p, (d : ℤ) * q⟩ := by
  apply Zsqrtd.ext <;> simp

/-- The norm of the integer `d`, viewed in `ℤ[i]`. -/
lemma natCast_norm (d : ℕ) : (d : GaussianInt).norm = (d : ℤ) ^ 2 := by
  rw [Zsqrtd.norm_def]; simp; ring

/-- `(1+i)·(p + qi) = (p-q) + (p+q)i`. -/
lemma onePlusI_mul_mk (p q : ℤ) :
    Prop213Aux.onePlusI * (⟨p, q⟩ : GaussianInt) = ⟨p - q, p + q⟩ := by
  apply Zsqrtd.ext
  · simp [Prop213Aux.onePlusI, Zsqrtd.re_mul]; ring
  · simp [Prop213Aux.onePlusI, Zsqrtd.im_mul]; ring

/-! ## 2. `IsCoprime` of the parts is invariant under multiplication by a unit -/

lemma isCoprime_neg_neg_iff (a b : ℤ) : IsCoprime (-a) (-b) ↔ IsCoprime a b := by
  rw [Int.isCoprime_iff_gcd_eq_one, Int.isCoprime_iff_gcd_eq_one]
  have h : (-a).gcd (-b) = a.gcd b := by
    rw [Int.gcd_eq_natAbs, Int.gcd_eq_natAbs, Int.natAbs_neg, Int.natAbs_neg]
  rw [h]

lemma isCoprime_neg_swap_iff (a b : ℤ) : IsCoprime (-b) a ↔ IsCoprime a b := by
  rw [Int.isCoprime_iff_gcd_eq_one, Int.isCoprime_iff_gcd_eq_one]
  have h : (-b).gcd a = a.gcd b := by
    rw [Int.gcd_eq_natAbs, Int.gcd_eq_natAbs, Int.natAbs_neg, Nat.gcd_comm]
  rw [h]

lemma isCoprime_swap_neg_iff (a b : ℤ) : IsCoprime b (-a) ↔ IsCoprime a b := by
  rw [Int.isCoprime_iff_gcd_eq_one, Int.isCoprime_iff_gcd_eq_one]
  have h : b.gcd (-a) = a.gcd b := by
    rw [Int.gcd_eq_natAbs, Int.gcd_eq_natAbs, Int.natAbs_neg, Nat.gcd_comm]
  rw [h]

lemma re_mul_I (z : GaussianInt) : (z * (⟨0, 1⟩ : GaussianInt)).re = -z.im := by
  simp [Zsqrtd.re_mul]
lemma im_mul_I (z : GaussianInt) : (z * (⟨0, 1⟩ : GaussianInt)).im = z.re := by
  simp [Zsqrtd.im_mul]
lemma re_mul_negI (z : GaussianInt) : (z * (⟨0, -1⟩ : GaussianInt)).re = z.im := by
  simp [Zsqrtd.re_mul]
lemma im_mul_negI (z : GaussianInt) : (z * (⟨0, -1⟩ : GaussianInt)).im = -z.re := by
  simp [Zsqrtd.im_mul]

/-- Multiplying by a unit does not change whether the real and imaginary parts are coprime. -/
lemma isCoprime_mul_unit_iff (z : GaussianInt) (u : GaussianIntˣ) :
    IsCoprime (z * (u : GaussianInt)).re (z * (u : GaussianInt)).im ↔
      IsCoprime z.re z.im := by
  have hu : (u : GaussianInt) = 1 ∨ (u : GaussianInt) = -1 ∨
      (u : GaussianInt) = (⟨0, 1⟩ : GaussianInt) ∨
      (u : GaussianInt) = (⟨0, -1⟩ : GaussianInt) := by
    have := u.isUnit
    rwa [Commons.NumberTheory.GaussianInt.units_classification] at this
  rcases hu with h | h | h | h
  · rw [h]; simp
  · rw [h, show z * (-1 : GaussianInt) = -z by ring]
    simp only [Zsqrtd.re_neg, Zsqrtd.im_neg]
    exact isCoprime_neg_neg_iff z.re z.im
  · rw [h]; simp only [re_mul_I, im_mul_I]
    exact isCoprime_neg_swap_iff z.re z.im
  · rw [h]; simp only [re_mul_negI, im_mul_negI]
    exact isCoprime_swap_neg_iff z.re z.im

/-! ## 3. `1+i` divides `z` exactly when the norm is even -/

lemma onePlusI_dvd_iff_even_norm (z : GaussianInt) :
    Prop213Aux.onePlusI ∣ z ↔ Even z.norm := by
  constructor
  · rintro ⟨z1, rfl⟩
    rw [Zsqrtd.norm_mul, show Prop213Aux.onePlusI.norm = 2 by decide]
    exact ⟨z1.norm, by ring⟩
  · intro he
    -- `re` and `im` have the same parity
    have hnorm : z.norm = z.re ^ 2 + z.im ^ 2 := by rw [Zsqrtd.norm_def]; ring
    have hre : Even (z.re ^ 2) ↔ Even z.re := by simp [Int.even_pow]
    have him : Even (z.im ^ 2) ↔ Even z.im := by simp [Int.even_pow]
    have hpar : Even z.re ↔ Even z.im := by
      have h := Int.even_add.mp (hnorm ▸ he)
      rwa [hre, him] at h
    have hsum : Even (z.re + z.im) := Int.even_add.mpr hpar
    have hdiff : Even (z.im - z.re) := Int.even_sub.mpr hpar.symm
    obtain ⟨p, hp⟩ := hsum
    obtain ⟨q, hq⟩ := hdiff
    have hpr : z.re = p - q := by omega
    have hpi : z.im = p + q := by omega
    refine ⟨⟨p, q⟩, ?_⟩
    rw [onePlusI_mul_mk]
    exact Zsqrtd.ext hpr hpi

/-! ## 4. Taking out the odd content of an odd-norm element -/

lemma exists_content_decomp (w : GaussianInt) (hw : w ≠ 0) (hodd : Odd w.norm.natAbs) :
    ∃ d : ℕ, Odd d ∧ ∃ w0 : GaussianInt, w = (d : GaussianInt) * w0 ∧
      IsCoprime w0.re w0.im ∧ Odd w0.norm.natAbs := by
  have hoddnorm : Odd w.norm := Int.natAbs_odd.mp hodd
  have hnot : ¬ Even w.norm := Int.not_even_iff_odd.mpr hoddnorm
  let d : ℕ := w.re.gcd w.im
  have hdvdre : (d : ℤ) ∣ w.re := Int.gcd_dvd_left w.re w.im
  have hdvdim : (d : ℤ) ∣ w.im := Int.gcd_dvd_right w.re w.im
  have hdne : d ≠ 0 := by
    intro h
    have h' : w.re = 0 ∧ w.im = 0 := Int.gcd_eq_zero_iff.mp h
    exact hw (Zsqrtd.ext h'.1 h'.2)
  have hdneZ : (d : ℤ) ≠ 0 := by exact_mod_cast hdne
  -- the content is odd
  have hdodd : Odd d := by
    rw [← Nat.not_even_iff_odd]
    intro hde
    apply hnot
    rw [even_iff_two_dvd]
    have h2d : (2 : ℤ) ∣ (d : ℤ) := by
      obtain ⟨k, hk⟩ := hde
      exact ⟨(k : ℤ), by rw [hk]; push_cast; ring⟩
    have h2re2 : (2 : ℤ) ∣ w.re ^ 2 := by
      rw [pow_two]; exact dvd_mul_of_dvd_left (dvd_trans h2d hdvdre) w.re
    have h2im2 : (2 : ℤ) ∣ w.im ^ 2 := by
      rw [pow_two]; exact dvd_mul_of_dvd_left (dvd_trans h2d hdvdim) w.im
    rw [show w.norm = w.re ^ 2 + w.im ^ 2 by rw [Zsqrtd.norm_def]; ring]
    exact dvd_add h2re2 h2im2
  let w0 : GaussianInt := ⟨w.re / (d : ℤ), w.im / (d : ℤ)⟩
  have hw0eq : w = (d : GaussianInt) * w0 := by
    rw [natCast_mul_mk]
    apply Zsqrtd.ext
    · exact (Int.mul_ediv_cancel' hdvdre).symm
    · exact (Int.mul_ediv_cancel' hdvdim).symm
  -- `w0` is primitive: Bézout on the gcd
  have hcop : IsCoprime w0.re w0.im := by
    obtain ⟨x, hxw⟩ := hdvdre
    obtain ⟨y, hyw⟩ := hdvdim
    have hxd : w.re / (d : ℤ) = x :=
      Int.ediv_eq_of_eq_mul_left hdneZ (by rw [hxw]; ring)
    have hyd : w.im / (d : ℤ) = y :=
      Int.ediv_eq_of_eq_mul_left hdneZ (by rw [hyw]; ring)
    set A : ℤ := w.re.gcdA w.im with hA
    set B : ℤ := w.re.gcdB w.im with hB
    have hbez : w.re * A + w.im * B = (d : ℤ) := by
      rw [hA, hB]; exact (Int.gcd_eq_gcd_ab w.re w.im).symm
    have key : (d : ℤ) * (A * x + B * y) = (d : ℤ) := by
      calc (d : ℤ) * (A * x + B * y) = w.re * A + w.im * B := by rw [hxw, hyw]; ring
        _ = (d : ℤ) := hbez
    refine ⟨A, B, ?_⟩
    show A * (w.re / (d : ℤ)) + B * (w.im / (d : ℤ)) = 1
    rw [hxd, hyd]
    have key2 : (d : ℤ) * (A * x + B * y) = (d : ℤ) * 1 := by rw [mul_one]; exact key
    exact mul_left_cancel₀ hdneZ key2
  -- and its norm is odd
  have hodd0 : Odd w0.norm.natAbs := by
    have hnormmul : ((d : ℤ) ^ 2) * w0.norm = w.norm := by
      rw [hw0eq, Zsqrtd.norm_mul, natCast_norm]
    have hd2odd : Odd (((d : ℤ) ^ 2)).natAbs := by
      rw [Int.natAbs_pow, Int.natAbs_natCast]
      exact hdodd.pow
    have hprod : (((d : ℤ) ^ 2) * w0.norm).natAbs = (((d : ℤ) ^ 2)).natAbs * w0.norm.natAbs :=
      Int.natAbs_mul _ _
    have : Odd ((((d : ℤ) ^ 2)).natAbs * w0.norm.natAbs) := by
      rw [← hprod, hnormmul]; exact hodd
    exact (Nat.odd_mul.mp this).2
  exact ⟨d, hdodd, w0, hw0eq, hcop, hodd0⟩

/-! ## 5. The primary associate of a primitive element is primary and primitive -/

lemma exists_pp_associate (w : GaussianInt) (hodd : Odd w.norm.natAbs)
    (hc : IsCoprime w.re w.im) :
    ∃ z' : GaussianInt, Prop213Aux.IsPP z' ∧ Associated z' w := by
  have hw : w ≠ 0 := by
    intro h; subst h; simp at hodd
  obtain ⟨z', hz'main, -⟩ :=
    Commons.NumberTheory.GaussianInt.primary_associate_exists_unique hw hodd
  obtain ⟨hzassoc, hzre, hzim, hzc⟩ := hz'main
  refine ⟨z', ⟨⟨hzre, hzim, ?_⟩, ?_⟩, hzassoc⟩
  · refine (ZMod.intCast_eq_intCast_iff z'.im (z'.re - 1) 4).mp ?_
    push_cast
    exact hzc
  · obtain ⟨u, hu⟩ := hzassoc
    have : IsCoprime (z' * (u : GaussianInt)).re (z' * (u : GaussianInt)).im := by
      rw [hu]; exact hc
    exact (isCoprime_mul_unit_iff z' u).mp this

/-! ## 6. The odd-norm case -/

lemma exists_decomp_odd (w : GaussianInt) (hw : w ≠ 0) (hodd : Odd w.norm.natAbs) :
    ∃ c : GaussianInt, Prop213Aux.IsC c ∧
      ∃ z' : GaussianInt, Prop213Aux.IsPP z' ∧ c * z' = w := by
  obtain ⟨d, hdodd, w0, hw_eq, hcop, hodd0⟩ := exists_content_decomp w hw hodd
  obtain ⟨z', hz'pp, hassoc⟩ := exists_pp_associate w0 hodd0 hcop
  obtain ⟨u, hu⟩ := hassoc
  refine ⟨(u : GaussianInt) * (d : GaussianInt), ?_, z', hz'pp, ?_⟩
  · exact ⟨(u : GaussianInt), u.isUnit, 0, d, hdodd, by simp⟩
  · rw [hw_eq, ← hu]; ring

/-! ## 7. The arrangement -/

theorem exists_decomp (z : GaussianInt) (hz : z ≠ 0) :
    ∃ c : GaussianInt, Prop213Aux.IsC c ∧
      ∃ z' : GaussianInt, Prop213Aux.IsPP z' ∧ c * z' = z := by
  classical
  suffices h : ∀ n, ∀ z : GaussianInt, z.norm.natAbs = n → z ≠ 0 →
      ∃ c : GaussianInt, Prop213Aux.IsC c ∧
        ∃ z' : GaussianInt, Prop213Aux.IsPP z' ∧ c * z' = z by
    exact h z.norm.natAbs z rfl hz
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro z hzn hz
    by_cases h2 : Prop213Aux.onePlusI ∣ z
    · -- peel one factor of `1+i`, recurse on the smaller norm
      obtain ⟨z1, rfl⟩ := h2
      have hz1 : z1 ≠ 0 := by
        intro h
        exact hz (by rw [h, mul_zero])
      have hlt : z1.norm.natAbs < n := by
        rw [← hzn, Zsqrtd.norm_mul, Int.natAbs_mul,
          show Prop213Aux.onePlusI.norm.natAbs = 2 by decide]
        have hpos : 0 < z1.norm.natAbs :=
          Nat.pos_of_ne_zero (fun h => hz1 (GaussianInt.norm_eq_zero.mp (Int.natAbs_eq_zero.mp h)))
        omega
      obtain ⟨c1, hc1, z1', hz1'pp, heq⟩ := ih z1.norm.natAbs hlt z1 rfl hz1
      exact ⟨Prop213Aux.onePlusI * c1, Prop213Aux.isC_mul Prop213Aux.isC_onePlusI hc1,
        z1', hz1'pp, by rw [mul_assoc, heq]⟩
    · -- odd norm: content times primary primitive
      have hodd : Odd z.norm.natAbs :=
        Int.natAbs_odd.mpr (Int.not_even_iff_odd.mp
          (fun he => h2 ((onePlusI_dvd_iff_even_norm z).mpr he)))
      exact exists_decomp_odd z hz hodd

end Work.FIArea7.Pub213
