import Mathlib

namespace Work.FIArea7

theorem expSlack172 {η ν δ ρ1 ρ2 ρ3 : ℝ} (hη0 : 0 ≤ η) (hη1 : η ≤ 1) (hδ0 : 0 ≤ δ)
    (hδ1 : δ ≤ 1) (h1 : ρ1 + 2 * η ≤ 1 - ν) (h2 : ρ2 + η ≤ 1 - ν) (h3 : ρ3 + η ≤ 1 - ν) :
    (2 * δ + δ * δ / 4 + (η * (2 + δ / 4) + ρ1) ≤ 1 - ν + 4 * δ) ∧
    (2 * δ + δ * δ / 4 + (η * (1 + δ / 4) + ρ2) ≤ 1 - ν + 4 * δ) ∧
    (2 * δ + δ * δ / 4 + (η * (1 + δ / 4) + ρ3) ≤ 1 - ν + 4 * δ) := by
  refine ⟨?_, ?_, ?_⟩ <;> nlinarith [hη0, hη1, hδ0, hδ1, h1, h2, h3]

end Work.FIArea7
