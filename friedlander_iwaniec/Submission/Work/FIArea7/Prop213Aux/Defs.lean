/-
# `Work.FIArea7.Prop213Aux` — the vocabulary of the direct route to *FI* (21.10)

This file fixes the objects used in the proof of `Work.FIArea7.Prop213` (*FI* Proposition 21.3,
(21.10)) along the paper's own route (pp. 1026–1027), i.e. **without** the mean-square input
`Work.FIArea7.MeanSquareBound`:

* `IsPP z` — `z` is *primary and primitive*: `Work.FIPlan.IsPrimary z ∧ IsCoprime z.re z.im`;
* `onePlusI` — the element `1 + i` of `ℤ[i]`;
* `IsC c` — `c` lies in the multiplicative monoid generated by the units, `1+i`, and the odd
  natural numbers: `c = u · (1+i)^b · n` with `u` a unit and `n` odd.

The paper's "arrangement" (p. 1027) is the statement that every nonzero Gaussian integer `z`
can be written **uniquely** as `z = c · z*` with `IsC c` and `IsPP z*`
(`exists_decomp` / `unique_decomp`); the sums over `c` then converge because
`∑_{c ∈ C} |c|^{-11/6} = 4·(∑_b 2^{-11b/12})(∑_{n odd} n^{-11/6}) < ∞`
(`sum_IsC_le`).
-/
import Mathlib
import Submission.Work.FIArea7.Classical172Defs
import Submission.Work.FIArea7.FIsymbols
import Submission.Work.FIArea7.dirichletSym_mul
import Submission.Work.FIArea7.DirichletReciprocity
import Submission.Commons.NumberTheory.GaussianInt.primary_associate_exists_unique
import Submission.Commons.NumberTheory.GaussianInt.units_classification

set_option autoImplicit false

namespace Work.FIArea7

open Finset
open scoped BigOperators

attribute [local instance] Classical.propDecidable

noncomputable section

namespace Prop213Aux

/-- `1 + i` in `ℤ[i]`. -/
def onePlusI : GaussianInt := 1 + ⟨0, 1⟩

@[simp] lemma onePlusI_re : onePlusI.re = 1 := rfl
@[simp] lemma onePlusI_im : onePlusI.im = 1 := rfl

/-- `c = u · (1+i)^b · n` with `u` a unit and `n` an odd natural number. -/
def IsC (c : GaussianInt) : Prop :=
  ∃ u : GaussianInt, IsUnit u ∧ ∃ b n : ℕ, Odd n ∧ c = u * onePlusI ^ b * (n : GaussianInt)

/-- Primary and primitive. -/
def IsPP (z : GaussianInt) : Prop := Work.FIPlan.IsPrimary z ∧ IsCoprime z.re z.im

lemma isPP_iff (z : GaussianInt) :
    IsPP z ↔ Work.FIPlan.IsPrimary z ∧ IsCoprime z.re z.im := Iff.rfl

lemma IsPP.primary {z : GaussianInt} (h : IsPP z) : Work.FIPlan.IsPrimary z := h.1

lemma IsPP.coprime {z : GaussianInt} (h : IsPP z) : IsCoprime z.re z.im := h.2

lemma IsPP.ne_zero {z : GaussianInt} (h : IsPP z) : z ≠ 0 := by
  obtain ⟨hodd, -, -⟩ := h.1
  intro hz
  rw [hz] at hodd
  exact absurd hodd (by decide)

lemma IsPP.gnorm_pos {z : GaussianInt} (h : IsPP z) : 0 < Work.FIPlan.gnorm z :=
  Work.FIArea7.gnorm_pos_of_ne_zero h.ne_zero

/-- The norm of `1+i` is `2`. -/
lemma gnorm_onePlusI : Work.FIPlan.gnorm onePlusI = 2 := by
  simp [Work.FIPlan.gnorm, onePlusI, Zsqrtd.norm_def]

/-- `1` is in `C`. -/
lemma isC_one : IsC 1 := by
  refine ⟨1, isUnit_one, 0, 1, ⟨0, by ring⟩, ?_⟩
  simp

/-- Units are in `C`. -/
lemma isC_of_isUnit {c : GaussianInt} (h : IsUnit c) : IsC c :=
  ⟨c, h, 0, 1, ⟨0, by ring⟩, by simp⟩

/-- `C` is closed under multiplication. -/
lemma isC_mul {c c' : GaussianInt} (h : IsC c) (h' : IsC c') : IsC (c * c') := by
  obtain ⟨u, hu, b, n, hn, rfl⟩ := h
  obtain ⟨u', hu', b', n', hn', rfl⟩ := h'
  refine ⟨u * u', hu.mul hu', b + b', n * n', hn.mul hn', ?_⟩
  push_cast
  ring

/-- `1+i` is in `C`. -/
lemma isC_onePlusI : IsC onePlusI := by
  refine ⟨1, isUnit_one, 1, 1, ⟨0, by ring⟩, ?_⟩
  simp

/-- `2 = -i (1+i)^2` is in `C`. -/
lemma isC_two : IsC (2 : GaussianInt) := by
  refine ⟨(⟨0, -1⟩ : GaussianInt), ?_, 2, 1, ⟨0, by ring⟩, ?_⟩
  · rw [← Zsqrtd.norm_eq_one_iff (x := (⟨0, -1⟩ : GaussianInt))]
    decide
  · decide

lemma gnorm_natCast (n : ℕ) : Work.FIPlan.gnorm (n : GaussianInt) = n ^ 2 := by
  apply Nat.cast_injective (R := ℤ)
  rw [Work.FIArea7.norm_eq]
  simp only [Zsqrtd.re_natCast, Zsqrtd.im_natCast]
  push_cast
  ring

lemma gnorm_eq_one_of_isUnit {u : GaussianInt} (hu : IsUnit u) : Work.FIPlan.gnorm u = 1 :=
  Zsqrtd.norm_eq_one_iff.mpr hu

lemma gnorm_onePlusI_pow (b : ℕ) : Work.FIPlan.gnorm (onePlusI ^ b) = 2 ^ b := by
  induction b with
  | zero => decide
  | succ b ih => rw [pow_succ, Work.FIArea7.gnorm_mul, ih, gnorm_onePlusI, pow_succ]

lemma gnorm_param {u : GaussianInt} (hu : IsUnit u) (b n : ℕ) :
    Work.FIPlan.gnorm (u * onePlusI ^ b * (n : GaussianInt)) = 2 ^ b * n ^ 2 := by
  rw [Work.FIArea7.gnorm_mul, Work.FIArea7.gnorm_mul, gnorm_eq_one_of_isUnit hu,
    gnorm_onePlusI_pow, gnorm_natCast]
  ring

/-- Cancellation on the right, proved through the norm (no `NoZeroDivisors` for `ℤ[i]` needed). -/
lemma eq_of_mul_eq_mul_right {a b X : GaussianInt} (hX : X ≠ 0) (h : a * X = b * X) : a = b := by
  have h0 : (a - b) * X = 0 := by rw [sub_mul, h, sub_self]
  have hg : Work.FIPlan.gnorm ((a - b) * X) = 0 := by rw [h0]; simp [Work.FIPlan.gnorm]
  rw [Work.FIArea7.gnorm_mul] at hg
  have hXg : Work.FIPlan.gnorm X ≠ 0 := fun hh => hX (Work.FIArea7.gnorm_eq_zero_iff.mp hh)
  have hzero : Work.FIPlan.gnorm (a - b) = 0 := by
    rcases Nat.mul_eq_zero.mp hg with h' | h'
    · exact h'
    · exact absurd h' hXg
  exact sub_eq_zero.mp (Work.FIArea7.gnorm_eq_zero_iff.mp hzero)

/-- If `2^b n² = 2^b' n'²` with `n, n'` odd then `b = b'` and `n = n'`. -/
lemma pow_two_mul_odd_inj {b b' n n' : ℕ} (hn : Odd n) (hn' : Odd n')
    (h : 2 ^ b * n ^ 2 = 2 ^ b' * n' ^ 2) : b = b' ∧ n = n' := by
  have hodd : Odd (n ^ 2) := by rw [pow_two]; exact hn.mul hn
  have hodd' : Odd (n' ^ 2) := by rw [pow_two]; exact hn'.mul hn'
  suffices hb : b = b' by
    subst hb
    have hn2 : n ^ 2 = n' ^ 2 := Nat.mul_left_cancel (by positivity : 0 < 2 ^ b) h
    exact ⟨rfl, Nat.mul_self_inj.mp (by rwa [pow_two, pow_two] at hn2)⟩
  rcases le_total b b' with hle | hle
  · by_contra hne
    have h1 : 2 ^ (b' - b) * n' ^ 2 = n ^ 2 := by
      have h2 : 2 ^ b * (2 ^ (b' - b) * n' ^ 2) = 2 ^ b * n ^ 2 := by
        rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle, h]
      exact Nat.mul_left_cancel (by positivity : 0 < 2 ^ b) h2
    have hev : Even (n ^ 2) := by
      obtain ⟨k, hk⟩ : ∃ k, 2 ^ (b' - b) = 2 * k :=
        ⟨2 ^ (b' - b - 1), by rw [← pow_succ']; congr 1; omega⟩
      exact ⟨k * n' ^ 2, by rw [← h1, hk]; ring⟩
    obtain ⟨i, hi⟩ := hev
    obtain ⟨j, hj⟩ := hodd
    omega
  · by_contra hne
    have h1 : 2 ^ (b - b') * n ^ 2 = n' ^ 2 := by
      have h2 : 2 ^ b' * (2 ^ (b - b') * n ^ 2) = 2 ^ b' * n' ^ 2 := by
        rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle, ← h]
      exact Nat.mul_left_cancel (by positivity : 0 < 2 ^ b') h2
    have hev : Even (n' ^ 2) := by
      obtain ⟨k, hk⟩ : ∃ k, 2 ^ (b - b') = 2 * k :=
        ⟨2 ^ (b - b' - 1), by rw [← pow_succ']; congr 1; omega⟩
      exact ⟨k * n ^ 2, by rw [← h1, hk]; ring⟩
    obtain ⟨i, hi⟩ := hev
    obtain ⟨j, hj⟩ := hodd'
    omega

/-- The parametrisation `(u,b,n) ↦ u (1+i)^b n` is injective on units and odd `n`. -/
lemma param_inj {u u' : GaussianInt} (hu : IsUnit u) (hu' : IsUnit u')
    {b b' n n' : ℕ} (hn : Odd n) (hn' : Odd n')
    (h : u * onePlusI ^ b * (n : GaussianInt) = u' * onePlusI ^ b' * (n' : GaussianInt)) :
    u = u' ∧ b = b' ∧ n = n' := by
  have hnrm : 2 ^ b * n ^ 2 = 2 ^ b' * n' ^ 2 := by
    have hc := congrArg Work.FIPlan.gnorm h
    rwa [gnorm_param hu b n, gnorm_param hu' b' n'] at hc
  obtain ⟨hb, hnn⟩ := pow_two_mul_odd_inj hn hn' hnrm
  subst hb; subst hnn
  refine ⟨?_, rfl, rfl⟩
  rw [mul_assoc, mul_assoc] at h
  refine eq_of_mul_eq_mul_right ?_ h
  have hX : Work.FIPlan.gnorm (onePlusI ^ b * (n : GaussianInt)) = 2 ^ b * n ^ 2 := by
    rw [Work.FIArea7.gnorm_mul, gnorm_onePlusI_pow, gnorm_natCast]
  have hn1 : 1 ≤ n := by obtain ⟨k, hk⟩ := hn; omega
  intro hzero
  rw [hzero] at hX
  have h1 : Work.FIPlan.gnorm (0 : GaussianInt) = 0 := by simp [Work.FIPlan.gnorm]
  rw [h1] at hX
  have h2 : 0 < 2 ^ b * n ^ 2 := by positivity
  omega

/-- The units of `ℤ[i]`. -/
def unitSet : Finset GaussianInt := {1, -1, (⟨0, 1⟩ : GaussianInt), ⟨0, -1⟩}

lemma unitSet_card : unitSet.card = 4 := by decide

lemma isUnit_of_mem_unitSet {u : GaussianInt} (hu : u ∈ unitSet) : IsUnit u := by
  simp only [unitSet, Finset.mem_insert, Finset.mem_singleton] at hu
  rcases hu with h | h | h | h
  · rw [h]; exact isUnit_one
  · rw [h]; exact isUnit_neg_one
  · rw [h]; exact Commons.NumberTheory.GaussianInt.isUnit_sqrtd
  · rw [h]; exact Commons.NumberTheory.GaussianInt.isUnit_neg_sqrtd

lemma mem_unitSet_of_isUnit {u : GaussianInt} (hu : IsUnit u) : u ∈ unitSet := by
  rcases Commons.NumberTheory.GaussianInt.units_classification u |>.mp hu with h | h | h | h <;>
    simp [unitSet, h]


/-- Left-cancellation, through the norm (no `NoZeroDivisors` for `ℤ[i]` needed). -/
lemma eq_of_mul_eq_mul_left {a b X : GaussianInt} (hX : X ≠ 0) (h : X * a = X * b) : a = b := by
  have h0 : X * (a - b) = 0 := by rw [mul_sub, h, sub_self]
  have hg : Work.FIPlan.gnorm (X * (a - b)) = 0 := by rw [h0]; simp [Work.FIPlan.gnorm]
  rw [Work.FIArea7.gnorm_mul] at hg
  have hXg : Work.FIPlan.gnorm X ≠ 0 := fun hh => hX (Work.FIArea7.gnorm_eq_zero_iff.mp hh)
  have hzero : Work.FIPlan.gnorm (a - b) = 0 := by
    rcases Nat.mul_eq_zero.mp hg with h' | h'
    · exact absurd h' hXg
    · exact h'
  exact sub_eq_zero.mp (Work.FIArea7.gnorm_eq_zero_iff.mp hzero)

/-- If `2^b A = 2^b' A'` with `A, A'` odd then `b = b'` and `A = A'`. -/
lemma pow_two_mul_odd_inj_gen {b b' A A' : ℕ} (hA : Odd A) (hA' : Odd A')
    (h : 2 ^ b * A = 2 ^ b' * A') : b = b' ∧ A = A' := by
  have hb : b = b' := by
    rcases le_total b b' with hle | hle
    · by_contra hne
      have h1 : 2 ^ (b' - b) * A' = A := by
        have h2 : 2 ^ b * (2 ^ (b' - b) * A') = 2 ^ b * A := by
          rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle, h]
        exact Nat.mul_left_cancel (by positivity : 0 < 2 ^ b) h2
      have hev : Even A := by
        obtain ⟨k, hk⟩ : ∃ k, 2 ^ (b' - b) = 2 * k :=
          ⟨2 ^ (b' - b - 1), by rw [← pow_succ']; congr 1; omega⟩
        exact ⟨k * A', by rw [← h1, hk]; ring⟩
      obtain ⟨i, hi⟩ := hev
      obtain ⟨j, hj⟩ := hA
      omega
    · by_contra hne
      have h1 : 2 ^ (b - b') * A = A' := by
        have h2 : 2 ^ b' * (2 ^ (b - b') * A) = 2 ^ b' * A' := by
          rw [← mul_assoc, ← pow_add, Nat.add_sub_cancel' hle, ← h]
        exact Nat.mul_left_cancel (by positivity : 0 < 2 ^ b') h2
      have hev : Even A' := by
        obtain ⟨k, hk⟩ : ∃ k, 2 ^ (b - b') = 2 * k :=
          ⟨2 ^ (b - b' - 1), by rw [← pow_succ']; congr 1; omega⟩
        exact ⟨k * A, by rw [← h1, hk]; ring⟩
      obtain ⟨i, hi⟩ := hev
      obtain ⟨j, hj⟩ := hA'
      omega
  subst hb
  exact ⟨rfl, Nat.mul_left_cancel (by positivity : 0 < 2 ^ b) h⟩

/-- The norm of a primary element is odd. -/
lemma IsPP.odd_gnorm {z : GaussianInt} (h : IsPP z) : Odd (Work.FIPlan.gnorm z) := by
  obtain ⟨hre, him, -⟩ := h.1
  have h1 : Odd (z.re ^ 2 + z.im ^ 2) := by
    have h2 : Odd (z.re ^ 2) := hre.pow
    have h3 : Even (z.im ^ 2) := by
      obtain ⟨k, hk⟩ := him
      exact ⟨2 * k * k, by rw [hk]; ring⟩
    exact h2.add_even h3
  rw [Work.FIArea7.gnorm_eq_natAbs]
  exact Int.natAbs_odd.mpr h1

end Prop213Aux

end

end Work.FIArea7
