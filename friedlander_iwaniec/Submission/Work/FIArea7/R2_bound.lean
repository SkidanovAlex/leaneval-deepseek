import Mathlib
import Submission.Work.FIArea7.lattice_sum_bound
import Submission.Work.FIArea7.card_filter_mul_le

/-!
# Bound on the number of Pythagorean triples with bounded legs

`R2_bound` bounds the number of triples `(a,b,c)` with `|a|,|b| ≤ N`, `1 ≤ c ≤ N`
and `a^2 + b^2 = c^2` by `C (N+1) (1 + log (2+N))`.

The proof uses the classification of Pythagorean triples (`PythagoreanTriple.classification`)
to map each triple into a bounded set of integer triples `(k,m,n)`, then counts those
triples by reducing to the lattice sum `∑ 1/(a^2+b^2) = O(log N)`.
-/

namespace Work.FIArea7

open Finset

/-- The set of triples counted in `R2_bound`. -/
noncomputable def SS (N : ℕ) : Finset ((ℤ × ℤ) × ℕ) :=
  (((Finset.Icc (-(N : ℤ)) (N : ℤ)) ×ˢ (Finset.Icc (-(N : ℤ)) (N : ℤ))) ×ˢ
      (Finset.Icc 1 N)).filter
    (fun q : (ℤ × ℤ) × ℕ => q.1.1 ^ 2 + q.1.2 ^ 2 = (q.2 : ℤ) ^ 2)

/-- Candidate parametrising triples `(k,m,n)` (see `gen`). -/
noncomputable def WW (N : ℕ) : Finset ((ℤ × ℤ) × ℤ) :=
  (((Finset.Icc (-(N : ℤ)) (N : ℤ)) ×ˢ (Finset.Icc (-(N : ℤ)) (N : ℤ))) ×ˢ
      (Finset.Icc (-(N : ℤ)) (N : ℤ))).filter
    (fun p : (ℤ × ℤ) × ℤ =>
      p.1.1 ≠ 0 ∧ ¬(p.1.2 = 0 ∧ p.2 = 0) ∧ (|p.1.1|) * (p.1.2 ^ 2 + p.2 ^ 2) ≤ (N : ℤ))

/-- The (at most two) triples generated by a parametrising triple `w = ((k,m),n)`. -/
noncomputable def gen (w : (ℤ × ℤ) × ℤ) : Finset ((ℤ × ℤ) × ℕ) :=
  insert (((w.1.1 * (w.1.2 ^ 2 - w.2 ^ 2), 2 * w.1.1 * w.1.2 * w.2),
            (w.1.1 * (w.1.2 ^ 2 + w.2 ^ 2)).natAbs))
    ({((2 * w.1.1 * w.1.2 * w.2, w.1.1 * (w.1.2 ^ 2 - w.2 ^ 2)),
        (w.1.1 * (w.1.2 ^ 2 + w.2 ^ 2)).natAbs)} : Finset ((ℤ × ℤ) × ℕ))

lemma gen_card_le_two (w : (ℤ × ℤ) × ℤ) : (gen w).card ≤ 2 := by
  unfold gen
  exact (Finset.card_insert_le _ _).trans (by simp)

/-- `|m| ≤ N` when `m^2 ≤ N`. -/
lemma abs_le_of_sq_le {m : ℤ} {N : ℕ} (h : m ^ 2 ≤ (N : ℤ)) : |m| ≤ (N : ℤ) := by
  have h2 : ((m.natAbs : ℤ)) ^ 2 ≤ (N : ℤ) := by rwa [Int.natAbs_sq]
  have h3 : m.natAbs ^ 2 ≤ N := by exact_mod_cast h2
  have hm : |m| = ((m.natAbs : ℕ) : ℤ) := Int.abs_eq_natAbs m
  rw [hm]
  rcases Nat.eq_zero_or_pos m.natAbs with h0 | hpos
  · rw [h0]; simp
  · have h4 : m.natAbs ≤ m.natAbs ^ 2 := by
      simpa [pow_two] using Nat.le_mul_self m.natAbs
    exact_mod_cast (le_trans h4 h3)

/-- Every triple of `SS N` is generated by a triple of `WW N`. -/
lemma SS_subset_gen (N : ℕ) : SS N ⊆ (WW N).biUnion gen := by
  intro s hs
  simp only [SS, Finset.mem_filter] at hs
  obtain ⟨hsI, hsq⟩ := hs
  rcases s with ⟨⟨x, y⟩, c⟩
  simp only [Finset.mem_product, Finset.mem_Icc] at hsI
  obtain ⟨⟨⟨hx1, hx2⟩, hy1, hy2⟩, hc1, hc2⟩ := hsI
  have hP : PythagoreanTriple x y (c : ℤ) := by
    simpa [PythagoreanTriple, sq] using hsq
  obtain ⟨k, m, n, hleg, hz⟩ := PythagoreanTriple.classification.mp hP
  have hk0 : k ≠ 0 := by
    rintro rfl
    rcases hz with h | h
    · simp at h; omega
    · simp at h; omega
  have hmnne : ¬(m = 0 ∧ n = 0) := by
    rintro ⟨rfl, rfl⟩
    rcases hz with h | h
    · simp at h; omega
    · simp at h; omega
  have heq : |k * (m ^ 2 + n ^ 2)| = (c : ℤ) := by
    rcases hz with h | h
    · rw [← h, abs_of_nonneg (by positivity : (0:ℤ) ≤ (c:ℤ))]
    · have h' : (c:ℤ) = -(k*(m^2+n^2)) := by rw [h]; ring
      rw [← abs_neg (k*(m^2+n^2)), ← h', abs_of_nonneg (by positivity : (0:ℤ) ≤ (c:ℤ))]
  have hsum : (|k|) * (m ^ 2 + n ^ 2) = (c : ℤ) := by
    rw [← abs_of_nonneg (by positivity : (0:ℤ) ≤ m^2+n^2), ← abs_mul]
    exact heq
  have hmnpos : (1:ℤ) ≤ m^2 + n^2 := by
    have hpos : (0:ℤ) < m^2 + n^2 := by
      rcases eq_or_ne m 0 with hm | hm
      · rcases eq_or_ne n 0 with hn | hn
        · exact absurd ⟨hm, hn⟩ hmnne
        · have : 0 < n^2 := sq_pos_of_ne_zero hn
          linarith [sq_nonneg m]
      · have : 0 < m^2 := sq_pos_of_ne_zero hm
        linarith [sq_nonneg n]
    omega
  have hk1 : (1:ℤ) ≤ |k| := by have := abs_pos.mpr hk0; omega
  have hkn : |k| ≤ (N:ℤ) := by
    calc |k| = (|k|) * 1 := by ring
      _ ≤ (|k|) * (m^2+n^2) := mul_le_mul_of_nonneg_left hmnpos (abs_nonneg k)
      _ = (c:ℤ) := hsum
      _ ≤ (N:ℤ) := by exact_mod_cast hc2
  have hmn2le : m^2 ≤ (N:ℤ) := by
    have h2 : m^2 + n^2 ≤ (|k|)*(m^2+n^2) := by
      simpa using mul_le_mul_of_nonneg_right hk1 (by positivity : (0:ℤ) ≤ m^2+n^2)
    calc m^2 ≤ m^2 + n^2 := by nlinarith [sq_nonneg n]
      _ ≤ (|k|)*(m^2+n^2) := h2
      _ = (c:ℤ) := hsum
      _ ≤ (N:ℤ) := by exact_mod_cast hc2
  have hnn2le : n^2 ≤ (N:ℤ) := by
    have h2 : m^2 + n^2 ≤ (|k|)*(m^2+n^2) := by
      simpa using mul_le_mul_of_nonneg_right hk1 (by positivity : (0:ℤ) ≤ m^2+n^2)
    calc n^2 ≤ m^2 + n^2 := by nlinarith [sq_nonneg m]
      _ ≤ (|k|)*(m^2+n^2) := h2
      _ = (c:ℤ) := hsum
      _ ≤ (N:ℤ) := by exact_mod_cast hc2
  have hkIcc : k ∈ Finset.Icc (-(N:ℤ)) (N:ℤ) := by rw [Finset.mem_Icc, ← abs_le]; exact hkn
  have hmIcc : m ∈ Finset.Icc (-(N:ℤ)) (N:ℤ) := by rw [Finset.mem_Icc, ← abs_le]; exact abs_le_of_sq_le hmn2le
  have hnIcc : n ∈ Finset.Icc (-(N:ℤ)) (N:ℤ) := by rw [Finset.mem_Icc, ← abs_le]; exact abs_le_of_sq_le hnn2le
  have hcle : (|k|) * (m^2+n^2) ≤ (N:ℤ) := by rw [hsum]; exact_mod_cast hc2
  have hwW : ((k, m), n) ∈ WW N := by
    rw [WW, Finset.mem_filter, Finset.mem_product, Finset.mem_product]
    exact ⟨⟨⟨hkIcc, hmIcc⟩, hnIcc⟩, hk0, hmnne, hcle⟩
  rw [Finset.mem_biUnion]
  refine ⟨((k, m), n), hwW, ?_⟩
  have hcabs : c = (k * (m ^ 2 + n ^ 2)).natAbs := by
    rcases hz with h | h
    · rw [← h]; simp
    · have h' : (c:ℤ) = -(k*(m^2+n^2)) := by rw [h]; ring
      rw [← Int.natAbs_neg, ← h']; simp
  rw [gen, Finset.mem_insert, Finset.mem_singleton]
  rcases hleg with ⟨hx, hy⟩ | ⟨hx, hy⟩
  · left
    rw [Prod.mk.injEq, Prod.mk.injEq]
    exact ⟨⟨hx, by rw [hy]; ring⟩, hcabs⟩
  · right
    rw [Prod.mk.injEq, Prod.mk.injEq]
    exact ⟨⟨by rw [hx]; ring, hy⟩, hcabs⟩

lemma SS_card_le (N : ℕ) : (SS N).card ≤ 2 * (WW N).card := by
  calc (SS N).card ≤ ((WW N).biUnion gen).card := Finset.card_le_card (SS_subset_gen N)
    _ ≤ ∑ w ∈ WW N, (gen w).card := Finset.card_biUnion_le
    _ ≤ ∑ w ∈ WW N, 2 := Finset.sum_le_sum (fun w _ => gen_card_le_two w)
    _ = (WW N).card * 2 := by rw [Finset.sum_const, smul_eq_mul]
    _ = 2 * (WW N).card := Nat.mul_comm _ _

/-- The set of "reduced" parameters `(κ,a,b)` with `κ (a^2+b^2) ≤ N`. -/
noncomputable def PP (N : ℕ) : Finset (ℕ × ℕ) :=
  ((Finset.Icc 0 N) ×ˢ (Finset.Icc 0 N)).filter (fun p => ¬(p.1 = 0 ∧ p.2 = 0))

noncomputable def UU (N : ℕ) : Finset ((ℕ × ℕ) × ℕ) :=
  (PP N).biUnion (fun p => ((Finset.Icc 1 N).filter (fun κ => κ * (p.1 ^ 2 + p.2 ^ 2) ≤ N)).image
    (fun κ => ((κ, p.1), p.2)))

/-- The at most eight sign variants of a reduced parameter. -/
noncomputable def pre (u : (ℕ × ℕ) × ℕ) : Finset ((ℤ × ℤ) × ℤ) :=
  { (((u.1.1 : ℤ), (u.1.2 : ℤ)), (u.2 : ℤ)),
    (((u.1.1 : ℤ), (u.1.2 : ℤ)), -(u.2 : ℤ)),
    (((u.1.1 : ℤ), -(u.1.2 : ℤ)), (u.2 : ℤ)),
    (((u.1.1 : ℤ), -(u.1.2 : ℤ)), -(u.2 : ℤ)),
    ((-(u.1.1 : ℤ), (u.1.2 : ℤ)), (u.2 : ℤ)),
    ((-(u.1.1 : ℤ), (u.1.2 : ℤ)), -(u.2 : ℤ)),
    ((-(u.1.1 : ℤ), -(u.1.2 : ℤ)), (u.2 : ℤ)),
    ((-(u.1.1 : ℤ), -(u.1.2 : ℤ)), -(u.2 : ℤ)) }

lemma card_eight_le {α : Type*} [DecidableEq α] (a b c d e f g h : α) :
    ({a,b,c,d,e,f,g,h} : Finset α).card ≤ 8 := by
  have h1 := Finset.card_insert_le a ({b,c,d,e,f,g,h} : Finset α)
  have h2 := Finset.card_insert_le b ({c,d,e,f,g,h} : Finset α)
  have h3 := Finset.card_insert_le c ({d,e,f,g,h} : Finset α)
  have h4 := Finset.card_insert_le d ({e,f,g,h} : Finset α)
  have h5 := Finset.card_insert_le e ({f,g,h} : Finset α)
  have h6 := Finset.card_insert_le f ({g,h} : Finset α)
  have h7 := Finset.card_insert_le g ({h} : Finset α)
  have h8 : ({h} : Finset α).card = 1 := Finset.card_singleton h
  omega

lemma pre_card_le (u : (ℕ × ℕ) × ℕ) : (pre u).card ≤ 8 := by
  unfold pre
  exact card_eight_le _ _ _ _ _ _ _ _

lemma mem_pre_of_natAbs {u : (ℕ × ℕ) × ℕ} {k m n : ℤ}
    (hk : k.natAbs = u.1.1) (hm : m.natAbs = u.1.2) (hn : n.natAbs = u.2) :
    ((k,m),n) ∈ pre u := by
  have hk' : k = (u.1.1 : ℤ) ∨ k = -(u.1.1 : ℤ) := by
    rcases Int.natAbs_eq k with h | h
    · exact Or.inl (by rw [← hk]; exact h)
    · exact Or.inr (by rw [← hk]; exact h)
  have hm' : m = (u.1.2 : ℤ) ∨ m = -(u.1.2 : ℤ) := by
    rcases Int.natAbs_eq m with h | h
    · exact Or.inl (by rw [← hm]; exact h)
    · exact Or.inr (by rw [← hm]; exact h)
  have hn' : n = (u.2 : ℤ) ∨ n = -(u.2 : ℤ) := by
    rcases Int.natAbs_eq n with h | h
    · exact Or.inl (by rw [← hn]; exact h)
    · exact Or.inr (by rw [← hn]; exact h)
  rcases hk' with h | h <;> rcases hm' with h2 | h2 <;> rcases hn' with h3 | h3 <;>
    (rw [h, h2, h3]; simp [pre])

lemma WW_subset_UU (N : ℕ) : WW N ⊆ (UU N).biUnion pre := by
  intro s hs
  rcases s with ⟨⟨k, m⟩, n⟩
  simp only [WW, Finset.mem_filter, Finset.mem_product, Finset.mem_Icc] at hs
  obtain ⟨⟨⟨hkIcc, hmIcc⟩, hnIcc⟩, hk0, hmnne, hle⟩ := hs
  rw [Finset.mem_biUnion]
  refine ⟨((k.natAbs, m.natAbs), n.natAbs), ?_, ?_⟩
  · rw [UU, Finset.mem_biUnion]
    refine ⟨(m.natAbs, n.natAbs), ?_, ?_⟩
    · have hmN : m.natAbs ≤ N := by
        have h : |m| ≤ (N:ℤ) := abs_le.mpr hmIcc
        rw [Int.abs_eq_natAbs] at h
        exact_mod_cast h
      have hnN : n.natAbs ≤ N := by
        have h : |n| ≤ (N:ℤ) := abs_le.mpr hnIcc
        rw [Int.abs_eq_natAbs] at h
        exact_mod_cast h
      have hmn2 : ¬(m.natAbs = 0 ∧ n.natAbs = 0) := by
        rintro ⟨h1, h2⟩
        exact hmnne ⟨Int.natAbs_eq_zero.mp h1, Int.natAbs_eq_zero.mp h2⟩
      rw [PP, Finset.mem_filter, Finset.mem_product, Finset.mem_Icc, Finset.mem_Icc]
      exact ⟨⟨⟨Nat.zero_le _, hmN⟩, ⟨Nat.zero_le _, hnN⟩⟩, hmn2⟩
    · rw [Finset.mem_image]
      refine ⟨k.natAbs, ?_, rfl⟩
      have hkN : k.natAbs ≤ N := by
        have h : |k| ≤ (N:ℤ) := abs_le.mpr hkIcc
        rw [Int.abs_eq_natAbs] at h
        exact_mod_cast h
      have hk1 : 1 ≤ k.natAbs := by
        rw [Nat.one_le_iff_ne_zero]
        exact fun h => hk0 (Int.natAbs_eq_zero.mp h)
      have hcast : ((k.natAbs * (m.natAbs^2 + n.natAbs^2) : ℕ) : ℤ) = |k| * (m^2 + n^2) := by
        push_cast
        rw [sq_abs m, sq_abs n]
      have hle' : (k.natAbs * (m.natAbs^2 + n.natAbs^2)) ≤ N := by
        have : ((k.natAbs * (m.natAbs^2 + n.natAbs^2) : ℕ) : ℤ) ≤ (N:ℤ) := by
          rw [hcast]; exact hle
        exact_mod_cast this
      rw [Finset.mem_filter, Finset.mem_Icc]
      exact ⟨⟨hk1, hkN⟩, hle'⟩
  · exact mem_pre_of_natAbs rfl rfl rfl

lemma WW_card_le (N : ℕ) : (WW N).card ≤ 8 * (UU N).card := by
  calc (WW N).card ≤ ((UU N).biUnion pre).card := Finset.card_le_card (WW_subset_UU N)
    _ ≤ ∑ u ∈ UU N, (pre u).card := Finset.card_biUnion_le
    _ ≤ ∑ u ∈ UU N, 8 := Finset.sum_le_sum (fun u _ => pre_card_le u)
    _ = (UU N).card * 8 := by rw [Finset.sum_const, smul_eq_mul]
    _ = 8 * (UU N).card := Nat.mul_comm _ _

lemma UU_card_le (N : ℕ) :
    ((UU N).card : ℝ) ≤ ∑ p ∈ PP N, (N : ℝ) / ((p.1 : ℝ) ^ 2 + (p.2 : ℝ) ^ 2) := by
  have h1 : ((UU N).card : ℝ) ≤
      ∑ p ∈ PP N, ((((Finset.Icc 1 N).filter (fun κ => κ * (p.1 ^ 2 + p.2 ^ 2) ≤ N)).image
        (fun κ => ((κ, p.1), p.2))).card : ℝ) := by
    exact_mod_cast Finset.card_biUnion_le
  refine h1.trans ?_
  apply Finset.sum_le_sum
  intro p hp
  simp only [PP, Finset.mem_filter] at hp
  have ht : 1 ≤ p.1 ^ 2 + p.2 ^ 2 := by
    rcases Nat.eq_zero_or_pos (p.1^2 + p.2^2) with h | h
    · exfalso
      apply hp.2
      have h1 : p.1^2 = 0 := by omega
      have h2 : p.2^2 = 0 := by omega
      exact ⟨sq_eq_zero_iff.mp h1, sq_eq_zero_iff.mp h2⟩
    · exact h
  calc ((((Finset.Icc 1 N).filter (fun κ => κ * (p.1 ^ 2 + p.2 ^ 2) ≤ N)).image
          (fun κ => ((κ, p.1), p.2))).card : ℝ)
      ≤ (((Finset.Icc 1 N).filter (fun κ => κ * (p.1 ^ 2 + p.2 ^ 2) ≤ N)).card : ℝ) := by
        exact_mod_cast Finset.card_image_le
    _ ≤ (N : ℝ) / ((p.1 ^ 2 + p.2 ^ 2 : ℕ) : ℝ) := card_filter_mul_le N (p.1^2+p.2^2) ht
    _ = (N : ℝ) / ((p.1 : ℝ) ^ 2 + (p.2 : ℝ) ^ 2) := by push_cast; ring

lemma product_sum_factor (N : ℕ) :
    (∑ p ∈ (Finset.Icc 0 N ×ˢ Finset.Icc 0 N), (N : ℝ) / ((p.1 : ℝ) ^ 2 + (p.2 : ℝ) ^ 2))
    = (N : ℝ) * (∑ a ∈ Finset.Icc 0 N, ∑ b ∈ Finset.Icc 0 N,
        (1:ℝ) / ((a:ℝ)^2 + (b:ℝ)^2)) := by
  rw [Finset.sum_product]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro a ha
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b hb
  ring

theorem R2_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ N : ℕ,
      ((((((Finset.Icc (-(N : ℤ)) (N : ℤ)) ×ˢ (Finset.Icc (-(N : ℤ)) (N : ℤ))) ×ˢ
          (Finset.Icc 1 N)).filter
        (fun q : (ℤ × ℤ) × ℕ => q.1.1 ^ 2 + q.1.2 ^ 2 = (q.2 : ℤ) ^ 2)).card : ℝ))
        ≤ C * ((N : ℝ) + 1) * (1 + Real.log (2 + (N : ℝ))) := by
  change ∃ C : ℝ, 0 < C ∧ ∀ N : ℕ,
      ((SS N).card : ℝ) ≤ C * ((N : ℝ) + 1) * (1 + Real.log (2 + (N : ℝ)))
  obtain ⟨C₀, hC₀pos, hC₀⟩ := lattice_sum_bound
  refine ⟨16 * C₀, mul_pos (by norm_num) hC₀pos, fun N => ?_⟩
  have h1 : ((SS N).card : ℝ) ≤ 2 * ((WW N).card : ℝ) := by exact_mod_cast SS_card_le N
  have h2 : ((WW N).card : ℝ) ≤ 8 * ((UU N).card : ℝ) := by exact_mod_cast WW_card_le N
  have h3 : ((SS N).card : ℝ) ≤ 16 * ((UU N).card : ℝ) := by linarith
  have hlog : (0:ℝ) ≤ 1 + Real.log (2 + (N:ℝ)) := by
    have h2N : (1:ℝ) ≤ 2 + (N:ℝ) := by
      have : (0:ℝ) ≤ (N:ℝ) := Nat.cast_nonneg N
      linarith
    have : (0:ℝ) ≤ Real.log (2 + (N:ℝ)) := Real.log_nonneg h2N
    linarith
  have hC0 : (0:ℝ) ≤ C₀ := le_of_lt hC₀pos
  calc ((SS N).card : ℝ) ≤ 16 * ((UU N).card : ℝ) := h3
    _ ≤ 16 * (∑ p ∈ PP N, (N:ℝ) / ((p.1:ℝ)^2 + (p.2:ℝ)^2)) := by
        exact mul_le_mul_of_nonneg_left (UU_card_le N) (by norm_num)
    _ ≤ 16 * (∑ p ∈ (Finset.Icc 0 N ×ˢ Finset.Icc 0 N),
            (N:ℝ) / ((p.1:ℝ)^2 + (p.2:ℝ)^2)) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        apply Finset.sum_le_sum_of_subset_of_nonneg
        · intro p hp; simp only [PP, Finset.mem_filter] at hp; exact hp.1
        · intro p hp hnp
          exact div_nonneg (Nat.cast_nonneg N) (by positivity)
    _ = 16 * ((N:ℝ) * (∑ a ∈ Finset.Icc 0 N, ∑ b ∈ Finset.Icc 0 N,
            (1:ℝ) / ((a:ℝ)^2+(b:ℝ)^2))) := by
        rw [product_sum_factor]
    _ ≤ 16 * ((N:ℝ) * (C₀ * (1 + Real.log (2 + (N:ℝ))))) := by
        apply mul_le_mul_of_nonneg_left _ (by norm_num)
        exact mul_le_mul_of_nonneg_left (hC₀ N) (Nat.cast_nonneg N)
    _ = 16 * C₀ * ((N:ℝ) * (1 + Real.log (2 + (N:ℝ)))) := by ring
    _ ≤ 16 * C₀ * ((N:ℝ) + 1) * (1 + Real.log (2 + (N:ℝ))) := by
        have hN : (N:ℝ) ≤ (N:ℝ) + 1 := by linarith
        nlinarith [mul_le_mul_of_nonneg_right hN hlog,
                   mul_nonneg (mul_nonneg (by norm_num : (0:ℝ) ≤ 16) hC0) hlog]

end Work.FIArea7
