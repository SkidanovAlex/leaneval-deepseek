/-! ## Auxiliary lemmas -/

/-- The subgroup generated by the `p`-th powers is the range of the `p`-th power map. -/
theorem pPowSubgroup_eq_range_pow (p : ℕ) (G : Type*) [CommGroup G] :
    Work.SSGRoute.EscapeCoreLib.pPowSubgroup p G =
      (MonoidHom.mk' (fun x : G => x ^ p) (fun a b => mul_pow a b p)).range := by
  rw [Work.SSGRoute.EscapeCoreLib.pPowSubgroup]
  apply le_antisymm
  · rw [Subgroup.closure_le]
    rintro _ ⟨g, rfl⟩
    exact ⟨g, rfl⟩
  · rintro _ ⟨g, rfl⟩
    exact Work.SSGRoute.EscapeCoreLib.pow_mem_pPowSubgroup g

/-- `gesUPow` presented as `gesU ⊔ (p-th powers)` with the `p`-th powers as a closure. -/
theorem gesUPow_eq (K : Type*) [Field K] [NumberField K] (p : ℕ)
    (T' : Finset (NK.Chebotarev.PrimeIdeal K)) :
    Work.SSGRoute.SSG8Escape.gesUPow K p T' =
      ((NK.GlobalCFT.Idele.principalSubgroup K ⊔ Work.SSGRoute.powTIdeles K p T').map
        (NK.GlobalCFT.IdeleClassGroup.mk K)) ⊔
        Work.SSGRoute.EscapeCoreLib.pPowSubgroup p (NK.GlobalCFT.IdeleClassGroup K) := by
  unfold Work.SSGRoute.SSG8Escape.gesUPow Work.SSGRoute.GrunwaldEscapeCore.gesU
  rw [← pPowSubgroup_eq_range_pow]

/-- An idèlic Artin map with the exact kernel kills the idèles whose class lies in the norm class
subgroup. -/
theorem art_eq_one_of_mk_mem {K : Type} [Field K] [NumberField K] {M : Type} [Field M]
    [NumberField M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (art : NK.GlobalCFT.Idele K →* (M ≃ₐ[K] M))
    (hker : art.ker = NK.GlobalCFT.Idele.normImage K M ⊔
      NK.GlobalCFT.Idele.principalSubgroup K)
    {y : NK.GlobalCFT.Idele K}
    (hy : IdeleClassGroup.mk K y ∈ Idele.normClassSubgroup K M) : art y = 1 := by
  obtain ⟨w, hw, hwe⟩ := Subgroup.mem_map.mp hy
  have h4 : art w = 1 := by
    rw [← MonoidHom.mem_ker, hker]; exact Subgroup.mem_sup_left hw
  have h2 : w⁻¹ * y ∈ NK.GlobalCFT.Idele.principalSubgroup K := by
    rw [← Work.SSGRoute.ker_mk_eq_principal, MonoidHom.mem_ker, map_mul, map_inv, hwe,
      inv_mul_cancel]
  have h3 : art (w⁻¹ * y) = 1 := by
    rw [← MonoidHom.mem_ker, hker]; exact Subgroup.mem_sup_right h2
  rw [show y = w * (w⁻¹ * y) from by group, map_mul, h4, h3, one_mul]

/-- A vanishing local `p`-th power class means the local component is a `p`-th power. -/
theorem localImageAt_mem_powRange_of_localPowClass_eq_one {K : Type} [Field K] [NumberField K]
    (p : ℕ) (𝔮 : NK.Chebotarev.PrimeIdeal K) (γ : Kˣ)
    (hγ : NK.UchidaKummer.localPowClass K p 𝔮 γ = 1) :
    NK.CFTLib.IdeleHasse.localImageAt (K := K) (Place.ofFinite 𝔮) γ ∈
      (powMonoidHom p : ((𝔮.adicCompletion K)ˣ →* (𝔮.adicCompletion K)ˣ)).range := by
  have h := hγ
  rw [NK.UchidaKummer.localPowClass, MonoidHom.comp_apply, QuotientGroup.mk'_apply] at h
  exact (QuotientGroup.eq_one_iff _).mp h

/-- The `n`-th power of a one-place idèle. -/
theorem onePlace_pow {K : Type} [Field K] [NumberField K] (w : Place K)
    (u : (Place.localField K w)ˣ) (n : ℕ) :
    NK.HassePrinciple.onePlace w (u ^ n) = (NK.HassePrinciple.onePlace w u) ^ n := by
  rw [← NK.CFTLib.IdeleHasse.onePlaceHom_apply (K := K) w (u ^ n),
    ← NK.CFTLib.IdeleHasse.onePlaceHom_apply (K := K) w u, map_pow]

/-- **Every element of `Gal(M/↥K)` has `p`-th power `1`** when the norm class subgroup of
`M/↥K` contains the `p`-th powers of `C_↥K`. -/
theorem galExp_L1K (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (T' : Finset (NK.Chebotarev.PrimeIdeal ↥K))
    (M : IntermediateField ↥K Ω) [FiniteDimensional ↥K M] [IsGalois ↥K M] [NumberField ↥M]
    [IsMulCommutative (↥M ≃ₐ[↥K] ↥M)]
    (hM : NK.GlobalCFT.Idele.normClassSubgroup ↥K ↥M =
      Work.SSGRoute.SSG8Escape.gesUPow ↥K p T')
    (art : NK.GlobalCFT.Idele ↥K →* (↥M ≃ₐ[↥K] ↥M))
    (hker : art.ker = NK.GlobalCFT.Idele.normImage ↥K ↥M ⊔
      NK.GlobalCFT.Idele.principalSubgroup ↥K)
    (hfrob : ∀ 𝔮 : NK.Chebotarev.PrimeIdeal ↥K,
      NK.HeckeL.IsUnramifiedIn (K := ↥K) (L := ↥M) 𝔮 →
      art (NK.HeckeL.ideleOfPrime ↥K 𝔮) = NK.Chebotarev.frobAtPrime (K := ↥K) (L := ↥M) 𝔮) :
    ∀ g : ↥M ≃ₐ[↥K] ↥M, g ^ p = 1 := by
  classical
  have hcomm : ∀ a b : (↥M ≃ₐ[↥K] ↥M), a * b = b * a := fun a b => mul_comm' a b
  have hartp : ∀ z : NK.GlobalCFT.Idele ↥K, (art z) ^ p = 1 := by
    intro z
    rw [← map_pow]
    refine art_eq_one_of_mk_mem art hker ?_
    have hrange : (IdeleClassGroup.mk ↥K z) ^ p ∈ Work.SSGRoute.EscapeCoreLib.pPowSubgroup p
        (IdeleClassGroup ↥K) :=
      Work.SSGRoute.EscapeCoreLib.pow_mem_pPowSubgroup (IdeleClassGroup.mk ↥K z)
    rw [hM, gesUPow_eq]
    refine Subgroup.mem_sup_right ?_
    rw [map_pow]
    exact hrange
  have hsurj : Function.Surjective art := by
    obtain ⟨m, hm, hram, hprinc⟩ := NK.CFTLib.artinReciprocityIdeal_proved ↥K ↥M hcomm
    have htop : art.range = ⊤ := by
      refine NK.CFTLib.Arl.eq_top_of_forall_isFrobAtPrime_of_notMem
        (NK.CFTLib.Arl.primesDividing m hm) art.range ?_
      intro q hq σ hσ
      have hqm : (m : NumberField.RingOfIntegers ↥K) ∉ q.asIdeal :=
        fun h => hq ((NK.CFTLib.Arl.mem_primesDividing m hm q).mpr h)
      have hunr : NK.HeckeL.IsUnramifiedIn (K := ↥K) (L := ↥M) q :=
        (NK.CFTLib.ArtinReciprocityIdeal.isUnramified_iff_ramificationIdxIn_eq_one (K := ↥K)
          (L := ↥M) q).mpr (hram q hqm)
      have hσeq : σ = NK.Chebotarev.frobAtPrime (K := ↥K) (L := ↥M) q :=
        (NK.Chebotarev.ExistsUniqueIsFrobAtPrime (K := ↥K) (L := ↥M) hcomm q hunr).unique hσ
          (NK.Chebotarev.isFrobAtPrime_frobAtPrime (K := ↥K) (L := ↥M) hcomm q hunr)
      rw [hσeq, ← hfrob q hunr]
      exact MonoidHom.mem_range.mpr ⟨_, rfl⟩
    intro g
    exact MonoidHom.mem_range.mp (by rw [htop]; exact Subgroup.mem_top g)
  intro g
  obtain ⟨z, rfl⟩ := hsurj g
  exact hartp z

/-- **The orthogonality clause implies complete splitting.**  If every additive class on
`K.fixingSubgroup` killing `L.fixingSubgroup` kills the decomposition group of `A`, and `F/↥K` is
an abelian extension of exponent `p` lying over `L`, then `A` is completely decomposed in `F/↥K`.
The proof is the duality of finite abelian `p`-groups: a character of `Gal(F/↥K)` is such a class,
so every character kills the image of the decomposition group, and characters separate its
points. -/
theorem isSplitIn_of_horth_L1K (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (L : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L] (hKL : K ≤ L)
    (F : IntermediateField ↥K Ω) [FiniteDimensional ↥K F] [IsGalois ↥K F]
    [IsMulCommutative (↥F ≃ₐ[↥K] ↥F)]
    (hFL : ∀ x : ↥F, (x : Ω) ∈ L)
    (hexp : ∀ g : ↥F ≃ₐ[↥K] ↥F, g ^ p = 1)
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (horth : ∀ χ : (Ω ≃ₐ[k] Ω) → ZMod p,
        (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ (x * y) = χ x + χ y) →
        (∀ σ ∈ L.fixingSubgroup, χ σ = 0) →
        ∀ σ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, χ σ = 0) :
    SSGRoute.IsSplitIn ↥K F A := by
  classical
  haveI : Fintype (↥F ≃ₐ[↥K] ↥F) := AlgEquiv.fintype ↥K ↥F
  haveI hFfin : Finite (↥F ≃ₐ[↥K] ↥F) := Finite.of_fintype _
  letI hFcg : CommGroup (↥F ≃ₐ[↥K] ↥F) := { mul_comm := fun a b => mul_comm' a b }
  letI hFmod : Module (ZMod p) (Additive (↥F ≃ₐ[↥K] ↥F)) :=
    AddCommGroup.zmodModule (fun a => by
      refine Additive.ext ?_
      have h1 : Additive.toMul (p • a) = Additive.toMul a ^ p := by simp
      rw [h1, hexp]
      rfl)
  have hsep : ∀ g : ↥F ≃ₐ[↥K] ↥F,
      (∀ φ : (↥F ≃ₐ[↥K] ↥F) →* Multiplicative (ZMod p), φ g = 1) → g = 1 := by
    intro g hg
    have key : ∀ f : Additive (↥F ≃ₐ[↥K] ↥F) →ₗ[ZMod p] ZMod p,
        f.toAddMonoidHom (Additive.ofMul g) = 0 := by
      intro f
      have h1 := hg (MonoidHom.mk' (fun u => Multiplicative.ofAdd
        (f.toAddMonoidHom (Additive.ofMul u)))
        (by intro a b; simp only [map_add, ofMul_mul, ofAdd_add]))
      simpa using h1
    have hmem := Work.SSGRoute.EscapeCoreLib.mem_of_forall_linearMap_eq_zero (p := p)
      (A := Additive (↥F ≃ₐ[↥K] ↥F)) (H := ⊥) (x := Additive.ofMul g) (fun f _ => key f)
    rw [Submodule.mem_bot] at hmem
    have h2 := congrArg Additive.toMul hmem
    simpa using h2
  unfold SSGRoute.IsSplitIn
  intro σ hσ
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro y hy
  have hres : AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) F σ = 1 := by
    refine hsep _ fun φ => ?_
    let ψ : ↥(K.fixingSubgroup) → ZMod p := fun τ =>
      Multiplicative.toAdd (φ (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) F
        ((IntermediateField.fixingSubgroupEquiv K) τ)))
    have hψadd : ∀ a b : ↥(K.fixingSubgroup), ψ (a * b) = ψ a + ψ b := by
      intro a b
      simp only [ψ]
      rw [map_mul, map_mul, map_mul]
      rfl
    let χ : (Ω ≃ₐ[k] Ω) → ZMod p := fun τ =>
      if h : τ ∈ K.fixingSubgroup then ψ ⟨τ, h⟩ else 0
    have hχadd : ∀ a ∈ K.fixingSubgroup, ∀ b ∈ K.fixingSubgroup, χ (a * b) = χ a + χ b := by
      intro a ha b hb
      have hab : a * b ∈ K.fixingSubgroup := Subgroup.mul_mem _ ha hb
      simp only [χ, dif_pos ha, dif_pos hb, dif_pos hab]
      exact hψadd ⟨a, ha⟩ ⟨b, hb⟩
    have hχkill : ∀ τ ∈ L.fixingSubgroup, χ τ = 0 := by
      intro τ hτ
      have hτK : τ ∈ K.fixingSubgroup := by
        rw [IntermediateField.mem_fixingSubgroup_iff]
        intro z hz
        exact (IntermediateField.mem_fixingSubgroup_iff L τ).mp hτ z (hKL hz)
      have h1 : (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) F
          ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, hτK⟩)) = 1 := by
        refine AlgEquiv.ext fun z => Subtype.ext ?_
        rw [AlgEquiv.restrictNormalHom_apply, AlgEquiv.one_apply]
        exact (IntermediateField.mem_fixingSubgroup_iff L τ).mp hτ (z : Ω) (hFL z)
      simp only [χ, dif_pos hτK, ψ]
      rw [h1, map_one]
      rfl
    let σ' : Ω ≃ₐ[k] Ω := (IntermediateField.fixingSubgroupEquiv K).symm σ
    have hσ'K : σ' ∈ K.fixingSubgroup := ((IntermediateField.fixingSubgroupEquiv K).symm σ).2
    have hσ'dec : σ' ∈ SSGRoute.decomp k A := by
      refine (Work.SSGRoute.fixingSubgroupEquiv_mem_decomp k Ω K A σ' hσ'K).mp ?_
      have h2 : ((IntermediateField.fixingSubgroupEquiv K) ⟨σ', hσ'K⟩) = σ :=
        MulEquiv.apply_symm_apply _ _
      rw [h2]
      exact hσ
    have h0 := horth χ hχadd hχkill σ' (Subgroup.mem_inf.mpr ⟨hσ'dec, hσ'K⟩)
    have hχσ' : χ σ' =
        Multiplicative.toAdd (φ (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) F σ)) := by
      simp only [χ, dif_pos hσ'K]
      simp only [ψ]
      rw [show (IntermediateField.fixingSubgroupEquiv K) ⟨σ', hσ'K⟩ = σ from
        MulEquiv.apply_symm_apply _ _]
    rw [hχσ'] at h0
    have h3 := congrArg Multiplicative.ofAdd h0
    simpa using h3
  have h1 : ((AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) F σ) ⟨y, hy⟩) = ⟨y, hy⟩ := by
    rw [hres, AlgEquiv.one_apply]
  have h2 := congrArg (fun z : ↥F => (z : Ω)) h1
  rw [AlgEquiv.restrictNormalHom_apply] at h2
  simpa using h2

/-! ## The main theorem -/

theorem alpha_fixes_L1K (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (hKimag : p = 2 → ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → c = 1)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L] (hKL : K ≤ L)
    (T : Finset (ValuationSubring Ω)) (hTfin : ∀ A ∈ T, SSGRoute.IsFinPlace k A)
    (T' : Finset (NK.Chebotarev.PrimeIdeal ↥K))
    (hTbelow : ∀ A ∈ T, ∃ 𝔭 ∈ T', A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K 𝔭)
    (hT'above : ∀ 𝔭 ∈ T', ∃ A ∈ T, A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K 𝔭)
    (hTdisj : ∀ A ∈ T, ∀ B ∈ T, (∃ τ ∈ K.fixingSubgroup, τ • A = B) → A = B)
    (hTcov : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (B.valuation (p : Ω) < 1 ∨
        (∃ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ ∧ σ ∉ L.fixingSubgroup)) →
      ∃ A ∈ T, ∃ τ ∈ K.fixingSubgroup, τ • A = B)
    (h : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → ZMod p)
    (hh : ∀ A ∈ T, ∀ x ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup,
      ∀ y ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, h A (x * y) = h A x + h A y)
    (hhc : ∀ A ∈ T, ∃ U : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (U : Set (Ω ≃ₐ[k] Ω)) ∧
      ∀ x ∈ U, x ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup → h A x = 0)
    (horth : ∀ A ∈ T,
      (∀ σ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, h A σ = 0) ∨
      (∀ χ : (Ω ≃ₐ[k] Ω) → ZMod p,
        (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ (x * y) = χ x + χ y) →
        (∀ σ ∈ L.fixingSubgroup, χ σ = 0) →
        ∀ σ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, χ σ = 0))
    (a : (↥K)ˣ)
    (ha : ∀ A ∈ T, ∀ σ : ↥(SSGRoute.decomp k A ⊓ K.fixingSubgroup),
      h A (σ : Ω ≃ₐ[k] Ω) =
        Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ a
          (Work.SSGRoute.gesLocalToGalK K σ))
    (M : IntermediateField ↥K Ω) [FiniteDimensional ↥K M] [IsGalois ↥K M] [NumberField ↥M]
    [IsMulCommutative (↥M ≃ₐ[↥K] ↥M)]
    (hM : NK.GlobalCFT.Idele.normClassSubgroup ↥K ↥M =
      Work.SSGRoute.SSG8Escape.gesUPow ↥K p T')
    (art : NK.GlobalCFT.Idele ↥K →* (↥M ≃ₐ[↥K] ↥M))
    (hker : art.ker = NK.GlobalCFT.Idele.normImage ↥K ↥M ⊔
      NK.GlobalCFT.Idele.principalSubgroup ↥K)
    (hfrob : ∀ 𝔮 : NK.Chebotarev.PrimeIdeal ↥K,
      NK.HeckeL.IsUnramifiedIn (K := ↥K) (L := ↥M) 𝔮 →
      art (NK.HeckeL.ideleOfPrime ↥K 𝔮) = NK.Chebotarev.frobAtPrime (K := ↥K) (L := ↥M) 𝔮)
    (α : ↥M ≃ₐ[↥K] ↥M)
    (hα : art (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))
      = α) :
    ∀ x : ↥M, ((x : Ω) ∈ L) → α x = x := by
  classical
  haveI hNumK : NumberField ↥K := NumberField.of_module_finite k ↥K
  -- the field `L`, viewed over `↥K`
  set Lb : IntermediateField ↥K Ω := Work.SSGRoute.EscapeCoreLib.baseChange K L hKL with hLbdef
  have hLbmem : ∀ x : Ω, x ∈ Lb ↔ x ∈ L := by
    intro x
    rw [hLbdef, Work.SSGRoute.EscapeCoreLib.mem_baseChange]
  haveI hLbgal : IsGalois ↥K Lb := by
    rw [hLbdef]; exact Work.SSGRoute.EscapeCoreLib.isGalois_baseChange K L hKL
  -- `FΩ = M ⊓ L`
  set FΩ : IntermediateField ↥K Ω := M ⊓ Lb with hFΩdef
  haveI hFΩfd : FiniteDimensional ↥K ↥FΩ := by
    rw [hFΩdef]
    exact FiniteDimensional.of_injective (IntermediateField.inclusion inf_le_left).toLinearMap
      (IntermediateField.inclusion_injective inf_le_left)
  haveI hFΩgal : IsGalois ↥K ↥FΩ := by
    rw [hFΩdef]; exact isGalois_iff.mpr ⟨inferInstance, inferInstance⟩
  haveI hFΩnf : NumberField ↥FΩ := NumberField.of_module_finite ↥K ↥FΩ
  -- `F`: the copy of `FΩ` inside `M`
  set F : IntermediateField ↥K ↥M := FΩ.comap (IsScalarTower.toAlgHom ↥K ↥M Ω) with hFdef
  have hFmem : ∀ x : ↥M, x ∈ F ↔ (x : Ω) ∈ L := by
    intro x
    have h1 : (IsScalarTower.toAlgHom ↥K ↥M Ω) x = (x : Ω) := rfl
    constructor
    · intro hx
      have h2 : (IsScalarTower.toAlgHom ↥K ↥M Ω) x ∈ FΩ := hx
      rw [h1, hFΩdef, IntermediateField.mem_inf] at h2
      exact (hLbmem x).mp h2.2
    · intro hx
      have h2 : (IsScalarTower.toAlgHom ↥K ↥M Ω) x ∈ FΩ := by
        rw [h1, hFΩdef, IntermediateField.mem_inf]
        exact ⟨x.2, (hLbmem x).mpr hx⟩
      exact h2
  haveI hFgal : IsGalois ↥K ↥F := by
    rw [hFdef]
    exact Work.SSGRoute.EscapeCoreLib.isGalois_comap_of_le_over K M FΩ inf_le_left
  haveI hFfd : FiniteDimensional ↥K ↥F := by
    rw [hFdef]
    exact FiniteDimensional.of_injective
      (Work.SSGRoute.EscapeCoreLib.comapAlgEquiv K M FΩ inf_le_left).symm.toLinearEquiv.toLinearMap
      (Work.SSGRoute.EscapeCoreLib.comapAlgEquiv K M FΩ inf_le_left).symm.injective
  haveI hFnf : NumberField ↥F := NumberField.of_module_finite ↥K ↥F
  -- exponent `p`
  have hexpM : ∀ g : ↥M ≃ₐ[↥K] ↥M, g ^ p = 1 :=
    galExp_L1K p k Ω K T' M hM art hker hfrob
  have hcommF : ∀ a b : ↥F ≃ₐ[↥K] ↥F, a * b = b * a := by
    intro a b
    obtain ⟨a', rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := ↥K) (K₁ := F) (E := ↥M) a
    obtain ⟨b', rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := ↥K) (K₁ := F) (E := ↥M) b
    rw [← map_mul, ← map_mul, mul_comm']
  have hexpF : ∀ g : ↥F ≃ₐ[↥K] ↥F, g ^ p = 1 := by
    intro g
    obtain ⟨g', rfl⟩ := AlgEquiv.restrictNormalHom_surjective (F := ↥K) (K₁ := F) (E := ↥M) g
    rw [← map_pow, hexpM g', map_one]
  haveI hFcomm : IsMulCommutative (↥F ≃ₐ[↥K] ↥F) := IsMulCommutative.of_comm hcommF
  -- the same for `FΩ`, along the canonical isomorphism `↥FΩ ≃ₐ[↥K] ↥F`
  let cφ : ↥FΩ ≃ₐ[↥K] ↥F := Work.SSGRoute.EscapeCoreLib.comapAlgEquiv K M FΩ inf_le_left
  haveI hFΩcomm : IsMulCommutative (↥FΩ ≃ₐ[↥K] ↥FΩ) := by
    refine IsMulCommutative.of_comm fun a b => ?_
    let e := AlgEquiv.autCongr cφ
    have h := hcommF (e a) (e b)
    exact e.injective (by rw [map_mul, map_mul, h])
  have hexpFΩ : ∀ g : ↥FΩ ≃ₐ[↥K] ↥FΩ, g ^ p = 1 := by
    intro g
    let e := AlgEquiv.autCongr cφ
    have h := hexpF (e g)
    have h2 : e (g ^ p) = (e g) ^ p := map_pow e g p
    exact e.injective (by rw [h2, h, map_one])
  -- the per-prime membership
  have hper : ∀ 𝔭 ∈ T', IdeleClassGroup.mk ↥K
      (NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
        (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)) ∈
      Idele.normClassSubgroup ↥K ↥F := by
    intro 𝔭 h𝔭
    obtain ⟨A, hAT, hAcomap⟩ := hT'above 𝔭 h𝔭
    have hAfin : SSGRoute.IsFinPlace k A := hTfin A hAT
    have hAne : A.comap (algebraMap ↥K Ω) ≠ ⊤ := by
      intro htop
      apply hAfin
      rw [← top_le_iff]
      intro y _
      rw [ValuationSubring.mem_comap, IsScalarTower.algebraMap_apply k ↥K Ω]
      have h1 : (algebraMap k ↥K y) ∈ A.comap (algebraMap ↥K Ω) := by rw [htop]; simp
      rwa [ValuationSubring.mem_comap] at h1
    rcases horth A hAT with hzero | hchi
    · -- ## the `h A ≡ 0` case: `a` is a local `p`-th power at `𝔭`
      have hchar : ∀ τ : Ω ≃ₐ[↥K] Ω, τ ∈ SSGRoute.decomp ↥K A →
          Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ a τ = 0 := by
        intro τ hτ
        let τ' : Ω ≃ₐ[k] Ω := (IntermediateField.fixingSubgroupEquiv K).symm τ
        have hτ'K : τ' ∈ K.fixingSubgroup := ((IntermediateField.fixingSubgroupEquiv K).symm τ).2
        have hτ'dec : τ' ∈ SSGRoute.decomp k A := by
          refine (Work.SSGRoute.fixingSubgroupEquiv_mem_decomp k Ω K A τ' hτ'K).mp ?_
          have h2 : ((IntermediateField.fixingSubgroupEquiv K) ⟨τ', hτ'K⟩) = τ :=
            MulEquiv.apply_symm_apply _ _
          rw [h2]
          exact hτ
        have h1 : h A τ' = 0 := hzero τ' (Subgroup.mem_inf.mpr ⟨hτ'dec, hτ'K⟩)
        have h2 : h A τ' = Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ a
            (Work.SSGRoute.gesLocalToGalK K ⟨τ', ⟨hτ'dec, hτ'K⟩⟩) :=
          ha A hAT ⟨τ', ⟨hτ'dec, hτ'K⟩⟩
        rw [h1] at h2
        have h3 : Work.SSGRoute.gesLocalToGalK K ⟨τ', ⟨hτ'dec, hτ'K⟩⟩ = τ :=
          MulEquiv.apply_symm_apply (IntermediateField.fixingSubgroupEquiv K) τ
        rw [← h3, ← h2]
      have hlp : NK.UchidaKummer.localPowClass ↥K p 𝔭 a = 1 :=
        (Work.SSGRoute.local_kummer_dictionary (k := k) (Ω := Ω) p K ζ hζ A hAfin 𝔭 hAcomap
          a).mp hchar
      obtain ⟨b, hb⟩ := localImageAt_mem_powRange_of_localPowClass_eq_one p 𝔭 a hlp
      have hone := onePlace_pow (Place.ofFinite 𝔭) b p
      have h1 : IdeleClassGroup.mk ↥K
          (NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
            (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)) ∈
          Work.SSGRoute.SSG8Escape.gesUPow ↥K p T' := by
        rw [show NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a = b ^ p from
          hb.symm, hone, map_pow]
        rw [gesUPow_eq]
        exact Subgroup.mem_sup_right (Work.SSGRoute.EscapeCoreLib.pow_mem_pPowSubgroup _)
      exact Idele.normClassSubgroup_le_of_tower (K := ↥K) (L := ↥F) (M := ↥M)
        (hM.symm ▸ h1)
    · -- ## the orthogonality case: `𝔭` splits completely in `F/↥K`
      have hsplit : SSGRoute.IsSplitIn ↥K FΩ A :=
        isSplitIn_of_horth_L1K p k Ω K L hKL FΩ
          (fun x => (hLbmem (x : Ω)).mp (IntermediateField.mem_inf.mp x.2).2) hexpFΩ A hAfin hchi
      have htop : NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥FΩ)
          (Place.ofFinite 𝔭) = ⊤ :=
        Work.SSGRoute.ZDataMup.localNormSubgroup_eq_top_of_isSplitIn (K := K) (E := FΩ)
          A hAne 𝔭 hAcomap hsplit
      have hmem : NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a ∈
          NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥FΩ) (Place.ofFinite 𝔭) := by
        rw [htop]; exact Subgroup.mem_top _
      have hni : NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
          (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a) ∈
          Idele.normImage ↥K ↥FΩ :=
        (NK.CFTLib.IdeleHasse.onePlace_mem_normImage_iff (K := ↥K) (L := ↥FΩ)
          (Place.ofFinite 𝔭) _).mpr hmem
      have h1 : IdeleClassGroup.mk ↥K
          (NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
            (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)) ∈
          Idele.normClassSubgroup ↥K ↥FΩ := Subgroup.mem_map_of_mem _ hni
      exact (Work.SSGRoute.Sha2Lib.mem_normClassSubgroup_iff_of_algEquiv cφ _).mp h1
  -- the `T'`-part is a norm
  have hP : IdeleClassGroup.mk ↥K
      (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
        (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)) ∈
      Idele.normClassSubgroup ↥K ↥F := by
    rw [map_prod]
    exact Subgroup.prod_mem _ (fun 𝔭 h𝔭 => hper 𝔭 h𝔭)
  -- the idèle decomposition of `(a)ᵥ`
  obtain ⟨u, hu, hdec⟩ := idele_decomposition_tFreePart p ↥K T' a
  have hprin : IdeleClassGroup.mk ↥K (NK.GlobalCFT.Idele.principalIdele ↥K a) = 1 :=
    MonoidHom.mem_ker.mp (by
      rw [Work.SSGRoute.ker_mk_eq_principal]
      exact Idele.mem_principalSubgroup.mpr ⟨a, rfl⟩)
  have huM : IdeleClassGroup.mk ↥K u ∈ Idele.normClassSubgroup ↥K ↥M := by
    rw [hM, gesUPow_eq]
    exact Subgroup.mem_sup_left (Subgroup.mem_map_of_mem _ (Subgroup.mem_sup_right hu))
  have huF : IdeleClassGroup.mk ↥K u ∈ Idele.normClassSubgroup ↥K ↥F :=
    Idele.normClassSubgroup_le_of_tower (K := ↥K) (L := ↥F) (M := ↥M) huM
  have hmkD : IdeleClassGroup.mk ↥K
      (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a)) ∈
      Idele.normClassSubgroup ↥K ↥F := by
    have hkey : (IdeleClassGroup.mk ↥K
          (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
            (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)) *
        (IdeleClassGroup.mk ↥K
          (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))) *
        (IdeleClassGroup.mk ↥K u)) = 1 := by
      have h := congrArg (IdeleClassGroup.mk ↥K) hdec
      rw [map_mul, map_mul, hprin] at h
      exact h.symm
    have hB : IdeleClassGroup.mk ↥K
        (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a)) =
        (IdeleClassGroup.mk ↥K
          (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
            (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)))⁻¹ *
        (IdeleClassGroup.mk ↥K u)⁻¹ := by
      calc IdeleClassGroup.mk ↥K
            (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))
          = (IdeleClassGroup.mk ↥K
              (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
                (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)))⁻¹ *
            ((IdeleClassGroup.mk ↥K
              (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
                (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a))) *
              (IdeleClassGroup.mk ↥K
                (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))) *
              (IdeleClassGroup.mk ↥K u)) * (IdeleClassGroup.mk ↥K u)⁻¹ := by group
          _ = (IdeleClassGroup.mk ↥K
                (∏ 𝔭 ∈ T', NK.HassePrinciple.onePlace (Place.ofFinite 𝔭)
                  (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (Place.ofFinite 𝔭) a)))⁻¹ *
              (IdeleClassGroup.mk ↥K u)⁻¹ := by rw [hkey]; group
    rw [hB]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ hP) (Subgroup.inv_mem _ huF)
  -- the norm-class form of local-global compatibility
  obtain ⟨m, hm, hramM, hprincM⟩ :=
    NK.CFTLib.artinReciprocityIdeal_proved ↥K ↥M (fun a b => mul_comm' a b)
  have hres : AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := ↥M) F
      (art (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))) = 1 :=
    Work.SSGRoute.N4Escape.restrictNormalHom_artinMap_kills_normClassSubgroup_of_modulus m hm hramM
      hprincM F art
      (fun c => by
        rw [← MonoidHom.mem_ker, hker]
        exact Subgroup.mem_sup_right (Idele.mem_principalSubgroup.mpr ⟨c, rfl⟩))
      (fun y => by
        rw [← MonoidHom.mem_ker, hker]
        exact Subgroup.mem_sup_left (Idele.mem_normImage.mpr ⟨y, fun v => rfl⟩))
      (fun Q hQ => hfrob Q
        ((NK.CFTLib.ArtinReciprocityIdeal.isUnramified_iff_ramificationIdxIn_eq_one (K := ↥K)
          (L := ↥M) Q).mpr (hramM Q hQ)))
      (IdeleClassGroup.mk ↥K
        (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a)))
      hmkD _ rfl
  -- conclude
  intro x hx
  have hxF : x ∈ F := (hFmem x).mpr hx
  have h1 : ((AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := ↥M) F
      (art (NK.NUV2.RouteB.RayModulus.fracIdele (Work.SSGRoute.tFreePart (K := ↥K) T' a))))
        ⟨x, hxF⟩) = ⟨x, hxF⟩ := by
    rw [hres, AlgEquiv.one_apply]
  have h2 := congrArg (fun z : ↥F => (z : ↥M)) h1
  rw [AlgEquiv.restrictNormalHom_apply, hα] at h2
  simpa using h2

end Work.GrunwaldEscapeCore.L1Korth
