/-!
# The one-place idèle at a prime unramified for the Kummer extension lies in `U'`

`Work.GrunwaldEscapeCore.onePlace_mem_gesU_of_kummerChar_eq_zero_on_inertia`: if the global Kummer
character of `b ∈ κˣ` kills the inertia subgroup of a finite place `B` of `Ω` over the prime `𝔮` of
`κ`, then the one-place idèle of `b` at `𝔮` has idèle class in

  `U' = gesU κ p T' ⊔ C_κ^p`.

The arithmetic input is the classical fact (`dvd_log_of_kummerChar_eq_zero_on_inertia`) that
`κ(b^{1/p})/κ` can be unramified at `𝔮` only when `p ∣ v_𝔮(b)`: the extension generated by a `p`-th
root of `b` has ramification index `p / gcd(p, v_𝔮(b))`.  Given `γ, u ∈ κ_𝔮ˣ` with
`b = γ^p·u` and `u` a local unit (`exists_pow_mul_mem_localUnits_of_dvd_log`), the one-place idèle
splits as the `p`-th power of the one-place idèle of `γ` times the one-place idèle of the local
unit `u`; the first factor lies in the `p`-th powers `C_κ^p`, and the second lies in
`powTIdeles κ p T' ⊆ gesU κ p T'` because `𝔮 ∉ T'`.

## Contents

* `localImageAt_mem_localUnits_of_valuation_eq_one` — a `𝔮`-unit of `κ` maps to a local unit;
* `onePlace_mem_powTIdeles_of_mem_localUnits` — a one-place idèle at `𝔮 ∉ T'` whose component is a
  local unit lies in `E_{T'}`;
* `onePlace_mem_gesU_sup_pPow_of_dvd_log` — the assembly, from the arithmetic input
  `p ∣ v_𝔮(b)`;
* `onePlace_mem_gesU_of_kummerChar_eq_zero_on_inertia` — the theorem, assembling the two.
-/

namespace Work.GrunwaldEscapeCore

open scoped Pointwise

variable {κ Ω : Type} [Field κ] [NumberField κ] [Field Ω] [Algebra κ Ω]
  [IsAlgClosure κ Ω] [IsAlgClosed Ω]

/-- **A `𝔮`-unit of `κ` maps to a local unit at `𝔮`.** -/
theorem localImageAt_mem_localUnits_of_valuation_eq_one (𝔮 : NK.Chebotarev.PrimeIdeal κ)
    (u : κˣ) (hu : 𝔮.valuation κ (u : κ) = 1) :
    NK.CFTLib.IdeleHasse.localImageAt (K := κ) (NK.GlobalCFT.Place.ofFinite 𝔮) u ∈
      NK.GlobalCFT.Place.localUnits κ (NK.GlobalCFT.Place.ofFinite 𝔮) := by
  rw [NK.GlobalCFT.Place.mem_localUnits_ofFinite_iff_valued_eq_one]
  rw [NK.CFTLib.IdeleHasse.localImageAt, Units.coe_map]
  change Valued.v ((algebraMap κ (𝔮.adicCompletion κ)) (u : κ)) = 1
  rw [Commons.NumberTheory.NumberField.val_algebraMap_adicCompletion_eq]
  exact hu

/-- **`onePlace` of a power is the power of `onePlace`.** -/
theorem onePlace_pow_local {K : Type} [Field K] [NumberField K] (w : NK.GlobalCFT.Place K)
    (a : (NK.GlobalCFT.Place.localField K w)ˣ) (n : ℕ) :
    NK.HassePrinciple.onePlace w (a ^ n) =
      (NK.HassePrinciple.onePlace w a) ^ n := by
  induction n with
  | zero => rw [pow_zero, pow_zero, NK.CFTLib.IdeleHasse.onePlace_one]
  | succ n ih => rw [pow_succ, pow_succ, NK.CFTLib.IdeleHasse.onePlace_mul, ih]

/-- **A one-place idèle at `𝔮 ∉ T'` with a local unit component lies in `E_{T'}`.**

The component at every prime of `T'` is `1` (a `p`-th power), and the component at every place
outside `T'` is the local unit `u` (at `𝔮`) or `1` (elsewhere). -/
theorem onePlace_mem_powTIdeles_of_mem_localUnits (p : ℕ)
    (T' : Finset (NK.Chebotarev.PrimeIdeal κ)) (𝔮 : NK.Chebotarev.PrimeIdeal κ)
    (h𝔮T : 𝔮 ∉ T')
    (u : (NK.GlobalCFT.Place.localField κ (NK.GlobalCFT.Place.ofFinite 𝔮))ˣ)
    (hu : u ∈ NK.GlobalCFT.Place.localUnits κ (NK.GlobalCFT.Place.ofFinite 𝔮)) :
    NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮) u ∈
      Work.SSGRoute.powTIdeles κ p T' := by
  rw [Work.SSGRoute.mem_powTIdeles]
  refine ⟨fun 𝔭 h𝔭 => ?_, fun v hv => ?_⟩
  · rw [NK.HassePrinciple.onePlace_apply_ne (v := NK.GlobalCFT.Place.ofFinite 𝔭)
      (w := NK.GlobalCFT.Place.ofFinite 𝔮)
      (fun h => h𝔮T (NK.GlobalCFT.Place.ofFinite_inj.mp h ▸ h𝔭))]
    exact Subgroup.one_mem _
  · by_cases hvq : v = NK.GlobalCFT.Place.ofFinite 𝔮
    · subst hvq
      rw [NK.HassePrinciple.onePlace_apply_self]
      exact hu
    · rw [NK.HassePrinciple.onePlace_apply_ne hvq]
      exact Subgroup.one_mem _

/-- **The assembly.**  Given the arithmetic input `p ∣ v_𝔮(b)` — so that
`b = γ^p·u` with `u` a local unit at `𝔮`
(`Work.SSGRoute.ZDataMup.LocalUnramified.exists_pow_mul_mem_localUnits_of_dvd_log`) — the
one-place idèle of `b` at `𝔮` has class in `gesU κ p T' ⊔ C_κ^p`. -/
theorem onePlace_mem_gesU_sup_pPow_of_dvd_log (p : ℕ) [Fact p.Prime]
    (T' : Finset (NK.Chebotarev.PrimeIdeal κ)) (𝔮 : NK.Chebotarev.PrimeIdeal κ)
    (h𝔮T : 𝔮 ∉ T') (b : κˣ)
    (hdvd : (p : ℤ) ∣ (𝔮.valuation κ (b : κ)).log) :
    NK.GlobalCFT.IdeleClassGroup.mk κ
        (NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮)
          (NK.CFTLib.IdeleHasse.localImageAt (K := κ) (NK.GlobalCFT.Place.ofFinite 𝔮) b)) ∈
      Work.SSGRoute.GrunwaldEscapeCore.gesU κ p T' ⊔
        Work.SSGRoute.EscapeCoreLib.pPowSubgroup p (NK.GlobalCFT.IdeleClassGroup κ) := by
  classical
  obtain ⟨γ, u, hu, hγu⟩ :=
    Work.SSGRoute.ZDataMup.LocalUnramified.exists_pow_mul_mem_localUnits_of_dvd_log
      𝔮 p Fact.out b hdvd
  -- the one-place idèle splits into a `p`-th power and a local unit idèle
  have hl : NK.CFTLib.IdeleHasse.localImageAt (K := κ) (NK.GlobalCFT.Place.ofFinite 𝔮) b =
      γ ^ p * u := hγu
  have hsplit : NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮)
      (NK.CFTLib.IdeleHasse.localImageAt (K := κ) (NK.GlobalCFT.Place.ofFinite 𝔮) b) =
      (NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮) γ) ^ p *
        NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮) u := by
    rw [hl, NK.CFTLib.IdeleHasse.onePlace_mul, onePlace_pow_local]
  rw [hsplit, map_mul, map_pow]
  refine Subgroup.mul_mem _ (Subgroup.mem_sup_right
    (Work.SSGRoute.EscapeCoreLib.pow_mem_pPowSubgroup _)) (Subgroup.mem_sup_left ?_)
  refine Subgroup.mem_map.mpr ⟨_, Subgroup.mem_sup_right ?_, rfl⟩
  exact onePlace_mem_powTIdeles_of_mem_localUnits p T' 𝔮 h𝔮T u hu

/-- **The arithmetic input: the Kummer character killing the inertia forces `p ∣ v_𝔮(b)`.**

Contrapositively: if `p ∤ v_𝔮(b)`, the Kummer field `N = κ(b^{1/p})` (for `b` not a `p`-th power)
has ramification index divisible by `p` at the prime below `B`
(`dvd_ramificationIdx_of_val_log_notMem_pow`), hence a non-trivial inertia subgroup
(`inertia_eq_bot_iff_ramificationIdx_eq_one`); a non-trivial inertia element of `Gal(N/κ)` lifts to
an inertia element of `B` in `G_κ` (`inertiaSub_image_eq_levelInertia`) which moves the chosen
`p`-th root, so the Kummer character of `b` does not vanish there
(`kummerCharZMod_eq_zero_iff_apply_sqrt`). -/
theorem dvd_log_of_kummerChar_eq_zero_on_inertia_aux (p : ℕ) [Fact p.Prime]
    (ζ : κ) (hζ : IsPrimitiveRoot ζ p)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace κ B)
    (𝔮 : NK.Chebotarev.PrimeIdeal κ)
    (h𝔮 : B.comap (algebraMap κ Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime κ 𝔮)
    (b : κˣ)
    (hb : ∀ σ : Ω ≃ₐ[κ] Ω, SSGRoute.IsInertia (k := κ) B σ →
      Work.SSGRoute.kummerCharZMod (K := κ) (Ω := Ω) p (ζ := ζ) hζ b σ = 0) :
    (p : ℤ) ∣ (𝔮.valuation κ (b : κ)).log := by
  classical
  haveI hSep : IsSepClosure κ Ω := IsSepClosure.of_isAlgClosure_of_perfectField κ Ω
  by_contra hndvd
  -- Step 1: `b` is not a `p`-th power in `κ`
  have hbnot : b ∉ NK.LocalAnabelian.powSubgroup p κ := by
    rintro ⟨d, hd⟩
    refine hndvd ⟨(𝔮.valuation κ (d : κ)).log, ?_⟩
    have hd' : (d : κ) ^ p = (b : κ) := by
      simpa using congrArg (fun u : κˣ => (u : κ)) hd
    rw [← hd', map_pow, WithZero.log_pow, nsmul_eq_mul]
  -- Step 2: the Kummer field `N = κ⟮α⟯` of a chosen `p`-th root `α` of `b`
  set α : Ω := Work.SSGRoute.kummerSqrtZMod (Ω := Ω) (K := κ) p b with hαdef
  have hα : α ^ p = algebraMap κ Ω (b : κ) :=
    Work.SSGRoute.kummerSqrtZMod_pow (Ω := Ω) (K := κ) p b
  set N : IntermediateField κ Ω := NK.LocalAnabelian.kummerField (K' := Ω) p b with hNdef
  haveI hgalN : IsGalois κ N :=
    (NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank (K' := Ω) p Fact.out hζ b
      hbnot).1
  haveI hfdN : FiniteDimensional κ ↥N :=
    NK.GlobalCFTdeep.SecondInequality.finiteDimensional_kummerField (K' := Ω) (k := κ)
      (p := p) Fact.out hζ b
  haveI hnfN : NumberField ↥N :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField N
  have hNgen : N = IntermediateField.adjoin κ ({α} : Set Ω) := by
    rw [hNdef]
    exact NK.UchidaKummer.Kummer.kummerField_eq_adjoin_simple p Fact.out hζ b hα
  have hαN : α ∈ N := by
    rw [hNgen]
    exact IntermediateField.mem_adjoin_simple_self κ α
  -- Step 3: the prime `P` of `𝓞 ↥N` below `B`, lying over `𝔮`
  set P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥N) :=
    Work.SSGRoute.levelPrime κ Ω B hB N with hPdef
  have hprimeOf : Submission.NeukirchUchida.primeOf B hB = 𝔮 :=
    Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := κ) (by
      rw [← Submission.NeukirchUchida.primeOf_spec B hB]
      exact h𝔮)
  have hLies : P.asIdeal.LiesOver 𝔮.asIdeal := by
    have h := NK.ResidueFrob.primeOfLevel_liesOver (K := κ) (K' := Ω) ⟨B, hB⟩ N
    rw [hprimeOf] at h
    simpa only [hPdef, Work.SSGRoute.levelPrime] using h
  haveI hLiesI := hLies
  -- Step 4: `p` divides the ramification index of `P` over `𝔮`
  have hpP : p ∣ P.asIdeal.ramificationIdx (NumberField.RingOfIntegers κ) := by
    have hβN : (⟨α, hαN⟩ : ↥N) ^ p = algebraMap κ ↥N (b : κ) := by
      apply Subtype.ext
      rw [SubmonoidClass.coe_pow]
      change α ^ p = algebraMap κ Ω (b : κ)
      exact hα
    exact Work.SSGRoute.ZDataMup.LocalUnramified.dvd_ramificationIdx_of_val_log_notMem_pow κ ↥N
      p Fact.out b ⟨α, hαN⟩ hβN 𝔮 P hndvd
  -- Step 5: the level inertia at `P` is non-trivial
  haveI h𝔮prime : 𝔮.asIdeal.IsPrime := 𝔮.isPrime
  haveI hPprime : P.asIdeal.IsPrime := P.isPrime
  have he_ne : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers κ) ≠ 1 := by
    intro h1
    rw [h1] at hpP
    exact (Fact.out : p.Prime).ne_one (Nat.dvd_one.mp hpP)
  have hbot : Ideal.inertia (↥N ≃ₐ[κ] ↥N) P.asIdeal ≠ ⊥ := fun hb0 =>
    he_ne ((Commons.NumberTheory.RamificationInertia.inertia_eq_bot_iff_ramificationIdx_eq_one
      𝔮.asIdeal P.asIdeal).mp hb0)
  obtain ⟨τ, hτmem, hτne⟩ : ∃ τ : ↥N ≃ₐ[κ] ↥N,
      τ ∈ Ideal.inertia (↥N ≃ₐ[κ] ↥N) P.asIdeal ∧ τ ≠ 1 := by
    by_contra hcon
    apply hbot
    rw [Subgroup.eq_bot_iff_forall]
    intro x hx
    by_contra hx1
    exact hcon ⟨x, hx, hx1⟩
  -- Step 6: lift `τ` to an inertia element `σ₁` of the place `B`
  have hmap := Work.SSGRoute.inertiaSub_image_eq_levelInertia κ Ω B hB N
  have hτmem' : τ ∈ (Work.SSGRoute.inertiaSub κ Ω B).map (AlgEquiv.restrictNormalHom N) := by
    rw [hmap]
    exact hτmem
  obtain ⟨σ₁, hσ₁mem, hσ₁res⟩ := Subgroup.mem_map.mp hτmem'
  -- Step 7: `σ₁` moves the chosen `p`-th root `α` of `b`
  have hσ₁α : σ₁ α ≠ α := by
    intro hfixα
    have hσ₁fix : σ₁ ∈ N.fixingSubgroup := by
      rw [hNgen]
      exact Work.SSGRoute.ZDataTwo.mem_fixingSubgroup_adjoin_simple α σ₁ hfixα
    have h1 : AlgEquiv.restrictNormalHom N σ₁ = 1 := by
      rw [show AlgEquiv.restrictNormalHom N σ₁ = σ₁.restrictNormal ↥N from rfl,
        AlgEquiv.restrictNormal_eq_one_iff]
      exact fun y hy => (IntermediateField.mem_fixingSubgroup_iff N σ₁).mp hσ₁fix y hy
    rw [h1] at hσ₁res
    exact hτne hσ₁res.symm
  -- Step 8: hence the Kummer character of `b` does not vanish at `σ₁`
  have hχ : Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := κ) p (ζ := ζ) hζ b σ₁ ≠ 0 := by
    intro h0
    exact hσ₁α
      ((Work.SSGRoute.ZDataMup.LocalUnramified.kummerCharZMod_eq_zero_iff_apply_sqrt
        (K := κ) p hζ b σ₁).mp h0)
  -- Step 9: contradict the hypothesis
  exact hχ (hb σ₁ ((Work.SSGRoute.mem_inertiaSub κ Ω B σ₁).mp hσ₁mem))

/-- **A one-place idèle over a prime at which the Kummer character kills the inertia lies in
`U' = gesU κ p T' ⊔ C_κ^p`.**

The Kummer character of `b` vanishing on the inertia of `B` means that `κ(b^{1/p})/κ` is unramified
at `𝔮`, hence that the `𝔮`-adic valuation of `b` is divisible by `p`
(`dvd_log_of_kummerChar_eq_zero_on_inertia`), which is the input of the assembly
`onePlace_mem_gesU_sup_pPow_of_dvd_log`. -/
theorem onePlace_mem_gesU_of_kummerChar_eq_zero_on_inertia (p : ℕ) [Fact p.Prime]
    {κ Ω : Type} [Field κ] [NumberField κ] [Field Ω] [Algebra κ Ω]
    [IsAlgClosure κ Ω] [IsAlgClosed Ω]
    (ζ : κ) (hζ : IsPrimitiveRoot ζ p)
    (T' : Finset (NK.Chebotarev.PrimeIdeal κ))
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace κ B)
    (𝔮 : NK.Chebotarev.PrimeIdeal κ)
    (h𝔮 : B.comap (algebraMap κ Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime κ 𝔮)
    (h𝔮T : 𝔮 ∉ T')
    (hp : ¬ B.valuation (p : Ω) < 1)
    (b : κˣ)
    (hb : ∀ σ : Ω ≃ₐ[κ] Ω, SSGRoute.IsInertia (k := κ) B σ →
      Work.SSGRoute.kummerCharZMod (K := κ) (Ω := Ω) p (ζ := ζ) hζ b σ = 0) :
    NK.GlobalCFT.IdeleClassGroup.mk κ (NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofFinite 𝔮)
        (NK.CFTLib.IdeleHasse.localImageAt (K := κ) (NK.GlobalCFT.Place.ofFinite 𝔮) b)) ∈
      Work.SSGRoute.GrunwaldEscapeCore.gesU κ p T' ⊔
        Work.SSGRoute.EscapeCoreLib.pPowSubgroup p (NK.GlobalCFT.IdeleClassGroup κ) := by
  exact onePlace_mem_gesU_sup_pPow_of_dvd_log p T' 𝔮 h𝔮T b
    (dvd_log_of_kummerChar_eq_zero_on_inertia_aux p ζ hζ B hB 𝔮 h𝔮 b hb)

end Work.GrunwaldEscapeCore
