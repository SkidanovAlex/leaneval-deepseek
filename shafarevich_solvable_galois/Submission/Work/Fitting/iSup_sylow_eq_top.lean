namespace Work.Fitting

set_option linter.style.haveILetI false

/-- **A finite nilpotent group is generated by its Sylow subgroups.**  More precisely, the
supremum of (a choice of) the Sylow `p`-subgroups, over all primes `p` dividing the order of the
group, is the whole group. -/
theorem iSup_sylow_eq_top {M : Type*} [Group M] [Finite M] [Group.IsNilpotent M] :
    (⨆ p : (Nat.card M).primeFactors, ((default : Sylow (p : ℕ) M) : Subgroup M)) = ⊤ := by
  classical
  have hcard_ne : Nat.card M ≠ 0 := Nat.card_pos.ne'
  -- Distinct Sylow subgroups commute elementwise.
  have hcomm : Pairwise fun p q : (Nat.card M).primeFactors =>
      ∀ x y : M, x ∈ ((default : Sylow (p : ℕ) M) : Subgroup M) →
        y ∈ ((default : Sylow (q : ℕ) M) : Subgroup M) → Commute x y := by
    rintro p q hpq x y hx hy
    haveI hp : Fact (p : ℕ).Prime := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    haveI hq : Fact (q : ℕ).Prime := ⟨Nat.prime_of_mem_primeFactors q.2⟩
    exact Subgroup.commute_of_normal_of_disjoint _ _
      (inferInstance : ((default : Sylow (p : ℕ) M) : Subgroup M).Normal)
      (inferInstance : ((default : Sylow (q : ℕ) M) : Subgroup M).Normal)
      (IsPGroup.disjoint_of_ne (p : ℕ) (q : ℕ) (fun h => hpq (Subtype.ext h)) _ _
        (default : Sylow (p : ℕ) M).isPGroup' (default : Sylow (q : ℕ) M).isPGroup')
      x y hx hy
  haveI hF : ∀ p : (Nat.card M).primeFactors,
      Fintype ↥((default : Sylow (p : ℕ) M) : Subgroup M) := fun p => Fintype.ofFinite _
  -- The Sylow subgroups are independent, because their orders are pairwise coprime.
  have hind : iSupIndep (fun p : (Nat.card M).primeFactors =>
      ((default : Sylow (p : ℕ) M) : Subgroup M)) := by
    apply Subgroup.independent_of_coprime_order hcomm
    intro p q hpq
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card]
    haveI hp : Fact (p : ℕ).Prime := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    haveI hq : Fact (q : ℕ).Prime := ⟨Nat.prime_of_mem_primeFactors q.2⟩
    exact IsPGroup.coprime_card_of_ne _ _ (fun h => hpq (Subtype.ext h)) _ _
      (default : Sylow (p : ℕ) M).isPGroup' (default : Sylow (q : ℕ) M).isPGroup'
  have hinj : Function.Injective
      (Subgroup.noncommPiCoprod (H := fun p : (Nat.card M).primeFactors =>
        ((default : Sylow (p : ℕ) M) : Subgroup M)) hcomm) :=
    Subgroup.injective_noncommPiCoprod_of_iSupIndep hind
  have hrange : (Subgroup.noncommPiCoprod (H := fun p : (Nat.card M).primeFactors =>
        ((default : Sylow (p : ℕ) M) : Subgroup M)) hcomm).range =
      ⨆ p : (Nat.card M).primeFactors, ((default : Sylow (p : ℕ) M) : Subgroup M) :=
    Subgroup.noncommPiCoprod_range
  -- The order of the group is the product of the orders of the Sylow subgroups.
  have hcardpi : Nat.card ((p : (Nat.card M).primeFactors) →
        ↥((default : Sylow (p : ℕ) M) : Subgroup M)) = Nat.card M := by
    rw [Nat.card_pi]
    rw [Finset.prod_congr rfl (fun a _ => by
      haveI : Fact (a : ℕ).Prime := ⟨Nat.prime_of_mem_primeFactors a.2⟩
      exact Sylow.card_eq_multiplicity (default : Sylow (a : ℕ) M))]
    exact (Finset.prod_finset_coe (fun i => i ^ (Nat.card M).factorization i)
        (Nat.card M).primeFactors).trans (Nat.prod_factorization_pow_eq_self hcard_ne)
  -- Hence the subgroup generated by the Sylow subgroups has full order, so it is everything.
  have hcard : Nat.card ↥(⨆ p : (Nat.card M).primeFactors,
      ((default : Sylow (p : ℕ) M) : Subgroup M)) = Nat.card M := by
    rw [← hrange]
    rw [Nat.card_eq_fintype_card, Fintype.card_coeSort_range hinj, ← Nat.card_eq_fintype_card]
    exact hcardpi
  exact Subgroup.eq_top_of_card_eq _ hcard

end Work.Fitting
