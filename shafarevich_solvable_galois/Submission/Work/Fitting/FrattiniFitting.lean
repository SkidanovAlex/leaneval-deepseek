# Preimages of normal `p`-subgroups of `G ⧸ M` lie in the Fitting subgroup

If `M ◁ G` with `M ≤ Φ(G)`, then the preimage in `G` of any normal `p`-subgroup of `G ⧸ M` is
contained in the Fitting subgroup `F(G)`:

* `Work.Fitting.le_fitting_of_isPGroup_comap`.

This is the technical heart of the Frattini–Fitting lemma
`Work.Fitting.isNilpotent_of_isNilpotent_map_quotient`: if `M ≤ Φ(G)` and `H/M` is nilpotent then
`H` is nilpotent.  Indeed, `H/M` is generated by the images of the `K_p := (Syl_p(H/M))` preimages
(`K_p ≤ F(G)` by the lemma above) and `H ≤ (⨆_p K_p) ⊔ M ≤ F(G)`.
-/
import Mathlib
import Submission.Work.Fitting.Basic
import Submission.Work.Fitting.PCore
import Submission.Work.Fitting.FittingEqPCore
import Submission.Work.Fitting.iSup_sylow_eq_top
import Submission.Work.Fitting.sup_sylow_eq_top_of_isPGroup_quotient
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.Fitting

set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000
open scoped Classical
open Subgroup

/-- The preimage in `G` of a normal `p`-subgroup of `G ⧸ M` is contained in `F(G)`, provided
`M ≤ Φ(G)`. -/
theorem le_fitting_of_isPGroup_comap {G : Type*} [Group G] [Finite G] (M : Subgroup G) [M.Normal]
    (hMΦ : M ≤ frattini G) {p : ℕ} [Fact (Nat.Prime p)] (Pbar : Subgroup (G ⧸ M))
    (hPn : Pbar.Normal) (hP : IsPGroup p ↥Pbar) :
    Pbar.comap (QuotientGroup.mk' M) ≤ fitting G := by
  classical
  set K : Subgroup G := Pbar.comap (QuotientGroup.mk' M) with hK
  have hMK : M ≤ K := by
    intro x hx
    rw [hK, Subgroup.mem_comap, QuotientGroup.mk'_apply, (QuotientGroup.eq_one_iff x).mpr hx]
    exact one_mem _
  haveI hKn : K.Normal := hPn.comap _
  have hmap : K.map (QuotientGroup.mk' M) = Pbar := by
    rw [hK]
    exact Subgroup.map_comap_eq_self (by
      rw [MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective M)]
      exact le_top)
  -- `K/M` is a `p`-group
  have hPK : IsPGroup p (↥K ⧸ M.subgroupOf K) := by
    refine (IsPGroup.iff_card).mpr ?_
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card).mp hP
    refine ⟨n, ?_⟩
    have hcard : Nat.card (↥K ⧸ M.subgroupOf K) = Nat.card ↥Pbar := by
      rw [← Subgroup.index_eq_card (M.subgroupOf K)]
      have h1 : (M.subgroupOf K).index = M.relIndex K := rfl
      have h2 : M.relIndex K = (QuotientGroup.mk' M).ker.relIndex K := by
        rw [QuotientGroup.ker_mk']
      have h3 : (QuotientGroup.mk' M).ker.relIndex K
          = Nat.card ↥(K.map (QuotientGroup.mk' M)) :=
        Subgroup.relIndex_ker K (QuotientGroup.mk' M)
      rw [h1, h2, h3, hmap]
    rw [hcard]
    exact hn
  -- a Sylow `p`-subgroup `Q` of `K`
  set Q : Sylow p ↥K := default
  -- `K = M ⊔ Q` by `sup_sylow_eq_top_of_isPGroup_quotient`
  have hamb : K = M ⊔ (Q : Subgroup ↥K).map K.subtype := by
    have hsplit : M.subgroupOf K ⊔ (Q : Subgroup ↥K) = ⊤ :=
      sup_sylow_eq_top_of_isPGroup_quotient (M.subgroupOf K) hPK Q
    have htop : Subgroup.map K.subtype (⊤ : Subgroup ↥K) = K := by
      rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
    have hM : Subgroup.map K.subtype (M.subgroupOf K) = M :=
      Subgroup.map_subgroupOf_eq_of_le hMK
    have h := congrArg (Subgroup.map K.subtype) hsplit
    rw [Subgroup.map_sup, hM, htop] at h
    exact h.symm
  -- the Frattini argument: `Q` is normal in `G`
  have hQn : ((Q : Subgroup ↥K).map K.subtype).Normal := by
    refine normalizer_eq_top_iff.mp (frattini_nongenerating ?_)
    have hfr : normalizer ↑((Q : Subgroup ↥K).map K.subtype) ⊔ K = ⊤ :=
      Sylow.normalizer_sup_eq_top Q
    have hKle : K ≤ normalizer ↑((Q : Subgroup ↥K).map K.subtype) ⊔ frattini G :=
      hamb.le.trans (sup_le (hMΦ.trans le_sup_right) (le_normalizer.trans le_sup_left))
    have : (⊤ : Subgroup G) ≤ normalizer ↑((Q : Subgroup ↥K).map K.subtype) ⊔ frattini G := by
      rw [← hfr]
      exact sup_le le_sup_left hKle
    exact top_le_iff.mp this
  rw [hamb]
  refine sup_le (hMΦ.trans frattini_le_fitting) ?_
  exact le_fitting hQn (IsPGroup.isNilpotent (IsPGroup.map Q.isPGroup' K.subtype))

end Work.Fitting
