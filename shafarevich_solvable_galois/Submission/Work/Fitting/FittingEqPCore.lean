namespace Work.Fitting

set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000
open scoped Classical
open Subgroup

variable {G : Type*} [Group G]

/-- A nilpotent normal subgroup `X` of a finite group `G` is contained in the join of the
`p`-cores `O_p(G)`, for `p` running over the prime divisors of `|X|`: a finite nilpotent group
is generated by its (normal in `G`) Sylow subgroups, and each of these is a normal `p`-subgroup
of `G`. -/
theorem le_iSup_pCore_of_isNilpotent_normal [Finite G] (X : Subgroup G) [X.Normal]
    [Group.IsNilpotent X] :
    X ≤ ⨆ p : (Nat.card X).primeFactors, pCore (p : ℕ) G := by
  have key : ∀ p : (Nat.card X).primeFactors,
      ((default : Sylow (p : ℕ) X) : Subgroup X).map X.subtype ≤ pCore (p : ℕ) G := by
    intro p
    haveI hp : Fact (Nat.Prime (p : ℕ)) := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    haveI : Unique (Sylow (p : ℕ) X) :=
      Sylow.unique_of_normal (default : Sylow (p : ℕ) X) inferInstance
    haveI : ((default : Sylow (p : ℕ) X) : Subgroup X).Characteristic :=
      Sylow.characteristic_of_subsingleton _
    exact le_pCore (Subgroup.map_subtype_normal_of_characteristic (M := X)
      (H := ((default : Sylow (p : ℕ) X) : Subgroup X)))
      (IsPGroup.map (default : Sylow (p : ℕ) X).isPGroup' X.subtype)
  intro x hx
  have h1 : (⟨x, hx⟩ : X) ∈ ⨆ p : (Nat.card X).primeFactors,
      ((default : Sylow (p : ℕ) X) : Subgroup X) := by
    rw [iSup_sylow_eq_top]
    trivial
  have h2 : x ∈ ⨆ p : (Nat.card X).primeFactors,
      ((default : Sylow (p : ℕ) X) : Subgroup X).map X.subtype := by
    have := Subgroup.mem_map_of_mem X.subtype h1
    rwa [Subgroup.map_iSup] at this
  exact (iSup_mono key) h2

/-- The Fitting subgroup of a finite group is the join of its `p`-cores. -/
theorem fitting_eq_iSup_pCore (G : Type*) [Group G] [Finite G] :
    fitting G = ⨆ p : (Nat.card G).primeFactors, pCore (p : ℕ) G := by
  refine le_antisymm ?_ ?_
  · refine (fitting_le_iff (G := G) (H := ⨆ p : (Nat.card G).primeFactors,
      pCore (p : ℕ) G)).mpr fun N hN hnil => ?_
    have hsub : (Nat.card N).primeFactors ⊆ (Nat.card G).primeFactors :=
      Nat.primeFactors_mono (Subgroup.card_subgroup_dvd_card N) (Nat.card_pos.ne')
    refine (le_iSup_pCore_of_isNilpotent_normal (G := G) N).trans (iSup_le fun p => ?_)
    exact le_iSup (fun q : (Nat.card G).primeFactors => pCore (q : ℕ) G) ⟨p.1, hsub p.2⟩
  · refine iSup_le fun p => ?_
    haveI : Fact (Nat.Prime (p : ℕ)) := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    exact pCore_le_fitting (p : ℕ)

/-- **The Fitting subgroup is nilpotent.**  Together with `le_fitting` this says that `fitting G`
is the largest nilpotent normal subgroup of a finite group `G`. -/
theorem fitting_nilpotent (G : Type*) [Group G] [Finite G] : Group.IsNilpotent (fitting G) := by
  haveI : ∀ p : (Nat.card G).primeFactors, (pCore (p : ℕ) G).Normal := fun p => pCore_normal _
  have h : Group.IsNilpotent ↥(⨆ p : (Nat.card G).primeFactors, pCore (p : ℕ) G) :=
    isNilpotent_iSup_of_normal_pgroups (G := G) (ι := (Nat.card G).primeFactors)
      (fun p => (p : ℕ)) (fun p => Nat.prime_of_mem_primeFactors p.2)
      (fun p q hpq hcon => hpq (Subtype.ext hcon)) (fun p => pCore (p : ℕ) G)
      (fun p => pCore_isPGroup _)
  rw [fitting_eq_iSup_pCore]
  exact h

end Work.Fitting
