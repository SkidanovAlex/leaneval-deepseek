open scoped commutatorElement

namespace Work.Fitting

/-- The subgroup generated by a finite family of normal subgroups `H i`, where `H i` is a `p i`-group
and the primes `p i` are pairwise distinct, is nilpotent.

The proof shows that the `H i` are pairwise commuting normal subgroups of pairwise coprime order,
so that the canonical map `(∀ i, H i) →* G` is injective with image `⨆ i, H i`; this identifies
`⨆ i, H i` with the direct product of the (nilpotent) `p`-groups `H i`. -/
theorem isNilpotent_iSup_of_normal_pgroups {G : Type*} [Group G] [Finite G] {ι : Type*}
    [Fintype ι] (p : ι → ℕ) (hp : ∀ i, (p i).Prime) (hne : ∀ i j, i ≠ j → p i ≠ p j)
    (H : ι → Subgroup G) [∀ i, (H i).Normal] (hH : ∀ i, IsPGroup (p i) (H i)) :
    Group.IsNilpotent ↥(⨆ i, H i) := by
  have hfin : ∀ i, Fintype ↥(H i) := fun i => Fintype.ofFinite _
  -- Distinct `p i`-groups are pairwise disjoint, hence (being normal) pairwise commuting.
  have hcomm : Pairwise fun i j : ι => ∀ x y : G, x ∈ H i → y ∈ H j → Commute x y := by
    intro i j hij x y hx hy
    have hdisj : Disjoint (H i) (H j) :=
      IsPGroup.disjoint_of_coprime (hH i) (hH j)
        (Nat.coprime_primes (hp i) (hp j) |>.mpr (hne i j hij))
    rw [← commutatorElement_eq_one_iff_commute]
    have hmem : ⁅x, y⁆ ∈ H i ⊓ H j :=
      Subgroup.commutator_le_inf (H i) (H j) (Subgroup.commutator_mem_commutator hx hy)
    exact Subgroup.mem_bot.mp (hdisj.eq_bot ▸ hmem)
  -- Their orders are pairwise coprime.
  have hcoprime : Pairwise fun i j : ι => Nat.Coprime (Fintype.card (H i)) (Fintype.card (H j)) := by
    intro i j hij
    obtain ⟨n, hn⟩ := isPGroup_iff_card_dvd_pow.mp (hH i)
    obtain ⟨m, hm⟩ := isPGroup_iff_card_dvd_pow.mp (hH j)
    rw [Nat.card_eq_fintype_card] at hn hm
    exact ((Nat.coprime_pow_primes n m (hp i) (hp j) (hne i j hij)).coprime_dvd_left hn).coprime_dvd_right hm
  have hind : iSupIndep H := Subgroup.independent_of_coprime_order hcomm hcoprime
  -- The canonical map from the direct product is injective with image `⨆ i, H i`.
  have hf_range : (Subgroup.noncommPiCoprod hcomm).range = ⨆ i, H i :=
    Subgroup.noncommPiCoprod_range
  have hf_inj : Function.Injective (Subgroup.noncommPiCoprod hcomm) :=
    Subgroup.injective_noncommPiCoprod_of_iSupIndep hind
  let g : (∀ i, H i) →* ↥(⨆ i, H i) :=
    (Subgroup.noncommPiCoprod hcomm).codRestrict (⨆ i, H i)
      (fun x => hf_range ▸ MonoidHom.mem_range.mpr ⟨x, rfl⟩)
  have hg_bij : Function.Bijective g := by
    constructor
    · intro a b hab
      exact hf_inj (Subtype.ext_iff.mp hab)
    · intro y
      have hy : (y : G) ∈ (Subgroup.noncommPiCoprod hcomm).range := by
        rw [hf_range]; exact y.property
      obtain ⟨x, hx⟩ := MonoidHom.mem_range.mp hy
      exact ⟨x, Subtype.ext hx⟩
  -- Each `H i` is nilpotent, hence so is the finite product `∀ i, H i`.
  have hnil : ∀ i, Group.IsNilpotent ↥(H i) := by
    intro i
    have hpi : Fact (p i).Prime := ⟨hp i⟩
    exact (hH i).isNilpotent
  exact (Group.isNilpotent_congr (MulEquiv.ofBijective g hg_bij)).mp inferInstance

end Work.Fitting
