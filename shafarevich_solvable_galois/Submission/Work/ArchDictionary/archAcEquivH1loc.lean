namespace Work.ArchDictionary

theorem archAcEquivH1loc (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] (E : Type) [AddCommGroup E] [Module (ZMod p) E]
    [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    ∃ e : Work.SSGRoute.ArchDictionary.Ac (K := K) (E := E) c ≃+
        Work.SSGRoute.H1loc p k Ω K E (Subgroup.zpowers c),
      ∀ (b : (Ω ≃ₐ[k] Ω) → E) (hb : b ∈ Work.SSGRoute.ArchDictionary.Zc (K := K) (E := E) c),
        e (Work.SSGRoute.ArchDictionary.Acπ (K := K) (E := E) c ⟨b, hb⟩)
          = Work.SSGRoute.toClass p k Ω K E (Subgroup.zpowers c) b := by
  classical
  -- On the cyclic subgroup generated by an involution every cochain is locally constant,
  -- so the two versions of `H¹(⟨c⟩,E)` (all cocycles vs. locally constant cocycles) coincide.
  let lc := Work.SSGRoute.lcCocycles p k Ω K E (Subgroup.zpowers c)
  let cb := Work.SSGRoute.coboundaries p k Ω K E (Subgroup.zpowers c)
  let den := Submodule.comap (lc : Submodule (ZMod p) ((Ω ≃ₐ[k] Ω) → E)).subtype cb
  -- The inclusion of the cocycles `Z¹(⟨c⟩,E)` into the locally constant cocycles.
  let toLc : ↥(Work.SSGRoute.ArchDictionary.Zc K E c) →+ ↥lc :=
    { toFun := fun b => ⟨(b : (Ω ≃ₐ[k] Ω) → E), by
        rw [Work.SSGRoute.mem_lcCocycles]
        exact ⟨b.2, Work.SSGRoute.E7Arch.isLocConstOn_zpowers_arch c hc (b : (Ω ≃ₐ[k] Ω) → E)⟩⟩
      map_zero' := by apply Subtype.ext; rfl
      map_add' := by intro a b; apply Subtype.ext; rfl }
  have htoLc : ∀ b, (toLc b : (Ω ≃ₐ[k] Ω) → E) = (b : (Ω ≃ₐ[k] Ω) → E) := fun b => rfl
  -- The composite cocycles → locally constant cocycles → `H¹`.
  let Φ : ↥(Work.SSGRoute.ArchDictionary.Zc K E c) →+
      Work.SSGRoute.H1loc p k Ω K E (Subgroup.zpowers c) :=
    (Submodule.mkQ den).toAddMonoidHom.comp toLc
  have hΦ : ∀ b, Φ b = (Submodule.mkQ den) (toLc b) := fun b => rfl
  -- Its kernel is exactly the group of coboundaries.
  have hker : Φ.ker = Work.SSGRoute.ArchDictionary.Bc K E c := by
    ext b
    rw [AddMonoidHom.mem_ker, hΦ, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      Submodule.mem_comap]
    change (toLc b : (Ω ≃ₐ[k] Ω) → E) ∈ cb ↔ b ∈ Work.SSGRoute.ArchDictionary.Bc K E c
    rw [htoLc b, Work.SSGRoute.mem_coboundaries, Work.SSGRoute.ArchDictionary.mem_Bc]
  -- And it is surjective: every locally constant cocycle is a cocycle on `⟨c⟩`.
  have hsurj : Function.Surjective Φ := by
    intro y
    obtain ⟨x, hx⟩ := Submodule.Quotient.mk_surjective (p := den) y
    have hx2 : (x : (Ω ≃ₐ[k] Ω) → E) ∈ Work.SSGRoute.ArchDictionary.Zc K E c := by
      rw [Work.SSGRoute.ArchDictionary.mem_Zc]
      exact ((Work.SSGRoute.mem_lcCocycles p k Ω K E (Subgroup.zpowers c)
        (x : (Ω ≃ₐ[k] Ω) → E)).mp x.2).1
    refine ⟨⟨(x : (Ω ≃ₐ[k] Ω) → E), hx2⟩, ?_⟩
    rw [hΦ]
    have htoLcx : toLc ⟨(x : (Ω ≃ₐ[k] Ω) → E), hx2⟩ = x := Subtype.ext rfl
    rw [htoLcx, Submodule.mkQ_apply, hx]
  -- Factor `Φ` through the quotient `Z¹/B¹ = Ac`.
  let f : Work.SSGRoute.ArchDictionary.Ac (K := K) (E := E) c →+
      Work.SSGRoute.H1loc p k Ω K E (Subgroup.zpowers c) :=
    QuotientAddGroup.lift (Work.SSGRoute.ArchDictionary.Bc K E c) Φ hker.ge
  have hf_mk : ∀ x, f (QuotientAddGroup.mk' (Work.SSGRoute.ArchDictionary.Bc K E c) x) = Φ x :=
    fun x => QuotientAddGroup.lift_mk' _ _ x
  have hinj : Function.Injective f := by
    intro x y hxy
    obtain ⟨x0, rfl⟩ := QuotientAddGroup.mk'_surjective (Work.SSGRoute.ArchDictionary.Bc K E c) x
    obtain ⟨y0, rfl⟩ := QuotientAddGroup.mk'_surjective (Work.SSGRoute.ArchDictionary.Bc K E c) y
    rw [hf_mk, hf_mk] at hxy
    rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_iff_sub_mem]
    have hmem : x0 - y0 ∈ Φ.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, hxy, sub_self]
    rwa [hker] at hmem
  have hsurjf : Function.Surjective f := by
    intro y
    obtain ⟨x, hx⟩ := hsurj y
    exact ⟨QuotientAddGroup.mk' (Work.SSGRoute.ArchDictionary.Bc K E c) x, by rw [hf_mk, hx]⟩
  refine ⟨AddEquiv.ofBijective f ⟨hinj, hsurjf⟩, ?_⟩
  intro b hb
  change f (QuotientAddGroup.mk' (Work.SSGRoute.ArchDictionary.Bc K E c) ⟨b, hb⟩)
    = Work.SSGRoute.toClass p k Ω K E (Subgroup.zpowers c) b
  rw [hf_mk, hΦ]
  have hblc : b ∈ lc := by
    rw [Work.SSGRoute.mem_lcCocycles]
    exact ⟨hb, Work.SSGRoute.E7Arch.isLocConstOn_zpowers_arch c hc b⟩
  rw [Work.SSGRoute.toClass, dif_pos hblc]
  congr 1

end Work.ArchDictionary
