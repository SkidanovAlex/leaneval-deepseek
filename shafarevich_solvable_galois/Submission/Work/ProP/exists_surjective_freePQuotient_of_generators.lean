namespace Work.ProP

/-- **Every finite `p`-group generated by `n` elements is a quotient of `F^(n)/F^(n)(ν)` for
some `ν`** — the user-facing form of the generic kernel statement, with the surjection not
assumed but built from a generating family.

Proof: `FreeGroup.lift x : FreeGroup (Fin n) →* P` is surjective because its range contains
`Set.range x`, whose closure is `⊤` (Mathlib's
`FreeGroup.lift_surjective_iff_closure_range_eq_top` gives this directly from `hgen`); then apply
`Work.ProP.exists_surjective_freePQuotient`. -/
theorem exists_surjective_freePQuotient_of_generators {p n : ℕ} [Fact p.Prime] {P : Type*}
    [Group P] [Finite P] (hP : IsPGroup p P) (x : Fin n → P)
    (hgen : Subgroup.closure (Set.range x) = ⊤) :
    ∃ (ν : ℕ) (f : FreePQuotient p n ν →* P), Function.Surjective f :=
  exists_surjective_freePQuotient (p := p) n hP (FreeGroup.lift x)
    (FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr hgen)

end Work.ProP
