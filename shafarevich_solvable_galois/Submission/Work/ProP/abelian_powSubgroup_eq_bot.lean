/-- The `p`-th power subgroup of `N ≤ Q` is the image, under the inclusion `↥N → Q`, of the
`p`-th power subgroup of the group `↥N`. -/
theorem powSubgroup_eq_map_subtype {Q : Type*} [Group Q] (p : ℕ) (N : Subgroup Q) :
    Work.Shrinking.powSubgroup p N =
      Subgroup.map N.subtype (Work.Shrinking.powSubgroup p (⊤ : Subgroup ↥N)) := by
  rw [Work.Shrinking.powSubgroup, Work.Shrinking.powSubgroup, MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨(⟨x, hx⟩ : ↥N) ^ p, ⟨⟨x, hx⟩, trivial, rfl⟩, by simp⟩
  · rintro ⟨z, ⟨w, -, hw⟩, hzy⟩
    exact ⟨(w : Q), w.2, by rw [← hzy, ← hw]; simp⟩

/-- A nontrivial finite group `V` (of exponent a power of `p`) whose multiplication is
commutative has a proper `p`-th power subgroup: `V ^ p ≠ V`.

Commutativity is passed as an explicit hypothesis `hcomm` (rather than through a `CommGroup`
instance) so that the statement is about the *given* group structure on `V`. -/
theorem powSubgroup_top_ne_top_of_comm {p : ℕ} [Fact p.Prime] {V : Type*} [Group V]
    (hcomm : ∀ a b : V, a * b = b * a) [Finite V] (hV : IsPGroup p V) (hne : Nontrivial V) :
    Work.Shrinking.powSubgroup p (⊤ : Subgroup V) ≠ ⊤ := by
  intro htop
  -- the `p`-th power map is an endomorphism because `V` is commutative
  let φ : V →* V :=
    { toFun := fun x => x ^ p
      map_one' := one_pow p
      map_mul' := fun a b => Commute.mul_pow (hcomm a b) p }
  -- `powSubgroup p ⊤` is precisely its range
  have hrange : Work.Shrinking.powSubgroup p (⊤ : Subgroup V) = φ.range := by
    refine le_antisymm ?_ ?_
    · unfold Work.Shrinking.powSubgroup
      rw [Subgroup.closure_le]
      rintro x ⟨y, -, rfl⟩
      exact MonoidHom.mem_range.mpr ⟨y, rfl⟩
    · intro x hx
      obtain ⟨y, rfl⟩ := MonoidHom.mem_range.mp hx
      show (fun x : V => x ^ p) y ∈
        Subgroup.closure ((fun x : V => x ^ p) '' (⊤ : Subgroup V))
      exact Subgroup.subset_closure ⟨y, trivial, rfl⟩
  -- surjective, hence (as `V` is finite) injective
  have hsurj : Function.Surjective φ := by
    rw [← MonoidHom.range_eq_top, ← hrange]
    exact htop
  have hinj : Function.Injective φ := Finite.injective_iff_surjective.mpr hsurj
  -- Cauchy's theorem provides an element of order `p`, which would lie in the kernel
  obtain ⟨n, hn, hcard⟩ := (hV.nontrivial_iff_card).mp hne
  have hdvd : p ∣ Nat.card V := by
    rw [hcard]
    exact dvd_pow_self p (Nat.pos_iff_ne_zero.mp hn)
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' p hdvd
  have hg1 : g ≠ 1 := (orderOf_eq_prime_iff.mp hg).2
  have hgpow : g ^ p = 1 := (orderOf_eq_prime_iff.mp hg).1
  have hφg : φ g = φ 1 := by
    change g ^ p = 1 ^ p
    rw [hgpow, one_pow]
  exact hg1 (hinj hφg)

/-- Every nontrivial finite `p`-group `N` (here a subgroup of a group `Q` lying in the centre,
so that `N` is commutative) satisfies `N^p < N`: if the subgroup generated by the `p`-th powers
of `N` equals `N`, then `N` is trivial. -/
theorem abelian_powSubgroup_eq_bot {p : ℕ} [Fact p.Prime] {Q : Type*} [Group Q]
    (N : Subgroup Q) [Finite ↥N] (hQ : IsPGroup p ↥N) (hZ : N ≤ Subgroup.center Q)
    (h : Work.Shrinking.powSubgroup p N = N) : N = ⊥ := by
  -- `↥N` is commutative, because `N` lies in the centre of `Q`.
  have hcommN : ∀ a b : ↥N, a * b = b * a := fun a b =>
    Subtype.ext ((Subgroup.mem_center_iff.mp (hZ a.2) b).symm)
  -- The `p`-th power subgroup of `↥N` is all of `↥N`.
  have htop : Work.Shrinking.powSubgroup p (⊤ : Subgroup ↥N) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : N.subtype x ∈ Subgroup.map N.subtype
        (Work.Shrinking.powSubgroup p (⊤ : Subgroup ↥N)) := by
      rw [← powSubgroup_eq_map_subtype p N, h]
      exact x.2
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    rwa [Subgroup.subtype_injective N hyx] at hy
  -- A nontrivial finite commutative `p`-group has proper `p`-th power subgroup.
  have hne : ¬ Nontrivial ↥N := fun hnt => powSubgroup_top_ne_top_of_comm hcommN hQ hnt htop
  haveI : Subsingleton ↥N := not_nontrivial_iff_subsingleton.mp hne
  exact Subgroup.eq_bot_of_subsingleton N

end Work.ProP
