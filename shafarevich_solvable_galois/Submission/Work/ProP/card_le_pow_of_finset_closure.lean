namespace Work.ProP

/-- A commutative group of exponent dividing `p` that is generated by `S` has at most `p ^ #S`
elements (a product of `#S` cyclic subgroups of order dividing `p`).

Proof: `Group.FG H` holds because `S` is a finite generating set (`Group.fg_iff'`), and
`Group.rank H ≤ S.card` (`Group.rank_le` applied to `hS`).  By `card_dvd_exponent_pow_rank'`,
`Nat.card H ∣ p ^ Group.rank H`; hence `Nat.card H ∣ p ^ S.card`, so `Nat.card H ≤ p ^ S.card`. -/
theorem card_le_pow_of_finset_closure {p : ℕ} (hp : 0 < p) {H : Type*} [CommGroup H] (S : Finset H)
    (hS : Subgroup.closure (S : Set H) = ⊤) (hexp : ∀ x : H, x ^ p = 1) :
    Nat.card H ≤ p ^ S.card := by
  have : Group.FG H := (Group.fg_iff').mpr ⟨S.card, S, rfl, hS⟩
  have hrank : Group.rank H ≤ S.card := Group.rank_le hS
  have hdvd : Nat.card H ∣ p ^ S.card :=
    (card_dvd_exponent_pow_rank' H hexp).trans (pow_dvd_pow p hrank)
  exact Nat.le_of_dvd (pow_pos hp _) hdvd

end Work.ProP
