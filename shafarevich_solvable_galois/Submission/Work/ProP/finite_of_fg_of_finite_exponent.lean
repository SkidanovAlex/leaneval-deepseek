namespace Work.ProP

/-- Auxiliary form of the main result, generalized over the nilpotency class so that we can run
strong induction.  `aux k` says: every finitely generated nilpotent group of nilpotency class `k`
and of finite exponent is finite. -/
private theorem aux_finite_of_fg_of_finite_exponent :
    ∀ k, (∀ (G : Type*) [Group G], Group.FG G → Group.IsNilpotent G →
      Group.nilpotencyClass G = k → ∀ n, 0 < n → (∀ g : G, g ^ n = 1) → Finite G) := by
  intro k
  refine Nat.strong_induction_on k ?_
  intro k ih G _ hG hN hk n hnpos hn
  rcases Nat.eq_zero_or_pos k with hk0 | hkpos
  · -- nilpotency class `0` means the group is a subsingleton
    have h0 : Group.nilpotencyClass G = 0 := by rw [hk, hk0]
    haveI : Subsingleton G := (Group.nilpotencyClass_zero_iff_subsingleton).mp h0
    exact Finite.of_subsingleton
  · -- main case: induct on the quotient by the center
    have hquot_class : Group.nilpotencyClass (G ⧸ Subgroup.center G) = k - 1 := by
      rw [Group.nilpotencyClass_quotient_center, hk]
    have hquot_exp : ∀ x : G ⧸ Subgroup.center G, x ^ n = 1 := by
      intro x
      induction x using QuotientGroup.induction_on with
      | H g => rw [← QuotientGroup.mk_pow (Subgroup.center G) g n, hn g]; rfl
    have hquot_fin : Finite (G ⧸ Subgroup.center G) :=
      ih (k - 1) (by omega) (G ⧸ Subgroup.center G) (by infer_instance) (by infer_instance)
        hquot_class n hnpos hquot_exp
    haveI : Finite (G ⧸ Subgroup.center G) := hquot_fin
    -- the center has finite index
    have hZindex : (Subgroup.center G).FiniteIndex :=
      Subgroup.finiteIndex_of_finite_quotient
    haveI : (Subgroup.center G).FiniteIndex := hZindex
    -- and the center is finite: it is abelian, finitely generated and of exponent dividing `n`
    have hZfin : Finite (Subgroup.center G) := by
      letI : CommGroup (Subgroup.center G) :=
        { (inferInstance : Group (Subgroup.center G)) with
          mul_comm := fun a b => Subtype.ext (Subgroup.mem_center_iff.mp b.2 a.1) }
      haveI : Group.FG (Subgroup.center G) := Subgroup.fg_of_index_ne_zero _
      have hcard : Nat.card (Subgroup.center G) ∣ n ^ Group.rank (Subgroup.center G) :=
        card_dvd_exponent_pow_rank' (G := Subgroup.center G) (fun z => Subtype.ext (hn z.1))
      exact Nat.finite_of_card_ne_zero
        (Nat.pos_iff_ne_zero.mp (Nat.pos_of_dvd_of_pos hcard (pow_pos hnpos _)))
    exact (Subgroup.finite_iff_finite_and_finiteIndex (Subgroup.center G)).mpr ⟨hZfin, hZindex⟩

/-- A finitely generated nilpotent group of finite exponent is finite.

Proof by strong induction on `Group.nilpotencyClass G` (using
`Group.nilpotencyClass_quotient_center` for the descent and
`Subgroup.lowerCentralSeries_eq_bot_iff_nilpotencyClass_le` to recognise the class):
`G ⧸ center G` is finitely generated (`Group.FG.quotient`), nilpotent of smaller class and of
exponent dividing `n`, hence finite by induction; so `center G` has finite index in `G` and is
finitely generated by Schreier's result (`Subgroup.fg_of_index_ne_zero`); being abelian with
exponent dividing `n` it is finite by `card_dvd_exponent_pow_rank` (which gives
`Nat.card Z ∣ Monoid.exponent Z ^ Group.rank Z`, and `Monoid.exponent Z ∣ n`); finally `G` is
finite because it is an extension of a finite group by a finite group
(`Subgroup.card_eq_card_quotient_mul_card_subgroup`). -/
theorem finite_of_fg_of_finite_exponent {G : Type*} [Group G] (hG : Group.FG G)
    (hN : Group.IsNilpotent G) {n : ℕ} (hnpos : 0 < n) (hn : ∀ g : G, g ^ n = 1) : Finite G :=
  aux_finite_of_fg_of_finite_exponent (Group.nilpotencyClass G) G hG hN rfl n hnpos hn

end Work.ProP
