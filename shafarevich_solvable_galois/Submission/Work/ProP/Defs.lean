namespace Work.ProP

universe u

/-! ## The finite quotients of the free group -/

/-- Every term of the descending `p`-central series of `FreeGroup (Fin n)` is normal, so that
the corresponding quotient is a group.  (Special case of
`Work.Shrinking.pCentralSeries_normal`.) -/
instance pCentralSeries_normal_free (p n ν : ℕ) :
    (Work.Shrinking.pCentralSeries p (FreeGroup (Fin n)) ν).Normal :=
  Work.Shrinking.pCentralSeries_normal p (FreeGroup (Fin n)) ν

/-- `FreePQuotient p n ν` is the paper's `F^(n)/F^(n)(ν)`: the quotient of the free group on `n`
generators by the `ν`-th term of its descending `p`-central series.  These are the *generic
kernels*: every finite `p`-group generated by `n` elements is a quotient of `FreePQuotient p n ν`
for some `ν` (`Work.ProP.exists_surjective_freePQuotient`). -/
abbrev FreePQuotient (p n ν : ℕ) : Type :=
  FreeGroup (Fin n) ⧸ Work.Shrinking.pCentralSeries p (FreeGroup (Fin n)) ν

/-- The canonical projection `F^(n) → F^(n)/F^(n)(ν)`. -/
def freePQuotientMk (p n ν : ℕ) : FreeGroup (Fin n) →* FreePQuotient p n ν :=
  QuotientGroup.mk' _

@[simp]
theorem freePQuotientMk_apply (p n ν : ℕ) (x : FreeGroup (Fin n)) :
    freePQuotientMk p n ν x =
      (QuotientGroup.mk x : FreePQuotient p n ν) := rfl

theorem freePQuotientMk_surjective (p n ν : ℕ) :
    Function.Surjective (freePQuotientMk p n ν) :=
  QuotientGroup.mk'_surjective _

/-- The projection `F^(n)/F^(n)(μ) → F^(n)/F^(n)(ν)` for `ν ≤ μ`, induced by the inclusion
`F^(n)(μ) ≤ F^(n)(ν)` (the descending `p`-central series is antitone). -/
def freePQuotientProj (p n : ℕ) {ν μ : ℕ} (h : ν ≤ μ) :
    FreePQuotient p n μ →* FreePQuotient p n ν :=
  QuotientGroup.map _ _ (MonoidHom.id (FreeGroup (Fin n)))
    (by
      have hle := Work.Shrinking.pCentralSeries_antitone p (FreeGroup (Fin n)) h
      simpa using hle)

@[simp]
theorem freePQuotientProj_apply (p n : ℕ) {ν μ : ℕ} (h : ν ≤ μ) (x : FreeGroup (Fin n)) :
    freePQuotientProj p n h (freePQuotientMk p n μ x) = freePQuotientMk p n ν x := by
  show QuotientGroup.map _ _ (MonoidHom.id (FreeGroup (Fin n))) _ (QuotientGroup.mk' _ x)
      = QuotientGroup.mk' _ x
  rw [QuotientGroup.map_mk']
  rfl

theorem freePQuotientProj_id (p n ν : ℕ) :
    freePQuotientProj p n (le_refl ν) = MonoidHom.id (FreePQuotient p n ν) := by
  refine MonoidHom.ext fun x => ?_
  obtain ⟨y, rfl⟩ := freePQuotientMk_surjective p n ν x
  exact freePQuotientProj_apply p n (le_refl ν) y

theorem freePQuotientProj_comp (p n : ℕ) {ν μ ρ : ℕ} (h₁ : ν ≤ μ) (h₂ : μ ≤ ρ) :
    (freePQuotientProj p n h₁).comp (freePQuotientProj p n h₂) = freePQuotientProj p n
      (h₁.trans h₂) := by
  refine MonoidHom.ext fun x => ?_
  obtain ⟨y, rfl⟩ := freePQuotientMk_surjective p n ρ x
  rw [MonoidHom.comp_apply, freePQuotientProj_apply, freePQuotientProj_apply,
    freePQuotientProj_apply]

/-! ## The pro-`p`-completion -/

/-- The pro-`p`-completion of the free group of rank `n`, realized as the inverse limit
`lim_ν F^(n)/F^(n)(ν)` inside the product `∀ ν, F^(n)/F^(n)(ν)`: the subgroup of compatible
families.  Since the structure maps `F^(n)/F^(n)(μ) → F^(n)/F^(n)(ν)` are surjective and all
groups involved are finite, this is exactly the pro-`p`-completion of the discrete free group
`FreeGroup (Fin n)` (`F^(n)/F^(n)(1) = F^(n)/Φ_p(F^(n))` is elementary abelian of rank `n` and
the filtration is cofinal among the normal subgroups of finite `p`-power index, see
`Work.ProP.pCentralSeries_eq_bot_of_card` and `Work.ProP.pCentralSeries_le_of_pgroup_quotient`).

A map *into* a finite group is automatically continuous for the profinite topology on the
completion and the discrete topology on the target; the topological group structure is not
developed here. -/
def proPCompletion (p n : ℕ) : Subgroup (∀ ν : ℕ, FreePQuotient p n ν) where
  carrier := {f | ∀ ν : ℕ, freePQuotientProj p n (Nat.le_succ ν) (f (ν + 1)) = f ν}
  one_mem' := by
    intro ν
    simp
  mul_mem' := by
    intro f g hf hg ν
    simp only [Pi.mul_apply, map_mul, hf ν, hg ν]
  inv_mem' := by
    intro f hf ν
    simp only [Pi.inv_apply, map_inv, hf ν]

namespace proPCompletion

/-- The `ν`-th coordinate projection `lim_μ F^(n)/F^(n)(μ) → F^(n)/F^(n)(ν)`. -/
def proj (p n ν : ℕ) : proPCompletion p n →* FreePQuotient p n ν :=
  (Pi.evalMonoidHom (fun ν : ℕ => FreePQuotient p n ν) ν).comp (proPCompletion p n).subtype

@[simp]
theorem proj_apply (p n ν : ℕ) (f : proPCompletion p n) :
    proj p n ν f = (f : ∀ ν : ℕ, FreePQuotient p n ν) ν := rfl

/-- Two elements of the pro-`p`-completion are equal as soon as all their coordinate
projections agree. -/
@[ext]
theorem ext {p n : ℕ} {f g : proPCompletion p n} (h : ∀ ν, proj p n ν f = proj p n ν g) :
    f = g := by
  refine Subtype.ext (funext fun ν => ?_)
  exact h ν

/-- The canonical map `F^(n) → proPCompletion p n = lim_ν F^(n)/F^(n)(ν)`. -/
def canonical (p n : ℕ) : FreeGroup (Fin n) →* proPCompletion p n where
  toFun x := ⟨fun ν => freePQuotientMk p n ν x, by
    intro ν
    exact freePQuotientProj_apply p n (Nat.le_succ ν) x⟩
  map_one' := Subtype.ext (funext fun ν => by simp [proj])
  map_mul' := fun a b => Subtype.ext (funext fun ν => by simp [proj])

@[simp]
theorem proj_canonical (p n ν : ℕ) (x : FreeGroup (Fin n)) :
    proj p n ν (canonical p n x) = freePQuotientMk p n ν x := rfl

/-- Every coordinate projection of the pro-`p`-completion is surjective. -/
theorem proj_surjective (p n ν : ℕ) : Function.Surjective (proj p n ν) := by
  intro y
  obtain ⟨x, rfl⟩ := freePQuotientMk_surjective p n ν y
  exact ⟨canonical p n x, proj_canonical p n ν x⟩

/-- The inverse-limit (universal) property of the pro-`p`-completion: a compatible family of
homomorphisms into the finite quotients `F^(n)/F^(n)(ν)` comes from a unique homomorphism into
`proPCompletion p n`. -/
def lift {p n : ℕ} {X : Type*} [Group X] (h : ∀ ν : ℕ, X →* FreePQuotient p n ν)
    (hcompat : ∀ ν : ℕ, (freePQuotientProj p n (Nat.le_succ ν)).comp (h (ν + 1)) = h ν) :
    X →* proPCompletion p n where
  toFun x := ⟨fun ν => h ν x, by
    intro ν
    have := congrFun (congrArg DFunLike.coe (hcompat ν)) x
    simpa using this⟩
  map_one' := Subtype.ext (funext fun ν => by simp [proj])
  map_mul' := fun a b => Subtype.ext (funext fun ν => by simp [proj])

@[simp]
theorem proj_lift {p n : ℕ} {X : Type*} [Group X] (h : ∀ ν : ℕ, X →* FreePQuotient p n ν)
    (hcompat : ∀ ν : ℕ, (freePQuotientProj p n (Nat.le_succ ν)).comp (h (ν + 1)) = h ν)
    (ν : ℕ) : (proj p n ν).comp (lift h hcompat) = h ν := rfl

/-- Uniqueness in the inverse-limit property. -/
theorem lift_unique {p n : ℕ} {X : Type*} [Group X] (h : ∀ ν : ℕ, X →* FreePQuotient p n ν)
    (hcompat : ∀ ν : ℕ, (freePQuotientProj p n (Nat.le_succ ν)).comp (h (ν + 1)) = h ν)
    (g : X →* proPCompletion p n) (hg : ∀ ν : ℕ, (proj p n ν).comp g = h ν) :
    g = lift h hcompat := by
  refine MonoidHom.ext fun x => ?_
  refine Subtype.ext (funext fun ν => ?_)
  exact congrFun (congrArg DFunLike.coe (hg ν)) x

end proPCompletion

end Work.ProP
