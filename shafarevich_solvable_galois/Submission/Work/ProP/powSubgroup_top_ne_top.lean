# The `p`-th power subgroup of the whole group is proper in a nontrivial finite abelian `p`-group

For a nontrivial finite abelian `p`-group `V` the subgroup `V^p` generated by the `p`-th powers
of the elements of `V` is a *proper* subgroup.  Equivalently the `p`-th power map `x ↦ x ^ p`
is not surjective, i.e. `V^p ≠ V`.

The reason is that `x ↦ x ^ p` is an endomorphism of the abelian group `V` (in fact
`V^p = (·^p).range`) whose kernel contains the (nontrivial, by Cauchy's theorem) subgroup of
elements of order dividing `p`; an injective endomorphism of a finite group is surjective, and
injectivity would force every element of order dividing `p` to be trivial.

This is the `N = ⊤` case of the Nakayama-type statement `pCentralStep_eq_self_iff`.
-/

import Mathlib
import Submission.Work.ProP.Defs
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.ProP

/-- In a nontrivial finite abelian `p`-group `V`, the subgroup generated by the `p`-th powers
is a proper subgroup: `V ^ p ≠ V`. -/
theorem powSubgroup_top_ne_top {p : ℕ} [Fact p.Prime] {V : Type*} [CommGroup V] [Finite V]
    (hV : IsPGroup p V) (hne : Nontrivial V) :
    Work.Shrinking.powSubgroup p (⊤ : Subgroup V) ≠ ⊤ := by
  -- the `p`-th power map is a homomorphism `V →* V` because `V` is abelian
  let φ : V →* V :=
    { toFun := fun x => x ^ p
      map_one' := one_pow p
      map_mul' := fun a b => mul_pow a b p }
  -- `powSubgroup p ⊤` is precisely the range of the power map
  have hrange : Work.Shrinking.powSubgroup p (⊤ : Subgroup V) = φ.range := by
    refine le_antisymm ?_ ?_
    · unfold Work.Shrinking.powSubgroup
      rw [Subgroup.closure_le]
      rintro x ⟨y, -, rfl⟩
      exact MonoidHom.mem_range.mpr ⟨y, rfl⟩
    · intro x hx
      obtain ⟨y, rfl⟩ := MonoidHom.mem_range.mp hx
      show (fun x : V => x ^ p) y ∈
        Subgroup.closure ((fun x : V => x ^ p) '' (⊤ : Subgroup V))
      exact Subgroup.subset_closure ⟨y, trivial, rfl⟩
  intro htop
  -- the power map would then be surjective, hence (V finite) injective
  have hsurj : Function.Surjective φ := by
    rw [← MonoidHom.range_eq_top, ← hrange]
    exact htop
  have hinj : Function.Injective φ := Finite.injective_iff_surjective.mpr hsurj
  -- `Nontrivial V` with `IsPGroup p V` forces `p ∣ Nat.card V`, so Cauchy gives an element
  -- of order `p`; it lies in the kernel of the power map, contradicting injectivity
  obtain ⟨n, hn, hcard⟩ := (hV.nontrivial_iff_card).mp hne
  have hdvd : p ∣ Nat.card V := by
    rw [hcard]
    exact dvd_pow_self p (Nat.pos_iff_ne_zero.mp hn)
  obtain ⟨g, hg⟩ := exists_prime_orderOf_dvd_card' p hdvd
  have hg1 : g ≠ 1 := (orderOf_eq_prime_iff.mp hg).2
  have hgpow : g ^ p = 1 := (orderOf_eq_prime_iff.mp hg).1
  have hφg : φ g = φ 1 := by
    change g ^ p = 1 ^ p
    rw [hgpow, one_pow]
  exact hg1 (hinj hφg)

end Work.ProP
