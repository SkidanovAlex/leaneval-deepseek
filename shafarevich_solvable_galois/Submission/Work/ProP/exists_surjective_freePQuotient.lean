namespace Work.ProP

open Work.Shrinking

/-- A non-increasing sequence of natural numbers has two consecutive equal terms: the sequence
is bounded above by `f 0`, so among the first `f 0 + 2` values some value repeats, and by
monotonicity the first repetition happens between consecutive indices.  (Formalised by induction
on the bound, restarting the sequence at the first strictly smaller value.) -/
private lemma exists_succ_eq_of_antitone (f : ℕ → ℕ) (hf : Antitone f) :
    ∃ n, f (n + 1) = f n := by
  suffices h : ∀ N, ∀ g : ℕ → ℕ, Antitone g → g 0 = N → ∃ n, g (n + 1) = g n by
    exact h (f 0) f hf rfl
  intro N
  induction N using Nat.strong_induction_on with
  | h N ih =>
    intro g hg hg0
    by_cases hstep : g 1 = g 0
    · exact ⟨0, hstep⟩
    · have hlt : g 1 < g 0 := lt_of_le_of_ne (hg (Nat.zero_le 1)) hstep
      have hltN : g 1 < N := by rw [← hg0]; exact hlt
      obtain ⟨n, hn⟩ :=
        ih (g 1) hltN (fun k => g (k + 1)) (fun a b hab => hg (by omega)) rfl
      exact ⟨n + 1, hn⟩

/-- The descending `p`-central series of a finite `p`-group reaches the trivial subgroup.

The series is a non-increasing sequence of subgroups of the finite group `Q`, so some two
consecutive terms have the same order; being nested, they are then equal, and the Nakayama
property `Work.ProP.pCentralStep_eq_self_iff` forces that term to be trivial. -/
theorem pCentralSeries_eq_bot_of_isPGroup {p : ℕ} [Fact p.Prime] {Q : Type*} [Group Q]
    [Finite Q] (hQ : IsPGroup p Q) : ∃ ν, Work.Shrinking.pCentralSeries p Q ν = ⊥ := by
  have hanti : Antitone (fun n => Nat.card (Work.Shrinking.pCentralSeries p Q n)) :=
    fun a b hab => Nat.card_le_card_of_injective
      (Subgroup.inclusion (Work.Shrinking.pCentralSeries_antitone p Q hab))
      (Subgroup.inclusion_injective _)
  obtain ⟨n, hn⟩ := exists_succ_eq_of_antitone _ hanti
  refine ⟨n, ?_⟩
  have hle : Work.Shrinking.pCentralSeries p Q (n + 1) ≤ Work.Shrinking.pCentralSeries p Q n :=
    Work.Shrinking.pCentralSeries_le_succ p Q n
  have heq : Work.Shrinking.pCentralSeries p Q (n + 1) = Work.Shrinking.pCentralSeries p Q n :=
    Subgroup.eq_of_le_of_card_ge hle hn.ge
  have hNnorm : (Work.Shrinking.pCentralSeries p Q n).Normal :=
    Work.Shrinking.pCentralSeries_normal p Q n
  have hstep : Work.Shrinking.pCentralStep p (Work.Shrinking.pCentralSeries p Q n)
      = Work.Shrinking.pCentralSeries p Q n := by
    show Work.Shrinking.pCentralSeries p Q (n + 1) = Work.Shrinking.pCentralSeries p Q n
    exact heq
  exact (pCentralStep_eq_self_iff hQ (Work.Shrinking.pCentralSeries p Q n)).mp hstep

/-- **The "generic kernel" corollary, in the form used by the reduction of Theorem 14 of
Schmidt–Wingberg.**  If `φ : F^(n) ↠ P` is a surjection onto a finite `p`-group, then `P` is a
quotient of one of the finite groups `F^(n)/F^(n)(ν)` for a suitable `ν`; in particular every
finite `p`-group generated by `n` elements is such a quotient.

Proof: take `ν` and `f` with `f ∘ mk = φ` (the previous factoring result; if it is not
importable, combine the cofinality of the filtration — proved by induction on `Nat.card P`
through the centre, using `Work.Shrinking.map_pCentralSeries_surjective` — with
`QuotientGroup.lift`).  Then `f` is surjective because `φ = f ∘ mk` is and `mk` is. -/
theorem exists_surjective_freePQuotient {p : ℕ} [Fact p.Prime] (n : ℕ) {P : Type*} [Group P]
    [Finite P] (hP : IsPGroup p P) (φ : FreeGroup (Fin n) →* P)
    (hφ : Function.Surjective φ) :
    ∃ (ν : ℕ) (f : FreePQuotient p n ν →* P), Function.Surjective f := by
  -- the `p`-central filtration of `P` reaches `⊥`, hence `φ` kills some term of the
  -- `p`-central filtration of `F^(n)` (the filtration of the quotient is the image of the
  -- filtration).
  obtain ⟨ν, hbot⟩ := pCentralSeries_eq_bot_of_isPGroup (Q := P) hP
  have hmap := Work.Shrinking.map_pCentralSeries_surjective p φ hφ ν
  rw [hbot] at hmap
  have hle : Work.Shrinking.pCentralSeries p (FreeGroup (Fin n)) ν ≤ φ.ker :=
    (Subgroup.map_eq_bot_iff _).mp hmap
  -- factor `φ` through the finite quotient `F^(n)/F^(n)(ν)`
  refine ⟨ν, QuotientGroup.lift _ φ hle, ?_⟩
  intro y
  obtain ⟨x, rfl⟩ := hφ y
  exact ⟨freePQuotientMk p n ν x, QuotientGroup.lift_mk' _ hle x⟩

end Work.ProP
