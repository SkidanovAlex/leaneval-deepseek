/-! ## The `f`-th power of a Frobenius generates the decomposition group modulo the inertia.

Let `k ⊆ K ⊆ L` be number fields with `K/k` and `L/k` finite Galois, `q'` a prime of `𝓞 L`, `d` an
arithmetic Frobenius at `q'` for the extension `L/k`, `f = [κ(q'∩K) : κ(q'∩k)]`, and
`e ∈ Gal(L/K)` the automorphism with `e = d ^ f`.  Then `e`, together with the inertia subgroup of
`q'` for `L/K`, generates the decomposition group of `q'` in `Gal(L/K)`.

The proof runs the standard dictionary of ramification theory:

* `e` is itself a Frobenius at `q'` for the extension `L/K` (this is the residue-degree
  computation `d ^ f` acts as the `#κ(q'∩K)`-power map);
* a Frobenius element fixes its own prime, so `e` lies in the decomposition group;
* the residue map `D ⧸ I ≅ Gal(κ(q')/κ(q'∩K))` sends `e` to the Frobenius of the residue field
  extension, whose powers exhaust the (cyclic) Galois group of that extension of finite fields;
* the kernel of the residue map is the inertia subgroup, so `⟨e⟩ · I = D`;
* the decomposition group is the stabiliser of `q'`, which is the Neukirch–Uchida
  `decompositionSubgroup`.

-/

section Helpers

variable {K L : Type} [Field K] [Field L] [NumberField K] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- Coercing `σ • b` to `L` agrees with acting on the coercion of `b`. -/
lemma ringOfIntegers_coe_smul (σ : L ≃ₐ[K] L) (b : 𝓞 L) :
    algebraMap (𝓞 L) L (σ • b) = σ • (algebraMap (𝓞 L) L b) :=
  integralClosure.coe_smul σ b

/-- The action of `Gal(L/K)` on the ring of integers of `L` is through `galRestrict`. -/
lemma galRestrict_eq_smul (σ : L ≃ₐ[K] L) (b : 𝓞 L) :
    galRestrict (𝓞 K) K L (𝓞 L) σ b = σ • b := by
  apply FaithfulSMul.algebraMap_injective (𝓞 L) L
  rw [algebraMap_galRestrict_apply (𝓞 K) σ b, ringOfIntegers_coe_smul]
  rfl

/-- The ring homomorphism underlying the `MulSemiringAction` of `Gal(L/K)` on `𝓞 L` is
`galRestrict`. -/
lemma toRingHom_eq_galRestrict (σ : L ≃ₐ[K] L) :
    MulSemiringAction.toRingHom (L ≃ₐ[K] L) (𝓞 L) σ =
      (galRestrict (𝓞 K) K L (𝓞 L) σ : 𝓞 L →+* 𝓞 L) :=
  RingHom.ext fun b => by
    rw [MulSemiringAction.toRingHom_apply]
    exact (galRestrict_eq_smul σ b).symm

/-- **A Frobenius element fixes its own prime**, in the form of membership in the stabiliser. -/
lemma mem_stabilizer_of_isFrobAt (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L))
    (e : L ≃ₐ[K] L) (hfe : NK.Chebotarev.IsFrobAt (K := K) (L := L) w e) :
    e ∈ MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal := by
  rw [MulAction.mem_stabilizer_iff, Ideal.pointwise_smul_def, toRingHom_eq_galRestrict]
  exact NK.Chebotarev.IsFrobAtStabilizes hfe

/-- **The residue action of a Frobenius at `w` is the Frobenius of the residue extension.** -/
lemma stabilizerHom_isFrobAt_eq_residueFrobenius
    (v : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) [hw : w.asIdeal.LiesOver v.asIdeal]
    (e : L ≃ₐ[K] L) (he : e ∈ MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal)
    (hfe : NK.Chebotarev.IsFrobAt (K := K) (L := L) w e) :
    (Ideal.Quotient.stabilizerHom w.asIdeal v.asIdeal (L ≃ₐ[K] L)) ⟨e, he⟩ =
      Work.LocalFields.residueFrobenius v w := by
  ext x
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.stabilizerHom_apply, MulAction.subgroup_smul_def, ← galRestrict_eq_smul e b,
    NK.Chebotarev.IsFrobAt.mk_apply hfe hw b, Work.LocalFields.residueFrobenius_apply]

/-- **The Galois group of an extension of finite fields is generated by the Frobenius.** -/
lemma zpowers_residueFrobenius_eq_top
    (v : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) [hw : w.asIdeal.LiesOver v.asIdeal] :
    Subgroup.zpowers (Work.LocalFields.residueFrobenius v w) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro τ
  obtain ⟨n, hn⟩ := Work.LocalFields.exists_pow_eq_residueFrobenius v w τ
  exact Subgroup.mem_zpowers_iff.mpr ⟨(n : ℤ), by rw [zpow_natCast]; exact hn.symm⟩

/-- **Generating modulo a kernel.**  If the image of `g` generates `H`, then `g` together with
the kernel of `f` generates `G`. -/
lemma zpowers_sup_ker_eq_top {G H : Type*} [Group G] [Group H] (f : G →* H) (g : G)
    (hgen : Subgroup.zpowers (f g) = ⊤) : Subgroup.zpowers g ⊔ f.ker = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  have hx : f x ∈ Subgroup.zpowers (f g) := by rw [hgen]; exact Subgroup.mem_top _
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hx
  have hker : x * g ^ (-n) ∈ f.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_zpow, zpow_neg, hn, mul_inv_cancel]
  rw [show x = (x * g ^ (-n)) * g ^ n from by group]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hker)
    (Subgroup.mem_sup_left (Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩))

/-- **The decomposition group is generated by the `f`-th power of a Frobenius modulo the
inertia.**  Once the class of `e` in `D ⧸ I` generates (hypothesis `htop`), the ambient statement
follows. -/
lemma zpowers_sup_inertia_eq_stabilizer (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L))
    (e : L ≃ₐ[K] L) (he_mem : e ∈ MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal)
    (htop : Subgroup.zpowers (⟨e, he_mem⟩ : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) ⊔
        Ideal.inertia (MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) w.asIdeal = ⊤) :
    Subgroup.zpowers e ⊔ Ideal.inertia (L ≃ₐ[K] L) w.asIdeal =
      MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal := by
  refine le_antisymm ?_ ?_
  · exact sup_le (Subgroup.zpowers_le.mpr he_mem) (Ideal.inertia_le_stabilizer w.asIdeal)
  · intro σ hσ
    have hmem : (⟨σ, hσ⟩ : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) ∈
        Subgroup.zpowers (⟨e, he_mem⟩ : MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) ⊔
          Ideal.inertia (MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal) w.asIdeal := by
      rw [htop]; exact Subgroup.mem_top _
    obtain ⟨a, ha, b, hb, hab⟩ := Subgroup.mem_sup_of_normal_right.mp hmem
    have hbG : (b : L ≃ₐ[K] L) ∈ Ideal.inertia (L ≃ₐ[K] L) w.asIdeal :=
      Ideal.coe_mem_inertia.mpr hb
    have haG : (a : L ≃ₐ[K] L) ∈ Subgroup.zpowers e := by
      obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp ha
      rw [Subgroup.mem_zpowers_iff]
      exact ⟨m, by rw [← hm]; rfl⟩
    have hσeq : (a : L ≃ₐ[K] L) * (b : L ≃ₐ[K] L) = σ := by
      have h := congrArg (Subgroup.subtype (MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal)) hab
      simpa using h
    rw [← hσeq]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_left haG) (Subgroup.mem_sup_right hbG)

/-- **The decomposition subgroup is the stabiliser of the underlying prime.** -/
lemma decompositionSubgroup_eq_stabilizer (w : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) :
    Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) w =
      MulAction.stabilizer (L ≃ₐ[K] L) w.asIdeal := by
  ext σ
  rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup, MulAction.mem_stabilizer_iff,
    IsDedekindDomain.HeightOneSpectrum.ext_iff,
    Submission.NeukirchUchida.Local.placeSmul_asIdeal, Ideal.pointwise_smul_def,
    toRingHom_eq_galRestrict]

end Helpers

theorem zpowers_sup_inertia_eq_decomp {k K L : Type} [Field k] [Field K] [Field L]
    [NumberField k] [NumberField K] [NumberField L] [Algebra k K] [Algebra k L] [Algebra K L]
    [IsScalarTower k K L] [FiniteDimensional k K] [IsGalois k K] [FiniteDimensional k L]
    [IsGalois k L] [IsGalois K L]
    (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) (d : L ≃ₐ[k] L)
    (e : L ≃ₐ[K] L) (f : ℕ)
    (hd : NK.Chebotarev.IsFrobAt (K := k) (L := L) q' d)
    (he : AlgEquiv.restrictScalars k e = d ^ f)
    (hf : f = (q'.asIdeal.under (NumberField.RingOfIntegers K)).inertiaDeg
      (NumberField.RingOfIntegers k)) :
    Subgroup.zpowers e ⊔ Ideal.inertia (L ≃ₐ[K] L) q'.asIdeal =
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) q' := by
  -- ### Step 1: `e` is a Frobenius at `q'` for the extension `L/K`.
  -- The automorphism `d ^ f` induces the `#κ(q'∩K)`-power map on the residue field `𝓞 L ⧸ q'`.
  have hfe : NK.Chebotarev.IsFrobAt (K := K) (L := L) q' e := by
    rw [NK.Chebotarev.isFrobAt_def]
    intro x
    -- `e` and `d ^ f` have the same underlying function on `L`
    have hfun : ∀ y : L, e y = (d ^ f) y := fun y => by
      rw [← AlgEquiv.restrictScalars_apply k e y, he]
    have hfunc : ∀ y : NumberField.RingOfIntegers L,
        galRestrict (NumberField.RingOfIntegers K) K L (NumberField.RingOfIntegers L) e y =
        galRestrict (NumberField.RingOfIntegers k) k L
          (NumberField.RingOfIntegers L) (d ^ f) y :=
      fun y => NK.ChebotarevGeneral.galRestrict_eq_of_apply_eq (σ := d ^ f) (τ := e) hfun y
    -- the residue action of the Frobenius `d` over `k`
    have hPk : q'.asIdeal.LiesOver (q'.under (NumberField.RingOfIntegers k)).asIdeal := by
      rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
      exact ⟨rfl⟩
    have hres_k : ∀ y : NumberField.RingOfIntegers L,
        Ideal.Quotient.mk q'.asIdeal
            (galRestrict (NumberField.RingOfIntegers k) k L (NumberField.RingOfIntegers L) d y) =
          (Ideal.Quotient.mk q'.asIdeal y)
            ^ Nat.card (NumberField.RingOfIntegers k ⧸
                (q'.under (NumberField.RingOfIntegers k)).asIdeal) :=
      fun y => hd.mk_apply hPk y
    -- hence the residue action of `d ^ f` is the `(#κ(q'∩k)) ^ f`-th power map
    have hpow := Commons.NumberTheory.NumberField.residue_pow_galRestrict_pow
      (K := k) (L := L) (q'.under (NumberField.RingOfIntegers k)) q' d hres_k
    -- the prime `q' ∩ 𝓞 K` lies over `q' ∩ 𝓞 k`
    have hLiesKK : (q'.asIdeal.under (NumberField.RingOfIntegers K)).LiesOver
        (q'.asIdeal.under (NumberField.RingOfIntegers k)) :=
      Ideal.LiesOver.mk
        (Ideal.under_under (A := NumberField.RingOfIntegers k)
          (B := NumberField.RingOfIntegers K) q'.asIdeal).symm
    -- `#κ(q'∩K) = (#κ(q'∩k)) ^ f`
    have hcard := Commons.NumberTheory.NumberField.natCard_residue_eq_pow_inertiaDeg
      (K := k) (L := K) (q'.under (NumberField.RingOfIntegers k))
      (q'.under (NumberField.RingOfIntegers K)) hLiesKK
    have hexp : (Nat.card (NumberField.RingOfIntegers k ⧸
          (q'.under (NumberField.RingOfIntegers k)).asIdeal)) ^ f =
        Nat.card (NumberField.RingOfIntegers K ⧸
          (q'.under (NumberField.RingOfIntegers K)).asIdeal) := by
      rw [hf, ← IsDedekindDomain.HeightOneSpectrum.under_asIdeal
        (NumberField.RingOfIntegers K) q', hcard.symm]
    -- the defining congruence for the Frobenius of `L/K` at `q'`
    have h4 : Ideal.Quotient.mk q'.asIdeal
          (galRestrict (NumberField.RingOfIntegers K) K L (NumberField.RingOfIntegers L) e x) =
        Ideal.Quotient.mk q'.asIdeal (x ^ Nat.card (NumberField.RingOfIntegers K ⧸
          (q'.under (NumberField.RingOfIntegers K)).asIdeal)) := by
      rw [hfunc x, hpow f x, hexp, map_pow]
    exact (Ideal.Quotient.eq).mp h4
  -- ### Step 2: a Frobenius fixes its own prime, so `e` is in the decomposition group.
  have he_mem : e ∈ MulAction.stabilizer (L ≃ₐ[K] L) q'.asIdeal :=
    mem_stabilizer_of_isFrobAt q' e hfe
  -- the prime of `𝓞 K` below `q'`
  have hP : q'.asIdeal.LiesOver (q'.under (𝓞 K)).asIdeal := by
    rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
    exact ⟨rfl⟩
  haveI := hP
  -- ### Step 3: the image of `e` in `D ⧸ I ≅ Gal(κ(q')/κ(q'∩K))` is the residue Frobenius.
  have hstab := stabilizerHom_isFrobAt_eq_residueFrobenius (q'.under (𝓞 K)) q' e he_mem hfe
  -- ### Step 4: that image generates the cyclic Galois group of the residue extension.
  have hgen : Subgroup.zpowers ((Ideal.Quotient.stabilizerHom q'.asIdeal
        ((q'.under (𝓞 K)).asIdeal) (L ≃ₐ[K] L)) ⟨e, he_mem⟩) = ⊤ := by
    rw [hstab]
    exact zpowers_residueFrobenius_eq_top (q'.under (𝓞 K)) q'
  -- ### Step 5: the kernel of the residue map is the inertia subgroup.
  have hker := Ideal.Quotient.ker_stabilizerHom q'.asIdeal ((q'.under (𝓞 K)).asIdeal)
    (L ≃ₐ[K] L)
  have htop : Subgroup.zpowers (⟨e, he_mem⟩ : MulAction.stabilizer (L ≃ₐ[K] L) q'.asIdeal) ⊔
      Ideal.inertia (MulAction.stabilizer (L ≃ₐ[K] L) q'.asIdeal) q'.asIdeal = ⊤ := by
    rw [← hker]
    exact zpowers_sup_ker_eq_top (Ideal.Quotient.stabilizerHom q'.asIdeal
      ((q'.under (𝓞 K)).asIdeal) (L ≃ₐ[K] L)) ⟨e, he_mem⟩ hgen
  -- ### Step 6: transfer from `D` back to `Gal(L/K)`, and rewrite `D` as the Neukirch–Uchida
  -- decomposition subgroup.
  rw [zpowers_sup_inertia_eq_stabilizer q' e he_mem htop,
    decompositionSubgroup_eq_stabilizer (K := K) q']

end Work.Sha2Lib
