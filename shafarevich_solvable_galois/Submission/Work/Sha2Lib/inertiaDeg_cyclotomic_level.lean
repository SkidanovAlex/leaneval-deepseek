/-- **Generation.**  `CyclotomicField m L = L(ζ)` for a primitive `m`-th root of unity `ζ`
(`m > 0`, `L` a number field), so an `L`-algebra automorphism of `CyclotomicField m L` which fixes
`ζ` is the identity.

(Equivalently: any element of the cyclotomic field is a polynomial in `ζ` over `L`.) -/
lemma eq_one_of_isPrimitiveRoot_apply_eq_self {L : Type} [Field L] [NumberField L] {m : ℕ}
    [NeZero m] {ζ : CyclotomicField m L} (hζ : IsPrimitiveRoot ζ m)
    (σ : CyclotomicField m L ≃ₐ[L] CyclotomicField m L) (h : σ ζ = ζ) : σ = 1 := by
  haveI hcyc : IsCyclotomicExtension {m} L (CyclotomicField m L) :=
    CyclotomicField.isCyclotomicExtension m L
  have hgen : ∀ x : CyclotomicField m L,
      x ∈ Algebra.adjoin L ({ζ} : Set (CyclotomicField m L)) := by
    intro x
    refine Algebra.adjoin_le (fun b hb => ?_)
      (IsCyclotomicExtension.adjoin_roots (S := {m}) (A := L) (B := CyclotomicField m L) x)
    obtain ⟨k, hk, _hk0, hbk⟩ := hb
    rw [Set.mem_singleton_iff] at hk
    subst hk
    obtain ⟨i, _hi, hii⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one hζ hbk
    rw [← hii]
    exact Subalgebra.pow_mem _ (Algebra.subset_adjoin (Set.mem_singleton ζ)) i
  refine AlgEquiv.ext fun x => ?_
  have hx := hgen x
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      rw [Set.mem_singleton_iff] at hy
      rw [hy]
      simpa using h
  | algebraMap r => exact σ.commutes r
  | add y z hy hz ihy ihz => rw [map_add, map_add, ihy, ihz]
  | mul y z hy hz ihy ihz => rw [map_mul, map_mul, ihy, ihz]

/-- **The cyclotomic level `L(ζ_m)`, `m = q₀ ^ n - 1`, is unramified of inertia degree `n` at `q`.**

`L` a number field, `q` a prime of `𝓞 L`, `q₀ = #(𝓞 L ⧸ q)`, `n > 0`, `m := q₀ ^ n - 1`. Then for
**every** prime `q'` of `𝓞 (L(ζ_m))` lying over `q`, the extension is unramified at `q'` and the
inertia degree of `q'` over `q` is exactly `n`.

This is the second and last unproved goal of `exists_galois_unramified_extension_of_inertiaDeg` in
`Submission/NK/NumberTheory/NumberField/Completion/exists_galois_unramified_extension_of_inertiaDeg.lean`
(lines 547-606, module `Submission.NK.NumberTheory.NumberField.Completion.exists_galois_unramified_extension_of_inertiaDeg`),
the file's entry point for the detector's "level existence" input; you may import that module and
reuse its proved lemmas (`ramificationIdx_cyclotomic_eq_one` line 378, `isPrimitiveRoot_reduction`
line 298, `natCast_mem_of_one_sub_isPrimitiveRoot_mem` line 204, `pow_sub_one_dvd_pow_sub_one_iff`
line 63, `natDegree_minpoly_isPrimitiveRoot_card_pow_sub_one` line 746); in particular the file's
proof of `exists_galois_unramified_extension_of_inertiaDeg` already derives `m ∉ q` and `e = 1`
from `ramificationIdx_cyclotomic_eq_one`, so the work here is the inertia degree `f = n`.

Route (confirmed by two reviews, and *not* needing the residue field to be generated by `ζ̄`):
`L(ζ_m)/L` is the splitting field of `X ^ m - 1` over `L` (char `0`), hence abelian Galois, so all
`q' | q` share `e` and `f`; `n ≤ f` because `ζ̄ ^ m = 1` in the residue field of size `q₀ ^ f` forces
`m ∣ q₀ ^ f - 1`, i.e. `n ∣ f`; `f ≤ n` because the Frobenius at `q'` (the extension is unramified:
`e = 1`) acts on `μ_m` by `ζ ↦ ζ ^ q₀` - Teichmüller: reduce, raise to the `q₀`-th power, lift - and
`q₀ ^ d - 1 < m` for `d < n`, so that action has order exactly `n`, while `L(ζ_m) = L(μ_m)` is
generated by `μ_m` (an automorphism fixing `μ_m` pointwise is the identity), giving `f = n`.
The hypotheses are satisfiable and the statement is a strengthening of the source's single-`q'`
goal; `q₀ ≥ 2` and `0 < q₀ ^ n - 1` follow from `hq₀` and `hn`. -/
theorem inertiaDeg_cyclotomic_level {L : Type} [Field L] [NumberField L]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) (q₀ : ℕ)
    (hq₀ : q₀ = Nat.card (NumberField.RingOfIntegers L ⧸ q.asIdeal)) {n : ℕ} (hn : 0 < n)
    [NeZero (q₀ ^ n - 1)] :
    ∀ q' : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers (CyclotomicField (q₀ ^ n - 1) L)),
      q'.asIdeal.LiesOver q.asIdeal →
        (q₀ ^ n - 1 : ℕ) ≠ 0 ∧
        q'.asIdeal.ramificationIdx (NumberField.RingOfIntegers L) = 1 ∧
        q'.asIdeal.inertiaDeg (NumberField.RingOfIntegers L) = n := by
  intro q' hqq'
  -- the cyclotomic level
  haveI hcyc : IsCyclotomicExtension {q₀ ^ n - 1} L (CyclotomicField (q₀ ^ n - 1) L) :=
    CyclotomicField.isCyclotomicExtension (q₀ ^ n - 1) L
  haveI hgal : IsGalois L (CyclotomicField (q₀ ^ n - 1) L) :=
    IsCyclotomicExtension.isGalois {q₀ ^ n - 1} L (CyclotomicField (q₀ ^ n - 1) L)
  haveI hfin : FiniteDimensional L (CyclotomicField (q₀ ^ n - 1) L) :=
    IsCyclotomicExtension.finiteDimensional {q₀ ^ n - 1} L (CyclotomicField (q₀ ^ n - 1) L)
  -- numerical data of the base residue field
  haveI hfink : Finite (𝓞 L ⧸ q.asIdeal) :=
    Commons.NumberTheory.NumberField.finite_quotient_heightOneSpectrum q
  haveI hftk : Fintype (𝓞 L ⧸ q.asIdeal) := Fintype.ofFinite _
  have hq02 : 2 ≤ q₀ := by
    rw [hq₀, Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hq0pos : 0 < q₀ := by omega
  have hq0n : 2 ≤ q₀ ^ n := le_trans hq02 (Nat.le_self_pow hn.ne' q₀)
  have hmpos : 0 < q₀ ^ n - 1 := by omega
  -- `q₀` vanishes in the residue field, hence so does `q₀ ^ n`, hence `m ≡ -1`
  have hq0mem : ((q₀ : ℕ) : 𝓞 L) ∈ q.asIdeal := by
    have h := Commons.NumberTheory.NumberField.Completion.natCard_residueField_mem (L := L) q
    rwa [← hq₀] at h
  have hmq : ((q₀ ^ n - 1 : ℕ) : 𝓞 L) ∉ q.asIdeal := by
    intro hmem
    have hzero : Ideal.Quotient.mk q.asIdeal ((q₀ ^ n - 1 : ℕ) : 𝓞 L) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hmem
    have hq0zero : Ideal.Quotient.mk q.asIdeal ((q₀ : ℕ) : 𝓞 L) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hq0mem
    have hone : 1 ≤ q₀ ^ n := by omega
    have hval : Ideal.Quotient.mk q.asIdeal ((q₀ ^ n - 1 : ℕ) : 𝓞 L) = -1 := by
      rw [Nat.cast_sub hone, Nat.cast_pow, Nat.cast_one, map_sub, map_one, map_pow, hq0zero,
        zero_pow hn.ne']
      ring
    rw [hval] at hzero
    exact absurd hzero (by
      haveI : Nontrivial (𝓞 L ⧸ q.asIdeal) :=
        Ideal.Quotient.nontrivial_iff.mpr (inferInstance : q.asIdeal.IsPrime).ne_top
      exact neg_ne_zero.mpr one_ne_zero)
  -- unramifiedness and the Frobenius at `q'`
  have he : q'.asIdeal.ramificationIdx (𝓞 L) = 1 :=
    Commons.NumberTheory.NumberField.Completion.ramificationIdx_cyclotomic_eq_one q hmq q' hqq'
  obtain ⟨σ, hσmap, hσres⟩ :=
    Commons.NumberTheory.NumberField.exists_frobenius_galRestrict (K := L)
      (L := CyclotomicField (q₀ ^ n - 1) L) q q' hqq'
  have horder : orderOf σ = q'.asIdeal.inertiaDeg (𝓞 L) :=
    Commons.NumberTheory.NumberField.orderOf_frobenius_eq_inertiaDeg (K := L)
      (L := CyclotomicField (q₀ ^ n - 1) L) q q' hqq' he σ hσmap hσres
  -- a primitive `m`-th root of unity, as an element of the ring of integers
  obtain ⟨ζ, hζ⟩ := IsCyclotomicExtension.exists_isPrimitiveRoot L
    (CyclotomicField (q₀ ^ n - 1) L) (Set.mem_singleton (q₀ ^ n - 1))
    (NeZero.ne (q₀ ^ n - 1))
  have hζitg : IsIntegral ℤ ζ := hζ.isIntegral hmpos
  obtain ⟨ζ₀, hζ₀⟩ :=
    (IsIntegralClosure.isIntegral_iff (A := 𝓞 (CyclotomicField (q₀ ^ n - 1) L)) (R := ℤ)
      (B := CyclotomicField (q₀ ^ n - 1) L)).mp hζitg
  have hcoe : ((ζ₀ : 𝓞 (CyclotomicField (q₀ ^ n - 1) L)) :
      CyclotomicField (q₀ ^ n - 1) L) = ζ := hζ₀
  have hζ' : IsPrimitiveRoot (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) (q₀ ^ n - 1) := by
    rw [hcoe]; exact hζ
  have hζmB : ζ₀ ^ (q₀ ^ n - 1) = 1 := by
    apply Subtype.ext
    push_cast
    exact hζ'.pow_eq_one
  have hζne : (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ≠ 0 := by
    intro h0
    have h1 := hζ'.pow_eq_one
    rw [h0, zero_pow (NeZero.ne (q₀ ^ n - 1))] at h1
    exact one_ne_zero h1.symm
  -- `m` is a unit at `q'`, so the reduction map is injective on `μ_m` there
  have hm_unit : ((q₀ ^ n - 1 : ℕ) : 𝓞 (CyclotomicField (q₀ ^ n - 1) L)) ∉ q'.asIdeal := by
    intro hmem
    refine hmq ?_
    rw [hqq'.over, Ideal.mem_under]
    simpa using hmem
  -- Teichmüller: `σ` acts on `ζ` by the `q₀`-th power map
  have hsub : (galRestrict (𝓞 L) L (CyclotomicField (q₀ ^ n - 1) L)
        (𝓞 (CyclotomicField (q₀ ^ n - 1) L)) σ) ζ₀ - ζ₀ ^ q₀ ∈ q'.asIdeal := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, map_pow, sub_eq_zero]
    rw [hσres ζ₀, ← hq₀]
  have hθm : ((galRestrict (𝓞 L) L (CyclotomicField (q₀ ^ n - 1) L)
        (𝓞 (CyclotomicField (q₀ ^ n - 1) L)) σ) ζ₀) ^ (q₀ ^ n - 1) = 1 := by
    rw [← map_pow, hζmB, map_one]
  have hηm : (ζ₀ ^ q₀) ^ (q₀ ^ n - 1) = 1 := by
    rw [← pow_mul, mul_comm, pow_mul, hζmB, one_pow]
  have hσΘ : (galRestrict (𝓞 L) L (CyclotomicField (q₀ ^ n - 1) L)
        (𝓞 (CyclotomicField (q₀ ^ n - 1) L)) σ) ζ₀ = ζ₀ ^ q₀ :=
    Commons.NumberTheory.NumberField.Completion.eq_of_sub_mem_of_pow_eq_one
      hθm hηm hsub hm_unit
  have hσxζ : σ (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) =
      (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ q₀ := by
    have h := congrArg (fun x : 𝓞 (CyclotomicField (q₀ ^ n - 1) L) =>
      algebraMap (𝓞 (CyclotomicField (q₀ ^ n - 1) L))
        (CyclotomicField (q₀ ^ n - 1) L) x) hσΘ
    simpa [map_pow, algebraMap_galRestrict_apply] using h
  -- the iterated Frobenius action
  have hpow : ∀ k : ℕ, (σ ^ k) (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) =
      (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ (q₀ ^ k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
        rw [pow_succ', AlgEquiv.mul_apply, ih]
        rw [show σ ((ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ (q₀ ^ k)) =
            (σ (ζ₀ : CyclotomicField (q₀ ^ n - 1) L)) ^ (q₀ ^ k) from
          map_pow (σ : CyclotomicField (q₀ ^ n - 1) L →+* CyclotomicField (q₀ ^ n - 1) L) _ _]
        rw [hσxζ, ← pow_mul, ← pow_succ']
  -- the order of the Frobenius is exactly `n`
  have hord : orderOf σ = n := by
    rw [orderOf_eq_iff hn]
    refine ⟨?_, ?_⟩
    · apply eq_one_of_isPrimitiveRoot_apply_eq_self hζ' (σ ^ n)
      rw [hpow n]
      have hexp : q₀ ^ n = (q₀ ^ n - 1) + 1 := by omega
      have h1 : (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ (q₀ ^ n) =
          (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ ((q₀ ^ n - 1) + 1) :=
        congrArg (fun e : ℕ => (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ e) hexp
      rw [h1, pow_succ, hζ'.pow_eq_one, one_mul]
    · intro k hk hkpos hk1
      have h1 : (σ ^ k) (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) =
          (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) := by
        rw [hk1]; rfl
      rw [hpow k] at h1
      have h2 : (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ (q₀ ^ k - 1) = 1 := by
        have hqk1 : 1 ≤ q₀ ^ k := Nat.one_le_pow k q₀ hq0pos
        have h3 : (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) ^ (q₀ ^ k - 1) *
            (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) =
            (ζ₀ : CyclotomicField (q₀ ^ n - 1) L) := by
          rw [← pow_succ, Nat.sub_add_cancel hqk1]
          exact h1
        exact mul_right_cancel₀ hζne (by rw [h3, one_mul])
      have h4 : (q₀ ^ n - 1) ∣ q₀ ^ k - 1 := (hζ'.pow_eq_one_iff_dvd _).mp h2
      have h5 : n ∣ k :=
        (Commons.NumberTheory.NumberField.Completion.dvd_pow_sub_one_iff hq02 hn).mp h4
      obtain ⟨c, hc⟩ := h5
      rw [hc] at hk
      have hk' : n * c < n * 1 := by rw [mul_one]; exact hk
      have hc1 : c < 1 := (Nat.mul_lt_mul_left hn).mp hk'
      have hcpos : 0 < c := by
        rcases Nat.eq_zero_or_pos c with h0 | h0
        · rw [hc, h0, mul_zero] at hkpos
          exact absurd hkpos (lt_irrefl 0)
        · exact h0
      omega
  refine ⟨NeZero.ne _, he, ?_⟩
  rw [← horder, hord]

