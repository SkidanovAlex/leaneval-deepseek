variable {p : ℕ}

/-! ## Functoriality of the descending `p`-central series -/

/-- The subgroup generated by the `p`-th powers is monotone. -/
theorem powSubgroup_mono {P : Type*} [Group P] (p : ℕ) {H K : Subgroup P} (h : H ≤ K) :
    powSubgroup p H ≤ powSubgroup p K := by
  rw [powSubgroup, powSubgroup]
  refine Subgroup.closure_mono ?_
  rintro x ⟨y, hy, rfl⟩
  exact ⟨y, h hy, rfl⟩

/-- One step of the functoriality of the descending `p`-central series. -/
theorem map_pCentralStep_le (p : ℕ) {S T : Type*} [Group S] [Group T] (g : S →* T)
    (H : Subgroup S) (K : Subgroup T) (ih : H.map g ≤ K) :
    (pCentralStep p H).map g ≤ pCentralStep p K := by
  have h1 : Subgroup.map g (powSubgroup p H) ≤ powSubgroup p K := by
    rw [map_powSubgroup]
    exact powSubgroup_mono p ih
  have h2 : Subgroup.map g ⁅H, ⊤⁆ ≤ ⁅K, ⊤⁆ := by
    rw [Subgroup.map_commutator]
    exact Subgroup.commutator_mono ih le_top
  show Subgroup.map g (powSubgroup p H ⊔ ⁅H, ⊤⁆) ≤ powSubgroup p K ⊔ ⁅K, ⊤⁆
  rw [Subgroup.map_sup]
  exact sup_le (le_trans h1 le_sup_left) (le_trans h2 le_sup_right)

/-- **The descending `p`-central series is functorial** for arbitrary homomorphisms
(surjectivity is not needed): `g(P_n) ≤ Q_n`. -/
theorem map_pCentralSeries_le (p : ℕ) {S T : Type*} [Group S] [Group T] (g : S →* T) (n : ℕ) :
    (pCentralSeries p S n).map g ≤ pCentralSeries p T n := by
  induction n with
  | zero => rw [pCentralSeries_zero, pCentralSeries_zero]; exact le_top
  | succ n ih =>
    rw [pCentralSeries_succ, pCentralSeries_succ]
    exact map_pCentralStep_le p g _ _ ih

/-! ## Functoriality of `P/P^p[P,P]` -/

/-- The map `P_0 →* Q_0` (i.e. `P →* Q`, reindexed along the two copies of the series). -/
noncomputable def pQTopHom (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T) :
    ↥(pCentralSeries p S 0) →* ↥(pCentralSeries p T 0) where
  toFun x := ⟨g (x : S), by
    rw [show pCentralSeries p T 0 = ⊤ from rfl]
    exact Subgroup.mem_top _⟩
  map_one' := Subtype.ext (map_one g)
  map_mul' a b := Subtype.ext (map_mul g (a : S) (b : S))

@[simp] theorem pQTopHom_coe (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (x : ↥(pCentralSeries p S 0)) :
    ((pQTopHom p g x : ↥(pCentralSeries p T 0)) : T) = g (x : S) := rfl

/-- **The map induced by `g` on the bottom `p`-central quotient** `P/P^p[P,P] →* Q/Q^p[Q,Q]`. -/
noncomputable def pQMapMul (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T) :
    pCentralQuotient p S 0 →* pCentralQuotient p T 0 :=
  QuotientGroup.map ((pCentralSeries p S 1).subgroupOf (pCentralSeries p S 0))
    ((pCentralSeries p T 1).subgroupOf (pCentralSeries p T 0)) (pQTopHom p g)
    (by
      intro x hx
      rw [Subgroup.mem_subgroupOf] at hx
      rw [Subgroup.mem_comap, Subgroup.mem_subgroupOf]
      exact map_pCentralSeries_le p g 1 (Subgroup.mem_map_of_mem g hx))

/-- The computation rule of `pQMapMul` on the canonical generators. -/
theorem pQMapMul_mk (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (x : ↥(pCentralSeries p S 0)) :
    pQMapMul p g (QuotientGroup.mk' ((pCentralSeries p S 1).subgroupOf (pCentralSeries p S 0)) x)
      = QuotientGroup.mk' ((pCentralSeries p T 1).subgroupOf (pCentralSeries p T 0))
          (pQTopHom p g x) :=
  QuotientGroup.map_mk' _ _ _ _ x

/-- Surjectivity of `pQMapMul` for a surjective `g`. -/
theorem pQMapMul_surjective (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (hg : Function.Surjective g) : Function.Surjective (pQMapMul p g) := by
  intro y
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective
    ((pCentralSeries p T 1).subgroupOf (pCentralSeries p T 0)) y
  obtain ⟨s, hs⟩ := hg (x : T)
  refine ⟨QuotientGroup.mk' ((pCentralSeries p S 1).subgroupOf (pCentralSeries p S 0))
    ⟨s, by rw [show pCentralSeries p S 0 = ⊤ from rfl]; exact Subgroup.mem_top _⟩, ?_⟩
  rw [pQMapMul_mk]
  congr 1
  exact Subtype.ext hs

/-- The additive form of `pQMapMul` (the target quotient is elementary abelian). -/
noncomputable def pQMapAdd (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T) :
    Additive (pCentralQuotient p S 0) →+ Additive (pCentralQuotient p T 0) where
  toFun x := Additive.ofMul (pQMapMul p g (Additive.toMul x))
  map_zero' := by
    show Additive.ofMul (pQMapMul p g (Additive.toMul (0 : Additive (pCentralQuotient p S 0)))) = 0
    rw [toMul_zero, map_one, ofMul_one]
  map_add' a b := by
    show Additive.ofMul (pQMapMul p g (Additive.toMul (a + b)))
      = Additive.ofMul (pQMapMul p g (Additive.toMul a))
        + Additive.ofMul (pQMapMul p g (Additive.toMul b))
    rw [toMul_add, map_mul, ofMul_mul]

/-- **The `𝔽_p`-linear map induced by `g` on `P/P^p[P,P]`.** -/
noncomputable def pQMapLin (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T) :
    Additive (pCentralQuotient p S 0) →ₗ[ZMod p] Additive (pCentralQuotient p T 0) :=
  AddMonoidHom.toZModLinearMap p (pQMapAdd p g)

theorem pQMapLin_apply (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (x : Additive (pCentralQuotient p S 0)) :
    pQMapLin p g x = Additive.ofMul (pQMapMul p g (Additive.toMul x)) := rfl

/-- Surjectivity of the `𝔽_p`-linear map on `P/P^p[P,P]` induced by a surjective `g`. -/
theorem pQMapLin_surjective (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (hg : Function.Surjective g) : Function.Surjective (pQMapLin p g) := by
  intro y
  obtain ⟨x, hx⟩ := pQMapMul_surjective p g hg (Additive.toMul y)
  refine ⟨Additive.ofMul x, ?_⟩
  rw [pQMapLin_apply, toMul_ofMul, hx, ofMul_toMul]

/-- The computation rule of `pQMapLin` on the canonical generators `mk' x`. -/
theorem pQMapLin_mk (p : ℕ) {S T : Type} [Group S] [Group T] (g : S →* T)
    (x : ↥(pCentralSeries p S 0)) :
    pQMapLin p g (Additive.ofMul (QuotientGroup.mk'
        ((pCentralSeries p S 1).subgroupOf (pCentralSeries p S 0)) x))
      = Additive.ofMul (QuotientGroup.mk'
          ((pCentralSeries p T 1).subgroupOf (pCentralSeries p T 0)) (pQTopHom p g x)) := by
  rw [pQMapLin_apply, toMul_ofMul, pQMapMul_mk]

/-- **Naturality of the `p`-central quotient on a commuting square.** -/
theorem pQMapLin_square (p : ℕ) {P Q P' Q' : Type} [Group P] [Group Q] [Group P'] [Group Q']
    (f : P →* P') (g : Q →* Q') (φ : P →* Q) (φ' : P' →* Q')
    (h : φ'.comp f = g.comp φ) :
    (pQMapLin p φ').comp (pQMapLin p f) = (pQMapLin p g).comp (pQMapLin p φ) := by
  refine LinearMap.ext (fun x => ?_)
  obtain ⟨q, hq⟩ := QuotientGroup.mk'_surjective
    ((pCentralSeries p P 1).subgroupOf (pCentralSeries p P 0)) (Additive.toMul x)
  have hx : x = Additive.ofMul (QuotientGroup.mk'
      ((pCentralSeries p P 1).subgroupOf (pCentralSeries p P 0)) q) := by
    rw [← ofMul_toMul x, hq]
  rw [hx]
  simp only [LinearMap.comp_apply, pQMapLin_mk]
  have hgoal : pQTopHom p φ' (pQTopHom p f q) = pQTopHom p g (pQTopHom p φ q) :=
    Subtype.ext (by simp only [pQTopHom_coe]; exact (MonoidHom.ext_iff.mp h) (q : P))
  rw [hgoal]

/-! ## The corestriction of the Hochschild–Serre sequence -/

/-- The corestriction `H₁(N, E⊗T) → H₁(Γ, E⊗T)` of `N = F(m)/F(m)^{(ν)} ◁ Γ`, i.e. the first
map of the homological Hochschild–Serre sequence. -/
noncomputable def coresH (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G] (i j : ℕ)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction G T]
    [SMulCommClass G (ZMod p) T] (m : ℕ) :
    (↑(groupHomology.H1 (Rep.res (flowNormal p G m i j).subtype (flowRep p G m i j T))) : Type) →+
      (↑(groupHomology.H1 (flowRep p G m i j T)) : Type) :=
  (((groupHomology.H1CoresCoinfOfTrivial (flowRep p G m i j T)
      (flowNormal p G m i j)).f).hom).toAddMonoidHom

/-- The chosen map `flowHSα` of `SemidirectData.lean` *is* the corestriction. -/
theorem flowHSα_eq_coresH (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G] (i j : ℕ)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction G T]
    [SMulCommClass G (ZMod p) T] (m : ℕ) :
    flowHSα p G i j T m = coresH p G i j T m := by
  refine AddMonoidHom.ext (fun x => ?_)
  exact (flowHS_spec p G i j T m).1 x

/-! ## The restricted coefficient morphism and the induced map on `H₁` -/

/-- The coefficient morphism `E(m,τ)⊗T ⟶ E(n,τ)⊗T` viewed over the normal subgroups
`F(m)/F(m)^{(ν)} →* F(n)/F(n)^{(ν)}` (the restriction of `flowRepMap Φ T`). -/
noncomputable def flowRepMapN (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G] (i j : ℕ)
    {m n : ℕ} (Φ : OperatorMap G m n) (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction G T] [SMulCommClass G (ZMod p) T] :
    Rep.res (flowNormal p G m i j).subtype (flowRep p G m i j T) ⟶
      Rep.res (flowNormalSubMap p G i j Φ)
        (Rep.res (flowNormal p G n i j).subtype (flowRep p G n i j T)) :=
  Rep.ofHom (LinearMap.intertwiningMap_of_isIntertwiningMap _ _
    ((Rep.Hom.hom (flowRepMap (p := p) G i j Φ T)).toLinearMap) (fun x w => by
      have hx : (flowNormal p G m i j).subtype x =
          flowInl (G := G) p m i j ((flowNormalEquiv (G := G) p m i j).symm x) := by
        rw [← flowNormalEquiv_apply (G := G) p m i j
          ((flowNormalEquiv (G := G) p m i j).symm x), MulEquiv.apply_symm_apply]
        rfl
      have hy : (flowNormal p G n i j).subtype (flowNormalSubMap p G i j Φ x) =
          flowInl (G := G) p n i j ((flowNormalEquiv (G := G) p n i j).symm
            (flowNormalSubMap p G i j Φ x)) := by
        rw [← flowNormalEquiv_apply (G := G) p n i j
          ((flowNormalEquiv (G := G) p n i j).symm (flowNormalSubMap p G i j Φ x)),
          MulEquiv.apply_symm_apply]
        rfl
      simp only [Rep.res_obj_ρ, MonoidHom.comp_apply, hx, hy, flowQuot_inl, map_one,
        Module.End.one_apply]))

/-- The underlying linear map of `flowRepMapN` is the graded map tensored with the identity. -/
theorem flowRepMapN_hom (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G] (i j : ℕ)
    {m n : ℕ} (Φ : OperatorMap G m n) (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction G T] [SMulCommClass G (ZMod p) T] :
    (Rep.Hom.hom (flowRepMapN (p := p) G i j Φ T)).toLinearMap
      = (gradedMapLin p Φ.toHom Φ.surjective i j).rTensor T := rfl

/-- The map on group homology over the normal subgroups induced by an operator map. -/
noncomputable def mapNormal (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G] (i j : ℕ)
    {m n : ℕ} (Φ : OperatorMap G m n) (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction G T] [SMulCommClass G (ZMod p) T] :
    (↑(groupHomology.H1 (Rep.res (flowNormal p G m i j).subtype (flowRep p G m i j T))) : Type) →+
      (↑(groupHomology.H1 (Rep.res (flowNormal p G n i j).subtype (flowRep p G n i j T))) : Type) :=
  ((groupHomology.map (flowNormalSubMap p G i j Φ) (flowRepMapN (p := p) G i j Φ T) 1).hom).toAddMonoidHom

end Work.CohomologicalShrinking.naturalAlpha
