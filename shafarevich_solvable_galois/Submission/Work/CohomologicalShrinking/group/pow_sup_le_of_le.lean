namespace Work.CohomologicalShrinking.group

open scoped commutatorElement

/-- In a group, if all elements of a subgroup generated by `S` commute pairwise and every
element of `S` has `n`-th power `1`, then every element of the generated subgroup has
`n`-th power `1`.  This is the abelian-group computation `(x*y)^n = x^n * y^n`. -/
theorem closure_pow_eq_one_of_comm {Q : Type*} [Group Q] {n : ℕ} {S : Set Q}
    (hcomm : ∀ x ∈ Subgroup.closure S, ∀ y ∈ Subgroup.closure S, Commute x y)
    (hS : ∀ s ∈ S, s ^ n = 1) :
    ∀ x ∈ Subgroup.closure S, x ^ n = 1 := by
  intro x hx
  refine Subgroup.closure_induction (p := fun z _ => z ^ n = 1) ?_ ?_ ?_ ?_ hx
  · intro s hs
    exact hS s hs
  · simp
  · intro a b ha hb iha ihb
    rw [(hcomm a ha b hb).mul_pow n, iha, ihb, one_mul]
  · intro a ha iha
    rw [inv_pow, iha, inv_one]

theorem pow_sup_le_of_le {P : Type*} [Group P] {K A B : Subgroup P} [K.Normal] {p : ℕ}
    (hA : ∀ a ∈ A, a ^ p ∈ K) (hB : ∀ b ∈ B, b ^ p ∈ K) (hcomm : ⁅A ⊔ B, A ⊔ B⁆ ≤ K) :
    ∀ x ∈ A ⊔ B, x ^ p ∈ K := by
  let ψ : P →* P ⧸ K := QuotientGroup.mk' K
  let M : Subgroup (P ⧸ K) := Subgroup.map ψ (A ⊔ B)
  have hker : ψ.ker = K := QuotientGroup.ker_mk' K
  have hMap : M = Subgroup.map ψ (A ⊔ B) := rfl
  -- `M` is abelian, because it is the image of the subgroup `A ⊔ B` whose commutator lies in `K`
  have hMMle : ⁅M, M⁆ ≤ ⊥ := by
    have h1 : ⁅M, M⁆ = Subgroup.map ψ ⁅A ⊔ B, A ⊔ B⁆ := by
      rw [hMap]
      exact (Subgroup.map_commutator (A ⊔ B) (A ⊔ B) ψ).symm
    rw [h1]
    calc Subgroup.map ψ ⁅A ⊔ B, A ⊔ B⁆ ≤ Subgroup.map ψ K := Subgroup.map_mono hcomm
      _ = ⊥ := by rw [Subgroup.map_eq_bot_iff]; exact le_of_eq hker.symm
  have hab : ∀ x ∈ M, ∀ y ∈ M, Commute x y := by
    intro x hx y hy
    have hmem : ⁅x, y⁆ ∈ (⊥ : Subgroup (P ⧸ K)) :=
      Subgroup.commutator_le.mp hMMle x hx y hy
    rw [Subgroup.mem_bot] at hmem
    exact commutatorElement_eq_one_iff_commute.mp hmem
  -- `M` is generated by the images of `A` and `B`
  let k : Set (P ⧸ K) := (Subgroup.map ψ A : Set (P ⧸ K)) ∪ (Subgroup.map ψ B : Set (P ⧸ K))
  have hk : Subgroup.closure k = M := by
    rw [hMap, Subgroup.map_sup A B ψ, Subgroup.sup_eq_closure]
  have hS : ∀ s ∈ k, s ^ p = 1 := by
    intro s hs
    rcases hs with hs | hs
    · obtain ⟨a, ha, hsa⟩ := Subgroup.mem_map.mp hs
      rw [← hsa, ← map_pow]
      exact MonoidHom.mem_ker.mp (hker.symm ▸ hA a ha)
    · obtain ⟨b, hb, hsb⟩ := Subgroup.mem_map.mp hs
      rw [← hsb, ← map_pow]
      exact MonoidHom.mem_ker.mp (hker.symm ▸ hB b hb)
  have hclosure : ∀ y ∈ Subgroup.closure k, y ^ p = 1 :=
    closure_pow_eq_one_of_comm (fun x hx y hy => hab x (hk ▸ hx) y (hk ▸ hy)) hS
  have hpow : ∀ y ∈ M, y ^ p = 1 := fun y hy => hclosure y (hk.symm ▸ hy)
  intro x hx
  have hxM : ψ x ∈ M := by
    rw [hMap]
    exact Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
  have h1 : ψ (x ^ p) = 1 := by
    rw [map_pow]
    exact hpow (ψ x) hxM
  exact hker ▸ MonoidHom.mem_ker.mp h1

end Work.CohomologicalShrinking.group
