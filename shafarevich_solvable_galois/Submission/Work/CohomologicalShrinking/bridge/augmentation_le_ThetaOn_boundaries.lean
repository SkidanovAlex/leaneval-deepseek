/-
# `I_G·M^♯` is covered by `Θ(B₁(G,M))`

The file `Submission.Work.CohomologicalShrinking.Bridge.Core` sets up the concrete dimension-shift
map

`Θ : Z₁(G,M) → ker(N_{M^♯})`,   `Θ x = x - δ_1(∑ x)`,

between the `1`-cycles of `M` and the kernel of the norm on the `I_G`-twist `M^♯ = coindUp G M`,
and computes it on the generators `d₂₁ (single (p,q) a)` of the `2`-chains:

`Θ (d₂₁ (single (p,q) a)) = q⁻¹ • φ_{p,a} - φ_{p,a}`,   `φ_{p,a} = δ_1(p⁻¹•a) - δ_p(a) ∈ M^♯`.

Here we prove the surjectivity of `Θ` on the *boundaries*: every element of the augmentation
submodule `I_G·M^♯` is the image of a `1`-boundary.  Equivalently, the map induced by `Θ` on the
quotient is an isomorphism `H₁(G,M) = Z₁/B₁ ≅ Ĥ⁻¹(G,M^♯)` (the companion file
`ThetaOn_augmentation_of_mem_boundaries` gives the other inclusion `Θ(B₁) ⊆ I_G·M^♯`).

The argument is the explicit dimension shift.  The `G`-module `M^♯` is generated by the elements
`ψ_{p,m} = -φ_{p,m}` (for `p ∈ G`, `m ∈ M`): every `a ∈ M^♯` is `∑_p ψ_{p, a p}`, because
`∑_p δ_p(a p) = a` and `∑_p δ_1(p⁻¹•a p) = 0` on `M^♯`.  Consequently

`a - g•a = ∑_p (g•φ_{p,a p} - φ_{p,a p})`,

and each single summand is `Θ (d₂₁ (single (p, g⁻¹) (a p)))`, a boundary.  Since
`I_G·M^♯` is generated by the elements `g•a - a`, it is contained in `Θ(B₁(G,M))`.
-/
import Mathlib
import Submission.Work.CohomologicalShrinking.Bridge.Core
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open scoped BigOperators

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

namespace Work.CohomologicalShrinking.bridge

variable {G : Type} [Group G] [Fintype G] [DecidableEq G]
variable {k : Type} [CommRing k]
variable {M : Type} [AddCommGroup M] [Module k M] [DistribMulAction G M] [SMulCommClass G k M]

/-! ## The `1`-boundaries are `1`-cycles -/

theorem aug_le_B_le_Z {x : G →₀ M} (hx : x ∈ Work.Bridge.B k G M) : x ∈ Work.Bridge.Z k G M :=
  groupHomology.boundaries₁_le_cycles₁ (Work.Bridge.repM k G M) hx

/-! ## The generators `φ_{p,m}` of the `I_G`-twist and the decomposition of `M^♯` -/

/-- The element `φ_{p,m} = δ_1(p⁻¹•m) - δ_p(m)` of `M^♯`. -/
noncomputable def aug_le_phiElem (p : G) (m : M) : ↥(Work.Bridge.A (G:=G) (M:=M)) :=
  ⟨Work.Bridge.phiFun (G:=G) p m, Work.Bridge.phiFun_mem (G:=G) (M:=M) p m⟩

theorem aug_le_coe_phiElem (p : G) (m : M) :
    ((aug_le_phiElem p m : ↥(Work.Bridge.A (G:=G) (M:=M))) : G → M)
      = Work.Bridge.phiFun (G:=G) p m := rfl

/-- The element `ψ_{p,m} = -φ_{p,m} = δ_p(m) - δ_1(p⁻¹•m)` of `M^♯`. -/
noncomputable def aug_le_psi (p : G) (m : M) : ↥(Work.Bridge.A (G:=G) (M:=M)) :=
  -(aug_le_phiElem p m)

theorem aug_le_coe_psi (p : G) (m : M) :
    ((aug_le_psi p m : ↥(Work.Bridge.A (G:=G) (M:=M))) : G → M)
      = Work.Bridge.eg (G:=G) p m - Work.Bridge.d1 (G:=G) (p⁻¹ • m) := by
  show -(Work.Bridge.phiFun (G:=G) p m) = _
  rw [Work.Bridge.phiFun, neg_sub]

theorem aug_le_sum_eg_eq_self (f : G → M) :
    (∑ p : G, Work.Bridge.eg (G:=G) p (f p)) = f := by
  funext x
  rw [Finset.sum_apply]
  rw [Finset.sum_eq_single x]
  · simp
  · intro b _ hb
    rw [Work.Bridge.eg_apply, if_neg (Ne.symm hb)]
  · intro h; exact absurd (Finset.mem_univ x) h

theorem aug_le_sum_d1_eq (c : G → M) :
    (∑ p : G, Work.Bridge.d1 (G:=G) (c p)) = Work.Bridge.d1 (G:=G) (∑ p : G, c p) := by
  funext x
  simp only [Finset.sum_apply, Work.Bridge.d1_apply]
  by_cases hx : x = 1 <;> simp [hx]

/-- The `ψ_{p,m}` generate `M^♯`: `a = ∑_p ψ_{p, a p}`. -/
theorem aug_le_sum_psi_eq (a : ↥(Work.Bridge.A (G:=G) (M:=M))) :
    (∑ p : G, aug_le_psi p ((a : G → M) p)) = a := by
  apply Subtype.ext
  change (Work.Bridge.A (G:=G) (M:=M)).subtype
      (∑ p : G, aug_le_psi p ((a : G → M) p))
    = (Work.Bridge.A (G:=G) (M:=M)).subtype a
  rw [map_sum (Work.Bridge.A (G:=G) (M:=M)).subtype
    (fun p => aug_le_psi p ((a : G → M) p)) Finset.univ]
  simp only [AddSubgroup.subtype_apply]
  rw [Finset.sum_congr rfl (fun p _ => aug_le_coe_psi p ((a : G → M) p)),
    Finset.sum_sub_distrib, aug_le_sum_eg_eq_self, aug_le_sum_d1_eq,
    show (∑ p : G, p⁻¹ • (a : G → M) p) = 0 from Work.Tate.mem_coindUp_iff.mp a.2]
  simp

/-! ## `Θ` restricted to the `1`-boundaries -/

/-- The restriction of `Θ` to the `1`-boundaries `B₁(G,M)`, as an additive map into `M^♯`. -/
noncomputable def aug_le_ThetaOnB : ↥(Work.Bridge.B k G M) →+
    ↥(Work.Bridge.A (G:=G) (M:=M)) where
  toFun b := ((Work.Bridge.ThetaOn k G M ⟨(b : G →₀ M), aug_le_B_le_Z b.2⟩ :
      Work.Bridge.K (G:=G) (M:=M)) : Work.Bridge.A (G:=G) (M:=M))
  map_zero' := by
    apply Subtype.ext
    rw [Work.Bridge.ThetaOn_coe]
    simp [Work.Bridge.thetaFun_zero]
  map_add' x y := by
    apply Subtype.ext
    simp only [AddSubgroup.coe_add, Work.Bridge.ThetaOn_coe, Subtype.coe_mk]
    rw [Submodule.coe_add, Work.Bridge.thetaFun_add]

@[simp] theorem aug_le_ThetaOnB_coe (b : ↥(Work.Bridge.B k G M)) :
    ((aug_le_ThetaOnB (k:=k) (G:=G) (M:=M) b : ↥(Work.Bridge.A (G:=G) (M:=M))) : G → M)
      = Work.Bridge.thetaFun (b : G →₀ M) := rfl

/-- The key computation on generators: `g•φ_{p,m} - φ_{p,m} = Θ (d₂₁ (single (p,g⁻¹) m))`
is in the image of `Θ|B₁`. -/
theorem aug_le_exists_boundary_thetaElem_smul_phi (g p : G) (m : M) :
    ∃ b : ↥(Work.Bridge.B k G M),
      aug_le_ThetaOnB (k:=k) (G:=G) (M:=M) b
        = g • aug_le_phiElem p m - aug_le_phiElem p m := by
  have hB : (groupHomology.d₂₁ (Work.Bridge.repM k G M)).hom (Finsupp.single (p, g⁻¹) m)
      ∈ Work.Bridge.B k G M :=
    LinearMap.mem_range.mpr ⟨Finsupp.single (p, g⁻¹) m, rfl⟩
  refine ⟨⟨(groupHomology.d₂₁ (Work.Bridge.repM k G M)).hom (Finsupp.single (p, g⁻¹) m),
    hB⟩, ?_⟩
  apply Subtype.ext
  rw [aug_le_ThetaOnB_coe, Work.Bridge.thetaFun_d21_single, inv_inv, AddSubgroup.coe_sub,
    Work.Tate.coe_smul_coindUp, aug_le_coe_phiElem]

/-! ## The augmentation submodule is contained in `Θ(B₁)` -/

theorem aug_le_smul_sub_self_mem_range (g : G) (a : ↥(Work.Bridge.A (G:=G) (M:=M))) :
    g • a - a ∈ (aug_le_ThetaOnB (k:=k) (G:=G) (M:=M)).range := by
  have h1 : a - g • a
      = ∑ p : G, (g • aug_le_phiElem p ((a : G → M) p)
          - aug_le_phiElem p ((a : G → M) p)) := by
    conv_lhs => rw [← aug_le_sum_psi_eq a]
    rw [Work.Tate.smul_sum_univ, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun p _ => ?_)
    show aug_le_psi p ((a : G → M) p) - g • aug_le_psi p ((a : G → M) p)
        = g • aug_le_phiElem p ((a : G → M) p) - aug_le_phiElem p ((a : G → M) p)
    rw [aug_le_psi, smul_neg]
    abel
  have hmem : (∑ p : G, (g • aug_le_phiElem p ((a : G → M) p)
        - aug_le_phiElem p ((a : G → M) p)))
      ∈ (aug_le_ThetaOnB (k:=k) (G:=G) (M:=M)).range :=
    AddSubgroup.sum_mem _
      (fun p _ => AddMonoidHom.mem_range.mpr
        (aug_le_exists_boundary_thetaElem_smul_phi (k:=k) (G:=G) (M:=M) g p
          ((a : G → M) p)))
  rw [← h1] at hmem
  have h2 : g • a - a = -(a - g • a) := by abel
  rw [h2]
  exact neg_mem hmem

theorem augmentation_le_ThetaOn_boundaries (k : Type) [CommRing k] (G : Type) [Group G]
    [Fintype G] [DecidableEq G] (M : Type) [AddCommGroup M] [Module k M] [DistribMulAction G M]
    [SMulCommClass G k M] (y : Work.Bridge.A (G:=G) (M:=M))
    (hy : y ∈ Work.Tate.augmentation G (Work.Bridge.A (G:=G) (M:=M))) :
    ∃ b : ↥(Work.Bridge.Z k G M), (b : G →₀ M) ∈ Work.Bridge.B k G M ∧
      ((Work.Bridge.ThetaOn k G M b : Work.Bridge.K (G:=G) (M:=M))
        : Work.Bridge.A (G:=G) (M:=M)) = y := by
  have hS : Work.Tate.augmentation G (Work.Bridge.A (G:=G) (M:=M)) ≤
      (aug_le_ThetaOnB (k:=k) (G:=G) (M:=M)).range := by
    rw [Work.Tate.augmentation, AddSubgroup.closure_le]
    rintro _ ⟨⟨g, a⟩, rfl⟩
    exact aug_le_smul_sub_self_mem_range (k:=k) g a
  obtain ⟨b, hb⟩ := hS hy
  exact ⟨⟨(b : G →₀ M), aug_le_B_le_Z b.2⟩, b.2, hb⟩

end Work.CohomologicalShrinking.bridge
