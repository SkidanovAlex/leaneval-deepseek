namespace Work.GenericKernelReduction

/-- **A `ℚ`-algebra automorphism of a compositum fixing each factor pointwise is the identity.**

Let `M : ι → IntermediateField ℚ (AlgebraicClosure ℚ)` be a finite family of intermediate fields
of `ℚ̄/ℚ`, let `K = ⨆ i, M i` be their compositum (as an intermediate field of `ℚ̄`), and let
`σ : K ≃ₐ[ℚ] K` be a `ℚ`-algebra automorphism of `K` which fixes, for every `i`, the image of
`M i` in `K` pointwise.  Then `σ = 1`.

Since `K` is generated as a `ℚ`-algebra by the union of the images of the `M i`, it suffices to
show that `σ` fixes a `ℚ`-subfield of `K` containing all those images, and that the subfield
generated by them is everything.  The latter is the statement
`⨆ i, (M i).restrict hᵢ = ⊤`, proved by applying the injective `IntermediateField.lift`
(lifting intermediate fields of `↥(⨆ i, M i)` to `ℚ̄`), which sends `(M i).restrict hᵢ` back to
`M i` and sends `⊤` to `⨆ i, M i`. -/
theorem algEquiv_eq_one_of_fixes_iSup {ι : Type} [Fintype ι] (M : ι → IntermediateField ℚ (AlgebraicClosure ℚ)) [FiniteDimensional ℚ ↥(⨆ i, M i)] (σ : (↥(⨆ i, M i)) ≃ₐ[ℚ] (↥(⨆ i, M i))) (h : ∀ i (y : ↥(M i)), σ ⟨(y : AlgebraicClosure ℚ), le_iSup (fun j => M j) i y.2⟩ = ⟨(y : AlgebraicClosure ℚ), le_iSup (fun j => M j) i y.2⟩) : σ = 1 := by
  -- The subgroup of `Gal(K/ℚ)` generated by `σ`; all its elements fix the field we build.
  let H : Subgroup Gal(↥(⨆ i, M i)/ℚ) := Subgroup.closure {σ}
  -- Each `M i`, restricted to the compositum `K = ⨆ i, M i`, has the property that the `⨆` of
  -- these restrictions is all of `K`.  (This is where `K = ⨆ i, M i` is used.)
  have hsup : (⨆ i, (M i).restrict (le_iSup (fun j => M j) i)) = ⊤ := by
    apply IntermediateField.lift_injective (⨆ j, M j)
    have hstep : IntermediateField.lift (⨆ i, (M i).restrict (le_iSup (fun j => M j) i))
        = ⨆ i, M i := by
      change IntermediateField.map (IntermediateField.val (⨆ j, M j))
        (⨆ i, (M i).restrict (le_iSup (fun j => M j) i)) = ⨆ i, M i
      rw [IntermediateField.map_iSup]
      apply iSup_congr
      intro i
      change IntermediateField.lift ((M i).restrict (le_iSup (fun j => M j) i)) = M i
      rw [IntermediateField.lift_restrict]
    rw [hstep, IntermediateField.lift_top ℚ (⨆ j, M j)]
  -- `σ` fixes the restricted `M i` pointwise, hence lies in the fixing subgroup of each.
  have hle : (⨆ i, (M i).restrict (le_iSup (fun j => M j) i))
      ≤ IntermediateField.fixedField H := by
    apply iSup_le
    intro i
    refine (IntermediateField.le_iff_le H ((M i).restrict (le_iSup (fun j => M j) i))).mpr ?_
    refine (Subgroup.closure_le _).mpr ?_
    rw [Set.singleton_subset_iff]
    refine (IntermediateField.mem_fixingSubgroup_iff
      ((M i).restrict (le_iSup (fun j => M j) i)) σ).mpr ?_
    intro x hx
    have hx' : (x : AlgebraicClosure ℚ) ∈ M i :=
      ((M i).mem_restrict (le_iSup (fun j => M j) i) x).mp hx
    have key := h i ⟨(x : AlgebraicClosure ℚ), hx'⟩
    have hxeq : x = ⟨(x : AlgebraicClosure ℚ), le_iSup (fun j => M j) i hx'⟩ := Subtype.ext rfl
    rw [hxeq]
    exact key
  -- Therefore everything of `K` is fixed by `σ`.
  have htop := hsup ▸ hle
  have hfix : ∀ x : ↥(⨆ i, M i), σ x = x := by
    intro x
    exact (IntermediateField.mem_fixedField_iff H x).mp (htop (by simp)) σ
      (Subgroup.subset_closure (Set.mem_singleton σ))
  exact AlgEquiv.ext hfix

end Work.GenericKernelReduction
