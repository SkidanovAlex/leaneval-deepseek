/-- **A `G`-equivariant surjection onto any finite `G`-operator group, from a free group.**

For a finite group `G`, a finite `G`-operator group `P` (with `[MulDistribMulAction G P]`) there
are `n`, an action `ρ : G →* MulAut (FreeGroup (Fin n))` on the free group of rank `n`, and a
`G`-equivariant surjection `φ : FreeGroup (Fin n) →* P`.

Construction: index the free generators by `P` itself (`n = Nat.card P`), let `G` permute them
through its action on `P` (this is `FreeGroup.freeGroupCongr` applied to the permutation
`σ g : i ↦ g • i`), and let `φ` be the unique homomorphism sending the generator `p` to `p`
(`FreeGroup.lift`).  `φ` is surjective because `P` is generated by itself, and it is equivariant
on generators, hence everywhere.  This is the "free `G`-operator group" step of the generic-kernel
reduction (see the module docstring of `Work.GenericKernelReduction.Defs`). -/
theorem exists_equivariant_surjection_freeGroup_of_finite {G : Type*} [Group G] [Finite G]
    {P : Type*} [Group P] [Finite P] [MulDistribMulAction G P] :
    ∃ (n : ℕ) (ρ : G →* MulAut (FreeGroup (Fin n))) (φ : FreeGroup (Fin n) →* P),
      Function.Surjective φ ∧
      ∀ (g : G) (x : FreeGroup (Fin n)),
        φ (ρ g x) = (MulDistribMulAction.toMulAut G P g) (φ x) := by
  classical
  letI : Fintype P := Fintype.ofFinite P
  let n : ℕ := Fintype.card P
  let e : Fin n ≃ P := (Fintype.equivFin P).symm
  -- the permutation of the index set induced by the action of `G` on `P`
  let σ : G → Fin n ≃ Fin n := fun g =>
    { toFun := fun i => e.symm (g • e i)
      invFun := fun i => e.symm (g⁻¹ • e i)
      left_inv := by
        intro i
        show e.symm (g⁻¹ • e (e.symm (g • e i))) = i
        rw [Equiv.apply_symm_apply, ← SemigroupAction.mul_smul, inv_mul_cancel, one_smul,
          Equiv.symm_apply_apply]
      right_inv := by
        intro i
        show e.symm (g • e (e.symm (g⁻¹ • e i))) = i
        rw [Equiv.apply_symm_apply, ← SemigroupAction.mul_smul, mul_inv_cancel, one_smul,
          Equiv.symm_apply_apply] }
  have hσ1 : σ 1 = Equiv.refl (Fin n) := by
    refine Equiv.ext fun i => ?_
    show e.symm (1 • e i) = i
    rw [one_smul, Equiv.symm_apply_apply]
  have hσmul : ∀ g h : G, σ (g * h) = (σ h).trans (σ g) := by
    intro g h
    refine Equiv.ext fun i => ?_
    show e.symm ((g * h) • e i) = e.symm (g • e (e.symm (h • e i)))
    rw [Equiv.apply_symm_apply, ← SemigroupAction.mul_smul]
  -- the action of `G` on the free group permuting the generators
  let ρ : G →* MulAut (FreeGroup (Fin n)) :=
    { toFun := fun g => FreeGroup.freeGroupCongr (σ g)
      map_one' := by rw [hσ1, FreeGroup.freeGroupCongr_refl]; rfl
      map_mul' := fun g h => by rw [hσmul g h, ← FreeGroup.freeGroupCongr_trans]; rfl }
  -- the canonical surjection sending the generator indexed by `p` to `p`
  let φ : FreeGroup (Fin n) →* P := FreeGroup.lift (fun i => e i)
  refine ⟨n, ρ, φ, ?_, ?_⟩
  · intro p
    refine ⟨FreeGroup.of (e.symm p), ?_⟩
    show FreeGroup.lift (fun i => e i) (FreeGroup.of (e.symm p)) = p
    rw [FreeGroup.lift_apply_of, Equiv.apply_symm_apply]
  · intro g x
    induction x using FreeGroup.induction_on with
    | one => simp
    | of i =>
        show FreeGroup.lift (fun i => e i) (FreeGroup.freeGroupCongr (σ g) (FreeGroup.of i))
          = (MulDistribMulAction.toMulAut G P g) (FreeGroup.lift (fun i => e i) (FreeGroup.of i))
        rw [FreeGroup.freeGroupCongr_apply, FreeGroup.map.of, FreeGroup.lift_apply_of,
          FreeGroup.lift_apply_of]
        show e (σ g i) = (MulDistribMulAction.toMulAut G P g) (e i)
        show e (e.symm (g • e i)) = (MulDistribMulAction.toMulAut G P g) (e i)
        rw [Equiv.apply_symm_apply, MulDistribMulAction.toMulAut_apply,
          MulDistribMulAction.toMulEquiv_apply]
    | inv_of i ih =>
        simp only [map_inv]
        exact congrArg Inv.inv ih
    | mul x y ihx ihy =>
        simp only [map_mul]
        exact congrArg₂ HMul.hMul ihx ihy

/-- **Every finite `G`-operator `p`-group is a `G`-equivariant quotient of a generic kernel.**

Let `G` be a finite group, `p` a prime and `P` a finite `p`-group carrying a `G`-action by group
automorphisms (`[MulDistribMulAction G P]`).  Then for suitable `n` and `ν` the generic kernel
`F^(n)/F^(n)(ν) = Work.ProP.FreePQuotient p n ν` carries a `G`-action `Φ` *descending* from an
action `ρ` of `G` on the free group `F^(n) = FreeGroup (Fin n)` (i.e.
`Φ g (mk x) = mk (ρ g x)`), and there is a surjective `G`-equivariant homomorphism
`f : F^(n)/F^(n)(ν) →* P`.

This is the statement used in Schmidt–Wingberg, §5 (Theorem 15) that *every finite `G`-operator
`p`-group is a quotient of `F^(n)/F^(n)(τ)` for some `n, τ`*, in its discrete form.

Proof: first produce a `G`-equivariant surjection `φ : F^(n) →* P` from a free group
(`exists_equivariant_surjection_freeGroup_of_finite`), then apply the equivariant generic-kernel
corollary `Work.ProP.exists_surjective_freePQuotient_equivariant`, which supplies `ν`, the
descended action `Φ` and the equivariant factorization `f`. -/
theorem exists_equivariant_quotient_freePQuotient {G : Type*} [Group G] [Finite G] {p : ℕ}
    [Fact p.Prime] {P : Type*} [Group P] [Finite P] [MulDistribMulAction G P]
    (hP : IsPGroup p P) :
    ∃ (n ν : ℕ) (ρ : G →* MulAut (FreeGroup (Fin n)))
      (Φ : G →* MulAut (Work.ProP.FreePQuotient p n ν))
      (f : Work.ProP.FreePQuotient p n ν →* P),
      Function.Surjective f ∧
      (∀ (g : G) (x : FreeGroup (Fin n)),
        Φ g (Work.ProP.freePQuotientMk p n ν x) = Work.ProP.freePQuotientMk p n ν (ρ g x)) ∧
      (∀ (g : G) (y : Work.ProP.FreePQuotient p n ν),
        f (Φ g y) = (MulDistribMulAction.toMulAut G P g) (f y)) := by
  obtain ⟨n, ρ, φ, hφ, heq⟩ := exists_equivariant_surjection_freeGroup_of_finite (G := G) (P := P)
  obtain ⟨ν, Φ, f, hf, hΦ, hfeq⟩ :=
    Work.ProP.exists_surjective_freePQuotient_equivariant (p := p) hP ρ φ hφ heq
  exact ⟨n, ν, ρ, Φ, f, hf, hΦ, hfeq⟩

end Work.GenericKernelReduction
