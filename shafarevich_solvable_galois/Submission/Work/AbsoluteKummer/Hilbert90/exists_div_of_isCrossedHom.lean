/-- **Hilbert's theorem 90 for the absolute Galois group**, in the `Gal(k̄/k)` language: a locally
constant crossed homomorphism `Gal(k̄/k) → k̄ˣ` is a coboundary. -/
theorem exists_div_of_isCrossedHom_gal {k : Type*} [Field k] [IsGalois k (AlgebraicClosure k)]
    (f : Gal(AlgebraicClosure k / k) → (AlgebraicClosure k)ˣ)
    (hf : ∀ σ τ : Gal(AlgebraicClosure k / k),
      f (σ * τ) = f σ * Work.AbsoluteKummer.algEquivUnitsMap k σ (f τ))
    (hc : Work.AbsoluteKummer.IsLocallyConstant f) :
    ∃ b : (AlgebraicClosure k)ˣ, ∀ σ : Gal(AlgebraicClosure k / k),
      f σ = Work.AbsoluteKummer.algEquivUnitsMap k σ b / b := by
  -- `f 1 = 1`, from the cocycle identity.
  have hf1 : f 1 = 1 := by
    have h := hf 1 1
    rw [one_mul, Work.AbsoluteKummer.algEquivUnitsMap_one] at h
    exact (mul_eq_left.mp h.symm)
  -- Local constancy at `1` supplies an open neighbourhood `U` of `1` on which `f` is trivial.
  obtain ⟨U, hUopen, h1U, hUc⟩ := hc 1
  have hfU : ∀ y ∈ U, f y = 1 := fun y hy => by rw [hUc y hy, hf1]
  have hUn : U ∈ 𝓝 (1 : Gal(AlgebraicClosure k / k)) := hUopen.mem_nhds h1U
  -- The Krull topology: `U` contains the fixing subgroup of a finite *normal* subextension `M`.
  obtain ⟨M, hMfin, hMnorm, hMsub⟩ :=
    (krullTopology_mem_nhds_one_iff_of_normal k (AlgebraicClosure k) U).mp hUn
  have hker : (AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M).ker
      = M.fixingSubgroup :=
    IntermediateField.restrictNormalHom_ker M
  have hNnormal : M.fixingSubgroup.Normal := by
    rw [← hker]; exact MonoidHom.normal_ker _
  have hfN : ∀ n ∈ M.fixingSubgroup, f n = 1 := fun n hn => hfU n (hMsub hn)
  -- `f` is invariant under right multiplication by `N = Gal(k̄/M)`.
  have hNinv : ∀ (a n : Gal(AlgebraicClosure k / k)),
      n ∈ M.fixingSubgroup → f (a * n) = f a := by
    intro a n hn
    rw [hf a n, hfN n hn, map_one, mul_one]
  -- All values of `f` lie in `M`.
  have hmem : ∀ a : Gal(AlgebraicClosure k / k), (f a : AlgebraicClosure k) ∈ M := by
    intro a
    rw [← InfiniteGalois.fixedField_fixingSubgroup M]
    rw [IntermediateField.mem_fixedField_iff]
    intro n hn
    have h1 : f (n * a) = Work.AbsoluteKummer.algEquivUnitsMap k n (f a) := by
      rw [hf n a, hfN n hn, one_mul]
    have h2 : f (n * a) = f a := by
      have heq : n * a = a * (a⁻¹ * n * a) := by group
      rw [heq, hNinv a (a⁻¹ * n * a) (hNnormal.conj_mem n hn a⁻¹)]
    have h3 : (Work.AbsoluteKummer.algEquivUnitsMap k n (f a) : AlgebraicClosure k)
        = (f a : AlgebraicClosure k) := by
      rw [← h1, h2]
    simpa using h3
  -- Restriction to the finite Galois extension `M/k` is onto, so we may choose lifts.
  have hsurj : Function.Surjective
      (AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) :=
    AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := ↥M) (AlgebraicClosure k)
  let lift : (↥M ≃ₐ[k] ↥M) → Gal(AlgebraicClosure k / k) := fun χ => Classical.choose (hsurj χ)
  have hlift : ∀ χ : (↥M ≃ₐ[k] ↥M),
      AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M (lift χ) = χ :=
    fun χ => Classical.choose_spec (hsurj χ)
  -- The restriction of an absolute automorphism acts on `M` as the automorphism itself.
  have happ : ∀ (σ : Gal(AlgebraicClosure k / k)) (x : ↥M),
      (((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ) x :
          AlgebraicClosure k) = σ (x : AlgebraicClosure k) :=
    fun σ x => AlgEquiv.restrictNormalHom_apply (F := k) (K₁ := AlgebraicClosure k) M σ x
  have happ' : ∀ (χ : (↥M ≃ₐ[k] ↥M)) (x : ↥M),
      (((χ x) : ↥M) : AlgebraicClosure k) = (lift χ) (x : AlgebraicClosure k) := by
    intro χ x
    conv_lhs => rw [← hlift χ]
    exact happ (lift χ) x
  -- The descended cocycle `g : Gal(M/k) → Mˣ`.
  let g : (↥M ≃ₐ[k] ↥M) → (↥M)ˣ := fun χ =>
    Units.mk0 ⟨(f (lift χ) : AlgebraicClosure k), hmem (lift χ)⟩ (by
      intro h0
      have h1 : (f (lift χ) : AlgebraicClosure k) = 0 := by
        have := congrArg (fun x : ↥M => (x : AlgebraicClosure k)) h0
        simpa using this
      exact Units.ne_zero (f (lift χ)) h1)
  have hgval : ∀ χ : (↥M ≃ₐ[k] ↥M),
      (f (lift χ) : AlgebraicClosure k) = ((g χ : ↥M) : AlgebraicClosure k) := by
    intro χ
    simp only [g, Units.val_mk0, Subtype.coe_mk]
  -- `g` is a crossed homomorphism.
  have hgcoc : ∀ χ ψ : (↥M ≃ₐ[k] ↥M), ((g (χ * ψ) : (↥M)ˣ) : ↥M)
      = ((g χ : (↥M)ˣ) : ↥M) * χ ((g ψ : (↥M)ˣ) : ↥M) := by
    intro χ ψ
    have hK : (f (lift (χ * ψ)) : AlgebraicClosure k) =
        (f (lift χ) : AlgebraicClosure k) * (lift χ) (f (lift ψ) : AlgebraicClosure k) := by
      have hn : (lift (χ * ψ))⁻¹ * (lift χ * lift ψ) ∈ M.fixingSubgroup := by
        rw [← hker, MonoidHom.mem_ker]
        simp only [map_mul, map_inv, hlift]
        group
      have hA : f (lift (χ * ψ)) = f (lift χ * lift ψ) := by
        have h := hNinv (lift (χ * ψ)) ((lift (χ * ψ))⁻¹ * (lift χ * lift ψ)) hn
        have heq : lift (χ * ψ) * ((lift (χ * ψ))⁻¹ * (lift χ * lift ψ)) = lift χ * lift ψ :=
          by group
        rw [heq] at h
        exact h.symm
      have h := congrArg (fun u : (AlgebraicClosure k)ˣ => (u : AlgebraicClosure k))
        (hf (lift χ) (lift ψ))
      rw [hA]
      simpa [Work.AbsoluteKummer.algEquivUnitsMap_coe] using h
    apply Subtype.ext
    show (f (lift (χ * ψ)) : AlgebraicClosure k) =
      ((g χ : (↥M)ˣ) : AlgebraicClosure k) * ((χ ((g ψ : (↥M)ˣ) : ↥M)) : AlgebraicClosure k)
    rw [happ' χ ((g ψ : (↥M)ˣ) : ↥M), ← hgval χ, ← hgval ψ]
    exact hK
  -- Finite Hilbert 90 for `M/k`.
  obtain ⟨b, hb⟩ :=
    Work.AbsoluteKummer.exists_algEquiv_div_of_isCrossedHom (K := k) (L := ↥M) g hgcoc
  -- Transport `b : Mˣ` to a unit of `k̄`.
  refine ⟨Units.map (algebraMap ↥M (AlgebraicClosure k)).toMonoidHom b, fun σ => ?_⟩
  have hbσ : (((g ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ) :
          (↥M)ˣ) : ↥M) : AlgebraicClosure k)
      = (((((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ) (b : ↥M)) :
            ↥M) : AlgebraicClosure k)
        / (((b : ↥M) : AlgebraicClosure k)) := by
    have h := congrArg (fun x : ↥M => (x : AlgebraicClosure k))
      (hb ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ))
    simpa only [IntermediateField.coe_div] using h
  have hfσ : (f σ : AlgebraicClosure k) =
      (f (lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ)) :
        AlgebraicClosure k) := by
    have hn : (lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ))⁻¹
        * σ ∈ M.fixingSubgroup := by
      rw [← hker, MonoidHom.mem_ker]
      simp only [map_mul, map_inv, hlift]
      group
    have h := hNinv (lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ))
      ((lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ))⁻¹ * σ) hn
    have heq : (lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ)) *
        ((lift ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ))⁻¹ * σ)
        = σ := by group
    rw [heq] at h
    exact congrArg (fun u : (AlgebraicClosure k)ˣ => (u : AlgebraicClosure k)) h
  have hfinal : (f σ : AlgebraicClosure k)
      = σ ((b : ↥M) : AlgebraicClosure k) / ((b : ↥M) : AlgebraicClosure k) := by
    rw [hfσ, hgval ((AlgEquiv.restrictNormalHom (F := k) (K₁ := AlgebraicClosure k) ↥M) σ),
      hbσ, happ σ (b : ↥M)]
  apply Units.ext
  rw [Units.val_div_eq_div_val, Work.AbsoluteKummer.algEquivUnitsMap_coe, Units.coe_map]
  simpa using hfinal

/-- **Hilbert's theorem 90 for the absolute Galois group.**  Every locally constant crossed
homomorphism `Gal(k̄/k) → k̄ˣ` is a coboundary: `f σ = σ b / b` for some `b : k̄ˣ`.  Equivalently,
`H¹(Gal(k̄/k), k̄ˣ) = 0`. -/
theorem exists_div_of_isCrossedHom {k : Type*} [Field k] [IsGalois k (AlgebraicClosure k)] (f : Field.absoluteGaloisGroup k → (AlgebraicClosure k)ˣ) (hf : ∀ σ τ : Field.absoluteGaloisGroup k, f (σ * τ) = f σ * Work.AbsoluteKummer.algEquivUnitsMap k σ (f τ)) (hc : Work.AbsoluteKummer.IsLocallyConstant f) : ∃ b : (AlgebraicClosure k)ˣ, ∀ σ : Field.absoluteGaloisGroup k, f σ = Work.AbsoluteKummer.algEquivUnitsMap k σ b / b := by
  obtain ⟨b, hb⟩ := exists_div_of_isCrossedHom_gal (k := k) f hf hc
  exact ⟨b, fun σ => hb (show Gal(AlgebraicClosure k / k) from σ)⟩

end

end Work.AbsoluteKummer.Hilbert90
