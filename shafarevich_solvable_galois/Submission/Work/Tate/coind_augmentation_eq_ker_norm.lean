namespace Work.Tate

open scoped BigOperators

/-! ## Two elementary facts about the coinduced module `G → R`

For the coinduced module `G → R` with `(g • f) x = f (x * g)` the norm of an element `f` is the
constant function `x ↦ ∑_g f g`, so `ker N` consists of those `f` with `∑_g f g = 0`.  The
augmentation submodule `I_G·(G → R)` is generated by the elements `g • f - f`, and one checks
that for `f = δ_1 r` these are exactly the differences of the "basis" functions `δ_y r`.  This
gives the identity `I_G·(G → R) = ker N`: the inclusion `≤` is
`Work.Tate.augmentation_le_ker_norm`, and for the reverse inclusion one writes an arbitrary `f`
as `∑_y δ_y (f y)`, splits each `δ_y (f y) = (δ_y (f y) - δ_1 (f y)) + δ_1 (f y)`, and observes
that the first sum is in the augmentation submodule while the second is `0` as soon as
`∑_y f y = 0`.

We record the three pointwise identities used in the argument, all proved by reducing to the
permutation behaviour `Pi.single y r ↦ Pi.single (y * g⁻¹) r` of the action. -/

section Helpers

variable {G : Type*} {R : Type*}

/-- On the coinduced module, the action shifts the "basis" function `Pi.single y r`:
`g • δ_y r = δ_{y g⁻¹} r`. -/
theorem coind_smul_piSingle [Group G] [DecidableEq G] [Zero R] (g y : G) (r : R) :
    g • (Pi.single y r : G → R) = (Pi.single (y * g⁻¹) r : G → R) := by
  funext x
  rw [coind_smul_eq, Pi.single_apply, Pi.single_apply]
  by_cases h : x * g = y
  · rw [if_pos h, if_pos (show x = y * g⁻¹ by rw [← h]; group)]
  · rw [if_neg h, if_neg (show ¬ (x = y * g⁻¹) by intro hx; exact h (by rw [hx]; group))]

/-- Every function on `G` is the sum of the "basis" functions `δ_y (f y)`. -/
theorem sum_pi_single_self [Fintype G] [DecidableEq G] [AddCommMonoid R] (f : G → R) :
    (∑ y : G, (Pi.single y (f y) : G → R)) = f := by
  funext x
  rw [Finset.sum_apply]
  simp only [Pi.single_apply, Finset.sum_ite_eq, Finset.mem_univ, if_true]

/-- The sum of the "basis" functions based at the identity is the function supported at the
identity with value the total sum: only its value at `1` is nonzero. -/
theorem sum_pi_single_one [Fintype G] [Group G] [DecidableEq G] [AddCommMonoid R] (f : G → R) :
    (∑ y : G, (Pi.single (1 : G) (f y) : G → R))
      = (Pi.single (1 : G) (∑ y : G, f y) : G → R) := by
  funext x
  rw [Finset.sum_apply]
  by_cases h : x = 1
  · subst h
    simp
  · simp [h]

end Helpers

theorem coind_augmentation_eq_ker_norm {G : Type*} [Group G] [Fintype G] {R : Type*}
    [AddCommGroup R] :
    Work.Tate.augmentation G (G → R) = (Work.Tate.norm G (G → R)).ker := by
  classical
  refine le_antisymm augmentation_le_ker_norm (fun f hf => ?_)
  rw [AddMonoidHom.mem_ker] at hf
  -- Evaluating the vanishing norm at the identity gives `∑ f = 0`.
  have hsum : ∑ y : G, f y = 0 := by
    have h := congrFun hf (1 : G)
    rw [norm_apply] at h
    simpa [Finset.sum_apply, coind_smul_eq] using h
  -- Every summand `δ_y (f y)` differs from `δ_1 (f y)` by an element of the augmentation.
  have key : (∑ y : G, (Pi.single y (f y) : G → R))
      - (∑ y : G, (Pi.single (1 : G) (f y) : G → R)) ∈ augmentation G (G → R) := by
    rw [← Finset.sum_sub_distrib]
    refine AddSubgroup.sum_mem _ (fun y _ => ?_)
    have hy : (Pi.single y (f y) : G → R) = y⁻¹ • (Pi.single (1 : G) (f y) : G → R) := by
      rw [coind_smul_piSingle]
      simp
    rw [hy]
    exact smul_sub_self_mem_augmentation y⁻¹ _
  -- The remaining sum is supported at the identity with value `∑ f = 0`, hence vanishes.
  have hsecond : (∑ y : G, (Pi.single (1 : G) (f y) : G → R)) = 0 := by
    rw [sum_pi_single_one, hsum]
    simp
  rw [hsecond, sub_zero, sum_pi_single_self] at key
  exact key

end Work.Tate
