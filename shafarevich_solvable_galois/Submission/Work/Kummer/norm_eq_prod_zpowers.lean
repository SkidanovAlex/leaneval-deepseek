/-!
# Norm as a product over the powers of a generator of the Galois group

If `L/K` is a finite Galois extension and `σ : Gal(L/K)` generates the Galois group
(as a cyclic group, i.e. every element is a power of `σ`), then the norm of `x : L` is the
product of the conjugates `σ ^ i x` for `i` running over `0, …, [L : K] - 1`.

This is the "cyclic extension" specialisation of `Algebra.norm_eq_prod_automorphisms`,
which expresses the norm as the product of `σ x` over *all* `σ : Gal(L/K)`. The passage from
the group to the range is the fact that a generator of a group of order `[L : K]` enumerates
the group precisely as `σ ^ 0, …, σ ^ ([L:K]-1)` (Mathlib's `IsCyclic.image_range_card`),
together with `IsGalois.card_aut_eq_finrank`.
-/

universe u v

namespace Work.Kummer

theorem norm_eq_prod_zpowers {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] {σ : Gal(L/K)}
    (hσ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ) (x : L) :
    algebraMap K L (Algebra.norm K x) =
      ∏ i ∈ Finset.range (Module.finrank K L), ((σ : L ≃ₐ[K] L) ^ i) x := by
  classical
  rw [Algebra.norm_eq_prod_automorphisms]
  -- The Galois group is cyclic of order `[L : K]`, generated by `σ`.
  have hcard : Nat.card Gal(L/K) = Module.finrank K L := IsGalois.card_aut_eq_finrank K L
  have horder : orderOf σ = Module.finrank K L := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hσ, hcard]
  -- The map `i ↦ σ ^ i` enumerates the whole Galois group on `range [L : K]`.
  have himg : Finset.image (fun i => σ ^ i) (Finset.range (Module.finrank K L)) =
      Finset.univ := by
    rw [← hcard]
    exact IsCyclic.image_range_card hσ
  -- ... and it is injective there, because `σ` has order `[L : K]`.
  have hinj : Set.InjOn (fun i => σ ^ i) ↑(Finset.range (Module.finrank K L)) := by
    intro i hi j hj hij
    simp only [Finset.mem_coe, Finset.mem_range] at hi hj
    have hmod : i ≡ j [MOD orderOf σ] := pow_eq_pow_iff_modEq.mp hij
    rw [horder] at hmod
    exact hmod.eq_of_lt_of_lt hi hj
  -- Reindex the product over the group as a product over `range [L : K]`.
  have hpi := Finset.prod_image (f := fun g : Gal(L/K) => g x)
    (s := Finset.range (Module.finrank K L)) (g := fun i => σ ^ i) hinj
  rw [himg] at hpi
  exact hpi

end Work.Kummer
