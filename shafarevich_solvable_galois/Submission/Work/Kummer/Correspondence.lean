# The Kummer correspondence

For `K` a field containing a primitive `n`-th root of unity `ζ` and `L/K` a finite Galois
extension, the Kummer pairing is a perfect pairing between `Gal(L/K)` and the group
`(Kˣ ∩ (Lˣ)^n)/(Kˣ)^n` when `L/K` is a Kummer extension. Orthogonality in this pairing gives the
Kummer correspondence between subgroups of `(Kˣ ∩ (Lˣ)^n)/(Kˣ)^n` and intermediate Kummer
extensions of `L/K`.

The field associated with a subgroup `Δ` of the Kummer quotient is `kummerAdjoin n K L Δ`, the
field generated over `K` by the `n`-th roots in `L` of the elements of `Δ`; the main statement of
this file is that the annihilator of `Δ` in the pairing is exactly the subgroup of `Gal(L/K)`
fixing `kummerAdjoin n K L Δ`. Combined with the fundamental theorem of Galois theory and with the
bijectivity of the pairing for Kummer extensions (`kummerPairing_bijective_of_isKummerExtension`),
this yields the Kummer correspondence.
-/
import Mathlib.FieldTheory.KummerExtension
import Submission.Work.Kummer.Pairing
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

universe u v

namespace Work.Kummer

open IntermediateField

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
variable {n : ℕ} [NeZero n]

/-- The Kummer subextension cut out by a subgroup `Δ` of `(Kˣ ∩ (Lˣ)^n)/(Kˣ)^n`: the intermediate
field generated over `K` by the `n`-th roots in `L` of the elements of `Δ`. -/
def kummerAdjoin (n : ℕ) (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L]
    (Δ : Subgroup (kummerQuotient n K L)) : IntermediateField K L :=
  IntermediateField.adjoin K
    {x : L | ∃ a : kummerSubgroup n K L,
      QuotientGroup.mk' _ a ∈ Δ ∧ x ^ n = algebraMap K L (((a : Kˣ) : K))}

/-- `subgroupKummer` is contained in `kummerAdjoin`. -/
lemma kummerQuotient_mk_mem_kummerAdjoin (Δ : Subgroup (kummerQuotient n K L))
    (a : kummerSubgroup n K L) (ha : QuotientGroup.mk' _ a ∈ Δ) {x : L}
    (hx : x ^ n = algebraMap K L (((a : Kˣ) : K))) : x ∈ kummerAdjoin n K L Δ :=
  IntermediateField.subset_adjoin K _ ⟨a, ha, hx⟩

/-- Monotonicity of `kummerAdjoin`. -/
lemma kummerAdjoin_mono {Δ₁ Δ₂ : Subgroup (kummerQuotient n K L)} (h : Δ₁ ≤ Δ₂) :
    kummerAdjoin n K L Δ₁ ≤ kummerAdjoin n K L Δ₂ :=
  IntermediateField.adjoin_le_iff.mpr fun x hx => by
    obtain ⟨a, ha, hxa⟩ := hx
    exact kummerQuotient_mk_mem_kummerAdjoin Δ₂ a (h ha) hxa

/-- The Kummer subextension generated by `Δ` is always contained in the Kummer subfield: every
generator is an `n`-th root of an element of `K`. -/
lemma kummerAdjoin_le_kummerSubfield (Δ : Subgroup (kummerQuotient n K L)) :
    kummerAdjoin n K L Δ ≤ kummerSubfield n K L :=
  IntermediateField.adjoin_le_iff.mpr fun x hx => by
    obtain ⟨a, _, hxa⟩ := hx
    exact IntermediateField.subset_adjoin K _ ⟨((a : Kˣ) : K), hxa⟩

end Work.Kummer
