import Mathlib
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

universe u v

namespace Work.Kummer

/-- **Hilbert's Theorem 90 (multiplicative, cyclic form).**

Let `L/K` be a finite Galois extension with cyclic Galois group generated by `σ`.  Then every
element `x : L` of norm `1` is of the form `σ y / y` for some unit `y : Lˣ`.

This is the classical computation `H¹(Gal(L/K), Lˣ) = 1` for the cyclic group `Gal(L/K)`, in the
concrete "Lagrange resolvent" form.  The proof constructs the resolvent

`b(c) = ∑_{i<n} t_i · σ^i(c)`,  where `t_i = ∏_{j<i} σ^j(a)`,  `a = x⁻¹`,

which is a unit for a suitable `c` (by Dedekind's linear independence of the monoid endomorphisms
of the field `L`, applied to the powers `σ^i`), and which satisfies `σ(b) = a⁻¹ · b`, i.e.
`σ(b)/b = a⁻¹`, whence `σ(y)/y = x` for `y = b`.  The defining property `t_n = N_{L/K}(a) = 1`
of the resolvent is exactly the identity `∏_{i<n} σ^i(a) = N_{L/K}(a)`. -/
theorem exists_algEquiv_div_of_norm_eq_one {K : Type u} {L : Type v} [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] [IsCyclic Gal(L/K)] {σ : Gal(L/K)}
    (hσ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ) {x : L} (hx : Algebra.norm K x = 1) :
    ∃ y : Lˣ, x = (σ : L ≃ₐ[K] L) (y : L) / (y : L) := by
  classical
  -- It suffices to prove the "mirror" statement `∃ y, y / σ y = a` for every `a` of norm `1`:
  -- applying it to `x⁻¹` and inverting gives the claim.
  have key : ∀ {a : L}, Algebra.norm K a = 1 →
      ∃ y : Lˣ, (y : L) / (σ : L ≃ₐ[K] L) (y : L) = a := by
    intro a ha
    -- `N := #Gal(L/K)` is the order of `σ` and of the extension.
    set N := Fintype.card Gal(L/K) with hN
    have horder : orderOf σ = N := by
      rw [orderOf_eq_card_of_forall_mem_zpowers hσ, Nat.card_eq_fintype_card]
    have ha0 : a ≠ 0 := fun h0 => by
      rw [h0, Algebra.norm_zero] at ha
      exact one_ne_zero ha.symm
    have hpowN : (σ : L ≃ₐ[K] L) ^ N = 1 := by
      rw [← horder]; exact pow_orderOf_eq_one σ
    -- The Lagrange resolvent coefficients `t k = ∏_{i<k} σ^i(a)`.
    let t : ℕ → L := fun k => ∏ i ∈ Finset.range k, ((σ : L ≃ₐ[K] L) ^ i) a
    have ht0 : t 0 = 1 := by simp [t]
    -- The recurrence `t (k+1) = a * σ (t k)`.
    have hrec : ∀ k, t (k + 1) = a * (σ : L ≃ₐ[K] L) (t k) := by
      intro k
      have h : t (k + 1) = (∏ i ∈ Finset.range k, ((σ : L ≃ₐ[K] L) ^ (i + 1)) a) * a := by
        simp only [t]
        rw [Finset.prod_range_succ']
        simp
      rw [h]
      have h2 : (∏ i ∈ Finset.range k, ((σ : L ≃ₐ[K] L) ^ (i + 1)) a)
          = (σ : L ≃ₐ[K] L) (t k) := by
        simp only [t]
        rw [map_prod]
        apply Finset.prod_congr rfl
        intro i _
        rw [pow_succ', AlgEquiv.mul_apply]
      rw [h2]
      exact mul_comm _ _
    -- The powers `σ^i`, `i < N`, are pairwise distinct (they enumerate `Gal(L/K)`).
    have hinj : Function.Injective (fun i : Fin N => (σ : L ≃ₐ[K] L) ^ i.val) := by
      intro i j hij
      have h1 : i.val ≡ j.val [MOD N] := by
        have h' := (pow_eq_pow_iff_modEq (x := σ) (n := i.val) (m := j.val)).mp hij
        rwa [horder] at h'
      exact Fin.ext (Nat.ModEq.eq_of_lt_of_lt h1 i.isLt j.isLt)
    have hbij : Function.Bijective (fun i : Fin N => (σ : L ≃ₐ[K] L) ^ i.val) :=
      (Fintype.bijective_iff_injective_and_card _).mpr ⟨hinj, by simpa using hN⟩
    -- Closing relation: `t N = N_{L/K}(a) = 1`.
    have htN : t N = 1 := by
      have hprod : t N = ∏ g : Gal(L/K), (g : L ≃ₐ[K] L) a := by
        simp only [t]
        rw [← Fin.prod_univ_eq_prod_range]
        exact Fintype.prod_bijective (fun i : Fin N => (σ : L ≃ₐ[K] L) ^ i.val) hbij
          (fun i => ((σ : L ≃ₐ[K] L) ^ i.val) a) (fun g => (g : L ≃ₐ[K] L) a) (fun i => rfl)
      rw [hprod, ← Algebra.norm_eq_prod_automorphisms, ha, map_one]
    -- Dedekind: the functions `σ^i : L → L`, `i < N`, are `L`-linearly independent.
    have hli : LinearIndependent L (fun i : Fin N => ⇑((σ : L ≃ₐ[K] L) ^ i.val)) := by
      have hbase : LinearIndependent L (fun (f : Gal(L/K)) => (f : L → L)) :=
        LinearIndependent.comp (ι' := Gal(L/K))
          (linearIndependent_monoidHom L L) (fun f => f)
          (fun x y h => by ext; exact DFunLike.ext_iff.1 h _)
      exact LinearIndependent.comp hbase (fun i : Fin N => (σ : L ≃ₐ[K] L) ^ i.val) hinj
    have hNpos : 0 < N := by
      rw [hN]; exact Fintype.card_pos_iff.mpr ⟨1⟩
    -- The resolvent map `c ↦ ∑_{i<N} t_i · σ^i(c)` is not identically zero.
    have hbne : (fun c : L => ∑ i ∈ Finset.range N, t i * ((σ : L ≃ₐ[K] L) ^ i) c) ≠ 0 := by
      intro hzero
      have hsum : (∑ i : Fin N, t i.val • (⇑((σ : L ≃ₐ[K] L) ^ i.val))) = 0 := by
        funext c
        simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
        rw [Fin.sum_univ_eq_sum_range (fun i => t i * ((σ : L ≃ₐ[K] L) ^ i) c) N]
        exact congrFun hzero c
      have hcon := (Fintype.linearIndependent_iff.mp hli) (fun i : Fin N => t i.val) hsum
      have h0 := hcon ⟨0, hNpos⟩
      rw [ht0] at h0
      exact one_ne_zero h0
    obtain ⟨c, hc⟩ : ∃ c : L, (∑ i ∈ Finset.range N, t i * ((σ : L ≃ₐ[K] L) ^ i) c) ≠ 0 := by
      by_contra h
      push Not at h
      exact hbne (funext h)
    -- Key computation: `σ(b) = a⁻¹ · b`.
    have hrel : (σ : L ≃ₐ[K] L) (∑ i ∈ Finset.range N, t i * ((σ : L ≃ₐ[K] L) ^ i) c)
        = a⁻¹ * (∑ i ∈ Finset.range N, t i * ((σ : L ≃ₐ[K] L) ^ i) c) := by
      set F : ℕ → L := fun j => t j * ((σ : L ≃ₐ[K] L) ^ j) c with hF
      have hFN : F N = F 0 := by
        simp only [F, htN, hpowN, t, Finset.prod_range_zero, pow_zero, AlgEquiv.one_apply, one_mul]
      -- Sum over a full period: `∑_{i<N} F(i+1) = ∑_{i<N} F i`.
      have hshift : ∑ i ∈ Finset.range N, F (i+1) = ∑ i ∈ Finset.range N, F i := by
        have h1 := Finset.sum_range_succ F N
        have h2 := Finset.sum_range_succ' F N
        rw [h2] at h1
        rw [hFN] at h1
        exact add_right_cancel h1
      have hterm : ∀ i, (σ : L ≃ₐ[K] L) (t i * ((σ : L ≃ₐ[K] L) ^ i) c) = a⁻¹ * F (i+1) := by
        intro i
        rw [map_mul]
        have hσt : (σ : L ≃ₐ[K] L) (t i) = a⁻¹ * t (i+1) := by
          rw [hrec i, ← mul_assoc, inv_mul_cancel₀ ha0, one_mul]
        have hstep : (σ : L ≃ₐ[K] L) (((σ : L ≃ₐ[K] L) ^ i) c) = ((σ : L ≃ₐ[K] L) ^ (i+1)) c := by
          rw [pow_succ', AlgEquiv.mul_apply]
        rw [hσt, hstep]
        simp only [F]
        ring
      calc (σ : L ≃ₐ[K] L) (∑ i ∈ Finset.range N, t i * ((σ : L ≃ₐ[K] L) ^ i) c)
          = ∑ i ∈ Finset.range N, (σ : L ≃ₐ[K] L) (t i * ((σ : L ≃ₐ[K] L) ^ i) c) := by rw [map_sum]
        _ = ∑ i ∈ Finset.range N, a⁻¹ * F (i+1) := Finset.sum_congr rfl (fun i _ => hterm i)
        _ = a⁻¹ * ∑ i ∈ Finset.range N, F (i+1) := (Finset.mul_sum _ _ _).symm
        _ = a⁻¹ * ∑ i ∈ Finset.range N, F i := by rw [hshift]
    -- Conclude `b / σ b = a`.
    refine ⟨Units.mk0 _ hc, ?_⟩
    simp only [Units.val_mk0]
    rw [hrel, div_eq_iff (mul_ne_zero (inv_ne_zero ha0) hc), ← mul_assoc, mul_inv_cancel₀ ha0, one_mul]
  have hxinv : Algebra.norm K x⁻¹ = 1 := by rw [Algebra.norm_inv, hx, inv_one]
  obtain ⟨y, hy⟩ := key hxinv
  refine ⟨y, ?_⟩
  have h2 := congrArg Inv.inv hy
  rw [inv_div, inv_inv] at h2
  exact h2.symm

end Work.Kummer
