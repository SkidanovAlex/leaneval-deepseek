universe u v

namespace Work.Kummer

/-- In a finite Galois extension `L/K` whose Galois group is generated by a single element `σ`,
the product of the Galois conjugates of `x` equals the product of the iterates `σ ^ i x` for
`0 ≤ i < [L : K]`. -/
theorem prod_gal_eq_prod_range {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] {σ : Gal(L/K)}
    (hσ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ) (x : L) :
    ∏ g : Gal(L/K), g x = ∏ i ∈ Finset.range (Module.finrank K L), (σ ^ i) x := by
  classical
  have horder : orderOf σ = Module.finrank K L :=
    (orderOf_eq_card_of_forall_mem_zpowers hσ).trans (IsGalois.card_aut_eq_finrank K L)
  have hbij : Function.Bijective (fun i : Fin (Module.finrank K L) => σ ^ (i : ℕ)) := by
    constructor
    · intro i j hij
      have hmod : (i : ℕ) ≡ (j : ℕ) [MOD orderOf σ] := pow_eq_pow_iff_modEq.mp hij
      rw [horder] at hmod
      exact Fin.ext (hmod.eq_of_lt_of_lt i.isLt j.isLt)
    · intro g
      have hg : g ∈ Finset.image (fun k => σ ^ k) (Finset.range (orderOf σ)) :=
        mem_zpowers_iff_mem_range_orderOf.mp (hσ g)
      obtain ⟨k, hk, hkg⟩ := Finset.mem_image.mp hg
      rw [Finset.mem_range, horder] at hk
      exact ⟨⟨k, hk⟩, hkg⟩
  have h1 : ∏ i : Fin (Module.finrank K L), (σ ^ (i : ℕ)) x = ∏ g : Gal(L/K), g x :=
    Fintype.prod_bijective _ hbij (fun i => (σ ^ (i : ℕ)) x) (fun g => g x) (fun i => rfl)
  rw [← h1, Finset.prod_range]

theorem norm_eq_primRoot_pow_mul_of_kummer_generator {K : Type u} {L : Type v} [Field K]
    [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] {n : ℕ} [NeZero n] {ζ : K}
    (hζ : IsPrimitiveRoot ζ n) (hn : Module.finrank K L = n) {α : L} {a : K}
    (ha : α ^ n = algebraMap K L a) {σ : Gal(L/K)}
    (hσ : ∀ x : Gal(L/K), x ∈ Subgroup.zpowers σ)
    (hlt : (σ : L ≃ₐ[K] L) α = algebraMap K L ζ * α) :
    Algebra.norm K α = ζ ^ (n * (n - 1) / 2) * a := by
  classical
  apply FaithfulSMul.algebraMap_injective K L
  rw [Algebra.norm_eq_prod_automorphisms, map_mul, map_pow, ← ha]
  rw [prod_gal_eq_prod_range hσ α, hn]
  have hstep : ∀ i : ℕ, (σ ^ i) α = (algebraMap K L ζ) ^ i * α := by
    intro i
    induction i with
    | zero => simp
    | succ k ih =>
      rw [pow_succ, AlgEquiv.mul_apply, hlt, map_mul, AlgEquiv.commutes, ih, pow_succ]
      ring
  rw [Finset.prod_congr rfl (fun i _ => hstep i), Finset.prod_mul_distrib,
    Finset.prod_pow_eq_pow_sum, Finset.sum_range_id, Finset.prod_const, Finset.card_range]

end Work.Kummer
