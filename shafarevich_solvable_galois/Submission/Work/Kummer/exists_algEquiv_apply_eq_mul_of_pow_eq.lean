universe u v

namespace Work.Kummer

open IntermediateField Polynomial

/-- If `L = K(α)` with `α ^ n = a ∈ K`, `[L : K] = n`, and `μ` is an `n`-th root of unity in `K`,
then there is a `K`-automorphism of `L` sending `α` to `μ · α`.

This is the elementary Kummer-theory statement that the `K`-automorphisms of a Kummer extension
act on a chosen root `α` by multiplication by roots of unity: since `[K(α) : K] = n`, the minimal
polynomial of `α` is `X ^ n - a`, and the substitution `X ↦ μ X` preserves it. -/
theorem exists_algEquiv_apply_eq_mul_of_pow_eq {K : Type u} {L : Type v} [Field K] [Field L]
    [Algebra K L] [FiniteDimensional K L] {n : ℕ} [NeZero n] {ζ : K}
    (hζ : IsPrimitiveRoot ζ n) {α : L} {a : K}
    (ha : α ^ n = algebraMap K L a) (hα : IntermediateField.adjoin K {α} = ⊤)
    (hn : Module.finrank K L = n) (μ : rootsOfUnity n K) :
    ∃ σ : Gal(L/K), (σ : L ≃ₐ[K] L) α = algebraMap K L ((μ : Kˣ) : K) * α := by
  -- `α` is integral, being a root of the monic polynomial `X ^ n - C a`.
  have hαint : IsIntegral K α :=
    ⟨X ^ n - C a, monic_X_pow_sub_C a (NeZero.ne n), by simp [ha]⟩
  -- `[K⟮α⟯ : K] = [L : K] = n`, hence `natDegree (minpoly K α) = n`.
  have htop : Module.finrank K ↥(⊤ : IntermediateField K L) = Module.finrank K L :=
    (IntermediateField.topEquiv (F := K) (E := L)).toLinearEquiv.finrank_eq
  have hnat : (minpoly K α).natDegree = n := by
    rw [← IntermediateField.adjoin.finrank hαint, hα, htop, hn]
  -- Since `minpoly K α` is monic of degree `n` and divides `X ^ n - C a`, it equals it.
  have hmin : minpoly K α = X ^ n - C a := by
    have hdvd : minpoly K α ∣ X ^ n - C a := minpoly.dvd K α (by simp [ha])
    refine (eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hαint)
      (monic_X_pow_sub_C a (NeZero.ne n)) hdvd ?_).symm
    rw [natDegree_X_pow_sub_C, hnat]
  -- `μ` has `n`-th power `1`, so `y = μ · α` also satisfies `y ^ n = a`.
  have hpow : ((μ : Kˣ) : K) ^ n = 1 := (mem_rootsOfUnity' n (μ : Kˣ)).mp μ.2
  set y : L := algebraMap K L ((μ : Kˣ) : K) * α with hy_def
  have hy : y ^ n = algebraMap K L a := by
    rw [hy_def, mul_pow, ← map_pow, hpow, map_one, one_mul, ha]
  -- A power basis of `L` over `K` generated by `α`.
  let e : K⟮α⟯ ≃ₐ[K] L := (IntermediateField.equivOfEq hα).trans IntermediateField.topEquiv
  let pb : PowerBasis K L := (IntermediateField.adjoin.powerBasis hαint).map e
  have hgen : pb.gen = α := by
    rw [PowerBasis.map_gen]
    show ((IntermediateField.equivOfEq hα).trans IntermediateField.topEquiv)
        (IntermediateField.AdjoinSimple.gen K α) = α
    rw [AlgEquiv.trans_apply]
    show (↑((IntermediateField.equivOfEq hα) (IntermediateField.AdjoinSimple.gen K α)) : L) = α
    rw [IntermediateField.equivOfEq_apply]
    rfl
  have hroot : aeval y (minpoly K pb.gen) = 0 := by
    rw [hgen, hmin]
    simp [hy]
  -- The `K`-algebra endomorphism `α ↦ μ · α`, obtained by extending along the power basis.
  let ψ : L →ₐ[K] L := pb.lift y hroot
  have hψ : ψ α = y := by
    rw [← hgen, show ψ pb.gen = y from PowerBasis.lift_gen pb y hroot]
  -- It is injective (a nonzero map of fields) and hence surjective (finite dimension).
  have hinj : Function.Injective ψ := by simpa using RingHom.injective ψ.toRingHom
  have hinjL : Function.Injective ψ.toLinearMap := fun x y h => hinj h
  have hsurj : Function.Surjective ψ := fun y' =>
    (LinearMap.injective_iff_surjective (f := ψ.toLinearMap)).mp hinjL y'
  have hbij : Function.Bijective ψ := ⟨hinj, hsurj⟩
  refine ⟨AlgEquiv.ofBijective ψ hbij, ?_⟩
  rw [AlgEquiv.ofBijective_apply]
  exact hψ

end Work.Kummer
