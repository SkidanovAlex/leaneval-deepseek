import Mathlib
import Submission.Work.Kummer.Pairing
import Submission.Work.Kummer.kummerCharacter_apply_of_pow_eq
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

universe u v

namespace Work.Kummer

open IntermediateField

/-- **Non-degeneracy of the Kummer pairing on the Galois side.**  Let `L/K` be a finite Galois
Kummer extension of exponent `n` (so `L` is generated over `K` by `n`-th roots of elements of `K`),
with `K` containing a primitive `n`-th root of unity `ζ`.  If `σ ∈ Gal(L/K)` acts trivially in the
Kummer pairing, i.e. `σ α = α` for every `α : L` with `α ^ n ∈ K`, then `σ = 1`.

Indeed an element of `Gal(L/K)` is determined by its action on any generating set of `L` over `K`:
`L` is generated by the `n`-th roots of elements of `K`, and the hypothesis says that `σ` fixes all
of them. -/
theorem eq_one_of_forall_kummerCharacter_eq_one {K : Type u} {L : Type v} [Field K] [Field L]
    [Algebra K L] {n : ℕ} [NeZero n] {ζ : K}
    (hζ : IsPrimitiveRoot ζ n) [FiniteDimensional K L] [IsGalois K L]
    (hL : IsKummerExtension n K L) (σ : Gal(L/K))
    (h : ∀ a : kummerSubgroup n K L, kummerCharacter hζ a σ = 1) : σ = 1 := by
  -- It suffices to show that `σ` fixes every `n`-th root of an element of `K`.
  have hgen : ∀ (x : L) (a : K), x ^ n = algebraMap K L a → (σ : L ≃ₐ[K] L) x = x := by
    intro x a ha
    by_cases ha0 : a = 0
    · -- `x ^ n = 0` forces `x = 0`.
      have hx0 : x = 0 := (pow_eq_zero_iff (NeZero.ne n)).mp (by rw [ha, ha0, map_zero])
      rw [hx0, map_zero]
    · -- `x` is a unit, and its `n`-th power is the image of the unit `a` of `K`.
      set u : Kˣ := Units.mk0 a ha0 with hu
      have hxu : (u : K) = a := Units.val_mk0 ha0
      have hx0 : x ≠ 0 := by
        intro hx
        have h0 : algebraMap K L a = 0 := by rw [← ha, hx, zero_pow (NeZero.ne n)]
        exact ha0 ((algebraMap K L).injective (by rw [h0, map_zero]))
      set xu : Lˣ := Units.mk0 x hx0 with hxuset
      have hxuv : (xu : L) = x := Units.val_mk0 hx0
      -- `u` lies in the Kummer subgroup, with `n`-th root `xu`.
      have hmem : u ∈ kummerSubgroup n K L := ⟨xu, by
        apply Units.ext
        rw [Units.val_pow_eq_pow_val, Units.coe_map, hxuv, hxu, ha]
        rfl⟩
      -- The hypothesis makes the Kummer ratio of `xu` trivial.
      have hchar := h ⟨u, hmem⟩
      have hratio1 : kummerRatio σ (kummerRoot ⟨u, hmem⟩) = 1 := by
        have hm := map_kummerCharacter_apply hζ ⟨u, hmem⟩ σ
        rw [hchar] at hm
        simpa using hm.symm
      have hratiox : kummerRatio σ xu = kummerRatio σ (kummerRoot ⟨u, hmem⟩) := by
        refine kummerRatio_congr hζ (α := (kummerRoot ⟨u, hmem⟩)) (α' := xu) (a := u) ?_ ?_ σ
        · exact kummerRoot_pow_val ⟨u, hmem⟩
        · rw [hxuv, ha, hxu]
      have hratio1' : kummerRatio σ xu = 1 := by rw [hratiox, hratio1]
      have hfix : algEquivUnitsMap (σ : L ≃ₐ[K] L) xu = xu := by
        have h2 : algEquivUnitsMap (σ : L ≃ₐ[K] L) xu / xu = 1 := hratio1'
        exact div_eq_one.mp h2
      have h' := congrArg (fun v : Lˣ => (v : L)) hfix
      simpa [algEquivUnitsMap_coe, hxuv] using h'
  -- `L` is generated over `K` by these elements, and `σ` fixes them all.
  refine AlgEquiv.ext fun x => ?_
  have hx : x ∈ kummerSubfield n K L := by
    rw [isKummerExtension_iff.mp hL]
    exact IntermediateField.mem_top
  have hx' : x ∈ IntermediateField.adjoin K {y : L | ∃ a : K, y ^ n = algebraMap K L a} := hx
  have key := IntermediateField.adjoin_induction K
    (s := {y : L | ∃ a : K, y ^ n = algebraMap K L a})
    (p := fun x _ => (σ : L ≃ₐ[K] L) x = x)
    (fun y hy => by obtain ⟨a, ha⟩ := hy; exact hgen y a ha)
    (fun c => (σ : L ≃ₐ[K] L).commutes c)
    (fun y z hy hz ihy ihz => by rw [map_add, ihy, ihz])
    (fun y hy ihy => by rw [map_inv₀, ihy])
    (fun y z hy hz ihy ihz => by rw [map_mul, ihy, ihz])
    hx'
  simpa using key

end Work.Kummer
