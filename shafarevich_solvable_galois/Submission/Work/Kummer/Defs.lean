universe u v

namespace Work.Kummer

open IntermediateField

section Base

variable {G : Type u} [CommGroup G]

/-- The subgroup of `n`-th powers of a commutative group `G`. -/
def nthPowerSubgroup (n : ℕ) (G : Type u) [CommGroup G] : Subgroup G where
  carrier := {x | ∃ y : G, y ^ n = x}
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨x * y, mul_pow x y n⟩
  one_mem' := ⟨1, by simp⟩
  inv_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨x⁻¹, inv_pow x n⟩

@[simp]
lemma mem_nthPowerSubgroup {n : ℕ} {x : G} :
    x ∈ nthPowerSubgroup n G ↔ ∃ y : G, y ^ n = x := Iff.rfl

end Base

section Ext

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]

/-- The Kummer subgroup `Kˣ ∩ (Lˣ)^n`: the units of `K` that are `n`-th powers in `L`. -/
def kummerSubgroup (n : ℕ) (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] :
    Subgroup Kˣ where
  carrier := {a | ∃ α : Lˣ, α ^ n = Units.map (algebraMap K L) a}
  mul_mem' := by
    rintro _ _ ⟨x, hx⟩ ⟨y, hy⟩
    exact ⟨x * y, by rw [mul_pow, hx, hy, map_mul]⟩
  one_mem' := ⟨1, by simp⟩
  inv_mem' := by
    rintro _ ⟨x, hx⟩
    exact ⟨x⁻¹, by rw [inv_pow, hx, map_inv]⟩

@[simp]
lemma mem_kummerSubgroup {n : ℕ} {a : Kˣ} :
    a ∈ kummerSubgroup n K L ↔ ∃ α : Lˣ, α ^ n = Units.map (algebraMap K L) a := Iff.rfl

lemma nthPowerSubgroup_le_kummerSubgroup (n : ℕ) :
    nthPowerSubgroup n Kˣ ≤ kummerSubgroup n K L := by
  rintro x ⟨y, rfl⟩
  exact ⟨Units.map (algebraMap K L) y, by rw [← map_pow]⟩

/-- A choice of an `n`-th root in `L` of an element of the Kummer subgroup. -/
noncomputable def kummerRoot {n : ℕ} (a : kummerSubgroup n K L) : Lˣ := Classical.choose a.2

lemma kummerRoot_pow {n : ℕ} (a : kummerSubgroup n K L) :
    kummerRoot a ^ n = Units.map (algebraMap K L) (a : Kˣ) := Classical.choose_spec a.2

lemma kummerRoot_pow_val {n : ℕ} (a : kummerSubgroup n K L) :
    ((kummerRoot a : L)) ^ n = algebraMap K L ((a : Kˣ) : K) := by
  have := congrArg (fun u : Lˣ => (u : L)) (kummerRoot_pow a)
  simpa using this

/-- The intermediate field of `L` generated over `K` by all `n`-th roots of elements of `K`. -/
def kummerSubfield (n : ℕ) (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] :
    IntermediateField K L :=
  IntermediateField.adjoin K {x : L | ∃ a : K, x ^ n = algebraMap K L a}

/-- `L/K` is a Kummer extension of exponent `n` if `L` is generated over `K` by `n`-th roots of
elements of `K`. -/
def IsKummerExtension (n : ℕ) (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] :
    Prop :=
  kummerSubfield n K L = ⊤

lemma isKummerExtension_iff {n : ℕ} :
    IsKummerExtension n K L ↔ kummerSubfield n K L = ⊤ := Iff.rfl

lemma kummerSubfield_eq_adjoin {n : ℕ} :
    kummerSubfield n K L =
      IntermediateField.adjoin K {x : L | ∃ a : K, x ^ n = algebraMap K L a} := rfl

/-- `L/K` is a Kummer extension of exponent `n` as soon as it is generated by `n`-th roots of
elements of `K`. -/
lemma isKummerExtension_of_adjoin_eq_top {n : ℕ} {s : Set L}
    (hs : IntermediateField.adjoin K s = ⊤)
    (h : ∀ x ∈ s, ∃ a : K, x ^ n = algebraMap K L a) : IsKummerExtension n K L := by
  rw [isKummerExtension_iff, eq_top_iff, ← hs]
  exact IntermediateField.adjoin_le_iff.mpr fun x hx =>
    IntermediateField.subset_adjoin K _ (h x hx)

end Ext

section Ratio

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]

/-- The action of `K`-automorphisms of `L` on the units of `L`. -/
def algEquivUnitsMap (σ : L ≃ₐ[K] L) : Lˣ →* Lˣ :=
  Units.map σ.toAlgHom.toRingHom.toMonoidWithZeroHom

@[simp]
lemma algEquivUnitsMap_coe (σ : L ≃ₐ[K] L) (u : Lˣ) :
    ((algEquivUnitsMap σ u : Lˣ) : L) = σ (u : L) := rfl

lemma algEquivUnitsMap_mul (σ τ : L ≃ₐ[K] L) (u : Lˣ) :
    algEquivUnitsMap σ (algEquivUnitsMap τ u) = algEquivUnitsMap (σ * τ) u := rfl

lemma algEquivUnitsMap_one (u : Lˣ) : algEquivUnitsMap (1 : L ≃ₐ[K] L) u = u := rfl

/-- `Gal(L/K)`-automorphisms fix the units coming from `K`. -/
lemma algEquivUnitsMap_unitsMap (σ : L ≃ₐ[K] L) (x : Kˣ) :
    algEquivUnitsMap σ (Units.map (algebraMap K L) x) = Units.map (algebraMap K L) x := by
  ext
  simp [algEquivUnitsMap_coe, AlgEquiv.commutes]

/-- The ratio `σ α / α`, as a unit of `L`. -/
def kummerRatio (σ : Gal(L/K)) (α : Lˣ) : Lˣ :=
  algEquivUnitsMap (σ : L ≃ₐ[K] L) α / α

lemma kummerRatio_coe (σ : Gal(L/K)) (α : Lˣ) :
    ((kummerRatio σ α : Lˣ) : L) = (σ : L ≃ₐ[K] L) (α : L) / (α : L) := by
  rw [kummerRatio, Units.val_div_eq_div_val, algEquivUnitsMap_coe]

lemma kummerRatio_one (α : Lˣ) : kummerRatio (1 : Gal(L/K)) α = 1 := by
  rw [kummerRatio, algEquivUnitsMap_one]
  exact div_self' α

end Ratio

section Char

variable {K : Type u} {L : Type v} [Field K] [Field L] [Algebra K L]
variable {n : ℕ} [NeZero n] {ζ : K}

/-- A primitive `n`-th root of unity `ζ` of `K`, as a unit of `K`. -/
noncomputable def primRootUnit (hζ : IsPrimitiveRoot ζ n) : Kˣ :=
  (hζ.isUnit (NeZero.ne n)).unit

lemma primRootUnit_coe (hζ : IsPrimitiveRoot ζ n) : ((primRootUnit hζ : Kˣ) : K) = ζ :=
  (hζ.isUnit (NeZero.ne n)).unit_spec

lemma primitiveRoots_nonempty (hζ : IsPrimitiveRoot ζ n) : (primitiveRoots n K).Nonempty :=
  ⟨primRootUnit hζ,
    (mem_primitiveRoots (Nat.pos_of_ne_zero (NeZero.ne n))).mpr (by
      simpa [primRootUnit_coe hζ] using hζ)⟩

/-- The canonical isomorphism between the `n`-th roots of unity of `K` and of `L`. -/
noncomputable def rootsOfUnityEquiv (hζ : IsPrimitiveRoot ζ n) :
    rootsOfUnity n K ≃* rootsOfUnity n L :=
  rootsOfUnityEquivOfPrimitiveRoots (f := algebraMap K L) (algebraMap K L).injective
    (primitiveRoots_nonempty hζ)

/-- An `n`-th root of unity in `L` is a power of the primitive root coming from `K`. -/
lemma exists_primRootUnit_pow_eq_of_pow_eq_one (hζ : IsPrimitiveRoot ζ n) {u : Lˣ}
    (hu : (u : L) ^ n = 1) :
    ∃ i : ℕ, i < n ∧ u = Units.map (algebraMap K L) (primRootUnit hζ ^ i) := by
  obtain ⟨i, hi, h⟩ := (hζ.map_of_injective (f := algebraMap K L)
    (algebraMap K L).injective).eq_pow_of_pow_eq_one hu
  refine ⟨i, hi, Units.ext ?_⟩
  rw [Units.coe_map, Units.val_pow_eq_pow_val, primRootUnit_coe, map_pow]
  exact h.symm

/-- `σ α / α` is an `n`-th root of unity in `L`, for `α ^ n ∈ K`. -/
lemma kummerRatio_mem_rootsOfUnity (hζ : IsPrimitiveRoot ζ n) {a : Kˣ} {α : Lˣ}
    (hα : (α : L) ^ n = algebraMap K L (a : K)) (σ : Gal(L/K)) :
    kummerRatio σ α ∈ rootsOfUnity n L := by
  rw [mem_rootsOfUnity', kummerRatio_coe, div_pow, ← map_pow, hα,
    AlgEquiv.commutes (σ : L ≃ₐ[K] L) (a : K)]
  exact div_self ((map_ne_zero (algebraMap K L)).mpr (Units.ne_zero a))

/-- `σ α / α` lies in the image of the `n`-th roots of unity of `K`, for `α ^ n ∈ K`. -/
lemma exists_primRootUnit_pow_eq_kummerRatio (hζ : IsPrimitiveRoot ζ n) {a : Kˣ} {α : Lˣ}
    (hα : (α : L) ^ n = algebraMap K L (a : K)) (σ : Gal(L/K)) :
    ∃ i : ℕ, i < n ∧ kummerRatio σ α = Units.map (algebraMap K L) (primRootUnit hζ ^ i) :=
  exists_primRootUnit_pow_eq_of_pow_eq_one hζ
    ((mem_rootsOfUnity' n (kummerRatio σ α)).mp (kummerRatio_mem_rootsOfUnity hζ hα σ))

/-- The ratio `σ α / α` depends only on `α ^ n`. -/
lemma kummerRatio_congr (hζ : IsPrimitiveRoot ζ n) {a : Kˣ} {α α' : Lˣ}
    (hα : (α : L) ^ n = algebraMap K L (a : K))
    (hα' : (α' : L) ^ n = algebraMap K L (a : K)) (σ : Gal(L/K)) :
    kummerRatio σ α' = kummerRatio σ α := by
  have hdiv : (((α' / α : Lˣ)) : L) ^ n = 1 := by
    rw [Units.val_div_eq_div_val, div_pow, hα', hα]
    exact div_self ((map_ne_zero (algebraMap K L)).mpr (Units.ne_zero a))
  obtain ⟨i, hi, h⟩ := exists_primRootUnit_pow_eq_of_pow_eq_one hζ hdiv
  have hc : ((Units.map (algebraMap K L) (primRootUnit hζ ^ i) : Lˣ) : L) =
      algebraMap K L (ζ ^ i) := by
    rw [Units.coe_map, Units.val_pow_eq_pow_val, primRootUnit_coe]
    rfl
  have h' : (α' : L) = algebraMap K L (ζ ^ i) * (α : L) := by
    have h1 := congrArg (fun u : Lˣ => (u : L)) h
    rw [Units.val_div_eq_div_val, hc, div_eq_iff_mul_eq (Units.ne_zero α)] at h1
    exact h1.symm
  have hζ0 : ζ ≠ 0 := (hζ.isUnit (NeZero.ne n)).ne_zero
  ext
  rw [kummerRatio_coe, kummerRatio_coe, h', map_mul, AlgEquiv.commutes,
    mul_div_mul_left _ _ ((map_ne_zero (algebraMap K L)).mpr (pow_ne_zero i hζ0))]

/-- The ratio is multiplicative in the automorphism (up to the order of the multiplication). -/
lemma kummerRatio_mul (hζ : IsPrimitiveRoot ζ n) {a : Kˣ} {α : Lˣ}
    (hα : (α : L) ^ n = algebraMap K L (a : K)) (σ τ : Gal(L/K)) :
    kummerRatio (σ * τ) α = kummerRatio τ α * kummerRatio σ α := by
  obtain ⟨i, hi, h⟩ := exists_primRootUnit_pow_eq_kummerRatio hζ hα τ
  have hc : ((kummerRatio τ α : Lˣ) : L) = algebraMap K L (ζ ^ i) := by
    rw [h, Units.coe_map, Units.val_pow_eq_pow_val, primRootUnit_coe]
    rfl
  have ht : (τ : L ≃ₐ[K] L) (α : L) = algebraMap K L (ζ ^ i) * (α : L) := by
    rw [← hc, kummerRatio_coe τ α, div_mul_cancel₀ _ (Units.ne_zero α)]
  ext
  rw [Units.val_mul, kummerRatio_coe, kummerRatio_coe, kummerRatio_coe, AlgEquiv.mul_apply, ht,
    map_mul, AlgEquiv.commutes]
  field_simp [Units.ne_zero α]

/-- The Kummer pairing as a homomorphism in the automorphism variable, with values in the
`n`-th roots of unity of `L`; compare `kummerCharacter`. -/
noncomputable def kummerCharacterL (hζ : IsPrimitiveRoot ζ n) {a : Kˣ} {α : Lˣ}
    (hα : (α : L) ^ n = algebraMap K L (a : K)) : Gal(L/K) →* rootsOfUnity n L where
  toFun σ := ⟨kummerRatio σ α, kummerRatio_mem_rootsOfUnity hζ hα σ⟩
  map_one' := Subtype.ext (kummerRatio_one α)
  map_mul' := fun σ τ => Subtype.ext (by
    show kummerRatio (σ * τ) α = kummerRatio σ α * kummerRatio τ α
    rw [kummerRatio_mul hζ hα σ τ, mul_comm])

/-- The Kummer pairing `(σ, a) ↦ σ α / α`, where `α ^ n = a`, as a homomorphism in `σ`. -/
noncomputable def kummerCharacter (hζ : IsPrimitiveRoot ζ n) (a : kummerSubgroup n K L) :
    Gal(L/K) →* rootsOfUnity n K :=
  ((rootsOfUnityEquiv hζ).symm.toMonoidHom).comp (kummerCharacterL hζ (kummerRoot_pow_val a))

lemma map_kummerCharacter_apply (hζ : IsPrimitiveRoot ζ n) (a : kummerSubgroup n K L)
    (σ : Gal(L/K)) :
    Units.map (algebraMap K L) ((kummerCharacter hζ a σ : rootsOfUnity n K) : Kˣ) =
      kummerRatio σ (kummerRoot a) := by
  have key := rootsOfUnityEquivOfPrimitiveRoots_symm_apply (f := algebraMap K L)
    (algebraMap K L).injective (primitiveRoots_nonempty hζ)
    (kummerCharacterL hζ (kummerRoot_pow_val a) σ)
  refine Units.ext ?_
  rw [Units.coe_map, kummerCharacter, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    rootsOfUnityEquiv]
  exact key

/-- The Kummer quotient `(Kˣ ∩ (Lˣ)^n) / (Kˣ)^n`. -/
abbrev kummerQuotient (n : ℕ) (K : Type u) (L : Type v) [Field K] [Field L] [Algebra K L] :
    Type u :=
  kummerSubgroup n K L ⧸ (nthPowerSubgroup n Kˣ).subgroupOf (kummerSubgroup n K L)

/-- The Kummer character of an `n`-th power is trivial. -/
lemma kummerCharacter_eq_one_of_mem_nthPower (hζ : IsPrimitiveRoot ζ n) {x : kummerSubgroup n K L}
    (hx : x ∈ (nthPowerSubgroup n Kˣ).subgroupOf (kummerSubgroup n K L)) :
    kummerCharacter hζ x = 1 := by
  obtain ⟨y, hy⟩ := (Subgroup.mem_subgroupOf).mp hx
  have hyL : ((Units.map (algebraMap K L) y : Lˣ) : L) ^ n = algebraMap K L ((x : Kˣ) : K) := by
    rw [Units.coe_map, ← map_pow, ← Units.val_pow_eq_pow_val, hy]
    rfl
  refine MonoidHom.ext fun σ => ?_
  show kummerCharacter hζ x σ = 1
  have h := map_kummerCharacter_apply hζ x σ
  rw [← kummerRatio_congr hζ (kummerRoot_pow_val x) hyL σ] at h
  rw [kummerRatio, algEquivUnitsMap_unitsMap, div_self'] at h
  refine Subtype.ext ?_
  simp only [Subgroup.coe_one]
  exact Units.map_injective (algebraMap K L).injective (by simpa using h)

end Char

end Work.Kummer
