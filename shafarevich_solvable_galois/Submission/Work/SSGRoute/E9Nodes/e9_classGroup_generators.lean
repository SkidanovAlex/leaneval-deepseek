namespace Work.SSGRoute.E9Nodes

open scoped nonZeroDivisors

set_option maxHeartbeats 800000

/-- The ideal class attached to a height-one prime ideal `𝔮` of the ring of integers: the class of
the (nonzero) prime ideal `𝔮.asIdeal`. -/
noncomputable def heightOneClass (K : Type) [Field K] [NumberField K] :
    IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) →
      ClassGroup (NumberField.RingOfIntegers K) :=
  fun v => ClassGroup.mk0 ⟨v.asIdeal, mem_nonZeroDivisors_of_ne_zero v.ne_bot⟩

/-- **The class group is generated by classes of prime ideals.**  Every element of the class group
lies in the subgroup generated by the classes of the finitely many height-one primes occurring in
the factorization of any nonzero integral ideal representing it.

A representative is produced by `ClassGroup.mk0_surjective`.  Writing it as
`I = ∏ᶠ 𝔮, 𝔮.maxPowDividing I` (`Ideal.finprod_heightOneSpectrum_factorization`) and observing that
only the finitely many primes dividing `I` contribute (`Ideal.finite_factors`), we obtain `mk0 I` as
a finite product of powers of classes of prime ideals. -/
lemma exists_finset_mem_closure_heightOneClass (K : Type) [Field K] [NumberField K]
    (x : ClassGroup (NumberField.RingOfIntegers K)) :
    ∃ F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      x ∈ Subgroup.closure (heightOneClass K ''
        (↑F : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))) := by
  classical
  obtain ⟨I, hIx⟩ := ClassGroup.mk0_surjective x
  have hI0 : (I : Ideal (NumberField.RingOfIntegers K)) ≠ 0 :=
    mem_nonZeroDivisors_iff_ne_zero.mp I.2
  let F : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    (Ideal.finite_factors hI0).toFinset
  refine ⟨F, ?_⟩
  rw [← hIx]
  set e : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) → ℕ :=
    fun v => (Associates.mk v.asIdeal).count
      (Associates.mk (I : Ideal (NumberField.RingOfIntegers K))).factors with he
  have hmulsub : Function.mulSupport
      (fun v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K) =>
        v.maxPowDividing (I : Ideal (NumberField.RingOfIntegers K))) ⊆ ↑F := by
    intro v hv
    rw [Function.mem_mulSupport] at hv
    change v ∈ ↑((Ideal.finite_factors hI0).toFinset)
    rw [Set.Finite.mem_toFinset]
    change v.asIdeal ∣ (I : Ideal (NumberField.RingOfIntegers K))
    rw [← Associates.count_ne_zero_iff_dvd hI0 v.irreducible]
    intro hc
    exact hv (by rw [IsDedekindDomain.HeightOneSpectrum.maxPowDividing, hc, pow_zero])
  have hprod : (I : Ideal (NumberField.RingOfIntegers K)) =
      ∏ v ∈ F, (v.asIdeal : Ideal (NumberField.RingOfIntegers K)) ^ e v := by
    rw [← Ideal.finprod_heightOneSpectrum_factorization hI0]
    rw [finprod_eq_prod_of_mulSupport_subset _ hmulsub]
    apply Finset.prod_congr rfl
    intro v _
    rfl
  have hsub : I = ∏ v ∈ F, (⟨v.asIdeal, mem_nonZeroDivisors_of_ne_zero v.ne_bot⟩ :
      (Ideal (NumberField.RingOfIntegers K))⁰) ^ e v := by
    apply Subtype.ext
    rw [Submonoid.coe_finsetProd]
    simp only [SubmonoidClass.coe_pow]
    exact hprod
  have hcg : ClassGroup.mk0 I = ∏ v ∈ F, (heightOneClass K v) ^ e v := by
    conv_lhs => rw [hsub]
    rw [map_prod]
    apply Finset.prod_congr rfl
    intro v _
    rw [map_pow]
    rfl
  rw [hcg]
  apply Subgroup.prod_mem
  intro v hv
  have hmem : heightOneClass K v ∈ Subgroup.closure (heightOneClass K ''
      (↑F : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)))) :=
    Subgroup.subset_closure ⟨v, hv, rfl⟩
  exact Subgroup.pow_mem _ hmem (e v)

theorem e9_classGroup_generators (K : Type) [Field K] [NumberField K] :
    ∃ S : Finset (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)),
      Subgroup.closure {d : ClassGroup (NumberField.RingOfIntegers K) |
        ∃ 𝔮 ∈ S, d = ClassGroup.mk0 ⟨𝔮.asIdeal, mem_nonZeroDivisors_of_ne_zero 𝔮.ne_bot⟩} = ⊤ := by
  classical
  choose S hS using exists_finset_mem_closure_heightOneClass K
  refine ⟨Finset.univ.biUnion S, ?_⟩
  have hset : {d : ClassGroup (NumberField.RingOfIntegers K) |
        ∃ 𝔮 ∈ Finset.univ.biUnion S,
          d = ClassGroup.mk0 ⟨𝔮.asIdeal, mem_nonZeroDivisors_of_ne_zero 𝔮.ne_bot⟩}
      = heightOneClass K '' (↑(Finset.univ.biUnion S) :
          Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))) := by
    ext d
    simp only [Set.mem_ofPred_eq, Set.mem_image, Finset.mem_coe]
    constructor <;> rintro ⟨q, hq, hqd⟩ <;> exact ⟨q, hq, hqd.symm⟩
  rw [hset, Subgroup.eq_top_iff']
  intro x
  refine Subgroup.closure_mono ?_ (hS x)
  apply Set.image_mono
  intro v hv
  exact Finset.mem_biUnion.mpr ⟨x, Finset.mem_univ x, hv⟩

end Work.SSGRoute.E9Nodes
