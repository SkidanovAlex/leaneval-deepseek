/-! # The stage-3 data of Step 4 of Theorem 15 (Schmidt–Wingberg §5)

`SSGRoute.IsProperStage p K m i j` is an existential: there are level-`m` solutions `φ` (at `τ`) and
`ψ` (at `τ+1`) satisfying the Scholz conditions for `φ` and the *stage-3* conditions for `ψ`.  The
assembly of Step 4 needs the data, not the existential, so we put the whole conjunction into a
predicate `IsProperStageData`:

* `φ` is a Scholz solution at `τ`;
* `ψ` lifts `φ` through the projection `Γ^{τ+1} →* Γ^τ`;
* `ψ` is a flow solution (hence proper, with open kernel, and `flowQuot ∘ ψ = res`);
* `ψ` satisfies condition (i) and the involution condition;
* at every finite place ramified for `ψ`, either `φ` is trivial on the whole decomposition group,
  or the local group of `ψ` is cyclic, generated by the image of the inertia.

`isProperStage_iff_exists_data` says that this is exactly `IsProperStage`, definitionally. -/

namespace Work.SSGRoute

open _root_.SSGRoute
open Work.CohomologicalShrinking

/-- **The stage-3 data at level `m`** attached to a pair `(φ, ψ)`: precisely the body of
`SSGRoute.IsProperStage p K m i j` for the names `φ`, `ψ`. -/
def IsProperStageData (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (m i j : ℕ)
    (φ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m i j)
    (ψ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m (tauSucc i j).1 (tauSucc i j).2) : Prop :=
  SSGRoute.IsScholzSolution p K m i j φ ∧ SSGRoute.LiftsFlow ψ φ ∧
  SSGRoute.IsFlowSolution p K m (tauSucc i j).1 (tauSucc i j).2 ψ ∧
  (∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsT1Place p K A →
    ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup → ψ σ = 1) ∧
  (∀ c : SSGRoute.GalQ, c ^ 2 = 1 → c ∈ K.fixingSubgroup → ψ c = 1) ∧
  ∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ A →
    (∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧ ψ σ ≠ 1) →
    (∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup) ∧
    ((∀ σ ∈ SSGRoute.decomp ℚ A, φ σ = 1) ∨
      (IsCyclic ((SSGRoute.decomp ℚ A).map ψ) ∧
        ∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧ ψ τ = ψ σ))

/-- `SSGRoute.IsProperStage p K m i j` is exactly the existence of stage-3 data at level `m`
(definitionally). -/
theorem isProperStage_iff_exists_data (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (m i j : ℕ) :
    SSGRoute.IsProperStage p K m i j ↔
      ∃ (φ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m i j)
        (ψ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m (tauSucc i j).1 (tauSucc i j).2),
        IsProperStageData p K m i j φ ψ :=
  Iff.rfl

/-- The stage-3 data extracted from an `IsProperStage`. -/
theorem exists_data_of_isProperStage (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (m i j : ℕ) (h : SSGRoute.IsProperStage p K m i j) :
    ∃ (φ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m i j)
      (ψ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) m (tauSucc i j).1 (tauSucc i j).2),
      IsProperStageData p K m i j φ ψ :=
  (isProperStage_iff_exists_data p K m i j).mp h

end Work.SSGRoute
