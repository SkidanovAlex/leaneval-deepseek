/-!
# `Ext¹_G(ℤ, Hom_ℤ(ℤ[G]^α, N)) = 0` when the coefficient module is coinduced from `⊥`

`homRep R N` is the internal `Hom_ℤ(R.V, N.V)` with the conjugation action (the `G`-module of
`Coeff`-linear maps), and `Rep.free Coeff G α` is the free `Coeff[G]`-module on `α` (Mathlib:
`Representation.free = (α →₀ MonoidAlgebra Coeff G)` with the left-regular action).

Whenever `Hom_ℤ(ℤ[G]^α, N) ≅ Coind_⊥^G X` — which is what Shapiro's lemma gives, since
`Hom_ℤ(ℤ[G]^α, N) ≅ ∏_α Coind_⊥^G N` — the group `Ext¹_G(ℤ, Hom_ℤ(ℤ[G]^α, N))` vanishes, i.e. is
a subsingleton.  Concretely (Shapiro for `Ext`, `ext_coind_iso_proof`):

  `Ext¹_G(ℤ, Coind_⊥^G X) ≅ Ext¹_⊥(res_⊥ ℤ, X)`,

and over the *trivial* group `⊥` the coefficient module `res_⊥ ℤ = unitRep ⊥` is the rank one
free module, hence projective, so `Ext¹` out of it vanishes
(`Abelian.Ext.subsingleton_of_projective`).  This is `H¹(1, X) = 0`.

Two supporting facts are proved here:

* `ext_subsingleton_of_iso_second` — functoriality of `Ext X · 1` in the coefficient variable at
  the level of subsingletons (transporting along an isomorphism of coefficients is injective);
* `projective_unitRep_of_subsingleton` — `unitRep H = Rep.trivial Coeff H Coeff` is projective as
  soon as the group `H` is trivial.  The lifting is built by hand: a morphism
  `unitRep H ⟶ Y` is `c ↦ c • y` (it is determined by `y = f 1`), and an epimorphism in `Rep` is
  surjective on the underlying types (`Rep.epi_iff_surjective`), so any preimage of `f 1` gives
  the lift; the equivariance is free because `H` is subsingleton.
-/

namespace Work.SSGRoute

open CategoryTheory SSGRoute.PTExt

attribute [local instance 10000] Rep.hV2 Rep.hV1 Submodule.module

noncomputable section

/-- **Transport of `Ext` in the coefficient variable.**  If `A ≅ B` as `G`-modules and
`Ext X B 1` is a subsingleton, then so is `Ext X A 1`.  (Postcomposition with `Ext.mk₀ e.hom`
and `Ext.mk₀ e.inv` are mutually inverse on `Ext X · 1`.) -/
theorem ext_subsingleton_of_iso_second {G : Type} [Group G] {A B X : Rep.{0} Coeff G}
    (e : A ≅ B) (h : Subsingleton (Abelian.Ext X B 1)) :
    Subsingleton (Abelian.Ext X A 1) := by
  have key : ∀ a : Abelian.Ext X A 1,
      (a.comp (Abelian.Ext.mk₀ e.hom) (add_zero 1)).comp (Abelian.Ext.mk₀ e.inv)
        (add_zero 1) = a := by
    intro a
    rw [Abelian.Ext.comp_assoc_of_second_deg_zero]
    rw [Abelian.Ext.mk₀_comp_mk₀, e.hom_inv_id]
    exact Abelian.Ext.comp_mk₀_id a
  refine ⟨fun a b => ?_⟩
  have h1 : (a.comp (Abelian.Ext.mk₀ e.hom) (add_zero 1)) =
      (b.comp (Abelian.Ext.mk₀ e.hom) (add_zero 1)) := Subsingleton.elim _ _
  have h2 := congrArg (fun z => z.comp (Abelian.Ext.mk₀ e.inv) (add_zero 1)) h1
  rwa [key a, key b] at h2

/-- **`unitRep H` is projective for a trivial group `H`.**  Here `unitRep H = Rep.trivial Coeff H
Coeff`, whose underlying `Coeff`-module is free of rank one and generated by `1`; since `H` is
subsingleton, equivariance of a morphism out of it is automatic. -/
theorem projective_unitRep_of_subsingleton (H : Type) [Group H] [Subsingleton H] :
    Projective (unitRep H) := by
  refine Projective.mk ?_
  intro E X f e hE
  obtain ⟨x, hx⟩ := (Rep.epi_iff_surjective e).mp hE (f.hom 1)
  have hx' : (Rep.Hom.hom e).toLinearMap x = (Rep.Hom.hom f).toLinearMap 1 := hx
  refine ⟨Rep.ofHom ⟨LinearMap.toSpanSingleton _ _ x, ?_⟩, ?_⟩
  · intro g
    rw [Subsingleton.elim g 1]
    ext
    simp
  · apply Rep.hom_ext
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro c
    show (Rep.Hom.hom e).toLinearMap ((LinearMap.toSpanSingleton _ _ x) c)
      = (Rep.Hom.hom f).toLinearMap c
    rw [LinearMap.toSpanSingleton_apply, LinearMap.map_smul, hx', ← LinearMap.map_smul]
    congr 1
    rw [smul_eq_mul, mul_one]

theorem ext_one_homRepFree_subsingleton (G : Type) [Group G] (α : Type)
    (N : Rep.{0} SSGRoute.PTExt.Coeff G)
    (X : Rep.{0} SSGRoute.PTExt.Coeff (⊥ : Subgroup G))
    (hX : Nonempty (Work.SSGRoute.homRep (Rep.free SSGRoute.PTExt.Coeff G α) N ≅
        Rep.coind (⊥ : Subgroup G).subtype X)) :
    Subsingleton (CategoryTheory.Abelian.Ext (SSGRoute.PTExt.unitRep G)
      (Work.SSGRoute.homRep (Rep.free SSGRoute.PTExt.Coeff G α) N) 1) := by
  obtain ⟨e⟩ := hX
  obtain ⟨sh⟩ := ext_coind_iso_proof G (⊥ : Subgroup G) (unitRep G) X 1
  haveI : Projective (Rep.res (⊥ : Subgroup G).subtype (unitRep G)) :=
    projective_unitRep_of_subsingleton (⊥ : Subgroup G)
  have hsub : Subsingleton
      (Abelian.Ext (Rep.res (⊥ : Subgroup G).subtype (unitRep G)) X 1) :=
    Abelian.Ext.subsingleton_of_projective
      (Rep.res (⊥ : Subgroup G).subtype (unitRep G)) X 0
  have h2 : Subsingleton (Abelian.Ext (unitRep G) (Rep.coind (⊥ : Subgroup G).subtype X) 1) :=
    ⟨fun a b => sh.injective (hsub.elim _ _)⟩
  exact ext_subsingleton_of_iso_second e h2

end

end Work.SSGRoute
