namespace Work.SSGRoute

/-- If the `p`-torsion subgroup `{t // p • t = 0}` of an additive commutative group `T` has exactly `p`
elements (for a prime `p`), then any non-zero `p`-torsion element `b` generates it: every `p`-torsion
element is an integer multiple of `b`. -/
theorem exists_zsmul_eq_of_ptorsion_card {T : Type*} [AddCommGroup T] (p : ℕ) [Fact p.Prime]
    (hT : Nat.card {t : T // p • t = 0} = p) (b : T) (hb : b ≠ 0) (hbp : p • b = 0)
    (t : T) (ht : p • t = 0) : ∃ m : ℤ, m • b = t := by
  -- The `p`-torsion subgroup of `T`, whose underlying set is exactly that of the given subtype.
  let P : AddSubgroup T :=
    { carrier := {x | p • x = 0}
      zero_mem' := by simp
      add_mem' := by
        intro a c ha hc
        have ha' : p • a = 0 := ha
        have hc' : p • c = 0 := hc
        show p • (a + c) = 0
        rw [smul_add, ha', hc', add_zero]
      neg_mem' := by
        intro a ha
        have ha' : p • a = 0 := ha
        show p • (-a) = 0
        rw [smul_neg, ha', neg_zero] }
  have hcardP : Nat.card P = p := hT
  -- `b` has additive order exactly `p`.
  have horder : addOrderOf b = p := addOrderOf_eq_prime_iff.mpr ⟨hbp, hb⟩
  -- The cyclic subgroup generated by `b` also has `p` elements.
  have hAcard : Nat.card (AddSubgroup.zmultiples b) = p := by
    rw [Nat.card_zmultiples, horder]
  -- It is contained in the `p`-torsion, since `p • b = 0`.
  have hAP : AddSubgroup.zmultiples b ≤ P := AddSubgroup.zmultiples_le.mpr hbp
  have hPfin : Finite P :=
    Nat.finite_of_card_ne_zero (by rw [hcardP]; exact (Fact.out : p.Prime).ne_zero)
  -- Two subgroups of equal finite cardinality, one contained in the other, are equal.
  have hAPeq : AddSubgroup.zmultiples b = P :=
    AddSubgroup.eq_of_le_of_card_ge hAP (by rw [hcardP, hAcard])
  have htA : t ∈ AddSubgroup.zmultiples b := by rw [hAPeq]; exact ht
  obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp htA
  exact ⟨m, hm⟩

end Work.SSGRoute
