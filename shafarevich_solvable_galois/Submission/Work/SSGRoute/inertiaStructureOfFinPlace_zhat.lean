/-!
# The inertia structure of a finite place, with `Ẑ`-quotients

The target `Work.SSGRoute.inertiaStructureOfFinPlace_zhat`: at a finite place `A` of an algebraic
closure `Ω` of a number field `k` whose residue characteristic is different from `p`, the
decomposition group `D_A = SSGRoute.decomp k A` is the semidirect product of the closed inertia
subgroup `I_A = Work.SSGRoute.inertiaSub k Ω A` with a closed procyclic subgroup
`C = closure (zpowers σ)`, `I_A ⊓ C = ⊥`, and

* every `ZMod n` (`n > 0`) is a quotient of `C`;
* `H²(I_A, M) = 0` and `H¹(I_A, M)` is finite for every finite `𝔽_p[Gal(K/k)]`-module `M`.

The first two conjuncts are proved here from the level structure of the decomposition group: for a
finite normal level `M'/k` whose inertia degree `f` is divisible by `n`
(`Work.SSGRoute.exists_level_inertiaDeg_mul_dvd`) the level subgroup
`H = (levelSub A M').comap (Subgroup.subtype D_A)` is normal in `D_A` with `D_A ⧸ H` cyclic of
order `f` generated by the class of a level generator `g`
(`Work.SSGRoute.levelSub_commutator_and_generator`,
`Work.SSGRoute.levelSub_comap_index_eq_inertiaDeg`), so that `n ∣ f` gives a surjection
`D_A ⧸ H →* Multiplicative (ZMod n)`; since `C → D_A ⧸ H` is surjective (because
`D_A ≤ I_A ⊔ C`, so that every `δ ∈ D_A` is congruent to an element of `C` modulo the level
subgroup, which contains `I_A`), composition gives the required surjection `C →* Multiplicative
(ZMod n)`.

The last conjunct is the local cohomology of the inertia: `H² = 0` is the combination of the
pro-prime-to-`p` averaging argument on the wild inertia and the pro-cyclic growth argument on the
tame quotient, and `H¹` is finite because a locally constant cocycle of the inertia is determined
by its restriction to `I_A ⊓ G_K` and finitely many values.
-/

namespace Work.SSGRoute

open scoped Topology
open Filter

set_option linter.style.haveILetI false
set_option maxHeartbeats 2000000

/-- **The inertia subgroup of a finite place is closed in the Krull topology.** -/
theorem inertiaSub_isClosed_zhat (k : Type) [Field k] (Ω : Type) [Field Ω] [Algebra k Ω]
    (A : ValuationSubring Ω) [IsAlgClosure k Ω] [NumberField k] :
    IsClosed (inertiaSub k Ω A : Set (Ω ≃ₐ[k] Ω)) := by
  haveI : IsGalois k Ω := IsAlgClosure.isGalois k Ω
  rw [← isOpen_compl_iff, isOpen_iff_mem_nhds]
  intro σ hσ
  by_cases hσd : σ ∈ SSGRoute.decomp k A
  · have hbad : ∃ x : Ω, x ∈ A ∧ ¬ A.valuation (σ x - x) < 1 := by
      by_contra hc
      push_neg at hc
      exact hσ ⟨hσd, fun y hy => hc y hy⟩
    obtain ⟨x, hxA, hvx⟩ := hbad
    let E : IntermediateField k Ω := IntermediateField.adjoin k ({x} : Set Ω)
    haveI hfd : FiniteDimensional k E :=
      IntermediateField.adjoin.finiteDimensional (IsGalois.integral k x)
    have hopenE : IsOpen ((E.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) :=
      IntermediateField.fixingSubgroup_isOpen E
    have hnbhd : {τ : Ω ≃ₐ[k] Ω | σ⁻¹ * τ ∈ E.fixingSubgroup} ∈ 𝓝 σ := by
      refine (hopenE.preimage (continuous_const.mul continuous_id)).mem_nhds ?_
      simp only [Pi.mul_apply, id_eq, Set.mem_preimage]
      rw [inv_mul_cancel]
      exact E.fixingSubgroup.one_mem
    refine Filter.mem_of_superset hnbhd ?_
    intro τ hτ hτI
    apply hvx
    have hmem : (σ⁻¹ * τ) ∈ E.fixingSubgroup := hτ
    have hfix : (σ⁻¹ * τ) x = x := by
      rw [IntermediateField.mem_fixingSubgroup_iff] at hmem
      exact hmem x (IntermediateField.subset_adjoin k ({x} : Set Ω) (Set.mem_singleton x))
    have hτx : τ x = σ x := by
      have h2 : σ⁻¹ (τ x) = x := hfix
      have h3 : σ (σ⁻¹ (τ x)) = σ x := congrArg σ h2
      simpa [AlgEquiv.apply_symm_apply] using h3
    have hval := hτI.2 x hxA
    rwa [hτx] at hval
  · have hcomp : IsOpen (SSGRoute.decomp k A : Set (Ω ≃ₐ[k] Ω))ᶜ :=
      (HS.isClosed_decomp (k := k) (Ω := Ω) A).isOpen_compl
    refine Filter.mem_of_superset (hcomp.mem_nhds (by simpa using hσd)) ?_
    intro τ hτ hτI
    exact hτ hτI.1

/-- **The procyclic complement of the inertia surjects onto every `ZMod n`** (`n > 0`). -/
theorem zhat_surjection_of_level
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (σ : Ω ≃ₐ[k] Ω) (hσD : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤
      inertiaSub k Ω A ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (n : ℕ) (hn : 0 < n) :
    ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →* Multiplicative (ZMod n),
      Function.Surjective f := by
  classical
  -- a finite normal level whose inertia degree is divisible by `n`
  haveI hbotnf : NumberField ↥(⊥ : IntermediateField k Ω) :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField (⊥ : IntermediateField k Ω)
  obtain ⟨M', hM'fd, hM'norm, hM'nf, -, hdvd⟩ :=
    exists_level_inertiaDeg_mul_dvd k Ω A hA (⊥ : IntermediateField k Ω) n hn.ne'
  letI : FiniteDimensional k M' := hM'fd
  letI : Normal k M' := hM'norm
  letI : NumberField ↥M' := hM'nf
  have hdiv : n ∣ (levelPrime k Ω A hA M').asIdeal.inertiaDeg (NumberField.RingOfIntegers k) :=
    dvd_trans (dvd_mul_right n _) hdvd
  -- the level subgroup inside the decomposition group and its index
  set H : Subgroup ↥(SSGRoute.decomp k A) :=
    (levelSub A M').comap (Subgroup.subtype (SSGRoute.decomp k A)) with hHdef
  have hHindex : H.index =
      (levelPrime k Ω A hA M').asIdeal.inertiaDeg (NumberField.RingOfIntegers k) := by
    rw [hHdef]
    exact levelSub_comap_index_eq_inertiaDeg k Ω A hA M'
  -- the class of a level generator generates the cyclic quotient
  obtain ⟨hcomm, g, hgD, hgen⟩ := levelSub_commutator_and_generator k Ω A hA M'
  -- the level subgroup is normal in the decomposition group
  have hHnormal : H.Normal := by
    rw [hHdef]
    refine ⟨fun x hx g => ?_⟩
    rw [Subgroup.mem_comap] at hx ⊢
    have hcm := hcomm (g : Ω ≃ₐ[k] Ω) g.2 (x : Ω ≃ₐ[k] Ω) hx.1
    have hcoe : (SSGRoute.decomp k A).subtype (g * x * g⁻¹) =
        (g : Ω ≃ₐ[k] Ω) * (x : Ω ≃ₐ[k] Ω) * (g : Ω ≃ₐ[k] Ω)⁻¹ := by simp
    rw [hcoe]
    rw [show (g : Ω ≃ₐ[k] Ω) * (x : Ω ≃ₐ[k] Ω) * (g : Ω ≃ₐ[k] Ω)⁻¹ =
        ((g : Ω ≃ₐ[k] Ω) * (x : Ω ≃ₐ[k] Ω) * (g : Ω ≃ₐ[k] Ω)⁻¹ *
          (x : Ω ≃ₐ[k] Ω)⁻¹) * (x : Ω ≃ₐ[k] Ω) from by group]
    exact (levelSub A M').mul_mem hcm.2 hx
  haveI : H.Normal := hHnormal
  have hzpow : ∀ x : ↥(SSGRoute.decomp k A) ⧸ H,
      x ∈ Subgroup.zpowers (QuotientGroup.mk' H ⟨g, hgD⟩) := by
    intro x
    obtain ⟨δ, rfl⟩ := QuotientGroup.mk'_surjective H x
    obtain ⟨m, hm⟩ := hgen (δ : Ω ≃ₐ[k] Ω) δ.2
    have hmH : δ⁻¹ * (⟨g, hgD⟩ : ↥(SSGRoute.decomp k A)) ^ m ∈ H := by
      rw [hHdef, Subgroup.mem_comap]
      rw [show (SSGRoute.decomp k A).subtype
          (δ⁻¹ * (⟨g, hgD⟩ : ↥(SSGRoute.decomp k A)) ^ m) =
          (δ : Ω ≃ₐ[k] Ω)⁻¹ * g ^ m from by simp]
      exact hm.2
    refine Subgroup.mem_zpowers_iff.mpr ⟨m, ?_⟩
    have h1 : (QuotientGroup.mk' H δ)⁻¹ * (QuotientGroup.mk' H ⟨g, hgD⟩) ^ m = 1 := by
      have hk : δ⁻¹ * (⟨g, hgD⟩ : ↥(SSGRoute.decomp k A)) ^ m ∈
          (QuotientGroup.mk' H).ker := by
        rw [QuotientGroup.ker_mk']; exact hmH
      have h0 : QuotientGroup.mk' H
          (δ⁻¹ * (⟨g, hgD⟩ : ↥(SSGRoute.decomp k A)) ^ m) = 1 := MonoidHom.mem_ker.mp hk
      rwa [map_mul, map_inv, map_zpow] at h0
    exact (inv_mul_eq_one.mp h1).symm
  have hcard : Nat.card (↥(SSGRoute.decomp k A) ⧸ H) =
      (levelPrime k Ω A hA M').asIdeal.inertiaDeg (NumberField.RingOfIntegers k) := by
    rw [← Subgroup.index_eq_card, hHindex]
  -- the surjection `D_A ⧸ H →* Multiplicative (ZMod n)`
  haveI : NeZero n := ⟨hn.ne'⟩
  have hFsurj : Function.Surjective
      ((AddMonoidHom.toMultiplicative
          ((ZMod.castHom hdiv (ZMod n)).toAddMonoidHom)).comp
        (zmodMulEquivOfGenerator (G := ↥(SSGRoute.decomp k A) ⧸ H) hzpow hcard).symm.toMonoidHom) := by
    intro y
    obtain ⟨a, ha⟩ := ZMod.castHom_surjective hdiv (Multiplicative.toAdd y)
    refine ⟨(zmodMulEquivOfGenerator (G := ↥(SSGRoute.decomp k A) ⧸ H) hzpow hcard)
      (Multiplicative.ofAdd a), ?_⟩
    rw [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulEquiv.symm_apply_apply]
    exact congrArg Multiplicative.ofAdd ha
  -- the surjection `C →* D_A ⧸ H`
  have hCD : Subgroup.topologicalClosure (Subgroup.zpowers σ) ≤ SSGRoute.decomp k A :=
    HS.CC_le_DD A σ hσD
  have hI_le_H : (inertiaSub k Ω A).comap (Subgroup.subtype (SSGRoute.decomp k A)) ≤ H := by
    rw [hHdef]
    exact Subgroup.comap_mono (inertiaSub_le_levelSub k Ω A M')
  let ψ : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
      (↥(SSGRoute.decomp k A) ⧸ H) :=
    (QuotientGroup.mk' H).comp (Subgroup.inclusion hCD)
  have hψsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨δ, hδ⟩ := QuotientGroup.mk'_surjective H y
    obtain ⟨i, hi, γ, hγ, hiγ⟩ := HS.exists_factor A (inertiaSub k Ω A) σ
      (inertiaSub_le_decomp k Ω A) (inertiaSub_normal k Ω A) hCD hsup δ.2
    refine ⟨⟨γ, hγ⟩, ?_⟩
    have hγD : γ ∈ SSGRoute.decomp k A := hCD hγ
    have hconj : γ⁻¹ * i * γ ∈ inertiaSub k Ω A := by
      have h := inertiaSub_normal k Ω A γ⁻¹ ((SSGRoute.decomp k A).inv_mem hγD) i hi
      simpa [mul_assoc] using h
    have hmemH : (⟨γ, hγD⟩ : ↥(SSGRoute.decomp k A))⁻¹ * δ ∈ H := by
      rw [hHdef, Subgroup.mem_comap]
      rw [show (SSGRoute.decomp k A).subtype
          ((⟨γ, hγD⟩ : ↥(SSGRoute.decomp k A))⁻¹ * δ) =
          γ⁻¹ * (δ : Ω ≃ₐ[k] Ω) from by simp]
      have hmem : γ⁻¹ * i * γ ∈ levelSub A M' := inertiaSub_le_levelSub k Ω A M' hconj
      simpa [← hiγ, mul_assoc] using hmem
    have hclass : QuotientGroup.mk' H ⟨γ, hγD⟩ = QuotientGroup.mk' H δ := by
      have h1 : (QuotientGroup.mk' H ⟨γ, hγD⟩)⁻¹ * QuotientGroup.mk' H δ = 1 := by
        have hk : (⟨γ, hγD⟩ : ↥(SSGRoute.decomp k A))⁻¹ * δ ∈ (QuotientGroup.mk' H).ker := by
          rw [QuotientGroup.ker_mk']; exact hmemH
        have h0 := MonoidHom.mem_ker.mp hk
        rwa [map_mul, map_inv] at h0
      exact inv_mul_eq_one.mp h1
    have hstep : ψ ⟨γ, hγ⟩ = QuotientGroup.mk' H ⟨γ, hγD⟩ := by
      apply congrArg (QuotientGroup.mk' H)
      exact Subtype.ext rfl
    rw [hstep, hclass, hδ]
  refine ⟨((AddMonoidHom.toMultiplicative
      ((ZMod.castHom hdiv (ZMod n)).toAddMonoidHom)).comp
    (zmodMulEquivOfGenerator (G := ↥(SSGRoute.decomp k A) ⧸ H) hzpow hcard).symm.toMonoidHom).comp ψ,
    ?_⟩
  intro y
  obtain ⟨q, hq⟩ := hFsurj y
  obtain ⟨c, hc⟩ := hψsurj q
  exact ⟨c, by rw [MonoidHom.comp_apply, hc, hq]⟩

/-- **The second local cohomology of the inertia subgroup vanishes** (residue characteristic
different from `p`): the assembly of the pro-prime-to-`p` averaging argument on the wild inertia
with the pro-cyclic growth argument on the tame quotient. -/
theorem zhat_H2loc_inertia_subsingleton
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (h : ¬ A.valuation ((p : ℚ) : Ω) < 1) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subsingleton (H2loc p k Ω K M (inertiaSub k Ω A)) := by
  classical
  intro M _ _ _ _ _
  set H : Subgroup (Ω ≃ₐ[k] Ω) := inertiaSub k Ω A with hHdef
  rw [Submodule.Quotient.subsingleton_iff]
  rw [eq_top_iff]
  intro c _
  rw [Submodule.mem_comap]
  change SSGRoute.IsCoboundary2On (SSGRoute.res k K) H
    (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M)
  obtain ⟨hCc, hClc⟩ := c.2
  -- the wild inertia and the pro-cyclically growing tame quotient
  obtain ⟨V, hVnorm, hVclosed, hVpro, hVcyc, hVbig⟩ := zhat_inertia_wild_structure p k Ω A hA h
  haveI hVnormI : V.Normal := hVnorm
  have hHclosed : IsClosed (H : Set (Ω ≃ₐ[k] Ω)) := by
    rw [hHdef]; exact inertiaSub_isClosed_zhat k Ω A
  haveI : CompactSpace ↥H := isCompact_iff_compactSpace.mp hHclosed.isCompact
  let act : ↥H →* (K ≃ₐ[k] K) := (SSGRoute.res k K).comp H.subtype
  have hkerG : ∃ U₀ : Subgroup ↥H, IsOpen (U₀ : Set ↥H) ∧ U₀ ≤ act.ker := by
    refine ⟨(K.fixingSubgroup).comap H.subtype, ?_, ?_⟩
    · exact K.fixingSubgroup_isOpen.preimage continuous_subtype_val
    · have hker : act.ker = (K.fixingSubgroup).comap H.subtype := by
        show ((SSGRoute.res k K).comp H.subtype).ker = (K.fixingSubgroup).comap H.subtype
        rw [← IntermediateField.restrictNormalHom_ker, ← MonoidHom.comap_ker]
      rw [hker]
  let c' : ↥H → ↥H → M := fun g h => c.1 (g : Ω ≃ₐ[k] Ω) (h : Ω ≃ₐ[k] Ω)
  have hc' : SSGRoute.IsCocycle2 act c' := by
    intro g h l
    have h1 := hCc (g : Ω ≃ₐ[k] Ω) g.2 (h : Ω ≃ₐ[k] Ω) h.2 (l : Ω ≃ₐ[k] Ω) l.2
    simpa [act, c', SSGRoute.IsCocycle2On, Subgroup.coe_mul] using h1
  have hlc' : SSGRoute.IsLocConst2 c' := by
    obtain ⟨U₀, hU₀open, hU₀inv⟩ := hClc
    refine ⟨U₀.comap H.subtype, hU₀open.preimage continuous_subtype_val, ?_⟩
    intro g h u v hu hv
    have hu' : (u : Ω ≃ₐ[k] Ω) ∈ U₀ := hu
    have hv' : (v : Ω ≃ₐ[k] Ω) ∈ U₀ := hv
    have h1 := hU₀inv (g : Ω ≃ₐ[k] Ω) g.2 (h : Ω ≃ₐ[k] Ω) h.2 (u : Ω ≃ₐ[k] Ω) hu'
      (v : Ω ≃ₐ[k] Ω) hv' u.2 v.2
    simpa [c', SSGRoute.IsLocConst2On, Subgroup.coe_mul] using h1
  obtain ⟨b', hb'loc, hb'rel⟩ :=
    zhat_descent_proPrimeToP_proCyclicGrowth p V hVclosed hVpro act hkerG hVcyc hVbig c' hc' hlc'
  refine ⟨fun x => if hx : x ∈ H then b' ⟨x, hx⟩ else 0, ?_, ?_⟩
  · obtain ⟨N₀, hN₀open, hN₀inv⟩ := hb'loc
    obtain ⟨U, hUopen, hUle⟩ := Work.SSGRoute.exists_openSubgroup_comap_le H N₀ hN₀open
    refine ⟨U, hUopen, ?_⟩
    intro g hg u hu huH
    have hgu : g * u ∈ H := H.mul_mem hg huH
    dsimp only
    rw [dif_pos hgu, dif_pos hg]
    have hmem : (⟨u, huH⟩ : ↥H) ∈ N₀ := hUle (by rw [Subgroup.mem_comap]; exact hu)
    have hcoe : (⟨g, hg⟩ : ↥H) * ⟨u, huH⟩ = ⟨g * u, hgu⟩ := Subtype.ext rfl
    rw [← hcoe]
    exact hN₀inv ⟨g, hg⟩ (Subgroup.mem_top _) ⟨u, huH⟩ hmem (Subgroup.mem_top _)
  · intro g hg h' hh'
    have hgh : g * h' ∈ H := H.mul_mem hg hh'
    dsimp only
    rw [dif_pos hh', dif_pos hgh, dif_pos hg]
    have h1 := hb'rel ⟨g, hg⟩ (Subgroup.mem_top _) ⟨h', hh'⟩ (Subgroup.mem_top _)
    simpa [act, c', Subgroup.coe_mul] using h1

theorem inertiaStructureOfFinPlace_zhat
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (h : ¬ A.valuation ((p : ℚ) : Ω) < 1) :
    ∃ (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω),
      I ≤ SSGRoute.decomp k A ∧
      IsClosed (I : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I) ∧
      σ ∈ SSGRoute.decomp k A ∧
      SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ) ∧
      I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥ ∧
      (∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subsingleton (Work.SSGRoute.H2loc p k Ω K M I) ∧
        Module.Finite (ZMod p) (Work.SSGRoute.H1loc p k Ω K M I)) := by
  obtain ⟨σ, hσD, hsup, hinf⟩ := exists_frobenius_complement k Ω A hA
  refine ⟨inertiaSub k Ω A, σ, inertiaSub_le_decomp k Ω A, inertiaSub_isClosed_zhat k Ω A,
    inertiaSub_normal k Ω A, hσD, hsup, hinf, ?_, ?_⟩
  · intro n hn
    exact zhat_surjection_of_level p k Ω A hA σ hσD hsup n hn
  · intro M _ _ _ _ _
    refine ⟨?_, ?_⟩
    · exact zhat_H2loc_inertia_subsingleton p k Ω K A hA h M
    · haveI : Finite (Work.SSGRoute.H1loc p k Ω K M (inertiaSub k Ω A)) :=
        finite_H1loc_inertia p k Ω K A hA h M
      exact Module.Finite.of_finite

end Work.SSGRoute
