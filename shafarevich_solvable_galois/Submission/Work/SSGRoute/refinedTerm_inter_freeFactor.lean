/-!
# The refined `2`-central filtration of a free group meets the free factor in the expected way

Let `X₀ ⊆ X`, let `F = FreeGroup X` and `F₀ = FreeGroup X₀`, and let
`f = FreeGroup.map (Subtype.val : X₀ → X) : F₀ →* F` be the inclusion of free factors.
The map `f` is a *split monomorphism*: the function
`s : X → FreeGroup X₀`, sending `x ∈ X₀` to the free generator it is and every other generator
to `1`, induces by the universal property of free groups a homomorphism
`r = FreeGroup.lift s : F →* F₀` with `r ∘ f = id`.  (No assumption that `X₀` is nonempty is
needed: the value `1` is always available.)

Since the terms `P_{(i,j)} = (P_i ∩ P^j) P_{i+1}` of Schmidt–Wingberg's refined `2`-central
filtration are preserved by *surjective* homomorphisms
(`Work.CohomologicalShrinking.map_refinedTerm_le_of_surjective`), and `r` is surjective because
it is a retraction, an element of `P_{(i,j)} ⊆ F` that already lies in the free factor `F₀`
has its (unique) preimage in the corresponding term of the filtration of `F₀`.

This is the statement used to descend anti-fixed elements of `F` along the filtration to the
free factor `F₀` (cf. `Work.SSGRoute.freeGroup_refinedTerm_lifting`).
-/

/-- **The refined `2`-central filtration of `FreeGroup X` restricts to that of a free factor.**
If `w ∈ FreeGroup X` lies in the image of the inclusion `FreeGroup X₀ →* FreeGroup X` of the
free factor generated by `X₀`, and `w` belongs to the term `P_{(i,j)}` of the refined
`2`-central filtration of `FreeGroup X`, then its preimage in `FreeGroup X₀` belongs to the
corresponding term of the refined `2`-central filtration of `FreeGroup X₀`. -/
theorem refinedTerm_inter_freeFactor
    {X : Type*} (X₀ : Set X) (i j : ℕ) (w : FreeGroup X)
    (hw : w ∈ (FreeGroup.map (Subtype.val : X₀ → X)).range)
    (hmem : w ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j) :
    ∃ w₀ : FreeGroup X₀, FreeGroup.map (Subtype.val : X₀ → X) w₀ = w ∧
      w₀ ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X₀) i j := by
  classical
  -- A section of `Subtype.val` on generators: invert it on `X₀`, send everything else to `1`.
  let s : X → FreeGroup X₀ := fun x => if h : x ∈ X₀ then FreeGroup.of ⟨x, h⟩ else 1
  -- The induced retraction `r` of the free factor inclusion.
  let r : FreeGroup X →* FreeGroup X₀ := FreeGroup.lift s
  have hrf_gen : ∀ x₀ : X₀, r (FreeGroup.of (x₀ : X)) = FreeGroup.of x₀ := by
    intro x₀
    dsimp only [r]
    rw [FreeGroup.lift_apply_of]
    dsimp only [s]
    rw [dif_pos x₀.2]
  have hrf : r.comp (FreeGroup.map (Subtype.val : X₀ → X)) = MonoidHom.id (FreeGroup X₀) := by
    apply FreeGroup.ext_hom
    intro x₀
    rw [MonoidHom.comp_apply, MonoidHom.id_apply, FreeGroup.map.of]
    exact hrf_gen x₀
  have hrf' : ∀ y : FreeGroup X₀, r (FreeGroup.map (Subtype.val : X₀ → X) y) = y := by
    intro y
    have h := congrArg (fun g : FreeGroup X₀ →* FreeGroup X₀ => g y) hrf
    simpa using h
  have hsurj : Function.Surjective r := fun y =>
    ⟨FreeGroup.map (Subtype.val : X₀ → X) y, hrf' y⟩
  obtain ⟨u, rfl⟩ := MonoidHom.mem_range.mp hw
  refine ⟨u, rfl, ?_⟩
  have hmem' : r (FreeGroup.map (Subtype.val : X₀ → X) u) ∈
      Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X₀) i j :=
    Work.CohomologicalShrinking.map_refinedTerm_le_of_surjective 2 r hsurj i j
      (Subgroup.mem_map_of_mem r hmem)
  rwa [hrf' u] at hmem'

end Work.SSGRoute
