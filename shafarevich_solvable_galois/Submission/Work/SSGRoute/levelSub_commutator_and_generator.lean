/-! ## Group theory: a group generated by one element modulo a normal subgroup -/

/-- Powers of a fixed element of a group commute. -/
private lemma mul_comm_of_mem_zpowers {H : Type*} [Group H] {g x y : H}
    (hx : x ∈ Subgroup.zpowers g) (hy : y ∈ Subgroup.zpowers g) : x * y = y * x := by
  obtain ⟨a, ha⟩ := Subgroup.mem_zpowers_iff.mp hx
  obtain ⟨b, hb⟩ := Subgroup.mem_zpowers_iff.mp hy
  rw [← ha, ← hb, zpow_mul_comm]

/-- Two commuting elements have trivial commutator. -/
private lemma commutator_eq_one_of_commute {H : Type*} [Group H] {x y : H}
    (h : x * y = y * x) : x * y * x⁻¹ * y⁻¹ = 1 := by
  have hkey : x * y * x⁻¹ * y⁻¹ = (x * y) * (y * x)⁻¹ := by group
  rw [hkey, h, mul_inv_cancel]

/-- **If every element of a group is a power of one fixed element modulo a normal subgroup, then
the subgroup contains all commutators.** -/
private lemma commutator_mem_of_generator {G : Type*} [Group G] {N : Subgroup G} [N.Normal]
    {f : G} (h : ∀ σ : G, ∃ m : ℤ, σ⁻¹ * f ^ m ∈ N) (σ τ : G) :
    σ * τ * σ⁻¹ * τ⁻¹ ∈ N := by
  refine (QuotientGroup.eq_one_iff (σ * τ * σ⁻¹ * τ⁻¹)).mp ?_
  have key : ∀ x : G, (x : G ⧸ N) ∈ Subgroup.zpowers (f : G ⧸ N) := by
    intro x
    obtain ⟨m, hm⟩ := h x
    have h1 : ((x⁻¹ * f ^ m : G) : G ⧸ N) = 1 := (QuotientGroup.eq_one_iff _).mpr hm
    simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_zpow] at h1
    have h2 : (x : G ⧸ N) = (f : G ⧸ N) ^ m := by
      have h3 : (x : G ⧸ N)⁻¹ = ((f : G ⧸ N) ^ m)⁻¹ := mul_eq_one_iff_eq_inv.mp h1
      exact inv_injective h3
    exact Subgroup.mem_zpowers_iff.mpr ⟨m, h2.symm⟩
  simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv]
  exact commutator_eq_one_of_commute (mul_comm_of_mem_zpowers (key σ) (key τ))

/-! ## The level inertia in the ideal form and in the valuation form -/

/-- **The two descriptions of the automorphism of `𝓞 L` induced by `τ` agree.** -/
private theorem galRestrict_coe_eq_toRingHom {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (τ : L ≃ₐ[K] L) :
    (galRestrict (𝓞 K) K L (𝓞 L) τ : 𝓞 L →+* 𝓞 L) =
      MulSemiringAction.toRingHom (L ≃ₐ[K] L) (𝓞 L) τ := by
  ext y
  rw [MulSemiringAction.toRingHom_apply]
  change algebraMap (𝓞 L) L (((galRestrict (𝓞 K) K L (𝓞 L)) τ) y) =
    algebraMap (𝓞 L) L (τ • y)
  rw [algebraMap_galRestrict_apply, algebraMap.smul']
  rfl

/-- **The stabiliser of a prime is the set of elements fixing the induced place.** -/
private theorem placeSmul_eq_iff_smul_asIdeal {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) (τ : L ≃ₐ[K] L) :
    Submission.NeukirchUchida.Local.placeSmul τ P = P ↔ τ • P.asIdeal = P.asIdeal := by
  constructor
  · intro h
    have h2 : Ideal.map (galRestrict (𝓞 K) K L (𝓞 L) τ : 𝓞 L →+* 𝓞 L) P.asIdeal = P.asIdeal := by
      conv_rhs => rw [← congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal h]
      rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
    rw [Ideal.pointwise_smul_def, ← galRestrict_coe_eq_toRingHom]
    exact h2
  · intro h
    apply IsDedekindDomain.HeightOneSpectrum.ext
    rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
    rw [Ideal.pointwise_smul_def, ← galRestrict_coe_eq_toRingHom] at h
    exact h

/-- **The stabiliser of the valuation ring of a prime is contained in the stabiliser of the
prime.** -/
private theorem stabilizer_valuationSubringAtPrime_le_stabilizer_asIdeal {K L : Type*} [Field K]
    [Field L] [NumberField K] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] (P : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) :
    MulAction.stabilizer (L ≃ₐ[K] L)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime L P) ≤
      MulAction.stabilizer (L ≃ₐ[K] L) P.asIdeal := by
  intro τ hτ
  rw [MulAction.mem_stabilizer_iff] at hτ ⊢
  have h1 : τ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) P :=
    (Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
      P τ).mp hτ
  rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup] at h1
  exact (placeSmul_eq_iff_smul_asIdeal P τ).mp h1

/-- **The level inertia in the sense of ideals is the level inertia in the sense of the valuation
ring**: the elements of `Gal(L/K)` acting trivially on `𝓞 L ⧸ P` are the elements acting trivially
on the residue field of the local ring `𝒪_{L,P}`. -/
private theorem mem_inertia_iff_isTrivialAtLevel (B : ValuationSubring Ω)
    (hB : B.comap (algebraMap k Ω) ≠ ⊤) (L : IntermediateField k Ω) [FiniteDimensional k L]
    [Normal k L] [NumberField ↥L] (g : Ω ≃ₐ[k] Ω) :
    AlgEquiv.restrictNormalHom L g ∈
        Ideal.inertia (↥L ≃ₐ[k] ↥L) (levelPrime k Ω B hB L).asIdeal ↔
      IsTrivialAtLevel k Ω B hB L g := by
  rw [IsTrivialAtLevel, NK.FrobeniusBridge.IsTrivialOnResidueAtLevel, AddSubgroup.mem_inertia]
  refine forall_congr' fun x => ?_
  have hsmul : (AlgEquiv.restrictNormalHom L g) • x =
      galRestrict (NumberField.RingOfIntegers k) k ↥L (NumberField.RingOfIntegers ↥L)
        (AlgEquiv.restrictNormalHom L g) x := by
    apply NumberField.RingOfIntegers.coe_injective
    rw [algebraMap_galRestrict_apply, algebraMap.smul']
    rfl
  rw [hsmul]
  exact Iff.rfl

/-! ## The main theorem -/

theorem levelSub_commutator_and_generator (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (M : IntermediateField k Ω) [FiniteDimensional k M] [Normal k M] :
    (∀ δ₁ ∈ SSGRoute.decomp k B, ∀ δ₂ ∈ SSGRoute.decomp k B,
        δ₁ * δ₂ * δ₁⁻¹ * δ₂⁻¹ ∈ SSGRoute.decomp k B ⊓ levelSub B M) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        ∃ m : ℤ, δ⁻¹ * g ^ m ∈ SSGRoute.decomp k B ⊓ levelSub B M) := by
  classical
  have hB' : B.comap (algebraMap k Ω) ≠ ⊤ := hB
  haveI hMnf : NumberField ↥M :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField M
  haveI hMgal : IsGalois k ↥M :=
    Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  -- the prime of `𝓞 M` below the place `B`
  set P : IsDedekindDomain.HeightOneSpectrum (𝓞 ↥M) := levelPrime k Ω B hB' M with hPdef
  have hspecA : B.comap (algebraMap ↥M Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P :=
    NK.Reconstruct.primeOfLevel_spec B M (NK.Reconstruct.comap_level_ne_top hB' M)
  haveI hLies : P.asIdeal.LiesOver (Submission.NeukirchUchida.primeOf B hB').asIdeal :=
    NK.ResidueFrob.primeOfLevel_liesOver ⟨B, hB'⟩ M
  -- the decomposition group at the level and the restriction map
  set DW : Subgroup (↥M ≃ₐ[k] ↥M) := Work.LocalFields.decompositionGroup k P with hDW
  set ρ : ↥(SSGRoute.decomp k B) →* (↥M ≃ₐ[k] ↥M) :=
    (AlgEquiv.restrictNormalHom M).comp (SSGRoute.decomp k B).subtype with hρ
  have hρapply : ∀ δ : ↥(SSGRoute.decomp k B),
      ρ δ = AlgEquiv.restrictNormalHom M (δ : Ω ≃ₐ[k] Ω) := fun δ => rfl
  -- ## Step 1: the restriction of an element of `D_B` lies in the level decomposition group
  have hmemD : ∀ δ : ↥(SSGRoute.decomp k B), ρ δ ∈ DW := by
    intro δ
    have h1 : ρ δ ∈ MulAction.stabilizer (↥M ≃ₐ[k] ↥M) (B.comap (algebraMap ↥M Ω)) := by
      rw [MulAction.mem_stabilizer_iff]
      have hσ : (δ : Ω ≃ₐ[k] Ω) • B = B := MulAction.mem_stabilizer_iff.mp δ.2
      have hkey := Commons.FieldTheory.Galois.comap_smul_eq_restrictNormalHom_smul
        B (δ : Ω ≃ₐ[k] Ω) M
      rw [hσ] at hkey
      rw [hρapply δ]
      exact hkey.symm
    have h2 : ρ δ ∈ MulAction.stabilizer (↥M ≃ₐ[k] ↥M)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P) := by
      rw [← hspecA]; exact h1
    exact stabilizer_valuationSubringAtPrime_le_stabilizer_asIdeal (K := k) (L := ↥M) P h2
  -- ## Step 2: the quotient `D_P ⧸ I_P` is cyclic, so the same holds for the image of `D_B`
  haveI hcycQ : IsCyclic (↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) := by
    obtain ⟨f, hf⟩ := Work.LocalFields.exists_generator_mod_inertia (K := k) (L := ↥M)
      (Submission.NeukirchUchida.primeOf B hB') P
    refine isCyclic_iff_exists_zpowers_eq_top.mpr ⟨(f : ↥DW ⧸ _), ?_⟩
    rw [Subgroup.eq_top_iff']
    intro x
    obtain ⟨σ, rfl⟩ := QuotientGroup.mk'_surjective (N := Work.LocalFields.inertiaSubgroup k P) x
    obtain ⟨m, hm⟩ := hf σ
    refine Subgroup.mem_zpowers_iff.mpr ⟨m, ?_⟩
    have h1 : ((σ⁻¹ * f ^ m : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hm
    simp only [QuotientGroup.mk_mul, QuotientGroup.mk_inv, QuotientGroup.mk_zpow] at h1
    have h2 : ((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m =
        ((σ : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) := by
      have h3 : ((σ : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P)⁻¹ =
          (((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m)⁻¹ := by
        calc ((σ : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P)⁻¹
            = ((σ : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P)⁻¹ *
                (((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m) *
                ((((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m))⁻¹ := by
              group
          _ = 1 * ((((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m))⁻¹ := by
              rw [h1]
          _ = ((((f : ↥DW) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) ^ m))⁻¹ := by
              rw [one_mul]
      exact inv_injective h3.symm
    exact h2
  -- the composite `D_B → Gal(M/k) → D_P ⧸ I_P`
  let Φ : ↥(SSGRoute.decomp k B) →* (↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) :=
    (QuotientGroup.mk' (Work.LocalFields.inertiaSubgroup k P)).comp (ρ.codRestrict DW hmemD)
  haveI hcycR : IsCyclic ↥Φ.range := Subgroup.isCyclic Φ.range
  obtain ⟨q, hq⟩ := IsCyclic.exists_generator (α := ↥Φ.range)
  obtain ⟨g, hg⟩ := MonoidHom.mem_range.mp q.2
  -- ## Step 3: the level-inertia condition implies membership in the level subgroup
  have hlevel : ∀ ψ : Ω ≃ₐ[k] Ω, ψ ∈ SSGRoute.decomp k B →
      AlgEquiv.restrictNormalHom M ψ ∈
        Ideal.inertia (↥M ≃ₐ[k] ↥M) P.asIdeal → ψ ∈ levelSub B M := by
    intro ψ hψ hmem
    have htriv : IsTrivialAtLevel k Ω B hB' M ψ :=
      (mem_inertia_iff_isTrivialAtLevel B hB' M ψ).mp (by rwa [hPdef] at hmem)
    refine ⟨hψ, fun x => ?_⟩
    exact valuation_sub_lt_one_of_isTrivialAtLevel B hB' M ψ hψ htriv
      (y := ((x : ↥M) : Ω)) (x : ↥M).2 ((ValuationSubring.mem_comap).mp x.2)
  -- an element of `Φ.ker` has its restriction in the level inertia
  have hInertia : ∀ x : ↥(SSGRoute.decomp k B), x ∈ Φ.ker →
      AlgEquiv.restrictNormalHom M (x : Ω ≃ₐ[k] Ω) ∈
        Ideal.inertia (↥M ≃ₐ[k] ↥M) P.asIdeal := by
    intro x hx
    have h1 : ((ρ.codRestrict DW hmemD x) : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P) = 1 :=
      MonoidHom.mem_ker.mp hx
    have h2 : ρ.codRestrict DW hmemD x ∈ Work.LocalFields.inertiaSubgroup k P :=
      (QuotientGroup.eq_one_iff _).mp h1
    have h3 := (Work.LocalFields.mem_inertiaSubgroup_iff (K := k) (w := P) _).mp h2
    simpa only [MonoidHom.codRestrict_apply, Subtype.coe_mk, hρapply x] using h3
  -- ## Step 4: the two conclusions
  have hgen : ∀ σ : ↥(SSGRoute.decomp k B), ∃ m : ℤ, σ⁻¹ * g ^ m ∈ Φ.ker := by
    intro σ
    have hmem : (⟨Φ σ, ⟨σ, rfl⟩⟩ : ↥Φ.range) ∈ Subgroup.zpowers q := hq _
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
    refine ⟨m, ?_⟩
    rw [MonoidHom.mem_ker]
    have hm' : (Φ g) ^ m = Φ σ := by
      have h2 := congrArg (fun z : ↥Φ.range =>
        (z : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P)) hm
      simp only [Subgroup.coe_zpow] at h2
      simpa [← hg] using h2
    rw [map_mul, map_inv, map_zpow, hm', inv_mul_cancel]
  constructor
  · -- ## The commutator of two elements of `D_B` lies in the level subgroup
    intro δ₁ hδ₁ δ₂ hδ₂
    set d₁ : ↥(SSGRoute.decomp k B) := ⟨δ₁, hδ₁⟩ with hd₁
    set d₂ : ↥(SSGRoute.decomp k B) := ⟨δ₂, hδ₂⟩ with hd₂
    have hker : d₁ * d₂ * d₁⁻¹ * d₂⁻¹ ∈ Φ.ker :=
      commutator_mem_of_generator (N := Φ.ker) hgen d₁ d₂
    have hd : ((d₁ * d₂ * d₁⁻¹ * d₂⁻¹ : ↥(SSGRoute.decomp k B)) : Ω ≃ₐ[k] Ω) ∈
        SSGRoute.decomp k B := (d₁ * d₂ * d₁⁻¹ * d₂⁻¹).2
    have hI := hInertia _ hker
    have hsub := hlevel _ hd hI
    have hmem1 : δ₁ * δ₂ * δ₁⁻¹ * δ₂⁻¹ ∈ SSGRoute.decomp k B := by
      simpa only [hd₁, hd₂, Subtype.coe_mk, Subgroup.coe_mul, Subgroup.coe_inv] using hd
    have hmem2 : δ₁ * δ₂ * δ₁⁻¹ * δ₂⁻¹ ∈ levelSub B M := by
      simpa only [hd₁, hd₂, Subtype.coe_mk, Subgroup.coe_mul, Subgroup.coe_inv] using hsub
    rw [Subgroup.mem_inf]
    exact ⟨hmem1, hmem2⟩
  · -- ## `D_B` is generated by a single element modulo the level subgroup
    refine ⟨(g : Ω ≃ₐ[k] Ω), g.2, fun δ hδ => ?_⟩
    set d : ↥(SSGRoute.decomp k B) := ⟨δ, hδ⟩ with hd
    have hmem : (⟨Φ d, ⟨d, rfl⟩⟩ : ↥Φ.range) ∈ Subgroup.zpowers q := hq _
    obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
    have hm' : (Φ g) ^ m = Φ d := by
      have h2 := congrArg (fun z : ↥Φ.range =>
        (z : ↥DW ⧸ Work.LocalFields.inertiaSubgroup k P)) hm
      simp only [Subgroup.coe_zpow] at h2
      simpa [← hg] using h2
    refine ⟨m, ?_⟩
    have hker : d⁻¹ * g ^ m ∈ Φ.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, map_zpow, hm', inv_mul_cancel]
    have hd' : ((d⁻¹ * g ^ m : ↥(SSGRoute.decomp k B)) : Ω ≃ₐ[k] Ω) ∈ SSGRoute.decomp k B :=
      (d⁻¹ * g ^ m).2
    have hI := hInertia _ hker
    have hsub := hlevel _ hd' hI
    have hmem1 : δ⁻¹ * (g : Ω ≃ₐ[k] Ω) ^ m ∈ SSGRoute.decomp k B := by
      simpa only [hd, Subtype.coe_mk, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_zpow] using hd'
    have hmem2 : δ⁻¹ * (g : Ω ≃ₐ[k] Ω) ^ m ∈ levelSub B M := by
      simpa only [hd, Subtype.coe_mk, Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_zpow] using hsub
    rw [Subgroup.mem_inf]
    exact ⟨hmem1, hmem2⟩

end Work.SSGRoute
