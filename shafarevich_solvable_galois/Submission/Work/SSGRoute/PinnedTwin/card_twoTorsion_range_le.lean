/-!
# The 2-torsion of a homomorphic image of the units of a number field

We prove that for a number field `K` and any homomorphism `φ` from the unit group `(𝓞 K)ˣ`
into a finite abelian group `G`, the set of elements of order dividing `2` lying in the image
of `φ` has at most `2 ^ (rank K + 1)` elements.

The proof proceeds as follows.  Writing `H = φ.range`, the set in question is the `2`-torsion
subgroup `H[2]`, which is (for a finite group `H`) in bijection with the quotient `H ⧸ H²` of
`H` by its subgroup of squares.  Since `H` is generated by the images of the `rank K + 1`
generators of the unit group (a generator of the torsion subgroup together with Dirichlet's
fundamental system), the quotient `H ⧸ H²` is generated by at most `rank K + 1` elements and
has exponent `2`, hence has at most `2 ^ (rank K + 1)` elements.

## Main result

* `Work.SSGRoute.PinnedTwin.card_twoTorsion_range_le`
-/

namespace Work.SSGRoute.PinnedTwin

/-- For a set `S` of a finite type, the `ncard` of `S` is the cardinality of the corresponding
subtype. -/
theorem twoTorsion_ncard_eq_natCard {α : Type} [Fintype α] (S : Set α) :
    S.ncard = Nat.card ↥S := by
  classical
  haveI : Fintype ↥S := Fintype.ofFinite _
  rw [Set.ncard_eq_toFinset_card' S, Set.toFinset_card]
  exact (Nat.card_eq_fintype_card).symm

/-- A surjective homomorphism carries a generating finset to a generating finset. -/
theorem twoTorsion_closure_image_finset_eq_top {G N : Type} [Group G] [Group N]
    (f : G →* N) (s : Finset G) [DecidableEq N] (hf : Function.Surjective f)
    (hgen : Subgroup.closure (s : Set G) = ⊤) :
    Subgroup.closure ((s.image f : Finset N) : Set N) = ⊤ := by
  rw [Finset.coe_image, ← MonoidHom.map_closure f (s : Set G), hgen,
    Subgroup.map_top_of_surjective f hf]

/-- For an endomorphism `f` of a finite group, the kernel of `f` and the cokernel
`G ⧸ f.range` have the same cardinality (both are the index of `f.range`). -/
theorem twoTorsion_card_ker_eq_card_quot_range {G : Type} [Group G] [Finite G] (f : G →* G) :
    Nat.card (f.ker) = Nat.card (G ⧸ f.range) := by
  have hidx : (f.ker).index = Nat.card (f.range) := by
    rw [Subgroup.index_eq_card]
    exact Nat.card_congr (QuotientGroup.quotientKerEquivRange f).toEquiv
  have hA : Nat.card (f.ker) * Nat.card (f.range) = Nat.card G := by
    rw [← hidx]; exact Subgroup.card_mul_index f.ker
  have hB : Nat.card (f.range) * Nat.card (G ⧸ f.range) = Nat.card G := by
    rw [← Subgroup.index_eq_card f.range]; exact Subgroup.card_mul_index f.range
  have hA' : Nat.card (f.range) * Nat.card (f.ker) = Nat.card G := by rw [mul_comm]; exact hA
  have hpos : 0 < Nat.card (f.range) := Nat.card_pos
  exact Nat.eq_of_mul_eq_mul_left hpos (hA'.trans hB.symm)

/-- A finite commutative group of exponent `2` generated by a finset `s` has at most
`2 ^ s.card` elements. -/
theorem twoTorsion_card_le_two_pow_card_of_exp_two {A : Type} [CommGroup A] [Fintype A]
    (s : Finset A) (hexp : ∀ a : A, a * a = 1)
    (hgen : Subgroup.closure (s : Set A) = ⊤) : Nat.card A ≤ 2 ^ s.card := by
  classical
  -- View `A` (additively) as a vector space over `ZMod 2`.
  haveI : Module (ZMod 2) (Additive A) := AddCommGroup.zmodModule (by
    intro x
    exact Additive.ext (by
      rw [toMul_nsmul, toMul_zero, pow_two]
      exact hexp x.toMul))
  set X : Finset (Additive A) := s.image Additive.ofMul with hX
  -- The image of a generating set spans the whole `ZMod 2`-vector space.
  have hspan : Submodule.span (ZMod 2) (X : Set (Additive A)) = ⊤ := by
    have key : ∀ a : A, a ∈ Subgroup.closure (s : Set A) →
        Additive.ofMul a ∈ Submodule.span (ZMod 2) (X : Set (Additive A)) := by
      intro a ha
      refine Subgroup.closure_induction ?_ ?_ ?_ ?_ ha
      · intro x hx
        refine Submodule.subset_span ?_
        rw [Finset.mem_coe, hX]
        exact Finset.mem_image.mpr ⟨x, Finset.mem_coe.mp hx, rfl⟩
      · simpa [ofMul_one] using
          (Submodule.zero_mem (Submodule.span (ZMod 2) (X : Set (Additive A))))
      · intro x y _ _ ihx ihy
        rw [ofMul_mul]
        exact Submodule.add_mem _ ihx ihy
      · intro x _ ih
        rw [ofMul_inv]
        exact Submodule.neg_mem _ ih
    refine top_le_iff.mp ?_
    intro y _
    have hy := key (Additive.toMul y) (by rw [hgen]; trivial)
    simpa using hy
  -- Hence the dimension is bounded by the number of generators.
  have hle : Module.finrank (ZMod 2) (Additive A) ≤ s.card := by
    calc Module.finrank (ZMod 2) (Additive A)
        = Set.finrank (ZMod 2) (X : Set (Additive A)) := by
          rw [Set.finrank, hspan, finrank_top]
      _ ≤ X.card := finrank_span_finset_le_card X
      _ ≤ s.card := Finset.card_image_le
  -- A finite vector space over `ZMod 2` of dimension `d` has `2 ^ d` elements.
  have e : A ≃ Additive A := Additive.ofMul
  have hcard : Nat.card A = 2 ^ Module.finrank (ZMod 2) (Additive A) := by
    have h2 : Fintype.card (ZMod 2) = 2 := by simp
    rw [Nat.card_congr e, Nat.card_eq_fintype_card,
      Module.card_eq_pow_finrank (K := ZMod 2) (V := Additive A), h2]
  calc Nat.card A = 2 ^ Module.finrank (ZMod 2) (Additive A) := hcard
    _ ≤ 2 ^ s.card := Nat.pow_le_pow_right (by norm_num) hle

/-- The unit group `(𝓞 K)ˣ` of a number field is generated by `rank K + 1` elements:
a generator of the (cyclic, finite) torsion subgroup together with a fundamental system of
units (Dirichlet's unit theorem). -/
theorem twoTorsion_exists_generating_finset_units (K : Type) [Field K] [NumberField K] :
    ∃ s : Finset (NumberField.RingOfIntegers K)ˣ,
      s.card ≤ NumberField.Units.rank K + 1 ∧
      Subgroup.closure (s : Set (NumberField.RingOfIntegers K)ˣ) = ⊤ := by
  classical
  obtain ⟨ζ, hζ⟩ := IsCyclic.exists_generator (α := NumberField.Units.torsion K)
  set z : (NumberField.RingOfIntegers K)ˣ :=
    ((ζ : NumberField.Units.torsion K) : (NumberField.RingOfIntegers K)ˣ) with hz
  set s : Finset (NumberField.RingOfIntegers K)ˣ :=
    Finset.univ.image (NumberField.Units.fundSystem K) ∪ {z} with hs
  refine ⟨s, ?_, ?_⟩
  · rw [hs]
    have h1 : (Finset.univ.image (NumberField.Units.fundSystem K)).card ≤
        NumberField.Units.rank K := (Finset.card_image_le).trans (by simp)
    have h3 := Finset.card_union_le (Finset.univ.image (NumberField.Units.fundSystem K))
      ({z} : Finset (NumberField.RingOfIntegers K)ˣ)
    rw [Finset.card_singleton] at h3
    omega
  · refine le_antisymm le_top ?_
    rw [← NumberField.Units.closure_fundSystem_sup_torsion_eq_top K]
    refine sup_le ?_ ?_
    · refine Subgroup.closure_mono ?_
      rintro x ⟨i, rfl⟩
      rw [hs]
      exact Finset.mem_union.mpr (Or.inl (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩))
    · intro x hx
      rw [hs]
      have hx' : (⟨x, hx⟩ : NumberField.Units.torsion K) ∈ Subgroup.zpowers ζ := hζ ⟨x, hx⟩
      rw [Subgroup.mem_zpowers_iff] at hx'
      obtain ⟨k, hk⟩ := hx'
      have hkx : z ^ k = x := by
        rw [hz]
        simpa using congrArg (fun t : NumberField.Units.torsion K =>
          (t : (NumberField.RingOfIntegers K)ˣ)) hk
      rw [← hkx]
      exact Subgroup.zpow_mem _ (Subgroup.subset_closure (Finset.mem_union.mpr
        (Or.inr (Finset.mem_singleton_self z)))) k

/-- **The `2`-torsion of the image of the unit group is bounded by `2 ^ (rank K + 1)`.**
For any homomorphism `φ` from the units of a number field into a finite abelian group `G`,
the elements of order dividing `2` of `φ.range` number at most `2 ^ (Units.rank K + 1)`. -/
theorem card_twoTorsion_range_le {K : Type} [Field K] [NumberField K]
    {G : Type} [CommGroup G] [Fintype G] (φ : (NumberField.RingOfIntegers K)ˣ →* G) :
    Set.ncard {g : G | g ∈ φ.range ∧ g * g = 1}
      ≤ 2 ^ (NumberField.Units.rank K + 1) := by
  classical
  -- `f` is the squaring endomorphism of `H = φ.range`, so that `f.ker = H[2]`.
  let f : ↥(φ.range) →* ↥(φ.range) := powMonoidHom 2
  let Q : Type := (↥(φ.range)) ⧸ f.range
  have hSker : Nat.card ↥{g : G | g ∈ φ.range ∧ g * g = 1} = Nat.card ↥(f.ker) := by
    refine Nat.card_congr ?_
    refine
      { toFun := fun x => ⟨⟨x.1, x.2.1⟩, ?_⟩
        invFun := fun y => ⟨y.1.1, y.1.2, ?_⟩
        left_inv := fun x => Subtype.ext rfl
        right_inv := fun y => Subtype.ext rfl }
    · rw [MonoidHom.mem_ker]
      exact Subtype.ext (by simpa [f, pow_two] using x.2.2)
    · have hy := y.2
      rw [MonoidHom.mem_ker] at hy
      have h2 := congrArg Subtype.val hy
      simpa [f, pow_two] using h2
  rw [twoTorsion_ncard_eq_natCard, hSker,
    twoTorsion_card_ker_eq_card_quot_range f]
  -- The quotient `Q = H ⧸ H²` is generated by the images of `rank K + 1` units and has
  -- exponent `2`, so it has at most `2 ^ (rank K + 1)` elements.
  obtain ⟨s, hscard, hgen⟩ := twoTorsion_exists_generating_finset_units K
  let ψ : (NumberField.RingOfIntegers K)ˣ →* ↥(φ.range) := φ.rangeRestrict
  have hψ : Function.Surjective ψ := MonoidHom.rangeRestrict_surjective φ
  let χ : (NumberField.RingOfIntegers K)ˣ →* Q := (QuotientGroup.mk' f.range).comp ψ
  have hχ : Function.Surjective χ := (QuotientGroup.mk'_surjective f.range).comp hψ
  haveI : DecidableEq Q := Classical.decEq _
  have hgenQ : Subgroup.closure ((s.image χ : Finset Q) : Set Q) = ⊤ :=
    twoTorsion_closure_image_finset_eq_top χ s hχ hgen
  have hcardQ : (s.image χ).card ≤ NumberField.Units.rank K + 1 :=
    le_trans Finset.card_image_le hscard
  have hexpQ : ∀ q : Q, q * q = 1 := by
    intro q
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective f.range q
    rw [← map_mul]
    exact (QuotientGroup.eq_one_iff _).mpr ⟨y, by simp [f, pow_two]⟩
  calc Nat.card Q ≤ 2 ^ (s.image χ).card :=
        twoTorsion_card_le_two_pow_card_of_exp_two (s.image χ) hexpQ hgenQ
    _ ≤ 2 ^ (NumberField.Units.rank K + 1) := Nat.pow_le_pow_right (by norm_num) hcardQ

end Work.SSGRoute.PinnedTwin
