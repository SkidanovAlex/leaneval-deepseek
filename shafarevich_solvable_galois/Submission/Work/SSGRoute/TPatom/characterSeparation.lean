/-!
# Separating a coset by a character, in the elementary abelian case

If `N ⊴ H` contains all commutators (`hcomm`) and all `p`-th powers (`hpow`), then `H ⧸ N` is an
abelian group of exponent `p`, i.e. a vector space over `ZMod p`; a character `y : H →*
Multiplicative (ZMod p)` vanishing on `N` is a linear functional on `H ⧸ N`, and a non-zero vector
of a vector space is separated by a linear functional.

This is the group-theoretic input of the unramified detector's non-invariant case: there `N` is the
subgroup generated by the block elements `c x d^f` (`x ≠ x₀`, from
`Work.SSGRoute.TPatom.exists_blockSystem_transversal`), the commutators and the `p`-th powers, so
the character produced here kills every block but `x₀` — the vanishing clause consumed by
`Work.SSGRoute.TPatom.shapiroValue_ne_zero_of_single_block`.  See
`Submission/Work/SSGRoute/NOTE_TPatom_route.md` §7.2 item 1.
-/

namespace Work.SSGRoute.TPatom

/-- **A character of `H` killing `N` and not killing `x₀`, when `H/N` is elementary abelian.** -/
theorem exists_character_ker_of_subgroup {H : Type} [Group H] (p : ℕ) [Fact p.Prime]
    (N : Subgroup H) (hN : N.Normal)
    (hcomm : ∀ a b : H, a * b * a⁻¹ * b⁻¹ ∈ N)
    (hpow : ∀ a : H, a ^ p ∈ N)
    {x₀ : H} (hx₀ : x₀ ∉ N) :
    ∃ y : H →* Multiplicative (ZMod p), y x₀ ≠ 1 ∧ ∀ n ∈ N, y n = 1 := by
  classical
  haveI := hN
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  -- ## the quotient is abelian
  have hcommut : ∀ a b : H ⧸ N, a * b = b * a := by
    intro a b
    induction a using QuotientGroup.induction_on with
    | _ a =>
      induction b using QuotientGroup.induction_on with
      | _ b =>
        have key : ((a * b : H) : H ⧸ N) = ((b * a : H) : H ⧸ N) := by
          refine QuotientGroup.eq.mpr ?_
          have h1 : (a * b)⁻¹ * (b * a)
              = ((b⁻¹ * a⁻¹) * (a * b * a⁻¹ * b⁻¹) * (b⁻¹ * a⁻¹)⁻¹)⁻¹ := by group
          rw [h1]
          exact N.inv_mem (hN.conj_mem _ (hcomm a b) _)
        rw [QuotientGroup.mk_mul, QuotientGroup.mk_mul] at key
        exact key
  letI : CommGroup (H ⧸ N) :=
    { (inferInstance : Group (H ⧸ N)) with mul_comm := hcommut }
  -- ## the quotient has exponent `p`
  have hexp : ∀ x : Additive (H ⧸ N), p • x = 0 := by
    intro x
    induction x using Additive.rec with
    | ofMul a =>
      induction a using QuotientGroup.induction_on with
      | _ a =>
        rw [← ofMul_pow, ofMul_eq_zero, ← QuotientGroup.mk'_apply, ← map_pow,
          QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff _).mpr (hpow a)
  letI : Module (ZMod p) (Additive (H ⧸ N)) := AddCommGroup.zmodModule (n := p) hexp
  -- ## a non-zero vector of a vector space is separated by a functional
  have hx₀' : Additive.ofMul ((x₀ : H) : H ⧸ N) ≠ 0 := by
    intro h
    exact hx₀ ((QuotientGroup.eq_one_iff x₀).mp (ofMul_eq_zero.mp h))
  obtain ⟨f, hf⟩ := Module.Projective.exists_dual_ne_zero (ZMod p) hx₀'
  -- ## the character
  let y : H →* Multiplicative (ZMod p) :=
    { toFun := fun h => Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N h)))
      map_one' := by
        show Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N 1))) = 1
        rw [map_one (QuotientGroup.mk' N), ofMul_one, map_zero, ofAdd_zero]
      map_mul' := by
        intro a b
        show Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N (a * b))))
          = Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N a)))
            * Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N b)))
        rw [map_mul (QuotientGroup.mk' N), ofMul_mul, map_add, ofAdd_add] }
  have hval : ∀ h : H, y h
      = Multiplicative.ofAdd (f (Additive.ofMul (QuotientGroup.mk' N h))) := fun h => rfl
  refine ⟨y, ?_, ?_⟩
  · intro hc
    refine hf ?_
    rw [← QuotientGroup.mk'_apply N x₀]
    exact (ofAdd_eq_one).mp (by rw [← hval x₀]; exact hc)
  · intro n hn
    rw [hval n, show QuotientGroup.mk' N n = 1 from (QuotientGroup.eq_one_iff n).mpr hn,
      ofMul_one, map_zero, ofAdd_zero]

end Work.SSGRoute.TPatom
