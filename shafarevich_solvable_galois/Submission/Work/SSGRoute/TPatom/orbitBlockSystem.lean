/-!
# The block system of the `D`-orbits on the coordinate set `H\Γ`

This file proves, from scratch and `sorry`-free, the combinatorial input of the value formula
`Work.Sha2Lib.coindValueFormula_orbits` — the hypothesis pair `hpart`/`hblock` there.  It is
deliberately re-proved here (in the own namespace `Work.SSGRoute.TPatom`) so that the downstream
development of the Tate–Poitou atom `Work.SSGRoute.tatePoitouEmbedding_via_detectorProved` does not
have to import the still `sorry`-ed copy
`Submission/Work/Sha2Lib/exists_orbitBlockSystem.lean` (a `sorry` in an imported module taints the
axiom closure of everything above it).

Statement.  `Γ` a finite group, `H ⊴ Γ`, `D ≤ Γ`, `d ∈ D` whose class in `Γ ⧸ H` has order exactly
`f > 0` and generates `D/(D ∩ H)` (in the form: every `δ ∈ D` is congruent to a power of `d`
modulo `H`).  Then there is `X : Finset Γ` such that every `γ : Γ` lies in exactly one block
`x · d^j · H` (`x ∈ X`, `j : Fin f`), and every block is `D`-stable.

Proof.  Put `Q : Γ →* Γ ⧸ H` for the quotient map and `g := Q d`.  The section
`sect γ := Quotient.out (Q γ)` of `Γ → Γ ⧸ P` with `P := Q⁻¹⟨g⟩` satisfies
`(sect γ)⁻¹ * γ ∈ P`, i.e. `Q γ = Q (sect γ) · g^k` for some `k : ℤ`; reducing `k` modulo `f`
(using `g^f = 1`) gives a *unique* `j : Fin f`, whence the block decomposition with
`X := sect '' univ`.  Uniqueness of `x` uses that `sect` is idempotent and constant on `P`-cosets;
uniqueness of `j` uses `orderOf g = f`.  Stability is left-cancellation in `Γ ⧸ H`.
-/

namespace Work.SSGRoute.TPatom

/-- **The block system of the `D`-orbits on the coordinate set `H\Γ`** (the hypotheses `hpart`,
`hblock` of `Work.Sha2Lib.coindValueFormula_orbits`). -/
theorem exists_orbitBlockSystem {Γ : Type} [Group Γ] [Fintype Γ] [DecidableEq Γ]
    (H : Subgroup Γ) (hH : H.Normal) (D : Subgroup Γ) (d : ↥D) (f : ℕ) (hfpos : 0 < f)
    (hdH : ((d : Γ)) ^ f ∈ H)
    (hdgen : ∀ δ : ↥D, ∃ m : ℕ, ((δ : Γ))⁻¹ * (d : Γ) ^ m ∈ H)
    (hfmin : ∀ m : ℕ, 0 < m → m < f → ((d : Γ) ^ m) ∉ H) :
    ∃ X : Finset Γ,
      (∀ γ : Γ, ∃! q : Γ × Fin f, q.1 ∈ X ∧ γ * (q.1 * (d : Γ) ^ (q.2 : ℕ))⁻¹ ∈ H) ∧
      (∀ x ∈ X, ∀ δ : ↥D, ∃ j : Fin f, (x * (δ : Γ)) * (x * (d : Γ) ^ (j : ℕ))⁻¹ ∈ H) := by
  classical
  haveI : H.Normal := hH
  -- the quotient map
  let Q : Γ →* Γ ⧸ H := QuotientGroup.mk' H
  have hQapply : ∀ x : Γ, Q x = (x : Γ ⧸ H) := fun x => QuotientGroup.mk'_apply H x
  have hpow : ∀ m : ℕ, Q ((d : Γ) ^ m) = (Q (d : Γ)) ^ m := fun m => map_pow Q _ m
  -- the image of `d` has order exactly `f`
  have hg_f : (Q (d : Γ)) ^ f = 1 := by
    have h1 : Q ((d : Γ) ^ f) = 1 := by
      rw [hQapply]
      exact (QuotientGroup.eq_one_iff _).mpr hdH
    simpa using h1
  have hord : orderOf (Q (d : Γ)) = f := by
    rw [orderOf_eq_iff hfpos]
    refine ⟨hg_f, fun m hmf hm hcon => ?_⟩
    have hmH : ((d : Γ) ^ m) ∈ H := by
      refine (QuotientGroup.eq_one_iff _).mp ?_
      rw [← hQapply ((d : Γ) ^ m), map_pow]
      exact hcon
    exact hfmin m hm hmf hmH
  -- the subgroup of `Γ` lying over the cyclic group generated by the image of `d`
  let P : Subgroup Γ := (Subgroup.zpowers (Q (d : Γ))).comap Q
  -- the section of `Γ → Γ ⧸ P`
  let sect : Γ → Γ := fun γ => Quotient.out (QuotientGroup.mk γ : Γ ⧸ P)
  have sect_mk : ∀ γ : Γ,
      (QuotientGroup.mk (sect γ) : Γ ⧸ P) = (QuotientGroup.mk γ : Γ ⧸ P) := fun γ =>
    Quotient.out_eq' _
  have sect_rel : ∀ γ : Γ, (sect γ)⁻¹ * γ ∈ P := by
    intro γ
    refine QuotientGroup.leftRel_apply.mp (Quotient.exact ?_)
    exact sect_mk γ
  have sect_idem : ∀ γ : Γ, sect (sect γ) = sect γ := by
    intro γ
    exact congrArg Quotient.out (sect_mk γ)
  -- every `γ` sits in a block: `Q γ = Q (sect γ) * (Q d)^j` for some `j`
  have key : ∀ γ : Γ, ∃ j : Fin f, Q γ = Q (sect γ) * (Q (d : Γ)) ^ (j : ℕ) := by
    intro γ
    have hmem : Q (sect γ)⁻¹ * Q γ ∈ Subgroup.zpowers (Q (d : Γ)) := by
      have h := sect_rel γ
      rw [Subgroup.mem_comap] at h
      simpa [map_mul, map_inv] using h
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
    -- hk : (Q d) ^ k = Q (sect γ)⁻¹ * Q γ
    have hred : (Q (d : Γ)) ^ k = (Q (d : Γ)) ^ (k % (f : ℤ)) :=
      zpow_eq_zpow_emod k (by rw [zpow_natCast]; exact hg_f)
    have h0 : 0 ≤ k % (f : ℤ) := Int.emod_nonneg k (by positivity)
    have hlt : k % (f : ℤ) < (f : ℤ) := Int.emod_lt_of_pos k (by positivity)
    refine ⟨⟨(k % (f : ℤ)).toNat, (Int.toNat_lt h0).mpr hlt⟩, ?_⟩
    have h2 : (Q (d : Γ)) ^ ((k % (f : ℤ)).toNat) = Q (sect γ)⁻¹ * Q γ := by
      rw [← zpow_natCast, Int.toNat_of_nonneg h0, ← hred]
      exact hk
    rw [h2, map_inv]
    group
  -- the block set
  let X : Finset Γ := Finset.image sect Finset.univ
  have hmemX : ∀ γ : Γ, sect γ ∈ X := fun γ =>
    Finset.mem_image.mpr ⟨γ, Finset.mem_univ γ, rfl⟩
  have hX_rep : ∀ x ∈ X, ∃ a : Γ, sect a = x := by
    intro x hx
    obtain ⟨a, -, ha⟩ := Finset.mem_image.mp hx
    exact ⟨a, ha⟩
  refine ⟨X, ?_, ?_⟩
  · -- existence and uniqueness of the block coordinate
    intro γ
    obtain ⟨j, hj⟩ := key γ
    have hmem : γ * (sect γ * (d : Γ) ^ (j : ℕ))⁻¹ ∈ H := by
      have h1 : Q (γ * (sect γ * (d : Γ) ^ (j : ℕ))⁻¹) = 1 := by
        rw [map_mul, map_inv, map_mul, hpow, hj]
        group
      rw [hQapply] at h1
      exact (QuotientGroup.eq_one_iff _).mp h1
    refine ⟨(sect γ, j), ⟨hmemX γ, hmem⟩, ?_⟩
    rintro ⟨x, j'⟩ ⟨hxX, hxH⟩
    -- the membership as an equation in `Γ ⧸ H`
    have hQ1 : Q (γ * (x * (d : Γ) ^ (j' : ℕ))⁻¹) = 1 := by
      rw [hQapply]
      exact (QuotientGroup.eq_one_iff _).mpr hxH
    rw [map_mul, map_inv, map_mul, hpow] at hQ1
    rw [mul_inv_eq_one] at hQ1
    -- hQ1 : Q γ = Q x * (Q d) ^ (j' : ℕ)
    have hqs : Q (sect γ) * (Q (d : Γ)) ^ (j : ℕ) = Q x * (Q (d : Γ)) ^ (j' : ℕ) := by
      rw [← hj, hQ1]
    -- the `x`-coordinate is forced
    obtain ⟨a, ha⟩ := hX_rep x hxX
    have hqsz : Q (sect γ) * (Q (d : Γ)) ^ (j : ℤ) = Q x * (Q (d : Γ)) ^ (j' : ℤ) := by
      have h := hqs
      rw [← zpow_natCast (a := Q (d : Γ)) (n := (j : ℕ)),
        ← zpow_natCast (a := Q (d : Γ)) (n := (j' : ℕ))] at h
      exact h
    have hxP : (sect γ)⁻¹ * x ∈ P := by
      rw [Subgroup.mem_comap]
      refine Subgroup.mem_zpowers_iff.mpr ⟨(j : ℤ) - (j' : ℤ), ?_⟩
      have hkey : (Q (sect γ))⁻¹ * Q x
          = (Q (d : Γ)) ^ (j : ℤ) * ((Q (d : Γ)) ^ (j' : ℤ))⁻¹ := by
        calc (Q (sect γ))⁻¹ * Q x
            = (Q (sect γ))⁻¹ * (Q x * (Q (d : Γ)) ^ (j' : ℤ))
                * ((Q (d : Γ)) ^ (j' : ℤ))⁻¹ := by
                rw [← mul_assoc, mul_inv_cancel_right]
          _ = (Q (sect γ))⁻¹ * (Q (sect γ) * (Q (d : Γ)) ^ (j : ℤ))
                * ((Q (d : Γ)) ^ (j' : ℤ))⁻¹ := by rw [← hqsz]
          _ = (Q (d : Γ)) ^ (j : ℤ) * ((Q (d : Γ)) ^ (j' : ℤ))⁻¹ := by
                rw [inv_mul_cancel_left]
      rw [map_mul, map_inv, hkey, ← zpow_sub]
    have hxm : (QuotientGroup.mk (sect γ) : Γ ⧸ P) = QuotientGroup.mk x :=
      Quotient.sound (QuotientGroup.leftRel_apply.mpr hxP)
    have hxs : sect x = sect γ := by
      have h1 : sect (sect γ) = sect x := by
        dsimp only [sect]
        exact congrArg Quotient.out hxm
      rw [sect_idem γ] at h1
      exact h1.symm
    have hxid : sect x = x := by rw [← ha, sect_idem]
    have hxe : x = sect γ := by rw [← hxid, hxs]
    -- the `j`-coordinate is forced
    have hj' : (Q (d : Γ)) ^ (j' : ℕ) = (Q (d : Γ)) ^ (j : ℕ) := by
      have h : Q (sect γ) * (Q (d : Γ)) ^ (j : ℕ)
          = Q (sect γ) * (Q (d : Γ)) ^ (j' : ℕ) := by rw [hqs, hxe]
      exact (mul_left_cancel h).symm
    have hmod : (j' : ℕ) ≡ (j : ℕ) [MOD f] := by
      have h' : (j' : ℕ) ≡ (j : ℕ) [MOD orderOf (Q (d : Γ))] :=
        pow_eq_pow_iff_modEq.mp hj'
      rwa [hord] at h'
    have hjj : (j' : ℕ) = (j : ℕ) := Nat.ModEq.eq_of_lt_of_lt hmod j'.isLt j.isLt
    exact Prod.ext hxe (Fin.ext hjj)
  · -- stability of every block under `D`
    intro x hx δ
    obtain ⟨m, hm⟩ := hdgen δ
    have hQd : Q (δ : Γ) = (Q (d : Γ)) ^ m := by
      have h : Q ((δ : Γ)⁻¹ * (d : Γ) ^ m) = 1 := by
        rw [hQapply]
        exact (QuotientGroup.eq_one_iff _).mpr hm
      rw [map_mul, map_inv, hpow] at h
      simpa using (eq_inv_of_mul_eq_one_right h).symm
    refine ⟨⟨m % f, Nat.mod_lt m hfpos⟩, ?_⟩
    have hgoal : Q ((x * (δ : Γ)) * (x * (d : Γ) ^ (m % f))⁻¹) = 1 := by
      rw [map_mul, map_inv, map_mul, map_mul, hpow, hQd]
      have hgm : (Q (d : Γ)) ^ m = (Q (d : Γ)) ^ (m % f) := by
        conv_lhs => rw [(Nat.div_add_mod m f).symm]
        rw [pow_add, pow_mul, hg_f, one_pow, one_mul]
      rw [hgm, mul_inv_cancel]
    rw [hQapply] at hgoal
    exact (QuotientGroup.eq_one_iff _).mp hgoal

end Work.SSGRoute.TPatom
