/-!
# The concentrated-block detector `block_iff_of_concentrated`

`φ : G →* Γ` is a surjection of groups, `N ⊴ Γ` and `H = N.comap φ ⊴ G`.  `Dw ≤ Γ` is the
image of a subgroup `D ≤ G` under `φ` (this is exactly the content of `hDw` together with
`hsurjDw`), and `d ∈ D` is a generator of `D` modulo `H`, in the sense that every `δ ∈ D` is
congruent to a power of `d` modulo `H` (`hdgen`), with `d ^ f ∈ H` (`hdH`, `f > 0`).

The lemma says that a coset `φ x` lies in the `Dw·N`-coset of `φ γ` exactly when `x` itself
sits in one of the `f` `H`-cosets `γ · d^{-j} H` (`j : Fin f`).

The proof reduces both sides to the quotient `Γ ⧸ N`: writing `q` for the quotient map and
`g := q (φ d)`, both statements become `z ∈ ⟨g⟩` resp. `z = g^{-j}` for the single element
`z := q (φ γ)⁻¹ * q (φ x)`, and `g ^ f = 1` makes `{g^{-j} : j : Fin f}` exhaustive in `⟨g⟩`.
-/

namespace Work.SSGRoute.C6Detector

-- `hφ` is part of the requested statement but the proof does not need surjectivity of `φ`.
set_option linter.unusedVariables false

/-- **Cyclic subgroups as inverse powers indexed by `Fin f`.**  In a group `Q`, if `g ^ f = 1`
with `f > 0`, then the cyclic subgroup generated by `g` is exactly the set of inverses of the
first `f` powers of `g`. -/
private lemma zpowers_mem_iff_exists_fin_inv {Q : Type} [Group Q]
    (g z : Q) (f : ℕ) (hf : 0 < f) (hg : g ^ f = 1) :
    z ∈ Subgroup.zpowers g ↔ ∃ j : Fin f, z = (g ^ (j : ℕ))⁻¹ := by
  constructor
  · intro hz
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hz
    have he0 : 0 ≤ k % (f : ℤ) := Int.emod_nonneg k (by positivity)
    have helt : k % (f : ℤ) < (f : ℤ) := Int.emod_lt_of_pos k (by positivity)
    have hge : g ^ (k % (f : ℤ)) = z := by
      rw [← zpow_eq_zpow_emod k (by rw [zpow_natCast]; exact hg)]
      exact hk
    set i : ℕ := (k % (f : ℤ)).toNat
    have hii : (i : ℤ) = k % (f : ℤ) := Int.toNat_of_nonneg he0
    have hilt : i < f := by
      have h : (i : ℤ) < (f : ℤ) := by rw [hii]; exact helt
      exact_mod_cast h
    have hgi : g ^ i = z := by
      rw [← zpow_natCast (a := g) (n := i), hii]; exact hge
    have hModEq : i + (f - i) % f ≡ 0 [MOD f] := by
      have h1 : i + (f - i) % f ≡ i + (f - i) [MOD f] :=
        Nat.ModEq.add_left i (Nat.mod_modEq (f - i) f)
      rw [Nat.add_sub_cancel' (le_of_lt hilt)] at h1
      exact h1.trans (Nat.modEq_zero_iff_dvd.mpr (dvd_refl f))
    have hdvd : f ∣ i + (f - i) % f := Nat.modEq_zero_iff_dvd.mp hModEq
    have hpowsum : g ^ (i + (f - i) % f) = 1 := by
      obtain ⟨c, hc⟩ := hdvd
      rw [hc, pow_mul, hg, one_pow]
    refine ⟨⟨(f - i) % f, Nat.mod_lt _ hf⟩, ?_⟩
    rw [← hgi]
    exact eq_inv_of_mul_eq_one_left (by rw [← pow_add]; exact hpowsum)
  · rintro ⟨j, rfl⟩
    exact Subgroup.mem_zpowers_iff.mpr ⟨-(j : ℤ), by rw [zpow_neg, zpow_natCast]⟩

/-- **The image of `Dw` is the cyclic subgroup generated by `φ d`.**  The hypotheses `hDw` and
`hsurjDw` say that `Dw` is exactly the image of `D` under `φ`; quotienting by `N`, `Dw` therefore
becomes the cyclic subgroup generated by the image of `φ d`. -/
private lemma dwMap_eq_zpowers {G Γ : Type} [Group G] [Group Γ]
    (φ : G →* Γ) (N : Subgroup Γ) [N.Normal]
    (H : Subgroup G) (hH : H = N.comap φ)
    (Dw : Subgroup Γ) (D : Subgroup G) (hDw : ∀ δ : ↥D, φ δ ∈ Dw)
    (hsurjDw : ∀ δ ∈ Dw, ∃ δ' : ↥D, φ δ' = δ)
    (d : ↥D) (hdgen : ∀ δ : ↥D, ∃ m : ℕ, ((δ : G))⁻¹ * (d : G) ^ m ∈ H) :
    Dw.map (QuotientGroup.mk' N) = Subgroup.zpowers (QuotientGroup.mk' N (φ (d : G))) := by
  have hmemH : ∀ y : G, y ∈ H ↔ φ y ∈ N := by
    intro y; rw [hH, Subgroup.mem_comap]
  apply le_antisymm
  · rintro w ⟨δ, hδ, rfl⟩
    obtain ⟨δ', hδ'⟩ := hsurjDw δ hδ
    obtain ⟨m, hm⟩ := hdgen δ'
    have hmN : φ ((δ' : G)⁻¹ * (d : G) ^ m) ∈ N := (hmemH _).mp hm
    rw [map_mul, map_inv, map_pow] at hmN
    have h1 : (QuotientGroup.mk' N (φ δ'))⁻¹ * (QuotientGroup.mk' N (φ (d : G))) ^ m = 1 := by
      have h2 : QuotientGroup.mk' N ((φ δ')⁻¹ * (φ (d : G)) ^ m) = 1 := by
        rw [QuotientGroup.mk'_apply]
        exact (QuotientGroup.eq_one_iff _).mpr hmN
      rwa [map_mul, map_inv, map_pow] at h2
    have hq : QuotientGroup.mk' N (φ δ') = (QuotientGroup.mk' N (φ (d : G))) ^ m :=
      inv_mul_eq_one.mp h1
    rw [← hδ', hq]
    exact Subgroup.mem_zpowers_iff.mpr ⟨(m : ℤ), by rw [zpow_natCast]⟩
  · rw [Subgroup.zpowers_le]
    exact Subgroup.mem_map.mpr ⟨φ (d : G), hDw d, rfl⟩

/-- **The `Dw·N`-condition in the quotient.**  The existence of `δ ∈ Dw`, `n ∈ N` with
`φ γ * (δ * n) = φ x` is equivalent to the quotient class of `(φ γ)⁻¹ * φ x` lying in the image
of `Dw`. -/
private lemma lhs_iff_mem_map {G Γ : Type} [Group G] [Group Γ]
    (φ : G →* Γ) (N : Subgroup Γ) [N.Normal] (Dw : Subgroup Γ) (γ x : G) :
    (∃ δ ∈ Dw, ∃ n ∈ N, φ γ * (δ * n) = φ x) ↔
      (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x))
        ∈ Dw.map (QuotientGroup.mk' N) := by
  constructor
  · rintro ⟨δ, hδ, n, hn, heq⟩
    have hn1 : QuotientGroup.mk' N n = 1 := by
      rw [QuotientGroup.mk'_apply]; exact (QuotientGroup.eq_one_iff _).mpr hn
    have h2 : QuotientGroup.mk' N (φ γ) * QuotientGroup.mk' N δ = QuotientGroup.mk' N (φ x) := by
      have h := congrArg (QuotientGroup.mk' N) heq
      rwa [map_mul, map_mul, hn1, mul_one] at h
    refine Subgroup.mem_map.mpr ⟨δ, hδ, ?_⟩
    rw [← h2]
    group
  · rintro ⟨δ, hδ, hqδ⟩
    refine ⟨δ, hδ, δ⁻¹ * (φ γ)⁻¹ * (φ x), ?_, ?_⟩
    · have h1 : QuotientGroup.mk' N (δ⁻¹ * (φ γ)⁻¹ * (φ x)) = 1 := by
        rw [map_mul, map_mul, map_inv, map_inv, hqδ]
        group
      rw [QuotientGroup.mk'_apply] at h1
      exact (QuotientGroup.eq_one_iff _).mp h1
    · group

/-- **The `H`-coset condition in the quotient.**  With `H = N.comap φ`, the statement
`γ * (x * d^j)⁻¹ ∈ H` is the quotient equation `q (φ γ)⁻¹ * q (φ x) = (q (φ d)^j)⁻¹`. -/
private lemma rhs_iff_exists_fin {G Γ : Type} [Group G] [Group Γ]
    (φ : G →* Γ) (N : Subgroup Γ) [N.Normal]
    (H : Subgroup G) (hH : H = N.comap φ)
    (D : Subgroup G) (d : ↥D) (f : ℕ) (γ x : G) :
    (∃ j : Fin f, γ * (x * (d : G) ^ (j : ℕ))⁻¹ ∈ H) ↔
      ∃ j : Fin f,
        (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x))
          = ((QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ))⁻¹ := by
  have hmemH : ∀ y : G, y ∈ H ↔ φ y ∈ N := by
    intro y; rw [hH, Subgroup.mem_comap]
  apply exists_congr
  intro j
  have key : QuotientGroup.mk' N (φ (γ * (x * (d : G) ^ (j : ℕ))⁻¹)) =
      QuotientGroup.mk' N (φ γ) *
        (QuotientGroup.mk' N (φ x) * (QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ))⁻¹ := by
    simp only [map_mul, map_inv, map_pow]
  constructor
  · intro hh
    have hN : φ (γ * (x * (d : G) ^ (j : ℕ))⁻¹) ∈ N := (hmemH _).mp hh
    have hq1 : QuotientGroup.mk' N (φ (γ * (x * (d : G) ^ (j : ℕ))⁻¹)) = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff _).mpr hN
    rw [key] at hq1
    have h3 : QuotientGroup.mk' N (φ γ) =
        QuotientGroup.mk' N (φ x) * (QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ) :=
      mul_inv_eq_one.mp hq1
    rw [h3]
    group
  · rintro hz
    have h3 : QuotientGroup.mk' N (φ γ) =
        QuotientGroup.mk' N (φ x) * (QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ) := by
      have h4 : QuotientGroup.mk' N (φ γ) * ((QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ))⁻¹
          = QuotientGroup.mk' N (φ x) := by
        rw [← hz]
        group
      rw [← h4]
      group
    refine (hmemH _).mpr ?_
    have hq1 : QuotientGroup.mk' N (φ (γ * (x * (d : G) ^ (j : ℕ))⁻¹)) = 1 := by
      rw [key, h3]
      simp
    rw [QuotientGroup.mk'_apply] at hq1
    exact (QuotientGroup.eq_one_iff _).mp hq1

theorem block_iff_of_concentrated {G Γ : Type} [Group G] [Group Γ]
    (φ : G →* Γ) (hφ : Function.Surjective φ)
    (N : Subgroup Γ) [N.Normal]
    (H : Subgroup G) [H.Normal] (hH : H = N.comap φ)
    (Dw : Subgroup Γ) (D : Subgroup G) (hDw : ∀ δ : ↥D, φ δ ∈ Dw)
    (hsurjDw : ∀ δ ∈ Dw, ∃ δ' : ↥D, φ δ' = δ)
    (d : ↥D) (f : ℕ) (hf : 0 < f) (hdH : ((d : G)) ^ f ∈ H)
    (hdgen : ∀ δ : ↥D, ∃ m : ℕ, ((δ : G))⁻¹ * (d : G) ^ m ∈ H)
    (γ x : G) :
    (φ x ∈ {g : Γ | ∃ δ ∈ Dw, ∃ n ∈ N, φ γ * (δ * n) = g} ↔
      ∃ j : Fin f, γ * (x * (d : G) ^ (j : ℕ))⁻¹ ∈ H) := by
  have hmemH : ∀ y : G, y ∈ H ↔ φ y ∈ N := by
    intro y; rw [hH, Subgroup.mem_comap]
  have hpf : (φ (d : G)) ^ f ∈ N := by
    have h1 : φ ((d : G) ^ f) ∈ N := (hmemH _).mp hdH
    rwa [map_pow] at h1
  have hgf : (QuotientGroup.mk' N (φ (d : G))) ^ f = 1 := by
    have h1 : QuotientGroup.mk' N ((φ (d : G)) ^ f) = 1 := by
      rw [QuotientGroup.mk'_apply]
      exact (QuotientGroup.eq_one_iff _).mpr hpf
    rwa [map_pow] at h1
  have hL : (φ x ∈ {g : Γ | ∃ δ ∈ Dw, ∃ n ∈ N, φ γ * (δ * n) = g}) ↔
      (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x)) ∈
        Subgroup.zpowers (QuotientGroup.mk' N (φ (d : G))) := by
    simp only [Set.mem_ofPred_eq]
    exact (lhs_iff_mem_map φ N Dw γ x).trans (by
      simp only [dwMap_eq_zpowers φ N H hH Dw D hDw hsurjDw d hdgen])
  have hR : (∃ j : Fin f, γ * (x * (d : G) ^ (j : ℕ))⁻¹ ∈ H) ↔
      ∃ j : Fin f, (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x)) =
        ((QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ))⁻¹ :=
    rhs_iff_exists_fin φ N H hH D d f γ x
  have hA : (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x)) ∈
      Subgroup.zpowers (QuotientGroup.mk' N (φ (d : G))) ↔
      ∃ j : Fin f, (QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x)) =
        ((QuotientGroup.mk' N (φ (d : G))) ^ (j : ℕ))⁻¹ :=
    zpowers_mem_iff_exists_fin_inv (QuotientGroup.mk' N (φ (d : G)))
      ((QuotientGroup.mk' N (φ γ))⁻¹ * (QuotientGroup.mk' N (φ x))) f hf hgf
  exact hL.trans (hA.trans hR.symm)

end Work.SSGRoute.C6Detector
