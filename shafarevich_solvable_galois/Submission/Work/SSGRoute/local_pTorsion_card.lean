open SSGRoute.PTExt CategoryTheory

/-- **The `p`-torsion of a finite cyclic additive group has `p` elements.**

Let `A` be an additive commutative group of cardinality `n ≠ 0` generated by `a`
(`AddSubgroup.zmultiples a = ⊤`), so that `A` is cyclic of order `n`, and let `p` be a prime
dividing `n`.  Then the set of `p`-torsion elements `{x : A // p • x = 0}` has exactly `p`
elements: it is the unique subgroup of order `p = gcd(p, n)` of `ℤ/n`.

This is the counting step `Nat.card (pTorsion) = p` used in the local input of the
`phi0_trivial_epi_in` assembly; it is the direct cardinality consequence of
`Work.SSGRoute.pTorsion_zmod`. -/
theorem natCard_pTorsion_subtype_eq_of_zmultiples_top (A : Type) [AddCommGroup A] (p n : ℕ)
    [Fact p.Prime] (hn : n ≠ 0) (hcard : Nat.card A = n) (hp : p ∣ n) (a : A)
    (hgen : AddSubgroup.zmultiples a = ⊤) :
    Nat.card {x : A // p • x = 0} = p := by
  -- `a` generates `A`, so its additive order is the cardinality of `A`
  have ha : addOrderOf a = n := by
    have h1 : Nat.card (AddSubgroup.zmultiples a) = Nat.card A := by
      rw [hgen, AddSubgroup.card_top]
    rw [Nat.card_zmultiples] at h1
    rw [h1, hcard]
  -- the `p`-torsion is a subgroup additively isomorphic to `ZMod p`
  obtain ⟨P, χ, hP, hχ⟩ := pTorsion_zmod A p n hn hp a ha hcard
  calc Nat.card {x : A // p • x = 0} = Nat.card P :=
        Nat.card_congr (Equiv.subtypeEquivRight (fun v => (hP v).symm))
    _ = Nat.card (ZMod p) := Nat.card_congr (Equiv.ofBijective (χ : P → ZMod p) hχ)
    _ = p := Nat.card_zmod p

/-- **The `p`-torsion of the local Brauer group is `𝔽_p`.**

For a finite Galois extension `k ⊆ L` of number fields, a place `w` of `L` and a prime `p`
dividing the order of the decomposition group `D_w ≤ Gal(L/k)`, the `p`-torsion of
`extH (localUnitsK w) 2 = H²(D_w, L_wˣ) = Br(L_w/k_v)` has exactly `p` elements:

`Br(L_w/k_v)[p] ≅ ℤ/p`.

The two ingredients are the local invariant map of local class field theory, giving
`H²(D_w, L_wˣ) ≅ ℤ/|D_w|` (monogenic of order `|D_w|`), and the fact that the `p`-torsion of a
finite cyclic additive group of order divisible by `p` has `p` elements. -/
theorem local_pTorsion_card (p : ℕ) [Fact p.Prime] (k L : Type) [Field k] [NumberField k]
    [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (w : NK.GlobalCFT.Place L) (hp : p ∣ Nat.card (SSGRoute.PTExt.decompK (k := k) w)) :
    Nat.card {x : SSGRoute.PTExt.extH (SSGRoute.PTExt.localUnitsK (k := k) w) 2 // p • x = 0}
      = p := by
  -- the order of the local Brauer group is the order of the decomposition group
  have hcard : Nat.card (extH (localUnitsK (k := k) w) 2)
      = Nat.card (decompK (k := k) w) := by
    rcases w with ŵ | q
    · rw [natCard_extH_localUnits_deep_ofInfinite]
      rfl
    · exact localUnits_extH_natCard_eq_ofFinite k L q
  -- the local Brauer group is cyclic: it is generated by one element
  obtain ⟨u, hgen⟩ := extH_localUnits_generator k L w
  have hn : Nat.card (decompK (k := k) w) ≠ 0 :=
    Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  exact natCard_pTorsion_subtype_eq_of_zmultiples_top _ p _ hn hcard hp u hgen

end Work.SSGRoute
