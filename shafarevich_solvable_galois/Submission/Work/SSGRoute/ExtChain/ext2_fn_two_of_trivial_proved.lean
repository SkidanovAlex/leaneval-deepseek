/-!
# Transfer of the degree-two Hasse principle from the trivial `𝔽₂`-coefficient

The main theorem `ext2_fn_two_of_trivial_proved` is assembled here from

* `two_torsion_decomp` (`Submission/Work/SSGRoute/ExtChain/twoTorsionDecomp.lean`): the structure
  theorem for finite `𝔽₂[C₂]`-modules, i.e. a finite `2`-torsion representation `N` of a group `H`
  of order two is a direct sum of `a` copies of the trivial module `𝔽₂` and `b` copies of the regular
  module `𝔽₂[H]`, recorded as explicit coordinate maps
  `inclT, projT, inclR, projR` with `projT ≫ inclT + projR ≫ inclR = 𝟙 N`;
* `ext_injective_of_two_block`: reconstruction of an `Ext²`-class from its two blocks;
* `ext_injective_trivPow'`: injectivity on the trivial block, from the hypothesis on `𝔽₂`
  (`Work.ExtChain.ext_injective_trivPow`, coordinates on `𝔽₂^a`);
* `ext_injective_regPow'`: injectivity on the regular block, which is automatic
  (`Work.SSGRoute.ExtChain.subsingleton_ext_fpRegular`: the two-term free resolution
  `0 → ℤ[H] --2--> ℤ[H] → 𝔽₂[H] → 0` gives `Ext^{≥2}_H(𝔽₂[H],A) = 0`).
-/

namespace Work.SSGRoute.ExtChain

open CategoryTheory

noncomputable section

attribute [local instance] Classical.decEq

attribute [local instance 2000] Rep.hV2

/-! ## The linear-algebra core of the structure theorem -/

/-- **Linear-algebra core of the `𝔽₂[C₂]`-structure theorem.** A finite `𝔽₂`-vector space with an
involution `S` (i.e. a finite module over `𝔽₂[ε]/ε²`, `ε = S - 1`) decomposes into copies of the
trivial module (on which `S` acts as the identity) and of the two-dimensional module `𝔽₂[S]`
(with coordinates `(x,z)` on which `S` acts by `(x,z) ↦ (x, x+z)`).

This is `Work.SSGRoute.ExtChain.zmod_two_jordan` restated with the inverse parametrisation. -/
theorem zmod2_involution_decomposition {V : Type} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (S : V ≃ₗ[ZMod 2] V) (hS : S * S = 1) :
    ∃ (a b : ℕ)
      (Φ : V ≃ₗ[ZMod 2] ((Fin b → ZMod 2) × (Fin a → ZMod 2) × (Fin b → ZMod 2))),
      ∀ v : V, Φ (S v) = ((Φ v).1, (Φ v).2.1, (Φ v).1 + (Φ v).2.2) := by
  obtain ⟨a, b, e, he⟩ := zmod_two_jordan S hS
  refine ⟨a, b, e.symm, fun v => ?_⟩
  have h : S v = e ((e.symm v).1, ((e.symm v).2.1, (e.symm v).1 + (e.symm v).2.2)) := by
    conv_lhs => rw [← e.apply_symm_apply v]
    exact he (e.symm v)
  rw [h, LinearEquiv.symm_apply_apply]

/-! ## A group of order two has a generating involution -/

/-- A group of order two is generated by an involution. -/
theorem exists_gen_of_card_two {H : Type} [Group H] (hH : Nat.card H = 2) :
    ∃ σ : H, σ ≠ 1 ∧ σ * σ = 1 ∧ ∀ g : H, g = 1 ∨ g = σ :=
  cardTwoGenerator hH

/-! ## The structure theorem for finite `𝔽₂[C₂]`-modules -/

-- The structure theorem in the form used below is `Work.SSGRoute.ExtChain.two_torsion_decomp`
-- (in `twoTorsionDecomp.lean`): a finite `2`-torsion `N` admits coordinate maps
-- `inclT : trivPow' a ⟶ N`, `projT : N ⟶ trivPow' a`, `inclR : regPow' b ⟶ N`,
-- `projR : N ⟶ regPow' b` with `projT ≫ inclT + projR ≫ inclR = 𝟙 N`.

end

/-- **Transfer of the degree-two Hasse principle from the trivial `𝔽₂`-coefficient to an arbitrary
finite `2`-torsion first variable, over a group of order two.**

`H` is a group of order two and `N` a finite representation on which `2` acts as `0`, i.e. a finite
`𝔽₂[H]`-module.  If the coefficient map `φ : A ⟶ B` induces an *injective* map on
`Ext²_H(𝔽₂,·)` (the trivial `𝔽₂`-module), then it induces an injective map on `Ext²_H(N,·)`.

The proof is the structure theory of finite modules over `𝔽₂[C₂] = 𝔽₂[ε]/ε²` (`ε = σ - 1`,
`ε² = 0`): such a module is a direct sum of copies of the trivial module `𝔽₂` and of the regular
module `𝔽₂[H]`.  The regular summand contributes nothing in degree two
(`ExtChain.subsingleton_ext_fpRegular`: `Ext^{≥2}_H(𝔽₂[H],A) = 0`, from the two-term free
resolution `0 → ℤ[H] --2--> ℤ[H] → 𝔽₂[H] → 0`), and `Ext` is additive in its first variable, so
`Ext²_H(N,·)` is a direct summand of a finite power of `Ext²_H(𝔽₂,·)`, on which `φ` is injective by
hypothesis. -/
theorem ext2_fn_two_of_trivial_proved {H : Type} [Group H] (hH : Nat.card H = 2)
    (N : Rep.{0} SSGRoute.PTExt.Coeff H) [Finite N.V]
    (hN : ∀ x : N.V, (2 : SSGRoute.PTExt.Coeff) • x = 0)
    (A B : Rep.{0} SSGRoute.PTExt.Coeff H) (φ : A ⟶ B)
    (htriv : Function.Injective (fun z : CategoryTheory.Abelian.Ext.{0}
        (Rep.trivial SSGRoute.PTExt.Coeff H (ZMod 2)) A 2 =>
      z.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (add_zero 2))) :
    Function.Injective (fun z : CategoryTheory.Abelian.Ext.{0} N A 2 =>
      z.comp (CategoryTheory.Abelian.Ext.mk₀ φ) (add_zero 2)) := by
  -- structure theorem: `N` is a sum of a trivial block and a regular block
  obtain ⟨a, b, inclT, projT, inclR, projR, hsplit⟩ := two_torsion_decomp hH N hN
  -- injectivity on the trivial block is the hypothesis, on the regular block it is automatic
  exact ext_injective_of_two_block φ inclT projT inclR projR hsplit
    (ext_injective_trivPow' a A B φ htriv)
    (ext_injective_regPow' b A B φ)

end Work.SSGRoute.ExtChain
