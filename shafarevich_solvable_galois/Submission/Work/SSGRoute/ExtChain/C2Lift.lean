/-!
# The involutive subgroup `H = ⟨σ̄⟩ ≤ Gal(K/k)` and its class formation

The class formation `0 → Kˣ → 𝕀_K → C_K → 0` restricted to the involutive subgroup generated by
`σ̄ = res k K σ`, the long-exact-sequence step reducing the degree-one Hasse principle to the
surjectivity of `Hom_H(M, 𝕀_K) → Hom_H(M, C_K)`, and the lattice-coefficient lift itself.
-/

open CategoryTheory

noncomputable section

namespace Work.SSGRoute.ExtChain

-- The `Coeff`-module structure stored in a representation competes with the generic
-- `ULift.module` instance; as in the `NK` sources we give the stored structure priority.
attribute [local instance 10000] Rep.hV2 Rep.hV1

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K]
  [NumberField K]

/-- The `Coeff = ULift ℤ`-scalar action of the `Module` structure is the `ℤ`-scalar action. -/
lemma coeff_smul_eq_zsmul {M : Type*} [AddCommGroup M] [hM : Module SSGRoute.PTExt.Coeff M]
    (z : ℤ) (x : M) :
    (hM.toDistribMulAction.toDistribSMul.toSMul).smul (⟨z⟩ : SSGRoute.PTExt.Coeff) x = z • x := by
  have h : (hM.toDistribMulAction.toDistribSMul.toSMul).smul (⟨z⟩ : SSGRoute.PTExt.Coeff) x
      = (hM.toDistribMulAction.toDistribSMul.toSMul).smul (z : SSGRoute.PTExt.Coeff) x := rfl
  rw [h]
  exact Int.cast_smul_eq_zsmul SSGRoute.PTExt.Coeff z x

/-! ## The involutive subgroup `H = ⟨σ̄⟩` of `Gal(K/k)` -/

/-- The canonical generator `σ̄ = res k K σ` of the involutive subgroup `H ≤ Gal(K/k)`. -/
def c2gen (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] :
    ↥(Subgroup.zpowers (SSGRoute.res k K σ)) :=
  ⟨SSGRoute.res k K σ, Subgroup.mem_zpowers _⟩

lemma c2gen_mul_self {σ : Ω ≃ₐ[k] Ω} [Normal k ↥K] (hσ : σ ^ 2 = 1) :
    c2gen (K := K) σ * c2gen (K := K) σ = 1 := by
  apply Subtype.ext
  show SSGRoute.res k K σ * SSGRoute.res k K σ = 1
  rw [← map_mul, ← pow_two, hσ, map_one]

lemma c2gen_ne_one {σ : Ω ≃ₐ[k] Ω} [Normal k ↥K] (hnt : SSGRoute.res k K σ ≠ 1) :
    c2gen (K := K) σ ≠ 1 := fun h => hnt (congrArg Subtype.val h)

lemma c2gen_res_sq {σ : Ω ≃ₐ[k] Ω} [Normal k ↥K] (hσ : σ ^ 2 = 1) :
    (SSGRoute.res k K σ) ^ 2 = 1 := by
  rw [← map_pow, hσ, map_one]

/-- Every element of the involutive subgroup is a power of its canonical generator. -/
lemma c2gen_eq_zpow {σ : Ω ≃ₐ[k] Ω} [Normal k ↥K]
    (h : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :
    ∃ n : ℤ, h = c2gen (K := K) σ ^ n := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp h.2
  refine ⟨n, ?_⟩
  apply Subtype.ext
  show (h : ↥K ≃ₐ[k] ↥K) = (c2gen (K := K) σ : ↥K ≃ₐ[k] ↥K) ^ n
  rw [show (c2gen (K := K) σ : ↥K ≃ₐ[k] ↥K) = SSGRoute.res k K σ from rfl]
  exact hn.symm

/-- The class formation `0 → Kˣ → 𝕀_K → C_K → 0` restricted to the involutive subgroup
`H = ⟨σ̄⟩ ≤ Gal(K/k)`. -/
abbrev c2SES (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] : ShortComplex
    (Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :=
  (SSGRoute.PTExt.sesK k ↥K).map
    (Rep.resFunctor (Subgroup.zpowers (SSGRoute.res k K σ)).subtype)

/-- The restricted class formation is short exact. -/
theorem c2SES_shortExact (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] :
    (c2SES (K := K) σ).ShortExact :=
  (NK.HassePrinciple.ideleShortComplex_shortExact k ↥K).map_of_exact
    (Rep.resFunctor (Subgroup.zpowers (SSGRoute.res k K σ)).subtype)

@[simp] lemma c2SES_X₁ (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] : (c2SES (K := K) σ).X₁
    = Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K) :=
  rfl

@[simp] lemma c2SES_X₂ (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] : (c2SES (K := K) σ).X₂
    = Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.idelesK k ↥K) :=
  rfl

@[simp] lemma c2SES_X₃ (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] : (c2SES (K := K) σ).X₃
    = Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.classesK k ↥K) :=
  rfl

@[simp] lemma c2SES_f (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] :
    (c2SES (K := K) σ).f
      = Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K) :=
  rfl

@[simp] lemma c2SES_g (σ : Ω ≃ₐ[k] Ω) [Normal k ↥K] :
    (c2SES (K := K) σ).g
      = Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.classGroupMap k ↥K) :=
  rfl

/-! ## The long-exact-sequence step -/

/-- **The degree-one exactness step of a short exact sequence.**  If every `X ⟶ S.X₃` lifts along
`S.g`, then postcomposition with `S.f` makes `Ext¹(X,S.X₁) → Ext¹(X,S.X₂)` injective. -/
theorem c2_extOne_injective_of_surj {C : Type*} [CategoryTheory.Category C]
    [CategoryTheory.Abelian C] [CategoryTheory.HasExt C] (S : CategoryTheory.ShortComplex C)
    (hS : S.ShortExact) (X : C)
    (h : ∀ c : X ⟶ S.X₃, ∃ s : X ⟶ S.X₂,
      CategoryTheory.CategoryStruct.comp s S.g = c) :
    ∀ z : CategoryTheory.Abelian.Ext X S.X₁ 1,
      z.comp (CategoryTheory.Abelian.Ext.mk₀ S.f) (add_zero 1) = 0 → z = 0 := by
  intro z hz
  obtain ⟨x, hx⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ X hS z hz
    (n₀ := 0) (hn₀ := rfl)
  obtain ⟨c, hc⟩ : ∃ c : X ⟶ S.X₃, x = CategoryTheory.Abelian.Ext.mk₀ c :=
    ⟨CategoryTheory.Abelian.Ext.homEquiv₀ x,
      (CategoryTheory.Abelian.Ext.mk₀_homEquiv₀_apply x).symm⟩
  obtain ⟨s, hs⟩ := h c
  have hkey : x.comp hS.extClass (Nat.zero_add 1) = 0 := by
    rw [hc, ← hs, ← CategoryTheory.Abelian.Ext.mk₀_comp_mk₀ s S.g]
    refine (CategoryTheory.Abelian.Ext.comp_assoc (CategoryTheory.Abelian.Ext.mk₀ s)
      (CategoryTheory.Abelian.Ext.mk₀ S.g) hS.extClass (zero_add 0) (Nat.zero_add 1)
      (by omega)).trans ?_
    rw [hS.comp_extClass, CategoryTheory.Abelian.Ext.comp_zero]
  rw [← hx, hkey]

/-! ## `Coeff`-linear versus `ℤ`-linear maps on the carriers of representations -/

/-- The `ℤ`-linear map underlying a morphism of representations. -/
def zLinHom {G : Type} [Group G] (X Y : Rep.{0} SSGRoute.PTExt.Coeff G) (φ : X ⟶ Y) :
    X.V →ₗ[ℤ] Y.V :=
  φ.hom.toAddMonoidHom.toIntLinearMap

@[simp] lemma zLinHom_apply {G : Type} [Group G] (X Y : Rep.{0} SSGRoute.PTExt.Coeff G)
    (φ : X ⟶ Y) (x : X.V) : zLinHom X Y φ x = φ.hom x := rfl

/-- The action of an element of `G` on the carrier of a `Rep`, as a `ℤ`-linear map. -/
def actZ {G : Type} [Group G] (X : Rep.{0} SSGRoute.PTExt.Coeff G) (g : G) : X.V →ₗ[ℤ] X.V :=
  (X.ρ g).toAddMonoidHom.toIntLinearMap

@[simp] lemma actZ_apply {G : Type} [Group G] (X : Rep.{0} SSGRoute.PTExt.Coeff G) (g : G)
    (x : X.V) : actZ X g x = X.ρ g x := rfl

lemma actZ_mul {G : Type} [Group G] (X : Rep.{0} SSGRoute.PTExt.Coeff G) (g h : G) :
    actZ X (g * h) = (actZ X g).comp (actZ X h) := by
  ext x
  show X.ρ (g * h) x = X.ρ g (X.ρ h x)
  rw [map_mul]
  rfl

lemma actZ_one {G : Type} [Group G] (X : Rep.{0} SSGRoute.PTExt.Coeff G) :
    actZ X (1 : G) = LinearMap.id := by
  ext x
  show X.ρ (1 : G) x = x
  rw [map_one]
  rfl

lemma actZ_inv {G : Type} [Group G] (X : Rep.{0} SSGRoute.PTExt.Coeff G) (g : G) :
    (actZ X g).comp (actZ X g⁻¹) = LinearMap.id ∧
      (actZ X g⁻¹).comp (actZ X g) = LinearMap.id := by
  constructor
  · rw [← actZ_mul, mul_inv_cancel, actZ_one]
  · rw [← actZ_mul, inv_mul_cancel, actZ_one]

/-- **Intertwining of a `ℤ`-linear map with the action of a generator extends to the cyclic
subgroup it generates.** -/
lemma comm_zpowers_of_comm {G : Type} [Group G] {X Y : Rep.{0} SSGRoute.PTExt.Coeff G}
    (f : X.V →ₗ[ℤ] Y.V) {g : G}
    (hcomm : ∀ x : X.V, f (actZ X g x) = actZ Y g (f x)) :
    ∀ h ∈ Subgroup.zpowers g, ∀ x : X.V, f (actZ X h x) = actZ Y h (f x) := by
  have hinv_comm : ∀ x : X.V, f (actZ X g⁻¹ x) = actZ Y g⁻¹ (f x) := by
    intro x
    have hX : actZ X g (actZ X g⁻¹ x) = x := by
      rw [← LinearMap.comp_apply, (actZ_inv X g).1, LinearMap.id_apply]
    have hY : ∀ y : Y.V, actZ Y g⁻¹ (actZ Y g y) = y := by
      intro y
      rw [← LinearMap.comp_apply, (actZ_inv Y g).2, LinearMap.id_apply]
    have h1 : f x = actZ Y g (f (actZ X g⁻¹ x)) := by
      conv_lhs => rw [← hX]
      rw [hcomm]
    rw [h1, hY]
  have hP : ∀ n : ℤ, ∀ x : X.V, f (actZ X (g ^ n) x) = actZ Y (g ^ n) (f x) := by
    intro n
    refine zpow_induction_left (g := g)
      (P := fun a => ∀ x : X.V, f (actZ X a x) = actZ Y a (f x)) ?_ ?_ ?_ n
    · intro x
      rw [actZ_one, actZ_one]
      rfl
    · intro a ha x
      rw [actZ_mul, LinearMap.comp_apply, actZ_mul, LinearMap.comp_apply, hcomm, ha]
    · intro a ha x
      rw [actZ_mul, LinearMap.comp_apply, actZ_mul, LinearMap.comp_apply, hinv_comm, ha]
  intro h hh x
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hh
  subst hn
  exact hP n x

/-- **A `ℤ`-linear map is `Coeff`-linear** (`Coeff = ULift ℤ`). -/
noncomputable def coeffLin {G : Type} [Group G] (X Y : Rep.{0} SSGRoute.PTExt.Coeff G)
    (f : X.V →ₗ[ℤ] Y.V) : X.V →ₗ[SSGRoute.PTExt.Coeff] Y.V where
  toFun := f
  map_add' := f.map_add
  map_smul' c x := by
    cases c with
    | up z =>
      have hxz := coeff_smul_eq_zsmul (M := X.V) z x
      have hyz := coeff_smul_eq_zsmul (M := Y.V) z (f x)
      exact (congrArg f hxz).trans ((f.toAddMonoidHom.map_zsmul z x).trans hyz.symm)

@[simp] lemma coeffLin_apply {G : Type} [Group G] (X Y : Rep.{0} SSGRoute.PTExt.Coeff G)
    (f : X.V →ₗ[ℤ] Y.V) (x : X.V) : coeffLin X Y f x = f x := rfl

/-! ## Elementary `Additive` bookkeeping -/

section AdditiveAux
variable {A : Type} [CommGroup A]

@[simp] lemma c2_toMul_add (a b : Additive A) : (a + b).toMul = a.toMul * b.toMul := rfl

@[simp] lemma c2_toMul_neg (a : Additive A) : (-a).toMul = (a.toMul)⁻¹ := rfl

@[simp] lemma c2_toMul_sub (a b : Additive A) :
    (a - b).toMul = a.toMul * (b.toMul)⁻¹ := by
  have h : a - b = a + -b := sub_eq_add_neg a b
  rw [h, c2_toMul_add, c2_toMul_neg]

@[simp] lemma c2_toMul_zero : (0 : Additive A).toMul = 1 := rfl

@[simp] lemma c2_ofMul_mul (a b : A) :
    Additive.ofMul (a * b) = Additive.ofMul a + Additive.ofMul b := rfl

@[simp] lemma c2_ofMul_inv (a : A) : Additive.ofMul a⁻¹ = -Additive.ofMul a := rfl

@[simp] lemma c2_ofMul_toMul (a : Additive A) : (Additive.ofMul a.toMul) = a := rfl

@[simp] lemma c2_toMul_ofMul (a : A) : (Additive.ofMul a).toMul = a := rfl

lemma c2_ofMul_injective : Function.Injective (Additive.ofMul : A → Additive A) :=
  Additive.ofMul.injective

end AdditiveAux

/-! ## Agreement lemmas for an adapted basis -/

section AdaptedBasis

variable {V W : Type*} [AddCommGroup V] [Module ℤ V] [AddCommGroup W] [Module ℤ W]

/-- Two `ℤ`-linear maps out of a `ℤ`-module with a basis `B : Basis (Fin a ⊕ Fin b) ℤ V` which
agree on the `inl`-part of the basis agree on its span. -/
lemma c2_eq_on_span_inl {a b : ℕ} {B : Module.Basis (Fin a ⊕ Fin b) ℤ V} (f h : V →ₗ[ℤ] W)
    (hf : ∀ i : Fin a, f (B (Sum.inl i)) = h (B (Sum.inl i))) :
    ∀ x ∈ Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)), f x = h x := by
  intro x hx
  have hle : Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)) ≤
      LinearMap.eqLocus f h := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    simpa using hf i
  exact hle hx

/-- A `ℤ`-linear map which kills the `inl`-part of a basis kills its span. -/
lemma c2_eq_zero_on_span_inl {a b : ℕ} {B : Module.Basis (Fin a ⊕ Fin b) ℤ V} (E : V →ₗ[ℤ] W)
    (hE : ∀ i : Fin a, E (B (Sum.inl i)) = 0) :
    ∀ x ∈ Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)), E x = 0 := by
  intro x hx
  have hle : Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)) ≤ LinearMap.ker E := by
    rw [Submodule.span_le]
    rintro y ⟨i, rfl⟩
    simpa using hE i
  exact hle hx

end AdaptedBasis

/-! ## The lift -/

section

-- The `Coeff`-module structure stored in a representation competes with the generic
-- `ULift.module` instance (see `NK/HassePrinciple/UnitsLevel.lean`); we give it priority.
attribute [local instance 10000] Rep.hV2 Rep.hV1

/-- **The lattice-coefficient lift.**  Every `H`-equivariant morphism `M ⟶ C_K` lifts to an
`H`-equivariant morphism `M ⟶ 𝕀_K`. -/
theorem c2_lattice_lift (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) (hnt : SSGRoute.res k K σ ≠ 1)
    (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ)))
    [Module.Finite ℤ M.V] [Module.Free ℤ M.V]
    (c : M ⟶ Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
      (SSGRoute.PTExt.classesK k ↥K)) :
    ∃ s : M ⟶ Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
      (SSGRoute.PTExt.idelesK k ↥K),
      CategoryTheory.CategoryStruct.comp s
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.classGroupMap k ↥K)) = c := by
  -- the involutive subgroup, its generator, and the restricted coefficient modules
  let H : Subgroup (↥K ≃ₐ[k] ↥K) := Subgroup.zpowers (SSGRoute.res k K σ)
  let gen : H := c2gen (K := K) σ
  have hgensq : gen * gen = 1 := c2gen_mul_self (K := K) hσ
  have hresmul : (SSGRoute.res k K σ) * (SSGRoute.res k K σ) = 1 := by
    rw [← pow_two, c2gen_res_sq (K := K) hσ]
  let XU : Rep.{0} SSGRoute.PTExt.Coeff H := Rep.res H.subtype (SSGRoute.PTExt.unitsK k ↥K)
  let XI : Rep.{0} SSGRoute.PTExt.Coeff H := Rep.res H.subtype (SSGRoute.PTExt.idelesK k ↥K)
  let XC : Rep.{0} SSGRoute.PTExt.Coeff H := Rep.res H.subtype (SSGRoute.PTExt.classesK k ↥K)
  -- the two coefficient maps of the class formation, with their universes pinned
  let ιK : SSGRoute.PTExt.unitsK k ↥K ⟶ SSGRoute.PTExt.idelesK k ↥K :=
    NK.HassePrinciple.ideleIncl k ↥K
  let πK : SSGRoute.PTExt.idelesK k ↥K ⟶ SSGRoute.PTExt.classesK k ↥K :=
    NK.HassePrinciple.classGroupMap k ↥K
  -- the coefficient groups with their generator actions, at literal carrier types
  let actU : Additive ((↥K)ˣ) →ₗ[ℤ] Additive ((↥K)ˣ) :=
    ((SSGRoute.PTExt.unitsK k ↥K).ρ (SSGRoute.res k K σ)).toAddMonoidHom.toIntLinearMap
  let actI : Additive (NK.GlobalCFT.Idele ↥K) →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K) :=
    ((SSGRoute.PTExt.idelesK k ↥K).ρ (SSGRoute.res k K σ)).toAddMonoidHom.toIntLinearMap
  let actC : Additive (NK.GlobalCFT.IdeleClassGroup ↥K) →ₗ[ℤ]
      Additive (NK.GlobalCFT.IdeleClassGroup ↥K) :=
    ((SSGRoute.PTExt.classesK k ↥K).ρ (SSGRoute.res k K σ)).toAddMonoidHom.toIntLinearMap
  let πZ : Additive (NK.GlobalCFT.Idele ↥K) →ₗ[ℤ]
      Additive (NK.GlobalCFT.IdeleClassGroup ↥K) :=
    (πK.hom.toAddMonoidHom).toIntLinearMap
  let ιZ : Additive ((↥K)ˣ) →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K) :=
    (ιK.hom.toAddMonoidHom).toIntLinearMap
  let cZ : M.V →ₗ[ℤ] Additive (NK.GlobalCFT.IdeleClassGroup ↥K) :=
    (c.hom.toAddMonoidHom).toIntLinearMap
  -- the generator actions are involutions
  have hactU2' : ∀ z : XU.V, actZ XU gen (actZ XU gen z) = z := by
    intro z
    rw [← LinearMap.comp_apply, ← actZ_mul, hgensq, actZ_one, LinearMap.id_apply]
  have hactU2 : ∀ z : Additive ((↥K)ˣ), actU (actU z) = z := hactU2'
  have hactI2' : ∀ z : XI.V, actZ XI gen (actZ XI gen z) = z := by
    intro z
    rw [← LinearMap.comp_apply, ← actZ_mul, hgensq, actZ_one, LinearMap.id_apply]
  have hactI2 : ∀ z : Additive (NK.GlobalCFT.Idele ↥K), actI (actI z) = z := hactI2'
  -- commutation of the class maps with the generator action
  have hcls : ∀ x : M.V, cZ (actZ M gen x) = actC (cZ x) := fun x =>
    Rep.hom_comm_apply c gen x
  have hπ_comm : ∀ y : Additive (NK.GlobalCFT.Idele ↥K), πZ (actI y) = actC (πZ y) := fun y =>
    Rep.hom_comm_apply πK (SSGRoute.res k K σ) y
  have hι_comm : ∀ y : Additive ((↥K)ˣ), ιZ (actU y) = actI (ιZ y) := fun y =>
    Rep.hom_comm_apply ιK (SSGRoute.res k K σ) y
  -- the involution on `M` and an adapted basis
  let t : M.V →ₗ[ℤ] M.V := actZ M gen
  have ht : ∀ v : M.V, t (t v) = v := by
    intro v
    rw [show t (t v) = ((actZ M gen).comp (actZ M gen)) v from rfl, ← actZ_mul, hgensq,
      actZ_one, LinearMap.id_apply]
  obtain ⟨a, b, B, hBneg, hBspan⟩ := c2_adapted_basis (V := M.V) t ht
  -- a `ℤ`-linear lift of `c` along `𝕀_K ↠ C_K`
  have hπsurj : Function.Surjective πZ := by
    intro y
    obtain ⟨x, hx⟩ := (NK.HassePrinciple.classGroupMap_surjective k ↥K :
      Function.Surjective (πK.hom : (SSGRoute.PTExt.idelesK k ↥K).V →
        (SSGRoute.PTExt.classesK k ↥K).V)) y
    exact ⟨x, hx⟩
  choose g0 hg0 using fun k : Fin a ⊕ Fin b => hπsurj (cZ (B k))
  let g : M.V →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K) := B.constr ℤ g0
  have hgB : ∀ k, g (B k) = g0 k := fun k => Module.Basis.constr_basis B ℤ g0 k
  have hgx : ∀ x : M.V, πZ (g x) = cZ x := by
    have hmap : πZ.comp g = cZ := Module.Basis.ext B (fun k => by
      rw [LinearMap.comp_apply, hgB k]
      exact hg0 k)
    intro x
    have := LinearMap.congr_fun hmap x
    simpa using this
  -- the idèle-valued defect `x ↦ ρ(σ̄)(g x) - g (t x)`, which lies in `Kˣ`
  let Adef : M.V →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K) := actI.comp g - g.comp t
  have hAdef_apply : ∀ x : M.V, Adef x = actI (g x) - g (t x) := fun _ => rfl
  have hAdef_ker : ∀ x : M.V, πZ (Adef x) = 0 := by
    intro x
    rw [hAdef_apply x, map_sub, hπ_comm (g x), hgx x, hgx (t x), ← hcls x]
    exact sub_self _
  -- the composite `Kˣ ↪ 𝕀_K ↠ C_K` is zero
  have hιπ_zero : ∀ y : Additive ((↥K)ˣ), πZ (ιZ y) = 0 := by
    intro u
    have h := congrArg (fun (φ : SSGRoute.PTExt.unitsK k ↥K ⟶
        SSGRoute.PTExt.classesK k ↥K) => (Rep.Hom.hom φ) u)
      (NK.HassePrinciple.ideleIncl_comp_classGroupMap k ↥K : ιK ≫ πK = 0)
    rw [Rep.hom_comp] at h
    have hz : (Rep.Hom.hom (0 : SSGRoute.PTExt.unitsK k ↥K ⟶
        SSGRoute.PTExt.classesK k ↥K)) u = (0 : Additive (NK.GlobalCFT.IdeleClassGroup ↥K)) := rfl
    rw [hz] at h
    show (Rep.Hom.hom (NK.HassePrinciple.classGroupMap k ↥K))
      ((Rep.Hom.hom (NK.HassePrinciple.ideleIncl k ↥K)) u) = 0
    exact h
  have hker : LinearMap.ker πZ = LinearMap.range ιZ := by
    refine le_antisymm ?_ ?_
    · intro y hy
      rw [LinearMap.mem_ker] at hy
      obtain ⟨u, hu⟩ :=
        (NK.HassePrinciple.exists_ideleIncl_eq_of_classGroupMap_eq_zero (K := k) (L := ↥K) hy :
          ∃ u' : (SSGRoute.PTExt.unitsK k ↥K).V, (ιK.hom : (SSGRoute.PTExt.unitsK k ↥K).V →
            (SSGRoute.PTExt.idelesK k ↥K).V) u' = y)
      exact LinearMap.mem_range.mpr ⟨u, hu⟩
    · rintro y ⟨u, rfl⟩
      rw [LinearMap.mem_ker]
      exact hιπ_zero u
  -- the `Kˣ`-valued defect
  have hιinj : Function.Injective ιZ := fun x y h =>
    (NK.HassePrinciple.ideleIncl_injective k ↥K :
      Function.Injective (ιK.hom : (SSGRoute.PTExt.unitsK k ↥K).V →
        (SSGRoute.PTExt.idelesK k ↥K).V)) h
  let AdK : M.V →ₗ[ℤ] (LinearMap.range ιZ) := Adef.codRestrict (LinearMap.range ιZ)
    (fun x => by rw [← hker]; exact hAdef_ker x)
  let d : M.V →ₗ[ℤ] Additive ((↥K)ˣ) := (LinearEquiv.ofInjective ιZ hιinj).symm.toLinearMap.comp AdK
  have hd : ∀ x : M.V, ιZ (d x) = Adef x := by
    intro x
    have h2 : (LinearEquiv.ofInjective ιZ hιinj) (d x) = AdK x :=
      LinearEquiv.apply_symm_apply _ _
    have h3 : ((LinearEquiv.ofInjective ιZ hιinj) (d x) : Additive (NK.GlobalCFT.Idele ↥K))
        = ιZ (d x) := rfl
    rw [h2] at h3
    exact h3.symm
  -- `d` is a `1`-cocycle
  have hd_cocycle : ∀ x : M.V, d x + actU (d (t x)) = 0 := by
    intro x
    apply hιinj
    rw [map_add, map_zero, hd x, hι_comm (d (t x)), hd (t x), hAdef_apply x, hAdef_apply (t x),
      ht x, map_sub, hactI2]
    abel
  -- `d` is fixed by the generator on the `(-1)`-part
  have hd_fix : ∀ x ∈ LinearMap.ker (t + LinearMap.id), actU (d x) = d x := by
    intro x hx
    have htx : t x = -x := by
      have h := LinearMap.mem_ker.mp hx
      have h' : t x + x = 0 := by simpa using h
      exact eq_neg_of_add_eq_zero_left h'
    have h := hd_cocycle x
    rw [htx] at h
    rw [map_neg d x] at h
    rw [map_neg actU (d x)] at h
    exact (sub_eq_zero.mp h).symm
  -- the multiplicative/additive conversions of the two coefficient groups
  let toU : Additive ((↥K)ˣ) → (↥K)ˣ := fun y => Additive.toMul y
  let ofU : (↥K)ˣ → Additive ((↥K)ˣ) := fun y => Additive.ofMul y
  let toI : Additive (NK.GlobalCFT.Idele ↥K) → NK.GlobalCFT.Idele ↥K := fun y => Additive.toMul y
  let ofI : NK.GlobalCFT.Idele ↥K → Additive (NK.GlobalCFT.Idele ↥K) := fun y => Additive.ofMul y
  have toU_ofU : ∀ u : (↥K)ˣ, toU (ofU u) = u := fun _ => rfl
  have ofU_toU : ∀ y : Additive ((↥K)ˣ), ofU (toU y) = y := fun _ => rfl
  have toU_add : ∀ p q : Additive ((↥K)ˣ), toU (p + q) = toU p * toU q := fun _ _ => rfl
  have toU_zero : toU (0 : Additive ((↥K)ˣ)) = 1 := rfl
  have ofU_mul : ∀ p q : (↥K)ˣ, ofU (p * q) = ofU p + ofU q := fun _ _ => rfl
  have ofU_inv : ∀ p : (↥K)ˣ, ofU p⁻¹ = -ofU p := fun _ => rfl
  have toI_ofI : ∀ y : NK.GlobalCFT.Idele ↥K, toI (ofI y) = y := fun _ => rfl
  have ofI_toI : ∀ y : Additive (NK.GlobalCFT.Idele ↥K), ofI (toI y) = y := fun _ => rfl
  have toI_add : ∀ p q : Additive (NK.GlobalCFT.Idele ↥K), toI (p + q) = toI p * toI q :=
    fun _ _ => rfl
  have toI_ι : ∀ y : Additive ((↥K)ˣ),
      toI (ιZ y) = NK.GlobalCFT.Idele.principalIdele ↥K (toU y) := fun _ => rfl
  have actU_ofU : ∀ u : (↥K)ˣ, actU (ofU u) = ofU (SSGRoute.res k K σ • u) := fun _ => rfl
  have actI_ofI : ∀ y : NK.GlobalCFT.Idele ↥K,
      actI (ofI y) = ofI (SSGRoute.res k K σ • y) := fun _ => rfl
  have actU_toU : ∀ y : Additive ((↥K)ˣ), (SSGRoute.res k K σ • toU y) = toU (actU y) := by
    intro y
    have h := congrArg toU (actU_ofU (toU y))
    simp only [toU_ofU, ofU_toU] at h
    exact h.symm
  have actI_toI : ∀ y : Additive (NK.GlobalCFT.Idele ↥K),
      (SSGRoute.res k K σ • toI y) = toI (actI y) := by
    intro y
    have h := congrArg toI (actI_ofI (toI y))
    simp only [toI_ofI, ofI_toI] at h
    exact h.symm
  -- **Hasse's norm principle** applied to the `(-1)`-part of the basis
  have hhy : ∀ i : Fin a,
      toI (-(g (B (Sum.inl i)))) * (SSGRoute.res k K σ • toI (-(g (B (Sum.inl i))))) =
        NK.GlobalCFT.Idele.principalIdele ↥K (toU (-(d (B (Sum.inl i))))) := by
    intro i
    have hadd : (-(g (B (Sum.inl i)))) + actI (-(g (B (Sum.inl i))))
        = ιZ (-(d (B (Sum.inl i)))) := by
      have h1 : actI (-(g (B (Sum.inl i)))) = -actI (g (B (Sum.inl i))) := map_neg actI _
      have h2 : ιZ (-(d (B (Sum.inl i)))) = -ιZ (d (B (Sum.inl i))) := map_neg ιZ _
      have h3 : ιZ (d (B (Sum.inl i))) = actI (g (B (Sum.inl i))) - g (t (B (Sum.inl i))) := by
        rw [hd (B (Sum.inl i)), hAdef_apply]
      have h4 : g (t (B (Sum.inl i))) = -g (B (Sum.inl i)) := by
        rw [hBneg i, map_neg g (B (Sum.inl i))]
      rw [h1, h2, h3, h4]
      abel
    rw [actI_toI, ← toI_add, ← toI_ι, hadd]
  choose wf hwf using fun i : Fin a =>
    c2_hasse_brick (k := k) (K := ↥K) (SSGRoute.res k K σ) (c2gen_res_sq (K := K) hσ) hnt
      (toI (-(g (B (Sum.inl i))))) (toU (-(d (B (Sum.inl i))))) (hhy i)
  have hwf' : ∀ i : Fin a, ofU (wf i) + actU (ofU (wf i)) = -(d (B (Sum.inl i))) := by
    intro i
    have h1 := congrArg ofU (hwf i)
    simp only [ofU_mul] at h1
    rw [ofU_toU, ← actU_ofU] at h1
    exact h1.symm
  -- the `(-1)`-part of the correction, used to describe `t (B (inr j)) - B (inr j)`
  let φf : Fin a → Additive ((↥K)ˣ) := fun i => ofU (wf i)
  let ψf : M.V →ₗ[ℤ] Additive ((↥K)ˣ) := B.constr ℤ (Sum.elim φf (fun _ : Fin b => 0))
  have hψf_inl : ∀ i : Fin a, ψf (B (Sum.inl i)) = ofU (wf i) := by
    intro i
    rw [show ψf = B.constr ℤ (Sum.elim φf (fun _ : Fin b => 0)) from rfl,
      Module.Basis.constr_basis]
    rfl
  have hψf_eq : ∀ x ∈ Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)),
      ψf x + actU (ψf x) = -(d x) := by
    have hE : ∀ i : Fin a,
        (ψf + actU.comp ψf + d) (B (Sum.inl i)) = 0 := by
      intro i
      rw [LinearMap.add_apply, LinearMap.add_apply, LinearMap.comp_apply, hψf_inl i, hwf' i]
      abel
    intro x hx
    have h0 := c2_eq_zero_on_span_inl (B := B) (ψf + actU.comp ψf + d) hE x hx
    rw [LinearMap.add_apply, LinearMap.add_apply, LinearMap.comp_apply] at h0
    exact eq_neg_of_add_eq_zero_left h0
  -- the translate `t (B (inr j)) - B (inr j)`, which lies in the span of the `(-1)`-part
  let m' : Fin b → M.V := fun j => t (B (Sum.inr j)) - B (Sum.inr j)
  have hm'_ker : ∀ j : Fin b, m' j ∈ LinearMap.ker (t + LinearMap.id) := by
    intro j
    rw [LinearMap.mem_ker]
    show (t + LinearMap.id : M.V →ₗ[ℤ] M.V) (t (B (Sum.inr j)) - B (Sum.inr j)) = 0
    rw [LinearMap.add_apply, LinearMap.id_apply, map_sub, ht]
    abel
  have hm'_span : ∀ j : Fin b,
      m' j ∈ Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)) := by
    intro j
    rw [hBspan]
    exact hm'_ker j
  -- **Hilbert 90** applied to the complementary part of the basis
  have hB_j : ∀ j : Fin b, (d (B (Sum.inr j)) - ψf (m' j)) + actU (d (B (Sum.inr j)) - ψf (m' j))
      = 0 := by
    intro j
    have h1 : d (B (Sum.inr j)) + actU (d (B (Sum.inr j))) = -(d (m' j)) := by
      have h := hd_cocycle (B (Sum.inr j))
      rw [show t (B (Sum.inr j)) = m' j + B (Sum.inr j) from by
        rw [show m' j = t (B (Sum.inr j)) - B (Sum.inr j) from rfl, sub_add_cancel]] at h
      simp only [map_add] at h
      rw [hd_fix (m' j) (hm'_ker j)] at h
      rw [show d (B (Sum.inr j)) + (d (m' j) + actU (d (B (Sum.inr j))))
          = (d (B (Sum.inr j)) + actU (d (B (Sum.inr j)))) + d (m' j) from by abel] at h
      exact eq_neg_of_add_eq_zero_left h
    have h2 : ψf (m' j) + actU (ψf (m' j)) = -(d (m' j)) := hψf_eq (m' j) (hm'_span j)
    have hAB : d (B (Sum.inr j)) + actU (d (B (Sum.inr j)))
        = ψf (m' j) + actU (ψf (m' j)) := h1.trans h2.symm
    have hsplit : actU (d (B (Sum.inr j)) - ψf (m' j))
        = actU (d (B (Sum.inr j))) - actU (ψf (m' j)) := map_sub actU _ _
    rw [hsplit]
    rw [show (d (B (Sum.inr j)) - ψf (m' j)) + (actU (d (B (Sum.inr j))) - actU (ψf (m' j)))
        = (d (B (Sum.inr j)) + actU (d (B (Sum.inr j))))
          - (ψf (m' j) + actU (ψf (m' j))) from by abel]
    rw [hAB, sub_self]
  choose wb hwb using fun j : Fin b =>
    c2_h90_brick (k := k) (K := ↥K) (SSGRoute.res k K σ) (c2gen_res_sq (K := K) hσ) hnt
      (toU (d (B (Sum.inr j)) - ψf (m' j)))
      (by rw [actU_toU, ← toU_add, hB_j j, toU_zero])
  have hwb' : ∀ j : Fin b,
      ofU (wb j) - actU (ofU (wb j)) = d (B (Sum.inr j)) - ψf (m' j) := by
    intro j
    have h1 := congrArg ofU (hwb j)
    simp only [ofU_mul, ofU_inv] at h1
    rw [ofU_toU, ← actU_ofU] at h1
    exact h1.symm
  -- the correction `ψ`
  let ψ : M.V →ₗ[ℤ] Additive ((↥K)ˣ) := B.constr ℤ (Sum.elim φf (fun j => ofU (wb j)))
  have hψ_inl : ∀ i : Fin a, ψ (B (Sum.inl i)) = ofU (wf i) := by
    intro i
    rw [show ψ = B.constr ℤ (Sum.elim φf (fun j => ofU (wb j))) from rfl,
      Module.Basis.constr_basis]
    rfl
  have hψ_inr : ∀ j : Fin b, ψ (B (Sum.inr j)) = ofU (wb j) := by
    intro j
    rw [show ψ = B.constr ℤ (Sum.elim φf (fun j => ofU (wb j))) from rfl,
      Module.Basis.constr_basis]
    rfl
  have hψ_eq_on : ∀ x ∈ Submodule.span ℤ (Set.range fun i : Fin a => B (Sum.inl i)),
      ψ x = ψf x := by
    refine c2_eq_on_span_inl (B := B) ψ ψf (fun i => ?_)
    rw [hψ_inl i, hψf_inl i]
  -- the defining equation of `ψ`
  have hψ_eq : ∀ x : M.V, ψ (t x) - actU (ψ x) = d x := by
    have hmap : ψ.comp t - actU.comp ψ - d = 0 := by
      apply Module.Basis.ext B
      intro k
      rw [LinearMap.sub_apply, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.comp_apply,
        LinearMap.zero_apply]
      rcases k with i | j
      · have h2 : -(ofU (wf i)) - actU (ofU (wf i))
            = -(ofU (wf i) + actU (ofU (wf i))) := by abel
        rw [hBneg i, map_neg, hψ_inl i, h2, hwf' i]
        abel
      · rw [show t (B (Sum.inr j)) = m' j + B (Sum.inr j) from by
          rw [show m' j = t (B (Sum.inr j)) - B (Sum.inr j) from rfl, sub_add_cancel],
          map_add, hψ_eq_on (m' j) (hm'_span j), hψ_inr j]
        rw [show ψf (m' j) + ofU (wb j) - actU (ofU (wb j)) - d (B (Sum.inr j))
            = (ofU (wb j) - actU (ofU (wb j))) - (d (B (Sum.inr j)) - ψf (m' j)) from by abel,
          hwb' j, sub_self]
    intro x
    have hx := LinearMap.congr_fun hmap x
    rw [LinearMap.sub_apply, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.comp_apply,
      LinearMap.zero_apply] at hx
    exact sub_eq_zero.mp hx
  -- the lift `S = g + ι ∘ ψ`
  let S : M.V →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K) := g + ιZ.comp ψ
  have hS_apply : ∀ x : M.V, S x = g x + ιZ (ψ x) := fun _ => rfl
  have hS_class : ∀ x : M.V, πZ (S x) = cZ x := by
    intro x
    rw [hS_apply x, map_add, hgx x]
    have hzero : πZ (ιZ (ψ x)) = 0 := hιπ_zero (ψ x)
    rw [hzero, add_zero]
  have hS_equiv : ∀ x : M.V, S (t x) = actI (S x) := by
    have hstep : ∀ k : Fin a ⊕ Fin b, S (t (B k)) - actI (S (B k)) = 0 := by
      intro k
      have h1 : S (t (B k)) = g (t (B k)) + ιZ (ψ (t (B k))) := hS_apply (t (B k))
      have h2 : actI (S (B k)) = actI (g (B k)) + ιZ (actU (ψ (B k))) := by
        rw [hS_apply, map_add, ← hι_comm]
      have h3 : (g (t (B k)) + ιZ (ψ (t (B k)))) - (actI (g (B k)) + ιZ (actU (ψ (B k))))
          = (g (t (B k)) - actI (g (B k)))
            + (ιZ (ψ (t (B k))) - ιZ (actU (ψ (B k)))) := by abel
      rw [h1, h2, h3, ← map_sub, hψ_eq (B k), hd (B k), hAdef_apply (B k)]
      abel
    have hmap : ∀ x : M.V, S (t x) - actI (S x) = 0 := by
      have hE : S.comp t - actI.comp S = (0 : M.V →ₗ[ℤ] Additive (NK.GlobalCFT.Idele ↥K)) :=
        Module.Basis.ext B (fun k => hstep k)
      intro x
      have hx := LinearMap.congr_fun hE x
      exact hx
    intro x
    exact sub_eq_zero.mp (hmap x)
  -- upgrade the generator-equivariance to `H`-equivariance
  have hequiv : ∀ h : H, ∀ x : M.V, S (actZ M h x) = actZ XI h (S x) := by
    have hgen := comm_zpowers_of_comm (X := M) (Y := XI) S hS_equiv
    intro h x
    obtain ⟨n, hn⟩ := c2gen_eq_zpow (K := K) (σ := σ) h
    rw [hn]
    exact hgen (gen ^ n) (Subgroup.mem_zpowers_iff.mpr ⟨n, rfl⟩) x
  -- package as a morphism of representations
  refine ⟨Rep.ofHom (ρ := M.ρ) (σ := XI.ρ)
    { toLinearMap := coeffLin M XI (S : M.V →ₗ[ℤ] XI.V)
      isIntertwining' := fun h => by
        apply LinearMap.ext
        intro x
        exact hequiv h x }, ?_⟩
  · apply Rep.hom_ext
    ext x
    show πZ (S x) = cZ x
    exact hS_class x

end

end Work.SSGRoute.ExtChain
