/-- **The involution half of the unconditional `extDelta` input of `himg`.** -/
theorem himgExtDeltaInput_inf (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K] [NumberField K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    [hRfin : Module.Finite ℤ ↥(CategoryTheory.Limits.kernel
      (Work.SSGRoute.freeCover (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)))]
    (x : CategoryTheory.Abelian.Ext.{0}
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E) (SSGRoute.PTExt.classesK k K) 1)
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) (hnt : SSGRoute.res k K σ ≠ 1) :
    Work.SSGRoute.PT.H2Fin.resH1 (Subgroup.zpowers σ)
      (Work.SSGRoute.homCoind k Ω K
        (CategoryTheory.Limits.kernel
          (Work.SSGRoute.freeCover (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E))))
      (Work.SSGRoute.ExtChain.e1cMap
        (CategoryTheory.Limits.kernel
          (Work.SSGRoute.freeCover (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)))
        ((Work.SSGRoute.ExtChain.e1aSyzShift (k := k) (K := K)
            (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).symm
          (SSGRoute.PTExt.extDelta (k := k) (K := ↥K) x))) = 0 := by
  rcases eq_or_ne p 2 with _h2 | hp2
  · haveI hTfin : Finite T := Work.SSGRoute.ExtChain.e1aFiniteT p k Ω K ζ T hT
    haveI hNfin : Finite (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E).V :=
      Work.SSGRoute.PT.finite_dualMod_tensor p E T
    have hH := Work.SSGRoute.ExtChain.hbnC2_of_hasseExt1_syzygy (K := K)
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E) σ hσ hnt
      (HimgInfLattice.hasseExt1_syzygy_lattice_clean p k Ω K T E σ hσ hnt)
    have h1 : SSGRoute.PTExt.extRes (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (SSGRoute.PTExt.extDelta (k := k) (K := ↥K) x) = 0 :=
      Work.SSGRoute.ExtChain.extRes_zpowers_eq_zero_of_quadraticHasse (K := K)
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E) σ hσ hnt hH _
        (Work.SSGRoute.ExtChain.extToIdeles_extDelta_eq_zero (k := k) (K := K) x)
    have h2 := Work.SSGRoute.ExtChain.resH2_zpowers_e1aChainH_eq_zero_of_extRes_zpowers_eq_zero
      (k := k) (Ω := Ω) (K := K) (N := Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E) σ hσ hnt
      (SSGRoute.PTExt.extDelta (k := k) (K := ↥K) x) h1
    refine Work.SSGRoute.ExtChain.resH1_zpowers_e1cMap_eq_zero_of_resH2_e1aChainH_eq_zero
      (k := k) (Ω := Ω) (K := K) (N := Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E) σ hσ
      ((Work.SSGRoute.ExtChain.e1aSyzShift (k := k) (K := K)
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).symm
          (SSGRoute.PTExt.extDelta (k := k) (K := ↥K) x)) ?_
    rw [AddEquiv.apply_symm_apply]
    exact h2
  · exact himgExtDeltaInput_inf_odd p hp2 k Ω K ζ hζ hζK T hT E x σ hσ hnt

end Work.SSGRoute.ExtChain
