/-! ## The two arithmetic inputs at the involutive subgroup `H = ⟨σ̄⟩`

The coefficient ring is `Coeff = ULift ℤ`, `H = Subgroup.zpowers (res k K σ)` is the subgroup of
`Gal(K/k)` generated by the involution `σ̄ = res k K σ`, and `F := K^H` is its fixed field, so that
`K/F` is the quadratic extension with `Gal(K/F) = H` (`IntermediateField.subgroupEquivAlgAlg`).

All the arithmetic used below is at the level of the *full* Galois group `Gal(K/F)`, where the
`NK` chapter has it (`subsingleton_groupCohomology_one_unitsRep`, `hbnUnits`,
`subsingleton_groupCohomology_one_ideleClassGroup_all`), read in the `Ext` vocabulary by
`Work.SSGRoute.subsingleton_extH_unitsK_one` and `Work.SSGRoute.subsingleton_extH_classesK_one`, and
transported to `H` along the group isomorphism
`IntermediateField.subgroupEquivAlgEquiv H : H ≃* Gal(K/F)`
(`Work.SSGRoute.nonempty_extH_addEquiv_mulEquiv`).  The transport is cheap because the
representations are *definitionally* the same: `Rep.res` of `unitsRep F K` along that isomorphism
*is* `Rep.res H.subtype (unitsK k K)`, since an element of `H` and its image in `Gal(K/F)` are the
same function on `K`. -/

/-- **`H = ⟨σ̄⟩` has order two.**  `σ̄² = res (σ²) = 1` and `σ̄ ≠ 1`, so `σ̄` has order exactly `2`. -/
theorem card_zpowers_res (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k ↥K]
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) (hnt : SSGRoute.res k K σ ≠ 1) :
    Nat.card (Subgroup.zpowers (SSGRoute.res k K σ)) = 2 := by
  have h2 : SSGRoute.res k K σ ^ 2 = 1 := by rw [← map_pow, hσ, map_one]
  have ho : orderOf (SSGRoute.res k K σ) = 2 := orderOf_eq_prime h2 hnt
  rw [← ho]
  exact Nat.card_zpowers _

/-- **An `𝔽_p`-module is `p`-torsion under the `Coeff = ULift ℤ`-scalar action.** -/
theorem coeff_ptorsion_smul_eq_zero (p : ℕ) [Fact p.Prime] (X : Type) [AddCommGroup X]
    [Module (ZMod p) X] : ∀ x : X, (p : SSGRoute.PTExt.Coeff) • x = 0 := by
  intro x
  have h2 : ((p : ℤ) : ZMod p) = 0 := by rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
  have h3 : (p : SSGRoute.PTExt.Coeff) • x = ((p : ℤ) : ZMod p) • x := by
    rw [Int.cast_smul_eq_zsmul]
    rfl
  rw [h3, h2, zero_smul]

/-- **The canonical `E1a` coefficient `N = DualMod p (E ⊗ T)` is `p`-torsion** under the
`Coeff = ULift ℤ`-scalar action, since its underlying group is an `𝔽_p`-module. -/
theorem ptorsion_e1aN0 (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] :
    ∀ x : (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E).V, (p : SSGRoute.PTExt.Coeff) • x = 0 := by
  change ∀ x : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T),
    (p : SSGRoute.PTExt.Coeff) • x = 0
  exact fun x => coeff_ptorsion_smul_eq_zero p _ x

/-- **Transport of `Subsingleton` of `Ext`-cohomology along an isomorphism of groups.**  For a group
isomorphism `e : H ≃* H'` and a coefficient module `A` of `H'`, the cohomology `Hⁿ(H, res A)` is a
subsingleton as soon as `Hⁿ(H', A)` is (`Work.SSGRoute.nonempty_extH_addEquiv_mulEquiv`). -/
theorem subsingleton_extH_of_mulEquiv {H H' : Type} [Group H] [Group H'] (e : H ≃* H')
    (A : Rep.{0} SSGRoute.PTExt.Coeff H') (n : ℕ)
    (h : Subsingleton (SSGRoute.PTExt.extH A n)) :
    Subsingleton (SSGRoute.PTExt.extH (Rep.res e.toMonoidHom A) n) := by
  obtain ⟨ee⟩ := Work.SSGRoute.nonempty_extH_addEquiv_mulEquiv e A n
  haveI := h
  exact ⟨fun x y => ee.symm.injective (Subsingleton.elim _ _)⟩

/-- **The degree-one Hasse principle at `H = ⟨σ̄⟩` for the units `Kˣ`** (Noether's Hilbert 90 read in
the `Ext` vocabulary): `H¹(H, Kˣ|_H) = 0`.

`K/F` (`F = K^H`) is a finite Galois extension of number fields with Galois group `H`, so
`Work.SSGRoute.subsingleton_extH_unitsK_one` at `K/F` gives `H¹(Gal(K/F), Kˣ) = 0`, and restriction
along the group isomorphism `H ≃* Gal(K/F)` — the identity on the underlying automorphisms — carries
this to `H`. -/
theorem subsingleton_extH_unitsK_zpowers (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K] (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1)
    (hnt : SSGRoute.res k K σ ≠ 1) :
    Subsingleton (SSGRoute.PTExt.extH
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (SSGRoute.PTExt.unitsK k ↥K)) 1) := by
  let H := Subgroup.zpowers (SSGRoute.res k K σ)
  let FF := ↥(IntermediateField.fixedField H)
  haveI : NumberField FF := NumberField.of_intermediateField (K := k) (L := ↥K) _
  haveI : IsGalois FF ↥K := IsGalois.tower_top_of_isGalois k FF ↥K
  have h1 : Subsingleton (SSGRoute.PTExt.extH (SSGRoute.PTExt.unitsK FF ↥K) 1) :=
    Work.SSGRoute.subsingleton_extH_unitsK_one FF ↥K
  exact subsingleton_extH_of_mulEquiv (IntermediateField.subgroupEquivAlgEquiv H)
    (SSGRoute.PTExt.unitsK FF ↥K) 1 h1

/-- **The degree-one Hasse principle at `H = ⟨σ̄⟩` for the idèle class group**, in the `Ext`
vocabulary: `H¹(H, C_K|_H) = 0`.  Same transport as `subsingleton_extH_unitsK_zpowers`, from
`Work.SSGRoute.subsingleton_extH_classesK_one` at `K/F`. -/
theorem subsingleton_extH_classesK_zpowers (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K] (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1)
    (hnt : SSGRoute.res k K σ ≠ 1) :
    Subsingleton (SSGRoute.PTExt.extH
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (SSGRoute.PTExt.classesK k ↥K)) 1) := by
  let H := Subgroup.zpowers (SSGRoute.res k K σ)
  let FF := ↥(IntermediateField.fixedField H)
  haveI : NumberField FF := NumberField.of_intermediateField (K := k) (L := ↥K) _
  haveI : IsGalois FF ↥K := IsGalois.tower_top_of_isGalois k FF ↥K
  have h1 : Subsingleton (SSGRoute.PTExt.extH (SSGRoute.PTExt.classesK FF ↥K) 1) :=
    Work.SSGRoute.subsingleton_extH_classesK_one FF ↥K
  exact subsingleton_extH_of_mulEquiv (IntermediateField.subgroupEquivAlgEquiv H)
    (SSGRoute.PTExt.classesK FF ↥K) 1 h1

/-- **The Hasse–Brauer–Noether statement at `H = ⟨σ̄⟩`, in degree two for the units** — the `hφ`
input of the trivial-coefficient case: the coefficient change `Kˣ|_H → 𝕀_K|_H` (the diagonal
embedding of the principal idèles) is injective on `Ext²_H(ℤ, ·)`.

This is the exact sequence of the class formation.  For the restricted short exact sequence
`0 → Kˣ → 𝕀_K → C_K → 0` of `H`-modules, the covariant long exact sequence of `Ext` in the
coefficient variable reads

  `Ext¹_H(ℤ, C_K) --δ--> Ext²_H(ℤ, Kˣ) --> Ext²_H(ℤ, 𝕀_K)`,

and exactness at the middle identifies the kernel of the second map with the image of the connecting
map `δ`, whose source is trivial by Hilbert 90 at the level of the class group
(`subsingleton_extH_classesK_zpowers`). -/
theorem injective_extH_ideles_zpowers (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K] (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1)
    (hnt : SSGRoute.res k K σ ≠ 1) :
    Function.Injective (fun z : CategoryTheory.Abelian.Ext.{0}
      (SSGRoute.PTExt.unitRep ↥(Subgroup.zpowers (SSGRoute.res k K σ)))
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (SSGRoute.PTExt.unitsK k ↥K)) 2 =>
      z.comp (CategoryTheory.Abelian.Ext.mk₀
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2)) := by
  let H := Subgroup.zpowers (SSGRoute.res k K σ)
  have hcl : Subsingleton (SSGRoute.PTExt.extH
      (Rep.res H.subtype (SSGRoute.PTExt.classesK k ↥K)) 1) :=
    subsingleton_extH_classesK_zpowers k Ω K σ hσ hnt
  have hS : ((NK.HassePrinciple.ideleShortComplex k ↥K).map
      (Rep.resFunctor H.subtype)).ShortExact :=
    (NK.HassePrinciple.ideleShortComplex_shortExact k ↥K).map_of_exact (Rep.resFunctor H.subtype)
  have hker : ∀ z : CategoryTheory.Abelian.Ext.{0} (SSGRoute.PTExt.unitRep ↥H)
      (Rep.res H.subtype (SSGRoute.PTExt.unitsK k ↥K)) 2,
      z.comp (CategoryTheory.Abelian.Ext.mk₀ (Rep.resMap H.subtype
        (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2) = 0 → z = 0 := by
    intro z hz
    obtain ⟨c, hc⟩ := CategoryTheory.Abelian.Ext.covariant_sequence_exact₁
      (X := SSGRoute.PTExt.unitRep ↥H) hS z hz (show 1 + 1 = 2 by norm_num)
    have hc0 : c = 0 := hcl.elim c 0
    rw [hc0, CategoryTheory.Abelian.Ext.zero_comp] at hc
    exact hc.symm
  intro z w hzw
  dsimp only at hzw
  have hsub : (z - w).comp (CategoryTheory.Abelian.Ext.mk₀ (Rep.resMap H.subtype
      (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2) = 0 := by
    rw [sub_eq_add_neg, CategoryTheory.Abelian.Ext.add_comp,
      CategoryTheory.Abelian.Ext.neg_comp, hzw, add_neg_cancel]
  have h0 : z - w = 0 := hker (z - w) hsub
  exact sub_eq_zero.mp h0

/-- **The formal half of the target.**  The degree-one Hasse principle for the canonical syzygy
`N₁ = ker (freeCover N)` follows from its degree-two form for `N` itself.

The restricted canonical presentation `0 → N₁|_H → F|_H → N|_H → 0` has a projective middle term
(`F` is free over `ℤ[G]`, hence over `ℤ[H]`), so the syzygy shift `PT.e1aShiftEquiv` is an
isomorphism `Ext¹_H(N₁,·) ≅ Ext²_H(N,·)`; by its coefficient naturality
(`ExtChain.e1aShiftEquiv_natural_coeff`) the class `z` with `z ≫ mk₀ ideleIncl = 0` is carried to
the class `e z` with `(e z) ≫ mk₀ ideleIncl = 0`, which vanishes by hypothesis; injectivity of `e`
then gives `z = 0`. -/
theorem hasseExt1_syzygy_lattice_of_ext2 (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K] [NumberField K]
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T] [Finite T]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) (hnt : SSGRoute.res k K σ ≠ 1)
    (hExt2 : ∀ z : CategoryTheory.Abelian.Ext.{0}
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E))
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K)) 2,
      z.comp (CategoryTheory.Abelian.Ext.mk₀
          (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
            (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2) = 0 → z = 0) :
    ∀ z : CategoryTheory.Abelian.Ext.{0}
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (CategoryTheory.Limits.kernel (Work.SSGRoute.freeCover
            (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E))))
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K)) 1,
      z.comp (CategoryTheory.Abelian.Ext.mk₀
          (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
            (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 1) = 0 → z = 0 := by
  classical
  intro z hz
  let F : CategoryTheory.Functor (Rep.{0} SSGRoute.PTExt.Coeff (K ≃ₐ[k] K))
      (Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :=
    Rep.resFunctor (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
  have hS : ((Work.SSGRoute.freeCoverSES
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F).ShortExact :=
    (Work.SSGRoute.freeCoverSES_shortExact
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map_of_exact F
  haveI : CategoryTheory.Projective
      ((Work.SSGRoute.freeCoverSES
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F).X₂ :=
    Work.SSGRoute.res_free_rep_projective (Subgroup.zpowers (SSGRoute.res k K σ))
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E).V
  have hkey := Work.SSGRoute.ExtChain.e1aShiftEquiv_natural_coeff hS
    (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K))
    (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.idelesK k ↥K))
    (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
      (NK.HassePrinciple.ideleIncl k ↥K)) 1 (le_refl 1) z
  have hy : (Work.SSGRoute.PT.e1aShiftEquiv
        ((Work.SSGRoute.freeCoverSES
          (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.idelesK k ↥K))
        1 (le_refl 1))
      (z.comp (CategoryTheory.Abelian.Ext.mk₀
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 1)) = 0 := by
    rw [hz]
    exact (Work.SSGRoute.PT.e1aShiftEquiv
      ((Work.SSGRoute.freeCoverSES
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.idelesK k ↥K))
      1 (le_refl 1)).map_zero
  have hw0 : (Work.SSGRoute.PT.e1aShiftEquiv
        ((Work.SSGRoute.freeCoverSES
          (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K))
        1 (le_refl 1) z).comp
      (CategoryTheory.Abelian.Ext.mk₀
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2) = 0 := hkey.trans hy
  have hw : Work.SSGRoute.PT.e1aShiftEquiv
      ((Work.SSGRoute.freeCoverSES
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K))
      1 (le_refl 1) z = 0 := hExt2 _ hw0
  exact (Work.SSGRoute.PT.e1aShiftEquiv
      ((Work.SSGRoute.freeCoverSES
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K))
      1 (le_refl 1)).injective (hw.trans (Work.SSGRoute.PT.e1aShiftEquiv
      ((Work.SSGRoute.freeCoverSES
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).map F) hS
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K))
      1 (le_refl 1)).map_zero.symm)


/-- **The degree-one Hasse principle at the involutive subgroup for the canonical syzygy lattice of
the `E1a` coefficient.**  This is the concrete instance of `hasseExt1_C2_lattice_general` that the
involution half of `himg` consumes.

`H = ⟨σ̄⟩ ≤ G = Gal(K/k)` is generated by `σ̄ = res k K σ` and has order `2` (`hnt`, `hσ`); `N` is the
canonical `E1a` coefficient `e1aN0 p k Ω K T E = DualMod p (E ⊗ T)` and `N₁ = ker (freeCover N)` is
its canonical syzygy (a `ℤ`-lattice, cf. `Work.SSGRoute.freeCoverSES_finite`).  The claim: a class in
`Ext¹_H(N₁, Kˣ)` (coefficients restricted along `H ↪ G` by `Rep.res`) whose image under the diagonal
embedding of the principal idèles `Kˣ → 𝕀_K` vanishes, is itself zero.

This is the degree-one form of the residual arithmetic input of the involution half; the passage
`Ext²_H(N,·) ≅ Ext¹_H(N₁,·)` (the syzygy shift `Work.SSGRoute.PT.e1aShiftEquiv` together with its
coefficient naturality `ExtChain.e1aShiftEquiv_natural_coeff`) is formal and is done in the lane, so
this statement alone closes the involution half.  For `M = N₁` the obstruction to the "decompose into
the two classical shapes (Hilbert 90 / Hasse norm)" argument is concentrated in the `2`-torsion of
`N₁/(N₁₊ ⊕ N₁₋)`; a proof restricted to this one concrete lattice is what is asked for.  (Do not
re-prove the statement from `Submission/Work/SSGRoute/ExtChain/hasseExt1_C2_lattice.lean`: that file
is an orphan carrying the general statement with a `sorry`; a `sorry`-free proof is what is wanted.) -/
theorem hasseExt1_syzygy_lattice_clean (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K] [NumberField K]
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T] [Finite T]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) (hnt : SSGRoute.res k K σ ≠ 1) :
    ∀ z : CategoryTheory.Abelian.Ext.{0}
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (CategoryTheory.Limits.kernel (Work.SSGRoute.freeCover
            (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E))))
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K)) 1,
      z.comp (CategoryTheory.Abelian.Ext.mk₀
          (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
            (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 1) = 0 → z = 0 := by
  classical
  have hHcard : Nat.card (Subgroup.zpowers (SSGRoute.res k K σ)) = 2 :=
    card_zpowers_res k Ω K σ hσ hnt
  have hA1 : Subsingleton (SSGRoute.PTExt.extH
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (SSGRoute.PTExt.unitsK k ↥K)) 1) :=
    subsingleton_extH_unitsK_zpowers k Ω K σ hσ hnt
  have hC := injective_extH_ideles_zpowers k Ω K σ hσ hnt
  intro z hz
  refine hasseExt1_syzygy_lattice_of_ext2 p k Ω K T E σ hσ hnt ?_ z hz
  -- the degree-two form for the canonical coefficient `N = e1aN0 p k Ω K T E`
  intro w hw
  haveI hfinN : Finite (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
      (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).V := by
    have := Work.SSGRoute.PT.finite_dualMod_tensor p E T
    exact this
  rcases eq_or_ne p 2 with hp | hpne
  · -- `p = 2`: the `𝔽₂[H]`-structure theory, and the trivial `𝔽₂`-coefficient Hasse principle
    subst hp
    have hN : ∀ x : (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (Work.SSGRoute.SSGStage.e1aN0 2 k Ω K T E)).V, (2 : SSGRoute.PTExt.Coeff) • x = 0 :=
      fun x => ptorsion_e1aN0 2 k Ω K T E x
    have htriv : Function.Injective (fun z : CategoryTheory.Abelian.Ext.{0}
        (Rep.trivial SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ)) (ZMod 2))
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (SSGRoute.PTExt.unitsK k ↥K)) 2 =>
        z.comp (CategoryTheory.Abelian.Ext.mk₀ (Rep.resMap
          (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 2)) :=
      Work.ExtChain.ext2_trivial_fn_two_no_hB1 (p := 2) hHcard _ _
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K)) hA1 hC
    have hInj := Work.SSGRoute.ExtChain.ext2_fn_two_of_trivial_proved hHcard
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (Work.SSGRoute.SSGStage.e1aN0 2 k Ω K T E)) hN _ _
      (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (NK.HassePrinciple.ideleIncl k ↥K)) htriv
    refine hInj (a₁ := w) (a₂ := 0) ?_
    simp only [hw, CategoryTheory.Abelian.Ext.zero_comp]
  · -- `p ≠ 2`: `𝔽_p[H]` is semisimple, so `Ext²` vanishes outright
    have hN : ∀ x : (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
        (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E)).V, (p : SSGRoute.PTExt.Coeff) • x = 0 :=
      fun x => ptorsion_e1aN0 p k Ω K T E x
    haveI : Subsingleton (CategoryTheory.Abelian.Ext.{0}
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (Work.SSGRoute.SSGStage.e1aN0 p k Ω K T E))
        (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (SSGRoute.PTExt.unitsK k ↥K)) 2) :=
      Work.SSGRoute.ExtChain.ext2_fn_p_odd_proved hpne hHcard _ hN _
    exact Subsingleton.elim w 0

end Work.SSGRoute.ExtChain.HimgInfLattice

