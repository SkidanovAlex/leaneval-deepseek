/-!
# A group of order two is generated by an involution
-/

namespace Work.SSGRoute.ExtChain

/-- A group of order two consists of `1` and a single involution `σ`. -/
theorem cardTwoGenerator {H : Type} [Group H] (hH : Nat.card H = 2) :
    ∃ σ : H, σ ≠ 1 ∧ σ * σ = 1 ∧ ∀ g : H, g = 1 ∨ g = σ := by
  classical
  haveI hfin : Finite H := (Nat.card_pos_iff.mp (by omega)).2
  haveI : Fintype H := Fintype.ofFinite H
  have hcard : Fintype.card H = 2 := by rw [← Nat.card_eq_fintype_card]; exact hH
  obtain ⟨σ, hσne⟩ := Fintype.exists_ne_of_one_lt_card (α := H) (by omega) (1 : H)
  have hgen : ∀ g : H, g = 1 ∨ g = σ := by
    intro g
    have hc : ({1, σ} : Finset H).card = Fintype.card H := by
      rw [Finset.card_insert_of_notMem (by simpa using hσne.symm), Finset.card_singleton, hcard]
    have hmem : g ∈ ({1, σ} : Finset H) := by
      rw [Finset.eq_univ_of_card _ hc]
      exact Finset.mem_univ g
    simpa using hmem
  have hσ : σ * σ = 1 := by
    rcases hgen (σ * σ) with h | h
    · exact h
    · exfalso
      have h' : σ = 1 := by
        have hc := congrArg (fun x : H => σ⁻¹ * x) h
        simpa [mul_assoc] using hc
      exact hσne h'
  exact ⟨σ, hσne, hσ, hgen⟩

end Work.SSGRoute.ExtChain
