/-!
# The residue field of `𝒪_L` is generated by the residue of the Teichmüller lift

Let `L = Q.adicCompletion K`, `B = 𝒪_L`, and let `ζ ∈ B` be a primitive `N`-th root of unity where
`N = #κ_B - 1` is one less than the cardinality of the residue field.  Then the residue
`ζ̄ = residue ζ` generates the multiplicative group `κ_B^×`: every nonzero `y` of `κ_B` is a power
of `ζ̄`.

Since `#κ_B` vanishes in `B` (it is the cardinality of a finite field, which is `0` in its own
residue field), `N = #κ_B - 1 ≡ -1` modulo the maximal ideal, so `N` is a **unit** of `B`; then
`eq_one_of_pow_eq_one_of_sub_mem_maximalIdeal` shows that reduction is injective on `N`-th roots
of unity, so `ζ̄` has order `N = #κ_B^×` and hence generates `κ_B^×`.
-/

open scoped NumberField
open IsDedekindDomain

namespace Work.SSGRoute.Finiteness

open Work.SSGRoute.TatePoitouRoute.FinitenessHM

noncomputable section

variable {K : Type*} [Field K] [NumberField K]
variable (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
variable (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
variable (ζ : Q.adicCompletionIntegers K)

/-- **The residue field of `𝒪_L` is generated by `residue ζ`.** -/
theorem residueField_pow_generated_by_residue
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K)
      (Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1)) :
    ∀ y : IsLocalRing.ResidueField (Q.adicCompletionIntegers K), y ≠ 0 →
      ∃ j : ℕ, y = (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) ^ j := by
  classical
  haveI hfinres : Finite (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) :=
    Commons.NumberTheory.NumberField.Completion.finite_residueField_adicCompletion K Q
  haveI : Fintype (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) := Fintype.ofFinite _
  set N := Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1 with hN
  -- ## `N` is a unit of `B`
  have hcard2 : 2 ≤ Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) := by
    rw [Nat.card_eq_fintype_card]; exact Fintype.one_lt_card
  have hNpos : 0 < N := by rw [hN]; omega
  have hcastcard : ((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) : ℕ) :
      Q.adicCompletionIntegers K) ∈ IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_natCast, Nat.card_eq_fintype_card]
    exact FiniteField.cast_card_eq_zero (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))
  have hNm : (((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) : ℕ) :
      Q.adicCompletionIntegers K) - 1) ∉ IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) := by
    intro h
    have h1 : (1 : Q.adicCompletionIntegers K) ∈
        IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) := by
      have h2 : ((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) : ℕ) :
          Q.adicCompletionIntegers K) -
          (((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) : ℕ) :
            Q.adicCompletionIntegers K) - 1) ∈
          IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) :=
        (IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K)).sub_mem hcastcard h
      rwa [sub_sub_cancel] at h2
    exact (IsLocalRing.maximalIdeal.isMaximal (Q.adicCompletionIntegers K)).ne_top
      (Ideal.eq_top_iff_one _ |>.mpr h1)
  have hNunit : IsUnit ((N : ℕ) : Q.adicCompletionIntegers K) := by
    have hle : 1 ≤ Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) := by omega
    have hcast : ((N : ℕ) : Q.adicCompletionIntegers K) =
        ((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) : ℕ) :
          Q.adicCompletionIntegers K) - 1 := by
      rw [hN, Nat.cast_sub hle, Nat.cast_one]
    rw [hcast]
    exact IsLocalRing.notMem_maximalIdeal.mp hNm
  -- ## reduction is injective on `N`-th roots of unity, so `residue ζ` has order `N`
  have hpowB : (ζ : Q.adicCompletionIntegers K) ^ N = 1 := by
    refine Subtype.ext ?_
    show (algebraMap (Q.adicCompletionIntegers K) (Q.adicCompletion K)
      ((ζ : Q.adicCompletionIntegers K) ^ N)) = 1
    rw [map_pow]
    simpa using hζ.pow_eq_one
  have hresN : (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) ^ N = 1 := by
    rw [← map_pow, hpowB, map_one]
  have hresne : ∀ j : ℕ, 0 < j → j < N →
      (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) ^ j ≠ 1 := by
    intro j hj hjN hcon
    have hmem : (ζ : Q.adicCompletionIntegers K) ^ j - 1 ∈
        IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) := by
      rw [← IsLocalRing.residue_eq_zero_iff]
      rw [map_sub, map_one, map_pow, hcon, sub_self]
    have hpow : ((ζ : Q.adicCompletionIntegers K) ^ j) ^ N = 1 := by
      rw [← pow_mul, mul_comm, pow_mul, hpowB, one_pow]
    have hone : (ζ : Q.adicCompletionIntegers K) ^ j = 1 :=
      eq_one_of_pow_eq_one_of_sub_mem_maximalIdeal hNunit hpow hmem
    have hdvd : N ∣ j := by
      refine (hζ.pow_eq_one_iff_dvd j).mp ?_
      have h := congrArg (fun x : Q.adicCompletionIntegers K => (x : Q.adicCompletion K)) hone
      simpa using h
    exact absurd (Nat.le_of_dvd hj hdvd) (by omega)
  have hord : orderOf (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) = N := by
    refine (orderOf_eq_iff hNpos).mpr ⟨hresN, ?_⟩
    intro m hmN hm
    exact hresne m hm hmN
  -- ## therefore `residue ζ` generates `κ_B^×`
  have hζunit : IsUnit ζ := by
    refine ⟨⟨ζ, ζ ^ (N - 1), ?_, ?_⟩, rfl⟩
    · rw [← pow_succ', Nat.sub_add_cancel hNpos, hpowB]
    · rw [← pow_succ, Nat.sub_add_cancel hNpos, hpowB]
  have hres0 : IsLocalRing.residue (Q.adicCompletionIntegers K) ζ ≠ 0 := by
    intro h
    exact (IsLocalRing.notMem_maximalIdeal (x := ζ)).mpr hζunit
      ((IsLocalRing.residue_eq_zero_iff ζ).mp h)
  set u : (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))ˣ :=
    Units.mk0 (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) hres0 with hu
  have hucoe : (u : IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) =
      IsLocalRing.residue (Q.adicCompletionIntegers K) ζ := by
    rw [hu]; exact Units.val_mk0 hres0
  have horderu : orderOf u = N := by
    rw [← orderOf_units, hucoe]
    exact hord
  have hcardu : Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))ˣ = N := by
    rw [Nat.card_units, hN]
  rw [show IsLocalRing.residue (Q.adicCompletionIntegers K) ζ =
      (u : IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) from hucoe.symm]
  intro y hy
  have htop : Subgroup.zpowers u = ⊤ :=
    Subgroup.eq_top_of_card_eq (Subgroup.zpowers u) (by rw [Nat.card_zpowers, horderu, hcardu])
  have hyu : (Units.mk0 y hy : (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))ˣ) ∈
      Subgroup.zpowers u := by
    rw [htop]; exact Subgroup.mem_top _
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hyu
  refine ⟨(m % (N : ℤ)).toNat, ?_⟩
  have hmN : u ^ (m % (N : ℤ)) = u ^ m :=
    (zpow_eq_zpow_emod' (x := u) m (by rw [← horderu]; exact pow_orderOf_eq_one u)).symm
  have hcast : ((m % (N : ℤ)).toNat : ℤ) = m % (N : ℤ) :=
    Int.toNat_of_nonneg (Int.emod_nonneg m (by positivity))
  have hfin : u ^ ((m % (N : ℤ)).toNat) = u ^ (m % (N : ℤ)) := by
    rw [← zpow_natCast, hcast]
  have h1 : u ^ ((m % (N : ℤ)).toNat) =
      (Units.mk0 y hy : (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))ˣ) := by
    rw [hfin, hmN]; exact hm
  rw [← Units.val_pow_eq_pow_val, h1]
  exact (Units.val_mk0 hy).symm

end

end Work.SSGRoute.Finiteness
