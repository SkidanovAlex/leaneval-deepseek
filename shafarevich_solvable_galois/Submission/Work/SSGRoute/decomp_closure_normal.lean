namespace Work.SSGRoute

open scoped Pointwise

/-!
# Normality of the subgroup generated by the decomposition groups of the completely split places

Let `k` be a number field, `Ω` an algebraic closure of `k` and `N/k` a finite Galois extension.
Write `S` for the set of all `τ ∈ G_k = Ω ≃ₐ[k] Ω` lying in the decomposition group `D_A` of some
finite place `A` of `Ω` which is split completely in `N` (i.e. `D_A ≤ G_N = N.fixingSubgroup`).

The group `G_k` acts on the places of `Ω` by `(g, A) ↦ g • A`, and

* the trace of a place on `k` is invariant: `(g • A).comap (algebraMap k Ω) = A.comap (algebraMap k Ω)`,
  so `g • A` is again a finite place (`comap_smul_algebraMap_gk`);
* decomposition groups of conjugate places are conjugate:
  `D_{g • A} = g D_A g⁻¹` (`decomp_smul_gk`);
* `G_N = N.fixingSubgroup` is normal in `G_k`, because `N/k` is Galois
  (`IsGalois.fixingSubgroup_normal_of_isGalois`).

Consequently `g • A` is again split completely in `N` whenever `A` is, and `S` is stable under
conjugation.  Hence the subgroup it generates is normal in `G_k` — the statement below, which is
the reason `Σ = ⟨D_A : A split completely in N⟩` is a legitimate closed (normal) subgroup of `G_k`
whose fixed field is the maximal abelian subextension of `N/k` used in the proof of
Shafarevich's theorem.
-/

section Conjugation

variable {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]

/-- The trace of a place of `Ω` on the base field `k` is invariant under `G_k`: translating a
place by `g ∈ G_k` does not change the prime of `k` it lies over. -/
private lemma comap_smul_algebraMap_gk (A : ValuationSubring Ω) (g : Ω ≃ₐ[k] Ω) :
    (g • A).comap (algebraMap k Ω) = A.comap (algebraMap k Ω) := by
  ext x
  rw [ValuationSubring.mem_comap, ValuationSubring.mem_comap,
    ValuationSubring.mem_pointwise_smul_iff_inv_smul_mem]
  have hfix : (g⁻¹ : Ω ≃ₐ[k] Ω) • (algebraMap k Ω x) = algebraMap k Ω x := by
    rw [AlgEquiv.smul_def]
    exact (g⁻¹).commutes x
  rw [hfix]

/-- Translating a place by `g ∈ G_k` conjugates its decomposition group: `D_{g·A} = g D_A g⁻¹`. -/
private lemma decomp_smul_gk (A : ValuationSubring Ω) (g : Ω ≃ₐ[k] Ω) :
    SSGRoute.decomp k (g • A) = (SSGRoute.decomp k A).map (MulAut.conj g).toMonoidHom :=
  MulAction.stabilizer_smul_eq_stabilizer_map_conj g A

end Conjugation

/-- The subgroup generated by a conjugation-invariant set of elements is normal. -/
private lemma closure_normal_of_conj_invariant {G : Type*} [Group G] (S : Set G)
    (hS : ∀ g : G, ∀ x ∈ S, g * x * g⁻¹ ∈ S) : (Subgroup.closure S).Normal := by
  rw [Subgroup.normal_iff_map_conj_eq]
  intro g
  have h : Subgroup.map (MulAut.conj g) (Subgroup.closure S) = Subgroup.closure S := by
    rw [MonoidHom.map_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hS g y hy
    · intro hx
      refine ⟨g⁻¹ * x * g, ?_, ?_⟩
      · simpa using hS g⁻¹ x hx
      · change (MulAut.conj g) (g⁻¹ * x * g) = x
        rw [MulAut.conj_apply]; group
  exact h

/-- **The subgroup generated by the decomposition groups of the primes split completely in `N` is normal in `G_k`.**

Let `k` be a number field, `Ω` an algebraic closure of `k` and `N/k` a finite Galois extension.  A place
`A` of `Ω` is *split completely in `N`* when `D_A = decomp k A ≤ N.fixingSubgroup`; when `A` is such a
place and `g ∈ G_k`, the conjugate `g • A` is again split completely in `N` and
`D_{g·A} = g D_A g⁻¹`.  Hence the set `Σ` of decomposition groups of the completely split places is
stable under conjugation, and the subgroup it generates is normal in `G_k`. -/
theorem decomp_closure_normal (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (N : IntermediateField k Ω) [FiniteDimensional k N] [IsGalois k N] :
    (Subgroup.closure {τ : Ω ≃ₐ[k] Ω | ∃ A : ValuationSubring Ω,
      SSGRoute.IsFinPlace k A ∧ SSGRoute.IsSplitIn k N A ∧
      τ ∈ SSGRoute.decomp k A}).Normal := by
  -- `G_N = N.fixingSubgroup` is normal in `G_k`, since `N/k` is Galois
  -- (`IsGalois k Ω` is available from `IsAlgClosure k Ω`).
  have hN : (N.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)).Normal :=
    IsGalois.fixingSubgroup_normal_of_isGalois N
  -- The generating set is stable under conjugation.
  refine closure_normal_of_conj_invariant _ fun g τ hτ => ?_
  obtain ⟨A, hfin, hsplit, hmem⟩ := hτ
  have hsplit' : SSGRoute.decomp k A ≤ N.fixingSubgroup := hsplit
  have hfin' : A.comap (algebraMap k Ω) ≠ ⊤ := hfin
  refine ⟨g • A, ?_, ?_, ?_⟩
  · -- `g • A` is again a finite place.
    simp only [SSGRoute.IsFinPlace]
    rw [comap_smul_algebraMap_gk]
    exact hfin'
  · -- `g • A` is again split completely in `N`.
    simp only [SSGRoute.IsSplitIn]
    rw [decomp_smul_gk, Subgroup.map_le_iff_le_comap]
    intro x hx
    simpa using hN.conj_mem x (hsplit' hx) g
  · -- `conj g τ` again lies in the decomposition group of the conjugate place.
    rw [decomp_smul_gk]
    exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hmem

end Work.SSGRoute
