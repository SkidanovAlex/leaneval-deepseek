/-!
# Cyclicity of the transfer at a place whose inertia is killed

This file proves `Work.SSGRoute.cyclic_transfer_of_vanishing`, the group-theoretic half of the last
conjunct of `Work.SSGRoute.shafarevich_z_construction` in the case where the constructed cochain `z`
is *unramified* at every conjugate of the place `B` under consideration.

Let `B` be a finite place of `Ω` over a finite prime of `k`, split in `K`, let `z` be a cochain
additive on `G_K = K.fixingSubgroup`, and let `V ≤ G_k` be an open subgroup containing the inertia
`I_B` on which the transfer `X = transfer z sec` vanishes.  Since `G_k` is profinite and the
decomposition group of a finite place modulo its inertia is pro-cyclic, the quotient
`decomp k B / (decomp k B ⊓ V)` is cyclic, generated by one element `g`
(`Work.SSGRoute.decomp_mod_inertia_cyclic`); additivity of `X` on `decomp k B` (which holds because
`B` is split in `K`, so `decomp k B ≤ G_K` and the action of `G_K` on `E` is trivial) then shows
that `X (decomp k B)` is contained in the cyclic subgroup generated by `X g`.

This is the precise form in which the Schmidt--Wingberg argument verifies the cyclicity clause at a
place outside `cs(S)` where the auxiliary class `z` is unramified at all conjugates: the open
subgroup `V` is then the intersection of the conjugates of the kernel of `z` (see
`Work.SSGRoute.shafarevich_z_construction_of_zData`).
-/

open scoped Pointwise

namespace Work.SSGRoute

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k]
  [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
  {E : Type} [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

/-- If the inertia of `B` lies in an open subgroup `V` on which the transfer of `z` vanishes, then
the image of the transfer on `decomp k B` is cyclic (generated by the value at one element). -/
theorem cyclic_transfer_of_vanishing
    (z : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B) (hsplitK : SSGRoute.IsSplitIn k K B)
    (V : Subgroup (Ω ≃ₐ[k] Ω)) (hVopen : IsOpen (V : Set (Ω ≃ₐ[k] Ω)))
    (hVan : ∀ h ∈ SSGRoute.decomp k B ⊓ V, transfer z sec h = 0)
    (hI : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → σ ∈ V) :
    ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g) := by
  have hhom : ∀ a ∈ SSGRoute.decomp k B, ∀ b ∈ SSGRoute.decomp k B,
      transfer z sec (a * b) = transfer z sec a + transfer z sec b :=
    fun a ha b hb => transfer_mul_mem hsec hzadd (hsplitK ha) (hsplitK hb)
  obtain ⟨g, hg, hgen⟩ := decomp_mod_inertia_cyclic k Ω B hB (V ⊓ SSGRoute.decomp k B)
    ⟨V, hVopen, rfl⟩ (fun σ hσ => Subgroup.mem_inf.mpr ⟨hI σ hσ, hσ.1⟩)
  refine ⟨g, hg, fun δ hδ => ?_⟩
  obtain ⟨m, hm⟩ := hgen δ hδ
  have hmem : δ⁻¹ * g ^ m ∈ SSGRoute.decomp k B ⊓ V :=
    Subgroup.mem_inf.mpr ⟨hm.2, hm.1⟩
  have hzero : transfer z sec (δ⁻¹ * g ^ m) = 0 := hVan _ hmem
  rw [X_mul hhom _ _ ((SSGRoute.decomp k B).inv_mem hδ) (Subgroup.zpow_mem _ hg m),
      X_inv hhom δ hδ, X_zpow hhom g hg m] at hzero
  refine AddSubgroup.mem_zmultiples_iff.mpr ⟨m, ?_⟩
  have h2 : -transfer z sec δ + m • transfer z sec g
      = -transfer z sec δ + transfer z sec δ := by
    rw [hzero, neg_add_cancel]
  exact add_left_cancel h2

end Work.SSGRoute
