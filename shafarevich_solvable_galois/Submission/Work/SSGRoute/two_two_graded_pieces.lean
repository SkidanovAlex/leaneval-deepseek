/-!
# The graded piece `E(n,(2,2))` of the `p = 2` correction: the honest side

This file collects the *honest* (model-free) group-theoretic facts about the second genuinely
quadratic graded piece of Schmidt–Wingberg's refined filtration, i.e. about

  `E(n,(2,2)) = F(n)^{(2,2)}/F(n)^{(3,1)}`  inside  `Q_{(3,1)} = F(n)/F(n)^{(3,1)}`,

for the free `G`-operator group `F(n)`.  These are exactly the facts a "`ℤ/4`-model" of `Q_{(3,1)}`
must satisfy in order for the model to receive a `G`-equivariant *surjection* from the presentation

  `⟨x_i (i ∈ Fin n × G), γ_ij central ∣ x_i^4 = 1, γ_ij^2 = 1, [x_i,x_j] = γ_ij, [x_i^2,x_j] = 1⟩`,

which is the input of the explicit quadratic computation proving the graded step at `σ = (2,2)`
(the `p = 2` correction of Shafarevich's theorem; Schmidt–Wingberg, §5, Step 1a, clause (B)).

The mathematical content is:

* `refinedTerm_two_two` — `P_{(2,2)} = γ₂(P)·P_3` for **every** group `P`: the second index of the
  refinement does nothing at `(2,2)`;
* `flowTerm_two_two` — the same for the free `G`-operator group;
* `ker_flowQuotSucc_two_two_le` — the kernel of the level projection `Q_{(3,1)} → Q_{(2,2)}` is
  generated by the images of the commutators;
* the four relations above hold in `Q_{(3,1)}` (`pow_four_mem`, `commutator_pow_two_mem`,
  `commutator_sq_mem`, `commutator_centralSeries_mem`).
-/

namespace Work.SSGRoute

set_option maxHeartbeats 1000000

open Work.CohomologicalShrinking
open scoped commutatorElement

namespace TwoTwo

/-! ## `P_{(2,2)} = γ₂ · P_3` -/

/-- The second term of the descending central series is the commutator subgroup. -/
theorem centralSeries_two (P : Type*) [Group P] :
    centralSeries P 2 = ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ := by
  rw [show (2 : ℕ) = 1 + 1 from rfl, centralSeries_succ_succ, centralSeries_one]

/-- The second term of the `p`-central series is `P^p · [P,P]`. -/
theorem pSeries_two (p : ℕ) (P : Type*) [Group P] :
    pSeries p P 2 = Work.Shrinking.powSubgroup p (⊤ : Subgroup P) ⊔
      ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ := by
  rw [show (2 : ℕ) = 0 + 2 from rfl, pSeries_succ_succ, pSeries_one,
    Work.Shrinking.pCentralStep]

/-- **The refinement does nothing at `(2,2)`**: the `(2,2)`-term of Schmidt–Wingberg's refined
filtration is `γ₂(P)·P_3`, for every group `P`. -/
theorem refinedTerm_two_two (p : ℕ) (P : Type*) [Group P] :
    refinedTerm p P 2 2 = ⁅(⊤ : Subgroup P), (⊤ : Subgroup P)⁆ ⊔ pSeries p P 3 := by
  have hle : centralSeries P 2 ≤ pSeries p P 2 := by
    rw [centralSeries_two, pSeries_two]; exact le_sup_right
  rw [refinedTerm, inf_eq_right.mpr hle, centralSeries_two]

/-- The same for the free `G`-operator group: `F(n)^{(2,2)} = [F,F]·F(n)^{(3,1)}`. -/
theorem flowTerm_two_two {G : Type*} [Group G] (n : ℕ) :
    flowTerm 2 G n 2 2 =
      ⁅(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n)),
        (⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))⁆ ⊔ flowTerm 2 G n 3 1 := by
  rw [flowTerm, refinedTerm_two_two, flowTerm, refinedTerm_one]

/-! ## The four relations in `Q_{(3,1)} = F(n)^{(3,1)}`

All four are immediate from `F(n)^{(3,1)} = F(n)_3 = (F(n)_2)^2·[F(n)_2, F(n)]` with
`F(n)_2 = F(n)^2·[F(n),F(n)]`: powers land in the `2`-th powers of `F(n)_2`, commutators in
`[F(n)_2, F(n)]`. -/

variable {G : Type*} [Group G] {n : ℕ}

/-- `F(n)^{(3,1)} = F(n)_3`, i.e. the third term of the `2`-central series. -/
theorem flowTerm_three_one :
    flowTerm 2 G n 3 1 = Work.Shrinking.pCentralSeries 2
      (Work.Shrinking.freeOperatorGroup G n) 2 := by
  rw [flowTerm, refinedTerm_one]

/-- An element of `F(n)_2^p` lies in `F(n)^{(3,1)}`. -/
theorem pow_mem_flowTerm_three_one {x : Work.Shrinking.freeOperatorGroup G n}
    (hx : x ∈ pSeries 2 (Work.Shrinking.freeOperatorGroup G n) 2) :
    x ^ 2 ∈ flowTerm 2 G n 3 1 := by
  rw [flowTerm_three_one]
  show x ^ 2 ∈ Work.Shrinking.pCentralStep 2
    (Work.Shrinking.pCentralSeries 2 (Work.Shrinking.freeOperatorGroup G n) 1)
  rw [Work.Shrinking.pCentralStep]
  exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨x, hx, rfl⟩)

/-- A commutator `⁅x,y⁆` with `x ∈ F(n)_2` lies in `F(n)^{(3,1)}`. -/
theorem commutator_mem_flowTerm_three_one {x y : Work.Shrinking.freeOperatorGroup G n}
    (hx : x ∈ pSeries 2 (Work.Shrinking.freeOperatorGroup G n) 2) :
    ⁅x, y⁆ ∈ flowTerm 2 G n 3 1 := by
  rw [flowTerm_three_one]
  show ⁅x, y⁆ ∈ Work.Shrinking.pCentralStep 2
    (Work.Shrinking.pCentralSeries 2 (Work.Shrinking.freeOperatorGroup G n) 1)
  rw [Work.Shrinking.pCentralStep]
  exact Subgroup.mem_sup_right ((Subgroup.commutator_le.mp le_rfl) x hx y (Subgroup.mem_top y))

/-- `x^2 ∈ F(n)_2 = F(n)^2·[F(n),F(n)]`. -/
theorem sq_mem_pSeries_two (x : Work.Shrinking.freeOperatorGroup G n) :
    x ^ 2 ∈ pSeries 2 (Work.Shrinking.freeOperatorGroup G n) 2 := by
  rw [pSeries_two]
  exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨x, Subgroup.mem_top x, rfl⟩)

/-- `[F(n),F(n)] ⊆ F(n)_2`. -/
theorem commutator_mem_pSeries_two (x y : Work.Shrinking.freeOperatorGroup G n) :
    ⁅x, y⁆ ∈ pSeries 2 (Work.Shrinking.freeOperatorGroup G n) 2 := by
  rw [pSeries_two]
  exact Subgroup.mem_sup_right ((Subgroup.commutator_le.mp le_rfl) x (Subgroup.mem_top x) y
    (Subgroup.mem_top y))

/-- **First relation**: `x^4 = 1` in `Q_{(3,1)}`. -/
theorem pow_four_mem (x : Work.Shrinking.freeOperatorGroup G n) :
    x ^ 4 ∈ flowTerm 2 G n 3 1 := by
  have h := pow_mem_flowTerm_three_one (G := G) (n := n) (sq_mem_pSeries_two (G := G) (n := n) x)
  rwa [← pow_mul] at h

/-- **Second relation**: `[x,y]^2 = 1` in `Q_{(3,1)}`. -/
theorem commutator_pow_two_mem (x y : Work.Shrinking.freeOperatorGroup G n) :
    ⁅x, y⁆ ^ 2 ∈ flowTerm 2 G n 3 1 :=
  pow_mem_flowTerm_three_one (G := G) (n := n) (commutator_mem_pSeries_two (G := G) (n := n) x y)

/-- **Third relation**: `[x^2,y] = 1` in `Q_{(3,1)}`. -/
theorem commutator_sq_mem (x y : Work.Shrinking.freeOperatorGroup G n) :
    ⁅x ^ 2, y⁆ ∈ flowTerm 2 G n 3 1 :=
  commutator_mem_flowTerm_three_one (G := G) (n := n) (sq_mem_pSeries_two (G := G) (n := n) x)

/-- **Fourth relation**: `[[x,y],z] = 1` in `Q_{(3,1)}`, i.e. the graded piece is central there. -/
theorem commutator_commutator_mem (x y z : Work.Shrinking.freeOperatorGroup G n) :
    ⁅⁅x, y⁆, z⁆ ∈ flowTerm 2 G n 3 1 :=
  commutator_mem_flowTerm_three_one (G := G) (n := n)
    (commutator_mem_pSeries_two (G := G) (n := n) x y)

/-! ## The kernel of the level projection `Q_{(3,1)} → Q_{(2,2)}` -/

/-- `tauSucc (2,2) = (3,1)`. -/
theorem tauSucc_two_two : tauSucc 2 2 = (3, 1) := tauSucc_of_le (le_refl 2)

/-- The ambient quotient of the graded piece `E(n,(2,2))` is the level-`(3,1)` quotient. -/
theorem flowTerm_succ_two_two :
    flowTerm 2 G n (tauSucc 2 2).1 (tauSucc 2 2).2 = flowTerm 2 G n 3 1 := by
  rw [tauSucc_two_two]

/-- **The kernel of `flowQuotSucc 2 G n 2 2` has commutator representatives**: since
`F(n)^{(2,2)} = [F,F]·F(n)^{(3,1)}`, every element of `E(n,(2,2))` is the image of an element of the
commutator subgroup of `F(n)`.  This is the lifting input of the `ℤ/4`-model computation of the
graded step at `σ = (2,2)`. -/
theorem ker_flowQuotSucc_two_two_exists_commutator
    {c : flowQuotient 2 G n (tauSucc 2 2).1 (tauSucc 2 2).2}
    (hc : flowQuotSucc 2 G n 2 2 c = 1) :
    ∃ y : Work.Shrinking.freeOperatorGroup G n,
      y ∈ ⁅(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n)),
            (⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))⁆ ∧
      QuotientGroup.mk' ((flowTerm 2 G n (tauSucc 2 2).1 (tauSucc 2 2).2).subgroupOf
        (⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) ⟨y, Subgroup.mem_top y⟩ = c := by
  haveI : (flowTerm 2 G n 3 1).Normal :=
    Work.CohomologicalShrinking.refinedTerm_normal 2 _ 3 1
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective
    ((flowTerm 2 G n (tauSucc 2 2).1 (tauSucc 2 2).2).subgroupOf
      (⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) c
  rw [flowQuotSucc_mk] at hc
  have hy : ((y : ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) :
      Work.Shrinking.freeOperatorGroup G n) ∈ flowTerm 2 G n 2 2 :=
    Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff y).mp hc)
  rw [flowTerm_two_two] at hy
  obtain ⟨u, hu, v, hv, huv⟩ := Subgroup.mem_sup_of_normal_right.mp hy
  refine ⟨u, hu, ?_⟩
  have hy_eq : y = (⟨u * v, Subgroup.mem_top (u * v)⟩ :
      ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) := Subtype.ext huv.symm
  rw [hy_eq]
  rw [show (⟨u * v, Subgroup.mem_top (u * v)⟩ :
      ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) =
        (⟨u, Subgroup.mem_top u⟩ : ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n)))
          * (⟨v, Subgroup.mem_top v⟩ : ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n)))
      from rfl, map_mul]
  have hv1 : QuotientGroup.mk' ((flowTerm 2 G n (tauSucc 2 2).1 (tauSucc 2 2).2).subgroupOf
      (⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n)))
      (⟨v, Subgroup.mem_top v⟩ : ↥(⊤ : Subgroup (Work.Shrinking.freeOperatorGroup G n))) = 1 := by
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact Subgroup.mem_subgroupOf.mpr hv
  rw [hv1, mul_one]

end TwoTwo

end Work.SSGRoute
