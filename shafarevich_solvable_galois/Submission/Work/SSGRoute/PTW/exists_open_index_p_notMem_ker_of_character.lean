set_option linter.style.haveILetI false

namespace Work.SSGRoute.PTW

/-- For a continuous character `χ : Q →* ℂˣ` of a commutative topological group whose values are
`p`-th roots of unity (`p` prime), and an element `y` with `χ y ≠ 1`, the kernel of `χ` is an open
subgroup of index `p` not containing `y`. -/
theorem exists_open_index_p_notMem_ker_of_character {Q : Type*} [CommGroup Q] [TopologicalSpace Q]
    [IsTopologicalGroup Q] (p : ℕ) [Fact p.Prime] (χ : Q →* ℂˣ) (hχ : Continuous χ)
    (hexp : ∀ g : Q, χ g ^ p = 1) (y : Q) (hy : χ y ≠ 1) :
    ∃ U : Subgroup Q, IsOpen (U : Set Q) ∧ U.index = p ∧ y ∉ U := by
  have hpprime : p.Prime := Fact.out
  have hp_ne_zero : p ≠ 0 := hpprime.ne_zero
  -- The image of `χ` is cyclic of order `p`, generated by `χ y`.
  have hrange : Nat.card χ.range = p := by
    haveI : NeZero p := ⟨hp_ne_zero⟩
    set a := χ y with ha_def
    have horder : orderOf a = p := orderOf_eq_prime (hexp y) hy
    -- every value of `χ` is a `p`-th root of unity
    have hle2 : χ.range ≤ rootsOfUnity p ℂ := by
      intro x hx
      rw [MonoidHom.mem_range] at hx
      obtain ⟨g, rfl⟩ := hx
      rw [mem_rootsOfUnity]
      exact hexp g
    have hinj2 : Function.Injective
        (fun x : χ.range => (⟨x.1, hle2 x.2⟩ : rootsOfUnity p ℂ)) := by
      intro u v h
      exact Subtype.ext (congrArg (fun w : rootsOfUnity p ℂ => (w : ℂˣ)) h)
    haveI hfinR : Finite χ.range := Finite.of_injective _ hinj2
    have ha : a ∈ χ.range := MonoidHom.mem_range.mpr ⟨y, rfl⟩
    have hle1 : Subgroup.zpowers a ≤ χ.range := Subgroup.zpowers_le.mpr ha
    have hinj1 : Function.Injective
        (fun z : Subgroup.zpowers a => (⟨z.1, hle1 z.2⟩ : χ.range)) := by
      intro u v h
      exact Subtype.ext (congrArg (fun w : χ.range => (w : ℂˣ)) h)
    have hlow : p ≤ Nat.card χ.range := by
      rw [← horder, ← Nat.card_zpowers a]
      exact Nat.card_le_card_of_injective _ hinj1
    have hhigh : Nat.card χ.range ≤ p := by
      calc Nat.card χ.range ≤ Nat.card (rootsOfUnity p ℂ) :=
            Nat.card_le_card_of_injective _ hinj2
        _ ≤ p := card_rootsOfUnity ℂ p
    exact le_antisymm hhigh hlow
  -- Index of the kernel equals the cardinality of the image.
  have hindex : χ.ker.index = p := by
    rw [Subgroup.index_ker, hrange]
  -- The kernel is closed, and a closed subgroup of finite index is open.
  have hclosed : IsClosed (χ.ker : Set Q) := by
    have h : (χ.ker : Set Q) = χ ⁻¹' {1} := by
      ext x; simp [MonoidHom.mem_ker]
    rw [h]
    exact IsClosed.preimage hχ isClosed_singleton
  haveI : χ.ker.FiniteIndex := Subgroup.finiteIndex_iff.mpr (by rw [hindex]; exact hp_ne_zero)
  refine ⟨χ.ker, Subgroup.isOpen_of_isClosed_of_finiteIndex _ hclosed, hindex, ?_⟩
  simpa [MonoidHom.mem_ker] using hy

end Work.SSGRoute.PTW
