open SSGRoute
open scoped TensorProduct

namespace Work.SSGRoute.H1Pair

section Helpers

variable {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]

/-- `b₀ ∘ res k N` is locally constant on every subgroup: the open subgroup is
`N.fixingSubgroup = ker (res k N)`. -/
theorem isLocConstOn_comp_res (N : IntermediateField k Ω) [FiniteDimensional k N] [Normal k N]
    {M : Type} [AddCommGroup M] (b₀ : (N ≃ₐ[k] N) → M) (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    SSGRoute.IsLocConstOn H (fun σ => b₀ (SSGRoute.res k N σ)) := by
  refine ⟨N.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen N, ?_⟩
  intro g _ u hu _
  have hres : SSGRoute.res k N u = 1 := by
    rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker]
    exact hu
  show b₀ (SSGRoute.res k N (g * u)) = b₀ (SSGRoute.res k N g)
  rw [map_mul, hres, mul_one]

/-- If `c ^ 2 = 1` then every function is locally constant on the cyclic subgroup generated by
`c`: that subgroup is `{1, c}`, and the Krull topology separates `c` from `1` (through the fixing
subgroup of `k⟮x⟯` for any `x` moved by `c`). -/
theorem isLocConstOn_zpowers_of_sq_eq_one [IsAlgClosure k Ω] {M : Type} [AddCommGroup M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (f : (Ω ≃ₐ[k] Ω) → M) :
    SSGRoute.IsLocConstOn (Subgroup.zpowers c) f := by
  have h2 : ∀ u ∈ Subgroup.zpowers c, u = 1 ∨ u = c := by
    intro u hu
    obtain ⟨n, hn⟩ := (Subgroup.mem_zpowers_iff).mp hu
    rw [← hn]
    have hcZ : c ^ (2 : ℤ) = 1 := by simpa using hc
    rcases Int.even_or_odd n with hn2 | hn2
    · left
      obtain ⟨m, hm⟩ := hn2
      rw [hm, show (m + m : ℤ) = 2 * m from by ring, zpow_mul, hcZ, one_zpow]
    · right
      obtain ⟨m, hm⟩ := hn2
      rw [hm, zpow_add_one, zpow_mul, hcZ, one_zpow, one_mul]
  by_cases h1 : c = 1
  · refine ⟨⊤, isOpen_univ, ?_⟩
    intro g _ u _ hu
    rcases h2 u hu with h | h
    · rw [h, mul_one]
    · rw [h, h1, mul_one]
  · obtain ⟨x, hx⟩ : ∃ x : Ω, c x ≠ x := by
      by_contra hcon
      have hfix : ∀ y : Ω, c y = y := by
        intro y
        by_contra hy
        exact hcon ⟨y, hy⟩
      exact h1 (AlgEquiv.ext hfix)
    set L : IntermediateField k Ω := IntermediateField.adjoin k ({x} : Set Ω) with hLdef
    have hxint : IsIntegral k x := (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
    have hLfin : FiniteDimensional k ↥L :=
      hLdef ▸ IntermediateField.adjoin.finiteDimensional hxint
    haveI := hLfin
    refine ⟨L.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen L, ?_⟩
    have hxL : x ∈ L := by
      rw [hLdef]
      exact IntermediateField.subset_adjoin k ({x} : Set Ω) (Set.mem_singleton x)
    have hcL : c ∉ L.fixingSubgroup := by
      intro hmem
      refine hx ?_
      have h := hmem ⟨x, hxL⟩
      simpa using h
    intro g _ u huU huH
    have hu1 : u = 1 := by
      rcases h2 u huH with h | h
      · exact h
      · exact absurd (h ▸ huU) hcL
    rw [hu1, mul_one]

end Helpers

/-- **The functional `ω` attached to the local data** (step 1 of the assembly of
`Work.SSGRoute.coker_obstruction`).  Given a pairing `pair` on cochains of the big group
`G_k = Ω ≃ₐ[k] Ω` with values in `E` and in `DualMod p (E ⊗ T) = E^∨(1)` which is additive in each
variable on cocycles and vanishes when an argument is a coboundary, and the local data `(α, β)`, the
formula

`ω([b₀]) = ∑_{A∈S} pair (decomp k A) (α A) (b₀ ∘ res k N) + ∑_{c∈C} pair (zpowers c) (β c) (b₀ ∘ res k N)`

defines a linear form on the `1`-cocycles `Gal(N/k) → E^∨(1)` which kills the coboundaries.

PROVED (2026-09-26).  The proof is: (a) the cocycle condition pulls back along `res k N`
(`groupCohomology.mem_cocycles₁_def` plus `hπN`); (b) additivity in `b₀` from `hadd₂` (the two local
constancy inputs are the lemmas above); (c) vanishing on coboundaries: `b₀ = d₀₁ m` becomes
`(b₀ ∘ res k N) = d₀₁ m` with respect to `res k K` by `hπN`, and `hcob` kills every summand;
(d) additivity on the `ZMod p`-module of cocycles upgrades to `ZMod p`-linearity.
Consumers: `x := (pad 1)`-inverse of `ω` (see `Work.SSGRoute.H1Pair.tateDual_natural`); the descent
of `Φ` from the cocycles to `groupCohomology.H1` is the third clause of
`Work.SSGRoute.h1_bridge`.
-/
theorem omega_functional_contra (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K N : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k N] [IsGalois k N] (hKN : K ≤ N)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E T : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (πN : (N ≃ₐ[k] N) →* (K ≃ₐ[k] K))
    (hπN : ∀ σ : Ω ≃ₐ[k] Ω, πN (SSGRoute.res k N σ) = SSGRoute.res k K σ)
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → E) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      PairClauses p K T E (fun a b => pair H a b) H)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (C : Finset (Ω ≃ₐ[k] Ω)) (hCinv : ∀ c ∈ C, c ^ 2 = 1)
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → E)
    (hα : ∀ A ∈ S, SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) (α A) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) (α A))
    (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → E)
    (hβ : ∀ c ∈ C, SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) (β c)) :
    ∃ Φ : ↥(groupCohomology.cocycles₁ (contra (Rep.res πN
        (Rep.of (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
          (TensorProduct (ZMod p) E T)))))) →ₗ[ZMod p] ZMod p,
      (∀ x : ↥(groupCohomology.cocycles₁ (contra (Rep.res πN
        (Rep.of (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
          (TensorProduct (ZMod p) E T)))))),
        (x : (N ≃ₐ[k] N) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T))
            ∈ groupCohomology.coboundaries₁ (contra (Rep.res πN
        (Rep.of (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
          (TensorProduct (ZMod p) E T))))) → Φ x = 0) ∧
      (∀ (b₀ : (N ≃ₐ[k] N) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T))
        (hb : b₀ ∈ groupCohomology.cocycles₁ (contra (Rep.res πN
        (Rep.of (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
          (TensorProduct (ZMod p) E T)))))),
        Φ ⟨b₀, hb⟩ =
          S.sum (fun A => pair (SSGRoute.decomp k A) (α A) (fun σ => b₀ (SSGRoute.res k N σ))) +
          C.sum (fun c => pair (Subgroup.zpowers c) (β c) (fun σ => b₀ (SSGRoute.res k N σ)))) := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  -- the Tate twist as a `Gal(K/k)`-module and its restriction to `Gal(N/k)`
  let AN : Rep (ZMod p) (N ≃ₐ[k] N) := contra (Rep.res πN (Rep.of
    (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
      (TensorProduct (ZMod p) E T))))
  have hAN : AN = contra (Rep.res πN (Rep.of (Representation.ofDistribMulAction
      (ZMod p) (K ≃ₐ[k] K) (TensorProduct (ZMod p) E T)))) := rfl
  have hρ : ∀ (σ : N ≃ₐ[k] N) (m : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T)),
      AN.ρ σ m = (πN σ) • m := by
    intro σ m
    have hdual := DFunLike.congr_fun
      (comp_dual_eq_dualMod p k Ω K N πN (TensorProduct (ZMod p) E T)) σ
    show (((Rep.res πN (Rep.of (Representation.ofDistribMulAction (ZMod p) (K ≃ₐ[k] K)
      (TensorProduct (ZMod p) E T)))).ρ.dual σ) m) = (πN σ) • m
    rw [hdual]
    simp only [Rep.of, Rep.res_obj_ρ, MonoidHom.comp_apply,
      Representation.ofDistribMulAction_apply_apply]
  -- ## (a) the cocycle condition pulls back along `res k N`
  have hcoc : ∀ (b : ↥(groupCohomology.cocycles₁ AN)) (H : Subgroup (Ω ≃ₐ[k] Ω)),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) H (fun σ => b.1 (SSGRoute.res k N σ)) := by
    intro b H σ _ τ _
    show b.1 (SSGRoute.res k N (σ * τ))
      = b.1 (SSGRoute.res k N σ) + (SSGRoute.res k K σ) • b.1 (SSGRoute.res k N τ)
    rw [map_mul]
    have hb := (groupCohomology.mem_cocycles₁_def b.1).1 b.2 (SSGRoute.res k N σ)
      (SSGRoute.res k N τ)
    rw [hρ, hπN σ] at hb
    rw [sub_add_eq_add_sub, sub_eq_zero] at hb
    rw [← hb, add_comm]
  -- ## (b) the local constancy inputs
  have hlocN : ∀ (b : ↥(groupCohomology.cocycles₁ AN)) (H : Subgroup (Ω ≃ₐ[k] Ω)),
      SSGRoute.IsLocConstOn H (fun σ => b.1 (SSGRoute.res k N σ)) :=
    fun b H => isLocConstOn_comp_res N b.1 H
  have hlocβ : ∀ c ∈ C, SSGRoute.IsLocConstOn (Subgroup.zpowers c) (β c) :=
    fun c hc => isLocConstOn_zpowers_of_sq_eq_one c (hCinv c hc) (β c)
  -- the functional, on the cocycles
  let gfun : ↥(groupCohomology.cocycles₁ AN) → ZMod p := fun b =>
    S.sum (fun A' => pair (SSGRoute.decomp k A') (α A')
      (fun σ => b.1 (SSGRoute.res k N σ))) +
    C.sum (fun c => pair (Subgroup.zpowers c) (β c) (fun σ => b.1 (SSGRoute.res k N σ)))
  -- ## (b) additivity
  have hgS : ∀ (b b' : ↥(groupCohomology.cocycles₁ AN)) (A' : ValuationSubring Ω), A' ∈ S →
      pair (SSGRoute.decomp k A') (α A') (fun σ => (b + b').1 (SSGRoute.res k N σ))
        = pair (SSGRoute.decomp k A') (α A') (fun σ => b.1 (SSGRoute.res k N σ))
          + pair (SSGRoute.decomp k A') (α A') (fun σ => b'.1 (SSGRoute.res k N σ)) := by
    intro b b' A' hA'
    have h1 : (fun σ : Ω ≃ₐ[k] Ω => (b + b').1 (SSGRoute.res k N σ))
        = (fun σ : Ω ≃ₐ[k] Ω => b.1 (SSGRoute.res k N σ) + b'.1 (SSGRoute.res k N σ)) := by
      funext σ
      exact congrFun (Submodule.coe_add b b') (SSGRoute.res k N σ)
    rw [h1]
    exact ((hloc (SSGRoute.decomp k A') (Or.inl ⟨A', hSfin A' hA', rfl⟩)).2.1) (α A') _ _
      (hα A' hA') ⟨hcoc b _, hlocN b _⟩ ⟨hcoc b' _, hlocN b' _⟩
  have hgC : ∀ (b b' : ↥(groupCohomology.cocycles₁ AN)) (c : Ω ≃ₐ[k] Ω), c ∈ C →
      pair (Subgroup.zpowers c) (β c) (fun σ => (b + b').1 (SSGRoute.res k N σ))
        = pair (Subgroup.zpowers c) (β c) (fun σ => b.1 (SSGRoute.res k N σ))
          + pair (Subgroup.zpowers c) (β c) (fun σ => b'.1 (SSGRoute.res k N σ)) := by
    intro b b' c hc
    have h1 : (fun σ : Ω ≃ₐ[k] Ω => (b + b').1 (SSGRoute.res k N σ))
        = (fun σ : Ω ≃ₐ[k] Ω => b.1 (SSGRoute.res k N σ) + b'.1 (SSGRoute.res k N σ)) := by
      funext σ
      exact congrFun (Submodule.coe_add b b') (SSGRoute.res k N σ)
    rw [h1]
    exact ((hloc (Subgroup.zpowers c) (Or.inr ⟨c, hCinv c hc, rfl⟩)).2.1) (β c) _ _
      ⟨hβ c hc, hlocβ c hc⟩ ⟨hcoc b _, hlocN b _⟩ ⟨hcoc b' _, hlocN b' _⟩
  have hadd : ∀ b b' : ↥(groupCohomology.cocycles₁ AN), gfun (b + b') = gfun b + gfun b' := by
    intro b b'
    have hS := Finset.sum_congr rfl (fun A' (hA' : A' ∈ S) => hgS b b' A' hA')
    have hC := Finset.sum_congr rfl (fun c (hc : c ∈ C) => hgC b b' c hc)
    simp only [gfun]
    rw [hS, hC, Finset.sum_add_distrib, Finset.sum_add_distrib]
    abel
  -- ## (c) vanishing on coboundaries
  have hvan : ∀ x : ↥(groupCohomology.cocycles₁ AN),
      (x : (N ≃ₐ[k] N) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T))
        ∈ groupCohomology.coboundaries₁ AN → gfun x = 0 := by
    intro x hx
    obtain ⟨m, hm⟩ := LinearMap.mem_range.mp hx
    have hcobOn : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H (fun σ => x.1 (SSGRoute.res k N σ)) := by
      intro H
      refine ⟨m, ?_⟩
      have hmσ : ∀ σ : N ≃ₐ[k] N, ((groupCohomology.d₀₁ AN).hom m) σ = x.1 σ :=
        fun σ => (congrFun hm σ).trans rfl
      intro g _
      show x.1 (SSGRoute.res k N g) = (SSGRoute.res k K g) • m - m
      rw [← hmσ (SSGRoute.res k N g)]
      have hval : ((groupCohomology.d₀₁ AN).hom m) (SSGRoute.res k N g)
          = AN.ρ (SSGRoute.res k N g) m - m := rfl
      rw [hval, hρ, hπN g]
    have h0S : ∀ A' ∈ S, pair (SSGRoute.decomp k A') (α A')
        (fun σ => x.1 (SSGRoute.res k N σ)) = 0 := by
      intro A' hA'
      exact ((hloc (SSGRoute.decomp k A') (Or.inl ⟨A', hSfin A' hA', rfl⟩)).2.2.1) (α A') _ (hα A' hA')
        ⟨isCocycleOn_of_isCoboundaryOn (hcobOn _), hlocN x _⟩ (Or.inr (hcobOn _))
    have h0C : ∀ c ∈ C, pair (Subgroup.zpowers c) (β c)
        (fun σ => x.1 (SSGRoute.res k N σ)) = 0 := by
      intro c hc
      exact ((hloc (Subgroup.zpowers c) (Or.inr ⟨c, hCinv c hc, rfl⟩)).2.2.1) (β c) _
        ⟨hβ c hc, hlocβ c hc⟩
        ⟨isCocycleOn_of_isCoboundaryOn (hcobOn _), hlocN x _⟩ (Or.inr (hcobOn _))
    simp only [gfun]
    rw [Finset.sum_eq_zero h0S, Finset.sum_eq_zero h0C, add_zero]
  -- ## (d) packaging: additivity on a `ZMod p`-module is `ZMod p`-linearity
  have hgzero : gfun 0 = 0 := by
    refine hvan 0 ?_
    refine ⟨0, ?_⟩
    rw [map_zero]
    funext σ
    rfl
  have hnsmul : ∀ (n : ℕ) (x : ↥(groupCohomology.cocycles₁ AN)),
      gfun (n • x) = n • gfun x := by
    intro n x
    induction n with
    | zero => simpa using hgzero
    | succ n ih => rw [succ_nsmul, hadd, ih, succ_nsmul]
  refine ⟨{ toFun := gfun, map_add' := hadd, map_smul' := ?_ }, hvan, fun b₀ hb => rfl⟩
  intro r x
  have h1 : r • x = (r.val) • x := by
    rw [← Nat.cast_smul_eq_nsmul (ZMod p) r.val x, ZMod.natCast_zmod_val]
  have h2 : (r.val) • gfun x = r • gfun x := by
    rw [← Nat.cast_smul_eq_nsmul (ZMod p) r.val (gfun x), ZMod.natCast_zmod_val]
  rw [h1, hnsmul r.val x, h2]
  rfl

end Work.SSGRoute.H1Pair
