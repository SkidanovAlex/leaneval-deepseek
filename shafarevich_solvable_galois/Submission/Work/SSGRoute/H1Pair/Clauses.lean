namespace Work.SSGRoute.H1Pair

/-- The local groups of the global assembly: the decomposition group of a finite place of `Ω`, or
the group generated by an involution (a real place, by Artin–Schreier). -/
def IsLocalGroup (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (H : Subgroup (Ω ≃ₐ[k] Ω)) : Prop :=
  (∃ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A ∧ H = SSGRoute.decomp k A) ∨
    (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)

/-- **The local pairing clauses (1)–(3) and perfectness**, at a fixed local group `H`, for a fixed
coefficient module `M`: additivity in each variable on locally constant cocycles, vanishing when an
argument is a coboundary, and perfectness on both sides.  This is the `hloc` bundle of
`Work.SSGRoute.pt_selmer_relaxed`, at the module `M`. -/
def PairClauses (p : ℕ) {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k K] (T M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (pairH : ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)
    (H : Subgroup (Ω ≃ₐ[k] Ω)) : Prop :=
  (∀ (a a' : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    pairH (a + a') b = pairH a b + pairH a' b) ∧
  (∀ (a : (Ω ≃ₐ[k] Ω) → M) (b b' : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b' ∧ SSGRoute.IsLocConstOn H b') →
    pairH a (b + b') = pairH a b + pairH a b') ∧
  (∀ (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a ∨
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) →
    pairH a b = 0) ∧
  (∀ a : (Ω ≃ₐ[k] Ω) → M,
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
      pairH a b = 0) →
    SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
  (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (∀ a : (Ω ≃ₐ[k] Ω) → M,
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
      pairH a b = 0) →
    SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b)


/-- **Reciprocity (REC)** of a local pairing family at a fixed coefficient module `M`: the sum of the
local pairings over one place per prime of `S'` and one involution per real place `C'` vanishes on
pairs of *global* locally constant cocycles that are unramified outside `S' ∪ C'` (this is the
`hrec` hypothesis of `Work.SSGRoute.pt_selmer_relaxed`).

This is the input that is **not** among the clauses of
`Work.SSGRoute.PTembedding.localTatePairing_canonical`: it is the global reciprocity law for the
canonical pairings (the sum of the local invariants of a global class vanishes), and it is currently
neither stated nor proved elsewhere in the workspace.  It is stated here, once, in the exact shape
`pt_selmer_relaxed` consumes, so that the assembly can refer to it and so that a future lane has a
single definition to prove against. -/
def PairReciprocity (p : ℕ) {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k K] (T M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p) : Prop :=
  ∀ (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
    ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
    (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
    (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
      ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
    ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
    (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
    (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
    ∑ A ∈ S', pair (SSGRoute.decomp k A) a b +
      ∑ c ∈ C', pair (Subgroup.zpowers c) a b = 0

end Work.SSGRoute.H1Pair
