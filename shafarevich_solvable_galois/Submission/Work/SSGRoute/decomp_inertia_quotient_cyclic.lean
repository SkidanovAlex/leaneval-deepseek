-- Target: `Work.SSGRoute.decomp_inertia_quotient_cyclic`, needed as the `hcyc` hypothesis of
-- `Work.SSGRoute.exists_cyclic_open_of_isInertia_eq_zero` in
-- `Submission/Work/SSGRoute/shafarevich_existence.lean`.
--
-- Content: for a finite place `B` of `Ω` (an algebraic closure of the number field `k`) and an
-- open `V ≤ G_k` containing every inertial element at `B`, the open subgroup `D_B ⊓ V` of the
-- decomposition group `D_B = SSGRoute.decomp k B` is normal in `D_B` and `D_B/(D_B ⊓ V)` is cyclic.
--
-- The proof is level-theoretic and avoids the local field theory entirely:
-- * `Work.SSGRoute.levelSub B M` is the subgroup of `D_B` acting trivially on the level subring
--   `B ∩ M` modulo its maximal ideal (`Submission/Work/SSGRoute/levelInertia_defs.lean`);
-- * `Work.SSGRoute.mem_levelSub_iff` : the intersection of the `levelSub B M` over the finite
--   normal `M` is exactly the set of inertia elements at `B`;
-- * `Work.SSGRoute.exists_levelSub_le_of_isOpen` : an open `V ≥` the inertia subgroup contains
--   some `levelSub B M`;
-- * `Work.SSGRoute.levelSub_commutator_and_generator` : `D_B ⧸ (D_B ⊓ levelSub B M)` is finite
--   cyclic (it embeds into the Galois group of the finite residue field extension), so `D_B`
--   contains the commutators and is generated by a single element modulo `D_B ⊓ levelSub B M`.
theorem decomp_inertia_quotient_cyclic (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (V : Subgroup (Ω ≃ₐ[k] Ω)) (hV : IsOpen (V : Set (Ω ≃ₐ[k] Ω)))
    (hI : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → σ ∈ V) :
    (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
    (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) := by
  obtain ⟨M, hMfd, hMnorm, hMV⟩ := exists_levelSub_le_of_isOpen k Ω B hB V hV hI
  haveI := hMfd
  haveI := hMnorm
  obtain ⟨hcomm, hgen⟩ := levelSub_commutator_and_generator k Ω B hB M
  constructor
  · intro δ hδ u hu
    have hc : δ * u * δ⁻¹ * u⁻¹ ∈ SSGRoute.decomp k B ⊓ levelSub B M :=
      hcomm δ hδ u hu.1
    have hcV : δ * u * δ⁻¹ * u⁻¹ ∈ V := hMV hc.2
    have hkey : δ * u * δ⁻¹ = (δ * u * δ⁻¹ * u⁻¹) * u := by group
    rw [hkey]
    exact mul_mem hcV hu.2
  · obtain ⟨g, hgD, hg⟩ := hgen
    exact ⟨g, hgD, fun δ hδ => by
      obtain ⟨m, hm⟩ := hg δ hδ
      exact ⟨m, hMV hm.2⟩⟩

end Work.SSGRoute
