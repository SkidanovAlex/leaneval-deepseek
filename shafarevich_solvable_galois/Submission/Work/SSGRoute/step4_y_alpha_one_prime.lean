/-! # The first prime of the `α`-prescription of Schmidt–Wingberg's Fourth Step

Schmidt–Wingberg's Fourth Step prescribes the datum `y` locally at the places of `S`.  The first
prime of that prescription (`x_℘ = 0` for `℘ ∈ Ram(N_τ) ∪ S_p ∪ S_1 ∪ T⁰`, SW p. 30) is realised by
the *local target* `Work.SSGRoute.step4_local_target`: at a finite place `A` not over `p` where the
level-`τ` solution `φ` is trivial on the whole decomposition group `D_A`, the stage-`τ+1` solution
`ψ` maps `D_A` into the abelian kernel `E(n,τ)` and there is an unramified local homomorphism
`η : D_A → E(n,τ)` whose twist with `ψ` is cyclic, generated by the inertia.

This module packages that instantiation for a place `A` of the set `S` of a coker-side datum
`D : Step4CokerData p K n i j`, i.e. for `φ = D.phi`, `ψ = D.psi`.  The hypotheses of
`step4_local_target` are all available from `D` and the assumptions on `A`:

* `D.data` is stage-3 data at level `D.m`; pushing it down along `D.Φ` with
  `Work.SSGRoute.isProperStageData_pushdown` gives stage-3 data `IsProperStageData p K n i j D.phi
  D.psi` at level `n` (this is definitional because `D.phi`/`D.psi` are exactly the push-forwards),
  hence `hLift : LiftsFlow D.psi D.phi` and `hopen : IsOpen D.psi.ker`;
* `IsFinPlace ℚ A` is `D.hSfin A hA` (with `hA : A ∈ D.S`);
* `D_A ≤ K.fixingSubgroup` follows from `hφA` because `flowQuot (D.phi σ) = restrict K σ`
  (`mem_fixingSubgroup_of_restrict_eq_one`);
* `hAp` and `hφA` are hypotheses.

The conclusion is the `ηt`-clause block of `Step4YData` verbatim. -/

namespace Work.SSGRoute

theorem step4_y_alpha_one_prime (p : ℕ) [Fact p.Prime] (K : IntermediateField ℚ SSGRoute.QBar)
    [FiniteDimensional ℚ K] [Normal ℚ K] (n i j : ℕ) (hj : 1 ≤ j) (hji : j ≤ i)
    (D : Work.SSGRoute.Step4CokerData p K n i j)
    (A : ValuationSubring SSGRoute.QBar) (hA : A ∈ D.S)
    (hAp : ¬ A.valuation (p : SSGRoute.QBar) < 1)
    (hφA : ∀ σ ∈ SSGRoute.decomp ℚ A, D.phi σ = 1) :
    ∃ η : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
      (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
      IsCyclic (Subgroup.closure
        ((Work.SSGRoute.flowTwistE p K n i j η D.psi) ''
          (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
        Work.SSGRoute.flowTwistE p K n i j η D.psi τ
          = Work.SSGRoute.flowTwistE p K n i j η D.psi σ) := by
  classical
  -- (1) the level-`n` stage-3 data for `(D.phi, D.psi)`, by pushing `D.data` down along `D.Φ`
  have hPDN : IsProperStageData p K n i j D.phi D.psi :=
    isProperStageData_pushdown p K D.Φ D.φm D.ψm D.data
  -- (2) the `ψ`-lift, the openness of `ψ.ker`, and `flowQuot ∘ φ = res`
  have hLift : SSGRoute.LiftsFlow D.psi D.phi := hPDN.2.1
  have hopen : IsOpen (D.psi.ker : Set SSGRoute.GalQ) := hPDN.2.2.1.2.1
  have hφquot : ∀ σ : SSGRoute.GalQ,
      Work.CohomologicalShrinking.flowQuot p (K ≃ₐ[ℚ] K) n i j (D.phi σ) =
        Work.SSGRoute.restrict K σ := hPDN.1.1.2.2
  -- (3) the place `A` is finite, and `D_A ≤ G_K` since `φ` is trivial there
  have hAfin : SSGRoute.IsFinPlace ℚ A := D.hSfin A hA
  have hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup := by
    intro σ hσ
    exact mem_fixingSubgroup_of_restrict_eq_one K
      (by rw [← hφquot σ, hφA σ hσ, map_one])
  -- (4) the local target
  exact step4_local_target p K n i j hj hji D.phi D.psi hLift hopen A hAfin hAp hDK hφA

end Work.SSGRoute
