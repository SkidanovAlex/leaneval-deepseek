/-!
# `G1` from the cup datum: the restatement of the gluing with explicit tensor-action instances

Input `G1` (`Work.SSGRoute.canonical_localPairing_with_reciprocity`) asks for one family of local
pairings, indexed by the coefficient module `M` alone, with clauses (1)-(6) at every local group and
the reciprocity clause (7).  Two halves of that family are *proved* in the workspace: the
archimedean half (`Work.SSGRoute.E7Arch.pairArchFamily` with its clause bundle and its naturality)
in `E7Arch/pairFamily.lean`, and the finite-place half from the cup construction
(`Work.SSGRoute.cupH_pairClauses`, `cupH_natural`, `cupH_unramified`) in `cupG1Assembly.lean`, from
the invariant functional `inv` (with `hinv_add`, `hinv_cob`, `hinv_unram`), the diagonal-tensor rule
`hdiag` and the perfectness input `h4`.

They do **not** compose as stated: `E7Arch.glue_of_finiteHalf`'s `hnat` hypothesis does not carry
the hypotheses `IsCocycleOn H a`, `IsCocycleOn H b` that `cupH_natural` (and, in the intended
instantiation, the cup construction itself) requires -- without them the identity is *false* for the
cup family, since the `if` in `pairOfInvH` can take different branches on the two sides -- and its
`fin` is a variable whose tensor-action instances are fixed by type-class search in another file.

This file therefore **restates the gluing in one file** with the instances and the cocycle
hypotheses where they belong, and assembles `G1`'s conclusion from

* `inv`, `hinv_add`, `hinv_cob`, `hinv_unram` -- the invariant functional of the cup construction;
* `hdiag` -- the diagonal-tensor rule;
* `h4` -- perfectness of the cup pairing at the decomposition groups of the finite places
  (local Tate duality in its strong form, the arithmetic input);
* `hrecJoint` -- the *joint* reciprocity of the two halves (clause (7); it must not be split, see
  `E7Arch/g1Assembly.lean`).

Everything else -- the two halves' clauses, naturality, orthogonality, and the disjointness of the
two shapes of local group (`E7Arch.localGroupDisjoint`) -- is proved.
-/

open SSGRoute
open scoped TensorProduct BigOperators

namespace Work.SSGRoute

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

attribute [local instance] Classical.propDecidable

/-- **The finite-place half as a family**: the cup construction with the place-dependent invariant
functional `inv`. -/
noncomputable def finCup (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p :=
  fun M _ _ _ _ _ H a b => pairOfInvH p k Ω K T inv M H a b

/-- The glued family: the archimedean family at the groups generated by an involution, the
cup-generated finite-place family elsewhere.  (`pairArchFamily` is `0` off the involution groups,
so the order of the two tests is immaterial for the values; putting the involution test first makes
the clauses at `⟨c⟩` *definitionally* the archimedean ones.) -/
noncomputable def pairCup (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p :=
  fun M _ _ _ _ _ H a b =>
    if _h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c then
      E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M H a b
    else finCup p k Ω K ζ hζ hζK T hT inv M H a b

theorem pairCup_arch
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)} {c : Ω ≃ₐ[k] Ω} (hc : c ^ 2 = 1)
    (heq : H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairCup p k Ω K ζ hζ hζK T hT inv M H a b =
      E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b := by
  subst heq
  unfold pairCup
  exact dif_pos ⟨c, hc, rfl⟩

/-- The value of the glued family away from the involution groups. -/
theorem pairCup_fin
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)}
    (h : ¬ ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairCup p k Ω K ζ hζ hζK T hT inv M H a b = pairOfInvH p k Ω K T inv M H a b := by
  unfold pairCup finCup
  exact dif_neg h

/-- **The value of the glued family at a finite place is the cup value**, by the disjointness of
the two shapes of local group. -/
theorem pairCup_decomp
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairCup p k Ω K ζ hζ hζK T hT inv M (SSGRoute.decomp k A) a b =
      pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b := by
  refine pairCup_fin p k Ω K ζ hζ hζK T hT inv M (fun h => ?_) a b
  obtain ⟨c, hc, heq⟩ := h
  exact E7Arch.localGroupDisjoint k Ω A hA c hc heq

/-- **Clauses (1)-(4) of the cup pairing at a subgroup**, from `hinv_add`, `hinv_cob`, `hdiag` and
the perfectness input `h4`: the version of `Work.SSGRoute.pairOfInvH_pairClauses` with the clause-6
component dropped, so that `hinv_unram` is not needed. -/
theorem pairOfInvH_pairClauses_noUnram
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k K] (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (H : Subgroup (Ω ≃ₐ[k] Ω))
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T,
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) (TensorProduct (ZMod p) M T)]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (TensorProduct (ZMod p) M T)]
    (hdiagM : ∀ (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (hstabM : ∀ n : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
      SSGRoute.IsLocConstOn H (fun g => SSGRoute.res k K g • n))
    (h4 : (∀ a : (Ω ≃ₐ[k] Ω) → M,
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
        (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M H a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
      (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
        (∀ a : (Ω ≃ₐ[k] Ω) → M,
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M H a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b)) :
    H1Pair.PairClauses p K T M (fun a b => Work.SSGRoute.pairOfInvH p k Ω K T inv M H a b) H := by
  have hinstD := tensorAction_eq_of_diag p k Ω K T M hdiagM
  subst hinstD
  refine ⟨?_, ?_, ?_, h4.1, h4.2⟩
  · intro a a' b ha ha' hb
    exact E7Fin.pairOfInv_add_left p k Ω K T M H (inv H) (hinv_add H) a a' b ha ha' hb
  · intro a b b' ha hb hb'
    exact E7Fin.pairOfInv_add_right p k Ω K T M H (inv H) (hinv_add H) a b b' ha hb hb'
  · intro a b ha hb h
    rcases h with h | h
    · show E7Fin.pairOfInv p k Ω K T (inv H) M H a b = 0
      rw [E7Fin.pairOfInv_of_cocycle p k Ω K T (inv H) M H a b ⟨ha.1, hb.1⟩]
      exact hinv_cob _ (E7Fin.evCupFun_coboundary_left p k Ω K T M hdiagM H a b h hb.1 hb.2)
    · show E7Fin.pairOfInv p k Ω K T (inv H) M H a b = 0
      rw [E7Fin.pairOfInv_of_cocycle p k Ω K T (inv H) M H a b ⟨ha.1, hb.1⟩]
      exact hinv_cob _ (E7Fin.evCupFun_coboundary_right p k Ω K T M hdiagM H a b ha.1 ha.2 h hstabM)

/-- **Clause (5) of the cup pairing at a subgroup**, from `hdiag` alone (no `hinv_unram`). -/
theorem cupH_natural_direct
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k K] (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (H : Subgroup (Ω ≃ₐ[k] Ω))
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) (TensorProduct (ZMod p) M T)]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (TensorProduct (ZMod p) M T)]
    (hdiagM : ∀ (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
    [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂]
    [DistribMulAction (K ≃ₐ[k] K) (TensorProduct (ZMod p) M₂ T)]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (TensorProduct (ZMod p) M₂ T)]
    (hdiagM₂ : ∀ (g : K ≃ₐ[k] K) (x : M₂) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
    (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
      Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
    (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
      f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
    (a : (Ω ≃ₐ[k] Ω) → M)
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T))
    (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) :
    Work.SSGRoute.pairOfInvH p k Ω K T inv M₂ H (fun σ => f (a σ)) b =
      Work.SSGRoute.pairOfInvH p k Ω K T inv M H a (fun σ => f' (b σ)) :=
  E7Fin.pairOfInv_natural p k Ω K T (inv H) M M₂ hdiagM hdiagM₂ f hf f' hff' H a b ha hb

/-- **Clause (6) of the cup pairing at a good place**, from `hinv_cob` alone
(`Work.SSGRoute.cupH_unramified_of_hinv_cob`). -/
theorem cupH_unramified_direct
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
    (a : (Ω ≃ₐ[k] Ω) → M)
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
    (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
    (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0) :
    Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0 :=
  cupH_unramified_of_hinv_cob p k Ω K ζ hζ hζK T hT inv hinv_cob M A hA hpA hramA a b ha hb hiner


/-- Clauses (1)-(4) of the glued family at the decomposition group of a finite place. -/
theorem pairCup_pairClauses_decomp
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (hdiag : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
      (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (h4 : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      (∀ a : (Ω ≃ₐ[k] Ω) → M,
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
        (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) a) ∧
      (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
        (∀ a : (Ω ≃ₐ[k] Ω) → M,
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) b))
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A) :
    H1Pair.PairClauses p K T M
      (fun a b => pairCup p k Ω K ζ hζ hζK T hT inv M (SSGRoute.decomp k A) a b)
      (SSGRoute.decomp k A) :=
  E7Arch.pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
    (H := SSGRoute.decomp k A)
    (fun a b => pairCup_decomp p k Ω K ζ hζ hζK T hT inv M A hA a b)
    (pairOfInvH_pairClauses_noUnram p k Ω K T inv (SSGRoute.decomp k A) hinv_add
      (fun c hc => hinv_cob (SSGRoute.decomp k A) c hc) M (hdiag M)
      (isLocConstOn_res_smul_dualMod (K := K) (H := SSGRoute.decomp k A) (X := M) (T' := T) _)
      (h4 M A hA))

/-- Clauses (1)-(4) of the glued family at the group generated by an involution. -/
theorem pairCup_pairClauses_arch
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    H1Pair.PairClauses p K T M
      (fun a b => pairCup p k Ω K ζ hζ hζK T hT inv M (Subgroup.zpowers c) a b)
      (Subgroup.zpowers c) :=
  E7Arch.pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
    (H := Subgroup.zpowers c)
    (fun a b => pairCup_arch p k Ω K ζ hζ hζK T hT inv M hc rfl a b)
    (E7Arch.pairArchFamily_pairClauses p k Ω K ζ hζ hζK T hT M c hc)

/-- Clause (5) of the glued family at the decomposition group of a finite place. -/
theorem pairCup_natural_decomp
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (hdiag : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
      (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
    [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
    (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
    (f' : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
      Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
    (hff' : ∀ (φ : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
      f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T))
    (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) :
    pairCup p k Ω K ζ hζ hζK T hT inv M₂ (SSGRoute.decomp k A) (fun σ => f (a σ)) b =
      pairCup p k Ω K ζ hζ hζK T hT inv M (SSGRoute.decomp k A) a (fun σ => f' (b σ)) := by
  rw [pairCup_decomp p k Ω K ζ hζ hζK T hT inv M₂ A hA (fun σ => f (a σ)) b,
    pairCup_decomp p k Ω K ζ hζ hζK T hT inv M A hA a (fun σ => f' (b σ))]
  exact cupH_natural_direct p k Ω K T inv (SSGRoute.decomp k A) M (hdiag M) M₂ (hdiag M₂)
    f hf f' hff' a b ha hb

/-- Clause (5) of the glued family at the group generated by an involution. -/
theorem pairCup_natural_arch
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
    [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
    (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
    (f' : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
      Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
    (hff' : ∀ (φ : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
      f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T))
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    pairCup p k Ω K ζ hζ hζK T hT inv M₂ (Subgroup.zpowers c) (fun σ => f (a σ)) b =
      pairCup p k Ω K ζ hζ hζK T hT inv M (Subgroup.zpowers c) a (fun σ => f' (b σ)) := by
  rw [pairCup_arch p k Ω K ζ hζ hζK T hT inv M₂ hc rfl (fun σ => f (a σ)) b,
    pairCup_arch p k Ω K ζ hζ hζK T hT inv M hc rfl a (fun σ => f' (b σ))]
  exact E7Arch.pairArchFamily_naturality p k Ω K ζ hζ hζK T hT M M₂ f hf f' hff' a b c hc

/-- Clause (6) of the glued family at a good place. -/
theorem pairCup_orth
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (hdiag : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
      (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t))
    (h4 : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      (∀ a : (Ω ≃ₐ[k] Ω) → M,
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
        (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) a) ∧
      (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
        (∀ a : (Ω ≃ₐ[k] Ω) → M,
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) b))
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
    (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
    (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0) :
    pairCup p k Ω K ζ hζ hζK T hT inv M (SSGRoute.decomp k A) a b = 0 := by
  rw [pairCup_decomp p k Ω K ζ hζ hζK T hT inv M A hA a b]
  exact cupH_unramified_direct p k Ω K ζ hζ hζK T hT inv hinv_cob M A hA hpA hramA
    a b ha hb hiner

/-- Clause (7) of the glued family, from the joint reciprocity of the two halves. -/
theorem pairCup_reciprocity
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hrecJoint : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M] :
    H1Pair.PairReciprocity p K T M
      (fun H a b => pairCup p k Ω K ζ hζ hζK T hT inv M H a b) := by
  intro a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj
  have h1 : ∑ A ∈ S', pairCup p k Ω K ζ hζ hζK T hT inv M (SSGRoute.decomp k A) a b
      = ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b := by
    refine Finset.sum_congr rfl fun A hA => ?_
    exact pairCup_decomp p k Ω K ζ hζ hζK T hT inv M A (hS'fin A hA) a b
  have h2 : ∑ c ∈ C', pairCup p k Ω K ζ hζ hζK T hT inv M (Subgroup.zpowers c) a b
      = ∑ c ∈ C', E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b := by
    refine Finset.sum_congr rfl fun c hc => ?_
    exact pairCup_arch p k Ω K ζ hζ hζK T hT inv M (hC'inv c hc) rfl a b
  rw [h1, h2]
  exact hrecJoint M a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj

/-- **The diagonal-tensor rule is automatic** for the canonical tensor-product action
(`Work.Shrinking.instDistribMulActionTensorProduct`): the `hdiag` hypothesis of the cup construction
(`cupH_pairClauses`, `cupH_natural`, `cupH_unramified`) is *not* an extra input. -/
theorem hdiag_cup (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T] :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] (g : K ≃ₐ[k] K) (x : M) (t : T),
      g • (TensorProduct.tmul (ZMod p) x t) =
        TensorProduct.tmul (ZMod p) (g • x) (g • t) :=
  fun M _ _ _ _ g x t =>
    Work.Shrinking.diagTensor_smul_tmul (p := p) (G := K ≃ₐ[k] K) g x t

/-- **`G1` from the cup datum**: the conclusion of
`Work.SSGRoute.canonical_localPairing_with_reciprocity`, assembled from the two proved halves in a
single file with the tensor-action instances and the cocycle hypotheses explicit.  The hypotheses are
exactly the invariant functional `inv` with its three properties, the diagonal-tensor rule `hdiag`,
the perfectness input `h4` at the finite places (local Tate duality), and the joint reciprocity
`hrecJoint`. -/
theorem canonical_localPairing_with_reciprocity_of_cupData
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (h4 : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      (∀ a : (Ω ≃ₐ[k] Ω) → M,
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
        (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) a) ∧
      (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
        (∀ a : (Ω ≃ₐ[k] Ω) → M,
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) b))
    (hrecJoint : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0) :
    ∃ pair : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p,
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        (∀ H : Subgroup (Ω ≃ₐ[k] Ω),
          ((∃ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A ∧ H = SSGRoute.decomp k A) ∨
            (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)) →
          -- (1)+(2) additive in each variable on locally constant cocycles
          (∀ (a a' : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            pair M H (a + a') b = pair M H a b + pair M H a' b) ∧
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b b' : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b' ∧ SSGRoute.IsLocConstOn H b') →
            pair M H a (b + b') = pair M H a b + pair M H a b') ∧
          -- (3) zero on a coboundary
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a ∨
              SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) →
            pair M H a b = 0) ∧
          -- (4) perfect in each variable
          (∀ a : (Ω ≃ₐ[k] Ω) → M,
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
          (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (∀ a : (Ω ≃ₐ[k] Ω) → M,
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) ∧
          -- (5) naturality in the coefficient module (transpose of `f ⊗ id_T`)
          (∀ (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
              [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
              (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
              (f' : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
                Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
              (hff' : ∀ (φ : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
                f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
              (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            pair M₂ H (fun σ => f (a σ)) b = pair M H a (fun σ => f' (b σ))) ∧
          -- (6) orthogonality on unramified classes at good places
          (∀ (A : ValuationSubring Ω) (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            SSGRoute.IsFinPlace k A → ¬ A.valuation (p : Ω) < 1 → ¬ SSGRoute.IsRamifiedIn k K A →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
              SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
              SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
            (∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0) →
            pair M (SSGRoute.decomp k A) a b = 0))) ∧
      -- (7) reciprocity
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (a : (Ω ≃ₐ[k] Ω) → M)
          (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', pair M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', pair M (Subgroup.zpowers c) a b = 0) := by
  have hdiag := hdiag_cup p k Ω K T
  refine ⟨fun M _ _ _ _ _ => pairCup p k Ω K ζ hζ hζK T hT inv M, ?_, ?_⟩
  · intro M _ _ _ _ _ H hH
    rcases hH with ⟨A, hA, rfl⟩ | ⟨c, hc, rfl⟩
    · obtain ⟨h1, h2, h3, h4l, h4r⟩ :=
        pairCup_pairClauses_decomp p k Ω K ζ hζ hζK T hT inv hinv_add hinv_cob
          hdiag h4 M A hA
      refine ⟨h1, h2, h3, h4l, h4r, ?_, ?_⟩
      · intro M₂ _ _ _ _ _ f hf f' hff' a b ha hb
        exact pairCup_natural_decomp p k Ω K ζ hζ hζK T hT inv hinv_add hinv_cob
          hdiag M M₂ f hf f' hff' A hA a b ha hb
      · intro A' a b hA' hpA hramA ha hb hiner
        exact pairCup_orth p k Ω K ζ hζ hζK T hT inv hinv_add hinv_cob hdiag h4
          M A' hA' hpA hramA a b ha hb hiner
    · obtain ⟨h1, h2, h3, h4l, h4r⟩ :=
        pairCup_pairClauses_arch p k Ω K ζ hζ hζK T hT inv M c hc
      refine ⟨h1, h2, h3, h4l, h4r, ?_, ?_⟩
      · intro M₂ _ _ _ _ _ f hf f' hff' a b ha hb
        exact pairCup_natural_arch p k Ω K ζ hζ hζK T hT inv M M₂ f hf f' hff' a b c hc
      · intro A' a b hA' hpA hramA ha hb hiner
        exact pairCup_orth p k Ω K ζ hζ hζK T hT inv hinv_add hinv_cob hdiag h4
          M A' hA' hpA hramA a b ha hb hiner
  · intro M _ _ _ _ _
    exact pairCup_reciprocity p k Ω K ζ hζ hζK T hT inv hrecJoint M

/-- **The finite-place half of the joint reciprocity.**  For `p != 2` the archimedean family is
identically zero at the groups generated by involutions (`E7Arch.pairArchFamily_eq_zero_of_ne_two`),
so clause (7) of `G1` for the cup family is *equivalent* to the vanishing of the `S'`-sum at the
finite places alone.  (Clause (7) must not be split in general: for `k = Q`, `p = 2` neither half
vanishes separately -- see the header of `E7Arch/g1Assembly.lean`.) -/
theorem hrecJoint_of_finitePlace
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hfin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
      ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
      (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
        ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
          ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
      ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
      (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
      ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b +
        ∑ c ∈ C', E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0 := by
  intro M _ _ _ _ _ a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj
  rw [hfin M a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram, zero_add]
  refine Finset.sum_eq_zero fun c hc => ?_
  exact E7Arch.pairArchFamily_eq_zero_of_ne_two p k Ω K ζ hζ hζK T hT hp M c (hC'inv c hc) a b

/-- **`G1` for odd `p` from the finite-place reciprocity only.**  The conclusion is the same
`exists pair, ...` as `canonical_localPairing_with_reciprocity_of_cupData` (hence as
`Work.SSGRoute.canonical_localPairing_with_reciprocity`), so the `p = 2` correction is isolated:
for odd `p` the only remaining *reciprocity* input is the `S'`-sum at the finite places. -/
theorem canonical_localPairing_with_reciprocity_of_cupData_odd
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T]
    [DistribMulAction (K ≃ₐ[k] K) T] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (inv : Subgroup (Ω ≃ₐ[k] Ω) →
      ((Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T) → ZMod p)
    (hinv_add : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c c' : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      inv H (c + c') = inv H c + inv H c')
    (hinv_cob : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω))
      (c : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p T),
      SSGRoute.IsCoboundary2On (SSGRoute.res k K) H c → inv H c = 0)
    (h4 : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      (∀ a : (Ω ≃ₐ[k] Ω) → M,
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
        (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) a) ∧
      (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
        (∀ a : (Ω ≃ₐ[k] Ω) → M,
          (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
          Work.SSGRoute.pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) b))
    (hfin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∑ A ∈ S', pairOfInvH p k Ω K T inv M (SSGRoute.decomp k A) a b = 0) :
    ∃ pair : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p,
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        (∀ H : Subgroup (Ω ≃ₐ[k] Ω),
          ((∃ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A ∧ H = SSGRoute.decomp k A) ∨
            (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)) →
          -- (1)+(2) additive in each variable on locally constant cocycles
          (∀ (a a' : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            pair M H (a + a') b = pair M H a b + pair M H a' b) ∧
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b b' : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b' ∧ SSGRoute.IsLocConstOn H b') →
            pair M H a (b + b') = pair M H a b + pair M H a b') ∧
          -- (3) zero on a coboundary
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a ∨
              SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) →
            pair M H a b = 0) ∧
          -- (4) perfect in each variable
          (∀ a : (Ω ≃ₐ[k] Ω) → M,
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
          (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (∀ a : (Ω ≃ₐ[k] Ω) → M,
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) ∧
          -- (5) naturality in the coefficient module (transpose of `f ⊗ id_T`)
          (∀ (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
              [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
              (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
              (f' : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
                Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
              (hff' : ∀ (φ : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
