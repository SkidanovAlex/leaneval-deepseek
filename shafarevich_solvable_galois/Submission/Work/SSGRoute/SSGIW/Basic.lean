/-!
# The wild kernel of the inertia subgroup of a finite place: vocabulary

This module fixes the objects in terms of which the proof of
`Work.SSGRoute.inertia_wild_proPrimeToP_proCyclicGrowth` is phrased.

* `Work.SSGRoute.wildLvl p k Ω A hA M hfd hnm hnf` — the *wild inertia* of the level inertia
  `I_M = Work.SSGRoute.levelInertiaOf k Ω A hA M`, defined as the join of all the subgroups of
  `↥I_M` that are normal and of order coprime to `p` (so: the maximal such);
* `Work.SSGRoute.Idx k Ω` — the (directed) index type of finite normal levels `M ⊆ Ω` carrying a
  `NumberField ↥M` instance;
* `Work.SSGRoute.idxHomOf k Ω A hA M` — the restriction map `↥I_A →* ↥(levelInertiaOf k Ω A hA M)`;
* `Work.SSGRoute.NumIdx p k Ω A hA i` — the preimage in `I_A = Work.SSGRoute.inertiaSub k Ω A` of
  `wildLvl` at the level `i`, i.e. the level wild kernel;
* `Work.SSGRoute.Vsub p k Ω A hA` — the intersection of the `NumIdx` over all levels, i.e. the wild
  kernel `V` of the theorem.
-/

open scoped Pointwise NumberField

namespace Work.SSGRoute

/-- The normal subgroups of `H` of order coprime to `p`. -/
abbrev WildFam (H : Type*) [Group H] (p : ℕ) :=
  {Q : Subgroup H // Q.Normal ∧ Nat.Coprime p (Nat.card ↥Q)}

/-- **The wild inertia of the level inertia.**  For a finite normal level `M ⊆ Ω`, the subgroup of
the level inertia `I_M = levelInertiaOf k Ω A hA M` generated by the subgroups of `I_M` that are
normal and have order coprime to `p`; a product of two such again has order coprime to `p`
(`Work.SSGRoute.coprime_card_sup`), so this is the *maximal* normal subgroup of `I_M` of order
coprime to `p`. -/
noncomputable def wildLvl (p : ℕ) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (M : IntermediateField k Ω) [FiniteDimensional k M] [Normal k M] [NumberField ↥M] :
    Subgroup ↥(levelInertiaOf k Ω A hA M) :=
  ⨆ Q : WildFam ↥(levelInertiaOf k Ω A hA M) p, Q.1

/-- The index type of the finite normal levels of `Ω/k` carrying a `NumberField` instance. -/
abbrev Idx (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω] :=
  {M : IntermediateField k Ω // FiniteDimensional k M ∧ Normal k M ∧ NumberField ↥M}

/-- The index of a finite normal level. -/
abbrev idxOf (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω] (M : IntermediateField k Ω)
    [FiniteDimensional k M] [Normal k M] [NumberField ↥M] : Idx k Ω :=
  ⟨M, inferInstance, inferInstance, inferInstance⟩

/-- The restriction of the place inertia onto the inertia of a finite normal level. -/
noncomputable def idxHomOf (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (M : IntermediateField k Ω) [FiniteDimensional k M] [Normal k M] [NumberField ↥M] :
    ↥(inertiaSub k Ω A) →* ↥(levelInertiaOf k Ω A hA M) :=
  ((AlgEquiv.restrictNormalHom M).comp (inertiaSub k Ω A).subtype).codRestrict
    (levelInertiaOf k Ω A hA M) (fun x => by
      rw [← inertiaSub_image_eq_levelInertia k Ω A hA M]
      exact Subgroup.mem_map_of_mem _ x.2)

/-- **The level wild kernel**: the preimage in `I_A` of the wild inertia of the level. -/
noncomputable def NumIdx (p : ℕ) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (i : Idx k Ω) : Subgroup (↥(inertiaSub k Ω A)) :=
  letI := i.2.1
  letI := i.2.2.1
  letI := i.2.2.2
  (wildLvl p k Ω A hA i.1).comap (idxHomOf k Ω A hA i.1)

/-- **The wild kernel of the inertia subgroup**: the intersection of the level wild kernels. -/
noncomputable def Vsub (p : ℕ) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A) :
    Subgroup (↥(inertiaSub k Ω A)) :=
  ⨅ i : Idx k Ω, NumIdx p k Ω A hA i

variable {p : ℕ} {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  {A : ValuationSubring Ω} {hA : SSGRoute.IsFinPlace k A}

theorem Vsub_le_numIdx (i : Idx k Ω) : Vsub p k Ω A hA ≤ NumIdx p k Ω A hA i :=
  iInf_le _ _

theorem mem_Vsub_iff (x : ↥(inertiaSub k Ω A)) :
    x ∈ Vsub p k Ω A hA ↔ ∀ i : Idx k Ω, x ∈ NumIdx p k Ω A hA i :=
  Subgroup.mem_iInf

/-- Membership in the level wild kernel, in terms of the level itself. -/
theorem mem_numIdx_iff {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M]
    [NumberField ↥M] (x : ↥(inertiaSub k Ω A)) :
    x ∈ NumIdx p k Ω A hA (idxOf k Ω M) ↔ idxHomOf k Ω A hA M x ∈ wildLvl p k Ω A hA M :=
  Iff.rfl

end Work.SSGRoute
