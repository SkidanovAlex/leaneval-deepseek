namespace Work.SSGRoute.ZConstruction

theorem submodule_map_mkQ_eq_span_singleton {R L : Type*} [Field R] [AddCommGroup L] [Module R L]
    (B U : Submodule R L)
    (h : ∀ x ∈ U, ∀ y ∈ U, x ∉ B → ∃ c : R, y - c • x ∈ B) :
    ∃ u : L ⧸ B, U.map B.mkQ = Submodule.span R {u} := by
  by_cases hU : ∃ x ∈ U, x ∉ B
  · -- There is an element of `U` outside `B`: its image generates the quotient image.
    obtain ⟨x, hxU, hxB⟩ := hU
    refine ⟨B.mkQ x, le_antisymm ?_ ?_⟩
    · rw [Submodule.map_le_iff_le_comap]
      intro y hy
      rw [Submodule.mem_comap]
      obtain ⟨c, hc⟩ := h x hxU y hy hxB
      have hz : B.mkQ (y - c • x) = 0 := by
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact hc
      rw [map_sub, map_smul] at hz
      have h2 : B.mkQ y = c • B.mkQ x := sub_eq_zero.mp hz
      rw [h2]
      exact Submodule.smul_mem _ c (Submodule.subset_span (Set.mem_singleton _))
    · rw [Submodule.span_le]
      intro z hz
      rw [Set.mem_singleton_iff] at hz
      rw [hz]
      exact Submodule.mem_map_of_mem hxU
  · -- Otherwise `U ≤ B`, so its image is trivial, generated by `0`.
    have hsub : U ≤ B := by
      intro y hy
      by_contra hyB
      exact hU ⟨y, hy, hyB⟩
    refine ⟨0, ?_⟩
    have hmap : U.map B.mkQ = ⊥ := by
      apply le_antisymm
      · rw [Submodule.map_le_iff_le_comap]
        intro y hy
        rw [Submodule.mem_comap, Submodule.mem_bot]
        rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact hsub hy
      · exact bot_le
    rw [hmap, Submodule.span_singleton_eq_bot.mpr rfl]

end Work.SSGRoute.ZConstruction
