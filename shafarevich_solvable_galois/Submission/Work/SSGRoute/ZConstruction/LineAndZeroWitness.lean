/-!
# Two new sufficient conditions for the node `Work.SSGRoute.shafarevich_z_construction`

The node asks for a cochain `z : Gal(Ω/k) → E` with six properties.  Its only substantial conjunct is
the sixth one, which by `Work.SSGRoute.exists_V_of_cyclic_transfer` and
`Work.SSGRoute.isCyclic_transfer_of_exists_V` is *equivalent* to the cyclicity of

  `transfer z sec δ = ∑_{s : Gal(K|k)} s • z ((sec s)⁻¹ * δ * sec s)`

on the decomposition group `decomp k B` of a finite place `B ∉ cs(S)` that is split in `Λ`.

This file proves two new sufficient conditions for the node, both arithmetic-free, which together
delimit the genuinely hard case.

## 1. The **Galois-stable line** regime (Parts 1--2)

`Work.ZConstruction.shafarevich_z_construction_of_stableLine`: if the *datum* `y` takes its values in
a line `⟨v⟩ ≤ E` which is stable under the action of `Gal(K|k)` (`s • v ∈ ⟨v⟩` for all `s`), then the
candidate `z :=` (the extension of `y` by `0` off `G_K`) satisfies **all six** conjuncts.  The only
point needing an argument is conjunct 6: every summand `s • z ((sec s)⁻¹ δ sec s)` lies in `⟨v⟩`
(the first factor by `hyv`, the second by the stability), hence the transfer on `decomp k B` takes
values in the cyclic group `⟨v⟩`, so its image is cyclic, and
`exists_V_of_cyclic_transfer` converts this into the `∃ V` form.

Since `Gal(K|k)` acts trivially on `E` when `K = k`, this covers in particular every datum of
*`𝔽_p`-rank one* over a base `K = k`, whatever the dimension of `E`, so the previously known case
(`Work.SSGRoute.shafarevich_z_construction_of_finrank_le_one`, requiring
`finrank (ZMod p) E ≤ 1`) is strictly contained in it.

The supporting algebraic input is `exists_zmultiples_generator`: the image of a map which is additive
on a subgroup and takes values in a cyclic additive subgroup is generated by one of its values (this
is `AddSubgroup.le_zmultiples_iff`).

## 2. The **vanishing on `cs(S)`** regime (Part 3)

`Work.ZConstruction.shafarevich_z_construction_of_zeroOnCs`: if the datum vanishes on the local group
`decomp k B ⊓ G_K` of every place `B` conjugate into `S`, then `z := 0` satisfies all six conjuncts
(conjuncts 1, 2, 4, 5 are trivial, conjunct 3 is the hypothesis, and conjunct 6 holds with `V = ⊤`
because the transfer vanishes identically).  Its corollary
`shafarevich_z_construction_of_noResidualPlace` applies the node's hypothesis `hy0`: `y` is *forced*
to vanish at a place `B` conjugate into `S` unless `B` is **split in `K` and away from `p`**.

Combining, the residual obligation of the node is exactly the case in which

  `∃ B, IsFinPlace k B ∧ (∃ A ∈ S, IsConjPlace k A B) ∧ IsSplitIn k K B ∧ ¬ B.valuation (p:Ω) < 1`

with `y ≠ 0` on `decomp k B ⊓ G_K`.  For a *minimal* `S` (`S = Ram(Λ|k) ∪ {places over p}` up to
conjugacy) such a place is ramified in `Λ` but split (hence unramified) in `K`; at it `hyT` makes
`y` unramified and `y (decomp k B ⊓ G_K)` cyclic.  This is the place where Schmidt--Wingberg §4 has
to act, and it is where the two sufficient conditions above fail.
-/

open scoped Pointwise

namespace Work.SSGRoute.ZConstruction

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

/-! ## Part 1: the image of an additive map inside a cyclic subgroup -/

section Generator

variable {Γ : Type} [Group Γ] {E : Type} [AddCommGroup E]

/-- `X` additive on `D` vanishes at `1`. -/
lemma one_eq_zero_of_additive {D : Subgroup Γ} {X : Γ → E}
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) : X 1 = 0 := by
  have h : X (1 * 1) = X 1 + X 1 := hhom 1 D.one_mem 1 D.one_mem
  rw [mul_one] at h
  exact (add_left_cancel (show X 1 + 0 = X 1 + X 1 by rw [add_zero]; exact h)).symm

/-- `X` additive on `D` inverts. -/
lemma inv_eq_neg_of_additive {D : Subgroup Γ} {X : Γ → E}
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) (δ : Γ) (hδ : δ ∈ D) :
    X δ⁻¹ = - X δ := by
  have h := hhom δ hδ δ⁻¹ (D.inv_mem hδ)
  rw [mul_inv_cancel, one_eq_zero_of_additive hhom] at h
  exact eq_neg_of_add_eq_zero_right h.symm

/-- The image of a map which is additive on `D`, as an additive subgroup of `E`. -/
def imageSubgroup (D : Subgroup Γ) (X : Γ → E)
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) : AddSubgroup E where
  carrier := {x | ∃ δ ∈ D, X δ = x}
  zero_mem' := ⟨1, D.one_mem, one_eq_zero_of_additive hhom⟩
  add_mem' := by
    rintro a b ⟨δ, hδ, rfl⟩ ⟨ε, hε, rfl⟩
    exact ⟨δ * ε, D.mul_mem hδ hε, hhom δ hδ ε hε⟩
  neg_mem' := by
    rintro a ⟨δ, hδ, rfl⟩
    exact ⟨δ⁻¹, D.inv_mem hδ, inv_eq_neg_of_additive hhom δ hδ⟩

lemma mem_imageSubgroup {D : Subgroup Γ} {X : Γ → E}
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) {δ : Γ} (hδ : δ ∈ D) :
    X δ ∈ imageSubgroup D X hhom :=
  show (∃ ε ∈ D, X ε = X δ) from ⟨δ, hδ, rfl⟩

/-- **The image of an additive map whose values lie in a cyclic subgroup is generated by one of its
values.**  If `X δ ∈ AddSubgroup.zmultiples v` for every `δ ∈ D`, then there is `g ∈ D` with
`X δ ∈ AddSubgroup.zmultiples (X g)` for every `δ ∈ D`.  (The subgroup `imageSubgroup D X` is
contained in the cyclic group `⟨v⟩`; by `AddSubgroup.le_zmultiples_iff` it is `⟨n • v⟩` for some
`n`, and `n • v = X g` for some `g ∈ D`.) -/
lemma exists_zmultiples_generator {D : Subgroup Γ} {X : Γ → E}
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) {v : E}
    (hv : ∀ δ ∈ D, X δ ∈ AddSubgroup.zmultiples v) :
    ∃ g ∈ D, ∀ δ ∈ D, X δ ∈ AddSubgroup.zmultiples (X g) := by
  have hle : imageSubgroup D X hhom ≤ AddSubgroup.zmultiples v := by
    intro x hx
    obtain ⟨δ, hδ, rfl⟩ : ∃ δ ∈ D, X δ = x := hx
    exact hv δ hδ
  obtain ⟨n, hn⟩ := (AddSubgroup.le_zmultiples_iff v (imageSubgroup D X hhom)).mp hle
  have hmem : n • v ∈ imageSubgroup D X hhom := by
    rw [hn]
    exact AddSubgroup.mem_zmultiples_iff.mpr ⟨1, one_zsmul _⟩
  obtain ⟨g, hgD, hgx⟩ : ∃ g ∈ D, X g = n • v := hmem
  refine ⟨g, hgD, fun δ hδ => ?_⟩
  have h2 : X δ ∈ imageSubgroup D X hhom := mem_imageSubgroup hhom hδ
  rw [hn] at h2
  rw [hgx]
  exact h2

end Generator

/-! ## Part 2: the transfer of a datum with values in a Galois-stable line -/

section Line

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω]
  {K : IntermediateField k Ω} {E : Type} [AddCommGroup E] [Module (ZMod p) E]
  [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
  [FiniteDimensional k K] [Normal k K] [Fintype (K ≃ₐ[k] K)]

/-- **A `Gal(K|k)`-stable line is closed under the `G_K`-action**: if `s • v ∈ ⟨v⟩` for every
`s : Gal(K|k)`, then `s • x ∈ ⟨v⟩` for every `x ∈ ⟨v⟩`. -/
lemma smul_mem_zmultiples_of_stable {v : E}
    (hstable : ∀ s : K ≃ₐ[k] K, s • v ∈ AddSubgroup.zmultiples v)
    (s : K ≃ₐ[k] K) {x : E} (hx : x ∈ AddSubgroup.zmultiples v) :
    s • x ∈ AddSubgroup.zmultiples v := by
  obtain ⟨c, rfl⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
  obtain ⟨d, hd⟩ := AddSubgroup.mem_zmultiples_iff.mp (hstable s)
  refine AddSubgroup.mem_zmultiples_iff.mpr ⟨c * d, ?_⟩
  let f : E →+ E :=
    { toFun := fun y => s • y, map_zero' := smul_zero s, map_add' := fun y z => smul_add s y z }
  change (c * d) • v = f (c • v)
  rw [f.map_zsmul c v]
  change (c * d) • v = c • (s • v)
  rw [← hd, mul_zsmul]

/-- **The transfer of a cochain with values in a `Gal(K|k)`-stable line lies in that line.** -/
lemma transfer_mem_zmultiples {z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s) {v : E}
    (hstable : ∀ s : K ≃ₐ[k] K, s • v ∈ AddSubgroup.zmultiples v)
    (hzv : ∀ σ ∈ K.fixingSubgroup, z σ ∈ AddSubgroup.zmultiples v)
    (D : Subgroup (Ω ≃ₐ[k] Ω)) (hD : D ≤ K.fixingSubgroup) :
    ∀ δ ∈ D, transfer z sec δ ∈ AddSubgroup.zmultiples v := by
  intro δ hδ
  unfold transfer
  refine AddSubgroup.sum_mem (AddSubgroup.zmultiples v) (t := Finset.univ)
    (f := fun s : K ≃ₐ[k] K => s • z ((sec s)⁻¹ * δ * sec s)) (fun s _ => ?_)
  exact smul_mem_zmultiples_of_stable hstable s
    (hzv _ (conj_sec_mem_fixingSubgroup hsec s (hD hδ)))

/-- The transfer is additive on the decomposition group of a place split in `K`. -/
lemma transfer_additive_on_decomp {z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {B : ValuationSubring Ω} (hsplitK : SSGRoute.IsSplitIn k K B) :
    ∀ a ∈ SSGRoute.decomp k B, ∀ b ∈ SSGRoute.decomp k B,
      transfer z sec (a * b) = transfer z sec a + transfer z sec b :=
  fun a ha b hb => transfer_mul_mem hsec hz (hsplitK ha) (hsplitK hb)

end Line

/-! ## Part 2b: the node's conclusion in the Galois-stable line regime -/

/-- **`Work.SSGRoute.shafarevich_z_construction` in the Galois-stable line regime.**

If the datum `y` takes its values in a line `⟨v⟩ ≤ E` which is stable under the action of
`Gal(K|k)`, then the cochain `z :=` (the extension of `y` by `0` off `G_K`) satisfies all six
conjuncts of the node.  Conjuncts 1--5 are immediate; for conjunct 6, the transfer on `decomp k B`
takes values in the cyclic group `⟨v⟩` (`transfer_mem_zmultiples`), so its image is cyclic and the
`∃ V` form follows from `exists_V_of_cyclic_transfer`.

No hypothesis on the ramification of `y` is used beyond the node's own `hyS`, `hyT`, `hy0`: this is a
*new* regime, strictly larger than the case `finrank (ZMod p) E ≤ 1` of
`Work.SSGRoute.shafarevich_z_construction_of_finrank_le_one`. -/
theorem shafarevich_z_construction_of_stableLine (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (v : E) (hstable : ∀ s : K ≃ₐ[k] K, s • v ∈ AddSubgroup.zmultiples v)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hyv : ∀ σ ∈ K.fixingSubgroup, y σ ∈ AddSubgroup.zmultiples v)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  classical
  let z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ else 0
  have hzy : ∀ σ, σ ∈ K.fixingSubgroup → z σ = y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ else 0) = y σ
    rw [if_pos hσ]
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hzy (g * h) (K.fixingSubgroup.mul_mem hg hh), hzy g hg, hzy h hh, hy g hg h hh]
  have hzloc : SSGRoute.IsLocConstOn K.fixingSubgroup z := by
    obtain ⟨U, hUopen, hUc⟩ := hyc
    refine ⟨U, hUopen, ?_⟩
    intro g hg u hu huH
    rw [hzy (g * u) (K.fixingSubgroup.mul_mem hg huH), hzy g hg]
    exact hUc g hg u hu huH
  have hzv : ∀ σ ∈ K.fixingSubgroup, z σ ∈ AddSubgroup.zmultiples v := by
    intro σ hσ
    rw [hzy σ hσ]
    exact hyv σ hσ
  refine ⟨z, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro g hg h hh
    rw [hzadd g hg h hh, (res_eq_one_iff_mem_fixingSubgroup (K := K) g).mpr hg, one_smul]
  · exact hzloc
  · intro B hB hconj σ hσ _
    exact hzy σ hσ
  · intro c hc hc2
    rw [hzy c hc]
    exact hyinf c hc hc2
  · intro B hB hconj hnsplit σ hσ hI
    rw [hzy σ hσ]
    exact hyS B hB hconj hnsplit σ hσ hI
  · intro B hB hconj hsplitΛ
    have hsplitK : SSGRoute.IsSplitIn k K B :=
      le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
    have hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g) :=
      exists_zmultiples_generator (D := SSGRoute.decomp k B) (X := transfer z sec)
        (v := v) (transfer_additive_on_decomp (K := K) (z := z) (sec := sec) hsec hzadd hsplitK)
        (transfer_mem_zmultiples (K := K) (z := z) (sec := sec) (v := v) hsec hstable hzv
          (SSGRoute.decomp k B) hsplitK)
    obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
      exists_V_of_cyclic_transfer hsec hzadd hzloc B hsplitK hcyc
    exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩

/-! ## Part 2c: projecting a datum onto a `Gal(K|k)`-stable line

The node's conjunct 3 is the *only* place where the datum `y` occurs: it asks `z` to agree with `y`
on the local group `decomp k B ⊓ G_K` of each place `B` conjugate into `S`.  Consequently one may
replace `y` by *any* cochain agreeing with it there, and in particular one may always replace it by
its projection onto the span of those local values.  When that span lies in a `Gal(K|k)`-stable line
`⟨v⟩`, the projected datum is line-valued and the regime of Part 2 applies.  The projection is
supplied by `exists_projection_onto_line` (a retraction of the inclusion `⟨v⟩ ↪ E`, which exists
because `E` is a `ZMod p`-vector space, `p` being prime). -/

section Projection

/-- **The projection onto the line spanned by `v`.**  There is an additive map `E → E` which is the
identity on `AddSubgroup.zmultiples v` and takes all its values there.  (For `v = 0` this is the
zero map; for `v ≠ 0` it is the retraction of the inclusion of the line `⟨v⟩`, obtained by
complementing `(ZMod p) ∙ v` — `Submodule.exists_isCompl` — and projecting.) -/
lemma exists_projection_onto_line (p : ℕ) [Fact p.Prime] (E : Type) [AddCommGroup E]
    [Module (ZMod p) E] (v : E) :
    ∃ π : E →+ E, (∀ x ∈ AddSubgroup.zmultiples v, π x = x) ∧
      (∀ x : E, π x ∈ AddSubgroup.zmultiples v) := by
  classical
  let W : Submodule (ZMod p) E := Submodule.span (ZMod p) {v}
  obtain ⟨C, hC⟩ := Submodule.exists_isCompl W
  let e : (↥W × ↥C) ≃ₗ[ZMod p] E := Submodule.prodEquivOfIsCompl W C hC
  let π : E →+ E :=
    { toFun := fun x => (((e.symm x).1 : ↥W) : E)
      map_zero' := by simp
      map_add' := by intro a b; simp [map_add] }
  have hmemW : ∀ x ∈ AddSubgroup.zmultiples v, x ∈ W := by
    intro x hx
    obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
    rw [← hm, Submodule.mem_span_singleton]
    exact ⟨(m : ZMod p), Int.cast_smul_eq_zsmul (ZMod p) m v⟩
  have hmemv : ∀ x : E, π x ∈ AddSubgroup.zmultiples v := by
    intro x
    have hxW : ((e.symm x).1 : E) ∈ W := ((e.symm x).1).2
    rw [Submodule.mem_span_singleton] at hxW
    obtain ⟨c, hc⟩ := hxW
    have hcv : (((c.val : ℤ) : ZMod p)) = c := by
      push_cast
      exact ZMod.natCast_zmod_val c
    refine AddSubgroup.mem_zmultiples_iff.mpr ⟨(c.val : ℤ), ?_⟩
    show (c.val : ℤ) • v = (((e.symm x).1 : ↥W) : E)
    rw [← hc, ← Int.cast_smul_eq_zsmul (ZMod p) (c.val : ℤ) v, hcv]
  refine ⟨π, ?_, hmemv⟩
  intro x hx
  have hxW : x ∈ W := hmemW x hx
  have hleft := Submodule.prodEquivOfIsCompl_symm_apply_left W C hC (⟨x, hxW⟩ : ↥W)
  show (((e.symm x).1 : ↥W) : E) = x
  rw [hleft]

end Projection

/-! ## Part 2d: the conclusion of the node as a named predicate

`IsZConclusion S sec y z` is the six-fold conjunction of the node's conclusion with the witness `z`
and the datum `y` made explicit (so that `∃ z, IsZConclusion S sec y z` *is* the node's conclusion,
by definitional unfolding).  Naming it makes the assembly lemmas below readable, and in particular
lets one state the closure of the conclusion under sums of witnesses whose transfers have disjoint
support — the formal half of the "rank-one decomposition" route to the node. -/

section Conclusion

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] {K Λ : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K]
  [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] {E : Type} [AddCommGroup E]
  [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

/-- **The conclusion of `Work.SSGRoute.shafarevich_z_construction`** with the datum `y` and the
witness `z` explicit: the six conjuncts (cocycle, local constancy, agreement at the `cs(S)`-local
groups, vanishing on the involutions, vanishing on the inertia outside `cs(S)` that is not split in
`Λ`, and the `∃ V` form of local cyclicity of the transfer). -/
def IsZConclusion (S : Finset (ValuationSubring Ω))
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (y z : (Ω ≃ₐ[k] Ω) → E) : Prop :=
  SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
  SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
  (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
    ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
  (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
  (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
    ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
  (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0))

/-- The node's conclusion is the `∃ z` form of `IsZConclusion` (definitional unfolding). -/
theorem exists_isZConclusion_iff (S : Finset (ValuationSubring Ω))
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (y : (Ω ≃ₐ[k] Ω) → E) :
    (∃ z : (Ω ≃ₐ[k] Ω) → E, IsZConclusion (K := K) (Λ := Λ) S sec y z) ↔
      ∃ z : (Ω ≃ₐ[k] Ω) → E,
        SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
        SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
          ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
        (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
          ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
          ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
            (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
            (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
            (∀ δ ∈ SSGRoute.decomp k B ⊓ V,
              (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) :=
  Iff.rfl

/-- The transfer is additive in the cochain: `transfer (z₁ + z₂) sec δ` is the sum of the transfers. -/
lemma transfer_add (z₁ z₂ : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (δ : Ω ≃ₐ[k] Ω) :
    transfer (fun σ => z₁ σ + z₂ σ) sec δ = transfer z₁ sec δ + transfer z₂ sec δ := by
  unfold transfer
  rw [← Finset.sum_add_distrib]
  exact Finset.sum_congr rfl fun s _ => by rw [smul_add]

/-- The **five elementary conjuncts** of the node's conclusion (everything but the local cyclicity
conjunct): cocycle, local constancy, agreement with the datum at the `cs(S)`-local groups, vanishing
on the involutions, vanishing on the inertia outside `cs(S)` that is not split in `Λ`. -/
def IsZData5 (S : Finset (ValuationSubring Ω))
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (y z : (Ω ≃ₐ[k] Ω) → E) : Prop :=
  SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
  SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
  (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
    ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
  (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
  (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
    ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0)

end Conclusion

/-- **The node's cyclicity conjunct is needed only where the witness is actually ramified.**

Let `Z` satisfy the five elementary conjuncts for the datum `y`.  Suppose moreover that the transfer of
`Z` has cyclic image on `decomp k B` for every place `B ∉ cs(S)` that is split in `Λ` and such that
*some conjugate of `B` carries a non-zero value of `Z` on its inertia*.  Then `Z` satisfies the sixth
conjunct as well, i.e. the full conclusion `IsZConclusion S sec y Z`.

The point of the ramification trigger: if no conjugate of such a `B` carries a non-zero `Z`-value on
its inertia, then `Z` vanishes on the inertia of every conjugate of `B`, so the transfer
`X_Z = cor(Z)` kills the inertia of `B`
(`Work.SSGRoute.ZConstruction.transfer_eq_zero_of_vanishes_on_conjugate_inertia`), and its image on
`decomp k B` is cyclic by
`Work.SSGRoute.ZConstruction.exists_V_of_transfer_inertia_vanishing` (the pro-cyclicity of
`decomp k B / I_B`).  Hence only the **finitely many** junk places lying over the primes where `Z`
ramifies need to be checked --- which is what makes the box principle of Schmidt--Wingberg §4
applicable, and is the sharpest known form of the node's obligation. -/
theorem isZConclusion_of_cyclicTransferOnRamified
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s, SSGRoute.res k K (sec s) = s) (y Z : (Ω ≃ₐ[k] Ω) → E)
    (h5 : IsZData5 (K := K) (Λ := Λ) (E := E) S sec y Z)
    (hcyc : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      (∃ Q : ValuationSubring Ω, SSGRoute.IsConjPlace k B Q ∧
        ∃ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k Q σ ∧ Z σ ≠ 0) →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer Z sec δ ∈ AddSubgroup.zmultiples (transfer Z sec g)) :
    IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y Z := by
  obtain ⟨hZ1, hZ2, hZ3, hZ4, hZ5⟩ := h5
  have hZadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, Z (g * h) = Z g + Z h := by
    intro g hg h hh
    rw [hZ1 g hg h hh, (res_eq_one_iff_mem_fixingSubgroup (K := K) g).mpr hg, one_smul]
  refine ⟨hZ1, hZ2, hZ3, hZ4, hZ5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  by_cases hram : ∃ Q : ValuationSubring Ω, SSGRoute.IsConjPlace k B Q ∧
      ∃ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k Q σ ∧ Z σ ≠ 0
  · obtain ⟨g, hg, hgc⟩ := hcyc B hB hnotconj hsplitΛ hram
    obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
      exists_V_of_cyclic_transfer hsec hZadd hZ2 B hsplitK ⟨g, hg, hgc⟩
    exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩
  · have hvan : ∀ (s : K ≃ₐ[k] K) (τ : Ω ≃ₐ[k] Ω), τ ∈ K.fixingSubgroup →
        SSGRoute.IsInertia k ((sec s)⁻¹ • B) τ → Z τ = 0 := by
      intro s τ hτK hτI
      by_contra hne
      let Q : ValuationSubring Ω := (sec s)⁻¹ • B
      have hQ : SSGRoute.IsConjPlace k B Q :=
        Exists.intro ((sec s)⁻¹ : Ω ≃ₐ[k] Ω) rfl
      have hτI' : SSGRoute.IsInertia k Q τ := hτI
      have hex : ∃ σ : Ω ≃ₐ[k] Ω, σ ∈ K.fixingSubgroup ∧
          SSGRoute.IsInertia k Q σ ∧ Z σ ≠ 0 :=
        ⟨τ, hτK, hτI', hne⟩
      exact hram (Exists.intro Q ⟨hQ, hex⟩)
    have hIvan := transfer_eq_zero_of_vanishes_on_conjugate_inertia (p := p) (K := K) (z := Z)
      (sec := sec) hsec B hsplitK hvan
    exact exists_V_of_transfer_inertia_vanishing p k Ω K E Z sec hsec hZadd hZ2 B hB hsplitK hIvan

/-- **`Work.SSGRoute.shafarevich_z_construction` when the *local data at `cs(S)`* lies in a
`Gal(K|k)`-stable line.**

This is the natural form of `shafarevich_z_construction_of_stableLine`: it suffices that the values of
`y` on the local groups `decomp k B ⊓ G_K` of the places `B` conjugate into `S` lie in the stable
line `⟨v⟩` — *not* that all the values of `y` do.  The proof replaces `y` by its projection `y'`
onto `⟨v⟩` (`exists_projection_onto_line`), applies the stable-line theorem to `y'`, and observes
that the six conjuncts of the conclusion mention `y` only in conjunct 3, so that the witness for `y'`
is a witness for `y` (the projections agree on the `cs(S)`-local groups because `y` is line-valued
there).

Hence the node holds for *every* datum whose prescribed local data is one-dimensional, and — since
the projection onto the line can be applied to the *whole* datum, not only to its `cs(S)`-local part
— the residual obligation is exactly the *spanning* case: the local data of `y` at `cs(S)` spans a
subspace of `E` of `𝔽_p`-dimension `≥ 2` which is not contained in a `Gal(K|k)`-stable line. -/
theorem shafarevich_z_construction_of_csLine (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (v : E) (hstable : ∀ s : K ≃ₐ[k] K, s • v ∈ AddSubgroup.zmultiples v)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hyv : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ ∈ AddSubgroup.zmultiples v)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  classical
  obtain ⟨π, hπfix, hπval⟩ := exists_projection_onto_line p E v
  obtain ⟨z, hz1, hz2, hz3, hz4, hz5, hz6⟩ :=
    shafarevich_z_construction_of_stableLine p k Ω K Λ hKΛ ζ hζ hζK E v hstable
      S hSfin hSdisj hSram (fun σ => π (y σ))
      (fun g hg h hh => by
        show π (y (g * h)) = π (y g) + π (y h)
        rw [hy g hg h hh, map_add])
      (by
        obtain ⟨U, hUopen, hUc⟩ := hyc
        exact ⟨U, hUopen, fun g hg u hu huK => by
          show π (y (g * u)) = π (y g)
          rw [hUc g hg u hu huK]⟩)
      (fun B hB hconj hnsplit σ hσ hI => by
        show π (y σ) = 0
        rw [hyS B hB hconj hnsplit σ hσ hI, map_zero])
      (fun B hB hconj σ hσ hI => by
        show π (y σ) = 0
        rw [hyT B hB hconj σ hσ hI, map_zero])
      (fun B hB hconj htrig σ hσ hσd => by
        show π (y σ) = 0
        rw [hy0 B hB hconj htrig σ hσ hσd, map_zero])
      (fun c hc hc2 => by
        show π (y c) = 0
        rw [hyinf c hc hc2, map_zero])
      (fun σ _ => hπval (y σ)) sec hsec
  refine ⟨z, hz1, hz2, ?_, hz4, hz5, hz6⟩
  intro B hB hconj σ hσ hσd
  rw [hz3 B hB hconj σ hσ hσd]
  exact hπfix (y σ) (hyv B hB hconj σ hσ hσd)

/-! ## Part 2e: the node from cyclicity of the transfer of the datum itself

The converse of the equivalence "conjunct 6 ⟺ cyclicity of the transfer on `decomp k B`"
(`Work.SSGRoute.exists_V_of_cyclic_transfer` and `Work.SSGRoute.isCyclic_transfer_of_exists_V`) shows
that `z :=` (the extension of `y` by `0` off `G_K`) already satisfies conjunct 6 **as soon as the
transfer of `y` itself has cyclic image on the decomposition group of every junk place**.  This is the
weakest form of the node's obligation: it is a condition on the *datum*, with no search over `z`, and
it strictly generalises the régime of
`Work.SSGRoute.ZConstruction.shafarevich_z_construction_of_transferInertia` (where the transfer is
required to *kill* the inertia, which forces cyclicity) and the régime of
`shafarevich_z_construction_of_csLine` (where line-valued local data makes the transfer's image a
subgroup of a line).  What is left in the residual case is only the *modification* of `z` (by the
quotient-level freedom described in `ZConstruction/NOTE_session23.lean`) when this condition fails. -/

/-- **The node from the cyclicity of the transfer of the datum at the junk places.** -/
theorem shafarevich_z_construction_of_transferCyclicDatum (p : ℕ) [Fact p.Prime] (k Ω : Type)
    [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (hcyc : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer y sec δ ∈ AddSubgroup.zmultiples (transfer y sec g)) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  let Z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ else 0
  have hZy : ∀ σ, σ ∈ K.fixingSubgroup → Z σ = y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ else 0) = y σ
    rw [if_pos hσ]
  obtain ⟨hZ1, _hZ2, hZ3, hZ4, hZ5, hZtr⟩ :=
    zClauses_of_agrees_on_fixingSubgroup p k Ω K Λ E S y Z hZy hy hyc hyS hyinf sec hsec
  have hZadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, Z (g * h) = Z g + Z h := by
    intro g hg h hh
    rw [hZy (g * h) (K.fixingSubgroup.mul_mem hg hh), hZy g hg, hZy h hh, hy g hg h hh]
  have hZloc : SSGRoute.IsLocConstOn K.fixingSubgroup Z := by
    obtain ⟨U, hUopen, hUc⟩ := hyc
    refine ⟨U, hUopen, ?_⟩
    intro g hg u hu huK
    rw [hZy (g * u) (K.fixingSubgroup.mul_mem hg huK), hZy g hg]
    exact hUc g hg u hu huK
  refine ⟨Z, hZ1, hZloc, hZ3, hZ4, hZ5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  have hcyc' : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      transfer Z sec δ ∈ AddSubgroup.zmultiples (transfer Z sec g) := by
    obtain ⟨g, hg, hgc⟩ := hcyc B hB hnotconj hsplitΛ
    exact ⟨g, hg, fun δ hδ => by
      rw [hZtr B hsplitK δ hδ, hZtr B hsplitK g hg]
      exact hgc δ hδ⟩
  obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
    exists_V_of_cyclic_transfer hsec hZadd hZloc B hsplitK hcyc'
  exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩

/-! ## Part 2f: the node from the *junk* local data lying in a stable line

The conjunct 6 of the node concerns the transfer at a place `B ∉ cs(S)` split in `Λ`, and the
arguments of the summands are conjugates of elements of `decomp k B` by the `sec s`, i.e. elements of
the decomposition groups of the conjugates of `B`.  So conjunct 6 is decided by the values of the
cochain on the decomposition groups of the *junk* places (`B` outside `cs(S)` and split in `Λ`): if
those all lie in one `Gal(K|k)`-stable line, the transfer's image at every junk place is a subgroup of
that line, hence cyclic, and the candidate `z :=` (the extension of `y` by `0` off `G_K`) witnesses
the node.  **No hypothesis on the `cs(S)`-local data is needed for this**, because conjunct 3 is
satisfied by that candidate identically; this strictly generalises the stable-line régime of Part 2
(which required *all* the values of `y` on `G_K` to lie in the line). -/

section JunkLine

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] {K : IntermediateField k Ω} [FiniteDimensional k K] [Normal k K]
  [Fintype (K ≃ₐ[k] K)] {E : Type} [AddCommGroup E] [Module (ZMod p) E]
  [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

/-- Completely split places remain so under conjugation. -/
lemma isSplitIn_smul_of_isSplitIn {Λ : IntermediateField k Ω} [FiniteDimensional k Λ]
    [IsGalois k Λ] {B : ValuationSubring Ω} (h : SSGRoute.IsSplitIn k Λ B)
    (g : Ω ≃ₐ[k] Ω) : SSGRoute.IsSplitIn k Λ (g • B) :=
  (isSplitIn_conj Λ (IsGalois.fixingSubgroup_normal_of_isGalois Λ) B g).mpr h

/-- Being outside the conjugacy classes of `S` is preserved by conjugation. -/
lemma not_isConjPlace_smul {A B : ValuationSubring Ω}
    (h : ¬ SSGRoute.IsConjPlace k A B) (g : Ω ≃ₐ[k] Ω) :
    ¬ SSGRoute.IsConjPlace k A (g • B) := by
  rintro ⟨σ, hσ⟩
  exact h ⟨g⁻¹ * σ, by rw [mul_smul, hσ, inv_smul_smul]⟩

/-- The conjugate of an element of a decomposition group lies in the decomposition group of the
conjugate place. -/
lemma conj_mem_decomp_smul (B : ValuationSubring Ω) (g δ : Ω ≃ₐ[k] Ω)
    (hδ : δ ∈ SSGRoute.decomp k B) : g⁻¹ * δ * g ∈ SSGRoute.decomp k (g⁻¹ • B) := by
  refine MulAction.mem_stabilizer_iff.mpr ?_
  have h1 : δ • B = B := MulAction.mem_stabilizer_iff.mp hδ
  calc (g⁻¹ * δ * g) • (g⁻¹ • B) = g⁻¹ • (δ • (g • (g⁻¹ • B))) := by rw [mul_smul, mul_smul]
    _ = g⁻¹ • (δ • B) := by rw [smul_inv_smul]
    _ = g⁻¹ • B := by rw [h1]

/-- **The sixth conjunct at a junk place from the junk local data lying in a stable line.**  If the
values of the cochain `z` on the decomposition groups (intersected with `G_K`) of the junk places lie
in the `Gal(K|k)`-stable line `⟨v⟩`, then the transfer of `z` on the decomposition group of a junk
place takes its values in `⟨v⟩`, hence has cyclic image. -/
lemma exists_V_of_transfer_of_junkData_line
    {Λ : IntermediateField k Ω} [FiniteDimensional k Λ] [IsGalois k Λ] (hKΛ : K ≤ Λ)
    (S : Finset (ValuationSubring Ω)) (z : (Ω ≃ₐ[k] Ω) → E)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzloc : SSGRoute.IsLocConstOn K.fixingSubgroup z)
    {v : E} (hstable : ∀ s : K ≃ₐ[k] K, s • v ∈ AddSubgroup.zmultiples v)
    (hval : ∀ Q : ValuationSubring Ω, SSGRoute.IsFinPlace k Q →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A Q) → SSGRoute.IsSplitIn k Λ Q →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k Q → z σ ∈ AddSubgroup.zmultiples v)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hnotconj : ∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) (hsplitΛ : SSGRoute.IsSplitIn k Λ B) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, Work.SSGRoute.transfer z sec δ = 0) := by
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  have hmem : ∀ δ ∈ SSGRoute.decomp k B, transfer z sec δ ∈ AddSubgroup.zmultiples v := by
    intro δ hδ
    unfold transfer
    refine AddSubgroup.sum_mem (AddSubgroup.zmultiples v) (t := Finset.univ)
      (f := fun s : K ≃ₐ[k] K => s • z ((sec s)⁻¹ * δ * sec s)) (fun s _ => ?_)
    refine smul_mem_zmultiples_of_stable hstable s ?_
    have hfin' : SSGRoute.IsFinPlace k ((sec s)⁻¹ • B) := (isFinPlace_smul_iff B (sec s)⁻¹).mpr hB
    refine hval ((sec s)⁻¹ • B) hfin' ?_ ?_ _ (conj_sec_mem_fixingSubgroup hsec s (hsplitK hδ))
      (conj_mem_decomp_smul B (sec s) δ hδ)
    · exact fun A hA => not_isConjPlace_smul (hnotconj A hA) ((sec s)⁻¹)
    · exact isSplitIn_smul_of_isSplitIn hsplitΛ ((sec s)⁻¹)
  have hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g) :=
    exists_zmultiples_generator (D := SSGRoute.decomp k B) (X := transfer z sec) (v := v)
      (fun a ha b hb => transfer_mul_mem hsec hzadd (hsplitK ha) (hsplitK hb)) hmem
  obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
    exists_V_of_cyclic_transfer hsec hzadd hzloc B hsplitK hcyc
  exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩

end JunkLine

/-! ## Part 3: the vanishing-on-`cs(S)` regime -/

/-- **`Work.SSGRoute.shafarevich_z_construction` when the datum vanishes on the local groups of the
places of `cs(S)`.**  The cochain `z := 0` then satisfies all six conjuncts: conjunct 3 is the
hypothesis, and conjunct 6 holds with `V = ⊤` because the transfer vanishes identically. -/
theorem shafarevich_z_construction_of_zeroOnCs (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (h0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  refine ⟨fun _ => 0, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro g hg h hh
    simp
  · refine ⟨⊤, isOpen_univ, ?_⟩
    intro g hg u hu huK
    simp
  · intro B hB hconj σ hσ hσd
    exact (h0 B hB hconj σ hσ hσd).symm
  · intro c hc hc2
    rfl
  · intro B hB hconj hnsplit σ hσ hI
    rfl
  · intro B hB hconj hsplit
    refine ⟨⊤, isOpen_univ, ?_, ?_, ?_⟩
    · intro δ hδ u hu
      simp
    · refine ⟨1, (SSGRoute.decomp k B).one_mem, fun δ hδ => ⟨(0 : ℤ), ?_⟩⟩
      simp
    · intro δ hδ
      simp

/-- **`Work.SSGRoute.shafarevich_z_construction` when no place of `cs(S)` is both split in `K` and
away from `p`.**

This is the sharp corollary of `shafarevich_z_construction_of_zeroOnCs` via the node's hypothesis
`hy0`: the disjunction `¬ IsSplitIn k K B ∨ B.valuation (p:Ω) < 1` is exactly the trigger of `hy0`,
and under the hypothesis `hres` below it holds at *every* place conjugate into `S`.  Hence the datum
vanishes there and `z := 0` witnesses the conclusion.

Equivalently: a place `B` conjugate into `S` at which `y` can fail to vanish must be **split in `K`
and away from `p`** (`¬ B.valuation (p:Ω) < 1`); this theorem records that the node is otherwise
free. -/
theorem shafarevich_z_construction_of_noResidualPlace (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hres : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1))
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) :=
  shafarevich_z_construction_of_zeroOnCs p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram y
    (fun B hB hconj σ hσ hσd => hy0 B hB hconj (hres B hB hconj) σ hσ hσd) sec hsec

end Work.SSGRoute.ZConstruction
