/-!
# The `∃ V` clause of `shafarevich_z_construction` from the inertia-killing of the transfer

Let `k` be a number field, `Ω` an algebraic closure, `K ⊆ Ω` a finite Galois subextension,
`E` a finite `𝔽_p`-module with an action of `Gal(K/k)`, `z : G_k → E` a cochain additive and
locally constant on `G_K = K.fixingSubgroup`, and `B` a finite place of `Ω` split in `K`.  Write

  `X δ = transfer z sec δ = ∑_{s : Gal(K/k)} s • z ((sec s)⁻¹ * δ * sec s)`

for the transfer of `z` along a section `sec` of `res k K : G_k →* Gal(K/k)`.

The last clause of `Work.SSGRoute.shafarevich_z_construction` at `B` asks for an open subgroup
`V ≤ G_k` with `decomp k B ⊓ V` normalised by `decomp k B`, `decomp k B / (decomp k B ⊓ V)`
generated by one element, and `X` vanishing on `decomp k B ⊓ V`.  By
`Work.SSGRoute.exists_V_of_cyclic_transfer` this is *equivalent* to the cyclicity of the image
`X (decomp k B)`.

`Work.SSGRoute.transfer_vanishes_of_unramified`
(`Submission/Work/SSGRoute/exists_cyclic_quotient_subgroup_of_cyclic_image.lean`) proves the clause
under the hypothesis that `z` vanishes on the inertia of *every* `G_k`-conjugate of `B`.  The present
file proves it under the strictly weaker hypothesis

> `X` itself vanishes on the inertia of `B`:  `∀ σ ∈ decomp k B, IsInertia k B σ → X σ = 0`.

The proof is the same one: the transfer agrees with the corestriction cocycle
`corCocycle k Ω K E z sec` on `G_K`, which is a locally constant `1`-cocycle on all of `G_k`; the
hypothesis says it kills the inertia of `B`, so
`Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing` produces a subgroup
`U = V ⊓ decomp k B` (`V` open in `G_k`), normal in `decomp k B`, with cyclic quotient, on which the
corestriction — hence the transfer — vanishes.  Since `B` is split in `K`, `decomp k B ≤ G_K`, so the
vanishing transfers back from `corCocycle` to `transfer`.

The strengthening matters because "`z` is unramified at all conjugates of `B`" constrains the *local
components* of `z` separately at every conjugate of `B`, while "`X` kills the inertia of `B`" only
constrains their *sum*: in the situation of Schmidt--Wingberg's §4, in which one conjugate of `B`
carries a non-trivial cyclic local component and all the others are killed, only the second condition
holds — it is exactly what their condition (b) is used to verify in
`Work.SSGRoute.shafarevich_theorem13_of_z_conjugate_vanishing`.
-/

namespace Work.SSGRoute.ZConstruction

open _root_.SSGRoute

open scoped Pointwise

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

/-- **The `∃ V` clause at a finite place split in `K`, from the inertia-killing of the transfer.**

If the transfer `X = transfer z sec` kills the inertia of the finite place `B` (and `B` is split in
`K`, so that `decomp k B ≤ K.fixingSubgroup`), then there is an open subgroup `V ≤ G_k` with
`decomp k B ⊓ V` normalised by `decomp k B`, `decomp k B / (decomp k B ⊓ V)` generated by one
element, and `X` vanishing on `decomp k B ⊓ V`. -/
theorem exists_V_of_transfer_inertia_vanishing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (z : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzloc : SSGRoute.IsLocConstOn K.fixingSubgroup z)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B) (hsplitK : SSGRoute.IsSplitIn k K B)
    (hIvan : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ SSGRoute.decomp k B → SSGRoute.IsInertia k B σ →
      Work.SSGRoute.transfer z sec σ = 0) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, Work.SSGRoute.transfer z sec δ = 0) := by
  classical
  -- the transfer is the corestriction cocycle on `G_K`
  have htransfer : ∀ δ ∈ K.fixingSubgroup, Work.SSGRoute.transfer z sec δ =
      corCocycle k Ω K E z sec δ := by
    intro δ hδ
    rw [corCocycle_restrict k Ω K E z sec δ hδ]
    rfl
  -- the corestriction cocycle kills the inertia of `B`
  have hI : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → corCocycle k Ω K E z sec σ = 0 := by
    intro σ hσ
    have hσK : σ ∈ K.fixingSubgroup := hsplitK hσ.1
    rw [← htransfer σ hσK]
    exact hIvan σ hσ.1 hσ
  obtain ⟨U, ⟨V, hVopen, hUV⟩, hUnorm, hUcyc, hcob⟩ :=
    exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E z sec)
      (corCocycle_isCocycle k Ω K E z hzadd sec hsec)
      (corCocycle_isLocConstOn k Ω K E z hzloc sec hsec) B hB hI
      (decomp_mod_inertia_cyclic k Ω B hB)
  -- elements of `U` are fixed by `res k K`, hence the cocycle vanishes on `U`
  have hUle : U ≤ K.fixingSubgroup := by
    intro u hu
    rw [hUV] at hu
    exact hsplitK (Subgroup.mem_inf.mp hu).2
  have hxU : ∀ u ∈ U, corCocycle k Ω K E z sec u = 0 := by
    obtain ⟨m₀, hm₀⟩ := hcob
    intro u hu
    rw [hm₀ u hu, (mem_fixingSubgroup_iff_res_eq_one k Ω K u).mpr (hUle hu), one_smul, sub_self]
  refine ⟨V, hVopen, ?_, ?_, ?_⟩
  · -- normality, in the `V`-form
    intro δ hδ u hu
    have hmem : δ * u * δ⁻¹ ∈ U :=
      hUnorm δ hδ u (by rw [hUV]; exact Subgroup.mem_inf.mpr ⟨hu.2, hu.1⟩)
    rw [hUV] at hmem
    exact (Subgroup.mem_inf.mp hmem).1
  · -- the quotient condition, in the `V`-form
    obtain ⟨g, hg, hgU⟩ := hUcyc
    refine ⟨g, hg, fun δ hδ => ?_⟩
    obtain ⟨m, hm⟩ := hgU δ hδ
    refine ⟨m, ?_⟩
    rw [hUV] at hm
    exact (Subgroup.mem_inf.mp hm).1
  · -- vanishing of the transfer
    intro δ hδ
    have hδU : δ ∈ U := by rw [hUV]; exact Subgroup.mem_inf.mpr ⟨hδ.2, hδ.1⟩
    have hδK : δ ∈ K.fixingSubgroup := hsplitK hδ.1
    rw [htransfer δ hδK]
    exact hxU δ hδU

/-- **The `∃ V` clause at a finite place split in `K`, from the cyclicity of the transfer on an open
subgroup.**

The hypothesis is the normal form of the sixth conjunct obtained from the fact that `decomp k B`
modulo an open subgroup `V` containing the inertia is cyclic (`Work.SSGRoute.decomp_mod_inertia_cyclic`
provides `V` and the generator `g` for every open subgroup containing the inertia):

* `V` is an open subgroup of `G_k`, `g ∈ decomp k B`, the quotient `decomp k B / (decomp k B ⊓ V)`
  is generated by `g` (condition `hgen`), and
* the transfer of `z` on `decomp k B ⊓ V` takes values in the subgroup generated by
  `transfer z sec g` (condition `hline`).

Then the image of the transfer on `decomp k B` is contained in the cyclic subgroup generated by
`transfer z sec g`, so the sixth conjunct holds.

This *strictly* generalises `exists_V_of_transfer_inertia_vanishing`: if the transfer kills the
inertia of `B`, take for `V` the subgroup generated by the inertia and an open subgroup on which the
transfer vanishes (which exists by local constancy, as in the proof of that lemma); then the transfer
vanishes on `decomp k B ⊓ V`, so `hline` holds trivially.  It also covers the case in which the
transfer is ramified at `B` but its ramification is *aligned* with a generator — which is the
situation of Schmidt--Wingberg's condition (b), where all the contributions but one vanish and the
surviving one generates a cyclic local image. -/
theorem exists_V_of_transfer_line_cyclic
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (z : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzloc : SSGRoute.IsLocConstOn K.fixingSubgroup z)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B) (hsplitK : SSGRoute.IsSplitIn k K B)
    (halt : ∃ (V : Subgroup (Ω ≃ₐ[k] Ω)), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      ∃ g ∈ SSGRoute.decomp k B,
        (∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
        (∀ u ∈ SSGRoute.decomp k B ⊓ V,
          Work.SSGRoute.transfer z sec u ∈ AddSubgroup.zmultiples (Work.SSGRoute.transfer z sec g))) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, Work.SSGRoute.transfer z sec δ = 0) := by
  obtain ⟨V, _hVopen, g, hg, hgen, hline⟩ := halt
  have hhom : ∀ a ∈ SSGRoute.decomp k B, ∀ b ∈ SSGRoute.decomp k B,
      Work.SSGRoute.transfer z sec (a * b) =
        Work.SSGRoute.transfer z sec a + Work.SSGRoute.transfer z sec b :=
    fun a ha b hb => transfer_mul_mem hsec hzadd (hsplitK ha) (hsplitK hb)
  refine exists_V_of_cyclic_transfer hsec hzadd hzloc B hsplitK ⟨g, hg, fun δ hδ => ?_⟩
  obtain ⟨m, hm⟩ := hgen δ hδ
  have hmem : δ⁻¹ * g ^ m ∈ SSGRoute.decomp k B ⊓ V :=
    Subgroup.mem_inf.mpr ⟨mul_mem (inv_mem hδ) (zpow_mem hg m), hm⟩
  have h1 := hline _ hmem
  rw [X_mul hhom (δ⁻¹) (g ^ m) (inv_mem hδ) (zpow_mem hg m), X_inv hhom δ hδ,
    X_zpow hhom g hg m] at h1
  obtain ⟨c, hc⟩ := AddSubgroup.mem_zmultiples_iff.mp h1
  have h3 : (m - c) • Work.SSGRoute.transfer z sec g = Work.SSGRoute.transfer z sec δ := by
    rw [sub_zsmul]
    rw [← hc.symm]
    abel
  exact AddSubgroup.mem_zmultiples_iff.mpr ⟨m - c, h3⟩

end Work.SSGRoute.ZConstruction
