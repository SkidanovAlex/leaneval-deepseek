/-!
# Auxiliary lemmas for `Work.SSGRoute.shafarevich_z_construction`

This file isolates two pieces of the proof of Shafarevich's Theorem 13 in the "`z`-form"
(`Work.SSGRoute.shafarevich_z_construction`):

* the **group-theoretic encoding of local cyclicity** (`exists_open_subgroup_cyclic_transfer`):
  if a transfer map `X` is additive on a subgroup `D` and its image on `D` is cyclic, then there is
  an open subgroup `V` with `D ⊓ V` normal in `D`, `D/(D ⊓ V)` cyclic generated by one element,
  and `X` vanishing on `D ⊓ V`.  This is exactly the "cyclicity" conjunct of the theorem, whose
  shape is `∃ V, IsOpen V ∧ (…normalising…) ∧ (…cyclic quotient…) ∧ (…vanishing…)`.

* the **`𝔽_p`-line case** of the theorem: when every nonzero element of `E` generates `E`
  additively (equivalently `E ≅ 𝔽_p`, the case `A = μ_p` of Schmidt–Wingberg §4, where "the
  cyclicity condition is trivially satisfied"), the constant cochain `z := y` (extended by `0`
  outside `G_K`) satisfies every conjunct.

The general case (`E` of arbitrary `𝔽_p`-dimension) is the arithmetic content of Schmidt–Wingberg
§4 and is not proved here.
-/

open scoped Pointwise TensorProduct

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

/-- **The trivial action of `Gal(K|k)` on the coefficient module `ZMod p`.**

For `ζ_p ∈ K` the `Gal(K|k)`-module `μ_p ⊆ K` is trivial, and this is the coefficient action under
which the workspace's `IsCocycleOn` reduces to additivity; every statement of the `z`-construction
that mentions `ZMod p` coefficients carries this instance as a (usually implicit) argument.

It is declared here so that it is available in the import cone of the `OddGate/` frozen copies of the
odd-`p` lane (`ZConstruction/OddGate/`), which lost it when
`ZDataMup/KummerSurjectivity/kummerCharZMod_surjective_levelK.lean` was rewritten without it (see
`PING_oddGate_copies_broken_by_missing_trivial_action.md` at the workspace root).  The same pair of
instances is declared in `ZConstruction/AuxExistsAssembly.lean`; the two are definitionally equal, so
their coexistence changes no type. -/
instance instDistribMulActionZModTrivial {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω] (p : ℕ)
    (K : IntermediateField k Ω) : DistribMulAction (K ≃ₐ[k] K) (ZMod p) where
  smul := fun _ x => x
  one_smul := fun _ => rfl
  mul_smul := fun _ _ _ => rfl
  smul_zero := fun _ => rfl
  smul_add := fun _ _ _ => rfl

/-- The matching compatibility with the `ZMod p`-module structure (see
`instDistribMulActionZModTrivial`). -/
instance instSMulCommClassZModTrivial {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω] (p : ℕ)
    (K : IntermediateField k Ω) : SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p) where
  smul_comm := fun _ _ _ => rfl

namespace Work.SSGRoute

open _root_.SSGRoute

/-! ## Part 1: the `∃ V` encoding of cyclicity (abstract) -/

section Abstract

variable {Γ E : Type} [Group Γ] [AddCommGroup E]
variable {D : Subgroup Γ} {X : Γ → E}

/-- The subgroup `{γ ∈ D : X γ = 0}`, for a map `X` which is additive on `D`. -/
def kerOn (D : Subgroup Γ) (X : Γ → E) (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) :
    Subgroup Γ where
  carrier := {γ | γ ∈ D ∧ X γ = 0}
  one_mem' := by
    refine ⟨D.one_mem, ?_⟩
    have h : X 1 = X 1 + X 1 := by simpa [mul_one] using hhom 1 D.one_mem 1 D.one_mem
    have h2 : X 1 + 0 = X 1 + X 1 := by rw [add_zero]; exact h
    exact (add_left_cancel h2).symm
  mul_mem' := by
    rintro a b ⟨ha, hxa⟩ ⟨hb, hxb⟩
    refine ⟨D.mul_mem ha hb, ?_⟩
    rw [hhom a ha b hb, hxa, hxb, zero_add]
  inv_mem' := by
    rintro a ⟨ha, hxa⟩
    refine ⟨D.inv_mem ha, ?_⟩
    have h1 : X 1 = 0 := by
      have h : X 1 = X 1 + X 1 := by simpa [mul_one] using hhom 1 D.one_mem 1 D.one_mem
      have h2 : X 1 + 0 = X 1 + X 1 := by rw [add_zero]; exact h
      exact (add_left_cancel h2).symm
    have h := hhom a ha a⁻¹ (D.inv_mem ha)
    rw [mul_inv_cancel, hxa, zero_add] at h
    rw [h1] at h
    exact h.symm

lemma X_one (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) : X 1 = 0 := by
  have h : X 1 = X 1 + X 1 := by simpa [mul_one] using hhom 1 D.one_mem 1 D.one_mem
  have h2 : X 1 + 0 = X 1 + X 1 := by rw [add_zero]; exact h
  exact (add_left_cancel h2).symm

lemma X_mul (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) (a b : Γ) (ha : a ∈ D) (hb : b ∈ D) :
    X (a * b) = X a + X b := hhom a ha b hb

lemma X_inv (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) (a : Γ) (ha : a ∈ D) :
    X a⁻¹ = - X a := by
  have h := hhom a ha a⁻¹ (D.inv_mem ha)
  rw [mul_inv_cancel, X_one hhom] at h
  exact eq_neg_of_add_eq_zero_right h.symm

lemma X_pow (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) (g : Γ) (hg : g ∈ D) (n : ℕ) :
    X (g ^ n) = (n : ℤ) • X g := by
  induction n with
  | zero => simpa using X_one hhom
  | succ n ih =>
      rw [pow_succ, X_mul hhom _ _ (Subgroup.pow_mem D hg n) hg, ih, Nat.cast_succ, add_smul,
        one_smul]

lemma X_zpow (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b) (g : Γ) (hg : g ∈ D) (m : ℤ) :
    X (g ^ m) = m • X g := by
  cases m with
  | ofNat n => simpa using X_pow hhom g hg n
  | negSucc n =>
      rw [zpow_negSucc, X_inv hhom _ (Subgroup.pow_mem D hg (n + 1)), X_pow hhom g hg (n + 1),
        Int.negSucc_eq, neg_zsmul, Nat.cast_succ]

variable [TopologicalSpace Γ] [SeparatelyContinuousMul Γ]

/-- **The `∃ V` encoding of cyclicity.**  Let `X : Γ → E` be additive on a subgroup `D ≤ Γ`, and
suppose that `X` vanishes on `D ⊓ U` for some normal open subgroup `U`, and that the image of `X`
on `D` is cyclic (generated by the value `X g`, `g ∈ D`).  Then there is an open subgroup `V ≤ Γ`
such that `D ⊓ V` is normalised by `D` (indeed `D ⊓ V = D ⊓ U·H` is normal in `D`), the quotient
`D/(D ⊓ V)` is cyclic generated by the image of `g`, and `X` vanishes on `D ⊓ V`.  This is the
"local cyclicity" conjunct of `shafarevich_z_construction`. -/
theorem exists_open_subgroup_cyclic_transfer
    (D : Subgroup Γ) (X : Γ → E)
    (hhom : ∀ a ∈ D, ∀ b ∈ D, X (a * b) = X a + X b)
    (hU : ∃ U : Subgroup Γ, IsOpen (U : Set Γ) ∧ U.Normal ∧ ∀ u ∈ U, u ∈ D → X u = 0)
    (hcyc : ∃ g ∈ D, ∀ δ ∈ D, X δ ∈ AddSubgroup.zmultiples (X g)) :
    ∃ V : Subgroup Γ, IsOpen (V : Set Γ) ∧
      (∀ δ ∈ D, ∀ u ∈ D ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ D, ∀ δ ∈ D, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      ∀ δ ∈ D ⊓ V, X δ = 0 := by
  obtain ⟨U, hUopen, hUnorm, hUvan⟩ := hU
  haveI := hUnorm
  obtain ⟨g, hgD, hgcyc⟩ := hcyc
  have hkey : (D ⊓ (kerOn D X hhom ⊔ U) : Subgroup Γ) ≤ kerOn D X hhom := by
    intro x hx
    obtain ⟨hxD, hxHU⟩ := Subgroup.mem_inf.mp hx
    have hxHU' : x ∈ ((kerOn D X hhom ⊔ U : Subgroup Γ) : Set Γ) := hxHU
    rw [Subgroup.mul_normal (kerOn D X hhom) U] at hxHU'
    obtain ⟨h, hh, u, hu, hhu⟩ := Set.mem_mul.mp hxHU'
    have hhD : h ∈ D := hh.1
    have huD : u ∈ D := by
      have hmem : h⁻¹ * x ∈ D := D.mul_mem (D.inv_mem hhD) hxD
      rw [← hhu] at hmem
      simpa using hmem
    have huH : u ∈ kerOn D X hhom := ⟨huD, hUvan u hu huD⟩
    rw [← hhu]
    exact (kerOn D X hhom).mul_mem hh huH
  refine ⟨kerOn D X hhom ⊔ U, Subgroup.isOpen_mono le_sup_right hUopen, ?_, ?_, ?_⟩
  · intro δ hδ u hu
    have huH : u ∈ kerOn D X hhom := hkey hu
    refine Subgroup.mem_sup_left ?_
    refine ⟨D.mul_mem (D.mul_mem hδ huH.1) (D.inv_mem hδ), ?_⟩
    rw [show δ * u * δ⁻¹ = δ * (u * δ⁻¹) from by group]
    rw [X_mul hhom _ _ hδ (D.mul_mem huH.1 (D.inv_mem hδ)),
      X_mul hhom _ _ huH.1 (D.inv_mem hδ), X_inv hhom δ hδ, huH.2]
    abel
  · refine ⟨g, hgD, fun δ hδ => ?_⟩
    obtain ⟨m, hm⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgcyc δ hδ)
    refine ⟨m, Subgroup.mem_sup_left ?_⟩
    refine ⟨D.mul_mem (D.inv_mem hδ) (Subgroup.zpow_mem D hgD m), ?_⟩
    rw [X_mul hhom _ _ (D.inv_mem hδ) (Subgroup.zpow_mem D hgD m), X_inv hhom δ hδ,
      X_zpow hhom g hgD m, hm]
    abel
  · intro δ hδ
    exact (hkey hδ).2

end Abstract

/-! ## Part 2: the transfer attached to a cochain on `G_K` -/

section Transfer

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
  {K : IntermediateField k Ω} {E : Type} [AddCommGroup E] [Module (ZMod p) E]
  [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

variable [Fintype (K ≃ₐ[k] K)]

/-- The transfer (formal corestriction) of a cochain `z` along a section `sec` of `res k K`:
`X δ = ∑_{s : Gal(K/k)} s • z ((sec s)⁻¹ δ sec s)`. -/
noncomputable def transfer (z : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (δ : Ω ≃ₐ[k] Ω) : E :=
  ∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)

variable [FiniteDimensional k K] [Normal k K]

/-- The restriction to `K` is trivial exactly on the fixing subgroup. -/
lemma res_eq_one_iff_mem_fixingSubgroup (σ : Ω ≃ₐ[k] Ω) :
    SSGRoute.res k K σ = 1 ↔ σ ∈ K.fixingSubgroup := by
  rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker K]

variable {z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}
  (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)

include hsec

/-- Conjugation by `sec s` preserves the fixing subgroup of the normal field `K`. -/
lemma conj_sec_mem_fixingSubgroup (s : K ≃ₐ[k] K) {δ : Ω ≃ₐ[k] Ω}
    (hδ : δ ∈ K.fixingSubgroup) : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
  rw [← res_eq_one_iff_mem_fixingSubgroup]
  rw [map_mul, map_mul, map_inv, hsec s, (res_eq_one_iff_mem_fixingSubgroup (K := K) δ).mpr hδ]
  simp

end Transfer

/-! ## Part 3: the transfer of a cochain additive on `G_K` -/

section TransferHom

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω]
  {K : IntermediateField k Ω} {E : Type} [AddCommGroup E] [Module (ZMod p) E]
  [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
  [FiniteDimensional k K] [Normal k K] [Fintype (K ≃ₐ[k] K)]
  {z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}

/-- A cochain which is additive on `G_K` vanishes at `1`. -/
lemma z_one (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h) :
    z 1 = 0 := by
  have h : z (1 * 1) = z 1 + z 1 := hz 1 K.fixingSubgroup.one_mem 1 K.fixingSubgroup.one_mem
  rw [mul_one] at h
  have h2 : z 1 + 0 = z 1 + z 1 := by rw [add_zero]; exact h
  exact (add_left_cancel h2).symm

/-- The transfer of a cochain additive on `G_K` is additive on `G_K`. -/
lemma transfer_mul_mem (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {a b : Ω ≃ₐ[k] Ω} (ha : a ∈ K.fixingSubgroup) (hb : b ∈ K.fixingSubgroup) :
    transfer z sec (a * b) = transfer z sec a + transfer z sec b := by
  unfold transfer
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun s _ => ?_
  have hmul : (sec s)⁻¹ * (a * b) * sec s
      = ((sec s)⁻¹ * a * sec s) * ((sec s)⁻¹ * b * sec s) := by group
  rw [hmul, hz _ (conj_sec_mem_fixingSubgroup hsec s ha) _
      (conj_sec_mem_fixingSubgroup hsec s hb), smul_add]

/-- **The transfer vanishes on a normal open subgroup, intersected with any subgroup of `G_K`.** -/
lemma exists_normal_open_subgroup_transfer_eq_zero
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzc : SSGRoute.IsLocConstOn K.fixingSubgroup z)
    (D : Subgroup (Ω ≃ₐ[k] Ω)) (hD : D ≤ K.fixingSubgroup) :
    ∃ U : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (U : Set (Ω ≃ₐ[k] Ω)) ∧ U.Normal ∧
      ∀ u ∈ U, u ∈ D → transfer z sec u = 0 := by
  obtain ⟨U₀, hU₀open, hU₀c⟩ := hzc
  obtain ⟨F, _hFfin, _hFnorm, hFle⟩ :=
    exists_finiteDimensional_normal_fixingSubgroup_le (U := k) (L := Ω) U₀ hU₀open
  haveI : Algebra.IsSeparable k F := inferInstance
  haveI : IsGalois k F := IsGalois.mk
  have hFnormal : (F.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)).Normal :=
    IsGalois.fixingSubgroup_normal_of_isGalois F
  refine ⟨F.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen F, hFnormal, ?_⟩
  intro u hu huD
  have hval : ∀ s : K ≃ₐ[k] K, z ((sec s)⁻¹ * u * sec s) = 0 := by
    intro s
    have hmemF : (sec s)⁻¹ * u * sec s ∈ F.fixingSubgroup := by
      have h := hFnormal.conj_mem u hu ((sec s)⁻¹)
      simpa using h
    have hmemK : (sec s)⁻¹ * u * sec s ∈ K.fixingSubgroup :=
      conj_sec_mem_fixingSubgroup hsec s (hD huD)
    have h := hU₀c 1 K.fixingSubgroup.one_mem ((sec s)⁻¹ * u * sec s) (hFle hmemF) hmemK
    rw [one_mul] at h
    rw [h, z_one hz]
  unfold transfer
  exact Finset.sum_eq_zero fun s _ => by rw [hval s, smul_zero]

/-- **The last conjunct of `shafarevich_z_construction` from cyclicity of the transfer.** -/
theorem exists_V_of_cyclic_transfer
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzc : SSGRoute.IsLocConstOn K.fixingSubgroup z)
    (B : ValuationSubring Ω) (hsplitK : SSGRoute.IsSplitIn k K B)
    (hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g)) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0) := by
  obtain ⟨U, hUo, hUn, hUv⟩ :=
    exists_normal_open_subgroup_transfer_eq_zero hsec hz hzc (SSGRoute.decomp k B) hsplitK
  exact exists_open_subgroup_cyclic_transfer (SSGRoute.decomp k B) (transfer z sec)
    (fun a ha b hb => transfer_mul_mem hsec hz (hsplitK ha) (hsplitK hb))
    ⟨U, hUo, hUn, hUv⟩ hcyc

/-- **Converse direction**: if the `∃ V` conditions of the last conjunct of
`shafarevich_z_construction` hold at a place `B` split in `K`, then the image of the transfer on the
decomposition group of `B` is cyclic.  Together with `exists_V_of_cyclic_transfer` this shows that
the last conjunct of the theorem is *equivalent* to the cyclicity of `transfer z sec` on
`decomp k B` (a form in which the hypothesis can be attacked by the arithmetic of
Schmidt--Wingberg §4). -/
theorem isCyclic_transfer_of_exists_V
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (B : ValuationSubring Ω) (hsplitK : SSGRoute.IsSplitIn k K B)
    (hV : ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0)) :
    ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g) := by
  obtain ⟨V, _hVo, _hVnorm, hC, hVv⟩ := hV
  obtain ⟨g, hg, hVg⟩ := hC
  have hhom : ∀ a ∈ SSGRoute.decomp k B, ∀ b ∈ SSGRoute.decomp k B,
      transfer z sec (a * b) = transfer z sec a + transfer z sec b :=
    fun a ha b hb => transfer_mul_mem hsec hz (hsplitK ha) (hsplitK hb)
  refine ⟨g, hg, fun δ hδ => ?_⟩
  obtain ⟨m, hm⟩ := hVg δ hδ
  have hmem : δ⁻¹ * g ^ m ∈ SSGRoute.decomp k B ⊓ V :=
    Subgroup.mem_inf.mpr ⟨(SSGRoute.decomp k B).mul_mem ((SSGRoute.decomp k B).inv_mem hδ)
      (Subgroup.zpow_mem (SSGRoute.decomp k B) hg m), hm⟩
  have hzero : transfer z sec (δ⁻¹ * g ^ m) = 0 := hVv _ hmem
  rw [X_mul hhom _ _ ((SSGRoute.decomp k B).inv_mem hδ)
      (Subgroup.zpow_mem (SSGRoute.decomp k B) hg m), X_inv hhom δ hδ,
      X_zpow hhom g hg m] at hzero
  refine AddSubgroup.mem_zmultiples_iff.mpr ⟨m, ?_⟩
  have h2 : -transfer z sec δ + m • transfer z sec g
      = -transfer z sec δ + transfer z sec δ := by
    rw [hzero, neg_add_cancel]
  exact add_left_cancel h2

end TransferHom

/-! ## Part 4: the one-dimensional coefficient case (`A = μ_p`), where cyclicity is free -/

section IsLine

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k]
  [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]


/-- Every non-zero element of a `𝔽_p`-module of `𝔽_p`-dimension `≤ 1` generates it additively: a
`1`-dimensional `𝔽_p`-vector space has no non-cyclic subgroups, so the hypothesis `hE` of
`shafarevich_z_construction_of_isLine` holds. -/
lemma zmultiples_eq_top_of_finrank_le_one {p : ℕ} [Fact p.Prime] {E : Type} [AddCommGroup E]
    [Module (ZMod p) E] [Finite E] (h1 : Module.finrank (ZMod p) E ≤ 1) {x : E} (hx : x ≠ 0) :
    ∀ y : E, y ∈ AddSubgroup.zmultiples x := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hspan : (ZMod p) ∙ x = ⊤ := by
    refine Submodule.eq_top_of_finrank_eq ?_
    rw [finrank_span_singleton hx]
    have hpos : 0 < Module.finrank (ZMod p) E := by
      rw [Module.finrank_pos_iff]
      exact ⟨x, 0, hx⟩
    omega
  intro y
  have hy : y ∈ (ZMod p) ∙ x := by rw [hspan]; exact Submodule.mem_top
  rw [Submodule.mem_span_singleton] at hy
  obtain ⟨c, hc⟩ := hy
  have hcv : ((c.val : ℤ) : ZMod p) = c := by
    rw [Int.cast_natCast, ZMod.natCast_zmod_val]
  refine AddSubgroup.mem_zmultiples_iff.mpr ⟨(c.val : ℤ), ?_⟩
  rw [← Int.cast_smul_eq_zsmul (R := ZMod p) (c.val : ℤ) x, hcv, hc]

/-- **Shafarevich's Theorem 13, `z`-form, for a one-dimensional coefficient module.**

If every non-zero element of `E` generates `E` additively (the case `E ≅ 𝔽_p`, i.e. `A = μ_p` in
Schmidt--Wingberg §4, where the cyclicity condition is trivially satisfied), then the cochain
`z := y` (extended by `0` outside `G_K`) satisfies every conjunct: conjuncts 1, 2, 4, 5 are the
hypotheses `hy`, `hyc`, `hyinf`, `hyS`, conjunct 3 is the definition of `z` on `G_K`, and conjunct
6 holds because the transfer takes values in the additive subgroups of `E`, all of which are
cyclic. -/
theorem shafarevich_z_construction_of_isLine (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (hE : ∀ x y : E, x ≠ 0 → y ∈ AddSubgroup.zmultiples x)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  classical
  let z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ else 0
  have hzy : ∀ σ, σ ∈ K.fixingSubgroup → z σ = y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ else 0) = y σ
    rw [if_pos hσ]
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hzy (g * h) (K.fixingSubgroup.mul_mem hg hh), hzy g hg, hzy h hh, hy g hg h hh]
  have hzloc : SSGRoute.IsLocConstOn K.fixingSubgroup z := by
    obtain ⟨U, hUopen, hUc⟩ := hyc
    refine ⟨U, hUopen, ?_⟩
    intro g hg u hu huH
    rw [hzy (g * u) (K.fixingSubgroup.mul_mem hg huH), hzy g hg]
    exact hUc g hg u hu huH
  refine ⟨z, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro g hg h hh
    rw [hzadd g hg h hh, (res_eq_one_iff_mem_fixingSubgroup (K := K) g).mpr hg, one_smul]
  · exact hzloc
  · intro B hB hconj σ hσ _
    exact hzy σ hσ
  · intro c hc hc2
    rw [hzy c hc]
    exact hyinf c hc hc2
  · intro B hB hconj hnsplit σ hσ hI
    rw [hzy σ hσ]
    exact hyS B hB hconj hnsplit σ hσ hI
  · intro B hB hconj hsplitΛ
    have hsplitK : SSGRoute.IsSplitIn k K B :=
      le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
    have hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer z sec δ ∈ AddSubgroup.zmultiples (transfer z sec g) := by
      by_cases hex : ∃ g ∈ SSGRoute.decomp k B, transfer z sec g ≠ 0
      · obtain ⟨g, hg, hgne⟩ := hex
        exact ⟨g, hg, fun δ hδ => hE _ _ hgne⟩
      · push_neg at hex
        exact ⟨1, (SSGRoute.decomp k B).one_mem, fun δ hδ => by
          rw [hex δ hδ, hex 1 (SSGRoute.decomp k B).one_mem]
          exact AddSubgroup.zero_mem _⟩
    obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
      exists_V_of_cyclic_transfer hsec hzadd hzloc B hsplitK hcyc
    exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩

theorem shafarevich_z_construction_of_finrank_le_one (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (h1 : Module.finrank (ZMod p) E ≤ 1)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup z ∧
      SSGRoute.IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ SSGRoute.decomp k B ⊓ V, (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  exact shafarevich_z_construction_of_isLine p k Ω K Λ hKΛ ζ hζ hζK E
    (fun x y hx => zmultiples_eq_top_of_finrank_le_one h1 hx y)
    S hSfin hSdisj hSram y hy hyc hyS hyT hy0 hyinf sec hsec

section Involutions

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
  {K : IntermediateField k Ω} {E : Type} [AddCommGroup E] [Module (ZMod p) E]
  [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

/-- **The involution clause of `shafarevich_z_construction` is free for odd `p`.**  If `z` is a
cochain which is additive on `G_K = K.fixingSubgroup` (i.e. a `1`-cocycle, the action of `G_K` on
`E` being trivial), then `z` vanishes at every involution of `G_K`: for `c ∈ G_K` with `c ^ 2 = 1`
one has `z c + z c = z (c * c) = z 1 = 0`, and `2` is invertible in `ZMod p` since `p` is odd. -/
lemma z_eq_zero_of_sq_eq_one (hp : p ≠ 2) {z : (Ω ≃ₐ[k] Ω) → E}
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {c : Ω ≃ₐ[k] Ω} (hc : c ∈ K.fixingSubgroup) (hc2 : c ^ 2 = 1) : z c = 0 := by
  have h2ne : (2 : ZMod p) ≠ 0 := by
    intro h
    have hdvd : p ∣ 2 := (ZMod.natCast_eq_zero_iff 2 p).mp h
    have hle : p ≤ 2 := Nat.le_of_dvd (by norm_num) hdvd
    have hge : 2 ≤ p := (Fact.out : Nat.Prime p).two_le
    exact hp (le_antisymm hle hge)
  have hsum : z c + z c = 0 := by
    have h := hz c hc c hc
    rw [← pow_two, hc2, X_one (D := K.fixingSubgroup) (X := z) hz] at h
    exact h.symm
  have h2 : (2 : ZMod p) • z c = 0 := by
    rw [show (2 : ZMod p) = (1 + 1 : ZMod p) from by norm_num, add_smul, one_smul]
    exact hsum
  exact (smul_eq_zero.mp h2).resolve_left h2ne

end Involutions

