/-!
# The decomposition group of a finite place, cut down to a finite level field, is cyclic modulo an
open subgroup containing the inertia

This file proves `Work.SSGRoute.ZConstruction.levelKDecomp_quotient_cyclic`.

Let `k` be a number field, `Ω` an algebraic closure of `k`, `K ⊆ Ω` a finite Galois subextension
and `A` a finite place of `Ω`.  Put

`D = D_A = SSGRoute.decomp k A`, `I = I_A = Work.SSGRoute.inertiaSub k Ω A`,
`G = D ⊓ K.fixingSubgroup`.

For a subgroup `N ≤ G` which is open in `G` (i.e. contains `V ⊓ G` for some open `V ≤ G_k`) and
contains `I ⊓ G`, the quotient `G ⧸ N` is *cyclic*: there is `g ∈ G` such that every `δ ∈ G` is a
power of `g` modulo `N`.

## The proof

The place-arithmetic input is entirely in the already proven lemma

* `Work.SSGRoute.decomp_mod_inertia_cyclic_over_K` : for an *open* `V ≤ G_k` containing every
  inertia element of `A` that fixes `K`, the quotient
  `G ⧸ (V ⊓ D ⊓ G)` is generated by one element.

Openness of `N` is used to replace `N` by a *level* subgroup: the compactness argument in

* `Work.SSGRoute.ZConstruction.levelKDecomp_exists_levelSub_le`

produces a finite normal level `M ⊆ Ω` with `levelSub A M ⊓ G ≤ N`.  (Here
`Work.SSGRoute.levelSub A M` is the subgroup of `D` acting trivially on the level ring `A ∩ M`
modulo its maximal ideal; the family `(levelSub A M ⊓ G)_M` is a decreasing net of closed subgroups
of the compact group `G` whose intersection is `I ⊓ G ≤ N`, and `N` is open, hence closed, in `G`.)

Since clearly `I ≤ levelSub A M`, the subgroup

`V := levelSub A M ⊔ M.fixingSubgroup`

is an open subgroup of `G_k` containing every inertia element of `A` that fixes `K`.  Hence
`decomp_mod_inertia_cyclic_over_K` provides `g ∈ G` with `δ⁻¹ g^m ∈ V ⊓ D ⊓ G` for every `δ ∈ G`,
and it remains to see that `V ⊓ D ⊓ G ≤ levelSub A M`.  That is the second lemma below: for
`x ∈ G` written in `V`, its restriction to the level `M` lies in the image of `levelSub A M`
(the inertia at the level) modulo the image of `M.fixingSubgroup` (which is trivial), because the
restriction map is a homomorphism and carries joins to joins (`Subgroup.map_sup`).

Combining the two containments gives `δ⁻¹ g^m ∈ levelSub A M ⊓ G ≤ N`.
-/

namespace Work.SSGRoute.ZConstruction

open scoped Pointwise

set_option linter.unusedVariables false
set_option linter.style.haveILetI false

/-- **The level subgroup absorbs `M.fixingSubgroup` inside the decomposition group over `K`.**

For a finite normal level `M ⊆ Ω`, the trace on `G = D_A ⊓ K.fixingSubgroup` of the subgroup
`levelSub A M ⊔ M.fixingSubgroup` is already contained in `levelSub A M`: restricting such an
element `x` to `M` and using that restriction is a homomorphism,
`(levelSub A M ⊔ M.fixingSubgroup).map (restrictNormalHom M) =
levelSub A M .map (restrictNormalHom M) ⊔ ⊥`, one sees that `x` acts trivially on the residue field
of the level prime. -/
lemma levelSub_sup_fixingSubgroup_inf_le {k Ω : Type} [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) (A : ValuationSubring Ω)
    (hA : SSGRoute.IsFinPlace k A) (M : IntermediateField k Ω) [FiniteDimensional k M]
    [Normal k M] :
    (Work.SSGRoute.levelSub A M ⊔ M.fixingSubgroup) ⊓ SSGRoute.decomp k A ⊓ K.fixingSubgroup ≤
      Work.SSGRoute.levelSub A M := by
  haveI hMnf : NumberField ↥M :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField M
  intro x hx
  rw [Subgroup.mem_inf] at hx
  obtain ⟨⟨hxV, hxD⟩, -⟩ := hx
  refine (Work.SSGRoute.mem_levelSub_iff_mem_inertia k Ω A hA M ⟨x, hxD⟩).mpr ?_
  -- The image of `levelSub A M` in `Gal(M/k)` is contained in the level inertia.
  have hlev_map : (Work.SSGRoute.levelSub A M).map (AlgEquiv.restrictNormalHom M) ≤
      Ideal.inertia (↥M ≃ₐ[k] ↥M) (Work.SSGRoute.levelPrime k Ω A hA M).asIdeal := by
    rintro τ ⟨l, hl, rfl⟩
    exact (Work.SSGRoute.mem_levelSub_iff_mem_inertia k Ω A hA M
      ⟨l, Work.SSGRoute.levelSub_le_decomp A M hl⟩).mp hl
  -- The image of `M.fixingSubgroup` is trivial.
  have hfix_map : (M.fixingSubgroup).map (AlgEquiv.restrictNormalHom M) = ⊥ := by
    have hle : M.fixingSubgroup ≤ (AlgEquiv.restrictNormalHom M).ker :=
      le_of_eq (IntermediateField.restrictNormalHom_ker M).symm
    exact (Subgroup.map_eq_bot_iff (H := M.fixingSubgroup)
      (f := AlgEquiv.restrictNormalHom M)).mpr hle
  have hxmap : AlgEquiv.restrictNormalHom M x ∈
      (Work.SSGRoute.levelSub A M).map (AlgEquiv.restrictNormalHom M) ⊔
        (M.fixingSubgroup).map (AlgEquiv.restrictNormalHom M) := by
    rw [← Subgroup.map_sup]
    exact ⟨x, hxV, rfl⟩
  rw [hfix_map, sup_bot_eq] at hxmap
  exact hlev_map hxmap

theorem levelKDecomp_quotient_cyclic (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (N : Subgroup (Ω ≃ₐ[k] Ω))
    (hNle : N ≤ SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hNnorm : ∀ h ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, ∀ n ∈ N, h * n * h⁻¹ ∈ N)
    (hNopen : ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      V ⊓ (SSGRoute.decomp k A ⊓ K.fixingSubgroup) ≤ N)
    (hI : SSGRoute.inertiaSub k Ω A ⊓ (SSGRoute.decomp k A ⊓ K.fixingSubgroup) ≤ N) :
    ∃ g ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup,
      ∀ δ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ N := by
  classical
  -- ## Step 1: an open `N` contains a level subgroup
  obtain ⟨M, hMfd, hMnorm, hMle⟩ :=
    levelKDecomp_exists_levelSub_le k Ω K A hA N hNle hNopen hI
  haveI := hMfd
  haveI := hMnorm
  -- ## Step 2: the open subgroup `V = levelSub A M ⊔ M.fixingSubgroup` contains the inertia
  have hVopen : IsOpen ((Work.SSGRoute.levelSub A M ⊔ M.fixingSubgroup :
      Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.isOpen_mono le_sup_right (IntermediateField.fixingSubgroup_isOpen M)
  have hI' : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → σ ∈ K.fixingSubgroup →
      σ ∈ (Work.SSGRoute.levelSub A M ⊔ M.fixingSubgroup) ⊓ SSGRoute.decomp k A ⊓
        K.fixingSubgroup := by
    intro σ hσ hσK
    have hσlev : σ ∈ Work.SSGRoute.levelSub A M := by
      refine ⟨hσ.1, fun x => ?_⟩
      exact hσ.2 _ (by
        simpa [IntermediateField.algebraMap_apply] using (ValuationSubring.mem_comap).mp x.2)
    exact ⟨Subgroup.mem_inf.mpr ⟨Subgroup.mem_sup_left hσlev, hσ.1⟩, hσK⟩
  -- ## Step 3: cyclicity modulo the open subgroup `V`
  obtain ⟨g, hg, hgen⟩ :=
    Work.SSGRoute.decomp_mod_inertia_cyclic_over_K k Ω K
      (Work.SSGRoute.levelSub A M ⊔ M.fixingSubgroup) hVopen A hA hI'
  refine ⟨g, hg, fun δ hδ => ?_⟩
  obtain ⟨m, hm⟩ := hgen δ hδ
  -- ## Step 4: the trace of `V` on `G` lies in the level subgroup, hence in `N`
  refine ⟨m, hMle (Subgroup.mem_inf.mpr
    ⟨levelSub_sup_fixingSubgroup_inf_le K A hA M hm,
      Subgroup.mem_inf.mpr
        ⟨(Subgroup.mem_inf.mp (Subgroup.mem_inf.mp hm).1).2, (Subgroup.mem_inf.mp hm).2⟩⟩)⟩

end Work.SSGRoute.ZConstruction
