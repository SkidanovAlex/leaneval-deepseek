/-!
# The transfer of a cochain with a Galois level, and a new régime of the node

## The problem

The sixth (and only non-elementary) conjunct of
`Work.SSGRoute.shafarevich_z_construction` asks, at every finite place `B` outside `cs(S)` that
splits completely in `Λ`, for an **open** subgroup `V ≤ G_k = Ω ≃ₐ[k] Ω` with

1. `V` normalised by the decomposition group `D_B = decomp k B`;
2. `D_B ⫽ (D_B ⊓ V)` cyclic (generated by one element);
3. the transfer `X_Z δ = ∑_{s : Gal(K|k)} s • Z ((sec s)⁻¹ * δ * sec s)` vanishing on `D_B ⊓ V`.

There is a canonical way of producing such a `V` which does **not** go through the transfer: take
`V` to be the fixing subgroup of a finite Galois *level* `M/k` on which the cochain `Z` vanishes.
Then

* (1) holds because `M|k` is Galois (`G_M ◁ G_k`);
* (2) is the *only* hypothesis: `D_B ⫽ (D_B ⊓ G_M)` is the decomposition group of `B` in `Gal(M|k)`,
  and one asks it to be cyclic;
* (3) is a purely algebraic computation (`transfer_eq_zero_of_mem_level` below): for
  `δ ∈ D_B ⊓ G_M` and any `s`, the conjugate `(sec s)⁻¹ δ sec s = δ * (δ⁻¹ (sec s)⁻¹ δ sec s)` is a
  product of two elements of `G_M`, because `δ ∈ G_M` and `M|k` is Galois (the conjugate of `δ`
  by `sec s` lies in `G_M` again); hence `Z` of it is `Z δ + Z (…) = 0`.

So the sixth conjunct is *decided by the level of the witness* as soon as the level has cyclic local
decomposition groups, and no local computation of the transfer is needed.  In particular the
régime below is strictly wider than the "`Z` vanishes on the inertia of the conjugates of `B`"
régimes: it applies at places where `Z` **is** ramified, whenever the local Galois group of the level
is cyclic (for instance a tamely ramified cyclic level, or a level whose ramification at `B` lies in
a single one of its cyclic factors).

## Main results

* `Work.SSGRoute.mem_fixingSubgroup_conj` — `G_M` is normal in `G_k` for a Galois level.
* `Work.SSGRoute.transfer_eq_zero_of_mem_level` — the vanishing of the transfer on `G_M`.
* `Work.SSGRoute.exists_V_of_transfer_of_cyclic_level` — the sixth conjunct at `B` from the
  cyclicity of `D_B ⫽ (D_B ⊓ G_M)`.
* `Work.SSGRoute.shafarevich_z_construction_of_cyclicLevel` — the node from the existence of a
  Galois level `M` of the datum whose local decomposition groups at the junk places are cyclic.
-/

open scoped Pointwise

namespace Work.SSGRoute

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1600000

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]

section LevelLaws

variable {M : IntermediateField k Ω} [Normal k M]

/-- The fixing subgroup of a normal level is normal in `G_k` (it is the kernel of the restriction
map to `Gal(M|k)`); this is clause (1) of the sixth conjunct for `V = G_M`. -/
private lemma tl_fixingSubgroup_normal_of_normal : M.fixingSubgroup.Normal := by
  rw [← IntermediateField.restrictNormalHom_ker M]
  exact MonoidHom.normal_ker _

/-- The fixing subgroup of a normal level is closed under conjugation by `G_k`. -/
lemma mem_fixingSubgroup_conj {δ τ : Ω ≃ₐ[k] Ω} (hδ : δ ∈ M.fixingSubgroup) :
    τ * δ * τ⁻¹ ∈ M.fixingSubgroup :=
  (tl_fixingSubgroup_normal_of_normal (M := M)).conj_mem δ hδ τ

end LevelLaws

section TransferLevel

variable [NumberField k] [IsAlgClosure k Ω]
variable {K : IntermediateField k Ω} [FiniteDimensional k K] [Normal k K]
  [Fintype (K ≃ₐ[k] K)]
variable {E : Type} [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
variable {z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}

/-- **The transfer vanishes on a Galois level.**  Let `M/k` be a finite Galois level, `K ≤ M`, and
`z` a cochain which is additive on `G_K = K.fixingSubgroup` and vanishes on `G_M`.  Then for every
`δ ∈ G_M` the transfer `∑_s s • z ((sec s)⁻¹ δ sec s)` vanishes.

The point is that `(sec s)⁻¹ δ sec s = δ * (δ⁻¹ * (sec s)⁻¹ * δ * sec s)`, and the second factor is a
commutator of two elements of `G_M` (`δ ∈ G_M` and `M|k` Galois), hence again in `G_M`; so both
summands are values of `z` at elements of `G_M`, where `z` vanishes. -/
theorem transfer_eq_zero_of_mem_level
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M] (hKM : K ≤ M)
    (hzM : ∀ g ∈ M.fixingSubgroup, z g = 0)
    {δ : Ω ≃ₐ[k] Ω} (hδK : δ ∈ K.fixingSubgroup) (hδM : δ ∈ M.fixingSubgroup) :
    transfer z sec δ = 0 := by
  refine Finset.sum_eq_zero fun s _ => ?_
  have hσK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup :=
    conj_sec_mem_fixingSubgroup hsec s hδK
  set γ : Ω ≃ₐ[k] Ω := δ⁻¹ * ((sec s)⁻¹ * δ * sec s) with hγ
  have hcommM : γ ∈ M.fixingSubgroup :=
    M.fixingSubgroup.mul_mem (M.fixingSubgroup.inv_mem hδM)
      (mem_fixingSubgroup_conj (M := M) hδM (τ := (sec s)⁻¹))
  have hcommK : γ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKM hcommM
  have hsplit : (sec s)⁻¹ * δ * sec s = δ * γ := by rw [hγ]; group
  rw [hsplit, hzadd δ hδK γ hcommK, hzM δ hδM, hzM γ hcommM, add_zero, smul_zero]

/-- **The sixth conjunct at `B` from an open normal subgroup on which the cochain vanishes.**

This is the sharpest "cheap" criterion: if there is an open normal `V ≤ G_k` such that `Z` vanishes
on `V ∩ G_K` and the image of `decomp k B` in `G_k/V` is cyclic, then the sixth conjunct holds at `B`
with this very `V`.  Clause (1) is normality, clause (2) is the cyclicity hypothesis, and clause (3)
is immediate: for `δ ∈ D_B ∩ V` and any `s` the conjugate `(sec s)⁻¹ δ sec s` lies in `V` (normality)
and in `G_K` (`G_K ◁ G_k`, which holds because `K|k` is normal), where `Z` vanishes.

No computation of the transfer is needed, and no hypothesis on the ramification of `Z`. -/
theorem exists_V_of_transfer_of_normal_vanishing
    {V : Subgroup (Ω ≃ₐ[k] Ω)} (hVopen : IsOpen (V : Set (Ω ≃ₐ[k] Ω))) (hVnorm : V.Normal)
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzV : ∀ v ∈ V, v ∈ K.fixingSubgroup → z v = 0)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hsplit : SSGRoute.IsSplitIn k K B)
    (hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) :
    ∃ V' : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V' : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V', δ * u * δ⁻¹ ∈ V') ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V') ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V', transfer z sec δ = 0) := by
  refine ⟨V, hVopen, ?_, hcyc, ?_⟩
  · intro δ _hdB u hu
    exact hVnorm.conj_mem u hu.2 δ
  · intro δ hδ
    refine Finset.sum_eq_zero fun s _ => ?_
    have hσK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup :=
      conj_sec_mem_fixingSubgroup hsec s (hsplit hδ.1)
    have hσV : (sec s)⁻¹ * δ * sec s ∈ V := hVnorm.conj_mem δ hδ.2 (sec s)⁻¹
    rw [hzV _ hσV hσK, smul_zero]

/-- **The sixth conjunct at `B` from a cyclic level.**  Let `B` be a finite place which splits
completely in `K|k` (so that `decomp k B ≤ G_K` and the conjugates by `sec s` stay in `G_K`), let
`z` be additive on `G_K` and vanishing on the normal level `M ⊇ K`, and suppose that the image of
`decomp k B` in `Gal(M|k)` is cyclic.  Then the sixth conjunct holds at `B` with `V = G_M`.

No hypothesis on the ramification of `z` (or of `y`) at `B` is needed: what is used is only that the
*local Galois group of the level* is cyclic. -/
theorem exists_V_of_transfer_of_cyclic_level
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M] (hKM : K ≤ M)
    (hzM : ∀ g ∈ M.fixingSubgroup, z g = 0)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hsplit : SSGRoute.IsSplitIn k K B)
    (hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      ∃ m : ℤ, δ⁻¹ * g ^ m ∈ M.fixingSubgroup) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0) :=
  exists_V_of_transfer_of_normal_vanishing (K := K) (z := z) (V := M.fixingSubgroup)
    (IntermediateField.fixingSubgroup_isOpen M) (tl_fixingSubgroup_normal_of_normal (M := M))
    hsec (fun _ hg _ => hzM _ hg) B hB hsplit hcyc

/-! ## The transfer as the norm, and the sixth conjunct with `V = ⊤`

When the conjugating elements `(sec s)⁻¹ δ sec s` have the same `z`-value as `δ` itself — which
happens whenever `z` vanishes on a normal level `M` in which the commutators `δ⁻¹ τ⁻¹ δ τ`
(`δ ∈ G_K`, `τ ∈ G_k`) are trivial (for instance when `Gal(M|k)` is abelian) — the transfer
`∑_s s • z ((sec s)⁻¹ δ sec s)` collapses to the **norm** `∑_s s • z δ`.  The sixth conjunct then
holds with `V = ⊤` as soon as the norm kills the image of the decomposition group. -/

/-- **The transfer is the norm on a level with trivial commutators.**  Let `M/k` be a finite normal
level, `K ≤ M`, such that every commutator `δ⁻¹ τ⁻¹ δ τ` (`δ ∈ G_K`, `τ ∈ G_k`) lies in `G_M` (this
holds e.g. when `Gal(M|k)` is abelian, or when `M = k`), and let `z` vanish on `G_M` and be additive
on `G_K`.  Then for every `δ ∈ G_K`

  `transfer z sec δ = ∑_{s : Gal(K|k)} s • z δ`,

the norm of `z δ`. -/
theorem transfer_eq_norm_of_commutators_mem
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M] (hKM : K ≤ M)
    (hzM : ∀ g ∈ M.fixingSubgroup, z g = 0)
    (hcomm : ∀ δ ∈ K.fixingSubgroup, ∀ τ : Ω ≃ₐ[k] Ω,
      δ⁻¹ * τ⁻¹ * δ * τ ∈ M.fixingSubgroup)
    {δ : Ω ≃ₐ[k] Ω} (hδK : δ ∈ K.fixingSubgroup) :
    transfer z sec δ = ∑ s : K ≃ₐ[k] K, s • z δ := by
  refine Finset.sum_congr rfl fun s _ => ?_
  have hσK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup :=
    conj_sec_mem_fixingSubgroup hsec s hδK
  set γ : Ω ≃ₐ[k] Ω := δ⁻¹ * ((sec s)⁻¹ * δ * sec s) with hγ
  have hcommM : γ ∈ M.fixingSubgroup := hcomm δ hδK (sec s)
  have hcommK : γ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKM hcommM
  have hsplit : (sec s)⁻¹ * δ * sec s = δ * γ := by rw [hγ]; group
  rw [hsplit, hzadd δ hδK γ hcommK, hzM γ hcommM, add_zero]

/-- **The sixth conjunct at `B` with `V = ⊤`.**  If the transfer of `z` vanishes on the decomposition
group of `B` — which by `transfer_eq_norm_of_commutators_mem` happens as soon as the conjugates of the
elements of `D_B` have the same `z`-value as the elements themselves and the norm of `z (decomp k B)`
is `0` (for instance if the norm operator `∑_s s` of `Gal(K|k)` acts as `0` on `E`, e.g. for a
coefficient module with no invariant vectors when `p ∤ [K : k]`, or when `p ∣ [K : k]` and `E` is
trivial) — then the sixth conjunct holds at `B` with the *whole* group `V = ⊤`.

This needs neither a cyclicity hypothesis on the level (unlike
`exists_V_of_transfer_of_cyclic_level`) nor a hypothesis on the inertia (unlike the
`transfer_vanishes_of_unramified` route): it is the criterion of choice whenever the norm of the
coefficient module is degenerate. -/
theorem exists_V_of_transfer_of_norm_vanishing
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M] (hKM : K ≤ M)
    (hzM : ∀ g ∈ M.fixingSubgroup, z g = 0)
    (hcomm : ∀ δ ∈ K.fixingSubgroup, ∀ τ : Ω ≃ₐ[k] Ω,
      δ⁻¹ * τ⁻¹ * δ * τ ∈ M.fixingSubgroup)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hsplit : SSGRoute.IsSplitIn k K B)
    (hN : ∀ δ ∈ SSGRoute.decomp k B, (∑ s : K ≃ₐ[k] K, s • z δ) = 0) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0) := by
  refine ⟨⊤, isOpen_univ, ?_, ⟨1, SSGRoute.decomp k B |>.one_mem, fun δ _ => ⟨0, by simp⟩⟩, ?_⟩
  · intro δ _hdB u _hu
    exact Subgroup.mem_top _
  · intro δ hδ
    have hδB : δ ∈ SSGRoute.decomp k B := (Subgroup.mem_inf.mp hδ).1
    rw [transfer_eq_norm_of_commutators_mem hsec hzadd hKM hzM hcomm (hsplit hδB), hN δ hδB]

/-- **The sixth conjunct at `B` with `V = ⊤` from conjugation-invariance and vanishing norm.**

This is the sharpest form of the "norm" route: it needs no level at all.  If the values of the
cochain on the conjugates `(sec s)⁻¹ δ sec s` of the elements of `decomp k B` agree with the values at
`δ` themselves, then the transfer at `δ` is the norm `∑_s s • z δ`, so it vanishes as soon as the norm
of `z (decomp k B)` does; and then the whole group `V = ⊤` serves in the sixth conjunct.

The hypotheses hold for a cochain vanishing on a normal level with trivial commutators
(`transfer_eq_norm_of_commutators_mem`), but may also hold for other reasons. -/
theorem exists_V_of_transfer_of_conjInvariant_norm_vanishing
    {B : ValuationSubring Ω}
    (hinv : ∀ δ ∈ SSGRoute.decomp k B, ∀ s : K ≃ₐ[k] K,
      z ((sec s)⁻¹ * δ * sec s) = z δ)
    (hN : ∀ δ ∈ SSGRoute.decomp k B, (∑ s : K ≃ₐ[k] K, s • z δ) = 0) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0) := by
  refine ⟨⊤, isOpen_univ, ?_, ⟨1, (SSGRoute.decomp k B).one_mem, fun δ _ => ⟨0, by simp⟩⟩, ?_⟩
  · intro δ _ u _
    exact Subgroup.mem_top _
  · intro δ hδ
    have hδB : δ ∈ SSGRoute.decomp k B := (Subgroup.mem_inf.mp hδ).1
    refine (Finset.sum_congr rfl (fun s _ => ?_)).trans (hN δ hδB)
    exact congrArg (fun v : E => s • v) (hinv δ hδB s)

/-- **The sixth conjunct for a sum of two cochains with a common normal level.**

This is the building block for an `IsZConclusion`-level assembly of the two summands of the §4
induction (the lane's `hasZData_sum_of_level_data` is phrased for the stronger `HasZData` clause): the
transfer is additive in the cochain (`Work.SSGRoute.transfer_add`), so if both summands vanish on the
*same* normal level `G_M` and `decomp k B ⫽ (decomp k B ⊓ G_M)` is cyclic, then the sixth conjunct for
the sum holds with `V = G_M`. -/
theorem exists_V_of_transfer_add_of_common_level
    (hsec : ∀ s : K ≃ₐ[k] K, SSGRoute.res k K (sec s) = s)
    {z₁ z₂ : (Ω ≃ₐ[k] Ω) → E}
    (hz₁add : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z₁ (g * h) = z₁ g + z₁ h)
    (hz₂add : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z₂ (g * h) = z₂ g + z₂ h)
    {M : IntermediateField k Ω} [FiniteDimensional k M] [Normal k M] (hKM : K ≤ M)
    (hz₁M : ∀ g ∈ M.fixingSubgroup, z₁ g = 0) (hz₂M : ∀ g ∈ M.fixingSubgroup, z₂ g = 0)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hsplit : SSGRoute.IsSplitIn k K B)
    (hcyc : ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
      ∃ m : ℤ, δ⁻¹ * g ^ m ∈ M.fixingSubgroup) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ SSGRoute.decomp k B ⊓ V,
        transfer (fun σ => z₁ σ + z₂ σ) sec δ = 0) := by
  refine ⟨M.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen M, ?_, ?_, ?_⟩
  · intro δ _ u hu
    exact mem_fixingSubgroup_conj (M := M) hu.2
  · obtain ⟨g, hg, hgc⟩ := hcyc
    exact ⟨g, hg, hgc⟩
  · intro δ hδ
    have hδK : δ ∈ K.fixingSubgroup := hsplit hδ.1
    rw [ZConstruction.transfer_add]
    rw [transfer_eq_zero_of_mem_level hsec hz₁add hKM hz₁M hδK hδ.2,
      transfer_eq_zero_of_mem_level hsec hz₂add hKM hz₂M hδK hδ.2, add_zero]

end TransferLevel

/-! ## The node from a cyclic Galois level -/

section Node

variable [NumberField k] [IsAlgClosure k Ω]

/-- **`Work.SSGRoute.shafarevich_z_construction` from a cyclic Galois level of the datum.**

Suppose the datum `y` vanishes on the fixing subgroup of a finite Galois level `M ⊇ K`, and suppose
that at every junk place `B` (`B ∉ cs(S)` and `B` split in `Λ`) the decomposition group of `B` in
`Gal(M|k)` is cyclic.  Then the node holds, with the witness `Z :=` the extension of `y` by `0` off
`G_K`.

The five elementary conjuncts of the conclusion are supplied by
`Work.SSGRoute.zClauses_of_agrees_on_fixingSubgroup`, and the sixth by
`Work.SSGRoute.exists_V_of_transfer_of_cyclic_level` with `V = G_M`.

This régime is *not* contained in the "`y` is unramified at the junk places" régime
(`Work.SSGRoute.shafarevich_z_construction_of_unramifiedOutside`): here `y` may well be ramified at
the junk places (and its junk span may span the whole coefficient module), as long as the level `M`
which kills `y` has cyclic local Galois groups there — for example if `M|K` is cyclic, or if the
ramification of `M|K` at each junk place is confined to a single cyclic factor of `Gal(M|K)`. -/
theorem shafarevich_z_construction_of_cyclicLevel
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (M : IntermediateField k Ω) [FiniteDimensional k M] [IsGalois k M] (hKM : K ≤ M)
    (hyM : ∀ σ ∈ M.fixingSubgroup, y σ = 0)
    (hcyc : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        ∃ m : ℤ, δ⁻¹ * g ^ m ∈ M.fixingSubgroup) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  haveI : Normal k M := IsGalois.to_normal
  let Z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ else 0
  have hZy : ∀ σ, σ ∈ K.fixingSubgroup → Z σ = y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ else 0) = y σ
    rw [if_pos hσ]
  obtain ⟨hZ1, hZ2, hZ3, hZ4, hZ5, _hZtr⟩ :=
    ZConstruction.zClauses_of_agrees_on_fixingSubgroup p k Ω K Λ E S y Z hZy hy hyc hyS hyinf
      sec hsec
  have hZadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, Z (g * h) = Z g + Z h := by
    intro g hg h hh
    rw [hZy (g * h) (K.fixingSubgroup.mul_mem hg hh), hZy g hg, hZy h hh, hy g hg h hh]
  have hZM : ∀ g ∈ M.fixingSubgroup, Z g = 0 := by
    intro g hg
    rw [hZy g (IntermediateField.fixingSubgroup_le hKM hg), hyM g hg]
  refine ⟨Z, hZ1, hZ2, hZ3, hZ4, hZ5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  exact exists_V_of_transfer_of_cyclic_level (K := K) (M := M) (E := E) (z := Z)
    hsec hZadd hKM hZM B hB hsplitK (hcyc B hB hnotconj hsplitΛ)



/-- **`Work.SSGRoute.shafarevich_z_construction` from a degenerate norm.**

Suppose the datum `y` vanishes on a finite Galois level `M ⊇ K` in which the commutators
`δ⁻¹ τ⁻¹ δ τ` (`δ ∈ G_K`, `τ ∈ G_k`) are trivial (this holds for instance when `Gal(M|k)` is
abelian), and suppose that the norm `∑_{s : Gal(K|k)} s • y δ` vanishes for every `δ` in the
decomposition group of every junk place `B`.

Then the node holds, with the witness `Z :=` the extension of `y` by `0` off `G_K`, and with the
*whole* group `V = ⊤` in the sixth conjunct.  In particular the sixth conjunct needs neither a
cyclicity hypothesis on the level nor a hypothesis on the inertia: the transfer of `Z` collapses to
the norm (`Work.SSGRoute.transfer_eq_norm_of_commutators_mem`), which vanishes on `decomp k B`.

The hypothesis on the norm is automatic whenever the norm operator `∑_{s : Gal(K|k)} s` of the
`Gal(K|k)`-module `E` is the zero endomorphism — for example when `K = k`, when `p ∣ [K : k]` and the
action of `Gal(K|k)` on `E` is trivial, or when `E` has no non-zero `Gal(K|k)`-invariant vector and
`p ∤ [K : k]`. -/
theorem shafarevich_z_construction_of_normVanishing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (M : IntermediateField k Ω) [FiniteDimensional k M] [IsGalois k M] (hKM : K ≤ M)
    (hyM : ∀ σ ∈ M.fixingSubgroup, y σ = 0)
    (hcomm : ∀ δ ∈ K.fixingSubgroup, ∀ τ : Ω ≃ₐ[k] Ω,
      δ⁻¹ * τ⁻¹ * δ * τ ∈ M.fixingSubgroup)
    (hN : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∀ δ ∈ SSGRoute.decomp k B, (∑ s : K ≃ₐ[k] K, s • y δ) = 0) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  haveI : Normal k M := IsGalois.to_normal
  let Z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ else 0
  have hZy : ∀ σ, σ ∈ K.fixingSubgroup → Z σ = y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ else 0) = y σ
    rw [if_pos hσ]
  obtain ⟨hZ1, hZ2, hZ3, hZ4, hZ5, _hZtr⟩ :=
    ZConstruction.zClauses_of_agrees_on_fixingSubgroup p k Ω K Λ E S y Z hZy hy hyc hyS hyinf
      sec hsec
  have hZadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, Z (g * h) = Z g + Z h := by
    intro g hg h hh
    rw [hZy (g * h) (K.fixingSubgroup.mul_mem hg hh), hZy g hg, hZy h hh, hy g hg h hh]
  have hZM : ∀ g ∈ M.fixingSubgroup, Z g = 0 := by
    intro g hg
    rw [hZy g (IntermediateField.fixingSubgroup_le hKM hg), hyM g hg]
  refine ⟨Z, hZ1, hZ2, hZ3, hZ4, hZ5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  refine exists_V_of_transfer_of_norm_vanishing (K := K) (M := M) (E := E) (z := Z)
    hsec hZadd hKM hZM hcomm B hB hsplitK ?_
  intro δ hδ
  have hδK : δ ∈ K.fixingSubgroup := hsplitK hδ
  show (∑ s : K ≃ₐ[k] K, s • Z δ) = 0
  rw [hZy δ hδK]
  exact hN B hB hnotconj hsplitΛ δ hδ

end Node

/-! ## The admissible variants of a datum, and the honest gate

The node's conclusion mentions the datum `y` only in its third clause (`z σ = y σ` on the local
groups of the places conjugate into `S`).  Hence one is free to replace `y` by `y + α` for any `α`
which

* is a continuous homomorphism on `G_K` (a `ZHyp` datum, in the vocabulary of
  `Work.SSGRoute.ZHyp`), and
* *vanishes* on the local groups of the places conjugate into `S` (so that the replacement does not
  change the third clause).

Such an `α` must vanish on the *pinned* subgroup
`P = ⟨cs(S)-decomposition groups, involutions, inertia outside cs(S) not split in Λ⟩`, because a
`ZHyp` datum already vanishes on all of `P` *except* the `cs(S)`-decomposition groups, and the
agreement clause supplies the vanishing there.

The **honest gate** of the sixth conjunct is therefore not "the transfer of `y` is cyclic at the junk
places" (the hypothesis of `Work.SSGRoute.ZConstruction.shafarevich_z_construction_of_transferCyclicDatum`)
but the same statement for a *variant* `y + α`: it is strictly weaker, it is what the invocation
`α = 0` reduces to, and — as the equivalence below shows — it is exactly equivalent to the node. -/

section Variant

variable [NumberField k] [IsAlgClosure k Ω]

/-- **The admissible variant `y + α`.**  If `y` and `α` satisfy the hypotheses `ZHyp` and `α` vanishes
on the `cs(S)`-local groups, then `y + α` again satisfies `ZHyp` and agrees with `y` there. -/
theorem ZHyp.add_of_vanishes_on_csGroups
    {K Λ : IntermediateField k Ω} [FiniteDimensional k K] [Normal k K]
    {S : Finset (ValuationSubring Ω)} {E : Type} [AddCommGroup E]
    {y α : (Ω ≃ₐ[k] Ω) → E} (hy : ZHyp (p := p) K Λ S y) (hα : ZHyp (p := p) K Λ S α)
    (hαcs : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0) :
    ZHyp (p := p) K Λ S (fun σ => y σ + α σ) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ + α σ = y σ) :=
  ⟨ZHyp.sum hy hα, fun B hB hconj σ hσK hσd => by rw [hαcs B hB hconj σ hσK hσd, add_zero]⟩

/-- **The node from the cyclicity of the transfer of an admissible variant.**

This is the honest gate: the node holds as soon as *some* variant `y + α` (`α` a `ZHyp` datum
vanishing on the `cs(S)`-local groups) has cyclic transfer at every junk place.  The case `α = 0` is
`Work.SSGRoute.ZConstruction.shafarevich_z_construction_of_transferCyclicDatum`; the general form is
strictly weaker, and it is equivalent to the node (see the docstring of the section).

The witness produced is the one of the fleet's theorem applied to the variant, which is a witness for
`y` because the first, second, fourth, fifth and sixth clauses of the conclusion do not mention the
datum, and the third clause only asks for agreement on the `cs(S)`-local groups. -/
theorem shafarevich_z_construction_of_variant
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y α : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hα : ZHyp (p := p) K Λ S α)
    (hαcs : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (hcyc : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer (fun σ => y σ + α σ) sec δ ∈
          AddSubgroup.zmultiples (transfer (fun σ => y σ + α σ) sec g)) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  have hyZ : ZHyp (p := p) K Λ S y :=
    ⟨hy, hyc, hyS, hyT, hy0, hyinf⟩
  obtain ⟨hvZ, hvagree⟩ := ZHyp.add_of_vanishes_on_csGroups hyZ hα hαcs
  obtain ⟨z, hz1, hz2, hz3, hz4, hz5, hz6⟩ :=
    ZConstruction.shafarevich_z_construction_of_transferCyclicDatum p k Ω K Λ hKΛ ζ hζ hζK E S
      hSfin hSdisj hSram (fun σ => y σ + α σ) hvZ.add hvZ.locconst hvZ.hyS hvZ.hyT hvZ.hy0 hvZ.hyinf
      sec hsec hcyc
  exact ⟨z, hz1, hz2,
    (fun B hB hconj σ hσK hσd => by
      have h1 := hz3 B hB hconj σ hσK hσd
      have h2 := hvagree B hB hconj σ hσK hσd
      show z σ = y σ
      rw [h1]
      show y σ + α σ = y σ
      exact h2),
    hz4, hz5, hz6⟩

/-- **The gate is exactly the node: the converse of `shafarevich_z_construction_of_variant`.**

Given a witness `z` of the node's conclusion, the difference `α := z|G_K - y` (extended by `0` off
`G_K`) is an admissible variant in the sense of `shafarevich_z_construction_of_variant`:

* `α` satisfies `ZHyp`: additivity and local constancy are inherited from `z` and `y`, `hyS` uses the
  fifth clause of the conclusion for `z` together with `hyS` of `y`, and `hyT`, `hy0`, `hyinf` use the
  third, fourth and `hyinf` clauses (the `cs(S)`-decomposition groups are where `z` agrees with `y`,
  and they contain their inertia);
* `α` vanishes on the `cs(S)`-local groups (third clause);
* the transfer of the variant `y + α` agrees with the transfer of `z` on `decomp k B` for every
  `B` split in `K` (the summands are values at elements of `G_K`), so it is cyclic there by
  `Work.SSGRoute.ZConstruction.isCyclic_transfer_of_exists_V`.

Hence the node is *equivalent* to the existence of an admissible variant with cyclic transfer at the
junk places: the gate of `shafarevich_z_construction_of_variant` is the exact residual obligation,
and the case `α = 0` (the hypothesis of
`Work.SSGRoute.ZConstruction.shafarevich_z_construction_of_transferCyclicDatum`) is a genuine
specialisation of it. -/
theorem exists_variant_of_isZConclusion
    {K Λ : IntermediateField k Ω} [FiniteDimensional k K] [Normal k K] [Fintype (K ≃ₐ[k] K)]
    {S : Finset (ValuationSubring Ω)} {E : Type} [AddCommGroup E] [Module (ZMod p) E]
    [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    {y z : (Ω ≃ₐ[k] Ω) → E} {sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)}
    (hKΛ : K ≤ Λ) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (hy : ZHyp (p := p) K Λ S y)
    (hz : ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z) :
    ∃ α : (Ω ≃ₐ[k] Ω) → E,
      ZHyp (p := p) K Λ S α ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
        ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
          transfer (fun σ => y σ + α σ) sec δ ∈
            AddSubgroup.zmultiples (transfer (fun σ => y σ + α σ) sec g)) := by
  classical
  obtain ⟨hz1, hz2, hz3, hz4, hz5, hz6⟩ := hz
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hz1 g hg h hh, (res_eq_one_iff_mem_fixingSubgroup (K := K) g).mpr hg, one_smul]
  let α : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then z σ - y σ else 0
  have hαval : ∀ σ, σ ∈ K.fixingSubgroup → α σ = z σ - y σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then z σ - y σ else 0) = z σ - y σ
    rw [if_pos hσ]
  refine ⟨α, ?_, ?_, ?_⟩
  · refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro g hg h hh
      rw [hαval (g * h) (K.fixingSubgroup.mul_mem hg hh), hαval g hg, hαval h hh,
        hzadd g hg h hh, hy.add g hg h hh]
      abel
    · obtain ⟨Uz, hUzo, hUzc⟩ := hz2
      obtain ⟨Uy, hUyo, hUyc⟩ := hy.locconst
      refine ⟨Uz ⊓ Uy, ?_, ?_⟩
      · simpa using hUzo.inter hUyo
      · intro g hg u hu huK
        rw [hαval (g * u) (K.fixingSubgroup.mul_mem hg huK), hαval g hg,
          hUzc g hg u hu.1 huK, hUyc g hg u hu.2 huK]
    · intro B hB hnot hsp σ hσ hσI
      rw [hαval σ hσ, hz5 B hB hnot hsp σ hσ hσI, hy.hyS B hB hnot hsp σ hσ hσI, sub_zero]
    · intro B hB hconj σ hσ hσI
      rw [hαval σ hσ, hz3 B hB hconj σ hσ hσI.1, sub_self]
    · intro B hB hconj hbad σ hσ hσd
      rw [hαval σ hσ, hz3 B hB hconj σ hσ hσd, sub_self]
    · intro c hc hc2
      rw [hαval c hc, hz4 c hc hc2, hy.hyinf c hc hc2, sub_zero]
  · intro B hB hconj σ hσ hσd
    rw [hαval σ hσ, hz3 B hB hconj σ hσ hσd, sub_self]
  · intro B hB hnot hsp
    have hsplitK : SSGRoute.IsSplitIn k K B :=
      le_trans hsp (IntermediateField.fixingSubgroup_le hKΛ)
    have hV : ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
        (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
        (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
        (∀ δ ∈ SSGRoute.decomp k B ⊓ V, transfer z sec δ = 0) := by
      obtain ⟨V, hVo, hVn, hVc, hVv⟩ := hz6 B hB hnot hsp
      exact ⟨V, hVo, hVn, hVc, fun δ hδ => hVv δ hδ⟩
    obtain ⟨g, hg, hgc⟩ :=
      isCyclic_transfer_of_exists_V (K := K) hsec hzadd B hsplitK hV
    have hEqAt : ∀ ε ∈ SSGRoute.decomp k B,
        transfer (fun σ => y σ + α σ) sec ε = transfer z sec ε := by
      intro ε hε
      refine Finset.sum_congr rfl fun s _ => ?_
      refine congrArg (fun v : E => s • v) ?_
      have hmem : (sec s)⁻¹ * ε * sec s ∈ K.fixingSubgroup :=
        conj_sec_mem_fixingSubgroup hsec s (hsplitK hε)
      show y ((sec s)⁻¹ * ε * sec s) + α ((sec s)⁻¹ * ε * sec s)
        = z ((sec s)⁻¹ * ε * sec s)
      rw [hαval _ hmem]
      abel
    refine ⟨g, hg, fun δ hδ => ?_⟩
    rw [hEqAt δ hδ, hEqAt g hg]
    exact hgc δ hδ

/-- **The exact residual obligation of the node: the existence of an admissible variant whose transfer
is cyclic at the junk places.**

An admissible variant is `y + α` with `α` a `ZHyp` datum vanishing on the `cs(S)`-local groups (so
that `y + α` satisfies `ZHyp` and agrees with `y` there, hence is a legitimate replacement of the
datum); the transfer is the one of the variant.  The case `α = 0` is the hypothesis of
`Work.SSGRoute.ZConstruction.shafarevich_z_construction_of_transferCyclicDatum`. -/
def VariantTransferGate (K Λ : IntermediateField k Ω) (S : Finset (ValuationSubring Ω))
    {E : Type} [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E] [Fintype (K ≃ₐ[k] K)]
    (y : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) : Prop :=
  ∃ α : (Ω ≃ₐ[k] Ω) → E,
    ZHyp (p := p) K Λ S α ∧
    (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0) ∧
    (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B,
        transfer (fun σ => y σ + α σ) sec δ ∈
          AddSubgroup.zmultiples (transfer (fun σ => y σ + α σ) sec g))

/-- **The node is equivalent to its single named residual obligation `VariantTransferGate`.**

This is the sharp form of the gate list of the lane: the node is *equivalent* to the existence of an
admissible variant of the datum whose transfer is cyclic at every junk place, so no further
reduction of the sixth conjunct is possible along the lines of `α`-modifications.  The two
implications are `Work.SSGRoute.shafarevich_z_construction_of_variant` (the direction that produces
the witness) and `Work.SSGRoute.exists_variant_of_isZConclusion` (the direction that extracts `α`
from a witness). -/
theorem isZConclusion_iff_variantTransferGate
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    (∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z) ↔
      VariantTransferGate (p := p) (K := K) (Λ := Λ) S y sec := by
  constructor
  · intro ⟨z, hz⟩
    obtain ⟨α, hαZ, hαcs, hαtr⟩ :=
      exists_variant_of_isZConclusion (p := p) (K := K) (Λ := Λ) (E := E) hKΛ hsec
        ⟨hy, hyc, hyS, hyT, hy0, hyinf⟩ hz
    exact ⟨α, hαZ, hαcs, hαtr⟩
  · rintro ⟨α, hαZ, hαcs, hαtr⟩
    exact shafarevich_z_construction_of_variant (p := p) (k := k) (Ω := Ω) (K := K) (Λ := Λ)
      (E := E) hKΛ ζ hζ hζK S hSfin hSdisj hSram y α hy hyc hyS hyT hy0 hyinf hαZ hαcs
      sec hsec hαtr

/-- **The node from an admissible variant which is unramified at the junk places.**

This is the interface for the Grünwald-type route: it suffices to find a `ZHyp` datum `α` vanishing on
the `cs(S)`-local groups (an *admissible variant*, so that `y + α` is a legitimate replacement of the
datum) such that `y + α` is **unramified at every junk place** — the places outside `cs(S)` that split
completely in `Λ`.  Then the node holds with the witness `Z :=` the extension of `y + α` by `0` off
`G_K`, and the sixth conjunct is supplied by the lane's
`Work.SSGRoute.transfer_vanishes_of_unramified` (the transfer kills the inertia of every conjugate of
`B`, which is again a junk place), with `V` produced there.

Such an `α` exists in particular when `y` itself is unramified at the junk places (take `α = 0`, which
recovers `Work.SSGRoute.shafarevich_z_construction_of_unramifiedOutside`), and the whole content of the
residual of Case C is the *general* existence of such an `α`: the extension problem for continuous
homs of profinite groups described in `ZConstruction/NOTE_session25.lean` §4. -/
theorem shafarevich_z_construction_of_unramifiedVariant
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y α : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hαZ : ZHyp (p := p) K Λ S α)
    (hαcs : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0)
    (hunram : ∀ Q : ValuationSubring Ω, SSGRoute.IsFinPlace k Q →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A Q) → SSGRoute.IsSplitIn k Λ Q →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k Q σ → y σ + α σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  have hyZ : ZHyp (p := p) K Λ S y := ⟨hy, hyc, hyS, hyT, hy0, hyinf⟩
  obtain ⟨hvZ, hvagree⟩ := ZHyp.add_of_vanishes_on_csGroups hyZ hαZ hαcs
  let Z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ + α σ else 0
  have hZval : ∀ σ, σ ∈ K.fixingSubgroup → Z σ = y σ + α σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ + α σ else 0) = y σ + α σ
    rw [if_pos hσ]
  have hZadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, Z (g * h) = Z g + Z h := by
    intro g hg h hh
    rw [hZval (g * h) (K.fixingSubgroup.mul_mem hg hh), hZval g hg, hZval h hh,
      hvZ.add g hg h hh]
  have hZloc : SSGRoute.IsLocConstOn K.fixingSubgroup Z := by
    obtain ⟨Uy, hUyo, hUyc⟩ := hyc
    obtain ⟨Uα, hUαo, hUαc⟩ := hαZ.locconst
    refine ⟨Uy ⊓ Uα, ?_, ?_⟩
    · simpa using hUyo.inter hUαo
    · intro g hg u hu huK
      rw [hZval (g * u) (K.fixingSubgroup.mul_mem hg huK), hZval g hg,
        hUyc g hg u hu.1 huK, hUαc g hg u hu.2 huK]
  have hZagrees : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ K.fixingSubgroup → Z σ = (fun σ => y σ + α σ) σ := by
    intro σ hσ
    rw [hZval σ hσ]
  obtain ⟨h1, h2, h3, h4, h5, _h6⟩ :=
    ZConstruction.zClauses_of_agrees_on_fixingSubgroup p k Ω K Λ E S (fun σ => y σ + α σ) Z
      hZagrees hvZ.add hvZ.locconst hvZ.hyS hvZ.hyinf sec hsec
  refine ⟨Z, h1, h2,
    (fun B hB hconj σ hσK hσd => by
      have h1' := h3 B hB hconj σ hσK hσd
      have h2' := hvagree B hB hconj σ hσK hσd
      show Z σ = y σ
      rw [h1']
      show y σ + α σ = y σ
      exact h2'),
    h4, h5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  have hunram' : ∀ (s : K ≃ₐ[k] K) (σ : Ω ≃ₐ[k] Ω), σ ∈ K.fixingSubgroup →
      SSGRoute.IsInertia k ((sec s)⁻¹ • B) σ → Z σ = 0 := by
    intro s σ hσ hI
    have hfin' : SSGRoute.IsFinPlace k ((sec s)⁻¹ • B) :=
      (isFinPlace_smul_iff B (sec s)⁻¹).mpr hB
    have hnot' : ∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A ((sec s)⁻¹ • B) :=
      fun A hA => ZConstruction.not_isConjPlace_smul (hnotconj A hA) ((sec s)⁻¹)
    have hsp' : SSGRoute.IsSplitIn k Λ ((sec s)⁻¹ • B) :=
      ZConstruction.isSplitIn_smul_of_isSplitIn hsplitΛ ((sec s)⁻¹)
    rw [hZval σ hσ]
    exact hunram ((sec s)⁻¹ • B) hfin' hnot' hsp' σ hσ hI
  obtain ⟨V, hVo, hVn, hVc, hVv⟩ :=
    transfer_vanishes_of_unramified p k Ω K (E := E) Z hZadd hZloc sec hsec B hB hsplitK hunram'
  exact ⟨V, hVo, hVn, hVc, hVv⟩

end Variant


section ConjInvariantNormNode

variable [NumberField k] [IsAlgClosure k Ω]

/-- **`Work.SSGRoute.shafarevich_z_construction` from a conjugation-invariant variant with vanishing
norm.**

Suppose there is an admissible variant `α` (a `ZHyp` datum vanishing on the `cs(S)`-local groups) such
that `y + α` is invariant under conjugation by the section elements on the decomposition groups of the
junk places and its norm `∑_{s : Gal(K|k)} s • (y δ + α δ)` vanishes there.  Then the node holds, with
the witness `Z :=` the extension of `y + α` by `0` off `G_K`, and with the *whole* group `V = ⊤` in the
sixth conjunct (`Work.SSGRoute.exists_V_of_transfer_of_conjInvariant_norm_vanishing`).

This subsumes `shafarevich_z_construction_of_normVanishing` (where the invariance is derived from a
normal level with trivial commutators) and covers in particular every datum with `K = k` and every
datum whose coefficient module has zero norm operator, at any degree of junk ramification. -/
theorem shafarevich_z_construction_of_conjInvariantNorm
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y α : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (hαZ : ZHyp (p := p) K Λ S α)
    (hαcs : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → α σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s)
    (hinv : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∀ δ ∈ SSGRoute.decomp k B, ∀ s : K ≃ₐ[k] K,
        y ((sec s)⁻¹ * δ * sec s) + α ((sec s)⁻¹ * δ * sec s) = y δ + α δ)
    (hN : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k Λ B →
      ∀ δ ∈ SSGRoute.decomp k B, (∑ s : K ≃ₐ[k] K, s • (y δ + α δ)) = 0) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E, ZConstruction.IsZConclusion (K := K) (Λ := Λ) (E := E) S sec y z := by
  classical
  have hyZ : ZHyp (p := p) K Λ S y := ⟨hy, hyc, hyS, hyT, hy0, hyinf⟩
  obtain ⟨hvZ, hvagree⟩ := ZHyp.add_of_vanishes_on_csGroups hyZ hαZ hαcs
  let Z : (Ω ≃ₐ[k] Ω) → E := fun σ => if σ ∈ K.fixingSubgroup then y σ + α σ else 0
  have hZval : ∀ σ, σ ∈ K.fixingSubgroup → Z σ = y σ + α σ := by
    intro σ hσ
    show (if σ ∈ K.fixingSubgroup then y σ + α σ else 0) = y σ + α σ
    rw [if_pos hσ]
  have hZagrees : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ K.fixingSubgroup → Z σ = (fun σ => y σ + α σ) σ := by
    intro σ hσ
    rw [hZval σ hσ]
  obtain ⟨h1, h2, h3, h4, h5, _h6⟩ :=
    ZConstruction.zClauses_of_agrees_on_fixingSubgroup p k Ω K Λ E S (fun σ => y σ + α σ) Z
      hZagrees hvZ.add hvZ.locconst hvZ.hyS hvZ.hyinf sec hsec
  refine ⟨Z, h1, h2,
    (fun B hB hconj σ hσK hσd => by
      have h1' := h3 B hB hconj σ hσK hσd
      have h2' := hvagree B hB hconj σ hσK hσd
      show Z σ = y σ
      rw [h1']
      show y σ + α σ = y σ
      exact h2'),
    h4, h5, ?_⟩
  intro B hB hnotconj hsplitΛ
  have hsplitK : SSGRoute.IsSplitIn k K B :=
    le_trans hsplitΛ (IntermediateField.fixingSubgroup_le hKΛ)
  have hinv' : ∀ δ ∈ SSGRoute.decomp k B, ∀ s : K ≃ₐ[k] K,
      Z ((sec s)⁻¹ * δ * sec s) = Z δ := by
    intro δ hδ s
    have hδK : δ ∈ K.fixingSubgroup := hsplitK hδ
    have hconjK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup :=
      conj_sec_mem_fixingSubgroup hsec s hδK
    rw [hZval _ hconjK, hZval δ hδK]
    exact hinv B hB hnotconj hsplitΛ δ hδ s
  have hN' : ∀ δ ∈ SSGRoute.decomp k B, (∑ s : K ≃ₐ[k] K, s • Z δ) = 0 := by
    intro δ hδ
    rw [hZval δ (hsplitK hδ)]
    exact hN B hB hnotconj hsplitΛ δ hδ
  exact exists_V_of_transfer_of_conjInvariant_norm_vanishing (K := K) (z := Z) (B := B) hinv' hN'

end ConjInvariantNormNode

end Work.SSGRoute
