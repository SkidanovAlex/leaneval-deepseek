/-!
# The `z`-data of Schmidt--Wingberg §4 reduces to the *spanning* case

`Work.SSGRoute.HasZData` (`ZConstruction/ZDataGlue.lean`) mentions the datum `y` only through the
**agreement clause** `z = y` on the decomposition groups of the places conjugate into `S`
(`Work.SSGRoute.hasZData_congr_cs`).  Hence the whole obligation `z_data_general_of_level` depends on
`y` only through the `𝔽_p`-subspace

  `csData K S y := span_{𝔽_p} { y σ : σ ∈ decomp k B ⊓ K.fixingGroup, B conjugate into S }`

generated by the local data of `y` at the places of `cs(S)`.

This file records the *first reduction of the induction* on `dim_{𝔽_p} E`:

* **`Work.SSGRoute.hasZData_of_fixes_data`** (the *peeling* step).  If a linear projection
  `π : E →ₗ E` fixes `y` pointwise on the local groups of `cs(S)`, then any `z`-data witness for the
  projected datum `π ∘ y` is a `z`-data witness for `y` itself.  Indeed only the agreement clause
  mentions `y`, and there `π (y σ) = y σ`.  Applied with `π` the projection onto a proper submodule
  containing `csData K S y`, this reduces the problem at `(Λ,S)` for the module `E` to the same
  problem for the *smaller* module `↥(csData K S y)` — which is the induction hypothesis.

* **`Work.SSGRoute.z_data_general_of_spanning_gate`**: consequently the full `z`-data for an
  arbitrary finite coefficient module follows by strong induction on `finrank (ZMod p) E` from the
  single residual statement `Work.SSGRoute.SpanningZData K Λ S`, namely the `z`-data in the case
  where the local data of `y` *spans* `E` (`csData K S y = ⊤`).

So the obligation of Schmidt--Wingberg §4 splits into

  (i) the *spanning* case `csData K S y = ⊤` — the case in which the local data really is a
      surjective family, i.e. the case the paper's construction (the auxiliary class of §4) has to
      handle; and
  (ii) everything else — handled here, with no arithmetic at all.

For the one-dimensional case (`finrank (ZMod p) E ≤ 1`) the two cases coincide: a non-trivial local
datum already spans a one-dimensional module, and that case is exactly what the arithmetic cores
`Work.SSGRoute.sw_z_exists_odd_sketch` (odd `p`) and
`Work.SSGRoute.shafarevich_z_data_two_kummerCore` (`p = 2`) supply.
-/

open scoped Pointwise

namespace Work.SSGRoute

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω]

/-- **The local data of `y` at the places of `cs(S)`.**  The `𝔽_p`-span of the values of `y` on the
level-`K` local groups `decomp k B ⊓ K.fixingSubgroup` of the places `B` conjugate into `S`.  This is
the only datum of `y` that the `z`-data sees (`Work.SSGRoute.hasZData_congr_cs`). -/
def csData (K : IntermediateField k Ω) {E : Type} [AddCommGroup E] [Module (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (y : (Ω ≃ₐ[k] Ω) → E) : Submodule (ZMod p) E :=
  Submodule.span (ZMod p)
    {x : E | ∃ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B ∧
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) ∧
      ∃ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B ∧ y σ = x}

/-- The local data of `y` at a place conjugate into `S` lies in `csData K S y`. -/
theorem mem_csData {K : IntermediateField k Ω} {S : Finset (ValuationSubring Ω)} {E : Type}
    [AddCommGroup E] [Module (ZMod p) E] {y : (Ω ≃ₐ[k] Ω) → E} {B : ValuationSubring Ω}
    (hB : SSGRoute.IsFinPlace k B) (hconj : ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    {σ : Ω ≃ₐ[k] Ω} (hσK : σ ∈ K.fixingSubgroup) (hσd : σ ∈ SSGRoute.decomp k B) :
    y σ ∈ csData (p := p) K S y :=
  Submodule.subset_span ⟨B, hB, hconj, σ, hσK, hσd, rfl⟩

/-- **Transport of the hypotheses on the datum along an additive map.**  Every clause of `ZHyp` is
either an additivity assertion (preserved by an additive map) or of the shape "`y σ = 0`" at a
specific `σ` (preserved because `f 0 = 0`).  The target needs only an additive structure, so this is
the version of `Work.SSGRoute.ZHyp.comp` used when the map lands in a *submodule* of `E`. -/
theorem ZHyp.mapAdd {K Λ : IntermediateField k Ω} {S : Finset (ValuationSubring Ω)}
    {E E' : Type} [AddCommGroup E] [AddCommGroup E'] {y : (Ω ≃ₐ[k] Ω) → E} (f : E →+ E')
    (h : ZHyp (p := p) K Λ S y) : ZHyp (p := p) K Λ S (fun σ => f (y σ)) where
  add g hg h' hh := by rw [h.add g hg h' hh, map_add]
  locconst := by
    obtain ⟨U, hUo, hU⟩ := h.locconst
    exact ⟨U, hUo, fun g hg u hu huK => by
      show f (y (g * u)) = f (y g)
      rw [hU g hg u hu huK]⟩
  hyS B hB hnot hsp σ hσ hσI := by rw [h.hyS B hB hnot hsp σ hσ hσI, map_zero]
  hyT B hB hconj σ hσ hσI := by rw [h.hyT B hB hconj σ hσ hσI, map_zero]
  hy0 B hB hconj hbad σ hσ hσd := by rw [h.hy0 B hB hconj hbad σ hσ hσd, map_zero]
  hyinf c hc hc2 := by rw [h.hyinf c hc hc2, map_zero]

/-- **The peeling step of the induction.**  Let `π : E →ₗ E` be a linear projection which fixes the
datum `y` pointwise on the local groups of the places conjugate into `S`.  Then a `z`-data witness
for the projected datum `π ∘ y` is already a `z`-data witness for `y`.

Indeed, of the six clauses of `HasZData` only the agreement clause mentions `y`, and there
`(π ∘ y) σ = π (y σ) = y σ` by hypothesis.  The point is that `π` may have a range of *smaller*
dimension than `E` (take `π` the projection onto a submodule containing `csData K S y`), which is how
the strong induction on `finrank (ZMod p) E` is run. -/
theorem hasZData_of_fixes_data {K Λ : IntermediateField k Ω} {S : Finset (ValuationSubring Ω)}
    {E : Type} [AddCommGroup E] [Module (ZMod p) E] {y : (Ω ≃ₐ[k] Ω) → E}
    (π : E →ₗ[ZMod p] E)
    (hfix : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → π (y σ) = y σ)
    {z : (Ω ≃ₐ[k] Ω) → E} (hz : HasZData K Λ S (fun σ => π (y σ)) z) :
    HasZData K Λ S y z := by
  obtain ⟨ha, hl, hg, hi, hs, hb⟩ := hz
  refine ⟨ha, hl, fun B hB hc σ hσK hσd => ?_, hi, hs, hb⟩
  have h1 := hg B hB hc σ hσK hσd
  have h2 := hfix B hB hc σ hσK hσd
  show z σ = y σ
  rw [h1]
  exact h2

/-- **The ambient hypotheses of the `z`-construction** (everything except the conditions on the
datum `y`): `K ≤ Λ`, `S` consists of pairwise non-conjugate finite places, and `S` contains
(up to conjugacy) every place that is ramified in `Λ` or lies over `p`. -/
structure ZAmbient (K Λ : IntermediateField k Ω) (S : Finset (ValuationSubring Ω)) where
  hKΛ : K ≤ Λ
  ζ : Ω
  hζ : IsPrimitiveRoot ζ p
  hζK : ζ ∈ K
  hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A
  hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B
  hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
    (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) →
    ∃ A ∈ S, SSGRoute.IsConjPlace k A B

/-- **The one-dimensional gate** (`A = μ_p`): the `z`-data for a coefficient module of
`𝔽_p`-dimension `≤ 1`, at *every* pair `(Λ,S)`.  This is precisely the shape of the two arithmetic
cores of Schmidt--Wingberg §4, `Work.SSGRoute.z_data_mup_core` (odd `p`) and
`Work.SSGRoute.shafarevich_z_data_two` (`p = 2`), which are both available *below* this node. -/
def MupGate (K : IntermediateField k Ω) : Prop :=
  ∀ (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ]
    (S : Finset (ValuationSubring Ω)), ZAmbient (p := p) K Λ S →
    ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E] [Finite E],
      Module.finrank (ZMod p) E ≤ 1 → ∀ (y : (Ω ≃ₐ[k] Ω) → E),
      ZHyp (p := p) K Λ S y → ∃ z : (Ω ≃ₐ[k] Ω) → E, HasZData K Λ S y z

/-- **The residual obligation of the `z`-construction**: the `z`-data when the local data of `y`
*spans* the coefficient module and the module has dimension `≥ 2`.  This is the case in which the
datum is a genuinely surjective family of local data, i.e. the case that Schmidt--Wingberg §4
handles by the auxiliary-class construction (`ỹ` of pp. 18--19, the Tate--Poitou realisation).  The
non-spanning cases `csData K S y ≠ ⊤` are handled below by the peeling step, and the
one-dimensional cases by `Work.SSGRoute.MupGate`. -/
def SpanningGate (K : IntermediateField k Ω) : Prop :=
  ∀ (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ]
    (S : Finset (ValuationSubring Ω)), ZAmbient (p := p) K Λ S →
    ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E] [Finite E],
      2 ≤ Module.finrank (ZMod p) E → ∀ (y : (Ω ≃ₐ[k] Ω) → E),
      ZHyp (p := p) K Λ S y → csData (p := p) K S y = ⊤ →
      ∃ z : (Ω ≃ₐ[k] Ω) → E, HasZData K Λ S y z

/-- **The full `z`-data from the two gates.**  Strong induction on `finrank (ZMod p) E`: in dimension
`≤ 1` apply the one-dimensional gate; in dimension `≥ 2` apply the spanning gate if the local data
spans `E`, and otherwise peel off the complement of `csData K S y` (`hasZData_of_fixes_data`),
reducing to the coefficient module `↥(csData K S y)` of strictly smaller dimension.

This is the precise sense in which the obligation `Work.SSGRoute.z_data_general_of_ramified` (and
with it Schmidt--Wingberg's Theorem 13 in the `HasZData` form) is the conjunction of the two gates:
the arithmetic of the theorem is entirely in `MupGate` and `SpanningGate`; everything else is the
linear algebra of a vector space and the elementary `z`-data calculus. -/
theorem z_data_general_of_gates {K : IntermediateField k Ω}
    [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (hmup : MupGate (p := p) K) (hspan : SpanningGate (p := p) K) :
    ∀ (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ]
      (S : Finset (ValuationSubring Ω)), ZAmbient (p := p) K Λ S →
      ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E] [Finite E]
        (y : (Ω ≃ₐ[k] Ω) → E), ZHyp (p := p) K Λ S y →
        ∃ z : (Ω ≃ₐ[k] Ω) → E, HasZData K Λ S y z := by
  intro Λ _instΛf _instΛg S hAmb
  have key : ∀ (m : ℕ), ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E] [Finite E],
      Module.finrank (ZMod p) E = m → ∀ (y : (Ω ≃ₐ[k] Ω) → E),
      ZHyp (p := p) K Λ S y → ∃ z : (Ω ≃ₐ[k] Ω) → E, HasZData K Λ S y z := by
    intro m
    induction m using Nat.strong_induction_on with
    | _ m ih =>
      intro E _instE _instM _instF hfin y hy
      by_cases hdim : Module.finrank (ZMod p) E ≤ 1
      · exact hmup Λ S hAmb E hdim y hy
      · push_neg at hdim
        by_cases hsp : csData (p := p) K S y = ⊤
        · exact hspan Λ S hAmb E hdim y hy hsp
        · haveI : FiniteDimensional (ZMod p) E := Module.Finite.of_finite
          obtain ⟨C, hc⟩ := Submodule.exists_isCompl (csData (p := p) K S y)
          have hlt : Module.finrank (ZMod p) ↥(csData (p := p) K S y) <
              Module.finrank (ZMod p) E := Submodule.finrank_lt hsp
          have hltm : Module.finrank (ZMod p) ↥(csData (p := p) K S y) < m := by
            rw [← hfin]; exact hlt
          have hy' : ZHyp (p := p) K Λ S
              (fun σ => (csData (p := p) K S y).projectionOnto C hc (y σ)) :=
            ZHyp.mapAdd (f := ((csData (p := p) K S y).projectionOnto C hc).toAddMonoidHom) hy
          obtain ⟨z', hz'⟩ := ih _ hltm ↥(csData (p := p) K S y) rfl _ hy'
          have hmap := hasZData_map (A := ↥(csData (p := p) K S y)) (B := E)
            (f := (Submodule.subtype (csData (p := p) K S y)).toAddMonoidHom)
            (fun _ _ h => Subtype.ext h) hz'
          refine ⟨fun σ => (z' σ : E), hasZData_of_fixes_data
            (π := (Submodule.subtype (csData (p := p) K S y)).comp
              ((csData (p := p) K S y).projectionOnto C hc)) ?_ hmap⟩
          intro B hB hconj σ hσK hσd
          have hmem : y σ ∈ csData (p := p) K S y := mem_csData (p := p) (K := K) hB hconj hσK hσd
          show ((Submodule.subtype (csData (p := p) K S y)).comp
            ((csData (p := p) K S y).projectionOnto C hc)) (y σ) = y σ
          rw [LinearMap.comp_apply, Submodule.projectionOnto_apply_of_mem_left _ hmem]
          rfl
  intro E _instE _instM _instF y hy
  exact key (Module.finrank (ZMod p) E) E rfl y hy

end Work.SSGRoute
