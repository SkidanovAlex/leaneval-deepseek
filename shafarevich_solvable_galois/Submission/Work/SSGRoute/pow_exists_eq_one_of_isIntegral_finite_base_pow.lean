/-- **Roots of unity in a finite extension of a finite field, integral elements, prime-to-`p`
order.**

Generalisation of `Work.SSGRoute.pow_exists_eq_one_of_isIntegral_finite_base`, in which the base
hypothesis `Nat.card F = p` is weakened to `Nat.card F = p ^ f` with `0 < f`.  The proof is the
same: put `E = F⟮x⟯`, so `Nat.card E = Nat.card F ^ [E : F] = p ^ (f * [E : F])`; take
`N = Nat.card Eˣ = Nat.card E - 1`; if `p ∣ N` then `p ∣ Nat.card E` as well (the exponent
`f * [E : F]` is positive), hence `p ∣ 1`, forcing `p ^ (f * [E:F]) ≤ 1 < 2 ≤ Nat.card E`, a
contradiction. -/
theorem pow_exists_eq_one_of_isIntegral_finite_base_pow {F K : Type*} [Field F] [Field K]
    [Algebra F K] [Finite F] (p f : ℕ) (hf : 0 < f) (hp : Nat.card F = p ^ f) {x : K}
    (hx : x ≠ 0) (hint : IsIntegral F x) :
    ∃ N : ℕ, 0 < N ∧ ¬ p ∣ N ∧ x ^ N = 1 := by
  haveI : Fintype F := Fintype.ofFinite F
  -- The cardinality of `F` is `p ^ f` with `f > 0`, hence `p ≥ 2`.
  have hcardF : 1 < p ^ f := by
    rw [← hp, Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hpge2 : 2 ≤ p := by
    by_contra h
    rw [Nat.not_le] at h
    have hle1 : p ≤ 1 := by omega
    have hpow : p ^ f ≤ 1 := by
      calc p ^ f ≤ 1 ^ f := Nat.pow_le_pow_left hle1 f
        _ = 1 := one_pow f
    omega
  -- The subfield generated by `x`; it is a finite extension of `F`.
  set E : IntermediateField F K := IntermediateField.adjoin F ({x} : Set K) with hE
  have hxmem : x ∈ E := by
    rw [hE]; exact IntermediateField.subset_adjoin F {x} (Set.mem_singleton x)
  have hfd : FiniteDimensional F E := by
    rw [hE]
    exact IntermediateField.finiteDimensional_adjoin (S := {x})
      (fun y hy => by rw [Set.mem_singleton_iff] at hy; rw [hy]; exact hint)
  haveI : Module.Finite F E := hfd
  haveI : Finite E := Module.finite_of_finite F
  -- `E` has cardinality `(p ^ f) ^ [E : F] = p ^ (f * [E : F])`.
  have hcard : Nat.card E = p ^ (f * Module.finrank F E) := by
    rw [Module.natCard_eq_pow_finrank (K := F) (V := E), hp, pow_mul]
  -- Since `E` is a field, `Nat.card E ≥ 2`.
  have hge2 : 2 ≤ Nat.card E := by
    have h0 : Nat.card E ≠ 0 := by rw [hcard]; exact pow_ne_zero _ (by omega)
    have h1 : Nat.card E ≠ 1 := by
      intro h
      have hsub : Subsingleton E := (Nat.card_eq_one_iff_unique.mp h).1
      exact zero_ne_one (α := E) (hsub.elim _ _)
    omega
  -- Hence the extension degree `[E : F]` is at least `1`.
  have hd : 1 ≤ Module.finrank F E := by
    by_contra h
    rw [Nat.not_le] at h
    have h0 : Module.finrank F E = 0 := by omega
    rw [h0, mul_zero, pow_zero] at hcard
    omega
  -- Take `N = |Eˣ| = p ^ (f * [E : F]) - 1`.
  refine ⟨Nat.card Eˣ, ?_, ?_, ?_⟩
  · rw [Nat.card_units]; omega
  · rw [Nat.card_units]
    intro hdvd
    have hdvdp : p ∣ Nat.card E := by
      rw [hcard]
      exact dvd_pow_self p (Nat.mul_ne_zero (Nat.pos_iff_ne_zero.mp hf) (by omega))
    have hnat : Nat.card E - (Nat.card E - 1) = 1 := Nat.sub_sub_self (by omega)
    have hdvd1 : p ∣ 1 := by rw [← hnat]; exact Nat.dvd_sub hdvdp hdvd
    have := Nat.le_of_dvd (by norm_num) hdvd1
    omega
  · -- `x`, viewed in `Eˣ`, has order dividing `|Eˣ|` by Lagrange.
    have hxe : (⟨x, hxmem⟩ : E) ≠ 0 := by
      intro h; exact hx (congrArg Subtype.val h)
    let ye : Eˣ := Units.mk0 (⟨x, hxmem⟩ : E) hxe
    have hpow : ye ^ Nat.card Eˣ = 1 := pow_card_eq_one'
    have hE' : ((ye : E) ^ Nat.card Eˣ : E) = 1 := by
      rw [← Units.val_pow_eq_pow_val, hpow, Units.val_one]
    have hye : (ye : E) = ⟨x, hxmem⟩ := Units.val_mk0 hxe
    rw [hye] at hE'
    have := congrArg (fun z : E => (z : K)) hE'
    rw [IntermediateField.coe_pow, IntermediateField.coe_one] at this
    rwa [show ((⟨x, hxmem⟩ : E) : K) = x from rfl] at this

end Work.SSGRoute
