/-! ## Local properties of the formal corestriction `X`

For the candidate global class `x = cor(y)` of the paper, the first local condition of Theorem 13
asks that `x` agree with `X δ = ∑_{s : Gal(K/k)} s • y(sec(s)⁻¹ * δ * sec(s))` on the decomposition
groups of the places of `S` that split in `K`, and the last-but-one asks that `x` vanish on the
inertia of every place outside `S` that is not split in `Λ`.  The next lemma records the two
properties of the formal corestriction `X` itself that make this consistent: `X` is a `1`-cocycle
on `G_K` (it is additive there, and `G_K` acts trivially on `E`), and it kills the inertia of every
such place.  Both are proved in the sibling modules
`Work.SSGRoute.corestriction_hom_on_fixingSubgroup` and
`Work.SSGRoute.corestriction_vanishes_on_inertia`. -/

/-- The formal corestriction `X` is a `1`-cocycle on `G_K` for the action of `G_K` on `E` (trivial on
`G_K`), and it vanishes on the inertia of every finite place `B` that lies over no element of `S`
and is not split in `Λ`. -/
theorem corestriction_cocycle_and_vanishes_on_inertia
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    IsCocycleOn (res k K) K.fixingSubgroup
        (fun δ => ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))
      ∧ IsLocConstOn K.fixingSubgroup
        (fun δ => ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))
      ∧ (∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
          ¬ IsSplitIn k Λ B → ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ →
          (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * σ * sec s)) = 0) := by
  refine ⟨?_, ?_, ?_⟩
  · intro g hg h hh
    have hg1 : res k K g = 1 := by
      rw [← MonoidHom.mem_ker]
      rwa [IntermediateField.restrictNormalHom_ker K]
    rw [hg1, one_smul]
    exact corestriction_hom_on_fixingSubgroup p k Ω K E y hy sec hsec g hg h hh
  · exact isLocConstOn_corestriction p k Ω K E y hy hyc sec hsec
  · exact corestriction_vanishes_on_inertia p k Ω K Λ hKΛ E S hSfin hSram y hy hyS hyT sec hsec


/-! ## The corestriction class satisfies the first and the third local conditions

`exists_corestriction` produces a global continuous `1`-cocycle `x` whose restriction to `G_K` is the
formal corestriction `X`.  Because the decomposition group of a place that *splits* in `K` is
contained in `G_K`, the first local condition of Theorem 13 (`x` agrees with `X` on it) is then
automatic; and the third local condition (`x` kills the inertia of every place outside `S` that is
not split in `Λ`) follows from the corresponding property of `X`, using that such a place is
unramified in `Λ|k` and therefore has its inertia inside `G_Λ ≤ G_K`.  This is the part of the
conclusion that only uses the values of `x` on `G_K`. -/

theorem corestriction_satisfies_split_and_inertia
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ δ ∈ K.fixingSubgroup, x δ = ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ¬ IsSplitIn k Λ B → ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) := by
  obtain ⟨x, hcoc, hlc, hxH⟩ := exists_corestriction p k Ω K E y hy hyc sec hsec
  refine ⟨x, hcoc, hlc, hxH, ?_, ?_⟩
  · intro A hA hsplit
    refine ⟨0, fun δ hδ => ?_⟩
    have hδH : δ ∈ K.fixingSubgroup := hsplit hδ
    change x δ - (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) = (res k K) δ • (0 : E) - 0
    rw [hxH δ hδH]
    simp
  · intro B hB hconj hnotsplit σ hσ
    have hnotram : ¬ IsRamifiedIn k Λ B :=
      (not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
    have hσΛ : σ ∈ Λ.fixingSubgroup :=
      mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hnotram σ hσ
    have hσH : σ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ hσΛ
    rw [hxH σ hσH]
    exact corestriction_vanishes_on_inertia p k Ω K Λ hKΛ E S hSfin hSram y hy hyS hyT
      sec hsec B hB hconj hnotsplit σ hσ

/-! ## The corestriction cocycle and its local behaviour

This section contains the assembly of Theorem 13 *modulo* the two clauses that the paper obtains
from the construction of the auxiliary class `z` (namely the "`x_p` is cyclic" clause and the
involution clause for `p = 2`).  With `x := corCocycle y sec` (the explicit corestriction cocycle of
`exists_corestriction`):

* `corCocycle_section_change` : two sections of `res k K` give corestriction cocycles differing by
  the explicit coboundary `M = ∑ t, t • y ((sec t)⁻¹ * sec' t)`;
* `exists_adapted_section` : there is a section of `res k K` whose values over the image `S₀` of
  `D_A` lie in `D_A`, and for which moving the argument by an element of `S₀` on the left changes
  the value by an element of `D_A` (so that `(sec s)⁻¹ • A` depends only on the right coset `S₀ s`);
* `corCocycle_adapted_section_vanishes` : for such an adapted section the corestriction cocycle
  vanishes identically on `D_A` (each term of the corestriction sum lies in the decomposition group
  of a conjugate of `A`, where `y` vanishes by `hy0`);
* `corCocycle_satisfies_conditions` : consequently `corCocycle y sec` satisfies the clauses (1)–(4)
  and (6) of the theorem.

-/

section AdaptedSection

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]

/-- A crossed homomorphism on `G_K` (i.e. an additive map, `G_K` acting trivially) kills `1`. -/
lemma corestriction_y_one (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h) : y 1 = 0 := by
  have h := hy 1 (one_mem _) 1 (one_mem _)
  rw [mul_one] at h
  have h' : y 1 + 0 = y 1 + y 1 := by rw [add_zero]; exact h
  exact (add_left_cancel h').symm

lemma corestriction_y_inv (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    {u : Ω ≃ₐ[k] Ω} (hu : u ∈ K.fixingSubgroup) : y u⁻¹ = - y u := by
  have h := hy u⁻¹ (Subgroup.inv_mem _ hu) u hu
  rw [inv_mul_cancel] at h
  rw [corestriction_y_one k Ω K E y hy] at h
  exact eq_neg_of_add_eq_zero_left h.symm

lemma corestriction_y_conj (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    {u w : Ω ≃ₐ[k] Ω} (hu : u ∈ K.fixingSubgroup) (hw : w ∈ K.fixingSubgroup) :
    y (u⁻¹ * w * u) = y w := by
  have h1 := hy u⁻¹ (Subgroup.inv_mem _ hu) (w * u) (mul_mem hw hu)
  have h2 := hy w hw u hu
  rw [← mul_assoc] at h1
  rw [h1, h2, corestriction_y_inv k Ω K E y hy hu]
  abel

/-- **Changing the section changes the corestriction cocycle by an explicit coboundary.**
For two sections `sec`, `sec'` of `res k K`, the two corestriction cocycles differ by the coboundary
of `M = ∑ t, t • y ((sec t)⁻¹ * sec' t)`. -/
theorem corCocycle_section_change (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (sec sec' : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hsec : ∀ s, res k K (sec s) = s) (hsec' : ∀ s, res k K (sec' s) = s) :
    ∀ g : Ω ≃ₐ[k] Ω,
      corCocycle k Ω K E y sec' g = corCocycle k Ω K E y sec g
        + ((res k K g) • (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t))
            - (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t))) := by
  intro g
  set M : E := ∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t) with hM
  have hu_mem : ∀ t : K ≃ₐ[k] K, (sec t)⁻¹ * sec' t ∈ K.fixingSubgroup := by
    intro t
    rw [← mem_fixingSubgroup_iff_res_eq_one, map_mul, map_inv, hsec, hsec', inv_mul_cancel]
  have hterm : ∀ t : K ≃ₐ[k] K,
      y ((sec' t)⁻¹ * g * sec' ((res k K g)⁻¹ * t))
        = y ((sec t)⁻¹ * sec' t)⁻¹
          + y ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t))
          + y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t)) := by
    intro t
    have h1 : sec' t = sec t * ((sec t)⁻¹ * sec' t) := by group
    have h2 : (sec' t)⁻¹ = ((sec t)⁻¹ * sec' t)⁻¹ * (sec t)⁻¹ := by rw [h1]; group
    have h3 : sec' ((res k K g)⁻¹ * t)
        = sec ((res k K g)⁻¹ * t) * ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t)) := by
      group
    have hw : (sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t) ∈ K.fixingSubgroup :=
      corCocycle_arg_mem k Ω K sec hsec g t
    have harg : (sec' t)⁻¹ * g * sec' ((res k K g)⁻¹ * t)
        = ((sec t)⁻¹ * sec' t)⁻¹
          * ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t))
          * ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t)) := by
      rw [h2, h3]; group
    rw [harg, mul_assoc]
    rw [hy _ (Subgroup.inv_mem _ (hu_mem t)) _
          (mul_mem hw (hu_mem ((res k K g)⁻¹ * t)))]
    rw [hy _ hw _ (hu_mem ((res k K g)⁻¹ * t))]
    abel
  have hsum : (∑ t : K ≃ₐ[k] K, t • y ((sec' t)⁻¹ * g * sec' ((res k K g)⁻¹ * t)))
      = (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t)⁻¹)
        + (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t)))
        + (∑ t : K ≃ₐ[k] K,
            t • y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t))) := by
    calc (∑ t : K ≃ₐ[k] K, t • y ((sec' t)⁻¹ * g * sec' ((res k K g)⁻¹ * t)))
        = ∑ t : K ≃ₐ[k] K, t • (y ((sec t)⁻¹ * sec' t)⁻¹
            + y ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t))
            + y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t))) :=
          Finset.sum_congr rfl (fun t _ => by rw [hterm t])
      _ = ∑ t : K ≃ₐ[k] K, (t • y ((sec t)⁻¹ * sec' t)⁻¹
            + t • y ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t))
            + t • y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t))) :=
          Finset.sum_congr rfl (fun t _ => by rw [smul_add, smul_add])
      _ = (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t)⁻¹)
        + (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * g * sec ((res k K g)⁻¹ * t)))
        + (∑ t : K ≃ₐ[k] K,
            t • y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t))) := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  have hfirst : (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t)⁻¹) = - M := by
    rw [hM, ← Finset.sum_neg_distrib]
    exact Finset.sum_congr rfl (fun t _ => by rw [corestriction_y_inv k Ω K E y hy (hu_mem t), smul_neg])
  have hthird : (∑ t : K ≃ₐ[k] K,
      t • y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t))) = (res k K g) • M := by
    calc (∑ t : K ≃ₐ[k] K,
          t • y ((sec ((res k K g)⁻¹ * t))⁻¹ * sec' ((res k K g)⁻¹ * t)))
        = ∑ s : K ≃ₐ[k] K, ((res k K g) * s) • y ((sec s)⁻¹ * sec' s) :=
          (sum_mulLeft_smul (res k K g) (fun t : K ≃ₐ[k] K => y ((sec t)⁻¹ * sec' t))).symm
      _ = (res k K g) • M := by
          rw [hM, Finset.smul_sum]
          exact Finset.sum_congr rfl (fun s _ => mul_smul (res k K g) s _)
  simp only [corCocycle]
  rw [hsum, hfirst, hthird]
  abel



/-- **A section of `res k K` adapted to a place `A`.**  Its values over the image `S₀ = π(D_A)`
of the decomposition group lie in `D_A`, and moving by an element of `S₀` on the left only changes
the value by an element of `D_A` (so that the place `(sec s)⁻¹ • A` depends only on the right
coset `S₀ s`). -/
theorem exists_adapted_section (A : ValuationSubring Ω) :
    ∃ sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω),
      (∀ s, res k K (sec s) = s) ∧
      (∀ t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) → sec t ∈ decomp k A) ∧
      (∀ s t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) →
        sec (t * s) * (sec s)⁻¹ ∈ decomp k A) := by
  classical
  have hmem : ∀ t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) ↔
      ∃ g ∈ decomp k A, res k K g = t := fun t => Subgroup.mem_map
  have hsec : ∀ s : K ≃ₐ[k] K, ∃ g : Ω ≃ₐ[k] Ω, res k K g = s ∧
      (s ∈ (decomp k A).map (res k K) → g ∈ decomp k A) := by
    intro s
    by_cases hs : s ∈ (decomp k A).map (res k K)
    · obtain ⟨g, hg, hgres⟩ := (hmem s).mp hs
      exact ⟨g, hgres, fun _ => hg⟩
    · obtain ⟨g, hg⟩ := AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := K) (E := Ω) s
      exact ⟨g, hg, fun h => absurd h hs⟩
  let base : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω) := fun s => Classical.choose (hsec s)
  have base_res : ∀ s, res k K (base s) = s := fun s => (Classical.choose_spec (hsec s)).1
  have base_mem : ∀ s, s ∈ (decomp k A).map (res k K) → base s ∈ decomp k A :=
    fun s => (Classical.choose_spec (hsec s)).2
  -- right coset representatives of `S₀ = π(D_A)`
  let r : Setoid (K ≃ₐ[k] K) :=
    { r := fun a b => ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {a}
        = ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {b}
      iseqv := ⟨fun a => rfl, fun h => h.symm, fun h1 h2 => h1.trans h2⟩ }
  let rep : (K ≃ₐ[k] K) → (K ≃ₐ[k] K) := fun s => Quotient.out (Quotient.mk r s)
  have hrep : ∀ s : K ≃ₐ[k] K,
      ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {rep s}
        = ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {s} :=
    fun s => Quotient.exact (Quotient.out_eq (Quotient.mk r s))
  have hrep_mul : ∀ t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) →
      ∀ s : K ≃ₐ[k] K, rep (t * s) = rep s := by
    intro t ht s
    have hset : ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {t * s}
        = ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {s} := by
      ext u
      rw [Set.mem_mul, Set.mem_mul]
      constructor
      · rintro ⟨a, ha, b, hb, hab⟩
        rw [Set.mem_singleton_iff] at hb
        exact ⟨a * t, mul_mem ha ht, s, rfl, by rw [← hab, hb]; group⟩
      · rintro ⟨a, ha, b, hb, hab⟩
        rw [Set.mem_singleton_iff] at hb
        exact ⟨a * t⁻¹, mul_mem ha (Subgroup.inv_mem _ ht), t * s, rfl,
          by rw [← hab, hb]; group⟩
    have hclass : Quotient.mk r (t * s) = Quotient.mk r s := Quotient.sound hset
    show Quotient.out (Quotient.mk r (t * s)) = Quotient.out (Quotient.mk r s)
    rw [hclass]
  have hdev : ∀ s : K ≃ₐ[k] K, ∃ t : (decomp k A).map (res k K),
      (t : K ≃ₐ[k] K) * rep s = s := by
    intro s
    have hmem' : s ∈ ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {s} :=
      ⟨1, one_mem _, s, rfl, one_mul s⟩
    rw [← hrep s] at hmem'
    rw [Set.mem_mul] at hmem'
    obtain ⟨a, ha, b, hb, hab⟩ := hmem'
    rw [Set.mem_singleton_iff] at hb
    exact ⟨⟨a, ha⟩, by rw [← hb]; exact hab⟩
  let dev : (s : K ≃ₐ[k] K) → (decomp k A).map (res k K) := fun s => Classical.choose (hdev s)
  have hdev_spec : ∀ s : K ≃ₐ[k] K, ((dev s : (decomp k A).map (res k K)) : K ≃ₐ[k] K) * rep s = s :=
    fun s => Classical.choose_spec (hdev s)
  have hrep_mem : ∀ t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) →
      rep t ∈ (decomp k A).map (res k K) := by
    intro t ht
    have hmem'' : rep t ∈ ((decomp k A).map (res k K) : Set (K ≃ₐ[k] K)) * {rep t} :=
      ⟨1, one_mem _, rep t, rfl, one_mul _⟩
    rw [hrep t] at hmem''
    rw [Set.mem_mul] at hmem''
    obtain ⟨a, ha, b, hb, hab⟩ := hmem''
    rw [Set.mem_singleton_iff] at hb
    rw [hb] at hab
    rw [← hab]
    exact mul_mem ha ht
  let secF : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω) :=
    fun s => base ((dev s : (decomp k A).map (res k K)) : K ≃ₐ[k] K) * base (rep s)
  have hsecF : ∀ s, secF s = base ((dev s : (decomp k A).map (res k K)) : K ≃ₐ[k] K)
      * base (rep s) := fun s => rfl
  refine ⟨secF, ?_, ?_, ?_⟩
  · intro s
    change res k K (secF s) = s
    rw [hsecF s, map_mul, base_res, base_res, hdev_spec s]
  · intro t ht
    change secF t ∈ decomp k A
    rw [hsecF t]
    exact mul_mem (base_mem _ ((dev t).2)) (base_mem _ (hrep_mem t ht))
  · intro s t ht
    change secF (t * s) * (secF s)⁻¹ ∈ decomp k A
    have hrep_eq : rep (t * s) = rep s := hrep_mul t ht s
    have h1 : base ((dev (t * s) : (decomp k A).map (res k K)) : K ≃ₐ[k] K) ∈ decomp k A :=
      base_mem _ ((dev (t * s)).2)
    have h2 : base ((dev s : (decomp k A).map (res k K)) : K ≃ₐ[k] K) ∈ decomp k A :=
      base_mem _ ((dev s).2)
    have hprod : secF (t * s) * (secF s)⁻¹
        = base ((dev (t * s) : (decomp k A).map (res k K)) : K ≃ₐ[k] K)
          * (base ((dev s : (decomp k A).map (res k K)) : K ≃ₐ[k] K))⁻¹ := by
      rw [hsecF (t * s), hsecF s, hrep_eq, mul_inv_rev]
      group
    rw [hprod]
    exact mul_mem h1 (inv_mem h2)

/-- **The corestriction cocycle of an adapted section vanishes on the decomposition group.**
If `y` vanishes on `D_B ∩ G_K` for every place `B` over a prime of `S` that is not split in `K`
(hypothesis `hy0`), and `sec` is a section adapted to a place `A ∈ S` that is not split in `K`, then
the corestriction cocycle of `y` (for `sec`) vanishes identically on `D_A`. -/
theorem corCocycle_adapted_section_vanishes
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (A : ValuationSubring Ω) (hA : A ∈ S) (hnotsplit : ¬ IsSplitIn k K A)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec_res : ∀ s, res k K (sec s) = s)
    (hadapt : ∀ s t : K ≃ₐ[k] K, t ∈ (decomp k A).map (res k K) →
        sec (t * s) * (sec s)⁻¹ ∈ decomp k A) :
    ∀ δ ∈ decomp k A, corCocycle k Ω K E y sec δ = 0 := by
  intro δ hδ
  simp only [corCocycle]
  refine Finset.sum_eq_zero (fun s _ => ?_)
  set B : ValuationSubring Ω := (sec s)⁻¹ • A with hB
  have hτ : (res k K δ)⁻¹ ∈ (decomp k A).map (res k K) :=
    ⟨δ⁻¹, Subgroup.inv_mem _ hδ, by rw [map_inv]⟩
  have hwA : sec ((res k K δ)⁻¹ * s) * (sec s)⁻¹ ∈ decomp k A := hadapt s _ hτ
  have hwK : (sec s)⁻¹ * δ * sec ((res k K δ)⁻¹ * s) ∈ K.fixingSubgroup := by
    rw [← mem_fixingSubgroup_iff_res_eq_one, map_mul, map_mul, map_inv, hsec_res, hsec_res]
    group
  have hwD : (sec s)⁻¹ * δ * sec ((res k K δ)⁻¹ * s) ∈ decomp k B := by
    rw [MulAction.mem_stabilizer_iff]
    have hδA : δ • A = A := hδ
    have hτA : (sec ((res k K δ)⁻¹ * s) * (sec s)⁻¹) • A = A := hwA
    show ((sec s)⁻¹ * δ * sec ((res k K δ)⁻¹ * s)) • ((sec s)⁻¹ • A) = (sec s)⁻¹ • A
    have hstep : sec ((res k K δ)⁻¹ * s) • ((sec s)⁻¹ • A) = A := by
      rw [← mul_smul]; exact hτA
    rw [mul_smul, mul_smul, hstep, hδA]
  have hBfin : IsFinPlace k B := by
    rw [hB]; exact (isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA)
  have hBconj : ∃ A' ∈ S, IsConjPlace k A' B := ⟨A, hA, ⟨(sec s)⁻¹, by rw [hB]⟩⟩
  have hBsplit : ¬ IsSplitIn k K B := by
    rw [hB]
    exact fun h => hnotsplit ((isSplitIn_conj K inferInstance A (sec s)⁻¹).mp h)
  have hz : y ((sec s)⁻¹ * δ * sec ((res k K δ)⁻¹ * s)) = 0 :=
    hy0 B hBfin hBconj (Or.inl hBsplit) _ hwK hwD
  rw [hz, smul_zero]


/-- **The corestriction cocycle satisfies all the local conditions of Theorem 13 except the
cyclic one.**  With `x := corCocycle y sec`: it is a locally constant `1`-cocycle on `G_k`, it
agrees with the formal corestriction `∑ s, s • y (sec s⁻¹ δ sec s)` on the decomposition groups of
the places of `S` that split in `K`, it *vanishes* on the decomposition groups of the places of `S`
that do not split in `K` (for a suitable section), and it vanishes on the inertia of every finite
place outside `S` that is not split in `Λ`. -/
theorem corCocycle_satisfies_conditions
    (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ] (hKΛ : K ≤ Λ)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    IsCocycleOn (res k K) ⊤ (corCocycle k Ω K E y sec) ∧
    IsLocConstOn ⊤ (corCocycle k Ω K E y sec) ∧
    (∀ A ∈ S, IsSplitIn k K A →
      IsCoboundaryOn (res k K) (decomp k A)
        (fun δ => corCocycle k Ω K E y sec δ
          - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
    (∀ A ∈ S, ¬ IsSplitIn k K A →
      IsCoboundaryOn (res k K) (decomp k A) (corCocycle k Ω K E y sec)) ∧
    (∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → corCocycle k Ω K E y sec σ = 0) := by
  refine ⟨corCocycle_isCocycle k Ω K E y hy sec hsec,
    corCocycle_isLocConstOn k Ω K E y hyc sec hsec, ?_, ?_, ?_⟩
  · -- (3) on the places that split in `K`
    intro A hA hsplit
    refine ⟨0, fun δ hδ => ?_⟩
    show corCocycle k Ω K E y sec δ
      - (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) = (res k K δ) • (0 : E) - 0
    have hδH : δ ∈ K.fixingSubgroup := hsplit hδ
    rw [corCocycle_restrict k Ω K E y sec δ hδH]
    simp
  · -- (4) on the places that do not split in `K`
    intro A hA hnotsplit
    obtain ⟨sec', hsec'res, -, hadapt⟩ := exists_adapted_section (k := k) (Ω := Ω) (K := K) A
    have hvanish : ∀ δ ∈ decomp k A, corCocycle k Ω K E y sec' δ = 0 :=
      corCocycle_adapted_section_vanishes p k Ω K E S hSfin y hy hy0 A hA hnotsplit sec'
        hsec'res hadapt
    refine ⟨-(∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t)), fun δ hδ => ?_⟩
    have hchange := corCocycle_section_change k Ω K E y hy sec sec' hsec hsec'res δ
    rw [hvanish δ hδ] at hchange
    have hval : corCocycle k Ω K E y sec δ
        = - ((res k K δ) • (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t))
            - (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t))) :=
      eq_neg_of_add_eq_zero_left hchange.symm
    rw [hval]
    simp only [smul_neg]
    abel
  · -- (6) outside `S`
    intro B hB hconj hnotsplit σ hσ
    have hnotram : ¬ IsRamifiedIn k Λ B :=
      (not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
    have hσΛ : σ ∈ Λ.fixingSubgroup :=
      mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hnotram σ hσ
    have hσH : σ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ hσΛ
    rw [corCocycle_restrict k Ω K E y sec σ hσH]
    exact corestriction_vanishes_on_inertia p k Ω K Λ hKΛ E S hSfin hSram y hy hyS hyT sec hsec
      B hB hconj hnotsplit σ hσ




/-- **Theorem 13 of Schmidt–Wingberg, modulo the "cyclic" and `p = 2`-involution clauses.**

All of the local conditions of Theorem 13 that are satisfied by the *explicit* corestriction cocycle
of the given class `y` (with the given section `sec`) hold: it is a locally constant `1`-cocycle on
`G_k`, it agrees with the formal corestriction on the decomposition groups of the places of `S` that
split in `K`, it is a coboundary on the decomposition groups of the places of `S` that do not split
in `K`, and it vanishes on the inertia of the finite places outside `S` that are not split in `Λ`.

The two remaining clauses of the theorem (the "`x_p` is cyclic for `p ∉ T`" clause, and the
involution clause in characteristic `2`) are not satisfied by an arbitrary corestriction and are
supplied by the construction of the auxiliary class `z` of Schmidt–Wingberg §4. -/
theorem shafarevich_theorem13_partial
    (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ] (hKΛ : K ≤ Λ)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram y hy hyc hyS hyT hy0 sec hsec
  exact ⟨corCocycle k Ω K E y sec, h1, h2, h3, h4, h5⟩

/-- `(c^n)^2 = 1` for an involution `c`. -/
lemma zpow_sq_eq_one {c : Ω ≃ₐ[k] Ω} (hc : c ^ 2 = 1) (n : ℤ) : (c ^ n) ^ 2 = 1 := by
  have hc' : c ^ (2:ℤ) = 1 := by simpa using hc
  calc (c ^ n) ^ 2 = c ^ n * c ^ n := by rw [sq]
    _ = c ^ (n + n) := (zpow_add c n n).symm
    _ = c ^ ((2:ℤ) * n) := by congr 1; ring
    _ = (c ^ (2:ℤ)) ^ n := zpow_mul c 2 n
    _ = 1 := by rw [hc', one_zpow]

/-- Powers of an involution are involutions. -/
lemma zpowers_sq_eq_one {c g : Ω ≃ₐ[k] Ω} (hc : c ^ 2 = 1) (hg : g ∈ Subgroup.zpowers c) :
    g ^ 2 = 1 := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hg
  rw [← hn]
  exact zpow_sq_eq_one (k := k) (Ω := Ω) hc n

/-- `corCocycle y sec 1 = 0`. -/
lemma corCocycle_one (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    corCocycle k Ω K E y sec 1 = 0 := by
  have h := corCocycle_isCocycle k Ω K E y hy sec hsec 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
  rw [mul_one, map_one, one_smul] at h
  have h' : corCocycle k Ω K E y sec 1 + 0
      = corCocycle k Ω K E y sec 1 + corCocycle k Ω K E y sec 1 := by
    rw [add_zero]; exact h
  exact (add_left_cancel h').symm

/-- On `G_K`, `corCocycle` vanishes at every involution. -/
lemma corCocycle_vanish_of_mem_fixingSubgroup (y : (Ω ≃ₐ[k] Ω) → E)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    {g : Ω ≃ₐ[k] Ω} (hg : g ∈ K.fixingSubgroup) (hg2 : g ^ 2 = 1) :
    corCocycle k Ω K E y sec g = 0 := by
  rw [corCocycle_restrict k Ω K E y sec g hg]
  have hsum : (∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * g * sec t)) = 0 := by
    refine Finset.sum_eq_zero (fun t _ => ?_)
    have harg : (sec t)⁻¹ * g * sec t ∈ K.fixingSubgroup := by
      have h := corCocycle_arg_mem k Ω K sec hsec g t
      rwa [show res k K g = 1 from (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg,
        inv_one, one_mul] at h
    have harg2 : ((sec t)⁻¹ * g * sec t) ^ 2 = 1 := by
      calc ((sec t)⁻¹ * g * sec t) ^ 2 = (sec t)⁻¹ * g ^ 2 * sec t := by rw [sq, sq]; group
        _ = 1 := by rw [hg2]; group
    rw [hyinf _ harg harg2, smul_zero]
  rw [hsum]

/-- **The involution clause of Theorem 13 holds for the corestriction cocycle.**
For every involution `c` of `G_k` the corestriction cocycle restricted to the cyclic group
`⟨c⟩ = {1, c}` is a coboundary. -/
theorem corCocycle_involution_coboundary (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    IsCoboundaryOn (res k K) (Subgroup.zpowers c) (corCocycle k Ω K E y sec) := by
  classical
  by_cases hs : res k K c = 1
  · refine ⟨0, fun g hg => ?_⟩
    have hcmem : c ∈ K.fixingSubgroup := (mem_fixingSubgroup_iff_res_eq_one k Ω K c).mp hs
    have hgmem : g ∈ K.fixingSubgroup := Subgroup.zpowers_le.mpr hcmem hg
    have hg2 : g ^ 2 = 1 := zpowers_sq_eq_one (k := k) (Ω := Ω) hc hg
    rw [corCocycle_vanish_of_mem_fixingSubgroup k Ω K E y hyinf sec hsec hgmem hg2]
    simp
  · set s : K ≃ₐ[k] K := res k K c with hs_def
    have hres_eq : res k K c = s := hs_def.symm
    have hs2 : s * s = 1 := by
      rw [hs_def, ← map_mul, ← sq, hc, map_one]
    have hsne : s ≠ 1 := hs
    -- the involution `t ↦ s * t` is fixed-point free
    have hmul_ne : ∀ t : K ≃ₐ[k] K, s * t ≠ t := by
      intro t h
      exact hsne (mul_right_cancel h)
    -- Setoid of the orbits of `t ↦ s * t`
    let r : Setoid (K ≃ₐ[k] K) :=
      { r := fun a b => b = a ∨ b = s * a
        iseqv := by
          refine ⟨fun a => Or.inl rfl, ?_, ?_⟩
          · intro a b h
            rcases h with h | h
            · exact Or.inl h.symm
            · refine Or.inr ?_
              rw [h, ← mul_assoc, hs2, one_mul]
          · intro a b d hab hbd
            rcases hab with hab | hab <;> rcases hbd with hbd | hbd
            · exact Or.inl (hbd.trans hab)
            · exact Or.inr (by rw [hbd, hab])
            · exact Or.inr (by rw [hbd, hab])
            · exact Or.inl (by rw [hbd, hab, ← mul_assoc, hs2, one_mul]) }
    let rep : (K ≃ₐ[k] K) → (K ≃ₐ[k] K) := fun v => Quotient.out (Quotient.mk r v)
    have hrep : ∀ v : K ≃ₐ[k] K, rep v = v ∨ rep v = s * v := by
      intro v
      have h : v = rep v ∨ v = s * rep v := Quotient.exact (Quotient.out_eq (Quotient.mk r v))
      rcases h with h | h
      · exact Or.inl h.symm
      · refine Or.inr ?_
        have key : s * (s * rep v) = rep v := by rw [← mul_assoc, hs2, one_mul]
        rw [← h] at key
        exact key.symm
    have hrep_mul : ∀ v : K ≃ₐ[k] K, rep (s * v) = rep v := by
      intro v
      have hclass : Quotient.mk r (s * v) = Quotient.mk r v :=
        Quotient.sound (show v = s * v ∨ v = s * (s * v) from
          Or.inr (by rw [← mul_assoc, hs2, one_mul]))
      show Quotient.out (Quotient.mk r (s * v)) = Quotient.out (Quotient.mk r v)
      rw [hclass]
    let sec' : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω) :=
      fun v => if rep v = v then sec v else c * sec (s * v)
    have hsec'_spec : ∀ v, sec' v
        = if rep v = v then sec v else c * sec (s * v) := fun v => rfl
    have hsec' : ∀ v, res k K (sec' v) = v := by
      intro v
      by_cases h : rep v = v
      · rw [hsec'_spec v, if_pos h, hsec]
      · rw [hsec'_spec v, if_neg h, map_mul, hres_eq, hsec]
        rw [← mul_assoc, hs2, one_mul]
    have hcompat : ∀ v, sec' (s * v) = c * sec' v := by
      intro v
      by_cases h : rep v = v
      · have hrepv : rep (s * v) = v := by rw [hrep_mul v, h]
        have hne : ¬ (rep (s * v) = s * v) := by rw [hrepv]; exact fun hh => hmul_ne v hh.symm
        rw [hsec'_spec (s * v), if_neg hne, hsec'_spec v, if_pos h]
        rw [show s * (s * v) = v from by rw [← mul_assoc, hs2, one_mul]]
      · have hrepv : rep v = s * v := (hrep v).resolve_left h
        have hrepv' : rep (s * v) = s * v := by rw [hrep_mul v, hrepv]
        rw [hsec'_spec (s * v), if_pos hrepv', hsec'_spec v, if_neg h]
        rw [← mul_assoc, ← sq, hc, one_mul]
    have hzero : corCocycle k Ω K E y sec' c = 0 := by
      have hterm : ∀ t : K ≃ₐ[k] K, (sec' t)⁻¹ * c * sec' ((res k K c)⁻¹ * t) = 1 := by
        intro t
        have hinv : (res k K c)⁻¹ = s := by rw [hres_eq]; exact inv_eq_of_mul_eq_one_left hs2
        rw [hinv, hcompat t]
        calc (sec' t)⁻¹ * c * c * sec' t = (sec' t)⁻¹ * (c * c) * sec' t := by group
          _ = 1 := by rw [← sq, hc]; group
      show (∑ t : K ≃ₐ[k] K, t • y ((sec' t)⁻¹ * c * sec' ((res k K c)⁻¹ * t))) = 0
      refine Finset.sum_eq_zero (fun t _ => ?_)
      rw [hterm t, corestriction_y_one k Ω K E y hy, smul_zero]
    -- the section change
    have hM := corCocycle_section_change k Ω K E y hy sec sec' hsec hsec' c
    rw [hzero] at hM
    set M : E := ∑ t : K ≃ₐ[k] K, t • y ((sec t)⁻¹ * sec' t) with hMdef
    have hxc : corCocycle k Ω K E y sec c = (res k K c) • (-M) - (-M) := by
      have h2 : corCocycle k Ω K E y sec c = -((res k K c) • M - M) := by
        rw [eq_neg_iff_add_eq_zero]
        exact hM.symm
      rw [h2]
      simp only [smul_sub, smul_neg, smul_smul, neg_smul, mul_neg, mul_one, neg_mul, neg_neg,
        one_smul, neg_one_smul]
      abel
    refine ⟨-M, fun g hg => ?_⟩
    rw [Subgroup.zpowers_eq_closure] at hg
    refine Subgroup.closure_induction
      (p := fun g _ => corCocycle k Ω K E y sec g = (res k K g) • (-M) - (-M))
      ?_ ?_ ?_ ?_ hg
    · intro x hx
      rw [Set.mem_singleton_iff] at hx
      rw [hx]
      exact hxc
    · rw [corCocycle_one k Ω K E y hy sec hsec, map_one, one_smul, sub_self]
    · intro x z _ _ hpx hpz
      rw [corCocycle_isCocycle k Ω K E y hy sec hsec x (Subgroup.mem_top x) z (Subgroup.mem_top z),
        hpx, hpz, map_mul]
      simp only [smul_sub, smul_neg, smul_smul, neg_smul, mul_neg, mul_one, neg_mul, neg_neg,
        one_smul, neg_one_smul]
      abel
    · intro x hx hpx
      have hxcoc : corCocycle k Ω K E y sec (x⁻¹ * x)
          = corCocycle k Ω K E y sec x⁻¹ + (res k K x⁻¹) • corCocycle k Ω K E y sec x :=
        corCocycle_isCocycle k Ω K E y hy sec hsec x⁻¹ (Subgroup.mem_top x⁻¹) x (Subgroup.mem_top x)
      rw [inv_mul_cancel, corCocycle_one k Ω K E y hy sec hsec, hpx] at hxcoc
      have hneg : corCocycle k Ω K E y sec x⁻¹
          = -((res k K x⁻¹) • ((res k K x) • (-M) - (-M))) := by
        rw [eq_neg_iff_add_eq_zero]
        exact hxcoc.symm
      rw [hneg]
      simp only [smul_sub, smul_neg, smul_smul, neg_smul, mul_neg, mul_one, neg_mul, neg_neg,
        one_smul, neg_one_smul]
      rw [show (res k K x⁻¹) * (res k K x) = 1 from by rw [← map_mul, inv_mul_cancel, map_one]]
      simp

/-- **The involution clause (5) for odd `p` is free.**  If `x` is a `1`-cocycle on `G_k` and `p ≠ 2`,
then `x` restricted to the cyclic subgroup generated by any involution is a coboundary: this is
`Work.SSGRoute.odd_involution_coboundary`, the standard vanishing of `H¹(Z/2; M)` in odd
characteristic.  Only the case `p = 2` needs the construction of the auxiliary class `z`. -/
theorem isCoboundaryOn_zpowers_of_involution_of_ne_two (hp : p ≠ 2)
    (x : (Ω ≃ₐ[k] Ω) → E) (hx : IsCocycleOn (res k K) ⊤ x)
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    IsCoboundaryOn (res k K) (Subgroup.zpowers c) x :=
  odd_involution_coboundary p hp (res k K) x hx c hc

end AdaptedSection

/-- **Clause (5) of Theorem 13 holds for the corestriction cocycle.**
For every involution `c ∈ G_k` the corestriction cocycle `corCocycle k Ω K E y sec` is a coboundary
on the subgroup `⟨c⟩ = {1, c}` it generates; this is `corCocycle_involution_coboundary` restated so
that it can be used without the section variables. -/
theorem corCocycle_satisfies_involution_clause
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
      IsCoboundaryOn (res k K) (Subgroup.zpowers c) (corCocycle k Ω K E y sec) :=
  fun c hc => corCocycle_involution_coboundary k Ω K E y hy hyinf sec hsec c hc

/-- **Theorem 13 modulo the "`x_p` is cyclic" clause.**
All the clauses of Theorem 13 except the last one hold for the explicit corestriction cocycle
`corCocycle k Ω K E y sec` of the given class `y`: it is a locally constant `1`-cocycle, it agrees
with the formal corestriction on the decomposition groups of the places of `S` that split in `K`, it
is a coboundary on the decomposition groups of the places of `S` that do not split in `K`, it is a
coboundary on `⟨c⟩` for every involution `c ∈ G_k`, and it vanishes on the inertia of the finite
places outside `S` that are not split in `Λ`. -/
theorem shafarevich_theorem13_modulo_cyclic_clause
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (Λ : IntermediateField k Ω) [FiniteDimensional k Λ] [IsGalois k Λ] (hKΛ : K ≤ Λ)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) := by
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram y hy hyc hyS hyT hy0 sec hsec
  exact ⟨corCocycle k Ω K E y sec, h1, h2, h3, h4,
    corCocycle_satisfies_involution_clause p k Ω K E y hy hyinf sec hsec, h5⟩



/-- **Theorem 13 follows from the two remaining inputs.**  All the clauses of Theorem 13 except the
last one hold for the explicit corestriction cocycle of `y` (`shafarevich_theorem13_modulo_cyclic_clause`).
The last clause ("`x_p` is cyclic for `p ∉ T`") then follows from

* `hsplit` — the cyclic condition at the places `B` outside `S` that are
  *completely decomposed* in `Λ|k` (the remaining input, isolated below).  For the places
  `B ∉ S` with `¬ IsSplitIn k Λ B` the local input is supplied by
  `Work.SSGRoute.decomp_mod_inertia_cyclic`.  For the completely decomposed places `B ∉ S`,
  however, the corestriction is a homomorphism on `D_B ≤ G_K` and the hypothesis `hyS` of Theorem 13
  does **not** apply (it asks for `¬ IsSplitIn k Λ B`); this is precisely the part of the statement
  that is only available under the paper's additional standing assumption `S ⊇ cs(Λ|k)` (see
  `shafarevich_theorem13_of_S_contains_split`) or under `y ∈ H¹(k_S|K, A)` (see
  `shafarevich_theorem13_of_y_unramified_outside_S`).  The cyclic condition at those places asks
  for a subgroup `U ⊆ ker x` with `D_B/U` cyclic, i.e. for the image `x(D_B) ⊆ E` to be cyclic; for
  the corestriction `x = cor(y)` this need not hold, since `x(D_B)` is the image of a *sum of
  conjugates* of `y` and can have full rank in `E`. -/
theorem shafarevich_theorem13_of_cyclic_inputs
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hsplit : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
      IsSplitIn k Λ B →
      ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
        (∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
        (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
        (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
        IsCoboundaryOn (res k K) U (corCocycle k Ω K E y sec)) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram y hy hyc hyS hyT hy0 sec hsec
  refine ⟨corCocycle k Ω K E y sec, h1, h2, h3, h4,
    corCocycle_satisfies_involution_clause p k Ω K E y hy hyinf sec hsec,
    ⟨h5, fun B hB hconj => ?_⟩⟩
  by_cases hsp : IsSplitIn k Λ B
  · exact hsplit B hB hconj hsp
  · exact exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E y sec) h1 h2 B hB
      (h5 B hB hconj hsp) (decomp_mod_inertia_cyclic k Ω B hB)


/-- **Theorem 13 of Schmidt–Wingberg from the "local gluing" input.**

The remaining content of Theorem 13 (beyond the purely local clauses (1)–(6)) is the following
gluing statement: given `y` as in the theorem, there is a cochain `y'` on `G_K` — additive and
locally constant — which

* agrees with `y` on the decomposition groups of the finite places that are conjugate to an element
  of `S` and *split* in `K|k` (in particular on all the conjugates of such a place),
* vanishes on the inertia of *every* finite place outside `S` (i.e. `y'` is unramified outside `S`),
* vanishes on the decomposition groups of the places of `S` that are not split in `K|k` (or lie over
  `p`), and
* vanishes on the involutions of `G_K`.

Then `x := corCocycle k Ω K E y' sec` satisfies the conclusion of Theorem 13.  Indeed

* clause (3) holds because `y'` and `y` agree on the decomposition groups of the places of `S` that
  are split in `K` and on all their conjugates;
* clause (4) is the adapted-section argument, which only uses the third bullet;
* clause (5) is `corCocycle_satisfies_involution_clause`, using the fourth bullet;
* clause (6) and the last clause hold because `x` vanishes on the inertia of every place `B ∉ S`:
  the argument of `y'` lies in the inertia of a conjugate of `B`, hence in `S`-complement, where
  `y'` is unramified.  The last clause then follows from
  `Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing`.

The gluing input itself is the `A = μ_p` case of Schmidt–Wingberg's argument (§4, pp. 13–20): it is
produced from Chebotarev's density theorem (the local data at the places of `S` are prescribed, and
the resulting class is ramified only inside `S`). -/
theorem shafarevich_theorem13_of_local_gluing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hglue : ∃ y' : (Ω ≃ₐ[k] Ω) → E,
      (∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y' (g * h) = y' g + y' h) ∧
      IsLocConstOn K.fixingSubgroup y' ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        IsSplitIn k K B →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y' σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y' c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y' σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y' σ = 0)) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  classical
  obtain ⟨y', hy'add, hy'loc, hy'agree, hy'inv, hy'unram, hy'0⟩ := hglue
  -- the conjugates of a place outside the `S`-orbit are again outside the `S`-orbit
  have hconj_smul : ∀ (B : ValuationSubring Ω) (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B)
      (s : K ≃ₐ[k] K), ∀ A ∈ S, ¬ IsConjPlace k A ((sec s)⁻¹ • B) := by
    intro B hconj s A hA hc
    exact hconj A hA (isConjPlace_trans hc ⟨sec s, by rw [← mul_smul, mul_inv_cancel, one_smul]⟩)
  -- `y'` is unramified at every conjugate (under `Gal(K/k)`) of a place outside the `S`-orbit
  have hy'unram_conj : ∀ (B : ValuationSubring Ω) (hB : IsFinPlace k B)
      (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B) (s : K ≃ₐ[k] K),
      ∀ σ ∈ K.fixingSubgroup, IsInertia k ((sec s)⁻¹ • B) σ → y' σ = 0 := by
    intro B hB hconj s σ hσK hσ
    exact hy'unram ((sec s)⁻¹ • B) ((isFinPlace_smul_iff B (sec s)⁻¹).mpr hB)
      (hconj_smul B hconj s) σ hσK hσ
  -- the inertia of a place outside the `S`-orbit lies in `G_K`
  have hKmem_of_inertia : ∀ (B : ValuationSubring Ω) (hB : IsFinPlace k B)
      (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B) (σ : Ω ≃ₐ[k] Ω), IsInertia k B σ →
      σ ∈ K.fixingSubgroup := by
    intro B hB hconj σ hσ
    by_cases hsp : IsSplitIn k Λ B
    · exact IntermediateField.fixingSubgroup_le hKΛ (hsp hσ.1)
    · have hnotram : ¬ IsRamifiedIn k Λ B :=
        (not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
      exact IntermediateField.fixingSubgroup_le hKΛ
        (mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hnotram σ hσ)
  -- the corestriction cocycle of `y'` vanishes on the inertia of every place outside the `S`-orbit
  have hvan : ∀ (B : ValuationSubring Ω) (hB : IsFinPlace k B)
      (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B) (σ : Ω ≃ₐ[k] Ω), σ ∈ K.fixingSubgroup →
      IsInertia k B σ → corCocycle k Ω K E y' sec σ = 0 := by
    intro B hB hconj σ hσK hσ
    rw [corCocycle_restrict k Ω K E y' sec σ hσK]
    refine Finset.sum_eq_zero (fun s _ => ?_)
    have harg : (sec s)⁻¹ * σ * sec s ∈ K.fixingSubgroup := by
      have h := corCocycle_arg_mem k Ω K sec hsec σ s
      rw [(mem_fixingSubgroup_iff_res_eq_one k Ω K σ).mpr hσK, inv_one, one_mul] at h
      exact h
    have his : IsInertia k ((sec s)⁻¹ • B) ((sec s)⁻¹ * σ * sec s) := by
      simpa using (isInertia_conj B (sec s)⁻¹ σ).mpr hσ
    rw [hy'unram_conj B hB hconj s _ harg his, smul_zero]
  refine ⟨corCocycle k Ω K E y' sec, corCocycle_isCocycle k Ω K E y' hy'add sec hsec,
    corCocycle_isLocConstOn k Ω K E y' hy'loc sec hsec, ?_, ?_, ?_, ?_, ?_⟩
  · -- (3)
    intro A hA hsplit
    refine ⟨0, fun δ hδ => ?_⟩
    have hδK : δ ∈ K.fixingSubgroup := hsplit hδ
    show corCocycle k Ω K E y' sec δ
      - (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) = (res k K δ) • (0 : E) - 0
    rw [corCocycle_restrict k Ω K E y' sec δ hδK]
    have hterm : ∀ s : K ≃ₐ[k] K, y ((sec s)⁻¹ * δ * sec s) = y' ((sec s)⁻¹ * δ * sec s) := by
      intro s
      haveI hnorm : (K.fixingSubgroup).Normal := IsGalois.fixingSubgroup_normal_of_isGalois K
      have hBa : IsFinPlace k ((sec s)⁻¹ • A) := (isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA)
      have hBconj : ∃ A' ∈ S, IsConjPlace k A' ((sec s)⁻¹ • A) :=
        ⟨A, hA, ⟨(sec s)⁻¹, rfl⟩⟩
      have hBsplit : IsSplitIn k K ((sec s)⁻¹ • A) :=
        (isSplitIn_conj K hnorm A (sec s)⁻¹).mpr hsplit
      have hmemD : (sec s)⁻¹ * δ * sec s ∈ decomp k ((sec s)⁻¹ • A) := by
        rw [decomp_conj]
        exact Subgroup.mem_map.mpr ⟨δ, hδ, by simp [MulAut.conj_apply]⟩
      have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
        have h := corCocycle_arg_mem k Ω K sec hsec δ s
        rw [(mem_fixingSubgroup_iff_res_eq_one k Ω K δ).mpr hδK, inv_one, one_mul] at h
        exact h
      exact (hy'agree ((sec s)⁻¹ • A) hBa hBconj hBsplit _ hmemK hmemD).symm
    have hsum : (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))
        = ∑ s : K ≃ₐ[k] K, s • y' ((sec s)⁻¹ * δ * sec s) :=
      Finset.sum_congr rfl (fun s _ => by rw [hterm s])
    rw [hsum]
    simp
  · -- (4)
    intro A hA hnotsplit
    obtain ⟨sec', hsec'res, -, hadapt⟩ := exists_adapted_section (k := k) (Ω := Ω) (K := K) A
    have hvanish : ∀ δ ∈ decomp k A, corCocycle k Ω K E y' sec' δ = 0 :=
      corCocycle_adapted_section_vanishes p k Ω K E S hSfin y' hy'add hy'0 A hA hnotsplit sec'
        hsec'res hadapt
    refine ⟨-(∑ t : K ≃ₐ[k] K, t • y' ((sec t)⁻¹ * sec' t)), fun δ hδ => ?_⟩
    have hchange := corCocycle_section_change k Ω K E y' hy'add sec sec' hsec hsec'res δ
    rw [hvanish δ hδ] at hchange
    have hval : corCocycle k Ω K E y' sec δ
        = - ((res k K δ) • (∑ t : K ≃ₐ[k] K, t • y' ((sec t)⁻¹ * sec' t))
            - (∑ t : K ≃ₐ[k] K, t • y' ((sec t)⁻¹ * sec' t))) :=
      eq_neg_of_add_eq_zero_left hchange.symm
    rw [hval]
    simp only [smul_neg]
    abel
  · -- (5)
    exact corCocycle_satisfies_involution_clause p k Ω K E y' hy'add hy'inv sec hsec
  · -- (6)
    intro B hB hconj hnotsplit σ hσ
    exact hvan B hB hconj σ (hKmem_of_inertia B hB hconj σ hσ) hσ
  · -- (7)
    intro B hB hconj
    exact exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E y' sec)
      (corCocycle_isCocycle k Ω K E y' hy'add sec hsec)
      (corCocycle_isLocConstOn k Ω K E y' hy'loc sec hsec) B hB
      (fun σ hσ => hvan B hB hconj σ (hKmem_of_inertia B hB hconj σ hσ) hσ)
      (decomp_mod_inertia_cyclic k Ω B hB)


/-- **Theorem 13 of Schmidt–Wingberg from the `z`-existence theorem of §4.**

The `z`-form of Theorem 13 (Schmidt–Wingberg §4) is: *there is a cochain `z` on `G_K`, additive and
locally constant, which agrees with `y` on the decomposition groups of the places of `S`, kills the
involutions, kills the inertia of every place outside `S` that is not split in `Λ|k`, and — at every
place `B ∉ S` that is completely decomposed in `Λ|k` — vanishes on the trace `V ⊓ decomp k B` of an
open subgroup `V` with `decomp k B / (decomp k B ⊓ V)` cyclic and `V` normalised by `decomp k B`.*

From such a `z` the conclusion of Theorem 13 follows with `x := corCocycle k Ω K E z sec`:

* clauses (1), (2) are `corCocycle_isCocycle` and `corCocycle_isLocConstOn`;
* clause (3) holds because `z` and `y` agree on the decomposition groups of the conjugates of `S`;
* clause (4) is the adapted-section argument, whose `hy0`-hypothesis is inherited from `y` by the
  agreement clause;
* clause (5) is `corCocycle_satisfies_involution_clause`;
* clause (6) holds because the argument of `z` in the corestriction sum lies in the inertia of a
  conjugate of `B`, where `z` is unramified;
* the last clause holds at the completely decomposed places because the *transfer*
  `∑ s, s • z ((sec s)⁻¹ δ sec s)` vanishes on `decomp k B ⊓ V`, hence `x|U = 0` for
  `U := decomp k B ⊓ V`; at the remaining places it follows from clause (6). -/
theorem shafarevich_theorem13_of_z_construction
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hz : ∃ z : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) K.fixingSubgroup z ∧
      IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ decomp k B ⊓ V,
            (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0))) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  classical
  obtain ⟨z, hzcoc, hzloc, hzagree, hzinv, hzS, hzram⟩ := hz
  -- `z` is additive on `G_K` (the action of `G_K` is trivial)
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hzcoc g hg h hh, (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg, one_smul]
  -- the conjugates of a place outside the `S`-orbit are again outside the `S`-orbit
  have hconj_smul : ∀ (B : ValuationSubring Ω) (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B)
      (s : K ≃ₐ[k] K), ∀ A ∈ S, ¬ IsConjPlace k A ((sec s)⁻¹ • B) := by
    intro B hconj s A hA hc
    exact hconj A hA (isConjPlace_trans hc ⟨sec s, by rw [← mul_smul, mul_inv_cancel, one_smul]⟩)
  -- the inertia of a place outside the `S`-orbit lies in `G_K`
  have hKmem_of_inertia : ∀ (B : ValuationSubring Ω) (hB : IsFinPlace k B)
      (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B) (σ : Ω ≃ₐ[k] Ω), IsInertia k B σ →
      σ ∈ K.fixingSubgroup := by
    intro B hB hconj σ hσ
    by_cases hsp : IsSplitIn k Λ B
    · exact IntermediateField.fixingSubgroup_le hKΛ (hsp hσ.1)
    · have hnotram : ¬ IsRamifiedIn k Λ B :=
        (not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
      exact IntermediateField.fixingSubgroup_le hKΛ
        (mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hnotram σ hσ)
  -- `x` vanishes on the inertia of a place outside the `S`-orbit that is not split in `Λ|k`
  have hvan : ∀ (B : ValuationSubring Ω) (hB : IsFinPlace k B)
      (hconj : ∀ A ∈ S, ¬ IsConjPlace k A B) (hnotsplit : ¬ IsSplitIn k Λ B)
      (σ : Ω ≃ₐ[k] Ω), σ ∈ K.fixingSubgroup → IsInertia k B σ →
      corCocycle k Ω K E z sec σ = 0 := by
    intro B hB hconj hnotsplit σ hσK hσ
    rw [corCocycle_restrict k Ω K E z sec σ hσK]
    refine Finset.sum_eq_zero (fun s _ => ?_)
    have harg : (sec s)⁻¹ * σ * sec s ∈ K.fixingSubgroup := by
      have h := corCocycle_arg_mem k Ω K sec hsec σ s
      rw [(mem_fixingSubgroup_iff_res_eq_one k Ω K σ).mpr hσK, inv_one, one_mul] at h
      exact h
    have his : IsInertia k ((sec s)⁻¹ • B) ((sec s)⁻¹ * σ * sec s) := by
      simpa using (isInertia_conj B (sec s)⁻¹ σ).mpr hσ
    have hBs : ¬ IsSplitIn k Λ ((sec s)⁻¹ • B) := by
      intro h
      haveI hnorm : (Λ.fixingSubgroup).Normal := IsGalois.fixingSubgroup_normal_of_isGalois Λ
      exact hnotsplit ((isSplitIn_conj Λ hnorm B (sec s)⁻¹).mp h)
    rw [hzS ((sec s)⁻¹ • B) ((isFinPlace_smul_iff B (sec s)⁻¹).mpr hB)
      (hconj_smul B hconj s) hBs _ harg his, smul_zero]
  refine ⟨corCocycle k Ω K E z sec, corCocycle_isCocycle k Ω K E z hzadd sec hsec,
    corCocycle_isLocConstOn k Ω K E z hzloc sec hsec, ?_, ?_, ?_, ?_, ?_⟩
  · -- (3)
    intro A hA hsplit
    refine ⟨0, fun δ hδ => ?_⟩
    have hδK : δ ∈ K.fixingSubgroup := hsplit hδ
    show corCocycle k Ω K E z sec δ
      - (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) = (res k K δ) • (0 : E) - 0
    rw [corCocycle_restrict k Ω K E z sec δ hδK]
    have hsum : (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s))
        = ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s) := by
      refine Finset.sum_congr rfl (fun s _ => ?_)
      have hBa : IsFinPlace k ((sec s)⁻¹ • A) := (isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA)
      have hBconj : ∃ A' ∈ S, IsConjPlace k A' ((sec s)⁻¹ • A) :=
        ⟨A, hA, ⟨(sec s)⁻¹, rfl⟩⟩
      have hmemD : (sec s)⁻¹ * δ * sec s ∈ decomp k ((sec s)⁻¹ • A) := by
        rw [decomp_conj]
        exact Subgroup.mem_map.mpr ⟨δ, hδ, by simp [MulAut.conj_apply]⟩
      have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
        have h := corCocycle_arg_mem k Ω K sec hsec δ s
        rw [(mem_fixingSubgroup_iff_res_eq_one k Ω K δ).mpr hδK, inv_one, one_mul] at h
        exact h
      rw [hzagree ((sec s)⁻¹ • A) hBa hBconj _ hmemK hmemD]
    rw [hsum]
    simp
  · -- (4)
    intro A hA hnotsplit
    obtain ⟨sec', hsec'res, -, hadapt⟩ := exists_adapted_section (k := k) (Ω := Ω) (K := K) A
    have hz0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = 0 := by
      intro B hB hconj hbad σ hσK hσD
      rw [hzagree B hB hconj σ hσK hσD]
      exact hy0 B hB hconj hbad σ hσK hσD
    have hvanish : ∀ δ ∈ decomp k A, corCocycle k Ω K E z sec' δ = 0 :=
      corCocycle_adapted_section_vanishes p k Ω K E S hSfin z hzadd hz0 A hA hnotsplit sec'
        hsec'res hadapt
    refine ⟨-(∑ t : K ≃ₐ[k] K, t • z ((sec t)⁻¹ * sec' t)), fun δ hδ => ?_⟩
    have hchange := corCocycle_section_change k Ω K E z hzadd sec sec' hsec hsec'res δ
    rw [hvanish δ hδ] at hchange
    have hval : corCocycle k Ω K E z sec δ
        = - ((res k K δ) • (∑ t : K ≃ₐ[k] K, t • z ((sec t)⁻¹ * sec' t))
            - (∑ t : K ≃ₐ[k] K, t • z ((sec t)⁻¹ * sec' t))) :=
      eq_neg_of_add_eq_zero_left hchange.symm
    rw [hval]
    simp only [smul_neg]
    abel
  · -- (5)
    exact corCocycle_satisfies_involution_clause p k Ω K E z hzadd hzinv sec hsec
  · -- (6)
    intro B hB hconj hnotsplit σ hσ
    exact hvan B hB hconj hnotsplit σ (hKmem_of_inertia B hB hconj σ hσ) hσ
  · -- (7)
    intro B hB hconj
    by_cases hsp : IsSplitIn k Λ B
    · obtain ⟨V, hVopen, hVnorm, hVcyc, hVvan⟩ := hzram B hB hconj hsp
      refine ⟨V ⊓ decomp k B, ⟨V, hVopen, rfl⟩, ?_, ?_, ?_⟩
      · intro δ hδ u hu
        obtain ⟨huV, huD⟩ := Subgroup.mem_inf.mp hu
        exact Subgroup.mem_inf.mpr
          ⟨hVnorm δ hδ u (Subgroup.mem_inf.mpr ⟨huD, huV⟩),
            mul_mem (mul_mem hδ huD) (inv_mem hδ)⟩
      · obtain ⟨g, hgD, hgV⟩ := hVcyc
        refine ⟨g, hgD, fun δ hδ => ?_⟩
        obtain ⟨m, hm⟩ := hgV δ hδ
        exact ⟨m, Subgroup.mem_inf.mpr ⟨hm, mul_mem (inv_mem hδ) (zpow_mem hgD m)⟩⟩
      · refine ⟨0, fun u hu => ?_⟩
        obtain ⟨huV, huD⟩ := Subgroup.mem_inf.mp hu
        have huK : u ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ (hsp huD)
        show corCocycle k Ω K E z sec u = (res k K u) • (0 : E) - 0
        rw [corCocycle_restrict k Ω K E z sec u huK]
        rw [hVvan u (Subgroup.mem_inf.mpr ⟨huD, huV⟩)]
        simp
    · exact exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E z sec)
        (corCocycle_isCocycle k Ω K E z hzadd sec hsec)
        (corCocycle_isLocConstOn k Ω K E z hzloc sec hsec) B hB
        (fun σ hσ => hvan B hB hconj hsp σ (hKmem_of_inertia B hB hconj σ hσ) hσ)
        (decomp_mod_inertia_cyclic k Ω B hB)


/-- **Theorem 13 of Schmidt–Wingberg from the `z`-existence theorem, restricted to its deep half.**

The `z`-clause of `Work.SSGRoute.shafarevich_z_construction` at a place `B ∉ S` that is completely
decomposed in `Λ|k` asks for the transfer `∑_s s • z ((sec s)⁻¹ δ sec s)` to vanish on `decomp k B ⊓ V`
for some open `V` with `decomp k B ⧸ (decomp k B ⊓ V)` cyclic.  There are two cases.

* If `z` is *unramified at all conjugates of `B`*, this is **free**: the transfer kills the inertia
  `I_B` (each of its summands is `z` at an element of the inertia of a conjugate of `B`), and the
  local input `Work.SSGRoute.decomp_mod_inertia_cyclic` (the decomposition group modulo an open
  subgroup containing the inertia is cyclic) together with
  `Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing` produces the required `V`.  This is
  `Work.SSGRoute.transfer_vanishes_of_unramified`.

* If `z` *is* ramified at a conjugate of `B`, the clause is the deep half — the content of
  Schmidt–Wingberg §4 (their condition (b), the sequence `z₁, z₂, …`, the pigeonhole argument and
  the Hilbert-symbol product formula).  It is isolated here as the hypothesis `hzram`.

Thus Theorem 13 follows from the existence of a cochain `z` with

* the agreement clause `z = y` on the decomposition groups of the places of `S`,
* `z` killing the involutions and the inertia of the places outside `S` that are not split in `Λ|k`
  (these two are automatic for the explicit `z = y`, by `hyinf` and `hyS`),
* and the ramified-case clause `hzram` at the completely decomposed places outside `S`.

In particular the *whole* of the `z`-existence reduces to the ramified case: the unramified case is
proved, and the agreement/involution/inertia clauses are inherited from `y`. -/
theorem shafarevich_theorem13_of_z_ramified
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hzr : ∃ z : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) K.fixingSubgroup z ∧
      IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        (∃ s : K ≃ₐ[k] K, ∃ δ ∈ K.fixingSubgroup,
            IsInertia k ((sec s)⁻¹ • B) δ ∧ z δ ≠ 0) →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ decomp k B ⊓ V,
            (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0))) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  obtain ⟨z, hzcoc, hzloc, hzagree, hzinv, hzS, hzram⟩ := hzr
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hzcoc g hg h hh, (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg, one_smul]
  refine shafarevich_theorem13_of_z_construction p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram
    y hy hyc hyS hyT hy0 hyinf sec hsec ⟨z, hzcoc, hzloc, hzagree, hzinv, hzS, ?_⟩
  intro B hB hconj hsplitΛ
  by_cases hram : ∃ s : K ≃ₐ[k] K, ∃ δ ∈ K.fixingSubgroup,
      IsInertia k ((sec s)⁻¹ • B) δ ∧ z δ ≠ 0
  · -- the deep case: isolated hypothesis
    exact hzram B hB hconj hsplitΛ hram
  · -- the unramified case
    have hsplitK : IsSplitIn k K B :=
      fun δ hδ => IntermediateField.fixingSubgroup_le hKΛ (hsplitΛ hδ)
    have hunram : ∀ (s : K ≃ₐ[k] K) (σ : Ω ≃ₐ[k] Ω), σ ∈ K.fixingSubgroup →
        IsInertia k ((sec s)⁻¹ • B) σ → z σ = 0 := by
      intro s σ hσK hσI
      by_contra hne
      exact hram ⟨s, σ, hσK, hσI, hne⟩
    exact transfer_vanishes_of_unramified p k Ω K E z hzadd hzloc sec hsec B hB hsplitK hunram


/-- **Theorem 13 from the `z`-existence in the form of Schmidt–Wingberg's condition (b).**

This is `shafarevich_theorem13_of_z_ramified` with its deep hypothesis re-stated in the paper's own
shape: at every completely decomposed place `B ∉ S` at which `z` is ramified at some conjugate, there
is a *single* conjugate `t` such that `z` vanishes on the whole local group of every other conjugate,
and `z` realises on the `t`-th local group a *cyclic* subgroup of `E`.  That is exactly
Schmidt–Wingberg's "`z^σ_P = 0` for `σ ≠ 1` and `z_P` cyclic", and by
`Work.SSGRoute.transfer_clause_of_single_conjugate` it implies the `∃V`-clause of
`shafarevich_theorem13_of_z_ramified` (the transfer collapses to the single surviving conjugate, whose
image is cyclic, and `exists_V_of_cyclic_transfer` converts cyclicity into the `V`-clause). -/
theorem shafarevich_theorem13_of_z_conjugate_vanishing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hz : ∃ z : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) K.fixingSubgroup z ∧
      IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        (∃ s : K ≃ₐ[k] K, ∃ δ ∈ K.fixingSubgroup,
            IsInertia k ((sec s)⁻¹ • B) δ ∧ z δ ≠ 0) →
        ∃ t : K ≃ₐ[k] K,
          (∀ s : K ≃ₐ[k] K, s ≠ t → ∀ σ ∈ K.fixingSubgroup,
            σ ∈ decomp k ((sec s)⁻¹ • B) → z σ = 0) ∧
          (∃ g ∈ decomp k ((sec t)⁻¹ • B) ⊓ K.fixingSubgroup,
            ∀ δ ∈ decomp k ((sec t)⁻¹ • B) ⊓ K.fixingSubgroup,
              z δ ∈ AddSubgroup.zmultiples (z g)))) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  obtain ⟨z, hzcoc, hzloc, hzagree, hzinv, hzS, hzconj⟩ := hz
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    rw [hzcoc g hg h hh, (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg, one_smul]
  refine shafarevich_theorem13_of_z_ramified p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram
    y hy hyc hyS hyT hy0 hyinf sec hsec ⟨z, hzcoc, hzloc, hzagree, hzinv, hzS, ?_⟩
  intro B hB hconj hsplitΛ hram
  obtain ⟨t, hkill, hcyc⟩ := hzconj B hB hconj hsplitΛ hram
  exact transfer_clause_of_single_conjugate p k Ω K E z hzadd hzloc sec hsec B hB
    (fun δ hδ => IntermediateField.fixingSubgroup_le hKΛ (hsplitΛ hδ)) t hkill hcyc


/-- **The dimension-induction step of Schmidt–Wingberg §4 (pp. 18–19): the verification.**

Theorem 13 is proved by induction on `dim_{𝔽_p} A`.  Writing `A = A_0 ⊕ μ_p`, one takes the
induction-hypothesis solution `z_0` for the submodule `A_0` and a solution `z''` for the one
dimensional part, and verifies that `z = z_0 + z''` has the required local behaviour.  The whole
content of that verification — and this is what is formalised here — is the following.

Let `x₀`, `x₁ : G_k → E` each satisfy the clauses of Theorem 13 for the data `(S, y₂)` and
`(S, y₁)`.  Then `x₀ + x₁` satisfies the clauses for `(S, y₁ + y₂)`, **provided** that at every finite
place `B ∉ S` which is completely decomposed in `K|k` and at which `x₀ + x₁` is ramified, the first
component `x₀` vanishes on the whole local group `decomp k B ⊓ G_K`.

The proviso (`hPT`) is exactly the place where the Poitou–Tate exactness enters the paper's
argument, and it is isolated here as a named hypothesis on purpose.  In §4 it is supplied by the
*modified* data: one replaces `(T, S)` by `(T', S')` with `T' = T ∪ Ram(K̃|k)` (`K̃` the Galois
closure over `k` of the field cut out by `z_0`) and solves the one-dimensional problem for a class
`ỹ` adjusted at `T'` — whose existence is the diagram chase on pp. 18–19 — so that "if `z_P` is
ramified then `z''_P` is ramified, the underlying prime splits completely in `K̃`, and hence
`z_0^σ_P = 0` for every `σ`, so that `z_P = z''_P`".  That is precisely `hPT`.

The clauses themselves are additive: cocycles, local constancy, coboundaries (witnesses add) and
vanishing on the inertia are all closed under `x₀ + x₁`; only the last clause needs the proviso,
because a sum of two cyclic local images need not be cyclic.  This is the mechanism of the
induction. -/
theorem shafarevich_theorem13_of_two_solutions
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (y₁ y₂ : (Ω ≃ₐ[k] Ω) → E)
    (x₀ x₁ : (Ω ≃ₐ[k] Ω) → E)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (h₀ : IsCocycleOn (res k K) ⊤ x₀ ∧ IsLocConstOn ⊤ x₀ ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x₀ δ - ∑ s : K ≃ₐ[k] K, s • y₂ ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A → IsCoboundaryOn (res k K) (decomp k A) x₀) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → IsCoboundaryOn (res k K) (Subgroup.zpowers c) x₀) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x₀ σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x₀))
    (h₁ : IsCocycleOn (res k K) ⊤ x₁ ∧ IsLocConstOn ⊤ x₁ ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x₁ δ - ∑ s : K ≃ₐ[k] K, s • y₁ ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A → IsCoboundaryOn (res k K) (decomp k A) x₁) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → IsCoboundaryOn (res k K) (Subgroup.zpowers c) x₁) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x₁ σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x₁))
    (hPT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
      IsSplitIn k K B →
      (∃ σ ∈ K.fixingSubgroup, IsInertia k B σ ∧ (x₀ + x₁) σ ≠ 0) →
      ∀ δ ∈ K.fixingSubgroup, δ ∈ decomp k B → x₀ δ = 0) :
    IsCocycleOn (res k K) ⊤ (x₀ + x₁) ∧ IsLocConstOn ⊤ (x₀ + x₁) ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => (x₀ + x₁) δ
            - ∑ s : K ≃ₐ[k] K, s • (y₁ + y₂) ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A → IsCoboundaryOn (res k K) (decomp k A) (x₀ + x₁)) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → IsCoboundaryOn (res k K) (Subgroup.zpowers c) (x₀ + x₁)) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → (x₀ + x₁) σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U (x₀ + x₁) := by
  obtain ⟨h₀c, h₀l, h₀3, h₀4, h₀5, h₀6, h₀7⟩ := h₀
  obtain ⟨h₁c, h₁l, h₁3, h₁4, h₁5, h₁6, h₁7⟩ := h₁
  -- the fixing subgroup of `Λ` is contained in that of `K` (`K ≤ Λ`)
  have hle : Λ.fixingSubgroup ≤ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ
  -- (1) a sum of cocycles is a cocycle
  have hc : IsCocycleOn (res k K) ⊤ (x₀ + x₁) := by
    intro g _ h _
    have h0 := h₀c g (Subgroup.mem_top g) h (Subgroup.mem_top h)
    have h1 := h₁c g (Subgroup.mem_top g) h (Subgroup.mem_top h)
    simp only [Pi.add_apply] at h0 h1 ⊢
    rw [h0, h1, smul_add]
    abel
  -- (2) a sum of locally constant cochains is locally constant
  have hl : IsLocConstOn ⊤ (x₀ + x₁) := by
    obtain ⟨U₀, hU₀, hc₀⟩ := h₀l
    obtain ⟨U₁, hU₁, hc₁⟩ := h₁l
    refine ⟨U₀ ⊓ U₁, hU₀.inter hU₁, fun g _ u hu _ => ?_⟩
    have hu₀ : u ∈ U₀ := (Subgroup.mem_inf.mp hu).1
    have hu₁ : u ∈ U₁ := (Subgroup.mem_inf.mp hu).2
    simp only [Pi.add_apply]
    rw [hc₀ g (Subgroup.mem_top g) u hu₀ (Subgroup.mem_top u),
      hc₁ g (Subgroup.mem_top g) u hu₁ (Subgroup.mem_top u)]
  refine ⟨hc, hl, ?_, ?_, ?_, ?_, ?_⟩
  · -- (3) the agreement clause, against `y₁ + y₂`
    intro A hA hsplit
    obtain ⟨m, hm⟩ := h₀3 A hA hsplit
    obtain ⟨m', hm'⟩ := h₁3 A hA hsplit
    refine ⟨m + m', fun δ hδ => ?_⟩
    have h0 := hm δ hδ
    have h1 := hm' δ hδ
    have hsum : (∑ s : K ≃ₐ[k] K, s • (y₁ + y₂) ((sec s)⁻¹ * δ * sec s))
        = (∑ s : K ≃ₐ[k] K, s • y₁ ((sec s)⁻¹ * δ * sec s))
          + ∑ s : K ≃ₐ[k] K, s • y₂ ((sec s)⁻¹ * δ * sec s) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun s _ => by rw [Pi.add_apply, smul_add]
    have h0' : x₀ δ = ((res k K) δ • m - m)
        + ∑ s : K ≃ₐ[k] K, s • y₂ ((sec s)⁻¹ * δ * sec s) :=
      (sub_eq_iff_eq_add).mp h0
    have h1' : x₁ δ = ((res k K) δ • m' - m')
        + ∑ s : K ≃ₐ[k] K, s • y₁ ((sec s)⁻¹ * δ * sec s) :=
      (sub_eq_iff_eq_add).mp h1
    show x₀ δ + x₁ δ
        - (∑ s : K ≃ₐ[k] K, s • (y₁ + y₂) ((sec s)⁻¹ * δ * sec s))
        = (res k K) δ • (m + m') - (m + m')
    rw [h0', h1', hsum, smul_add]
    abel
  · -- (4) a sum of coboundaries is a coboundary
    intro A hA hnotsplit
    obtain ⟨m, hm⟩ := h₀4 A hA hnotsplit
    obtain ⟨m', hm'⟩ := h₁4 A hA hnotsplit
    refine ⟨m + m', fun δ hδ => ?_⟩
    have h0 := hm δ hδ
    have h1 := hm' δ hδ
    simp only [Pi.add_apply] at h0 h1 ⊢
    rw [h0, h1, smul_add]
    abel
  · -- (5) involutions
    intro c hc2
    obtain ⟨m, hm⟩ := h₀5 c hc2
    obtain ⟨m', hm'⟩ := h₁5 c hc2
    refine ⟨m + m', fun δ hδ => ?_⟩
    have h0 := hm δ hδ
    have h1 := hm' δ hδ
    simp only [Pi.add_apply] at h0 h1 ⊢
    rw [h0, h1, smul_add]
    abel
  · -- (6) vanishing on the outside inertia
    intro B hB hconj hnotsplit σ hσ
    have h0 := h₀6 B hB hconj hnotsplit σ hσ
    have h1 := h₁6 B hB hconj hnotsplit σ hσ
    simp only [Pi.add_apply]
    rw [h0, h1, add_zero]
  · -- (7) the last clause: only here does the proviso enter
    intro B hB hconj
    by_cases hram : ∃ σ ∈ K.fixingSubgroup, IsInertia k B σ ∧ (x₀ + x₁) σ ≠ 0
    · -- `x₀ + x₁` is ramified at `B`: the proviso kills the first component
      -- hence `B` is completely decomposed in `K|k`, and `x₁`'s witness applies
      have hsplitK : IsSplitIn k K B := by
        by_contra hns
        obtain ⟨σ, hσK, hσI, hσne⟩ := hram
        have hnsΛ : ¬ IsSplitIn k Λ B := fun h => hns (le_trans h hle)
        have hx₀ := h₀6 B hB hconj hnsΛ σ hσI
        have hx₁ := h₁6 B hB hconj hnsΛ σ hσI
        refine hσne ?_
        simp only [Pi.add_apply]
        rw [hx₀, hx₁, add_zero]
      obtain ⟨U, hUform, hUnorm, hUcyc, hUcob⟩ := h₁7 B hB hconj
      have hx₀zero : ∀ δ ∈ decomp k B, x₀ δ = 0 := fun δ hδ =>
        hPT B hB hconj hsplitK hram δ (hsplitK hδ) hδ
      refine ⟨U, hUform, hUnorm, hUcyc, ?_⟩
      obtain ⟨m, hm⟩ := hUcob
      refine ⟨m, fun δ hδ => ?_⟩
      have hδD : δ ∈ decomp k B := by
        obtain ⟨V, _, hUV⟩ := hUform
        rw [hUV] at hδ
        exact (Subgroup.mem_inf.mp hδ).2
      have h0 := hx₀zero δ hδD
      simp only [Pi.add_apply]
      rw [h0, zero_add]
      exact hm δ hδ
    · -- `x₀ + x₁` kills the inertia of `B`: the general `U`-existence applies
      have hI : ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → (x₀ + x₁) σ = 0 := by
        intro σ hσ
        by_cases hsplitΛ : IsSplitIn k Λ B
        · -- `B` splits completely in `Λ`: then `σ ∈ G_K` and `¬ hram` applies
          by_contra hne
          exact hram ⟨σ, hle (hsplitΛ hσ.1), hσ, hne⟩
        · -- otherwise clause (6) for `x₀` and `x₁` gives the vanishing
          have hx₀ := h₀6 B hB hconj hsplitΛ σ hσ
          have hx₁ := h₁6 B hB hconj hsplitΛ σ hσ
          simp only [Pi.add_apply]
          rw [hx₀, hx₁, add_zero]
      exact exists_cyclic_quotient_subgroup_vanishing p k Ω K E (x₀ + x₁) hc hl B hB hI
        (decomp_mod_inertia_cyclic k Ω B hB)


/-- **Theorem 13 of Schmidt–Wingberg in the paper's setting.**

This is `shafarevich_theorem13_of_cyclic_inputs` with the paper's standing assumption
`S = cs(Λ|k) ∪ T` made explicit: if every finite place that is completely decomposed in `Λ|k` is
`G_k`-conjugate to an element of `S` (so that `S ⊇ cs(Λ|k)`), then the remaining cyclic condition
`hsplit` is vacuous and the theorem follows from the local cyclicity input
`Work.SSGRoute.decomp_mod_inertia_cyclic` alone. -/
theorem shafarevich_theorem13_of_S_contains_split
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (hScs : ∀ B : ValuationSubring Ω, IsFinPlace k B → IsSplitIn k Λ B →
      ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  refine shafarevich_theorem13_of_cyclic_inputs p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram y hy
    hyc hyS hyT hy0 hyinf sec hsec ?_
  intro B hB hconj hsp
  exact absurd (hScs B hB hsp) (by rintro ⟨A, hA, hAB⟩; exact hconj A hA hAB)



/-- **The corestriction vanishes on the inertia of every place outside `S` when `y` does.**

With the paper's hypothesis that `y` is unramified at *every* finite place outside `S` (i.e.
`y ∈ H¹(k_S|K, A)`), the formal corestriction `X` — and hence the corestriction cocycle — vanishes
on the inertia of every finite place outside `S`, not only of those that are not split in `Λ|k`.
This is the same computation as `Work.SSGRoute.corestriction_vanishes_on_inertia`, without the
`¬ IsSplitIn k Λ B` ingredient. -/
theorem corestriction_vanishes_on_inertia_of_unramified_outside_S
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
      ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → corCocycle k Ω K E y sec σ = 0 := by
  intro B hB hconj σ hI
  have hunram : ¬ IsRamifiedIn k Λ B :=
    (not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
  have hσΛ : σ ∈ Λ.fixingSubgroup :=
    mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hunram σ hI
  have hσK : σ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ hσΛ
  have hker : ∀ (u : Ω ≃ₐ[k] Ω), res k K u = 1 ↔ u ∈ K.fixingSubgroup := by
    intro u
    rw [show res k K u = u.restrictNormal K from rfl, AlgEquiv.restrictNormal_eq_one_iff,
      IntermediateField.mem_fixingSubgroup_iff]
  have hσ1 : res k K σ = 1 := (hker σ).mpr hσK
  rw [corCocycle_restrict k Ω K E y sec σ hσK]
  refine Finset.sum_eq_zero (fun s _ => ?_)
  have hfin : IsFinPlace k ((sec s)⁻¹ • B) := (isFinPlace_smul_iff B (sec s)⁻¹).mpr hB
  have hconj' : ∀ A ∈ S, ¬ IsConjPlace k A ((sec s)⁻¹ • B) := fun A hA hc =>
    hconj A hA ((isConjPlace_smul_iff A B (sec s)⁻¹).mp hc)
  have hmem_res : res k K ((sec s)⁻¹ * σ * sec s) = 1 := by
    rw [map_mul, map_mul, map_inv, hsec s, hσ1, mul_one, inv_mul_cancel]
  have hmem : ((sec s)⁻¹ * σ * sec s) ∈ K.fixingSubgroup := (hker _).mp hmem_res
  have hinert : IsInertia k ((sec s)⁻¹ • B) ((sec s)⁻¹ * σ * sec s) := by
    simpa using (isInertia_conj B (sec s)⁻¹ σ).mpr hI
  rw [hyS ((sec s)⁻¹ • B) hfin hconj' _ hmem hinert, smul_zero]

/-- **Theorem 13 of Schmidt–Wingberg with the paper's hypothesis `y ∈ H¹(k_S|K, A)`.**

Here the hypothesis on `y` is the paper's: `y` vanishes on the inertia of *every* finite place of
`k` outside `S` (not only of those that are not split in `Λ|k`).  Then the theorem holds, using the
local input `Work.SSGRoute.decomp_mod_inertia_cyclic` (the unramified local Galois group
`D_B/I_B ≅ Ẑ` is pro-cyclic, so `decomp k B / W` is cyclic for every `W` of the form
`V ⊓ decomp k B` with `V` open and `I_B ≤ W`).

The class `x` is the explicit corestriction cocycle `corCocycle k Ω K E y sec`; its vanishing on the
inertia of every place outside `S` (proved here) together with `hlocal` gives the last clause via
`Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing`. -/
theorem shafarevich_theorem13_of_y_unramified_outside_S
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  have hyS' : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0 :=
    fun B hB hconj _ σ hσK hσ => hyS B hB hconj σ hσK hσ
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram y hy hyc hyS' hyT hy0 sec hsec
  refine ⟨corCocycle k Ω K E y sec, h1, h2, h3, h4,
    corCocycle_satisfies_involution_clause p k Ω K E y hy hyinf sec hsec,
    ⟨h5, fun B hB hconj => ?_⟩⟩
  exact exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E y sec) h1 h2 B hB
    (corestriction_vanishes_on_inertia_of_unramified_outside_S p k Ω K Λ hKΛ E S hSfin hSram y
      hyS sec hsec B hB hconj)
    (decomp_mod_inertia_cyclic k Ω B hB)


/-- **Theorem 13 of Schmidt–Wingberg for a one-dimensional coefficient module** (`A = μ_p`).

If `E` has `𝔽_p`-dimension `≤ 1` (the case `A = μ_p` of Schmidt–Wingberg §4), then *every* subgroup
of `E` is cyclic and the last clause of Theorem 13 ("`x_p` is cyclic for `p ∉ T`") is free: the
explicit corestriction cocycle `corCocycle k Ω K E y sec` already satisfies all the clauses.

Concretely, at a finite place `B ∉ S` the clause is witnessed as follows.

* If `B` is not completely decomposed in `Λ|k` then it is unramified in `Λ` and
  `Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing` applies, using clause (6)
  (`x|I_B = 0`) and the local input `Work.SSGRoute.decomp_mod_inertia_cyclic` (`D_B/I_B ≅ Ẑ`).
* If `B` is completely decomposed in `Λ|k` then `D_B ≤ G_K` and `x|D_B` is the additive map
  `X = ∑_s s • (y ∘ conj_s)`, whose image is generated by one element
  (`zmultiples_eq_top_of_finrank_le_one`); then
  `Work.SSGRoute.exists_cyclic_quotient_subgroup_of_cyclic_image` produces the required `U`.

This is the `A = μ_p` case of Theorem 13 in the sense of the formalisation (where the clause only
requires the cyclicity of the local component of `x`, not `z^σ_P = 0` of Schmidt–Wingberg's
auxiliary class `z`). -/
theorem shafarevich_theorem13_of_finrank_le_one
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (h1 : Module.finrank (ZMod p) E ≤ 1)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  refine shafarevich_theorem13_of_cyclic_inputs p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram
    y hy hyc hyS hyT hy0 hyinf sec hsec ?_
  intro B hB hconj hsplitΛ
  have hsplitK : IsSplitIn k K B :=
    fun δ hδ => IntermediateField.fixingSubgroup_le hKΛ (hsplitΛ hδ)
  refine exists_cyclic_quotient_subgroup_of_cyclic_image p k Ω K E (corCocycle k Ω K E y sec)
    (corCocycle_isCocycle k Ω K E y hy sec hsec)
    (corCocycle_isLocConstOn k Ω K E y hyc sec hsec) B hB hsplitK ?_
  by_cases hzero : ∃ δ ∈ decomp k B, corCocycle k Ω K E y sec δ ≠ 0
  · obtain ⟨δ₀, hδ₀, hδ₀ne⟩ := hzero
    refine ⟨δ₀, hδ₀, fun δ hδ => ?_⟩
    obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp
      (zmultiples_eq_top_of_finrank_le_one h1 hδ₀ne (corCocycle k Ω K E y sec δ))
    exact ⟨n, hn.symm⟩
  · refine ⟨1, one_mem _, fun δ hδ => ⟨0, ?_⟩⟩
    have hz : corCocycle k Ω K E y sec δ = 0 := by
      by_contra hne
      exact hzero ⟨δ, hδ, hne⟩
    rw [hz, zero_smul]



/-! ## The cyclic clause from a cyclic retraction of the coefficient module

The clauses (1)–(6) of Theorem 13 hold for the explicit corestriction cocycle
`X = corCocycle k Ω K E y sec` of the given class `y`.  The remaining clause (7) fails only at the
places `B ∉ S` that are *completely decomposed* in `Λ|k`: at such a place `decomp k B ≤ G_K` and
`X|decomp k B` is an honest homomorphism whose image can have full rank in `E`, whereas the clause
requires the image to be cyclic.

The two lemmas below exploit the freedom in the choice of `x`: for every *additive* and
`Gal(K|k)`-equivariant endomorphism `ψ` of `E`, the map `x := ψ ∘ X` is again a locally constant
`1`-cocycle on `G_k`, it is (by equivariance) a coboundary on `decomp k A` whenever `X` is one, it
vanishes wherever `X` does, and its local image at a place `B` is contained in `ψ(E)`.  Hence, if
`ψ(E)` is cyclic and `ψ` fixes `X` on the decomposition groups of the places of `S` that split in
`K` (so that clause (3), which is an *equality* there, survives), then `x := ψ ∘ X` satisfies all
seven clauses of Theorem 13, the last one through
`Work.SSGRoute.exists_cyclic_quotient_subgroup_of_cyclic_image` (completely decomposed places) and
`Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing` (the remaining places).

In particular `ψ = 0` is allowed whenever the corestriction already vanishes on the decomposition
groups of the split places of `S` — in which case `x = 0` itself is a witness.  This is exactly the
mechanism by which the paper's class `z` (chosen with Schmidt–Wingberg's condition (b)) controls the
cyclic clause: `z` is arranged so that the transfer `cor(z)` is (locally) supported on a single
conjugate at every new ramification prime. -/

/-- In a module over the field `𝔽_p`, the cyclic subgroup generated by a nonzero element `b` of the
cyclic subgroup generated by `a` is the whole of `⟨a⟩`.  (Every nonzero element of `E` has additive
order `p`, since `p · e = (p : ZMod p) • e = 0`.) -/
lemma zmultiples_eq_of_mem_zmultiples {p : ℕ} [Fact p.Prime] {E : Type} [AddCommGroup E]
    [Module (ZMod p) E] {a b : E} (hb : b ≠ 0) (h : b ∈ AddSubgroup.zmultiples a) :
    AddSubgroup.zmultiples b = AddSubgroup.zmultiples a := by
  obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp h
  have hnc : (n : ZMod p) ≠ 0 := by
    intro hc
    exact hb (by rw [← hn, ← Int.cast_smul_eq_zsmul (ZMod p) n a, hc, zero_smul])
  have hb' : b = (n : ZMod p) • a := by rw [← hn, Int.cast_smul_eq_zsmul]
  obtain ⟨m, hm⟩ : ∃ m : ℤ, (m : ZMod p) = (n : ZMod p)⁻¹ :=
    ⟨(ZMod.val ((n : ZMod p)⁻¹) : ℤ), by rw [Int.cast_natCast, ZMod.natCast_zmod_val]⟩
  have ham : a = m • b := by
    calc a = (1 : ZMod p) • a := by rw [one_smul]
      _ = ((n : ZMod p)⁻¹ * (n : ZMod p)) • a := by rw [inv_mul_cancel₀ hnc]
      _ = (n : ZMod p)⁻¹ • ((n : ZMod p) • a) := by rw [mul_smul]
      _ = (n : ZMod p)⁻¹ • b := by rw [← hb']
      _ = (m : ZMod p) • b := by rw [hm]
      _ = m • b := by rw [Int.cast_smul_eq_zsmul]
  refine le_antisymm ?_ ?_
  · rw [AddSubgroup.zmultiples_le]; exact h
  · rw [AddSubgroup.zmultiples_le]
    exact AddSubgroup.mem_zmultiples_iff.mpr ⟨m, ham.symm⟩

/-- **Theorem 13 of Schmidt–Wingberg from a cyclic retraction of the coefficient module.**

Let `X = corCocycle k Ω K E y sec` be the corestriction cocycle of the given class `y` and let
`ψ : E →+ E` be additive and `Gal(K|k)`-equivariant (`hψsmul`) with cyclic image (`hψcyc`), fixing
`X` on the decomposition groups of the places of `S` that are split in `K|k` (`hψfix`).  Then
`x := ψ ∘ X` satisfies every clause of Theorem 13.

The map `ψ` is the only freedom that is left once clauses (3)–(6) are imposed on the corestriction,
and `hψfix` is exactly the part of clause (3) that `ψ` must respect; the point of the lemma is that
the *last* clause is then automatic (the local images of `x` are contained in the cyclic group
`ψ(E)`), so that no arithmetic input beyond `y` is needed.  For `ψ = 0` this recovers
`shafarevich_theorem13_of_corestriction_vanishes_on_split` below, which covers in particular the
case in which every place of `S` split in `K|k` lies over `p` (then `hy0` forces `X` to vanish on
its decomposition group). -/
theorem shafarevich_theorem13_of_cyclic_projection
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (ψ : E →+ E) (hψsmul : ∀ (s : K ≃ₐ[k] K) (e : E), ψ (s • e) = s • ψ e)
    (hψcyc : ∃ e : E, ∀ e' : E, ψ e' ∈ AddSubgroup.zmultiples e)
    (hψfix : ∀ A ∈ S, IsSplitIn k K A → ∀ δ ∈ decomp k A,
      ψ (corCocycle k Ω K E y sec δ) = corCocycle k Ω K E y sec δ) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  obtain ⟨h1, h2, h3, h4, h5⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram y hy hyc hyS hyT hy0 sec hsec
  have h6 := corCocycle_satisfies_involution_clause p k Ω K E y hy hyinf sec hsec
  have hxc : IsCocycleOn (res k K) ⊤ (fun δ => ψ (corCocycle k Ω K E y sec δ)) := by
    intro g _ h _
    have h0 := h1 g (Subgroup.mem_top g) h (Subgroup.mem_top h)
    show ψ (corCocycle k Ω K E y sec (g * h))
      = ψ (corCocycle k Ω K E y sec g)
        + (res k K g) • ψ (corCocycle k Ω K E y sec h)
    rw [h0, map_add, hψsmul]
  have hxl : IsLocConstOn ⊤ (fun δ => ψ (corCocycle k Ω K E y sec δ)) := by
    obtain ⟨U, hU, hcX⟩ := h2
    refine ⟨U, hU, fun g _ u hu _ => ?_⟩
    show ψ (corCocycle k Ω K E y sec (g * u)) = ψ (corCocycle k Ω K E y sec g)
    rw [hcX g (Subgroup.mem_top g) u hu (Subgroup.mem_top u)]
  refine ⟨fun δ => ψ (corCocycle k Ω K E y sec δ), hxc, hxl, ?_, ?_, ?_, ?_, ?_⟩
  · intro A hA hsplit
    refine ⟨0, fun δ hδ => ?_⟩
    have hδH : δ ∈ K.fixingSubgroup := hsplit hδ
    have hres : corCocycle k Ω K E y sec δ
        = ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s) :=
      corCocycle_restrict k Ω K E y sec δ hδH
    show ψ (corCocycle k Ω K E y sec δ)
      - (∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s)) = (res k K δ) • (0 : E) - 0
    rw [← hres, hψfix A hA hsplit δ hδ, sub_self, smul_zero, sub_zero]
  · intro A hA hns
    obtain ⟨m, hm⟩ := h4 A hA hns
    refine ⟨ψ m, fun δ hδ => ?_⟩
    have h0 := hm δ hδ
    show ψ (corCocycle k Ω K E y sec δ) = (res k K δ) • ψ m - ψ m
    rw [h0, map_sub, hψsmul]
  · intro c hc
    obtain ⟨m, hm⟩ := h6 c hc
    refine ⟨ψ m, fun δ hδ => ?_⟩
    have h0 := hm δ hδ
    show ψ (corCocycle k Ω K E y sec δ) = (res k K δ) • ψ m - ψ m
    rw [h0, map_sub, hψsmul]
  · intro B hB hconj hns σ hσ
    have h0 := h5 B hB hconj hns σ hσ
    show ψ (corCocycle k Ω K E y sec σ) = 0
    rw [h0, map_zero]
  · intro B hB hconj
    by_cases hsp : IsSplitIn k Λ B
    · have hspK : IsSplitIn k K B :=
        fun δ hδ => (IntermediateField.fixingSubgroup_le hKΛ) (hsp hδ)
      have hcyc : ∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ n : ℤ,
          ψ (corCocycle k Ω K E y sec δ) = n • ψ (corCocycle k Ω K E y sec g) := by
        obtain ⟨e, he⟩ := hψcyc
        by_cases hz : ∃ g ∈ decomp k B, ψ (corCocycle k Ω K E y sec g) ≠ 0
        · obtain ⟨g, hgD, hgne⟩ := hz
          have hge : AddSubgroup.zmultiples (ψ (corCocycle k Ω K E y sec g))
              = AddSubgroup.zmultiples e :=
            zmultiples_eq_of_mem_zmultiples (p := p) hgne (he (corCocycle k Ω K E y sec g))
          refine ⟨g, hgD, fun δ hδ => ?_⟩
          have hmem : ψ (corCocycle k Ω K E y sec δ)
              ∈ AddSubgroup.zmultiples (ψ (corCocycle k Ω K E y sec g)) := by
            rw [hge]; exact he _
          obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
          exact ⟨n, hn.symm⟩
        · simp only [not_exists, not_and, not_not] at hz
          refine ⟨1, Subgroup.one_mem _, fun δ hδ => ⟨0, ?_⟩⟩
          rw [hz δ hδ, hz 1 (Subgroup.one_mem _), zero_smul]
      exact exists_cyclic_quotient_subgroup_of_cyclic_image p k Ω K E
        (fun δ => ψ (corCocycle k Ω K E y sec δ)) hxc hxl B hB hspK hcyc
    · refine exists_cyclic_quotient_subgroup_vanishing p k Ω K E
        (fun δ => ψ (corCocycle k Ω K E y sec δ)) hxc hxl B hB (fun σ hσ => ?_)
        (decomp_mod_inertia_cyclic k Ω B hB)
      have h0 := h5 B hB hconj hsp σ hσ
      show ψ (corCocycle k Ω K E y sec σ) = 0
      rw [h0, map_zero]

/-- **Theorem 13 of Schmidt–Wingberg when the corestriction vanishes on the split places of `S`.**

If the corestriction `X = corCocycle k Ω K E y sec` of the given class `y` vanishes on the
decomposition group of every place of `S` that is completely decomposed in `K|k`, then `x = 0` is a
witness for Theorem 13: clause (3) holds because `X` vanishes there (and the decomposition groups of
those places are contained in `G_K`, where coboundaries with respect to the trivial action vanish),
and the last clause holds with `U = decomp k B` (`V = ⊤`).  This is
`shafarevich_theorem13_of_cyclic_projection` for `ψ = 0`; it covers in particular the case in which
every place of `S` split in `K|k` lies over `p`, where `hy0` forces `X` to vanish. -/
theorem shafarevich_theorem13_of_corestriction_vanishes_on_split
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hvanish : ∀ A ∈ S, IsSplitIn k K A →
      ∀ δ ∈ decomp k A, corCocycle k Ω K E y sec δ = 0) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x :=
  shafarevich_theorem13_of_cyclic_projection p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram
    y hy hyc hyS hyT hy0 hyinf sec hsec 0 (fun s e => by simp)
    ⟨0, fun e' => by simp⟩
    (fun A hA hsp δ hδ => by rw [AddMonoidHom.zero_apply, hvanish A hA hsp δ hδ])


/-- **"`B` lies over the prime `p`" is invariant under the action of `G_k` on the places of `Ω`.**

The element `p ∈ k` is fixed by every `k`-algebra automorphism of `Ω`, so the value
`B.valuation (p : Ω)` is transported.  This is the place-theoretic input of
`shafarevich_theorem13_of_split_places_over_p` below. -/
lemma valuation_lt_one_natCast_smul_iff {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (p : ℕ) (g : Ω ≃ₐ[k] Ω) (A : ValuationSubring Ω) :
    (g • A : ValuationSubring Ω).valuation (p : Ω) < 1 ↔ A.valuation (p : Ω) < 1 := by
  have hfix : ∀ h : Ω ≃ₐ[k] Ω, h • (p : Ω) = (p : Ω) := by
    intro h
    show h (p : Ω) = (p : Ω)
    rw [← map_natCast (algebraMap k Ω) p, AlgEquiv.commutes]
  constructor
  · intro hg
    have hmem : (p : Ω) ∈ (g • A : ValuationSubring Ω) :=
      (ValuationSubring.valuation_le_one_iff (g • A) (p : Ω)).mp (le_of_lt hg)
    have h2 := smul_valuation_lt_one (k := k) g⁻¹ (g • A) (p : Ω) hmem
    rw [hfix g⁻¹, inv_smul_smul] at h2
    exact h2.mpr hg
  · intro hA
    have hmem : (p : Ω) ∈ A :=
      (ValuationSubring.valuation_le_one_iff A (p : Ω)).mp (le_of_lt hA)
    have h2 := smul_valuation_lt_one (k := k) g A (p : Ω) hmem
    rw [hfix g] at h2
    exact h2.mpr hA

/-- **Theorem 13 of Schmidt–Wingberg when the split places of `S` all lie over `p`.**

If every place of `S` that is completely decomposed in `K|k` lies over `p`, then the hypothesis
`hy0` of Theorem 13 forces the corestriction `corCocycle k Ω K E y sec` to vanish on the
decomposition group of each of them, and
`shafarevich_theorem13_of_corestriction_vanishes_on_split` provides the witness `x = 0`.

The argument is that for `δ ∈ decomp k A` the arguments `(sec s)⁻¹ * δ * sec s` of the defining sum
of the corestriction lie in `decomp k ((sec s)⁻¹ • A)`, and `(sec s)⁻¹ • A` is again a place of `S`
over `p` (`valuation_lt_one_natCast_smul_iff`), so `hy0` kills them. -/
theorem shafarevich_theorem13_of_split_places_over_p
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (hoverp : ∀ A ∈ S, IsSplitIn k K A → A.valuation (p : Ω) < 1) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  refine shafarevich_theorem13_of_corestriction_vanishes_on_split p k Ω K Λ hKΛ ζ hζ hζK E
    S hSfin hSdisj hSram y hy hyc hyS hyT hy0 hyinf sec hsec ?_
  intro A hA hsp δ hδ
  rw [corCocycle_restrict k Ω K E y sec δ (hsp hδ)]
  refine Finset.sum_eq_zero (fun s _ => ?_)
  have hδA : δ • A = A := hδ
  have hresδ : res k K δ = 1 := (mem_fixingSubgroup_iff_res_eq_one k Ω K δ).mpr (hsp hδ)
  have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
    rw [← mem_fixingSubgroup_iff_res_eq_one, map_mul, map_mul, map_inv, hsec, hresδ]
    group
  have hmemD : (sec s)⁻¹ * δ * sec s ∈ decomp k ((sec s)⁻¹ • A) := by
    rw [MulAction.mem_stabilizer_iff]
    show (((sec s)⁻¹ * δ * sec s) • ((sec s)⁻¹ • A)) = (sec s)⁻¹ • A
    rw [mul_smul, mul_smul, smul_inv_smul, hδA]
  have hconjval : ((sec s)⁻¹ • A : ValuationSubring Ω).valuation (p : Ω) < 1 :=
    (valuation_lt_one_natCast_smul_iff p (sec s)⁻¹ A).mpr (hoverp A hA hsp)
  have hz := hy0 ((sec s)⁻¹ • A) ((isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA))
    ⟨A, hA, ⟨(sec s)⁻¹, rfl⟩⟩ (Or.inr hconjval) ((sec s)⁻¹ * δ * sec s) hmemK hmemD
  rw [hz, smul_zero]


/-! ## Čebotarev with a finite set of primes avoided (the arithmetic input of §4)

The arithmetic heart of Schmidt–Wingberg §4 is Čebotarev's density theorem: to build the auxiliary
class `z` one repeatedly needs a *new* prime at which a prescribed element of the Galois group of a
finite Galois level is an arithmetic Frobenius element, and that prime must avoid the finitely many
primes already used.  The workspace's Chebotarev for a general number field `k` is available in the
**density** form `NK.Reconstruct.ChebotarevDensityInput k Ω`, which follows from Artin reciprocity
(`NK.Reconstruct.chebotarevDensityInput_of_artinReciprocity`) and is the sharpest form proved in this
repository; `NK.Reconstruct.exists_isFrobAtPrime_mem_of_hasFullDensity` turns it into a prime *inside
a prescribed set of full Dirichlet density*.

The lemma below is the form actually needed: a finite set of primes has Dirichlet density `0`, so
its complement has full density, and the prescribed Frobenius element is realised at a prime outside
the given finite set.  No separability or Galois hypothesis on `Ω` is required beyond `[Algebra k Ω]`. -/



set_option linter.style.haveILetI false in
/-! ## The Čebotarev step of Schmidt–Wingberg §4 (the new ramification prime)

The construction of the auxiliary class `z` of Schmidt–Wingberg §4 (the paper's pp. 13–20) chooses,
at each step, a *new* prime `P_{n+1} ∈ S∖T_n(K)`, completely decomposed in `Λ|k`, at which a
prescribed Frobenius element is realised, and which avoids the finitely many primes already used.
The lemma below is that step, in the corrected form: the prescribed Frobenius element of `Gal(L|k)`
is realised by an element of the decomposition group of one and the same *place* `B` (not merely up
to conjugacy, which was the defect of the sibling node's `chebotarev_sameFrobeniusClass_split`).

All of its ingredients are the ones proved above in this file:
* `exists_isFrobAtPrime_notMem_finite` — Čebotarev with a finite set of primes avoided;
* the prime–place bridge `map_res_decomp_eq_stabilizer_valuationRing`;
* `isSplitIn_iff_primesOver_ncard` and `Commons.NumberTheory.NumberField.ncard_primesOver_eq_finrank_iff_splitCompletely`
  for the complete-splitting clause (with `NK.Chebotarev.IsFrobAt_eq_one_iff_inertiaDeg_eq_one`
  supplying the inertia degree `1`);
* `levelSub_le_fixingSubgroup_of_ramificationIdx_eq_one` +
  `not_isRamifiedIn_of_levelSub_le_fixingSubgroup` for the unramifiedness clause (applied at the
  level `M = L ⊔ N ⊇ L`, so that only the ramification of `M` has to be avoided);
* `not_isConjPlace_of_notMem_primeUnder` for the avoidance clause. -/

/-- **Čebotarev with a prescribed Frobenius element, prescribed splitting and prescribed
unramifiedness (the "new ramification prime" of Schmidt–Wingberg §4).**

Let `L` and `N` be finite Galois levels of a number field `k` inside an algebraic closure `Ω`, let
`T'` be a finite set of pairwise non-conjugate finite places of `Ω`, and let `τ ∈ G_k` be an element
whose restriction to `N` is trivial.  Then there is a finite place `B` of `Ω` such that

* `B` is not a `G_k`-conjugate of any place of `T'`;
* the prime of `k` below `B` is unramified in `L` (hence `¬ IsRamifiedIn k L B`);
* the prime of `k` below `B` splits completely in `N` (that is, `IsSplitIn k N B`);
* some `σ ∈ decomp k B` restricts to `res k L τ` on `L`.

Note that `T'` is used only through its underlying *set*: neither its finiteness nor the
"one place per prime" condition (`hT'disj` in the sibling statements) is needed, so they are not
hypotheses here.

The compatibility hypothesis `hτ` ("`τ` is trivial on `N`, and realises `res k L τ` on `L`") is
what makes the prescribed Frobenius well defined at the compositum `L ⊔ N`: it is the condition
that `(res k L τ, 1)` comes from an element of `Gal(L ⊔ N|k)`.

This is the corrected form of the "Piece 2" of the arithmetic lane of the `z`-node
(`Submission/Work/SSGRoute/z_data_mup_arith.lean`, where the statement without `hτ` is *false*:
see the counterexample recorded in the docstring of the sibling `frobeniusClass_realisation`
discussion in the STATUS comment of this file). -/
theorem frobeniusClass_realisation {k Ω : Type} [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (hc : NK.Reconstruct.ChebotarevDensityInput k Ω)
    (L N : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    [FiniteDimensional k N] [IsGalois k N]
    (T' : Finset (ValuationSubring Ω))
    (τ : Ω ≃ₐ[k] Ω) (hτ : ∃ τ₀ : Ω ≃ₐ[k] Ω, res k N τ₀ = 1 ∧ res k L τ₀ = res k L τ) :
    ∃ B : ValuationSubring Ω, IsFinPlace k B ∧
      (∀ C ∈ T', ¬ IsConjPlace k C B) ∧
      ¬ IsRamifiedIn k L B ∧ IsSplitIn k N B ∧
      ∃ σ : Ω ≃ₐ[k] Ω, σ ∈ decomp k B ∧ res k L σ = res k L τ := by
  classical
  obtain ⟨τ₀, hτ₀N, hτ₀L⟩ := hτ
  -- ### The compositum `M = L ⊔ N` and its structure
  let M : IntermediateField k Ω := L ⊔ N
  have hLM : L ≤ M := le_sup_left
  have hNM : N ≤ M := le_sup_right
  haveI hMfin : FiniteDimensional k M := IntermediateField.finiteDimensional_sup L N
  haveI hMnor : Normal k M := inferInstance
  haveI hMgal : IsGalois k M := Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  haveI hMnum : NumberField ↥M :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField M
  -- canonical algebra structures for the two towers `k ⊆ L ⊆ M` and `k ⊆ N ⊆ M`
  letI : Algebra ↥L ↥M := (Subsemiring.inclusion hLM).toAlgebra
  haveI : IsScalarTower k ↥L ↥M := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI : IsScalarTower ↥L ↥M Ω := IsScalarTower.of_algebraMap_eq fun x => rfl
  letI : Algebra ↥N ↥M := (Subsemiring.inclusion hNM).toAlgebra
  haveI : IsScalarTower k ↥N ↥M := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI : IsScalarTower ↥N ↥M Ω := IsScalarTower.of_algebraMap_eq fun x => rfl
  -- ### The bad set of primes of `k`
  set Bad : Set (NK.Chebotarev.PrimeIdeal k) :=
    {p | (∃ A ∈ T', A.comap (algebraMap k Ω) =
        IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p) ∨
      (∃ P : NK.Chebotarev.PrimeIdeal ↥M,
        P.asIdeal.LiesOver p.asIdeal ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1) ∨
      (∃ Q : NK.Chebotarev.PrimeIdeal ↥N,
        Q.asIdeal.LiesOver p.asIdeal ∧
        Q.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1)} with hBad
  have hBadfin : Bad.Finite := by
    rw [hBad]
    exact (finite_setOf_primeUnder T').union
      ((finite_setOf_primeUnder_ramified M).union (finite_setOf_primeUnder_ramified N))
  -- ### Čebotarev
  obtain ⟨p, hpBad, hfrobp⟩ :=
    exists_isFrobAtPrime_notMem_finite hc Bad hBadfin M (res k M τ₀)
  obtain ⟨P, hPlies, hPfrob⟩ := hfrobp
  -- ### The place `B` over `P`
  obtain ⟨B, hBcomap⟩ :=
    Commons.NumberTheory.NumberField.Valuation.exists_valuationSubring_at_prime
      (K := ↥M) (K' := Ω) P
  have hBk : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p := by
    have h1 : B.comap (algebraMap k Ω) =
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P).comap
          (algebraMap k ↥M) := by
      rw [← hBcomap]
      exact (ValuationSubring.comap_comap B (algebraMap ↥M Ω) (algebraMap k ↥M)).symm
    rw [h1]
    exact Commons.RingTheory.Valuation.comap_valuationSubringAtPrime p P hPlies
  have hBne : B.comap (algebraMap k Ω) ≠ ⊤ := by
    rw [hBk]
    exact Commons.RingTheory.Valuation.valuationSubringAtPrime_ne_top (K := k) p
  have hBfin : IsFinPlace k B := hBne
  refine ⟨B, hBfin, ?_, ?_, ?_, ?_⟩
  · -- **avoidance**: `B` is not conjugate to any place of `T'`
    refine not_isConjPlace_of_notMem_primeUnder T' B p hBk (fun h => hpBad (Or.inl h))
  · -- **unramifiedness in `L`**: use the level `M ⊇ L`
    have hunrM : ∀ Q : NK.Chebotarev.PrimeIdeal ↥M, Q.asIdeal.LiesOver p.asIdeal →
        Q.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := by
      intro Q hQ
      by_contra hne
      exact hpBad (Or.inr (Or.inl ⟨Q, hQ, hne⟩))
    have hlev := levelSub_le_fixingSubgroup_of_ramificationIdx_eq_one M B hBne p hBk hunrM
    rintro ⟨σ, hσI, hσnot⟩
    refine hσnot (IntermediateField.fixingSubgroup_le hLM ?_)
    exact hlev ((mem_levelSub_iff B σ).mpr hσI M)
  · -- **complete splitting in `N`**
    have hQlies : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.LiesOver p.asIdeal :=
      Ideal.LiesOver.mk (by
        rw [show (P.under (NumberField.RingOfIntegers ↥N)).asIdeal =
            P.asIdeal.under (NumberField.RingOfIntegers ↥N) from rfl, Ideal.under_under]
        exact hPlies.over)
    have heQ : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.ramificationIdx
        (NumberField.RingOfIntegers k) = 1 := by
      by_contra hne
      exact hpBad (Or.inr (Or.inr ⟨P.under (NumberField.RingOfIntegers ↥N), hQlies, hne⟩))
    have hfrobN : NK.Chebotarev.IsFrobAt (P.under (NumberField.RingOfIntegers ↥N))
        (1 : (↥N) ≃ₐ[k] (↥N)) := by
      have h := NK.Chebotarev.isFrobAt_restrictNormalHom_le (L := N) (M := M) (hLM := hNM)
        (P := P) (ρ := res k M τ₀) hPfrob
      rwa [← NK.Chebotarev.restrictNormalHom_le_comp N M hNM τ₀, hτ₀N] at h
    have hfQ : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.inertiaDeg
        (NumberField.RingOfIntegers k) = 1 :=
      (NK.Chebotarev.IsFrobAt_eq_one_iff_inertiaDeg_eq_one hQlies heQ).mp hfrobN
    rw [isSplitIn_iff_primesOver_ncard N B p hBk,
      Commons.NumberTheory.NumberField.ncard_primesOver_eq_finrank_iff_splitCompletely
        (K := k) (L := ↥N) p]
    haveI : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.LiesOver p.asIdeal := hQlies
    constructor
    · rw [Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal
        (P.under (NumberField.RingOfIntegers ↥N)).asIdeal (Gal(↥N/k))]
      exact heQ
    · rw [Ideal.inertiaDegIn_eq_inertiaDeg p.asIdeal
        (P.under (NumberField.RingOfIntegers ↥N)).asIdeal (Gal(↥N/k))]
      exact hfQ
  · -- **the prescribed Frobenius is realised in `decomp k B`**
    have hgdec : res k M τ₀ ∈
        Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P := by
      show Submission.NeukirchUchida.Local.placeSmul (res k M τ₀) P = P
      apply IsDedekindDomain.HeightOneSpectrum.ext
      rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
      exact NK.Chebotarev.IsFrobAtStabilizes hPfrob
    have hgstab : res k M τ₀ ∈ MulAction.stabilizer (↥M ≃ₐ[k] ↥M)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P) :=
      (Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
        P (res k M τ₀)).mpr hgdec
    obtain ⟨σ, hσ, hσres⟩ := Subgroup.mem_map.mp (by
      rw [map_res_decomp_eq_stabilizer_valuationRing M B hBne P hBcomap]
      exact hgstab)
    refine ⟨σ, hσ, ?_⟩
    rw [NK.Chebotarev.restrictNormalHom_le_comp L M hLM σ, hσres,
      ← NK.Chebotarev.restrictNormalHom_le_comp L M hLM τ₀, hτ₀L]


/-- **The Čebotarev new-prime step in the form of the sibling nodes.**  When the prescribed element
`τ` has trivial restriction to `N` (the hypothesis in which the step is used by
`Work.SSGRoute.z_data_mup_core`, `Work.SSGRoute.shafarevich_z_data_two` and
`Work.SSGRoute.sw_z_exists_odd_sketch`), `frobeniusClass_realisation` applies with `τ₀ := τ`: the
compatibility hypothesis `∃ τ₀, res k N τ₀ = 1 ∧ res k L τ₀ = res k L τ` is then automatic.  (It is
in fact automatic for *every* `τ` with `res k N τ = 1`, because `res k L τ` and `1` agree on
`L ⊓ N`: both are obtained by restricting `τ` to `L ⊓ N`.) -/
theorem frobeniusClass_realisation_of_res_eq_one {k Ω : Type} [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (hc : NK.Reconstruct.ChebotarevDensityInput k Ω)
    (L N : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    [FiniteDimensional k N] [IsGalois k N]
    (T' : Finset (ValuationSubring Ω))
    (τ : Ω ≃ₐ[k] Ω) (hτ : res k N τ = 1) :
    ∃ B : ValuationSubring Ω, IsFinPlace k B ∧
      (∀ C ∈ T', ¬ IsConjPlace k C B) ∧
      ¬ IsRamifiedIn k L B ∧ IsSplitIn k N B ∧
      ∃ σ : Ω ≃ₐ[k] Ω, σ ∈ decomp k B ∧ res k L σ = res k L τ :=
  frobeniusClass_realisation hc L N T' τ ⟨τ, hτ, rfl⟩

/-! ## The retract reduction of the `z`-statement (the general-coefficient case)

The `z`-statement (`Work.SSGRoute.shafarevich_z_construction`) and Theorem 13 are statements about
*arbitrary* finite `𝔽_p[Gal(K|k)]`-modules `E`, while the construction in the literature (the
sequence `z_1, z_2, …` of Schmidt–Wingberg §4, pp. 13–20) is carried out for a module that is its
own Tate dual up to the trivial cyclotomic twist: for `E = μ_p` this holds because `μ_p ⊆ K`, and
for a general `E` it holds for `E ⊕ E^∨(1)`.

The lemma below records the formal half of that reduction: **if the conclusion holds for the module
`E × F` and the datum `δ ↦ (y δ, 0)` (i.e. for `y` viewed in `E × F` through the first
summand), then it holds for `E` and `y`.**  The proof is a retraction: every clause of the
conclusion is preserved by the `Gal(K|k)`-equivariant projection `Prod.fst : E × F → E`
(cocycles, local constancy, coboundaries, pointwise vanishings — and for the last clause the
vanishing of the transfer, because `Prod.fst` is additive and commutes with the action and with
finite sums).

Consequently, to prove Theorem 13 (or the `z`-statement) for an arbitrary `E` it is enough to prove
it for a module of the form `E ⊕ E^∨(1)`, which is self-dual; this is the shape in which a
generalized §4 argument (with the canonical local Tate pairing of
`Work.SSGRoute.canonical_localPairing_with_reciprocity` in place of the Hilbert symbol) is expected
to be available.  Note that a *quotient* (as opposed to retract) reduction is false: the hypotheses
of the theorem are pointwise vanishings, so a lift of a datum along a surjection `P ↠ Q` need not
satisfy them. -/

/-- **The retract reduction of the `z`-statement.**  If the conclusion of
`Work.SSGRoute.shafarevich_z_construction` holds for the coefficient module `E × F` and the datum
`δ ↦ (y δ, 0)` — i.e. for the datum `y` viewed in `E × F` — then it holds for `E` and `y`. -/
theorem shafarevich_z_statement_of_retract
    (p : ℕ) [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [Normal k K]
    [FiniteDimensional k Λ] [Normal k Λ] [Fintype (K ≃ₐ[k] K)]
    {E : Type} [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    {F : Type} [AddCommGroup F] [Module (ZMod p) F] [DistribMulAction (K ≃ₐ[k] K) F]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) F]
    (S : Finset (ValuationSubring Ω)) (y : (Ω ≃ₐ[k] Ω) → E)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (h : ∃ z : (Ω ≃ₐ[k] Ω) → E × F,
      IsCocycleOn (res k K) K.fixingSubgroup z ∧
      IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = (y σ, 0)) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ decomp k B ⊓ V,
            (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0))) :
    ∃ z : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) K.fixingSubgroup z ∧
      IsLocConstOn K.fixingSubgroup z ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → z σ = y σ) ∧
      (∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → z c = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → z σ = 0) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          (∀ δ ∈ decomp k B ⊓ V,
            (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0)) := by
  obtain ⟨z, hz1, hz2, hz3, hz4, hz5, hz6⟩ := h
  refine ⟨fun δ => (z δ).1, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- a product cocycle projects to a cocycle
    intro g hg h hh
    have hh' := hz1 g hg h hh
    simp only []
    rw [hh', Prod.fst_add, Prod.smul_fst]
  · -- local constancy is preserved
    obtain ⟨U, hU, hcU⟩ := hz2
    refine ⟨U, hU, fun g hg u hu hgu => ?_⟩
    simp only []
    rw [hcU g hg u hu hgu]
  · -- the agreement clause
    intro B hB hconj σ hσG hσ
    have hh' := hz3 B hB hconj σ hσG hσ
    simp only []
    rw [hh']
  · -- the involutions
    intro c hc hc2
    have hh' := hz4 c hc hc2
    simp only []
    rw [hh']
    rfl
  · -- vanishing on the outside inertia
    intro B hB hconj hnotsplit σ hσG hσI
    have hh' := hz5 B hB hconj hnotsplit σ hσG hσI
    simp only []
    rw [hh']
    rfl
  · -- the last clause: the same `V` works, and the transfer vanishes after projecting
    intro B hB hconj hsplit
    obtain ⟨V, hVopen, hVnorm, hVcyc, hVvan⟩ := hz6 B hB hconj hsplit
    refine ⟨V, hVopen, hVnorm, hVcyc, fun δ hδ => ?_⟩
    have hh' := hVvan δ hδ
    have hproj : (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)).1
        = ∑ s : K ≃ₐ[k] K, s • (z ((sec s)⁻¹ * δ * sec s)).1 :=
      (map_sum (AddMonoidHom.fst E F)
          (fun s : K ≃ₐ[k] K => s • z ((sec s)⁻¹ * δ * sec s)) Finset.univ).trans
        (Finset.sum_congr rfl fun s _ => Prod.smul_fst s _)
    simp only []
    rw [← hproj, hh']
    rfl

/-! ## Schmidt–Wingberg's `z`-data as a predicate, and its `⊕`-combination

The `z`-data of §4 (the conclusion of `Work.SSGRoute.z_data_general`, i.e. the sharpened condition
(b) with the ramification trigger, together with the cyclicity of the local image) is used in two
places: as the input of `Work.SSGRoute.shafarevich_z_construction_of_zData`, and inside the paper's
induction on `dim_{F_p} A` (pp. 18–19), where the class for `A = A_0 ⊕ μ_p` is the *sum*
`z = z⁰ + inf z⁰⁰` of a class for `A_0` and one for `μ_p`.  The verification that the sum is again
`z`-data is purely formal once the two summands have *disjoint ramification*: at a place where one
summand is ramified the other one vanishes on the local groups of all the `G_k`-conjugates of that
place (which is exactly what the paper arranges by prescribing the vanishing of `ỹ` at `T_0∖T(K)`),
and then every clause of the conclusion is read off from the corresponding clause of the summand
that is ramified there.

The predicate `IsZData` below moves the existential quantifier over `z` out of that conclusion, and
`IsZData.prod` is the `⊕`-combination. -/


/-- **The `ytilde`-construction of Schmidt–Wingberg §4, pp. 18–19, from the exposed localisation
interface.**

The hypothesis `hrealise` is the *interface* (Poitou–Tate in degree one, **relaxed at the places that
are split in the auxiliary field `Λ`**, in the form used by the paper): for every family `f` of local
data at the places of `T` (prescribed on the *level-`K`* local groups `decomp k A ⊓ K.fixingSubgroup`)
which is orthogonal, with respect to the local Tate pairings `pair`, to every class `b` whose local
components mirror the localisation problem — `b` unramified at the places outside `S₀` that are not
split in `Λ`, and `b` *vanishing on the local groups* of the places outside `S₀` that are split in
`Λ` — there is a class `ytilde` realising those local components with the *relaxed* unramifiedness
clause (`IsYRealisation`, which asks for unramifiedness only at the places outside `S₀` that are not
split in `Λ`, or for the vanishing on the local groups of `S₀ ∖ T`).

Two points of care, both of which are corrections of an earlier form of this interface:

* the datum has to be prescribed on the level-`K` local group (the class `ytilde` is a class over
  `K`); the earlier form required `f A` to be a cocycle on the whole `decomp k A`, which is not
  satisfiable in general;
* the dual classes `b` have to satisfy the local conditions *mirroring* the relaxation: a class `b`
  that is only unramified outside `S₀` (without vanishing on the split-in-`Λ` places outside `S₀`)
  can obstruct a datum which *is* realisable, because the realisable datum may be ramified at those
  split places (with `k = K = ℚ`, `p = 2`, `Λ = ℚ(√5)`, `S = S₀ = {2,5,13}` and `ν = χ₄₁` as in the
  STATUS block below, the datum *is* realised by `ν` itself, while the class `b = 13` — unramified
  outside `S₀`, but with non-trivial local component at the split-in-`Λ` place `11` — pairs
  non-trivially with it at `13`).  The conditions above are the standard ones for the relaxed
  Poitou–Tate localisation (relaxation at the split-in-`Λ` places, i.e. the places where the
  sixth conjunct of the `z`-data takes over).

The paper supplies this interface by the diagram chase with the two exact lines of the Poitou–Tate
sequence; here it is exposed, and `horth` is the orthogonality for the data at hand
(which in the paper is *derived* from the exactness of the lower line and the fact that the datum
comes from the global class `y⁰⁰ ∈ H¹(k_S|K, μ_p)`).

Note that `hrealise` quantifies over *all* data `f`, so this theorem is not a restatement of its own
conclusion: what it isolates is exactly that the datum at hand satisfies the orthogonality
hypothesis, i.e. the arithmetic content of the paper's diagram chase. -/
theorem exists_isYRealisation_of_localisation (p : ℕ) [Fact p.Prime] {k Ω : Type} [Field k]
    [Field Ω] [Algebra k Ω] (K : IntermediateField k Ω) [Normal k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (Λ : IntermediateField k Ω) (T S₀ : Finset (ValuationSubring Ω))
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ZMod p)
    (hrealise : ∀ f : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → ZMod p,
      (∀ A ∈ T, IsCocycleOn (res k K) (decomp k A ⊓ K.fixingSubgroup) (f A) ∧
        IsLocConstOn (decomp k A ⊓ K.fixingSubgroup) (f A)) →
      (∀ A ∈ T, ∀ B ∈ T, IsConjPlace k A B → A = B) →
      (∀ b : (Ω ≃ₐ[k] Ω) → ZMod p,
        IsCocycleOn (res k K) K.fixingSubgroup b →
        IsLocConstOn K.fixingSubgroup b →
        (∀ B : ValuationSubring Ω, IsFinPlace k B →
          (∀ A ∈ S₀, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
          ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → b σ = 0) →
        (∀ B : ValuationSubring Ω, IsFinPlace k B →
          (∀ A ∈ S₀, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
          ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → b σ = 0) →
        ∑ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) (f A) b = 0) →
      ∃ ytilde : (Ω ≃ₐ[k] Ω) → ZMod p, IsYRealisation p K Λ T S₀ f ytilde)
    (f : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → ZMod p)
    (hf : ∀ A ∈ T, IsCocycleOn (res k K) (decomp k A ⊓ K.fixingSubgroup) (f A) ∧
      IsLocConstOn (decomp k A ⊓ K.fixingSubgroup) (f A))
    (hTdisj : ∀ A ∈ T, ∀ B ∈ T, IsConjPlace k A B → A = B)
    (horth : ∀ b : (Ω ≃ₐ[k] Ω) → ZMod p,
      IsCocycleOn (res k K) K.fixingSubgroup b →
      IsLocConstOn K.fixingSubgroup b →
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S₀, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → b σ = 0) →
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S₀, ¬ IsConjPlace k A B) → IsSplitIn k Λ B →
        ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → b σ = 0) →
      ∑ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) (f A) b = 0) :
    ∃ ytilde : (Ω ≃ₐ[k] Ω) → ZMod p, IsYRealisation p K Λ T S₀ f ytilde :=
  hrealise f hf hTdisj horth

/-- **The contributions of the "new" places to the reciprocity sum vanish** when the second datum
vanishes on their local groups. -/
theorem sum_pair_eq_zero_of_vanishes_on_new {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k]
    [Field Ω] [Algebra k Ω] (K : IntermediateField k Ω) [Normal k K]
    [DecidableEq (ValuationSubring Ω)]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ZMod p)
    (hz : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)) (a b : (Ω ≃ₐ[k] Ω) → ZMod p),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      (IsCoboundaryOn (res k K) H a ∨ IsCoboundaryOn (res k K) H b) →
      pair H a b = 0)
    (T S₀ : Finset (ValuationSubring Ω))
    (a b : (Ω ≃ₐ[k] Ω) → ZMod p)
    (ha : IsCocycleOn (res k K) K.fixingSubgroup a) (hal : IsLocConstOn K.fixingSubgroup a)
    (hb : ∀ A ∈ S₀, IsCocycleOn (res k K) (decomp k A ⊓ K.fixingSubgroup) b)
    (hbl : ∀ A ∈ S₀, IsLocConstOn (decomp k A ⊓ K.fixingSubgroup) b)
    (hvanish : ∀ B ∈ S₀, B ∉ T →
      ∀ δ ∈ decomp k B ⊓ K.fixingSubgroup, b δ = 0) :
    ∑ A ∈ S₀ \ T, pair (decomp k A ⊓ K.fixingSubgroup) a b = 0 := by
  refine Finset.sum_eq_zero (fun A hA => ?_)
  rw [Finset.mem_sdiff] at hA
  obtain ⟨hAS₀, hAnT⟩ := hA
  have hle : decomp k A ⊓ K.fixingSubgroup ≤ K.fixingSubgroup := inf_le_right
  have hcob : IsCoboundaryOn (res k K) (decomp k A ⊓ K.fixingSubgroup) b :=
    ⟨0, fun δ hδ => by
      rw [hvanish A hAS₀ hAnT δ hδ, smul_zero, sub_zero]⟩
  exact hz _ a b
    ⟨isCocycleOn_mono (res k K) hle ha, isLocConstOn_mono hle hal⟩
    ⟨hb A hAS₀, hbl A hAS₀⟩ (Or.inr hcob)

/-- **The pinned data at `S` is compatible with the vanishing clause `hy0`.**

Let `A ∈ S` be *not* completely decomposed in `K|k`.  Clause (2) of the theorem's conclusion makes
`x` a coboundary on `decomp k A`, hence forces `x δ = 0` for every `δ ∈ decomp k A ⊓ G_K`; clause (1),
on the other hand, pins `x` to the corestriction `X = cor(y)` on the decomposition group of every
place of `S` that *is* completely decomposed, so for any such place `A'` and any
`δ ∈ decomp k A ⊓ decomp k A' ⊓ G_K` the two clauses together force `X δ = 0`.  This lemma records
that this forced relation is *automatic*: every argument
`sec(s)⁻¹ * δ * sec(s)` of the defining sum lies in `decomp k (sec(s)⁻¹ • A) ⊓ G_K`, and `hy0` kills
`y` there because `sec(s)⁻¹ • A` is a conjugate of `A ∈ S` and is again not completely decomposed in
`K|k`.  Consequently the local data pinned at `S` carries no hidden contradiction. -/
theorem corestriction_vanishes_on_intersection_of_split_and_nonsplit
    (p : ℕ) [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (hnorm : (K.fixingSubgroup).Normal)
    {E : Type} [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E]
    (S : Finset (ValuationSubring Ω))
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (A : ValuationSubring Ω) (hA : A ∈ S) (hns : ¬ IsSplitIn k K A)
    (δ : Ω ≃ₐ[k] Ω) (hδA : δ ∈ decomp k A) (hδK : δ ∈ K.fixingSubgroup) :
    ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s) = 0 := by
  classical
  refine Finset.sum_eq_zero (fun s _ => ?_)
  have hmemD : (sec s)⁻¹ * δ * sec s ∈ decomp k ((sec s)⁻¹ • A) := by
    rw [decomp_conj]
    exact Subgroup.mem_map.mpr ⟨δ, hδA, by simp⟩
  have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
    simpa using hnorm.conj_mem δ hδK ((sec s)⁻¹)
  have hfin : IsFinPlace k ((sec s)⁻¹ • A) := (isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA)
  have hconj : ∃ A₀ ∈ S, IsConjPlace k A₀ ((sec s)⁻¹ • A) :=
    ⟨A, hA, ⟨(sec s)⁻¹, rfl⟩⟩
  have hnsplit : ¬ IsSplitIn k K ((sec s)⁻¹ • A) := fun h =>
    hns ((isSplitIn_conj K hnorm A (sec s)⁻¹).mp h)
  rw [hy0 ((sec s)⁻¹ • A) hfin hconj (Or.inl hnsplit) _ hmemK hmemD, smul_zero]

/-- **Discharging the orthogonality hypothesis (`horth`) of
`Work.SSGRoute.exists_isYRealisation_of_localisation` from reciprocity.**

Let `f` be local data at the places of `T` whose component at every `A ∈ T` agrees, up to a
coboundary, with the local component of a *global* class `a`; let `b` be a global class unramified
outside `S₀`.  If

* (`hrec`, **reciprocity**) the sum of the local pairings of `a` with `b` over the whole set `S₀`
  vanishes — this is the global reciprocity clause of the canonical local Tate pairing
  (`Work.SSGRoute.canonical_localPairing_with_reciprocity`), and
* (`hzero`) the contributions of the places of `S₀ ∖ T` to that sum vanish,

then the datum is orthogonal to `b` over `T`, i.e. the hypothesis `horth` of
`exists_isYRealisation_of_localisation` holds.  This is the `T`-part of the paper's pp. 18–19 diagram
chase: the datum at `T` is replaced by the global class `a` (the pairing only sees cohomology
classes, `Work.SSGRoute.pair_eq_of_sub_coboundary`), and the sum over `S₀` is then analysed by
reciprocity, leaving only the places of `S₀ ∖ T`. -/
theorem orthogonality_of_reciprocity {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω]
    [Algebra k Ω] (K : IntermediateField k Ω) [Normal k K]
    [DecidableEq (ValuationSubring Ω)]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ((Ω ≃ₐ[k] Ω) → ZMod p) → ZMod p)
    (hadd : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)) (a a' b : (Ω ≃ₐ[k] Ω) → ZMod p),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H a' ∧ IsLocConstOn H a') →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      pair H (a + a') b = pair H a b + pair H a' b)
    (hz : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)) (a b : (Ω ≃ₐ[k] Ω) → ZMod p),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      (IsCoboundaryOn (res k K) H a ∨ IsCoboundaryOn (res k K) H b) →
      pair H a b = 0)
    (T S₀ : Finset (ValuationSubring Ω)) (hTsub : T ⊆ S₀)
    (a b : (Ω ≃ₐ[k] Ω) → ZMod p)
    (ha : IsCocycleOn (res k K) K.fixingSubgroup a) (hal : IsLocConstOn K.fixingSubgroup a)
    (hb : ∀ A ∈ S₀, IsCocycleOn (res k K) (decomp k A ⊓ K.fixingSubgroup) b)
    (hbl : ∀ A ∈ S₀, IsLocConstOn (decomp k A ⊓ K.fixingSubgroup) b)
    (hrec : ∑ A ∈ S₀, pair (decomp k A ⊓ K.fixingSubgroup) a b = 0)
    (hzero : ∑ A ∈ S₀ \ T, pair (decomp k A ⊓ K.fixingSubgroup) a b = 0)
    (f : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → ZMod p)
    (hfdata : ∀ A ∈ T, IsCocycleOn (res k K) (decomp k A ⊓ K.fixingSubgroup) (f A) ∧
      IsLocConstOn (decomp k A ⊓ K.fixingSubgroup) (f A))
    (hf : ∀ A ∈ T, IsCoboundaryOn (res k K) (decomp k A ⊓ K.fixingSubgroup)
      (fun σ => f A σ - a σ)) :
    ∑ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) (f A) b = 0 := by
  -- the datum at `T` may be replaced by the global class `a`
  have hterm : ∀ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) (f A) b
      = pair (decomp k A ⊓ K.fixingSubgroup) a b := by
    intro A hA
    have hle : decomp k A ⊓ K.fixingSubgroup ≤ K.fixingSubgroup := inf_le_right
    exact pair_eq_of_sub_coboundary pair hadd hz (hfdata A hA)
      ⟨isCocycleOn_mono (res k K) hle ha, isLocConstOn_mono hle hal⟩
      ⟨hb A (hTsub hA), hbl A (hTsub hA)⟩ (hf A hA)
  have hstep : ∑ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) (f A) b
      = ∑ A ∈ T, pair (decomp k A ⊓ K.fixingSubgroup) a b :=
    Finset.sum_congr rfl (fun A hA => hterm A hA)
  rw [hstep]
  -- reciprocity over `S₀` minus the contributions at `S₀ ∖ T`
  have hsd := Finset.sum_sdiff (s₁ := T) (s₂ := S₀) hTsub
    (f := fun A => pair (decomp k A ⊓ K.fixingSubgroup) a b)
  rw [hrec, hzero] at hsd
  simpa using hsd



/-! ## Theorem 13 of Schmidt–Wingberg -/

theorem shafarevich_theorem13 (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, IsFinPlace k B →
      (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, IsFinPlace k B → (∃ A ∈ S, IsConjPlace k A B) →
      (¬ IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      IsCocycleOn (res k K) ⊤ x ∧ IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ IsSplitIn k K A →
        IsCoboundaryOn (res k K) (decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        IsCoboundaryOn (res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S, ¬ IsConjPlace k A B) → ¬ IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, IsFinPlace k B → (∀ A ∈ S, ¬ IsConjPlace k A B) →
        ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
          (∃ V : Subgroup (Ω ≃ₐ[k] Ω),
            IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
          (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
          (∃ g ∈ decomp k B,
            ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
          IsCoboundaryOn (res k K) U x := by
  -- The whole remaining content is the `z`-statement of Schmidt--Wingberg §4
  -- (`Work.SSGRoute.shafarevich_z_construction`, whose single remaining obligation is
  -- `Work.SSGRoute.z_data_general`); the bridge below is `shafarevich_theorem13_of_z_construction`.
  exact shafarevich_theorem13_of_z_construction p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram y hy
    hyc hyS hyT hy0 hyinf sec hsec
    (shafarevich_z_construction p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram y hy hyc hyS hyT
      hy0 hyinf sec hsec)

/-- **On a subgroup of `G_K` a coboundary is zero.**  The action of `G_K` on the coefficients is
trivial, so for `σ ∈ K.fixingSubgroup` the coboundary `σ ↦ res k K σ • m - m` vanishes.  Consequently
the local components of a class *over `K`* (an additive, locally constant function on
`K.fixingSubgroup`) are pinned by an *equality of cochains* on the level-`K` local group
`decomp k B ⊓ K.fixingSubgroup`: there is no non-trivial coboundary at level `K`.

This is the reason why the third conjunct of `Work.SSGRoute.IsYRealisation` is stated on
`decomp k B ⊓ K.fixingSubgroup` and not on the full `k`-level group `decomp k B`: the paper's
"`ỹ_P = y⁰⁰_P`" is an equality of local classes in `H¹(K_P, μ_p)`, and at level `K` that is an
equality of cochains.  The full-level form would instead require the level-`K` datum to extend to a
cocycle on the whole local group `decomp k B`, i.e. would require the local class of the datum to lie
in the image of the restriction `H¹(k_A, μ_p) → H¹(K_B, μ_p)`, which is not surjective in general and
is not needed by any consumer. -/
theorem coboundaryOn_fixingSubgroup_iff {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [Field Ω]
    [Algebra k Ω] {K : IntermediateField k Ω} [Normal k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : H ≤ K.fixingSubgroup) (f : (Ω ≃ₐ[k] Ω) → ZMod p) :
    IsCoboundaryOn (res k K) H f ↔ ∀ σ ∈ H, f σ = 0 := by
  constructor
  · rintro ⟨m, hm⟩ σ hσ
    have h1 : res k K σ = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker (K := k)]
      exact hH hσ
    rw [hm σ hσ, h1, one_smul, sub_self]
  · intro h
    exact ⟨0, fun σ hσ => by rw [h σ hσ, smul_zero, sub_zero]⟩

end Work.SSGRoute

