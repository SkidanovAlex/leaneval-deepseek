namespace Work.SSGRoute.PTCore

/-- **Two elements of a cyclic subgroup are integrally dependent with a *primitive* relation.**

If `x` and `y` both lie in the cyclic subgroup generated by `w`, then there is a relation
`m • x + n • y = 0` whose coefficient vector `(m, n)` is not both divisible by the prime `p`.

Indeed, write `x = a • w` and `y = b • w`, let `d = gcd a b` and put `a = d a'`, `b = d b'` with
`gcd a' b' = 1`.  Then `b' • x - a' • y = (b' * a' - a' * b') • (d • w) = 0`, and since `a'`, `b'`
are coprime no prime divides both of them — so `(b', -a')` is the required primitive relation.

(Consequently the `p`-torsion hypotheses are not needed for the conclusion; they are recorded
because that is the form in which the statement is used downstream.) -/
theorem zmultiples_pTorsion_int_dependent {A : Type} [AddCommGroup A] (p : ℕ) [Fact p.Prime]
    (w x y : A) (hx : x ∈ AddSubgroup.zmultiples w) (hy : y ∈ AddSubgroup.zmultiples w)
    (hpx : p • x = 0) (hpy : p • y = 0) :
    ∃ m n : ℤ, ¬((p : ℤ) ∣ m ∧ (p : ℤ) ∣ n) ∧ m • x + n • y = 0 := by
  -- Write the two elements as integer multiples of the common generator `w`.
  obtain ⟨a, ha⟩ := AddSubgroup.mem_zmultiples_iff.mp hx
  obtain ⟨b, hb⟩ := AddSubgroup.mem_zmultiples_iff.mp hy
  by_cases h0 : a = 0 ∧ b = 0
  · -- Both coefficients vanish: `x = y = 0` and `(1, 0)` is a primitive relation.
    obtain ⟨rfl, rfl⟩ := h0
    simp only [zero_smul] at ha hb
    refine ⟨1, 0, ?_, ?_⟩
    · rintro ⟨h1, _⟩
      exact (Fact.out : p.Prime).not_dvd_one (by exact_mod_cast h1)
    · rw [one_zsmul, zero_zsmul, add_zero, ← ha]
  · -- Otherwise cancel the greatest common divisor `d` of the two coefficients.
    have hgcd_ne : a.gcd b ≠ 0 := fun h => h0 (Int.gcd_eq_zero_iff.mp h)
    have hgcd_pos : 0 < a.gcd b := Nat.pos_of_ne_zero hgcd_ne
    set d : ℤ := ↑(a.gcd b) with hd
    have hda : d ∣ a := by rw [hd]; exact Int.gcd_dvd_left a b
    have hdb : d ∣ b := by rw [hd]; exact Int.gcd_dvd_right a b
    set a' : ℤ := a / d with ha'
    set b' : ℤ := b / d with hb'
    have haeq : a = d * a' := (Int.mul_ediv_cancel' hda).symm
    have hbeq : b = d * b' := (Int.mul_ediv_cancel' hdb).symm
    -- After cancellation the two coefficients are coprime.
    have hcop : a'.gcd b' = 1 := by
      rw [ha', hb', hd]
      exact Int.gcd_div_gcd_div_gcd hgcd_pos
    have hnot : ¬((p : ℤ) ∣ a' ∧ (p : ℤ) ∣ b') := by
      rintro ⟨hpa, hpb⟩
      have h := Int.dvd_gcd hpa hpb
      rw [hcop] at h
      exact (Fact.out : p.Prime).not_dvd_one h
    refine ⟨b', -a', ?_, ?_⟩
    · -- Coprimality makes `(b', -a')` primitive.
      rintro ⟨h1, h2⟩
      exact hnot ⟨dvd_neg.mp h2, h1⟩
    · -- The relation itself: `b' • x - a' • y = (b' a' - a' b') • (d • w) = 0`.
      have hxa : x = a' • (d • w) := by rw [← ha, haeq, mul_comm d a', mul_zsmul]
      have hyb : y = b' • (d • w) := by rw [← hb, hbeq, mul_comm d b', mul_zsmul]
      rw [hxa, hyb]
      simp only [← mul_zsmul]
      rw [← add_zsmul]
      have hz : b' * (a' * d) + -a' * (b' * d) = 0 := by ring
      rw [hz, zero_zsmul]

end Work.SSGRoute.PTCore
