import Mathlib
import Submission.Work.SSGRoute.PTCore.RootsOfUnityInstances
import Submission.Work.SSGRoute.PT.H2Transfer
import Submission.Work.SSGRoute.PTembedding.kbdDefs
import Submission.Work.SSGRoute.PTembedding.kummer_decomp
import Submission.Work.SSGRoute.PTembedding.rootsOfUnity_autCongr_equiv
import Submission.Work.SSGRoute.PTembedding.rootsOfUnity_addEquiv_adjoinLocalEquiv
import Submission.Work.SSGRoute.LTDDefs.H2locEquivH2
import Submission.Work.SSGRoute.LTDDefs.DecompAction
import Submission.NK.Mine.AdjoinLocalGalois
import Submission.NK.Mine.exists_isHomeomorph_mulEquiv_sepClosure_of_decompositionGroup_map

namespace Work.SSGRoute.PTCore

noncomputable section

/-- The prime `𝔭` of `k` below a finite place `A` of `Ω`. -/
abbrev h2PrimeUnder (k : Type) [Field k] [NumberField k] {Ω : Type} [Field Ω] [Algebra k Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A) :
    IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k) :=
  Submission.NeukirchUchida.primeOf A hA

/-- `M = 𝔨·Ω ⊆ placeCompletion A`, the subfield generated by `𝔨 = k_𝔭` and `Ω`. -/
abbrev h2AdjoinField (k : Type) [Field k] [NumberField k] (Ω : Type) [Field Ω] [Algebra k Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    [Algebra (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (NK.NeukirchUchida.placeCompletion A)] : Type :=
  ↥(NK.NeukirchUchida.adjoinPlaceCompletion (h2PrimeUnder k A hA) A)

theorem h2loc_equiv_localGal_mup
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A) :
    Nonempty (Work.SSGRoute.H2loc p k Ω K (Additive (rootsOfUnity p K)) (SSGRoute.decomp k A) ≃+
      Work.AbsoluteKummer.H2 (Work.AbsoluteKummer.G (Work.SSGRoute.PTembedding.localFieldOf k A hA))
        (Additive (rootsOfUnity p (AlgebraicClosure (Work.SSGRoute.PTembedding.localFieldOf k A hA))))) := by
  classical
  -- ## the ambient algebra structure `𝔨 → placeCompletion A` and the field `M = 𝔨·Ω`
  letI : Algebra (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (NK.NeukirchUchida.placeCompletion A) :=
    (NK.NeukirchUchida.adicCompletionToPlaceCompletion (h2PrimeUnder k A hA) A
      (Submission.NeukirchUchida.primeOf_spec A hA)).toAlgebra
  have halg : ∀ z : Work.SSGRoute.PTembedding.localFieldOf k A hA,
      (algebraMap (Work.SSGRoute.PTembedding.localFieldOf k A hA)
        (NK.NeukirchUchida.placeCompletion A)) z =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion (h2PrimeUnder k A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA) z := fun _ => rfl
  have hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
        (NK.NeukirchUchida.adicCompletionToPlaceCompletion (h2PrimeUnder k A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA)) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers k (h2PrimeUnder k A hA) :=
    NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers
      (h2PrimeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA)
  haveI hCharZero : CharZero (Work.SSGRoute.PTembedding.localFieldOf k A hA) :=
    Commons.NumberTheory.NumberField.charZero_adicCompletion (h2PrimeUnder k A hA)
  haveI hSep : IsSepClosure (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (h2AdjoinField k Ω A hA) :=
    NK.Mine.isSepClosure_adjoinPlaceCompletion (h2PrimeUnder k A hA) A
      (Submission.NeukirchUchida.primeOf_spec A hA) halg
  haveI hGalM : IsGalois (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (h2AdjoinField k Ω A hA) := hSep.isGalois
  haveI hGalCl : IsGalois (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (AlgebraicClosure (Work.SSGRoute.PTembedding.localFieldOf k A hA)) :=
    IsAlgClosure.isGalois _ _
  -- ## Step 1: the model bridge `H²(D_A, μ_p) ≃ H²_c(D_A, μ_p)`
  have e1 : Work.SSGRoute.H2loc p k Ω K (Additive (rootsOfUnity p K)) (SSGRoute.decomp k A) ≃+
      Work.AbsoluteKummer.H2 ↥(SSGRoute.decomp k A) (Additive (rootsOfUnity p K)) :=
    Work.SSGRoute.LTDDefs.H2locAddEquivH2 p k Ω K (Additive (rootsOfUnity p K))
      (SSGRoute.decomp k A) (Work.SSGRoute.PTembedding.isClosed_decomp' k Ω A)
      (fun h m => SSGRoute.decomp_smul_eq_res K (Additive (rootsOfUnity p K)) A h m)
  -- ## Step 2: the two separable closures of `𝔨` are isomorphic over `𝔨`
  let e2 : AlgebraicClosure (Work.SSGRoute.PTembedding.localFieldOf k A hA) ≃ₐ[
      Work.SSGRoute.PTembedding.localFieldOf k A hA] (h2AdjoinField k Ω A hA) :=
    IsSepClosure.equiv (Work.SSGRoute.PTembedding.localFieldOf k A hA)
      (AlgebraicClosure (Work.SSGRoute.PTembedding.localFieldOf k A hA)) (h2AdjoinField k Ω A hA)
  obtain ⟨Ψ2, hΨ2⟩ := Work.SSGRoute.PTembedding.rootsOfUnity_autCongr_equiv
    (Work.SSGRoute.PTembedding.localFieldOf k A hA) e2 p
  have htr2 := Work.SSGRoute.PT.h2Transfer (Φ := AlgEquiv.autCongr e2)
    (NK.Mine.isHomeomorph_autCongr e2) Ψ2 hΨ2
  -- ## Step 3: the explicit identification `D_A ≃* Gal(M/𝔨)` is compatible with `μ_p`
  obtain ⟨Ψ3, hΨ3⟩ := Work.SSGRoute.PTembedding.rootsOfUnity_addEquiv_adjoinLocalEquiv p k Ω A hA
    halg hW K ζ hζ hζK
  let Φ3 : Gal(h2AdjoinField k Ω A hA / Work.SSGRoute.PTembedding.localFieldOf k A hA) ≃*
      ↥(SSGRoute.decomp k A) :=
    (NK.Mine.adjoinLocalEquiv (h2PrimeUnder k A hA) A
      (Submission.NeukirchUchida.primeOf_spec A hA) halg hW).symm
  have hΦ3 : IsHomeomorph (Φ3 : Gal(h2AdjoinField k Ω A hA /
      Work.SSGRoute.PTembedding.localFieldOf k A hA) → ↥(SSGRoute.decomp k A)) :=
    NK.Mine.isHomeomorph_symm _
      (NK.Mine.isHomeomorph_adjoinLocalEquiv (h2PrimeUnder k A hA) A
        (Submission.NeukirchUchida.primeOf_spec A hA) halg hW)
  have hadj : ∀ g' : Gal(h2AdjoinField k Ω A hA /
      Work.SSGRoute.PTembedding.localFieldOf k A hA),
      NK.Mine.adjoinLocalEquiv (h2PrimeUnder k A hA) A
        (Submission.NeukirchUchida.primeOf_spec A hA) halg hW (Φ3 g') = g' := by
    intro g'
    change Φ3.symm (Φ3 g') = g'
    exact MulEquiv.symm_apply_apply Φ3 g'
  have hΨ3' : ∀ (g' : Gal(h2AdjoinField k Ω A hA /
        Work.SSGRoute.PTembedding.localFieldOf k A hA))
      (m' : Additive (rootsOfUnity p (h2AdjoinField k Ω A hA))),
      Ψ3 (g' • m') = Φ3 g' • Ψ3 m' := by
    intro g' m'
    have h := hΨ3 (Φ3 g') m'
    rwa [hadj g'] at h
  have htr3 := Work.SSGRoute.PT.h2Transfer (Φ := Φ3) hΦ3 Ψ3 hΨ3'
  exact ⟨e1.trans (htr2.trans htr3).symm⟩

end

end Work.SSGRoute.PTCore
