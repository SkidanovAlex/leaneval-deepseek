namespace Work.SSGRoute.PTCore

open CategoryTheory

/-- **The second cohomology of the units of a `p`-adic level is cyclic of order the degree.**

For `K` a number field, `Q` a finite place of `K`, `F = K_Q` the `Q`-adic completion and `L / F` a
finite Galois extension, the group `H²(Gal(L/F), Lˣ)` is cyclic of order `[L : F]`, generated by an
element of additive order `[L : F]`.

The two ingredients are the local fundamental class
`NK.NUV2.LC.exists_addOrderOf_eq_finrank_groupCohomology_two_units_local` (an element of order
`[L : F]`) and the order computation
`NK.NUV2.LC.natCard_groupCohomology_two_units_local_eq_finrank` (`#H² = [L : F]`).  Since the
subgroup generated by such an element has `Nat.card = addOrderOf = [L : F] = Nat.card H²`, it is all
of `H²` by the cardinality count. -/
theorem level_units_H2_cyclic {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K)))
    [FiniteDimensional (Q.adicCompletion K) ↥L] [IsGalois (Q.adicCompletion K) ↥L] :
    ∃ u : groupCohomology (Rep.ofAlgebraAutOnUnits (Q.adicCompletion K) ↥L) 2,
      AddSubgroup.zmultiples u = ⊤ ∧ addOrderOf u = Module.finrank (Q.adicCompletion K) ↥L := by
  obtain ⟨u, hu⟩ :=
    NK.NUV2.LC.exists_addOrderOf_eq_finrank_groupCohomology_two_units_local (K := K) Q
      (F := Q.adicCompletion K) (E := ↥L)
  refine ⟨u, ?_, hu⟩
  -- `#H²(Gal(L/F), Lˣ) = [L : F]`
  have hA : Nat.card (groupCohomology (Rep.ofAlgebraAutOnUnits (Q.adicCompletion K) ↥L) 2)
      = Module.finrank (Q.adicCompletion K) ↥L :=
    NK.NUV2.LC.natCard_groupCohomology_two_units_local_eq_finrank (K := K) Q
      (F := Q.adicCompletion K) (E := ↥L)
  -- the degree is positive, so the subgroup generated by `u` is finite
  have hfinrank_ne : Module.finrank (Q.adicCompletion K) ↥L ≠ 0 :=
    ne_of_gt ((Module.finrank_pos_iff_of_free (Q.adicCompletion K) ↥L).mpr inferInstance)
  -- `Nat.card (zmultiples u) = addOrderOf u = [L : F] = Nat.card H²`
  have hcard : Nat.card ↥(AddSubgroup.zmultiples u)
      = Nat.card (groupCohomology (Rep.ofAlgebraAutOnUnits (Q.adicCompletion K) ↥L) 2) := by
    rw [Nat.card_zmultiples, hu, hA]
  have hfin : Finite ↥(AddSubgroup.zmultiples u) :=
    Nat.finite_of_card_ne_zero (by rw [hcard, hA]; exact hfinrank_ne)
  exact AddSubgroup.eq_top_of_card_eq (AddSubgroup.zmultiples u) hcard

end Work.SSGRoute.PTCore
