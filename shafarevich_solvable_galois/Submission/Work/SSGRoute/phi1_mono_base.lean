# E5 `phi1_mono_pgroup` — dévissage: `φ¹` is injective when `Gal(K/k)` is a `p`-group

**Statement.** `μ_p ⊆ k`, `G` is a `p`-group, and `M` is finite `p`-torsion. Then `PhiOneVanishes x`
implies `x = 0` for `x ∈ Ext¹_G(M, C_K)`.

**Route.** Induction on `|M|`. For `M ≠ 0` a `p`-group has a fixed vector, which gives
`0 → 𝔽_p →i M →π M₂ → 0`.
1. **Case `i^* x ≠ 0` in `Ext¹(𝔽_p, C)`.** By E3 there is `h` with `x ∪ i_*h = i^*x ∪ h ≠ 0`.
2. **Case `i^* x = 0`.** The contravariant `Ext` exact sequence (Mathlib `contravariant_sequence_exact₂`)
   gives `x = π^* y` with `y ∈ Ext¹(M₂, C)`.
3. **`φ¹(y)` factors through `δ`.** `φ¹(y)` kills `π_* H¹(M) = ker(δ : H¹(M₂) → H²(𝔽_p))` at every
   level. So `φ¹(y) = λ ∘ δ` for a compatible family `λ` on `δ(H¹(M₂)) ⊆ H²(k, 𝔽_p)`.
4. **Extend and realise `λ`.** Extend `λ` to `H²(k,𝔽_p)`; everything is an 𝔽_p-space. Work on the
   colimit over levels, using that inflation on `H²(C)` is injective (Commons
   `H2_inflation_injective_of_subsingleton_H1` plus NK H1All). E4 gives `c` with `φ⁰(c) = λ`.
5. **Conclude.** `y − δ' c` has `φ¹ = 0` by compatibility of Yoneda products with connecting maps
   (`comp_extClass`, `Ext.comp_assoc`, one sign). The induction hypothesis for `M₂` gives
   `y = δ' c`, hence `x = π^* δ' c = 0`.

**Size.** 1–1.5k. **Risk:** medium, from the colimit bookkeeping in step 4.

**Imports.** `Submission.Work.SSGRoute.PTDefs`.
-/

namespace Work.SSGRoute

open SSGRoute.PTExt CategoryTheory

/-! ## The two dévissage inputs -/

/-! The coefficient ring `Coeff = ULift ℤ` carries the generic instance `ULift.module`, which
shadows the honest `Module Coeff M` structure `M.hV2` of a general `M : Rep Coeff G` and makes
`Rep.ofHom`-based morphisms into `M` ill-elaborated. We disable that instance in this section and
re-provide the (legitimate) `Coeff`-module structure on `ZMod p` explicitly. -/
section ZModCoeff

attribute [-instance] ULift.module

local instance zmodModuleCoeff (n : ℕ) : Module Coeff (ZMod n) := ULift.module

/-- **The trivial submodule generated by a non-zero fixed vector.** For `b ≠ 0` a fixed vector
of the `G`-module `M` with `p • b = 0`, the `ℤ`-linear map `n ↦ n • b` factors through `ZMod p` and
gives a morphism `Rep.trivial Coeff G (ZMod p) ⟶ M` sending `1 ↦ b`; it is injective because
`addOrderOf b = p`.

This is proved in a section where the generic instance `ULift.module` is switched off, since it
shadows `M.hV2` (the honest `Module Coeff M` structure) and makes the `Rep.ofHom`-literal
ill-elaborated. -/
theorem exists_fixed_vector_morphism (p : ℕ) [Fact p.Prime] {G : Type} [Group G] (M : Rep.{0} Coeff G)
    (b : M) (hb : ∀ g : G, M.ρ g b = b) (hb0 : b ≠ 0) (hM : ∀ m : M, p • m = 0) :
    ∃ (i : Rep.trivial Coeff G (ZMod p) ⟶ M), Function.Injective i ∧ i 1 = b := by
  have hpb : (p : ℤ) • b = 0 := by
    rw [Nat.cast_smul_eq_nsmul ℤ p b]; exact hM b
  let f₀ : ℤ →ₗ[ℤ] M := LinearMap.toSpanSingleton ℤ M b
  have hf₀p : f₀ (p : ℤ) = 0 := by rw [LinearMap.toSpanSingleton_apply]; exact hpb
  have hf₀p' : f₀.toAddMonoidHom (p : ℤ) = 0 := by simpa using hf₀p
  let φ : ZMod p →+ M := ZMod.lift p ⟨f₀.toAddMonoidHom, hf₀p'⟩
  have hφ_int : ∀ n : ℤ, (φ : ZMod p → M) ((n : ℤ) : ZMod p) = n • b := by
    intro n
    show (ZMod.lift p ⟨f₀.toAddMonoidHom, hf₀p'⟩) ((n : ℤ) : ZMod p) = n • b
    rw [ZMod.lift_coe]
    exact LinearMap.toSpanSingleton_apply ℤ M b n
  have hφ_val : ∀ x : ZMod p, φ x = (x.val : ℤ) • b := by
    intro x
    conv_lhs => rw [← ZMod.natCast_zmod_val x]
    rw [show (((x.val : ℕ)) : ZMod p) = (((x.val : ℕ) : ℤ) : ZMod p) from by norm_num]
    exact hφ_int (x.val : ℤ)
  let i : Rep.trivial Coeff G (ZMod p) ⟶ M :=
    Rep.ofHom
      { toFun := fun x => φ x
        map_add' := fun x y => φ.map_add x y
        map_smul' := fun n x => by
          obtain ⟨z⟩ := n
          simp only [RingHom.id_apply]
          rw [show (⟨z⟩ : Coeff) = ((z : ℤ) : Coeff) from rfl]
          rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
          exact AddMonoidHom.map_zsmul φ z x
        isIntertwining' := fun g => by
          apply LinearMap.ext
          intro x
          simp only [LinearMap.comp_apply, Representation.trivial_apply]
          change φ x = M.ρ g (φ x)
          rw [hφ_val x]
          rw [show M.ρ g ((x.val : ℤ) • b) = (x.val : ℤ) • (M.ρ g) b from
            map_zsmul (M.ρ g) (x.val) b, hb g] }
  refine ⟨i, ?_, ?_⟩
  · intro x y hxy
    have h1 : φ x = φ y := hxy
    rw [hφ_val x, hφ_val y] at h1
    have h2 : ((x.val : ℤ) - (y.val : ℤ)) • b = 0 := by
      rw [sub_zsmul, h1]; simp
    have h3 : (addOrderOf b : ℤ) ∣ ((x.val : ℤ) - (y.val : ℤ)) :=
      (addOrderOf_dvd_iff_zsmul_eq_zero).mpr h2
    have hbord : addOrderOf b = p := by
      have h1 : addOrderOf b ∣ p := addOrderOf_dvd_iff_nsmul_eq_zero.mpr (hM b)
      rcases (Nat.dvd_prime (Fact.out (p := p.Prime))).mp h1 with h | h
      · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) hb0
      · exact h
    rw [hbord] at h3
    have h4 : (((x.val : ℤ) - (y.val : ℤ) : ℤ) : ZMod p) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      exact_mod_cast h3
    haveI : NeZero p := ⟨(Fact.out (p := p.Prime)).ne_zero⟩
    have h5 : ((x.val : ℤ) : ZMod p) = ((y.val : ℤ) : ZMod p) := by
      have : ((x.val : ℤ) : ZMod p) - ((y.val : ℤ) : ZMod p) = 0 := by
        rw [← Int.cast_sub]; exact h4
      exact sub_eq_zero.mp this
    have h6 : (x.val : ZMod p) = (y.val : ZMod p) := by simpa using h5
    rw [← ZMod.natCast_zmod_val x, ← ZMod.natCast_zmod_val y]
    exact h6
  · dsimp only [i]
    rw [Rep.ofHom_apply]
    simpa using hφ_int 1

/-- **E5-step I (fixed vectors).** Let `G` be a finite `p`-group and `M ≠ 0` a finite `p`-torsion
`G`-module. Then there is a short exact sequence `0 → 𝔽_p → M → M₂ → 0` with `𝔽_p` the trivial
module and `M₂ = M/𝔽_p` strictly smaller; the sequence is presented by its two maps so that the
endpoints are definitionally the trivial module and `M`.

(This is the "a `p`-group has a non-zero fixed vector" input of the dévissage: for `M ≠ 0` the
orbit-counting congruence `|M| ≡ |M^G| (mod p)` together with `p ∣ |M|` gives `M^G ≠ 0`.) -/
theorem exists_trivial_sub_shortExact (p : ℕ) [Fact p.Prime] {G : Type} [Group G] [Finite G]
    (hG : IsPGroup p G) (M : Rep.{0} Coeff G) [Finite M] (hM : ∀ m : M, p • m = 0)
    (hne : Nontrivial M) :
    ∃ (M₂ : Rep.{0} Coeff G) (i : Rep.trivial Coeff G (ZMod p) ⟶ M) (π : M ⟶ M₂)
      (h : i ≫ π = 0), ((ShortComplex.mk i π h).ShortExact) ∧
      Finite M₂ ∧ (∀ m : M₂, p • m = 0) := by
  classical
  -- the `G`-action on `M` comes from the representation
  letI : MulAction G M :=
    { smul := fun g m => M.ρ g m
      one_smul := fun m => by show M.ρ 1 m = m; rw [M.ρ.map_one]; rfl
      mul_smul := fun g h m => by show M.ρ (g * h) m = M.ρ g (M.ρ h m); rw [M.ρ.map_mul]; rfl }
  -- `p ∣ |M|`
  have hpM : p ∣ Nat.card M := by
    obtain ⟨m, hm⟩ := exists_ne (0 : M)
    have h1 : addOrderOf m ∣ p := addOrderOf_dvd_iff_nsmul_eq_zero.mpr (hM m)
    have h2 : addOrderOf m ≠ 1 := fun h => hm (AddMonoid.addOrderOf_eq_one_iff.mp h)
    have hp : addOrderOf m = p := by
      rcases (Nat.dvd_prime (Fact.out (p := p.Prime))).mp h1 with h | h
      · exact absurd h h2
      · exact h
    refine ⟨(AddSubgroup.zmultiples m).index, ?_⟩
    rw [← AddSubgroup.card_mul_index (AddSubgroup.zmultiples m), Nat.card_zmultiples m, hp]
  -- a non-zero fixed vector and the trivial submodule it spans
  have h0fix : (0 : M) ∈ MulAction.fixedPoints G M := by
    rw [MulAction.mem_fixedPoints]; intro g; show M.ρ g 0 = 0; simp
  obtain ⟨b, hbfix, hbne⟩ :=
    hG.exists_fixed_point_of_prime_dvd_card_of_fixed_point M hpM (a := (0 : M)) h0fix
  obtain ⟨i, hi_inj, _hi_one⟩ :=
    exists_fixed_vector_morphism p M b ((MulAction.mem_fixedPoints.mp hbfix)) (fun h => hbne h.symm) hM
  refine ⟨Limits.cokernel i, i, Limits.cokernel.π i, Limits.cokernel.condition i, ?_, ?_, ?_⟩
  · exact ShortComplex.ShortExact.mk' (ShortComplex.exact_cokernel i)
      ((Rep.mono_iff_injective i).mpr hi_inj) inferInstance
  · have hsurj : Function.Surjective (Rep.Hom.hom (Limits.cokernel.π i)) :=
      (Rep.epi_iff_surjective _).mp inferInstance
    exact Finite.of_surjective _ hsurj
  · intro m
    obtain ⟨y, rfl⟩ := (Rep.epi_iff_surjective (Limits.cokernel.π i)).mp inferInstance m
    change (p : ℕ) • (Rep.Hom.hom (Limits.cokernel.π i)).toLinearMap y = 0
    have h1 : (p : ℕ) • (Rep.Hom.hom (Limits.cokernel.π i)).toLinearMap y
        = (Rep.Hom.hom (Limits.cokernel.π i)).toLinearMap ((p : ℕ) • y) :=
      (map_nsmul (Rep.Hom.hom (Limits.cokernel.π i)).toLinearMap.toAddMonoidHom p y).symm
    rw [h1, hM y, map_zero]

end ZModCoeff

/-! ## The `Ext`-algebra of the dévissage step

The induction step of `phi1_mono_pgroup` (case `i^*x = 0`) is, in the `Ext`-core notation,

* **Data.** a short exact sequence `S : 0 → S.X₁ --f--> S.X₂ --g--> S.X₃ → 0` with
  `S.X₃ = coker S.f`, a class `y : Ext¹_G(S.X₃, C_K)`, and the hypothesis `hy` that the pairing
  `h ↦ h ∪ y` vanishes on the kernel of the connecting map `δ_L : H¹(G_L,S.X₃) → H²(G_L,S.X₁)`
  (`j ↦ j.comp S.extClass`) at every level `L ⊇ K`.
* **Goal.** `g^*(y) = (mk₀ S.g).comp y = 0`.

The *algebraic* half of this is contained in the two lemmas below.

* `phiAt_extClass_comp` is the Yoneda computation `h ∪ (S.extClass.comp c) = δ_L h ∪ c`:
  the pairing of the "connecting class" of a coefficient map `c : S.X₁ ⟶ C_K` with `h` equals the
  pairing of the coefficient class `mk₀ c` with the connecting class `δ_L h`.  It is pure
  associativity of `Abelian.Ext.comp` (Mathlib `Ext.mapExactFunctor_comp`,
  `Ext.mapExactFunctor_mk₀`, `Ext.mk₀_comp_mk₀`) and it carries no sign.
* `phi_one_step_of_realization` then finishes the step from a *realization* hypothesis `hc`: if some
  `c : S.X₁ ⟶ C_K` satisfies `hc`, i.e. `phiAt (mk₀ c) (h.comp (extRes _ S.extClass)) = phiAt y h`
  for all `h` and all levels `L`, then `g^*(y) = y - S.extClass.comp (mk₀ c)` has vanishing pairing
  (by `phiAt_extClass_comp`), so the induction hypothesis kills it, and the goal follows from
  Mathlib's `ShortComplex.ShortExact.comp_extClass_assoc`.

What is *not* proved here is `hc` itself: producing the coefficient map `c` from `y` and `hy` is the
class-formation duality input (the design's steps 3–4, `E4`).  See the discussion at
`phi_one_step_of_annihilates_ker_delta` below. -/

section ExtAlgebra

variable {k K L : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Field L]
  [NumberField L] [Algebra k K] [Algebra K L] [Algebra k L] [IsScalarTower k K L]
  [FiniteDimensional k K] [IsGalois k K]

/-- **`phiAt x ·` is additive in the class `x`**, as a bundled additive map. -/
noncomputable def phiAtHom {M : Rep.{0} Coeff (K ≃ₐ[k] K)} {r s : ℕ}
    (h : extH (Rep.res (galRes k K L) M) s) :
    Abelian.Ext M (classesK k K) r →+ extH (classesK k L) (s + r) where
  toFun x := phiAt (k := k) (K := K) (L := L) x h
  map_zero' := by
    simp only [phiAt, levelPair, extRes, Abelian.Ext.mapExactFunctor_zero, Abelian.Ext.zero_comp,
      Abelian.Ext.comp_zero]
  map_add' x y := by
    simp only [phiAt, levelPair, extRes, Abelian.Ext.mapExactFunctor_add, Abelian.Ext.add_comp,
      Abelian.Ext.comp_add]

@[simp] lemma phiAtHom_apply {M : Rep.{0} Coeff (K ≃ₐ[k] K)} {r s : ℕ}
    (h : extH (Rep.res (galRes k K L) M) s) (x : Abelian.Ext M (classesK k K) r) :
    phiAtHom (k := k) (K := K) (L := L) h x = phiAt (k := k) (K := K) (L := L) x h := rfl

/-- **The Yoneda computation `h ∪ (S.extClass.comp c) = δ_L h ∪ c`**: pairing the connecting class
of a coefficient map `c : S.X₁ ⟶ C_K` with `h` gives the same value as pairing the coefficient class
`mk₀ c` with the connecting class `h.comp (extRes S.extClass)`. -/
theorem phiAt_extClass_comp {S : ShortComplex (Rep.{0} Coeff (K ≃ₐ[k] K))} (hS : S.ShortExact)
    (c : S.X₁ ⟶ classesK k K) (h : extH (Rep.res (galRes k K L) S.X₃) 1) :
    phiAt (k := k) (K := K) (L := L) (hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) h
      = phiAt (k := k) (K := K) (L := L) (Abelian.Ext.mk₀ c)
          (h.comp (extRes (galRes k K L) hS.extClass) (show 1 + 1 = 2 by norm_num)) := by
  simp only [phiAt, levelPair, extRes, Abelian.Ext.mapExactFunctor_comp,
    Abelian.Ext.mapExactFunctor_mk₀, Abelian.Ext.mk₀_comp_mk₀,
    Abelian.Ext.comp_assoc_of_second_deg_zero, Abelian.Ext.comp_assoc_of_third_deg_zero]

/-- **E5-step II, the algebraic half.**  Given the *realization* hypothesis `hc` (some coefficient
map `c` pairs with the connecting classes of `S` as `y` does) and the induction hypothesis `IH` for
the sub-quotient `S.X₃`, the class `g^*(y) = (mk₀ S.g).comp y` vanishes.

The realization `hc` is the duality input; this lemma isolates the part of the dévissage that is pure
`Ext` algebra. -/
theorem phi_one_step_of_realization
    {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
    [FiniteDimensional k K] [IsGalois k K]
    (p : ℕ) [Fact p.Prime] (ζ : k) (hζ : IsPrimitiveRoot ζ p)
    (S : ShortComplex (Rep.{0} Coeff (K ≃ₐ[k] K))) (hS : S.ShortExact)
    [Finite S.X₂] [Finite S.X₃] (hp₃ : ∀ m : S.X₃, p • m = 0)
    (hcard : Nat.card S.X₃ < Nat.card S.X₂)
    (y : Abelian.Ext S.X₃ (classesK k K) 1)
    (c : S.X₁ ⟶ classesK k K)
    (hc : ∀ (L : Type) [Field L] [NumberField L] [Algebra k L] [Algebra K L]
        [IsScalarTower k K L] [FiniteDimensional k L] [IsGalois k L]
        (h : extH (Rep.res (galRes k K L) S.X₃) 1),
        phiAt (k := k) (K := K) (L := L) (Abelian.Ext.mk₀ c)
            (h.comp (extRes (galRes k K L) hS.extClass) (show 1 + 1 = 2 by norm_num))
          = phiAt (k := k) (K := K) (L := L) y h)
    (IH : ∀ (N : Rep.{0} Coeff (K ≃ₐ[k] K)) [Finite N], Nat.card N < Nat.card S.X₂ →
        (∀ m : N, p • m = 0) →
        ∀ (x : Abelian.Ext N (classesK k K) 1), PhiOneVanishes k K x → x = 0) :
    (Abelian.Ext.mk₀ S.g).comp y (zero_add 1) = 0 := by
  classical
  have hvan : PhiOneVanishes k K (y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) := by
    intro L _ _ _ _ _ _ _ h
    rw [show phiAt (k := k) (K := K) (L := L)
          (y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) h
        = phiAt (k := k) (K := K) (L := L) y h
          - phiAt (k := k) (K := K) (L := L)
              (hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) h from
      (phiAtHom (k := k) (K := K) (L := L) h).map_sub y _]
    rw [phiAt_extClass_comp hS c h, hc L h, sub_self]
  have hzero : y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1) = 0 :=
    IH S.X₃ hcard hp₃ _ hvan
  have hy : y = hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1) := sub_eq_zero.mp hzero
  rw [hy]
  exact hS.comp_extClass_assoc (Abelian.Ext.mk₀ c) (add_zero 1)

end ExtAlgebra


/-- **E5-step IIΩ (the Ω-level algebraic half).**  The `Ω`-level version of
`phi_one_step_of_realization`, stated with the *sharp* injectivity hypothesis `IH` for the quotient
`S.X₃` (namely: every `PhiOneVanishesIn Ω`-class on `S.X₃` is zero).  This is exactly the shape in
which node E5s (`Work.SSGRoute.phi1_mono_step_in`) consumes the pairing.

`phiAtHom` (additivity of the pairing in the class variable) and `phiAt_extClass_comp` (the Yoneda
computation `h ∪ (extClass ∪ c) = (h ∪ extClass) ∪ c`) are all that is used here; the realization
`hc` and the injectivity `IH` are the two inputs that the dévissage supplies. -/
theorem phi_one_step_of_realization_in
    {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
    [FiniteDimensional k K] [IsGalois k K]
    (Ω : Type) [Field Ω] [Algebra K Ω] [Algebra k Ω] [IsScalarTower k K Ω]
    (S : ShortComplex (Rep.{0} Coeff (K ≃ₐ[k] K))) (hS : S.ShortExact)
    (y : Abelian.Ext S.X₃ (classesK k K) 1)
    (c : S.X₁ ⟶ classesK k K)
    (hc : ∀ (L : IntermediateField K Ω) [NumberField L] [FiniteDimensional k L] [IsGalois k L]
        (h : extH (Rep.res (galRes k K L) S.X₃) 1),
        phiAt (k := k) (K := K) (L := L) (Abelian.Ext.mk₀ c)
            (h.comp (extRes (galRes k K L) hS.extClass) (show 1 + 1 = 2 by norm_num))
          = phiAt (k := k) (K := K) (L := L) y h)
    (IH : ∀ x : Abelian.Ext S.X₃ (classesK k K) 1, PhiOneVanishesIn Ω x → x = 0) :
    (Abelian.Ext.mk₀ S.g).comp y (zero_add 1) = 0 := by
  classical
  have hvan : PhiOneVanishesIn Ω (y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) := by
    intro L _ _ _ h
    rw [show phiAt (k := k) (K := K) (L := L)
          (y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) h
        = phiAt (k := k) (K := K) (L := L) y h
          - phiAt (k := k) (K := K) (L := L)
              (hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1)) h from
      (phiAtHom (k := k) (K := K) (L := L) h).map_sub y _]
    rw [phiAt_extClass_comp hS c h, hc L h, sub_self]
  have hzero : y - hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1) = 0 :=
    IH _ hvan
  have hy : y = hS.extClass.comp (Abelian.Ext.mk₀ c) (add_zero 1) := sub_eq_zero.mp hzero
  rw [hy]
  exact hS.comp_extClass_assoc (Abelian.Ext.mk₀ c) (add_zero 1)

/-! ## The old (type-indexed) target as a corollary of the `Ω`-indexed one

`PhiOneVanishes` quantifies over *all types* `L`; `PhiOneVanishesIn Ω` over the finite Galois levels
`K ≤ L ≤ Ω` inside a fixed `Ω`.  The former is stronger, so it implies the latter by instantiating
the type-quantifier at `↥L`.  Consequently the target `phi1_mono_pgroup` (which is stated with the
old, type-indexed `PhiOneVanishes`) is a direct corollary of the node
`Work.SSGRoute.phi1_mono_pgroup_in` (`Ω := AlgebraicClosure K`), exactly as in `DESIGN_FIX.md` §1. -/

/-- **The type-indexed form implies the `Ω`-indexed form**: instantiate the quantifier over all
types at `↥L`, `L : IntermediateField K Ω`. -/
theorem phiOneVanishes_to_In {k K Ω : Type} [Field k] [NumberField k] [Field K] [NumberField K]
    [Algebra k K] [FiniteDimensional k K] [IsGalois k K] [Field Ω] [Algebra K Ω] [Algebra k Ω]
    [IsScalarTower k K Ω] {M : Rep Coeff (K ≃ₐ[k] K)}
    (x : Abelian.Ext M (classesK k K) 1) (hx : PhiOneVanishes k K x) :
    PhiOneVanishesIn Ω x := by
  intro L _ _ _ h
  exact hx ↥L h

end Work.SSGRoute
