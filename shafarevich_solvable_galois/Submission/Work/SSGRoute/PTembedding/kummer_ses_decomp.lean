/-!
# The Kummer sequence `1 → μ_p → Ωˣ → Ωˣ → 1` over a decomposition group

For a finite place `A` of `Ω` over the number field `k` and a finite Galois extension `K/k` whose
`p`-th roots of unity are generated by a primitive root `ζ ∈ K`, the sequence

  `1 → μ_p(K) →^{muIota} Ωˣ →^{powPi} Ωˣ → 1`

is a short exact sequence of discrete `D_A`-modules (`D_A = decomp k A`).
-/

open SSGRoute
open Work.SSGRoute

namespace Work.SSGRoute.PTembedding.MupCard

noncomputable section
set_option linter.style.haveILetI false

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω]

/-! ## Comparison of the two unit-actions on `Ωˣ` -/

theorem algEquivUnitsMapOfField_eq_algEquivUnitsMapΩ (σ : Ω ≃ₐ[k] Ω) (u : Ωˣ) :
    PT.algEquivUnitsMapOfField k Ω σ u = algEquivUnitsMapΩ k Ω σ u :=
  Units.ext (by rw [PT.algEquivUnitsMapOfField_coe, algEquivUnitsMapΩ_coe])

/-! ## The action of a subgroup of `G_k` on `μ_n(Ω)` -/

/-- The restriction of the `G_k`-action on `μ_n(Ω)` to a subgroup `H ≤ G_k`. -/
noncomputable instance instDistribMulActionSubgroupAddRootsOfUnity (n : ℕ)
    (H : Subgroup (Ω ≃ₐ[k] Ω)) : DistribMulAction ↥H (Additive (rootsOfUnity n Ω)) where
  smul h a := (h : Ω ≃ₐ[k] Ω) • a
  one_smul a := by
    show ((1 : ↥H) : Ω ≃ₐ[k] Ω) • a = a
    rw [show ((1 : ↥H) : Ω ≃ₐ[k] Ω) = 1 from rfl, one_smul]
  mul_smul h1 h2 a := by
    show ((h1 * h2 : ↥H) : Ω ≃ₐ[k] Ω) • a
      = (h1 : Ω ≃ₐ[k] Ω) • ((h2 : Ω ≃ₐ[k] Ω) • a)
    rw [show ((h1 * h2 : ↥H) : Ω ≃ₐ[k] Ω)
      = (h1 : Ω ≃ₐ[k] Ω) * (h2 : Ω ≃ₐ[k] Ω) from rfl, mul_smul]
  smul_zero h := smul_zero _
  smul_add h a b := smul_add _ _ _

@[simp] theorem subgroupAddRootsOfUnity_smul (n : ℕ) (H : Subgroup (Ω ≃ₐ[k] Ω)) (h : ↥H)
    (a : Additive (rootsOfUnity n Ω)) :
    h • a = (h : Ω ≃ₐ[k] Ω) • a := rfl

/-- A root of unity is fixed by `σ` iff its underlying unit is. -/
theorem smul_muAdd_eq_iff (n : ℕ) (σ : Ω ≃ₐ[k] Ω) (a : Additive (rootsOfUnity n Ω)) :
    σ • a = a ↔ algEquivUnitsMapΩ k Ω σ ((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ)
      = ((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ) := by
  constructor
  · intro h
    have h2 := congrArg
      (fun z : Additive (rootsOfUnity n Ω) => ((Additive.toMul z : rootsOfUnity n Ω) : Ωˣ)) h
    have h3 : MupKummer.muMapOfField k Ω n σ (Additive.toMul a) = Additive.toMul a := by
      rw [show Additive.toMul (σ • a)
          = MupKummer.muMapOfField k Ω n σ (Additive.toMul a) from
          toMul_smul_rootsOfUnity (k := k) (n := n) σ a] at h2
      exact Subtype.ext h2
    rw [← algEquivUnitsMapOfField_eq_algEquivUnitsMapΩ (k := k) (Ω := Ω) σ
      ((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ)]
    apply Units.ext
    rw [PT.algEquivUnitsMapOfField_coe]
    exact congrArg (fun w : rootsOfUnity n Ω => ((w : Ωˣ) : Ω)) h3
  · intro h
    have h2 : MupKummer.muMapOfField k Ω n σ (Additive.toMul a) = Additive.toMul a := by
      apply Subtype.ext
      apply Units.ext
      rw [MupKummer.muMapOfField_coe, PT.algEquivUnitsMapOfField_coe]
      exact congrArg (fun w : Ωˣ => (w : Ω)) h
    show Additive.ofMul (MupKummer.muMapOfField k Ω n σ (Additive.toMul a)) = a
    rw [h2]
    exact ofMul_toMul a

/-- The `↥H`-module `μ_n(Ω)` is discrete for the Krull topology. -/
theorem isDiscreteModule_decomp_addRootsOfUnity (n : ℕ) (A : ValuationSubring Ω) :
    Work.AbsoluteKummer.IsDiscreteModule ↥(SSGRoute.decomp k A)
      (Additive (rootsOfUnity n Ω)) := by
  intro a
  show IsOpen (MulAction.stabilizer ↥(SSGRoute.decomp k A) a : Set ↥(SSGRoute.decomp k A))
  have hset : (MulAction.stabilizer ↥(SSGRoute.decomp k A) a : Set ↥(SSGRoute.decomp k A))
      = Subtype.val ⁻¹' ((MulAction.stabilizer (Ω ≃ₐ[k] Ω)
          (((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ) : Ω)) : Set (Ω ≃ₐ[k] Ω)) := by
    ext g
    show (g : Ω ≃ₐ[k] Ω) • a = a
      ↔ (g : Ω ≃ₐ[k] Ω) (((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ) : Ω)
        = (((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ) : Ω)
    have hiff := smul_muAdd_eq_iff (k := k) (Ω := Ω) n (g : Ω ≃ₐ[k] Ω) a
    rw [hiff]
    constructor
    · intro h
      exact congrArg (fun w : Ωˣ => (w : Ω)) h
    · intro h
      exact Units.ext h
  rw [hset]
  exact (stabilizer_isOpen_of_isIntegral
    (((Additive.toMul a : rootsOfUnity n Ω) : Ωˣ) : Ω)).preimage continuous_subtype_val

/-- The `↥H`-module `Ωˣ` is discrete for the Krull topology. -/
theorem isDiscreteModule_decomp_addUnits (A : ValuationSubring Ω) :
    Work.AbsoluteKummer.IsDiscreteModule ↥(SSGRoute.decomp k A) (Additive (Units Ω)) := by
  intro a
  show IsOpen (MulAction.stabilizer ↥(SSGRoute.decomp k A) a : Set ↥(SSGRoute.decomp k A))
  have hset : (MulAction.stabilizer ↥(SSGRoute.decomp k A) a : Set ↥(SSGRoute.decomp k A))
      = Subtype.val ⁻¹' ((MulAction.stabilizer (Ω ≃ₐ[k] Ω) a) : Set (Ω ≃ₐ[k] Ω)) := by
    ext g
    show (g : Ω ≃ₐ[k] Ω) • a = a ↔ (g : Ω ≃ₐ[k] Ω) • a = a
    exact Iff.rfl
  have hstab : (MulAction.stabilizer (Ω ≃ₐ[k] Ω) a : Set (Ω ≃ₐ[k] Ω))
      = MulAction.stabilizer (Ω ≃ₐ[k] Ω) (Additive.ofMul (Additive.toMul a)) := by
    rw [ofMul_toMul a]
  have hstab2 : (MulAction.stabilizer (Ω ≃ₐ[k] Ω) (Additive.ofMul (Additive.toMul a)) :
        Set (Ω ≃ₐ[k] Ω))
      = MulAction.stabilizer (Ω ≃ₐ[k] Ω) (((Additive.toMul a : Ωˣ) : Ω)) :=
    stabilizer_addUnits_ofMulΩ k Ω (Additive.toMul a)
  rw [hset, hstab, hstab2]
  exact (stabilizer_isOpen_of_isIntegral
    (((Additive.toMul a : Ωˣ) : Ω))).preimage continuous_subtype_val

/-! ## The Kummer inclusion `μ_p(Ω) ↪ Ωˣ` and the `p`-th power map -/

/-- **The Kummer inclusion** `μ_p(Ω) ↪ Ωˣ`. -/
noncomputable def muIotaΩ : Additive (rootsOfUnity p Ω) →+ Additive (Units Ω) where
  toFun a := Additive.ofMul ((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ)
  map_zero' := by
    apply Additive.toMul.injective
    show Additive.toMul (Additive.ofMul (((Additive.toMul (0 : Additive (rootsOfUnity p Ω))
      : rootsOfUnity p Ω) : Ωˣ))) = Additive.toMul (0 : Additive (Units Ω))
    simp
  map_add' a b := by
    apply Additive.toMul.injective
    show Additive.toMul (Additive.ofMul (((Additive.toMul (a + b) : rootsOfUnity p Ω) : Ωˣ)))
      = Additive.toMul (Additive.ofMul (((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ))
        + Additive.ofMul (((Additive.toMul b : rootsOfUnity p Ω) : Ωˣ)))
    simp [Subgroup.coe_mul]

@[simp] theorem muIotaΩ_apply (a : Additive (rootsOfUnity p Ω)) :
    muIotaΩ (p := p) (Ω := Ω) a
      = Additive.ofMul ((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ) := rfl

theorem muIotaΩ_injective : Function.Injective (muIotaΩ (p := p) (Ω := Ω)) := by
  intro a b h
  have h' : ((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ)
      = ((Additive.toMul b : rootsOfUnity p Ω) : Ωˣ) := by
    simpa using congrArg Additive.toMul h
  exact Additive.toMul.injective (Subtype.ext h')

theorem muIotaΩ_equivariant (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    Work.GroupCohomology.IsEquivariant ↥H (muIotaΩ (p := p) (Ω := Ω)) := by
  intro g a
  apply Additive.toMul.injective
  have h1 : Additive.toMul (muIotaΩ (p := p) (Ω := Ω) (g • a))
      = algEquivUnitsMapΩ k Ω (g : Ω ≃ₐ[k] Ω)
          ((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ) := by
    rw [muIotaΩ_apply, toMul_ofMul]
    have hs : Additive.toMul (g • a)
        = MupKummer.muMapOfField k Ω p (g : Ω ≃ₐ[k] Ω) (Additive.toMul a) :=
      toMul_smul_rootsOfUnity (k := k) (n := p) (g : Ω ≃ₐ[k] Ω) a
    rw [hs, MupKummer.muMapOfField_coe]
    exact algEquivUnitsMapOfField_eq_algEquivUnitsMapΩ (k := k) (Ω := Ω) (g : Ω ≃ₐ[k] Ω) _
  have h2 : Additive.toMul (g • muIotaΩ (p := p) (Ω := Ω) a)
      = algEquivUnitsMapΩ k Ω (g : Ω ≃ₐ[k] Ω)
          ((Additive.toMul a : rootsOfUnity p Ω) : Ωˣ) := by
    rw [muIotaΩ_apply]
    exact addUnits_smul_toMulΩ (k := k) (Ω := Ω) (g : Ω ≃ₐ[k] Ω) _
  exact h1.trans h2.symm

theorem powPi_surjective [IsAlgClosed Ω] :
    Function.Surjective (powPi (p := p) (Ω := Ω)) := by
  intro b
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq ((Additive.toMul b : Units Ω) : Ω)
    (Fact.out : p.Prime).pos
  have hz0 : z ≠ 0 := by
    intro h
    have h1 : ((Additive.toMul b : Units Ω) : Ω) = 0 := by
      rw [← hz, h, zero_pow (Fact.out : p.Prime).ne_zero]
    exact (Additive.toMul b).ne_zero h1
  refine ⟨Additive.ofMul (Units.mk0 z hz0), ?_⟩
  apply Additive.toMul.injective
  rw [powPi_apply, toMul_ofMul, toMul_ofMul]
  exact Units.ext (by rw [Units.val_pow_eq_pow_val, Units.val_mk0]; exact hz)

/-- `powPi b = 0` iff `b` is a `p`-th root of unity. -/
theorem powPi_eq_zero_iff (b : Additive (Units Ω)) :
    powPi (p := p) (Ω := Ω) b = 0 ↔ Additive.toMul b ∈ rootsOfUnity p Ω := by
  rw [← toMul_eq_one, powPi_eq_nsmul, toMul_nsmul]
  exact (mem_rootsOfUnity p (Additive.toMul b)).symm

/-! ## The Kummer sequence over `D_A` -/

variable (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]

/-- `μ_p(K)` embedded in `μ_p(Ω)`. -/
theorem muIota_eq_muIotaΩ_comp {ζ : Ω} (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) (x : MuAdd p K) :
    muIotaΩ (p := p) (Ω := Ω) (muInclAddEquiv (p := p) (K := K) hζ hζK x)
      = muIota (p := p) (K := K) x := by
  apply Additive.toMul.injective
  simp only [muIotaΩ_apply, muIota_apply, toMul_ofMul, toMul_muInclAddEquiv, muInclHom_coe]

theorem muIota_equivariant {ζ : Ω} (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (A : ValuationSubring Ω) :
    Work.GroupCohomology.IsEquivariant ↥(SSGRoute.decomp k A) (muIota (p := p) (K := K)) := by
  intro g m
  have h := muIotaΩ_equivariant (p := p) (Ω := Ω) (SSGRoute.decomp k A) g
    (muInclAddEquiv (p := p) (K := K) hζ hζK m)
  have hL : (g : ↥(SSGRoute.decomp k A)) • (muInclAddEquiv (p := p) (K := K) hζ hζK m)
      = muInclAddEquiv (p := p) (K := K) hζ hζK (g • m) :=
    (muInclAddEquiv_smul (p := p) (K := K) hζ hζK (g : Ω ≃ₐ[k] Ω) m).symm
  rw [hL] at h
  rw [muIota_eq_muIotaΩ_comp (K := K) hζ hζK (g • m),
    muIota_eq_muIotaΩ_comp (K := K) hζ hζK m] at h
  exact h

theorem muIota_injective : Function.Injective (muIota (p := p) (K := K)) := by
  intro a b h
  have h' : Units.map (algebraMap ↥K Ω).toMonoidHom
      ((Additive.toMul a : rootsOfUnity p K) : (↥K)ˣ)
      = Units.map (algebraMap ↥K Ω).toMonoidHom
        ((Additive.toMul b : rootsOfUnity p K) : (↥K)ˣ) := by
    simpa using congrArg Additive.toMul h
  have hinj : Function.Injective ((algebraMap ↥K Ω).toMonoidHom : ↥K → Ω) :=
    fun x y hxy => Subtype.ext hxy
  have h2 := Units.map_injective (f := (algebraMap ↥K Ω).toMonoidHom) hinj h'
  exact Additive.toMul.injective (Subtype.ext h2)

/-- **The kernel of `powPi` is `μ_p(K)`**: every `p`-th root of unity of `Ω` lies in `K`. -/
theorem range_muIota_eq_ker_powPi {ζ : Ω} (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) :
    (muIota (p := p) (K := K)).range = (powPi (p := p) (Ω := Ω)).ker := by
  ext b
  constructor
  · rintro ⟨a, rfl⟩
    rw [AddMonoidHom.mem_ker, powPi_eq_zero_iff, muIota_apply, toMul_ofMul, mem_rootsOfUnity]
    have hu : ((Additive.toMul a : rootsOfUnity p K) : (↥K)ˣ) ^ p = 1 :=
      (mem_rootsOfUnity p ((Additive.toMul a : rootsOfUnity p K) : (↥K)ˣ)).mp
        (Additive.toMul a).2
    rw [← map_pow (Units.map (algebraMap ↥K Ω).toMonoidHom)
      ((Additive.toMul a : rootsOfUnity p K) : (↥K)ˣ) p, hu, map_one]
  · intro hb
    rw [AddMonoidHom.mem_ker] at hb
    have hpow : (Additive.toMul b : Units Ω) ^ p = 1 := by
      have h := congrArg Additive.toMul hb
      simpa [powPi_eq_nsmul] using h
    have hcoe : (((Additive.toMul b : Units Ω)) : Ω) ^ p = 1 := by
      rw [← Units.val_pow_eq_pow_val, hpow]
      rfl
    have hmem : ((Additive.toMul b : Units Ω) : Ω) ∈ K := mem_K_of_pow_eq_one hζ hζK hcoe
    have hne : (⟨((Additive.toMul b : Units Ω) : Ω), hmem⟩ : ↥K) ≠ 0 := by
      intro h
      exact (Additive.toMul b).ne_zero (by simpa using congrArg Subtype.val h)
    have hroot : Units.mk0 (⟨((Additive.toMul b : Units Ω) : Ω), hmem⟩ : ↥K) hne
        ∈ rootsOfUnity p K := by
      rw [mem_rootsOfUnity]
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_mk0]
      exact Subtype.ext hcoe
    refine ⟨Additive.ofMul
      (⟨Units.mk0 (⟨((Additive.toMul b : Units Ω) : Ω), hmem⟩ : ↥K) hne, hroot⟩ :
        rootsOfUnity p K), ?_⟩
    apply Additive.toMul.injective
    simp only [muIota_apply, toMul_ofMul]
    apply Units.ext
    rw [Units.coe_map, Units.val_mk0]
    rfl

theorem isDiscreteModule_decomp_muAdd {ζ : Ω} (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (A : ValuationSubring Ω) :
    Work.AbsoluteKummer.IsDiscreteModule ↥(SSGRoute.decomp k A) (MuAdd p K) := by
  intro m
  have hset : (MulAction.stabilizer ↥(SSGRoute.decomp k A) m : Set ↥(SSGRoute.decomp k A))
      = (MulAction.stabilizer ↥(SSGRoute.decomp k A)
          (muInclAddEquiv (p := p) (K := K) hζ hζK m) : Set ↥(SSGRoute.decomp k A)) := by
    ext g
    show (g : ↥(SSGRoute.decomp k A)) • m = m
      ↔ (g : ↥(SSGRoute.decomp k A))
        • (muInclAddEquiv (p := p) (K := K) hζ hζK m)
        = muInclAddEquiv (p := p) (K := K) hζ hζK m
    have h2 : muInclAddEquiv (p := p) (K := K) hζ hζK (g • m)
        = g • muInclAddEquiv (p := p) (K := K) hζ hζK m :=
      muInclAddEquiv_smul (p := p) (K := K) hζ hζK (g : Ω ≃ₐ[k] Ω) m
    rw [← h2]
    exact ⟨fun hg => by rw [hg],
      fun hg => (muInclAddEquiv (p := p) (K := K) hζ hζK).injective hg⟩
  rw [hset]
  exact isDiscreteModule_decomp_addRootsOfUnity p A
    (muInclAddEquiv (p := p) (K := K) hζ hζK m)

/-- **The Kummer sequence over the decomposition group** of a finite place `A`. -/
theorem exists_kummerSES_decomp (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A) :
    ∃ S : Work.AbsoluteKummer.ShortExactSeq ↥(SSGRoute.decomp k A)
        (MuAdd p K) (Additive (Units Ω)) (Additive (Units Ω)),
      (∀ x : MuAdd p K, S.iota x = muIota (p := p) (K := K) x) ∧
      (∀ u : Additive (Units Ω), S.pi u = powPi (p := p) (Ω := Ω) u) := by
  haveI : IsAlgClosed Ω := IsAlgClosure.isAlgClosed k
  refine ⟨{ iota := muIota (p := p) (K := K)
            pi := powPi (p := p) (Ω := Ω)
            iota_equivariant := muIota_equivariant (K := K) hζ hζK A
            pi_equivariant := powPi_equivariant (p := p) (Ω := Ω) (SSGRoute.decomp k A)
            iota_injective := muIota_injective (K := K)
            pi_surjective := powPi_surjective (p := p) (Ω := Ω)
            range_iota_eq_ker_pi := range_muIota_eq_ker_powPi (K := K) hζ hζK
            isDiscreteM := isDiscreteModule_decomp_muAdd (K := K) hζ hζK A
            isDiscreteN := isDiscreteModule_decomp_addUnits (k := k) (Ω := Ω) A
            isDiscreteP := isDiscreteModule_decomp_addUnits (k := k) (Ω := Ω) A }, ?_, ?_⟩
  · intro x
    rfl
  · intro u
    rfl

end

end Work.SSGRoute.PTembedding.MupCard
