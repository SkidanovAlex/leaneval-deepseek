/-!
# The local/global identification is compatible with the `p`-th roots of unity

Let `k` be a number field, `Ω` an algebraic closure of `k`, `A` a finite place of `Ω` over `k`,
`𝔭` the prime of `k` below `A`, `𝔨 = k_𝔭` the `𝔭`-adic completion of `k` and
`M = 𝔨·Ω ⊆ placeCompletion A` the subfield generated by (the image of) `𝔨` and (that of) `Ω`.
Then `M` is a separable closure of `𝔨`, and the decomposition group `D_A` of `A` is the group of
`𝔨`-algebra automorphisms of `M` (`NK.Mine.adjoinLocalEquiv`).

The main result of this file is `rootsOfUnity_addEquiv_adjoinLocalEquiv`: for a finite Galois
extension `K/k` inside `Ω` containing a primitive `p`-th root of unity `ζ`, the groups of `p`-th
roots of unity `μ_p(M)` and `μ_p(K)` are isomorphic, compatibly with the action of `D_A` (acting
on `μ_p(M)` through `adjoinLocalEquiv` and on `μ_p(K)` through the restriction `res k K`).

The proof runs through the explicit ring hom `coInAdjoinHom : Ω →+* M` (the `coInAdjoin` of
`NK.NeukirchUchida` packaged as a ring hom), which is injective, and the induced map
`muAddAdjoinMap : μ_p(K) → μ_p(M)`.  Injectivity is formal; surjectivity uses the fact that
`coInAdjoin 𝔭 A ζ` is a primitive `p`-th root of unity in `M` (the injectivity of `coInAdjoinHom`
transports the primitivity), so every `p`-th root of unity in `M` is a power of it, hence in the
image of the (restriction of) `Ω`-part of `M` — and `ζ` generates `μ_p(K)`.  The compatibility
with the actions is the naturality `decompositionToAdjoin σ (coInAdjoin y) = coInAdjoin (σ y)`.
-/

open Work.SSGRoute

namespace Work.SSGRoute.PTembedding

noncomputable section

open scoped Pointwise

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

/-! ## The map on roots of unity induced by `coInAdjoin` -/

/-- **The image of `Ω` in `M = 𝔨·Ω` as a ring hom.**  This is the map underlying
`NK.NeukirchUchida.coInAdjoin`. -/
def coInAdjoinHom {k : Type} [Field k] [NumberField k] {Ω : Type} [Field Ω] [Algebra k Ω]
    [IsSepClosure k Ω]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] :
    Ω →+* ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) where
  toFun := NK.NeukirchUchida.coInAdjoin 𝔭 A
  map_one' := NK.NeukirchUchida.coInAdjoin_one 𝔭 A
  map_mul' := NK.NeukirchUchida.coInAdjoin_mul 𝔭 A
  map_zero' := NK.NeukirchUchida.coInAdjoin_zero 𝔭 A
  map_add' := NK.NeukirchUchida.coInAdjoin_add 𝔭 A

@[simp] theorem coInAdjoinHom_apply {k : Type} [Field k] [NumberField k] {Ω : Type} [Field Ω]
    [Algebra k Ω] [IsSepClosure k Ω]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] (y : Ω) :
    coInAdjoinHom 𝔭 A y = NK.NeukirchUchida.coInAdjoin 𝔭 A y := rfl

/-- `coInAdjoinHom` is injective: its values are the places of `Ω` inside the completion. -/
theorem coInAdjoinHom_injective {k : Type} [Field k] [NumberField k] {Ω : Type} [Field Ω]
    [Algebra k Ω] [IsSepClosure k Ω]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] :
    Function.Injective (coInAdjoinHom 𝔭 A) := by
  intro x y hxy
  refine RingHom.injective (NK.NeukirchUchida.placeCompletionCoe A) ?_
  exact congrArg (fun z : ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) =>
    (z : NK.NeukirchUchida.placeCompletion A)) hxy

/-- A ring homomorphism between commutative monoids restricts to an injective map on the `n`-th
roots of unity. -/
theorem restrictRootsOfUnity_injective {R S F : Type*} [CommMonoid R] [CommMonoid S]
    [FunLike F R S] [MonoidHomClass F R S] (f : F) (hf : Function.Injective f) (n : ℕ) :
    Function.Injective (restrictRootsOfUnity f n) := by
  intro u v huv
  have h1 := Subtype.ext_iff.mp huv
  have h2 : f ((u : Rˣ) : R) = f ((v : Rˣ) : R) := by
    have hc := congrArg (fun z : Sˣ => (z : S)) h1
    simpa using hc
  exact Subtype.ext (Units.ext (hf h2))

/-- **The map `μ_p(K) → μ_p(𝔨·Ω)`** induced by the inclusion `K ⊆ Ω` followed by `coInAdjoin`. -/
def muAddAdjoinMap (p : ℕ) [Fact p.Prime] {k : Type} [Field k] [NumberField k] {Ω : Type}
    [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] :
    MupCard.MuAdd p K →+ MupCard.MuAdd p (NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) :=
  MonoidHom.toAdditive ((restrictRootsOfUnity (coInAdjoinHom 𝔭 A) p).comp
    (restrictRootsOfUnity (algebraMap ↥K Ω) p))

@[simp] theorem muAddAdjoinMap_apply (p : ℕ) [Fact p.Prime] {k : Type} [Field k] [NumberField k]
    {Ω : Type} [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] (x : MupCard.MuAdd p K) :
    Additive.toMul (muAddAdjoinMap p K 𝔭 A x)
      = (restrictRootsOfUnity (coInAdjoinHom 𝔭 A) p)
        ((restrictRootsOfUnity (algebraMap ↥K Ω) p) (Additive.toMul x)) := rfl

/-- The underlying element of `M` of `muAddAdjoinMap p K 𝔭 A x`. -/
theorem muAddAdjoinMap_val (p : ℕ) [Fact p.Prime] {k : Type} [Field k] [NumberField k]
    {Ω : Type} [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] (x : MupCard.MuAdd p K) :
    (((Additive.toMul (muAddAdjoinMap p K 𝔭 A x) :
        rootsOfUnity p ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A)) :
        (↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))ˣ) :
        ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))
      = coInAdjoinHom 𝔭 A
          (algebraMap ↥K Ω (((Additive.toMul x : rootsOfUnity p ↥K) : (↥K)ˣ) : ↥K)) := by
  rw [show Additive.toMul (muAddAdjoinMap p K 𝔭 A x) =
      (restrictRootsOfUnity (coInAdjoinHom 𝔭 A) p)
        ((restrictRootsOfUnity (algebraMap ↥K Ω) p) (Additive.toMul x)) from rfl,
    restrictRootsOfUnity_coe_apply, restrictRootsOfUnity_coe_apply]

theorem muAddAdjoinMap_injective (p : ℕ) [Fact p.Prime] {k : Type} [Field k] [NumberField k]
    {Ω : Type} [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)] :
    Function.Injective (muAddAdjoinMap p K 𝔭 A) := by
  have h1 : Function.Injective (restrictRootsOfUnity (coInAdjoinHom 𝔭 A) p) :=
    restrictRootsOfUnity_injective (coInAdjoinHom 𝔭 A) (coInAdjoinHom_injective 𝔭 A) p
  have h2 : Function.Injective (restrictRootsOfUnity (algebraMap ↥K Ω) p) :=
    restrictRootsOfUnity_injective (algebraMap ↥K Ω) (RingHom.injective (algebraMap ↥K Ω)) p
  have h3 : Function.Injective (fun z : rootsOfUnity p ↥K =>
      (restrictRootsOfUnity (coInAdjoinHom 𝔭 A) p)
        ((restrictRootsOfUnity (algebraMap ↥K Ω) p) z)) := h1.comp h2
  intro x y hxy
  exact Additive.toMul.injective (h3 (congrArg Additive.toMul hxy))

/-- **Surjectivity**: every `p`-th root of unity of `M = 𝔨·Ω` is the image of one of `K`, because
`ζ` is primitive in `Ω` (hence, by injectivity of `coInAdjoinHom`, in `M`) and `ζ` generates
`μ_p(K)`. -/
theorem muAddAdjoinMap_surjective (p : ℕ) [Fact p.Prime] {k : Type} [Field k] [NumberField k]
    {Ω : Type} [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (A : ValuationSubring Ω)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) :
    Function.Surjective (muAddAdjoinMap p K 𝔭 A) := by
  intro x
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hζM : IsPrimitiveRoot (coInAdjoinHom 𝔭 A ζ) p :=
    hζ.map_of_injective (f := coInAdjoinHom 𝔭 A) (coInAdjoinHom_injective 𝔭 A)
  let u : rootsOfUnity p ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) := Additive.toMul x
  have hu : ((u : (↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))ˣ) :
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A)) ^ p = 1 :=
    (mem_rootsOfUnity' p (u : (↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))ˣ)).mp u.2
  obtain ⟨i, -, hi⟩ := hζM.eq_pow_of_pow_eq_one hu
  have hw0 : (⟨ζ ^ i, pow_mem hζK i⟩ : ↥K) ≠ 0 := by
    intro h
    have h2 : (ζ ^ i : Ω) = 0 := congrArg Subtype.val h
    exact pow_ne_zero i (hζ.ne_zero (Fact.out : p.Prime).ne_zero) h2
  let v : (↥K)ˣ := Units.mk0 ⟨ζ ^ i, pow_mem hζK i⟩ hw0
  have hv : v ^ p = 1 := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, Units.val_one]
    show (⟨ζ ^ i, pow_mem hζK i⟩ : ↥K) ^ p = 1
    refine Subtype.ext ?_
    simp only [IntermediateField.coe_pow, IntermediateField.coe_one]
    rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  refine ⟨Additive.ofMul ⟨v, (mem_rootsOfUnity p v).mpr hv⟩, ?_⟩
  apply Additive.toMul.injective
  apply Subtype.ext
  apply Units.ext
  rw [muAddAdjoinMap_val]
  show coInAdjoinHom 𝔭 A (ζ ^ i) =
    ((u : (↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))ˣ) :
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A))
  rw [map_pow]
  exact hi

/-! ## Compatibility with the Galois actions -/

theorem toMul_smul_ofField {F E : Type} [Field F] [Field E] [Algebra F E]
    {K : IntermediateField F E} {p : ℕ} [Fact p.Prime] (g : ↥K ≃ₐ[F] ↥K)
    (x : MupCard.MuAdd p K) :
    Additive.toMul (g • x) = MupKummer.muMapOfField F ↥K p g (Additive.toMul x) := rfl

theorem muMapOfField_val {F E : Type} [Field F] [Field E] [Algebra F E] {p : ℕ} [Fact p.Prime]
    (g : E ≃ₐ[F] E) (v : rootsOfUnity p E) :
    (((MupKummer.muMapOfField F E p g v : rootsOfUnity p E) : Eˣ) : E) =
      g ((v : Eˣ) : E) := by
  rw [MupKummer.muMapOfField_coe, Work.SSGRoute.PT.algEquivUnitsMapOfField_coe]

theorem toMul_smul_decomp {k : Type} [Field k] {Ω : Type} [Field Ω] [Algebra k Ω]
    {K : IntermediateField k Ω} [IsGalois k K] {p : ℕ} [Fact p.Prime]
    (A : ValuationSubring Ω) (σ : ↥(SSGRoute.decomp k A)) (x : MupCard.MuAdd p K) :
    Additive.toMul (σ • x) =
      MupKummer.muMapOfField k ↥K p (SSGRoute.res k K (σ : Ω ≃ₐ[k] Ω)) (Additive.toMul x) := rfl

theorem res_apply_eq {k : Type} [Field k] {Ω : Type} [Field Ω] [Algebra k Ω]
    {K : IntermediateField k Ω} [Normal k K] (σ : Ω ≃ₐ[k] Ω) (z : ↥K) :
    algebraMap ↥K Ω ((SSGRoute.res k K σ) z) = σ (algebraMap ↥K Ω z) :=
  AlgEquiv.restrictNormalHom_apply K σ z

variable (p : ℕ) [Fact p.Prime] (k : Type) [Field k] [NumberField k] (Ω : Type) [Field Ω]
  [Algebra k Ω] [IsAlgClosure k Ω]
  (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
  (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
  (h𝔭 : A.comap (algebraMap k Ω) = IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k 𝔭)
  [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
    (NK.NeukirchUchida.placeCompletion A)]
  (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭,
    (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭)
      (NK.NeukirchUchida.placeCompletion A)) z =
      NK.NeukirchUchida.adicCompletionToPlaceCompletion 𝔭 A h𝔭 z)
  (hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
      (NK.NeukirchUchida.adicCompletionToPlaceCompletion 𝔭 A h𝔭) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers k 𝔭)

/-- **`muAddAdjoinMap` intertwines the action of `D_A` with the action of `Gal(M/𝔨)`** under the
identification `adjoinLocalEquiv`: this is `decompositionToAdjoin_coInAdjoin`. -/
theorem muAddAdjoinMap_smul (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (σ : ↥(SSGRoute.decomp k A)) (x : MupCard.MuAdd p K) :
    muAddAdjoinMap p K 𝔭 A (σ • x) =
      (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • muAddAdjoinMap p K 𝔭 A x := by
  let D : ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion k 𝔭]
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) :=
    NK.NeukirchUchida.decompositionToAdjoin 𝔭 A h𝔭 halg σ
  have hD : (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) = D := rfl
  have hDco : ∀ y : Ω, D (coInAdjoinHom 𝔭 A y) =
      coInAdjoinHom 𝔭 A ((σ : Ω ≃ₐ[k] Ω) y) := fun y =>
    NK.NeukirchUchida.decompositionToAdjoin_coInAdjoin 𝔭 A h𝔭 halg σ y
  rw [hD]
  apply Additive.toMul.injective
  apply Subtype.ext
  apply Units.ext
  rw [muAddAdjoinMap_val, toMul_smul_decomp, toMul_smul_ofField, muMapOfField_val,
    muMapOfField_val, muAddAdjoinMap_val, res_apply_eq, hDco]

/-- The statement of `rootsOfUnity_addEquiv_adjoinLocalEquiv` for an arbitrary prime `𝔭` of `k`
below `A` (the statement itself only ever uses `𝔭 = primeOf A hA`). -/
theorem rootsOfUnity_addEquiv_adjoinLocalEquiv_aux (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) :
    ∃ Ψ : MupCard.MuAdd p (NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) ≃+ MupCard.MuAdd p K,
      ∀ (σ : ↥(SSGRoute.decomp k A))
        (x : MupCard.MuAdd p (NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A)),
        Ψ ((NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • x) = σ • Ψ x := by
  have hb : Function.Bijective (muAddAdjoinMap p K 𝔭 A) :=
    ⟨muAddAdjoinMap_injective p K 𝔭 A,
      muAddAdjoinMap_surjective p K 𝔭 A ζ hζ hζK⟩
  let e : MupCard.MuAdd p K ≃+ MupCard.MuAdd p
      (NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A) :=
    AddEquiv.ofBijective (muAddAdjoinMap p K 𝔭 A) hb
  refine ⟨e.symm, ?_⟩
  intro σ x
  have hkey : e (σ • e.symm x) = (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • x := by
    have h1 : muAddAdjoinMap p K 𝔭 A (σ • e.symm x) =
        (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • muAddAdjoinMap p K 𝔭 A (e.symm x) :=
      muAddAdjoinMap_smul p k Ω A 𝔭 h𝔭 halg hW K σ (e.symm x)
    have h2 : muAddAdjoinMap p K 𝔭 A (e.symm x) = x := AddEquiv.apply_symm_apply e x
    calc e (σ • e.symm x) = muAddAdjoinMap p K 𝔭 A (σ • e.symm x) := rfl
      _ = (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • muAddAdjoinMap p K 𝔭 A (e.symm x) := h1
      _ = (NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • x := by rw [h2]
  calc e.symm ((NK.Mine.adjoinLocalEquiv 𝔭 A h𝔭 halg hW σ) • x)
      = e.symm (e (σ • e.symm x)) := by rw [hkey]
    _ = σ • e.symm x := AddEquiv.symm_apply_apply e (σ • e.symm x)

end

/-- **The explicit local/global identification is compatible with the `p`-th roots of unity.**

Let `k` be a number field, `Ω` an algebraic closure of `k`, `A` a finite place of `Ω` over `k`,
`𝔭` the prime of `k` below `A`, `𝔨 = k_𝔭` the `𝔭`-adic completion of `k` and
`M = 𝔨·Ω ⊆ placeCompletion A` the subfield generated by (the image of) `𝔨` and (that of) `Ω`
(`NK.NeukirchUchida.adjoinPlaceCompletion 𝔭 A`); `M` is a separable closure of `𝔨`.

Let `K` be a finite Galois extension of `k` inside `Ω` containing a primitive `p`-th root of unity
`ζ`.  Then there is an isomorphism `μ_p(M) ≅ μ_p(K)` of the groups of `p`-th roots of unity
compatible with the action of the decomposition group `D_A = decomp k A`: under the explicit
identification `NK.Mine.adjoinLocalEquiv : D_A ≃* Gal(M/𝔨)` (`σ ↦ σ̂|_M`), the action on `μ_p(M)`
(written `Additive (rootsOfUnity p M)`) corresponds to the action on `MupCard.MuAdd p K`, which is
the restriction of the action on `Ω`.

Proof sketch.  `σ̂|_M` is `NK.NeukirchUchida.decompositionToAdjoin`, and by
`NK.NeukirchUchida.decompositionToAdjoin_coInAdjoin`,
`decompositionToAdjoin σ (coInAdjoin y) = coInAdjoin (σ y)` for `y : Ω`.  Hence
`ζ_M := coInAdjoin ζ ∈ M` is a primitive `p`-th root of unity with
`decompositionToAdjoin σ ζ_M = coInAdjoin (σ ζ)`, while the image of `ζ` under the action of `σ`
on `MuAdd p K` is `σ ζ` (this is `AlgEquiv.restrictNormalHom_apply`/`AlgEquiv.smul_def`, since
the `D_A`-action on `MuAdd p K` is through `SSGRoute.res k K`).  Every `p`-th root of unity in a
field of characteristic `≠ p` is a power of any primitive one, so the assignment `ζ_M ^ m ↦ ζ ^ m`
is well defined, is an isomorphism of the cyclic groups of order `p`, and is compatible with the
two actions. -/
theorem rootsOfUnity_addEquiv_adjoinLocalEquiv
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion k
        (Submission.NeukirchUchida.primeOf A hA)) (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion k
        (Submission.NeukirchUchida.primeOf A hA),
      (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion k
          (Submission.NeukirchUchida.primeOf A hA))
        (NK.NeukirchUchida.placeCompletion A)) z =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion
          (Submission.NeukirchUchida.primeOf A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA) z)
    (hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
        (NK.NeukirchUchida.adicCompletionToPlaceCompletion
          (Submission.NeukirchUchida.primeOf A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA)) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers k
        (Submission.NeukirchUchida.primeOf A hA))
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) :
    ∃ Ψ : Additive (rootsOfUnity p (↥(NK.NeukirchUchida.adjoinPlaceCompletion
          (Submission.NeukirchUchida.primeOf A hA) A))) ≃+ MupCard.MuAdd p K,
      ∀ (σ : ↥(SSGRoute.decomp k A))
        (x : Additive (rootsOfUnity p (↥(NK.NeukirchUchida.adjoinPlaceCompletion
          (Submission.NeukirchUchida.primeOf A hA) A)))),
        Ψ ((NK.Mine.adjoinLocalEquiv (Submission.NeukirchUchida.primeOf A hA) A
              (Submission.NeukirchUchida.primeOf_spec A hA) halg hW σ) • x)
          = σ • Ψ x :=
  rootsOfUnity_addEquiv_adjoinLocalEquiv_aux p k Ω A
    (Submission.NeukirchUchida.primeOf A hA) (Submission.NeukirchUchida.primeOf_spec A hA)
    halg hW K ζ hζ hζK

end Work.SSGRoute.PTembedding
