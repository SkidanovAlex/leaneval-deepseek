/-!
# Index-`p` subgroups of a commutative group vs. index-`p` subgroups of `G ⧸ G ^ p`

For a prime `p` and a commutative group `G`, the subgroup `G ^ p` generated by the `p`-th powers
is contained in every subgroup `M` of index `p` (the quotient `G ⧸ M` has order `p`, hence
exponent `p`).  Therefore the lattice isomorphism between the subgroups of `G` lying above
`G ^ p` and the subgroups of `G ⧸ G ^ p` restricts to a bijection between the subgroups of
index `p` on either side, which is the content of

`subgroup_index_p_equiv_addSubgroup`.

This is a component of the count `(p - 1) * #{M ≤ G : [G : M] = p} = #{G ⧸ G ^ p} - 1`
(see `mul_natCard_indexP_subgroups`).
-/

namespace Work.SSGRoute.PTembedding

/-- If `M` is a subgroup of index `p` in a commutative group `G`, with `p` prime, then every
`p`-th power lies in `M`. -/
theorem pow_mem_of_index_eq_prime {G : Type*} [CommGroup G] {p : ℕ} [Fact p.Prime]
    {M : Subgroup G} (hM : M.index = p) (x : G) : x ^ p ∈ M := by
  have hcard : Nat.card (G ⧸ M) = p := by rw [← Subgroup.index_eq_card]; exact hM
  have hdvd : orderOf ((QuotientGroup.mk' M) x) ∣ p := by
    rw [← hcard]; exact orderOf_dvd_natCard _
  have hpow : ((QuotientGroup.mk' M) x) ^ p = 1 := (orderOf_dvd_iff_pow_eq_one).mp hdvd
  have hpow' : (QuotientGroup.mk' M) (x ^ p) = 1 := by
    rw [map_pow, QuotientGroup.mk'_apply]; exact hpow
  exact (QuotientGroup.eq_one_iff (x ^ p)).mp (by simpa [QuotientGroup.mk'_apply] using hpow')

/-- If `M` is a subgroup of index `p` in a commutative group `G`, with `p` prime, then `M`
contains the range of the `p`-th power map. -/
theorem range_powMonoidHom_le_of_index_eq_prime {G : Type*} [CommGroup G] {p : ℕ} [Fact p.Prime]
    {M : Subgroup G} (hM : M.index = p) : (powMonoidHom p : G →* G).range ≤ M := by
  intro y hy
  obtain ⟨x, rfl⟩ := MonoidHom.mem_range.mp hy
  rw [powMonoidHom_apply]
  exact pow_mem_of_index_eq_prime hM x

/-- The subgroups of index `p` of a commutative group `G` correspond to the additive subgroups
of index `p` of `Additive (G ⧸ G ^ p)`. -/
theorem subgroup_index_p_equiv_addSubgroup (p : ℕ) [Fact p.Prime] (G : Type) [CommGroup G] :
    Nonempty ({M : Subgroup G // M.index = p} ≃
      {K : AddSubgroup (Additive (G ⧸ (powMonoidHom p : G →* G).range)) // K.index = p}) := by
  set N : Subgroup G := (powMonoidHom p : G →* G).range with hN
  let q : G →* G ⧸ N := QuotientGroup.mk' N
  have hqsurj : Function.Surjective q := QuotientGroup.mk'_surjective N
  have hqker : q.ker = N := QuotientGroup.ker_mk' N
  have hle : ∀ M : Subgroup G, M.index = p → N ≤ M := by
    intro M hM
    rw [hN]
    exact range_powMonoidHom_le_of_index_eq_prime hM
  refine ⟨{
    toFun := fun M => ⟨Subgroup.toAddSubgroup (M.1.map q), by
      rw [Subgroup.index_toAddSubgroup,
        Subgroup.index_map_eq M.1 hqsurj (hqker.symm ▸ hle M.1 M.2), M.2]⟩
    invFun := fun K => ⟨(Subgroup.toAddSubgroup.symm K.1).comap q, by
      rw [Subgroup.index_comap_of_surjective _ hqsurj,
        ← Subgroup.index_toAddSubgroup (H := Subgroup.toAddSubgroup.symm K.1),
        OrderIso.apply_symm_apply]
      exact K.2⟩
    left_inv := fun M => by
      apply Subtype.ext
      show (Subgroup.toAddSubgroup.symm (Subgroup.toAddSubgroup (M.1.map q))).comap q = M.1
      rw [OrderIso.symm_apply_apply, Subgroup.comap_map_eq_self (hqker.symm ▸ hle M.1 M.2)]
    right_inv := fun K => by
      apply Subtype.ext
      show Subgroup.toAddSubgroup (((Subgroup.toAddSubgroup.symm K.1).comap q).map q) = K.1
      rw [Subgroup.map_comap_eq_self_of_surjective hqsurj (Subgroup.toAddSubgroup.symm K.1),
        OrderIso.apply_symm_apply] }⟩

end Work.SSGRoute.PTembedding
