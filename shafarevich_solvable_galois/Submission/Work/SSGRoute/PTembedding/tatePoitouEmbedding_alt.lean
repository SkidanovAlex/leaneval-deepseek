namespace Work.SSGRoute.PTembedding

open scoped TensorProduct

set_option maxHeartbeats 800000
set_option linter.style.haveILetI false
set_option linter.unusedVariables false

/-- The tensor product of two finite `𝔽_p`-modules is finite. -/
lemma finite_tensor (p : ℕ) [Fact p.Prime] (E T : Type) [AddCommGroup E] [Module (ZMod p) E]
    [Finite E] [AddCommGroup T] [Module (ZMod p) T] [Finite T] :
    Finite (TensorProduct (ZMod p) E T) := by
  haveI : Module.Finite (ZMod p) E := Module.Finite.of_finite
  haveI : Module.Finite (ZMod p) T := Module.Finite.of_finite
  haveI : Module.Finite (ZMod p) (TensorProduct (ZMod p) E T) :=
    Module.Finite.tensorProduct (ZMod p) E T
  have h1 : Nat.card (TensorProduct (ZMod p) E T)
      = Nat.card (ZMod p) ^ Module.finrank (ZMod p) (TensorProduct (ZMod p) E T) :=
    Module.natCard_eq_pow_finrank (K := ZMod p) (V := TensorProduct (ZMod p) E T)
  have h2 : 0 < Nat.card (TensorProduct (ZMod p) E T) := by
    rw [h1]
    exact pow_pos (Nat.pos_of_ne_zero (by
      rw [Nat.card_eq_fintype_card, ZMod.card]
      exact (Fact.out : p.Prime).ne_zero)) _
  exact (Nat.card_pos_iff.mp h2).2

/-- The `𝔽_p`-dual of a finite `𝔽_p`-module is finite. -/
lemma finite_dual (p : ℕ) [Fact p.Prime] (X : Type) [AddCommGroup X] [Module (ZMod p) X]
    [Finite X] : Finite (X →ₗ[ZMod p] ZMod p) := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  haveI : Fintype X := Fintype.ofFinite X
  haveI : Fintype (X → ZMod p) := inferInstance
  exact Finite.of_injective (fun f : X →ₗ[ZMod p] ZMod p => (f : X → ZMod p))
    (fun f g h => LinearMap.ext (congrFun h))

/-- **The `𝔽_p`-dual of a finite `𝔽_p`-module has the same cardinality.**  (Used to deduce
bijectivity from injectivity plus the Euler characteristic `#Ш² = #Ш¹`.) -/
theorem natCard_dual (p : ℕ) [Fact p.Prime] (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [Finite M] : Nat.card (M →ₗ[ZMod p] ZMod p) = Nat.card M := by
  haveI : Module.Free (ZMod p) M := Module.Free.of_divisionRing (ZMod p) M
  haveI : Module.Finite (ZMod p) M := Module.Finite.of_finite
  haveI hfin : Finite (M →ₗ[ZMod p] ZMod p) := finite_dual p M
  haveI : Module.Finite (ZMod p) (M →ₗ[ZMod p] ZMod p) := Module.Finite.of_finite
  rw [Module.natCard_eq_pow_finrank (K := ZMod p) (V := M →ₗ[ZMod p] ZMod p),
    Module.natCard_eq_pow_finrank (K := ZMod p) (V := M)]
  congr 1
  have b := Module.finBasis (ZMod p) M
  rw [Module.finrank_eq_card_basis b.dualBasis, Module.finrank_eq_card_basis b]
  simp

/-- **The assembly of the embedding form of Tate–Poitou duality.**

Given a natural pairing `pair` of the two Tate–Shafarevich groups whose *left* kernel is zero and
the global Euler characteristic `#Ш²(k,E) = #Ш¹(k,E^∨(1))`, the adjoint
`Φ E b := (fun a => pair E a b)` is injective and natural in `E`: this is
`tatePoitouEmbedding_alt` with the two arithmetic inputs of Milne I.4.10(a) (the pairing, and the
order equality of §5) taken as hypotheses. -/
theorem tatePoitouEmbedding_of_pairing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (hTfin : Finite T)
    (hcard : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Nat.card (Sha2 p k Ω K E)
          = Nat.card (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))))
    (pair : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p]
          (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p))
    (hleft : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (pair E))
    (hnat : ∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
        [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
        (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
        [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
        (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
        (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                DualMod p (TensorProduct (ZMod p) E₁ T))
        (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
          f' (g • φ) = g • f' φ)
        (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (a : Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E₂ T)))
        (b : Sha2 p k Ω K E₁),
        pair E₂ a (Sha2Map p k Ω K E₁ E₂ f hf b)
          = pair E₁ (Sha1Map p k Ω K
              (DualMod p (TensorProduct (ZMod p) E₂ T))
              (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf' a) b) :
    ∃ Φ : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
            [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
          Sha2 p k Ω K E →ₗ[ZMod p]
            (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p),
      (∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
          [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (Φ E)) ∧
      (∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
          [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
          (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
          [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
          (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
          (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                  DualMod p (TensorProduct (ZMod p) E₁ T))
          (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
            f' (g • φ) = g • f' φ)
          (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
            f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
          (b : Sha2 p k Ω K E₁),
          Φ E₂ (Sha2Map p k Ω K E₁ E₂ f hf b)
            = (Φ E₁ b).comp
                (Sha1Map p k Ω K
                  (DualMod p (TensorProduct (ZMod p) E₂ T))
                  (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf')) := by
  classical
  refine ⟨fun E => LinearMap.flip (pair E), ?_, ?_⟩
  · -- injectivity: the adjoint of the pairing, using the Euler characteristic
    intro E _ _ _ _ _ b₁ b₂ h12
    have hker : LinearMap.flip (pair E) (b₁ - b₂) = 0 := by rw [map_sub, h12, sub_self]
    have hzero : b₁ - b₂ = 0 := by
      by_contra hne
      -- a nonzero class is separated from zero by a functional
      obtain ⟨β, hβ⟩ := Module.Projective.exists_dual_ne_zero (ZMod p) hne
      -- `Ш¹(k,E^∨(1))` is finite (Chebotarev/Bauer Hasse descent)
      haveI hfET : Finite (TensorProduct (ZMod p) E T) := finite_tensor p E T
      haveI hfD : Finite (DualMod p (TensorProduct (ZMod p) E T)) :=
        finite_dual p (TensorProduct (ZMod p) E T)
      haveI hf1 : Finite (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))) :=
        finite_sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))
      -- hence `Ш²(k,E)` is finite, by the Euler characteristic
      haveI hf2 : Finite (Sha2 p k Ω K E) := by
        have hpos : 0 < Nat.card (Sha2 p k Ω K E) := by
          rw [hcard E]
          exact Nat.card_pos_iff.mpr ⟨⟨0⟩, hf1⟩
        exact (Nat.card_pos_iff.mp hpos).2
      haveI hf2d : Finite (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p) := finite_dual p (Sha2 p k Ω K E)
      -- the pairing's adjoint is surjective: injective between finite spaces of equal size
      have hle : Nat.card (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p)
          ≤ Nat.card (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))) := by
        rw [natCard_dual p (Sha2 p k Ω K E), hcard E]
      have hsurj : Function.Surjective (pair E) :=
        ((hleft E).bijective_of_nat_card_le hle).surjective
      obtain ⟨a, ha⟩ := hsurj β
      have h1 : (pair E a) (b₁ - b₂) = 0 := by
        have h2 : (LinearMap.flip (pair E) (b₁ - b₂)) a = 0 := by rw [hker]; rfl
        simpa [LinearMap.flip_apply] using h2
      exact hβ (by rw [← ha]; exact h1)
    exact sub_eq_zero.mp hzero
  · -- naturality of the adjoint, from the naturality of the pairing
    intro E₁ _ _ _ _ _ E₂ _ _ _ _ _ f hf f' hf' hff' b
    refine LinearMap.ext (fun a => ?_)
    exact hnat E₁ E₂ f hf f' hf' hff' a b

/-! ## The sharpest reduction of this node's target

The target asks for an *injective and natural* family `Φ`.  The naturality of `Φ` is carried by a
*natural pairing* (the canonical Poitou–Tate pairing, node `poitouTate_pairing`); the *injectivity*
of `Φ` needs a second, independent input: the *cardinality* identity `#Ш² = #Ш¹`.  The theorem below
shows that, in the presence of the natural pairing, this second input can be weakened to the
*non-natural* existence of an injection `Ш²(k,E) ↪ (Ш¹(k,E^∨(1)))^∨` of `𝔽_p`-vector spaces: the
cardinality identity then follows by the squeeze

  `#Ш¹ ≤ #(Ш²)^∨ = #Ш² ≤ #(Ш¹)^∨ = #Ш¹`

(`#(·)^∨ = #(·)` by `natCard_dual`).  This is the sharpest reduction of the target that the
workspace's linear algebra alone can produce: it puts *all* of the naturality on the pairing and
*none* on the injectivity. -/

/-- A one-dimensional `𝔽_p`-module is finite. -/
private lemma finite_of_finrank_eq_one_alt (p : ℕ) [Fact p.Prime] (T : Type) [AddCommGroup T]
    [Module (ZMod p) T] (h : Module.finrank (ZMod p) T = 1) : Finite T := by
  haveI : Module.Free (ZMod p) T := Module.Free.of_divisionRing (ZMod p) T
  haveI : Module.Finite (ZMod p) T := Module.finite_of_finrank_pos (by rw [h]; norm_num)
  have hfr : Module.finrank (ZMod p) T = Module.finrank (ZMod p) (ZMod p) := by
    rw [h, Module.finrank_self]
  exact Finite.of_injective
    (LinearEquiv.ofFinrankEq T (ZMod p) hfr : T ≃ₗ[ZMod p] ZMod p) (LinearEquiv.injective _)

/-- `Finite T` for a cyclotomic dual `T` of `μ_p`. -/
private lemma finite_of_isCyclotomicDual_alt (p : ℕ) [Fact p.Prime] {Γ G T Ω : Type} [Group Γ]
    [Group G] [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction G T] [Field Ω]
    [MulSemiringAction Γ Ω] (act : Γ →* G) (ζ : Ω)
    (hT : SSGRoute.IsCyclotomicDual p (T := T) act ζ) : Finite T :=
  finite_of_finrank_eq_one_alt p T hT.1

/-- **The sharpest reduction of `tatePoitouEmbedding_alt`.**  From

* a **natural** pairing `pair` of `Ш¹(k,E^∨(1))` with `Ш²(k,E)` which is injective in its first
  variable (the content of the node `poitouTate_pairing`), and
* the **existence**, for every finite `E`, of *some* injective `𝔽_p`-linear map
  `Ш²(k,E) ↪ (Ш¹(k,E^∨(1)) →ₗ 𝔽_p)` (no naturality at all: this is the non-natural "right half" of
  Milne I.4.10(a)),

the target follows: `#Ш²(k,E) = #Ш¹(k,E^∨(1))` is obtained by the cardinality squeeze, and then
`tatePoitouEmbedding_of_pairing` produces the witness `Φ`.

Note the asymmetry: the *injectivity* half need not be natural, because the naturality of the
target's `Φ` is inherited from the naturality of the pairing. -/
theorem tatePoitouEmbedding_of_pairing_and_rightHalf
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (pair : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p]
          (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p))
    (hleft : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (pair E))
    (hnat : ∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
        [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
        (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
        [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
        (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
        (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                DualMod p (TensorProduct (ZMod p) E₁ T))
        (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
          f' (g • φ) = g • f' φ)
        (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (a : Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E₂ T)))
        (b : Sha2 p k Ω K E₁),
        pair E₂ a (Sha2Map p k Ω K E₁ E₂ f hf b)
          = pair E₁ (Sha1Map p k Ω K
              (DualMod p (TensorProduct (ZMod p) E₂ T))
              (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf' a) b)
    (hright : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        ∃ Φ : Sha2 p k Ω K E →ₗ[ZMod p]
          (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p),
        Function.Injective Φ) :
    ∃ Φ : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
            [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
          Sha2 p k Ω K E →ₗ[ZMod p]
            (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p),
      (∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
          [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (Φ E)) ∧
      (∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
          [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
          (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
          [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
          (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
          (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                  DualMod p (TensorProduct (ZMod p) E₁ T))
          (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
            f' (g • φ) = g • f' φ)
          (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
            f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
          (b : Sha2 p k Ω K E₁),
          Φ E₂ (Sha2Map p k Ω K E₁ E₂ f hf b)
            = (Φ E₁ b).comp
                (Sha1Map p k Ω K
                  (DualMod p (TensorProduct (ZMod p) E₂ T))
                  (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf')) := by
  have hTfin : Finite T := finite_of_isCyclotomicDual_alt p (SSGRoute.res k K) ζ hT
  have hcard : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
      [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
      Nat.card (Sha2 p k Ω K E)
        = Nat.card (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))) := by
    intro E _ _ _ _ _
    haveI hfT : Finite (TensorProduct (ZMod p) E T) := finite_tensor p E T
    haveI hfD : Finite (DualMod p (TensorProduct (ZMod p) E T)) :=
      finite_dual p (TensorProduct (ZMod p) E T)
    haveI hf1 : Finite (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))) :=
      finite_sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))
    haveI hf1d : Finite
        (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p) :=
      finite_dual p (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)))
    obtain ⟨Φ₀, hΦ₀⟩ := hright E
    haveI hf2 : Finite (Sha2 p k Ω K E) := Finite.of_injective Φ₀ hΦ₀
    haveI hf2d : Finite (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p) := finite_dual p (Sha2 p k Ω K E)
    have hle1 : Nat.card (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)))
        ≤ Nat.card (Sha2 p k Ω K E) := by
      have h := Nat.card_le_card_of_injective (pair E) (hleft E)
      rwa [natCard_dual p (Sha2 p k Ω K E)] at h
    have hle2 : Nat.card (Sha2 p k Ω K E)
        ≤ Nat.card (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T))) := by
      have h := Nat.card_le_card_of_injective Φ₀ hΦ₀
      rwa [natCard_dual p (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)))] at h
    exact le_antisymm hle2 hle1
  exact tatePoitouEmbedding_of_pairing p k Ω K ζ hζ hζK T hT hTfin hcard pair hleft hnat

/-- **The sharpest reduction of `tatePoitouEmbedding_alt`: a single non-degeneracy statement.**

If the canonical Poitou–Tate pairing `pair` — natural in the coefficient module `E` — *separates the
classes of `Ш²`* (i.e. its second component `b ↦ (a ↦ pair E a b)` is injective), then the target
follows with **no** further input: the witness is the flip `Φ E = (pair E).flip`, which is injective
by hypothesis and natural by the naturality of `pair`.

In particular **no counting identity / Euler characteristic is needed** in this form: the cardinality
input of `tatePoitouEmbedding_of_pairing` (and with it the node `sha_card_euler`) is not used at all
here.  The whole content of the target is thus the (right) non-degeneracy of the canonical pairing —
a statement about the *canonical* object, not about cardinalities. -/
theorem tatePoitouEmbedding_of_rightNondegenerate
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (pair : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p]
          (Sha2 p k Ω K E →ₗ[ZMod p] ZMod p))
    (hright : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
        [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
        (b : Sha2 p k Ω K E),
        (∀ a : Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)), pair E a b = 0) → b = 0)
    (hnat : ∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
        [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
        (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
        [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
        (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
        (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                DualMod p (TensorProduct (ZMod p) E₁ T))
        (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
          f' (g • φ) = g • f' φ)
        (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (a : Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E₂ T)))
        (b : Sha2 p k Ω K E₁),
        pair E₂ a (Sha2Map p k Ω K E₁ E₂ f hf b)
          = pair E₁ (Sha1Map p k Ω K
              (DualMod p (TensorProduct (ZMod p) E₂ T))
              (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf' a) b) :
    ∃ Φ : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
            [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
          Sha2 p k Ω K E →ₗ[ZMod p]
            (Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p),
      (∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
          [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (Φ E)) ∧
      (∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁]
          [DistribMulAction (K ≃ₐ[k] K) E₁] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
          (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂]
          [DistribMulAction (K ≃ₐ[k] K) E₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
          (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
          (f' : DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                  DualMod p (TensorProduct (ZMod p) E₁ T))
          (hf' : ∀ (g : K ≃ₐ[k] K) (φ : DualMod p (TensorProduct (ZMod p) E₂ T)),
            f' (g • φ) = g • f' φ)
          (hff' : ∀ (φ : DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
            f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
          (b : Sha2 p k Ω K E₁),
          Φ E₂ (Sha2Map p k Ω K E₁ E₂ f hf b)
            = (Φ E₁ b).comp
                (Sha1Map p k Ω K
                  (DualMod p (TensorProduct (ZMod p) E₂ T))
                  (DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf')) := by
  refine ⟨fun E => LinearMap.flip (pair E), ?_, ?_⟩
  · intro E _ _ _ _ _ b₁ b₂ h12
    have hker : LinearMap.flip (pair E) (b₁ - b₂) = 0 := by rw [map_sub, h12, sub_self]
    have h0 : b₁ - b₂ = 0 := by
      refine hright E (b₁ - b₂) (fun a => ?_)
      have h1 := congrArg
        (fun (g : Sha1 p k Ω K (DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p]
            ZMod p) => g a) hker
      simpa [LinearMap.flip_apply] using h1
    exact sub_eq_zero.mp h0
  · intro E₁ _ _ _ _ _ E₂ _ _ _ _ _ f hf f' hf' hff' b
    refine LinearMap.ext (fun a => ?_)
    exact hnat E₁ E₂ f hf f' hf' hff' a b

/-- **Tate-Poitou duality in "embedding" form** (Milne, *Arithmetic Duality Theorems* I.4.10(a);
Neukirch-Schmidt-Wingberg 8.6.8), the Claim in Step 2 of Section 5 of Schmidt-Wingberg
(arXiv:math/9809211).

There is a family of `F_p`-linear maps `Phi_E : Sh^2(k,E) -> (Sh^1(k, E^v(1)) ->_F_p F_p)`, one for
each *finite* `F_p[Gal(K/k)]`-module `E` (where `E^v(1) = DualMod p (E (x) T)` and `T` is the
cyclotomic dual of `mu_p`), which is **injective** for every finite `E` and **natural** in `E` with
respect to every `Gal(K/k)`-equivariant linear `f : E_1 -> E_2` and its transpose `f'`.

This is the single arithmetic input of the whole Shafarevich reduction: the proved assembly
results `Work.SSGRoute.sha2_dual_control_of_tatePoitouEmbedding` and
`Work.SSGRoute.sha2_image_of_Hm2_of_dualControl` take exactly this witness `Phi` as a hypothesis,
and `Work.SSGRoute.stage_global_lifting` consumes the resulting
`Work.SSGRoute.sha2_image_of_Hm2`.

Available sorry-free assets to build on (see `Submission/Work/SSGRoute/DESIGN2.md`, node (1)):
the Chebotarev/Bauer Hasse principle (`Work.SSGRoute.hassePrinciple_h1_cocycles`,
`Work.SSGRoute.sha1_descent_H1`), finite-group Tate duality in degrees `-2`/`1`
(`Work.SSGRoute.tateDuality_hm2_dual_natural`, `Work.SSGRoute.H1_tateDual_clean`), the local Tate
pairings and their nondegeneracy (`Work.SSGRoute.local_tate_duality*`,
`Work.SSGRoute.hasPerfectLocalPairing_finite`, `Work.SSGRoute.archPair_nondegenerate`), the
`Sh^2`-vocabulary and its vanishing statements (`Work.SSGRoute.ShaCocycles`,
`Work.SSGRoute.sha2_trivial_vanish`, `Work.SSGRoute.sha2_restrict_vanish`,
`Work.SSGRoute.sha2_transport`, `Work.SSGRoute.selmer_dual_inflated`), the CFT library
(`NK.CFTLib.artinReciprocityIdeal_proved`, `NK.NUV2.kernelCondition_all`,
`NK.NUV2.chebotarev_all0`, `NK.GlobalCFTdeep.hbnUnits`, `NK.HassePrinciple.hbnIdele`) and the
ramified prime-index existence result `Work.SSGRoute.classField_exists_ramified` (plus its
Grunwald companions `Work.SSGRoute.grunwald_surjective_odd`,
`Work.SSGRoute.grunwald_kummer_idx`). -/
theorem tatePoitouEmbedding_alt
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ) :
    ∃ Φ : ∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E]
            [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
          Work.SSGRoute.Sha2 p k Ω K E →ₗ[ZMod p]
            (Work.SSGRoute.Sha1 p k Ω K
              (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T)) →ₗ[ZMod p] ZMod p),
      (∀ (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E],
        Function.Injective (Φ E)) ∧
      (∀ (E₁ : Type) [AddCommGroup E₁] [Module (ZMod p) E₁] [DistribMulAction (K ≃ₐ[k] K) E₁]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₁] [Finite E₁]
          (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂] [DistribMulAction (K ≃ₐ[k] K) E₂]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂] [Finite E₂]
          (f : E₁ →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E₁), f (g • e) = g • f e)
          (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₂ T) →ₗ[ZMod p]
                  Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₁ T))
          (hf' : ∀ (g : K ≃ₐ[k] K) (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₂ T)),
            f' (g • φ) = g • f' φ)
          (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₂ T)) (e : E₁) (t : T),
            f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
          (b : Work.SSGRoute.Sha2 p k Ω K E₁),
          Φ E₂ (Work.SSGRoute.Sha2Map p k Ω K E₁ E₂ f hf b)
            = (Φ E₁ b).comp
                (Work.SSGRoute.Sha1Map p k Ω K
                  (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₂ T))
                  (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E₁ T)) f' hf')) := by
  exact Work.SSGRoute.tatePoitouEmbedding p k Ω K ζ hζ hζK T hT

end Work.SSGRoute.PTembedding
