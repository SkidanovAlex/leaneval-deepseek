import Mathlib.Algebra.Field.ZMod
import Submission.Work.SSGRoute.exists_zsmul_eq_of_ptorsion_card
import Submission.Work.SSGRoute.zmultiples_eq_top_of_card_le_prime
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.SSGRoute

/-- **The annihilator of `ker d` is spanned by any nonzero annihilated element.** Let `p` be a
prime, `V W T E` additive groups with `W`, `E` finite and `W` a `ZMod p`-module, `E` killed by `p`
with at most `p` elements, and the `p`-torsion of `T` of order exactly `p`. Let `d : V →+ E` and let
`B : V → W → T` be additive in both variables, with `p`-torsion values, and suppose `B` detects
nonzero elements of `W`. Then every `w ∈ W` annihilated by `ker d` lies in the `ZMod p`-span of any
nonzero annihilated element. -/
theorem exists_smul_eq_of_annihilator (p : ℕ) [Fact p.Prime] {V W T E : Type}
    [AddCommGroup V] [AddCommGroup W] [AddCommGroup T] [AddCommGroup E]
    [Finite W] [Finite E] [Module (ZMod p) W]
    (hpE : ∀ x : E, p • x = 0) (hEcard : Nat.card E ≤ p)
    (hpW : ∀ w : W, p • w = 0)
    (hTcard : Nat.card {t : T // p • t = 0} = p)
    (d : V →+ E) (B : V → W → T)
    (hadd_v : ∀ v₁ v₂ w, B (v₁ + v₂) w = B v₁ w + B v₂ w)
    (hadd_w : ∀ v w₁ w₂, B v (w₁ + w₂) = B v w₁ + B v w₂)
    (hsmul_w : ∀ (c : ZMod p) v w, B v (c • w) = c.val • B v w)
    (hptors : ∀ v w, p • B v w = 0)
    (hdet : ∀ w, w ≠ 0 → ∃ v, B v w ≠ 0)
    {x₀ x : W} (hx₀ : x₀ ≠ 0) (hx₀K : ∀ v : V, d v = 0 → B v x₀ = 0)
    (hxK : ∀ v : V, d v = 0 → B v x = 0) :
    ∃ c : ZMod p, c • x₀ = x := by
  -- Additive structure in each variable, realized as additive homs.
  let φv : V → W →+ T := fun v => AddMonoidHom.mk' (fun w => B v w) (hadd_w v)
  let χ : W → V →+ T := fun w => AddMonoidHom.mk' (fun v => B v w) (fun a b => hadd_v a b w)
  -- The annihilator of `ker d` as an additive subgroup of `W`.
  let Ann : AddSubgroup W := ⨅ (v : d.ker), (φv (v : V)).ker
  have memAnn : ∀ w : W, w ∈ Ann ↔ ∀ v : V, v ∈ d.ker → B v w = 0 := by
    intro w
    show (w ∈ ⨅ (v : d.ker), (φv (v : V)).ker) ↔ (∀ v : V, v ∈ d.ker → B v w = 0)
    rw [AddSubgroup.mem_iInf]
    constructor
    · intro h v hv
      have hh := h ⟨v, hv⟩
      rw [AddMonoidHom.mem_ker] at hh
      exact hh
    · intro h v
      rw [AddMonoidHom.mem_ker]
      exact h v v.2
  -- `d` is not identically zero.
  have hv₁ : ∃ v : V, d v ≠ 0 := by
    by_contra h
    have hd : ∀ v : V, d v = 0 := by
      intro v
      by_contra hv
      exact h ⟨v, hv⟩
    obtain ⟨v, hv⟩ := hdet x₀ hx₀
    exact hv (hx₀K v (hd v))
  obtain ⟨v₁, hv₁⟩ := hv₁
  -- Since `E` is killed by `p` and has at most `p` elements, it is generated by `d v₁`.
  have hzmultiples_top : AddSubgroup.zmultiples (d v₁) = ⊤ :=
    zmultiples_eq_top_of_card_le_prime (G := E) p hpE hEcard (d v₁) hv₁
  -- The key injectivity step: on the annihilator, `B v₁ ·` is injective.
  have key : ∀ w : W, w ∈ Ann → φv v₁ w = 0 → w = 0 := by
    intro w hwAnn hwψ
    by_contra hw
    obtain ⟨v, hv⟩ := hdet w hw
    have hwψB : B v₁ w = 0 := hwψ
    obtain ⟨m, hm⟩ : ∃ m : ℤ, m • d v₁ = d v := by
      have hmem : d v ∈ AddSubgroup.zmultiples (d v₁) := by
        rw [hzmultiples_top]; exact trivial
      rwa [AddSubgroup.mem_zmultiples_iff] at hmem
    have hu : v - m • v₁ ∈ d.ker := by
      rw [AddMonoidHom.mem_ker, map_sub, map_zsmul, hm, sub_self]
    have hBuw : B (v - m • v₁) w = 0 := (memAnn w).mp hwAnn (v - m • v₁) hu
    have hdecomp : B v w = B (v - m • v₁) w + B (m • v₁) w := by
      have hh := hadd_v (v - m • v₁) (m • v₁) w
      rwa [sub_add_cancel] at hh
    have hBmv : B (m • v₁) w = m • B v₁ w := (χ w).map_zsmul m v₁
    have hBv : B v w = 0 := by
      rw [hdecomp, hBuw, hBmv, hwψB, smul_zero, zero_add]
    exact hv hBv
  have hx₀Ann : x₀ ∈ Ann := (memAnn x₀).mpr (fun v hv => hx₀K v hv)
  have hxAnn : x ∈ Ann := (memAnn x).mpr (fun v hv => hxK v hv)
  have hψx₀ : φv v₁ x₀ ≠ 0 := by
    intro h
    exact hx₀ (key x₀ hx₀Ann h)
  have hptorsψx₀ : p • φv v₁ x₀ = 0 := hptors v₁ x₀
  have hptorsψx : p • φv v₁ x = 0 := hptors v₁ x
  -- `B v₁ x` is an integer multiple of `B v₁ x₀` since the `p`-torsion of `T` is cyclic of order `p`.
  obtain ⟨m, hm⟩ :=
    exists_zsmul_eq_of_ptorsion_card (T := T) p hTcard (φv v₁ x₀) hψx₀ hptorsψx₀ (φv v₁ x) hptorsψx
  have hyAnn : m • x₀ - x ∈ Ann := by
    rw [memAnn]
    intro v hv
    have h1 : B v (m • x₀) = m • B v x₀ := (φv v).map_zsmul m x₀
    have h2 : B v (m • x₀ - x) = B v (m • x₀) - B v x := (φv v).map_sub (m • x₀) x
    have hx₀v : B v x₀ = 0 := (memAnn x₀).mp hx₀Ann v hv
    have hxv : B v x = 0 := (memAnn x).mp hxAnn v hv
    rw [h2, h1, hx₀v, hxv, smul_zero, sub_zero]
  have hψy : φv v₁ (m • x₀ - x) = 0 := by
    have h1 : φv v₁ (m • x₀) = m • φv v₁ x₀ := (φv v₁).map_zsmul m x₀
    have h2 : φv v₁ (m • x₀ - x) = φv v₁ (m • x₀) - φv v₁ x := (φv v₁).map_sub (m • x₀) x
    rw [h2, h1, hm, sub_self]
  have hy0 : m • x₀ - x = 0 := key (m • x₀ - x) hyAnn hψy
  have hmx : m • x₀ = x := sub_eq_zero.mp hy0
  refine ⟨(m : ZMod p), ?_⟩
  rw [Int.cast_smul_eq_zsmul (ZMod p)]
  exact hmx

end Work.SSGRoute
