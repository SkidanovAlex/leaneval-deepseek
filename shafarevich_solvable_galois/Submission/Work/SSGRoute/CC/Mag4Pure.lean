/-! ## Elementary helpers used by `mag4_pure` -/

/-- If the coefficientwise reduction mod `2` of `d ∈ FreeAssoc X` vanishes, then `d` is twice an
integral element, and the halved element can be chosen with no larger support. -/
theorem red2_eq_zero_halve {d : FreeAssoc X} (h : red2 X d = 0) :
    ∃ d' : FreeAssoc X, d = (2 : ℤ) • d' ∧
      ∀ w : FreeMonoid X, d'.coeff w ≠ 0 → d.coeff w ≠ 0 := by
  refine ⟨MonoidAlgebra.ofCoeff (d.coeff.mapRange (fun z : ℤ => z / 2) ?_), ?_, ?_⟩
  · norm_num
  · ext w
    rw [MonoidAlgebra.coeff_smul, Finsupp.smul_apply, smul_eq_mul, MonoidAlgebra.coeff_ofCoeff,
      Finsupp.mapRange_apply]
    have hw : (d.coeff w : ZMod 2) = 0 := by
      have h2 := congrArg (fun f : MonoidAlgebra (ZMod 2) (FreeMonoid X) => f.coeff w) h
      rwa [red2_apply, MonoidAlgebra.coeff_zero, Finsupp.zero_apply] at h2
    have hdvd : (2 : ℤ) ∣ d.coeff w := (ZMod.intCast_zmod_eq_zero_iff_dvd (d.coeff w) 2).mp hw
    exact (Int.mul_ediv_cancel' hdvd).symm
  · intro w hw hd
    rw [MonoidAlgebra.coeff_ofCoeff, Finsupp.mapRange_apply, hd] at hw
    exact hw (by norm_num)

/-- An element of `FreeAssoc X` whose support consists of words of length at least `j` lies in the
length filtration piece `filz X j`. -/
theorem mem_filz_of_coeff_len {j : ℕ} {d' : FreeAssoc X}
    (h : ∀ w : FreeMonoid X, d'.coeff w ≠ 0 → j ≤ w.length) : d' ∈ filz X j := by
  have hsum := Finsupp.sum_of_support_subset d'.coeff (s := d'.coeff.support)
    (Finset.Subset.refl _) (fun w r => MonoidAlgebra.single w r) (fun i hi => by simp)
  rw [show d'.coeff.sum (fun w r => MonoidAlgebra.single w r) = d'
      from MonoidAlgebra.sum_coeff_single _] at hsum
  rw [hsum]
  refine Submodule.sum_mem _ (fun w hw => ?_)
  exact single_mem_filz (h w (Finsupp.mem_support_iff.mp hw)) _

/-- The subgroup generated by the `p`-th powers is monotone. -/
theorem cc_powSubgroup_mono (p : ℕ) {G : Type*} [Group G] {H K : Subgroup G} (h : H ≤ K) :
    Work.Shrinking.powSubgroup p H ≤ Work.Shrinking.powSubgroup p K := by
  rw [Work.Shrinking.powSubgroup, Work.Shrinking.powSubgroup, Subgroup.closure_le]
  rintro x ⟨y, hy, rfl⟩
  exact Subgroup.subset_closure ⟨y, h hy, rfl⟩

/-- `γ_n^p · γ_{n+1} ≤ P_{n+1}` for the descending `p`-central series. -/
theorem powSubgroup_lcs_sup_le_pCentralSeries (p : ℕ) (G : Type*) [Group G] (n : ℕ) :
    Work.Shrinking.powSubgroup p ((⊤ : Subgroup G).lowerCentralSeries n) ⊔
      (⊤ : Subgroup G).lowerCentralSeries (n + 1) ≤
    Work.Shrinking.pCentralSeries p G (n + 1) := by
  refine sup_le ?_ ?_
  · refine le_trans
      (cc_powSubgroup_mono p (Work.ProP.lowerCentralSeries_le_pCentralSeries p G n)) ?_
    rw [Work.Shrinking.powSubgroup, Subgroup.closure_le]
    rintro x ⟨y, hy, rfl⟩
    rw [Work.Shrinking.pCentralSeries_succ, Work.Shrinking.pCentralStep]
    exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨y, hy, rfl⟩)
  · exact Work.ProP.lowerCentralSeries_le_pCentralSeries p G (n + 1)

/-- **The degree-`4` mod-`2` Magnus component detects `P₅` on `γ₄`.**

`mag4 X z` is the degree-`4` component, reduced mod `2`, of the Magnus image of `z` at truncation
`5` (defined in `Submission/Work/SSGRoute/magFourDefs.lean`).  For `u ∈ γ₄ = lowerCentralSeries 3`
the vanishing of `mag4 X u` forces `u ∈ P₅ = pCentralSeries 2 (FreeGroup X) 4`.

This is the injectivity/purity half of the identification `γ₄/(γ₄ ∩ P₅) ≅ Wsub X`.  Proof route:
`mag4 X u = 0` says the degree-`4` part `d` of a lift of `magLead 5 u` to `FreeAssoc X` has all
coefficients even, so `d = 2 * d'` with `d'` of degree `4`, hence `magLead 5 u = (2 : ℤ) • mk d'`
with `mk d' ∈ filq X 5 4`; then `prop5.adj_magnus_leadingTerm_of_kernel_and_pure` with `q = 2`,
`j = 4` (supplying its `hkernel` from `prop5.adjacent.magnus_kernel_detects` and its `hpure` from
`magnus_image_saturated_local`, exactly as `prop5.adjacent_pSeries_inter_lcs_le` does) gives
`u ∈ powSubgroup 2 (lowerCentralSeries 3) ⊔ lowerCentralSeries 4 ⊆ P₅`. -/
theorem mag4_pure {X : Type} {u : FreeGroup X}
    (hu : u ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries 3)
    (h : mag4 X u = 0) :
    u ∈ Work.Shrinking.pCentralSeries 2 (FreeGroup X) 4 := by
  -- The degree-`4` Magnus leading term lies in `filq X 5 4`, so it has a lift `c ∈ fil X 4`.
  have hmem : magLT X 4 u ∈ filq X 5 4 :=
    adj_magLT_mem_filq X 4 (by norm_num) hu
  obtain ⟨c, hc_mem, hc_eq⟩ := mem_filq_iff.1 hmem
  -- `mag4 X u = 0` says the degree-`4` part of `c` has all coefficients even.
  have hdeg : red2 X (degPart (X := X) 4 c) = 0 := by
    have h1 : mag4 X u = red2 X (degPart (X := X) 4 c) := by
      have h2 : degq 4 X (magLead 5 u) = red2 X (degPart (X := X) 4 c) := by
        rw [show magLead 5 u = magLT X 4 u from rfl, ← hc_eq,
          degq_mk (j := 4) (by norm_num) X c]
      exact h2
    rw [h1] at h
    exact h
  -- Halve it: `degPart 4 c = 2 • d'` with `d'` supported on words of length `4`.
  obtain ⟨d', hd'_eq, hd'_supp⟩ := red2_eq_zero_halve (X := X) hdeg
  have hd'len : ∀ w : FreeMonoid X, d'.coeff w ≠ 0 → 4 ≤ w.length := by
    intro w hw
    have h2 := hd'_supp w hw
    rw [coeff_degPart] at h2
    by_cases hl : w.length = 4
    · omega
    · rw [if_neg hl] at h2; exact absurd rfl h2
  have hd'mem : d' ∈ filz X 4 := mem_filz_of_coeff_len hd'len
  -- `magLT X 4 u` is `2` times a class in `filq X 5 4`.
  have hdiv : ∃ a : FreeAssoc X ⧸ fil X 5,
      a ∈ filq X 5 4 ∧ magLT X 4 u = (2 : ℤ) * a := by
    refine ⟨Ideal.Quotient.mk (fil X 5) d', ?_, ?_⟩
    · exact Ideal.mem_map_of_mem _ (filz_le_fil X 4 hd'mem)
    · have hc4 : c ∈ fil X 4 := filz_le_fil X 4 hc_mem
      have hc5 : c - degPart (X := X) 4 c ∈ fil X 5 := by
        have hh := sub_degPart_mem_fil (X := X) hc4
        simpa using hh
      have hmk : Ideal.Quotient.mk (fil X 5) c
          = Ideal.Quotient.mk (fil X 5) (degPart (X := X) 4 c) := by
        rw [← sub_eq_zero, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
        exact hc5
      rw [← hc_eq, hmk, hd'_eq, map_zsmul, zsmul_eq_mul]
  -- The two classical inputs of the adjacent-case assembly.
  have hkernel : ∀ (Y : Type) (j : ℕ), 1 ≤ j →
      ∀ y ∈ (⊤ : Subgroup (FreeGroup Y)).lowerCentralSeries (j - 1),
        ((magnus Y (j + 1) y : (FreeAssoc Y ⧸ fil Y (j + 1))ˣ) :
            FreeAssoc Y ⧸ fil Y (j + 1)) - 1 = 0 →
        y ∈ (⊤ : Subgroup (FreeGroup Y)).lowerCentralSeries j := by
    intro Y j' hj' y hy h'
    have h'' : ((magnus Y (j' + 1) y : (FreeAssoc Y ⧸ fil Y (j' + 1))ˣ) :
        FreeAssoc Y ⧸ fil Y (j' + 1)) - 1 ∈ filq Y (j' + 1) (j' - 1 + 2) := by
      rw [show j' - 1 + 2 = j' + 1 from by omega, h']
      exact (filq Y (j' + 1) (j' + 1)).zero_mem
    have hres := Work.SSGRoute.prop5.adjacent.magnus_kernel_detects Y (j' + 1) (j' - 1)
      (by omega) y hy h''
    rwa [Nat.sub_add_cancel hj'] at hres
  have hpure := fun (Y : Type) (n j : ℕ) => magnus_image_saturated_local Y n j
  have hmem2 := adj_magnus_leadingTerm_of_kernel_and_pure hkernel hpure 2 (by norm_num)
    X 4 (by norm_num) u hu hdiv
  exact powSubgroup_lcs_sup_le_pCentralSeries 2 (FreeGroup X) 3 hmem2

end

end Work.SSGRoute.CC
