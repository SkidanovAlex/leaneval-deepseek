namespace Work.SSGRoute



set_option linter.style.haveILetI false

/-- **Place glue, `K_w → M = k_v · Ω`.**

With `K_q = q.adicCompletion K` the completion of `K` at `q` (a `k_v`-algebra through the
canonical map `adicCompletionMapAt k Ω K A hA q hLies`) and `M = adjoinPlaceCompletion p A`
the `k_v`-subfield of the completion `C = placeCompletion A` of `Ω` at `A` generated by the
image of `Ω`, the canonical map `adicCompletionToPlaceCompletion q A hAq' : K_q →+* C` actually
lands in `M` (it is `k_v`-linear by `hlin`, `K_q` is finite dimensional over the complete field
`k_v`, so its image consists of elements of `C` algebraic, hence separable, over `k_v`, and
`M = separableClosure k_v C` contains all of them).

Hence it corestricts to a `k_v`-algebra map `θ : K_q →ₐ[k_v] M` which is the identity on `K`
(that is the pointwise condition, `adicCompletionToPlaceCompletion_algebraMap`). -/
theorem exists_algHom_adicCompletion_adjoinPlaceCompletion (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K] [IsSepClosure ↥K Ω] (A : ValuationSubring Ω)
    (hA : SSGRoute.IsFinPlace k A)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hAq : ∀ x : NumberField.RingOfIntegers K, x ∈ q.asIdeal ↔ A.valuation (((x : K) : Ω)) < 1)
    (hAq' : A.comap (algebraMap K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q)
    (hLies : q.asIdeal.LiesOver (Work.SSGRoute.primeUnder k A hA).asIdeal) :
    letI : Algebra (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) :=
      (Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies).toAlgebra
    letI : Algebra (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A) :=
      (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA)).toAlgebra
    (hlin : ∀ c : Work.SSGRoute.localFieldAt k A hA,
      NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := ↥K) (K' := Ω) q A hAq'
          (algebraMap (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) c) =
        algebraMap (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A) c) →
    ∃ θ : (q.adicCompletion K) →ₐ[Work.SSGRoute.localFieldAt k A hA]
        ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
          (Work.SSGRoute.primeUnder k A hA) A),
      ∀ x : K, θ (algebraMap K (q.adicCompletion K) x) =
        NK.NeukirchUchida.coInAdjoin (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A
          (algebraMap K Ω x) := by
  intro hlin
  -- the two `Algebra` structures of the statement, made available as local instances
  letI : Algebra (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) :=
    (Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies).toAlgebra
  letI : Algebra (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A) :=
    (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
      (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA)).toAlgebra
  -- the canonical ring homomorphism `K_q →+* C`
  let φ : (q.adicCompletion K) →+* NK.NeukirchUchida.placeCompletion A :=
    NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := ↥K) (K' := Ω) q A hAq'
  -- `hlin` says exactly that it is `k_v`-linear
  let φa : (q.adicCompletion K) →ₐ[Work.SSGRoute.localFieldAt k A hA]
      NK.NeukirchUchida.placeCompletion A :=
    AlgHom.mk' φ (fun c x => by
      rw [Algebra.smul_def, map_mul, hlin c, Algebra.smul_def])
  have hφa : ∀ z, φa z = φ z := fun z => congrFun (AlgHom.coe_mk' φ _) z
  -- `K_q` is a finite dimensional — hence algebraic, and separable in characteristic zero —
  -- extension of the complete field `k_v`
  have hfin : @Module.Finite (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) _ _
      (RingHom.toAlgebra (Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies)).toModule :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion
      (Work.SSGRoute.primeUnder k A hA) q hLies
  haveI : Module.Finite (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) := hfin
  haveI : FiniteDimensional (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) := hfin
  haveI hAlg : Algebra.IsAlgebraic (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) :=
    Algebra.IsAlgebraic.of_finite (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K)
  haveI hCZ : CharZero (Work.SSGRoute.localFieldAt k A hA) :=
    charZero_of_injective_algebraMap
      (RingHom.injective (algebraMap k (Work.SSGRoute.localFieldAt k A hA)))
  haveI hSepAlg : Algebra.IsSeparable (Work.SSGRoute.localFieldAt k A hA) (q.adicCompletion K) :=
    Algebra.IsAlgebraic.isSeparable_of_perfectField
  -- `M = k_v · Ω` contains every element of the completion which is separable over `k_v` (Krasner)
  have hsep_le_M : separableClosure (Work.SSGRoute.localFieldAt k A hA)
      (NK.NeukirchUchida.placeCompletion A) ≤
      NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A :=
    separableClosure_le_adjoinPlaceCompletion k Ω A hA (fun z => rfl)
  -- therefore the image of `φ` lies in `M`
  have hmem : ∀ x : q.adicCompletion K, φ x ∈
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A : Set (NK.NeukirchUchida.placeCompletion A)) := by
    intro x
    have hφalg : IsAlgebraic (Work.SSGRoute.localFieldAt k A hA) (φa x) :=
      IsAlgebraic.algHom φa (hAlg.isAlgebraic x)
    have hφsep : IsSeparable (Work.SSGRoute.localFieldAt k A hA) (φa x) :=
      PerfectField.separable_of_irreducible (minpoly.irreducible hφalg.isIntegral)
    have h1 : φa x ∈ (NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A : Set (NK.NeukirchUchida.placeCompletion A)) :=
      hsep_le_M (mem_separableClosure_iff.mpr hφsep)
    rw [hφa x] at h1
    exact h1
  -- corestricting `φ` to `M`
  let θ : (q.adicCompletion K) →ₐ[Work.SSGRoute.localFieldAt k A hA]
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A) :=
    AlgHom.codRestrict φa (NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A).toSubalgebra hmem
  refine ⟨θ, fun x => ?_⟩
  refine Subtype.ext ?_
  change (φ (algebraMap K (q.adicCompletion K) x) : NK.NeukirchUchida.placeCompletion A) =
    NK.NeukirchUchida.placeCompletionCoe A (algebraMap K Ω x)
  rw [show φ = NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := ↥K) (K' := Ω)
    q A hAq' from rfl]
  rw [NK.NeukirchUchida.adicCompletionToPlaceCompletion_algebraMap (K := ↥K) (K' := Ω)
    q A hAq' x]

end Work.SSGRoute
