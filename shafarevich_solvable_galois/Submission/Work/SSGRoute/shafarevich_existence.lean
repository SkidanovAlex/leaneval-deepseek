/-! ## The candidate class `x = cor y` and the conjuncts that are already available

`corCocycle k Ω K E y sec` is the explicit corestriction (transfer) cocycle of
`Work.SSGRoute.exists_corestriction`.  The three lemmas below record the conjuncts of
`shafarevich_existence` that hold for it without further arithmetic:

* it is a `1`-cocycle on all of `G_k` and locally constant (conjuncts 1 and 2 of the conclusion);
* on the decomposition groups of the places of `S` that split in `K` it agrees *pointwise* with
  the formal corestriction `∑ s, s • y ((sec s)⁻¹ * δ * sec s)` of the statement (conjunct 3:
  since `decomp k A ≤ K.fixingSubgroup`, the action of `res k K` is trivial there, so a
  coboundary on `decomp k A` is zero);
* it vanishes on the inertia of every finite place outside `cs(S)` that is not split in `Λ`
  (conjunct 6).

The remaining conjuncts — the coboundary conditions at the places of `S` that are not split in
`K` and at the involutions, and the cyclicity condition outside `cs(S)` — are the ones that
require Shafarevich's construction of the class `z` with `x = cor z`, and are not proved here.
-/

/-- The explicit corestriction `corCocycle` is a `1`-cocycle on all of `G_k` (conjunct 1). -/
lemma corCocycle_shaf_isCocycle (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [Fintype (K ≃ₐ[k] K)] (E : Type) [AddCommGroup E] [Module (ZMod p) E]
    [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ (corCocycle k Ω K E y sec) :=
  corCocycle_isCocycle k Ω K E y hy sec hsec

/-- The explicit corestriction `corCocycle` is locally constant on `G_k` (conjunct 2). -/
lemma corCocycle_shaf_isLocConstOn (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [Fintype (K ≃ₐ[k] K)] (E : Type) [AddCommGroup E] [Module (ZMod p) E]
    [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    SSGRoute.IsLocConstOn ⊤ (corCocycle k Ω K E y sec) :=
  corCocycle_isLocConstOn k Ω K E y hyc sec hsec

/-- On a place of `S` that splits in `K`, the explicit corestriction agrees pointwise with the
formal corestriction appearing in the statement (conjunct 3). -/
lemma corCocycle_shaf_eq_simple_of_isSplitIn (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)] (E : Type) [AddCommGroup E]
    [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (y : (Ω ≃ₐ[k] Ω) → E) (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) :
    ∀ A : ValuationSubring Ω, SSGRoute.IsSplitIn k K A → ∀ δ ∈ SSGRoute.decomp k A,
      corCocycle k Ω K E y sec δ = ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s) := by
  intro A hsplit δ hδ
  exact corCocycle_restrict k Ω K E y sec δ (hsplit hδ)

/-- The explicit corestriction vanishes on the inertia of every finite place outside `cs(S)` that
is not split in `Λ` (conjunct 6). -/
lemma corCocycle_shaf_eq_zero_of_isInertia (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ →
      corCocycle k Ω K E y sec σ = 0 := by
  intro B hB hconj hnsplit σ hI
  have hunram : ¬ SSGRoute.IsRamifiedIn k Λ B :=
    (SSGRoute.not_isRamifiedIn_and_not_val_p_lt_one_of_forall_not_conj Λ p S hSram B hB hconj).1
  have hσΛ : σ ∈ Λ.fixingSubgroup :=
    SSGRoute.mem_fixingSubgroup_of_isInertia_of_not_isRamifiedIn Λ B hunram σ hI
  have hσK : σ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ hσΛ
  rw [corCocycle_restrict k Ω K E y sec σ hσK]
  exact corestriction_vanishes_on_inertia p k Ω K Λ hKΛ E S hSfin hSram y hy hyS hyT sec hsec
    B hB hconj hnsplit σ hI


/-! ## Route and current state of `shafarevich_existence`

`Work.SSGRoute.shafarevich_existence` is Schmidt–Wingberg's Theorem 13 (the corrected `p = 2`
version) over an arbitrary number field `k`: given a class `y` on `G_K` which is unramified outside
`cs(S)` and vanishes on the inertias and decomposition groups specified by the hypotheses, there is
a class `x` on `G_k` which agrees with `cor y` at the places of `S` that split in `K`, is a
coboundary at the places of `S` that do not split in `K`, is a coboundary on the subgroups
generated by the involutions, is unramified at the finite places outside `cs(S)` that are not split
in `Λ`, and is *cyclic* at every finite place outside `cs(S)`.

The proof below is assembled as `x := corCocycle k Ω K E z sec` from a class `z` over `K` with the
following properties (see `Work.SSGRoute.shafarevich_z_construction`):

* `z` is a locally constant `1`-cocycle on `G_K` (conjuncts `(1)`, `(2)`);
* `z = y` on `D_B ⊓ G_K` for every finite place `B` conjugate to an element of `S` (conjunct `(3)`);
* `z` vanishes on the involutions of `G_K` (conjunct `(4)`);
* `z` vanishes on the inertia of every finite place `B ∉ cs(S)` that is not split in `Λ`
  (conjunct `(5)`);
* at every finite place `B ∉ cs(S)` that *is* split in `Λ`, the formal corestriction
  `∑ s, s • z((sec s)⁻¹ δ sec s)` vanishes on `D_B ⊓ V` for some open `V ≤ G_k` with `D_B ⊓ V`
  normal in `D_B` and `D_B/(D_B ⊓ V)` cyclic (conjunct `(6)` — this is the "cyclicity at the new
  ramification primes" produced by Shafarevich's construction, SW §4).

Conjuncts `(1)`–`(5)` of the construction are easy (with `z = y` on `G_K` and `0` off it); conjunct
`(6)` is the genuine arithmetic content of SW Theorem 13 (Chebotarev, the Poitou–Tate exact
sequence, the Hilbert-symbol product formula, and the induction on `dim_{𝔽_p} A`).

The *local* input on the side of `k` — needed for the last conjunct at the places outside `cs(S)`
that are not split in `Λ`, where `x` is unramified — is the cyclicity of the inertia quotient of a
decomposition group: see `Work.SSGRoute.decomp_mod_inertia_cyclic`
(`D_B/I_B ≅ Ẑ`, used through `exists_cyclic_open_of_isInertia_eq_zero` below).

The remaining unproved input of the file is therefore exactly the arithmetic:

* `Work.SSGRoute.shafarevich_z_construction` (`Submission/Work/SSGRoute/shafarevich_z_construction`),
  whose own reduction `Work.SSGRoute.shafarevich_z_construction_of_swData`
  (`Submission/Work/SSGRoute/ZConstruction/SWData.lean`, sorry-free) isolates the last piece as the
  *existence* of the SW §4 data.  The one-dimensional cases of that existence statement (for `p`
  odd and for `p = 2`) are `Work.SSGRoute.shafarevich_z_data_mup` and
  `Work.SSGRoute.shafarevich_z_data_two`; the general case is the induction on `dim_{𝔽_p} E`.

The local input — `Work.SSGRoute.decomp_inertia_quotient_cyclic`, i.e. `D_B/I_B ≅ Ẑ`: the trace of
an open subgroup containing the inertia on a decomposition group is normal with cyclic quotient —
is **proved** (`Submission/Work/SSGRoute/decomp_inertia_quotient_cyclic.lean`, used through
`exists_cyclic_open_of_isInertia_eq_zero`).

**Fallback.** `Work.SSGRoute.shafarevich_theorem13` (`Submission/Work/SSGRoute/shafarevich_theorem13`)
is the same theorem with its last conjunct phrased as "there is `U = V ⊓ decomp k B` (`V` open)
normal in `decomp k B` with cyclic quotient on which `x` is a coboundary".  The two statements are
logically equivalent (the last conjuncts correspond under `U = D_B ⊓ V`), and the derivation of the
statement of this file from that one is a ten-line argument (see `.mylogs/hedge.lean`); it is a
viable alternative assembly if `shafarevich_theorem13` is completed first.

Everything else — `corCocycle_satisfies_conditions`, `corCocycle_satisfies_involution_clause`
(from `Submission/Work/SSGRoute/shafarevich_theorem13`), `decomp_conj` and friends, the lemmas of
this file — is axiom-clean. -/

/-! ## Elementary bookkeeping used by the assembly

The proof of `shafarevich_existence` is assembled from the class `z` of
`Work.SSGRoute.shafarevich_z_construction` through `x = corCocycle z`.  The lemmas in this section
are the group-theoretic input to the last conjunct (the cyclicity condition at the places outside
`cs(S)`): the zero set of a `1`-cocycle is a subgroup, and a locally constant cocycle vanishing on
the inertia of a finite place satisfies the cyclicity condition there as soon as the inertia
quotient of the decomposition group is cyclic (`hcyc` below, a theorem of local field theory:
`D_B/I_B ≅ Ẑ`, supplied by `Work.SSGRoute.decomp_inertia_quotient_cyclic`).
-/

/-- A function vanishing on a subgroup is a coboundary there, with witness `0`. -/
theorem isCoboundaryOn_of_eq_zero {Γ G M : Type} [Group Γ] [Group G] [AddCommGroup M]
    [DistribMulAction G M] (act : Γ →* G) (H : Subgroup Γ) (f : Γ → M)
    (h : ∀ g ∈ H, f g = 0) : SSGRoute.IsCoboundaryOn act H f :=
  ⟨0, fun g hg => by rw [h g hg, smul_zero, sub_zero]⟩

/-- The value at `1` of a `1`-cocycle on all of `Γ` is `0`. -/
theorem isCocycleOn_apply_one {Γ G M : Type} [Group Γ] [Group G] [AddCommGroup M]
    [DistribMulAction G M] {act : Γ →* G} {f : Γ → M} (hf : SSGRoute.IsCocycleOn act ⊤ f) :
    f 1 = 0 := by
  have h := hf 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
  simp only [mul_one, map_one, one_smul] at h
  exact add_left_cancel (show f 1 + f 1 = f 1 + 0 by rw [add_zero]; exact h.symm)

/-- **The zero set of a `1`-cocycle is a subgroup.** -/
theorem isCocycleOn_zeroSetSubgroup {Γ G M : Type} [Group Γ] [Group G] [AddCommGroup M]
    [DistribMulAction G M] (act : Γ →* G) (f : Γ → M) (hf : SSGRoute.IsCocycleOn act ⊤ f) :
    ∃ Z : Subgroup Γ, ∀ g, g ∈ Z ↔ f g = 0 := by
  have h1 : f 1 = 0 := isCocycleOn_apply_one hf
  refine ⟨{ carrier := {g | f g = 0}, one_mem' := h1, mul_mem' := ?_, inv_mem' := ?_ },
    fun g => Iff.rfl⟩
  · intro a b ha hb
    change f a = 0 at ha
    change f b = 0 at hb
    change f (a * b) = 0
    rw [hf a (Subgroup.mem_top a) b (Subgroup.mem_top b), ha, hb, smul_zero, add_zero]
  · intro a ha
    change f a = 0 at ha
    change f a⁻¹ = 0
    have h := hf a (Subgroup.mem_top a) a⁻¹ (Subgroup.mem_top a⁻¹)
    rw [mul_inv_cancel, h1, ha, zero_add] at h
    have h2 : act a • f a⁻¹ = 0 := h.symm
    have h3 := congrArg (fun m => act a⁻¹ • m) h2
    simpa [← mul_smul, ← map_mul] using h3

/-- **Conjunct 7 at a finite place where `x` is unramified.**  Let `x` be a locally constant
`1`-cocycle on `G_k` (for the action `res k K` on `E`) vanishing on the inertia of the finite place
`B`, and let `hlocal` be the *local cyclicity input*: for every open subgroup `V ≤ G_k` containing
the inertial elements of `B`, some `g ∈ D_B` generates `D_B` modulo `V`.  Then the last conjunct of
`shafarevich_existence` holds at `B`.

Proof.  Let `U₀` be the open subgroup of local constancy of `x` and choose, by
`exists_finiteDimensional_normal_fixingSubgroup_le`, a finite-dimensional normal `M/k` with
`M.fixingSubgroup ≤ U₀`.  Put `V := M.fixingSubgroup ⊔ ⟨I_B⟩`, where `⟨I_B⟩` is the subgroup
generated by the inertial elements of `B`.  Then `V` is open (it contains `M.fixingSubgroup`), it
contains the inertia of `B`, and it is stable under conjugation by `D_B`: `M.fixingSubgroup` is
normal in `G_k`, while for `δ ∈ D_B` and `u` inertial at `B` the conjugate `δuδ⁻¹` is inertial at
`δ • B = B`.  Moreover `x` vanishes on `V`: the zero set of a `1`-cocycle is a subgroup containing
`M.fixingSubgroup` (local constancy) as well as the inertial elements (hypothesis).

Hence `D_B ⊓ V` is normal in `D_B` (it is the trace of the `D_B`-stable subgroup `V`), `x` is a
coboundary on it with witness `0`, and `D_B/(D_B ⊓ V)` is cyclic by `hlocal` (applied to `V`, the
condition `δ⁻¹ g ^ m ∈ V` being equivalent to `δ⁻¹ g ^ m ∈ D_B ⊓ V` for `δ, g ∈ D_B`). -/
theorem exists_cyclic_open_of_isInertia_eq_zero (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (B : ValuationSubring Ω) (x : (Ω ≃ₐ[k] Ω) → E)
    (hx : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ x)
    (hxc : SSGRoute.IsLocConstOn ⊤ x)
    (h6 : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → x σ = 0)
    (hlocal : ∀ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) →
      (∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → σ ∈ V) →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B ⊓ V) x := by
  haveI : IsGalois k Ω := inferInstance
  obtain ⟨U₀, hU₀open, hU₀inv⟩ := hxc
  obtain ⟨M, hMfin, hMnorm, hMsub⟩ :=
    exists_finiteDimensional_normal_fixingSubgroup_le (U := k) (L := Ω) U₀ hU₀open
  haveI : FiniteDimensional k M := hMfin
  haveI : Normal k M := hMnorm
  have hMfixnorm : (M.fixingSubgroup).Normal := by
    haveI : IsGalois k M :=
      isGalois_iff.mpr ⟨Algebra.IsSeparable.of_algHom k Ω (IntermediateField.val M), hMnorm⟩
    infer_instance
  -- the subgroup generated by the inertial elements of `B`
  set Isub : Subgroup (Ω ≃ₐ[k] Ω) :=
    Subgroup.closure {σ : Ω ≃ₐ[k] Ω | SSGRoute.IsInertia k B σ} with hIsubdef
  -- the zero set of `x` contains the two building blocks
  obtain ⟨Z, hZ⟩ := isCocycleOn_zeroSetSubgroup (SSGRoute.res k K) x hx
  have hx1 : x 1 = 0 := isCocycleOn_apply_one hx
  have hMZ : M.fixingSubgroup ≤ Z := by
    intro u hu
    refine (hZ u).mpr ?_
    have h := hU₀inv 1 (Subgroup.mem_top 1) u (hMsub hu) (Subgroup.mem_top u)
    rwa [one_mul, hx1] at h
  have hIZ : Isub ≤ Z := by
    rw [hIsubdef, Subgroup.closure_le]
    intro σ hσ
    exact (hZ σ).mpr (h6 σ hσ)
  have hVZ : M.fixingSubgroup ⊔ Isub ≤ Z := sup_le hMZ hIZ
  -- conjugation by `D_B` preserves `V := M.fixingSubgroup ⊔ Isub`
  let T : Subgroup (Ω ≃ₐ[k] Ω) :=
    { carrier := {w : Ω ≃ₐ[k] Ω | ∀ δ ∈ SSGRoute.decomp k B,
        MulAut.conj δ w ∈ (M.fixingSubgroup ⊔ Isub : Subgroup (Ω ≃ₐ[k] Ω))}
      one_mem' := by
        intro δ _
        simp
      mul_mem' := by
        intro a b ha hb δ hδ
        rw [map_mul]
        exact mul_mem (ha δ hδ) (hb δ hδ)
      inv_mem' := by
        intro a ha δ hδ
        rw [map_inv]
        exact inv_mem (ha δ hδ) }
  have hMT : M.fixingSubgroup ≤ T := by
    intro m hm δ hδ
    exact Subgroup.mem_sup_left (by simpa [MulAut.conj_apply] using hMfixnorm.conj_mem m hm δ)
  have hIT : Isub ≤ T := by
    rw [hIsubdef, Subgroup.closure_le]
    intro σ hσ δ hδ
    have hB : δ • B = B := MulAction.mem_stabilizer_iff.mp hδ
    have hconj := (isInertia_conj B δ σ).mpr hσ
    rw [hB] at hconj
    exact Subgroup.mem_sup_right (Subgroup.subset_closure (by simpa [MulAut.conj_apply] using hconj))
  have hVT : M.fixingSubgroup ⊔ Isub ≤ T := sup_le hMT hIT
  have hVopen : IsOpen ((M.fixingSubgroup ⊔ Isub : Subgroup (Ω ≃ₐ[k] Ω)) :
      Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.isOpen_mono le_sup_left (IntermediateField.fixingSubgroup_isOpen M)
  refine ⟨M.fixingSubgroup ⊔ Isub, hVopen, ?_, ?_, ?_⟩
  · intro δ hδ u hu
    have h := hVT hu.2 δ hδ
    simpa [MulAut.conj_apply] using h
  · exact hlocal _ hVopen (fun σ hσ => Subgroup.mem_sup_right (Subgroup.subset_closure hσ))
  · exact isCoboundaryOn_of_eq_zero _ _ _ (fun g hg => (hZ g).mp (hVZ hg.2))
/-- **The last conjunct of `shafarevich_existence` from a cyclic local image.**

Let `B` be a finite place of `Ω`, and let `x : G_k → E` be additive on the decomposition group
`D_B` (what `x = cor z` satisfies at a place where `Λ/k` splits, since then `D_B ≤ G_K` and the
action of `D_B` on `E` is trivial) and vanish on an open subgroup of `D_B`.  Assume that the image
of `x|_{D_B}` is *cyclic*, witnessed by `g ∈ D_B` (`∀ δ ∈ D_B, ∃ m : ℤ, x δ = m • x g`).  Then the
last conjunct of `shafarevich_existence` holds at `B`.

Proof.  Let `U := {u ∈ D_B | x u = 0}` be the kernel of `x|_{D_B}` (a subgroup normal in `D_B`),
let `W` be the open subgroup on which `x` vanishes and choose a finite-dimensional normal `M/k`
with `M.fixingSubgroup ≤ W` (Krull topology).  Then `V := M.fixingSubgroup ⊔ U` is open, it
contains the inertia of `B`, and `D_B ⊓ V = U`: an element of `D_B` written as `m · u` with
`m ∈ M.fixingSubgroup` has its `m`-factor back in `D_B`, where `x` vanishes on
`D_B ⊓ M.fixingSubgroup ⊆ D_B ⊓ W`.  Hence `D_B ⊓ V = U` is normal in `D_B`, the quotient
`D_B/(D_B ⊓ V)` is cyclic generated by `g` (since `x δ = m • x g = x(g^m)` gives
`δ⁻¹ g^m ∈ U`), and `x` vanishes on `D_B ⊓ V`, so it is a coboundary there with witness `0`.

This is the passage, in the proof of Shafarevich's existence theorem, from "the local class is
cyclic at the new ramification prime" to clause (7) of `shafarevich_existence`. -/
theorem exists_cyclic_open_of_cyclic_image (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (B : ValuationSubring Ω) (x : (Ω ≃ₐ[k] Ω) → E)
    (hadd : ∀ δ ∈ SSGRoute.decomp k B, ∀ δ' ∈ SSGRoute.decomp k B, x (δ * δ') = x δ + x δ')
    (hopen : ∃ W : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (W : Set (Ω ≃ₐ[k] Ω)) ∧
      ∀ u ∈ SSGRoute.decomp k B ⊓ W, x u = 0)
    (g : Ω ≃ₐ[k] Ω) (hg : g ∈ SSGRoute.decomp k B)
    (hgen : ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, x δ = m • x g) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g' ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g' ^ m ∈ V) ∧
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B ⊓ V) x := by
  haveI : IsGalois k Ω := inferInstance
  obtain ⟨W, hWopen, hWzero⟩ := hopen
  obtain ⟨M, hMfin, hMnorm, hMsub⟩ :=
    exists_finiteDimensional_normal_fixingSubgroup_le (U := k) (L := Ω) W hWopen
  haveI : FiniteDimensional k M := hMfin
  haveI : Normal k M := hMnorm
  have hMfixnorm : (M.fixingSubgroup).Normal := by
    haveI : IsGalois k M :=
      isGalois_iff.mpr ⟨Algebra.IsSeparable.of_algHom k Ω (IntermediateField.val M), hMnorm⟩
    infer_instance
  have hMfixzero : ∀ u ∈ SSGRoute.decomp k B ⊓ M.fixingSubgroup, x u = 0 :=
    fun u hu => hWzero u ⟨hu.1, hMsub hu.2⟩
  have hx1 : x 1 = 0 := by
    have h := hadd 1 (Subgroup.one_mem _) 1 (Subgroup.one_mem _)
    rw [mul_one] at h
    exact add_left_cancel (show x 1 + x 1 = x 1 + 0 by rw [add_zero]; exact h.symm)
  -- the kernel of `x` on `D_B`
  let U : Subgroup (Ω ≃ₐ[k] Ω) :=
    { carrier := {u : Ω ≃ₐ[k] Ω | u ∈ SSGRoute.decomp k B ∧ x u = 0}
      one_mem' := ⟨Subgroup.one_mem _, hx1⟩
      mul_mem' := by
        intro a b ha hb
        exact ⟨Subgroup.mul_mem _ ha.1 hb.1,
          by rw [hadd a ha.1 b hb.1, ha.2, hb.2, add_zero]⟩
      inv_mem' := by
        intro a ha
        refine ⟨Subgroup.inv_mem _ ha.1, ?_⟩
        have h := hadd a ha.1 a⁻¹ (Subgroup.inv_mem _ ha.1)
        rw [mul_inv_cancel, hx1, ha.2, zero_add] at h
        exact h.symm }
  have hUle : U ≤ SSGRoute.decomp k B := fun u hu => hu.1
  have hxpow : ∀ m : ℤ, x (g ^ m) = m • x g := by
    let φ : ℤ →+ E :=
      { toFun := fun m => x (g ^ m)
        map_zero' := by simpa using hx1
        map_add' := by
          intro a b
          rw [zpow_add, hadd _ (Subgroup.zpow_mem _ hg a) _
            (Subgroup.zpow_mem _ hg b)] }
    have h1 : ∀ m : ℤ, φ m = m • φ 1 := by
      intro m
      have := map_zsmul φ m (1 : ℤ)
      simpa using this
    have h2 : φ 1 = x g := by
      show x (g ^ (1 : ℤ)) = x g
      rw [zpow_one]
    intro m
    have := h1 m
    rw [h2] at this
    exact this
  -- the relevant elements of `D_B` lie in `U`
  have hmemU : ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U := by
    intro δ hδ
    obtain ⟨m, hm⟩ := hgen δ hδ
    refine ⟨m, ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ hδ) (Subgroup.zpow_mem _ hg m), ?_⟩⟩
    have h2 : x (δ⁻¹ * g ^ m) = x δ⁻¹ + x (g ^ m) :=
      hadd δ⁻¹ (Subgroup.inv_mem _ hδ) (g ^ m) (Subgroup.zpow_mem _ hg m)
    have hinv : x δ⁻¹ = - x δ := by
      have h := hadd δ hδ δ⁻¹ (Subgroup.inv_mem _ hδ)
      rw [mul_inv_cancel, hx1] at h
      refine eq_neg_iff_add_eq_zero.mpr ?_
      rw [add_comm]
      exact h.symm
    rw [h2, hinv, hxpow m, hm]
    abel
  have hnormU : ∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U := by
    intro δ hδ u hu
    refine ⟨Subgroup.mul_mem _ (Subgroup.mul_mem _ hδ (hUle hu)) (Subgroup.inv_mem _ hδ), ?_⟩
    have h1 : x (δ * u) = x δ + x u := hadd δ hδ u (hUle hu)
    have h2 : x (δ * u * δ⁻¹) = x (δ * u) + x δ⁻¹ :=
      hadd (δ * u) (Subgroup.mul_mem _ hδ (hUle hu)) δ⁻¹ (Subgroup.inv_mem _ hδ)
    have hinv : x δ⁻¹ = - x δ := by
      have h := hadd δ hδ δ⁻¹ (Subgroup.inv_mem _ hδ)
      rw [mul_inv_cancel, hx1] at h
      refine eq_neg_iff_add_eq_zero.mpr ?_
      rw [add_comm]
      exact h.symm
    rw [h2, h1, hu.2, add_zero, hinv, add_neg_cancel]
  -- `D_B ⊓ (M.fixingSubgroup ⊔ U) = U`
  have hVU : SSGRoute.decomp k B ⊓ (M.fixingSubgroup ⊔ U) = U := by
    haveI : (M.fixingSubgroup).Normal := hMfixnorm
    apply le_antisymm
    · intro v hv
      obtain ⟨m, hm, u, hu, hmu⟩ :=
        (Subgroup.mem_sup_of_normal_left (s := M.fixingSubgroup) (t := U)).mp hv.2
      have hmD : m ∈ SSGRoute.decomp k B := by
        have : m = v * u⁻¹ := by rw [← hmu]; group
        rw [this]
        exact Subgroup.mul_mem _ hv.1 (Subgroup.inv_mem _ (hUle hu))
      refine ⟨hv.1, ?_⟩
      have hsum : x v = x m + x u := by rw [← hmu, hadd m hmD u (hUle hu)]
      rw [hsum, hMfixzero m ⟨hmD, hm⟩, hu.2, zero_add]
    · intro v hv
      exact ⟨hUle hv, Subgroup.mem_sup_right hv⟩
  refine ⟨M.fixingSubgroup ⊔ U, ?_, ?_, ?_,
    isCoboundaryOn_of_eq_zero _ _ _ (fun u hu => (hVU ▸ hu : u ∈ U).2)⟩
  · exact Subgroup.isOpen_mono le_sup_left (IntermediateField.fixingSubgroup_isOpen M)
  · intro δ hδ u hu
    exact Subgroup.mem_sup_right (hnormU δ hδ u (hVU ▸ hu))
  · refine ⟨g, hg, fun δ hδ => ?_⟩
    obtain ⟨m, hm⟩ := hmemU δ hδ
    exact ⟨m, Subgroup.mem_sup_right hm⟩
theorem shafarevich_existence (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K Λ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k Λ] [IsGalois k Λ] [Fintype (K ≃ₐ[k] K)] (hKΛ : K ≤ Λ)
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] [Finite E]
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k Λ B ∨ B.valuation (p : Ω) < 1) → ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (hyc : SSGRoute.IsLocConstOn K.fixingSubgroup y)
    (hyS : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hyT : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → y σ = 0)
    (hy0 : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → y σ = 0)
    (hyinf : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 → y c = 0)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∃ x : (Ω ≃ₐ[k] Ω) → E,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ x ∧ SSGRoute.IsLocConstOn ⊤ x ∧
      (∀ A ∈ S, SSGRoute.IsSplitIn k K A →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A)
          (fun δ => x δ - ∑ s : K ≃ₐ[k] K, s • y ((sec s)⁻¹ * δ * sec s))) ∧
      (∀ A ∈ S, ¬ SSGRoute.IsSplitIn k K A →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) x) ∧
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c) x) ∧
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k Λ B →
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → x σ = 0) ∧
      ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B → (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) →
        ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
          (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ SSGRoute.decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
          (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
          SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B ⊓ V) x := by
  -- the auxiliary class `z` of Schmidt–Wingberg §4
  obtain ⟨z, zc, zlc, zT, zinv, zS, zcyc⟩ :=
    shafarevich_z_construction p k Ω K Λ hKΛ ζ hζ hζK E S hSfin hSdisj hSram y hy hyc hyS hyT hy0
      hyinf sec hsec
  -- `z` is additive on `G_K` (which acts trivially on `E`)
  have hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h := by
    intro g hg h hh
    have hres : SSGRoute.res k K g = 1 := (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg
    have h := zc g hg h hh
    rwa [hres, one_smul] at h
  -- the `y`-style local hypotheses for `z` (conjuncts (3) and (4) of the construction)
  have hzT' : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      ∀ σ ∈ K.fixingSubgroup, SSGRoute.IsInertia k B σ → z σ = 0 := by
    intro B hB hconj σ hσ hI
    rw [zT B hB hconj σ hσ hI.1]
    exact hyT B hB hconj σ hσ hI
  have hz0' : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∃ A ∈ S, SSGRoute.IsConjPlace k A B) →
      (¬ SSGRoute.IsSplitIn k K B ∨ B.valuation (p : Ω) < 1) →
      ∀ σ ∈ K.fixingSubgroup, σ ∈ SSGRoute.decomp k B → z σ = 0 := by
    intro B hB hconj hsp σ hσ hσd
    rw [zT B hB hconj σ hσ hσd]
    exact hy0 B hB hconj hsp σ hσ hσd
  -- clauses (1), (2), (4) and (6) of Theorem 13 for `x = cor z`
  obtain ⟨hx1, hx2, _hx3, hx4, hx6⟩ :=
    corCocycle_satisfies_conditions p k Ω K E Λ hKΛ S hSfin hSram z hzadd zlc zS hzT' hz0' sec
      hsec
  refine ⟨corCocycle k Ω K E z sec, hx1, hx2, ?_, hx4, ?_, hx6, ?_⟩
  · -- clause (3): on a place of `S` splitting in `K`, `z` agrees with `y` on the arguments
    intro A hA hsplit
    refine isCoboundaryOn_of_eq_zero _ _ _ (fun δ hδ => ?_)
    have hu : ∀ s : K ≃ₐ[k] K,
        z ((sec s)⁻¹ * δ * sec s) = y ((sec s)⁻¹ * δ * sec s) := by
      intro s
      have hfin : SSGRoute.IsFinPlace k ((sec s)⁻¹ • A) :=
        (isFinPlace_smul_iff A (sec s)⁻¹).mpr (hSfin A hA)
      have hconj : ∃ A' ∈ S, SSGRoute.IsConjPlace k A' ((sec s)⁻¹ • A) :=
        ⟨A, hA, ⟨(sec s)⁻¹, rfl⟩⟩
      have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup := by
        rw [← mem_fixingSubgroup_iff_res_eq_one, map_mul, map_mul, map_inv, hsec,
          (mem_fixingSubgroup_iff_res_eq_one k Ω K δ).mpr (hsplit hδ), mul_one,
          inv_mul_cancel]
      have hmemD : (sec s)⁻¹ * δ * sec s ∈ SSGRoute.decomp k ((sec s)⁻¹ • A) := by
        rw [decomp_conj A (sec s)⁻¹]
        have h : (MulAut.conj (sec s)⁻¹) δ = (sec s)⁻¹ * δ * sec s := by
          rw [MulAut.conj_apply]; simp
        rw [← h]
        exact Subgroup.mem_map_of_mem _ hδ
      exact zT _ hfin hconj _ hmemK hmemD
    rw [corCocycle_restrict k Ω K E z sec δ (hsplit hδ), sub_eq_zero]
    exact Finset.sum_congr rfl (fun s _ => by rw [hu s])
  · -- clause (5): the involution clause
    exact corCocycle_satisfies_involution_clause p k Ω K E z hzadd zinv sec hsec
  · -- clause (7): the "`x_p` is cyclic" condition
    intro B hB hconj
    by_cases hsplit : SSGRoute.IsSplitIn k Λ B
    · -- `D_B ≤ G_Λ ≤ G_K`: the construction of `z` gives the required open subgroup
      obtain ⟨V, hVopen, hnorm, hgen, hsum⟩ := zcyc B hB hconj hsplit
      refine ⟨V, hVopen, hnorm, hgen, isCoboundaryOn_of_eq_zero _ _ _ (fun δ hδ => ?_)⟩
      have hδK : δ ∈ K.fixingSubgroup := IntermediateField.fixingSubgroup_le hKΛ (hsplit hδ.1)
      rw [corCocycle_restrict k Ω K E z sec δ hδK]
      exact hsum δ hδ
    · -- `x` is unramified at `B`: use the cyclicity of the inertia quotient
      exact exists_cyclic_open_of_isInertia_eq_zero p k Ω K E B (corCocycle k Ω K E z sec) hx1 hx2
        (fun σ hI => hx6 B hB hconj hsplit σ hI)
        (fun V hV hI => (decomp_inertia_quotient_cyclic k Ω B hB V hV hI).2)

end Work.SSGRoute
