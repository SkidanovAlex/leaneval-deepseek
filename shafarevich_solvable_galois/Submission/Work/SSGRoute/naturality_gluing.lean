namespace Work.SSGRoute

/-- **Pushforward (naturality) of a glueing solution along an equivariant `𝔽_p`-linear map.**

If `ε₀ : G_k → E` is a continuous cocycle whose local defects against the prescribed local
functions `α` (on decomposition groups of places in `S`) and `β` (on the cyclic subgroups
generated by `C`) are coboundaries, and which vanishes on the inertia of every finite place
that is neither a conjugate of an element of `S` nor split in `N`, then for any `G`-equivariant
`𝔽_p`-linear `f : E → E₂` the composite `f ∘ ε₀` is a solution of the same shape with the same
local data `f ∘ α`, `f ∘ β` and the *smaller* field `N₂ ≤ N` (where not splitting in `N₂` is a
stronger condition than not splitting in `N`).

The mathematics is entirely formal: `f ∘ ε₀` is again a cocycle and again locally constant
because `f` is `G`-equivariant and `𝔽_p`-linear, the local coboundaries push forward through
`f`, and the vanishing condition transfers because `N₂ ≤ N` gives
`N.fixingSubgroup ≤ N₂.fixingSubgroup`, so `IsSplitIn N B` implies `IsSplitIn N₂ B`. -/
theorem naturality_gluing (p : ℕ) (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω]
    (K N N₂ : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k N] [IsGalois k N]
    [FiniteDimensional k N₂] [IsGalois k N₂] (hKN₂ : K ≤ N₂) (hN₂N : N₂ ≤ N)
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (S : Finset (ValuationSubring Ω)) (C : Finset (Ω ≃ₐ[k] Ω))
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → E)
    (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → E)
    (hE : ∃ ε₀ : (Ω ≃ₐ[k] Ω) → E,
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ ε₀ ∧ SSGRoute.IsLocConstOn ⊤ ε₀ ∧
        (∀ A ∈ S, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A)
          (fun σ => ε₀ σ - α A σ)) ∧
        (∀ c ∈ C, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
          (fun σ => ε₀ σ - β c σ)) ∧
        ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k N B →
          ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → ε₀ σ = 0)
    (E₂ : Type) [AddCommGroup E₂] [Module (ZMod p) E₂] [DistribMulAction (K ≃ₐ[k] K) E₂]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E₂]
    (f : E →ₗ[ZMod p] E₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : E), f (g • e) = g • f e) :
    ∃ ε : (Ω ≃ₐ[k] Ω) → E₂,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ ε ∧ SSGRoute.IsLocConstOn ⊤ ε ∧
      (∀ A ∈ S, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A)
        (fun σ => ε σ - f (α A σ))) ∧
      (∀ c ∈ C, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
        (fun σ => ε σ - f (β c σ))) ∧
      ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k N₂ B →
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → ε σ = 0 := by
  obtain ⟨ε₀, hcyc, hlc, hcobA, hcobC, hsplit⟩ := hE
  refine ⟨fun σ => f (ε₀ σ), ?_, ?_, ?_, ?_, ?_⟩
  · -- `f ∘ ε₀` is a cocycle: use the cocycle law of `ε₀`, additivity of `f`, and equivariance.
    rw [SSGRoute.IsCocycleOn] at hcyc ⊢
    intro g hg h hh
    rw [hcyc g hg h hh, map_add, hf]
  · -- local constancy is inherited: the same open subgroup `U` works.
    rw [SSGRoute.IsLocConstOn] at hlc ⊢
    obtain ⟨U, hUopen, hU⟩ := hlc
    exact ⟨U, hUopen, fun g hg u hu huH => by rw [hU g hg u hu huH]⟩
  · -- the local coboundaries at places of `S` push forward.
    intro A hA
    obtain ⟨m, hm⟩ := hcobA A hA
    dsimp only at hm
    refine ⟨f m, fun g hg => ?_⟩
    dsimp only
    rw [← map_sub, hm g hg, map_sub, hf]
  · -- the local coboundaries along the cyclic subgroups in `C` push forward.
    intro c hc
    obtain ⟨m, hm⟩ := hcobC c hc
    dsimp only at hm
    refine ⟨f m, fun g hg => ?_⟩
    dsimp only
    rw [← map_sub, hm g hg, map_sub, hf]
  · -- the vanishing condition: `¬ IsSplitIn N₂ ⟹ ¬ IsSplitIn N` since `N₂ ≤ N`.
    intro B hfin hconj hsplit₂ σ hinertia
    have hN : ¬ SSGRoute.IsSplitIn k N B :=
      fun h => hsplit₂ (le_trans h (IntermediateField.fixingSubgroup_le hN₂N))
    show f (ε₀ σ) = 0
    rw [hsplit B hfin hconj hN σ hinertia, map_zero]

end Work.SSGRoute
