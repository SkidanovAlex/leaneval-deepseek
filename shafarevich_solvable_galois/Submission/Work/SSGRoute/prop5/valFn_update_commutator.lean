open Work.CohomologicalShrinking

/-! ## The value map kills a slot filled with a commutator

`valFn_update_mul` shows that `valFn p G i j d` is a homomorphism in each slot, and
`valFn_update_pow` that it kills `p`-th powers.  Here we show that it also kills a slot
filled by a commutator `⁅a, b⁆` — the mathematical content being that the `j`-fold
commutator word with one letter of weight `1` has weight at least `j+1`, so its
`p^{i-j}`-th power lands in the successor term `P_{(i,j)+1}` of the refinement.

This is the second half of the statement that `valFn` factors through the square quotient
`F(d)/F(d)^p[F(d),F(d)]`, and it is what makes the Proposition 5 differential square to `0`
on the `𝔽_p[G]`-module generated by commutators.
-/

/-- The `p^{i-j}`-th power of the `j`-fold commutator word with the `k`-th slot replaced by
a commutator `⁅a, b⁆` lies in the successor term `P_{(i,j)+1}` of Schmidt–Wingberg's refined
`p`-central filtration.

Indeed `commWord j (update x k ⁅a,b⁆) ∈ γ_j = P^{j+1}` (`commWord_update_commutator_mem`),
so its `p^{i-j}`-th power lies in `P_i ∩ P^{j+1}` when `j < i` (by the `p`-power estimate
`pow_mem_pSeries`, the `p`-th power raising the `p`-central index by one), and in `P_{i+1}`
when `j = i` (there the exponent is `1` and `γ_j ≤ P_{j+1}`). -/
theorem commWord_update_commutator_pow_mem (p : ℕ) {P : Type*} [Group P] (i j : ℕ)
    (hj : 1 ≤ j) (hji : j ≤ i) (x : Fin j → P) (k : Fin j) (a b : P) :
    commWord j (Function.update x k ⁅a, b⁆) ^ p ^ (i - j) ∈
      refinedTerm p P (tauSucc i j).1 (tauSucc i j).2 := by
  rcases lt_or_eq_of_le hji with hlt | heq
  · -- `j < i`: the successor is `(i, j+1)`.
    have hidx : j + (i - j) - 1 = i - 1 := by omega
    have hword : commWord j (Function.update x k ⁅a, b⁆) ∈
        (⊤ : Subgroup P).lowerCentralSeries j :=
      commWord_update_commutator_mem j hj x k a b
    have hps : commWord j (Function.update x k ⁅a, b⁆) ^ p ^ (i - j) ∈ pSeries p P i := by
      have h := pow_mem_pSeries p j (i - j) hj (commWord j (Function.update x k ⁅a, b⁆))
        (commWord_mem_lowerCentralSeries j (Function.update x k ⁅a, b⁆))
      rwa [hidx] at h
    have hcs : commWord j (Function.update x k ⁅a, b⁆) ^ p ^ (i - j) ∈
        centralSeries P (j + 1) := by
      show _ ∈ (⊤ : Subgroup P).lowerCentralSeries j
      exact pow_mem hword _
    have hgoal : refinedTerm p P (tauSucc i j).1 (tauSucc i j).2
        = (pSeries p P i ⊓ centralSeries P (j + 1)) ⊔ pSeries p P (i + 1) := by
      rw [tauSucc_of_lt hlt, refinedTerm]
    rw [hgoal]
    exact Subgroup.mem_sup_left (Subgroup.mem_inf.mpr ⟨hps, hcs⟩)
  · -- `j = i`: the successor is `(i+1, 1)`, and the exponent is `p^0 = 1`.
    subst heq
    have hword : commWord j (Function.update x k ⁅a, b⁆) ∈
        (⊤ : Subgroup P).lowerCentralSeries j :=
      commWord_update_commutator_mem j hj x k a b
    have hgoal : refinedTerm p P (tauSucc j j).1 (tauSucc j j).2 = pSeries p P (j + 1) := by
      rw [tauSucc_of_le (le_refl j), refinedTerm_one]
    rw [hgoal]
    simp only [tsub_self, pow_zero, pow_one]
    exact Work.ProP.lowerCentralSeries_le_pCentralSeries p P j hword

/-- The class of an element of the small term `K` in `H ⧸ K.subgroupOf H` is trivial. -/
lemma mk'_subgroupOf_eq_one_of_mem {P : Type*} [Group P] {H K : Subgroup P} [K.Normal]
    {c : P} (hc : c ∈ H) (hmem : c ∈ K) :
    (QuotientGroup.mk' (K.subgroupOf H)) ⟨c, hc⟩ = 1 := by
  rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
  exact hmem

open scoped commutatorElement in
/-- **The value map kills a commutator slot**: replacing the `k`-th slot of `x` by a
commutator `⁅a, b⁆` makes `valFn p G i j d` vanish. -/
theorem valFn_update_commutator (p : ℕ) [Fact p.Prime] (G : Type*) [Group G] (i j d : ℕ)
    (hj : 1 ≤ j) (hji : j ≤ i)
    (x : Fin j → Work.Shrinking.freeOperatorGroup G d) (k : Fin j)
    (a b : Work.Shrinking.freeOperatorGroup G d) :
    valFn p G i j d hj hji (Function.update x k ⁅a, b⁆) = 0 := by
  have hmem := commWord_update_commutator_pow_mem (p := p)
    (P := Work.Shrinking.freeOperatorGroup G d) i j hj hji x k a b
  rw [valFn_apply]
  exact mk'_subgroupOf_eq_one_of_mem
    (commWord_pow_mem_refinedTerm p G i j d hj hji (Function.update x k ⁅a, b⁆)) hmem

end Work.SSGRoute.prop5
