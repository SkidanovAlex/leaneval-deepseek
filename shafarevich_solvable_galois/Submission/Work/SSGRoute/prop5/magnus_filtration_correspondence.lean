/-!
# The Magnus filtration correspondence

Let `F = FreeGroup X` be a free group, `A = FreeAssoc X = ℤ[FreeMonoid X]` the free associative
`ℤ`-algebra, `fil X N ⊆ A` the ideal of words of length `≥ N` and
`magnus X N : F →* (A ⧸ fil X N)ˣ` the (truncated) Magnus map.  Write `I` for the augmentation
ideal of the group algebra `ℤ[F]`, generated by the elements `single g 1 - 1` (`g ∈ F`).

This file proves that the truncated Magnus map is at least as strong as the natural map
`F → ℤ[F] ⧸ I^N`:  if `magnus X N g = 1` then `single g 1 - 1 ∈ I^N`.

The proof uses an auxiliary ring homomorphism `χ : A →+* ℤ[F] ⧸ I^N` sending the generator `X_x`
to `x - 1`.  A word `w` of length `k` is sent to the product of the `k` corresponding elements of
`I`, hence `χ` vanishes on `fil X N` and descends to `A ⧸ fil X N`.  Because
`χ (1 + X_x) = 1 + (x - 1) = x`, the composite `g ↦ χ (magnus X N g)` is the monoid homomorphism
`g ↦ single g 1` into the group algebra modulo `I^N`; consequently `magnus X N g = 1` forces
`single g 1 = 1` modulo `I^N`.

Note that this direction of the filtration correspondence needs no input from Witt's theorem (the
faithfulness of the free Lie ring): the only structural fact about the filtration used is the
elementary one that a product of `k` elements of `I` lies in `I^k` and that a word of length `k`
is carried into `I^k` by `χ`.
-/

noncomputable section

open scoped commutatorElement

namespace Work.SSGRoute.prop5

variable {X : Type*}

/-- The augmentation ideal of the group algebra of a free group, generated by the elements
`single g 1 - 1`, is a two-sided ideal. -/
theorem augIdeal_isTwoSided (X : Type) :
    (Ideal.span (Set.range (fun g' : FreeGroup X =>
      MonoidAlgebra.single g' (1 : ℤ) - 1))).IsTwoSided := by
  set I : Ideal (MonoidAlgebra ℤ (FreeGroup X)) :=
    Ideal.span (Set.range (fun g' : FreeGroup X =>
      MonoidAlgebra.single g' (1 : ℤ) - 1)) with hI
  have hgen : ∀ g' : FreeGroup X, MonoidAlgebra.single g' (1 : ℤ) - 1 ∈ I :=
    fun g' => Ideal.subset_span (Set.mem_range_self g')
  -- right multiplication by a basis element preserves `I`
  have hright : ∀ (h : FreeGroup X) ⦃a : MonoidAlgebra ℤ (FreeGroup X)⦄,
      a ∈ I → a * MonoidAlgebra.single h (1 : ℤ) ∈ I := by
    intro h a ha
    refine Submodule.span_induction (p := fun x _ => x * MonoidAlgebra.single h (1 : ℤ) ∈ I)
      ?_ ?_ ?_ ?_ ha
    · rintro x ⟨g', rfl⟩
      have h1 : (MonoidAlgebra.single g' (1 : ℤ) - 1) * MonoidAlgebra.single h (1 : ℤ)
          = (MonoidAlgebra.single (g' * h) (1 : ℤ) - 1)
            - (MonoidAlgebra.single h (1 : ℤ) - 1) := by
        rw [sub_mul, MonoidAlgebra.single_mul_single, mul_one, one_mul]
        abel
      rw [h1]
      exact Submodule.sub_mem _ (hgen (g' * h)) (hgen h)
    · rw [zero_mul]; exact Submodule.zero_mem _
    · intro x y _ _ hx hy
      rw [add_mul]
      exact Submodule.add_mem _ hx hy
    · intro c x _ hx
      rw [smul_mul_assoc]
      exact Submodule.smul_mem _ c hx
  refine ⟨fun {a} b ha => ?_⟩
  have hb : b = ∑ h ∈ b.coeff.support, MonoidAlgebra.single h (b.coeff h) := by
    conv_lhs => rw [← MonoidAlgebra.sum_coeff_single b]
    rfl
  rw [hb, Finset.mul_sum]
  refine Ideal.sum_mem _ fun h _ => ?_
  rw [show MonoidAlgebra.single h (b.coeff h)
      = (b.coeff h) • MonoidAlgebra.single h (1 : ℤ) by
    rw [MonoidAlgebra.smul_single']; simp]
  rw [mul_smul_comm, Algebra.smul_def]
  exact Ideal.mul_mem_left I _ (hright h ha)

/-- The group algebra of a free group, as a group of units: `g ↦ single g 1`. -/
def groupUnitHom (X : Type) : FreeGroup X →* (MonoidAlgebra ℤ (FreeGroup X))ˣ where
  toFun g :=
    ⟨MonoidAlgebra.single g (1 : ℤ), MonoidAlgebra.single g⁻¹ (1 : ℤ), by
      rw [MonoidAlgebra.single_mul_single, mul_one, mul_inv_cancel, MonoidAlgebra.one_def], by
      rw [MonoidAlgebra.single_mul_single, mul_one, inv_mul_cancel, MonoidAlgebra.one_def]⟩
  map_one' := by
    apply Units.ext
    show MonoidAlgebra.single (1 : FreeGroup X) (1 : ℤ) = (1 : MonoidAlgebra ℤ (FreeGroup X))
    exact MonoidAlgebra.one_def.symm
  map_mul' := by
    intro a b
    apply Units.ext
    show MonoidAlgebra.single (a * b) (1 : ℤ) =
      MonoidAlgebra.single a 1 * MonoidAlgebra.single b 1
    rw [MonoidAlgebra.single_mul_single, mul_one]

theorem magnus_filtration_correspondence (X : Type) (N : ℕ) (g : FreeGroup X)
    (h : ((magnus X N g : (FreeAssoc X ⧸ fil X N)ˣ) : FreeAssoc X ⧸ fil X N) - 1 = 0) :
    MonoidAlgebra.single g (1 : ℤ) - 1 ∈
      (Ideal.span (Set.range (fun g' : FreeGroup X => MonoidAlgebra.single g' (1 : ℤ) - 1))) ^ N := by
  classical
  set I : Ideal (MonoidAlgebra ℤ (FreeGroup X)) :=
    Ideal.span (Set.range (fun g' : FreeGroup X =>
      MonoidAlgebra.single g' (1 : ℤ) - 1)) with hI
  change MonoidAlgebra.single g (1 : ℤ) - 1 ∈ I ^ N
  have hI2 : I.IsTwoSided := augIdeal_isTwoSided X
  have hIN : (I ^ N).IsTwoSided := inferInstance
  let Q := MonoidAlgebra ℤ (FreeGroup X) ⧸ I ^ N
  let q : MonoidAlgebra ℤ (FreeGroup X) →+* Q := Ideal.Quotient.mk (I ^ N)
  -- the word `x ↦ single x 1 - 1` and its image in `Q`
  let u : FreeMonoid X →* MonoidAlgebra ℤ (FreeGroup X) :=
    FreeMonoid.lift (fun x => MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ) - 1)
  let φ : FreeMonoid X →* Q := q.toMonoidHom.comp u
  -- the comparison map `χ`
  let χ : FreeAssoc X →+* Q :=
    MonoidAlgebra.liftNCRingHom (Int.castRingHom Q) φ (fun n _ => Commute.intCast_left)
  have hu_of : ∀ x : X, u (FreeMonoid.of x) = MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ) - 1 :=
    fun x => by simp [u]
  have hφ_of : ∀ x : X, φ (FreeMonoid.of x) =
      q (MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ) - 1) :=
    fun x => by simp [φ, hu_of x]
  have hχ_single : ∀ (w : FreeMonoid X) (c : ℤ), χ (MonoidAlgebra.single w c) = (c : Q) * φ w :=
    fun w c => MonoidAlgebra.liftNCRingHom_single _ _ _ w c
  -- a word of length `k` maps to an element of `I^k`
  have hu_mem : ∀ w : FreeMonoid X, u w ∈ I ^ w.length := by
    intro w
    induction w using FreeMonoid.inductionOn' with
    | one =>
        have h0 : FreeMonoid.length (1 : FreeMonoid X) = 0 := rfl
        rw [map_one, h0, Submodule.pow_zero]
        exact Submodule.one_le.mp le_rfl
    | of_mul b a ih =>
        have hlen : (FreeMonoid.of b * a).length = a.length + 1 := by
          simp [FreeMonoid.length]
        rw [hlen, map_mul]
        have hpow : I ^ (a.length + 1) = I * I ^ a.length := by
          rw [Nat.add_comm a.length 1, Ideal.IsTwoSided.pow_add (I := I) 1 a.length, Submodule.pow_one]
        rw [hpow]
        refine Ideal.mul_mem_mul ?_ ih
        exact hu_of b ▸ Ideal.subset_span (Set.mem_range_self (FreeGroup.of b))
  -- hence `χ` vanishes on `fil X N`
  have hker : fil X N ≤ RingHom.ker χ := by
    rw [fil, Ideal.span_le]
    rintro a ⟨w, hw, rfl⟩
    refine (RingHom.mem_ker).mpr ?_
    rw [hχ_single w 1, Int.cast_one, one_mul]
    show q (u w) = 0
    rw [Ideal.Quotient.eq_zero_iff_mem]
    exact Ideal.pow_le_pow_right hw (hu_mem w)
  let χb : FreeAssoc X ⧸ fil X N →+* Q :=
    Ideal.Quotient.lift (fil X N) χ (fun a ha => (RingHom.mem_ker).mp (hker ha))
  have hχb : ∀ a : FreeAssoc X, χb (Ideal.Quotient.mk (fil X N) a) = χ a := fun a =>
    Ideal.Quotient.lift_mk (I := fil X N) (a := a) χ
      (fun a ha => (RingHom.mem_ker).mp (hker ha))
  -- the two monoid homomorphisms `F →* Qˣ`
  have hΨ : (Units.map χb.toMonoidHom).comp (magnus X N) =
      (Units.map q.toMonoidHom).comp (groupUnitHom X) := by
    refine FreeGroup.ext_hom _ _ (fun x => ?_)
    apply Units.ext
    show (↑((Units.map χb.toMonoidHom) (magnus X N (FreeGroup.of x))) : Q) =
      ↑((Units.map q.toMonoidHom) (groupUnitHom X (FreeGroup.of x)))
    rw [Units.coe_map, Units.coe_map]
    show χb (↑(magnus X N (FreeGroup.of x))) = q (MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ))
    rw [magnus_of, map_add, map_one, hχb]
    rw [hχ_single (FreeMonoid.of x) 1, Int.cast_one, one_mul, hφ_of x]
    show 1 + (q (MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ)) - 1) =
      q (MonoidAlgebra.single (FreeGroup.of x) (1 : ℤ))
    abel
  -- the hypothesis says that the Magnus image of `g` is trivial
  have hunit : magnus X N g = 1 := Units.ext (by rw [sub_eq_zero.mp h, Units.val_one])
  have hmap : (Units.map q.toMonoidHom) (groupUnitHom X g) = 1 := by
    have hΨg := congrArg (fun f : FreeGroup X →* Qˣ => f g) hΨ
    show ((Units.map q.toMonoidHom).comp (groupUnitHom X)) g = 1
    rw [← hΨg]
    show (Units.map χb.toMonoidHom) (magnus X N g) = 1
    rw [hunit, map_one]
  have hval : q (MonoidAlgebra.single g (1 : ℤ)) = 1 := by
    have hcoe : (↑((Units.map q.toMonoidHom) (groupUnitHom X g)) : Q) =
        q (MonoidAlgebra.single g (1 : ℤ)) := by
      rw [Units.coe_map]
      rfl
    rw [← hcoe, hmap, Units.val_one]
  refine (Ideal.Quotient.eq_zero_iff_mem (I := I ^ N)).mp ?_
  rw [map_sub, map_one, hval, sub_self]

end Work.SSGRoute.prop5
