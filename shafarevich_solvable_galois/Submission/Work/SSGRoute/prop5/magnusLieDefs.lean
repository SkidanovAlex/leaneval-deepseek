/-!
# The Lie lattice in the degree-`j` part of the truncated free associative algebra

Let `A = FreeAssoc X = ℤ[FreeMonoid X]` be the free associative `ℤ`-algebra on `X` and let
`fil X k` be the ideal generated by the words of length `≥ k`, so that
`fil X k ⧸ fil X (k+1)` is the degree-`k` part of `A` (a free `ℤ`-module on the words of length
`k`).

This file sets up the two lattices that occur in the statement of the "purity" of the Magnus
image:

* `lyndonSpan X j`, the `ℤ`-span of the *standard bracketings* of the Lyndon words of length `j`;
* `nestedSpan X j`, the `ℤ`-span of the left-nested bracket monomials of degree `j`.

The classical inputs relating them (proved in the `sorry`-free companion files
`nested_eq_lyndon_span` and `lyndon_leading_term`) are

* the two lattices coincide (the Lyndon bracketings span the free Lie ring), and
* the standard bracketing of a Lyndon word has lexicographically minimal word the word itself with
  coefficient `1` (triangularity, giving independence and saturation).

This file contains only definitions and elementary facts about them.
-/

noncomputable section

open scoped commutatorElement

attribute [local instance] Classical.propDecidable

namespace Work.SSGRoute.prop5

variable {X : Type*}

/-! ## Lyndon words -/

/-- A word is a **Lyndon word** (with respect to a linear order on the alphabet) if it is nonempty
and strictly smaller than each of its nontrivial rotations. -/
def IsLyndon [LinearOrder X] (w : List X) : Prop :=
  w ≠ [] ∧ ∀ i : ℕ, 0 < i → i < w.length → w < w.drop i ++ w.take i

/-- The `ℤ`-basis element of `FreeAssoc X` attached to a word. -/
def wordEl (w : List X) : FreeAssoc X := MonoidAlgebra.single (FreeMonoid.ofList w) 1

/-- The length of the longest proper suffix of `w` which is a Lyndon word (`0` if there is none). -/
def lyndonSuffixLen [LinearOrder X] (w : List X) : ℕ :=
  Nat.findGreatest (fun m => 0 < m ∧ m < w.length ∧ IsLyndon (w.drop (w.length - m)))
    (w.length - 1)

theorem lyndonSuffixLen_spec [LinearOrder X] {w : List X} (h : lyndonSuffixLen w ≠ 0) :
    0 < lyndonSuffixLen w ∧ lyndonSuffixLen w < w.length ∧
      IsLyndon (w.drop (w.length - lyndonSuffixLen w)) := by
  have h1 := (Nat.findGreatest_eq_iff
    (P := fun m => 0 < m ∧ m < w.length ∧ IsLyndon (w.drop (w.length - m)))
    (k := w.length - 1)).mp rfl
  exact h1.2.1 h

/-- The *standard bracketing* of a Lyndon word: `b([x]) = single x 1` and, for `w = u v` the
standard factorization of a Lyndon word `w` of length `≥ 2`, `b(w) = b(u) * b(v) - b(v) * b(u)`.
It is defined for all words (with the value `0` on the non-Lyndon ones, which is irrelevant). -/
def stdBr [LinearOrder X] : List X → FreeAssoc X
  | [] => 0
  | [x] => wordEl [x]
  | w =>
      if h : lyndonSuffixLen w = 0 then 0
      else
        (stdBr (w.take (w.length - lyndonSuffixLen w))) *
            (stdBr (w.drop (w.length - lyndonSuffixLen w)))
          - (stdBr (w.drop (w.length - lyndonSuffixLen w))) *
            (stdBr (w.take (w.length - lyndonSuffixLen w)))
termination_by w => w.length
decreasing_by
  · exact lt_of_le_of_lt (List.length_take_le _ _) (by have := lyndonSuffixLen_spec (w := w) h; omega)
  · rw [List.length_drop]
    have := lyndonSuffixLen_spec (w := w) h
    omega

/-- The **Lie lattice** `Λ_j ⊆ FreeAssoc X`: the `ℤ`-span of the standard bracketings of the
Lyndon words of length `j`. -/
def lyndonSpan [LinearOrder X] (j : ℕ) : Submodule ℤ (FreeAssoc X) :=
  Submodule.span ℤ {a : FreeAssoc X | ∃ w : List X, w.length = j ∧ IsLyndon w ∧ a = stdBr w}

/-- The **nested span**: the `ℤ`-span of the words of length `j`, i.e. the degree-`j` part of
`FreeAssoc X` (modelled inside `FreeAssoc X` by the words of that length). -/
def wordSpan (j : ℕ) : Submodule ℤ (FreeAssoc X) :=
  Submodule.span ℤ {a : FreeAssoc X | ∃ w : List X, w.length = j ∧ a = wordEl w}

/-- The left-nested bracket monomial `[[...[x_{i₁},x_{i₂}],…],x_{i_j}]` attached to a word. -/
def lnMon : List X → FreeAssoc X
  | [] => 0
  | x :: rest => rest.foldl (fun acc y => acc * wordEl [y] - wordEl [y] * acc) (wordEl [x])

/-- The `ℤ`-span of the **left-nested bracket monomials** of degree `j`. -/
def nestedSpan (j : ℕ) : Submodule ℤ (FreeAssoc X) :=
  Submodule.span ℤ {a : FreeAssoc X | ∃ w : List X, w.length = j ∧ a = lnMon w}

end Work.SSGRoute.prop5
