/-!
# The lower central series of a free group is generated by the commutator monomials

For a free group `F = FreeGroup X` and `n : ℕ` the commutator monomial `monGrp X c` of a binary
tree `c` with `n` leaves lies in `γ_{n-1} = (⊤ : Subgroup F).lowerCentralSeries (n-1)`; write
`monWeight X n` for the subgroup generated by all these monomials.  The generation statement is

`γ_{m-1} = monWeight X m ⊔ γ_m`.

Equivalently: the associated graded piece `Λ_{m-1} = γ_{m-1}/γ_m` is generated by the classes of the
weight-`m` monomials.  This is the classical statement that the associated graded of the lower
central series of a free group is generated in degree one.

## Structure of the proof

Write `monSup X n = monWeight X n ⊔ γ_n`.  The heart is the multilinearization step

`commutator_monWeight_mem_sup`: for `s ∈ monWeight X (n+1)` and arbitrary `b`, the commutator
`⁅s,b⁆` lies in `monSup X (n+2)`.

It is proved in two steps, both by closure induction.

* For a fixed monomial `s = monGrp X c` one inducts on the word `b ∈ FreeGroup X`: for a generator
  `b = FreeGroup.of x` the commutator is `monGrp X (Magma.mul c (Magma.gen x))`, a monomial of
  weight `size c + 1`; for products and inverses the commutator is rewritten with
  `commutatorElement_mul_right_eq_mul_conj` / `commutatorElement_inv_right` and the conjugation
  error `v * u * v⁻¹ * u⁻¹ ∈ γ_{k+m+1}` (for `u ∈ γ_m`, `v ∈ γ_k`) is absorbed by `γ_{size c + 1}`.
* Then one inducts on `s ∈ monWeight X (n+1)` (a closure of monomials): products are handled with
  `commutatorElement_mul_left_eq_conj_mul` and the fact that `s ∈ γ_n`, so that the conjugation
  error lands in `γ_{2n+2} ⊆ γ_{n+2}`, and inverses with `commutatorElement_inv_left`.

Finally `γ_{n+1} = ⁅γ_n, F⁆` (Mathlib: `Subgroup.lowerCentralSeries_succ`), so every element of
`γ_{n+1}` is a product of commutators `⁅a, b⁆` with `a ∈ γ_n`, `b ∈ F`; writing `a = s * h` with
`s ∈ monWeight X (n+1)`, `h ∈ γ_{n+1}` (the induction hypothesis) one computes
`⁅s * h, b⁆ = s * ⁅h, b⁆ * s⁻¹ * ⁅s, b⁆`, where `⁅h,b⁆ ∈ γ_{n+2}` and `⁅s,b⁆ ∈ monSup X (n+2)`.
-/

noncomputable section

open scoped commutatorElement Pointwise

namespace Work.SSGRoute.prop5

namespace LcsGenAux

variable {X : Type}

/-- `monSup X n = monWeight X n ⊔ γ_n`, the target of the generation statement. -/
abbrev monSup (X : Type) (n : ℕ) : Subgroup (FreeGroup X) :=
  monWeight X n ⊔ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n

/-- Membership in `H ⊔ N` for a normal `N`, written as a product. -/
theorem mem_sup_of_normal {H N : Subgroup (FreeGroup X)} (hN : N.Normal) {x : FreeGroup X} :
    x ∈ H ⊔ N ↔ ∃ h ∈ H, ∃ n ∈ N, h * n = x := by
  have key : ((H ⊔ N : Subgroup (FreeGroup X)) : Set (FreeGroup X)) =
      (H : Set (FreeGroup X)) * (N : Set (FreeGroup X)) :=
    Subgroup.mul_normal H N (hN := hN)
  constructor
  · intro hx
    have hx' : x ∈ ((H ⊔ N : Subgroup (FreeGroup X)) : Set (FreeGroup X)) := hx
    rw [key] at hx'
    exact Set.mem_mul.mp hx'
  · rintro ⟨h, hh, k, hk, rfl⟩
    have hmem : h * k ∈ ((H ⊔ N : Subgroup (FreeGroup X)) : Set (FreeGroup X)) := by
      rw [key]
      exact Set.mem_mul.mpr ⟨h, hh, k, hk, rfl⟩
    exact hmem

/-- An element of `monWeight X (n+1)` lies in `γ_n`. -/
theorem monWeight_mem_lcs {n : ℕ} {x : FreeGroup X} (hx : x ∈ monWeight X (n + 1)) :
    x ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n := by
  have h := monWeight_le_lcs X (n := n + 1) (by omega) hx
  have hidx : n + 1 - 1 = n := by omega
  rwa [hidx] at h

/-- The commutator of a weight-`k` monomial with an arbitrary element lies in `γ_k`. -/
theorem commutator_monGrp_mem_lcs (c : Magma X) (b : FreeGroup X) :
    ⁅monGrp X c, b⁆ ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (Magma.size c) := by
  have h := commutator_mem_lcs X (p := Magma.size c - 1) (q := 0)
    (monGrp_mem_lowerCentralSeries c) (Subgroup.mem_top b)
  have hidx : Magma.size c - 1 + 0 + 1 = Magma.size c := by
    have := Magma.size_pos c
    omega
  rwa [hidx] at h

/-- Inner step of the multilinearization: for a fixed monomial `monGrp X c` and an arbitrary word
`b`, the commutator `⁅monGrp X c, b⁆` lies in `monWeight X (size c + 1) ⊔ γ_{size c + 1}`. -/
theorem commutator_monGrp_mem_sup (c : Magma X) (b : FreeGroup X) :
    ⁅monGrp X c, b⁆ ∈ monSup X (Magma.size c + 1) := by
  induction b using FreeGroup.induction_on with
  | one =>
      rw [commutatorElement_one_right]
      exact Subgroup.one_mem _
  | of x =>
      have h : ⁅monGrp X c, FreeGroup.of x⁆ = monGrp X (Magma.mul c (Magma.gen x)) := by
        rw [← monGrp_gen X x, ← monGrp_mul X c (Magma.gen x)]
      rw [h]
      exact Subgroup.mem_sup_left (monGrp_mem_monWeight X (Magma.mul c (Magma.gen x)))
  | inv_of x ih =>
      rw [commutatorElement_inv_right, ← commutatorElement_inv (monGrp X c) (FreeGroup.of x)]
      set u := ⁅monGrp X c, FreeGroup.of x⁆⁻¹ with hu_def
      have hu : u ∈ monSup X (Magma.size c + 1) := by
        rw [hu_def]; exact Subgroup.inv_mem _ ih
      have hum : u ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (Magma.size c) := by
        rw [hu_def]
        exact Subgroup.inv_mem _ (commutator_monGrp_mem_lcs c (FreeGroup.of x))
      have herr : (FreeGroup.of x)⁻¹ * u * (FreeGroup.of x) * u⁻¹ ∈
          monSup X (Magma.size c + 1) := by
        have h := conj_mul_inv_mem_lcs X (k := 0) (m := Magma.size c) hum
          (Subgroup.mem_top (FreeGroup.of x)⁻¹)
        refine Subgroup.mem_sup_right ?_
        simpa using h
      have key : (FreeGroup.of x)⁻¹ * u * (FreeGroup.of x) =
          ((FreeGroup.of x)⁻¹ * u * (FreeGroup.of x) * u⁻¹) * u := by group
      rw [key]
      exact Subgroup.mul_mem _ herr hu
  | mul b₁ b₂ ih₁ ih₂ =>
      rw [commutatorElement_mul_right_eq_mul_conj]
      set y := ⁅monGrp X c, b₂⁆ with hy_def
      have hy : y ∈ monSup X (Magma.size c + 1) := by rw [hy_def]; exact ih₂
      have hym : y ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (Magma.size c) := by
        rw [hy_def]; exact commutator_monGrp_mem_lcs c b₂
      have hconj : b₁ * y * b₁⁻¹ ∈ monSup X (Magma.size c + 1) := by
        have h := conj_mul_inv_mem_lcs X (k := 0) (m := Magma.size c) hym
          (Subgroup.mem_top b₁)
        have herr : b₁ * y * b₁⁻¹ * y⁻¹ ∈ monSup X (Magma.size c + 1) :=
          Subgroup.mem_sup_right (by simpa using h)
        have key : b₁ * y * b₁⁻¹ = (b₁ * y * b₁⁻¹ * y⁻¹) * y := by group
        rw [key]
        exact Subgroup.mul_mem _ herr hy
      have key : ⁅monGrp X c, b₁⁆ * b₁ * y * b₁⁻¹ = ⁅monGrp X c, b₁⁆ * (b₁ * y * b₁⁻¹) := by
        group
      rw [key]
      exact Subgroup.mul_mem _ ih₁ hconj

/-- **Multilinearization step.**  The commutator of an element of `monWeight X (n+1)` with an
arbitrary element of the free group lies in `monWeight X (n+2) ⊔ γ_{n+2}`. -/
theorem commutator_monWeight_mem_sup (n : ℕ) {s : FreeGroup X}
    (hs : s ∈ monWeight X (n + 1)) (b : FreeGroup X) :
    ⁅s, b⁆ ∈ monSup X (n + 2) := by
  refine Subgroup.closure_induction (p := fun s _ => ⁅s, b⁆ ∈ monSup X (n + 2)) ?_ ?_ ?_ ?_ hs
  · rintro x ⟨c, hc, rfl⟩
    have h := commutator_monGrp_mem_sup c b
    rw [hc] at h
    simpa using h
  · rw [commutatorElement_one_left]
    exact Subgroup.one_mem _
  · intro x y hx hy ihx ihy
    rw [commutatorElement_mul_left_eq_conj_mul]
    set z := ⁅y, b⁆ with hz_def
    have hz : z ∈ monSup X (n + 2) := by rw [hz_def]; exact ihy
    have hzm : z ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 1) := by
      rw [hz_def]
      have h := commutator_mem_lcs X (p := n) (q := 0) (monWeight_mem_lcs hy)
        (Subgroup.mem_top b)
      simpa using h
    have hxm : x ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n :=
      monWeight_mem_lcs hx
    have hconj : x * z * x⁻¹ ∈ monSup X (n + 2) := by
      have h := conj_mul_inv_mem_lcs X hzm hxm
      have herr : x * z * x⁻¹ * z⁻¹ ∈ monSup X (n + 2) :=
        Subgroup.mem_sup_right
          (Subgroup.lowerCentralSeries_antitone ⊤ (show n + 2 ≤ n + (n + 1) + 1 by omega) h)
      have key : x * z * x⁻¹ = (x * z * x⁻¹ * z⁻¹) * z := by group
      rw [key]
      exact Subgroup.mul_mem _ herr hz
    have key : x * z * x⁻¹ * ⁅x, b⁆ = (x * z * x⁻¹) * ⁅x, b⁆ := by group
    rw [key]
    exact Subgroup.mul_mem _ hconj ihx
  · intro x hx ih
    rw [commutatorElement_inv_left, ← commutatorElement_inv x b]
    set u := ⁅x, b⁆⁻¹ with hu_def
    have hu : u ∈ monSup X (n + 2) := by rw [hu_def]; exact Subgroup.inv_mem _ ih
    have hum : u ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 1) := by
      rw [hu_def]
      refine Subgroup.inv_mem _ ?_
      have h := commutator_mem_lcs X (p := n) (q := 0) (monWeight_mem_lcs hx)
        (Subgroup.mem_top b)
      simpa using h
    have hxm : x⁻¹ ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n :=
      Subgroup.inv_mem _ (monWeight_mem_lcs hx)
    have herr : x⁻¹ * u * x * u⁻¹ ∈ monSup X (n + 2) := by
      have h := conj_mul_inv_mem_lcs X hum hxm
      refine Subgroup.mem_sup_right ?_
      simpa using
        (Subgroup.lowerCentralSeries_antitone ⊤ (show n + 2 ≤ n + (n + 1) + 1 by omega) h)
    have key : x⁻¹ * u * x = (x⁻¹ * u * x * u⁻¹) * u := by group
    rw [key]
    exact Subgroup.mul_mem _ herr hu

/-- Main induction: `γ_n ⊆ monWeight X (n+1) · γ_{n+1}`. -/
theorem lcs_le_monSup (n : ℕ) :
    (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n ≤ monSup X (n + 1) := by
  induction n with
  | zero =>
      have : monSup X (0 + 1) = ⊤ := by simp [monSup, monWeight_one_eq_top]
      rw [this]
      exact le_top
  | succ n ih =>
      rw [Subgroup.lowerCentralSeries_succ, Subgroup.commutator_def]
      refine (Subgroup.closure_le _).2 ?_
      rintro g ⟨g₁, hg₁, g₂, -, rfl⟩
      have hsplit : g₁ ∈ monWeight X (n + 1) ⊔
          (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 1) := by
        simpa [monSup] using ih hg₁
      have hn : ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 1)).Normal :=
        graded.Gam_normal (G := FreeGroup X) (n + 1)
      obtain ⟨s, hs, h, hh, hsgh⟩ :=
        (mem_sup_of_normal (H := monWeight X (n + 1))
          (N := (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 1)) hn).mp hsplit
      rw [← hsgh, commutatorElement_mul_left_eq_conj_mul]
      have hsLcs : s ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries n :=
        monWeight_mem_lcs hs
      have hhm : ⁅h, g₂⁆ ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n + 2) := by
        have hk := commutator_mem_lcs X (p := n + 1) (q := 0) hh (Subgroup.mem_top g₂)
        simpa using hk
      have hconj : s * ⁅h, g₂⁆ * s⁻¹ ∈ monSup X (n + 2) := by
        have hkey := conj_mul_inv_mem_lcs X hhm hsLcs
        have herr : s * ⁅h, g₂⁆ * s⁻¹ * ⁅h, g₂⁆⁻¹ ∈ monSup X (n + 2) :=
          Subgroup.mem_sup_right
            (Subgroup.lowerCentralSeries_antitone ⊤ (show n + 2 ≤ n + (n + 2) + 1 by omega) hkey)
        have key : s * ⁅h, g₂⁆ * s⁻¹ = (s * ⁅h, g₂⁆ * s⁻¹ * ⁅h, g₂⁆⁻¹) * ⁅h, g₂⁆ := by group
        rw [key]
        exact Subgroup.mul_mem _ herr (Subgroup.mem_sup_right hhm)
      have hs2 : ⁅s, g₂⁆ ∈ monSup X (n + 2) := commutator_monWeight_mem_sup n hs g₂
      exact Subgroup.mul_mem _ hconj hs2

end LcsGenAux

open LcsGenAux

theorem lcs_generated_by_monGrp (X : Type) (m : ℕ) :
    (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (m - 1) =
      Subgroup.closure {x : FreeGroup X | ∃ c : Magma X, Magma.size c = m ∧ x = monGrp X c} ⊔
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries m := by
  obtain rfl | hm := Nat.eq_zero_or_pos m
  · have h0 : monWeight X 0 = ⊥ := le_bot_iff.mp ((Subgroup.closure_le ⊥).2 (by
      rintro x ⟨c, hc, -⟩
      exact absurd hc (by have := Magma.size_pos c; omega)))
    change (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (0 - 1) =
      monWeight X 0 ⊔ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries 0
    rw [h0]
    simp
  · change (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (m - 1) = monSup X m
    have hle : (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (m - 1) ≤ monSup X m := by
      have h := lcs_le_monSup (X := X) (m - 1)
      have hidx : m - 1 + 1 = m := by omega
      rwa [hidx] at h
    have hge : monSup X m ≤ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (m - 1) := by
      refine sup_le (monWeight_le_lcs X (n := m) (by omega)) ?_
      exact Subgroup.lowerCentralSeries_antitone ⊤ (Nat.sub_le m 1)
    exact le_antisymm hle hge

end Work.SSGRoute.prop5
