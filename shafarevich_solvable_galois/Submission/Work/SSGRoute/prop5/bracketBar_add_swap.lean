namespace Work.SSGRoute.prop5

namespace graded

variable {G : Type*} [Group G]

/-- **The homogeneous case of the antisymmetry of the graded bracket.**  For `a ∈ Λ p` and
`b ∈ Λ q` the two brackets `⁅a, b⁆` and `⁅b, a⁆`, viewed in the direct sum `Λbar`, add up to zero.
This is `graded.bracketL_antisymm` together with `graded.lof_cast`, which transports the graded
piece `Λ (q+p+1)` to `Λ (p+q+1)`. -/
theorem bracketBar_lofL_add_swap (p q : ℕ) (a : LamAdd (G := G) p) (b : LamAdd (G := G) q) :
    bracketBar (G := G) (lofL (G := G) p a) (lofL (G := G) q b) +
      bracketBar (G := G) (lofL (G := G) q b) (lofL (G := G) p a) = 0 := by
  rw [bracketBar_lofL, bracketBar_lofL]
  have h : p + q + 1 = q + p + 1 := by omega
  have hb : lofL (G := G) (p + q + 1) (bracketL (G := G) p q a b) =
      -lofL (G := G) (q + p + 1) (bracketL (G := G) q p b a) := by
    rw [bracketL_antisymm h a b]
    simp only [map_neg]
    rw [lof_cast h]
  rw [hb, neg_add_cancel]

end graded

/-- **Bilinear antisymmetry of the graded bracket on the direct sum `Λbar = ⨁ k, Λ k`.**
For arbitrary `x y : Λbar` the two brackets sum to zero.  Since `bracketBar` is additive in each
variable, it suffices to check the homogeneous case `x = lof p a`, `y = lof q b`, where the bracket
of two classes is `bracketL p q a b` and antisymmetry of `bracketL` (available in the imported
module `gradedCast` as `graded.bracketL_antisymm`) provides
`bracketL p q a b + GLamCast h (bracketL q p b a) = 0`; the transport between the graded pieces
`Λ (p+q+1)` and `Λ (q+p+1)` is handled by `graded.lof_cast`. -/
theorem bracketBar_add_swap (G : Type*) [Group G]
    (x y : Work.SSGRoute.prop5.graded.Lbar G) :
    Work.SSGRoute.prop5.graded.bracketBar (G := G) x y +
      Work.SSGRoute.prop5.graded.bracketBar (G := G) y x = 0 := by
  -- It suffices to prove the claim when both variables are homogeneous: `Λbar` is generated by
  -- the images of the `lof`'s and `bracketBar` is additive in each variable.
  have hhom : ∀ (k : ℕ) (a : Work.SSGRoute.prop5.graded.LamAdd (G := G) k)
      (z : Work.SSGRoute.prop5.graded.Lbar G),
      Work.SSGRoute.prop5.graded.bracketBar (G := G) (Work.SSGRoute.prop5.graded.lofL k a) z +
        Work.SSGRoute.prop5.graded.bracketBar (G := G) z
          (Work.SSGRoute.prop5.graded.lofL k a) = 0 := by
    intro k a z
    refine DFinsupp.induction (p := fun z : Work.SSGRoute.prop5.graded.Lbar G =>
      Work.SSGRoute.prop5.graded.bracketBar (G := G) (Work.SSGRoute.prop5.graded.lofL k a) z +
        Work.SSGRoute.prop5.graded.bracketBar (G := G) z
          (Work.SSGRoute.prop5.graded.lofL k a) = 0) z ?_ ?_
    · simp
    · intro q b f hf hb ih
      simp only [map_add, AddMonoidHom.add_apply]
      rw [add_add_add_comm]
      change (Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.lofL k a) (Work.SSGRoute.prop5.graded.lofL q b) +
          Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.lofL q b) (Work.SSGRoute.prop5.graded.lofL k a)) +
          (Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.lofL k a) f +
          Work.SSGRoute.prop5.graded.bracketBar (G := G) f
            (Work.SSGRoute.prop5.graded.lofL k a)) = 0
      rw [Work.SSGRoute.prop5.graded.bracketBar_lofL_add_swap k q a b, ih, add_zero]
  refine DFinsupp.induction (p := fun x : Work.SSGRoute.prop5.graded.Lbar G =>
    Work.SSGRoute.prop5.graded.bracketBar (G := G) x y +
      Work.SSGRoute.prop5.graded.bracketBar (G := G) y x = 0) x ?_ ?_
  · simp
  · intro k a f hf hb ih
    simp only [map_add, AddMonoidHom.add_apply]
    rw [add_add_add_comm]
    change (Work.SSGRoute.prop5.graded.bracketBar (G := G)
          (Work.SSGRoute.prop5.graded.lofL k a) y +
        Work.SSGRoute.prop5.graded.bracketBar (G := G) y
          (Work.SSGRoute.prop5.graded.lofL k a)) +
        (Work.SSGRoute.prop5.graded.bracketBar (G := G) f y +
        Work.SSGRoute.prop5.graded.bracketBar (G := G) y f) = 0
    rw [hhom k a y, ih, add_zero]

end Work.SSGRoute.prop5
