/-!
# The `p`-central series is contained in `⟨x^{p^{i-1}}⟩ · [P, P]`

Schmidt–Wingberg's proof of Šafarevič's theorem needs the elementary fact that the descending
`p`-central series `P₁ = P`, `P_{i+1} = P_i^p [P_i, P]` is "almost" the series of subgroups
generated by the `p^{i-1}`-st powers: every `P_{i-1}` is contained in the subgroup generated by
the `p^{i-1}`-st powers of all elements, together with the derived subgroup `[P, P] = γ₂`.

Concretely, writing `A_k := ⟨x^{p^k} : x ∈ P⟩ · [P, P]` (an abbreviation for
`Work.Shrinking.powSubgroup (p ^ k) ⊤ ⊔ (⊤ : Subgroup P).lowerCentralSeries 1`), we prove
`pCentralSeries p P k ≤ A_k` for every `k`, by induction, the point being

* `[P_k, P] ≤ [P, P] = γ₂`, and
* `A_k^p ≤ A_{k+1}`, i.e. `x ∈ A_k ⇒ x^p ∈ A_{k+1}`.

The second statement is proved from two ingredients:
* for `x ∈ ⟨y^{p^k} : y⟩` the `p`-th power lands in `A_{k+1}` (induction over the generating set,
  using that `(uv)^p ≡ u^p v^p` modulo `γ₂`), and
* the same congruence handles an extra factor in `γ₂`.

The congruence `(u v)^p (u^p v^p)^{-1} ∈ γ₂` is proved by mapping to the abelianization, where
both sides agree.

No hypothesis on `p` is needed (it holds for `p = 1` and `p = 0` as well).
-/

set_option linter.unusedVariables false

namespace Work.SSGRoute.prop5

/-- Modulo the derived subgroup, `(u v)^n` and `u^n v^n` agree: their quotient is a commutator.
Proved by pushing the identity through the abelianization `Abelianization.of`, whose kernel is the
commutator subgroup. -/
private lemma mul_pow_mul_pow_inv_mem_lowerCentralSeries_one (n : ℕ) {P : Type} [Group P]
    (u v : P) : (u * v) ^ n * (u ^ n * v ^ n)⁻¹ ∈ (⊤ : Subgroup P).lowerCentralSeries 1 := by
  rw [Subgroup.top_lowerCentralSeries_one, ← Abelianization.ker_of, MonoidHom.mem_ker]
  simp [map_mul, map_pow, mul_pow]

/-- If `x` lies in the subgroup generated by the `p^k`-th powers of `P`, then `x^p` lies in
`⟨y^{p^{k+1}} : y⟩ · [P, P]`.

Proof by induction over the generating set of `⟨y^{p^k} : y⟩`: a generator `y^{p^k}` has
`p`-th power `y^{p^{k+1}}`; the statement is stable under inversion, and under products by the
congruence `mul_pow_mul_pow_inv_mem_lowerCentralSeries_one`. -/
private lemma pow_mem_powSubgroup_sup (p k : ℕ) {P : Type} [Group P] {x : P}
    (hx : x ∈ Work.Shrinking.powSubgroup (p ^ k) ⊤) :
    x ^ p ∈ Work.Shrinking.powSubgroup (p ^ (k + 1)) ⊤ ⊔
      (⊤ : Subgroup P).lowerCentralSeries 1 := by
  simp only [Work.Shrinking.powSubgroup] at hx ⊢
  refine Subgroup.closure_induction ?_ ?_ ?_ ?_ hx
  · rintro z ⟨y, -, rfl⟩
    apply Subgroup.mem_sup_left
    rw [← pow_mul, ← pow_succ]
    exact Subgroup.subset_closure ⟨y, Subgroup.mem_top y, rfl⟩
  · rw [one_pow]
    exact Subgroup.one_mem _
  · intro a b ha hb iha ihb
    have hkey : (a * b) ^ p =
        ((a * b) ^ p * (a ^ p * b ^ p)⁻¹) * (a ^ p * b ^ p) := by group
    rw [hkey]
    refine Subgroup.mul_mem _ (Subgroup.mem_sup_right ?_) (Subgroup.mul_mem _ iha ihb)
    exact mul_pow_mul_pow_inv_mem_lowerCentralSeries_one p a b
  · intro a ha iha
    rw [inv_pow]
    exact Subgroup.inv_mem _ iha

/-- The `p`-th power of an element of `⟨y^{p^k} : y⟩ · [P, P]` lies in
`⟨y^{p^{k+1}} : y⟩ · [P, P]`. -/
private lemma sup_pow_mem (p k : ℕ) {P : Type} [Group P] {x : P}
    (hx : x ∈ Work.Shrinking.powSubgroup (p ^ k) ⊤ ⊔ (⊤ : Subgroup P).lowerCentralSeries 1) :
    x ^ p ∈ Work.Shrinking.powSubgroup (p ^ (k + 1)) ⊤ ⊔
      (⊤ : Subgroup P).lowerCentralSeries 1 := by
  set C := Work.Shrinking.powSubgroup (p ^ (k + 1)) ⊤ ⊔
    (⊤ : Subgroup P).lowerCentralSeries 1 with hC
  obtain ⟨u, hu, v, hv, huv⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := Work.Shrinking.powSubgroup (p ^ k) ⊤)
      (t := (⊤ : Subgroup P).lowerCentralSeries 1)).mp hx
  rw [← huv]
  have hu' : u ^ p ∈ C := pow_mem_powSubgroup_sup p k hu
  have hvC : v ∈ C := Subgroup.mem_sup_right hv
  have hv' : v ^ p ∈ C := Subgroup.pow_mem C hvC p
  have hkey : (u * v) ^ p =
      ((u * v) ^ p * (u ^ p * v ^ p)⁻¹) * (u ^ p * v ^ p) := by group
  rw [hkey]
  refine Subgroup.mul_mem _ (Subgroup.mem_sup_right ?_) (Subgroup.mul_mem _ hu' hv')
  exact mul_pow_mul_pow_inv_mem_lowerCentralSeries_one p u v

/-- The main auxiliary statement: `pCentralSeries p P k ≤ ⟨y^{p^k} : y⟩ · [P, P]`.

Induction on `k`.  Since `pCentralSeries p P (k+1) = (P_k)^p [P_k, P]`, the commutator part is
contained in `[P, P] = γ₂`, while the power part is handled by `sup_pow_mem` together with the
induction hypothesis `P_k ≤ ⟨y^{p^k} : y⟩ · [P, P]`. -/
private lemma pCentralSeries_le_powSubgroup_sup (p : ℕ) (P : Type) [Group P] (k : ℕ) :
    Work.Shrinking.pCentralSeries p P k ≤
      Work.Shrinking.powSubgroup (p ^ k) ⊤ ⊔ (⊤ : Subgroup P).lowerCentralSeries 1 := by
  induction k with
  | zero =>
      rw [Work.Shrinking.pCentralSeries_zero]
      intro y _
      apply Subgroup.mem_sup_left
      rw [Work.Shrinking.powSubgroup]
      exact Subgroup.subset_closure ⟨y, Subgroup.mem_top y, by simp⟩
  | succ k ih =>
      rw [Work.Shrinking.pCentralSeries_succ]
      unfold Work.Shrinking.pCentralStep
      apply sup_le
      · rw [Work.Shrinking.powSubgroup]
        rw [Subgroup.closure_le]
        rintro z ⟨y, hy, rfl⟩
        exact sup_pow_mem p k (ih hy)
      · have h : ⁅(⊤ : Subgroup P), ⊤⁆ = (⊤ : Subgroup P).lowerCentralSeries 1 := by
          rw [Subgroup.top_lowerCentralSeries_one, _root_.commutator_def]
        apply le_trans (Subgroup.commutator_mono (le_top) le_rfl)
        rw [h]
        exact le_sup_right

/-- **Shafarevich, solvable Galois groups — reduction step.**  The `(i-1)`-st member of the
descending `p`-central series of `P` is contained in the subgroup generated by the
`p^{i-1}`-st powers of all elements, together with the derived subgroup `[P, P]`. -/
theorem pCentralSeries_le_pow_sup_commutator (p : ℕ) {P : Type} [Group P] (i : ℕ) (hi : 1 ≤ i) :
    Work.Shrinking.pCentralSeries p P (i - 1) ≤
      Subgroup.closure {x : P | ∃ y : P, x = y ^ (p ^ (i - 1))}
        ⊔ (⊤ : Subgroup P).lowerCentralSeries 1 := by
  refine le_trans (pCentralSeries_le_powSubgroup_sup p P (i - 1)) ?_
  apply sup_le_sup _ le_rfl
  rw [Work.Shrinking.powSubgroup]
  apply Subgroup.closure_mono
  rintro z ⟨y, -, rfl⟩
  exact ⟨y, rfl⟩

end Work.SSGRoute.prop5
