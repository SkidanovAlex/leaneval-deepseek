namespace Work.SSGRoute.prop5

open scoped commutatorElement

/-!
# The lower central series is generated by the nested commutator words

In `Basic.lean` we proved that each `j`-fold left-nested commutator `commWord j x` lies in the
`(j-1)`-st term of the lower central series (`commWord_mem_lowerCentralSeries`).  Here we prove the
converse inclusion: `γ_{j-1}` is *generated* by the values of `commWord j`.

The proof is an induction on `j = m + 1` of the statement `γ_m(G) ≤ C_{m+1}(G)`, where
`C_k(G) = closure {commWord k x | x : Fin k → G}`.

The key point of the induction step is that the subgroups `C_k` are normal (conjugation permutes the
commutator words: `(commWord k x)^g = commWord k (x^g)`), so we may form the quotient
`Q = G ⧸ C_{m+2}(G)`.  In `Q` every `(m+2)`-fold commutator word is trivial; consequently every
`(m+1)`-fold commutator word `w` satisfies `⁅a, w⁆ = commWord (m+2) (Fin.cons a y) = 1`, i.e. `w` is
central.  Hence `C_{m+1}(Q) ≤ Z(Q)`, and by the induction hypothesis `γ_m(Q) ≤ C_{m+1}(Q) ≤ Z(Q)`.
Therefore `γ_{m+1}(Q) = ⁅γ_m(Q), Q⁆ = ⊥`, which says exactly `γ_{m+1}(G) ≤ C_{m+2}(G)`.
-/

/-- `commWordClosure k G` is the subgroup of `G` generated by the values of the `k`-fold nested
commutator word `commWord k`. -/
def commWordClosure (k : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {y : G | ∃ x : Fin k → G, y = commWord k x}

/-! ## Two elementary compatibilities of `commWord` -/

/-- `commWord` commutes with group homomorphisms. -/
lemma map_commWord {G H : Type*} [Group G] [Group H] (f : G →* H) (k : ℕ) (x : Fin k → G) :
    f (commWord k x) = commWord k (fun i => f (x i)) := by
  induction k using Nat.strong_induction_on with
  | _ k ih =>
    match k, x with
    | 0, x => simp
    | 1, x => simp
    | (m+2), x =>
      rw [commWord_succ_succ, commWord_succ_succ, map_commutatorElement]
      congr 1
      exact ih (m+1) (by omega) (fun t => x t.succ)

/-- Conjugation acts on the nested commutator word by conjugating every letter. -/
lemma conj_commWord {G : Type*} [Group G] (k : ℕ) (x : Fin k → G) (g : G) :
    g * commWord k x * g⁻¹ = commWord k (fun i => g * x i * g⁻¹) := by
  induction k using Nat.strong_induction_on generalizing g with
  | _ k ih =>
    match k, x with
    | 0, x => simp [commWord]
    | 1, x => simp [commWord]
    | (m+2), x =>
      rw [commWord_succ_succ, commWord_succ_succ, commutatorElement_def, commutatorElement_def]
      rw [← ih (m+1) (by omega) (fun t => x t.succ) g]
      group

/-! ## Normality of `commWordClosure` -/

/-- A generating set closed under conjugation generates a normal subgroup. -/
lemma closure_normal_of_conj_invariant {G : Type*} [Group G] {s : Set G}
    (hs : ∀ g : G, ∀ y ∈ s, g * y * g⁻¹ ∈ s) : (Subgroup.closure s).Normal where
  conj_mem n hn g := by
    induction hn using Subgroup.closure_induction with
    | mem y hy => exact Subgroup.subset_closure (hs g y hy)
    | one => simp
    | mul a b _ _ iha ihb =>
        have h : g * (a * b) * g⁻¹ = (g * a * g⁻¹) * (g * b * g⁻¹) := by group
        rw [h]
        exact Subgroup.mul_mem _ iha ihb
    | inv a _ iha =>
        have h : g * a⁻¹ * g⁻¹ = (g * a * g⁻¹)⁻¹ := by group
        rw [h]
        exact Subgroup.inv_mem _ iha

/-- The subgroup generated by the `k`-fold commutator words is normal. -/
instance commWordClosure_normal (k : ℕ) (G : Type*) [Group G] : (commWordClosure k G).Normal :=
  closure_normal_of_conj_invariant (fun g y hy => by
    obtain ⟨x, rfl⟩ := hy
    exact ⟨fun i => g * x i * g⁻¹, conj_commWord k x g⟩)

/-! ## The main induction -/

/-- The `m`-th term of the lower central series is contained in the subgroup generated by the
`(m+1)`-fold commutator words. -/
theorem lowerCentralSeries_le_commWordClosure :
    ∀ (m : ℕ) (G : Type*) [Group G],
      (⊤ : Subgroup G).lowerCentralSeries m ≤ commWordClosure (m+1) G := by
  intro m
  induction m with
  | zero =>
    intro G _
    rw [Subgroup.lowerCentralSeries_zero]
    intro y _
    exact Subgroup.subset_closure ⟨fun _ => y, by simp⟩
  | succ m ih =>
    intro G _
    -- every `(m+2)`-fold commutator word is trivial in `Q = G ⧸ C_{m+2}(G)`
    have hvan : ∀ x' : Fin (m+2) → (G ⧸ commWordClosure (m+2) G), commWord (m+2) x' = 1 := by
      intro x'
      choose x hx using fun i => QuotientGroup.mk'_surjective (commWordClosure (m+2) G) (x' i)
      have hfun : (fun i => QuotientGroup.mk' (commWordClosure (m+2) G) (x i)) = x' := funext hx
      rw [← hfun, ← map_commWord (QuotientGroup.mk' (commWordClosure (m+2) G)) (m+2) x]
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact Subgroup.subset_closure ⟨x, rfl⟩
    -- hence every `(m+1)`-fold commutator word is central in `Q`
    have hcen : ∀ y : Fin (m+1) → (G ⧸ commWordClosure (m+2) G),
        commWord (m+1) y ∈ Subgroup.center (G ⧸ commWordClosure (m+2) G) := by
      intro y
      rw [Subgroup.mem_center_iff]
      intro a
      have h1 : ⁅a, commWord (m+1) y⁆ = 1 := by
        have hz := hvan (Fin.cons a y)
        simpa [commWord_succ_succ, Fin.cons_zero, Fin.tail_cons] using hz
      exact commutatorElement_eq_one_iff_mul_comm.mp h1
    have hclosure : commWordClosure (m+1) (G ⧸ commWordClosure (m+2) G) ≤
        Subgroup.center (G ⧸ commWordClosure (m+2) G) :=
      (Subgroup.closure_le (Subgroup.center (G ⧸ commWordClosure (m+2) G))).mpr (fun w hw => by
        obtain ⟨y, rfl⟩ := hw
        exact hcen y)
    -- the induction hypothesis puts `γ_m(Q)` inside `C_{m+1}(Q)` and hence inside the centre
    have hgmQ : (⊤ : Subgroup (G ⧸ commWordClosure (m+2) G)).lowerCentralSeries m ≤
        Subgroup.center (G ⧸ commWordClosure (m+2) G) :=
      le_trans (ih (G ⧸ commWordClosure (m+2) G)) hclosure
    -- therefore `γ_{m+1}(Q)` is trivial
    have hbot : (⊤ : Subgroup (G ⧸ commWordClosure (m+2) G)).lowerCentralSeries (m+1) = ⊥ := by
      rw [Subgroup.lowerCentralSeries_succ]
      apply le_bot_iff.mp
      rw [Subgroup.commutator_le]
      intro a ha b _
      rw [Subgroup.mem_bot, commutatorElement_eq_one_iff_mul_comm]
      exact ((Subgroup.mem_center_iff.mp (hgmQ ha)) b).symm
    -- transport back along the quotient map `G → Q`
    have hmap : Subgroup.map (QuotientGroup.mk' (commWordClosure (m+2) G))
        ((⊤ : Subgroup G).lowerCentralSeries (m+1)) = ⊥ := by
      rw [Subgroup.map_lowerCentralSeries]
      rw [Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
      exact hbot
    have hle : (⊤ : Subgroup G).lowerCentralSeries (m+1) ≤ commWordClosure (m+2) G := by
      have := (Subgroup.map_eq_bot_iff ((⊤ : Subgroup G).lowerCentralSeries (m+1))).mp hmap
      rwa [QuotientGroup.ker_mk'] at this
    exact hle

theorem lowerCentralSeries_le_closure_commWord {P : Type*} [Group P] (j : ℕ) (hj : 1 ≤ j) :
    (⊤ : Subgroup P).lowerCentralSeries (j - 1) ≤
      Subgroup.closure {y : P | ∃ x : Fin j → P, y = commWord j x} := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  simpa [commWordClosure] using lowerCentralSeries_le_commWordClosure m P

end Work.SSGRoute.prop5
