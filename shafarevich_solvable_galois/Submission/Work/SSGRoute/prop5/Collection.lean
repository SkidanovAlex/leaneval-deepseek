open scoped commutatorElement

namespace Work.SSGRoute.prop5

section Collection

variable {P : Type} [Group P]

/-- The subgroup generated by the `j`-fold nested commutator words is contained in `γ_j`. -/
lemma commWordClosure_le_lcs (j : ℕ) :
    Subgroup.closure {y : P | ∃ x : Fin j → P, y = commWord j x} ≤
      (⊤ : Subgroup P).lowerCentralSeries (j - 1) := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro y ⟨x, rfl⟩
  exact commWord_mem_lowerCentralSeries j x

/-- **Collection of `q`-th powers**: the `q`-th powers of the elements of `γ_j` lie in the
subgroup generated by the `q`-th powers of the `j`-fold nested commutator words, modulo `γ_{j+1}`. -/
theorem commWordClosure_pow_le (j q : ℕ) (hj : 1 ≤ j) :
    Subgroup.closure {y : P | ∃ z ∈ (⊤ : Subgroup P).lowerCentralSeries (j - 1), y = z ^ q} ≤
      Subgroup.closure {y : P | ∃ x : Fin j → P, y = (commWord j x) ^ q} ⊔
        (⊤ : Subgroup P).lowerCentralSeries j := by
  set W := Subgroup.closure {y : P | ∃ x : Fin j → P, y = (commWord j x) ^ q} with hW
  set G1 := (⊤ : Subgroup P).lowerCentralSeries j with hG1
  have key : ∀ z ∈ Subgroup.closure {y : P | ∃ x : Fin j → P, y = commWord j x},
      z ^ q ∈ W ⊔ G1 := by
    intro z hz
    induction hz using Subgroup.closure_induction with
    | mem y hy =>
        obtain ⟨x, rfl⟩ := hy
        exact Subgroup.mem_sup_left (Subgroup.subset_closure ⟨x, rfl⟩)
    | one => simp
    | mul a b ha hb iha ihb =>
        have haj : a ∈ (⊤ : Subgroup P).lowerCentralSeries (j - 1) :=
          commWordClosure_le_lcs j ha
        have hbj : b ∈ (⊤ : Subgroup P).lowerCentralSeries (j - 1) :=
          commWordClosure_le_lcs j hb
        have hd : (a * b) ^ q * ((b ^ q) * (a ^ q))⁻¹ ∈ G1 :=
          mul_pow_mem_lowerCentralSeries P j q hj a b haj hbj
        have hba : (b ^ q) * (a ^ q) ∈ W ⊔ G1 := Subgroup.mul_mem _ ihb iha
        have heq : (a * b) ^ q
            = ((a * b) ^ q * ((b ^ q) * (a ^ q))⁻¹) * ((b ^ q) * (a ^ q)) := by
          group
        rw [heq]
        exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hd) hba
    | inv a ha iha => simpa [inv_pow] using Subgroup.inv_mem _ iha
  refine (Subgroup.closure_le _).mpr ?_
  rintro y ⟨z, hz, rfl⟩
  exact key z (lowerCentralSeries_le_closure_commWord j hj hz)

end Collection

end Work.SSGRoute.prop5
