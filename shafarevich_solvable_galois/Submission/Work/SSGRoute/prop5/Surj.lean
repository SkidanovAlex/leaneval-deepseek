/-! ## The group-theoretic reduction -/

/-- **Lemma 4(ii) of Schmidt–Wingberg, in the form used for surjectivity**: every element of
`F_i ∩ γ_j` lies in the subgroup generated by the `p^{i-j}`-th powers of the `j`-fold nested
commutator words, *modulo* the next refined term `F_{(i,j)+1}`. -/
theorem pSeries_inter_lcs_le_commWordPow_sup (p : ℕ) [Fact p.Prime] (X : Type) [Fintype X]
    (i j : ℕ) (hj : 1 ≤ j) (hji : j ≤ i) :
    Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) ⊓
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) ≤
      Subgroup.closure {y : FreeGroup X | ∃ x : Fin j → FreeGroup X,
          y = (commWord j x) ^ (p ^ (i - j))} ⊔
      Work.CohomologicalShrinking.refinedTerm p (FreeGroup X)
        (Work.CohomologicalShrinking.tauSucc i j).1
        (Work.CohomologicalShrinking.tauSucc i j).2 := by
  intro a ha
  obtain ⟨haP, hag⟩ := Subgroup.mem_inf.mp ha
  haveI hnormγ : ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j).Normal := lcsNormal _ j
  -- the collection step
  have hcoll := commWordClosure_pow_le (P := FreeGroup X) j (p ^ (i - j)) hj
  -- `W ≤ P_i`
  have hWPi : Subgroup.closure {y : FreeGroup X | ∃ x : Fin j → FreeGroup X,
      y = (commWord j x) ^ (p ^ (i - j))} ≤
      Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) := by
    refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨x, rfl⟩
    have hmem := pow_mem_pSeries p j (i - j) hj (commWord j x)
      (commWord_mem_lowerCentralSeries j x)
    have hidx : j + (i - j) - 1 = i - 1 := by omega
    rwa [hidx] at hmem
  -- Lemma 4(ii)
  have haT : a ∈ (Subgroup.closure {y : FreeGroup X |
        ∃ z ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1),
          y = z ^ (p ^ (i - j))} ⊔
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j) ⊔
      Work.Shrinking.pCentralSeries p (FreeGroup X) i :=
    pSeries_inter_centralSeries p X i j hj hji ⟨haP, hag⟩
  rw [Subgroup.mem_sup_of_normal_right] at haT
  obtain ⟨w, hw, u, hu, hwu⟩ := haT
  rw [Subgroup.mem_sup_of_normal_right] at hw
  obtain ⟨g, hg, k, hk, hgk⟩ := hw
  -- `g * k = a * u⁻¹ ∈ P_i`
  have hgkP : g * k ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) := by
    have heq : g * k = a * u⁻¹ := by rw [hgk, ← hwu]; group
    rw [heq]
    exact Subgroup.mul_mem _ haP (Subgroup.inv_mem _
      (Work.Shrinking.pCentralSeries_antitone p (FreeGroup X) (Nat.sub_le i 1) hu))
  -- `g ∈ W ⊔ γ_{j+1}`
  have hgW := hcoll hg
  rw [Subgroup.mem_sup_of_normal_right] at hgW
  obtain ⟨w', hw', k', hk', hw'k'⟩ := hgW
  -- `k' * k ∈ P_i`
  have hkk'P : k' * k ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) := by
    have heq : k' * k = w'⁻¹ * (g * k) := by rw [← hw'k']; group
    rw [heq]
    exact Subgroup.mul_mem _ (Subgroup.inv_mem _ (hWPi hw')) hgkP
  -- `k' * k ∈ γ_{j+1}`
  have hkk'γ : k' * k ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j :=
    Subgroup.mul_mem _ hk' hk
  -- `k' * k ∈ F_{(i,j)+1}`
  have hkk'R : k' * k ∈ Work.CohomologicalShrinking.refinedTerm p (FreeGroup X)
      (Work.CohomologicalShrinking.tauSucc i j).1
      (Work.CohomologicalShrinking.tauSucc i j).2 := by
    rcases lt_or_ge j i with hlt | hge
    · rw [Work.CohomologicalShrinking.tauSucc_of_lt hlt,
        Work.CohomologicalShrinking.refinedTerm]
      exact Subgroup.mem_sup_left (Subgroup.mem_inf.mpr ⟨hkk'P, hkk'γ⟩)
    · have hji' : j = i := le_antisymm hji hge
      have hsucc : Work.CohomologicalShrinking.tauSucc i j = (i + 1, 1) := by
        rw [hji']
        exact Work.CohomologicalShrinking.tauSucc_of_le (le_refl i)
      rw [hsucc, Work.CohomologicalShrinking.refinedTerm_one]
      exact Work.ProP.lowerCentralSeries_le_pCentralSeries p (FreeGroup X) i
        (by rwa [hji'] at hkk'γ)
  -- `u ∈ F_{(i,j)+1}`
  have huR : u ∈ Work.CohomologicalShrinking.refinedTerm p (FreeGroup X)
      (Work.CohomologicalShrinking.tauSucc i j).1
      (Work.CohomologicalShrinking.tauSucc i j).2 :=
    Work.CohomologicalShrinking.pSeries_succ_le_refinedTerm_succ (P := FreeGroup X) p i j hu
  -- assembly
  have haeq : a = w' * ((k' * k) * u) := by rw [← hwu, ← hgk, ← hw'k']; group
  rw [haeq]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hw')
    (Subgroup.mul_mem _ (Subgroup.mem_sup_right hkk'R) (Subgroup.mem_sup_right huR))


/-! ## Surjectivity of `θ` -/

section Surjectivity

variable (p : ℕ) [Fact p.Prime] (G : Type) [Group G] [Fintype G]
  (i j d : ℕ) (hj : 1 ≤ j) (hji : j ≤ i)

/-- The refined term `F(d)_{(i,j)}`. -/
abbrev RT (p : ℕ) (G : Type) [Group G] (i j d : ℕ) :
    Subgroup (Work.Shrinking.freeOperatorGroup G d) :=
  Work.CohomologicalShrinking.refinedTerm p (Work.Shrinking.freeOperatorGroup G d) i j

/-- The next refined term `F(d)_{(i,j)+1}`. -/
abbrev RTn (p : ℕ) (G : Type) [Group G] (i j d : ℕ) :
    Subgroup (Work.Shrinking.freeOperatorGroup G d) :=
  Work.CohomologicalShrinking.refinedTerm p (Work.Shrinking.freeOperatorGroup G d)
    (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2

/-- The subgroup generated by the values of `(commWord j x)^(p^(i-j))`. -/
abbrev WPow (p : ℕ) (G : Type) [Group G] (i j d : ℕ) :
    Subgroup (Work.Shrinking.freeOperatorGroup G d) :=
  Subgroup.closure {y : Work.Shrinking.freeOperatorGroup G d |
    ∃ x : Fin j → Work.Shrinking.freeOperatorGroup G d,
      y = (commWord j x) ^ (p ^ (i - j))}

/-- The class of an element of `F(d)_{(i,j)}` in the graded piece `E(d,τ)`. -/
def cls (x : Work.Shrinking.freeOperatorGroup G d) (hx : x ∈ RT p G i j d) : E p G d i j :=
  Additive.ofMul (QuotientGroup.mk' ((RTn p G i j d).subgroupOf (RT p G i j d)) ⟨x, hx⟩)

lemma cls_ext {x : Work.Shrinking.freeOperatorGroup G d} (h1 h2 : x ∈ RT p G i j d) :
    cls p G i j d x h1 = cls p G i j d x h2 := by
  unfold cls
  rw [show (⟨x, h1⟩ : RT p G i j d) = ⟨x, h2⟩ from Subtype.ext rfl]

/-- On the class of a tuple of group elements, `θ` is the paper's value map. -/
lemma valFn_eq_cls (x : Fin j → Work.Shrinking.freeOperatorGroup G d) :
    valFn p G i j d hj hji x
      = cls p G i j d ((commWord j x) ^ (p ^ (i - j)))
          (commWord_pow_mem_refinedTerm p G i j d hj hji x) := by
  rw [valFn_eq]
  unfold valFnOf cls
  simp only [QuotientGroup.mk'_apply]

lemma cls_eq_of_eq {x y : Work.Shrinking.freeOperatorGroup G d} (heq : x = y)
    (hx : x ∈ RT p G i j d) (hy : y ∈ RT p G i j d) :
    cls p G i j d x hx = cls p G i j d y hy := by
  subst heq
  exact cls_ext p G i j d hx hy

lemma cls_mul {x y : Work.Shrinking.freeOperatorGroup G d} (hx : x ∈ RT p G i j d)
    (hy : y ∈ RT p G i j d) (hxy : x * y ∈ RT p G i j d) :
    cls p G i j d (x * y) hxy = cls p G i j d x hx + cls p G i j d y hy := by
  unfold cls
  rw [show (⟨x * y, hxy⟩ : RT p G i j d) = ⟨x, hx⟩ * ⟨y, hy⟩ from Subtype.ext rfl,
    map_mul, ofMul_mul]

/-- The class of an element of the next refined term is `0`. -/
lemma cls_zero_of_mem {x : Work.Shrinking.freeOperatorGroup G d} (hx : x ∈ RTn p G i j d)
    (hQ : x ∈ RT p G i j d) : cls p G i j d x hQ = 0 := by
  unfold cls
  rw [show QuotientGroup.mk' ((RTn p G i j d).subgroupOf (RT p G i j d))
      (⟨x, hQ⟩ : RT p G i j d) = 1 from by
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    exact hx]
  exact ofMul_one

/-- `W ≤ F(d)_{(i,j)}`. -/
lemma WPow_le_RT (hj : 1 ≤ j) (hji : j ≤ i) : WPow p G i j d ≤ RT p G i j d := by
  refine (Subgroup.closure_le _).mpr ?_
  rintro y ⟨x, rfl⟩
  exact commWord_pow_mem_refinedTerm p G i j d hj hji x

/-- The next refined term is contained in the current one. -/
lemma RTn_le_RT (hj : 1 ≤ j) (hji : j ≤ i) : RTn p G i j d ≤ RT p G i j d := by
  rcases lt_or_ge j i with hlt | hge
  · rw [RTn, RT, Work.CohomologicalShrinking.tauSucc_of_lt hlt]
    exact Work.CohomologicalShrinking.refinedTerm_antitone_snd p _ i j
  · have hji' : j = i := le_antisymm hji hge
    have hsucc : Work.CohomologicalShrinking.tauSucc i j = (i + 1, 1) := by
      rw [hji']
      exact Work.CohomologicalShrinking.tauSucc_of_le (le_refl i)
    rw [RTn, hsucc, Work.CohomologicalShrinking.refinedTerm_one, RT,
      Work.CohomologicalShrinking.refinedTerm]
    exact le_sup_right

/-- **Surjectivity of `θ`.** The graded piece `E(d,τ)` is generated by the images of the
`p^{i-j}`-th powers of the `j`-fold nested commutator words. -/
theorem thetaLin_surjective : Function.Surjective (thetaLin p G i j d hj hji) := by
  have hle : WPow p G i j d ≤ RT p G i j d := WPow_le_RT p G i j d hj hji
  suffices h : ∀ (x : Work.Shrinking.freeOperatorGroup G d) (hx : x ∈ RT p G i j d),
      cls p G i j d x hx ∈ LinearMap.range (thetaLin p G i j d hj hji) by
    intro z
    obtain ⟨q, hq⟩ := QuotientGroup.mk'_surjective _ (Additive.toMul z)
    obtain ⟨Y, hY⟩ := h (q : Work.Shrinking.freeOperatorGroup G d) q.2
    refine ⟨Y, ?_⟩
    rw [hY]
    show cls p G i j d (q : Work.Shrinking.freeOperatorGroup G d) q.2 = z
    unfold cls
    rw [show (⟨(q : Work.Shrinking.freeOperatorGroup G d), q.2⟩ : RT p G i j d) = q
      from Subtype.ext rfl, hq]
    exact ofMul_toMul z
  intro x hx
  -- (1) the class of an element of `W` is in the range
  have hWrange : ∀ (w : Work.Shrinking.freeOperatorGroup G d) (hw : w ∈ WPow p G i j d),
      cls p G i j d w (hle hw) ∈ LinearMap.range (thetaLin p G i j d hj hji) := by
    intro w hw
    induction hw using Subgroup.closure_induction with
    | mem y hy =>
        obtain ⟨x, rfl⟩ := hy
        refine ⟨PiTensorProduct.tprod (ZMod p) (fun k => qmk p G d (x k)), ?_⟩
        rw [thetaLin_tprod_qmk]
        rw [show cls p G i j d ((commWord j x) ^ (p ^ (i - j)))
              (hle (Subgroup.subset_closure ⟨x, rfl⟩))
            = cls p G i j d ((commWord j x) ^ (p ^ (i - j)))
              (commWord_pow_mem_refinedTerm p G i j d hj hji x) from cls_ext p G i j d _ _]
        exact (valFn_eq_cls p G i j d hj hji x).symm
    | one =>
        refine ⟨0, ?_⟩
        rw [map_zero]
        show cls p G i j d 1 (hle (Subgroup.one_mem _)) = 0
        exact cls_zero_of_mem p G i j d (Subgroup.one_mem _) (hle (Subgroup.one_mem _))
    | mul a b ha hb iha ihb =>
        obtain ⟨Y1, hY1⟩ := iha
        obtain ⟨Y2, hY2⟩ := ihb
        refine ⟨Y1 + Y2, ?_⟩
        rw [map_add, hY1, hY2]
        exact (cls_mul p G i j d (hle ha) (hle hb)
          (hle (Subgroup.mul_mem _ ha hb))).symm
    | inv a ha iha =>
        obtain ⟨Y, hY⟩ := iha
        refine ⟨-Y, ?_⟩
        rw [map_neg, hY]
        have hmul := cls_mul p G i j d (hle (Subgroup.inv_mem _ ha)) (hle ha)
          (hle (Subgroup.mul_mem _ (Subgroup.inv_mem _ ha) ha))
        have hone : cls p G i j d (a⁻¹ * a)
            (hle (Subgroup.mul_mem _ (Subgroup.inv_mem _ ha) ha)) = 0 := by
          rw [cls_eq_of_eq p G i j d (inv_mul_cancel a)
            (hle (Subgroup.mul_mem _ (Subgroup.inv_mem _ ha) ha))
            (hle (Subgroup.one_mem _))]
          exact cls_zero_of_mem p G i j d (Subgroup.one_mem _) (hle (Subgroup.one_mem _))
        rw [hone] at hmul
        exact (eq_neg_of_add_eq_zero_left hmul.symm).symm
  -- (2) decompose `x ∈ F(d)_{(i,j)} = (F_i ∩ F^j) F_{i+1}`
  rw [RT, Work.CohomologicalShrinking.refinedTerm] at hx
  rw [Subgroup.mem_sup_of_normal_right] at hx
  obtain ⟨a, ha, u, hu, hau⟩ := hx
  obtain ⟨haP, hag⟩ := Subgroup.mem_inf.mp ha
  -- (3) Lemma 4(ii) + collection: `a ∈ W · F(d)_{(i,j)+1}`
  have hcrux := pSeries_inter_lcs_le_commWordPow_sup p (Fin d × G) i j hj hji ⟨haP, hag⟩
  rw [Subgroup.mem_sup_of_normal_right] at hcrux
  obtain ⟨w, hw, r, hr, hwr⟩ := hcrux
  have huR : u ∈ RTn p G i j d :=
    Work.CohomologicalShrinking.pSeries_succ_le_refinedTerm_succ
      (P := Work.Shrinking.freeOperatorGroup G d) p i j hu
  have hruR : r * u ∈ RTn p G i j d := Subgroup.mul_mem (RTn p G i j d) hr huR
  have hwRT : w ∈ RT p G i j d := hle hw
  have hruRT : r * u ∈ RT p G i j d := RTn_le_RT p G i j d hj hji hruR
  -- (4) assemble
  rw [cls_eq_of_eq p G i j d (show x = w * (r * u) by rw [← hau, ← hwr]; group) hx
      (Subgroup.mul_mem _ hwRT hruRT),
    cls_mul p G i j d hwRT hruRT (Subgroup.mul_mem _ hwRT hruRT),
    cls_zero_of_mem p G i j d hruR hruRT, add_zero]
  exact hWrange w hw

end Surjectivity

end

