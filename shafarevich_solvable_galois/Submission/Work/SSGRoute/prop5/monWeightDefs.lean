/-!
# The subgroup generated by the commutator monomials of a fixed weight

For a free group `F = FreeGroup X` and a natural number `n`, the classical generation statement for
the associated graded of the lower central series says that the classes of the commutator monomials
`monGrp X c` with `c` a binary tree of `n` leaves generate `γ_{n-1}/γ_n`.  The subgroup they
generate inside `F` itself is `monWeight X n`; the generation statement is

`γ_{n-1} = monWeight X n ⊔ γ_n`  (`lcs_generated_by_monGrp`).

This file collects the definition and the elementary facts about `monWeight` that are used in the
proof, together with the two standard element level commutator lemmas (weight additivity and the
conjugation error term) that the argument needs.
-/

noncomputable section

open scoped commutatorElement

namespace Work.SSGRoute.prop5

variable {X : Type*}

/-- `monWeight X n` is the subgroup of `FreeGroup X` generated by the commutator monomials
`monGrp X c` attached to the binary trees `c` with exactly `n` leaves. -/
def monWeight (X : Type) (n : ℕ) : Subgroup (FreeGroup X) :=
  Subgroup.closure {x : FreeGroup X | ∃ c : Magma X, Magma.size c = n ∧ x = monGrp X c}

/-- Every commutator monomial of weight `n` lies in `monWeight X n`. -/
theorem monGrp_mem_monWeight (X : Type) (c : Magma X) :
    monGrp X c ∈ monWeight X (Magma.size c) :=
  Subgroup.subset_closure ⟨c, rfl, rfl⟩

/-- A tree of size one is a generator. -/
theorem eq_gen_of_size_eq_one {c : Magma X} (hc : Magma.size c = 1) : ∃ x : X, c = Magma.gen x := by
  cases c with
  | gen x => exact ⟨x, rfl⟩
  | mul a b =>
      rw [Magma.size_mul] at hc
      have ha := Magma.size_pos a
      have hb := Magma.size_pos b
      omega

/-- The commutator monomials of weight `n` lie in the `(n-1)`-st term of the lower central
series. -/
theorem monWeight_le_lcs (X : Type) {n : ℕ} (hn : 1 ≤ n) :
    monWeight X n ≤ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (n - 1) := by
  refine (Subgroup.closure_le _).2 ?_
  rintro x ⟨c, hc, rfl⟩
  have h := monGrp_mem_lowerCentralSeries c
  rw [hc] at h
  exact h

/-- The commutator monomials of weight one generate the whole free group: they are the free
generators. -/
theorem monWeight_one_eq_top (X : Type) : monWeight X 1 = ⊤ := by
  have hset : {x : FreeGroup X | ∃ c : Magma X, Magma.size c = 1 ∧ x = monGrp X c}
      = Set.range (FreeGroup.of : X → FreeGroup X) := by
    ext x
    constructor
    · rintro ⟨c, hc, rfl⟩
      obtain ⟨y, rfl⟩ := eq_gen_of_size_eq_one hc
      exact ⟨y, rfl⟩
    · rintro ⟨y, rfl⟩
      exact ⟨Magma.gen y, rfl, rfl⟩
  show Subgroup.closure {x : FreeGroup X | ∃ c : Magma X, Magma.size c = 1 ∧ x = monGrp X c} = ⊤
  rw [hset, FreeGroup.closure_range_of X]

/-- **Weight additivity.**  A commutator of an element of `γ_p` and an element of `γ_q` lies in
`γ_{p+q+1}`. -/
theorem commutator_mem_lcs (X : Type) {p q : ℕ} {a b : FreeGroup X}
    (ha : a ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries p)
    (hb : b ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries q) :
    ⁅a, b⁆ ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (p + q + 1) :=
  graded.commutator_mem_Gam ha hb

/-- Conjugation by an element of `γ_k` moves an element of `γ_m` by an element of `γ_{k+m+1}`. -/
theorem conj_mul_inv_mem_lcs (X : Type) {k m : ℕ} {u v : FreeGroup X}
    (hu : u ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries m)
    (hv : v ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries k) :
    v * u * v⁻¹ * u⁻¹ ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (k + m + 1) :=
  commutator_mem_lcs X hv hu

end Work.SSGRoute.prop5
