/-!
# The augmentation-ideal filtration refines the Magnus (word-length) filtration

Let `F = FreeGroup X`, `Δ ⊆ ℤ[F]` the augmentation ideal (the ideal generated by the elements
`single g 1 - 1`), and `magnus X N : F →* (FreeAssoc X ⧸ fil X N)ˣ` the truncated Magnus map.
The Magnus map extends to a ring homomorphism `magRingHom X N : ℤ[F] →+* FreeAssoc X ⧸ fil X N`,
and because `magRingHom X N (single g 1 - 1) ∈ filq X N 1` for every `g`, the `(m+1)`-st power of
`Δ` is carried into `filq X N (m+1)`.  Consequently, if `single g 1 - 1 ∈ Δ^m` (`1 ≤ m`) then the
Magnus image of `g` modulo `fil X m` is trivial.

This is the direction "dimension subgroup ⊆ Magnus kernel"; the reverse containment is
`magnus_filtration_correspondence`.
-/

noncomputable section

open scoped commutatorElement

namespace Work.SSGRoute.prop5

variable {X : Type*}

/-- The augmentation ideal of the integral group ring `ℤ[FreeGroup X]`. -/
def augIdeal (X : Type*) : Ideal (MonoidAlgebra ℤ (FreeGroup X)) :=
  Ideal.span (Set.range (fun g : FreeGroup X => MonoidAlgebra.single g (1 : ℤ) - 1))

/-- The ring homomorphism `ℤ[FreeGroup X] →+* FreeAssoc X ⧸ fil X N` extending the truncated
Magnus map. -/
noncomputable def magRingHom (X : Type*) (N : ℕ) :
    MonoidAlgebra ℤ (FreeGroup X) →+* (FreeAssoc X ⧸ fil X N) :=
  MonoidAlgebra.liftNCRingHom (Int.castRingHom (FreeAssoc X ⧸ fil X N))
    ((Units.coeHom (FreeAssoc X ⧸ fil X N)).comp (magnus X N))
    (fun x _ => Int.cast_commute x _)

@[simp]
theorem magRingHom_single (N : ℕ) (g : FreeGroup X) :
    magRingHom X N (MonoidAlgebra.single g (1 : ℤ)) =
      ((magnus X N g : (FreeAssoc X ⧸ fil X N)ˣ) : FreeAssoc X ⧸ fil X N) := by
  rw [magRingHom, MonoidAlgebra.liftNCRingHom_single]
  simp

/-- The generators of the augmentation ideal are carried into the first filtration piece. -/
theorem magRingHom_sub_one_mem (N : ℕ) (hN : 1 ≤ N) (g : FreeGroup X) :
    magRingHom X N (MonoidAlgebra.single g (1 : ℤ) - 1) ∈ filq X N 1 := by
  have h := magnus_mem_one_add X N 0 hN g (Subgroup.mem_top g)
  rw [map_sub, magRingHom_single, map_one]
  exact h

/-- The augmentation ideal is carried into the first filtration piece. -/
theorem magRingHom_augIdeal_le (N : ℕ) (hN : 1 ≤ N) :
    Ideal.map (magRingHom X N) (augIdeal X) ≤ filq X N 1 := by
  rw [Ideal.map_le_iff_le_comap, augIdeal]
  refine Ideal.span_le.mpr ?_
  rintro a ⟨g, rfl⟩
  exact Ideal.mem_comap.mpr (magRingHom_sub_one_mem N hN g)

/-- `map` is submultiplicative for products of ideals. -/
theorem map_mul_le (N : ℕ) (I J : Ideal (MonoidAlgebra ℤ (FreeGroup X))) :
    Ideal.map (magRingHom X N) (I * J) ≤
      Ideal.map (magRingHom X N) I * Ideal.map (magRingHom X N) J := by
  rw [Ideal.map_le_iff_le_comap]
  refine Ideal.mul_le.mpr fun a ha b hb => ?_
  rw [Ideal.mem_comap, map_mul]
  exact Ideal.mul_mem_mul (Ideal.mem_map_of_mem (magRingHom X N) ha)
    (Ideal.mem_map_of_mem (magRingHom X N) hb)

/-- Products of ideals are monotone. -/
theorem mul_le_mul_ideal {I I' J J' : Ideal (MonoidAlgebra ℤ (FreeGroup X))}
    (hI : I ≤ I') (hJ : J ≤ J') : I * J ≤ I' * J' :=
  Ideal.mul_le.mpr fun a ha b hb => Ideal.mul_mem_mul (hI ha) (hJ hb)

/-- Powers of the first filtration piece: `(filq N 1)^(m+1) ≤ filq N (m+1)`. -/
theorem filq_one_pow_le (N m : ℕ) : (filq X N 1) ^ (m + 1) ≤ filq X N (m + 1) := by
  induction m with
  | zero =>
      rw [show (0 : ℕ) + 1 = 1 from rfl, Submodule.pow_one]
  | succ m ih =>
      have hl : (filq X N 1) ^ (m + 1 + 1) = (filq X N 1) ^ (m + 1) * (filq X N 1) := by
        rw [show (m + 1 + 1 : ℕ) = (m + 1) + 1 from rfl, Submodule.pow_succ]
      rw [hl]
      exact Ideal.mul_le.mpr fun a ha b hb => mul_mem_filq X N (m + 1) 1 (ih ha) hb

/-- `map` commutes with powers up to `≤`. -/
theorem map_pow_le (N m : ℕ) (I : Ideal (MonoidAlgebra ℤ (FreeGroup X))) :
    Ideal.map (magRingHom X N) (I ^ (m + 1)) ≤ (Ideal.map (magRingHom X N) I) ^ (m + 1) := by
  induction m with
  | zero =>
      rw [show (0 : ℕ) + 1 = 1 from rfl, Submodule.pow_one, Submodule.pow_one]
  | succ m ih =>
      have hl : I ^ (m + 1 + 1) = I ^ (m + 1) * I := by
        rw [show (m + 1 + 1 : ℕ) = (m + 1) + 1 from rfl, Submodule.pow_succ]
      have hr : (Ideal.map (magRingHom X N) I) ^ (m + 1 + 1) =
          (Ideal.map (magRingHom X N) I) ^ (m + 1) * (Ideal.map (magRingHom X N) I) := by
        rw [show (m + 1 + 1 : ℕ) = (m + 1) + 1 from rfl, Submodule.pow_succ]
      rw [hl, hr]
      exact le_trans (map_mul_le N (I ^ (m + 1)) I)
        (Ideal.mul_le.mpr fun a ha b hb => Ideal.mul_mem_mul (ih ha) hb)

/-- The `(m+1)`-st power of the augmentation ideal is carried into `(filq N 1)^(m+1)`. -/
theorem magRingHom_augIdeal_pow_le (N m : ℕ) (hN : 1 ≤ N) :
    Ideal.map (magRingHom X N) ((augIdeal X) ^ (m + 1)) ≤ (filq X N 1) ^ (m + 1) := by
  induction m with
  | zero =>
      rw [show (0 : ℕ) + 1 = 1 from rfl, Submodule.pow_one, Submodule.pow_one]
      exact magRingHom_augIdeal_le N hN
  | succ m ih =>
      have hl : (augIdeal X) ^ (m + 1 + 1) = (augIdeal X) ^ (m + 1) * (augIdeal X) := by
        rw [show (m + 1 + 1 : ℕ) = (m + 1) + 1 from rfl, Submodule.pow_succ]
      have hr : (filq X N 1) ^ (m + 1 + 1) = (filq X N 1) ^ (m + 1) * (filq X N 1) := by
        rw [show (m + 1 + 1 : ℕ) = (m + 1) + 1 from rfl, Submodule.pow_succ]
      rw [hl, hr]
      exact le_trans (map_mul_le N ((augIdeal X) ^ (m + 1)) (augIdeal X))
        (Ideal.mul_le.mpr fun a ha b hb => Ideal.mul_mem_mul (ih ha)
          (magRingHom_augIdeal_le N hN hb))

/-- Powers of the augmentation ideal are decreasing. -/
theorem augIdeal_pow_antitone (X : Type*) (k : ℕ) :
    (augIdeal X) ^ (k + 1) ≤ (augIdeal X) ^ k := by
  induction k with
  | zero =>
      rw [show (0 : ℕ) + 1 = 1 from rfl, Submodule.pow_one, Submodule.pow_zero,
        Ideal.one_eq_top]
      exact le_top
  | succ k ih =>
      have hl : (augIdeal X) ^ (k + 1 + 1) = (augIdeal X) ^ (k + 1) * (augIdeal X) := by
        rw [show (k + 1 + 1 : ℕ) = (k + 1) + 1 from rfl, Submodule.pow_succ]
      rw [hl, show (k + 1 : ℕ) = k + 1 from rfl]
      exact Ideal.mul_le.mpr fun a ha b hb => Ideal.mul_mem_mul (ih ha) hb

/-- Membership form: the `(m+1)`-st power of the augmentation ideal is carried into
`filq X N (m+1)`. -/
theorem magRingHom_mem_filq (N m : ℕ) (hN : 1 ≤ N)
    {x : MonoidAlgebra ℤ (FreeGroup X)} (hx : x ∈ (augIdeal X) ^ (m + 1)) :
    magRingHom X N x ∈ filq X N (m + 1) := by
  have hx' : magRingHom X N x ∈ Ideal.map (magRingHom X N) ((augIdeal X) ^ (m + 1)) :=
    Ideal.mem_map_of_mem (magRingHom X N) hx
  exact (filq_one_pow_le N m) (magRingHom_augIdeal_pow_le N m hN hx')

/-- **Conversion.**  If the `m`-th power of the augmentation ideal contains `single g 1 - 1`
(with `1 ≤ m`), then the Magnus image of `g` modulo `fil X m` is trivial. -/
theorem magRingHom_eq_one_of_mem_augIdeal_pow (m : ℕ) (hm : 1 ≤ m) (g : FreeGroup X)
    (h : MonoidAlgebra.single g (1 : ℤ) - 1 ∈ (augIdeal X) ^ m) :
    ((magnus X m g : (FreeAssoc X ⧸ fil X m)ˣ) : FreeAssoc X ⧸ fil X m) = 1 := by
  obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
  have h1 : magRingHom X (m' + 1) (MonoidAlgebra.single g (1 : ℤ) - 1) ∈
      filq X (m' + 1) (m' + 1) :=
    magRingHom_mem_filq (m' + 1) m' (by omega) h
  have h2 : filq X (m' + 1) (m' + 1) ≤ ⊥ := by
    intro x hx
    rw [Ideal.mem_bot]
    rw [show filq X (m' + 1) (m' + 1) =
      Ideal.map (Ideal.Quotient.mk (fil X (m' + 1))) (fil X (m' + 1)) from rfl] at hx
    obtain ⟨a, ha, rfl⟩ :=
      (Ideal.mem_map_iff_of_surjective _ Ideal.Quotient.mk_surjective).1 hx
    exact Ideal.Quotient.eq_zero_iff_mem.mpr ha
  have h3 : magRingHom X (m' + 1) (MonoidAlgebra.single g (1 : ℤ) - 1) ∈
      (⊥ : Ideal (FreeAssoc X ⧸ fil X (m' + 1))) := h2 h1
  rw [Ideal.mem_bot, map_sub, magRingHom_single, map_one, sub_eq_zero] at h3
  exact h3

end Work.SSGRoute.prop5
