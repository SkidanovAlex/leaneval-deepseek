/-!
# Reduction of the derivation identity on `Λbar` to the homogeneous generators

The graded Lie ring `Λbar = ⨁ k, Λ k` is generated, as an abelian group, by the images of the
inclusions `lofL p a` of the graded pieces.  Since `bracketBar : Λbar →+ (Λbar →+ Λbar)` is
additive in its first variable and `bracketBar u` is additive for every `u`, the derivation defect

`D(x,y,z) = [x,[y,z]] - [[x,y],z] - [y,[x,z]]`

is additive in each of the three variables separately.  Hence the truth of the Jacobi/derivation
identity `D(x,y,z) = 0` for all homogeneous `x = lofL p a`, `y = lofL q b`, `z = lofL r c` implies
it for arbitrary `x y z ∈ Λbar`:  one reduces one variable at a time, using that an additive
endomorphism of `⨁ k, Λ k` which vanishes on all the generators `lofL r c` is zero
(`DFinsupp.addHom_ext`).

This is exactly the reduction performed by `bracketBar_deriv_of_lof`.
-/

noncomputable section

namespace Work.SSGRoute.prop5
namespace graded

variable {G : Type*} [Group G]

/-- The derivation defect `[x,[y,z]] - [[x,y],z] - [y,[x,z]]`, as an additive map in the *third*
variable. -/
private def derivZ (x y : Lbar G) : Lbar G →+ Lbar G where
  toFun z := bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
    bracketBar y (bracketBar x z)
  map_zero' := by simp
  map_add' z z' := by
    simp only [map_add]
    abel

private theorem derivZ_apply (x y z : Lbar G) :
    derivZ x y z = bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
      bracketBar y (bracketBar x z) := rfl

/-- The derivation defect `[x,[y,z]] - [[x,y],z] - [y,[x,z]]`, as an additive map in the *second*
variable. -/
private def derivY (x z : Lbar G) : Lbar G →+ Lbar G where
  toFun y := bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
    bracketBar y (bracketBar x z)
  map_zero' := by simp
  map_add' y y' := by
    simp only [map_add, AddMonoidHom.add_apply]
    abel

private theorem derivY_apply (x y z : Lbar G) :
    derivY x z y = bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
      bracketBar y (bracketBar x z) := rfl

/-- The derivation defect `[x,[y,z]] - [[x,y],z] - [y,[x,z]]`, as an additive map in the *first*
variable. -/
private def derivX (y z : Lbar G) : Lbar G →+ Lbar G where
  toFun x := bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
    bracketBar y (bracketBar x z)
  map_zero' := by simp
  map_add' x x' := by
    simp only [map_add, AddMonoidHom.add_apply]
    abel

private theorem derivX_apply (x y z : Lbar G) :
    derivX y z x = bracketBar x (bracketBar y z) - bracketBar (bracketBar x y) z -
      bracketBar y (bracketBar x z) := rfl

/-- **Extension from the generators.**  `Λbar = ⨁ k, Λ k` is generated by the elements `lofL r c`,
so an additive endomorphism of `Λbar` that vanishes on all of them is zero. -/
private theorem eq_zero_of_lofL {F : Lbar G →+ Lbar G}
    (hF : ∀ (r : ℕ) (c : LamAdd (G := G) r), F (lofL (G := G) r c) = 0) :
    ∀ z, F z = 0 := by
  have h : F = 0 := by
    apply DFinsupp.addHom_ext (g := 0)
    intro i y
    rw [AddMonoidHom.zero_apply]
    exact hF i y
  intro z
  rw [h, AddMonoidHom.zero_apply]

end graded

/-- **Reduction of the derivation identity to the homogeneous generators.**
`Lbar G = ⨁ k, Λ k` is generated as an abelian group by the elements `lofL p a`; in the identity
`[x,[y,z]] = [[x,y],z] + [y,[x,z]]` each of the three variables occurs in a linear position
(`bracketBar` is additive in each variable, and `bracketBar u` is additive for every `u`), so a
proof for `x = lofL p a`, `y = lofL q b`, `z = lofL r c` extends to all `x y z`.  Below, that
extension is performed, taking the homogeneous case as the hypothesis `H`. -/
theorem bracketBar_deriv_of_lof (G : Type*) [Group G]
    (H : ∀ (p q r : ℕ) (a : Work.SSGRoute.prop5.graded.LamAdd (G := G) p)
      (b : Work.SSGRoute.prop5.graded.LamAdd (G := G) q)
      (c : Work.SSGRoute.prop5.graded.LamAdd (G := G) r),
      Work.SSGRoute.prop5.graded.bracketBar (G := G) (Work.SSGRoute.prop5.graded.lofL (G := G) p a)
          (Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.lofL (G := G) q b)
            (Work.SSGRoute.prop5.graded.lofL (G := G) r c)) =
        Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.bracketBar (G := G)
              (Work.SSGRoute.prop5.graded.lofL (G := G) p a)
              (Work.SSGRoute.prop5.graded.lofL (G := G) q b))
            (Work.SSGRoute.prop5.graded.lofL (G := G) r c) +
          Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.lofL (G := G) q b)
            (Work.SSGRoute.prop5.graded.bracketBar (G := G)
              (Work.SSGRoute.prop5.graded.lofL (G := G) p a)
              (Work.SSGRoute.prop5.graded.lofL (G := G) r c))) :
    ∀ x y z : Work.SSGRoute.prop5.graded.Lbar G,
      Work.SSGRoute.prop5.graded.bracketBar (G := G) x
          (Work.SSGRoute.prop5.graded.bracketBar (G := G) y z) =
        Work.SSGRoute.prop5.graded.bracketBar (G := G)
            (Work.SSGRoute.prop5.graded.bracketBar (G := G) x y) z +
          Work.SSGRoute.prop5.graded.bracketBar (G := G) y
            (Work.SSGRoute.prop5.graded.bracketBar (G := G) x z) := by
  -- Step 1: the identity holds whenever the first two variables are homogeneous, and the third
  -- one is arbitrary: the defect is additive in `z` and vanishes on generators by `H`.
  have keyZ : ∀ (p q : ℕ) (a : graded.LamAdd (G := G) p) (b : graded.LamAdd (G := G) q)
      (z : graded.Lbar G),
      graded.derivZ (G := G) (graded.lofL (G := G) p a) (graded.lofL (G := G) q b) z = 0 := by
    intro p q a b
    apply graded.eq_zero_of_lofL
    intro r c
    rw [graded.derivZ_apply, H p q r a b c]
    abel
  -- Step 2: the identity holds whenever the first variable is homogeneous (here `z` is the second
  -- *parameter* of `derivY`, `y` its argument).
  have keyY : ∀ (p : ℕ) (a : graded.LamAdd (G := G) p) (z : graded.Lbar G) (y : graded.Lbar G),
      graded.derivY (G := G) (graded.lofL (G := G) p a) z y = 0 := by
    intro p a z
    apply graded.eq_zero_of_lofL
    intro q b
    simpa only [graded.derivY_apply, graded.derivZ_apply] using keyZ p q a b z
  -- Step 3: the identity holds for arbitrary variables.
  have keyX : ∀ (y z : graded.Lbar G) (x : graded.Lbar G), graded.derivX (G := G) y z x = 0 := by
    intro y z
    apply graded.eq_zero_of_lofL
    intro p a
    simpa only [graded.derivX_apply, graded.derivY_apply] using keyY p a z y
  intro x y z
  have h := keyX y z x
  rw [graded.derivX_apply, sub_eq_zero, sub_eq_iff_eq_add'] at h
  exact h

end Work.SSGRoute.prop5
