open scoped commutatorElement

/-- The terms of the descending central series are normal. -/
lemma lcsNormal (G : Type) [Group G] (n : ℕ) :
    ((⊤ : Subgroup G).lowerCentralSeries n).Normal := by
  induction n with
  | zero => rw [Subgroup.lowerCentralSeries_zero]; exact Subgroup.normal_top
  | succ k ih =>
      rw [Subgroup.lowerCentralSeries_succ]
      exact @Subgroup.commutator_normal G _ _ ⊤ ih Subgroup.normal_top

/-- `H ≤ ⟨h ^ 1 : h ∈ H⟩`; used for the base case `i = j` of the induction. -/
lemma le_powSubgroup_one {G : Type*} [Group G] (H : Subgroup G) :
    H ≤ Work.Shrinking.powSubgroup 1 H := by
  intro x hx
  rw [Work.Shrinking.powSubgroup]
  exact Subgroup.subset_closure ⟨x, hx, by simp⟩

/-- **The collection step** (the "engine" of Lemma 4(ii) of Schmidt–Wingberg, in the weak form
needed below): an element of `γ_j` which is a `p^m`-th power and which lies in `F_{j+m+1}` *up to*
`γ_{j+1}` is already a `p^{m+1}`-st power up to `γ_{j+1}`,

`γ_j ^{p^m} ∩ (F_{j+m+1} · γ_{j+1}) ≤ γ_j ^{p^{m+1}} · γ_{j+1}`.

It is deduced from Lemma 4(ii) (`lemma4ii_filtration`): writing `x = y z` with
`y ∈ F_{j+m+1}`, `z ∈ γ_{j+1}`, one has `y = x z⁻¹ ∈ γ_j ∩ F_{j+m+1}`, and the equality of
Lemma 4(ii) at `(j+m+1, j)` expresses `γ_j ∩ F_{j+m+1}` as the join of `⟨γ_k^{p^{j+m+1-k}}⟩` for
`j ≤ k ≤ j+m+1`; the term `k = j` is `⟨γ_j ^{p^{m+1}}⟩` and every term with `k ≥ j+1` lies in
`γ_{j+1}`. -/
theorem gamma_pow_inter_pSeries_sup (p : ℕ) [Fact p.Prime] (X : Type) [Fintype X]
    (j m : ℕ) (hj : 1 ≤ j) :
    Work.Shrinking.powSubgroup (p ^ m)
          ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊓
        (Work.Shrinking.pCentralSeries p (FreeGroup X) (j + m) ⊔
          (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j) ≤
      Work.Shrinking.powSubgroup (p ^ (m + 1))
          ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊔
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
  intro x hx
  obtain ⟨hxA, hxP⟩ := Subgroup.mem_inf.mp hx
  haveI : ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j).Normal := lcsNormal _ j
  -- decompose `x` into its `F_{j+m+1}` part `y` and its `γ_{j+1}` part `z`
  obtain ⟨y, hyP, z, hz, hyz⟩ := (Subgroup.mem_sup_of_normal_right
    (s := Work.Shrinking.pCentralSeries p (FreeGroup X) (j + m))
    (t := (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j)).mp hxP
  -- `y = x * z⁻¹ ∈ γ_j`
  have hxle : x ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) :=
    Work.Shrinking.powSubgroup_le (p ^ m) _ hxA
  have hzle : z ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) :=
    Subgroup.lowerCentralSeries_antitone (⊤ : Subgroup (FreeGroup X)) (by omega : j - 1 ≤ j) hz
  have hyle : y ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) := by
    have h : y = x * z⁻¹ := by rw [← hyz]; group
    rw [h]
    exact Subgroup.mul_mem _ hxle (Subgroup.inv_mem _ hzle)
  -- Lemma 4(ii) at `(j+m+1, j)`
  have hkey := lemma4ii_filtration p X (j + m + 1) j hj (by omega)
  have hyP' : y ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (j + m + 1 - 1) := by
    rwa [show j + m + 1 - 1 = j + m from by omega]
  have hyY := hkey ▸ (Subgroup.mem_inf.mpr ⟨hyP', hyle⟩ :
      y ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (j + m + 1 - 1) ⊓
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1))
  -- each summand of the join is contained in the target subgroup
  have hterm : y ∈ Work.Shrinking.powSubgroup (p ^ (m + 1))
          ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊔
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
    have hle : (⨆ k ∈ Finset.Icc j (j + m + 1),
          Work.Shrinking.powSubgroup (p ^ (j + m + 1 - k))
            ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (k - 1))) ≤
        (Work.Shrinking.powSubgroup (p ^ (m + 1))
            ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊔
          (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j) := by
      refine iSup_le (fun k => iSup_le (fun hk => ?_))
      rw [Finset.mem_Icc] at hk
      rcases eq_or_lt_of_le hk.1 with hkj | hklt
      · -- `k = j`: this is the `p^{m+1}`-st power subgroup of `γ_j` itself
        subst hkj
        rw [show j + m + 1 - j = m + 1 from by omega]
        exact le_sup_left
      · -- `k > j`: the summand lies in `γ_{j+1}`
        refine le_trans (Work.Shrinking.powSubgroup_le (p ^ (j + m + 1 - k))
          ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (k - 1))) ?_
        exact le_trans (Subgroup.lowerCentralSeries_antitone (⊤ : Subgroup (FreeGroup X))
          (by omega : j ≤ k - 1)) le_sup_right
    exact hle hyY
  -- conclude: `x = y * z` with `z ∈ γ_{j+1}`
  rw [← hyz]
  exact Subgroup.mul_mem _ hterm (Subgroup.mem_sup_right hz)

/-- **Main induction.**  For every `j ≤ i` the intersection of `F_i` with `γ_j` is contained in
`⟨γ_j ^{p^{i-j}}⟩ · γ_{j+1}` (paper's indexing: `F_i = pCentralSeries p F (i-1)`,
`γ_j = lowerCentralSeries (j-1)`).  This is stronger than the required conclusion. -/
theorem pSeries_inter_lcs_subset (p : ℕ) [Fact p.Prime] (X : Type) [Fintype X] (i : ℕ) :
    ∀ j : ℕ, 1 ≤ j → j ≤ i →
      Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) ⊓
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)
      ≤ Work.Shrinking.powSubgroup (p ^ (i - j))
          ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1))
        ⊔ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
  induction i with
  | zero =>
      -- `1 ≤ j` and `j ≤ 0` are incompatible
      intro j hj hji
      omega
  | succ n ih =>
      intro j hj hji
      rcases Nat.eq_or_lt_of_le hji with h | h
      · -- base case `j = n + 1`: `γ_{n+1}` is already the right hand side
        subst h
        have hidx : p ^ ((n + 1) - (n + 1)) = 1 := by simp
        rw [hidx]
        exact le_trans inf_le_right (le_trans (le_powSubgroup_one _) le_sup_left)
      · -- induction step: throw away `F_{n+1} ≤ F_n`, decompose and upgrade by the collection step
        have hjn : j ≤ n := by omega
        intro x hx
        obtain ⟨hxA, hxB⟩ := hx
        have hx' : x ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (n - 1) :=
          Work.Shrinking.pCentralSeries_antitone p (FreeGroup X) (Nat.sub_le n 1) hxA
        have hmem := ih j hj hjn ⟨hx', hxB⟩
        haveI : ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j).Normal := lcsNormal _ j
        rw [Subgroup.mem_sup_of_normal_right] at hmem
        obtain ⟨a, ha, b, hb, hab⟩ := hmem
        -- index identifications
        have hidx1 : j + (n - j) = n := by omega
        have hidx2 : (n - j) + 1 = (n + 1) - j := by omega
        -- `a = x * b⁻¹` lies in `F_n ⊔ γ_{j+1}`
        have haX : a ∈ Work.Shrinking.pCentralSeries p (FreeGroup X) (j + (n - j)) ⊔
            (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
          rw [hidx1]
          have ha_eq : a = x * b⁻¹ := by rw [← hab]; group
          rw [ha_eq]
          exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hxA)
            (Subgroup.mem_sup_right (Subgroup.inv_mem _ hb))
        -- the collection step upgrades `a`
        have ha' := gamma_pow_inter_pSeries_sup p X j (n - j) hj ⟨ha, haX⟩
        rw [hidx2] at ha'
        rw [← hab]
        exact Subgroup.mul_mem _ ha' (Subgroup.mem_sup_right hb)

/-- **`pSeries_inter_centralSeries`**: for a free group `F` on a finite set and `i ≥ j ≥ 1`,

`F_i ∩ γ_j ≤ ⟨γ_j ^{p^{i-j}}⟩ · γ_{j+1} · F_{i+1}`. -/
theorem pSeries_inter_centralSeries (p : ℕ) [Fact p.Prime] (X : Type) [Fintype X]
    (i j : ℕ) (hj : 1 ≤ j) (hji : j ≤ i) :
    Work.Shrinking.pCentralSeries p (FreeGroup X) (i - 1) ⊓
        (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)
      ≤ Subgroup.closure {x : FreeGroup X |
            ∃ y ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1),
              x = y ^ (p ^ (i - j))}
        ⊔ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j
        ⊔ Work.Shrinking.pCentralSeries p (FreeGroup X) i := by
  -- the closure appearing in the statement is `⟨γ_j ^{p^{i-j}}⟩`
  have hAA : Work.Shrinking.powSubgroup (p ^ (i - j))
        ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1))
      ≤ Subgroup.closure {x : FreeGroup X |
          ∃ y ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1),
            x = y ^ (p ^ (i - j))} := by
    rw [Work.Shrinking.powSubgroup]
    apply Subgroup.closure_mono
    rintro z ⟨y, hy, rfl⟩
    exact ⟨y, hy, rfl⟩
  refine le_trans (pSeries_inter_lcs_subset p X i j hj hji) (sup_le ?_ ?_)
  · exact le_trans hAA (le_trans le_sup_left le_sup_left)
  · exact le_trans le_sup_right le_sup_left

end Work.SSGRoute.prop5
