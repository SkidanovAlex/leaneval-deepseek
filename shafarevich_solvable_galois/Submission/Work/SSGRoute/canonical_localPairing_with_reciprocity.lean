/-!
# The canonical local Tate pairing with its reciprocity clause (input `G1` of the `H¹`-assembly)

This is `Work.SSGRoute.PTembedding.localTatePairing_canonical` (node `G1` of
`Submission/Work/SSGRoute/DESIGN_PT.md`: the canonical local Tate pairing at every local group
`H` — a decomposition group `decomp k A` at a finite place, or `Subgroup.zpowers c` for an
involution `c` — for every *finite* `𝔽_p[Gal(K/k)]`-module `M`), **strengthened by the
reciprocity clause**, in the two ways the consumer `Work.SSGRoute.coker_obstruction` needs:

* the family `pair` is indexed by the coefficient module `M` alone: it does **not** depend on the
  local data, on the level `N` or on the sets `S`, `C` (the canonical pairing is a single
  canonical object; the assembly uses *one* family throughout, and naturality in the level and in
  the coefficients is what makes the obstruction class `x` universal);
* it carries clause **(6), reciprocity** `hrec`, which is *not* among the clauses of
  `localTatePairing_canonical`: reciprocity is a property of the *canonical* construction
  (`DESIGN_EXT.md` §2: in the generator-free form the sum of the local values of a global pair is
  the image of a cup product in `H²(G, K^×)`, hence vanishes by the exactness of the class
  formation `K^× → 𝕀_K → C_K`); it is *not* a consequence of the other clauses alone, so the
  interface consumed by the assembly must bundle it together with the construction.

Clauses (1)–(5) below are copied verbatim from `localTatePairing_canonical`; clause (6) is copied
verbatim from the `hrec` hypothesis of `Work.SSGRoute.pt_selmer_relaxed` (there instantiated at a
single `M`), universally quantified over the coefficient module.

Consumers: `Work.SSGRoute.coker_obstruction` (through `Work.SSGRoute.coker_obstruction_of_inputs`,
which takes clauses (1)–(4) to build the obstruction functional `ω` and to move it between levels)
and `Work.SSGRoute.pt_selmer_relaxed` (which consumes (1)–(3) + perfectness as its `hloc` and (6)
as its `hrec`).
-/

open scoped TensorProduct

namespace Work.SSGRoute

/-- **`G1` + reciprocity**: there is a single family of local pairings
`pair M H a b ∈ 𝔽_p` (indexed by the finite `𝔽_p[Gal(K/k)]`-module `M` only, with
`b : G_k → DualMod p (M ⊗ T)`), such that for every local group `H` of the two kinds that occur
(a decomposition group of a finite place, or the procyclic group generated by an involution):

* (1),(2) `pair M H` is additive in each variable on locally constant cocycles;
* (3) it vanishes when either argument is a coboundary;
* (4) it is perfect in each variable (Tate's local duality);
* (5) it is natural in the coefficient module, with respect to any `Gal(K/k)`-equivariant
  `f : M → M₂` and the transpose `f'` of `f ⊗ id_T`;
* (6) it is orthogonal on unramified classes at places prime to `p` and unramified in `K`;
* (7) **reciprocity**: the sum over one place per prime of `S'` and one involution per real place
  of `C'` (for `S'` large enough, `C'` containing one representative of every conjugacy class of
  involutions) vanishes on global cocycles. -/
theorem canonical_localPairing_with_reciprocity
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ) :
    ∃ pair : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p,
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        (∀ H : Subgroup (Ω ≃ₐ[k] Ω),
          ((∃ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A ∧ H = SSGRoute.decomp k A) ∨
            (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)) →
          -- (1)+(2) additive in each variable on locally constant cocycles
          (∀ (a a' : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            pair M H (a + a') b = pair M H a b + pair M H a' b) ∧
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b b' : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b' ∧ SSGRoute.IsLocConstOn H b') →
            pair M H a (b + b') = pair M H a b + pair M H a b') ∧
          -- (3) zero on a coboundary
          (∀ (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a ∨
              SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) →
            pair M H a b = 0) ∧
          -- (4) perfect in each variable
          (∀ a : (Ω ≃ₐ[k] Ω) → M,
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
          (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            (∀ a : (Ω ≃ₐ[k] Ω) → M,
              (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
              pair M H a b = 0) →
            SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) ∧
          -- (5) naturality in the coefficient module (transpose of `f ⊗ id_T`)
          (∀ (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
              [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
              (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
              (f' : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
                Work.SSGRoute.DualMod p (M ⊗[ZMod p] T))
              (hff' : ∀ (φ : Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
                f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
              (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)),
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
            pair M₂ H (fun σ => f (a σ)) b = pair M H a (fun σ => f' (b σ))) ∧
          -- (6) orthogonality on unramified classes at good places
          (∀ (A : ValuationSubring Ω) (a : (Ω ≃ₐ[k] Ω) → M)
              (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
            SSGRoute.IsFinPlace k A → ¬ A.valuation (p : Ω) < 1 → ¬ SSGRoute.IsRamifiedIn k K A →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
              SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a) →
            (SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
              SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b) →
            (∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0) →
            pair M (SSGRoute.decomp k A) a b = 0))) ∧
      -- (7) reciprocity
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (a : (Ω ≃ₐ[k] Ω) → M)
          (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', pair M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', pair M (Subgroup.zpowers c) a b = 0) := by
  exact canonical_localPairing_with_reciprocity_of_G1plus
    (p := p) (k := k) (Ω := Ω) (K := K) (ζ := ζ) (hζ := hζ) (hζK := hζK) (T := T) (hT := hT)

end Work.SSGRoute
