/-!
# A `1`-cocycle at the Frobenius element of a completely split finite place

Let `A` be a finite place of `ℚ̄` which is *completely decomposed* in a finite normal extension
`K/ℚ`, i.e. `D_A ≤ G_K` (`hsplit`).  Then the action of `D_A` on any `Gal(K/ℚ)`-module `M` is
trivial, so a `1`-cocycle for `D_A` with values in a *finite* module `M` is nothing but a
homomorphism `D_A → M`; such a homomorphism vanishes on the inertia subgroup and is determined by
its value on a Frobenius element.  Since `D_A/I_A ≅ Ẑ` is pro-cyclic of rank one
(`Work.SSGRoute.local_tame_lifting`, part (a)), every value `x ∈ M` is attained.

This file records that statement in exactly the form in which the Schmidt–Wingberg (Step 1–2)
argument of the paper consumes it: the cocycle `f` is defined on all of `G_ℚ` (vanishing away from
`D_A`), is a `1`-cocycle *on* `D_A`, is locally constant *on* `D_A`, kills the inertia group, and
takes the value `x` at the chosen Frobenius element `Work.SSGRoute.localFrobElem` of `D_A`.

The three ingredients are:

* `exists_hom_at_frob` (`Work.SSGRoute.local_tame_lifting`, part (a)): for a *finite* group `X` and
  any `x ∈ X` there is `f₀ : D_A →* X` with open kernel, trivial on the inertia group and with
  `f₀ F = x`;
* `exists_openSubgroup_comap_le`: the Krull topology is generated by the fixing subgroups of the
  *finite* subextensions of `ℚ̄/ℚ`, so the open kernel of `f₀` contains `U ∩ D_A` for an open
  subgroup `U ≤ G_ℚ`.  This is what makes `f₀` continuous, i.e. the extension of `f₀` by `0`
  locally constant on `D_A`;
* `isCocycleOn_of_eq_hom_on_subgroup` and `isLocConstOn_of_eq_hom_on_subgroup`: the extension by
  `0` off `D_A` of the additive shadow `toAdd ∘ f₀` is a `1`-cocycle, resp. locally constant, on
  `D_A` as soon as the action is trivial on `D_A` — which is exactly the hypothesis `hsplit`.
-/

namespace Work.SSGRoute

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

theorem exists_cocycle_at_frob_of_split (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (A : ValuationSubring SSGRoute.QBar) (hA : SSGRoute.IsFinPlace ℚ A)
    (hsplit : SSGRoute.decomp ℚ A ≤ K.fixingSubgroup)
    (M : Type) [AddCommGroup M] [DistribMulAction (K ≃ₐ[ℚ] K) M] [Finite M] (x : M) :
    ∃ f : SSGRoute.GalQ → M,
      SSGRoute.IsCocycleOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ A) f ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) f ∧
      (∀ σ ∈ SSGRoute.decomp ℚ A, SSGRoute.IsInertia ℚ A σ → f σ = 0) ∧
      f ((Work.SSGRoute.localFrobElem ⟨A, hA⟩ : ↥(SSGRoute.decomp ℚ A)) : SSGRoute.GalQ) = x := by
  classical
  -- the local homomorphism `D_A →* M` with the prescribed value at a Frobenius element
  obtain ⟨f0, hf0open, hf0inertia, hf0F⟩ :=
    exists_hom_at_frob A hA (Multiplicative M) (Multiplicative.ofAdd x)
  -- a Frobenius element of `D_A` lies over an open subgroup of `G_ℚ` on which `f0` is trivial,
  -- so `f0` is locally constant on `D_A`
  obtain ⟨U, hUopen, hUker⟩ :=
    exists_openSubgroup_comap_le (SSGRoute.decomp ℚ A) f0.ker hf0open
  -- the action is trivial on `D_A` because `A` splits completely in `K/ℚ`
  have hact : SSGRoute.decomp ℚ A ≤ (Work.SSGRoute.restrict K).ker := fun σ hσ =>
    MonoidHom.mem_ker.mpr (restrict_eq_one_of_mem_fixingSubgroup K (hsplit hσ))
  -- the extension of `toAdd ∘ f0` by `0` off the decomposition group
  have hf : ∀ (σ : SSGRoute.GalQ) (hσ : σ ∈ SSGRoute.decomp ℚ A),
      (fun τ => if h : τ ∈ SSGRoute.decomp ℚ A then (f0 ⟨τ, h⟩).toAdd else 0) σ =
        (f0 ⟨σ, hσ⟩).toAdd := fun σ hσ => dif_pos hσ
  refine ⟨fun σ => if h : σ ∈ SSGRoute.decomp ℚ A then (f0 ⟨σ, h⟩).toAdd else 0,
    ?_, ?_, ?_, ?_⟩
  · -- it is a `1`-cocycle on `D_A`, the action there being trivial
    exact isCocycleOn_of_eq_hom_on_subgroup (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ A)
      hact f0 _ hf
  · -- it is locally constant on `D_A`, with witness the open subgroup `U`
    exact isLocConstOn_of_eq_hom_on_subgroup (SSGRoute.decomp ℚ A) f0 U hUopen hUker _ hf
  · -- the inertia subgroup is killed, because `f0` kills it
    intro σ hσ hσI
    rw [hf σ hσ, hf0inertia ⟨σ, hσ⟩ hσI]
    simp
  · -- the value at a Frobenius element is the prescribed one
    have hF : ((localFrobElem ⟨A, hA⟩ : ↥(SSGRoute.decomp ℚ A)) : SSGRoute.GalQ)
        ∈ SSGRoute.decomp ℚ A := (localFrobElem ⟨A, hA⟩).2
    have h2 : (⟨((localFrobElem ⟨A, hA⟩ : ↥(SSGRoute.decomp ℚ A)) : SSGRoute.GalQ), hF⟩ :
        ↥(SSGRoute.decomp ℚ A)) = localFrobElem ⟨A, hA⟩ := Subtype.ext rfl
    rw [hf _ hF, h2, hf0F]
    simp

end Work.SSGRoute
