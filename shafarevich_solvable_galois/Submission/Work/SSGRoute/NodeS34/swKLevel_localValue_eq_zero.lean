/-!
# The promotion of a Frobenius value to the whole local group, at a level over `K`

`Work.SSGRoute.ZSplit.localValue_eq_zero_of_isFrobAtPrime` performs the §4 verification step

    `z` a locally constant `1`-cocycle, `σ` a Frobenius of the level `L`  ⟹  `z τ = m • z σ`

but its level `L` is a **subfield of `Ω` over `k`** (`[IsGalois k L]`, `res k L`).  In the §4(b)
chain of Schmidt--Wingberg the natural level is the *Kummer level over `K`*,
`L = K((b_i b_N)^{1/p})`: it is Galois over `K` (not over `k`), and it is unramified at the sibling
places precisely because the classes are (this is Schmidt--Wingberg's "`z_i` and `z_N` are unramified
at `σP_N`, so it suffices to check the Frobenius").  Its `k`-normal closure, on the other hand, is
ramified at *every* sibling of `Q_N` (it contains the conjugates `K((σ b_i)^{1/p})`), so the
`k`-level statement cannot be applied there.

This file supplies the level-over-`K` version.  The engine is a purely group-theoretic lemma:

* `localValue_eq_zero_of_zpowers` — for **any** monoid homomorphism `φ` out of `K.fixingSubgroup`
  and any subgroup `H ≤ K.fixingSubgroup`: if `φ` maps `H` into the cyclic group generated by
  `φ σ`, `z` is additive on `K.fixingSubgroup`, `z` kills the kernel of `φ` on `H`, and
  `z σ = 0`, then `z = 0` on `H`;

* `swKLevel_localValue_eq_zero` — the same with `φ` the restriction to a level `L` over `K`,
  `H = decomp k A ⊓ K.fixingSubgroup`: the promotion in the form in which the §4(b) chain uses it
  (statement `swKLevel_localValue_eq_zero` of the chain design).

Both are `sorry`-free and axiom-clean.

## Note for the chain

The companion input `∀ τ ∈ H, ∃ m, φ τ = (φ σ) ^ m` (the `hpow` of `swKLevel_localValue_eq_zero`)
is the "image of the local group at a level over `K` is generated by the image of a Frobenius",
`swKLevel_localGroup_pow`; the level-kernel hypothesis `hker` is supplied for the §4(b) chain by
`Work.SSGRoute.H9.swSum_kills_levelKernel` (`L ⊇ K((b_i b_N)^{1/p})`).
-/

namespace Work.SSGRoute.NodeS34

open _root_.SSGRoute

set_option autoImplicit false
set_option linter.unusedSectionVars false

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω]

/-- **The promotion engine.**  Let `φ : K.fixingSubgroup →* G` be any homomorphism, `H` a subgroup
of `K.fixingSubgroup`, `z` additive on `K.fixingSubgroup`, `σ ∈ H` with `z σ = 0`, and suppose that

* (cyclicity) every `τ ∈ H` has `φ τ` in the cyclic group generated by `φ σ`, and
* (level kernel) `z` kills the elements of `H` with `φ u = 1`.

Then `z` vanishes on `H`.

The proof is the one-line identity `z τ = -m • z σ + z τ = z (σ ^ (-m) * τ) = 0`, where
`m : ℤ` is the exponent with `φ τ = (φ σ) ^ m` and `σ ^ (-m) * τ ∈ ker φ`.  (No topology, no
local/global input: the vanishing is a consequence of additivity alone, once the level is fine
enough to see only `⟨φ σ⟩`.) -/
theorem localValue_eq_zero_of_zpowers {G : Type*} [Group G]
    (K : IntermediateField k Ω) (φ : ↥K.fixingSubgroup →* G)
    (H : Subgroup (Ω ≃ₐ[k] Ω)) (hHK : H ≤ K.fixingSubgroup)
    {z : (Ω ≃ₐ[k] Ω) → ZMod p}
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ H)
    (hpow : ∀ (τ : Ω ≃ₐ[k] Ω) (hτ : τ ∈ H), ∃ m : ℤ, φ ⟨τ, hHK hτ⟩ = (φ ⟨σ, hHK hσ⟩) ^ m)
    (hker : ∀ (u : Ω ≃ₐ[k] Ω) (hu : u ∈ H), φ ⟨u, hHK hu⟩ = 1 → z u = 0)
    (hval : z σ = 0) :
    ∀ τ ∈ H, z τ = 0 := by
  intro τ hτ
  obtain ⟨m, hm⟩ := hpow τ hτ
  have hσm : σ ^ (-m) ∈ H := H.zpow_mem hσ (-m)
  have hτm : σ ^ (-m) * τ ∈ H := H.mul_mem hσm hτ
  -- `φ` of the corrected element is `1`
  have hphi : φ ⟨σ ^ (-m) * τ, hHK hτm⟩ = 1 := by
    have hmul : (⟨σ ^ (-m) * τ, hHK hτm⟩ : ↥K.fixingSubgroup)
        = ⟨σ ^ (-m), hHK hσm⟩ * ⟨τ, hHK hτ⟩ := rfl
    have h1 : φ ⟨σ ^ (-m), hHK hσm⟩ = (φ ⟨σ, hHK hσ⟩) ^ (-m) := by
      rw [show (⟨σ ^ (-m), hHK hσm⟩ : ↥K.fixingSubgroup) = ⟨σ, hHK hσ⟩ ^ (-m) from rfl]
      exact map_zpow φ ⟨σ, hHK hσ⟩ (-m)
    rw [hmul, map_mul, h1, hm]
    group
  have hz0 : z (σ ^ (-m) * τ) = 0 := hker _ hτm hphi
  -- and `z (σ ^ (-m)) = 0` because `z σ = 0`
  have hzm : z (σ ^ (-m)) = 0 := by
    rw [ZSplit.z_zpow_eq_zsmul hz σ (hHK hσ) (-m), hval, smul_zero]
  -- additivity finishes
  have hadd : z (σ ^ (-m) * τ) = z (σ ^ (-m)) + z τ := hz _ (hHK hσm) τ (hHK hτ)
  rw [hz0, hzm, zero_add] at hadd
  exact hadd.symm

/-- **The promotion of a Frobenius value to the whole local group, at a level over `K`.**

`L` is a finite Galois level of `Ω` over `↥K`; `φ` is the restriction map
`Ω ≃ₐ[↥K] Ω →* ↥L ≃ₐ[↥K] ↥L` composed with `IntermediateField.fixingSubgroupEquiv K`
(so that the `hpow`/`hker` hypotheses are stated, as in the chain design, as equations between
elements of `↥L ≃ₐ[↥K] ↥L`).  If every element of the local group `decomp k A ⊓ K.fixingSubgroup`
restricts into `⟨φ σ⟩`, if `z` kills the level kernel, and if `z σ = 0` at the Frobenius `σ`, then
`z` vanishes on the whole local group. -/
theorem swKLevel_localValue_eq_zero {K : IntermediateField k Ω} [FiniteDimensional k K]
    [IsGalois k K]
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L]
    (A : ValuationSubring Ω)
    (z : (Ω ≃ₐ[k] Ω) → ZMod p)
    (hz : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hpow : ∀ (τ : Ω ≃ₐ[k] Ω) (hτ : τ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup), ∃ m : ℤ,
      AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
          ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, (Subgroup.mem_inf.mp hτ).2⟩) =
        (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
          ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, (Subgroup.mem_inf.mp hσ).2⟩)) ^ m)
    (hker : ∀ (u : Ω ≃ₐ[k] Ω) (hu : u ∈ K.fixingSubgroup),
      AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
        ((IntermediateField.fixingSubgroupEquiv K) ⟨u, hu⟩) = 1 →
      u ∈ SSGRoute.decomp k A → z u = 0)
    (hval : z σ = 0) :
    ∀ (τ : Ω ≃ₐ[k] Ω) (hτ : τ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup), z τ = 0 := by
  refine localValue_eq_zero_of_zpowers (p := p) K
    ((AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L).comp
      (IntermediateField.fixingSubgroupEquiv K).toMonoidHom)
    (SSGRoute.decomp k A ⊓ K.fixingSubgroup) (fun x hx => (Subgroup.mem_inf.mp hx).2)
    hz σ hσ ?_ ?_ hval
  · intro τ hτ
    obtain ⟨m, hm⟩ := hpow τ hτ
    exact ⟨m, hm⟩
  · intro u hu hphi
    exact hker u (Subgroup.mem_inf.mp hu).2 hphi (Subgroup.mem_inf.mp hu).1

end Work.SSGRoute.NodeS34
