namespace Work.SSGRoute.NodeS34

/-!
# The local group at a level over `K` is generated by the image of a Frobenius

This is the `hpow` companion of `Work.SSGRoute.NodeS34.swKLevel_localValue_eq_zero`: at a finite
place `A` of `Ω` lying over an unramified prime `𝔮` of the finite Galois level `K/k`, and for a
finite Galois level `L/K` inside `Ω`, the image of the local group `decomp k A ⊓ K.fixingSubgroup`
under the restriction to `L` is generated by the image of any element which restricts to a Frobenius
at `𝔮`.

The proof is the `K`-relative analogue of
`Work.SSGRoute.ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime` (the `k`-relative statement):
since `Ω` is an algebraic closure of `↥K` as well, the prime `P` of `𝓞 ↥L` below `A` lies over `𝔮`
and is unramified over `𝔮` by hypothesis, so the image of the decomposition group
`decomp ↥K A` in `Gal(↥L/↥K)` is the cyclic group generated by its Frobenius; an element
`σ ∈ decomp k A ⊓ K.fixingSubgroup` becomes an element of `decomp ↥K A` after applying
`IntermediateField.fixingSubgroupEquiv K`, and the two actions on the valuation ring agree because
the underlying maps agree.

*Note.* The statement as originally filed contained the (unelaboratable) term
`(Subgroup.mem_inf.mp σ).2` in its conclusion; it has been corrected to
`(Subgroup.mem_inf.mp hσ).2`, which is the only reading under which the statement parses, and it is
the reading recorded for the companion statement in `Work.SSGRoute.ZDataMup.swKLevel_localGroup_pow`.
-/

theorem swKLevel_localGroup_pow {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K]
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K))
    (h𝔮 : A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K 𝔮)
    (hunr : ∀ P : NK.Chebotarev.PrimeIdeal ↥L, P.asIdeal.LiesOver 𝔮.asIdeal →
      P.asIdeal.ramificationIdx (NumberField.RingOfIntegers ↥K) = 1)
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hfrob : NK.Chebotarev.IsFrobAtPrime (K := ↥K) (L := ↥L) 𝔮
      (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
        ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, (Subgroup.mem_inf.mp hσ).2⟩))) :
    ∀ (τ : Ω ≃ₐ[k] Ω) (hτ : τ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup), ∃ m : ℤ,
      AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
          ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, (Subgroup.mem_inf.mp hτ).2⟩) =
        (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
          ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, (Subgroup.mem_inf.mp hσ).2⟩)) ^ m := by
  classical
  -- `Ω` is an algebraic (separable) closure of `↥K` as well.
  haveI hAlgK : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI hSepK : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  haveI hNumL : NumberField ↥L := inferInstance
  -- The trace of `A` on `↥K` is a proper place, namely the one of `𝔮`.
  have hCK : A.comap (algebraMap ↥K Ω) ≠ ⊤ := by
    rw [h𝔮]; exact Commons.RingTheory.Valuation.valuationSubringAtPrime_ne_top (K := ↥K) 𝔮
  -- The prime `P` of `𝓞 ↥L` below `A` lies over `𝔮`, hence is unramified over `𝔮`.
  have hlies : (Work.SSGRoute.levelPrime ↥K Ω A hCK L).asIdeal.LiesOver 𝔮.asIdeal := by
    have hprimeOf : Submission.NeukirchUchida.primeOf A hCK = 𝔮 :=
      Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := ↥K) (by
        rw [← Submission.NeukirchUchida.primeOf_spec A hCK, h𝔮])
    have h := NK.ResidueFrob.primeOfLevel_liesOver (K := ↥K) (K' := Ω)
      (⟨A, hCK⟩ : NK.FrobeniusBridge.FinitePlaceOf ↥K Ω) L
    rwa [hprimeOf] at h
  have hpram : (Work.SSGRoute.levelPrime ↥K Ω A hCK L).asIdeal.ramificationIdx
      (NumberField.RingOfIntegers ↥K) = 1 := hunr _ hlies
  -- The action of `Gal(Ω/↥K)` on valuation rings agrees with the action of `Gal(Ω/k)` on the
  -- elements of `K.fixingSubgroup` (the underlying maps are the same).
  have hsmul_of : ∀ (x : Ω ≃ₐ[k] Ω) (hx : x ∈ K.fixingSubgroup),
      ((IntermediateField.fixingSubgroupEquiv K) ⟨x, hx⟩ : Ω ≃ₐ[↥K] Ω) • A = x • A := by
    intro x hx
    apply SetLike.ext; intro y
    rw [ValuationSubring.mem_smul_pointwise_iff_exists,
      ValuationSubring.mem_smul_pointwise_iff_exists]
    exact ⟨fun ⟨s, hs, hsy⟩ => ⟨s, hs, by rw [← hsy]; rfl⟩,
           fun ⟨s, hs, hsy⟩ => ⟨s, hs, by rw [← hsy]; rfl⟩⟩
  -- Members of the local group lie in the `↥K`-decomposition group of `A`.
  have hσK : σ ∈ K.fixingSubgroup := (Subgroup.mem_inf.mp hσ).2
  have hσ' : ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσK⟩ : Ω ≃ₐ[↥K] Ω)
      ∈ SSGRoute.decomp ↥K A := by
    rw [SSGRoute.decomp, MulAction.mem_stabilizer_iff, hsmul_of σ hσK]
    exact MulAction.mem_stabilizer_iff.mp (Subgroup.mem_inf.mp hσ).1
  -- The `↥K`-relative Frobenius-generation statement.
  have hmain : (SSGRoute.decomp ↥K A).map (SSGRoute.res ↥K L) =
      Subgroup.zpowers (SSGRoute.res ↥K L ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσK⟩)) :=
    Work.SSGRoute.ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime ↥K Ω L A hCK 𝔮 h𝔮 hpram
      _ hσ' hfrob
  intro τ hτ
  have hτK : τ ∈ K.fixingSubgroup := (Subgroup.mem_inf.mp hτ).2
  have hτ' : ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, hτK⟩ : Ω ≃ₐ[↥K] Ω)
      ∈ SSGRoute.decomp ↥K A := by
    rw [SSGRoute.decomp, MulAction.mem_stabilizer_iff, hsmul_of τ hτK]
    exact MulAction.mem_stabilizer_iff.mp (Subgroup.mem_inf.mp hτ).1
  have hmem : (SSGRoute.res ↥K L) ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, hτK⟩)
      ∈ (SSGRoute.decomp ↥K A).map (SSGRoute.res ↥K L) :=
    Subgroup.mem_map.mpr ⟨_, hτ', rfl⟩
  rw [hmain] at hmem
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
  exact ⟨m, hm.symm⟩

end Work.SSGRoute.NodeS34
