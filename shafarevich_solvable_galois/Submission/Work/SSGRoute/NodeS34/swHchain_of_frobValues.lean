/-!
# The §4(b) chain from the Frobenius value identity

This file packages the last glue of the odd-`p` chain of Schmidt--Wingberg §4(b): given, for every
`σ ≠ 1` in `Gal(K|k)`, a Frobenius element `G σ` of the local group at the `σ`-sibling of the last
escape prime `Q_N` at which the sum `χ_{b_i} + χ_{b_N}` **vanishes**, together with the cyclicity
input at the Kummer level `L ⊇ K((b_i b_N)^{1/p})`, the sum vanishes on the whole local group of
**every** `k`-conjugate `Q` of `Q_N` that is not a `K`-conjugate of it — which is literally the
`hchain` input of `Work.SSGRoute.H9.ZSix_of_histK`.

The two inputs `hval` and `hpow` are exactly what the assembly produces for the `G` of
`Work.SSGRoute.ZDataMup.exists_frobFamily`/`selection_matching`:

* `hval` — the value identity, `Work.SSGRoute.H9.swChainValueH9`;
* `hpow` — `Work.SSGRoute.NodeS34.swKLevel_localGroup_pow` (the image of the local group at a level
  over `K` is generated by the image of a Frobenius);
* the remaining hypothesis `hroot` is the defining property of the Kummer level
  `L ⊇ K((b_i b_N)^{1/p})`, and the level kernel is discharged by
  `NodeS34.swKLevel_sum_kills_levelKernel` inside `NodeS34.swKLevel_sum_vanish_of_hpow`.
-/

namespace Work.SSGRoute.NodeS34

open _root_.SSGRoute

set_option autoImplicit false
set_option linter.unusedSectionVars false

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] [IsAlgClosed Ω] {K : IntermediateField k Ω} [FiniteDimensional k K]
  [IsGalois k K]

/-- **The chain `hchain` of `H9.ZSix_of_histK` from the Frobenius value identity.**

For every `σ ≠ 1`, `G σ` is a Frobenius element of the local group at the `σ`-sibling
`galLift K σ • Q_N` of the last escape prime (this is the `membership` `hG`, and the cyclicity
`hpow` makes it a Frobenius in the sense needed), and the sum `χ_{b_i} + χ_{b_N}` vanishes at
`G σ`.  Then it vanishes on the whole local group of every `k`-conjugate of `Q_N` that is not a
`K`-conjugate of it. -/
theorem swHchain_of_frobValues
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) (bi bN : (↥K)ˣ)
    (QN : ValuationSubring Ω)
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L]
    (hroot : (Work.SSGRoute.kummerSqrtUnitZMod (Ω := Ω) p (bi * bN) : Ω) ∈ L)
    (G : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hG : ∀ σ : K ≃ₐ[k] K, σ ≠ 1 →
      G σ ∈ SSGRoute.decomp k (Work.SSGRoute.ZDataMup.galLift K σ • QN) ⊓ K.fixingSubgroup)
    (hpow : ∀ (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1),
      ∀ (τ : Ω ≃ₐ[k] Ω)
        (hτ : τ ∈ SSGRoute.decomp k (Work.SSGRoute.ZDataMup.galLift K σ • QN)
          ⊓ K.fixingSubgroup),
        ∃ m : ℤ,
          AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
              ((IntermediateField.fixingSubgroupEquiv K) ⟨τ, (Subgroup.mem_inf.mp hτ).2⟩) =
            (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
              ((IntermediateField.fixingSubgroupEquiv K)
                ⟨G σ, (Subgroup.mem_inf.mp (hG σ hσ)).2⟩)) ^ m)
    (hval : ∀ (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1),
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bi (G σ)
        + Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bN (G σ) = 0) :
    ∀ Q : ValuationSubring Ω, SSGRoute.IsConjPlace k QN Q →
      (¬ ∃ τ ∈ K.fixingSubgroup, τ • QN = Q) →
      ∀ y ∈ SSGRoute.decomp k Q ⊓ K.fixingSubgroup,
        Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bi y
          + Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bN y = 0 := by
  refine Work.SSGRoute.H9.swSiblingVanishing_all (K := K) ζ hζ hζK bi bN QN ?_
  intro σ hσ y hy
  exact swKLevel_sum_vanish_of_hpow (K := K) L ζ hζ hζK bi bN hroot
    (Work.SSGRoute.ZDataMup.galLift K σ • QN) (G σ) (hG σ hσ) (hpow σ hσ) (hval σ hσ) y hy

/-- **The same with the cyclicity input produced from `IsFrobAtPrime`.**  The extra data are exactly
the ones the assembly has: the `K`-prime `𝔮 σ` below the `σ`-sibling of `Q_N` (with its
`valuationSubringAtPrime` identification), its unramifiedness in the level `L`, and the fact that
`G σ` restricts to the Frobenius at `𝔮 σ`.  The cyclicity input is then
`NodeS34.swKLevel_localGroup_pow`. -/
theorem swHchain_of_frobValues_of_isFrobAtPrime
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K) (bi bN : (↥K)ˣ)
    (QN : ValuationSubring Ω)
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L]
    (hroot : (Work.SSGRoute.kummerSqrtUnitZMod (Ω := Ω) p (bi * bN) : Ω) ∈ L)
    (G : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω))
    (hG : ∀ (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1),
      G σ ∈ SSGRoute.decomp k (Work.SSGRoute.ZDataMup.galLift K σ • QN) ⊓ K.fixingSubgroup)
    (hfin : ∀ σ : K ≃ₐ[k] K,
      SSGRoute.IsFinPlace k (Work.SSGRoute.ZDataMup.galLift K σ • QN))
    (𝔮 : (K ≃ₐ[k] K) → IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K))
    (h𝔮 : ∀ σ : K ≃ₐ[k] K,
      (Work.SSGRoute.ZDataMup.galLift K σ • QN).comap (algebraMap ↥K Ω) =
        IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K (𝔮 σ))
    (hunr : ∀ σ : K ≃ₐ[k] K, ∀ P : NK.Chebotarev.PrimeIdeal ↥L,
      P.asIdeal.LiesOver (𝔮 σ).asIdeal →
      P.asIdeal.ramificationIdx (NumberField.RingOfIntegers ↥K) = 1)
    (hfrob : ∀ (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1),
      NK.Chebotarev.IsFrobAtPrime (K := ↥K) (L := ↥L) (𝔮 σ)
        (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) ↥L
          ((IntermediateField.fixingSubgroupEquiv K)
            ⟨G σ, (Subgroup.mem_inf.mp (hG σ hσ)).2⟩)))
    (hval : ∀ (σ : K ≃ₐ[k] K) (hσ : σ ≠ 1),
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bi (G σ)
        + Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bN (G σ) = 0) :
    ∀ Q : ValuationSubring Ω, SSGRoute.IsConjPlace k QN Q →
      (¬ ∃ τ ∈ K.fixingSubgroup, τ • QN = Q) →
      ∀ y ∈ SSGRoute.decomp k Q ⊓ K.fixingSubgroup,
        Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bi y
          + Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ bN y = 0 := by
  refine Work.SSGRoute.H9.swSiblingVanishing_all (K := K) ζ hζ hζK bi bN QN ?_
  intro σ hσ y hy
  exact swKLevel_sum_vanish (K := K) L ζ hζ hζK bi bN hroot
    (Work.SSGRoute.ZDataMup.galLift K σ • QN) (hfin σ) (𝔮 σ) (h𝔮 σ) (hunr σ)
    (G σ) (hG σ hσ) (hfrob σ hσ) (hval σ hσ) y hy

end Work.SSGRoute.NodeS34
