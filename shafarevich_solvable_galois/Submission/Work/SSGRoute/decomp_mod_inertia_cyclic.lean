/-!
# The decomposition group modulo an open subgroup containing the inertia is cyclic

This file proves `Work.SSGRoute.decomp_mod_inertia_cyclic`.

Let `k` be a number field with algebraic closure `Ω`, `B` a place of `Ω` over a finite prime of
`k`, `W ≤ decomp k B` the trace `V ⊓ decomp k B` of an open subgroup `V ≤ G_k` on the
decomposition group, and suppose `W` contains the inertia `I_B` of `B`.  Then `decomp k B ⧸ W` is
cyclic.

The proof is the classical one: choose a finite Galois level `L ⊆ Ω` with `L.fixingSubgroup ≤ V`
(the `L.fixingSubgroup` for finite `L` form a neighbourhood basis of `1` in the Krull topology);
then `decomp k B ⧸ W` is a quotient of the decomposition group `D_P` of the prime `P` of `𝓞 L`
below `B`, and `D_P/I_P ≅ Gal(κ_P/κ_k)` is cyclic, generated by the Frobenius
(`Work.LocalFields.ramificationExactSequence`, `Work.LocalFields.exists_pow_eq_residueFrobenius`).

The one substantial input is that the level inertia `I_P` is contained in the image of `W`; this is
the level-inertia surjectivity: an element acting trivially on the residue field of `L` is, modulo
`L.fixingSubgroup`, an inertia element of `B` (`NK.ResidueFrob.exists_inertia_of_isTrivialOnResidueAtLevel`)
and every inertia element of `B` lies in `W` by hypothesis.  The passage from "trivial on every
level" to `SSGRoute.IsInertia k B` is
`Work.SSGRoute.valuation_sub_lt_one_of_isTrivialAtLevel` +
`Work.SSGRoute.valuation_sub_lt_one_of_all_levels`.
-/

open scoped Pointwise NumberField Topology

namespace Work.SSGRoute

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]

/-- **The level-triviality condition is membership in `Ideal.inertia`.** -/
private theorem isTrivialAtLevel_iff_mem_inertia {B : ValuationSubring Ω}
    (hB : B.comap (algebraMap k Ω) ≠ ⊤)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [Normal k L] [NumberField ↥L]
    (g : Ω ≃ₐ[k] Ω) :
    IsTrivialAtLevel k Ω B hB L g ↔
      AlgEquiv.restrictNormalHom L g ∈
        Ideal.inertia (↥L ≃ₐ[k] ↥L) (levelPrime k Ω B hB L).asIdeal := by
  rw [IsTrivialAtLevel, NK.FrobeniusBridge.IsTrivialOnResidueAtLevel, AddSubgroup.mem_inertia]
  refine forall_congr' fun x => ?_
  have hsmul : (AlgEquiv.restrictNormalHom L g) • x =
      galRestrict (NumberField.RingOfIntegers k) k ↥L (NumberField.RingOfIntegers ↥L)
        (AlgEquiv.restrictNormalHom L g) x := by
    apply NumberField.RingOfIntegers.coe_injective
    rw [algebraMap_galRestrict_apply, algebraMap.smul']
    rfl
  rw [hsmul]
  exact Iff.rfl

/-- **The restriction of the decomposition group of `B` to a finite normal level is the
decomposition group of the trace of `B` on that level.** -/
private theorem map_restrictNormalHom_decomp_eq_stabilizer {B : ValuationSubring Ω}
    (hB : SSGRoute.IsFinPlace k B)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [Normal k L] :
    (SSGRoute.decomp k B).map (AlgEquiv.restrictNormalHom L) =
      MulAction.stabilizer (↥L ≃ₐ[k] ↥L) (B.comap (algebraMap ↥L Ω)) := by
  apply le_antisymm
  · rintro τ ⟨σ, hσ, rfl⟩
    rw [MulAction.mem_stabilizer_iff]
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff] at hσ
    rw [← Commons.FieldTheory.Galois.comap_smul_eq_restrictNormalHom_smul B σ L, hσ]
  · intro τ hτ
    obtain ⟨σ, hσ, hres⟩ := Commons.FieldTheory.Galois.exists_mem_stabilizer_restrictNormalHom_eq
      (F := k) (K' := Ω) B hB L τ hτ
    exact ⟨σ, hσ, hres⟩

/-- **All finite levels together exhaust `B`.**  If `σ` acts trivially on the maximal ideal of
`B` at the elements of every finite normal level, then it acts trivially on the whole maximal
ideal of `B`. -/
private theorem valuation_sub_lt_one_of_all_levels (B : ValuationSubring Ω) (σ : Ω ≃ₐ[k] Ω)
    (h : ∀ (L : IntermediateField k Ω) [FiniteDimensional k L] [Normal k L] [NumberField ↥L],
      ∀ y : Ω, y ∈ L → y ∈ B → B.valuation (σ y - y) < 1)
    {x : Ω} (hx : x ∈ B) : B.valuation (σ x - x) < 1 := by
  have hxint : IsIntegral k x := IsAlgebraic.isIntegral (Algebra.IsAlgebraic.isAlgebraic x)
  haveI : Normal k Ω := inferInstance
  let L₀ : IntermediateField k Ω := IntermediateField.adjoin k {x}
  haveI : Nonempty (L₀ →ₐ[k] Ω) := ⟨L₀.val⟩
  haveI hL₀ : FiniteDimensional k L₀ := IntermediateField.adjoin.finiteDimensional hxint
  let L : IntermediateField k Ω := IntermediateField.normalClosure k L₀ Ω
  haveI hLfin : FiniteDimensional k L := normalClosure.is_finiteDimensional k L₀ Ω
  haveI hLnorm : Normal k L := inferInstance
  haveI hLnf : NumberField ↥L :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField L
  have hxL : x ∈ L :=
    IntermediateField.le_normalClosure L₀
      (IntermediateField.subset_adjoin k ({x} : Set Ω) (Set.mem_singleton x))
  exact h L x hxL hx


/-- **The two descriptions of the prime of a number field extension agree**: the restriction of a
`k`-automorphism to the ring of integers is `galRestrict`, so `MulSemiringAction.toRingHom` of the
Galois action on `𝓞 L` is the ring hom induced by `galRestrict`. -/
private theorem galRestrict_coe_eq_toRingHom {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (τ : L ≃ₐ[K] L) :
    (galRestrict (𝓞 K) K L (𝓞 L) τ : 𝓞 L →+* 𝓞 L) =
      MulSemiringAction.toRingHom (L ≃ₐ[K] L) (𝓞 L) τ := by
  ext y
  rw [MulSemiringAction.toRingHom_apply]
  change algebraMap (𝓞 L) L (((galRestrict (𝓞 K) K L (𝓞 L)) τ) y) =
    algebraMap (𝓞 L) L (τ • y)
  rw [algebraMap_galRestrict_apply, algebraMap.smul']
  rfl

/-- **The stabiliser of a prime is the set of elements fixing its valuation ring** (in the
pointwise sense of the Galois action on the places of `L`). -/
private theorem placeSmul_eq_iff_smul_asIdeal {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) (τ : L ≃ₐ[K] L) :
    Submission.NeukirchUchida.Local.placeSmul τ P = P ↔ τ • P.asIdeal = P.asIdeal := by
  constructor
  · intro h
    have h2 : Ideal.map (galRestrict (𝓞 K) K L (𝓞 L) τ : 𝓞 L →+* 𝓞 L) P.asIdeal = P.asIdeal := by
      conv_rhs => rw [← congrArg IsDedekindDomain.HeightOneSpectrum.asIdeal h]
      rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
    rw [Ideal.pointwise_smul_def, ← galRestrict_coe_eq_toRingHom]
    exact h2
  · intro h
    apply IsDedekindDomain.HeightOneSpectrum.ext
    rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
    rw [Ideal.pointwise_smul_def, ← galRestrict_coe_eq_toRingHom] at h
    exact h

/-- **The stabiliser of a prime ideal is contained in the stabiliser of its valuation ring.** -/
private theorem stabilizer_asIdeal_le_stabilizer_valuationSubringAtPrime {K L : Type*} [Field K] [Field L]
    [NumberField K] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) :
    MulAction.stabilizer (L ≃ₐ[K] L) P.asIdeal ≤
      MulAction.stabilizer (L ≃ₐ[K] L)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime L P) := by
  intro τ hτ
  rw [MulAction.mem_stabilizer_iff] at hτ ⊢
  have hmap : Ideal.map (galRestrict (𝓞 K) K L (𝓞 L) τ : 𝓞 L →+* 𝓞 L) P.asIdeal = P.asIdeal := by
    rw [galRestrict_coe_eq_toRingHom, ← Ideal.pointwise_smul_def]
    exact hτ
  exact Commons.NumberTheory.RamificationInertia.smul_valuationSubringAtPrime_eq_map_galRestrict
    P P τ hmap.symm

/-- **The stabiliser of the valuation ring of a prime is contained in the stabiliser of the
prime ideal.** -/
private theorem stabilizer_valuationSubringAtPrime_le_stabilizer_asIdeal {K L : Type*} [Field K] [Field L]
    [NumberField K] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (P : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) :
    MulAction.stabilizer (L ≃ₐ[K] L)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime L P) ≤
      MulAction.stabilizer (L ≃ₐ[K] L) P.asIdeal := by
  intro τ hτ
  rw [MulAction.mem_stabilizer_iff] at hτ ⊢
  have h1 : τ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) P :=
    (Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
      P τ).mp hτ
  rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup] at h1
  exact (placeSmul_eq_iff_smul_asIdeal P τ).mp h1

/-- **The decomposition group modulo an open subgroup containing the inertia is cyclic.** -/
theorem decomp_mod_inertia_cyclic (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (W : Subgroup (Ω ≃ₐ[k] Ω))
    (hW : ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      W = V ⊓ SSGRoute.decomp k B)
    (hI : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → σ ∈ W) :
    ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ W := by
  classical
  obtain ⟨V, hVopen, hWV⟩ := hW
  -- ## Step 1: a finite normal level `L` with `L.fixingSubgroup ≤ V`
  have hVmem : (V : Set (Ω ≃ₐ[k] Ω)) ∈ 𝓝 (1 : Ω ≃ₐ[k] Ω) := hVopen.mem_nhds V.one_mem
  rw [krullTopology_mem_nhds_one_iff_of_normal k Ω] at hVmem
  obtain ⟨L, hLfin, hLnorm, hLV'⟩ := hVmem
  have hLV : L.fixingSubgroup ≤ V := hLV'
  haveI := hLfin
  haveI := hLnorm
  haveI hLgal : IsGalois k ↥L := Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  haveI hLnf : NumberField ↥L :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField L
  -- ## Step 2: the prime `P` of `𝓞 L` below `B`, and the restriction map `ρ`
  set P : IsDedekindDomain.HeightOneSpectrum (𝓞 ↥L) := levelPrime k Ω B hB L with hPdef
  have hspecA : B.comap (algebraMap ↥L Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P :=
    NK.Reconstruct.primeOfLevel_spec B L (NK.Reconstruct.comap_level_ne_top hB L)
  haveI hLies : P.asIdeal.LiesOver (Submission.NeukirchUchida.primeOf B hB).asIdeal :=
    NK.ResidueFrob.primeOfLevel_liesOver ⟨B, hB⟩ L
  set ρ : ↥(SSGRoute.decomp k B) →* (↥L ≃ₐ[k] ↥L) :=
    (AlgEquiv.restrictNormalHom L).comp (SSGRoute.decomp k B).subtype with hρdef
  set W' : Subgroup ↥(SSGRoute.decomp k B) := W.subgroupOf (SSGRoute.decomp k B) with hW'def
  set Z : Subgroup (↥L ≃ₐ[k] ↥L) := W'.map ρ with hZdef
  have hker : ρ.ker = (L.fixingSubgroup).subgroupOf (SSGRoute.decomp k B) := by
    rw [hρdef, ← MonoidHom.comap_ker, IntermediateField.restrictNormalHom_ker,
      Subgroup.comap_subtype]
  have hfixleW : (L.fixingSubgroup).subgroupOf (SSGRoute.decomp k B) ≤ W' := by
    intro x hx
    rw [Subgroup.mem_subgroupOf] at hx ⊢
    rw [hWV]
    exact ⟨hLV hx, x.2⟩
  -- translation of the stabilisers of the prime ideal and of its valuation ring
  have hbridge : ∀ τ : ↥L ≃ₐ[k] ↥L, τ ∈ MulAction.stabilizer (↥L ≃ₐ[k] ↥L) P.asIdeal →
      τ ∈ MulAction.stabilizer (↥L ≃ₐ[k] ↥L) (B.comap (algebraMap ↥L Ω)) := by
    intro τ hτ
    have h2 := stabilizer_asIdeal_le_stabilizer_valuationSubringAtPrime (K := k) (L := ↥L) P hτ
    rwa [← hspecA] at h2
  have hbridge' : ∀ τ : ↥L ≃ₐ[k] ↥L,
      τ ∈ MulAction.stabilizer (↥L ≃ₐ[k] ↥L) (B.comap (algebraMap ↥L Ω)) →
      τ ∈ MulAction.stabilizer (↥L ≃ₐ[k] ↥L) P.asIdeal := by
    intro τ hτ
    rw [hspecA] at hτ
    exact stabilizer_valuationSubringAtPrime_le_stabilizer_asIdeal (K := k) (L := ↥L) P hτ
  -- ## Step 3: the level inertia is contained in the image of `W`
  have hcrux : Ideal.inertia (↥L ≃ₐ[k] ↥L) P.asIdeal ≤ Z := by
    intro τ hτ
    -- an extension of `τ` to `Ω`
    set g : Ω ≃ₐ[k] Ω := τ.liftNormal Ω with hgdef
    have hgτ : AlgEquiv.restrictNormalHom L g = τ := by
      rw [hgdef, show AlgEquiv.restrictNormalHom L (τ.liftNormal Ω) =
        (τ.liftNormal Ω).restrictNormal ↥L from rfl]
      exact AlgEquiv.restrict_liftNormal (K₁ := ↥L) (E := Ω) τ
    have htrivg : IsTrivialAtLevel k Ω B hB L g :=
      (isTrivialAtLevel_iff_mem_inertia hB L g).mpr (by rw [hgτ]; exact hτ)
    -- lift to the decomposition group of `B`
    obtain ⟨h, hh, hhres⟩ :=
      NK.ResidueFrob.exists_mem_decompositionGroup_restrictNormalHom_eq ⟨B, hB⟩ L htrivg
    have hhτ : AlgEquiv.restrictNormalHom L h = τ := by rw [hhres, hgτ]
    have htrivh : IsTrivialAtLevel k Ω B hB L h :=
      (isTrivialAtLevel_iff_mem_inertia hB L h).mpr (by rw [hhτ]; exact hτ)
    -- the level inertia is covered by the inertia of `B`
    obtain ⟨δ, hδ, hδ1, hδtriv⟩ :=
      NK.ResidueFrob.exists_inertia_of_isTrivialOnResidueAtLevel ⟨B, hB⟩ L h hh htrivh
    have hδh : δ * h ∈ SSGRoute.decomp k B := Subgroup.mul_mem _ hδ hh
    have hlev : ∀ (L' : IntermediateField k Ω) [FiniteDimensional k L'] [Normal k L']
        [NumberField ↥L'], ∀ y : Ω, y ∈ L' → y ∈ B →
        B.valuation ((δ * h) y - y) < 1 := by
      intro L' _ _ _ y hyL' hyB'
      exact Work.SSGRoute.valuation_sub_lt_one_of_isTrivialAtLevel (k := k) (Ω := Ω) B hB L'
        (δ * h) hδh (hδtriv L') hyL' hyB'
    have hval : ∀ y : Ω, y ∈ B → B.valuation ((δ * h) y - y) < 1 :=
      fun y hy => valuation_sub_lt_one_of_all_levels B (δ * h) hlev hy
    have hInertia : SSGRoute.IsInertia k B (δ * h) := ⟨hδh, hval⟩
    have hmemW : δ * h ∈ W := hI (δ * h) hInertia
    have hτeq : τ = ρ ⟨δ * h, hδh⟩ := by
      rw [hρdef]
      simp only [MonoidHom.comp_apply, Subgroup.subtype_apply, map_mul, hδ1, one_mul, hhτ]
    rw [hτeq]
    exact Subgroup.mem_map_of_mem ρ (Subgroup.mem_subgroupOf.mpr hmemW)
  -- ## Step 4: a Frobenius generator of the decomposition group modulo the inertia
  obtain ⟨f, hfgen⟩ := Work.LocalFields.exists_generator_mod_inertia (K := k) (L := ↥L)
    (Submission.NeukirchUchida.primeOf B hB) P
  have hfD : (f : ↥L ≃ₐ[k] ↥L) ∈ (SSGRoute.decomp k B).map (AlgEquiv.restrictNormalHom L) := by
    rw [map_restrictNormalHom_decomp_eq_stabilizer (B := B) hB L]
    exact hbridge (f : ↥L ≃ₐ[k] ↥L) f.2
  obtain ⟨g, hg, hgf⟩ := hfD
  refine ⟨g, hg, fun δ hδ => ?_⟩
  have hσmem : ρ ⟨δ, hδ⟩ ∈ Work.LocalFields.decompositionGroup k P := by
    have h1 : ρ ⟨δ, hδ⟩ ∈
        MulAction.stabilizer (↥L ≃ₐ[k] ↥L) (B.comap (algebraMap ↥L Ω)) := by
      rw [← map_restrictNormalHom_decomp_eq_stabilizer (B := B) hB L]
      refine Subgroup.mem_map.mpr ⟨δ, hδ, ?_⟩
      rw [hρdef]
      rfl
    exact hbridge' (ρ ⟨δ, hδ⟩) h1
  obtain ⟨m, hm⟩ := hfgen ⟨ρ ⟨δ, hδ⟩, hσmem⟩
  have hmI : (ρ ⟨δ, hδ⟩)⁻¹ * (f : ↥L ≃ₐ[k] ↥L) ^ m ∈
      Ideal.inertia (↥L ≃ₐ[k] ↥L) P.asIdeal := Subgroup.mem_subgroupOf.mp hm
  have hmZ : (ρ ⟨δ, hδ⟩)⁻¹ * (f : ↥L ≃ₐ[k] ↥L) ^ m ∈ Z := hcrux hmI
  obtain ⟨w, hw, hwρ⟩ := Subgroup.mem_map.mp hmZ
  have hx : ρ ((⟨δ, hδ⟩ : ↥(SSGRoute.decomp k B))⁻¹ * (⟨g, hg⟩ : ↥(SSGRoute.decomp k B)) ^ m) =
      (ρ ⟨δ, hδ⟩)⁻¹ * (f : ↥L ≃ₐ[k] ↥L) ^ m := by
    rw [hρdef]
    simp only [MonoidHom.comp_apply, Subgroup.subtype_apply, Subgroup.coe_mul, Subgroup.coe_inv,
      Subgroup.coe_zpow, map_mul, map_zpow, map_inv, hgf]
  have hxker : ((⟨δ, hδ⟩ : ↥(SSGRoute.decomp k B))⁻¹ *
      (⟨g, hg⟩ : ↥(SSGRoute.decomp k B)) ^ m * w⁻¹) ∈ ρ.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, hx, hwρ, mul_inv_cancel]
  have hxW' : ((⟨δ, hδ⟩ : ↥(SSGRoute.decomp k B))⁻¹ *
      (⟨g, hg⟩ : ↥(SSGRoute.decomp k B)) ^ m * w⁻¹) ∈ W' := by
    rw [hker] at hxker
    exact hfixleW hxker
  have hmain : ((⟨δ, hδ⟩ : ↥(SSGRoute.decomp k B))⁻¹ *
      (⟨g, hg⟩ : ↥(SSGRoute.decomp k B)) ^ m) ∈ W' := by
    have h := W'.mul_mem hxW' hw
    simpa [mul_assoc] using h
  have hfin : (δ⁻¹ * g ^ m) ∈ W := by
    have h := Subgroup.mem_subgroupOf.mp hmain
    rwa [Subgroup.coe_mul, Subgroup.coe_inv, Subgroup.coe_zpow] at h
  exact ⟨m, hfin⟩

end Work.SSGRoute
