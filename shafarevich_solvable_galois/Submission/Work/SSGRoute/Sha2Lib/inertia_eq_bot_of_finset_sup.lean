/-- If `σ` fixes pointwise each member of a finite family of intermediate fields, then `σ` fixes
pointwise their supremum (compositum). -/
lemma mem_fixingSubgroup_finset_sup {F E : Type*} [Field F] [Field E] [Algebra F E]
    {ι : Type} (s : Finset ι) (f : ι → IntermediateField F E) (σ : E ≃ₐ[F] E)
    (h : ∀ i ∈ s, σ ∈ (f i).fixingSubgroup) : σ ∈ (s.sup f).fixingSubgroup := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.sup_insert, IntermediateField.fixingSubgroup_sup]
      exact ⟨h a (Finset.mem_insert_self a s),
        ih fun i hi => h i (Finset.mem_insert_of_mem hi)⟩

/-- **The inertia subgroup is trivial in a compositum of finitely many unramified-at-`Q` levels.**

This is the finitely-indexed family version of `inertia_eq_bot_of_sup`: `↥L` is generated over `k`
by the image of `K` and the fields `Lᵢ` (`hgenL`), and each `Lᵢ/k` is unramified at the prime
`w i` of `↥(Lᵢ i)` below `q'` (`hunr`); then the inertia subgroup of `L/K` at `q'` is trivial.

Proof: a `σ` in the inertia subgroup of `q'` restricts to an inertial `k`-automorphism
(`isInertiaAt_restrictScalars`), which therefore fixes each `↥(Lᵢ i)` pointwise
(`restrictNormalHom_eq_one_of_isInertiaAt`); it also fixes the image of `K`.  Since `↥L` is
generated by these fields, `σ = 1`. -/
theorem inertia_eq_bot_of_finset_sup {k K Ω : Type} [Field k] [NumberField k] [Field K]
    [NumberField K] [Algebra k K] [Field Ω] [IsAlgClosed Ω] [Algebra K Ω] [Algebra k Ω]
    [IsScalarTower k K Ω]
    (L : IntermediateField K Ω) [NumberField ↥L] [FiniteDimensional k ↥L] [IsGalois k ↥L]
    {ι : Type} [Fintype ι] (Lᵢ : ι → IntermediateField k Ω)
    [∀ i, NumberField ↥(Lᵢ i)] [∀ i, FiniteDimensional k ↥(Lᵢ i)] [∀ i, IsGalois k ↥(Lᵢ i)]
    [∀ i, Algebra ↥(Lᵢ i) ↥L] [∀ i, IsScalarTower k ↥(Lᵢ i) ↥L]
    (hgenL : L.restrictScalars k ≤
      (IsScalarTower.toAlgHom k K Ω).fieldRange ⊔ Finset.univ.sup Lᵢ)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥L))
    (hq' : q'.asIdeal.LiesOver q.asIdeal)
    (w : ∀ i, IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥(Lᵢ i)))
    (hw : ∀ i, q'.asIdeal.LiesOver (w i).asIdeal)
    (hunr : ∀ i, (w i).asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1) :
    Ideal.inertia (↥L ≃ₐ[K] ↥L) q'.asIdeal = ⊥ := by
  classical
  -- The inclusion `↥L →ₐ[k] Ω` and, for every `i`, the inclusion `↥(Lᵢ i) →ₐ[k] ↥L`.
  let φ : ↥L →ₐ[k] Ω := (L.restrictScalars k).val
  have hφrange : φ.fieldRange = L.restrictScalars k := IntermediateField.fieldRange_val _
  let ψ : (i : ι) → ↥(Lᵢ i) →ₐ[k] ↥L := fun i => IsScalarTower.toAlgHom k ↥(Lᵢ i) ↥L
  -- The image of `↥(Lᵢ i)` in `Ω` under the composite is exactly `Lᵢ i`.
  have hfr : ∀ i, (φ.comp (ψ i)).fieldRange = Lᵢ i :=
    fun i => AlgHom.fieldRange_of_normal (E := Lᵢ i) (φ.comp (ψ i))
  rw [Subgroup.eq_bot_iff_forall]
  intro σ hσ
  -- ## Step 1: `σ` is inertial as a `k`-automorphism of `↥L`.
  have hIn : SSGRoute.PTExt.IsInertiaAt q' (AlgEquiv.restrictScalars k σ) :=
    Work.SSGRoute.E9CaseB.isInertiaAt_restrictScalars q' hσ
  -- ## Step 2: `σ` fixes each `↥(Lᵢ i)` pointwise (as a subfield of `↥L`).
  have hfix : ∀ i (m : ↥(Lᵢ i)), σ (ψ i m) = ψ i m := by
    intro i m
    have hτ : AlgEquiv.restrictNormalHom ↥(Lᵢ i) (AlgEquiv.restrictScalars k σ) = 1 :=
      restrictNormalHom_eq_one_of_isInertiaAt (E := ↥(Lᵢ i)) (L := ↥L) (k := k) q' (w i)
        (hw i) (hunr i) (AlgEquiv.restrictScalars k σ) hIn
    have h := AlgEquiv.restrictNormal_commutes (AlgEquiv.restrictScalars k σ) ↥(Lᵢ i) m
    have h4 : ((AlgEquiv.restrictScalars k σ).restrictNormal ↥(Lᵢ i)) m = m := by
      have h5 : (AlgEquiv.restrictScalars k σ).restrictNormal ↥(Lᵢ i) = 1 := hτ
      rw [h5]; rfl
    rw [h4, AlgEquiv.restrictScalars_apply] at h
    exact h.symm
  -- ## Step 3: `σ` fixes the image of `K` in `↥L`.
  have hfixK : ∀ y : K, σ (algebraMap K ↥L y) = algebraMap K ↥L y := fun y => σ.commutes y
  -- ## Step 4: the fields `Lᵢ i` and the image of `K` lie in `L`, and they generate `L`.
  have hGle : ∀ i, Lᵢ i ≤ L.restrictScalars k := by
    intro i
    rw [← hfr i]
    intro x hx
    rw [AlgHom.mem_fieldRange] at hx
    obtain ⟨m, rfl⟩ := hx
    show ((ψ i m : ↥L) : Ω) ∈ L
    exact (ψ i m).2
  have hAle : (IsScalarTower.toAlgHom k K Ω).fieldRange ≤ L.restrictScalars k := by
    intro x hx
    rw [AlgHom.mem_fieldRange] at hx
    obtain ⟨y, rfl⟩ := hx
    show algebraMap K Ω y ∈ L
    exact L.algebraMap_mem y
  have hsupEq : (IsScalarTower.toAlgHom k K Ω).fieldRange ⊔ Finset.univ.sup Lᵢ
      = L.restrictScalars k :=
    le_antisymm (sup_le hAle (Finset.sup_le fun i _ => hGle i)) hgenL
  -- ## Step 5: `map φ` of the "comap" fields is the original field.
  have hmapS : ∀ S : IntermediateField k Ω, S ≤ L.restrictScalars k → (S.comap φ).map φ = S := by
    intro S hS
    exact IntermediateField.map_comap_eq_self (by rw [hφrange]; exact hS)
  have hmapG : (Finset.univ.sup fun i => (Lᵢ i).comap φ).map φ = Finset.univ.sup Lᵢ := by
    rw [Finset.sup_univ_eq_iSup (f := fun i => (Lᵢ i).comap φ), IntermediateField.map_iSup,
      Finset.sup_univ_eq_iSup (f := Lᵢ)]
    exact iSup_congr fun i => hmapS (Lᵢ i) (hGle i)
  have hWmap : ((IsScalarTower.toAlgHom k K Ω).fieldRange.comap φ ⊔
      Finset.univ.sup (fun i => (Lᵢ i).comap φ)).map φ
      = (IsScalarTower.toAlgHom k K Ω).fieldRange ⊔ Finset.univ.sup Lᵢ := by
    rw [IntermediateField.map_sup, hmapS _ hAle, hmapG]
  -- ## Step 6: the comap fields generate `↥L`.
  have htop : (⊤ : IntermediateField k ↥L) ≤
      (IsScalarTower.toAlgHom k K Ω).fieldRange.comap φ ⊔
        Finset.univ.sup (fun i => (Lᵢ i).comap φ) := by
    intro x _
    have hx1 : (x : Ω) ∈ ((IsScalarTower.toAlgHom k K Ω).fieldRange.comap φ ⊔
        Finset.univ.sup (fun i => (Lᵢ i).comap φ)).map φ := by
      rw [hWmap, hsupEq]
      exact x.2
    rw [IntermediateField.mem_map] at hx1
    obtain ⟨y, hy, hyx⟩ := hx1
    have hyx' : y = x := Subtype.ext hyx
    simpa [hyx'] using hy
  -- ## Step 7: `σ` fixes each of the comap fields pointwise.
  have hfixA' : ∀ x ∈ (IsScalarTower.toAlgHom k K Ω).fieldRange.comap φ, σ x = x := by
    intro x hx
    have hx' : φ x ∈ (IsScalarTower.toAlgHom k K Ω).fieldRange := hx
    rw [AlgHom.mem_fieldRange] at hx'
    obtain ⟨y, hy⟩ := hx'
    change algebraMap K Ω y = (x : Ω) at hy
    have hyx : algebraMap K ↥L y = x := by
      apply Subtype.ext
      change algebraMap K Ω y = (x : Ω)
      exact hy
    rw [← hyx]
    exact hfixK y
  have hfixG' : ∀ i, ∀ x ∈ (Lᵢ i).comap φ, σ x = x := by
    intro i x hx
    have hxL : φ x ∈ Lᵢ i := hx
    have hx' : φ x ∈ (φ.comp (ψ i)).fieldRange := by rw [hfr i]; exact hxL
    rw [AlgHom.mem_fieldRange] at hx'
    obtain ⟨m, hm⟩ := hx'
    have hmx : ψ i m = x := Subtype.ext hm
    rw [← hmx]
    exact hfix i m
  -- ## Step 8: conclude.
  have hmem : AlgEquiv.restrictScalars k σ ∈
      ((IsScalarTower.toAlgHom k K Ω).fieldRange.comap φ ⊔
        Finset.univ.sup (fun i => (Lᵢ i).comap φ)).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · exact (IntermediateField.mem_fixingSubgroup_iff _ _).mpr hfixA'
    · exact mem_fixingSubgroup_finset_sup Finset.univ _ _
        (fun i _ => (IntermediateField.mem_fixingSubgroup_iff _ _).mpr (hfixG' i))
  have hmem' : AlgEquiv.restrictScalars k σ ∈ (⊤ : IntermediateField k ↥L).fixingSubgroup :=
    IntermediateField.fixingSubgroup_le htop hmem
  rw [IntermediateField.fixingSubgroup_top] at hmem'
  have hσ'1 : AlgEquiv.restrictScalars k σ = 1 := Subgroup.mem_bot.mp hmem'
  refine AlgEquiv.ext fun x => ?_
  have h := congrArg (fun f : ↥L ≃ₐ[k] ↥L => f x) hσ'1
  rw [AlgEquiv.restrictScalars_apply] at h
  simpa using h

end Work.SSGRoute.Sha2Lib
