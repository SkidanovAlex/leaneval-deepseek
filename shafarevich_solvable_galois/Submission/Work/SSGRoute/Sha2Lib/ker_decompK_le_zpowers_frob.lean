/-!
# The kernel of `Gal(L/k) →* Gal(K/k)` inside the decomposition group of an unramified place

Let `k ⊆ K ⊆ L` be a tower of number fields with `K/k` and `L/k` finite Galois (so that `L/K` is
finite Galois too), `q'` a nonzero prime of `𝓞 L` which is unramified over the prime `q` of
`𝓞 K` below it, and `F : L ≃ₐ[K] L` a Frobenius element at `q'` (for the extension `L/K`).

The main result `ker_decompK_le_zpowers_frob` is the classical statement that the decomposition
group of the place `q'` *inside the kernel*

`ker (Gal(L/k) →* Gal(K/k)) = {g : L ≃ₐ[k] L | g|_K = id} ≅ Gal(L/K)`

is the cyclic group generated by `F` (viewed as a `k`-algebra automorphism of `L`):

`ker(galRes k K L) ∩ D_{q'}  ≤  ⟨F.restrictScalars k⟩.`

The mechanism is cardinality-free.  The place `w = Place.ofFinite q'` of `L` is fixed by an
automorphism iff the induced automorphism of `𝓞 L` fixes the prime `q'`; since the induced
automorphism of `𝓞 L` only depends on the underlying *function* `L → L`, the stabiliser of `w`
inside `Gal(L/k)` meets the kernel exactly in the image of the stabiliser of `w` inside
`Gal(L/K)`.  That last group is the decomposition group of `q'` over `K`, which for an unramified
prime is generated by any Frobenius element (`NK.Chebotarev.IsFrobAtStabilizes`,
`NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg`,
`NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt`).

## Main results

* `resKerToGalK` : a `k`-algebra automorphism of `L` restricting to the identity on `K` is a
  `K`-algebra automorphism of `L` (same underlying function);
* `mem_decompK_iff_mem_stabilizer_of_restrictScalars` : the transfer of the stabiliser of a
  finite place along `AlgEquiv.restrictScalars`;
* `stabilizer_ofFinite_eq_zpowers_of_isFrobAt` : the stabiliser of an unramified finite place
  over `K` is generated by a Frobenius element;
* `ker_decompK_le_zpowers_frob` : the statement requested.
-/

namespace Work.SSGRoute.Sha2Lib

open scoped Pointwise

set_option linter.unusedSectionVars false

section Helpers

variable {k K L : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Field L]
  [NumberField L] [Algebra k K] [Algebra k L] [Algebra K L] [IsScalarTower k K L]
  [FiniteDimensional k K] [IsGalois k K] [FiniteDimensional k L] [IsGalois k L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **An element of the kernel of the restriction `Gal(L/k) →* Gal(K/k)` is a `K`-algebra
automorphism of `L`.**  Its underlying function is unchanged. -/
noncomputable def resKerToGalK (g : (SSGRoute.PTExt.galRes k K L).ker) : L ≃ₐ[K] L :=
  { (g : L ≃ₐ[k] L).toRingEquiv with
    commutes' := fun x => by
      have h1 : (g : L ≃ₐ[k] L).restrictNormal K = 1 := g.2
      have h2 := AlgEquiv.restrictNormal_commutes (g : L ≃ₐ[k] L) K x
      rw [h1] at h2
      simpa using h2.symm }

@[simp]
lemma resKerToGalK_apply (g : (SSGRoute.PTExt.galRes k K L).ker) (x : L) :
    resKerToGalK g x = (g : L ≃ₐ[k] L) x := rfl

/-- The descent of a kernel element has the same underlying function, hence restricting scalars
back from `K` to `k` recovers the original automorphism. -/
lemma restrictScalars_resKerToGalK (g : (SSGRoute.PTExt.galRes k K L).ker) :
    AlgEquiv.restrictScalars k (resKerToGalK g) = (g : L ≃ₐ[k] L) :=
  AlgEquiv.ext fun _ => rfl

/-- **The action on a finite place only depends on the underlying function of the automorphism.**

For `σ : L ≃ₐ[K] L`, viewing `σ` as a `k`-algebra automorphism of `L` (via
`AlgEquiv.restrictScalars`) does not change the induced action on the places of `L`. -/
lemma restrictScalars_smul_ofFinite (σ : L ≃ₐ[K] L)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :
    (AlgEquiv.restrictScalars k σ) • (NK.GlobalCFT.Place.ofFinite q) =
      σ • (NK.GlobalCFT.Place.ofFinite q) := by
  rw [NK.GlobalCFT.Place.smul_ofFinite, NK.GlobalCFT.Place.smul_ofFinite,
    NK.GlobalCFT.Place.ofFinite_inj, IsDedekindDomain.HeightOneSpectrum.ext_iff,
    NK.GlobalCFT.Place.smulHeightOneSpectrum_asIdeal,
    NK.GlobalCFT.Place.smulHeightOneSpectrum_asIdeal]
  congr 1
  try rfl

/-- **Transfer of the decomposition group along `AlgEquiv.restrictScalars`.** -/
lemma mem_decompK_iff_mem_stabilizer_of_restrictScalars (σ : L ≃ₐ[K] L)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :
    AlgEquiv.restrictScalars k σ ∈ SSGRoute.PTExt.decompK (k := k) (K := L)
        (NK.GlobalCFT.Place.ofFinite q) ↔
      σ ∈ MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q) := by
  change AlgEquiv.restrictScalars k σ ∈
      MulAction.stabilizer (L ≃ₐ[k] L) (NK.GlobalCFT.Place.ofFinite q) ↔ _
  rw [MulAction.mem_stabilizer_iff, MulAction.mem_stabilizer_iff,
    restrictScalars_smul_ofFinite]

end Helpers

/-- **The stabiliser of a finite place of `L` is the decomposition group of the prime below it**
(in the form used by the Neukirch–Uchida formalisation). -/
lemma mem_stabilizer_ofFinite_iff_decompositionSubgroup {K L : Type} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (σ : L ≃ₐ[K] L)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :
    σ ∈ MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q) ↔
      σ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) q := by
  rw [Work.SSGRoute.mem_stabilizer_ofFinite_iff q σ,
    Submission.NeukirchUchida.Local.mem_decompositionSubgroup,
    IsDedekindDomain.HeightOneSpectrum.ext_iff,
    Submission.NeukirchUchida.Local.placeSmul_asIdeal]
  try exact Iff.rfl

/-- **The stabiliser of an unramified finite place is generated by a Frobenius element.** -/
theorem stabilizer_ofFinite_eq_zpowers_of_isFrobAt {K L : Type} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hunr : q'.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1)
    (F : L ≃ₐ[K] L) (hF : NK.Chebotarev.IsFrobAt q' F) :
    MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q') =
      Subgroup.zpowers F := by
  have hbridge : MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q') =
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) q' :=
    Subgroup.ext fun σ =>
      mem_stabilizer_ofFinite_iff_decompositionSubgroup (K := K) (L := L) σ q'
  rw [hbridge]
  exact NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt (K := K) (N := L)
    q' F hunr hF

theorem ker_decompK_le_zpowers_frob {k K L : Type} [Field k] [NumberField k] [Field K]
    [NumberField K] [Field L] [NumberField L] [Algebra k K] [Algebra k L] [Algebra K L]
    [IsScalarTower k K L] [FiniteDimensional k K] [IsGalois k K] [FiniteDimensional k L]
    [IsGalois k L] [FiniteDimensional K L] [IsGalois K L]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hq' : q'.asIdeal.LiesOver q.asIdeal)
    (hunr : q'.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1)
    (F : L ≃ₐ[K] L) (hF : NK.Chebotarev.IsFrobAt q' F) :
    ∀ g : (SSGRoute.PTExt.galRes k K L).ker,
      (g : L ≃ₐ[k] L) ∈ SSGRoute.PTExt.decompK (k := k) (K := L)
          (NK.GlobalCFT.Place.ofFinite q') →
        (g : L ≃ₐ[k] L) ∈ Subgroup.zpowers (AlgEquiv.restrictScalars k F) := by
  -- the stabiliser of `q'` inside `Gal(L/K)` is `⟨F⟩`
  have hstabK : MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q') =
      Subgroup.zpowers F :=
    stabilizer_ofFinite_eq_zpowers_of_isFrobAt (K := K) (L := L) q' hunr F hF
  intro g hg
  -- the kernel element, viewed as a `K`-algebra automorphism of `L`
  have hres : AlgEquiv.restrictScalars k (resKerToGalK (k := k) (K := K) (L := L) g) =
      (g : L ≃ₐ[k] L) :=
    restrictScalars_resKerToGalK (k := k) (K := K) (L := L) g
  have hgK : resKerToGalK (k := k) (K := K) (L := L) g ∈
      MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q') := by
    refine (mem_decompK_iff_mem_stabilizer_of_restrictScalars (k := k) (K := K) (L := L)
      (resKerToGalK (k := k) (K := K) (L := L) g) q').mp ?_
    rw [hres]
    exact hg
  -- it therefore lies in the cyclic group generated by `F`
  have hmem : resKerToGalK (k := k) (K := K) (L := L) g ∈ Subgroup.zpowers F := by
    rw [← hstabK]
    exact hgK
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hmem
  -- and so does the original element, as the `n`-th power of `F.restrictScalars k`
  have hmap : (AlgEquiv.restrictScalarsHom k) (F ^ n) =
      ((AlgEquiv.restrictScalarsHom k) F) ^ n :=
    map_zpow (AlgEquiv.restrictScalarsHom k) F n
  rw [hn] at hmap
  rw [Subgroup.mem_zpowers_iff]
  refine ⟨n, ?_⟩
  change ((AlgEquiv.restrictScalarsHom k) F) ^ n = (g : L ≃ₐ[k] L)
  rw [← hmap]
  exact hres

end Work.SSGRoute.Sha2Lib
