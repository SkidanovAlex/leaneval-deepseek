namespace Work.SSGRoute

/-- A locally constant function on a compact topological group is locally constant *on* the whole
group in the sense of `SSGRoute.IsLocConstOn`: it is invariant under right translation by an open
subgroup.

The argument is uniform: the agreement set `{(g, u) | f (g * u) = f g}` is open in `Γ × Γ`
(because `f` is locally constant) and contains `Γ × {1}`; the compactness of `Γ` (tube lemma) then
produces a single open neighbourhood `t ∋ 1` with `f (g * u) = f g` for all `g` and all `u ∈ t`.
Taking the subgroup generated by `t` (which is open since `t` is an open neighbourhood of `1`)
finishes. -/
theorem bridge_isLocConstOn_top_of_isLocallyConstant {Γ M : Type} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ] [AddCommGroup M] (f : Γ → M) (hf : Work.AbsoluteKummer.IsLocallyConstant f) : SSGRoute.IsLocConstOn (⊤ : Subgroup Γ) f := by
  -- The set of pairs `(g, u)` on which `f (g * u) = f g` is open.
  have hZ : IsOpen {p : Γ × Γ | f (p.1 * p.2) = f p.1} := by
    rw [isOpen_iff_forall_mem_open]
    rintro ⟨g, u⟩ (hgu : f (g * u) = f g)
    obtain ⟨W₁, hW₁o, hW₁mem, hW₁c⟩ := hf (g * u)
    obtain ⟨W₂, hW₂o, hW₂mem, hW₂c⟩ := hf g
    refine ⟨{p : Γ × Γ | p.1 * p.2 ∈ W₁ ∧ p.1 ∈ W₂}, ?sub, ?opn, ?mem⟩
    · rintro ⟨g', u'⟩ ⟨h1, h2⟩
      show f (g' * u') = f g'
      rw [hW₁c (g' * u') h1, hgu, hW₂c g' h2]
    · exact (continuous_mul.isOpen_preimage W₁ hW₁o).inter (hW₂o.preimage continuous_fst)
    · exact ⟨hW₁mem, hW₂mem⟩
  have hsub : Set.univ ×ˢ ({1} : Set Γ) ⊆ {p : Γ × Γ | f (p.1 * p.2) = f p.1} := by
    rintro ⟨g, x⟩ ⟨-, hx⟩
    rw [Set.mem_singleton_iff] at hx
    subst hx
    simp
  -- Compactness (tube lemma) turns this into a single open neighbourhood `t` of `1`.
  obtain ⟨s, t, _hso, hto, hs, ht, hst⟩ :=
    generalized_tube_lemma (s := Set.univ) (t := {1}) isCompact_univ isCompact_singleton hZ hsub
  -- The set of periods of `f` is a subgroup.
  set P : Subgroup Γ :=
    { carrier := {u | ∀ g : Γ, f (g * u) = f g}
      one_mem' := by intro g; simp
      mul_mem' := by
        intro a b ha hb g
        show f (g * (a * b)) = f g
        rw [← mul_assoc, hb (g * a), ha g]
      inv_mem' := by
        intro a ha g
        have h := ha (g * a⁻¹)
        rw [← h, mul_assoc, inv_mul_cancel, mul_one] }
  have hvP : t ⊆ (P : Set Γ) := by
    intro x hx g
    exact hst (Set.mk_mem_prod (hs (Set.mem_univ g)) hx)
  refine ⟨Subgroup.closure t, ?_, ?_⟩
  · -- `t` is an open neighbourhood of `1`, hence the subgroup it generates is open.
    apply Subgroup.isOpen_of_one_mem_interior
    exact interior_maximal Subgroup.subset_closure hto (ht (Set.mem_singleton 1))
  · intro g _ u hu _
    exact ((Subgroup.closure_le P).mpr hvP hu) g

end Work.SSGRoute
