namespace Work.SSGRoute

set_option linter.style.haveILetI false in
/-- **The `p`-torsion of a cyclic finite abelian group of order `n`**: if `A` is an additive
commutative group of cardinality `n ≠ 0` containing an element `a` of additive order `n`, and
`p` is a prime dividing `n`, then the `p`-torsion subgroup `P = {v : A | p • v = 0}` of `A` is
cyclic of order `p`: there is an additive map `χ : P →+ ZMod p` which is bijective.

(Such an `A` is cyclic of order `n` — `zmultiples a` has cardinality `addOrderOf a = n =
Nat.card A` — so it is `ℤ/n`; its `p`-torsion is the subgroup generated by `(n/p) • a`, which has
order `p`.) -/
theorem pTorsion_zmod (A : Type) [AddCommGroup A] (p n : ℕ) [Fact p.Prime]
    (hn : n ≠ 0) (hp : p ∣ n) (a : A) (ha : addOrderOf a = n) (hcard : Nat.card A = n) :
    ∃ (P : AddSubgroup A) (χ : P →+ ZMod p),
      (∀ v : A, v ∈ P ↔ p • v = 0) ∧ Function.Bijective χ := by
  have hp_prime : p.Prime := Fact.out
  -- `A` is finite, and `a` generates it.
  haveI : Finite A := (Nat.card_ne_zero.mp (by rw [hcard]; exact hn)).2
  have hgen : ∀ x : A, x ∈ AddSubgroup.zmultiples a := by
    have hH : AddSubgroup.zmultiples a = ⊤ := by
      apply AddSubgroup.eq_top_of_card_eq
      rw [Nat.card_zmultiples, ha, hcard]
    intro x; rw [hH]; exact AddSubgroup.mem_top x
  have hna : n • a = 0 := by
    rw [← ha]; exact addOrderOf_dvd_iff_nsmul_eq_zero.mp (dvd_refl (addOrderOf a))
  have hpm : p * (n / p) = n := Nat.mul_div_cancel' hp
  -- The generator of the `p`-torsion: `g0 = (n/p) • a`, of order `p`.
  have hgorder : addOrderOf ((n / p) • a) = p := by
    rw [addOrderOf_nsmul, ha]
    have hdvd : n / p ∣ n := Nat.div_dvd_of_dvd hp
    rw [Nat.gcd_eq_right hdvd]
    exact Nat.div_div_self hp hn
  have hpg : p • ((n / p) • a) = 0 := by
    rw [← mul_nsmul, Nat.mul_comm (n / p) p, Nat.mul_div_cancel' hp, hna]
  -- The `p`-torsion is exactly `zmultiples ((n/p) • a)`.
  have hmem : ∀ v : A, v ∈ AddSubgroup.zmultiples ((n / p) • a) ↔ p • v = 0 := by
    intro v
    constructor
    · intro hv
      rw [AddSubgroup.mem_zmultiples_iff] at hv
      obtain ⟨k, rfl⟩ := hv
      rw [smul_comm, hpg, smul_zero]
    · intro hv
      rw [AddSubgroup.mem_zmultiples_iff]
      have hvgen : v ∈ AddSubgroup.zmultiples a := hgen v
      rw [AddSubgroup.mem_zmultiples_iff] at hvgen
      obtain ⟨k, hk⟩ := hvgen
      have hk0 : ((p : ℤ) * k) • a = 0 := by
        rw [mul_zsmul, natCast_zsmul, hk, hv]
      have hdiv : (n : ℤ) ∣ (p : ℤ) * k := by
        have h := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hk0
        simpa [ha] using h
      have hpne : (p : ℤ) ≠ 0 := by exact_mod_cast hp_prime.ne_zero
      have hdiv2 : ((n / p : ℕ) : ℤ) ∣ k := by
        have hmul : (n : ℤ) = (p : ℤ) * ((n / p : ℕ) : ℤ) := by
          rw [← Nat.cast_mul, hpm]
        have h2 : (p : ℤ) * ((n / p : ℕ) : ℤ) ∣ (p : ℤ) * k := by rwa [← hmul]
        exact (Int.mul_dvd_mul_iff_left hpne).mp h2
      obtain ⟨j, hj⟩ := hdiv2
      refine ⟨j, ?_⟩
      calc j • ((n / p) • a) = j • (((n / p : ℕ) : ℤ) • a) := by rw [natCast_zsmul]
        _ = (j * ((n / p : ℕ) : ℤ)) • a := by rw [← mul_zsmul]
        _ = (((n / p : ℕ) : ℤ) * j) • a := by rw [mul_comm]
        _ = k • a := by rw [← hj]
        _ = v := hk
  -- Package the `p`-torsion as a subgroup isomorphic to `ZMod p`.
  let g0 : A := (n / p) • a
  let P : AddSubgroup A := AddSubgroup.zmultiples g0
  have hcardP : Nat.card P = p := by
    show Nat.card (AddSubgroup.zmultiples g0) = p
    rw [Nat.card_zmultiples, hgorder]
  let gg : P := ⟨g0, AddSubgroup.mem_zmultiples g0⟩
  have hgP : ∀ x : P, x ∈ AddSubgroup.zmultiples gg := by
    intro x
    rw [AddSubgroup.mem_zmultiples_iff]
    have hx : (x : A) ∈ AddSubgroup.zmultiples g0 := x.2
    rw [AddSubgroup.mem_zmultiples_iff] at hx
    obtain ⟨k, hk⟩ := hx
    refine ⟨k, ?_⟩
    ext
    rw [AddSubgroup.coe_zsmul]
    exact hk
  let ψ : ZMod p ≃+ P := zmodAddEquivOfGenerator hgP hcardP
  refine ⟨P, (ψ.symm : P →+ ZMod p), ?_, ψ.symm.bijective⟩
  intro v
  exact hmem v

end Work.SSGRoute
