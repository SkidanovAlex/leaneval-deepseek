namespace Work.SSGRoute

open scoped Pointwise

/-- **The unramified case of the "transfer" clause of the `z`-form of Theorem 13.**

Let `z` be a cochain on `G_K` which is additive and locally constant there, and suppose that `z`
kills the inertia of every `G_K`-conjugate of the finite place `B`.  Then the transfer
`∑_s s • z ((sec s)⁻¹ * δ * sec s)` is the restriction to `G_K` of the corestriction cocycle
`corCocycle k Ω K E z sec`, which kills the inertia of `B`; by
`Work.SSGRoute.exists_cyclic_quotient_subgroup_vanishing` and
`Work.SSGRoute.decomp_mod_inertia_cyclic` there is therefore `V` (open in `G_k`, normalising,
with `decomp k B ⧸ (decomp k B ⊓ V)` cyclic) on which the transfer vanishes.  This is exactly the
last clause of `Work.SSGRoute.shafarevich_z_construction` at `B`.

This is the half of that clause into which no new mathematics enters: the other half — the case
where `z` *is* ramified at a conjugate of `B` — is the content of Schmidt–Wingberg §4. -/
theorem transfer_vanishes_of_unramified
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (z : (Ω ≃ₐ[k] Ω) → E)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzloc : IsLocConstOn K.fixingSubgroup z)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (B : ValuationSubring Ω) (hB : IsFinPlace k B) (hsplit : IsSplitIn k K B)
    (hunram : ∀ (s : K ≃ₐ[k] K) (σ : Ω ≃ₐ[k] Ω), σ ∈ K.fixingSubgroup →
      IsInertia k ((sec s)⁻¹ • B) σ → z σ = 0) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ decomp k B ⊓ V,
        (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0) := by
  classical
  -- the transfer is the corestriction cocycle on `G_K`
  have htransfer : ∀ δ ∈ K.fixingSubgroup, transfer z sec δ = corCocycle k Ω K E z sec δ := by
    intro δ hδ
    rw [corCocycle_restrict k Ω K E z sec δ hδ]
    rfl
  -- the corestriction cocycle is additive on `G_K` and is a cocycle on `G_k`
  have hxadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup,
      corCocycle k Ω K E z sec (g * h)
        = corCocycle k Ω K E z sec g + corCocycle k Ω K E z sec h := by
    intro g hg h hh
    rw [corCocycle_isCocycle k Ω K E z hzadd sec hsec g (Subgroup.mem_top g) h
      (Subgroup.mem_top h), (mem_fixingSubgroup_iff_res_eq_one k Ω K g).mpr hg, one_smul]
  -- it kills the inertia of `B`
  have hI : ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → corCocycle k Ω K E z sec σ = 0 := by
    intro σ hσ
    have hσK : σ ∈ K.fixingSubgroup := hsplit hσ.1
    rw [← htransfer σ hσK]
    unfold transfer
    refine Finset.sum_eq_zero (fun s _ => ?_)
    have hmem : (sec s)⁻¹ * σ * sec s ∈ K.fixingSubgroup :=
      conj_sec_mem_fixingSubgroup hsec s hσK
    have his : IsInertia k ((sec s)⁻¹ • B) ((sec s)⁻¹ * σ * sec s) := by
      simpa using (isInertia_conj B (sec s)⁻¹ σ).mpr hσ
    rw [hunram s _ hmem his, smul_zero]
  obtain ⟨U, ⟨V, hVopen, hUV⟩, hUnorm, hUcyc, hcob⟩ :=
    exists_cyclic_quotient_subgroup_vanishing p k Ω K E (corCocycle k Ω K E z sec)
      (corCocycle_isCocycle k Ω K E z hzadd sec hsec)
      (corCocycle_isLocConstOn k Ω K E z hzloc sec hsec) B hB hI
      (decomp_mod_inertia_cyclic k Ω B hB)
  -- elements of `U` are fixed by `res k K`, hence `x` vanishes on `U`
  have hUle : U ≤ K.fixingSubgroup := by
    intro u hu
    rw [hUV] at hu
    exact hsplit (Subgroup.mem_inf.mp hu).2
  have hxU : ∀ u ∈ U, corCocycle k Ω K E z sec u = 0 := by
    obtain ⟨m₀, hm₀⟩ := hcob
    intro u hu
    rw [hm₀ u hu, (mem_fixingSubgroup_iff_res_eq_one k Ω K u).mpr (hUle hu), one_smul, sub_self]
  refine ⟨V, hVopen, ?_, ?_, ?_⟩
  · -- normality, in the `V`-form
    intro δ hδ u hu
    have hmem : δ * u * δ⁻¹ ∈ U :=
      hUnorm δ hδ u (by rw [hUV]; exact Subgroup.mem_inf.mpr ⟨hu.2, hu.1⟩)
    rw [hUV] at hmem
    exact (Subgroup.mem_inf.mp hmem).1
  · -- the quotient condition, in the `V`-form
    obtain ⟨g, hg, hgU⟩ := hUcyc
    refine ⟨g, hg, fun δ hδ => ?_⟩
    obtain ⟨m, hm⟩ := hgU δ hδ
    refine ⟨m, ?_⟩
    rw [hUV] at hm
    exact (Subgroup.mem_inf.mp hm).1
  · -- vanishing of the transfer
    intro δ hδ
    have hδU : δ ∈ U := by rw [hUV]; exact Subgroup.mem_inf.mpr ⟨hδ.2, hδ.1⟩
    have hδK : δ ∈ K.fixingSubgroup := hsplit hδ.1
    rw [← corCocycle_restrict k Ω K E z sec δ hδK]
    exact hxU δ hδU

end Work.SSGRoute

