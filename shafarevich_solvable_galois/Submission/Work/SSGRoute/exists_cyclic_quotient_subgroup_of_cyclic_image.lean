/-!
# The "`x_p` is cyclic" clause from a cyclic local image

The last clause of Schmidt--Wingberg's Theorem 13 asks that, at every prime `p ∉ T`, the class `x`
be "cyclic", i.e. split by a cyclic extension of the local field.  In the formalisation this is
encoded as: there is a subgroup `U = V ⊓ decomp k B` of the decomposition group (`V` open in `G_k`)
which is normal in `decomp k B`, with `decomp k B / U` generated by one element, and on which `x` is
a coboundary.

This file proves that this clause is *equivalent* to the cyclicity of the local image of `x` in the
case that `B` is completely decomposed in `K|k` (`IsSplitIn k K B`): then `decomp k B ≤ G_K`, the
action of `G_K` on `E` is trivial, and `x|decomp k B` is an honest homomorphism, so that the clause
is witnessed by `U = ker (x|decomp k B)`.
-/

namespace Work.SSGRoute

open _root_.SSGRoute
open scoped Pointwise

/-- **Cyclic image gives the "`x_p` is cyclic" clause.**  If `x` is a locally constant `1`-cocycle on
`G_k = Ω ≃ₐ[k] Ω` (for the action through `res k K`), if `B` is a finite place which is completely
decomposed in `K|k` (so that `decomp k B ≤ K.fixingSubgroup`, where the action of `G_K` on `E` is
trivial and `x|decomp k B` is additive), and if the image of `x` on `decomp k B` is generated by one
element `x g`, then there is a subgroup `U = V ⊓ decomp k B` of `decomp k B` (`V` open in `G_k`),
normal in `decomp k B`, with `decomp k B / U` generated by one element and `x|U` a coboundary. -/
theorem exists_cyclic_quotient_subgroup_of_cyclic_image
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    (x : (Ω ≃ₐ[k] Ω) → E)
    (hx : IsCocycleOn (res k K) ⊤ x) (hlc : IsLocConstOn ⊤ x)
    (B : ValuationSubring Ω) (hB : IsFinPlace k B)
    (hsplit : IsSplitIn k K B)
    (hcyc : ∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ n : ℤ, x δ = n • x g) :
    ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
      (∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
      (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
      (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
      IsCoboundaryOn (res k K) U x := by
  classical
  -- `x` vanishes at `1`
  have hx1 : x 1 = 0 := by
    have h := hx 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
    rw [mul_one, map_one, one_smul] at h
    exact (add_left_cancel (show x 1 + 0 = x 1 + x 1 by rw [add_zero]; exact h)).symm
  -- `hlc` supplies an open subgroup on which `x` vanishes
  obtain ⟨V₀, hV₀open, hV₀inv⟩ := hlc
  have hV₀zero : ∀ u ∈ V₀, x u = 0 := by
    intro u hu
    have h := hV₀inv 1 (Subgroup.mem_top 1) u hu (Subgroup.mem_top u)
    rwa [one_mul, hx1] at h
  -- the kernel of `x`, as a subgroup of `G_k`
  let V : Subgroup (Ω ≃ₐ[k] Ω) :=
    { carrier := {g | x g = 0}
      one_mem' := hx1
      mul_mem' := by
        intro a b ha hb
        change x (a * b) = 0
        rw [hx a (Subgroup.mem_top a) b (Subgroup.mem_top b), ha, hb, smul_zero, add_zero]
      inv_mem' := by
        intro a ha
        change x a⁻¹ = 0
        have h := hx a (Subgroup.mem_top a) a⁻¹ (Subgroup.mem_top a⁻¹)
        rw [mul_inv_cancel, hx1, ha, zero_add] at h
        have h2 : (res k K a) • x a⁻¹ = 0 := h.symm
        have h3 := congrArg (fun m => (res k K a)⁻¹ • m) h2
        simpa [← mul_smul, ← map_mul] using h3 }
  have hVmem : ∀ g : Ω ≃ₐ[k] Ω, g ∈ V ↔ x g = 0 := fun g => Iff.rfl
  have hVopen : IsOpen (V : Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.isOpen_mono (fun u hu => (hVmem u).mpr (hV₀zero u hu)) hV₀open
  -- `res k K` is trivial on the decomposition group of a completely decomposed place
  have hres1 : ∀ δ ∈ decomp k B, res k K δ = 1 := by
    intro δ hδ
    rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker K]
    exact hsplit hδ
  -- hence `x` is additive there
  have hadd : ∀ δ ∈ decomp k B, ∀ ε ∈ decomp k B, x (δ * ε) = x δ + x ε := by
    intro δ hδ ε hε
    rw [hx δ (Subgroup.mem_top δ) ε (Subgroup.mem_top ε), hres1 δ hδ, one_smul]
  -- the resulting homomorphism on the decomposition group
  let φ : decomp k B →* Multiplicative E :=
    { toFun := fun δ => Multiplicative.ofAdd (x δ)
      map_one' := by
        rw [ofAdd_eq_one]
        exact hx1
      map_mul' := by
        intro a b
        change Multiplicative.ofAdd (x (a.val * b.val))
          = Multiplicative.ofAdd (x a.val) * Multiplicative.ofAdd (x b.val)
        rw [hadd a a.2 b b.2, ofAdd_add] }
  obtain ⟨g, hgD, hgcyc⟩ := hcyc
  refine ⟨V ⊓ decomp k B, ⟨V, hVopen, rfl⟩, ?_, ?_, ?_⟩
  · -- `U` is normal in the decomposition group
    intro δ hδ u hu
    obtain ⟨huV, huD⟩ := Subgroup.mem_inf.mp hu
    refine Subgroup.mem_inf.mpr ⟨?_, mul_mem (mul_mem hδ huD) (inv_mem hδ)⟩
    rw [hVmem]
    have h1 := hadd δ hδ (u * δ⁻¹) (mul_mem huD (inv_mem hδ))
    have h2 := hadd u huD δ⁻¹ (inv_mem hδ)
    have h3 := hadd δ hδ δ⁻¹ (inv_mem hδ)
    rw [mul_inv_cancel, hx1] at h3
    have hgoal : x (δ * u * δ⁻¹) = x δ + x δ⁻¹ := by
      rw [show δ * u * δ⁻¹ = δ * (u * δ⁻¹) by group, h1, h2, (hVmem u).mp huV]
      simp
    rw [hgoal]
    exact h3.symm
  · -- `decomp k B / U` is generated by the class of `g`
    refine ⟨g, hgD, fun δ hδ => ?_⟩
    obtain ⟨n, hn⟩ := hgcyc δ hδ
    refine ⟨n, Subgroup.mem_inf.mpr ⟨?_, mul_mem (inv_mem hδ) (zpow_mem hgD n)⟩⟩
    rw [hVmem]
    have hφδ : φ ⟨δ, hδ⟩ = φ ⟨g, hgD⟩ ^ n := by
      change Multiplicative.ofAdd (x δ) = Multiplicative.ofAdd (x g) ^ n
      rw [hn, ofAdd_zsmul]
    have hgz : φ ⟨g ^ n, zpow_mem hgD n⟩ = φ ⟨g, hgD⟩ ^ n := map_zpow φ ⟨g, hgD⟩ n
    have hinv : φ ⟨δ⁻¹, inv_mem hδ⟩ = (φ ⟨δ, hδ⟩)⁻¹ := by
      have h1 : φ ⟨δ⁻¹, inv_mem hδ⟩ * φ ⟨δ, hδ⟩ = 1 := by
        rw [← map_mul]
        have : (⟨δ⁻¹, inv_mem hδ⟩ * ⟨δ, hδ⟩ : decomp k B) = 1 := by ext; simp
        rw [this, map_one]
      exact eq_inv_of_mul_eq_one_left h1
    have hphi : φ ⟨δ⁻¹ * g ^ n, mul_mem (inv_mem hδ) (zpow_mem hgD n)⟩ = 1 := by
      rw [show (⟨δ⁻¹ * g ^ n, mul_mem (inv_mem hδ) (zpow_mem hgD n)⟩ : decomp k B)
          = ⟨δ⁻¹, inv_mem hδ⟩ * ⟨g ^ n, zpow_mem hgD n⟩ from rfl, map_mul, hinv, hgz, hφδ]
      simp
    exact (ofAdd_eq_one).mp hphi
  · -- `x` vanishes on `U`, so it is a coboundary with witness `0`
    refine ⟨0, fun u hu => ?_⟩
    rw [(hVmem u).mp (Subgroup.mem_inf.mp hu).1]
    simp

end Work.SSGRoute

open _root_.SSGRoute

namespace Work.SSGRoute

/-- **The converse of `exists_cyclic_quotient_subgroup_of_cyclic_image`.**  If the "cyclic quotient"
clause of Theorem 13 holds for a `1`-cocycle `x` at a finite place `B` which is completely
decomposed in `K|k`, then the image `x (decomp k B) ⊆ E` is generated by one element.  Hence, at
such a place, clause (7) of Theorem 13 is *equivalent* to the cyclicity of the local image of `x`. -/
theorem cyclic_image_of_exists_cyclic_quotient_subgroup
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    (x : (Ω ≃ₐ[k] Ω) → E)
    (hx : IsCocycleOn (res k K) ⊤ x)
    (B : ValuationSubring Ω) (hB : IsFinPlace k B)
    (hsplit : IsSplitIn k K B)
    (h : ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
      (∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ U = V ⊓ decomp k B) ∧
      (∀ δ ∈ decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
      (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
      IsCoboundaryOn (res k K) U x) :
    ∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ n : ℤ, x δ = n • x g := by
  classical
  obtain ⟨U, hV, -, hcycU, hcob⟩ := h
  obtain ⟨g, hgD, hgU⟩ := hcycU
  obtain ⟨m₀, hm₀⟩ := hcob
  -- elements of `U` lie in the decomposition group
  have hUle : U ≤ decomp k B := by
    obtain ⟨V, -, hUV⟩ := hV
    rw [hUV]
    exact inf_le_right
  -- `res k K` is trivial on the decomposition group
  have hres1 : ∀ δ ∈ decomp k B, res k K δ = 1 := by
    intro δ hδ
    rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker K]
    exact hsplit hδ
  have hx1 : x 1 = 0 := by
    have h := hx 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
    rw [mul_one, map_one, one_smul] at h
    exact (add_left_cancel (show x 1 + 0 = x 1 + x 1 by rw [add_zero]; exact h)).symm
  -- `x` vanishes on `U` (the coboundary clause degenerates, as `res k K = 1` there)
  have hxU : ∀ u ∈ U, x u = 0 := by
    intro u hu
    rw [hm₀ u hu, hres1 u (hUle hu), one_smul, sub_self]
  -- `x` is additive on the decomposition group
  have hadd : ∀ δ ∈ decomp k B, ∀ ε ∈ decomp k B, x (δ * ε) = x δ + x ε := by
    intro δ hδ ε hε
    rw [hx δ (Subgroup.mem_top δ) ε (Subgroup.mem_top ε), hres1 δ hδ, one_smul]
  -- the resulting monoid homomorphism on the decomposition group
  let φ : decomp k B →* Multiplicative E :=
    { toFun := fun δ => Multiplicative.ofAdd (x δ)
      map_one' := (ofAdd_eq_one).mpr hx1
      map_mul' := by
        intro a b
        change Multiplicative.ofAdd (x (a.val * b.val))
          = Multiplicative.ofAdd (x a.val) * Multiplicative.ofAdd (x b.val)
        rw [hadd a a.2 b b.2, ofAdd_add] }
  refine ⟨g, hgD, fun δ hδ => ?_⟩
  obtain ⟨m, hm⟩ := hgU δ hδ
  have hmem : δ⁻¹ * g ^ m ∈ decomp k B := mul_mem (inv_mem hδ) (zpow_mem hgD m)
  have hz : φ ⟨δ⁻¹ * g ^ m, hmem⟩ = 1 := (ofAdd_eq_one).mpr (hxU _ hm)
  have hinvφ : φ ⟨δ⁻¹, inv_mem hδ⟩ = (φ ⟨δ, hδ⟩)⁻¹ :=
    eq_inv_of_mul_eq_one_left (by
      rw [← map_mul]
      have : (⟨δ⁻¹, inv_mem hδ⟩ * ⟨δ, hδ⟩ : decomp k B) = 1 := by ext; simp
      rw [this, map_one])
  have hz' : (φ ⟨δ, hδ⟩)⁻¹ * φ ⟨g, hgD⟩ ^ m = 1 := by
    rw [← hinvφ, ← map_zpow, ← map_mul]
    exact hz
  have hphi : φ ⟨δ, hδ⟩ = φ ⟨g, hgD⟩ ^ m := eq_of_inv_mul_eq_one hz'
  refine ⟨m, ?_⟩
  have h1 := congrArg Multiplicative.toAdd hphi
  rw [toAdd_zpow] at h1
  change x δ = m • x g at h1
  exact h1

end Work.SSGRoute

