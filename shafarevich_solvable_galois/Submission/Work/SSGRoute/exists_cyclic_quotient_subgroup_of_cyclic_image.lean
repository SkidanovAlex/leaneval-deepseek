namespace Work.SSGRoute

open scoped Pointwise

/-- **The transfer collapses to the one conjugate which `z` does not kill.**

Let `z` be a cochain on `G_K`, additive and locally constant there, which vanishes on the whole
local group `decomp k ((sec s)⁻¹ • B) ⊓ G_K` of every `G_K`-conjugate of `B` except the one indexed by
`t`, and whose image on the `t`-th local group is generated by one element.  Then the transfer
`∑_s s • z ((sec s)⁻¹ * δ * sec s)` has image on `decomp k B` generated by one element, and hence (by
`Work.SSGRoute.exists_V_of_cyclic_transfer`) its last clause in the `z`-form of Theorem 13 holds at
`B`.

This is the step by which Schmidt–Wingberg's condition (b) — `z_P^σ = 0` for `σ ≠ 1` together with
`z_P` cyclic — produces the cyclicity of the local component of the corestriction `cor(z)`. -/
theorem transfer_clause_of_single_conjugate
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (z : (Ω ≃ₐ[k] Ω) → E)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hzloc : IsLocConstOn K.fixingSubgroup z)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, res k K (sec s) = s)
    (B : ValuationSubring Ω) (hB : IsFinPlace k B) (hsplit : IsSplitIn k K B)
    (t : K ≃ₐ[k] K)
    (hkill : ∀ s : K ≃ₐ[k] K, s ≠ t → ∀ σ ∈ K.fixingSubgroup,
      σ ∈ decomp k ((sec s)⁻¹ • B) → z σ = 0)
    (hcyc : ∃ g ∈ decomp k ((sec t)⁻¹ • B) ⊓ K.fixingSubgroup,
      ∀ δ ∈ decomp k ((sec t)⁻¹ • B) ⊓ K.fixingSubgroup,
        z δ ∈ AddSubgroup.zmultiples (z g)) :
    ∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
      (∀ δ ∈ decomp k B, ∀ u ∈ decomp k B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
      (∃ g ∈ decomp k B, ∀ δ ∈ decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
      (∀ δ ∈ decomp k B ⊓ V,
        (∑ s : K ≃ₐ[k] K, s • z ((sec s)⁻¹ * δ * sec s)) = 0) := by
  classical
  -- the single surviving summand
  have hsingle : ∀ δ ∈ decomp k B,
      transfer z sec δ = t • z ((sec t)⁻¹ * δ * sec t) := by
    intro δ hδ
    refine Finset.sum_eq_single t (fun s _ hs => ?_) (fun h => absurd (Finset.mem_univ t) h)
    have hmemD : (sec s)⁻¹ * δ * sec s ∈ decomp k ((sec s)⁻¹ • B) := by
      rw [decomp_conj]
      exact Subgroup.mem_map.mpr ⟨δ, hδ, by simp [MulAut.conj_apply]⟩
    have hmemK : (sec s)⁻¹ * δ * sec s ∈ K.fixingSubgroup :=
      conj_sec_mem_fixingSubgroup hsec s (hsplit hδ)
    rw [hkill s hs _ hmemK hmemD, smul_zero]
  -- a generator of the cyclic image of `z` on the `t`-th local group
  obtain ⟨g, hgD, hgc⟩ := hcyc
  -- the corresponding element of `decomp k B`
  have hg_map : g ∈ (decomp k B).map (MulAut.conj (sec t)⁻¹).toMonoidHom := by
    rw [← decomp_conj B (sec t)⁻¹]
    exact hgD.1
  obtain ⟨δ₀, hδ₀D, hδ₀⟩ := Subgroup.mem_map.mp hg_map
  -- the transfer at `δ₀` generates the image
  refine exists_V_of_cyclic_transfer hsec hzadd hzloc B hsplit ⟨δ₀, hδ₀D, ?_⟩
  intro δ hδ
  rw [hsingle δ hδ, hsingle δ₀ hδ₀D]
  -- `(sec t)⁻¹ * δ * sec t` lies in the `t`-th local group
  have hmemD : (sec t)⁻¹ * δ * sec t ∈ decomp k ((sec t)⁻¹ • B) := by
    rw [decomp_conj]
    exact Subgroup.mem_map.mpr ⟨δ, hδ, by simp [MulAut.conj_apply]⟩
  have hmemK : (sec t)⁻¹ * δ * sec t ∈ K.fixingSubgroup :=
    conj_sec_mem_fixingSubgroup hsec t (hsplit hδ)
  have hmemK₀ : (sec t)⁻¹ * δ₀ * sec t ∈ K.fixingSubgroup :=
    conj_sec_mem_fixingSubgroup hsec t (hsplit hδ₀D)
  -- `z` at that element is a multiple of `z g`
  obtain ⟨n, hn⟩ := AddSubgroup.mem_zmultiples_iff.mp
    (hgc _ (Subgroup.mem_inf.mpr ⟨hmemD, hmemK⟩))
  have hg' : (sec t)⁻¹ * δ₀ * sec t = g := by
    have h := MulAut.conj_apply (sec t)⁻¹ δ₀
    rw [← hδ₀]
    exact h.symm
  refine ⟨n, ?_⟩
  rw [← hg'] at hn
  rw [← hn, smul_comm]

end Work.SSGRoute
