/-!
# The unramified subgroup of a level-`K` local `H¹`

At a finite place `B` of the algebraic closure `Ω` the *level-`K` local group* is
`D_B ∩ G_K = decomp k B ⊓ K.fixingSubgroup`: the elements of the decomposition group of `B` which
fix `K`.  A locally constant `1`-cocycle on that group has values in the `Gal(K/k)`-module
`ZMod p`, and since the group lies in the kernel of the restriction `res k K` (the action is
trivial there), the cocycle condition degenerates to additivity and every coboundary is zero.

The *unramified subgroup* at `B` is the `𝔽_p`-subspace of `H¹_loc(D_B ∩ G_K, 𝔽_p)` generated by
the classes of the cocycles which are trivial at every inertia element of `D_B ∩ G_K`, i.e. the
classes which are trivial at the level-`K` inertia subgroup.  The main result
`toClass_mem_unramifiedSubgroup_iff` says that a locally constant cocycle `c` on a subgroup
`H ≤ G_K` represents a class in this subgroup **iff** `c` itself vanishes at every element of `H`
lying in `I_B` — so on the level-`K` local groups this subgroup really is the "unramified at `B`"
subgroup, and the class map detects it pointwise.

The target `levelK_unramifiedSubgroup` is the instance `H = decomp k B ⊓ K.fixingSubgroup`.
-/

open scoped Pointwise TensorProduct

namespace Work.SSGRoute.ZSplit

noncomputable section

open Classical

set_option linter.unusedSectionVars false

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
  [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]

/-- The functions `G_k → 𝔽_p` which vanish at every element of `H` lying in the inertia group
`I_B` of the place `B`.  (`H` itself is arbitrary; this is the `𝔽_p`-submodule cut out by a
pointwise vanishing condition, hence manifestly a submodule.) -/
def vanishOnInertia (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    Submodule (ZMod p) ((Ω ≃ₐ[k] Ω) → ZMod p) where
  carrier := {f | ∀ σ ∈ H, SSGRoute.IsInertia k B σ → f σ = 0}
  zero_mem' := fun σ _ _ => rfl
  add_mem' := by
    intro f g hf hg σ hσ hi
    simp only [Pi.add_apply, hf σ hσ hi, hg σ hσ hi, add_zero]
  smul_mem' := by
    intro a f hf σ hσ hi
    simp only [Pi.smul_apply, hf σ hσ hi, smul_zero]

/-- The locally constant cocycles on `H` that vanish at every inertia element of `H`; a
submodule of the module `lcCocycles` of all locally constant cocycles on `H`. -/
abbrev unramifiedCocycles (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    Submodule (ZMod p) ↥(lcCocycles p k Ω K (ZMod p) H) :=
  Submodule.comap (lcCocycles p k Ω K (ZMod p) H).subtype (vanishOnInertia p k Ω B H)

/-- The coboundaries, as a submodule of the locally constant cocycles (so that `H1loc` is the
quotient of the cocycle module by this submodule). -/
abbrev coboundarySub (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    Submodule (ZMod p) ↥(lcCocycles p k Ω K (ZMod p) H) :=
  Submodule.comap (lcCocycles p k Ω K (ZMod p) H).subtype (coboundaries p k Ω K (ZMod p) H)

/-- **The unramified subgroup** at `B`: the image in `H¹_loc(H, 𝔽_p)` of the locally constant
cocycles on `H` which are trivial at every inertia element of `H`. -/
abbrev unramifiedSubgroup (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    Submodule (ZMod p) (H1loc p k Ω K (ZMod p) H) :=
  Submodule.map (Submodule.mkQ (coboundarySub p k Ω K H)) (unramifiedCocycles p k Ω K B H)

theorem mem_unramifiedSubgroup (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω))
    (x : H1loc p k Ω K (ZMod p) H) :
    x ∈ unramifiedSubgroup p k Ω K B H ↔
      ∃ y ∈ unramifiedCocycles p k Ω K B H,
        Submodule.mkQ (coboundarySub p k Ω K H) y = x := by
  simp only [unramifiedSubgroup]
  exact Submodule.mem_map

theorem mem_unramifiedCocycles (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [DistribMulAction (K ≃ₐ[k] K) (ZMod p)]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω))
    (y : ↥(lcCocycles p k Ω K (ZMod p) H)) :
    y ∈ unramifiedCocycles p k Ω K B H ↔
      ∀ σ ∈ H, SSGRoute.IsInertia k B σ → (y : (Ω ≃ₐ[k] Ω) → ZMod p) σ = 0 := by
  simp only [unramifiedCocycles, Submodule.mem_comap]
  exact Iff.rfl

theorem mem_coboundarySub (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (H : Subgroup (Ω ≃ₐ[k] Ω)) (y : ↥(lcCocycles p k Ω K (ZMod p) H)) :
    y ∈ coboundarySub p k Ω K H ↔
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H ((y : (Ω ≃ₐ[k] Ω) → ZMod p)) := by
  simp only [coboundarySub, Submodule.mem_comap]
  exact Iff.rfl

/-- On a subgroup `H ≤ G_K` lying in the kernel of `res k K`, the class of a locally constant
cocycle `c` lies in the unramified subgroup at `B` **iff** `c` vanishes at every inertia element
of `H`. -/
theorem toClass_mem_unramifiedSubgroup_iff (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [DistribMulAction (K ≃ₐ[k] K) (ZMod p)]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : H ≤ K.fixingSubgroup)
    {c : (Ω ≃ₐ[k] Ω) → ZMod p} (hc : c ∈ lcCocycles p k Ω K (ZMod p) H) :
    toClass p k Ω K (ZMod p) H c ∈ unramifiedSubgroup p k Ω K B H ↔
      ∀ σ ∈ H, SSGRoute.IsInertia k B σ → c σ = 0 := by
  have hker : (SSGRoute.res k K).ker = K.fixingSubgroup := by
    simpa using (IntermediateField.restrictNormalHom_ker (E := K))
  -- every element of `H` has trivial image under the restriction, so its action is trivial
  have hres : ∀ σ ∈ H, SSGRoute.res k K σ = 1 := by
    intro σ hσ
    exact MonoidHom.mem_ker.mp (by rw [hker]; exact hH hσ)
  -- the class of `c` is the class of the cocycle `⟨c, hc⟩`
  have htc : toClass p k Ω K (ZMod p) H c =
      Submodule.mkQ (coboundarySub p k Ω K H) ⟨c, hc⟩ :=
    dif_pos hc
  constructor
  · -- `c` differs from an unramified cocycle by a coboundary, and coboundaries vanish on `H`
    intro hmem
    obtain ⟨y, hy, hyeq⟩ := (mem_unramifiedSubgroup p k Ω K B H _).mp hmem
    have hyv := (mem_unramifiedCocycles p k Ω K B H y).mp hy
    rw [htc] at hyeq
    have hmemN : y - ⟨c, hc⟩ ∈ coboundarySub p k Ω K H := by
      rw [Submodule.mkQ_apply, Submodule.mkQ_apply] at hyeq
      exact (Submodule.Quotient.eq (coboundarySub p k Ω K H)).mp hyeq
    have hmemN' := (mem_coboundarySub p k Ω K H (y - ⟨c, hc⟩)).mp hmemN
    rw [Submodule.coe_sub] at hmemN'
    obtain ⟨m, hm⟩ := hmemN'
    intro σ hσ hi
    have h1 : ((y : (Ω ≃ₐ[k] Ω) → ZMod p) - c) σ = 0 := by
      rw [hm σ hσ, hres σ hσ, one_smul, sub_self]
    have h2 : (y : (Ω ≃ₐ[k] Ω) → ZMod p) σ = 0 := hyv σ hσ hi
    simpa [Pi.sub_apply, h2] using h1
  · -- conversely `c` itself is an unramified cocycle, so its class lies in the image
    intro hv
    refine (mem_unramifiedSubgroup p k Ω K B H _).mpr ⟨⟨c, hc⟩, ?_, ?_⟩
    · exact (mem_unramifiedCocycles p k Ω K B H ⟨c, hc⟩).mpr hv
    · exact htc.symm

theorem levelK_unramifiedSubgroup (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (B : ValuationSubring Ω) :
    ∃ U : Submodule (ZMod p)
        (Work.SSGRoute.H1loc p k Ω K (ZMod p) (SSGRoute.decomp k B ⊓ K.fixingSubgroup)),
      ∀ c : (Ω ≃ₐ[k] Ω) → ZMod p,
        SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k B ⊓ K.fixingSubgroup) c →
        SSGRoute.IsLocConstOn (SSGRoute.decomp k B ⊓ K.fixingSubgroup) c →
        (Work.SSGRoute.toClass p k Ω K (ZMod p) (SSGRoute.decomp k B ⊓ K.fixingSubgroup) c ∈ U ↔
          ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ SSGRoute.decomp k B ⊓ K.fixingSubgroup →
            SSGRoute.IsInertia k B σ → c σ = 0) := by
  refine ⟨unramifiedSubgroup p k Ω K B (SSGRoute.decomp k B ⊓ K.fixingSubgroup), ?_⟩
  intro c hcocycle hlc
  exact toClass_mem_unramifiedSubgroup_iff p k Ω K B _ inf_le_right ⟨hcocycle, hlc⟩

end

end Work.SSGRoute.ZSplit
