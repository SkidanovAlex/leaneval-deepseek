/-!
# The `±1` eigenspaces of the involution `σ̄`

Let `H = ⟨σ̄⟩` be the group generated by the restriction `σ̄ = res k K σ` of a Galois involution
`σ` of `Ω/k`, and let `M` be an `H`-representation over `Coeff = ℤ` which is a finite free
`ℤ`-module.

This file collects the lattice-theoretic facts about the two eigenspaces
`M⁺ = {x | σ̄ x = x}` and `M⁻ = {x | σ̄ x = -x}`:

* both are `H`-stable (because `H = {1, σ̄}`);
* `M⁺ ∩ M⁻ = 0` (`M` is torsion-free);
* `2x = (σ̄x + x) + (x - σ̄x) ∈ M⁺ + M⁻` and `σ̄x - x ∈ M⁺ + M⁻`.

Since `Coeff = ULift ℤ`, Mathlib's `ULift`-scalar instances compete with the `Module Coeff V`
structure; they are removed below so that `c • x` always denotes the *module* action.
-/

attribute [-instance] ULift.module
attribute [-instance] ULift.smulLeft
attribute [-instance] ULift.smulZeroClass
attribute [-instance] ULift.distribSMul
attribute [-instance] ULift.distribMulAction
attribute [-instance] ULift.mulAction
attribute [-instance] ULift.smulWithZero
attribute [-instance] ULift.mulActionWithZero

namespace Work.SSGRoute.E1aFinal

open CategoryTheory

open scoped BigOperators

noncomputable section

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
variable {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField K]
variable {σ : Ω ≃ₐ[k] Ω}

/-- The `+1` eigenlattice of the involution `σ̄`. -/
def eigPlus (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :
    Submodule SSGRoute.PTExt.Coeff M.V where
  carrier := {x | M.ρ (gen (σ := σ)) x = x}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [map_add, ha, hb]
  smul_mem' := by
    intro c a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [LinearMap.map_smul, ha]

/-- The `-1` eigenlattice of the involution `σ̄`. -/
def eigMinus (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :
    Submodule SSGRoute.PTExt.Coeff M.V where
  carrier := {x | M.ρ (gen (σ := σ)) x = -x}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb
    simp only [Set.mem_setOf_eq] at ha hb ⊢
    rw [map_add, ha, hb, neg_add]
  smul_mem' := by
    intro c a ha
    simp only [Set.mem_setOf_eq] at ha ⊢
    rw [LinearMap.map_smul, ha, smul_neg]

/-- The sum `M⁺ + M⁻` of the two eigenlattices. -/
def eigSum (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :
    Submodule SSGRoute.PTExt.Coeff M.V :=
  eigPlus M ⊔ eigMinus M

variable {M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))}

lemma mem_eigPlus {x : M.V} : x ∈ eigPlus M ↔ M.ρ (gen (σ := σ)) x = x := Iff.rfl

lemma mem_eigMinus {x : M.V} : x ∈ eigMinus M ↔ M.ρ (gen (σ := σ)) x = -x := Iff.rfl

lemma mem_eigSum {x : M.V} :
    x ∈ eigSum M ↔ ∃ y ∈ eigPlus M, ∃ z ∈ eigMinus M, y + z = x :=
  Submodule.mem_sup

/-- The generator of `H` is an involution. -/
lemma gen_sq_one (hσ : σ ^ 2 = 1) : gen (K := K) (σ := σ) ^ 2 = 1 := by
  apply Subtype.ext
  show ((SSGRoute.res k K σ) : K ≃ₐ[k] K) ^ 2 = (1 : K ≃ₐ[k] K)
  rw [← map_pow, hσ, map_one]

/-- The group `H = ⟨σ̄⟩` is generated by `gen`. -/
lemma eq_one_or_eq_gen (hσ : σ ^ 2 = 1)
    (h : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) :
    h = 1 ∨ h = gen (K := K) (σ := σ) := by
  have hg2 : gen (K := K) (σ := σ) ^ 2 = 1 := gen_sq_one hσ
  have hmul : gen (K := K) (σ := σ) * gen (K := K) (σ := σ) = 1 := by
    rw [← pow_two]; exact hg2
  have htop : Subgroup.zpowers (gen (K := K) (σ := σ)) = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro x
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp x.2
    exact Subgroup.mem_zpowers_iff.mpr ⟨n, by
      apply Subtype.ext
      show ((SSGRoute.res k K σ) : K ≃ₐ[k] K) ^ n =
        ((x : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) : K ≃ₐ[k] K)
      exact hn⟩
  let T : Subgroup ↥(Subgroup.zpowers (SSGRoute.res k K σ)) :=
    { carrier := {x | x = 1 ∨ x = gen (K := K) (σ := σ)}
      mul_mem' := by
        rintro a b (rfl | rfl) (rfl | rfl)
        · exact Or.inl (one_mul 1)
        · exact Or.inr (one_mul _)
        · exact Or.inr (mul_one _)
        · exact Or.inl hmul
      one_mem' := Or.inl rfl
      inv_mem' := by
        rintro a (rfl | rfl)
        · exact Or.inl (inv_one)
        · exact Or.inr (inv_eq_of_mul_eq_one_right hmul) }
  have hle : Subgroup.zpowers (gen (K := K) (σ := σ)) ≤ T :=
    Subgroup.zpowers_le.mpr (Or.inr rfl)
  exact hle (htop ▸ Subgroup.mem_top h)

/-- `σ̄` is an involution on `M`. -/
lemma rho_gen_gen (hσ : σ ^ 2 = 1) (x : M.V) :
    M.ρ (gen (σ := σ)) (M.ρ (gen (σ := σ)) x) = x := by
  have hgg : (M.ρ (gen (σ := σ))) * (M.ρ (gen (σ := σ))) = 1 := by
    rw [← map_mul (M.ρ) (gen (σ := σ)) (gen (σ := σ)), ← pow_two, gen_sq_one hσ,
      map_one (M.ρ)]
  calc M.ρ (gen (σ := σ)) (M.ρ (gen (σ := σ)) x)
      = ((M.ρ (gen (σ := σ))) * (M.ρ (gen (σ := σ)))) x := rfl
    _ = x := by rw [hgg]; rfl

lemma smul_mem_eigPlus (hσ : σ ^ 2 = 1)
    (h : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) {x : M.V} (hx : x ∈ eigPlus M) :
    M.ρ h x ∈ eigPlus M := by
  rw [mem_eigPlus] at hx ⊢
  rcases eq_one_or_eq_gen (K := K) hσ h with rfl | rfl
  · rw [map_one]; exact hx
  · rw [rho_gen_gen hσ x, hx]

lemma smul_mem_eigMinus (hσ : σ ^ 2 = 1)
    (h : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) {x : M.V} (hx : x ∈ eigMinus M) :
    M.ρ h x ∈ eigMinus M := by
  rw [mem_eigMinus] at hx ⊢
  rcases eq_one_or_eq_gen (K := K) hσ h with rfl | rfl
  · rw [map_one]; exact hx
  · rw [rho_gen_gen hσ x, hx, neg_neg]

lemma smul_mem_eigSum (hσ : σ ^ 2 = 1)
    (h : ↥(Subgroup.zpowers (SSGRoute.res k K σ))) {x : M.V} (hx : x ∈ eigSum M) :
    M.ρ h x ∈ eigSum M := by
  rw [eigSum] at hx ⊢
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hx
  rw [map_add]
  exact Submodule.add_mem _ (Submodule.mem_sup_left (smul_mem_eigPlus hσ h hy))
    (Submodule.mem_sup_right (smul_mem_eigMinus hσ h hz))

/-- `2x = (σ̄x + x) + (x - σ̄x) ∈ M⁺ + M⁻`. -/
lemma add_self_mem_eigSum (hσ : σ ^ 2 = 1) (x : M.V) : x + x ∈ eigSum M := by
  have h1 : M.ρ (gen (σ := σ)) x + x ∈ eigPlus M := by
    rw [mem_eigPlus, map_add, rho_gen_gen hσ x, add_comm]
  have h2 : x - M.ρ (gen (σ := σ)) x ∈ eigMinus M := by
    rw [mem_eigMinus, map_sub, rho_gen_gen hσ x]
    abel
  rw [← show (M.ρ (gen (σ := σ)) x + x) + (x - M.ρ (gen (σ := σ)) x) = x + x from by abel]
  exact Submodule.add_mem _ (Submodule.mem_sup_left h1) (Submodule.mem_sup_right h2)

/-- `x - σ̄x ∈ M⁺ + M⁻`. -/
lemma sub_rho_gen_mem_eigSum (hσ : σ ^ 2 = 1) (x : M.V) :
    M.ρ (gen (σ := σ)) x - x ∈ eigSum M := by
  have h2 : x - M.ρ (gen (σ := σ)) x ∈ eigSum M :=
    Submodule.mem_sup_right (by
      rw [mem_eigMinus, map_sub, rho_gen_gen hσ x]
      abel)
  rw [show M.ρ (gen (σ := σ)) x - x = -(x - M.ρ (gen (σ := σ)) x) from by abel]
  exact Submodule.neg_mem _ h2

/-- The two eigenlattices meet in `0`. -/
lemma inf_eigPlus_eigMinus (hσ : σ ^ 2 = 1) [Module.Free ℤ M.V] :
    eigPlus M ⊓ eigMinus M = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x hx
  rw [Submodule.mem_inf, mem_eigPlus, mem_eigMinus] at hx
  obtain ⟨h1, h2⟩ := hx
  have hxx : x = -x := h1.symm.trans h2
  have h2x : (2 : ℤ) • x = 0 := by
    rw [two_smul]
    nth_rewrite 1 [hxx]
    exact neg_add_cancel x
  rcases smul_eq_zero.mp h2x with h | h
  · exact absurd h (by norm_num)
  · exact h

end

end Work.SSGRoute.E1aFinal
