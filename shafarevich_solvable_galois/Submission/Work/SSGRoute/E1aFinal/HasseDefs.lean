/-!
# Setup vocabulary for the `C₂`-lattice Hasse principle

This module fixes the notation for the target `Work.SSGRoute.E1aFinal.hasseExt1_C2_lattice`
and states the three lattice-theoretic / arithmetic pieces of its proof as separate
delegated lemmas:

* `HasseStat M` — the conclusion of the target for the coefficient module `M`;
* `IsSplit M` — `M` is a direct sum of copies of the trivial and the sign representation;
* `StepData M₀ M` — `M` is an index-two extension of `M₀` on which the generator acts
  trivially.
-/

namespace Work.SSGRoute.E1aFinal

open CategoryTheory

noncomputable section

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
variable {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField K]
variable {σ : Ω ≃ₐ[k] Ω}

/-- The generator `σ̄ = res k K σ` of `H = ⟨σ̄⟩`. -/
def gen : ↥(Subgroup.zpowers (SSGRoute.res k K σ)) :=
  ⟨SSGRoute.res k K σ, Subgroup.mem_zpowers _⟩

/-- **The conclusion of the target** for the coefficient module `M`: the coefficient change
`Kˣ → 𝕀_K` makes `Ext¹_H(M, Kˣ) → Ext¹_H(M, 𝕀_K)` injective. -/
def HasseStat (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) : Prop :=
  ∀ z : CategoryTheory.Abelian.Ext.{0} M
      (Rep.res (Subgroup.zpowers (SSGRoute.res k K σ)).subtype (SSGRoute.PTExt.unitsK k ↥K)) 1,
    z.comp (CategoryTheory.Abelian.Ext.mk₀
        (Rep.resMap (Subgroup.zpowers (SSGRoute.res k K σ)).subtype
          (NK.HassePrinciple.ideleIncl k ↥K))) (add_zero 1) = 0 → z = 0

/-- **The split case**: `M` has a `ℤ`-basis on which the generator of `H` acts diagonally with
eigenvalues `±1` (i.e. `M` is a direct sum of copies of the trivial and the sign
representation). -/
def IsSplit (M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (b : Module.Basis ι ℤ M.V),
    ∀ i, M.ρ (gen (σ := σ)) (b i) = b i ∨ M.ρ (gen (σ := σ)) (b i) = - b i

/-- **An index-two extension datum**: `M₀ ⊆ M` as `H`-representations, with `M/M₀ ≅ ℤ/2`
generated by `m` and the generator of `H` acting trivially on `M/M₀`. -/
def StepData (M₀ M : Rep.{0} SSGRoute.PTExt.Coeff ↥(Subgroup.zpowers (SSGRoute.res k K σ))) : Prop :=
  ∃ (f : M₀ ⟶ M) (m : M.V),
    Function.Injective f.hom ∧
    (∀ x : M.V, ∃ y : M₀.V, x = f.hom y ∨ x - f.hom y = m) ∧
    (2 : ℤ) • m ∈ Set.range f.hom ∧
    (M.ρ (gen (σ := σ)) m - m) ∈ Set.range f.hom

end

end Work.SSGRoute.E1aFinal
