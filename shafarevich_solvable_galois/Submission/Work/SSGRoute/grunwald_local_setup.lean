import Mathlib.RingTheory.Henselian
import Mathlib.Algebra.Field.ZMod
import Mathlib.RingTheory.DedekindDomain.AdicValuation
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.RingTheory.SimpleRing.Principal
import Submission.NK.Mine.AdjoinLocalGalois
import Submission.Work.SSGRoute.grunwald_kummer_idx

/-!
# The local Kummer setup for the Grünwald surjectivity lemma

Let `K` be a number field, `Ω` a separable closure of `K`, `v` a finite prime of `K`, `P` a place
of `Ω` above `v` and `C` the completion of `Ω` at `P`.  The *local closure* `M = κ·Ω` is the
subfield of `C` generated by the image of the `v`-adic completion `κ = K_v` and the image of `Ω`;
it is a separable closure of `κ` (`localClosure_isSepClosure`).

This file collects the elementary transport lemmas relating the global Kummer index (computed at
the level `Ω/K`) with the local Kummer index (computed at the level `M/κ`).  All the statements are
phrased with the concrete algebra structure `localAlgebra v P hv`, so that `localClosure v P hv` is
a self-contained type needing no instance at use sites.
-/

namespace Work.SSGRoute

open scoped Pointwise

noncomputable section

section LocalSetup

variable {K' : Type*} [Field K'] [NumberField K']
variable {Ω : Type*} [Field Ω] [Algebra K' Ω] [IsSepClosure K' Ω]

/-- The `κ`-algebra structure on the completion of `Ω` at `P` induced by the continuous embedding
of the `v`-adic completion `κ = K_v` inside it. -/
abbrev localAlgebra
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) :
    Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
      (NK.NeukirchUchida.placeCompletion P) :=
  (NK.NeukirchUchida.adicCompletionToPlaceCompletion v P hv).toAlgebra

/-- The local closure `κ·Ω` of the local field `κ = K_v` inside the completion of `Ω` at `P`. -/
abbrev localClosure
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) : Type _ :=
  letI := localAlgebra v P hv
  ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := K') (K' := Ω) v P)

/-- The `κ`-algebra structure on the local closure, inherited from the completion. -/
@[instance_reducible]
instance instLocalClosureAlgebra
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) :
    Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
      (localClosure (K' := K') (Ω := Ω) v P hv) := by
  letI := localAlgebra v P hv
  unfold localClosure
  exact inferInstance

/-- The local closure is a separable closure of the local field `κ = K_v`. -/
theorem localClosure_isSepClosure
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) :
    IsSepClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
      (localClosure (K' := K') (Ω := Ω) v P hv) := by
  letI := localAlgebra v P hv
  exact NK.Mine.isSepClosure_adjoinPlaceCompletion v P hv (fun z => rfl)

/-- The inclusion `Ω →+* M` of `Ω` in the local closure. -/
def coInHom
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) :
    Ω →+* localClosure (K' := K') (Ω := Ω) v P hv := by
  letI := localAlgebra v P hv
  exact
    { toFun := fun y => NK.NeukirchUchida.coInAdjoin (K := K') (K' := Ω) v P y
      map_one' := NK.NeukirchUchida.coInAdjoin_one v P
      map_mul' := fun x y => NK.NeukirchUchida.coInAdjoin_mul v P x y
      map_zero' := NK.NeukirchUchida.coInAdjoin_zero v P
      map_add' := fun x y => NK.NeukirchUchida.coInAdjoin_add v P x y }

/-- The value of `coInHom` in the ambient completion. -/
theorem coInHom_coe
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    (y : Ω) :
    ((coInHom v P hv y : localClosure (K' := K') (Ω := Ω) v P hv) :
        NK.NeukirchUchida.placeCompletion P) = NK.NeukirchUchida.placeCompletionCoe P y := rfl

theorem coInHom_injective
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) :
    Function.Injective (coInHom v P hv) := by
  intro x y hxy
  have h2 : ((coInHom v P hv x : localClosure (K' := K') (Ω := Ω) v P hv) :
      NK.NeukirchUchida.placeCompletion P) =
      ((coInHom v P hv y : localClosure (K' := K') (Ω := Ω) v P hv) :
        NK.NeukirchUchida.placeCompletion P) :=
    congrArg (fun z : localClosure (K' := K') (Ω := Ω) v P hv =>
      (z : NK.NeukirchUchida.placeCompletion P)) hxy
  rw [coInHom_coe, coInHom_coe] at h2
  exact RingHom.injective (NK.NeukirchUchida.placeCompletionCoe P) h2

/-- `coInHom` intertwines the two structure maps `K' → Ω → M` and `K' → κ → M`. -/
theorem coInHom_algebraMap
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v) (y : K') :
    coInHom v P hv (algebraMap K' Ω y) =
      algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
        (localClosure (K' := K') (Ω := Ω) v P hv)
        (algebraMap K' (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v) y) := by
  letI := localAlgebra v P hv
  apply Subtype.ext
  show NK.NeukirchUchida.placeCompletionCoe P (algebraMap K' Ω y) =
    NK.NeukirchUchida.adicCompletionToPlaceCompletion v P hv
      (algebraMap K' (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v) y)
  rw [NK.NeukirchUchida.adicCompletionToPlaceCompletion_algebraMap]

end LocalSetup

section LocalRoot

variable {K' : Type*} [Field K'] [NumberField K']
variable {Ω : Type*} [Field Ω] [Algebra K' Ω] [IsSepClosure K' Ω]
variable {p : ℕ} [Fact p.Prime]

/-- The primitive `p`-th root of unity of the local field, obtained by transporting `hζK`. -/
abbrev localRootOfUnity {v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K')}
    {ζK : K'} (hζK : IsPrimitiveRoot ζK p) :
    IsPrimitiveRoot
      (algebraMap K' (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v) ζK) p :=
  hζK.map_of_injective (f := algebraMap K'
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v))
    (FaithfulSMul.algebraMap_injective K'
      (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v))

/-- The image of a unit `α ∈ Ωˣ` in the units of the local closure. -/
def localRoot
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    (α : Ωˣ) : (localClosure (K' := K') (Ω := Ω) v P hv)ˣ :=
  Units.map (coInHom v P hv).toMonoidHom α

theorem localRoot_coe
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    (α : Ωˣ) :
    ((localRoot v P hv α : (localClosure (K' := K') (Ω := Ω) v P hv)ˣ) :
        localClosure (K' := K') (Ω := Ω) v P hv) = coInHom v P hv (α : Ω) := rfl

/-- **The image of the primitive `p`-th root of unity is the same in `M`.** -/
theorem mappedRoot_local_eq
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    {ζK : K'} (hζK : IsPrimitiveRoot ζK p) :
    mappedRoot (E := localClosure (K' := K') (Ω := Ω) v P hv) p
        (localRootOfUnity (v := v) hζK) =
      Units.map (coInHom v P hv).toMonoidHom (mappedRoot (E := Ω) p hζK) := by
  have hroot : Work.Kummer.primRootUnit (localRootOfUnity (v := v) hζK) =
      Units.map (algebraMap K' (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)).toMonoidHom
        (Work.Kummer.primRootUnit hζK) := by
    apply Units.ext
    rw [Work.Kummer.primRootUnit_coe, Units.coe_map, Work.Kummer.primRootUnit_coe]
    rfl
  simp only [mappedRoot]
  rw [hroot]
  apply Units.ext
  rw [Units.coe_map, Units.coe_map, Units.coe_map, Units.coe_map,
    Work.Kummer.primRootUnit_coe]
  exact (coInHom_algebraMap v P hv ζK).symm

/-- **`localRoot α ^ p` is the image of `α ^ p`.** -/
theorem localRoot_pow
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    {a : K'ˣ} {α : Ωˣ} (hα : α ^ p = Units.map (algebraMap K' Ω) a) :
    localRoot v P hv α ^ p =
      Units.map (algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
        (localClosure (K' := K') (Ω := Ω) v P hv)).toMonoidHom
        (Units.map (algebraMap K'
          (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)).toMonoidHom a) := by
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, localRoot_coe, Units.coe_map, Units.coe_map]
  show (coInHom v P hv (α : Ω)) ^ p =
    algebraMap (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)
      (localClosure (K' := K') (Ω := Ω) v P hv)
      (algebraMap K' (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v) (a : K'))
  have hα' : (α : Ω) ^ p = algebraMap K' Ω (a : K') := by
    rw [← Units.val_pow_eq_pow_val, hα, Units.coe_map]
    rfl
  rw [← map_pow (coInHom v P hv) (α : Ω) p, hα', coInHom_algebraMap v P hv]

/-- **Compatibility of the Kummer ratios.**  If `σloc` is a local automorphism of `M` agreeing
with `σ` on the image of `Ω`, then the Kummer ratio of `localRoot α` under `σloc` is the image of
the Kummer ratio of `α` under `σ`. -/
theorem kummerRatio_localRoot
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    (α : Ωˣ) (σ : Ω ≃ₐ[K'] Ω)
    (σloc : localClosure (K' := K') (Ω := Ω) v P hv ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v]
      localClosure (K' := K') (Ω := Ω) v P hv)
    (hσloc : ∀ y : Ω, σloc (coInHom v P hv y) = coInHom v P hv (σ y)) :
    Work.Kummer.kummerRatio σloc (localRoot v P hv α) =
      Units.map (coInHom v P hv).toMonoidHom (Work.Kummer.kummerRatio σ α) := by
  have h1 : Units.map (coInHom v P hv).toMonoidHom
        (Work.Kummer.algEquivUnitsMap σ α) =
      Work.Kummer.algEquivUnitsMap σloc (localRoot v P hv α) := by
    apply Units.ext
    simp only [Work.Kummer.algEquivUnitsMap_coe, Units.coe_map, localRoot_coe]
    exact (hσloc (α : Ω)).symm
  have h2 : Units.map (coInHom v P hv).toMonoidHom α = localRoot v P hv α := rfl
  rw [Work.Kummer.kummerRatio, Work.Kummer.kummerRatio, map_div, h1, h2]

/-- **Naturality of the `zr` isomorphism under the inclusion of the local closure.** -/
theorem zr_local_eq
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    {ζK : K'} (hζK : IsPrimitiveRoot ζK p) (j : Multiplicative (ZMod p)) :
    ((zr (isPrimitiveRoot_mappedRoot
          (E := localClosure (K' := K') (Ω := Ω) v P hv) p (localRootOfUnity (v := v) hζK)) j :
        ↥(rootsOfUnity p (localClosure (K' := K') (Ω := Ω) v P hv))) :
      (localClosure (K' := K') (Ω := Ω) v P hv)ˣ)
    = Units.map (coInHom v P hv).toMonoidHom
        ((zr (isPrimitiveRoot_mappedRoot (E := Ω) p hζK) j : ↥(rootsOfUnity p Ω)) : Ωˣ) := by
  have hnat := mappedRoot_local_eq v P hv hζK
  have h1 := zr_apply_int (isPrimitiveRoot_mappedRoot
    (E := localClosure (K' := K') (Ω := Ω) v P hv) p (localRootOfUnity (v := v) hζK))
    ((Multiplicative.toAdd j).val : ℤ)
  have h2 := zr_apply_int (isPrimitiveRoot_mappedRoot (E := Ω) p hζK)
    ((Multiplicative.toAdd j).val : ℤ)
  have hj : Multiplicative.ofAdd ((((Multiplicative.toAdd j).val : ℤ) : ZMod p)) = j := by
    ext
    simp
  rw [hj] at h1 h2
  rw [h1, h2, map_zpow, ← hnat]

/-- **The local Kummer index is the restriction of the global one.** -/
theorem kummerIdx_local_eq_global
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K'))
    (P : ValuationSubring Ω)
    (hv : P.comap (algebraMap K' Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K' v)
    {ζK : K'} (hζK : IsPrimitiveRoot ζK p)
    (a : K'ˣ) (α : Ωˣ) (hα : α ^ p = Units.map (algebraMap K' Ω) a)
    (σ : Ω ≃ₐ[K'] Ω)
    (σloc : localClosure (K' := K') (Ω := Ω) v P hv ≃ₐ[
      IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v]
      localClosure (K' := K') (Ω := Ω) v P hv)
    (hσloc : ∀ y : Ω, σloc (coInHom v P hv y) = coInHom v P hv (σ y)) :
    kummerIdx p (localRootOfUnity (v := v) hζK)
        (Units.map (algebraMap K'
          (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)).toMonoidHom a)
        (localRoot v P hv α) (localRoot_pow v P hv hα) σloc
      = kummerIdx p hζK a α hα σ := by
  have hrat := kummerRatio_localRoot v P hv α σ σloc hσloc
  have hmain : Multiplicative.ofAdd
        (kummerIdx p (localRootOfUnity (v := v) hζK)
          (Units.map (algebraMap K'
            (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)).toMonoidHom a)
          (localRoot v P hv α) (localRoot_pow v P hv hα) σloc)
      = Multiplicative.ofAdd (kummerIdx p hζK a α hα σ) := by
    apply (zr (isPrimitiveRoot_mappedRoot
      (E := localClosure (K' := K') (Ω := Ω) v P hv) p (localRootOfUnity (v := v) hζK))).injective
    apply Subtype.ext
    rw [← kummerIdx_spec p (localRootOfUnity (v := v) hζK)
        (Units.map (algebraMap K'
          (IsDedekindDomain.HeightOneSpectrum.adicCompletion K' v)).toMonoidHom a)
        (localRoot v P hv α) (localRoot_pow v P hv hα) σloc,
      hrat, kummerIdx_spec p hζK a α hα σ]
    exact (zr_local_eq v P hv hζK (Multiplicative.ofAdd (kummerIdx p hζK a α hα σ))).symm
  exact congrArg Multiplicative.toAdd hmain

end LocalRoot

end

end Work.SSGRoute
