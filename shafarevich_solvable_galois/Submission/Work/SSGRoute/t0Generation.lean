/-!
# `T⁰` generation: a subgroup of a finite quotient of `G_ℚ` is generated by decomposition groups

Let `Γ` be a finite group, `ψ : G_ℚ →* Γ` a continuous surjection (equivalently, with open kernel)
and `H ≤ Γ`.  Then there is a *finite* set `T⁰` of finite places of `ℚ̄` such that
* each decomposition group `D_A = decomp ℚ A` has `ψ`-image inside `H`, and
* the images generate `H`.

This is the `T⁰`-generation used in Step 3 of Schmidt–Wingberg's proof of Theorem 15.

## Route

Let `L = fixedField (ker ψ)` be the finite Galois extension cut out by `ker ψ`, so that `ψ` factors
as `ψ̄ ∘ r` with `r = restrictNormalHom L : G_ℚ →* Gal(L/ℚ)` (`restrictLift`), and let
`H_L = (H.comap ψ).map r ≤ Gal(L/ℚ)`.

For every `σ ∈ H_L`, Čebotarev's theorem in the finite-level form `ChebotarevInput ℚ ℚ̄` provides an
unramified prime `P` of `L` with Frobenius `σ`; extending `P` to a place `A` of `ℚ̄` gives a place
whose decomposition-group image is exactly `⟨σ⟩` (`placeDecompImage`).  Taking one such `A` for each
`σ ∈ H_L` (a finite set) and using that `H_L` is generated by its elements yields the result.

## Contents

* `t0_map_zpowers` — `(Subgroup.zpowers x).map f = Subgroup.zpowers (f x)`;
* `t0_restrictLift` — `ψ` factors through `restrictNormalHom L` when the kernels agree;
* `t0_placeDecompImage` — every `σ : Gal(L/ℚ)` is the image of a decomposition group;
* `t0Generation` — the target.
-/

namespace Work.SSGRoute

open scoped Pointwise

set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false

theorem t0_map_zpowers {G N : Type*} [Group G] [Group N] (f : G →* N) (x : G) :
    (Subgroup.zpowers x).map f = Subgroup.zpowers (f x) := by
  ext y
  rw [Subgroup.mem_map]
  constructor
  · rintro ⟨z, hz, rfl⟩
    rw [Subgroup.mem_zpowers_iff] at hz ⊢
    obtain ⟨k, rfl⟩ := hz
    exact ⟨k, by rw [map_zpow]⟩
  · intro hy
    rw [Subgroup.mem_zpowers_iff] at hy
    obtain ⟨k, rfl⟩ := hy
    exact ⟨x ^ k, Subgroup.mem_zpowers_iff.mpr ⟨k, rfl⟩, by rw [map_zpow]⟩

/-- If `ψ : G_ℚ →* Γ` has the same kernel as the restriction map `G_ℚ →* Gal(L/ℚ)` attached to a
finite Galois intermediate field `L ⊆ ℚ̄`, then `ψ` factors through that restriction map. -/
theorem t0_restrictLift {Γ : Type*} [Group Γ]
    (L : IntermediateField ℚ SSGRoute.QBar) [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (ψ : SSGRoute.GalQ →* Γ)
    (hker : ψ.ker = (AlgEquiv.restrictNormalHom L).ker) :
    ∃ ψbar : (↥L ≃ₐ[ℚ] ↥L) →* Γ, ψbar.comp (AlgEquiv.restrictNormalHom L) = ψ := by
  have hrsurj : Function.Surjective (AlgEquiv.restrictNormalHom L) :=
    AlgEquiv.restrictNormalHom_surjective (F := ℚ) (K₁ := ↥L) (E := SSGRoute.QBar)
  refine ⟨(QuotientGroup.lift (AlgEquiv.restrictNormalHom L).ker ψ
      (le_of_eq hker.symm)).comp
    ((QuotientGroup.quotientKerEquivOfSurjective (AlgEquiv.restrictNormalHom L) hrsurj).symm), ?_⟩
  ext g
  rw [MonoidHom.comp_apply]
  have h1 : (QuotientGroup.quotientKerEquivOfSurjective (AlgEquiv.restrictNormalHom L) hrsurj)
      (QuotientGroup.mk g) = AlgEquiv.restrictNormalHom L g := by
    rw [QuotientGroup.quotientKerEquivOfSurjective,
      QuotientGroup.quotientKerEquivOfRightInverse_apply, QuotientGroup.kerLift_mk]
  have h2 : (QuotientGroup.quotientKerEquivOfSurjective (AlgEquiv.restrictNormalHom L) hrsurj).symm
      (AlgEquiv.restrictNormalHom L g) = QuotientGroup.mk g :=
    (MulEquiv.symm_apply_eq _).mpr h1
  show (QuotientGroup.lift (AlgEquiv.restrictNormalHom L).ker ψ (le_of_eq hker.symm))
      ((QuotientGroup.quotientKerEquivOfSurjective (AlgEquiv.restrictNormalHom L) hrsurj).symm
        (AlgEquiv.restrictNormalHom L g)) = ψ g
  rw [h2]
  exact QuotientGroup.lift_mk (AlgEquiv.restrictNormalHom L).ker (le_of_eq hker.symm) g

/-- For a finite Galois intermediate field `L ⊆ ℚ̄` and `σ : Gal(L/ℚ)`, there is a finite place `A`
of `ℚ̄` whose decomposition-group image in `Gal(L/ℚ)` is exactly the cyclic group `⟨σ⟩`. -/
theorem t0_placeDecompImage (hc : NK.Reconstruct.ChebotarevInput ℚ SSGRoute.QBar)
    (L : IntermediateField ℚ SSGRoute.QBar) [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (σ : ↥L ≃ₐ[ℚ] ↥L) :
    ∃ A : ValuationSubring SSGRoute.QBar,
      A.comap (algebraMap ℚ SSGRoute.QBar) ≠ ⊤ ∧
      (SSGRoute.decomp ℚ A).map (AlgEquiv.restrictNormalHom L) = Subgroup.zpowers σ := by
  haveI : NumberField ↥L := inferInstance
  obtain ⟨p, P, hP, hram, hfrob⟩ := hc L σ
  obtain ⟨A, hA⟩ := Commons.NumberTheory.NumberField.Valuation.exists_valuationSubring_at_prime
    (K := ↥L) (K' := SSGRoute.QBar) P
  haveI : IsAlgClosure ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.instIsAlgClosure ℚ
  haveI : IsGalois ℚ SSGRoute.QBar :=
    { to_isSeparable := inferInstance, to_normal := inferInstance }
  have hAneL : A.comap (algebraMap ↥L SSGRoute.QBar) ≠ ⊤ := by
    rw [hA]; exact Submission.NeukirchUchida.Local.valuationSubringAtPrime_ne_top P
  have hAne : A.comap (algebraMap ℚ SSGRoute.QBar) ≠ ⊤ := by
    have hcomp : A.comap (algebraMap ℚ SSGRoute.QBar) =
        (A.comap (algebraMap ↥L SSGRoute.QBar)).comap (algebraMap ℚ ↥L) := by
      rw [ValuationSubring.comap_comap, IsScalarTower.algebraMap_eq ℚ ↥L SSGRoute.QBar]
    rw [hcomp, hA]
    have hlies : P.asIdeal.LiesOver (P.under (NumberField.RingOfIntegers ℚ)).asIdeal := by
      rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]; exact ⟨rfl⟩
    rw [Commons.RingTheory.Valuation.comap_valuationSubringAtPrime
      (K := ℚ) (L := ↥L) (P.under (NumberField.RingOfIntegers ℚ)) P hlies]
    exact Submission.NeukirchUchida.Local.valuationSubringAtPrime_ne_top _
  refine ⟨A, hAne, ?_⟩
  have hLem : (SSGRoute.decomp ℚ A).map (AlgEquiv.restrictNormalHom L) =
      MulAction.stabilizer (↥L ≃ₐ[ℚ] ↥L) (A.comap (algebraMap ↥L SSGRoute.QBar)) := by
    apply le_antisymm
    · intro τ hτ
      rw [Subgroup.mem_map] at hτ
      obtain ⟨σ', hσ', rfl⟩ := hτ
      rw [MulAction.mem_stabilizer_iff] at hσ' ⊢
      exact Commons.FieldTheory.Galois.restrictNormalHom_smul_comap_eq_of_smul_eq A σ' hσ' L
    · intro τ hτ
      rw [Subgroup.mem_map]
      obtain ⟨σ', hσA, hστ⟩ :=
        Commons.RingTheory.Valuation.exists_mem_stabilizer_restrictNormalHom_eq_of_isGalois
          (F := ℚ) (E := SSGRoute.QBar) A hAne L τ hτ
      exact ⟨σ', hσA, hστ⟩
  rw [hLem, hA]
  rw [show MulAction.stabilizer (↥L ≃ₐ[ℚ] ↥L)
      (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P) =
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := ℚ) P from
    Subgroup.ext (fun τ =>
      Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup P τ)]
  exact NK.WeakNU.decompositionSubgroup_eq_zpowers_of_isFrobAt P σ hram hfrob

theorem t0Generation (Γ : Type*) [Group Γ] [Finite Γ] (ψ : SSGRoute.GalQ →* Γ)
    (hopen : IsOpen (ψ.ker : Set SSGRoute.GalQ)) (hsurj : Function.Surjective ψ)
    (H : Subgroup Γ) :
    ∃ T0 : Finset (ValuationSubring SSGRoute.QBar),
      (∀ A ∈ T0, (SSGRoute.decomp ℚ A).map ψ ≤ H) ∧
      (⨆ A ∈ T0, (SSGRoute.decomp ℚ A).map ψ) = H := by
  classical
  haveI hAlgClosure : IsAlgClosure ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.instIsAlgClosure ℚ
  haveI hGalQ : IsGalois ℚ SSGRoute.QBar :=
    { to_isSeparable := inferInstance, to_normal := inferInstance }
  have hclosed : IsClosed (ψ.ker : Set SSGRoute.GalQ) := Subgroup.isClosed_of_isOpen ψ.ker hopen
  let L : IntermediateField ℚ SSGRoute.QBar := IntermediateField.fixedField ψ.ker
  have hLfix : L.fixingSubgroup = ψ.ker := by
    have h := InfiniteGalois.fixingSubgroup_fixedField (k := ℚ) (K := AlgebraicClosure ℚ)
      (⟨ψ.ker, hclosed⟩ : ClosedSubgroup (AlgebraicClosure ℚ ≃ₐ[ℚ] AlgebraicClosure ℚ))
    simpa [L] using h
  have hLfd : FiniteDimensional ℚ L :=
    (InfiniteGalois.isOpen_iff_finite (k := ℚ) (K := AlgebraicClosure ℚ) L).mp (hLfix ▸ hopen)
  haveI hLfdI : FiniteDimensional ℚ L := hLfd
  haveI hLgal : IsGalois ℚ L :=
    IsGalois.of_fixedField_normal_subgroup (K := ℚ) (L := AlgebraicClosure ℚ) ψ.ker
      (hn := MonoidHom.normal_ker ψ)
  haveI hLnf : NumberField ↥L := inferInstance
  have hrker : (AlgEquiv.restrictNormalHom L).ker = ψ.ker := by
    rw [IntermediateField.restrictNormalHom_ker, hLfix]
  obtain ⟨ψbar, hψbar⟩ := t0_restrictLift L ψ hrker.symm
  let HL : Subgroup (↥L ≃ₐ[ℚ] ↥L) := (H.comap ψ).map (AlgEquiv.restrictNormalHom L)
  have hHmap : HL.map ψbar = H := by
    show Subgroup.map ψbar
        (Subgroup.map (AlgEquiv.restrictNormalHom L) (Subgroup.comap ψ H)) = H
    rw [Subgroup.map_map, hψbar, Subgroup.map_comap_eq, MonoidHom.range_eq_top.mpr hsurj, top_inf_eq]
  have hc : NK.Reconstruct.ChebotarevInput ℚ SSGRoute.QBar := by
    haveI : IsSepClosure ℚ SSGRoute.QBar := inferInstance
    exact (NK.ReconstructEndgame.chebotarevInput_congr ℚ SSGRoute.QBar).mpr
      ((NK.NUV2.chebotarev_all0 NK.CFTLib.fundamentalClassElement) ℚ SSGRoute.QBar)
  have key : ∀ σ : ↥HL, ∃ A : ValuationSubring SSGRoute.QBar,
      (SSGRoute.decomp ℚ A).map (AlgEquiv.restrictNormalHom L) =
        Subgroup.zpowers (σ : ↥L ≃ₐ[ℚ] ↥L) :=
    fun σ => (t0_placeDecompImage hc L (σ : ↥L ≃ₐ[ℚ] ↥L)).imp (fun A h => h.2)
  let Afun : ↥HL → ValuationSubring SSGRoute.QBar := fun σ => Classical.choose (key σ)
  have hAfun : ∀ σ : ↥HL, (SSGRoute.decomp ℚ (Afun σ)).map (AlgEquiv.restrictNormalHom L) =
        Subgroup.zpowers (σ : ↥L ≃ₐ[ℚ] ↥L) := fun σ => Classical.choose_spec (key σ)
  have hval : ∀ σ : ↥HL, (SSGRoute.decomp ℚ (Afun σ)).map ψ =
      Subgroup.zpowers (ψbar (σ : ↥L ≃ₐ[ℚ] ↥L)) := by
    intro σ
    rw [← hψbar, ← Subgroup.map_map, hAfun σ, t0_map_zpowers]
  refine ⟨Finset.univ.image Afun, ?_, ?_⟩
  · intro A' hA'
    rw [Finset.mem_image] at hA'
    obtain ⟨σ, -, rfl⟩ := hA'
    rw [hval σ]
    exact Subgroup.zpowers_le.mpr (hHmap ▸ Subgroup.mem_map.mpr ⟨σ, σ.2, rfl⟩)
  · rw [← Finset.sup_eq_iSup, Finset.sup_image]
    show Finset.univ.sup (fun σ : ↥HL => (SSGRoute.decomp ℚ (Afun σ)).map ψ) = H
    have hsup_eq : (Finset.univ.sup (fun σ : ↥HL =>
        Subgroup.zpowers (ψbar (σ : ↥L ≃ₐ[ℚ] ↥L)))) = H := by
      apply le_antisymm
      · apply Finset.sup_le
        intro σ _
        exact Subgroup.zpowers_le.mpr (hHmap ▸ Subgroup.mem_map.mpr ⟨σ, σ.2, rfl⟩)
      · intro h hh
        rw [← hHmap, Subgroup.mem_map] at hh
        obtain ⟨σ, hσ, rfl⟩ := hh
        exact Finset.le_sup (f := fun σ : ↥HL =>
            Subgroup.zpowers (ψbar (σ : ↥L ≃ₐ[ℚ] ↥L))) (Finset.mem_univ ⟨σ, hσ⟩)
          (Subgroup.mem_zpowers (ψbar (σ : ↥L ≃ₐ[ℚ] ↥L)))
    rw [show (fun σ : ↥HL => (SSGRoute.decomp ℚ (Afun σ)).map ψ) =
        (fun σ : ↥HL => Subgroup.zpowers (ψbar (σ : ↥L ≃ₐ[ℚ] ↥L))) from funext hval]
    exact hsup_eq

end Work.SSGRoute
