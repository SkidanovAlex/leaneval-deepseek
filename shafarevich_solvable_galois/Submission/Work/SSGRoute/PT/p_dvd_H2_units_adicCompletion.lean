section Aux

/-- Transfer of `AddSubgroup.zmultiples u = ⊤` along an additive equivalence. -/
lemma zmultiples_map_addEquiv {A B : Type*} [AddCommGroup A] [AddCommGroup B] (e : A ≃+ B)
    {u : A} (hu : AddSubgroup.zmultiples u = ⊤) : AddSubgroup.zmultiples (e u) = ⊤ := by
  rw [← AddSubgroup.range_zmultiplesHom, AddMonoidHom.range_eq_top] at hu ⊢
  intro y
  obtain ⟨x, hx⟩ := hu (e.symm y)
  refine ⟨x, ?_⟩
  calc (zmultiplesHom B (e u)) x = x • e u := zmultiplesHom_apply B (e u) x
    _ = e (x • u) := (AddMonoidHom.map_zsmul e.toAddMonoidHom x u).symm
    _ = e ((zmultiplesHom A u) x) := by rw [zmultiplesHom_apply]
    _ = e (e.symm y) := by rw [hx]
    _ = y := e.apply_symm_apply y

end Aux

/-- **Cyclicity of the level `H²(Gal(L/F), Lˣ)`**: it is generated by an element of order
`[L : F]`, i.e. it is cyclic of order the degree. -/
theorem levelH2_cyclic {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : FiniteGaloisIntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K))) :
    ∃ u : LevelH2 L, AddSubgroup.zmultiples u = ⊤ ∧
      addOrderOf u = Module.finrank (Q.adicCompletion K) ↥L := by
  obtain ⟨u, hgen, hord⟩ :=
    level_units_H2_cyclic (K := K) Q (L := (L : IntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K))))
  exact ⟨h2LevelEquiv L u, zmultiples_map_addEquiv (h2LevelEquiv L) hgen,
    (addOrderOf_injective (h2LevelEquiv L).toAddMonoidHom (h2LevelEquiv L).injective u).trans hord⟩

/-- **Divisibility of a group covered by nested cyclic subgroups.**  If an abelian group `H` is
covered by the nested images of cyclic groups `A i` of order `n i`, and every `i` has a `j ≥ i`
with `n i * p ∣ n j`, then multiplication by `p` is surjective on `H`. -/
theorem surjective_nsmul_of_cover_cyclic {H : Type*} [AddGroup H] {ι : Type*}
    (lt : ι → ι → Prop) (A : ι → Type*) [∀ i, AddGroup (A i)] (n : ι → ℕ)
    (φ : ∀ i, A i →+ H) (p : ℕ)
    (hpos : ∀ i, 0 < n i)
    (hcyc : ∀ i, ∃ u : A i, AddSubgroup.zmultiples u = ⊤ ∧ addOrderOf u = n i)
    (hinj : ∀ i, Function.Injective (φ i))
    (hnest : ∀ i j, lt i j → Set.range (φ i) ⊆ Set.range (φ j))
    (hcover : ∀ x : H, ∃ i, x ∈ Set.range (φ i))
    (hex : ∀ i, ∃ j, lt i j ∧ n i * p ∣ n j) :
    Function.Surjective (fun x : H => p • x) := by
  intro x
  obtain ⟨i, a, ha⟩ := hcover x
  obtain ⟨j, hij, hpj⟩ := hex i
  obtain ⟨b, hb⟩ := hnest i j hij ⟨a, ha⟩
  have hsub : (φ i).range ≤ (φ j).range := fun y hy => hnest i j hij hy
  let e : A j ≃+ ↥(φ j).range := AddEquiv.ofBijective ((φ j).rangeRestrict) (by
    refine ⟨fun x y hxy => hinj j (Subtype.ext_iff.mp hxy), ?_⟩
    rintro ⟨y, hy⟩
    obtain ⟨w, hw⟩ := hy
    exact ⟨w, Subtype.ext hw⟩)
  let ψ : A i →+ A j := e.symm.toAddMonoidHom.comp
    ((AddSubgroup.inclusion hsub).comp ((φ i).rangeRestrict))
  have hψa : e (ψ a) = AddSubgroup.inclusion hsub ((φ i).rangeRestrict a) := by
    dsimp only [ψ]
    rw [AddMonoidHom.comp_apply, AddMonoidHom.comp_apply]
    exact e.apply_symm_apply _
  have hbψ : b = ψ a := by
    apply e.injective
    rw [hψa]
    refine Subtype.ext ?_
    show φ j b = φ i a
    rw [hb, ha]
  have hord_a : addOrderOf a ∣ n i := by
    obtain ⟨u₂, hgen₂, hu₂⟩ := hcyc i
    have hm : a ∈ AddSubgroup.zmultiples u₂ := by rw [hgen₂]; exact AddSubgroup.mem_top a
    obtain ⟨k₂, hk₂⟩ := AddSubgroup.mem_zmultiples_iff.mp hm
    refine addOrderOf_dvd_iff_nsmul_eq_zero.mpr ?_
    have h1 : (n i : ℤ) • u₂ = 0 := by
      rw [← hu₂]
      exact (addOrderOf_dvd_iff_zsmul_eq_zero).mp dvd_rfl
    have h2 : (n i : ℤ) • a = 0 := by
      calc (n i : ℤ) • a = (n i : ℤ) • (k₂ • u₂) := by rw [hk₂]
        _ = k₂ • ((n i : ℤ) • u₂) := by rw [zsmul_comm]
        _ = 0 := by rw [h1, smul_zero]
    rw [← natCast_zsmul]
    exact h2
  have hord_b : addOrderOf b ∣ n i := by
    rw [hbψ]
    exact (addOrderOf_map_dvd ψ a).trans hord_a
  obtain ⟨u, hgen, hu⟩ := hcyc j
  have hbm : b ∈ AddSubgroup.zmultiples u := by rw [hgen]; exact AddSubgroup.mem_top b
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hbm
  have hb0 : (n i) • b = 0 := addOrderOf_dvd_iff_nsmul_eq_zero.mp hord_b
  have hni_u : ((n i : ℤ) * k) • u = 0 := by
    calc ((n i : ℤ) * k) • u = (n i : ℤ) • (k • u) := by rw [mul_zsmul]
      _ = (n i : ℤ) • b := by rw [hk]
      _ = 0 := by rw [natCast_zsmul]; exact hb0
  have hm_dvd : (n j : ℤ) ∣ (n i : ℤ) * k := by
    have h := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hni_u
    rwa [hu] at h
  have hp_dvd : (p : ℤ) ∣ k := by
    have h1 : (n i : ℤ) * (p : ℤ) ∣ (n i : ℤ) * k := by
      refine dvd_trans ?_ hm_dvd
      exact_mod_cast hpj
    have hne : (n i : ℤ) ≠ 0 := by exact_mod_cast (ne_of_gt (hpos i))
    exact (mul_dvd_mul_iff_left hne).mp (by simpa [mul_comm] using h1)
  obtain ⟨k', hk'⟩ := hp_dvd
  refine ⟨φ j (k' • u), ?_⟩
  calc p • (φ j (k' • u)) = φ j (p • (k' • u)) := by rw [map_nsmul]
    _ = φ j (k • u) := by
        congr 1
        rw [← natCast_zsmul, ← mul_zsmul, ← hk']
    _ = φ j b := by rw [hk]
    _ = x := hb

section Arithmetic

/-- Arithmetic input for the level extension: if `p ^ s ≥ p * d` and `d > 0`, then `p * d` divides
`lcm d (p ^ s)`. -/
private lemma dvd_mul_prime_of_le_pow {p d s : ℕ} (hp : p.Prime) (hd : 0 < d) (hs : p * d ≤ p ^ s) :
    p * d ∣ Nat.lcm d (p ^ s) := by
  have hg_pos : 0 < Nat.gcd d (p ^ s) := Nat.gcd_pos_of_pos_left (p ^ s) hd
  have hg_dvd : Nat.gcd d (p ^ s) ∣ p ^ s := Nat.gcd_dvd_right d (p ^ s)
  have hg_ne : Nat.gcd d (p ^ s) ≠ p ^ s := by
    intro h
    have hdvd : p ^ s ∣ d := h ▸ Nat.gcd_dvd_left d (p ^ s)
    have hle : p ^ s ≤ d := Nat.le_of_dvd hd hdvd
    have hp2 : 2 ≤ p := hp.two_le
    nlinarith
  obtain ⟨k, hk_le, hk⟩ := (Nat.dvd_prime_pow hp).mp hg_dvd
  have hk_lt : k < s := by
    rcases lt_or_eq_of_le hk_le with hlt | heq
    · exact hlt
    · exact absurd (hk.trans (congrArg (fun m => p ^ m) heq)) hg_ne
  have hg_dvd' : Nat.gcd d (p ^ s) ∣ p ^ (s - 1) := by
    rw [hk]
    exact pow_dvd_pow p (Nat.le_pred_of_lt hk_lt)
  have hmul : p * Nat.gcd d (p ^ s) ∣ p ^ s := by
    have h := mul_dvd_mul_right hg_dvd' p
    have hspos : 1 ≤ s := Nat.succ_le_of_lt (Nat.lt_of_le_of_lt (Nat.zero_le k) hk_lt)
    rw [mul_comm (Nat.gcd d (p ^ s)) p, ← pow_succ, Nat.sub_add_cancel hspos] at h
    exact h
  have h2 : p * d * Nat.gcd d (p ^ s) ∣ Nat.lcm d (p ^ s) * Nat.gcd d (p ^ s) := by
    have h := hmul
    rw [Nat.mul_comm (Nat.lcm d (p ^ s)) (Nat.gcd d (p ^ s)), Nat.gcd_mul_lcm d (p ^ s)]
    calc p * d * Nat.gcd d (p ^ s) = d * (p * Nat.gcd d (p ^ s)) := by ring
      _ ∣ d * p ^ s := mul_dvd_mul_left d h
  exact Nat.dvd_of_mul_dvd_mul_right hg_pos h2

/-- From `n • k = e • (-1)` conclude `n ∣ e`. -/
private lemma dvd_of_nsmul_eq_neg {n e : ℕ} {k : ℤ} (h : n • k = e • (-1 : ℤ)) : n ∣ e := by
  have h' : (n : ℤ) * k = -(e : ℤ) := by simpa [nsmul_eq_mul] using h
  refine Int.ofNat_dvd.mp ⟨-k, ?_⟩
  rw [mul_neg, h', neg_neg]

end Arithmetic

/-- **A finite Galois extension of degree divisible by `p ^ s`.**  Let `F` be a field of
characteristic zero with a valuation `w` with values in `ℤᵐ⁰ = WithZero (Multiplicative ℤ)` and let
`π` be a uniformizer.  Then the splitting field of `X ^ (p ^ s) - π` is finite and Galois over `F`
of degree divisible by `p ^ s`: a root `α` satisfies `N(α) ^ (p ^ s) = π ^ [M : F]`, and applying
`w` and the logarithm turns this into `p ^ s • log (w (N α)) = [M : F] • (-1)`. -/
theorem exists_galois_degree_pow_dvd_of_uniformizer {p : ℕ} [Fact p.Prime] (s : ℕ) {F : Type*}
    [Field F] [CharZero F] (w : Valuation F (WithZero (Multiplicative ℤ))) (π : F)
    (hπ : w π = WithZero.exp (-1)) :
    ∃ M : IntermediateField F (AlgebraicClosure F),
      FiniteDimensional F ↥M ∧ IsGalois F ↥M ∧ p ^ s ∣ Module.finrank F ↥M := by
  haveI hp : p.Prime := Fact.out
  have hπne : π ≠ 0 := (Valuation.ne_zero_iff w).mp (by rw [hπ]; exact WithZero.exp_ne_zero)
  have hnF : ((p ^ s : ℕ) : F) ≠ 0 := by
    rw [Nat.cast_pow]
    exact pow_ne_zero s (Nat.cast_ne_zero.mpr hp.ne_zero)
  have hnpos : 0 < p ^ s := pow_pos hp.pos s
  let M : IntermediateField F (AlgebraicClosure F) :=
    IntermediateField.adjoin F ((X ^ (p ^ s) - C π).rootSet (AlgebraicClosure F))
  haveI hsplit : Polynomial.IsSplittingField F ↥M (X ^ (p ^ s) - C π) :=
    IntermediateField.adjoin_rootSet_isSplittingField (p := X ^ (p ^ s) - C π) (IsAlgClosed.splits _)
  haveI hfin : FiniteDimensional F ↥M :=
    Polynomial.IsSplittingField.finiteDimensional ↥M (X ^ (p ^ s) - C π)
  haveI hgal : IsGalois F ↥M :=
    IsGalois.of_separable_splitting_field (p := X ^ (p ^ s) - C π)
      (separable_X_pow_sub_C π hnF hπne)
  haveI : Module.Free F ↥M := Module.Free.of_divisionRing F ↥M
  let α : ↥M := rootOfSplitsXPowSubC hnpos π ↥M
  have hα : α ^ (p ^ s) = algebraMap F ↥M π :=
    rootOfSplitsXPowSubC_pow (n := p ^ s) (a := π) (L := ↥M)
  have hnorm : ((Algebra.norm F) α) ^ (p ^ s) = π ^ Module.finrank F ↥M := by
    rw [← map_pow, hα, Algebra.norm_algebraMap]
  have hw : (w ((Algebra.norm F) α)) ^ (p ^ s) = (w π) ^ Module.finrank F ↥M := by
    simpa using congrArg w hnorm
  rw [hπ] at hw
  have hlog : p ^ s • WithZero.log (w ((Algebra.norm F) α)) =
      Module.finrank F ↥M • (-1 : ℤ) := by
    have h := congrArg WithZero.log hw
    simpa only [WithZero.log_pow, WithZero.log_exp] using h
  exact ⟨M, hfin, hgal, dvd_of_nsmul_eq_neg hlog⟩

/-- **Enlarging a level so that the index is divisible by `p`.**  For `K` a number field, `Q` a
finite place, `F = K_Q` the `Q`-adic completion, `p` a prime and `L / F` a finite Galois level,
there is a larger finite Galois level `L' ⊇ L` with `p * [L : F] ∣ [L' : F]`. -/
theorem exists_level_p_dvd_index (p : ℕ) [Fact p.Prime] {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (L : FiniteGaloisIntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K))) :
    ∃ L' : FiniteGaloisIntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K)),
      (L : IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))) ≤
        (L' : IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))) ∧
      Module.finrank (Q.adicCompletion K) ↥L * p ∣ Module.finrank (Q.adicCompletion K) ↥L' := by
  haveI hp : p.Prime := Fact.out
  haveI hchar : CharZero (Q.adicCompletion K) :=
    charZero_of_injective_algebraMap
      (RingHom.injective (algebraMap ℚ (Q.adicCompletion K)))
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.valuation_exists_uniformizer K Q
  have hπ' : Valued.v (π : Q.adicCompletion K) = WithZero.exp (-1) := by
    rw [IsDedekindDomain.HeightOneSpectrum.adicCompletion.valued_coe, hπ]
  haveI : Module.Free (Q.adicCompletion K) ↥L := Module.Free.of_divisionRing _ ↥L
  have hdpos : 0 < Module.finrank (Q.adicCompletion K) ↥L :=
    (Module.finrank_pos_iff_of_free (Q.adicCompletion K) ↥L).mpr inferInstance
  obtain ⟨M, hMfin, hMgal, hMdiv⟩ := exists_galois_degree_pow_dvd_of_uniformizer
    (p := p) (Module.finrank (Q.adicCompletion K) ↥L * p)
    (Valued.v : Valuation (Q.adicCompletion K) (WithZero (Multiplicative ℤ)))
    (π : Q.adicCompletion K) hπ'
  let M' : FiniteGaloisIntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K)) :=
    { toIntermediateField := M, finiteDimensional := hMfin, isGalois := hMgal }
  have hs : p * Module.finrank (Q.adicCompletion K) ↥L ≤
      p ^ (Module.finrank (Q.adicCompletion K) ↥L * p) := by
    have h1 : Module.finrank (Q.adicCompletion K) ↥L * p <
        2 ^ (Module.finrank (Q.adicCompletion K) ↥L * p) := Nat.lt_two_pow_self
    have h2 : (2 : ℕ) ^ (Module.finrank (Q.adicCompletion K) ↥L * p) ≤
        p ^ (Module.finrank (Q.adicCompletion K) ↥L * p) :=
      Nat.pow_le_pow_left hp.two_le _
    rw [mul_comm p]
    exact le_of_lt (lt_of_lt_of_le h1 h2)
  refine ⟨L ⊔ M', ?_, ?_⟩
  · exact le_sup_left
  · have hle1 : (L : IntermediateField (Q.adicCompletion K)
        (AlgebraicClosure (Q.adicCompletion K))) ≤
        ((L ⊔ M' : FiniteGaloisIntermediateField (Q.adicCompletion K)
          (AlgebraicClosure (Q.adicCompletion K))) :
          IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))) :=
      (FiniteGaloisIntermediateField.le_iff L (L ⊔ M')).mp le_sup_left
    have hle2 : M ≤
        ((L ⊔ M' : FiniteGaloisIntermediateField (Q.adicCompletion K)
          (AlgebraicClosure (Q.adicCompletion K))) :
          IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))) :=
      le_sup_right
    have h1 : Module.finrank (Q.adicCompletion K) ↥L ∣
        Module.finrank (Q.adicCompletion K) ↥(L ⊔ M') :=
      IntermediateField.finrank_dvd_of_le_right hle1
    have h2 : p ^ (Module.finrank (Q.adicCompletion K) ↥L * p) ∣
        Module.finrank (Q.adicCompletion K) ↥(L ⊔ M') :=
      hMdiv.trans (IntermediateField.finrank_dvd_of_le_right hle2)
    have hmain : p * Module.finrank (Q.adicCompletion K) ↥L ∣
        Module.finrank (Q.adicCompletion K) ↥(L ⊔ M') :=
      (dvd_mul_prime_of_le_pow hp hdpos hs).trans (Nat.lcm_dvd h1 h2)
    rwa [mul_comm] at hmain

/-- **The main theorem.** -/
theorem p_dvd_H2_units_adicCompletion (p : ℕ) [Fact p.Prime] {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    Function.Surjective (fun x : Work.AbsoluteKummer.H2 (Work.AbsoluteKummer.G (Q.adicCompletion K))
      (Additive ((AlgebraicClosure (Q.adicCompletion K))ˣ)) => p • x) := by
  haveI hG : IsGalois (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K)) := inferInstance
  refine surjective_nsmul_of_cover_cyclic
    (ι := FiniteGaloisIntermediateField (Q.adicCompletion K)
      (AlgebraicClosure (Q.adicCompletion K)))
    (lt := fun (L L' : FiniteGaloisIntermediateField (Q.adicCompletion K)
        (AlgebraicClosure (Q.adicCompletion K))) =>
      (L : IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))) ≤
        (L' : IntermediateField (Q.adicCompletion K) (AlgebraicClosure (Q.adicCompletion K))))
    (A := fun L => LevelH2 L) (n := fun L => Module.finrank (Q.adicCompletion K) ↥L)
    (φ := fun L => psiTilde L) p ?_ ?_ ?_ ?_ ?_ ?_
  · intro L
    rw [Module.finrank_pos_iff_of_free]
    infer_instance
  · intro L
    exact levelH2_cyclic Q L
  · intro L
    exact psiTilde_injective L
  · intro L L' h
    exact psiTilde_range_mono L L' h
  · intro x
    exact psiTilde_range_cover x
  · intro L
    exact exists_level_p_dvd_index p Q L

