/-!
# Auxiliary field/group facts for the open-subgroup `p`-torsion statement

This module collects the elementary facts about intermediate fields and the decomposition group
used by `Work.SSGRoute.PT.exists_numberField_decomp_eq` (the structural reduction) and by
`Work.SSGRoute.PT.cardH2_units_openSubgroup_decomp`.
-/

namespace Work.SSGRoute.PT

noncomputable section

/-- An intermediate field `L` of `Ω/k` containing `F₀`, regarded as an intermediate field of
`Ω` over the smaller base `↥F₀`. -/
def relField {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (F₀ L : IntermediateField k Ω) (h : F₀ ≤ L) : IntermediateField ↥F₀ Ω where
  carrier := (L : Set Ω)
  mul_mem' := L.mul_mem'
  one_mem' := L.one_mem'
  add_mem' := L.add_mem'
  zero_mem' := L.zero_mem'
  inv_mem' := L.inv_mem'
  algebraMap_mem' := fun r => h (Subtype.coe_prop r)

@[simp] theorem relField_coe {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (F₀ L : IntermediateField k Ω) (h : F₀ ≤ L) :
    ((relField F₀ L h : IntermediateField ↥F₀ Ω) : Set Ω) = (L : Set Ω) := rfl

/-- A finite-dimensional intermediate field is generated by a finite set. -/
theorem exists_finite_generating_set {F E : Type} [Field F] [Field E] [Algebra F E]
    (M : IntermediateField F E) [FiniteDimensional F ↥M] :
    ∃ S : Set E, S.Finite ∧ IntermediateField.adjoin F S = M :=
  IntermediateField.fg_def.mp
    (IntermediateField.essFiniteType_iff.mp (inferInstance : Algebra.EssFiniteType F ↥M))

/-- The `↥F₀`-adjoin of a finite generating set of a finite-dimensional intermediate field is
finite-dimensional over `↥F₀`. -/
theorem finiteDimensional_adjoin_of_adjoin_eq {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (F₀ K : IntermediateField k Ω) (S : Set Ω) (hS : S.Finite)
    (hgen : IntermediateField.adjoin k S = K) :
    FiniteDimensional ↥F₀ ↥(IntermediateField.adjoin ↥F₀ S) := by
  haveI hAlg : Algebra.IsAlgebraic k Ω := IsAlgClosure.isAlgebraic
  haveI : Finite S := hS
  refine IntermediateField.finiteDimensional_adjoin (fun x hx => ?_)
  have h1 : x ∈ K := by rw [← hgen]; exact IntermediateField.subset_adjoin k S hx
  exact IsAlgebraic.isIntegral
    (IsAlgebraic.tower_top ↥F₀ (Algebra.IsAlgebraic.isAlgebraic (R := k) (A := Ω) x))

/-- `K ⊔ F₀` is finite-dimensional over `↥F₀` when `K` is finite-dimensional over `k`. -/
theorem finiteDimensional_relField_sup {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (F₀ K : IntermediateField k Ω) [FiniteDimensional k ↥K] :
    FiniteDimensional ↥F₀ ↥(relField F₀ (K ⊔ F₀) le_sup_right) := by
  obtain ⟨S, hSfin, hSgen⟩ := exists_finite_generating_set K
  haveI h1 : FiniteDimensional ↥F₀ ↥(IntermediateField.adjoin ↥F₀ S) :=
    finiteDimensional_adjoin_of_adjoin_eq F₀ K S hSfin hSgen
  have hcarrier : ((IntermediateField.adjoin ↥F₀ S : IntermediateField ↥F₀ Ω) : Set Ω) =
      (relField F₀ (K ⊔ F₀) le_sup_right : Set Ω) := by
    rw [relField_coe]
    have h := congrArg (fun M : IntermediateField k Ω => (M : Set Ω))
      (IntermediateField.restrictScalars_adjoin_eq_sup (F := k) (K := F₀) (S := S))
    rw [IntermediateField.coe_restrictScalars, hSgen, sup_comm] at h
    exact h
  have heq : relField F₀ (K ⊔ F₀) le_sup_right = IntermediateField.adjoin ↥F₀ S :=
    SetLike.coe_injective hcarrier.symm
  rw [heq]
  exact h1

/-- **The image in `Gal(Ω/k)` of an open subgroup of the decomposition group is closed.**  The
subgroup is open, hence closed, in the compact group `↥(decomp k A)`; its image under the
(continuous) inclusion into `Ω ≃ₐ[k] Ω` is therefore compact, hence closed. -/
theorem isClosed_map_subtype_decomp_of_isOpen {k Ω : Type} [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (U : Subgroup ↥(SSGRoute.decomp k A)) (hU : IsOpen (U : Set ↥(SSGRoute.decomp k A))) :
    IsClosed ((U.map (SSGRoute.decomp k A).subtype : Subgroup (Ω ≃ₐ[k] Ω)) :
      Set (Ω ≃ₐ[k] Ω)) := by
  haveI hGal : IsGalois k Ω := IsAlgClosure.isGalois k Ω
  haveI : CompactSpace (Ω ≃ₐ[k] Ω) := inferInstance
  haveI : T2Space (Ω ≃ₐ[k] Ω) := krullTopology_t2 (K := k) (L := Ω)
  haveI : CompactSpace ↥(SSGRoute.decomp k A) := by
    have hc : IsClosed ((SSGRoute.decomp k A : Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) :=
      Commons.FieldTheory.Galois.isClosed_stabilizer_valuationSubring (K := k) (K' := Ω) A
    exact isCompact_iff_compactSpace.mp hc.isCompact
  have hUc : IsClosed (U : Set ↥(SSGRoute.decomp k A)) := Subgroup.isClosed_of_isOpen U hU
  have hcomp : IsCompact (Subtype.val '' (U : Set ↥(SSGRoute.decomp k A))) :=
    hUc.isCompact.image continuous_subtype_val
  have hcoe : ((U.map (SSGRoute.decomp k A).subtype : Subgroup (Ω ≃ₐ[k] Ω)) :
      Set (Ω ≃ₐ[k] Ω)) = Subtype.val '' (U : Set ↥(SSGRoute.decomp k A)) := by
    ext σ
    constructor
    · intro h
      obtain ⟨u, hu, hu'⟩ :=
        Subgroup.mem_map.mp (show σ ∈ Subgroup.map (SSGRoute.decomp k A).subtype U from h)
      exact ⟨u, hu, hu'⟩
    · rintro ⟨u, hu, rfl⟩
      exact Subgroup.mem_map.mpr ⟨u, hu, rfl⟩
  rw [hcoe]
  exact hcomp.isClosed

end

end Work.SSGRoute.PT
