attribute [local instance] Classical.propDecidable

/-- **The glued family with an abstract archimedean half**: the archimedean half `arch` at the groups
generated by an involution, the finite-place half `fin` elsewhere.  (The archimedean test comes
first, so that the value at `Subgroup.zpowers c` is *definitionally* `arch`; `arch` is not assumed to
vanish off the involution groups, so only the *values* at the involution groups are ever used by the
construction.) -/
noncomputable def pairGlueArch
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)
    (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p :=
  fun M _ _ _ _ _ H a b =>
    if _h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c then
      arch M H a b
    else fin M H a b

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
  (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
  (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)

variable (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
    Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)

variable (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
    Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)

/-- The value of the glued family at the group generated by an involution. -/
theorem pairGlueArch_arch (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)} {c : Ω ≃ₐ[k] Ω} (hc : c ^ 2 = 1)
    (heq : H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M H a b =
      arch M (Subgroup.zpowers c) a b := by
  subst heq
  unfold pairGlueArch
  exact dif_pos ⟨c, hc, rfl⟩

/-- The value of the glued family away from the involution groups. -/
theorem pairGlueArch_fin (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)}
    (h : ¬ ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M H a b = fin M H a b := by
  unfold pairGlueArch
  exact dif_neg h


/-- **The value of the glued family at a finite place is the finite-place value**, by the
disjointness of the two shapes of local group. -/
theorem pairGlueArch_decomp (hempty : E7Arch.LocalGroupDisjoint k Ω)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M (SSGRoute.decomp k A) a b =
      fin M (SSGRoute.decomp k A) a b := by
  unfold pairGlueArch
  exact dif_neg (fun h => by
    obtain ⟨c, hc, heq⟩ := h
    exact hempty A hA c hc heq)

/-- With the concrete archimedean half, the glued family is `Work.SSGRoute.E7Arch.pairGlue`.  This
records that the abstraction here is a genuine generalisation and not a different construction. -/
theorem pairGlueArch_pairArchFamily (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (H : Subgroup (Ω ≃ₐ[k] Ω)) (a : (Ω ≃ₐ[k] Ω) → M)
    (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlueArch p k Ω K ζ hζ hζK T hT fin
        (E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT) M H a b =
      E7Arch.pairGlue p k Ω K ζ hζ hζK T hT fin M H a b := by
  unfold pairGlueArch E7Arch.pairGlue
  rfl

end Work.SSGRoute.PT
