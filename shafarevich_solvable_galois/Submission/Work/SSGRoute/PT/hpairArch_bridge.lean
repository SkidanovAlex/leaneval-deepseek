/-- The generator `1` of `Coeff` as an element of the invariants of the trivial representation. -/
noncomputable abbrev H0unitGen (G : Type) [Group G] :
    ↥(unitRep G).ρ.invariants :=
  ⟨1, fun g => by simp [SSGRoute.PTExt.unitRep]⟩

/-- **The generator of `H⁰(G, ℤ)`** used in the bridge: the image of `1` under the degree-`0`
isomorphism `groupCohomology.H0Iso`. -/
noncomputable abbrev eCohY0 (G : Type) [Group G] : groupCohomology (unitRep G) 0 :=
  (groupCohomology.H0Iso (unitRep G)).inv (H0unitGen G)

/-! ## Auxiliary facts about `Ext¹` for a group generated by an involution

The target `PT.archPairLocal_hpairArch` compares the class-formation value of the descended
`⟨c⟩`-cocycle `b` computed at the fixed level `L_c` through `PT.zLocal` (which packages the class
through the E0b bridge `SSGRoute.PTExt.eCoh`) with the value computed at the level `L` through
`PT.levelClassOf ψ` (which packages the class through the derivation bridge `ExtH1.gammaHom`).

These two group-cohomology implementations of `Ext¹_G(ℤ,-)` differ at most by an overall sign
(the workspace records this only up to sign: `eCoh_delta`, and the E0b node
`extH_groupCohomology_iso` says explicitly "the sign is allowed to go either way").  Both levels
involved are seam places, so by `PT.decompK_linked` their decomposition groups are *generated by an
involution*; for such a group every `Ext¹` is 2-torsion, which makes the sign irrelevant.  That is
the content of the two lemmas below. -/

/-- **`Ext¹_G(ℤ, N)` is 2-torsion when `G` is generated by an involution.**  For a group
`G = {1, c}` with `c * c = 1`, an inhomogeneous `1`-cocycle `z` satisfies `2 • z = d⁰ (- z c)`
(the cocycle identity at `(c, c)` gives `c • z c = - z c`), so `2` kills `H¹`; transported to
`Ext¹` through the E0b bridge `eCoh` and the surjectivity of `H1π`. -/
theorem extH_one_eq_neg_self_of_zpowers (G : Type) [Group G] (c : G) (hc : c * c = 1)
    (hgen : ∀ g : G, g = 1 ∨ g = c) (N : Rep.{0} Coeff G) (x : extH N 1) : x = -x := by
  have key : ∀ z : ↥(groupCohomology.cocycles₁ N),
      (2 : ℤ) • (groupCohomology.H1π N).hom z = 0 := by
    intro z
    have hz1 : (z : G → N) 1 = 0 := by
      have h := (groupCohomology.mem_cocycles₁_iff (z : G → N)).mp z.2 1 1
      rw [mul_one] at h
      have hfix : (N.ρ (1 : G)) ((z : G → N) 1) = (z : G → N) 1 := by simp
      rw [hfix] at h
      have h' : (z : G → N) 1 + (z : G → N) 1 = (z : G → N) 1 + 0 := by
        rw [add_zero, ← h]
      exact add_left_cancel h'
    have hzc : N.ρ c ((z : G → N) c) = -((z : G → N) c) := by
      have h := (groupCohomology.mem_cocycles₁_iff (z : G → N)).mp z.2 c c
      rw [hc, hz1] at h
      exact eq_neg_of_add_eq_zero_left h.symm
    have hmem : ((2 : ℤ) • (z : G → N)) ∈ groupCohomology.coboundaries₁ N := by
      rw [groupCohomology.coboundaries₁, LinearMap.mem_range]
      refine ⟨-((z : G → N) c), ?_⟩
      funext g
      simp only [Pi.smul_apply, Pi.neg_apply, groupCohomology.d₀₁_hom_apply]
      rcases hgen g with rfl | rfl
      · have hfix : (N.ρ (1 : G)) (-((z : G → N) c)) = -((z : G → N) c) := by
          rw [map_one]; rfl
        rw [hfix, hz1, smul_zero, sub_self]
      · rw [map_neg, hzc, neg_neg, sub_neg_eq_add, two_zsmul]
    rw [show (2 : ℤ) • (groupCohomology.H1π N).hom z
        = (groupCohomology.H1π N).hom ((2 : ℤ) • z) from (map_zsmul _ _ _).symm]
    exact (groupCohomology.H1π_eq_zero_iff _).mpr hmem
  have h2 : (2 : ℤ) • x = 0 := by
    rw [show x = (eCoh 1 G N) ((eCoh 1 G N).symm x) from (AddEquiv.apply_symm_apply _ _).symm,
      ← map_zsmul]
    refine (AddEquiv.map_eq_zero_iff (eCoh 1 G N)).mpr ?_
    exact groupCohomology.H1_induction_on ((eCoh 1 G N).symm x) (fun z => key z)
  have h3 : x + x = 0 := by simpa [two_zsmul] using h2
  exact eq_neg_of_add_eq_zero_left h3

/-- **`regRep`'s action on a basis element**: `g • ebas x = ebas (g * x)`. -/
theorem regRep_ρ_ebas (G : Type) [Group G] (g x : G) :
    (regRep G).ρ g (ebas G x) = ebas G (g * x) := by
  show (Representation.ofMulAction Coeff G G) g (MonoidAlgebra.single x (1 : Coeff)) =
    MonoidAlgebra.single (g * x) (1 : Coeff)
  ext y
  rw [Representation.coeff_ofMulAction, MonoidAlgebra.coeff_single, MonoidAlgebra.coeff_single]
  show ((Finsupp.single x (1 : Coeff)) (g⁻¹ • y)).down
    = ((Finsupp.single (g * x) (1 : Coeff)) y).down
  by_cases h : y = g * x
  · subst h
    have hidx : g⁻¹ • (g * x) = x := by rw [smul_eq_mul, inv_mul_cancel_left]
    rw [hidx, Finsupp.single_eq_same, Finsupp.single_eq_same]
  · have h1 : g⁻¹ • y ≠ x := fun hc => h (by
      have h2 := congrArg (fun t => g • t) hc
      rw [← smul_inv_smul g y] at h2
      simpa using h2)
    rw [show (Finsupp.single x (1 : Coeff)) (g⁻¹ • y) = 0 from
          Finsupp.single_eq_of_ne h1,
        show (Finsupp.single (g * x) (1 : Coeff)) y = 0 from
          Finsupp.single_eq_of_ne h]

/-- **The `SMul` carried by a `Rep` on its carrier** (from `ρ`). -/
noncomputable abbrev repSMul (G : Type) [Group G] (A : Rep.{0} Coeff G) : SMul G ↥A :=
  ⟨fun g x => A.ρ g x⟩

/-- **The `DistribMulAction` carried by a `Rep` on its carrier** (from `ρ`), so that the
group-cohomology machinery of `Work.GroupCohomology` can be applied to `augI G` and friends. -/
noncomputable abbrev repDistribMulAction (G : Type) [Group G] (A : Rep.{0} Coeff G) :
    DistribMulAction G ↥A :=
  letI : SMul G ↥A := repSMul G A
  { smul := fun g x => A.ρ g x
    one_smul := fun x => by
      show A.ρ 1 x = x
      rw [map_one]
      rfl
    mul_smul := fun g h x => by
      show A.ρ (g * h) x = A.ρ g (A.ρ h x)
      rw [Rep.ρ_mul]
      rfl
    smul_zero := fun g => by
      show A.ρ g 0 = 0
      exact map_zero _
    smul_add := fun g x y => by
      show A.ρ g (x + y) = A.ρ g x + A.ρ g y
      exact map_add _ _ _ }

/-- The `SMulCommClass` for the action `repDistribMulAction`. -/
theorem smulCommClass_repDistribMulAction (G : Type) [Group G] (A : Rep.{0} Coeff G) :
    letI : DistribMulAction G ↥A := repDistribMulAction G A
    SMulCommClass G Coeff ↥A := by
  letI : DistribMulAction G ↥A := repDistribMulAction G A
  refine ⟨fun g r x => ?_⟩
  ·
    show A.ρ g (r • x) = r • A.ρ g x
    simpa using LinearMap.map_smul (A.ρ g) r x

/-- **`θ γ = augDiff G γ` is a `1`-cocycle on `augI G`** (in the `ρ`-spelling). -/
theorem augDiff_mul (G : Type) [Group G] (g h : G) :
    augDiff G (g * h) = (augI G).ρ g (augDiff G h) + augDiff G g := by
  apply Subtype.ext
  show ebas G (g * h) - ebas G 1 =
    (regRep G).ρ g (ebas G h - ebas G 1) + (ebas G g - ebas G 1)
  rw [map_sub, regRep_ρ_ebas, regRep_ρ_ebas, mul_one, sub_add_sub_cancel]

/-- **The `Z1`-element of `θ`** in the `Work.GroupCohomology` spelling. -/
theorem augDiff_mem_Z1 (G : Type) [Group G] :
    letI := repDistribMulAction G (augI G)
    (fun γ : G => augDiff G γ) ∈ Work.GroupCohomology.Z1 G ↥(augI G) := by
  letI := repDistribMulAction G (augI G)
  rw [Work.GroupCohomology.mem_Z1_iff, Work.GroupCohomology.IsCrossedHom]
  intro g h
  show augDiff G (g * h) = (augI G).ρ g (augDiff G h) + augDiff G g
  exact augDiff_mul G g h

/-- **The degree-`0` value of the E0b bridge on the generator of `H⁰(G, ℤ)`.**  The element
`c₀ := eCoh 0 G (unitRep G) (eCohY0 G) ∈ Ext⁰_G(ℤ, ℤ) = Hom_{ℤ[G]}(ℤ, ℤ) ≅ ℤ` is `±` the
generator `mk₀ 𝟙` (equivalently, its scalar is odd).

Route: `eCohY0 G = (H0Iso _).inv (H0unitGen G)` and `1` generates the invariants of the trivial
representation (`H0unitGen G`); transporting `Submodule.span ℤ {1} = ⊤` along the isomorphism
`H0Iso` and then along the isomorphism `eCoh 0` shows that `c₀` generates `Ext⁰_G(ℤ, ℤ)` as a
`ℤ`-module.  Hence some integer multiple of `c₀` is `mk₀ 𝟙`; applying `Abelian.Ext.addEquiv₀`
turns that into `a • g = 𝟙` for `g := addEquiv₀ c₀`, and evaluating at `1 : Coeff` gives
`a * (g.hom 1).down = 1` in `ℤ`, so `(g.hom 1).down = ±1`.  Since `g` is `Coeff`-linear,
`g = (g.hom 1) • 𝟙`, whence `c₀ = mk₀ g = (g.hom 1) • mk₀ 𝟙 = ±mk₀ 𝟙`. -/
theorem eCoh_zero_unitRep_eq_pm_mk0_id (G : Type) [Group G] :
    ((eCoh 0 G (unitRep G)) (eCohY0 G)
        = Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (unitRep G))) ∨
      ((eCoh 0 G (unitRep G)) (eCohY0 G)
        = -Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (unitRep G))) := by
  -- (1) `H0unitGen G = 1` generates the invariants of the trivial representation
  have hgen1 : Submodule.span ℤ ({H0unitGen G} : Set ↥(unitRep G).ρ.invariants) = ⊤ := by
    rw [Submodule.eq_top_iff']
    rintro ⟨x, hx⟩
    rw [Submodule.mem_span_singleton]
    refine ⟨x.down, ?_⟩
    exact Subtype.ext (ULift.down_injective (by simp))
  -- (2) transport along the isomorphism `H0Iso`
  have hgen2 : Submodule.span ℤ ({eCohY0 G} : Set (groupCohomology (unitRep G) 0)) = ⊤ := by
    have hf : Submodule.map
        (((groupCohomology.H0Iso (unitRep G)).inv.hom).toAddMonoidHom.toIntLinearMap)
        (Submodule.span ℤ ({H0unitGen G} : Set ↥(unitRep G).ρ.invariants)) = ⊤ := by
      rw [hgen1, Submodule.map_top, LinearMap.range_eq_top]
      exact fun y => ⟨(groupCohomology.H0Iso (unitRep G)).hom y,
        Iso.hom_inv_id_apply (groupCohomology.H0Iso (unitRep G)) y⟩
    rw [← hf, Submodule.map_span, Set.image_singleton]
    rfl
  -- (3) transport along the isomorphism `eCoh 0`
  have hgen3 : Submodule.span ℤ
      ({eCoh 0 G (unitRep G) (eCohY0 G)} : Set (extH (unitRep G) 0)) = ⊤ := by
    have hf : Submodule.map (((eCoh 0 G (unitRep G)).toAddMonoidHom).toIntLinearMap)
        (Submodule.span ℤ ({eCohY0 G} : Set (groupCohomology (unitRep G) 0))) = ⊤ := by
      rw [hgen2, Submodule.map_top, LinearMap.range_eq_top]
      exact fun y => ⟨(eCoh 0 G (unitRep G)).symm y,
        AddEquiv.apply_symm_apply (eCoh 0 G (unitRep G)) y⟩
    rw [← hf, Submodule.map_span, Set.image_singleton]
    rfl
  -- (4) some integer multiple of `c₀` is the generator `mk₀ 𝟙`
  obtain ⟨a, ha⟩ : ∃ a : ℤ, a • (eCoh 0 G (unitRep G) (eCohY0 G))
      = Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (unitRep G)) := by
    have hmem : (Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (unitRep G)) :
        extH (unitRep G) 0)
        ∈ Submodule.span ℤ ({eCoh 0 G (unitRep G) (eCohY0 G)} : Set (extH (unitRep G) 0)) := by
      rw [hgen3]
      trivial
    rw [Submodule.mem_span_singleton] at hmem
    exact hmem
  -- (5) `g := addEquiv₀ c₀` satisfies `a • g = 𝟙`, so `(g.hom 1).down = ±1`
  have hg : a • (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)) : unitRep G ⟶ unitRep G)
      = 𝟙 (unitRep G) := by
    have h1 := congrArg (Abelian.Ext.addEquiv₀ (X := unitRep G) (Y := unitRep G)) ha
    rw [map_zsmul] at h1
    have h2 : Abelian.Ext.addEquiv₀ (X := unitRep G) (Y := unitRep G)
        (Abelian.Ext.mk₀ (CategoryTheory.CategoryStruct.id (unitRep G))) = 𝟙 (unitRep G) := by
      rw [← Abelian.Ext.addEquiv₀_symm_apply (CategoryTheory.CategoryStruct.id (unitRep G)),
        AddEquiv.apply_symm_apply]
    rwa [h2] at h1
  have hr : a * ((Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom
      (1 : Coeff)).down = 1 := by
    have h2 := congrArg (fun (f : unitRep G ⟶ unitRep G) => (f.hom (1 : Coeff)).down) hg
    have h3 : (a • (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)))).hom (1 : Coeff)
        = a • ((Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom
            (1 : Coeff)) := rfl
    rw [h3] at h2
    simpa using h2
  obtain hr1 | hr1 := Int.eq_one_or_neg_one_of_mul_eq_one (by rw [mul_comm]; exact hr)
  · -- `g = (g.hom 1) • 𝟙`, and `(g.hom 1).down = 1`, so `c₀ = mk₀ 𝟙`
    left
    have hgc : (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)) : unitRep G ⟶ unitRep G)
        = 𝟙 (unitRep G) := by
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro x
      show (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x = x
      have hx : (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (1 : Coeff)
          = (1 : Coeff) := by
        first
          | exact ULift.down_injective (by simpa using hr1)
          | (congr 1; exact hr1)
          | simp_all
      calc (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x
          = (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (x * 1) := by
            rw [mul_one]
        _ = x • (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (1 : Coeff) :=
            map_smul (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x (1 : Coeff)
        _ = x := by rw [hx, smul_eq_mul, mul_one]
    rw [Work.SSGRoute.ext_eq_mk₀_addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)), hgc]
  · right
    have hgc : (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)) : unitRep G ⟶ unitRep G)
        = -𝟙 (unitRep G) := by
      apply Rep.hom_ext
      apply Representation.IntertwiningMap.ext
      apply LinearMap.ext
      intro x
      show (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x = -x
      have hx : (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (1 : Coeff)
          = -(1 : Coeff) := by
        first
          | exact ULift.down_injective (by simpa using hr1)
          | (congr 1; exact hr1)
          | simp_all
      calc (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x
          = (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (x * 1) := by
            rw [mul_one]
        _ = x • (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom (1 : Coeff) :=
            map_smul (Abelian.Ext.addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G))).hom x (1 : Coeff)
        _ = -x := by rw [hx, smul_neg, smul_eq_mul, mul_one]
    rw [Work.SSGRoute.ext_eq_mk₀_addEquiv₀ (eCoh 0 G (unitRep G) (eCohY0 G)), hgc]
    simp

/-- **The E0b bridge and the derivation bridge agree on cocycle classes when `G` is generated by
an involution.**

PROOF ROUTE (all ingredients on disk; the only non-trivial formal computation is the *oddness* of
the scalar `c₀ • hS.extClass`, where `c₀ = eCoh 0 G (unitRep G) y₀` and
`y₀ = (groupCohomology.H0Iso (unitRep G)).inv 1`; see (ii)).

(i) `θ γ = ExtH1.augDiff G γ` is a `1`-cocycle on `augI G`: `augDiff (gh) = g • augDiff h +
    augDiff g`, because `g • ebas h = ebas (g*h)` (`regRep G = Rep.leftRegular Coeff G`).
(ii) Mathlib's `groupCohomology.δ₀_apply hS 1 (ebas G 1) (augHom_ebas G 1) θ hx` (with
    `hx : augIncl ∘ θ = d₀₁ (regRep G) (ebas G 1)`, which is `d₀₁_hom_apply` + `one_smul`) gives
    `δ hS 0 1 rfl y₀ = H1π θ`.  `SSGRoute.eCoh_delta 0 G (augSES G) hS y₀` then gives
    `eCoh 1 G (augI G) (H1π θ) = ± (eCoh 0 G (unitRep G) y₀).comp hS.extClass rfl`.
    Write `c₀ := eCoh 0 G (unitRep G) y₀ ∈ Ext⁰(ℤ,ℤ) = Hom_G(ℤ,ℤ)`; with
    `r := (Abelian.Ext.addEquiv₀ c₀).hom 1` one has `c₀ = mk₀ (r • 𝟙)` (by `Rep.hom_ext` and
    `Coeff`-linearity of `Hom(ℤ,ℤ)`) and hence `c₀.comp hS.extClass rfl = r • hS.extClass`
    (`ZMod`-style: `(r • 𝟙).comp b rfl = r • (𝟙.comp b) = r • b`).
    **`r` is odd**: if `r ∈ 2ℤ`, then `c₀ ∈ 2 • ⊤`; transporting along the `ℤ`-linear iso `eCoh 0`
    and then along the iso `H0Iso` gives `1 = 2 • w` in `↥(unitRep G).ρ.invariants`, i.e.
    `(1 : Coeff) = 2 * (w : Coeff)` in `Coeff = ULift ℤ` — impossible (`ULift.down` of that
    equation is `1 = 2 * w.down`, refuted by `omega`).
    Since `hS.extClass` is 2-torsion (Step (i) of the previous lemma applied to `augI G`),
    `r • hS.extClass = hS.extClass` for odd `r`, so `eCoh 1 G (augI G) (H1π θ) = ± hS.extClass =
    hS.extClass`.
(iii) `ExtH1.cocycleHom G θ _ = 𝟙 (augI G)` by `ExtH1.hom_ext_augDiff` +
    `ExtH1.cocycleHom_augDiff`; hence `gammaZ1 hS ⟨θ,_⟩ = phiMap hS 𝟙 =
    hS.extClass.comp (mk₀ 𝟙) = hS.extClass` (`Abelian.Ext.comp_mk₀_id`).  So
    `eCoh (H1π θ) = gammaHom G M (H1π θ)`.
(iv) For general `φ`: `Work.SSGRoute.E7cOmega.eCoh_one_comp_mk0 G (modRep G (augI G)) (modRep G M)
    (ExtH1.cocycleHom G φ _) ⟨θ,_⟩ z hz'` with `hz' g : z g = (cocycleHom G φ _) (θ g)` — which is
    `ExtH1.cocycleHom_augDiff` together with the hypothesis `hz` of the statement — gives
    `eCoh 1 G (modRep G M) (H1π z) =
     (eCoh 1 G (augI G) (H1π θ)).comp (mk₀ (cocycleHom G φ _)) rfl
     = hS.extClass.comp (mk₀ (cocycleHom G φ _)) = gammaZ1 hS ⟨φ,_⟩ = gammaHom G M (H1π φ)`. -/
theorem eCoh_eq_gammaHom_of_zpowers (G : Type) [Group G] (c : G) (hc : c * c = 1)
    (hgen : ∀ g : G, g = 1 ∨ g = c)
    (M : Type) [AddCommGroup M] [Module Coeff M] [DistribMulAction G M] [SMulCommClass G Coeff M]
    (φ : G → M) (hφ : ∀ g h : G, φ (g * h) = g • φ h + φ g)
    (z : ↥(groupCohomology.cocycles₁ (modRep G M)))
    (hz : ∀ g : G, (z : G → (modRep G M)) g = φ g) :
    eCoh 1 G (modRep G M) ((groupCohomology.H1π (modRep G M)).hom z)
      = ExtH1.gammaHom G M (augSES_shortExact G)
          ((Work.GroupCohomology.H1π G M) ⟨φ, (Work.GroupCohomology.mem_Z1_iff G M φ).mpr hφ⟩) := by
  -- The cocycle `φ` seen through Mathlib's (bar-resolution) `cocycles₁`
  let φ' : G → ↥(modRep G M) := fun g => φ g
  have hφc : φ' ∈ groupCohomology.cocycles₁ (modRep G M) := by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    exact hφ g h
  -- … and as an element of the workspace's `Z1`
  let ψ₀ : ↥(Work.GroupCohomology.Z1 G M) :=
    ⟨φ, (Work.GroupCohomology.mem_Z1_iff G M φ).mpr hφ⟩
  have hzψ : z = (⟨(ψ₀.1 : G → (modRep G M)), hφc⟩ :
      ↥(groupCohomology.cocycles₁ (modRep G M))) := by
    apply groupCohomology.cocycles₁_ext
    intro g
    exact hz g
  -- The two degree-one realisations differ at most by a sign (`B1`, proved).
  have hd := Work.SSGRoute.LeadArch2.gammaHom_H1pi_eq_eCoh_or_neg (G := G) (M := M) ψ₀ hφc
  rw [hzψ]
  rcases hd with h | h
  · exact h.symm
  · -- and the sign is harmless because `G = {1,c}` is generated by an involution
    rw [h]
    exact extH_one_eq_neg_self_of_zpowers G c hc hgen (modRep G M)
      (eCoh 1 G (modRep G M)
        ((groupCohomology.H1π (modRep G M)).hom ⟨(ψ₀.1 : G → (modRep G M)), hφc⟩))


end Work.SSGRoute.PT
