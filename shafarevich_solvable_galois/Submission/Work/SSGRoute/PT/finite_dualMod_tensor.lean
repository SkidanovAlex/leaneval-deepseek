namespace Work.SSGRoute.PT

open scoped TensorProduct

/-- The tensor product over `ZMod p` of two finite `ZMod p`-modules is finite: it is a quotient
of the finite module `X × Y →₀ ZMod p` generated by the pure tensors. -/
theorem finite_tensorProduct (p : ℕ) [NeZero p] (X Y : Type) [AddCommGroup X] [Module (ZMod p) X]
    [Finite X] [AddCommGroup Y] [Module (ZMod p) Y] [Finite Y] :
    Finite (TensorProduct (ZMod p) X Y) := by
  have hdom : Finite (X × Y →₀ ZMod p) :=
    Finite.of_injective (fun f : X × Y →₀ ZMod p => (f : X × Y → ZMod p)) DFunLike.coe_injective
  refine Finite.of_surjective
    (Finsupp.linearCombination (ZMod p) (fun q : X × Y => q.1 ⊗ₜ[ZMod p] q.2)) ?_
  intro z
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | tmul x y =>
    exact ⟨Finsupp.single (x, y) 1, by rw [Finsupp.linearCombination_single, one_smul]⟩
  | add a b ha hb =>
    obtain ⟨f, hf⟩ := ha
    obtain ⟨g, hg⟩ := hb
    exact ⟨f + g, by rw [map_add, hf, hg]⟩

theorem finite_dualMod_tensor (p : ℕ) [Fact p.Prime] (X Y : Type) [AddCommGroup X] [Module (ZMod p) X]
    [Finite X] [AddCommGroup Y] [Module (ZMod p) Y] [Finite Y] :
    Finite (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) X Y)) := by
  haveI : Finite (TensorProduct (ZMod p) X Y) := finite_tensorProduct p X Y
  exact Finite.of_injective
    (fun f : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) X Y) =>
      (f : TensorProduct (ZMod p) X Y → ZMod p)) DFunLike.coe_injective

end Work.SSGRoute.PT
