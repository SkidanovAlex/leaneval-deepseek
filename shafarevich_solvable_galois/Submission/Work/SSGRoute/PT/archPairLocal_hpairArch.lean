import Mathlib
import Submission.Work.SSGRoute.PT.hpairArch_bridge
import Submission.Work.SSGRoute.PT.archPairLocal
import Submission.Work.SSGRoute.PT.archPair_level_independent
import Submission.Work.SSGRoute.PT.archPairLocalClauses
import Submission.Work.SSGRoute.PT.levelClassOf_extHRestrict_eq_eCoh_of_seam
import Submission.Work.SSGRoute.PT.bDaux_restrict_eq_psi_restrict

attribute [local instance 1] ULift.module

open CategoryTheory SSGRoute.PTExt
open Work.SSGRoute.ExtH1

namespace Work.SSGRoute.PT

set_option maxHeartbeats 1600000

/-- **The value formula (`hpairArch`) at the involution for `PT.archPairLocal`**, in the seam-place
form in which `PT.finiteS_converse_canonical_v7` consumes it.

Route.  Both sides are values of `χ ∘ ι ∘ levelPair`; the right-hand side is literally
`PT.archPairValue … c φ a L hKL u hu ψ hψ` (`PT/archSwapHalf.lean`).  `PT.archPairLocal` is the value
at the **fixed** level `L_c = PT.archPairLocalL k Ω K c hc1` with `res_{L_c} c ≠ 1`, its seam place
`u_c`, and `z = PT.zLocal … b`; the right-hand side is the value at `L`, its seam place `u`, and
`z' = PTExt.extHRestrict (decompK u) (levelClassOf ψ)`.  Go up to `L' := L_c ⊔ L` with the seam place
`u' := mk (φ|_{L'})`, which lies over both `u_c` and `u` (`PT.liesOver_linked`), and apply
`PT.archPair_level_independent_loc` (proved) twice, from `L_c` to `L'` and from `L` to `L'`; its
hypothesis is that the two cocycles agree pointwise on `D_{u'}` after restriction, which follows from
`hres` and `res_{L'} = res_{L'→L} ∘ res_L` on `⟨c⟩ = {1, c}`.  On the `L`-side the class of `ψ` on
`D_u` is identified with the descent of `b` by
`PT.extHRestrict_levelClassOf_eq_of_eqOn` (proved, input `Work.SSGRoute.extHMap_gammaHom_eq`), using
`hres`; on the `L_c`-side it is `PT.zLocal … b` by construction (`PT.bDaux_spec`).  When
`res_L c = 1`, `D_u = ⊥`, `z = 0` and `b c = ψ 1 = 0`, so both sides agree.  `hus` identifies `u` as
the seam place of `L`; `hb` is the guard of `PT.archPairLocal` (derivable from `hres` + `hψ`, and
supplied directly to avoid the unfolding obstruction).

NOTE (measured): the two spellings of "the class of the descended `⟨c⟩`-cocycle" above are *not*
syntactically the same — `zLocal` packages it with the E0b bridge `PTExt.eCoh`, whereas
`extHRestrict (levelClassOf ψ)` is `ExtH1.gammaHom` of the restricted cocycle
(`extHMap_gammaHom_eq`).  The workspace relates `eCoh` and `gammaHom` only up to sign
(`eCoh_delta`; the E0b node `extH_groupCohomology_iso` says "the sign is allowed to go either way").
Both levels here are seam places, so their decomposition groups are generated by an involution
(`PT.decompK_linked`), and `PT.eCoh_eq_gammaHom_of_zpowers` (`eCoh_eq_gammaHom_of_zpowers` below)
supplies the missing bridge: for such a group all `Ext¹` are 2-torsion
(`PT.extH_one_eq_neg_self_of_zpowers`, proved below), which kills the sign. -/
theorem archPairLocal_hpairArch
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T] [Finite T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (χ : G1pOwn.ChiK p k Ω K T)
    (hχadd : ∀ (L : IntermediateField k Ω) [NumberField L] [FiniteDimensional k L]
      [IsGalois k L] (hKL : K ≤ L) (u v : SSGRoute.PTExt.extH (SSGRoute.PTExt.classesK k L) 2),
      p • u = 0 → p • v = 0 → χ L hKL (u + v) = χ L hKL u + χ L hKL v)
    (hχcompat : ∀ (L : IntermediateField k Ω) [NumberField L] [FiniteDimensional k L]
      [IsGalois k L] (hKL : K ≤ L) (L' : IntermediateField k Ω) [NumberField L']
      [FiniteDimensional k L'] [IsGalois k L'] (hKL' : K ≤ L') (hLL : L ≤ L')
      (u : SSGRoute.PTExt.extH (SSGRoute.PTExt.classesK k L) 2),
      p • u = 0 → χ L' hKL' (Work.SSGRoute.PT.inflLevel L L' hLL u) = χ L hKL u)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → VFcoef p M T)
    (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) a)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) b)
    (φ : Ω →+* ℂ) (hφ : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x))
    (L : IntermediateField k Ω) [NumberField L] [FiniteDimensional k L] [IsGalois k L]
    (hKL : K ≤ L) [Algebra ↥K ↥L] [IsScalarTower k ↥K ↥L] [IsScalarTower ↥K ↥L Ω]
    (u : NK.GlobalCFT.Place ↥L) (hu : NK.GlobalCFT.Place.LiesOver u (archW k Ω K φ))
    (hus : u = NK.GlobalCFT.Place.ofInfinite (NumberField.InfinitePlace.mk
      (φ.comp (algebraMap (↥L) Ω))))
    (ψ : (↥L ≃ₐ[k] ↥L) → VFcoef p M T)
    (hψ : ∀ g h : ↥L ≃ₐ[k] ↥L,
      ψ (g * h) = SSGRoute.PTExt.galRes k (↥K) (↥L) g • ψ h + ψ g)
    (hres : ∀ σ ∈ Subgroup.zpowers c, b σ = ψ (SSGRoute.res k L σ)) :
    archPairLocal p k Ω K ζ hζ hζK T hT χ M c hc2 hc1 φ hφ a b =
      χ L hKL (Work.SSGRoute.PT.iota (k := k) (L := ↥L) u
        (SSGRoute.PTExt.levelPair (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
          (Work.SSGRoute.localUnitsMap k ↥K ↥L (archW k Ω K φ) u hu)
          (archβc p k Ω K ζ hζ hζK T hT M c (archW k Ω K φ) a)
          (SSGRoute.PTExt.extHRestrict (SSGRoute.PTExt.decompK (k := k) u)
            (Work.SSGRoute.PT.levelClassOf p k Ω K T M L ψ hψ)))) := by
  classical
  -- ## The fixed level `L_c` of `PT.archPairLocal`, with its instances
  let Lc : IntermediateField k Ω := archPairLocalL k Ω K c hc1
  haveI hfinLc : FiniteDimensional k ↥Lc := archPairLocalL_fin k Ω K c hc1
  haveI hgalLc : IsGalois k ↥Lc := archPairLocalL_gal k Ω K c hc1
  haveI hnfLc : NumberField ↥Lc := inferInstance
  have hKLc : K ≤ Lc := archPairLocalL_le k Ω K c hc1
  letI hAlgLc : Algebra ↥K ↥Lc := (IntermediateField.inclusion hKLc).toAlgebra
  letI hTowLc₁ : IsScalarTower k ↥K ↥Lc := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowLc₂ : IsScalarTower ↥K ↥Lc Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  have hresLc : SSGRoute.res k Lc c ≠ 1 := archPairLocalL_res k Ω K c hc1
  -- the seam place of `L_c`
  let uc : NK.GlobalCFT.Place ↥Lc := NK.GlobalCFT.Place.ofInfinite
    (NumberField.InfinitePlace.mk (φ.comp (algebraMap (↥Lc) Ω)))
  have huc : NK.GlobalCFT.Place.LiesOver uc (archW k Ω K φ) := liesOver_linked k Ω K Lc φ
  have hDuc : SSGRoute.PTExt.decompK (k := k) uc = (Subgroup.zpowers c).map (SSGRoute.res k Lc) :=
    decompK_linked k Ω Lc c hc2 hc1 φ hφ
  -- ## The common level `L' = L_c ⊔ L`, with its instances
  let L' : IntermediateField k Ω := Lc ⊔ L
  haveI hfinL' : FiniteDimensional k ↥L' := by dsimp only [L']; infer_instance
  haveI hgalL' : IsGalois k ↥L' := by dsimp only [L']; infer_instance
  haveI hnfL' : NumberField ↥L' := inferInstance
  have hLcL' : Lc ≤ L' := by dsimp only [L']; exact le_sup_left
  have hLL' : L ≤ L' := by dsimp only [L']; exact le_sup_right
  have hKLsup : K ≤ L' := hKLc.trans hLcL'
  letI hAlgKL' : Algebra ↥K ↥L' := (IntermediateField.inclusion hKLsup).toAlgebra
  letI hTowKL'₁ : IsScalarTower k ↥K ↥L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowKL'₂ : IsScalarTower ↥K ↥L' Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hAlgLcL' : Algebra ↥Lc ↥L' := (IntermediateField.inclusion hLcL').toAlgebra
  letI hTowLcL'₁ : IsScalarTower k ↥Lc ↥L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowLcL'₂ : IsScalarTower ↥Lc ↥L' Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hAlgLL' : Algebra ↥L ↥L' := (IntermediateField.inclusion hLL').toAlgebra
  letI hTowLL'₁ : IsScalarTower k ↥L ↥L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowLL'₂ : IsScalarTower ↥L ↥L' Ω := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowKLcL' : IsScalarTower ↥K ↥Lc ↥L' := IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  letI hTowKLL' : IsScalarTower ↥K ↥L ↥L' := IsScalarTower.of_algebraMap_eq (fun x => by
    apply (algebraMap ↥L' Ω).injective
    rw [← IsScalarTower.algebraMap_apply ↥L ↥L' Ω,
      ← IsScalarTower.algebraMap_apply ↥K ↥L Ω,
      ← IsScalarTower.algebraMap_apply ↥K ↥L' Ω])
  -- the seam place of `L'`, lying over `w`, `u_c` and `u`
  let u' : NK.GlobalCFT.Place ↥L' := NK.GlobalCFT.Place.ofInfinite
    (NumberField.InfinitePlace.mk (φ.comp (algebraMap (↥L') Ω)))
  have hu'w : NK.GlobalCFT.Place.LiesOver u' (archW k Ω K φ) := liesOver_linked k Ω K L' φ
  have hu'c : NK.GlobalCFT.Place.LiesOver u' uc := liesOver_linked k Ω Lc L' φ
  have hu'L : NK.GlobalCFT.Place.LiesOver u' u := by
    rw [hus]; exact liesOver_linked k Ω L L' φ
  have hDu' : SSGRoute.PTExt.decompK (k := k) u' = (Subgroup.zpowers c).map (SSGRoute.res k L') :=
    decompK_linked k Ω L' c hc2 hc1 φ hφ
  -- ## The restriction maps of the decomposition groups
  have hcompLc : Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w
      = (Work.SSGRoute.decompKRestrict k ↥K ↥Lc (archW k Ω K φ) uc huc).comp
          (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c) :=
    archPair_decompKRestrict_comp (k := k) (K := ↥K) (L := ↥Lc) (L' := ↥L')
      (w := archW k Ω K φ) (u := uc) (u' := u') (hu := huc) (hu'u := hu'c) (hu'w := hu'w)
  have hcompL : Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w
      = (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu).comp
          (Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L) :=
    archPair_decompKRestrict_comp (k := k) (K := ↥K) (L := ↥L) (L' := ↥L')
      (w := archW k Ω K φ) (u := u) (u' := u') (hu := hu) (hu'u := hu'L) (hu'w := hu'w)
  -- ## The descended cocycle on `D_{u_c}` and the level-`L` cocycle `ψ` on `D_u`
  let zF : ↥(SSGRoute.PTExt.decompK (k := k) uc) →
      ↥(zRep p k Ω K T M Lc uc (archW k Ω K φ) huc) :=
    bDaux p k Ω K T M c hc2 Lc hKLc hresLc uc hDuc b hb (archW k Ω K φ) huc
  have hzF_mem : zF ∈ groupCohomology.cocycles₁ (zRep p k Ω K T M Lc uc (archW k Ω K φ) huc) :=
    bDaux_mem p k Ω K T M c hc2 Lc hKLc hresLc uc hDuc b hb (archW k Ω K φ) huc
  let zc : ↥(groupCohomology.cocycles₁ (zRep p k Ω K T M Lc uc (archW k Ω K φ) huc)) :=
    ⟨zF, hzF_mem⟩
  let zF' : ↥(SSGRoute.PTExt.decompK (k := k) u) →
      ↥(Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) :=
    fun d => ψ (d : ↥L ≃ₐ[k] ↥L)
  have hzF'_mem : zF' ∈ groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) := by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    simp only [zF', MonoidHom.comp_apply, Subgroup.coe_subtype, Subgroup.coe_mul,
      Work.SSGRoute.decompKRestrict_coe]
    exact hψ g h
  let zL : ↥(groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))) := ⟨zF', hzF'_mem⟩
  -- ## The two cocycles on the common decomposition group `D_{u'}`
  let zF'' : ↥(SSGRoute.PTExt.decompK (k := k) u') →
      ↥(Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) :=
    fun g => ψ (Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L g)
  have hzF''_mem : zF'' ∈ groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) := by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    have hgl : (↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L (g * h)) : ↥L ≃ₐ[k] ↥L)
        = ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L g)
          * ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L h) := map_mul _ g h
    have hρ2 : ((Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))).ρ g)
          (ψ ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L h))
        = (SSGRoute.PTExt.galRes k (↥K) (↥L))
            ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L g)
          • ψ ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L h) := by
      simp only [Rep.res, MonoidHom.comp_apply, Subgroup.coe_subtype,
        Work.SSGRoute.decompKRestrict_coe]
      rw [← SSGRoute.PTExt.galRes_trans (K := ↥K) (L := ↥L) (L' := ↥L')
          (g : ↥L' ≃ₐ[k] ↥L')]
      rfl
    have h1 : zF'' (g * h) = ψ (↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L g)
        * ↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L h)) := by
      show ψ (↑(Work.SSGRoute.decompKRestrict k ↥L ↥L' u u' hu'L (g * h))
        : ↥L ≃ₐ[k] ↥L) = _
      rw [hgl]
    rw [h1, hψ, hρ2]
    rfl
  let z'L : ↥(groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))) := ⟨zF'', hzF''_mem⟩
  let zF3 : ↥(SSGRoute.PTExt.decompK (k := k) u') →
      ↥(Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) :=
    fun g => zF (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c g)
  have hzF3_mem : zF3 ∈ groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) := by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    dsimp only [zF3]
    have hρ3 : (((Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))).ρ g)
          (zF (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c h)))
        = (((Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥Lc (archW k Ω K φ) uc huc)
          (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
            (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))).ρ
          (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c g))
          (zF (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c h))) := by
      simp only [Rep.res, MonoidHom.comp_apply, Subgroup.coe_subtype,
        Work.SSGRoute.decompKRestrict_coe]
      rw [SSGRoute.PTExt.galRes_trans (K := ↥K) (L := ↥Lc) (L' := ↥L')
        (g : ↥L' ≃ₐ[k] ↥L')]
    rw [map_mul, hρ3]
    exact (groupCohomology.mem_cocycles₁_iff zF).1 hzF_mem
      (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c g)
      (Work.SSGRoute.decompKRestrict k ↥Lc ↥L' uc u' hu'c h)
  let z'c : ↥(groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))) := ⟨zF3, hzF3_mem⟩
  -- ## 1. The level-`L` class of `ψ` on `D_u` in `eCoh`-form
  have hzL : SSGRoute.PTExt.extHRestrict (SSGRoute.PTExt.decompK (k := k) u)
        (Work.SSGRoute.PT.levelClassOf p k Ω K T M L ψ hψ)
      = SSGRoute.PTExt.eCoh 1 ↥(SSGRoute.PTExt.decompK (k := k) u)
        (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
          (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
            (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))
        ((groupCohomology.H1π _).hom zL) :=
    levelClassOf_extHRestrict_eq_eCoh_of_seam (p := p) (k := k) (Ω := Ω) (K := K) (T := T)
      (M := M) (c := c) (hc2 := hc2) (hc1 := hc1) (φ := φ) (hφ := hφ) (L := L) (hKL := hKL)
      (u := u) (hu := hu) (hus := hus) (ψ := ψ) (hψ := hψ) (z := zL) (hz := fun _ => rfl)
  -- ## 2. Both sides are the value at the common level `L'`
  have hstep2 : archPairValueZ p k Ω K ζ hζ hζK T hT χ M c (archW k Ω K φ) a L hKL u hu
        (SSGRoute.PTExt.eCoh 1 ↥(SSGRoute.PTExt.decompK (k := k) u)
          (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
            (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
              (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))
          ((groupCohomology.H1π _).hom zL))
      = χ L' hKLsup (iota (k := k) (L := ↥L') u'
          (SSGRoute.PTExt.levelPair (Work.SSGRoute.decompKRestrict k ↥K ↥L' (archW k Ω K φ) u' hu'w)
