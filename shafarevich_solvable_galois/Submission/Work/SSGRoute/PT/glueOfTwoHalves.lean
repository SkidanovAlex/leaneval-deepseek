/-- **Clauses (1)–(4) of the glued family with an abstract archimedean half**, at every local group.
This is `Work.SSGRoute.E7Arch.pairGlue_pairClauses` (`Submission/Work/SSGRoute/E7Arch/g1Assembly.lean`)
with `pairArchFamily p k Ω K ζ hζ hζK T hT M` replaced by `arch M` and the appeal to
`pairArchFamily_pairClauses … M c hc` replaced by the hypothesis `harch_clauses M c hc`.  The two
branches follow from the corresponding `PairClauses` bundle by
`Work.SSGRoute.E7Arch.pairClauses_of_pair_eq`, using the definitional values
`Work.SSGRoute.PT.pairGlueArch_decomp` (decomposition group of a finite place) and
`Work.SSGRoute.PT.pairGlueArch_arch` (group generated by an involution). -/
theorem pairGlueArch_pairClauses
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hclauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      H1Pair.PairClauses p K T M (fun a b => fin M (SSGRoute.decomp k A) a b)
        (SSGRoute.decomp k A))
    (harch_clauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (c : Ω ≃ₐ[k] Ω), c ^ 2 = 1 →
      H1Pair.PairClauses p K T M (fun a b => arch M (Subgroup.zpowers c) a b) (Subgroup.zpowers c))
    (hempty : E7Arch.LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (H : Subgroup (Ω ≃ₐ[k] Ω)), H1Pair.IsLocalGroup k Ω H →
      H1Pair.PairClauses p K T M
        (fun a b => pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M H a b) H := by
  intro M _ _ _ _ _ H hH
  rcases hH with ⟨A, hA, rfl⟩ | ⟨c, hc, rfl⟩
  · refine E7Arch.pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      (H := SSGRoute.decomp k A)
      (fun a b => pairGlueArch_decomp p k Ω K ζ hζ hζK T hT fin arch hempty M A hA a b)
      (hclauses M A hA)
  · refine E7Arch.pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      (H := Subgroup.zpowers c) (fun a b => ?_)
      (harch_clauses M c hc)
    exact pairGlueArch_arch p k Ω K ζ hζ hζK T hT fin arch M hc rfl a b

/-- **Clause (5) of the glued family with an abstract archimedean half**, at every local group, in
the cocycle-hypothesised shape of `G1`.  This is `pairGlue_naturality_cocycle` of
`Submission/Work/SSGRoute/E7Arch/glueCocycle.lean` with `pairArchFamily p k Ω K ζ hζ hζK T hT M`
replaced by `arch M` and the appeal to `pairArchFamily_naturality` replaced by the hypothesis
`harch_nat`.  The finite-place branch uses the clause (5) hypothesis `hnat`, the archimedean branch
uses `harch_nat`, and the definitional values `pairGlueArch_decomp` / `pairGlueArch_arch` transport
the goal to those two halves. -/
theorem pairGlueArch_naturality
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hnat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
          Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (H : Subgroup (Ω ≃ₐ[k] Ω))
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
        fin M₂ H (fun σ => f (a σ)) b = fin M H a (fun σ => f' (b σ)))
    (harch_nat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
          Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) a ∧
          SSGRoute.IsLocConstOn (Subgroup.zpowers c) a) →
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) b ∧
          SSGRoute.IsLocConstOn (Subgroup.zpowers c) b) →
        arch M₂ (Subgroup.zpowers c) (fun σ => f (a σ)) b =
          arch M (Subgroup.zpowers c) a (fun σ => f' (b σ)))
    (hempty : E7Arch.LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
      [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
      (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
      (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
        Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
      (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
        f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
      (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : H1Pair.IsLocalGroup k Ω H)
      (a : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T))
      (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a)
      (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b),
      pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M₂ H (fun σ => f (a σ)) b =
        pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M H a (fun σ => f' (b σ)) := by
  intro M _ _ _ _ _ M₂ _ _ _ _ _ f hf f' hff' H hH a b ha hb
  rcases hH with ⟨A, hA, rfl⟩ | ⟨c, hc, rfl⟩
  · rw [pairGlueArch_decomp p k Ω K ζ hζ hζK T hT fin arch hempty M₂ A hA (fun σ => f (a σ)) b,
      pairGlueArch_decomp p k Ω K ζ hζ hζK T hT fin arch hempty M A hA a (fun σ => f' (b σ))]
    exact hnat M M₂ f hf f' hff' (SSGRoute.decomp k A) a b ha hb
  · rw [pairGlueArch_arch p k Ω K ζ hζ hζK T hT fin arch M₂ hc rfl (fun σ => f (a σ)) b,
      pairGlueArch_arch p k Ω K ζ hζ hζK T hT fin arch M hc rfl a (fun σ => f' (b σ))]
    exact harch_nat M M₂ f hf f' hff' c hc a b ha hb

/-- **Clause (6) of the glued family with an abstract archimedean half**, at a good place (a finite
place over a prime `≠ p`, unramified in `K`, and outside the places where the cocycle vanishes on
inertia).  This is `Work.SSGRoute.E7Arch.pairGlue_orth` (`Submission/Work/SSGRoute/E7Arch/g1Assembly.lean`)
with `pairArchFamily … M` replaced by `arch M`; the only step is that a good place is a finite place,
so `pairGlueArch_decomp` rewrites the glued value to `fin M (decomp k A) a b`, and `horth` finishes.
No property of `arch` is needed (a good place is never an involution group, by `hempty`). -/
theorem pairGlueArch_orth
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (horth : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
        (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
        (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
        (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
        fin M (SSGRoute.decomp k A) a b = 0)
    (hempty : E7Arch.LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
      (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
      (a : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
      (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
      (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
      (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
      pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M (SSGRoute.decomp k A) a b = 0 := by
  intro M _ _ _ _ _ A hA hpA hramA a b ha hb hiner
  rw [pairGlueArch_decomp p k Ω K ζ hζ hζK T hT fin arch hempty M A hA a b]
  exact horth M A hA hpA hramA a b ha hb hiner

/-- The generic two-half gluing of `G1⁺`: an abstract archimedean half `arch` in place of
`E7Arch.pairArchFamily`, with its clauses (1)-(4) at the involution groups (`harch_clauses`, stated
for every `c` with `c ^ 2 = 1`, hence also at `⊥ = zpowers 1`) and its naturality clause (5)
(`harch_nat`).  Everything else is `E7Arch.glue_of_finiteHalf_cocycle`: copy `pairGlue`,
`pairGlue_arch`, `pairGlue_fin`, `pairGlue_decomp`, `pairGlue_pairClauses`, `pairGlue_naturality`,
`pairGlue_orth`, `pairGlue_reciprocity` from `E7Arch/g1Assembly.lean` and
`E7Arch/glueCocycle.lean`, replacing every occurrence of `pairArchFamily p k Ω K ζ hζ hζK T hT M`
by `arch M` and every appeal to `pairArchFamily_pairClauses` / `pairArchFamily_naturality` by the
corresponding hypothesis `harch_clauses M c hc` / `harch_nat … c hc`. -/
theorem glueOfTwoHalves
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (arch : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hclauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      H1Pair.PairClauses p K T M (fun a b => fin M (SSGRoute.decomp k A) a b)
        (SSGRoute.decomp k A))
    (hnat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
          Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (H : Subgroup (Ω ≃ₐ[k] Ω))
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
        fin M₂ H (fun σ => f (a σ)) b = fin M H a (fun σ => f' (b σ)))
    (horth : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
        (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
        (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
        (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
        fin M (SSGRoute.decomp k A) a b = 0)
    (harch_clauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (c : Ω ≃ₐ[k] Ω), c ^ 2 = 1 →
      H1Pair.PairClauses p K T M (fun a b => arch M (Subgroup.zpowers c) a b) (Subgroup.zpowers c))
    (harch_nat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
          Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
          f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
        (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)),
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) a ∧
          SSGRoute.IsLocConstOn (Subgroup.zpowers c) a) →
        (SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) b ∧
          SSGRoute.IsLocConstOn (Subgroup.zpowers c) b) →
        arch M₂ (Subgroup.zpowers c) (fun σ => f (a σ)) b =
          arch M (Subgroup.zpowers c) a (fun σ => f' (b σ)))
    (hrecJoint : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', fin M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', arch M (Subgroup.zpowers c) a b = 0)
    (hempty : E7Arch.LocalGroupDisjoint k Ω) :
    ∃ pair : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (H : Subgroup (Ω ≃ₐ[k] Ω)), H1Pair.IsLocalGroup k Ω H →
          H1Pair.PairClauses p K T M (fun a b => pair M H a b) H) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
          [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
          (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
          (f' : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T) →ₗ[ZMod p]
            Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (hff' : ∀ (φ : Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T)) (e : M) (t : T),
            f' φ (TensorProduct.tmul (ZMod p) e t) = φ (TensorProduct.tmul (ZMod p) (f e) t))
          (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : H1Pair.IsLocalGroup k Ω H)
          (a : (Ω ≃ₐ[k] Ω) → M)
          (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M₂ T))
          (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a)
          (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b),
          pair M₂ H (fun σ => f (a σ)) b = pair M H a (fun σ => f' (b σ))) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
          (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
          (a : (Ω ≃ₐ[k] Ω) → M)
          (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
          (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
          (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
          pair M (SSGRoute.decomp k A) a b = 0) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
          [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
          H1Pair.PairReciprocity p K T M (fun H a b => pair M H a b)) :=
  ⟨fun M _ _ _ _ _ => pairGlueArch p k Ω K ζ hζ hζK T hT fin arch M,
    pairGlueArch_pairClauses p k Ω K ζ hζ hζK T hT fin arch hclauses harch_clauses hempty,
    fun M _ _ _ _ _ M₂ _ _ _ _ _ f hf f' hff' H hH a b ha hb =>
      pairGlueArch_naturality p k Ω K ζ hζ hζK T hT fin arch hnat harch_nat hempty
        M M₂ f hf f' hff' H hH a b ha hb,
    fun M _ _ _ _ _ A hA hpA hramA a b ha hb hiner =>
      pairGlueArch_orth p k Ω K ζ hζ hζK T hT fin arch horth hempty
        M A hA hpA hramA a b ha hb hiner,
    fun M _ _ _ _ _ =>
      pairGlueArch_reciprocity p k Ω K ζ hζ hζK T hT fin arch hrecJoint hempty M⟩

end Work.SSGRoute.PT
