namespace Work.SSGRoute.PT

/-- **Existence of a single (per-coefficient-module) canonical local pairing family satisfying the
finite-place clause bundle and agreeing with the archimedean family at the involution groups.**

The construction is the same gluing as `Work.SSGRoute.E7Arch.pairGlue`, but with a *single*
coefficient module `M`: on a subgroup generated by an involution (`Subgroup.zpowers c`, `c ^ 2 = 1`)
the value is the archimedean family `pairArchFamily` (so the second clause is definitional); on a
subgroup that is the decomposition group of a finite place it is a pairing satisfying
`H1Pair.PairClauses`, produced from the local Euler characteristic `hE` and the degree `0`/`2`
duality `h02` through `Work.SSGRoute.E7Fin.pairClauses_of_euler02`; and `0` elsewhere (where the
value is never used).  The two shapes need not be disjoint for the existence statement: when a
decomposition group happens to be an involution group, the archimedean branch is taken and the
clause is supplied by `pairArchFamily_pairClauses`. -/
theorem pt_canonicalFin_clauses_of_euler02
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (hE : ∀ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A),
      ∃ ε, ∀ (M' : Type) [AddCommGroup M'] [Module (ZMod p) M']
        [DistribMulAction (K ≃ₐ[k] K) M'] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M'] [Finite M'],
        Module.Finite (ZMod p) (Work.SSGRoute.H1loc p k Ω K M' (SSGRoute.decomp k A)) ∧
          Module.finrank (ZMod p) (Work.SSGRoute.H1loc p k Ω K M' (SSGRoute.decomp k A)) =
            Module.finrank (ZMod p) ↥(Work.SSGRoute.H0loc p k Ω K M' (SSGRoute.decomp k A)) +
                Module.finrank (ZMod p) (Work.SSGRoute.H2loc p k Ω K M' (SSGRoute.decomp k A)) +
              ε * Module.finrank (ZMod p) M')
    (h02 : ∀ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A), ∀ (M' : Type)
        [AddCommGroup M'] [Module (ZMod p) M'] [DistribMulAction (K ≃ₐ[k] K) M']
        [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M'] [Finite M'],
        (Module.finrank (ZMod p) (Work.SSGRoute.H2loc p k Ω K M' (SSGRoute.decomp k A)) =
          Module.finrank (ZMod p) (Work.SSGRoute.H0loc p k Ω K
            (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M' T)) (SSGRoute.decomp k A))) ∧
        (Module.finrank (ZMod p) (Work.SSGRoute.H2loc p k Ω K
            (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M' T)) (SSGRoute.decomp k A)) =
          Module.finrank (ZMod p) (Work.SSGRoute.H0loc p k Ω K M' (SSGRoute.decomp k A)))) :
    ∃ fin : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
      (∀ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A),
        Work.SSGRoute.H1Pair.PairClauses p K T M (fun a b => fin (SSGRoute.decomp k A) a b)
          (SSGRoute.decomp k A)) ∧
      (∀ (H : Subgroup (Ω ≃ₐ[k] Ω)) (c : Ω ≃ₐ[k] Ω), c ^ 2 = 1 → H = Subgroup.zpowers c →
        ∀ (a : (Ω ≃ₐ[k] Ω) → M)
          (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
          fin H a b = Work.SSGRoute.E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M H a b) := by
  classical
  -- At every finite place, the Euler characteristic and the degree `0`/`2` duality give a pairing
  -- satisfying the clause bundle.
  have hchoose : ∀ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A),
      ∃ P : ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
        Work.SSGRoute.H1Pair.PairClauses p K T M P (SSGRoute.decomp k A) := by
    intro A hA
    obtain ⟨B, -, -, hpc⟩ :=
      Work.SSGRoute.E7Fin.pairClauses_of_euler02 p k Ω K ζ hζ hζK T hT A hA
        (hE A hA) (h02 A hA) M
    exact ⟨fun a b =>
        B (Work.SSGRoute.toClass p k Ω K M (SSGRoute.decomp k A) a)
          (Work.SSGRoute.toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
            (SSGRoute.decomp k A) b), hpc⟩
  -- The same at any subgroup that *is* a decomposition group.
  have hex : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
      (∃ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A), H = SSGRoute.decomp k A) →
      ∃ P : ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
        Work.SSGRoute.H1Pair.PairClauses p K T M P H := by
    intro H hH
    obtain ⟨A, hA, heq⟩ := hH
    obtain ⟨P, hP⟩ := hchoose A hA
    exact ⟨P, heq.symm ▸ hP⟩
  -- The glued family: archimedean at the involution groups, chosen finite-place pairing at the
  -- decomposition groups, `0` elsewhere.
  let fin : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p :=
    fun H =>
      if h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c then
        Work.SSGRoute.E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M H
      else if _h' : ∃ (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A),
            H = SSGRoute.decomp k A then
        Classical.choose (hex H _h')
      else 0
  refine ⟨fin, ?_, ?_⟩
  · -- Clause (1): the bundle at every finite place.
    intro A hA
    by_cases h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ SSGRoute.decomp k A = Subgroup.zpowers c
    · -- the decomposition group is generated by an involution: the archimedean branch of `fin`,
      -- whose clauses hold by `pairArchFamily_pairClauses`
      have hfin : fin (SSGRoute.decomp k A) =
          Work.SSGRoute.E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M (SSGRoute.decomp k A) :=
        dif_pos h
      obtain ⟨c, hc, heq⟩ := h
      rw [hfin]
      exact heq.symm ▸
        (Work.SSGRoute.E7Arch.pairArchFamily_pairClauses p k Ω K ζ hζ hζK T hT M c hc)
    · -- otherwise the finite-place branch
      have h' : ∃ (A' : ValuationSubring Ω) (hA' : SSGRoute.IsFinPlace k A'),
          SSGRoute.decomp k A = SSGRoute.decomp k A' := ⟨A, hA, rfl⟩
      have hfin : fin (SSGRoute.decomp k A) =
          Classical.choose (hex (SSGRoute.decomp k A) h') :=
        (dif_neg h).trans (dif_pos h')
      rw [hfin]
      exact Classical.choose_spec (hex (SSGRoute.decomp k A) h')
  · -- Clause (2): the value at an involution group is the archimedean one, by construction.
    intro H c hc heq a b
    have h : ∃ c' : Ω ≃ₐ[k] Ω, c' ^ 2 = 1 ∧ H = Subgroup.zpowers c' := ⟨c, hc, heq⟩
    have hfin : fin H = Work.SSGRoute.E7Arch.pairArchFamily p k Ω K ζ hζ hζK T hT M H :=
      dif_pos h
    rw [hfin]

end Work.SSGRoute.PT
