/-!
# Assembly of `Work.SSGRoute.PT.pt_canonical_relaxed`

This module carries out the *formal* passage from the two arithmetic inputs

* `Work.SSGRoute.PT.pt_canonical_pairing` — the canonical local Tate pairing with its local axioms
  (clauses (1)) and the global reciprocity law (clause (2)), and
* `Work.SSGRoute.PT.pt_selmer_counting_identity` — the Poitou–Tate counting identity
  `|V| · |W| = |∏_{S ∪ C} H¹|`,

to the full statement `Work.SSGRoute.PT.pt_canonical_relaxed` (the realizability clause (3)).

The argument is the one described in `pt_counting_assembly`: the local axioms turn the local
pairings into perfect pairings `B H` on the local `H¹`-groups (`exists_pairing_on_H1loc`), their
product `β = productFormFun B` is non-degenerate in each variable at the local groups of `S ∪ C`
(`productFormFun_ndR`/`ndL`), reciprocity gives `V ⊆ W^⊥`
(`pt_orthogonality_of_realizable`, with the reciprocal set of `pt_reciprocal_set`), the counting
identity gives `|V| · |W| = |P|`, and `wbot_le_of_additive` then gives `W^⊥ ⊆ V`.  Reading
`mem_primalClassSet_iff` backwards produces the realizing cocycle `ε`.
-/

open scoped TensorProduct Pointwise
open Classical

set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

namespace Work.SSGRoute.PT

noncomputable section

section Defs

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
  (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]

local instance : AddCommGroup (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) :=
  inferInstance
local instance : Module (ZMod p) (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) :=
  inferInstance
local instance : DistribMulAction (K ≃ₐ[k] K) (Work.SSGRoute.DualMod p
    (TensorProduct (ZMod p) M T)) := inferInstance
local instance : SMulCommClass (K ≃ₐ[k] K) (ZMod p) (Work.SSGRoute.DualMod p
    (TensorProduct (ZMod p) M T)) := inferInstance

/-- The local pairing pushed down to the local `H¹`-groups.  At a group at which the local axioms
are available it is the bilinear form produced by `exists_pairing_on_H1loc`; elsewhere it is `0`,
which is harmless because `productFormFun` evaluates it only at decomposition groups of places of
`S` and at subgroups generated by the involutions of `C`. -/
noncomputable def localPairingFun
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H) :
    ∀ H : Subgroup (Ω ≃ₐ[k] Ω), H1loc p k Ω K M H →ₗ[ZMod p]
      H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H →ₗ[ZMod p] ZMod p :=
  fun H => if h : IsLocalGroup k Ω H then
    (Classical.choose (exists_pairing_on_H1loc (p := p) (k := k) (Ω := Ω) (K := K)
      (M := M) (M' := Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H (pair H)
      (hloc H h).1 (hloc H h).2.1
      (fun a b ha hb hcob => (hloc H h).2.2.1 a b ha hb (Or.inl hcob))
      (fun a b ha hb hcob => (hloc H h).2.2.1 a b ha hb (Or.inr hcob))
      (hloc H h).2.2.2.1 (hloc H h).2.2.2.2))
  else 0

/-- The defining property of `localPairingFun` on locally constant cocycles. -/
theorem localPairingFun_toClass
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H)
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : IsLocalGroup k Ω H)
    (a : (Ω ≃ₐ[k] Ω) → M)
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
    (ha : a ∈ lcCocycles p k Ω K M H)
    (hb : b ∈ lcCocycles p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H) :
    localPairingFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair hloc H
        (toClass p k Ω K M H a)
        (toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H b)
      = pair H a b := by
  have hspec := Classical.choose_spec (exists_pairing_on_H1loc (p := p) (k := k) (Ω := Ω) (K := K)
    (M := M) (M' := Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H (pair H)
    (hloc H hH).1 (hloc H hH).2.1
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inl hcob))
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inr hcob))
    (hloc H hH).2.2.2.1 (hloc H hH).2.2.2.2)
  rw [localPairingFun, dif_pos hH]
  exact hspec.1 a b ha hb

/-- The non-degeneracy of `localPairingFun` in the first variable. -/
theorem localPairingFun_ndL
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H)
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : IsLocalGroup k Ω H) :
    ∀ x : H1loc p k Ω K M H,
      (∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H,
        localPairingFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair hloc H
          x y = 0) → x = 0 := by
  have hspec := Classical.choose_spec (exists_pairing_on_H1loc (p := p) (k := k) (Ω := Ω) (K := K)
    (M := M) (M' := Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H (pair H)
    (hloc H hH).1 (hloc H hH).2.1
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inl hcob))
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inr hcob))
    (hloc H hH).2.2.2.1 (hloc H hH).2.2.2.2)
  rw [localPairingFun, dif_pos hH]
  exact hspec.2.1

/-- The non-degeneracy of `localPairingFun` in the second variable. -/
theorem localPairingFun_ndR
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H)
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : IsLocalGroup k Ω H) :
    ∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H,
      (∀ x : H1loc p k Ω K M H,
        localPairingFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair hloc H
          x y = 0) → y = 0 := by
  have hspec := Classical.choose_spec (exists_pairing_on_H1loc (p := p) (k := k) (Ω := Ω) (K := K)
    (M := M) (M' := Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H (pair H)
    (hloc H hH).1 (hloc H hH).2.1
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inl hcob))
    (fun a b ha hb hcob => (hloc H hH).2.2.1 a b ha hb (Or.inr hcob))
    (hloc H hH).2.2.2.1 (hloc H hH).2.2.2.2)
  rw [localPairingFun, dif_pos hH]
  exact hspec.2.2

end Defs

end

/-! ## The reciprocity and realizability clauses -/

section Main

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] (K N : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  [FiniteDimensional k N] [IsGalois k N] (hKN : K ≤ N)
  (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
  (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
  (S : Finset (ValuationSubring Ω)) (C : Finset (Ω ≃ₐ[k] Ω))

local instance : AddCommGroup (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) :=
  inferInstance
local instance : Module (ZMod p) (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) :=
  inferInstance
local instance : DistribMulAction (K ≃ₐ[k] K) (Work.SSGRoute.DualMod p
    (TensorProduct (ZMod p) M T)) := inferInstance
local instance : SMulCommClass (K ≃ₐ[k] K) (ZMod p) (Work.SSGRoute.DualMod p
    (TensorProduct (ZMod p) M T)) := inferInstance

/-- The reciprocity clause (2) of `pt_canonical_relaxed`: the sum of the local values over a
large enough set of places, one per prime, plus one involution per real place, vanishes on global
cocycles. -/
def Recip (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
    ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p) : Prop :=
  ∀ (a : (Ω ≃ₐ[k] Ω) → M)
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
    ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
    (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
    (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
      ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
    ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
    (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
    (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
    ∑ A ∈ S', pair (SSGRoute.decomp k A) a b + ∑ c ∈ C', pair (Subgroup.zpowers c) a b = 0

/-- The realizability clause (3) of `pt_canonical_relaxed`. -/
def Realiz (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
    ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → M) (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M) : Prop :=
  (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) →
        SSGRoute.IsSplitIn k N B →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B) b) →
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) →
        ¬ SSGRoute.IsSplitIn k N B →
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → b σ = 0) →
      ∑ A ∈ S, pair (SSGRoute.decomp k A) (α A) b +
        ∑ c ∈ C, pair (Subgroup.zpowers c) (β c) b = 0) →
  ∃ ε : (Ω ≃ₐ[k] Ω) → M,
    SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ ε ∧ SSGRoute.IsLocConstOn ⊤ ε ∧
    (∀ A ∈ S, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A)
      (fun σ => ε σ - α A σ)) ∧
    (∀ c ∈ C, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
      (fun σ => ε σ - β c σ)) ∧
    ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → ¬ SSGRoute.IsSplitIn k N B →
      ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → ε σ = 0


/-- **The archimedean half of the local axioms of the target, in this file's vocabulary.**

For an involution `c`, the *proved* archimedean local Tate duality
`Work.SSGRoute.local_tate_duality_archimedean` supplies a pairing on the locally constant cocycles of
`⟨c⟩` whose six clauses are exactly `LocalAxioms … (Subgroup.zpowers c)`: its two
"zero on a coboundary" clauses split the cases, and merging them gives the `∨`-clause of
`LocalAxioms`.  Consequently the half of the arithmetic input (1) that concerns the *real* places is
not an input at all: it is available here, sorry-free.  The half that remains is the finite-place
local Tate duality together with the *global* reciprocity law (which involves both halves at once
and is therefore not separable from the choice of pairing). -/
theorem exists_localAxioms_zpowers (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    ∃ pairc : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pairc
        (Subgroup.zpowers c) := by
  obtain ⟨pair, h1, h2, h3, h4, h5, h6⟩ :=
    SSGRoute.local_tate_duality_archimedean p k Ω K ζ hζ hζK M T hT c hc
  -- the `H`-index of `LocalAxioms` is irrelevant at an involution: the pairing is constant in it
  refine ⟨fun _ => pair, ?_, ?_, ?_, ?_, ?_⟩
  · intro a a' b ha ha' hb
    exact h1 a a' a b b ha ha' hb
  · intro a b b' ha hb hb'
    exact h2 a a b b' ha hb hb'
  · intro a b ha hb hcob
    rcases hcob with h | h
    · exact h3 a b ha hb h
    · exact h4 a b ha hb h
  · intro a ha hb
    exact h5 a ha hb
  · intro b hb ha
    exact h6 b hb ha

/-- **Finiteness of the primal class space** (input (3), primal side), as a named proposition: the
body is elaborated *here* (where the instance search for the Tate dual resolves), so that a proof of
it can be produced in another module and cited without re-triggering that search. -/
def PrimalClassesFinite : Prop := Finite (primalClasses p k Ω K M S C)

/-- **Finiteness of the Tate-dual class space** (input (3), dual side), as a named proposition. -/
def DualClassesFinite : Prop := Finite (primalClasses p k Ω K
    (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C)

/-- **The Poitou–Tate counting identity of the target, as one proposition**: `|V| · |W| = |P|`,
where `V` is the set of realizable classes, `W` the set of relaxed dual Selmer classes and `P` the
product of the local `H¹`-spaces at `S ∪ C`.  This is the `hcount` hypothesis of
`pt_canonical_relaxed_of_inputs`, named so that it can be quoted and dispatched as a single
statement (Milne, *Arithmetic Duality Theorems* I.4.10 (b) at `r = 1`; NSW 8.6.8, in the relaxed
form of Schmidt–Wingberg).  It is *equivalent* to the realizability clause (3) of the target given
the pairing clauses and the formal inclusion `V ⊆ W^⊥` (`pt_orthogonality_of_realizable`), so it is
the heart of the node and not a detachable consequence of the other inputs. -/
def CountingIdentity : Prop :=
  Nat.card {x : primalClasses p k Ω K M S C //
      IsRealizableClass p k Ω K N hKN M S C x} *
    Nat.card {y : primalClasses p k Ω K (Work.SSGRoute.DualMod p
        (TensorProduct (ZMod p) M T)) S C //
      IsDualSelmerClass p k Ω K N hKN T M S C y} =
    Nat.card (primalClasses p k Ω K M S C)


/-- The product form evaluated at the local class of a pair of local data: the sum of the local
pairings of `(α, β)` against a global dual Selmer class `b`. -/
theorem productFormFun_primalClassOf
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (B : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), H1loc p k Ω K M H →ₗ[ZMod p]
      H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) H →ₗ[ZMod p] ZMod p)
    (hB : ∀ A ∈ S, ∀ (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      a ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) →
      b ∈ lcCocycles p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (SSGRoute.decomp k A) →
      B (SSGRoute.decomp k A) (toClass p k Ω K M (SSGRoute.decomp k A) a)
        (toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (SSGRoute.decomp k A) b) = pair (SSGRoute.decomp k A) a b)
    (hBc : ∀ c ∈ C, ∀ (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      a ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) →
      b ∈ lcCocycles p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (Subgroup.zpowers c) →
      B (Subgroup.zpowers c) (toClass p k Ω K M (Subgroup.zpowers c) a)
        (toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (Subgroup.zpowers c) b) = pair (Subgroup.zpowers c) a b)
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → M) (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M)
    (hα : ∀ A ∈ S, α A ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A))
    (hβ : ∀ c ∈ C, β c ∈ lcCocycles p k Ω K M (Subgroup.zpowers c))
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
    (hb : b ∈ dualSelmer p k Ω K N T M S) :
    productFormFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) (S := S) (C := C) B
        (primalClassOf p k Ω K M S C α β) (dualClassMap p k Ω K T M S C b)
      = (∑ A ∈ S.attach, pair (SSGRoute.decomp k A.1) (α A.1) b)
        + (∑ c ∈ C.attach, pair (Subgroup.zpowers c.1) (β c.1) b) := by
  classical
  simp only [productFormFun, primalClassOf, dualClassMap]
  congr 1
  · exact Finset.sum_congr rfl (fun A _ => hB A.1 A.2 (α A.1) b (hα A.1 A.2)
      (isCocycleOn_of_mem_dualSelmer p k Ω K N T M S hb _))
  · exact Finset.sum_congr rfl (fun c _ => hBc c.1 c.2 (β c.1) b (hβ c.1 c.2)
      (isCocycleOn_of_mem_dualSelmer p k Ω K N T M S hb _))


/-- **The counting step with a predicate interface.**  This is `wbot_le_of_additive` with the two
submodules replaced by their membership predicates, so that it can be applied to submodules
elaborated in another context (where the `Submodule` instance arguments are not syntactically the
same). -/
theorem wbot_le_of_additive_pred {P Q : Type*} [AddCommGroup P] [Module (ZMod p) P] [Finite P]
    [AddCommGroup Q] [Module (ZMod p) Q] [Finite Q]
    (β : P → Q → ZMod p)
    (haddL : ∀ x x' y, β (x + x') y = β x y + β x' y)
    (haddR : ∀ x y y', β x (y + y') = β x y + β x y')
    (hndL : ∀ x : P, (∀ y : Q, β x y = 0) → x = 0)
    (hndR : ∀ y : Q, (∀ x : P, β x y = 0) → y = 0)
    (Vp : P → Prop) (Wp : Q → Prop)
    (hV0 : Vp 0) (hVadd : ∀ x x', Vp x → Vp x' → Vp (x + x'))
    (hVsmul : ∀ (c : ZMod p) x, Vp x → Vp (c • x))
    (hW0 : Wp 0) (hWadd : ∀ y y', Wp y → Wp y' → Wp (y + y'))
    (hWsmul : ∀ (c : ZMod p) y, Wp y → Wp (c • y))
    (hVW : ∀ x, Vp x → ∀ y, Wp y → β x y = 0)
    (hcard : Nat.card {x : P // Vp x} * Nat.card {y : Q // Wp y} = Nat.card P) :
    ∀ x : P, (∀ y : Q, Wp y → β x y = 0) → Vp x := by
  classical
  haveI : Module.Finite (ZMod p) P := Module.Finite.of_finite
  haveI : Module.Finite (ZMod p) Q := Module.Finite.of_finite
  let inner : ∀ (_ : P), Q →+ ZMod p :=
    fun x => AddMonoidHom.mk' (β x) (fun y y' => haddR x y y')
  have hinner : ∀ x x' : P, inner (x + x') = inner x + inner x' := by
    intro x x'
    ext y
    exact haddL x x' y
  let F : P →+ (Q →ₗ[ZMod p] ZMod p) :=
    AddMonoidHom.mk' (fun x => AddMonoidHom.toZModLinearMap p (inner x))
      (fun x x' => by
        rw [hinner x x']
        ext y
        rfl)
  let βlin : P →ₗ[ZMod p] Q →ₗ[ZMod p] ZMod p := AddMonoidHom.toZModLinearMap p F
  have hβlin : ∀ x y, βlin x y = β x y := fun x y => rfl
  have hndL' : ∀ x : P, (∀ y : Q, βlin x y = 0) → x = 0 :=
    fun x hx => hndL x (fun y => by rw [← hβlin]; exact hx y)
  have hndR' : ∀ y : Q, (∀ x : P, βlin x y = 0) → y = 0 :=
    fun y hy => hndR y (fun x => by rw [← hβlin]; exact hy x)
  let Vsub : Submodule (ZMod p) P :=
    { carrier := {x | Vp x}
      zero_mem' := hV0
      add_mem' := by intro x y hx hy; exact hVadd x y hx hy
      smul_mem' := by intro c x hx; exact hVsmul c x hx }
  let Wsub : Submodule (ZMod p) Q :=
    { carrier := {y | Wp y}
      zero_mem' := hW0
      add_mem' := by intro y y' hy hy'; exact hWadd y y' hy hy'
      smul_mem' := by intro c y hy; exact hWsmul c y hy }
  have hVsub : ∀ x, x ∈ Vsub ↔ Vp x := fun x => Iff.rfl
  have hWsub : ∀ y, y ∈ Wsub ↔ Wp y := fun y => Iff.rfl
  have hVW' : ∀ x ∈ Vsub, ∀ y : Wsub, βlin x y = 0 := by
    intro x hx y
    rw [hβlin]
    exact hVW x ((hVsub x).mp hx) y.1 ((hWsub y.1).mp y.2)
  have hcard' : Nat.card Vsub * Nat.card Wsub = Nat.card P := hcard
  have hres := wbot_le_of_natCard βlin hndL' hndR' Vsub Wsub hVW' hcard'
  intro x hx
  exact (hVsub x).mp (hres x (fun y => by
    rw [hβlin]
    exact hx y.1 ((hWsub y.1).mp y.2)))


/-- **The `𝔽_p`-dual of a finite module is finite** (as a type): `DualMod p B = B →ₗ[𝔽_p] 𝔽_p` is a
subtype of the finite type `B → 𝔽_p`.  (`Finite (DualMod p B)` is *not* an instance, and it is needed
as the `[Finite M]` argument of the local-field input at the Tate dual `M^∨(1) = DualMod p (M ⊗ T)`.)
-/
theorem finite_dualMod (p : ℕ) [Fact p.Prime] (B : Type) [AddCommGroup B] [Module (ZMod p) B]
    [Finite B] : Finite (Work.SSGRoute.DualMod p B) :=
  Finite.of_injective (fun (f : Work.SSGRoute.DualMod p B) => (f : B → ZMod p))
    (fun f g hfg => LinearMap.ext (fun b => congrFun hfg b))

/-- **The counting step at the concrete class spaces** (input (4) of the target node): the abstract
`wbot_le_of_additive_pred`, applied with the *membership predicates* of the two given submodules.

The predicate interface is what makes this work: `V` and `W` carry their module instances inside
their types, so the only instance arguments that have to be synthesised at the application site are
those of `primalClasses` itself (which is why the two finiteness hypotheses are passed explicitly and
installed as instances first). -/
theorem counting_step_concrete
    (hfinP : Finite (primalClasses p k Ω K M S C))
    (hfinQ : Finite (primalClasses p k Ω K
      (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C))
    (β : primalClasses p k Ω K M S C →
      primalClasses p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C → ZMod p)
    (haddL : ∀ x x' y, β (x + x') y = β x y + β x' y)
    (haddR : ∀ x y y', β x (y + y') = β x y + β x y')
    (hndL : ∀ x : primalClasses p k Ω K M S C, (∀ y, β x y = 0) → x = 0)
    (hndR : ∀ y : primalClasses p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
      S C, (∀ x, β x y = 0) → y = 0)
    (V : Submodule (ZMod p) (primalClasses p k Ω K M S C))
    (W : Submodule (ZMod p) (primalClasses p k Ω K
      (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C))
    (hVW : ∀ x ∈ V, ∀ y : W, β x y = 0)
    (hcard : Nat.card V * Nat.card W = Nat.card (primalClasses p k Ω K M S C)) :
    ∀ x : primalClasses p k Ω K M S C, (∀ y : W, β x y = 0) → x ∈ V := by
  classical
  -- Every instance argument is supplied explicitly: the search for
  -- `Module (ZMod p) (primalClasses …)` cannot be left to the elaborator at an application site
  -- (`primalClasses` is a product of function types, and the search for the `Module` structure on it
  -- does not terminate in this context), so the instance terms are named here, where the goal type
  -- is concrete and the search succeeds.
  have hres := @wbot_le_of_additive_pred p (inferInstance : Fact p.Prime)
    (primalClasses p k Ω K M S C)
    (primalClasses p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C)
    (inferInstance : AddCommGroup (primalClasses p k Ω K M S C))
    (inferInstance : Module (ZMod p) (primalClasses p k Ω K M S C))
    hfinP
    (inferInstance : AddCommGroup (primalClasses p k Ω K
      (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C))
    (inferInstance : Module (ZMod p) (primalClasses p k Ω K
      (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) S C))
    hfinQ
    β haddL haddR hndL hndR
    (fun x => x ∈ V) (fun y => y ∈ W) V.zero_mem
    (fun x x' hx hx' => V.add_mem hx hx') (fun c x hx => V.smul_mem c hx)
    W.zero_mem (fun y y' hy hy' => W.add_mem hy hy') (fun c y hy => W.smul_mem c hy)
    (fun x hx y hy => hVW x hx ⟨y, hy⟩) hcard
  intro x hx
  exact hres x (fun y hy => hx ⟨y, hy⟩)

/-- **The assembly.**  From the canonical local pairing with reciprocity (clauses (1) and (2)) and
the Poitou–Tate counting identity, plus finiteness of the local class spaces at `S ∪ C`, the
realizability clause (3) follows. -/
theorem pt_canonical_relaxed_of_inputs
    (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (hSdisj : ∀ A ∈ S, ∀ B ∈ S, SSGRoute.IsConjPlace k A B → A = B)
    (hSram : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (SSGRoute.IsRamifiedIn k N B ∨ B.valuation (p : Ω) < 1) →
      ∃ A ∈ S, SSGRoute.IsConjPlace k A B)
    (hCinv : ∀ c ∈ C, c ^ 2 = 1)
    (hC : ∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C, ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹)
    (hCdisj : ∀ c ∈ C, ∀ c' ∈ C, (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c')
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → M)
    (hα : ∀ A ∈ S, SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) (α A) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) (α A))
    (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M)
    (hβ : ∀ c ∈ C, SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) (β c))
    (hpair : ∃ pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
      (∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
        LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H) ∧
      Recip (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair)
    (hcount : Nat.card {x : primalClasses p k Ω K M S C //
        IsRealizableClass p k Ω K N hKN M S C x} *
      Nat.card {y : primalClasses p k Ω K (Work.SSGRoute.DualMod p
          (TensorProduct (ZMod p) M T)) S C //
        IsDualSelmerClass p k Ω K N hKN T M S C y} =
      Nat.card (primalClasses p k Ω K M S C))
    (hfinP : Finite (primalClasses p k Ω K M S C))
    (hfinQ : Finite (primalClasses p k Ω K (Work.SSGRoute.DualMod p
      (TensorProduct (ZMod p) M T)) S C))
    :
    ∃ pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p,
      (∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
        LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H) ∧
      Recip (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair ∧
      Realiz (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (T := T) (M := M) (S := S) (C := C)
        pair α β := by
  classical
  obtain ⟨pair, hloc, hrec⟩ := hpair
  let B := localPairingFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair hloc
  have hB : ∀ A ∈ S, ∀ (a : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      a ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) →
      b ∈ lcCocycles p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (SSGRoute.decomp k A) →
      B (SSGRoute.decomp k A) (toClass p k Ω K M (SSGRoute.decomp k A) a)
        (toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (SSGRoute.decomp k A) b) = pair (SSGRoute.decomp k A) a b := by
    intro A hA a b ha hb
    exact localPairingFun_toClass (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inl ⟨A, hSfin A hA, rfl⟩) a b ha hb
  have hBc : ∀ c ∈ C, ∀ (a : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      a ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) →
      b ∈ lcCocycles p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (Subgroup.zpowers c) →
      B (Subgroup.zpowers c) (toClass p k Ω K M (Subgroup.zpowers c) a)
        (toClass p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
          (Subgroup.zpowers c) b) = pair (Subgroup.zpowers c) a b := by
    intro c hc a b ha hb
    exact localPairingFun_toClass (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inr ⟨c, hCinv c hc, rfl⟩) a b ha hb
  have hndL : ∀ A ∈ S, ∀ x : H1loc p k Ω K M (SSGRoute.decomp k A),
      (∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (SSGRoute.decomp k A), B (SSGRoute.decomp k A) x y = 0) → x = 0 :=
    fun A hA => localPairingFun_ndL (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inl ⟨A, hSfin A hA, rfl⟩)
  have hndLc : ∀ c ∈ C, ∀ x : H1loc p k Ω K M (Subgroup.zpowers c),
      (∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (Subgroup.zpowers c), B (Subgroup.zpowers c) x y = 0) → x = 0 :=
    fun c hc => localPairingFun_ndL (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inr ⟨c, hCinv c hc, rfl⟩)
  have hndR : ∀ A ∈ S, ∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (SSGRoute.decomp k A),
      (∀ x : H1loc p k Ω K M (SSGRoute.decomp k A), B (SSGRoute.decomp k A) x y = 0) → y = 0 :=
    fun A hA => localPairingFun_ndR (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inl ⟨A, hSfin A hA, rfl⟩)
  have hndRc : ∀ c ∈ C, ∀ y : H1loc p k Ω K (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
        (Subgroup.zpowers c),
      (∀ x : H1loc p k Ω K M (Subgroup.zpowers c), B (Subgroup.zpowers c) x y = 0) → y = 0 :=
    fun c hc => localPairingFun_ndR (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      pair hloc (Or.inr ⟨c, hCinv c hc, rfl⟩)
  have hcard : Nat.card (primalClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (M := M)
        (S := S) (C := C)) *
      Nat.card (dualClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (T := T) (M := M)
        (S := S) (C := C)) = Nat.card (primalClasses p k Ω K M S C) :=
    natCard_counting (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (hKN := hKN) (T := T) (M := M)
      (S := S) (C := C) hCinv hcount
  have hVW : ∀ x ∈ primalClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (M := M)
        (S := S) (C := C),
      ∀ y : dualClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (T := T) (M := M)
        (S := S) (C := C),
        productFormFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) (S := S) (C := C)
          B x y.1 = 0 := by
    intro x hx y
    rw [mem_primalClassSet_iff (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (hKN := hKN)
      (M := M) (S := S) (C := C) hCinv x] at hx
    obtain ⟨α', β', ε, hcls, hε1, hε2, hεα', hεβ', hεunr⟩ := hx
    obtain ⟨b, hb⟩ := LinearMap.mem_range.mp y.2
    have hby : dualClassMap (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) (S := S)
        (C := C) b.1 = y := hb
    rw [← hby, ← hcls]
    have hεmem : ε ∈ primalSelmer p k Ω K N M S := ⟨hε1, hε2, hεunr⟩
    have hεα'lc : ∀ A ∈ S, (fun σ => ε σ - α' A σ) ∈
        lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      fun A hA => coboundaries_le_lcCocycles p k Ω K M (SSGRoute.decomp k A)
        ((mem_coboundaries p k Ω K M (SSGRoute.decomp k A) _).mpr (hεα' A hA))
    have hεβ'lc : ∀ c ∈ C, (fun σ => ε σ - β' c σ) ∈
        lcCocycles p k Ω K M (Subgroup.zpowers c) :=
      fun c hc => coboundaries_le_lcCocycles p k Ω K M (Subgroup.zpowers c)
        ((mem_coboundaries p k Ω K M (Subgroup.zpowers c) _).mpr (hεβ' c hc))
    have hα'lc : ∀ A ∈ S, α' A ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) := by
      intro A hA
      have hεA : ε ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
        ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hε1, isLocConstOn_mono le_top hε2⟩
      have heq : α' A = ε - (fun σ => ε σ - α' A σ) := by
        ext σ; simp only [Pi.sub_apply]; abel
      rw [heq]
      exact Submodule.sub_mem _ hεA (hεα'lc A hA)
    have hβ'lc : ∀ c ∈ C, β' c ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) := by
      intro c hc
      have hεc : ε ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) :=
        ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hε1, isLocConstOn_mono le_top hε2⟩
      have heq : β' c = ε - (fun σ => ε σ - β' c σ) := by
        ext σ; simp only [Pi.sub_apply]; abel
      rw [heq]
      exact Submodule.sub_mem _ hεc (hεβ'lc c hc)
    obtain ⟨S', hS'sub, hS'fin, hS'disj, hS'good, hS'cob⟩ :=
      exists_reciprocal_set (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (hKN := hKN)
        (T := T) (M := M) (S := S) hSfin hSdisj hSram ε hεmem b.1 b.2
    have hzero : ∑ A ∈ S, pair (SSGRoute.decomp k A) (α' A) b.1 +
        ∑ c ∈ C, pair (Subgroup.zpowers c) (β' c) b.1 = 0 :=
      pt_orthogonality_of_realizable (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
        pair hloc hrec S hSfin C α' β' ε ⟨hε1, hε2⟩
        (fun A hA => hα'lc A hA) hεα' (fun A hA => hεα'lc A hA)
        (fun c hc => (hβ'lc c hc).1) hεβ' (fun c hc => hεβ'lc c hc)
        b.1 ⟨b.2.1, b.2.2.1⟩ S' hS'sub hS'fin hS'disj hS'good hS'cob hCinv hC hCdisj
    rw [productFormFun_primalClassOf (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (T := T)
      (M := M) (S := S) (C := C) pair B hB hBc α' β' hα'lc hβ'lc b.1 b.2,
      Finset.sum_attach S (fun A => pair (SSGRoute.decomp k A) (α' A) b.1),
      Finset.sum_attach C (fun c => pair (Subgroup.zpowers c) (β' c) b.1)]
    exact hzero
  haveI := hfinP
  haveI := hfinQ
  let βfun := productFormFun (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) (S := S)
    (C := C) B
  let Vset := primalClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (M := M) (S := S)
    (C := C)
  let Wset := dualClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (T := T) (M := M)
    (S := S) (C := C)
  have hVW' : ∀ x ∈ Vset, ∀ y : Wset, βfun x y.1 = 0 := hVW
  have hcard' : Nat.card Vset * Nat.card Wset = Nat.card (primalClasses p k Ω K M S C) := hcard
  have hmain : ∀ x : primalClasses p k Ω K M S C,
      (∀ y : Wset, βfun x y.1 = 0) → x ∈ Vset :=
    counting_step_concrete (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      (S := S) (C := C) hfinP hfinQ βfun
      (fun x x' y => productFormFun_add_left (p := p) (k := k) (Ω := Ω) (K := K)
        (T := T) (M := M) (S := S) (C := C) B x x' y)
      (fun x y y' => productFormFun_add_right (p := p) (k := k) (Ω := Ω) (K := K)
        (T := T) (M := M) (S := S) (C := C) B x y y')
      (fun x hx => productFormFun_ndL (p := p) (k := k) (Ω := Ω) (K := K) (T := T)
        (M := M) (S := S) (C := C) B hndL hndLc x hx)
      (fun y hy => productFormFun_ndR (p := p) (k := k) (Ω := Ω) (K := K) (T := T)
        (M := M) (S := S) (C := C) B hndR hndRc y hy)
      Vset Wset hVW' hcard'
  refine ⟨pair, hloc, hrec, ?_⟩
  intro horth
  have hxmem : primalClassOf p k Ω K M S C α β ∈
      primalClassSet (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (M := M) (S := S) (C := C) := by
    refine hmain _ (fun y => ?_)
    obtain ⟨b, hb⟩ := LinearMap.mem_range.mp y.2
    have hby : dualClassMap (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) (S := S)
        (C := C) b.1 = y := hb
    rw [← hby]
    simp only [βfun]
    rw [productFormFun_primalClassOf (p := p) (k := k) (Ω := Ω) (K := K) (N := N)
      (T := T) (M := M) (S := S) (C := C) pair B hB hBc α β hα
      (fun c hc => ⟨hβ c hc, isLocConstOn_zpowers c (hCinv c hc) (β c)⟩) b.1 b.2,
      Finset.sum_attach S (fun A => pair (SSGRoute.decomp k A) (α A) b.1),
      Finset.sum_attach C (fun c => pair (Subgroup.zpowers c) (β c) b.1)]
    exact horth b.1 b.2.1 b.2.2.1 b.2.2.2.1 b.2.2.2.2
  obtain ⟨α', β', ε, hcls, hε1, hε2, hεα', hεβ', hεunr⟩ :=
    (mem_primalClassSet_iff (p := p) (k := k) (Ω := Ω) (K := K) (N := N) (hKN := hKN)
      (M := M) (S := S) (C := C) hCinv _).mp hxmem
  have hα'lc : ∀ A ∈ S, α' A ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) := by
    intro A hA
    have hεA : ε ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hε1, isLocConstOn_mono le_top hε2⟩
    have hsub : (fun σ => ε σ - α' A σ) ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      coboundaries_le_lcCocycles p k Ω K M (SSGRoute.decomp k A)
        ((mem_coboundaries p k Ω K M (SSGRoute.decomp k A) _).mpr (hεα' A hA))
    have heq : α' A = ε - (fun σ => ε σ - α' A σ) := by
      ext σ; simp only [Pi.sub_apply]; abel
    rw [heq]
    exact Submodule.sub_mem _ hεA hsub
  have hβ'lc : ∀ c ∈ C, β' c ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) := by
    intro c hc
    have hεc : ε ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) :=
      ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hε1, isLocConstOn_mono le_top hε2⟩
    have hsub : (fun σ => ε σ - β' c σ) ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) :=
      coboundaries_le_lcCocycles p k Ω K M (Subgroup.zpowers c)
        ((mem_coboundaries p k Ω K M (Subgroup.zpowers c) _).mpr (hεβ' c hc))
    have heq : β' c = ε - (fun σ => ε σ - β' c σ) := by
      ext σ; simp only [Pi.sub_apply]; abel
    rw [heq]
    exact Submodule.sub_mem _ hεc hsub
  have hαlc : ∀ A ∈ S, α A ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
    fun A hA => hα A hA
  have hβlc : ∀ c ∈ C, β c ∈ lcCocycles p k Ω K M (Subgroup.zpowers c) :=
    fun c hc => ⟨hβ c hc, isLocConstOn_zpowers c (hCinv c hc) (β c)⟩
  have htoA : ∀ A ∈ S, toClass p k Ω K M (SSGRoute.decomp k A) (α' A) =
      toClass p k Ω K M (SSGRoute.decomp k A) (α A) := by
    intro A hA
    exact congrArg (fun z : primalClasses p k Ω K M S C => z.1 ⟨A, hA⟩) hcls
  have htoC : ∀ c ∈ C, toClass p k Ω K M (Subgroup.zpowers c) (β' c) =
      toClass p k Ω K M (Subgroup.zpowers c) (β c) := by
    intro c hc
    exact congrArg (fun z : primalClasses p k Ω K M S C => z.2 ⟨c, hc⟩) hcls
  refine ⟨ε, hε1, hε2, ?_, ?_, hεunr⟩
  · intro A hA
    have h1 : (fun σ => ε σ - α' A σ) ∈ coboundaries p k Ω K M (SSGRoute.decomp k A) :=
      (mem_coboundaries p k Ω K M (SSGRoute.decomp k A) _).mpr (hεα' A hA)
    have h2 : (fun σ => α' A σ - α A σ) ∈ coboundaries p k Ω K M (SSGRoute.decomp k A) :=
      sub_mem_coboundaries_of_toClass_eq p k Ω K M (SSGRoute.decomp k A) (hα'lc A hA) (hαlc A hA)
        (htoA A hA)
    have h3 : (fun σ => ε σ - α A σ) =
        (fun σ => ε σ - α' A σ) + (fun σ => α' A σ - α A σ) := by
      ext σ; simp only [Pi.add_apply, Pi.sub_apply]; abel
    rw [h3]
    exact (mem_coboundaries p k Ω K M (SSGRoute.decomp k A) _).mp (add_mem h1 h2)
  · intro c hc
    have h1 : (fun σ => ε σ - β' c σ) ∈ coboundaries p k Ω K M (Subgroup.zpowers c) :=
      (mem_coboundaries p k Ω K M (Subgroup.zpowers c) _).mpr (hεβ' c hc)
    have h2 : (fun σ => β' c σ - β c σ) ∈ coboundaries p k Ω K M (Subgroup.zpowers c) :=
      sub_mem_coboundaries_of_toClass_eq p k Ω K M (Subgroup.zpowers c) (hβ'lc c hc) (hβlc c hc)
        (htoC c hc)
    have h3 : (fun σ => ε σ - β c σ) =
        (fun σ => ε σ - β' c σ) + (fun σ => β' c σ - β c σ) := by
      ext σ; simp only [Pi.add_apply, Pi.sub_apply]; abel
    rw [h3]
    exact (mem_coboundaries p k Ω K M (Subgroup.zpowers c) _).mp (add_mem h1 h2)


end Main

