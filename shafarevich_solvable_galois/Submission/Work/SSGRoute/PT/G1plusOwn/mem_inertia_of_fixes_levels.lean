/-! ## An auxiliary fact about the field generated by one element

A `k`-algebra automorphism that fixes `ζ` fixes the whole field `k⟮ζ⟯`: this is the easy half of
`Work.SSGRoute.fixingSubgroup_adjoin_singleton`, reproved here so that this module need not import
the (heavier) cyclotomic-character development it lives in. -/
private lemma mem_fixingSubgroup_adjoin_singleton_of_fixes
    {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω] {ζ : Ω} {σ : Ω ≃ₐ[k] Ω}
    (h : σ ζ = ζ) :
    σ ∈ (IntermediateField.adjoin k ({ζ} : Set Ω)).fixingSubgroup := by
  have hle : IntermediateField.adjoin k ({ζ} : Set Ω) ≤
      IntermediateField.fixedField (MulAction.stabilizer (Ω ≃ₐ[k] Ω) ζ) := by
    rw [IntermediateField.adjoin_le_iff, Set.singleton_subset_iff]
    refine (IntermediateField.mem_fixedField_iff _ ζ).mpr ?_
    intro f hf
    have h2 : f • ζ = ζ := (MulAction.mem_stabilizer_iff).mp hf
    rwa [AlgEquiv.smul_def] at h2
  exact ((IntermediateField.le_iff_le (MulAction.stabilizer (Ω ≃ₐ[k] Ω) ζ)
    (IntermediateField.adjoin k ({ζ} : Set Ω))).mp hle)
    (by rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]; exact h)

/-- **Fixing all finite Galois levels unramified at `A` above `K` forces inertia.**

`k` a number field, `Ω` an algebraic closure, `K ≤ Ω` finite Galois unramified at the finite place
`A` (`hramA`), and `δ ∈ D_A = decomp k A`.  If `δ` fixes pointwise every finite Galois level
`M ⊇ K` that is unramified at `A` (`I_A ≤ M.fixingSubgroup`), then `δ ∈ I_A`.

Route (all inputs on disk): by `Work.SSGRoute.isInertia_of_fixes_rootsOfUnity_gen` (residue
characteristic `p := NK.TameStructureDeep.Tame.resCharAt (Submission.NeukirchUchida.primeOf A hA)`,
`CharP` from `Work.SSGRoute.charP_residueField_isFinPlace`) it suffices that `δ` fixes every
primitive `n`-th root of unity `ζ` with `¬ p ∣ n`.  For such `ζ`, the compositum
`M := K ⊔ k⟮ζ⟯` is a finite Galois level over `k`
(`Work.SSGRoute.E7cC.isCyclotomicExtension_adjoin_primitiveRoot`,
`IsCyclotomicExtension.finiteDimensional`, `IsCyclotomicExtension.isGalois`, sup of two Galois
levels), with `K ≤ M` and `I_A ≤ M.fixingSubgroup`: `I_A` fixes `K` by `hramA` and fixes `ζ` by
`Work.SSGRoute.fixes_rootsOfUnity_of_isInertia` (units hypothesis from
`Work.SSGRoute.isUnit_natCast_iff_not_dvd_resCharAt`).  Apply `hfix` at `M` and use
`ζ ∈ k⟮ζ⟯ ≤ M`. -/
theorem mem_inertia_of_fixes_levels
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
    (δ : Ω ≃ₐ[k] Ω) (hδD : δ ∈ SSGRoute.decomp k A)
    (hfix : ∀ (M : IntermediateField k Ω) [FiniteDimensional k M] [Normal k M],
      K ≤ M → Work.SSGRoute.inertiaSub k Ω A ≤ M.fixingSubgroup → δ ∈ M.fixingSubgroup) :
    δ ∈ Work.SSGRoute.inertiaSub k Ω A := by
  -- `Ω` is a separable closure of the number field `k`.
  haveI : IsSepClosure k Ω := IsSepClosure.of_isAlgClosure_of_perfectField k Ω
  -- It suffices that `δ` fixes every primitive `n`-th root of unity with `p ∤ n`, where `p` is the
  -- residue characteristic of `A`.
  refine (Work.SSGRoute.mem_inertiaSub k Ω A δ).mpr ?_
  refine Work.SSGRoute.isInertia_of_fixes_rootsOfUnity_gen k Ω A hA
    (NK.TameStructureDeep.Tame.resCharAt (Submission.NeukirchUchida.primeOf A hA))
    (Work.SSGRoute.charP_residueField_isFinPlace k Ω A hA) δ hδD ?_
  intro n hn ζ hζ
  -- a primitive `n`-th root of unity with `p ∤ n` has `n ≠ 0`
  have hn0 : n ≠ 0 := fun h0 => hn (by rw [h0]; exact dvd_zero _)
  haveI : NeZero n := ⟨hn0⟩
  -- `L = k⟮ζ⟯` is a finite Galois level over `k`
  haveI hcyc : IsCyclotomicExtension ({n} : Set ℕ) k
      ↥(IntermediateField.adjoin k ({ζ} : Set Ω)) :=
    Work.SSGRoute.E7cC.isCyclotomicExtension_adjoin_primitiveRoot (K := k) hζ
  haveI hfdL : FiniteDimensional k (IntermediateField.adjoin k ({ζ} : Set Ω)) :=
    IsCyclotomicExtension.finiteDimensional {n} k
      ↥(IntermediateField.adjoin k ({ζ} : Set Ω))
  haveI hgalL : IsGalois k (IntermediateField.adjoin k ({ζ} : Set Ω)) :=
    IsCyclotomicExtension.isGalois {n} k ↥(IntermediateField.adjoin k ({ζ} : Set Ω))
  -- the compositum `M = K ⊔ k⟮ζ⟯` is likewise a finite Galois level over `k`
  haveI hfdM : FiniteDimensional k ↥(K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)) :=
    IntermediateField.finiteDimensional_sup K _
  haveI hgalM : IsGalois k ↥(K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)) := inferInstance
  haveI hnormM : Normal k ↥(K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)) := inferInstance
  -- `I_A` is contained in the pointwise fixer of `M`
  have hIle : Work.SSGRoute.inertiaSub k Ω A ≤
      (K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)).fixingSubgroup := by
    rw [IntermediateField.fixingSubgroup_sup]
    intro σ hσ
    rw [Subgroup.mem_inf]
    have hσI : SSGRoute.IsInertia k A σ := (Work.SSGRoute.mem_inertiaSub k Ω A σ).mp hσ
    refine ⟨?_, ?_⟩
    · -- `I_A` fixes the unramified level `K`
      by_contra hnot
      exact hramA ⟨σ, hσI, hnot⟩
    · -- `I_A` fixes `ζ`, hence `k⟮ζ⟯`
      have hζfix : σ ζ = ζ := by
        have h1 := Work.SSGRoute.fixes_rootsOfUnity_of_isInertia (K := k) (Ω := Ω)
          (A := ⟨A, hA⟩)
          (fun m hm => Work.SSGRoute.isUnit_natCast_of_not_dvd_resCharAt k Ω A hA m hm)
          (⟨σ, (Work.SSGRoute.inertiaSub_le_decomp k Ω A) hσ⟩) hσI n hn ζ hζ
        simpa using h1
      exact mem_fixingSubgroup_adjoin_singleton_of_fixes hζfix
  -- apply the hypothesis at `M`
  have hδM : δ ∈ (K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)).fixingSubgroup :=
    hfix (K ⊔ IntermediateField.adjoin k ({ζ} : Set Ω)) le_sup_left hIle
  have hδL : δ ∈ (IntermediateField.adjoin k ({ζ} : Set Ω)).fixingSubgroup :=
    IntermediateField.fixingSubgroup_le le_sup_right hδM
  exact (IntermediateField.mem_fixingSubgroup_iff _ δ).mp hδL ζ
    (IntermediateField.subset_adjoin k ({ζ} : Set Ω) (by simp))

end Work.SSGRoute.PT.G1plusOwn
