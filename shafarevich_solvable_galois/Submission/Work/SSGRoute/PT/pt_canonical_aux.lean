/-!
# Auxiliary lemmas for `Work.SSGRoute.PT.pt_canonical_relaxed`

This file isolates the *formal* half of the counting argument that converts orthogonality
against the relaxed dual Selmer group into realizability (the step
"`V ⊆ W^⊥`" of `Work.SSGRoute.pt_selmer_relaxed`): it is the half that only uses

* the local clauses of the pairing axioms (`haddL`, `hvanish`: additivity in the first variable
  on locally constant cocycles and vanishing when the second argument is a coboundary), and
* the reciprocity clause (`hrec`).

Given a global locally constant cocycle `ε` of `M` matching local data `α` at `S` and `β` at `C`,
and a global locally constant cocycle `b` of `M' = DualMod p (M ⊗ T)` subject to the relaxed dual
Selmer conditions, the sum `∑_S pair (α A) b + ∑_C pair (β c) b` vanishes
(`pt_orthogonality_of_realizable`), provided one supplies a finite set `S' ⊇ S` of one place per
prime, containing the finitely many places at which `ε` is ramified, such that `b` is a coboundary
on `D_A` for `A ∈ S' ∖ S` (true when `S' ∖ S ⊆ cs(N)`, since `D_A ≤ G_K` acts trivially on `M'`
there and a coboundary for a trivial action is zero).

The existence of `S'` from the local constancy of `ε` (finiteness of the ramification of a global
class) is not formalised here; it is the only non-formal input of this file, and it is exactly the
place where `Work.SSGRoute.ramifiedPlaces_finite` and its `↥K`-analogues are used.
-/

open scoped TensorProduct Pointwise
open Classical

namespace Work.SSGRoute.PT

section LocalGroupDefs

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
  (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
  (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]

/-- The local groups at which the local axioms of `pt_canonical_relaxed` are asserted:
decomposition groups of finite places, and subgroups generated by an involution. -/
def IsLocalGroup (H : Subgroup (Ω ≃ₐ[k] Ω)) : Prop :=
  (∃ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A ∧ H = SSGRoute.decomp k A) ∨
    (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)

/-- The local axioms (clauses (1)) of `pt_canonical_relaxed`, at a fixed local group `H`. -/
def LocalAxioms (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
    ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (H : Subgroup (Ω ≃ₐ[k] Ω)) : Prop :=
  (∀ (a a' : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    pair H (a + a') b = pair H a b + pair H a' b) ∧
  (∀ (a : (Ω ≃ₐ[k] Ω) → M)
      (b b' : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b' ∧ SSGRoute.IsLocConstOn H b') →
    pair H a (b + b') = pair H a b + pair H a b') ∧
  (∀ (a : (Ω ≃ₐ[k] Ω) → M)
      (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a ∨
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b) →
    pair H a b = 0) ∧
  (∀ a : (Ω ≃ₐ[k] Ω) → M,
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
    (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
      pair H a b = 0) →
    SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a) ∧
  (∀ b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T),
    (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
    (∀ a : (Ω ≃ₐ[k] Ω) → M,
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
      pair H a b = 0) →
    SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b)

end LocalGroupDefs


/-! ## Local constancy on `⟨c⟩` for an involution `c` -/

/-- On the procyclic subgroup generated by an involution, **every** cochain is locally constant:
there is an open subgroup meeting `⟨c⟩` trivially. -/
theorem isLocConstOn_zpowers {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    {M : Type} (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (f : (Ω ≃ₐ[k] Ω) → M) :
    SSGRoute.IsLocConstOn (Subgroup.zpowers c) f := by
  by_cases hc1 : c = 1
  · subst hc1
    refine ⟨⊤, isOpen_univ, fun g _ u _ huH => ?_⟩
    rcases Ach.mem_zpowers_eq_one_or (1 : Ω ≃ₐ[k] Ω) (by simp) huH with h | h <;>
      rw [h, mul_one]
  · obtain ⟨U, hU, hUdisj⟩ := ArchAux.exists_isOpen_subgroup_not_mem c hc hc1
    exact ⟨U, hU, fun g _ u hu huH => by rw [hUdisj u hu huH, mul_one]⟩

/-! ## Monotonicity in the subgroup -/

theorem isCocycleOn_mono {Γ G M : Type} [Group Γ] [Group G] [AddCommGroup M]
    [DistribMulAction G M] (act : Γ →* G) {H H' : Subgroup Γ} (h : H ≤ H') {f : Γ → M}
    (hf : SSGRoute.IsCocycleOn act H' f) : SSGRoute.IsCocycleOn act H f :=
  fun g hg h' hh' => hf g (h hg) h' (h hh')

theorem isLocConstOn_mono {Γ M : Type} [Group Γ] [TopologicalSpace Γ] {H H' : Subgroup Γ}
    (h : H ≤ H') {f : Γ → M} (hf : SSGRoute.IsLocConstOn H' f) :
    SSGRoute.IsLocConstOn H f := by
  obtain ⟨U, hU, hUc⟩ := hf
  exact ⟨U, hU, fun g hg u hu huH => hUc g (h hg) u hu (h huH)⟩

/-! ## The pairing vanishes on the zero cochain -/

theorem pair_zero_left {Γ G M N : Type} [Group Γ] [TopologicalSpace Γ] [Group G]
    [AddCommGroup M] [AddCommGroup N] [DistribMulAction G M] [DistribMulAction G N]
    (p : ℕ) (act : Γ →* G) (pair : Subgroup Γ → (Γ → M) → (Γ → N) → ZMod p)
    (haddL : ∀ (H : Subgroup Γ) (a a' : Γ → M) (b : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H a' ∧ SSGRoute.IsLocConstOn H a') →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      pair H (a + a') b = pair H a b + pair H a' b)
    (H : Subgroup Γ) (b : Γ → N)
    (hb : SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) :
    pair H 0 b = 0 := by
  have h0 : SSGRoute.IsCocycleOn act H (0 : Γ → M) ∧ SSGRoute.IsLocConstOn H (0 : Γ → M) :=
    ⟨fun g _ h _ => by simp, ⟨⊤, isOpen_univ, fun g _ u _ _ => rfl⟩⟩
  have h := haddL H 0 0 b h0 h0 hb
  have h2 : pair H 0 b = pair H 0 b + pair H 0 b := by
    simpa only [Pi.zero_apply, add_zero] using h
  have h3 : pair H 0 b + pair H 0 b = pair H 0 b + 0 := by
    rw [add_zero]; exact h2.symm
  exact add_left_cancel h3

/-! ## The pairing on `H¹`: independence of the representative -/

/-- If two locally constant cocycles on `H` differ by a coboundary, the pairing with a fixed
argument is the same: the pairing factors through `H¹(H, M)`. -/
theorem pair_congr_left {Γ G M N : Type} [Group Γ] [TopologicalSpace Γ] [Group G]
    [AddCommGroup M] [AddCommGroup N] [DistribMulAction G M] [DistribMulAction G N]
    (p : ℕ) (act : Γ →* G) (pair : Subgroup Γ → (Γ → M) → (Γ → N) → ZMod p)
    (haddL : ∀ (H : Subgroup Γ) (a a' : Γ → M) (b : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H a' ∧ SSGRoute.IsLocConstOn H a') →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      pair H (a + a') b = pair H a b + pair H a' b)
    (hvanish : ∀ (H : Subgroup Γ) (a : Γ → M) (b : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      SSGRoute.IsCoboundaryOn act H a → pair H a b = 0)
    (H : Subgroup Γ) {a a' : Γ → M} (b : Γ → N)
    (ha : SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a)
    (ha' : SSGRoute.IsCocycleOn act H a' ∧ SSGRoute.IsLocConstOn H a')
    (hb : SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b)
    (hsub : SSGRoute.IsCoboundaryOn act H (fun σ => a σ - a' σ))
    (hsubc : SSGRoute.IsCocycleOn act H (fun σ => a σ - a' σ) ∧
      SSGRoute.IsLocConstOn H (fun σ => a σ - a' σ)) :
    pair H a b = pair H a' b := by
  have hsplit : a = a' + (fun σ => a σ - a' σ) := by
    ext σ; simp only [Pi.add_apply]; abel
  rw [hsplit, haddL H a' (fun σ => a σ - a' σ) b ha' hsubc hb,
    hvanish H (fun σ => a σ - a' σ) b hsubc hb hsub, add_zero]

/-! ## The pairing vanishes on the zero cochain, second variable -/

theorem pair_zero_right {Γ G M N : Type} [Group Γ] [TopologicalSpace Γ] [Group G]
    [AddCommGroup M] [AddCommGroup N] [DistribMulAction G M] [DistribMulAction G N]
    (p : ℕ) (act : Γ →* G) (pair : Subgroup Γ → (Γ → M) → (Γ → N) → ZMod p)
    (haddR : ∀ (H : Subgroup Γ) (a : Γ → M) (b b' : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      (SSGRoute.IsCocycleOn act H b' ∧ SSGRoute.IsLocConstOn H b') →
      pair H a (b + b') = pair H a b + pair H a b')
    (H : Subgroup Γ) (a : Γ → M)
    (ha : SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) :
    pair H a 0 = 0 := by
  have h0 : SSGRoute.IsCocycleOn act H (0 : Γ → N) ∧ SSGRoute.IsLocConstOn H (0 : Γ → N) :=
    ⟨fun g _ h _ => by simp, ⟨⊤, isOpen_univ, fun g _ u _ _ => rfl⟩⟩
  have h := haddR H a 0 0 ha h0 h0
  have h2 : pair H a 0 = pair H a 0 + pair H a 0 := by
    simpa only [Pi.zero_apply, add_zero] using h
  have h3 : pair H a 0 + pair H a 0 = pair H a 0 + 0 := by
    rw [add_zero]; exact h2.symm
  exact add_left_cancel h3

/-- Independence of the representative in the **second** variable: the pairing factors through
`H¹(H, M')` as well. -/
theorem pair_congr_right {Γ G M N : Type} [Group Γ] [TopologicalSpace Γ] [Group G]
    [AddCommGroup M] [AddCommGroup N] [DistribMulAction G M] [DistribMulAction G N]
    (p : ℕ) (act : Γ →* G) (pair : Subgroup Γ → (Γ → M) → (Γ → N) → ZMod p)
    (haddR : ∀ (H : Subgroup Γ) (a : Γ → M) (b b' : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      (SSGRoute.IsCocycleOn act H b' ∧ SSGRoute.IsLocConstOn H b') →
      pair H a (b + b') = pair H a b + pair H a b')
    (hvanishR : ∀ (H : Subgroup Γ) (a : Γ → M) (b : Γ → N),
      (SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b) →
      SSGRoute.IsCoboundaryOn act H b → pair H a b = 0)
    (H : Subgroup Γ) (a : Γ → M) {b b' : Γ → N}
    (ha : SSGRoute.IsCocycleOn act H a ∧ SSGRoute.IsLocConstOn H a)
    (hb : SSGRoute.IsCocycleOn act H b ∧ SSGRoute.IsLocConstOn H b)
    (hb' : SSGRoute.IsCocycleOn act H b' ∧ SSGRoute.IsLocConstOn H b')
    (hsub : SSGRoute.IsCoboundaryOn act H (fun σ => b σ - b' σ))
    (hsubc : SSGRoute.IsCocycleOn act H (fun σ => b σ - b' σ) ∧
      SSGRoute.IsLocConstOn H (fun σ => b σ - b' σ)) :
    pair H a b = pair H a b' := by
  have hsplit : b = b' + (fun σ => b σ - b' σ) := by
    ext σ; simp only [Pi.add_apply]; abel
  rw [hsplit, haddR H a b' (fun σ => b σ - b' σ) ha hb' hsubc,
    hvanishR H a (fun σ => b σ - b' σ) ha hsubc hsub, add_zero]

/-! ## The easy inclusion `V ⊆ W^⊥` -/

/-- **Reciprocity implies orthogonality** — the inclusion `V ⊆ W^⊥` of the Poitou–Tate counting
argument in `Work.SSGRoute.PT.pt_canonical_relaxed` and `Work.SSGRoute.pt_selmer_relaxed`.

If `ε` is a global locally constant cocycle of `M` matching the local data `α` at `S`
(coboundary differences on the decomposition groups) and `β` at the involutions `c ∈ C`, and if
`b` is a global locally constant cocycle of `M'` subject to the relaxed dual Selmer conditions,
then the sum of local Tate pairings of `(α, β)` against `b` over `S ∪ C` vanishes.

The only non-formal input is the finite reciprocal set `S' ⊇ S` of `hrec`: it must contain the
finitely many places where the global class of `ε` ramifies (its existence is the local constancy
of `ε` plus the finiteness of ramification), and at the extra places `S' ∖ S` the cocycle `b`
must be a coboundary (automatic when those places split in `N`, since `D_A ≤ G_K` acts trivially
on `M'` there). -/
theorem pt_orthogonality_of_realizable
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
        ((Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) → ZMod p)
    (hloc : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroup k Ω H →
      LocalAxioms (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M) pair H)
    (hrec : ∀ (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
      ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
      (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
        ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
          ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
      ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
      (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
      ∑ A ∈ S', pair (SSGRoute.decomp k A) a b +
        ∑ c ∈ C', pair (Subgroup.zpowers c) a b = 0)
    (S : Finset (ValuationSubring Ω)) (hSfin : ∀ A ∈ S, SSGRoute.IsFinPlace k A)
    (C : Finset (Ω ≃ₐ[k] Ω))
    (α : ValuationSubring Ω → (Ω ≃ₐ[k] Ω) → M) (β : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M)
    (ε : (Ω ≃ₐ[k] Ω) → M)
    (hε : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ ε ∧ SSGRoute.IsLocConstOn ⊤ ε)
    (hα : ∀ A ∈ S, SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) (α A) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) (α A))
    (hεα : ∀ A ∈ S, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A)
      (fun σ => ε σ - α A σ))
    (hεαc : ∀ A ∈ S, SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A)
        (fun σ => ε σ - α A σ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) (fun σ => ε σ - α A σ))
    (hβ : ∀ c ∈ C, SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) (β c))
    (hεβ : ∀ c ∈ C, SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
      (fun σ => ε σ - β c σ))
    (hεβc : ∀ c ∈ C, SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c)
        (fun σ => ε σ - β c σ) ∧
      SSGRoute.IsLocConstOn (Subgroup.zpowers c) (fun σ => ε σ - β c σ))
    (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T))
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b ∧ SSGRoute.IsLocConstOn ⊤ b)
    (S' : Finset (ValuationSubring Ω)) (hS'sub : ∀ A ∈ S, A ∈ S')
    (hS'fin : ∀ A ∈ S', SSGRoute.IsFinPlace k A)
    (hS'disj : ∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B)
    (hS'good : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
      ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
        ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → ε σ = 0 ∧ b σ = 0)
    (hS'cob : ∀ A ∈ S', (∀ A₀ ∈ S, ¬ SSGRoute.IsConjPlace k A₀ A) →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) b)
    (hCinv : ∀ c ∈ C, c ^ 2 = 1)
    (hC : ∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C, ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹)
    (hCdisj : ∀ c ∈ C, ∀ c' ∈ C, (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') :
    ∑ A ∈ S, pair (SSGRoute.decomp k A) (α A) b +
      ∑ c ∈ C, pair (Subgroup.zpowers c) (β c) b = 0 := by
  obtain ⟨hε1, hε2⟩ := hε
  obtain ⟨hb1, hb2⟩ := hb
  have haddL : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)), IsLocalGroup k Ω H →
      ∀ (a a' : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a' ∧ SSGRoute.IsLocConstOn H a') →
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
      pair H (a + a') b = pair H a b + pair H a' b := fun H hH => (hloc H hH).1
  have hvanishL : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)), IsLocalGroup k Ω H →
      ∀ (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H a → pair H a b = 0 :=
    fun H hH a b ha hb hc => (hloc H hH).2.2.1 a b ha hb (Or.inl hc)
  have hvanishR : ∀ (H : Subgroup (Ω ≃ₐ[k] Ω)), IsLocalGroup k Ω H →
      ∀ (a : (Ω ≃ₐ[k] Ω) → M)
        (b : (Ω ≃ₐ[k] Ω) → Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)),
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a) →
      (SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b) →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) H b → pair H a b = 0 :=
    fun H hH a b ha hb hc => (hloc H hH).2.2.1 a b ha hb (Or.inr hc)
  have hbH : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b :=
    fun H => ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hb1, isLocConstOn_mono le_top hb2⟩
  have hεH : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) H ε ∧ SSGRoute.IsLocConstOn H ε :=
    fun H => ⟨isCocycleOn_mono (SSGRoute.res k K) le_top hε1, isLocConstOn_mono le_top hε2⟩
  have hrec' := hrec ε b hε1 hε2 hb1 hb2 S' hS'fin hS'disj hS'good C hCinv hC hCdisj
  have hsplit : ∑ A ∈ S', pair (SSGRoute.decomp k A) ε b =
      ∑ A ∈ S, pair (SSGRoute.decomp k A) ε b :=
    (Finset.sum_subset hS'sub (fun A hA' hA =>
      hvanishR (SSGRoute.decomp k A) (Or.inl ⟨A, hS'fin A hA', rfl⟩) ε b
        (hεH (SSGRoute.decomp k A)) (hbH (SSGRoute.decomp k A))
        (hS'cob A hA' (fun A₀ hA₀ hconj =>
          hA ((hS'disj A₀ (hS'sub A₀ hA₀) A hA' hconj) ▸ hA₀))))).symm
  rw [hsplit] at hrec'
  have hαswap : ∀ A ∈ S, pair (SSGRoute.decomp k A) (α A) b =
      pair (SSGRoute.decomp k A) ε b := by
    intro A hA
    have hsplitε : ε = α A + (fun σ => ε σ - α A σ) := by
      ext σ; simp only [Pi.add_apply]; abel
    have key : pair (SSGRoute.decomp k A) ε b = pair (SSGRoute.decomp k A) (α A) b := by
      rw [hsplitε, haddL (SSGRoute.decomp k A) (Or.inl ⟨A, hSfin A hA, rfl⟩) (α A)
          (fun σ => ε σ - α A σ) b (hα A hA)
        (hεαc A hA) (hbH _), hvanishL (SSGRoute.decomp k A) (Or.inl ⟨A, hSfin A hA, rfl⟩)
          (fun σ => ε σ - α A σ) b (hεαc A hA) (hbH _) (hεα A hA), add_zero]
    exact key.symm
  have hβswap : ∀ c ∈ C, pair (Subgroup.zpowers c) (β c) b =
      pair (Subgroup.zpowers c) ε b := by
    intro c hc
    have hsplitε : ε = β c + (fun σ => ε σ - β c σ) := by
      ext σ; simp only [Pi.add_apply]; abel
    have hβc : SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) (β c) ∧
        SSGRoute.IsLocConstOn (Subgroup.zpowers c) (β c) :=
      ⟨hβ c hc, isLocConstOn_zpowers c (hCinv c hc) (β c)⟩
    have key : pair (Subgroup.zpowers c) ε b = pair (Subgroup.zpowers c) (β c) b := by
      rw [hsplitε, haddL (Subgroup.zpowers c) (Or.inr ⟨c, hCinv c hc, rfl⟩) (β c)
          (fun σ => ε σ - β c σ) b hβc
        (hεβc c hc) (hbH _), hvanishL (Subgroup.zpowers c) (Or.inr ⟨c, hCinv c hc, rfl⟩)
          (fun σ => ε σ - β c σ) b (hεβc c hc) (hbH _) (hεβ c hc), add_zero]
    exact key.symm
  have hαsum : ∑ A ∈ S, pair (SSGRoute.decomp k A) (α A) b =
      ∑ A ∈ S, pair (SSGRoute.decomp k A) ε b :=
    Finset.sum_congr rfl (fun A hA => hαswap A hA)
  have hβsum : ∑ c ∈ C, pair (Subgroup.zpowers c) (β c) b =
      ∑ c ∈ C, pair (Subgroup.zpowers c) ε b :=
    Finset.sum_congr rfl (fun c hc => hβswap c hc)
  rw [hαsum, hβsum]
  exact hrec'

end Work.SSGRoute.PT
