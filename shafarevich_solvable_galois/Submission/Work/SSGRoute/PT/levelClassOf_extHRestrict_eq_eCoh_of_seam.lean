/-- In a group, every element of the cyclic subgroup generated by an involution is the identity or
the involution itself.  (Local helper; the same fact appears as
`Work.SSGRoute.ZSplit.zpowers_eq_one_or_of_sq_eq_one` elsewhere in the workspace, restated here so
that this file needs no additional import.) -/
lemma zpowers_eq_one_or_of_sq_eq_one_seam {Γ : Type*} [Group Γ] {c g : Γ} (hc : c ^ 2 = 1)
    (hg : g ∈ Subgroup.zpowers c) : g = 1 ∨ g = c := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hg
  rcases Int.even_or_odd n with ⟨k, hk⟩ | ⟨k, hk⟩
  · left
    rw [← hn]
    have h2 : n = 2 * k := by omega
    rw [h2, zpow_mul, show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, hc, one_zpow]
  · right
    rw [← hn]
    have h2 : n = 2 * k + 1 := by omega
    rw [h2, zpow_add, zpow_mul, show (2 : ℤ) = ((2 : ℕ) : ℤ) from rfl, zpow_natCast, hc,
      one_zpow, zpow_one, one_mul]

/-- **The restriction of the level-`L` class to a seam decomposition group.**  This is the brick D1
of the archimedean value formula: for a tower `k ⊆ K ⊆ L` of number fields with `K/k` and `L/k`
finite Galois inside `Ω`, an involution `c ≠ 1` of `Ω/k` and the seam place `u = mk (φ|_L)` of `L`
(`hus`), the restriction to the decomposition group `D_u` of the level-`L` class `levelClassOf ψ`
of a `1`-cocycle `ψ` is the `eCoh`-class of any cocycle `z` on `D_u` whose underlying function is
`ψ` restricted to `D_u`.

Route.  `extHRestrict D = extHMap D.subtype 𝟙` and group-naturality of the derivation bridge
(`Work.SSGRoute.extHMap_gammaHom_eq`) turn the left-hand side into
`gammaHom D X (H¹π ⟨ψ ∘ D.subtype, ·⟩)`.  By `hus` the place `u` is the seam place, so
`D_u = ⟨res_L c⟩` by `PT.decompK_linked`: `D_u` is generated by an involution, whence every
`Ext¹_{D_u}` is `2`-torsion and `PT.eCoh_eq_gammaHom_of_zpowers` identifies the `eCoh`-realisation
— the class of `z` — with the `gammaHom`-realisation of the same cocycle `φ' = ψ ∘ D.subtype`,
which is `z` by the hypothesis `hz`.  No property of `hu` is used. -/
theorem levelClassOf_extHRestrict_eq_eCoh_of_seam
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [NumberField ↥K]
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1) (φ : Ω →+* ℂ)
    (hφ : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x))
    (L : IntermediateField k Ω) [NumberField ↥L] [FiniteDimensional k ↥L] [IsGalois k ↥L]
    (hKL : K ≤ L) [Algebra ↥K ↥L] [IsScalarTower k ↥K ↥L] [IsScalarTower ↥K ↥L Ω]
    (u : NK.GlobalCFT.Place ↥L) (hu : NK.GlobalCFT.Place.LiesOver u (Work.SSGRoute.PT.archW k Ω K φ))
    (hus : u = NK.GlobalCFT.Place.ofInfinite
      (NumberField.InfinitePlace.mk (φ.comp (algebraMap (↥L) Ω))))
    (ψ : (↥L ≃ₐ[k] ↥L) → Work.SSGRoute.PT.VFcoef p M T)
    (hψ : ∀ g h : ↥L ≃ₐ[k] ↥L,
      ψ (g * h) = SSGRoute.PTExt.galRes k (↥K) (↥L) g • ψ h + ψ g)
    (z : ↥(groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (Work.SSGRoute.PT.archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (Work.SSGRoute.PT.archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (Work.SSGRoute.PT.VFcoef p M T))))))
    (hz : ∀ g : ↥(SSGRoute.PTExt.decompK (k := k) u),
      (z : ↥(SSGRoute.PTExt.decompK (k := k) u) → Work.SSGRoute.PT.VFcoef p M T) g = ψ (g : ↥L ≃ₐ[k] ↥L)) :
    SSGRoute.PTExt.extHRestrict (SSGRoute.PTExt.decompK (k := k) u)
        (Work.SSGRoute.PT.levelClassOf p k Ω K T M L ψ hψ)
      = SSGRoute.PTExt.eCoh 1 ↥(SSGRoute.PTExt.decompK (k := k) u)
        (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (Work.SSGRoute.PT.archW k Ω K φ) u hu)
          (Rep.res (SSGRoute.PTExt.decompK (k := k) (Work.SSGRoute.PT.archW k Ω K φ)).subtype
            (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (Work.SSGRoute.PT.VFcoef p M T))))
        ((groupCohomology.H1π _).hom z) := by
  -- the action through which `levelClassOf` is defined, and the same action on `D_u`
  letI hActL : DistribMulAction (↥L ≃ₐ[k] ↥L) (VFcoef p M T) :=
    DistribMulAction.compHom (VFcoef p M T) (SSGRoute.PTExt.galRes k (↥K) (↥L))
  letI hCommZL : SMulCommClass (↥L ≃ₐ[k] ↥L) ℤ (VFcoef p M T) :=
    ⟨fun g n m =>
      map_zsmul (AddMonoidHom.mk' (fun m => g • m) (fun a b => smul_add g a b)) n m⟩
  letI hCommCL : SMulCommClass (↥L ≃ₐ[k] ↥L) SSGRoute.PTExt.Coeff (VFcoef p M T) :=
    ⟨fun g c m => smul_comm g c.down m⟩
  letI hActD : DistribMulAction ↥(SSGRoute.PTExt.decompK (k := k) u) (VFcoef p M T) :=
    DistribMulAction.compHom (VFcoef p M T) (SSGRoute.PTExt.decompK (k := k) u).subtype
  letI hCommZD : SMulCommClass ↥(SSGRoute.PTExt.decompK (k := k) u) ℤ (VFcoef p M T) :=
    ⟨fun g n m =>
      map_zsmul (AddMonoidHom.mk' (fun m => g • m) (fun a b => smul_add g a b)) n m⟩
  letI hCommCD : SMulCommClass ↥(SSGRoute.PTExt.decompK (k := k) u)
      SSGRoute.PTExt.Coeff (VFcoef p M T) :=
    ⟨fun g c m => smul_comm g c.down m⟩
  -- `u` is the seam place of `L`, so `D_u = ⟨res_L c⟩`
  have hDu : SSGRoute.PTExt.decompK (k := k) u
      = (Subgroup.zpowers c).map (SSGRoute.res k L) := by
    rw [hus]
    exact decompK_linked k Ω L c hc2 hc1 φ hφ
  have hc2' : c * c = 1 := by simpa [pow_two] using hc2
  have hcmem : SSGRoute.res k L c ∈ SSGRoute.PTExt.decompK (k := k) u := by
    rw [hDu]
    exact Subgroup.mem_map_of_mem _ (Subgroup.mem_zpowers c)
  -- the cocycle function of `z` is `ψ ∘ D_u.subtype`
  let φ' : ↥(SSGRoute.PTExt.decompK (k := k) u) → VFcoef p M T :=
    fun g => ψ (g : ↥L ≃ₐ[k] ↥L)
  have hφ'cross : ∀ g h : ↥(SSGRoute.PTExt.decompK (k := k) u),
      φ' (g * h) = g • φ' h + φ' g := by
    intro g h
    dsimp only [φ']
    rw [show ((g * h : ↥(SSGRoute.PTExt.decompK (k := k) u)) : ↥L ≃ₐ[k] ↥L)
        = (g : ↥L ≃ₐ[k] ↥L) * (h : ↥L ≃ₐ[k] ↥L) from rfl, hψ]
    rfl
  have hφ'mem : φ' ∈ groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (Work.SSGRoute.PT.archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (Work.SSGRoute.PT.archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))) := by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    rw [hφ'cross g h]
    congr 1
  have hzφ : z = (⟨φ', hφ'mem⟩ : ↥(groupCohomology.cocycles₁
      (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (Work.SSGRoute.PT.archW k Ω K φ) u hu)
        (Rep.res (SSGRoute.PTExt.decompK (k := k) (Work.SSGRoute.PT.archW k Ω K φ)).subtype
          (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T)))))) := by
    apply groupCohomology.cocycles₁_ext
    intro g
    exact hz g
  -- the group `D_u` is generated by the involution `⟨res_L c⟩`
  have hgen : ∀ g : ↥(SSGRoute.PTExt.decompK (k := k) u),
      g = 1 ∨ g = ⟨SSGRoute.res k L c, hcmem⟩ := by
    intro g
    have hmem : (g : ↥L ≃ₐ[k] ↥L) ∈ (Subgroup.zpowers c).map (SSGRoute.res k L) := by
      rw [← hDu]
      exact g.2
    obtain ⟨σ, hσ, hσeq⟩ := Subgroup.mem_map.mp hmem
    rcases zpowers_eq_one_or_of_sq_eq_one_seam hc2 hσ with h | h
    · left
      exact Subtype.ext (by rw [← hσeq, h, map_one]; rfl)
    · right
      exact Subtype.ext (by rw [← hσeq, h])
  have hcmm : (⟨SSGRoute.res k L c, hcmem⟩ : ↥(SSGRoute.PTExt.decompK (k := k) u))
      * ⟨SSGRoute.res k L c, hcmem⟩ = 1 := by
    apply Subtype.ext
    show SSGRoute.res k L c * SSGRoute.res k L c = 1
    rw [← map_mul, hc2', map_one]
  -- unfold `extHRestrict` and `levelClassOf` into the two bridges
  show SSGRoute.PTExt.extHMap (SSGRoute.PTExt.decompK (k := k) u).subtype
      (CategoryTheory.CategoryStruct.id
        (Rep.res (SSGRoute.PTExt.decompK (k := k) u).subtype
          (SSGRoute.PTExt.modRep (↥L ≃ₐ[k] ↥L) (VFcoef p M T))))
      (Work.SSGRoute.ExtH1.gammaHom (↥L ≃ₐ[k] ↥L) (VFcoef p M T)
        (Work.SSGRoute.augSES_shortExact (↥L ≃ₐ[k] ↥L))
        (Work.GroupCohomology.H1π (↥L ≃ₐ[k] ↥L) (VFcoef p M T)
          ⟨ψ, fun g h => hψ g h⟩))
    = SSGRoute.PTExt.eCoh 1 ↥(SSGRoute.PTExt.decompK (k := k) u)
        (Rep.res (Work.SSGRoute.decompKRestrict k ↥K ↥L (archW k Ω K φ) u hu)
          (Rep.res (SSGRoute.PTExt.decompK (k := k) (archW k Ω K φ)).subtype
            (SSGRoute.PTExt.modRep (↥K ≃ₐ[k] ↥K) (VFcoef p M T))))
        ((groupCohomology.H1π _).hom z)
  rw [Work.SSGRoute.extHMap_gammaHom_eq (G := ↥L ≃ₐ[k] ↥L)
    (H := ↥(SSGRoute.PTExt.decompK (k := k) u))
    (r := (SSGRoute.PTExt.decompK (k := k) u).subtype) (M := VFcoef p M T)
    ⟨ψ, fun g h => hψ g h⟩]
  rw [hzφ]
  exact (Work.SSGRoute.PT.eCoh_eq_gammaHom_of_zpowers (G := ↥(SSGRoute.PTExt.decompK (k := k) u))
    (c := ⟨SSGRoute.res k L c, hcmem⟩) hcmm hgen (M := VFcoef p M T) (φ := φ') hφ'cross
    (z := ⟨φ', hφ'mem⟩) (hz := fun g => rfl)).symm

end Work.SSGRoute.PT
