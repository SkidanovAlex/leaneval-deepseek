/-!
# The procyclic group `C = closure (zpowers σ)`

Group theory of `C := Subgroup.topologicalClosure (Subgroup.zpowers σ) ⊆ G_k = Ω ≃ₐ[k] Ω`, for
the two-row decomposition of `H¹_loc(D_A, M)`.

* `zpowersClosure_mul_comm` — `C` is commutative (it is topologically generated by one element);
* `zpowers_subtype_dense` — `zpowers σ` is dense in `C` (equivalently `C` is topologically
  generated by `σ`);
* `closure_zpowers_pow_isOpen` — in a compact Hausdorff group generated topologically by `σ`, the
  closed subgroup `closure (zpowers (σ ^ N))` is open (for `N > 0`);
* `hbig_of_cyclic_dense` — `p`-divisibility of the open subgroups of such a group: every open
  normal `U` contains an open normal `V` with `p ∣ [U : V]`;
* `hbig_zpowersClosure` — the same statement for `C`, from the hypothesis `hZ` (a surjection of
  `C` onto `ZMod n` for every `n > 0`).

`hbig_zpowersClosure` is the hypothesis `hbig` of
`Work.SSGRoute.isCoboundary2On_top_of_procyclicGrowth` and of the construction of locally constant
`1`-cocycles on `C` with prescribed value at `σ`.
-/

open scoped Pointwise
open Classical

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

namespace Work.SSGRoute.PT

noncomputable section

variable (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]

/-- **`C = closure (zpowers σ)` is commutative**: it is topologically generated by one element, and
the closure of the centralizer of `σ` contains `C`. -/
theorem zpowersClosure_mul_comm (σ : Ω ≃ₐ[k] Ω) :
    ∀ x ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ),
      ∀ y ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), x * y = y * x := by
  haveI : T2Space (Ω ≃ₐ[k] Ω) := krullTopology_t2 (K := k) (L := Ω)
  have hcent_closed : ∀ x : Ω ≃ₐ[k] Ω,
      IsClosed ((Subgroup.centralizer ({x} : Set (Ω ≃ₐ[k] Ω)) :
        Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) := by
    intro x
    have hset : ((Subgroup.centralizer ({x} : Set (Ω ≃ₐ[k] Ω)) :
        Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) = {z | x * z = z * x} := by
      ext z
      rw [SetLike.mem_coe, Subgroup.mem_centralizer_iff]
      constructor
      · intro h; exact h x (by simp)
      · intro h y hy
        rw [Set.mem_singleton_iff] at hy
        subst hy; exact h
    rw [hset]
    exact isClosed_eq (continuous_const.mul continuous_id) (continuous_id.mul continuous_const)
  have hσ_mem : Subgroup.zpowers σ ≤ Subgroup.centralizer ({σ} : Set (Ω ≃ₐ[k] Ω)) := by
    intro z hz
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    simp only [Set.mem_singleton_iff] at hw
    subst hw
    obtain ⟨i, rfl⟩ := (Subgroup.mem_zpowers_iff).mp hz
    rw [← zpow_one_add, add_comm, zpow_add_one]
  have hC_le : Subgroup.topologicalClosure (Subgroup.zpowers σ) ≤
      Subgroup.centralizer ({σ} : Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.topologicalClosure_minimal _ hσ_mem (hcent_closed σ)
  intro x hx y hy
  have hxσ : x * σ = σ * x := by
    have h := hC_le hx
    rw [Subgroup.mem_centralizer_iff] at h
    exact (h σ (by simp)).symm
  have hσ_cen : σ ∈ Subgroup.centralizer ({x} : Set (Ω ≃ₐ[k] Ω)) := by
    rw [Subgroup.mem_centralizer_iff]
    intro w hw
    simp only [Set.mem_singleton_iff] at hw
    subst hw
    exact hxσ
  have hle : Subgroup.topologicalClosure (Subgroup.zpowers σ) ≤
      Subgroup.centralizer ({x} : Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.topologicalClosure_minimal _ (Subgroup.zpowers_le.mpr hσ_cen) (hcent_closed x)
  have h := hle hy
  rw [Subgroup.mem_centralizer_iff] at h
  exact h x (by simp)

/-- **`zpowers σ` is dense in `C = closure (zpowers σ)`.** -/
theorem zpowers_subtype_dense (σ : Ω ≃ₐ[k] Ω)
    (hσC : σ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ)) :
    Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ :
      ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)))) = ⊤ := by
  set C : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.topologicalClosure (Subgroup.zpowers σ) with hCdef
  have hmap := Work.SSGRoute.map_topologicalClosure_zpowers_subtype (G := Ω ≃ₐ[k] Ω) C
    (Subgroup.isClosed_topologicalClosure _) σ hσC
  have hmap' : (Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C))).map C.subtype
      = C := hmap
  have htop : (⊤ : Subgroup ↥C).map (Subgroup.subtype C) = C := by
    ext x
    constructor
    · intro hx; exact Subgroup.map_subtype_le ⊤ hx
    · intro hx
      exact Subgroup.mem_map.mpr ⟨⟨x, hx⟩, Subgroup.mem_top _, rfl⟩
  exact Subgroup.map_injective (f := Subgroup.subtype C) (fun x y h => Subtype.ext h)
    (hmap'.trans htop.symm)

/-- **In a compact Hausdorff group generated topologically by `σ`, the closed subgroup
`V = closure (zpowers (σ ^ N))` is open** (for `N > 0`).  The `N` translates `σ^i * V`
(`0 ≤ i < N`) are closed and cover the group — the union is closed and contains the dense subgroup
`zpowers σ` — hence `⇑Γ ⧸ V` is a quotient of `Fin N`, so `V` has finite index and is closed,
which makes it open. -/
theorem closure_zpowers_pow_isOpen {Γ : Type} [Group Γ] [TopologicalSpace Γ]
    [IsTopologicalGroup Γ] [T2Space Γ] (σ : Γ) (N : ℕ) (hN : 0 < N)
    (hdense : Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊤) :
    IsOpen ((Subgroup.topologicalClosure (Subgroup.zpowers (σ ^ N)) : Subgroup Γ) : Set Γ) := by
  set V : Subgroup Γ := Subgroup.topologicalClosure (Subgroup.zpowers (σ ^ N)) with hVdef
  have hVclosed : IsClosed (V : Set Γ) := Subgroup.isClosed_topologicalClosure _
  have hcover : ∀ x : Γ, ∃ i ∈ Finset.range N, ∃ y ∈ V, σ ^ i * y = x := by
    have hWclosed : IsClosed {x : Γ | ∃ i ∈ Finset.range N, ∃ y ∈ V, σ ^ i * y = x} := by
      have hset : {x : Γ | ∃ i ∈ Finset.range N, ∃ y ∈ V, σ ^ i * y = x}
          = ⋃ i ∈ Finset.range N, (fun y : Γ => σ ^ i * y) '' (V : Set Γ) := by
        ext x
        constructor
        · rintro ⟨i, hi, y, hy, hxy⟩
          exact Set.mem_iUnion.mpr ⟨i, Set.mem_iUnion.mpr ⟨hi, ⟨y, hy, hxy⟩⟩⟩
        · intro hx
          obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hx
          obtain ⟨hi', hy⟩ := Set.mem_iUnion.mp hi
          obtain ⟨y, hy', hxy⟩ := hy
          exact ⟨i, hi', y, hy', hxy⟩
      rw [hset]
      refine isClosed_biUnion_finset ?_
      intro i _
      exact (Homeomorph.mulLeft (σ ^ i)).isClosedMap (V : Set Γ) hVclosed
    have hsub : (Subgroup.zpowers σ : Set Γ)
        ⊆ {x : Γ | ∃ i ∈ Finset.range N, ∃ y ∈ V, σ ^ i * y = x} := by
      intro z hz
      obtain ⟨k, rfl⟩ := (Subgroup.mem_zpowers_iff).mp hz
      have hmod0 : 0 ≤ k % (N : ℤ) := Int.emod_nonneg k (by omega)
      have hmodN : k % (N : ℤ) < N := Int.emod_lt_of_pos k (by omega)
      have hcast : (((k % (N : ℤ)).toNat : ℕ) : ℤ) = k % (N : ℤ) := Int.toNat_of_nonneg hmod0
      refine ⟨(k % (N : ℤ)).toNat, Finset.mem_range.mpr (by omega),
        ((σ ^ N) : Γ) ^ (k / (N : ℤ)), ?_, ?_⟩
      · exact Subgroup.le_topologicalClosure _ (Subgroup.zpow_mem_zpowers (σ ^ N) (k / (N : ℤ)))
      · have h1 : ((σ ^ N) : Γ) ^ (k / (N : ℤ)) = σ ^ ((N : ℤ) * (k / (N : ℤ))) := by
          rw [zpow_mul, zpow_natCast]
        show σ ^ ((k % (N : ℤ)).toNat) * ((σ ^ N) : Γ) ^ (k / (N : ℤ)) = σ ^ k
        rw [h1, ← zpow_natCast σ ((k % (N : ℤ)).toNat), ← zpow_add]
        congr 1
        have hk := Int.mul_ediv_add_emod k (N : ℤ)
        linarith
    have hcl := closure_minimal hsub hWclosed
    intro x
    have hx : x ∈ closure ((Subgroup.zpowers σ : Set Γ)) := by
      rw [← Subgroup.topologicalClosure_coe, hdense]
      exact Subgroup.mem_top x
    exact hcl hx
  have hsurj : Function.Surjective (fun i : Fin N => (QuotientGroup.mk (σ ^ (i : ℕ)) : Γ ⧸ V)) := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective q
    obtain ⟨i, hi, y, hy, hxy⟩ := hcover x
    refine ⟨⟨i, Finset.mem_range.mp hi⟩, ?_⟩
    rw [QuotientGroup.eq]
    have : (σ ^ i)⁻¹ * x = y := by rw [← hxy]; group
    rw [this]
    exact hy
  haveI : Finite (Γ ⧸ V) := Finite.of_surjective _ hsurj
  haveI : V.FiniteIndex := Subgroup.finiteIndex_iff_finite_quotient.mpr inferInstance
  exact Subgroup.isOpen_of_isClosed_of_finiteIndex V hVclosed

/-- **`p`-divisibility of the open subgroups of a compact group generated by one element.**

For every open normal `U` there is an open normal `V ≤ U` with `p ∣ [U : V]`.

Proof.  Put `N := p * [Γ : U]` and let `f : Γ →* ZMod N` be a surjection (hypothesis `hZ`).  The
closed subgroup `W := closure (zpowers (σ ^ N))` is open (`closure_zpowers_pow_isOpen`), and it is
contained in `f.ker`: the `N`-th powers of `Γ` are killed by `f` and form a closed set, so
`W ⊆ f.ker`.  Take `V := U ⊓ W`.  Now `(U ⊓ f.ker).relIndex U = |f (U)|` and
`|f (U)| * [(U.map f).index] = |ZMod N| = p * [Γ : U]` where `(U.map f).index ∣ [Γ : U]`, so
`p ∣ (U ⊓ f.ker).relIndex U`; since `V ≤ U ⊓ f.ker ≤ U`, the index `[U : V]` is a multiple of
`(U ⊓ f.ker).relIndex U`, hence divisible by `p`. -/
theorem hbig_of_cyclic_dense {Γ : Type} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ]
    [CompactSpace Γ] [T2Space Γ] (hcomm : ∀ x y : Γ, x * y = y * x) (σ : Γ)
    (hdense : Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊤)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : Γ →* Multiplicative (ZMod n), Function.Surjective f)
    (p : ℕ) [Fact p.Prime] :
    ∀ U : Subgroup Γ, IsOpen (U : Set Γ) → U.Normal →
      ∃ V : Subgroup Γ, V ≤ U ∧ IsOpen (V : Set Γ) ∧ V.Normal ∧ p ∣ (V.subgroupOf U).index := by
  intro U hUo _
  haveI : U.FiniteIndex := by
    rw [Subgroup.finiteIndex_iff_finite_quotient]
    haveI : DiscreteTopology (Γ ⧸ U) := QuotientGroup.discreteTopology_iff.mpr hUo
    exact finite_of_compact_of_discrete
  have hUpos : 0 < U.index := Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite (H := U))
  have hNpos : 0 < p * U.index := Nat.mul_pos (Fact.out : Nat.Prime p).pos hUpos
  obtain ⟨f, hf⟩ := hZ (p * U.index) hNpos
  have hWopen : IsOpen ((Subgroup.topologicalClosure (Subgroup.zpowers (σ ^ (p * U.index))) :
      Subgroup Γ) : Set Γ) := closure_zpowers_pow_isOpen σ (p * U.index) hNpos hdense
  have hWker : Subgroup.topologicalClosure (Subgroup.zpowers (σ ^ (p * U.index))) ≤ f.ker := by
    have hrange_closed : IsClosed (Set.range (fun y : Γ => y ^ (p * U.index))) :=
      (isCompact_range (continuous_id.pow (p * U.index))).isClosed
    have hsub : (Subgroup.zpowers (σ ^ (p * U.index)) : Set Γ)
        ⊆ Set.range (fun y : Γ => y ^ (p * U.index)) := by
      intro x hx
      obtain ⟨k, rfl⟩ := (Subgroup.mem_zpowers_iff).mp hx
      exact ⟨σ ^ k, by
        show (σ ^ k) ^ (p * U.index : ℕ) = (σ ^ (p * U.index)) ^ k
        rw [← zpow_natCast (σ ^ k) (p * U.index), ← zpow_natCast σ (p * U.index),
          ← zpow_mul, ← zpow_mul, mul_comm]⟩
    have hker : Set.range (fun y : Γ => y ^ (p * U.index)) ⊆ (f.ker : Set Γ) := by
      rintro x ⟨y, rfl⟩
      rw [SetLike.mem_coe, MonoidHom.mem_ker]
      haveI : NeZero (p * U.index) := ⟨hNpos.ne'⟩
      have h := pow_card_eq_one (G := Multiplicative (ZMod (p * U.index))) (x := f y)
      simpa [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card] using h
    intro x hx
    rw [← SetLike.mem_coe, Subgroup.topologicalClosure_coe] at hx
    exact hker (closure_minimal hsub hrange_closed hx)
  have hker_eq : (f.comp U.subtype).ker = (U ⊓ f.ker).subgroupOf U := by
    ext x
    simp [MonoidHom.mem_ker, Subgroup.mem_subgroupOf]
  have hrange_eq : (f.comp U.subtype).range = U.map f := by
    rw [MonoidHom.range_comp, Subgroup.range_subtype]
  have hrel : (U ⊓ f.ker).relIndex U = Nat.card ↥(U.map f) := by
    rw [Subgroup.relIndex, hker_eq.symm, Subgroup.index_ker, hrange_eq]
  have hcardN : Nat.card (Multiplicative (ZMod (p * U.index))) = p * U.index := by
    haveI : NeZero (p * U.index) := ⟨hNpos.ne'⟩
    rw [Nat.card_eq_fintype_card, Fintype.card_multiplicative, ZMod.card]
  have hmult := Subgroup.card_mul_index (U.map f)
  rw [hcardN] at hmult
  have hm_ne : (U.map f).index ≠ 0 := by
    intro h0
    rw [h0, mul_zero] at hmult
    omega
  obtain ⟨t, ht⟩ := Subgroup.index_map_dvd (H := U) hf
  have hp : p ∣ Nat.card ↥(U.map f) := by
    have hkey : Nat.card ↥(U.map f) = p * t := by
      have h2 : Nat.card ↥(U.map f) * (U.map f).index = (p * t) * (U.map f).index := by
        calc Nat.card ↥(U.map f) * (U.map f).index = p * U.index := hmult
          _ = p * ((U.map f).index * t) := congrArg (fun z => p * z) ht
          _ = (p * t) * (U.map f).index := by ring
      exact Nat.mul_right_cancel (Nat.pos_of_ne_zero hm_ne) h2
    exact ⟨t, hkey⟩
  set W : Subgroup Γ := Subgroup.topologicalClosure (Subgroup.zpowers (σ ^ (p * U.index))) with hWdef
  have hWopen' : IsOpen (W : Set Γ) := hWopen
  refine ⟨U ⊓ W, inf_le_left, ?_, ?_, ?_⟩
  · rw [Subgroup.coe_inf]
    exact hUo.inter hWopen'
  · refine ⟨fun n hn g => ?_⟩
    have h1 : g * n * g⁻¹ = n := by rw [hcomm g n, mul_assoc, mul_inv_cancel, mul_one]
    rw [h1]; exact hn
  · have hpdvd : p ∣ (U ⊓ f.ker).relIndex U := by
      rw [hrel]; exact hp
    have hstep : ((U ⊓ W).subgroupOf U).index
        = (U ⊓ W).relIndex (U ⊓ f.ker) * (U ⊓ f.ker).relIndex U := by
      rw [show ((U ⊓ W).subgroupOf U).index = (U ⊓ W).relIndex U from rfl,
        (Subgroup.relIndex_mul_relIndex (U ⊓ W) (U ⊓ f.ker) U (inf_le_inf_left _ hWker)
          inf_le_left).symm]
    rw [hstep]
    exact dvd_mul_of_dvd_right hpdvd _


/-- **`p`-divisibility of the open subgroups of `C = closure (zpowers σ)`**, from the hypothesis
`hZ` that `C` has a surjection onto `ZMod n` for every `n > 0`. -/
theorem hbig_zpowersClosure (p : ℕ) [Fact p.Prime] (σ : Ω ≃ₐ[k] Ω)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f) :
    ∀ U : Subgroup ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)),
      IsOpen (U : Set ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ))) → U.Normal →
      ∃ V : Subgroup ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)),
        V ≤ U ∧ IsOpen (V : Set ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ))) ∧
          V.Normal ∧ p ∣ (V.subgroupOf U).index := by
  haveI : CompactSpace ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) := by
    haveI : T2Space (Ω ≃ₐ[k] Ω) := krullTopology_t2 (K := k) (L := Ω)
    exact isCompact_iff_compactSpace.mp (Subgroup.isClosed_topologicalClosure _).isCompact
  haveI : T2Space ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) := inferInstance
  have hσC : σ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ) :=
    Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers σ)
  exact hbig_of_cyclic_dense
    (fun x y => Subtype.ext (zpowersClosure_mul_comm k Ω σ x.1 x.2 y.1 y.2))
    (⟨σ, hσC⟩ : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)))
    (zpowers_subtype_dense k Ω σ hσC) hZ p

end

end Work.SSGRoute.PT
