/-! ## The `p`-torsion of a finite cyclic additive group, counted by a `gcd`

This is the generalisation of `Work.SSGRoute.natCard_pTorsion_subtype_eq_of_zmultiples_top` that
does not assume `p` prime nor `p ∣ n`: for a monogenic additive group `A` of order `n ≠ 0`, the
number of solutions of `p • x = 0` is `Nat.gcd p n`. -/
theorem natCard_pTorsion_subtype_eq_gcd_of_zmultiples_top (A : Type) [AddCommGroup A] (p n : ℕ)
    (hn : n ≠ 0) (hcard : Nat.card A = n) (a : A) (hgen : AddSubgroup.zmultiples a = ⊤) :
    Nat.card {x : A // p • x = 0} = Nat.gcd p n := by
  haveI : Finite A := (Nat.card_ne_zero.mp (by rw [hcard]; exact hn)).2
  -- the additive order of the generator is `n`
  have ha : addOrderOf a = n := by
    have h1 : Nat.card (AddSubgroup.zmultiples a) = Nat.card A := by
      rw [hgen, AddSubgroup.card_top]
    rw [Nat.card_zmultiples] at h1
    exact h1.trans hcard
  have hna : n • a = 0 := by rw [← ha]; exact addOrderOf_nsmul_eq_zero a
  have hgdvd : Nat.gcd p n ∣ n := Nat.gcd_dvd_right p n
  have hg0 : Nat.gcd p n ≠ 0 := fun h => hn (Nat.gcd_eq_zero_iff.mp h).2
  -- the generator of the `p`-torsion is `(n / gcd p n) • a`, of order `gcd p n`
  have ha' : addOrderOf ((n / Nat.gcd p n) • a) = Nat.gcd p n := by
    rw [addOrderOf_nsmul, ha, Nat.gcd_eq_right (Nat.div_dvd_of_dvd hgdvd),
      Nat.div_div_self hgdvd hn]
  have hpa' : p • ((n / Nat.gcd p n) • a) = 0 := by
    have h1 : Nat.gcd p n * (p / Nat.gcd p n) = p :=
      Nat.mul_div_cancel' (Nat.gcd_dvd_left p n)
    have h2 : Nat.gcd p n * (n / Nat.gcd p n) = n := Nat.mul_div_cancel' hgdvd
    have hpng : p * (n / Nat.gcd p n) = (p / Nat.gcd p n) * n := by
      calc p * (n / Nat.gcd p n)
          = (Nat.gcd p n * (p / Nat.gcd p n)) * (n / Nat.gcd p n) := by rw [h1]
        _ = (p / Nat.gcd p n) * (Nat.gcd p n * (n / Nat.gcd p n)) := by ring
        _ = (p / Nat.gcd p n) * n := by rw [h2]
    rw [smul_comm, ← mul_nsmul, hpng, Nat.mul_comm (p / Nat.gcd p n) n, mul_nsmul, hna,
      smul_zero]
  -- the `p`-torsion is exactly the subgroup generated by that element
  have hmem : ∀ v : A, v ∈ AddSubgroup.zmultiples ((n / Nat.gcd p n) • a) ↔ p • v = 0 := by
    intro v
    constructor
    · intro hv
      rw [AddSubgroup.mem_zmultiples_iff] at hv
      obtain ⟨k, rfl⟩ := hv
      rw [smul_comm, hpa', smul_zero]
    · intro hv
      rw [AddSubgroup.mem_zmultiples_iff]
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen ▸ AddSubgroup.mem_top v)
      have hk0 : ((p : ℤ) * k) • a = 0 := by rw [mul_zsmul, natCast_zsmul, hk, hv]
      have hdiv : (n : ℤ) ∣ (p : ℤ) * k := by
        have h := addOrderOf_dvd_iff_zsmul_eq_zero.mpr hk0
        rwa [ha] at h
      have hgZ : (Nat.gcd p n : ℤ) ≠ 0 := by exact_mod_cast hg0
      have hncast : (n : ℤ) = (Nat.gcd p n : ℤ) * ((n / Nat.gcd p n : ℕ) : ℤ) := by
        rw [← Nat.cast_mul, Nat.mul_div_cancel' hgdvd]
      have hpcast : (p : ℤ) = (Nat.gcd p n : ℤ) * ((p / Nat.gcd p n : ℕ) : ℤ) := by
        rw [← Nat.cast_mul, Nat.mul_div_cancel' (Nat.gcd_dvd_left p n)]
      have hdiv' : (Nat.gcd p n : ℤ) * ((n / Nat.gcd p n : ℕ) : ℤ)
          ∣ (Nat.gcd p n : ℤ) * (((p / Nat.gcd p n : ℕ) : ℤ) * k) := by
        rw [← hncast, ← mul_assoc, ← hpcast]
        exact hdiv
      have h2 : ((n / Nat.gcd p n : ℕ) : ℤ) ∣ ((p / Nat.gcd p n : ℕ) : ℤ) * k :=
        (Int.mul_dvd_mul_iff_left hgZ).mp hdiv'
      have hcop : Nat.Coprime (n / Nat.gcd p n) (p / Nat.gcd p n) :=
        (Nat.coprime_div_gcd_div_gcd
          (Nat.gcd_pos_of_pos_right p (Nat.pos_of_ne_zero hn))).symm
      have h4 : ((n / Nat.gcd p n : ℕ) : ℤ) ∣ k := hcop.isCoprime.dvd_of_dvd_mul_left h2
      obtain ⟨j, hj⟩ := h4
      refine ⟨j, ?_⟩
      calc j • ((n / Nat.gcd p n) • a)
          = j • (((n / Nat.gcd p n : ℕ) : ℤ) • a) := by rw [natCast_zsmul]
        _ = (j * ((n / Nat.gcd p n : ℕ) : ℤ)) • a := by rw [← mul_zsmul]
        _ = (((n / Nat.gcd p n : ℕ) : ℤ) * j) • a := by rw [mul_comm]
        _ = k • a := by rw [← hj]
        _ = v := hk
  calc Nat.card {x : A // p • x = 0}
      = Nat.card (AddSubgroup.zmultiples ((n / Nat.gcd p n) • a)) :=
        Nat.card_congr (Equiv.subtypeEquivRight (fun v => (hmem v).symm))
    _ = addOrderOf ((n / Nat.gcd p n) • a) := Nat.card_zmultiples _
    _ = Nat.gcd p n := ha'

/-- **The order of the local Brauer group is the order of the decomposition group**, at every
place (finite or archimedean). -/
theorem natCard_extH_localUnits_eq_natCard_decompK (k L : Type) [Field k] [NumberField k]
    [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (w : NK.GlobalCFT.Place L) :
    Nat.card (SSGRoute.PTExt.extH (SSGRoute.PTExt.localUnitsK (k := k) w) 2)
      = Nat.card (SSGRoute.PTExt.decompK (k := k) w) := by
  rcases w with ŵ | q
  · rw [Work.SSGRoute.natCard_extH_localUnits_deep_ofInfinite]
    rfl
  · exact Work.SSGRoute.localUnits_extH_natCard_eq_ofFinite k L q

/-- **The `p`-torsion of the local Brauer group is `ℤ/gcd(p, |D_w|)`.**  For a finite Galois
extension `k ⊆ L` of number fields, a place `w` of `L` and a prime `p`, the `p`-torsion of
`H²(D_w, L_wˣ) = Br(L_w/k_v)` has `Nat.gcd p |D_w|` elements; the group is cyclic (the local
invariant map), so this is the `p`-torsion of a cyclic group of order `|D_w|`. -/
theorem localUnits_extH_pTorsion_card_gcd (p : ℕ) [Fact p.Prime] (k L : Type) [Field k]
    [NumberField k] [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L]
    [IsGalois k L] (w : NK.GlobalCFT.Place L) :
    Nat.card {x : SSGRoute.PTExt.extH (SSGRoute.PTExt.localUnitsK (k := k) w) 2 // p • x = 0}
      = Nat.gcd p (Nat.card (SSGRoute.PTExt.decompK (k := k) w)) := by
  -- the local Brauer group is monogenic
  obtain ⟨u, hgen⟩ := Work.SSGRoute.extH_localUnits_generator k L w
  -- and its cardinality is the order of the decomposition group
  have hcard := natCard_extH_localUnits_eq_natCard_decompK k L w
  have hn : Nat.card (SSGRoute.PTExt.decompK (k := k) w) ≠ 0 :=
    Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  exact natCard_pTorsion_subtype_eq_gcd_of_zmultiples_top
    (SSGRoute.PTExt.extH (SSGRoute.PTExt.localUnitsK (k := k) w) 2) p
    (Nat.card (SSGRoute.PTExt.decompK (k := k) w)) hn hcard u hgen

