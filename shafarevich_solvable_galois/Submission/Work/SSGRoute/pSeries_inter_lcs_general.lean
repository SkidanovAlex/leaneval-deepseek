/-- The descending central series is functorial for an arbitrary group homomorphism:
`(γ_n P).map f ≤ γ_n Q`. -/
theorem map_lcs_le {P Q : Type*} [Group P] [Group Q] (f : P →* Q) (n : ℕ) :
    ((⊤ : Subgroup P).lowerCentralSeries n).map f ≤ (⊤ : Subgroup Q).lowerCentralSeries n := by
  rw [Subgroup.map_lowerCentralSeries]
  exact Subgroup.lowerCentralSeries_mono n le_top

/-- The range of `FreeGroup.map f` is the subgroup generated by the images of the generators in
the range of `f`. -/
theorem range_freeGroup_map_eq {X Y : Type*} (f : Y → X) :
    (FreeGroup.map f).range = Subgroup.closure (FreeGroup.of '' Set.range f) := by
  rw [MonoidHom.range_eq_map, ← FreeGroup.closure_range_of Y, MonoidHom.map_closure]
  congr 1
  have hfun : (FreeGroup.map f) ∘ (FreeGroup.of : Y → FreeGroup Y) = FreeGroup.of ∘ f := by
    funext a
    exact FreeGroup.map.of
  rw [← Set.range_comp, ← Set.range_comp, hfun]

/-- Every element of a free group lies in the subgroup generated by the images of a finite set of
generators of the base type. -/
theorem exists_finset_closure_of {X : Type*} (x : FreeGroup X) :
    ∃ S : Finset X, x ∈ Subgroup.closure (FreeGroup.of '' (S : Set X)) := by
  classical
  refine FreeGroup.induction_on x ?_ ?_ ?_ ?_
  · exact ⟨∅, Subgroup.one_mem _⟩
  · intro a
    exact ⟨{a}, Subgroup.subset_closure ⟨a, by simp, rfl⟩⟩
  · intro a h
    obtain ⟨S, hS⟩ := h
    exact ⟨S, Subgroup.inv_mem _ hS⟩
  · intro p q hp hq
    obtain ⟨S₁, h₁⟩ := hp
    obtain ⟨S₂, h₂⟩ := hq
    refine ⟨S₁ ∪ S₂, Subgroup.mul_mem _ ?_ ?_⟩
    · refine (Subgroup.closure_mono (Set.image_mono ?_)) h₁
      intro y hy
      exact Finset.mem_union_left _ hy
    · refine (Subgroup.closure_mono (Set.image_mono ?_)) h₂
      intro y hy
      exact Finset.mem_union_right _ hy

/-- If `x` lies in the subgroup generated by the images of the finitely many generators in the
finite set `S ⊆ X`, then `x` lies in the range of a homomorphism `φ : FreeGroup (Fin n) →*
FreeGroup X` (a finitely generated free factor) which admits a retraction `ρ` with
`ρ.comp φ = id`. -/
theorem exists_freeFactor_retraction_of_closure {X : Type*} (S : Finset X) (x : FreeGroup X)
    (hx : x ∈ Subgroup.closure (FreeGroup.of '' (S : Set X))) :
    ∃ (n : ℕ) (φ : FreeGroup (Fin n) →* FreeGroup X) (ρ : FreeGroup X →* FreeGroup (Fin n)),
      ρ.comp φ = MonoidHom.id (FreeGroup (Fin n)) ∧ x ∈ φ.range := by
  classical
  let e : ↥S ≃ Fin S.card := Finset.equivFin S
  let f : Fin S.card → X := fun i => (e.symm i : ↥S).1
  let g : X → FreeGroup (Fin S.card) :=
    fun y => if h : y ∈ S then FreeGroup.of (e ⟨y, h⟩) else 1
  have hgf : ∀ i, g (f i) = FreeGroup.of i := by
    intro i
    have hmem : ((e.symm i : ↥S) : X) ∈ S := (e.symm i : ↥S).2
    show (if h : ((e.symm i : ↥S) : X) ∈ S
        then FreeGroup.of (e ⟨((e.symm i : ↥S) : X), h⟩) else 1) = FreeGroup.of i
    rw [dif_pos hmem]
    congr 1
    rw [show (⟨((e.symm i : ↥S) : X), hmem⟩ : ↥S) = e.symm i from Subtype.ext rfl,
      Equiv.apply_symm_apply]
  obtain ⟨ρ, hρ⟩ := exists_freeGroup_lift_retraction f g hgf
  refine ⟨S.card, FreeGroup.map f, ρ, hρ, ?_⟩
  have hran : Set.range f = (S : Set X) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact (e.symm i : ↥S).2
    · intro hy
      refine ⟨e ⟨y, hy⟩, ?_⟩
      dsimp only [f]
      rw [Equiv.symm_apply_apply]
  rw [range_freeGroup_map_eq, hran]
  exact hx

/-- **Lemma 4(ii) of Schmidt–Wingberg at `(i,j) = (j+1,j)`, for free groups of arbitrary rank.**
For a free group on an arbitrary type `X` (no finiteness hypothesis), the `j`-th term of the
descending central series meets the `j`-th term of the descending `2`-central series exactly in
`γ_j² · γ_{j+1}`.  This is `Work.SSGRoute.lcs_inter_pCentralSeries_eq` without the `[Fintype X]`
hypothesis.  (Proof route: reduce to the finitely generated case by applying the retraction
`F(X) → F(Y)` onto the free factor generated by the finitely many letters occurring in a given
element; the one-step lemma `prop5.pSeries_inter_lcs_le_oneStep`-style inputs have no finiteness
hypothesis, so the whole `pCentralSeries_inter_lowerCentralSeries_le` chain should be
re-provable with `X : Type*`.) -/
theorem pSeries_inter_lcs_general {X : Type*} (j : ℕ) (hj : 1 ≤ j) :
    (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) ⊓
      Work.Shrinking.pCentralSeries 2 (FreeGroup X) j
    = Work.Shrinking.powSubgroup 2 ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊔
      (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
  apply le_antisymm
  · -- `⊆`: reduce to the finitely generated free factor `FreeGroup (Fin n)`.
    intro x hx
    obtain ⟨hxG, hxP⟩ := Subgroup.mem_inf.mp hx
    obtain ⟨S, hS⟩ := exists_finset_closure_of x
    obtain ⟨n, φ, ρ, hρφ, hxrange⟩ := exists_freeFactor_retraction_of_closure S x hS
    obtain ⟨y, hy_eq⟩ := MonoidHom.mem_range.mp hxrange
    rw [← hy_eq] at hxG hxP ⊢
    have hy_rho : ρ (φ y) = y := DFunLike.congr_fun hρφ y
    have hyG : y ∈ (⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries (j - 1) := by
      have h : ρ (φ y) ∈ (⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries (j - 1) :=
        map_lcs_le ρ (j - 1) (Subgroup.mem_map_of_mem ρ hxG)
      rwa [hy_rho] at h
    have hyP : y ∈ Work.Shrinking.pCentralSeries 2 (FreeGroup (Fin n)) j := by
      have h : ρ (φ y) ∈ Work.Shrinking.pCentralSeries 2 (FreeGroup (Fin n)) j :=
        pCentralSeries_map_le 2 ρ j (Subgroup.mem_map_of_mem ρ hxP)
      rwa [hy_rho] at h
    have hy : y ∈ Work.Shrinking.powSubgroup 2
          ((⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries (j - 1)) ⊔
        (⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries j := by
      rw [← lcs_inter_pCentralSeries_eq (X := Fin n) j hj]
      exact ⟨hyG, hyP⟩
    have hmem : φ y ∈ Subgroup.map φ (Work.Shrinking.powSubgroup 2
          ((⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries (j - 1))) ⊔
        Subgroup.map φ ((⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries j) := by
      rw [← Subgroup.map_sup]
      exact Subgroup.mem_map_of_mem φ hy
    have hle : Subgroup.map φ (Work.Shrinking.powSubgroup 2
          ((⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries (j - 1))) ⊔
        Subgroup.map φ ((⊤ : Subgroup (FreeGroup (Fin n))).lowerCentralSeries j) ≤
        Work.Shrinking.powSubgroup 2 ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ⊔
          (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries j := by
      refine sup_le ?_ ?_
      · exact ((le_of_eq (Work.Shrinking.map_powSubgroup 2 φ _)).trans
          (pCentralSeriesMapAux.powSubgroup_mono 2 (map_lcs_le φ (j - 1)))).trans le_sup_left
      · exact (map_lcs_le φ j).trans le_sup_right
    exact hle hmem
  · -- `⊇`: both `γ_{j-1}²` and `γ_j` lie in `γ_{j-1}` and in `P_j`.
    refine sup_le ?_ ?_
    · refine le_inf (Work.Shrinking.powSubgroup_le 2 _) ?_
      have h1 : (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1) ≤
          Work.Shrinking.pCentralSeries 2 (FreeGroup X) (j - 1) :=
        Work.ProP.lowerCentralSeries_le_pCentralSeries 2 (FreeGroup X) (j - 1)
      have h2 : Work.Shrinking.powSubgroup 2
            ((⊤ : Subgroup (FreeGroup X)).lowerCentralSeries (j - 1)) ≤
          Work.Shrinking.powSubgroup 2
            (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (j - 1)) :=
        pCentralSeriesMapAux.powSubgroup_mono 2 h1
      have h3 : Work.Shrinking.powSubgroup 2
            (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (j - 1)) ≤
          Work.Shrinking.pCentralSeries 2 (FreeGroup X) ((j - 1) + 1) := by
        rw [Work.Shrinking.pCentralSeries_succ, Work.Shrinking.pCentralStep]
        exact le_sup_left
      rw [show (j - 1) + 1 = j from by omega] at h3
      exact h2.trans h3
    · refine le_inf ?_ ?_
      · exact Subgroup.lowerCentralSeries_antitone _ (by omega)
      · exact Work.ProP.lowerCentralSeries_le_pCentralSeries 2 (FreeGroup X) j

