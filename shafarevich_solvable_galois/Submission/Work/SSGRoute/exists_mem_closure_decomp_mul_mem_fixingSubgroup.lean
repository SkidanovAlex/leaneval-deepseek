/-!
# The sub-base Fourth Step generation of Schmidt--Wingberg

`Work.SSGRoute.exists_mem_closure_decomp_mul_mem_fixingSubgroup`: for a pair of finite Galois
extensions `N₂ ⊆ M₀` of a number field `k` inside an algebraic closure `Ω`, a sub-base `k₀ ⊆ k`
and a finite set `S` of finite places of `Ω`, every `σ ∈ G_{N₂}` is congruent modulo `G_{M₀}` to an
element of the subgroup generated by the decomposition groups `D_A` of the finite places `A` of `Ω`
that are completely decomposed in `N₂` **over `k₀`** and avoid `S`.

The proof realises the prescribed element `σ|_{M₀}` by a Čebotarev element in the normal closure
`P` of `M₀` over `k₀`, extends it to `P` (`AlgEquiv.liftNormal`), and translates the resulting
prime of `P` into a place of `Ω` whose decomposition group over `k₀` maps onto `⟨σ|_{M₀}⟩`.
-/

open scoped Pointwise

namespace Work.SSGRoute

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

/-- A finite place of `Ω` over `k` is a finite place over any sub-base `k₀ ⊆ k`. -/
theorem isFinPlace_subbase (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (k₀ : Type) [Field k₀] [NumberField k₀] [Algebra k₀ k] [Algebra k₀ Ω]
    [IsScalarTower k₀ k Ω] [FiniteDimensional k₀ k] :
    ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A → SSGRoute.IsFinPlace k₀ A := by
  intro A hA
  rw [SSGRoute.IsFinPlace] at hA ⊢
  rw [IsScalarTower.algebraMap_eq k₀ k Ω, ← ValuationSubring.comap_comap]
  intro h
  exact hA (Commons.RingTheory.Valuation.ValuationSubring.eq_top_of_comap_algebraMap_eq_top
    (A.comap (algebraMap k Ω)) (Algebra.IsAlgebraic.of_finite k₀ k) h)

/-- **Čebotarev with avoidance and unramifiedness.** -/
theorem exists_frobAtPrime_avoid_unramified {K N : Type} [Field K] [NumberField K] [Field N]
    [NumberField N] [Algebra K N] [FiniteDimensional K N] [IsGalois K N]
    (σ : Gal(N/K)) (T : Finset (NK.Chebotarev.PrimeIdeal K)) :
    ∃ p : NK.Chebotarev.PrimeIdeal K, p ∉ T ∧
      NK.ChebotarevGeneral.IsUnramifiedAt (K := K) (N := N) p ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := N) p σ := by
  have hinf : (NK.ChebotarevGeneral.frobSet (K := K) (N := N) σ).Infinite :=
    Work.SSGRoute.chebotarevInfinite_type0 K N σ
  have hfin : (({p : NK.Chebotarev.PrimeIdeal K | p ∈ T} ∪ {p : NK.Chebotarev.PrimeIdeal K |
      ¬ NK.ChebotarevGeneral.IsUnramifiedAt (K := K) (N := N) p}) : Set _).Finite :=
    (Set.toFinite _).union (NK.ChebotarevGeneral.finite_setOf_not_isUnramified (K := K) (N := N))
  obtain ⟨p, hp⟩ := (hinf.sdiff hfin).nonempty
  rw [Set.mem_sdiff, Set.mem_union, not_or] at hp
  exact ⟨p, by simpa using hp.2.1, by simpa using hp.2.2, hp.1⟩

/-- The stabiliser of a finite place is its decomposition subgroup. -/
theorem stabilizer_ofFinite_eq_decompositionSubgroup {K L : Type} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (q : NK.Chebotarev.PrimeIdeal L) :
    MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofFinite q) =
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) q := by
  ext σ
  rw [Work.SSGRoute.mem_stabilizer_ofFinite_iff q σ,
    Submission.NeukirchUchida.Local.mem_decompositionSubgroup,
    IsDedekindDomain.HeightOneSpectrum.ext_iff,
    Submission.NeukirchUchida.Local.placeSmul_asIdeal]
  exact Iff.rfl

/-- `D_B` maps into the stabiliser of the prime below it. -/
theorem decomp_map_le_stabilizer_of_comap_eq (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K))
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hAq : A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q) :
    (SSGRoute.decomp k A).map (SSGRoute.res k K) ≤
      MulAction.stabilizer (↥K ≃ₐ[k] ↥K) (NK.GlobalCFT.Place.ofFinite q) := by
  rintro y hy
  rw [Subgroup.mem_map] at hy
  obtain ⟨σ, hσ, rfl⟩ := hy
  have hσA : σ • A = A := MulAction.mem_stabilizer_iff.mp hσ
  have hkey :=
    NK.Reconstruct.comap_smul_eq_restrictNormalHom_smul' (F := k) (E := ↥K) (K := Ω) A σ
  rw [hσA] at hkey
  have hresB : SSGRoute.res k K σ • (A.comap (algebraMap ↥K Ω)) = A.comap (algebraMap ↥K Ω) :=
    hkey.symm
  have hval : SSGRoute.res k K σ •
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q := by
    rw [← hAq]
    exact hresB
  rw [MulAction.mem_stabilizer_iff]
  rw [NK.GlobalCFT.Place.smul_ofFinite, NK.GlobalCFT.Place.ofFinite_inj]
  apply Commons.RingTheory.Valuation.valuationSubringAtPrime_injective
    (R := NumberField.RingOfIntegers ↥K) (K := ↥K)
  have hsmul :=
    Commons.NumberTheory.RamificationInertia.smul_valuationSubringAtPrime_eq_map_galRestrict
      (K := k) (L := ↥K) q (NK.GlobalCFT.Place.smulHeightOneSpectrum (SSGRoute.res k K σ) q)
      (SSGRoute.res k K σ)
      (by
        rw [NK.GlobalCFT.Place.smulHeightOneSpectrum_asIdeal]
        exact congrArg
          (fun e : NumberField.RingOfIntegers ↥K ≃+* NumberField.RingOfIntegers ↥K =>
            Ideal.map (e : NumberField.RingOfIntegers ↥K →+* NumberField.RingOfIntegers ↥K)
              q.asIdeal)
          (NK.GlobalCFT.Galois.ringOfIntegersEquiv_eq_galRestrict (SSGRoute.res k K σ)))
  rw [hsmul.symm]
  exact hval

/-- Every element of the stabiliser of the prime below `B` lifts into `D_B`. -/
theorem stabilizer_le_decomp_map_of_comap_eq (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] [NumberField K]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K))
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hAq : A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q) :
    MulAction.stabilizer (↥K ≃ₐ[k] ↥K) (NK.GlobalCFT.Place.ofFinite q) ≤
      (SSGRoute.decomp k A).map (SSGRoute.res k K) := by
  intro τ hτ
  have hτ' : τ ∈ MulAction.stabilizer (↥K ≃ₐ[k] ↥K) (A.comap (algebraMap ↥K Ω)) := by
    rw [hAq]
    exact SSGRoute.stabilizer_ofFinite_le_stabilizer_valuationSubringAtPrime K q hτ
  obtain ⟨σ, hσ, hres⟩ :=
    Commons.RingTheory.Valuation.exists_mem_stabilizer_restrictNormalHom_eq_of_isGalois
      (F := k) (E := Ω) A hA K τ hτ'
  exact ⟨σ, hσ, hres⟩

/-- A finite place of `Ω` over a sub-base `k₀` lies over a unique prime of `k₀`. -/
theorem exists_primeIdeal_comap_eq {k₀ Ω : Type} [Field k₀] [NumberField k₀] [Field Ω]
    [Algebra k₀ Ω] (A : ValuationSubring Ω) (hA : A.comap (algebraMap k₀ Ω) ≠ ⊤) :
    ∃ q : NK.Chebotarev.PrimeIdeal k₀,
      A.comap (algebraMap k₀ Ω) =
        IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k₀ q :=
  Commons.RingTheory.Valuation.exists_heightOneSpectrum_eq_valuationSubringAtPrime
    (A.comap (algebraMap k₀ Ω)) hA
    (Commons.NumberTheory.NumberField.ringOfIntegers_le_of_ne_top _ hA)


/-- **The sub-base Fourth Step generation.** -/
theorem exists_mem_closure_decomp_mul_mem_fixingSubgroup
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (k₀ : Type) [Field k₀] [NumberField k₀] [Algebra k₀ k] [Algebra k₀ Ω]
    [IsScalarTower k₀ k Ω] [FiniteDimensional k₀ k]
    (N₂ M₀ : IntermediateField k Ω) [FiniteDimensional k N₂] [IsGalois k N₂]
    [FiniteDimensional k M₀] [IsGalois k M₀] (hN : N₂ ≤ M₀)
    (S : Finset (ValuationSubring Ω)) (hS : ∀ A ∈ S, SSGRoute.IsFinPlace k A) :
    ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ N₂.fixingSubgroup →
      ∃ h ∈ Subgroup.closure {τ : Ω ≃ₐ[k] Ω |
          ∃ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B ∧
            (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) ∧
            SSGRoute.IsSplitOverSub k₀ k Ω N₂ B ∧ τ ∈ SSGRoute.decomp k B},
        h * σ⁻¹ ∈ M₀.fixingSubgroup := by
  intro σ hσ
  classical
  haveI hAC : IsAlgClosed Ω := IsAlgClosure.isAlgClosed k
  haveI hAlgk0k : Algebra.IsAlgebraic k₀ k := Algebra.IsAlgebraic.of_finite k₀ k
  haveI hAlg0Ω : Algebra.IsAlgebraic k₀ Ω := Algebra.IsAlgebraic.trans k₀ k Ω
  haveI hAC0 : IsAlgClosure k₀ Ω := ⟨IsAlgClosure.isAlgClosed k, hAlg0Ω⟩
  -- ## the Galois closure `P` of `M₀` over `k₀`
  haveI hSTkkM : IsScalarTower k₀ k ↥M₀ :=
    IsScalarTower.of_algebraMap_eq (fun x => Subtype.ext (IsScalarTower.algebraMap_apply k₀ k Ω x))
  haveI hSTkMΩ : IsScalarTower k₀ ↥M₀ Ω :=
    IsScalarTower.of_algebraMap_eq (fun x => by
      rw [IsScalarTower.algebraMap_apply k₀ k Ω]
      simp [IsScalarTower.algebraMap_apply k₀ k ↥M₀])
  haveI hMfd0 : FiniteDimensional k₀ ↥M₀ := FiniteDimensional.trans k₀ k ↥M₀
  haveI hMalg0 : Algebra.IsAlgebraic k₀ ↥M₀ := Algebra.IsAlgebraic.of_finite k₀ ↥M₀
  let P : IntermediateField k₀ Ω := IntermediateField.normalClosure k₀ ↥M₀ Ω
  haveI hPfd : FiniteDimensional k₀ P := normalClosure.is_finiteDimensional k₀ ↥M₀ Ω
  have hIncP : IsNormalClosure k₀ ↥M₀ P :=
    Algebra.IsAlgebraic.isNormalClosure_normalClosure (fun z => IsAlgClosed.splits _)
  haveI hPN : Normal k₀ P := hIncP.normal
  haveI hPgal : IsGalois k₀ P :=
    isGalois_iff.mpr ⟨Algebra.IsSeparable.of_integral k₀ P, hPN⟩
  haveI hPNF : NumberField ↥P := NumberField.of_module_finite k₀ P
  have hMP : ∀ x : Ω, x ∈ M₀ → x ∈ P := fun x hx =>
    AlgHom.fieldRange_le_normalClosure (IsScalarTower.toAlgHom k₀ ↥M₀ Ω)
      (AlgHom.mem_fieldRange.mpr ⟨⟨x, hx⟩, rfl⟩)
  -- ## the inclusion `M₀ → P` as a `k₀`-algebra structure
  let inclMP : ↥M₀ →+* ↥P :=
    { toFun := fun x => ⟨(x : Ω), hMP x x.2⟩
      map_one' := by ext; rfl
      map_mul' := by intro x y; ext; rfl
      map_zero' := by ext; rfl
      map_add' := by intro x y; ext; rfl }
  letI : Algebra ↥M₀ ↥P := inclMP.toAlgebra
  haveI hST3 : IsScalarTower k₀ ↥M₀ ↥P :=
    IsScalarTower.of_algebraMap_eq (fun x => by ext; rfl)
  -- ## the prescribed element `γ = σ|_{M₀}` and its lift to `P`
  let γ : ↥M₀ ≃ₐ[k] ↥M₀ := (AlgEquiv.restrictNormalHom (F := k) M₀) σ
  let γk : ↥M₀ ≃ₐ[k₀] ↥M₀ := γ.restrictScalars k₀
  obtain ⟨γtilde, hγtilde⟩ : ∃ γtilde : ↥P ≃ₐ[k₀] ↥P,
      ∀ x : ↥M₀, γtilde (algebraMap ↥M₀ ↥P x) = algebraMap ↥M₀ ↥P (γk x) :=
    ⟨AlgEquiv.liftNormal γk ↥P, fun x => AlgEquiv.liftNormal_commutes γk ↥P x⟩
  have hγgor : ∀ z : ↥M₀, (z : Ω) ∈ N₂ → γ z = z := by
    intro z hz
    apply Subtype.ext
    rw [AlgEquiv.restrictNormalHom_apply M₀ σ z]
    exact (IntermediateField.mem_fixingSubgroup_iff N₂ σ).mp hσ (z : Ω) hz
  have hγtilde_fix : ∀ z : ↥M₀, (z : Ω) ∈ N₂ →
      γtilde (algebraMap ↥M₀ ↥P z) = algebraMap ↥M₀ ↥P z := by
    intro z hz
    rw [hγtilde]
    congr 1
    exact hγgor z hz
  -- ## the subgroup of `Gal(P/k₀)` fixing `N₂` pointwise
  let FixN : Subgroup (↥P ≃ₐ[k₀] ↥P) :=
    { carrier := {ρ | ∀ x : ↥P, (x : Ω) ∈ N₂ → ρ x = x}
      one_mem' := fun _ _ => rfl
      mul_mem' := by
        intro ρ σ' hρ hσ' x hx
        show (ρ * σ') x = x
        rw [AlgEquiv.mul_apply, hσ' x hx, hρ x hx]
      inv_mem' := by
        intro ρ hρ x hx
        show ρ.symm x = x
        exact ρ.symm_apply_eq.mpr (hρ x hx).symm }
  have hγtildeFixN : γtilde ∈ FixN := by
    intro x hx
    have hxM : (x : Ω) ∈ M₀ := hN hx
    have hxeq : x = algebraMap ↥M₀ ↥P (⟨(x : Ω), hxM⟩ : ↥M₀) := by
      apply Subtype.ext
      rfl
    rw [hxeq, hγtilde_fix ⟨(x : Ω), hxM⟩ hx]
  have hzp_le : Subgroup.zpowers γtilde ≤ FixN := Subgroup.zpowers_le.mpr hγtildeFixN
  -- ## Čebotarev
  have hS0 : ∀ A ∈ S, SSGRoute.IsFinPlace k₀ A := fun A hA =>
    isFinPlace_subbase k Ω k₀ A (hS A hA)
  have hAS0 : ∀ A ∈ S, A.comap (algebraMap k₀ Ω) ≠ ⊤ := fun A hA => by
    simpa [SSGRoute.IsFinPlace] using hS0 A hA
  let primeOfA : {A : ValuationSubring Ω // A ∈ S} → NK.Chebotarev.PrimeIdeal k₀ := fun A =>
    Classical.choose (exists_primeIdeal_comap_eq (k₀ := k₀) (Ω := Ω) A.1 (hAS0 A.1 A.2))
  have hprimeOfA_spec : ∀ A : {A : ValuationSubring Ω // A ∈ S},
      A.1.comap (algebraMap k₀ Ω) =
        IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k₀ (primeOfA A) :=
    fun A => Classical.choose_spec
      (exists_primeIdeal_comap_eq (k₀ := k₀) (Ω := Ω) A.1 (hAS0 A.1 A.2))
  let T : Finset (NK.Chebotarev.PrimeIdeal k₀) := S.attach.image primeOfA
  obtain ⟨p, hpT, hpunram, hpFrob⟩ :=
    exists_frobAtPrime_avoid_unramified (K := k₀) (N := ↥P) γtilde T
  obtain ⟨𝔓, h𝔓lies, h𝔓frob⟩ := hpFrob
  have h𝔓ram : 𝔓.asIdeal.ramificationIdx (NumberField.RingOfIntegers k₀) = 1 :=
    hpunram 𝔓 h𝔓lies
  have hdecomp : Submission.NeukirchUchida.Local.decompositionSubgroup (K := k₀) 𝔓 =
      Subgroup.zpowers γtilde :=
    NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt 𝔓 γtilde h𝔓ram h𝔓frob
  have hstab : MulAction.stabilizer (↥P ≃ₐ[k₀] ↥P) (NK.GlobalCFT.Place.ofFinite 𝔓) =
      Subgroup.zpowers γtilde := by
    rw [stabilizer_ofFinite_eq_decompositionSubgroup (K := k₀) (L := ↥P) 𝔓, hdecomp]
  -- ## the place `B` of `Ω` over `𝔓`
  obtain ⟨B, hBcomap, hBfin0⟩ := exists_isFinPlace_comap_eq (k := k₀) (Ω := Ω) P 𝔓
  have hBfin : SSGRoute.IsFinPlace k B := by
    rw [SSGRoute.IsFinPlace] at hBfin0 ⊢
    intro h
    apply hBfin0
    rw [IsScalarTower.algebraMap_eq k₀ k Ω, ← ValuationSubring.comap_comap, h]
    ext x
    simp [ValuationSubring.mem_comap]
  have hp_eq : p = 𝔓.under (NumberField.RingOfIntegers k₀) :=
    IsDedekindDomain.HeightOneSpectrum.ext (by
      rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
      exact h𝔓lies.over)
  have hBp : B.comap (algebraMap k₀ Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k₀ p := by
    rw [hp_eq, IsScalarTower.algebraMap_eq k₀ ↥P Ω, ← ValuationSubring.comap_comap, hBcomap]
    exact Commons.RingTheory.Valuation.comap_valuationSubringAtPrime (K := k₀) (L := ↥P)
      (𝔓.under (NumberField.RingOfIntegers k₀)) 𝔓
      (by rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]; infer_instance)
  -- ## `B` is completely decomposed in `N₂` over `k₀`
  have hBsplit : SSGRoute.IsSplitOverSub k₀ k Ω N₂ B := by
    intro σ' hσ' x hx
    have hle1 : (SSGRoute.decomp k₀ B).map (SSGRoute.res k₀ P) ≤
        MulAction.stabilizer (↥P ≃ₐ[k₀] ↥P) (NK.GlobalCFT.Place.ofFinite 𝔓) :=
      decomp_map_le_stabilizer_of_comap_eq k₀ Ω P 𝔓 B hBfin0 hBcomap
    have hle2 : (SSGRoute.decomp k₀ B).map (SSGRoute.res k₀ P) ≤ FixN :=
      le_trans hle1 (hstab.symm ▸ hzp_le)
    have hmem : SSGRoute.res k₀ P σ' ∈ FixN := hle2 ⟨σ', hσ', rfl⟩
    have hxP : x ∈ P := hMP x (hN hx)
    have hfix := hmem ⟨x, hxP⟩ hx
    calc σ' x = (AlgEquiv.restrictNormalHom P σ' ⟨x, hxP⟩ : Ω) :=
          (AlgEquiv.restrictNormalHom_apply P σ' ⟨x, hxP⟩).symm
      _ = x := by rw [hfix]
  -- ## `B` avoids `S`
  have hBavoid : ∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B := by
    intro A hA hconj
    obtain ⟨g, hg⟩ := hconj
    have hcomap : A.comap (algebraMap k Ω) = B.comap (algebraMap k Ω) := by
      rw [← hg, comap_algebraMap_smul]
    have hcomap0 : A.comap (algebraMap k₀ Ω) = B.comap (algebraMap k₀ Ω) := by
      have e1 : A.comap (algebraMap k₀ Ω) =
          (A.comap (algebraMap k Ω)).comap (algebraMap k₀ k) := by
        rw [IsScalarTower.algebraMap_eq k₀ k Ω, ← ValuationSubring.comap_comap]
      have e2 : B.comap (algebraMap k₀ Ω) =
          (B.comap (algebraMap k Ω)).comap (algebraMap k₀ k) := by
        rw [IsScalarTower.algebraMap_eq k₀ k Ω, ← ValuationSubring.comap_comap]
      rw [e1, e2, hcomap]
    rw [hprimeOfA_spec ⟨A, hA⟩, hBp] at hcomap0
    have hkey : primeOfA ⟨A, hA⟩ = p :=
      Commons.RingTheory.Valuation.valuationSubringAtPrime_injective hcomap0
    have hmem : primeOfA ⟨A, hA⟩ ∈ T :=
      Finset.mem_image.mpr ⟨⟨A, hA⟩, Finset.mem_attach S ⟨A, hA⟩, rfl⟩
    exact hpT (hkey ▸ hmem)
  -- ## the element `τ ∈ D_B` realising `γtilde`
  have hstab2 : Subgroup.zpowers γtilde ≤ (SSGRoute.decomp k₀ B).map (SSGRoute.res k₀ P) := by
    rw [← hstab]
    exact stabilizer_le_decomp_map_of_comap_eq k₀ Ω P 𝔓 B hBfin0 hBcomap
  have hγtilde_mem : γtilde ∈ (SSGRoute.decomp k₀ B).map (SSGRoute.res k₀ P) :=
    hstab2 (Subgroup.mem_zpowers γtilde)
  obtain ⟨τ, hτdecomp, hτres⟩ := Subgroup.mem_map.mp hγtilde_mem
  -- ## `τ` fixes `k`, so it is an element of `G_k`
  have hτfixk : ∀ c : k, τ (algebraMap k Ω c) = algebraMap k Ω c := by
    intro c
    have hcM : algebraMap k Ω c ∈ M₀ := M₀.algebraMap_mem c
    have hcN : algebraMap k Ω c ∈ N₂ := N₂.algebraMap_mem c
    calc τ (algebraMap k Ω c)
        = (AlgEquiv.restrictNormalHom P τ ⟨algebraMap k Ω c, hMP _ hcM⟩ : Ω) :=
          (AlgEquiv.restrictNormalHom_apply P τ ⟨algebraMap k Ω c, hMP _ hcM⟩).symm
      _ = (γtilde ⟨algebraMap k Ω c, hMP _ hcM⟩ : Ω) := by rw [hτres]
      _ = (γtilde (algebraMap ↥M₀ ↥P (⟨algebraMap k Ω c, hcM⟩ : ↥M₀)) : Ω) := by rfl
      _ = (algebraMap ↥M₀ ↥P (γk ⟨algebraMap k Ω c, hcM⟩) : Ω) := by rw [hγtilde]
      _ = (γ ⟨algebraMap k Ω c, hcM⟩ : Ω) := rfl
      _ = algebraMap k Ω c := by
            rw [hγgor ⟨algebraMap k Ω c, hcM⟩ hcN]
  let τk : Ω ≃ₐ[k] Ω :=
    { τ.toRingEquiv with commutes' := fun c => hτfixk c }
  have hτk_decomp : τk ∈ SSGRoute.decomp k B := by
    rw [SSGRoute.decomp, MulAction.mem_stabilizer_iff]
    have h : τk • B = τ • B := rfl
    rw [h, MulAction.mem_stabilizer_iff.mp hτdecomp]
  -- ## `τk` agrees with `σ` on `M₀`
  have hres_eq : AlgEquiv.restrictNormalHom M₀ τk = AlgEquiv.restrictNormalHom M₀ σ := by
    ext x
    rw [AlgEquiv.restrictNormalHom_apply M₀ τk x, AlgEquiv.restrictNormalHom_apply M₀ σ x]
    show τ (x : Ω) = σ (x : Ω)
    calc τ (x : Ω)
        = (AlgEquiv.restrictNormalHom P τ ⟨(x : Ω), hMP _ x.2⟩ : Ω) :=
          (AlgEquiv.restrictNormalHom_apply P τ ⟨(x : Ω), hMP _ x.2⟩).symm
      _ = (γtilde ⟨(x : Ω), hMP _ x.2⟩ : Ω) := by rw [hτres]
      _ = (γtilde (algebraMap ↥M₀ ↥P x) : Ω) := by rfl
      _ = (algebraMap ↥M₀ ↥P (γk x) : Ω) := by rw [hγtilde]
      _ = (γ x : Ω) := rfl
      _ = σ (x : Ω) := AlgEquiv.restrictNormalHom_apply M₀ σ x
  -- ## conclusion
  refine ⟨τk, Subgroup.subset_closure ⟨B, hBfin, hBavoid, hBsplit, hτk_decomp⟩, ?_⟩
  have hker : (τk * σ⁻¹) ∈ (AlgEquiv.restrictNormalHom M₀).ker := by
    rw [MonoidHom.mem_ker, map_mul, hres_eq, map_inv, mul_inv_cancel]
  rwa [IntermediateField.restrictNormalHom_ker M₀] at hker

end Work.SSGRoute
