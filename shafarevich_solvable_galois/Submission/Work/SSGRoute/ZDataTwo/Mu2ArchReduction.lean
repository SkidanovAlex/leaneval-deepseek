/-!
# Reduction of `mu2LocalTateSystemWithArch` to a family of local forms

The predicate `Work.SSGRoute.ZDataTwo.IsMu2LocalTateSystemWithArch` asks for a family of local
pairings `pair H a b` of `𝔽₂`-valued cochains, satisfying at every local group `H` of the two kinds
that occur (the decomposition group of a finite place, or the group generated by an involution):

* additivity in each variable on locally constant cocycles;
* vanishing when an argument is a coboundary;
* perfectness in each variable;

and, globally, the archimedean-corrected reciprocity.

This file performs the *formal* half of the construction, which is independent of arithmetic:

* the action of `Gal(K/k)` on `ZMod 2` is trivial, so that the cocycle condition on `H` is plain
  additivity and the coboundary condition is "vanishes on `H`";
* consequently, given *any* family `Φ H` of `𝔽₂`-bilinear forms on the local cohomology groups
  `H1loc 2 k Ω K (ZMod 2) H` that is non-degenerate in the first variable at every local group, the
  descended family `pair H a b := Φ H (toClass a) (toClass b)` satisfies all five local clauses
  (the descent is `toClass_add`, `toClass_eq_zero_iff`, `toClass_surjective`);
* the reciprocity clause for `pair` is exactly the reciprocity clause for `Φ` evaluated on the
  classes of the global cocycles.

Hence the theorem follows from the existence of the family `Φ` together with its reciprocity
identity; the arithmetic content is isolated in that input.
-/

namespace Work.SSGRoute.ZDataTwo

open _root_.SSGRoute
open scoped Pointwise

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

variable (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  [DistribMulAction (K ≃ₐ[k] K) (ZMod 2)] [SMulCommClass (K ≃ₐ[k] K) (ZMod 2) (ZMod 2)]

/-- **The action of `Gal(K/k)` on `ZMod 2` is trivial.**  The action map `m ↦ g • m` is an additive
bijection of the two-element group `ZMod 2`, hence the identity. -/
lemma smul_zmodTwo_eq_self (g : K ≃ₐ[k] K) (m : ZMod 2) : g • m = m := by
  have hinj : Function.Injective (fun x : ZMod 2 => g • x) := fun a b h => by
    have h' := congrArg (fun y : ZMod 2 => g⁻¹ • y) h
    simpa using h'
  fin_cases m
  · exact smul_zero g
  · by_contra h
    have hz : g • (1 : ZMod 2) = 0 := by
      have h2 : ∀ x : ZMod 2, x = 0 ∨ x = 1 := by
        intro x
        fin_cases x
        · exact Or.inl rfl
        · exact Or.inr rfl
      rcases h2 (g • (1 : ZMod 2)) with h' | h'
      · exact h'
      · exact absurd h' h
    have h3 : (1 : ZMod 2) = 0 := by
      have h4 : g⁻¹ • (g • (1 : ZMod 2)) = 1 := by rw [inv_smul_smul]
      rw [hz, smul_zero] at h4
      exact h4.symm
    exact one_ne_zero h3

/-- With trivial coefficients, the cocycle condition on `H` is additivity on `H`. -/
lemma isCocycleOn_iff_add (H : Subgroup (Ω ≃ₐ[k] Ω)) (f : (Ω ≃ₐ[k] Ω) → ZMod 2) :
    IsCocycleOn (res k K) H f ↔ ∀ g ∈ H, ∀ h ∈ H, f (g * h) = f g + f h := by
  constructor
  · intro hf g hg h hh
    rw [hf g hg h hh, smul_zmodTwo_eq_self]
  · intro hf g hg h hh
    rw [hf g hg h hh, smul_zmodTwo_eq_self]

/-- With trivial coefficients, the coboundary condition on `H` is vanishing on `H`. -/
lemma isCoboundaryOn_iff_eq_zero (H : Subgroup (Ω ≃ₐ[k] Ω)) (f : (Ω ≃ₐ[k] Ω) → ZMod 2) :
    IsCoboundaryOn (res k K) H f ↔ ∀ g ∈ H, f g = 0 := by
  constructor
  · rintro ⟨m, hm⟩ g hg
    rw [hm g hg, smul_zmodTwo_eq_self, sub_self]
  · intro hf
    exact ⟨0, fun g hg => by rw [hf g hg, smul_zero, sub_zero]⟩

/-- The local groups of the `μ₂` local Tate system: the decomposition group of a finite place, or
the group generated by an involution. -/
def IsLocalGroupMu2 (H : Subgroup (Ω ≃ₐ[k] Ω)) : Prop :=
  (∃ A : ValuationSubring Ω, IsFinPlace k A ∧ H = decomp k A) ∨
    (∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)

/-- **The local clauses from a family of non-degenerate forms.**  If `Φ H` is an `𝔽₂`-bilinear form
on the local cohomology `H1loc 2 k Ω K (ZMod 2) H`, non-degenerate in the first variable at every
local group, then the descended pairing `pair H a b := Φ H (toClass a) (toClass b)` satisfies the
five local clauses of `IsMu2LocalTateSystemWithArch` at every local group. -/
lemma localClauses_of_forms
    (Φ : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
      H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] (H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] ZMod 2))
    (hnd : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroupMu2 k Ω H →
      (∀ x : H1loc 2 k Ω K (ZMod 2) H, (∀ y, Φ H x y = 0) → x = 0) ∧
      (∀ y : H1loc 2 k Ω K (ZMod 2) H, (∀ x, Φ H x y = 0) → y = 0))
    (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : IsLocalGroupMu2 k Ω H) :
    (∀ (a a' b : (Ω ≃ₐ[k] Ω) → ZMod 2),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H a' ∧ IsLocConstOn H a') →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      Φ H (toClass 2 k Ω K (ZMod 2) H (a + a')) (toClass 2 k Ω K (ZMod 2) H b) =
        Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b) +
          Φ H (toClass 2 k Ω K (ZMod 2) H a') (toClass 2 k Ω K (ZMod 2) H b)) ∧
    (∀ (a b b' : (Ω ≃ₐ[k] Ω) → ZMod 2),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      (IsCocycleOn (res k K) H b' ∧ IsLocConstOn H b') →
      Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H (b + b')) =
        Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b) +
          Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b')) ∧
    (∀ (a b : (Ω ≃ₐ[k] Ω) → ZMod 2),
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      (IsCoboundaryOn (res k K) H a ∨ IsCoboundaryOn (res k K) H b) →
      Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b) = 0) ∧
    (∀ a : (Ω ≃ₐ[k] Ω) → ZMod 2,
      (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
      (∀ b : (Ω ≃ₐ[k] Ω) → ZMod 2,
        (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
        Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b) = 0) →
      IsCoboundaryOn (res k K) H a) ∧
    (∀ b : (Ω ≃ₐ[k] Ω) → ZMod 2,
      (IsCocycleOn (res k K) H b ∧ IsLocConstOn H b) →
      (∀ a : (Ω ≃ₐ[k] Ω) → ZMod 2,
        (IsCocycleOn (res k K) H a ∧ IsLocConstOn H a) →
        Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b) = 0) →
      IsCoboundaryOn (res k K) H b) := by
  have hmem : ∀ (f : (Ω ≃ₐ[k] Ω) → ZMod 2),
      (IsCocycleOn (res k K) H f ∧ IsLocConstOn H f) →
      f ∈ lcCocycles 2 k Ω K (ZMod 2) H :=
    fun f hf => (mem_lcCocycles 2 k Ω K (ZMod 2) H f).mpr hf
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro a a' b ha ha' _
    rw [toClass_add 2 k Ω K (ZMod 2) H (hmem a ha) (hmem a' ha'), map_add, LinearMap.add_apply]
  · intro a b b' _ hb hb'
    rw [toClass_add 2 k Ω K (ZMod 2) H (hmem b hb) (hmem b' hb'), map_add]
  · intro a b ha hb hcob
    rcases hcob with h | h
    · rw [show toClass 2 k Ω K (ZMod 2) H a = 0 from
          (toClass_eq_zero_iff 2 k Ω K (ZMod 2) H (hmem a ha)).mpr
            ((mem_coboundaries 2 k Ω K (ZMod 2) H a).mpr h), map_zero, LinearMap.zero_apply]
    · rw [show toClass 2 k Ω K (ZMod 2) H b = 0 from
          (toClass_eq_zero_iff 2 k Ω K (ZMod 2) H (hmem b hb)).mpr
            ((mem_coboundaries 2 k Ω K (ZMod 2) H b).mpr h), map_zero]
  · intro a ha hall
    have hzero : ∀ y : H1loc 2 k Ω K (ZMod 2) H,
        Φ H (toClass 2 k Ω K (ZMod 2) H a) y = 0 := by
      intro y
      obtain ⟨g, hg, hgy⟩ := toClass_surjective 2 k Ω K (ZMod 2) H y
      have h0 := hall g ((mem_lcCocycles 2 k Ω K (ZMod 2) H g).mp hg)
      rw [← hgy]
      exact h0
    have hx : toClass 2 k Ω K (ZMod 2) H a = 0 := (hnd H hH).1 _ hzero
    exact (mem_coboundaries 2 k Ω K (ZMod 2) H a).mp
      ((toClass_eq_zero_iff 2 k Ω K (ZMod 2) H (hmem a ha)).mp hx)
  · intro b hb hall
    have hzero : ∀ x : H1loc 2 k Ω K (ZMod 2) H,
        Φ H x (toClass 2 k Ω K (ZMod 2) H b) = 0 := by
      intro x
      obtain ⟨g, hg, hgy⟩ := toClass_surjective 2 k Ω K (ZMod 2) H x
      have h0 := hall g ((mem_lcCocycles 2 k Ω K (ZMod 2) H g).mp hg)
      rw [← hgy]
      exact h0
    have hx : toClass 2 k Ω K (ZMod 2) H b = 0 := (hnd H hH).2 _ hzero
    exact (mem_coboundaries 2 k Ω K (ZMod 2) H b).mp
      ((toClass_eq_zero_iff 2 k Ω K (ZMod 2) H (hmem b hb)).mp hx)

/-- **The reduction.**  Given a family `Φ` of `𝔽₂`-bilinear forms on the local cohomology groups,
non-degenerate at every local group, and satisfying the archimedean-corrected reciprocity identity
on the classes of global locally constant cocycles, the `μ₂` local Tate system with archimedean
terms exists. -/
theorem mu2LocalTateSystemWithArch_of_forms
    (Φ : ∀ H : Subgroup (Ω ≃ₐ[k] Ω),
      H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] (H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] ZMod 2))
    (hnd : ∀ H : Subgroup (Ω ≃ₐ[k] Ω), IsLocalGroupMu2 k Ω H →
      (∀ x : H1loc 2 k Ω K (ZMod 2) H, (∀ y, Φ H x y = 0) → x = 0) ∧
      (∀ y : H1loc 2 k Ω K (ZMod 2) H, (∀ x, Φ H x y = 0) → y = 0))
    (hrec : ∀ (a b : (Ω ≃ₐ[k] Ω) → ZMod 2),
      IsCocycleOn (res k K) ⊤ a → IsLocConstOn ⊤ a →
      IsCocycleOn (res k K) ⊤ b → IsLocConstOn ⊤ b →
      ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', IsFinPlace k A) →
      (∀ A ∈ S', ∀ B ∈ S', IsConjPlace k A B → A = B) →
      (∀ B : ValuationSubring Ω, IsFinPlace k B →
        (∀ A ∈ S', ¬ IsConjPlace k A B) →
        ¬ B.valuation (2 : Ω) < 1 ∧ ¬ IsRamifiedIn k K B ∧
          ∀ σ : Ω ≃ₐ[k] Ω, IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
      ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
      (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 →
        ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
      (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
      (∑ A ∈ S', Φ (decomp k A) (toClass 2 k Ω K (ZMod 2) (decomp k A) a)
          (toClass 2 k Ω K (ZMod 2) (decomp k A) b)) +
        (∑ c ∈ C', Φ (Subgroup.zpowers c) (toClass 2 k Ω K (ZMod 2) (Subgroup.zpowers c) a)
          (toClass 2 k Ω K (ZMod 2) (Subgroup.zpowers c) b)) = 0) :
    ∃ pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → ZMod 2) →
        ((Ω ≃ₐ[k] Ω) → ZMod 2) → ZMod 2,
      IsMu2LocalTateSystemWithArch k Ω K pair := by
  refine ⟨fun H a b => Φ H (toClass 2 k Ω K (ZMod 2) H a) (toClass 2 k Ω K (ZMod 2) H b),
    ?_, ?_⟩
  · intro H hH
    exact localClauses_of_forms k Ω K Φ hnd H hH
  · intro a b ha1 ha2 hb1 hb2 S' hS' hconj hout C' hC'inv hC'rep hC'disj
    exact hrec a b ha1 ha2 hb1 hb2 S' hS' hconj hout C' hC'inv hC'rep hC'disj

end Work.SSGRoute.ZDataTwo
