/-! ## Two elementary Kummer-field facts

The Kummer field `L = k(√α)` of `α ∈ kˣ` is the intermediate field generated by a chosen square
root of `α` (a definition in `Mu2FiniteForm`), so the fixing subgroup of `σ` in `Gal(Ω/k)` is
exactly the stabiliser of that root; and a `ℤᵐ⁰`-valued valuation of a field detects "the value of
`b` is the square of a value of a unit" by the parity of the logarithm of the value. -/

/-- **The fixing subgroup of the Kummer field is the stabiliser of the chosen square root.** -/
lemma mem_fixingSubgroup_kummerField_iff (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    [IsAlgClosed Ω]
    (α : kˣ) (σ : Ω ≃ₐ[k] Ω) :
    σ ∈ (kummerField k Ω α).fixingSubgroup ↔
      σ ((Work.SSGRoute.kummerSqrt (K := k) (Ω := Ω) α : Ωˣ) : Ω) =
        ((Work.SSGRoute.kummerSqrt (K := k) (Ω := Ω) α : Ωˣ) : Ω) := by
  constructor
  · intro h
    exact (IntermediateField.mem_fixingSubgroup_iff (kummerField k Ω α) σ).mp h _
      (IntermediateField.mem_adjoin_simple_self k _)
  · intro h
    exact mem_fixingSubgroup_adjoin_simple _ σ h

/-- **A `ℤᵐ⁰`-valued surjective valuation detects squares in the value group by the parity of the
logarithm.** -/
lemma exists_sq_val_iff_even_neg_log {K : Type*} [Field K]
    (v : Valuation K (WithZero (Multiplicative ℤ))) (hv : Function.Surjective v) (b : Kˣ) :
    (∃ d : Kˣ, v (b : K) = (v (d : K)) ^ 2) ↔ Even (-(v (b : K)).log) := by
  constructor
  · rintro ⟨d, hd⟩
    refine ⟨-(v (d : K)).log, ?_⟩
    have hlog : (v (b : K)).log = 2 * (v (d : K)).log := by
      rw [hd, WithZero.log_pow]
      simp
    rw [hlog]
    ring
  · rintro ⟨k, hk⟩
    obtain ⟨y, hy⟩ := hv (WithZero.exp (-k))
    have hy0 : y ≠ 0 := (Valuation.ne_zero_iff v).mp (by rw [hy]; simp)
    refine ⟨Units.mk0 y hy0, ?_⟩
    have hb0 : v (b : K) ≠ 0 := (Valuation.ne_zero_iff v).mpr (Units.ne_zero b)
    have h1 : v (b : K) = WithZero.exp (-(2 * k)) := by
      rw [← WithZero.exp_log hb0]
      congr 1
      omega
    have h2 : (v (y : K)) ^ 2 = WithZero.exp (-(2 * k)) := by
      rw [hy, ← WithZero.exp_nsmul]
      congr 1
      simp
    rw [Units.val_mk0]
    exact h1.trans h2.symm

/-! ## The level prime below `B` -/

/-- **The prime of a finite level below `B` lies over the prime `Q` of `k` below `B`.** -/
lemma levelPrime_liesOver_of_comap_eq (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω]
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hQ : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k Q)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [Normal k L] [NumberField ↥L] :
    (Work.SSGRoute.levelPrime k Ω B hB L).asIdeal.LiesOver Q.asIdeal := by
  haveI : IsSepClosure k Ω := IsSepClosure.of_isAlgClosure_of_perfectField k Ω
  have h1 := NK.ResidueFrob.primeOfLevel_liesOver (K := k) (K' := Ω) ⟨B, hB⟩ L
  have h2 : Submission.NeukirchUchida.primeOf B hB = Q :=
    Commons.RingTheory.Valuation.valuationSubringAtPrime_injective
      (R := NumberField.RingOfIntegers k) (K := k)
      (by rw [← Submission.NeukirchUchida.primeOf_spec B hB, hQ])
  rw [h2] at h1
  exact h1

/-! ## The quadratic Kummer field `k(√α)` -/

/-- **The Kummer field `k(√α)` of a non-square is quadratic Galois, with an explicit witness.** -/
theorem kummerFieldQuadraticStructure (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω] (α : kˣ)
    (hnsq : ∀ d : k, d * d ≠ (α : k)) :
    IsGalois k ↥(kummerField k Ω α) ∧
      Nat.card (↥(kummerField k Ω α) ≃ₐ[k] ↥(kummerField k Ω α)) = 2 ∧
      ∃ y : ↥(kummerField k Ω α),
        y * y = algebraMap k ↥(kummerField k Ω α) (α : k) ∧
        y ∉ Set.range (algebraMap k ↥(kummerField k Ω α)) := by
  set y : Ω := ((Work.SSGRoute.kummerSqrt (K := k) (Ω := Ω) α : Ωˣ) : Ω) with hydef
  have hroot : y ^ 2 = algebraMap k Ω (α : k) := by
    rw [hydef, ← Units.val_pow_eq_pow_val, Work.SSGRoute.kummerSqrt_pow, Units.coe_map]
    rfl
  have hroot_mul : y * y = algebraMap k Ω (α : k) := by rw [← pow_two]; exact hroot
  have hfield : kummerField k Ω α = k⟮y⟯ := by rw [hydef]; rfl
  have hint : IsIntegral k y :=
    IsIntegral.of_pow (n := 2) (by norm_num)
      (by rw [hroot]; exact isIntegral_algebraMap)
  have hy_notin_bot : y ∉ (⊥ : IntermediateField k Ω) := by
    intro hmem
    obtain ⟨d, hd⟩ := IntermediateField.mem_bot.mp hmem
    refine hnsq d ?_
    have h2 : algebraMap k Ω (d * d) = algebraMap k Ω (α : k) := by
      rw [map_mul, hd, ← pow_two, hroot]
    exact (algebraMap k Ω).injective h2
  have hle2 : Module.finrank k ↥(kummerField k Ω α) ≤ 2 := by
    rw [hfield]
    exact (NK.NUV2.LC.adjoinSq_normal_finrank_le (K := k) (L := Ω) y (α : k) hroot_mul).2.2
  have hnormal : Normal k ↥(kummerField k Ω α) := by
    rw [hfield]
    exact (NK.NUV2.LC.adjoinSq_normal_finrank_le (K := k) (L := Ω) y (α : k) hroot_mul).1
  have hne0 : (minpoly k y).natDegree ≠ 0 := by
    intro h0
    have hf1 : minpoly k y = 1 := by
      rw [Polynomial.eq_C_of_natDegree_eq_zero h0]
      have hc1 : (minpoly k y).coeff 0 = 1 := by
        rw [← h0, Polynomial.coeff_natDegree, (minpoly.monic hint).leadingCoeff]
      rw [hc1, map_one]
    have hae := minpoly.aeval k y
    rw [hf1] at hae
    simpa using hae
  have hne1 : (minpoly k y).natDegree ≠ 1 := by
    intro h1
    obtain ⟨a, ha0, b, hfab⟩ := Polynomial.natDegree_eq_one.mp h1
    have hrel : algebraMap k Ω a * y + algebraMap k Ω b = 0 := by
      have hae := minpoly.aeval k y
      rw [← hfab] at hae
      simpa using hae
    have ha0' : algebraMap k Ω a ≠ 0 := fun h0 =>
      ha0 ((algebraMap k Ω).injective (by rw [h0, map_zero]))
    have hy_eq : y = (-algebraMap k Ω b) * (algebraMap k Ω a)⁻¹ := by
      have h2 : algebraMap k Ω a * y = -algebraMap k Ω b := by
        rw [add_eq_zero_iff_eq_neg] at hrel
        exact hrel
      calc y = (algebraMap k Ω a)⁻¹ * (algebraMap k Ω a * y) := by
            rw [← mul_assoc, inv_mul_cancel₀ ha0', one_mul]
        _ = (algebraMap k Ω a)⁻¹ * (-algebraMap k Ω b) := by rw [h2]
        _ = (-algebraMap k Ω b) * (algebraMap k Ω a)⁻¹ := by ring
    refine hy_notin_bot (IntermediateField.mem_bot.mpr ⟨(-b) * a⁻¹, ?_⟩)
    rw [map_mul, map_neg, map_inv₀]
    exact hy_eq.symm
  have hnat : (minpoly k y).natDegree = 2 := by
    have hdiv : minpoly k y ∣ (X ^ 2 - C (α : k) : k[X]) := by
      refine minpoly.dvd k y ?_
      rw [map_sub, map_pow, aeval_X, aeval_C, hroot, sub_self]
    have hq : (X ^ 2 - C (α : k) : k[X]) ≠ 0 :=
      Polynomial.X_pow_sub_C_ne_zero (by norm_num) (α : k)
    have hle : (minpoly k y).natDegree ≤ 2 :=
      calc (minpoly k y).natDegree ≤ (X ^ 2 - C (α : k) : k[X]).natDegree :=
            Polynomial.natDegree_le_of_dvd hdiv hq
        _ = 2 := Polynomial.natDegree_X_pow_sub_C (n := 2) (r := (α : k))
    omega
  have hfinrank : Module.finrank k ↥(kummerField k Ω α) = 2 := by
    have hfr : Module.finrank k ↥(kummerField k Ω α) =
        (minpoly k y).natDegree := by
      rw [hfield]
      exact IntermediateField.adjoin.finrank hint
    rw [hfr, hnat]
  have hgal : IsGalois k ↥(kummerField k Ω α) := isGalois_iff.mpr ⟨inferInstance, hnormal⟩
  haveI : IsGalois k ↥(kummerField k Ω α) := hgal
  refine ⟨hgal, ?_, ?_⟩
  · rw [IsGalois.card_aut_eq_finrank k ↥(kummerField k Ω α)]
    exact hfinrank
  · refine ⟨⟨y, ?_⟩, ?_, ?_⟩
    · rw [hfield]
      exact IntermediateField.mem_adjoin_simple_self k y
    · refine Subtype.ext ?_
      rw [IntermediateField.coe_algebraMap_apply]
      change y * y = algebraMap k Ω (α : k)
      exact hroot_mul
    · rintro ⟨d, hd⟩
      refine hnsq d ?_
      have hdy : y = algebraMap k Ω d := by
        have h := congrArg (fun z : ↥(kummerField k Ω α) => (z : Ω)) hd
        simpa using h.symm
      have hd2 : algebraMap k Ω (d * d) = algebraMap k Ω (α : k) := by
        rw [map_mul, ← hdy, ← pow_two, hroot]
      exact (algebraMap k Ω).injective hd2

/-! ## The arithmetic of the excluded places

Two facts about the Kummer character of `b ∈ kˣ` at a finite place `B` with `B ∤ 2`: killing the
inertia forces the `Q`-adic valuation of `b` to be a square in the value group (equivalently, even),
and it makes the quadratic Kummer extension `k(√α)` unramified at `Q`.  Both are proved through the
Galois-theoretic description of the ramification index of the level prime below `B`. -/

/-- **A Kummer character killing the inertia forces an even valuation.** -/
theorem existsValSqOfKillsInertiaPrime (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω] (B : ValuationSubring Ω)
    (hB : SSGRoute.IsFinPlace k B) (h2B : ¬ B.valuation (2 : Ω) < 1)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hQ : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k Q)
    (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (b : kˣ)
    (h : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ →
      Work.SSGRoute.kummerChar (K := k) (Ω := Ω) ζ hζ b σ = 0) :
    ∃ d : kˣ, Q.valuation k (b : k) = (Q.valuation k (d : k)) ^ 2 := by
  classical
  by_contra hcon
  have hv : Function.Surjective (Q.valuation k) :=
    IsDedekindDomain.HeightOneSpectrum.valuation_surjective k Q
  have hodd : Odd (-(Q.valuation k (b : k)).log) := by
    rw [← Int.not_even_iff_odd]
    intro hev
    exact hcon ((exists_sq_val_iff_even_neg_log (Q.valuation k) hv b).mpr hev)
  have hnsq : ∀ d : k, d * d ≠ (b : k) := by
    intro d hd
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact b.ne_zero (by simpa using hd.symm)
    exact hcon ⟨Units.mk0 d hd0, by
      rw [Units.val_mk0, ← map_pow, pow_two, hd]⟩
  obtain ⟨hgal, hcard, hy⟩ := kummerFieldQuadraticStructure k Ω b hnsq
  haveI : NumberField ↥(kummerField k Ω b) :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField _
  haveI : IsGalois k ↥(kummerField k Ω b) := hgal
  haveI : Normal k ↥(kummerField k Ω b) := hgal.to_normal
  set P : IsDedekindDomain.HeightOneSpectrum
      (NumberField.RingOfIntegers ↥(kummerField k Ω b)) :=
    Work.SSGRoute.levelPrime k Ω B hB (kummerField k Ω b) with hP
  haveI hLies : P.asIdeal.LiesOver Q.asIdeal :=
    levelPrime_liesOver_of_comap_eq k Ω B hB Q hQ _
  have hβmem : ((Work.SSGRoute.kummerSqrt (K := k) (Ω := Ω) b : Ωˣ) : Ω) ∈
      kummerField k Ω b :=
    IntermediateField.mem_adjoin_simple_self k _
  set β : ↥(kummerField k Ω b) :=
    ⟨((Work.SSGRoute.kummerSqrt (K := k) (Ω := Ω) b : Ωˣ) : Ω), hβmem⟩ with hβdef
  have hβ : β ^ 2 = algebraMap k ↥(kummerField k Ω b) (b : k) := by
    refine Subtype.ext ?_
    rw [SubmonoidClass.coe_pow, hβdef, IntermediateField.coe_algebraMap_apply]
    rw [← Units.val_pow_eq_pow_val, Work.SSGRoute.kummerSqrt_pow, Units.coe_map]
    rfl
  have h2dvd : 2 ∣ P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) :=
    Work.SSGRoute.ZDataTwo.two_dvd_ramificationIdx_of_odd_valuation k
      ↥(kummerField k Ω b) b β hβ Q P hodd
  have hne1 : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1 := by
    intro h1
    rw [h1] at h2dvd
    norm_num at h2dvd
  have hram : SSGRoute.IsRamifiedIn k (kummerField k Ω b) B := by
    by_contra hnr
    exact hne1 (ramificationIdx_levelPrime_eq_one_of_not_isRamifiedIn k Ω _ B hB hnr)
  obtain ⟨σ, hσI, hσnf⟩ := hram
  refine hσnf ((mem_fixingSubgroup_kummerField_iff k Ω b σ).mpr ?_)
  exact (Work.SSGRoute.kummerChar_eq_zero_iff_apply_sqrt ζ hζ b σ).mp (h σ hσI)

/-- **A Kummer character killing the inertia makes the quadratic Kummer extension unramified at
the prime below.** -/
theorem existsUnramifiedPrimeOfKillsInertia (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hQ : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k Q)
    (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (α : kˣ) (hnsq : ∀ d : k, d * d ≠ (α : k))
    (ha : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ →
      Work.SSGRoute.kummerChar (K := k) (Ω := Ω) ζ hζ α σ = 0) :
    ∃ q : IsDedekindDomain.HeightOneSpectrum
        (NumberField.RingOfIntegers ↥(kummerField k Ω α)),
      q.asIdeal.LiesOver Q.asIdeal ∧
        q.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := by
  classical
  obtain ⟨hgal, hcard, hy⟩ := kummerFieldQuadraticStructure k Ω α hnsq
  haveI : NumberField ↥(kummerField k Ω α) :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField _
  haveI : IsGalois k ↥(kummerField k Ω α) := hgal
  have hram : ¬ SSGRoute.IsRamifiedIn k (kummerField k Ω α) B := by
    rintro ⟨σ, hσI, hσnf⟩
    exact hσnf ((mem_fixingSubgroup_kummerField_iff k Ω α σ).mpr
      ((Work.SSGRoute.kummerChar_eq_zero_iff_apply_sqrt ζ hζ α σ).mp (ha σ hσI)))
  exact ⟨Work.SSGRoute.levelPrime k Ω B hB (kummerField k Ω α),
    levelPrime_liesOver_of_comap_eq k Ω B hB Q hQ _,
    ramificationIdx_levelPrime_eq_one_of_not_isRamifiedIn k Ω _ B hB hram⟩

theorem finPairEqZeroOfKillsInertia (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω] (B : ValuationSubring Ω)
    (hB : SSGRoute.IsFinPlace k B)
    (h2B : ¬ B.valuation (2 : Ω) < 1)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hQ : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k Q)
    (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (α β : kˣ)
    (ha : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ →
      Work.SSGRoute.kummerChar (K := k) (Ω := Ω) ζ hζ α σ = 0)
    (hb : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ →
      Work.SSGRoute.kummerChar (K := k) (Ω := Ω) ζ hζ β σ = 0) :
    Work.SSGRoute.ZDataTwo.finPair k Q α β = 0 := by
  classical
  -- the prime of `k` below `B` is the given prime `Q`
  have hprime : primeBelow k Ω B hB = Q := by
    refine Commons.RingTheory.Valuation.valuationSubringAtPrime_injective
      (R := NumberField.RingOfIntegers k) (K := k) ?_
    rw [← primeBelow_spec k Ω B hB, hQ]
  by_cases hsq : ∃ d : k, d * d = (α : k)
  · -- `α` is a global square: the pairing is additive in the first variable
    obtain ⟨d, hd⟩ := hsq
    have hd0 : d ≠ 0 := by
      rintro rfl
      exact α.ne_zero (by simpa using hd.symm)
    have hα : α = Units.mk0 d hd0 * Units.mk0 d hd0 := by
      refine Units.ext ?_
      rw [Units.val_mul, Units.val_mk0]
      exact hd.symm
    rw [hα, finPair_mul_left k Q (Units.mk0 d hd0) (Units.mk0 d hd0) β]
    exact add_self_eq_zero_zmodTwo _
  · -- `α` is not a square: the quadratic Kummer field `L = k(√α)` is unramified at `Q`, and
    -- `β` has even `Q`-adic valuation, so `β` is a local norm from `L`
    have hnsq : ∀ d : k, d * d ≠ (α : k) := fun d hd => hsq ⟨d, hd⟩
    obtain ⟨hgal, hcard, hy⟩ := kummerFieldQuadraticStructure k Ω α hnsq
    haveI : NumberField ↥(kummerField k Ω α) :=
      Commons.NumberTheory.NumberField.numberField_of_intermediateField _
    haveI : IsGalois k ↥(kummerField k Ω α) := hgal
    have hfr : Module.finrank k ↥(kummerField k Ω α) = 2 := by
      rw [← IsGalois.card_aut_eq_finrank k ↥(kummerField k Ω α)]
      exact hcard
    have hloc : NK.NUV2.LC.IsLocalNorm k ↥(kummerField k Ω α) β
        (NK.GlobalCFT.Place.ofFinite Q) := by
      obtain ⟨q, hq, hunr⟩ :=
        existsUnramifiedPrimeOfKillsInertia k Ω B hB Q hQ ζ hζ α hnsq ha
      -- the inertia degree of the unramified prime is at most `2`
      have hfdvd : q.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) ∣ 2 := by
        have h := Work.SSGRoute.ramificationIdx_mul_inertiaDeg_dvd_finrank k
          ↥(kummerField k Ω α) Q q hq
        rw [hunr, one_mul, hfr] at h
        exact h
      -- the image of `β` in the completion has a square value
      obtain ⟨d, hd⟩ := existsValSqOfKillsInertiaPrime k Ω B hB h2B Q hQ ζ hζ β hb
      have hne_alg : ∀ x : kˣ, algebraMap k (Q.adicCompletion k) (x : k) ≠ 0 := by
        intro x h0
        have h1 : Valued.v (R := Q.adicCompletion k) (Γ₀ := WithZero (Multiplicative ℤ))
            (algebraMap k (Q.adicCompletion k) (x : k)) = 0 := by rw [h0, map_zero]
        rw [Commons.NumberTheory.NumberField.Completion.val_algebraMap_adicCompletion Q
          (x : k)] at h1
        exact (Valuation.ne_zero_iff (Q.valuation k)).mpr (Units.ne_zero x) h1
      have hval : Valued.v (R := Q.adicCompletion k) (Γ₀ := WithZero (Multiplicative ℤ))
            (algebraMap k (Q.adicCompletion k) (β : k)) =
          (Valued.v (R := Q.adicCompletion k) (Γ₀ := WithZero (Multiplicative ℤ))
            ((Units.mk0 (algebraMap k (Q.adicCompletion k) (d : k)) (hne_alg d) :
              (Q.adicCompletion k)ˣ) : Q.adicCompletion k)) ^ 2 := by
        rw [Units.val_mk0,
          Commons.NumberTheory.NumberField.Completion.val_algebraMap_adicCompletion Q (β : k),
          Commons.NumberTheory.NumberField.Completion.val_algebraMap_adicCompletion Q (d : k)]
        exact hd
      rcases eq_or_ne (q.asIdeal.inertiaDeg (NumberField.RingOfIntegers k)) 1 with hf1 | hf1
      · -- inertia degree `1`: the valuation condition is vacuous
        refine isLocalNorm_of_unramified_of_val_pow Q q hq hunr β
          ⟨Units.mk0 (algebraMap k (Q.adicCompletion k) (β : k)) (hne_alg β), ?_⟩
        rw [hf1, pow_one, Units.val_mk0]
      · -- inertia degree `2`: use the even valuation
        have hfpos : 1 ≤ q.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) := by
          rw [Nat.one_le_iff_ne_zero]
          intro h0
          rw [h0] at hfdvd
          exact absurd (Nat.eq_zero_of_zero_dvd hfdvd) (by norm_num)
        have hfle : q.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) ≤ 2 :=
          Nat.le_of_dvd (by norm_num) hfdvd
        have hf2 : q.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) = 2 := by omega
        exact isLocalNorm_of_unramified_of_val_pow Q q hq hunr β ⟨_,
          by rw [hf2]; exact hval⟩
    rw [← hprime] at hloc
    rw [← hprime]
    exact (finPair_eq_zero_iff_isLocalNorm k Ω ζ hζ B hB α β
      ↥(kummerField k Ω α) hcard hy).mpr hloc

end Work.SSGRoute.ZDataTwo
