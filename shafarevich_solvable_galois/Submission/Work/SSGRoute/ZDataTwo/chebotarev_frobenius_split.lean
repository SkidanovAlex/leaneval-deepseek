/-!
# The Čebotarev "new prime" step of Schmidt–Wingberg §4 (piece P3 of the `z`-construction)

`Work.SSGRoute.ZDataTwo.chebotarev_frobenius_split`: given a prescribed Frobenius element `τ` of
`G_k` whose restriction to `N` is trivial, there is a finite place `B` of `Ω` which avoids an
arbitrary finite set `T'` of pairwise non-`G_k`-conjugate places, is unramified in `L`, is
completely split in `N`, and whose decomposition group contains an element `σ` restricting to
`τ` on `L`, i.e. `res k L σ = res k L τ`.

This is the step of Schmidt–Wingberg §4 which chooses the new ramification prime `P_{n+1}` with a
prescribed Frobenius, and it is one of the inputs of the `p = 2` `z`-construction
(`Work.SSGRoute.shafarevich_z_data_two`) and of the odd-`p` sibling
(`Submission/Work/SSGRoute/z_data_mup_arith.lean`, where the corresponding piece is a `sorry`).
The statement is the corrected form of the sibling's `chebotarev_sameFrobeniusClass_split`
(which is false as stated): it carries the compatibility hypothesis `res k N τ = 1`, which makes
`(res k L τ, 1)` a well-defined element of `Gal(L · N / k)`.

## The hypothesis `hc`

The general-`k` Čebotarev density theorem is *conditional* in this workspace: it is derived from
`NK.Chebotarev.ArtinReciprocityInput k L` at every finite Galois level (see
`NK.Reconstruct.chebotarevDensityInput_of_artinReciprocity` and
`NK.Reconstruct.exists_isFrobAtPrime_mem_of_hasFullDensity`), so it must be carried as the
hypothesis `hc : NK.Reconstruct.ChebotarevDensityInput k Ω`.  The same is true of the sibling's
`Work.SSGRoute.exists_isFrobAtPrime_notMem_finite`.

## Proof

The level `M := L ⊔ N`, the "bad" set (primes of `k` below `T'`, and the primes of `k` ramified at
one of the three levels `M`, `L`, `N`), and Čebotarev (`exists_isFrobAtPrime_notMem_finite`) with
`g := res k M τ` produce `p ∉ Bad` and `P | p` with `IsFrobAt P g`; a place `B` over `P` is
produced by `exists_valuationSubring_at_prime`.  Then:

* `IsFinPlace k B` is `isFinPlace_of_comap_valuationSubringAtPrime`;
* the avoidance clause is `not_isConjPlace_of_notMem_primeUnder`, using that the prime of `k` below
  `B` is `p` (`comap_valuationSubringAtPrime` for the tower `k ≤ ↥M ≤ Ω`);
* the unramifiedness of `B` in `L` follows from `p ∉ Bad` via
  `levelSub_le_fixingSubgroup_of_ramificationIdx_eq_one` and
  `not_isRamifiedIn_of_levelSub_le_fixingSubgroup`;
* the complete splitting of `B` in `N`: the Frobenius at the prime `P.under (𝓞 ↥N)` of `𝓞 N` is
  `res k N τ = 1` (`IsFrobAtRestrictNormalHomType` and the tower compatibility of `res`), so its
  decomposition subgroup is generated by `1`, and the prime–place bridge
  `map_res_decomp_eq_stabilizer_valuationRing` at the level `N` identifies
  `(decomp k B).map (res k N)` with that (trivial) stabiliser; hence `decomp k B ≤ N.fixingSubgroup`;
* the Frobenius clause is the prime–place bridge at the level `M` together with
  `mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup`,
  `mem_decompositionSubgroup_iff_smul`, `IsFrobAtStabilizes`, and the tower compatibility
  `IsScalarTower.AlgEquiv.restrictNormalHom_comp_apply`.

Axiom footprint: `propext, Classical.choice, Quot.sound`.
-/

namespace Work.SSGRoute.ZDataTwo

open scoped Pointwise

theorem chebotarev_frobenius_split (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω]
    (hc : NK.Reconstruct.ChebotarevDensityInput k Ω)
    (L N : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    [FiniteDimensional k N] [IsGalois k N]
    (T' : Finset (ValuationSubring Ω))
    (τ : Ω ≃ₐ[k] Ω) (hτ : SSGRoute.res k N τ = 1) :
    ∃ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B ∧
      (∀ C ∈ T', ¬ SSGRoute.IsConjPlace k C B) ∧
      ¬ SSGRoute.IsRamifiedIn k L B ∧ SSGRoute.IsSplitIn k N B ∧
      ∃ σ : Ω ≃ₐ[k] Ω, σ ∈ SSGRoute.decomp k B ∧
        SSGRoute.res k L σ = SSGRoute.res k L τ := by
  classical
  let M : IntermediateField k Ω := L ⊔ N
  have hLM : L ≤ M := le_sup_left
  have hNM : N ≤ M := le_sup_right
  letI : Algebra ↥L ↥M := (Subsemiring.inclusion hLM).toAlgebra
  letI : Algebra ↥N ↥M := (Subsemiring.inclusion hNM).toAlgebra
  haveI htowLMk : IsScalarTower k ↥L ↥M := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI htowNMk : IsScalarTower k ↥N ↥M := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI htowLMΩ : IsScalarTower ↥L ↥M Ω := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI htowNMΩ : IsScalarTower ↥N ↥M Ω := IsScalarTower.of_algebraMap_eq fun x => rfl
  haveI hfdM : FiniteDimensional k M := inferInstance
  haveI hnormM : Normal k M := inferInstance
  haveI hgalM : IsGalois k M := inferInstance
  haveI hnumM : NumberField ↥M := NumberField.of_module_finite k ↥M
  set g : ↥M ≃ₐ[k] ↥M := SSGRoute.res k M τ with hg
  set Bad : Set (NK.Chebotarev.PrimeIdeal k) :=
    {p | ∃ A ∈ T', A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p}
    ∪ {p | ∃ P : NK.Chebotarev.PrimeIdeal ↥M,
        P.asIdeal.LiesOver p.asIdeal ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1}
    ∪ {p | ∃ P : NK.Chebotarev.PrimeIdeal ↥L,
        P.asIdeal.LiesOver p.asIdeal ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1}
    ∪ {p | ∃ P : NK.Chebotarev.PrimeIdeal ↥N,
        P.asIdeal.LiesOver p.asIdeal ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) ≠ 1} with hBaddef
  have hBad : Bad.Finite := by
    rw [hBaddef]
    exact (((finite_setOf_primeUnder (k := k) (Ω := Ω) T').union
      (finite_setOf_primeUnder_ramified (k := k) (Ω := Ω) M)).union
      (finite_setOf_primeUnder_ramified (k := k) (Ω := Ω) L)).union
      (finite_setOf_primeUnder_ramified (k := k) (Ω := Ω) N)
  obtain ⟨p, hpBad, hFrob⟩ := exists_isFrobAtPrime_notMem_finite hc Bad hBad M g
  obtain ⟨P, hPlies, hPfrob⟩ := hFrob
  obtain ⟨B, hBcomap⟩ :=
    Commons.NumberTheory.NumberField.Valuation.exists_valuationSubring_at_prime
      (K := ↥M) (K' := Ω) P
  -- the three components of `p ∉ Bad`
  have hpBad₁ : p ∉ {p | ∃ A ∈ T', A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p} := by
    rw [hBaddef] at hpBad; exact fun h => hpBad (Or.inl (Or.inl (Or.inl h)))
  have hpBadL : ∀ P_L : NK.Chebotarev.PrimeIdeal ↥L, P_L.asIdeal.LiesOver p.asIdeal →
      P_L.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := by
    intro P_L hPL
    by_contra hne
    rw [hBaddef] at hpBad
    exact hpBad (Or.inl (Or.inr ⟨P_L, hPL, hne⟩))
  have hpBadN : ∀ P_N : NK.Chebotarev.PrimeIdeal ↥N, P_N.asIdeal.LiesOver p.asIdeal →
      P_N.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := by
    intro P_N hPN
    by_contra hne
    rw [hBaddef] at hpBad
    exact hpBad (Or.inr ⟨P_N, hPN, hne⟩)
  -- the prime of `k` below `B` is `p`
  have hBp : B.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p := by
    have hunderAs : (IsDedekindDomain.HeightOneSpectrum.under
        (NumberField.RingOfIntegers k) P).asIdeal = p.asIdeal := by
      rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
      exact hPlies.over.symm
    have hunder : IsDedekindDomain.HeightOneSpectrum.under (NumberField.RingOfIntegers k) P = p :=
      IsDedekindDomain.HeightOneSpectrum.ext hunderAs
    have h1 : B.comap (algebraMap k Ω) =
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P).comap
          (algebraMap k ↥M) := by
      rw [← hBcomap]
      exact (ValuationSubring.comap_comap B (algebraMap ↥M Ω) (algebraMap k ↥M)).symm
    rw [h1, Commons.RingTheory.Valuation.comap_valuationSubringAtPrime p P hPlies]
  have hBne : B.comap (algebraMap k Ω) ≠ ⊤ := by
    rw [hBp]
    exact Commons.RingTheory.Valuation.valuationSubringAtPrime_ne_top (K := k) p
  refine ⟨B, hBne, ?_, ?_, ?_, ?_⟩
  · intro C hC hconj
    refine not_isConjPlace_of_notMem_primeUnder (k := k) (Ω := Ω) T' B p hBp ?_ C hC hconj
    intro hmem
    exact hpBad₁ hmem
  · -- unramified in `L`
    have hlev := levelSub_le_fixingSubgroup_of_ramificationIdx_eq_one (k := k) (Ω := Ω) L B hBne p
      hBp hpBadL
    exact not_isRamifiedIn_of_levelSub_le_fixingSubgroup (k := k) (Ω := Ω) L B hlev
  · -- completely split in `N`
    -- the prime of `𝓞 N` below `B`
    have hBN : B.comap (algebraMap ↥N Ω) =
        IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥N
          (P.under (NumberField.RingOfIntegers ↥N)) := by
      have hliesN : P.asIdeal.LiesOver (P.under (NumberField.RingOfIntegers ↥N)).asIdeal := by
        rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
        exact ⟨rfl⟩
      have h1 : B.comap (algebraMap ↥N Ω) =
          (B.comap (algebraMap ↥M Ω)).comap (algebraMap ↥N ↥M) :=
        (ValuationSubring.comap_comap B (algebraMap ↥M Ω) (algebraMap ↥N ↥M)).symm
      rw [h1, hBcomap, Commons.RingTheory.Valuation.comap_valuationSubringAtPrime
        (P.under (NumberField.RingOfIntegers ↥N)) P hliesN]
    -- the prime of `𝓞 N` below `B`, and its Frobenius
    have hliesN' : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.LiesOver p.asIdeal := by
      rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
      refine ⟨?_⟩
      rw [Ideal.under_under]
      exact hPlies.over
    have he_N : (P.under (NumberField.RingOfIntegers ↥N)).asIdeal.ramificationIdx
        (NumberField.RingOfIntegers k) = 1 := hpBadN _ hliesN'
    have hfrobN : NK.Chebotarev.IsFrobAt (K := k) (L := ↥N)
        (P.under (NumberField.RingOfIntegers ↥N))
        (SSGRoute.res k N τ) := by
      have h := NK.Chebotarev.IsFrobAtRestrictNormalHomType (K := k) (E := ↥N) (M := ↥M) P g hPfrob
      have hcompat := IsScalarTower.AlgEquiv.restrictNormalHom_comp_apply ↥N ↥M (F := k) (K₃ := Ω) τ
      have hres : AlgEquiv.restrictNormalHom ↥N g = AlgEquiv.restrictNormalHom ↥N τ := by
        rw [hg]; exact hcompat.symm
      rw [show SSGRoute.res k N τ = AlgEquiv.restrictNormalHom ↥N τ from rfl, ← hres]
      exact h
    -- the decomposition subgroup at the `N`-prime is trivial
    have hdec : Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
        (P.under (NumberField.RingOfIntegers ↥N)) = ⊥ := by
      rw [NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt (K := k) (N := ↥N)
        (P.under (NumberField.RingOfIntegers ↥N)) (SSGRoute.res k N τ) he_N hfrobN, hτ]
      exact Subgroup.zpowers_one_eq_bot
    -- the bridge at level `N`
    have hbridgeN := map_res_decomp_eq_stabilizer_valuationRing (k := k) (Ω := Ω) N B hBne
      (P.under (NumberField.RingOfIntegers ↥N)) hBN
    have hstab : MulAction.stabilizer (↥N ≃ₐ[k] ↥N)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥N
          (P.under (NumberField.RingOfIntegers ↥N))) = ⊥ := by
      refine le_antisymm ?_ bot_le
      intro x hx
      rw [Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup,
        hdec] at hx
      exact hx
    rw [SSGRoute.IsSplitIn]
    intro δ hδ
    rw [← IntermediateField.restrictNormalHom_ker N, MonoidHom.mem_ker]
    have hmem : SSGRoute.res k N δ ∈ (SSGRoute.decomp k B).map (SSGRoute.res k N) :=
      Subgroup.mem_map_of_mem _ hδ
    rw [hbridgeN, hstab] at hmem
    simpa using hmem
  · -- the Frobenius clause
    have hbridge := map_res_decomp_eq_stabilizer_valuationRing (k := k) (Ω := Ω) M B hBne P hBcomap
    have hgstab : g ∈ MulAction.stabilizer (↥M ≃ₐ[k] ↥M)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥M P) := by
      rw [Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup]
      rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup_iff_smul]
      exact NK.Chebotarev.IsFrobAtStabilizes hPfrob
    rw [← hbridge] at hgstab
    obtain ⟨σ, hσmem, hσres⟩ := hgstab
    refine ⟨σ, hσmem, ?_⟩
    have hM : AlgEquiv.restrictNormalHom ↥M σ = AlgEquiv.restrictNormalHom ↥M τ :=
      hσres.trans hg.symm
    have e1 := IsScalarTower.AlgEquiv.restrictNormalHom_comp_apply ↥L ↥M (F := k) (K₃ := Ω) σ
    have e2 := IsScalarTower.AlgEquiv.restrictNormalHom_comp_apply ↥L ↥M (F := k) (K₃ := Ω) τ
    show AlgEquiv.restrictNormalHom ↥L σ = AlgEquiv.restrictNormalHom ↥L τ
    exact e1.trans ((congrArg (AlgEquiv.restrictNormalHom ↥L) hM).trans e2.symm)

end Work.SSGRoute.ZDataTwo
