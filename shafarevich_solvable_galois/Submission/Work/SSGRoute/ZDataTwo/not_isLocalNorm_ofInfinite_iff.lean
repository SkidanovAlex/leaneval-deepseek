/-! ## The embeddings attached to a real place and a real place above it -/

section Embeddings

variable {k L : Type*} [Field k] [Field L] [Algebra k L]

/-- **Compatibility of the real embeddings of a real place and of a real place above it.**  If `w'`
lies over `w` and `w` is real, then the complex embedding of `w'` restricts to the complex embedding
of `w` along `k → L` (`embedding_comp_eq_of_isReal`); the real form of this statement is the one
used below. -/
lemma embedding_comp_eq_of_isReal {w' : NumberField.InfinitePlace L}
    {w : NumberField.InfinitePlace k} (h : w'.LiesOver w) (hw : w.IsReal) :
    w'.embedding.comp (algebraMap k L) = w.embedding := by
  rcases NumberField.InfinitePlace.LiesOver.embedding_comp_eq_or_conjugate_embedding_comp_eq w' w
    with h1 | h1
  · exact h1
  · have h2 : ComplexEmbedding.conjugate (w'.embedding.comp (algebraMap k L)) = w.embedding := by
      rw [← h1, ComplexEmbedding.conjugate_comp]
    rw [← ComplexEmbedding.involutive_conjugate (K := k) (w'.embedding.comp (algebraMap k L)), h2,
      NumberField.InfinitePlace.conjugate_embedding_eq_of_isReal hw]

/-- **The square of the image of a square root.**  For `w` real, `w' | w` and `y * y = α` in `L`,
the complex number `w'.embedding y` squares to the real number `α` evaluated at `w`. -/
lemma embedding_pow_two_eq_of_isReal {α : k} {y : L} (hy : y * y = algebraMap k L α)
    {w' : NumberField.InfinitePlace L} {w : NumberField.InfinitePlace k}
    (h : w'.LiesOver w) (hw : w.IsReal) :
    (w'.embedding y) ^ 2 = ((NumberField.InfinitePlace.embedding_of_isReal hw α : ℝ) : ℂ) := by
  have hcomp := embedding_comp_eq_of_isReal h hw
  calc (w'.embedding y) ^ 2 = w'.embedding (y * y) := by rw [map_mul, sq]
    _ = w'.embedding (algebraMap k L α) := by rw [hy]
    _ = w.embedding α := by rw [← RingHom.comp_apply, hcomp]
    _ = ((NumberField.InfinitePlace.embedding_of_isReal hw α : ℝ) : ℂ) := by
        rw [NumberField.InfinitePlace.embedding_of_isReal_apply]

end Embeddings

/-! ## Pure auxiliary facts -/

section Aux

/-- **A quadratic extension generated by a square root is spanned by `1` and the square root.**
If `y * y = α` in a degree-two extension `L/k` and `α` is not a square in `k`, then every element of
`L` is of the form `a + b * y`. -/
private lemma aux_exists_eq_add_mul_of_sq_eq {k L : Type*} [Field k] [Field L] [Algebra k L]
    [FiniteDimensional k L] {α : k} {y : L} (hy : y * y = algebraMap k L α)
    (hns : ∀ c : k, c * c ≠ α) (hrank : Module.finrank k L = 2) :
    ∀ z : L, ∃ a b : k, z = algebraMap k L a + algebraMap k L b * y := by
  let f : (k × k) →ₗ[k] L :=
    { toFun := fun p => p.1 • (1 : L) + p.2 • y
      map_add' := by
        intro p q
        simp only [Prod.fst_add, Prod.snd_add, add_smul]
        abel
      map_smul' := by
        intro c p
        simp only [Prod.smul_fst, Prod.smul_snd, RingHom.id_apply, smul_add, smul_eq_mul,
          smul_smul] }
  have hf_apply : ∀ p : k × k, f p = algebraMap k L p.1 + algebraMap k L p.2 * y := by
    intro p
    show p.1 • (1 : L) + p.2 • y = algebraMap k L p.1 + algebraMap k L p.2 * y
    rw [Algebra.smul_def, Algebra.smul_def, mul_one]
  have hker : ∀ p : k × k, f p = 0 → p = 0 := by
    rintro ⟨a, b⟩ hp
    rw [hf_apply] at hp
    by_cases hb : b = 0
    · subst hb
      simp only [map_zero, zero_mul, add_zero] at hp
      have ha : a = 0 := (algebraMap k L).injective (by simpa using hp)
      subst ha
      rfl
    · exfalso
      have hbne : algebraMap k L b ≠ 0 := by
        intro h0
        exact hb ((algebraMap k L).injective (by simpa using h0))
      have h3 : algebraMap k L b⁻¹ * (algebraMap k L a + algebraMap k L b * y) = 0 := by
        rw [hp, mul_zero]
      rw [mul_add, ← map_mul, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hb, map_one, one_mul] at h3
      have h2 : algebraMap k L (b⁻¹ * a) + y = 0 := by
        simpa using h3
      have h1 : algebraMap k L (b⁻¹ * a) = -y := eq_neg_of_add_eq_zero_left h2
      have h4 : algebraMap k L ((b⁻¹ * a) * (b⁻¹ * a)) = algebraMap k L α := by
        rw [map_mul, h1, neg_mul_neg, hy]
      exact hns (b⁻¹ * a) ((algebraMap k L).injective h4)
  have hinj : Function.Injective f := by
    intro p q hpq
    exact sub_eq_zero.mp (hker (p - q) (by simp [map_sub, hpq]))
  have hfin : Module.finrank k (k × k) = Module.finrank k L := by
    rw [Module.finrank_prod, Module.finrank_self, hrank]
  have hsurj : Function.Surjective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin).mp hinj
  intro z
  obtain ⟨p, hp⟩ := hsurj z
  exact ⟨p.1, p.2, by rw [← hp, hf_apply]⟩

/-- **A non-real complex number whose square is real has negative square.**  This is the formal
content of "`z = iy` with `y ≠ 0`": `z² = r` with `r` real and `z` not real forces `r < 0`. -/
private lemma aux_ofReal_neg_of_sq_eq_of_notMem {z : ℂ} {r : ℝ} (h : z ^ 2 = (r : ℂ))
    (hz : z ∉ Set.range (fun x : ℝ => (x : ℂ))) : r < 0 := by
  by_contra hr
  rw [not_lt] at hr
  set s : ℂ := ((Real.sqrt r : ℝ) : ℂ) with hs
  have hsq : s ^ 2 = (r : ℂ) := by
    rw [hs, ← Complex.ofReal_pow, Real.sq_sqrt hr]
  have hfac : (z - s) * (z + s) = 0 := by
    have hkey : (z - s) * (z + s) = z ^ 2 - s ^ 2 := by ring
    have hz2 : z ^ 2 - s ^ 2 = 0 := by rw [h, hsq, sub_self]
    rw [hkey, hz2]
  rcases mul_eq_zero.mp hfac with h1 | h1
  · have hz' : z = s := sub_eq_zero.mp h1
    exact hz ⟨Real.sqrt r, by rw [hz', hs]⟩
  · have hz' : z = -s := eq_neg_of_add_eq_zero_left h1
    exact hz ⟨-Real.sqrt r, by rw [hz', hs]; simp⟩

end Aux

/-! ## When is a place above a real place real? -/

section IsRealAbove

variable {k L : Type*} [Field k] [Field L] [Algebra k L]
  {w' : NumberField.InfinitePlace L} {w : NumberField.InfinitePlace k}

/-- **A place above a real place is real exactly when the image of the square root is real.**  Given
`w` real, `w' | w` and the knowledge that every element of `L` is `a + b*y`, the embedding of `w'`
is real as soon as it takes `y` to a real number. -/
private lemma aux_isReal_iff_mem_range {y : L}
    (hcomp : w'.embedding.comp (algebraMap k L) = w.embedding) (hw : w.IsReal)
    (hgen : ∀ z : L, ∃ a b : k, z = algebraMap k L a + algebraMap k L b * y) :
    w'.IsReal ↔ w'.embedding y ∈ Set.range (fun r : ℝ => (r : ℂ)) := by
  constructor
  · intro hR
    exact ⟨ComplexEmbedding.IsReal.embedding (NumberField.InfinitePlace.isReal_iff.mp hR) y,
      ComplexEmbedding.IsReal.coe_embedding_apply _ y⟩
  · rintro ⟨t, ht⟩
    have hconj : ComplexEmbedding.conjugate w'.embedding = w'.embedding := by
      ext z
      obtain ⟨a, b, hz⟩ := hgen z
      have hwa : starRingEnd ℂ (w.embedding a) = w.embedding a :=
        RingHom.congr_fun (ComplexEmbedding.isReal_iff.mp
          (NumberField.InfinitePlace.isReal_iff.mp hw)) a
      have hwb : starRingEnd ℂ (w.embedding b) = w.embedding b :=
        RingHom.congr_fun (ComplexEmbedding.isReal_iff.mp
          (NumberField.InfinitePlace.isReal_iff.mp hw)) b
      have hφa : w'.embedding (algebraMap k L a) = w.embedding a :=
        RingHom.congr_fun hcomp a
      have hφb : w'.embedding (algebraMap k L b) = w.embedding b :=
        RingHom.congr_fun hcomp b
      have ht' : (t : ℂ) = w'.embedding y := ht
      simp only [hz, map_add, map_mul, ComplexEmbedding.conjugate_coe_eq]
      rw [hφa, hφb, ← ht', hwa, hwb, Complex.conj_ofReal]
    exact NumberField.InfinitePlace.isReal_iff.mpr hconj

end IsRealAbove

/-! ## The local norm at a real place with no real place above it -/

section LocalNorm

variable {k : Type} [Field k] [NumberField k] {L : Type} [Field L] [NumberField L] [Algebra k L]
  [FiniteDimensional k L] [IsGalois k L]

/-- The value of the identification `k_w ≅ ℝ` on an element of `k`, at a real place. -/
private lemma aux_ringEquivRealOfIsReal_algebraMap {w : NumberField.InfinitePlace k} (hw : w.IsReal)
    (x : k) :
    (NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw)
        (algebraMap k w.Completion x) = NumberField.InfinitePlace.embedding_of_isReal hw x := by
  rw [NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal_apply,
    NumberField.InfinitePlace.Completion.algebraMap_apply]
  simp [NumberField.InfinitePlace.Completion.extensionEmbeddingOfIsReal_coe]

/-- **The local norm at a real place whose extensions are all complex is the set of positive
elements.**  The local norm is then `ℂˣ → ℝˣ`, `z ↦ |z|²`, so the image of `x ∈ kˣ` is a local norm
exactly when the real number attached to `x` at `w` is positive, i.e. exactly when `x` is not
negative at `w`. -/
private lemma aux_mem_range_localNormInfinite_iff_not_isNegAt (x : kˣ)
    {w' : NumberField.InfinitePlace L} {w : NumberField.InfinitePlace k}
    (h : w'.LiesOver w) (hw : w.IsReal) (hw' : w'.IsComplex) :
    NK.NUV2.LC.localIncl k (NK.GlobalCFT.Place.ofInfinite w) x ∈
        (NK.GlobalCFT.Place.localNormInfinite w' w).range ↔ ¬ IsNegAt w x := by
  haveI : w'.LiesOver w := h
  rw [NK.CFTLib.IdeleHasse.range_localNormInfinite_of_real_complex (w := w) (w' := w') hw hw',
    Subgroup.mem_comap, Units.mem_posSubgroup]
  change 0 < (NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw)
      (algebraMap k w.Completion (x : k)) ↔ ¬ IsNegAt w x
  rw [aux_ringEquivRealOfIsReal_algebraMap hw]
  exact (not_isNegAt_iff hw x).symm

end LocalNorm

/-! ## The criterion -/

/-- **The archimedean local-norm criterion for a quadratic extension.**  For a quadratic Galois
extension `L/k` given by a square root `y ∈ L \ k` of `α ∈ kˣ` and an infinite place `w` of `k`,
`β ∈ kˣ` fails to be a local norm from `L` at `w` exactly when both `α` and `β` are negative at `w`.

At a complex place both sides are false; at a real place the extensions of `w` are all real when `α`
is positive at `w` (local norm onto, right hand side false) and all complex when `α` is negative
(then the local norm is the norm `ℂˣ → ℝˣ`, whose image is the positive reals, so `β` fails exactly
when `β` is negative). -/
theorem not_isLocalNorm_ofInfinite_iff {k : Type} [Field k] [NumberField k] (α β : kˣ)
    (L : Type) [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (h2 : Nat.card (L ≃ₐ[k] L) = 2)
    (hy : ∃ y : L, y * y = algebraMap k L (α : k) ∧ y ∉ Set.range (algebraMap k L))
    (w : NumberField.InfinitePlace k) :
    ¬ NK.NUV2.LC.IsLocalNorm k L β (NK.GlobalCFT.Place.ofInfinite w) ↔
      Work.SSGRoute.ZDataTwo.IsNegAt w α ∧ Work.SSGRoute.ZDataTwo.IsNegAt w β := by
  obtain ⟨y, hy1, hy2⟩ := hy
  -- `L` has degree two over `k`, and `α` is not a square in `k`.
  have hrank : Module.finrank k L = 2 := by
    rw [← IsGalois.card_aut_eq_finrank k L, h2]
  have hns : ∀ c : k, c * c ≠ (α : k) := by
    intro c hc
    have hsq : y * y = algebraMap k L c * algebraMap k L c := by rw [hy1, ← map_mul, hc]
    have hfac : (y - algebraMap k L c) * (y + algebraMap k L c) = 0 := by
      rw [sub_mul, mul_add, mul_add, hsq]
      ring
    rcases mul_eq_zero.mp hfac with h | h
    · exact hy2 ⟨c, (sub_eq_zero.mp h).symm⟩
    · have h' : y = -algebraMap k L c := eq_neg_of_add_eq_zero_left h
      exact hy2 ⟨-c, by rw [h', map_neg]⟩
  -- Every element of `L` is `a + b * y`.
  have hgen : ∀ z : L, ∃ a b : k, z = algebraMap k L a + algebraMap k L b * y :=
    aux_exists_eq_add_mul_of_sq_eq hy1 hns hrank
  by_cases hw : w.IsReal
  · -- `w` is real: the type of the places above `w` is governed by the sign of `α` at `w`.
    have htype : ∀ (w' : NumberField.InfinitePlace L) (h : w'.LiesOver w),
        (w'.IsReal ↔ ¬ IsNegAt w α) := by
      intro w' h
      have hcomp := embedding_comp_eq_of_isReal h hw
      have hsqt := embedding_pow_two_eq_of_isReal hy1 h hw
      rw [aux_isReal_iff_mem_range hcomp hw hgen]
      constructor
      · rintro ⟨t, ht⟩
        rw [not_isNegAt_iff hw]
        have ht' : (t : ℂ) = w'.embedding y := ht
        have hsq_t : t ^ 2 = NumberField.InfinitePlace.embedding_of_isReal hw (α : k) := by
          refine Complex.ofReal_injective ?_
          rw [Complex.ofReal_pow, ht']
          exact hsqt
        have hne : NumberField.InfinitePlace.embedding_of_isReal hw (α : k) ≠ 0 := by
          intro h0
          exact α.ne_zero ((NumberField.InfinitePlace.embedding_of_isReal hw).injective
            (by rw [h0, map_zero]))
        have hle : 0 ≤ NumberField.InfinitePlace.embedding_of_isReal hw (α : k) :=
          hsq_t ▸ sq_nonneg t
        exact lt_of_le_of_ne hle (Ne.symm hne)
      · intro hneg
        by_contra hmem
        exact hneg ((isNegAt_iff hw α).mpr
          (aux_ofReal_neg_of_sq_eq_of_notMem hsqt hmem))
    by_cases hneg : IsNegAt w α
    · -- all places above `w` are complex: the local norm is the positive reals.
      have hallC : ∀ (w' : NumberField.InfinitePlace L) (h : w'.LiesOver w), w'.IsComplex := by
        intro w' h
        rw [← NumberField.InfinitePlace.not_isReal_iff_isComplex]
        exact fun hR => ((htype w' h).mp hR) hneg
      have hiff : NK.NUV2.LC.IsLocalNorm k L β (NK.GlobalCFT.Place.ofInfinite w) ↔
          ¬ IsNegAt w β := by
        rw [NK.NUV2.LC.IsLocalNorm]
        constructor
        · rintro ⟨w', h, hmem⟩
          exact (aux_mem_range_localNormInfinite_iff_not_isNegAt β h hw (hallC w' h)).mp hmem
        · intro hnb
          obtain ⟨w', hw'comap⟩ := NumberField.InfinitePlace.comap_surjective (K := L) w
          have h : w'.LiesOver w := (NK.GlobalCFT.Norm.liesOver_iff_comap_eq w' w).mpr hw'comap
          exact ⟨w', h,
            (aux_mem_range_localNormInfinite_iff_not_isNegAt β h hw (hallC w' h)).mpr hnb⟩
      rw [hiff]
      constructor
      · intro h
        exact ⟨hneg, by by_contra hc; exact h hc⟩
      · rintro ⟨-, hβ⟩
        intro hc
        exact hc hβ
    · -- no place above `w` is complex: the local norm is onto.
      obtain ⟨w₀, hw₀comap⟩ := NumberField.InfinitePlace.comap_surjective (K := L) w
      have h₀ : w₀.LiesOver w := (NK.GlobalCFT.Norm.liesOver_iff_comap_eq w₀ w).mpr hw₀comap
      have hR : w₀.IsReal := (htype w₀ h₀).mpr hneg
      have hloc : NK.NUV2.LC.IsLocalNorm k L β (NK.GlobalCFT.Place.ofInfinite w) := by
        rw [NK.NUV2.LC.IsLocalNorm]
        refine ⟨w₀, h₀, ?_⟩
        haveI : w₀.LiesOver w := h₀
        rw [show NK.GlobalCFT.Place.localNormInfinite w₀ w =
            Units.map (Algebra.norm w.Completion : w₀.Completion →* w.Completion) from rfl,
          NK.NUV2.ArtinBridge.localNormInfinite_range_eq_top_of_real_real hw hR]
        exact Subgroup.mem_top _
      exact ⟨fun h => absurd hloc h, fun h => absurd h.1 hneg⟩
  · -- `w` is complex: `k_w = ℂ = L_w` and every element is a local norm.
    have hwc : w.IsComplex := NumberField.InfinitePlace.not_isReal_iff_isComplex.mp hw
    exact ⟨fun h => absurd (isLocalNorm_ofInfinite_of_isComplex w hwc β) h,
      fun h => absurd (IsNegAt.isReal h.1) hw⟩

end Work.SSGRoute.ZDataTwo
