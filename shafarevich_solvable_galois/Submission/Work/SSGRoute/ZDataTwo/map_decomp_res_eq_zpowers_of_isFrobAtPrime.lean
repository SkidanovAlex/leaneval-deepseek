namespace Work.SSGRoute.ZDataTwo

open scoped Pointwise

/-- **The restriction of the decomposition group of a place, when the level is unramified and
the restriction of `σ` is a Frobenius, is the cyclic group generated by that Frobenius.**

`k` a number field, `Ω` an algebraic closure, `A` a finite place of `Ω` over the prime `p` of `k`,
`L/k` a finite Galois level unramified at `p` (spelled `ramificationIdx = 1` at the prime `P` of
`𝓞 L` below `A`), and `σ ∈ decomp k A` with `res k L σ` a Frobenius at `p`
(`NK.Chebotarev.IsFrobAtPrime p (res k L σ)`).  Then
`(decomp k A).map (res k L) = Subgroup.zpowers (res k L σ)`.

Proof sketch.  By `Work.SSGRoute.map_res_decomp_eq_stabilizer_valuationRing` with
`P := Work.SSGRoute.levelPrime k Ω A hA L` (whose defining property is
`NK.Reconstruct.primeOfLevel_spec`) the left side is `MulAction.stabilizer Gal(↥L/k)
(valuationSubringAtPrime ↥L P)`, equal to `Submission.NeukirchUchida.Local.decompositionSubgroup
(K := k) P` by `mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup`.

* `Subgroup.zpowers_le.mpr`: `res k L σ ∈ D_P`.  From `hσ : σ ∈ decomp k A` we get
  `σ • A = A`; `Commons.FieldTheory.Galois.restrictNormalHom_smul_comap_eq_of_smul_eq` (or
  `comap_smul_eq_restrictNormalHom_smul`) turns this into `res k L σ` stabilising
  `A.comap (algebraMap ↥L Ω) = valuationSubringAtPrime ↥L P`.
* cardinalities.  All primes of `𝓞 L` over `p` have the same `e`, `f`
  (`Ideal.ramificationIdx_eq_of_isGaloisGroup`, `Ideal.inertiaDeg_eq_of_isGaloisGroup`, for
  `G = Gal(↥L/k)`, `A = 𝓞 k`, `B = 𝓞 ↥L`, with `MulSemiringAction`/`IsGaloisGroup` instances built as
  in `NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt`).  Write `Q` for the prime
  over `p` from `hfrob`.  Then
  - `Nat.card ↥(Subgroup.zpowers (res k L σ)) = orderOf (res k L σ) = Q.asIdeal.inertiaDeg (𝓞 k)`
    by `Nat.card_zpowers` and `NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg` (the needed unramifiedness
    `Q.asIdeal.ramificationIdx (𝓞 k) = 1` follows from `hpram` and Galois-invariance of `e`);
  - `Nat.card ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P)
      = P.asIdeal.ramificationIdx (𝓞 k) * P.asIdeal.inertiaDeg (𝓞 k) = P.asIdeal.inertiaDeg (𝓞 k)`
    by `card_decompositionSubgroup` with `Ideal.ramificationIdxIn_eq_ramificationIdx`,
    `Ideal.inertiaDegIn_eq_inertiaDeg` and `hpram`.
  These are equal by `Ideal.inertiaDeg_eq_of_isGaloisGroup` (both `P`, `Q` lie over `p`).
* conclude with `Subgroup.eq_of_le_of_card_ge` (or `.eq_of_le_of_card_le`). -/
theorem map_decomp_res_eq_zpowers_of_isFrobAtPrime
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (L : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hp : A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p)
    (hpram : (Work.SSGRoute.levelPrime k Ω A hA L).asIdeal.ramificationIdx
      (NumberField.RingOfIntegers k) = 1)
    (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ SSGRoute.decomp k A)
    (hfrob : NK.Chebotarev.IsFrobAtPrime (K := k) (L := L) p (SSGRoute.res k L σ)) :
    (SSGRoute.decomp k A).map (SSGRoute.res k L) = Subgroup.zpowers (SSGRoute.res k L σ) := by
  classical
  haveI : IsSepClosure k Ω := inferInstance
  haveI hNumberFieldL : NumberField ↥L := inferInstance
  haveI : Normal k ↥L := inferInstance
  -- The prime `P` of `𝓞 ↥L` below the place `A`.
  set P : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥L) :=
    Work.SSGRoute.levelPrime k Ω A hA L with hPdef
  have hPspec : A.comap (algebraMap ↥L Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P :=
    NK.Reconstruct.primeOfLevel_spec A L (NK.Reconstruct.comap_level_ne_top hA L)
  -- The prime of `𝓞 k` below `A` is `p`, hence `P` lies over `p`.
  have hprimeOf_eq : Submission.NeukirchUchida.primeOf A hA = p :=
    Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := k) (by
      rw [← Submission.NeukirchUchida.primeOf_spec A hA, hp])
  have hliesP : P.asIdeal.LiesOver p.asIdeal := by
    have h := NK.ResidueFrob.primeOfLevel_liesOver (K := k) (K' := Ω)
      (⟨A, hA⟩ : NK.FrobeniusBridge.FinitePlaceOf k Ω) L
    rw [hprimeOf_eq] at h
    exact h
  -- `P` lies over its own `under`, with the `IsPrime`/`LiesOver` instances made available.
  have hliesD : P.asIdeal.LiesOver (P.under (NumberField.RingOfIntegers k)).asIdeal := by
    rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
    exact ⟨rfl⟩
  have heP : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := hpram
  -- The two actions of `Gal(↥L/k)` on `𝓞 ↥L` needed for the ramification bookkeeping.
  letI : MulSemiringAction Gal(↥L/k) (NumberField.RingOfIntegers ↥L) :=
    IsIntegralClosure.MulSemiringAction (NumberField.RingOfIntegers k) k ↥L
      (NumberField.RingOfIntegers ↥L)
  haveI hGalL : IsGaloisGroup Gal(↥L/k) (NumberField.RingOfIntegers k)
      (NumberField.RingOfIntegers ↥L) :=
    IsGaloisGroup.of_isFractionRing Gal(↥L/k) (NumberField.RingOfIntegers k)
      (NumberField.RingOfIntegers ↥L) k ↥L
  -- The prime–place bridge: `res k L` maps `decomp k A` onto the stabiliser of `P`.
  have hbridge : (SSGRoute.decomp k A).map (SSGRoute.res k L) =
      MulAction.stabilizer Gal(↥L/k)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P) :=
    Work.SSGRoute.map_res_decomp_eq_stabilizer_valuationRing (k := k) (Ω := Ω) L A hA P hPspec
  have hstab : MulAction.stabilizer Gal(↥L/k)
      (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P) =
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P :=
    Subgroup.ext (fun x =>
      Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
        (K := k) P x)
  -- `res k L σ` lies in the decomposition group of `P`.
  have hmem : SSGRoute.res k L σ ∈
      Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P := by
    rw [← Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
      (K := k) P (SSGRoute.res k L σ)]
    rw [MulAction.mem_stabilizer_iff]
    have hσA : σ • A = A := MulAction.mem_stabilizer_iff.mp hσ
    have hcom := NK.Reconstruct.comap_smul_eq_restrictNormalHom_smul'
      (F := k) (E := ↥L) (K := Ω) A σ
    rw [hσA, hPspec] at hcom
    exact hcom.symm
  -- The decomposition group has `e · f = f` elements.
  have hcardD : Nat.card ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P)
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) := by
    rw [Submission.NeukirchUchida.Local.card_decompositionSubgroup (K := k) (L := ↥L)
      (P.under (NumberField.RingOfIntegers k)) P hliesD]
    haveI := hliesD
    rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := NumberField.RingOfIntegers k)
          (B := NumberField.RingOfIntegers ↥L)
          (P.under (NumberField.RingOfIntegers k)).asIdeal P.asIdeal Gal(↥L/k),
        Ideal.inertiaDegIn_eq_inertiaDeg (A := NumberField.RingOfIntegers k)
          (B := NumberField.RingOfIntegers ↥L)
          (P.under (NumberField.RingOfIntegers k)).asIdeal P.asIdeal Gal(↥L/k),
        heP, one_mul]
  -- The cyclic group generated by `res k L σ` has `orderOf = f` elements.
  have hcardZ : Nat.card ↥(Subgroup.zpowers (SSGRoute.res k L σ))
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers k) := by
    obtain ⟨Q, hQlies, hQfrob⟩ := hfrob
    haveI := hliesP
    haveI := hQlies
    have hunrQ : Q.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1 := by
      rw [← Ideal.ramificationIdx_eq_of_isGaloisGroup p.asIdeal P.asIdeal Q.asIdeal Gal(↥L/k),
        heP]
    rw [Nat.card_zpowers, NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg hQlies hunrQ hQfrob]
    exact Ideal.inertiaDeg_eq_of_isGaloisGroup p.asIdeal Q.asIdeal P.asIdeal Gal(↥L/k)
  have hD : Submission.NeukirchUchida.Local.decompositionSubgroup (K := k) P
      = Subgroup.zpowers (SSGRoute.res k L σ) :=
    (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hmem)
      (by rw [hcardD, hcardZ])).symm
  exact hbridge.trans (hstab.trans hD)

end Work.SSGRoute.ZDataTwo
