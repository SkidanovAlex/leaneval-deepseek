/-!
# The family of local `μ₂` forms, and its non-degeneracy

`mu2Form k Ω K ζ hζ H` is the local `p = 2` Tate pairing at a local group `H` of the `μ₂` local
Tate system: at the group generated by an involution it is the archimedean form `archForm` of
`Mu2ArchForm`, at a decomposition group of a finite place it is the local Hilbert-symbol form
`finForm` of `Mu2FiniteForm`, and it is `0` at every other subgroup.  (The archimedean test comes
first; the two local groups are provably disjoint, `Work.SSGRoute.E7Arch.localGroupDisjoint`, so the
order only matters for computation.)

This file also proves that `mu2Form` is non-degenerate in both variables at every local group, which
is the hypothesis `hnd` of `Work.SSGRoute.ZDataTwo.mu2LocalTateSystemWithArch_of_forms`.
-/

namespace Work.SSGRoute.ZDataTwo

open _root_.SSGRoute
open scoped IntermediateField Pointwise

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

variable (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  [IsAlgClosed Ω]
  (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  [DistribMulAction (K ≃ₐ[k] K) (ZMod 2)] [SMulCommClass (K ≃ₐ[k] K) (ZMod 2) (ZMod 2)]

/-- **The family of local `μ₂` Tate forms** at the two kinds of local groups. -/
noncomputable def mu2Form (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (H : Subgroup (Ω ≃ₐ[k] Ω)) :
    H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] (H1loc 2 k Ω K (ZMod 2) H →ₗ[ZMod 2] ZMod 2) := by
  classical
  exact if h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c then
    h.choose_spec.2.symm ▸ archForm k Ω K h.choose
  else if h : ∃ A : ValuationSubring Ω, IsFinPlace k A ∧ H = decomp k A then
    h.choose_spec.2.symm ▸ finForm k Ω K ζ hζ h.choose h.choose_spec.1
  else 0

/-- **Evaluation at an involution group**, in the form given by the chosen involution. -/
lemma mu2Form_eq_arch (ζ : k) (hζ : IsPrimitiveRoot ζ 2) {H : Subgroup (Ω ≃ₐ[k] Ω)}
    (h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c) :
    mu2Form k Ω K ζ hζ H = h.choose_spec.2.symm ▸ archForm k Ω K h.choose := by
  unfold mu2Form
  rw [dif_pos h]

/-- **Evaluation at a decomposition group**, in the form given by the chosen place. -/
lemma mu2Form_eq_fin (ζ : k) (hζ : IsPrimitiveRoot ζ 2) {H : Subgroup (Ω ≃ₐ[k] Ω)}
    (hneg : ¬ ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)
    (h : ∃ A : ValuationSubring Ω, IsFinPlace k A ∧ H = decomp k A) :
    mu2Form k Ω K ζ hζ H = h.choose_spec.2.symm ▸ finForm k Ω K ζ hζ h.choose h.choose_spec.1 := by
  unfold mu2Form
  rw [dif_neg hneg, dif_pos h]

/-- A finite place is determined by its decomposition group (rigidity of places). -/
lemma place_eq_of_decomp_eq {A B : ValuationSubring Ω} (hA : IsFinPlace k A)
    (hB : IsFinPlace k B) (h : decomp k A = decomp k B) : A = B := by
  haveI : IsSepClosure k Ω := ⟨IsSepClosure.sep_closed Ω, inferInstance⟩
  exact Submission.NeukirchUchida.decompositionGroup_injective hA hB h

/-- Non-degeneracy of a transport of `finForm`. -/
lemma hnd_finForm_transport (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (A : ValuationSubring Ω)
    (hA : IsFinPlace k A) {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : H = decomp k A) :
    (∀ x : H1loc 2 k Ω K (ZMod 2) H,
        (∀ y, (hH.symm ▸ finForm k Ω K ζ hζ A hA) x y = 0) → x = 0) ∧
      (∀ y : H1loc 2 k Ω K (ZMod 2) H,
        (∀ x, (hH.symm ▸ finForm k Ω K ζ hζ A hA) x y = 0) → y = 0) := by
  subst H
  exact finForm_nondegenerate k Ω K ζ hζ A hA

/-- Non-degeneracy of a transport of `archForm`. -/
lemma hnd_archForm_transport (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hH : H = Subgroup.zpowers c) :
    (∀ x : H1loc 2 k Ω K (ZMod 2) H,
        (∀ y, (hH.symm ▸ archForm k Ω K c) x y = 0) → x = 0) ∧
      (∀ y : H1loc 2 k Ω K (ZMod 2) H,
        (∀ x, (hH.symm ▸ archForm k Ω K c) x y = 0) → y = 0) := by
  subst H
  exact archForm_nondegenerate k Ω K hc

/-- **Non-degeneracy of `mu2Form` at every local group.** -/
theorem mu2Form_nondegenerate (ζ : k) (hζ : IsPrimitiveRoot ζ 2) (H : Subgroup (Ω ≃ₐ[k] Ω))
    (hH : IsLocalGroupMu2 k Ω H) :
    (∀ x : H1loc 2 k Ω K (ZMod 2) H, (∀ y, mu2Form k Ω K ζ hζ H x y = 0) → x = 0) ∧
      (∀ y : H1loc 2 k Ω K (ZMod 2) H, (∀ x, mu2Form k Ω K ζ hζ H x y = 0) → y = 0) := by
  classical
  rcases hH with ⟨A, hA, hHeq⟩ | ⟨c, hc, hHeq⟩
  · have hneg : ¬ ∃ d : Ω ≃ₐ[k] Ω, d ^ 2 = 1 ∧ H = Subgroup.zpowers d := by
      rintro ⟨d, hd, hHd⟩
      exact Work.SSGRoute.E7Arch.localGroupDisjoint k Ω A hA d hd (by rw [← hHeq]; exact hHd)
    have h : ∃ A : ValuationSubring Ω, IsFinPlace k A ∧ H = decomp k A := ⟨A, hA, hHeq⟩
    rw [mu2Form_eq_fin k Ω K ζ hζ hneg h]
    exact hnd_finForm_transport k Ω K ζ hζ h.choose h.choose_spec.1 h.choose_spec.2
  · have h : ∃ d : Ω ≃ₐ[k] Ω, d ^ 2 = 1 ∧ H = Subgroup.zpowers d := ⟨c, hc, hHeq⟩
    rw [mu2Form_eq_arch k Ω K ζ hζ h]
    exact hnd_archForm_transport k Ω K h.choose h.choose_spec.1 h.choose_spec.2

end Work.SSGRoute.ZDataTwo
