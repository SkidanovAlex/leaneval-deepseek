/-!
# The local normalisation of the `p = 2` escape class at two non-conjugate places

`Work.SSGRoute.ZDataTwo.TwoRec.claimOfPreTwo_localNormalise` (Schmidt--Wingberg §4, the piece
(P-c) of `ZDataTwo/TwoRec/NOTE_diagonal_p16_plan.md`): for a finite place `B` at which the class
`b ∈ (↥K)ˣ` has even `𝔭`-count, and a second finite place `B'` which is not `K`-conjugate to `B`,
there is `x ∈ (↥K)ˣ` with

* `count_B(x² b) = 0` (the class `b` is normalised at `B`: a square is invisible to the count
  modulo `2`, and the `B`-count of `b` is even), and
* `count_{B'}(x²) = 0` (the correcting square `x²` is a unit at `B'`).

The two primes of `↥K` below `B` and `B'` are distinct — `gesKConj` is exactly "same prime of `↥K`"
(`exists_mem_fixingSubgroup_smul_eq_of_comap_eq` together with `oddPrime_spec`) — and at two
distinct height-one primes the count map `↥Kˣ → ℤ²` hits `(1,0)`: the elementary two-prime CRT step
`exists_count_one_of_ne` below.  Powers of that element then solve the two linear equations
`2 v + count(b) = 0`, `2 v = 0`.
-/

namespace Work.SSGRoute.ZDataTwo.TwoRec

open _root_.SSGRoute

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 800000

/-! ## Counts of principal fractional ideals generated by units -/

/-- **Additivity of the `𝔭`-count over a product of units.** -/
theorem count_spanSingleton_mul_unit {K : Type} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (u v : Kˣ) :
    FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((u * v : Kˣ) : K))
      = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (u : K))
        + FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (v : K)) := by
  have hu : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
      (u : K) ≠ 0 :=
    FractionalIdeal.spanSingleton_ne_zero_iff.mpr (Units.ne_zero u)
  have hv : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
      (v : K) ≠ 0 :=
    FractionalIdeal.spanSingleton_ne_zero_iff.mpr (Units.ne_zero v)
  rw [Units.val_mul, ← FractionalIdeal.spanSingleton_mul_spanSingleton]
  exact FractionalIdeal.count_mul K 𝔭 hu hv

/-- **Homogeneity of the `𝔭`-count under natural powers of a unit.** -/
theorem count_spanSingleton_pow_unit {K : Type} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (u : Kˣ) (n : ℕ) :
    FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((u ^ n : Kˣ) : K))
      = (n : ℤ) * FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (u : K)) := by
  rw [Units.val_pow_eq_pow_val, ← FractionalIdeal.spanSingleton_pow]
  exact FractionalIdeal.count_pow K 𝔭 n _

/-- **The `𝔭`-count of the inverse of a unit is the negative of the `𝔭`-count.** -/
theorem count_spanSingleton_inv_unit {K : Type} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (u : Kˣ) :
    FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((u⁻¹ : Kˣ) : K))
      = - FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (u : K)) := by
  rw [Units.val_inv_eq_inv_val, ← FractionalIdeal.spanSingleton_inv]
  exact FractionalIdeal.count_inv K 𝔭 _

/-! ## The two-prime CRT step -/

/-- **Two distinct height-one primes of a number field have independent valuations**: there is
`c ∈ Kˣ` whose principal fractional ideal has `𝔭`-count `1` and `𝔮`-count `0`.

Let `π` be a uniformiser at `𝔭` and let `a ∈ 𝔭²`, `b ∈ 𝔮` with `a + b = 1` (Bézout for the
comaximal pair `(𝔭², 𝔮)`).  Then `c := π b + a` satisfies `c - π = a (1 - π) ∈ 𝔭²` and
`c - 1 = b (π - 1) ∈ 𝔮`; hence `c ∈ 𝔭 \ 𝔭²` and `c ∉ 𝔮`, i.e. `v_𝔭(c) = exp(-1)` and
`v_𝔮(c) = 1`, which is exactly what the two `count`s say. -/
theorem exists_count_one_of_ne {K : Type} [Field K] [NumberField K]
    (𝔭 𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (h : 𝔭 ≠ 𝔮) :
    ∃ c : Kˣ,
      FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (c : K)) = 1 ∧
      FractionalIdeal.count K 𝔮 (FractionalIdeal.spanSingleton
          (nonZeroDivisors (NumberField.RingOfIntegers K)) (c : K)) = 0 := by
  classical
  obtain ⟨π, hπ⟩ := IsDedekindDomain.HeightOneSpectrum.intValuation_exists_uniformizer 𝔭
  obtain ⟨a, ha, b, hb, hab⟩ :=
    (IsDedekindDomain.HeightOneSpectrum.isCoprime_pow_of_ne 𝔭 𝔮 h 2 1).exists
  rw [pow_one] at hb
  set c : NumberField.RingOfIntegers K := π * b + a with hcdef
  have hb_eq : b = 1 - a := by rw [← hab]; ring
  have hc𝔭 : c - π ∈ 𝔭.asIdeal ^ 2 := by
    have h1 : c - π = a * (1 - π) := by rw [hcdef, hb_eq]; ring
    rw [h1]
    have h2 := Ideal.mul_mem_mul ha
      (Submodule.mem_top : (1 - π) ∈ (⊤ : Ideal (NumberField.RingOfIntegers K)))
    rwa [Ideal.mul_top] at h2
  have hc𝔮 : c - 1 ∈ 𝔮.asIdeal := by
    have h1 : c - 1 = b * (π - 1) := by rw [hcdef, hb_eq]; ring
    rw [h1]
    have h2 := Ideal.mul_mem_mul hb
      (Submodule.mem_top : (π - 1) ∈ (⊤ : Ideal (NumberField.RingOfIntegers K)))
    rwa [Ideal.mul_top] at h2
  have hπlt : 𝔭.intValuation π < 1 := by
    rw [hπ, ← WithZero.exp_zero, WithZero.exp_lt_exp]
    norm_num
  have hπmem : π ∈ 𝔭.asIdeal :=
    (IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem 𝔭 π).mp hπlt
  have hπnotmem : π ∉ 𝔭.asIdeal ^ 2 := by
    intro hmem
    have hle := (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem 𝔭 π 2).mpr hmem
    rw [hπ, WithZero.exp_le_exp] at hle
    exact absurd hle (by norm_num)
  have hcmem : c ∈ 𝔭.asIdeal := by
    have h2 : c - π ∈ 𝔭.asIdeal :=
      Ideal.pow_le_self (I := 𝔭.asIdeal) (n := 2) (by norm_num) hc𝔭
    have h3 := 𝔭.asIdeal.add_mem hπmem h2
    rwa [show π + (c - π) = c by ring] at h3
  have hcnotmem2 : c ∉ 𝔭.asIdeal ^ 2 := by
    intro hc2
    refine hπnotmem ?_
    simpa using (𝔭.asIdeal ^ 2).sub_mem hc2 hc𝔭
  have hcnotmem𝔮 : c ∉ 𝔮.asIdeal := by
    intro hcq
    have h1 : (1 : NumberField.RingOfIntegers K) ∈ 𝔮.asIdeal := by
      simpa using 𝔮.asIdeal.sub_mem hcq hc𝔮
    exact 𝔮.isPrime.ne_top ((Ideal.eq_top_iff_one 𝔮.asIdeal).mpr h1)
  have hle : 𝔭.intValuation c ≤ WithZero.exp (-(1 : ℤ)) :=
    (IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem 𝔭 c 1).mpr
      (by simpa using hcmem)
  have hnle : ¬ (𝔭.intValuation c ≤ WithZero.exp (-(2 : ℤ))) := fun hh =>
    hcnotmem2 ((IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem 𝔭 c 2).mp hh)
  have hne0 : 𝔭.intValuation c ≠ 0 := by
    intro h0
    exact hnle (by rw [h0]; exact zero_le)
  have hlog : (𝔭.intValuation c).log = -1 := by
    have h1 : (𝔭.intValuation c).log ≤ -1 := by
      have h := hle
      rw [← WithZero.exp_log hne0] at h
      exact (WithZero.exp_le_exp (a := (𝔭.intValuation c).log) (b := (-1 : ℤ))).mp h
    have h2 : -(2 : ℤ) < (𝔭.intValuation c).log := by
      rcases lt_or_ge (-(2 : ℤ)) ((𝔭.intValuation c).log) with hh | hh
      · exact hh
      · exfalso
        have hh' := WithZero.exp_le_exp.mpr hh
        rw [WithZero.exp_log hne0] at hh'
        exact hnle hh'
    omega
  have h𝔭val : 𝔭.intValuation c = WithZero.exp (-1) := by
    rw [← hlog]
    exact (WithZero.exp_log hne0).symm
  have h𝔮val : 𝔮.intValuation c = 1 := by
    refine le_antisymm (IsDedekindDomain.HeightOneSpectrum.intValuation_le_one 𝔮 c) ?_
    exact le_of_not_gt fun hlt => hcnotmem𝔮
      ((IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem 𝔮 c).mp hlt)
  have hcR : c ≠ 0 := by
    intro h0
    exact hcnotmem𝔮 (by rw [h0]; exact 𝔮.asIdeal.zero_mem)
  have hcK : algebraMap (NumberField.RingOfIntegers K) K c ≠ 0 := by
    intro h0
    exact hcR (IsFractionRing.injective (NumberField.RingOfIntegers K) K h0)
  refine ⟨Units.mk0 (algebraMap (NumberField.RingOfIntegers K) K c) hcK, ?_, ?_⟩
  · rw [Work.SSGRoute.EscapeCoreLib.count_spanSingleton_eq_neg_log 𝔭 (Units.ne_zero _),
      Units.val_mk0, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap, h𝔭val,
      WithZero.log_exp]
    norm_num
  · rw [Work.SSGRoute.EscapeCoreLib.count_spanSingleton_eq_neg_log 𝔮 (Units.ne_zero _),
      Units.val_mk0, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap, h𝔮val,
      WithZero.log_one]
    norm_num

/-! ## Powers of the CRT element -/

/-- **Prescribed `𝔭`-count with `𝔮`-count zero.**  From an element of `𝔭`-count `1` and `𝔮`-count `0`,
every integer `𝔭`-count is realised by a power of it or of its inverse, the `𝔮`-count staying `0`. -/
theorem exists_count_neg_of_count_one_ne {K : Type} [Field K] [NumberField K]
    (𝔭 𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (c : Kˣ)
    (hc𝔭 : FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
      (nonZeroDivisors (NumberField.RingOfIntegers K)) (c : K)) = 1)
    (hc𝔮 : FractionalIdeal.count K 𝔮 (FractionalIdeal.spanSingleton
      (nonZeroDivisors (NumberField.RingOfIntegers K)) (c : K)) = 0)
    (k : ℤ) :
    ∃ x : Kˣ,
      FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) (x : K)) = -k ∧
      FractionalIdeal.count K 𝔮 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) (x : K)) = 0 := by
  rcases lt_or_ge (0 : ℤ) k with hk | hk
  · refine ⟨c⁻¹ ^ k.toNat, ?_, ?_⟩
    · rw [count_spanSingleton_pow_unit, count_spanSingleton_inv_unit, hc𝔭,
        Int.toNat_of_nonneg (by omega : (0 : ℤ) ≤ k)]
      ring
    · rw [count_spanSingleton_pow_unit, count_spanSingleton_inv_unit, hc𝔮]
      ring
  · refine ⟨c ^ (-k).toNat, ?_, ?_⟩
    · rw [count_spanSingleton_pow_unit, hc𝔭, Int.toNat_of_nonneg (by omega : (0 : ℤ) ≤ -k)]
      ring
    · rw [count_spanSingleton_pow_unit, hc𝔮]
      ring

/-! ## The core of the local normalisation -/

/-- **The local normalisation, in pure number-field terms.**  At two distinct height-one primes
`𝔭 ≠ 𝔮` of a number field, an element `b` with even `𝔭`-count can be corrected by a square whose
`𝔮`-count is `0`. -/
theorem exists_unit_of_even_count {K : Type} [Field K] [NumberField K]
    (𝔭 𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (h : 𝔭 ≠ 𝔮)
    (b : Kˣ) (hb : Even (FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
      (nonZeroDivisors (NumberField.RingOfIntegers K)) (b : K)))) :
    ∃ x : Kˣ,
      FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((x * x * b : Kˣ) : K)) = 0 ∧
      FractionalIdeal.count K 𝔮 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((x * x : Kˣ) : K)) = 0 := by
  obtain ⟨c, hc1, hc0⟩ := exists_count_one_of_ne 𝔭 𝔮 h
  obtain ⟨k, hk⟩ := hb
  obtain ⟨x, hx1, hx0⟩ := exists_count_neg_of_count_one_ne 𝔭 𝔮 c hc1 hc0 k
  refine ⟨x, ?_, ?_⟩
  · rw [count_spanSingleton_mul_unit 𝔭 (x * x) b, count_spanSingleton_mul_unit 𝔭 x x, hx1, hk]
    ring
  · rw [count_spanSingleton_mul_unit 𝔮 x x, hx0]
    ring

/-! ## The local normalisation for the `p = 2` recursion -/

theorem claimOfPreTwo_localNormalise {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω]
    (B B' : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B) (hB' : SSGRoute.IsFinPlace k B')
    (hne : ¬ Work.SSGRoute.gesKConj K B' B) (b : (↥K)ˣ)
    (hb : Even (FractionalIdeal.count ↥K
      (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) B hB)
      (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers ↥K)) (b : ↥K)))) :
    ∃ x : (↥K)ˣ,
      FractionalIdeal.count ↥K (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) B hB)
        (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers ↥K))
          ((x * x * b : (↥K)ˣ) : ↥K)) = 0 ∧
      FractionalIdeal.count ↥K (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) B' hB')
        (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers ↥K))
          ((x * x : (↥K)ˣ) : ↥K)) = 0 := by
  have hpn : Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) B hB ≠
      Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) B' hB' := by
    intro heq
    refine hne ?_
    have hcomap : B'.comap (algebraMap ↥K Ω) = B.comap (algebraMap ↥K Ω) := by
      rw [Work.SSGRoute.ZDataMup.OddForm.oddPrime_spec (K := K) (A := B') hB',
        Work.SSGRoute.ZDataMup.OddForm.oddPrime_spec (K := K) (A := B) hB, heq]
    exact Work.SSGRoute.ZDataMup.OddForm.exists_mem_fixingSubgroup_smul_eq_of_comap_eq (K := K)
      B' B (Work.SSGRoute.comap_algebraMap_ne_top_of_isFinPlace K hB') hcomap
  exact exists_unit_of_even_count _ _ hpn b hb

end Work.SSGRoute.ZDataTwo.TwoRec
