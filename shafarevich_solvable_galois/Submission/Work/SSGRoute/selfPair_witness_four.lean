/-! ## Elementary words in the truncated free associative algebra

Throughout, `R5 X` denotes the truncation `FreeAssoc X ⧸ fil X 5` of the free associative
`ℤ`-algebra on `X`: the quotient by the ideal generated by the words of length `≥ 5`. -/

/-- The degree-`< 5` truncation of the free associative algebra on `X`. -/
abbrev R5 (X : Type) := FreeAssoc X ⧸ fil X 5

theorem wordEl_cons_loc {X : Type} (y : X) (l : List X) :
    wordEl (y :: l) = wordEl [y] * wordEl l := by
  simp only [wordEl, FreeMonoid.ofList_cons, MonoidAlgebra.single_mul_single, mul_one]
  rfl

theorem wordEl_four {X : Type} (a b c d : X) :
    wordEl [a, b, c, d] = wordEl [a] * (wordEl [b] * (wordEl [c] * wordEl [d])) := by
  rw [wordEl_cons_loc a [b, c, d], wordEl_cons_loc b [c, d], wordEl_cons_loc c [d]]

/-- A word of length `d` is in the `d`-th filtration piece. -/
theorem wordEl_mem_fil (X : Type) (l : List X) : wordEl l ∈ fil X l.length := by
  rw [fil_eq_filI, wordEl]
  exact single_mem_filz le_rfl 1

/-- A word of length `≥ 5` vanishes in `R5 X`. -/
theorem mk_wordEl_zero (X : Type) (l : List X) (h : 5 ≤ l.length) :
    (Ideal.Quotient.mk (fil X 5) (wordEl l) : R5 X) = 0 := by
  rw [Ideal.Quotient.eq_zero_iff_mem, fil_eq_filI]
  exact single_mem_filz h 1

/-- A product of five length-one words vanishes in `R5 X`. -/
theorem prod5_zero {X : Type} (y1 y2 y3 y4 y5 : X) :
    (Ideal.Quotient.mk (fil X 5) (wordEl [y1]) : R5 X) *
      ((Ideal.Quotient.mk (fil X 5) (wordEl [y2])) *
      ((Ideal.Quotient.mk (fil X 5) (wordEl [y3])) *
      ((Ideal.Quotient.mk (fil X 5) (wordEl [y4])) *
       (Ideal.Quotient.mk (fil X 5) (wordEl [y5]))))) = 0 := by
  rw [← map_mul, ← map_mul, ← map_mul, ← map_mul]
  have hword : wordEl [y1] * (wordEl [y2] * (wordEl [y3] * (wordEl [y4] * wordEl [y5])))
      = wordEl [y1, y2, y3, y4, y5] := by
    rw [← wordEl_cons_loc, ← wordEl_cons_loc, ← wordEl_cons_loc, ← wordEl_cons_loc]
  rw [hword]
  exact mk_wordEl_zero X _ (by simp)

/-! ## The Magnus expansions

`Wword X σ x = (x·σx)·[x⁻¹,σx]·(x·σx)` is the word whose norm `ν = (σW)⁻¹W` is the self-pair
witness.  The two polynomials below are the Magnus expansions of `W` and of `σW` in `R5`. -/

/-- The word `(x·σx)·⁅x⁻¹,σx⁆·(x·σx)`. -/
def Wword (X : Type) (σ : X ≃ X) (x : X) : FreeGroup X :=
  (FreeGroup.of x * FreeGroup.of (σ x)) *
    ((FreeGroup.of x)⁻¹ * FreeGroup.of (σ x) * FreeGroup.of x * (FreeGroup.of (σ x))⁻¹) *
    (FreeGroup.of x * FreeGroup.of (σ x))

/-- The Magnus expansion of `W` in `R5`. -/
def ZWpoly (X : Type) (A B : R5 X) : R5 X :=
  2*A + 2*B + A*A + 2*(A*B) + 2*(B*A) + B*B + (A*A*B + A*B*B + B*A*A + B*B*A) + (-(A*B*A*B) + 2*(A*B*B*A) + 2*(B*A*A*B) - 3*(B*A*B*A) + B*B*A*A)

/-- The Magnus expansion of `σW` in `R5`. -/
def ZSpoly (X : Type) (A B : R5 X) : R5 X :=
  2*A + 2*B + A*A + 2*(A*B) + 2*(B*A) + B*B + (A*A*B + A*B*B + B*A*A + B*B*A) + (A*A*B*B - 3*(A*B*A*B) + 2*(A*B*B*A) + 2*(B*A*A*B) - (B*A*B*A))

/-- The antisymmetric degree-four part `ZWpoly - ZSpoly`. -/
def EABpoly (X : Type) (A B : R5 X) : R5 X :=
  -(A*A*B*B) + 2*(A*B*A*B) - 2*(B*A*B*A) + B*B*A*A

/-- **Magnus expansion of `W` modulo `I⁵`.** -/
theorem HW (X : Type) (σ : X ≃ X) (x : X) (A B : R5 X)
    (hA : A = Ideal.Quotient.mk (fil X 5) (wordEl [x]))
    (hB : B = Ideal.Quotient.mk (fil X 5) (wordEl [σ x])) :
    (↑(magnus X 5 (Wword X σ x)) : R5 X) = 1 + ZWpoly X A B := by
  have hAval : (↑(magnus X 5 (FreeGroup.of x)) : R5 X) = 1 + A := by
    rw [magnus_of]
    rw [show MonoidAlgebra.single (FreeMonoid.of x) (1:ℤ) = wordEl [x] from by simp [wordEl], ← hA]
  have hBval : (↑(magnus X 5 (FreeGroup.of (σ x))) : R5 X) = 1 + B := by
    rw [magnus_of]
    rw [show MonoidAlgebra.single (FreeMonoid.of (σ x)) (1:ℤ) = wordEl [σ x] from by simp [wordEl], ← hB]
  have hAAAAA : A*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x x
  have hAAAAB : A*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x (σ x)
  have hAAABA : A*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) x
  have hAAABB : A*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) (σ x)
  have hAABAA : A*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x x
  have hAABAB : A*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x (σ x)
  have hAABBA : A*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) x
  have hAABBB : A*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) (σ x)
  have hABAAA : A*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x x
  have hABAAB : A*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x (σ x)
  have hABABA : A*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) x
  have hABABB : A*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) (σ x)
  have hABBAA : A*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x x
  have hABBAB : A*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x (σ x)
  have hABBBA : A*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) x
  have hABBBB : A*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) (σ x)
  have hBAAAA : B*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x x
  have hBAAAB : B*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x (σ x)
  have hBAABA : B*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) x
  have hBAABB : B*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) (σ x)
  have hBABAA : B*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x x
  have hBABAB : B*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x (σ x)
  have hBABBA : B*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) x
  have hBABBB : B*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) (σ x)
  have hBBAAA : B*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x x
  have hBBAAB : B*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x (σ x)
  have hBBABA : B*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) x
  have hBBABB : B*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) (σ x)
  have hBBBAA : B*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x x
  have hBBBAB : B*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x (σ x)
  have hBBBBA : B*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) x
  have hBBBBB : B*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) (σ x)
  have hAinv : (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) = 1 - A + A*A - A*A*A + A*A*A*A := by
    have hmul : (1 + A) * (1 - A + A*A - A*A*A + A*A*A*A) = 1 := by
      noncomm_ring [hAAAAA]
    have h1 : (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * (1 + A) = 1 := by
      rw [← hAval, ← Units.val_mul, inv_mul_cancel, Units.val_one]
    calc (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X)
        = (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * 1 := (mul_one _).symm
      _ = (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * ((1 + A) * (1 - A + A*A - A*A*A + A*A*A*A)) := by rw [hmul]
      _ = ((↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * (1 + A)) * (1 - A + A*A - A*A*A + A*A*A*A) := (mul_assoc _ _ _).symm
      _ = 1 * (1 - A + A*A - A*A*A + A*A*A*A) := by rw [h1]
      _ = 1 - A + A*A - A*A*A + A*A*A*A := one_mul _
  have hBinv : (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) = 1 - B + B*B - B*B*B + B*B*B*B := by
    have hmul : (1 + B) * (1 - B + B*B - B*B*B + B*B*B*B) = 1 := by
      noncomm_ring [hBBBBB]
    have h1 : (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * (1 + B) = 1 := by
      rw [← hBval, ← Units.val_mul, inv_mul_cancel, Units.val_one]
    calc (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X)
        = (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * 1 := (mul_one _).symm
      _ = (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * ((1 + B) * (1 - B + B*B - B*B*B + B*B*B*B)) := by rw [hmul]
      _ = ((↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * (1 + B)) * (1 - B + B*B - B*B*B + B*B*B*B) := (mul_assoc _ _ _).symm
      _ = 1 * (1 - B + B*B - B*B*B + B*B*B*B) := by rw [h1]
      _ = 1 - B + B*B - B*B*B + B*B*B*B := one_mul _
  rw [Wword, ZWpoly]
  simp only [map_mul, map_inv, Units.val_mul, hAval, hBval, hAinv, hBinv]
  noncomm_ring [hAAAAA, hAAAAB, hAAABA, hAAABB, hAABAA, hAABAB, hAABBA, hAABBB, hABAAA, hABAAB, hABABA, hABABB, hABBAA, hABBAB, hABBBA, hABBBB, hBAAAA, hBAAAB, hBAABA, hBAABB, hBABAA, hBABAB, hBABBA, hBABBB, hBBAAA, hBBAAB, hBBABA, hBBABB, hBBBAA, hBBBAB, hBBBBA, hBBBBB]

/-- **Magnus expansion of `σW` modulo `I⁵`.** -/
theorem HSW (X : Type) (σ : X ≃ X) (x : X) (A B : R5 X)
    (hA : A = Ideal.Quotient.mk (fil X 5) (wordEl [x]))
    (hB : B = Ideal.Quotient.mk (fil X 5) (wordEl [σ x])) :
    (↑(magnus X 5 ((FreeGroup.of (σ x) * FreeGroup.of x) *
      ((FreeGroup.of (σ x))⁻¹ * FreeGroup.of x * FreeGroup.of (σ x) * (FreeGroup.of x)⁻¹) *
      (FreeGroup.of (σ x) * FreeGroup.of x))) : R5 X) = 1 + ZSpoly X A B := by
  have hAval : (↑(magnus X 5 (FreeGroup.of x)) : R5 X) = 1 + A := by
    rw [magnus_of]
    rw [show MonoidAlgebra.single (FreeMonoid.of x) (1:ℤ) = wordEl [x] from by simp [wordEl], ← hA]
  have hBval : (↑(magnus X 5 (FreeGroup.of (σ x))) : R5 X) = 1 + B := by
    rw [magnus_of]
    rw [show MonoidAlgebra.single (FreeMonoid.of (σ x)) (1:ℤ) = wordEl [σ x] from by simp [wordEl], ← hB]
  have hAAAAA : A*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x x
  have hAAAAB : A*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x (σ x)
  have hAAABA : A*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) x
  have hAAABB : A*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) (σ x)
  have hAABAA : A*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x x
  have hAABAB : A*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x (σ x)
  have hAABBA : A*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) x
  have hAABBB : A*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) (σ x)
  have hABAAA : A*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x x
  have hABAAB : A*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x (σ x)
  have hABABA : A*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) x
  have hABABB : A*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) (σ x)
  have hABBAA : A*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x x
  have hABBAB : A*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x (σ x)
  have hABBBA : A*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) x
  have hABBBB : A*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) (σ x)
  have hBAAAA : B*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x x
  have hBAAAB : B*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x (σ x)
  have hBAABA : B*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) x
  have hBAABB : B*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) (σ x)
  have hBABAA : B*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x x
  have hBABAB : B*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x (σ x)
  have hBABBA : B*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) x
  have hBABBB : B*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) (σ x)
  have hBBAAA : B*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x x
  have hBBAAB : B*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x (σ x)
  have hBBABA : B*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) x
  have hBBABB : B*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) (σ x)
  have hBBBAA : B*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x x
  have hBBBAB : B*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x (σ x)
  have hBBBBA : B*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) x
  have hBBBBB : B*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) (σ x)
  have hAinv : (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) = 1 - A + A*A - A*A*A + A*A*A*A := by
    have hmul : (1 + A) * (1 - A + A*A - A*A*A + A*A*A*A) = 1 := by
      noncomm_ring [hAAAAA]
    have h1 : (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * (1 + A) = 1 := by
      rw [← hAval, ← Units.val_mul, inv_mul_cancel, Units.val_one]
    calc (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X)
        = (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * 1 := (mul_one _).symm
      _ = (↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * ((1 + A) * (1 - A + A*A - A*A*A + A*A*A*A)) := by rw [hmul]
      _ = ((↑((magnus X 5 (FreeGroup.of x))⁻¹) : R5 X) * (1 + A)) * (1 - A + A*A - A*A*A + A*A*A*A) := (mul_assoc _ _ _).symm
      _ = 1 * (1 - A + A*A - A*A*A + A*A*A*A) := by rw [h1]
      _ = 1 - A + A*A - A*A*A + A*A*A*A := one_mul _
  have hBinv : (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) = 1 - B + B*B - B*B*B + B*B*B*B := by
    have hmul : (1 + B) * (1 - B + B*B - B*B*B + B*B*B*B) = 1 := by
      noncomm_ring [hBBBBB]
    have h1 : (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * (1 + B) = 1 := by
      rw [← hBval, ← Units.val_mul, inv_mul_cancel, Units.val_one]
    calc (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X)
        = (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * 1 := (mul_one _).symm
      _ = (↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * ((1 + B) * (1 - B + B*B - B*B*B + B*B*B*B)) := by rw [hmul]
      _ = ((↑((magnus X 5 (FreeGroup.of (σ x)))⁻¹) : R5 X) * (1 + B)) * (1 - B + B*B - B*B*B + B*B*B*B) := (mul_assoc _ _ _).symm
      _ = 1 * (1 - B + B*B - B*B*B + B*B*B*B) := by rw [h1]
      _ = 1 - B + B*B - B*B*B + B*B*B*B := one_mul _
  rw [ZSpoly]
  simp only [map_mul, map_inv, Units.val_mul, hAval, hBval, hAinv, hBinv]
  noncomm_ring [hAAAAA, hAAAAB, hAAABA, hAAABB, hAABAA, hAABAB, hAABBA, hAABBB, hABAAA, hABAAB, hABABA, hABABB, hABBAA, hABBAB, hABBBA, hABBBB, hBAAAA, hBAAAB, hBAABA, hBAABB, hBABAA, hBABAB, hBABBA, hBABBB, hBBAAA, hBBAAB, hBBABA, hBBABB, hBBBAA, hBBBAB, hBBBBA, hBBBBB]

/-! ## The self-pair witness -/

/-- The witness `e ⟼ ?`: its class in `R5` is the antisymmetric degree-four part `ZWpoly - ZSpoly`,
i.e. `-x²σx² + 2·xσxxσx - 2·σxxσxx + σx²x²`. -/
def witnessE (X : Type) (σ : X ≃ X) (x : X) : FreeAssoc X :=
  - wordEl [x, x, σ x, σ x] + 2 • wordEl [x, σ x, x, σ x]
    - 2 • wordEl [σ x, x, σ x, x] + wordEl [σ x, σ x, x, x]

/-- The witness lies in the ideal generated by the words of length `≥ 4`. -/
theorem witnessE_mem_fil_four (X : Type) (σ : X ≃ X) (x : X) :
    witnessE X σ x ∈ fil X 4 := by
  have h1 : wordEl [x, x, σ x, σ x] ∈ fil X 4 := by simpa using wordEl_mem_fil X [x, x, σ x, σ x]
  have h2 : wordEl [x, σ x, x, σ x] ∈ fil X 4 := by simpa using wordEl_mem_fil X [x, σ x, x, σ x]
  have h3 : wordEl [σ x, x, σ x, x] ∈ fil X 4 := by simpa using wordEl_mem_fil X [σ x, x, σ x, x]
  have h4 : wordEl [σ x, σ x, x, x] ∈ fil X 4 := by simpa using wordEl_mem_fil X [σ x, σ x, x, x]
  have h2s : (2:ℕ) • wordEl [x, σ x, x, σ x] ∈ fil X 4 := by
    rw [two_nsmul]; exact Ideal.add_mem _ h2 h2
  have h3s : (2:ℕ) • wordEl [σ x, x, σ x, x] ∈ fil X 4 := by
    rw [two_nsmul]; exact Ideal.add_mem _ h3 h3
  show - wordEl [x, x, σ x, σ x] + 2 • wordEl [x, σ x, x, σ x]
    - 2 • wordEl [σ x, x, σ x, x] + wordEl [σ x, σ x, x, x] ∈ fil X 4
  exact Ideal.add_mem _ (Ideal.sub_mem _ (Ideal.add_mem _ (neg_mem h1) h2s) h3s) h4

/-- The class of the witness in `R5` is the antisymmetric degree-four part. -/
theorem witnessE_mk (X : Type) (σ : X ≃ X) (x : X) (A B : R5 X)
    (hA : A = Ideal.Quotient.mk (fil X 5) (wordEl [x]))
    (hB : B = Ideal.Quotient.mk (fil X 5) (wordEl [σ x])) :
    (Ideal.Quotient.mk (fil X 5) (witnessE X σ x) : R5 X) = EABpoly X A B := by
  show (Ideal.Quotient.mk (fil X 5)
    (- wordEl [x, x, σ x, σ x] + 2 • wordEl [x, σ x, x, σ x]
      - 2 • wordEl [σ x, x, σ x, x] + wordEl [σ x, σ x, x, x]) : R5 X) = _
  simp only [map_add, map_sub, map_neg, map_nsmul, map_mul, wordEl_four]
  rw [← hA, ← hB, EABpoly]
  noncomm_ring

/-- The mod-`2` image of the witness is the self-pair class `x²σx² + σx²x²`. -/
theorem witnessE_modTwo (X : Type) (σ : X ≃ X) (x : X) :
    (MonoidAlgebra.mapRingHom (FreeMonoid X) (Int.castRingHom (ZMod 2)) (witnessE X σ x)
      : MonoidAlgebra (ZMod 2) (FreeMonoid X)) = selfPairClass X σ x := by
  have h2z : ∀ m : FreeMonoid X,
      ((2:ℕ) • (MonoidAlgebra.single m (1:ZMod 2) : MonoidAlgebra (ZMod 2) (FreeMonoid X))) = 0 := by
    intro m
    rw [two_nsmul, ← MonoidAlgebra.single_add, show (1:ZMod 2)+1 = 0 from by decide,
      MonoidAlgebra.single_zero]
  have hneg : ∀ m : FreeMonoid X,
      -(MonoidAlgebra.single m (1:ZMod 2) : MonoidAlgebra (ZMod 2) (FreeMonoid X))
        = MonoidAlgebra.single m 1 := by
    intro m
    rw [← MonoidAlgebra.single_neg, show -(1:ZMod 2) = 1 from by decide]
  show (MonoidAlgebra.mapRingHom (FreeMonoid X) (Int.castRingHom (ZMod 2))
    (- wordEl [x, x, σ x, σ x] + 2 • wordEl [x, σ x, x, σ x]
      - 2 • wordEl [σ x, x, σ x, x] + wordEl [σ x, σ x, x, x])
      : MonoidAlgebra (ZMod 2) (FreeMonoid X)) = _
  rw [selfPairClass]
  simp only [map_add, map_sub, map_neg, map_nsmul, map_one, wordEl, MonoidAlgebra.mapRingHom_single,
    FreeMonoid.ofList_cons, FreeMonoid.ofList_nil, mul_one, h2z, hneg]
  simp only [sub_zero, zero_add, mul_assoc, add_comm]

/-! ## Naturality of the Magnus leading term and the `σ`-image of `W` -/

/-- For `N ≤ N'` the truncation `FreeAssoc X ⧸ fil X N' → FreeAssoc X ⧸ fil X N` intertwines the
Magnus leading terms. -/
theorem magLead_naturality (X : Type) (N N' : ℕ) (h : N ≤ N') (z : FreeGroup X) :
    (Ideal.Quotient.factor (fil_antitone X h)) (magLead (X := X) N' z) = magLead (X := X) N z := by
  have hle : fil X N' ≤ fil X N := fil_antitone X h
  set π : FreeAssoc X ⧸ fil X N' →+* FreeAssoc X ⧸ fil X N := Ideal.Quotient.factor hle with hπ
  have hπmk : ∀ a : FreeAssoc X, π (Ideal.Quotient.mk (fil X N') a) = Ideal.Quotient.mk (fil X N) a :=
    fun a => Ideal.Quotient.factor_mk hle a
  have hnat : (Units.map π.toMonoidHom).comp (magnus X N') = magnus X N := by
    refine FreeGroup.ext_hom _ _ (fun y => ?_)
    apply Units.ext
    simp only [MonoidHom.comp_apply, Units.coe_map]
    rw [magnus_of X N' y, magnus_of X N y]
    change π (1 + Ideal.Quotient.mk (fil X N') (MonoidAlgebra.single (FreeMonoid.of y) (1 : ℤ))) =
      1 + Ideal.Quotient.mk (fil X N) (MonoidAlgebra.single (FreeMonoid.of y) (1 : ℤ))
    rw [map_add, map_one, hπmk]
  have hval : π (↑((magnus X N') z)) = ↑((magnus X N) z) := by
    have h2 := congrArg (fun u : (FreeAssoc X ⧸ fil X N)ˣ => (u : FreeAssoc X ⧸ fil X N))
      (DFunLike.congr_fun hnat z)
    rw [MonoidHom.comp_apply, Units.coe_map] at h2
    exact h2
  show π (↑((magnus X N') z) - 1) = ↑((magnus X N) z) - 1
  rw [map_sub, map_one, hval]

/-- `σ` applied to the word `W` is `(σx·x)·[σx⁻¹,x]·(σx·x)`. -/
theorem freeGroupCongr_Wword (X : Type) (σ : X ≃ X) (hσ : ∀ y, σ (σ y) = y) (x : X) :
    FreeGroup.freeGroupCongr σ (Wword X σ x) =
      (FreeGroup.of (σ x) * FreeGroup.of x) *
        ((FreeGroup.of (σ x))⁻¹ * FreeGroup.of x * FreeGroup.of (σ x) * (FreeGroup.of x)⁻¹) *
        (FreeGroup.of (σ x) * FreeGroup.of x) := by
  rw [Wword]
  simp only [map_mul, map_inv, FreeGroup.freeGroupCongr_apply, FreeGroup.map.of]
  rw [hσ x]

/-! ## The self-pair witness of the `(4,4)` graded step -/

theorem selfPair_witness_four (X : Type) (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (x : X)
    (hx : σ x ≠ x) :
    Work.SSGRoute.selfPairWord X σ x ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries 3 ∧
    ∃ e : Work.SSGRoute.prop5.FreeAssoc X,
      (Work.SSGRoute.prop5.magnus X 5 (Work.SSGRoute.selfPairWord X σ x) :
          Work.SSGRoute.prop5.FreeAssoc X ⧸ Work.SSGRoute.prop5.fil X 5)
          = 1 + Ideal.Quotient.mk (Work.SSGRoute.prop5.fil X 5) e ∧
      (MonoidAlgebra.mapRingHom (FreeMonoid X) (Int.castRingHom (ZMod 2)) e :
          MonoidAlgebra (ZMod 2) (FreeMonoid X)) = Work.SSGRoute.selfPairClass X σ x := by
  have _hx := hx
  set A : R5 X := Ideal.Quotient.mk (fil X 5) (wordEl [x]) with hA
  set B : R5 X := Ideal.Quotient.mk (fil X 5) (wordEl [σ x]) with hB
  have hcongr := freeGroupCongr_Wword X σ hσ x
  have hW := HW X σ x A B hA hB
  have hSW := HSW X σ x A B hA hB
  have hν : selfPairWord X σ x = (FreeGroup.freeGroupCongr σ (Wword X σ x))⁻¹ * Wword X σ x := by
    simp only [selfPairWord, commutatorElement_def, Wword]
    rfl
  have hZe : (Ideal.Quotient.mk (fil X 5) (witnessE X σ x) : R5 X) = EABpoly X A B :=
    witnessE_mk X σ x A B hA hB
  have hZE : ZSpoly X A B + EABpoly X A B = ZWpoly X A B := by
    rw [ZWpoly, ZSpoly, EABpoly]; noncomm_ring
  have hAAAAA : A*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x x
  have hAAAAB : A*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x x (σ x)
  have hAAABA : A*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) x
  have hAAABB : A*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x x (σ x) (σ x)
  have hAABAA : A*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x x
  have hAABAB : A*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) x (σ x)
  have hAABBA : A*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) x
  have hAABBB : A*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x x (σ x) (σ x) (σ x)
  have hABAAA : A*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x x
  have hABAAB : A*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x x (σ x)
  have hABABA : A*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) x
  have hABABB : A*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) x (σ x) (σ x)
  have hABBAA : A*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x x
  have hABBAB : A*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) x (σ x)
  have hABBBA : A*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) x
  have hABBBB : A*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero x (σ x) (σ x) (σ x) (σ x)
  have hBAAAA : B*(A*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x x
  have hBAAAB : B*(A*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x x (σ x)
  have hBAABA : B*(A*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) x
  have hBAABB : B*(A*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x x (σ x) (σ x)
  have hBABAA : B*(A*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x x
  have hBABAB : B*(A*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) x (σ x)
  have hBABBA : B*(A*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) x
  have hBABBB : B*(A*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) x (σ x) (σ x) (σ x)
  have hBBAAA : B*(B*(A*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x x
  have hBBAAB : B*(B*(A*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x x (σ x)
  have hBBABA : B*(B*(A*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) x
  have hBBABB : B*(B*(A*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) x (σ x) (σ x)
  have hBBBAA : B*(B*(B*(A*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x x
  have hBBBAB : B*(B*(B*(A*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) x (σ x)
  have hBBBBA : B*(B*(B*(B*(A)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) x
  have hBBBBB : B*(B*(B*(B*(B)))) = 0 := by simpa only [← hA, ← hB] using prod5_zero (σ x) (σ x) (σ x) (σ x) (σ x)
  have hZS0 : ZSpoly X A B * EABpoly X A B = 0 := by
    rw [ZSpoly, EABpoly]; noncomm_ring [hAAAAA, hAAAAB, hAAABA, hAAABB, hAABAA, hAABAB, hAABBA, hAABBB, hABAAA, hABAAB, hABABA, hABABB, hABBAA, hABBAB, hABBBA, hABBBB, hBAAAA, hBAAAB, hBAABA, hBAABB, hBABAA, hBABAB, hBABBA, hBABBB, hBBAAA, hBBAAB, hBBABA, hBBABB, hBBBAA, hBBBAB, hBBBBA, hBBBBB]
  have hkey : (1 + ZSpoly X A B) * (1 + EABpoly X A B) = 1 + ZWpoly X A B := by
    calc (1 + ZSpoly X A B) * (1 + EABpoly X A B)
        = (1 + ZSpoly X A B) * 1 + (1 + ZSpoly X A B) * EABpoly X A B := by rw [mul_add]
      _ = (1 + ZSpoly X A B) + (EABpoly X A B + ZSpoly X A B * EABpoly X A B) := by
            rw [mul_one, add_mul, one_mul]
      _ = (1 + ZSpoly X A B) + (EABpoly X A B + 0) := by rw [hZS0]
      _ = (1 + ZSpoly X A B) + EABpoly X A B := by rw [add_zero]
      _ = 1 + (ZSpoly X A B + EABpoly X A B) := by rw [add_assoc]
      _ = 1 + ZWpoly X A B := by rw [hZE]
  have hval : (↑(magnus X 5 (selfPairWord X σ x)) : R5 X)
      = 1 + Ideal.Quotient.mk (fil X 5) (witnessE X σ x) := by
    rw [hν, map_mul, map_inv, Units.val_mul]
    set u : (R5 X)ˣ := magnus X 5 (FreeGroup.freeGroupCongr σ (Wword X σ x)) with hu_def
    have hu : (↑u : R5 X) = 1 + ZSpoly X A B := by
      rw [hu_def, hcongr]; exact hSW
    calc (↑(u⁻¹) : R5 X) * ↑(magnus X 5 (Wword X σ x))
        = (↑(u⁻¹) : R5 X) * (1 + ZWpoly X A B) := by rw [hW]
      _ = (↑(u⁻¹) : R5 X) * ((1 + ZSpoly X A B) * (1 + EABpoly X A B)) := by rw [← hkey]
      _ = ((↑(u⁻¹) : R5 X) * (1 + ZSpoly X A B)) * (1 + EABpoly X A B) := (mul_assoc _ _ _).symm
      _ = ((↑(u⁻¹) : R5 X) * ↑u) * (1 + EABpoly X A B) := by rw [← hu]
      _ = 1 * (1 + EABpoly X A B) := by rw [Units.inv_mul]
      _ = 1 + EABpoly X A B := one_mul _
      _ = 1 + Ideal.Quotient.mk (fil X 5) (witnessE X σ x) := by rw [hZe]
  have h0 : (↑(magnus X 4 (selfPairWord X σ x)) : FreeAssoc X ⧸ fil X 4) - 1 = 0 := by
    have hnat := magLead_naturality X 4 5 (by norm_num) (selfPairWord X σ x)
    have h5 : magLead (X := X) 5 (selfPairWord X σ x)
        = Ideal.Quotient.mk (fil X 5) (witnessE X σ x) := by
      rw [magLead, hval]; simp
    have he4 : (Ideal.Quotient.mk (fil X 4) (witnessE X σ x) : FreeAssoc X ⧸ fil X 4) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact witnessE_mem_fil_four X σ x
    calc (↑(magnus X 4 (selfPairWord X σ x)) : FreeAssoc X ⧸ fil X 4) - 1
        = magLead (X := X) 4 (selfPairWord X σ x) := rfl
      _ = (Ideal.Quotient.factor (fil_antitone X (by norm_num : 4 ≤ 5)))
            (magLead (X := X) 5 (selfPairWord X σ x)) := hnat.symm
      _ = (Ideal.Quotient.factor (fil_antitone X (by norm_num : 4 ≤ 5)))
            (Ideal.Quotient.mk (fil X 5) (witnessE X σ x)) := by rw [h5]
      _ = Ideal.Quotient.mk (fil X 4) (witnessE X σ x) := Ideal.Quotient.factor_mk _ _
      _ = 0 := he4
  have hlcs : selfPairWord X σ x ∈ (⊤ : Subgroup (FreeGroup X)).lowerCentralSeries 3 :=
    dimensionSubgroup_free X 4 (selfPairWord X σ x)
      (magnus_filtration_correspondence X 4 (selfPairWord X σ x) h0)
  exact ⟨hlcs, witnessE X σ x, hval, witnessE_modTwo X σ x⟩

end

end Work.SSGRoute
