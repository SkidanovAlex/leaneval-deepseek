/-!
# The two local clauses `hreal` and `hdich` of Step 4 of Schmidt–Wingberg

`Work.SSGRoute.step4_local_clauses` extracts, from the coker data `D`, the datum `y` with its local
targets (`Step4YData`) and the class `x` with Theorem 13's clauses, the two local clauses of the
coker side of Step 4:

* `hreal`: at a finite place `A ∉ T⁰` conjugate to a place of `S`, where the twist of `ψ` is
  ramified and the level-`τ` solution is trivial on `D_A`, the cocycle `x` agrees on `D_A` with a
  local target `η` whose twist with `ψ` is cyclic, generated by the inertia
  (`Work.SSGRoute.step4_local_target`).  It is transferred to `A` from the chosen prolongation
  `P ∈ Tnew` by `Work.SSGRoute.hreal_conj_transfer`.
* `hdich`: at a finite place where `ψ` and the twist of `ψ` are ramified, either `x` is a
  `1`-coboundary on `D_A` (the paper's `x_℘ = 0` at the old-ramification primes, the hypothesis
  `hxold`), or the local target of `hreal` realises the twist.
-/

namespace Work.SSGRoute

open _root_.SSGRoute
open Work.CohomologicalShrinking
open scoped Pointwise

set_option maxHeartbeats 4000000

theorem step4_local_clauses (p : ℕ) [Fact p.Prime] (K : IntermediateField ℚ SSGRoute.QBar)
    [FiniteDimensional ℚ K] [Normal ℚ K] (n i j : ℕ) (hj : 1 ≤ j) (hji : j ≤ i)
    (hμ : SSGRoute.HasRootsOfUnity p K i) (D : Work.SSGRoute.Step4CokerData p K n i j)
    (y : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j)
    (hY : Work.SSGRoute.Step4YData p K n i j D y)
    (x : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j)
    (hψquot : ∀ σ, Work.CohomologicalShrinking.flowQuot p (K ≃ₐ[ℚ] K) n
        (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2
        (D.psi σ) = Work.SSGRoute.restrict K σ)
    (hxmul : ∀ σ τ : SSGRoute.GalQ, x (σ * τ) = x σ + (Work.SSGRoute.restrict K σ) • x τ)
    (hxloc : SSGRoute.IsLocConstOn ⊤ x)
    (hxsplit : ∀ A ∈ D.S, SSGRoute.IsSplitIn ℚ K A →
      SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ A)
        (fun δ => x δ - ∑ s : K ≃ₐ[ℚ] K, s • y ((D.sec s)⁻¹ * δ * D.sec s)))
    (hxnot : ∀ A ∈ D.S, ¬ SSGRoute.IsSplitIn ℚ K A →
      SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ A) x)
    (hxinertia : ∀ B : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ B →
      (∀ A ∈ D.S, ¬ SSGRoute.IsConjPlace ℚ A B) → ¬ SSGRoute.IsSplitIn ℚ D.Λ B →
      ∀ σ : SSGRoute.GalQ, SSGRoute.IsInertia ℚ B σ → x σ = 0)
    (hinv : ∀ c : SSGRoute.GalQ, c ^ 2 = 1 →
      SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (Subgroup.zpowers c) x)
    (hcyc7 : ∀ B : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ B →
      (∀ A ∈ D.S, ¬ SSGRoute.IsConjPlace ℚ A B) →
      ∃ V : Subgroup SSGRoute.GalQ, IsOpen (V : Set SSGRoute.GalQ) ∧
        (∀ δ ∈ SSGRoute.decomp ℚ B, ∀ u ∈ SSGRoute.decomp ℚ B ⊓ V, δ * u * δ⁻¹ ∈ V) ∧
        (∃ g ∈ SSGRoute.decomp ℚ B, ∀ δ ∈ SSGRoute.decomp ℚ B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ V) ∧
        SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ B ⊓ V) x)
    (hxold : ∀ B : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ B →
      (∃ A ∈ D.S, SSGRoute.IsConjPlace ℚ A B) →
      (∃ σ, SSGRoute.IsInertia ℚ B σ ∧ σ ∈ K.fixingSubgroup ∧ D.phi σ ≠ 1) →
      SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ B) x) :
    (∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ A → A ∉ D.T0 →
      (∃ A₀ ∈ D.S, SSGRoute.IsConjPlace ℚ A₀ A) →
      (∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧
        (Work.SSGRoute.flowTwistEHom p K n i j x D.psi hψquot hxmul) σ ≠ 1) →
      (∀ σ ∈ SSGRoute.decomp ℚ A, D.phi σ = 1) →
      ∃ η : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
        (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
        (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
        IsCyclic (Subgroup.closure
          ((Work.SSGRoute.flowTwistE p K n i j η D.psi) ''
            (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
        (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
          Work.SSGRoute.flowTwistE p K n i j η D.psi τ
            = Work.SSGRoute.flowTwistE p K n i j η D.psi σ) ∧
        ∀ σ ∈ SSGRoute.decomp ℚ A, x σ = η σ) ∧
    (∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ A →
      (∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧ D.psi σ ≠ 1) →
      (∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧
        (Work.SSGRoute.flowTwistEHom p K n i j x D.psi hψquot hxmul) σ ≠ 1) →
      SSGRoute.IsCoboundaryOn (Work.SSGRoute.restrict K) (SSGRoute.decomp ℚ A) x ∨
        ∃ η : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
          (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
          (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
          IsCyclic (Subgroup.closure
            ((Work.SSGRoute.flowTwistE p K n i j η D.psi) ''
              (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
          (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
            Work.SSGRoute.flowTwistE p K n i j η D.psi τ
              = Work.SSGRoute.flowTwistE p K n i j η D.psi σ) ∧
          ∀ σ ∈ SSGRoute.decomp ℚ A, x σ = η σ) := by
  classical
  haveI : FiniteDimensional ℚ D.Λ := D.fdΛ
  haveI : Normal ℚ D.Λ := D.galΛ.to_normal
  -- the level-`n` stage-3 data for `(D.phi, D.psi)`
  have hPDN : IsProperStageData p K n i j D.phi D.psi :=
    isProperStageData_pushdown p K D.Φ D.φm D.ψm D.data
  have hφquot : ∀ σ : SSGRoute.GalQ,
      flowQuot p (K ≃ₐ[ℚ] K) n i j (D.phi σ) = Work.SSGRoute.restrict K σ := hPDN.1.1.2.2
  have hLift : SSGRoute.LiftsFlow D.psi D.phi := hPDN.2.1
  have hT1ψ : ∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsT1Place p K A →
      ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup → D.psi σ = 1 := hPDN.2.2.2.1
  have hProp := hPDN.2.2.2.2.2
  have hxcoc : SSGRoute.IsCocycleOn (Work.SSGRoute.restrict K) ⊤ x := fun g _ h _ => hxmul g h
  have hΛker : D.psi.ker = D.Λ.fixingSubgroup := D.hΛker
  obtain ⟨hT1cob, _hxram_mono⟩ :=
    step4_transport_general p K D.Λ D.hKΛ n i j
      (flowGroup p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2) D.psi hΛker
      D.S D.hSfin D.hSram D.sec D.hsec y hY.2.2.2.1 hY.2.2.2.2.1 x hxcoc hxsplit hxnot hxinertia
  obtain ⟨Tnew, ηt, hTnewS, _hTnewfin, _hTnewp, hTnewphi, hcover, hbundle, hagree⟩ :=
    hY.2.2.2.2.2.2.2
  have hproj : ∀ θ : SSGRoute.GalQ,
      flowGroupProj p (K ≃ₐ[ℚ] K) n i j (D.psi θ) = D.phi θ :=
    fun θ => flowGroupProj_eq_of_liftsFlowAt (hLift θ)
  -- ## Conjunct 1: the local target `hreal`
  have hreal : ∀ A : ValuationSubring SSGRoute.QBar, SSGRoute.IsFinPlace ℚ A → A ∉ D.T0 →
      (∃ A₀ ∈ D.S, SSGRoute.IsConjPlace ℚ A₀ A) →
      (∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧
        (flowTwistEHom p K n i j x D.psi hψquot hxmul) σ ≠ 1) →
      (∀ σ ∈ SSGRoute.decomp ℚ A, D.phi σ = 1) →
      ∃ η : SSGRoute.GalQ → E p (K ≃ₐ[ℚ] K) n i j,
        (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
        (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
        IsCyclic (Subgroup.closure
          ((flowTwistE p K n i j η D.psi) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
        (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
          flowTwistE p K n i j η D.psi τ = flowTwistE p K n i j η D.psi σ) ∧
        ∀ σ ∈ SSGRoute.decomp ℚ A, x σ = η σ := by
    intro A hAfin hAT0 hconj hramtw hφ1
    -- `D_A ≤ G_K`
    have hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup := by
      intro σ hσ
      exact mem_fixingSubgroup_of_restrict_eq_one K (by rw [← hφquot σ, hφ1 σ hσ, map_one])
    by_cases hT1 : SSGRoute.IsT1Place p K A
    · -- the twist is trivial on `I_A`: the guard fails
      exfalso
      obtain ⟨σ, hσI, hσK, hσne⟩ := hramtw
      have hx0 : x σ = 0 := eq_zero_of_isCoboundaryOn p K n i j (hT1cob A hT1) σ hσI.1 hσK
      have hψ1 : D.psi σ = 1 := hT1ψ A hT1 σ hσI.1 hσK
      have htw : flowTwistEHom p K n i j x D.psi hψquot hxmul σ = 1 := by
        rw [flowTwistEHom_apply, flowTwistE, flowTwist, hx0, hψ1]
        simp
      exact hσne htw
    · by_cases hψram : ∃ σ, SSGRoute.IsInertia ℚ A σ ∧ σ ∈ K.fixingSubgroup ∧ D.psi σ ≠ 1
      · -- the local target at the chosen prolongation `P ∈ Tnew`
        obtain ⟨P, hPTnew, hPconj⟩ := hcover A hAfin hAT0 hconj hφ1 hψram
        obtain ⟨θ, hθ⟩ := hPconj
        have hPS : P ∈ D.S := hTnewS P hPTnew
        have hPphi : ∀ σ ∈ SSGRoute.decomp ℚ P, D.phi σ = 1 := hTnewphi P hPTnew
        have hDKP : ∀ σ ∈ SSGRoute.decomp ℚ P, σ ∈ K.fixingSubgroup := by
          intro σ hσ
          exact mem_fixingSubgroup_of_restrict_eq_one K (by rw [← hφquot σ, hPphi σ hσ, map_one])
        have hPsplit : SSGRoute.IsSplitIn ℚ K P := hDKP
        have hxP : ∀ σ ∈ SSGRoute.decomp ℚ P, x σ = ηt P hPTnew σ := by
          intro σ hσ
          have h0 : x σ - (∑ s : K ≃ₐ[ℚ] K, s • y ((D.sec s)⁻¹ * σ * D.sec s)) = 0 :=
            eq_zero_of_isCoboundaryOn p K n i j (hxsplit P hPS hPsplit) σ hσ (hDKP σ hσ)
          rw [sub_eq_zero] at h0
          rw [h0, hagree P hPTnew σ hσ]
        obtain ⟨hηadd, hηloc, hη0, hηcyc, hηgen⟩ := hbundle P hPTnew
        have hres := hreal_conj_transfer p K n i j x D.psi hψquot hxmul P hDKP θ
          ⟨ηt P hPTnew, hηadd, hηloc, hη0, hηcyc, hηgen, hxP⟩
        rw [hθ] at hres
        exact hres
      · -- `ψ` is unramified on `I_A`: then `x` vanishes there too, so the guard fails
        exfalso
        -- the conjugate `S`-place is a `T⁰`-place
        obtain ⟨A₀, hA₀S, hA₀conj⟩ := hconj
        obtain ⟨θ, hθ⟩ := hA₀conj
        have hsplitA₀ : SSGRoute.IsSplitIn ℚ K A₀ := by
          rw [← step4_isSplitIn_smul K A₀ θ, hθ]
          exact hDK
        have hT0A₀ : A₀ ∈ D.T0 := by
          rcases D.hSmin A₀ hA₀S with h | h | h
          · exact h
          · -- ramified in `Λ`: this is the ψ-ramification at `A`
            exfalso
            obtain ⟨ρ, hρI, hρΛ⟩ := h
            have hρne : D.psi ρ ≠ 1 := fun hh =>
              hρΛ (by rw [← hΛker]; exact MonoidHom.mem_ker.mpr hh)
            have hI : SSGRoute.IsInertia ℚ A (θ * ρ * θ⁻¹) := by
              have h1 : SSGRoute.IsInertia ℚ (θ • A₀) (θ * ρ * θ⁻¹) :=
                (isInertia_conj A₀ θ ρ).mpr hρI
              rwa [hθ] at h1
            have hne : D.psi (θ * ρ * θ⁻¹) ≠ 1 := by
              intro hh
              apply hρne
              have h1 : D.psi (θ * ρ * θ⁻¹) = D.psi θ * D.psi ρ * (D.psi θ)⁻¹ := by
                rw [map_mul, map_mul, map_inv]
              rw [h1] at hh
              have h2 := congrArg (fun z => (D.psi θ)⁻¹ * z * D.psi θ) hh
              simpa [mul_assoc] using h2
            exact hψram ⟨θ * ρ * θ⁻¹, hI, hDK _ hI.1, hne⟩
          · -- over `p`: then `A` is a `T¹`-place
            exfalso
            have hvalA : A.valuation (p : SSGRoute.QBar) < 1 := by
              have h1 := (step4_smul_valuation_p_lt_one p A₀ θ).mpr h
              rwa [hθ] at h1
            exact hT1 ⟨hAfin, Or.inl hvalA⟩
        -- `x` vanishes on `D_{A₀}`
        have hx0 : ∀ δ ∈ SSGRoute.decomp ℚ A₀, x δ = 0 := by
          intro δ hδ
          have h0 : x δ - (∑ s : K ≃ₐ[ℚ] K, s • y ((D.sec s)⁻¹ * δ * D.sec s)) = 0 :=
            eq_zero_of_isCoboundaryOn p K n i j (hxsplit A₀ hA₀S hsplitA₀) δ hδ (hsplitA₀ hδ)
          rw [hY.2.2.2.2.2.1 A₀ hT0A₀ δ hδ, sub_zero] at h0
          exact h0
        -- hence `x` vanishes on the inertia of `A`
        have hxI : ∀ σ : SSGRoute.GalQ, SSGRoute.IsInertia ℚ A σ → x σ = 0 := by
          intro σ hσ
          have hσI : SSGRoute.IsInertia ℚ A₀ (θ⁻¹ * σ * θ) := by
            have h1 : SSGRoute.IsInertia ℚ (θ • A₀) (θ * (θ⁻¹ * σ * θ) * θ⁻¹) := by
              rw [show θ * (θ⁻¹ * σ * θ) * θ⁻¹ = σ from by group, hθ]
              exact hσ
            exact (isInertia_conj A₀ θ (θ⁻¹ * σ * θ)).mp h1
          have hact : Work.SSGRoute.restrict K σ = 1 :=
            restrict_eq_one_of_mem_fixingSubgroup K (hDK σ hσ.1)
          rw [step4_cocycle_conj_eq hxcoc hact θ, hx0 _ hσI.1, smul_zero]
        obtain ⟨σ, hσI, hσK, hσne⟩ := hramtw
        have hxσ : x σ = 0 := hxI σ hσI
        have hψ1 : D.psi σ = 1 := by
          by_contra hh
          exact hψram ⟨σ, hσI, hσK, hh⟩
        have htw : flowTwistEHom p K n i j x D.psi hψquot hxmul σ = 1 := by
          rw [flowTwistEHom_apply, flowTwistE, flowTwist, hxσ, hψ1]
          simp
        exact hσne htw
  refine ⟨hreal, ?_⟩
  -- ## Conjunct 2: the local dichotomy `hdich`
  intro A hAfin hramψ hramtw
  -- `A ∉ T⁰` and `A` is conjugate to a place of `S`
  have hAT0 : A ∉ D.T0 := by
    intro hAT0
    obtain ⟨σ, hσI, _hσK, hσne⟩ := hramψ
    exact hσne (D.hT0unram A hAT0 σ hσI)
  have hconjA : ∃ A₀ ∈ D.S, SSGRoute.IsConjPlace ℚ A₀ A := by
    obtain ⟨σ, hσI, _hσK, hσne⟩ := hramψ
    have hramΛ : SSGRoute.IsRamifiedIn ℚ D.Λ A := by
      refine ⟨σ, hσI, ?_⟩
      intro hmem
      exact hσne (by rw [← hΛker] at hmem; exact MonoidHom.mem_ker.mpr hmem)
    exact D.hSram A hAfin (Or.inl hramΛ)
  obtain ⟨hDK, hdich⟩ := hProp A hAfin hramψ
  by_cases hφ1 : ∀ σ ∈ SSGRoute.decomp ℚ A, D.phi σ = 1
  · -- `φ` is trivial on `D_A`: conjunct 1 gives the local target
    exact Or.inr (hreal A hAfin hAT0 hconjA hramtw hφ1)
  · -- otherwise `φ` ramifies on the inertia and `hxold` gives a coboundary
    left
    have hgenψ : ∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧ D.psi τ = D.psi σ := by
      rcases hdich with h | ⟨_, h⟩
      · exact absurd h hφ1
      · exact h
    have hex : ∃ σ ∈ SSGRoute.decomp ℚ A, D.phi σ ≠ 1 := by
      by_contra h
      exact hφ1 (fun σ hσ => by_contra fun hne => h ⟨σ, hσ, hne⟩)
    obtain ⟨σ, hσD, hσne⟩ := hex
    obtain ⟨τ, hτI, hτeq⟩ := hgenψ σ hσD
    have hφτ : D.phi τ ≠ 1 := by
      intro hh
      apply hσne
      calc D.phi σ = flowGroupProj p (K ≃ₐ[ℚ] K) n i j (D.psi σ) := (hproj σ).symm
        _ = flowGroupProj p (K ≃ₐ[ℚ] K) n i j (D.psi τ) := by rw [hτeq]
        _ = D.phi τ := hproj τ
        _ = 1 := hh
    exact hxold A hAfin hconjA ⟨τ, hτI, hDK τ hτI.1, hφτ⟩

end Work.SSGRoute
