/-!
# Local Kummer reciprocity

Let `k` be a field containing a primitive `p`-th root of unity `ζ` (`p` prime) and let `K'` be a
separable closure of `k`.  The **Kummer character** of a unit `a ∈ kˣ` (the homomorphism
`χ_a : Gal(K'/k) → 𝔽_p^*` sending `σ` to the exponent `i` with `σ(kRoot a) = ζ^i kRoot a`) is
locally constant and depends only on the class of `a` in `kˣ/(kˣ)^p`, and it vanishes exactly on
the `p`-th powers.  The resulting homomorphism

  `kˣ/(kˣ)^p →* lcHoms p Gal(K'/k)`

is in fact an isomorphism.

The target `local_kummer_reciprocity` is the special case `k = q.adicCompletion K` of a number
field `K` at a finite place `q` (with `ζ_p` assumed to exist in the completion).
-/

set_option linter.style.haveILetI false

namespace Work.SSGRoute

open IntermediateField

noncomputable section

/-! ## Two auxiliary facts: fixing subgroups and Kummer fields -/

/-- The fixing subgroup of the simple extension `k⟮α⟯` is exactly the set of `k`-algebra
automorphisms fixing `α`. -/
theorem mem_fixingSubgroup_adjoin_simple {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    (α : K') (σ : K' ≃ₐ[k] K') :
    σ ∈ (IntermediateField.adjoin k {α}).fixingSubgroup ↔ σ α = α := by
  constructor
  · intro h
    rw [IntermediateField.mem_fixingSubgroup_iff] at h
    exact h α (IntermediateField.mem_adjoin_simple_self k α)
  · intro h
    have hα : α ∈ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      rw [IntermediateField.mem_fixedField_iff]
      intro τ hτ
      have hstab : σ ∈ MulAction.stabilizer (K' ≃ₐ[k] K') α := by
        rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]; exact h
      have hτ' : τ ∈ MulAction.stabilizer (K' ≃ₐ[k] K') α :=
        Subgroup.zpowers_le.mpr hstab hτ
      rwa [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at hτ'
    have hle : IntermediateField.adjoin k {α} ≤ IntermediateField.fixedField (Subgroup.zpowers σ) :=
      IntermediateField.adjoin_le_iff.mpr (by rintro x rfl; exact hα)
    exact (IntermediateField.le_iff_le (Subgroup.zpowers σ) _).mp hle (Subgroup.mem_zpowers σ)

/-- The Kummer field `k(a^{1/p})` is generated by any single `p`-th root of `a`. -/
theorem kummerField_eq_adjoin_root {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    [IsSepClosure k K'] (p : ℕ) (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (a : kˣ) (α : K') (hα : α ^ p = algebraMap k K' (a : k)) :
    Work.SSGRoute.kummerField (K' := K') p a = IntermediateField.adjoin k {α} := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  apply le_antisymm
  · rw [Work.SSGRoute.kummerField, NK.LocalAnabelian.kummerField_le_iff]
    intro β hβ
    have hα0 : α ≠ 0 := by
      rintro rfl
      rw [zero_pow hp.ne_zero] at hα
      exact Units.ne_zero a ((RingHom.injective (algebraMap k K')) (by simpa using hα.symm))
    have ha0 : ((a : kˣ) : k) ≠ 0 := Units.ne_zero a
    have hba : (β / α) ^ p = 1 := by
      rw [div_pow, hβ, hα, div_self ((map_ne_zero_iff _ (RingHom.injective _)).mpr ha0)]
    obtain ⟨i, -, hi⟩ :=
      (hζ.map_of_injective (RingHom.injective (algebraMap k K'))).eq_pow_of_pow_eq_one hba
    have hβeq : β = α * (algebraMap k K' ζ) ^ i := by
      rw [hi]
      exact (mul_div_cancel₀ β hα0).symm
    rw [hβeq, ← map_pow]
    exact mul_mem (IntermediateField.mem_adjoin_simple_self k α)
      (IntermediateField.algebraMap_mem _ (ζ ^ i))
  · rw [IntermediateField.adjoin_simple_le_iff]
    exact NK.LocalAnabelian.mem_kummerField_of_pow_eq hα

/-! ## Group theory: two characters with the same kernel differ by a power -/

/-- Two monoid homomorphisms into the group `𝔽_p^*` of prime order `p` with the same kernel and
with the first nontrivial differ by a pointwise power. -/
theorem exists_pow_eq_of_ker_eq {G : Type*} [Group G] {p : ℕ} [Fact p.Prime]
    (φ ψ : G →* Multiplicative (ZMod p)) (hφ : φ ≠ 1) (hker : φ.ker = ψ.ker) :
    ∃ m : ℕ, ∀ g : G, ψ g = φ g ^ m := by
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  have hex : ∃ τ : G, φ τ ≠ 1 := by
    by_contra h
    apply hφ
    ext g
    by_contra hg
    exact h ⟨g, hg⟩
  obtain ⟨τ, hτ⟩ := hex
  have hgen : ∀ y : Multiplicative (ZMod p), ∃ m : ℕ, y = φ τ ^ m := by
    intro y
    have hu0 : Multiplicative.toAdd (φ τ) ≠ 0 := by
      intro h
      exact hτ ((Multiplicative.toAdd).injective (by simpa using h))
    refine ⟨((Multiplicative.toAdd (φ τ))⁻¹ * Multiplicative.toAdd y).val, ?_⟩
    apply (Multiplicative.toAdd).injective
    rw [toAdd_pow, nsmul_eq_mul, ZMod.natCast_zmod_val, mul_assoc,
      mul_comm (Multiplicative.toAdd y) (Multiplicative.toAdd (φ τ)), ← mul_assoc,
      inv_mul_cancel₀ hu0, one_mul]
  obtain ⟨m, hm⟩ := hgen (ψ τ)
  refine ⟨m, fun g => ?_⟩
  obtain ⟨n, hn⟩ := hgen (φ g)
  have hmem : g * τ ^ (-(n : ℤ)) ∈ φ.ker := by
    rw [MonoidHom.mem_ker, map_mul, hn, map_zpow, ← zpow_natCast (φ τ) n, ← zpow_add,
      add_neg_cancel, zpow_zero]
  have hmemψ : g * τ ^ (-(n : ℤ)) ∈ ψ.ker := by rw [hker] at hmem; exact hmem
  have hg : ψ g = (ψ τ) ^ n := by
    have h2 : ψ g * (ψ τ) ^ (-(n : ℤ)) = 1 := by
      have h := MonoidHom.mem_ker.mp hmemψ
      rwa [map_mul, map_zpow] at h
    have h3 : ((ψ τ) ^ (-(n : ℤ))) * ((ψ τ) ^ ((n : ℤ))) = 1 := by
      rw [← zpow_add, neg_add_cancel, zpow_zero]
    calc ψ g = ψ g * ((ψ τ) ^ (-(n : ℤ)) * (ψ τ) ^ ((n : ℤ))) := by rw [h3, mul_one]
      _ = (ψ g * (ψ τ) ^ (-(n : ℤ))) * (ψ τ) ^ ((n : ℤ)) := by rw [mul_assoc]
      _ = (ψ τ) ^ ((n : ℤ)) := by rw [h2, one_mul]
      _ = (ψ τ) ^ n := by rw [zpow_natCast]
  rw [hg, hm, hn, ← pow_mul, ← pow_mul, mul_comm]

/-! ## Galois theory: a nontrivial locally constant character has a degree-`p` fixed field -/

/-- A nontrivial locally constant character `χ : Gal(K'/k) → 𝔽_p^*` has fixed field a finite
Galois extension of degree `p` with fixing subgroup `ker χ`. -/
theorem exists_isGalois_finrank_eq_of_isLocallyConstant {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] [IsGalois k K'] {p : ℕ} [Fact p.Prime]
    (χ : (K' ≃ₐ[k] K') →* Multiplicative (ZMod p)) (hχ : IsLocallyConstant χ) (hne : χ ≠ 1) :
    ∃ E : IntermediateField k K', IsGalois k E ∧ Module.finrank k E = p ∧
      E.fixingSubgroup = χ.ker := by
  have hopen : IsOpen (χ.ker : Set (K' ≃ₐ[k] K')) := by
    have h := hχ.isOpen_fiber (1 : Multiplicative (ZMod p))
    have hset : (χ.ker : Set (K' ≃ₐ[k] K')) = {x | χ x = 1} := by
      ext x; exact MonoidHom.mem_ker
    rwa [hset]
  have hclosed : IsClosed (χ.ker : Set (K' ≃ₐ[k] K')) := Subgroup.isClosed_of_isOpen χ.ker hopen
  have hfixE : (IntermediateField.fixedField χ.ker).fixingSubgroup = χ.ker :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨χ.ker, hclosed⟩
  refine ⟨IntermediateField.fixedField χ.ker, ?_, ?_, hfixE⟩
  · rw [← InfiniteGalois.normal_iff_isGalois]
    rw [hfixE]
    infer_instance
  · have hfin : FiniteDimensional k ↥(IntermediateField.fixedField χ.ker) :=
      (InfiniteGalois.isOpen_iff_finite (IntermediateField.fixedField χ.ker)).mp (by
        rw [hfixE]; exact hopen)
    haveI := hfin
    rw [← IsGalois.card_aut_eq_finrank k (IntermediateField.fixedField χ.ker)]
    have hcard : Nat.card (Multiplicative (ZMod p)) = p := by
      rw [Nat.card_congr Multiplicative.toAdd, Nat.card_zmod]
    have htop : χ.range = ⊤ := by
      haveI : Fact (Nat.Prime (Nat.card (Multiplicative (ZMod p)))) :=
        ⟨by rw [hcard]; exact Fact.out⟩
      rcases Subgroup.eq_bot_or_eq_top_of_prime_card χ.range with h | h
      · exact absurd (MonoidHom.range_eq_bot_iff.mp h) hne
      · exact h
    have h1 : Nat.card (IntermediateField.fixedField χ.ker ≃ₐ[k] IntermediateField.fixedField χ.ker)
        = Nat.card χ.range := by
      rw [← Nat.card_congr (InfiniteGalois.normalAutEquivQuotient ⟨χ.ker, hclosed⟩).toEquiv,
        Nat.card_congr (QuotientGroup.quotientKerEquivRange χ).toEquiv]
    rw [h1, htop, Nat.card_congr (Subgroup.topEquiv).toEquiv]
    exact hcard

section General

variable {k K' : Type*} [Field k] [Field K'] [Algebra k K'] [IsSepClosure k K']
variable {p : ℕ} [Fact p.Prime] {ζ : k} (hζ : IsPrimitiveRoot ζ p)

/-- The kernel of the Kummer character `χ_a` is the fixing subgroup of `k⟮kRoot a⟯`. -/
theorem kChar_ker_eq (a : kˣ) :
    (kChar (K' := K') hζ a).ker =
      (IntermediateField.adjoin k {kRoot (K' := K') hζ a}).fixingSubgroup := by
  ext σ
  rw [MonoidHom.mem_ker, mem_fixingSubgroup_adjoin_simple (kRoot (K' := K') hζ a) σ]
  exact kChar_eq_one_iff_root hζ a σ

/-- Every nontrivial locally constant character is a Kummer character `χ_a`. -/
theorem exists_kChar_eq_of_ne_one (χ : ↥(lcHoms p (K' ≃ₐ[k] K'))) (hne : χ.1 ≠ 1) :
    ∃ a : kˣ, kChar (K' := K') hζ a = χ.1 := by
  haveI : IsGalois k K' := inferInstance
  obtain ⟨E, hgal, hfr, hfixE⟩ := exists_isGalois_finrank_eq_of_isLocallyConstant χ.1 χ.2 hne
  obtain ⟨x, hx⟩ := NK.LocalAnabelian.Kummer.exists_kummerFieldQuot_eq_of_isGalois (K' := K') p
    (Fact.out : p.Prime) hζ E hgal hfr
  set a : kˣ := Quotient.out x with ha_def
  have hq : (a : NK.LocalAnabelian.KummerGroup p k) = x := by
    rw [ha_def]; exact Quotient.out_eq x
  have ha : Work.SSGRoute.kummerField (K' := K') p a = E := by
    rw [Work.SSGRoute.kummerField, ← NK.LocalAnabelian.kummerFieldQuot_mk (K' := K') p a, hq, hx]
  have hkerChar : (kChar (K' := K') hζ a).ker = χ.1.ker := by
    rw [kChar_ker_eq hζ a,
      ← kummerField_eq_adjoin_root (K' := K') p (Fact.out : p.Prime) hζ a
        (kRoot (K' := K') hζ a) (kRoot_pow hζ a), ha, hfixE]
  have hcne : kChar (K' := K') hζ a ≠ 1 := by
    intro hc
    apply hne
    have htop : χ.1.ker = ⊤ := by rw [← hkerChar, hc]; simp
    ext g
    have hg : g ∈ χ.1.ker := by rw [htop]; exact Subgroup.mem_top g
    simpa using MonoidHom.mem_ker.mp hg
  obtain ⟨m, hm⟩ := exists_pow_eq_of_ker_eq (kChar (K' := K') hζ a) χ.1 hcne hkerChar
  refine ⟨a ^ m, ?_⟩
  ext σ
  rw [kChar_pow, MonoidHom.pow_apply]
  exact (hm σ).symm

end General

/-- **Kummer reciprocity over a field containing `ζ_p`.**  The Kummer character map is an
isomorphism `kˣ/(kˣ)^p ≃ Hom_cont(Gal(K'/k), 𝔽_p)`. -/
theorem kummer_reciprocity_general {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    [IsSepClosure k K'] (p : ℕ) [Fact p.Prime] {ζ : k} (hζ : IsPrimitiveRoot ζ p) :
    Nonempty (NK.LocalAnabelian.KummerGroup p k ≃* ↥(lcHoms p (K' ≃ₐ[k] K'))) := by
  haveI : IsGalois k K' := inferInstance
  have hker : NK.LocalAnabelian.powSubgroup p k ≤ (kCharHom (K' := K') hζ).ker := by
    intro a ha
    rw [MonoidHom.mem_ker]
    exact Subtype.ext (kChar_eq_one_of_mem_powSubgroup (K' := K') hζ a ha)
  let φ : NK.LocalAnabelian.KummerGroup p k →* ↥(lcHoms p (K' ≃ₐ[k] K')) :=
    QuotientGroup.lift (NK.LocalAnabelian.powSubgroup p k) (kCharHom (K' := K') hζ) hker
  have hφ : ∀ a : kˣ, φ (QuotientGroup.mk a) = kCharHom (K' := K') hζ a := fun a => rfl
  refine ⟨MulEquiv.ofBijective φ ⟨?_, ?_⟩⟩
  · rw [injective_iff_map_eq_one]
    intro x hx
    obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective x
    rw [hφ] at hx
    have h1 : kChar (K' := K') hζ a = 1 := Subtype.ext_iff.mp hx
    exact (QuotientGroup.eq_one_iff a).mpr ((kChar_eq_one_iff (K' := K') hζ a).mp h1)
  · intro χ
    by_cases h1 : χ.1 = 1
    · refine ⟨1, ?_⟩
      rw [map_one]
      exact Subtype.ext h1.symm
    · obtain ⟨a, ha⟩ := exists_kChar_eq_of_ne_one (K' := K') hζ χ h1
      exact ⟨QuotientGroup.mk a, by rw [hφ]; exact Subtype.ext ha⟩

/-! ## The target -/

theorem local_kummer_reciprocity (p : ℕ) [Fact p.Prime] {K : Type} [Field K] [NumberField K]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hζ : ∃ ζ : q.adicCompletion K, IsPrimitiveRoot ζ p) :
    Nonempty (NK.LocalAnabelian.KummerGroup p (q.adicCompletion K) ≃*
      ↥(Work.SSGRoute.lcHoms p ((AlgebraicClosure (q.adicCompletion K)) ≃ₐ[q.adicCompletion K]
        (AlgebraicClosure (q.adicCompletion K))))) := by
  obtain ⟨ζ, hζ⟩ := hζ
  haveI : CharZero (q.adicCompletion K) :=
    Commons.NumberTheory.NumberField.charZero_adicCompletion q
  haveI : IsSepClosure (q.adicCompletion K) (AlgebraicClosure (q.adicCompletion K)) :=
    inferInstance
  exact kummer_reciprocity_general (K' := AlgebraicClosure (q.adicCompletion K)) p hζ

end

