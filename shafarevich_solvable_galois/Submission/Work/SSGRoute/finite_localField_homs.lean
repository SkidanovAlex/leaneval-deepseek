/-!
# Finiteness of the continuous homomorphisms of a local Galois group

The target `Work.SSGRoute.finite_localField_homs`: for a number field `K`, a height-one prime `𝔭`
of its ring of integers and a finite `𝔽_p`-module `M`, the group homomorphisms
`Gal(SeparableClosure κ / κ) →* Multiplicative M` (κ = `𝔭.adicCompletion K`) whose kernel is open
for the Krull topology form a finite set.

## Route

1. **Abstract part** (`finite_homs_of_prime_homs`): if for every prime `l` there are only finitely
   many open-kernel homs `G →* Multiplicative (ZMod l)`, then the same holds for every finite
   abelian target (`Multiplicative M`).  Strong induction on `Nat.card`, Cauchy's theorem, and the
   reduction along `S →* S ⧸ N` for `N` a subgroup of prime order, with Mathlib's structure theory
   of finite abelian groups (`zmodCyclicMulEquiv`) transporting the hypothesis to groups of prime
   order.
2. **Arithmetic part** (`finite_cyclic_homs_adicCompletion`): for every prime `l` the open-kernel
   homomorphisms `Gal(SeparableClosure κ / κ) →* Multiplicative (ZMod l)` are finite.  Let
   `K₀ = κ⟮ζ⟯` be the extension generated by a primitive `l`-th root of unity
   (`[K₀ : κ] ≤ l - 1`, hence `[K₀ : κ] < l`).
   * Restriction to `Gal(SeparableClosure κ / K₀)` is injective (`finite_homs_of_restriction`),
     because a hom into a group of order `l` which is trivial on a subgroup of index `> 1` and
     `< l` is trivial.
   * Over `K₀`, which contains `ζ_l`, Kummer theory counts the degree-`l` Galois extensions by the
     `l`-th power class group `K₀ˣ ⧸ (K₀ˣ)^l` (`finite_galoisFields_of_finite_kummer`), and
     finiteness of the degree-`l` Galois extensions gives finiteness of the open-kernel homs into
     `Multiplicative (ZMod l)` (`finite_homs_of_finite_galoisFields`).
   * `K₀ˣ ⧸ (K₀ˣ)^l` is finite because `K₀` is a non-archimedean local field of characteristic zero
     (`finite_powClass_localField`), the structure of `K₀` being supplied by
     `NK.LocalReciprocityLubinTate.Eval.exists_isNonarchimedeanLocalField_intermediateField`.
-/

open scoped Classical

namespace Work.SSGRoute

noncomputable section

/-! ## The arithmetic input for a `p`-adic field -/

/-- **For every prime `l`, finitely many open-kernel homomorphisms of the absolute Galois group of
a `p`-adic field into a cyclic group of order `l`.** -/
theorem finite_cyclic_homs_adicCompletion (K : Type) [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (l : ℕ) (hl : l.Prime) :
    Finite {χ : Gal(SeparableClosure (𝔭.adicCompletion K) / (𝔭.adicCompletion K)) →*
        Multiplicative (ZMod l) //
      IsOpen (χ.ker : Set (Gal(SeparableClosure (𝔭.adicCompletion K) / (𝔭.adicCompletion K))))} := by
  classical
  -- a primitive `l`-th root of unity in the separable closure of `κ = 𝔭.adicCompletion K`
  haveI : NeZero ((l : ℕ) : SeparableClosure (𝔭.adicCompletion K)) :=
    ⟨fun hl0 => hl.ne_zero (Nat.cast_eq_zero.mp hl0)⟩
  obtain ⟨ζ, hζ⟩ :=
    HasEnoughRootsOfUnity.exists_primitiveRoot (SeparableClosure (𝔭.adicCompletion K)) l
  -- the extension it generates
  let L : IntermediateField (𝔭.adicCompletion K) (SeparableClosure (𝔭.adicCompletion K)) :=
    IntermediateField.adjoin (𝔭.adicCompletion K) {ζ}
  have hmem : ζ ∈ L :=
    IntermediateField.subset_adjoin (𝔭.adicCompletion K) {ζ} (Set.mem_singleton ζ)
  have hint : IsIntegral (𝔭.adicCompletion K) ζ :=
    ⟨Polynomial.X ^ l - Polynomial.C 1, Polynomial.monic_X_pow_sub_C 1 hl.ne_zero, by
      have : Polynomial.eval₂ (algebraMap (𝔭.adicCompletion K)
          (SeparableClosure (𝔭.adicCompletion K))) ζ
          (Polynomial.X ^ l - Polynomial.C 1 : Polynomial (𝔭.adicCompletion K)) = ζ ^ l - 1 := by
        simp
      rw [this, hζ.pow_eq_one, sub_self]⟩
  haveI hfd : FiniteDimensional (𝔭.adicCompletion K) L :=
    IntermediateField.adjoin.finiteDimensional (K := 𝔭.adicCompletion K) hint
  -- the local field structure on `L`
  obtain ⟨instV, instT, hloc⟩ :=
    NK.LocalReciprocityLubinTate.Eval.exists_isNonarchimedeanLocalField_intermediateField 𝔭 L
  letI : ValuativeRel ↥L := instV
  letI : TopologicalSpace ↥L := instT
  haveI : IsNonarchimedeanLocalField ↥L := hloc
  haveI : CharZero ↥L :=
    ⟨fun a b h => Nat.cast_injective (R := SeparableClosure (𝔭.adicCompletion K))
      (by simpa using congrArg (fun x : ↥L => (x : SeparableClosure (𝔭.adicCompletion K))) h)⟩
  -- finiteness of the Kummer class group of `L`
  haveI : Finite (NK.LocalAnabelian.KummerGroup l ↥L) := finite_powClass_localField ↥L l hl
  -- `SeparableClosure κ` is a separable closure of `L` as well
  haveI : Algebra.IsAlgebraic ↥L (SeparableClosure (𝔭.adicCompletion K)) := inferInstance
  haveI : IsSepClosure ↥L (SeparableClosure (𝔭.adicCompletion K)) :=
    ⟨inferInstance, Algebra.IsAlgebraic.isSeparable_of_perfectField⟩
  -- `ζ` viewed in `L` is a primitive `l`-th root of unity
  have hζL : IsPrimitiveRoot (⟨ζ, hmem⟩ : ↥L) l :=
    IsPrimitiveRoot.of_map_of_injective
      (f := algebraMap ↥L (SeparableClosure (𝔭.adicCompletion K)))
      (by simpa using hζ) (fun x y h => Subtype.ext h)
  -- Kummer: finitely many degree-`l` Galois extensions of `L`
  haveI hGF : Finite {L' : IntermediateField ↥L (SeparableClosure (𝔭.adicCompletion K)) //
      IsGalois ↥L L' ∧ Module.finrank ↥L L' = l} :=
    finite_galoisFields_of_finite_kummer (k := ↥L)
      (K' := SeparableClosure (𝔭.adicCompletion K)) l hl ⟨ζ, hmem⟩ hζL
  -- hence finitely many open-kernel homs on `Gal(Ω/L)`
  have hGL : Finite {ψ : Gal(SeparableClosure (𝔭.adicCompletion K) / ↥L) →*
      Multiplicative (ZMod l) //
      IsOpen (ψ.ker : Set Gal(SeparableClosure (𝔭.adicCompletion K) / ↥L))} :=
    finite_homs_of_finite_galoisFields (k := ↥L)
      (K' := SeparableClosure (𝔭.adicCompletion K)) l hl hGF
  -- the degree of `L/κ` is `< l`
  have hdeg : Module.finrank (𝔭.adicCompletion K) L < l := by
    have hfr : Module.finrank (𝔭.adicCompletion K) L =
        (minpoly (𝔭.adicCompletion K) ζ).natDegree :=
      IntermediateField.adjoin.finrank (K := 𝔭.adicCompletion K) hint
    have hPhi_ne :
        (∑ i ∈ Finset.range l, (Polynomial.X ^ i : Polynomial (𝔭.adicCompletion K))) ≠ 0 := by
      intro h0
      have hmul : (∑ i ∈ Finset.range l,
            (Polynomial.X ^ i : Polynomial (𝔭.adicCompletion K))) * (Polynomial.X - 1)
          = Polynomial.X ^ l - 1 := by
        simpa using geom_sum_mul (Polynomial.X : Polynomial (𝔭.adicCompletion K)) l
      rw [h0, zero_mul] at hmul
      have hmon : (Polynomial.X ^ l - 1 : Polynomial (𝔭.adicCompletion K)).Monic := by
        simpa using Polynomial.monic_X_pow_sub_C (1 : 𝔭.adicCompletion K) hl.ne_zero
      exact hmon.ne_zero hmul.symm
    have hdvd : minpoly (𝔭.adicCompletion K) ζ ∣
        (∑ i ∈ Finset.range l, (Polynomial.X ^ i : Polynomial (𝔭.adicCompletion K))) := by
      refine minpoly.dvd _ _ ?_
      have : Polynomial.aeval ζ (∑ i ∈ Finset.range l,
          (Polynomial.X ^ i : Polynomial (𝔭.adicCompletion K)))
          = ∑ i ∈ Finset.range l, ζ ^ i := by
        rw [map_sum]
        simp
      rw [this]
      exact hζ.geom_sum_eq_zero hl.one_lt
    have hdle :
        (∑ i ∈ Finset.range l, (Polynomial.X ^ i : Polynomial (𝔭.adicCompletion K))).natDegree
          ≤ l - 1 := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro m hm
      rw [Polynomial.finsetSum_coeff]
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [Polynomial.coeff_X_pow]
      by_cases h : m = i
      · exfalso
        have := Finset.mem_range.mp hi
        omega
      · simp [h]
    have hle : (minpoly (𝔭.adicCompletion K) ζ).natDegree ≤ l - 1 :=
      le_trans (Polynomial.natDegree_le_of_dvd hdvd hPhi_ne) hdle
    have hl1 : 1 ≤ l := hl.one_le
    rw [hfr]
    omega
  exact finite_homs_of_restriction L l hl hdeg hGL

/-! ## The main theorem -/

/-! ## Proof notes (how this file is proved)

* The abstract reduction `finite_homs_of_prime_homs` (`Submission/Work/SSGRoute/finite_homs_of_prime_homs.lean`)
  shows that it suffices to handle a cyclic target `Multiplicative (ZMod l)` of prime order `l`: for
  a finite abelian target one inducts on its cardinality, using Cauchy's theorem and the reduction
  along `S →* S ⧸ N` for `N` of prime order.
* `finite_cyclic_homs_adicCompletion` below supplies the prime case.  Kummer theory over
  `κ⟮ζ_l⟯` (whose degree over `κ` is `< l`) identifies the open-kernel homomorphisms into
  `Multiplicative (ZMod l)` with the degree-`l` Galois extensions
  (`finite_galoisFields_of_finite_kummer`, `finite_homs_of_finite_galoisFields`), and the latter are
  finite because the `l`-th power class group of the local field `κ⟮ζ_l⟯` is finite
  (`finite_powClass_localField`, from the higher unit filtration of a `p`-adic field), while
  finiteness descends from `κ⟮ζ_l⟯` to `κ` by restriction (`finite_homs_of_restriction`). -/

/-- **Finiteness of the continuous homomorphisms of a local Galois group** (the arithmetic input
`Work.SSGRoute.finite_localField_homs`).  For a number field `K`, a height-one prime `𝔭` of its ring
of integers and a finite `𝔽_p`-module `M`, the group homomorphisms
`Gal(SeparableClosure κ / κ) →* Multiplicative M` (κ = `𝔭.adicCompletion K`) with *open* kernel form a
finite set.

The statement below is **exactly** the shape required by its consumer
`Submission/Work/SSGRoute/finite_openKernel_homs_decomp_kernel.lean`, which applies it as
`finite_localField_homs ↥K 𝔭 p M` (there `𝔭 = Submission.NeukirchUchida.primeOf A hAK`,
κ = `𝔭.adicCompletion ↥K`, and the local group is `Gal(SeparableClosure κ/κ)`, identified
homeomorphically with `decomp k A ⊓ K.fixingSubgroup`); that consumer, and
`Submission/Work/SSGRoute/local_tate_duality_finite.lean` on top of it, are otherwise free of
placeholders, and the statement formalised here matches the one they expect verbatim.

PROOF NOTES / WHERE THE MATHEMATICS LIVES.
* `κ = 𝔭.adicCompletion K` is a nonarchimedean local field (`IsDedekindDomain.HeightOneSpectrum.adicCompletion`
  is a `Field`; the residue field is finite), and `Gal(SeparableClosure κ/κ)` carries the Krull
  topology (`KrullTopology.lean`), which is the topology meant by `IsOpen`.
* Equivalent formulation: a hom with open kernel kills an open normal subgroup of index at most
  `|M|`, so the set is finite as soon as `κ` has only finitely many extensions of each bounded
  degree, equivalently `G_κ` is topologically finitely generated (Jannsen–Wingberg).
* The workspace has a large local-CFT library under `Submission/NK/` — notably `NK/LocalCFT`,
  `NK/LocalStructure`, `NK/LocalReciprocity`, `NK/LocalArtin`, `NK/LocalKW`, `NK/LocalField`,
  `NK/LocalDecomposition`, `NK/NUV2/LC`, `NK/NeukirchUchida` — so search there before building local
  field theory from scratch; the reciprocity isomorphism `G_κ^ab ≅ \hat{κ^×}` plus
  `κ^× ≅ ℤ × μ_{q-1} × ℤ_p^{[κ:ℚ_p]}` (the `κ^×` structure theory) is the natural route: an abelian
  finite `M` forces every such `χ` to factor through `G_κ^ab`, and `Hom_cts(\hat{κ^×}, M)` is finite
  because `κ^×` has finitely many open subgroups of bounded index. -/
theorem finite_localField_homs (K : Type) [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (p : ℕ) (M : Type) [AddCommGroup M] [Module (ZMod p) M] [Finite M] :
    Finite {χ : Gal(SeparableClosure (𝔭.adicCompletion K) / (𝔭.adicCompletion K)) →* Multiplicative M //
      IsOpen (χ.ker : Set (Gal(SeparableClosure (𝔭.adicCompletion K) / (𝔭.adicCompletion K))))} := by
  exact finite_homs_of_prime_homs
    (G := Gal(SeparableClosure (𝔭.adicCompletion K) / (𝔭.adicCompletion K)))
    (fun l hl => finite_cyclic_homs_adicCompletion K 𝔭 l hl) M

end

end Work.SSGRoute
