namespace Work.SSGRoute

/-- Given a finite Galois extension `L/k` (sitting inside an algebraically closed
field `Ω`), every unit `x` of `L` has a `p`-th root in some finite Galois extension
`L'` of `k` containing `L`.

The proof adjoins a `p`-th root `y` of `x` (which exists because `Ω` is algebraically
closed) to `L`, and then passes to the normal closure of the resulting field inside
`Ω`. The normal closure is finite over `k` because the extension is generated by an
integral element, it is normal by construction, and it is separable because `k` has
characteristic zero. -/
theorem exists_level_pthRoot (p : ℕ) [Fact p.Prime] (k K : Type) [Field k] [NumberField k]
    [Field K] [NumberField K] [Algebra k K] [FiniteDimensional k K] [IsGalois k K]
    (Ω : Type) [Field Ω] [IsAlgClosed Ω] [Algebra K Ω] [Algebra k Ω] [IsScalarTower k K Ω]
    (L : IntermediateField K Ω) [NumberField L] [FiniteDimensional k L] [IsGalois k L]
    (x : Lˣ) :
    ∃ (L' : IntermediateField K Ω) (_ : NumberField L') (_ : FiniteDimensional k L')
      (_ : IsGalois k L') (hLL : L ≤ L'),
      ∃ y : L'ˣ, Units.map (IntermediateField.inclusion hLL).toMonoidHom x = y ^ p := by
  -- `a` is `x` viewed as an element of `Ω`.
  let a : Ω := algebraMap L Ω (x : L)
  have ha : a ≠ 0 := by
    simp only [a, ne_eq, map_eq_zero]
    exact Units.ne_zero x
  have hpp : 0 < p := (Fact.out : p.Prime).pos
  have hpne : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  -- A `p`-th root `y` of `a` exists in `Ω`, since `Ω` is algebraically closed.
  obtain ⟨y, hy⟩ := IsAlgClosed.exists_root (Polynomial.X ^ p - Polynomial.C a)
    (by rw [Polynomial.degree_X_pow_sub_C hpp a]; exact_mod_cast hpne)
  have hy' : y ^ p = a := by
    rw [Polynomial.IsRoot.def] at hy
    simp only [Polynomial.eval_sub, Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_C] at hy
    exact sub_eq_zero.mp hy
  -- `y` is integral over `k`.
  haveI hIntL : Algebra.IsIntegral k L := Algebra.IsIntegral.of_finite k L
  have hxint : IsIntegral k (x : L) := Algebra.IsIntegral.isIntegral (x : L)
  haveI hST : IsScalarTower k ↥L Ω := by
    apply IsScalarTower.of_algebraMap_eq
    intro c
    rw [IntermediateField.algebraMap_apply, IsScalarTower.algebraMap_apply k K ↥L,
      ← IntermediateField.algebraMap_apply L, ← IsScalarTower.algebraMap_apply K ↥L Ω,
      IsScalarTower.algebraMap_apply k K Ω]
  have haint : IsIntegral k a := by
    have h := IsIntegral.map (IsScalarTower.toAlgHom k ↥L Ω) hxint
    simpa only [a, IsScalarTower.toAlgHom_apply] using h
  have hyint : IsIntegral k y := by
    apply IsIntegral.of_pow hpp
    rw [hy']; exact haint
  -- The field `M = L(y)` generated by `L` and `y` inside `Ω`, over the base `k`.
  let M : IntermediateField k Ω := (L.restrictScalars k) ⊔ IntermediateField.adjoin k ({y} : Set Ω)
  have hLfin : FiniteDimensional k ↥(L.restrictScalars k) := inferInstanceAs (FiniteDimensional k ↥L)
  have hyfin : FiniteDimensional k ↥(IntermediateField.adjoin k ({y} : Set Ω)) :=
    IntermediateField.adjoin.finiteDimensional hyint
  haveI hMfin : FiniteDimensional k ↥M := IntermediateField.finiteDimensional_sup _ _
  haveI hMalg : Algebra.IsAlgebraic k ↥M := Algebra.IsAlgebraic.of_finite k ↥M
  -- The normal closure `N` of `M/k` inside `Ω`.
  let N : IntermediateField k Ω := IntermediateField.normalClosure k ↥M Ω
  haveI hNfin : FiniteDimensional k ↥N := normalClosure.is_finiteDimensional k ↥M Ω
  have hMN : M ≤ N := IntermediateField.le_normalClosure M
  have hIN : IsNormalClosure k ↥M ↥N :=
    Algebra.IsAlgebraic.isNormalClosure_normalClosure (fun z => IsAlgClosed.splits _)
  haveI hNnorm : Normal k ↥N := hIN.normal
  haveI hNint : Algebra.IsIntegral k ↥N := Algebra.IsIntegral.of_finite k ↥N
  haveI hNsep : Algebra.IsSeparable k ↥N := Algebra.IsSeparable.of_integral k ↥N
  have hNgal : IsGalois k ↥N := isGalois_iff.mpr ⟨hNsep, hNnorm⟩
  -- `N` contains the image of `K` in `Ω`, so it can be regarded as an
  -- `IntermediateField K Ω` (with the same underlying subfield of `Ω`).
  have hKN : (⊥ : IntermediateField K Ω).restrictScalars k ≤ N := by
    have h1 : (⊥ : IntermediateField K Ω).restrictScalars k ≤ L.restrictScalars k := by
      rw [IntermediateField.restrictScalars_le_iff]; exact bot_le
    exact le_trans h1 (le_trans le_sup_left hMN)
  have hmemL' : ∀ t : K, algebraMap K Ω t ∈ (N : Set Ω) := fun t =>
    hKN (by rw [IntermediateField.mem_restrictScalars]; exact IntermediateField.mem_bot.mpr ⟨t, rfl⟩)
  let L' : IntermediateField K Ω := { N.toSubfield with algebraMap_mem' := hmemL' }
  haveI hL'fin : FiniteDimensional k L' := inferInstanceAs (FiniteDimensional k ↥N)
  haveI hL'gal : IsGalois k L' := inferInstanceAs (IsGalois k ↥N)
  haveI hL'cz : CharZero L' := inferInstanceAs (CharZero ↥N)
  haveI hL'fdq : FiniteDimensional ℚ L' := FiniteDimensional.trans ℚ k L'
  haveI hL'NF : NumberField L' := NumberField.mk
  have hLM : L.restrictScalars k ≤ M := le_sup_left
  have hLL : L ≤ L' := fun z hz => hMN (hLM hz)
  have hAsup : IntermediateField.adjoin k ({y} : Set Ω) ≤ M := le_sup_right
  have hyM : y ∈ M := hAsup (IntermediateField.mem_adjoin_simple_self k y)
  have hyN : y ∈ N := hMN hyM
  have hyL' : y ∈ L' := hyN
  have hyne0 : y ≠ 0 := by
    intro h0
    rw [h0, zero_pow hpne] at hy'
    exact ha hy'.symm
  have hyne : (⟨y, hyL'⟩ : ↥L') ≠ 0 := by
    intro h0
    apply hyne0
    have h1 := congrArg (fun z : ↥L' => (z : Ω)) h0
    simpa using h1
  refine ⟨L', hL'NF, hL'fin, hL'gal, hLL, ?_⟩
  refine ⟨Units.mk0 ⟨y, hyL'⟩ hyne, ?_⟩
  apply Units.ext
  rw [Units.coe_map, Units.val_pow_eq_pow_val, Units.val_mk0]
  change (IntermediateField.inclusion hLL) (x : ↥L) = (⟨y, hyL'⟩ : ↥L') ^ p
  apply Subtype.ext
  rw [IntermediateField.coe_inclusion, SubmonoidClass.coe_pow]
  show ((x : L) : Ω) = y ^ p
  rw [hy']
  exact (IntermediateField.algebraMap_apply L (x : L)).symm

end Work.SSGRoute
