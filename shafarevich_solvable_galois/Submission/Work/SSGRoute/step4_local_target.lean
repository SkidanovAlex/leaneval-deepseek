/-! ### Two auxiliary lemmas about `Ẑ` and about open kernels on `G_ℚ` -/

/-- A homomorphism `Ẑ →* X` into a group of exponent dividing `p` which kills the canonical
generator `zhatGen` is trivial: `Ẑ` is generated by `zhatGen` together with the `p`-th powers
(`Work.SSGRoute.zpowers_zhatGen_sup_powSubgroup`), and the `p`-th powers die in `X`. -/
theorem zhat_eq_one_of_zhatGen_eq_one (p : ℕ) (hp : 0 < p) {X : Type*} [Group X]
    (hexp : ∀ x : X, x ^ p = 1) (φ : NK.LocalAnabelian.Zhat →* X)
    (hgen : φ NK.TowerRank.zhatGen = 1) : φ = 1 := by
  refine MonoidHom.ext fun z => ?_
  have hz : z ∈ (⊤ : Subgroup NK.LocalAnabelian.Zhat) := Subgroup.mem_top z
  rw [← zpowers_zhatGen_sup_powSubgroup p hp] at hz
  obtain ⟨a, ha, b, hb, hab⟩ := Subgroup.mem_sup.mp hz
  rw [← hab, map_mul]
  have ha1 : φ a = 1 := by
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp ha
    rw [map_zpow, hgen, one_zpow]
  have hb1 : φ b = 1 := by
    obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hb
    have hy' : y ^ p = b := by simpa [NK.TowerRank.powHom] using hy
    rw [← hy', map_pow]
    exact hexp (φ y)
  rw [ha1, hb1, one_mul, MonoidHom.one_apply]

/-- Any homomorphism from `Ẑ` to a group, evaluated at the canonical generator, may be prescribed
as soon as the prescribed value has order dividing `d`. -/
theorem exists_zhat_hom_zhatGen_eq {X : Type*} [Group X] (x : X) (d : ℕ) (hd : 0 < d)
    (hx : x ^ d = 1) :
    ∃ φ : NK.LocalAnabelian.Zhat →* X, φ NK.TowerRank.zhatGen = x := by
  have hdne : d ≠ 0 := hd.ne'
  have hker : (NK.TameStructure.ProCyclic.mZ d hdne).toSubgroup ≤ (zpowersHom X x).ker := by
    intro z hz
    rw [MonoidHom.mem_ker]
    have hz' : Multiplicative.ofAdd z.toAdd ∈
        (NK.TameStructure.ProCyclic.mZ d hdne).toSubgroup := by rwa [ofAdd_toAdd]
    have hdiv : ((d : ℕ) : ℤ) ∣ z.toAdd :=
      (NK.TameStructure.ProCyclic.mem_mZ d hdne z.toAdd).mp hz'
    obtain ⟨c, hc⟩ := hdiv
    rw [zpowersHom_apply, hc, zpow_mul]
    have h1 : x ^ ((d : ℕ) : ℤ) = 1 := by rw [zpow_natCast, hx]
    rw [h1, one_zpow]
  refine ⟨(QuotientGroup.lift (NK.TameStructure.ProCyclic.mZ d hdne).toSubgroup
    (zpowersHom X x) hker).comp (NK.TameStructure.ProCyclic.compHom d hdne), ?_⟩
  rw [MonoidHom.comp_apply, compHom_zhatGen_eq d hdne,
    QuotientGroup.lift_mk', zpowersHom_apply, toAdd_ofAdd, zpow_one]

/-- The kernel of a homomorphism on the absolute Galois group `G_ℚ = Gal(Q̄/ℚ)` with open kernel
has finite index: an open subgroup of the Krull topology contains the fixing subgroup of a
finite-dimensional intermediate field, and the index of such a fixing subgroup is the degree. -/
theorem finiteIndex_ker_of_isOpen {X : Type*} [Group X] (f : SSGRoute.GalQ →* X)
    (h : IsOpen (f.ker : Set SSGRoute.GalQ)) : f.ker.FiniteIndex := by
  haveI hAlg : IsAlgClosure ℚ (AlgebraicClosure ℚ) := AlgebraicClosure.instIsAlgClosure ℚ
  haveI hGal : IsGalois ℚ SSGRoute.QBar :=
    { to_isSeparable := inferInstance, to_normal := inferInstance }
  obtain ⟨E, hEfin, hE⟩ :=
    (krullTopology_mem_nhds_one_iff ℚ SSGRoute.QBar (f.ker : Set SSGRoute.GalQ)).mp
      (h.mem_nhds (MonoidHom.mem_ker.mpr (map_one f)))
  haveI : FiniteDimensional ℚ ↥E := hEfin
  have hle : E.fixingSubgroup ≤ f.ker := hE
  have hfinE : E.fixingSubgroup.FiniteIndex := by
    rw [Subgroup.finiteIndex_iff,
      ← IntermediateField.finrank_eq_fixingSubgroup_index (F := ℚ) (E' := SSGRoute.QBar) E]
    exact ne_of_gt Module.finrank_pos
  exact Subgroup.finiteIndex_of_le (H := E.fixingSubgroup) hle

/-- A homomorphism with finite index kernel has finite range. -/
theorem finite_range_of_finiteIndex {G' H' : Type*} [Group G'] [Group H'] (φ : G' →* H')
    (h : φ.ker.FiniteIndex) : Finite ↥φ.range := by
  haveI : Finite (G' ⧸ φ.ker) := inferInstance
  exact Finite.of_injective
    (fun x : ↥φ.range => (QuotientGroup.quotientKerEquivRange φ).symm x)
    (QuotientGroup.quotientKerEquivRange φ).symm.injective

theorem quotient_pow_eq_one {M : Type*} [Group M] (N : Subgroup M) [N.Normal] (p : ℕ)
    (h : ∀ x : M, x ^ p = 1) (x : M ⧸ N) : x ^ p = 1 := by
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, h y]
  exact Subgroup.one_mem N

/-- The "four-fold" commutativity step used to show that the product of two homomorphisms into an
abelian group is again a homomorphism. -/
theorem mul_four_comm {M : Type*} [Group M] [IsMulCommutative M] (a b c d : M) :
    (a * b) * (c * d) = (a * c) * (b * d) := by
  rw [mul_assoc a b (c * d), ← mul_assoc b c d, mul_comm' b c, mul_assoc c b d,
    ← mul_assoc a c (b * d)]

end Helpers

/-- **The abstract group-theoretic core.**  Let `V ◁ G` be pro-`ℓ`, `I ≤ G` such that `I/V` is
pro-cyclic, and let `φ : G →* X` be a homomorphism into a group of exponent dividing `p`, with
`ℓ ≠ p` prime and `φ.ker` of finite index.  Then `V ≤ φ.ker` (a finite quotient of a pro-`ℓ`
group inside a group of exponent `p` is trivial) and the image of `I` is a finite quotient of the
pro-cyclic group `I/V`, hence cyclic. -/
theorem isCyclic_map_of_proCyclic_quotient (ℓ p : ℕ) (hℓ : ℓ.Prime) (hp : p.Prime) (hne : ℓ ≠ p)
    {G X : Type*} [Group G] [Group X] (V I : Subgroup G) [V.Normal]
    (hVpro : NK.LocalTame.IsProP ℓ ↥V)
    (hprocyc : NK.LocalTame.IsProCyclic (↥I ⧸ V.subgroupOf I))
    (φ : G →* X) (hexp : ∀ x : X, x ^ p = 1) (hfin : φ.ker.FiniteIndex) :
    IsCyclic ↥(I.map φ) := by
  classical
  -- the image of `V` in `X` is trivial
  have hVker : V ≤ φ.ker := by
    let g : ↥V →* X := φ.comp V.subtype
    have hgker : g.ker.FiniteIndex := by
      have h1 : g.ker = φ.ker.subgroupOf V := rfl
      rw [h1]
      infer_instance
    haveI hgkerI : g.ker.FiniteIndex := hgker
    haveI : Finite (↥V ⧸ g.ker) := inferInstance
    obtain ⟨k, hk⟩ := hVpro g.ker hgker
    have hcard : Nat.card (↥V ⧸ g.ker) = ℓ ^ k := by
      rw [← Subgroup.index_eq_card, hk]
    have hk0 : k = 0 := by
      by_contra hk0
      have hdvd : ℓ ∣ Nat.card (↥V ⧸ g.ker) := by
        rw [hcard]
        exact dvd_pow_self _ hk0
      haveI : Fact ℓ.Prime := ⟨hℓ⟩
      obtain ⟨y, hy⟩ := exists_prime_orderOf_dvd_card' (G := ↥V ⧸ g.ker) ℓ hdvd
      have hyp : y ^ p = 1 := by
        apply (QuotientGroup.quotientKerEquivRange g).injective
        rw [map_pow, map_one]
        exact Subtype.ext (hexp (((QuotientGroup.quotientKerEquivRange g) y : ↥g.range) : X))
      have hdiv : ℓ ∣ p := by
        rw [← hy]
        exact orderOf_dvd_iff_pow_eq_one.mpr hyp
      exact hne ((Nat.prime_dvd_prime_iff_eq hℓ hp).mp hdiv)
    rw [hk0, pow_zero] at hcard
    have htop : g.ker = ⊤ := by
      rw [← Subgroup.index_eq_one, Subgroup.index_eq_card, hcard]
    intro v hv
    have hmem : (⟨v, hv⟩ : ↥V) ∈ g.ker := by rw [htop]; trivial
    exact MonoidHom.mem_ker.mp hmem
  -- the induced map `I/V →* X` has the same image as `I →* X`
  have hker' : V.subgroupOf I ≤ (φ.comp I.subtype).ker := by
    intro x hx
    rw [MonoidHom.mem_ker]
    show φ ↑x = 1
    exact MonoidHom.mem_ker.mp (hVker (Subgroup.mem_subgroupOf.mp hx))
  let h' : (↥I ⧸ V.subgroupOf I) →* X :=
    QuotientGroup.lift (V.subgroupOf I) (φ.comp I.subtype) hker'
  have hrange : h'.range = I.map φ := by
    apply le_antisymm
    · rintro y ⟨x, rfl⟩
      obtain ⟨i, rfl⟩ := QuotientGroup.mk'_surjective (V.subgroupOf I) x
      exact Subgroup.mem_map.mpr ⟨i, i.2,
        (QuotientGroup.lift_mk' (N := V.subgroupOf I) hker' i).symm⟩
    · rintro y ⟨i, hi, rfl⟩
      exact ⟨QuotientGroup.mk' (V.subgroupOf I) ⟨i, hi⟩,
        QuotientGroup.lift_mk' (N := V.subgroupOf I) hker' ⟨i, hi⟩⟩
  have hfin' : h'.ker.FiniteIndex := by
    haveI : Nonempty ↥h'.range := ⟨⟨1, Subgroup.one_mem _⟩⟩
    haveI hFr : Finite ↥φ.range := finite_range_of_finiteIndex φ hfin
    have hle : h'.range ≤ φ.range := by
      rw [hrange]
      exact Subgroup.map_le_range φ I
    haveI : Finite ↥h'.range := Finite.of_injective
      (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)
    rw [Subgroup.finiteIndex_iff, Subgroup.index_ker]
    exact (Finite.card_pos).ne'
  have hcycQuot : IsCyclic ((↥I ⧸ V.subgroupOf I) ⧸ h'.ker) := hprocyc h'.ker hfin'
  rw [← hrange]
  exact (QuotientGroup.quotientKerEquivRange h').isCyclic.mp hcycQuot

/-- **The image of the inertia subgroup of a finite place under a homomorphism into a group of
exponent `p` is cyclic**, for a finite place `A'` of `ℚ̄` whose residue characteristic is not `p`.

The inertia subgroup `I ⊆ D_{A'}` sits in an extension `1 → V → I → I/V → 1` where `V` is the wild
inertia (pro-`ℓ`, `ℓ` the residue characteristic) and `I/V` is pro-cyclic.  Since `ℓ ≠ p`
(hypothesis `hAp`) and the target has exponent `p`, the wild inertia maps to `1`
(`isCyclic_map_of_proCyclic_quotient`), so the image is a finite quotient of the pro-cyclic group
`I/V`, hence cyclic. -/
theorem step4_inertia_image_cyclic (p : ℕ) (hp : p.Prime)
    (A' : NK.FrobeniusBridge.FinitePlaceOf ℚ SSGRoute.QBar)
    (hAp : ¬ A'.1.valuation (p : SSGRoute.QBar) < 1)
    {X : Type*} [Group X] (hexp : ∀ x : X, x ^ p = 1)
    (f : ↥(SSGRoute.decomp ℚ A'.1) →* X) (hfin : f.ker.FiniteIndex) :
    IsCyclic ↥((ValuationSubring.inertiaSubgroup ℚ A'.1).map f) := by
  classical
  -- the residue characteristic `ℓ` is a prime different from `p`
  have hℓ : (Work.SSGRoute.residueChar A').Prime := Work.SSGRoute.residueChar_prime A'
  have hne : Work.SSGRoute.residueChar A' ≠ p := by
    intro h
    exact hAp ((Work.SSGRoute.residueChar_dvd_iff_valuation_lt_one A' p).mp (h ▸ dvd_refl p))
  -- the local structure theory at the place and the local/global identification
  have hT : NK.LocalTame.TameData (Work.SSGRoute.residueChar A')
      (NK.LocalStructure.residueCard ℚ (Submission.NeukirchUchida.primeOf A'.1 A'.2))
      (NK.FrobeniusBridge.localField A') (NK.FrobeniusBridge.localClosure A') :=
    Work.SSGRoute.localTameData A'
  have hq : NK.ResidueFrob.ResidueCardMatches A'
      (NK.LocalStructure.residueCard ℚ (Submission.NeukirchUchida.primeOf A'.1 A'.2)) :=
    Work.SSGRoute.residueCardMatches_localStructure A'
  let κ := NK.FrobeniusBridge.localField A'
  let K' := NK.FrobeniusBridge.localClosure A'
  let e : ↥(SSGRoute.decomp ℚ A'.1) ≃* Gal(K'/κ) := NK.FrobeniusBridge.localGaloisEquiv A'
  let Vκ : Subgroup Gal(K'/κ) := NK.LocalTame.wildInertiaSubgroup (Work.SSGRoute.residueChar A')
  let Iκ : Subgroup Gal(K'/κ) := NK.LocalAnabelian.inertiaSubgroup (Work.SSGRoute.residueChar A')
  let Fhom : Gal(K'/κ) →* X := f.comp e.symm.toMonoidHom
  haveI hVκN : Vκ.Normal := by
    show (NK.LocalTame.wildInertiaSubgroup (Work.SSGRoute.residueChar A')).Normal
    infer_instance
  -- (i) the global and the local inertia subgroups correspond under `e`
  have hS : ∀ σ : ↥(SSGRoute.decomp ℚ A'.1),
      σ ∈ ValuationSubring.inertiaSubgroup ℚ A'.1 ↔ e σ ∈ Iκ := by
    intro σ
    rw [isInertia_iff_mem_inertiaSubgroup]
    exact ⟨fun h => inertia_of_isInertia A' (Work.SSGRoute.residueChar A')
        (NK.LocalStructure.residueCard ℚ (Submission.NeukirchUchida.primeOf A'.1 A'.2))
        hT hq rfl σ h,
      fun h => isInertia_of_mem_inertia A' (Work.SSGRoute.residueChar A')
        (NK.LocalStructure.residueCard ℚ (Submission.NeukirchUchida.primeOf A'.1 A'.2))
        hT hq rfl σ h⟩
  have hmapI : (ValuationSubring.inertiaSubgroup ℚ A'.1).map e.toMonoidHom = Iκ := by
    ext y
    constructor
    · rintro ⟨σ, hσ, rfl⟩
      exact (hS σ).mp hσ
    · intro hy
      exact ⟨e.symm y, (hS (e.symm y)).mpr (by simpa using hy), by simp⟩
  -- (ii) the goal transfers: the image of `Iκ` under `Fhom = f ∘ e⁻¹`
  have hgoal : Iκ.map Fhom = (ValuationSubring.inertiaSubgroup ℚ A'.1).map f := by
    rw [← hmapI, Subgroup.map_map]
    congr 1
    ext σ
    simp [Fhom]
  -- (iii) `Fhom` has finite index kernel
  have hFker : Fhom.ker.FiniteIndex := by
    have hker : Fhom.ker = Subgroup.comap e.symm.toMonoidHom f.ker :=
      (MonoidHom.comap_ker f e.symm.toMonoidHom).symm
    rw [Subgroup.finiteIndex_iff, hker,
      Subgroup.index_comap_of_surjective (H := f.ker) (f := e.symm.toMonoidHom) e.symm.surjective]
    exact hfin.index_ne_zero
  -- (iv) `Iκ/Vκ` is pro-cyclic
  have hprocyc : NK.LocalTame.IsProCyclic (↥Iκ ⧸ Vκ.subgroupOf Iκ) := by
    have hker_eq : ((QuotientGroup.mk' Vκ).comp Iκ.subtype).ker = Vκ.subgroupOf Iκ := by
      rw [← MonoidHom.comap_ker, QuotientGroup.ker_mk']
      rfl
    have hrange_eq : ((QuotientGroup.mk' Vκ).comp Iκ.subtype).range
        = NK.LocalTame.quotientImage Vκ Iκ := by
      rw [MonoidHom.range_comp, Subgroup.range_subtype]
      rfl
    have e1 : (↥Iκ ⧸ Vκ.subgroupOf Iκ) ≃* ↥(NK.LocalTame.quotientImage Vκ Iκ) :=
      (QuotientGroup.quotientMulEquivOfEq hker_eq.symm).trans
        ((QuotientGroup.quotientKerEquivRange ((QuotientGroup.mk' Vκ).comp Iκ.subtype)).trans
          (MulEquiv.subgroupCongr hrange_eq))
    exact (NK.LocalTame.isProCyclic_congr e1).mpr hT.structure_input.isTameInertia.2.2.1
  -- (v) conclude
  have hcycI : IsCyclic ↥(Iκ.map Fhom) :=
    isCyclic_map_of_proCyclic_quotient (Work.SSGRoute.residueChar A') p hℓ hp hne
      Vκ Iκ (NK.LocalTame.wildInertiaSubgroup_isProP (Work.SSGRoute.residueChar A'))
      hprocyc Fhom hexp hFker
  rw [← hgoal]
  exact hcycI

theorem step4_local_target (p : ℕ) [Fact p.Prime]
    (K : IntermediateField ℚ SSGRoute.QBar) [FiniteDimensional ℚ K] [Normal ℚ K]
    (n i j : ℕ) (hj : 1 ≤ j) (hji : j ≤ i)
    (φ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) n i j)
    (ψ : SSGRoute.GalQ →* flowGroup p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2)
    (hLift : SSGRoute.LiftsFlow ψ φ) (hopen : IsOpen (ψ.ker : Set SSGRoute.GalQ))
    (A : ValuationSubring SSGRoute.QBar) (hA : SSGRoute.IsFinPlace ℚ A)
    (hAp : ¬ A.valuation (p : SSGRoute.QBar) < 1)
    (hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup)
    (hφA : ∀ σ ∈ SSGRoute.decomp ℚ A, φ σ = 1) :
    ∃ η : SSGRoute.GalQ → E p (K ≃ₐ[ℚ] K) n i j,
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
      (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
      IsCyclic (Subgroup.closure
        ((Work.SSGRoute.flowTwistE p K n i j η ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
      ∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
        Work.SSGRoute.flowTwistE p K n i j η ψ τ = Work.SSGRoute.flowTwistE p K n i j η ψ σ := by
  classical
  have hp : p.Prime := Fact.out
  -- (1) `ψ` maps the decomposition group into the graded piece
  have hmap : Subgroup.map ψ (SSGRoute.decomp ℚ A) ≤
      (gradeInl p (K ≃ₐ[ℚ] K) n i j).range :=
    map_le_range_gradeInl_of_flowQuot_eq_one p K n i j ψ φ hLift A hφA
  -- (2) the `E(n,τ)`-component `sm` of `ψ` on `D_A`, and its multiplicativity
  have hψmem : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      ψ σ.1 ∈ Subgroup.map ψ (SSGRoute.decomp ℚ A) :=
    fun σ => Subgroup.mem_map.mpr ⟨σ.1, σ.2, rfl⟩
  let sm : ↥(SSGRoute.decomp ℚ A) →
      refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j :=
    fun σ => Classical.choose (hmap (hψmem σ))
  have hsm : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      gradeInl p (K ≃ₐ[ℚ] K) n i j (sm σ) = ψ σ.1 :=
    fun σ => Classical.choose_spec (hmap (hψmem σ))
  have hsm_mul : ∀ σ τ : ↥(SSGRoute.decomp ℚ A), sm (σ * τ) = sm σ * sm τ := by
    intro σ τ
    apply gradeInl_injective p (K ≃ₐ[ℚ] K) n i j
    rw [hsm (σ * τ), map_mul, hsm σ, hsm τ]
    exact map_mul ψ σ.1 τ.1
  have hsm_one : sm 1 = 1 := by
    apply gradeInl_injective p (K ≃ₐ[ℚ] K) n i j
    rw [hsm 1]
    simp
  let smHom : ↥(SSGRoute.decomp ℚ A) →*
      refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j :=
    { toFun := sm, map_one' := hsm_one, map_mul' := hsm_mul }
  -- (3) the place, the Frobenius element and the unramified quotient `cl : D_A ↠ Ẑ`
  let A' : NK.FrobeniusBridge.FinitePlaceOf ℚ SSGRoute.QBar := ⟨A, hA⟩
  let cl : ↥(SSGRoute.decomp ℚ A) →* NK.LocalAnabelian.Zhat := localZhatHom A'
  have hcl_surj : Function.Surjective cl := localZhatHom_surjective A'
  let Frob : ↥(SSGRoute.decomp ℚ A) := localFrobElem A'
  have hFcl : cl Frob = NK.TowerRank.zhatGen := localZhatHom_localFrobElem A'
  have hcl_ker : cl.ker = globalInertiaSub A' := localZhatHom_ker A'
  -- (4) an unramified hom `Ẑ →* β` whose value at the generator is `-sm(Frob)`
  obtain ⟨fbar, hfbar⟩ := exists_zhat_hom_zhatGen_eq (smHom Frob)⁻¹ p hp.pos (by
    rw [inv_pow, pow_eq_one_refinedQuotient p i j, inv_one])
  have hfbar_pow : NK.TowerRank.powSubgroup p ≤ fbar.ker := by
    intro z hz
    rw [MonoidHom.mem_ker]
    obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hz
    have hy' : y ^ p = z := by simpa [NK.TowerRank.powHom] using hy
    rw [← hy', map_pow]
    exact pow_eq_one_refinedQuotient p i j (fbar y)
  let etaD : ↥(SSGRoute.decomp ℚ A) →*
      refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j := fbar.comp cl
  let η : SSGRoute.GalQ → E p (K ≃ₐ[ℚ] K) n i j :=
    fun σ => if h : σ ∈ SSGRoute.decomp ℚ A then Additive.ofMul (etaD ⟨σ, h⟩) else 0
  have heta : ∀ (σ : SSGRoute.GalQ) (h : σ ∈ SSGRoute.decomp ℚ A),
      η σ = Additive.ofMul (etaD ⟨σ, h⟩) := by
    intro σ h
    show (if h' : σ ∈ SSGRoute.decomp ℚ A then Additive.ofMul (etaD ⟨σ, h'⟩) else 0) = _
    rw [dif_pos h]
  -- (5) the twist `χ = η · ψ` on `D_A`, as a homomorphism
  let chi : ↥(SSGRoute.decomp ℚ A) →*
      refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j :=
    { toFun := fun σ => etaD σ * smHom σ
      map_one' := by simp
      map_mul' := by
        intro σ τ
        show etaD (σ * τ) * smHom (σ * τ) = (etaD σ * smHom σ) * (etaD τ * smHom τ)
        rw [map_mul etaD σ τ, map_mul smHom σ τ]
        exact mul_four_comm _ _ _ _ }
  have htwist : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      flowTwistE p K n i j η ψ σ.1 = gradeInl p (K ≃ₐ[ℚ] K) n i j (chi σ) := by
    intro σ
    have h1 : η σ.1 = Additive.ofMul (etaD σ) := heta σ.1 σ.2
    calc flowTwistE p K n i j η ψ σ.1
        = gradeInl p (K ≃ₐ[ℚ] K) n i j (Additive.toMul (η σ.1)) * ψ σ.1 := rfl
      _ = gradeInl p (K ≃ₐ[ℚ] K) n i j (etaD σ) *
            gradeInl p (K ≃ₐ[ℚ] K) n i j (sm σ) := by rw [h1, toMul_ofMul, hsm σ]
      _ = gradeInl p (K ≃ₐ[ℚ] K) n i j (etaD σ * sm σ) := (map_mul _ _ _).symm
      _ = gradeInl p (K ≃ₐ[ℚ] K) n i j (chi σ) := rfl
  -- (6) the twist kills the unramified part: `χ(D_A) ⊆ χ(I_A)`
  let B : Subgroup (refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j) :=
    (ValuationSubring.inertiaSubgroup ℚ A).map chi
  let zeta : ↥(SSGRoute.decomp ℚ A) →*
      (refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j) ⧸ B :=
    (QuotientGroup.mk' B).comp chi
  have hzeta_inertia : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      σ ∈ ValuationSubring.inertiaSubgroup ℚ A → zeta σ = 1 := by
    intro σ hσ
    have hmem : chi σ ∈ B := Subgroup.mem_map.mpr ⟨σ, hσ, rfl⟩
    show (QuotientGroup.mk' B) (chi σ) = 1
    rw [QuotientGroup.mk'_apply]
    exact (QuotientGroup.eq_one_iff _).mpr hmem
  have hker_cl_le : cl.ker ≤ zeta.ker := by
    rw [hcl_ker, globalInertiaSub, Subgroup.closure_le]
    intro g hg
    exact MonoidHom.mem_ker.mpr (hzeta_inertia g (mem_inertiaSubgroup_of_isInertia g hg))
  let clIso : (↥(SSGRoute.decomp ℚ A)) ⧸ cl.ker ≃* NK.LocalAnabelian.Zhat :=
    QuotientGroup.quotientKerEquivOfSurjective cl hcl_surj
  have hclIso : ∀ σ : ↥(SSGRoute.decomp ℚ A), clIso (QuotientGroup.mk' cl.ker σ) = cl σ := by
    intro σ
    change QuotientGroup.kerLift cl (QuotientGroup.mk' cl.ker σ) = cl σ
    rw [QuotientGroup.mk'_apply, QuotientGroup.kerLift_mk]
  let zetaBar : NK.LocalAnabelian.Zhat →*
      (refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j) ⧸ B :=
    (QuotientGroup.lift cl.ker zeta hker_cl_le).comp clIso.symm.toMonoidHom
  have hzetaBar : ∀ σ : ↥(SSGRoute.decomp ℚ A), zetaBar (cl σ) = zeta σ := by
    intro σ
    show (QuotientGroup.lift cl.ker zeta hker_cl_le) (clIso.symm (cl σ)) = zeta σ
    rw [show clIso.symm (cl σ) = QuotientGroup.mk' cl.ker σ from by
      rw [← hclIso σ, MulEquiv.symm_apply_apply]]
    exact QuotientGroup.lift_mk' cl.ker hker_cl_le σ
  have hzetaBar_gen : zetaBar NK.TowerRank.zhatGen = 1 := by
    rw [← hFcl, hzetaBar Frob]
    show (QuotientGroup.mk' B) (chi Frob) = 1
    have hchiF : chi Frob = 1 := by
      show etaD Frob * smHom Frob = 1
      have h1 : etaD Frob = (smHom Frob)⁻¹ := by
        show fbar (cl Frob) = _
        rw [hFcl, hfbar]
      rw [h1, inv_mul_cancel]
    rw [hchiF, map_one]
  have hzetaBar_one : zetaBar = 1 :=
    zhat_eq_one_of_zhatGen_eq_one p hp.pos
      (fun x => quotient_pow_eq_one B p (fun y => pow_eq_one_refinedQuotient p i j y) x)
      zetaBar hzetaBar_gen
  have hchi_mem_B : ∀ σ : ↥(SSGRoute.decomp ℚ A), chi σ ∈ B := by
    intro σ
    have h1 : zeta σ = 1 := by rw [← hzetaBar σ, hzetaBar_one]; rfl
    have h2 : (QuotientGroup.mk' B) (chi σ) = 1 := h1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h2
    exact h2
  -- (7) `χ.ker` has finite index: it contains `cl⁻¹(Ẑ^p) ⊓ (ker ψ)`
  have hfin_pow : (NK.TowerRank.powSubgroup p).FiniteIndex := by
    rw [← NK.TameStructureDeep.Degree.ker_compHomZMod_eq_powSubgroup p hp.ne_zero]
    infer_instance
  have hchi_fin : chi.ker.FiniteIndex := by
    have hfin_cl : (NK.TowerRank.powSubgroup p).comap cl |>.FiniteIndex := by
      rw [Subgroup.finiteIndex_iff,
        Subgroup.index_comap_of_surjective (H := NK.TowerRank.powSubgroup p) (f := cl) hcl_surj]
      exact hfin_pow.index_ne_zero
    have hfin_psi : ((ψ.ker).subgroupOf (SSGRoute.decomp ℚ A)).FiniteIndex := by
      haveI : ψ.ker.FiniteIndex := finiteIndex_ker_of_isOpen ψ hopen
      infer_instance
    have hle : (NK.TowerRank.powSubgroup p).comap cl ⊓
        (ψ.ker).subgroupOf (SSGRoute.decomp ℚ A) ≤ chi.ker := by
      intro σ hσ
      obtain ⟨hσcl, hσψ⟩ := Subgroup.mem_inf.mp hσ
      rw [MonoidHom.mem_ker]
      have h1 : etaD σ = 1 := MonoidHom.mem_ker.mp (hfbar_pow hσcl)
      have h2 : smHom σ = 1 := by
        have hψ : ψ σ.1 = 1 := MonoidHom.mem_ker.mp (Subgroup.mem_subgroupOf.mp hσψ)
        apply gradeInl_injective p (K ≃ₐ[ℚ] K) n i j
        rw [show smHom σ = sm σ from rfl, hsm σ, hψ]
        simp
      rw [show chi σ = etaD σ * smHom σ from rfl, h1, h2, one_mul]
    exact Subgroup.finiteIndex_of_le hle
  -- (8) the twisted local group is the image of the inertia, hence cyclic
  have hcycB : IsCyclic ↥B :=
    step4_inertia_image_cyclic p hp A' hAp
      (fun x => pow_eq_one_refinedQuotient p i j x) chi hchi_fin
  have hset : Subgroup.closure
      ((flowTwistE p K n i j η ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ)) =
      Subgroup.map (gradeInl p (K ≃ₐ[ℚ] K) n i j) B := by
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro y ⟨σ, hσ, rfl⟩
      exact Subgroup.mem_map.mpr
        ⟨chi ⟨σ, hσ⟩, hchi_mem_B ⟨σ, hσ⟩, (htwist ⟨σ, hσ⟩).symm⟩
    · rw [Subgroup.map_le_iff_le_comap]
      intro b hb
      obtain ⟨ι, hι, rfl⟩ := Subgroup.mem_map.mp hb
      exact Subgroup.subset_closure ⟨(ι : SSGRoute.GalQ), ι.2, htwist ι⟩
  have hcyc : IsCyclic (Subgroup.closure
      ((Work.SSGRoute.flowTwistE p K n i j η ψ) ''
        (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) := by
    rw [hset]
    exact (Subgroup.equivMapOfInjective B (gradeInl p (K ≃ₐ[ℚ] K) n i j)
      (gradeInl_injective p (K ≃ₐ[ℚ] K) n i j)).isCyclic.mp hcycB
  -- (9) local constancy of `η`
  have hloc : SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η := by
    have hopen1 : IsOpen ((cl ⁻¹' NK.TowerRank.powSubgroup p) : Set ↥(SSGRoute.decomp ℚ A)) :=
      localZhatHom_preimage_powSubgroup_isOpen A' p hp.pos
    obtain ⟨W, hWopen, hW⟩ := isOpen_induced_iff.mp hopen1
    have h1mem : (1 : ↥(SSGRoute.decomp ℚ A)) ∈ (cl ⁻¹' NK.TowerRank.powSubgroup p) := by
      show cl 1 ∈ NK.TowerRank.powSubgroup p
      rw [map_one]
      exact Subgroup.one_mem _
    have hW1 : (1 : SSGRoute.GalQ) ∈ W := by
      have h1' : (1 : ↥(SSGRoute.decomp ℚ A)) ∈ Subtype.val ⁻¹' W := hW ▸ h1mem
      exact h1'
    obtain ⟨E, hEfin, hE⟩ := (krullTopology_mem_nhds_one_iff ℚ SSGRoute.QBar W).mp
      (hWopen.mem_nhds hW1)
    refine ⟨E.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen E, ?_⟩
    intro g hg u hu huD
    rw [heta (g * u) (Subgroup.mul_mem _ hg huD), heta g hg]
    have hmem : (⟨g * u, Subgroup.mul_mem _ hg huD⟩ : ↥(SSGRoute.decomp ℚ A)) =
        ⟨g, hg⟩ * ⟨u, huD⟩ := Subtype.ext rfl
    have huW : (u : SSGRoute.GalQ) ∈ W := hE hu
    have huS : (⟨u, huD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈
        (cl ⁻¹' NK.TowerRank.powSubgroup p) := by
      have h' : (⟨u, huD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ Subtype.val ⁻¹' W := huW
      rwa [hW] at h'
    have hucl : cl ⟨u, huD⟩ ∈ NK.TowerRank.powSubgroup p := huS
    rw [hmem, map_mul]
    have h1 : etaD ⟨u, huD⟩ = 1 := by
      show fbar (cl ⟨u, huD⟩) = 1
      exact MonoidHom.mem_ker.mp (hfbar_pow hucl)
    rw [h1, mul_one]
  -- (10) assembly
  refine ⟨η, ?_, hloc, ?_, hcyc, ?_⟩
  · intro σ hσ τ hτ
    rw [heta (σ * τ) (Subgroup.mul_mem _ hσ hτ), heta σ hσ, heta τ hτ]
    rw [show (⟨σ * τ, Subgroup.mul_mem _ hσ hτ⟩ : ↥(SSGRoute.decomp ℚ A)) =
        ⟨σ, hσ⟩ * ⟨τ, hτ⟩ from Subtype.ext rfl]
    rw [map_mul, ofMul_mul]
  · intro σ hσ
    rw [heta σ hσ.1]
    have hmem : (⟨σ, hσ.1⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ cl.ker := by
      rw [hcl_ker]
      exact Subgroup.subset_closure hσ
    show Additive.ofMul (etaD ⟨σ, hσ.1⟩) = 0
    rw [show etaD ⟨σ, hσ.1⟩ = 1 from by
      show fbar (cl ⟨σ, hσ.1⟩) = 1
      rw [MonoidHom.mem_ker.mp hmem, map_one]]
    rfl
  · intro σ hσ
    obtain ⟨ι, hι, hιeq⟩ := Subgroup.mem_map.mp (hchi_mem_B ⟨σ, hσ⟩)
    refine ⟨(ι : SSGRoute.GalQ), isInertia_of_mem_inertiaSubgroup hι, ?_⟩
    rw [htwist ι, htwist ⟨σ, hσ⟩, hιeq]

end Work.SSGRoute
