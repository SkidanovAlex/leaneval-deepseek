/-!
# The transfer `H¹(⟨c⟩,E) ≅ H¹(D_w,E)` at a linked complex place, natural in `E`

At an archimedean place `w` of `K` whose decomposition group `D_w` is generated by the image of an
involution `c ∈ Gal(Ω/k)` under `res k K` (`PT.decompK_linked`), the restriction map
`⟨c⟩ → D_w` is an isomorphism (`ArchDictionary.ePowLift`, from
`PTdualControl.decompK_zpowers_iso`).  Transporting `H¹` along it (with the identity coefficient
map) gives the **transfer** `H¹(⟨c⟩,E) ≅+ H¹(D_w,E)`.

The transfer is built from `PT.pushH1`/`PT.pullH1` (which are the canonical `QuotientAddGroup.lift`
maps induced by pushing cochains `f ↦ (g ↦ Ψ (f (Φ.symm g)))`), and the present file proves

* `PT.pushH1_mapH1_refl` — the transfer commutes with the functoriality `mapH1` in the coefficient,
  for the identity coefficient map (`Ψ = AddEquiv.refl`), and
* the resulting `cycTransfer_natural`.

These are the two formal ingredients of the coefficient-naturality clause of the archimedean
dictionary in the nonsplit (`decompK w ≠ ⊥`) case.
-/

namespace Work.SSGRoute.PT

open Work.GroupCohomology

variable {G' G : Type*} [Group G'] [Group G]
variable {M₁ M₂ : Type*} [AddCommGroup M₁] [AddCommGroup M₂]
variable [DistribMulAction G' M₁] [DistribMulAction G M₁]
variable [DistribMulAction G' M₂] [DistribMulAction G M₂]

/-- **`pushH1` along `Φ`, with the identity coefficient map, commutes with `mapH1`.** -/
theorem pushH1_mapH1_refl (Φ : G' ≃* G)
    (hΨ₁ : IsCompat Φ (AddEquiv.refl M₁)) (hΨ₂ : IsCompat Φ (AddEquiv.refl M₂))
    (f : M₁ →+ M₂) (hf' : IsEquivariant G' f) (hf : IsEquivariant G f) (y : H1 G' M₁) :
    pushH1 Φ (AddEquiv.refl M₂) hΨ₂ (mapH1 (G := G') f hf' y)
      = mapH1 (G := G) f hf (pushH1 Φ (AddEquiv.refl M₁) hΨ₁ y) := by
  induction y using Work.GroupCohomology.H1_induction_on with
  | h z =>
    rw [mapH1_H1π, pushH1_H1π, pushH1_H1π, mapH1_H1π]
    have hz : (pushZ1 Φ (AddEquiv.refl M₂) hΨ₂) ((mapZ1 (G := G') f hf') z)
        = (mapZ1 (G := G) f hf) ((pushZ1 Φ (AddEquiv.refl M₁) hΨ₁) z) := by
      apply Subtype.ext
      funext g
      simp only [pushZ1_coe, pushCoeff_apply, mapZ1_coe, mapCochain1_apply]
      rfl
    rw [hz]

/-- From equivariance for the `G'`-action one gets equivariance for the `G`-action, given the
compatibility of the two actions along `Φ` (with the identity coefficient map). -/
theorem isEquivariant_of_compat (Φ : G' ≃* G)
    (h₁ : IsCompat Φ (AddEquiv.refl M₁)) (h₂ : IsCompat Φ (AddEquiv.refl M₂))
    (f : M₁ →+ M₂) (hf' : IsEquivariant G' f) : IsEquivariant G f := by
  intro g m
  obtain ⟨g', rfl⟩ := Φ.surjective g
  have h1' : g' • m = Φ g' • m := h₁ g' m
  have h2' : g' • f m = Φ g' • f m := h₂ g' (f m)
  rw [← h1', ← h2']
  exact hf' g' m

end Work.SSGRoute.PT

namespace Work.SSGRoute.ArchDictionary

open CategoryTheory SSGRoute.PTExt

section Act

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]

/-- The action of the decomposition group `D_w ⊆ Gal(K/k)` on a `Gal(K/k)`-module `E`. -/
noncomputable abbrev dcAct (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [NumberField ↥K] (E : Type) [AddCommGroup E]
    [DistribMulAction (K ≃ₐ[k] K) E] (w : NK.GlobalCFT.Place ↥K) :
    DistribMulAction ↥(decompK (k := k) w) E :=
  @Subgroup.instDistribMulActionSubtypeMem (K ≃ₐ[k] K) E _ _
    (inferInstance : DistribMulAction (K ≃ₐ[k] K) E) (decompK (k := k) w)

end Act

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]

/-- The defining computation rule of `ePowLift`: the image of `g ∈ ⟨c⟩` is `res k K g`. -/
theorem ePowLift_coe (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1)
    (φ : Ω →+* ℂ) (hlink : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x)) (w : NK.GlobalCFT.Place ↥K)
    (hw : w = NK.GlobalCFT.Place.ofInfinite
      (NumberField.InfinitePlace.mk (φ.comp (algebraMap ↥K Ω))))
    (hne : decompK (k := k) w ≠ ⊥) (g : ↥(Subgroup.zpowers c)) :
    ((ePowLift (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne g :
        ↥(decompK (k := k) w)) : K ≃ₐ[k] K)
      = SSGRoute.res k K (g : Ω ≃ₐ[k] Ω) := by
  simp only [ePowLift]
  rfl

/-- The compatibility of the `⟨c⟩`-action (through `res k K`) with the `D_w`-action, along
`ePowLift`, for the identity coefficient map. -/
theorem ePowLift_compat (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1)
    (φ : Ω →+* ℂ) (hlink : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x)) (w : NK.GlobalCFT.Place ↥K)
    (hw : w = NK.GlobalCFT.Place.ofInfinite
      (NumberField.InfinitePlace.mk (φ.comp (algebraMap ↥K Ω))))
    (hne : decompK (k := k) w ≠ ⊥) (E : Type) [AddCommGroup E]
    [DistribMulAction (K ≃ₐ[k] K) E] :
    @Work.SSGRoute.PT.IsCompat ↥(Subgroup.zpowers c) ↥(decompK (k := k) w) _ _ E E _ _
      (cycAct K c E) (dcAct K E w)
      (ePowLift (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne) (AddEquiv.refl E) := by
  letI hpar : DistribMulAction (Ω ≃ₐ[k] Ω) E := DistribMulAction.compHom E (SSGRoute.res k K)
  letI hcyc : DistribMulAction ↥(Subgroup.zpowers c) E := cycAct K c E
  intro g e
  show (g • e : E) = ((ePowLift (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne g :
      ↥(decompK (k := k) w)) : K ≃ₐ[k] K) • e
  rw [Subgroup.smul_def (g) (e),
    ePowLift_coe c hc2 hc1 φ hlink w hw hne g]
  rfl

/-- **The transfer** `H¹(⟨c⟩,E) ≃+ H¹(D_w,E)` at a linked complex place. -/
noncomputable def cycTransfer (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1)
    (φ : Ω →+* ℂ) (hlink : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x)) (w : NK.GlobalCFT.Place ↥K)
    (hw : w = NK.GlobalCFT.Place.ofInfinite
      (NumberField.InfinitePlace.mk (φ.comp (algebraMap ↥K Ω))))
    (hne : decompK (k := k) w ≠ ⊥) (E : Type) [AddCommGroup E]
    [DistribMulAction (K ≃ₐ[k] K) E] :
    H1c K c E ≃+ @Work.GroupCohomology.H1 ↥(decompK (k := k) w) E _ _ (dcAct K E w) := by
  letI hcyc : DistribMulAction ↥(Subgroup.zpowers c) E := cycAct K c E
  exact
    { toFun := Work.SSGRoute.PT.pushH1 _ _ (ePowLift_compat c hc2 hc1 φ hlink w hw hne E)
      invFun := Work.SSGRoute.PT.pullH1 _ _ (ePowLift_compat c hc2 hc1 φ hlink w hw hne E)
      left_inv := Work.SSGRoute.PT.pullH1_pushH1 _ _ _
      right_inv := Work.SSGRoute.PT.pushH1_pullH1 _ _ _
      map_add' := (Work.SSGRoute.PT.pushH1 _ _ _).map_add }

/-- **Naturality of the transfer** in the coefficient module. -/
theorem cycTransfer_natural (c : Ω ≃ₐ[k] Ω) (hc2 : c ^ 2 = 1) (hc1 : c ≠ 1)
    (φ : Ω →+* ℂ) (hlink : ∀ x : Ω, φ (c x) = starRingEnd ℂ (φ x)) (w : NK.GlobalCFT.Place ↥K)
    (hw : w = NK.GlobalCFT.Place.ofInfinite
      (NumberField.InfinitePlace.mk (φ.comp (algebraMap ↥K Ω))))
    (hne : decompK (k := k) w ≠ ⊥)
    (E : Type) [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E]
    (E₂ : Type) [AddCommGroup E₂] [DistribMulAction (K ≃ₐ[k] K) E₂]
    (f : E →+ E₂)
    (hf : @Work.GroupCohomology.IsEquivariant ↥(Subgroup.zpowers c) E E₂ _ _ _
      (cycAct K c E) (cycAct K c E₂) f)
    (hfD : @Work.GroupCohomology.IsEquivariant ↥(decompK (k := k) w) E E₂ _ _ _
      (dcAct K E w) (dcAct K E₂ w) f)
    (y : H1c K c E) :
    cycTransfer (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne E₂
        (@Work.GroupCohomology.mapH1 ↥(Subgroup.zpowers c) E E₂ _ _ _
          (cycAct K c E) (cycAct K c E₂) f hf y) =
      (@Work.GroupCohomology.mapH1 ↥(decompK (k := k) w) E E₂ _ _ _
          (dcAct K E w) (dcAct K E₂ w) f hfD)
        (cycTransfer (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne E y) := by
  letI hcyc : DistribMulAction ↥(Subgroup.zpowers c) E := cycAct K c E
  letI hcyc₂ : DistribMulAction ↥(Subgroup.zpowers c) E₂ := cycAct K c E₂
  have h₁ : ∀ y : H1c K c E,
      cycTransfer (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne E y
        = (Work.SSGRoute.PT.pushH1
            (ePowLift (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne) (AddEquiv.refl E)
            (ePowLift_compat c hc2 hc1 φ hlink w hw hne E)) y := fun y => rfl
  have h₂ : ∀ y : H1c K c E₂,
      cycTransfer (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne E₂ y
        = (Work.SSGRoute.PT.pushH1
            (ePowLift (k := k) (Ω := Ω) (K := K) c hc2 hc1 φ hlink w hw hne) (AddEquiv.refl E₂)
            (ePowLift_compat c hc2 hc1 φ hlink w hw hne E₂)) y := fun y => rfl
  rw [h₁, h₂]
  exact Work.SSGRoute.PT.pushH1_mapH1_refl _ _ _ f hf hfD y

end Work.SSGRoute.ArchDictionary
