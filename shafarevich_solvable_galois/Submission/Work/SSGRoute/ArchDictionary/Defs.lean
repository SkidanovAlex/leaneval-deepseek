/-!
# Vocabulary for the archimedean dictionary at a nonsplit (complex) place

This file collects the definitions used by
`Work.SSGRoute.ArchDictionary.archimedeanDictNonsplit` and by the lemmas it is assembled from.

* `Eprime` is the coefficient module `E' = DualMod p (E ⊗ T)` of the `E1a` design.
* `Zc` is the additive group of functions `(Ω ≃ₐ[k] Ω) → E` that are `1`-cocycles on the cyclic
  subgroup `⟨c⟩` (the action of `⟨c⟩` on `E` being through `SSGRoute.res k K`).
* `Bc` is the subgroup of coboundaries inside `Zc` (`IsCoboundaryOn`).
* `Ac` is the quotient `Z¹(⟨c⟩,E)/B¹(⟨c⟩)` — the `H¹` of the involution group, in the concrete
  shape in which the target statement reads it.
-/

namespace Work.SSGRoute.ArchDictionary

open CategoryTheory SSGRoute.PTExt
open scoped TensorProduct

section Defs

variable (p : ℕ) (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]

/-- The coefficient module `E' = DualMod p (E ⊗ T)` of the archimedean dictionary, as a
`Gal(K/k)`-representation. -/
abbrev Eprime (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E] : Rep.{0} SSGRoute.PTExt.Coeff (K ≃ₐ[k] K) :=
  SSGRoute.PTExt.modRep (K ≃ₐ[k] K)
    (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) E T))

end Defs

section Cyc

variable {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
variable (K : IntermediateField k Ω) [Normal k K]
variable (E : Type) [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E]

/-- The `1`-cocycles on the cyclic subgroup generated by `c`, as functions on the whole Galois
group `Ω ≃ₐ[k] Ω` (the action of `⟨c⟩` on `E` being through `SSGRoute.res k K`). -/
def Zc (c : Ω ≃ₐ[k] Ω) : AddSubgroup ((Ω ≃ₐ[k] Ω) → E) where
  carrier := {b | SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) b}
  zero_mem' := by
    intro g hg h hh
    simp
  add_mem' := by
    intro a b ha hb g hg h hh
    have ha' := ha g hg h hh
    have hb' := hb g hg h hh
    simp only [Pi.add_apply, ha', hb', smul_add]
    abel
  neg_mem' := by
    intro a ha g hg h hh
    have ha' := ha g hg h hh
    simp only [Pi.neg_apply, ha', smul_neg]
    abel

variable {K E}

@[simp] theorem mem_Zc {c : Ω ≃ₐ[k] Ω} {b : (Ω ≃ₐ[k] Ω) → E} :
    b ∈ Zc K E c ↔ SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) b := Iff.rfl

end Cyc

section CycB

variable {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
variable (K : IntermediateField k Ω) [Normal k K]
variable (E : Type) [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E]

/-- The coboundaries on `⟨c⟩`, as a subgroup of the cocycles `Zc`. -/
def Bc (c : Ω ≃ₐ[k] Ω) : AddSubgroup ↥(Zc K E c) where
  carrier := {b | SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c) (b : _ → E)}
  zero_mem' := by
    refine ⟨0, fun g hg => ?_⟩
    simp
  add_mem' := by
    rintro a b ⟨m, hm⟩ ⟨m', hm'⟩
    refine ⟨m + m', fun g hg => ?_⟩
    have ha := hm g hg
    have hb := hm' g hg
    change (a : (Ω ≃ₐ[k] Ω) → E) g + (b : (Ω ≃ₐ[k] Ω) → E) g
      = (SSGRoute.res k K) g • (m + m') - (m + m')
    rw [ha, hb, smul_add]
    abel
  neg_mem' := by
    rintro a ⟨m, hm⟩
    refine ⟨-m, fun g hg => ?_⟩
    have ha := hm g hg
    change -((a : (Ω ≃ₐ[k] Ω) → E) g)
      = (SSGRoute.res k K) g • (-m) - (-m)
    rw [ha, smul_neg]
    abel

variable {K E}

@[simp] theorem mem_Bc {c : Ω ≃ₐ[k] Ω} {b : ↥(Zc K E c)} :
    b ∈ Bc K E c ↔
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c) (b : _ → E) := Iff.rfl

/-- `H¹(⟨c⟩, E)` in the concrete shape `Z¹/B¹` used by the target statement. -/
abbrev Ac (c : Ω ≃ₐ[k] Ω) : Type := ↥(Zc K E c) ⧸ Bc K E c

/-- The quotient map `Z¹(⟨c⟩,E) → H¹(⟨c⟩,E)`. -/
def Acπ (c : Ω ≃ₐ[k] Ω) : ↥(Zc K E c) →+ Ac (K := K) (E := E) c := QuotientAddGroup.mk' _

/-- The class of a cocycle on `⟨c⟩`. -/
theorem Acπ_apply (c : Ω ≃ₐ[k] Ω) (b : ↥(Zc K E c)) :
    Acπ (K := K) (E := E) c b = QuotientAddGroup.mk' (Bc K E c) b := rfl

theorem Acπ_eq_zero_iff {c : Ω ≃ₐ[k] Ω} (b : ↥(Zc K E c)) :
    Acπ (K := K) (E := E) c b = 0 ↔ b ∈ Bc K E c := by
  rw [Acπ_apply, QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]

theorem Acπ_surjective (c : Ω ≃ₐ[k] Ω) : Function.Surjective (Acπ (K := K) (E := E) c) :=
  QuotientAddGroup.mk'_surjective _

/-- The class of a function, when it is a cocycle on `⟨c⟩` (and `0` otherwise). -/
noncomputable def AcOfFun (c : Ω ≃ₐ[k] Ω) (b : (Ω ≃ₐ[k] Ω) → E) : Ac (K := K) (E := E) c := by
  classical
  exact if h : b ∈ Zc K E c then Acπ (K := K) (E := E) c ⟨b, h⟩ else 0

theorem AcOfFun_eq (c : Ω ≃ₐ[k] Ω) (b : (Ω ≃ₐ[k] Ω) → E) (h : b ∈ Zc K E c) :
    AcOfFun (K := K) (E := E) c b = Acπ (K := K) (E := E) c ⟨b, h⟩ := dif_pos h

theorem AcOfFun_zero (c : Ω ≃ₐ[k] Ω) (b : (Ω ≃ₐ[k] Ω) → E) (h : b ∉ Zc K E c) :
    AcOfFun (K := K) (E := E) c b = 0 := dif_neg h

/-- A global cocycle restricts to a cocycle on `⟨c⟩`. -/
theorem mem_Zc_of_global {c : Ω ≃ₐ[k] Ω} {b : (Ω ≃ₐ[k] Ω) → E}
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b) : b ∈ Zc K E c := by
  intro g hg h hh
  exact hb g trivial h trivial

/-- On global cocycles `AcOfFun` is additive. -/
theorem AcOfFun_add {c : Ω ≃ₐ[k] Ω} {b b' : (Ω ≃ₐ[k] Ω) → E}
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b)
    (hb' : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b') :
    AcOfFun (K := K) (E := E) c (b + b') = AcOfFun (K := K) (E := E) c b + AcOfFun (K := K) (E := E) c b' := by
  have h1 : b ∈ Zc K E c := mem_Zc_of_global (K := K) (E := E) (c := c) hb
  have h2 : b' ∈ Zc K E c := mem_Zc_of_global (K := K) (E := E) (c := c) hb'
  have h3 : (b + b') ∈ Zc K E c := (Zc K E c).add_mem h1 h2
  rw [AcOfFun_eq (K := K) (E := E) c (b + b') h3,
      AcOfFun_eq (K := K) (E := E) c b h1,
      AcOfFun_eq (K := K) (E := E) c b' h2,
    show (⟨b + b', h3⟩ : ↥(Zc K E c)) = ⟨b, h1⟩ + ⟨b', h2⟩ from Subtype.ext rfl, map_add]

end CycB

end Work.SSGRoute.ArchDictionary
