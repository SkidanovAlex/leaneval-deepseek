/-!
# The norm ray of an ideal modulus is monotone under a `K`-algebra isomorphism

`normRayId 𝔪` is the subgroup of the group of fractional ideals of `K` generated by the relative
norms `N_{L/K} I` of the integral ideals `I` of `L` coprime to the extension `𝔪·𝓞 L`
(`Submission/Work/.../IdealModulus/Defs.lean`).

This module proves that this construction is insensitive to replacing `L` by a `K`-isomorphic
field: if `e : L₁ ≃ₐ[K] L₂` then `normRayId (L := L₂) 𝔪 ≤ normRayId (L := L₁) 𝔪`.

The proof transports a generator `N_{L₂/K} I` across the induced isomorphism
`𝓞 L₁ ≃ₐ[𝓞 K] 𝓞 L₂` of rings of integers:

* the ideal `I` of `𝓞 L₂` is pulled back to `I.comap (𝓞 L₁ ≃+* 𝓞 L₂)`, and the relative norms agree
  (`Ideal.relNorm_comap_algEquiv`);
* coprimality to the modulus transports because a ring equivalence reflects divisibility of ideals
  (`fracCoprimeId_comap_of_algEquiv`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup.MupAux

open NK.CFTLib.ArtinReciprocityIdeal

/-- **Coprimality to an ideal modulus transports backwards along a `K`-algebra isomorphism.**

If an integral ideal `I` of `𝓞 L₂` is coprime to the base change `𝔪·𝓞 L₂`, then its pullback along
the ring isomorphism `𝓞 L₁ ≃+* 𝓞 L₂` induced by `e : L₁ ≃ₐ[K] L₂` is coprime to `𝔪·𝓞 L₁`.

The point is that `count` detects divisibility of ideals, and a ring equivalence carries the primes
of `𝓞 L₁` bijectively to the primes of `𝓞 L₂`, preserving the divisibility relation (the maps on
ideals are monotone in both directions along the equivalence). -/
theorem fracCoprimeId_comap_of_algEquiv {K L₁ L₂ : Type} [Field K] [NumberField K]
    [Field L₁] [NumberField L₁] [Field L₂] [NumberField L₂] [Algebra K L₁] [Algebra K L₂]
    [FiniteDimensional K L₁] [FiniteDimensional K L₂] (e : L₁ ≃ₐ[K] L₂)
    (𝔪 : Ideal (𝓞 K)) {I : Ideal (𝓞 L₂)} (hI : I ≠ ⊥)
    (hcop : FracCoprimeId (K := L₂) (Ideal.map (algebraMap (𝓞 K) (𝓞 L₂)) 𝔪) (idealUnit I hI))
    (hJ : Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I ≠ ⊥) :
    FracCoprimeId (K := L₁) (Ideal.map (algebraMap (𝓞 K) (𝓞 L₁)) 𝔪)
      (idealUnit (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I) hJ) := by
  have hmapJ : Ideal.map (NumberField.RingOfIntegers.mapAlgEquiv e)
      (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I) = I :=
    Ideal.map_comap_of_surjective _ (NumberField.RingOfIntegers.mapAlgEquiv e).surjective I
  intro 𝔭 h𝔭
  -- the base change of the modulus through the isomorphism
  have hcomm : Ideal.map (algebraMap (𝓞 K) (𝓞 L₂) : 𝓞 K →+* 𝓞 L₂) 𝔪
      = Ideal.map (NumberField.RingOfIntegers.mapAlgEquiv e)
          (Ideal.map (algebraMap (𝓞 K) (𝓞 L₁)) 𝔪) := by
    let σ : 𝓞 L₁ →+* 𝓞 L₂ := NumberField.RingOfIntegers.mapAlgEquiv e
    change Ideal.map (algebraMap (𝓞 K) (𝓞 L₂) : 𝓞 K →+* 𝓞 L₂) 𝔪
      = Ideal.map σ (Ideal.map (algebraMap (𝓞 K) (𝓞 L₁)) 𝔪)
    rw [Ideal.map_map]
    congr 1
    exact RingHom.ext fun x => ((NumberField.RingOfIntegers.mapAlgEquiv e).commutes x).symm
  -- the transported prime of `𝓞 L₂`
  let 𝔭₂ : HeightOneSpectrum (𝓞 L₂) :=
    ⟨Ideal.map (NumberField.RingOfIntegers.mapAlgEquiv e) 𝔭.asIdeal,
      Ideal.map_isPrime_of_equiv (NumberField.RingOfIntegers.mapAlgEquiv e),
      fun h => 𝔭.ne_bot ((Ideal.map_eq_bot_iff_of_injective
        (f := (NumberField.RingOfIntegers.mapAlgEquiv e : 𝓞 L₁ →+* 𝓞 L₂))
        (NumberField.RingOfIntegers.mapAlgEquiv e).injective).mp h)⟩
  have h𝔭₂ : 𝔭₂.asIdeal = Ideal.map (NumberField.RingOfIntegers.mapAlgEquiv e) 𝔭.asIdeal := rfl
  have hdvd₂ : DvdPrime (Ideal.map (algebraMap (𝓞 K) (𝓞 L₂)) 𝔪) 𝔭₂ := by
    show Ideal.map (algebraMap (𝓞 K) (𝓞 L₂)) 𝔪 ≤ 𝔭₂.asIdeal
    rw [h𝔭₂, hcomm]
    exact Ideal.map_mono h𝔭
  -- coprimality at the transported prime
  have hcount : FractionalIdeal.count L₂ 𝔭₂ (I : FractionalIdeal (𝓞 L₂)⁰ L₂) = 0 :=
    hcop 𝔭₂ hdvd₂
  have hnotdvd₂ : ¬ 𝔭₂.asIdeal ∣ I := by
    intro hd
    have hI0 : I ≠ 0 := by simpa [Ideal.zero_eq_bot] using hI
    have hne : (Associates.mk 𝔭₂.asIdeal).count (Associates.mk I).factors ≠ 0 :=
      (Associates.count_ne_zero_iff_dvd hI0 𝔭₂.irreducible).mpr hd
    have hZ : ((Associates.mk 𝔭₂.asIdeal).count (Associates.mk I).factors : ℤ) = 0 := by
      rw [← FractionalIdeal.count_coe L₂ 𝔭₂ hI0, hcount]
    exact hne (Int.ofNat_eq_zero.mp hZ)
  have hJ0 : Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I ≠ 0 := by
    simpa [Ideal.zero_eq_bot] using hJ
  have hnotdvd : ¬ 𝔭.asIdeal ∣ Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I := by
    intro hd
    refine hnotdvd₂ ?_
    rw [h𝔭₂]
    refine Ideal.dvd_iff_le.mpr ?_
    rw [← hmapJ]
    exact Ideal.map_mono (Ideal.dvd_iff_le.mp hd)
  rw [show ((idealUnit (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I) hJ : Frac L₁)
      : FractionalIdeal (𝓞 L₁)⁰ L₁)
      = (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I
          : FractionalIdeal (𝓞 L₁)⁰ L₁) from rfl]
  rw [FractionalIdeal.count_coe L₁ 𝔭 hJ0, Int.natCast_eq_zero, ← not_ne_iff]
  exact fun hne => hnotdvd ((Associates.count_ne_zero_iff_dvd hJ0 𝔭.irreducible).mp hne)

theorem normRayId_le_of_algEquiv {K L₁ L₂ : Type} [Field K] [NumberField K] [Field L₁]
    [NumberField L₁] [Field L₂] [NumberField L₂] [Algebra K L₁] [Algebra K L₂]
    [FiniteDimensional K L₁] [FiniteDimensional K L₂] (e : L₁ ≃ₐ[K] L₂)
    (𝔪 : Ideal (NumberField.RingOfIntegers K)) :
    NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L₂) 𝔪
      ≤ NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L₁) 𝔪 := by
  simp only [NK.CFTLib.ArtinReciprocityIdeal.normRayId]
  refine (Subgroup.closure_le _).mpr ?_
  rintro A ⟨I, hI, hcop, rfl⟩
  have hmapJ : Ideal.map (NumberField.RingOfIntegers.mapAlgEquiv e)
      (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I) = I :=
    Ideal.map_comap_of_surjective _ (NumberField.RingOfIntegers.mapAlgEquiv e).surjective I
  have hJ : Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I ≠ ⊥ := by
    intro h
    exact hI (by rw [← hmapJ, h, Ideal.map_bot])
  have hrelnorm : Ideal.relNorm (𝓞 K) (Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I)
      = Ideal.relNorm (𝓞 K) I :=
    Ideal.relNorm_comap_algEquiv (NumberField.RingOfIntegers.mapAlgEquiv e) I
  refine Subgroup.subset_closure ⟨Ideal.comap (NumberField.RingOfIntegers.mapAlgEquiv e) I, hJ,
    fracCoprimeId_comap_of_algEquiv e 𝔪 hI hcop hJ, ?_⟩
  apply Units.ext
  simp only [NK.CFTLib.ArtinReciprocityIdeal.idealUnit, Units.val_mk0]
  rw [hrelnorm]

end Work.SSGRoute.ZDataMup.MupAux
