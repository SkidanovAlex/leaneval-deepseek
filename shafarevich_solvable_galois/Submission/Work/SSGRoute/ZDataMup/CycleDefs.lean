/-!
# Cycles (ideal moduli) and the Lang-era vocabulary

The Lang-era conductor machinery in `Submission/NK/` (`transferOfAuxField`,
`langCyclicRelIndex`, `langX2KernelLe`, …) is stated for moduli `m : ℕ`.  For a number field `K`
this is a genuine restriction: if `𝔭 | (m)` then *every* prime `𝔮 | p(𝔭)` also divides `(m)`,
because `v_𝔮(m) = e_𝔮 f_𝔮 v_p(m) ≥ 1`.  Hence the support of a natural-number modulus is always
*saturated above the rational primes*, and no `ℕ`-modulus can have support exactly the set `R` of
ramified primes when two primes above one rational prime behave differently
(`supp(m) ⊇ R̂ := {𝔮 : p(𝔮) ∈ P(R)}`, possibly `⊋ R`).

The conductor-drop theorem, however, needs the congruence only at the ramified primes.  The
corresponding generalisation is to allow the *cycle* (Lang's `c`) language: an arbitrary finite
set of primes with a level attached to each.  This module introduces that vocabulary, in exact
parallel with the `ℕ`-versions in
`NK.CFTLib.ArtinReciprocityIdeal.LangDefs`, together with the (definitional) identification of
the `ℕ`-moduli as the "saturated with correlated levels" cycles.

## Contents

* `Work.SSGRoute.ZDataMup.Cycle` — a finite set of finite places of `K` with exponents;
* `Cycle.FracCoprime`, `Cycle.CongrOne`, `Cycle.principalRay`, `Cycle.idealCoprimeGroup`,
  `Cycle.normRay` — the cycle-versions of `NK.CFTLib.ArtinReciprocityIdeal.FracCoprime`,
  `CongrOne`, `principalRay`, `idealCoprimeGroup`, `normRay`;
* `Cycle.ofNat` — the cycle of a natural-number modulus, and the compatibility lemmas
  `Cycle.FracCoprime_ofNat_iff`, `Cycle.CongrOne_ofNat_iff`, `Cycle.principalRay_ofNat`,
  `Cycle.idealCoprimeGroup_ofNat`, `Cycle.normRay_ofNat`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup

open NK.CFTLib.ArtinReciprocityIdeal

/-- **A cycle (ideal modulus) for `K`**: a finite set of finite places together with an exponent
attached to each.  This is Lang's `c = ∏_{𝔭} 𝔭^{n(𝔭)}` as a formal product, i.e. an ideal modulus;
unlike a natural-number modulus its support need not be saturated above the rational primes. -/
structure Cycle (K : Type*) [Field K] [NumberField K] where
  /-- the primes occurring in the cycle -/
  supp : Finset (HeightOneSpectrum (𝓞 K))
  /-- the exponent attached to each prime (irrelevant outside `supp`) -/
  lev : HeightOneSpectrum (𝓞 K) → ℕ

namespace Cycle

variable {K : Type*} [Field K] [NumberField K]

/-- **A fractional ideal is coprime to a cycle** if none of the primes of the cycle occurs in it. -/
def FracCoprime (c : Cycle K) (A : Frac K) : Prop :=
  ∀ 𝔭 ∈ c.supp, FractionalIdeal.count K 𝔭 (A : FractionalIdeal (𝓞 K)⁰ K) = 0

/-- **The congruence-`1` condition of a cycle**: at every prime `𝔭` of the cycle the element `a`
is congruent to `1` modulo the `lev 𝔭`-th power of `𝔭`, and `a` is positive at every real
place.  (The level is used directly as an exponent in the value group, so that cycles coming from
a natural-number modulus reproduce `NK.CFTLib.ArtinReciprocityIdeal.CongrOne` definitionally on
the nose — see `Cycle.CongrOne_ofNat_iff`.) -/
def CongrOne (c : Cycle K) (a : Kˣ) : Prop :=
  (∀ 𝔭 ∈ c.supp,
      Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
        (algebraMap K (𝔭.adicCompletion K) (a : K) - 1)
        ≤ (WithZero.exp (-(((c.lev 𝔭 : ℕ) : ℤ))) : WithZero (Multiplicative ℤ)))
    ∧ (∀ (w : InfinitePlace K) (hw : w.IsReal),
        0 < (InfinitePlace.Completion.ringEquivRealOfIsReal hw)
              (algebraMap K w.Completion (a : K)))

/-- **The principal ray `P(c)` of a cycle**: the subgroup generated by the principal ideals `(a)`
with `a ≡ 1 mod c` and `a` totally positive. -/
def principalRay (c : Cycle K) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ a : Kˣ, c.CongrOne a ∧ A = spanUnit a}

/-- **The group `I(c)` of fractional ideals coprime to the cycle**, presented as the subgroup
generated by the prime ideals outside `c.supp`. -/
def idealCoprimeGroup (c : Cycle K) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ 𝔭 : HeightOneSpectrum (𝓞 K),
    𝔭 ∉ c.supp ∧ A = idealUnit 𝔭.asIdeal 𝔭.ne_bot}

/-- **The norm group `𝔑(c)` of a cycle**: the subgroup generated by the relative norms of the
ideals of `L` that are coprime to the cycle `cL` over `L`.  The cycle over `L` is passed
separately (so that this does not depend on a choice of base change of a cycle along `K → L`). -/
def normRay (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] (c : Cycle K) (cL : Cycle L) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ (I : Ideal (𝓞 L)) (hI : I ≠ ⊥),
    FracCoprime (K := L) cL (idealUnit I hI) ∧
    A = idealUnit (Ideal.relNorm (𝓞 K) I) (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h))}

end Cycle

/-! ## Admissibility for cycles -/

/-- **A cycle is admissible for `L/K`** (the cycle analogue of
`NK.CFTLib.ArtinReciprocityIdeal.IsAdmissible`): at every prime of the cycle, a unit congruent to
`1` modulo the level is a local norm at every prime of `L` above it.  The archimedean places need
no condition. -/
def Cycle.IsAdmissible (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (c : Cycle K) : Prop :=
  ∀ (𝔭 : HeightOneSpectrum (𝓞 K)), 𝔭 ∈ c.supp →
    ∀ (𝔮 : HeightOneSpectrum (𝓞 L)) (h𝔮 : 𝔮.asIdeal.LiesOver 𝔭.asIdeal)
      (x : (𝔭.adicCompletion K)ˣ),
      Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
          ((x : 𝔭.adicCompletion K) - 1)
        ≤ (WithZero.exp (-(((c.lev 𝔭 : ℕ) : ℤ))) : WithZero (Multiplicative ℤ)) →
      x ∈ (NK.GlobalCFT.Place.localNormFinite 𝔮 𝔭 h𝔮).range

/-- **The base-change bookkeeping of the norm ray**: `cL` is the cycle over `L` whose support is
exactly the set of primes above the primes of `c`.  Stated as a predicate (so that no `Finset` of
primes above a given prime has to be constructed), and only about the *support*, which is all that
`Cycle.FracCoprime` and `Cycle.normRay` read off from `cL`. -/
def Cycle.IsBaseChange (K L : Type*) [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] (c : Cycle K) (cL : Cycle L) : Prop :=
  ∀ 𝔮 : HeightOneSpectrum (𝓞 L),
    𝔮 ∈ cL.supp ↔ ∃ 𝔭 ∈ c.supp, 𝔮.asIdeal.LiesOver 𝔭.asIdeal

/-! ## The level of a natural number at a prime -/

/-- **The exponent of the prime `𝔭` in the principal ideal `(m) ⊆ 𝓞 K`** (universe-polymorphic
copy of `Work.SSGRoute.ZDataMup.adicMultiplicity`). -/
def cycleLevel {K : Type*} [Field K] [NumberField K] (m : ℕ)
    (𝔭 : HeightOneSpectrum (𝓞 K)) : ℕ :=
  (Associates.mk 𝔭.asIdeal).count (Associates.mk (Ideal.span {(m : 𝓞 K)})).factors

/-- **The `𝔭`-adic value of a positive integer is `exp (-(level))`**: the completion valuation
restricts to the global `𝔭`-adic valuation, which on `𝓞 K` is Mathlib's `intValuation`,
*defined* as `exp (-(count 𝔭 (factors (span {m}))))`. -/
theorem valued_natCast_eq_exp_cycleLevel {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) (𝔭 : HeightOneSpectrum (𝓞 K)) :
    Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
        (((m : ℕ) : 𝔭.adicCompletion K))
      = (WithZero.exp (-(((cycleLevel (K := K) m 𝔭 : ℕ) : ℤ))) :
          WithZero (Multiplicative ℤ)) := by
  have hmK : (m : K) ≠ 0 := by exact_mod_cast hm.ne'
  have hmO : (m : 𝓞 K) ≠ 0 := by
    intro h
    apply hmK
    have := congrArg (algebraMap (𝓞 K) K) h
    simpa using this
  have h1 : ((m : ℕ) : 𝔭.adicCompletion K) = ((m : K) : 𝔭.adicCompletion K) :=
    (map_natCast (algebraMap K (𝔭.adicCompletion K)) m).symm
  have h3 : Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
      ((m : K) : 𝔭.adicCompletion K) = 𝔭.valuation K (m : K) :=
    IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation' 𝔭 (m : K)
  rw [h1, h3]
  have h2 : (algebraMap (𝓞 K) K (m : 𝓞 K)) = (m : K) := map_natCast _ m
  rw [← h2, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
    IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg 𝔭 hmO]
  rfl

/-! ## Natural-number moduli as cycles -/

/-- **The cycle of a natural-number modulus**: support the primes dividing `(m)`, level the
exponent of the prime in `(m)`. -/
noncomputable def Cycle.ofNat {K : Type*} [Field K] [NumberField K] (m : ℕ) (hm : 0 < m) :
    Cycle K :=
  { supp := (NK.CFTLib.ArtinReciprocityIdeal.finite_setOf_mem_span (K := K) m hm).toFinset
    lev := fun 𝔭 => cycleLevel (K := K) m 𝔭 }

@[simp] theorem Cycle.mem_supp_ofNat {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) (𝔭 : HeightOneSpectrum (𝓞 K)) :
    𝔭 ∈ (Cycle.ofNat (K := K) m hm).supp ↔ (m : 𝓞 K) ∈ 𝔭.asIdeal :=
  (NK.CFTLib.ArtinReciprocityIdeal.finite_setOf_mem_span (K := K) m hm).mem_toFinset

@[simp] theorem Cycle.lev_ofNat {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) (𝔭 : HeightOneSpectrum (𝓞 K)) :
    (Cycle.ofNat (K := K) m hm).lev 𝔭 = cycleLevel (K := K) m 𝔭 := rfl

theorem Cycle.FracCoprime_ofNat_iff {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) (A : NK.CFTLib.ArtinReciprocityIdeal.Frac K) :
    (Cycle.ofNat (K := K) m hm).FracCoprime A
      ↔ NK.CFTLib.ArtinReciprocityIdeal.FracCoprime m A := by
  constructor
  · intro h 𝔭 h𝔭
    exact h 𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mpr h𝔭)
  · intro h 𝔭 h𝔭
    exact h 𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mp h𝔭)

theorem Cycle.CongrOne_ofNat_iff {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) (a : Kˣ) :
    (Cycle.ofNat (K := K) m hm).CongrOne a
      ↔ NK.CFTLib.ArtinReciprocityIdeal.CongrOne m a := by
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun 𝔭 h𝔭 => ?_, h2⟩
    rw [valued_natCast_eq_exp_cycleLevel (K := K) m hm 𝔭]
    exact h1 𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mpr h𝔭)
  · rintro ⟨h1, h2⟩
    refine ⟨fun 𝔭 h𝔭 => ?_, h2⟩
    have h := h1 𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mp h𝔭)
    rwa [valued_natCast_eq_exp_cycleLevel (K := K) m hm 𝔭] at h

theorem Cycle.principalRay_ofNat {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) :
    (Cycle.ofNat (K := K) m hm).principalRay
      = NK.CFTLib.ArtinReciprocityIdeal.principalRay K m := by
  have h : {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K |
        ∃ a : Kˣ, (Cycle.ofNat (K := K) m hm).CongrOne a
          ∧ A = NK.CFTLib.ArtinReciprocityIdeal.spanUnit a}
      = {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K |
        ∃ a : Kˣ, NK.CFTLib.ArtinReciprocityIdeal.CongrOne m a
          ∧ A = NK.CFTLib.ArtinReciprocityIdeal.spanUnit a} := by
    ext A
    constructor
    · rintro ⟨a, ha, rfl⟩
      exact ⟨a, (Cycle.CongrOne_ofNat_iff m hm a).mp ha, rfl⟩
    · rintro ⟨a, ha, rfl⟩
      exact ⟨a, (Cycle.CongrOne_ofNat_iff m hm a).mpr ha, rfl⟩
  unfold Cycle.principalRay NK.CFTLib.ArtinReciprocityIdeal.principalRay
  rw [h]

theorem Cycle.idealCoprimeGroup_ofNat {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (hm : 0 < m) :
    (Cycle.ofNat (K := K) m hm).idealCoprimeGroup
      = NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K m := by
  have h : {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K | ∃ 𝔭 : HeightOneSpectrum (𝓞 K),
        𝔭 ∉ (Cycle.ofNat (K := K) m hm).supp
          ∧ A = NK.CFTLib.ArtinReciprocityIdeal.idealUnit 𝔭.asIdeal 𝔭.ne_bot}
      = {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K | ∃ 𝔭 : HeightOneSpectrum (𝓞 K),
        (m : 𝓞 K) ∉ 𝔭.asIdeal
          ∧ A = NK.CFTLib.ArtinReciprocityIdeal.idealUnit 𝔭.asIdeal 𝔭.ne_bot} := by
    ext A
    constructor
    · rintro ⟨𝔭, h𝔭, rfl⟩
      exact ⟨𝔭, fun hmem => h𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mpr hmem), rfl⟩
    · rintro ⟨𝔭, h𝔭, rfl⟩
      exact ⟨𝔭, fun hmem => h𝔭 ((Cycle.mem_supp_ofNat m hm 𝔭).mp hmem), rfl⟩
  unfold Cycle.idealCoprimeGroup NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup
  rw [h]

theorem Cycle.normRay_ofNat {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (m : ℕ) (hm : 0 < m) :
    Cycle.normRay K L (Cycle.ofNat (K := K) m hm) (Cycle.ofNat (K := L) m hm)
      = NK.CFTLib.ArtinReciprocityIdeal.normRay K L m := by
  have h : {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K |
        ∃ (I : Ideal (𝓞 L)) (hI : I ≠ ⊥),
          (Cycle.ofNat (K := L) m hm).FracCoprime
            (NK.CFTLib.ArtinReciprocityIdeal.idealUnit I hI) ∧
          A = NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 K) I)
            (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h))}
      = {A : NK.CFTLib.ArtinReciprocityIdeal.Frac K |
        ∃ (I : Ideal (𝓞 L)) (hI : I ≠ ⊥),
          NK.CFTLib.ArtinReciprocityIdeal.FracCoprime (K := L) m
            (NK.CFTLib.ArtinReciprocityIdeal.idealUnit I hI) ∧
          A = NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 K) I)
            (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h))} := by
    ext A
    constructor
    · rintro ⟨I, hI, hcop, hA⟩
      exact ⟨I, hI, (Cycle.FracCoprime_ofNat_iff m hm _).mp hcop, hA⟩
    · rintro ⟨I, hI, hcop, hA⟩
      exact ⟨I, hI, (Cycle.FracCoprime_ofNat_iff m hm _).mpr hcop, hA⟩
  unfold Cycle.normRay NK.CFTLib.ArtinReciprocityIdeal.normRay
  rw [h]

end Work.SSGRoute.ZDataMup
