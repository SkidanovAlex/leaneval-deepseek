/-!
# Lang's cyclic norm index inequality for an ideal modulus

The ideal-modulus form of `NK.CFTLib.ArtinReciprocityIdeal.langCyclicRelIndex`: for a finite
**cyclic** extension `L/K` of number fields and a modulus `𝔪 ≠ ⊥` which is admissible and
contains all the primes ramified in `L/K`,

  `[L : K] ≤ [I(𝔪) : P(𝔪)·𝔑(𝔪)]`,

where `I(𝔪) = idealCoprimeGroupId 𝔪` is the group of fractional ideals of `K` coprime to `𝔪`,
`P(𝔪) = principalRayId 𝔪` is the principal ray and `𝔑(𝔪) = normRayId 𝔪` is the group generated by
the relative norms of the ideals of `L` coprime to `𝔪·𝓞 L`.

The proof is the idèle-theoretic one: the map `θ : 𝕀 K →* (fractional ideals) ⧸ P(𝔪)·𝔑(𝔪)`
(`thetaId`, defined in `AdjustId.lean` with the adjustment of idèles into the congruence subgroup
`U(𝔪)`) has kernel `Kˣ · N_{L/K} 𝕀 L`: the inclusion `⊇` is
`principalSubgroup_sup_normImage_le_ker_thetaId`, the inclusion `⊆` is `thetaId_ker_le`, which uses
the admissibility of `𝔪` (the congruence units of level `𝔪` are local norms) and Hasse's norm
theorem.  Hence

  `[I(𝔪) : P(𝔪)·𝔑(𝔪)] = [𝕀 K : Kˣ · N 𝕀 L] = [C_K : N C_L] = [L : K]`,

the last equality being the unconditional cyclic norm index theorem
`NK.GlobalCFTdeep.index_eq_finrank_of_isCyclic`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus

open NK.GlobalCFT

theorem langCyclicRelIndexId
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (𝔪 : Ideal (NumberField.RingOfIntegers K)) (h𝔪 : 𝔪 ≠ ⊥)
    (hram : NK.CFTLib.ArtinReciprocityIdeal.ContainsRamified (K := K) (L := L) 𝔪)
    (hadm : NK.CFTLib.ArtinReciprocityIdeal.IsAdmissibleId (K := K) (L := L) 𝔪) :
    (NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪) ≤
      NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪 ∧
    Module.finrank K L ≤
      (NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪).relIndex
        (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪) := by
  refine ⟨conjunctOneId (K := K) (L := L) 𝔪 h𝔪, ?_⟩
  have hker_le := NK.CFTLib.ArtinReciprocityIdeal.thetaId_ker_le (K := K) (L := L) h𝔪 hram hadm
  have hker_ge := NK.CFTLib.ArtinReciprocityIdeal.principalSubgroup_sup_normImage_le_ker_thetaId
    (K := K) (L := L) h𝔪
  have hker_eq : (NK.CFTLib.ArtinReciprocityIdeal.thetaId K L 𝔪 h𝔪).ker =
      Idele.principalSubgroup K ⊔ Idele.normImage K L := le_antisymm hker_le hker_ge
  calc Module.finrank K L
      = (Idele.normClassSubgroup K L).index :=
        (NK.GlobalCFTdeep.index_eq_finrank_of_isCyclic (K := K) (L := L)).symm
    _ = (Idele.principalSubgroup K ⊔ Idele.normImage K L).index :=
        (NK.CFTLib.ArtinReciprocityIdeal.index_principalSubgroup_sup_normImage
          (K := K) (L := L) 1).symm
    _ = (NK.CFTLib.ArtinReciprocityIdeal.thetaId K L 𝔪 h𝔪).ker.index := by rw [hker_eq]
    _ = ((NK.CFTLib.ArtinReciprocityIdeal.rayNormClId K L 𝔪).subgroupOf
          (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪)).index :=
        (NK.CFTLib.ArtinReciprocityIdeal.index_rayNormId_eq_ker_index
          (K := K) (L := L) h𝔪).symm
    _ = (((NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
          NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪).subgroupOf
          (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪))).index := by
        rw [NK.CFTLib.ArtinReciprocityIdeal.rayNormClId,
          NK.CFTLib.ArtinReciprocityIdeal.principalRayClId_eq_principalRayId h𝔪]
    _ ≤ (NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
          NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪).relIndex
          (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪) := le_of_eq rfl

end Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus
