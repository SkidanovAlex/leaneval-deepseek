/-!
# Descent of the norm ray of an *ideal* modulus along the relative norm

`NK.CFTLib.ArtinReciprocityIdeal.normRayId 𝔪` is the norm group `𝔑(𝔪)` of the ideal modulus `𝔪`:
the subgroup of the group of fractional ideals of `K` generated by the relative norms
`N_{L/K} I` of the integral ideals `I ≠ 0` of `L` whose prime factors avoid the primes dividing
`𝔪·𝓞 L`.

This file proves the *transfer* statement for an ideal modulus, the ideal-modulus analogue of
`NK.CFTLib.ARLAlt.normRay_map_relNormUnit_le`.  In the double tower

  `K ⊆ E ⊆ LE`,   `K ⊆ L ⊆ LE`

(`LE` simultaneously an extension of `E` and of `L`), the relative norm `N_{E/K}` sends the norm
group of `LE/E` at a modulus `𝔠` into the norm group of `L/K` at any modulus `𝔪` with
`𝔠 ⊆ 𝔪·𝓞 E`.

The proof is the natural one.  A generator of `normRayId (K := E) (L := LE) 𝔠` is the relative norm
`N_{E/LE} I` of an ideal `I ≠ 0` of `LE` coprime to `𝔠·𝓞 LE`.  By transitivity of the relative norm
(`NK.CFTLib.ARL.relNormUnit_trans`, here used in the shape `relNormFI_coeIdeal` +
`Ideal.relNorm_relNorm`) this equals `N_{K/LE} I`, and unpacked in the tower `K ⊆ L ⊆ LE` it is the
relative norm over `L` of `J = N_{L/LE} I`.  The coprimality is hereditary
(`fracCoprimeId_relNorm`, `fracCoprimeId_mono`) because
`𝔠·𝓞 LE ⊆ (𝔪·𝓞 E)·𝓞 LE = 𝔪·𝓞 LE = (𝔪·𝓞 L)·𝓞 LE`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus.transfer

/-! ## Two auxiliary lemmas -/

/-- **The relative norm of the integral ideal `I` is the integral ideal `N_{L/K} I`.**  Both are
packaged as elements of the group of fractional ideals; this is `relNormFI_coeIdeal` in
disguise. -/
lemma relNormUnit_idealUnit {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L]
    (I : Ideal (𝓞 L)) (hI : I ≠ ⊥) :
    NK.CFTLib.ARL.relNormUnit (K := K) (L := L)
        (NK.CFTLib.ArtinReciprocityIdeal.idealUnit I hI) =
      NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 K) I)
        (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h)) := by
  apply Units.ext
  rw [NK.CFTLib.ARL.relNormUnit_apply_e]
  exact NK.CFTLib.ARL.relNormFI_coeIdeal (K := K) (L := L) I hI

/-- `idealUnit` only depends on the underlying ideal: the nonzeroness proof is irrelevant. -/
lemma idealUnit_eq_idealUnit {K : Type} [Field K] [NumberField K] {A B : Ideal (𝓞 K)}
    (hA : A ≠ ⊥) (hB : B ≠ ⊥) (hh : A = B) :
    NK.CFTLib.ArtinReciprocityIdeal.idealUnit A hA =
      NK.CFTLib.ArtinReciprocityIdeal.idealUnit B hB := by
  subst hh
  rfl

/-! ## The transfer statement -/

theorem normRayId_map_relNormUnit_le {K L E LE : Type}
    [Field K] [NumberField K] [Field L] [NumberField L] [Field E] [NumberField E]
    [Field LE] [NumberField LE]
    [Algebra K E] [Algebra E LE] [Algebra K LE] [IsScalarTower K E LE]
    [Algebra K L] [Algebra L LE] [IsScalarTower K L LE]
    [FiniteDimensional K E] [FiniteDimensional E LE] [FiniteDimensional K L]
    [FiniteDimensional L LE]
    (𝔠 : Ideal (NumberField.RingOfIntegers E)) (𝔪 : Ideal (NumberField.RingOfIntegers K))
    (h𝔪 : 𝔪 ≠ ⊥)
    (h : 𝔠 ≤ Ideal.map (algebraMap (NumberField.RingOfIntegers K)
      (NumberField.RingOfIntegers E)) 𝔪) :
    (NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := E) (L := LE) 𝔠).map
        (NK.CFTLib.ARL.relNormUnit (K := K) (L := E))
      ≤ NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪 := by
  rw [NK.CFTLib.ArtinReciprocityIdeal.normRayId, Subgroup.map_le_iff_le_comap,
    Subgroup.closure_le]
  rintro A ⟨I, hI, hcop, rfl⟩
  classical
  have hEne : Ideal.relNorm (𝓞 E) I ≠ ⊥ := fun hh => hI ((Ideal.relNorm_eq_bot_iff).mp hh)
  -- unfold the membership in the `comap` to expose the relative norm
  show NK.CFTLib.ARL.relNormUnit (K := K) (L := E)
      (NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 E) I) hEne) ∈
      NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪
  set J : Ideal (𝓞 L) := Ideal.relNorm (𝓞 L) I with hJdef
  have hJne : J ≠ ⊥ := fun hh => hI ((Ideal.relNorm_eq_bot_iff).mp (hJdef ▸ hh))
  -- the hereditary coprimality: `𝔠·𝓞 LE ⊆ (𝔪·𝓞 E)·𝓞 LE = 𝔪·𝓞 LE = (𝔪·𝓞 L)·𝓞 LE`
  have hle : Ideal.map (algebraMap (𝓞 E) (𝓞 LE)) 𝔠 ≤
      Ideal.map (algebraMap (𝓞 L) (𝓞 LE)) (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪) := by
    calc Ideal.map (algebraMap (𝓞 E) (𝓞 LE)) 𝔠
        ≤ Ideal.map (algebraMap (𝓞 E) (𝓞 LE)) (Ideal.map (algebraMap (𝓞 K) (𝓞 E)) 𝔪) :=
          Ideal.map_mono h
      _ = Ideal.map (algebraMap (𝓞 K) (𝓞 LE)) 𝔪 := by
          rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
      _ = Ideal.map (algebraMap (𝓞 L) (𝓞 LE)) (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪) := by
          rw [Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  have hcopJ : NK.CFTLib.ArtinReciprocityIdeal.FracCoprimeId (K := L)
      (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪)
      (NK.CFTLib.ArtinReciprocityIdeal.idealUnit J hJne) := by
    have hmap : NK.CFTLib.ArtinReciprocityIdeal.FracCoprimeId (K := LE)
        (Ideal.map (algebraMap (𝓞 L) (𝓞 LE)) (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪))
        (NK.CFTLib.ArtinReciprocityIdeal.idealUnit I hI) :=
      NK.CFTLib.ArtinReciprocityIdeal.fracCoprimeId_mono hle hcop
    have hrel := fracCoprimeId_relNorm (K := L) (L := LE)
      (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪) hI hmap
    simpa [hJdef] using hrel
  -- transitivity of the relative norm: `N_{K/E}(N_{E/LE} I) = N_{K/LE} I = N_{K/L}(N_{L/LE} I)`
  have hideal : Ideal.relNorm (𝓞 K) (Ideal.relNorm (𝓞 E) I) = Ideal.relNorm (𝓞 K) J := by
    rw [hJdef, Ideal.relNorm_relNorm (𝓞 K) (𝓞 L) I, Ideal.relNorm_relNorm (𝓞 K) (𝓞 E) I]
  have hmain : NK.CFTLib.ARL.relNormUnit (K := K) (L := E)
      (NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 E) I) hEne) =
      NK.CFTLib.ArtinReciprocityIdeal.idealUnit (Ideal.relNorm (𝓞 K) J)
        (fun hh => hJne ((Ideal.relNorm_eq_bot_iff).mp hh)) := by
    rw [relNormUnit_idealUnit (K := K) (L := E) (Ideal.relNorm (𝓞 E) I) hEne]
    exact idealUnit_eq_idealUnit _ _ hideal
  rw [hmain]
  exact Subgroup.subset_closure ⟨J, hJne, hcopJ, rfl⟩

end Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus.transfer
