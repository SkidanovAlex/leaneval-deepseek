namespace NK.CFTLib.ArtinReciprocityIdeal

open NK.GlobalCFT

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L]

/-! ## Elementary lemmas about the ideal-modulus vocabulary -/

/-- `DvdPrime` is monotone in the modulus, in the direction in which the divisibility `𝔭 | 𝔪`
is: if `𝔪 ≤ 𝔫` (i.e. `𝔫 | 𝔪`) and `𝔭 | 𝔫` then `𝔭 | 𝔪`. -/
lemma dvdPrime_mono {𝔪 𝔫 : Ideal (𝓞 K)} (h : 𝔪 ≤ 𝔫) {𝔭 : HeightOneSpectrum (𝓞 K)}
    (h𝔭 : DvdPrime 𝔫 𝔭) : DvdPrime 𝔪 𝔭 := le_trans h h𝔭

/-- **`DvdPrime` depends only on the divisibility of the modulus.** -/
lemma dvdPrime_iff_dvd' {𝔪 : Ideal (𝓞 K)} {𝔭 : HeightOneSpectrum (𝓞 K)} :
    DvdPrime 𝔪 𝔭 ↔ 𝔭.asIdeal ∣ 𝔪 := Ideal.dvd_iff_le.symm

/-- A prime dividing a nonzero ideal has positive exponent. -/
lemma dvdPrime_count_pos {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) {𝔭 : HeightOneSpectrum (𝓞 K)}
    (h𝔭 : DvdPrime 𝔪 𝔭) :
    1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) := by
  have h0 : 𝔪 ≠ 0 := by simpa [Ideal.zero_eq_bot] using h𝔪
  rw [FractionalIdeal.count_coe K 𝔭 h0]
  have hdvd : 𝔭.asIdeal ∣ 𝔪 := Ideal.dvd_iff_le.mpr h𝔭
  have hne : (Associates.mk 𝔭.asIdeal).count (Associates.mk 𝔪).factors ≠ 0 :=
    (Associates.count_ne_zero_iff_dvd h0 𝔭.irreducible).mpr hdvd
  exact_mod_cast Nat.one_le_iff_ne_zero.mpr hne

/-- Coprimality to a modulus is monotone in the modulus. -/
lemma fracCoprimeId_mono {𝔪 𝔫 : Ideal (𝓞 K)} (h : 𝔪 ≤ 𝔫) {A : Frac K}
    (hA : FracCoprimeId 𝔪 A) : FracCoprimeId 𝔫 A :=
  fun 𝔭 h𝔭 => hA 𝔭 (dvdPrime_mono h h𝔭)

/-- The principal ray grows with the modulus. -/
lemma principalRayId_mono {𝔪 𝔫 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) (h : 𝔪 ≤ 𝔫) :
    principalRayId 𝔪 ≤ principalRayId 𝔫 := by
  rw [principalRayId, principalRayId, Subgroup.closure_le]
  rintro A ⟨a, ha, rfl⟩
  have h0 : (𝔪 : FractionalIdeal (𝓞 K)⁰ K) ≠ 0 := by
    rw [FractionalIdeal.coeIdeal_ne_zero]
    simpa [Ideal.zero_eq_bot] using h𝔪
  have hcnt : ∀ 𝔭 : HeightOneSpectrum (𝓞 K),
      FractionalIdeal.count K 𝔭 (𝔫 : FractionalIdeal (𝓞 K)⁰ K)
        ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) :=
    fun 𝔭 => FractionalIdeal.count_mono (K := K) (v := 𝔭) h0
      ((FractionalIdeal.coeIdeal_le_coeIdeal (K := K)).mpr h)
  refine Subgroup.subset_closure ⟨a, ⟨fun 𝔭 h𝔭 => ?_, ha.2⟩, rfl⟩
  exact le_trans (ha.1 𝔭 (dvdPrime_mono h h𝔭)) (WithZero.exp_le_exp.mpr (by
    have := hcnt 𝔭
    omega))

/-- The norm ray grows with the modulus. -/
lemma normRayId_mono {𝔪 𝔫 : Ideal (𝓞 K)} (h : 𝔪 ≤ 𝔫) :
    normRayId (K := K) (L := L) 𝔪 ≤ normRayId (K := K) (L := L) 𝔫 := by
  rw [normRayId, normRayId, Subgroup.closure_le]
  rintro A ⟨I, hI, hcop, rfl⟩
  exact Subgroup.subset_closure ⟨I, hI, fracCoprimeId_mono (Ideal.map_mono h) hcop, rfl⟩

/-- The group of fractional ideals coprime to the modulus grows with the modulus. -/
lemma idealCoprimeGroupId_mono {𝔪 𝔫 : Ideal (𝓞 K)} (h : 𝔪 ≤ 𝔫) :
    idealCoprimeGroupId 𝔪 ≤ idealCoprimeGroupId 𝔫 := by
  rw [idealCoprimeGroupId, idealCoprimeGroupId, Subgroup.closure_le]
  rintro A ⟨𝔭, h𝔭, rfl⟩
  exact Subgroup.subset_closure ⟨𝔭, fun hc => h𝔭 (dvdPrime_mono h hc), rfl⟩

/-! ## The local congruence condition and the level -/

/-- **The local congruence `y ≡ 1 mod 𝔪` at `𝔭`**, at the level `count K 𝔭 𝔪`: the ideal-modulus
analogue of `NK.CFTLib.Arl.CongrAt`. -/
def CongrAtId (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K))
    (y : (𝔭.adicCompletion K)ˣ) : Prop :=
  Valued.v ((y : 𝔭.adicCompletion K) - 1)
    ≤ WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ))

/-- The level of the congruence condition is at most `1` (the `count` is nonnegative). -/
lemma exp_neg_count_le_one (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K)) :
    (WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ)) :
      WithZero (Multiplicative ℤ)) ≤ 1 := by
  rw [← WithZero.exp_zero]
  refine WithZero.exp_le_exp.mpr ?_
  have h := FractionalIdeal.count_coe_nonneg (K := K) (v := 𝔭) 𝔪
  omega

/-- If `𝔭` occurs in `𝔪` then the level of the congruence condition is strictly smaller than `1`,
so that the condition forces `y` to be a local unit. -/
lemma exp_neg_count_lt_one (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K))
    (h : 1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K)) :
    (WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ)) :
      WithZero (Multiplicative ℤ)) < 1 := by
  rw [← WithZero.exp_zero]
  refine WithZero.exp_lt_exp.mpr ?_
  omega

/-- **`DvdPrime 𝔪 𝔭` is the same as `1 ≤ count K 𝔭 𝔪`**, for `𝔪 ≠ ⊥`. -/
lemma dvdPrime_iff_one_le_count {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥)
    (𝔭 : HeightOneSpectrum (𝓞 K)) :
    DvdPrime 𝔪 𝔭 ↔ 1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) := by
  constructor
  · intro h
    exact dvdPrime_count_pos h𝔪 h
  · intro h
    have h0 : 𝔪 ≠ 0 := by simpa [Ideal.zero_eq_bot] using h𝔪
    rw [dvdPrime_iff_dvd']
    rw [FractionalIdeal.count_coe K 𝔭 h0] at h
    refine (Associates.count_ne_zero_iff_dvd h0 𝔭.irreducible).mp ?_
    intro hc
    rw [hc] at h
    simp at h

/-- The congruence condition at `1`. -/
lemma congrAtId_one (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K)) :
    CongrAtId 𝔭 𝔪 (1 : (𝔭.adicCompletion K)ˣ) := by
  unfold CongrAtId
  rw [Units.val_one, sub_self, map_zero]
  exact zero_le

/-- The congruence condition is multiplicative. -/
lemma congrAtId_mul (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K))
    (hmem : 1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K))
    {y z : (𝔭.adicCompletion K)ˣ} (hy : CongrAtId 𝔭 𝔪 y) (hz : CongrAtId 𝔭 𝔪 z) :
    CongrAtId 𝔭 𝔪 (y * z) := by
  unfold CongrAtId at *
  set c : WithZero (Multiplicative ℤ) :=
    WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ)) with hc
  have hc1 : c ≤ 1 := exp_neg_count_le_one 𝔭 𝔪
  have hc2 : c * c ≤ c := by
    calc c * c ≤ c * 1 := mul_le_mul_of_nonneg_left hc1 zero_le
      _ = c := mul_one _
  have hcross : Valued.v ((y : 𝔭.adicCompletion K) - 1)
      * Valued.v ((z : 𝔭.adicCompletion K) - 1) ≤ c :=
    le_trans (mul_le_mul' hy hz) hc2
  have hC : Valued.v (((y : 𝔭.adicCompletion K) - 1) * ((z : 𝔭.adicCompletion K) - 1)) ≤ c := by
    rw [Valuation.map_mul]; exact hcross
  have hdec : (((y * z : (𝔭.adicCompletion K)ˣ) : 𝔭.adicCompletion K) - 1)
      = ((y : 𝔭.adicCompletion K) - 1) + ((z : 𝔭.adicCompletion K) - 1)
        + ((y : 𝔭.adicCompletion K) - 1) * ((z : 𝔭.adicCompletion K) - 1) := by
    rw [Units.val_mul]; ring
  rw [hdec]
  calc Valued.v (((y : 𝔭.adicCompletion K) - 1) + ((z : 𝔭.adicCompletion K) - 1)
        + ((y : 𝔭.adicCompletion K) - 1) * ((z : 𝔭.adicCompletion K) - 1))
      ≤ max (Valued.v (((y : 𝔭.adicCompletion K) - 1) + ((z : 𝔭.adicCompletion K) - 1)))
          (Valued.v (((y : 𝔭.adicCompletion K) - 1) * ((z : 𝔭.adicCompletion K) - 1))) :=
        Valuation.map_add_le_max' _ _ _
    _ ≤ max (max (Valued.v ((y : 𝔭.adicCompletion K) - 1))
          (Valued.v ((z : 𝔭.adicCompletion K) - 1))) c :=
        max_le_max (Valuation.map_add_le_max' _ _ _) hC
    _ ≤ c := max_le (max_le hy hz) le_rfl

/-- The congruence condition is stable under inversion (the condition forces a local unit). -/
lemma congrAtId_inv (𝔭 : HeightOneSpectrum (𝓞 K)) (𝔪 : Ideal (𝓞 K))
    (hmem : 1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K))
    {y : (𝔭.adicCompletion K)ˣ} (hy : CongrAtId 𝔭 𝔪 y) : CongrAtId 𝔭 𝔪 y⁻¹ := by
  unfold CongrAtId at *
  have hlt : Valued.v ((y : 𝔭.adicCompletion K) - 1) < 1 :=
    lt_of_le_of_lt hy (exp_neg_count_lt_one 𝔭 𝔪 hmem)
  have hyv : Valued.v ((y : 𝔭.adicCompletion K)) = 1 := by
    have h := Valuation.map_add_eq_of_lt_left (v := Valued.v)
      (x := (1 : 𝔭.adicCompletion K)) (y := (y : 𝔭.adicCompletion K) - 1) (by simpa using hlt)
    simpa using h
  have hval : Valued.v (((y⁻¹ : (𝔭.adicCompletion K)ˣ) : 𝔭.adicCompletion K) - 1)
      = Valued.v ((y : 𝔭.adicCompletion K) - 1) := by
    have hdecode : (((y⁻¹ : (𝔭.adicCompletion K)ˣ) : 𝔭.adicCompletion K) - 1)
        = ((y : 𝔭.adicCompletion K) - 1) * (-((y : 𝔭.adicCompletion K)⁻¹)) := by
      rw [Units.val_inv_eq_inv_val]
      field_simp
      ring
    rw [hdecode, Valuation.map_mul, Valuation.map_neg, Valuation.map_inv, hyv, inv_one, mul_one]
  rw [hval]; exact hy

/-! ## The congruence subgroup -/

/-- **The congruence subgroup `U(𝔪) ≤ 𝕀 K` of the ideal modulus `𝔪`**: the idèles which are
congruent to `1` modulo `𝔪` at every prime `𝔭 | 𝔪` and positive at every real place.

The prime condition is phrased with `1 ≤ count K 𝔭 𝔪` (rather than `DvdPrime 𝔪 𝔭`) so that the
definition makes sense for `𝔪 = ⊥` as well; for `𝔪 ≠ ⊥` the two are equivalent
(`dvdPrime_iff_one_le_count`).  This is the ideal-modulus analogue of
`NK.CFTLib.Arl.congruenceSubgroup`. -/
def congruenceSubgroupId (K : Type*) [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K)) :
    Subgroup (Idele K) where
  carrier := {x | (∀ 𝔭 : HeightOneSpectrum (𝓞 K),
      1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) →
        CongrAtId 𝔭 𝔪 (x (Place.ofFinite 𝔭)))
    ∧ (∀ w : InfinitePlace K, NK.CFTLib.Arl.PosAtReal w (x (Place.ofInfinite w)))}
  one_mem' := by
    refine ⟨fun 𝔭 _ => congrAtId_one 𝔭 𝔪, fun w => ?_⟩
    rw [Idele.one_apply]
    exact NK.CFTLib.Arl.posAtReal_one w
  mul_mem' := by
    intro x y hx hy
    refine ⟨fun 𝔭 h𝔭 => ?_, fun w => ?_⟩
    · rw [Idele.mul_apply]
      exact congrAtId_mul 𝔭 𝔪 h𝔭 (hx.1 𝔭 h𝔭) (hy.1 𝔭 h𝔭)
    · rw [Idele.mul_apply]
      exact NK.CFTLib.Arl.posAtReal_mul (hx.2 w) (hy.2 w)
  inv_mem' := by
    intro x hx
    refine ⟨fun 𝔭 h𝔭 => ?_, fun w => ?_⟩
    · rw [Idele.inv_apply]
      exact congrAtId_inv 𝔭 𝔪 h𝔭 (hx.1 𝔭 h𝔭)
    · rw [Idele.inv_apply]
      exact NK.CFTLib.Arl.posAtReal_inv (hx.2 w)

/-- Membership in the congruence subgroup, unfolded. -/
lemma mem_congruenceSubgroupId {𝔪 : Ideal (𝓞 K)} {x : Idele K} :
    x ∈ congruenceSubgroupId K 𝔪 ↔
      (∀ 𝔭 : HeightOneSpectrum (𝓞 K),
        1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) →
          CongrAtId 𝔭 𝔪 (x (Place.ofFinite 𝔭)))
      ∧ (∀ w : InfinitePlace K, NK.CFTLib.Arl.PosAtReal w (x (Place.ofInfinite w))) :=
  Iff.rfl

/-- Membership in the congruence subgroup, in terms of `DvdPrime`. -/
lemma mem_congruenceSubgroupId_iff {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) {x : Idele K} :
    x ∈ congruenceSubgroupId K 𝔪 ↔
      (∀ 𝔭 : HeightOneSpectrum (𝓞 K), DvdPrime 𝔪 𝔭 →
          CongrAtId 𝔭 𝔪 (x (Place.ofFinite 𝔭)))
      ∧ (∀ w : InfinitePlace K, NK.CFTLib.Arl.PosAtReal w (x (Place.ofInfinite w))) := by
  rw [mem_congruenceSubgroupId]
  constructor
  · rintro ⟨h1, h2⟩
    exact ⟨fun 𝔭 h𝔭 => h1 𝔭 ((dvdPrime_iff_one_le_count h𝔪 𝔭).mp h𝔭), h2⟩
  · rintro ⟨h1, h2⟩
    exact ⟨fun 𝔭 h𝔭 => h1 𝔭 ((dvdPrime_iff_one_le_count h𝔪 𝔭).mpr h𝔭), h2⟩

/-- An idèle of the congruence subgroup is a local unit at every prime `𝔭 | 𝔪`, so the ideal it
generates has vanishing `𝔭`-adic exponent. -/
lemma count_idealOf_eq_zero_of_congruenceId {𝔪 : Ideal (𝓞 K)} {x : Idele K}
    (hx : x ∈ congruenceSubgroupId K 𝔪) (𝔭 : HeightOneSpectrum (𝓞 K))
    (h𝔭 : 1 ≤ FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K)) :
    FractionalIdeal.count K 𝔭 (Idele.idealOf x) = 0 := by
  classical
  rw [Idele.count_idealOf, Idele.exp_def]
  have hlt : Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
      (((x (Place.ofFinite 𝔭)) : 𝔭.adicCompletion K) - 1) < 1 :=
    lt_of_le_of_lt (hx.1 𝔭 h𝔭) (exp_neg_count_lt_one 𝔭 𝔪 h𝔭)
  have hval : Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
      ((x (Place.ofFinite 𝔭)) : 𝔭.adicCompletion K) = 1 := by
    have h := Valuation.map_add_eq_of_lt_left
      (v := Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ)))
      (x := (1 : 𝔭.adicCompletion K))
      (y := ((x (Place.ofFinite 𝔭)) : 𝔭.adicCompletion K) - 1) (by simpa using hlt)
    rw [map_one, show (1 : 𝔭.adicCompletion K) +
      (((x (Place.ofFinite 𝔭)) : 𝔭.adicCompletion K) - 1) =
        ((x (Place.ofFinite 𝔭)) : 𝔭.adicCompletion K) from by ring] at h
    exact h
  rw [hval]
  simp

/-! ## The bridge between the ideal-theoretic and the idèlic congruence conditions -/

/-- **The `𝔭`-adic valuation of a nonzero element, in the `count` normalisation**: the valuation of
`a ∈ K` in the completion at `𝔭` is `exp (-count)` for the principal fractional ideal `(a)`. -/
lemma valued_algebraMap_eq_exp_neg_count_spanSingleton (𝔭 : HeightOneSpectrum (𝓞 K)) {a : K}
    (ha : a ≠ 0) :
    Valued.v (R := 𝔭.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
        (algebraMap K (𝔭.adicCompletion K) a)
      = WithZero.exp (-(FractionalIdeal.count K 𝔭
          (FractionalIdeal.spanSingleton (𝓞 K)⁰ a) : ℤ)) := by
  rw [Commons.NumberTheory.NumberField.Completion.valued_alg_eq,
    NK.GlobalCFT.IdeleClassGroup.count_spanSingleton_eq 𝔭 ha, neg_neg,
    WithZero.exp_log ((Valuation.ne_zero_iff _).mpr ha)]

/-- **The idèlic and the ideal-theoretic congruence conditions agree for principal idèles.** -/
lemma principalIdele_mem_congruenceSubgroupId_iff {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) (a : Kˣ) :
    Idele.principalIdele K a ∈ congruenceSubgroupId K 𝔪 ↔ CongrOneId 𝔪 a := by
  rw [mem_congruenceSubgroupId_iff h𝔪]
  constructor
  · rintro ⟨h1, h2⟩
    refine ⟨fun 𝔭 h𝔭 => ?_, h2⟩
    have h := h1 𝔭 h𝔭
    unfold CongrAtId at h
    rwa [Idele.principalIdele_apply, Units.coe_map] at h
  · rintro ⟨h1, h2⟩
    refine ⟨fun 𝔭 h𝔭 => ?_, h2⟩
    show CongrAtId 𝔭 𝔪 ((Idele.principalIdele K a) (Place.ofFinite 𝔭))
    unfold CongrAtId
    rw [Idele.principalIdele_apply, Units.coe_map]
    exact h1 𝔭 h𝔭

/-- **The principal idèle of `a` lies in the congruence subgroup whenever `a ≡ 1 mod* 𝔪`.** -/
lemma principalIdele_mem_congruenceSubgroupId_of_congrOneId {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥)
    {a : Kˣ} (ha : CongrOneId 𝔪 a) :
    Idele.principalIdele K a ∈ congruenceSubgroupId K 𝔪 :=
  (principalIdele_mem_congruenceSubgroupId_iff h𝔪 a).mpr ha

/-! ## The classical principal ray -/

/-- **The principal fractional ideal, as a homomorphism** from `Kˣ` to the group of fractional
ideals of `𝓞 K`. -/
def spanUnitHom (K : Type*) [Field K] [NumberField K] : Kˣ →* Frac K where
  toFun x := Units.mk0 (FractionalIdeal.spanSingleton (𝓞 K)⁰ (x : K))
    (FractionalIdeal.spanSingleton_ne_zero_iff.mpr (Units.ne_zero x))
  map_one' := by
    simp only [Units.val_one, FractionalIdeal.spanSingleton_one]
    exact Units.mk0_one _
  map_mul' x y := by
    refine Units.ext ?_
    simp only [Units.val_mk0, Units.val_mul, FractionalIdeal.spanSingleton_mul_spanSingleton,
      Units.val_mul]

@[simp] lemma spanUnitHom_apply (a : Kˣ) : spanUnitHom K a = spanUnit a := rfl

/-- **The classical principal ray `P(𝔪)`**: the image in the group of fractional ideals of the
principal idèles lying in the congruence subgroup `U(𝔪)`.  For `𝔪 ≠ ⊥` it agrees with
`principalRayId`, see `principalRayClId_eq_principalRayId`. -/
def principalRayClId (K : Type*) [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K)) :
    Subgroup (Frac K) :=
  (Subgroup.comap (Idele.principalIdele K) (congruenceSubgroupId K 𝔪)).map (spanUnitHom K)

/-- **The ideal-theoretic ray `principalRayId 𝔪` is contained in the classical ray `P(𝔪)`.** -/
lemma principalRayId_le_principalRayClId {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) :
    principalRayId 𝔪 ≤ principalRayClId K 𝔪 := by
  rw [principalRayId, Subgroup.closure_le]
  rintro A ⟨a, ha, rfl⟩
  exact Subgroup.mem_map.mpr
    ⟨a, principalIdele_mem_congruenceSubgroupId_of_congrOneId h𝔪 ha, rfl⟩

/-- **The classical ray `P(𝔪)` is contained in the ideal-theoretic ray `principalRayId 𝔪`.** -/
lemma principalRayClId_le_principalRayId {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) :
    principalRayClId K 𝔪 ≤ principalRayId 𝔪 := by
  rintro A ⟨a, ha, rfl⟩
  exact Subgroup.subset_closure
    ⟨a, (principalIdele_mem_congruenceSubgroupId_iff h𝔪 a).mp ha, rfl⟩

/-- **For `𝔪 ≠ ⊥` the two principal rays agree.** -/
lemma principalRayClId_eq_principalRayId {𝔪 : Ideal (𝓞 K)} (h𝔪 : 𝔪 ≠ ⊥) :
    principalRayClId K 𝔪 = principalRayId 𝔪 :=
  le_antisymm (principalRayClId_le_principalRayId h𝔪) (principalRayId_le_principalRayClId h𝔪)

end NK.CFTLib.ArtinReciprocityIdeal
