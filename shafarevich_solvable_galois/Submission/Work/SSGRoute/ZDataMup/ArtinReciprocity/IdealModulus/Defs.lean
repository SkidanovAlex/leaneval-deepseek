/-!
# The Lang conductor theory for an *ideal* modulus

`Submission/NK/CFTLib/ArtinReciprocityIdeal/LangDefs.lean` develops Lang's conductor theorem for a
modulus which is a **natural number** `m`.  The conductor of `L/K` is however an *ideal*
`𝔪 = ∏_{𝔭 ∈ R} 𝔭^{e_𝔭}` supported on the ramified primes `R`, and the ℕ-modulus framework cannot
express it: `supp(m)` for `m : ℕ` is always a union of full fibres `{𝔮 : 𝔮 | p}` over the rational
primes, so if `p` carries a ramified prime then *every* prime above `p` — including unramified ones
— divides `(m)`, and the congruence condition at such an unramified `𝔮₀` can never be dropped.

This file sets up the analogous vocabulary for an ideal modulus `𝔪 : Ideal (𝓞 K)`, with the
dictionary to `LangDefs.lean` for the principal modulus `𝔪 = Ideal.span {(m : 𝓞 K)}`.  The
reformulation is mechanical because `m` occurs in `LangDefs.lean` only through
`(m : 𝓞 K) ∈ 𝔭.asIdeal` (which is `𝔪 ≤ 𝔭.asIdeal`) and
`Valued.v (((m : ℕ) : 𝔭.adicCompletion K))` (which is `WithZero.exp (-(count K 𝔭 𝔪))`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

/-! ## The modulus predicates for an ideal modulus -/

/-- **The modulus `𝔪` divides the prime `𝔭`** (`𝔭 | 𝔪`), i.e. `𝔪 ⊆ 𝔭`; the replacement of
`(m : 𝓞 K) ∈ 𝔭.asIdeal` for a general ideal modulus. -/
def DvdPrime {K : Type*} [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K))
    (𝔭 : HeightOneSpectrum (𝓞 K)) : Prop := 𝔪 ≤ 𝔭.asIdeal

theorem dvdPrime_span_iff {K : Type*} [Field K] [NumberField K] {m : ℕ}
    (𝔭 : HeightOneSpectrum (𝓞 K)) :
    DvdPrime (Ideal.span {(m : 𝓞 K)}) 𝔭 ↔ (m : 𝓞 K) ∈ 𝔭.asIdeal :=
  Ideal.span_singleton_le_iff_mem (𝔭.asIdeal)

/-- **A fractional ideal is coprime to the ideal modulus `𝔪`**: it has no prime factor `𝔭 | 𝔪`. -/
def FracCoprimeId {K : Type*} [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K)) (A : Frac K) : Prop :=
  ∀ 𝔭 : HeightOneSpectrum (𝓞 K), DvdPrime 𝔪 𝔭 →
    FractionalIdeal.count K 𝔭 (A : FractionalIdeal (𝓞 K)⁰ K) = 0

theorem fracCoprimeId_span_iff {K : Type*} [Field K] [NumberField K] {m : ℕ} (A : Frac K) :
    FracCoprimeId (Ideal.span {(m : 𝓞 K)}) A ↔ FracCoprime m A := by
  constructor
  · intro h 𝔭 h𝔭
    exact h 𝔭 ((dvdPrime_span_iff 𝔭).2 h𝔭)
  · intro h 𝔭 h𝔭
    exact h 𝔭 ((dvdPrime_span_iff 𝔭).1 h𝔭)

lemma FracCoprimeId.mul {K : Type*} [Field K] [NumberField K] {𝔪 : Ideal (𝓞 K)} {A B : Frac K}
    (hA : FracCoprimeId 𝔪 A) (hB : FracCoprimeId 𝔪 B) : FracCoprimeId 𝔪 (A * B) := by
  intro 𝔭 h𝔭
  rw [Units.val_mul, FractionalIdeal.count_mul K 𝔭 (Units.ne_zero A) (Units.ne_zero B),
    hA 𝔭 h𝔭, hB 𝔭 h𝔭, add_zero]

lemma FracCoprimeId.zpow {K : Type*} [Field K] [NumberField K] {𝔪 : Ideal (𝓞 K)} {A : Frac K}
    (n : ℤ) (hA : FracCoprimeId 𝔪 A) : FracCoprimeId 𝔪 (A ^ n) := by
  intro 𝔭 h𝔭
  rw [Units.val_zpow_eq_zpow_val, FractionalIdeal.count_zpow, hA 𝔭 h𝔭, mul_zero]

/-- **The congruence condition `a ≡ 1 mod* 𝔪`** (Lang's `mod*`) for an ideal modulus: the
`𝔭`-adic value of `a - 1` is at most the `𝔪`-level `exp (-(count K 𝔭 𝔪))` at every `𝔭 | 𝔪`, and `a`
is positive at every real place.

**No integrality away from `𝔪` is imposed** (this is the point: for `b : Kˣ` satisfying the
congruence only at the ramified primes, `b - 1` need not be an algebraic integer at the other
primes, so the naive "`spanSingleton (b-1) ≤ 𝔪`" would be too strong).  This is the exact analogue
of `CongrOne` in `LangDefs.lean`, whose condition is likewise an adic valuation bound at the primes
dividing the modulus together with positivity. -/
def CongrOneId {K : Type*} [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K)) (a : Kˣ) : Prop :=
  (∀ 𝔭 : HeightOneSpectrum (𝓞 K), DvdPrime 𝔪 𝔭 →
      Valued.v (algebraMap K (𝔭.adicCompletion K) (a : K) - 1)
        ≤ WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ)))
    ∧ (∀ (w : InfinitePlace K) (hw : w.IsReal),
        0 < (InfinitePlace.Completion.ringEquivRealOfIsReal hw)
              (algebraMap K w.Completion (a : K)))

/-- **The principal ray `P(𝔪)`** of the ideal modulus `𝔪`: generated by the principal ideals `(a)`
with `a ≡ 1 mod* 𝔪`. -/
def principalRayId {K : Type*} [Field K] [NumberField K] (𝔪 : Ideal (𝓞 K)) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ a : Kˣ, CongrOneId 𝔪 a ∧ A = spanUnit a}

/-- **The group `I(𝔪)`** of fractional ideals coprime to `𝔪`. -/
def idealCoprimeGroupId {K : Type*} [Field K] [NumberField K]
    (𝔪 : Ideal (𝓞 K)) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ 𝔭 : HeightOneSpectrum (𝓞 K),
    ¬ DvdPrime 𝔪 𝔭 ∧ A = idealUnit 𝔭.asIdeal 𝔭.ne_bot}

/-- **The norm group `𝔑(𝔪)`** of the ideal modulus `𝔪`: generated by the relative norms of the
ideals of `L` coprime to the extension of `𝔪` to `𝓞 L`. -/
def normRayId {K : Type*} [Field K] [NumberField K] {L : Type*} [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (𝔪 : Ideal (𝓞 K)) : Subgroup (Frac K) :=
  Subgroup.closure {A | ∃ (I : Ideal (𝓞 L)) (hI : I ≠ ⊥),
    FracCoprimeId (K := L) (Ideal.map (algebraMap (𝓞 K) (𝓞 L)) 𝔪) (idealUnit I hI) ∧
    A = idealUnit (Ideal.relNorm (𝓞 K) I) (fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h))}

/-- **`𝔪` is an admissible modulus for `L/K`** (Lang, Ch. VII §4) for an ideal modulus: the
congruence units of level `𝔪` at every `𝔭 | 𝔪` are local norms above `𝔭`.  The level of `𝔪` at
`𝔭` is `count K 𝔭 𝔪`. -/
def IsAdmissibleId {K : Type*} [Field K] [NumberField K] {L : Type*} [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] (𝔪 : Ideal (𝓞 K)) : Prop :=
  ∀ (𝔭 : HeightOneSpectrum (𝓞 K)), DvdPrime 𝔪 𝔭 →
    ∀ (𝔮 : HeightOneSpectrum (𝓞 L)) (h𝔮 : 𝔮.asIdeal.LiesOver 𝔭.asIdeal)
      (x : (𝔭.adicCompletion K)ˣ),
      Valued.v ((x : 𝔭.adicCompletion K) - 1)
        ≤ WithZero.exp (-(FractionalIdeal.count K 𝔭 (𝔪 : FractionalIdeal (𝓞 K)⁰ K) : ℤ)) →
      x ∈ (NK.GlobalCFT.Place.localNormFinite 𝔮 𝔭 h𝔮).range

/-- **`𝔪` contains all the ramified primes**: the replacement of Lang's `hram` for an ideal modulus.
The case of interest is `𝔪 = ∏_{𝔭 ∈ R} 𝔭^{v_𝔭(M)}`, whose support is *exactly* the ramified
primes and which is, therefore, expressible only as an ideal modulus. -/
def ContainsRamified {K : Type*} [Field K] [NumberField K] {L : Type*} [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (𝔪 : Ideal (𝓞 K)) : Prop :=
  ∀ 𝔭 : HeightOneSpectrum (𝓞 K),
    Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) ≠ 1 → DvdPrime 𝔪 𝔭

end NK.CFTLib.ArtinReciprocityIdeal
