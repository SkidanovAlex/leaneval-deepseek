/-!
# The index of `P(𝔪)·𝔑(𝔪)` in `I(𝔪)` is at most the idèlic norm index

Let `K ⊆ L` be a finite extension of number fields and let `𝔪 ≠ ⊥` be an ideal modulus of `K`.
Write

* `I(𝔪) = idealCoprimeGroupId 𝔪` for the group of fractional ideals of `K` coprime to `𝔪`,
* `P(𝔪) = principalRayId 𝔪` for the principal ray (the ideals `(a)` with `a ≡ 1 mod* 𝔪`),
* `𝔑(𝔪) = normRayId 𝔪` for the norm group (generated by the relative norms of the ideals of `L`
  coprime to `𝔪·𝓞 L`).

This module proves

`[I(𝔪) : P(𝔪)·𝔑(𝔪)] ≤ [C_K : N_{L/K} C_L]`

which is the ideal-modulus form of the universal norm index inequality
`NK.CFTLib.ArtinReciprocityIdeal.indexIdealCoprimeLeNormClassIndex` for natural-number moduli.

The proof is the same one: the map
`θ : 𝕀 K →* (fractional ideals of K) ⧸ P(𝔪)·𝔑(𝔪)`
of `AdjustId.lean` has image the projection of `I(𝔪)` (`thetaId_range`) and kills the principal
idèles and the idèlic norms (`principalSubgroup_sup_normImage_le_ker_thetaId`); hence

`[I(𝔪) : P(𝔪)·𝔑(𝔪)] = [𝕀 K : ker θ] ≤ [𝕀 K : Kˣ·N_{L/K} 𝕀 L] = [C_K : N_{L/K} C_L]`.

The last index is `NK.GlobalCFT.Idele.normClassSubgroup K L`.index`
(`index_principalSubgroup_sup_normImage` below).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus

/-- **The index of `Kˣ · N_{L/K} 𝕀 L` in `𝕀 K` is the index of the idèlic norm class
subgroup.**  Both are the cardinality of the ray class group `C_K ⧸ N_{L/K} C_L`. -/
lemma index_principalSubgroup_sup_normImage (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] :
    (NK.GlobalCFT.Idele.principalSubgroup K ⊔ NK.GlobalCFT.Idele.normImage K L).index =
      (NK.GlobalCFT.Idele.normClassSubgroup K L).index := by
  rw [Subgroup.index_eq_card]
  exact (NK.GlobalCFTdeep.SecondInequality.index_normClassSubgroup_eq_card_rayClassGroup
    (K := K) (L := L)).symm

theorem indexLeId (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (𝔪 : Ideal (NumberField.RingOfIntegers K)) (h𝔪 : 𝔪 ≠ ⊥) :
    Nat.card (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪 ⧸
        (NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
          NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪).subgroupOf
          (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪))
      ≤ (NK.GlobalCFT.Idele.normClassSubgroup K L).index := by
  classical
  -- `principalRayId 𝔪` and the classical principal ray `principalRayClId K 𝔪` agree, so the
  -- subgroup `P(𝔪) ⊔ 𝔑(𝔪)` is `rayNormClId K L 𝔪` — the subgroup by which `θ` is defined.
  have hR : NK.CFTLib.ArtinReciprocityIdeal.rayNormClId K L 𝔪 =
      NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 ⊔
        NK.CFTLib.ArtinReciprocityIdeal.normRayId (K := K) (L := L) 𝔪 := by
    rw [NK.CFTLib.ArtinReciprocityIdeal.rayNormClId,
      NK.CFTLib.ArtinReciprocityIdeal.principalRayClId_eq_principalRayId h𝔪]
  rw [← hR]
  -- `θ` kills the principal idèles and the idèlic norms.
  have hker : (NK.GlobalCFT.Idele.principalSubgroup K ⊔ NK.GlobalCFT.Idele.normImage K L) ≤
      (NK.CFTLib.ArtinReciprocityIdeal.thetaId K L 𝔪 h𝔪).ker :=
    NK.CFTLib.ArtinReciprocityIdeal.principalSubgroup_sup_normImage_le_ker_thetaId
      (K := K) (L := L) h𝔪
  -- the index of `Kˣ · N_{L/K} 𝕀 L` is nonzero, hence finite
  haveI hVfin : (NK.GlobalCFT.Idele.principalSubgroup K ⊔
      NK.GlobalCFT.Idele.normImage K L).FiniteIndex :=
    Subgroup.finiteIndex_iff.mpr (by
      rw [index_principalSubgroup_sup_normImage K L]
      exact NK.GlobalCFTdeep.normClassSubgroup_index_ne_zero (K := K) (L := L))
  -- `[I(𝔪) : P(𝔪)·𝔑(𝔪)] = [𝕀 K : ker θ] ≤ [𝕀 K : Kˣ·N 𝕀 L] = [C_K : N C_L]`.
  calc Nat.card (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪 ⧸
          (NK.CFTLib.ArtinReciprocityIdeal.rayNormClId K L 𝔪).subgroupOf
            (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪))
      = ((NK.CFTLib.ArtinReciprocityIdeal.rayNormClId K L 𝔪).subgroupOf
            (NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroupId 𝔪)).index :=
        (Subgroup.index_eq_card _).symm
    _ = (NK.CFTLib.ArtinReciprocityIdeal.thetaId K L 𝔪 h𝔪).ker.index :=
        NK.CFTLib.ArtinReciprocityIdeal.index_rayNormId_eq_ker_index (K := K) (L := L) h𝔪
    _ ≤ (NK.GlobalCFT.Idele.principalSubgroup K ⊔ NK.GlobalCFT.Idele.normImage K L).index :=
        Subgroup.index_antitone hker
    _ = (NK.GlobalCFT.Idele.normClassSubgroup K L).index :=
        index_principalSubgroup_sup_normImage K L

end Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus
