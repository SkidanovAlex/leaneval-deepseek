namespace Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus

/-- **The principal ideals of the idèles of the congruence subgroup lie in the principal ray.**
Since `principalRayId 𝔪` is generated by the principal ideals `(b)` of the elements `b` with
`b ≡ 1 mod* 𝔪` (i.e. `CongrOneId 𝔪 b`: congruence to `1` at the primes dividing `𝔪` together with
total positivity), and the principal idèle of `a` lying in `U(𝔪)` is exactly the statement
`CongrOneId 𝔪 a`, the ideal `(a)` is one of the generators. -/
theorem spanUnit_mem_principalRayId_of_mem_congruenceSubgroupId
    {K : Type} [Field K] [NumberField K]
    (𝔪 : Ideal (NumberField.RingOfIntegers K)) (h𝔪 : 𝔪 ≠ ⊥) (a : Kˣ)
    (ha : NK.GlobalCFT.Idele.principalIdele K a ∈
      NK.CFTLib.ArtinReciprocityIdeal.congruenceSubgroupId K 𝔪) :
    NK.CFTLib.ArtinReciprocityIdeal.spanUnit a ∈
      NK.CFTLib.ArtinReciprocityIdeal.principalRayId 𝔪 := by
  refine Subgroup.subset_closure ⟨a, ?_, rfl⟩
  exact (NK.CFTLib.ArtinReciprocityIdeal.principalIdele_mem_congruenceSubgroupId_iff h𝔪 a).mp ha

end Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus
