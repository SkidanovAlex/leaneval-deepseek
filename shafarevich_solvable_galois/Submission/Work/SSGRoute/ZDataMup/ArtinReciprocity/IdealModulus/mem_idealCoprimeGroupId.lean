/-
# The ideal-modulus analogue of `mem_idealCoprimeGroup_iff`  (adapter 3 of the assembly)

`I(𝔪) = idealCoprimeGroupId 𝔪` is by definition the subgroup of the group of fractional ideals
generated by the prime ideals `𝔭` with `¬ DvdPrime 𝔪 𝔭`.  This file proves the direction of the
dictionary that the assembly of `artinSymbolKillsPrincipal_ideal` needs: every element of `I(𝔪)`
is coprime to `𝔪`.

The converse (that a fractional ideal coprime to `𝔪` lies in `I(𝔪)`, i.e. that `𝔪 | A` forces the
prime factors of `A` to avoid `𝔪`) is the harder direction of the natural-number version
`NK.CFTLib.ArtinReciprocityIdeal.mem_idealCoprimeGroup_iff`; it is *not* needed by the assembly and
is not proved here.
-/
import Mathlib
import Submission.Work.SSGRoute.ZDataMup.ArtinReciprocity.IdealModulus.Defs
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open NumberField IsDedekindDomain
open scoped NumberField nonZeroDivisors

noncomputable section

namespace NK.CFTLib.ArtinReciprocityIdeal

variable {K : Type*} [Field K] [NumberField K]

/-- **Every element of `I(𝔪)` is coprime to `𝔪`.**  This is the direction of
`mem_idealCoprimeGroup_iff` needed to run the index argument of the assembly at an ideal modulus. -/
lemma fracCoprimeId_of_mem_idealCoprimeGroupId {𝔪 : Ideal (𝓞 K)} {A : Frac K}
    (hA : A ∈ idealCoprimeGroupId 𝔪) : FracCoprimeId 𝔪 A := by
  classical
  let H : Subgroup (Frac K) :=
    { carrier := {A : Frac K | FracCoprimeId 𝔪 A}
      one_mem' := by
        intro 𝔭 _
        show FractionalIdeal.count K 𝔭 ((1 : Frac K) : FractionalIdeal (𝓞 K)⁰ K) = 0
        rw [Units.val_one, FractionalIdeal.count_one]
      mul_mem' := fun hA hB => hA.mul hB
      inv_mem' := fun {x} hA => by
        show FracCoprimeId 𝔪 x⁻¹
        simpa only [zpow_neg_one] using hA.zpow (-1) }
  have hle : idealCoprimeGroupId 𝔪 ≤ H :=
    (Subgroup.closure_le H).mpr (by
      rintro B ⟨𝔭, h𝔭, rfl⟩
      intro 𝔮 h𝔮
      have hne : 𝔭 ≠ 𝔮 := fun h => h𝔭 (h.symm ▸ h𝔮)
      show FractionalIdeal.count K 𝔮
        (↑(idealUnit 𝔭.asIdeal 𝔭.ne_bot) : FractionalIdeal (𝓞 K)⁰ K) = 0
      rw [show (↑(idealUnit 𝔭.asIdeal 𝔭.ne_bot) : FractionalIdeal (𝓞 K)⁰ K)
          = (𝔭.asIdeal : FractionalIdeal (𝓞 K)⁰ K) from rfl,
        FractionalIdeal.count_maximal]
      simp [hne])
  exact hle hA

end NK.CFTLib.ArtinReciprocityIdeal
