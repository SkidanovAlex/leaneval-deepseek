/-!
# The escape of the local norm subgroup at the Kummer level `K(β^{1/p})`

The lemma `exists_localImageAt_notMem_localNormSubgroup_hLevel` of the `LTRecFamHonest` lane:
for a finite place `A` of `Ω` over `k`, a prime `p ≠ 2` with `ζ_p ∈ ↥K`, and `β ∈ ↥Kˣ` whose
local `p`-th power class at the prime `𝔭` of `↥K` below `A` is **non-trivial**, there is a global
unit `γ ∈ ↥Kˣ` whose local image at `𝔭` is *not* a local norm from the Kummer level
`↥K(β^{1/p})`.

## The mathematics

Write `κ = ↥K_𝔭` for the completion and `N ≤ κˣ` for the subgroup of `κˣ` generated by the local
norms `N_{L_w/κ}` over the places `w` of `L = ↥K(β^{1/p})` above `𝔭`
(`NK.CFTLib.IdeleHasse.localNormSubgroup`).  The argument has three steps.

1. **`𝔭` does not split completely in `L`.**  The local Kummer dictionary in the form
   `kummerCharMonoidHom_eq_one_iff` says that the local Kummer character of `β` is trivial at `A`
   exactly when `β` is a local `p`-th power at `𝔭`; `hβ` therefore makes the Kummer character of
   `β` non-trivial on the decomposition group of `A`.  Since the Kummer character of `β` vanishes
   on the fixing subgroup of its Kummer level (`kummerCharZMod_eq_zero_of_mem_fixingSubgroup`),
   the decomposition group of `A` is *not* contained in `Gal(Ω/L)`:
   `¬ SSGRoute.IsSplitIn ↥K L A`.
2. **`N ≠ ⊤`.**  If the local norm subgroup were everything, the place would split completely
   (`Work.SSGRoute.ZDataMup.OddForm.oddSplitIn_of_localNormSubgroup_eq_top`, which rests on the
   local norm index theorem in the prime degree case).
3. **A global witness.**  Pick `x ∈ κˣ \ N`, which exists because `N ≠ ⊤`.  Weak approximation at
   the completion (`exists_globalUnit_mul_pow_eq_of_local`, proved in the workspace from density of
   `↥K` in `κ`) produces `γ ∈ ↥Kˣ` with `localImageAt γ = x · c^{-p}` for some `c ∈ κˣ`.  Since
   `c^p` is a local norm (`mem_localNormSubgroup_of_mem_powRange`, the norm of `c`), `γ` is the
   required witness: `localImageAt γ ∉ N` because `x = localImageAt γ · c^p`.

Only the last step is specific to the Kummer level; it is isolated below as
`exists_localImageAt_notMem_localNormSubgroup_of_ne_top`.
-/

namespace Work.SSGRoute.ZDataMup.LTRecFamHonest

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

noncomputable section

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] [IsAlgClosed Ω]
  {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]

/-- **Escape from a proper local norm subgroup.**

Let `L / ↥K` be a finite Galois extension of number fields of degree `p`, `𝔭` the prime of `↥K`
below a finite place `A` of `Ω`, and suppose the local norm subgroup of `L` at `𝔭` is a *proper*
subgroup of the local unit group `κˣ` (`κ = ↥K_𝔭`).  Then some global unit `γ ∈ ↥Kˣ` has local
image at `𝔭` outside the local norm subgroup.

The proof is weak approximation at the completion: take `x` outside the norm subgroup; every local
class has a global representative up to `p`-th powers (`exists_globalUnit_mul_pow_eq_of_local`), and
`p`-th powers are local norms (`mem_localNormSubgroup_of_mem_powRange`, which uses the degree
`p` hypothesis). -/
theorem exists_localImageAt_notMem_localNormSubgroup_of_ne_top (A : ValuationSubring Ω)
    (hA : SSGRoute.IsFinPlace k A) (hAK : A.comap (algebraMap ↥K Ω) ≠ ⊤)
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L] [NumberField ↥L]
    (hcard : Nat.card (↥L ≃ₐ[↥K] ↥L) = p)
    (hne : NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥L)
      (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) ≠ ⊤) :
    ∃ γ : (↥K)ˣ,
      NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
        (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) γ ∉
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥L)
        (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) := by
  obtain ⟨x, hx⟩ : ∃ x : (NK.GlobalCFT.Place.localField ↥K
      (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)))ˣ,
      x ∉ NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥L)
        (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) := by
    by_contra hcon
    exact hne (Subgroup.ext fun y =>
      ⟨fun _ => Subgroup.mem_top y, fun _ => by
        by_contra hy
        exact hcon ⟨y, hy⟩⟩)
  obtain ⟨γ, c, hγc⟩ := Work.SSGRoute.ZConstruction.exists_globalUnit_mul_pow_eq_of_local
    p k Ω K (Submission.NeukirchUchida.primeOf A hAK) x
  refine ⟨γ, ?_⟩
  intro hmem
  apply hx
  have hcpow : c ^ p ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥L)
      (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) :=
    mem_localNormSubgroup_of_mem_powRange (K := ↥K) (L := ↥L) hcard
      (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) (c ^ p)
      (MonoidHom.mem_range.mpr ⟨c, rfl⟩)
  rw [← hγc]
  exact Subgroup.mul_mem _ hmem hcpow

/-- **A global unit of non-trivial local `p`-th power class is not a global `p`-th power.**

If `β ∈ ↥Kˣ` is not a local `p`-th power at the prime `𝔭` below the finite place `A`, then `β` is not
a `p`-th power in `↥K`.  Indeed `kummerCharHom` kills `p`-th powers
(`Work.SSGRoute.ZConstruction.kummerCharHom_pow`) and its kernel is exactly the local `p`-th powers
(`kummerCharMonoidHom_eq_one_iff`). -/
theorem notMem_powSubgroup_of_localPowClass_ne_one (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hAK : A.comap (algebraMap ↥K Ω) ≠ ⊤) (β : (↥K)ˣ)
    (hβ : NK.UchidaKummer.localPowClass ↥K p (Submission.NeukirchUchida.primeOf A hAK) β ≠ 1) :
    β ∉ NK.LocalAnabelian.powSubgroup p ↥K := by
  haveI : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  intro hmem
  obtain ⟨c, hc⟩ := MonoidHom.mem_range.mp hmem
  have h1 : Work.SSGRoute.ZConstruction.kummerCharMonoidHom (p := p) (k := k) (Ω := Ω)
      (K := K) (ζ := ζ) (hζ := hζ) (A := A) hA β = 1 := by
    refine Subtype.ext ?_
    rw [← hc]
    exact Work.SSGRoute.ZConstruction.kummerCharHom_pow (p := p) (k := k) (Ω := Ω) (K := K)
      (ζ := ζ) (hζ := hζ) (A := A) c
  exact hβ ((Work.SSGRoute.ZConstruction.kummerCharMonoidHom_eq_one_iff (p := p) (k := k)
    (Ω := Ω) (K := K) (ζ := ζ) (hζ := hζ) (A := A) hA
    (Submission.NeukirchUchida.primeOf A hAK)
    (Submission.NeukirchUchida.primeOf_spec A hAK) β).mp h1)

/-- **The Galois group of a Kummer level of a non-`p`-th power has order `p`.** -/
theorem hLevel_natCard_eq (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (β : (↥K)ˣ)
    [FiniteDimensional ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    [IsGalois ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    (hβ : β ∉ NK.LocalAnabelian.powSubgroup p ↥K) :
    Nat.card (↥(NK.LocalAnabelian.kummerField (K' := Ω) p β) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)) = p := by
  haveI : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  rw [IsGalois.card_aut_eq_finrank,
    (NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank
      (K' := Ω) (k := ↥K) p Fact.out hζ β hβ).2]

/-- **The local norm subgroup of the Kummer level at a non-split place is proper.**

If `β ∈ ↥Kˣ` is not a local `p`-th power at the prime `𝔭` of `↥K` below the finite place `A`
(i.e. `β` has non-trivial local Kummer class at `𝔭`), then the place `A` does not split completely
in the Kummer level `↥K(β^{1/p})`, and hence the local norm subgroup at `𝔭` is a proper subgroup of
`κˣ`.

The two inputs are the local Kummer dictionary (`kummerCharMonoidHom_eq_one_iff`, which turns the
non-triviality of the local class of `β` into the non-triviality of its Kummer character on the
decomposition group of `A`) and the converse splitting criterion
`Work.SSGRoute.ZDataMup.OddForm.oddSplitIn_of_localNormSubgroup_eq_top` for a proper local norm
subgroup in prime degree. -/
theorem localNormSubgroup_hLevel_ne_top (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hAK : A.comap (algebraMap ↥K Ω) ≠ ⊤) (β : (↥K)ˣ)
    [FiniteDimensional ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    [IsGalois ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    [NumberField ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    (hβ : NK.UchidaKummer.localPowClass ↥K p (Submission.NeukirchUchida.primeOf A hAK) β ≠ 1) :
    NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K)
      (L := ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β))
      (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) ≠ ⊤ := by
  haveI : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  letI : DistribMulAction (↥K ≃ₐ[k] ↥K) (ZMod p) :=
    { smul := fun _ x => x
      one_smul := fun _ => rfl
      mul_smul := fun _ _ _ => rfl
      smul_zero := fun _ => rfl
      smul_add := fun _ _ _ => rfl }
  letI : SMulCommClass (↥K ≃ₐ[k] ↥K) (ZMod p) (ZMod p) :=
    { smul_comm := fun _ _ _ => rfl }
  -- the Kummer character of `β` is non-trivial on the decomposition group of `A`
  have hkummer : Work.SSGRoute.ZConstruction.kummerCharMonoidHom (p := p) (k := k) (Ω := Ω)
      (K := K) (ζ := ζ) (hζ := hζ) (A := A) hA β ≠ 1 := by
    intro h1
    exact hβ ((Work.SSGRoute.ZConstruction.kummerCharMonoidHom_eq_one_iff (p := p)
      (k := k) (Ω := Ω) (K := K) (ζ := ζ) (hζ := hζ) (A := A) hA
      (Submission.NeukirchUchida.primeOf A hAK)
      (Submission.NeukirchUchida.primeOf_spec A hAK) β).mp h1)
  -- hence `A` does not split completely in the Kummer level
  have hnsplit : ¬ SSGRoute.IsSplitIn ↥K (NK.LocalAnabelian.kummerField (K' := Ω) p β) A := by
    intro hsplit
    apply hkummer
    refine Subtype.ext (MonoidHom.ext fun g => ?_)
    rw [Work.SSGRoute.ZConstruction.kummerCharMonoidHom_apply]
    have hmem : (g : Ω ≃ₐ[↥K] Ω) ∈
        (NK.LocalAnabelian.kummerField (K' := Ω) p β).fixingSubgroup := hsplit g.2
    have hz := Work.SSGRoute.ZDataMup.LTRecFamHonest.kummerCharZMod_eq_zero_of_mem_fixingSubgroup
      (K := K) ζ hζ β le_rfl hmem
    show Multiplicative.ofAdd (Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) p (ζ := ζ) hζ β
      (g : Ω ≃ₐ[↥K] Ω)) = 1
    rw [hz, ofAdd_zero]
  have hβ_pow := notMem_powSubgroup_of_localPowClass_ne_one (K := K) (p := p) (k := k) (Ω := Ω)
    ζ hζ A hA hAK β hβ
  have hcard := hLevel_natCard_eq (K := K) (p := p) (k := k) (Ω := Ω) ζ hζ β hβ_pow
  -- the two descriptions of the prime below `A` agree
  have hP : hPrimeBelow (K := K) A hA = Submission.NeukirchUchida.primeOf A hAK :=
    (Submission.NeukirchUchida.primeOf_eq_of_comap_eq (A := A) (B := A) hAK
      (Work.SSGRoute.ZConstruction.isFinPlace_of_isFinPlace_below (K := K) (A := A) hA) rfl).symm
  -- a proper local norm subgroup
  intro htop
  rw [← hP] at htop
  exact hnsplit (Work.SSGRoute.ZDataMup.OddForm.oddSplitIn_of_localNormSubgroup_eq_top
    (K := K) (p := p) (k := k) (Ω := Ω) A hA
    (NK.LocalAnabelian.kummerField (K' := Ω) p β) hcard htop)

theorem exists_localImageAt_notMem_localNormSubgroup_hLevel (p : ℕ) [Fact p.Prime] (hp : p ≠ 2)
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    [IsAlgClosed Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [NumberField ↥K] (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (A : ValuationSubring Ω)
    (hA : SSGRoute.IsFinPlace k A) (hAK : A.comap (algebraMap ↥K Ω) ≠ ⊤) (β : (↥K)ˣ)
    [FiniteDimensional ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    [IsGalois ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    [NumberField ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β)]
    (hβ : NK.UchidaKummer.localPowClass ↥K p (Submission.NeukirchUchida.primeOf A hAK) β ≠ 1) :
    ∃ γ : (↥K)ˣ,
      NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
        (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) γ ∉
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K)
        (L := ↥(NK.LocalAnabelian.kummerField (K' := Ω) p β))
        (NK.GlobalCFT.Place.ofFinite (Submission.NeukirchUchida.primeOf A hAK)) := by
  have hne_top := localNormSubgroup_hLevel_ne_top (K := K) (p := p) (k := k) (Ω := Ω)
    ζ hζ A hA hAK β hβ
  have hβ_pow := notMem_powSubgroup_of_localPowClass_ne_one (K := K) (p := p) (k := k) (Ω := Ω)
    ζ hζ A hA hAK β hβ
  exact exists_localImageAt_notMem_localNormSubgroup_of_ne_top (K := K) (p := p) (k := k) (Ω := Ω)
    A hA hAK (NK.LocalAnabelian.kummerField (K' := Ω) p β)
    (hLevel_natCard_eq (K := K) (p := p) (k := k) (Ω := Ω) ζ hζ β hβ_pow) hne_top

end

end Work.SSGRoute.ZDataMup.LTRecFamHonest
