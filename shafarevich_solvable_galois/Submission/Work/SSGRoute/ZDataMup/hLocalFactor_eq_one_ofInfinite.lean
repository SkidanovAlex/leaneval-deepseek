/-!
# The archimedean local factor of a homomorphism killing the norm idèles, for odd prime degree

Let `L / K` be a finite Galois extension of number fields of **odd** (prime) degree `p ≠ 2` and let
`w` be an infinite place of `K`.  This file proves the archimedean input of the odd-`p` correction
of Shafarevich's theorem:

`Φ (onePlace w (localImageAt w γ)) = 1`

for every group homomorphism `Φ : 𝕀_K →* Gal(L/K)` which kills the norm idèles `N_{L/K}(𝕀_L)` and
every `γ ∈ Kˣ`.

## The mathematics

Since `[L : K] = p` is odd, the local degree `[L_W : K_w]` of every infinite place `W | w` divides
`p` and is at most `2` (the completions are `ℝ` or `ℂ`); hence it is `1`, and the archimedean local
norm `N_{L_W/K_w}` is **onto**.  Consequently the group `localNormSubgroup K L w` generated by these
local norms is all of `K_wˣ` (`localNormSubgroup_ofInfinite_eq_top_of_odd_finrank`), so *every*
element of `K_wˣ` is a local norm at `w`.  The one-place dictionary for idèle norms
(`NK.CFTLib.IdeleHasse.onePlace_ofInfinite_mem_normImage_iff`) then turns this into the statement
that the one-place idèle `onePlace w a` is a norm idèle — whence it is killed by `Φ`.

Concretely, if `W` were complex above a real `w`, then `W` would be *ramified* over `K`
(`NumberField.InfinitePlace.not_isUnramified_iff`) and `NumberField.InfinitePlace.even_finrank_of_not_isUnramified`
would force `[L : K]` to be even, contradicting the oddness of `p`.  This is exactly where the
hypothesis `p ≠ 2` enters.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace Work.SSGRoute.ZDataMup

/-- **The archimedean local norm subgroup is everything in odd degree.**  If `L / K` is a finite
Galois extension of number fields of odd degree, then at every infinite place `w` of `K` the
subgroup of `K_wˣ` generated by the local norms `N_{L_W/K_w}` over the places `W | w` is all of
`K_wˣ`: every local degree `[L_W : K_w]` divides `[L : K]`, is at most two, and hence equals one.

The proof picks a place `W | w`; if `w` (hence `W`) is complex the local norm is onto
(`localNormInfinite_range_eq_top_of_complex_complex`), if both are real it is onto as well
(`localNormInfinite_range_eq_top_of_real_real`), and the remaining case — `W` complex over a real
`w` — is a *ramified* place, which would make the degree of `L / K` even. -/
theorem localNormSubgroup_ofInfinite_eq_top_of_odd_finrank {K L : Type} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (w : NumberField.InfinitePlace K) (hodd : ¬ 2 ∣ Module.finrank K L) :
    NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L)
      (NK.GlobalCFT.Place.ofInfinite w) = ⊤ := by
  classical
  obtain ⟨W, hWcomap⟩ := NumberField.InfinitePlace.comap_surjective (k := K) (K := L) w
  have hW : W.LiesOver w := (NK.GlobalCFT.Norm.liesOver_iff_comap_eq W w).mpr hWcomap
  haveI : W.LiesOver w := hW
  -- the local norm at our chosen place `W` is onto
  have hmain : (NK.GlobalCFT.Place.localNormInfinite W w).range = ⊤ := by
    rcases w.isReal_or_isComplex with hwR | hwC
    · rcases W.isReal_or_isComplex with hWR | hWC
      · -- real above real: the local norm is the identity
        exact NK.NUV2.ArtinBridge.localNormInfinite_range_eq_top_of_real_real hwR hWR
      · -- complex above real is impossible in odd degree
        exfalso
        have hram : ¬ NumberField.InfinitePlace.IsUnramified K W := by
          rw [NumberField.InfinitePlace.not_isUnramified_iff]
          exact ⟨hWC, by rw [NumberField.InfinitePlace.LiesOver.comap_eq W w]; exact hwR⟩
        exact hodd (even_iff_two_dvd.mp
          (NumberField.InfinitePlace.even_finrank_of_not_isUnramified hram))
    · -- complex above complex: the local norm is onto
      exact NK.NUV2.ArtinBridge.localNormInfinite_range_eq_top_of_complex_complex hwC
        (NumberField.InfinitePlace.LiesOver.isComplex_of_isComplex_under W hwC)
  rw [NK.CFTLib.IdeleHasse.localNormSubgroup_ofInfinite (K := K) (L := L), eq_top_iff]
  rw [← hmain]
  exact le_iSup_of_le ⟨W, hW⟩ le_rfl

theorem hLocalFactor_eq_one_ofInfinite {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω] (hp : p ≠ 2) (w : NumberField.InfinitePlace ↥K)
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L] [IsGalois ↥K L] [NumberField ↥L]
    (hcard : Nat.card (↥L ≃ₐ[↥K] ↥L) = p)
    (Φ : NK.GlobalCFT.Idele ↥K →* (↥L ≃ₐ[↥K] ↥L))
    (hΦ : ∀ x ∈ NK.GlobalCFT.Idele.normImage ↥K ↥L, Φ x = 1) (γ : (↥K)ˣ) :
    Φ (NK.HassePrinciple.onePlace (NK.GlobalCFT.Place.ofInfinite w)
        (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (NK.GlobalCFT.Place.ofInfinite w) γ)) = 1 := by
  -- `Gal(L/K)` has cardinality `p = [L : K]`, an odd prime
  have hfin : Module.finrank ↥K ↥L = p := by
    rw [← IsGalois.card_aut_eq_finrank ↥K ↥L]
    exact hcard
  have hodd : ¬ 2 ∣ Module.finrank ↥K ↥L := by
    rw [hfin]
    exact (Fact.out : p.Prime).odd_of_ne_two hp |>.not_two_dvd_nat
  -- the local norm subgroup at `w` is everything, so the one-place idèle is a norm idèle
  have htop := localNormSubgroup_ofInfinite_eq_top_of_odd_finrank (K := ↥K) (L := ↥L) w hodd
  have hmem : NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (NK.GlobalCFT.Place.ofInfinite w) γ
      ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K) (L := ↥L)
          (NK.GlobalCFT.Place.ofInfinite w) := by
    rw [htop]
    exact Subgroup.mem_top _
  refine hΦ _ ?_
  exact (NK.CFTLib.IdeleHasse.onePlace_ofInfinite_mem_normImage_iff (K := ↥K) (L := ↥L) w _).mpr hmem

end Work.SSGRoute.ZDataMup
