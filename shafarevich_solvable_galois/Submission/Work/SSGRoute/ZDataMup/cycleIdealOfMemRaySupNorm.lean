/-!
# The ideal of a congruent idèle lies in the ray times the norm group

`Cycle.rayOf c` is the congruence ray `P(c)` of a cycle `c` and `Cycle.normGroupOf K L c cL` is
the norm group `𝔑(c, cL)` generated by the relative norms of the integral ideals of `L` coprime
to `cL`.  This module proves that for an idèle `z` of `K` which is congruent to `1` modulo `c`
and which splits as `z = N_{L/K}(y)·(β)`, the fractional ideal of `z` lies in `P(c)·𝔑(c, cL)`.

This is the cycle analogue of `NK.CFTLib.ARL.idealOf_mem_principalRay_sup_normIdeals`; the
argument is the same, with the `ℕ`-modulus lemmas supplied by the cycle through the containment
`Cycle.congrSubgroup_le_of_natCast_le`:

* adjust `y` in `L` so that `y' := y·(d)` is congruent to `1` modulo `m`
  (`NK.CFTLib.ARL.exists_adjust_congruenceSubgroup`);
* its idèlic norm is congruent to `1` modulo `m` in `K`
  (`NK.CFTLib.Arl.normIdeleHom_mem_congruenceSubgroup`) and hence, because the level of `c` at
  each prime of its support is dominated by the valuation of `m`, congruent to `1` modulo `c`;
* the leftover principal idèle `(β/N_{L/K} d) = z·(N y')⁻¹` is therefore in the congruence
  subgroup of `c`, so its ideal lies in the ray `P(c)`
  (`Cycle.unitsToIdealUnits_mem_rayOf`);
* `idealOf y'` is a local unit at every prime dividing `(m)`, hence — the support of `cL` being
  made of primes above the support of `c` — coprime to `cL`, so `relNormUnit (idealOf y')` is the
  relative norm of an element of `I(cL)`, i.e. lies in `𝔑(c, cL)`
  (`Cycle.normGroupOf_eq_map_Icoprime`, `NK.CFTLib.ARL.idealOf_normIdeleHom`);
* the two pieces multiply to `idealOf z`, and subgroups are closed under multiplication.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain
open NK.GlobalCFT

noncomputable section

namespace Work.SSGRoute.ZDataMup

theorem cycleIdealOfMemRaySupNorm
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L]
    (c : Work.SSGRoute.ZDataMup.Cycle K) (cL : Work.SSGRoute.ZDataMup.Cycle L)
    (hbc : Work.SSGRoute.ZDataMup.Cycle.IsBaseChange K L c cL)
    (m : ℕ) (hm : 0 < m)
    (hlevK : ∀ 𝔭 ∈ c.supp, 1 ≤ c.lev 𝔭)
    (hsuppK : ∀ 𝔭 ∈ c.supp, (m : NumberField.RingOfIntegers K) ∈ 𝔭.asIdeal)
    (hcmpK : ∀ 𝔭 ∈ c.supp, c.lev 𝔭 ≤ Work.SSGRoute.ZDataMup.cycleLevel (K := K) m 𝔭)
    {y : NK.GlobalCFT.Idele L} {β : Kˣ} {z : NK.GlobalCFT.Idele K}
    (hz : z ∈ c.congrSubgroup)
    (hzy : z = NK.GlobalCFT.Idele.normIdeleHom K L y *
      NK.GlobalCFT.Idele.principalIdele K β) :
    Units.mk0 (NK.GlobalCFT.Idele.idealOf z) (NK.GlobalCFT.Idele.idealOf_ne_zero z) ∈
      c.rayOf ⊔ c.normGroupOf K L cL := by
  classical
  -- adjust `y` in `L` so that it becomes congruent to `1` modulo `m`
  obtain ⟨d, hd⟩ := NK.CFTLib.ARL.exists_adjust_congruenceSubgroup L m hm y
  set y' : NK.GlobalCFT.Idele L := y * Idele.principalIdele L d with hy'_def
  have hd' : y' ∈ NK.CFTLib.Arl.congruenceSubgroup L m := hd
  -- the norm of the adjusted idèle is congruent to `1` modulo `m`, hence modulo the cycle `c`
  have hNy'mem : Idele.normIdeleHom K L y' ∈ NK.CFTLib.Arl.congruenceSubgroup K m :=
    NK.CFTLib.Arl.normIdeleHom_mem_congruenceSubgroup m hm hd'
  have hNy'c : Idele.normIdeleHom K L y' ∈ c.congrSubgroup :=
    Cycle.congrSubgroup_le_of_natCast_le hm hlevK hsuppK hcmpK hNy'mem
  have hNy'_eq : Idele.normIdeleHom K L y' =
      Idele.normIdeleHom K L y * Idele.principalIdele K (Units.map (Algebra.norm K) d) := by
    rw [hy'_def, map_mul, Idele.normIdeleHom_principalIdele]
  -- the leftover principal idèle
  have hprinc : Idele.principalIdele K (β / Units.map (Algebra.norm K) d) =
      z * (Idele.normIdeleHom K L y')⁻¹ := by
    rw [hzy, hNy'_eq, map_div]
    simp [div_eq_mul_inv, mul_assoc, mul_comm]
  have hprinc_mem : Idele.principalIdele K (β / Units.map (Algebra.norm K) d) ∈
      c.congrSubgroup := by
    rw [hprinc]
    exact Subgroup.mul_mem _ hz (Subgroup.inv_mem _ hNy'c)
  -- its ideal lies in the ray
  have hray : NK.CFTLib.ARL.unitsToIdealUnits K (β / Units.map (Algebra.norm K) d) ∈ c.rayOf :=
    Cycle.unitsToIdealUnits_mem_rayOf hprinc_mem
  -- the ideal of `N y'` lies in the norm group
  have hA_mem : Units.mk0 (Idele.idealOf y') (Idele.idealOf_ne_zero y') ∈ cL.Icoprime := by
    show Cycle.FracCoprime cL (Units.mk0 (Idele.idealOf y') (Idele.idealOf_ne_zero y'))
    intro 𝔮 h𝔮
    obtain ⟨𝔭, h𝔭, hlies⟩ := (hbc 𝔮).mp h𝔮
    have hm𝔮 : ((m : ℕ) : 𝓞 L) ∈ 𝔮.asIdeal := by
      haveI : 𝔮.asIdeal.LiesOver 𝔭.asIdeal := hlies
      have h4 : algebraMap (𝓞 K) (𝓞 L) ((m : ℕ) : 𝓞 K) ∈ 𝔮.asIdeal :=
        (Ideal.mem_of_liesOver _ _ ((m : ℕ) : 𝓞 K)).mp (hsuppK 𝔭 h𝔭)
      simpa using h4
    exact NK.CFTLib.ARL.count_idealOf_eq_zero_of_congruence hd' 𝔮 hm𝔮
  have hnorm : Units.mk0 (Idele.idealOf (Idele.normIdeleHom K L y'))
      (Idele.idealOf_ne_zero _) ∈ c.normGroupOf K L cL := by
    rw [Cycle.normGroupOf_eq_map_Icoprime]
    refine Subgroup.mem_map.mpr ⟨Units.mk0 (Idele.idealOf y') (Idele.idealOf_ne_zero y'),
      hA_mem, ?_⟩
    apply Units.ext
    simp only [Units.val_mk0]
    exact (NK.CFTLib.ARL.idealOf_normIdeleHom y').symm
  -- split `z` as the product of the two pieces
  have hz_split : z = Idele.normIdeleHom K L y' *
      Idele.principalIdele K (β / Units.map (Algebra.norm K) d) := by
    rw [hprinc]
    simp
  suffices h : Units.mk0 (Idele.idealOf z) (Idele.idealOf_ne_zero z) =
      Units.mk0 (Idele.idealOf (Idele.normIdeleHom K L y')) (Idele.idealOf_ne_zero _) *
        NK.CFTLib.ARL.unitsToIdealUnits K (β / Units.map (Algebra.norm K) d) by
    rw [h]
    exact Subgroup.mul_mem _ (Subgroup.mem_sup_right hnorm) (Subgroup.mem_sup_left hray)
  apply Units.ext
  simp only [Units.val_mk0, Units.val_mul]
  rw [hz_split, Idele.idealOf_mul, NK.CFTLib.ARL.unitsToIdealUnits_coe,
    Idele.idealOf_principalIdele]

end Work.SSGRoute.ZDataMup
