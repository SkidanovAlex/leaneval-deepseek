noncomputable section

namespace Work.SSGRoute.ZDataMup

open NK.CFTLib.ArtinReciprocityIdeal

namespace Cycle

variable {K : Type} [Field K] [NumberField K]

/-! ## `I(c)`: the fractional ideals coprime to the cycle -/

/-- **The group `I(c)` of fractional ideals coprime to the cycle `c`**, as the subgroup of `Frac K`
of the fractional ideals with vanishing `count` at every prime of `c`.  (This is the subgroup
presented by `Cycle.idealCoprimeGroup` as the closure of the primes outside `c`.) -/
def Icoprime (c : Cycle K) : Subgroup (Frac K) where
  carrier := {A | c.FracCoprime A}
  one_mem' := by
    intro 𝔭 _
    rw [Units.val_one, FractionalIdeal.count_one K 𝔭]
  mul_mem' := by
    intro A B hA hB 𝔭 h𝔭
    rw [Units.val_mul, FractionalIdeal.count_mul K 𝔭 A.ne_zero B.ne_zero, hA 𝔭 h𝔭, hB 𝔭 h𝔭,
      add_zero]
  inv_mem' := by
    intro A hA 𝔭 h𝔭
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv K 𝔭, hA 𝔭 h𝔭, neg_zero]

@[simp] theorem mem_Icoprime {c : Cycle K} {A : Frac K} :
    A ∈ c.Icoprime ↔ c.FracCoprime A := Iff.rfl

/-! ## `P(c)`: the congruence ray of a cycle -/

/-- **The congruence ray `P(c)` of the cycle `c`**, in the idèle–ideal vocabulary of
`NK.CFTLib.ARL`: the image of the principal idèles lying in the congruence subgroup
`Cycle.congrSubgroup c` under the principal-ideal map. -/
def rayOf (c : Cycle K) : Subgroup (Frac K) :=
  (Subgroup.comap (Idele.principalIdele K) c.congrSubgroup).map (NK.CFTLib.ARL.unitsToIdealUnits K)

theorem unitsToIdealUnits_mem_rayOf {c : Cycle K} {a : Kˣ}
    (ha : Idele.principalIdele K a ∈ c.congrSubgroup) :
    NK.CFTLib.ARL.unitsToIdealUnits K a ∈ c.rayOf :=
  Subgroup.mem_map.mpr ⟨a, ha, rfl⟩

/-- **The closure-presented principal ray of `CycleDefs.lean` is the congruence ray.**  For a cycle
whose levels on its support are `≥ 1` (all that occurs for a conductor), the congruence condition
`Cycle.CongrOne` agrees with membership of the principal idèle in `Cycle.congrSubgroup`. -/
theorem principalRay_eq_rayOf {c : Cycle K} (hlev : ∀ 𝔭 ∈ c.supp, 1 ≤ c.lev 𝔭) :
    c.principalRay = c.rayOf := by
  rw [principalRay, rayOf]
  refine le_antisymm ?_ ?_
  · rw [Subgroup.closure_le]
    rintro A ⟨a, ha, rfl⟩
    exact Subgroup.mem_map.mpr ⟨a, (principalIdele_mem_congrSubgroup_iff hlev a).mpr ha,
      (NK.CFTLib.ArtinReciprocityIdeal.spanUnit_eq_unitsToIdealUnits a).symm⟩
  · rintro A ⟨a, ha, rfl⟩
    exact Subgroup.subset_closure ⟨a, (principalIdele_mem_congrSubgroup_iff hlev a).mp ha,
      (NK.CFTLib.ArtinReciprocityIdeal.spanUnit_eq_unitsToIdealUnits a)⟩

/-! ## `𝔑(c, cL)`: the norm group of a pair of cycles -/

/-- **The norm group `𝔑(c, cL)`** of a cycle `c` of `K` together with a cycle `cL` of `L`: the
subgroup of `Frac K` generated by the relative norms of the integral ideals of `𝓞 L` which are
coprime to `cL`. -/
def normGroupOf (K : Type) [Field K] [NumberField K]
    (L : Type) [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    (c : Cycle K) (cL : Cycle L) : Subgroup (Frac K) :=
  Subgroup.closure (Set.range (fun 𝔅 : {I : Ideal (𝓞 L) // I ≠ ⊥ ∧
      ∀ 𝔮 : HeightOneSpectrum (𝓞 L), 𝔮 ∈ cL.supp → ¬ 𝔮.asIdeal ∣ I} =>
    Units.mk0 (Ideal.relNorm (𝓞 K) (𝔅 : Ideal (𝓞 L)) : FractionalIdeal (𝓞 K)⁰ K)
      (by
        rw [FractionalIdeal.coeIdeal_ne_zero]
        exact fun h => 𝔅.2.1 ((Ideal.relNorm_eq_bot_iff).mp h))))

variable {L : Type} [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]

/-- A generator of the norm group. -/
theorem mk_relNorm_mem_normGroupOf {c : Cycle K} {cL : Cycle L} {𝔅 : Ideal (𝓞 L)} (h𝔅 : 𝔅 ≠ ⊥)
    (hcop : ∀ 𝔮 : HeightOneSpectrum (𝓞 L), 𝔮 ∈ cL.supp → ¬ 𝔮.asIdeal ∣ 𝔅) :
    Units.mk0 (Ideal.relNorm (𝓞 K) 𝔅 : FractionalIdeal (𝓞 K)⁰ K)
        (by rw [FractionalIdeal.coeIdeal_ne_zero]
            exact fun h => h𝔅 ((Ideal.relNorm_eq_bot_iff).mp h)) ∈ c.normGroupOf K L cL := by
  refine Subgroup.subset_closure ⟨⟨𝔅, h𝔅, hcop⟩, ?_⟩
  apply Units.ext
  simp only [Units.val_mk0]

/-- **The closure-presented norm group of `CycleDefs.lean` is `Cycle.normGroupOf`.** -/
theorem normRay_eq_normGroupOf (c : Cycle K) (cL : Cycle L) :
    Cycle.normRay K L c cL = c.normGroupOf K L cL := by
  rw [Cycle.normRay, normGroupOf]
  congr 1
  ext A
  constructor
  · rintro ⟨I, hI, hcop, rfl⟩
    refine ⟨⟨I, hI, ?_⟩, ?_⟩
    · intro 𝔮 h𝔮 hdvd
      exact (count_ne_zero_iff_dvd (K := L) hI 𝔮).mpr hdvd (hcop 𝔮 h𝔮)
    · apply Units.ext
      simp only [Units.val_mk0]
      rfl
  · rintro ⟨⟨I, hI, hcop⟩, rfl⟩
    refine ⟨I, hI, ?_, ?_⟩
    · intro 𝔮 h𝔮
      rw [show FractionalIdeal.count L 𝔮
            ((idealUnit I hI : Frac L) : FractionalIdeal (𝓞 L)⁰ L)
          = FractionalIdeal.count L 𝔮 (I : FractionalIdeal (𝓞 L)⁰ L) from rfl]
      by_contra hc
      exact hcop 𝔮 h𝔮 ((count_ne_zero_iff_dvd (K := L) hI 𝔮).mp hc)
    · apply Units.ext
      simp only [Units.val_mk0]
      rfl

end Cycle

end Work.SSGRoute.ZDataMup
