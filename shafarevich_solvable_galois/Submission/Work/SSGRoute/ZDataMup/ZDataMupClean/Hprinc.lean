namespace NK.CFTLib.ArtinReciprocityIdeal

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **`IsUnramified` is `ramificationIdxIn = 1`** (the converse of the direction recorded in
`ArtinSymAux`): if every prime of `𝓞 L` above `p` has ramification index one, then the common
ramification index of `p` is one. -/
theorem ramificationIdxIn_eq_one_of_isUnramifiedIn_clean (p : HeightOneSpectrum (𝓞 K))
    (h : IsUnramified (K := K) (L := L) p) :
    Ideal.ramificationIdxIn p.asIdeal (𝓞 L) = 1 := by
  obtain ⟨q, hq⟩ := NK.Chebotarev.exists_primeIdeal_liesOver (K := K) (L := L) p
  letI hMSA : MulSemiringAction (Gal(L/K)) (𝓞 L) :=
    IsIntegralClosure.MulSemiringAction (𝓞 K) K L (𝓞 L)
  haveI hGG : IsGaloisGroup (Gal(L/K)) (𝓞 K) (𝓞 L) :=
    IsGaloisGroup.of_isFractionRing (Gal(L/K)) (𝓞 K) (𝓞 L) K L
  haveI : q.asIdeal.IsPrime := q.isPrime
  haveI : q.asIdeal.LiesOver p.asIdeal := hq
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := 𝓞 K) (B := 𝓞 L) p.asIdeal q.asIdeal
    (Gal(L/K))]
  exact h q hq

/-- **The principal ray lies in the kernel of the ideal Artin symbol.**

Given an ideal modulus `𝔪 ≠ ⊥` containing all ramified primes (`hram`), the kernel containment of
Lang's crux on `I(𝔪)` (`hkerK`), and the norm-index inequality (`hPNI`, `hIdx`), the whole
principal ray `P(𝔪)` — generated by the principal ideals `(b)` with `b ≡ 1 mod* 𝔪` — lies in the
kernel of the ideal-theoretic Artin symbol.

This is the first three quarters of the proof of
`NK.CFTLib.ArtinReciprocityIdeal.artinSymbolKillsPrincipal_ideal` (the index computation), stated
in the `mod*` form needed by the idèlic construction. -/
theorem principalRayId_le_ker_artinSymFracHom_clean
    [IsCyclic (L ≃ₐ[K] L)]
    (hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a)
    (𝔪 : Ideal (𝓞 K)) (h𝔪 : 𝔪 ≠ ⊥)
    (hram : ContainsRamified (K := K) (L := L) 𝔪)
    (hkerK : ∀ A : Frac K, FracCoprimeId 𝔪 A →
      NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm A = 1 →
      A ∈ principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪)
    (hPNI : principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪 ≤ idealCoprimeGroupId 𝔪)
    (hIdx : Module.finrank K L ≤ (principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪).relIndex
      (idealCoprimeGroupId 𝔪)) :
    principalRayId 𝔪 ≤ (artinSymFracHom (K := K) (L := L) hcomm).ker := by
  classical
  haveI : IsMulCommutative (L ≃ₐ[K] L) := IsMulCommutative.of_comm hcomm
  let f : Frac K →* (L ≃ₐ[K] L) := artinSymFracHom (K := K) (L := L) hcomm
  let I : Subgroup (Frac K) := idealCoprimeGroupId 𝔪
  let PN : Subgroup (Frac K) := principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪
  let J : Subgroup (Frac K) := f.ker ⊓ I
  have hJPN : J ≤ PN := by
    intro A hA
    have hAJ : A ∈ f.ker := (Subgroup.mem_inf.mp hA).1
    have hAI : A ∈ I := (Subgroup.mem_inf.mp hA).2
    have hkerA : f A = 1 := MonoidHom.mem_ker.mp hAJ
    have hcop : FracCoprimeId 𝔪 A := fracCoprimeId_of_mem_idealCoprimeGroupId (K := K) hAI
    refine hkerK A hcop ?_
    rw [artinSymFracHom_apply] at hkerA
    exact hkerA
  have hmap : I.map f = ⊤ := by
    rw [eq_top_iff]
    intro σ _
    obtain ⟨A, hA, hAσ⟩ := surjId_clean K L 𝔪 h𝔪 hram σ
    refine Subgroup.mem_map.mpr ⟨A, hA, ?_⟩
    rw [artinSymFracHom_apply]
    exact hAσ
  have hcardI : f.ker.relIndex I = Nat.card (L ≃ₐ[K] L) := by
    rw [Subgroup.relIndex_ker I f, hmap]
    exact Nat.card_congr (Subgroup.topEquiv (G := L ≃ₐ[K] L)).toEquiv
  have hJrelI : J.relIndex I = Module.finrank K L := by
    rw [show J.relIndex I = f.ker.relIndex I from Subgroup.inf_relIndex_right f.ker I, hcardI,
      IsGalois.card_aut_eq_finrank K L]
  have hJI_ne : J.relIndex I ≠ 0 := by
    rw [hJrelI]
    exact (Module.finrank_pos (R := K) (M := L)).ne'
  have hPNrelI : PN.relIndex I = Module.finrank K L := by
    refine le_antisymm ?_ hIdx
    rw [← hJrelI]
    exact Subgroup.relIndex_le_of_le_left hJPN hJI_ne
  have hJrelPN : J.relIndex PN = 1 := by
    have h' : J.relIndex PN * PN.relIndex I = 1 * PN.relIndex I := by
      rw [Subgroup.relIndex_mul_relIndex J PN I hJPN hPNI, hJrelI, hPNrelI, one_mul]
    exact Nat.eq_of_mul_eq_mul_right
      (Nat.pos_of_ne_zero (by rw [hPNrelI, ← hJrelI]; exact hJI_ne)) h'
  have hPNJ : PN ≤ J := Subgroup.relIndex_eq_one.mp hJrelPN
  intro A hA
  have hAPN : A ∈ PN := Subgroup.mem_sup_left hA
  have hmem : A ∈ f.ker ⊓ I := hPNJ hAPN
  exact (Subgroup.mem_inf.mp hmem).1

/-- **The conductor drop at an ideal modulus, in ray form.**  For `b : Kˣ` congruent to `1` modulo
`𝔪` in the sense of Lang (`mod*`, i.e. merely a valuation bound at the primes dividing `𝔪`, plus
totally positive), the Artin symbol of the principal ideal `(b)` is trivial. -/
theorem artinSym_spanSingleton_eq_one_of_congrOneId_clean
    [IsCyclic (L ≃ₐ[K] L)]
    (hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a)
    (𝔪 : Ideal (𝓞 K)) (h𝔪 : 𝔪 ≠ ⊥)
    (hram : ContainsRamified (K := K) (L := L) 𝔪)
    (hkerK : ∀ A : Frac K, FracCoprimeId 𝔪 A →
      NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm A = 1 →
      A ∈ principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪)
    (hPNI : principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪 ≤ idealCoprimeGroupId 𝔪)
    (hIdx : Module.finrank K L ≤ (principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪).relIndex
      (idealCoprimeGroupId 𝔪))
    (b : Kˣ) (hb : CongrOneId 𝔪 b) :
    NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm
        (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) ((b : Kˣ) : K)) = 1 := by
  have hmem : spanUnit b ∈ (artinSymFracHom (K := K) (L := L) hcomm).ker :=
    principalRayId_le_ker_artinSymFracHom_clean (K := K) (L := L) hcomm 𝔪 h𝔪 hram hkerK hPNI hIdx
      (Subgroup.subset_closure ⟨b, hb, rfl⟩)
  have h2 := MonoidHom.mem_ker.mp hmem
  rw [artinSymFracHom_apply] at h2
  rwa [coe_spanUnit] at h2

end NK.CFTLib.ArtinReciprocityIdeal

namespace NK.CFTLib.ArtinReciprocityIdeal

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **The ideal modulus supported exactly on the ramified primes, with the conductor drop.**

Assembled from the natural-number modulus `mRam · 2` of finding (A)
(`Work.SSGRoute.ZDataMup.mRam_ramifiedSupport`) via `exists_idealModulus_of_natModulus`, and from
the two inputs `hkerId` (Lang's crux) and `hidxId` (the norm-index inequality) of the
ideal-modulus lane. -/
theorem hprinc_idealModulus_ramifiedSupport_clean
    [IsCyclic (L ≃ₐ[K] L)]
    (hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a)
    (hkerId : ∀ (𝔪 : Ideal (𝓞 K)), 𝔪 ≠ ⊥ →
      IsAdmissibleId (K := K) (L := L) 𝔪 →
      ContainsRamified (K := K) (L := L) 𝔪 →
      ∀ A : Frac K, FracCoprimeId 𝔪 A →
        NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm A = 1 →
        A ∈ principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪)
    (hidxId : ∀ (𝔪 : Ideal (𝓞 K)), 𝔪 ≠ ⊥ →
      ContainsRamified (K := K) (L := L) 𝔪 →
      IsAdmissibleId (K := K) (L := L) 𝔪 →
      (principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪) ≤ idealCoprimeGroupId 𝔪 ∧
      Module.finrank K L ≤ (principalRayId 𝔪 ⊔ normRayId (K := K) (L := L) 𝔪).relIndex
        (idealCoprimeGroupId 𝔪)) :
    ∃ 𝔪 : Ideal (𝓞 K), 𝔪 ≠ ⊥ ∧
      IsAdmissibleId (K := K) (L := L) 𝔪 ∧
      ContainsRamified (K := K) (L := L) 𝔪 ∧
      (∀ 𝔭 : HeightOneSpectrum (𝓞 K),
        DvdPrime 𝔪 𝔭 ↔ Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) ≠ 1) ∧
      (∀ b : Kˣ, CongrOneId 𝔪 b →
        NK.CFTLib.Arl.artinSym (K := K) (L := L) hcomm
          (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) ((b : Kˣ) : K)) = 1) := by
  classical
  set M : ℕ := Work.SSGRoute.ZDataMup.mRam (K := K) (L := L) * 2 with hMdef
  have hM1 : 1 < M := by
    have h := Work.SSGRoute.ZDataMup.mRam_pos (K := K) (L := L)
    rw [hMdef]; omega
  have hramM : ∀ 𝔭 : HeightOneSpectrum (𝓞 K), (M : 𝓞 K) ∉ 𝔭.asIdeal →
      Ideal.ramificationIdxIn 𝔭.asIdeal (𝓞 L) = 1 := by
    intro 𝔭 h𝔭
    by_contra hne
    have hnotU : ¬ IsUnramified (K := K) (L := L) 𝔭 := by
      intro hunr
      exact hne (ramificationIdxIn_eq_one_of_isUnramifiedIn_clean (K := K) (L := L) 𝔭 hunr)
    have hmem : ((Work.SSGRoute.ZDataMup.mRam (K := K) (L := L) : ℕ) : 𝓞 K) ∈ 𝔭.asIdeal :=
      Work.SSGRoute.ZDataMup.mRam_strongSupport (K := K) (L := L) 𝔭 hnotU
    refine h𝔭 ?_
    have hcast : ((M : ℕ) : 𝓞 K)
        = ((Work.SSGRoute.ZDataMup.mRam (K := K) (L := L) : ℕ) : 𝓞 K) * 2 := by
      rw [hMdef]; push_cast; ring
    rw [hcast]
    exact Ideal.mul_mem_right (2 : 𝓞 K) 𝔭.asIdeal hmem
  have hadm : IsAdmissible (K := K) (L := L) M := by
    refine isAdmissible_of_mem_pow (K := K) (L := L) M ?_
    intro Q hQ
    obtain ⟨c, hc⟩ := Work.SSGRoute.ZDataMup.dvd_mRam (K := K) (L := L) Q hQ
    have hcast : ((M : ℕ) : 𝓞 K)
        = ((Ideal.absNorm Q.asIdeal : 𝓞 K)) ^ (levelQ (K := K) (L := L) Q)
            * (c : 𝓞 K) * 2 := by
      rw [hMdef, hc]; push_cast; ring
    have hmem : ((Ideal.absNorm Q.asIdeal : 𝓞 K)) ^ (levelQ (K := K) (L := L) Q)
        ∈ Q.asIdeal ^ levelQ (K := K) (L := L) Q := by
      rw [← Nat.cast_pow]
      exact Work.SSGRoute.ZDataMup.absNorm_pow_mem_pow (K := K) Q
        (levelQ (K := K) (L := L) Q)
    rw [hcast]
    exact Ideal.mul_mem_right (2 : 𝓞 K) (Q.asIdeal ^ levelQ (K := K) (L := L) Q)
      (Ideal.mul_mem_right (c : 𝓞 K) (Q.asIdeal ^ levelQ (K := K) (L := L) Q) hmem)
  obtain ⟨𝔪, h𝔪, hadmId, hram, hsupp, _hcong⟩ :=
    exists_idealModulus_of_natModulus (K := K) (L := L) M hM1 hramM hadm
  obtain ⟨hPNI, hIdx⟩ := hidxId 𝔪 h𝔪 hram hadmId
  refine ⟨𝔪, h𝔪, hadmId, hram, hsupp, fun b hb => ?_⟩
  exact artinSym_spanSingleton_eq_one_of_congrOneId_clean (K := K) (L := L) hcomm 𝔪 h𝔪 hram
    (fun A hcop hsym => hkerId 𝔪 h𝔪 hadmId hram A hcop hsym) hPNI hIdx b hb

end NK.CFTLib.ArtinReciprocityIdeal
