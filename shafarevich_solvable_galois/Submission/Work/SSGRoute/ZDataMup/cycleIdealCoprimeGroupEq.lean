/-!
# The closure-presented coprime-ideal group of a cycle is the subgroup `I(c)`

`Cycle.idealCoprimeGroup c` presents `I(c)` as the subgroup of `Frac K` generated by the prime
ideals outside `c`, while `Cycle.Icoprime c` presents it as the subgroup of fractional ideals
whose `count` vanishes at every prime of `c`.  This module proves that the two agree.

Both inclusions are the content of `Submission/Work/SSGRoute/ZDataMup/LT_CyclePort.lean`:

* `Cycle.idealCoprimeGroup_le_Icoprime` — every generator is a prime outside `c`, hence has
  vanishing `count` at each prime of `c`, and the coprime fractional ideals form a subgroup;
* `Cycle.Icoprime_le_idealCoprimeGroup` — a fractional ideal is the finitely supported product
  `∏_𝔭 𝔭 ^ (count 𝔭 A)`; every factor with `𝔭 ∈ c.supp` has exponent `0`, and every other factor
  is a generator.

Here they are assembled into the equality, the cycle analogue of
`NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup_eq_Icoprime`.
-/

set_option autoImplicit false
set_option maxHeartbeats 1600000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace Work.SSGRoute.ZDataMup

open NK.CFTLib.ArtinReciprocityIdeal

/-- **`I(c)` in the closure presentation is `I(c)` in the coprime presentation**: the subgroup of
fractional ideals generated by the primes outside the cycle `c` equals the subgroup of fractional
ideals whose `count` vanishes at every prime of `c`. -/
theorem cycleIdealCoprimeGroupEq
    {K : Type} [Field K] [NumberField K] (c : Work.SSGRoute.ZDataMup.Cycle K) :
    c.idealCoprimeGroup = Work.SSGRoute.ZDataMup.Cycle.Icoprime c :=
  le_antisymm (Cycle.idealCoprimeGroup_le_Icoprime c) (Cycle.Icoprime_le_idealCoprimeGroup c)

end Work.SSGRoute.ZDataMup
