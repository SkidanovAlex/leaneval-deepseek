/-!
# Every locally constant abelian character of `Gal(F'/F)` factors through `Gal(F^{ab}/F)`

Let `F'/F` be Galois and let `A = NK.LocalReciprocity.maxAbelianSubext F F'` be the fixed field
of the commutator subgroup of `G = Gal(F'/F)`, so that `Gal(A/F) = NK.LocalCFT.AbGal F F'` is the
abelianised absolute Galois group and restriction

`AlgEquiv.restrictNormalHom A : Gal(F'/F) →* Gal(A/F)`

is surjective with kernel `Gal(F'/A)`, the (topologically) closed subgroup generated by the
commutators.  The lemma proved here says that *every* locally constant homomorphism

`y : Gal(F'/F) →* Multiplicative (ZMod p)`

into an abelian group (more generally, any `CommGroup`) factors through the restriction map; in
other words, the map

`MonoidHom.liftOfSurjective (AlgEquiv.restrictNormalHom A) _`
applied to `y` is a genuine preimage of `y`.

## Route

The target is commutative, so `y` kills commutators: `commutator G ≤ y.ker`.  Local constancy of
`y` says that `y.ker` is open (`IsLocallyConstant` is `∀ s, IsOpen (y ⁻¹' s)`, and
`y.ker = y ⁻¹' {1}`), and the Krull topology neighbourhood basis of `1`
(`krullTopology_mem_nhds_one_iff`) produces a *finite* subextension `E/F'` — i.e. an open subgroup
`Gal(F'/E) ≤ y.ker`.  Hence the subgroup

`K = Gal(F'/E) ⊔ commutator G ≤ y.ker`

contains the open subgroup `Gal(F'/E)`, so it is open, hence closed.  A closed subgroup is the
fixing subgroup of its fixed field (`InfiniteGalois.fixingSubgroup_fixedField`), and since
`commutator G ≤ K` we get `fixedField K ≤ fixedField (commutator G) = A`; applying the (antitone)
`fixingSubgroup` map gives

`ker (restrictNormalHom A) = A.fixingSubgroup ≤ (fixedField K).fixingSubgroup = K ≤ y.ker`.

So `y` factors through the quotient `G ⧸ ker (restrictNormalHom A) ≃ Gal(A/F)`, which is exactly
the statement.
-/

namespace Work.SSGRoute.ZDataMup

open scoped Topology commutatorElement

-- `haveI` below is genuinely used as a typeclass instance (`FiniteDimensional F E` supplies the
-- `IsOpen` instance for the fixing subgroup); the style linter cannot see that.
set_option linter.style.haveILetI false

theorem exists_factor_restrictNormalHom {p : ℕ} [Fact p.Prime] {F F' : Type*}
    [Field F] [Field F'] [Algebra F F'] [IsGalois F F']
    [IsGalois F (NK.LocalReciprocity.maxAbelianSubext F F')]
    (y : (F' ≃ₐ[F] F') →* Multiplicative (ZMod p))
    (hy : IsLocallyConstant y) :
    ∃ y' : NK.LocalCFT.AbGal F F' →* Multiplicative (ZMod p),
      y'.comp (AlgEquiv.restrictNormalHom (NK.LocalReciprocity.maxAbelianSubext F F')) = y := by
  classical
  let A : IntermediateField F F' := NK.LocalReciprocity.maxAbelianSubext F F'
  -- `y` is trivial on commutators, because its target is commutative.
  have hcomm : commutator (F' ≃ₐ[F] F') ≤ y.ker := by
    rw [commutator_def, Subgroup.commutator_le]
    intro g _ h _
    rw [MonoidHom.mem_ker, commutatorElement_def]
    simp only [map_mul, map_inv]
    rw [mul_comm (y g) (y h)]
    group
  -- local constancy: `y.ker` is open, so it contains `Gal(F'/E)` for a finite `E/F`.
  have hopen : IsOpen (y.ker : Set (F' ≃ₐ[F] F')) := by
    have h : (y.ker : Set (F' ≃ₐ[F] F')) = y ⁻¹' ({1} : Set (Multiplicative (ZMod p))) := by
      ext x; simp [MonoidHom.mem_ker]
    rw [h]
    exact hy {1}
  obtain ⟨E, hEfin, hEsub⟩ :=
    (krullTopology_mem_nhds_one_iff F F' (y.ker : Set (F' ≃ₐ[F] F'))).mp
      (hopen.mem_nhds y.ker.one_mem)
  haveI := hEfin
  -- The subgroup generated by `Gal(F'/E)` and the commutators.
  let K : Subgroup (F' ≃ₐ[F] F') := E.fixingSubgroup ⊔ commutator (F' ≃ₐ[F] F')
  have hKopen : IsOpen (K : Set (F' ≃ₐ[F] F')) :=
    Subgroup.isOpen_mono le_sup_left E.fixingSubgroup_isOpen
  have hKclosed : IsClosed (K : Set (F' ≃ₐ[F] F')) := K.isClosed_of_isOpen hKopen
  -- A closed subgroup is the fixing subgroup of its fixed field.
  have hfixK : (IntermediateField.fixedField K).fixingSubgroup = K :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨K, hKclosed⟩
  -- `fixedField K` lies inside `A = fixedField (commutator G)` because `commutator G ≤ K`.
  have hle : IntermediateField.fixedField K ≤ A := by
    show IntermediateField.fixedField K ≤
      IntermediateField.fixedField (commutator (F' ≃ₐ[F] F'))
    exact IntermediateField.fixedField_le le_sup_right
  -- Hence the kernel of the restriction to `A` is contained in `K ≤ y.ker`.
  have hker_le_K : (AlgEquiv.restrictNormalHom (F := F) (K₁ := F') ↥A).ker ≤ K := by
    rw [IntermediateField.restrictNormalHom_ker A, ← hfixK]
    exact IntermediateField.fixingSubgroup_le hle
  have hker_le_ker : (AlgEquiv.restrictNormalHom (F := F) (K₁ := F') ↥A).ker ≤ y.ker :=
    hker_le_K.trans (sup_le hEsub hcomm)
  -- Factor `y` through the quotient by the kernel of the (surjective) restriction map.
  refine ⟨(MonoidHom.liftOfSurjective
      (AlgEquiv.restrictNormalHom (F := F) (K₁ := F') ↥A)
      (AlgEquiv.restrictNormalHom_surjective (F := F) (K₁ := ↥A) F')) ⟨y, hker_le_ker⟩, ?_⟩
  exact MonoidHom.liftOfRightInverse_comp _ _ _ ⟨y, hker_le_ker⟩

end Work.SSGRoute.ZDataMup
