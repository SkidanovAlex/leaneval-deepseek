/-!
# The norm group of a cycle is the set of relative norms of the coprime fractional ideals

`Work.SSGRoute.ZDataMup.Cycle.normGroupOf K L c cL` is the subgroup of the group `Frac K` of
fractional ideals of `K` generated by the relative norms of the *integral* ideals of `𝓞 L` which
are coprime to the cycle `cL`.  This module identifies it with the image of the subgroup
`Cycle.Icoprime cL` of fractional ideals of `L` coprime to `cL` under the relative norm
`NK.CFTLib.ARL.relNormUnit`:

    `𝔫 ∈ 𝔑(c, cL) ↔ ∃ A ∈ I(cL), N_{L/K} A = 𝔫`.

The two inclusions are proved separately:

* `normGroupOf_le_map_Icoprime` — every generator is the relative norm of the integral ideal it
  comes from, which is coprime to `cL` by `count_ne_zero_iff_dvd`, so it lies in the image;
* `map_Icoprime_le_normGroupOf` — a fractional ideal of `L` coprime to `cL` is a product of prime
  ideals outside `cL` (`Cycle.Icoprime_le_idealCoprimeGroup`), and the relative norm of such a prime
  is one of the generators (it is coprime to `cL` because `𝔮 ∉ cL.supp` and the primes are
  maximal).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 1000000

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain
open NK.GlobalCFT

noncomputable section

namespace Work.SSGRoute.ZDataMup

open NK.CFTLib.ArtinReciprocityIdeal

namespace Cycle

variable {K : Type} [Field K] [NumberField K]
variable {L : Type} [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]

/-- The relative norm of the fractional ideal attached to a nonzero integral ideal `I` is the
integral ideal `N I`, viewed as a fractional ideal. -/
theorem relNormUnit_idealUnit (I : Ideal (𝓞 L)) (hI : I ≠ ⊥) :
    NK.CFTLib.ARL.relNormUnit (K := K) (L := L) (idealUnit I hI) =
      Units.mk0 ((Ideal.relNorm (𝓞 K) I : Ideal (𝓞 K)) : FractionalIdeal (𝓞 K)⁰ K)
        (by rw [FractionalIdeal.coeIdeal_ne_zero]
            exact fun h => hI ((Ideal.relNorm_eq_bot_iff).mp h)) := by
  apply Units.ext
  simp only [Units.val_mk0]
  exact NK.CFTLib.ARL.relNormFI_coeIdeal (K := K) (L := L) I hI

/-- The relative norm of a prime ideal of `𝓞 L` which is **not** in the support of `cL` lies in
the norm group `𝔑(c, cL)`: it is one of the generators, since it has zero exponent at every prime
of `cL`. -/
theorem relNormUnit_prime_mem_normGroupOf (c : Cycle K) (cL : Cycle L)
    (𝔮 : HeightOneSpectrum (𝓞 L)) (h𝔮 : 𝔮 ∉ cL.supp) :
    NK.CFTLib.ARL.relNormUnit (K := K) (L := L) (idealUnit 𝔮.asIdeal 𝔮.ne_bot) ∈
      c.normGroupOf K L cL := by
  have hcop : ∀ 𝔮' : HeightOneSpectrum (𝓞 L), 𝔮' ∈ cL.supp → ¬ 𝔮'.asIdeal ∣ 𝔮.asIdeal := by
    intro 𝔮' h𝔮' hdvd
    have hne : 𝔮' ≠ 𝔮 := fun h => h𝔮 (h ▸ h𝔮')
    have h1 : 𝔮'.asIdeal.IsMaximal := Ring.DimensionLEOne.maximalOfPrime 𝔮'.ne_bot 𝔮'.isPrime
    have h2 : 𝔮.asIdeal.IsMaximal := Ring.DimensionLEOne.maximalOfPrime 𝔮.ne_bot 𝔮.isPrime
    have hle : 𝔮.asIdeal ≤ 𝔮'.asIdeal := Ideal.dvd_iff_le.mp hdvd
    have heq : 𝔮.asIdeal = 𝔮'.asIdeal := Ideal.IsMaximal.eq_of_le h2 h1.ne_top hle
    exact hne (HeightOneSpectrum.ext heq.symm)
  rw [normGroupOf, relNormUnit_idealUnit]
  refine Subgroup.subset_closure ?_
  exact ⟨⟨𝔮.asIdeal, 𝔮.ne_bot, hcop⟩, rfl⟩

/-- **`𝔑(c, cL) ≤ N(I(cL))`**: every generator of the norm group is the relative norm of the
integral ideal it comes from, which is coprime to `cL`. -/
theorem normGroupOf_le_map_Icoprime (c : Cycle K) (cL : Cycle L) :
    c.normGroupOf K L cL ≤
      (cL.Icoprime).map (NK.CFTLib.ARL.relNormUnit (K := K) (L := L)) := by
  rw [normGroupOf]
  refine (Subgroup.closure_le _).mpr ?_
  rintro A ⟨𝔅, rfl⟩
  obtain ⟨h𝔅ne, hcop⟩ := 𝔅.2
  refine Subgroup.mem_map.mpr ⟨idealUnit 𝔅.1 h𝔅ne, ?_, ?_⟩
  · change cL.FracCoprime (idealUnit 𝔅.1 h𝔅ne)
    intro 𝔮 h𝔮
    by_contra hc
    exact hcop 𝔮 h𝔮 ((count_ne_zero_iff_dvd (K := L) h𝔅ne 𝔮).mp hc)
  · exact relNormUnit_idealUnit 𝔅.1 h𝔅ne

/-- **`N(I(cL)) ≤ 𝔑(c, cL)`**: a fractional ideal of `L` coprime to `cL` is a product of primes
outside `cL`, and the relative norm of each of those is a generator of the norm group. -/
theorem map_Icoprime_le_normGroupOf (c : Cycle K) (cL : Cycle L) :
    (cL.Icoprime).map (NK.CFTLib.ARL.relNormUnit (K := K) (L := L)) ≤ c.normGroupOf K L cL := by
  rw [Subgroup.map_le_iff_le_comap]
  refine le_trans (Icoprime_le_idealCoprimeGroup cL) ?_
  rw [idealCoprimeGroup, Subgroup.closure_le]
  rintro A ⟨𝔮, h𝔮, rfl⟩
  exact Subgroup.mem_comap.mpr (relNormUnit_prime_mem_normGroupOf c cL 𝔮 h𝔮)

/-- **The norm group of a cycle is the image of the coprime fractional ideals under the relative
norm.** -/
theorem normGroupOf_eq_map_Icoprime (c : Cycle K) (cL : Cycle L) :
    c.normGroupOf K L cL =
      (cL.Icoprime).map (NK.CFTLib.ARL.relNormUnit (K := K) (L := L)) :=
  le_antisymm (normGroupOf_le_map_Icoprime c cL) (map_Icoprime_le_normGroupOf c cL)

end Cycle

theorem cycleMemNormGroupOf_iff
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L]
    (c : Work.SSGRoute.ZDataMup.Cycle K) (cL : Work.SSGRoute.ZDataMup.Cycle L)
    (𝔫 : NK.CFTLib.ArtinReciprocityIdeal.Frac K) :
    𝔫 ∈ Work.SSGRoute.ZDataMup.Cycle.normGroupOf K L c cL ↔ ∃ A ∈ Work.SSGRoute.ZDataMup.Cycle.Icoprime cL,
      NK.CFTLib.ARL.relNormUnit (K := K) (L := L) A = 𝔫 := by
  rw [Cycle.normGroupOf_eq_map_Icoprime]
  exact Subgroup.mem_map

end Work.SSGRoute.ZDataMup
