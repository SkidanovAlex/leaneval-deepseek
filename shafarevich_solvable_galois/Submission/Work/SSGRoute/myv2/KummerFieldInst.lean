/-!
# Instances for the Kummer fields `↥K⟮x^{1/p}⟯`

For the level `E = M ⊔ F_a ⊔ F_{c₁} ⊔ F_{c₂} ⊔ F_{b_g}` of the `hsplit` orthogonality one needs,
for each Kummer field `F_x = NK.LocalAnabelian.kummerField p x`, that it is finite dimensional,
Galois, and has an **abelian** Galois group of exponent `p` over `↥K` (all so that the compositum
is abelian of exponent `p`, via `myv2/sup_isMulCommutative` and `myv2/sup_pow_eq_one`, and so that
the idèlic Artin map of the compositum exists).

`F_x/↥K` is generated by a `p`-th root of `x`, so its degree is `1` or `p`; in the second case its
Galois group has prime order `p`, hence is cyclic, hence abelian of exponent `p`; in the first case
it is trivial.  The degree is `p` exactly when `x ∉ (↥Kˣ)^p`
(`NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank`), and when `x = y^p` the canonical root
`kummerSqrtZMod p x` differs from `y` by a `p`-th root of unity, hence lies in `↥K`.
-/

open scoped NumberField
open NumberField IsDedekindDomain

namespace Work.SSGRoute.N2v2

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
  [IsAlgClosed Ω]

/-- The Kummer field of `x` is `⊥` when `x` is a `p`-th power in `↥K`. -/
theorem kummerField_eq_bot_of_mem_powSubgroup (p : ℕ) [Fact p.Prime]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (x : (↥K)ˣ)
    (hx : x ∈ NK.LocalAnabelian.powSubgroup p ↥K) :
    NK.LocalAnabelian.kummerField (K' := Ω) p x = ⊥ := by
  classical
  haveI hAlgK : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI hSepK : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  obtain ⟨y, hy⟩ : ∃ y : (↥K)ˣ, y ^ p = x := by
    rw [NK.LocalAnabelian.powSubgroup, MonoidHom.mem_range] at hx
    obtain ⟨y, hy⟩ := hx
    exact ⟨y, by rwa [powMonoidHom_apply] at hy⟩
  set α : Ω := Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p x with hαdef
  have hα : α ^ p = algebraMap ↥K Ω (x : ↥K) := Work.SSGRoute.kummerSqrtZMod_pow (Ω := Ω) p x
  have hαK : α ∈ K := by
    have hyΩ : (algebraMap ↥K Ω (y : ↥K)) ^ p = algebraMap ↥K Ω (x : ↥K) := by
      rw [← map_pow]
      exact congrArg (fun u : (↥K)ˣ => algebraMap ↥K Ω (u : ↥K)) hy
    have hpow : (α / algebraMap ↥K Ω (y : ↥K)) ^ p = 1 := by
      rw [div_pow, hα, hyΩ, div_self]
      exact (map_ne_zero (algebraMap ↥K Ω)).mpr x.ne_zero
    obtain ⟨i, -, hi⟩ := IsPrimitiveRoot.eq_pow_of_pow_eq_one
      (hζ.map_of_injective (algebraMap ↥K Ω).injective) hpow
    have hy0 : algebraMap ↥K Ω (y : ↥K) ≠ 0 := (map_ne_zero _).mpr y.ne_zero
    have hαeq : α = algebraMap ↥K Ω (ζ ^ i * (y : ↥K)) := by
      calc α = (α / algebraMap ↥K Ω (y : ↥K)) * algebraMap ↥K Ω (y : ↥K) :=
            (div_mul_cancel₀ _ hy0).symm
        _ = (algebraMap ↥K Ω ζ) ^ i * algebraMap ↥K Ω (y : ↥K) := by rw [hi]
        _ = algebraMap ↥K Ω (ζ ^ i * (y : ↥K)) := by simp [map_mul, map_pow]
    rw [hαeq]
    change ((ζ ^ i * (y : ↥K) : ↥K) : Ω) ∈ K
    exact (ζ ^ i * (y : ↥K)).2
  rw [NK.UchidaKummer.Kummer.kummerField_eq_adjoin_simple p Fact.out hζ x hα]
  refine le_antisymm ?_ bot_le
  rw [IntermediateField.adjoin_simple_le_iff, IntermediateField.mem_bot]
  exact ⟨⟨α, hαK⟩, rfl⟩

/-- The Galois group of the Kummer field of `x` has order `1` or `p`. -/
theorem kummerField_card_aut (p : ℕ) [Fact p.Prime]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (x : (↥K)ˣ) :
    Nat.card (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
        ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) = 1 ∨
      Nat.card (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
        ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) = p := by
  classical
  haveI hAlgK : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI hSepK : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  haveI hfd : FiniteDimensional ↥K (NK.LocalAnabelian.kummerField (K' := Ω) p x) :=
    NK.GlobalCFTdeep.SecondInequality.finiteDimensional_kummerField (K' := Ω) (p := p) Fact.out hζ x
  by_cases hx : x ∈ NK.LocalAnabelian.powSubgroup p ↥K
  · left
    rw [kummerField_eq_bot_of_mem_powSubgroup p K ζ hζ x hx]
    rw [IsGalois.card_aut_eq_finrank ↥K ↥(⊥ : IntermediateField ↥K Ω)]
    simp
  · right
    have h := NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank (K' := Ω) p Fact.out hζ
      (k := ↥K) x hx
    haveI : IsGalois ↥K (NK.LocalAnabelian.kummerField (K' := Ω) p x) := h.1
    rw [IsGalois.card_aut_eq_finrank ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)]
    exact h.2

/-- **`Gal(↥K⟮x^{1/p}⟯/↥K)` is commutative** (it is cyclic of order `1` or `p`). -/
theorem kummerField_isMulCommutative (p : ℕ) [Fact p.Prime]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (x : (↥K)ˣ) :
    IsMulCommutative (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) := by
  classical
  haveI hAlgK : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI hSepK : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  haveI hfd : FiniteDimensional ↥K (NK.LocalAnabelian.kummerField (K' := Ω) p x) :=
    NK.GlobalCFTdeep.SecondInequality.finiteDimensional_kummerField (K' := Ω) (p := p) Fact.out hζ x
  haveI hFintype : Fintype (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) :=
    AlgEquiv.fintype ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)
  haveI hFin : Finite (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) := Finite.of_fintype _
  rcases kummerField_card_aut p K ζ hζ x with h1 | hp
  · haveI : Subsingleton (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
        ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) :=
      Finite.card_le_one_iff_subsingleton.mp (by rw [h1])
    exact IsMulCommutative.of_comm fun a b => Subsingleton.elim _ _
  · haveI : IsCyclic (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
        ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) := isCyclic_of_prime_card hp
    exact IsCyclic.isMulCommutative

/-- **`Gal(↥K⟮x^{1/p}⟯/↥K)` has exponent `p`.** -/
theorem kummerField_pow_eq_one (p : ℕ) [Fact p.Prime]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (x : (↥K)ˣ)
    (σ : ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) : σ ^ p = 1 := by
  classical
  haveI hAlgK : IsAlgClosure ↥K Ω := ⟨IsAlgClosure.isAlgClosed k, inferInstance⟩
  haveI hSepK : IsSepClosure ↥K Ω := IsSepClosure.of_isAlgClosure_of_perfectField ↥K Ω
  haveI hfd : FiniteDimensional ↥K (NK.LocalAnabelian.kummerField (K' := Ω) p x) :=
    NK.GlobalCFTdeep.SecondInequality.finiteDimensional_kummerField (K' := Ω) (p := p) Fact.out hζ x
  haveI hFintype : Fintype (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) :=
    AlgEquiv.fintype ↥K ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)
  haveI hFin : Finite (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) := Finite.of_fintype _
  rcases kummerField_card_aut p K ζ hζ x with h1 | hp
  · haveI : Subsingleton (↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
        ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) :=
      Finite.card_le_one_iff_subsingleton.mp (by rw [h1])
    exact Subsingleton.elim _ _
  · have h := pow_card_eq_one' (G := ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x) ≃ₐ[↥K]
      ↥(NK.LocalAnabelian.kummerField (K' := Ω) p x)) (x := σ)
    rw [hp] at h
    exact h

end Work.SSGRoute.N2v2
