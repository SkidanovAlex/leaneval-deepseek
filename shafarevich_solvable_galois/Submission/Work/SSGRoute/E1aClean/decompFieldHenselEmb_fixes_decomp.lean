/-!
# The henselisation embedding fixes the decomposition field under the local action

The two auxiliary lemmas below (the `k`-level range statement `exists_algebraMap_eq_coInAdjoin_…`
and the `k_v`-linearity of `localAutHom`, `localAutHom_fixes_algebraMap_localFieldAt`) are the
pieces of the proof of the arithmetical input `hfix` of
`Work.SSGRoute.E1aClean.henselEmb_equivariant`:

* an element `x ∈ k^h = Ω^{D_A}` has, inside the completion `K_q`, an image which is the image of
  an element of the base completion `k_v = 𝔭.adicCompletion k` (see also the equivalently stated
  `E1aClean.decompFieldHenselEmb_spec`);
* `localAutHom τ` fixes the image of `k_v` in `K_q` pointwise, since the action of the
  decomposition group on the completion is `k_v`-linear
  (`Commons.NumberTheory.NumberField.Completion.decompositionToAdicCompletion_adicCompletionMap`).

The final theorem combines them, the comparison `Work.SSGRoute.adicCompletionToPlaceCompletion_comp`
of the two routes `k_v → K_q → Ω_A` and `k_v → Ω_A` and the injectivity of
`k_v.adicCompletion ↥K → Ω_A`.
-/

namespace Work.SSGRoute.E1aClean

open CategoryTheory SSGRoute.PTExt
open scoped Pointwise

noncomputable section

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1600000

/-- **The `k`-level range statement**: an element `x ∈ k^h = Ω^{D_A}` has its image `coInAdjoin x`
in the subfield of the completion generated by the *base* completion `k_v = 𝔭.adicCompletion k` and
the image of `Ω`.

This is `coInAdjoin_mem_range_algebraMap_of_forall_fixed` with the base field `↥K` replaced by `k`
(the proof is the same one: `coInAdjoin x` is fixed by `Gal(M/k_v) ≅ D_A`, because `x` is fixed by
`D_A` and the action on the image of `Ω` is the Galois action
`NK.NeukirchUchida.decompositionToAdjoin_coInAdjoin`). -/
theorem exists_algebraMap_eq_coInAdjoin_of_forall_fixed
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    [inst : Algebra ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
      (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : (Work.SSGRoute.primeUnder k A hA).adicCompletion k,
      algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
          (NK.NeukirchUchida.placeCompletion A) z =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion (Work.SSGRoute.primeUnder k A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA) z)
    (hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
        (NK.NeukirchUchida.adicCompletionToPlaceCompletion (Work.SSGRoute.primeUnder k A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA)) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers k (Work.SSGRoute.primeUnder k A hA))
    (x : Ω) (hx : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ SSGRoute.decomp k A → σ x = x) :
    ∃ z : (Work.SSGRoute.primeUnder k A hA).adicCompletion k,
      algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
          ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
            (Work.SSGRoute.primeUnder k A hA) A) z =
        NK.NeukirchUchida.coInAdjoin (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A x := by
  haveI hsep : IsSepClosure ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A) :=
    NK.Mine.isSepClosure_adjoinPlaceCompletion (Work.SSGRoute.primeUnder k A hA) A
      (Submission.NeukirchUchida.primeOf_spec A hA) halg
  haveI : IsGalois ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A) := inferInstance
  refine (InfiniteGalois.mem_range_algebraMap_iff_fixed
    (NK.NeukirchUchida.coInAdjoin (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A x)).mpr ?_
  intro f
  obtain ⟨σ, rfl⟩ := (NK.Mine.adjoinLocalEquiv (Work.SSGRoute.primeUnder k A hA) A
    (Submission.NeukirchUchida.primeOf_spec A hA) halg hW).surjective f
  rw [NK.Mine.adjoinLocalEquiv_apply, NK.NeukirchUchida.decompositionToAdjoin_coInAdjoin]
  exact congrArg (NK.NeukirchUchida.coInAdjoin (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A)
    (hx σ.1 σ.2)

/-- **`localAutHom` fixes the image of the base completion**: for `τ` in the decomposition group
`D_q ≤ Gal(K/k)` and `c` in the base completion `k_v = 𝔭.adicCompletion k` (where `𝔭` is the prime
of `k` below `A`, and `q` lies over `𝔭`), the local automorphism `localAutHom τ` of `K_q` fixes the
image of `c` in `K_q`.

The action of `D_q` on `K_q` is the action of the decomposition group on the completion
(`Work.SSGRoute.localAutHom_eq_isoLocalGalois`), which is by `k_v`-algebra automorphisms
(`Commons.NumberTheory.NumberField.Completion.decompositionToAdicCompletion_adicCompletionMap`). -/
theorem localAutHom_fixes_algebraMap_localFieldAt
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [NumberField K]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hLies : q.asIdeal.LiesOver (Work.SSGRoute.primeUnder k A hA).asIdeal)
    [inst : Algebra ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K)]
    (halg : ∀ c : (Work.SSGRoute.primeUnder k A hA).adicCompletion k,
      algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) c =
        Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies c) :
    ∀ (τ : ↥(SSGRoute.PTExt.decompK (k := k) (NK.GlobalCFT.Place.ofFinite q)))
      (c : (Work.SSGRoute.primeUnder k A hA).adicCompletion k),
      NK.HassePrinciple.localAutHom (K := k) (L := ↥K) (NK.GlobalCFT.Place.ofFinite q) τ
          (algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) c)
        = algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) c := by
  intro τ c
  have hmap : (algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) :
      (Work.SSGRoute.primeUnder k A hA).adicCompletion k →+* q.adicCompletion ↥K) =
      Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies := RingHom.ext halg
  rw [hmap]
  rw [Work.SSGRoute.localAutHom_eq_isoLocalGalois (K := k) (L := ↥K)
    (Work.SSGRoute.primeUnder k A hA) q hLies τ]
  rw [NK.GlobalCFTdeep.decompositionSubgroupIsoLocalGalois_apply (K := k) (L := ↥K)
    (Work.SSGRoute.primeUnder k A hA) q hLies τ]
  exact Commons.NumberTheory.NumberField.Completion.decompositionToAdicCompletion_adicCompletionMap
    (K := k) (L := ↥K) (Work.SSGRoute.primeUnder k A hA) q hLies _ c

/-- **The canonical embedding of the henselisation into the completion fixes the decomposition
field under the local action** — the arithmetic input `hfix` of
`Work.SSGRoute.E1aClean.henselEmb_equivariant`.

`decompFieldHenselEmb k Ω K A hA q hAq halg : K^h →+* K_q` is the canonical embedding constructed
(and characterised by `decompFieldHenselEmb_spec`, `algebraMap (φ x) = coInAdjoin x`) in
`E1aClean/decompFieldHenselEmb.lean`.  The claim is that its image of the decomposition field
`k^h = Ω^{D_A}` is pointwise fixed by the local action `localAutHom τ` of `D_q` on `K_q` — i.e.
`φ(k^h) ⊆ k_v`, the completion of `k` at the place below `A`.

Together with `Work.SSGRoute.E1aClean.henselEmb_equivariant` this makes
`Units.map φ : (K^h)ˣ → K_qˣ` a morphism of `D_q`-representations, which is the coefficient push
`(PUSH)` of `Work.SSGRoute.E1aClean.localDictionary_natural_family`.

Route.  `coInAdjoin x` for `x ∈ k^h` is fixed by every `adjoinLocalEquiv σ` (`σ ∈ D_A`), because
`coInAdjoin` is `D_A`-equivariant (`NK.Mine.decompositionToAdjoin_coInAdjoin`; see also
`Work.SSGRoute.localGaloisEquiv_coInAdjoin_compat_general`).  The remaining step — the only
non-trivial one, per the two reviewers of this statement — is the compatibility of the two actions
on `adjoinPlaceCompletion`: for `σ ∈ D_A` whose image in `D_q = D_A·G_K/G_K` is `τ`
(`Work.SSGRoute.E1aClean.decomp_map_res_eq_decompK`,
`exists_res_eq_of_mem_decompK`), the automorphism `adjoinLocalEquiv σ` agrees on the image of
`q.adicCompletion ↥K` with `localAutHom τ`; then `algebraMap (φ x)` is `localAutHom τ`-fixed and
injectivity of `algebraMap (q.adicCompletion ↥K) (adjoinPlaceCompletion …)` gives the claim.
Equivalently: the completion of the decomposition field is the completion of `k`.  Nearby on disk:
the `κ = k_v`-linearity form in `Submission/Work/SSGRoute/PT/completionFixedField.lean`
(`adjoinLocalEquiv σ` is linear over the completion of the base) and
`Work.SSGRoute.PT.mem_fixedField_of_coInAdjoin_mem_range` (the converse direction).  Useful glue:
`NK.Mine.adjoinLocalEquiv`, `NK.Mine.adjoinLocalEquiv_apply`,
`NK.NeukirchUchida.decompositionToAdjoin_coInAdjoin`. -/
theorem decompFieldHenselEmb_fixes_decomp
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [NumberField K]
    [IsSepClosure ↥K Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hAq : ∀ x : NumberField.RingOfIntegers K,
      x ∈ q.asIdeal ↔ A.valuation (((x : K) : Ω)) < 1)
    [inst : Algebra (q.adicCompletion ↥K) (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : q.adicCompletion ↥K,
      algebraMap (q.adicCompletion ↥K) (NK.NeukirchUchida.placeCompletion A) z =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion q A
          (Work.SSGRoute.place_comap_valuationSubringAtPrime k Ω K A hA q hAq) z) :
    ∀ (τ : ↥(SSGRoute.PTExt.decompK (k := k) (NK.GlobalCFT.Place.ofFinite q)))
      (x : ↥(Work.SSGRoute.E1aClean.decompField k Ω A)),
      NK.HassePrinciple.localAutHom (K := k) (L := ↥K) (NK.GlobalCFT.Place.ofFinite q) τ
          (Work.SSGRoute.E1aClean.decompFieldHenselEmb k Ω K A hA q hAq halg
            ⟨(x : Ω), Work.SSGRoute.E1aClean.decompField_le_henselField k Ω K A x.2⟩)
        = Work.SSGRoute.E1aClean.decompFieldHenselEmb k Ω K A hA q hAq halg
            ⟨(x : Ω), Work.SSGRoute.E1aClean.decompField_le_henselField k Ω K A x.2⟩ := by
  classical
  intro τ x
  -- the prime of `K` below `A` and the prime of `k` below `A`
  have hAqK : A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K q :=
    Work.SSGRoute.place_comap_valuationSubringAtPrime k Ω K A hA q hAq
  have hAp : A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k (Work.SSGRoute.primeUnder k A hA) :=
    Submission.NeukirchUchida.primeOf_spec A hA
  -- `q` lies over the prime of `k` cut out by `A`
  obtain ⟨hLies, -⟩ := Work.SSGRoute.exists_adicCompletion_algebra_compat k Ω K A hA q hAq
  -- the two `k_v`-algebra structures: on the completion of `Ω` and on the completion of `K`
  letI : Algebra ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
      (NK.NeukirchUchida.placeCompletion A) :=
    (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
      (Work.SSGRoute.primeUnder k A hA) A hAp).toAlgebra
  letI : Algebra ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) :=
    (Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies).toAlgebra
  have hW : (NK.NeukirchUchida.placeCompletionIntegers A).comap
      (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A hAp) =
      IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers k (Work.SSGRoute.primeUnder k A hA) :=
    NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers
      (Work.SSGRoute.primeUnder k A hA) A hAp
  -- ## the image of `x` in the completion is the image of an element of the base completion
  obtain ⟨z, hz⟩ := exists_algebraMap_eq_coInAdjoin_of_forall_fixed k Ω A hA
    (halg := fun _ => rfl) hW (x : Ω)
    ((IntermediateField.mem_fixedField_iff (SSGRoute.decomp k A) (x : Ω)).mp x.2)
  have hzC : NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
      (Work.SSGRoute.primeUnder k A hA) A hAp z =
      NK.NeukirchUchida.placeCompletionCoe A (x : Ω) := by
    have h := congrArg (fun w : ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
      (Work.SSGRoute.primeUnder k A hA) A) => (w : NK.NeukirchUchida.placeCompletion A)) hz
    rw [NK.NeukirchUchida.coe_coInAdjoin] at h
    rw [show ((algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
        ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
          (Work.SSGRoute.primeUnder k A hA) A) z :
        NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
          (Work.SSGRoute.primeUnder k A hA) A) : NK.NeukirchUchida.placeCompletion A) =
      algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
        (NK.NeukirchUchida.placeCompletion A) z from rfl] at h
    rw [show (algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k)
        (NK.NeukirchUchida.placeCompletion A)) =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
          (Work.SSGRoute.primeUnder k A hA) A hAp from rfl] at h
    exact h
  -- ## `φ x` is that element of the base completion
  have hmapK : (algebraMap (q.adicCompletion ↥K) (NK.NeukirchUchida.placeCompletion A)) =
      NK.NeukirchUchida.adicCompletionToPlaceCompletion q A hAqK := RingHom.ext halg
  have hspecC : NK.NeukirchUchida.adicCompletionToPlaceCompletion q A hAqK
      ((decompFieldHenselEmb k Ω K A hA q hAq halg)
        ⟨(x : Ω), decompField_le_henselField k Ω K A x.2⟩) =
      NK.NeukirchUchida.placeCompletionCoe A (x : Ω) := by
    have h := congrArg (fun w : ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := ↥K) (K' := Ω) q A) =>
      (w : NK.NeukirchUchida.placeCompletion A))
      (decompFieldHenselEmb_spec k Ω K A hA q hAq halg ⟨(x : Ω), decompField_le_henselField k Ω K A x.2⟩)
    rw [NK.NeukirchUchida.coe_coInAdjoin] at h
    rw [show ((algebraMap (q.adicCompletion ↥K)
        ↥(NK.NeukirchUchida.adjoinPlaceCompletion (K := ↥K) (K' := Ω) q A)
        ((decompFieldHenselEmb k Ω K A hA q hAq halg)
          ⟨(x : Ω), decompField_le_henselField k Ω K A x.2⟩) :
        NK.NeukirchUchida.adjoinPlaceCompletion (K := ↥K) (K' := Ω) q A) :
        NK.NeukirchUchida.placeCompletion A) =
      algebraMap (q.adicCompletion ↥K) (NK.NeukirchUchida.placeCompletion A)
        ((decompFieldHenselEmb k Ω K A hA q hAq halg)
          ⟨(x : Ω), decompField_le_henselField k Ω K A x.2⟩) from rfl] at h
    rw [hmapK] at h
    exact h
  have hφ : (decompFieldHenselEmb k Ω K A hA q hAq halg)
        ⟨(x : Ω), decompField_le_henselField k Ω K A x.2⟩ =
      algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K) z := by
    apply RingHom.injective (NK.NeukirchUchida.adicCompletionToPlaceCompletion q A hAqK)
    rw [hspecC]
    rw [show (algebraMap ((Work.SSGRoute.primeUnder k A hA).adicCompletion k) (q.adicCompletion ↥K)) =
        Work.SSGRoute.adicCompletionMapAt k Ω K A hA q hLies from rfl]
    exact hzC.symm.trans (RingHom.congr_fun
      (Work.SSGRoute.adicCompletionToPlaceCompletion_comp k Ω K A hA q hAq hAqK hLies) z).symm
  -- ## the local action fixes it
  rw [hφ]
  exact localAutHom_fixes_algebraMap_localFieldAt k Ω K A hA q hLies (halg := fun _ => rfl) τ z

end

end Work.SSGRoute.E1aClean
