/-!
# `akToGCH2` at a finite subgroup: the two cohomology models agree at `⟨σ⟩`

The continuous model `Work.AbsoluteKummer.H2` and the abstract model `Work.GroupCohomology.H2` are
compared by the forgetful map `Work.SSGRoute.PT.akToGCH2`.  For a *profinite* subgroup (e.g. a
decomposition group `D_A`) this map is **not** injective — that is the E1a lane's node
`PT.akToGCH2_injective_decompFin` and the source of the `D_A`/`D_w` fork.  For a **finite**
subgroup (e.g. the group `⟨σ⟩` generated by an involution, which is what the archimedean local
comparison of node `E1a` uses) it *is*: a finite subgroup of a Hausdorff topological group is
discrete, hence `C¹_c = C²_c = ⊤` and the two models coincide (the general statement is
`Work.SSGRoute.Sha2Lib.akToGCH2_bijective`).

This file supplies the missing instance (`DiscreteTopology ↥(Subgroup.zpowers σ)` for `σ² = 1`),
hence `Function.Injective (akToGCH2 ↥(Subgroup.zpowers σ) E)`.

**Why it is needed.**  `Work.SSGRoute.SSGStage.archimedeanLocalDictionary` states its
compatibility clause with the hypothesis in the *abstract* model,
`GroupCohomology.resH2 ⟨σ⟩ (akToGCH2 (e1aChainC y)) = 0`, while every proved brick around it
(`ExtChain.resH1_zpowers_e1cMap_eq_zero_of_resH2_e1aChainH_eq_zero`,
`AbsoluteKummer.akToGCH2_akRes`) and every available input
(`PT.e1aBetaCan_akRes_eq_zero`) lives in the *continuous* model, `akRes_{⟨σ⟩} (e1aChainC y) = 0`.
Injectivity of `akToGCH2` at `⟨σ⟩` is exactly what converts the dictionary's hypothesis into the
usable `akRes` form (via `AbsoluteKummer.akToGCH2_akRes`).
-/

namespace Work.SSGRoute.PTdualControl

open Work

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]

/-- **The group generated by an involution is finite**: it is contained in `{1, σ}`. -/
theorem finite_set_zpowers_of_sq_eq_one (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) :
    ((Subgroup.zpowers σ : Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)).Finite := by
  have hσz : σ ^ (2 : ℤ) = 1 := by rw [zpow_ofNat]; exact hσ
  refine Set.Finite.subset (Set.toFinite ({1, σ} : Set (Ω ≃ₐ[k] Ω))) ?_
  intro x hx
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx
  rcases Int.even_or_odd n with ⟨m, hm⟩ | ⟨m, hm⟩
  · rw [hm, show m + m = 2 * m from by ring, zpow_mul, hσz, one_zpow]
    simp
  · rw [hm, zpow_add, zpow_mul, hσz, one_zpow, one_mul, zpow_one]
    simp

/-- The group generated by an involution is a finite group. -/
theorem finite_zpowers_of_sq_eq_one (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) :
    Finite ↥(Subgroup.zpowers σ) :=
  (finite_set_zpowers_of_sq_eq_one (k := k) (Ω := Ω) σ hσ).to_subtype

/-- **`⟨σ⟩` is closed in `Ω ≃ₐ[k] Ω`** (a finite subset of a Hausdorff space is compact, hence
closed).  This is the hypothesis `IsClosed` of the chain reduction
`SSGStage.resH1_e1cEquiv_eq_zero_of_akRes_e1aChainC_eq_zero` at the involution `⟨σ⟩`. -/
theorem isClosed_zpowers (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) :
    IsClosed ((Subgroup.zpowers σ : Subgroup (Ω ≃ₐ[k] Ω)) : Set (Ω ≃ₐ[k] Ω)) :=
  (finite_set_zpowers_of_sq_eq_one (k := k) (Ω := Ω) σ hσ).isCompact.isClosed

/-- **A finite subgroup of the Hausdorff group `Ω ≃ₐ[k] Ω` is discrete.** -/
theorem discreteTopology_zpowers (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) :
    DiscreteTopology ↥(Subgroup.zpowers σ) := by
  have := finite_zpowers_of_sq_eq_one (k := k) (Ω := Ω) σ hσ
  infer_instance

/-- **`akToGCH2` is injective at the group generated by an involution.**  Consequently the
continuous and abstract models of `H²(⟨σ⟩, E)` agree, and the `akToGCH2`-tainted hypothesis of
`SSGStage.archimedeanLocalDictionary` is equivalent to its `akRes` form. -/
theorem akToGCH2_injective_zpowers (E : Type) [AddCommGroup E]
    [DistribMulAction (Ω ≃ₐ[k] Ω) E] (σ : Ω ≃ₐ[k] Ω) (hσ : σ ^ 2 = 1) :
    Function.Injective (Work.SSGRoute.PT.akToGCH2 ↥(Subgroup.zpowers σ) E) := by
  have := discreteTopology_zpowers (k := k) (Ω := Ω) σ hσ
  exact (Work.SSGRoute.Sha2Lib.akToGCH2_bijective (G := ↥(Subgroup.zpowers σ)) (M := E)).1

end Work.SSGRoute.PTdualControl
