/-!
# `Ẑ` is generated by `zhatGen` together with the `n`-th powers

Let `Ẑ = NK.LocalAnabelian.Zhat` be the profinite completion of `ℤ`, let
`NK.TowerRank.zhatGen = zEta 1` be its canonical topological generator and let
`NK.TowerRank.powSubgroup n = Ẑ ^ n = {x ^ n : x ∈ Ẑ}` be the subgroup of `n`-th powers.

The main result of this file is

  `Work.SSGRoute.zpowers_zhatGen_sup_powSubgroup`:
  `Subgroup.zpowers zhatGen ⊔ powSubgroup n = ⊤` for every `n > 0`,

i.e. **every element of `Ẑ` is a product of a power of the canonical generator and an `n`-th
power**.  This is the group-theoretic statement that the quotient `Ẑ ⧸ Ẑ ^ n` is generated by the
class of `zhatGen` (it is cyclic of order `n`).

## The mathematics

For `n > 0` the `n`-th component map
`NK.TameStructureDeep.Degree.compHomZMod n hn : Ẑ →* Multiplicative (ZMod n)` has kernel
`Ẑ ^ n` (`ker_compHomZMod_eq_powSubgroup`) and sends the canonical generator to `ofAdd 1`
(`compHomZMod_zhatGen`).  Given `x ∈ Ẑ`, let `a = toAdd (compHomZMod n hn x) ∈ ZMod n` and let
`m = a.val ∈ ℕ` be a lift of `a` to `ℤ`.  Then

`compHomZMod n hn (x * (zhatGen ^ m)⁻¹) = ofAdd a * ofAdd a⁻¹ = 1`,

so `x * (zhatGen ^ m)⁻¹ ∈ Ẑ ^ n`; since `x = zhatGen ^ m * (x * (zhatGen ^ m)⁻¹)` (`Ẑ` is
commutative), `x` lies in the sup.
-/

namespace Work.SSGRoute

set_option linter.style.haveILetI false

theorem zpowers_zhatGen_sup_powSubgroup (n : ℕ) (hn : 0 < n) :
    Subgroup.zpowers NK.TowerRank.zhatGen ⊔ NK.TowerRank.powSubgroup n = ⊤ := by
  have hnne : n ≠ 0 := hn.ne'
  haveI : NeZero n := ⟨hnne⟩
  -- the `n`-th component map kills exactly the `n`-th powers, and sends `zhatGen` to `ofAdd 1`
  have hker : (NK.TameStructureDeep.Degree.compHomZMod n hnne).ker =
      NK.TowerRank.powSubgroup n :=
    NK.TameStructureDeep.Degree.ker_compHomZMod_eq_powSubgroup n hnne
  rw [eq_top_iff]
  intro x _
  -- a lift `m : ℤ` of the `n`-th component of `x`
  set m : ℤ := ((Multiplicative.toAdd
      (NK.TameStructureDeep.Degree.compHomZMod n hnne x)).val : ℤ) with hm
  -- the complementary factor is an `n`-th power
  have hmem : x * (NK.TowerRank.zhatGen ^ m)⁻¹ ∈ NK.TowerRank.powSubgroup n := by
    rw [← hker, MonoidHom.mem_ker, map_mul, map_inv, map_zpow,
      NK.TameStructureDeep.Degree.compHomZMod_zhatGen]
    rw [show (Multiplicative.ofAdd (1 : ZMod n)) ^ m
        = Multiplicative.ofAdd ((m : ℤ) : ZMod n) from by
      rw [← ofAdd_zsmul, zsmul_eq_mul, mul_one]]
    rw [hm, Int.cast_natCast, ZMod.natCast_zmod_val]
    exact mul_inv_cancel _
  -- `x = zhatGen ^ m * (x * (zhatGen ^ m)⁻¹)`, and both factors lie in the sup
  rw [show x = NK.TowerRank.zhatGen ^ m * (x * (NK.TowerRank.zhatGen ^ m)⁻¹) from by
    rw [← mul_assoc, mul_comm (NK.TowerRank.zhatGen ^ m) x, mul_assoc,
      mul_inv_cancel, mul_one]]
  exact Subgroup.mul_mem _
    (Subgroup.mem_sup_left (Subgroup.zpow_mem_zpowers NK.TowerRank.zhatGen m))
    (Subgroup.mem_sup_right hmem)

end Work.SSGRoute
