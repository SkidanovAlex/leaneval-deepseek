open _root_.SSGRoute
open scoped Pointwise

/-- The value at `1` of a `1`-cocycle on all of `Γ` is `0`. -/
private theorem isCocycleOn_apply_one_aux {Γ G M : Type} [Group Γ] [Group G]
    [AddCommGroup M] [DistribMulAction G M] {act : Γ →* G} {f : Γ → M}
    (hf : SSGRoute.IsCocycleOn act ⊤ f) : f 1 = 0 := by
  have h := hf 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
  simp only [mul_one, map_one, one_smul] at h
  exact add_left_cancel (show f 1 + f 1 = f 1 + 0 by rw [add_zero]; exact h.symm)

/-- A `1`-cocycle that vanishes on a set of generators vanishes on the subgroup they generate. -/
private theorem eq_zero_on_closure_of_eq_zero {Γ G M : Type} [Group Γ] [Group G]
    [AddCommGroup M] [DistribMulAction G M] (act : Γ →* G) {f : Γ → M}
    (hf : SSGRoute.IsCocycleOn act ⊤ f) {S : Set Γ} (hS : ∀ s ∈ S, f s = 0) :
    ∀ g ∈ Subgroup.closure S, f g = 0 := by
  have h1 : f 1 = 0 := isCocycleOn_apply_one_aux hf
  intro g hg
  refine Subgroup.closure_induction (p := fun y _ => f y = 0) (fun y hy => hS y hy) h1 ?_ ?_ hg
  · intro y z _ _ hy hz
    rw [hf y (Subgroup.mem_top y) z (Subgroup.mem_top z), hy, hz, smul_zero, add_zero]
  · intro y _ hy
    have h := hf y (Subgroup.mem_top y) y⁻¹ (Subgroup.mem_top y⁻¹)
    rw [mul_inv_cancel, h1, hy, zero_add] at h
    have h2 : act y • f y⁻¹ = 0 := h.symm
    have h3 := congrArg (fun m => (act y)⁻¹ • m) h2
    simpa [← mul_smul, ← map_mul] using h3

/-- The subgroup of `G_k` generated by the inertia elements of the finite place `B` is normalised
by the decomposition group `D_B` of `B`. -/
private theorem conj_mem_closure_inertia {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    (B : ValuationSubring Ω) (δ : Ω ≃ₐ[k] Ω) (hδ : δ ∈ SSGRoute.decomp k B)
    {b : Ω ≃ₐ[k] Ω}
    (hb : b ∈ Subgroup.closure {σ : Ω ≃ₐ[k] Ω | SSGRoute.IsInertia k B σ}) :
    δ * b * δ⁻¹ ∈ Subgroup.closure {σ : Ω ≃ₐ[k] Ω | SSGRoute.IsInertia k B σ} := by
  have hδB : δ • B = B := MulAction.mem_stabilizer_iff.mp hδ
  refine Subgroup.closure_induction (p := fun y _ =>
    δ * y * δ⁻¹ ∈ Subgroup.closure {σ : Ω ≃ₐ[k] Ω | SSGRoute.IsInertia k B σ}) ?_ ?_ ?_ ?_ hb
  · intro y hy
    exact Subgroup.subset_closure (by
      have h : SSGRoute.IsInertia k (δ • B) (δ * y * δ⁻¹) := (isInertia_conj B δ y).mpr hy
      rwa [hδB] at h)
  · rw [mul_one, mul_inv_cancel]
    exact Subgroup.one_mem _
  · intro y z _ _ hy hz
    convert mul_mem hy hz using 1
    group
  · intro y _ hy
    convert Subgroup.inv_mem _ hy using 1
    group

/-- **A locally constant cocycle vanishing on the inertia of a finite place vanishes on a subgroup
of cyclic quotient.**

Let `x` be a locally constant `1`-cocycle on `G_k` (with values in a finite `𝔽_p`-module `E` on
which `G_k` acts through `res k K : G_k →* Gal(K/k)`), `B` a finite place of `Ω` such that `x`
vanishes on the inertia `I_B`, and assume the local cyclicity input `hlocal` (for any subgroup `W` of
the shape `V ⊓ decomp k B` with `V` open and `I_B ≤ W`, the quotient `decomp k B / W` is cyclic,
generated by one element `g`).

Then there is a subgroup `U ≤ decomp k B` of the shape `V ⊓ decomp k B` with `V` open in `G_k`, on
which `x` vanishes identically, normal in `decomp k B`, with `decomp k B / U` cyclic generated by one
`g`, and hence `x` restricted to `U` is a coboundary (with `m = 0`).

Suggested proof.  `hlc` gives an open subgroup `V₀ ≤ G_k` with `x u = x 1 = 0` for `u ∈ V₀`; by
`Work.SSGRoute.exists_finiteDimensional_normal_fixingSubgroup_le` there is a finite-dimensional
normal `M/k` with `M.fixingSubgroup ≤ V₀`.  Put `V := M.fixingSubgroup * I_B` (the product of a
subgroup and the inertia, which is a subgroup because `M.fixingSubgroup ⊴ G_k`), and
`U := V ⊓ decomp k B`.  Then `V` is open (it contains the open subgroup `M.fixingSubgroup`),
`I_B ≤ V`, and `V` is stable under conjugation by `D_B` (because `M.fixingSubgroup ⊴ G_k` and
`δ I_B δ⁻¹ = I_B` for `δ ∈ D_B`, using `IsInertia k (δ • B) (δ * τ * δ⁻¹) ↔ IsInertia k B τ` from
`place_basics` together with `δ • B = B`).  Finally `x` vanishes on `U ⊆ V` because for
`u = g * i` with `g ∈ M.fixingSubgroup`, `i ∈ I_B` the cocycle identity gives
`x u = x g + (res k K g) • x i = 0`.  Apply `hlocal` to `W = U`. -/
theorem exists_cyclic_quotient_subgroup_vanishing
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (x : (Ω ≃ₐ[k] Ω) → E) (hx : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ x)
    (hlc : SSGRoute.IsLocConstOn ⊤ x)
    (B : ValuationSubring Ω) (hB : SSGRoute.IsFinPlace k B)
    (hI : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → x σ = 0)
    (hlocal : ∀ (W : Subgroup (Ω ≃ₐ[k] Ω)),
      (∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧ W = V ⊓ SSGRoute.decomp k B) →
      (∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → σ ∈ W) →
      ∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ W) :
    ∃ U : Subgroup (Ω ≃ₐ[k] Ω),
      (∃ V : Subgroup (Ω ≃ₐ[k] Ω), IsOpen (V : Set (Ω ≃ₐ[k] Ω)) ∧
        U = V ⊓ SSGRoute.decomp k B) ∧
      (∀ δ ∈ SSGRoute.decomp k B, ∀ u ∈ U, δ * u * δ⁻¹ ∈ U) ∧
      (∃ g ∈ SSGRoute.decomp k B, ∀ δ ∈ SSGRoute.decomp k B, ∃ m : ℤ, δ⁻¹ * g ^ m ∈ U) ∧
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) U x := by
  classical
  -- `x` vanishes at `1`
  have hx1 : x 1 = 0 := isCocycleOn_apply_one_aux hx
  -- `hlc` supplies an open subgroup on which `x` vanishes (it has the value `x 1`)
  obtain ⟨V₀, hV₀open, hV₀inv⟩ := hlc
  have hV₀zero : ∀ u ∈ V₀, x u = 0 := by
    intro u hu
    have h := hV₀inv 1 (Subgroup.mem_top 1) u hu (Subgroup.mem_top u)
    rwa [one_mul, hx1] at h
  -- Krull: an open subgroup contains the fixing subgroup of a finite-dimensional normal level
  haveI : IsGalois k Ω := IsAlgClosure.isGalois k Ω
  obtain ⟨M, hMfin, hMnorm, hMsub⟩ :=
    exists_finiteDimensional_normal_fixingSubgroup_le (U := k) (L := Ω) V₀ hV₀open
  haveI : FiniteDimensional k M := hMfin
  haveI : Normal k M := hMnorm
  haveI : IsGalois k M := ⟨⟩
  have hMnormal : (M.fixingSubgroup).Normal := inferInstance
  -- the subgroup generated by the inertia of `B`
  let I : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.closure {σ : Ω ≃ₐ[k] Ω | SSGRoute.IsInertia k B σ}
  have hIzero : ∀ b ∈ I, x b = 0 := fun b hb =>
    eq_zero_on_closure_of_eq_zero (SSGRoute.res k K) hx (fun s hs => hI s hs) b hb
  have hMzero : ∀ a ∈ M.fixingSubgroup, x a = 0 := fun a ha => hV₀zero a (hMsub ha)
  -- `x` vanishes on the whole of `V = M.fixingSubgroup ⊔ I`
  have hVzero : ∀ u ∈ M.fixingSubgroup ⊔ I, x u = 0 := by
    haveI : (M.fixingSubgroup).Normal := hMnormal
    intro u hu
    obtain ⟨a, ha, b, hb, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp hu
    rw [hx a (Subgroup.mem_top a) b (Subgroup.mem_top b), hMzero a ha, hIzero b hb,
      smul_zero, add_zero]
  have hVopen : IsOpen ((M.fixingSubgroup ⊔ I : Subgroup (Ω ≃ₐ[k] Ω)) :
      Set (Ω ≃ₐ[k] Ω)) :=
    Subgroup.isOpen_mono le_sup_left (IntermediateField.fixingSubgroup_isOpen M)
  refine ⟨(M.fixingSubgroup ⊔ I) ⊓ SSGRoute.decomp k B, ⟨M.fixingSubgroup ⊔ I, hVopen, rfl⟩,
    ?_, ?_, ?_⟩
  · -- `U` is normal in the decomposition group
    intro δ hδ u hu
    haveI : (M.fixingSubgroup).Normal := hMnormal
    obtain ⟨huV, huD⟩ := Subgroup.mem_inf.mp hu
    refine Subgroup.mem_inf.mpr ⟨?_, ?_⟩
    · obtain ⟨a, ha, b, hb, rfl⟩ := Subgroup.mem_sup_of_normal_left.mp huV
      have h := Subgroup.mul_mem_sup (hMnormal.conj_mem a ha δ)
        (conj_mem_closure_inertia B δ hδ hb)
      convert h using 1
      group
    · exact mul_mem (mul_mem hδ huD) (inv_mem hδ)
  · -- the local cyclicity input applies to `W = U`
    refine hlocal ((M.fixingSubgroup ⊔ I) ⊓ SSGRoute.decomp k B)
      ⟨M.fixingSubgroup ⊔ I, hVopen, rfl⟩
      (fun σ hσ => Subgroup.mem_inf.mpr ⟨?_, hσ.1⟩)
    exact Subgroup.mem_sup_right (Subgroup.subset_closure hσ)
  · -- `x` vanishes on `U`, so it is a coboundary with witness `0`
    exact ⟨0, fun g hg => by
      rw [hVzero g (Subgroup.mem_inf.mp hg).1, smul_zero, sub_zero]⟩

end Work.SSGRoute
