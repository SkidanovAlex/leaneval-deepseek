import Mathlib
import Submission.Work.SSGRoute.E7aAux
import Submission.Work.SSGRoute.LiftImports

namespace Work.SSGRoute

/-- `M = k_v · Ω`, the `k_v`-subfield of the completion of `Ω` at the place `A` generated by the
image of `Ω`, contains every element of that completion which is separable over `k_v`.

This is the "hard" half of the statement that `M` is the separable closure of `k_v` in
`placeCompletion A`; the composite statement (`M = separableClosure k_v (placeCompletion A)`) is
proved in `Submission/NK/ResidueFrob/isSepClosure_adjoinPlaceCompletion.lean`, whose proof contains
this inclusion as the block `hsep_le_M` (a copy of that block, with `K := k`, `K' := Ω`,
`p := Work.SSGRoute.primeUnder k A hA` and `hA := Submission.NeukirchUchida.primeOf_spec A hA`,
is a complete proof; the ingredients are
`Submission.NK.NeukirchUchida.exists_mem_subfieldClosure_of_eval_eq_zero` and
`Submission.NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers`). -/
theorem separableClosure_le_adjoinPlaceCompletion (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsSepClosure k Ω] (A : ValuationSubring Ω)
    (hA : SSGRoute.IsFinPlace k A)
    [Algebra (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : Work.SSGRoute.localFieldAt k A hA,
      algebraMap (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A) z =
        NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
          (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA) z) :
    separableClosure (Work.SSGRoute.localFieldAt k A hA) (NK.NeukirchUchida.placeCompletion A) ≤
      NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A := by
  have hΦ : (algebraMap (Work.SSGRoute.localFieldAt k A hA)
        (NK.NeukirchUchida.placeCompletion A)) =
      NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA) :=
    RingHom.ext halg
  intro x hx
  rw [mem_separableClosure_iff] at hx
  obtain ⟨q, hq0, hqx⟩ := hx.isIntegral.isAlgebraic
  -- `x` is a root of a nonzero polynomial over `k_v`; Krasner's lemma then puts `x` into the
  -- subfield generated by `k_v` and a single element of `Ω`.
  have hx' : ∃ q : Polynomial (Work.SSGRoute.localFieldAt k A hA), q ≠ 0 ∧
      Polynomial.eval₂ (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA))
        x q = 0 :=
    ⟨q, hq0, by
      rw [Polynomial.aeval_def, hΦ] at hqx
      exact hqx⟩
  obtain ⟨y, hy⟩ := NK.NeukirchUchida.exists_mem_subfieldClosure_of_eval_eq_zero
    (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A
    (Submission.NeukirchUchida.primeOf_spec A hA)
    (NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers
      (K := k) (K' := Ω) (Work.SSGRoute.primeUnder k A hA) A
      (Submission.NeukirchUchida.primeOf_spec A hA)) hx'
  have hsub : Set.range (NK.NeukirchUchida.adicCompletionToPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A (Submission.NeukirchUchida.primeOf_spec A hA)) ∪
      {NK.NeukirchUchida.placeCompletionCoe A y} ⊆
      (NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A : Set (NK.NeukirchUchida.placeCompletion A)) := by
    rintro z (⟨w, rfl⟩ | rfl)
    · rw [← hΦ]
      exact (NK.NeukirchUchida.adjoinPlaceCompletion (K := k) (K' := Ω)
        (Work.SSGRoute.primeUnder k A hA) A).algebraMap_mem w
    · exact IntermediateField.subset_adjoin (Work.SSGRoute.localFieldAt k A hA)
        (Set.range (NK.NeukirchUchida.placeCompletionCoe A)) ⟨y, rfl⟩
  exact Subfield.closure_le.mpr hsub hy

end Work.SSGRoute
