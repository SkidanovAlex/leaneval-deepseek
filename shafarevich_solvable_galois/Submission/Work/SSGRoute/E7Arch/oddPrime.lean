/-
# The involution conditions of the target are automatic for odd `p`

For odd `p` the group `⟨c⟩` generated by an involution has order dividing `2`, invertible in `𝔽_p`;
hence every `1`-cocycle on `⟨c⟩` with values in any `𝔽_p`-module is a coboundary
(`ArchAux.isCoboundaryOn_of_isCocycleOn_of_ne_two`).  Two consequences are recorded here, both of
which remove a condition from the inputs of the `H¹`-assembly for odd `p`:

* the *conclusion* of `Work.SSGRoute.coker_obstruction` asks, for every `c ∈ C`, that the local
  defect `ε - f ∘ β c` of a global cocycle against the given datum `β c` be a coboundary on
  `⟨c⟩`; since both `ε` and `β c` are cocycles on `⟨c⟩`, *any* global `ε` satisfies this for odd
  `p` (`isCoboundaryOn_zpowers_sub_of_ne_two`), so the `C`-part of the local datum imposes no
  condition at all;
* together with `pairArchFamily_eq_zero_of_ne_two`, the same holds for the pairing clauses and for
  the `C'`-sum of reciprocity (`pairReciprocity_of_vanishing_involutions`).

The genuine archimedean content of the target is therefore confined to `p = 2`.
-/
import Mathlib
import Submission.Work.SSGRoute.Interfaces
import Submission.Work.SSGRoute.DualMod.Main
import Submission.Work.SSGRoute.LTDArch.AuxLemmas
import Submission.Work.SSGRoute.local_tate_duality_archimedean
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open SSGRoute
open scoped TensorProduct

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace Work.SSGRoute.E7Arch

/-- **For odd `p`, the defect of two cocycles on `⟨c⟩` is a coboundary.**  Both `ε` and `β` are
`1`-cocycles on `⟨c⟩`, hence so is their difference, and for `p ≠ 2` this forces it to be a
coboundary (`2` is invertible in `𝔽_p`). -/
theorem isCoboundaryOn_zpowers_sub_of_ne_two
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (hp : p ≠ 2)
    (ε : (Ω ≃ₐ[k] Ω) → M) (β : (Ω ≃ₐ[k] Ω) → M)
    (hε : SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) ε)
    (hβ : SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) β) :
    SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
      (fun σ => ε σ - β σ) := by
  refine ArchAux.isCoboundaryOn_of_isCocycleOn_of_ne_two p hp (SSGRoute.res k K) c hc
    (fun σ => ε σ - β σ) ?_
  intro x hx y hy
  simp only [Pi.sub_apply]
  rw [hε x hx y hy, hβ x hx y hy, smul_sub]
  abel

end Work.SSGRoute.E7Arch
