set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open SSGRoute
open scoped TensorProduct BigOperators

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.SSGRoute.E7Arch

/-- **The archimedean family vanishes at every involution group when `p ≠ 2`.** -/
theorem pairArchFamily_eq_zero_of_ne_two
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (hp : p ≠ 2)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0 := by
  rw [pairArchFamily_zpowers_apply p k Ω K ζ hζ hζK T hT M c hc a b]
  exact Ach.archPair_apply_of_ne_two (h := hT.1) p (Ω ≃ₐ[k] Ω) M T hp (genArch p k Ω K ζ hζ hζK T hT c hc) a b

/-- **Reciprocity is carried by the finite places only, when the pairing vanishes at involutions.**
If a family of local pairings takes the value `0` at the group generated by every involution, then
reciprocity (`H1Pair.PairReciprocity`, the `hrec` hypothesis of `pt_selmer_relaxed`) follows from
the corresponding vanishing of the sum over the places of `S'` alone.  Combined with
`pairArchFamily_eq_zero_of_ne_two`, this says that for odd `p` the archimedean family contributes
nothing to reciprocity. -/
theorem pairReciprocity_of_vanishing_involutions
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [Normal k K]
    (T M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (pair : Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)
    (harch : ∀ (c : Ω ≃ₐ[k] Ω), c ^ 2 = 1 →
      ∀ (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        pair (Subgroup.zpowers c) a b = 0)
    (hfin : ∀ (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)),
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
      SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
      ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
      (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
      (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
        (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
        ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
          ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
      ∑ A ∈ S', pair (SSGRoute.decomp k A) a b = 0) :
    H1Pair.PairReciprocity p K T M pair := by
  intro a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj
  rw [hfin a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram, zero_add]
  refine Finset.sum_eq_zero fun c hc => ?_
  exact harch c (hC'inv c hc) a b

end Work.SSGRoute.E7Arch
