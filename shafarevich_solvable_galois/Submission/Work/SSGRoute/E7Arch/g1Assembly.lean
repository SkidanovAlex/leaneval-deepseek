attribute [local instance] Classical.propDecidable

variable (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
  (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
  (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
  [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
  (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)

variable (fin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
    Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p)

/-- **The two shapes of local group are disjoint**: the decomposition group of a finite place is
never the group generated by an involution.  (`decomp k A` is infinite — it is the absolute Galois
group of the corresponding local field — while `Subgroup.zpowers c` for `c ^ 2 = 1` has at most two
elements; the proof is `Work.SSGRoute.E7Arch.decomp_ne_zpowers_of_sq_eq_one`.) -/
def LocalGroupDisjoint : Prop := ∀ (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
  ∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → SSGRoute.decomp k A ≠ Subgroup.zpowers c

/-- **The glued family**: the archimedean family at the groups generated by an involution, the
finite-place family elsewhere.  (`pairArchFamily` is `0` off the involution groups, so the order of
the two tests is immaterial for the values; putting the involution test first makes the clauses at
`⟨c⟩` *definitionally* the archimedean ones.) -/
noncomputable def pairGlue : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
    Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p :=
  fun M _ _ _ _ _ H a b =>
    if _h : ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c then
      pairArchFamily p k Ω K ζ hζ hζK T hT M H a b
    else fin M H a b

/-- The value of the glued family at the group generated by an involution. -/
theorem pairGlue_arch (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)} {c : Ω ≃ₐ[k] Ω} (hc : c ^ 2 = 1)
    (heq : H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlue p k Ω K ζ hζ hζK T hT fin M H a b =
      pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b := by
  subst heq
  unfold pairGlue
  exact dif_pos ⟨c, hc, rfl⟩

/-- The value of the glued family away from the involution groups. -/
theorem pairGlue_fin (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {H : Subgroup (Ω ≃ₐ[k] Ω)}
    (h : ¬ ∃ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 ∧ H = Subgroup.zpowers c)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlue p k Ω K ζ hζ hζK T hT fin M H a b = fin M H a b := by
  unfold pairGlue
  exact dif_neg h

/-- **The value of the glued family at a finite place is the finite-place value**, by the
disjointness of the two shapes of local group. -/
theorem pairGlue_decomp (hempty : LocalGroupDisjoint k Ω)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) :
    pairGlue p k Ω K ζ hζ hζK T hT fin M (SSGRoute.decomp k A) a b =
      fin M (SSGRoute.decomp k A) a b := by
  refine pairGlue_fin p k Ω K ζ hζ hζK T hT fin M (fun h => ?_) a b
  obtain ⟨c, hc, heq⟩ := h
  exact hempty A hA c hc heq

/-- The clause bundles transport along a pointwise equality of the pairing. -/
theorem pairClauses_of_pair_eq {M : Type} [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    {pairH pairH' : ((Ω ≃ₐ[k] Ω) → M) →
      ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p}
    {H : Subgroup (Ω ≃ₐ[k] Ω)} (hp : ∀ a b, pairH' a b = pairH a b)
    (h : H1Pair.PairClauses p K T M pairH H) :
    H1Pair.PairClauses p K T M pairH' H := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := h
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro a a' b ha ha' hb
    rw [hp (a + a') b, hp a b, hp a' b]
    exact h1 a a' b ha ha' hb
  · intro a b b' ha hb hb'
    rw [hp a (b + b'), hp a b, hp a b']
    exact h2 a b b' ha hb hb'
  · intro a b ha hb hab
    rw [hp a b]
    exact h3 a b ha hb hab
  · intro a ha hzero
    exact h4 a ha (fun b hb => by rw [← hp a b]; exact hzero b hb)
  · intro b hb hzero
    exact h5 b hb (fun a ha => by rw [← hp a b]; exact hzero a ha)

/-- Clauses (1)–(4) of the glued family at every local group. -/
theorem pairGlue_pairClauses
    (hclauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      H1Pair.PairClauses p K T M (fun a b => fin M (SSGRoute.decomp k A) a b)
        (SSGRoute.decomp k A))
    (hempty : LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (H : Subgroup (Ω ≃ₐ[k] Ω)), H1Pair.IsLocalGroup k Ω H →
      H1Pair.PairClauses p K T M (fun a b => pairGlue p k Ω K ζ hζ hζK T hT fin M H a b) H := by
  intro M _ _ _ _ _ H hH
  rcases hH with ⟨A, hA, rfl⟩ | ⟨c, hc, rfl⟩
  · refine pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      (H := SSGRoute.decomp k A) (fun a b => pairGlue_decomp p k Ω K ζ hζ hζK T hT fin hempty
        M A hA a b) (hclauses M A hA)
  · refine pairClauses_of_pair_eq (p := p) (k := k) (Ω := Ω) (K := K) (T := T) (M := M)
      (H := Subgroup.zpowers c) (fun a b => ?_)
      (pairArchFamily_pairClauses p k Ω K ζ hζ hζK T hT M c hc)
    exact pairGlue_arch p k Ω K ζ hζ hζK T hT fin M hc rfl a b

/-- Clause (5) of the glued family at every local group. -/
theorem pairGlue_naturality
    (hnat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
          SSGRoute.DualMod p (M ⊗[ZMod p] T))
        (hff' : ∀ (φ : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
          f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
        (H : Subgroup (Ω ≃ₐ[k] Ω))
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)),
        fin M₂ H (fun σ => f (a σ)) b = fin M H a (fun σ => f' (b σ)))
    (hempty : LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
      [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
      (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
      (f' : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p] SSGRoute.DualMod p (M ⊗[ZMod p] T))
      (hff' : ∀ (φ : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
        f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
      (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : H1Pair.IsLocalGroup k Ω H)
      (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M₂ ⊗[ZMod p] T))
      (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a)
      (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b),
      pairGlue p k Ω K ζ hζ hζK T hT fin M₂ H (fun σ => f (a σ)) b =
        pairGlue p k Ω K ζ hζ hζK T hT fin M H a (fun σ => f' (b σ)) := by
  intro M _ _ _ _ _ M₂ _ _ _ _ _ f hf f' hff' H hH a b ha hb
  rcases hH with ⟨A, hA, rfl⟩ | ⟨c, hc, rfl⟩
  · rw [pairGlue_decomp p k Ω K ζ hζ hζK T hT fin hempty M₂ A hA (fun σ => f (a σ)) b,
      pairGlue_decomp p k Ω K ζ hζ hζK T hT fin hempty M A hA a (fun σ => f' (b σ))]
    exact hnat M M₂ f hf f' hff' (SSGRoute.decomp k A) a b
  · rw [pairGlue_arch p k Ω K ζ hζ hζK T hT fin M₂ hc rfl (fun σ => f (a σ)) b,
      pairGlue_arch p k Ω K ζ hζ hζK T hT fin M hc rfl a (fun σ => f' (b σ))]
    exact pairArchFamily_naturality p k Ω K ζ hζ hζK T hT M M₂ f hf f' hff' a b c hc

/-- Clause (6) of the glued family at a good place. -/
theorem pairGlue_orth
    (horth : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
        (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T))
        (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
        (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
        (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
        fin M (SSGRoute.decomp k A) a b = 0)
    (hempty : LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
      (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
      (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T))
      (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
      (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
      (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
      pairGlue p k Ω K ζ hζ hζK T hT fin M (SSGRoute.decomp k A) a b = 0 := by
  intro M _ _ _ _ _ A hA hpA hramA a b ha hb hiner
  rw [pairGlue_decomp p k Ω K ζ hζ hζK T hT fin hempty M A hA a b]
  exact horth M A hA hpA hramA a b ha hb hiner

/-- **The joint reciprocity hypothesis**: the sum of the finite-place pairings over `S'` and of the
archimedean pairings over `C'` vanishes on pairs of *global* locally constant cocycles, for every
admissible testing pair `(S', C')`.  This is clause (7) of `G1` for the two canonical halves taken
together; it must **not** be split into a finite-place and an archimedean statement (see the header:
for `k = ℚ`, `p = 2`, `M = 𝔽₂`, `a = b =` the sign character, each half separately is `1 ≠ 0` while
the sum is `0`). -/
theorem pairGlue_reciprocity
    (hrecJoint : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', fin M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0)
    (hempty : LocalGroupDisjoint k Ω) :
    ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
      H1Pair.PairReciprocity p K T M
        (fun H a b => pairGlue p k Ω K ζ hζ hζK T hT fin M H a b) := by
  intro M _ _ _ _ _ a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj
  have h1 : ∑ A ∈ S', pairGlue p k Ω K ζ hζ hζK T hT fin M (SSGRoute.decomp k A) a b
      = ∑ A ∈ S', fin M (SSGRoute.decomp k A) a b := by
    refine Finset.sum_congr rfl fun A hA => ?_
    exact pairGlue_decomp p k Ω K ζ hζ hζK T hT fin hempty M A (hS'fin A hA) a b
  have h2 : ∑ c ∈ C', pairGlue p k Ω K ζ hζ hζK T hT fin M (Subgroup.zpowers c) a b
      = ∑ c ∈ C', pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b := by
    refine Finset.sum_congr rfl fun c hc => ?_
    rw [pairGlue_arch p k Ω K ζ hζ hζK T hT fin M (hC'inv c hc) rfl a b]
  rw [h1, h2]
  exact hrecJoint M a b ha1 ha2 hb1 hb2 S' hS'fin hS'disj hS'unram C' hC'inv hC'rep hC'disj

/-- **The assembly of `G1` from its two halves.**  The glued family `pairGlue` satisfies all four
items the consumers of `G1` need: clauses (1)–(4) at every local group, clause (5) at every local
group, clause (6) at every good place, and reciprocity. -/
theorem glue_of_finiteHalf
    (hclauses : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
      (A : ValuationSubring Ω), SSGRoute.IsFinPlace k A →
      H1Pair.PairClauses p K T M (fun a b => fin M (SSGRoute.decomp k A) a b)
        (SSGRoute.decomp k A))
    (hnat : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
        [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
        (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
        (f' : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
          SSGRoute.DualMod p (M ⊗[ZMod p] T))
        (hff' : ∀ (φ : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
          f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
        (H : Subgroup (Ω ≃ₐ[k] Ω))
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)),
        fin M₂ H (fun σ => f (a σ)) b = fin M H a (fun σ => f' (b σ)))
    (horth : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
        (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T))
        (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
        (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
          SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
        (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
        fin M (SSGRoute.decomp k A) a b = 0)
    (hrecJoint : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
        (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)),
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ a → SSGRoute.IsLocConstOn ⊤ a →
        SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b → SSGRoute.IsLocConstOn ⊤ b →
        ∀ (S' : Finset (ValuationSubring Ω)), (∀ A ∈ S', SSGRoute.IsFinPlace k A) →
        (∀ A ∈ S', ∀ B ∈ S', SSGRoute.IsConjPlace k A B → A = B) →
        (∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
          (∀ A ∈ S', ¬ SSGRoute.IsConjPlace k A B) →
          ¬ B.valuation (p : Ω) < 1 ∧ ¬ SSGRoute.IsRamifiedIn k K B ∧
            ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0) →
        ∀ (C' : Finset (Ω ≃ₐ[k] Ω)), (∀ c ∈ C', c ^ 2 = 1) →
        (∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ≠ 1 → ∃ c₀ ∈ C', ∃ σ : Ω ≃ₐ[k] Ω, c = σ * c₀ * σ⁻¹) →
        (∀ c ∈ C', ∀ c' ∈ C', (∃ σ : Ω ≃ₐ[k] Ω, c' = σ * c * σ⁻¹) → c = c') →
        ∑ A ∈ S', fin M (SSGRoute.decomp k A) a b +
          ∑ c ∈ C', pairArchFamily p k Ω K ζ hζ hζK T hT M (Subgroup.zpowers c) a b = 0)
    (hempty : LocalGroupDisjoint k Ω) :
    ∃ pair : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subgroup (Ω ≃ₐ[k] Ω) → ((Ω ≃ₐ[k] Ω) → M) →
          ((Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T)) → ZMod p,
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (H : Subgroup (Ω ≃ₐ[k] Ω)), H1Pair.IsLocalGroup k Ω H →
          H1Pair.PairClauses p K T M (fun a b => pair M H a b) H) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (M₂ : Type) [AddCommGroup M₂] [Module (ZMod p) M₂]
          [DistribMulAction (K ≃ₐ[k] K) M₂] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M₂] [Finite M₂]
          (f : M →ₗ[ZMod p] M₂) (hf : ∀ (g : K ≃ₐ[k] K) (e : M), f (g • e) = g • f e)
          (f' : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T) →ₗ[ZMod p]
            SSGRoute.DualMod p (M ⊗[ZMod p] T))
          (hff' : ∀ (φ : SSGRoute.DualMod p (M₂ ⊗[ZMod p] T)) (e : M) (t : T),
            f' φ (e ⊗ₜ[ZMod p] t) = φ (f e ⊗ₜ[ZMod p] t))
          (H : Subgroup (Ω ≃ₐ[k] Ω)) (hH : H1Pair.IsLocalGroup k Ω H)
          (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M₂ ⊗[ZMod p] T))
          (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) H a ∧ SSGRoute.IsLocConstOn H a)
          (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) H b ∧ SSGRoute.IsLocConstOn H b),
          pair M₂ H (fun σ => f (a σ)) b = pair M H a (fun σ => f' (b σ))) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
          (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
          (hpA : ¬ A.valuation (p : Ω) < 1) (hramA : ¬ SSGRoute.IsRamifiedIn k K A)
          (a : (Ω ≃ₐ[k] Ω) → M) (b : (Ω ≃ₐ[k] Ω) → SSGRoute.DualMod p (M ⊗[ZMod p] T))
          (ha : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) a ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) a)
          (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) b ∧
            SSGRoute.IsLocConstOn (SSGRoute.decomp k A) b)
          (hiner : ∀ σ : Ω ≃ₐ[k] Ω, SSGRoute.IsInertia k A σ → a σ = 0 ∧ b σ = 0),
          pair M (SSGRoute.decomp k A) a b = 0) ∧
      (∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
          [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
          H1Pair.PairReciprocity p K T M (fun H a b => pair M H a b)) :=
  ⟨fun M _ _ _ _ _ => pairGlue p k Ω K ζ hζ hζK T hT fin M,
    pairGlue_pairClauses p k Ω K ζ hζ hζK T hT fin hclauses hempty,
    fun M _ _ _ _ _ M₂ _ _ _ _ _ f hf f' hff' H hH a b ha hb =>
      pairGlue_naturality p k Ω K ζ hζ hζK T hT fin hnat hempty M M₂ f hf f' hff' H hH a b ha hb,
    fun M _ _ _ _ _ A hA hpA hramA a b ha hb hiner =>
      pairGlue_orth p k Ω K ζ hζ hζK T hT fin horth hempty M A hA hpA hramA a b ha hb hiner,
    fun M _ _ _ _ _ => pairGlue_reciprocity p k Ω K ζ hζ hζK T hT fin hrecJoint hempty M⟩

end Work.SSGRoute.E7Arch
