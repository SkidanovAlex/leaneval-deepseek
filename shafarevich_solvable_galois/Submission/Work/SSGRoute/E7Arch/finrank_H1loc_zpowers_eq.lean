/-! ## Local constancy on `⟨c⟩` is automatic -/

/-- On the procyclic subgroup generated by an involution, **every** cochain is locally constant
(there is an open subgroup of `G_k` meeting `⟨c⟩` trivially). -/
theorem isLocConstOn_zpowers_arch {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] {M : Type} [AddCommGroup M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (f : (Ω ≃ₐ[k] Ω) → M) :
    SSGRoute.IsLocConstOn (Subgroup.zpowers c) f := by
  by_cases hc1 : c = 1
  · subst hc1
    refine ⟨⊤, isOpen_univ, fun g _ u _ huH => ?_⟩
    have hu : u = 1 := by
      rw [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot] at huH; exact huH
    rw [hu, mul_one]
  · obtain ⟨U, hU, hcU⟩ := Work.SSGRoute.exists_isOpen_subgroup_notMem_zpowers k Ω c hc1
    refine Work.SSGRoute.isLocConstOn_zpowers_of_meet c ⟨U, hU, fun u hu huH => ?_⟩
    rcases Work.SSGRoute.Ach.mem_zpowers_eq_one_or c hc huH with h | h
    · exact h
    · exact absurd (h ▸ hu) hcU

/-! ## The endomorphism `x ↦ x + c·x` is a differential in characteristic two -/

/-- In characteristic two, `S_X = x ↦ x + c·x` satisfies `S_X² = 0`. -/
theorem addSelf_comp_self_eq_zero (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω]
    [Algebra k Ω] (K : IntermediateField k Ω) [IsGalois k K]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (hp2 : p = 2)
    (X : Type) [AddCommGroup X] [Module (ZMod p) X]
    [DistribMulAction (K ≃ₐ[k] K) X] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) X] :
    (addSelf p k Ω K X c).comp (addSelf p k Ω K X c) = 0 := by
  have hres : (SSGRoute.res k K c) * (SSGRoute.res k K c) = 1 := by
    rw [← map_mul, ← pow_two, hc, map_one]
  have hσ2 : ∀ y : X, (SSGRoute.res k K c) • ((SSGRoute.res k K c) • y) = y := by
    intro y; rw [← mul_smul, hres, one_smul]
  ext x
  simp only [LinearMap.comp_apply, LinearMap.zero_apply, addSelf_apply]
  rw [smul_add, hσ2]
  have hx : x + x = 0 := Work.SSGRoute.Ach.add_self_eq_zero_of_eq_two p hp2 x
  have hy : SSGRoute.res k K c • x + SSGRoute.res k K c • x = 0 :=
    Work.SSGRoute.Ach.add_self_eq_zero_of_eq_two p hp2 _
  calc x + SSGRoute.res k K c • x + (SSGRoute.res k K c • x + x)
      = (x + x) + (SSGRoute.res k K c • x + SSGRoute.res k K c • x) := by abel
    _ = 0 := by rw [hx, hy, add_zero]

/-! ## `H¹(⟨c⟩, X)` as `ker S_X ⧸ range S_X` -/

/-- **The key linear equivalence.**  For `p = 2` and `c ≠ 1`, the local `H¹` at `⟨c⟩` is
`ker S_X ⧸ range S_X`: a locally constant cocycle is determined by its value at `c`, which lies in
`ker S_X`, and the coboundaries are exactly the cocycles whose value at `c` lies in `range S_X`. -/
def H1locEquivKerQuot (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (hp2 : p = 2) (hc1 : c ≠ 1)
    (X : Type) [AddCommGroup X] [Module (ZMod p) X]
    [DistribMulAction (K ≃ₐ[k] K) X] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) X] :
    H1loc p k Ω K X (Subgroup.zpowers c) ≃ₗ[ZMod p]
      (↥(addSelf p k Ω K X c).ker ⧸
        ((addSelf p k Ω K X c).range.comap (addSelf p k Ω K X c).ker.subtype)) := by
  classical
  have hψmem : ∀ f : ↥(lcCocycles p k Ω K X (Subgroup.zpowers c)),
      (addSelf p k Ω K X c) (f.1 c) = 0 := by
    intro f
    have hcoc := (Ach.isCocycleOn_zpowers_iff (SSGRoute.res k K) c hc f.1).mp f.2.1
    rw [addSelf_apply, hcoc.2]
  let ψ : ↥(lcCocycles p k Ω K X (Subgroup.zpowers c)) →ₗ[ZMod p]
      ↥(addSelf p k Ω K X c).ker :=
    { toFun := fun f => ⟨f.1 c, by rw [LinearMap.mem_ker]; exact hψmem f⟩
      map_add' := fun f g => by ext; simp
      map_smul' := fun r f => by ext; simp }
  have hψval : ∀ f, (ψ f).1 = f.1 c := fun f => rfl
  have hPQ : Submodule.comap (lcCocycles p k Ω K X (Subgroup.zpowers c)).subtype
        (coboundaries p k Ω K X (Subgroup.zpowers c)) ≤
      Submodule.comap ψ ((addSelf p k Ω K X c).range.comap (addSelf p k Ω K X c).ker.subtype) := by
    intro f hf
    rw [Submodule.mem_comap] at hf ⊢
    rw [Submodule.mem_comap]
    obtain ⟨-, m, hm⟩ := (Ach.isCoboundaryOn_zpowers_iff (SSGRoute.res k K) c hc f.1).mp hf
    refine ⟨m, ?_⟩
    show (addSelf p k Ω K X c) m = f.1 c
    rw [hm, addSelf_apply, Ach.sub_eq_add_of_eq_two p hp2]
    abel
  let Th := Submodule.mapQ _ ((addSelf p k Ω K X c).range.comap (addSelf p k Ω K X c).ker.subtype)
    ψ hPQ
  have hconc_coc : ∀ x : ↥(addSelf p k Ω K X c).ker,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) (Subgroup.zpowers c) (Pi.single c x.1) := by
    intro x
    refine (Ach.isCocycleOn_zpowers_iff (SSGRoute.res k K) c hc _).mpr ⟨?_, ?_⟩
    · rw [Pi.single_eq_of_ne (fun h : (1:Ω ≃ₐ[k] Ω) = c => hc1 h.symm)]
    · rw [Pi.single_eq_same]
      have h := LinearMap.mem_ker.mp x.2
      rwa [addSelf_apply] at h
  have hconc_mem : ∀ x : ↥(addSelf p k Ω K X c).ker,
      Pi.single c x.1 ∈ lcCocycles p k Ω K X (Subgroup.zpowers c) :=
    fun x => ⟨hconc_coc x, isLocConstOn_zpowers_arch c hc _⟩
  let inner : ↥(addSelf p k Ω K X c).ker →ₗ[ZMod p]
      ↥(lcCocycles p k Ω K X (Subgroup.zpowers c)) :=
    { toFun := fun x => ⟨Pi.single c x.1, hconc_mem x⟩
      map_add' := fun x y => Subtype.ext (by
        show (Pi.single c (x + y).1 : (Ω ≃ₐ[k] Ω) → X) = Pi.single c x.1 + Pi.single c y.1
        rw [Submodule.coe_add, Pi.single_add])
      map_smul' := fun r x => Subtype.ext (by
        show (Pi.single c (r • x).1 : (Ω ≃ₐ[k] Ω) → X) = r • Pi.single c x.1
        rw [Submodule.coe_smul, Pi.single_smul]) }
  have hinnerval : ∀ x, (inner x).1 = (Pi.single c x.1 : (Ω ≃ₐ[k] Ω) → X) := fun x => rfl
  let φ₀ := ((Submodule.comap (lcCocycles p k Ω K X (Subgroup.zpowers c)).subtype
      (coboundaries p k Ω K X (Subgroup.zpowers c))).mkQ).comp inner
  have hφ₀ : ∀ x, φ₀ x = Submodule.Quotient.mk (inner x) := fun x => Submodule.mkQ_apply _ _
  have hQφ : (addSelf p k Ω K X c).range.comap (addSelf p k Ω K X c).ker.subtype ≤ φ₀.ker := by
    intro y hy
    rw [Submodule.mem_comap] at hy
    obtain ⟨m, hm⟩ := LinearMap.mem_range.mp hy
    rw [LinearMap.mem_ker, hφ₀]
    rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap]
    change (inner y).1 ∈ coboundaries p k Ω K X (Subgroup.zpowers c)
    rw [hinnerval y]
    refine (Ach.isCoboundaryOn_zpowers_iff (SSGRoute.res k K) c hc (Pi.single c y.1)).mpr ⟨?_, m, ?_⟩
    · rw [Pi.single_eq_of_ne (fun h : (1:Ω ≃ₐ[k] Ω) = c => hc1 h.symm)]
    · rw [Pi.single_eq_same]
      have key : (SSGRoute.res k K) c • m - m = ↑y := by
        rw [Ach.sub_eq_add_of_eq_two p hp2, add_comm, ← addSelf_apply p k Ω K X c m]
        simpa using hm
      exact key.symm
  let Λ := Submodule.liftQ ((addSelf p k Ω K X c).range.comap (addSelf p k Ω K X c).ker.subtype)
    φ₀ hQφ
  refine { toFun := Th, invFun := Λ, left_inv := ?_, right_inv := ?_,
           map_add' := Th.map_add, map_smul' := Th.map_smul }
  · intro y
    refine Submodule.Quotient.induction_on _ y (fun f => ?_)
    have h1 : Th (Submodule.Quotient.mk f) = Submodule.Quotient.mk (ψ f) :=
      Submodule.mapQ_apply _ _ _ f
    have h2 : Λ (Submodule.Quotient.mk (ψ f)) = φ₀ (ψ f) := Submodule.liftQ_apply _ _ _
    rw [h1, h2, hφ₀]
    refine (Submodule.Quotient.eq _).mpr ?_
    rw [Submodule.mem_comap]
    change (inner (ψ f) - f).1 ∈ coboundaries p k Ω K X (Subgroup.zpowers c)
    rw [Submodule.coe_sub, hinnerval (ψ f)]
    refine (Ach.isCoboundaryOn_zpowers_iff (SSGRoute.res k K) c hc _).mpr ⟨?_, 0, ?_⟩
    · have hf1 : f.1 1 = 0 :=
        ((Ach.isCocycleOn_zpowers_iff (SSGRoute.res k K) c hc f.1).mp f.2.1).1
      show (Pi.single c ((ψ f).1) : (Ω ≃ₐ[k] Ω) → X) 1 - f.1 1 = 0
      rw [Pi.single_eq_of_ne (fun h : (1:Ω ≃ₐ[k] Ω) = c => hc1 h.symm), hf1, sub_zero]
    · show (Pi.single c ((ψ f).1) : (Ω ≃ₐ[k] Ω) → X) c - f.1 c = (SSGRoute.res k K) c • 0 - 0
      rw [Pi.single_eq_same, hψval f, smul_zero, sub_zero, sub_self]
  · intro z
    refine Submodule.Quotient.induction_on _ z (fun x => ?_)
    have h2 : Λ (Submodule.Quotient.mk x) = φ₀ x := Submodule.liftQ_apply _ _ _
    rw [h2, hφ₀]
    change Th (Submodule.Quotient.mk ⟨Pi.single c x.1, hconc_mem x⟩) = Submodule.Quotient.mk x
    rw [show Th (Submodule.Quotient.mk ⟨Pi.single c x.1, hconc_mem x⟩) =
        Submodule.Quotient.mk (ψ ⟨Pi.single c x.1, hconc_mem x⟩) from
      Submodule.mapQ_apply _ _ _ _]
    congr 1
    apply Subtype.ext
    rw [hψval]
    change (Pi.single c x.1 : (Ω ≃ₐ[k] Ω) → X) c = x.1
    rw [Pi.single_eq_same]

/-! ## The dimension formula -/

/-- **The dimension of `H¹(⟨c⟩, X)` in characteristic two.**  It is
`finrank X - 2 * finrank (range S_X)`. -/
theorem finrank_H1loc_zpowers_formula (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K]
    [IsGalois k K] (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (hp2 : p = 2) (hc1 : c ≠ 1)
    (X : Type) [AddCommGroup X] [Module (ZMod p) X]
    [DistribMulAction (K ≃ₐ[k] K) X] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) X]
    [FiniteDimensional (ZMod p) X] :
    Module.finrank (ZMod p) (H1loc p k Ω K X (Subgroup.zpowers c)) =
      Module.finrank (ZMod p) X - 2 * Module.finrank (ZMod p) ↥(addSelf p k Ω K X c).range := by
  rw [LinearEquiv.finrank_eq (H1locEquivKerQuot p k Ω K c hc hp2 hc1 X)]
  set S : X →ₗ[ZMod p] X := addSelf p k Ω K X c with hSdef
  set Q : Submodule (ZMod p) ↥S.ker := S.range.comap S.ker.subtype with hQdef
  have hS2 : S.comp S = 0 := by
    rw [hSdef]; exact addSelf_comp_self_eq_zero p k Ω K c hc hp2 X
  have hS2_le : S.range ≤ S.ker := by
    intro y hy
    obtain ⟨x, rfl⟩ := LinearMap.mem_range.mp hy
    rw [LinearMap.mem_ker]
    have h := congrArg (fun f : X →ₗ[ZMod p] X => f x) hS2
    simpa [LinearMap.comp_apply] using h
  have hQrank : Module.finrank (ZMod p) ↥Q = Module.finrank (ZMod p) ↥S.range :=
    LinearEquiv.finrank_eq
      { toFun := fun z => ⟨z.1.1, Submodule.mem_comap.mp z.2⟩
        invFun := fun y => ⟨⟨y.1, hS2_le y.2⟩, Submodule.mem_comap.mpr y.2⟩
        left_inv := fun z => by apply Subtype.ext; apply Subtype.ext; rfl
        right_inv := fun y => by apply Subtype.ext; rfl
        map_add' := fun a b => by apply Subtype.ext; rfl
        map_smul' := fun r a => by apply Subtype.ext; rfl }
  have hquot := Submodule.finrank_quotient_add_finrank Q
  have hrk := LinearMap.finrank_range_add_finrank_ker S
  omega

/-! ## The elementary linear algebra of `finrank` for a transpose -/

/-- The transpose of an endomorphism of a finite-dimensional space has the same rank. -/
theorem finrank_dualMap_range {K V : Type} [Field K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (T : V →ₗ[K] V) :
    Module.finrank K ↥(T.dualMap.range) = Module.finrank K ↥T.range := by
  rw [LinearMap.range_dualMap_eq_dualAnnihilator_ker]
  have h1 := Subspace.finrank_add_finrank_dualAnnihilator_eq (K := K) (V := V) T.ker
  have h2 := LinearMap.finrank_range_add_finrank_ker T
  omega

/-- Conjugation by a linear equivalence preserves the dimension of the range. -/
theorem finrank_range_congr {K V V' : Type} [Field K] [AddCommGroup V] [Module K V]
    [AddCommGroup V'] [Module K V'] (e : V ≃ₗ[K] V') (S : V →ₗ[K] V) (S' : V' →ₗ[K] V')
    (he : ∀ x, e (S x) = S' (e x)) :
    Module.finrank K ↥S'.range = Module.finrank K ↥S.range := by
  have hmap : Submodule.map (e : V →ₗ[K] V') S.range = S'.range := by
    refine le_antisymm ?_ ?_
    · intro y hy
      obtain ⟨x, hx, hfe⟩ := Submodule.mem_map.mp hy
      obtain ⟨z, rfl⟩ := LinearMap.mem_range.mp hx
      rw [← hfe]
      exact LinearMap.mem_range.mpr ⟨e z, (he z).symm⟩
    · intro y hy
      obtain ⟨w, rfl⟩ := LinearMap.mem_range.mp hy
      refine Submodule.mem_map.mpr ⟨e.symm (S' w), ?_, e.apply_symm_apply (S' w)⟩
      refine LinearMap.mem_range.mpr ⟨e.symm w, ?_⟩
      have h := congrArg (⇑e.symm) (he (e.symm w))
      simp only [LinearEquiv.symm_apply_apply, LinearEquiv.apply_symm_apply] at h
      exact h
  rw [← hmap, LinearEquiv.finrank_map_eq]

/-! ## The coefficient identification `M ⊗ T ≃ M` for `p = 2` -/

/-- For `p = 2` the cyclotomic dual `T` is a rank-one trivial `⟨c⟩`-module, and
`m ⊗ t ↦ (coord t) • m` is a linear equivalence `M ⊗ T ≃ M`. -/
def tensorEquivArch (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (K : IntermediateField k Ω) [IsGalois k K] (ζ : Ω) (M T : Type)
    [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ) :
    M ⊗[ZMod p] T ≃ₗ[ZMod p] M where
  toFun := Ach.toE p M T (Ach.coord p T hT.1)
  invFun := fun m => m ⊗ₜ[ZMod p] Ach.t0 p T hT.1
  left_inv := fun y => by
    show (fun m => m ⊗ₜ[ZMod p] Ach.t0 p T hT.1) (Ach.toE p M T (Ach.coord p T hT.1) y) = y
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul m t =>
        rw [Ach.toE_tmul]
        show ((Ach.coord p T hT.1) t • m) ⊗ₜ[ZMod p] Ach.t0 p T hT.1 = m ⊗ₜ[ZMod p] t
        rw [TensorProduct.smul_tmul, Ach.smul_coord_t0]
    | add a b ha hb => simp only [map_add, TensorProduct.add_tmul, ha, hb]
  right_inv := fun m => by rw [Ach.toE_tmul, Ach.coord_t0, one_smul]
  map_add' := (Ach.toE p M T (Ach.coord p T hT.1)).map_add
  map_smul' := (Ach.toE p M T (Ach.coord p T hT.1)).map_smul

/-- The equivalence `M ⊗ T ≃ M` (for `p = 2`) is `⟨c⟩`-equivariant. -/
theorem tensorEquivArch_res_smul (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω]
    [Algebra k Ω] (K : IntermediateField k Ω) [IsGalois k K] (ζ : Ω)
    (hζ : IsPrimitiveRoot ζ p) (M T : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (hp2 : p = 2) (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) (y : M ⊗[ZMod p] T) :
    tensorEquivArch p k Ω K ζ M T hT (SSGRoute.res k K c • y) =
      SSGRoute.res k K c • tensorEquivArch p k Ω K ζ M T hT y := by
  induction y using TensorProduct.induction_on with
  | zero => simp
  | tmul m t =>
      show Ach.toE p M T (Ach.coord p T hT.1) (SSGRoute.res k K c • (m ⊗ₜ[ZMod p] t))
        = SSGRoute.res k K c • Ach.toE p M T (Ach.coord p T hT.1) (m ⊗ₜ[ZMod p] t)
      rw [smul_tmul_diagonal, smul_eq_self_of_isCyclotomicDual_two p k Ω K T ζ hζ hT hp2 c hc t,
        Ach.toE_tmul, Ach.toE_tmul]
      rw [smul_comm (SSGRoute.res k K c) ((Ach.coord p T hT.1) t) m]
  | add a b ha hb => simp only [smul_add, map_add, ha, hb]

/-- The transpose identification: for `p = 2`, `S` on `DualMod p (M ⊗ T)` is the transpose of
`S` on `M ⊗ T`. -/
theorem addSelf_dualMod_eq_dualMap (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [Field Ω]
    [Algebra k Ω] (K : IntermediateField k Ω) [IsGalois k K] (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
    (M T : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T] :
    addSelf p k Ω K (DualMod p (M ⊗[ZMod p] T)) c =
      (addSelf p k Ω K (M ⊗[ZMod p] T) c).dualMap := by
  have hσinv : (SSGRoute.res k K c)⁻¹ = SSGRoute.res k K c :=
    inv_eq_of_mul_eq_one_right (by rw [← map_mul, ← pow_two, hc, map_one])
  apply LinearMap.ext; intro φ
  apply LinearMap.ext; intro y
  rw [addSelf_apply, LinearMap.add_apply, DualMod.dualSMul_apply, hσinv,
      LinearMap.dualMap_apply, addSelf_apply, map_add]

/-! ## Vanishing on the trivial cases -/

/-- If `c = 1`, or `p ≠ 2`, then `H¹(⟨c⟩, X) = 0`. -/
theorem subsingleton_H1loc_zpowers (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K] (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1)
    (h : c = 1 ∨ p ≠ 2) (X : Type) [AddCommGroup X] [Module (ZMod p) X]
    [DistribMulAction (K ≃ₐ[k] K) X] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) X] :
    Subsingleton (H1loc p k Ω K X (Subgroup.zpowers c)) := by
  have hsub : (Submodule.comap (lcCocycles p k Ω K X (Subgroup.zpowers c)).subtype
      (coboundaries p k Ω K X (Subgroup.zpowers c))) = ⊤ := by
    rw [Submodule.eq_top_iff']
    intro f
    rw [Submodule.mem_comap]
    rcases h with hc1 | hp
    · subst hc1
      refine ⟨0, fun g hg => ?_⟩
      rw [Subgroup.zpowers_one_eq_bot, Subgroup.mem_bot] at hg
      have hf1 : f.1 1 = 0 :=
        ((Ach.isCocycleOn_zpowers_iff (SSGRoute.res k K) 1 (by simp) f.1).mp f.2.1).1
      rw [hg]
      change f.1 1 = (SSGRoute.res k K) 1 • 0 - 0
      rw [hf1]; simp
    · exact isCoboundaryOn_zpowers_of_ne_two p (SSGRoute.res k K) c hc hp f.1 f.2.1
  exact Submodule.Quotient.subsingleton_iff.mpr hsub

/-! ## The main theorem -/

theorem finrank_H1loc_zpowers_eq
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ p) (hζK : ζ ∈ K)
    (T : Type) [AddCommGroup T] [Module (ZMod p) T] [DistribMulAction (K ≃ₐ[k] K) T]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) T]
    (hT : SSGRoute.IsCyclotomicDual p (T := T) (SSGRoute.res k K) ζ)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    Module.finrank (ZMod p) (Work.SSGRoute.H1loc p k Ω K M (Subgroup.zpowers c)) =
      Module.finrank (ZMod p) (Work.SSGRoute.H1loc p k Ω K
        (Work.SSGRoute.DualMod p (TensorProduct (ZMod p) M T)) (Subgroup.zpowers c)) := by
  classical
  by_cases h : c = 1 ∨ p ≠ 2
  · haveI : Subsingleton (H1loc p k Ω K M (Subgroup.zpowers c)) :=
      subsingleton_H1loc_zpowers p k Ω K c hc h M
    haveI : Subsingleton (H1loc p k Ω K (DualMod p (M ⊗[ZMod p] T)) (Subgroup.zpowers c)) :=
      subsingleton_H1loc_zpowers p k Ω K c hc h (DualMod p (M ⊗[ZMod p] T))
    exact LinearEquiv.finrank_eq (LinearEquiv.ofSubsingleton _ _)
  · push_neg at h
    obtain ⟨hc1, hp2⟩ := h
    haveI hTfin : Finite T := finite_of_finrank_eq_one T hT.1
    haveI hMTfin : Finite (M ⊗[ZMod p] T) := finite_tensor (p := p) M T
    haveI hDufin : Finite (DualMod p (M ⊗[ZMod p] T)) := finite_dualMod (p := p) _
    haveI hMfd : FiniteDimensional (ZMod p) M := Module.Finite.of_finite
    haveI hMTfd : FiniteDimensional (ZMod p) (M ⊗[ZMod p] T) := Module.Finite.of_finite
    haveI hDufd : FiniteDimensional (ZMod p) (DualMod p (M ⊗[ZMod p] T)) :=
      Module.Finite.of_finite
    rw [finrank_H1loc_zpowers_formula p k Ω K c hc hp2 hc1 M,
      finrank_H1loc_zpowers_formula p k Ω K c hc hp2 hc1 (DualMod p (M ⊗[ZMod p] T))]
    have hN1 : Module.finrank (ZMod p) (DualMod p (M ⊗[ZMod p] T)) =
        Module.finrank (ZMod p) M := by
      rw [finrank_dualMod, finrank_tensor_rankOne M T hT.1]
    have hN2 : Module.finrank (ZMod p)
          ↥(addSelf p k Ω K (DualMod p (M ⊗[ZMod p] T)) c).range =
        Module.finrank (ZMod p) ↥(addSelf p k Ω K M c).range := by
      rw [addSelf_dualMod_eq_dualMap p k Ω K c hc M T]
      rw [finrank_dualMap_range]
      exact (finrank_range_congr (tensorEquivArch p k Ω K ζ M T hT)
        (addSelf p k Ω K (M ⊗[ZMod p] T) c) (addSelf p k Ω K M c)
        (fun y => by
          rw [addSelf_apply, addSelf_apply, map_add]
          rw [tensorEquivArch_res_smul p k Ω K ζ hζ M T hT hp2 c hc y])).symm
    rw [hN1, hN2]

end

