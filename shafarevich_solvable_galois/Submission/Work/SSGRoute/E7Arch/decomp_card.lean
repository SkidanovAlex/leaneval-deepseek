/-
# The decomposition group of a finite place is not generated by an involution

`Work.SSGRoute.E7Arch.g1Assembly` glues the archimedean and the finite-place halves of `G1` using the
disjointness `LocalGroupDisjoint` of the two families of local groups: no decomposition group
`decomp k A` of a finite place is the group `Subgroup.zpowers c` generated by an involution `c`.
This file reduces that statement to a finite-level arithmetic one.

## The reduction

For every finite normal intermediate field `L ⊇ k`, the restriction of decomposition groups
(`Submission.NeukirchUchida.Local.decompositionRestrictHom_surjective`) is a **surjection**

  `decomp k A →* decompositionSubgroup (placeOf p A hA L)`,

so `decomp k A` has at least as many elements as the finite-level decomposition group.  On the other
hand `Subgroup.zpowers c` for `c ^ 2 = 1` has at most two elements (it is cyclic of order dividing
two).  Hence it suffices to find *one* finite normal level `L` at which the place `A` has local
degree `e · f ≥ 3`:

  `3 ≤ Nat.card (decompositionSubgroup (placeOf p A hA L))`
    ⟹ `decomp k A ≠ Subgroup.zpowers c`  for every `c` with `c ^ 2 = 1`.

The remaining arithmetic obligation (`exists_level_localDegree_ge_three`) is: the local field `k_p`
has an unramified extension of degree `3`; by
`Commons.NumberTheory.NumberField.Completion.exists_galois_realization` (with
`exists_unramified_extension_of_inertiaDeg`) it is the completion `L_w` of a finite Galois extension
`L/k`, whose place `w | p` provides the level, and `Nat.card (decompositionSubgroup w) = e·f = 3`
(`Submission.NeukirchUchida.Local.LocalGalois.natCard_algEquiv_adicCompletion_eq_finrank`).
-/
import Mathlib
import Submission.Work.SSGRoute.Interfaces
import Submission.NeukirchUchida.Local.Transitivity
import Submission.NeukirchUchida.PrimeCorrespondence
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open SSGRoute

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

namespace Work.SSGRoute.E7Arch

/-- **`Subgroup.zpowers c` is finite when `c ^ 2 = 1`** (it is cyclic of order dividing two). -/
theorem finite_zpowers_of_sq_eq_one {G : Type*} [Group G] (c : G) (hc : c ^ 2 = 1) :
    Finite ↥(Subgroup.zpowers c) := by
  refine Nat.finite_of_card_ne_zero ?_
  rw [Nat.card_zpowers]
  exact (orderOf_pos_iff.mpr (isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by norm_num, hc⟩)).ne'

/-- **`Subgroup.zpowers c` has at most two elements when `c ^ 2 = 1`.** -/
theorem card_zpowers_le_two {G : Type*} [Group G] (c : G) (hc : c ^ 2 = 1) :
    Nat.card ↥(Subgroup.zpowers c) ≤ 2 := by
  rw [Nat.card_zpowers]
  exact Nat.le_of_dvd (by norm_num) (orderOf_dvd_iff_pow_eq_one.mpr hc)

/-- **The reduction of `LocalGroupDisjoint` to one realising level.**  If a finite normal
intermediate field `L` realises a local degree `≥ 3` at the place of `A` (that is, its decomposition
group has at least three elements), then `decomp k A` is not `Subgroup.zpowers c` for any `c` with
`c ^ 2 = 1`: the restriction map `decomp k A →* decompositionSubgroup (placeOf p A hA L)` is onto, so
`decomp k A` has at least three elements, while `Subgroup.zpowers c` has at most two. -/
theorem decomp_ne_zpowers_of_sq_eq_one_of_level
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (hpA : A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k p)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [Normal k L]
    (hL : 3 ≤ Nat.card (Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
      (Submission.NeukirchUchida.Local.placeOf p A hpA L)))
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    SSGRoute.decomp k A ≠ Subgroup.zpowers c := by
  intro heq
  haveI hfin : Finite ↥(SSGRoute.decomp k A) := by
    rw [heq]
    exact finite_zpowers_of_sq_eq_one c hc
  -- the restriction of decomposition groups is onto
  have hsurj : Function.Surjective
      (Submission.NeukirchUchida.Local.decompositionRestrictHom p A hpA L) :=
    Submission.NeukirchUchida.Local.decompositionRestrictHom_surjective p A hpA L
  -- a section of it
  let sec : ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
      (Submission.NeukirchUchida.Local.placeOf p A hpA L)) → ↥(SSGRoute.decomp k A) :=
    fun y => Classical.choose (hsurj y)
  have hsec_spec : ∀ y : ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
      (Submission.NeukirchUchida.Local.placeOf p A hpA L)),
      Submission.NeukirchUchida.Local.decompositionRestrictHom p A hpA L (sec y) = y :=
    fun y => Classical.choose_spec (hsurj y)
  have hsec : Function.Injective sec := by
    intro y₁ y₂ h
    rw [← hsec_spec y₁, ← hsec_spec y₂, h]
  have hle : Nat.card ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
        (Submission.NeukirchUchida.Local.placeOf p A hpA L)) ≤
      Nat.card ↥(SSGRoute.decomp k A) :=
    Nat.card_le_card_of_injective sec hsec
  have h3 : 3 ≤ Nat.card ↥(SSGRoute.decomp k A) := le_trans hL hle
  have h2 : Nat.card ↥(SSGRoute.decomp k A) ≤ 2 := by
    have hcard : Nat.card ↥(SSGRoute.decomp k A) = Nat.card ↥(Subgroup.zpowers c) :=
      congrArg (fun H : Subgroup (Ω ≃ₐ[k] Ω) => Nat.card ↥H) heq
    rw [hcard]
    exact card_zpowers_le_two c hc
  omega

/-- **No finite-place decomposition group is generated by an element of order dividing two**,
conditional on the existence of one finite normal level realising local degree `≥ 3` at the place
(see the header for the arithmetic route to that level). -/
theorem decomp_ne_zpowers_of_sq_eq_one_of_exists_level
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hlevel : ∃ (L : IntermediateField k Ω) (hfin : FiniteDimensional k L) (hnorm : Normal k L),
      letI : FiniteDimensional k L := hfin
      letI : Normal k L := hnorm
      3 ≤ Nat.card (Submission.NeukirchUchida.Local.decompositionSubgroup (K := k)
        (Submission.NeukirchUchida.Local.placeOf (Submission.NeukirchUchida.primeOf A hA) A
          (Submission.NeukirchUchida.primeOf_spec A hA) L)))
    (c : Ω ≃ₐ[k] Ω) (hc : c ^ 2 = 1) :
    SSGRoute.decomp k A ≠ Subgroup.zpowers c := by
  obtain ⟨L, hfin, hnorm, hL⟩ := hlevel
  letI : FiniteDimensional k L := hfin
  letI : Normal k L := hnorm
  exact decomp_ne_zpowers_of_sq_eq_one_of_level k Ω A hA _ (Submission.NeukirchUchida.primeOf_spec A hA)
    L hL c hc

end Work.SSGRoute.E7Arch
