/-!
# Restriction to a finite normal subextension of an element of a topological closure

Let `k ⊆ Ω` be a field extension, `M` a finite-dimensional normal intermediate field, and
`σ x : Ω ≃ₐ[k] Ω`.  If `x` lies in the closure, for the Krull topology, of the cyclic subgroup
generated by `σ`, then its restriction to `M` lies in the cyclic subgroup generated by the
restriction of `σ`.

The proof combines two standard facts:
* `AlgEquiv.restrictNormalHom M` is continuous for the Krull topology
  (`InfiniteGalois.restrictNormalHom_continuous`);
* `Gal(M/k)` is **discrete** when `M/k` is finite dimensional
  (`krullTopology_discreteTopology_of_finiteDimensional`), so every subgroup of it is closed,
  in particular `Subgroup.zpowers _`.
-/

namespace Work.SSGRoute

theorem restrictNormalHom_mem_zpowers_of_mem_topologicalClosure
    (k Ω : Type) [Field k] [Field Ω] [Algebra k Ω]
    (M : IntermediateField k Ω) [FiniteDimensional k M] [Normal k M]
    (σ x : Ω ≃ₐ[k] Ω)
    (hx : x ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ)) :
    AlgEquiv.restrictNormalHom M x ∈ Subgroup.zpowers (AlgEquiv.restrictNormalHom M σ) := by
  let f : (Ω ≃ₐ[k] Ω) →* (M ≃ₐ[k] M) := AlgEquiv.restrictNormalHom M
  have hcont : Continuous f := InfiniteGalois.restrictNormalHom_continuous M
  have hx' : x ∈ closure ((Subgroup.zpowers σ : Subgroup (Ω ≃ₐ[k] Ω)) : Set _) := hx
  have hmem : f x ∈ closure (f '' ((Subgroup.zpowers σ : Subgroup (Ω ≃ₐ[k] Ω)) : Set _)) :=
    image_closure_subset_closure_image hcont ⟨x, hx', rfl⟩
  have himg : f '' ((Subgroup.zpowers σ : Subgroup (Ω ≃ₐ[k] Ω)) : Set _)
      = ((Subgroup.zpowers (f σ) : Subgroup (M ≃ₐ[k] M)) : Set _) := by
    rw [← Subgroup.coe_map, MonoidHom.map_zpowers]
  rw [himg, closure_discrete] at hmem
  exact hmem

end Work.SSGRoute
