/-!
## The corestriction cocycle is a coboundary on the subgroup generated by an involution `c ∉ G_K`

Let `x = corCocycle k Ω K E y sec` be the explicit corestriction cocycle of
`Submission.Work.SSGRoute.exists_corestriction`, i.e.

  `x σ = ∑_{s : Gal(K/k)} s • y (sec(s)⁻¹ · σ · sec((res k K σ)⁻¹ · s))`.

For an involution `c ∈ G_k` (`c ^ 2 = 1`) with `c ∉ G_K = K.fixingSubgroup`, the restriction of `x`
to the cyclic subgroup `⟨c⟩ = Subgroup.zpowers c` (of order `2`) is a coboundary.  The underlying
mathematics is that the sum defining `x c` pairs up: writing `u_s := sec(s)⁻¹ c sec(s₀⁻¹ s)` with
`s₀ = res k K c` one has `u_{s₀ s} = u_s⁻¹`, so with `z_s := s • y(u_s)` we get
`z_{s₀ s} = -(s₀ • z_s)`.  Summing over representatives `T` of the (fixed point free) involution
`t ↦ s₀ t` on `Gal(K/k)` gives

  `x c = ∑_t z_t = ∑_{t∈T} (z_t + z_{s₀ t}) = ∑_{t∈T} z_t - s₀ • ∑_{t∈T} z_t = s₀ • W - W`

for `W = - ∑_{t∈T} z_t`, which is exactly the coboundary condition at `c`.  Since `x` is a cocycle
on all of `G_k` and the set `{g | x g = res(g) • W - W}` is a subgroup containing `c`, it contains
`⟨c⟩`. -/

/-- **Pairing lemma.**  Let `Q` be a finite group and `s ∈ Q` an involution with `s ≠ 1`.  If a
function `z : Q → E` into an `AddCommGroup` with a `DistribMulAction Q E` satisfies
`z (s * t) = -(s • z t)` then `∑_t z t = s • W - W` for an explicit `W`.

Proof: `t ↦ s * t` is a fixed point free involution of `Q`, so it partitions `Q` into the pairs
`{t, s t}`.  Choosing one representative per pair (via `Fintype.equivFin` and the comparison of
`Fin` values) and summing over the partition gives the claim. -/
theorem exists_smul_sub_of_mul_involution {Q E : Type} [Group Q] [Fintype Q]
    [AddCommGroup E] [DistribMulAction Q E]
    (s : Q) (hs : s * s = 1) (hsne : s ≠ 1) (z : Q → E)
    (hz : ∀ t, z (s * t) = -(s • z t)) :
    ∃ W : E, (∑ t, z t) = s • W - W := by
  classical
  let e : Q ≃ Fin (Fintype.card Q) := Fintype.equivFin Q
  let T : Finset Q := Finset.univ.filter (fun t => (e t).val < (e (s * t)).val)
  have hT : ∀ t, t ∈ T ↔ (e t).val < (e (s * t)).val := by
    intro t; simp only [T, Finset.mem_filter, Finset.mem_univ, true_and]
  have hstT : ∀ t, (s * t ∈ T) ↔ (e (s * t)).val < (e t).val := by
    intro t
    have := hT (s * t)
    rwa [show s * (s * t) = t by rw [← mul_assoc, hs, one_mul]] at this
  have hne : ∀ t, s * t ≠ t := by
    intro t h
    exact hsne (mul_right_cancel (h.trans (one_mul t).symm))
  have hene : ∀ t, e t ≠ e (s * t) := fun t h => hne t (e.injective h).symm
  have hvalne : ∀ t, (e t).val ≠ (e (s * t)).val := fun t h => hene t (Fin.ext h)
  -- `T` contains exactly one element of each pair `{t, s t}`
  have hkey : ∀ t, t ∈ T ↔ ¬ (s * t ∈ T) := by
    intro t
    rw [hT t, hstT t]
    exact ⟨fun h h' => absurd h (lt_asymm h'),
      fun h => (lt_or_gt_of_ne (hvalne t)).resolve_right h⟩
  have hcover : T ∪ T.image (fun t => s * t) = Finset.univ := by
    ext t
    simp only [Finset.mem_union, Finset.mem_image, Finset.mem_univ, iff_true]
    by_cases h : t ∈ T
    · exact Or.inl h
    · refine Or.inr ⟨s * t, ?_, by rw [← mul_assoc, hs, one_mul]⟩
      by_contra h'
      exact h ((hkey t).mpr h')
  have hdisj : Disjoint T (T.image (fun t => s * t)) := by
    rw [Finset.disjoint_left]
    intro t ht hti
    obtain ⟨u, hu, hut⟩ := Finset.mem_image.mp hti
    rw [← hut] at ht
    exact (hkey u).mp hu ht
  have hinj : Set.InjOn (fun t => s * t) ↑T := by
    intro a _ b _ hab; exact mul_left_cancel hab
  have hsum : (∑ t, z t) = ∑ t ∈ T, (z t + z (s * t)) := by
    rw [← hcover, Finset.sum_union hdisj, Finset.sum_image hinj, ← Finset.sum_add_distrib]
  have hval : ∀ t ∈ T, z t + z (s * t) = z t - s • z t := by
    intro t _; rw [hz t, sub_eq_add_neg]
  have hL : (∑ t, z t) = (∑ t ∈ T, z t) - s • (∑ t ∈ T, z t) := by
    rw [hsum, Finset.sum_congr rfl hval, Finset.sum_sub_distrib, Finset.smul_sum]
  refine ⟨-(∑ t ∈ T, z t), ?_⟩
  rw [smul_neg, hL]
  abel

/-- **Coboundaries on `⟨c⟩` from the value at `c`.**  If `f` is a `1`-cocycle on all of `Γ` and
`f c = act c • m - m` for a single `m`, then `f` is a coboundary on `Subgroup.zpowers c` with the
same witness `m`: the set `{g | f g = act g • m - m}` is a subgroup of `Γ` (this is where the
cocycle identity is used, together with `f 1 = 0`) containing `c`, hence containing `⟨c⟩`. -/
theorem isCoboundaryOn_zpowers_of_cocycle {Γ G M : Type} [Group Γ] [Group G]
    [AddCommGroup M] [DistribMulAction G M]
    (act : Γ →* G) (f : Γ → M) (hf : SSGRoute.IsCocycleOn act ⊤ f)
    (c : Γ) (m : M) (hc : f c = act c • m - m) :
    SSGRoute.IsCoboundaryOn act (Subgroup.zpowers c) f := by
  have hf1 : f 1 = 0 := by
    have h := hf 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
    simp only [mul_one, map_one, one_smul] at h
    exact add_left_cancel (show f 1 + f 1 = f 1 + 0 by rw [add_zero]; exact h.symm)
  let S : Subgroup Γ :=
    { carrier := {a | f a = act a • m - m}
      one_mem' := by
        change f 1 = act 1 • m - m
        rw [hf1, map_one, one_smul]
        abel
      mul_mem' := by
        intro a b ha hb
        change f a = act a • m - m at ha
        change f b = act b • m - m at hb
        change f (a * b) = act (a * b) • m - m
        rw [hf a (Subgroup.mem_top a) b (Subgroup.mem_top b), ha, hb,
          map_mul, mul_smul, smul_sub]
        abel
      inv_mem' := by
        intro a ha
        change f a = act a • m - m at ha
        change f a⁻¹ = act a⁻¹ • m - m
        have h := hf a (Subgroup.mem_top a) a⁻¹ (Subgroup.mem_top a⁻¹)
        rw [mul_inv_cancel, hf1, ha] at h
        have h2 : act a • f a⁻¹ = m - act a • m := by
          have := eq_neg_of_add_eq_zero_right h.symm
          rw [this]; abel
        calc f a⁻¹ = act a⁻¹ • (act a • f a⁻¹) := by
                rw [← mul_smul, ← map_mul, inv_mul_cancel, map_one, one_smul]
          _ = act a⁻¹ • (m - act a • m) := by rw [h2]
          _ = act a⁻¹ • m - m := by
                rw [smul_sub, ← mul_smul, ← map_mul, inv_mul_cancel, map_one, one_smul] }
  refine ⟨m, fun g hg => ?_⟩
  exact (Subgroup.zpowers_le.mpr (show c ∈ S from hc)) hg

theorem corCocycle_coboundary_of_zpowers_of_not_mem (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K] [Fintype (K ≃ₐ[k] K)]
    (E : Type) [AddCommGroup E] [Module (ZMod p) E] [DistribMulAction (K ≃ₐ[k] K) E]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) E]
    (y : (Ω ≃ₐ[k] Ω) → E)
    (hy : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, y (g * h) = y g + y h)
    (sec : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω)) (hsec : ∀ s, SSGRoute.res k K (sec s) = s) :
    ∀ c : Ω ≃ₐ[k] Ω, c ^ 2 = 1 → c ∉ K.fixingSubgroup →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers c)
        (corCocycle k Ω K E y sec) := by
  intro c hc2 hcH
  -- `s₀ = res k K c` is an involution of `Gal(K/k)` and is nontrivial.
  have hs0sq : SSGRoute.res k K c * SSGRoute.res k K c = 1 := by
    rw [← sq, ← map_pow, hc2, map_one]
  have hs0ne : SSGRoute.res k K c ≠ 1 := by
    intro h
    exact hcH ((mem_fixingSubgroup_iff_res_eq_one k Ω K c).mp h)
  have hcinv : c⁻¹ = c := inv_eq_of_mul_eq_one_right hc2
  -- The "transfer" arguments `u s = sec(s)⁻¹ c sec(s₀⁻¹ s)`, all in `G_K`.
  let u : (K ≃ₐ[k] K) → (Ω ≃ₐ[k] Ω) :=
    fun s => (sec s)⁻¹ * c * sec ((SSGRoute.res k K c)⁻¹ * s)
  have hu_mem : ∀ s, u s ∈ K.fixingSubgroup := fun s =>
    corCocycle_arg_mem k Ω K sec hsec c s
  have hy1 : y 1 = 0 := by
    have h := hy 1 K.fixingSubgroup.one_mem 1 K.fixingSubgroup.one_mem
    simp only [mul_one] at h
    exact add_left_cancel (show y 1 + y 1 = y 1 + 0 by rw [add_zero]; exact h.symm)
  have hy_inv : ∀ a ∈ K.fixingSubgroup, y a⁻¹ = - y a := by
    intro a ha
    have h1 : y (a * a⁻¹) = y a + y a⁻¹ := hy a ha a⁻¹ (K.fixingSubgroup.inv_mem ha)
    rw [mul_inv_cancel, hy1] at h1
    exact eq_neg_of_add_eq_zero_right h1.symm
  -- The pairing `u (s₀ * s) = (u s)⁻¹`.
  have hu_inv : ∀ s, u (SSGRoute.res k K c * s) = (u s)⁻¹ := by
    intro s
    show (sec (SSGRoute.res k K c * s))⁻¹ * c
        * sec ((SSGRoute.res k K c)⁻¹ * (SSGRoute.res k K c * s))
      = ((sec s)⁻¹ * c * sec ((SSGRoute.res k K c)⁻¹ * s))⁻¹
    rw [inv_eq_of_mul_eq_one_right hs0sq,
      show SSGRoute.res k K c * (SSGRoute.res k K c * s) = s by
        rw [← mul_assoc, hs0sq, one_mul],
      mul_inv_rev, mul_inv_rev, inv_inv, hcinv, mul_assoc]
  -- The summand of `x c`.
  let z : (K ≃ₐ[k] K) → E := fun s => s • y (u s)
  have hz : ∀ s, z (SSGRoute.res k K c * s) = -(SSGRoute.res k K c • z s) := by
    intro s
    show (SSGRoute.res k K c * s) • y (u (SSGRoute.res k K c * s))
      = -(SSGRoute.res k K c • (s • y (u s)))
    rw [hu_inv s, hy_inv (u s) (hu_mem s), smul_neg, mul_smul]
  -- `x c = ∑ z` and the pairing produces a coboundary witness.
  obtain ⟨W, hW⟩ := exists_smul_sub_of_mul_involution (SSGRoute.res k K c) hs0sq hs0ne z hz
  have hcf : corCocycle k Ω K E y sec c = ∑ t, z t := by
    simp only [corCocycle, z, u]
  refine isCoboundaryOn_zpowers_of_cocycle (SSGRoute.res k K)
    (corCocycle k Ω K E y sec)
    (corCocycle_isCocycle k Ω K E y hy sec hsec) c W ?_
  rw [hcf, hW]

end Work.SSGRoute
