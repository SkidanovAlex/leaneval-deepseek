open scoped Pointwise

/-!
# Transfer of the local clause `hreal` along conjugation of a place

`Work.SSGRoute.hreal_conj_transfer`: given a datum `η` for the place `A` satisfying the local
clauses of the `hreal` side of Step 4 (additivity on `D_A`, local constancy, vanishing on inertia,
the closure of the twisted image being cyclic, the image of `D_A` in the twist being generated by
the image of `I_A`, and agreement with the cocycle `x` on `D_A`), the same bundle of clauses holds
for the conjugate place `θ · A`, realised by

  `η'(σ) = (res θ) · η(θ⁻¹ σ θ)`.

The two mathematical inputs are the *cocycle* identity `x (θ σ θ⁻¹) = (res θ) · x σ` (which uses
`D_A ≤ G_K`, so that `res` is trivial on `D_A`), and the *equivariance* `gradeInl_conj` of the
graded piece, which identifies the conjugation action of the lift `ψ θ` on `flowTwistE η ψ (D_A)`
with `res θ`, so that `flowTwistE η' ψ (θ σ θ⁻¹) = ψ θ · flowTwistE η ψ σ · (ψ θ)⁻¹`.
-/

/-- Membership in the decomposition group of a translated place. -/
private theorem mem_decomp_psmul_iff (A : ValuationSubring SSGRoute.QBar)
    (θ χ : SSGRoute.GalQ) :
    χ ∈ SSGRoute.decomp ℚ (θ • A) ↔ θ⁻¹ * χ * θ ∈ SSGRoute.decomp ℚ A := by
  rw [MulAction.mem_stabilizer_iff, MulAction.mem_stabilizer_iff]
  constructor
  · intro h
    rw [mul_smul, mul_smul, h, ← mul_smul, inv_mul_cancel, one_smul]
  · intro h
    have h2 : θ • ((θ⁻¹ * χ * θ) • A) = θ • A := by rw [h]
    rw [← mul_smul] at h2
    rw [show θ * (θ⁻¹ * χ * θ) = χ * θ from by group, mul_smul] at h2
    exact h2

/-- The cocycle `x` is `res θ`-equivariant on the decomposition group of `A`: for `σ ∈ D_A`,
`x (θ σ θ⁻¹) = (res θ) · x σ`.  The point is that `σ` acts trivially on `K` (since `D_A ≤ G_K`),
so the inhomogeneous cocycle identity degenerates to this equivariance. -/
private theorem x_conj_of_mem_decomp (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (n i j : ℕ)
    (x : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j)
    (hxmul : ∀ σ τ : SSGRoute.GalQ, x (σ * τ) = x σ + (restrict K σ) • x τ)
    (A : ValuationSubring SSGRoute.QBar)
    (hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup)
    (θ : SSGRoute.GalQ) {σ : SSGRoute.GalQ} (hσ : σ ∈ SSGRoute.decomp ℚ A) :
    x (θ * σ * θ⁻¹) = (restrict K θ) • x σ := by
  have hres : restrict K σ = 1 := restrict_eq_one_of_mem_fixingSubgroup K (hDK σ hσ)
  have hx1 : x 1 = 0 := by
    have h := hxmul 1 1
    simp only [mul_one, map_one, one_smul] at h
    exact add_left_cancel (h.symm.trans (add_zero (x 1)).symm)
  have hxθ : x θ + (restrict K θ) • x θ⁻¹ = 0 := by
    have h := hxmul θ θ⁻¹
    rw [mul_inv_cancel, hx1] at h
    exact h.symm
  have h1 := hxmul θ (σ * θ⁻¹)
  have h2 := hxmul σ θ⁻¹
  rw [← mul_assoc, h2, hres, one_smul] at h1
  rw [h1, smul_add, add_comm ((restrict K θ) • x σ) ((restrict K θ) • x θ⁻¹),
    ← add_assoc, hxθ, zero_add]

/-- The twisted image of the conjugate is the conjugate of the twisted image: for the coefficient
system `η' = (res θ) · η(θ⁻¹ · θ)`, the twist satisfies
`flowTwistE η' ψ (θ σ θ⁻¹) = ψ θ · flowTwistE η ψ σ · (ψ θ)⁻¹`.

This is the equivariance of the graded piece (`gradeInl_conj`), together with `ψ` being a
homomorphism. -/
private theorem twist_conj_apply (p : ℕ) (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K]
    (n i j : ℕ)
    (η : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j)
    (ψ : SSGRoute.GalQ →* Work.CohomologicalShrinking.flowGroup p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2)
    (hψquot : ∀ σ, Work.CohomologicalShrinking.flowQuot p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2 (ψ σ)
      = restrict K σ)
    (θ σ₀ : SSGRoute.GalQ) :
    flowTwistE p K n i j (fun χ => (restrict K θ) • η (θ⁻¹ * χ * θ)) ψ (θ * σ₀ * θ⁻¹)
      = ψ θ * flowTwistE p K n i j η ψ σ₀ * (ψ θ)⁻¹ := by
  change gradeInl p (K ≃ₐ[ℚ] K) n i j
        (Additive.toMul ((restrict K θ) • η (θ⁻¹ * (θ * σ₀ * θ⁻¹) * θ)))
      * ψ (θ * σ₀ * θ⁻¹)
    = ψ θ * (gradeInl p (K ≃ₐ[ℚ] K) n i j (Additive.toMul (η σ₀)) * ψ σ₀) * (ψ θ)⁻¹
  rw [show θ⁻¹ * (θ * σ₀ * θ⁻¹) * θ = σ₀ from by group]
  have hg : gradeInl p (K ≃ₐ[ℚ] K) n i j (Additive.toMul ((restrict K θ) • η σ₀))
      = ψ θ * gradeInl p (K ≃ₐ[ℚ] K) n i j (Additive.toMul (η σ₀)) * (ψ θ)⁻¹ := by
    have hvm : Additive.toMul ((restrict K θ) • η σ₀)
        = (restrict K θ) • Additive.toMul (η σ₀) := rfl
    rw [hvm, ← gradeInl_conj p K n i j ψ θ (hψquot θ) (Additive.toMul (η σ₀))]
  rw [hg, show ψ (θ * σ₀ * θ⁻¹) = ψ θ * ψ σ₀ * (ψ θ)⁻¹ from by rw [map_mul, map_mul, map_inv]]
  group

open scoped Topology

theorem hreal_conj_transfer (p : ℕ) [Fact p.Prime]
    (K : IntermediateField ℚ SSGRoute.QBar) [Normal ℚ K] (n i j : ℕ)
    (x : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j)
    (ψ : SSGRoute.GalQ →* Work.CohomologicalShrinking.flowGroup p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2)
    (hψquot : ∀ σ, Work.CohomologicalShrinking.flowQuot p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2 (ψ σ)
      = Work.SSGRoute.restrict K σ)
    (hxmul : ∀ σ τ : SSGRoute.GalQ, x (σ * τ) = x σ + (Work.SSGRoute.restrict K σ) • x τ)
    (A : ValuationSubring SSGRoute.QBar)
    (hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup)
    (θ : SSGRoute.GalQ)
    (hη : ∃ η : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, η (σ * τ) = η σ + η τ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) η ∧
      (∀ σ, SSGRoute.IsInertia ℚ A σ → η σ = 0) ∧
      IsCyclic (Subgroup.closure
        ((Work.SSGRoute.flowTwistE p K n i j η ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
        Work.SSGRoute.flowTwistE p K n i j η ψ τ = Work.SSGRoute.flowTwistE p K n i j η ψ σ) ∧
      ∀ σ ∈ SSGRoute.decomp ℚ A, x σ = η σ) :
    ∃ η' : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
      (∀ σ ∈ SSGRoute.decomp ℚ (θ • A), ∀ τ ∈ SSGRoute.decomp ℚ (θ • A), η' (σ * τ) = η' σ + η' τ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ (θ • A)) η' ∧
      (∀ σ, SSGRoute.IsInertia ℚ (θ • A) σ → η' σ = 0) ∧
      IsCyclic (Subgroup.closure ((Work.SSGRoute.flowTwistE p K n i j η' ψ) ''
        (SSGRoute.decomp ℚ (θ • A) : Set SSGRoute.GalQ))) ∧
      (∀ σ ∈ SSGRoute.decomp ℚ (θ • A), ∃ τ, SSGRoute.IsInertia ℚ (θ • A) τ ∧
        Work.SSGRoute.flowTwistE p K n i j η' ψ τ = Work.SSGRoute.flowTwistE p K n i j η' ψ σ) ∧
      ∀ σ ∈ SSGRoute.decomp ℚ (θ • A), x σ = η' σ := by
  obtain ⟨η, hηhom, hηlc, hηinertia, hηcyc, hηsurj, hηx⟩ := hη
  let η' : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j :=
    fun σ => (restrict K θ) • η (θ⁻¹ * σ * θ)
  have htwist : ∀ σ₀ : SSGRoute.GalQ,
      flowTwistE p K n i j η' ψ (θ * σ₀ * θ⁻¹)
        = ψ θ * flowTwistE p K n i j η ψ σ₀ * (ψ θ)⁻¹ :=
    fun σ₀ => twist_conj_apply p K n i j η ψ hψquot θ σ₀
  refine ⟨η', ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro σ hσ τ hτ
    have hσ₀ : θ⁻¹ * σ * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ σ).mp hσ
    have hτ₀ : θ⁻¹ * τ * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ τ).mp hτ
    show (restrict K θ) • η (θ⁻¹ * (σ * τ) * θ)
        = (restrict K θ) • η (θ⁻¹ * σ * θ) + (restrict K θ) • η (θ⁻¹ * τ * θ)
    rw [show θ⁻¹ * (σ * τ) * θ = (θ⁻¹ * σ * θ) * (θ⁻¹ * τ * θ) from by group,
      hηhom (θ⁻¹ * σ * θ) hσ₀ (θ⁻¹ * τ * θ) hτ₀, smul_add]
  · obtain ⟨U, hUopen, hU⟩ := hηlc
    refine ⟨U.map (MulAut.conj θ).toMonoidHom, ?_, ?_⟩
    · rw [Subgroup.coe_map]
      change IsOpen ((fun y : SSGRoute.GalQ => θ * y * θ⁻¹) '' (U : Set SSGRoute.GalQ))
      rw [show (fun y : SSGRoute.GalQ => θ * y * θ⁻¹)
          = ⇑((Homeomorph.mulLeft θ).trans (Homeomorph.mulRight θ⁻¹)) from by ext y; rfl]
      exact (Homeomorph.mulLeft θ |>.trans (Homeomorph.mulRight θ⁻¹)).isOpenMap _ hUopen
    · intro g hg u hu huH
      rw [Subgroup.mem_map] at hu
      obtain ⟨v, hvU, hv⟩ := hu
      have huv : θ * v * θ⁻¹ = u := by
        rw [← hv]; exact (MulAut.conj_apply θ v).symm
      have huv' : θ⁻¹ * u * θ = v := by rw [← huv]; group
      have hg₀ : θ⁻¹ * g * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ g).mp hg
      have hu₀ : θ⁻¹ * u * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ u).mp huH
      show (restrict K θ) • η (θ⁻¹ * (g * u) * θ) = (restrict K θ) • η (θ⁻¹ * g * θ)
      rw [show θ⁻¹ * (g * u) * θ = (θ⁻¹ * g * θ) * (θ⁻¹ * u * θ) from by group,
        hU (θ⁻¹ * g * θ) hg₀ (θ⁻¹ * u * θ) (by rw [huv']; exact hvU) hu₀]
  · intro σ hI
    have hσ : σ ∈ SSGRoute.decomp ℚ (θ • A) := hI.1
    have hσ₀ : θ⁻¹ * σ * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ σ).mp hσ
    have hI₀ : SSGRoute.IsInertia ℚ A (θ⁻¹ * σ * θ) := by
      have h : SSGRoute.IsInertia ℚ (θ • A) (θ * (θ⁻¹ * σ * θ) * θ⁻¹) := by
        rwa [show θ * (θ⁻¹ * σ * θ) * θ⁻¹ = σ from by group]
      exact (isInertia_conj A θ (θ⁻¹ * σ * θ)).mp h
    show (restrict K θ) • η (θ⁻¹ * σ * θ) = 0
    rw [hηinertia (θ⁻¹ * σ * θ) hI₀, smul_zero]
  · set S := (flowTwistE p K n i j η ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ) with hS
    set S' := (flowTwistE p K n i j η' ψ) '' (SSGRoute.decomp ℚ (θ • A) : Set SSGRoute.GalQ) with hS'
    have hηcyc' : IsCyclic (Subgroup.closure S) := by rw [hS]; exact hηcyc
    have hmap : Subgroup.closure S' = (Subgroup.closure S).map (MulAut.conj (ψ θ)).toMonoidHom := by
      apply le_antisymm
      · rw [Subgroup.closure_le]
        rintro y ⟨σ, hσ, rfl⟩
        change flowTwistE p K n i j η' ψ σ ∈
          Subgroup.map (MulAut.conj (ψ θ)).toMonoidHom (Subgroup.closure S)
        rw [Subgroup.mem_map]
        refine ⟨flowTwistE p K n i j η ψ (θ⁻¹ * σ * θ), ?_, ?_⟩
        · exact Subgroup.subset_closure
            ⟨θ⁻¹ * σ * θ, (mem_decomp_psmul_iff A θ σ).mp hσ, rfl⟩
        · show ψ θ * flowTwistE p K n i j η ψ (θ⁻¹ * σ * θ) * (ψ θ)⁻¹ = flowTwistE p K n i j η' ψ σ
          conv_rhs => rw [show σ = θ * (θ⁻¹ * σ * θ) * θ⁻¹ from by group]
          rw [htwist (θ⁻¹ * σ * θ)]
      · rw [Subgroup.map_le_iff_le_comap, Subgroup.closure_le]
        rintro y ⟨σ₀, hσ₀, rfl⟩
        change flowTwistE p K n i j η ψ σ₀ ∈
          Subgroup.comap (MulAut.conj (ψ θ)).toMonoidHom (Subgroup.closure S')
        rw [Subgroup.mem_comap]
        show ψ θ * flowTwistE p K n i j η ψ σ₀ * (ψ θ)⁻¹ ∈ Subgroup.closure S'
        refine Subgroup.subset_closure ⟨θ * σ₀ * θ⁻¹, ?_, htwist σ₀⟩
        exact (mem_decomp_psmul_iff A θ (θ * σ₀ * θ⁻¹)).mpr (by
          rw [show θ⁻¹ * (θ * σ₀ * θ⁻¹) * θ = σ₀ from by group]; exact hσ₀)
    rw [hmap]
    exact (MulEquiv.isCyclic (Subgroup.equivMapOfInjective (Subgroup.closure S)
      (MulAut.conj (ψ θ)).toMonoidHom (EquivLike.injective (MulAut.conj (ψ θ))))).mp hηcyc'
  · intro σ hσ
    have hσ₀ : θ⁻¹ * σ * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ σ).mp hσ
    obtain ⟨τ₀, hτ₀I, hτ₀eq⟩ := hηsurj (θ⁻¹ * σ * θ) hσ₀
    refine ⟨θ * τ₀ * θ⁻¹, (isInertia_conj A θ τ₀).mpr hτ₀I, ?_⟩
    rw [htwist τ₀]
    conv_rhs => rw [show σ = θ * (θ⁻¹ * σ * θ) * θ⁻¹ from by group]
    rw [htwist (θ⁻¹ * σ * θ), hτ₀eq]
  · intro σ hσ
    have hσ₀ : θ⁻¹ * σ * θ ∈ SSGRoute.decomp ℚ A := (mem_decomp_psmul_iff A θ σ).mp hσ
    calc x σ = x (θ * (θ⁻¹ * σ * θ) * θ⁻¹) := by
              rw [show θ * (θ⁻¹ * σ * θ) * θ⁻¹ = σ from by group]
      _ = (restrict K θ) • x (θ⁻¹ * σ * θ) := x_conj_of_mem_decomp p K n i j x hxmul A hDK θ hσ₀
      _ = (restrict K θ) • η (θ⁻¹ * σ * θ) := by rw [hηx (θ⁻¹ * σ * θ) hσ₀]
      _ = η' σ := rfl

end Work.SSGRoute
