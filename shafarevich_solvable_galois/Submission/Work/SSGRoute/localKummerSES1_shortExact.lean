/-!
# The Kummer sequence at a local place is short exact

For a place `w` of a number field `K` over a number field `k` (with `K/k` finite Galois) and a
prime `p`, this file proves that the sequence

  `0 → 𝔽_p → K_wˣ → (K_wˣ)^p → 0`

— the first map `z` being any **nonzero** `D_w`-map out of the trivial representation `𝔽_p`, and
the second the `p`-th power map `localPthMap` onto the `p`-th powers `localPthSub` — is short exact.

The mathematical content is the following.  Since `𝔽_p = ZMod p` is generated by `1` as a
`Coeff`-module and is annihilated by `p`, the composite `z ≫ p`-th-power map is zero for *any* `z`
(`localKummerSES1_comp_zero`).  The `p`-th power map is onto its own range by definition
(`localKummerSES1_pthMap_surjective`).  A nonzero `z` does not kill `1`
(`localKummerSES1_one_ne_zero`), whence `z` is injective (`localKummerSES1_injective`) — here we
use that an element of `𝔽_p` killed by `z` is an integral multiple of `1`, so that the
coefficient-combination lemma `eq_zero_of_nsmul_eq_zero_of_coprime` applies to the `p`-torsion
element `z 1`.  Finally, an element killed by the `p`-th power map is a `p`-th root of unity `u` in
the local field `K_w`, and the nonzero value `ζ = z 1` is a primitive `p`-th root of unity (it is
`≠ 1` and `ζ^p = 1`, so its order is `p`); hence `u = ζ^i = z i` by
`IsPrimitiveRoot.eq_pow_of_pow_eq_one` (`localKummerSES1_ker_le_range`).

The three ingredients are fed into the elementwise criterion
`Commons.RepresentationTheory.GroupCohomology.shortExact_of_mono_epi_elementwise`.
-/

namespace Work.SSGRoute

open CategoryTheory SSGRoute.PTExt

set_option linter.unusedSectionVars false

noncomputable section

section Aux

variable (k K : Type) [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]
  [FiniteDimensional k K] [IsGalois k K]
  (w : NK.GlobalCFT.Place K) (p : ℕ) [Fact p.Prime]

/-- **The `p`-th power map `K_wˣ → (K_wˣ)^p` is surjective**: the codomain is by definition the
range of the `p`-th power endomorphism of `K_wˣ`. -/
theorem localKummerSES1_pthMap_surjective :
    Function.Surjective (localPthMap k K w p).hom := by
  intro v
  have hv : ((show ↥(localPthSub k K w p) from v) : localUnitsK (k := k) w) ∈
      localPthSub k K w p := (show ↥(localPthSub k K w p) from v).2
  obtain ⟨u, hu⟩ := (mem_localPthSub_iff k K w p _).mp hv
  refine ⟨u, ?_⟩
  apply Subtype.ext
  show (p : ℕ) • u = ((show ↥(localPthSub k K w p) from v) : localUnitsK (k := k) w)
  exact hu

/-- **The composite `𝔽_p ⟶ K_wˣ ⟶ (K_wˣ)^p` is zero.**  For any `D_w`-map `z` out of the trivial
representation `𝔽_p = ZMod p` the `p`-th power of a value of `z` is zero, because `z` is additive
and `p` kills `𝔽_p`:  `p • z(x) = z(p • x) = z(0) = 0`. -/
theorem localKummerSES1_comp_zero
    (z : Rep.trivial Coeff (decompK (k := k) w) (ZMod p) ⟶ localUnitsK (k := k) w) :
    z ≫ localPthMap k K w p = 0 := by
  refine Rep.hom_ext (Representation.IntertwiningMap.ext (LinearMap.ext ?_))
  intro x
  show (localPthMap k K w p).hom (z.hom x) = 0
  refine Subtype.ext ?_
  show (p : ℕ) • (z.hom x) = 0
  rw [← map_nsmul z.hom p x]
  rw [show (p : ℕ) • x = 0 from by rw [nsmul_eq_mul, ZMod.natCast_self]; simp]
  simp

/-- **A nonzero `D_w`-map `z : 𝔽_p ⟶ K_wˣ` does not kill `1`.**  Since `1` generates `𝔽_p` as a
`Coeff`-module, a map killing `1` is zero. -/
theorem localKummerSES1_one_ne_zero
    (z : Rep.trivial Coeff (decompK (k := k) w) (ZMod p) ⟶ localUnitsK (k := k) w)
    (hz : z ≠ 0) : z.hom (1 : ZMod p) ≠ 0 := by
  intro h
  apply hz
  refine Rep.hom_ext (Representation.IntertwiningMap.ext (LinearMap.ext ?_))
  intro x
  show z.hom x = 0
  obtain ⟨m, hm⟩ := ZMod.intCast_surjective x
  rw [← hm]
  have hcs : ((m : ℤ) : ZMod p) = (ULift.up m : Coeff) • (1 : ZMod p) := by
    rw [ULift.smul_def, zsmul_eq_mul, mul_one]
  rw [hcs, map_smul, h, smul_zero]

/-- **A nonzero `D_w`-map `z : 𝔽_p ⟶ K_wˣ` is injective.**  If `z x = z y` with `x ≠ y`, then
`z` kills the nonzero element `x - y` of the field `𝔽_p`; writing `x - y = n` for
`n = ZMod.val (x - y)` shows that `z 1` is killed both by `p` (as usual) and by the natural number
`n` coprime to `p`, whence `z 1 = 0` by `eq_zero_of_nsmul_eq_zero_of_coprime`. -/
theorem localKummerSES1_injective
    (z : Rep.trivial Coeff (decompK (k := k) w) (ZMod p) ⟶ localUnitsK (k := k) w)
    (hz : z ≠ 0) : Function.Injective z.hom := by
  have hz1 := localKummerSES1_one_ne_zero k K w p z hz
  have hp : Nat.Prime p := Fact.out
  have htors : p • z.hom (1 : ZMod p) = 0 := by
    rw [← map_nsmul z.hom p (1 : ZMod p)]
    rw [show (p : ℕ) • (1 : ZMod p) = 0 from by rw [nsmul_eq_mul, ZMod.natCast_self]; simp]
    simp
  intro a b hab
  by_contra hne
  have hyne : a - b ≠ 0 := by
    intro h
    exact hne (sub_eq_zero.mp h)
  set n := ZMod.val (a - b) with hn
  have hncast : (n : ZMod p) = a - b := ZMod.natCast_zmod_val (a - b)
  have hn0 : 0 < n := (ZMod.val_pos).mpr hyne
  have hnp : n < p := ZMod.val_lt (a - b)
  have hcop : n.Coprime p := by
    rw [Nat.coprime_comm]
    exact (Nat.Prime.coprime_iff_not_dvd hp).mpr (by
      intro hdvd
      have := Nat.le_of_dvd hn0 hdvd
      omega)
  have hzero : n • z.hom (1 : ZMod p) = 0 := by
    have h2 : z.hom ((n : ZMod p)) = n • z.hom (1 : ZMod p) := by
      conv_lhs => rw [show (n : ZMod p) = n • (1 : ZMod p) from by rw [nsmul_eq_mul, mul_one]]
      exact map_nsmul z.hom n 1
    rw [← h2, hncast, map_sub, hab, sub_self]
  exact hz1 (eq_zero_of_nsmul_eq_zero_of_coprime htors hcop hzero)

/-- **Exactness at `K_wˣ`.**  An element of `K_wˣ` killed by the `p`-th power map is a `p`-th root
of unity.  The nonzero value `ζ = z 1` of the Kummer coefficient class `z` is a primitive `p`-th
root of unity in the local field `K_w` (it satisfies `ζ^p = 1` and `ζ ≠ 1`, so `orderOf ζ = p`,
`p` being prime); hence every `p`-th root of unity is a power of `ζ`, and those are exactly the
values of `z`. -/
theorem localKummerSES1_ker_le_range
    (z : Rep.trivial Coeff (decompK (k := k) w) (ZMod p) ⟶ localUnitsK (k := k) w)
    (hz : z ≠ 0) :
    ∀ x : (localUnitsK (k := k) w), (localPthMap k K w p).hom x = 0 →
      ∃ y : ZMod p, z.hom y = x := by
  have hz1 := localKummerSES1_one_ne_zero k K w p z hz
  intro x hx
  have hx0 : (p : ℕ) • x = 0 := by
    have h := congrArg Subtype.val hx
    exact h
  set ζ : (NK.GlobalCFT.Place.localField K w)ˣ := Additive.toMul (z.hom (1 : ZMod p)) with hζdef
  have hz1' : Additive.ofMul ζ = z.hom (1 : ZMod p) := Equiv.apply_symm_apply Additive.ofMul _
  have hζne : ζ ≠ 1 := by
    intro h
    exact hz1 (by rw [← hz1', h]; rfl)
  have hζp : ζ ^ p = 1 := by
    have htors : (p : ℕ) • z.hom (1 : ZMod p) = 0 := by
      rw [← map_nsmul z.hom p (1 : ZMod p)]
      rw [show (p : ℕ) • (1 : ZMod p) = 0 from by rw [nsmul_eq_mul, ZMod.natCast_self]; simp]
      simp
    have h : (p : ℕ) • Additive.ofMul ζ = 0 := by rw [hz1']; exact htors
    rw [nsmul_ofMul_eq] at h
    exact Additive.ofMul.injective (by simpa using h)
  have hp : Nat.Prime p := Fact.out
  have hζprim : IsPrimitiveRoot ((ζ : (NK.GlobalCFT.Place.localField K w)ˣ) :
      NK.GlobalCFT.Place.localField K w) p := by
    rw [IsPrimitiveRoot.iff_orderOf]
    have hdvd : orderOf ((ζ : (NK.GlobalCFT.Place.localField K w)ˣ) :
        NK.GlobalCFT.Place.localField K w) ∣ p := by
      rw [orderOf_dvd_iff_pow_eq_one, ← Units.val_pow_eq_pow_val, hζp, Units.val_one]
    rcases (Nat.dvd_prime hp).mp hdvd with h1 | h2
    · rw [orderOf_eq_one_iff] at h1
      exact absurd h1 (fun h => hζne (Units.ext h))
    · exact h2
  set u : (NK.GlobalCFT.Place.localField K w)ˣ := Additive.toMul x with hudef
  have hx' : Additive.ofMul u = x := Equiv.apply_symm_apply Additive.ofMul x
  have hup : u ^ p = 1 := by
    have h : (p : ℕ) • Additive.ofMul u = 0 := by rw [hx']; exact hx0
    rw [nsmul_ofMul_eq] at h
    exact Additive.ofMul.injective (by simpa using h)
  have huKW : ((u : (NK.GlobalCFT.Place.localField K w)ˣ) :
      NK.GlobalCFT.Place.localField K w) ^ p = 1 := by
    rw [← Units.val_pow_eq_pow_val, hup, Units.val_one]
  obtain ⟨i, _hi, hi⟩ := hζprim.eq_pow_of_pow_eq_one (ξ := ((u :
    (NK.GlobalCFT.Place.localField K w)ˣ) : NK.GlobalCFT.Place.localField K w)) huKW
  have hunit : ζ ^ i = u := Units.ext hi
  refine ⟨(i : ZMod p), ?_⟩
  have hcast : (i : ZMod p) = (i : ℕ) • (1 : ZMod p) := by rw [nsmul_eq_mul, mul_one]
  have h1 : z.hom ((i : ZMod p)) = (i : ℕ) • z.hom (1 : ZMod p) := by
    rw [hcast]; exact map_nsmul z.hom i 1
  have h2 : (i : ℕ) • z.hom (1 : ZMod p) = Additive.ofMul (ζ ^ i) := by
    rw [← hz1']; exact nsmul_ofMul_eq _ i ζ
  rw [h1, h2, hunit, hx']

end Aux

/-- **The Kummer sequence at a local place.**  For a place `w` of a number field `K` over `k` and a
nonzero `D_w`-map `z : 𝔽_p ⟶ K_wˣ` (so that `μ_p ⊆ K_w`), the sequence
`0 → 𝔽_p → K_wˣ → (K_wˣ)^p → 0` — middle map `x ↦ x^p`, last map the surjection onto the `p`-th
powers `localPthSub` — is short exact.  Inputs: `z` is injective with image the `p`-torsion (since
`z(1)` is a primitive `p`-th root of unity and a field has at most `p` of them,
`IsPrimitiveRoot.eq_pow_of_pow_eq_one`), and the `p`-th power map is onto `localPthSub`.

Definitions live in `Submission.Work.SSGRoute.LocalKummerAux`.  Hint: on elements of
`↥(localPthRep k K w p)` use the `show ↥(localPthSub k K w p) from x` idiom of
`kummer_level_defs.pthMapX_surjective`, and
`Commons.RepresentationTheory.GroupCohomology.shortExact_of_mono_epi_elementwise` is the
mono-epi-elementwise criterion (import it from
`Submission.Commons.RepresentationTheory.GroupCohomology.groupCohomology_two_int_iso_one_qmodz`). -/
theorem localKummerSES1_shortExact (k K : Type) [Field k] [NumberField k] [Field K]
    [NumberField K] [Algebra k K] [FiniteDimensional k K] [IsGalois k K]
    (w : NK.GlobalCFT.Place K) (p : ℕ) [Fact p.Prime]
    (z : Rep.trivial Coeff (decompK (k := k) w) (ZMod p) ⟶ localUnitsK (k := k) w)
    (hz : z ≠ 0) :
    ∃ (h0 : z ≫ localPthMap k K w p = 0),
      (ShortComplex.mk z (localPthMap k K w p) h0).ShortExact := by
  refine ⟨localKummerSES1_comp_zero k K w p z, ?_⟩
  refine Commons.RepresentationTheory.GroupCohomology.shortExact_of_mono_epi_elementwise
    (k := Coeff) (G := decompK (k := k) w)
    (ShortComplex.mk z (localPthMap k K w p) (localKummerSES1_comp_zero k K w p z)) ?_ ?_ ?_
  · exact (Rep.mono_iff_injective _).mpr (localKummerSES1_injective k K w p z hz)
  · exact (Rep.epi_iff_surjective _).mpr (localKummerSES1_pthMap_surjective k K w p)
  · intro x hx
    exact localKummerSES1_ker_le_range k K w p z hz x hx

end

end Work.SSGRoute
