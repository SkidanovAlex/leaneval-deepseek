/-!
# The `p = 2` two-place product formula in the `oPairAt` language

This file proves `Work.SSGRoute.H9.swTwoPlacePairingTwo`, the `p = 2` twin of the proved
`Work.SSGRoute.H9.swTwoPlacePairing_zero` (which requires `p ≠ 2`).

The product formula `Work.SSGRoute.ZDataMup.OddForm.oPairForm_sum_attach_eq_zero_of_outside` is
stated for *every* prime `p`; applied to `T' = {Zi, ZN}` it reduces the target to supplying

* (`hout` at finite places) the local factor `oTheta α β 𝔭` is `1` for every finite prime `𝔭` of `↥K`
  which is not below `Zi` or `ZN`.  The finite-place branch of
  `Work.SSGRoute.ZDataMup.OddForm.oTheta_eq_one_of_ne_oddPrime` does this and never uses `p ≠ 2`
  (only the *archimedean* branch of that proof does), so it is extracted here as the auxiliary
  `Work.SSGRoute.H9.oTheta_ofFinite_eq_one_of_outside`;
* (`hout` at archimedean places) the local factor at an infinite place `w` of `↥K` is `1`.  This uses
  the hypothesis `hinfα` (the Kummer class of `α` vanishes at every involution of `K.fixingSubgroup`,
  i.e. `α` is positive at every real place of `↥K`): then the Kummer level `↥K(α^{1/2})` has trivial
  archimedean local extension, so *every* local unit is a norm and `oTheta α β w = 1`.  The
  archimedean local-norm criterion used is
  `Work.SSGRoute.ZDataTwo.not_isLocalNorm_ofInfinite_iff`, packaged here as the auxiliary
  `Work.SSGRoute.H9.localNormSubgroup_hLevel_ofInfinite_of_not_isNegAt`.
-/

open scoped Pointwise

namespace Work.SSGRoute.H9

open _root_.SSGRoute Work.SSGRoute.ZDataMup.OddForm Work.SSGRoute.ZDataMup.LTRecFamHonest

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 2000000

/-- **Archimedean local-norm membership at the quadratic Kummer level, from positivity of `α`.**

Let `α, β ∈ ↥Kˣ` with `α ∉ (↥Kˣ)²` (so that the Kummer level `↥K(α^{1/2})` is quadratic over `↥K`)
and `α` not negative at any infinite place of `↥K`.  Then at every infinite place `w` of `↥K` the
local image of `β` lies in the local norm subgroup of the level `↥K(α^{1/2})`.

The archimedean local-norm criterion `Work.SSGRoute.ZDataTwo.not_isLocalNorm_ofInfinite_iff` says
`¬ IsLocalNorm ↥K ↥(hLevel α) β w ↔ IsNegAt w α ∧ IsNegAt w β`; since `α` is not negative at `w`,
`β` is a local norm, and membership in the local norm *subgroup* follows from
`NK.CFTLib.IdeleHasse.localNormSubgroup_ofInfinite`. -/
theorem localNormSubgroup_hLevel_ofInfinite_of_not_isNegAt {k Ω : Type} [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ 2) (α β : (↥K)ˣ)
    [FiniteDimensional ↥K ↥(hLevel (Ω := Ω) (K := K) (p := 2) α)]
    [IsGalois ↥K ↥(hLevel (Ω := Ω) (K := K) (p := 2) α)]
    [NumberField ↥(hLevel (Ω := Ω) (K := K) (p := 2) α)]
    (hαpow : α ∉ NK.LocalAnabelian.powSubgroup 2 ↥K)
    (hαpos : ∀ w : NumberField.InfinitePlace ↥K, ¬ Work.SSGRoute.ZDataTwo.IsNegAt w α) :
    ∀ w : NumberField.InfinitePlace ↥K,
      NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (NK.GlobalCFT.Place.ofInfinite w) β ∈
        NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K)
          (L := ↥(hLevel (Ω := Ω) (K := K) (p := 2) α))
          (NK.GlobalCFT.Place.ofInfinite w) := by
  -- the Kummer level `↥K(α^{1/2})` is a quadratic extension of `↥K`, generated by a square root of `α`
  -- lying outside `↥K`
  obtain ⟨h2, hy⟩ := hLevel_quadratic_data (k := k) (Ω := Ω) (K := K) ζ hζ α hαpow
  intro w
  have hLN : NK.NUV2.LC.IsLocalNorm ↥K ↥(hLevel (Ω := Ω) (K := K) (p := 2) α) β
      (NK.GlobalCFT.Place.ofInfinite w) := by
    by_contra hbad
    exact hαpos w
      ((Work.SSGRoute.ZDataTwo.not_isLocalNorm_ofInfinite_iff α β _ h2 hy w).mp hbad).1
  rw [NK.CFTLib.IdeleHasse.localNormSubgroup_ofInfinite]
  obtain ⟨w', hlies, hmem⟩ := hLN
  exact Subgroup.mem_iSup_of_mem ⟨w', hlies⟩ hmem

section FiniteBranch

attribute [-instance] Work.SSGRoute.Triv.instSMulOfOne

/-- **The local factor is trivial at a finite place outside the one-sided set `T'`** — the
finite-place branch of `Work.SSGRoute.ZDataMup.OddForm.oTheta_eq_one_of_ne_oddPrime`, extracted at
*arbitrary* prime `p` (that branch never uses `p ≠ 2`: it rests on the local Kummer dictionary
`kummerChar_zero_on_inertia_imp_mem_unramified`, on `isUnramifiedIn_of_inertia_subset_fixingSubgroup`
and on `odd_kummerCharZMod_eq_zero_iff_mem_fixingSubgroup`, all of which hold for every prime `p`). -/
theorem oTheta_ofFinite_eq_one_of_outside {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k]
    [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω]
    [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (a b : (Ω ≃ₐ[k] Ω) → ZMod p) (α β : (↥K)ˣ)
    (hα : ∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
      a σ = Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) p (ζ := ζ) hζ α
        ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩))
    (hβ : ∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
      b σ = Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) p (ζ := ζ) hζ β
        ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩))
    (T' : Finset (ValuationSubring Ω)) (hTfin : ∀ A ∈ T', _root_.SSGRoute.IsFinPlace k A)
    (hunr : ∀ B : ValuationSubring Ω, _root_.SSGRoute.IsFinPlace k B →
      (∀ A ∈ T', ¬ ∃ τ ∈ K.fixingSubgroup, ∀ x : Ω, x ∈ B ↔ (τ⁻¹ : Ω ≃ₐ[k] Ω) • x ∈ A) →
      ∀ σ : Ω ≃ₐ[k] Ω, _root_.SSGRoute.IsInertia k B σ → a σ = 0 ∧ b σ = 0)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K))
    (hv : ∀ A ∈ T'.attach, NK.GlobalCFT.Place.ofFinite
      (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A.1 (hTfin A.1 A.2)) ≠
        NK.GlobalCFT.Place.ofFinite 𝔭) :
    Work.SSGRoute.ZDataMup.OddForm.oTheta (K := K) (p := p) (k := k) (Ω := Ω) ζ hζ α β
      (NK.GlobalCFT.Place.ofFinite 𝔭) = 1 := by
  classical
  by_cases hαpow : α ∈ NK.LocalAnabelian.powSubgroup p ↥K
  · -- the degenerate case: the Kummer level of `α` is `↥K` itself
    have hbot : hLevel (K := K) (Ω := Ω) (p := p) α = ⊥ :=
      NK.LocalAnabelian.Kummer.kummerField_eq_bot_of_mem_powSubgroup (K' := Ω) (k := ↥K) p
        Fact.out hζ hαpow
    haveI : Subsingleton (↥(hLevel (K := K) (Ω := Ω) (p := p) α) ≃ₐ[↥K]
        ↥(hLevel (K := K) (Ω := Ω) (p := p) α)) := by
      rw [hbot]
      refine ⟨fun x y => AlgEquiv.ext fun z => ?_⟩
      obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp z.2
      have hz : z = algebraMap ↥K ↥(⊥ : IntermediateField ↥K Ω) c := (Subtype.ext hc).symm
      rw [hz, AlgEquiv.commutes, AlgEquiv.commutes]
    exact Subsingleton.elim _ _
  · haveI hfdL : FiniteDimensional ↥K ↥(hLevel (K := K) (Ω := Ω) (p := p) α) :=
      hLevel_finiteDimensional (Ω := Ω) (K := K) (p := p) ζ hζ α
    haveI hgalL : IsGalois ↥K ↥(hLevel (K := K) (Ω := Ω) (p := p) α) :=
      hLevel_isGalois (Ω := Ω) (K := K) (p := p) ζ hζ α
    haveI hnfL : NumberField ↥(hLevel (K := K) (Ω := Ω) (p := p) α) :=
      hLevel_numberField (Ω := Ω) (K := K) (p := p) ζ hζ α
    have hcardL : Nat.card (↥(hLevel (K := K) (Ω := Ω) (p := p) α) ≃ₐ[↥K]
        ↥(hLevel (K := K) (Ω := Ω) (p := p) α)) = p := by
      rw [IsGalois.card_aut_eq_finrank,
        (NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank (K' := Ω) (k := ↥K) p
          Fact.out hζ α hαpow).2]
    -- the one-place local factor is `1`
    have hmem : NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
        (NK.GlobalCFT.Place.ofFinite 𝔭) β ∈
        NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K)
          (L := ↥(hLevel (K := K) (Ω := Ω) (p := p) α))
          (NK.GlobalCFT.Place.ofFinite 𝔭) := by
      -- a place `A` of `Ω` above `𝔭`
      obtain ⟨A, hApart⟩ := NK.ReconstructField.exists_finitePlace_of_prime_level
        (K₁ := k) (K₁' := Ω) K 𝔭
      -- `A` is not `K`-conjugate to any element of `T'`
      have hnc : ∀ A' ∈ T', ¬ ∃ τ ∈ K.fixingSubgroup, ∀ x : Ω, x ∈ A.1 ↔
          (τ⁻¹ : Ω ≃ₐ[k] Ω) • x ∈ A' := by
        intro A' hA' hconj
        have hprime := oddPrime_eq_of_exists_conj (K := K) (A := A') (B := A.1)
          (hTfin A' hA') A.2 hconj
        have hA'p : oddPrime (K := K) A.1 A.2 = 𝔭 := by
          apply Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := ↥K)
          rw [← oddPrime_spec (K := K) (A := A.1) A.2, hApart]
        exact hv ⟨A', hA'⟩ (Finset.mem_attach T' _) (by rw [hprime, hA'p])
      -- the Kummer character of `β` vanishes on the inertia of `A`
      have hchiβ : ∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
          SSGRoute.IsInertia k A.1 σ →
          Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) p (ζ := ζ) hζ β
            ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) = 0 :=
        fun σ hσ hI => (hβ σ hσ).symm.trans (hunr A.1 A.2 hnc σ hI).2
      -- hence the local image of `β` at `𝔭` is a `p`-th power times a local unit
      obtain ⟨γ, u, hu, hβeq⟩ :=
        Work.SSGRoute.ZDataMup.LocalUnramified.kummerChar_zero_on_inertia_imp_mem_unramified
          p k Ω K ζ hζ A.1 A.2 𝔭 hApart β hchiβ
      have hloc : NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
          (NK.GlobalCFT.Place.ofFinite 𝔭) β = γ ^ p * u := by
        rw [show NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
            (NK.GlobalCFT.Place.ofFinite 𝔭) β =
            Units.map (algebraMap ↥K (𝔭.adicCompletion ↥K)) β from rfl]
        exact hβeq
      -- `𝔭` is unramified in the Kummer level of `α`
      have hunrlvl : NK.HeckeL.IsUnramifiedIn (K := ↥K)
          (L := ↥(hLevel (K := K) (Ω := Ω) (p := p) α)) 𝔭 := by
        refine Work.SSGRoute.ZDataMup.isUnramifiedIn_of_inertia_subset_fixingSubgroup
          (K := ↥K) (Ω := Ω) (hLevel (K := K) (Ω := Ω) (p := p) α) 𝔭 ?_
        intro B hB hBp σ hI
        have hBk : SSGRoute.IsFinPlace k B := isFinPlace_of_isFinPlace_level (K := K) B hB
        have hncB : ∀ A' ∈ T', ¬ ∃ τ ∈ K.fixingSubgroup,
            ∀ x : Ω, x ∈ B ↔ (τ⁻¹ : Ω ≃ₐ[k] Ω) • x ∈ A' := by
          intro A' hA' hconj
          have hprime := oddPrime_eq_of_exists_conj (K := K) (A := A') (B := B)
            (hTfin A' hA') hBk hconj
          have hBp' : oddPrime (K := K) B hBk = 𝔭 := by
            apply Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := ↥K)
            rw [← oddPrime_spec (K := K) (A := B) hBk, hBp]
          exact hv ⟨A', hA'⟩ (Finset.mem_attach T' _) (by rw [hprime, hBp'])
        have hτmem : σ.restrictScalars k ∈ K.fixingSubgroup := by
          rw [IntermediateField.mem_fixingSubgroup_iff]
          intro x hx
          exact σ.commutes ⟨x, hx⟩
        have heq : (IntermediateField.fixingSubgroupEquiv K)
            ⟨σ.restrictScalars k, hτmem⟩ = σ := by
          ext x
          rfl
        have hIfin : SSGRoute.IsInertia k B (σ.restrictScalars k) :=
          (Work.SSGRoute.isInertia_baseChange k Ω K B (σ.restrictScalars k) hτmem).mp
            (by rw [heq]; exact hI)
        have hχ : Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) p (ζ := ζ) hζ α σ = 0 := by
          have h0 := (hunr B hBk hncB (σ.restrictScalars k) hIfin).1
          rw [hα (σ.restrictScalars k) hτmem, heq] at h0
          exact h0
        exact (Work.SSGRoute.ZDataMup.OddForm.odd_kummerCharZMod_eq_zero_iff_mem_fixingSubgroup
          (K := K) ζ hζ α σ).mp hχ
      rw [hloc]
      refine Subgroup.mul_mem _ ?_ ?_
      · exact Work.SSGRoute.ZConstruction.mem_localNormSubgroup_of_mem_powRange
          (K := ↥K) (L := ↥(hLevel (K := K) (Ω := Ω) (p := p) α)) hcardL
          (NK.GlobalCFT.Place.ofFinite 𝔭) (γ ^ p) ⟨γ, by rw [powMonoidHom_apply]⟩
      · exact NK.CFTLib.IdeleHasse.localUnits_le_localNormSubgroup_of_unramified
          (K := ↥K) (L := ↥(hLevel (K := K) (Ω := Ω) (p := p) α)) 𝔭 hunrlvl hu
    unfold oTheta
    exact (Work.SSGRoute.ZDataMup.oddArtin_onePlace (K := K)
      (hLevel (K := K) (Ω := Ω) (p := p) α)
      (hLevel_isMulCommutative (Ω := Ω) (K := K) (p := p) ζ hζ α)
      (NK.GlobalCFT.Place.ofFinite 𝔭)
      (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K) (NK.GlobalCFT.Place.ofFinite 𝔭) β)).mpr hmem

end FiniteBranch

/-- **The `p = 2` two-place product formula in the `oPairAt` language** (the `p = 2` twin of the proved `Work.SSGRoute.H9.swTwoPlacePairing_zero`, which requires `p ≠ 2`).  Two Kummer classes `χ_α`, `χ_β` unramified outside their own marked place `Zi`, resp. `ZN` (`hconfα`, `hconfβ`), with `α`'s archimedean (involution) terms vanishing (`hinfα`), have local pairings at the two marked places summing to zero.

Intended proof: `Work.SSGRoute.ZDataMup.OddForm.oPairForm_sum_attach_eq_zero_of_outside` (stated for every prime `p`) with `T' = {Zi, ZN}` and `hout` discharged (i) at finite places by the finite-place branch of `Work.SSGRoute.ZDataMup.OddForm.oTheta_eq_one_of_ne_oddPrime` (that branch is `p`-independent), (ii) at archimedean places by `hinfα` (the Kummer level of `α` is trivial at every real place of `↥K`, so the local norm subgroup is everything at `v`). -/
theorem swTwoPlacePairingTwo {k Ω : Type} [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ 2) (hζK : ζ ∈ K)
    (α β : (↥K)ˣ)
    (Zi ZN : ValuationSubring Ω) (hZi : _root_.SSGRoute.IsFinPlace k Zi)
    (hZN : _root_.SSGRoute.IsFinPlace k ZN)
    (hZiN : ¬ Work.SSGRoute.gesKConj K Zi ZN)
    (hconfα : ∀ B : ValuationSubring Ω, _root_.SSGRoute.IsFinPlace k B →
      (¬ Work.SSGRoute.gesKConj K Zi B) →
      ∀ u : Ω ≃ₐ[k] Ω, _root_.SSGRoute.IsInertia k B u →
        Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α u = 0)
    (hconfβ : ∀ B : ValuationSubring Ω, _root_.SSGRoute.IsFinPlace k B →
      (¬ Work.SSGRoute.gesKConj K ZN B) →
      ∀ u : Ω ≃ₐ[k] Ω, _root_.SSGRoute.IsInertia k B u →
        Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β u = 0)
    (hinfα : ∀ c ∈ K.fixingSubgroup, c ^ 2 = 1 →
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α c = 0) :
    Work.SSGRoute.ZDataMup.OddForm.oPairAt (K := K) (p := 2) (k := k) (Ω := Ω)
        (⟨ζ, hζK⟩ : ↥K) (Work.SSGRoute.ZSplit.isPrimitiveRoot_subtype_of_mem_zmod hζK hζ)
        Zi hZi (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
        (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β)
      + Work.SSGRoute.ZDataMup.OddForm.oPairAt (K := K) (p := 2) (k := k) (Ω := Ω)
        (⟨ζ, hζK⟩ : ↥K) (Work.SSGRoute.ZSplit.isPrimitiveRoot_subtype_of_mem_zmod hζK hζ)
        ZN hZN (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
        (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β) = 0 := by
  classical
  set ζ' : ↥K := ⟨ζ, hζK⟩ with hζ'def
  have hζ' : IsPrimitiveRoot ζ' 2 :=
    Work.SSGRoute.ZSplit.isPrimitiveRoot_subtype_of_mem_zmod hζK hζ
  set T' : Finset (ValuationSubring Ω) := {Zi, ZN} with hT'def
  have hZi_mem : Zi ∈ T' := by rw [hT'def]; exact Finset.mem_insert_self _ _
  have hZN_mem : ZN ∈ T' := by
    rw [hT'def]; exact Finset.mem_insert_of_mem (Finset.mem_singleton_self _)
  have hZiZN : Zi ≠ ZN := fun h => hZiN ⟨1, K.fixingSubgroup.one_mem, by rw [h, one_smul]⟩
  have hTfin : ∀ A ∈ T', _root_.SSGRoute.IsFinPlace k A := by
    intro A hA
    rw [hT'def, Finset.mem_insert, Finset.mem_singleton] at hA
    rcases hA with rfl | rfl
    · exact hZi
    · exact hZN
  have hTdisj : ∀ A ∈ T', ∀ B ∈ T',
      (∃ τ ∈ K.fixingSubgroup, ∀ x : Ω, x ∈ B ↔ (τ⁻¹ : Ω ≃ₐ[k] Ω) • x ∈ A) → A = B := by
    intro A hA B hB hconj
    have hAZ : A = Zi ∨ A = ZN := by
      rw [hT'def, Finset.mem_insert, Finset.mem_singleton] at hA
      exact hA
    have hBZ : B = Zi ∨ B = ZN := by
      rw [hT'def, Finset.mem_insert, Finset.mem_singleton] at hB
      exact hB
    rcases hAZ with hAZ | hAZ
    · rcases hBZ with hBZ | hBZ
      · rw [hAZ, hBZ]
      · exfalso
        rw [hAZ, hBZ] at hconj
        exact absurd ((gesKConj_iff_smul_form (K := K) Zi ZN).mpr hconj) hZiN
    · rcases hBZ with hBZ | hBZ
      · exfalso
        rw [hAZ, hBZ] at hconj
        exact absurd (gesKConj_symm'' (A := ZN) (B := Zi)
          ((gesKConj_iff_smul_form (K := K) ZN Zi).mpr hconj)) hZiN
      · rw [hAZ, hBZ]
  -- the two Kummer cochains
  have hacoc : SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α) := by
    intro g hg h hh
    rw [Work.SSGRoute.ZSplit.nodeKummerCocharZMod_add K ζ hζK hζ α g hg h hh]
    rfl
  have hbcoc : SSGRoute.IsCocycleOn (SSGRoute.res k K) K.fixingSubgroup
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β) := by
    intro g hg h hh
    rw [Work.SSGRoute.ZSplit.nodeKummerCocharZMod_add K ζ hζK hζ β g hg h hh]
    rfl
  have hαeq : ∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α σ =
        Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) 2 (ζ := ζ') hζ' α
          ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) :=
    fun σ hσ => Work.SSGRoute.ZSplit.nodeKummerCocharZMod_apply (K := K) (ζ := ζ)
      (hζK := hζK) (hζ := hζ) (β := α) hσ
  have hβeq : ∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β σ =
        Work.SSGRoute.kummerCharZMod (Ω := Ω) (K := ↥K) 2 (ζ := ζ') hζ' β
          ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) :=
    fun σ hσ => Work.SSGRoute.ZSplit.nodeKummerCocharZMod_apply (K := K) (ζ := ζ)
      (hζK := hζK) (hζ := hζ) (β := β) hσ
  -- `α` is positive at every real place of `↥K`
  have hnotneg : ∀ w : NumberField.InfinitePlace ↥K, ¬ Work.SSGRoute.ZDataTwo.IsNegAt w α :=
    Work.SSGRoute.ZDataTwo.not_isNegAt_of_involution_condition (k := k) (Ω := Ω) K ζ' hζ' α
      (fun c hc hc2 => by
        rw [show Work.SSGRoute.gesGalKOfFixing K c hc =
            (IntermediateField.fixingSubgroupEquiv K) ⟨c, hc⟩ from rfl]
        exact (hαeq c hc).symm.trans (hinfα c hc hc2))
  -- the local factors outside `T'` are trivial
  have hout : ∀ v : NK.GlobalCFT.Place ↥K,
      (∀ A ∈ T'.attach, NK.GlobalCFT.Place.ofFinite
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A.1 (hTfin A.1 A.2)) ≠ v) →
      Work.SSGRoute.ZDataMup.OddForm.oTheta (K := K) (p := 2) (k := k) (Ω := Ω)
        ζ' hζ' α β v = 1 := by
    intro v hv
    rcases v with w | 𝔭
    · -- archimedean place
      by_cases hαpow : α ∈ NK.LocalAnabelian.powSubgroup 2 ↥K
      · -- degenerate case: the Kummer level of `α` is `↥K` itself
        have hbot : hLevel (Ω := Ω) (K := K) (p := 2) α = ⊥ :=
          NK.LocalAnabelian.Kummer.kummerField_eq_bot_of_mem_powSubgroup (K' := Ω) (k := ↥K) 2
            Fact.out hζ' hαpow
        haveI : Subsingleton (↥(hLevel (Ω := Ω) (K := K) (p := 2) α) ≃ₐ[↥K]
            ↥(hLevel (Ω := Ω) (K := K) (p := 2) α)) := by
          rw [hbot]
          refine ⟨fun x y => AlgEquiv.ext fun z => ?_⟩
          obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp z.2
          have hz : z = algebraMap ↥K ↥(⊥ : IntermediateField ↥K Ω) c := (Subtype.ext hc).symm
          rw [hz, AlgEquiv.commutes, AlgEquiv.commutes]
        exact Subsingleton.elim _ _
      · haveI hfdL : FiniteDimensional ↥K ↥(hLevel (Ω := Ω) (K := K) (p := 2) α) :=
          hLevel_finiteDimensional (Ω := Ω) (K := K) (p := 2) ζ' hζ' α
        haveI hgalL : IsGalois ↥K ↥(hLevel (Ω := Ω) (K := K) (p := 2) α) :=
          hLevel_isGalois (Ω := Ω) (K := K) (p := 2) ζ' hζ' α
        haveI hnfL : NumberField ↥(hLevel (Ω := Ω) (K := K) (p := 2) α) :=
          hLevel_numberField (Ω := Ω) (K := K) (p := 2) ζ' hζ' α
        have hmem : NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
            (NK.GlobalCFT.Place.ofInfinite w) β ∈
            NK.CFTLib.IdeleHasse.localNormSubgroup (K := ↥K)
              (L := ↥(hLevel (Ω := Ω) (K := K) (p := 2) α))
              (NK.GlobalCFT.Place.ofInfinite w) :=
          localNormSubgroup_hLevel_ofInfinite_of_not_isNegAt (K := K) (k := k) (Ω := Ω)
            ζ' hζ' α β hαpow hnotneg w
        unfold Work.SSGRoute.ZDataMup.OddForm.oTheta
        exact (Work.SSGRoute.ZDataMup.oddArtin_onePlace (K := K)
          (hLevel (Ω := Ω) (K := K) (p := 2) α)
          (hLevel_isMulCommutative (Ω := Ω) (K := K) (p := 2) ζ' hζ' α)
          (NK.GlobalCFT.Place.ofInfinite w)
          (NK.CFTLib.IdeleHasse.localImageAt (K := ↥K)
            (NK.GlobalCFT.Place.ofInfinite w) β)).mpr hmem
    · -- finite place
      refine oTheta_ofFinite_eq_one_of_outside (p := 2) (K := K) (k := k) (Ω := Ω) ζ' hζ'
        _ _ α β hαeq hβeq T' hTfin ?_ 𝔭 hv
      intro B hB hnc σ hσI
      exact ⟨
        hconfα B hB (fun hc => hnc Zi hZi_mem ((gesKConj_iff_smul_form (K := K) Zi B).mp hc))
          σ hσI,
        hconfβ B hB (fun hc => hnc ZN hZN_mem ((gesKConj_iff_smul_form (K := K) ZN B).mp hc))
          σ hσI⟩
  -- the product formula over `T' = {Zi, ZN}`
  have hsum : ∑ A ∈ T'.attach,
      Work.SSGRoute.ZDataMup.OddForm.oPairForm (K := K) (p := 2) (k := k) (Ω := Ω) ζ' hζ'
        (hTfin A.1 A.2)
        (Work.SSGRoute.toClass 2 k Ω K (ZMod 2) (SSGRoute.decomp k A.1 ⊓ K.fixingSubgroup)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α))
        (Work.SSGRoute.toClass 2 k Ω K (ZMod 2) (SSGRoute.decomp k A.1 ⊓ K.fixingSubgroup)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β)) = 0 :=
    Work.SSGRoute.ZDataMup.OddForm.oPairForm_sum_attach_eq_zero_of_outside
      (K := K) (p := 2) (k := k) (Ω := Ω) ζ' hζ'
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β) α β
      hacoc (Work.SSGRoute.ZSplit.nodeKummerCocharZMod_locConst K ζ hζK hζ α)
      hbcoc (Work.SSGRoute.ZSplit.nodeKummerCocharZMod_locConst K ζ hζK hζ β)
      hαeq hβeq T' hTfin hTdisj hout
  -- the collapse of the sum to the two escape terms
  have hattach : T'.attach = ({⟨Zi, hZi_mem⟩, ⟨ZN, hZN_mem⟩} :
      Finset {A : ValuationSubring Ω // A ∈ T'}) := by
    apply Finset.ext
    intro x
    obtain ⟨a, ha⟩ := x
    constructor
    · intro _
      have ha' := ha
      rw [hT'def, Finset.mem_insert, Finset.mem_singleton] at ha'
      rw [Finset.mem_insert, Finset.mem_singleton]
      rcases ha' with h | h
      · exact Or.inl (Subtype.ext h)
      · exact Or.inr (Subtype.ext h)
    · intro _
      exact Finset.mem_attach T' ⟨a, ha⟩
  have hne : (⟨Zi, hZi_mem⟩ : {A : ValuationSubring Ω // A ∈ T'}) ≠ ⟨ZN, hZN_mem⟩ :=
    fun h => hZiZN (congrArg Subtype.val h)
  have hpair : (∑ A ∈ T'.attach,
      Work.SSGRoute.ZDataMup.OddForm.oPairForm (K := K) (p := 2) (k := k) (Ω := Ω) ζ' hζ'
        (hTfin A.1 A.2)
        (Work.SSGRoute.toClass 2 k Ω K (ZMod 2) (SSGRoute.decomp k A.1 ⊓ K.fixingSubgroup)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α))
        (Work.SSGRoute.toClass 2 k Ω K (ZMod 2) (SSGRoute.decomp k A.1 ⊓ K.fixingSubgroup)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β)))
      = Work.SSGRoute.ZDataMup.OddForm.oPairAt (K := K) (p := 2) (k := k) (Ω := Ω) ζ' hζ'
          Zi hZi (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β)
        + Work.SSGRoute.ZDataMup.OddForm.oPairAt (K := K) (p := 2) (k := k) (Ω := Ω) ζ' hζ'
          ZN hZN (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
          (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ β) := by
    rw [hattach, Finset.sum_insert (by simp only [Finset.mem_singleton]; exact hne),
      Finset.sum_singleton]
    congr 1
  rw [hpair] at hsum
  exact hsum

end Work.SSGRoute.H9
