/-!
# The promotion of a Frobenius value to the local group, at a Kummer level

The §4(b) chain of Schmidt--Wingberg computes the *value* `z(ψ) = 0` of the class
`z = χ_{b_i} + χ_{b_N} = χ_{b_i b_N}` at a Frobenius element `ψ` of the local group at the sibling
`A = σQ_N` of the last escape prime.  The last step of the paper's argument promotes this value to
the *whole* local group.

The level-based promotion (`Work.SSGRoute.ZSplit.localValue_eq_zero_of_isFrobAtPrime`) needs an
auxiliary level `L` that is simultaneously unramified at `A` and contains the Kummer level of `z` —
and at the sibling of a ramified escape prime the *`k`-Galois* closure of such an `L` is always
ramified (`NOTE_pinning_and_promotion_session7.md` §1), so that route is a dead end.
Schmidt--Wingberg's own step is the one formalised here: since `z` is the Kummer cochain of the level
`M := ↥K((b_i b_N)^{1/p})` (so that `z` kills `Gal(Ω|M) ∩ G_K`) and the decomposition group of `A`
maps onto its cyclic quotient modulo `Gal(Ω|M)`, generated by the pinned Frobenius `ψ`
(`Work.SSGRoute.ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime`), the value at `ψ` determines `z`
on the whole local group.

This file also contains the level bookkeeping used by the assembly: the compositum of the Kummer
levels of a finite set of elements, and the transport of a Kummer sub-level into a bigger level.
-/

open _root_.SSGRoute
open Work.SSGRoute.ZDataMup.LTRecFamHonest

namespace Work.SSGRoute.H9

variable {p : ℕ} [Fact p.Prime] {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
  [IsAlgClosure k Ω] [IsAlgClosed Ω]
  {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
  [IsSepClosure ↥K Ω]
  [DistribMulAction (K ≃ₐ[k] K) (ZMod p)] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) (ZMod p)]

/-! ## The compositum of a finite family of Kummer levels -/

/-- **The compositum of the Kummer levels of a finite set of elements of `↥K^×`.** -/
noncomputable def swKummerSup (W : Finset (↥K)ˣ) : IntermediateField ↥K Ω :=
  W.sup (fun w => hLevel (Ω := Ω) (K := K) (p := p) w)

theorem swKummerSup_finiteDimensional (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (W : Finset (↥K)ˣ) : FiniteDimensional ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) := by
  classical
  induction W using Finset.induction_on with
  | empty => rw [swKummerSup, Finset.sup_empty]; infer_instance
  | insert a s _ha ih =>
      rw [swKummerSup, Finset.sup_insert]
      haveI h1 : FiniteDimensional ↥K ↥(hLevel (Ω := Ω) (K := K) (p := p) a) :=
        hLevel_finiteDimensional (Ω := Ω) (K := K) (p := p) ζ hζ a
      haveI h2 : FiniteDimensional ↥K
          ↥(s.sup (fun w => hLevel (Ω := Ω) (K := K) (p := p) w)) := ih
      exact IntermediateField.finiteDimensional_sup _ _

theorem swKummerSup_normal (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (W : Finset (↥K)ˣ) : Normal ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) := by
  classical
  induction W using Finset.induction_on with
  | empty => rw [swKummerSup, Finset.sup_empty]; infer_instance
  | insert a s _ha ih =>
      rw [swKummerSup, Finset.sup_insert]
      haveI h1 : Normal ↥K ↥(hLevel (Ω := Ω) (K := K) (p := p) a) :=
        (hLevel_isGalois (Ω := Ω) (K := K) (p := p) ζ hζ a).to_normal
      haveI h2 : Normal ↥K
          ↥(s.sup (fun w => hLevel (Ω := Ω) (K := K) (p := p) w)) := ih
      exact IntermediateField.normal_sup ↥K Ω _ _

theorem swKummerSup_isGalois (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (W : Finset (↥K)ˣ) : IsGalois ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) := by
  haveI hfd : FiniteDimensional ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) :=
    swKummerSup_finiteDimensional (Ω := Ω) (K := K) (p := p) ζ hζ W
  haveI hnorm : Normal ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) :=
    swKummerSup_normal (Ω := Ω) (K := K) (p := p) ζ hζ W
  exact { to_isSeparable := Algebra.isSeparable_tower_bot_of_isSeparable ↥K ↥(swKummerSup (p := p) (K := K) (Ω := Ω) W) Ω, to_normal := inferInstance }

theorem swKummerSup_numberField (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (W : Finset (↥K)ˣ) : NumberField ↥(swKummerSup (p := p) (K := K) (Ω := Ω) W) := by
  haveI hfd : FiniteDimensional ↥K (swKummerSup (p := p) (K := K) (Ω := Ω) W) :=
    swKummerSup_finiteDimensional (Ω := Ω) (K := K) (p := p) ζ hζ W
  exact Commons.NumberTheory.NumberField.numberField_of_intermediateField
    (swKummerSup (p := p) (K := K) (Ω := Ω) W)

theorem hLevel_le_swKummerSup {W : Finset (↥K)ˣ} {w : (↥K)ˣ} (hw : w ∈ W) :
    hLevel (Ω := Ω) (K := K) (p := p) w ≤ swKummerSup (p := p) (K := K) (Ω := Ω) W :=
  Finset.le_sup (f := fun w => hLevel (Ω := Ω) (K := K) (p := p) w) hw

/-! ## Transporting a Kummer sub-level into a bigger level -/

/-- **A Kummer sub-level of `Λ`, as a level over `↥K` together with its identification with
`hLevel w`.**  If `hLevel w ≤ Λ` then the preimage `M := (val Λ) ⁻¹' (hLevel w)` of the Kummer level
in `↥Λ` is a finite normal (`↥K`-)subfield of `↥Λ` which is canonically isomorphic to `hLevel w`.
This is the input `M, e` of `Work.SSGRoute.H9.swPinnedFrob_sublevel`. -/
theorem swSubfieldOf (Λ : IntermediateField ↥K Ω) [FiniteDimensional ↥K Λ] [IsGalois ↥K Λ]
    [NumberField ↥Λ]
    (w : (↥K)ˣ) [FiniteDimensional ↥K ↥(hLevel (Ω := Ω) (K := K) (p := p) w)]
    [Normal ↥K ↥(hLevel (Ω := Ω) (K := K) (p := p) w)]
    [NumberField ↥(hLevel (Ω := Ω) (K := K) (p := p) w)]
    (hle : hLevel (Ω := Ω) (K := K) (p := p) w ≤ Λ) :
    ∃ (M : IntermediateField ↥K ↥Λ)
      (e : ↥M ≃ₐ[↥K] ↥(hLevel (Ω := Ω) (K := K) (p := p) w)),
      (∀ x : ↥M, (e x : Ω) = ((x : ↥Λ) : Ω)) ∧
        FiniteDimensional ↥K ↥M ∧ NumberField ↥M ∧ Normal ↥K ↥M := by
  classical
  let M0 : IntermediateField ↥K ↥Λ :=
    IntermediateField.comap (IntermediateField.val Λ) (hLevel (Ω := Ω) (K := K) (p := p) w)
  have hMmem : ∀ x : ↥Λ, x ∈ M0 ↔ (x : Ω) ∈ hLevel (Ω := Ω) (K := K) (p := p) w :=
    fun _x => Iff.rfl
  let e0 : ↥M0 ≃ₐ[↥K] ↥(hLevel (Ω := Ω) (K := K) (p := p) w) :=
    { toFun := fun x => ⟨(x : ↥Λ), (hMmem x).mp x.2⟩
      invFun := fun y => ⟨⟨(y : Ω), hle y.2⟩, (hMmem ⟨(y : Ω), hle y.2⟩).mpr (by simpa using y.2)⟩
      left_inv := fun x => Subtype.ext rfl
      right_inv := fun y => Subtype.ext rfl
      map_mul' := fun x y => Subtype.ext rfl
      map_add' := fun x y => Subtype.ext rfl
      commutes' := fun c => Subtype.ext rfl }
  have he0 : ∀ x : ↥M0, (e0 x : Ω) = ((x : ↥Λ) : Ω) := fun _x => rfl
  haveI hfdM : FiniteDimensional ↥K ↥M0 :=
    Module.Finite.of_surjective (e0.symm.toLinearMap)
      e0.symm.surjective
  have hnfM : NumberField ↥M0 :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField M0
  haveI hnfM' : NumberField ↥M0 := hnfM
  have hnormM : Normal ↥K ↥M0 := Normal.of_algEquiv e0.symm
  exact ⟨M0, e0, he0, hfdM, hnfM, hnormM⟩

/-! ## The promotion -/

/-- **The promotion of a Frobenius value to the local group at a Kummer level.**  If the additive
cochain `z` kills `Gal(Ω|M) ∩ G_K` for a Kummer level `M` which is unramified at the finite place
`A`, and `z` vanishes at an element `ψ` of the local group whose image in `Gal(M/↥K)` is the
canonical Frobenius at the prime below `A`, then `z` vanishes on the whole local group at `A`. -/
theorem swLocalValue_eq_zero_of_level_isFrobAtPrime
    (M : IntermediateField ↥K Ω) [FiniteDimensional ↥K M] [IsGalois ↥K M] [NumberField ↥M]
    (A : ValuationSubring Ω) (hA : SSGRoute.IsFinPlace k A)
    (hunrM : NK.HeckeL.IsUnramifiedIn (K := ↥K) (L := ↥M)
      (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA))
    (z : (Ω ≃ₐ[k] Ω) → ZMod p)
    (hzadd : ∀ g ∈ K.fixingSubgroup, ∀ h ∈ K.fixingSubgroup, z (g * h) = z g + z h)
    (hkerM : ∀ u : K.fixingSubgroup,
      AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) M
        ((IntermediateField.fixingSubgroupEquiv K) u) = 1 → z u = 0)
    (ψ : Ω ≃ₐ[k] Ω) (hψ : ψ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hpin : NK.Chebotarev.IsFrobAtPrime (K := ↥K) (L := ↥M)
      (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA)
      (AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω) M
        ((IntermediateField.fixingSubgroupEquiv K) ⟨ψ, (Subgroup.mem_inf.mp hψ).2⟩)))
    (hval : z ψ = 0) :
    ∀ τ ∈ SSGRoute.decomp k A ⊓ K.fixingSubgroup, z τ = 0 := by
  classical
  intro τ hτ
  have hAK : A.comap (algebraMap ↥K Ω) ≠ ⊤ :=
    Work.SSGRoute.ZConstruction.isFinPlace_of_isFinPlace_below (K := K) (A := A) hA
  set 𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ↥K) :=
    Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA with h𝔮
  have h𝔮spec : A.comap (algebraMap ↥K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥K 𝔮 :=
    Work.SSGRoute.ZDataMup.OddForm.oddPrime_spec (K := K) (A := A) hA
  -- the prime below `A` is unramified in `M`
  have hpram : (Work.SSGRoute.levelPrime ↥K Ω A hAK M).asIdeal.ramificationIdx
      (NumberField.RingOfIntegers ↥K) = 1 := by
    refine hunrM (Work.SSGRoute.levelPrime ↥K Ω A hAK M) ?_
    have h := NK.ResidueFrob.primeOfLevel_liesOver (K := ↥K) (K' := Ω) ⟨A, hAK⟩ M
    have hprime : Submission.NeukirchUchida.primeOf A hAK =
        Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA := rfl
    rw [hprime] at h
    exact h
  -- the elements of the local group, in `K.fixingSubgroup`
  set ψK : K.fixingSubgroup := ⟨ψ, (Subgroup.mem_inf.mp hψ).2⟩ with hψK
  set τK : K.fixingSubgroup := ⟨τ, (Subgroup.mem_inf.mp hτ).2⟩ with hτK
  have hψD : (IntermediateField.fixingSubgroupEquiv K) ψK ∈ SSGRoute.decomp ↥K A :=
    (Work.SSGRoute.toGkHom_mem_decomp K A _).mp
      (show Work.SSGRoute.toGkHom K ((IntermediateField.fixingSubgroupEquiv K) ψK) ∈
        SSGRoute.decomp k A from by
        rw [Work.SSGRoute.toGkHom_fixingSubgroupEquiv]; exact (Subgroup.mem_inf.mp hψ).1)
  have hτD : (IntermediateField.fixingSubgroupEquiv K) τK ∈ SSGRoute.decomp ↥K A :=
    (Work.SSGRoute.toGkHom_mem_decomp K A _).mp
      (show Work.SSGRoute.toGkHom K ((IntermediateField.fixingSubgroupEquiv K) τK) ∈
        SSGRoute.decomp k A from by
        rw [Work.SSGRoute.toGkHom_fixingSubgroupEquiv]; exact (Subgroup.mem_inf.mp hτ).1)
  -- the quotient of the local group by `Gal(Ω|M)` is generated by the pinned Frobenius
  have hmap := Work.SSGRoute.ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime ↥K Ω M A hAK
    𝔮 h𝔮spec hpram ((IntermediateField.fixingSubgroupEquiv K) ψK) hψD hpin
  have hmem : SSGRoute.res ↥K M ((IntermediateField.fixingSubgroupEquiv K) τK) ∈
      (SSGRoute.decomp ↥K A).map (SSGRoute.res ↥K M) :=
    Subgroup.mem_map.mpr ⟨_, hτD, rfl⟩
  rw [hmap] at hmem
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp hmem
  -- `v := τ · ψ^{-m}` fixes `M`
  have hconv : (IntermediateField.fixingSubgroupEquiv K) (τK * ψK ^ (-m)) =
      (IntermediateField.fixingSubgroupEquiv K) τK *
        ((IntermediateField.fixingSubgroupEquiv K) ψK) ^ (-m) := by
    rw [map_mul, map_zpow]
  have hres : SSGRoute.res ↥K M
      ((IntermediateField.fixingSubgroupEquiv K) (τK * ψK ^ (-m))) = 1 := by
    rw [hconv, map_mul, map_zpow, ← hm, zpow_neg]
    exact mul_inv_cancel _
  have hzv : z ((τK * ψK ^ (-m) : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) = 0 :=
    hkerM (τK * ψK ^ (-m)) hres
  -- coercions of the subtype group elements
  have hc1 : ((τK * ψK ^ (-m) : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) = τ * ψ ^ (-m) := by
    simp only [Subgroup.coe_mul, Subgroup.coe_zpow]
    rw [hτK, hψK]
  have hc2 : ((ψK ^ m : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) = ψ ^ m := by
    simp only [Subgroup.coe_zpow]
    rw [hψK]
  -- the `m`-th power of `ψ`
  have hzpow : z ((ψK ^ m : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) = m • z ψ := by
    rw [hc2]
    exact Work.SSGRoute.ZSplit.z_zpow_eq_zsmul hzadd ψ (Subgroup.mem_inf.mp hψ).2 m
  -- assemble
  have hτeq : (τ : Ω ≃ₐ[k] Ω) = ((τK * ψK ^ (-m) : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) *
      ((ψK ^ m : K.fixingSubgroup) : Ω ≃ₐ[k] Ω) := by
    rw [hc1, hc2]
    group
  rw [hτeq, hzadd _ (τK * ψK ^ (-m)).2 _ (ψK ^ m).2, hzv, zero_add, hzpow, hval, smul_zero]
end Work.SSGRoute.H9
