/-- **A `ZMod 2`-valued quantity sandwiched between integral multiples of the other is determined.**
If `b = m • a` and `a = m' • b` in `ZMod 2`, then `a = b`: by the parity of `m` either `b = 0` (and
then `a = m' • b = 0`) or `b = a`.  This is the parity step of `lPinnedFrobValue_eq`, in the form
in which it arises there: applying the `res k L`-power bookkeeping in both directions produces the
two integral multiples, and `ZMod 2` has only the two values `0` and `1`. -/
lemma zmodTwo_eq_of_zsmul_eq {a b : ZMod 2} {m m' : ℤ} (hb : b = m • a) (ha : a = m' • b) :
    a = b := by
  have h01 : ∀ x : ZMod 2, x = 0 ∨ x = 1 := by decide
  have hmul : b = (m : ZMod 2) * a := by rw [hb, zsmul_eq_mul]
  rcases h01 (m : ZMod 2) with hm0 | hm1
  · rw [hm0, zero_mul] at hmul
    rw [ha, hmul]
    simp
  · rw [hm1, one_mul] at hmul
    exact hmul.symm

/-- **All `L`-pinned Frobenius elements of a local group give the same Kummer value.**  Let `A` be a finite place over the `k`-prime `𝔭`, `L/k` finite Galois and unramified at `A`, and suppose the Kummer cochain of `α` kills the level-`L` kernel of the local group `D := decomp k A ⊓ K.fixingSubgroup` (`hker`); then any two elements of `D` whose restrictions to `L` are Frobenius elements at `𝔭` give the *same* value of the Kummer cochain of `α`.

This is the pinning statement which makes the value of `χ_α` at an `L`-pinned element well defined (the analogous odd-`p` declaration was the defect recorded for `ZDataMup.swChainTwoPlaceValue_fixed`; here the four `hker_*` hypotheses of the target supply `hker`).

Intended argument (elementary, no CFT): `hker` says `χ_α` kills the kernel of `res k L` on `D`, so `χ_α|_D = Φ ∘ (res k L)` for a homomorphism `Φ` of the image `I := res k L '' D ⊆ Gal(L/k)`.  Since `L/k` is unramified at `𝔭` (`hunrL`), the decomposition group of `A`'s prime at the level `L` is cyclic, `M := (decomp k A).map (res k L)` (available by `ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime`, unramifiedness from `hunrL`), generated by `res k L g` of order `f` (the residue degree); `I ⊆ M` contains `res k L g`, so `I = M`, and `res k L g'` is another generator, i.e. `res k L g' = (res k L g)^k` with `gcd(k, f) = 1`.  Hence `χ g' = k • χ g`; if `f` is even then `k` is odd and `k • χ g = χ g`; if `f` is odd then `f • χ g = χ (g^f) = χ 1 = 0` and `f` is odd in `ZMod 2`, so `χ g = 0`, and likewise `χ g' = 0`.  In both cases the two values agree.

(`ZSplit.localValue_eq_zsmul_of_res_eq_zpow` is the on-disk tool for the `res k L`-power bookkeeping; the parity argument is the new content.) -/
theorem lPinnedFrobValue_eq {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ 2) (hζK : ζ ∈ K) (α : (↥K)ˣ)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    (A : ValuationSubring Ω) (hA : _root_.SSGRoute.IsFinPlace k A)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (h𝔭 : A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k 𝔭)
    (hunrL : ¬ _root_.SSGRoute.IsRamifiedIn k L A)
    (hker : ∀ u ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup, _root_.SSGRoute.res k L u = 1 →
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α u = 0)
    (g g' : Ω ≃ₐ[k] Ω)
    (hg : g ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hg' : g' ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hfg : NK.Chebotarev.IsFrobAtPrime (K := k) (L := L) 𝔭 (_root_.SSGRoute.res k L g))
    (hfg' : NK.Chebotarev.IsFrobAtPrime (K := k) (L := L) 𝔭 (_root_.SSGRoute.res k L g')) :
    Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α g
      = Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α g' := by
  have hz := Work.SSGRoute.ZSplit.nodeKummerCocharZMod_add K ζ hζK hζ α
  obtain ⟨m, hm⟩ := Work.SSGRoute.ZSplit.localValue_eq_zsmul_of_isFrobAtPrime K L A hA 𝔭 h𝔭
    hunrL (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α) hz g hg hfg hker g' hg'
  obtain ⟨m', hm'⟩ := Work.SSGRoute.ZSplit.localValue_eq_zsmul_of_isFrobAtPrime K L A hA 𝔭 h𝔭
    hunrL (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α) hz g' hg' hfg' hker g hg
  exact zmodTwo_eq_of_zsmul_eq hm hm'

end Work.SSGRoute.H9
