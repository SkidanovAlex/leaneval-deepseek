/-! ## The passage between `G_k`-elements fixing `K` and `↥K`-automorphisms

The two pinning regimes of the target live at different bases: the `L`-pinning is a statement
about `G_k = Gal(Ω/k)`, while the Kummer pinning `hpin` is a statement about the Kummer level
`K(α^{1/2})` *over* `↥K`, i.e. about `Gal(Ω/↥K)`.  The three elementary lemmas below are the
translation between the two languages.  (They are the reverse direction of
`Work.SSGRoute.N2v2.restrictScalars_mem_decomp` / the companion lemmas of the `N2v2` lane.) -/

/-- **The `↥K`-automorphism underlying an element of `G_k` fixing `K`**: for `σ ∈ Gal(Ω/↥K)`,
the element of `K.fixingSubgroup` given by `σ.restrictScalars k` has `σ` as its
`fixingSubgroupEquiv`-image. -/
theorem fixingSubgroupEquiv_restrictScalars {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    {K : IntermediateField k Ω} (σ : Ω ≃ₐ[↥K] Ω) :
    (IntermediateField.fixingSubgroupEquiv K) ⟨σ.restrictScalars k, by
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      exact σ.commutes ⟨x, hx⟩⟩ = σ := by
  ext x
  rfl

/-- **A `↥K`-automorphism of `Ω` fixes `K`** (as an element of `Gal(Ω/k)`, after restricting
scalars). -/
theorem restrictScalars_mem_fixingSubgroup {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    {K : IntermediateField k Ω} (σ : Ω ≃ₐ[↥K] Ω) :
    σ.restrictScalars k ∈ K.fixingSubgroup := by
  rw [IntermediateField.mem_fixingSubgroup_iff]
  intro x hx
  exact σ.commutes ⟨x, hx⟩

/-- **The decomposition group of a place is stable under the passage `Gal(Ω/↥K) → Gal(Ω/k)`**:
if `σ.restrictScalars k` lies in the decomposition group of `A` over `k`, then `σ` lies in the
decomposition group of `A` over `↥K`. -/
theorem mem_decomp_of_restrictScalars {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    {K : IntermediateField k Ω} {A : ValuationSubring Ω} {σ : Ω ≃ₐ[↥K] Ω}
    (hσ : σ.restrictScalars k ∈ _root_.SSGRoute.decomp k A) :
    σ ∈ _root_.SSGRoute.decomp (k := ↥K) A := by
  have hsmul : (σ.restrictScalars k : Ω ≃ₐ[k] Ω) • A = σ • A := by
    apply ValuationSubring.ext
    intro x
    rw [ValuationSubring.mem_smul_pointwise_iff_exists,
      ValuationSubring.mem_smul_pointwise_iff_exists]
    constructor <;> rintro ⟨s, hs, hx⟩ <;>
      exact ⟨s, hs, by rw [← hx, AlgEquiv.smul_def, AlgEquiv.smul_def]; rfl⟩
  rw [_root_.SSGRoute.decomp, MulAction.mem_stabilizer_iff] at hσ ⊢
  rw [← hsmul, hσ]

/-- **The value of a Kummer cochain at an `L`-pinned element equals its value at a Kummer-pinned element of the same local group.**  Let `A` be a finite place over the `k`-prime `𝔭`, `L/k` finite Galois unramified at `A`, `α ∈ (↥K)ˣ` with Kummer level `K(α^{1/2})` unramified at `A` (`hkill`), and suppose the Kummer cochain of `α` kills the level-`L` kernel of the local group `D := decomp k A ⊓ K.fixingSubgroup` (`hker`).  If `gt ∈ D` is pinned at the level `L` (`hfrob`) and `ψ ∈ D` is pinned at the Kummer level (`hpin`, the hypothesis of the local dictionary `Work.SSGRoute.H9.CV2.oPairAt_eq_value_of_odd_count`), then the two values of the Kummer cochain of `α` agree.

This is the link between the two pinning regimes, i.e. the step which turns the target's `L`-pinned elements into Kummer-pinned ones (the odd-`p` twin is the *missing* slot recorded for `ZDataMup.swChainTwoPlaceValue_fixed`).

Proposed route: on `D`, `χ_α` is read off `res_{hLevel α}` (its zero set is "fixes the Kummer field", `kummerCharZMod_eq_zero_iff_apply_sqrt`), and `hker` makes `χ_α|_D = Φ ∘ (res k L)`; `hfrob` plus `ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime` makes `res k L '' D` cyclic, generated by `res k L gt` (whose restriction to `hLevel α` is the canonical Frobenius by `hpin`).  Hence `Φ` is a homomorphism from a cyclic group into `ZMod 2`: if the order is odd then `Φ = 0` and both values vanish; if it is even and `Φ ≠ 0` then `χ_α ψ = 1` and the two-way sandwich `Work.SSGRoute.H9.zmodTwo_eq_of_zsmul_eq` applied with `ZSplit.localValue_eq_zsmul_of_res_eq_zpow` (in both directions) gives `χ_α gt = χ_α ψ`.

Implementation note.  The sandwich is run in the two available pinnings: `hker` together with
`hfrob` and `ZSplit.localValue_eq_zsmul_of_isFrobAtPrime` at the level `L` gives
`χ_α ψ = m₁ • χ_α gt`, while `hkill` (through
`H9.swIsUnramifiedIn_hLevel_of_kills_inertia`) together with `hpin` gives — by exact Kummer
faithfulness on the level `K(α^{1/2})` — that `χ_α` kills the kernel of the restriction to the
Kummer level on the whole `↥K`-local group, so that
`ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime` (at the base `↥K`) and
`ZSplit.localValue_eq_zsmul_of_res_eq_zpow` give `χ_α gt = m₂ • χ_α ψ`.  The parity lemma
`zmodTwo_eq_of_zsmul_eq` then concludes. -/
theorem lPinned_eq_kummerPinnedValue {k Ω : Type} [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    {K : IntermediateField k Ω} [FiniteDimensional k K] [IsGalois k K] [NumberField ↥K]
    [IsSepClosure ↥K Ω]
    (ζ : Ω) (hζ : IsPrimitiveRoot ζ 2) (hζK : ζ ∈ K) (α : (↥K)ˣ)
    (L : IntermediateField k Ω) [FiniteDimensional k L] [IsGalois k L]
    (A : ValuationSubring Ω) (hA : _root_.SSGRoute.IsFinPlace k A)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k))
    (h𝔭 : A.comap (algebraMap k Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime k 𝔭)
    (hunrL : ¬ _root_.SSGRoute.IsRamifiedIn k L A)
    (hker : ∀ u ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup, _root_.SSGRoute.res k L u = 1 →
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α u = 0)
    (hkill : ∀ u ∈ K.fixingSubgroup, _root_.SSGRoute.IsInertia k A u →
      Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α u = 0)
    [FiniteDimensional ↥K (Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α)]
    [IsGalois ↥K (Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α)]
    [NumberField ↥(Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α)]
    (gt ψ : Ω ≃ₐ[k] Ω)
    (hgt : gt ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hψ : ψ ∈ _root_.SSGRoute.decomp k A ⊓ K.fixingSubgroup)
    (hfrob : NK.Chebotarev.IsFrobAtPrime (K := k) (L := L) 𝔭 (_root_.SSGRoute.res k L gt))
    (hpin : AlgEquiv.restrictNormalHom (F := ↥K) (K₁ := Ω)
        (Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α)
        ((IntermediateField.fixingSubgroupEquiv K) ⟨ψ, (Subgroup.mem_inf.mp hψ).2⟩) =
      NK.Chebotarev.frobAtPrime (K := ↥K)
        (L := ↥(Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α))
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA)) :
    Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α
        |> (fun _ => Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α gt
      = Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α ψ) := by
  classical
  -- ## Direction 1: at the level `L`, `ψ` is a power of the pinned `gt`
  obtain ⟨m₁, hm₁⟩ : ∃ m : ℤ, Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α ψ
      = m • Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α gt :=
    Work.SSGRoute.ZSplit.localValue_eq_zsmul_of_isFrobAtPrime K L A hA 𝔭 h𝔭 hunrL
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α)
      (Work.SSGRoute.ZSplit.nodeKummerCocharZMod_add K ζ hζK hζ α) gt hgt hfrob hker ψ hψ
  -- ## Direction 2: at the Kummer level, `gt` is a power of the pinned `ψ`
  obtain ⟨m₂, hm₂⟩ : ∃ m : ℤ, Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α gt
      = m • Work.SSGRoute.ZSplit.nodeKummerCocharZMod K ζ hζK hζ α ψ := by
    -- abbreviations: the Kummer level and the two elements as `↥K`-automorphisms
    set hLev := Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel (Ω := Ω) (K := K) (p := 2) α
      with hLevdef
    set ψ' : Ω ≃ₐ[↥K] Ω :=
      (IntermediateField.fixingSubgroupEquiv K) ⟨ψ, (Subgroup.mem_inf.mp hψ).2⟩ with hψ'def
    set gt' : Ω ≃ₐ[↥K] Ω :=
      (IntermediateField.fixingSubgroupEquiv K) ⟨gt, (Subgroup.mem_inf.mp hgt).2⟩ with hgt'def
    -- (i) the Kummer level is unramified over `↥K` at the prime below `A` (`hkill`)
    have hunrK : NK.HeckeL.IsUnramifiedIn (K := ↥K) (L := ↥hLev)
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA) :=
      Work.SSGRoute.H9.swIsUnramifiedIn_hLevel_of_kills_inertia (p := 2) ζ hζ hζK α A hA hkill
    have h𝔮 := Work.SSGRoute.ZDataMup.OddForm.oddPrime_spec (K := K) (A := A) hA
    have hA' : _root_.SSGRoute.IsFinPlace ↥K A :=
      Work.SSGRoute.ZDataMup.OddForm.oddFinPlace (K := K) hA
    -- (ii) the Kummer level has prime degree, hence commutative Galois group, hence the chosen
    -- Frobenius is a Frobenius; `hpin` says it is the restriction of `ψ`
    have hcomm : ∀ a b : ↥hLev ≃ₐ[↥K] ↥hLev, a * b = b * a :=
      Work.SSGRoute.ZDataMup.LTRecFamHonest.hLevel_isMulCommutative (ζ := (⟨ζ, hζK⟩ : ↥K))
        (Work.SSGRoute.ZSplit.isPrimitiveRoot_subtype_of_mem_zmod hζK hζ) α
    have hfrob' : NK.Chebotarev.IsFrobAtPrime (K := ↥K) (L := ↥hLev)
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA)
        ((AlgEquiv.restrictNormalHom hLev) ψ') := by
      rw [(NK.Chebotarev.isFrobAtPrime_iff_frobAtPrime_eq hcomm
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA) hunrK
        ((AlgEquiv.restrictNormalHom hLev) ψ'))]
      exact hpin.symm
    -- (iii) the ramification index of the prime of the Kummer level below `A` is `1`
    have hpram : (Work.SSGRoute.levelPrime ↥K Ω A hA' hLev).asIdeal.ramificationIdx
        (NumberField.RingOfIntegers ↥K) = 1 := by
      apply hunrK
      have h := NK.ResidueFrob.primeOfLevel_liesOver (K := ↥K) (K' := Ω)
        (⟨A, hA'⟩ : NK.FrobeniusBridge.FinitePlaceOf ↥K Ω) hLev
      have hprimeOf : Submission.NeukirchUchida.primeOf A hA' =
          Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA := by
        apply Commons.RingTheory.Valuation.valuationSubringAtPrime_injective (K := ↥K)
        rw [← Submission.NeukirchUchida.primeOf_spec A hA', h𝔮]
      simp only [Work.SSGRoute.levelPrime]
      rwa [hprimeOf] at h
    -- (iv) the two elements as elements of `Gal(Ω/↥K)` are the given ones, and they lie in the
    -- `↥K`-decomposition group of `A`
    have hψ'restrict : ψ'.restrictScalars k = ψ := by
      have h1 : (IntermediateField.fixingSubgroupEquiv K)
          ⟨ψ'.restrictScalars k, restrictScalars_mem_fixingSubgroup (k := k) (Ω := Ω) (K := K) ψ'⟩
          = ψ' :=
        fixingSubgroupEquiv_restrictScalars (k := k) (Ω := Ω) (K := K) ψ'
      have h2 : (IntermediateField.fixingSubgroupEquiv K)
          ⟨ψ, (Subgroup.mem_inf.mp hψ).2⟩ = ψ' := hψ'def.symm
      exact congrArg Subtype.val
        ((IntermediateField.fixingSubgroupEquiv K).injective (h1.trans h2.symm))
    have hgt'restrict : gt'.restrictScalars k = gt := by
      have h1 : (IntermediateField.fixingSubgroupEquiv K)
          ⟨gt'.restrictScalars k, restrictScalars_mem_fixingSubgroup (k := k) (Ω := Ω) (K := K) gt'⟩
          = gt' :=
        fixingSubgroupEquiv_restrictScalars (k := k) (Ω := Ω) (K := K) gt'
      have h2 : (IntermediateField.fixingSubgroupEquiv K)
          ⟨gt, (Subgroup.mem_inf.mp hgt).2⟩ = gt' := hgt'def.symm
      exact congrArg Subtype.val
        ((IntermediateField.fixingSubgroupEquiv K).injective (h1.trans h2.symm))
    have hψ'mem : ψ' ∈ _root_.SSGRoute.decomp (k := ↥K) A :=
      mem_decomp_of_restrictScalars (k := k) (Ω := Ω) (K := K)
        (by rw [hψ'restrict]; exact (Subgroup.mem_inf.mp hψ).1)
    have hgt'mem : gt' ∈ _root_.SSGRoute.decomp (k := ↥K) A :=
      mem_decomp_of_restrictScalars (k := k) (Ω := Ω) (K := K)
        (by rw [hgt'restrict]; exact (Subgroup.mem_inf.mp hgt).1)
    -- (v) the local group of the Kummer level is generated by the pinned `ψ`
    have hmap : Subgroup.map (AlgEquiv.restrictNormalHom hLev)
        (_root_.SSGRoute.decomp (k := ↥K) A)
        = Subgroup.zpowers ((AlgEquiv.restrictNormalHom hLev) ψ') :=
      Work.SSGRoute.ZDataTwo.map_decomp_res_eq_zpowers_of_isFrobAtPrime ↥K Ω hLev A hA'
        (Work.SSGRoute.ZDataMup.OddForm.oddPrime (K := K) A hA) h𝔮 hpram ψ' hψ'mem hfrob'
    obtain ⟨m, hm⟩ : ∃ m : ℤ, (AlgEquiv.restrictNormalHom hLev) gt'
        = ((AlgEquiv.restrictNormalHom hLev) ψ') ^ m := by
      have hmem : (AlgEquiv.restrictNormalHom hLev) gt' ∈
          Subgroup.map (AlgEquiv.restrictNormalHom hLev) (_root_.SSGRoute.decomp (k := ↥K) A) :=
        Subgroup.mem_map.mpr ⟨gt', hgt'mem, rfl⟩
      rw [hmap] at hmem
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hmem
      exact ⟨n, hn.symm⟩
    -- (vi) the `↥K`-level Kummer cochain `z := χ_α ∘ restrictScalars` is additive on the local
    -- group, and kills the kernel of the restriction to the Kummer level (Kummer faithfulness)
    have hz : ∀ g ∈ (⊥ : IntermediateField ↥K Ω).fixingSubgroup,
        ∀ h ∈ (⊥ : IntermediateField ↥K Ω).fixingSubgroup,
        (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (σ.restrictScalars k))
            (g * h)
          = (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (σ.restrictScalars k)) g
            + (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α
                (σ.restrictScalars k)) h := by
      intro g _ h _
      show ZSplit.nodeKummerCocharZMod K ζ hζK hζ α ((g * h).restrictScalars k)
          = ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (g.restrictScalars k)
            + ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (h.restrictScalars k)
      have hmul : (g * h).restrictScalars k = g.restrictScalars k * h.restrictScalars k := by
        ext x; rfl
      rw [hmul]
      exact ZSplit.nodeKummerCocharZMod_add K ζ hζK hζ α (g.restrictScalars k)
        (restrictScalars_mem_fixingSubgroup (k := k) (Ω := Ω) (K := K) g) (h.restrictScalars k)
        (restrictScalars_mem_fixingSubgroup (k := k) (Ω := Ω) (K := K) h)
    have hker' : ∀ u ∈ _root_.SSGRoute.decomp (k := ↥K) A
        ⊓ (⊥ : IntermediateField ↥K Ω).fixingSubgroup,
        (AlgEquiv.restrictNormalHom hLev) u = 1 →
          (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α
            (σ.restrictScalars k)) u = 0 := by
      intro u _ hu1
      show ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (u.restrictScalars k) = 0
      have huK : u.restrictScalars k ∈ K.fixingSubgroup :=
        restrictScalars_mem_fixingSubgroup (k := k) (Ω := Ω) (K := K) u
      rw [ZSplit.nodeKummerCocharZMod_apply (K := K) (ζ := ζ) (hζK := hζK) (hζ := hζ)
        (β := α) huK]
      rw [fixingSubgroupEquiv_restrictScalars (k := k) (Ω := Ω) (K := K) u]
      refine (Work.SSGRoute.ZDataMup.OddForm.odd_kummerCharZMod_eq_zero_iff_mem_fixingSubgroup
        (K := K) (p := 2) (⟨ζ, hζK⟩ : ↥K)
        (ZSplit.isPrimitiveRoot_subtype_of_mem_zmod hζK hζ) α u).mpr ?_
      refine (IntermediateField.mem_fixingSubgroup_iff hLev u).mpr (fun x hx => ?_)
      have h := congrArg (fun (g : ↥hLev ≃ₐ[↥K] ↥hLev) => (g ⟨x, hx⟩ : Ω)) hu1
      rwa [AlgEquiv.restrictNormalHom_apply] at h
    have hψ'' : ψ' ∈ _root_.SSGRoute.decomp (k := ↥K) A
        ⊓ (⊥ : IntermediateField ↥K Ω).fixingSubgroup :=
      Subgroup.mem_inf.mpr ⟨hψ'mem,
        by rw [IntermediateField.fixingSubgroup_bot]; exact Subgroup.mem_top _⟩
    have hgt'' : gt' ∈ _root_.SSGRoute.decomp (k := ↥K) A
        ⊓ (⊥ : IntermediateField ↥K Ω).fixingSubgroup :=
      Subgroup.mem_inf.mpr ⟨hgt'mem,
        by rw [IntermediateField.fixingSubgroup_bot]; exact Subgroup.mem_top _⟩
    have hkey : (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α
          (σ.restrictScalars k)) gt'
        = m • (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α
            (σ.restrictScalars k)) ψ' :=
      ZSplit.localValue_eq_zsmul_of_res_eq_zpow (k := ↥K) (⊥ : IntermediateField ↥K Ω) hLev A
        (fun σ : Ω ≃ₐ[↥K] Ω => ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (σ.restrictScalars k)) hz
        ψ' hψ'' gt' hgt'' m hm hker'
    change ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (gt'.restrictScalars k)
        = m • ZSplit.nodeKummerCocharZMod K ζ hζK hζ α (ψ'.restrictScalars k) at hkey
    rw [hgt'restrict, hψ'restrict] at hkey
    exact ⟨m, hkey⟩
  -- ## The parity step
  exact zmodTwo_eq_of_zsmul_eq hm₁ hm₂

end Work.SSGRoute.H9
