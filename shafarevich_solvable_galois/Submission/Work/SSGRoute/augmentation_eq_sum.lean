/-!
# The augmentation submodule as sums of `g • a - a`

The augmentation submodule `Work.Tate.augmentation G A` is defined as the additive subgroup
generated by the elements `g • a - a`.  Here we record the completely explicit form of this
fact: every element of the augmentation submodule is a finite sum of elements of the shape
`g • a - a`.

The point is that the generating set `S = {g • a - a}` is closed under negation
(`-(g • a - a) = g⁻¹ • (g • a) - g • a`), so the closure consists of *nonnegative* finite sums
of elements of `S`, with no integer coefficients needed.  Consequently the closure induction
only ever produces sums over a finite type, which is exactly the shape occurring in the
augmentation-coboundary computations of the Tate groups.
-/

namespace Work.SSGRoute

/-- An element of a `G`-module is a finite sum of elements of the form `g • a - a`. -/
def IsAugSum (G : Type) (A : Type) [Group G] [AddCommGroup A] [DistribMulAction G A]
    (u : A) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι) (γ : ι → G) (z : ι → A), u = ∑ i, (γ i • z i - z i)

/-- Every element of the augmentation submodule is a finite sum of elements `g • a - a`. -/
theorem isAugSum_of_mem_augmentation {G : Type} [Group G] {A : Type} [AddCommGroup A]
    [DistribMulAction G A] {u : A} (hu : u ∈ Work.Tate.augmentation G A) :
    IsAugSum G A u := by
  refine AddSubgroup.closure_induction (k := Set.range fun p : G × A => p.1 • p.2 - p.2)
    ?_ ?_ ?_ ?_ hu
  · -- A generator `g • a - a` is a one-term sum.
    rintro y ⟨⟨g, a⟩, rfl⟩
    exact ⟨PUnit, inferInstance, fun _ => g, fun _ => a, by simp⟩
  · -- `0` is the empty sum.
    exact ⟨Empty, inferInstance, fun e => e.elim, fun e => e.elim, by simp⟩
  · -- Sums are combined by the sum over a disjoint union of index types.
    intro y z _ _ hy hz
    obtain ⟨ι₁, _, γ₁, z₁, hy⟩ := hy
    obtain ⟨ι₂, _, γ₂, z₂, hz⟩ := hz
    refine ⟨ι₁ ⊕ ι₂, inferInstance, Sum.elim γ₁ γ₂, Sum.elim z₁ z₂, ?_⟩
    rw [hy, hz, Fintype.sum_sum_type]
    simp
  · -- Negation uses `-(g • a - a) = g⁻¹ • (g • a) - (g • a)`, i.e. the generating set is
    -- closed under negation.
    intro y _ hy
    obtain ⟨ι, _, γ, z, hy⟩ := hy
    refine ⟨ι, inferInstance, fun i => (γ i)⁻¹, fun i => γ i • z i, ?_⟩
    rw [hy, ← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i _
    rw [inv_smul_smul, neg_sub]

theorem augmentation_eq_sum (p : ℕ) (G : Type) [Group G] (A : Type) [AddCommGroup A]
    [Module (ZMod p) A] [DistribMulAction G A] {u : A}
    (hu : u ∈ Work.Tate.augmentation G A) :
    ∃ (ι : Type) (_ : Fintype ι) (γ : ι → G) (z : ι → A), u = ∑ i, (γ i • z i - z i) :=
  isAugSum_of_mem_augmentation hu

end Work.SSGRoute
