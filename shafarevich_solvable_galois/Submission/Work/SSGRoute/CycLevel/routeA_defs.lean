/-!
# Route A of the per-place cyclotomic level: definitions

This file fixes the *construction* used by `Work.SSGRoute.CycLevel.routeA_level`
(`Submission/Work/SSGRoute/CycLevel/routeA_level.lean`).

Let `k` be a number field, `q` an odd prime, `e > 0`, `v₀` a finite place of `k` with residue
cardinality `N v₀`, and let `ℓ` be a rational prime with `ℓ ∤ disc k`, `(ℓ) ∉ v₀`,
`q ^ e ∣ ℓ - 1` and `N v₀ ∉ ((ZMod ℓ)ˣ) ^ q`.  Fix a primitive `ℓ`-th root of unity `ζ` in
`Ω = AlgebraicClosure k`.

* `cycL ℓ ζ = k⟮ζ⟯`, the cyclotomic level; it is a Galois extension of `k` with Galois group
  isomorphic to `(ZMod ℓ)ˣ`, so in particular *cyclic* of order `ℓ - 1`.
* `cycH q e ℓ ζ ≤ Gal(k⟮ζ⟯/k)` is the subgroup generated by the `q ^ e`-th powers; since
  `Gal(k⟮ζ⟯/k)` is commutative (`Subgroup.closure` of the set of `q ^ e`-th powers agrees with the
  range of the `q ^ e`-power map, `powMonoidHom (q ^ e)`), it has index `q ^ e`.
* `cycM q e ℓ ζ = IntermediateField.lift (fixedField (cycH q e ℓ ζ))` is the subfield of
  `AlgebraicClosure k` corresponding to the fixed field of `cycH` inside `k⟮ζ⟯`; it is the unique
  subfield of `k⟮ζ⟯` of degree `q ^ e` over `k`, Galois and cyclic over `k`.
* `CycMData k q e ℓ ζ` bundles the structural data of that level (`FiniteDimensional`,
  `NumberField`, `IsGalois`, `IsCyclic`, order `q ^ e`).

The two lemmas requested on top of this file are

* `Work.SSGRoute.CycLevel.cycM_structure` — `Nonempty (CycMData k q e ℓ ζ)`;
* `Work.SSGRoute.CycLevel.cycM_fullLocal` — every place of `↥(cycM q e ℓ ζ)` above `v₀` has
  full local degree, i.e. its stabiliser in `Gal(cycM/k)` is the whole group.

## Sketch of `cycM_fullLocal`

Let `W` be a place of `↥(cycL ℓ ζ)` above a place `w` of `↥(cycM q e ℓ ζ)` above `v₀`, and let
`τ ∈ Gal(k⟮ζ⟯/k)` be a Frobenius element at `W`; it exists unconditionally
(`NK.Chebotarev.exists_isFrobAt`) and it stabilises `W`.  Because `(ℓ) ∉ v₀`, the congruence
defining a Frobenius can be upgraded to the equality `τ ζ = ζ ^ N v₀`
(`NK.CFTLib.ARL.isFrobAtPrime_zeta`).

The cyclotomic character `θ := IsPrimitiveRoot.autToPow k` is an injective homomorphism
`Gal(k⟮ζ⟯/k) →* (ZMod ℓ)ˣ`, and it is *surjective* because `ℓ ∤ disc k`
(`NK.CFTLib.ArtinReciprocityIdeal.exists_algEquiv_zeta_pow`; the same computation gives
`Nat.card (Gal(k⟮ζ⟯/k)) = ℓ - 1`).  Hence `θ τ` is the class of `N v₀`, and — because `cycH` is
the preimage under `θ` of the `q ^ e`-th powers of `(ZMod ℓ)ˣ` — the order of the image of `τ` in
`Gal(cycM/k)` is the least `j > 0` with `(N v₀) ^ j` a `q ^ e`-th power modulo `ℓ`, which is
`q ^ e` (`Work.SSGRoute.CycLevel.cyclic_exists_pow_eq_iff_dvd`, using
`N v₀ ∉ ((ZMod ℓ)ˣ) ^ q`).

Consequently `⟨τ|_M⟩` has `q ^ e` elements inside the decomposition group of `w` in
`Gal(cycM/k)` (`Work.SSGRoute.decompK_restrict_exists` for the inclusion of the decomposition
group), and since `Gal(cycM/k)` itself has `q ^ e` elements the decomposition group is everything;
the stabiliser of the place `w` of `↥(cycM q e ℓ ζ)` is the decomposition group of the underlying
prime ideal (`NK.GlobalCFT.Place.smul_ofFinite`).
-/

namespace Work.SSGRoute.CycLevel

open scoped NumberField

variable {k : Type} [Field k] [NumberField k]

/-- The cyclotomic level `k⟮ζ⟯` inside `AlgebraicClosure k`. -/
noncomputable def cycL (ℓ : ℕ) (ζ : AlgebraicClosure k) : IntermediateField k (AlgebraicClosure k) :=
  IntermediateField.adjoin k ({ζ} : Set (AlgebraicClosure k))

/-- The subgroup of `q ^ e`-th powers of `Gal(k⟮ζ⟯/k)`, as the closure of the set of powers. -/
noncomputable def cycH (q e ℓ : ℕ) (ζ : AlgebraicClosure k) :
    Subgroup (cycL ℓ ζ ≃ₐ[k] cycL ℓ ζ) :=
  Subgroup.closure (Set.range fun y : cycL ℓ ζ ≃ₐ[k] cycL ℓ ζ => y ^ (q ^ e))

/-- The level `M`: the image in `AlgebraicClosure k` of the fixed field of `cycH`. -/
noncomputable def cycM (q e ℓ : ℕ) (ζ : AlgebraicClosure k) :
    IntermediateField k (AlgebraicClosure k) :=
  IntermediateField.lift (F := cycL ℓ ζ) (IntermediateField.fixedField (cycH q e ℓ ζ))

/-- The structural data of the level `cycM q e ℓ ζ`. -/
structure CycMData (k : Type) [Field k] [NumberField k] (q e ℓ : ℕ) (ζ : AlgebraicClosure k) where
  fd : FiniteDimensional k ↥(cycM q e ℓ ζ)
  nf : NumberField ↥(cycM q e ℓ ζ)
  gal : IsGalois k ↥(cycM q e ℓ ζ)
  cyc : IsCyclic (↥(cycM q e ℓ ζ) ≃ₐ[k] ↥(cycM q e ℓ ζ))
  card : Nat.card (↥(cycM q e ℓ ζ) ≃ₐ[k] ↥(cycM q e ℓ ζ)) = q ^ e

/-- Auxiliary: the exponent of a primitive root of unity is determined modulo its order. -/
theorem pow_val_eq_of_lt {Ω : Type*} [Field Ω] {ℓ : ℕ} (hℓ : ℓ.Prime) {ζ : Ω}
    (hζ : IsPrimitiveRoot ζ ℓ) {a b : ℕ} (ha : a < ℓ) (hb : b < ℓ) (h : ζ ^ a = ζ ^ b) :
    a = b := by
  wlog hle : b ≤ a generalizing a b with H
  · exact (H hb ha h.symm (le_of_lt (not_le.mp hle))).symm
  have hζ0 : ζ ≠ 0 := hζ.ne_zero hℓ.ne_zero
  have h1 : ζ ^ (a - b) = 1 := by
    have h2 : ζ ^ b * ζ ^ (a - b) = ζ ^ b * 1 := by
      rw [mul_one, ← pow_add, Nat.add_sub_cancel' hle, h]
    exact (mul_left_cancel₀ (pow_ne_zero b hζ0)) h2
  rcases Nat.eq_zero_or_pos (a - b) with h0 | hpos
  · omega
  · exact absurd (Nat.le_of_dvd hpos ((hζ.pow_eq_one_iff_dvd _).mp h1)) (by omega)

/-- Auxiliary: **the structural data of `cycM q e ℓ ζ`.** -/
theorem cycM_structure_aux (k : Type) [Field k] [NumberField k] (q e ℓ : ℕ) (hq : q.Prime)
    (hℓ : ℓ.Prime) (he : 0 < e) (hdisc : ¬ (ℓ : ℤ) ∣ NumberField.discr k)
    (hdvd : q ^ e ∣ ℓ - 1) (ζ : AlgebraicClosure k) (hζ : IsPrimitiveRoot ζ ℓ) :
    Nonempty (CycMData k q e ℓ ζ) := by
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  haveI hcyc : IsCyclotomicExtension {ℓ} k ↥(cycL ℓ ζ) :=
    (IntermediateField.isCyclotomicExtension_singleton_iff_eq_adjoin ℓ k (AlgebraicClosure k)
      (cycL ℓ ζ) hζ).mpr rfl
  haveI hfd : FiniteDimensional k ↥(cycL ℓ ζ) :=
    IsCyclotomicExtension.finiteDimensional {ℓ} k ↥(cycL ℓ ζ)
  haveI hgalL : IsGalois k ↥(cycL ℓ ζ) := IsCyclotomicExtension.isGalois {ℓ} k ↥(cycL ℓ ζ)
  haveI hcycU : IsCyclic (ZMod ℓ)ˣ := ZMod.isCyclic_units_prime hℓ
  have hζLmem : ζ ∈ cycL ℓ ζ := IntermediateField.mem_adjoin_simple_self k ζ
  have hζL : IsPrimitiveRoot (⟨ζ, hζLmem⟩ : ↥(cycL ℓ ζ)) ℓ :=
    IsPrimitiveRoot.coe_submonoidClass_iff.mp (by
      rw [show ((⟨ζ, hζLmem⟩ : ↥(cycL ℓ ζ)) : AlgebraicClosure k) = ζ from rfl]; exact hζ)
  have hθinj : Function.Injective (IsPrimitiveRoot.autToPow k hζL) :=
    IsPrimitiveRoot.autToPow_injective k hζL
  have hθsurj : Function.Surjective (IsPrimitiveRoot.autToPow k hζL) := by
    intro τ
    obtain ⟨σ, hσ⟩ := NK.CFTLib.ArtinReciprocityIdeal.exists_algEquiv_zeta_pow ℓ hℓ hdisc ζ hζ τ
    refine ⟨σ, ?_⟩
    have h1 : (⟨ζ, hζLmem⟩ : ↥(cycL ℓ ζ))
          ^ (((IsPrimitiveRoot.autToPow k hζL σ : (ZMod ℓ)ˣ) : ZMod ℓ)).val
        = (⟨ζ, hζLmem⟩ : ↥(cycL ℓ ζ)) ^ ((τ : ZMod ℓ)).val :=
      (IsPrimitiveRoot.autToPow_spec k hζL σ).trans hσ
    exact Units.ext (ZMod.val_injective ℓ
      (pow_val_eq_of_lt hℓ hζL (ZMod.val_lt _) (ZMod.val_lt _) h1))
  have hcardL : Nat.card (↥(cycL ℓ ζ) ≃ₐ[k] ↥(cycL ℓ ζ)) = ℓ - 1 := by
    have hbij : Function.Bijective (IsPrimitiveRoot.autToPow k hζL) := ⟨hθinj, hθsurj⟩
    rw [Nat.card_congr (Equiv.ofBijective _ hbij), Nat.card_eq_fintype_card, ZMod.card_units]
  haveI hcycG : IsCyclic (↥(cycL ℓ ζ) ≃ₐ[k] ↥(cycL ℓ ζ)) :=
    isCyclic_of_injective _ hθinj
  haveI : Finite (↥(cycL ℓ ζ) ≃ₐ[k] ↥(cycL ℓ ζ)) := Finite.of_injective _ hθinj
  letI : CommGroup (↥(cycL ℓ ζ) ≃ₐ[k] ↥(cycL ℓ ζ)) := IsCyclic.commGroup
  have hHrange : cycH q e ℓ ζ = (powMonoidHom (q ^ e)).range := by
    rw [cycH]
    refine le_antisymm ?_ ?_
    · rw [Subgroup.closure_le]
      rintro _ ⟨y, rfl⟩
      exact MonoidHom.mem_range.mpr ⟨y, rfl⟩
    · rintro _ ⟨y, rfl⟩
      exact Subgroup.subset_closure ⟨y, rfl⟩
  have hHindex : (cycH q e ℓ ζ).index = q ^ e := by
    rw [hHrange, IsCyclic.index_powMonoidHom_range, hcardL]
    exact Nat.gcd_eq_right hdvd
  haveI hHnormal : (cycH q e ℓ ζ).Normal := Subgroup.normal_of_comm _
  have hGalM : Nat.card (↥(IntermediateField.fixedField (cycH q e ℓ ζ)) ≃ₐ[k]
      ↥(IntermediateField.fixedField (cycH q e ℓ ζ))) = q ^ e := by
    rw [← Nat.card_congr (IsGalois.normalAutEquivQuotient (cycH q e ℓ ζ)).toEquiv,
      ← Subgroup.index_eq_card]
    exact hHindex
  haveI hMgal : IsGalois k ↥(IntermediateField.fixedField (cycH q e ℓ ζ)) :=
    IsGalois.of_fixedField_normal_subgroup (cycH q e ℓ ζ)
  haveI hMcyc : IsCyclic (↥(IntermediateField.fixedField (cycH q e ℓ ζ)) ≃ₐ[k]
      ↥(IntermediateField.fixedField (cycH q e ℓ ζ))) :=
    isCyclic_of_surjective _ (IsGalois.normalAutEquivQuotient (cycH q e ℓ ζ)).surjective
  -- transport along the inclusion into the algebraic closure
  have e_al : ↥(IntermediateField.fixedField (cycH q e ℓ ζ)) ≃ₐ[k] ↥(cycM q e ℓ ζ) :=
    IntermediateField.liftAlgEquiv (E := cycL ℓ ζ) (IntermediateField.fixedField (cycH q e ℓ ζ))
  haveI hfdM : FiniteDimensional k ↥(cycM q e ℓ ζ) :=
    FiniteDimensional.of_surjective e_al.toLinearMap e_al.surjective
  haveI hgalM : IsGalois k ↥(cycM q e ℓ ζ) := IsGalois.of_algEquiv e_al
  have hcycM : IsCyclic (↥(cycM q e ℓ ζ) ≃ₐ[k] ↥(cycM q e ℓ ζ)) :=
    (MulEquiv.isCyclic (AlgEquiv.autCongr e_al)).mp hMcyc
  have hcardM : Nat.card (↥(cycM q e ℓ ζ) ≃ₐ[k] ↥(cycM q e ℓ ζ)) = q ^ e := by
    rw [← Nat.card_congr (AlgEquiv.autCongr e_al).toEquiv]
    exact hGalM
  exact ⟨hfdM, NumberField.of_module_finite k ↥(cycM q e ℓ ζ), hgalM, hcycM, hcardM⟩


/-- **The Frobenius at a prime acts on a primitive root of unity by the residue cardinality.**

This is `NK.CFTLib.ARL.isFrobAtPrime_zeta` for an *arbitrary* primitive `n`-th root of unity of
the cyclotomic-free extension `L/k` (the original statement uses the canonical
`IsCyclotomicExtension.zeta`). -/
theorem isFrobAt_apply_isPrimitiveRoot {k L : Type*} [Field k] [NumberField k] [Field L]
    [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L] (n : ℕ) [NeZero n]
    (ζ : L) (hζ : IsPrimitiveRoot ζ n) (p : NK.Chebotarev.PrimeIdeal k) (σ : Gal(L/k))
    (hs : (n : NumberField.RingOfIntegers k) ∉ p.asIdeal)
    (hfrob : NK.Chebotarev.IsFrobAtPrime (L := L) p σ) :
    σ ζ = ζ ^ Nat.card (NumberField.RingOfIntegers k ⧸ p.asIdeal) := by
  obtain ⟨P, hP, hfrobP⟩ := hfrob
  have hζint : IsPrimitiveRoot hζ.toInteger n := hζ.toInteger_isPrimitiveRoot
  have hcoe : algebraMap (NumberField.RingOfIntegers L) L hζ.toInteger = ζ := hζ.coe_toInteger
  have hnP : (n : NumberField.RingOfIntegers L) ∉ P.asIdeal := by
    intro hmem
    apply hs
    have h' : algebraMap (NumberField.RingOfIntegers k) (NumberField.RingOfIntegers L)
        (n : NumberField.RingOfIntegers k) ∈ P.asIdeal := by
      rwa [map_natCast]
    exact (Ideal.mem_of_liesOver (P := P.asIdeal) (p := p.asIdeal)
      (x := (n : NumberField.RingOfIntegers k))).mpr h'
  have h1 : galRestrict (NumberField.RingOfIntegers k) k L (NumberField.RingOfIntegers L) σ
        hζ.toInteger
      = hζ.toInteger ^ Nat.card (NumberField.RingOfIntegers k ⧸
          P.asIdeal.under (NumberField.RingOfIntegers k)) :=
    AlgHom.IsArithFrobAt.apply_of_pow_eq_one hfrobP hζint.pow_eq_one hnP
  have h2 := congrArg (algebraMap (NumberField.RingOfIntegers L) L) h1
  rw [map_pow, algebraMap_galRestrict_apply] at h2
  rw [hcoe] at h2
  rw [← hP.over] at h2
  exact h2

end Work.SSGRoute.CycLevel
