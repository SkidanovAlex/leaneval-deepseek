/-- **The inertia subgroup inside the decomposition group.**  The subgroup
`Work.SSGRoute.globalInertiaSub A'` of `D_A` generated by the inertia elements is exactly the
Mathlib subgroup `ValuationSubring.inertiaSubgroup ℚ A.1` (the kernel of the action of `D_A` on
the residue field): the two descriptions agree by `isInertia_iff_mem_inertiaSubgroup`. -/
theorem globalInertiaSub_eq_inertiaSubgroup (A' : NK.FrobeniusBridge.FinitePlaceOf ℚ SSGRoute.QBar) :
    globalInertiaSub A' = ValuationSubring.inertiaSubgroup ℚ A'.1 := by
  rw [globalInertiaSub]
  have h : ({g : ↥(SSGRoute.decomp ℚ A'.1) | SSGRoute.IsInertia ℚ A'.1
        (g : SSGRoute.QBar ≃ₐ[ℚ] SSGRoute.QBar)} : Set ↥(SSGRoute.decomp ℚ A'.1))
      = (ValuationSubring.inertiaSubgroup ℚ A'.1 : Set _) :=
    Set.ext fun g => (isInertia_iff_mem_inertiaSubgroup g).symm
  rw [h]
  refine le_antisymm ?_ Subgroup.subset_closure
  rw [Subgroup.closure_le]

/-- **Reduction of a membership statement on a group to the Frobenius generator.**

Let `D` be a group with a surjection `cl : D →* Ẑ` whose kernel is `I`, let `β : D →* Q` be a
homomorphism and `A' ≤ Q` a subgroup with `β ι ∈ A'` for `ι ∈ I`.  Suppose

* `π : Q →* Q'` has central kernel of exponent dividing `p` (`hcentral`, `hexp`),
* `π (β σ) ∈ π '' A'` for every `σ : D` (`hpi_beta`) — so that each `β σ` is a product of an
  element of `A'` and an element of `ker π` (using centrality to reorder),
* `β F ∈ A'` for some `F` with `cl F = zhatGen`.

Then `β σ ∈ A'` for all `σ : D`.

The "correction" `σ ↦ (a_σ)⁻¹ · β σ ∈ ker π` (with `a_σ ∈ A'` chosen with `π a_σ = π (β σ)`) is
a homomorphism `D → ker π ⧸ (A' ⊓ ker π)`; it is independent of the choices and kills `I`, so it
factors through `cl : D ↠ Ẑ`.  Its target is a quotient of `ker π`, hence of exponent dividing
`p`, and a homomorphism `Ẑ →* W` into a group of exponent `p` is trivial as soon as it kills
`zhatGen` (`Work.SSGRoute.zhat_eq_one_of_zhatGen_eq_one`).  Since `β F ∈ A'` the correction kills
`F`, hence vanishes, giving `β σ ∈ A'`. -/
theorem t2LeOfLeZhatGenAux {D Q Q' : Type*} [Group D] [Group Q] [Group Q'] (p : ℕ) (hp : 0 < p)
    (I : Subgroup D) (cl : D →* NK.LocalAnabelian.Zhat) (hclker : cl.ker = I)
    (hclsurj : Function.Surjective cl)
    (A' : Subgroup Q) (π : Q →* Q') (β : D →* Q)
    (hI : ∀ ι ∈ I, β ι ∈ A')
    (hcentral : ∀ x ∈ π.ker, ∀ y : Q, x * y = y * x)
    (hexp : ∀ x ∈ π.ker, x ^ p = 1)
    (hpi_beta : ∀ σ : D, ∃ a ∈ A', π (β σ) = π a)
    (F : D) (hF : cl F = NK.TowerRank.zhatGen) (hβF : β F ∈ A') :
    ∀ σ : D, β σ ∈ A' := by
  classical
  let a : D → Q := fun σ => (hpi_beta σ).choose
  have ha_mem : ∀ σ, a σ ∈ A' := fun σ => (hpi_beta σ).choose_spec.1
  have ha_eq : ∀ σ, π (β σ) = π (a σ) := fun σ => (hpi_beta σ).choose_spec.2
  have hcorr : ∀ σ : D, (a σ)⁻¹ * β σ ∈ π.ker := by
    intro σ
    rw [MonoidHom.mem_ker, map_mul, map_inv, ha_eq σ, inv_mul_cancel]
  let N : Subgroup ↥(π.ker) := (A' ⊓ π.ker).subgroupOf π.ker
  haveI hNnorm : N.Normal := by
    refine ⟨fun n hn g => ?_⟩
    rw [Subgroup.mem_subgroupOf] at hn ⊢
    have hc : (g : Q) * (n : Q) = (n : Q) * (g : Q) := hcentral (g : Q) g.2 (n : Q)
    simp only [Subgroup.coe_mul, Subgroup.coe_inv]
    rw [hc, mul_assoc, mul_inv_cancel, mul_one]
    exact hn
  let w : D →* (↥(π.ker) ⧸ N) :=
    { toFun := fun σ => QuotientGroup.mk' N ⟨(a σ)⁻¹ * β σ, hcorr σ⟩
      map_one' := by
        rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
        exact Subgroup.mem_inf.mpr ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ (ha_mem 1))
          (by rw [MonoidHom.map_one]; exact Subgroup.one_mem _), hcorr 1⟩
      map_mul' := fun σ τ => by
        have hhA : (a (σ * τ))⁻¹ * (a σ * a τ) ∈ A' :=
          Subgroup.mul_mem _ (Subgroup.inv_mem _ (ha_mem (σ * τ)))
            (Subgroup.mul_mem _ (ha_mem σ) (ha_mem τ))
        have hhker : (a (σ * τ))⁻¹ * (a σ * a τ) ∈ π.ker := by
          rw [MonoidHom.mem_ker, map_mul, map_inv, map_mul, ← ha_eq (σ * τ), ← ha_eq σ,
            ← ha_eq τ, ← MonoidHom.map_mul π (β σ) (β τ), ← map_mul β, inv_mul_cancel]
        have key : (⟨(a (σ * τ))⁻¹ * β (σ * τ), hcorr (σ * τ)⟩ : ↥(π.ker)) *
            ((⟨(a σ)⁻¹ * β σ, hcorr σ⟩ : ↥(π.ker)) *
              ⟨(a τ)⁻¹ * β τ, hcorr τ⟩)⁻¹
            = ⟨(a (σ * τ))⁻¹ * (a σ * a τ), hhker⟩ := by
          apply Subtype.ext
          simp only [Subgroup.coe_mul, Subgroup.coe_inv]
          have hβσ : β σ = a σ * ((a σ)⁻¹ * β σ) := by group
          have hβτ : β τ = a τ * ((a τ)⁻¹ * β τ) := by group
          rw [map_mul β, hβσ, hβτ,
            show (a σ * ((a σ)⁻¹ * β σ)) * (a τ * ((a τ)⁻¹ * β τ))
                = a σ * (((a σ)⁻¹ * β σ) * a τ) * ((a τ)⁻¹ * β τ) from by group,
            hcentral ((a σ)⁻¹ * β σ) (hcorr σ) (a τ)]
          group
        rw [← map_mul (QuotientGroup.mk' N) ⟨(a σ)⁻¹ * β σ, hcorr σ⟩
          ⟨(a τ)⁻¹ * β τ, hcorr τ⟩]
        refine QuotientGroup.eq_iff_div_mem.mpr ?_
        rw [div_eq_mul_inv, key, Subgroup.mem_subgroupOf]
        exact Subgroup.mem_inf.mpr ⟨hhA, hhker⟩ }
  have hwI : ∀ ι ∈ I, w ι = 1 := by
    intro ι hι
    show QuotientGroup.mk' N ⟨(a ι)⁻¹ * β ι, hcorr ι⟩ = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    exact Subgroup.mem_inf.mpr
      ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ (ha_mem ι)) (hI ι hι), hcorr ι⟩
  have hwker : cl.ker ≤ w.ker := by
    rw [hclker]
    intro ι hι
    rw [MonoidHom.mem_ker]
    exact hwI ι hι
  let clIso : (D ⧸ cl.ker) ≃* NK.LocalAnabelian.Zhat :=
    QuotientGroup.quotientKerEquivOfSurjective cl hclsurj
  have hclIso : ∀ σ : D, clIso (QuotientGroup.mk' cl.ker σ) = cl σ := by
    intro σ
    change QuotientGroup.kerLift cl (QuotientGroup.mk' cl.ker σ) = cl σ
    rw [QuotientGroup.mk'_apply, QuotientGroup.kerLift_mk]
  let wbar : NK.LocalAnabelian.Zhat →* (↥(π.ker) ⧸ N) :=
    (QuotientGroup.lift cl.ker w hwker).comp clIso.symm.toMonoidHom
  have hwbar : ∀ σ : D, wbar (cl σ) = w σ := by
    intro σ
    show (QuotientGroup.lift cl.ker w hwker) (clIso.symm (cl σ)) = w σ
    rw [show clIso.symm (cl σ) = QuotientGroup.mk' cl.ker σ from by
      rw [← hclIso σ, MulEquiv.symm_apply_apply]]
    exact QuotientGroup.lift_mk' cl.ker hwker σ
  have hwF : w F = 1 := by
    show QuotientGroup.mk' N ⟨(a F)⁻¹ * β F, hcorr F⟩ = 1
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, Subgroup.mem_subgroupOf]
    exact Subgroup.mem_inf.mpr
      ⟨Subgroup.mul_mem _ (Subgroup.inv_mem _ (ha_mem F)) hβF, hcorr F⟩
  have hwbar_gen : wbar NK.TowerRank.zhatGen = 1 := by
    rw [← hF, hwbar F]
    exact hwF
  have hwbar_one : wbar = 1 :=
    zhat_eq_one_of_zhatGen_eq_one p hp
      (fun x => quotient_pow_eq_one N p (fun y => Subtype.ext (hexp (y : Q) y.2)) x)
      wbar hwbar_gen
  intro σ
  have hw1 : w σ = 1 := by rw [← hwbar σ, hwbar_one]; rfl
  have hℓN : (⟨(a σ)⁻¹ * β σ, hcorr σ⟩ : ↥(π.ker)) ∈ N := by
    have h := hw1
    rw [show w σ = QuotientGroup.mk' N ⟨(a σ)⁻¹ * β σ, hcorr σ⟩ from rfl,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff] at h
    exact h
  have hA : (a σ)⁻¹ * β σ ∈ A' := by
    rw [Subgroup.mem_subgroupOf] at hℓN
    exact (Subgroup.mem_inf.mp hℓN).1
  have h2 : a σ * ((a σ)⁻¹ * β σ) = β σ := by group
  rw [← h2]
  exact Subgroup.mul_mem _ (ha_mem σ) hA

/-- **The `T²` local target of Step 3 of Schmidt–Wingberg's Theorem 15.**

Let `ρ : G_ℚ →* Γ_τ(n)` be a level-`τ` map and `ψ : G_ℚ →* Γ_{τ+1}(n)` a lift of it (`hproj`),
continuous (`hopen`), with `flowQuot ∘ ψ = res`.  Let `A` be a finite place **not over `p`**
(`hAp`), whose decomposition group is contained in the field `K` (`hDK`), and such that the local
group `ρ(D_A)` is generated by the image of the inertia (`hgen`; this is implied by `hDK`, `hproj`,
`hψquot`).

Then there is a `1`-cocycle `α : G_ℚ → E(n,τ)` which is additive on `D_A`, locally constant there,
**vanishes on the inertia** `I_A`, and such that the twist `α · ψ` has **cyclic** local group at
`A`, generated by the image of the inertia:

  `IsCyclic (closure ((α·ψ) '' D_A))`  and  `∀σ ∈ D_A, ∃τ ∈ I_A, (α·ψ) τ = (α·ψ) σ`.

This is the "new ramification is cyclic totally ramified" input of Step 3 (the paper's `T²`
prescription, Schmidt–Wingberg pp. 27–29), stated purely group-theoretically: it is condition (ii)
of Theorem 15 at the places where the level-`τ` field is ramified over `K`.

**Proof.**  `D_A ≤ G_K`, so the action on `E(n,τ)` is trivial and `α` is a homomorphism
`D_A → E(n,τ)`; also `flowQuot(ψ σ) = res σ = 1` for `σ ∈ D_A`, so `ψ` maps `D_A` into
`ker(flowQuot) = F(n)/F(n)^{(τ+1)}`, a *finite `p`-group*.  As `A` is not over `p`, the maximal
pro-`p` quotient of the local inertia `I_A` is procyclic (wild inertia is pro-`ℓ`, `ℓ ≠ p`; tame
inertia is `∏_{q≠ℓ} ℤ_q`), so `ψ(I_A) = ⟨u⟩` is cyclic; pick `τ ∈ I_A` with `ψ τ = u`.  Let
`F ∈ D_A` be a Frobenius lift.  Define `α` on `D_A` by `α|I_A := 0` and
`α F := (ψ F)⁻¹ · ψ(τ)^m` where `m` is chosen so that `ρ F = (ρ τ)^m` (which exists because
`⟨ρ τ⟩ = ρ(I_A) = ρ(D_A)` by `hgen`).  Any homomorphism `D_A → E(n,τ)` is determined on `I_A` and
on `F` (the `D_A/I_A`-action on `E` is trivial, so the defining relation of `D_A` is respected),
and `α` extended by `0` off `D_A` is locally constant with `IsLocConstOn D_A (ker ρ ∩ ker ψ)`.
Then `(α·ψ)(τ') = ψ(τ')` for `τ' ∈ I_A` and `(α·ψ) F = ψ(τ)^m`, whence
`(α·ψ)(D_A) = ⟨u⟩ = (α·ψ)(I_A)` is cyclic, inertia-generated, and `α` vanishes on `I_A`.

Useful lemmas already on disk: `Work.SSGRoute.isCyclic_map_of_proCyclic_quotient`,
`NK.LocalTame.wildInertiaSubgroup_isProP`, `NK.LocalTame.isProCyclic_congr`,
`NK.FrobeniusBridge.localGaloisEquiv`, `Work.SSGRoute.localTameData`,
`Work.SSGRoute.step4_inertia_image_cyclic` (the exponent-`p` variant, whose proof has exactly the
pro-cyclic-inertia step), `Work.SSGRoute.gradeInl_mul_comm`, `Work.SSGRoute.gradeInl_injective`,
`Work.SSGRoute.mem_flowEKer_iff_exists_gradeInl`, `Work.CohomologicalShrinking.finite_refinedQuotient`,
`Work.SSGRoute.localZhatHom_ker`, `Work.SSGRoute.flowQuot` (its kernel is the finite `p`-group
`flowQuotient`), `Work.CohomologicalShrinking.finite_flowQuotient`. -/
theorem stage3T2LocalTarget (p : ℕ) [Fact p.Prime] (K : IntermediateField ℚ SSGRoute.QBar)
    [Normal ℚ K] (n i j : ℕ)
    (ρ : SSGRoute.GalQ →* Work.CohomologicalShrinking.flowGroup p (K ≃ₐ[ℚ] K) n i j)
    (ψ : SSGRoute.GalQ →* Work.CohomologicalShrinking.flowGroup p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2)
    (hproj : ∀ σ : SSGRoute.GalQ, Work.SSGRoute.flowGroupProj p (K ≃ₐ[ℚ] K) n i j (ψ σ) = ρ σ)
    (hψquot : ∀ σ : SSGRoute.GalQ, Work.CohomologicalShrinking.flowQuot p (K ≃ₐ[ℚ] K) n
      (Work.CohomologicalShrinking.tauSucc i j).1 (Work.CohomologicalShrinking.tauSucc i j).2
        (ψ σ) = Work.SSGRoute.restrict K σ)
    (hopen : IsOpen (ψ.ker : Set SSGRoute.GalQ))
    (A : ValuationSubring SSGRoute.QBar) (hA : SSGRoute.IsFinPlace ℚ A)
    (hAp : ¬ A.valuation (p : SSGRoute.QBar) < 1)
    (hDK : ∀ σ ∈ SSGRoute.decomp ℚ A, σ ∈ K.fixingSubgroup)
    (hgen : ∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧ ρ τ = ρ σ) :
    ∃ α : SSGRoute.GalQ → Work.CohomologicalShrinking.E p (K ≃ₐ[ℚ] K) n i j,
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, α (σ * τ) = α σ + α τ) ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) α ∧
      (∀ σ : SSGRoute.GalQ, SSGRoute.IsInertia ℚ A σ → α σ = 0) ∧
      IsCyclic (Subgroup.closure
        ((Work.SSGRoute.flowTwistE p K n i j α ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))) ∧
      (∀ σ ∈ SSGRoute.decomp ℚ A, ∃ τ, SSGRoute.IsInertia ℚ A τ ∧
        Work.SSGRoute.flowTwistE p K n i j α ψ τ = Work.SSGRoute.flowTwistE p K n i j α ψ σ) := by
  classical
  have hp : p.Prime := Fact.out
  let A' : NK.FrobeniusBridge.FinitePlaceOf ℚ SSGRoute.QBar := ⟨A, hA⟩
  -- ## Step 1: `ψ` and `ρ` take values in the normal subgroup on `D_A`
  have hψnorm : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      ψ σ.1 ∈ flowNormal p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 := by
    intro σ
    rw [← flowQuot_ker, MonoidHom.mem_ker, hψquot σ.1,
      restrict_eq_one_of_mem_fixingSubgroup K (hDK σ.1 σ.2)]
  have hρnorm : ∀ σ : ↥(SSGRoute.decomp ℚ A), ρ σ.1 ∈ flowNormal p (K ≃ₐ[ℚ] K) n i j := by
    intro σ
    rw [← flowQuot_ker, MonoidHom.mem_ker, ← hproj σ.1]
    have h1 : flowQuot p (K ≃ₐ[ℚ] K) n i j
        (flowGroupProj p (K ≃ₐ[ℚ] K) n i j (ψ σ.1)) =
        flowQuot p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (ψ σ.1) := by
      conv_lhs => rw [show ψ σ.1 =
        SemidirectProduct.mk (ψ σ.1).left (ψ σ.1).right from rfl]
      rw [flowGroupProj_mk]
      rfl
    rw [h1, hψquot σ.1, restrict_eq_one_of_mem_fixingSubgroup K (hDK σ.1 σ.2)]
  -- ## Step 2: the two "left component" homomorphisms `lam` and `mu`
  let ψD : ↥(SSGRoute.decomp ℚ A) →*
      flowNormal p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 :=
    { toFun := fun σ => ⟨ψ σ.1, hψnorm σ⟩
      map_one' := Subtype.ext (map_one ψ)
      map_mul' := fun σ τ => Subtype.ext (map_mul ψ σ.1 τ.1) }
  let lam : ↥(SSGRoute.decomp ℚ A) →*
      flowQuotient p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 :=
    (flowNormalEquiv p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2).symm.toMonoidHom.comp ψD
  have hlam : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (lam σ) = ψ σ.1 := by
    intro σ
    have h2 : (flowNormalEquiv p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2) (lam σ) = ψD σ := by
      show (flowNormalEquiv _ _ _ _ _) ((flowNormalEquiv _ _ _ _ _).symm (ψD σ)) = ψD σ
      rw [MulEquiv.apply_symm_apply]
    rw [← flowNormalEquiv_apply p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (lam σ), h2]
    rfl
  let ρD : ↥(SSGRoute.decomp ℚ A) →* flowNormal p (K ≃ₐ[ℚ] K) n i j :=
    { toFun := fun σ => ⟨ρ σ.1, hρnorm σ⟩
      map_one' := Subtype.ext (map_one ρ)
      map_mul' := fun σ τ => Subtype.ext (map_mul ρ σ.1 τ.1) }
  let mu : ↥(SSGRoute.decomp ℚ A) →* flowQuotient p (K ≃ₐ[ℚ] K) n i j :=
    (flowNormalEquiv p (K ≃ₐ[ℚ] K) n i j).symm.toMonoidHom.comp ρD
  have hmu : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      flowInl p (K ≃ₐ[ℚ] K) n i j (mu σ) = ρ σ.1 := by
    intro σ
    have h2 : (flowNormalEquiv p (K ≃ₐ[ℚ] K) n i j) (mu σ) = ρD σ := by
      show (flowNormalEquiv _ _ _ _ _) ((flowNormalEquiv _ _ _ _ _).symm (ρD σ)) = ρD σ
      rw [MulEquiv.apply_symm_apply]
    rw [← flowNormalEquiv_apply p (K ≃ₐ[ℚ] K) n i j (mu σ), h2]
    rfl
  have hpi_lam : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      stageProjQuotient p (K ≃ₐ[ℚ] K) n i j (lam σ) = mu σ := by
    intro σ
    have h1 : (flowGroupProj p (K ≃ₐ[ℚ] K) n i j (ψ σ.1)).left
        = stageProjQuotient p (K ≃ₐ[ℚ] K) n i j (lam σ) := by
      conv_lhs => rw [show ψ σ.1 =
        SemidirectProduct.mk (ψ σ.1).left (ψ σ.1).right from rfl]
      rw [flowGroupProj_mk]
      show flowQuotientProj p (K ≃ₐ[ℚ] K) n i j (ψ σ.1).left
        = stageProjQuotient p (K ≃ₐ[ℚ] K) n i j (lam σ)
      rw [show (ψ σ.1).left = lam σ from by rw [← hlam σ]; rfl]
      rfl
    have h2 : (ρ σ.1).left = mu σ := by
      rw [← hmu σ]
      rfl
    have h3 := congrArg SemidirectProduct.left (hproj σ.1)
    rw [h1, h2] at h3
    exact h3
  -- ## Step 3: the image of inertia under `lam` is cyclic; pick a generator
  have hlamfin : lam.ker.FiniteIndex := by
    have hk : lam.ker = (ψ.ker).subgroupOf (SSGRoute.decomp ℚ A) := by
      ext σ
      rw [MonoidHom.mem_ker, Subgroup.mem_subgroupOf, MonoidHom.mem_ker]
      constructor
      · intro h
        have h' : flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (lam σ) = 1 := by
          rw [h, map_one]
        rwa [hlam σ] at h'
      · intro h
        apply flowInl_injective p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2
        rw [hlam σ, h, map_one]
    rw [hk]
    haveI : ψ.ker.FiniteIndex := finiteIndex_ker_of_isOpen ψ hopen
    infer_instance
  have hcyclam : IsCyclic ↥(Subgroup.map lam (ValuationSubring.inertiaSubgroup ℚ A)) :=
    t2InertiaImageCyclicOfPowEqOne p hp ((tauSucc i j).1)
      (fun x => t2PowPowEqOneFlowQuotient p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 x)
      A hA hAp lam hlamfin
  have hcycI : IsCyclic ↥(Subgroup.map lam (globalInertiaSub A')) := by
    rw [globalInertiaSub_eq_inertiaSubgroup]
    exact hcyclam
  obtain ⟨g, hg⟩ :=
    (Subgroup.isCyclic_iff_exists_zpowers_eq_top (Subgroup.map lam (globalInertiaSub A'))).mp hcycI
  have hgmem : g ∈ Subgroup.map lam (globalInertiaSub A') := by
    rw [← hg]
    exact Subgroup.mem_zpowers g
  obtain ⟨ι, hιI, hιg⟩ := Subgroup.mem_map.mp hgmem
  have hAg : Subgroup.map lam (globalInertiaSub A') = Subgroup.zpowers (lam ι) := by
    ext a
    constructor
    · intro ha
      have h2 : a ∈ Subgroup.zpowers g := by rw [hg]; exact ha
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp h2
      refine Subgroup.mem_zpowers_iff.mpr ⟨n, ?_⟩
      rw [hιg, hn]
    · intro ha
      obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp ha
      rw [← hn]
      exact Subgroup.zpow_mem _ (Subgroup.mem_map.mpr ⟨ι, hιI, rfl⟩) n
  -- ## Step 4: the value of the cocycle at the Frobenius
  let F : ↥(SSGRoute.decomp ℚ A) := localFrobElem A'
  have hmumap : Subgroup.map mu (globalInertiaSub A') = Subgroup.zpowers (mu ι) := by
    have hcomp : (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j).comp lam = mu := MonoidHom.ext hpi_lam
    calc Subgroup.map mu (globalInertiaSub A')
        = (Subgroup.zpowers (lam ι)).map (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) := by
          rw [← hcomp, ← Subgroup.map_map, hAg]
      _ = Subgroup.zpowers ((stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) (lam ι)) :=
          MonoidHom.map_zpowers _ _
      _ = Subgroup.zpowers (mu ι) := by rw [hpi_lam ι]
  have hmuF_mem : mu F ∈ Subgroup.map mu (globalInertiaSub A') := by
    obtain ⟨τ, hτI, hτeq⟩ := hgen (F : SSGRoute.GalQ) F.2
    have hτD : τ ∈ SSGRoute.decomp ℚ A := hτI.1
    have hτmem : (⟨τ, hτD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ globalInertiaSub A' := by
      rw [globalInertiaSub_eq_inertiaSubgroup]
      exact mem_inertiaSubgroup_of_isInertia _ hτI
    have hmuτ : mu ⟨τ, hτD⟩ = mu F := by
      apply flowInl_injective p (K ≃ₐ[ℚ] K) n i j
      rw [hmu ⟨τ, hτD⟩, hmu F]
      exact hτeq
    rw [← hmuτ]
    exact Subgroup.mem_map.mpr ⟨⟨τ, hτD⟩, hτmem, rfl⟩
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hmumap ▸ hmuF_mem)
  have hξ : ∃ ξ : refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j,
      gradeIncl p (K ≃ₐ[ℚ] K) n i j ξ = (lam ι) ^ m * (lam F)⁻¹ := by
    have hmem : (lam ι) ^ m * (lam F)⁻¹ ∈ (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j).ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, map_zpow, hpi_lam ι, hpi_lam F, hm,
        mul_inv_cancel]
    rw [stageProjQuotient_ker] at hmem
    exact hmem
  obtain ⟨ξ, hξeq⟩ := hξ
  obtain ⟨abar, habar⟩ := exists_zhat_hom_zhatGen_eq ξ p hp.pos (pow_eq_one_refinedQuotient p i j ξ)
  let αD : ↥(SSGRoute.decomp ℚ A) →*
      refinedQuotient p (Work.Shrinking.freeOperatorGroup (K ≃ₐ[ℚ] K) n) i j :=
    abar.comp (localZhatHom A')
  let α : SSGRoute.GalQ → E p (K ≃ₐ[ℚ] K) n i j :=
    fun σ => if h : σ ∈ SSGRoute.decomp ℚ A then Additive.ofMul (αD ⟨σ, h⟩) else 0
  have hα : ∀ (σ : SSGRoute.GalQ) (h : σ ∈ SSGRoute.decomp ℚ A),
      α σ = Additive.ofMul (αD ⟨σ, h⟩) := by
    intro σ h
    show (if h' : σ ∈ SSGRoute.decomp ℚ A then Additive.ofMul (αD ⟨σ, h'⟩) else 0) = _
    rw [dif_pos h]
  have hαD1 : ∀ ι' ∈ globalInertiaSub A', αD ι' = 1 := by
    intro ι' hι'
    show abar (localZhatHom A' ι') = 1
    rw [show localZhatHom A' ι' = 1 from by
      rw [← MonoidHom.mem_ker, localZhatHom_ker A']; exact hι', map_one]
  have hαD_F : αD F = ξ := by
    show abar (localZhatHom A' F) = ξ
    rw [localZhatHom_localFrobElem A', habar]
  -- ## Step 5: the twist homomorphism `β`
  let β : ↥(SSGRoute.decomp ℚ A) →*
      flowQuotient p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 :=
    { toFun := fun σ => gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ) * lam σ
      map_one' := by simp
      map_mul' := fun σ τ => by
        have hc : lam σ * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) =
            gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam σ := by
          have h := gradeIncl_central p (K ≃ₐ[ℚ] K) n i j (lam σ) (αD τ)
          have h' : gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam σ =
              lam σ * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) := by
            calc gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam σ
                = (lam σ * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * (lam σ)⁻¹) * lam σ := by
                  rw [h]
              _ = lam σ * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) := by group
          exact h'.symm
        show gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD (σ * τ)) * lam (σ * τ) =
          (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ) * lam σ)
            * (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam τ)
        rw [map_mul αD, map_mul lam,
          map_mul (gradeIncl p (K ≃ₐ[ℚ] K) n i j) (αD σ) (αD τ)]
        calc gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ)
              * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * (lam σ * lam τ)
            = gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ)
                * (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam σ) * lam τ := by group
          _ = gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ)
                * (lam σ * gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ)) * lam τ := by rw [← hc]
          _ = (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ) * lam σ)
                * (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD τ) * lam τ) := by group }
  have htwist : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      flowTwistE p K n i j α ψ σ.1
        = flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (β σ) := by
    intro σ
    show gradeInl p (K ≃ₐ[ℚ] K) n i j (Additive.toMul (α σ.1)) * ψ σ.1 = _
    rw [hα σ.1 σ.2, toMul_ofMul, show ψ σ.1 =
      flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (lam σ) from (hlam σ).symm]
    show flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2
        (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ)) *
      flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2 (lam σ) = _
    rw [← map_mul]
    rfl
  -- ## Step 6: the corrections: `β` lands in the inertia image
  have hβI : ∀ ι' ∈ globalInertiaSub A',
      β ι' ∈ Subgroup.map lam (globalInertiaSub A') := by
    intro ι' hι'
    show gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD ι') * lam ι' ∈ Subgroup.map lam (globalInertiaSub A')
    rw [hαD1 ι' hι', map_one, one_mul]
    exact Subgroup.mem_map.mpr ⟨ι', hι', rfl⟩
  have hcentral : ∀ x ∈ (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j).ker,
      ∀ y : flowQuotient p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2, x * y = y * x := by
    intro x hx y
    rw [stageProjQuotient_ker] at hx
    obtain ⟨v, rfl⟩ := hx
    have h := gradeIncl_central p (K ≃ₐ[ℚ] K) n i j y v
    calc gradeIncl p (K ≃ₐ[ℚ] K) n i j v * y
        = (y * gradeIncl p (K ≃ₐ[ℚ] K) n i j v * y⁻¹) * y := by rw [h]
      _ = y * gradeIncl p (K ≃ₐ[ℚ] K) n i j v := by group
  have hexpk : ∀ x ∈ (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j).ker, x ^ p = 1 := by
    intro x hx
    rw [stageProjQuotient_ker] at hx
    obtain ⟨v, rfl⟩ := hx
    rw [← map_pow, pow_eq_one_refinedQuotient p i j v, map_one]
  have hpi_beta : ∀ σ : ↥(SSGRoute.decomp ℚ A),
      ∃ a ∈ Subgroup.map lam (globalInertiaSub A'),
        (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) (β σ)
          = (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) a := by
    intro σ
    obtain ⟨τ, hτI, hτeq⟩ := hgen (σ : SSGRoute.GalQ) σ.2
    have hτD : τ ∈ SSGRoute.decomp ℚ A := hτI.1
    have hτmem : (⟨τ, hτD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ globalInertiaSub A' := by
      rw [globalInertiaSub_eq_inertiaSubgroup]
      exact mem_inertiaSubgroup_of_isInertia _ hτI
    refine ⟨lam ⟨τ, hτD⟩, Subgroup.mem_map.mpr ⟨⟨τ, hτD⟩, hτmem, rfl⟩, ?_⟩
    show (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j)
        (gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD σ) * lam σ)
      = (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) (lam ⟨τ, hτD⟩)
    rw [map_mul, MonoidHom.mem_ker.mp (by rw [stageProjQuotient_ker]; exact ⟨αD σ, rfl⟩),
      one_mul, hpi_lam σ, hpi_lam ⟨τ, hτD⟩]
    apply flowInl_injective p (K ≃ₐ[ℚ] K) n i j
    rw [hmu σ, hmu ⟨τ, hτD⟩]
    exact hτeq.symm
  have hβF : β F ∈ Subgroup.map lam (globalInertiaSub A') := by
    have h1 : gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD F) * lam F = (lam ι) ^ m := by
      rw [hαD_F, hξeq, mul_assoc, inv_mul_cancel, mul_one]
    rw [show β F = gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD F) * lam F from rfl, h1]
    have h2 : (lam ι) ^ m ∈ Subgroup.zpowers (lam ι) := Subgroup.mem_zpowers_iff.mpr ⟨m, rfl⟩
    rwa [← hAg] at h2
  have hβmem : ∀ σ : ↥(SSGRoute.decomp ℚ A), β σ ∈ Subgroup.map lam (globalInertiaSub A') :=
    t2LeOfLeZhatGenAux p hp.pos (globalInertiaSub A') (localZhatHom A') (localZhatHom_ker A')
      (localZhatHom_surjective A') (Subgroup.map lam (globalInertiaSub A'))
      (stageProjQuotient p (K ≃ₐ[ℚ] K) n i j) β hβI hcentral hexpk hpi_beta F
      (localZhatHom_localFrobElem A') hβF
  -- ## Step 7: conclusions
  have hadd : ∀ σ ∈ SSGRoute.decomp ℚ A, ∀ τ ∈ SSGRoute.decomp ℚ A, α (σ * τ) = α σ + α τ := by
    intro σ hσ τ hτ
    rw [hα (σ * τ) (Subgroup.mul_mem _ hσ hτ), hα σ hσ, hα τ hτ]
    rw [show (⟨σ * τ, Subgroup.mul_mem _ hσ hτ⟩ : ↥(SSGRoute.decomp ℚ A))
        = ⟨σ, hσ⟩ * ⟨τ, hτ⟩ from Subtype.ext rfl, map_mul αD, ofMul_mul]
  have hzero : ∀ σ : SSGRoute.GalQ, SSGRoute.IsInertia ℚ A σ → α σ = 0 := by
    intro σ hσ
    rw [hα σ hσ.1]
    have hmem : (⟨σ, hσ.1⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ globalInertiaSub A' := by
      rw [globalInertiaSub_eq_inertiaSubgroup]
      exact mem_inertiaSubgroup_of_isInertia _ hσ
    show Additive.ofMul (αD ⟨σ, hσ.1⟩) = 0
    rw [hαD1 ⟨σ, hσ.1⟩ hmem]
    rfl
  have hloc : SSGRoute.IsLocConstOn (SSGRoute.decomp ℚ A) α := by
    have habarpow : NK.TowerRank.powSubgroup p ≤ abar.ker := by
      intro z hz
      rw [MonoidHom.mem_ker]
      obtain ⟨y, hy⟩ := MonoidHom.mem_range.mp hz
      have hy' : y ^ p = z := by simpa [NK.TowerRank.powHom] using hy
      rw [← hy', map_pow]
      exact pow_eq_one_refinedQuotient p i j (abar y)
    have hopen1 : IsOpen (((localZhatHom A') ⁻¹' NK.TowerRank.powSubgroup p) :
        Set ↥(SSGRoute.decomp ℚ A)) :=
      localZhatHom_preimage_powSubgroup_isOpen A' p hp.pos
    obtain ⟨W, hWopen, hW⟩ := isOpen_induced_iff.mp hopen1
    have h1mem : (1 : ↥(SSGRoute.decomp ℚ A)) ∈ ((localZhatHom A') ⁻¹'
        NK.TowerRank.powSubgroup p) := by
      show localZhatHom A' 1 ∈ NK.TowerRank.powSubgroup p
      rw [map_one]
      exact Subgroup.one_mem _
    have hW1 : (1 : SSGRoute.GalQ) ∈ W := by
      have h1' : (1 : ↥(SSGRoute.decomp ℚ A)) ∈ Subtype.val ⁻¹' W := hW ▸ h1mem
      exact h1'
    obtain ⟨Ev, hEfin, hE⟩ := (krullTopology_mem_nhds_one_iff ℚ SSGRoute.QBar W).mp
      (hWopen.mem_nhds hW1)
    refine ⟨Ev.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen Ev, ?_⟩
    intro g hg u hu huD
    rw [hα (g * u) (Subgroup.mul_mem _ hg huD), hα g hg]
    have hmem : (⟨g * u, Subgroup.mul_mem _ hg huD⟩ : ↥(SSGRoute.decomp ℚ A)) =
        ⟨g, hg⟩ * ⟨u, huD⟩ := Subtype.ext rfl
    have huW : (u : SSGRoute.GalQ) ∈ W := hE hu
    have huS : (⟨u, huD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈
        ((localZhatHom A') ⁻¹' NK.TowerRank.powSubgroup p) := by
      have h' : (⟨u, huD⟩ : ↥(SSGRoute.decomp ℚ A)) ∈ Subtype.val ⁻¹' W := huW
      rwa [hW] at h'
    have hucl : localZhatHom A' ⟨u, huD⟩ ∈ NK.TowerRank.powSubgroup p := huS
    rw [hmem, map_mul]
    have h1 : αD ⟨u, huD⟩ = 1 := MonoidHom.mem_ker.mp (habarpow hucl)
    rw [h1, mul_one]
  have hclosure : Subgroup.closure
      ((flowTwistE p K n i j α ψ) '' (SSGRoute.decomp ℚ A : Set SSGRoute.GalQ))
      = Subgroup.map (flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2)
          (Subgroup.map lam (globalInertiaSub A')) := by
    apply le_antisymm
    · rw [Subgroup.closure_le]
      rintro y ⟨σ, hσ, rfl⟩
      exact Subgroup.mem_map.mpr ⟨β ⟨σ, hσ⟩, hβmem ⟨σ, hσ⟩, (htwist ⟨σ, hσ⟩).symm⟩
    · rw [Subgroup.map_le_iff_le_comap]
      intro a ha
      obtain ⟨ι', hι', rfl⟩ := Subgroup.mem_map.mp ha
      refine Subgroup.subset_closure ⟨ι'.1, ι'.2, ?_⟩
      have hβι : β ι' = lam ι' := by
        show gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD ι') * lam ι' = lam ι'
        rw [hαD1 ι' hι', map_one, one_mul]
      rw [htwist ι', hβι]
  refine ⟨α, hadd, hloc, hzero, ?_, ?_⟩
  · have hcycAq : IsCyclic ↥(Subgroup.map lam (globalInertiaSub A')) := by
      rw [globalInertiaSub_eq_inertiaSubgroup]
      exact hcyclam
    have hcycmap : IsCyclic ↥((Subgroup.map lam (globalInertiaSub A')).map
        (flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2)) :=
      (Subgroup.equivMapOfInjective (Subgroup.map lam (globalInertiaSub A'))
        (flowInl p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2)
        (flowInl_injective p (K ≃ₐ[ℚ] K) n (tauSucc i j).1 (tauSucc i j).2)).isCyclic.mp hcycAq
    rw [hclosure]
    exact hcycmap
  · intro σ hσ
    obtain ⟨ι', hι', hι'eq⟩ := Subgroup.mem_map.mp (hβmem ⟨σ, hσ⟩)
    refine ⟨ι'.1, ?_, ?_⟩
    · have hmem : ι' ∈ ValuationSubring.inertiaSubgroup ℚ A := by
        have h' := hι'
        rw [globalInertiaSub_eq_inertiaSubgroup A'] at h'
        exact h'
      exact isInertia_of_mem_inertiaSubgroup hmem
    · have hβι : β ι' = lam ι' := by
        show gradeIncl p (K ≃ₐ[ℚ] K) n i j (αD ι') * lam ι' = lam ι'
        rw [hαD1 ι' hι', map_one, one_mul]
      rw [htwist ⟨σ, hσ⟩, htwist ι', hβι, hι'eq]

end Work.SSGRoute
