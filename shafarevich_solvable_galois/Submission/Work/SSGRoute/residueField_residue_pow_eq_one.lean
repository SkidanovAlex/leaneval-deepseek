namespace Work.SSGRoute

open SSGRoute

set_option linter.style.haveILetI false

/-- **Every element of the residue field of a finite place of `ℚ̄` over `ℚ` is `0` or a root of
unity of order prime to the residue characteristic.**

Let `A` be a finite place of `ℚ̄` (a valuation subring whose restriction to `ℚ` is proper) and
`p = residueChar A` the rational prime below it.  For `a : ↥A.1` the residue
`IsLocalRing.residue ↥A.1 a` is either `0` or satisfies `x ^ N = 1` for some `N > 0` with `p ∤ N`.

Indeed, the residue field `κ` of `A.1` is the algebraic closure `𝔽̄_p` of `𝔽_p`: with the level
`L = ℚ(a)` generated by `a`, the element `a` lies in the valuation ring `B = A.1 ∩ L` of the number
field `L`, and `a` is integral over the residue field `F₀` of `B` restricted to the prime field `ℚ`
(`NK.RamificationAudit.exists_monic_aeval_eq_zero_natDegree_le`, the linear independence of lifts).
`F₀` is the finite field `𝔽_p` (`finite_card_residueField_comap_bot`), so `x` lies in the finite
field `F₀⟮x⟯ ⊆ κ` and is a root of unity whose order divides `#F₀⟮x⟯ - 1 = p ^ d - 1`
(`pow_exists_eq_one_of_isIntegral_finite_base`), which is prime to `p`. -/
theorem residueField_residue_pow_eq_one
    (A : NK.FrobeniusBridge.FinitePlaceOf ℚ SSGRoute.QBar) (p : ℕ)
    (hp : p = Work.SSGRoute.residueChar A) (a : ↥A.1) :
    IsLocalRing.residue ↥A.1 a = 0 ∨
      ∃ N : ℕ, 0 < N ∧ ¬ p ∣ N ∧ (IsLocalRing.residue ↥A.1 a) ^ N = 1 := by
  by_cases hx : IsLocalRing.residue ↥A.1 a = 0
  · exact Or.inl hx
  · right
    -- the finite level `L = ℚ(a)` generated by `a`
    let L : IntermediateField ℚ SSGRoute.QBar :=
      IntermediateField.adjoin ℚ ({(a : SSGRoute.QBar)} : Set SSGRoute.QBar)
    haveI hLfd : FiniteDimensional ℚ L :=
      IntermediateField.adjoin.finiteDimensional
        ((Algebra.IsAlgebraic.isAlgebraic (a : SSGRoute.QBar)).isIntegral)
    -- the valuation ring of the level, and `a` as an element of it
    let B : ValuationSubring ↥L := A.1.comap (algebraMap ↥L SSGRoute.QBar)
    have haL : (a : SSGRoute.QBar) ∈ L :=
      IntermediateField.mem_adjoin_simple_self ℚ (a : SSGRoute.QBar)
    let y : ↥B := ⟨⟨(a : SSGRoute.QBar), haL⟩, by
      show algebraMap ↥L SSGRoute.QBar ⟨(a : SSGRoute.QBar), haL⟩ ∈ A.1
      simpa using a.2⟩
    have hcomapy : NK.RamificationAudit.comapToA A.1 L y = a := by
      ext
      simp [y, NK.RamificationAudit.comapToA]
    -- `a` is a root of a monic polynomial over the residue field of the prime field
    obtain ⟨f, hfmonic, _hfdeg, hf⟩ :=
      NK.RamificationAudit.exists_monic_aeval_eq_zero_natDegree_le B (⊥ : IntermediateField ℚ ↥L)
        (IsLocalRing.residue ↥B y)
    -- the map on residue fields induced by the inclusions `A.1 ∩ L ⊆ L ⊆ ℚ̄` and `A.1 ∩ L ⊆ A.1`
    let ψ : IsLocalRing.ResidueField ↥B →+* IsLocalRing.ResidueField ↥A.1 :=
      IsLocalRing.ResidueField.map (NK.RamificationAudit.comapToA A.1 L)
    let F0 := IsLocalRing.ResidueField ↥(B.comap (algebraMap ↥(⊥ : IntermediateField ℚ ↥L) ↥L))
    letI : Algebra F0 (IsLocalRing.ResidueField ↥A.1) :=
      (ψ.comp (algebraMap F0 (IsLocalRing.ResidueField ↥B))).toAlgebra
    -- the residue of `a` is the image of the residue of `y`
    have hxψ : ψ (IsLocalRing.residue ↥B y) = IsLocalRing.residue ↥A.1 a := by
      rw [IsLocalRing.ResidueField.map_residue, hcomapy]
    -- `y` is integral over `F0`, hence so is its image `a` in `κ`
    have hzint : IsIntegral F0 (IsLocalRing.residue ↥B y) := ⟨f, hfmonic, hf⟩
    have hcompat : (algebraMap F0 (IsLocalRing.ResidueField ↥A.1)).comp (RingHom.id F0) =
        ψ.comp (algebraMap F0 (IsLocalRing.ResidueField ↥B)) := by
      ext z
      rfl
    have hint : IsIntegral F0 (IsLocalRing.residue ↥A.1 a) := by
      rw [← hxψ]
      exact IsIntegral.map_of_comp_eq (RingHom.id F0) ψ hcompat hzint
    -- `F0` is the finite field `𝔽_p`
    obtain ⟨hFin, hcard⟩ := finite_card_residueField_comap_bot A L
    haveI : Finite F0 := hFin
    exact pow_exists_eq_one_of_isIntegral_finite_base p (hcard.trans hp.symm) hx hint

end Work.SSGRoute
