/-!
# The function extending a cochain from `C = closure (zpowers σ)` to `D_A = decomp k A`

Let `k` be a number field, `Ω` an algebraic closure of `k`, `A` a place of `Ω`, `D_A = decomp k A`
its decomposition group, `I ≤ D_A` a subgroup normalised by `D_A` and `C = closure (zpowers σ)`
the procyclic closed subgroup generated by `σ ∈ D_A`, with `D_A ≤ I ⊔ C` and `I ⊓ C = ⊥` (so
`D_A = I ⋊ C`).

Given a cochain `a` on the absolute Galois group `G_k = Ω ≃ₐ[k] Ω`, the formula

  `extFun a d = a (proj d)`  for `d ∈ D_A`,   `extFun a x = 0`  for `x ∉ D_A`,

where `proj d` is the `C`-coordinate of `d`, is the candidate extension of `a` to `D_A` used in
`Work.SSGRoute.HSTwoRow.extension_of_lcCocycle`.  This file defines it, together with the group
homomorphism `DprojHom` of the `C`-coordinate, and records its elementary properties: it vanishes
on `I` and restricts to `a` on `C`.  The two substantial properties (being a `1`-cocycle whenever
`a` is one, and local constancy) are proved in the sibling files
`HSTwoRow/extFun_isCocycleOn` and `HSTwoRow/extFun_isLocConstOn`.
-/

set_option linter.unusedSectionVars false

open scoped Pointwise
open Classical

namespace Work.SSGRoute.HSTwoRow

noncomputable section

variable {k Ω : Type} [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]

/-- **The `C`-coordinate** `↥(decomp k A) →* ↥(closure (zpowers σ))` of the semidirect
decomposition `D_A = I ⋊ C`. -/
def DprojHom (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥) :
    ↥(SSGRoute.decomp k A) →* ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) where
  toFun d := HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup d
  map_one' := by
    show HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup (1 : ↥(SSGRoute.decomp k A)) = 1
    apply Subtype.ext
    exact (HS.factor_unique A I σ hinf (I.one_mem)
      (HS.ip A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup 1).2
      (Subgroup.one_mem (Subgroup.topologicalClosure (Subgroup.zpowers σ)))
      (HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup 1).2
      (by rw [HS.ip_mul_proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup 1]; rfl)).2.symm
  map_mul' d₁ d₂ := HS.proj_mul A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup hinf d₁ d₂

/-- The candidate extension to `D_A` of a cochain `a` on `G_k`: `a ∘ proj` on `D_A`, `0` outside. -/
def extFun {M : Type} [Zero M] (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω))
    (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (a : (Ω ≃ₐ[k] Ω) → M) : (Ω ≃ₐ[k] Ω) → M :=
  fun x => if hx : x ∈ SSGRoute.decomp k A then
    a ↑(HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨x, hx⟩) else 0

/-- The value of `extFun a` on `D_A`. -/
theorem extFun_apply_of_mem {M : Type} [Zero M] (A : ValuationSubring Ω)
    (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (a : (Ω ≃ₐ[k] Ω) → M) {x : Ω ≃ₐ[k] Ω} (hx : x ∈ SSGRoute.decomp k A) :
    extFun A I σ hI hnorm hσ hsup a x
      = a ↑(HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨x, hx⟩) :=
  dif_pos hx

/-- **`H⁰_loc(I)` is stable under the action of the decomposition group `D_A`** (which normalises
`I`). -/
theorem smul_mem_H0loc_of_mem_decomp (p : ℕ) [Fact p.Prime] (K : IntermediateField k Ω)
    [FiniteDimensional k K] [IsGalois k K]
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    {c : Ω ≃ₐ[k] Ω} (hc : c ∈ SSGRoute.decomp k A) {m : M}
    (hm : m ∈ SSGRoute.H0loc p k Ω K M I) :
    SSGRoute.res k K c • m ∈ SSGRoute.H0loc p k Ω K M I := by
  intro g hg
  have hcgc : c⁻¹ * g * c ∈ I := by
    have h := hnorm c⁻¹ ((SSGRoute.decomp k A).inv_mem hc) g hg
    simpa using h
  calc SSGRoute.res k K g • (SSGRoute.res k K c • m)
      = (SSGRoute.res k K g * SSGRoute.res k K c) • m := (mul_smul _ _ _).symm
    _ = SSGRoute.res k K (g * c) • m := by rw [map_mul]
    _ = SSGRoute.res k K (c * (c⁻¹ * g * c)) • m := by
          rw [show g * c = c * (c⁻¹ * g * c) from by group]
    _ = (SSGRoute.res k K c * SSGRoute.res k K (c⁻¹ * g * c)) • m := by rw [map_mul]
    _ = SSGRoute.res k K c • (SSGRoute.res k K (c⁻¹ * g * c) • m) := mul_smul _ _ _
    _ = SSGRoute.res k K c • m := by rw [hm _ hcgc]

/-- **`extFun a` vanishes on `I`** when `a 1 = 0`. -/
theorem extFun_eq_zero_on_I {M : Type} [Zero M] (A : ValuationSubring Ω)
    (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (a : (Ω ≃ₐ[k] Ω) → M) (ha1 : a 1 = 0) :
    ∀ i ∈ I, extFun A I σ hI hnorm hσ hsup a i = 0 := by
  intro i hi
  have hiD : i ∈ SSGRoute.decomp k A := hI hi
  rw [extFun_apply_of_mem A I σ hI hnorm hσ hsup a hiD]
  have hprj : HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨i, hiD⟩ = 1 := by
    apply Subtype.ext
    exact (HS.factor_unique A I σ hinf hi
      (HS.ip A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨i, hiD⟩).2
      (Subgroup.one_mem (Subgroup.topologicalClosure (Subgroup.zpowers σ)))
      (HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨i, hiD⟩).2
      (by rw [HS.ip_mul_proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨i, hiD⟩]
          exact mul_one i)).2.symm
  rw [hprj]
  simpa using ha1

/-- **`extFun a` restricts to `a` on `C = closure (zpowers σ)`.** -/
theorem extFun_eq_on_C {M : Type} [Zero M] (A : ValuationSubring Ω)
    (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (a : (Ω ≃ₐ[k] Ω) → M) :
    ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ),
      extFun A I σ hI hnorm hσ hsup a γ = a γ := by
  intro γ hγ
  have hγD : γ ∈ SSGRoute.decomp k A := (HS.CC_le_DD A σ hσ) hγ
  rw [extFun_apply_of_mem A I σ hI hnorm hσ hsup a hγD]
  have hprj : HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨γ, hγD⟩ = ⟨γ, hγ⟩ := by
    apply Subtype.ext
    exact (HS.factor_unique A I σ hinf (I.one_mem)
      (HS.ip A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨γ, hγD⟩).2 hγ
      (HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨γ, hγD⟩).2
      (by rw [HS.ip_mul_proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup ⟨γ, hγD⟩]
          exact one_mul γ)).2.symm
  rw [hprj]

end

end Work.SSGRoute.HSTwoRow
