/-- **A locally constant `1`-cocycle on `C = closure (zpowers σ)` vanishing at `σ` vanishes on
`C`.**  The zero set is a subgroup of `↥C` containing `σ`; it is open (it contains the preimage of
the local-constancy subgroup `U`), hence closed, so it contains the closure of the cyclic subgroup
generated by `σ`, which is all of `↥C`. -/
lemma lcCocycleOn_zpowers_eq_zero_of_gen_eq_zero
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
    [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (σ : Ω ≃ₐ[k] Ω) (a : (Ω ≃ₐ[k] Ω) → M)
    (hcoc : SSGRoute.IsCocycleOn (SSGRoute.res k K)
      (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (hlc : SSGRoute.IsLocConstOn (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (hσ : a σ = 0) :
    ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), a γ = 0 := by
  classical
  set C : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.topologicalClosure (Subgroup.zpowers σ) with hCdef
  have hσC : σ ∈ C := Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers σ)
  obtain ⟨U, hUo, hU⟩ := hlc
  -- `a 1 = 0`
  have ha1 : a 1 = 0 := by
    have h := hcoc 1 (Subgroup.one_mem C) 1 (Subgroup.one_mem C)
    simp only [mul_one, map_one, one_smul] at h
    have h' : a 1 + 0 = a 1 + a 1 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  let T : Subgroup ↥C :=
    { carrier := {γ | a (γ : Ω ≃ₐ[k] Ω) = 0}
      one_mem' := ha1
      mul_mem' := by
        intro x y hx hy
        change a ((x : Ω ≃ₐ[k] Ω) * (y : Ω ≃ₐ[k] Ω)) = 0
        rw [hcoc _ x.2 _ y.2, hx, hy, smul_zero, add_zero]
      inv_mem' := by
        intro x hx
        change a ((x : Ω ≃ₐ[k] Ω)⁻¹) = 0
        have h11 : a (1 : Ω ≃ₐ[k] Ω)
            = a (x : Ω ≃ₐ[k] Ω) + SSGRoute.res k K (x : Ω ≃ₐ[k] Ω) • a ((x : Ω ≃ₐ[k] Ω)⁻¹) := by
          have h := hcoc _ x.2 _ (C.inv_mem x.2)
          rwa [mul_inv_cancel] at h
        rw [ha1, hx, zero_add] at h11
        calc a ((x : Ω ≃ₐ[k] Ω)⁻¹)
            = SSGRoute.res k K (x : Ω ≃ₐ[k] Ω)⁻¹
                • (SSGRoute.res k K (x : Ω ≃ₐ[k] Ω) • a ((x : Ω ≃ₐ[k] Ω)⁻¹)) := by
              rw [← mul_smul, ← map_mul, inv_mul_cancel, map_one, one_smul]
          _ = 0 := by rw [h11.symm, smul_zero] }
  have hσT : (⟨σ, hσC⟩ : ↥C) ∈ T := hσ
  have hTopen : IsOpen (T : Set ↥C) := by
    have h1 : (Subgroup.comap (Subgroup.subtype C) U : Subgroup ↥C) ≤ T := by
      intro x hx
      change a (x : Ω ≃ₐ[k] Ω) = 0
      have hxU : (x : Ω ≃ₐ[k] Ω) ∈ U := hx
      have h := hU 1 (Subgroup.one_mem C) (x : Ω ≃ₐ[k] Ω) hxU x.2
      rw [one_mul, ha1] at h
      exact h
    have hUopen' : IsOpen ((Subgroup.comap (Subgroup.subtype C) U : Subgroup ↥C) : Set ↥C) := by
      rw [Subgroup.coe_comap]
      exact hUo.preimage continuous_subtype_val
    exact Subgroup.isOpen_mono h1 hUopen'
  have hTclosed : IsClosed (T : Set ↥C) := Subgroup.isClosed_of_isOpen T hTopen
  have hle : Subgroup.zpowers (⟨σ, hσC⟩ : ↥C) ≤ T := Subgroup.zpowers_le.mpr hσT
  have hcl : Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C)) ≤ T :=
    Subgroup.topologicalClosure_minimal _ hle hTclosed
  have hmap : (Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C))).map
      (Subgroup.subtype C) = C := by
    exact Work.SSGRoute.map_topologicalClosure_zpowers_subtype C
      (Subgroup.isClosed_topologicalClosure _) σ hσC
  intro γ hγ
  have hx : γ ∈ (Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C))).map
      (Subgroup.subtype C) := by
    rw [hmap]
    exact hγ
  obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
  have hyeq : y = (⟨γ, hγ⟩ : ↥C) := Subtype.ext hyx
  exact hcl (hyeq ▸ hy)


/-- **`ip` and `proj` are continuous.**  The multiplication map `↥I × ↥C → ↥D` is a continuous
bijection between compact Hausdorff spaces, hence a homeomorphism; `ip` and `proj` are its two
components. -/
lemma continuous_ip_proj
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥) :
    Continuous (fun d : ↥(SSGRoute.decomp k A) =>
        ((HS.proj A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup d :
          ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ))) : Ω ≃ₐ[k] Ω)) ∧
    Continuous (fun d : ↥(SSGRoute.decomp k A) =>
        ((HS.ip A I σ hI hnorm (HS.CC_le_DD A σ hσ) hsup d : ↥I) : Ω ≃ₐ[k] Ω)) := by
  classical
  haveI : T2Space (Ω ≃ₐ[k] Ω) := krullTopology_t2 (K := k) (L := Ω)
  have hCD : Subgroup.topologicalClosure (Subgroup.zpowers σ) ≤ SSGRoute.decomp k A :=
    HS.CC_le_DD A σ hσ
  haveI : CompactSpace ↥I := isCompact_iff_compactSpace.mp hIclosed.isCompact
  haveI : CompactSpace ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) :=
    isCompact_iff_compactSpace.mp (Subgroup.isClosed_topologicalClosure _).isCompact
  let Ψ : ↥I × ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) → ↥(SSGRoute.decomp k A) :=
    fun x => ⟨(x.1 : Ω ≃ₐ[k] Ω) * (x.2 : Ω ≃ₐ[k] Ω),
      (SSGRoute.decomp k A).mul_mem (hI x.1.2) (hCD x.2.2)⟩
  have hΨcont : Continuous Ψ := by
    refine Continuous.subtype_mk ?_ _
    exact (continuous_subtype_val.comp continuous_fst).mul
      (continuous_subtype_val.comp continuous_snd)
  have hΨbij : Function.Bijective Ψ := by
    constructor
    · intro x y hxy
      have h : (x.1 : Ω ≃ₐ[k] Ω) * (x.2 : Ω ≃ₐ[k] Ω)
          = (y.1 : Ω ≃ₐ[k] Ω) * (y.2 : Ω ≃ₐ[k] Ω) := by
        simpa [Ψ] using congrArg (fun z : ↥(SSGRoute.decomp k A) => (z : Ω ≃ₐ[k] Ω)) hxy
      obtain ⟨h1, h2⟩ := HS.factor_unique A I σ hinf x.1.2 y.1.2 x.2.2 y.2.2 h
      exact Prod.ext (Subtype.ext h1) (Subtype.ext h2)
    · intro d
      obtain ⟨i, hi, γ, hγ, hprod⟩ := HS.exists_factor A I σ hI hnorm hCD hsup d.2
      exact ⟨(⟨i, hi⟩, ⟨γ, hγ⟩), Subtype.ext hprod⟩
  let eH : ↥I × ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) ≃ₜ
      ↥(SSGRoute.decomp k A) :=
    Continuous.homeoOfEquivCompactToT2 (f := Equiv.ofBijective Ψ hΨbij) hΨcont
  have hkey : ∀ d : ↥(SSGRoute.decomp k A),
      ((eH.symm d).1 : Ω ≃ₐ[k] Ω) * ((eH.symm d).2 : Ω ≃ₐ[k] Ω)
        = (d : Ω ≃ₐ[k] Ω) := by
    intro d
    have h := congrArg (fun z : ↥(SSGRoute.decomp k A) => (z : Ω ≃ₐ[k] Ω))
      (eH.apply_symm_apply d)
    rw [← h]
    rfl
  have hproj_eq : ∀ d : ↥(SSGRoute.decomp k A),
      HS.proj A I σ hI hnorm hCD hsup d = (eH.symm d).2 := by
    intro d
    have h1 := HS.ip_mul_proj A I σ hI hnorm hCD hsup d
    obtain ⟨-, hγ⟩ := HS.factor_unique A I σ hinf
      (HS.ip A I σ hI hnorm hCD hsup d).2 (eH.symm d).1.2
      (HS.proj A I σ hI hnorm hCD hsup d).2 (eH.symm d).2.2
      (by rw [h1, hkey d])
    exact Subtype.ext hγ
  have hip_eq : ∀ d : ↥(SSGRoute.decomp k A),
      HS.ip A I σ hI hnorm hCD hsup d = (eH.symm d).1 := by
    intro d
    have h1 := HS.ip_mul_proj A I σ hI hnorm hCD hsup d
    obtain ⟨hi, -⟩ := HS.factor_unique A I σ hinf
      (HS.ip A I σ hI hnorm hCD hsup d).2 (eH.symm d).1.2
      (HS.proj A I σ hI hnorm hCD hsup d).2 (eH.symm d).2.2
      (by rw [h1, hkey d])
    exact Subtype.ext hi
  refine ⟨?_, ?_⟩
  · have hfun : (fun d : ↥(SSGRoute.decomp k A) =>
        ((HS.proj A I σ hI hnorm hCD hsup d :
          ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ))) : Ω ≃ₐ[k] Ω))
        = fun d => (((eH.symm d).2 :
            ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ))) : Ω ≃ₐ[k] Ω) :=
      funext (fun d => by rw [hproj_eq d])
    rw [hfun]
    exact (continuous_subtype_val.comp continuous_snd).comp eH.symm.continuous
  · have hfun : (fun d : ↥(SSGRoute.decomp k A) =>
        ((HS.ip A I σ hI hnorm hCD hsup d : ↥I) : Ω ≃ₐ[k] Ω))
        = fun d => (((eH.symm d).1 : ↥I) : Ω ≃ₐ[k] Ω) :=
      funext (fun d => by rw [hip_eq d])
    rw [hfun]
    exact (continuous_subtype_val.comp continuous_fst).comp eH.symm.continuous

/-- **The key identity `(†)`.**  If `b` is a `1`-cocycle on `I` and `a` a `1`-cocycle on
`C = closure (zpowers σ)` with `a σ = m`, and if `res σ • b (σ⁻¹ j σ) - b j = res j • m - m` for
all `j ∈ I`, then the obstruction
`Ψ γ j := res γ • b (γ⁻¹ j γ) - b j - (res j • a γ - a γ)`
vanishes for every `γ ∈ C` and `j ∈ I`.  This is exactly the compatibility condition making
`f (i * γ) := b i + res i • a γ` a `1`-cocycle on `D = decomp k A`. -/
theorem Psi_eq_zero
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (b : (Ω ≃ₐ[k] Ω) → M) (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) I b)
    (hblc : SSGRoute.IsLocConstOn I b)
    (a : (Ω ≃ₐ[k] Ω) → M)
    (hacoc : SSGRoute.IsCocycleOn (SSGRoute.res k K)
      (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (halc : SSGRoute.IsLocConstOn (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (m : M) (haσ : a σ = m)
    (hm : ∀ j ∈ I, SSGRoute.res k K σ • b (σ⁻¹ * j * σ) - b j = SSGRoute.res k K j • m - m) :
    ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), ∀ j ∈ I,
      SSGRoute.res k K γ • b (γ⁻¹ * j * γ) - b j
        = SSGRoute.res k K j • a γ - a γ := by
  classical
  set C : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.topologicalClosure (Subgroup.zpowers σ) with hCdef
  have hCD : C ≤ SSGRoute.decomp k A := HS.CC_le_DD A σ hσ
  have hσC : σ ∈ C := Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers σ)
  have ha1 : a 1 = 0 := by
    have h := hacoc 1 (Subgroup.one_mem C) 1 (Subgroup.one_mem C)
    simp only [mul_one, map_one, one_smul] at h
    have h' : a 1 + 0 = a 1 + a 1 := by rw [add_zero]; exact h
    exact (add_left_cancel h').symm
  obtain ⟨Ub, hUbo, hUb⟩ := hblc
  obtain ⟨Ua, hUao, hUa⟩ := halc
  have hopen : IsOpen ((Ub ⊓ Ua ⊓ K.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) :
      Set (Ω ≃ₐ[k] Ω)) := by
    rw [Subgroup.coe_inf, Subgroup.coe_inf]
    exact (hUbo.inter hUao).inter (IntermediateField.fixingSubgroup_isOpen K)
  obtain ⟨E, hEfin, hEnorm, hEsub⟩ :=
    Work.SSGRoute.exists_finiteDimensional_normal_fixingSubgroup_le (U := k) (L := Ω)
      (Ub ⊓ Ua ⊓ K.fixingSubgroup) hopen
  haveI : FiniteDimensional k E := hEfin
  haveI : Normal k E := hEnorm
  have hEker : E.fixingSubgroup = (SSGRoute.res k E).ker :=
    (IntermediateField.restrictNormalHom_ker E).symm
  haveI hEnormfix : E.fixingSubgroup.Normal := by rw [hEker]; infer_instance
  have hUsubUb : E.fixingSubgroup ≤ Ub := fun x hx => (hEsub hx).1.1
  have hUsubUa : E.fixingSubgroup ≤ Ua := fun x hx => (hEsub hx).1.2
  have hUsubK : E.fixingSubgroup ≤ K.fixingSubgroup := fun x hx => (hEsub hx).2
  have haU : ∀ u ∈ (C ⊓ E.fixingSubgroup), a u = 0 := by
    intro u hu
    have huUa : u ∈ Ua := hUsubUa (Subgroup.mem_inf.mp hu).2
    have huC : u ∈ C := (Subgroup.mem_inf.mp hu).1
    have h := hUa 1 (Subgroup.one_mem C) u huUa huC
    rw [one_mul, ha1] at h
    exact h
  have hbu : ∀ u ∈ (C ⊓ E.fixingSubgroup), ∀ x ∈ I, b (u⁻¹ * x * u) = b x := by
    intro u hu x hx
    have huE : u ∈ E.fixingSubgroup := (Subgroup.mem_inf.mp hu).2
    have huC : u ∈ C := (Subgroup.mem_inf.mp hu).1
    have hconjI : u⁻¹ * x * u ∈ I :=
      hnorm u⁻¹ ((SSGRoute.decomp k A).inv_mem (hCD huC)) x hx
    have hinvE : u⁻¹ ∈ E.fixingSubgroup := E.fixingSubgroup.inv_mem huE
    have hx1E : x⁻¹ * u⁻¹ * x ∈ E.fixingSubgroup :=
      hEnormfix.conj_mem u⁻¹ hinvE x⁻¹
    have hwE : x⁻¹ * u⁻¹ * x * u ∈ E.fixingSubgroup := E.fixingSubgroup.mul_mem hx1E huE
    have hx1I : x⁻¹ ∈ I := I.inv_mem hx
    have hwI : x⁻¹ * u⁻¹ * x * u ∈ I := by
      have h := I.mul_mem hx1I hconjI
      rwa [show x⁻¹ * (u⁻¹ * x * u) = x⁻¹ * u⁻¹ * x * u from by group] at h
    have hwUb : x⁻¹ * u⁻¹ * x * u ∈ Ub := hUsubUb hwE
    have hkey : u⁻¹ * x * u = x * (x⁻¹ * u⁻¹ * x * u) := by group
    rw [hkey]
    exact hUb x hx (x⁻¹ * u⁻¹ * x * u) hwUb hwI
  let Ψ : (Ω ≃ₐ[k] Ω) → (Ω ≃ₐ[k] Ω) → M := fun γ j =>
    SSGRoute.res k K γ • b (γ⁻¹ * j * γ) - b j - (SSGRoute.res k K j • a γ - a γ)
  have hPsi_mul : ∀ γ₁ γ₂ : Ω ≃ₐ[k] Ω, γ₁ ∈ C → γ₂ ∈ C → ∀ j : Ω ≃ₐ[k] Ω,
      Ψ (γ₁ * γ₂) j = SSGRoute.res k K γ₁ • Ψ γ₂ (γ₁⁻¹ * j * γ₁) + Ψ γ₁ j := by
    intro γ₁ γ₂ h1C h2C j
    have hconj : (γ₁ * γ₂)⁻¹ * j * (γ₁ * γ₂) = γ₂⁻¹ * (γ₁⁻¹ * j * γ₁) * γ₂ := by group
    have ha := hacoc γ₁ h1C γ₂ h2C
    have hres : SSGRoute.res k K (γ₁ * γ₂) = SSGRoute.res k K γ₁ * SSGRoute.res k K γ₂ :=
      map_mul _ _ _
    have hmid : SSGRoute.res k K γ₁ • (SSGRoute.res k K (γ₁⁻¹ * j * γ₁) • a γ₂)
        = SSGRoute.res k K j • (SSGRoute.res k K γ₁ • a γ₂) := by
      have hresmul : SSGRoute.res k K γ₁ * SSGRoute.res k K (γ₁⁻¹ * j * γ₁)
          = SSGRoute.res k K j * SSGRoute.res k K γ₁ := by
        rw [← map_mul, ← map_mul]
        congr 1
        group
      calc SSGRoute.res k K γ₁ • (SSGRoute.res k K (γ₁⁻¹ * j * γ₁) • a γ₂)
          = (SSGRoute.res k K γ₁ * SSGRoute.res k K (γ₁⁻¹ * j * γ₁)) • a γ₂ := by
            rw [mul_smul]
        _ = (SSGRoute.res k K j * SSGRoute.res k K γ₁) • a γ₂ := by rw [hresmul]
        _ = SSGRoute.res k K j • (SSGRoute.res k K γ₁ • a γ₂) := by rw [mul_smul]
    simp only [Ψ, hconj, ha]
    rw [hres]
    simp only [mul_smul, smul_add, smul_sub]
    rw [hmid]
    abel
  have hS1 : ∀ j ∈ I, Ψ 1 j = 0 := by
    intro j hj
    simp only [Ψ, inv_one, one_mul, mul_one, map_one, one_smul, ha1, sub_zero, smul_zero,
      sub_self]
  have hSmul : ∀ γ₁ γ₂ : Ω ≃ₐ[k] Ω, γ₁ ∈ C → γ₂ ∈ C →
      (∀ j ∈ I, Ψ γ₁ j = 0) → (∀ j ∈ I, Ψ γ₂ j = 0) → ∀ j ∈ I, Ψ (γ₁ * γ₂) j = 0 := by
    intro γ₁ γ₂ h1C h2C h1 h2 j hj
    have hjI : γ₁⁻¹ * j * γ₁ ∈ I :=
      hnorm γ₁⁻¹ ((SSGRoute.decomp k A).inv_mem (hCD h1C)) j hj
    rw [hPsi_mul γ₁ γ₂ h1C h2C j, h2 _ hjI, h1 j hj, smul_zero, add_zero]
  have hSinv : ∀ γ : Ω ≃ₐ[k] Ω, γ ∈ C → (∀ j ∈ I, Ψ γ j = 0) →
      ∀ j ∈ I, Ψ γ⁻¹ j = 0 := by
    intro γ hmem hγ j hj
    have h1 : ∀ w ∈ I, Ψ γ⁻¹ (γ⁻¹ * w * γ) = 0 := by
      intro w hw
      have h2 := hPsi_mul γ γ⁻¹ hmem (C.inv_mem hmem) w
      rw [mul_inv_cancel] at h2
      rw [hS1 w hw, hγ w hw, add_zero] at h2
      have h2' : SSGRoute.res k K γ • Ψ γ⁻¹ (γ⁻¹ * w * γ) = 0 := h2.symm
      calc Ψ γ⁻¹ (γ⁻¹ * w * γ)
          = SSGRoute.res k K γ⁻¹ • (SSGRoute.res k K γ • Ψ γ⁻¹ (γ⁻¹ * w * γ)) := by
            rw [← mul_smul, ← map_mul, inv_mul_cancel, map_one, one_smul]
        _ = 0 := by rw [h2', smul_zero]
    have hjI : γ * j * γ⁻¹ ∈ I := hnorm γ (hCD hmem) j hj
    have h := h1 _ hjI
    rwa [show γ⁻¹ * (γ * j * γ⁻¹) * γ = j from by group] at h
  let S : Subgroup ↥C :=
    { carrier := {γ | ∀ j ∈ I, Ψ (γ : Ω ≃ₐ[k] Ω) j = 0}
      one_mem' := hS1
      mul_mem' := fun {x y} hx hy => hSmul (x : Ω ≃ₐ[k] Ω) (y : Ω ≃ₐ[k] Ω) x.2 y.2 hx hy
      inv_mem' := fun {x} hx => hSinv (x : Ω ≃ₐ[k] Ω) x.2 hx }
  have hUeq : ((C ⊓ E.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω))) =
      (C ⊓ E.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) := rfl
  have hUS : (Subgroup.comap (Subgroup.subtype C)
      ((C ⊓ E.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) : Subgroup (Ω ≃ₐ[k] Ω))) ≤ S := by
    intro γ hγ
    rw [Subgroup.mem_comap] at hγ
    obtain ⟨hγC, hγE⟩ := Subgroup.mem_inf.mp hγ
    intro j hj
    have hres1 : SSGRoute.res k K (γ : Ω ≃ₐ[k] Ω) = 1 := by
      have hmem : (γ : Ω ≃ₐ[k] Ω) ∈ (SSGRoute.res k K).ker := by
        rw [IntermediateField.restrictNormalHom_ker K]
        exact hUsubK hγE
      exact MonoidHom.mem_ker.mp hmem
    have haU' : a (γ : Ω ≃ₐ[k] Ω) = 0 := haU _ ⟨hγC, hγE⟩
    have hbu' : b ((γ : Ω ≃ₐ[k] Ω)⁻¹ * j * (γ : Ω ≃ₐ[k] Ω)) = b j := hbu _ ⟨hγC, hγE⟩ j hj
    simp only [Ψ, hres1, one_smul, haU', sub_zero, hbu']
    simp
  have hSopen : IsOpen ((Subgroup.comap (Subgroup.subtype C)
      ((C ⊓ E.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) : Subgroup (Ω ≃ₐ[k] Ω)) :
        Subgroup ↥C) : Set ↥C) := by
    rw [Subgroup.coe_comap]
    refine isOpen_induced_iff.mpr ⟨(E.fixingSubgroup : Set (Ω ≃ₐ[k] Ω)),
      IntermediateField.fixingSubgroup_isOpen E, ?_⟩
    ext x
    exact ⟨fun hx => ⟨x.2, hx⟩, fun hx => hx.2⟩
  have hSopen' : IsOpen (S : Set ↥C) := Subgroup.isOpen_mono hUS hSopen
  have hSclosed : IsClosed (S : Set ↥C) := Subgroup.isClosed_of_isOpen S hSopen'
  have hσS : (⟨σ, hσC⟩ : ↥C) ∈ S := by
    intro j hj
    simp only [Ψ, haσ]
    rw [hm j hj]
    abel
  have hle : Subgroup.zpowers (⟨σ, hσC⟩ : ↥C) ≤ S := Subgroup.zpowers_le.mpr hσS
  have hcl : Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C)) ≤ S :=
    Subgroup.topologicalClosure_minimal _ hle hSclosed
  have hmap : (Subgroup.topologicalClosure (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C))).map
      (Subgroup.subtype C) = C := by
    exact Work.SSGRoute.map_topologicalClosure_zpowers_subtype C
      (Subgroup.isClosed_topologicalClosure _) σ hσC
  have hStop : S = ⊤ := by
    rw [eq_top_iff]
    intro x _
    have hx : (x : Ω ≃ₐ[k] Ω) ∈ (Subgroup.topologicalClosure
        (Subgroup.zpowers (⟨σ, hσC⟩ : ↥C))).map (Subgroup.subtype C) := by
      rw [hmap]
      exact x.2
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    have hyeq : y = x := Subtype.ext hyx
    exact hcl (by rw [← hyeq]; exact hy)
  intro γ hγ j hj
  have hmem : (⟨γ, hγ⟩ : ↥C) ∈ S := by rw [hStop]; exact Subgroup.mem_top _
  have h := hmem j hj
  simp only [Ψ] at h
  exact sub_eq_zero.mp h

/-- **Extension of a `1`-cocycle on `I` to `D = decomp k A`.**  Given a locally constant
`1`-cocycle `b` on `I` whose class is fixed by conjugation by `σ` (witnessed by `m`), and a
locally constant `1`-cocycle `a` on `C = closure (zpowers σ)` with `a σ = m`, the formula
`f (i * γ) = b i + res i • a γ` defines a locally constant `1`-cocycle `f` on `D` restricting to
`b` on `I`. -/
theorem exists_extension_cocycle_of_c
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (b : (Ω ≃ₐ[k] Ω) → M) (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) I b)
    (hblc : SSGRoute.IsLocConstOn I b)
    (a : (Ω ≃ₐ[k] Ω) → M)
    (hacoc : SSGRoute.IsCocycleOn (SSGRoute.res k K)
      (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (halc : SSGRoute.IsLocConstOn (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (m : M) (haσ : a σ = m)
    (hm : ∀ j ∈ I, SSGRoute.res k K σ • b (σ⁻¹ * j * σ) - b j = SSGRoute.res k K j • m - m) :
    ∃ f : (Ω ≃ₐ[k] Ω) → M,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) f ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) f ∧
      (∀ i ∈ I, f i = b i) ∧
      ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), f γ = a γ := by
  classical
  set C : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.topologicalClosure (Subgroup.zpowers σ) with hCdef
  have hCD : C ≤ SSGRoute.decomp k A := HS.CC_le_DD A σ hσ
  have hPsi := Psi_eq_zero p k Ω K A I σ hI hIclosed hnorm hσ hsup hinf M b hb hblc a hacoc halc
    m haσ hm
  let ipf : ↥(SSGRoute.decomp k A) → ↥I := fun d => HS.ip A I σ hI hnorm hCD hsup d
  let prj : ↥(SSGRoute.decomp k A) → ↥C := fun d => HS.proj A I σ hI hnorm hCD hsup d
  have hipf : ∀ d, ((ipf d : ↥I) : Ω ≃ₐ[k] Ω) * ((prj d : ↥C) : Ω ≃ₐ[k] Ω)
      = (d : Ω ≃ₐ[k] Ω) := fun d => HS.ip_mul_proj A I σ hI hnorm hCD hsup d
  have hprjm : ∀ d₁ d₂, ((prj (d₁ * d₂) : ↥C) : Ω ≃ₐ[k] Ω)
      = ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω) := by
    intro d₁ d₂
    exact congrArg (fun x : ↥C => (x : Ω ≃ₐ[k] Ω))
      (HS.proj_mul A I σ hI hnorm hCD hsup hinf d₁ d₂)
  have hipm : ∀ d₁ d₂, ((ipf (d₁ * d₂) : ↥I) : Ω ≃ₐ[k] Ω)
      = ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
          * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹) := by
    intro d₁ d₂
    have hmem : ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹ ∈ I :=
      hnorm _ (hCD (prj d₁).2) _ (ipf d₂).2
    have hprod : (((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
          * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹))
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))
        = (d₁ : Ω ≃ₐ[k] Ω) * (d₂ : Ω ≃ₐ[k] Ω) := by
      rw [show (d₁ : Ω ≃ₐ[k] Ω) * (d₂ : Ω ≃ₐ[k] Ω)
          = (((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω) * ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))
            * (((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω) * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))
          from by rw [hipf d₁, hipf d₂]]
      group
    obtain ⟨hi, -⟩ := HS.factor_unique A I σ hinf (ipf (d₁ * d₂)).2
      (I.mul_mem (ipf d₁).2 hmem) (prj (d₁ * d₂)).2 (C.mul_mem (prj d₁).2 (prj d₂).2)
      (by rw [hipf (d₁ * d₂), hprod]; rfl)
    simpa using hi
  let g : ↥(SSGRoute.decomp k A) → M := fun d =>
    b ((ipf d : ↥I) : Ω ≃ₐ[k] Ω) + SSGRoute.res k K ((ipf d : ↥I) : Ω ≃ₐ[k] Ω)
      • a ((prj d : ↥C) : Ω ≃ₐ[k] Ω)
  -- the cocycle condition
  have hg_mul : ∀ d₁ d₂ : ↥(SSGRoute.decomp k A), g (d₁ * d₂)
      = g d₁ + SSGRoute.res k K (d₁ : Ω ≃ₐ[k] Ω) • g d₂ := by
    intro d₁ d₂
    have hxI : ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹ ∈ I :=
      hnorm _ (hCD (prj d₁).2) _ (ipf d₂).2
    have hX : b (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
          * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω) * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
        + SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹) • a ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
        = a ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
            • b ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω) := by
      set γ₁ : Ω ≃ₐ[k] Ω := ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) with hγ₁
      set i₂ : Ω ≃ₐ[k] Ω := ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω) with hi₂
      set x : Ω ≃ₐ[k] Ω := γ₁ * i₂ * γ₁⁻¹ with hx
      have hγ₁C : γ₁ ∈ C := by rw [hγ₁]; exact (prj d₁).2
      have hxIm : x ∈ I := by rw [hx, hγ₁, hi₂]; exact hxI
      have h := hPsi γ₁ hγ₁C x hxIm
      rw [show γ₁⁻¹ * x * γ₁ = i₂ from by rw [hx]; group] at h
      have h1 : SSGRoute.res k K γ₁ • b i₂ - b x
          - (SSGRoute.res k K x • a γ₁ - a γ₁) = 0 := sub_eq_zero.mpr h
      have h2 : a γ₁ + SSGRoute.res k K γ₁ • b i₂
          - (b x + SSGRoute.res k K x • a γ₁) = 0 := by
        rw [show a γ₁ + SSGRoute.res k K γ₁ • b i₂
              - (b x + SSGRoute.res k K x • a γ₁)
            = SSGRoute.res k K γ₁ • b i₂ - b x
              - (SSGRoute.res k K x • a γ₁ - a γ₁) from by abel, h1]
      exact (sub_eq_zero.mp h2).symm
    have hcoc_a := hacoc ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) (prj d₁).2
      ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω) (prj d₂).2
    have hxγ : SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
          • (SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) • a ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))
        = SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
          • (SSGRoute.res k K ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            • a ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω)) := by
      rw [← mul_smul, ← mul_smul]
      congr 1
      rw [← map_mul, ← map_mul]
      congr 1
      group
    have hinner : b (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
          * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
        + SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹) • a (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
              * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))
        = a ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
            • (b ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
              + SSGRoute.res k K ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                • a ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω)) := by
      rw [hcoc_a, smul_add, hxγ, ← add_assoc, hX, smul_add]
      abel
    dsimp only [g]
    rw [hipm d₁ d₂, hprjm d₁ d₂, ← hipf d₁]
    rw [show SSGRoute.res k K (((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹))
        = SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          * SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
            * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹) from map_mul _ _ _]
    rw [show SSGRoute.res k K (((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω) * ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))
        = SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          * SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) from map_mul _ _ _]
    rw [hb ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω) (ipf d₁).2
      (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
        * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹) hxI]
    calc b ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
            • b (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
              * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
          + (SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
              * SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹))
            • a (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))
        = b ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
            • (b (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
              + SSGRoute.res k K (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                * (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))⁻¹)
                • a (((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω) * ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))) := by
          rw [mul_smul, add_assoc, ← smul_add]
      _ = b ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
            • (a ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
              + SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
                • (b ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                  + SSGRoute.res k K ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                    • a ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω))) := by rw [hinner]
      _ = b ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
          + SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
            • a ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω)
          + (SSGRoute.res k K ((ipf d₁ : ↥I) : Ω ≃ₐ[k] Ω)
              * SSGRoute.res k K ((prj d₁ : ↥C) : Ω ≃ₐ[k] Ω))
            • (b ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
              + SSGRoute.res k K ((ipf d₂ : ↥I) : Ω ≃ₐ[k] Ω)
                • a ((prj d₂ : ↥C) : Ω ≃ₐ[k] Ω)) := by
          rw [mul_smul, add_assoc, ← smul_add]
  -- an open subgroup of `↥D` on which `g` vanishes
  have hcont_ip : Continuous (fun d : ↥(SSGRoute.decomp k A) => ((ipf d : ↥I) : Ω ≃ₐ[k] Ω)) :=
    (continuous_ip_proj (A := A) (I := I) (σ := σ) (hI := hI) (hIclosed := hIclosed)
      (hnorm := hnorm) (hσ := hσ) (hsup := hsup) (hinf := hinf)).2
  have hcont_prj : Continuous (fun d : ↥(SSGRoute.decomp k A) => ((prj d : ↥C) : Ω ≃ₐ[k] Ω)) :=
    (continuous_ip_proj (A := A) (I := I) (σ := σ) (hI := hI) (hIclosed := hIclosed)
      (hnorm := hnorm) (hσ := hσ) (hsup := hsup) (hinf := hinf)).1
  obtain ⟨Ub, hUbo, hUb⟩ := hblc
  obtain ⟨Ua, hUao, hUa⟩ := halc
  have hgU : ∀ u : ↥(SSGRoute.decomp k A),
      ((ipf u : ↥I) : Ω ≃ₐ[k] Ω) ∈ Ub → ((prj u : ↥C) : Ω ≃ₐ[k] Ω) ∈ Ua → g u = 0 := by
    intro u hu1 hu2
    have hb0 : b ((ipf u : ↥I) : Ω ≃ₐ[k] Ω) = 0 := by
      have h := hUb 1 (I.one_mem) ((ipf u : ↥I) : Ω ≃ₐ[k] Ω) hu1 (ipf u).2
      rw [one_mul] at h
      have h1 : b 1 = 0 := by
        have hb1 := hb 1 I.one_mem 1 I.one_mem
        simp only [mul_one, map_one, one_smul] at hb1
        have h'' : b 1 + 0 = b 1 + b 1 := by rw [add_zero]; exact hb1
        exact (add_left_cancel h'').symm
      rw [h1] at h
      exact h
    have ha0 : a ((prj u : ↥C) : Ω ≃ₐ[k] Ω) = 0 := by
      have h := hUa 1 (Subgroup.one_mem C) ((prj u : ↥C) : Ω ≃ₐ[k] Ω) hu2 (prj u).2
      rw [one_mul] at h
      have h1 : a 1 = 0 := by
        have ha1 := hacoc 1 (Subgroup.one_mem C) 1 (Subgroup.one_mem C)
        simp only [mul_one, map_one, one_smul] at ha1
        have h'' : a 1 + 0 = a 1 + a 1 := by rw [add_zero]; exact ha1
        exact (add_left_cancel h'').symm
      rw [h1] at h
      exact h
    dsimp only [g]
    rw [hb0, ha0, smul_zero, add_zero]
  have hb1zero : b 1 = 0 := by
    have hb1' := hb 1 I.one_mem 1 I.one_mem
    simp only [mul_one, map_one, one_smul] at hb1'
    have h'' : b 1 + 0 = b 1 + b 1 := by rw [add_zero]; exact hb1'
    exact (add_left_cancel h'').symm
  have ha1zero : a 1 = 0 := by
    have ha1' := hacoc 1 (Subgroup.one_mem C) 1 (Subgroup.one_mem C)
    simp only [mul_one, map_one, one_smul] at ha1'
    have h'' : a 1 + 0 = a 1 + a 1 := by rw [add_zero]; exact ha1'
    exact (add_left_cancel h'').symm
  let f : (Ω ≃ₐ[k] Ω) → M := fun x =>
    if hx : x ∈ SSGRoute.decomp k A then g ⟨x, hx⟩ else 0
  -- the cocycle and local constancy
  refine ⟨f, ?_, ?_, ?_, ?_⟩
  · intro x hx y hy
    show f (x * y) = f x + SSGRoute.res k K x • f y
    have e1 : f (x * y) = g ⟨x * y, (SSGRoute.decomp k A).mul_mem hx hy⟩ := by
      dsimp only [f]; rw [dif_pos ((SSGRoute.decomp k A).mul_mem hx hy)]
    have e2 : f x = g ⟨x, hx⟩ := by dsimp only [f]; rw [dif_pos hx]
    have e3 : f y = g ⟨y, hy⟩ := by dsimp only [f]; rw [dif_pos hy]
    rw [e1, e2, e3]
    have hmul : (⟨x * y, (SSGRoute.decomp k A).mul_mem hx hy⟩ : ↥(SSGRoute.decomp k A))
        = ⟨x, hx⟩ * ⟨y, hy⟩ := Subtype.ext rfl
    rw [hmul, hg_mul ⟨x, hx⟩ ⟨y, hy⟩]
  · have hSopen : IsOpen {d : ↥(SSGRoute.decomp k A) |
        ((ipf d : ↥I) : Ω ≃ₐ[k] Ω) ∈ Ub ∧ ((prj d : ↥C) : Ω ≃ₐ[k] Ω) ∈ Ua} :=
      (hUbo.preimage hcont_ip).inter (hUao.preimage hcont_prj)
    have h1ip : ipf (1 : ↥(SSGRoute.decomp k A)) = 1 := by
      apply Subtype.ext
      exact (HS.factor_unique A I σ hinf (I.one_mem) (ipf 1).2 (C.one_mem) (prj 1).2
        (by rw [hipf 1]; rfl)).1.symm
    have h1prj : prj (1 : ↥(SSGRoute.decomp k A)) = 1 := by
      apply Subtype.ext
      exact (HS.factor_unique A I σ hinf (I.one_mem) (ipf 1).2 (C.one_mem) (prj 1).2
        (by rw [hipf 1]; rfl)).2.symm
    have hS1 : (1 : ↥(SSGRoute.decomp k A)) ∈ {d : ↥(SSGRoute.decomp k A) |
        ((ipf d : ↥I) : Ω ≃ₐ[k] Ω) ∈ Ub ∧ ((prj d : ↥C) : Ω ≃ₐ[k] Ω) ∈ Ua} := by
      refine ⟨?_, ?_⟩
      · rw [h1ip]; exact Ub.one_mem
      · rw [h1prj]; exact Ua.one_mem
    obtain ⟨O, hOo, hOeq⟩ := isOpen_induced_iff.mp hSopen
    have h1O : (1 : Ω ≃ₐ[k] Ω) ∈ O := by
      have h : (1 : ↥(SSGRoute.decomp k A)) ∈ Subtype.val ⁻¹' O := by
        rw [hOeq]; exact hS1
      exact h
    obtain ⟨F, hFfin, hFnorm, hFsub⟩ :=
      (krullTopology_mem_nhds_one_iff_of_normal k Ω O).mp (hOo.mem_nhds h1O)
    haveI : FiniteDimensional k F := hFfin
    haveI : Normal k F := hFnorm
    have hFmem : ∀ u : Ω ≃ₐ[k] Ω, u ∈ F.fixingSubgroup → u ∈ O := fun u hu => hFsub hu
    obtain ⟨V, hVo, hVsub⟩ := Work.SSGRoute.exists_openSubgroup_comap_le
      (SSGRoute.decomp k A)
      (Subgroup.comap (Subgroup.subtype (SSGRoute.decomp k A)) (F.fixingSubgroup :
        Subgroup (Ω ≃ₐ[k] Ω)))
      (by
        rw [Subgroup.coe_comap]
        exact (IntermediateField.fixingSubgroup_isOpen F).preimage continuous_subtype_val)
    refine ⟨V, hVo, ?_⟩
    intro x hx u hu huD
    have huN : (⟨u, huD⟩ : ↥(SSGRoute.decomp k A)) ∈
        Subgroup.comap (Subgroup.subtype (SSGRoute.decomp k A))
          (F.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)) := by
      rw [Subgroup.mem_comap]
      exact hVsub hu
    rw [Subgroup.mem_comap] at huN
    have huO : u ∈ O := hFmem u huN
    have huS : (⟨u, huD⟩ : ↥(SSGRoute.decomp k A)) ∈ {d : ↥(SSGRoute.decomp k A) |
        ((ipf d : ↥I) : Ω ≃ₐ[k] Ω) ∈ Ub ∧ ((prj d : ↥C) : Ω ≃ₐ[k] Ω) ∈ Ua} := by
      rw [← hOeq]
      exact huO
    have hzu : g ⟨u, huD⟩ = 0 := hgU ⟨u, huD⟩ huS.1 huS.2
    have e1 : f (x * u) = g ⟨x * u, (SSGRoute.decomp k A).mul_mem hx huD⟩ := by
      dsimp only [f]; rw [dif_pos ((SSGRoute.decomp k A).mul_mem hx huD)]
    have e2 : f x = g ⟨x, hx⟩ := by dsimp only [f]; rw [dif_pos hx]
    have hmul : (⟨x * u, (SSGRoute.decomp k A).mul_mem hx huD⟩ : ↥(SSGRoute.decomp k A))
        = ⟨x, hx⟩ * ⟨u, huD⟩ := Subtype.ext rfl
    rw [e1, e2, hmul, hg_mul ⟨x, hx⟩ ⟨u, huD⟩, hzu, smul_zero, add_zero]
  · intro i hi
    have e1 : f i = g ⟨i, hI hi⟩ := by dsimp only [f]; rw [dif_pos (hI hi)]
    rw [e1]
    have hi1 : ipf ⟨i, hI hi⟩ = ⟨i, hi⟩ := by
      apply Subtype.ext
      exact (HS.factor_unique A I σ hinf hi (ipf ⟨i, hI hi⟩).2 (C.one_mem)
        (prj ⟨i, hI hi⟩).2 (by rw [hipf ⟨i, hI hi⟩]; exact (mul_one i).symm ▸ rfl)).1.symm
    have hi2 : prj ⟨i, hI hi⟩ = 1 := by
      apply Subtype.ext
      exact (HS.factor_unique A I σ hinf hi (ipf ⟨i, hI hi⟩).2 (C.one_mem)
        (prj ⟨i, hI hi⟩).2 (by rw [hipf ⟨i, hI hi⟩]; exact (mul_one i).symm ▸ rfl)).2.symm
    dsimp only [g]
    rw [hi1, hi2]
    show b i + SSGRoute.res k K i • a 1 = b i
    have ha1 : a 1 = 0 := by
      have h := hacoc 1 (Subgroup.one_mem C) 1 (Subgroup.one_mem C)
      simp only [mul_one, map_one, one_smul] at h
      have h' : a 1 + 0 = a 1 + a 1 := by rw [add_zero]; exact h
      exact (add_left_cancel h').symm
    rw [ha1, smul_zero, add_zero]
  · intro γ hγ
    have hγD : γ ∈ SSGRoute.decomp k A := hCD hγ
    have e1 : f γ = g ⟨γ, hγD⟩ := by dsimp only [f]; rw [dif_pos hγD]
    rw [e1]
    obtain ⟨hfac1, hfac2⟩ := HS.factor_unique A I σ hinf (I.one_mem) (ipf ⟨γ, hγD⟩).2 hγ
      (prj ⟨γ, hγD⟩).2 (by rw [one_mul]; exact (hipf ⟨γ, hγD⟩).symm)
    have hγ1 : ipf ⟨γ, hγD⟩ = 1 := Subtype.ext hfac1.symm
    have hγ2 : prj ⟨γ, hγD⟩ = ⟨γ, hγ⟩ := Subtype.ext hfac2.symm
    dsimp only [g]
    rw [hγ1, hγ2]
    show b 1 + SSGRoute.res k K 1 • a γ = a γ
    rw [hb1zero, map_one, one_smul, zero_add]

/-- **The extension theorem**, with the cocycle `a` on `C = closure (zpowers σ)` produced by
`exists_lcCocycleOn_zpowers_gen_eq`. -/
theorem exists_extension_cocycle
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (b : (Ω ≃ₐ[k] Ω) → M) (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) I b)
    (hblc : SSGRoute.IsLocConstOn I b)
    (m : M)
    (hm : ∀ j ∈ I, SSGRoute.res k K σ • b (σ⁻¹ * j * σ) - b j = SSGRoute.res k K j • m - m) :
    ∃ f : (Ω ≃ₐ[k] Ω) → M,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) f ∧
      SSGRoute.IsLocConstOn (SSGRoute.decomp k A) f ∧
      ∀ i ∈ I, f i = b i := by
  obtain ⟨a, hacoc, halc, haσ, -⟩ :=
    exists_lcCocycleOn_zpowers_gen_eq (p := p) (k := k) (Ω := Ω) (K := K) (σ := σ) (hZ := hZ) (M := M)
      (W := (⊤ : Submodule (ZMod p) M))
      (hW := fun γ _ w _ => Submodule.mem_top) (v := m) (hv := Submodule.mem_top)
  obtain ⟨f, hf1, hf2, hf3, -⟩ := exists_extension_cocycle_of_c p k Ω K A I σ hI hIclosed hnorm
    hσ hsup hinf M b hb hblc a hacoc halc m haσ hm
  exact ⟨f, hf1, hf2, hf3⟩


/-- **Surjectivity of `res1` onto the `σ`-invariants of `H¹(I,M)`.** -/
theorem res1_range_eq_ker_conj1
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (hnorm1 : ∀ n ∈ I, σ * n * σ⁻¹ ∈ I) (hnorm2 : ∀ n ∈ I, σ⁻¹ * n * σ ∈ I) :
    (res1 p k Ω K M I A hI).range
      = LinearMap.ker (conj1 p k Ω K M I σ hnorm1 hnorm2 - LinearMap.id) := by
  refine le_antisymm ?_ ?_
  · intro y hy
    obtain ⟨x, rfl⟩ := hy
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero]
    obtain ⟨f, hf, rfl⟩ := toClass_surjective p k Ω K M (SSGRoute.decomp k A) x
    have hfI : f ∈ lcCocycles p k Ω K M I := (restrictCocycle1 p k Ω K M I A hI ⟨f, hf⟩).2
    rw [res1_toClass p k Ω K M I A hI f hf, conj1_spec p k Ω K M I σ hnorm1 hnorm2 f hfI]
    exact HS.toClass_conj_eq p k Ω K A I σ M hI hnorm hσ hf
  · intro y hy
    rw [LinearMap.mem_ker, LinearMap.sub_apply, LinearMap.id_apply, sub_eq_zero] at hy
    obtain ⟨g, hg, hgy⟩ := toClass_surjective p k Ω K M I y
    set tw : (Ω ≃ₐ[k] Ω) → M := fun n => SSGRoute.res k K σ • g (σ⁻¹ * n * σ) with htw
    have htwc : tw ∈ lcCocycles p k Ω K M I := by
      rw [htw]
      exact h1locConjShift_mem_lcCocycles p k Ω K M I σ hnorm2 hg
    have hspec : conj1 p k Ω K M I σ hnorm1 hnorm2 (toClass p k Ω K M I g)
        = toClass p k Ω K M I tw := by
      rw [conj1_spec p k Ω K M I σ hnorm1 hnorm2 g hg]
    rw [← hgy, hspec] at hy
    -- `hy : toClass tw = toClass g`, hence `tw - g` is a coboundary
    have hmem : tw - g ∈ coboundaries p k Ω K M I := by
      have hq : ((⟨tw, htwc⟩ : ↥(lcCocycles p k Ω K M I)) - ⟨g, hg⟩) ∈
          Submodule.comap (lcCocycles p k Ω K M I).subtype (coboundaries p k Ω K M I) := by
        rw [← Submodule.Quotient.eq]
        rw [toClass, dif_pos htwc, toClass, dif_pos hg] at hy
        exact hy
      rw [Submodule.mem_comap] at hq
      simpa using hq
    obtain ⟨m, hm⟩ := hmem
    have hmg : ∀ j ∈ I, SSGRoute.res k K σ • g (σ⁻¹ * j * σ) - g j
        = SSGRoute.res k K j • m - m := by
      intro j hj
      have h := hm j hj
      rw [Pi.sub_apply, htw] at h
      exact h
    obtain ⟨f, hf, hflc, hfI⟩ := exists_extension_cocycle p k Ω K A I σ hI hIclosed hnorm hσ
      hsup hinf hZ M g hg.1 hg.2 m hmg
    have hfZ : f ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) := ⟨hf, hflc⟩
    have hfI' : f ∈ lcCocycles p k Ω K M I := (restrictCocycle1 p k Ω K M I A hI ⟨f, hfZ⟩).2
    have hzero : f - g ∈ coboundaries p k Ω K M I := ⟨0, fun j hj => by
      have h := hfI j hj
      rw [Pi.sub_apply, h, sub_self]
      simp⟩
    refine ⟨toClass p k Ω K M (SSGRoute.decomp k A) f, ?_⟩
    rw [res1_toClass p k Ω K M I A hI f hfZ]
    have heq : toClass p k Ω K M I f = toClass p k Ω K M I g := by
      have hgf : g - f ∈ coboundaries p k Ω K M I := by
        have h : g - f = -(f - g) := by abel
        rw [h]; exact neg_mem hzero
      have hgfc : g - f ∈ lcCocycles p k Ω K M I := sub_mem hg hfI'
      have h0 : toClass p k Ω K M I (g - f) = 0 := (toClass_eq_zero_iff p k Ω K M I hgfc).mpr hgf
      have hsplit : (g : (Ω ≃ₐ[k] Ω) → M) = f + (g - f) := by ext x; simp
      rw [hsplit, toClass_add p k Ω K M I hfI' hgfc, h0, add_zero]
    rw [heq, hgy]

/-- **Uniqueness of a locally constant `1`-cocycle on `D = decomp k A` with prescribed values on
`I` and at `σ`.**  The difference vanishes on the closed subgroup `C = closure (zpowers σ)` (its
vanishing set is an open subgroup of `↥C` containing `σ`, hence all of `↥C`), and therefore on
`D = I · C` by the cocycle identity. -/
lemma eqOn_decomp_of_eq_on_I_of_eq_gen
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (f f' : (Ω ≃ₐ[k] Ω) → M)
    (hf : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) f)
    (hflc : SSGRoute.IsLocConstOn (SSGRoute.decomp k A) f)
    (hf' : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) f')
    (hf'lc : SSGRoute.IsLocConstOn (SSGRoute.decomp k A) f')
    (hIeq : ∀ i ∈ I, f i = f' i) (hgen : f σ = f' σ) :
    ∀ d ∈ SSGRoute.decomp k A, f d = f' d := by
  classical
  have hCD : Subgroup.topologicalClosure (Subgroup.zpowers σ) ≤ SSGRoute.decomp k A :=
    HS.CC_le_DD A σ hσ
  have hmem : (f - f') ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
    Submodule.sub_mem _ ⟨hf, hflc⟩ ⟨hf', hf'lc⟩
  have hzero : ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), (f - f') γ = 0 := by
    refine lcCocycleOn_zpowers_eq_zero_of_gen_eq_zero p k Ω K M σ (f - f') ?_ ?_ ?_
    · intro x hx y hy
      have h1 := hf x (hCD hx) y (hCD hy)
      have h2 := hf' x (hCD hx) y (hCD hy)
      simp only [Pi.sub_apply, h1, h2, smul_sub]
      abel
    · obtain ⟨U, hUo, hU⟩ := hflc
      obtain ⟨U', hU'o, hU'⟩ := hf'lc
      refine ⟨U ⊓ U', ?_, fun g hg u hu huC => ?_⟩
      · rw [Subgroup.coe_inf]; exact hUo.inter hU'o
      · have h1 : u ∈ U := (Subgroup.mem_inf.mp hu).1
        have h2 : u ∈ U' := (Subgroup.mem_inf.mp hu).2
        simp only [Pi.sub_apply, hU g (hCD hg) u h1 (hCD huC), hU' g (hCD hg) u h2 (hCD huC)]
    · simp only [Pi.sub_apply, hgen, sub_self]
  intro d hd
  have hid : ((HS.ip A I σ hI hnorm hCD hsup ⟨d, hd⟩ : ↥I) : Ω ≃ₐ[k] Ω)
      * ((HS.proj A I σ hI hnorm hCD hsup ⟨d, hd⟩) : Ω ≃ₐ[k] Ω) = d :=
    HS.ip_mul_proj A I σ hI hnorm hCD hsup ⟨d, hd⟩
  have h1 := hmem.1 ((HS.ip A I σ hI hnorm hCD hsup ⟨d, hd⟩ : ↥I) : Ω ≃ₐ[k] Ω)
    (hI (HS.ip A I σ hI hnorm hCD hsup ⟨d, hd⟩).2)
    ((HS.proj A I σ hI hnorm hCD hsup ⟨d, hd⟩) : Ω ≃ₐ[k] Ω)
    (hCD (HS.proj A I σ hI hnorm hCD hsup ⟨d, hd⟩).2)
  have hi0 : (f - f') ((HS.ip A I σ hI hnorm hCD hsup ⟨d, hd⟩ : ↥I) : Ω ≃ₐ[k] Ω) = 0 := by
    simp only [Pi.sub_apply, hIeq _ (HS.ip A I σ hI hnorm hCD hsup ⟨d, hd⟩).2, sub_self]
  have h2 : (f - f') d = 0 := by
    rw [← hid, h1, hi0, hzero _ (HS.proj A I σ hI hnorm hCD hsup ⟨d, hd⟩).2, smul_zero,
      add_zero]
  exact sub_eq_zero.mp h2

/-- Two locally constant `1`-cocycles on `C = closure (zpowers σ)` with the same value at `σ`
agree on `C`. -/
lemma eqOn_closure_of_eq_gen
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M]
    (σ : Ω ≃ₐ[k] Ω) (a a' : (Ω ≃ₐ[k] Ω) → M)
    (hacoc : SSGRoute.IsCocycleOn (SSGRoute.res k K)
      (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (halc : SSGRoute.IsLocConstOn (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a)
    (ha'coc : SSGRoute.IsCocycleOn (SSGRoute.res k K)
      (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a')
    (ha'lc : SSGRoute.IsLocConstOn (Subgroup.topologicalClosure (Subgroup.zpowers σ)) a')
    (h0 : a σ = a' σ) :
    ∀ γ ∈ Subgroup.topologicalClosure (Subgroup.zpowers σ), a γ = a' γ := by
  have h := lcCocycleOn_zpowers_eq_zero_of_gen_eq_zero p k Ω K M σ (a - a')
    (fun x hx y hy => by
      have h1 := hacoc x hx y hy
      have h2 := ha'coc x hx y hy
      simp only [Pi.sub_apply, h1, h2, smul_sub]
      abel)
    (by
      obtain ⟨U, hUo, hU⟩ := halc
      obtain ⟨U', hU'o, hU'⟩ := ha'lc
      refine ⟨U ⊓ U', ?_, fun g hg u hu huC => ?_⟩
      · rw [Subgroup.coe_inf]; exact hUo.inter hU'o
      · have h1 : u ∈ U := (Subgroup.mem_inf.mp hu).1
        have h2 : u ∈ U' := (Subgroup.mem_inf.mp hu).2
        simp only [Pi.sub_apply, hU g hg u h1 huC, hU' g hg u h2 huC])
    (by simp only [Pi.sub_apply, h0, sub_self])
  intro γ hγ
  have hh := h γ hγ
  simpa only [Pi.sub_apply, sub_eq_zero] using hh

/-- **`dim ker res1 = dim ker (conj₀ - 1)`.**  The inflation `M^I → ker res1`,
`μ ↦ [f_μ]` (where `f_μ` is the locally constant `1`-cocycle on `D` vanishing on `I` with
`f_μ σ = μ`), has kernel `(σ - 1)M^I = range (conj₀ - 1)` and is surjective: a class killed by
`res1` is represented by a cocycle `f` with `f|_I = 0`, and then `f|_C` is a locally constant
`1`-cocycle on `C` with values in `M^I`, hence `f = f_{f σ}`. -/
theorem ker_res1_finrank_eq_ker_conj0_loc
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M] [DistribMulAction (K ≃ₐ[k] K) M]
      [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (hnorm2 : ∀ n ∈ I, σ⁻¹ * n * σ ∈ I) :
    Module.Finite (ZMod p) ↥(LinearMap.ker (res1 p k Ω K M I A hI)) ∧
      Module.finrank (ZMod p) ↥(LinearMap.ker (res1 p k Ω K M I A hI)) =
        Module.finrank (ZMod p)
          ↥(LinearMap.ker (conj0 p k Ω K M I σ hnorm2 - LinearMap.id)) := by
  classical
  set C : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.topologicalClosure (Subgroup.zpowers σ) with hCdef
  have hCD : C ≤ SSGRoute.decomp k A := HS.CC_le_DD A σ hσ
  have hσC : σ ∈ C := Subgroup.le_topologicalClosure _ (Subgroup.mem_zpowers σ)
  set N : Submodule (ZMod p) M := H0loc p k Ω K M I with hNdef
  haveI hMfin : Module.Finite (ZMod p) M := Module.Finite.of_finite
  haveI hMfinD : FiniteDimensional (ZMod p) M := hMfin
  haveI hNfin : FiniteDimensional (ZMod p) ↥N := FiniteDimensional.finiteDimensional_submodule N
  set T : ↥N →ₗ[ZMod p] ↥N := conj0 p k Ω K M I σ hnorm2 - LinearMap.id with hTdef
  -- Step 1: the kernel of `T` is `N ⧸ range T`
  have hstep1 : Module.finrank (ZMod p) ↥(LinearMap.ker T) =
      Module.finrank (ZMod p) (↥N ⧸ LinearMap.range T) := by
    have h1 := LinearMap.finrank_range_add_finrank_ker T
    have h2 := Submodule.finrank_quotient_add_finrank (LinearMap.range T)
    omega
  have hTcoe : ∀ n : ↥N, (T n : M) = SSGRoute.res k K σ • (n : M) - (n : M) := by
    intro n
    have h1 : T n = conj0 p k Ω K M I σ hnorm2 n - n := by
      rw [hTdef, LinearMap.sub_apply, LinearMap.id_apply]
    rw [h1]
    show ((conj0 p k Ω K M I σ hnorm2 n : ↥N) : M) - ((n : ↥N) : M) =
      SSGRoute.res k K σ • (n : M) - (n : M)
    rw [conj0_coe]
  -- `N` is `C`-stable
  have hNstable : ∀ (γ : Ω ≃ₐ[k] Ω), γ ∈ C → ∀ w : M, w ∈ N → SSGRoute.res k K γ • w ∈ N := by
    intro γ hγ w hw
    have hwI : ∀ g ∈ I, SSGRoute.res k K g • w = w := hw
    intro i hi
    have hconj : γ⁻¹ * i * γ ∈ I := hnorm γ⁻¹ ((SSGRoute.decomp k A).inv_mem (hCD hγ)) i hi
    have hww : SSGRoute.res k K (γ⁻¹ * i * γ) • w = w := hwI _ hconj
    calc SSGRoute.res k K i • (SSGRoute.res k K γ • w)
        = SSGRoute.res k K (i * γ) • w := by rw [map_mul, mul_smul]
      _ = SSGRoute.res k K (γ * (γ⁻¹ * i * γ)) • w := by congr 1; group
      _ = SSGRoute.res k K γ • (SSGRoute.res k K (γ⁻¹ * i * γ) • w) := by rw [map_mul, mul_smul]
      _ = SSGRoute.res k K γ • w := by rw [hww]
  -- the D2 cocycles on `C` with values in `N`
  have hexists_a : ∀ μ : ↥N, ∃ a : (Ω ≃ₐ[k] Ω) → M,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) C a ∧ SSGRoute.IsLocConstOn C a ∧
        a σ = (μ : M) ∧ ∀ γ ∈ C, a γ ∈ N := by
    intro μ
    exact exists_lcCocycleOn_zpowers_gen_eq (p := p) (k := k) (Ω := Ω) (K := K) (M := M)
      (σ := σ) (hZ := hZ) (W := N) (hW := hNstable) (v := (μ : M)) (hv := μ.2)
  let aOf : ↥N → ((Ω ≃ₐ[k] Ω) → M) := fun μ => Classical.choose (hexists_a μ)
  have aOf_spec (μ : ↥N) : SSGRoute.IsCocycleOn (SSGRoute.res k K) C (aOf μ) ∧
      SSGRoute.IsLocConstOn C (aOf μ) ∧ aOf μ σ = (μ : M) ∧ ∀ γ ∈ C, aOf μ γ ∈ N :=
    Classical.choose_spec (hexists_a μ)
  -- the extensions to `D`
  have hexists_f : ∀ μ : ↥N, ∃ f : (Ω ≃ₐ[k] Ω) → M,
      SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A) f ∧
        SSGRoute.IsLocConstOn (SSGRoute.decomp k A) f ∧
        (∀ i ∈ I, f i = 0) ∧ ∀ γ ∈ C, f γ = aOf μ γ := by
    intro μ
    refine exists_extension_cocycle_of_c p k Ω K A I σ hI hIclosed hnorm hσ hsup hinf M
      (0 : (Ω ≃ₐ[k] Ω) → M) ?_ ?_ (aOf μ) (aOf_spec μ).1 (aOf_spec μ).2.1 ((μ : M))
      (aOf_spec μ).2.2.1 ?_
    · intro g _ h _; simp
    · exact ⟨⊤, isOpen_univ, fun g _ u _ _ => rfl⟩
    · intro j hj
      have hμ : SSGRoute.res k K j • (μ : M) = (μ : M) := μ.2 j hj
      simp [hμ]
  let fOf : ↥N → ((Ω ≃ₐ[k] Ω) → M) := fun μ => Classical.choose (hexists_f μ)
  have fOf_spec (μ : ↥N) : SSGRoute.IsCocycleOn (SSGRoute.res k K) (SSGRoute.decomp k A)
        (fOf μ) ∧ SSGRoute.IsLocConstOn (SSGRoute.decomp k A) (fOf μ) ∧
        (∀ i ∈ I, fOf μ i = 0) ∧ ∀ γ ∈ C, fOf μ γ = aOf μ γ :=
    Classical.choose_spec (hexists_f μ)
  have fOf_mem (μ : ↥N) : fOf μ ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
    ⟨(fOf_spec μ).1, (fOf_spec μ).2.1⟩
  -- `(fOf μ) σ = μ`
  have fOf_gen (μ : ↥N) : fOf μ σ = (μ : M) := by
    rw [(fOf_spec μ).2.2.2 σ hσC, (aOf_spec μ).2.2.1]
  -- the linear map `Φ`
  have hmem_ker (μ : ↥N) : toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ) ∈
      LinearMap.ker (res1 p k Ω K M I A hI) := by
    rw [LinearMap.mem_ker, res1_toClass p k Ω K M I A hI (fOf μ) (fOf_mem μ)]
    refine (toClass_eq_zero_iff p k Ω K M I
      ((restrictCocycle1 p k Ω K M I A hI ⟨fOf μ, fOf_mem μ⟩).2)).mpr ⟨0, fun i hi => ?_⟩
    simp [(fOf_spec μ).2.2.1 i hi]
  -- the two functions agree on `D` for `μ = ν + ν'`
  have hagree_add (μ ν : ↥N) : ∀ d ∈ SSGRoute.decomp k A,
      fOf (μ + ν) d = (fOf μ + fOf ν) d := by
    refine eqOn_decomp_of_eq_on_I_of_eq_gen p k Ω K A I σ hI hnorm hσ hsup M (fOf (μ + ν))
      (fOf μ + fOf ν) (fOf_spec (μ + ν)).1 (fOf_spec (μ + ν)).2.1
      (Submodule.add_mem _ (fOf_mem μ) (fOf_mem ν)).1
      (Submodule.add_mem _ (fOf_mem μ) (fOf_mem ν)).2 (fun i hi => ?_) ?_
    · rw [(fOf_spec (μ + ν)).2.2.1 i hi]
      simp [(fOf_spec μ).2.2.1 i hi, (fOf_spec ν).2.2.1 i hi]
    · show fOf (μ + ν) σ = fOf μ σ + fOf ν σ
      rw [fOf_gen (μ + ν), fOf_gen μ, fOf_gen ν, Submodule.coe_add]
  have hagree_smul (r : ZMod p) (μ : ↥N) : ∀ d ∈ SSGRoute.decomp k A,
      fOf (r • μ) d = (r • fOf μ) d := by
    refine eqOn_decomp_of_eq_on_I_of_eq_gen p k Ω K A I σ hI hnorm hσ hsup M (fOf (r • μ))
      (r • fOf μ) (fOf_spec (r • μ)).1 (fOf_spec (r • μ)).2.1
      (Submodule.smul_mem _ r (fOf_mem μ)).1 (Submodule.smul_mem _ r (fOf_mem μ)).2
      (fun i hi => ?_) ?_
    · rw [(fOf_spec (r • μ)).2.2.1 i hi]
      simp [(fOf_spec μ).2.2.1 i hi]
    · show fOf (r • μ) σ = r • fOf μ σ
      rw [fOf_gen (r • μ), fOf_gen μ, Submodule.coe_smul]
  -- the `toClass`-level consequence
  have hclass_eq {g g' : (Ω ≃ₐ[k] Ω) → M}
      (hg : g ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A))
      (hg' : g' ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A))
      (hgd : ∀ d ∈ SSGRoute.decomp k A, g d = g' d) :
      toClass p k Ω K M (SSGRoute.decomp k A) g = toClass p k Ω K M (SSGRoute.decomp k A) g' := by
    have hd : g - g' ∈ coboundaries p k Ω K M (SSGRoute.decomp k A) :=
      ⟨0, fun d hdD => by simp [hgd d hdD]⟩
    have h0 : toClass p k Ω K M (SSGRoute.decomp k A) (g - g') = 0 :=
      (toClass_eq_zero_iff p k Ω K M (SSGRoute.decomp k A)
        (Submodule.sub_mem _ hg hg')).mpr hd
    have hsub := PT.toClass_sub p k Ω K M (SSGRoute.decomp k A) hg hg'
    rw [h0] at hsub
    exact sub_eq_zero.mp hsub.symm
  let Φ : ↥N →ₗ[ZMod p] ↥(LinearMap.ker (res1 p k Ω K M I A hI)) :=
    { toFun := fun μ => ⟨toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ), hmem_ker μ⟩
      map_add' := fun μ ν => by
        refine Subtype.ext ?_
        show toClass p k Ω K M (SSGRoute.decomp k A) (fOf (μ + ν)) =
          toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ) +
            toClass p k Ω K M (SSGRoute.decomp k A) (fOf ν)
        rw [← toClass_add p k Ω K M (SSGRoute.decomp k A) (fOf_mem μ) (fOf_mem ν)]
        exact hclass_eq (fOf_mem (μ + ν)) (Submodule.add_mem _ (fOf_mem μ) (fOf_mem ν))
          (hagree_add μ ν)
      map_smul' := fun r μ => by
        refine Subtype.ext ?_
        show toClass p k Ω K M (SSGRoute.decomp k A) (fOf (r • μ)) =
          r • toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ)
        rw [← PT.toClass_smul p k Ω K M (SSGRoute.decomp k A) r (fOf_mem μ)]
        exact hclass_eq (fOf_mem (r • μ)) (Submodule.smul_mem _ r (fOf_mem μ))
          (hagree_smul r μ) }
  -- `Φ` kills `range T`
  have hkill : LinearMap.range T ≤ LinearMap.ker Φ := by
    intro x hx
    obtain ⟨n, rfl⟩ := hx
    rw [LinearMap.mem_ker]
    refine Subtype.ext ?_
    show toClass p k Ω K M (SSGRoute.decomp k A) (fOf (T n)) = 0
    have hdn : (fun g : Ω ≃ₐ[k] Ω => SSGRoute.res k K g • (n : M) - (n : M)) ∈
        coboundaries p k Ω K M (SSGRoute.decomp k A) := ⟨(n : M), fun g _ => rfl⟩
    have hdnc := coboundaries_le_lcCocycles p k Ω K M (SSGRoute.decomp k A) hdn
    have hagree : ∀ d ∈ SSGRoute.decomp k A,
        fOf (T n) d = SSGRoute.res k K d • (n : M) - (n : M) := by
      refine eqOn_decomp_of_eq_on_I_of_eq_gen p k Ω K A I σ hI hnorm hσ hsup M (fOf (T n))
        (fun g => SSGRoute.res k K g • (n : M) - (n : M)) (fOf_spec (T n)).1
        (fOf_spec (T n)).2.1 hdnc.1 hdnc.2 (fun i hi => ?_) ?_
      · rw [(fOf_spec (T n)).2.2.1 i hi]
        have hn : SSGRoute.res k K i • (n : M) = (n : M) := n.2 i hi
        rw [hn, sub_self]
      · show fOf (T n) σ = SSGRoute.res k K σ • (n : M) - (n : M)
        rw [fOf_gen (T n), hTcoe n]
    have hmem : fOf (T n) ∈ coboundaries p k Ω K M (SSGRoute.decomp k A) :=
      ⟨(n : M), fun d hdD => hagree d hdD⟩
    exact (toClass_eq_zero_iff p k Ω K M (SSGRoute.decomp k A) (fOf_mem (T n))).mpr hmem
  let Φq : (↥N ⧸ LinearMap.range T) →ₗ[ZMod p] ↥(LinearMap.ker (res1 p k Ω K M I A hI)) :=
    (LinearMap.range T).liftQ Φ hkill
  have hΦq_apply : ∀ μ : ↥N, Φq (Submodule.mkQ (LinearMap.range T) μ) = Φ μ := by
    intro μ
    rw [show Φq = (LinearMap.range T).liftQ Φ hkill from rfl]
    rfl
  -- injectivity
  have hinj : Function.Injective Φq := by
    intro x y hxy
    obtain ⟨μ, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range T) x
    obtain ⟨ν, rfl⟩ := Submodule.mkQ_surjective (LinearMap.range T) y
    rw [hΦq_apply μ, hΦq_apply ν] at hxy
    have hc : toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ) =
        toClass p k Ω K M (SSGRoute.decomp k A) (fOf ν) := by
      have h := congrArg (fun z : ↥(LinearMap.ker (res1 p k Ω K M I A hI)) =>
        (z : H1loc p k Ω K M (SSGRoute.decomp k A))) hxy
      exact h
    have hmem : fOf μ - fOf ν ∈ coboundaries p k Ω K M (SSGRoute.decomp k A) := by
      have h0 : toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ - fOf ν) = 0 := by
        rw [PT.toClass_sub p k Ω K M (SSGRoute.decomp k A) (fOf_mem μ) (fOf_mem ν), hc, sub_self]
      exact (toClass_eq_zero_iff p k Ω K M (SSGRoute.decomp k A)
        (Submodule.sub_mem _ (fOf_mem μ) (fOf_mem ν))).mp h0
    obtain ⟨m, hm⟩ := hmem
    have hmI : ∀ i ∈ I, SSGRoute.res k K i • m = m := by
      intro i hi
      have h := hm i (hI hi)
      rw [Pi.sub_apply, (fOf_spec μ).2.2.1 i hi, (fOf_spec ν).2.2.1 i hi, sub_zero] at h
      exact sub_eq_zero.mp h.symm
    have hval : (μ : M) - (ν : M) = SSGRoute.res k K σ • m - m := by
      have h := hm σ hσ
      rw [Pi.sub_apply, fOf_gen μ, fOf_gen ν] at h
      exact h
    have hT : T ⟨m, fun i hi => hmI i hi⟩ = μ - ν := by
      refine Subtype.ext ?_
      show (T ⟨m, fun i hi => hmI i hi⟩ : M) = (μ : M) - (ν : M)
      rw [hTcoe, hval]
    exact (Submodule.Quotient.eq (LinearMap.range T)).mpr
      ⟨⟨m, fun i hi => hmI i hi⟩, hT⟩
  -- surjectivity
  have hsurj : Function.Surjective Φq := by
    intro y
    set f : (Ω ≃ₐ[k] Ω) → M := PT.locRepr p k Ω K M (SSGRoute.decomp k A) y.1 with hfdef
    have hfcoc : f ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      PT.mem_locRepr p k Ω K M (SSGRoute.decomp k A) y.1
    have hclass : toClass p k Ω K M (SSGRoute.decomp k A) f = y.1 :=
      PT.toClass_locRepr p k Ω K M (SSGRoute.decomp k A) y.1
    have hcobI : f ∈ coboundaries p k Ω K M I := by
      have h0 : toClass p k Ω K M I f = 0 := by
        rw [← res1_toClass p k Ω K M I A hI f hfcoc, hclass]
        exact y.2
      exact (toClass_eq_zero_iff p k Ω K M I
        ((restrictCocycle1 p k Ω K M I A hI ⟨f, hfcoc⟩).2)).mp h0
    obtain ⟨m, hm⟩ := hcobI
    set d : (Ω ≃ₐ[k] Ω) → M := fun g => SSGRoute.res k K g • m - m with hddef
    have hdcoc : d ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      coboundaries_le_lcCocycles p k Ω K M (SSGRoute.decomp k A) ⟨m, fun g _ => rfl⟩
    have hf'mem : f - d ∈ lcCocycles p k Ω K M (SSGRoute.decomp k A) :=
      Submodule.sub_mem _ hfcoc hdcoc
    have hf'I : ∀ i ∈ I, (f - d) i = 0 := by
      intro i hi
      rw [Pi.sub_apply, hm i hi, hddef]
      simp
    have hf'class : toClass p k Ω K M (SSGRoute.decomp k A) (f - d) = y.1 := by
      have h0 : toClass p k Ω K M (SSGRoute.decomp k A) d = 0 :=
        (toClass_eq_zero_iff p k Ω K M (SSGRoute.decomp k A) hdcoc).mpr ⟨m, fun g _ => rfl⟩
      rw [PT.toClass_sub p k Ω K M (SSGRoute.decomp k A) hfcoc hdcoc, h0, sub_zero, hclass]
    -- `(f - d)|_C` takes values in `N`
    have hvalN : ∀ γ ∈ C, (f - d) γ ∈ N := by
      intro γ hγ
      have hCDm : (f - d) γ ∈ N := by
        intro i hi
        have hconj : γ⁻¹ * i * γ ∈ I := hnorm γ⁻¹ ((SSGRoute.decomp k A).inv_mem (hCD hγ)) i hi
        have h1 : (f - d) (i * γ) = SSGRoute.res k K i • (f - d) γ := by
          have h := hf'mem.1 i (hI hi) γ (hCD hγ)
          rw [h, hf'I i hi, zero_add]
        have h2 : (f - d) (γ * (γ⁻¹ * i * γ)) = (f - d) γ := by
          have h := hf'mem.1 γ (hCD hγ) (γ⁻¹ * i * γ) (hI hconj)
          rw [h, hf'I _ hconj, smul_zero, add_zero]
        have h3 : i * γ = γ * (γ⁻¹ * i * γ) := by group
        rw [h3] at h1
        rw [← h1, h2]
      exact hCDm
    let μ : ↥N := ⟨(f - d) σ, hvalN σ hσC⟩
    have hμgen : aOf μ σ = (μ : M) := (aOf_spec μ).2.2.1
    -- `(f - d)|_C = aOf μ` on `C`
    have hConC : ∀ γ ∈ C, (f - d) γ = aOf μ γ :=
      eqOn_closure_of_eq_gen p k Ω K M σ ((f - d)) (aOf μ)
        (fun x hx y hy => hf'mem.1 x (hCD hx) y (hCD hy))
        (by
          obtain ⟨U, hUo, hU⟩ := hf'mem.2
          exact ⟨U, hUo, fun g hg u hu huC => hU g (hCD hg) u hu (hCD huC)⟩)
        (aOf_spec μ).1 (aOf_spec μ).2.1 (by rw [hμgen])
    -- hence `fOf μ = f - d` on `D`
    have hagree : ∀ e ∈ SSGRoute.decomp k A, fOf μ e = (f - d) e :=
      eqOn_decomp_of_eq_on_I_of_eq_gen p k Ω K A I σ hI hnorm hσ hsup M (fOf μ) (f - d)
        (fOf_spec μ).1 (fOf_spec μ).2.1 hf'mem.1 hf'mem.2
        (fun i hi => by rw [(fOf_spec μ).2.2.1 i hi, hf'I i hi])
        (by
          show fOf μ σ = (f - d) σ
          rw [fOf_gen μ])
    refine ⟨Submodule.mkQ (LinearMap.range T) μ, ?_⟩
    rw [hΦq_apply]
    refine Subtype.ext ?_
    show toClass p k Ω K M (SSGRoute.decomp k A) (fOf μ) = y.1
    rw [hclass_eq (fOf_mem μ) hf'mem hagree, hf'class]
  -- conclude
  refine ⟨?_, ?_⟩
  · haveI : Module.Finite (ZMod p) (↥N ⧸ LinearMap.range T) := inferInstance
    exact Module.Finite.equiv (LinearEquiv.ofBijective Φq ⟨hinj, hsurj⟩)
  · have hmain : Module.finrank (ZMod p) ↥(LinearMap.ker (res1 p k Ω K M I A hI)) =
        Module.finrank (ZMod p) (↥N ⧸ LinearMap.range T) :=
      (LinearEquiv.finrank_eq (LinearEquiv.ofBijective Φq ⟨hinj, hsurj⟩)).symm
    calc Module.finrank (ZMod p) ↥(LinearMap.ker (res1 p k Ω K M I A hI))
        = Module.finrank (ZMod p) (↥N ⧸ LinearMap.range T) := hmain
      _ = Module.finrank (ZMod p) ↥(LinearMap.ker T) := hstep1.symm
      _ = Module.finrank (ZMod p)
            ↥(LinearMap.ker (conj0 p k Ω K M I σ hnorm2 - LinearMap.id)) := rfl

/-- **The degree-`1` row of the Hochschild–Serre two-row decomposition.** -/
theorem finrank_H1loc_decomp
    (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (A : ValuationSubring Ω) (I : Subgroup (Ω ≃ₐ[k] Ω)) (σ : Ω ≃ₐ[k] Ω)
    (hI : I ≤ SSGRoute.decomp k A)
    (hIclosed : IsClosed (I : Set (Ω ≃ₐ[k] Ω)))
    (hnorm : ∀ δ ∈ SSGRoute.decomp k A, ∀ u ∈ I, δ * u * δ⁻¹ ∈ I)
    (hσ : σ ∈ SSGRoute.decomp k A)
    (hsup : SSGRoute.decomp k A ≤ I ⊔ Subgroup.topologicalClosure (Subgroup.zpowers σ))
    (hinf : I ⊓ Subgroup.topologicalClosure (Subgroup.zpowers σ) = ⊥)
    (hZ : ∀ n : ℕ, 0 < n → ∃ f : ↥(Subgroup.topologicalClosure (Subgroup.zpowers σ)) →*
        Multiplicative (ZMod n), Function.Surjective f)
    (hvan : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Subsingleton (Work.SSGRoute.H2loc p k Ω K M I))
    (hfin : ∀ (M : Type) [AddCommGroup M] [Module (ZMod p) M]
        [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M],
        Module.Finite (ZMod p) (Work.SSGRoute.H1loc p k Ω K M I))
    (hnorm1 : ∀ n ∈ I, σ * n * σ⁻¹ ∈ I) (hnorm2 : ∀ n ∈ I, σ⁻¹ * n * σ ∈ I)
    (M : Type) [AddCommGroup M] [Module (ZMod p) M]
      [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M] :
    Module.finrank (ZMod p) (Work.SSGRoute.H1loc p k Ω K M (SSGRoute.decomp k A)) =
      Module.finrank (ZMod p) ↥(LinearMap.ker (conj0 p k Ω K M I σ hnorm2 - LinearMap.id)) +
        Module.finrank (ZMod p) ↥(LinearMap.ker (conj1 p k Ω K M I σ hnorm1 hnorm2 - LinearMap.id)) := by
  obtain ⟨hkerfin, hker⟩ := ker_res1_finrank_eq_ker_conj0_loc p k Ω K A I σ hI hIclosed hnorm hσ
    hsup hinf hZ M hnorm2
  haveI hIfin : Module.Finite (ZMod p) (Work.SSGRoute.H1loc p k Ω K M I) := hfin M
  haveI hIfinD : FiniteDimensional (ZMod p) (Work.SSGRoute.H1loc p k Ω K M I) := hIfin
  haveI hfinD : Module.Finite (ZMod p)
      (Work.SSGRoute.H1loc p k Ω K M (SSGRoute.decomp k A)) := by
    haveI h1 : Module.Finite (ZMod p) ↥(LinearMap.ker (res1 p k Ω K M I A hI)) := hkerfin
    haveI h2 : Module.Finite (ZMod p) ↥(LinearMap.range (res1 p k Ω K M I A hI)) :=
      FiniteDimensional.finiteDimensional_submodule _
    haveI h3 : Module.Finite (ZMod p) (Work.SSGRoute.H1loc p k Ω K M (SSGRoute.decomp k A) ⧸
        LinearMap.ker (res1 p k Ω K M I A hI)) :=
      Module.Finite.equiv (LinearMap.quotKerEquivRange (res1 p k Ω K M I A hI)).symm
    exact Module.Finite.of_submodule_quotient (LinearMap.ker (res1 p k Ω K M I A hI))
  haveI : FiniteDimensional (ZMod p)
      (Work.SSGRoute.H1loc p k Ω K M (SSGRoute.decomp k A)) := hfinD
  have hran := res1_range_eq_ker_conj1 p k Ω K A I σ hI hIclosed hnorm hσ hsup hinf hZ M hnorm1 hnorm2
  rw [← LinearMap.finrank_range_add_finrank_ker (res1 p k Ω K M I A hI), hran, hker]
  omega

end

