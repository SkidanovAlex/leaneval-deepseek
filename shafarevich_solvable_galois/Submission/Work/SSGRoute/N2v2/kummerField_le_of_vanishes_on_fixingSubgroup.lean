namespace Work.SSGRoute.N2v2

open scoped IntermediateField

/-- If the Kummer character of `c ∈ Kˣ` vanishes on the fixing subgroup of `L`, then the Kummer
field `K(c^{1/p})` is contained in `L`.  The chosen `p`-th root `α` of `c` is fixed by every
`L`-automorphism of `Ω` (the character vanishes exactly when `σ` fixes `α`); since `Ω/L` is Galois
(`Ω` is an algebraic closure of the number field `k`, so of characteristic zero) the fixed field of
`L.fixingSubgroup` is `L` itself, whence `α ∈ L` and `K⟮α⟯ ≤ L`. -/
theorem kummerField_le_of_vanishes_on_fixingSubgroup (p : ℕ) [Fact p.Prime] (k Ω : Type)
    [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p) (c : (↥K)ˣ)
    (L : IntermediateField ↥K Ω) [FiniteDimensional ↥K L]
    (h : ∀ σ : Ω ≃ₐ[↥K] Ω, σ ∈ L.fixingSubgroup →
      Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c σ = 0) :
    NK.LocalAnabelian.kummerField (p := p) (K' := Ω) c ≤ L := by
  classical
  -- Every `L`-automorphism of `Ω` fixes the chosen `p`-th root of `c`.
  have hfix : ∀ σ : Ω ≃ₐ[↥K] Ω, σ ∈ L.fixingSubgroup →
      σ (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) =
        Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c := fun σ hσ =>
    (Work.SSGRoute.ZDataMup.LocalUnramified.kummerCharZMod_eq_zero_iff_apply_sqrt
      (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c σ).mp (h σ hσ)
  -- Hence the root lies in `L`, the fixed field of `L.fixingSubgroup`.
  have hαL : Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c ∈ L := by
    have hmem : Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c ∈
        IntermediateField.fixedField L.fixingSubgroup := by
      rw [IntermediateField.mem_fixedField_iff]
      exact fun σ hσ => hfix σ hσ
    rwa [InfiniteGalois.fixedField_fixingSubgroup L] at hmem
  have hα : (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) ^ p = algebraMap ↥K Ω (c : ↥K) :=
    Work.SSGRoute.kummerSqrtZMod_pow (Ω := Ω) p c
  -- The Kummer field is generated by this single root.
  rw [NK.UchidaKummer.Kummer.kummerField_eq_adjoin_simple p Fact.out hζ c hα]
  exact IntermediateField.adjoin_simple_le_iff.mpr hαL

end Work.SSGRoute.N2v2

