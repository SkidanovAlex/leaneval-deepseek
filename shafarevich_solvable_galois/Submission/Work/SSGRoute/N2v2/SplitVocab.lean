/-!
# Vocabulary for the `hsplit` ⟹ Kummer-split reduction

The `hsplit` hypothesis of the escape-form Grünwald orthogonality quantifies over **all** additive
functions `χ : (Ω ≃ₐ[k] Ω) → ZMod p` killing the fixing subgroup of `L₁ ⊔ L₂`, and asserts that they
split as `χ = χ₁ + χ₂` with `χᵢ` killing `Lᵢ.fixingSubgroup`.  The functions `χᵢ` so produced are
*arbitrary* (not necessarily continuous, not necessarily factoring through a finite quotient).

The arithmetic computation, however, needs the two summands to be **Kummer characters of elements
of `Kˣ`** (that is the only way the antisymmetry of the local Kummer pairing and the product formula
can be applied).  The mathematical content of this file's companions is the observation that this
is nevertheless available, because it suffices that the produced `χ₁`, `χ₂` kill the fixing
subgroup of the field `E` whose characters one wants to split: and indeed, if

`E.fixingSubgroup ≤ (L₁.fixingSubgroup ⊓ L₂.fixingSubgroup) * commPow K.fixingSubgroup p`

(a condition that holds in the application: `E` is the maximal abelian exponent-`p` subextension of
`L₁ ⊔ L₂`, whose fixing subgroup is `(L₁.fixingSubgroup ⊓ L₂.fixingSubgroup) * commPow … p`), then
any additive `χᵢ` killing `Lᵢ.fixingSubgroup` kills `E.fixingSubgroup` as well, hence descends to
`Gal(E/K)`, and Kummer surjectivity
(`Work.SSGRoute.ZDataMup.KummerSurjectivity.kummerCharZMod_surjective_levelK`) turns it into the
Kummer character of an element `cᵢ ∈ Kˣ` with Kummer field inside `E ⊓ Lᵢ`.
-/

namespace Work.SSGRoute.N2v2

/-- The subgroup of `G` generated by the `p`-th powers and the commutators: it is contained in the
kernel of every additive `ZMod p`-valued function on `G`. -/
def commPow (G : Type*) [Group G] (p : ℕ) : Subgroup G :=
  Subgroup.closure (Set.range (fun x : G => x ^ p) ∪
    Set.range (fun yz : G × G => yz.1 * yz.2 * yz.1⁻¹ * yz.2⁻¹))

theorem pow_mem_commPow {G : Type*} [Group G] (p : ℕ) (x : G) : x ^ p ∈ commPow G p :=
  Subgroup.subset_closure (Or.inl ⟨x, rfl⟩)

theorem commutator_mem_commPow {G : Type*} [Group G] (p : ℕ) (x y : G) :
    x * y * x⁻¹ * y⁻¹ ∈ commPow G p :=
  Subgroup.subset_closure (Or.inr ⟨(x, y), rfl⟩)

/-- **`commPow` is killed by every additive `ZMod p`-valued function.** -/
theorem commPow_le_ker_of_additive {G : Type*} [Group G] (p : ℕ) (χ : G → ZMod p)
    (hadd : ∀ x y : G, χ (x * y) = χ x + χ y) :
    ∀ x ∈ commPow G p, χ x = 0 := by
  have h1 : χ 1 = 0 := by
    have h := hadd 1 1
    rw [one_mul] at h
    exact add_left_cancel (by rw [add_zero]; exact h.symm)
  have hpow : ∀ (x : G) (n : ℕ), χ (x ^ n) = n * χ x := by
    intro x n
    induction n with
    | zero => simp [h1]
    | succ k ih => rw [pow_succ, hadd, ih, Nat.cast_succ, add_mul, one_mul]
  have hinv : ∀ x : G, χ x⁻¹ = -χ x := by
    intro x
    have h := (hadd x x⁻¹).symm
    rw [mul_inv_cancel, h1] at h
    exact eq_neg_of_add_eq_zero_right h
  have hcomm : ∀ x y : G, χ (x * y * x⁻¹ * y⁻¹) = 0 := by
    intro x y
    rw [hadd, hadd, hadd, hinv, hinv]
    ring
  let K : Subgroup G :=
    { carrier := {x : G | χ x = 0}
      one_mem' := h1
      mul_mem' := by
        intro a b ha hb
        show χ (a * b) = 0
        rw [hadd, ha, hb, add_zero]
      inv_mem' := by
        intro a ha
        show χ a⁻¹ = 0
        rw [hinv, ha, neg_zero] }
  have hle : commPow G p ≤ K := by
    rw [commPow]
    refine (Subgroup.closure_le K).mpr ?_
    rintro x (⟨y, rfl⟩ | ⟨⟨y, z⟩, rfl⟩)
    · show χ (y ^ p) = 0
      rw [hpow]
      have : (p : ZMod p) = 0 := ZMod.natCast_self p
      rw [this, zero_mul]
    · show χ (y * z * y⁻¹ * z⁻¹) = 0
      exact hcomm y z
  exact fun x hx => hle hx

end Work.SSGRoute.N2v2
