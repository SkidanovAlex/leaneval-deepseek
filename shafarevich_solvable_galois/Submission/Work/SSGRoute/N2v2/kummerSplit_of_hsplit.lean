namespace Work.SSGRoute.N2v2

/-- **The Kummer split of a finite-level character, from the `hsplit` hypothesis.**

`hsplit` (the repair hypothesis of the escape-form Grünwald orthogonality) splits an additive
`χ : (Ω ≃ₐ[k] Ω) → ZMod p` killing `(L₁ ⊔ L₂).fixingSubgroup` into additive `χ₁`, `χ₂` killing
`L₁`- resp. `L₂.fixingSubgroup`.  A priori the two summands are arbitrary functions (they need not
be continuous, hence need not be Kummer characters), while the arithmetic computation needs Kummer
characters of elements of `Kˣ`.

The content of this result is that for a finite level `E ⊆ L₁ ⊔ L₂` whose fixing subgroup is
generated by `L₁.fixingSubgroup ⊓ L₂.fixingSubgroup` together with the `p`-th powers and
commutators of `K.fixingSubgroup`, this is automatic: any additive function killing
`Lᵢ.fixingSubgroup` kills `E.fixingSubgroup` as well, so the summands descend to `Gal(E/K)`, are
locally constant, and Kummer surjectivity (`kummerCharZMod_surjective_levelK`) turns them into
Kummer characters `χ_{cᵢ}` with `KummerField cᵢ ≤ E ⊓ baseChange Lᵢ`
(`kummerField_le_of_vanishes_on_fixingSubgroup`). -/
theorem kummerSplit_of_hsplit (p : ℕ) [Fact p.Prime] (k Ω : Type) [Field k] [NumberField k]
    [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω] [IsAlgClosed Ω]
    (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    (ζ : ↥K) (hζ : IsPrimitiveRoot ζ p)
    (L₁ L₂ : IntermediateField k Ω) [FiniteDimensional k L₁] [IsGalois k L₁]
    [FiniteDimensional k L₂] [IsGalois k L₂] (hKL₁ : K ≤ L₁) (hKL₂ : K ≤ L₂)
    (hsplit : ∀ χ : (Ω ≃ₐ[k] Ω) → ZMod p,
      (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ (x * y) = χ x + χ y) →
      (∀ σ ∈ (L₁ ⊔ L₂).fixingSubgroup, χ σ = 0) →
      ∃ χ₁ χ₂ : (Ω ≃ₐ[k] Ω) → ZMod p,
        (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ₁ (x * y) = χ₁ x + χ₁ y) ∧
        (∀ σ ∈ L₁.fixingSubgroup, χ₁ σ = 0) ∧
        (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ₂ (x * y) = χ₂ x + χ₂ y) ∧
        (∀ σ ∈ L₂.fixingSubgroup, χ₂ σ = 0) ∧
        ∀ σ ∈ K.fixingSubgroup, χ σ = χ₁ σ + χ₂ σ)
    (E : IntermediateField k Ω) [FiniteDimensional k E] [IsGalois k E] (hKE : K ≤ E)
    (hEN : (E : Set Ω) ⊆ ((L₁ ⊔ L₂ : IntermediateField k Ω) : Set Ω))
    (hEfix : E.fixingSubgroup ≤ (L₁.fixingSubgroup ⊓ L₂.fixingSubgroup) ⊔
      (commPow ↥(K.fixingSubgroup) p).map K.fixingSubgroup.subtype)
    (c : (↥K)ˣ)
    (hc : NK.LocalAnabelian.kummerField (K' := Ω) p c ≤
      Work.SSGRoute.EscapeCoreLib.baseChange K E hKE) :
    ∃ c₁ c₂ : (↥K)ˣ,
      NK.LocalAnabelian.kummerField (K' := Ω) p c₁ ≤
        Work.SSGRoute.EscapeCoreLib.baseChange K E hKE ⊓
          (Work.SSGRoute.EscapeCoreLib.baseChange K L₁ hKL₁) ∧
      NK.LocalAnabelian.kummerField (K' := Ω) p c₂ ≤
        Work.SSGRoute.EscapeCoreLib.baseChange K E hKE ⊓
          (Work.SSGRoute.EscapeCoreLib.baseChange K L₂ hKL₂) ∧
      (∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
        Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c
            ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) =
          Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c₁
            ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) +
          Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c₂
            ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩)) := by
  classical
  haveI hNumK : NumberField ↥K := NumberField.of_module_finite k ↥K
  haveI hsepK : IsSepClosure ↥K Ω := ⟨IsSepClosure.sep_closed Ω, inferInstance⟩
  -- the Kummer root of `c`
  have hαpow : (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) ^ p = algebraMap ↥K Ω (c : ↥K) :=
    Work.SSGRoute.kummerSqrtZMod_pow (Ω := Ω) p c
  have hαmem : Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c ∈
      NK.LocalAnabelian.kummerField (K' := Ω) p c := by
    rw [NK.UchidaKummer.Kummer.kummerField_eq_adjoin_simple p Fact.out hζ c hαpow]
    exact IntermediateField.mem_adjoin_simple_self _ _
  -- `E ⊆ baseChange K E` as subsets of `Ω`
  have hEsub : (E : Set Ω) ⊆ ((Work.SSGRoute.EscapeCoreLib.baseChange K E hKE : Set Ω)) := by
    intro x hx
    exact (Work.SSGRoute.EscapeCoreLib.mem_baseChange K E hKE).mpr hx
  -- ## the function `χ` on `Gal(Ω/k)`, extending the Kummer character of `c`
  let χ : (Ω ≃ₐ[k] Ω) → ZMod p := fun σ =>
    if h : σ ∈ K.fixingSubgroup then
      Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c
        ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, h⟩)
    else 0
  -- ## `χ` is additive on `K.fixingSubgroup`
  have hχadd : ∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χ (x * y) = χ x + χ y := by
    intro x hx y hy
    have hxy : x * y ∈ K.fixingSubgroup := Subgroup.mul_mem _ hx hy
    have hmul : ((IntermediateField.fixingSubgroupEquiv K) ⟨x * y, hxy⟩ : Ω ≃ₐ[↥K] Ω) =
        ((IntermediateField.fixingSubgroupEquiv K) ⟨x, hx⟩) *
          ((IntermediateField.fixingSubgroupEquiv K) ⟨y, hy⟩) := by
      rw [← map_mul]
      rfl
    simp only [χ, dif_pos hx, dif_pos hy, dif_pos hxy, hmul,
      Work.SSGRoute.ZConstruction.kummerCharZMod_apply_mul ζ hζ c]
  -- ## `χ` kills `(L₁ ⊔ L₂).fixingSubgroup`
  have hχkill : ∀ σ ∈ (L₁ ⊔ L₂).fixingSubgroup, χ σ = 0 := by
    intro σ hσ
    have hσK : σ ∈ K.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro x hx
      exact hσ x (le_sup_left (a := L₁) (b := L₂) (hKL₁ hx))
    have hσE : σ ∈ E.fixingSubgroup := by
      rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro x hx
      exact hσ x (hEN hx)
    have hrootE : (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) ∈ (E : Set Ω) :=
      (Work.SSGRoute.EscapeCoreLib.mem_baseChange K E hKE).mp (hc hαmem)
    have hfix : ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσK⟩)
        (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) =
        Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c := by
      show σ (Work.SSGRoute.kummerSqrtZMod (Ω := Ω) p c) = _
      exact (IntermediateField.mem_fixingSubgroup_iff E σ).mp hσE _ hrootE
    simp only [χ, dif_pos hσK]
    rw [Work.SSGRoute.ZDataMup.LocalUnramified.kummerCharZMod_eq_zero_iff_apply_sqrt p hζ c
        ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσK⟩)]
    exact hfix
  -- ## the split
  obtain ⟨χ₁, χ₂, h1add, h1kill, h2add, h2kill, hsum⟩ := hsplit χ hχadd hχkill
  -- ## any additive function killing `L₁.fixingSubgroup` and `L₂.fixingSubgroup` kills `E.fixingSubgroup`
  have hχone : ∀ x : Ω ≃ₐ[k] Ω, x ∈ K.fixingSubgroup → χ 1 = 0 → True := fun _ _ _ => trivial
  have h_one : χ 1 = 0 := by
    have h := hχadd 1 (Subgroup.one_mem _) 1 (Subgroup.one_mem _)
    rw [one_mul] at h
    exact add_left_cancel (by rw [add_zero]; exact h.symm)
  have killE : ∀ (χi : (Ω ≃ₐ[k] Ω) → ZMod p),
      (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χi (x * y) = χi x + χi y) →
      (∀ σ ∈ L₁.fixingSubgroup ⊓ L₂.fixingSubgroup, χi σ = 0) →
      ∀ x ∈ E.fixingSubgroup, χi x = 0 := by
    intro χi hadd h1 x hx
    have h1' : χi 1 = 0 := by
      have h := hadd 1 (Subgroup.one_mem _) 1 (Subgroup.one_mem _)
      rw [one_mul] at h
      exact add_left_cancel (by rw [add_zero]; exact h.symm)
    -- the subgroup of `K.fixingSubgroup`-elements killed by `χi`
    let S : Subgroup (Ω ≃ₐ[k] Ω) :=
      { carrier := {y | y ∈ K.fixingSubgroup ∧ χi y = 0}
        one_mem' := ⟨Subgroup.one_mem _, h1'⟩
        mul_mem' := by
          intro a b ha hb
          refine ⟨Subgroup.mul_mem _ ha.1 hb.1, ?_⟩
          rw [hadd a ha.1 b hb.1, ha.2, hb.2, add_zero]
        inv_mem' := by
          intro a ha
          refine ⟨Subgroup.inv_mem _ ha.1, ?_⟩
          have h := hadd a ha.1 a⁻¹ (Subgroup.inv_mem _ ha.1)
          rw [mul_inv_cancel, h1', ha.2, zero_add] at h
          exact h.symm }
    have hA : L₁.fixingSubgroup ⊓ L₂.fixingSubgroup ≤ S := by
      intro y hy
      have hy1 : y ∈ L₁.fixingSubgroup := (Subgroup.mem_inf.mp hy).1
      refine ⟨?_, h1 y hy⟩
      rw [IntermediateField.mem_fixingSubgroup_iff] at hy1 ⊢
      intro w hw
      exact hy1 w (hKL₁ hw)
    have hB : (commPow ↥(K.fixingSubgroup) p).map K.fixingSubgroup.subtype ≤ S := by
      rintro y ⟨a, ha, rfl⟩
      refine ⟨a.2, ?_⟩
      have hf : ∀ u v : ↥(K.fixingSubgroup),
          (fun b : ↥(K.fixingSubgroup) => χi (b : Ω ≃ₐ[k] Ω)) (u * v) =
            (fun b : ↥(K.fixingSubgroup) => χi (b : Ω ≃ₐ[k] Ω)) u +
              (fun b : ↥(K.fixingSubgroup) => χi (b : Ω ≃ₐ[k] Ω)) v := by
        intro u v
        exact hadd (u : Ω ≃ₐ[k] Ω) u.2 (v : Ω ≃ₐ[k] Ω) v.2
      exact commPow_le_ker_of_additive p (fun b : ↥(K.fixingSubgroup) => χi (b : Ω ≃ₐ[k] Ω)) hf a ha
    have hsup : (L₁.fixingSubgroup ⊓ L₂.fixingSubgroup) ⊔
        (commPow ↥(K.fixingSubgroup) p).map K.fixingSubgroup.subtype ≤ S := sup_le hA hB
    exact (hsup (hEfix hx)).2
  -- ## local constancy and Kummer surjectivity
  have hlc : ∀ (χi : (Ω ≃ₐ[k] Ω) → ZMod p),
      (∀ x ∈ K.fixingSubgroup, ∀ y ∈ K.fixingSubgroup, χi (x * y) = χi x + χi y) →
      (∀ x ∈ E.fixingSubgroup, χi x = 0) →
      SSGRoute.IsLocConstOn K.fixingSubgroup χi := by
    intro χi hadd hzero
    refine ⟨E.fixingSubgroup, IntermediateField.fixingSubgroup_isOpen E, ?_⟩
    intro g hg u hu huK
    rw [hadd g hg u huK, hzero u hu, add_zero]
  have h1kill' : ∀ σ ∈ L₁.fixingSubgroup ⊓ L₂.fixingSubgroup, χ₁ σ = 0 :=
    fun σ hσ => h1kill σ (Subgroup.mem_inf.mp hσ).1
  have h2kill' : ∀ σ ∈ L₁.fixingSubgroup ⊓ L₂.fixingSubgroup, χ₂ σ = 0 :=
    fun σ hσ => h2kill σ (Subgroup.mem_inf.mp hσ).2
  obtain ⟨c₁, hc₁⟩ := Work.SSGRoute.ZDataMup.KummerSurjectivity.kummerCharZMod_surjective_levelK
    p k Ω K ζ hζ χ₁ h1add (hlc χ₁ h1add (killE χ₁ h1add h1kill'))
  obtain ⟨c₂, hc₂⟩ := Work.SSGRoute.ZDataMup.KummerSurjectivity.kummerCharZMod_surjective_levelK
    p k Ω K ζ hζ χ₂ h2add (hlc χ₂ h2add (killE χ₂ h2add h2kill'))
  -- ## finiteness of the intersected levels
  haveI hfdkE : FiniteDimensional k ↥(Work.SSGRoute.EscapeCoreLib.baseChange K E hKE) :=
    Work.SSGRoute.EscapeCoreLib.finiteDimensional_baseChange K E hKE
  haveI hfdkL₁ : FiniteDimensional k ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L₁ hKL₁) :=
    Work.SSGRoute.EscapeCoreLib.finiteDimensional_baseChange K L₁ hKL₁
  haveI hfdkL₂ : FiniteDimensional k ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L₂ hKL₂) :=
    Work.SSGRoute.EscapeCoreLib.finiteDimensional_baseChange K L₂ hKL₂
  haveI hfdE : FiniteDimensional ↥K ↥(Work.SSGRoute.EscapeCoreLib.baseChange K E hKE) :=
    Module.Finite.of_restrictScalars_finite k ↥K _
  haveI hfdL₁ : FiniteDimensional ↥K ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L₁ hKL₁) :=
    Module.Finite.of_restrictScalars_finite k ↥K _
  haveI hfdL₂ : FiniteDimensional ↥K ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L₂ hKL₂) :=
    Module.Finite.of_restrictScalars_finite k ↥K _
  haveI hfdE₁ : FiniteDimensional ↥K
      ↥(Work.SSGRoute.EscapeCoreLib.baseChange K E hKE ⊓
        (Work.SSGRoute.EscapeCoreLib.baseChange K L₁ hKL₁)) :=
    FiniteDimensional.of_injective (IntermediateField.inclusion inf_le_left).toLinearMap
      (IntermediateField.inclusion_injective inf_le_left)
  haveI hfdE₂ : FiniteDimensional ↥K
      ↥(Work.SSGRoute.EscapeCoreLib.baseChange K E hKE ⊓
        (Work.SSGRoute.EscapeCoreLib.baseChange K L₂ hKL₂)) :=
    FiniteDimensional.of_injective (IntermediateField.inclusion inf_le_left).toLinearMap
      (IntermediateField.inclusion_injective inf_le_left)
  -- ## the two field inclusions
  have hσk : ∀ σ : Ω ≃ₐ[↥K] Ω, ∃ σk : Ω ≃ₐ[k] Ω, (⇑σk : Ω → Ω) = ⇑σ := by
    intro σ
    exact ⟨{ σ with
      commutes' := fun r => by
        rw [IsScalarTower.algebraMap_apply k ↥K Ω r]
        exact σ.commutes (algebraMap k ↥K r) }, rfl⟩
  have key : ∀ (χi : (Ω ≃ₐ[k] Ω) → ZMod p) (ci : (↥K)ˣ) (L : IntermediateField k Ω)
      [FiniteDimensional k L] (hKL : K ≤ L),
      (∀ (σ : Ω ≃ₐ[k] Ω) (hσ : σ ∈ K.fixingSubgroup),
        χi σ = Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ ci
          ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩)) →
      (∀ x ∈ E.fixingSubgroup, χi x = 0) →
      (∀ σ ∈ L.fixingSubgroup, χi σ = 0) →
      NK.LocalAnabelian.kummerField (K' := Ω) p ci ≤
        Work.SSGRoute.EscapeCoreLib.baseChange K E hKE ⊓
          (Work.SSGRoute.EscapeCoreLib.baseChange K L hKL) := by
    intro χi ci L hL hKL hrep hkillE hkillL
    haveI : FiniteDimensional k L := hL
    haveI hfdkL : FiniteDimensional k ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L hKL) :=
      Work.SSGRoute.EscapeCoreLib.finiteDimensional_baseChange K L hKL
    haveI hfdL : FiniteDimensional ↥K ↥(Work.SSGRoute.EscapeCoreLib.baseChange K L hKL) :=
      Module.Finite.of_restrictScalars_finite k ↥K _
    have hσkK : ∀ σ : Ω ≃ₐ[↥K] Ω,
        (hσk σ).choose ∈ K.fixingSubgroup := by
      intro σ
      rw [IntermediateField.mem_fixingSubgroup_iff]
      intro x hx
      show (hσk σ).choose x = x
      rw [show ⇑(hσk σ).choose = ⇑σ from (hσk σ).choose_spec]
      exact σ.commutes ⟨x, hx⟩
    have heq : ∀ σ : Ω ≃ₐ[↥K] Ω,
        ((IntermediateField.fixingSubgroupEquiv K)
          ⟨(hσk σ).choose, hσkK σ⟩ : Ω ≃ₐ[↥K] Ω) = σ := by
      intro σ
      refine AlgEquiv.ext (fun x => ?_)
      show (hσk σ).choose x = σ x
      exact congrFun (hσk σ).choose_spec x
    refine le_inf ?_ ?_
    · refine kummerField_le_of_vanishes_on_fixingSubgroup p k Ω K ζ hζ ci _ ?_
      intro σ hσ
      rw [← heq σ, ← hrep (hσk σ).choose (hσkK σ)]
      refine hkillE (hσk σ).choose ?_
      rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro y hy
      rw [show (hσk σ).choose y = σ y from congrFun (hσk σ).choose_spec y]
      exact hσ y ((Work.SSGRoute.EscapeCoreLib.mem_baseChange K E hKE).mpr hy)
    · refine kummerField_le_of_vanishes_on_fixingSubgroup p k Ω K ζ hζ ci _ ?_
      intro σ hσ
      rw [← heq σ, ← hrep (hσk σ).choose (hσkK σ)]
      refine hkillL (hσk σ).choose ?_
      rw [IntermediateField.mem_fixingSubgroup_iff] at hσ ⊢
      intro y hy
      rw [show (hσk σ).choose y = σ y from congrFun (hσk σ).choose_spec y]
      exact hσ y ((Work.SSGRoute.EscapeCoreLib.mem_baseChange K L hKL).mpr hy)
  have hle₁ := key χ₁ c₁ L₁ hKL₁ hc₁ (killE χ₁ h1add h1kill') h1kill
  have hle₂ := key χ₂ c₂ L₂ hKL₂ hc₂ (killE χ₂ h2add h2kill') h2kill
  refine ⟨c₁, c₂, hle₁, hle₂, ?_⟩
  intro σ hσ
  have hχσ : χ σ = Work.SSGRoute.kummerCharZMod (K := ↥K) (Ω := Ω) p (ζ := ζ) hζ c
      ((IntermediateField.fixingSubgroupEquiv K) ⟨σ, hσ⟩) := by
    simp only [χ, dif_pos hσ]
  rw [← hχσ, hsum σ hσ, ← hc₁ σ hσ, ← hc₂ σ hσ]

end Work.SSGRoute.N2v2
