# selmer_dual_inflated  (Bauer for the dual Selmer group; PROVABLE NOW)

**Statement.** Let `b : G_k → M` be a continuous 1-cocycle, where `G_k` acts through `Gal(K/k)` and
`K ≤ N`. Suppose `b` is a coboundary on `D_B` for every finite place `B` that is split in `N` and not
conjugate to a place of the finite set `S`. Then `b` factors through `res k N : G_k → Gal(N/k)`.
`M` is any `Gal(K/k)`-module; no finiteness is needed.

**Proof.** 1. `G_N ≤ G_K` acts trivially on `M`. So `b|_{G_N}` is a homomorphism, and a coboundary on
`D_B ≤ G_N` is zero there. Hence `b = 0` on `D_B` for every split `B` outside `S`.  2. `ker(b|_{G_N})`
is open, by `hlc`.  3. It is normal in `G_k` (cocycle identity).  4. Its fixed field `N_b ⊇ N` is
finite Galois over `k`.  5. Every `B` split in `N`, apart from those over the finitely many primes
`A.comap` (`A ∈ S`), has `D_B ⊆ ker`, so `B` is split in `N_b`.  6. `bauer_of_chebotarev` gives
`N_b ≤ N`. Hence `b = 0` on `G_N`.  7. Then `b (σ * n) = b σ` for `n ∈ G_N`, so `b` is constant on the
fibres of `res k N`; define `b₀` through a section of the surjection `res k N`.
-/

namespace Work.SSGRoute

open SSGRoute
open scoped Pointwise Topology

/-! ## The normal subgroup generated by the decomposition groups of the split places outside `S` -/

/-- The subgroup generated by a conjugation-invariant set of elements is normal. -/
private theorem closure_normal_of_conj_invariant {G : Type*} [Group G] (s : Set G)
    (hs : ∀ g : G, ∀ x ∈ s, g * x * g⁻¹ ∈ s) : (Subgroup.closure s).Normal := by
  rw [Subgroup.normal_iff_map_conj_eq]
  intro g
  have h : Subgroup.map (MulAut.conj g) (Subgroup.closure s) = Subgroup.closure s := by
    rw [MonoidHom.map_closure]
    congr 1
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact hs g y hy
    · intro hx
      refine ⟨g⁻¹ * x * g, ?_, ?_⟩
      · simpa using hs g⁻¹ x hx
      · change (MulAut.conj g) (g⁻¹ * x * g) = x
        rw [MulAut.conj_apply]; group
  exact h

/-- **Normality of the group generated by the decomposition groups of the split places outside `S`.**

The subgroup of `G_k = Ω ≃ₐ[k] Ω` generated by the decomposition groups `D_A` of the finite places
`A` of `Ω` which split completely in `N` and which are not conjugate to any place of the finite set
`S` is normal in `G_k`.

Indeed (as in `decomp_closure_normal`, with the extra condition) the generating set is stable under
conjugation: `IsFinPlace`, `IsSplitIn` and `decomp` are transported by `A ↦ g • A`, and the
condition "`A` avoids the conjugates of `S`" is translation invariant because
`IsConjPlace k B (g • A) ↔ IsConjPlace k B A`. -/
theorem decomp_closure_normal_except (k Ω : Type) [Field k] [NumberField k] [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] (N : IntermediateField k Ω) [FiniteDimensional k N]
    [IsGalois k N] (S : Finset (ValuationSubring Ω)) :
    (Subgroup.closure {τ : Ω ≃ₐ[k] Ω | ∃ A : ValuationSubring Ω,
      SSGRoute.IsFinPlace k A ∧ (∀ B ∈ S, ¬ SSGRoute.IsConjPlace k B A) ∧
      SSGRoute.IsSplitIn k N A ∧ τ ∈ SSGRoute.decomp k A}).Normal := by
  have hN : (N.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω)).Normal :=
    IsGalois.fixingSubgroup_normal_of_isGalois N
  refine closure_normal_of_conj_invariant _ fun g τ hτ => ?_
  obtain ⟨A, hAfin, hAconj, hAsplit, hmem⟩ := hτ
  refine ⟨g • A, ?_, ?_, ?_, ?_⟩
  · rw [SSGRoute.IsFinPlace, comap_algebraMap_smul]
    exact hAfin
  · -- "avoiding the conjugates of `S`" is invariant under translation of the place
    intro B hB hconj
    exact hAconj B hB (by
      obtain ⟨σ, hσ⟩ := hconj
      exact ⟨g⁻¹ * σ, by rw [mul_smul, hσ, inv_smul_smul]⟩)
  · rw [isSplitIn_conj N hN A g]
    exact hAsplit
  · rw [decomp_conj]
    exact Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hmem

/-- Two conjugate places of `Ω` lie over the same place of `k`. -/
theorem isConjPlace_comap_eq {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
    {A B : ValuationSubring Ω} (h : SSGRoute.IsConjPlace k A B) :
    A.comap (algebraMap k Ω) = B.comap (algebraMap k Ω) := by
  obtain ⟨σ, hσ⟩ := h
  rw [← hσ]
  exact (comap_algebraMap_smul A σ).symm

/-! ## The Chebotarev (Bauer) step -/

/-- **The Chebotarev steps of Schmidt–Wingberg Lemma 12, with an exceptional set.**

Let `b : G_k → E` be a continuous (`IsLocConstOn`) `1`-cocycle for the action of `G_k = Ω ≃ₐ[k] Ω`
on `E` through `Gal(K/k)`, where `K ≤ N` and `N/k` is finite Galois; so `G_N ≤ G_K` acts trivially
on `E`.  Suppose that for every finite place `B` of `Ω` which is split completely in `N` and which
is not conjugate to any place of the finite set `S`, the cocycle `b` is a coboundary on the
decomposition group `D_B`.  Then `b` vanishes on all of `G_N`.

(The exceptional set `S` is what one needs in the application: the local conditions are imposed only
outside the places over the fixed finite set `S`, and Bauer's theorem tolerates a finite
exceptional set of primes.) -/
theorem eq_zero_on_fixingSubgroup_of_coboundary_on_split
    (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω] [IsAlgClosure k Ω]
    (K N : IntermediateField k Ω) [FiniteDimensional k K] [Normal k K]
    [FiniteDimensional k N] [IsGalois k N] (hKN : K ≤ N)
    (E : Type) [AddCommGroup E] [DistribMulAction (K ≃ₐ[k] K) E]
    (S : Finset (ValuationSubring Ω))
    (b : (Ω ≃ₐ[k] Ω) → E)
    (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b)
    (hlc : SSGRoute.IsLocConstOn ⊤ b)
    (hcob : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k N B →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B) b) :
    ∀ σ ∈ N.fixingSubgroup, b σ = 0 := by
  classical
  -- ## `G_N ≤ G_K`, so the restriction `res k K` is trivial on `G_N`
  have hNtriv : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ N.fixingSubgroup → SSGRoute.res k K σ = 1 := by
    intro σ hσ
    refine MonoidHom.mem_ker.mp ?_
    rw [IntermediateField.restrictNormalHom_ker K]
    exact IntermediateField.fixingSubgroup_antitone hKN hσ
  have hNtriv' : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ N.fixingSubgroup →
      ∀ e : E, SSGRoute.res k K σ • e = e :=
    fun σ hσ e => by rw [hNtriv σ hσ, one_smul]
  -- ## The subgroup generated by the decomposition groups of the split places outside `S`
  let Sset : Set (Ω ≃ₐ[k] Ω) := {τ | ∃ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B ∧
    (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) ∧ SSGRoute.IsSplitIn k N B ∧
    τ ∈ SSGRoute.decomp k B}
  let H : Subgroup (Ω ≃ₐ[k] Ω) := Subgroup.closure Sset
  have hHle : H ≤ N.fixingSubgroup := by
    refine (Subgroup.closure_le (N.fixingSubgroup)).mpr ?_
    rintro τ ⟨B, _hBfin, _hBconj, hBsplit, hτD⟩
    exact hBsplit hτD
  have hHnormal : H.Normal := by
    dsimp only [H, Sset]
    exact decomp_closure_normal_except k Ω N S
  have hHsplit : ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A →
      (∀ A' ∈ S, ¬ SSGRoute.IsConjPlace k A' A) → SSGRoute.IsSplitIn k N A →
      SSGRoute.decomp k A ≤ H := by
    intro A hAfin hAconj hAsplit τ hτ
    exact Subgroup.subset_closure ⟨A, hAfin, hAconj, hAsplit, hτ⟩
  -- ## The values of `b` on `G_N` form a subgroup where it vanishes
  have hb1 : b 1 = 0 := by
    have h : b 1 = b 1 + (SSGRoute.res k K 1) • b 1 := by
      simpa using hb 1 (Subgroup.mem_top 1) 1 (Subgroup.mem_top 1)
    rw [map_one, one_smul] at h
    exact (add_left_cancel (by rw [add_zero]; exact h)).symm
  let Sb : Subgroup (Ω ≃ₐ[k] Ω) :=
    { carrier := {τ : Ω ≃ₐ[k] Ω | τ ∈ N.fixingSubgroup ∧ b τ = 0}
      one_mem' := ⟨N.fixingSubgroup.one_mem, hb1⟩
      mul_mem' := by
        rintro a c ⟨haN : a ∈ N.fixingSubgroup, ha0 : b a = 0⟩
          ⟨hcN : c ∈ N.fixingSubgroup, hc0 : b c = 0⟩
        refine ⟨N.fixingSubgroup.mul_mem haN hcN, ?_⟩
        rw [hb a (Subgroup.mem_top a) c (Subgroup.mem_top c), ha0,
          hNtriv' a haN (b c), hc0, zero_add]
      inv_mem' := by
        rintro a ⟨haN : a ∈ N.fixingSubgroup, ha0 : b a = 0⟩
        refine ⟨N.fixingSubgroup.inv_mem haN, ?_⟩
        have h1 := hb a (Subgroup.mem_top a) a⁻¹ (Subgroup.mem_top a⁻¹)
        rw [mul_inv_cancel] at h1
        rw [hb1, ha0, zero_add, hNtriv' a haN (b a⁻¹)] at h1
        exact h1.symm }
  -- `b` vanishes on the decomposition group of every split place outside `S`
  have hHS : H ≤ Sb := by
    refine (Subgroup.closure_le Sb).mpr ?_
    rintro τ ⟨B, hBfin, hBconj, hBsplit, hτD⟩
    obtain ⟨m, hm⟩ := hcob B hBfin hBconj hBsplit
    refine ⟨hBsplit hτD, ?_⟩
    rw [hm τ hτD, hNtriv τ (hBsplit hτD), one_smul, sub_self]
  have hHc0 : ∀ h ∈ H, b h = 0 := fun h hh => (hHS hh).2
  -- ## The main argument
  intro σ hσ
  obtain ⟨U, hUopen, hUcst⟩ := hlc
  -- a finite Galois level `Mf ⊇ N` with `G_{Mf} ≤ U ∩ G_N`
  have hGNopen : IsOpen (N.fixingSubgroup : Set (Ω ≃ₐ[k] Ω)) :=
    IntermediateField.fixingSubgroup_isOpen N
  have hVopen : IsOpen (((U ⊓ N.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω))) : Set (Ω ≃ₐ[k] Ω)) := by
    rw [Subgroup.coe_inf]
    exact hUopen.inter hGNopen
  have hVnhds : (((U ⊓ N.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω))) : Set (Ω ≃ₐ[k] Ω)) ∈
      𝓝 (1 : Ω ≃ₐ[k] Ω) :=
    hVopen.mem_nhds (Subgroup.mem_inf.mpr ⟨U.one_mem, N.fixingSubgroup.one_mem⟩)
  obtain ⟨Ef, hEffin, hEfnorm, hEfU⟩ :=
    (krullTopology_mem_nhds_one_iff_of_normal k Ω
      (((U ⊓ N.fixingSubgroup : Subgroup (Ω ≃ₐ[k] Ω))) : Set (Ω ≃ₐ[k] Ω))).mp hVnhds
  let Mf : IntermediateField k Ω := Ef ⊔ N
  haveI hEffinI : FiniteDimensional k Ef := hEffin
  haveI hEfnormI : Normal k Ef := hEfnorm
  haveI hMffin : FiniteDimensional k Mf := inferInstance
  haveI hMfnorm : Normal k Mf := inferInstance
  haveI hMfgal : IsGalois k Mf :=
    Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  have hNMf : N ≤ Mf := le_sup_right
  have hGMle : Mf.fixingSubgroup ≤ U ⊓ N.fixingSubgroup := by
    intro x hx
    rw [show Mf.fixingSubgroup = Ef.fixingSubgroup ⊓ N.fixingSubgroup by
      dsimp only [Mf]
      rw [IntermediateField.fixingSubgroup_sup]] at hx
    exact ⟨(hEfU hx.1).1, hx.2⟩
  have hGMGN : Mf.fixingSubgroup ≤ N.fixingSubgroup := fun x hx => (hGMle hx).2
  -- ## Chebotarev/Bauer at the finite level: `G_N = H · G_{Mf}`
  have hcrux : ∀ τ ∈ N.fixingSubgroup, ∃ h ∈ H, ∃ g ∈ Mf.fixingSubgroup, h * g = τ := by
    intro τ hτ
    let φ : (Ω ≃ₐ[k] Ω) →* (Mf ≃ₐ[k] Mf) :=
      AlgEquiv.restrictNormalHom (F := k) (K₁ := Ω) ↥Mf
    have hφsurj : Function.Surjective φ :=
      AlgEquiv.restrictNormalHom_surjective (F := k) (K₁ := ↥Mf) (E := Ω)
    let K₁ : Subgroup (Mf ≃ₐ[k] Mf) := H.map φ
    have hK₁n : K₁.Normal := Subgroup.Normal.map hHnormal φ hφsurj
    let H' : Subgroup (Ω ≃ₐ[k] Ω) := K₁.comap φ
    have hH'n : H'.Normal := hK₁n.comap φ
    have hH'H : H ≤ H' := fun x hx => Subgroup.mem_map_of_mem φ hx
    have hH'N : H' ≤ N.fixingSubgroup := by
      intro x hx
      have hx' : φ x ∈ K₁ := hx
      obtain ⟨h, hhH, hhh⟩ := Subgroup.mem_map.mp hx'
      have hker : h⁻¹ * x ∈ Mf.fixingSubgroup := by
        rw [← IntermediateField.restrictNormalHom_ker Mf, MonoidHom.mem_ker]
        show φ (h⁻¹ * x) = 1
        rw [map_mul, map_inv, hhh, inv_mul_cancel]
      have hxeq : x = h * (h⁻¹ * x) := by group
      rw [hxeq]
      exact N.fixingSubgroup.mul_mem (hHle hhH) (hGMGN hker)
    have hMH' : Mf.fixingSubgroup ≤ H' := by
      intro x hx
      rw [← IntermediateField.restrictNormalHom_ker Mf] at hx
      have hx1 : φ x = 1 := MonoidHom.mem_ker.mp hx
      change φ x ∈ K₁
      rw [hx1]
      exact K₁.one_mem
    -- the fixed field of `H'` is finite, normal over `k` and between `N` and `Mf`
    obtain ⟨hNF, hFfin, hFnorm, hFfix⟩ :=
      fixedField_of_le_fixingSubgroup k Ω N H' hH'N hH'n Mf hMH'
    set F : IntermediateField k Ω := IntermediateField.fixedField H' with hFdef
    haveI hFfinI : FiniteDimensional k F := hFfin
    haveI hFnormI : Normal k F := hFnorm
    haveI hFgalI : IsGalois k F :=
      Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
    -- every place split in `N`, apart from the places over the finite set `S.comap`, is split in `F`
    have hsplitF : ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A →
        A.comap (algebraMap k Ω) ∉ (S.image (fun A => A.comap (algebraMap k Ω))) →
        SSGRoute.IsSplitIn k N A → SSGRoute.IsSplitIn k F A := by
      intro A hAfin hAcom hAsplit
      refine le_trans (hHsplit A hAfin ?_ hAsplit) ?_
      · intro A' hA' hconj
        exact hAcom (Finset.mem_image.mpr ⟨A', hA', isConjPlace_comap_eq hconj⟩)
      · intro x hx
        rw [hFdef, hFfix]
        exact hH'H hx
    -- Bauer's theorem: `F ≤ N`
    have hFN : F ≤ N :=
      bauer_of_chebotarev k Ω F N (S.image (fun A => A.comap (algebraMap k Ω))) hsplitF
    have hFeqN : F = N := le_antisymm hFN hNF
    have hGN : N.fixingSubgroup = H' := by
      rw [← hFeqN]
      rw [hFdef, hFfix]
    have hτH' : τ ∈ H' := hGN ▸ hτ
    obtain ⟨h, hhH, hhτ⟩ := Subgroup.mem_map.mp hτH'
    refine ⟨h, hhH, h⁻¹ * τ, ?_, ?_⟩
    · rw [← IntermediateField.restrictNormalHom_ker Mf, MonoidHom.mem_ker]
      show φ (h⁻¹ * τ) = 1
      rw [map_mul, map_inv, hhτ, inv_mul_cancel]
    · group
  obtain ⟨h, hhH, g, hgM, hhg⟩ := hcrux σ hσ
  have hgu : g⁻¹ ∈ U := U.inv_mem (hGMle hgM).1
  have hσg : σ * g⁻¹ = h := by
    have := congrArg (fun x => x * g⁻¹) hhg
    simpa using this.symm
  calc b σ = b (σ * g⁻¹) := (hUcst σ (Subgroup.mem_top σ) g⁻¹ hgu (Subgroup.mem_top g⁻¹)).symm
    _ = b h := by rw [hσg]
    _ = 0 := hHc0 h hhH

/-- Bauer/Chebotarev for the dual Selmer group of `coker_obstruction`: a continuous `1`-cocycle
`b : G_k → M` (with `G_k` acting through `Gal(K/k)`, `K ≤ N`) that is a coboundary on the
decomposition group of every finite place split completely in `N`, apart from the finitely many
primes below `S`, factors through `Gal(N/k)`. -/
theorem selmer_dual_inflated (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K N : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [FiniteDimensional k N] [IsGalois k N] (hKN : K ≤ N)
    (M : Type) [AddCommGroup M] [DistribMulAction (K ≃ₐ[k] K) M]
    (S : Finset (ValuationSubring Ω))
    (b : (Ω ≃ₐ[k] Ω) → M) (hb : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ b)
    (hlc : SSGRoute.IsLocConstOn ⊤ b)
    (hsplit : ∀ B : ValuationSubring Ω, SSGRoute.IsFinPlace k B →
      (∀ A ∈ S, ¬ SSGRoute.IsConjPlace k A B) → SSGRoute.IsSplitIn k N B →
        SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k B) b) :
    ∃ b₀ : (N ≃ₐ[k] N) → M, ∀ σ : Ω ≃ₐ[k] Ω, b σ = b₀ (SSGRoute.res k N σ) := by
  classical
  have hzero : ∀ σ ∈ N.fixingSubgroup, b σ = 0 :=
    eq_zero_on_fixingSubgroup_of_coboundary_on_split k Ω K N hKN M S b hb hlc hsplit
  -- `b` vanishes on `G_N`, so it is constant on the fibres of `res k N`
  have hwd : ∀ σ σ' : Ω ≃ₐ[k] Ω, SSGRoute.res k N σ = SSGRoute.res k N σ' → b σ = b σ' := by
    intro σ σ' h
    have h1 : SSGRoute.res k N (σ⁻¹ * σ') = 1 := by
      simp only [map_mul, map_inv, h, inv_mul_cancel]
    have hmem : σ⁻¹ * σ' ∈ N.fixingSubgroup := by
      rw [← IntermediateField.restrictNormalHom_ker N]
      exact MonoidHom.mem_ker.mpr h1
    have h0 : b (σ⁻¹ * σ') = 0 := hzero _ hmem
    have h2 := hb σ (Subgroup.mem_top σ) (σ⁻¹ * σ') (Subgroup.mem_top (σ⁻¹ * σ'))
    rw [h0, smul_zero, add_zero] at h2
    have hmul : σ * (σ⁻¹ * σ') = σ' := by group
    rw [hmul] at h2
    exact h2.symm
  -- a section of the surjection `res k N` defines `b₀`
  have hsurj : Function.Surjective (SSGRoute.res k N) :=
    AlgEquiv.restrictNormalHom_surjective Ω
  refine ⟨fun y => b (Function.surjInv hsurj y), fun σ => ?_⟩
  exact hwd σ (Function.surjInv hsurj (SSGRoute.res k N σ))
    (Function.surjInv_eq hsurj (SSGRoute.res k N σ)).symm

end Work.SSGRoute
