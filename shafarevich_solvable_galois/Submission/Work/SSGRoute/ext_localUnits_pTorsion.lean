/-! ## General helpers -/

/-- A finite additive commutative group of cardinality at most two is monogenic. -/
theorem exists_zmultiples_eq_top_of_card_le_two {A : Type} [AddCommGroup A] [Finite A]
    (h : Nat.card A ≤ 2) : ∃ u : A, AddSubgroup.zmultiples u = ⊤ := by
  have hpos : 0 < Nat.card A := Nat.card_pos
  rcases (by omega : Nat.card A = 1 ∨ Nat.card A = 2) with h1 | h2
  · have hsub : Subsingleton A := (Nat.card_eq_one_iff_unique.mp h1).1
    refine ⟨0, ?_⟩
    rw [AddSubgroup.eq_top_iff']
    intro x
    rw [hsub.elim x 0]
    exact AddSubgroup.zero_mem _
  · have hne : ∃ s : A, s ≠ 0 := by
      by_contra hcon
      have hsub : Subsingleton A := ⟨fun a b => by
        have ha : a = 0 := by
          by_contra h
          exact hcon ⟨a, h⟩
        have hb : b = 0 := by
          by_contra h
          exact hcon ⟨b, h⟩
        rw [ha, hb]⟩
      have h1' : Nat.card A = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨0⟩⟩
      exact absurd (h1'.symm.trans h2) (by decide)
    obtain ⟨s, hs⟩ := hne
    refine ⟨s, ?_⟩
    have hdvd : addOrderOf s ∣ 2 := by
      rw [← h2]; exact addOrderOf_dvd_natCard s
    have hne1 : addOrderOf s ≠ 1 := fun hh => hs (AddMonoid.addOrderOf_eq_one_iff.mp hh)
    have hord : addOrderOf s = 2 := by
      rcases (Nat.dvd_prime (by norm_num : Nat.Prime 2)).mp hdvd with h | h
      · exact absurd h hne1
      · exact h
    refine AddSubgroup.eq_top_of_card_eq _ ?_
    rw [Nat.card_zmultiples, hord, h2]

/-- **The `p`-torsion of a finite monogenic additive group is cyclic or zero.**  If `A` is a
finite additive commutative group generated by `u`, then the `p`-torsion subgroup of `A` is either
trivial or cyclic: either the only `p`-torsion element is `0`, or there is a `p`-torsion element
`x` such that every `p`-torsion element is an integral multiple of `x`. -/
theorem pTorsion_cyclic_or_zero_of_generator {A : Type} [AddCommGroup A]
    (p : ℕ) [Fact p.Prime] (u : A) (hgen : AddSubgroup.zmultiples u = ⊤) :
    (∀ x : A, p • x = 0 → x = 0) ∨
      ∃ x : A, p • x = 0 ∧ ∀ y : A, p • y = 0 → ∃ m : ℤ, y = m • x := by
  have hn : addOrderOf u = Nat.card A := by
    have h1 : Nat.card (AddSubgroup.zmultiples u) = Nat.card A := by
      rw [hgen, AddSubgroup.card_top]
    rwa [Nat.card_zmultiples] at h1
  by_cases hp : p ∣ addOrderOf u
  · right
    refine ⟨(addOrderOf u / p) • u, ?_, ?_⟩
    · rw [smul_comm, ← mul_nsmul, Nat.mul_div_cancel' hp]
      exact addOrderOf_dvd_iff_nsmul_eq_zero.mp (dvd_refl _)
    · intro y hy
      obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen ▸ AddSubgroup.mem_top y)
      have hpy : (p : ℤ) • y = 0 := by rw [natCast_zsmul]; exact hy
      have h0 : ((p : ℤ) * k) • u = 0 := by rw [mul_zsmul, hk, hpy]
      have hdvd : (addOrderOf u : ℤ) ∣ (p : ℤ) * k :=
        addOrderOf_dvd_iff_zsmul_eq_zero.mpr h0
      have hcast : (addOrderOf u : ℤ) = (p : ℤ) * ((addOrderOf u / p : ℕ) : ℤ) := by
        rw [← Nat.cast_mul, Nat.mul_div_cancel' hp]
      have hpne : (p : ℤ) ≠ 0 := by
        exact_mod_cast (Fact.out : p.Prime).ne_zero
      have hdvd2 : ((addOrderOf u / p : ℕ) : ℤ) ∣ k := by
        have h2 : (p : ℤ) * ((addOrderOf u / p : ℕ) : ℤ) ∣ (p : ℤ) * k := by
          rwa [← hcast]
        exact (Int.mul_dvd_mul_iff_left hpne).mp h2
      obtain ⟨m, hm⟩ := hdvd2
      refine ⟨m, ?_⟩
      rw [← hk, hm, Int.mul_comm, mul_zsmul, natCast_zsmul]
  · left
    intro x hx
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp (hgen ▸ AddSubgroup.mem_top x)
    have hpx : (p : ℤ) • x = 0 := by rw [natCast_zsmul]; exact hx
    have h0 : ((p : ℤ) * k) • u = 0 := by rw [mul_zsmul, hk, hpx]
    have hdvd : (addOrderOf u : ℤ) ∣ (p : ℤ) * k :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mpr h0
    have hcop : Nat.Coprime (addOrderOf u) p :=
      ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr hp).symm
    have hdvdk : (addOrderOf u : ℤ) ∣ k :=
      hcop.isCoprime.dvd_of_dvd_mul_left hdvd
    obtain ⟨j, hj⟩ := hdvdk
    have hnu : (addOrderOf u : ℤ) • u = 0 :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mp (dvd_refl ((addOrderOf u : ℕ) : ℤ))
    rw [← hk, hj, Int.mul_comm, mul_zsmul, hnu, smul_zero]

/-! ## The local cyclicity inputs -/

/-- A finite group of cardinality at most two is cyclic. -/
theorem isCyclic_of_card_le_two {G : Type} [Group G] [Finite G] (h : Nat.card G ≤ 2) :
    IsCyclic G := by
  classical
  have hpos : 0 < Nat.card G := Nat.card_pos
  rcases (by omega : Nat.card G = 1 ∨ Nat.card G = 2) with h1 | h2
  · have hsub : Subsingleton G := (Nat.card_eq_one_iff_unique.mp h1).1
    refine ⟨1, fun x => ⟨0, ?_⟩⟩
    show 1 ^ (0 : ℤ) = x
    rw [zpow_zero]
    exact (hsub.elim x 1).symm
  · have hne : ∃ s : G, s ≠ 1 := by
      by_contra hcon
      push Not at hcon
      have hsub : Subsingleton G := ⟨fun a b => by rw [hcon a, hcon b]⟩
      have h1' : Nat.card G = 1 := Nat.card_eq_one_iff_unique.mpr ⟨hsub, ⟨1⟩⟩
      exact absurd (h1'.symm.trans h2) (by decide)
    obtain ⟨s, hs⟩ := hne
    haveI : Fintype G := Fintype.ofFinite G
    have hgen : ∀ g : G, g = 1 ∨ g = s := by
      intro g
      by_cases h : g = 1
      · exact Or.inl h
      · refine Or.inr ?_
        by_contra hgs
        have hsng : s ∉ ({g} : Finset G) := by
          simp only [Finset.mem_singleton]
          exact fun hsg => hgs hsg.symm
        have h1ng : (1 : G) ∉ ({s, g} : Finset G) := by
          simp only [Finset.mem_insert, Finset.mem_singleton, not_or]
          exact ⟨fun h' => hs h'.symm, fun h' => h h'.symm⟩
        have hcard3 : ({1, s, g} : Finset G).card = 3 := by
          rw [Finset.card_insert_of_notMem h1ng, Finset.card_insert_of_notMem hsng,
            Finset.card_singleton]
        have hle := Finset.card_le_univ ({1, s, g} : Finset G)
        rw [hcard3, ← Nat.card_eq_fintype_card, h2] at hle
        omega
    refine ⟨s, fun x => ?_⟩
    rcases hgen x with hx | hx
    · refine ⟨0, ?_⟩
      show s ^ (0 : ℤ) = x
      rw [zpow_zero, hx]
    · refine ⟨1, ?_⟩
      show s ^ (1 : ℤ) = x
      rw [zpow_one, hx]

/-- At an infinite place the decomposition group of `NK.GlobalCFTdeep` has order at most two. -/
theorem natCard_decompositionSubgroup_ofInfinite_le_two (k L : Type) [Field k] [NumberField k]
    [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (ŵ : NumberField.InfinitePlace L) :
    Nat.card ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
      (NK.GlobalCFT.Place.ofInfinite ŵ)) ≤ 2 := by
  have hcard : Nat.card ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
      (NK.GlobalCFT.Place.ofInfinite ŵ))
      = Nat.card {δ : L ≃ₐ[k] L // δ • NK.GlobalCFT.Place.ofInfinite ŵ
          = NK.GlobalCFT.Place.ofInfinite ŵ} := rfl
  rw [hcard]
  by_cases hu : NumberField.InfinitePlace.IsUnramified k ŵ
  · rw [NK.GlobalCFT.Inclusion.natCard_infStab_of_isUnramified (K := k) (L := L) hu]
    norm_num
  · rw [NK.GlobalCFT.Inclusion.natCard_infStab_of_not_isUnramified (K := k) (L := L) hu]

/-- **The order of the local Brauer group at an infinite place is the order of the decomposition
group.**  `#H²(D_w, L_wˣ) = #D_w`. -/
theorem natCard_extH_localUnits_deep_ofInfinite (k L : Type) [Field k] [NumberField k] [Field L]
    [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (ŵ : NumberField.InfinitePlace L) :
    Nat.card (extH (localUnitsK (k := k) (NK.GlobalCFT.Place.ofInfinite ŵ)) 2)
      = Nat.card ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
          (NK.GlobalCFT.Place.ofInfinite ŵ)) := by
  haveI : Fintype ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
      (NK.GlobalCFT.Place.ofInfinite ŵ)) := Fintype.ofFinite _
  haveI hcyc : IsCyclic ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
      (NK.GlobalCFT.Place.ofInfinite ŵ)) :=
    isCyclic_of_card_le_two (natCard_decompositionSubgroup_ofInfinite_le_two k L ŵ)
  -- transport the Hasse–Brauer–Noether local units rep to the `NK.GlobalCFTdeep` one
  have h2 : Nat.card (groupCohomology (localUnitsK (k := k) (NK.GlobalCFT.Place.ofInfinite ŵ)) 2)
      = Nat.card (groupCohomology (NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L)
          (NK.GlobalCFT.Place.ofInfinite ŵ)) 2) := by
    obtain ⟨e⟩ := h2_transport_rho_eq
      (A := NK.HassePrinciple.localUnitsRep k L (NK.GlobalCFT.Place.ofInfinite ŵ))
      (B := NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L) (NK.GlobalCFT.Place.ofInfinite ŵ))
      (AddEquiv.refl _)
      (fun g x => NK.GlobalCFTdeep.hasseUnitsRep_rho_eq (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ) g x)
    exact Nat.card_congr e.toEquiv
  have h3 : Nat.card (groupCohomology (NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ)) 2)
      = Nat.card (tateCohomology (NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ)) 0) :=
    Commons.RepresentationTheory.GroupCohomology.natCard_groupCohomology_two_eq_tateCohomology_zero_cyclic
      ((NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ)).ρ)
  have h4 : Nat.card (tateCohomology (NK.GlobalCFTdeep.localUnitsRep (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ)) 0)
      = Nat.card ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
          (NK.GlobalCFT.Place.ofInfinite ŵ)) := by
    have hH := NK.GlobalCFTdeep.Herbrand.herbrandEq_localUnitsRep_ofInfinite
      (K := k) (L := L) (ŵ.comap (algebraMap k L)) ŵ (NK.GlobalCFT.Norm.liesOver_comap_self ŵ)
    have h1 := NK.GlobalCFTdeep.Herbrand.natCard_tateCohomology_one_localUnitsRep
      (K := k) (L := L) (NK.GlobalCFT.Place.ofInfinite ŵ)
    rw [NK.GlobalCFTdeep.HerbrandEq, NK.GlobalCFTdeep.hZero_def, NK.GlobalCFTdeep.hOne_def,
      h1, mul_one] at hH
    exact hH
  rw [← Nat.card_congr (Work.SSGRoute.Bridge.E 2
      (decompK (k := k) (NK.GlobalCFT.Place.ofInfinite ŵ))
      (localUnitsK (k := k) (NK.GlobalCFT.Place.ofInfinite ŵ))).toEquiv, h2, h3, h4]

/-- **Cyclicity of the local Brauer group at a finite place**: `H²(D_w, L_wˣ)` has a generator. -/
theorem extH_localUnits_generator_ofFinite (k L : Type) [Field k] [NumberField k] [Field L]
    [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L)) :
    ∃ u : extH (localUnitsK (k := k) (NK.GlobalCFT.Place.ofFinite q)) 2,
      AddSubgroup.zmultiples u = ⊤ := by
  obtain ⟨hcard, u, hu⟩ := eb_loc_card k k L q
  have e := Work.SSGRoute.Bridge.E 2 (decompK (k := k) (NK.GlobalCFT.Place.ofFinite q))
    (localUnitsK (k := k) (NK.GlobalCFT.Place.ofFinite q))
  have hDne : Nat.card (decompK (k := k) (NK.GlobalCFT.Place.ofFinite q)) ≠ 0 :=
    Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
  have hord : addOrderOf (e u) = Nat.card (decompK (k := k) (NK.GlobalCFT.Place.ofFinite q)) :=
    (AddEquiv.addOrderOf_eq e u).trans (by rw [hu, hcard])
  have hcardE : Nat.card (extH (localUnitsK (k := k) (NK.GlobalCFT.Place.ofFinite q)) 2)
      = Nat.card (decompK (k := k) (NK.GlobalCFT.Place.ofFinite q)) := by
    rw [← Nat.card_congr e.toEquiv, hcard]
  refine ⟨e u, ?_⟩
  haveI : Finite ↥(AddSubgroup.zmultiples (e u)) :=
    (Nat.card_ne_zero.mp (by rw [Nat.card_zmultiples, hord]; exact hDne)).2
  refine AddSubgroup.eq_top_of_card_eq _ ?_
  rw [Nat.card_zmultiples, hord, hcardE]

/-- **The local Brauer group `H²(D_w, L_wˣ) = Br(L_w/k_v)` is monogenic** at every place `w`. -/
theorem extH_localUnits_generator (k L : Type) [Field k] [NumberField k] [Field L]
    [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (w : NK.GlobalCFT.Place L) :
    ∃ u : extH (localUnitsK (k := k) w) 2, AddSubgroup.zmultiples u = ⊤ := by
  rcases w with ŵ | q
  · have hcard := natCard_extH_localUnits_deep_ofInfinite k L ŵ
    have hDne : Nat.card ↥(NK.GlobalCFTdeep.decompositionSubgroup (K := k) (L := L)
        (NK.GlobalCFT.Place.ofInfinite ŵ)) ≠ 0 :=
      Nat.card_ne_zero.mpr ⟨⟨1⟩, inferInstance⟩
    haveI : Finite (extH (localUnitsK (k := k) (NK.GlobalCFT.Place.ofInfinite ŵ)) 2) :=
      (Nat.card_ne_zero.mp (by rw [hcard]; exact hDne)).2
    exact exists_zmultiples_eq_top_of_card_le_two (by
      rw [hcard]
      exact natCard_decompositionSubgroup_ofInfinite_le_two k L ŵ)
  · exact extH_localUnits_generator_ofFinite k L q

/-- **Local cyclicity, in `Ext` form.**  For a place `w` of the number field `L`, the `p`-torsion of
the local group `extH (localUnitsK (k := k) w) 2 = H²(D_w, L_wˣ) = Br(L_w/k_v)` is either zero or
cyclic: there is a `p`-torsion element `x` such that every `p`-torsion element is an integral
multiple of `x` (the disjunctive form avoids needing `p ∣ |D_w|` as a hypothesis; for `p ∣ |D_w|`
at a non-archimedean place the group is `ZMod p`).

(This is `Br(k_v)[p] ≅ ℤ/p` — the local fundamental class; the workspace has it in the
`groupCohomology` vocabulary (`NK.natCard_groupCohomology_two_units_local_eq_finrank`,
`unitsLevelH2_addOrderOf_realization`), and this is its `Ext` counterpart.  It is one of the two
local inputs of the assembly `phi0_trivial_epi_in` (the "read off the coefficients `a_v`" step).) -/
theorem ext_localUnits_pTorsion (p : ℕ) [Fact p.Prime] (k L : Type) [Field k] [NumberField k]
    [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (w : NK.GlobalCFT.Place L) :
    (∀ x : extH (localUnitsK (k := k) w) 2, p • x = 0 → x = 0) ∨
      ∃ x : extH (localUnitsK (k := k) w) 2, p • x = 0 ∧
        ∀ y : extH (localUnitsK (k := k) w) 2, p • y = 0 → ∃ m : ℤ, y = m • x := by
  obtain ⟨u, hgen⟩ := extH_localUnits_generator k L w
  exact pTorsion_cyclic_or_zero_of_generator p u hgen


