/-!
# A fractional ideal contains an element of prescribed `P`-adic order

For a Dedekind domain `R` with fraction field `K` and a nonzero fractional ideal `I`,
there is an element `x ∈ I` whose additive `P`-adic exponent `adicExp P x` equals
`FractionalIdeal.count K P I`, the exponent of the height one prime `P` in the
factorisation of `I`.

The proof writes `I = spanSingleton a⁻¹ * J` with `a ∈ R` nonzero and `J` a nonzero
ideal of `R` (`FractionalIdeal.exists_eq_spanSingleton_mul`), puts `k` for the exponent
of `P` in `J`, and chooses `j ∈ J` with `j ∉ P ^ (k + 1)` (which exists since
`count K P J = k`).  Then `x = a⁻¹ · j` works, because both `adicExp P` and `count K P`
are additive and agree on principal fractional ideals generated by elements of `R`.
-/

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open IsDedekindDomain

variable {R : Type*} {K : Type*} [CommRing R] [IsDedekindDomain R] [Field K]
    [Algebra R K] [IsFractionRing R K]

/-- The additive exponent of the inverse. -/
theorem adicExp_inv (v : HeightOneSpectrum R) {x : K} (hx : x ≠ 0) :
    adicExp v x⁻¹ = -adicExp v x := by
  have hx' : x⁻¹ ≠ 0 := inv_ne_zero hx
  have h1 : adicExp v (x * x⁻¹) = adicExp v x + adicExp v x⁻¹ := adicExp_mul v hx hx'
  rw [mul_inv_cancel₀ hx] at h1
  have h0 : adicExp v (1 : K) = 0 :=
    (adicExp_eq_zero_iff v (x := 1) one_ne_zero).mpr (map_one _)
  rw [h0] at h1
  linarith

/-- For an element of `R`, `count` of the principal fractional ideal it generates equals the
additive exponent. -/
theorem count_spanSingleton_algebraMap (v : HeightOneSpectrum R) (x : R) (hx : x ≠ 0) :
    FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) (algebraMap R K x)) =
      adicExp v (algebraMap R K x) := by
  have hspan : (Ideal.span {x} : Ideal R) ≠ 0 := by
    rw [Ne, Ideal.zero_eq_bot, Ideal.span_singleton_eq_bot]; exact hx
  rw [← FractionalIdeal.coeIdeal_span_singleton (S := nonZeroDivisors R) x,
    FractionalIdeal.count_coe K v hspan,
    Ideal.count_associates_factors_eq hspan v.isPrime v.ne_bot,
    adicExp_algebraMap_eq_count v x hx]

/-- Variant of `count_spanSingleton_algebraMap` for the inverse of an element of `R`. -/
theorem count_spanSingleton_inv_algebraMap (v : HeightOneSpectrum R) (x : R) (hx : x ≠ 0) :
    FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K x)⁻¹)) =
      -adicExp v (algebraMap R K x) := by
  rw [← FractionalIdeal.spanSingleton_inv K (algebraMap R K x),
    FractionalIdeal.count_inv, count_spanSingleton_algebraMap v x hx]

theorem exists_mem_adicExp_eq_fractionalIdeal_count {R : Type*} [CommRing R]
    [IsDedekindDomain R] {K : Type*} [Field K] [Algebra R K] [IsFractionRing R K]
    (P : IsDedekindDomain.HeightOneSpectrum R)
    {I : FractionalIdeal (nonZeroDivisors R) K} (hI : I ≠ 0) :
    ∃ x ∈ I, Work.SSGRoute.TatePoitouRoute.FinitenessHM.adicExp P x
      = FractionalIdeal.count K P I := by
  obtain ⟨a, J, ha_ne, hI_eq⟩ := FractionalIdeal.exists_eq_spanSingleton_mul I
  have hJ_ne : J ≠ 0 := FractionalIdeal.ideal_factor_ne_zero hI hI_eq
  set k : ℕ := (Associates.mk P.asIdeal).count (Associates.mk J).factors with hk
  have hcount_J : FractionalIdeal.count K P (J : FractionalIdeal (nonZeroDivisors R) K)
      = (k : ℤ) := by
    rw [FractionalIdeal.count_coe K P hJ_ne, hk]
  -- `P ^ k` divides `J`, while `P ^ (k + 1)` does not.
  have hJ_le : J ≤ P.asIdeal ^ k := by
    rw [← Ideal.dvd_iff_le, ← Associates.mk_le_mk_iff_dvd, Associates.mk_pow]
    exact (Associates.prime_pow_dvd_iff_le (Associates.mk_ne_zero.mpr hJ_ne)
      P.associates_irreducible).mpr (le_of_eq hk)
  have hJ_not_le : ¬ J ≤ P.asIdeal ^ (k + 1) := by
    intro h
    have hdvd : P.asIdeal ^ (k + 1) ∣ J := Ideal.dvd_iff_le.mpr h
    rw [← Associates.mk_le_mk_iff_dvd, Associates.mk_pow] at hdvd
    have hle := (Associates.prime_pow_dvd_iff_le (Associates.mk_ne_zero.mpr hJ_ne)
      P.associates_irreducible).mp hdvd
    rw [hk] at hle
    omega
  -- An element of `J` which is not in `P ^ (k+1)`.
  obtain ⟨j, hj_mem, hj_notmem⟩ : ∃ j ∈ J, j ∉ P.asIdeal ^ (k + 1) := by
    by_contra h
    apply hJ_not_le
    intro x hx
    by_contra hx'
    exact h ⟨x, hx, hx'⟩
  have hj_ne : j ≠ 0 := by
    rintro rfl
    exact hj_notmem (Submodule.zero_mem _)
  have hj_span_le : Ideal.span {j} ≤ P.asIdeal ^ k :=
    (Ideal.span_singleton_le_iff_mem _).mpr (hJ_le hj_mem)
  have hj_span_not_le : ¬ Ideal.span {j} ≤ P.asIdeal ^ (k + 1) := by
    rw [Ideal.span_singleton_le_iff_mem]; exact hj_notmem
  have hadicExp_j : adicExp P (algebraMap R K j) = (k : ℤ) := by
    rw [adicExp_algebraMap_eq_count P j hj_ne]
    exact_mod_cast Ideal.count_normalizedFactors_eq hj_span_le hj_span_not_le
  refine ⟨(algebraMap R K a)⁻¹ * algebraMap R K j, ?_, ?_⟩
  · rw [hI_eq, FractionalIdeal.mem_singleton_mul]
    exact ⟨algebraMap R K j, (FractionalIdeal.mem_coeIdeal _).mpr ⟨j, hj_mem, rfl⟩, rfl⟩
  · have ha_mem_ne : algebraMap R K a ≠ 0 :=
      fun h => ha_ne ((IsFractionRing.to_map_eq_zero_iff).mp h)
    have hj_mem_ne : algebraMap R K j ≠ 0 :=
      fun h => hj_ne ((IsFractionRing.to_map_eq_zero_iff).mp h)
    have ha_inv_ne : (algebraMap R K a)⁻¹ ≠ 0 := inv_ne_zero ha_mem_ne
    have hspan_inv_ne :
        FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K a)⁻¹) ≠ 0 :=
      FractionalIdeal.spanSingleton_ne_zero_iff.mpr ha_inv_ne
    have hJ_coe_ne : (J : FractionalIdeal (nonZeroDivisors R) K) ≠ 0 :=
      FractionalIdeal.coeIdeal_ne_zero.mpr hJ_ne
    have hcount_I : FractionalIdeal.count K P I =
        -adicExp P (algebraMap R K a) + (k : ℤ) := by
      rw [hI_eq, FractionalIdeal.count_mul K P hspan_inv_ne hJ_coe_ne,
        count_spanSingleton_inv_algebraMap P a ha_ne, hcount_J]
    rw [adicExp_mul P ha_inv_ne hj_mem_ne, adicExp_inv P ha_mem_ne, hadicExp_j, hcount_I]

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
