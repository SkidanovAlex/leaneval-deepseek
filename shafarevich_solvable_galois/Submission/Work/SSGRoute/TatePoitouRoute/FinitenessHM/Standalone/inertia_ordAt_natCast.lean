/-!
# The `(p)`-adic order of a rational integer inside the inertia ring

Let `p` be a prime, `Q₀ = (p)` the prime of `𝓞 ℚ` it generates, `Q | Q₀` a prime of `𝓞 K`, and
`ζ ∈ 𝒪_{K_Q}` a Teichmüller lift of a generator of the residue field, so that
`C := ↥(inertiaRing Q0 Q ζ) = 𝒪_E` is the ring of integers of the inertia field `E = ℚ_p(ζ)`.

The inertia field is *unramified* over `ℚ_p`, hence the ideal `𝔭 = (p)` of `C` generated by `p`
(the image of the rational prime) is the maximal ideal of the discrete valuation ring `C`, and the
`𝔭`-adic order of a rational integer is simply its `p`-adic valuation:

`ordAt 𝔭 (n : C) = padicValNat p n`.

This is the "an unramified extension does not change valuations" input used in
`inertia_ordAt_algebraMap` (where `ordAt 𝔭` appears as the factor `e(𝔭/(p)) = 1`).

The proof does not need the different ideal: it is the elementary observation that
`n = p ^ (padicValNat p n) · m` with `p ∤ m`, that `p` generates `𝔭`, and that `m ∉ 𝔭` because any
`m` coprime to `p` is invertible modulo the maximal ideal `𝔭` (Bézout).
-/

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM.Standalone

section OrdAtAux

variable {R : Type*} [CommRing R] [IsDedekindDomain R]

/-- The `P`-adic order of a nonzero element vanishes exactly when the element lies outside `P`.

(For an element of a Dedekind domain, `ordAt P x` is the exponent of `P` in the factorisation of
the principal ideal `(x)`; it is nonzero precisely when `(x) ⊆ P`.) -/
lemma ordAt_eq_zero_iff_notMem (v : IsDedekindDomain.HeightOneSpectrum R) {x : R}
    (hx : x ≠ 0) : ordAt v.asIdeal x = 0 ↔ x ∉ v.asIdeal := by
  constructor
  · intro h0 hmem
    have h1 : (1 : ℕ) ≤ ordAt v.asIdeal x :=
      (mem_pow_iff_le_ordAt v hx 1).mp (by rwa [pow_one])
    omega
  · intro hmem
    by_contra h0
    have h1 : (1 : ℕ) ≤ ordAt v.asIdeal x := Nat.one_le_iff_ne_zero.mpr h0
    have h2 : x ∈ v.asIdeal ^ 1 := (mem_pow_iff_le_ordAt v hx 1).mpr h1
    rw [pow_one] at h2
    exact hmem h2

/-- A generator of a maximal principal ideal has `P`-adic order `1`: it is a uniformiser for the
discrete valuation attached to `P`. -/
lemma ordAt_span_singleton_eq_one {x : R} (hx : x ≠ 0)
    (hmax : (Ideal.span ({x} : Set R)).IsMaximal) :
    ordAt (Ideal.span ({x} : Set R)) x = 1 := by
  have hprime : (Ideal.span ({x} : Set R)).IsPrime := hmax.isPrime
  have hbot : (Ideal.span ({x} : Set R)) ≠ ⊥ := fun h =>
    hx (Ideal.span_singleton_eq_bot.mp h)
  let v : IsDedekindDomain.HeightOneSpectrum R := ⟨Ideal.span {x}, hprime, hbot⟩
  have hv : v.asIdeal = Ideal.span ({x} : Set R) := rfl
  change ordAt v.asIdeal x = 1
  refine le_antisymm ?_ ?_
  · -- `x ∉ P ^ 2`, so `ordAt P x ≤ 1`
    by_contra hle
    have h2le : 2 ≤ ordAt v.asIdeal x := by omega
    have h2 : x ∈ v.asIdeal ^ 2 := (mem_pow_iff_le_ordAt v hx 2).mpr h2le
    rw [hv, Ideal.span_singleton_pow, Ideal.mem_span_singleton] at h2
    obtain ⟨c, hc⟩ := h2
    have hxc : x * (x * c) = x := by
      rw [← mul_assoc, ← pow_two]
      exact hc.symm
    have h1 : x * (1 - x * c) = 0 := by rw [mul_sub, mul_one, hxc, sub_self]
    have h0 : 1 - x * c = 0 := (mul_eq_zero.mp h1).resolve_left hx
    have hone : (1 : R) = x * c := sub_eq_zero.mp h0
    have hmem : (1 : R) ∈ Ideal.span ({x} : Set R) :=
      Ideal.mem_span_singleton.mpr ⟨c, hone⟩
    exact hmax.ne_top ((Ideal.eq_top_iff_one (Ideal.span ({x} : Set R))).mpr hmem)
  · -- `x ∈ P`
    have hmem : x ∈ v.asIdeal ^ 1 := by
      rw [hv, pow_one]
      exact Ideal.mem_span_singleton_self x
    exact (mem_pow_iff_le_ordAt v hx 1).mp hmem

end OrdAtAux

/-- **Bezout in a maximal ideal.**  If a rational prime `p` lies in a maximal ideal `𝔭` of a
commutative ring `A`, then the image of any natural number `m` coprime to `p` lies outside `𝔭`:
`1 = a·p + b·m` with `p, m ∈ 𝔭` would force `1 ∈ 𝔭`, i.e. `𝔭 = ⊤`. -/
lemma natCast_notMem_of_not_dvd {A : Type*} [CommRing A] {𝔭 : Ideal A} (hmax : 𝔭.IsMaximal)
    (p : ℕ) [Fact p.Prime] (hp : (p : A) ∈ 𝔭) {m : ℕ} (hm : ¬ p ∣ m) : (m : A) ∉ 𝔭 := by
  intro hmem
  have hcop : p.Coprime m := (Fact.out : p.Prime).coprime_iff_not_dvd.mpr hm
  have hgcd : p.gcd m = 1 := Nat.coprime_iff_gcd_eq_one.mp hcop
  have hbez : p.gcdA m * (p : ℤ) + p.gcdB m * (m : ℤ) = 1 := by
    have h := Nat.gcd_eq_gcd_ab p m
    rw [hgcd] at h
    norm_num at h
    linarith
  have hbezA : (p.gcdA m : A) * (p : A) + (p.gcdB m : A) * (m : A) = 1 := by
    have h := congrArg (fun z : ℤ => (z : A)) hbez
    push_cast at h
    simpa using h
  have h1 : (1 : A) ∈ 𝔭 := by
    have hsum : (p.gcdA m : A) * (p : A) + (p.gcdB m : A) * (m : A) ∈ 𝔭 :=
      𝔭.add_mem (Ideal.mul_mem_left 𝔭 (p.gcdA m : A) hp)
        (Ideal.mul_mem_left 𝔭 (p.gcdB m : A) hmem)
    rwa [hbezA] at hsum
  exact hmax.ne_top ((Ideal.eq_top_iff_one 𝔭).mpr h1)

/-- The `p`-power times the `p`-coprime part of a nonzero natural number. -/
lemma exists_eq_pow_padicValNat_mul_not_dvd (p : ℕ) [Fact p.Prime] {n : ℕ} (hn : n ≠ 0) :
    ∃ m : ℕ, n = p ^ (padicValNat p n) * m ∧ ¬ p ∣ m :=
  ⟨Nat.divMaxPow n p, (Nat.pow_padicValNat_mul_divMaxPow p n).symm,
    Nat.not_dvd_divMaxPow (Fact.out : p.Prime).one_lt hn⟩

/-- **The `p`-adic valuation of a rational integer inside a `p`-adic ring.**

Let `A` be a Dedekind domain of characteristic zero in which the rational prime `p` generates a
maximal ideal `𝔭 = (p)` (e.g. the valuation ring of an unramified extension of `ℚ_p`).  Then for
`n ≠ 0`, the `𝔭`-adic order of the image of `n` in `A` is the `p`-adic valuation of `n`. -/
lemma ordAt_natCast_eq_padicValNat {A : Type*} [CommRing A] [IsDedekindDomain A] [CharZero A]
    (p : ℕ) [Fact p.Prime] {𝔭 : Ideal A} (h𝔭 : 𝔭 = Ideal.span ({(p : A)} : Set A))
    (hmax : 𝔭.IsMaximal) (n : ℕ) (hn : n ≠ 0) :
    ordAt 𝔭 (n : A) = padicValNat p n := by
  classical
  have hp : p.Prime := Fact.out
  have hp0 : (p : A) ≠ 0 := Nat.cast_ne_zero.mpr hp.ne_zero
  have hpmem : (p : A) ∈ 𝔭 := h𝔭 ▸ Ideal.mem_span_singleton_self _
  have hbot : 𝔭 ≠ ⊥ := fun h => hp0 (Ideal.mem_bot.mp (by rw [← h]; exact hpmem))
  let v : IsDedekindDomain.HeightOneSpectrum A := ⟨𝔭, hmax.isPrime, hbot⟩
  have hv : v.asIdeal = 𝔭 := rfl
  have hv' : v.asIdeal = Ideal.span ({(p : A)} : Set A) := by rw [hv, h𝔭]
  -- `p` is a uniformiser
  have hpord : ordAt v.asIdeal (p : A) = 1 := by
    rw [hv']
    exact ordAt_span_singleton_eq_one hp0 (hv' ▸ hmax)
  -- decompose `n`
  obtain ⟨m, hnm, hpm⟩ := exists_eq_pow_padicValNat_mul_not_dvd p hn
  have hm_notmem : (m : A) ∉ v.asIdeal := by
    rw [hv]
    exact natCast_notMem_of_not_dvd hmax p hpmem hpm
  have hm0 : (m : A) ≠ 0 := fun h => hm_notmem (by rw [h]; exact Ideal.zero_mem v.asIdeal)
  have hmord : ordAt v.asIdeal (m : A) = 0 :=
    (ordAt_eq_zero_iff_notMem v hm0).mpr hm_notmem
  have hcast : (n : A) = (p : A) ^ (padicValNat p n) * (m : A) := by
    rw [← Nat.cast_pow, ← Nat.cast_mul, ← hnm]
  change ordAt v.asIdeal (n : A) = padicValNat p n
  rw [hcast, ordAt_mul v (pow_ne_zero _ hp0) hm0, ordAt_pow v hp0 (padicValNat p n), hpord,
    hmord, mul_one, add_zero]

theorem inertia_ordAt_natCast {K : Type*} [Field K] [NumberField K] (p : ℕ) [Fact p.Prime]
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hQ0 : Q0.asIdeal = Ideal.span
      ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ)))
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
    (ζ : Q.adicCompletionIntegers K)
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K)
      (Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1))
    (hD : differentIdeal (Q0.adicCompletionIntegers ℚ) ↥(inertiaRing Q0 Q ζ) = ⊤)
    (hmax : (Ideal.span ({(p : ↥(inertiaRing Q0 Q ζ))} : Set ↥(inertiaRing Q0 Q ζ))).IsMaximal)
    (n : ℕ) (hn : n ≠ 0) :
    ordAt (Ideal.span ({(p : ↥(inertiaRing Q0 Q ζ))} : Set ↥(inertiaRing Q0 Q ζ)))
      ((n : ↥(inertiaRing Q0 Q ζ))) = padicValNat p n :=
  ordAt_natCast_eq_padicValNat (A := ↥(inertiaRing Q0 Q ζ)) p rfl hmax n hn

end Work.SSGRoute.TatePoitouRoute.FinitenessHM.Standalone
