/-!
# The derivative of a polynomial, evaluated at an element, as a sum

`f'(x) = Σ_{j < deg f} (j+1)·f.coeff (j+1)·x^j`

This is the decomposition of the derivative that the classical "congruence mod `e`" argument for
the exponent of the different uses: applied to `f = minpoly (𝓞 F) π` of degree `e = [K : F]` with
`π` a uniformiser, the summands `(j+1)·f.coeff (j+1)·π^j` have `P`-adic orders congruent to `j`
modulo `e`, so the order of the sum equals the (uniquely attained) minimum of the orders.
-/

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open Polynomial

/-- The derivative of `f` as a polynomial, expanded in powers of `X`. -/
theorem derivative_eq_sum_C_mul_X_pow {R : Type*} [CommRing R] (f : R[X]) :
    f.derivative = ∑ j ∈ Finset.range f.natDegree,
      C (((j + 1) * f.coeff (j + 1))) * X ^ j := by
  ext n
  rw [Polynomial.coeff_derivative, Polynomial.finset_sum_coeff]
  rw [Finset.sum_eq_single n]
  · rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl]
    ring
  · intro b _ hb
    rw [Polynomial.coeff_C_mul_X_pow, if_neg (Ne.symm hb)]
  · intro hn
    rw [Finset.mem_range] at hn
    rw [Polynomial.coeff_C_mul_X_pow, if_pos rfl,
      Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), mul_zero]

/-- `f'(x)` expanded as a sum in the algebra generated by `x`. -/
theorem aeval_derivative_eq_sum {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]
    (f : R[X]) (x : A) :
    aeval x f.derivative = ∑ j ∈ Finset.range f.natDegree,
      ((j : A) + 1) * algebraMap R A (f.coeff (j + 1)) * x ^ j := by
  rw [derivative_eq_sum_C_mul_X_pow, map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [Polynomial.aeval_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow, map_mul]
  push_cast
  ring

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
