namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open Polynomial

/-- If a finite `F`-algebra `A` is generated as an `F`-algebra by a single element `x` that is a
root of a monic polynomial `g ∈ F[X]`, then `A` has `F`-dimension at most the degree of `g`.

The proof exhibits the power basis `1, x, …, x ^ (d-1)` of `A` over `F`, where `d` is the degree of
the minimal polynomial of `x`; since `g` is monic and annihilates `x`, that degree is at most the
degree of `g`. -/
theorem finrank_le_natDegree_of_aeval_eq_zero {F A : Type*} [Field F] [CommRing A] [Algebra F A]
    [Module.Finite F A] {g : Polynomial F} (hg : g.Monic) {x : A}
    (hx : Polynomial.aeval x g = 0) (hgen : Algebra.adjoin F ({x} : Set A) = ⊤) :
    Module.finrank F A ≤ g.natDegree := by
  have hint : IsIntegral F x := ⟨g, hg, hx⟩
  -- `A` is generated by the integral element `x`, so it has the power basis
  -- `1, x, …, x ^ (minpoly F x).natDegree - 1` over `F`.
  have hfr : Module.finrank F A =
      (PowerBasis.ofAdjoinEqTop (K := F) (S := A) hint hgen).dim :=
    PowerBasis.finrank _
  have hdim : (PowerBasis.ofAdjoinEqTop (K := F) (S := A) hint hgen).dim =
      (minpoly F x).natDegree :=
    PowerBasis.ofAdjoinEqTop_dim hint hgen
  rw [hfr, hdim]
  -- The minimal polynomial has degree at most that of any monic annihilator.
  exact Polynomial.natDegree_le_natDegree (minpoly.min F x hg hx)

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
