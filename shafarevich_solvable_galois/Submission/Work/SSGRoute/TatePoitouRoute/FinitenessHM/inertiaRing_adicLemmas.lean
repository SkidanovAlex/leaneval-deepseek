/-!
# Auxiliary lemmas about the `p`-adic completion of `ℚ` and `K`

Collected here are the three elementary ingredients used by
`Work.SSGRoute.TatePoitouRoute.FinitenessHM.inertiaRing_span_p_isMaximal`:

* the maximal ideal of `𝒪_{ℚ_p}` is generated by `p`;
* the natural number `#κ - 1` (where `κ` is the residue field) is a unit;
* the residue of a primitive `N`-th root of unity of the completion is again primitive.
-/

open IsDedekindDomain

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

variable {K : Type*} [Field K] [NumberField K]

/-- **The maximal ideal of the ring of integers of `ℚ_p` is generated by `p`.**  Here
`Q0` is the height one prime of `𝓞 ℚ` generated by the prime `p`; the completion of `ℚ` at `Q0`
is `ℚ_p` (in the shape `Q0.adicCompletion ℚ`), and `p` is a uniformiser. -/
theorem maximalIdeal_adicCompletionIntegers_rat {p : ℕ} [Fact p.Prime]
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hQ0 : Q0.asIdeal = Ideal.span
      ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ))) :
    IsLocalRing.maximalIdeal (Q0.adicCompletionIntegers ℚ) =
      Ideal.span ({(p : Q0.adicCompletionIntegers ℚ)} : Set (Q0.adicCompletionIntegers ℚ)) := by
  have hmem : (p : NumberField.RingOfIntegers ℚ) ∈ Q0.asIdeal := by
    rw [hQ0]; exact Ideal.mem_span_singleton_self _
  have hp : Nat.Prime p := Fact.out
  have hval : Valued.v (R := Q0.adicCompletion ℚ) (Γ₀ := WithZero (Multiplicative ℤ))
      ((p : Q0.adicCompletionIntegers ℚ) : Q0.adicCompletion ℚ) = WithZero.exp (-1 : ℤ) := by
    have h := Commons.NumberTheory.NumberField.Completion.val_adicCompletion_intCast_eq_padicValInt
      Q0 p hp hmem (p : ℤ) (by exact_mod_cast hp.ne_zero)
    simpa using h
  exact Commons.NumberTheory.NumberField.Completion.maximalIdeal_eq_span_of_valuation_eq_exp_neg_one
    (Valued.v (R := Q0.adicCompletion ℚ) (Γ₀ := WithZero (Multiplicative ℤ))) hval

/-- **`#κ - 1` is a unit of `𝒪_{K_Q}`**, where `κ` is the (finite) residue field. -/
theorem isUnit_card_residueField_sub_one_adicCompletion
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    IsUnit (((Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1) : ℕ) :
      Q.adicCompletionIntegers K) := by
  haveI : Finite (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) :=
    Commons.NumberTheory.NumberField.Completion.finite_residueField_adicCompletion K Q
  exact NK.TameStructureDeep.Tame.isUnit_natCast_card_residueField_sub_one

/-- **The residue of a primitive `N`-th root of unity (with `N` a unit) is primitive.**

This is the statement that reduction is injective on roots of unity of invertible order. -/
theorem isPrimitiveRoot_residue_adicCompletion
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (N : ℕ)
    (hN : IsUnit (N : Q.adicCompletionIntegers K))
    {ζ : Q.adicCompletionIntegers K}
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K) N) :
    IsPrimitiveRoot (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) N := by
  have hpowB : ζ ^ N = 1 := by
    apply ValuationSubring.subtype_injective (Q.adicCompletionIntegers K)
    rw [map_pow, map_one]
    simpa using hζ.pow_eq_one
  refine ⟨?_, ?_⟩
  · rw [← map_pow, hpowB, map_one]
  · intro l hl
    have hmem : ζ ^ l - 1 ∈ IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) := by
      rw [← IsLocalRing.residue_eq_zero_iff, map_sub, map_pow, hl, map_one, sub_self]
    have hpowl : (ζ ^ l) ^ N = 1 := by rw [← pow_mul, mul_comm, pow_mul, hpowB, one_pow]
    have hlB : ζ ^ l = 1 :=
      eq_one_of_pow_eq_one_of_sub_mem_maximalIdeal hN hpowl hmem
    apply hζ.dvd_of_pow_eq_one l
    have h2 : ValuationSubring.subtype (Q.adicCompletionIntegers K) (ζ ^ l) = 1 := by
      rw [hlB, map_one]
    rw [map_pow] at h2
    simpa using h2

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
