/-!
# Turning the target's hypotheses into the completion's vocabulary

The target `differentIdeal_count_le_proved` is stated with an *ideal* `P` of `𝓞 K` and the plain
ideal `(p) ⊆ ℤ`, while the local statements (`adicLocExp_le`, `count_le_adicLocExp`) are stated with
height-one spectra and the prime `(p) ⊆ 𝓞 ℚ`.  This file supplies the dictionary:

* `ratPrime p hp` — the height-one prime of `𝓞 ℚ` generated by the rational prime `p`;
* `ratPrime_asIdeal` — its underlying ideal is `Ideal.span {p}`;
* `spectrumOf` — the height-one spectrum attached to a prime ideal;
* `liesOver_ratPrime` — a prime `P | (p)` of `𝓞 K` lies over `ratPrime p hp`.
-/

open IsDedekindDomain

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open scoped NumberField

noncomputable section

/-- The ideal of `𝓞 ℚ` corresponding to `(p) ⊆ ℤ` under `𝓞 ℚ ≃ ℤ`. -/
noncomputable def ratPrimeIdeal (p : ℕ) : Ideal (NumberField.RingOfIntegers ℚ) :=
  Ideal.comap (Rat.ringOfIntegersEquiv : NumberField.RingOfIntegers ℚ →+* ℤ)
    (Ideal.span ({(p : ℤ)} : Set ℤ))

/-- The height-one prime of `𝓞 ℚ` generated by the rational prime `p`. -/
noncomputable def ratPrime (p : ℕ) (hp : p.Prime) :
    HeightOneSpectrum (NumberField.RingOfIntegers ℚ) :=
  haveI : (Ideal.span ({(p : ℤ)} : Set ℤ)).IsPrime :=
    (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr
      (Nat.prime_iff_prime_int.mp hp)
  ⟨ratPrimeIdeal p,
    by
      rw [ratPrimeIdeal]
      exact inferInstance,
    by
      rw [ratPrimeIdeal]
      intro hbot
      have hmem : (p : NumberField.RingOfIntegers ℚ) ∈
          Ideal.comap (Rat.ringOfIntegersEquiv : NumberField.RingOfIntegers ℚ →+* ℤ)
            (Ideal.span ({(p : ℤ)} : Set ℤ)) := by
        rw [Ideal.mem_comap, map_natCast]
        exact Ideal.mem_span_singleton_self _
      rw [hbot] at hmem
      exact absurd (Ideal.mem_bot.mp hmem) (Nat.cast_ne_zero.mpr hp.ne_zero)⟩

@[simp]
lemma ratPrime_asIdeal_eq (p : ℕ) (hp : p.Prime) : (ratPrime p hp).asIdeal = ratPrimeIdeal p := rfl

/-- `p` belongs to `ratPrime p hp`. -/
lemma ratPrime_mem (p : ℕ) (hp : p.Prime) :
    (p : NumberField.RingOfIntegers ℚ) ∈ (ratPrime p hp).asIdeal := by
  rw [ratPrime_asIdeal_eq, ratPrimeIdeal, Ideal.mem_comap, map_natCast]
  exact Ideal.mem_span_singleton_self _

/-- The underlying ideal of `ratPrime p hp` is generated by `p`. -/
lemma ratPrime_asIdeal (p : ℕ) (hp : p.Prime) :
    (ratPrime p hp).asIdeal =
      Ideal.span ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ)) :=
  Commons.NumberTheory.NumberField.Completion.asIdeal_eq_span_prime _ p hp (ratPrime_mem p hp)

/-- The height-one spectrum attached to a nonzero prime ideal. -/
noncomputable def spectrumOf {R : Type*} [CommRing R] {P : Ideal R} (hP : P.IsPrime) (h0 : P ≠ ⊥) :
    HeightOneSpectrum R :=
  ⟨P, hP, h0⟩

@[simp]
lemma spectrumOf_asIdeal {R : Type*} [CommRing R] {P : Ideal R} (hP : P.IsPrime) (h0 : P ≠ ⊥) :
    (spectrumOf hP h0).asIdeal = P := rfl

/-- A prime `P` of `𝓞 K` lying over `(p) ⊆ ℤ` lies over `(p) ⊆ 𝓞 ℚ`. -/
lemma liesOver_ratPrime {K : Type*} [Field K] [NumberField K] (p : ℕ) (hp : p.Prime)
    (P : Ideal (NumberField.RingOfIntegers K)) (hP : P.IsPrime)
    (h0 : P ≠ ⊥) (hlies : P.LiesOver (Ideal.span ({(p : ℤ)} : Set ℤ))) :
    P.LiesOver (ratPrime p hp).asIdeal := by
  haveI : P.IsPrime := hP
  have hprime : (Ideal.under (NumberField.RingOfIntegers ℚ) P).IsPrime := inferInstance
  have hnebot : Ideal.under (NumberField.RingOfIntegers ℚ) P ≠ ⊥ :=
    Ideal.under_ne_bot (NumberField.RingOfIntegers ℚ) h0
  have hmem : (p : NumberField.RingOfIntegers ℚ) ∈
      Ideal.under (NumberField.RingOfIntegers ℚ) P := by
    have h1 : (Ideal.under (NumberField.RingOfIntegers ℚ) P).under ℤ =
        Ideal.span ({(p : ℤ)} : Set ℤ) := by
      rw [Ideal.under_under, hlies.over]
    have h2 : (algebraMap ℤ (NumberField.RingOfIntegers ℚ)) (p : ℤ) ∈
        Ideal.under (NumberField.RingOfIntegers ℚ) P := by
      have h3 : (p : ℤ) ∈ (Ideal.under (NumberField.RingOfIntegers ℚ) P).under ℤ := by
        rw [h1]
        exact Ideal.mem_span_singleton_self _
      exact Ideal.mem_comap.mp h3
    simpa using h2
  have hspan := Commons.NumberTheory.NumberField.Completion.asIdeal_eq_span_prime
    (spectrumOf hprime hnebot) p hp hmem
  rw [ratPrime_asIdeal]
  exact ⟨hspan.symm⟩

end

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
