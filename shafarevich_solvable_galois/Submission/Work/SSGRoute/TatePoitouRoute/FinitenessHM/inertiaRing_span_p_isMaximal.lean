/-!
# `p` generates the maximal ideal of the inertia ring `𝒪_E`

Let `p` be a prime, `Q₀ = (p)` the prime of `𝓞 ℚ` it generates, `K` a number field and `Q | Q₀` a
prime of `𝓞 K`.  Write `L := Q.adicCompletion K` for the `Q`-adic completion, `B := 𝒪_L`, and let
`ζ ∈ B` be a primitive `(#κ - 1)`-st root of unity, where `κ` is the residue field of `B`.  Then
`E := ℚ_p(ζ)` is the inertia (maximal unramified) subextension of `L/ℚ_p` and `C := 𝒪_E` is a local
Dedekind domain (a DVR) whose maximal ideal is generated by `p`.

The main point is that `E/ℚ_p` is *unramified*; equivalently, the relative different of
`C/ℤ_p` is trivial.  We obtain this here by exhibiting `E = ℚ_p[ζ]` and applying the conductor
identity: with `f = minpoly ℤ_p ζ` one has `𝔠(ℤ_p[ζ]) · 𝔡_{C/ℤ_p} = (f'(ζ))`, and `f'(ζ)` is a unit
because `f ∣ X^N - 1` with `N` coprime to `p`, so that `N·ζ^{N-1} = f'(ζ)·g(ζ)` is a unit.

The final step uses the (independently proved) facts that `𝒪_E` is a local ring and that its
maximal ideal is generated by `p` once the relative different is trivial
(`Work.SSGRoute.Finiteness.inertiaRingLocal`).
-/

open IsDedekindDomain
open Work.SSGRoute.TatePoitouRoute.FinitenessHM

set_option maxHeartbeats 1600000
set_option synthInstance.maxHeartbeats 800000

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

noncomputable section

variable {K : Type*} [Field K] [NumberField K]
variable (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
variable (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
variable (ζ : Q.adicCompletionIntegers K)

/-- The image of `ζ` in the inertia ring `𝒪_E`. -/
def zetaInInertia : ↥(inertiaRing Q0 Q ζ) :=
  ⟨⟨liftElem Q ζ, IntermediateField.subset_adjoin (Q0.adicCompletion ℚ) _ (Set.mem_singleton _)⟩,
    (isIntegral_algHom_iff
      (IsScalarTower.toAlgHom (Q0.adicCompletionIntegers ℚ) ↥(inertiaField Q0 Q ζ) (Q.adicCompletion K))
      (fun _ _ h => Subtype.ext h)).mp
      ((Algebra.IsIntegral.isIntegral (R := Q0.adicCompletionIntegers ℚ) ζ).map
        (IsScalarTower.toAlgHom (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K)
          (Q.adicCompletion K)))⟩

lemma inertiaMap_zetaInInertia : inertiaMap Q0 Q ζ (zetaInInertia Q0 Q ζ) = ζ := by
  apply ValuationSubring.subtype_injective (Q.adicCompletionIntegers K)
  show ((inertiaMap Q0 Q ζ (zetaInInertia Q0 Q ζ) : Q.adicCompletionIntegers K) : Q.adicCompletion K) =
    ((ζ : Q.adicCompletionIntegers K) : Q.adicCompletion K)
  rw [inertiaMap_apply]
  rfl

lemma algebraMap_zetaInInertia :
    algebraMap ↥(inertiaRing Q0 Q ζ) ↥(inertiaField Q0 Q ζ) (zetaInInertia Q0 Q ζ) =
      (⟨liftElem Q ζ,
        IntermediateField.subset_adjoin (Q0.adicCompletion ℚ) _ (Set.mem_singleton _)⟩ :
        ↥(inertiaField Q0 Q ζ)) := rfl

/-- `E = ℚ_p[ζ]`, so that the monogenic hypothesis of the conductor lemma holds. -/
lemma adjoin_zetaInInertia_eq_top :
    Algebra.adjoin (Q0.adicCompletion ℚ)
      {algebraMap ↥(inertiaRing Q0 Q ζ) ↥(inertiaField Q0 Q ζ) (zetaInInertia Q0 Q ζ)} = ⊤ := by
  rw [algebraMap_zetaInInertia]
  apply Subalgebra.map_injective
    (f := IsScalarTower.toAlgHom (Q0.adicCompletion ℚ) ↥(inertiaField Q0 Q ζ) (Q.adicCompletion K))
    (fun _ _ h => Subtype.ext h)
  have hrange : (IsScalarTower.toAlgHom (Q0.adicCompletion ℚ) ↥(inertiaField Q0 Q ζ)
      (Q.adicCompletion K)).range = (inertiaField Q0 Q ζ).toSubalgebra := by
    ext x
    rw [AlgHom.mem_range, IntermediateField.mem_toSubalgebra]
    exact ⟨fun ⟨y, hy⟩ => hy ▸ y.2, fun hx => ⟨⟨x, hx⟩, rfl⟩⟩
  have hf : (IsScalarTower.toAlgHom (Q0.adicCompletion ℚ) ↥(inertiaField Q0 Q ζ)
      (Q.adicCompletion K))
      (⟨liftElem Q ζ,
        IntermediateField.subset_adjoin (Q0.adicCompletion ℚ) _ (Set.mem_singleton _)⟩ :
        ↥(inertiaField Q0 Q ζ)) = liftElem Q ζ := rfl
  rw [Algebra.map_top, hrange, AlgHom.map_adjoin, Set.image_singleton, hf]
  exact (IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (F := Q0.adicCompletion ℚ)
    (α := liftElem Q ζ) (IsAlgebraic.of_finite _ _)).symm

/-- If `x` is an integral element of a domain satisfying `x ^ N = 1`, with `(N : S) * x ^ (N - 1)`
a unit, then the derivative of the minimal polynomial of `x` over an integrally closed base takes a
unit value at `x`. -/
theorem isUnit_aeval_derivative_minpoly_of_dvd {A S : Type*} [CommRing A] [IsDomain A]
    [IsIntegrallyClosed A] [CommRing S] [IsDomain S] [Algebra A S] [Module.IsTorsionFree A S]
    (x : S) (hx : IsIntegral A x) (N : ℕ) (hxN : x ^ N = 1)
    (hunit : IsUnit ((N : S) * x ^ (N - 1))) :
    IsUnit ((Polynomial.aeval x) (Polynomial.derivative (minpoly A x))) := by
  have hdvd : minpoly A x ∣ (Polynomial.X ^ N - 1 : Polynomial A) := by
    refine minpoly.isIntegrallyClosed_dvd hx ?_
    rw [Polynomial.aeval_sub, Polynomial.aeval_one, Polynomial.aeval_X_pow, hxN, sub_self]
  obtain ⟨h, hh⟩ := hdvd
  have hderiv : Polynomial.derivative (Polynomial.X ^ N - 1 : Polynomial A)
      = Polynomial.derivative (minpoly A x) * h + minpoly A x * Polynomial.derivative h := by
    rw [hh, Polynomial.derivative_mul]
  have hval : (N : S) * x ^ (N - 1)
      = (Polynomial.aeval x) (Polynomial.derivative (minpoly A x)) * (Polynomial.aeval x) h := by
    have h1 : (Polynomial.aeval x) (Polynomial.derivative (Polynomial.X ^ N - 1 : Polynomial A))
        = (Polynomial.aeval x) (Polynomial.derivative (minpoly A x) * h
            + minpoly A x * Polynomial.derivative h) := by rw [hderiv]
    rw [map_add, map_mul, map_mul, minpoly.aeval, zero_mul, add_zero] at h1
    rw [← h1]
    rw [Polynomial.derivative_sub, Polynomial.derivative_one, sub_zero,
      Polynomial.derivative_X_pow, Polynomial.aeval_mul, Polynomial.aeval_C,
      Polynomial.aeval_X_pow]
    simp
  exact isUnit_of_mul_isUnit (hval ▸ hunit)

/-- **`p` generates the maximal ideal of the inertia ring.**  The ideal `(p)` of `𝒪_E` is maximal
and it is the unique maximal ideal: `𝒪_E` is a local ring whose maximal ideal is `p·𝒪_E`. -/
theorem inertiaRing_span_p_isMaximal {K : Type*} [Field K] [NumberField K] (p : ℕ)
    [Fact p.Prime]
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hQ0 : Q0.asIdeal = Ideal.span
      ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ)))
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
    (ζ : Q.adicCompletionIntegers K)
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K)
      (Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1))
    (hfin : Module.finrank (Q0.adicCompletion ℚ) ↥(inertiaField Q0 Q ζ) =
      Q.asIdeal.inertiaDeg (NumberField.RingOfIntegers ℚ)) :
    (Ideal.span ({(p : ↥(inertiaRing Q0 Q ζ))} : Set ↥(inertiaRing Q0 Q ζ))).IsMaximal ∧
      ∀ 𝔪 : Ideal ↥(inertiaRing Q0 Q ζ), 𝔪.IsMaximal →
        𝔪 = Ideal.span ({(p : ↥(inertiaRing Q0 Q ζ))} : Set ↥(inertiaRing Q0 Q ζ)) := by
  classical
  set N : ℕ := Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1 with hNdef
  have hζpowB : ζ ^ N = 1 := by
    apply ValuationSubring.subtype_injective (Q.adicCompletionIntegers K)
    rw [map_pow, map_one]
    simpa using hζ.pow_eq_one
  have hNpos : 0 < N := by
    rw [hNdef]
    haveI : Fintype (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) := by
      haveI : Finite (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) :=
        Commons.NumberTheory.NumberField.Completion.finite_residueField_adicCompletion K Q
      exact Fintype.ofFinite _
    have h2 : 2 ≤ Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) := by
      rw [Nat.card_eq_fintype_card]
      exact Nat.succ_le_of_lt Fintype.one_lt_card
    omega
  have hNunitB : IsUnit (N : Q.adicCompletionIntegers K) := by
    rw [hNdef]; exact isUnit_card_residueField_sub_one_adicCompletion Q
  have hNunitC : IsUnit (N : ↥(inertiaRing Q0 Q ζ)) :=
    (Work.SSGRoute.Finiteness.inertiaRing_isUnit_iff Q0 Q ζ _).mpr
      (by rw [map_natCast (inertiaMap Q0 Q ζ) N]; exact hNunitB)
  have hζCpow : zetaInInertia Q0 Q ζ ^ N = 1 := by
    apply inertiaMap_injective Q0 Q ζ
    rw [map_pow, map_one, inertiaMap_zetaInInertia, hζpowB]
  have hζCunit : IsUnit (zetaInInertia Q0 Q ζ) :=
    isUnit_of_mul_isUnit (a := zetaInInertia Q0 Q ζ) (b := zetaInInertia Q0 Q ζ ^ (N - 1)) (by
      rw [← pow_succ', Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hNpos.ne'), hζCpow]
      exact isUnit_one)
  -- the relative different of the inertia ring over `ℤ_p` is trivial
  have hdiff : differentIdeal (Q0.adicCompletionIntegers ℚ) ↥(inertiaRing Q0 Q ζ) = ⊤ := by
    have hcond := conductor_mul_differentIdeal (A := Q0.adicCompletionIntegers ℚ)
      (K := Q0.adicCompletion ℚ) (L := ↥(inertiaField Q0 Q ζ)) (B := ↥(inertiaRing Q0 Q ζ))
      (zetaInInertia Q0 Q ζ) (adjoin_zetaInInertia_eq_top Q0 Q ζ)
    have hunit := isUnit_aeval_derivative_minpoly_of_dvd (A := Q0.adicCompletionIntegers ℚ)
      (S := ↥(inertiaRing Q0 Q ζ)) (zetaInInertia Q0 Q ζ)
      (IsIntegralClosure.isIntegral (Q0.adicCompletionIntegers ℚ) ↥(inertiaField Q0 Q ζ)
        (zetaInInertia Q0 Q ζ)) N hζCpow
      (IsUnit.mul hNunitC (hζCunit.pow (N - 1)))
    rw [Ideal.span_singleton_eq_top.mpr hunit] at hcond
    have hcondtop : conductor (Q0.adicCompletionIntegers ℚ) (zetaInInertia Q0 Q ζ) = ⊤ :=
      le_antisymm le_top (hcond ▸ Ideal.mul_le_left)
    rw [hcondtop, Ideal.top_mul] at hcond
    exact hcond
  haveI hIL : IsLocalRing ↥(inertiaRing Q0 Q ζ) :=
    Work.SSGRoute.Finiteness.inertiaRing_isLocalRing Q0 Q ζ
  have hspan := Work.SSGRoute.Finiteness.inertiaRing_maximalIdeal_eq_span_p (p := p) Q0 Q ζ hQ0 hdiff
  refine ⟨hspan ▸ IsLocalRing.maximalIdeal.isMaximal ↥(inertiaRing Q0 Q ζ), fun 𝔪 h𝔪 => ?_⟩
  rw [← hspan]
  exact IsLocalRing.eq_maximalIdeal h𝔪

end

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
