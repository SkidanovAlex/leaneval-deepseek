/-!
# The unramified extension of `ℚ_p` of degree `f`, via a cyclotomic generator

Let `p` be prime, `f > 0` and `Q0` the prime of `𝓞 ℚ = ℤ` generated by `p`.  We produce a finite
extension `M / ℚ_p` (where `ℚ_p = Q0.adicCompletion ℚ`) of degree exactly `f` containing a
primitive `(p ^ f - 1)`-st root of unity `w`.

This is the classical fact that `ℚ_p(ζ_{p^f - 1})` is the **unramified** extension of `ℚ_p` of
degree `f`: its residue field is `𝔽_{p^f}`, whose multiplicative group is cyclic of order
`p^f - 1`, and the Teichmüller lift of a generator of `𝔽_{p^f}^×` is a primitive `(p^f - 1)`-st
root of unity generating the (unique) unramified extension of degree `f`.

Formal route:

* `exists_unramified_extension_of_inertiaDeg` produces a number field `L / ℚ` and a prime `q | Q0`
  with `e(q|Q0) = 1`, `f(q|Q0) = f` and `[L : ℚ] = f`;
* `finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg` gives `[L_q : ℚ_p] = e · f = f`;
* `exists_isPrimitiveRoot_lift_adicCompletionB` produces a unit `ζ` of `q.adicCompletionIntegers L`
  which is a primitive `(#κ - 1)`-st root of unity (Teichmüller lift of a generator of the residue
  field's unit group);
* `natCard_residueField_adicCompletion_eq_pow_inertiaDeg` (for the base `ℚ` and the base prime `Q0`)
  together with `residueCard_adicCompletionIntegers_rat` computes `#κ = p ^ f`, so the order of `ζ`
  is `p ^ f - 1`.
-/

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

set_option linter.style.haveILetI false

theorem exists_cyclotomic_completion_finrank (p f : ℕ) [Fact p.Prime] (hf : 0 < f)
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hQ0 : Q0.asIdeal = Ideal.span
      ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ))) :
    ∃ (M : Type) (_ : Field M) (_ : Algebra (Q0.adicCompletion ℚ) M)
      (_ : FiniteDimensional (Q0.adicCompletion ℚ) M) (w : M),
      IsPrimitiveRoot w (p ^ f - 1) ∧
      Module.finrank (Q0.adicCompletion ℚ) M = f := by
  classical
  have hp : p.Prime := Fact.out
  have hmem : (p : NumberField.RingOfIntegers ℚ) ∈ Q0.asIdeal := by
    rw [hQ0]; exact Ideal.mem_span_singleton_self _
  obtain ⟨L, hLf, hLnf, hLalg, q, hq, he, hfdeg, _hfr⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_unramified_extension_of_inertiaDeg Q0 f hf
  letI : Algebra ℚ L := hLalg
  letI : Algebra (Q0.adicCompletion ℚ) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q0 q hq)
  haveI hfmod : Module.Finite (Q0.adicCompletion ℚ) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q0 q hq
  obtain ⟨ζ, hζ, -⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_isPrimitiveRoot_lift_adicCompletionB
      (K := ℚ) (L := L) Q0 q hq
  have hcard : Nat.card (IsLocalRing.ResidueField (q.adicCompletionIntegers L)) = p ^ f := by
    have h1 : Nat.card (IsLocalRing.ResidueField (q.adicCompletionIntegers L)) =
        (Nat.card (IsLocalRing.ResidueField (Q0.adicCompletionIntegers ℚ))) ^
          (q.asIdeal.inertiaDeg (NumberField.RingOfIntegers ℚ)) :=
      Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletion_eq_pow_inertiaDeg
        ℚ L Q0 q hq
    have h2 : Nat.card (IsLocalRing.ResidueField (Q0.adicCompletionIntegers ℚ)) = p :=
      Commons.NumberTheory.NumberField.Completion.residueCard_adicCompletionIntegers_rat
        Q0 p hp hmem
    rw [h1, h2, hfdeg]
  have hfinrank : Module.finrank (Q0.adicCompletion ℚ) (q.adicCompletion L) = f := by
    have h := Commons.NumberTheory.NumberField.Completion.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
      (K := ℚ) (L := L) Q0 q hq
    rw [he, one_mul, hfdeg] at h
    exact h.symm
  rw [hcard] at hζ
  exact ⟨q.adicCompletion L, inferInstance, inferInstance, hfmod,
    (ζ : q.adicCompletion L), hζ, hfinrank⟩

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
