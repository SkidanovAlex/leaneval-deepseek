/-!
# The residue field of the completion at a prime is generated by the residue of a primitive
root of unity

Main result: `Work.SSGRoute.TatePoitouRoute.FinitenessHM.residueField_pow_generated_by_residue`.

Let `K` be a number field, `Q` a nonzero prime of `𝓞 K`, `Q0` a prime of `𝓞 ℚ` below it, and let
`O_Q = Q.adicCompletionIntegers K` be the valuation ring of the `Q`-adic completion `K_Q` of `K`,
with residue field `κ_Q` and maximal ideal `𝔪_Q`.  Then `κ_Q` is a finite field, of cardinality
`q = p ^ f` where `p = char κ_Q` (`Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K))`).

If `ζ ∈ O_Q` is a root of unity of order `q - 1 = |κ_Qˣ|`, then its residue generates `κ_Qˣ`:
every nonzero `y : κ_Q` is a power of `residue ζ`.

Note that the hypothesis is on `ζ` itself, *not* on `residue ζ`: the content is that `q - 1 = p^f - 1`
is prime to `p = char κ_Q`, hence `q - 1` is a *unit* of `O_Q`, and reduction is injective on the
`(q - 1)`-st roots of unity (`eq_one_of_pow_eq_one_of_residue_eq_one` below, the classical
geometric-sum argument `(x - 1) * ∑_{i<N} x^i = x^N - 1 = 0`).  Consequently `residue ζ` has order
`q - 1 = |κ_Qˣ|`, so it generates, and every nonzero element of `κ_Q` satisfies `y ^ (q - 1) = 1`.

The two ingredients used below are stated for an arbitrary local ring:
`eq_one_of_pow_eq_one_of_residue_eq_one` and `isPrimitiveRoot_residue_of_isUnit`.
-/

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

/-- **Roots of unity of unit order reduce injectively.**  If `N` is a unit of a local ring `R`, if
`x ^ N = 1` and `residue x = 1`, then `x = 1`.

Indeed `(x - 1) * ∑_{i < N} x ^ i = x ^ N - 1 = 0`, while `∑_{i < N} x ^ i` reduces to `N`, a unit
of the residue field because `N` is a unit of `R`; hence `∑_{i < N} x ^ i` is a unit of `R` and
`x - 1 = 0`. -/
theorem eq_one_of_pow_eq_one_of_residue_eq_one {R : Type*} [CommRing R] [IsLocalRing R]
    {N : ℕ} (hN : IsUnit (N : R)) {x : R} (hxpow : x ^ N = 1)
    (hx : IsLocalRing.residue R x = 1) : x = 1 := by
  have hS : IsUnit (∑ i ∈ Finset.range N, x ^ i) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
    have hres : IsLocalRing.residue R (∑ i ∈ Finset.range N, x ^ i) =
        (N : IsLocalRing.ResidueField R) := by
      rw [map_sum]
      simp only [map_pow, hx, one_pow]
      simp
    rw [hres]
    exact (RingHom.isUnit_map (IsLocalRing.residue R) hN).ne_zero
  have hmul : (x - 1) * (∑ i ∈ Finset.range N, x ^ i) = 0 := by
    rw [mul_geom_sum, hxpow, sub_self]
  exact sub_eq_zero.mp ((IsUnit.mul_left_eq_zero hS).mp hmul)

/-- **A primitive `N`-th root of unity of unit order reduces to a primitive `N`-th root of unity.**
If `N` is a unit of the local ring `R` and `ζ ∈ R` is a primitive `N`-th root of unity, then
`residue ζ` is a primitive `N`-th root of unity of the residue field. -/
theorem isPrimitiveRoot_residue_of_isUnit {R : Type*} [CommRing R] [IsLocalRing R]
    {N : ℕ} (hN : IsUnit (N : R)) {ζ : R} (hζ : IsPrimitiveRoot ζ N) :
    IsPrimitiveRoot (IsLocalRing.residue R ζ) N := by
  refine ⟨by rw [← map_pow, hζ.pow_eq_one, map_one], fun l hl => ?_⟩
  refine hζ.dvd_of_pow_eq_one l ?_
  refine eq_one_of_pow_eq_one_of_residue_eq_one hN ?_ (by rw [map_pow, hl])
  rw [← pow_mul, mul_comm, pow_mul, hζ.pow_eq_one, one_pow]

/-- **The residue field of the `Q`-adic completion is generated by the residue of a primitive
root of unity of order `|κ_Q| - 1`.**  See the module docstring. -/
theorem residueField_pow_generated_by_residue {K : Type*} [Field K] [NumberField K]
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
    (ζ : Q.adicCompletionIntegers K)
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K)
      (Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1)) :
    ∀ y : IsLocalRing.ResidueField (Q.adicCompletionIntegers K), y ≠ 0 →
      ∃ j : ℕ, y = (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) ^ j := by
  classical
  -- the residue field of the completion is the finite residue field `𝓞 K ⧸ Q`
  set κ := IsLocalRing.ResidueField (Q.adicCompletionIntegers K) with hκ
  haveI hfin : Finite κ := by
    rw [hκ]
    exact Commons.NumberTheory.NumberField.Completion.finite_residueField_adicCompletion K Q
  haveI : Fintype κ := Fintype.ofFinite κ
  -- `N = q - 1`, the order of `κˣ`
  set N : ℕ := Nat.card κ - 1 with hN
  have hcard0 : (Nat.card κ : κ) = 0 := by
    rw [Nat.card_eq_fintype_card]
    exact FiniteField.cast_card_eq_zero κ
  have h1 : 1 ≤ Nat.card κ := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.card_pos
  -- `q - 1` is prime to `char κ = p`, so that `(q - 1 : O_Q)` is a unit: its residue is `-1`
  have hu : IsUnit (N : Q.adicCompletionIntegers K) := by
    rw [← IsLocalRing.residue_ne_zero_iff_isUnit, map_natCast]
    have hcast : (N : κ) = -1 := by
      rw [hN, Nat.cast_sub h1, hcard0, Nat.cast_one, zero_sub]
    rw [hcast]
    simp
  -- `ζ`, viewed in the ring of integers `O_Q`, is a primitive `N`-th root of unity
  have hζ' : IsPrimitiveRoot (ζ : Q.adicCompletion K) N := hζ
  have hζR : IsPrimitiveRoot ζ N :=
    (IsPrimitiveRoot.coe_submonoidClass_iff (N := Q.adicCompletionIntegers K) (ζ := ζ)).mp hζ'
  -- hence so is its residue
  have hresprim : IsPrimitiveRoot (IsLocalRing.residue (Q.adicCompletionIntegers K) ζ) N :=
    isPrimitiveRoot_residue_of_isUnit hu hζR
  have h2 : 1 < Nat.card κ := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  haveI : NeZero N := ⟨by rw [hN]; omega⟩
  -- every nonzero element of `κ` satisfies `y ^ (q - 1) = 1`, so is a power of a primitive root
  intro y hy
  have hpow : y ^ N = 1 := by
    rw [hN, Nat.card_eq_fintype_card]
    exact FiniteField.pow_card_sub_one_eq_one y hy
  obtain ⟨i, -, hi⟩ := hresprim.eq_pow_of_pow_eq_one hpow
  exact ⟨i, hi.symm⟩

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
