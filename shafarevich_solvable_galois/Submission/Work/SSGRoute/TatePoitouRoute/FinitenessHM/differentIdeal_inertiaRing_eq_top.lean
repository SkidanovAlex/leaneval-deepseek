open IsDedekindDomain

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open scoped NumberField WithZero

noncomputable section

/-- **The different ideal of the inertia ring over `ℤ_p` is trivial.**

Let `p` be a prime, `Q₀ = (p)` the corresponding prime of `𝓞 ℚ`, `Q | Q₀` a prime of `𝓞 K` for a
number field `K`, and `ζ ∈ 𝒪_{K_Q}` a primitive `(q - 1)`-st root of unity where `q = |κ_Q|` is the
cardinality of the residue field of the `Q`-adic completion.  Then the inertia ring
`C = 𝒪_E` of `E = ℚ_p(ζ)` satisfies `differentIdeal ℤ_p C = ⊤`.

The proof is the derivative / conductor argument: `E = ℚ_p(ζ)` is generated by the root of unity
`ζ` of order `N = q - 1`, `p ∤ N`, so `N` is a *unit* of `ℤ_p` and `ζ` is a unit of `C`.  Hence
`N · ζ^{N-1}` is a unit of `C` and, since `minpoly ℤ_p ζ ∣ X^N - 1`, the derivative
`(minpoly ℤ_p ζ)'(ζ)` is a unit of `C`; by `aeval_derivative_mem_differentIdeal` it lies in the
different, which is therefore `⊤`. -/
theorem differentIdeal_inertiaRing_eq_top {K : Type*} [Field K] [NumberField K] (p : ℕ)
    [Fact p.Prime]
    (Q0 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (hQ0 : Q0.asIdeal = Ideal.span
      ({(p : NumberField.RingOfIntegers ℚ)} : Set (NumberField.RingOfIntegers ℚ)))
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    [hQ : Q.asIdeal.LiesOver Q0.asIdeal]
    (ζ : Q.adicCompletionIntegers K)
    (hζ : IsPrimitiveRoot (ζ : Q.adicCompletion K)
      (Nat.card (IsLocalRing.ResidueField (Q.adicCompletionIntegers K)) - 1)) :
    differentIdeal (Q0.adicCompletionIntegers ℚ) ↥(inertiaRing Q0 Q ζ) = ⊤ := by
  classical
  haveI hcz : CharZero (Q.adicCompletion K) :=
    Commons.NumberTheory.NumberField.charZero_adicCompletion Q
  let ℚp := Q0.adicCompletion ℚ
  let ℤp := Q0.adicCompletionIntegers ℚ
  let M := Q.adicCompletion K
  let B := Q.adicCompletionIntegers K
  let E := inertiaField Q0 Q ζ
  let C := inertiaRing Q0 Q ζ
  haveI hIC2 : IsIntegralClosure C ℤp E := inferInstance
  haveI hIC : IsIntegralClosure B ℤp M := inferInstance
  have hmemA : (p : 𝓞 ℚ) ∈ Q0.asIdeal := by
    rw [hQ0]; exact Ideal.mem_span_singleton_self _
  have hcard : Nat.card (IsLocalRing.ResidueField B) = p ^ Q.asIdeal.inertiaDeg (𝓞 ℚ) :=
    Commons.NumberTheory.NumberField.Completion.card_residueField_adicCompletionIntegers_eq_pow_inertiaDeg
      Q0 p (Fact.out) hmemA K Q hQ
  let N : ℕ := Nat.card (IsLocalRing.ResidueField B) - 1
  have hfpos : 0 < Q.asIdeal.inertiaDeg (𝓞 ℚ) := Q.asIdeal.inertiaDeg_pos (𝓞 ℚ)
  have hp1 : 1 < p := (Fact.out : p.Prime).one_lt
  have hNpos : 0 < N := by
    show 0 < Nat.card (IsLocalRing.ResidueField B) - 1
    rw [hcard]
    have hlt : 1 < p ^ Q.asIdeal.inertiaDeg (𝓞 ℚ) := one_lt_pow₀ hp1 hfpos.ne'
    omega
  have hpN : ¬ p ∣ N := by
    show ¬ p ∣ Nat.card (IsLocalRing.ResidueField B) - 1
    rw [hcard]
    intro h
    have hle : 1 ≤ p ^ Q.asIdeal.inertiaDeg (𝓞 ℚ) := one_le_pow₀ (Fact.out : p.Prime).one_le
    have hint : ((((p ^ Q.asIdeal.inertiaDeg (𝓞 ℚ) - 1 : ℕ)) : ℤ) : ZMod p) = 0 := by
      rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
      exact_mod_cast h
    have hd : (((p ^ Q.asIdeal.inertiaDeg (𝓞 ℚ) - 1 : ℕ)) : ZMod p) = 0 := by
      simpa using hint
    rw [Nat.cast_sub hle, Nat.cast_pow, ZMod.natCast_self, zero_pow hfpos.ne', zero_sub] at hd
    have h1 : (1 : ZMod p) = 0 := by simpa using neg_eq_zero.mp hd
    exact one_ne_zero h1
  -- ## `N` is a unit of `ℤp`
  have hNval : Valued.v (R := ℚp) (Γ₀ := WithZero (Multiplicative ℤ)) ((N : ℕ) : ℚp) = 1 := by
    have h : Valued.v (R := ℚp) (Γ₀ := WithZero (Multiplicative ℤ))
        (((N : ℤ) : ℚ) : ℚp) = WithZero.exp (-(padicValInt p (N : ℤ) : ℤ)) :=
      Commons.NumberTheory.NumberField.Completion.val_adicCompletion_intCast_eq_padicValInt
        Q0 p (Fact.out) hmemA (N : ℤ) (by exact_mod_cast hNpos.ne')
    rw [padicValInt.of_nat, padicValNat.eq_zero_of_not_dvd hpN,
      Nat.cast_zero, neg_zero, WithZero.exp_zero] at h
    rwa [show (((N : ℤ) : ℚ) : ℚp) = ((N : ℕ) : ℚp) by push_cast; ring] at h
  have hNunitℤp : IsUnit ((N : ℕ) : ℤp) := by
    rw [IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers.isUnit_iff_valued_eq_one]
    rwa [show (((N : ℕ) : ℤp) : ℚp) = ((N : ℕ) : ℚp) by simp]
  have hNunitC : IsUnit ((N : ℕ) : C) := by
    have h : IsUnit (algebraMap ℤp C ((N : ℕ) : ℤp)) := hNunitℤp.map (algebraMap ℤp C)
    rwa [map_natCast] at h
  -- ## `ζ` as an element of `E` and of `C`
  have hζE : liftElem Q ζ ∈ E := by
    show liftElem Q ζ ∈ IntermediateField.adjoin ℚp {liftElem Q ζ}
    exact IntermediateField.mem_adjoin_simple_self ℚp _
  let ζE : E := ⟨liftElem Q ζ, hζE⟩
  have hζEeq : (algebraMap ↥E M) ζE = ((ζ : B) : M) := rfl
  have hζEpow : ζE ^ N = 1 := by
    apply Subtype.ext
    exact hζ.pow_eq_one
  have hζEint : IsIntegral ℤp ζE :=
    (isIntegral_algebraMap_iff (A := ↥E) (B := M)).mp (by
      rw [hζEeq]
      exact (IsIntegralClosure.isIntegral ℤp M ζ).map (IsScalarTower.toAlgHom ℤp B M))
  have hζCmem : ζE ∈ C := by
    show ζE ∈ integralClosure ℤp ↥E
    rw [mem_integralClosure_iff]
    exact hζEint
  let ζC : C := ⟨ζE, hζCmem⟩
  have hζCeq : (algebraMap ↥C ↥E) ζC = ζE := rfl
  have hζCpow : ζC ^ N = 1 := by
    apply Subtype.ext
    apply Subtype.ext
    exact hζ.pow_eq_one
  have hζunitC : IsUnit ζC := by
    refine ⟨⟨ζC, ζC ^ (N - 1), ?_, ?_⟩, rfl⟩
    · rw [← pow_succ', Nat.sub_add_cancel hNpos, hζCpow]
    · rw [← pow_succ, Nat.sub_add_cancel hNpos, hζCpow]
  have hunit_prod : IsUnit (((N : ℕ) : C) * ζC ^ (N - 1)) :=
    IsUnit.mul hNunitC (hζunitC.pow (N - 1))
  have hderiv_unit : IsUnit ((Polynomial.aeval ζC) (Polynomial.derivative (minpoly ℤp ζC))) :=
    isUnit_aeval_derivative_minpoly_of_pow_eq_one (A := ℤp) (S := C) (x := ζC)
      (IsIntegralClosure.isIntegral ℤp E ζC) N hζCpow hunit_prod
  -- ## `ζ` generates `C` over `ℤp` (in the sense of `E = ℚ_p(ζ)`)
  have hgen : Algebra.adjoin ℚp {(algebraMap C E) ζC} = ⊤ := by
    rw [show (algebraMap C E) ζC = ζE from hζCeq]
    rw [← IntermediateField.adjoin_simple_eq_top_iff_of_isAlgebraic (F := ℚp)
      (IsAlgebraic.of_finite ℚp ζE)]
    rw [eq_top_iff]
    intro y _
    have hmap : E ≤ (IntermediateField.adjoin ℚp ({ζE} : Set ↥E)).map
        (IsScalarTower.toAlgHom ℚp ↥E M) := by
      show IntermediateField.adjoin ℚp {((ζ : B) : M)} ≤ _
      rw [IntermediateField.adjoin_le_iff]
      intro z hz'
      rw [Set.mem_singleton_iff] at hz'
      rw [hz']
      exact ⟨ζE, IntermediateField.mem_adjoin_simple_self ℚp ζE, hζEeq⟩
    obtain ⟨z, hzmem, hzy⟩ := hmap (show ((algebraMap ↥E M) y) ∈ (E : Set M) from y.2)
    rw [show z = y from (algebraMap ↥E M).injective hzy] at hzmem
    exact hzmem
  -- ## the derivative lies in the different, hence the different is `⊤`
  have hdiffmem : (Polynomial.aeval ζC) (Polynomial.derivative (minpoly ℤp ζC)) ∈
      differentIdeal ℤp C :=
    aeval_derivative_mem_differentIdeal ℤp ℚp ↥E ζC hgen
  have hdiff : differentIdeal ℤp C = ⊤ := by
    rw [eq_top_iff]
    intro y _
    obtain ⟨u, hu⟩ := hderiv_unit
    have hy : y = (y * ↑u⁻¹) * (Polynomial.aeval ζC) (Polynomial.derivative (minpoly ℤp ζC)) := by
      rw [← hu, mul_assoc, Units.inv_mul, mul_one]
    rw [hy]
    exact Ideal.mul_mem_left _ _ hdiffmem
  exact hdiff

end

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
