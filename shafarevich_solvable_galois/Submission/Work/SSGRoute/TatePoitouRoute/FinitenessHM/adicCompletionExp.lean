/-!
# The exponent of a prime in the different of the `P`-adic completion

For a number field `K`, a rational prime `p` and a prime `Q` of `𝓞 K` over `(p)`, let
`Q₀` be the prime of `𝓞 ℚ ≃ ℤ` generated by `p`.  The completion `L := Q.adicCompletion K` is a
finite extension of `ℚ_p := Q₀.adicCompletion ℚ`, with ring of integers
`𝒪_L := Q.adicCompletionIntegers K` (a DVR), and the *local different* is

`differentIdeal (Q₀.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K)`,

an ideal of the DVR `𝒪_L`, i.e. a power of the maximal ideal `𝔪_L`.

`adicLocExp Q₀ Q hQ` is the exponent of `𝔪_L` in it.

The classical local bound — the one that is *true* for the completion, unlike the localisation
`𝓞 K_P / ℤ_(p)` of `localizationExp.lean` (see
`NOTE_completion_route_and_locExp_flaw.md`) — is

`adicLocExp Q₀ Q hQ ≤ e * (1 + e * v_p(e)),   e = e(Q/p) = Q.asIdeal.ramificationIdx (𝓞 ℚ)`,

which is the local half of the target `count_P(𝓡_{K/ℤ}) ≤ e(1+e·v_p(e))`.  The other half is the
trace comparison `count_P(𝓡_{K/ℤ}) ≤ adicLocExp Q₀ Q hQ`.
-/

open IsDedekindDomain

namespace Work.SSGRoute.TatePoitouRoute.FinitenessHM

open scoped NumberField

noncomputable section

variable {K : Type*} [Field K] [NumberField K]

/-- The natural map `Q₀.adicCompletionIntegers ℚ →+* Q.adicCompletionIntegers K` is injective. -/
lemma adicCompletionMapIntegers_injective
    (Q0 : HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (Q : HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hQ : Q.asIdeal.LiesOver Q0.asIdeal) :
    Function.Injective
      (Commons.NumberTheory.NumberField.Completion.adicCompletionMapIntegers Q0 Q hQ) := by
  have hsub : Function.Injective ((Q0.adicCompletionIntegers ℚ).subtype :
      Q0.adicCompletionIntegers ℚ → Q0.adicCompletion ℚ) := Subtype.coe_injective
  have hinjcomp : Function.Injective
      ((Commons.RingTheory.Henselian.adicCompletionMap Q0 Q hQ).comp
        (Q0.adicCompletionIntegers ℚ).subtype) :=
    (Commons.NumberTheory.NumberField.Completion.adicCompletionMap_injective Q0 Q hQ).comp hsub
  intro a b hab
  refine hinjcomp ?_
  exact congrArg (fun z : Q.adicCompletionIntegers K => (z : Q.adicCompletion K)) hab

/-- **The local exponent of the different at `P`**, computed in the `P`-adic completion:
the exponent of the maximal ideal in the relative different of
`Q.adicCompletionIntegers K` over `Q0.adicCompletionIntegers ℚ`. -/
noncomputable def adicLocExp
    (Q0 : HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (Q : HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hQ : Q.asIdeal.LiesOver Q0.asIdeal) : ℕ :=
  letI : Algebra (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K) :=
    RingHom.toAlgebra
      (Commons.NumberTheory.NumberField.Completion.adicCompletionMapIntegers Q0 Q hQ)
  have hinjAlg : Function.Injective
      (algebraMap (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K)) := by
    intro a b hab
    refine adicCompletionMapIntegers_injective Q0 Q hQ ?_
    have h1 : (algebraMap (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K)) a =
        (algebraMap (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K)) b := hab
    rwa [RingHom.algebraMap_toAlgebra] at h1
  haveI : Module.IsTorsionFree (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K) :=
    Module.IsTorsionFree.of_smul_eq_zero fun r m h => by
      by_cases hr : r = 0
      · exact Or.inl hr
      · refine Or.inr ?_
        have h1 : algebraMap (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K) r * m = 0 := by
          rwa [Algebra.smul_def] at h
        rcases mul_eq_zero.mp h1 with h2 | h2
        · exact absurd (hinjAlg (by rw [h2, map_zero])) hr
        · exact h2
  (UniqueFactorizationMonoid.normalizedFactors
      (differentIdeal (Q0.adicCompletionIntegers ℚ) (Q.adicCompletionIntegers K))).count
    (IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K))

end

end Work.SSGRoute.TatePoitouRoute.FinitenessHM
