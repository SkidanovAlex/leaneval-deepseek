namespace Work.SSGRoute.EscapeCoreLib

open scoped nonZeroDivisors

/-- The `𝔭`-adic valuation `val_𝔭` of a principal fractional ideal generated by a unit `x : Kˣ` is
additive on products: `val_𝔭((a · γ⁻¹)) = val_𝔭((a)) - val_𝔭((γ))`. -/
theorem count_spanSingleton_mul_inv {K : Type} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (a γ : Kˣ) :
    FractionalIdeal.count K 𝔭
        (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
          ((a * γ⁻¹ : Kˣ) : K))
      = FractionalIdeal.count K 𝔭
          (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K))
        - FractionalIdeal.count K 𝔭
          (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K)) (γ : K)) := by
  have hval : ((a * γ⁻¹ : Kˣ) : K) = (a : K) * ((γ : K))⁻¹ := by
    rw [Units.val_mul, Units.val_inv_eq_inv_val]
  have hne_a : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
      (a : K) ≠ 0 := by
    rw [FractionalIdeal.spanSingleton_ne_zero_iff]; exact Units.ne_zero a
  have hne_ginv : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
      ((γ : K))⁻¹ ≠ 0 := by
    rw [FractionalIdeal.spanSingleton_ne_zero_iff]; exact inv_ne_zero (Units.ne_zero γ)
  have hγinv : FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
        ((γ : K))⁻¹
      = (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
          (γ : K))⁻¹ :=
    (FractionalIdeal.spanSingleton_inv K (γ : K)).symm
  calc
    FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
        (nonZeroDivisors (NumberField.RingOfIntegers K)) ((a * γ⁻¹ : Kˣ) : K))
        = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) ((a : K) * ((γ : K))⁻¹)) := by
          rw [hval]
    _ = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K) *
          FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
            ((γ : K))⁻¹) := by
          rw [FractionalIdeal.spanSingleton_mul_spanSingleton]
    _ = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K)) +
        FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) ((γ : K))⁻¹) :=
          FractionalIdeal.count_mul K 𝔭 hne_a hne_ginv
    _ = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K)) +
        FractionalIdeal.count K 𝔭 ((FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (γ : K))⁻¹) := by
          rw [hγinv]
    _ = FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (a : K)) -
        FractionalIdeal.count K 𝔭 (FractionalIdeal.spanSingleton
            (nonZeroDivisors (NumberField.RingOfIntegers K)) (γ : K)) := by
          rw [FractionalIdeal.count_inv]; ring

end Work.SSGRoute.EscapeCoreLib
