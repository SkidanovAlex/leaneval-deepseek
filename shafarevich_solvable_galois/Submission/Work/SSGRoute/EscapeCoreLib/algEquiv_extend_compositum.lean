/-!
# Extending an automorphism of `M` over `↥K` that fixes `M ⊓ N` pointwise

This module proves the Galois-theoretic input of the Čebotarev step of the Grünwald-with-escape
node (`Work.SSGRoute.grunwald_escape_relative`).

**The problem solved here.**  Let `L / k` be a finite Galois extension of number fields,
`K ≤ L` an intermediate field, `M, N ≤ L` intermediate fields that are Galois over `↥K`, and let
`α : Gal(M/↥K)` fix `M ⊓ N` pointwise.  Then `α` extends to an automorphism `g ∈ Gal(L/↥K)` of `L`
that fixes `N` pointwise.

In the escape construction this is what makes the orthogonality `Art(𝔡)|_{M ⊓ N} = 1` usable: it
produces an element `τ ∈ G_k` with `τ|_M = Art(𝔡)^{-1}` and `τ|_N = 1`, so that
`Work.SSGRoute.exists_isFrobAtPrime_notMem_density`, applied over the base `k` to `L`, produces the
escape place `Q` — automatically completely split in `N`, because `τ|_N = 1`.  (Since
`α ∈ Gal(M/↥K)` fixes `↥K`, the prescribed Frobenius fixes `K` pointwise, so the `k`-prime produced
by Čebotarev has residue degree `1` and the Frobenius of the `K`-prime below it in `M/↥K` is
literally `τ|_M` — no power of `τ` appears.)  In particular `M` is **not** required to be Galois
over `k`.

## Proof

Let `G = Gal(L/↥K)`, `H_M = Gal(L/M)`, `H_N = Gal(L/N)`.  Because `M/↥K` and `N/↥K` are Galois,
`H_M ⊴ Gal(L/↥K)`... rather, `H_N ⊴ G`, and the Galois correspondence (applied in the finite Galois
extension `L/↥K`) gives

`Gal(L/(M ⊓ N)) = ⟨H_M, H_N⟩`,

because `fixedField (H_M ⊔ H_N) = fixedField H_M ⊓ fixedField H_N = M ⊓ N`.  Restriction
`Gal(L/↥K) → Gal(M/↥K)` is surjective (`AlgEquiv.restrictNormalHom_surjective`), so `α` lifts to
`g₀ ∈ G`; and `g₀` fixes `M ⊓ N` pointwise (it acts as `α` on `M`, and `α` fixes `M ⊓ N` by
hypothesis).  Hence `g₀ ∈ H_N ⊔ H_M` and, since `H_N ⊴ G`, `g₀ = n * m` with `n ∈ H_N`, `m ∈ H_M`
(`Subgroup.mem_sup_of_normal_left`).  Then `n` fixes `N` pointwise and
`(restrictNormalHom M) n = (restrictNormalHom M) g₀ · ((restrictNormalHom M) m)⁻¹ = α`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

namespace Work.SSGRoute.EscapeCoreLib

/-- **Extending an automorphism of `M` over `↥K` that fixes `M ⊓ N` pointwise**, inside a finite
Galois extension `L / k`. -/
theorem exists_algEquiv_restrict_eq_of_fixing
    {K L : Type} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (M : IntermediateField K L) [FiniteDimensional K M] [IsGalois K M]
    (N : IntermediateField K L) [FiniteDimensional K N] [IsGalois K N]
    (α : ↥M ≃ₐ[K] ↥M)
    (hαfix : ∀ x : ↥M, ((x : L) ∈ N) → ((α x : ↥M) : L) = (x : L)) :
    ∃ g : L ≃ₐ[K] L,
      (∀ x : ↥M, g (x : L) = ((α x : ↥M) : L)) ∧ (∀ x ∈ N, g x = x) := by
  classical
  -- the fixing subgroups of `M` and of `N` in `Gal(L/K)`
  haveI hNn : N.fixingSubgroup.Normal := inferInstance
  -- the Galois correspondence: the fixing subgroup of the intersection is generated by the two
  have hff : IntermediateField.fixedField
        (M.fixingSubgroup ⊔ N.fixingSubgroup) = M ⊓ N := by
    have hff' : IntermediateField.fixedField (M.fixingSubgroup ⊔ N.fixingSubgroup)
        = IntermediateField.fixedField M.fixingSubgroup ⊓
          IntermediateField.fixedField N.fixingSubgroup := by
      refine le_antisymm ?_ ?_
      · exact le_inf (IntermediateField.fixedField_le le_sup_left)
          (IntermediateField.fixedField_le le_sup_right)
      · rw [IntermediateField.le_iff_le]
        refine sup_le ?_ ?_
        · exact le_trans ((IntermediateField.le_iff_le M.fixingSubgroup
              (IntermediateField.fixedField M.fixingSubgroup)).mp le_rfl)
            (IntermediateField.fixingSubgroup_le inf_le_left)
        · exact le_trans ((IntermediateField.le_iff_le N.fixingSubgroup
              (IntermediateField.fixedField N.fixingSubgroup)).mp le_rfl)
            (IntermediateField.fixingSubgroup_le inf_le_right)
    rw [hff', IsGalois.fixedField_fixingSubgroup M, IsGalois.fixedField_fixingSubgroup N]
  have hcorr : (M ⊓ N).fixingSubgroup = M.fixingSubgroup ⊔ N.fixingSubgroup := by
    rw [← hff, IntermediateField.fixingSubgroup_fixedField]
  -- a lift of `α` to `Gal(L/↥K)`
  have hsurj : Function.Surjective (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M) :=
    AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := ↥M) (E := L)
  obtain ⟨g₀, hg₀⟩ := hsurj α
  -- `g₀` fixes `M ⊓ N`
  have hfix : g₀ ∈ (M ⊓ N).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have h1 : (((AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M) g₀) ⟨x, hx.1⟩ : L) = g₀ x :=
      AlgEquiv.restrictNormalHom_apply M g₀ ⟨x, hx.1⟩
    rw [← h1, hg₀]
    exact hαfix ⟨x, hx.1⟩ hx.2
  -- so `g₀ = n * m` with `n` fixing `N` and `m` fixing `M`
  have hmem : g₀ ∈ N.fixingSubgroup ⊔ M.fixingSubgroup := by
    rw [sup_comm, ← hcorr]; exact hfix
  obtain ⟨n, hn, m, hm, hnm⟩ := Subgroup.mem_sup_of_normal_left.mp hmem
  -- `n` acts as `α` on `M` and fixes `N`
  have hker : (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M).ker = M.fixingSubgroup :=
    IntermediateField.restrictNormalHom_ker M
  have hm1 : AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M m = 1 := by
    rw [← MonoidHom.mem_ker, hker]; exact hm
  have hres : AlgEquiv.restrictNormalHom (F := K) (K₁ := L) ↥M n = α := by
    have hn_eq : n = g₀ * m⁻¹ := by rw [← hnm]; group
    rw [hn_eq, map_mul, map_inv, hm1, hg₀]
    simp
  refine ⟨n, ?_, ?_⟩
  · intro x
    rw [← AlgEquiv.restrictNormalHom_apply M n x, hres]
  · intro x hx
    rw [IntermediateField.mem_fixingSubgroup_iff] at hn
    exact hn x hx

end Work.SSGRoute.EscapeCoreLib
