/-!
# Reading off the subgroup `U · C_K^p`

This module proves the reading-off step for the escape-form Grünwald theorem in the form in which
the orthogonality argument produces it: the class of the idèle of a `T`-free fractional ideal `𝔵`
lies in `U · C_K^p`, where `U = im(Kˣ · E_{T,unr})` is the image of the principal idèles and the
idèles that are local `p`-th powers at `T` and local units outside the places above `T`.

The extra `p`-th power subgroup is harmless for the conclusion: an element of `C_K^p` can be lifted
to an idèle of `K` whose components are local `p`-th powers everywhere and whose `q`-adic
exponents are all divisible by `p` (`lift_pPowSubgroup`), so it contributes nothing to
`localPowClass` at `T` and nothing mod `p` to the `q`-adic exponents.
-/

namespace Work.SSGRoute.EscapeCoreLib

open NumberField
open NK.GlobalCFT

variable {K : Type} [Field K] [NumberField K]

/-- The `q`-adic exponent of an idèle behaves additively with respect to powers. -/
private lemma exp_pow_idele (q : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) (x : Idele K) (n : ℕ) :
    Idele.exp q (x ^ n) = (n : ℤ) * Idele.exp q x := by
  induction n with
  | zero => simp
  | succ n ih => rw [pow_succ, Idele.exp_mul, ih]; push_cast; ring

/-- The components of a power of an idèle. -/
private lemma pow_apply_idele (x : Idele K) (n : ℕ) (v : Place K) :
    (x ^ n) v = (x v) ^ n := by
  rw [← Idele.eval_apply (v := v) (x := x ^ n), map_pow, Idele.eval_apply]

/-- **Lifting the subgroup generated by `p`-th powers of the idèle class group** to the idèle
group, with control of the local classes at a finite set `T` of primes and of all `q`-adic
exponents. -/
private lemma lift_pPowSubgroup (p : ℕ) (T : Finset (NK.Chebotarev.PrimeIdeal K))
    (w : IdeleClassGroup K) (hw : w ∈ pPowSubgroup p (IdeleClassGroup K)) :
    ∃ b : Idele K, IdeleClassGroup.mk K b = w ∧
      (∀ 𝔭 ∈ T, b (Place.ofFinite 𝔭) ∈
        NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p) ∧
      (∀ 𝔮 : NK.Chebotarev.PrimeIdeal K, (p : ℤ) ∣ Idele.exp 𝔮 b) := by
  classical
  have key : ∀ w : IdeleClassGroup K,
      w ∈ Subgroup.closure (Set.range fun g : IdeleClassGroup K => g ^ p) →
      ∃ b : Idele K, IdeleClassGroup.mk K b = w ∧
        (∀ 𝔭 ∈ T, b (Place.ofFinite 𝔭) ∈
          NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p) ∧
        (∀ 𝔮 : NK.Chebotarev.PrimeIdeal K, (p : ℤ) ∣ Idele.exp 𝔮 b) := by
    intro w hw
    refine Subgroup.closure_induction (p := fun w _ => ∃ b : Idele K,
        IdeleClassGroup.mk K b = w ∧
          (∀ 𝔭 ∈ T, b (Place.ofFinite 𝔭) ∈
            NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p) ∧
          (∀ 𝔮 : NK.Chebotarev.PrimeIdeal K, (p : ℤ) ∣ Idele.exp 𝔮 b)) ?_ ?_ ?_ ?_ hw
    · rintro x ⟨g, rfl⟩
      obtain ⟨β, hβ⟩ := IdeleClassGroup.mk_surjective K g
      refine ⟨β ^ p, by rw [map_pow, hβ], ?_, ?_⟩
      · intro 𝔭 _
        rw [NK.UchidaKummer.ellPowSubgroup, MonoidHom.mem_range]
        exact ⟨β (Place.ofFinite 𝔭), by rw [powMonoidHom_apply, pow_apply_idele]⟩
      · intro 𝔮
        rw [exp_pow_idele]
        exact ⟨Idele.exp 𝔮 β, rfl⟩
    · refine ⟨1, ?_, ?_, ?_⟩
      · rw [map_one]
      · intro 𝔭 _
        exact Subgroup.one_mem _
      · intro 𝔮
        rw [Idele.exp_one]
        exact dvd_zero _
    · rintro x y _ _ ⟨b₁, h₁, hT₁, he₁⟩ ⟨b₂, h₂, hT₂, he₂⟩
      refine ⟨b₁ * b₂, ?_, ?_, ?_⟩
      · rw [map_mul, h₁, h₂]
      · intro 𝔭 h𝔭
        rw [Idele.mul_apply]
        exact Subgroup.mul_mem _ (hT₁ 𝔭 h𝔭) (hT₂ 𝔭 h𝔭)
      · intro 𝔮
        rw [Idele.exp_mul]
        exact dvd_add (he₁ 𝔮) (he₂ 𝔮)
    · rintro x _ ⟨b₁, h₁, hT₁, he₁⟩
      refine ⟨b₁⁻¹, ?_, ?_, ?_⟩
      · rw [map_inv, h₁]
      · intro 𝔭 h𝔭
        rw [Idele.inv_apply]
        exact Subgroup.inv_mem _ (hT₁ 𝔭 h𝔭)
      · intro 𝔮
        rw [NK.NUV2.RouteB.RayModulus.exp_inv]
        exact dvd_neg.mpr (he₁ 𝔮)
  exact key w hw

/-- **Local factorisation in the reading-off step.**  If `prin γ * e * b = a` is an idèle
factorisation whose `𝔭`-components at a finite prime are trivial (`a`), a local `p`-th power
(`e`) and a local `p`-th power (`b`), then `γ` is a local `p`-th power at `𝔭`. -/
private lemma localFactorOfMul (p : ℕ) (γ : Kˣ) (a e b : Idele K)
    (𝔭 : NK.Chebotarev.PrimeIdeal K)
    (h : Idele.principalIdele K γ * e * b = a) (ha : a (Place.ofFinite 𝔭) = 1)
    (he : e (Place.ofFinite 𝔭) ∈ NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p)
    (hb : b (Place.ofFinite 𝔭) ∈ NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p) :
    NK.UchidaKummer.localPowClass K p 𝔭 γ = 1 := by
  have hcomp : (Idele.principalIdele K γ) (Place.ofFinite 𝔭)
      * e (Place.ofFinite 𝔭) * b (Place.ofFinite 𝔭) = 1 := by
    rw [← Idele.mul_apply, ← Idele.mul_apply, h, ha]
  have hmem : (Idele.principalIdele K γ) (Place.ofFinite 𝔭) ∈
      NK.UchidaKummer.ellPowSubgroup (𝔭.adicCompletion K) p := by
    have h3 : (Idele.principalIdele K γ) (Place.ofFinite 𝔭) * (e (Place.ofFinite 𝔭) * b (Place.ofFinite 𝔭)) = 1 := by
      rw [← mul_assoc]
      exact hcomp
    have h2 : (Idele.principalIdele K γ) (Place.ofFinite 𝔭) =
        (e (Place.ofFinite 𝔭) * b (Place.ofFinite 𝔭))⁻¹ :=
      eq_inv_of_mul_eq_one_left h3
    rw [h2]
    exact Subgroup.inv_mem _ (Subgroup.mul_mem _ he hb)
  rw [NK.UchidaKummer.localPowClass, MonoidHom.comp_apply, QuotientGroup.mk'_apply,
    QuotientGroup.eq_one_iff]
  simpa [Idele.principalIdele_apply] using hmem

theorem readOffSupPow (p : ℕ) [Fact p.Prime] {K : Type} [Field K] [NumberField K]
    (T : Finset (NK.Chebotarev.PrimeIdeal K))
    (𝔵 : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)
    (h𝔵T : ∀ 𝔭 ∈ T, FractionalIdeal.count K 𝔭 𝔵 = 0)
    (hmem : NK.GlobalCFT.IdeleClassGroup.mk K
        (NK.NUV2.RouteB.RayModulus.fracIdele 𝔵) ∈
      ((NK.GlobalCFT.Idele.principalSubgroup K ⊔ Work.SSGRoute.powTIdeles K p T).map
          (NK.GlobalCFT.IdeleClassGroup.mk K))
        ⊔ Work.SSGRoute.EscapeCoreLib.pPowSubgroup p (NK.GlobalCFT.IdeleClassGroup K)) :
    ∃ γ : Kˣ, (∀ 𝔭 ∈ T, NK.UchidaKummer.localPowClass K p 𝔭 γ = 1) ∧
      ∀ 𝔮 : NK.Chebotarev.PrimeIdeal K,
        (p : ℤ) ∣ FractionalIdeal.count K 𝔮 𝔵
          - FractionalIdeal.count K 𝔮
              (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
                (γ : K)) := by
  classical
  set a : Idele K := NK.NUV2.RouteB.RayModulus.fracIdele 𝔵 with hadef
  -- decompose the class of `𝔵` as `u · w` with `u ∈ U` and `w` a product of `p`-th powers
  obtain ⟨u, hu, w, hw, huw⟩ := Subgroup.mem_sup.mp hmem
  obtain ⟨y, hy, hyu⟩ := Subgroup.mem_map.mp hu
  obtain ⟨p₁, hp₁, e, he, hp₁e⟩ := Subgroup.mem_sup.mp hy
  obtain ⟨γ₀, hγ₀⟩ := Idele.mem_principalSubgroup.mp hp₁
  have hprincipal : IdeleClassGroup.mk K (Idele.principalIdele K γ₀ * e) = u := by
    rw [map_mul, hγ₀, ← map_mul, hp₁e, hyu]
  -- lift the `p`-th power part
  obtain ⟨b, hb, hbT, hbexp⟩ := lift_pPowSubgroup p T w hw
  have hprod : IdeleClassGroup.mk K (Idele.principalIdele K γ₀ * e * b)
      = IdeleClassGroup.mk K a := by
    rw [map_mul, hprincipal, hb, huw]
  -- the quotient by the principal subgroup
  have hker : Idele.principalIdele K γ₀ * e * b * a⁻¹ ∈ Idele.principalSubgroup K := by
    rw [← Work.SSGRoute.ker_mk_eq_principal, MonoidHom.mem_ker, map_mul, hprod, map_inv,
      mul_inv_cancel]
  obtain ⟨δ, hδ⟩ := Idele.mem_principalSubgroup.mp hker
  have hEq : Idele.principalIdele K (δ⁻¹ * γ₀) * e * b = a := by
    have h₁ : Idele.principalIdele K δ * a = Idele.principalIdele K γ₀ * e * b := by
      rw [hδ]
      group
    calc Idele.principalIdele K (δ⁻¹ * γ₀) * e * b
        = (Idele.principalIdele K δ)⁻¹ * (Idele.principalIdele K δ * a) := by
          rw [map_mul, map_inv, h₁]
          group
      _ = a := by group
  refine ⟨δ⁻¹ * γ₀, ?_, ?_⟩
  · -- the local `p`-th power condition at `T`
    intro 𝔭 h𝔭
    refine localFactorOfMul p (δ⁻¹ * γ₀) a e b 𝔭 hEq ?_ ?_ ?_
    · rw [hadef, Work.SSGRoute.fracIdele_apply_ofFinite, h𝔵T 𝔭 h𝔭, zpow_zero]
    · exact (Work.SSGRoute.mem_powTIdeles.mp he).1 𝔭 h𝔭
    · exact hbT 𝔭 h𝔭
  · -- the `q`-adic exponents differ by a `p`-th power
    intro 𝔮
    have hγexp : FractionalIdeal.count K 𝔮
        (FractionalIdeal.spanSingleton (nonZeroDivisors (𝓞 K)) ((δ⁻¹ * γ₀ : Kˣ) : K))
        = Idele.exp 𝔮 (Idele.principalIdele K (δ⁻¹ * γ₀)) := by
      rw [← Idele.idealOf_principalIdele, Idele.count_idealOf]
    have haexp : Idele.exp 𝔮 a = FractionalIdeal.count K 𝔮 𝔵 := by
      rw [hadef]
      exact IdeleClassGroup.exp_ideleOfFun (fun q => FractionalIdeal.count K q 𝔵)
        (FractionalIdeal.finite_factors 𝔵) 𝔮
    have hsum : Idele.exp 𝔮 a = Idele.exp 𝔮 (Idele.principalIdele K (δ⁻¹ * γ₀))
        + Idele.exp 𝔮 e + Idele.exp 𝔮 b := by
      have h := congrArg (Idele.exp 𝔮) hEq
      simp only [Idele.exp_mul] at h
      exact h.symm
    have he_div : (p : ℤ) ∣ Idele.exp 𝔮 e := by
      by_cases h𝔮 : 𝔮 ∈ T
      · exact Work.SSGRoute.dvd_exp_of_mem_ellPowSubgroup p 𝔮 e
          ((Work.SSGRoute.mem_powTIdeles.mp he).1 𝔮 h𝔮)
      · rw [(NK.NUV2.RouteB.RayModulus.mem_localUnits_iff_exp_eq_zero 𝔮 e).mp
          ((Work.SSGRoute.mem_powTIdeles.mp he).2 (Place.ofFinite 𝔮)
            (fun hcon => h𝔮 (hcon 𝔮 rfl)))]
        exact dvd_zero _
    rw [hγexp, ← haexp, hsum]
    have hsub : Idele.exp 𝔮 (Idele.principalIdele K (δ⁻¹ * γ₀)) + Idele.exp 𝔮 e
        + Idele.exp 𝔮 b - Idele.exp 𝔮 (Idele.principalIdele K (δ⁻¹ * γ₀))
        = Idele.exp 𝔮 e + Idele.exp 𝔮 b := by
      ring
    rw [hsub]
    exact dvd_add he_div (hbexp 𝔮)

end Work.SSGRoute.EscapeCoreLib
