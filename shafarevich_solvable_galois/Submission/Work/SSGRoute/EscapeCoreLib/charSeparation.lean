/-!
# Separation of points by characters into `ZMod p`

A finite abelian group of exponent `p` is a vector space over `ZMod p`; hence an element `x` of such
a group lies in a subgroup `H` if and only if every homomorphism to `ZMod p` that kills `H` kills
`x`, because the nonzero elements of finite-dimensional `ZMod p`-vector spaces are separated by
linear functionals.

This is the step which turns "every character of `C_K/(U·N)` vanishes on `x`" into the membership
`x ∈ U·N·(p-th powers)` in the orthogonality argument of Grünwald-with-escape; the `p`-th powers
are needed because `C_K/U` itself is *not* of exponent `p` in general (only the part coming from
the class group of `K` modulo the primes of `T` is absorbed by `U`).
-/

namespace Work.SSGRoute.EscapeCoreLib

/-- **A nonzero element of a finite-dimensional vector space is separated by a linear
functional.** -/
theorem exists_dual_apply_ne_zero {p : ℕ} [Fact p.Prime] {Q : Type*} [AddCommGroup Q]
    [Module (ZMod p) Q] [Finite Q] {y : Q} (hy : y ≠ 0) :
    ∃ f : Q →ₗ[ZMod p] ZMod p, f y ≠ 0 :=
  Module.Projective.exists_dual_ne_zero (ZMod p) hy

/-- **Characters separate points modulo a submodule.**  For a finite `ZMod p`-module `A` (i.e. a
finite abelian group of exponent `p`), an element `x` lies in a submodule `H` as soon as every
linear functional that kills `H` kills `x`. -/
theorem mem_of_forall_linearMap_eq_zero {p : ℕ} [Fact p.Prime] {A : Type*} [AddCommGroup A]
    [Module (ZMod p) A] [Finite A] (H : Submodule (ZMod p) A) {x : A}
    (hx : ∀ f : A →ₗ[ZMod p] ZMod p, H ≤ f.ker → f x = 0) : x ∈ H := by
  haveI : Finite (A ⧸ H) := Quotient.finite _
  by_contra hxH
  have hy : ((Submodule.mkQ H) x : A ⧸ H) ≠ 0 := by
    intro h0
    refine hxH ?_
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h0
    exact h0
  obtain ⟨f, hf⟩ := exists_dual_apply_ne_zero (p := p) hy
  have hker : H ≤ (f.comp (Submodule.mkQ H)).ker := by
    intro h hh
    rw [LinearMap.mem_ker, LinearMap.comp_apply]
    have h0 : ((Submodule.mkQ H) h : A ⧸ H) = 0 := by
      rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
      exact hh
    rw [h0, map_zero]
  have hzero : (f.comp (Submodule.mkQ H)) x = 0 := hx _ hker
  refine hf ?_
  simpa [LinearMap.comp_apply] using hzero


/-- **The subgroup generated by the `p`-th powers** of a group. -/
def pPowSubgroup (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure (Set.range fun g : G => g ^ p)

@[simp] theorem mem_pPowSubgroup {p : ℕ} {G : Type*} [Group G] {x : G} :
    x ∈ pPowSubgroup p G ↔ x ∈ Subgroup.closure (Set.range fun g : G => g ^ p) :=
  Iff.rfl

theorem pow_mem_pPowSubgroup {p : ℕ} {G : Type*} [Group G] (g : G) :
    g ^ p ∈ pPowSubgroup p G :=
  Subgroup.subset_closure ⟨g, rfl⟩

