/-!
# The kernel of the level projection and the subgroup generated by the left-nested commutators

The kernel of `flowQuotSucc 2 Gm n 3 3 : Q_{(4,1)} ↠ Q_{(3,3)}` is `γ₃ F(n) · P₄ / P₄`, and the
latter is generated by the classes `lw n w = mkQ n (lcF n w)` of the left-nested commutators
`[[x,y],z]` of triples of generators.  This is the classical statement that the associated graded
`γ₃/γ₄` of the lower central series of a free group is generated by the bracket monomials
(`Work.SSGRoute.prop5.lcs_generated_by_monGrp`), together with the observation that modulo `P₄` the
right-nested commutator `[x,[y,z]]` equals the inverse of the left-nested one `[[y,z],x]`, and
elements of `γ₃` have order `2` modulo `P₄`.
-/

open scoped commutatorElement

noncomputable section

namespace Work.SSGRoute.zz3

open Work.CohomologicalShrinking
open Work.SSGRoute.ZZ3

/-- The subgroup generated by the classes of the left-nested commutators together with `P₄`. -/
def Rsub (n : ℕ) : Subgroup (FF n) :=
  Subgroup.closure (Set.range (lcF n)) ⊔ pSeries 2 (FF n) 4

theorem mem_Rsub_of_mem_closure (n : ℕ) {x : FF n}
    (h : x ∈ Subgroup.closure (Set.range (lcF n))) : x ∈ Rsub n := by
  rw [Rsub]; exact Subgroup.mem_sup_left h

theorem mem_Rsub_of_mem_pSeries (n : ℕ) {x : FF n} (h : x ∈ pSeries 2 (FF n) 4) :
    x ∈ Rsub n := by
  rw [Rsub]; exact Subgroup.mem_sup_right h

theorem tuple3_zero (n : ℕ) (a b c : XX n) : (![a, b, c] : Fin 3 → XX n) 0 = a := rfl
theorem tuple3_one (n : ℕ) (a b c : XX n) : (![a, b, c] : Fin 3 → XX n) 1 = b := rfl
theorem tuple3_two (n : ℕ) (a b c : XX n) : (![a, b, c] : Fin 3 → XX n) 2 = c := rfl

/-! ## The size-`3` binary trees -/

/-- A binary tree with `3` leaves is either `[[x,y],z]` or `[x,[y,z]]`. -/
theorem magma_size_three_cases {X : Type} (c : Work.SSGRoute.prop5.Magma X)
    (hc : Work.SSGRoute.prop5.Magma.size c = 3) :
    (∃ x y z : X, c = Work.SSGRoute.prop5.Magma.mul
        (Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen x)
          (Work.SSGRoute.prop5.Magma.gen y)) (Work.SSGRoute.prop5.Magma.gen z))
    ∨ (∃ x y z : X, c = Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen x)
        (Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen y)
          (Work.SSGRoute.prop5.Magma.gen z))) := by
  rcases c with x | ⟨a, b⟩
  · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc; omega
  · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
    have ha := Work.SSGRoute.prop5.Magma.size_pos a
    have hb := Work.SSGRoute.prop5.Magma.size_pos b
    rcases a with x | ⟨a1, a2⟩
    · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
      rcases b with y | ⟨b1, b2⟩
      · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc; omega
      · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
        have hb1 := Work.SSGRoute.prop5.Magma.size_pos b1
        have hb2 := Work.SSGRoute.prop5.Magma.size_pos b2
        rcases b1 with y | ⟨c1, c2⟩
        · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
          rcases b2 with z | ⟨d1, d2⟩
          · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
            exact Or.inr ⟨x, y, z, rfl⟩
          · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
            have := Work.SSGRoute.prop5.Magma.size_pos d1
            have := Work.SSGRoute.prop5.Magma.size_pos d2
            omega
        · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
          have := Work.SSGRoute.prop5.Magma.size_pos c1
          have := Work.SSGRoute.prop5.Magma.size_pos c2
          omega
    · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
      have ha1 := Work.SSGRoute.prop5.Magma.size_pos a1
      have ha2 := Work.SSGRoute.prop5.Magma.size_pos a2
      rcases a1 with u | ⟨e1, e2⟩
      · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
        rcases a2 with v | ⟨f1, f2⟩
        · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
          rcases b with w | ⟨g1, g2⟩
          · rw [Work.SSGRoute.prop5.Magma.size_gen] at hc
            exact Or.inl ⟨u, v, w, rfl⟩
          · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
            have := Work.SSGRoute.prop5.Magma.size_pos g1
            have := Work.SSGRoute.prop5.Magma.size_pos g2
            omega
        · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
          have := Work.SSGRoute.prop5.Magma.size_pos f1
          have := Work.SSGRoute.prop5.Magma.size_pos f2
          omega
      · rw [Work.SSGRoute.prop5.Magma.size_mul] at hc
        have := Work.SSGRoute.prop5.Magma.size_pos e1
        have := Work.SSGRoute.prop5.Magma.size_pos e2
        omega

/-! ## Generation of `γ₃` modulo `P₄` -/

/-- **`γ₃` is generated by the left-nested commutators of generators, modulo `P₄`.** -/
theorem gamma_three_le_closure_lcF_sup (n : ℕ) : centralSeries (FF n) 3 ≤ Rsub n := by
  have hgen := Work.SSGRoute.prop5.lcs_generated_by_monGrp (XX n) 3
  rw [show centralSeries (FF n) 3 = (⊤ : Subgroup (FF n)).lowerCentralSeries (3 - 1) from rfl,
    hgen]
  rw [show Rsub n = Subgroup.closure (Set.range (lcF n)) ⊔ pSeries 2 (FF n) 4 from rfl]
  refine sup_le ?_ ?_
  · refine (Subgroup.closure_le _).mpr ?_
    rintro y ⟨c, hc, rfl⟩
    rcases magma_size_three_cases c hc with ⟨x, y, z, rfl⟩ | ⟨x, y, z, rfl⟩
    · refine Subgroup.mem_sup_left (Subgroup.subset_closure ⟨![x, y, z], ?_⟩)
      show Work.SSGRoute.prop5.monGrp (XX n)
          (Work.SSGRoute.prop5.Magma.mul
            (Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen x)
              (Work.SSGRoute.prop5.Magma.gen y)) (Work.SSGRoute.prop5.Magma.gen z))
        = lcF n ![x, y, z]
      rw [Work.SSGRoute.prop5.monGrp_mul, Work.SSGRoute.prop5.monGrp_mul,
        Work.SSGRoute.prop5.monGrp_gen, Work.SSGRoute.prop5.monGrp_gen,
        Work.SSGRoute.prop5.monGrp_gen, lcF_eq]
      simp only [tuple3_zero, tuple3_one, tuple3_two]
    · have hmem : lcF n ![y, z, x] ∈ Subgroup.closure (Set.range (lcF n)) :=
        Subgroup.subset_closure ⟨![y, z, x], rfl⟩
      have hmem3 : lcF n ![y, z, x] ∈ pSeries 2 (FF n) 3 := lcF_mem_pSeries_three n _
      have hsq : (lcF n ![y, z, x]) ^ 2 ∈ pSeries 2 (FF n) 4 := sq_mem_pSeries_four n hmem3
      have hsq' : (lcF n ![y, z, x]) ^ 2
          ∈ Subgroup.closure (Set.range (lcF n)) ⊔ pSeries 2 (FF n) 4 :=
        Subgroup.mem_sup_right hsq
      have hinv : (lcF n ![y, z, x])⁻¹
          ∈ Subgroup.closure (Set.range (lcF n)) ⊔ pSeries 2 (FF n) 4 := by
        have h : (lcF n ![y, z, x])⁻¹
            = (lcF n ![y, z, x]) * ((lcF n ![y, z, x]) ^ 2)⁻¹ := by group
        rw [h]
        exact Subgroup.mul_mem _ (Subgroup.mem_sup_left hmem)
          (Subgroup.inv_mem _ hsq')
      have key : Work.SSGRoute.prop5.monGrp (XX n)
            (Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen x)
              (Work.SSGRoute.prop5.Magma.mul (Work.SSGRoute.prop5.Magma.gen y)
                (Work.SSGRoute.prop5.Magma.gen z)))
          = (lcF n ![y, z, x])⁻¹ := by
        rw [Work.SSGRoute.prop5.monGrp_mul, Work.SSGRoute.prop5.monGrp_mul,
          Work.SSGRoute.prop5.monGrp_gen, Work.SSGRoute.prop5.monGrp_gen,
          Work.SSGRoute.prop5.monGrp_gen, lcF_eq]
        simp only [tuple3_zero, tuple3_one, tuple3_two]
        rw [commutatorElement_def, commutatorElement_def]
        group
      rw [key]
      exact hinv
  · intro x hx
    exact Subgroup.mem_sup_right (centralSeries_four_le_pSeries_four n hx)

/-! ## The kernel is contained in the closure of the classes of the left-nested commutators -/

theorem ker_le_Ksub (n : ℕ) (c : Q0 n) (hc : c ∈ (flowQuotSucc 2 Gm n 3 3).ker) :
    c ∈ Ksub n := by
  set H := (flowTerm 2 Gm n (tauSucc 3 3).1 (tauSucc 3 3).2).subgroupOf
    (⊤ : Subgroup (FF n)) with hH
  obtain ⟨y, hy⟩ := QuotientGroup.mk'_surjective H c
  have hker : QuotientGroup.mk' H y ∈ (flowQuotSucc 2 Gm n 3 3).ker := by rw [hy]; exact hc
  -- `y` lies in `F^{(3,3)} = (P₃ ∩ γ₃)P₄ = γ₃ ⊔ P₄`
  have hy_mem : (y : FF n) ∈ flowTerm 2 Gm n 3 3 := by
    have h2 : flowQuotSucc 2 Gm n 3 3 (QuotientGroup.mk' H y) = 1 := hker
    rw [flowQuotSucc_mk] at h2
    exact Subgroup.mem_subgroupOf.mp ((QuotientGroup.eq_one_iff y).mp h2)
  have hy_sup : (y : FF n) ∈ centralSeries (FF n) 3 ⊔ pSeries 2 (FF n) 4 := by
    have h := hy_mem
    rw [flowTerm_three_three] at h
    rwa [inf_eq_right.mpr (centralSeries_three_le_pSeries_three n)] at h
  haveI : (pSeries 2 (FF n) 4).Normal := Work.Shrinking.pCentralSeries_normal 2 (FF n) 3
  obtain ⟨u, hu, v, hv, huv⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := centralSeries (FF n) 3)
      (t := pSeries 2 (FF n) 4)).mp hy_sup
  have hu' : u ∈ Rsub n := gamma_three_le_closure_lcF_sup n hu
  rw [show Rsub n = Subgroup.closure (Set.range (lcF n)) ⊔ pSeries 2 (FF n) 4 from rfl] at hu'
  obtain ⟨s, hs, t, ht, hst⟩ :=
    (Subgroup.mem_sup_of_normal_right (s := Subgroup.closure (Set.range (lcF n)))
      (t := pSeries 2 (FF n) 4)).mp hu'
  have ht1 : mkQ n t = 1 := by
    rw [mkQ_eq_one_iff, flowTerm_four_one]; exact ht
  have hv1 : mkQ n v = 1 := by
    rw [mkQ_eq_one_iff, flowTerm_four_one]; exact hv
  have hval : mkQ n (y : FF n) = mkQ n s := by
    rw [← huv, ← hst, mkQ_mul, mkQ_mul]
    rw [ht1, hv1, mul_one, mul_one]
  have hcy : c = mkQ n s := by
    rw [← hy]
    exact hval
  rw [hcy]
  -- `mkQ n s` lies in the closure of the images of the `lcF`
  have key : ∀ x ∈ Subgroup.closure (Set.range (lcF n)), mkQHom n x ∈ Ksub n := by
    intro x hx
    induction hx using Subgroup.closure_induction with
    | mem z hz =>
        obtain ⟨w, rfl⟩ := hz
        rw [mkQHom_apply, ← lw_def]
        exact lw_mem_Ksub n w
    | one => rw [map_one]; exact (Ksub n).one_mem
    | mul a b _ _ iha ihb => rw [map_mul]; exact (Ksub n).mul_mem iha ihb
    | inv a _ iha => rw [map_inv]; exact (Ksub n).inv_mem iha
  simpa only [mkQHom_apply] using key s hs

/-! ## Every element of `Ksub` is a value of `thetaFun` -/

theorem Ksub_le_range (n : ℕ) (c : Q0 n) (hc : c ∈ Ksub n) :
    ∃ g : TT n, thetaFun n g = c := by
  induction hc using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨w, rfl⟩ := hx
      exact ⟨LamT n (Pi.single w 1), thetaFun_Lam_single n w⟩
  | one => exact ⟨0, thetaFun_zero' n⟩
  | mul a b _ _ iha ihb =>
      obtain ⟨g, hg⟩ := iha
      obtain ⟨h, hh⟩ := ihb
      refine ⟨g + h, ?_⟩
      rw [thetaFun_add, hg, hh]
  | inv a _ iha =>
      obtain ⟨g, hg⟩ := iha
      refine ⟨-g, ?_⟩
      have h1 : thetaFun n g * thetaFun n (-g) = 1 := by
        rw [← thetaFun_add, add_neg_cancel, thetaFun_zero']
      rw [← hg, eq_inv_of_mul_eq_one_right h1]

end Work.SSGRoute.zz3
