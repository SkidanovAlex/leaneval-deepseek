/-!
# Auxiliary definitions for `Work.SSGRoute.zz3.ThetaSurj`

The target `ThetaSurj` says: every element of the kernel of the level projection
`Q_{(4,1)} ↠ Q_{(3,3)}` is the value `thetaFun n g` of the "product of left-nested commutators"
map on a function `g : TT n` that is *fixed* by the idempotent `LamT n`.

The proof strategy (verified in the explicit `2`-group model of `F(n)/P₄`):

* `thetaFun` is additive (`thetaFun_add`) and *surjective* onto the kernel
  (via the generation statement `gamma_three_le_closure_lcF` plus the closure `Ksub n` of the
  classes `lw n w` of the left-nested commutators);
* `thetaFun` is `LamT`-invariant (`thetaFun_LamT`), a finite computation in the four index
  permutations together with the Jacobi identity in the associated graded of the lower central
  series (and the commutator identities of `zeta_sq`/`vanishThetaFun`).

This file collects the objects both halves are phrased in:

* `FF n` is `F(n) = FreeGroup (XX n)`, `Q0 n = Q_{(4,1)} = F(n)/F(n)^{(4,1)}`,
  `Q1 n = Q_{(3,3)} = F(n)/F(n)^{(3,3)}` (the target of `flowQuotSucc 2 Gm n 3 3`);
* `lw n w = mkQ n (lcF n w)` is the class of the left-nested commutator `[[x,y],z]`
  attached to a triple `w : Idx n`;
* `Ksub n` is the subgroup of `Q0 n` generated by the `lw n w`.
-/

open scoped commutatorElement

noncomputable section

namespace Work.SSGRoute.zz3

open Work.CohomologicalShrinking
open Work.SSGRoute.ZZ3

/-- The free `G`-operator group `F(n) = FreeGroup (Fin n × Gm)`. -/
abbrev FF (n : ℕ) : Type := Work.Shrinking.freeOperatorGroup Gm n

/-- `Q_{(4,1)} = F(n)/F(n)^{(4,1)} = F(n)/P₄`: the ambient quotient of the `(3,3)` graded piece. -/
abbrev Q0 (n : ℕ) : Type :=
  flowQuotient 2 Gm n (tauSucc 3 3).1 (tauSucc 3 3).2

/-- `Q_{(3,3)} = F(n)/F(n)^{(3,3)}`, the target of `flowQuotSucc 2 Gm n 3 3`. -/
abbrev Q1 (n : ℕ) : Type := flowQuotient 2 Gm n 3 3

/-! ## The quotient map `F(n) ↠ Q_{(4,1)}` -/

theorem mkQ_inv (n : ℕ) (a : FF n) : mkQ n a⁻¹ = (mkQ n a)⁻¹ := by
  show QuotientGroup.mk' _ (⟨a⁻¹, Subgroup.mem_top a⁻¹⟩ : ↥(⊤ : Subgroup (FF n))) = _
  rw [show (⟨a⁻¹, Subgroup.mem_top a⁻¹⟩ : ↥(⊤ : Subgroup (FF n))) =
      (⟨a, Subgroup.mem_top a⟩ : ↥(⊤ : Subgroup (FF n)))⁻¹ from Subtype.ext rfl, map_inv]
  rfl

theorem mkQ_pow (n : ℕ) (a : FF n) (k : ℕ) : mkQ n (a ^ k) = (mkQ n a) ^ k := by
  induction k with
  | zero => rw [pow_zero, pow_zero, mkQ_one]
  | succ k ih => rw [pow_succ, pow_succ, mkQ_mul, ih]

/-- The class in `Q_{(4,1)}` of the left-nested commutator `[[x,y],z]` attached to a triple. -/
def lw (n : ℕ) (w : Idx n) : Q0 n := mkQ n (lcF n w)

theorem lw_def (n : ℕ) (w : Idx n) : lw n w = mkQ n (lcF n w) := rfl

/-- The subgroup of `Q_{(4,1)}` generated by the classes of the left-nested commutators. -/
def Ksub (n : ℕ) : Subgroup (Q0 n) := Subgroup.closure (Set.range (lw n))

theorem lw_mem_Ksub (n : ℕ) (w : Idx n) : lw n w ∈ Ksub n :=
  Subgroup.subset_closure (Set.mem_range_self w)

/-- The left-nested commutator `[[x,y],z]` unfolded. -/
theorem lcF_eq (n : ℕ) (w : Idx n) :
    lcF n w = ⁅⁅FreeGroup.of (w 0), FreeGroup.of (w 1)⁆, FreeGroup.of (w 2)⁆ := rfl

/-! ## The terms of the refined filtration involved -/

/-- `F(n)^{(4,1)} = P₄`. -/
theorem flowTerm_four_one (n : ℕ) :
    flowTerm 2 Gm n (tauSucc 3 3).1 (tauSucc 3 3).2 = pSeries 2 (FF n) 4 := by
  show refinedTerm 2 (FF n) 4 1 = pSeries 2 (FF n) 4
  have h1 : centralSeries (FF n) 1 = ⊤ := rfl
  simp only [refinedTerm, h1, inf_top_eq]
  exact sup_eq_left.mpr (pSeries_antitone 2 (FF n) (by norm_num))

/-- `F(n)^{(3,3)} = (P₃ ∩ γ₃)P₄`. -/
theorem flowTerm_three_three (n : ℕ) :
    flowTerm 2 Gm n 3 3 = (pSeries 2 (FF n) 3 ⊓ centralSeries (FF n) 3) ⊔
      pSeries 2 (FF n) 4 := rfl

/-- `γ₃ = F(n)^3` is contained in `P₃`. -/
theorem centralSeries_three_le_pSeries_three (n : ℕ) :
    centralSeries (FF n) 3 ≤ pSeries 2 (FF n) 3 :=
  Work.ProP.lowerCentralSeries_le_pCentralSeries 2 (FF n) 2

/-- `γ₄ = F(n)^4` is contained in `P₄`. -/
theorem centralSeries_four_le_pSeries_four (n : ℕ) :
    centralSeries (FF n) 4 ≤ pSeries 2 (FF n) 4 :=
  Work.ProP.lowerCentralSeries_le_pCentralSeries 2 (FF n) 3

/-- `P₄ ⊇ P₅`. -/
theorem pSeries_five_le_four (n : ℕ) : pSeries 2 (FF n) 5 ≤ pSeries 2 (FF n) 4 :=
  pSeries_antitone 2 (FF n) (by norm_num)

/-- `(P₃)² ⊆ P₄`. -/
theorem sq_mem_pSeries_four (n : ℕ) {x : FF n} (hx : x ∈ pSeries 2 (FF n) 3) :
    x ^ 2 ∈ pSeries 2 (FF n) 4 := by
  have h : pSeries 2 (FF n) 4 = Work.Shrinking.pCentralStep 2 (pSeries 2 (FF n) 3) := rfl
  rw [h, Work.Shrinking.pCentralStep]
  exact Subgroup.mem_sup_left
    (Subgroup.subset_closure ⟨x, hx, rfl⟩)

/-- `⁅P₃, F(n)⁆ ⊆ P₄`. -/
theorem commutator_pSeries_three_le (n : ℕ) {x y : FF n} (hx : x ∈ pSeries 2 (FF n) 3) :
    ⁅x, y⁆ ∈ pSeries 2 (FF n) 4 := by
  have h : pSeries 2 (FF n) 4 = Work.Shrinking.pCentralStep 2 (pSeries 2 (FF n) 3) := rfl
  rw [h, Work.Shrinking.pCentralStep]
  exact Subgroup.mem_sup_right
    (Subgroup.commutator_mem_commutator hx (Subgroup.mem_top y))

end Work.SSGRoute.zz3



/-! ## The kernel of the level projection -/

namespace Work.SSGRoute.zz3

open Work.CohomologicalShrinking
open Work.SSGRoute.ZZ3

/-- The quotient map `F(n) ↠ Q_{(4,1)}` as a monoid homomorphism (so that `Subgroup.map`
lemmas apply to it). -/
noncomputable def qqMkHom (n : ℕ) : FF n →* Q0 n :=
  (QuotientGroup.mk' ((flowTerm 2 Gm n (tauSucc 3 3).1 (tauSucc 3 3).2).subgroupOf
    (⊤ : Subgroup (FF n)))).comp (Subgroup.topEquiv (G := FF n)).symm.toMonoidHom

theorem qqMkHom_apply (n : ℕ) (y : FF n) : qqMkHom n y = mkQ n y := rfl

/-- `P₄ ⊇ [P₃, P₃]`: the quotient `P₃/P₄` is abelian. -/
theorem commutator_mem_pSeries_four (n : ℕ) {x y : FF n}
    (hx : x ∈ pSeries 2 (FF n) 3) (hy : y ∈ pSeries 2 (FF n) 3) :
    ⁅x, y⁆ ∈ pSeries 2 (FF n) 4 :=
  commutator_pSeries_three_le n hx

/-- An element of `P₃` has a class of order `2` in `Q_{(4,1)}`. -/
theorem mkQ_mul_self_eq_one (n : ℕ) {x : FF n} (hx : x ∈ pSeries 2 (FF n) 3) :
    mkQ n x * mkQ n x = 1 := by
  rw [← mkQ_mul, mkQ_eq_one_iff, flowTerm_four_one, ← pow_two]
  exact sq_mem_pSeries_four n hx

/-- Conjugation acts trivially modulo `P₄` on `P₃`. -/
theorem mkQ_conj_eq (n : ℕ) {x y : FF n} (hy : y ∈ pSeries 2 (FF n) 3) :
    mkQ n (x * y * x⁻¹) = mkQ n y := by
  have hy' : y⁻¹ ∈ pSeries 2 (FF n) 3 := Subgroup.inv_mem _ hy
  have hmem : ⁅y⁻¹, x⁆ ∈ pSeries 2 (FF n) 4 := commutator_pSeries_three_le n hy'
  have hzero : mkQ n ⁅y⁻¹, x⁆ = 1 := by
    rw [mkQ_eq_one_iff, flowTerm_four_one]
    exact hmem
  have hxy : x * y * x⁻¹ = y * ⁅y⁻¹, x⁆ := by
    rw [commutatorElement_def]; group
  rw [hxy, mkQ_mul, hzero, mul_one]

/-- Conjugation by an inverse acts trivially modulo `P₄` on `P₃`. -/
theorem mkQ_conj_inv_eq (n : ℕ) {x y : FF n} (hy : y ∈ pSeries 2 (FF n) 3) :
    mkQ n (x⁻¹ * y * x) = mkQ n y := by
  simpa using mkQ_conj_eq n (x := x⁻¹) hy

/-! ## The class of a left-nested commutator of generators -/

/-- `lcF n w ∈ γ₃ = F(n)^3`. -/
theorem lcF_mem_centralSeries_three (n : ℕ) (w : Idx n) :
    lcF n w ∈ centralSeries (FF n) 3 := by
  rw [centralSeries, lcF_eq]
  exact Work.SSGRoute.prop5.gpFold_mem [w 1, w 2] 1 le_rfl (Subgroup.mem_top _)

/-- `lcF n w ∈ P₃`. -/
theorem lcF_mem_pSeries_three (n : ℕ) (w : Idx n) :
    lcF n w ∈ pSeries 2 (FF n) 3 :=
  centralSeries_three_le_pSeries_three n (lcF_mem_centralSeries_three n w)

/-- The classes of the left-nested commutators are involutions. -/
theorem lw_mul_self (n : ℕ) (w : Idx n) : lw n w * lw n w = 1 :=
  mkQ_mul_self_eq_one n (lcF_mem_pSeries_three n w)

/-- The classes of two elements of `P₃` commute in `Q_{(4,1)}`. -/
theorem mkQ_mul_comm_of_mem (n : ℕ) {x y : FF n}
    (hx : x ∈ pSeries 2 (FF n) 3) (hy : y ∈ pSeries 2 (FF n) 3) :
    mkQ n y * mkQ n x = mkQ n x * mkQ n y := by
  have hmem : ⁅y⁻¹, x⁻¹⁆ ∈ pSeries 2 (FF n) 4 :=
    commutator_pSeries_three_le n (Subgroup.inv_mem _ hy)
  have hzero : mkQ n ⁅y⁻¹, x⁻¹⁆ = 1 := by
    rw [mkQ_eq_one_iff, flowTerm_four_one]
    exact hmem
  have hyx : y * x = x * y * ⁅y⁻¹, x⁻¹⁆ := by
    rw [commutatorElement_def]; group
  calc mkQ n y * mkQ n x = mkQ n (y * x) := (mkQ_mul n y x).symm
    _ = mkQ n (x * y * ⁅y⁻¹, x⁻¹⁆) := by rw [hyx]
    _ = mkQ n (x * y) * mkQ n ⁅y⁻¹, x⁻¹⁆ := mkQ_mul n _ _
    _ = mkQ n (x * y) := by rw [hzero, mul_one]
    _ = mkQ n x * mkQ n y := mkQ_mul n x y

/-- The classes of the left-nested commutators commute. -/
theorem lw_mul_comm (n : ℕ) (v w : Idx n) : lw n v * lw n w = lw n w * lw n v :=
  (mkQ_mul_comm_of_mem n (lcF_mem_pSeries_three n v) (lcF_mem_pSeries_three n w)).symm

/-! ## The two commutator identities in `Q_{(4,1)}` -/

/-- **Jacobi identity in the associated graded.**  The product of the three cyclic left-nested
commutators of `x, y, z` is trivial in `Q_{(4,1)}`. -/
theorem mkQ_jacobi (n : ℕ) (x y z : FF n) :
    mkQ n ⁅⁅x, y⁆, z⁆ * mkQ n ⁅⁅y, z⁆, x⁆ * mkQ n ⁅⁅z, x⁆, y⁆ = 1 := by
  have hJ := Work.SSGRoute.prop5.gamma_commutator_jacobi_mem (G := FF n) 0 0 0 x y z
    (Subgroup.mem_top x) (Subgroup.mem_top y) (Subgroup.mem_top z)
  have hmem : ⁅⁅x, y⁆, z⁆ * ⁅⁅y, z⁆, x⁆ * ⁅⁅z, x⁆, y⁆ ∈ pSeries 2 (FF n) 4 := by
    refine centralSeries_four_le_pSeries_four n ?_
    have h := hJ
    rw [show (⊤ : Subgroup (FF n)).lowerCentralSeries (0 + 0 + 0 + 3) =
      centralSeries (FF n) 4 from rfl] at h
    exact h
  rw [← mkQ_mul, ← mkQ_mul, mkQ_eq_one_iff, flowTerm_four_one]
  exact hmem

/-- **Skew-symmetry in the first two slots.**  `[[y,x],z]` and `[[x,y],z]` have the same class in
`Q_{(4,1)}` (the sign disappears because elements of `γ₃` have order `2` modulo `P₄`). -/
theorem mkQ_commutator_swap (n : ℕ) (x y z : FF n) :
    mkQ n ⁅⁅y, x⁆, z⁆ = mkQ n ⁅⁅x, y⁆, z⁆ := by
  have hyx : ⁅y, x⁆ = ⁅x, y⁆⁻¹ := by
    rw [commutatorElement_def, commutatorElement_def]; group
  have h2 : ⁅(⁅x, y⁆)⁻¹, z⁆ = (⁅x, y⁆)⁻¹ * ⁅z, (⁅x, y⁆)⁆ * ⁅x, y⁆ := by
    rw [commutatorElement_def, commutatorElement_def]; group
  have h3 : ⁅z, (⁅x, y⁆)⁆ = (⁅(⁅x, y⁆), z⁆)⁻¹ := by
    rw [commutatorElement_def, commutatorElement_def]; group
  have hu1 : ⁅x, y⁆ ∈ (⊤ : Subgroup (FF n)).lowerCentralSeries 1 :=
    Subgroup.commutator_mem_commutator (Subgroup.mem_top x) (Subgroup.mem_top y)
  have hu3 : ⁅(⁅x, y⁆), z⁆ ∈ pSeries 2 (FF n) 3 := by
    refine centralSeries_three_le_pSeries_three n ?_
    rw [centralSeries]
    exact Work.SSGRoute.prop5.commutator_lowerCentralSeries_le (FF n) 1 0
      (Subgroup.commutator_mem_commutator hu1 (Subgroup.mem_top z))
  have hw3 : ⁅z, (⁅x, y⁆)⁆ ∈ pSeries 2 (FF n) 3 := by
    rw [h3]; exact Subgroup.inv_mem _ hu3
  rw [hyx, h2, mkQ_conj_inv_eq n hw3, h3, mkQ_inv]
  exact inv_eq_of_mul_eq_one_left (mkQ_mul_self_eq_one n hu3)

/-! ## The four index permutations -/

/-- The four index permutations whose composites occur in `Λ`, as a `Finset`. -/
def lamP : Finset (Fin 3 → Fin 3) :=
  {![0, 1, 2], ![1, 0, 2], ![1, 2, 0], ![2, 1, 0]}

theorem mem_lamP (f : Fin 3 → Fin 3) :
    f ∈ lamP ↔ f = ![0, 1, 2] ∨ f = ![1, 0, 2] ∨ f = ![1, 2, 0] ∨ f = ![2, 1, 0] := by
  simp [lamP]

/-- `LamT` as a sum over the four index permutations. -/
theorem LamT_eq_sum (n : ℕ) (g : TT n) (w : Idx n) :
    LamT n g w = ∑ p ∈ lamP, g (w ∘ p) := by
  rw [LamT_apply]
  rw [show lamP = insert ![0, 1, 2] (insert ![1, 0, 2] (insert ![1, 2, 0] {![2, 1, 0]}))
    from rfl]
  rw [Finset.sum_insert (by decide), Finset.sum_insert (by decide), Finset.sum_insert (by decide),
    Finset.sum_singleton]
  rw [show (w ∘ ![0, 1, 2] : Idx n) = w from by funext i; fin_cases i <;> rfl]
  simp only [sw01, swcyc, sw02]
  abel

end Work.SSGRoute.zz3
