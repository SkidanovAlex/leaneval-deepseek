/-!
# Surjectivity of `thetaFun` on the `Λ`-fixed functions onto the kernel

`ThetaSurj`: every element `c` of `Q_{(4,1)}` whose class in `Q_{(3,3)}` is trivial is the image
`thetaFun n g` of a function `g : TT n` that is fixed by the idempotent retraction `LamT n`.

The proof combines the two halves:

* `Ksub_le_range` (`KerLeKsub`): every element of the subgroup `Ksub n` generated by the classes
  `lw n w = mkQ n (lcF n w)` is a value of `thetaFun`, together with `ker_le_Ksub`, which identifies
  the kernel of `flowQuotSucc 2 Gm n 3 3` with `Ksub n` — the kernel is `γ₃ F(n)·P₄/P₄`, generated
  by the classes of the left-nested commutators of triples of generators;
* `thetaFun_LamT` (`LamInvariance`): `thetaFun` is `Λ`-invariant, so replacing a witness `g` by
  `LamT n g` keeps its value while making it a fixed point of `LamT` (which is idempotent).
-/

namespace Work.SSGRoute.zz3

theorem ThetaSurj (n : ℕ)
    (c : Work.CohomologicalShrinking.flowQuotient 2 Work.SSGRoute.ZZ3.Gm n
      (Work.CohomologicalShrinking.tauSucc 3 3).1
      (Work.CohomologicalShrinking.tauSucc 3 3).2)
    (hc : c ∈ (Work.SSGRoute.flowQuotSucc 2 Work.SSGRoute.ZZ3.Gm n 3 3).ker) :
    ∃ g : Work.SSGRoute.ZZ3.TT n,
      Work.SSGRoute.ZZ3.LamT n g = g ∧ Work.SSGRoute.ZZ3.thetaFun n g = c := by
  obtain ⟨g, hg⟩ := Ksub_le_range n c (ker_le_Ksub n c hc)
  exact ⟨Work.SSGRoute.ZZ3.LamT n g, Work.SSGRoute.ZZ3.LamT_idem n g,
    by rw [thetaFun_LamT n g, hg]⟩

end Work.SSGRoute.zz3
