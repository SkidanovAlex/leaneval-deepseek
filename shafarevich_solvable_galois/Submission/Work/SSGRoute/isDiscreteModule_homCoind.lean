/-!
# Discreteness of the conjugation action on `Hom_ℤ(M.V, Ωˣ)`

For `K/k` a finite Galois extension inside an algebraic closure `Ω` of `k`, a `Rep Coeff G`
(`G = Gal(K/k)`) `M` whose underlying `ℤ`-module `M.V` is finitely generated, and
`Γ = Gal(Ω/k)` acting on `homCoind k Ω K M = Hom_ℤ(M.V, Ωˣ)` by conjugation
`(σ · φ) x = σ · φ (σ⁻¹ · x)`, the action of `Γ` is continuous for the discrete topology
on `homCoind k Ω K M`: every point has an open stabiliser.

The proof picks a finite generating set `s` of the finitely generated abelian group `M.V`
(the coefficient ring is `ULift ℤ`).  A `Γ`-element `σ` that lies in the open subgroup

* `ker(Gal(Ω/k) →* Gal(K/k))` (so that `σ` acts trivially on `M.V`), and
* the stabiliser of every `φ g`, `g ∈ s` (which is open because `φ g` is a unit of the
  algebraic field `Ω`),

fixes `φ`: indeed `σ` fixes `φ` on `s`, hence (both sides being additive in the argument)
on the additive subgroup generated by `s`, which is all of `M.V`.
-/

set_option autoImplicit false

open scoped Pointwise

namespace Work.SSGRoute

/-- The `ULift ℤ`-span of a set of additive generators is contained in the additive subgroup
they generate: an element of the span is a `ULift ℤ`-linear combination, i.e. an integral one. -/
lemma isDiscreteModule_homCoind_span_le_closure {k : Type} [Field k] {Ω : Type} [Field Ω]
    [Algebra k Ω] {K : IntermediateField k Ω} (M : Rep SSGRoute.PTExt.Coeff (K ≃ₐ[k] K))
    (s : Set M.V) :
    (Submodule.span SSGRoute.PTExt.Coeff s : Set M.V) ⊆ AddSubgroup.closure s := by
  intro x hx
  let P : Submodule SSGRoute.PTExt.Coeff M.V :=
    { carrier := AddSubgroup.closure s
      add_mem' := fun ha hb => AddSubgroup.add_mem _ ha hb
      zero_mem' := AddSubgroup.zero_mem _
      smul_mem' := by
        intro c x hx
        rw [show c • x = c.down • x from rfl]
        exact AddSubgroup.zsmul_mem _ hx c.down }
  have hle : Submodule.span SSGRoute.PTExt.Coeff s ≤ P :=
    Submodule.span_le.mpr (fun y hy => AddSubgroup.subset_closure hy)
  exact hle hx

/-- A finitely generated `Coeff = ULift ℤ`-module has a finite set of additive generators. -/
lemma isDiscreteModule_homCoind_exists_finset {k : Type} [Field k] {Ω : Type} [Field Ω]
    [Algebra k Ω] {K : IntermediateField k Ω} (M : Rep SSGRoute.PTExt.Coeff (K ≃ₐ[k] K))
    [Module.Finite SSGRoute.PTExt.Coeff M.V] :
    ∃ s : Finset M.V, AddSubgroup.closure (s : Set M.V) = ⊤ := by
  obtain ⟨s, hs⟩ := Module.Finite.fg_top (R := SSGRoute.PTExt.Coeff) (M := M.V)
  refine ⟨s, ?_⟩
  apply eq_top_iff.mpr
  intro x _
  have hx : x ∈ (Submodule.span SSGRoute.PTExt.Coeff (s : Set M.V) : Set M.V) := by
    rw [hs]; trivial
  exact isDiscreteModule_homCoind_span_le_closure M (s : Set M.V) hx

theorem isDiscreteModule_homCoind {k : Type} [Field k] [CharZero k] {Ω : Type} [Field Ω]
    [Algebra k Ω] [IsAlgClosure k Ω] {K : IntermediateField k Ω} [FiniteDimensional k K]
    [IsGalois k K] (M : Rep SSGRoute.PTExt.Coeff (K ≃ₐ[k] K))
    [Module.Finite SSGRoute.PTExt.Coeff M.V] :
    Work.AbsoluteKummer.IsDiscreteModule (Ω ≃ₐ[k] Ω) (Work.SSGRoute.homCoind k Ω K M) := by
  intro φ
  obtain ⟨s, hs⟩ := isDiscreteModule_homCoind_exists_finset (k := k) (Ω := Ω) (K := K) M
  refine Subgroup.isOpen_of_mem_nhds (H := MulAction.stabilizer (Ω ≃ₐ[k] Ω) φ) (g := 1) ?_
  -- an open neighbourhood `U` of `1` contained in the stabiliser of `φ`
  have hUo : IsOpen (((SSGRoute.res k K).ker : Set (Ω ≃ₐ[k] Ω)) ∩
      ⋂ g ∈ (s : Set M.V),
        (MulAction.stabilizer (Ω ≃ₐ[k] Ω) (φ g) : Set (Ω ≃ₐ[k] Ω))) := by
    refine IsOpen.inter ?_ ?_
    · rw [IntermediateField.restrictNormalHom_ker K]
      exact IntermediateField.fixingSubgroup_isOpen K
    · exact isOpen_biInter_finset (fun g _ => isDiscreteModule_addUnitsΩ k Ω (φ g))
  refine Filter.mem_of_superset (hUo.mem_nhds ?_) ?_
  · refine ⟨?_, ?_⟩
    · exact Subgroup.one_mem _
    · simp only [Set.mem_iInter]
      intro g hg
      exact MulAction.mem_stabilizer_iff.mpr (one_smul _ _)
  · intro σ hσ
    obtain ⟨hσker, hσstab⟩ := hσ
    rw [SetLike.mem_coe, MulAction.mem_stabilizer_iff]
    have hres : SSGRoute.res k K σ = 1 := MonoidHom.mem_ker.mp hσker
    -- `σ` acts trivially on `M.V`
    have hker : ∀ g : M.V, M.ρ (SSGRoute.res k K σ)⁻¹ g = g := by
      intro g
      rw [hres, inv_one]
      show (M.ρ 1 : M.V →ₗ[SSGRoute.PTExt.Coeff] M.V) g = g
      rw [map_one]; rfl
    -- `σ` fixes `φ` on the generating set
    have hgen : ∀ g ∈ (s : Set M.V), ((σ • φ) - φ : M.V →+ Additive Ωˣ) g = 0 := by
      intro g hg
      have hstab : σ • φ g = φ g :=
        MulAction.mem_stabilizer_iff.mp (Set.mem_iInter.mp (Set.mem_iInter.mp hσstab g) hg)
      rw [AddMonoidHom.sub_apply, sub_eq_zero, homCoind.smul_apply, hker g]
      exact hstab
    have hle : AddSubgroup.closure (s : Set M.V) ≤ ((σ • φ) - φ : M.V →+ Additive Ωˣ).ker :=
      (AddSubgroup.closure_le _).mpr (fun g hg => AddMonoidHom.mem_ker.mpr (hgen g hg))
    rw [hs] at hle
    have htop : ((σ • φ) - φ : M.V →+ Additive Ωˣ).ker = ⊤ := top_le_iff.mp hle
    -- `σ • φ - φ` vanishes on all of `M.V`, i.e. `σ` stabilises `φ`
    refine AddMonoidHom.ext fun x => ?_
    have hx0 : ((σ • φ) - φ : M.V →+ Additive Ωˣ) x = 0 := by
      rw [← AddMonoidHom.mem_ker, htop]; trivial
    exact sub_eq_zero.mp hx0

end Work.SSGRoute
