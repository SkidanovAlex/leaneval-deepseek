theorem chebotarev_place_zpowers_unram_disj (hC : NK.WeakNU.ChebotarevFrobeniusInput)
    (L : IntermediateField ℚ SSGRoute.QBar) [FiniteDimensional ℚ L] [IsGalois ℚ L]
    (σ : ↥L ≃ₐ[ℚ] ↥L) (T : Finset ℕ) :
    ∃ (A : ValuationSubring SSGRoute.QBar) (hA : SSGRoute.IsFinPlace ℚ A),
      (Work.SSGRoute.placePrime A hA).1 ∉ T ∧
      ¬ SSGRoute.IsRamifiedIn ℚ L A ∧
      (SSGRoute.decomp ℚ A).map (AlgEquiv.restrictNormalHom L) = Subgroup.zpowers σ := by
  classical
  -- A named copy of the Galois hypothesis, so that it can be passed explicitly below.
  have hG : IsGalois ℚ L := ‹IsGalois ℚ L›
  haveI hNF : NumberField ↥L := NumberField.of_module_finite ℚ ↥L
  obtain ⟨p, hp, hpT, hunr, P, hPlies, hFrob⟩ := hC ↥L σ T
  obtain ⟨A, hAcomap⟩ :=
    NK.Reconstruct.exists_place_of_prime_level (k := ℚ) (K' := SSGRoute.QBar) L P
  have hA : SSGRoute.IsFinPlace ℚ A :=
    isFinPlace_of_comap_valuationSubringAtPrime L A P hAcomap
  refine ⟨A, hA, ?_, ?_, ?_⟩
  · -- the rational prime below `A` is `p`
    haveI : Fact p.Prime := ⟨hp⟩
    have hp_mem : ((p : ℕ) : NumberField.RingOfIntegers ↥L) ∈ P.asIdeal := by
      haveI hlies : P.asIdeal.LiesOver (Ideal.span {((p : ℕ) : ℤ)}) := hPlies
      have h1 : ((p : ℕ) : ℤ) ∈ P.asIdeal.under ℤ := by
        rw [← hlies.over]
        exact Ideal.subset_span (Set.mem_singleton _)
      have h2 : algebraMap ℤ (NumberField.RingOfIntegers ↥L) ((p : ℕ) : ℤ) ∈ P.asIdeal := h1
      rwa [map_natCast] at h2
    have hvalp : A.valuation ((p : ℕ) : SSGRoute.QBar) < 1 := by
      have h1 : A.valuation (algebraMap ↥L SSGRoute.QBar ((p : ℕ) : ↥L)) < 1 :=
        (comap_valuation_lt_one_iff A ((p : ℕ) : ↥L)).mp (by
          rw [hAcomap]
          simpa only [map_natCast] using
            (valuationSubringAtPrime_valuation_lt_one_iff_mem P
              ((p : ℕ) : NumberField.RingOfIntegers ↥L)).mpr hp_mem)
      rwa [map_natCast] at h1
    have hplaceP : Work.SSGRoute.placePrime A hA = ⟨p, hp⟩ :=
      Work.SSGRoute.placePrime_eq_of_val_lt_one p A hA hvalp
    show (Work.SSGRoute.placePrime A hA).1 ∉ T
    rw [hplaceP]
    exact hpT
  · -- unramified in `L`
    have hP0 : NK.Reconstruct.primeOfLevel A L (comap_level_ne_top' A hA L) = P :=
      Commons.RingTheory.Valuation.valuationSubringAtPrime_injective
        ((NK.Reconstruct.primeOfLevel_spec A L (comap_level_ne_top' A hA L)).symm.trans hAcomap)
    rintro ⟨σ₀, hσI, hσnot⟩
    have hmem := restrictNormalHom_mem_inertia L A hA σ₀ hσI
    rw [hP0] at hmem
    haveI : P.asIdeal.IsPrime := P.isPrime
    have hbot : Ideal.inertia (↥L ≃ₐ[ℚ] ↥L) P.asIdeal = ⊥ :=
      (Commons.NumberTheory.RamificationInertia.inertia_eq_bot_iff_ramificationIdx_eq_one
        (P.asIdeal.under (NumberField.RingOfIntegers ℚ)) P.asIdeal).mpr (hunr P hPlies)
    rw [hbot] at hmem
    have hres1 : AlgEquiv.restrictNormalHom L σ₀ = 1 := Subgroup.mem_bot.mp hmem
    -- `res σ₀ = 1` forces `σ₀` to fix `L` pointwise
    refine hσnot ?_
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hcomm := AlgEquiv.restrictNormal_commutes σ₀ L (⟨x, hx⟩ : ↥L)
    rw [show σ₀.restrictNormal L = 1 from hres1, AlgEquiv.one_apply] at hcomm
    simpa using hcomm.symm
  · -- the decomposition group is generated by `σ`
    have hbridge :=
      @map_res_decomp_eq_stabilizer_valuationRing ℚ SSGRoute.QBar _ _ _ _ _ L _ hG A hA P hAcomap
    have hstab : MulAction.stabilizer (↥L ≃ₐ[ℚ] ↥L)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P) = Subgroup.zpowers σ := by
      rw [show MulAction.stabilizer (↥L ≃ₐ[ℚ] ↥L)
            (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime ↥L P)
          = Submission.NeukirchUchida.Local.decompositionSubgroup (K := ℚ) P from
        Subgroup.ext (fun x =>
          Submission.NeukirchUchida.Local.mem_stabilizer_valuationSubringAtPrime_iff_mem_decompositionSubgroup
            (K := ℚ) P x)]
      exact NK.ChebotarevGeneral.decompositionSubgroup_eq_zpowers_of_isFrobAt (K := ℚ) P σ
        (hunr P hPlies) hFrob
    exact hbridge.trans hstab

end Work.SSGRoute
