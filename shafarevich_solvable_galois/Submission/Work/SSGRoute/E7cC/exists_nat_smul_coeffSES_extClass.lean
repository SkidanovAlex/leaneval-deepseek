/-!
# `Ext¹_G(𝔽_p, ℤ)` is generated by the class of `0 → ℤ --p--> ℤ → 𝔽_p → 0`

For a finite group `G` and a prime `p`, the coefficient sequence
`e = 0 → ℤ --p--> ℤ → 𝔽_p → 0` of trivial representations (`SSGRoute.Phi1.coeffSES`) has class
`e.extClass ∈ Ext¹_G(𝔽_p, ℤ) ≅ ℤ/p`, and every nonzero `φ ∈ Ext¹_G(𝔽_p, ℤ)` is an `n`-th multiple of
`e.extClass` with `p ∤ n`.

The proof only uses the long exact sequence of `Abelian.Ext` (the contravariant sequence attached to
`e`, at the coefficient module `ℤ`), the vanishing `H¹(G, ℤ) = 0` for finite `G`
(`Work.SSGRoute.E7cOmega.extH_unitRep_one_subsingleton`), and the elementary description of the
endomorphisms of the trivial representation `ℤ`.

Main steps:

* `p_zsmul_extClass_eq_zero` : `p • e.extClass = 0` (the class is `p`-torsion);
* `exists_zsmul_extClass`   : every `φ` is `z • e.extClass` for some `z : ℤ`;
* the final reduction `z ↦ z % p` produces the natural number `n` with `p ∤ n`.
-/

namespace Work.SSGRoute.E7cC

open CategoryTheory

/-! ## Elementary facts about the trivial representation `unitRep G = ℤ` -/

/-- **Every endomorphism of the trivial representation `ℤ` is an integer multiple of the
identity.**  For `f : unitRep G ⟶ unitRep G`, the value `f.hom 1` determines `f` by
`Coeff`-linearity, and the multiple is the `down` of that value. -/
private lemma hom_zsmul_eq {G : Type} [Group G]
    (f : SSGRoute.PTExt.unitRep G ⟶ SSGRoute.PTExt.unitRep G) :
    f = ((f.hom 1).down : ℤ) • (𝟙 (SSGRoute.PTExt.unitRep G)) := by
  apply Rep.hom_ext
  apply Representation.IntertwiningMap.ext
  apply LinearMap.ext
  intro a
  rw [Rep.zsmul_hom, Rep.hom_id]
  simp only [Representation.IntertwiningMap.toLinearMap_apply,
    Representation.IntertwiningMap.coe_zsmul, Representation.IntertwiningMap.id_apply,
    Pi.smul_apply]
  rw [show (Rep.Hom.hom f) a = a • ((Rep.Hom.hom f) 1) from by
    rw [show a = a • (1 : SSGRoute.PTExt.Coeff) from (mul_one a).symm, map_smul]
    simp only [smul_eq_mul, mul_one]]
  cases a with
  | up m =>
    cases (Rep.Hom.hom f) 1 with
    | up z =>
      show (ULift.up m : ULift ℤ) * ULift.up z = ULift.up (z * m)
      rw [show (ULift.up m : ULift ℤ) * ULift.up z = ULift.up (m*z) from rfl]
      rw [mul_comm]

/-- `mk₀` commutes with integer multiples of morphisms. -/
private lemma mk0_zsmul {G : Type} [Group G] {X Y : Rep SSGRoute.PTExt.Coeff G} (z : ℤ)
    (f : X ⟶ Y) : Abelian.Ext.mk₀ (z • f) = z • Abelian.Ext.mk₀ f := by
  show Abelian.Ext.addEquiv₀.symm (z • f) = z • Abelian.Ext.addEquiv₀.symm f
  exact map_zsmul _ z f

/-- `mk₀` commutes with natural multiples of morphisms. -/
private lemma mk0_nsmul {G : Type} [Group G] {X Y : Rep SSGRoute.PTExt.Coeff G} (n : ℕ)
    (f : X ⟶ Y) : Abelian.Ext.mk₀ (n • f) = n • Abelian.Ext.mk₀ f := by
  show Abelian.Ext.addEquiv₀.symm (n • f) = n • Abelian.Ext.addEquiv₀.symm f
  exact map_nsmul _ n f

/-- The natural multiple `p • 𝟙` of the identity of `unitRep G` is multiplication by `p`,
i.e. the first map of the coefficient sequence. -/
private lemma nsmul_id_eq_unitMulByP {G : Type} [Group G] (p : ℕ) :
    p • (𝟙 (SSGRoute.PTExt.unitRep G)) = SSGRoute.Phi1.unitMulByP G p := by
  apply Rep.hom_ext
  apply Representation.IntertwiningMap.ext
  apply LinearMap.ext
  intro a
  rw [Rep.nsmul_hom, Rep.hom_id]
  simp only [Representation.IntertwiningMap.toLinearMap_apply,
    Representation.IntertwiningMap.coe_nsmul, Representation.IntertwiningMap.id_apply,
    Pi.smul_apply]
  show p • a = (Rep.Hom.hom (SSGRoute.Phi1.unitMulByP G p)) a
  rw [SSGRoute.Phi1.unitMulByP_apply, nsmul_eq_mul]

/-- **`Ext⁰_G(ℤ, ℤ)` is the ℤ-multiples of the identity.**  Every element of
`Ext⁰_G(unitRep G, unitRep G) ≅ End_Rep(ℤ, ℤ) = ℤ` is `z • mk₀ 𝟙` for some `z : ℤ`. -/
private lemma ext0_zsmul_mk0_id {G : Type} [Group G]
    (x : Abelian.Ext (SSGRoute.PTExt.unitRep G) (SSGRoute.PTExt.unitRep G) 0) :
    ∃ z : ℤ, x = z • Abelian.Ext.mk₀ (𝟙 (SSGRoute.PTExt.unitRep G)) := by
  set z : ℤ := ((Abelian.Ext.addEquiv₀ x).hom 1).down with hz
  refine ⟨z, ?_⟩
  have h1 : Abelian.Ext.addEquiv₀ x = z • (𝟙 (SSGRoute.PTExt.unitRep G)) := by
    rw [hz]; exact hom_zsmul_eq _
  conv_lhs => rw [← Abelian.Ext.mk₀_addEquiv₀_apply x]
  rw [h1]
  exact mk0_zsmul (G := G) z _

/-! ## The class of the coefficient sequence is `p`-torsion -/

/-- **`p • e.extClass = 0`**: the first map of the coefficient sequence is `p • 𝟙`, and the class of
a short exact sequence composes to zero against its first map. -/
private lemma p_nsmul_extClass_eq_zero {p : ℕ} [Fact p.Prime] {G : Type} [Group G] :
    p • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass = 0 := by
  let S := SSGRoute.Phi1.coeffSES G p
  have hS := SSGRoute.Phi1.coeffSES_shortExact G p
  let gg : Abelian.Ext S.X₁ S.X₁ 0 →+ Abelian.Ext S.X₃ S.X₁ 1 :=
    AddMonoidHom.mk' (fun y => hS.extClass.comp y (add_zero 1))
      (fun a b => Abelian.Ext.comp_add hS.extClass a b (add_zero 1))
  have h1 : hS.extClass = gg (Abelian.Ext.mk₀ (𝟙 S.X₁)) :=
    (Abelian.Ext.comp_mk₀_id hS.extClass).symm
  rw [h1, ← map_nsmul gg p (Abelian.Ext.mk₀ (𝟙 S.X₁))]
  rw [← mk0_nsmul (G := G) p (𝟙 S.X₁)]
  change gg (Abelian.Ext.mk₀ (p • (𝟙 (SSGRoute.PTExt.unitRep G)))) = 0
  rw [nsmul_id_eq_unitMulByP]
  exact ShortComplex.ShortExact.extClass_comp hS

/-- `p • e.extClass = 0` for the integer scalar. -/
private lemma p_zsmul_extClass_eq_zero {p : ℕ} [Fact p.Prime] {G : Type} [Group G] :
    (p : ℤ) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass = 0 := by
  rw [natCast_zsmul]
  exact p_nsmul_extClass_eq_zero

/-- The coercion of a natural scalar `Coeff` acting as `ULift` coincides with the natural
`sMul` on the `Ext`-group. -/
private lemma coeff_nat_smul {p : ℕ} [Fact p.Prime] {G : Type} [Group G] [Fintype G] (n : ℕ) :
    (n : SSGRoute.PTExt.Coeff) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass
      = n • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := by
  rw [ULift.smul_def, ULift.down_natCast, natCast_zsmul]

/-! ## Surjectivity: every class is an integer multiple of `e.extClass` -/

/-- **Every class in `Ext¹_G(𝔽_p, ℤ)` is a ℤ-multiple of `e.extClass`.**  The contravariant long
exact sequence of `e` at the coefficient module `ℤ` shows that the connecting map
`Ext⁰_G(ℤ, ℤ) → Ext¹_G(𝔽_p, ℤ)`, `y ↦ e.extClass.comp y`, is onto (its cokernel
`Ext¹_G(ℤ, ℤ) = H¹(G, ℤ)` vanishes), and `Ext⁰_G(ℤ, ℤ)` is generated by the identity. -/
private lemma exists_zsmul_extClass {p : ℕ} [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    (φ : Abelian.Ext (Rep.trivial SSGRoute.PTExt.Coeff G (ZMod p))
      (SSGRoute.PTExt.unitRep G) 1) :
    ∃ z : ℤ, φ = z • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := by
  let S := SSGRoute.Phi1.coeffSES G p
  have hS := SSGRoute.Phi1.coeffSES_shortExact G p
  have hx3 : (Abelian.Ext.mk₀ S.g).comp φ (zero_add 1) = 0 :=
    @Subsingleton.elim _ (E7cOmega.extH_unitRep_one_subsingleton G) _ _
  obtain ⟨x₁, hx₁⟩ := Abelian.Ext.contravariant_sequence_exact₃ hS (SSGRoute.PTExt.unitRep G) φ hx3
    (n₀ := 0) (by norm_num : 1 + 0 = 1)
  obtain ⟨z, hz⟩ := ext0_zsmul_mk0_id (G := G) x₁
  refine ⟨z, ?_⟩
  rw [← hx₁, hz]
  let gg : Abelian.Ext S.X₁ S.X₁ 0 →+ Abelian.Ext S.X₃ S.X₁ 1 :=
    AddMonoidHom.mk' (fun y => hS.extClass.comp y (add_zero 1))
      (fun a b => Abelian.Ext.comp_add hS.extClass a b (add_zero 1))
  change gg (z • Abelian.Ext.mk₀ (𝟙 S.X₁)) = z • hS.extClass
  rw [map_zsmul gg z (Abelian.Ext.mk₀ (𝟙 S.X₁))]
  change z • (hS.extClass.comp (Abelian.Ext.mk₀ (𝟙 S.X₁)) (add_zero 1)) = z • hS.extClass
  rw [Abelian.Ext.comp_mk₀_id hS.extClass]

/-! ## The main statement -/

theorem exists_nat_smul_coeffSES_extClass {p : ℕ} [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    (φ : CategoryTheory.Abelian.Ext (Rep.trivial SSGRoute.PTExt.Coeff G (ZMod p))
      (SSGRoute.PTExt.unitRep G) 1) (hφ : φ ≠ 0) :
    ∃ n : ℕ, ¬ p ∣ n ∧
      φ = (n : SSGRoute.PTExt.Coeff) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := by
  obtain ⟨z, hz⟩ := exists_zsmul_extClass (p := p) (G := G) φ
  have hp0 : (p : ℤ) ≠ 0 := by
    have h := (Fact.out : p.Prime).ne_zero
    exact_mod_cast h
  have hp_pos : (0:ℤ) < p := by
    have h := (Fact.out : p.Prime).pos
    exact_mod_cast h
  have hnonneg : 0 ≤ z % (p:ℤ) := Int.emod_nonneg z hp0
  have hlt : z % (p:ℤ) < (p:ℤ) := Int.emod_lt_of_pos z hp_pos
  have htoNat : ((z % (p:ℤ)).toNat : ℤ) = z % (p:ℤ) := Int.toNat_of_nonneg hnonneg
  set n : ℕ := (z % (p:ℤ)).toNat with hn
  have hn_int : (n : ℤ) = z % (p:ℤ) := by rw [hn]; exact htoNat
  refine ⟨n, ?_, ?_⟩
  · intro hdvd
    have hltnat : n < p := by omega
    have hzero : n = 0 := by
      by_contra hne
      have hpos : 0 < n := Nat.pos_of_ne_zero hne
      have := Nat.le_of_dvd hpos hdvd
      omega
    have hzmod : z % (p:ℤ) = 0 := by
      rw [← hn_int, hzero]; rfl
    have hdiv : (p:ℤ) ∣ z := (Int.dvd_iff_emod_eq_zero (a := (p:ℤ)) (b := z)).mpr hzmod
    obtain ⟨k, hk⟩ := hdiv
    have hze : z • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass = 0 := by
      rw [hk, mul_comm (p:ℤ) k, ← smul_smul, p_zsmul_extClass_eq_zero, smul_zero]
    exact hφ (hz.trans hze)
  · have h1 : z • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass
        = (z % (p:ℤ)) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := by
      conv_lhs => rw [show z = z / (p:ℤ) * (p:ℤ) + z % (p:ℤ) from
        (Int.ediv_mul_add_emod z (p:ℤ)).symm]
      rw [add_zsmul, ← smul_smul, p_zsmul_extClass_eq_zero, smul_zero, zero_add]
    have h2 : (z % (p:ℤ)) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass
        = (n : ℤ) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := by rw [hn_int]
    have h3 : (n : ℤ) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass
        = n • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass := natCast_zsmul _ n
    have h4 : n • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass
        = (n : SSGRoute.PTExt.Coeff) • (SSGRoute.Phi1.coeffSES_shortExact G p).extClass :=
      (coeff_nat_smul (p := p) (G := G) n).symm
    rw [hz, h1, h2, h3, h4]

end Work.SSGRoute.E7cC
