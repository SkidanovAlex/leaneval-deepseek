/-!
# `B.valuation (x) = 1` is `count 𝔭 (x) = 0`

This module proves

`Work.SSGRoute.GrunwaldEscapeCore.valuation_eq_one_iff_count_eq_zero`:

for a number field `K`, a place `𝔭` of `𝓞 K`, a field `Ω` with `Algebra K Ω` and a valuation subring
`B` of `Ω` whose restriction to `K` is the valuation subring `𝒪_{K,𝔭}`, the two conditions

* `B.valuation (algebraMap K Ω x) = 1` (i.e. `x` is a unit of `B`), and
* `FractionalIdeal.count K 𝔭 (x·𝓞 K) = 0` (i.e. `x` has `𝔭`-adic exponent `0`),

are equivalent.

The proof is assembled from two independent facts, both proved here:

1. `comap_valuation_eq_one_iff` — `B.valuation (algebraMap K Ω x) = 1` holds precisely when the
   *restricted* valuation, the canonical valuation of the valuation subring
   `B.comap (algebraMap K Ω)`, takes the value `1` on `x`.  This only uses the definitions of the
   valuation subring and of `comap` (`ValuationSubring.valuation_le_one_iff`,
   `ValuationSubring.mem_comap`).
2. `val_eq_exp_neg_count` — for any Dedekind domain `R` with fraction field `K`, a height-one prime
   `v` and a nonzero `x : K`, the `v`-adic valuation of `x` is `exp (-(count v (x)))`, where
   `count v (x)` is the exponent of `v` in the principal fractional ideal `x·R`.  Consequently
   `v.valuation K x = 1 ↔ count v (x) = 0`.

The passage from the canonical valuation of `𝒪_{K,𝔭}` to the adic valuation `𝔭.valuation K` is
`valuation_eq_one_iff_of_eq_valuationSubring`, valid for any valuation whose valuation subring
coincides with a given one.
-/

namespace Work.SSGRoute.GrunwaldEscapeCore

/-- **The `𝔭`-adic valuation of a nonzero element, in the `count` normalisation.**

For a Dedekind domain `R` with fraction field `K`, a height-one prime `v` and `x : K`, `x ≠ 0`,
the `v`-adic valuation of `x` is `exp (-(count v (x)))`, where `count v (x)` is the exponent of `v`
in the principal fractional ideal generated by `x`. -/
theorem val_eq_exp_neg_count {R K : Type*} [CommRing R] [IsDedekindDomain R] [Field K]
    [Algebra R K] [IsFractionRing R K] (v : IsDedekindDomain.HeightOneSpectrum R)
    {x : K} (hx : x ≠ 0) :
    IsDedekindDomain.HeightOneSpectrum.valuation K v x =
      WithZero.exp (-(FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) x))) := by
  -- Write `x = a / b` with `a : R` and `b ∈ R⁰`.
  obtain ⟨⟨a, b, hb0⟩, hab⟩ := IsLocalization.surj (nonZeroDivisors R) x
  have hbK : (algebraMap R K) b ≠ 0 := by
    intro h
    exact nonZeroDivisors.ne_zero hb0 ((IsFractionRing.injective R K) (by simpa using h))
  have haK : (algebraMap R K) a ≠ 0 := by
    intro h
    rw [h] at hab
    exact hx ((mul_eq_zero.mp hab).resolve_right hbK)
  have ha0 : a ≠ 0 := fun h => haK (by rw [h, map_zero])
  have hxdiv : (algebraMap R K) a / (algebraMap R K) b = x := by
    rw [div_eq_iff hbK]; exact hab.symm
  -- The valuation side: `v x = v a / v b`, and `v a`, `v b` come from the ideals `(a)`, `(b)`.
  have hval : IsDedekindDomain.HeightOneSpectrum.valuation K v x
      = v.intValuation a / v.intValuation b := by
    rw [← hxdiv, map_div₀, IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
      IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap]
  have hI : FractionalIdeal.spanSingleton (nonZeroDivisors R) x ≠ 0 :=
    FractionalIdeal.spanSingleton_ne_zero_iff.mpr hx
  have hIb : FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K) b) ≠ 0 :=
    FractionalIdeal.spanSingleton_ne_zero_iff.mpr hbK
  have hca : FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K) a))
      = ((Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {a})).factors : ℤ) := by
    rw [← FractionalIdeal.coeIdeal_span_singleton a, FractionalIdeal.count_coe]
    exact Ideal.span_singleton_eq_bot.not.mpr ha0
  have hcb : FractionalIdeal.count K v
        (FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K) b))
      = ((Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors : ℤ) := by
    rw [← FractionalIdeal.coeIdeal_span_singleton b, FractionalIdeal.count_coe]
    exact Ideal.span_singleton_eq_bot.not.mpr (nonZeroDivisors.ne_zero hb0)
  -- The `count` side: `count (x) = count (a) - count (b)`, from multiplicativity of `count`.
  have hcount : FractionalIdeal.count K v (FractionalIdeal.spanSingleton (nonZeroDivisors R) x)
      = ((Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {a})).factors : ℤ)
        - ((Associates.mk v.asIdeal).count (Associates.mk (Ideal.span {b})).factors : ℤ) := by
    have hxa : FractionalIdeal.spanSingleton (nonZeroDivisors R) x *
        FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K) b)
        = FractionalIdeal.spanSingleton (nonZeroDivisors R) ((algebraMap R K) a) := by
      rw [FractionalIdeal.spanSingleton_mul_spanSingleton, hab]
    have hmul := FractionalIdeal.count_mul K v hI hIb
    rw [hxa, hca, hcb] at hmul
    omega
  -- Assemble.
  rw [hval, IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg v ha0,
    IsDedekindDomain.HeightOneSpectrum.intValuation_if_neg v (nonZeroDivisors.ne_zero hb0),
    hcount, ← WithZero.exp_sub]
  congr 1
  ring

/-- **`= 1` is intrinsic to the valuation subring.**  If a valuation subring `A` is the valuation
subring of a valuation `v`, then `A`'s canonical valuation takes the value `1` at `y` exactly when
`v` does. -/
theorem valuation_eq_one_iff_of_eq_valuationSubring {K Γ₀ : Type*} [Field K]
    [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation K Γ₀) (A : ValuationSubring K)
    (h : A = v.valuationSubring) (y : K) : A.valuation y = 1 ↔ v y = 1 := by
  have hle : ∀ z : K, A.valuation z ≤ 1 ↔ v z ≤ 1 := by
    intro z
    rw [ValuationSubring.valuation_le_one_iff, h, Valuation.mem_valuationSubring_iff]
  rcases eq_or_ne y 0 with rfl | hy
  · simp
  · rw [le_antisymm_iff, le_antisymm_iff, Valuation.one_le_val_iff A.valuation hy,
      Valuation.one_le_val_iff v hy]
    simp only [hle]

/-- **Restricting a valuation to `K` and then taking `= 1` is the same as evaluating in `Ω`.**

For a valuation subring `B` of `Ω` and `x ∈ Kˣ`, `B.valuation (algebraMap K Ω x) = 1` holds
precisely when the canonical valuation of the valuation subring `B.comap (algebraMap K Ω)` of `K`
takes the value `1` at `x`. -/
theorem comap_valuation_eq_one_iff {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
    (B : ValuationSubring Ω) (x : Kˣ) :
    B.valuation (algebraMap K Ω (x : K)) = 1 ↔
      (B.comap (algebraMap K Ω)).valuation (x : K) = 1 := by
  have hle : ∀ y : K, B.valuation (algebraMap K Ω y) ≤ 1 ↔
      (B.comap (algebraMap K Ω)).valuation y ≤ 1 := by
    intro y
    rw [ValuationSubring.valuation_le_one_iff, ← ValuationSubring.mem_comap,
      ValuationSubring.valuation_le_one_iff]
  have hxΩ : algebraMap K Ω (x : K) ≠ 0 := by
    intro h
    exact Units.ne_zero x (RingHom.injective (algebraMap K Ω) (by rw [h, map_zero]))
  have hxK : (x : K) ≠ 0 := Units.ne_zero x
  rw [le_antisymm_iff, le_antisymm_iff, Valuation.one_le_val_iff B.valuation hxΩ,
      Valuation.one_le_val_iff (B.comap (algebraMap K Ω)).valuation hxK, ← map_inv₀]
  simp only [hle]

theorem valuation_eq_one_iff_count_eq_zero {K Ω : Type} [Field K] [NumberField K] [Field Ω]
    [Algebra K Ω] (B : ValuationSubring Ω)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hB : B.comap (algebraMap K Ω) =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K 𝔭) (x : Kˣ) :
    B.valuation (algebraMap K Ω (x : K)) = 1 ↔
      FractionalIdeal.count K 𝔭
        (FractionalIdeal.spanSingleton (nonZeroDivisors (NumberField.RingOfIntegers K))
          (x : K)) = 0 := by
  -- Restrict the valuation to `K`.
  rw [comap_valuation_eq_one_iff B x, hB]
  -- Replace the canonical valuation of `𝒪_{K,𝔭}` by the adic valuation `𝔭.valuation K`.
  rw [valuation_eq_one_iff_of_eq_valuationSubring (𝔭.valuation K)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K 𝔭)
        (IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring
          (K := K) 𝔭)
        (x : K)]
  -- Read `= 1` as `count = 0`.
  rw [val_eq_exp_neg_count 𝔭 (Units.ne_zero x), WithZero.exp_eq_one, neg_eq_zero]

end Work.SSGRoute.GrunwaldEscapeCore
