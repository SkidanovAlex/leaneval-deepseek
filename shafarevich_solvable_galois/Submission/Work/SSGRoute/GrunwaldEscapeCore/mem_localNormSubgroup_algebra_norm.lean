/-!
# The global norm is a local norm

`mem_localNormSubgroup_algebra_norm`: the global norm `N_{L/K}(α)` of `α ∈ Lˣ`, viewed in the
completion `K_𝔭` through `localImageAt`, lies in the local norm subgroup at `𝔭`.  This is the
identity `N_{L/K}(α) = ∏_{q | 𝔭} N_{L_q/K_𝔭}(α)`, obtained here from the idèle-norm machinery:
`normIdeleHom K L (principalIdele L α) = principalIdele K (N α)`
(`NK.GlobalCFT.NormFunctorial.normIdeleHom_principalIdele`) and
`normIdeleFun_mem_localNormSubgroup`.

This is the first input of the *antisymmetry* of the local Kummer pairing
(`NOTE_orthogonality_route.md` §3): with `α = x^{1/p}` a `p`-th root of `x`, it gives
`x = N_{K(x^{1/p})/K}(x^{1/p}) ∈ localNormSubgroup`, hence `x` is killed by the local Artin factor,
i.e. the diagonal of the pairing vanishes.

This file was requested from the fleet at this path (reviewed as `mem_localNormSubgroup_algebra_norm`,
"looks correct as stated"); the fleet was busy, so it is proved here (the main development of
`GrunwaldEscapeCore` is mine).
-/

open scoped NumberField

namespace Work.SSGRoute.GrunwaldEscapeCore

/-- The global norm `N_{L/K}(α)` of `α ∈ Lˣ`, viewed in the completion `K_𝔭` via `localImageAt`, lies
in the local norm subgroup at `𝔭` (the subgroup of `K_𝔭ˣ` generated by the local norms
`N_{L_q/K_𝔭}` over the primes `q` of `L` above `𝔭`).  This is the standard identity
`N_{L/K}(α) = ∏_{q | 𝔭} N_{L_q/K_𝔭}(α)`. -/
theorem mem_localNormSubgroup_algebra_norm
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) (α : Lˣ) :
    NK.CFTLib.IdeleHasse.localImageAt (K := K) (NK.GlobalCFT.Place.ofFinite 𝔭)
        (Units.map (Algebra.norm K) α) ∈
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L)
        (NK.GlobalCFT.Place.ofFinite 𝔭) := by
  have h1 : NK.CFTLib.IdeleHasse.localImageAt (K := K) (NK.GlobalCFT.Place.ofFinite 𝔭)
      (Units.map (Algebra.norm K) α)
      = NK.GlobalCFT.Idele.normIdeleFun K L (NK.GlobalCFT.Idele.principalIdele L α)
          (NK.GlobalCFT.Place.ofFinite 𝔭) := by
    show NK.GlobalCFT.Idele.principalIdele K (Units.map (Algebra.norm K) α)
        (NK.GlobalCFT.Place.ofFinite 𝔭) = _
    rw [← NK.GlobalCFT.Idele.normIdeleHom_principalIdele (K := K) (L := L) α]
    rfl
  rw [h1]
  exact NK.CFTLib.IdeleHasse.normIdeleFun_mem_localNormSubgroup
    (K := K) (L := L) (NK.GlobalCFT.Idele.principalIdele L α) (NK.GlobalCFT.Place.ofFinite 𝔭)

end Work.SSGRoute.GrunwaldEscapeCore
