/-- **The field generated by a Kummer root is Galois of degree `p`.**  Let `κ ⊆ E` be a field
extension, `ζ ∈ κ` a primitive `p`-th root of unity (`p` prime), `c ∈ κˣ` not a `p`-th power in `κ`,
and `γ ∈ Eˣ` with `γ ^ p = c`.  Then `κ(γ) ≤ E` is a Galois extension of `κ` of degree `p`.

This is `NK.LocalAnabelian.Kummer.isGalois_kummerField_and_finrank` with the `IsSepClosure κ E`
hypothesis dropped (the root `γ` is given rather than produced), which is what the global number
field use needs (`E` is a number field here, not a separable closure). -/
theorem isGalois_adjoin_kummerRoot
    (p : ℕ) [Fact p.Prime] {κ E : Type} [Field κ] [Field E] [Algebra κ E]
    (ζ : κ) (hζ : IsPrimitiveRoot ζ p) (c : κˣ) (γ : Eˣ)
    (hγ : γ ^ p = Units.map (algebraMap κ E) c)
    (hc : c ∉ NK.LocalAnabelian.powSubgroup p κ) :
    IsGalois κ (IntermediateField.adjoin κ ({(γ : E)} : Set E)) ∧
      Module.finrank κ ↥(IntermediateField.adjoin κ ({(γ : E)} : Set E)) = p := by
  have hp : p.Prime := Fact.out
  -- `α` is the given `p`-th root of `c`, as an element of `E`.
  let α : E := (γ : E)
  have hα : α ^ p = algebraMap κ E (c : κ) := by
    have h := congrArg (fun u : Eˣ => (u : E)) hγ
    dsimp [α]
    simpa using h
  -- The characteristic is not `p`, so `X ^ p - c` is separable over `κ`.
  have hchar : p ≠ ringChar κ :=
    NK.LocalAnabelian.Kummer.pow_ne_ringChar_of_isPrimitiveRoot p hp hζ
  have hpk : (p : κ) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime (R := κ) hp hchar.symm
  have hsep : (X ^ p - C (c : κ)).Separable := separable_X_pow_sub_C (c : κ) hpk (by simp)
  have hb0 : algebraMap κ E (c : κ) ≠ 0 := by simp
  have hα0 : α ≠ 0 := by
    intro h
    rw [h, zero_pow hp.ne_zero] at hα
    exact hb0 hα.symm
  -- The root set of `X ^ p - c` in `E`.
  have hrootset : (X ^ p - C (c : κ)).rootSet E =
      {x : E | x ^ p = algebraMap κ E (c : κ)} := by
    ext x
    rw [mem_rootSet_of_ne (X_pow_sub_C_ne_zero hp.pos (c : κ)), aeval_def, eval₂_sub, eval₂_pow,
      eval₂_C, eval₂_X, sub_eq_zero]
    simp
  -- Every root of `X ^ p - c` is `ζ ^ i * α`, hence lies in `κ⟮α⟯`.
  have hroot : ∀ β : E, β ^ p = algebraMap κ E (c : κ) → β ∈ adjoin κ {α} := by
    intro β hβ
    have hx : (β / α) ^ p = 1 := by rw [div_pow, hβ, hα, div_self hb0]
    have hmem : β / α ∈ nthRoots p (1 : E) := (mem_nthRoots hp.pos).mpr hx
    rw [(hζ.map_of_injective (RingHom.injective (algebraMap κ E))).nthRoots_eq
      (show (1 : E) ^ p = 1 by simp)] at hmem
    simp only [Multiset.mem_map, Multiset.mem_range] at hmem
    obtain ⟨i, hi, hβi⟩ := hmem
    rw [mul_one] at hβi
    have hβeq : β = algebraMap κ E (ζ ^ i) * α := by
      rw [map_pow, hβi, div_mul_cancel₀ β hα0]
    rw [hβeq]
    exact mul_mem (IntermediateField.algebraMap_mem _ (ζ ^ i)) (mem_adjoin_simple_self κ α)
  have hgen0 : ({(γ : E)} : Set E) ⊆ (X ^ p - C (c : κ)).rootSet E := by
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    rw [hx, hrootset]
    exact hα
  have hgen : ({(γ : E)} : Set E) ⊆
      (IntermediateField.adjoin κ ((X ^ p - C (c : κ)).rootSet E) : Set E) :=
    hgen0.trans (IntermediateField.subset_adjoin κ ((X ^ p - C (c : κ)).rootSet E))
  have hroot' : (X ^ p - C (c : κ)).rootSet E ⊆
      (IntermediateField.adjoin κ ({(γ : E)} : Set E) : Set E) := by
    intro β hβ
    rw [hrootset] at hβ
    exact hroot β hβ
  -- So `κ⟮α⟯` is generated by the root set of `X ^ p - c`.
  have hLR : IntermediateField.adjoin κ ({(γ : E)} : Set E) =
      IntermediateField.adjoin κ ((X ^ p - C (c : κ)).rootSet E) :=
    le_antisymm (IntermediateField.adjoin_le_iff.mpr hgen)
      (IntermediateField.adjoin_le_iff.mpr hroot')
  have hζ' : IsPrimitiveRoot ((algebraMap κ E) ζ) p :=
    hζ.map_of_injective (RingHom.injective (algebraMap κ E))
  have hsplitE : ((X ^ p - C (c : κ)).map (algebraMap κ E)).Splits := by
    have h := X_pow_sub_C_splits_of_isPrimitiveRoot hζ' hα
    simpa using h
  have hsplit : Polynomial.IsSplittingField κ ↥(IntermediateField.adjoin κ ({(γ : E)} : Set E))
      (X ^ p - C (c : κ)) := by
    rw [hLR]
    exact IntermediateField.adjoin_rootSet_isSplittingField hsplitE
  -- A splitting field of a separable polynomial is Galois.
  have hgal : IsGalois κ ↥(IntermediateField.adjoin κ ({(γ : E)} : Set E)) := by
    haveI : Polynomial.IsSplittingField κ ↥(IntermediateField.adjoin κ ({(γ : E)} : Set E))
        (X ^ p - C (c : κ)) := hsplit
    exact IsGalois.of_separable_splitting_field hsep
  -- `c` is not a `p`-th power in `κ`.
  have ha_ne : ∀ b : κ, b ^ p ≠ (c : κ) := by
    intro b hb
    have hb0' : b ≠ 0 := by
      rintro rfl
      rw [zero_pow hp.ne_zero] at hb
      exact Units.ne_zero c hb.symm
    refine hc ?_
    rw [NK.LocalAnabelian.powSubgroup, MonoidHom.mem_range]
    exact ⟨Units.mk0 b hb0', by rw [powMonoidHom_apply]; ext; simpa using hb⟩
  have hirr : Irreducible (X ^ p - C (c : κ)) := X_pow_sub_C_irreducible_of_prime hp ha_ne
  have hroot_poly : aeval α (X ^ p - C (c : κ)) = 0 := by
    rw [aeval_def, eval₂_sub, eval₂_pow, eval₂_C, eval₂_X, sub_eq_zero]
    exact hα
  have hminpoly : minpoly κ α = X ^ p - C (c : κ) :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot_poly (monic_X_pow_sub_C _ hp.ne_zero)).symm
  have hint : IsIntegral κ α := IsIntegral.of_pow hp.pos (by rw [hα]; exact isIntegral_algebraMap)
  -- The degree is `natDegree (minpoly κ α) = p`.
  have hfin : Module.finrank κ ↥(IntermediateField.adjoin κ ({(γ : E)} : Set E)) = p := by
    change Module.finrank κ ↥(κ⟮α⟯) = p
    rw [IntermediateField.adjoin.finrank hint, hminpoly, natDegree_X_pow_sub_C]
  exact ⟨hgal, hfin⟩

end Work.SSGRoute.GrunwaldEscapeCore
