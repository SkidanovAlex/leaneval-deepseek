/-!
# The Kummer root is a norm: the *diagonal* of the local Kummer pairing

For an odd prime `p`, a field `K` containing a primitive `p`-th root of unity `ζ`, a finite Galois
extension `L/K` of degree `p` generated by `α` with `α ^ p = x`:

  `x` is a norm from `L`, i.e. `∃ η : Lˣ, N_{L/K}(η) = x`.

This is the elementary Kummer fact "`x` is the norm of its own `p`-th root" (the product of the
conjugates `ζ ^ i α` is `ζ ^ (p(p-1)/2) α ^ p = x`, since `p` is odd).  It is *free of any
Hilbert-symbol theory*.

Its role (`NOTE_orthogonality_route.md` §3): combined with
`mem_localNormSubgroup_algebra_norm` it shows that `x` lies in the **kernel** of the local Artin
factor `θ_𝔭` of the Kummer extension `K(x^{1/p})/K`, i.e. that the *diagonal* of the local Kummer
pairing `β(x,y) = χ_y(θ_𝔭(x))` vanishes.  Together with the (free) bilinearity this makes the
pairing **alternating**, hence **antisymmetric**:
`β(x,y) + β(y,x) = β(x+y,x+y) - β(x,x) - β(y,y) = 0`.
That antisymmetry — not symmetry — is what the orthogonality of the Grünwald escape needs.

The proof composes the existing Kummer-theory material `Work.Kummer.exists_norm_eq_of_odd` (the
norm group of a Kummer generator) with the automorphism `α ↦ ζ α`
(`Work.Kummer.exists_algEquiv_apply_eq_mul_of_pow_eq`), which is shown here to generate
`Gal(L/K)`.
-/

namespace Work.SSGRoute.GrunwaldEscapeCore

open IntermediateField

/-- **The Kummer root is a norm.**  For an odd prime `p`, `ζ ∈ K` a primitive `p`-th root of unity,
`L/K` a finite Galois extension of degree `p` generated by `α` with `α ^ p = x`, the element `x` is
a norm from `L`. -/
theorem exists_norm_eq_of_kummerRoot
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) {K L : Type} [Field K] [Field L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] (ζ : K) (hζ : IsPrimitiveRoot ζ p) (x : Kˣ)
    (α : L) (hα : α ^ p = algebraMap K L (x : K))
    (hgen : IntermediateField.adjoin K ({α} : Set L) = ⊤)
    (hdeg : Module.finrank K L = p) :
    ∃ η : Lˣ, Algebra.norm K (η : L) = (x : K) := by
  classical
  have hodd : Odd p := (Fact.out : p.Prime).odd_of_ne_two hp
  have hx0 : (x : K) ≠ 0 := x.ne_zero
  -- the primitive root, as an element of the group `μ_p(K)`
  let μ : rootsOfUnity p K :=
    ⟨Work.Kummer.primRootUnit hζ, by
      rw [mem_rootsOfUnity', Work.Kummer.primRootUnit_coe hζ]
      exact hζ.pow_eq_one⟩
  have hμcoe : (((μ : rootsOfUnity p K) : Kˣ) : K) = ζ := Work.Kummer.primRootUnit_coe hζ
  -- the automorphism `α ↦ ζ α`
  obtain ⟨σ, hσmul⟩ :=
    Work.Kummer.exists_algEquiv_apply_eq_mul_of_pow_eq (K := K) (L := L) hζ hα hgen hdeg μ
  rw [hμcoe] at hσmul
  have hα0 : α ≠ 0 := by
    intro h
    have hmap : algebraMap K L (x : K) ≠ 0 := (map_ne_zero (algebraMap K L)).mpr hx0
    rw [h, zero_pow (Fact.out : p.Prime).ne_zero] at hα
    exact hmap hα.symm
  -- `σ` has order `p`, hence generates
  have hcard : Nat.card Gal(L/K) = p := (IsGalois.card_aut_eq_finrank K L).trans hdeg
  have hσpow : ∀ k : ℕ, ((σ : L ≃ₐ[K] L) ^ k) α = (algebraMap K L ζ) ^ k * α := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, map_pow, AlgEquiv.commutes, hσmul,
        ← mul_assoc, pow_succ]
  have hσp : σ ^ p = 1 := by
    have := pow_card_eq_one' (G := Gal(L/K)) (x := σ)
    rwa [hcard] at this
  have hdvd1 : orderOf σ ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hσp
  have hdvd2 : p ∣ orderOf σ := by
    have hfix : (algebraMap K L ζ) ^ orderOf σ * α = α := by
      have h := hσpow (orderOf σ)
      rw [pow_orderOf_eq_one, AlgEquiv.one_apply] at h
      exact h.symm
    have hζpow : (algebraMap K L ζ) ^ orderOf σ = 1 :=
      mul_right_cancel₀ hα0 (by rw [hfix, one_mul])
    have hζpow' : ζ ^ orderOf σ = 1 :=
      (algebraMap K L).injective (by rw [map_pow, map_one]; exact hζpow)
    exact (hζ.pow_eq_one_iff_dvd (orderOf σ)).mp hζpow'
  have hσorder : orderOf σ = p := Nat.dvd_antisymm hdvd1 hdvd2
  haveI : Finite (Subgroup.zpowers σ) :=
    Nat.finite_of_card_ne_zero (by rw [Nat.card_zpowers, hσorder]; exact NeZero.ne p)
  have hgen' : Subgroup.zpowers σ = ⊤ := by
    rw [← Subgroup.card_eq_iff_eq_top, Nat.card_zpowers, hσorder, hcard]
  exact Work.Kummer.exists_norm_eq_of_odd (K := K) (L := L) hζ hdeg hodd hx0 hα
    (fun g => by rw [hgen']; exact Subgroup.mem_top g) hσmul

/-- **The diagonal of the local Kummer pairing.**  In the situation of
`exists_norm_eq_of_kummerRoot`, the image of `x` in `K_𝔭` lies in the local norm subgroup, i.e. `x`
is killed by the local Artin factor `θ_𝔭` of the Kummer extension `K(x^{1/p})/K`
(`ker θ_𝔭 = localNormSubgroup`). -/
theorem mem_localNormSubgroup_of_kummerRoot
    (p : ℕ) [Fact p.Prime] (hp : p ≠ 2) {K L : Type} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (ζ : K) (hζ : IsPrimitiveRoot ζ p) (x : Kˣ) (α : L)
    (hα : α ^ p = algebraMap K L (x : K))
    (hgen : IntermediateField.adjoin K ({α} : Set L) = ⊤)
    (hdeg : Module.finrank K L = p)
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    NK.CFTLib.IdeleHasse.localImageAt (K := K) (NK.GlobalCFT.Place.ofFinite 𝔭) x ∈
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L)
        (NK.GlobalCFT.Place.ofFinite 𝔭) := by
  obtain ⟨η, hη⟩ := exists_norm_eq_of_kummerRoot p hp ζ hζ x α hα hgen hdeg
  have hxη : Units.map (Algebra.norm K) η = x := Units.ext hη
  rw [← hxη]
  exact mem_localNormSubgroup_algebra_norm 𝔭 η

end Work.SSGRoute.GrunwaldEscapeCore
