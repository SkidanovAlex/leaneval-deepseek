open FreeGroup

namespace LiftingAux

universe u

/-! ## The induced involution and basic invariance lemmas -/

/-- `FreeGroup.freeGroupCongr σ` is an involution when `σ` is. -/
theorem freeGroupCongr_involutive {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) :
    ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ (FreeGroup.freeGroupCongr σ w) = w := by
  intro w
  have h1 : (FreeGroup.freeGroupCongr σ).trans (FreeGroup.freeGroupCongr σ)
      = FreeGroup.freeGroupCongr (σ.trans σ) := FreeGroup.freeGroupCongr_trans σ σ
  have h2 : σ.trans σ = Equiv.refl X := Equiv.ext (fun x => hσ x)
  have h3 : (FreeGroup.freeGroupCongr σ).trans (FreeGroup.freeGroupCongr σ)
      = MulEquiv.refl (FreeGroup X) := by rw [h1, h2, FreeGroup.freeGroupCongr_refl]
  have := congrArg (fun e : FreeGroup X ≃* FreeGroup X => e w) h3
  simpa [MulEquiv.trans_apply] using this

/-- The descending `p`-central series is functorial for an arbitrary group homomorphism. -/
theorem map_pCentralSeries_le (p : ℕ) {P Q : Type*} [Group P] [Group Q] (f : P →* Q) (n : ℕ) :
    (Work.Shrinking.pCentralSeries p P n).map f ≤ Work.Shrinking.pCentralSeries p Q n := by
  induction n with
  | zero =>
      rw [Work.Shrinking.pCentralSeries_zero, Work.Shrinking.pCentralSeries_zero]
      exact le_top
  | succ n ih =>
      rw [Work.Shrinking.pCentralSeries_succ, Work.Shrinking.pCentralSeries_succ,
        Work.Shrinking.pCentralStep, Work.Shrinking.pCentralStep, Subgroup.map_sup,
        Work.Shrinking.map_powSubgroup, Subgroup.map_commutator]
      exact sup_le_sup (Subgroup.closure_mono (Set.image_mono ih))
        (Subgroup.commutator_mono ih le_top)

/-- The descending central series is functorial for an arbitrary group homomorphism. -/
theorem map_lowerCentralSeries_le {P Q : Type*} [Group P] [Group Q] (f : P →* Q) (j : ℕ) :
    ((⊤ : Subgroup P).lowerCentralSeries j).map f ≤ (⊤ : Subgroup Q).lowerCentralSeries j := by
  rw [Subgroup.map_lowerCentralSeries]
  exact Subgroup.lowerCentralSeries_mono j le_top

/-- Schmidt–Wingberg's refined term is monotone in the group. -/
theorem refinedTerm_map_le (p : ℕ) {P Q : Type*} [Group P] [Group Q] (f : P →* Q) (i j : ℕ) :
    (Work.CohomologicalShrinking.refinedTerm p P i j).map f ≤
      Work.CohomologicalShrinking.refinedTerm p Q i j := by
  rw [Work.CohomologicalShrinking.refinedTerm, Work.CohomologicalShrinking.refinedTerm,
    Subgroup.map_sup]
  refine sup_le ?_ ?_
  · refine le_trans (Subgroup.map_inf_le _ _ f) (le_trans (inf_le_inf ?_ ?_) le_sup_left)
    · exact map_pCentralSeries_le p f (i - 1)
    · exact map_lowerCentralSeries_le f (j - 1)
  · have h2 : (Work.CohomologicalShrinking.pSeries p P (i + 1)).map f ≤
        Work.CohomologicalShrinking.pSeries p Q (i + 1) := by
      simpa only [Work.CohomologicalShrinking.pSeries, Nat.add_sub_cancel] using
        map_pCentralSeries_le p f i
    exact le_trans h2 le_sup_right

/-! ## The half-word lemma and the equivalence of the two formulations -/

/-- The coset of `w` under the induced involution, in the form used by the half-word lemma. -/
theorem map_mk_freeGroupCongr {X : Type*} (σ : X ≃ X) (N : Subgroup (FreeGroup X)) [N.Normal]
    (h : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N) (w : FreeGroup X) :
    (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom h) (QuotientGroup.mk w)
      = QuotientGroup.mk (FreeGroup.freeGroupCongr σ w) := by
  rw [QuotientGroup.map_mk]
  simp

/-- If a coset contains an anti-fixed lift, then its image is a norm (half-word lemma). -/
theorem isNorm_of_antifixed_lift {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (hfree : ∀ x, σ x ≠ x) (N : Subgroup (FreeGroup X)) [N.Normal]
    (h : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N) {w : FreeGroup X}
    (hw : FreeGroup.freeGroupCongr σ w = w⁻¹) :
    ∃ r : FreeGroup X ⧸ N,
      QuotientGroup.mk w
        = (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom h r)⁻¹ * r := by
  obtain ⟨v, hv⟩ := halfWord_freeGroup σ hσ hfree w hw
  refine ⟨QuotientGroup.mk v, ?_⟩
  rw [map_mk_freeGroupCongr, hv, QuotientGroup.mk_mul, QuotientGroup.mk_inv]

/-- **The lifting step follows from the norm statement** (the two formulations are equivalent). -/
theorem lifting_of_target {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (h : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N)
    (htarget : ∀ x : FreeGroup X ⧸ N,
      (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom h) x = x⁻¹ →
      ∃ r : FreeGroup X ⧸ N,
        x = (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom h r)⁻¹ * r) :
    ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ w * w ∈ N →
      ∃ n ∈ N, FreeGroup.freeGroupCongr σ (w * n) * (w * n) = 1 := by
  intro w hw
  have hanti : (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom h)
      (QuotientGroup.mk w) = (QuotientGroup.mk w)⁻¹ := by
    rw [map_mk_freeGroupCongr, ← QuotientGroup.mk_inv]
    exact (QuotientGroup.eq_iff_div_mem).mpr (by simpa [div_eq_mul_inv] using hw)
  obtain ⟨r, hr⟩ := htarget (QuotientGroup.mk w) hanti
  obtain ⟨s, rfl⟩ := QuotientGroup.mk_surjective r
  have hdis : (QuotientGroup.mk' N) w
      = (QuotientGroup.mk' N) ((FreeGroup.freeGroupCongr σ s)⁻¹ * s) := by
    rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, hr, map_mk_freeGroupCongr,
      QuotientGroup.mk_mul, QuotientGroup.mk_inv]
  obtain ⟨n, hnN, hn⟩ := (QuotientGroup.mk'_eq_mk' N).mp hdis
  refine ⟨n, hnN, ?_⟩
  rw [hn, MulEquiv.map_mul, MulEquiv.map_inv, freeGroupCongr_involutive σ hσ s]
  group

/-! ## Reducing to a finite free factor -/

/-- A word all of whose letters lie in a subset `X₀` comes from the free factor on `X₀`. -/
theorem exists_map_subtype_eq_of_toWord {X : Type*} [DecidableEq X] (X₀ : Set X) (w : FreeGroup X)
    (hw : ∀ p ∈ FreeGroup.toWord w, p.1 ∈ X₀) :
    ∃ w₀ : FreeGroup X₀, FreeGroup.map (Subtype.val : X₀ → X) w₀ = w := by
  refine ⟨FreeGroup.mk ((FreeGroup.toWord w).attach.map
    (fun q => ((⟨q.1.1, hw q.1 q.2⟩ : X₀), q.1.2))), ?_⟩
  have hL : ((FreeGroup.toWord w).attach.map (fun q => ((⟨q.1.1, hw q.1 q.2⟩ : X₀), q.1.2))).map
      (fun x : X₀ × Bool => ((x.1 : X), x.2)) = FreeGroup.toWord w := by
    rw [List.map_map]
    have hfun : ((fun x : X₀ × Bool => ((x.1 : X), x.2)) ∘
        (fun q => ((⟨q.1.1, hw q.1 q.2⟩ : X₀), q.1.2))) =
        (fun q : {p : X × Bool // p ∈ FreeGroup.toWord w} => q.1) := by
      funext q
      rfl
    rw [hfun]
    simpa using (List.attach_map_val (l := FreeGroup.toWord w) (f := id))
  rw [FreeGroup.map.mk, hL, FreeGroup.mk_toWord]

/-- Naturality of the free-group involution with respect to a map of bases. -/
theorem freeGroup_map_freeGroupCongr_comm {X Y : Type*} (f : X → Y) (σ : X ≃ X) (τ : Y ≃ Y)
    (h : ∀ x, f (σ x) = τ (f x)) (w : FreeGroup X) :
    FreeGroup.map f (FreeGroup.freeGroupCongr σ w)
      = FreeGroup.freeGroupCongr τ (FreeGroup.map f w) := by
  rw [FreeGroup.freeGroupCongr_apply, FreeGroup.freeGroupCongr_apply,
    FreeGroup.map.comp, FreeGroup.map.comp]
  exact congrArg (fun g => FreeGroup.map g w) (funext h)


/-! ## The two boundary cases of the refined term, and the assembly in the range `1 ≤ j ≤ i` -/

/-- For `j ≤ 1` the refined term `P_{(i,j)} = (P_i ⊓ P^j) P_{i+1}` has `P^j = ⊤`, hence equals
the plain `p`-central term `P_i = P_{(i,1)}`. -/
theorem refinedTerm_eq_of_le_one {X : Type*} (i j : ℕ) (hj : j ≤ 1) :
    Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j
      = Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i 1 := by
  have htop : Work.CohomologicalShrinking.centralSeries (FreeGroup X) j = ⊤ := by
    interval_cases j
    · rfl
    · rfl
  rw [Work.CohomologicalShrinking.refinedTerm, htop, inf_top_eq,
    Work.CohomologicalShrinking.refinedTerm_one]
  exact sup_eq_left.mpr
    (Work.CohomologicalShrinking.pSeries_antitone 2 (FreeGroup X) (Nat.le_succ i))

/-- For `j ≥ i + 1` one has `P^j ⊆ γ_{j-1} ⊆ P_i = P_{i+1}`, so the refined term collapses to the
next plain `p`-central term: `P_{(i,j)} = P_{i+1} = P_{(i+1,1)}`. -/
theorem refinedTerm_eq_of_ge {X : Type*} (i j : ℕ) (hj : i + 1 ≤ j) :
    Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j
      = Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) (i + 1) 1 := by
  have hle : Work.CohomologicalShrinking.centralSeries (FreeGroup X) j
      ≤ Work.CohomologicalShrinking.pSeries 2 (FreeGroup X) (i + 1) := by
    refine le_trans (Work.ProP.lowerCentralSeries_le_pCentralSeries 2 (FreeGroup X) (j - 1)) ?_
    exact Work.Shrinking.pCentralSeries_antitone 2 (FreeGroup X) (by omega)
  rw [Work.CohomologicalShrinking.refinedTerm, Work.CohomologicalShrinking.refinedTerm_one]
  exact sup_eq_right.mpr (le_trans inf_le_right hle)

/-- **The lifting statement for a finite free basis from its "good range" `1 ≤ j ≤ i`.**  The two
boundary cases reduce to the cases `j = 1`, respectively to `(i+1, 1)`, by
`refinedTerm_eq_of_le_one` / `refinedTerm_eq_of_ge`. -/
theorem freeGroup_refinedTerm_lifting_finite_of_range
    (hrange : ∀ {Y : Type u} [Finite Y] (τ : Y ≃ Y) (hτ : ∀ y, τ (τ y) = y)
      (hfr : ∀ y, τ y ≠ y) (i j : ℕ), 1 ≤ j → j ≤ i →
      ∀ w : FreeGroup Y, FreeGroup.freeGroupCongr τ w * w ∈
          Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j →
        ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j,
          FreeGroup.freeGroupCongr τ (w * n) * (w * n) = 1)
    {Y : Type u} [Finite Y] (τ : Y ≃ Y) (hτ : ∀ y, τ (τ y) = y) (hfr : ∀ y, τ y ≠ y)
    (i j : ℕ) :
    ∀ w : FreeGroup Y, FreeGroup.freeGroupCongr τ w * w ∈
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j,
        FreeGroup.freeGroupCongr τ (w * n) * (w * n) = 1 := by
  by_cases hi : i = 0
  · have htop : Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j = ⊤ := by
      rw [hi, Work.CohomologicalShrinking.refinedTerm]
      simp
    rw [htop]
    intro w hw
    refine ⟨(FreeGroup.freeGroupCongr τ w)⁻¹, Subgroup.mem_top _, ?_⟩
    rw [MulEquiv.map_mul, MulEquiv.map_inv, LiftingAux.freeGroupCongr_involutive τ hτ w]
    group
  · have hi1 : 1 ≤ i := by omega
    intro w hw
    by_cases hj : j ≤ 1
    · rw [refinedTerm_eq_of_le_one i j hj] at hw ⊢
      exact hrange τ hτ hfr i 1 le_rfl hi1 w hw
    · by_cases hji : j ≤ i
      · exact hrange τ hτ hfr i j (by omega) hji w hw
      · rw [refinedTerm_eq_of_ge i j (by omega)] at hw ⊢
        exact hrange τ hτ hfr (i + 1) 1 le_rfl (by omega) w hw

end LiftingAux

section InducedInvolution

/-- The involution induced by `σ` on the quotient `F ⧸ N`, for `N` stable under `Φ`. -/
noncomputable def quotientInv {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hN : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N) :
    (FreeGroup X ⧸ N) ≃* (FreeGroup X ⧸ N) where
  toFun := QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hN
  invFun := QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hN
  left_inv := fun y => by
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective y
    rw [QuotientGroup.map_mk, QuotientGroup.map_mk]
    exact congrArg QuotientGroup.mk (LiftingAux.freeGroupCongr_involutive σ hσ w)
  right_inv := fun y => by
    obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective y
    rw [QuotientGroup.map_mk, QuotientGroup.map_mk]
    exact congrArg QuotientGroup.mk (LiftingAux.freeGroupCongr_involutive σ hσ w)
  map_mul' := map_mul _

@[simp] theorem quotientInv_mk {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hN : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N) (w : FreeGroup X) :
    quotientInv σ hσ N hN (QuotientGroup.mk w) = QuotientGroup.mk (FreeGroup.freeGroupCongr σ w) :=
  LiftingAux.map_mk_freeGroupCongr σ N hN w

/-- The norm statement for `F ⧸ N`: every anti-fixed element is a norm `(δ r)⁻¹ * r`. -/
def NormStatement {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hN : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N) : Prop :=
  ∀ x : FreeGroup X ⧸ N, quotientInv σ hσ N hN x = x⁻¹ →
    ∃ r : FreeGroup X ⧸ N, x = (quotientInv σ hσ N hN r)⁻¹ * r

end InducedInvolution

/-! ## The graded step as a hypothesis -/

namespace LiftingAux
universe u

/-- The `k`-th graded step of the descent: on the image of `P_{k-1}` in `F ⧸ N` every anti-fixed
element is a norm.  This is the remaining input of the assembly; the cases `k ≤ 2` are proved in
`Submission.Work.SSGRoute.refinedTerm_graded_norm`. -/
def GradedStep : Prop :=
  ∀ {X : Type*} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N)
    [Finite (FreeGroup X ⧸ N)] (k : ℕ)
    (hk : Work.Shrinking.pCentralSeries 2 (FreeGroup X) k ≤ N),
    ∀ x ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map (QuotientGroup.mk' N),
      (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
        (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy))) x = x⁻¹ →
      ∃ r : FreeGroup X ⧸ N,
        x = (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
              (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy)) r)⁻¹ * r

/-- The `k`-th instance of the graded step: the statement above with the level `k` fixed.  This is
the per-level form in which the workspace's ladder is organised; the levels `1, 2, 3` are available
in the workspace (in import cones that carry the other copy of `Work.SSGRoute.Nrm`), so the honest
remaining input of this file is `∀ k ≥ 4, GradedStepAt k`. -/
def GradedStepAt (k : ℕ) : Prop :=
  ∀ {X : Type*} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N)
    [Finite (FreeGroup X ⧸ N)]
    (hk : Work.Shrinking.pCentralSeries 2 (FreeGroup X) k ≤ N),
    ∀ x ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map (QuotientGroup.mk' N),
      (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
        (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy))) x = x⁻¹ →
      ∃ r : FreeGroup X ⧸ N,
        x = (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
              (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy)) r)⁻¹ * r

/-- The graded step from its per-level instances. -/
theorem gradedStep_of_forall_gradedStepAt (h : ∀ k, GradedStepAt.{u} k) : GradedStep.{u} := by
  intro X hX σ hσ hfree N hN hInv hfin k hk x hx hxanti
  exact @h k X hX σ hσ hfree N hN hInv hfin hk x hx hxanti

/-- The per-level instances from the graded step. -/
theorem forall_gradedStepAt_of_gradedStep (h : GradedStep.{u}) : ∀ k, GradedStepAt.{u} k := by
  intro k X hX σ hσ hfree N hN hInv hfin hk x hx hxanti
  exact @h X hX σ hσ hfree N hN hInv hfin k hk x hx hxanti

/-- The graded step is the conjunction of its per-level instances. -/
theorem gradedStep_iff : GradedStep.{u} ↔ ∀ k, GradedStepAt.{u} k :=
  ⟨forall_gradedStepAt_of_gradedStep, gradedStep_of_forall_gradedStepAt⟩

/-! ## The layer-generation statement and the reduction of the graded step to it

`LayerGen k` is the *pure structure* statement isolated by the mechanism above: on the image of
`P_{k-1}` in `F ⧸ N` (`N ⊇ P_k` fully invariant) the `Φ̄`-fixed elements are generated by

* the **orbit sums** `Φ̄ a * a` of the layer (`a` in the image of `P_{k-1}`) — this is
  `(1 + Φ̄)` on the layer; and
* the **`δ`-values of the lower layers** `Φ̄ r⁻¹ * r` with `r` in the image of `P_{k-2}`, restricted
  to those that land in the layer.

Both families consist of *central* elements of `F ⧸ N` and both are *norms*: the first because the
layer has exponent `2` (so `Φ̄ a * a = Φ̄ a⁻¹ * a`), the second by definition.  Since the set of
central norms is closed under multiplication (`norm_mul_of_central`) and inversion, the subgroup
generated by the two families consists of norms.  Hence `LayerGen` implies the graded step at the
same level (`gradedStep_of_layerGen`).  The cases `k ≤ 2` of `LayerGen` are the abelian and
class-`2` cases; `k = 3` is the first open one (the layer `P_2/P_3`). -/

/-- The involution of `F ⧸ N` induced by `Φ = FreeGroup.freeGroupCongr σ`, as a monoid
homomorphism (the same term as in `GradedStep`). -/
noncomputable abbrev PhiHom {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N) :
    (FreeGroup X ⧸ N) →* (FreeGroup X ⧸ N) :=
  QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
    (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy))

@[simp] theorem PhiHom_mk' {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N) (w : FreeGroup X) :
    PhiHom σ hσ N hInv (QuotientGroup.mk' N w) =
      QuotientGroup.mk' N (FreeGroup.freeGroupCongr σ w) := by
  rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply]
  exact QuotientGroup.map_mk N N (FreeGroup.freeGroupCongr σ).toMonoidHom _ w

theorem PhiHom_involutive {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N)
    (x : FreeGroup X ⧸ N) :
    PhiHom σ hσ N hInv (PhiHom σ hσ N hInv x) = x := by
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective N x
  rw [PhiHom_mk', PhiHom_mk', freeGroupCongr_involutive σ hσ w]

/-- **The `k`-th layer-generation statement.**  See the section comment above. -/
def LayerGen (k : ℕ) : Prop :=
  ∀ {X : Type*} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (N : Subgroup (FreeGroup X)) [N.Normal]
    (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N)
    (hN : Work.Shrinking.pCentralSeries 2 (FreeGroup X) k ≤ N),
    ∀ x ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map (QuotientGroup.mk' N),
      PhiHom σ hσ N hInv x = x →
      x ∈ Subgroup.closure
        ({y : FreeGroup X ⧸ N |
            ∃ a ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map
              (QuotientGroup.mk' N),
              y = PhiHom σ hσ N hInv a * a} ∪
          {y : FreeGroup X ⧸ N |
            ∃ r ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 2)).map
              (QuotientGroup.mk' N),
              (PhiHom σ hσ N hInv r)⁻¹ * r ∈
                (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map
                  (QuotientGroup.mk' N) ∧
              y = (PhiHom σ hσ N hInv r)⁻¹ * r})

/-- **The graded step follows from the layer-generation statements.** -/
theorem gradedStep_of_layerGen (hgen : ∀ k, 1 ≤ k → LayerGen.{u} k) : GradedStep.{u} := by
  intro X _ σ hσ hfree N hNnorm hInv _ k hk x hx hanti
  rcases Nat.eq_zero_or_pos k with rfl | hkpos
  · -- `P_0 = ⊤ ≤ N` forces `N = ⊤`, so the quotient is trivial
    have hNtop : N = ⊤ := top_le_iff.mp (by simpa [Work.Shrinking.pCentralSeries_zero] using hk)
    have hx1 : x = 1 := by
      obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective N x
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff, hNtop]
      exact Subgroup.mem_top u
    exact ⟨1, by rw [hx1]; simp⟩
  · -- main case `k ≥ 1`
    let L : Subgroup (FreeGroup X ⧸ N) :=
      (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map (QuotientGroup.mk' N)
    have hk1 : (k - 1) + 1 = k := Nat.succ_pred_eq_of_pos hkpos
    -- the layer has exponent two
    have hsq : ∀ a ∈ L, a * a = 1 := by
      intro a ha
      obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp ha
      have h1 : (QuotientGroup.mk' N u) * (QuotientGroup.mk' N u)
          = QuotientGroup.mk' N (u * u) :=
        (_root_.map_mul (QuotientGroup.mk' N) u u).symm
      rw [h1, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      have h2 : u ^ 2 ∈ Work.Shrinking.pCentralSeries 2 (FreeGroup X) k :=
        hk1 ▸ Work.Shrinking.pow_mem_pCentralSeries_succ 2 (FreeGroup X) hu
      simpa [pow_two] using hk h2
    have hfix : PhiHom σ hσ N hInv x = x := by
      rw [hanti, inv_eq_of_mul_eq_one_left (hsq x hx)]
    -- the layer is central
    have hcent : ∀ a ∈ L, ∀ y : FreeGroup X ⧸ N, a * y = y * a := by
      intro a ha y
      obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp ha
      obtain ⟨v, rfl⟩ := QuotientGroup.mk'_surjective N y
      have hmem : u * v * u⁻¹ * v⁻¹ ∈ N := by
        have hcomm := (Subgroup.commutator_le.mp
          (Work.Shrinking.commutator_le_pCentralSeries_succ 2 (FreeGroup X) (k - 1)).1)
          u hu v (Subgroup.mem_top v)
        exact hk (hk1 ▸ by simpa [commutatorElement_def, mul_assoc] using hcomm)
      have hthis : (QuotientGroup.mk' N (u * v) : FreeGroup X ⧸ N)
          = QuotientGroup.mk' N (v * u) := by
        rw [QuotientGroup.mk'_apply, QuotientGroup.mk'_apply, QuotientGroup.eq_iff_div_mem]
        simpa [div_eq_mul_inv, mul_assoc] using hmem
      simpa only [QuotientGroup.mk'_apply, QuotientGroup.mk_mul] using hthis
    -- `Φ̄` preserves the layer
    have hPhiL : ∀ a ∈ L, PhiHom σ hσ N hInv a ∈ L := by
      intro a ha
      obtain ⟨u, hu, rfl⟩ := Subgroup.mem_map.mp ha
      rw [PhiHom_mk']
      exact Subgroup.mem_map_of_mem (QuotientGroup.mk' N)
        (map_pCentralSeries_le 2 (FreeGroup.freeGroupCongr σ).toMonoidHom (k - 1)
          (Subgroup.mem_map_of_mem _ hu))
    -- the subgroup of the layer made up of norms
    let T : Subgroup (FreeGroup X ⧸ N) :=
      { carrier := {a | a ∈ L ∧ ∃ r : FreeGroup X ⧸ N,
          (PhiHom σ hσ N hInv r)⁻¹ * r = a}
        one_mem' := ⟨L.one_mem, 1, by simp⟩
        mul_mem' := by
          rintro a b ⟨haL, r, hr⟩ ⟨hbL, s, hs⟩
          refine ⟨L.mul_mem haL hbL, r * s, ?_⟩
          have hcomm : ∀ z : FreeGroup X ⧸ N,
              (PhiHom σ hσ N hInv r)⁻¹ * r * z = z * ((PhiHom σ hσ N hInv r)⁻¹ * r) := by
            intro z
            rw [hr]
            exact hcent a haL z
          have hmul := norm_mul_of_central (PhiHom σ hσ N hInv) r s hcomm
          rw [hmul, hr, hs]
          exact (hcent a haL b).symm
        inv_mem' := by
          rintro a ⟨haL, r, hr⟩
          refine ⟨L.inv_mem haL, PhiHom σ hσ N hInv r, ?_⟩
          rw [PhiHom_involutive σ hσ N hInv r, ← hr]
          group }
    -- both families lie in `T`
    have hfam : Subgroup.closure
        ({y : FreeGroup X ⧸ N |
            ∃ a ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map
              (QuotientGroup.mk' N),
              y = PhiHom σ hσ N hInv a * a} ∪
          {y : FreeGroup X ⧸ N |
            ∃ r ∈ (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 2)).map
              (QuotientGroup.mk' N),
              (PhiHom σ hσ N hInv r)⁻¹ * r ∈
                (Work.Shrinking.pCentralSeries 2 (FreeGroup X) (k - 1)).map
                  (QuotientGroup.mk' N) ∧
              y = (PhiHom σ hσ N hInv r)⁻¹ * r}) ≤ T := by
      refine (Subgroup.closure_le T).2 ?_
      rintro y (⟨a, haL, rfl⟩ | ⟨r, hrL, hrmem, rfl⟩)
      · -- orbit sums: `Φ̄ a * a = (Φ̄ a)⁻¹ * a` since the layer has exponent two
        have ha2 : a * a = 1 := hsq a haL
        have hPha2 : PhiHom σ hσ N hInv a * PhiHom σ hσ N hInv a = 1 := by
          rw [← _root_.map_mul (PhiHom σ hσ N hInv) a a, ha2, _root_.map_one (PhiHom σ hσ N hInv)]
        refine ⟨L.mul_mem (hPhiL a haL) haL, a, ?_⟩
        rw [inv_eq_of_mul_eq_one_left hPha2]
      · exact ⟨hrmem, r, rfl⟩
    obtain ⟨_, r, hr⟩ := hfam (hgen k (Nat.succ_le_of_lt hkpos) σ hσ hfree N hInv hk x hx hfix)
    exact ⟨r, hr.symm⟩

/-- Naturality of Noether's third isomorphism theorem for groups with respect to the maps induced
by an endomorphism `φ`: the diagram relating `(G ⧸ N) ⧸ (M ⧸ N)` and `G ⧸ M` commutes. -/
theorem quotientQuotientEquivQuotient_map_natural {G : Type*} [Group G]
    (N M : Subgroup G) [N.Normal] [M.Normal] (h : N ≤ M) (φ : G →* G)
    (hN : N ≤ Subgroup.comap φ N) (hM : M ≤ Subgroup.comap φ M)
    (hC : Subgroup.map (QuotientGroup.mk' N) M ≤
      Subgroup.comap (QuotientGroup.map N N φ hN) (Subgroup.map (QuotientGroup.mk' N) M)) :
    ∀ y : (G ⧸ N) ⧸ (Subgroup.map (QuotientGroup.mk' N) M),
      (QuotientGroup.quotientQuotientEquivQuotient N M h)
        (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) M)
          (Subgroup.map (QuotientGroup.mk' N) M) (QuotientGroup.map N N φ hN) hC y)
      = (QuotientGroup.map M M φ hM)
          ((QuotientGroup.quotientQuotientEquivQuotient N M h) y) := by
  have hsymm : ∀ g : G,
      (QuotientGroup.quotientQuotientEquivQuotient N M h).symm (QuotientGroup.mk g)
        = QuotientGroup.mk (QuotientGroup.mk' N g) := by
    intro g
    change (QuotientGroup.map M (Subgroup.map (QuotientGroup.mk' N) M) (QuotientGroup.mk' N)
        (Subgroup.le_comap_map (f := QuotientGroup.mk' N) M)) (QuotientGroup.mk g)
      = QuotientGroup.mk (QuotientGroup.mk' N g)
    rw [QuotientGroup.map_mk]
  have hnat : ∀ z : G ⧸ M,
      (QuotientGroup.quotientQuotientEquivQuotient N M h).symm
          ((QuotientGroup.map M M φ hM) z)
        = (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) M)
            (Subgroup.map (QuotientGroup.mk' N) M) (QuotientGroup.map N N φ hN) hC)
          ((QuotientGroup.quotientQuotientEquivQuotient N M h).symm z) := by
    intro z
    obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective z
    have h1 : (QuotientGroup.quotientQuotientEquivQuotient N M h).symm
        ((QuotientGroup.map M M φ hM) (QuotientGroup.mk g))
        = QuotientGroup.mk (QuotientGroup.mk' N (φ g)) := by
      rw [QuotientGroup.map_mk, hsymm]
    have h2 : (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) M)
        (Subgroup.map (QuotientGroup.mk' N) M) (QuotientGroup.map N N φ hN) hC)
        ((QuotientGroup.quotientQuotientEquivQuotient N M h).symm (QuotientGroup.mk g))
        = QuotientGroup.mk (QuotientGroup.mk' N (φ g)) := by
      rw [hsymm, QuotientGroup.map_mk, QuotientGroup.map_mk']
      rfl
    rw [h1, h2]
  intro y
  have hnatized : (QuotientGroup.quotientQuotientEquivQuotient N M h)
      ((QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) M)
        (Subgroup.map (QuotientGroup.mk' N) M) (QuotientGroup.map N N φ hN) hC) y)
      = (QuotientGroup.map M M φ hM)
          ((QuotientGroup.quotientQuotientEquivQuotient N M h) y) := by
    have hh := hnat ((QuotientGroup.quotientQuotientEquivQuotient N M h) y)
    rw [MulEquiv.symm_apply_apply] at hh
    rw [← hh, MulEquiv.apply_symm_apply]
  exact hnatized

end LiftingAux

/-! ## The mechanism behind the graded step, and the exact remaining gap

Write `Φ := FreeGroup.freeGroupCongr σ` and `δ u := Φ u * u⁻¹` (so that `δ u = (Φ u) * u⁻¹` is the
inverse of the norm of `u` used everywhere else: `(Φ u)⁻¹ * u`).  The following three elementary
identities are the *mechanism* of the graded step.

* `delta_mul`: `δ (r * s) = Φ r * δ s * r⁻¹`; `δ` is a crossed homomorphism for `Φ`.
* `delta_sq`: `δ (r * (Φ r)⁻¹) = (δ r)²`.  Every square of a `δ`-value is again a `δ`-value, with
  the witness moved *up*: a witness at `2`-central level `k` therefore produces a norm two levels
  deeper.  This is the "squaring"/quadratic mechanism of the `p = 2` correction.
* `delta_mul_of_central`: on a central layer (where `δ s` is central) `δ` is multiplicative,
  `δ (r * s) = δ s * δ r`; combined with `norm_mul_of_central` this says that the subgroup
  generated by *central* norms consists of norms.

Moreover, for an element `x` of the `k`-th layer `P_{k-1}/P_k` one has `x ^ 2 = 1`
(`P_{k-1} ^ 2 ≤ P_k`), so `δ x = Φ x * x⁻¹ = Φ x * x` is the *orbit sum* of `x`
(`Work.SSGRoute.norm_eq_orbitSum_of_sq_one`), which is a norm with witness inside the layer.  Hence
the whole `(1 + Φ)`-image `(1 + Φ)(P_{k-1}/P_k)` is made of norms.

### The reformulation of the gap

The `k`-th `GradedStep` is equivalent to the following *generation* statement about the free
`2`-central filtration (all quotients `π_N(-)` below are `Subgroup.map (QuotientGroup.mk' N)` and
`Φ̄` is the induced involution on `F ⧸ N`):

> for every fully invariant `N ≥ P_k` and every `Φ̄`-fixed `x ∈ π_N(P_{k-1})`,
> `x` lies in the subgroup generated by
> `{ Φ̄ a * a : a ∈ π_N(P_{k-1}) }` (the orbit sums of the layer, all of them norms by
> `norm_eq_orbitSum_of_sq_one` since the layer has exponent `2`), and
> `{ Φ̄ r * r⁻¹ : r ∈ π_N(P_j), Φ̄ r * r⁻¹ ∈ π_N(P_{k-1}) }` for `j ≤ k - 2` (the `δ`-values of
> lower layers, i.e. the witnesses living below the layer, produced by `delta_sq`).

Equivalently, in the counting form which makes the statement visibly sharp: for `Q = F ⧸ A_k` the
map `x ↦ Φ̄ x * x` has image of cardinality `|Q ^ Φ̄|`, i.e. the anti-fixed set `{x : Φ̄ x = x⁻¹}`
has exactly `[Q : Q ^ Φ̄]` elements, i.e. **every involution of `Q ⋊ ⟨δ⟩` lying outside `Q` is
conjugate to `δ`** (equivalently `H¹(⟨δ⟩, Q)` is trivial in the non-abelian sense).  The
`k ≤ 2` cases of this are the abelian and the class-`2` case, proved in
`SSGRoute/antifixed_abelian_case.lean` and `SSGRoute/class2_central_antifixed_is_norm.lean`; the
first genuinely open case is `k = 3`, i.e. the layer `P_2/P_3` (equivalently: the fixed part of the
free restricted Lie algebra piece `P_2/P_3` is generated by the `(1 + Φ)`-image and by the squares
`[g, Φ̄ g]²`, `g ∈ F ⧸ N` -- the formulation isolated in
`SSGRoute/layer3_fixed_le_closure_orbits_norms.lean`).
-/

namespace LiftingAux

universe u

/-- `δ (r * s) = Φ r * δ s * r⁻¹` where `δ u = Φ u * u⁻¹`: `δ` is a crossed homomorphism. -/
theorem delta_mul {X : Type*} (σ : X ≃ X) (r s : FreeGroup X) :
    FreeGroup.freeGroupCongr σ (r * s) * (r * s)⁻¹
      = FreeGroup.freeGroupCongr σ r * (FreeGroup.freeGroupCongr σ s * s⁻¹) * r⁻¹ := by
  rw [_root_.map_mul (FreeGroup.freeGroupCongr σ) r s, mul_inv_rev]
  group

/-- `δ (r * (Φ r)⁻¹) = (δ r)²`: the square of a `δ`-value is a `δ`-value, with the witness moved
one `2`-central level up. -/
theorem delta_sq {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (r : FreeGroup X) :
    FreeGroup.freeGroupCongr σ (r * (FreeGroup.freeGroupCongr σ r)⁻¹)
        * (r * (FreeGroup.freeGroupCongr σ r)⁻¹)⁻¹
      = (FreeGroup.freeGroupCongr σ r * r⁻¹)
          * (FreeGroup.freeGroupCongr σ r * r⁻¹) := by
  have hL : FreeGroup.freeGroupCongr σ (r * (FreeGroup.freeGroupCongr σ r)⁻¹)
      = FreeGroup.freeGroupCongr σ r * r⁻¹ := by
    rw [_root_.map_mul (FreeGroup.freeGroupCongr σ) r ((FreeGroup.freeGroupCongr σ r)⁻¹),
      _root_.map_inv (FreeGroup.freeGroupCongr σ) (FreeGroup.freeGroupCongr σ r),
      freeGroupCongr_involutive σ hσ r]
  have hR : (r * (FreeGroup.freeGroupCongr σ r)⁻¹)⁻¹
      = FreeGroup.freeGroupCongr σ r * r⁻¹ := by
    rw [mul_inv_rev, inv_inv]
  rw [hL, hR]

/-- On a central layer `δ` is multiplicative: if `δ s` is central then
`δ (r * s) = δ s * δ r`. -/
theorem delta_mul_of_central {X : Type*} (σ : X ≃ X) (r s : FreeGroup X)
    (h : ∀ y : FreeGroup X, (FreeGroup.freeGroupCongr σ s * s⁻¹) * y
      = y * (FreeGroup.freeGroupCongr σ s * s⁻¹)) :
    FreeGroup.freeGroupCongr σ (r * s) * (r * s)⁻¹
      = (FreeGroup.freeGroupCongr σ s * s⁻¹)
          * (FreeGroup.freeGroupCongr σ r * r⁻¹) := by
  rw [delta_mul, ← h (FreeGroup.freeGroupCongr σ r)]
  group

end LiftingAux

/-! ## The descent along the `2`-central filtration -/

namespace LiftingAux

universe u

/-- **The norm statement for all `N ⊇ P_k`, by descending induction on `k`.** -/
theorem normStatement_of_pCentralSeries_le (hgraded : GradedStep.{u})
    {X : Type u} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x) :
    ∀ (k : ℕ) (N : Subgroup (FreeGroup X)) [N.Normal]
      (hInv : ∀ f : FreeGroup X →* FreeGroup X, N.map f ≤ N),
      Work.Shrinking.pCentralSeries 2 (FreeGroup X) k ≤ N →
      ∀ x : FreeGroup X ⧸ N,
        (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
          (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy))) x = x⁻¹ →
        ∃ r : FreeGroup X ⧸ N,
          x = (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom
                (fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy)) r)⁻¹ * r := by
  intro k
  induction k with
  | zero =>
      intro N _ hInv hk x hx
      have hNtop : N = ⊤ := top_le_iff.mp (by simpa [Work.Shrinking.pCentralSeries_zero] using hk)
      refine ⟨1, ?_⟩
      have hx1 : x = 1 := by
        obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective x
        rw [QuotientGroup.eq_one_iff]
        rw [hNtop]
        exact Subgroup.mem_top w
      rw [hx1]
      simp
  | succ k ih =>
      intro N hNnorm hInv hk x hx
      set A : Subgroup (FreeGroup X) := Work.Shrinking.pCentralSeries 2 (FreeGroup X) k with hA
      haveI hAnorm : A.Normal := by
        rw [hA]; exact Work.Shrinking.pCentralSeries_normal 2 (FreeGroup X) k
      have hInvA : ∀ f : FreeGroup X →* FreeGroup X, A.map f ≤ A := by
        intro f; rw [hA]; exact map_pCentralSeries_le 2 f k
      haveI hsupnorm : (A ⊔ N).Normal := inferInstance
      have hInvSup : ∀ f : FreeGroup X →* FreeGroup X, (A ⊔ N).map f ≤ A ⊔ N := by
        intro f
        rw [Subgroup.map_sup]
        exact sup_le (le_trans (hInvA f) le_sup_left) (le_trans (hInv f) le_sup_right)
      have hle : A ≤ A ⊔ N := le_sup_left
      haveI hFinN : Finite (FreeGroup X ⧸ N) := finite_quotient_pCentralSeries (k + 1) N hk
      haveI hCnorm : (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N)).Normal :=
        Subgroup.Normal.map hsupnorm _ (QuotientGroup.mk'_surjective N)
      have hCeq : Subgroup.map (QuotientGroup.mk' N) (A ⊔ N)
          = Subgroup.map (QuotientGroup.mk' N) A := by
        rw [Subgroup.map_sup]
        have hbot : Subgroup.map (QuotientGroup.mk' N) N = (⊥ : Subgroup (FreeGroup X ⧸ N)) := by
          refine le_antisymm ?_ bot_le
          intro z hz
          rw [Subgroup.mem_bot]
          obtain ⟨n, hn, rfl⟩ := Subgroup.mem_map.mp hz
          exact (QuotientGroup.eq_one_iff n).mpr hn
        rw [hbot]
        exact sup_bot_eq _
      have hNinv : N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom N :=
        fun y hy => hInv _ (Subgroup.mem_map_of_mem _ hy)
      have hMminv : A ⊔ N ≤ Subgroup.comap (FreeGroup.freeGroupCongr σ).toMonoidHom (A ⊔ N) :=
        fun y hy => hInvSup _ (Subgroup.mem_map_of_mem _ hy)
      have hCstab : Subgroup.map (QuotientGroup.mk' N) (A ⊔ N) ≤
          Subgroup.comap (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv)
            (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N)) := by
        intro y hy
        obtain ⟨y', hy', rfl⟩ := Subgroup.mem_map.mp hy
        have hyinv : FreeGroup.freeGroupCongr σ y' ∈ A ⊔ N :=
          hInvSup (FreeGroup.freeGroupCongr σ).toMonoidHom
            (Subgroup.mem_map_of_mem (FreeGroup.freeGroupCongr σ).toMonoidHom hy')
        exact Subgroup.mem_map_of_mem (QuotientGroup.mk' N) hyinv
      have hcent : ∀ (c : Subgroup.map (QuotientGroup.mk' N) (A ⊔ N)) (y : FreeGroup X ⧸ N),
          (c : FreeGroup X ⧸ N) * y = y * (c : FreeGroup X ⧸ N) := by
        rintro ⟨c, hc⟩ y
        rw [hCeq] at hc
        obtain ⟨a, ha, rfl⟩ := Subgroup.mem_map.mp hc
        obtain ⟨g, rfl⟩ := QuotientGroup.mk_surjective y
        have hmem : a * g * a⁻¹ * g⁻¹ ∈ N := by
          have hcomm := (Subgroup.commutator_le.mp
            (Work.Shrinking.commutator_le_pCentralSeries_succ 2 (FreeGroup X) k).1)
            a ha g (Subgroup.mem_top g)
          exact hk (by simpa [commutatorElement_def, mul_assoc] using hcomm)
        have hthis : (QuotientGroup.mk (a * g) : FreeGroup X ⧸ N) = QuotientGroup.mk (g * a) := by
          rw [QuotientGroup.eq_iff_div_mem]
          simpa [div_eq_mul_inv, mul_assoc] using hmem
        simpa [QuotientGroup.mk_mul] using hthis
      have hstep : ∀ c : Subgroup.map (QuotientGroup.mk' N) (A ⊔ N),
          (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv) (c : FreeGroup X ⧸ N)
            = (c : FreeGroup X ⧸ N)⁻¹ →
          ∃ e : FreeGroup X ⧸ N,
            (c : FreeGroup X ⧸ N)
              = ((QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv) e)⁻¹ * e := by
        rintro ⟨c, hc⟩ hfix
        rw [hCeq] at hc
        exact hgraded σ hσ hfree N hInv (k + 1) hk (c : FreeGroup X ⧸ N) hc hfix
      have hquot : ∀ y : (FreeGroup X ⧸ N) ⧸ Subgroup.map (QuotientGroup.mk' N) (A ⊔ N),
          (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
            (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
            (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv) hCstab) y = y⁻¹ →
          ∃ r : (FreeGroup X ⧸ N) ⧸ Subgroup.map (QuotientGroup.mk' N) (A ⊔ N),
            y = (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
                  (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
                  (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv)
                  hCstab r)⁻¹ * r := by
        intro y hy
        have hnat := quotientQuotientEquivQuotient_map_natural N (A ⊔ N) le_sup_right
          (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv hMminv hCstab
        have hsymmnat : ∀ z : FreeGroup X ⧸ (A ⊔ N),
            (QuotientGroup.map (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
              (Subgroup.map (QuotientGroup.mk' N) (A ⊔ N))
              (QuotientGroup.map N N (FreeGroup.freeGroupCongr σ).toMonoidHom hNinv) hCstab)
              ((QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right).symm z)
            = (QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right).symm
                ((QuotientGroup.map (A ⊔ N) (A ⊔ N)
                  (FreeGroup.freeGroupCongr σ).toMonoidHom hMminv) z) := by
          intro z
          have h := hnat ((QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right).symm z)
          rw [MulEquiv.apply_symm_apply] at h
          have h2 := congrArg (fun t => (QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N)
            le_sup_right).symm t) h
          simpa using h2
        have hz : (QuotientGroup.map (A ⊔ N) (A ⊔ N) (FreeGroup.freeGroupCongr σ).toMonoidHom hMminv)
            ((QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right) y)
            = ((QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right) y)⁻¹ := by
          rw [← hnat y, hy, _root_.map_inv]
        obtain ⟨r, hr⟩ := ih (A ⊔ N) hInvSup hle
          ((QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right) y) hz
        refine ⟨(QuotientGroup.quotientQuotientEquivQuotient N (A ⊔ N) le_sup_right).symm r, ?_⟩
        have hh := hsymmnat r
        rw [hh, ← _root_.map_inv, ← _root_.map_mul, ← hr, MulEquiv.symm_apply_apply]
      exact central_descent_antifixed_weak (FreeGroup X ⧸ N) (quotientInv σ hσ N hNinv) (by
        refine MulEquiv.ext (fun y => ?_)
        obtain ⟨w, rfl⟩ := QuotientGroup.mk_surjective y
        show quotientInv σ hσ N hNinv (quotientInv σ hσ N hNinv (QuotientGroup.mk w))
          = QuotientGroup.mk w
        rw [quotientInv_mk, quotientInv_mk]
        exact congrArg QuotientGroup.mk (freeGroupCongr_involutive σ hσ w))
        _ hCstab hcent hstep hquot x hx

/-- The norm statement for Schmidt–Wingberg's refined terms, for a finite free basis. -/
theorem normStatement_refinedTerm_finite (hgraded : GradedStep.{u})
    {X : Type u} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (i j : ℕ) :
    ∀ x : FreeGroup X ⧸ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
      (QuotientGroup.map (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j)
        (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j)
        (FreeGroup.freeGroupCongr σ).toMonoidHom
        (fun y hy => (refinedTerm_map_le 2 (FreeGroup.freeGroupCongr σ).toMonoidHom i j)
          (Subgroup.mem_map_of_mem _ hy))) x = x⁻¹ →
      ∃ r : FreeGroup X ⧸ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        x = (QuotientGroup.map (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j)
              (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j)
              (FreeGroup.freeGroupCongr σ).toMonoidHom
              (fun y hy => (refinedTerm_map_le 2 (FreeGroup.freeGroupCongr σ).toMonoidHom i j)
                (Subgroup.mem_map_of_mem _ hy)) r)⁻¹ * r := by
  intro x hx
  have hk : Work.Shrinking.pCentralSeries 2 (FreeGroup X) i ≤
      Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j := by
    rw [Work.CohomologicalShrinking.refinedTerm]
    exact le_sup_right
  exact normStatement_of_pCentralSeries_le hgraded σ hσ hfree i _ (fun f => refinedTerm_map_le 2 f i j)
    hk x hx

/-- The lifting statement for Schmidt–Wingberg's refined terms, for a finite free basis. -/
theorem freeGroup_refinedTerm_lifting_finite (hgraded : GradedStep.{u})
    {X : Type u} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (i j : ℕ) :
    ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ w * w ∈
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        FreeGroup.freeGroupCongr σ (w * n) * (w * n) = 1 :=
  lifting_of_target σ hσ (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j)
    (fun y hy => (refinedTerm_map_le 2 (FreeGroup.freeGroupCongr σ).toMonoidHom i j)
      (Subgroup.mem_map_of_mem _ hy))
    (normStatement_refinedTerm_finite hgraded σ hσ hfree i j)

/-- **The theorem for arbitrary `X`**, assuming the finite case: a word involves only finitely many
letters, so one restricts to the finite `σ`-stable free factor generated by them. -/
theorem freeGroup_refinedTerm_lifting_of_finite
    (hfin : ∀ {Y : Type u} [Finite Y] (τ : Y ≃ Y) (hτ : ∀ y, τ (τ y) = y) (hfr : ∀ y, τ y ≠ y)
      (i j : ℕ),
      ∀ w : FreeGroup Y, FreeGroup.freeGroupCongr τ w * w ∈
          Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j →
        ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j,
          FreeGroup.freeGroupCongr τ (w * n) * (w * n) = 1)
    {X : Type u} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x) (i j : ℕ) :
    ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ w * w ∈
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        FreeGroup.freeGroupCongr σ (w * n) * (w * n) = 1 := by
  classical
  intro w hw
  let S : Finset X := (FreeGroup.toWord w).toFinset.image Prod.fst ∪
    (FreeGroup.toWord w).toFinset.image (fun p => σ p.1)
  let X₀ : Set X := ↑S
  have hstable : ∀ x ∈ X₀, σ x ∈ X₀ := by
    intro x hx
    have hx' : x ∈ S := hx
    rcases Finset.mem_union.mp hx' with h | h
    · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp h
      exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨p, hp, rfl⟩)
    · obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp h
      rw [hσ]
      exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨p, hp, rfl⟩)
  have hletters : ∀ p ∈ FreeGroup.toWord w, p.1 ∈ X₀ := by
    intro p hp
    exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨p, List.mem_toFinset.mpr hp, rfl⟩)
  haveI : Finite X₀ := S.finite_toSet.to_subtype
  let σ₀ : X₀ ≃ X₀ :=
    { toFun := fun x => ⟨σ x, hstable x x.2⟩
      invFun := fun x => ⟨σ x, hstable x x.2⟩
      left_inv := fun x => Subtype.ext (hσ x)
      right_inv := fun x => Subtype.ext (hσ x) }
  have hσ₀ : ∀ x, σ₀ (σ₀ x) = x := fun x => Subtype.ext (hσ x)
  have hfree₀ : ∀ x : X₀, σ₀ x ≠ x := fun x hx => hfree x (Subtype.ext_iff.mp hx)
  have hcomp : ∀ x : X₀, (Subtype.val : X₀ → X) (σ₀ x) = σ (Subtype.val x) := fun x => rfl
  obtain ⟨v, hv⟩ := exists_map_subtype_eq_of_toWord X₀ w hletters
  have hmapv : ∀ y : FreeGroup X₀,
      FreeGroup.map (Subtype.val : X₀ → X) (FreeGroup.freeGroupCongr σ₀ y)
        = FreeGroup.freeGroupCongr σ (FreeGroup.map (Subtype.val : X₀ → X) y) :=
    freeGroup_map_freeGroupCongr_comm (Subtype.val : X₀ → X) σ₀ σ hcomp
  have hmapmul : FreeGroup.map (Subtype.val : X₀ → X) (FreeGroup.freeGroupCongr σ₀ v * v)
      = FreeGroup.freeGroupCongr σ w * w := by
    rw [_root_.map_mul (FreeGroup.map (Subtype.val : X₀ → X)), hmapv v, hv]
  have hmemr : FreeGroup.freeGroupCongr σ w * w ∈ (FreeGroup.map (Subtype.val : X₀ → X)).range :=
    ⟨FreeGroup.freeGroupCongr σ₀ v * v, hmapmul⟩
  obtain ⟨u, hu, huP⟩ := refinedTerm_inter_freeFactor X₀ i j _ hmemr hw
  have hinj : Function.Injective (FreeGroup.map (Subtype.val : X₀ → X)) :=
    FreeGroup.map_injective Subtype.val_injective
  have huv : FreeGroup.freeGroupCongr σ₀ v * v = u := by
    apply hinj
    rw [hu, hmapmul]
  have huvP : FreeGroup.freeGroupCongr σ₀ v * v ∈
      Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X₀) i j := huv ▸ huP
  obtain ⟨n₀, hn₀P, hn₀⟩ := hfin σ₀ hσ₀ hfree₀ i j v huvP
  refine ⟨FreeGroup.map (Subtype.val : X₀ → X) n₀, ?_, ?_⟩
  · exact refinedTerm_map_le 2 (FreeGroup.map (Subtype.val : X₀ → X)) i j
      (Subgroup.mem_map_of_mem _ hn₀P)
  · have h2 : FreeGroup.freeGroupCongr σ
        (FreeGroup.map (Subtype.val : X₀ → X) (v * n₀))
          * FreeGroup.map (Subtype.val : X₀ → X) (v * n₀) = 1 := by
      rw [← hmapv (v * n₀), ← _root_.map_mul, hn₀, _root_.map_one]
    rwa [_root_.map_mul, hv] at h2

end LiftingAux

/-! ## The lifting statement as a predicate -/

/-- **The lifting statement** for the free group `FreeGroup X` with the involution `σ` of its basis
and the refined term `P = refinedTerm 2 (FreeGroup X) i j`: every `w` with `Φ w * w ∈ P` has a
translation `w * n` (`n ∈ P`) which is exactly anti-fixed. -/
def LiftingAt (X : Type*) (σ : X ≃ X) (i j : ℕ) : Prop :=
  ∀ w : FreeGroup X,
    (FreeGroup.freeGroupCongr σ w) * w ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
    ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
      (FreeGroup.freeGroupCongr σ (w * n)) * (w * n) = 1

universe u

/-- **The main theorem from its "good range"**, i.e. with the two boundary configurations of the
refined term removed: the remaining input is the lifting statement for a finite free basis with a
fixed-point-free involution and `1 ≤ j ≤ i`. -/
theorem freeGroup_refinedTerm_lifting_of_range
    (hrange : ∀ {Y : Type u} [Finite Y] (τ : Y ≃ Y) (hτ : ∀ y, τ (τ y) = y)
      (hfr : ∀ y, τ y ≠ y) (i j : ℕ), 1 ≤ j → j ≤ i →
      ∀ w : FreeGroup Y, FreeGroup.freeGroupCongr τ w * w ∈
          Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j →
        ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j,
          FreeGroup.freeGroupCongr τ (w * n) * (w * n) = 1)
    {X : Type u} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x) (i j : ℕ) :
    ∀ w : FreeGroup X, (FreeGroup.freeGroupCongr σ w) * w ∈
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        (FreeGroup.freeGroupCongr σ (w * n)) * (w * n) = 1 :=
  LiftingAux.freeGroup_refinedTerm_lifting_of_finite
    (fun {Y} _ τ hτ hfr i j => LiftingAux.freeGroup_refinedTerm_lifting_finite_of_range
      hrange τ hτ hfr i j)
    σ hσ hfree i j


namespace LiftingAux

/-- A bijection of bases `e : X ≃ Y` with `e (σ x) = τ (e x)` transports `LiftingAt` from
`(X, σ)` to `(Y, τ)`.  (A copy of `Work.SSGRoute.liftingAt_of_equiv`, kept here so that this file
does not depend on modules that import it.) -/
theorem liftingAt_of_equiv {X Y : Type*} (e : X ≃ Y) (σ : X ≃ X) (τ : Y ≃ Y)
    (h : ∀ x, e (σ x) = τ (e x)) (i j : ℕ) :
    LiftingAt X σ i j → LiftingAt Y τ i j := by
  intro hX w hw
  have hle_fwd : (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j).map
      (FreeGroup.map (e : X → Y)) ≤
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j :=
    refinedTerm_map_le 2 (FreeGroup.map (e : X → Y)) i j
  have hle_bwd : (Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j).map
      (FreeGroup.map (e.symm : Y → X)) ≤
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j :=
    refinedTerm_map_le 2 (FreeGroup.map (e.symm : Y → X)) i j
  obtain ⟨v, hv⟩ : ∃ v : FreeGroup X, FreeGroup.map (e : X → Y) v = w :=
    FreeGroup.map_surjective e.surjective w
  have hnat : ∀ u : FreeGroup X, FreeGroup.map (e : X → Y) (FreeGroup.freeGroupCongr σ u)
      = FreeGroup.freeGroupCongr τ (FreeGroup.map (e : X → Y) u) :=
    fun u => freeGroup_map_freeGroupCongr_comm (e : X → Y) σ τ h u
  have hsymm : ∀ x : FreeGroup X,
      FreeGroup.map (e.symm : Y → X) (FreeGroup.map (e : X → Y) x) = x := by
    intro x
    have h1 : (FreeGroup.freeGroupCongr e).symm (FreeGroup.freeGroupCongr e x) = x :=
      MulEquiv.symm_apply_apply _ _
    rw [FreeGroup.freeGroupCongr_symm] at h1
    simpa using h1
  have hx : FreeGroup.freeGroupCongr σ v * v
      ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j := by
    have hmem : FreeGroup.map (e : X → Y) (FreeGroup.freeGroupCongr σ v * v)
        ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup Y) i j := by
      rw [MonoidHom.map_mul, hnat v, hv]
      exact hw
    have hmem2 := Subgroup.mem_map_of_mem (FreeGroup.map (e.symm : Y → X)) hmem
    rw [hsymm] at hmem2
    exact hle_bwd hmem2
  obtain ⟨n, hnP, hn⟩ := hX v hx
  refine ⟨FreeGroup.map (e : X → Y) n, ?_, ?_⟩
  · exact hle_fwd (Subgroup.mem_map_of_mem _ hnP)
  · have h2 : FreeGroup.freeGroupCongr τ (FreeGroup.map (e : X → Y) (v * n))
        * (FreeGroup.map (e : X → Y) (v * n)) = 1 := by
      have h3 := congrArg (FreeGroup.map (e : X → Y)) hn
      rw [MonoidHom.map_one, MonoidHom.map_mul, hnat (v * n)] at h3
      exact h3
    rw [MonoidHom.map_mul, hv] at h2
    exact h2

/-- **The model case gives the finite good-range case.**  By `exists_equiv_fin_mul_zmodTwo` a
finite basis with a fixed-point-free involution is `σ`-equivariantly `Fin d × Multiplicative
(ZMod 2)` with the generating involution, and `liftingAt_of_equiv` transports the statement; so it
suffices to know the statement for the standard model `Fin d × Multiplicative (ZMod 2)`. -/
theorem of_finite_involutive
    (hmodel : ∀ (d i j : ℕ), 1 ≤ j → j ≤ i → LiftingAt (Fin d × Multiplicative (ZMod 2))
      (Work.Shrinking.freeOperatorGenPerm d (Multiplicative.ofAdd (1 : ZMod 2))) i j)
    {X : Type u} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (i j : ℕ) (h1 : 1 ≤ j) (h2 : j ≤ i) : LiftingAt X σ i j := by
  obtain ⟨d, e, he⟩ := exists_equiv_fin_mul_zmodTwo σ hσ hfree
  refine liftingAt_of_equiv e.symm
    (Work.Shrinking.freeOperatorGenPerm d (Multiplicative.ofAdd (1 : ZMod 2))) σ ?_ i j
    (hmodel d i j h1 h2)
  intro y
  have h2' : e (σ (e.symm y)) = Work.Shrinking.freeOperatorGenPerm d
      (Multiplicative.ofAdd (1 : ZMod 2)) y := by
    simpa using he (e.symm y)
  exact e.injective (by simpa using h2'.symm)

end LiftingAux


/-- **The finite case of the main theorem from the layer-generation statements.** -/
theorem LiftingAux.freeGroup_refinedTerm_lifting_finite_of_layerGen
    (h : ∀ k, 1 ≤ k → LiftingAux.LayerGen.{u} k)
    {X : Type u} [Finite X] (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x)
    (i j : ℕ) :
    ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ w * w ∈
        Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        FreeGroup.freeGroupCongr σ (w * n) * (w * n) = 1 :=
  LiftingAux.freeGroup_refinedTerm_lifting_finite (LiftingAux.gradedStep_of_layerGen h) σ hσ hfree i j

/-- **The main theorem from the layer-generation statements** (arbitrary basis). -/
theorem LiftingAux.freeGroup_refinedTerm_lifting_of_layerGen (h : ∀ k, 1 ≤ k → LiftingAux.LayerGen.{u} k) :
    ∀ {X : Type u} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x) (i j : ℕ),
      ∀ w : FreeGroup X, FreeGroup.freeGroupCongr σ w * w ∈
