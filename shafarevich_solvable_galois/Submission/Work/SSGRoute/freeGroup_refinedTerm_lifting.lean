/-! ## The main theorem -/

theorem freeGroup_refinedTerm_lifting
    {X : Type*} (σ : X ≃ X) (hσ : ∀ x, σ (σ x) = x) (hfree : ∀ x, σ x ≠ x) (i j : ℕ) :
    ∀ w : FreeGroup X, (FreeGroup.freeGroupCongr σ w) * w ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j →
      ∃ n ∈ Work.CohomologicalShrinking.refinedTerm 2 (FreeGroup X) i j,
        (FreeGroup.freeGroupCongr σ (w * n)) * (w * n) = 1 := by
  -- Everything except ONE named input is assembled in this file.
  --
  -- Proved here (see the section comments above):
  -- * `LiftingAux.lifting_of_target` : the anti-fixed-lift statement is the norm statement.
  -- * `LiftingAux.normStatement_of_pCentralSeries_le` : the descent along the `2`-central
  --   filtration, from the graded step `LiftingAux.GradedStep`.
  -- * `LiftingAux.freeGroup_refinedTerm_lifting_of_finite` : the reduction from an arbitrary basis
  --   to a finite `σ`-stable free factor; `LiftingAux.freeGroup_refinedTerm_lifting_finite` : the
  --   finite case from the graded step.
  -- * `LiftingAux.refinedTerm_eq_of_le_one` / `refinedTerm_eq_of_ge`, `liftingAt_of_equiv`,
  --   `of_finite_involutive`, `freeGroup_refinedTerm_lifting_of_range` : boundary cases and the
  --   reduction to the model `Fin d × Multiplicative (ZMod 2)` (an alternative route, kept here).
  -- * `delta_mul`, `delta_sq`, `delta_mul_of_central`, and the (now vacuous)
  --   `LiftingAux.gradedStep_of_layerGen` : the layer-generation route, refuted for `k ≥ 4` — see
  --   the WARNING in the module docstring.  `LiftingAux.LayerGen` is kept only because the sibling
  --   modules `layerGen_one/two/three` and `layerGen_split` are stated in terms of it.
  --
  -- NOTE (second repair): the earlier plan of taking the graded step `LiftingAux.GradedStep` as the
  -- single input is dead — that statement is FALSE at `|X| = 4`, `k = 4`
  -- (`NOTES_refinedTerm_graded_norm_REFUTED.md`), so the descent along the unrefined `2`-central
  -- filtration cannot be completed (see the module docstring).
  -- The remaining input is the *model case* for the standard basis, i.e. the target of the
  -- surviving flow / refined-pair route.  See the module docstring: the earlier reduction to
  -- `LiftingAux.GradedStep` is refuted (`NOTES_refinedTerm_graded_norm_REFUTED.md`).
  have hmodel : ∀ (d i j : ℕ), 1 ≤ j → j ≤ i →
      LiftingAt (Fin d × Multiplicative (ZMod 2))
        (Work.Shrinking.freeOperatorGenPerm d (Multiplicative.ofAdd (1 : ZMod 2))) i j := by
    sorry
  intro w hw
  exact LiftingAux.freeGroup_refinedTerm_lifting_of_modelRange hmodel σ hσ hfree i j w hw

end Work.SSGRoute
