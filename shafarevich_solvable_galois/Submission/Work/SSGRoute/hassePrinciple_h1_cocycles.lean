/-!
# The Hasse principle for continuous `1`-cocycles

Let `k` be a number field, `Ω` an algebraic closure of `k`, `K ⊆ Ω` a finite Galois extension of
`k` and `M` a finite `𝔽_p[Gal(K/k)]`-module.  A locally constant `1`-cocycle
`φ : G_k → M` for the restriction map `res : G_k → Gal(K/k)` which is a *coboundary* on the
decomposition group of every finite place and on the group generated by every involution descends
to a `1`-cocycle `ψ : Gal(K/k) → M`, i.e. `φ = ψ ∘ res`.

The mathematical content is the Hasse principle for `H¹(k, M)` (a locally trivial class is
trivial), together with the fact that a class in `H¹(k,M)` killed by restriction to `G_K` comes
from `H¹(Gal(K/k), M)`.  Concretely, since `φ` vanishes on an open subgroup of `G_k`, the kernel
`H` of `φ|G_K` is an open normal subgroup of `G_k` lying in `G_K`; the field `F` it fixes is
finite and normal over `k` (child lemma `fixedField_of_le_fixingSubgroup`), the local coboundary
conditions say that the decomposition group of every finite place of `Ω` lies in `H` (i.e. that
every place splits completely in `F/K`), and Bauer's theorem in the form
`eq_of_place_le_fixingSubgroup` below then forces `F = K`.  Consequently `φ` vanishes on `G_K`,
and the descent lemma `factorCocycle_of_vanishingOn_ker` produces `ψ`.
-/

namespace Work.SSGRoute

open scoped Pointwise Topology

set_option linter.style.haveILetI false

section Elementary

variable {k Ω : Type} [Field k] [Field Ω] [Algebra k Ω]
variable {M : Type} [AddCommGroup M]

/-- The value at `1` of a `1`-cocycle with values in an abelian group is `0`. -/
lemma cocycle_apply_one (K : IntermediateField k Ω) [Normal k K]
    [DistribMulAction (K ≃ₐ[k] K) M] {φ : (Ω ≃ₐ[k] Ω) → M}
    (hφ : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ φ) : φ 1 = 0 := by
  have h : φ 1 = φ 1 + φ 1 := by simpa using hφ 1 trivial 1 trivial
  exact (add_left_cancel (by rw [add_zero]; exact h)).symm

/-- A `1`-cocycle is constant along the kernel of its action homomorphism. -/
lemma cocycle_mul_eq_of_apply_eq_zero (K : IntermediateField k Ω) [Normal k K]
    [DistribMulAction (K ≃ₐ[k] K) M] {φ : (Ω ≃ₐ[k] Ω) → M}
    (hφ : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ φ) {h : Ω ≃ₐ[k] Ω}
    (hh0 : φ h = 0) (g : Ω ≃ₐ[k] Ω) : φ (g * h) = φ g := by
  have h1 := hφ g trivial h trivial
  rw [hh0, smul_zero, add_zero] at h1
  exact h1

end Elementary

/-- **Bauer's theorem**: finite normal subextensions of `Ω/k` whose decomposition groups at every
finite place are contained one in the other are contained one in the other.

If `K ≤ F` and the decomposition group `D_A` of every finite place `A` of `Ω` meets
`Gal(Ω/K)` inside `Gal(Ω/F)`, then `F = K`.  Indeed, such a place has its decomposition group in
`Gal(Ω/K)` exactly when its prime splits completely in `K`
(`NK.Reconstruct.stabilizer_le_fixingSubgroup_iff_splitCompletely`); hence every prime splitting
completely in `K` splits completely in `F`, and the completely split primes determine a normal
subextension (`Work.SSGRoute.le_of_splitPrimesSet_off_finite`). -/
theorem eq_of_place_le_fixingSubgroup (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K F : IntermediateField k Ω) [FiniteDimensional k K] [Normal k K]
    [FiniteDimensional k F] [Normal k F] (hKF : K ≤ F)
    (h : ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A →
      SSGRoute.decomp k A ⊓ K.fixingSubgroup ≤ F.fixingSubgroup) :
    F = K := by
  haveI : NumberField ↥K := Commons.NumberTheory.NumberField.numberField_of_intermediateField K
  haveI : NumberField ↥F := Commons.NumberTheory.NumberField.numberField_of_intermediateField F
  -- every prime splitting completely in `K` splits completely in `F`
  have hsub : NK.Reconstruct.splitPrimesSet k ↥K ⊆ NK.Reconstruct.splitPrimesSet k ↥F := by
    intro p hp
    obtain ⟨A, hA⟩ :=
      Commons.NumberTheory.NumberField.Valuation.exists_valuationSubring_at_prime (K := k) (K' := Ω) p
    have hAne : A.comap (algebraMap k Ω) ≠ ⊤ := by
      rw [hA]
      exact Commons.RingTheory.Valuation.valuationSubringAtPrime_ne_top (K := k) p
    have hbridgeK : SSGRoute.decomp k A ≤ K.fixingSubgroup :=
      (NK.Reconstruct.stabilizer_le_fixingSubgroup_iff_splitCompletely (K := k) (K' := Ω) (N := K)
        p A hA).mpr hp
    have hleF : SSGRoute.decomp k A ≤ F.fixingSubgroup :=
      le_trans (le_inf le_rfl hbridgeK) (h A hAne)
    exact (NK.Reconstruct.stabilizer_le_fixingSubgroup_iff_splitCompletely (K := k) (K' := Ω) (N := F)
      p A hA).mp hleF
  have hFK : F ≤ K :=
    le_of_splitPrimesSet_off_finite (K := k) (Ω := Ω) F K
      (∅ : Set (NK.Chebotarev.PrimeIdeal k)) Set.finite_empty (fun p _ hp => hsub hp)
  exact le_antisymm hFK hKF

theorem hassePrinciple_h1_cocycles (k Ω : Type) [Field k] [NumberField k] [Field Ω] [Algebra k Ω]
    [IsAlgClosure k Ω] (K : IntermediateField k Ω) [FiniteDimensional k K] [IsGalois k K]
    [Fintype (K ≃ₐ[k] K)] (p : ℕ) [Fact p.Prime] (M : Type) [AddCommGroup M] [Module (ZMod p) M]
    [DistribMulAction (K ≃ₐ[k] K) M] [SMulCommClass (K ≃ₐ[k] K) (ZMod p) M] [Finite M]
    (φ : (Ω ≃ₐ[k] Ω) → M) (hφ : SSGRoute.IsCocycleOn (SSGRoute.res k K) ⊤ φ)
    (hc : SSGRoute.IsLocConstOn ⊤ φ)
    (hloc : ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (SSGRoute.decomp k A) φ)
    (hinf : ∀ σ : Ω ≃ₐ[k] Ω, σ ^ 2 = 1 →
      SSGRoute.IsCoboundaryOn (SSGRoute.res k K) (Subgroup.zpowers σ) φ) :
    ∃ ψ : (K ≃ₐ[k] K) → M,
      SSGRoute.IsCocycleOn (MonoidHom.id (K ≃ₐ[k] K)) ⊤ ψ ∧ φ = ψ ∘ (SSGRoute.res k K) := by
  classical
  -- ## `φ` vanishes on an open subgroup of `G_k`
  obtain ⟨U, hUopen, hUconst⟩ := hc
  have hφ1 : φ 1 = 0 := cocycle_apply_one K hφ
  have hUzero : ∀ u : Ω ≃ₐ[k] Ω, u ∈ U → φ u = 0 := by
    intro u hu
    have h := hUconst 1 trivial u hu trivial
    rw [one_mul] at h
    rw [h, hφ1]
  -- ## a finite normal `E` with `E.fixingSubgroup ≤ U`
  have hUnhds : (U : Set (Ω ≃ₐ[k] Ω)) ∈ 𝓝 (1 : Ω ≃ₐ[k] Ω) :=
    hUopen.mem_nhds U.one_mem
  obtain ⟨E, hEfin, hEnorm, hEU⟩ :=
    (krullTopology_mem_nhds_one_iff_of_normal k Ω (U : Set (Ω ≃ₐ[k] Ω))).mp hUnhds
  haveI hEfinI : FiniteDimensional k E := hEfin
  haveI hEnormI : Normal k E := hEnorm
  -- ## the subgroup `H` of `G_k` fixing `K` on which `φ` vanishes
  let H : Subgroup (Ω ≃ₐ[k] Ω) :=
    { carrier := {σ | σ ∈ K.fixingSubgroup ∧ φ σ = 0}
      mul_mem' := by
        rintro σ τ ⟨hσK, hσ0⟩ ⟨hτK, hτ0⟩
        exact ⟨K.fixingSubgroup.mul_mem hσK hτK, by
          have h := hφ σ trivial τ trivial
          rw [hσ0, hτ0, smul_zero, zero_add] at h
          exact h⟩
      one_mem' := ⟨K.fixingSubgroup.one_mem, hφ1⟩
      inv_mem' := by
        rintro σ ⟨hσK, hσ0⟩
        refine ⟨K.fixingSubgroup.inv_mem hσK, ?_⟩
        have h := hφ σ trivial σ⁻¹ trivial
        rw [mul_inv_cancel, hσ0, hφ1, zero_add] at h
        have h2 := congrArg (fun x : M => (SSGRoute.res k K σ)⁻¹ • x) h
        rw [smul_zero, inv_smul_smul] at h2
        exact h2.symm }
  have hHmem : ∀ σ : Ω ≃ₐ[k] Ω, σ ∈ H ↔ σ ∈ K.fixingSubgroup ∧ φ σ = 0 := fun _ => Iff.rfl
  have hres_one : ∀ {σ : Ω ≃ₐ[k] Ω}, σ ∈ K.fixingSubgroup → SSGRoute.res k K σ = 1 := by
    intro σ hσ
    rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker K]
    exact hσ
  -- ## `H` is normal in `G_k`
  have hHnormal : H.Normal := by
    refine ⟨fun n hn g => ?_⟩
    obtain ⟨hnK, hn0⟩ := (hHmem n).mp hn
    refine (hHmem (g * n * g⁻¹)).mpr ⟨?_, ?_⟩
    · have hkerN : (K.fixingSubgroup).Normal := by
        rw [← IntermediateField.restrictNormalHom_ker K]
        infer_instance
      exact hkerN.conj_mem n hnK g
    · have h1 := hφ g trivial (n * g⁻¹) trivial
      have h2 := hφ n trivial g⁻¹ trivial
      have h3 : φ (n * g⁻¹) = φ g⁻¹ := by
        rw [h2, hn0, hres_one hnK, one_smul, zero_add]
      have h4 : φ (g * (n * g⁻¹)) = φ g + SSGRoute.res k K g • φ g⁻¹ := by
        rw [h1, h3]
      have h5 : φ g + SSGRoute.res k K g • φ g⁻¹ = 0 := by
        have h := hφ g trivial g⁻¹ trivial
        rw [mul_inv_cancel, hφ1] at h
        exact h.symm
      rw [mul_assoc, h4, h5]
  -- ## a finite normal `E'` containing `K` with `E'.fixingSubgroup ≤ H`
  have hE'H : (E ⊔ K).fixingSubgroup ≤ H := by
    intro σ hσ
    rw [IntermediateField.fixingSubgroup_sup] at hσ
    exact (hHmem σ).mpr ⟨hσ.2, hUzero σ (hEU hσ.1)⟩
  -- ## the field `F` fixed by `H`
  obtain ⟨hKF, hFfin, hFnorm, hFfix⟩ :=
    fixedField_of_le_fixingSubgroup k Ω K H
      (fun σ hσ => ((hHmem σ).mp hσ).1) hHnormal (E ⊔ K) hE'H
  haveI hFfinI : FiniteDimensional k (IntermediateField.fixedField H) := hFfin
  haveI hFnormI : Normal k (IntermediateField.fixedField H) := hFnorm
  -- ## the local conditions say that every finite place lies in `H`
  have hplace : ∀ A : ValuationSubring Ω, SSGRoute.IsFinPlace k A →
      SSGRoute.decomp k A ⊓ K.fixingSubgroup ≤ (IntermediateField.fixedField H).fixingSubgroup := by
    intro A hA
    rw [hFfix]
    obtain ⟨m, hm⟩ := hloc A hA
    intro σ hσ
    exact (hHmem σ).mpr ⟨hσ.2, by
      have h := hm σ hσ.1
      rw [hres_one hσ.2] at h
      simpa using h⟩
  -- ## Bauer's theorem: hence `F = K`
  have hFK : IntermediateField.fixedField H = K :=
    eq_of_place_le_fixingSubgroup k Ω K (IntermediateField.fixedField H) hKF hplace
  have hFix : K.fixingSubgroup = H := by rw [← hFfix, hFK]
  -- ## descent
  exact factorCocycle_of_vanishingOn_ker k Ω K φ hφ
    (fun σ hσ => ((hHmem σ).mp (hFix ▸ hσ)).2)

end Work.SSGRoute
