namespace Work.SSGRoute

/-- In a finite abelian group `G` in which every element is killed by a prime `p`, if `|G| ≤ p`
then every nonzero element generates the whole group. Concretely, the order of any nonzero `a`
is `p` (it divides `p` and is not `1`), so `zmultiples a` has `p` elements; since `|G| ≤ p` and
`zmultiples a ≤ G`, it has the same cardinality as `G`, hence is `⊤`. -/
theorem zmultiples_eq_top_of_card_le_prime {G : Type*} [AddCommGroup G] [Finite G]
    (p : ℕ) [Fact p.Prime] (hp : ∀ x : G, p • x = 0) (hcard : Nat.card G ≤ p)
    (a : G) (ha : a ≠ 0) : AddSubgroup.zmultiples a = ⊤ := by
  have hp_prime : p.Prime := Fact.out
  -- `a ≠ 0` has additive order exactly `p`.
  have ha0 : addOrderOf a = p := by
    have hdvd : addOrderOf a ∣ p := addOrderOf_dvd_iff_nsmul_eq_zero.mpr (hp a)
    rcases hp_prime.eq_one_or_self_of_dvd _ hdvd with h | h
    · exact absurd (AddMonoid.addOrderOf_eq_one_iff.mp h) ha
    · exact h
  -- The cyclic subgroup generated by `a` has exactly `p` elements.
  have hcardH : Nat.card (AddSubgroup.zmultiples a) = p := by
    rw [Nat.card_zmultiples, ha0]
  -- It is a subgroup of `G`, so its cardinality is at most `|G|`, which is at most `p`.
  have hle : Nat.card (AddSubgroup.zmultiples a) ≤ Nat.card G := by
    have h := AddSubgroup.card_le_of_le (H := AddSubgroup.zmultiples a)
      (K := (⊤ : AddSubgroup G)) le_top
    rwa [AddSubgroup.card_top] at h
  have hge : Nat.card G ≤ Nat.card (AddSubgroup.zmultiples a) := by
    rw [hcardH]; exact hcard
  exact AddSubgroup.eq_top_of_card_eq _ (le_antisymm hle hge)

end Work.SSGRoute
