/-!
# The local norm subgroup at `Q` is the norm group of the quadratic level `F(√α)`

Let `k` be a number field, `α ∈ kˣ` a unit, `Q` a finite place of `k`, and `L / k` a quadratic
Galois extension generated by a square root `y` of `α` which is not in `k`
(`hy`).  Writing `F := k_Q` for the completion of `k` at `Q`, the completion of `L` at a prime `q₀`
above `Q` is generated over `F` by the image `z` of `y`, and `z ^ 2 = ᾱ` where `ᾱ` is the image of
`α` in `F` (`L = k + k·y`, and the image of `L` is dense in the completion).

Consequently the local norm subgroup of `L / k` at `Q` — the product of the norm groups of the
completions at the primes above `Q` — is the norm group of the quadratic extension `F(√ᾱ)`: if
`ᾱ` is a square in `F` (the place splits, `E = F`) both groups are everything, and otherwise the
completion is `F(√ᾱ) = quadLevel` and both norm groups are the image of the norm form
`X ^ 2 - ᾱ Y ^ 2`.

The statement is phrased with the quadratic level `NK.NUV2.LC.quadLevel y₀ ᾱ h` of a square root
`y₀` of `ᾱ` inside the separable closure `SeparableClosure F`; the level does not depend on the
chosen square root.

## Contents

* `eq_zero_of_add_mul_eq_zero` — a vanishing base-field combination forces `y ∈ F`;
* `exists_eq_algebraMap_add_mul_of_finrank_two` — in a degree-two extension, every element is
  `a + b * y` for `y ∉ F`;
* `finrank_eq_two_of_notMem_range_of_finrank_le_two` — a one-dimensional extension has surjective
  structure map;
* `mem_normGroup_iff_exists_sq_sub_mul_sq` — the norm group of a quadratic extension generated by
  a square root is cut out by the norm form `X ^ 2 - b Y ^ 2`;
* `normGroup_eq_normGroup_quadLevel_of_sq` — comparison with the quadratic level inside a
  separable closure;
* `localNormSubgroup_eq_normGroup_quadLevel` — the target.
-/

open scoped NumberField Valued
open IsDedekindDomain

namespace Work.ZDataTwo

/-- **An element of the base field is zero when a base-field combination vanishes.**

If `algebraMap F E u + algebraMap F E v * z = 0` for `z ∉ F`, then `u = 0` and `v = 0`: for
`v ≠ 0` the relation exhibits `z = -(v⁻¹ * u)` as a base-field element. -/
theorem eq_zero_of_add_mul_eq_zero {F E : Type*} [Field F] [Field E] [Algebra F E]
    {z : E} (hz : z ∉ Set.range (algebraMap F E)) {u v : F}
    (h : algebraMap F E u + algebraMap F E v * z = 0) : u = 0 ∧ v = 0 := by
  by_cases hv : v = 0
  · subst hv
    simp only [map_zero, zero_mul, add_zero] at h
    exact ⟨(algebraMap F E).injective (by simpa using h), rfl⟩
  · exfalso
    have hvE : algebraMap F E v ≠ 0 := fun hh => hv ((algebraMap F E).injective (by simpa using hh))
    have h1 : algebraMap F E v * z = - algebraMap F E u := by
      rw [eq_neg_iff_add_eq_zero]
      simpa only [add_comm] using h
    have hz' : z = algebraMap F E (-(v⁻¹ * u)) := by
      calc z = (algebraMap F E v)⁻¹ * (algebraMap F E v * z) := by
              rw [← mul_assoc, inv_mul_cancel₀ hvE, one_mul]
        _ = (algebraMap F E v)⁻¹ * (- algebraMap F E u) := by rw [h1]
        _ = algebraMap F E (-(v⁻¹ * u)) := by
              rw [map_neg, map_mul, ← map_inv₀]
              ring
    exact hz ⟨-(v⁻¹ * u), hz'.symm⟩

/-- **In a degree-two extension `E / F` generated by an element outside `F`, every element of `E`
is of the form `a + b * y`** (with `a`, `b ∈ F`).

The map `F × F → E`, `(a, b) ↦ a + b * y` is injective — a vanishing combination gives `y ∈ F` by
`eq_zero_of_add_mul_eq_zero` — and an injective linear map between finite-dimensional spaces of the
same dimension `2` is surjective. -/
theorem exists_eq_algebraMap_add_mul_of_finrank_two {F E : Type*} [Field F] [Field E]
    [Algebra F E] [FiniteDimensional F E] (h : Module.finrank F E = 2) {y : E}
    (hy : y ∉ Set.range (algebraMap F E)) (w : E) :
    ∃ a b : F, w = algebraMap F E a + algebraMap F E b * y := by
  let f : F × F →ₗ[F] E :=
    { toFun := fun p => algebraMap F E p.1 + algebraMap F E p.2 * y
      map_add' := by
        intro p q
        show algebraMap F E (p.1 + q.1) + algebraMap F E (p.2 + q.2) * y =
          (algebraMap F E p.1 + algebraMap F E p.2 * y) +
            (algebraMap F E q.1 + algebraMap F E q.2 * y)
        rw [map_add, map_add]
        ring
      map_smul' := by
        intro c p
        show algebraMap F E (c * p.1) + algebraMap F E (c * p.2) * y =
          c • (algebraMap F E p.1 + algebraMap F E p.2 * y)
        rw [smul_add, Algebra.smul_def, Algebra.smul_def, map_mul, map_mul]
        ring }
  have hker : f.ker = ⊥ := by
    rw [Submodule.eq_bot_iff]
    rintro p hp
    rw [LinearMap.mem_ker] at hp
    have hp' : algebraMap F E p.1 + algebraMap F E p.2 * y = 0 := hp
    obtain ⟨hp1, hp2⟩ := eq_zero_of_add_mul_eq_zero hy hp'
    exact Prod.ext hp1 hp2
  have hinj : Function.Injective f := LinearMap.ker_eq_bot.mp hker
  have hfin : Module.finrank F (F × F) = Module.finrank F E := by
    rw [Module.finrank_prod, Module.finrank_self F, h]
  have hsurj : Function.Surjective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin).mp hinj
  obtain ⟨p, hp⟩ := hsurj w
  exact ⟨p.1, p.2, hp.symm⟩

/-- **A degree-two extension is not one-dimensional at a point outside the base field.**

If `y : E` is not in the image of `F` and `Module.finrank F E ≤ 2`, then `Module.finrank F E = 2`:
if the dimension were `1` the structure map would be surjective. -/
theorem finrank_eq_two_of_notMem_range_of_finrank_le_two {F E : Type*} [Field F] [Field E]
    [Algebra F E] [FiniteDimensional F E] {y : E} (hy : y ∉ Set.range (algebraMap F E))
    (h : Module.finrank F E ≤ 2) : Module.finrank F E = 2 := by
  have hpos : 0 < Module.finrank F E := Module.finrank_pos
  have hne : Module.finrank F E ≠ 1 := by
    intro h1
    have h2 : Module.finrank F ↥(⊤ : IntermediateField F E) = 1 := by
      rw [(IntermediateField.topEquiv (F := F) (E := E)).toLinearEquiv.finrank_eq]
      exact h1
    have hbot : (⊤ : IntermediateField F E) = ⊥ := IntermediateField.finrank_eq_one_iff.mp h2
    exact hy (IntermediateField.mem_bot.mp (hbot ▸
      (show y ∈ (⊤ : IntermediateField F E) from IntermediateField.mem_top)))
  omega

/-- **The norm group of a quadratic extension generated by a square root is the norm form.**

For a degree-two Galois extension `E / F` with `z ∉ F` and `z * z = b`, a unit `a ∈ Fˣ` is a norm
from `E` if and only if `a = u ^ 2 - b * v ^ 2` for some `u, v ∈ F`: every element of `E` is
`u + v * z` (`exists_eq_algebraMap_add_mul_of_finrank_two`) and has norm `u ^ 2 - b * v ^ 2`
(`NK.NUV2.QuadFaithful.norm_algebraMap_add_mul`). -/
theorem mem_normGroup_iff_exists_sq_sub_mul_sq {F E : Type*} [Field F] [Field E] [Algebra F E]
    [FiniteDimensional F E] [IsGalois F E] (h : Module.finrank F E = 2) {z : E}
    (hz : z ∉ Set.range (algebraMap F E)) {b : F} (hz2 : z * z = algebraMap F E b) (a : Fˣ) :
    a ∈ NK.LocalReciprocity.normGroup F E ↔ ∃ u v : F, u ^ 2 - b * v ^ 2 = (a : F) := by
  have hz2' : z ^ 2 = algebraMap F E b := by rw [pow_two]; exact hz2
  constructor
  · intro ha
    rw [NK.LocalReciprocity.mem_normGroup_iff] at ha
    obtain ⟨y, hy⟩ := ha
    obtain ⟨u, v, huv⟩ := exists_eq_algebraMap_add_mul_of_finrank_two h hz (y : E)
    refine ⟨u, v, ?_⟩
    rw [← hy, huv, NK.NUV2.QuadFaithful.norm_algebraMap_add_mul h hz hz2' u v]
  · rintro ⟨u, v, huv⟩
    rw [NK.LocalReciprocity.mem_normGroup_iff]
    have hwne : algebraMap F E u + algebraMap F E v * z ≠ 0 := by
      intro h0
      obtain ⟨hu, hv⟩ := eq_zero_of_add_mul_eq_zero hz h0
      exact Units.ne_zero a (by rw [← huv, hu, hv]; ring)
    refine ⟨Units.mk0 _ hwne, ?_⟩
    rw [Units.val_mk0, NK.NUV2.QuadFaithful.norm_algebraMap_add_mul h hz hz2' u v, huv]

/-- **The norm group of `E = F(z)` is the norm group of the quadratic level `F(√b)`.**

If `E / F` is a quadratic Galois extension generated by `z ∉ F` with `z ^ 2 = b`, and `y` is any
square root of `b` in a separable closure `F'` of `F`, then the norm group of `E` is the norm group
of the level `F(y) ⊆ F^{ab}` (it does not depend on the choice of the square root). -/
theorem normGroup_eq_normGroup_quadLevel_of_sq {F F' E : Type*} [Field F] [Field F']
    [Algebra F F'] [IsSepClosure F F'] [Field E] [Algebra F E] [FiniteDimensional F E]
    [IsGalois F E] [NeZero (2 : F)] (hdim : Module.finrank F E = 2) {z : E}
    (hz : z ∉ Set.range (algebraMap F E)) {b : F} (hz2 : z * z = algebraMap F E b) (hb : b ≠ 0)
    (y : F') (hy : y * y = algebraMap F F' b) :
    NK.LocalReciprocity.normGroup F E =
      NK.LocalReciprocity.normGroup F ↥(NK.NUV2.LC.quadLevel y b hy) := by
  refine Subgroup.ext (fun a => ?_)
  rw [mem_normGroup_iff_exists_sq_sub_mul_sq hdim hz hz2 a,
    Work.HilbertSymbolGeneral.mem_normGroup_quadLevel_iff y b hb hy a]

theorem localNormSubgroup_eq_normGroup_quadLevel {k : Type} [Field k] [NumberField k]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers k)) (α : kˣ)
    (L : Type) [Field L] [NumberField L] [Algebra k L] [FiniteDimensional k L] [IsGalois k L]
    (hc : Nat.card (L ≃ₐ[k] L) = 2)
    (hy : ∃ y : L, y * y = algebraMap k L (α : k) ∧ y ∉ Set.range (algebraMap k L)) :
    ∃ (y : SeparableClosure (Q.adicCompletion k))
      (hy : y * y = algebraMap (Q.adicCompletion k) (SeparableClosure (Q.adicCompletion k))
        (algebraMap k (Q.adicCompletion k) (α : k))),
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := k) (L := L)
          (NK.GlobalCFT.Place.ofFinite Q) =
        NK.LocalReciprocity.normGroup (Q.adicCompletion k)
          ↥(NK.NUV2.LC.quadLevel y (algebraMap k (Q.adicCompletion k) (α : k)) hy) := by
  classical
  -- a prime of `L` above `Q`
  obtain ⟨q₀, hq₀⟩ := NK.Chebotarev.exists_primeIdeal_liesOver (K := k) (L := L) Q
  haveI : q₀.asIdeal.LiesOver Q.asIdeal := hq₀
  haveI hfin : Module.Finite (Q.adicCompletion k) (q₀.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q₀ hq₀
  haveI hfd : FiniteDimensional (Q.adicCompletion k) (q₀.adicCompletion L) := inferInstance
  haveI hgal : IsGalois (Q.adicCompletion k) (q₀.adicCompletion L) :=
    Submission.NeukirchUchida.Local.isGalois_adicCompletion Q q₀ hq₀
  -- the local norm subgroup is the norm group of the completion at `q₀`
  have hlocal : NK.CFTLib.IdeleHasse.localNormSubgroup (K := k) (L := L)
        (NK.GlobalCFT.Place.ofFinite Q) =
      NK.LocalReciprocity.normGroup (Q.adicCompletion k) (q₀.adicCompletion L) := by
    apply le_antisymm
    · rw [NK.CFTLib.IdeleHasse.localNormSubgroup_ofFinite]
      refine iSup_le (fun q => ?_)
      rw [NK.CFTLib.IdeleHasse.range_localNormFinite_eq_of_liesOver (K := k) (L := L) Q
        q.1 q₀ q.2 hq₀]
      exact le_of_eq rfl
    · rw [NK.CFTLib.IdeleHasse.localNormSubgroup_ofFinite]
      exact le_iSup (fun q : {q : IsDedekindDomain.HeightOneSpectrum (𝓞 L) //
          q.asIdeal.LiesOver Q.asIdeal} =>
          MonoidHom.range (NK.GlobalCFT.Place.localNormFinite q.1 Q q.2)) ⟨q₀, hq₀⟩
  -- the square root `y ∈ L` of `α` and its image `z` in the completion
  obtain ⟨y, hy_sq, hy_notMem⟩ := hy
  set z : q₀.adicCompletion L := algebraMap L (q₀.adicCompletion L) y with hzdef
  have hz2 : z * z = algebraMap (Q.adicCompletion k) (q₀.adicCompletion L)
      (algebraMap k (Q.adicCompletion k) (α : k)) := by
    rw [hzdef, ← map_mul, hy_sq]
    exact (Commons.RingTheory.Henselian.adicCompletionMap_apply (K := k) (L := L) Q q₀ hq₀
      (α : k)).symm
  -- `L` is generated by `y` over `k`
  have hfKL : Module.finrank k L = 2 := (IsGalois.card_aut_eq_finrank k L).symm.trans hc
  -- the image of `L` is dense in the completion, hence generates it over `F`
  have hcont : Continuous (algebraMap (Q.adicCompletion k) (q₀.adicCompletion L)) :=
    Commons.RingTheory.Henselian.adicCompletionMap_continuous Q q₀ hq₀
  haveI hcsm : ContinuousSMul (Q.adicCompletion k) (q₀.adicCompletion L) :=
    continuousSMul_of_algebraMap _ _ hcont
  have hgen : IntermediateField.adjoin (Q.adicCompletion k)
      (Set.range (algebraMap L (q₀.adicCompletion L))) = ⊤ := by
    set S := IntermediateField.adjoin (Q.adicCompletion k)
      (Set.range (algebraMap L (q₀.adicCompletion L))) with hS
    have hclosed : IsClosed (S : Set (q₀.adicCompletion L)) := by
      haveI : FiniteDimensional (Q.adicCompletion k) ↥(S.toSubmodule) :=
        Submodule.finiteDimensional_of_le (le_top)
      exact Submodule.closed_of_finiteDimensional S.toSubmodule
    have hdense : DenseRange (algebraMap L (q₀.adicCompletion L)) :=
      IsDedekindDomain.HeightOneSpectrum.denseRange_algebraMap L q₀
    have hrange : Set.range (algebraMap L (q₀.adicCompletion L)) ⊆ (S : Set _) :=
      IntermediateField.subset_adjoin _ _
    have huniv : (Set.univ : Set (q₀.adicCompletion L)) ⊆ (S : Set _) := by
      have hd : closure (Set.range (algebraMap L (q₀.adicCompletion L))) = Set.univ :=
        hdense.closure_range
      rw [← hd]
      exact closure_minimal hrange hclosed
    exact top_unique (fun x _ => huniv (Set.mem_univ x))
  -- every element of `L` is `a + b * y`, so the image of `L` lies in `F(z)`
  have hsub : Set.range (algebraMap L (q₀.adicCompletion L)) ⊆
      (IntermediateField.adjoin (Q.adicCompletion k)
        ({z} : Set (q₀.adicCompletion L)) : Set _) := by
    rintro _ ⟨w, rfl⟩
    obtain ⟨a, b, rfl⟩ := exists_eq_algebraMap_add_mul_of_finrank_two hfKL hy_notMem w
    rw [map_add, map_mul]
    refine add_mem ?_ (mul_mem ?_ ?_)
    · have h : algebraMap L (q₀.adicCompletion L) (algebraMap k L a) =
          algebraMap (Q.adicCompletion k) (q₀.adicCompletion L)
            (algebraMap k (Q.adicCompletion k) a) :=
        (Commons.RingTheory.Henselian.adicCompletionMap_apply (K := k) (L := L) Q q₀ hq₀ a).symm
      rw [h]
      exact IntermediateField.algebraMap_mem _ _
    · have h : algebraMap L (q₀.adicCompletion L) (algebraMap k L b) =
          algebraMap (Q.adicCompletion k) (q₀.adicCompletion L)
            (algebraMap k (Q.adicCompletion k) b) :=
        (Commons.RingTheory.Henselian.adicCompletionMap_apply (K := k) (L := L) Q q₀ hq₀ b).symm
      rw [h]
      exact IntermediateField.algebraMap_mem _ _
    · rw [← hzdef]
      exact IntermediateField.subset_adjoin _ _ (Set.mem_singleton z)
  have hadj_top : IntermediateField.adjoin (Q.adicCompletion k)
      ({z} : Set (q₀.adicCompletion L)) = ⊤ := by
    refine top_unique ?_
    rw [← hgen]
    exact IntermediateField.adjoin_le_iff.mpr hsub
  -- the local degree is `≤ 2`
  have hd : Module.finrank (Q.adicCompletion k) (q₀.adicCompletion L) ≤ 2 := by
    have h := Commons.NumberTheory.NumberField.Completion.finrank_adicCompletion_le_finrank
      (K := k) (L := L) Q q₀ hq₀
    rwa [hfKL] at h
  by_cases hzmem : z ∈ Set.range (algebraMap (Q.adicCompletion k) (q₀.adicCompletion L))
  · -- `z ∈ F`: the place splits, `E = F`, and both norm groups are everything
    obtain ⟨c, hc_eq⟩ := hzmem
    have hαsq : algebraMap k (Q.adicCompletion k) (α : k) = c * c := by
      apply (algebraMap (Q.adicCompletion k) (q₀.adicCompletion L)).injective
      rw [map_mul, hc_eq]
      exact hz2.symm
    have hbot : IntermediateField.adjoin (Q.adicCompletion k)
        ({z} : Set (q₀.adicCompletion L)) = ⊥ :=
      IntermediateField.adjoin_eq_bot_iff.mpr (by
        rintro w hw
        rw [Set.mem_singleton_iff] at hw
        rw [hw]
        exact IntermediateField.mem_bot.mpr ⟨c, hc_eq⟩)
    have hdim1 : Module.finrank (Q.adicCompletion k) (q₀.adicCompletion L) = 1 := by
      have h1 : Module.finrank (Q.adicCompletion k)
          ↥(⊤ : IntermediateField (Q.adicCompletion k) (q₀.adicCompletion L)) = 1 := by
        rw [← hadj_top, hbot]
        exact IntermediateField.finrank_bot
      rw [← (IntermediateField.topEquiv (F := Q.adicCompletion k)
        (E := q₀.adicCompletion L)).toLinearEquiv.finrank_eq]
      exact h1
    refine ⟨algebraMap (Q.adicCompletion k) (SeparableClosure (Q.adicCompletion k)) c, ?_, ?_⟩
    · rw [← map_mul, hαsq]
    · rw [hlocal, Work.SSGRoute.ZDataTwo.normGroup_eq_top_of_finrank_eq_one hdim1]
      rw [Work.HilbertSymbolGeneral.quadLevel_eq_bot_of_mem_range
        (algebraMap (Q.adicCompletion k) (SeparableClosure (Q.adicCompletion k)) c)
        (algebraMap k (Q.adicCompletion k) (α : k)) _ ⟨c, rfl⟩]
      exact Work.HilbertSymbolGeneral.normGroup_bot_eq_top.symm
  · -- `z ∉ F`: the completion is quadratic and equals `F(√ᾱ)`
    have hdim2 : Module.finrank (Q.adicCompletion k) (q₀.adicCompletion L) = 2 :=
      finrank_eq_two_of_notMem_range_of_finrank_le_two hzmem hd
    have hb : algebraMap k (Q.adicCompletion k) (α : k) ≠ 0 :=
      (map_ne_zero (algebraMap k (Q.adicCompletion k))).mpr (Units.ne_zero α)
    refine ⟨NK.NUV2.LC.sqroot (Units.mk0 (algebraMap k (Q.adicCompletion k) (α : k)) hb), ?_, ?_⟩
    · rw [NK.NUV2.LC.sqroot_mul_self, Units.val_mk0]
    · rw [hlocal]
      exact normGroup_eq_normGroup_quadLevel_of_sq (F := Q.adicCompletion k)
        (F' := SeparableClosure (Q.adicCompletion k)) (E := q₀.adicCompletion L)
        (b := algebraMap k (Q.adicCompletion k) (α : k)) hdim2 hzmem hz2 hb _ _

end Work.ZDataTwo
