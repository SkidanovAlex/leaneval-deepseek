/-!
# The canonical generator of a quadratic level

For a field `F` with `2 ≠ 0`, a Galois extension `F'` and `y ∈ F'` with `y * y = b` (`b ∈ F`), the
quadratic level `F(√b) = NK.NUV2.LC.quadLevel y b hy` is the subfield of the maximal abelian
subextension `F^{ab}` generated by the image of `y`.

This file introduces that image as `quadGen y b hy`, together with the two basic facts about it
that the computation of the norm group of `F(√b)` needs:

* `quadGen_mul_self`: `quadGen ^ 2 = algebraMap F _ b`;
* `quadGen_notMem_range`: if `y` is *not* a base-field element, then neither is `quadGen`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

open scoped Classical

namespace Work.HilbertSymbolGeneral

section Gen

variable {F : Type*} {F' : Type*} [Field F] [Field F'] [Algebra F F'] [IsGalois F F']
variable [NeZero (2 : F)]

/-- **The canonical generator of the quadratic level `F(√b)`**: the image of the square root `y`
of `b` in `↥(quadLevel y b hy)`. -/
noncomputable def quadGen (y : F') (b : F) (hy : y * y = algebraMap F F' b) :
    ↥(NK.NUV2.LC.quadLevel y b hy) :=
  ⟨⟨y, NK.NUV2.LC.mem_maxAbelianSubext_of_sq y b hy⟩, by
    apply IntermediateField.subset_adjoin
    simp⟩

/-- The defining property of the generator: its square is the base-field element `b`. -/
theorem quadGen_mul_self (y : F') (b : F) (hy : y * y = algebraMap F F' b) :
    quadGen y b hy * quadGen y b hy = algebraMap F ↥(NK.NUV2.LC.quadLevel y b hy) b := by
  apply Subtype.ext
  exact NK.NUV2.LC.quadLevel_coe_mul_self y b hy

/-- If the square root `y` of `b` is not a base-field element, neither is the generator `quadGen`
of the quadratic level. -/
theorem quadGen_notMem_range (y : F') (b : F) (hy : y * y = algebraMap F F' b)
    (hx : y ∉ Set.range (algebraMap F F')) :
    quadGen y b hy ∉ Set.range (algebraMap F ↥(NK.NUV2.LC.quadLevel y b hy)) := by
  rintro ⟨u, hu⟩
  refine hx ⟨u, ?_⟩
  have h1 := congrArg (fun z : ↥(NK.NUV2.LC.quadLevel y b hy) =>
      ((z : ↥(NK.LocalReciprocity.maxAbelianSubext F F')) : F')) hu
  simpa [quadGen] using h1

end Gen

end Work.HilbertSymbolGeneral
