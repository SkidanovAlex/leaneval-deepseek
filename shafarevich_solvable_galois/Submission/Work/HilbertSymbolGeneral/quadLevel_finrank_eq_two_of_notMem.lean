namespace Work.HilbertSymbolGeneral

/-!
# The quadratic level `F(√b)` has degree two when `√b` is not a base-field element

Let `F` be a field with `2 ≠ 0`, `F'` a Galois extension of `F`, `y ∈ F'` with `y * y = b`, and
suppose `y` is not a base-field element (`y ∉ Set.range (algebraMap F F')`).  Then the quadratic
level `F(√b) = NK.NUV2.LC.quadLevel y b hy`, the subfield of `F^{ab}` generated by the image of `y`,
has degree exactly `2` over `F`.

Proof: `NK.NUV2.LC.quadLevel_finrank_le_two` gives `≤ 2`.  If the finrank were `1`, then
`IntermediateField.finrank_eq_one_iff` would give `quadLevel y b hy = ⊥`, so that the generator
`quadGen y b hy` (`Submission/Work/HilbertSymbolGeneral/Gens.lean`) lies in `⊥`; a `⊥`-level of a
subtype is spanned by the base field, so `quadGen` would lie in the range of `algebraMap F _`; since
`quadGen` is the image of `y`, this contradicts `hx`.  The finrank is nonzero by
`Module.finrank_pos`; hence it is `2`.
-/

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option linter.style.nativeDecide false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 800000

open scoped Classical

/-- **The quadratic level is spanned by the base field when the square root is a base-field
element.**  If `K = ⊥` as a level of `F^{ab}`, then `algebraMap F ↥K` is surjective: this is the
`⊥`-case of "the level is generated by the base field". -/
theorem surjective_algebraMap_of_eq_bot
    {F : Type*} {F' : Type*} [Field F] [Field F'] [Algebra F F']
    (K : IntermediateField F (NK.LocalReciprocity.maxAbelianSubext F F'))
    (hbot : K = ⊥) (x : ↥K) :
    ∃ u : F, algebraMap F ↥K u = x := by
  have hx : (x : ↥(NK.LocalReciprocity.maxAbelianSubext F F')) ∈
      (⊥ : IntermediateField F ↥(NK.LocalReciprocity.maxAbelianSubext F F')) := hbot ▸ x.2
  obtain ⟨u, hu⟩ := IntermediateField.mem_bot.mp hx
  exact ⟨u, Subtype.ext hu⟩

/-- **The quadratic level `F(√b)` has degree exactly two over `F` when `√b` is not a base-field
element.** -/
theorem quadLevel_finrank_eq_two_of_notMem {F : Type*} {F' : Type*} [Field F] [Field F']
    [Algebra F F'] [IsGalois F F'] [NeZero (2 : F)] (y : F') (b : F)
    (hy : y * y = algebraMap F F' b) (hx : y ∉ Set.range (algebraMap F F')) :
    Module.finrank F ↥(NK.NUV2.LC.quadLevel y b hy) = 2 := by
  haveI hfd : FiniteDimensional F ↥(NK.NUV2.LC.quadLevel y b hy) :=
    NK.NUV2.LC.quadLevel_finiteDimensional y b hy
  have hle : Module.finrank F ↥(NK.NUV2.LC.quadLevel y b hy) ≤ 2 :=
    NK.NUV2.LC.quadLevel_finrank_le_two y b hy
  have hpos : 0 < Module.finrank F ↥(NK.NUV2.LC.quadLevel y b hy) := Module.finrank_pos
  have hne : Module.finrank F ↥(NK.NUV2.LC.quadLevel y b hy) ≠ 1 := by
    intro h1
    have hbot : NK.NUV2.LC.quadLevel y b hy = ⊥ := IntermediateField.finrank_eq_one_iff.mp h1
    obtain ⟨u, hu⟩ := surjective_algebraMap_of_eq_bot _ hbot (quadGen y b hy)
    exact quadGen_notMem_range y b hy hx ⟨u, hu⟩
  omega

end Work.HilbertSymbolGeneral
