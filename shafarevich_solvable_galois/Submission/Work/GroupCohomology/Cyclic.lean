# Cyclic groups and the trivial module

Two ingredients for the Kummer-theoretic computation of `H²` of a cyclic group:

* `TrivMod G A`: the additive commutative group `A` equipped with the *trivial* action of `G`,
  as a type synonym (so that it does not clash with any pre-existing action on `A`);
* `nsmulRange n A`: the subgroup `nA = {n • a | a : A}` of an additive commutative group.

The computation itself, `H²(ℤ/n, A) ≅ A/nA` for the trivial action, is
`Work.GroupCohomology.H2_cyclic_trivial` (proved in `Submission/Work/GroupCohomology/H2_cyclic_trivial.lean`).
-/
import Submission.Work.GroupCohomology.Basic
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

universe u v

namespace Work.GroupCohomology

/-- `A` with the trivial action of `G`.  A type synonym, so that it does not clash with a
pre-existing action on `A` (in particular with the pointwise action on function spaces). -/
def TrivMod (G : Type u) (A : Type v) : Type v := A

namespace TrivMod

variable {G : Type u} {A : Type v} [Group G] [AddCommGroup A]

instance : AddCommGroup (TrivMod G A) := inferInstanceAs (AddCommGroup A)

instance : DistribMulAction G (TrivMod G A) where
  smul _ a := a
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

@[simp] theorem smul_def (g : G) (a : TrivMod G A) : g • a = a := rfl

/-- The identity map `TrivMod G A → A`, as an isomorphism of additive groups. -/
def addEquiv : TrivMod G A ≃+ A := AddEquiv.refl A

end TrivMod

/-- The subgroup `nA = {n • a | a : A}` generated by the `n`-fold multiples of elements of `A`. -/
def nsmulRange (n : ℕ) (A : Type v) [AddCommGroup A] : AddSubgroup A :=
  (AddMonoidHom.mk' (fun a : A => n • a) (fun x y => by
    rw [smul_add])).range

theorem mem_nsmulRange {n : ℕ} {A : Type v} [AddCommGroup A] {a : A} :
    a ∈ nsmulRange n A ↔ ∃ b : A, n • b = a := Iff.rfl

end Work.GroupCohomology
