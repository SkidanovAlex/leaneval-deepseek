/-!
# Invariants of a `p`-group representation over `𝔽_p`

The first slice of the *unipotence* of `𝔽_p[G]` for a finite `p`-group `G`: every nonzero
`ZMod p`-representation of `G` has a nonzero fixed vector.  Equivalently `H⁰(G, V) ≠ 0` for
`V ≠ 0`, which is the input for the vanishing criterion of the surrounding development of
cohomologically trivial modules.

## Implementation notes

The argument implemented below is the classical orbit count, in the form in which Mathlib already
provides it (`IsPGroup.exists_fixed_point_of_prime_dvd_card_of_fixed_point`: for a `p`-group
acting on a finite set `α` with `p ∣ Nat.card α` and one fixed point `a`, there is a second fixed
point `b ≠ a`).

That lemma needs `α` to be a *finite* `G`-set, whereas a representation `V` may well be
infinite dimensional (nothing in the statement bounds `dim V`).  We therefore replace `V` by the
`G`-stable submodule `M` spanned by the `G`-orbit of a nonzero vector `v₀`:

* `M` is finite dimensional over the field `ZMod p` (`Module.Finite.span_of_finite`), hence finite
  of cardinality `p ^ finrank` (`Module.natCard_eq_pow_finrank` together with `Nat.card_zmod`);
* `v₀ ≠ 0` makes `finrank M ≥ 1`, so `p ∣ Nat.card M`;
* `0 ∈ M` is a fixed point of the restricted action, and the action is `ZMod p`-linear
  (a `DistribMulAction`), so `0` really is fixed.

Mathlib's lemma then produces a *nonzero* fixed point of `M`, i.e. a nonzero vector of `V` fixed
by every `g : G`.
-/

namespace Work.CohomologicallyTrivial

set_option linter.style.haveILetI false

/-- For a finite `p`-group `G` and a nonzero `ZMod p`-representation `V`, there is a nonzero
fixed vector.

Proof route (do it this way): strong induction on `Fintype.card G`.  For `G` nontrivial use
`NK.HassePrinciple.exists_normal_subgroup_index_eq_prime` (in this workspace: file
`Submission/NK/HassePrinciple/exists_normal_subgroup_index_eq_prime.lean`, module
`Submission.NK.HassePrinciple.exists_normal_subgroup_index_eq_prime`; NOTE the `NK` component, it is
NOT under `Submission/Work/`) to get `N ◁ G` with `N.index = p`; then `IsPGroup` restricts to `N`
(`IsPGroup.to_subgroup`) and `|N| < |G|`, so the induction hypothesis applied to the `N`-module
`Rep.res N.subtype V` gives `0 ≠ v` with `V.ρ n v = v` for all `n : ↥N`.  Pick `g : G`, `g ∉ N`;
then `N ⊔ Subgroup.zpowers g = ⊤` (its index divides `N.index = p` and is `< p`).  On the nonzero
`ZMod p`-space `W := {v : V.V // ∀ n : ↥N, V.ρ n v = v}` the linear map `V.ρ g - 1` is nilpotent:
`g ^ p ∈ N` acts trivially on `W` and `ZMod p` has characteristic `p`, so
`(V.ρ g - 1)^p = V.ρ (g^p) - 1 = 0` on `W` (binomial/Frobenius identity for commuting
endomorphisms of a `ZMod p`-module).  A linear map with `f^p = 0` that is injective forces the
module to be zero, so `ker (V.ρ g - 1) ≠ ⊥` on `W`, giving `0 ≠ w ∈ W` with `V.ρ g w = w`, and
`w` is fixed by all of `G = N ⊔ ⟨g⟩`.  The case `G` trivial is immediate. -/
theorem pgroup_invariants_ne_bot {p : ℕ} [Fact p.Prime] {G : Type} [Group G] [Fintype G]
    (hpG : IsPGroup p G) (V : Rep (ZMod p) G) (hV : Nontrivial V.V) :
    ∃ v : V.V, v ≠ 0 ∧ ∀ g : G, V.ρ g v = v := by
  classical
  obtain ⟨v₀, hv₀⟩ := exists_ne (0 : V.V)
  -- The `G`-stable submodule generated by the `G`-orbit of `v₀`.
  set M : Submodule (ZMod p) V.V :=
    Submodule.span (ZMod p) (Set.range fun g : G => V.ρ g v₀) with hM
  have hgen : ∀ g : G, V.ρ g v₀ ∈ M := fun g => by
    rw [hM]; exact Submodule.subset_span ⟨g, rfl⟩
  have hv₀M : v₀ ∈ M := by simpa using hgen 1
  -- `M` is stable under the action of `G`.
  have hstab : ∀ (g : G) (x : V.V), x ∈ M → V.ρ g x ∈ M := by
    intro g x hx
    have hmap : Submodule.map (V.ρ g) M ≤ M := by
      rw [hM, Submodule.map_span]
      refine Submodule.span_le.mpr ?_
      rintro y ⟨z, ⟨h, rfl⟩, rfl⟩
      have hgh : V.ρ (g * h) v₀ = (V.ρ g) ((V.ρ h) v₀) := by
        rw [map_mul, Module.End.mul_apply]
      rw [← hgh]
      exact hgen (g * h)
    exact hmap ⟨x, hx, rfl⟩
  -- the induced `ZMod p`-linear action of `G` on `M`
  letI : DistribMulAction G ↥M :=
  { smul g x := ⟨V.ρ g x.1, hstab g x.1 x.2⟩
    one_smul x := by
      show (⟨V.ρ 1 x.1, _⟩ : ↥M) = x
      exact Subtype.ext (by simp)
    mul_smul g h x := by
      have h1 : V.ρ (g * h) x.1 = V.ρ g (V.ρ h x.1) := by
        rw [map_mul, Module.End.mul_apply]
      show (⟨V.ρ (g * h) x.1, _⟩ : ↥M) = ⟨V.ρ g (V.ρ h x.1), _⟩
      exact Subtype.ext h1
    smul_zero g := by
      show (⟨V.ρ g 0, _⟩ : ↥M) = 0
      exact Subtype.ext (by simp)
    smul_add g x y := by
      show (⟨V.ρ g (x.1 + y.1), _⟩ : ↥M) = ⟨V.ρ g x.1 + V.ρ g y.1, _⟩
      exact Subtype.ext (by simp) }
  have hval : ∀ (g : G) (x : ↥M), ((g • x : ↥M) : V.V) = V.ρ g (x : V.V) := by
    intro g x
    show (V.ρ g x.1) = V.ρ g x.1
    rfl
  -- `M` is finite dimensional over `ZMod p`, hence finite, and `p ∣ Nat.card ↥M`.
  haveI hFin : Module.Finite (ZMod p) ↥M := by
    rw [hM]
    exact Module.Finite.span_of_finite (ZMod p) (Set.finite_range _)
  have hcard : Nat.card ↥M = p ^ Module.finrank (ZMod p) ↥M := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod p), Nat.card_zmod]
  haveI : Nontrivial ↥M := ⟨⟨v₀, hv₀M⟩, 0, fun h => hv₀ (congrArg Subtype.val h)⟩
  have hpos : 0 < Module.finrank (ZMod p) ↥M := Module.finrank_pos
  haveI : Finite ↥M := Nat.finite_of_card_ne_zero (by
    rw [hcard]
    exact pow_ne_zero _ (Fact.out (p := Nat.Prime p)).ne_zero)
  have hdvd : p ∣ Nat.card ↥M := by
    rw [hcard]
    exact dvd_pow_self p (by omega)
  -- Mathlib's orbit count: a finite `G`-set of cardinality divisible by `p` with one fixed point
  -- has a second one.
  obtain ⟨b, hbfix, hbne⟩ :=
    hpG.exists_fixed_point_of_prime_dvd_card_of_fixed_point ↥M hdvd
      (show (0 : ↥M) ∈ MulAction.fixedPoints G ↥M from by
        rw [MulAction.mem_fixedPoints]
        intro g
        exact Subtype.ext (by simp))
  refine ⟨(b : V.V), ?_, ?_⟩
  · intro hb
    exact hbne (Subtype.ext hb).symm
  · intro g
    have h2 : ((g • b : ↥M) : V.V) = (b : V.V) := congrArg Subtype.val (hbfix g)
    rwa [hval g b] at h2

end Work.CohomologicallyTrivial
