/-!
# The sub/quotient short complex of a representation

For a representation `M : Rep k G` and a `G`-stable submodule `W ≤ M.V`, this file packages the
short complex

`0 → W → M → M ⧸ W → 0`

of representations of `G` (with the sub- and quotient representations inherited from `M`), together
with the inclusion and the projection.  The associated short exactness statement
`shortComplexOfStableSubmodule_shortExact` lives in a separate file so that it can be proved
independently; it is the input to the "unipotence" argument for `𝔽_p[G]`-modules with `G` a
`p`-group.

Nothing here is specific to `𝔽_p`: `k` is an arbitrary commutative ring and `G` an arbitrary
group.
-/

open CategoryTheory

set_option linter.unusedSimpArgs false

namespace Work.CohomologicallyTrivial

universe w u v

variable {k : Type u} [CommRing k] {G : Type v} [Group G]

/-- The subrepresentation of `M` on a `G`-stable submodule `W`. -/
noncomputable abbrev subRep (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) : Rep.{w} k G :=
  Rep.of (M.ρ.subrepresentation W hW)

/-- The quotient representation of `M` by a `G`-stable submodule `W`. -/
noncomputable abbrev quotRep (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) : Rep.{w} k G :=
  Rep.of (M.ρ.quotient W hW)

/-- The inclusion `W → M` as a morphism of representations. -/
noncomputable def subRepIncl (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) : subRep M W hW ⟶ M :=
  Rep.ofHom ⟨W.subtype, by intro g; ext x; simp [Representation.subrepresentation_apply]⟩

/-- The projection `M → M ⧸ W` as a morphism of representations. -/
noncomputable def quotRepProj (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) : M ⟶ quotRep M W hW :=
  Rep.ofHom ⟨W.mkQ, by intro g; ext x; simp [Representation.quotient_apply]⟩

/-- The short complex `0 → W → M → M ⧸ W → 0` of representations attached to a `G`-stable
submodule `W ≤ M.V`. -/
noncomputable def shortComplexOfStableSubmodule (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) : ShortComplex (Rep.{w} k G) :=
  ShortComplex.mk (subRepIncl M W hW) (quotRepProj M W hW) (by
    ext x
    simp only [subRepIncl, quotRepProj, Rep.hom_comp, Rep.hom_ofHom, Rep.zero_hom,
      Representation.IntertwiningMap.comp_toLinearMap,
      Representation.IntertwiningMap.zero_toLinearMap,
      LinearMap.comp_apply, LinearMap.zero_apply, Submodule.mkQ_apply]
    simp [Submodule.Quotient.mk_eq_zero, x.2])

@[simp]
lemma shortComplexOfStableSubmodule_X₁ (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) :
    (shortComplexOfStableSubmodule M W hW).X₁ = subRep M W hW := rfl

@[simp]
lemma shortComplexOfStableSubmodule_X₂ (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) :
    (shortComplexOfStableSubmodule M W hW).X₂ = M := rfl

@[simp]
lemma shortComplexOfStableSubmodule_X₃ (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) :
    (shortComplexOfStableSubmodule M W hW).X₃ = quotRep M W hW := rfl

@[simp]
lemma shortComplexOfStableSubmodule_f (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) :
    (shortComplexOfStableSubmodule M W hW).f = subRepIncl M W hW := rfl

@[simp]
lemma shortComplexOfStableSubmodule_g (M : Rep.{w} k G) (W : Submodule k M.V)
    (hW : ∀ g : G, W ≤ Submodule.comap (M.ρ g) W) :
    (shortComplexOfStableSubmodule M W hW).g = quotRepProj M W hW := rfl

/-- The stability condition for a submodule spanned by a fixed vector. -/
theorem span_singleton_le_comap_of_fixed (M : Rep.{w} k G) (v : M.V)
    (hv : ∀ g : G, M.ρ g v = v) :
    ∀ g : G, Submodule.span k {v} ≤ Submodule.comap (M.ρ g) (Submodule.span k {v}) := by
  intro g x hx
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
  rw [Submodule.mem_comap]
  exact Submodule.mem_span_singleton.mpr ⟨c, by rw [map_smul, hv]⟩

/-- The action of `G` on the subrepresentation generated by a fixed vector is trivial. -/
theorem subRep_span_singleton_ρ_apply (M : Rep.{w} k G) (v : M.V)
    (hv : ∀ g : G, M.ρ g v = v) :
    ∀ (g : G) (x : subRep M (Submodule.span k {v}) (span_singleton_le_comap_of_fixed M v hv)),
      (subRep M (Submodule.span k {v}) (span_singleton_le_comap_of_fixed M v hv)).ρ g x = x := by
  intro g x
  have hmem : ∀ y ∈ Submodule.span k {v}, M.ρ g y = y := by
    intro y hy
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hy
    rw [map_smul, hv]
  exact Subtype.ext (hmem x.1 x.2)

end Work.CohomologicallyTrivial
