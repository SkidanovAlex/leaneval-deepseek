# Cyclotomic subfields of `AlgebraicClosure ℚ` and their Galois groups

This file sets up the basic object of the `Crossing` area: for `n : ℕ`, the intermediate field

* `CycloField n = ℚ⟮ζₙ⟯ ⊆ AlgebraicClosure ℚ`,

generated by a chosen primitive `n`-th root of unity `zeta n` (for `n = 0` we simply set
`zeta 0 = 1`, so that `CycloField` is a *total* function of `n`: this makes it usable in
statements that quantify over primes without carrying `NeZero` instances around).
Because any two primitive `n`-th roots of unity are powers of each other, `CycloField n` does not
depend on the choice: it is the subfield generated by *all* `n`-th roots of unity.  This is what
makes it possible to compare `CycloField m` and `CycloField n` inside the fixed ambient field
`AlgebraicClosure ℚ` (see `Disjoint.lean`).

## Main declarations

* `zeta`, `zeta_isPrimitiveRoot`
* `CycloField`
* `isCyclotomicExtension_cycloField`, `finrank_cycloField`
* `finiteDimensional_cycloField`, `isGalois_cycloField`
* `cycloFieldGalEquiv` : `Gal(ℚ⟮ζₙ⟯/ℚ) ≃* (ZMod n)ˣ`

-/
import Mathlib
import Submission.Realization
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.FieldTheory.Crossing

open scoped Classical
open Polynomial

noncomputable section

set_option linter.style.haveILetI false

/-- The algebraic closure of `ℚ` is integral over `ℚ`.  (Type class search does not find this
instance, because `AlgebraicClosure` is an opaque `def`; we register it here.) -/
instance instIsIntegralAlgebraicClosure : Algebra.IsIntegral ℚ (AlgebraicClosure ℚ) :=
  @Algebra.IsAlgebraic.isIntegral ℚ (AlgebraicClosure ℚ) _ _ _
    (@AlgebraicClosure.isAlgebraic ℚ _)

/-- A chosen primitive `n`-th root of unity in the algebraic closure of `ℚ` (and `1` for `n = 0`,
so that `zeta` is a total function). -/
noncomputable def zeta (n : ℕ) : AlgebraicClosure ℚ :=
  if h : n = 0 then 1 else
    Classical.choose <| IsAlgClosed.exists_root (Polynomial.cyclotomic n (AlgebraicClosure ℚ))
      (Polynomial.degree_cyclotomic_pos n (AlgebraicClosure ℚ) (Nat.pos_of_ne_zero h)).ne'

theorem zeta_isPrimitiveRoot (n : ℕ) (hn : n ≠ 0) : IsPrimitiveRoot (zeta n) n := by
  haveI : NeZero (n : AlgebraicClosure ℚ) := ⟨Nat.cast_ne_zero.mpr hn⟩
  unfold zeta
  rw [dif_neg hn]
  exact Polynomial.isRoot_cyclotomic_iff.mp (Classical.choose_spec _)

/-- The `n`-th cyclotomic subfield of `AlgebraicClosure ℚ`, generated by a chosen primitive
`n`-th root of unity.  It is independent of the choice of primitive root. -/
noncomputable def CycloField (n : ℕ) : IntermediateField ℚ (AlgebraicClosure ℚ) :=
  IntermediateField.adjoin ℚ {zeta n}

@[simp]
theorem CycloField_eq_adjoin (n : ℕ) :
    CycloField n = IntermediateField.adjoin ℚ {zeta n} := rfl

instance isCyclotomicExtension_cycloField (n : ℕ) [NeZero n] :
    IsCyclotomicExtension {n} ℚ ↥(CycloField n) :=
  IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension ℚ (ζ := zeta n)
    (zeta_isPrimitiveRoot n (NeZero.ne n))

theorem finrank_cycloField (n : ℕ) [NeZero n] :
    Module.finrank ℚ ↥(CycloField n) = n.totient :=
  IsCyclotomicExtension.finrank ↥(CycloField n)
    (Polynomial.cyclotomic.irreducible_rat (NeZero.pos n))

instance finiteDimensional_cycloField (n : ℕ) [NeZero n] :
    FiniteDimensional ℚ ↥(CycloField n) :=
  IsCyclotomicExtension.finiteDimensional {n} ℚ ↥(CycloField n)

instance isGalois_cycloField (n : ℕ) [NeZero n] : IsGalois ℚ ↥(CycloField n) :=
  IsCyclotomicExtension.isGalois {n} ℚ ↥(CycloField n)

/-- The Galois group of the `n`-th cyclotomic field over `ℚ` is `(ZMod n)ˣ`. -/
noncomputable def cycloFieldGalEquiv (n : ℕ) [NeZero n] :
    Gal(↥(CycloField n)/ℚ) ≃* (ZMod n)ˣ :=
  IsCyclotomicExtension.autEquivPow ↥(CycloField n)
    (Polynomial.cyclotomic.irreducible_rat (NeZero.pos n))

/-- The cardinality of the Galois group of the `n`-th cyclotomic field is `n.totient`. -/
theorem card_cycloFieldGal (n : ℕ) [NeZero n] :
    Nat.card Gal(↥(CycloField n)/ℚ) = n.totient := by
  rw [IsGalois.card_aut_eq_finrank ℚ ↥(CycloField n), finrank_cycloField n]

end

end Work.FieldTheory.Crossing
