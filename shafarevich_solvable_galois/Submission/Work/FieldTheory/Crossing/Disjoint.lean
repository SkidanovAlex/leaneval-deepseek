# Linear disjointness of cyclotomic subfields of coprime order

This file proves that the cyclotomic subfields `CycloField m`, `CycloField n` of
`AlgebraicClosure ℚ` (see `Defs.lean`) are linearly disjoint when `m` and `n` are coprime; in
particular `CycloField p ⊓ CycloField q = ⊥` for distinct primes `p, q`.

The key input is `IsPrimitiveRoot.adjoin_pair_eq`: the subalgebra generated by two roots of
unity of order `k₁`, `k₂` is the subalgebra generated by a root of unity of order `lcm k₁ k₂`.
Hence `CycloField m ⊔ CycloField n = CycloField (m.lcm n)`, and degrees multiply, which gives
linear disjointness by `IntermediateField.LinearDisjoint.of_finrank_sup`.

## Main declarations

* `intermediateField_adjoin_pair_eq`
* `CycloField_sup_eq_lcm` : `CycloField m ⊔ CycloField n = CycloField (m.lcm n)`
* `cycloField_inf_eq_bot_of_coprime`
* `cycloField_inf_eq_bot` : `CycloField p ⊓ CycloField q = ⊥` for distinct primes
* `finrank_cycloField_prime`

-/
import Mathlib
import Submission.Work.FieldTheory.Crossing.Defs
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.FieldTheory.Crossing

open scoped Classical
open Polynomial

noncomputable section

set_option linter.style.haveILetI false

/-- The `IntermediateField`-version of `IsPrimitiveRoot.adjoin_pair_eq`: the subfield generated by
two roots of unity of order `k₁`, `k₂` is the subfield generated by a root of unity of order
`lcm k₁ k₂`. -/
theorem intermediateField_adjoin_pair_eq {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    [Algebra.IsAlgebraic F Ω] {k₁ k₂ : ℕ} {ζ₁ ζ₂ : Ω} (hζ₁ : IsPrimitiveRoot ζ₁ k₁)
    (hζ₂ : IsPrimitiveRoot ζ₂ k₂) (hk₁ : k₁ ≠ 0) (hk₂ : k₂ ≠ 0) {ζ : Ω}
    (hζ : IsPrimitiveRoot ζ (k₁.lcm k₂)) :
    IntermediateField.adjoin F ({ζ₁, ζ₂} : Set Ω) = IntermediateField.adjoin F {ζ} := by
  apply IntermediateField.toSubalgebra_injective
  rw [IntermediateField.adjoin_toSubalgebra, IntermediateField.adjoin_toSubalgebra]
  exact IsPrimitiveRoot.adjoin_pair_eq F hζ₁ hζ₂ hk₁ hk₂ hζ

/-- The compositum of two linearly disjoint (coprime order) cyclotomic subfields is the
cyclotomic subfield of the product. -/
theorem CycloField_sup_eq_mul (m n : ℕ) [NeZero m] [NeZero n] (h : m.Coprime n) :
    CycloField m ⊔ CycloField n = CycloField (m * n) := by
  rw [CycloField_eq_adjoin m, CycloField_eq_adjoin n, ← IntermediateField.adjoin_union]
  have hset : ({zeta m} : Set (AlgebraicClosure ℚ)) ∪ {zeta n} = {zeta m, zeta n} := by
    ext x; simp [or_comm]
  rw [hset, CycloField_eq_adjoin (m * n)]
  exact intermediateField_adjoin_pair_eq (F := ℚ) (zeta_isPrimitiveRoot m (NeZero.ne m))
    (zeta_isPrimitiveRoot n (NeZero.ne n)) (NeZero.ne m) (NeZero.ne n)
    (h.lcm_eq_mul.symm ▸ zeta_isPrimitiveRoot (m * n) (NeZero.ne (m * n)))

/-- **Cyclotomic subfields of coprime order are linearly disjoint.** -/
theorem cycloField_inf_eq_bot_of_coprime (m n : ℕ) [NeZero m] [NeZero n] (h : m.Coprime n) :
    CycloField m ⊓ CycloField n = ⊥ := by
  have hfin : Module.finrank ℚ ↥(CycloField m ⊔ CycloField n) =
      Module.finrank ℚ ↥(CycloField m) * Module.finrank ℚ ↥(CycloField n) := by
    rw [CycloField_sup_eq_mul m n h, finrank_cycloField (m * n), finrank_cycloField m,
      finrank_cycloField n, Nat.totient_mul h]
  exact (IntermediateField.LinearDisjoint.of_finrank_sup (A := CycloField m)
    (B := CycloField n) hfin).inf_eq_bot

/-- **Distinct prime cyclotomic subfields are linearly disjoint.** -/
theorem cycloField_inf_eq_bot {p q : ℕ} [NeZero p] [NeZero q] (hp : Nat.Prime p)
    (hq : Nat.Prime q) (hpq : p ≠ q) : CycloField p ⊓ CycloField q = ⊥ :=
  cycloField_inf_eq_bot_of_coprime p q ((Nat.coprime_primes hp hq).mpr hpq)

theorem finrank_cycloField_prime {p : ℕ} [NeZero p] (hp : Nat.Prime p) :
    Module.finrank ℚ ↥(CycloField p) = p - 1 := by
  rw [finrank_cycloField p, Nat.totient_prime hp]


/-- The linear-disjointness form of the previous statement, which is the one used downstream
(`IntermediateField.LinearDisjoint.finrank_sup`), together with the coprimality form. -/
theorem cycloField_linearDisjoint {m n : ℕ} [NeZero m] [NeZero n] (h : m.Coprime n) :
    (CycloField m).LinearDisjoint (CycloField n) :=
  @IntermediateField.LinearDisjoint.of_inf_eq_bot ℚ (AlgebraicClosure ℚ) _ _ _ (CycloField m)
    (CycloField n) (isGalois_cycloField m) (finiteDimensional_cycloField m)
    (finiteDimensional_cycloField n) (cycloField_inf_eq_bot_of_coprime m n h)

end

end Work.FieldTheory.Crossing
