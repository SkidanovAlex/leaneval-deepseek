namespace Work.Shrinking

/-- Under a homomorphism `f`, the subgroup generated by the `p`-th powers of `H` maps onto
the subgroup generated by the `p`-th powers of `H.map f`.  Surjectivity is not needed. -/
theorem map_powSubgroup {P Q : Type*} [Group P] [Group Q] (p : ℕ) (f : P →* Q)
    (H : Subgroup P) : (powSubgroup p H).map f = powSubgroup p (H.map f) := by
  rw [powSubgroup, powSubgroup, MonoidHom.map_closure, Subgroup.coe_map]
  congr 1
  ext y
  constructor
  · rintro ⟨x, ⟨z, hz, rfl⟩, rfl⟩
    exact ⟨f z, ⟨z, hz, rfl⟩, by simp⟩
  · rintro ⟨x, ⟨z, hz, rfl⟩, rfl⟩
    exact ⟨z ^ p, ⟨z, hz, rfl⟩, by simp⟩

/-- The descending `p`-central series is functorial for surjective homomorphisms: the image
of the `n`-th term is the `n`-th term.

Induction on `n`.  For a surjective `f`, powers map to powers, so
`(powSubgroup p H).map f = powSubgroup p (H.map f)` (surjectivity not needed here);
`Subgroup.map_commutator` gives `(⁅H, ⊤⁆).map f = ⁅H.map f, ⊤.map f⁆` and surjectivity turns
`⊤.map f` into `⊤` (`Subgroup.map_top_of_surjective`).  Combine with `Subgroup.map_sup` and
`Subgroup.map_top_of_surjective`. -/
theorem map_pCentralSeries_surjective {P Q : Type*} [Group P] [Group Q] (p : ℕ) (f : P →* Q)
    (hf : Function.Surjective f) (n : ℕ) :
    (pCentralSeries p P n).map f = pCentralSeries p Q n := by
  induction n with
  | zero =>
    rw [pCentralSeries_zero, pCentralSeries_zero, Subgroup.map_top_of_surjective f hf]
  | succ n ih =>
    rw [pCentralSeries_succ, pCentralSeries_succ, pCentralStep, pCentralStep,
        Subgroup.map_sup, map_powSubgroup, Subgroup.map_commutator, ih,
        Subgroup.map_top_of_surjective f hf]

end Work.Shrinking
