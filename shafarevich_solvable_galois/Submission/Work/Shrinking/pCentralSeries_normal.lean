namespace Work.Shrinking

/-- If `H` is a normal subgroup then the subgroup generated by its `p`-th powers is normal:
the conjugate `g * y ^ p * g⁻¹ = (g * y * g⁻¹) ^ p` of a generator is again a `p`-th power
of an element of `H`. -/
lemma powSubgroup_normal (p : ℕ) {P : Type*} [Group P] (H : Subgroup P) [H.Normal] :
    (powSubgroup p H).Normal := by
  refine Subgroup.Normal.mk fun n hn g => ?_
  have hφy : ∀ y : P, (MulAut.conj g).toMonoidHom y = g * y * g⁻¹ := by
    intro y
    change (MulAut.conj g) y = g * y * g⁻¹
    rw [MulAut.conj_apply]
  -- conjugation by `g` maps the generating set of `powSubgroup p H` into itself
  have hS : (MulAut.conj g).toMonoidHom '' ((fun x : P => x ^ p) '' (H : Set P))
      ⊆ ((fun x : P => x ^ p) '' (H : Set P)) := by
    rintro _ ⟨x, ⟨y, hy, rfl⟩, rfl⟩
    refine ⟨(MulAut.conj g).toMonoidHom y, ?_, ?_⟩
    · rw [hφy y]; exact (inferInstance : H.Normal).conj_mem y hy g
    · rw [map_pow]
  -- hence conjugation by `g` maps the generated subgroup into itself
  have hmap : Subgroup.map (MulAut.conj g).toMonoidHom
        (Subgroup.closure ((fun x : P => x ^ p) '' (H : Set P)))
      ≤ Subgroup.closure ((fun x : P => x ^ p) '' (H : Set P)) := by
    rw [MonoidHom.map_closure]
    exact Subgroup.closure_mono hS
  have hmem := hmap (Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hn)
  simpa [hφy n, powSubgroup] using hmem

/-- Every term of the descending `p`-central series is a normal subgroup.

Induction on `n`.  `⊤` is normal.  For the step: `pCentralStep p H = powSubgroup p H ⊔ ⁅H, ⊤⁆`
where `powSubgroup p H = Subgroup.closure ((fun x : P => x ^ p) '' (H : Set P))`.  If `H` is
normal then `powSubgroup p H` is normal: every conjugate `y * (x ^ p) * y⁻¹ = (y * x * y⁻¹) ^ p`
of a generator is again a `p`-th power of an element of `H` (use `Subgroup.normalClosure_le_normal`
together with `Subgroup.le_normalClosure`), and `Subgroup.commutator_normal` gives normality of
`⁅H, ⊤⁆` (as `⊤` is normal); use the instance `Subgroup.sup_normal` for the supremum. -/
theorem pCentralSeries_normal (p : ℕ) (P : Type*) [Group P] (n : ℕ) :
    (pCentralSeries p P n).Normal := by
  induction n with
  | zero => rw [pCentralSeries_zero]; exact Subgroup.normal_top
  | succ n ih =>
      rw [pCentralSeries_succ]
      have hH : (pCentralSeries p P n).Normal := ih
      have hpow : (powSubgroup p (pCentralSeries p P n)).Normal :=
        @powSubgroup_normal p P _ (pCentralSeries p P n) hH
      have hcom : (⁅pCentralSeries p P n, ⊤⁆ : Subgroup P).Normal :=
        @Subgroup.commutator_normal P _ (pCentralSeries p P n) ⊤ hH Subgroup.normal_top
      unfold pCentralStep
      exact @Subgroup.sup_normal P _ (powSubgroup p (pCentralSeries p P n))
        ⁅pCentralSeries p P n, ⊤⁆ hpow hcom

end Work.Shrinking
