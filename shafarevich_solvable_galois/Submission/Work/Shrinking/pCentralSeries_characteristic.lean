namespace Work.Shrinking

/-- If `H` is a characteristic subgroup then so is `H^p`, the subgroup generated by the
`p`-th powers of the elements of `H`: an automorphism `φ` maps the generating set
`(fun x => x ^ p) '' H` onto itself, because `φ (x ^ p) = (φ x) ^ p` and `φ '' H = H`
(and likewise for `φ.symm`). -/
instance powSubgroup_characteristic (p : ℕ) {P : Type*} [Group P] (H : Subgroup P)
    [H.Characteristic] : (powSubgroup p H).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro φ
  have hφH : φ.toMonoidHom '' (H : Set P) = (H : Set P) := by
    have h := Subgroup.characteristic_iff_map_eq.mp ‹H.Characteristic› φ
    simpa using congrArg (fun K : Subgroup P => (K : Set P)) h
  unfold powSubgroup
  rw [MonoidHom.map_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨x, ⟨z, hz, rfl⟩, rfl⟩
    refine ⟨φ z, ?_, ?_⟩
    · rw [← hφH]; exact ⟨z, hz, rfl⟩
    · simp
  · rintro ⟨z, hz, rfl⟩
    have hφsH : φ.symm.toMonoidHom '' (H : Set P) = (H : Set P) := by
      have h := Subgroup.characteristic_iff_map_eq.mp ‹H.Characteristic› φ.symm
      simpa using congrArg (fun K : Subgroup P => (K : Set P)) h
    refine ⟨(φ.symm z) ^ p, ⟨φ.symm z, ?_, rfl⟩, ?_⟩
    · rw [← hφsH]; exact ⟨z, hz, rfl⟩
    · simp

/-- Every term of the descending `p`-central series is a characteristic subgroup.

Induction on `n`, using `Subgroup.characteristic_iff_map_eq`: `⊤` is characteristic
(`Subgroup.topCharacteristic`) and if `H` is characteristic then so are
`powSubgroup p H = Subgroup.closure ((fun x : P => x ^ p) '' (H : Set P))` (for an automorphism
`φ`, `Subgroup.map_closure` and `map_pow` give `(powSubgroup p H).map φ.toMonoidHom = powSubgroup p H`)
and `⁅H, ⊤⁆` (`Subgroup.commutator_characteristic`, as `⊤` is characteristic).  Use the instance
`Subgroup.characteristic_sup` for the supremum. -/
theorem pCentralSeries_characteristic (p : ℕ) (P : Type*) [Group P] (n : ℕ) :
    (pCentralSeries p P n).Characteristic := by
  induction n with
  | zero => rw [pCentralSeries_zero]; exact Subgroup.topCharacteristic
  | succ n ih =>
    rw [pCentralSeries_succ]
    show (powSubgroup p (pCentralSeries p P n) ⊔ ⁅pCentralSeries p P n, ⊤⁆).Characteristic
    have : (pCentralSeries p P n).Characteristic := ih
    infer_instance

end Work.Shrinking
