namespace Work.LocalFields

open scoped NumberField Valued WithZero

set_option linter.style.haveILetI false

variable {K L : Type*} [Field K] [Field L] [NumberField K] [NumberField L]
  [Algebra K L] [FiniteDimensional K L] [IsGalois K L]

/-- **The completion `L_w` is a Galois extension of `K_v`.**

Since `L/K` is a finite Galois extension of number fields, `L` is the splitting field over `K`
of a separable polynomial `p`.  The completion `L_w` is generated over `K_v` by the images of
the roots of `p` (the subfield generated by them is finite dimensional over the complete field
`K_v`, hence closed, and contains the dense copy of `L`), so `L_w` is the splitting field of
`p.map (algebraMap K K_v)` over `K_v`, and is therefore Galois, being separable (characteristic
zero) with a splitting field. -/
theorem isGalois_completion (v : FinitePrime K) (w : FinitePrime L)
    [hw : w.asIdeal.LiesOver v.asIdeal]
    [Algebra (Completion K v) (Completion L w)]
    [ContinuousSMul (Completion K v) (Completion L w)]
    [IsScalarTower K (Completion K v) (Completion L w)] :
    IsGalois (Completion K v) (Completion L w) := by
  obtain ⟨p, hsep, hsp⟩ := IsGalois.is_separable_splitting_field K L
  let p' : Polynomial (Completion K v) := p.map (algebraMap K (Completion K v))
  have hsplit' : Polynomial.IsSplittingField (Completion K v) (Completion L w) p' := by
    refine Polynomial.IsSplittingField.mk ?_ ?_
    · have h1 : Polynomial.map (algebraMap (Completion K v) (Completion L w)) p' =
          Polynomial.map (algebraMap L (Completion L w)) (Polynomial.map (algebraMap K L) p) := by
        dsimp only [p']
        rw [Polynomial.map_map,
          ← IsScalarTower.algebraMap_eq K (Completion K v) (Completion L w),
          Polynomial.map_map,
          ← IsScalarTower.algebraMap_eq K L (Completion L w)]
      rw [h1]
      exact hsp.splits.map (algebraMap L (Completion L w))
    · set A : IntermediateField (Completion K v) (Completion L w) :=
        IntermediateField.adjoin (Completion K v) (p'.rootSet (Completion L w)) with hA
      have hAtop : A = ⊤ := by
        haveI : FiniteDimensional (Completion K v) (Completion L w) := inferInstance
        have hcl : IsClosed (A : Set (Completion L w)) := by
          haveI : FiniteDimensional (Completion K v) ↥(A.toSubalgebra.toSubmodule) :=
            Submodule.finiteDimensional_of_le (le_top)
          exact Submodule.closed_of_finiteDimensional A.toSubalgebra.toSubmodule
        have hdense : closure (Set.range (algebraMap L (Completion L w))) = Set.univ :=
          (IsDedekindDomain.HeightOneSpectrum.denseRange_algebraMap L w).closure_range
        set φ : L →ₐ[K] (Completion L w) := IsScalarTower.toAlgHom K L (Completion L w) with hφ
        have hφ_apply : ∀ y : L, φ y = algebraMap L (Completion L w) y :=
          fun y => IsScalarTower.toAlgHom_apply K L (Completion L w) y
        have hroot : ∀ r ∈ p.rootSet L, φ r ∈ (A : Set (Completion L w)) := by
          intro r hr
          obtain ⟨hp0, hpr⟩ := Polynomial.mem_rootSet.mp hr
          have hp'0 : p' ≠ 0 := by
            dsimp only [p']
            rw [Polynomial.map_ne_zero_iff (f := algebraMap K (Completion K v)) emb_injective]
            exact hp0
          have h1 : (Polynomial.aeval (φ r)) p' = 0 := by
            rw [← Polynomial.aeval_eq_aeval_map (φ := algebraMap K (Completion K v))
              (IsScalarTower.algebraMap_eq K (Completion K v) (Completion L w)).symm]
            rw [Polynomial.aeval_algHom_apply, hpr, map_zero]
          rw [hA]
          exact (IntermediateField.subset_adjoin (Completion K v) (p'.rootSet (Completion L w)))
            (Polynomial.mem_rootSet.mpr ⟨hp'0, h1⟩)
        have hrange : Set.range (algebraMap L (Completion L w)) ⊆ (A : Set (Completion L w)) := by
          rintro x ⟨y, rfl⟩
          rw [← hφ_apply y]
          have hy : y ∈ Algebra.adjoin K (p.rootSet L) := by
            rw [hsp.adjoin_rootSet]; exact IntermediateField.mem_top
          have h1 : φ y ∈ Algebra.adjoin K (φ '' (p.rootSet L)) := by
            rw [← AlgHom.map_adjoin φ (p.rootSet L)]
            exact Subalgebra.mem_map.mpr ⟨y, hy, rfl⟩
          have h2 : Algebra.adjoin K (φ '' (p.rootSet L)) ≤
              (IntermediateField.adjoin K (φ '' (p.rootSet L))).toSubalgebra := by
            rw [Algebra.adjoin_le_iff]
            intro t ht
            exact IntermediateField.subset_adjoin K (φ '' (p.rootSet L)) ht
          have h1' : φ y ∈ (IntermediateField.adjoin K (φ '' (p.rootSet L)) :
              Set (Completion L w)) := h2 h1
          have h3 : IntermediateField.adjoin K (φ '' (p.rootSet L)) ≤
              IntermediateField.restrictScalars K A := by
            rw [IntermediateField.adjoin_le_iff]
            rintro z ⟨r, hr, rfl⟩
            exact hroot r hr
          exact h3 h1'
        have hsub : Set.univ ⊆ (A : Set (Completion L w)) := by
          rw [← hdense, ← hcl.closure_eq]
          exact closure_mono hrange
        exact eq_top_iff.mpr (fun a _ => hsub (Set.mem_univ a))
      rw [← IntermediateField.adjoin_eq_top_iff]
      rw [← hA]
      exact hAtop
  haveI : Polynomial.IsSplittingField (Completion K v) (Completion L w) p' := hsplit'
  have hsep' : p'.Separable := by
    dsimp only [p']
    exact hsep.map (f := algebraMap K (Completion K v))
  exact IsGalois.of_separable_splitting_field (p := p') hsep'

/-- The degree of the local extension `L_w/K_v` equals the cardinality of its group of
`K_v`-linear automorphisms, by the main theorem of Galois theory (applied to the fact, proved in
`isGalois_completion`, that `L_w/K_v` is Galois). -/
theorem finrank_completion_eq_card_algEquiv (v : FinitePrime K) (w : FinitePrime L)
    [hw : w.asIdeal.LiesOver v.asIdeal]
    [Algebra (Completion K v) (Completion L w)]
    [ContinuousSMul (Completion K v) (Completion L w)]
    [IsScalarTower K (Completion K v) (Completion L w)] :
    Module.finrank (Completion K v) (Completion L w) =
      Nat.card ((Completion L w) ≃ₐ[Completion K v] (Completion L w)) := by
  haveI := isGalois_completion v w
  exact (IsGalois.card_aut_eq_finrank (Completion K v) (Completion L w)).symm

/-- **The local degree is the order of the decomposition group.**

For a finite Galois extension `L/K` of number fields, a finite prime `v` of `K` and a finite prime
`w` of `L` lying over `v`, the degree of the local extension `L_w/K_v` equals the cardinality of
the decomposition group `D_w ≤ Gal(L/K)`.

Indeed `D_w` is canonically the group of `K_v`-algebra automorphisms of `L_w`
(`card_decompositionGroup_le_card_algEquiv`) and, conversely, the restriction of any
`K_v`-automorphism to the dense copy of `L` lands in the decomposition group
(`card_algEquiv_le_card_decompositionGroup`); since `L_w/K_v` is Galois, the degree of `L_w/K_v`
is the order of its automorphism group (`finrank_completion_eq_card_algEquiv`). -/
theorem finrank_completion_eq_card_decompositionGroup {K L : Type*} [Field K] [Field L]
    [NumberField K] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (v : Work.LocalFields.FinitePrime K) (w : Work.LocalFields.FinitePrime L)
    [hw : w.asIdeal.LiesOver v.asIdeal]
    [Algebra (Work.LocalFields.Completion K v) (Work.LocalFields.Completion L w)]
    [ContinuousSMul (Work.LocalFields.Completion K v) (Work.LocalFields.Completion L w)]
    [IsScalarTower K (Work.LocalFields.Completion K v) (Work.LocalFields.Completion L w)] :
    Module.finrank (Work.LocalFields.Completion K v) (Work.LocalFields.Completion L w) =
      Nat.card (Work.LocalFields.decompositionGroup K w) := by
  rw [finrank_completion_eq_card_algEquiv v w]
  exact le_antisymm (card_algEquiv_le_card_decompositionGroup v w)
    (card_decompositionGroup_le_card_algEquiv v w)

end Work.LocalFields
