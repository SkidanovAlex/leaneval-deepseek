namespace Work.LocalFields

/-- **An unramified prime has cyclic decomposition group, generated by Frobenius.**

For a finite Galois extension `L/K` of number fields, a finite prime `w` of `L` lying over a
finite prime `v` of `K`, and `w` unramified over `K` (i.e. with trivial inertia subgroup
`I_w = ⊥`), the whole decomposition group `D_w` is generated by the Frobenius element
`frobenius v w`:

`Subgroup.zpowers (frobenius v w) = ⊤`.

This is the classical statement that an unramified local extension has cyclic Galois group,
generated by the Frobenius: indeed `I_w = ⊥` makes the canonical map `D_w → D_w ⧸ I_w`
injective, and `D_w ⧸ I_w` is the Galois group of the residue extension `κ_w/κ_v`, an extension
of finite fields whose Galois group is cyclic generated by the Frobenius
`residueFrobenius v w`, which is the image of `frobenius v w` under
`ramificationExactSequence v w`. -/
theorem frobenius_generates_of_unramified {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (v : Work.LocalFields.FinitePrime K) (w : Work.LocalFields.FinitePrime L)
    [hw : w.asIdeal.LiesOver v.asIdeal] (hunr : Work.LocalFields.IsUnramifiedAt K w) :
    Subgroup.zpowers (Work.LocalFields.frobenius v w) = ⊤ := by
  -- Unramified means trivial inertia subgroup, so `D_w → D_w ⧸ I_w` is injective.
  have hI : inertiaSubgroup K w = ⊥ := hunr
  have hinj : Function.Injective (QuotientGroup.mk' (inertiaSubgroup K w)) := by
    rw [← MonoidHom.ker_eq_bot_iff, QuotientGroup.ker_mk']
    exact hI
  -- The quotient `D_w ⧸ I_w ≃* Gal(κ_w/κ_v)` is generated by the class of the Frobenius,
  -- because the Galois group of the residue extension is generated by `residueFrobenius`,
  -- which is the image of `frobenius v w` under the ramification exact sequence.
  have hgen : Subgroup.zpowers (QuotientGroup.mk' (inertiaSubgroup K w)
      (frobenius v w)) = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro y
    rw [Subgroup.mem_zpowers_iff]
    obtain ⟨n, hn⟩ := exists_pow_eq_residueFrobenius v w ((ramificationExactSequence v w) y)
    refine ⟨(n : ℤ), ?_⟩
    apply (ramificationExactSequence v w).injective
    rw [map_zpow, QuotientGroup.mk'_apply, frobenius_spec, hn, zpow_natCast]
  -- Lift generation in the quotient to generation in `D_w` using injectivity of `D_w → D_w ⧸ I_w`.
  rw [Subgroup.eq_top_iff']
  intro σ
  have h : QuotientGroup.mk' (inertiaSubgroup K w) σ ∈
      Subgroup.zpowers (QuotientGroup.mk' (inertiaSubgroup K w) (frobenius v w)) := by
    rw [hgen]; exact Subgroup.mem_top _
  rw [Subgroup.mem_zpowers_iff] at h
  obtain ⟨k, hk⟩ := h
  rw [Subgroup.mem_zpowers_iff]
  exact ⟨k, hinj (by rw [map_zpow, hk])⟩

end Work.LocalFields
