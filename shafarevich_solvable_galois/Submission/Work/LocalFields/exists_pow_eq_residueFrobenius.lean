open scoped NumberField

namespace Work.LocalFields

/-- Every `𝓞 K ⧸ v`-algebra automorphism of the residue field `𝓞 L ⧸ w` is a power of the
Frobenius: the residue field extension is an extension of finite fields, and the Galois group of
an extension of finite fields is cyclic, generated by the Frobenius. -/
theorem exists_pow_eq_residueFrobenius {K L : Type*} [Field K] [Field L] [NumberField K]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (v : Work.LocalFields.FinitePrime K) (w : Work.LocalFields.FinitePrime L)
    [hw : w.asIdeal.LiesOver v.asIdeal]
    (σ : (NumberField.RingOfIntegers L ⧸ w.asIdeal) ≃ₐ[NumberField.RingOfIntegers K ⧸ v.asIdeal]
      (NumberField.RingOfIntegers L ⧸ w.asIdeal)) :
    ∃ n : ℕ, σ = (Work.LocalFields.residueFrobenius v w) ^ n := by
  letI : Field (𝓞 K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  letI : Field (𝓞 L ⧸ w.asIdeal) := Ideal.Quotient.field w.asIdeal
  obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
    (𝓞 K ⧸ v.asIdeal) (𝓞 L ⧸ w.asIdeal)).2 σ
  exact ⟨n.1, by
    rw [show Work.LocalFields.residueFrobenius v w =
      FiniteField.frobeniusAlgEquivOfAlgebraic (𝓞 K ⧸ v.asIdeal) (𝓞 L ⧸ w.asIdeal) from rfl]
    exact hn.symm⟩

end Work.LocalFields
