namespace Work.LocalFields

open scoped NumberField Valued WithZero

namespace IsLocalField

variable {k : Type*} [Field k] [Valued k ℤᵐ⁰] [IsLocalField k]

/-- A uniformizer of a local field: a generator of the maximal ideal of the ring of integers. -/
noncomputable def uniformizer : 𝒪[k] :=
  Classical.choose (IsDiscreteValuationRing.exists_irreducible 𝒪[k])

theorem uniformizer_irreducible : Irreducible (uniformizer (k := k)) :=
  Classical.choose_spec (IsDiscreteValuationRing.exists_irreducible 𝒪[k])

/-- The maximal ideal of a local field is generated by a uniformizer. -/
theorem maximalIdeal_eq_span_uniformizer :
    𝓂[k] = Ideal.span {uniformizer (k := k)} :=
  (uniformizer_irreducible (k := k)).maximalIdeal_eq

/-- The maximal ideal of a uniformizer is nonzero: `𝓂 ≠ 0`. -/
theorem uniformizer_ne_zero : (uniformizer (k := k) : 𝒪[k]) ≠ 0 :=
  (uniformizer_irreducible (k := k)).ne_zero

/-- The residue field of a local field is nontrivial (it has at least two elements). -/
theorem one_lt_card_residueField : 1 < Nat.card 𝓀[k] :=
  Finite.one_lt_card

/-- Quotients of the ring of integers of a local field by powers of the maximal ideal are
finite. -/
theorem finite_quotient_maximalIdeal_pow (n : ℕ) :
    Finite (𝒪[k] ⧸ 𝓂[k] ^ n) :=
  inferInstance

end IsLocalField

section Completion

variable {K : Type*} [Field K] [NumberField K] (v : FinitePrime K)

/-- A uniformizer of the completion `K_v`. -/
noncomputable def completionUniformizer : 𝒪[Completion K v] :=
  IsLocalField.uniformizer (k := Completion K v)

theorem completionUniformizer_irreducible : Irreducible (completionUniformizer v) :=
  IsLocalField.uniformizer_irreducible (k := Completion K v)

/-- The maximal ideal of `𝒪_v` is generated by a uniformizer. -/
theorem completion_maximalIdeal_eq_span_uniformizer :
    𝓂[Completion K v] = Ideal.span {completionUniformizer v} :=
  IsLocalField.maximalIdeal_eq_span_uniformizer (k := Completion K v)

/-- The residue field of the completion is finite. -/
theorem completion_finite_residue : Finite 𝓀[Completion K v] := inferInstance

end Completion

end Work.LocalFields
