# Only finitely many finite primes of a number field ramify over `ℚ`

For a number field `K`, only finitely many prime ideals of `𝓞 K` have ramification index
`≠ 1` over `ℤ`.  The classical proof goes through the discriminant: a prime `p` that does not
divide `discr K` is unramified in `𝓞 K` (`NumberField.not_dvd_discr_iff_forall_mem`), so every
ramified prime `v` contains the integer `discr K`, i.e. `v.asIdeal` divides the principal ideal
generated by `discr K`.  The prime divisors of a nonzero ideal of a Dedekind domain are finite
(`Ideal.finite_factors`), which gives the claim.

## Main results

* `Work.LocalFields.ramified_dvd_span_discr`: a ramified finite prime divides the principal ideal
  generated by the discriminant.
* `Work.LocalFields.finite_ramified_primes`: there are only finitely many ramified finite primes.
-/
import Mathlib
import Submission.Work.LocalFields.Basic
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace Work.LocalFields

open scoped NumberField

set_option linter.style.haveILetI false

variable {K : Type*} [Field K] [NumberField K]

/-- The discriminant `discr K` of a number field, viewed as an element of `𝓞 K`, is nonzero.
Equivalently, the principal ideal it generates is nonzero. -/
lemma discr_cast_ne_zero (K : Type*) [Field K] [NumberField K] :
    (NumberField.discr K : 𝓞 K) ≠ 0 := by
  intro h
  exact NumberField.discr_ne_zero K (by exact_mod_cast h)

/-- **A ramified finite prime divides the discriminant.**  If the ramification index of a finite
prime `v` of `K` over `ℤ` is not `1`, then `v.asIdeal` divides the principal ideal generated by
the discriminant `discr K`.

Indeed, let `p` generate the nonzero prime ideal `v.asIdeal.under ℤ`.  If `p ∤ discr K`, then `p`
is unramified in `𝓞 K` (`NumberField.not_dvd_discr_iff_forall_mem`), so `e(v) = 1`, contrary to
the hypothesis; hence `p ∣ discr K`, so `discr K ∈ v.asIdeal.under ℤ ≤ v.asIdeal`. -/
lemma ramified_dvd_span_discr {v : FinitePrime K} (hv : Ideal.ramificationIdx v.asIdeal ℤ ≠ 1) :
    v.asIdeal ∣ Ideal.span {(NumberField.discr K : 𝓞 K)} := by
  rw [Ideal.dvd_iff_le, Ideal.span_le, Set.singleton_subset_iff]
  haveI := v.isPrime
  haveI hmaxu : (v.asIdeal.under ℤ).IsMaximal := Ideal.IsMaximal.under ℤ v.asIdeal
  have hne : v.asIdeal.under ℤ ≠ ⊥ := Ideal.IsMaximal.ne_bot_of_isIntegral_int (v.asIdeal.under ℤ)
  -- write `v.asIdeal.under ℤ = Ideal.span {p}` with `p` prime
  obtain ⟨p, hp⟩ := IsPrincipalIdealRing.principal (v.asIdeal.under ℤ)
  have hp0 : p ≠ 0 := by
    intro h
    apply hne
    rw [hp, h]
    simp
  have hpprime : Prime p := by
    refine (Ideal.span_singleton_prime hp0).mp ?_
    rw [show Ideal.span {p} = v.asIdeal.under ℤ from hp.symm]
    exact Ideal.IsPrime.under ℤ v.asIdeal
  -- the prime `p` lies in `v`
  have hmem : (algebraMap ℤ (𝓞 K)) p ∈ v.asIdeal := by
    have hp_mem : p ∈ v.asIdeal.under ℤ := by
      rw [hp]; exact Submodule.mem_span_singleton_self p
    exact Ideal.mem_comap.mp hp_mem
  -- if `p ∤ discr K`, then `v` would be unramified, so `p ∣ discr K`
  have hpdvd : p ∣ NumberField.discr K := by
    by_contra h
    haveI : Algebra.IsUnramifiedAt ℤ v.asIdeal :=
      (NumberField.not_dvd_discr_iff_forall_mem (K := K) (𝒪 := 𝓞 K) hpprime).mp h
        v.asIdeal v.isPrime hmem
    exact hv (Ideal.ramificationIdx_eq_one_of_isUnramifiedAt)
  have : NumberField.discr K ∈ v.asIdeal.under ℤ := by
    rw [hp]
    exact Ideal.mem_span_singleton.mpr hpdvd
  exact Ideal.mem_comap.mp this

/-- **Only finitely many finite primes of a number field ramify over `ℚ`.**  The set of finite
primes of `K` whose ramification index over `ℤ` differs from `1` is finite. -/
theorem finite_ramified_primes {K : Type*} [Field K] [NumberField K] :
    {v : Work.LocalFields.FinitePrime K | Ideal.ramificationIdx v.asIdeal ℤ ≠ 1}.Finite := by
  refine (Ideal.finite_factors (I := Ideal.span {(NumberField.discr K : 𝓞 K)})
    (by simpa [Ideal.span_singleton_eq_bot] using discr_cast_ne_zero K)).subset ?_
  intro v hv
  exact ramified_dvd_span_discr hv

end Work.LocalFields
