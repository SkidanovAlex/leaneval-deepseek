/-!
# The normal closure of the inertia group at `q'` fixes an unramified intermediate field

Let `k ⊆ K₁ ⊆ L` be number fields with `L/k` (hence `L/K₁`) Galois, let `EL` be an intermediate
field `K₁ ⊆ EL ⊆ L`, and let `q'` be a finite place of `L`.  Suppose

* every prime `p'` of `K₁` above the prime `q' ∩ k` of `k` is unramified over `k`, and
* for every such `p'` and every prime `𝔮'` of `EL` above `p'`, the ramification index of `𝔮'`
  over `K₁` is `1`.

Then every element of the normal closure (in `Gal(L/k)`) of the inertia group `I_{q'}` of `q'`
fixes `EL` pointwise.

The proof is the classical one.  Every prime `𝔮'` of `EL` above `q' ∩ k` has
`e(𝔮' | k) = e(𝔮' | p') · e(p' | k) = 1` by the tower formula, so TPatom's criterion
(`Work.SSGRoute.TPatom.inertia_le_fixingSubgroup_of_ramificationIdx_eq_one`) applies to `𝔮'`: the
inertia group of any prime of `L` above `𝔮'` fixes `EL` pointwise.  Now the normal closure of
`I_{q'}` is generated by the conjugates `c I_{q'} c⁻¹`, and `c I_{q'} c⁻¹` is the inertia group of
`c · q'` (`Work.SSGRoute.E9b.isInertiaAt_smulHeightOneSpectrum_iff`), a prime of `L` which still
lies above `q' ∩ k` (`NK.GlobalCFT.Galois.globalCFT_finitePlace_smul_liesOver`), so the previous
paragraph applies to it as well.
-/

open scoped NumberField

set_option linter.style.haveILetI false

namespace Work.SSGcrux

/-- The functoriality of `𝓞`: a tower of fields induces a tower of their rings of integers. -/
private lemma ringOfIntegers_isScalarTower {A B C : Type} [Field A] [Field B] [Field C]
    [Algebra A B] [Algebra B C] [Algebra A C] [IsScalarTower A B C] :
    IsScalarTower (NumberField.RingOfIntegers A) (NumberField.RingOfIntegers B)
      (NumberField.RingOfIntegers C) := by
  refine IsScalarTower.of_algebraMap_eq fun x => ?_
  apply NumberField.RingOfIntegers.ext
  change (algebraMap A C (x : A) : C) =
    ((NumberField.RingOfIntegers.mapRingHom (algebraMap B C))
      (NumberField.RingOfIntegers.mapRingHom (algebraMap A B) x) : C)
  rw [NumberField.RingOfIntegers.mapRingHom_apply, NumberField.RingOfIntegers.mapRingHom_apply]
  exact IsScalarTower.algebraMap_apply A B C (x : A)

/-- **The prime of `K₁` below a prime of `EL` below a prime of `L` has the same prime of `k`
below it as `q'` does.** -/
private lemma ramIdx_under_EL_eq_one
  {k K1 L : Type} [Field k] [NumberField k] [Field K1] [NumberField K1] [Field L] [NumberField L]
    [Algebra k K1] [Algebra K1 L] [Algebra k L] [IsScalarTower k K1 L]
    [FiniteDimensional k K1] [FiniteDimensional k L]
  (EL : IntermediateField K1 L) [FiniteDimensional K1 EL]
  (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
  (hunrK1 : ∀ p' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K1),
      p'.asIdeal.LiesOver (q'.asIdeal.under (NumberField.RingOfIntegers k)) →
      p'.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1)
  (hunrEL : ∀ p' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K1),
      p'.asIdeal.LiesOver (q'.asIdeal.under (NumberField.RingOfIntegers k)) →
      ∀ 𝔮' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers EL),
        𝔮'.asIdeal.LiesOver p'.asIdeal →
        𝔮'.asIdeal.ramificationIdx (NumberField.RingOfIntegers K1) = 1)
  (q'' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
  (hq'' : q''.asIdeal.LiesOver (q'.asIdeal.under (NumberField.RingOfIntegers k))) :
  (q''.asIdeal.under (NumberField.RingOfIntegers EL)).ramificationIdx
    (NumberField.RingOfIntegers k) = 1 := by
  haveI : NumberField ↥EL := inferInstance
  haveI hst1 : IsScalarTower (𝓞 k) (𝓞 K1) (𝓞 L) := ringOfIntegers_isScalarTower
  haveI hst3 : IsScalarTower (𝓞 K1) (𝓞 ↥EL) (𝓞 L) := ringOfIntegers_isScalarTower
  haveI hst2 : IsScalarTower (𝓞 k) (𝓞 K1) (𝓞 ↥EL) := ringOfIntegers_isScalarTower
  -- the primes of `K₁` and of `EL` below `q''`
  let p' : IsDedekindDomain.HeightOneSpectrum (𝓞 K1) :=
    ⟨q''.asIdeal.under (𝓞 K1), inferInstance, Ideal.under_ne_bot _ q''.ne_bot⟩
  let 𝔮' : IsDedekindDomain.HeightOneSpectrum (𝓞 ↥EL) :=
    ⟨q''.asIdeal.under (𝓞 ↥EL), inferInstance, Ideal.under_ne_bot _ q''.ne_bot⟩
  have hp'v : p'.asIdeal.LiesOver (q'.asIdeal.under (𝓞 k)) :=
    Ideal.LiesOver.mk (by rw [Ideal.under_under, hq''.over])
  have h𝔮'p' : 𝔮'.asIdeal.LiesOver p'.asIdeal :=
    Ideal.LiesOver.mk (by rw [Ideal.under_under])
  haveI : 𝔮'.asIdeal.LiesOver p'.asIdeal := h𝔮'p'
  -- the two factors of the tower formula are `1`
  have he1 : p'.asIdeal.ramificationIdx (𝓞 k) = 1 := hunrK1 p' hp'v
  have he2 : 𝔮'.asIdeal.ramificationIdx (𝓞 K1) = 1 := hunrEL p' hp'v 𝔮' h𝔮'p'
  show 𝔮'.asIdeal.ramificationIdx (𝓞 k) = 1
  rw [Ideal.ramificationIdx_tower (R := 𝓞 k) p'.asIdeal 𝔮'.asIdeal, he1, he2, one_mul]

theorem normalClosure_inertia_le_fixingSubgroup
  {k K1 L : Type} [Field k] [NumberField k] [Field K1] [NumberField K1] [Field L] [NumberField L]
    [Algebra k K1] [Algebra K1 L] [Algebra k L] [IsScalarTower k K1 L]
    [FiniteDimensional k K1] [IsGalois k K1] [FiniteDimensional k L] [IsGalois k L]
  (EL : IntermediateField K1 L) [FiniteDimensional K1 EL]
  (q' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
  (hunrK1 : ∀ p' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K1),
      p'.asIdeal.LiesOver (q'.asIdeal.under (NumberField.RingOfIntegers k)) →
      p'.asIdeal.ramificationIdx (NumberField.RingOfIntegers k) = 1)
  (hunrEL : ∀ p' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K1),
      p'.asIdeal.LiesOver (q'.asIdeal.under (NumberField.RingOfIntegers k)) →
      ∀ 𝔮' : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers EL),
        𝔮'.asIdeal.LiesOver p'.asIdeal →
        𝔮'.asIdeal.ramificationIdx (NumberField.RingOfIntegers K1) = 1) :
  ∀ x : L ≃ₐ[k] L,
    x ∈ Subgroup.normalClosure {σ : L ≃ₐ[k] L | SSGRoute.PTExt.IsInertiaAt q' σ} →
    ∀ z : L, z ∈ EL → x z = z := by
  haveI : NumberField ↥EL := inferInstance
  intro x hx
  -- it suffices to prove the inclusion of subgroups `N ≤ Gal(L/EL)`
  have hsub : Subgroup.normalClosure {σ : L ≃ₐ[k] L | SSGRoute.PTExt.IsInertiaAt q' σ} ≤
      (EL.restrictScalars k).fixingSubgroup := by
    -- the normal closure is the subgroup generated by the conjugates of the inertia group
    rw [Subgroup.normalClosure, Subgroup.closure_le]
    intro y hy
    rw [Group.mem_conjugatesOfSet_iff] at hy
    obtain ⟨a, ha, hconj⟩ := hy
    rw [isConj_iff] at hconj
    obtain ⟨c, rfl⟩ := hconj
    -- `c a c⁻¹` is the inertia element at the conjugate prime `c · q'`
    have ha' : SSGRoute.PTExt.IsInertiaAt
        (NK.GlobalCFT.Place.smulHeightOneSpectrum c q') (c * a * c⁻¹) := by
      rw [Work.SSGRoute.E9b.isInertiaAt_smulHeightOneSpectrum_iff]
      rw [show c⁻¹ * (c * a * c⁻¹) * c = a by group]
      exact ha
    have hmem : c * a * c⁻¹ ∈ Ideal.inertia (L ≃ₐ[k] L)
        (NK.GlobalCFT.Place.smulHeightOneSpectrum c q').asIdeal :=
      (Work.SSGRoute.E9Nodes.isInertiaAt_iff_mem_inertia (k := k) (K := L)
        (NK.GlobalCFT.Place.smulHeightOneSpectrum c q') (c * a * c⁻¹)).mp ha'
    -- the conjugate prime still lies above `q' ∩ 𝓞 k`
    let Q : IsDedekindDomain.HeightOneSpectrum (𝓞 k) :=
      ⟨q'.asIdeal.under (𝓞 k), inferInstance, Ideal.under_ne_bot _ q'.ne_bot⟩
    have hlies : (NK.GlobalCFT.Place.smulHeightOneSpectrum c q').asIdeal.LiesOver
        (q'.asIdeal.under (𝓞 k)) :=
      (NK.GlobalCFT.Galois.globalCFT_finitePlace_smul_liesOver (K := k) (L := L) c q' Q).mpr
        (Ideal.over_under q'.asIdeal)
    -- TPatom's criterion, applied to the conjugate prime
    refine (Work.SSGRoute.TPatom.inertia_le_fixingSubgroup_of_ramificationIdx_eq_one
      (k := k) (M := L) (EL.restrictScalars k)
      (NK.GlobalCFT.Place.smulHeightOneSpectrum c q') ?_) hmem
    exact ramIdx_under_EL_eq_one EL q' hunrK1 hunrEL _ hlies
  intro z hz
  exact (IntermediateField.mem_fixingSubgroup_iff (EL.restrictScalars k) x).mp (hsub hx) z hz

end Work.SSGcrux
