/-!
# The norm witness at a ramified archimedean place

Let `d` be a `2`-cochain on `G_k = Gal(k̄/k)` with values in `k̄ˣ` which factors through a finite
Galois level `L` (`hfac`, `hvals`) and which is a coboundary on the cyclic subgroup generated by
every involution of `G_k` (`hinv`).  Let `v` be a complex infinite place of `L`, `σ` an involution
of `G_k` whose restriction to `L` is the complex conjugation `s` at `v`, and `φ : k̄ →+* ℂ` a ring
homomorphism extending `v.embedding` and intertwining `σ` with complex conjugation.

Then the element `X = C(s,s) · C(1,1)`, where `C(γ,δ) = unitsToLocalUnitsHom v (levelCocycle γ δ)`,
of the local field `L_vˣ` is a norm for the local extension: there is `z` with `(s • z) * z = X`.

The proof: `e := ringEquivComplexOfIsComplex hvC : L_v ≃+* ℂ` intertwines the local action of `s`
with complex conjugation (`localAutHom_ringEquivComplex`).  Using the involution-coboundary clause
for `σ` (`involution_coboundary_toMul`), `φ(X) = conj(u) * u` where `u = φ(b σ)`, so `z := e⁻¹ u`
satisfies `e((s • z) * z) = conj(u) * u = e(X)`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option maxHeartbeats 1600000

noncomputable section

open scoped Classical

namespace Work.sha2_hasse

/-- **The local action at a complex place is complex conjugation.**  If `σ` fixes the complex
infinite place `w` and acts on `L` by complex conjugation with respect to `w.embedding`, then the
canonical local automorphism of `L_w` attached to `σ` is complex conjugation under the
identification `L_w ≃+* ℂ` given by `ringEquivComplexOfIsComplex`.

Both sides are continuous and agree on the dense image of `L`; on the image they read
`w.embedding (σ x) = conj (w.embedding x)` by `hconj`. -/
theorem localAutHom_ringEquivComplex
    {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    (w : NumberField.InfinitePlace L) (hwC : w.IsComplex)
    (σ : MulAction.stabilizer (L ≃ₐ[K] L) (NK.GlobalCFT.Place.ofInfinite w))
    (hconj : ∀ x : L, NumberField.InfinitePlace.embedding w ((σ : L ≃ₐ[K] L) x) =
      starRingEnd ℂ (NumberField.InfinitePlace.embedding w x)) :
    ∀ y : NK.GlobalCFT.Place.localField L (NK.GlobalCFT.Place.ofInfinite w),
      NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
        (NK.HassePrinciple.localAutHom (NK.GlobalCFT.Place.ofInfinite w) σ y) =
      starRingEnd ℂ
        (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC y) := by
  intro y
  change NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
        (NK.HassePrinciple.localAut (NK.GlobalCFT.Place.ofInfinite w) σ y) =
      starRingEnd ℂ
        (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC y)
  have hcont1 : Continuous (fun z : w.Completion =>
      NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
        (NK.HassePrinciple.localAut (NK.GlobalCFT.Place.ofInfinite w) σ z)) :=
    (NumberField.InfinitePlace.Completion.isometry_extensionEmbedding w).continuous.comp
      (NK.HassePrinciple.localAut_continuous (NK.GlobalCFT.Place.ofInfinite w) σ)
  have hcont2 : Continuous (fun z : w.Completion =>
      starRingEnd ℂ
        (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC z)) :=
    Complex.continuous_conj.comp
      (NumberField.InfinitePlace.Completion.isometry_extensionEmbedding w).continuous
  have key : (fun z : w.Completion =>
      NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
        (NK.HassePrinciple.localAut (NK.GlobalCFT.Place.ofInfinite w) σ z))
      = fun z : w.Completion =>
      starRingEnd ℂ
        (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC z) := by
    apply DenseRange.equalizer
      (f := ⇑(algebraMap L w.Completion))
      (NK.GlobalCFT.Galois.denseRange_algebraMap_localField (NK.GlobalCFT.Place.ofInfinite w))
      hcont1 hcont2
    funext x
    simp only [Function.comp_apply]
    change NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
        (NK.HassePrinciple.localAut (NK.GlobalCFT.Place.ofInfinite w) σ
          (algebraMap L (NK.GlobalCFT.Place.localField L
            (NK.GlobalCFT.Place.ofInfinite w)) x))
      = starRingEnd ℂ
          (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hwC
            (algebraMap L (NK.GlobalCFT.Place.localField L
              (NK.GlobalCFT.Place.ofInfinite w)) x))
    rw [NK.HassePrinciple.localAut_algebraMap]
    rw [NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex_apply,
      NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex_apply]
    rw [NumberField.InfinitePlace.Completion.algebraMap_apply,
      NumberField.InfinitePlace.Completion.algebraMap_apply,
      NumberField.InfinitePlace.Completion.extensionEmbedding_coe,
      NumberField.InfinitePlace.Completion.extensionEmbedding_coe]
    simp only [WithAbs.equiv_apply]
    exact hconj x
  exact congrFun key y

/-- **The `ℂ`-identification sends the coefficient map `Lˣ → L_vˣ` to the embedding `φ` of `k̄`.**
For a global unit `y` of the level, `ringEquivComplexOfIsComplex hvC` composed with
`unitsToLocalUnitsHom v` equals `φ` composed with the inclusion `Lˣ ↪ k̄ˣ`, because `φ` extends
`v.embedding`. -/
theorem unitsToLocalUnits_ringEquivComplex
    {k : Type} [Field k] [NumberField k]
    (L : FiniteGaloisIntermediateField k (AlgebraicClosure k))
    (v : NumberField.InfinitePlace (Work.SSGRoute.sha2_hasse.Lf L)) (hvC : v.IsComplex)
    (φ : AlgebraicClosure k →+* ℂ)
    (hφL : ∀ x : Work.SSGRoute.sha2_hasse.Lf L,
      φ (algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k) x) =
        NumberField.InfinitePlace.embedding v x)
    (y : (Work.SSGRoute.sha2_hasse.Lf L)ˣ) :
    Units.map
        (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hvC).toMonoidHom
        (NK.HassePrinciple.unitsToLocalUnitsHom (NK.GlobalCFT.Place.ofInfinite v) y)
      = Units.map φ.toMonoidHom
          (Units.map (algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k)).toMonoidHom
            y) := by
  apply Units.ext
  simp only [Units.coe_map, NK.HassePrinciple.unitsToLocalUnitsHom]
  change (NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hvC)
      ((algebraMap (Work.SSGRoute.sha2_hasse.Lf L)
        (NK.GlobalCFT.Place.localField (Work.SSGRoute.sha2_hasse.Lf L)
          (NK.GlobalCFT.Place.ofInfinite v))) (y : Work.SSGRoute.sha2_hasse.Lf L))
    = φ ((algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k))
        (y : Work.SSGRoute.sha2_hasse.Lf L))
  rw [NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex_apply,
    NumberField.InfinitePlace.Completion.algebraMap_apply,
    NumberField.InfinitePlace.Completion.extensionEmbedding_coe]
  simp only [WithAbs.equiv_apply]
  exact (hφL (y : Work.SSGRoute.sha2_hasse.Lf L)).symm

/-- **The order-two coboundary relation, in multiplicative form.**  If `d = d¹b` on the cyclic
group generated by an involution `σ`, then the element `toMul (d σ σ) * toMul (d 1 1)` of `k̄ˣ` is
`σ • b σ · b σ`, i.e. `N(b σ)` for the action of the order-two group `⟨σ⟩`. -/
theorem involution_coboundary_toMul
    {k : Type} [Field k]
    (d : (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) →
      (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) → Additive (AlgebraicClosure k)ˣ)
    (b : (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) → Additive (AlgebraicClosure k)ˣ)
    (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) (hσ2 : σ ^ 2 = 1)
    (hb : ∀ g ∈ Subgroup.zpowers σ, ∀ h ∈ Subgroup.zpowers σ,
        d g h = g • b h - b (g * h) + b g) :
    Additive.toMul (d σ σ) * Additive.toMul (d 1 1)
      = Work.AbsoluteKummer.algEquivUnitsMap k σ (Additive.toMul (b σ))
          * Additive.toMul (b σ) := by
  have hσ : σ * σ = 1 := by simpa [pow_two] using hσ2
  have h1 : d σ σ = σ • b σ - b 1 + b σ := by
    have h := hb σ (Subgroup.mem_zpowers σ) σ (Subgroup.mem_zpowers σ)
    rwa [hσ] at h
  have h2 : d 1 1 = b 1 := by
    have h := hb (1 : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) (Subgroup.one_mem _)
      (1 : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) (Subgroup.one_mem _)
    simpa using h
  rw [h1, h2]
  show Additive.toMul (σ • b σ) * (Additive.toMul (b 1))⁻¹ * Additive.toMul (b σ)
      * Additive.toMul (b 1)
      = Work.AbsoluteKummer.algEquivUnitsMap k σ (Additive.toMul (b σ)) * Additive.toMul (b σ)
  rw [Work.AbsoluteKummer.addUnits_smul_toMul]
  simp [mul_comm, mul_left_comm]

/-- **`φ` intertwines the Galois action on `k̄ˣ` with complex conjugation.**  This is the unit-level
form of the hypothesis `φ (σ x) = conj (φ x)`. -/
theorem algEquivUnitsMap_ringEquivComplex
    {k : Type} [Field k] (φ : AlgebraicClosure k →+* ℂ)
    (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
    (hφσ : ∀ x : AlgebraicClosure k, φ (σ x) = starRingEnd ℂ (φ x))
    (U : (AlgebraicClosure k)ˣ) :
    Units.map φ.toMonoidHom (Work.AbsoluteKummer.algEquivUnitsMap k σ U)
      = Units.map (starRingEnd ℂ).toMonoidHom (Units.map φ.toMonoidHom U) := by
  apply Units.ext
  simp only [Units.coe_map, Work.AbsoluteKummer.algEquivUnitsMap_coe]
  exact hφσ (U : AlgebraicClosure k)

theorem exists_norm_witness_infinitePlace
    {k : Type} [Field k] [NumberField k]
    (d : (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) →
      (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) → Additive (AlgebraicClosure k)ˣ)
    (L : FiniteGaloisIntermediateField k (AlgebraicClosure k))
    (hfac : ∀ g h u v : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k,
      u ∈ (L : IntermediateField k (AlgebraicClosure k)).fixingSubgroup →
      v ∈ (L : IntermediateField k (AlgebraicClosure k)).fixingSubgroup →
      d (g * u) (h * v) = d g h)
    (hvals : ∀ g h : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k,
      ∃ x : (Work.SSGRoute.sha2_hasse.Lf L)ˣ,
        Work.SSGRoute.sha2_hasse.inclUnits L (Additive.ofMul x) = d g h)
    (hinv : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ ^ 2 = 1 →
      ∃ b : (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) → Additive (AlgebraicClosure k)ˣ,
        SSGRoute.IsLocConstOn (Subgroup.zpowers σ) b ∧
        ∀ g ∈ Subgroup.zpowers σ, ∀ h ∈ Subgroup.zpowers σ,
          d g h = g • b h - b (g * h) + b g)
    (v : NumberField.InfinitePlace (Work.SSGRoute.sha2_hasse.Lf L))
    (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) (hσ2 : σ ^ 2 = 1)
    (φ : AlgebraicClosure k →+* ℂ)
    (hφL : ∀ x : Work.SSGRoute.sha2_hasse.Lf L,
      φ (algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k) x) =
        NumberField.InfinitePlace.embedding v x)
    (hφσ : ∀ x : AlgebraicClosure k, φ (σ x) = starRingEnd ℂ (φ x))
    (s : MulAction.stabilizer (Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
      (NK.GlobalCFT.Place.ofInfinite v))
    (hs : Work.SSGRoute.sha2_hasse.levelRes L σ =
      (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L))
    (hconjs : ∀ x : Work.SSGRoute.sha2_hasse.Lf L,
      NumberField.InfinitePlace.embedding v
          ((s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L) x) =
        starRingEnd ℂ (NumberField.InfinitePlace.embedding v x))
    (hvC : v.IsComplex) :
    ∃ z : (NK.GlobalCFT.Place.localField (Work.SSGRoute.sha2_hasse.Lf L)
        (NK.GlobalCFT.Place.ofInfinite v))ˣ,
      NK.HassePrinciple.localUnitsEquiv (NK.GlobalCFT.Place.ofInfinite v) s z * z
        = NK.HassePrinciple.unitsToLocalUnitsHom (NK.GlobalCFT.Place.ofInfinite v)
            (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals
              (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
              (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)))
          * NK.HassePrinciple.unitsToLocalUnitsHom (NK.GlobalCFT.Place.ofInfinite v)
            (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals 1 1)) := by
  obtain ⟨b, _hbloc, hb⟩ := hinv σ hσ2
  -- the two values of the descended cocycle, identified with `d σ σ` and `d 1 1`
  have hss : Work.SSGRoute.sha2_hasse.inclUnits L
      (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals
        (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
        (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)) = d σ σ :=
    Work.SSGRoute.sha2_hasse.levelCocycle_value L d hvals hfac
      (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
      (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L) σ σ hs hs
  have h11 : Work.SSGRoute.sha2_hasse.inclUnits L
      (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals 1 1) = d 1 1 := by
    have h := Work.SSGRoute.sha2_hasse.levelCocycle_value L d hvals hfac
      (1 : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
      (1 : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
      (1 : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
      (1 : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
      (map_one (Work.SSGRoute.sha2_hasse.levelRes L))
      (map_one (Work.SSGRoute.sha2_hasse.levelRes L))
    simpa using h
  have hss' : Units.map
        (algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k)).toMonoidHom
      (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals
        (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
        (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)))
      = Additive.toMul (d σ σ) := by
    rw [← Work.SSGRoute.sha2_hasse.inclUnits_toMul L, hss]
  have h11' : Units.map
        (algebraMap (Work.SSGRoute.sha2_hasse.Lf L) (AlgebraicClosure k)).toMonoidHom
      (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals 1 1))
      = Additive.toMul (d 1 1) := by
    rw [← Work.SSGRoute.sha2_hasse.inclUnits_toMul L, h11]
  -- the inverse image of `u = φ (b σ)` under `e : L_v ≃+* ℂ`
  let e : v.Completion ≃+* ℂ :=
    NumberField.InfinitePlace.Completion.ringEquivComplexOfIsComplex hvC
  let u : ℂˣ := Units.map φ.toMonoidHom (Additive.toMul (b σ))
  let z : (NK.GlobalCFT.Place.localField (Work.SSGRoute.sha2_hasse.Lf L)
      (NK.GlobalCFT.Place.ofInfinite v))ˣ := Units.map e.symm.toMonoidHom u
  refine ⟨z, ?_⟩
  have hmapinj : Function.Injective (Units.map e.toMonoidHom) :=
    Units.map_injective (f := e.toMonoidHom) e.injective
  refine hmapinj ?_
  have hz : Units.map e.toMonoidHom z = u := by
    apply Units.ext
    simp [z, e]
  have hlocal : Units.map e.toMonoidHom
        (NK.HassePrinciple.localUnitsEquiv (NK.GlobalCFT.Place.ofInfinite v) s z)
      = Units.map (starRingEnd ℂ).toMonoidHom (Units.map e.toMonoidHom z) := by
    apply Units.ext
    simp only [Units.coe_map]
    rw [NK.HassePrinciple.coe_localUnitsEquiv]
    exact localAutHom_ringEquivComplex (K := k) (L := Work.SSGRoute.sha2_hasse.Lf L)
      v hvC s hconjs (z : v.Completion)
  simp only [map_mul]
  rw [hlocal, hz]
  rw [unitsToLocalUnits_ringEquivComplex L v hvC φ hφL
        (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals
          (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L)
          (s : Work.SSGRoute.sha2_hasse.Lf L ≃ₐ[k] Work.SSGRoute.sha2_hasse.Lf L))),
      unitsToLocalUnits_ringEquivComplex L v hvC φ hφL
        (Additive.toMul (Work.SSGRoute.sha2_hasse.levelCocycle L d hvals 1 1)), hss', h11']
  rw [← map_mul, involution_coboundary_toMul d b σ hσ2 hb, map_mul]
  rw [algEquivUnitsMap_ringEquivComplex φ σ hφσ (Additive.toMul (b σ))]

end Work.sha2_hasse
