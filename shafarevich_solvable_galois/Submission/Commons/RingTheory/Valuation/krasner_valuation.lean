/-!
# Krasner's lemma for a henselian valuation

Let `F` be a field carrying a henselian valuation subring `V`, let `L` be algebraically closed
and algebraic over `F`, and let `W` be the (necessarily unique) extension of `V` to `L`.  If
`α ∈ L` is separable over `F` and `β ∈ L` is closer to `α` than every other `F`-conjugate of
`α` (with respect to `W`), then `α` lies in the subfield generated by `F` and `β`.

The key input is that, `V` being henselian, its extension `W` to the algebraic extension `L`
is unique (`eq_of_comap_eq_of_isAlgebraic`).  Consequently `W` is invariant under every
`K`-automorphism of `L` for any intermediate field `F ⊆ K ⊆ L`; combining this invariance with
the ultrametric inequality yields the result.
-/

open IntermediateField
open Commons.RingTheory.Valuation

namespace Commons.RingTheory.Valuation

/-- `W` is invariant under every `K`-automorphism of `L`, where `W` extends a henselian
valuation `V` of `F ⊆ K ⊆ L` and `L / F` is algebraic.

The proof uses the uniqueness of the extension of a henselian valuation to an algebraic
extension (`eq_of_comap_eq_of_isAlgebraic`): for `σ ∈ Gal(L/K)`, the valuation subring
`W.comap σ` pulls back to `V` along `F → L`, hence equals `W`; the equality of valuations
`W.valuation (σ x) = W.valuation x` then follows from
`comap_eq_self_iff_val_eq_of_isAlgebraic`. -/
lemma krasner_valuation_algEquiv_invariant {F L : Type*} [Field F] [Field L] [Algebra F L]
    [Algebra.IsAlgebraic F L] {V : ValuationSubring F} [HenselianLocalRing V]
    {W : ValuationSubring L} (hW : W.comap (algebraMap F L) = V) (K' : IntermediateField F L)
    (σ : L ≃ₐ[↥K'] L) : ∀ x : L, W.valuation (σ x) = W.valuation x := by
  have hcomap : W.comap (σ : L →+* L) = W := by
    have hcomp : (σ : L →+* L).comp (algebraMap F L) = algebraMap F L := by
      ext x
      simp only [RingHom.comp_apply]
      rw [IsScalarTower.algebraMap_apply F ↥K' L]
      exact AlgEquiv.commutes σ (algebraMap F ↥K' x)
    have h1 : W = W.comap (σ : L →+* L) :=
      eq_of_comap_eq_of_isAlgebraic V W (W.comap (σ : L →+* L)) hW
        (by rw [ValuationSubring.comap_comap, hcomp, hW])
    exact h1.symm
  exact (comap_eq_self_iff_val_eq_of_isAlgebraic
    (inferInstance : Algebra.IsAlgebraic ↥K' L) W σ).mp hcomap

theorem krasner_valuation {F L : Type*} [Field F] [Field L] [Algebra F L] [IsAlgClosed L] [Algebra.IsAlgebraic F L] (V : ValuationSubring F) [HenselianLocalRing V] (W : ValuationSubring L) (hW : W.comap (algebraMap F L) = V) {α β : L} (hsep : IsSeparable F α) (hβ : IsIntegral F β) (hclose : ∀ α' : L, IsConjRoot F α α' → α ≠ α' → W.valuation (α - β) < W.valuation (α - α')) : α ∈ IntermediateField.adjoin F ({β} : Set L) := by
  by_contra hmem
  set K' := IntermediateField.adjoin F ({β} : Set L) with hK'
  have hβmem : β ∈ K' := IntermediateField.subset_adjoin F ({β} : Set L) (by simp)
  haveI : Normal F L := by
    rw [normal_iff]
    intro x
    exact ⟨Algebra.IsIntegral.isIntegral x,
      IsAlgClosed.splits ((minpoly F x).map (algebraMap F L))⟩
  have hαnotmem : α ∉ (⊥ : Subalgebra ↥K' L) := by
    intro h
    rw [Algebra.mem_bot] at h
    obtain ⟨r, hr⟩ := h
    exact hmem (hr ▸ r.2)
  have hsep' : IsSeparable ↥K' α := IsSeparable.tower_top K' hsep
  have hsplit : ((minpoly ↥K' α).map (algebraMap ↥K' L)).Splits := IsAlgClosed.splits _
  obtain ⟨α₂, hne₂, hconj₂⟩ := (notMem_iff_exists_ne_and_isConjRoot hsep' hsplit).mp hαnotmem
  obtain ⟨σ, hσ⟩ := isConjRoot_iff_exists_algEquiv.mp hconj₂.symm
  have hconjF : IsConjRoot F α α₂ := hconj₂.of_isScalarTower hsep.isIntegral
  have hσβ : σ β = β := by
    have hcomm := AlgEquiv.commutes σ (⟨β, hβmem⟩ : ↥K')
    simpa using hcomm
  have hinv := krasner_valuation_algEquiv_invariant hW K' σ
  have hvalβ : W.valuation (α₂ - β) = W.valuation (α - β) := by
    have heq : α₂ - β = σ (α - β) := by
      rw [← hσ, map_sub, hσβ]
    rw [heq, hinv]
  have hclose' := hclose α₂ hconjF hne₂
  have hultra : W.valuation (α - α₂) ≤ W.valuation (α - β) := by
    have h1 : α - α₂ = (α - β) + (β - α₂) := by ring
    rw [h1]
    refine le_trans (W.valuation.map_add _ _) (max_le le_rfl ?_)
    rw [W.valuation.map_sub_swap β α₂, hvalβ]
  exact absurd hclose' (not_lt_of_ge hultra)

end Commons.RingTheory.Valuation
