open ValuationSubring

namespace Commons.RingTheory.Valuation

/-- If a subring `S` of `F` contains two valuation subrings `A`, `B` with `A ⊔ B = ⊤`, then `S = ⊤`.
(Indeed the underlying subring of `A ⊔ B` is the subring generated by `A ∪ B`.) -/
lemma subring_eq_top_of_sup_eq_top {F : Type*} [Field F] {A B : ValuationSubring F} (hAB : A ⊔ B = ⊤)
    (S : Subring F) (hA : ∀ x ∈ A, x ∈ S) (hB : ∀ x ∈ B, x ∈ S) : S = ⊤ := by
  have h : A.toSubring ⊔ B.toSubring = ⊤ := by
    have h1 := congrArg ValuationSubring.toSubring hAB
    rw [show (A ⊔ B).toSubring = A.toSubring ⊔ B.toSubring from rfl,
      ValuationSubring.toSubring_top] at h1
    exact h1
  have hle : A.toSubring ⊔ B.toSubring ≤ S := by
    apply sup_le
    · intro x hx; exact hA x hx
    · intro x hx; exact hB x hx
  rw [h] at hle
  exact le_top.antisymm hle

/-- **Cofinality of the `B`-values of a valuation subring `A` with `A ⊔ B = ⊤`.**
Let `A`, `B` be valuation subrings of a field `F` with `A ⊔ B = ⊤` and `B ≠ ⊤`.  Then the set of
`B`-values of the nonzero elements of `A` is unbounded above in the value group of `B`: for every
`γ > 0` there is a nonzero `x ∈ A` with `γ < B.valuation x`.

This is the cofinality ingredient behind the approximation theorem for two independent valuations.
The proof is elementary.  Suppose every `x ∈ A` has `B.valuation x ≤ γ`.  Then `γ ≥ 1` and the
"sublevel" set `{x | ∃ n, B.valuation x ≤ γ ^ n}` is a subring containing `A ∪ B`, hence equals
`F`; consequently the powers of `γ` are cofinal in the value group of `B`.  On the other hand the
set `V = {η | η has bounded powers}` is a submonoid of the value group, and
`C = {x | ∃ η ∈ V, B.valuation x ≤ η}` is again a subring containing `A ∪ B`, hence equals `F`;
so `γ ≤ η` for some `η ∈ V` with `η ^ n ≤ M`, giving `γ ^ n ≤ M` for all `n`, contradicting the
cofinality of the powers of `γ`. -/
theorem exists_mem_valuation_gt_of_sup_eq_top {F : Type*} [Field F] (A B : ValuationSubring F)
    (hAB : A ⊔ B = ⊤) (hB : B ≠ ⊤) (γ : B.ValueGroup) (hγ : 0 < γ) :
    ∃ x : F, x ∈ A ∧ x ≠ 0 ∧ γ < B.valuation x := by
  by_contra hcon
  have hbound : ∀ x ∈ A, B.valuation x ≤ γ := by
    intro x hx
    rcases eq_or_ne x 0 with hx0 | hx0
    · rw [hx0, Valuation.map_zero]; exact hγ.le
    · by_contra hle
      exact hcon ⟨x, hx, hx0, lt_of_not_ge hle⟩
  have hγ1 : 1 ≤ γ := by
    have := hbound 1 A.one_mem
    rwa [Valuation.map_one] at this
  -- the subring `{x | ∃ n, B.val x ≤ γ^n}`
  let Cβ : Subring F :=
    { carrier := {x | ∃ n : ℕ, B.valuation x ≤ γ ^ n}
      zero_mem' := ⟨0, by rw [Valuation.map_zero, pow_zero]; exact zero_le_one⟩
      one_mem' := ⟨0, by rw [Valuation.map_one, pow_zero]⟩
      add_mem' := by
        rintro x y ⟨n, hn⟩ ⟨m, hm⟩
        exact ⟨n + m, le_trans (Valuation.map_add _ _ _) (le_trans (max_le_max hn hm)
          (max_le (pow_le_pow_right₀ hγ1 (Nat.le_add_right n m))
                  (pow_le_pow_right₀ hγ1 (Nat.le_add_left m n))))⟩
      mul_mem' := by
        rintro x y ⟨n, hn⟩ ⟨m, hm⟩
        exact ⟨n + m, by rw [Valuation.map_mul, pow_add]; exact mul_le_mul' hn hm⟩
      neg_mem' := by
        rintro x ⟨n, hn⟩
        exact ⟨n, by rwa [Valuation.map_neg]⟩ }
  have hCβ : Cβ = ⊤ := subring_eq_top_of_sup_eq_top hAB Cβ
    (fun x hx => show ∃ n : ℕ, B.valuation x ≤ γ ^ n from ⟨1, by rw [pow_one]; exact hbound x hx⟩)
    (fun x hx => show ∃ n : ℕ, B.valuation x ≤ γ ^ n from
      ⟨0, by rw [pow_zero]; exact (B.valuation_le_one_iff x).mpr hx⟩)
  -- the powers of `γ` are cofinal
  have star : ∀ δ : B.ValueGroup, δ ≠ 0 → ∃ n : ℕ, δ ≤ γ ^ n := by
    intro δ _
    obtain ⟨y, hy⟩ := B.valuation_surjective δ
    have hyC : y ∈ Cβ := by rw [hCβ]; trivial
    have hyC' : ∃ n : ℕ, B.valuation y ≤ γ ^ n := hyC
    obtain ⟨n, hn⟩ := hyC'
    exact ⟨n, by rwa [hy] at hn⟩
  -- the submonoid of elements with bounded powers
  let V : Set B.ValueGroup := {η | ∃ M : B.ValueGroup, M ≠ 0 ∧ ∀ n : ℕ, η ^ n ≤ M}
  have oneV : (1 : B.ValueGroup) ∈ V := ⟨1, one_ne_zero, fun n => by rw [one_pow]⟩
  have mulV : ∀ {η η' : B.ValueGroup}, η ∈ V → η' ∈ V → η * η' ∈ V := by
    rintro η η' ⟨M, hM, hMle⟩ ⟨M', hM', hM'le⟩
    exact ⟨M * M', mul_ne_zero hM hM', fun n => by
      rw [mul_pow]; exact mul_le_mul' (hMle n) (hM'le n)⟩
  have maxV : ∀ {η η' : B.ValueGroup}, η ∈ V → η' ∈ V → max η η' ∈ V := by
    rintro η η' ⟨M, hM, hMle⟩ ⟨M', hM', hM'le⟩
    refine ⟨max M M', ?_, fun n => ?_⟩
    · exact ne_of_gt (lt_of_lt_of_le (pos_iff_ne_zero.mpr hM) (le_max_left _ _))
    · rcases le_total η η' with h | h
      · rw [max_eq_right h]; exact le_trans (hM'le n) (le_max_right _ _)
      · rw [max_eq_left h]; exact le_trans (hMle n) (le_max_left _ _)
  let CV : Subring F :=
    { carrier := {x | ∃ η : B.ValueGroup, η ∈ V ∧ B.valuation x ≤ η}
      zero_mem' := ⟨1, oneV, by rw [Valuation.map_zero]; exact zero_le_one⟩
      one_mem' := ⟨1, oneV, by rw [Valuation.map_one]⟩
      add_mem' := by
        rintro x y ⟨η, hη, hx⟩ ⟨η', hη', hy⟩
        exact ⟨max η η', maxV hη hη', le_trans (Valuation.map_add _ _ _) (max_le_max hx hy)⟩
      mul_mem' := by
        rintro x y ⟨η, hη, hx⟩ ⟨η', hη', hy⟩
        exact ⟨η * η', mulV hη hη', by rw [Valuation.map_mul]; exact mul_le_mul' hx hy⟩
      neg_mem' := by
        rintro x ⟨η, hη, hx⟩
        exact ⟨η, hη, by rwa [Valuation.map_neg]⟩ }
  have hCV : CV = ⊤ := subring_eq_top_of_sup_eq_top hAB CV
    (fun x hx => show ∃ η : B.ValueGroup, η ∈ V ∧ B.valuation x ≤ η from
      ⟨B.valuation x, ⟨γ, ne_of_gt hγ, fun n => by
        rw [← Valuation.map_pow]; exact hbound (x ^ n) (pow_mem hx n)⟩, le_refl _⟩)
    (fun x hx => show ∃ η : B.ValueGroup, η ∈ V ∧ B.valuation x ≤ η from
      ⟨1, oneV, (B.valuation_le_one_iff x).mpr hx⟩)
  -- `γ` is itself dominated by an element of `V`
  obtain ⟨m, hm⟩ := B.valuation_surjective γ
  have hmC : m ∈ CV := by rw [hCV]; trivial
  have hmC' : ∃ η : B.ValueGroup, η ∈ V ∧ B.valuation m ≤ η := hmC
  obtain ⟨η, hηV, hηle⟩ := hmC'
  obtain ⟨M, hM, hMle⟩ := hηV
  have hγη : γ ≤ η := by rwa [hm] at hηle
  have hbound2 : ∀ n : ℕ, γ ^ n ≤ M := fun n =>
    le_trans (pow_le_pow_left₀ hγ.le hγη n) (hMle n)
  -- pick an element of the value group strictly above `1`
  have hBnt : B.valuation.IsNontrivial := by
    by_contra h; exact hB ((ValuationSubring.eq_top_iff B).mpr h)
  rw [Valuation.IsNontrivial_iff_exists_one_lt] at hBnt
  obtain ⟨z, hz⟩ := hBnt
  obtain ⟨n, hn⟩ := star (M * B.valuation z)
    (mul_ne_zero hM (ne_of_gt (lt_trans zero_lt_one hz)))
  have hfinal : B.valuation z ≤ 1 := by
    have h1 : M * B.valuation z ≤ M * 1 := by
      rw [mul_one]; exact le_trans hn (hbound2 n)
    exact le_of_mul_le_mul_left h1 (pos_iff_ne_zero.mpr hM)
  exact absurd hfinal (not_le.mpr hz)

theorem exists_val_lt_gt_of_independent {F : Type*} [Field F] (A B : ValuationSubring F)
    (hAB : A ⊔ B = ⊤) (hA : A ≠ ⊤) (hB : B ≠ ⊤)
    (α : A.ValueGroup) (β : B.ValueGroup) (hα : 0 < α) (hβ : 0 < β) :
    ∃ ρ : F, A.valuation ρ < α ∧ β < B.valuation ρ := by
  classical
  -- `A ≠ ⊤` gives a non-zero element `a` of the maximal ideal `m_A`.
  have hnt : A.valuation.IsNontrivial := by
    by_contra h
    exact hA ((ValuationSubring.eq_top_iff A).mpr h)
  rw [Valuation.IsNontrivial_iff_exists_one_lt] at hnt
  obtain ⟨x₀, hx₀⟩ := hnt
  have hx₀ne : x₀ ≠ 0 := by
    intro h; rw [h, Valuation.map_zero] at hx₀; exact absurd hx₀ (not_lt.mpr zero_le)
  set a : F := x₀⁻¹ with ha
  have hane : a ≠ 0 := inv_ne_zero hx₀ne
  have haval : A.valuation a < 1 := by
    rw [ha, Valuation.map_inv]; exact inv_lt_one_of_one_lt₀ hx₀
  -- a representative `α₀` of `α`.
  obtain ⟨α₀, hα₀⟩ := A.valuation_surjective α
  have hα₀ne : α₀ ≠ 0 := by
    intro h; rw [h, Valuation.map_zero] at hα₀; exact (ne_of_gt hα) hα₀.symm
  set x : F := α₀ * a with hx
  have hxne : x ≠ 0 := mul_ne_zero hα₀ne hane
  have hAx : A.valuation x < α := by
    rw [hx, Valuation.map_mul, hα₀]
    calc α * A.valuation a < α * 1 := mul_lt_mul_of_pos_left haval hα
      _ = α := mul_one α
  have hδne : B.valuation x ≠ 0 := fun h => hxne ((Valuation.zero_iff B.valuation).mp h)
  have hδpos : 0 < B.valuation x := lt_of_le_of_ne' zero_le hδne
  -- the cofinality fact, applied to the target `β / B.valuation x`.
  obtain ⟨y, hyA, -, hyval⟩ :=
    exists_mem_valuation_gt_of_sup_eq_top A B hAB hB (β / B.valuation x)
      (div_pos hβ hδpos)
  refine ⟨x * y, ?_, ?_⟩
  · rw [Valuation.map_mul]
    have hy1 : A.valuation y ≤ 1 := (A.valuation_le_one_iff y).mpr hyA
    calc A.valuation x * A.valuation y ≤ A.valuation x * 1 :=
          mul_le_mul_of_nonneg_left hy1 zero_le
      _ = A.valuation x := mul_one _
      _ < α := hAx
  · rw [Valuation.map_mul]
    have hlt : B.valuation x * (β / B.valuation x) < B.valuation x * B.valuation y :=
      mul_lt_mul_of_pos_left hyval hδpos
    rwa [mul_div_cancel₀ β hδne] at hlt

end Commons.RingTheory.Valuation