namespace Commons.RingTheory.Henselian

/-- In the discrete value group `ℤᵐ⁰`, every element strictly below `1` is bounded above
by `WithZero.exp (-1)`. -/
lemma lt_one_le_exp_neg_one {y : Zstar0} (hy : y < (1 : Zstar0)) :
    y ≤ WithZero.exp (-1 : ℤ) := by
  by_cases hy0 : y = 0
  · simp [hy0]
  · rw [← WithZero.exp_log hy0]
    apply WithZero.exp_le_exp.2
    have hlog : WithZero.log y < 0 := by
      rw [← WithZero.exp_log hy0] at hy
      rw [← WithZero.exp_zero] at hy
      exact WithZero.exp_lt_exp.mp hy
    omega

/-- The value of the (Henselian) uniformizer of the ring of integers of the `v`-adic completion
of a number field is `WithZero.exp (-1)`. -/
theorem uniformizer_valuation_eq_exp_neg_one {K : Type*} [Field K] [NumberField K]
    (V : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    Valued.v ((Commons.RingTheory.Henselian.uniformizer (R := NumberField.RingOfIntegers K)
        (K := K) V : V.adicCompletionIntegers K) : V.adicCompletion K) =
      WithZero.exp (-1 : ℤ) := by
  classical
  let R := NumberField.RingOfIntegers K
  let A := V.adicCompletionIntegers K
  let L := V.adicCompletion K
  let φ : R →+* A := algebraMap R A
  let ϖ : A := uniformizer (R := R) (K := K) V
  -- a uniformiser `π : R` of the global prime, with `V.intValuation π = exp (-1)`
  obtain ⟨π, hπ⟩ := V.intValuation_exists_uniformizer
  have hπ_mem : π ∈ V.asIdeal := by
    rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem V π]
    rw [hπ]
    rw [← WithZero.exp_zero]
    exact WithZero.exp_lt_exp.mpr (by norm_num)
  -- the image of `π` in the completion has value `exp (-1)`
  have hvalπ : Valued.v ((algebraMap R A π : A) : L) = WithZero.exp (-1 : ℤ) := by
    have hval0 : Valued.v ((algebraMap R A π : A) : L) = Valued.v (algebraMap R L π) := by rfl
    rw [hval0]
    have hval2 : Valued.v (algebraMap R L π) =
        IsDedekindDomain.HeightOneSpectrum.valuation K V (algebraMap R K π) := by
      exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation
        (R := R) (K := K) V π)
    rw [hval2]
    have hv : IsDedekindDomain.HeightOneSpectrum.valuation K V (algebraMap R K π) = V.intValuation π := by
      exact IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (R := R) (K := K) V π
    rw [hv, hπ]
  -- the image of `π` lies in the maximal ideal of `A`
  have hφπ_mem : algebraMap R A π ∈ IsLocalRing.maximalIdeal A := by
    have hm : IsLocalRing.maximalIdeal A = V.asIdeal.map φ := by
      simpa [A, φ] using
        (Commons.NumberTheory.NumberField.adicCompletionIntegers_maximalIdeal_eq_map (K := K) V)
    rw [hm]
    exact Ideal.mem_map_of_mem φ hπ_mem
  -- the maximal ideal is generated by `ϖ`
  have hm_span : IsLocalRing.maximalIdeal A = Ideal.span {ϖ} := by
    simpa [A, ϖ] using (maximalIdeal_eq_span_uniformizer (R := R) (K := K) V)
  -- so `ϖ ∣ algebraMap R A π`, hence `Valued.v (φ π) ≤ Valued.v ϖ`
  have hdvd : ϖ ∣ algebraMap R A π := by
    rw [hm_span, Ideal.mem_span_singleton] at hφπ_mem
    exact hφπ_mem
  have hvalφπ_le : Valued.v ((algebraMap R A π : A) : L) ≤ Valued.v (ϖ : L) := by
    have hdvd' : ϖ ∣ (algebraMap R A π) := hdvd
    have hle := (Valuation.Integers.dvd_iff_le
      (IsDedekindDomain.HeightOneSpectrum.adicCompletionIntegers.integers K V)
      (x := ϖ) (y := algebraMap R A π)).mp hdvd'
    simpa using hle
  -- `Valued.v ϖ < 1`, hence `Valued.v ϖ ≤ exp (-1)` by discreteness
  have hvalϖ_le : Valued.v (ϖ : L) ≤ WithZero.exp (-1 : ℤ) := by
    have hlt : Valued.v (ϖ : L) < (1 : Zstar0) := by
      simpa [ϖ] using (uniformizer_val_lt_one (R := R) (K := K) V)
    exact lt_one_le_exp_neg_one hlt
  -- conclusion
  apply le_antisymm
  · simpa [ϖ] using hvalϖ_le
  · rw [← hvalπ]
    simpa [ϖ] using hvalφπ_le

end Commons.RingTheory.Henselian
