open Commons.NumberTheory.NumberField

private lemma lt_one_le_exp_neg_one {y : Zstar0} (hy : y < (1 : Zstar0)) :
    y ≤ WithZero.exp (-1 : ℤ) := by
  by_cases hy0 : y = 0
  · simp [hy0]
  · rw [← WithZero.exp_log hy0]
    apply WithZero.exp_le_exp.2
    have hlog : WithZero.log y < 0 := by
      rw [← WithZero.exp_log hy0] at hy
      rw [← WithZero.exp_zero] at hy
      exact WithZero.exp_lt_exp.mp hy
    omega

/-- The maximal ideal of the ring of integers of the `v`-adic completion of a number field `K`
is generated by the image of the prime ideal `v`:

`maximalIdeal (V.adicCompletionIntegers K) = V.asIdeal.map (algebraMap (𝓞 K) (V.adicCompletionIntegers K))`.

Indeed, both ideals equal the principal ideal generated by the image of any uniformiser
`π ∈ V.asIdeal`: the maximal ideal of the completion ring of integers consists of the elements of
valuation `< 1`, and by discreteness of the value group `ℤᵐ⁰` every such element has valuation
`≤ exp (-1) = Valued.v π`, hence is a multiple of `π` in the ring of integers. -/
theorem adicCompletionIntegers_maximalIdeal_eq_map {K : Type*} [Field K] [NumberField K]
    (V : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    IsLocalRing.maximalIdeal (V.adicCompletionIntegers K) =
      V.asIdeal.map (algebraMap (NumberField.RingOfIntegers K) (V.adicCompletionIntegers K)) := by
  classical
  let R := 𝓞 K
  let A := V.adicCompletionIntegers K
  let L := V.adicCompletion K
  let φ : R →+* A := algebraMap R A
  apply le_antisymm
  · -- maximal ideal ⊆ extension of `V.asIdeal`
    intro x hx
    -- choose a uniformiser `π ∈ R` with `intValuation π = exp (-1)`
    obtain ⟨π, hπ⟩ := V.intValuation_exists_uniformizer
    have hπ_mem : π ∈ V.asIdeal := by
      rw [← IsDedekindDomain.HeightOneSpectrum.intValuation_lt_one_iff_mem V π]
      rw [hπ]
      rw [← WithZero.exp_zero]
      exact WithZero.exp_lt_exp.mpr (by norm_num)
    -- its value in the completion is `exp (-1)`
    have hvalπ : Valued.v ((algebraMap R A π : A) : L) = WithZero.exp (-1 : ℤ) := by
      have hval0 : Valued.v ((algebraMap R A π : A) : L) = Valued.v (algebraMap R L π) := by rfl
      rw [hval0]
      have hval2 : Valued.v (algebraMap R L π) =
          IsDedekindDomain.HeightOneSpectrum.valuation K V (algebraMap R K π) := by
        exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation (R := R) (K := K) V π)
      rw [hval2]
      have hv : IsDedekindDomain.HeightOneSpectrum.valuation K V (algebraMap R K π) = V.intValuation π := by
        exact IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap (R := R) (K := K) V π
      rw [hv, hπ]
    -- elements of the maximal ideal have valuation `< 1`, hence `≤ exp (-1) = value of π`
    have hxlt : Valued.v ((x : A) : L) < (1 : Zstar0) := by
      exact (adicCompletionIntegers_mem_maximalIdeal_iff_valued_lt_one V x).mp hx
    have hxle : Valued.v ((x : A) : L) ≤ Valued.v ((algebraMap R A π : A) : L) := by
      rw [hvalπ]
      exact lt_one_le_exp_neg_one hxlt
    -- write `x = π * (x / π)` with `x / π` integral
    let p : L := ((algebraMap R A π : A) : L)
    have hp_ne : p ≠ 0 := (Valuation.ne_zero_iff (Valued.v)).mp (by
        rw [hvalπ]
        simp)
    have hp_pos : 0 < Valued.v p := by
      rw [pos_iff_ne_zero]
      rw [hvalπ]
      simp
    have hq_le : Valued.v (((x : A) : L) / p) ≤ (1 : Zstar0) := by
      rw [map_div₀]
      rw [div_le_iff₀ hp_pos]
      simpa [p] using hxle
    have hq_mem : ((x : A) : L) / p ∈ A := by
      exact (IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers R K V).mpr hq_le
    let u : A := ⟨((x : A) : L) / p, hq_mem⟩
    have hu_eq : ((u : A) : L) = ((x : A) : L) / p := rfl
    have hx_eq : x = u * (algebraMap R A π) := by
      apply Subtype.ext
      have hcar : (((u * (algebraMap R A π)) : A) : L) =
          ((x : A) : L) / p * ((algebraMap R A π : A) : L) := by simp [hu_eq, p]
      rw [hcar]
      rw [div_mul_cancel₀]
      exact hp_ne
    -- `π` lies in the extension of `V.asIdeal`, so `x ∈ span {φ π} ⊆ V.asIdeal.map φ`
    have hφπ_mem : (algebraMap R A π) ∈ V.asIdeal.map φ := by
      exact Ideal.mem_map_of_mem φ hπ_mem
    have hspan_le : Ideal.span {algebraMap R A π} ≤ V.asIdeal.map φ := by
      exact (Ideal.span_singleton_le_iff_mem (V.asIdeal.map φ)).mpr hφπ_mem
    have hx_span : x ∈ Ideal.span {algebraMap R A π} := by
      rw [Ideal.mem_span_singleton']
      exact ⟨u, hx_eq.symm⟩
    exact hspan_le hx_span
  · -- extension of `V.asIdeal` ⊆ maximal ideal
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    rw [Ideal.mem_comap]
    rw [adicCompletionIntegers_mem_maximalIdeal_iff_valued_lt_one V]
    have hval : Valued.v ((algebraMap R A r : A) : L) = Valued.v (algebraMap R L r) := by rfl
    rw [hval]
    have hval2 : Valued.v (algebraMap R L r) =
        IsDedekindDomain.HeightOneSpectrum.valuation K V (algebraMap R K r) := by
      exact (IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation (R := R) (K := K) V r)
    rw [hval2]
    exact (IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (R := R) (K := K) V r).mpr hr

end

end Commons.NumberTheory.NumberField