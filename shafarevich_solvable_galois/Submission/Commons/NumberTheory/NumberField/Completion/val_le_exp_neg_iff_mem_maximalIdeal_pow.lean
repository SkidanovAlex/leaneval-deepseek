open scoped NumberField WithZero

namespace Commons.NumberTheory.NumberField.Completion

noncomputable section

/-- **Key computation.**  Let `F` be a field with a valuation `v` with values in the discrete
value group `ℤᵐ⁰ = WithZero (Multiplicative ℤ)`, and let `π` be a uniformiser of the valuation
ring `v.valuationSubring`, i.e. an element with `v π = exp (-1)` (equivalently, a generator of the
maximal ideal).  Then, for `x` in the valuation ring and `n : ℕ`,

`v x ≤ exp (-n)  ↔  x ∈ 𝔪 ^ n`,

where `𝔪` is the maximal ideal of the valuation ring.

Indeed `𝔪 ^ n` is generated by `π ^ n` (whose valuation is `exp (-n) = (exp (-1)) ^ n`), so the
statement reduces to: `x` is divisible by `π ^ n` iff `v x ≤ v (π ^ n)`. -/
theorem mem_maximalIdeal_pow_iff_le_exp_neg {F : Type*} [Field F] (v : Valuation F Zstar0)
    {π : v.valuationSubring} (hπ : v (π : F) = WithZero.exp (-1 : ℤ))
    (x : v.valuationSubring) (n : ℕ) :
    v (x : F) ≤ (WithZero.exp (-(n : ℤ)) : Zstar0) ↔
      x ∈ IsLocalRing.maximalIdeal v.valuationSubring ^ n := by
  have hvalpow : v (↑(π ^ n) : F) = (WithZero.exp (-(n : ℤ)) : Zstar0) := by
    rw [show (↑(π ^ n) : F) = (π : F) ^ n by push_cast; ring, Valuation.map_pow, hπ,
      ← WithZero.exp_nsmul]
    congr 1
    simp
  have hπn_ne : (↑(π ^ n) : F) ≠ 0 := by
    intro h
    rw [h, Valuation.map_zero] at hvalpow
    exact WithZero.exp_ne_zero hvalpow.symm
  have hmax : IsLocalRing.maximalIdeal v.valuationSubring = Ideal.span {π} :=
    maximalIdeal_eq_span_of_valuation_eq_exp_neg_one v hπ
  rw [hmax, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
  constructor
  · intro hx
    have hmem : (x : F) / (↑(π ^ n) : F) ∈ v.valuationSubring := by
      rw [Valuation.mem_valuationSubring_iff, Valuation.map_div, hvalpow]
      exact div_le_one_of_le₀ hx zero_le
    refine ⟨⟨(x : F) / (↑(π ^ n) : F), hmem⟩, ?_⟩
    apply Subtype.ext
    show (x : F) = ↑(π ^ n * ⟨(x : F) / ↑(π ^ n), hmem⟩)
    rw [show (↑(π ^ n * ⟨(x : F) / ↑(π ^ n), hmem⟩) : F)
        = (↑(π ^ n) : F) * ((x : F) / ↑(π ^ n)) by push_cast; ring, mul_div_cancel₀]
    exact hπn_ne
  · rintro ⟨c, rfl⟩
    have : (↑(π ^ n * c) : F) = (↑(π ^ n) : F) * (c : F) := by push_cast; ring
    rw [this, Valuation.map_mul, hvalpow]
    calc (WithZero.exp (-(n : ℤ)) : Zstar0) * v (c : F)
        ≤ (WithZero.exp (-(n : ℤ)) : Zstar0) * 1 := mul_le_mul_of_nonneg_left c.2 zero_le
      _ = _ := mul_one _

/-- For a number field `K`, a nonzero prime ideal `v` of `𝓞 K`, an element `x` of the ring of
integers of the `v`-adic completion of `K` and `n : ℕ`, the valuation of `x` is at most
`exp (-n)` if and only if `x` lies in the `n`-th power of the maximal ideal of the ring of
integers.

This is the `n`-th power refinement of the description of the maximal ideal as the elements of
valuation `< 1` (see `adicCompletionIntegers_mem_maximalIdeal_iff_valued_lt_one`). -/
theorem val_le_exp_neg_iff_mem_maximalIdeal_pow {K : Type*} [Field K] [NumberField K]
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (x : v.adicCompletionIntegers K) (n : ℕ) :
    Valued.v (R := v.adicCompletion K) (Γ₀ := WithZero (Multiplicative ℤ))
        (x : v.adicCompletion K) ≤ (WithZero.exp (-(n : ℤ)) : WithZero (Multiplicative ℤ)) ↔
      x ∈ IsLocalRing.maximalIdeal (v.adicCompletionIntegers K) ^ n := by
  obtain ⟨π, hπval, -⟩ := exists_uniformizer_adicCompletionIntegers v
  exact mem_maximalIdeal_pow_iff_le_exp_neg
    (Valued.v (R := v.adicCompletion K) (Γ₀ := Zstar0)) hπval x n

end

end Commons.NumberTheory.NumberField.Completion
