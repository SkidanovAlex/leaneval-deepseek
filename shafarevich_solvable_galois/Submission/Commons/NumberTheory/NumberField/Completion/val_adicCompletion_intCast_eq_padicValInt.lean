/-- The unique height-one prime of `𝓞 ℚ ≃ ℤ` containing the prime number `p` is the principal
ideal generated by `p`.  This is the basis for computing the `v`-adic valuation of integers. -/
theorem asIdeal_eq_span_prime (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ))
    (p : ℕ) (hp : p.Prime) (hmem : (p : NumberField.RingOfIntegers ℚ) ∈ v.asIdeal) :
    v.asIdeal = Ideal.span {(p : 𝓞 ℚ)} := by
  have hmax : Ideal.IsMaximal (Ideal.span {(p : 𝓞 ℚ)}) := by
    have hp' : ((Rat.ringOfIntegersEquiv : 𝓞 ℚ →+* ℤ) p) = (p : ℤ) := map_natCast _ p
    rw [← Ideal.isMaximal_map_iff_of_bijective (Rat.ringOfIntegersEquiv : 𝓞 ℚ →+* ℤ)
      Rat.ringOfIntegersEquiv.bijective, Ideal.map_span, Set.image_singleton, hp']
    refine (Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).mpr ?_ |>.isMaximal ?_
    · exact (Nat.prime_iff_prime_int.mp hp)
    · rw [Ne, Ideal.span_singleton_eq_bot]; exact_mod_cast hp.ne_zero
  have hle : Ideal.span {(p : 𝓞 ℚ)} ≤ v.asIdeal :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hmem)
  have hne : v.asIdeal ≠ ⊤ := v.isPrime.ne_top
  exact (Ideal.IsMaximal.eq_of_le hmax hne hle).symm

/-- Divisibility by `p ^ n` is the same in `𝓞 ℚ` and in `ℤ`, via the canonical ring isomorphism
`Rat.ringOfIntegersEquiv`. -/
theorem dvd_prime_pow_ringOfIntegers_iff (p n : ℕ) (a : ℤ) :
    (p : 𝓞 ℚ) ^ n ∣ (a : 𝓞 ℚ) ↔ (p : ℤ) ^ n ∣ a := by
  rw [← map_dvd_iff (Rat.ringOfIntegersEquiv : 𝓞 ℚ ≃+* ℤ)]
  simp

/-- The `v`-adic valuation of an integer `a ≠ 0`, evaluated through `v : HeightOneSpectrum (𝓞 ℚ)`
whose prime ideal contains `p`, is bounded above by `exp (-n)` exactly when `n` is at most the
`p`-adic valuation of `a`. -/
theorem valuation_le_exp_neg_iff_le_padicValInt
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) (p : ℕ) (hp : p.Prime)
    (hmem : (p : NumberField.RingOfIntegers ℚ) ∈ v.asIdeal) (a : ℤ) (ha : a ≠ 0) (n : ℕ) :
    v.valuation ℚ (a : ℚ) ≤ WithZero.exp (-(n : ℤ)) ↔ n ≤ padicValInt p a := by
  have hspan := asIdeal_eq_span_prime v p hp hmem
  have ha' : (a : ℚ) = algebraMap (𝓞 ℚ) ℚ (a : 𝓞 ℚ) := (map_intCast _ a).symm
  rw [ha', IsDedekindDomain.HeightOneSpectrum.valuation_of_algebraMap,
    IsDedekindDomain.HeightOneSpectrum.intValuation_le_pow_iff_mem, hspan,
    Ideal.span_singleton_pow, Ideal.mem_span_singleton,
    dvd_prime_pow_ringOfIntegers_iff, padicValInt_dvd_iff_of_ne_one hp.ne_one]
  simp [ha]

theorem val_adicCompletion_intCast_eq_padicValInt
    (v : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers ℚ)) (p : ℕ) (hp : p.Prime)
    (hmem : (p : NumberField.RingOfIntegers ℚ) ∈ v.asIdeal) (a : ℤ) (ha : a ≠ 0) :
    Valued.v (R := v.adicCompletion ℚ) (Γ₀ := WithZero (Multiplicative ℤ))
        ((a : ℚ) : v.adicCompletion ℚ) = WithZero.exp (-(padicValInt p a : ℤ)) := by
  -- Identify the completion's valuation on `a` with the global `v`-adic valuation of `a : ℚ`.
  have hval : Valued.v (R := v.adicCompletion ℚ) (Γ₀ := WithZero (Multiplicative ℤ))
      ((a : ℚ) : v.adicCompletion ℚ) = v.valuation ℚ (a : ℚ) := by
    simpa using Commons.NumberTheory.NumberField.val_algebraMap_adicCompletion_eq v (a : ℚ)
  rw [hval]
  set m : ℕ := padicValInt p a with hm
  have hclaim : ∀ n : ℕ, v.valuation ℚ (a : ℚ) ≤ WithZero.exp (-(n : ℤ)) ↔ n ≤ m := by
    intro n
    rw [hm]
    exact valuation_le_exp_neg_iff_le_padicValInt v p hp hmem a ha n
  have ht_ne : v.valuation ℚ (a : ℚ) ≠ 0 := by
    rw [Valuation.ne_zero_iff]
    exact_mod_cast ha
  set k : ℤ := WithZero.log (v.valuation ℚ (a : ℚ)) with hk
  -- `exp (-(m:ℤ))` and `v.valuation ℚ a` have the same position on the discrete scale.
  have hk_le : k ≤ -(m : ℤ) := by
    rw [hk]
    exact (WithZero.log_le_iff_le_exp ht_ne).2 ((hclaim m).2 le_rfl)
  have hk_ge : -(m : ℤ) ≤ k := by
    have hnot : ¬ (v.valuation ℚ (a : ℚ) ≤ WithZero.exp (-(((m + 1 : ℕ) : ℤ)))) :=
      fun h => absurd ((hclaim (m + 1)).1 h) (by omega)
    have hlt : WithZero.exp (-(((m + 1 : ℕ) : ℤ))) < v.valuation ℚ (a : ℚ) :=
      lt_of_not_ge hnot
    have hk' : -(((m + 1 : ℕ) : ℤ)) < k := by
      rw [hk]
      exact (WithZero.lt_log_iff_exp_lt ht_ne).2 hlt
    omega
  have hk_eq : k = -(m : ℤ) := le_antisymm hk_le hk_ge
  have hexp : v.valuation ℚ (a : ℚ) = WithZero.exp k := by
    rw [hk]
    exact (WithZero.exp_log ht_ne).symm
  rw [hexp, hk_eq, hm]

