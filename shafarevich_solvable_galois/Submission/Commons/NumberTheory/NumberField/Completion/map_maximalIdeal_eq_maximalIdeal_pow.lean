/-! ## Elementary facts about the discrete value group `ℤᵐ⁰` -/

/-- In the discrete value group `ℤᵐ⁰`, every element `< 1` is at most `exp (-1)`: the elements of
`WithZero (Multiplicative ℤ)` below `1` are exactly the `exp (-n)` with `n ≥ 1`. -/
theorem le_exp_neg_one_iff {x : ℤᵐ⁰} : x ≤ WithZero.exp (-1) ↔ x < 1 := by
  rcases eq_or_ne x 0 with rfl | hx
  · simp
  · lift x to ℤ using hx
    rw [show (1 : ℤᵐ⁰) = WithZero.exp 0 from WithZero.exp_zero.symm, WithZero.exp_le_exp,
      WithZero.exp_lt_exp]
    omega

/-! ## The maximal ideal of a valuation ring with values in `ℤᵐ⁰` -/

/-- In a valuation ring `v.valuationSubring` of a field with value group `ℤᵐ⁰`, the maximal ideal
is generated by any element of valuation `exp (-1)` (a uniformiser). -/
theorem maximalIdeal_eq_span_of_valuation_eq_exp_neg_one {F : Type*} [Field F]
    (v : Valuation F ℤᵐ⁰) {π : v.valuationSubring} (hπ : v (π : F) = WithZero.exp (-1)) :
    IsLocalRing.maximalIdeal v.valuationSubring = Ideal.span {π} := by
  refine le_antisymm ?_ ?_
  · intro x hx
    rw [Valuation.mem_maximalIdeal_iff] at hx
    rw [Ideal.mem_span_singleton]
    have hπ0 : (π : F) ≠ 0 := by
      intro h
      rw [h, Valuation.map_zero] at hπ
      exact WithZero.exp_ne_zero hπ.symm
    have hle : v (x : F) ≤ v (π : F) := by rw [hπ]; exact le_exp_neg_one_iff.mpr hx
    refine ⟨⟨(x : F) / (π : F), ?_⟩, ?_⟩
    · show v ((x : F) / (π : F)) ≤ 1
      rw [Valuation.map_div]
      exact div_le_one_of_le₀ hle zero_le
    · apply Subtype.ext
      exact (mul_div_cancel₀ (x : F) hπ0).symm
  · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    refine (Valuation.mem_maximalIdeal_iff F v).mpr ?_
    rw [hπ, show (1 : ℤᵐ⁰) = WithZero.exp 0 from WithZero.exp_zero.symm, WithZero.exp_lt_exp]
    norm_num

/-- Two elements of a valuation ring with values in `ℤᵐ⁰` which have the same (nonzero) valuation
generate the same principal ideal. -/
theorem span_eq_span_of_valuation_eq {F : Type*} [Field F] (v : Valuation F ℤᵐ⁰)
    {a b : v.valuationSubring} (h : v (a : F) = v (b : F)) (ha : v (a : F) ≠ 0) :
    Ideal.span {a} = Ideal.span {b} := by
  have hb : v (b : F) ≠ 0 := by rw [← h]; exact ha
  have hb0 : (b : F) ≠ 0 := by
    intro hh; rw [hh, Valuation.map_zero] at hb; exact hb rfl
  have ha0 : (a : F) ≠ 0 := by
    intro hh; rw [hh, Valuation.map_zero] at ha; exact ha rfl
  have hu : v ((a : F) / (b : F)) = 1 := by rw [Valuation.map_div, h, div_self hb]
  have hu' : v ((b : F) / (a : F)) = 1 := by rw [Valuation.map_div, ← h, div_self ha]
  refine le_antisymm ?_ ?_
  · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    refine Ideal.mem_span_singleton.mpr ⟨⟨(a : F) / (b : F), ?_⟩, ?_⟩
    · show v ((a : F) / (b : F)) ≤ 1
      rw [hu]
    · apply Subtype.ext
      show (a : F) = (b : F) * ((a : F) / (b : F))
      exact (mul_div_cancel₀ (a : F) hb0).symm
  · refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
    refine Ideal.mem_span_singleton.mpr ⟨⟨(b : F) / (a : F), ?_⟩, ?_⟩
    · show v ((b : F) / (a : F)) ≤ 1
      rw [hu']
    · apply Subtype.ext
      show (b : F) = (a : F) * ((b : F) / (a : F))
      exact (mul_div_cancel₀ (b : F) ha0).symm

/-! ## Uniformisers of the integers of an adic completion -/

/-- The maximal ideal of the ring of integers of the `Q`-adic completion of a number field `K` is
generated by a uniformiser, i.e. an element whose valuation is `exp (-1)`. -/
theorem exists_uniformizer_adicCompletionIntegers {K : Type*} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) :
    ∃ π : Q.adicCompletionIntegers K,
      Valued.v (π : Q.adicCompletion K) = WithZero.exp (-1) ∧
        IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K) = Ideal.span {π} := by
  obtain ⟨π₀, hπ₀⟩ := Commons.RingTheory.Henselian.adicCompletion_valued_surjective Q
    (WithZero.exp (-1 : ℤ))
  have hle : Valued.v π₀ ≤ 1 := by
    rw [hπ₀, show (1 : ℤᵐ⁰) = WithZero.exp 0 from WithZero.exp_zero.symm, WithZero.exp_le_exp]
    norm_num
  exact ⟨⟨π₀, hle⟩, hπ₀, maximalIdeal_eq_span_of_valuation_eq_exp_neg_one Valued.v hπ₀⟩

/-! ## The maximal ideal of `𝓞 K_Q` maps onto the `e`-th power of the maximal ideal of `𝓞 L_q` -/

/-- **Neukirch–Uchida, local ingredient.**  Let `L / K` be an extension of number fields, `Q` a
height-one prime of `𝓞 K` and `q` a height-one prime of `𝓞 L` lying over `Q`.  Then the induced map
`𝓞 K_Q → 𝓞 L_q` between the rings of integers of the corresponding adic completions sends the
maximal ideal of `𝓞 K_Q` onto the `e`-th power of the maximal ideal of `𝓞 L_q`, where
`e = e(q | Q)` is the ramification index of `q` over `Q`.

This is the local statement `𝔪_K 𝓞 L_q = 𝔪_L^e` of ramification theory, proved here through
valuations: the maximal ideals are generated by uniformisers, and a uniformiser `π` of `𝓞 K_Q`
(valuation `exp (-1)`) is mapped to an element of valuation `(exp (-1))^e`, which is therefore a
generator of `𝔪_L^e`. -/
theorem map_maximalIdeal_eq_maximalIdeal_pow {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (hq : q.asIdeal.LiesOver Q.asIdeal) :
    letI : Algebra (Q.adicCompletionIntegers K) (q.adicCompletionIntegers L) :=
      RingHom.toAlgebra (((Commons.RingTheory.Henselian.adicCompletionMap Q q hq).comp
          (Q.adicCompletionIntegers K).subtype).codRestrict (q.adicCompletionIntegers L)
        (fun x => Commons.RingTheory.Henselian.adicCompletionMap_mem_integers Q q hq x.2))
    Ideal.map (algebraMap (Q.adicCompletionIntegers K) (q.adicCompletionIntegers L))
        (IsLocalRing.maximalIdeal (Q.adicCompletionIntegers K)) =
      IsLocalRing.maximalIdeal (q.adicCompletionIntegers L) ^
        (q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K)) := by
  let A := Q.adicCompletionIntegers K
  let B := q.adicCompletionIntegers L
  let φ := Commons.RingTheory.Henselian.adicCompletionMap Q q hq
  let f : A →+* B := (φ.comp A.subtype).codRestrict B
    (fun x => Commons.RingTheory.Henselian.adicCompletionMap_mem_integers Q q hq x.2)
  letI : Algebra A B := RingHom.toAlgebra f
  show Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A) =
    IsLocalRing.maximalIdeal B ^ q.asIdeal.ramificationIdx (𝓞 K)
  obtain ⟨π, hπ, hmA⟩ := exists_uniformizer_adicCompletionIntegers Q
  obtain ⟨ρ, hρ, hmB⟩ := exists_uniformizer_adicCompletionIntegers q
  have hcoef : (f π : q.adicCompletion L) = φ (π : Q.adicCompletion K) := rfl
  have hval : Valued.v ((f π : B) : q.adicCompletion L) =
      (WithZero.exp (-1 : ℤ)) ^ q.asIdeal.ramificationIdx (𝓞 K) := by
    rw [hcoef, val_adicCompletionMap_eq_pow Q q hq (π : Q.adicCompletion K), hπ]
  have hvalB : Valued.v ((ρ ^ q.asIdeal.ramificationIdx (𝓞 K) : B) : q.adicCompletion L) =
      (WithZero.exp (-1 : ℤ)) ^ q.asIdeal.ramificationIdx (𝓞 K) := by
    have hv : ((ρ ^ q.asIdeal.ramificationIdx (𝓞 K) : B) : q.adicCompletion L) =
        ((ρ : q.adicCompletion L)) ^ q.asIdeal.ramificationIdx (𝓞 K) := by simp
    rw [hv, Valuation.map_pow, hρ]
  have hspan : Ideal.span {f π} = Ideal.span {ρ ^ q.asIdeal.ramificationIdx (𝓞 K)} :=
    span_eq_span_of_valuation_eq Valued.v (by rw [hval, hvalB])
      (by rw [hval]; exact pow_ne_zero _ (WithZero.exp_ne_zero (a := (-1 : ℤ))))
  calc Ideal.map (algebraMap A B) (IsLocalRing.maximalIdeal A)
      = Ideal.map f (Ideal.span {π}) := by rw [hmA]; rfl
    _ = Ideal.span {f π} := by rw [Ideal.map_span, Set.image_singleton]
    _ = Ideal.span {ρ ^ q.asIdeal.ramificationIdx (𝓞 K)} := hspan
    _ = (Ideal.span {ρ}) ^ q.asIdeal.ramificationIdx (𝓞 K) :=
        (Ideal.span_singleton_pow ρ _).symm
    _ = (IsLocalRing.maximalIdeal B) ^ q.asIdeal.ramificationIdx (𝓞 K) := by rw [hmB]

end Commons.NumberTheory.NumberField.Completion