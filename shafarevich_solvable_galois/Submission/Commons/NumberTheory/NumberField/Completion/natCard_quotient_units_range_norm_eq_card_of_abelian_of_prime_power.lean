universe uK uB uE

/-- Finiteness of the index of the norm group of an extension of an arbitrary finite extension `B`
of the local field `Q.adicCompletion K`.

The proof realises `B` as the completion `q.adicCompletion L` of a number field `L` at a place
`q` lying over `Q` (`exists_algEquiv_adicCompletion_of_finiteDimensional_aux`), transports the
`B`-algebra structure on `E` along the resulting `Q.adicCompletion K`-algebra isomorphism,
applies the finiteness result `finite_quotient_units_range_norm_of_isGalois` at the completion
`q.adicCompletion L`, and transfers the finiteness back through the invariance of the index of
the norm group under a change of base field (`range_norm_map_eq`, `Subgroup.index_map_equiv`). -/
theorem finiteIndex_range_norm_units_of_finiteDimensional
    {K : Type uK} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    {B : Type uB} [Field B] {E : Type uE} [Field E]
    [Algebra (Q.adicCompletion K) B] [Algebra B E] [Algebra (Q.adicCompletion K) E]
    [IsScalarTower (Q.adicCompletion K) B E]
    [FiniteDimensional (Q.adicCompletion K) B] [FiniteDimensional B E]
    [IsGalois B E] :
    (MonoidHom.range (Units.map (Algebra.norm B : E →* B))).FiniteIndex := by
  classical
  obtain ⟨L, hLf, hLn, hLa, q, hq, hφ⟩ :=
    exists_algEquiv_adicCompletion_of_finiteDimensional_aux.{uK, uB, uB} (Q := Q) (B := B)
  obtain ⟨φ⟩ := hφ
  letI : Field L := hLf
  letI : NumberField L := hLn
  obtain ⟨eφ, mulφ, addφ, commφ⟩ := φ
  let rφ : B ≃+* (q.adicCompletion L) := RingEquiv.mk eφ mulφ addφ
  let f : (q.adicCompletion L) →+* E := (algebraMap B E).comp rφ.symm.toRingHom
  letI : Algebra (q.adicCompletion L) E := f.toAlgebra
  have hhe : (algebraMap (q.adicCompletion L) E).comp rφ.toRingHom = algebraMap B E := by
    rw [RingHom.algebraMap_toAlgebra f]
    ext x
    show (algebraMap B E) (rφ.symm (rφ x)) = algebraMap B E x
    rw [rφ.symm_apply_apply]
  haveI : FiniteDimensional (q.adicCompletion L) E := finiteDimensional_transport rφ hhe
  haveI : IsGalois (q.adicCompletion L) E := isGalois_transport rφ hhe
  haveI hfin' : Finite ((q.adicCompletion L)ˣ ⧸ MonoidHom.range (Units.map
      (Algebra.norm (q.adicCompletion L) : E →* q.adicCompletion L))) :=
    finite_quotient_units_range_norm_of_isGalois (K := L) (Q := q) (E := E)
  have hmap := range_norm_map_eq (φ := rφ) hhe
  have hidx : (MonoidHom.range (Units.map (Algebra.norm B : E →* B))).index =
      (MonoidHom.range (Units.map
        (Algebra.norm (q.adicCompletion L) : E →* q.adicCompletion L))).index := by
    rw [← hmap]
    exact (Subgroup.index_map_equiv _ (Units.mapEquiv rφ.toMulEquiv)).symm
  have hne : (MonoidHom.range (Units.map (Algebra.norm B : E →* B))).index ≠ 0 := by
    rw [hidx]
    exact Subgroup.index_ne_zero_of_finite
  exact Subgroup.finiteIndex_iff.mpr hne

/-- The `ℓ`-primary (Sylow) reduction of the abelian local norm index identity, **conditioned on
the finiteness** of the index of the norm group `N_{E/B}(Eˣ)` in `Bˣ`.

For every prime `ℓ` dividing `#Gal(E/B)` the subgroup of `Gal(E/B)` generated by the `q`-Sylow
subgroups for `q ≠ ℓ` is the kernel of a surjection onto the `ℓ`-Sylow subgroup
(`Commons.GroupTheory.exists_subgroup_card_quotient_eq_pow_factorization`); its fixed field `E_ℓ`
therefore has Galois group of order `ℓ ^ (#Gal(E/B)).factorization ℓ` and is an `ℓ`-group.
Hypothesis `hp` applied at `E_ℓ` identifies the index of `N_{E_ℓ/B}(E_ℓˣ)` with that order; the
indices `ℓ ^ v_ℓ` are pairwise coprime, so `index_iInf_eq_prod_of_pairwise_coprime_index` computes
the index of the intersection of the norm groups as `∏_ℓ ℓ ^ v_ℓ = #Gal(E/B)`.  Since
`N_{E/B}(Eˣ) ≤ ⋂_ℓ N_{E_ℓ/B}(E_ℓˣ)` (norm transitivity) and `N_{E/B}(Eˣ)` has finite index, its
index is at least `#Gal(E/B)`, while `hupper` bounds it above by `#Gal(E/B)`. -/
theorem natCard_quotient_units_range_norm_eq_card_of_abelian_of_prime_power_of_finiteIndex
    {K : Type*} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    {B E : Type*} [Field B] [Field E]
    [Algebra (Q.adicCompletion K) B] [Algebra B E] [Algebra (Q.adicCompletion K) E]
    [IsScalarTower (Q.adicCompletion K) B E]
    [FiniteDimensional (Q.adicCompletion K) B] [FiniteDimensional B E]
    [IsGalois B E]
    (hcomm : ∀ a b : E ≃ₐ[B] E, a * b = b * a)
    (hupper : Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : E →* B))) ≤
      Nat.card (E ≃ₐ[B] E))
    (hp : ∀ (M : IntermediateField B E) (p : ℕ), IsPGroup p (M ≃ₐ[B] M) →
      Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : M →* B))) =
        Nat.card (M ≃ₐ[B] M))
    (hfin : (MonoidHom.range (Units.map (Algebra.norm B : E →* B))).FiniteIndex) :
    Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : E →* B))) =
      Nat.card (E ≃ₐ[B] E) := by
  classical
  letI : CommGroup (E ≃ₐ[B] E) := { (inferInstance : Group (E ≃ₐ[B] E)) with mul_comm := hcomm }
  haveI : Fintype (E ≃ₐ[B] E) := AlgEquiv.fintype B E
  set ps := (Nat.card (E ≃ₐ[B] E)).primeFactors with hps
  -- For each prime `ℓ` dividing `#Gal(E/B)` choose the complement of the `ℓ`-Sylow subgroup.
  have key : ∀ p : ps, ∃ H : Subgroup (E ≃ₐ[B] E),
      Nat.card ((E ≃ₐ[B] E) ⧸ H) = p.1 ^ (Nat.card (E ≃ₐ[B] E)).factorization p.1 := by
    intro p
    haveI : Fact p.1.Prime := ⟨Nat.prime_of_mem_primeFactors p.2⟩
    exact Commons.GroupTheory.exists_subgroup_card_quotient_eq_pow_factorization
  let Hf : ps → Subgroup (E ≃ₐ[B] E) := fun p => Classical.choose (key p)
  have Hf_spec : ∀ p : ps, Nat.card ((E ≃ₐ[B] E) ⧸ Hf p) =
      p.1 ^ (Nat.card (E ≃ₐ[B] E)).factorization p.1 := fun p => Classical.choose_spec (key p)
  let Mf : ps → IntermediateField B E := fun p => IntermediateField.fixedField (Hf p)
  let Nf : ps → Subgroup Bˣ := fun p => MonoidHom.range (Units.map (Algebra.norm B : ↥(Mf p) →* B))
  -- The Galois group of the fixed field of `Hf p` is the quotient by `Hf p`.
  have hcard_Mf : ∀ p : ps, Nat.card (↥(Mf p) ≃ₐ[B] ↥(Mf p)) =
      p.1 ^ (Nat.card (E ≃ₐ[B] E)).factorization p.1 := by
    intro p
    haveI : (Hf p).Normal := Subgroup.normal_of_isMulCommutative (Hf p)
    have e := IsGalois.normalAutEquivQuotient (K := B) (L := E) (Hf p)
    exact (Nat.card_congr e.toEquiv).symm.trans (Hf_spec p)
  have hP : ∀ p : ps, IsPGroup p.1 (↥(Mf p) ≃ₐ[B] ↥(Mf p)) := fun p =>
    IsPGroup.of_card (hcard_Mf p)
  -- Hypothesis `hp` turns this into the index of the norm group.
  have hNidx : ∀ p : ps, (Nf p).index = p.1 ^ (Nat.card (E ≃ₐ[B] E)).factorization p.1 := by
    intro p
    rw [Subgroup.index_eq_card]
    rw [hp (Mf p) p.1 (hP p)]
    exact hcard_Mf p
  have hfinN : ∀ p : ps, (Nf p).FiniteIndex := by
    intro p
    rw [Subgroup.finiteIndex_iff, hNidx p]
    exact pow_ne_zero _ (Nat.prime_of_mem_primeFactors p.2).ne_zero
  have hcop : Pairwise fun p q : ps => (Nf p).index.Coprime (Nf q).index := by
    intro p q hpq
    rw [hNidx p, hNidx q]
    have hpne : p.1 ≠ q.1 := by intro h; exact hpq (Subtype.ext h)
    exact (Nat.coprime_primes (Nat.prime_of_mem_primeFactors p.2)
      (Nat.prime_of_mem_primeFactors q.2)).mpr hpne |>.pow _ _
  -- Norm transitivity: the norm group of `E` sits inside each norm group of a subfield.
  have hle : MonoidHom.range (Units.map (Algebra.norm B : E →* B)) ≤ ⨅ p, Nf p := by
    refine le_iInf (fun p => ?_)
    exact Commons.FieldTheory.Galois.range_norm_le_range_norm_of_intermediateField (Mf p)
  have hidx : (⨅ p, Nf p).index = ∏ p, (Nf p).index :=
    GroupTheory.Subgroup.index_iInf_eq_prod_of_pairwise_coprime_index Nf hfinN hcop
  -- The product of the pairwise coprime indices is `#Gal(E/B)`.
  have hprod : ∏ p : ps, (Nf p).index = Nat.card (E ≃ₐ[B] E) := by
    calc ∏ p : ps, (Nf p).index
        = ∏ p : ps, p.1 ^ (Nat.card (E ≃ₐ[B] E)).factorization p.1 :=
          Finset.prod_congr rfl (fun p _ => hNidx p)
      _ = ∏ p ∈ ps, p ^ (Nat.card (E ≃ₐ[B] E)).factorization p :=
          Finset.prod_finset_coe (fun q => q ^ (Nat.card (E ≃ₐ[B] E)).factorization q) ps
      _ = (Nat.card (E ≃ₐ[B] E)).factorization.prod (· ^ ·) := rfl
      _ = Nat.card (E ≃ₐ[B] E) :=
          Nat.prod_factorization_pow_eq_self (Nat.card_pos.ne')
  have hchain : Nat.card (E ≃ₐ[B] E) ≤
      (MonoidHom.range (Units.map (Algebra.norm B : E →* B))).index := by
    haveI := hfin
    rw [← hprod, ← hidx]
    exact Subgroup.index_antitone hle
  refine le_antisymm hupper ?_
  rw [← Subgroup.index_eq_card (MonoidHom.range (Units.map (Algebra.norm B : E →* B)))]
  exact hchain

/-- **ℓ-primary (Sylow) reduction of the abelian local norm index identity.**

Let `B` be a finite extension of the local field `F = Q.adicCompletion K` and let `E / B` be a
finite *abelian* Galois extension.  If the norm index identity `#(Bˣ ⧸ N_{M/B}(Mˣ)) = #Gal(M/B)`
is known for every intermediate field `M` of `E / B` whose Galois group `M ≃ₐ[B] M` is a prime
power group, and if the elementary upper bound `#(Bˣ ⧸ N_{E/B}(Eˣ)) ≤ #Gal(E/B)` holds, then the
identity holds for `E` itself.

Route of proof: for each prime `ℓ` dividing `#Gal(E/B)`, let `E_ℓ` be the subextension fixed by
the subgroup generated by the Sylow `q`-subgroups of `Gal(E/B)` for all `q ≠ ℓ`; then
`Gal(E_ℓ/B) ≅ ` the Sylow `ℓ`-subgroup, so the hypothesis applies at `E_ℓ` and gives
`#(Bˣ ⧸ N_{E_ℓ/B}(E_ℓˣ)) = ℓ ^ (the exponent of `ℓ` in `#Gal(E/B))`.  These indices are pairwise
coprime, so `index_iInf_eq_prod_of_pairwise_coprime_index` gives
`#(Bˣ ⧸ ⋂_ℓ N_{E_ℓ/B}(E_ℓˣ)) = ∏_ℓ ℓ ^ (...) = #Gal(E/B)`.  The norm groups are nested,
`N_{E/B}(Eˣ) ≤ ⋂_ℓ N_{E_ℓ/B}(E_ℓˣ)` (by `Algebra.norm_norm`), and the hypothesis that
`N_{E/B}(Eˣ)` has index at most `#Gal(E/B)` closes the argument.

The finiteness of the norm index required by the reduction is supplied by
`finiteIndex_range_norm_units_of_finiteDimensional` (the local-field-theoretic input). -/
theorem natCard_quotient_units_range_norm_eq_card_of_abelian_of_prime_power
    {K : Type*} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    {B E : Type*} [Field B] [Field E]
    [Algebra (Q.adicCompletion K) B] [Algebra B E] [Algebra (Q.adicCompletion K) E]
    [IsScalarTower (Q.adicCompletion K) B E]
    [FiniteDimensional (Q.adicCompletion K) B] [FiniteDimensional B E]
    [IsGalois B E]
    (hcomm : ∀ a b : E ≃ₐ[B] E, a * b = b * a)
    (hupper : Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : E →* B))) ≤
      Nat.card (E ≃ₐ[B] E))
    (hp : ∀ (M : IntermediateField B E) (p : ℕ), IsPGroup p (M ≃ₐ[B] M) →
      Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : M →* B))) =
        Nat.card (M ≃ₐ[B] M)) :
    Nat.card (Bˣ ⧸ MonoidHom.range (Units.map (Algebra.norm B : E →* B))) =
      Nat.card (E ≃ₐ[B] E) :=
  natCard_quotient_units_range_norm_eq_card_of_abelian_of_prime_power_of_finiteIndex Q
    hcomm hupper hp (finiteIndex_range_norm_units_of_finiteDimensional (K := K) Q)

end Commons.NumberTheory.NumberField.Completion
