namespace Commons.GroupTheory.Subgroup

/-- The index of the subgroup generated by `ofAdd a` in the multiplicative group `Multiplicative ℤ`
equals `a.natAbs`. -/
lemma index_zpowers_ofAdd (a : ℤ) :
    (Subgroup.zpowers (Multiplicative.ofAdd a)).index = a.natAbs := by
  let ψ : Multiplicative ℤ →* Multiplicative (ZMod a.natAbs) :=
    (Int.castAddHom (ZMod a.natAbs)).toMultiplicative
  have hψapply : ∀ m : ℤ,
      ψ (Multiplicative.ofAdd m) = Multiplicative.ofAdd ((m : ZMod a.natAbs)) :=
    fun m => rfl
  have hker : ψ.ker = Subgroup.zpowers (Multiplicative.ofAdd a) := by
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_zpowers_iff]
    rw [show ψ x = Multiplicative.ofAdd ((x.toAdd : ZMod a.natAbs)) from by
      conv_lhs => rw [← ofAdd_toAdd x]
      exact hψapply x.toAdd]
    rw [ofAdd_eq_one, ZMod.intCast_zmod_eq_zero_iff_dvd, Int.natAbs_dvd]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨c, by rw [← ofAdd_toAdd x, hc, Int.ofAdd_mul]⟩
    · rintro ⟨k, hk⟩
      exact ⟨k, by rw [← hk, Int.toAdd_zpow, toAdd_ofAdd]⟩
  have hsurj : Function.Surjective ψ := by
    intro y
    obtain ⟨m, hm⟩ := ZMod.intCast_surjective (n := a.natAbs) y.toAdd
    exact ⟨Multiplicative.ofAdd m, by rw [hψapply m, hm, ofAdd_toAdd]⟩
  rw [← hker, Subgroup.index_ker, MonoidHom.range_eq_top.mpr hsurj, Subgroup.card_top]
  exact (Nat.card_congr (Multiplicative.ofAdd (α := ZMod a.natAbs))).symm.trans
    (Nat.card_zmod a.natAbs)

theorem index_eq_of_ker_le_of_map_eq_zpowers
    {G : Type*} [Group G] (φ : G →* Multiplicative ℤ) (hφ : Function.Surjective φ)
    (H : Subgroup G) (f : ℕ)
    (hf : Subgroup.map φ H = Subgroup.zpowers (Multiplicative.ofAdd (f : ℤ)))
    (hKH : φ.ker ≤ H) :
    H.index = f := by
  have h1 : H.index = (H.map φ).index := (Subgroup.index_map_eq H hφ hKH).symm
  rw [h1, hf, index_zpowers_ofAdd, Int.natAbs_natCast]

end Commons.GroupTheory.Subgroup