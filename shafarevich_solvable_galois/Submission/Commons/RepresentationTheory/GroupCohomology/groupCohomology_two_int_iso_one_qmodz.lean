/-!
# `H²(G, ℤ) ≃ H¹(G, ℚ/ℤ)` for a finite group `G`

For a finite group `G`, the connecting homomorphism of the coefficient sequence
`0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` (all with trivial `G`-action) gives an isomorphism
`H²(G, ℤ) ≃ H¹(G, ℚ/ℤ)`.  Indeed the long exact sequence reads
`H¹(G, ℚ) ⟶ H¹(G, ℚ/ℤ) ⟶ H²(G, ℤ) ⟶ H²(G, ℚ)`, and `Hⁿ(G, ℚ) = 0` for `n ≥ 1`
because `ℚ` is a `ℚ`-vector space while `Hⁿ(G, M)` is killed by `|G|`.

The basic tools are provided by Mathlib's
`Mathlib.RepresentationTheory.Homological.GroupCohomology.LongExactSequence`
(`groupCohomology.δ` and `groupCohomology.isIso_δ_of_isZero`), and the vanishing
`Hⁿ(G, ℚ) = 0` by the shared-commons lemma `subsingleton_groupCohomology_trivial_rat`.

Two implementation points are worth recording, since they cost some effort:

* Group cohomology is stated for `Rep ℤ G`.  For `k = ℤ` the module structure on a
  `Rep ℤ G`-object is a *diamond* (`A.hV2` versus `AddCommGroup.toIntModule`), so the
  forgetful functor `forget₂ (Rep ℤ G) (ModuleCat ℤ)` cannot be synthesised as an
  instance and the standard recipe
  `(forget₂ _ _).reflects_exact_of_faithful` for exactness of a short complex of
  representations is unavailable *at* `ℤ`.  The workaround is to prove the criterion
  `shortExact_of_mono_epi_elementwise` once over an *arbitrary* commutative ring `k`
  (where no diamond occurs) and then apply it at `k = ℤ`: the elaborator only unifies
  the already fixed instance arguments.

* With that criterion, the short exact sequence `0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` of trivial
  representations is checked by hand on elements.
-/

namespace Commons.RepresentationTheory.GroupCohomology

open CategoryTheory
open CategoryTheory.Limits

noncomputable section

/-- **Elementwise criterion for exactness of a short complex of representations.**

If `0 ⟶ X₁ ⟶ X₂ ⟶ X₃` is mono-epi and every element of `X₂` killed by `g` lies in the
range of `f`, then the short complex is short exact.

The statement is deliberately made over an arbitrary commutative ring `k`: at `k = ℤ`
the `Module ℤ`-structure on a `Rep ℤ G`-object is a diamond, so the forgetful functor
`forget₂ (Rep ℤ G) (ModuleCat ℤ)` is not synthesizable as an instance.  Proving the
criterion for a variable `k` and then specialising avoids the diamond, since the
specialisation only unifies instance arguments that were fixed generically. -/
theorem shortExact_of_mono_epi_elementwise {k : Type} [CommRing k] {G : Type} [Group G]
    (S : ShortComplex (Rep k G)) (hf : Mono S.f) (hg : Epi S.g)
    (h : ∀ x : S.X₂, S.g.hom x = 0 → ∃ y : S.X₁, S.f.hom y = x) : S.ShortExact := by
  refine ShortComplex.ShortExact.mk' ?_ hf hg
  rw [← ShortComplex.exact_map_iff_of_faithful S (forget₂ (Rep k G) (ModuleCat k))]
  rw [ShortComplex.moduleCat_exact_iff]
  intro x hx
  exact h x hx

/-- `ℚ/ℤ`, presented as the quotient of `ℚ` by the subgroup generated by `1`. -/
private abbrev QmodZ : Type := ℚ ⧸ AddSubgroup.closure ({(1:ℚ)} : Set ℚ)

/-- The inclusion `ℤ ↪ ℚ`, as a `ℤ`-linear map. -/
private abbrev intToRat : ℤ →ₗ[ℤ] ℚ := (Int.castAddHom ℚ).toIntLinearMap

/-- The quotient map `ℚ ↠ ℚ/ℤ`. -/
private abbrev ratToQmodZ : ℚ →ₗ[ℤ] QmodZ :=
  (QuotientAddGroup.mk' (AddSubgroup.closure ({(1:ℚ)} : Set ℚ))).toIntLinearMap

section

variable (G : Type) [Group G]

/-- The inclusion of the trivial representation `ℤ` into the trivial representation `ℚ`. -/
private abbrev fHom : Rep.trivial ℤ G ℤ ⟶ Rep.trivial ℤ G ℚ :=
  Rep.ofHom ⟨intToRat, fun g => by rw [Rep.trivial_ρ, Rep.trivial_ρ]; simp⟩

/-- The projection of the trivial representation `ℚ` onto the trivial representation `ℚ/ℤ`. -/
private abbrev gHom : Rep.trivial ℤ G ℚ ⟶ Rep.trivial ℤ G QmodZ :=
  Rep.ofHom ⟨ratToQmodZ, fun g => by rw [Rep.trivial_ρ, Rep.trivial_ρ]; simp⟩

/-- The coefficient sequence `0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` of trivial `ℤ`-linear
`G`-representations. -/
private abbrev ses : ShortComplex (Rep ℤ G) :=
  ShortComplex.mk (fHom G) (gHom G) (by
    apply Rep.hom_ext
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro x
    show ((x : ℚ) : QmodZ) = 0
    rw [QuotientAddGroup.eq_zero_iff]
    rw [← AddSubgroup.zmultiples_eq_closure, AddSubgroup.mem_zmultiples_iff]
    exact ⟨x, by simp⟩)

/-- The coefficient sequence `0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` is short exact. -/
private theorem ses_shortExact : (ses G).ShortExact :=
  shortExact_of_mono_epi_elementwise (k := ℤ) (G := G) (ses G)
    ((Rep.mono_iff_injective (fHom G)).2 (fun a b hab => by
      have hab' : (a : ℚ) = (b : ℚ) := hab
      exact Int.cast_injective hab'))
    ((Rep.epi_iff_surjective (gHom G)).2 (fun y => by
      obtain ⟨x, hx⟩ := QuotientAddGroup.mk'_surjective (AddSubgroup.closure ({(1:ℚ)} : Set ℚ)) y
      refine ⟨x, ?_⟩
      show ((x : ℚ) : QmodZ) = y
      exact hx))
    (fun x hx => by
      have hx' : ratToQmodZ x = 0 := hx
      have hmem : x ∈ AddSubgroup.closure ({(1:ℚ)} : Set ℚ) :=
        (QuotientAddGroup.eq_zero_iff x).1 hx'
      rw [← AddSubgroup.zmultiples_eq_closure] at hmem
      rw [AddSubgroup.mem_zmultiples_iff] at hmem
      obtain ⟨n, hn⟩ := hmem
      refine ⟨n, ?_⟩
      show intToRat n = x
      rw [show intToRat n = (n:ℚ) from rfl]
      simpa using hn)

end

/-- **`H²(G, ℤ) ≅ H¹(G, ℚ/ℤ)` for a finite group `G`.**

The connecting homomorphism `δ : H¹(G, ℚ/ℤ) ⟶ H²(G, ℤ)` of the coefficient sequence
`0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` is an isomorphism, because the adjacent terms `H¹(G, ℚ)` and
`H²(G, ℚ)` vanish for the finite group `G`.  This is Neukirch–Schmidt–Wingberg,
*Cohomology of Number Fields*, Chapter XII, used in the proof of (12.2.1). -/
theorem groupCohomology_two_int_iso_one_qmodz (G : Type) [Group G] [Fintype G] :
    Nonempty (groupCohomology (Rep.trivial ℤ G ℤ) 2 ≃ₗ[ℤ]
      groupCohomology (Rep.trivial ℤ G (ℚ ⧸ AddSubgroup.closure ({(1:ℚ)} : Set ℚ))) 1) := by
  have h1 : IsZero (groupCohomology (Rep.trivial ℤ G ℚ) 1) :=
    ModuleCat.isZero_iff_subsingleton.mpr
      (subsingleton_groupCohomology_trivial_rat G 1 (by norm_num))
  have h2 : IsZero (groupCohomology (Rep.trivial ℤ G ℚ) 2) :=
    ModuleCat.isZero_iff_subsingleton.mpr
      (subsingleton_groupCohomology_trivial_rat G 2 (by norm_num))
  haveI : IsIso (groupCohomology.δ (ses_shortExact G) 1 2 rfl) :=
    groupCohomology.isIso_δ_of_isZero (ses_shortExact G) 1 h1 h2
  exact ⟨(asIso (groupCohomology.δ (ses_shortExact G) 1 2 rfl)).symm.toLinearEquiv⟩

end

end Commons.RepresentationTheory.GroupCohomology