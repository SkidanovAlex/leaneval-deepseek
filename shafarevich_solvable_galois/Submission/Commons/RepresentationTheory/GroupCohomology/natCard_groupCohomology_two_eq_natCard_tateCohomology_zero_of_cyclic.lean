/-!
# Periodicity in degree two: `H²(G, A)` and `Ĥ⁰(G, A)`

For a finite **cyclic** group `G` generated by `g` and a `k`-linear representation `A` of `G`
(`k` any commutative ring), the second group cohomology and the zeroth Tate cohomology agree:

  `H²(G, A) ≅ Ĥ⁰(G, A) ≅ Aᴳ / N(A)`.

This is the degree-two case of the two-periodicity of the cohomology of a cyclic group.  Concretely
`H²(G, A)` is the middle homology of the periodic alternating complex
`A --N--> A --(ρ(g) - 1)--> A`, hence `ker(ρ(g) - 1)/Im(N)`, while `Ĥ⁰(G, A)` is the degree-zero
homology of the Tate complex, hence `Aᴳ/Im(N)`; for a cyclic group the invariants `Aᴳ` are exactly
`ker(ρ(g) - 1)`.

Because cardinality is what the application needs, the main theorem only records the resulting
equality `Nat.card (H²(G, A)) = Nat.card (Ĥ⁰(G, A))`.  The proof passes through an explicit linear
equivalence, built from Mathlib's `groupCohomologyIsoEven` (the degree-two identification with the
alternating complex) and the degree-zero Tate computation `tateCohomology_zero_iso_general` proved
below for an *arbitrary* commutative ring.

The statement is kept for a general `CommRing k` rather than for `k = ℤ` on purpose: at `k = ℤ`
the `ℤ`-module structure on a `Rep ℤ G`-object is a diamond (`Rep.hV2` versus
`AddCommGroup.toIntModule`), which makes the `LinearMap`/`Submodule` bookkeeping below fragile.
Proving the general statement and specialising avoids that diamond entirely, since the generic
elaboration fixes the module instance once and for all.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSimpArgs false

namespace Commons.RepresentationTheory.GroupCohomology

open CategoryTheory Limits Representation

/-! ## The zeroth Tate cohomology of an arbitrary commutative ring

`tateCohomology_zero_iso_general` is the statement that the degree-zero homology of the Tate
complex of `A : Rep k G` is `Aᴳ ⧸ N(A)`, where `N = ∑_{g : G} ρ(g)` is the norm map.  It is the
generalisation to an arbitrary commutative ring `k` of the shared-commons lemma
`Commons.RepresentationTheory.TateCohomology.tateCohomology_zero_iso` (which is stated over `ℤ`).
All the ingredients below are generic over `k`, so no `ℤ`-specific machinery is needed. -/

section TateZeroGeneral

variable {k G V : Type} [CommRing k] [Group G] [Fintype G] [AddCommGroup V] [Module k V]

/-- The three-term complex `V --N--> V --d₀₁--> (G → V)` exhibiting the part of the Tate complex
around degree `0`.  Its homology is `Ĥ⁰`. -/
private noncomputable def auxS0 (ρ : Representation k G V) : ShortComplex (ModuleCat k) :=
  ShortComplex.mk (Rep.Hom.toModuleCatHom (Rep.of ρ).norm) (groupCohomology.d₀₁ (Rep.of ρ))
    (Rep.norm_comp_d_eq_zero (Rep.of ρ))

private lemma aux_ker_S0_g (ρ : Representation k G V) :
    LinearMap.ker (auxS0 ρ).g.hom = ρ.invariants := by
  rw [show (auxS0 ρ).g = groupCohomology.d₀₁ (Rep.of ρ) from rfl]
  exact groupCohomology.d₀₁_ker_eq_invariants (Rep.of ρ)

/-- The kernel of `d₀₁` is the invariants; this is the corresponding linear equivalence. -/
private noncomputable def aux_eKer (ρ : Representation k G V) :
    ↥(LinearMap.ker (auxS0 ρ).g.hom) ≃ₗ[k] ↥(ρ.invariants) :=
  LinearEquiv.ofEq _ _ (aux_ker_S0_g ρ)

private lemma aux_moduleCatToCycles_val (ρ : Representation k G V) (z : V) :
    ((auxS0 ρ).moduleCatToCycles z).1 = ρ.norm z := rfl

/-- Under the identification `ker d₀₁ = Vᴳ`, the image of the norm map in `ker d₀₁` becomes
exactly `N(V) ⊆ Vᴳ`. -/
private lemma aux_map_P_eq_Q (ρ : Representation k G V) :
    (LinearMap.range (auxS0 ρ).moduleCatToCycles).map (aux_eKer ρ).toLinearMap =
      (LinearMap.range ρ.norm).comap ρ.invariants.subtype := by
  ext x
  constructor
  · intro hx
    rw [Submodule.mem_map] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    rw [Submodule.mem_comap]
    rw [LinearMap.mem_range] at hy
    obtain ⟨z, hz⟩ := hy
    refine ⟨z, ?_⟩
    show ρ.norm z = ((aux_eKer ρ) y : V)
    rw [show ((aux_eKer ρ) y : V) = (y.1 : V) from rfl]
    have hz' : (y.1 : V) = ρ.norm z := by rw [← hz]; rfl
    exact hz'.symm
  · intro hx
    rw [Submodule.mem_map]
    rw [Submodule.mem_comap, LinearMap.mem_range] at hx
    obtain ⟨z, hz⟩ := hx
    refine ⟨⟨x.1, (aux_ker_S0_g ρ).ge x.2⟩, ?_, ?_⟩
    · rw [LinearMap.mem_range]
      refine ⟨z, Subtype.ext ?_⟩
      show ρ.norm z = x.1
      exact hz
    · apply Subtype.ext; rfl

/-- `Ĥ⁰(G, V)` of the three-term complex `auxS0` is the quotient of the invariants by the image
of the norm. -/
private noncomputable def aux_e4 (ρ : Representation k G V) :
    letI : Module k ↥(LinearMap.ker (auxS0 ρ).g.hom) := (LinearMap.ker (auxS0 ρ).g.hom).module
    letI : Module k ↥(ρ.invariants) := (ρ.invariants).module
    ((LinearMap.ker (auxS0 ρ).g.hom) ⧸ LinearMap.range (auxS0 ρ).moduleCatToCycles) ≃ₗ[k]
      (ρ.invariants ⧸ (LinearMap.range ρ.norm).comap ρ.invariants.subtype) := by
  letI : Module k ↥(LinearMap.ker (auxS0 ρ).g.hom) := (LinearMap.ker (auxS0 ρ).g.hom).module
  letI : Module k ↥(ρ.invariants) := (ρ.invariants).module
  exact Submodule.Quotient.equiv _ _ (aux_eKer ρ) (aux_map_P_eq_Q ρ)

/-- The short complex `auxS0` is isomorphic, in degrees `-1, 0, 1`, to the Tate complex of
`Rep.of ρ`.  The isomorphisms in degrees `-1, 0, 1` identify the inhomogeneous chains and
cochains with `V` and with `G → V`. -/
private noncomputable def aux_scIso (ρ : Representation k G V) :
    (tateComplex (Rep.of ρ)).sc' (-1) 0 1 ≅ auxS0 ρ :=
  ShortComplex.isoMk (groupHomology.chainsIso₀ (Rep.of ρ)) (groupCohomology.cochainsIso₀ (Rep.of ρ))
    (groupCohomology.cochainsIso₁ (Rep.of ρ))
    (by
      show (groupHomology.chainsIso₀ (Rep.of ρ)).hom ≫ Rep.Hom.toModuleCatHom (Rep.of ρ).norm
        = Rep.tateNorm (Rep.of ρ) ≫ (groupCohomology.cochainsIso₀ (Rep.of ρ)).hom
      rw [Rep.tateNorm]
      simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id])
    (by
      show (groupCohomology.cochainsIso₀ (Rep.of ρ)).hom ≫ groupCohomology.d₀₁ (Rep.of ρ)
        = (groupCohomology.inhomogeneousCochains (Rep.of ρ)).d 0 1 ≫
            (groupCohomology.cochainsIso₁ (Rep.of ρ)).hom
      exact groupCohomology.comp_d₀₁_eq (Rep.of ρ))

/-- **The zeroth Tate cohomology of a `k`-linear representation, for any commutative ring `k`.**
For `ρ : Representation k G V` with `G` finite, the degree-zero Tate cohomology is the quotient
of the invariants by the image of the norm: `Ĥ⁰(G, V) ≅ Vᴳ ⧸ N(V)`. -/
theorem tateCohomology_zero_iso_general (ρ : Representation k G V) :
    Nonempty (tateCohomology (Rep.of ρ) 0 ≃ₗ[k] (ρ.invariants) ⧸
        (LinearMap.range ρ.norm).comap (ρ.invariants).subtype) := by
  classical
  refine ⟨?_⟩
  let iso1 : (tateComplex (Rep.of ρ)).homology 0 ≅
      ((tateComplex (Rep.of ρ)).sc' (-1) 0 1).homology :=
    HomologicalComplex.homologyIsoSc' (tateComplex (Rep.of ρ)) (-1) 0 1
      (ComplexShape.prev_eq' (ComplexShape.up ℤ) (show (ComplexShape.up ℤ).Rel (-1) 0 from by
        simp [ComplexShape.up, ComplexShape.up']))
      (ComplexShape.next_eq' (ComplexShape.up ℤ) (show (ComplexShape.up ℤ).Rel 0 1 from by
        simp [ComplexShape.up, ComplexShape.up']))
  have h1 : (tateCohomology (Rep.of ρ) 0) ≃ₗ[k]
      ((tateComplex (Rep.of ρ)).sc' (-1) 0 1).homology := iso1.toLinearEquiv
  have h2 : ((tateComplex (Rep.of ρ)).sc' (-1) 0 1).homology ≃ₗ[k] (auxS0 ρ).homology :=
    (ShortComplex.homologyMapIso (aux_scIso ρ)).toLinearEquiv
  have h3 : (auxS0 ρ).homology ≃ₗ[k] (auxS0 ρ).moduleCatLeftHomologyData.H :=
    (ShortComplex.moduleCatHomologyIso (auxS0 ρ)).toLinearEquiv
  have h4 : (auxS0 ρ).moduleCatLeftHomologyData.H ≃ₗ[k]
      (ρ.invariants ⧸ (LinearMap.range ρ.norm).comap ρ.invariants.subtype) := aux_e4 ρ
  exact h1.trans (h2.trans (h3.trans h4))

end TateZeroGeneral

/-! ## `H²` of a cyclic group is `Aᴳ ⧸ N(A)` -/

section CyclicDegreeTwo

variable {k G : Type} [CommRing k] [CommGroup G] [Fintype G]

/-- For a cyclic group `G` generated by `g`, the kernel of `ρ(g) - 1` is the invariants. -/
private lemma ker_sub_eq_invariants (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    LinearMap.ker (Rep.FiniteCyclicGroup.normHomCompSub A g).g.hom = A.ρ.invariants := by
  ext v
  rw [LinearMap.mem_ker, Representation.mem_invariants_iff_of_forall_mem_zpowers A.ρ g hg v]
  have hv : (Rep.FiniteCyclicGroup.normHomCompSub A g).g.hom v = A.ρ g v - v := by
    simp [Rep.FiniteCyclicGroup.normHomCompSub, Rep.sub_hom, Rep.applyAsHom_apply]
  rw [hv]
  exact sub_eq_zero

/-- Transporting a `comap` of the subtype along an equality of submodules. -/
private lemma map_comap_subtype_ofEq {M : Type} [AddCommGroup M] [Module k M]
    {p q : Submodule k M} (h : p = q) (r : Submodule k M) :
    (r.comap p.subtype).map (LinearEquiv.ofEq p q h).toLinearMap = r.comap q.subtype := by
  subst h
  simp

/-- The middle homology of the alternating complex `A --N--> A --(ρ(g) - 1)--> A` is the
quotient of the invariants by the image of the norm. -/
private noncomputable def cyclicHomologyIso (A : Rep k G) (g : G)
    (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.H ≃ₗ[k]
      (A.ρ.invariants ⧸ (LinearMap.range A.ρ.norm).comap A.ρ.invariants.subtype) := by
  letI : Module k ↥(LinearMap.ker (Rep.FiniteCyclicGroup.normHomCompSub A g).g.hom) :=
    (LinearMap.ker (Rep.FiniteCyclicGroup.normHomCompSub A g).g.hom).module
  letI : Module k ↥(A.ρ.invariants) := (A.ρ.invariants).module
  have hker := ker_sub_eq_invariants A g hg
  have hmap : (LinearMap.range (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatToCycles).map
        (LinearEquiv.ofEq _ _ hker).toLinearMap
      = (LinearMap.range A.ρ.norm).comap A.ρ.invariants.subtype := by
    rw [show (LinearMap.range (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatToCycles)
        = (LinearMap.range A.ρ.norm).comap
            (LinearMap.ker (Rep.FiniteCyclicGroup.normHomCompSub A g).g.hom).subtype from ?_]
    · exact map_comap_subtype_ofEq hker (LinearMap.range A.ρ.norm)
    · rw [ShortComplex.moduleCatToCycles]
      exact LinearMap.range_codRestrict _ _ _
  exact Submodule.Quotient.equiv _ _ (LinearEquiv.ofEq _ _ hker) hmap

/-- **Periodicity in degree two, for an arbitrary commutative ring.**  For a finite cyclic group
`G` generated by `g` and a `k`-linear representation `A`, `H²(G, A)` and `Ĥ⁰(G, A)` have the same
cardinality. -/
theorem natCard_groupCohomology_two_eq_natCard_tateCohomology_zero_of_cyclic_general
    (A : Rep k G) (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) :
    Nat.card (groupCohomology A 2) = Nat.card (tateCohomology A 0) := by
  classical
  obtain ⟨eTate⟩ := tateCohomology_zero_iso_general (G := G) (V := A.V) A.ρ
  have hrep : Rep.of A.ρ = A := rfl
  rw [hrep] at eTate
  have eGC : groupCohomology A 2 ≅ (Rep.FiniteCyclicGroup.normHomCompSub A g).homology :=
    Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg 2 (by norm_num)
  have eH : (Rep.FiniteCyclicGroup.normHomCompSub A g).homology ≅
      (Rep.FiniteCyclicGroup.normHomCompSub A g).moduleCatLeftHomologyData.H :=
    ShortComplex.moduleCatHomologyIso _
  exact Nat.card_congr
    ((eGC.toLinearEquiv.trans (eH.toLinearEquiv.trans (cyclicHomologyIso A g hg))).trans
      eTate.symm).toEquiv

end CyclicDegreeTwo

/-- **Periodicity in degree two.** For a finite cyclic group `G` generated by `g` and a `ℤ`-linear representation `A`, the second group cohomology `H²(G,A)` has the same cardinality as the zeroth Tate cohomology `Ĥ⁰(G,A)`: both are the quotient of the `G`-invariants of `A` by the image of the norm map. -/
theorem natCard_groupCohomology_two_eq_natCard_tateCohomology_zero_of_cyclic
    {G : Type} [CommGroup G] [Fintype G] (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g)
    (A : Rep ℤ G) :
    Nat.card (groupCohomology A 2) = Nat.card (tateCohomology A 0) :=
  natCard_groupCohomology_two_eq_natCard_tateCohomology_zero_of_cyclic_general (k := ℤ) A g hg

end Commons.RepresentationTheory.GroupCohomology
