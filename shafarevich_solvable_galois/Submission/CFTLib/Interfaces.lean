/-!
# Shared class-field-theory interfaces (the CFT quadruple)

Mathlib-only statements of the three library results that the shafarevich, erdos and martinet
workspaces consume. The library proves them; consumers ASSUME them as hypotheses until then.
This file is identical in every workspace (module `Submission.CFTLib.Interfaces`). Do not edit it.
-/

open NumberField CategoryTheory

namespace CFTLib

/-- `K/F` is unramified at every finite prime (different ideal is the unit ideal) and every real place
stays real. -/
def IsUnramified (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K] : Prop :=
  differentIdeal (𝓞 F) (𝓞 K) = ⊤ ∧ IsUnramifiedAtInfinitePlaces F K

/-- Every prime of `T` has inertia degree `1` in `K` (for unramified `K/F`: splits completely). -/
def SplitsAt (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) : Prop :=
  ∀ v ∈ T, Ideal.inertiaDegIn v.asIdeal (𝓞 K) = 1

/-- Every ideal class of `K` of `p`-power order lies in the subgroup generated by the classes of the
primes of `K` above `T`. -/
def ClassCond (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K] (p : ℕ)
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) : Prop :=
  ∀ c : ClassGroup (𝓞 K), (∃ k : ℕ, c ^ (p ^ k) = 1) →
    c ∈ Subgroup.closure {d | ∃ w : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
      (∃ v ∈ T, w.asIdeal.LiesOver v.asIdeal) ∧
      d = ClassGroup.mk0 ⟨w.asIdeal, mem_nonZeroDivisors_of_ne_zero w.ne_bot⟩}

/-- `δ_p(F)`. -/
noncomputable def delta (F : Type) [Field F] (p : ℕ) : ℕ :=
  open Classical in if ∃ ζ : F, IsPrimitiveRoot ζ p then 1 else 0

/-- **Shafarevich's bound for finite unramified `p`-extensions** (Roquette's form):
`dim H²(G,𝔽_p) ≤ dim H¹(G,𝔽_p) + r₁ + r₂ − 1 + δ_p(F) + |T|`. -/
def ShafBound : Prop :=
  ∀ (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
    [FiniteDimensional F K] [IsGalois F K] (p : ℕ) [Fact p.Prime]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))),
    IsPGroup p (K ≃ₐ[F] K) → IsUnramified F K → SplitsAt F K T → ClassCond F K p T →
    Module.finrank (ZMod p) (groupCohomology (Rep.trivial (ZMod p) (K ≃ₐ[F] K) (ZMod p)) 2) ≤
      Module.finrank (ZMod p) (groupCohomology (Rep.trivial (ZMod p) (K ≃ₐ[F] K) (ZMod p)) 1) +
        (InfinitePlace.nrRealPlaces F + InfinitePlace.nrComplexPlaces F - 1) + delta F p + T.card

/-- **Existence of the `p`-class field with prescribed splitting** (Hilbert/Furtwängler, `p`-part). -/
def PClassFieldExists : Prop :=
  ∀ (K : Type) [Field K] [NumberField K] (p : ℕ) [Fact p.Prime]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 K)))
    (χ : ClassGroup (𝓞 K) →* Multiplicative (ZMod p)), χ ≠ 1 →
    (∀ v ∈ T, χ (ClassGroup.mk0 ⟨v.asIdeal, mem_nonZeroDivisors_of_ne_zero v.ne_bot⟩) = 1) →
    ∃ (L : Type) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : FiniteDimensional K L),
      IsGalois K L ∧ Module.finrank K L = p ∧ IsUnramified K L ∧
      ∀ v ∈ T, Ideal.inertiaDegIn v.asIdeal (𝓞 L) = 1

/-- `K/F` is maximal among finite Galois unramified `p`-extensions of `F` in which `T` splits. -/
def IsMaximalUnramified (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
    (p : ℕ) (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))) : Prop :=
  ∀ (L : Type) [Field L] [NumberField L] [Algebra F L] [FiniteDimensional F L] [IsGalois F L],
    IsPGroup p (L ≃ₐ[F] L) → IsUnramified F L → SplitsAt F L T → Nonempty (L →ₐ[F] K)

/-- **Maximality gives the class condition** (from `PClassFieldExists` + Galois closure). -/
def MaximalClassCond : Prop :=
  ∀ (F K : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
    [FiniteDimensional F K] [IsGalois F K] (p : ℕ) [Fact p.Prime]
    (T : Finset (IsDedekindDomain.HeightOneSpectrum (𝓞 F))),
    IsPGroup p (K ≃ₐ[F] K) → IsUnramified F K → SplitsAt F K T → IsMaximalUnramified F K p T →
    ClassCond F K p T

/-- **Relative Shafarevich bound** (for infinite towers). `K ⊆ K'` finite Galois unramified `p`-extensions of
`F`, where `K'` contains every unramified abelian `p`-extension of `K`: the inflation image
`H²(Gal(K/F),𝔽_p) → H²(Gal(K'/F),𝔽_p)` has dimension `≤ dim H¹(Gal(K'/F),𝔽_p) + r₁ + r₂ − 1 + δ_p(F)`. -/
def RelShafBound : Prop :=
  ∀ (F K K' : Type) [Field F] [NumberField F] [Field K] [NumberField K] [Field K'] [NumberField K']
    [Algebra F K] [Algebra F K'] [Algebra K K'] [IsScalarTower F K K']
    [FiniteDimensional F K] [FiniteDimensional F K'] [IsGalois F K] [IsGalois F K'] (p : ℕ) [Fact p.Prime],
    IsPGroup p (K' ≃ₐ[F] K') → IsUnramified F K' →
    (∀ (L : Type) [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L],
      (∀ a b : L ≃ₐ[K] L, a * b = b * a) → IsPGroup p (L ≃ₐ[K] L) → IsUnramified K L →
      Nonempty (L →ₐ[K] K')) →
    Module.finrank (ZMod p) (LinearMap.range (groupCohomology.map
        (AlgEquiv.restrictNormalHom K : (K' ≃ₐ[F] K') →* (K ≃ₐ[F] K))
        (𝟙 _ : Rep.res (AlgEquiv.restrictNormalHom K) (Rep.trivial (ZMod p) (K ≃ₐ[F] K) (ZMod p)) ⟶
          Rep.trivial (ZMod p) (K' ≃ₐ[F] K') (ZMod p)) 2).hom) ≤
      Module.finrank (ZMod p) (groupCohomology (Rep.trivial (ZMod p) (K' ≃ₐ[F] K') (ZMod p)) 1) +
        (InfinitePlace.nrRealPlaces F + InfinitePlace.nrComplexPlaces F - 1) + delta F p

/-- **Unramified abelian extensions are bounded by the class number** (Artin reciprocity for the Hilbert class
field, degree half: `[L:K] = [Cl_K : N Cl_L] ≤ h_K`). -/
def UnramifiedAbelianDegreeLe : Prop :=
  ∀ (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L], (∀ a b : L ≃ₐ[K] L, a * b = b * a) → IsUnramified K L →
    Module.finrank K L ≤ Nat.card (ClassGroup (𝓞 K))

/-- **The `p`-class field of a character, in Artin form**: for a nontrivial `χ : Cl(K) → ℤ/p` there is a cyclic
degree-`p` unramified extension `L/K` in which a prime `v` splits (inertia degree `1`) iff `χ([v]) = 1`. -/
def PClassFieldArtin : Prop :=
  ∀ (K : Type) [Field K] [NumberField K] (p : ℕ) [Fact p.Prime]
    (χ : ClassGroup (𝓞 K) →* Multiplicative (ZMod p)), χ ≠ 1 →
    ∃ (L : Type) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : FiniteDimensional K L),
      IsGalois K L ∧ Module.finrank K L = p ∧ IsUnramified K L ∧
      ∀ v : IsDedekindDomain.HeightOneSpectrum (𝓞 K),
        (Ideal.inertiaDegIn v.asIdeal (𝓞 L) = 1 ↔
          χ (ClassGroup.mk0 ⟨v.asIdeal, mem_nonZeroDivisors_of_ne_zero v.ne_bot⟩) = 1)

end CFTLib
