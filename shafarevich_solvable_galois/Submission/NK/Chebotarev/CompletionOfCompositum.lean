namespace NK.Chebotarev
/-- **The completion of a compositum is the compositum of the completions.**

Let `K`, `C` and `L` be number fields with `L` generated over `ℚ` by the images of `K` and `C` (e.g.
`L = K·C`), let `𝔓` be a prime of `𝓞 L`, and let `𝔭`, `𝔮` be primes of `𝓞 K`, `𝓞 C` lying under `𝔓`.
Then the `𝔓`-adic completion of `L` is generated, as a subfield of itself, by the images of the
`𝔭`-adic completion of `K` and the `𝔮`-adic completion of `C` under the canonical maps
`Commons.RingTheory.Henselian.adicCompletionMap`.

Proof sketch.  Both `Set.range (adicCompletionMap 𝔭 𝔓 h𝔭)` and `Set.range (adicCompletionMap 𝔮 𝔓 h𝔮)`
are subfields of `T := 𝔓.adicCompletion L`, and the claim follows from:
(a) the image of `L` under `algebraMap L T` is dense in `T` (a completion is a dense embedding);
(b) that image is the subfield generated by the images of `K` and of `C`, by `hgen`;
(c) the subfield `S` generated by the two images of the completions is finite-dimensional over
    `ℚ_[p]` for the prime `p` below `𝔓` (it is generated by two finite extensions of `ℚ_[p]`,
    equivalently it is the image of the finite-dimensional `ℚ_[p]`-algebra
    `𝔭.adicCompletion K ⊗[ℚ_[p]] 𝔮.adicCompletion C`), hence closed in `T`
    (`Submodule.closed_of_finiteDimensional` run over the complete field `ℚ_[p]`); so `S` contains
    the closure of the dense image of `L`, i.e. all of `T`.  (All finite-dimensionality and
    closedness statements must be run over `ℚ_[p]`, *not* over `ℚ`, since `ℚ_[p]` is infinite
    dimensional over `ℚ`.) -/
theorem CompletionOfCompositum
    (K C L : Type*) [Field K] [Field C] [Field L] [NumberField K] [NumberField C] [NumberField L]
    [Algebra ℚ K] [Algebra ℚ C] [Algebra ℚ L] [Algebra K L] [Algebra C L]
    [IsScalarTower ℚ K L] [IsScalarTower ℚ C L]
    (hgen : IntermediateField.adjoin ℚ ((Set.range (algebraMap K L)) ∪
      (Set.range (algebraMap C L))) = ⊤)
    (𝔓 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers L))
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (h𝔭 : 𝔓.asIdeal.LiesOver 𝔭.asIdeal)
    (𝔮 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers C))
    (h𝔮 : 𝔓.asIdeal.LiesOver 𝔮.asIdeal) :
    Subfield.closure ((Set.range (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔓 h𝔭) :
        Set (𝔓.adicCompletion L)) ∪
      Set.range (Commons.RingTheory.Henselian.adicCompletionMap 𝔮 𝔓 h𝔮)) = ⊤ := by
  -- Abbreviations for the three completions and the two canonical maps.
  let A := 𝔭.adicCompletion K
  let T := 𝔓.adicCompletion L
  let φ : A →+* T := Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔓 h𝔭
  let ψ : (𝔮.adicCompletion C) →+* T := Commons.RingTheory.Henselian.adicCompletionMap 𝔮 𝔓 h𝔮
  let S : Subfield T := Subfield.closure (Set.range φ ∪ Set.range ψ)
  -- (b) the image of `K` (resp. `C`) in the completion of `L` lies in `S`.
  have hK : ∀ k : K, algebraMap L T (algebraMap K L k) ∈ S := by
    intro k
    have h1 : algebraMap L T (algebraMap K L k) = φ (k : A) := by
      rw [IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion (S := L) (v := 𝔓) (K := L)]
      simp only [Function.comp_apply, Algebra.algebraMap_self_apply]
      exact (Commons.RingTheory.Henselian.adicCompletionMap_apply 𝔭 𝔓 h𝔭 k).symm
    rw [h1]
    exact Subfield.subset_closure (Set.mem_union_left _ ⟨k, rfl⟩)
  have hC : ∀ c : C, algebraMap L T (algebraMap C L c) ∈ S := by
    intro c
    have h1 : algebraMap L T (algebraMap C L c) = ψ (c : 𝔮.adicCompletion C) := by
      rw [IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion (S := L) (v := 𝔓) (K := L)]
      simp only [Function.comp_apply, Algebra.algebraMap_self_apply]
      exact (Commons.RingTheory.Henselian.adicCompletionMap_apply 𝔮 𝔓 h𝔮 c).symm
    rw [h1]
    exact Subfield.subset_closure (Set.mem_union_right _ ⟨c, rfl⟩)
  -- (c) `S` is a finite-dimensional `𝔭.adicCompletion K`-subspace of `T`, hence closed.
  have hclosed : IsClosed (S : Set T) := by
    letI : Algebra A T := φ.toAlgebra
    have hrange : Set.range (algebraMap A T) = Set.range φ := rfl
    have hcont : Continuous (algebraMap A T) := by
      change Continuous (φ : A → T)
      exact Commons.RingTheory.Henselian.adicCompletionMap_continuous 𝔭 𝔓 h𝔭
    letI : ContinuousSMul A T := continuousSMul_of_algebraMap A T hcont
    letI hfin : Module.Finite A T := module_finite_adicCompletion 𝔭 𝔓 h𝔭
    letI : FiniteDimensional A T := hfin
    let S' : IntermediateField A T := IntermediateField.adjoin A (Set.range φ ∪ Set.range ψ)
    have hS' : S'.toSubfield = S := by
      dsimp only [S', S]
      rw [IntermediateField.adjoin_toSubfield, hrange]
      have hset : Set.range φ ∪ (Set.range φ ∪ Set.range ψ) = Set.range φ ∪ Set.range ψ := by
        rw [← Set.union_assoc, Set.union_self]
      exact congrArg Subfield.closure hset
    rw [← hS']
    exact Submodule.closed_of_finiteDimensional (𝕜 := A) S'.toSubalgebra.toSubmodule
  -- (b) again: the dense image of `L` is generated by the images of `K` and of `C`, hence
  -- contained in `S` (this is where `hgen` is used).
  have hrangeL : Set.range (algebraMap L T) ⊆ (S : Set T) := by
    have hgen_sub : Subfield.closure (Set.range (algebraMap ℚ L) ∪
        (Set.range (algebraMap K L) ∪ Set.range (algebraMap C L))) = (⊤ : Subfield L) := by
      rw [← IntermediateField.adjoin_toSubfield (F := ℚ)
        (S := Set.range (algebraMap K L) ∪ Set.range (algebraMap C L)), hgen]
      rfl
    have hU : (⊤ : Subfield L) ≤ Subfield.comap (algebraMap L T) S := by
      rw [← hgen_sub, Subfield.closure_le]
      rintro x (hx | hx | hx)
      · obtain ⟨q, rfl⟩ := hx
        show algebraMap L T (algebraMap ℚ L q) ∈ S
        rw [IsScalarTower.algebraMap_apply ℚ K L]
        exact hK _
      · obtain ⟨k, rfl⟩ := hx
        exact hK k
      · obtain ⟨c, rfl⟩ := hx
        exact hC c
    rintro _ ⟨l, rfl⟩
    exact (Subfield.mem_comap).mp (hU (Subfield.mem_top l))
  -- (a) the image of `L` is dense, and a closed subfield containing a dense set is everything.
  show S = ⊤
  rw [eq_top_iff]
  intro x _
  have hdense : DenseRange (algebraMap L T) :=
    IsDedekindDomain.HeightOneSpectrum.denseRange_algebraMap L 𝔓
  have hx : x ∈ closure (Set.range (algebraMap L T)) := by
    rw [Dense.closure_eq hdense]
    trivial
  exact closure_minimal hrangeL hclosed hx

end NK.Chebotarev
