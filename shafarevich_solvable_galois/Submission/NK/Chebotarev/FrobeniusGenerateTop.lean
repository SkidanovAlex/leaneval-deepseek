/-!
# The Frobenius elements generate the Galois group

For a finite Galois extension `L / K` of number fields, the Frobenius elements at the finite
places of `K` generate `Gal(L/K)`:

`Subgroup.closure {σ | ∃ p, IsFrobAtPrime p σ} = ⊤`.

The proof does not use the full Čebotarev density theorem.  Let `H` be the subgroup generated by
all Frobenius elements, and let `F` be its fixed field.  Conjugation invariance of the Frobenius
(`IsFrobAtConj`) shows that `H` is normal, so `F / K` is Galois.  The key observation is that the
Frobenius of *every* prime of `K` becomes trivial on `F`: if `P` is a prime of `L` above a prime
`q` of `F`, the Frobenius `σ` at `P` lies in `H` by construction, hence acts trivially on `F`, and
the restriction of a Frobenius is a Frobenius (`IsFrobAtRestrictNormalHom`), so `1` is a Frobenius
at `q`.  At an unramified prime `q`, the order of a Frobenius is the inertia degree
(`IsFrobAtOrderOfEqInertiaDeg`), so `q` then has residue degree one, and the fundamental identity
forces `p` to split completely in `F`.  Consequently every prime of `K` that is unramified in `F`
splits completely in `F`.  But by `ExistsUnramifiedPrimeNotSplit` an extension of degree `> 1` has
an unramified prime which does *not* split completely.  Hence `[F : K] = 1`, i.e. `F = K` and
`H = ⊤`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open IsDedekindDomain

namespace NK.Chebotarev

/-- **Transitivity of `LiesOver` for ideals.** -/
lemma liesOver_trans {A B C : Type*} [CommRing A] [CommRing B] [CommRing C] [Algebra A B]
    [Algebra B C] [Algebra A C] [IsScalarTower A B C] {𝔓 : Ideal C} {P : Ideal B} {p : Ideal A}
    (h1 : 𝔓.LiesOver P) (h2 : P.LiesOver p) : 𝔓.LiesOver p := by
  haveI := h1
  haveI := h2
  exact Ideal.LiesOver.trans 𝔓 P p

/-- **Conjugation of a Frobenius at a finite place.**  If `σ` is a Frobenius at some prime above
`p`, then so is every conjugate of `σ`. -/
lemma isFrobAtPrime_conj {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    {p : PrimeIdeal K} {σ : Gal(L/K)} (h : IsFrobAtPrime (K := K) (L := L) p σ)
    (τ : Gal(L/K)) : IsFrobAtPrime (K := K) (L := L) p (τ * σ * τ⁻¹) := by
  obtain ⟨P, hP, hσ⟩ := h
  refine ⟨τ • P, ?_, IsFrobAtConj hσ⟩
  rw [smul_primeIdeal_asIdeal]
  exact Commons.NumberTheory.NumberField.liesOver_map_galRestrict p P τ

theorem FrobeniusGenerateTop {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    Subgroup.closure {σ : Gal(L/K) | ∃ p : NK.Chebotarev.PrimeIdeal K,
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ} = ⊤ := by
  classical
  set S : Set Gal(L/K) := {σ | ∃ p : PrimeIdeal K, IsFrobAtPrime (K := K) (L := L) p σ} with hSdef
  set H : Subgroup Gal(L/K) := Subgroup.closure S with hHdef
  have hconj : ∀ ⦃σ : Gal(L/K)⦄, σ ∈ S → ∀ τ : Gal(L/K), τ * σ * τ⁻¹ ∈ S := by
    intro σ hσ τ
    show ∃ p : PrimeIdeal K, IsFrobAtPrime (K := K) (L := L) p (τ * σ * τ⁻¹)
    have hσ' : ∃ p : PrimeIdeal K, IsFrobAtPrime (K := K) (L := L) p σ := hσ
    obtain ⟨p, hp⟩ := hσ'
    exact ⟨p, isFrobAtPrime_conj hp τ⟩
  -- `S` is invariant under conjugation, so its closure is the normal closure of `S`
  have hconj_sub : Group.conjugatesOfSet S ⊆ S := by
    intro x hx
    obtain ⟨y, hy, hc⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨c, hc'⟩ := isConj_iff.mp hc
    rw [← hc']
    exact hconj hy c
  have hclosure_eq : Subgroup.normalClosure S = Subgroup.closure S :=
    le_antisymm (Subgroup.closure_mono hconj_sub) Subgroup.closure_le_normalClosure
  have hHnormal : H.Normal := by
    rw [hHdef]
    have hnorm : (Subgroup.normalClosure S).Normal := inferInstance
    rwa [hclosure_eq] at hnorm
  haveI : H.Normal := hHnormal
  set F : IntermediateField K L := IntermediateField.fixedField H with hFdef
  haveI hFgal : IsGalois K F := by rw [hFdef]; infer_instance
  -- ## Every prime of `F` has trivial Frobenius over `K`
  have key : ∀ (p : PrimeIdeal K) (q : PrimeIdeal F), q.asIdeal.LiesOver p.asIdeal →
      IsFrobAt (K := K) (L := F) q 1 := by
    intro p q hq
    obtain ⟨P0⟩ := (inferInstance : Nonempty (q.asIdeal.primesOver (NumberField.RingOfIntegers L)))
    let P : PrimeIdeal L := ⟨P0.1, P0.2.1, Ideal.ne_bot_of_mem_primesOver q.ne_bot P0.2⟩
    have hPq : P.asIdeal.LiesOver q.asIdeal := P0.2.2
    have hPp : P.asIdeal.LiesOver p.asIdeal := liesOver_trans hPq hq
    obtain ⟨σ, hσ⟩ := exists_isFrobAt (K := K) (L := L) p P hPp
    have hσS : σ ∈ S := by
      rw [hSdef]
      exact ⟨p, P, hPp, hσ⟩
    have hσH : σ ∈ H := Subgroup.subset_closure hσS
    have hσfix : σ ∈ (IntermediateField.fixedField H).fixingSubgroup := by
      rw [IntermediateField.fixingSubgroup_fixedField H]
      exact hσH
    have hone : AlgEquiv.restrictNormalHom (K₁ := L) F σ = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker]
      exact hσfix
    have hfrob := IsFrobAtRestrictNormalHom (K := K) (M := L) F hPp hσ
    have hq_eq : P.under (NumberField.RingOfIntegers F) = q :=
      IsDedekindDomain.HeightOneSpectrum.ext
        (by rw [HeightOneSpectrum.under_asIdeal]; exact hPq.over.symm)
    rw [hq_eq, hone] at hfrob
    simpa using hfrob
  -- ## Unramified primes split completely in `F`
  have hsplit : ∀ p : PrimeIdeal K, (∀ q : PrimeIdeal F, q.asIdeal.LiesOver p.asIdeal →
      q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) →
      (p.asIdeal.primesOver (NumberField.RingOfIntegers F)).ncard = Module.finrank K F := by
    intro p hunr
    obtain ⟨q0⟩ := (inferInstance : Nonempty (p.asIdeal.primesOver (NumberField.RingOfIntegers F)))
    let q : PrimeIdeal F := ⟨q0.1, q0.2.1, Ideal.ne_bot_of_mem_primesOver p.ne_bot q0.2⟩
    have hq : q.asIdeal.LiesOver p.asIdeal := q0.2.2
    haveI := hq
    have he1 : q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1 := hunr q hq
    have hf1 : q.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) = 1 := by
      have h := IsFrobAtOrderOfEqInertiaDeg (K := K) (L := F) hq he1 (key p q hq)
      rw [orderOf_one] at h
      exact h.symm
    rw [Commons.NumberTheory.NumberField.ncard_primesOver_eq_finrank_iff_splitCompletely p]
    refine ⟨?_, ?_⟩
    · rw [Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal q.asIdeal (F ≃ₐ[K] F)]
      exact he1
    · rw [Ideal.inertiaDegIn_eq_inertiaDeg p.asIdeal q.asIdeal (F ≃ₐ[K] F)]
      exact hf1
  -- ## The degree of `F / K` is one
  have hfin1 : Module.finrank K F = 1 := by
    by_contra hne
    have hlt : 1 < Module.finrank K F := by
      have hpos : 0 < Module.finrank K F := Module.finrank_pos
      omega
    obtain ⟨p, hunr, hnotsplit⟩ := ExistsUnramifiedPrimeNotSplit (K := K) (L := F) hlt
    exact absurd (hsplit p hunr) (ne_of_lt hnotsplit)
  have hFbot : F = ⊥ := IntermediateField.finrank_eq_one_iff.mp hfin1
  -- ## Hence `H = ⊤`
  have hfixed : IntermediateField.fixedField H = ⊥ := by rw [← hFdef]; exact hFbot
  have h1 : (IntermediateField.fixedField H).fixingSubgroup = ⊤ := by
    rw [hfixed, IntermediateField.fixingSubgroup_bot]
  rw [IntermediateField.fixingSubgroup_fixedField H] at h1
  exact h1

end NK.Chebotarev
