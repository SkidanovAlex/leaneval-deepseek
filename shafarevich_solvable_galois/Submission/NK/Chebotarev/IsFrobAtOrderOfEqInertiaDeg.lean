namespace NK.Chebotarev

open IsDedekindDomain

/-- **The order of a Frobenius element is the inertia degree.**  Let `L/K` be a finite Galois
extension of number fields, `P` a prime of `𝓞 L` over `p` of `𝓞 K`, unramified over `p`.  Then any
Frobenius element `σ ∈ Gal(L/K)` at `P` has order equal to the inertia degree `f(P|p)`.

Equivalently: the decomposition group of an unramified prime is cyclic, generated by the Frobenius,
and its order is the inertia degree. -/
theorem IsFrobAtOrderOfEqInertiaDeg {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    {p : NK.Chebotarev.PrimeIdeal K} {P : NK.Chebotarev.PrimeIdeal L}
    (hP : P.asIdeal.LiesOver p.asIdeal)
    (hunr : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1)
    {σ : Gal(L/K)} (h : NK.Chebotarev.IsFrobAt P σ) :
    orderOf σ = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) := by
  -- A Frobenius at `P` stabilises `P`.
  have hstab : Ideal.map (galRestrict (NumberField.RingOfIntegers K) K L
      (NumberField.RingOfIntegers L) σ : NumberField.RingOfIntegers L →+*
        NumberField.RingOfIntegers L) P.asIdeal = P.asIdeal := by
    have h2 := Ideal.map_comap_eq_self_of_equiv (galRestrict (NumberField.RingOfIntegers K) K L
      (NumberField.RingOfIntegers L) σ) P.asIdeal
    rw [show Ideal.comap ((galRestrict (NumberField.RingOfIntegers K) K L
        (NumberField.RingOfIntegers L)) σ) P.asIdeal = P.asIdeal from h.comap_eq] at h2
    exact h2
  exact Commons.NumberTheory.NumberField.orderOf_frobenius_eq_inertiaDeg p P hP hunr σ hstab
    (fun x => h.mk_apply hP x)

end NK.Chebotarev
