import Mathlib
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

universe u

set_option linter.style.haveILetI false

/-!
# A quadratic extension of `ℚ` is generated by an element whose square is rational

Let `K ⊆ L` be an intermediate field of a field extension `L / ℚ` with `[K : ℚ] = 2`.  Then there
is `y ∈ K` with `y ∉ ℚ`, `y ^ 2 = d` for some `d : ℚ`, and `ℚ(y) = K`.

The mathematical content is that a quadratic extension is obtained by adjoining a square root.
Concretely, any `α ∈ K \ ℚ` has a minimal polynomial `X ^ 2 + b X + c` over `ℚ`; completing the square
`(α + b/2) ^ 2 = b ^ 2 / 4 - c` exhibits the required generator.  Equivalently, scaling by two,
`y = 2 α + b` satisfies `y ^ 2 = b ^ 2 - 4 c`, with `ℚ(y) = ℚ(α) = K`.

The proof is split: `exists_sq_rat_of_finrank_two` handles an abstract field `F` with `[F : ℚ] = 2`
(where no instance diamonds arise), and the main theorem transfers the element found there from the
intermediate field `↥K` back to `L`.
-/

namespace NK.Chebotarev

open Polynomial IntermediateField

/-- **Auxiliary.** A field `F` of degree two over `ℚ` contains a non-rational element whose square
is rational. -/
theorem exists_sq_rat_of_finrank_two {F : Type u} [Field F] [Algebra ℚ F]
    (hF : Module.finrank ℚ F = 2) :
    ∃ (y : F) (d : ℚ), y ∉ Set.range (algebraMap ℚ F) ∧ y ^ 2 = algebraMap ℚ F d := by
  have hfin : Module.Finite ℚ F := Module.finite_of_finrank_pos (by rw [hF]; norm_num)
  haveI := hfin
  have htopne : (⊤ : IntermediateField ℚ F) ≠ ⊥ := by
    intro h
    have : Module.finrank ℚ (⊤ : IntermediateField ℚ F) = 1 := by
      rw [h]; exact IntermediateField.finrank_bot
    rw [IntermediateField.finrank_top', hF] at this
    norm_num at this
  obtain ⟨α, -, hαbot⟩ :
      ∃ α : F, α ∈ (⊤ : IntermediateField ℚ F) ∧ α ∉ (⊥ : IntermediateField ℚ F) :=
    (SetLike.lt_iff_le_and_exists.mp (lt_of_le_of_ne bot_le (Ne.symm htopne))).2
  have hαrange : α ∉ Set.range (algebraMap ℚ F) := by
    simpa only [IntermediateField.mem_bot] using hαbot
  have hint : IsIntegral ℚ α := IsIntegral.of_finite ℚ α
  set p : ℚ[X] := minpoly ℚ α with hp
  have hpdeg : p.natDegree = 2 := by
    have h2 : 2 ≤ p.natDegree := by
      rw [hp]; exact (minpoly.two_le_natDegree_iff hint).mpr hαrange
    have hdvd : p.natDegree ∣ 2 := by
      have h1 : Module.finrank ℚ ↥ℚ⟮α⟯ = p.natDegree := by
        rw [hp]; exact IntermediateField.adjoin.finrank hint
      have h2' : Module.finrank ℚ ↥ℚ⟮α⟯ ∣ 2 := by
        have := IntermediateField.finrank_dvd_of_le_right (le_top : ℚ⟮α⟯ ≤ (⊤ : IntermediateField ℚ F))
        rwa [IntermediateField.finrank_top', hF] at this
      rwa [h1] at h2'
    exact le_antisymm (Nat.le_of_dvd (by norm_num) hdvd) h2
  have hmonic : p.Monic := by rw [hp]; exact minpoly.monic hint
  have hpeq : p = X ^ 2 + C (p.coeff 1) * X + C (p.coeff 0) := by
    have hlt : p.natDegree < 3 := by rw [hpdeg]; norm_num
    conv_lhs => rw [Polynomial.as_sum_range_C_mul_X_pow' _ hlt]
    rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_one]
    have hc2 : p.coeff 2 = 1 := by
      rw [← hpdeg, Polynomial.coeff_natDegree, hmonic.leadingCoeff]
    simp only [pow_zero, pow_one, mul_one, hc2, map_one, one_mul]
    ring
  have haeval : α ^ 2 + algebraMap ℚ F (p.coeff 1) * α + algebraMap ℚ F (p.coeff 0) = 0 := by
    have h := minpoly.aeval ℚ α
    rw [← hp, hpeq] at h
    simpa using h
  set y : F := algebraMap ℚ F (2:ℚ) * α + algebraMap ℚ F (p.coeff 1) with hy
  set d : ℚ := (p.coeff 1)^2 - 4 * p.coeff 0 with hddef
  have hynotmem : y ∉ Set.range (algebraMap ℚ F) := by
    intro h
    have hy_bot : y ∈ (⊥ : IntermediateField ℚ F) := IntermediateField.mem_bot.mpr h
    apply hαbot
    have h2α : algebraMap ℚ F (2:ℚ) * α ∈ (⊥ : IntermediateField ℚ F) := by
      have : algebraMap ℚ F (2:ℚ) * α = y - algebraMap ℚ F (p.coeff 1) := by rw [hy]; ring
      rw [this]
      exact sub_mem hy_bot (IntermediateField.mem_bot.mpr ⟨p.coeff 1, rfl⟩)
    have hxy : α = algebraMap ℚ F (1/2:ℚ) * (algebraMap ℚ F (2:ℚ) * α) := by
      rw [← mul_assoc, ← map_mul]; norm_num
    rw [hxy]
    exact mul_mem (IntermediateField.mem_bot.mpr ⟨1/2, rfl⟩) h2α
  have hysq : y ^ 2 = algebraMap ℚ F d := by
    rw [hy, hddef]
    have h2 : algebraMap ℚ F (2:ℚ) = 2 := by norm_num
    have hd : algebraMap ℚ F ((p.coeff 1)^2 - 4*p.coeff 0)
        = (algebraMap ℚ F (p.coeff 1))^2 - 4 * algebraMap ℚ F (p.coeff 0) := by
      rw [map_sub, map_mul, map_pow]; norm_num
    rw [h2, hd]
    linear_combination 4 * haeval
  exact ⟨y, d, hynotmem, hysq⟩

/-- A degree-two intermediate field of `L / ℚ` is generated over `ℚ` by an element `y` which is not
rational and whose square is rational. -/
theorem exists_generator_sq_rational {L : Type u} [Field L] [Algebra ℚ L] (K : IntermediateField ℚ L)
    (hK : Module.finrank ℚ K = 2) :
    ∃ (y : L) (d : ℚ), y ∈ K ∧ y ∉ Set.range (algebraMap ℚ L) ∧
      y ^ 2 = algebraMap ℚ L d ∧ IntermediateField.adjoin ℚ ({y} : Set L) = K := by
  letI halg : Algebra ℚ (↥K) := IntermediateField.algebra' (R' := ℚ) K
  obtain ⟨y, d, hynmem, hysq⟩ := exists_sq_rat_of_finrank_two (F := ↥K) hK
  haveI hfin : Module.Finite ℚ K := Module.finite_of_finrank_pos (by rw [hK]; norm_num)
  have hyK : (y : L) ∈ K := y.2
  have hynmemL : (y : L) ∉ Set.range (algebraMap ℚ L) := by
    intro h
    rw [Set.mem_range] at h
    obtain ⟨q, hq⟩ := h
    apply hynmem
    rw [Set.mem_range]
    refine ⟨q, ?_⟩
    rw [IsScalarTower.algebraMap_apply ℚ ↥K L q, IntermediateField.algebraMap_apply] at hq
    exact Subtype.coe_injective hq
  have hysqL : (y : L) ^ 2 = algebraMap ℚ L d := by
    change (IntermediateField.val K) y ^ 2 = algebraMap ℚ L d
    have h1 := congrArg (IntermediateField.val K) hysq
    rw [map_pow, (IntermediateField.val K).commutes d] at h1
    exact h1
  have hint : IsIntegral ℚ (y : L) := by
    refine ⟨X ^ 2 - C d, monic_X_pow_sub_C d (by norm_num), ?_⟩
    show (aeval (y : L)) (X ^ 2 - C d) = 0
    simp only [map_sub, map_pow, aeval_X, aeval_C]
    rw [hysqL, sub_self]
  have hmin2 : (minpoly ℚ (y : L)).natDegree = 2 := by
    have h2 : 2 ≤ (minpoly ℚ (y : L)).natDegree :=
      (minpoly.two_le_natDegree_iff hint).mpr hynmemL
    have hle : (minpoly ℚ (y : L)).natDegree ≤ 2 := by
      have hdvd : minpoly ℚ (y : L) ∣ X ^ 2 - C d := by
        apply minpoly.dvd
        simp only [map_sub, map_pow, aeval_X, aeval_C]
        rw [hysqL, sub_self]
      have := natDegree_le_of_dvd hdvd (monic_X_pow_sub_C d (by norm_num)).ne_zero
      rwa [natDegree_X_pow_sub_C] at this
    omega
  have hle : ℚ⟮(y : L)⟯ ≤ K :=
    IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hyK)
  have hadj : IntermediateField.adjoin ℚ ({(y : L)} : Set L) = K := by
    apply IntermediateField.eq_of_le_of_finrank_eq hle
    rw [IntermediateField.adjoin.finrank hint, hmin2, hK]
  exact ⟨(y : L), d, hyK, hynmemL, hysqL, hadj⟩

end NK.Chebotarev
