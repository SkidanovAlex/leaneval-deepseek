/-!
# Kronecker–Weber for Galois extensions of exponent two

Let `L/ℚ` be a finite Galois extension whose Galois group has exponent `2` (every element is an
involution).  Then `L` is a multiquadratic field, and every quadratic field is contained in a
cyclotomic field; hence `L` is a `NK.Chebotarev.CyclotomicModel`.

The proof has three inputs, all independent of the present file:

* `NK.Chebotarev.exists_index_two_subgroups` (pure finite group theory): a finite group of
  exponent two is `(ℤ/2)^r`, and the `r` coordinate hyperplanes are index-two subgroups with
  trivial intersection;
* `NK.Chebotarev.exists_common_sqrt` (arithmetic of cyclotomic fields): finitely many rationals
  have square roots in one common cyclotomic field;
* `NK.Chebotarev.exists_generator_sq_rational` and
  `NK.Chebotarev.exists_injective_algHom_of_sq_generators` (linear algebra): a quadratic
  extension of `ℚ` is generated by a square root of a rational, and a field generated by `r`
  such square roots of degree `2^r` embeds into any field in which the same rationals have
  square roots.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped IntermediateField

universe u

namespace NK.Chebotarev

/-! ## Galois-theoretic bookkeeping -/

/-- **The fixed subgroup of a supremum of intermediate fields is the infimum of the fixed
subgroups.**  (`IntermediateField.fixingSubgroup` is antitone, and this is the corresponding
statement for suprema.) -/
theorem IntermediateField.fixingSubgroup_iSup {F E : Type*} [Field F] [Field E] [Algebra F E]
    {ι : Type*} (K : ι → IntermediateField F E) :
    (⨆ i, K i).fixingSubgroup = ⨅ i, (K i).fixingSubgroup := by
  refine le_antisymm ?_ ?_
  · intro σ hσ
    rw [Subgroup.mem_iInf]
    intro i
    exact IntermediateField.fixingSubgroup_le (le_iSup K i) hσ
  · intro σ hσ
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have h1 : (⨆ i, K i) ≤ IntermediateField.fixedField (Subgroup.zpowers σ) := by
      apply iSup_le
      intro i
      rw [IntermediateField.le_iff_le, Subgroup.zpowers_le]
      exact (Subgroup.mem_iInf.mp hσ) i
    exact (IntermediateField.mem_fixedField_iff _ x).mp (h1 hx) σ (Subgroup.mem_zpowers σ)

/-- **An index-two subgroup has a quadratic fixed field.** -/
theorem finrank_fixedField_eq_two {L : Type u} [Field L] [Algebra ℚ L] [FiniteDimensional ℚ L]
    [IsGalois ℚ L] (H : Subgroup Gal(L/ℚ)) (hH : Nat.card (Gal(L/ℚ) ⧸ H) = 2) :
    Module.finrank ℚ ↥(IntermediateField.fixedField H) = 2 := by
  set K := IntermediateField.fixedField H with hK
  have h1 : Module.finrank ℚ L = Nat.card Gal(L/ℚ) := (IsGalois.card_aut_eq_finrank ℚ L).symm
  have h2 : Module.finrank ↥K L = Nat.card H := IntermediateField.finrank_fixedField_eq_card H
  have h3 : Module.finrank ℚ L = Module.finrank ℚ ↥K * Module.finrank ↥K L :=
    (Module.finrank_mul_finrank ℚ ↥K L).symm
  have h4 : Nat.card Gal(L/ℚ) = Nat.card (Gal(L/ℚ) ⧸ H) * Nat.card H :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup H
  have h5 : 0 < Nat.card H := by rw [← h2]; exact Module.finrank_pos
  have h6 : Module.finrank ℚ ↥K * Nat.card H = 2 * Nat.card H := by
    rw [← h2, ← h3, h1, h4, hH, ← h2]
  exact Nat.mul_right_cancel h5 h6

/-- **The algebra generated by a set equals the field generated by it**, for algebraic generators:
if `K/ℚ` is finite dimensional, the `IntermediateField` generated by `S` is `⊤` exactly when the
`Subalgebra` generated by `S` is `⊤`.  (A finite-dimensional `ℚ`-subalgebra of a field is a field,
so it is closed under inverses.) -/
theorem algebra_adjoin_eq_top_of_intermediateField_adjoin_eq_top {K : Type*} [Field K]
    [Algebra ℚ K] [FiniteDimensional ℚ K] {S : Set K}
    (h : IntermediateField.adjoin ℚ S = ⊤) : Algebra.adjoin ℚ S = ⊤ := by
  have hinv : ∀ x ∈ Algebra.adjoin ℚ S, x⁻¹ ∈ Algebra.adjoin ℚ S := by
    haveI : Algebra.IsIntegral ℚ ↥(Algebra.adjoin ℚ S) :=
      Algebra.IsIntegral.adjoin (fun x _ => IsIntegral.of_finite ℚ x)
    intro x hx
    exact Algebra.IsIntegral.inv_mem hx
  rw [← IntermediateField.adjoin_eq_algebra_adjoin ℚ S hinv, h,
    IntermediateField.top_toSubalgebra]

/-! ## The theorem -/

theorem KroneckerWeberExponentTwo {L : Type u} [Field L] [NumberField L] [IsGalois ℚ L]
    (h : ∀ g : Gal(L/ℚ), g * g = 1) :
    ∃ (n : ℕ) (_ : 0 < n), Nonempty (NK.Chebotarev.CyclotomicModel.{u} L n) := by
  haveI : Finite Gal(L/ℚ) := by
    apply Nat.finite_of_card_ne_zero
    rw [IsGalois.card_aut_eq_finrank]
    exact (Module.finrank_pos).ne'
  obtain ⟨r, H, hHinf, hHidx, hGcard⟩ := exists_index_two_subgroups h
  have hdimL : Module.finrank ℚ L = 2 ^ r := by
    rw [← IsGalois.card_aut_eq_finrank ℚ L, hGcard]
  -- the quadratic subfields of `L`
  set K : Fin r → IntermediateField ℚ L := fun i => IntermediateField.fixedField (H i) with hKdef
  have hKfin : ∀ i, Module.finrank ℚ ↥(K i) = 2 := fun i => finrank_fixedField_eq_two (H i) (hHidx i)
  -- a generator of each quadratic subfield, whose square is rational
  choose y d hyK hynot hysq hyadj using fun i => exists_generator_sq_rational (K i) (hKfin i)
  have hsup : (⨆ i, K i) = ⊤ := by
    rw [← IsGalois.fixedField_fixingSubgroup (⨆ i, K i), IntermediateField.fixingSubgroup_iSup]
    have hFix : (fun i => (K i).fixingSubgroup) = H := by
      funext i
      show (IntermediateField.fixedField (H i)).fixingSubgroup = H i
      exact IntermediateField.fixingSubgroup_fixedField (H i)
    rw [hFix, hHinf, IntermediateField.fixedField_bot]
  have hgen1 : IntermediateField.adjoin ℚ (Set.range y) = ⊤ := by
    rw [eq_top_iff, ← hsup]
    apply iSup_le
    intro i
    rw [← hyadj i, IntermediateField.adjoin_le_iff]
    exact fun z hz => IntermediateField.subset_adjoin ℚ (Set.range y) (by
      rw [Set.mem_singleton_iff] at hz
      exact ⟨i, hz.symm⟩)
  have hgen : Algebra.adjoin ℚ (Set.range y) = ⊤ :=
    algebra_adjoin_eq_top_of_intermediateField_adjoin_eq_top hgen1
  -- a cyclotomic field containing square roots of all the `d i`
  obtain ⟨S⟩ := (show Nonempty (CommonSqrtInCyclotomic.{u} r d) from exists_common_sqrt r d)
  -- fix the canonical `ℚ`-algebra structure on `S.F`, so that the instances agree with the ones
  -- used by `CyclotomicModel`
  letI hCanF : Algebra ℚ S.F :=
    @DivisionRing.toRatAlgebra S.F S.fieldF.toDivisionRing S.numberFieldF.to_charZero
  have hA : S.algebraF = hCanF := Subsingleton.elim _ _
  have hcyc : IsCyclotomicExtension {S.n} ℚ S.F := hA ▸ S.cycloF
  have hsS : ∀ i, S.s i ^ 2 = algebraMap ℚ S.F (d i) := fun i => hA ▸ S.s_sq i
  obtain ⟨φ, hφ⟩ := exists_injective_algHom_of_sq_generators (K := L) (F := S.F) r d y S.s
    hysq hsS hgen hdimL
  refine ⟨S.n, S.hn, ?_⟩
  exact ⟨{ F := S.F, fieldF := S.fieldF, numberFieldF := S.numberFieldF, cyclotomicF := hcyc,
           E := φ.fieldRange,
           galoisE := IsGalois.of_algEquiv φ.equivFieldRange,
           equiv := φ.equivFieldRange }⟩

end NK.Chebotarev
