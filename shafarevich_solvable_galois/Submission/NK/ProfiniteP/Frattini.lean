/-!
# The Frattini subgroup of a topological group

For a topological group `G` and a natural number `p` we define the (`p`-)Frattini subgroup

  `frattiniSubgroup p G = closure (⟨{g ^ p}⟩ ⊔ [G, G])`,

the closed normal subgroup topologically generated by the `p`-th powers and the commutators.
For a pro-`p` group with `p` prime this is the classical Frattini subgroup, and the quotient
`G ⧸ frattiniSubgroup p G` is the maximal elementary abelian `p`-quotient of `G`; it is an
`𝔽_p`-vector space whose dimension is `frattiniRank p G`, the minimal number of topological
generators of `G` (see `Generation.lean`).

## Main definitions

* `powSubgroup p G` : the subgroup generated by the `p`-th powers of `G`.
* `frattiniSubgroup p G` : the topological closure of `powSubgroup p G ⊔ commutator G`.
* `frattiniRank p G` : the `𝔽_p`-dimension of `G ⧸ frattiniSubgroup p G`.

## Main results

* `frattiniSubgroup_le` : universal property : any closed subgroup containing the `p`-th
  powers and the commutators contains `frattiniSubgroup p G`.
* `frattiniSubgroup_quotient_commutative`, `frattiniSubgroup_quotient_pow_eq_one` : the
  quotient is elementary abelian of exponent `p`.
-/

open Subgroup
open scoped IsMulCommutative

universe u v

namespace NK.ProfiniteP

/-- The subgroup of `G` generated by the `p`-th powers of all elements of `G`. -/
def powSubgroup (p : ℕ) (G : Type u) [Group G] : Subgroup G :=
  Subgroup.closure (Set.range fun g : G => g ^ p)

theorem mem_powSubgroup {p : ℕ} {G : Type u} [Group G] {g : G} : g ^ p ∈ powSubgroup p G :=
  Subgroup.subset_closure ⟨g, rfl⟩

/-- The subgroup generated by the `p`-th powers is normal. -/
theorem powSubgroup_normal (p : ℕ) (G : Type u) [Group G] : (powSubgroup p G).Normal :=
  Commons.GroupTheory.PGroup.closure_range_pow_normal

instance instPowSubgroupNormal (p : ℕ) (G : Type u) [Group G] : (powSubgroup p G).Normal :=
  powSubgroup_normal p G

section Topological

variable {p : ℕ} {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

/-- The **Frattini subgroup** `Φ_p(G)` of a topological group: the closure of the subgroup
generated by the `p`-th powers and by the commutators of `G`. -/
@[reducible]
def frattiniSubgroup (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    Subgroup G :=
  (powSubgroup p G ⊔ commutator G).topologicalClosure

theorem frattiniSubgroup_coe (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] :
    (frattiniSubgroup p G : Set G) =
      _root_.closure ((powSubgroup p G ⊔ commutator G : Subgroup G) : Set G) := rfl

/-- The Frattini subgroup is closed. -/
theorem frattiniSubgroup_isClosed (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : IsClosed (frattiniSubgroup p G : Set G) :=
  Subgroup.isClosed_topologicalClosure _

instance (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G] [IsTopologicalGroup G] :
    (frattiniSubgroup p G).Normal :=
  Subgroup.is_normal_topologicalClosure _

theorem powSubgroup_le_frattiniSubgroup (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : powSubgroup p G ≤ frattiniSubgroup p G :=
  le_trans le_sup_left (Subgroup.le_topologicalClosure _)

theorem commutator_le_frattiniSubgroup (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : commutator G ≤ frattiniSubgroup p G :=
  le_trans le_sup_right (Subgroup.le_topologicalClosure _)

/-- **Universal property of the Frattini subgroup**: every closed subgroup of `G` that contains
all `p`-th powers and the commutator subgroup contains `frattiniSubgroup p G`. -/
theorem frattiniSubgroup_le {N : Subgroup G} (hN : IsClosed (N : Set G))
    (hp : powSubgroup p G ≤ N) (hc : commutator G ≤ N) : frattiniSubgroup p G ≤ N :=
  Subgroup.topologicalClosure_minimal _ (sup_le hp hc) hN

/-- The quotient of `G` by its Frattini subgroup is abelian. -/
theorem frattiniSubgroup_quotient_commutative (p : ℕ) (G : Type u) [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] :
    IsMulCommutative (G ⧸ frattiniSubgroup p G) :=
  (Subgroup.Normal.quotient_commutative_iff_commutator_le).mpr
    (commutator_le_frattiniSubgroup p G)

/-- The quotient of `G` by its Frattini subgroup has exponent `p`. -/
theorem frattiniSubgroup_quotient_pow_eq_one (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (x : G ⧸ frattiniSubgroup p G) : x ^ p = 1 := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (frattiniSubgroup p G) x
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact powSubgroup_le_frattiniSubgroup p G mem_powSubgroup

end Topological

end NK.ProfiniteP

namespace NK.ProfiniteP

section Rank

variable {p : ℕ} {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]

instance instAddCommGroupFrattiniQuotient (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] : AddCommGroup (Additive (G ⧸ frattiniSubgroup p G)) := by
  haveI : IsMulCommutative (G ⧸ frattiniSubgroup p G) :=
    frattiniSubgroup_quotient_commutative p G
  exact inferInstance

/-- The Frattini quotient of a topological group is a module over `ZMod p`: it is abelian of
exponent `p`. -/
noncomputable instance instModuleFrattiniQuotient (p : ℕ) (G : Type u) [Group G]
    [TopologicalSpace G] [IsTopologicalGroup G] :
    Module (ZMod p) (Additive (G ⧸ frattiniSubgroup p G)) := by
  refine AddCommGroup.zmodModule ?_
  intro x
  induction x using Additive.rec with
  | ofMul y => rw [← ofMul_pow, frattiniSubgroup_quotient_pow_eq_one p G y]; rfl

/-- The **Frattini rank** of a pro-`p` topological group: the `𝔽_p`-dimension of its maximal
elementary abelian `p`-quotient `G ⧸ frattiniSubgroup p G`.  For a pro-`p` group this is the
minimal number of topological generators (see `Generation.lean`). -/
noncomputable def frattiniRank (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [Fact p.Prime] : ℕ :=
  Module.finrank (ZMod p) (Additive (G ⧸ frattiniSubgroup p G))

theorem frattiniRank_def (p : ℕ) (G : Type u) [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [Fact p.Prime] :
    frattiniRank p G = Module.finrank (ZMod p) (Additive (G ⧸ frattiniSubgroup p G)) := rfl

end Rank

end NK.ProfiniteP
