# Equality of classes in the colimit `H²(U, Z/p)`

The profinite cohomology `H2Profinite p U` is, by construction, the quotient of the
disjoint union of the level cohomologies `H²(U/(U ∩ Gal(K'/L)), Z/p)` by the equivalence
relation *generated* by the inflation maps `levelMap`.  Working with a generated relation is
cumbersome; the point of this file is that, because the finite Galois intermediate fields
are directed (any two are contained in their compositum, which is again finite Galois), the
relation generated by the inflations is simply the relation "the two elements agree after
inflation to a common dominating level".

Concretely, for `x y` in `Σ L, LevelH2 p U L` we prove

`Relation.EqvGen (colimitGen p U) x y ↔ ∃ M h₁ h₂, levelMap h₁ x.2 = levelMap h₂ y.2`

and deduce the user-facing statement `NK.BrauerHasse.ofLevel_eq_iff`: two classes
`ofLevel L a` and `ofLevel L' b` coincide if and only if there is a common dominating
finite Galois intermediate field `M ⊇ L, L'` on which the two classes agree.

## Main results

* `NK.BrauerHasse.levelMap_trans_apply`, `NK.BrauerHasse.levelMap_apply_proof_irrel` —
  element-wise compatibility of the inflation maps with composition and proof irrelevance;
* `NK.BrauerHasse.eqvGen_colimitGen_iff` — the equivalence relation generated by the
  colimit relation, described by a common dominating level;
* `NK.BrauerHasse.ofLevel_eq_iff` — the corresponding statement for the structure maps
  `H2Profinite.ofLevel` of the colimit.
-/

import Mathlib
import Submission.NK.BrauerHasse.Profinite
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open CategoryTheory

set_option autoImplicit false

universe u

namespace NK.BrauerHasse

-- The colimit computations below repeatedly unfold `levelMap`, which is a fairly large
-- term; the default heartbeat budget is not enough for the `rw`s involved.
set_option maxHeartbeats 1600000

variable {K K' : Type u} [Field K] [Field K'] [Algebra K K'] [IsSepClosure K K']
variable {p : ℕ} {U : Subgroup Gal(K'/K)}

/-! ## Elementary compatibility lemmas for the inflation maps -/

/-- **Composition of inflations, element-wise**: inflating along `h₁` and then along `h₂` is
inflating along `h₁.trans h₂`. -/
lemma levelMap_trans_apply {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'} (h₁ : L₁ ≤ L₂)
    (h₂ : L₂ ≤ L₃) (x : LevelH2 p U L₁) :
    (levelMap p (U := U) h₂) ((levelMap p (U := U) h₁) x) =
      (levelMap p (U := U) (h₁.trans h₂)) x := by
  have h := congrArg (fun (f : LevelH2 p U L₁ ⟶ LevelH2 p U L₃) => f x)
    (levelMap_comp p (U := U) h₁ h₂)
  simpa [CategoryTheory.comp_apply] using h

/-- The inflation map between two levels does not depend on the proof of the inclusion. -/
lemma levelMap_proof_irrel {L L' : FiniteGaloisIntermediateField K K'} {h h' : L ≤ L'} :
    levelMap p (U := U) h = levelMap p (U := U) h' := by
  rw [Subsingleton.elim h h']

/-- Element-wise form of `levelMap_proof_irrel`. -/
lemma levelMap_apply_proof_irrel {L L' : FiniteGaloisIntermediateField K K'} {h h' : L ≤ L'}
    (x : LevelH2 p U L) :
    (levelMap p (U := U) h) x = (levelMap p (U := U) h') x :=
  congrArg (fun (f : LevelH2 p U L ⟶ LevelH2 p U L') => f x)
    (levelMap_proof_irrel (p := p) (U := U))

/-! ## The equivalence relation generated by the colimit relation -/

/-- **Description of the equivalence relation generated by the colimit relation.**

Two elements `x`, `y` of the disjoint union of the level cohomologies become equal in the
colimit if and only if there is a common dominating finite Galois intermediate field `M`
with `x.1 ≤ M`, `y.1 ≤ M` such that the two inflations to `M` coincide.

The hypothesis that the finite Galois intermediate fields are directed enters through the
transitivity step: the compositum of the two dominating fields is again a finite Galois
intermediate field. -/
lemma eqvGen_colimitGen_iff (x y : Σ L : FiniteGaloisIntermediateField K K', LevelH2 p U L) :
    Relation.EqvGen (colimitGen p U) x y ↔
      ∃ (M : FiniteGaloisIntermediateField K K') (h₁ : x.1 ≤ M) (h₂ : y.1 ≤ M),
        (levelMap p (U := U) h₁) x.2 = (levelMap p (U := U) h₂) y.2 := by
  constructor
  · -- Every generating relation admits a common dominating level.
    intro h
    induction h with
    | rel a b hab =>
        obtain ⟨hab, hb⟩ := hab
        refine ⟨a.1 ⊔ b.1, le_sup_left, le_sup_right, ?_⟩
        calc (levelMap p (U := U) (le_sup_left : a.1 ≤ a.1 ⊔ b.1)) a.2
            = (levelMap p (U := U) (hab.trans (le_sup_right : b.1 ≤ a.1 ⊔ b.1))) a.2 :=
                levelMap_apply_proof_irrel _
          _ = (levelMap p (U := U) (le_sup_right : b.1 ≤ a.1 ⊔ b.1))
                ((levelMap p (U := U) hab) a.2) :=
                (levelMap_trans_apply (p := p) (U := U) hab le_sup_right a.2).symm
          _ = (levelMap p (U := U) (le_sup_right : b.1 ≤ a.1 ⊔ b.1)) b.2 := by rw [← hb]
    | refl a => exact ⟨a.1, le_rfl, le_rfl, rfl⟩
    | symm a b hab ih =>
        obtain ⟨M, h₁, h₂, e⟩ := ih
        exact ⟨M, h₂, h₁, e.symm⟩
    | trans a b c hab hbc ihab ihbc =>
        -- Pass to a common dominating level of the two dominating levels.
        obtain ⟨M₁, ha₁, hb₁, e₁⟩ := ihab
        obtain ⟨M₂, hb₂, hc₂, e₂⟩ := ihbc
        refine ⟨M₁ ⊔ M₂, ha₁.trans le_sup_left, hc₂.trans le_sup_right, ?_⟩
        calc (levelMap p (U := U) (ha₁.trans le_sup_left)) a.2
            = (levelMap p (U := U) (le_sup_left : M₁ ≤ M₁ ⊔ M₂))
                ((levelMap p (U := U) ha₁) a.2) :=
                (levelMap_trans_apply ha₁ le_sup_left a.2).symm
          _ = (levelMap p (U := U) (le_sup_left : M₁ ≤ M₁ ⊔ M₂))
                ((levelMap p (U := U) hb₁) b.2) := by rw [e₁]
          _ = (levelMap p (U := U) (hb₁.trans le_sup_left)) b.2 :=
                levelMap_trans_apply hb₁ le_sup_left b.2
          _ = (levelMap p (U := U) (hb₂.trans le_sup_right)) b.2 :=
                levelMap_apply_proof_irrel _
          _ = (levelMap p (U := U) (le_sup_right : M₂ ≤ M₁ ⊔ M₂))
                ((levelMap p (U := U) hb₂) b.2) :=
                (levelMap_trans_apply hb₂ le_sup_right b.2).symm
          _ = (levelMap p (U := U) (le_sup_right : M₂ ≤ M₁ ⊔ M₂))
                ((levelMap p (U := U) hc₂) c.2) := by rw [e₂]
          _ = (levelMap p (U := U) (hc₂.trans le_sup_right)) c.2 :=
                levelMap_trans_apply hc₂ le_sup_right c.2
  · -- Two elements with a common dominating level on which the inflations agree are related
    -- by a two-step chain through that common level.
    rintro ⟨M, h₁, h₂, e⟩
    refine Relation.EqvGen.trans x
      (⟨M, (levelMap p (U := U) h₁) x.2⟩ : Σ L, LevelH2 p U L) y ?_ ?_
    · exact Relation.EqvGen.rel x _ ⟨h₁, rfl⟩
    · rw [show (⟨M, (levelMap p (U := U) h₁) x.2⟩ : Σ L, LevelH2 p U L) =
          (⟨M, (levelMap p (U := U) h₂) y.2⟩ : Σ L, LevelH2 p U L) from by rw [e]]
      exact (Relation.EqvGen.rel y _ ⟨h₂, rfl⟩).symm

/-! ## The statement for the structure maps of the colimit -/

/-- The equivalence closure of the equivalence closure of a relation is the equivalence
closure of the relation. -/
lemma eqvGen_eqvGen_iff {α : Type*} {r : α → α → Prop} {a b : α} :
    Relation.EqvGen (Relation.EqvGen r) a b ↔ Relation.EqvGen r a b :=
  Equivalence.eqvGen_iff (Relation.EqvGen.is_equivalence r)

/-- **Two classes of `H²(U, Z/p)` coincide if and only if they already coincide on a common
dominating finite level.**

For classes `a` at level `L` and `b` at level `L'`, the classes `ofLevel L a` and
`ofLevel L' b` in the colimit agree exactly when there are a finite Galois intermediate
field `M` with `L ≤ M` and `L' ≤ M` whose two inflations of `a` and `b` agree. -/
theorem ofLevel_eq_iff {K K' : Type u} [Field K] [Field K'] [Algebra K K']
    [IsSepClosure K K'] {p : ℕ} {U : Subgroup Gal(K'/K)}
    {L L' : FiniteGaloisIntermediateField K K'}
    (a : NK.BrauerHasse.LevelH2 p U L) (b : NK.BrauerHasse.LevelH2 p U L') :
    NK.BrauerHasse.H2Profinite.ofLevel L a = NK.BrauerHasse.H2Profinite.ofLevel L' b ↔
      ∃ (M : FiniteGaloisIntermediateField K K') (h₁ : L ≤ M) (h₂ : L' ≤ M),
        (NK.BrauerHasse.levelMap p (U := U) h₁) a =
          (NK.BrauerHasse.levelMap p (U := U) h₂) b := by
  have key := eqvGen_colimitGen_iff (p := p) (U := U)
    (⟨L, a⟩ : Σ L, LevelH2 p U L) (⟨L', b⟩ : Σ L, LevelH2 p U L)
  constructor
  · -- Equality in `Quot (Relation.EqvGen (colimitGen p U))` is the equivalence closure of
    -- the equivalence closure of the colimit relation, which is the equivalence closure of
    -- the colimit relation itself.
    intro h
    exact key.mp (eqvGen_eqvGen_iff.mp (Quot.eqvGen_exact h))
  · rintro ⟨M, h₁, h₂, e⟩
    exact Quot.eqvGen_sound (eqvGen_eqvGen_iff.mpr (key.mpr ⟨M, h₁, h₂, e⟩))

end NK.BrauerHasse
