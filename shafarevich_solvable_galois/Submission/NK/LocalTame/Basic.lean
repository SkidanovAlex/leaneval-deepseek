/-! ## pro-`p`, pro-prime-to-`p` and pro-cyclic groups -/

/-- **`G` is a pro-`p` group** (in the finite-quotient formulation): every quotient of `G` by a
normal subgroup of finite index has `p`-power order.

For a profinite group this is equivalent to the usual definition: a finite index subgroup of a
profinite group is open, and a profinite group is pro-`p` exactly when all its finite quotients
have `p`-power order. -/
def IsProP (p : ℕ) (G : Type u) [Group G] : Prop :=
  ∀ (N : Subgroup G) [N.Normal], N.FiniteIndex → ∃ k : ℕ, N.index = p ^ k

/-- **`G` is a pro-prime-to-`p` group**: every finite quotient has order prime to `p`. -/
def IsProPrimeToP (p : ℕ) (G : Type u) [Group G] : Prop :=
  ∀ (N : Subgroup G) [N.Normal], N.FiniteIndex → Nat.Coprime p N.index

/-- **`G` is pro-cyclic**: every finite quotient of `G` is a cyclic group.  For a profinite group
this is equivalent to `G` being topologically generated by a single element. -/
def IsProCyclic (G : Type u) [Group G] : Prop :=
  ∀ (N : Subgroup G) [N.Normal], N.FiniteIndex → IsCyclic (G ⧸ N)

/-! ## Invariance under group isomorphisms -/

/-- **Invariance of pro-`p`-ness under group isomorphisms.** -/
theorem isProP_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) (p : ℕ) :
    IsProP p G ↔ IsProP p H := by
  constructor
  · intro h N hN hfi
    haveI : (N.comap (e : G →* H)).Normal := Subgroup.Normal.comap hN _
    have hfin : (N.comap (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff,
        Subgroup.index_comap_of_surjective (f := (e : G →* H)) N e.surjective]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    obtain ⟨k, hk⟩ := h (N.comap (e : G →* H)) hfin
    exact ⟨k, by
      rw [← Subgroup.index_comap_of_surjective (f := (e : G →* H)) N e.surjective, hk]⟩
  · intro h N hN hfi
    haveI : (N.map (e : G →* H)).Normal := hN.map _ e.surjective
    have hfin : (N.map (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff, Subgroup.index_map_equiv N e]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    obtain ⟨k, hk⟩ := h (N.map (e : G →* H)) hfin
    exact ⟨k, by rw [← Subgroup.index_map_equiv N e]; exact hk⟩

/-- **Invariance of pro-prime-to-`p`-ness under group isomorphisms.** -/
theorem isProPrimeToP_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) (p : ℕ) :
    IsProPrimeToP p G ↔ IsProPrimeToP p H := by
  constructor
  · intro h N hN hfi
    haveI : (N.comap (e : G →* H)).Normal := Subgroup.Normal.comap hN _
    have hfin : (N.comap (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff,
        Subgroup.index_comap_of_surjective (f := (e : G →* H)) N e.surjective]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    rw [← Subgroup.index_comap_of_surjective (f := (e : G →* H)) N e.surjective]
    exact h _ hfin
  · intro h N hN hfi
    haveI : (N.map (e : G →* H)).Normal := hN.map _ e.surjective
    have hfin : (N.map (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff, Subgroup.index_map_equiv N e]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    rw [← Subgroup.index_map_equiv N e]
    exact h _ hfin

/-- **Invariance of pro-cyclicity under group isomorphisms.** -/
theorem isProCyclic_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) :
    IsProCyclic G ↔ IsProCyclic H := by
  constructor
  · intro h N hN hfi
    haveI : (N.comap (e : G →* H)).Normal := Subgroup.Normal.comap hN _
    have hfin : (N.comap (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff,
        Subgroup.index_comap_of_surjective (f := (e : G →* H)) N e.surjective]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    have h1 : IsCyclic (G ⧸ N.comap (e : G →* H)) := h _ hfin
    exact (QuotientGroup.congr (N.comap (e : G →* H)) N e
      (Subgroup.map_comap_eq_self_of_surjective e.surjective N)).isCyclic.mp h1
  · intro h N hN hfi
    haveI : (N.map (e : G →* H)).Normal := hN.map _ e.surjective
    have hfin : (N.map (e : G →* H)).FiniteIndex := by
      rw [Subgroup.finiteIndex_iff, Subgroup.index_map_equiv N e]
      exact (Subgroup.finiteIndex_iff (H := N)).mp hfi
    have h1 : IsCyclic (H ⧸ N.map (e : G →* H)) := h _ hfin
    exact (QuotientGroup.congr N (N.map (e : G →* H)) e rfl).isCyclic.mpr h1

/-- Pro-`p`-ness of a subgroup is preserved by an isomorphism (of ambient groups). -/
theorem isProP_map {G H : Type*} [Group G] [Group H] (e : G ≃* H) {p : ℕ} {V : Subgroup G}
    (h : IsProP p ↥V) : IsProP p ↥(V.map (e : G →* H)) :=
  (isProP_congr (Subgroup.equivMapOfInjective V (e : G →* H) e.injective) p).mp h

/-- Pro-prime-to-`p`-ness of a subgroup is preserved by an isomorphism. -/
theorem isProPrimeToP_map {G H : Type*} [Group G] [Group H] (e : G ≃* H) {p : ℕ}
    {V : Subgroup G} (h : IsProPrimeToP p ↥V) : IsProPrimeToP p ↥(V.map (e : G →* H)) :=
  (isProPrimeToP_congr (Subgroup.equivMapOfInjective V (e : G →* H) e.injective) p).mp h

/-- Pro-cyclicity of a subgroup is preserved by an isomorphism. -/
theorem isProCyclic_map {G H : Type*} [Group G] [Group H] (e : G ≃* H) {V : Subgroup G}
    (h : IsProCyclic ↥V) : IsProCyclic ↥(V.map (e : G →* H)) :=
  (isProCyclic_congr (Subgroup.equivMapOfInjective V (e : G →* H) e.injective)).mp h

/-- An isomorphism of groups restricts to an isomorphism of the corresponding subgroups. -/
def mulEquivSubgroupCongr {G H : Type*} [Group G] [Group H] (e : G ≃* H) {V : Subgroup G}
    {W : Subgroup H} (h : V.map (e : G →* H) = W) : ↥V ≃* ↥W :=
  (Subgroup.equivMapOfInjective V (e : G →* H) e.injective).trans (MulEquiv.subgroupCongr h)

/-! ## The wild inertia -/

/-- **`V` is the wild inertia subgroup** of the (profinite) group `G`: `V` is the maximal closed
normal pro-`p` subgroup of `G`.  Equivalently (for `G = G_κ`), `V` is the fixing subgroup of the
maximal tame extension of `κ`; see `NK.LocalTame.TameStructure`.

The defining property is stated so that it transfers along group isomorphisms with no continuity
hypothesis: `V` is normal, pro-`p`, and contains every normal pro-`p` subgroup. -/
def IsWildInertia (p : ℕ) (G : Type u) [Group G] (V : Subgroup G) : Prop :=
  V.Normal ∧ IsProP p ↥V ∧ ∀ N : Subgroup G, N.Normal → IsProP p ↥N → N ≤ V

/-- **There is at most one wild inertia subgroup**: the maximal closed normal pro-`p` subgroup is
unique. -/
theorem IsWildInertia.eq {G : Type u} [Group G] {p : ℕ} {V W : Subgroup G}
    (hV : IsWildInertia p G V) (hW : IsWildInertia p G W) : V = W :=
  le_antisymm (hW.2.2 V hV.1 hV.2.1) (hV.2.2 W hW.1 hW.2.1)

/-- **The wild inertia transfers along a group isomorphism**: an isomorphism of groups carries
the maximal closed normal pro-`p` subgroup onto the maximal closed normal pro-`p` subgroup. -/
theorem IsWildInertia.map {G H : Type*} [Group G] [Group H] {p : ℕ} {V : Subgroup G}
    (h : IsWildInertia p G V) (e : G ≃* H) :
    IsWildInertia p H (V.map (e : G →* H)) := by
  have hnorm : (V.map (e : G →* H)).Normal := h.1.map _ e.surjective
  refine ⟨hnorm, isProP_map e h.2.1, ?_⟩
  intro N hN hNp
  have hNp' : IsProP p ↥(N.comap (e : G →* H)) :=
    (isProP_congr (mulEquivSubgroupCongr e
      (Subgroup.map_comap_eq_self_of_surjective (f := (e : G →* H)) e.surjective N)) p).mpr hNp
  have hcomap : N.comap (e : G →* H) ≤ V :=
    h.2.2 _ (Subgroup.Normal.comap hN _) hNp'
  have h1 := Subgroup.map_mono (f := (e : G →* H)) hcomap
  rwa [Subgroup.map_comap_eq_self_of_surjective (f := (e : G →* H)) e.surjective N] at h1

/-! ## The tame inertia inside the tame quotient -/

/-- The image of a subgroup `H ≤ G` in the quotient `G ⧸ V`. -/
def quotientImage {G : Type u} [Group G] (V : Subgroup G) [V.Normal] (H : Subgroup G) :
    Subgroup (G ⧸ V) :=
  H.map (QuotientGroup.mk' V)

/-- **`I` is the tame inertia modulo the wild inertia `V`**: `I ⊇ V` and the image of `I` in
`G ⧸ V` is the *maximal* closed normal pro-cyclic subgroup of `G ⧸ V`.

For `G = G_κ` and `V = V_κ` this singles out `I = I_κ`, the inertia subgroup (NSW (7.5.7)
Corollary).  The statement is designed to transfer along group isomorphisms: it is a property of
the pair `(V, I)` inside the abstract group `G` alone. -/
def IsMaxNormalProCyclicInQuotient {G : Type u} [Group G] (V I : Subgroup G) [V.Normal] : Prop :=
  V ≤ I ∧ (quotientImage V I).Normal ∧ IsProCyclic ↥(quotientImage V I) ∧
    ∀ J : Subgroup G, V ≤ J → (quotientImage V J).Normal →
      IsProCyclic ↥(quotientImage V J) → J ≤ I

/-- **There is at most one tame inertia subgroup**: two maximal closed normal pro-cyclic
subgroups of `G ⧸ V` containing `V` coincide. -/
theorem IsMaxNormalProCyclicInQuotient.eq {G : Type u} [Group G] {V I I' : Subgroup G}
    [V.Normal] (hI : IsMaxNormalProCyclicInQuotient V I)
    (hI' : IsMaxNormalProCyclicInQuotient V I') : I = I' :=
  le_antisymm (hI'.2.2.2 I hI.1 hI.2.1 hI.2.2.1) (hI.2.2.2 I' hI'.1 hI'.2.1 hI'.2.2.1)

/-! ## Frobenius lifts -/

/-- **`x` is a Frobenius lift for the tame inertia `I/V` with residue field order `q`**: `x` lies
outside the inertia subgroup and conjugates the tame inertia `I/V` by the `q`-th power map, i.e.
`x y x⁻¹ ≡ y^q (mod V)` for every `y ∈ I`.

For `G = G_κ` this is the group-theoretic form of the Frobenius normalisation: the classical
Frobenius lift acts on the tame inertia by the `q`-th power map, where `q` is the cardinality of
the residue field (NSW (12.1.8) Lemma; Iwasawa).  The equivalence with the concrete description
by the action on the roots of unity of order prime to `p` is the input
`NK.LocalTame.FrobeniusLiftCharacterisation`. -/
def IsTameFrobeniusLift {G : Type u} [Group G] (q : ℕ) (V I : Subgroup G) (x : G) : Prop :=
  x ∉ I ∧ ∀ y ∈ I, x * y * x⁻¹ * (y ^ q)⁻¹ ∈ V

/-- **Frobenius lifts transfer along a group isomorphism** carrying `V` to `V'` and `I` to `I'`:
the predicate is expressed purely in terms of conjugation and `q`-th powers. -/
theorem isTameFrobeniusLift_map_iff {G H : Type*} [Group G] [Group H] (e : G ≃* H) {q : ℕ}
    {V I : Subgroup G} {V' I' : Subgroup H} (hV : V.map (e : G →* H) = V')
    (hI : I.map (e : G →* H) = I') (x : G) :
    IsTameFrobeniusLift q V I x ↔ IsTameFrobeniusLift q V' I' (e x) := by
  constructor
  · intro h
    refine ⟨fun hx => h.1 ?_, fun y' hy' => ?_⟩
    · have hx' : (e : G →* H) x ∈ I.map (e : G →* H) := hI ▸ hx
      obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx'
      have hyx' : y = x := e.injective hyx
      exact hyx' ▸ hy
    · have hy'' : y' ∈ I.map (e : G →* H) := hI ▸ hy'
      obtain ⟨y, hy, rfl⟩ := Subgroup.mem_map.mp hy''
      have h2 : (e : G →* H) (x * y * x⁻¹ * (y ^ q)⁻¹) ∈ V' := by
        rw [← hV]
        exact Subgroup.mem_map.mpr ⟨_, h.2 y hy, rfl⟩
      simpa [map_mul, map_pow, map_inv] using h2
  · intro h
    refine ⟨fun hx => h.1 ?_, fun y hy => ?_⟩
    · exact hI ▸ Subgroup.mem_map.mpr ⟨x, hx, rfl⟩
    · have hy' : (e : G →* H) y ∈ I' := hI ▸ Subgroup.mem_map.mpr ⟨y, hy, rfl⟩
      have h2 := h.2 ((e : G →* H) y) hy'
      have h3 : (e : G →* H) (x * y * x⁻¹ * (y ^ q)⁻¹) ∈ V' := by
        simpa [map_mul, map_pow, map_inv] using h2
      have h3' : (e : G →* H) (x * y * x⁻¹ * (y ^ q)⁻¹) ∈ V.map (e : G →* H) := hV ▸ h3
      obtain ⟨z, hz, hze⟩ := Subgroup.mem_map.mp h3'
      have hze' : z = x * y * x⁻¹ * (y ^ q)⁻¹ := e.injective hze
      rw [← hze']
      exact hz

/-! ## The `ℤ_ℓ²`-quotient detector of the residue characteristic -/

/-- **`G` admits a surjection onto `ℤ_ℓ²`**: for every `n ≥ 1` there is a normal subgroup `N` of
`G` with `G ⧸ N ≅ (ℤ/ℓ^n)²`.  Equivalently (for profinite `G`), `G` has a quotient isomorphic to
the free pro-`ℓ` group `ℤ_ℓ²`. -/
def HasZl2Quotient (ℓ : ℕ) (G : Type u) [Group G] : Prop :=
  ∀ n : ℕ, 0 < n → ∃ f : G →* (Multiplicative (ZMod (ℓ ^ n)) × Multiplicative (ZMod (ℓ ^ n))),
    Function.Surjective f

/-- **Invariance of the `ℤ_ℓ²`-quotient detector** under group isomorphisms. -/
theorem hasZl2Quotient_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) (ℓ : ℕ) :
    HasZl2Quotient ℓ G ↔ HasZl2Quotient ℓ H := by
  constructor
  · intro h n hn
    obtain ⟨f, hf⟩ := h n hn
    exact ⟨f.comp e.symm.toMonoidHom, hf.comp e.symm.surjective⟩
  · intro h n hn
    obtain ⟨f, hf⟩ := h n hn
    exact ⟨f.comp e.toMonoidHom, hf.comp e.surjective⟩

end

end NK.LocalTame
