/-!
# The `ℓ`-Frattini index of a normal subgroup of index `ℓ`

Let `M ⊴ G` be a normal subgroup of prime index `ℓ` and `g ∈ G` with `g ∉ M`.  The main result
of this file,

`NK.LocalTame.IndexRedo.frattini_index_ne_zero_of_sup_zpowers_commutator`,

says that if the subgroup `M ^ ℓ · [M,M] · [⟨g⟩, M]` of `M` has finite index in `M`, then so does
`M ^ ℓ · [M,M]`.

This is the "Nakayama step" in the special case where `G/M` has order `ℓ`:  the quotient
`V = M ⧸ M^ℓ[M,M]` is an elementary abelian `ℓ`-group on which `g` acts by an automorphism `σ`
with `σ^ℓ = 1`, and the hypothesis says that the image of `[⟨g⟩, M]`, namely `(σ-1)V`, is a
subgroup of finite index.  Since `(σ-1)^ℓ = σ^ℓ - 1 = 0` on `V`, Nakayama's lemma for the local
ring `F_ℓ[σ]` (with maximal ideal `(σ-1)`) forces `V` to be finite.

The proof is organised as follows.

* `exists_finset_sup_closure_eq_top`: a subgroup of finite index, together with the subgroup
  generated by a finite set, generates the whole group.
* `iterate_add`, `iterate_neg`, `iterate_zero`: iterates of additive maps are additive.
* `finite_of_finiteIndex_range_of_iterate`: **Nakayama's lemma**.  If `A` is an abelian group of
  exponent `ℓ`, `f : A →+ A` satisfies `f^[ℓ] = 0`, and `f` has finite-index image, then `A` is
  finite.  (Two ingredients: `A` is generated by `f.range` and a finitely generated subgroup, and
  the `ℓ`-fold iterated images of a finitely generated `ℓ`-torsion group are finite.)
* `iterate_sub_eq_zero`: the freshman's dream `(σ - 1)^ℓ = σ^ℓ - 1` applied to iterates.
* `conjDiff` and its properties: the "difference" `π(σ_x y) - π(y)` in the quotient `M ⧸ M^ℓ[M,M]`,
  which is an additive map making the conjugation action explicit.
-/

open scoped commutatorElement

namespace NK.LocalTame
namespace IndexRedo

/-! ### Generators modulo a finite-index subgroup -/

/-- If `H` has finite index in an additive group `A`, then `A` is generated by `H` and by a
finitely generated subgroup. -/
theorem exists_finset_sup_closure_eq_top {A : Type*} [AddCommGroup A] {H : AddSubgroup A}
    (h : H.FiniteIndex) : ∃ S : Finset A, H ⊔ AddSubgroup.closure (S : Set A) = ⊤ := by
  classical
  haveI : Finite (A ⧸ H) := AddSubgroup.finiteIndex_iff_finite_quotient.mp h
  haveI : Fintype (A ⧸ H) := Fintype.ofFinite _
  refine ⟨Finset.univ.image (fun q : A ⧸ H => (Quotient.out q : A)), ?_⟩
  rw [eq_top_iff]
  intro a _
  have hs : QuotientAddGroup.mk (Quotient.out ((QuotientAddGroup.mk a : A ⧸ H)))
      = QuotientAddGroup.mk a := Quotient.out_eq _
  have hmem : a - Quotient.out (QuotientAddGroup.mk a : A ⧸ H) ∈ H := by
    rw [← QuotientAddGroup.eq_iff_sub_mem]; exact hs.symm
  refine AddSubgroup.mem_sup.mpr
    ⟨_, hmem, Quotient.out (QuotientAddGroup.mk a : A ⧸ H), ?_, ?_⟩
  · exact AddSubgroup.subset_closure (Finset.mem_image.mpr ⟨_, Finset.mem_univ _, rfl⟩)
  · rw [sub_add_cancel]

/-! ### Iterates of additive maps -/

theorem iterate_add {A : Type*} [AddCommGroup A] (f : A →+ A) (n : ℕ) (x y : A) :
    f^[n] (x + y) = f^[n] x + f^[n] y := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', Function.iterate_succ_apply',
      Function.iterate_succ_apply', ih, map_add]

theorem iterate_neg {A : Type*} [AddCommGroup A] (f : A →+ A) (n : ℕ) (x : A) :
    f^[n] (-x) = -f^[n] x := by
  induction n with
  | zero => rfl
  | succ n ih => rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih, map_neg]

theorem iterate_zero {A : Type*} [AddCommGroup A] (f : A →+ A) (n : ℕ) :
    f^[n] (0 : A) = 0 := by
  induction n with
  | zero => rfl
  | succ n ih => rw [Function.iterate_succ_apply', ih, map_zero]

/-! ### Nakayama's lemma -/

/-- **Nakayama's lemma** for an abelian group `A` of exponent dividing the prime `ℓ`, with respect
to an endomorphism `f` with `f^[ℓ] = 0`: if `f` has finite-index image then `A` is finite. -/
theorem finite_of_finiteIndex_range_of_iterate {A : Type*} [AddCommGroup A] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hexp : ∀ a : A, ℓ • a = 0) (f : A →+ A) (hf : ∀ a : A, f^[ℓ] a = 0)
    (hfin : (AddSubgroup.closure (Set.range f)).FiniteIndex) : Finite A := by
  classical
  have hℓpos : 0 < ℓ := hℓ.pos
  obtain ⟨S, hS⟩ := exists_finset_sup_closure_eq_top hfin
  have hf_iter : ∀ i : ℕ, ℓ ≤ i → ∀ a : A, f^[i] a = 0 := by
    intro i hi a
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hi
    rw [Function.iterate_add_apply]
    exact hf (f^[k] a)
  set T : Finset A := (Finset.range ℓ).biUnion (fun j => S.image (fun s => f^[j] s)) with hT
  set C : AddSubgroup A := AddSubgroup.closure (T : Set A) with hC
  have hmapB : ∀ i : ℕ, ∀ x ∈ AddSubgroup.closure (S : Set A), f^[i] x ∈ C := by
    intro i x hx
    induction hx using AddSubgroup.closure_induction with
    | mem s hs =>
      rcases lt_or_ge i ℓ with hlt | hge
      · exact AddSubgroup.subset_closure (Finset.mem_biUnion.mpr
          ⟨i, Finset.mem_range.mpr hlt, Finset.mem_image.mpr ⟨s, hs, rfl⟩⟩)
      · rw [hf_iter i hge s]; exact C.zero_mem
    | zero => rw [iterate_zero]; exact C.zero_mem
    | add x y hx hy ihx ihy => rw [iterate_add]; exact C.add_mem ihx ihy
    | neg x hx ihx => rw [iterate_neg]; exact C.neg_mem ihx
  have hmap_iter : ∀ i k : ℕ, ∀ x ∈ AddSubgroup.closure (Set.range (f^[k])),
      f^[i] x ∈ AddSubgroup.closure (Set.range (f^[i+k])) := by
    intro i k x hx
    induction hx using AddSubgroup.closure_induction with
    | mem y hy =>
      obtain ⟨a, rfl⟩ := hy
      rw [← Function.iterate_add_apply]
      exact AddSubgroup.subset_closure ⟨a, rfl⟩
    | zero => rw [iterate_zero]; exact (AddSubgroup.closure _).zero_mem
    | add x y hx hy ihx ihy => rw [iterate_add]; exact (AddSubgroup.closure _).add_mem ihx ihy
    | neg x hx ihx => rw [iterate_neg]; exact (AddSubgroup.closure _).neg_mem ihx
  have hstep : ∀ i : ℕ, AddSubgroup.closure (Set.range (f^[i])) ≤
      AddSubgroup.closure (Set.range (f^[i+1])) ⊔ C := by
    intro i
    rw [AddSubgroup.closure_le]
    rintro x ⟨a, rfl⟩
    have ha : a ∈ AddSubgroup.closure (Set.range f) ⊔ AddSubgroup.closure (S : Set A) := by
      rw [hS]; trivial
    obtain ⟨y, hy, b, hb, rfl⟩ := AddSubgroup.mem_sup.mp ha
    have hy' : f^[i] y ∈ AddSubgroup.closure (Set.range (f^[i+1])) := by
      have h1 : y ∈ AddSubgroup.closure (Set.range (f^[1])) := by simpa using hy
      have h2 := hmap_iter i 1 y h1
      simpa using h2
    have hb' : f^[i] b ∈ C := hmapB i b hb
    rw [iterate_add]
    exact AddSubgroup.add_mem _ (AddSubgroup.mem_sup_left hy') (AddSubgroup.mem_sup_right hb')
  have hkey : ∀ i : ℕ, (⊤ : AddSubgroup A) ≤ AddSubgroup.closure (Set.range (f^[i])) ⊔ C := by
    intro i
    induction i with
    | zero =>
      rw [Function.iterate_zero, Set.range_id, AddSubgroup.closure_univ]
      exact le_sup_left
    | succ i ih => exact le_trans ih (sup_le (hstep i) le_sup_right)
  have hfℓ : f^[ℓ] = fun _ => (0 : A) := funext hf
  have hbot : AddSubgroup.closure (Set.range (fun _ : A => (0 : A))) = ⊥ := by
    rw [eq_bot_iff, AddSubgroup.closure_le]
    rintro x ⟨a, rfl⟩
    exact AddSubgroup.zero_mem _
  have hkeyℓ := hkey ℓ
  rw [hfℓ, hbot, bot_sup_eq] at hkeyℓ
  have hCtop : C = ⊤ := top_le_iff.mp hkeyℓ
  haveI : AddGroup.FG C := AddGroup.closure_finite_fg (T : Set A)
  have htor : IsAddTorsion A := by
    intro x
    rw [isOfFinAddOrder_iff_nsmul_eq_zero]
    exact ⟨ℓ, hℓpos, hexp x⟩
  haveI : Finite C := AddCommGroup.finite_of_fg_isAddTorsion C (htor.addSubgroup C)
  exact Finite.of_injective (fun a : A => (⟨a, by rw [hCtop]; trivial⟩ : C))
    (fun a b h => Subtype.ext_iff.mp h)

/-! ### The freshman's dream for iterates of `σ - 1` -/

theorem iterate_sub_eq_zero {A : Type*} [AddCommGroup A] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hexp : ∀ a : A, ℓ • a = 0) (σ : A ≃+ A) (hσ : ∀ a : A, σ^[ℓ] a = a) :
    ∀ a : A, (fun x => σ x - x)^[ℓ] a = 0 := by
  have hℓR : (ℓ : AddMonoid.End A) = 0 := by
    ext a
    exact hexp a
  let g0 : AddMonoid.End A := σ.toAddMonoidHom
  have hg0 : ⇑g0 = ⇑σ := rfl
  have hg0pow : ∀ n a, (g0^n) a = σ^[n] a := by
    intro n
    induction n with
    | zero => intro a; rfl
    | succ n ih =>
      intro a
      have h1 : (g0^(n+1)) a = (g0^n) (g0 a) := by
        show g0^[n+1] a = g0^[n] (g0 a)
        rw [Function.iterate_succ_apply]
      rw [h1, ih]
      show (⇑σ)^[n] (g0 a) = (⇑σ)^[n+1] a
      rw [Function.iterate_succ_apply]
      exact congrArg (fun y => (⇑σ)^[n] y) (congrFun hg0 a)
  have hσE : g0 ^ ℓ = 1 := by
    ext a
    rw [hg0pow, hσ, AddMonoid.End.one_apply]
  let f : AddMonoid.End A := g0 - 1
  have hfℓ : f ^ ℓ = 0 := by
    have h := IndexPrime.sub_one_pow_prime_pow (R := AddMonoid.End A) hℓ hℓR g0 1
    rw [pow_one] at h
    rw [hσE] at h
    simpa using h
  have hfiter : ∀ (n : ℕ) (a : A), (f^n) a = (fun x => σ x - x)^[n] a := by
    intro n
    induction n with
    | zero => intro a; rfl
    | succ n ih =>
      intro a
      have h1 : (f^(n+1)) a = (f^n) (f a) := by
        show f^[n+1] a = f^[n] (f a)
        rw [Function.iterate_succ_apply]
      have hfa : f a = σ a - a := by
        show g0 a - (1 : AddMonoid.End A) a = σ a - a
        rw [AddMonoid.End.one_apply, congrFun hg0 a]
      rw [h1, ih, hfa]
      rw [Function.iterate_succ_apply]
  intro a
  rw [← hfiter ℓ a, hfℓ]
  rfl

/-! ### The conjugation difference in a quotient -/

/-! #### Simplification lemmas for `Additive.ofMul` -/

section OfMulSimp

variable {V : Type*}

lemma ofMul_mul' [Mul V] (a b : V) :
    Additive.ofMul (a * b) = Additive.ofMul a + Additive.ofMul b := rfl

lemma ofMul_inv' [Inv V] (a : V) : Additive.ofMul a⁻¹ = -Additive.ofMul a := rfl

lemma ofMul_one' [One V] : Additive.ofMul (1 : V) = 0 := rfl

lemma nsmul_ofMul' [Monoid V] (n : ℕ) (v : V) :
    n • Additive.ofMul v = Additive.ofMul (v ^ n) := by
  induction n with
  | zero => rfl
  | succ n ih => rw [succ_nsmul, ih, pow_succ, ofMul_mul']

end OfMulSimp

section ConjDiff

variable {G : Type*} [Group G] {M : Subgroup G} [hMN : M.Normal]

/-- `⁅x, y⁆ ∈ M` for `y ∈ M` and `x ∈ G` (a subgroup of a normal subgroup is normal). -/
lemma comm_mem (x : G) (y : ↥M) : ⁅x, (y : G)⁆ ∈ M := by
  rw [commutatorElement_def]
  exact M.mul_mem (hMN.conj_mem (y : G) y.2 x) (M.inv_mem y.2)

/-- Conjugation is multiplicative in the group element. -/
lemma conjNormal_mul_apply (a b : G) (y : ↥M) :
    MulAut.conjNormal (H := M) (a * b) y
      = MulAut.conjNormal (H := M) a (MulAut.conjNormal (H := M) b y) := by
  rw [map_mul, MulAut.mul_apply]

/-- `x y x⁻¹ = ⁅x,y⁆ · y`. -/
lemma conjNormal_eq_comm_mul (x : G) (y : ↥M) :
    MulAut.conjNormal (H := M) x y = ⟨⁅x, (y : G)⁆, comm_mem x y⟩ * y := by
  apply Subtype.ext
  rw [MulAut.conjNormal_apply, Subgroup.coe_mul]
  show x * (y : G) * x⁻¹ = ⁅x, (y : G)⁆ * (y : G)
  rw [commutatorElement_def]
  group

/-- The "difference" of `y` under conjugation by `x`, computed in the quotient `↥M ⧸ L`. -/
noncomputable def conjDiff (L : Subgroup ↥M) [L.Normal] (x : G) (y : ↥M) :
    Additive (↥M ⧸ L) :=
  Additive.ofMul ((QuotientGroup.mk' L) (MulAut.conjNormal (H := M) x y)) -
    Additive.ofMul ((QuotientGroup.mk' L) y)

variable (L : Subgroup ↥M) [L.Normal]

lemma conjDiff_mul_right (hcomm : commutator ↥M ≤ L) (x : G) (y₁ y₂ : ↥M) :
    conjDiff L x (y₁ * y₂) = conjDiff L x y₁ + conjDiff L x y₂ := by
  haveI : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  have h1 : MulAut.conjNormal (H := M) x (y₁ * y₂) =
      MulAut.conjNormal (H := M) x y₁ * MulAut.conjNormal (H := M) x y₂ := map_mul _ _ _
  simp only [conjDiff, h1, map_mul, ofMul_mul', ofMul_inv']
  abel

lemma conjDiff_mul_left (hcomm : commutator ↥M ≤ L) (a b : G) (y : ↥M) :
    conjDiff L (a * b) y = conjDiff L a (MulAut.conjNormal (H := M) b y) + conjDiff L b y := by
  haveI : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  simp only [conjDiff, conjNormal_mul_apply]
  abel

lemma conjDiff_one_left (hcomm : commutator ↥M ≤ L) (y : ↥M) : conjDiff L (1 : G) y = 0 := by
  haveI : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  simp only [conjDiff, map_one, MulAut.one_apply, ofMul_one', sub_zero]
  abel

lemma conjDiff_eq (hcomm : commutator ↥M ≤ L) (x : G) (y : ↥M) :
    conjDiff L x y = Additive.ofMul ((QuotientGroup.mk' L) ⟨⁅x, (y : G)⁆, comm_mem x y⟩) := by
  haveI : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  rw [conjDiff, conjNormal_eq_comm_mul, map_mul, ofMul_mul']
  abel

lemma conjDiff_eq_zero_of_mem (hcomm : commutator ↥M ≤ L) (h : ↥M) (y : ↥M) :
    conjDiff L (h : G) y = 0 := by
  haveI : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  rw [conjDiff, conjNormal_eq_comm_mul, map_mul, ofMul_mul']
  have h1 : (QuotientGroup.mk' L) ⟨⁅(h : G), (y : G)⁆, comm_mem (h : G) y⟩ = 1 := by
    rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hcomm (Subgroup.commutator_mem_commutator (Subgroup.mem_top h) (Subgroup.mem_top y))
  rw [h1, ofMul_one', zero_add]
  abel

end ConjDiff

/-! ### The main theorem -/

/-- **The Nakayama step for `M ⊴ G` of prime index `ℓ`.**

If `M ^ ℓ · [M,M] · [⟨g⟩, M]` has finite index in `M` for some `g ∉ M`, then `M ^ ℓ · [M,M]` has
finite index in `M`. -/
theorem frattini_index_ne_zero_of_sup_zpowers_commutator {ℓ : ℕ} (hℓ : ℓ.Prime)
    {G : Type*} [Group G] (M : Subgroup G) [hM : M.Normal] (hMi : M.index = ℓ) (g : G)
    (hg : g ∉ M)
    (hfin : (NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M ⊔
        (⁅Subgroup.zpowers g, M⁆).comap M.subtype).index ≠ 0) :
    (NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M).index ≠ 0 := by
  classical
  set L : Subgroup ↥M := NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M with hLdef
  have hpowL : NK.LocalTame.IndexPrime.powSub ℓ ↥M ≤ L := by
    rw [hLdef]; exact le_sup_left
  have hcommL : commutator ↥M ≤ L := by
    rw [hLdef]; exact le_sup_right
  have hLnormal : L.Normal := by
    rw [hLdef]
    haveI hpow : (NK.LocalTame.IndexPrime.powSub ℓ ↥M).Normal := ⟨fun n hn g => by
      have h1 : NK.LocalTame.IndexPrime.powSub ℓ ↥M ≤
          (NK.LocalTame.IndexPrime.powSub ℓ ↥M).comap (MulAut.conj g).toMonoidHom := by
        rw [NK.LocalTame.IndexPrime.powSub_le_iff]
        intro y
        show (MulAut.conj g).toMonoidHom (y ^ ℓ) ∈ NK.LocalTame.IndexPrime.powSub ℓ ↥M
        rw [map_pow]
        exact NK.LocalTame.IndexPrime.mem_powSub _
      exact (Subgroup.map_le_iff_le_comap).mpr h1
        (Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hn)⟩
    haveI hcomm : (commutator ↥M).Normal := Subgroup.commutator_normal (⊤ : Subgroup ↥M) ⊤
    exact Subgroup.sup_normal _ _
  haveI : L.Normal := hLnormal
  -- `L` is invariant under all automorphisms of `↥M`
  have hLA : ∀ e : MulAut ↥M,
      (NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M).map e.toMonoidHom
        = NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M := by
    have hmap_le : ∀ f : MulAut ↥M,
        Subgroup.map f.toMonoidHom
          (NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M) ≤
          NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M := by
      intro f
      have hA : Subgroup.map f.toMonoidHom (NK.LocalTame.IndexPrime.powSub ℓ ↥M) ≤
          NK.LocalTame.IndexPrime.powSub ℓ ↥M := by
        rw [Subgroup.map_le_iff_le_comap, NK.LocalTame.IndexPrime.powSub_le_iff]
        intro y
        rw [Subgroup.mem_comap, map_pow]
        exact NK.LocalTame.IndexPrime.mem_powSub _
      have hB : Subgroup.map f.toMonoidHom (commutator ↥M) ≤ commutator ↥M := by
        have hsurj : Function.Surjective ⇑(MulEquiv.toMonoidHom f) := fun y => ⟨f.symm y, by simp⟩
        rw [show commutator ↥M = ⁅(⊤ : Subgroup ↥M), ⊤⁆ from rfl, Subgroup.map_commutator,
          Subgroup.map_top_of_surjective _ hsurj]
      refine (Subgroup.map_sup (NK.LocalTame.IndexPrime.powSub ℓ ↥M) (commutator ↥M)
        f.toMonoidHom).le.trans ?_
      refine sup_le ?_ ?_
      · exact hA.trans le_sup_left
      · exact hB.trans le_sup_right
    intro e
    refine le_antisymm (hmap_le e) ?_
    intro x hx
    have hx' : e.symm x ∈ NK.LocalTame.IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M :=
      hmap_le e.symm (Subgroup.mem_map_of_mem e.symm.toMonoidHom hx)
    have hxx : x = e.toMonoidHom (e.symm.toMonoidHom x) := by simp
    rw [hxx]
    exact Subgroup.mem_map_of_mem e.toMonoidHom hx'
  have hLaut : ∀ e : MulAut ↥M, L.map e.toMonoidHom = L := by
    intro e; rw [hLdef]; exact hLA e
  have hLinv : L.map (MulAut.conjNormal (H := M) g) = L := hLaut _
  -- the subgroup `K` and the hypothesis in the quotient
  set K : Subgroup ↥M := (⁅Subgroup.zpowers g, M⁆).comap M.subtype with hKdef
  have hker : (QuotientGroup.mk' L).ker = L := QuotientGroup.ker_mk' L
  have hmap1 : ((L ⊔ K).map (QuotientGroup.mk' L)).index = (L ⊔ K).index := by
    refine Subgroup.index_map_eq (L ⊔ K) (QuotientGroup.mk'_surjective L) ?_
    intro x hx
    rw [hker] at hx
    exact Subgroup.mem_sup_left hx
  have hmap2 : (L ⊔ K).map (QuotientGroup.mk' L) = K.map (QuotientGroup.mk' L) := by
    rw [Subgroup.map_sup]
    have hL0 : L.map (QuotientGroup.mk' L) = ⊥ := by
      rw [Subgroup.map_eq_bot_iff, hker]
    rw [hL0, bot_sup_eq]
  have hKidx : (K.map (QuotientGroup.mk' L)).index ≠ 0 := by
    rw [← hmap2, hmap1]
    exact hfin
  -- the quotient is commutative
  have hVcomm : IsMulCommutative (↥M ⧸ L) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr hcommL
  haveI : IsMulCommutative (↥M ⧸ L) := hVcomm
  letI : CommGroup (↥M ⧸ L) :=
    { (inferInstance : Group (↥M ⧸ L)) with mul_comm := fun x y => mul_comm' x y }
  -- the automorphism induced by conjugation by `g`, and its additive form
  set σV : (↥M ⧸ L) ≃* (↥M ⧸ L) :=
    QuotientGroup.congr L L (MulAut.conjNormal (H := M) g) hLinv with hσVdef
  have hσVmk : ∀ m : ↥M,
      σV (QuotientGroup.mk' L m) = QuotientGroup.mk' L (MulAut.conjNormal (H := M) g m) := by
    intro m
    rw [hσVdef, QuotientGroup.mk'_apply, QuotientGroup.congr_mk, QuotientGroup.mk'_apply]
  set σA : Additive (↥M ⧸ L) ≃+ Additive (↥M ⧸ L) := MulEquiv.toAdditive σV with hσAdef
  have hσA_apply : ∀ v : ↥M ⧸ L, σA (Additive.ofMul v) = Additive.ofMul (σV v) := fun v => rfl
  let σE : AddMonoid.End (Additive (↥M ⧸ L)) := σA.toAddMonoidHom
  let fE : AddMonoid.End (Additive (↥M ⧸ L)) := σE - 1
  have hfE_apply : ∀ a, fE a = σA a - a := by
    intro a
    show σE a - (1 : AddMonoid.End (Additive (↥M ⧸ L))) a = σA a - a
    rw [AddMonoid.End.one_apply]
    rfl
  set WA : AddSubgroup (Additive (↥M ⧸ L)) := AddSubgroup.closure (Set.range fE) with hWAdef
  -- iterates of `σV` are given by conjugation
  have hσViter : ∀ n : ℕ, ∀ m : ↥M,
      σV^[n] (QuotientGroup.mk' L m) = QuotientGroup.mk' L (MulAut.conjNormal (H := M) (g^n) m) := by
    intro n
    induction n with
    | zero =>
      intro m
      rw [Function.iterate_zero_apply, pow_zero, map_one, MulAut.one_apply]
    | succ n ih =>
      intro m
      rw [Function.iterate_succ_apply', ih, hσVmk]
      congr 1
      rw [← conjNormal_mul_apply, ← pow_succ']
  have hMtriv : ∀ (h : ↥M) (m : ↥M),
      (QuotientGroup.mk' L) (MulAut.conjNormal (H := M) (h : G) m) = QuotientGroup.mk' L m := by
    intro h m
    rw [conjNormal_eq_comm_mul, map_mul]
    have h1 : (QuotientGroup.mk' L) ⟨⁅(h : G), (m : G)⁆, comm_mem (h : G) m⟩ = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hcommL (Subgroup.commutator_mem_commutator (Subgroup.mem_top h) (Subgroup.mem_top m))
    rw [h1, one_mul]
  have hgl : g ^ ℓ ∈ M := by rw [← hMi]; exact Subgroup.pow_index_mem M g
  have hσVpow : ∀ v : ↥M ⧸ L, σV^[ℓ] v = v := by
    intro v
    obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective L v
    rw [hσViter]
    exact hMtriv ⟨g ^ ℓ, hgl⟩ m
  have hσAiter : ∀ n : ℕ, ∀ v : ↥M ⧸ L,
      σA^[n] (Additive.ofMul v) = Additive.ofMul (σV^[n] v) := by
    intro n
    induction n with
    | zero => intro v; rfl
    | succ n ih =>
      intro v
      rw [Function.iterate_succ_apply, hσA_apply, ih, Function.iterate_succ_apply]
  have hσAid : ∀ a : Additive (↥M ⧸ L), σA^[ℓ] a = a := by
    intro a
    show σA^[ℓ] (Additive.ofMul (Additive.toMul a)) = Additive.ofMul (Additive.toMul a)
    rw [hσAiter, hσVpow]
  have hVpow : ∀ v : ↥M ⧸ L, v ^ ℓ = 1 := by
    intro v
    obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective L v
    rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hpowL (NK.LocalTame.IndexPrime.mem_powSub m)
  have hexpA : ∀ a : Additive (↥M ⧸ L), ℓ • a = 0 := by
    intro a
    have h : ℓ • Additive.ofMul (Additive.toMul a)
        = Additive.ofMul ((Additive.toMul a) ^ ℓ) := nsmul_ofMul' ℓ _
    rw [show a = Additive.ofMul (Additive.toMul a) from rfl, h, hVpow (Additive.toMul a),
      ofMul_one']
  have hfE_iter : ∀ a : Additive (↥M ⧸ L), fE^[ℓ] a = 0 := by
    have hfeq : ⇑fE = fun x => σA x - x := by
      funext a
      show σE a - (1 : AddMonoid.End (Additive (↥M ⧸ L))) a = σA a - a
      rw [AddMonoid.End.one_apply]
      rfl
    intro a
    rw [show fE^[ℓ] a = (fun x => σA x - x)^[ℓ] a from by rw [hfeq]]
    exact iterate_sub_eq_zero hℓ hexpA σA hσAid a
  -- the image of `[g, y]` is a value of `fE`
  have hgen : ∀ m : ↥M,
      Additive.ofMul ((QuotientGroup.mk' L) (MulAut.conjNormal (H := M) g m)) -
        Additive.ofMul ((QuotientGroup.mk' L) m) ∈ WA := by
    intro m
    have h1 : fE (Additive.ofMul ((QuotientGroup.mk' L) m)) =
        Additive.ofMul ((QuotientGroup.mk' L) (MulAut.conjNormal (H := M) g m)) -
          Additive.ofMul ((QuotientGroup.mk' L) m) := by
      rw [hfE_apply, hσA_apply, hσVmk]
    rw [← h1]
    exact AddSubgroup.subset_closure ⟨_, rfl⟩
  have hgenG : ∀ y : ↥M, conjDiff L g y ∈ WA := by
    intro y
    show Additive.ofMul ((QuotientGroup.mk' L) (MulAut.conjNormal (H := M) g y)) -
        Additive.ofMul ((QuotientGroup.mk' L) y) ∈ WA
    exact hgen y
  -- the closure induction over `⟨g⟩`
  have hzpow : ∀ x ∈ Subgroup.zpowers g, ∀ y : ↥M, conjDiff L x y ∈ WA := by
    have hclosure : Subgroup.zpowers g = Subgroup.closure ({g} : Set G) :=
      Subgroup.zpowers_eq_closure g
    intro x hx
    rw [hclosure] at hx
    induction hx using Subgroup.closure_induction with
    | mem a ha =>
      rw [Set.mem_singleton_iff] at ha
      rw [ha]
      exact hgenG
    | one => intro y; rw [conjDiff_one_left L hcommL]; exact WA.zero_mem
    | mul a b ha hb iha ihb =>
      intro y
      rw [conjDiff_mul_left L hcommL a b y]
      exact WA.add_mem (iha (MulAut.conjNormal (H := M) b y)) (ihb y)
    | inv a ha iha =>
      intro y
      obtain ⟨z, hz⟩ : ∃ z, MulAut.conjNormal (H := M) a z = y :=
        ⟨MulAut.conjNormal (H := M) a⁻¹ y, by
          rw [← conjNormal_mul_apply, mul_inv_cancel, map_one, MulAut.one_apply]⟩
      have hcomp := conjDiff_mul_left L hcommL a⁻¹ a z
      rw [inv_mul_cancel, conjDiff_one_left L hcommL] at hcomp
      have hA : conjDiff L a⁻¹ (MulAut.conjNormal (H := M) a z) = -conjDiff L a z := by
        rw [eq_neg_iff_add_eq_zero]
        exact hcomp.symm
      rw [← hz, hA]
      exact WA.neg_mem (iha z)
  have hgenmem : ∀ x ∈ Subgroup.zpowers g, ∀ m : ↥M,
      Additive.ofMul ((QuotientGroup.mk' L) ⟨⁅x, (m : G)⁆, comm_mem x m⟩) ∈ WA := by
    intro x hx m
    rw [← conjDiff_eq L hcommL x m]
    exact hzpow x hx m
  -- the multiplicative subgroup corresponding to `WA`
  set W : Subgroup (↥M ⧸ L) := (Subgroup.toAddSubgroup).symm WA with hWdef
  have hWadd : Subgroup.toAddSubgroup W = WA := by
    rw [hWdef]
    exact OrderIso.apply_symm_apply _ _
  have hWmem : ∀ v : ↥M ⧸ L, v ∈ W ↔ v ∈ WA := by
    intro v
    rw [← hWadd]
    exact Iff.rfl
  -- the image of `K` lies in `W`
  have hKW : K.map (QuotientGroup.mk' L) ≤ W := by
    rw [Subgroup.map_le_iff_le_comap, hKdef]
    have h1 : ⁅Subgroup.zpowers g, M⁆ ≤ (W.comap (QuotientGroup.mk' L)).map M.subtype := by
      refine Subgroup.commutator_le.mpr ?_
      intro a ha b hb
      refine Subgroup.mem_map.mpr ⟨⟨⁅a, (b : G)⁆, comm_mem a ⟨b, hb⟩⟩, ?_, rfl⟩
      rw [Subgroup.mem_comap]
      rw [hWmem]
      exact hgenmem a ha ⟨b, hb⟩
    intro x hx
    rw [Subgroup.mem_comap] at hx ⊢
    obtain ⟨m, hm, hmx⟩ := Subgroup.mem_map.mp (h1 hx)
    rw [Subgroup.mem_comap] at hm
    have hmx' : m = x := Subtype.ext hmx
    rw [hmx'] at hm
    exact hm
  have hKsubA : Subgroup.toAddSubgroup (K.map (QuotientGroup.mk' L)) ≤ WA := by
    intro y hy
    rw [show y ∈ Subgroup.toAddSubgroup (K.map (QuotientGroup.mk' L)) ↔
        y ∈ K.map (QuotientGroup.mk' L) from Iff.rfl] at hy
    exact (hWmem y).mp (hKW hy)
  have hKidxA : (Subgroup.toAddSubgroup (K.map (QuotientGroup.mk' L))).index ≠ 0 := by
    rw [Subgroup.index_toAddSubgroup]
    exact hKidx
  have hWAfin : (AddSubgroup.closure (Set.range fE)).FiniteIndex := by
    have hrel := AddSubgroup.relIndex_mul_index hKsubA
    have hWAf : WA.FiniteIndex := by
      rw [AddSubgroup.finiteIndex_iff]
      intro h0
      rw [h0, mul_zero] at hrel
      exact hKidxA hrel.symm
    rw [← hWAdef]
    exact hWAf
  -- Nakayama
  have hAfin : Finite (Additive (↥M ⧸ L)) :=
    finite_of_finiteIndex_range_of_iterate hℓ hexpA fE hfE_iter hWAfin
  have hVfin : Finite (↥M ⧸ L) := hAfin
  show L.index ≠ 0
  exact Subgroup.finiteIndex_iff.mp (Subgroup.finiteIndex_iff_finite_quotient.mpr hVfin)


end IndexRedo
end NK.LocalTame
