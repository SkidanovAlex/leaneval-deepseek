/-!
# The subgroup generated by the `ℓ`-th powers

For a group `G` and a natural number `ℓ`, `powSub ℓ G` is the subgroup generated by the `ℓ`-th
powers of the elements of `G`.  Together with the commutator subgroup, its closure is the
`ℓ`-Frattini subgroup of a compact group.
-/

namespace NK.LocalTame
namespace IndexPrime

/-- The subgroup generated by the `ℓ`-th powers of the elements of `G`. -/
def powSub (ℓ : ℕ) (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure (Set.range fun g : G => g ^ ℓ)

theorem mem_powSub {ℓ : ℕ} {G : Type*} [Group G] (g : G) : g ^ ℓ ∈ powSub ℓ G :=
  Subgroup.subset_closure ⟨g, rfl⟩

theorem powSub_le_iff {ℓ : ℕ} {G : Type*} [Group G] {H : Subgroup G} :
    powSub ℓ G ≤ H ↔ ∀ g : G, g ^ ℓ ∈ H := by
  rw [powSub, Subgroup.closure_le]
  constructor
  · intro h g; exact h ⟨g, rfl⟩
  · rintro h _ ⟨g, rfl⟩; exact h g

/-- A *normal* subgroup of index `ℓ` contains all `ℓ`-th powers. -/
theorem powSub_le_of_index_eq_prime {ℓ : ℕ} {G : Type*} [Group G] {H : Subgroup G} [H.Normal]
    (hH : H.index = ℓ) : powSub ℓ G ≤ H :=
  powSub_le_iff.mpr fun g => by
    have := Subgroup.pow_index_mem H g
    rwa [hH] at this

/-- A normal subgroup of index a prime `ℓ` contains the commutator subgroup. -/
theorem commutator_le_of_index_eq_prime {ℓ : ℕ} (hℓ : ℓ.Prime) {G : Type*} [Group G]
    {H : Subgroup G} [H.Normal] (hH : H.index = ℓ) : commutator G ≤ H := by
  haveI : Fact ℓ.Prime := ⟨hℓ⟩
  have hcard : Nat.card (G ⧸ H) = ℓ := by
    rw [← Subgroup.index_eq_card, hH]
  haveI : IsCyclic (G ⧸ H) := isCyclic_of_prime_card (p := ℓ) hcard
  haveI : IsMulCommutative (G ⧸ H) := IsCyclic.isMulCommutative
  exact Subgroup.Normal.quotient_commutative_iff_commutator_le.mp inferInstance

end IndexPrime
end NK.LocalTame
