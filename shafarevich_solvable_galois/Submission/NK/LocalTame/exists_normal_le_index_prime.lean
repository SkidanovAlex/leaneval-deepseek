namespace NK.LocalTame

/-- **A normal subgroup of `ℓ`-power index contains one of index `ℓ`.**

Let `G` be a group, `ℓ` a prime and `N` a normal subgroup of `G` of index `ℓ ^ k` with
`1 ≤ k`.  Then there is a normal subgroup `M` with `N ≤ M` and `[G : M] = ℓ`.

Equivalently: a finite `ℓ`-group of order `ℓ ^ k`, `k ≥ 1`, has a normal subgroup of
index `ℓ`.  The proof is the classical induction on `k` walking down the upper central
series: the centre of a nontrivial finite `ℓ`-group is nontrivial, so it contains an
element `z` of order `ℓ` whose generated subgroup is normal (it is central); passing to
the quotient by `⟨z⟩` lowers the exponent `k` by one, and the induction hypothesis is
pulled back along the quotient map.
-/
theorem exists_normal_le_index_prime {G : Type*} [Group G] {ℓ k : ℕ} (hℓ : ℓ.Prime)
    (N : Subgroup G) (hN : N.Normal) (hk : N.index = ℓ ^ k) (hk1 : 1 ≤ k) :
    ∃ M : Subgroup G, N ≤ M ∧ M.Normal ∧ M.index = ℓ := by
  -- We prove the statement by strong induction on the exponent `k`, keeping the
  -- ambient group `G` fixed: the induction step replaces `N` by the preimage of the
  -- subgroup generated by a central element of order `ℓ` in `G ⧸ N`.
  have main : ∀ k : ℕ, 1 ≤ k → ∀ (N : Subgroup G), N.Normal → N.index = ℓ ^ k →
      ∃ M : Subgroup G, N ≤ M ∧ M.Normal ∧ M.index = ℓ := by
    intro k
    refine Nat.strong_induction_on k ?_
    intro k ih hk1 N hN hk
    rcases eq_or_lt_of_le hk1 with h1 | h1
    · -- `k = 1`: `N` itself has index `ℓ`.
      exact ⟨N, le_rfl, hN, by rw [hk, ← h1, pow_one]⟩
    · -- `1 < k`: pass to `Q = G ⧸ N`, a nontrivial finite `ℓ`-group.
      have : Fact ℓ.Prime := ⟨hℓ⟩
      have : N.FiniteIndex :=
        Subgroup.finiteIndex_iff.mpr (by rw [hk]; exact pow_ne_zero _ hℓ.ne_zero)
      have : Finite (G ⧸ N) := inferInstance
      have hcard : Nat.card (G ⧸ N) = ℓ ^ k := (Subgroup.index_eq_card N).symm.trans hk
      have hP : IsPGroup ℓ (G ⧸ N) := IsPGroup.of_card hcard
      have : Nontrivial (G ⧸ N) :=
        Finite.one_lt_card_iff_nontrivial.mp (by rw [hcard]; exact one_lt_pow' hℓ.one_lt (by omega))
      -- The centre of a nontrivial finite `ℓ`-group is nontrivial.
      have : Nontrivial (Subgroup.center (G ⧸ N)) := hP.center_nontrivial
      have hZ : IsPGroup ℓ (Subgroup.center (G ⧸ N)) := hP.to_subgroup _
      have hdvd : ℓ ∣ Nat.card (Subgroup.center (G ⧸ N)) := by
        obtain ⟨n, hn0, hn⟩ := hZ.nontrivial_iff_card.mp inferInstance
        exact hn.symm ▸ dvd_pow_self _ (ne_of_gt hn0)
      -- Cauchy's theorem in the centre: a central element `z` of order `ℓ`.
      obtain ⟨z, hz⟩ : ∃ z : Subgroup.center (G ⧸ N), orderOf z = ℓ :=
        exists_prime_orderOf_dvd_card' ℓ hdvd
      let z₀ : G ⧸ N := z
      have hz₀ : orderOf z₀ = ℓ := (Subgroup.orderOf_coe z).trans hz
      have hmem₀ : z₀ ∈ Subgroup.center (G ⧸ N) := z.2
      have hCcard : Nat.card (Subgroup.zpowers z₀) = ℓ := (Nat.card_zpowers z₀).trans hz₀
      -- `⟨z⟩` is central, hence normal.
      have hCnormal : (Subgroup.zpowers z₀).Normal := ⟨fun n hn g => by
        have hnc : n ∈ Subgroup.center (G ⧸ N) := Subgroup.zpowers_le.mpr hmem₀ hn
        rw [show g * n * g⁻¹ = n from by
          rw [Subgroup.mem_center_iff.mp hnc g, mul_assoc, mul_inv_cancel, mul_one]]
        exact hn⟩
      -- Its index in `Q` is `ℓ ^ (k - 1)`.
      have hindex : (Subgroup.zpowers z₀).index = ℓ ^ (k - 1) := by
        refine Nat.mul_right_cancel hℓ.pos ?_
        calc (Subgroup.zpowers z₀).index * ℓ
            = (Subgroup.zpowers z₀).index * Nat.card (Subgroup.zpowers z₀) := by rw [hCcard]
          _ = Nat.card (G ⧸ N) := Subgroup.index_mul_card _
          _ = ℓ ^ k := hcard
          _ = ℓ ^ (k - 1) * ℓ := by rw [← pow_succ, Nat.sub_add_cancel hk1]
      -- Pull `⟨z⟩` back to `G`: a normal subgroup `N₁` with `N ≤ N₁` and `[G : N₁] = ℓ ^ (k-1)`.
      have hN₁normal : ((Subgroup.zpowers z₀).comap (QuotientGroup.mk' N)).Normal :=
        hCnormal.comap _
      have hN₁index : ((Subgroup.zpowers z₀).comap (QuotientGroup.mk' N)).index = ℓ ^ (k - 1) := by
        rw [Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective N)]
        exact hindex
      have hNle : N ≤ (Subgroup.zpowers z₀).comap (QuotientGroup.mk' N) := by
        intro n hn
        rw [Subgroup.mem_comap]
        have h1 : (QuotientGroup.mk' N) n = 1 := by
          rw [QuotientGroup.mk'_apply]
          exact (QuotientGroup.eq_one_iff n).mpr hn
        rw [h1]
        exact Subgroup.one_mem _
      obtain ⟨M, hMle, hMnorm, hMindex⟩ :=
        ih (k - 1) (by omega) (by omega) _ hN₁normal hN₁index
      exact ⟨M, hNle.trans hMle, hMnorm, hMindex⟩
  exact main k hk1 N hN hk

end NK.LocalTame
