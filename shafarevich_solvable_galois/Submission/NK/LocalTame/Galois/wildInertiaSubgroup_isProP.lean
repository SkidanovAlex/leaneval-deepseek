/-!
# The wild inertia subgroup is pro-`p`

`NK.LocalTame.wildInertiaSubgroup p` is, by definition, the join of *all* normal pro-`p`
subgroups of `Gal(K'/κ)`.  In this file we show that this join is again a pro-`p` group, so that
the wild inertia really is the *maximal* closed normal pro-`p` subgroup (`IsWildInertia`), with no
arithmetic input about `p`-adic fields required.

The mathematical content is the following.  Let `N i` be normal pro-`p` subgroups of a group `G`
and put `S = ⨆ i, N i`.  A finite index normal subgroup `K ⊴ S` gives a *finite* quotient
`Q = S/K`, generated by the (normal, pro-`p`) images `M i` of the `N i`.  A finite group generated
by normal pro-`p` subgroups is pro-`p`: a join of *finitely many* of them is pro-`p` by
`NK.LocalTame.ProP.isProP_sup_of_normal`, and finitely many suffice because among all finite
sub-joins there is a maximal one (the subgroups of the finite group `Q` form a finite set).  Hence
`Nat.card Q = p ^ k`, and `Nat.card Q = K.index`, which is what had to be shown.

Nothing here uses the topology or the arithmetic of local fields: it is pure group theory, valid
for an arbitrary natural number `p`.
-/

namespace NK.LocalTame.Galois

open scoped Classical
open NK.LocalTame.ProP

/-! ## Preliminary lemmas on pro-`p` groups -/

/-- A subsingleton group is pro-`p`: its only subgroup has index `1 = p ^ 0`. -/
theorem isProP_of_subsingleton {G : Type*} [Group G] [Subsingleton G] (p : ℕ) : IsProP p G := by
  intro N _ _
  refine ⟨0, ?_⟩
  rw [Subgroup.index_eq_card]
  exact Nat.card_eq_one_iff_unique.mpr ⟨inferInstance, inferInstance⟩

/-- **The image of a pro-`p` group is pro-`p`.**  A subgroup of finite index in `f.range` pulls
back to a subgroup of finite index (of the same index) in the source. -/
theorem isProP_range {G H : Type*} [Group G] [Group H] {p : ℕ} (f : G →* H)
    (h : IsProP p G) : IsProP p ↥(f.range) := by
  intro L hLnorm hLfin
  haveI : L.Normal := hLnorm
  haveI : (Subgroup.comap f.rangeRestrict L).Normal := Subgroup.Normal.comap hLnorm _
  have hfi : (Subgroup.comap f.rangeRestrict L).FiniteIndex := by
    rw [Subgroup.finiteIndex_iff,
      Subgroup.index_comap_of_surjective L f.rangeRestrict_surjective]
    exact Subgroup.finiteIndex_iff.mp hLfin
  obtain ⟨k, hk⟩ := h _ hfi
  exact ⟨k, by
    rw [← Subgroup.index_comap_of_surjective L f.rangeRestrict_surjective]
    exact hk⟩

/-- **A join of finitely many normal pro-`p` subgroups is pro-`p`.**  (Induction on the finite
family, using `NK.LocalTame.ProP.isProP_sup_of_normal`.) -/
theorem isProP_finset_sup {G : Type*} [Group G] {ι : Type*} {p : ℕ} (M : ι → Subgroup G)
    (hMn : ∀ i, (M i).Normal) (hMp : ∀ i, IsProP p ↥(M i)) (T : Finset ι) :
    (T.sup M).Normal ∧ IsProP p ↥(T.sup M) := by
  classical
  induction T using Finset.induction with
  | empty =>
      rw [Finset.sup_empty]
      exact ⟨Subgroup.normal_bot, isProP_of_subsingleton p⟩
  | insert a s _ ih =>
      rw [Finset.sup_insert]
      haveI : (M a).Normal := hMn a
      haveI : (s.sup M).Normal := ih.1
      exact ⟨Subgroup.sup_normal (M a) (s.sup M),
        isProP_sup_of_normal (hMn a) ih.1 (hMp a) ih.2⟩

/-! ## A finite group generated by normal pro-`p` subgroups is pro-`p` -/

/-- **A finite group generated by normal pro-`p` subgroups is pro-`p`.**

Among the joins `T.sup M` of finitely many of the `M i` there is a maximal one: they are
subgroups of the finite group `Q`, so there are only finitely many of them.  A maximal one `J`
satisfies `M i ≤ J` for every `i` (else `J ⊔ M i` would be a strictly larger finite join), hence
`J = ⊤`, and `J` is pro-`p` by `isProP_finset_sup`. -/
theorem isProP_of_iSup_eq_top {Q : Type*} [Group Q] [Finite Q] {ι : Type*} {p : ℕ}
    (M : ι → Subgroup Q) (hMn : ∀ i, (M i).Normal) (hMp : ∀ i, IsProP p ↥(M i))
    (htop : ⨆ i, M i = ⊤) : IsProP p Q := by
  classical
  -- a join of finitely many of the `M i` which is as large as possible
  obtain ⟨T₀, hmax⟩ := Set.Finite.exists_maximalFor' (fun T : Finset ι => T.sup M) Set.univ
    ((Set.finite_univ : (Set.univ : Set (Subgroup Q)).Finite).subset (Set.subset_univ _))
    Set.univ_nonempty
  have htop' : T₀.sup M = ⊤ := by
    rw [eq_top_iff]
    calc ⊤ = ⨆ i, M i := htop.symm
      _ ≤ T₀.sup M := iSup_le fun i => by
          have hle : T₀.sup M ≤ (insert i T₀).sup M := Finset.sup_mono (Finset.subset_insert i T₀)
          have h2 : (insert i T₀).sup M ≤ T₀.sup M := hmax.2 (Set.mem_univ _) hle
          exact le_trans (Finset.le_sup (Finset.mem_insert_self i T₀)) h2
  have hJ := (isProP_finset_sup M hMn hMp T₀).2
  rw [htop'] at hJ
  exact (isProP_congr Subgroup.topEquiv p).mp hJ

/-! ## The main group theoretic statement -/

/-- **A join of normal pro-`p` subgroups is pro-`p`.**  For `p : ℕ` arbitrary and `N : ι → Subgroup G`
a family of normal subgroups with `IsProP p ↥(N i)`, the subgroup `⨆ i, N i` is again pro-`p`.

Indeed, let `K ◁ S := ⨆ i, N i` have finite index.  In the finite quotient `Q = S/K` the images of
the `N i` are normal pro-`p` subgroups generating `Q`, so `Q` is pro-`p` by
`isProP_of_iSup_eq_top`; in particular `Nat.card Q = K.index` is a power of `p`. -/
theorem isProP_iSup_of_normal {G : Type*} [Group G] {ι : Type*} {p : ℕ} (N : ι → Subgroup G)
    (hN : ∀ i, (N i).Normal) (hp : ∀ i, IsProP p ↥(N i)) :
    IsProP p ↥(⨆ i, N i) := by
  classical
  intro K hKnorm hKfin
  haveI : K.Normal := hKnorm
  let S : Subgroup G := ⨆ i, N i
  haveI : Finite (↥S ⧸ K) := Subgroup.finiteIndex_iff_finite_quotient.mp hKfin
  let φ : ↥S →* (↥S ⧸ K) := QuotientGroup.mk' K
  -- the images of the `N i` in the finite quotient `S ⧸ K`
  let M : ι → Subgroup (↥S ⧸ K) := fun i => (φ.comp (Subgroup.inclusion (le_iSup N i))).range
  have hMi : ∀ i, M i = Subgroup.map φ ((N i).subgroupOf S) := by
    intro i
    show (φ.comp (Subgroup.inclusion (le_iSup N i))).range = _
    rw [MonoidHom.range_comp, Subgroup.inclusion_range]
  have hMn : ∀ i, (M i).Normal := by
    intro i
    rw [hMi i]
    exact Subgroup.Normal.map ((hN i).subgroupOf S) φ (QuotientGroup.mk'_surjective K)
  have hMp : ∀ i, IsProP p ↥(M i) :=
    fun i => isProP_range (φ.comp (Subgroup.inclusion (le_iSup N i))) (hp i)
  -- the `M i` generate the quotient
  have hsupA : (⨆ i, (N i).subgroupOf S) = ⊤ := by
    have hmap : Subgroup.map S.subtype (⨆ i, (N i).subgroupOf S) = S := by
      rw [Subgroup.map_iSup]
      exact iSup_congr fun i => by
        rw [Subgroup.subgroupOf_map_subtype, inf_eq_left.mpr (le_iSup N i)]
    refine (Subgroup.eq_top_iff' _).mpr ?_
    intro x
    have hx : (x : G) ∈ Subgroup.map S.subtype (⨆ i, (N i).subgroupOf S) := by
      rw [hmap]
      exact x.2
    obtain ⟨y, hy, hyx⟩ := Subgroup.mem_map.mp hx
    have hyx' : y = x := Subtype.ext (by simpa using hyx)
    rwa [← hyx']
  have hsup : (⨆ i, M i) = ⊤ := by
    have h1 : (⨆ i, M i) = Subgroup.map φ (⨆ i, (N i).subgroupOf S) := by
      rw [Subgroup.map_iSup]
      exact iSup_congr hMi
    rw [h1, hsupA, Subgroup.map_top_of_surjective φ (QuotientGroup.mk'_surjective K)]
  have hQ : IsProP p (↥S ⧸ K) := isProP_of_iSup_eq_top M hMn hMp hsup
  have hbot : (⊥ : Subgroup (↥S ⧸ K)).FiniteIndex :=
    Subgroup.finiteIndex_iff_finite_quotient.mpr inferInstance
  obtain ⟨k, hk⟩ := hQ ⊥ hbot
  refine ⟨k, ?_⟩
  rw [Subgroup.index_eq_card, ← hk, Subgroup.index_eq_card]
  exact (Nat.card_congr QuotientGroup.quotientBot.toEquiv).symm

end NK.LocalTame.Galois

namespace NK.LocalTame.Galois

open scoped Classical
open NK.LocalAnabelian

/-- **The wild inertia subgroup `V_κ = ⨆ {N ◁ G_κ : N pro-`p`}` of `Gal(K'/κ)` is pro-`p`.**

This is the group-theoretic half of the definition of the wild inertia (NSW (7.5.7) Corollary);
with it, `wildInertiaSubgroup p` is the *unique maximal* closed normal pro-`p` subgroup of
`Gal(K'/κ)` (`NK.LocalTame.isWildInertia_wildInertiaSubgroup`), with no arithmetic input. -/
theorem wildInertiaSubgroup_isProP {κ K' : Type*} [Field κ] [Field K'] [Algebra κ K'] (p : ℕ) :
    IsProP p ↥(wildInertiaSubgroup (κ := κ) (K' := K') p) := by
  rw [wildInertiaSubgroup]
  exact isProP_iSup_of_normal
    (fun N : {N : Subgroup (Gal(K'/κ)) // N.Normal ∧ IsProP p ↥N} => N.1)
    (fun N => N.2.1) (fun N => N.2.2)

end NK.LocalTame.Galois
