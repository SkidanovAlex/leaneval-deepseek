/-!
# Normal subgroups of prime index of an open normal subgroup are open

Let `G` be a compact Hausdorff topological group, `ℓ` a prime, and suppose that every *normal*
subgroup of `G` of index `ℓ` is open (`hopen`).  If `M ⊴ G` is open with `M.index = ℓ` and
`P ⊴ M` has index `ℓ`, then `P` is open in `M`.

## Strategy

Since `[M : P] = ℓ` is prime, `M ⧸ P` is cyclic of order `ℓ`, so `P` contains the commutator
subgroup `[M,M]` and all `ℓ`-th powers `M ^ ℓ`; hence `M'M^ℓ ≤ P`.

* `NK.LocalTame.IndexRedo.frattini_index_ne_zero_index_eq_prime` shows that `[M : M'M^ℓ]` is
  finite, i.e. that `M'M^ℓ` (a subgroup generated by a *compact* set, which rules out the usual
  obstruction "finite index ⟹ open") has finite index in `M`.
* `NK.LocalTame.IndexRedo.isOpen_of_index_prime_of_frattini_index` (proved by a Baire category
  argument) then concludes that every normal subgroup of `M` of index `ℓ` — in particular `P` —
  is open.

The two ingredients are the two halves of the descent step of the `ℓ`-Frattini theory developed
in `NK.LocalTame.IndexPrime` and `NK.LocalTame.IndexRedo`.
-/

namespace NK.LocalTame

theorem normalIndexPrimeOpen_of_openNormal {G : Type*} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] [T2Space G] {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hopen : ∀ H : Subgroup G, H.index = ℓ → H.Normal → IsOpen (H : Set G))
    (M : Subgroup G) (hMN : M.Normal) (hMo : IsOpen (M : Set G)) (hMi : M.index = ℓ)
    (P : Subgroup M) (hP : P.Normal) (hPi : P.index = ℓ) : IsOpen (P : Set M) := by
  haveI : CompactSpace ↥M :=
    (isCompact_iff_compactSpace).mp (Subgroup.isClosed_of_isOpen M hMo).isCompact
  -- The `ℓ`-Frattini subgroup of `M` has finite index in `M`.
  have hfin : (IndexPrime.powSub ℓ ↥M ⊔ commutator ↥M).index ≠ 0 :=
    IndexRedo.frattini_index_ne_zero_index_eq_prime (G := G) hℓ hopen M hMN hMo hMi
  -- Hence every normal subgroup of `M` of index `ℓ` is open.
  exact IndexRedo.isOpen_of_index_prime_of_frattini_index hℓ hfin P hP hPi

end NK.LocalTame
