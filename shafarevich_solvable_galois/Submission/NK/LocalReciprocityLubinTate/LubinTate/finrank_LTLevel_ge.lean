/-!
# The lower bound for the degree of a Lubin–Tate level

Milne, *CFT*, §I.3.  The `n`-th Lubin–Tate level `K_n = F(Λ_n)` contains the roots of the
Eisenstein factor `f^{[n-1]}(T) = f^{(n-2)}(T)^{q-1} + π`, because `Λ_n` is the union of `Λ_{n-1}`
with the roots of `f^{[n-1]}`.  Since `f^{[n-1]}` is monic of degree `(q-1)q^{n-1}` and irreducible
over `F`, the simple extension generated by any one of its roots already has degree
`(q-1)q^{n-1}` over `F`; consequently

`[K_n : F] ≥ (q - 1) q ^ (n - 1)`.

This is the *lower* bound half of Milne I.3.1 for the `n`-th level of the Lubin–Tate tower; the
upper bound is `Module.finrank F K_n ≤ q^n - q^{n-1}` when the level is totally ramified of the
expected degree, i.e. the equality `[K_n : F] = (q-1)q^{n-1}` for the standard Lubin–Tate
polynomial.

## Main result

* `NK.LocalReciprocityLubinTate.LubinTate.finrank_LTLevel_ge`
-/

namespace NK.LocalReciprocityLubinTate.LubinTate

universe u

noncomputable section

open Polynomial

/-- **The degree of the `n`-th Lubin–Tate level is at least `(q-1)q^{n-1}`.**

The level `K_n = F(Λ_n)` is generated by the `π^n`-division points, so it contains a root `x` of
the Eisenstein factor `f^{[n-1]} = (f^{(n-2)})^{q-1} + π` (indeed `Λ_n = Λ_{n-1} ∪` roots of
`f^{[n-1]}`).  That polynomial is irreducible of degree `(q-1)q^{n-1}`, so `F(x) ⊆ K_n` already has
degree `(q-1)q^{n-1}` over `F`, and degrees are monotone in the intermediate field. -/
theorem finrank_LTLevel_ge (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π)
    (q n : ℕ) (hq : 2 ≤ q) (hn : 1 ≤ n) :
    (q - 1) * q ^ (n - 1) ≤ Module.finrank F ↥(NK.LocalReciprocityLubinTate.LTLevel F (π : F) q n) := by
  have hq1 : 1 ≤ q := by omega
  -- the Eisenstein factor `f^{[n-1]}` is irreducible
  have hirr := NK.LocalReciprocityLubinTate.irreducible_LTpolyEis F π hπ q (n - 1) hq
  -- hence its image in the algebraic closure is non-constant, so it has a root there
  have hdeg : ((LTpolyEis (π : F) q (n - 1)).map (algebraMap F (AlgebraicClosure F))).degree ≠ 0 := by
    rw [Polynomial.degree_map_eq_of_injective (algebraMap F (AlgebraicClosure F)).injective]
    exact (Polynomial.degree_pos_of_irreducible hirr).ne'
  obtain ⟨x, hx⟩ := IsAlgClosed.exists_root
    ((LTpolyEis (π : F) q (n - 1)).map (algebraMap F (AlgebraicClosure F))) hdeg
  -- rewrite the root condition as an `aeval` condition
  have hx' : (aeval x) (LTpolyEis (π : F) q (n - 1)) = 0 := by
    rw [Polynomial.IsRoot.def] at hx
    rwa [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
  -- `x` is a `π^n`-division point: `f^{(n)} = f^{[n-1]} · f^{(n-1)}`
  have hxmem : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n := by
    rw [NK.LocalReciprocityLubinTate.mem_LTdivisionSet_iff (π : F) q n hq]
    have hfac : LTpolyIter (π : F) q n
        = LTpolyEis (π : F) q (n - 1) * LTpolyIter (π : F) q (n - 1) := by
      conv_lhs => rw [← Nat.sub_add_cancel hn]
      exact NK.LocalReciprocityLubinTate.LTpolyIter_succ_eq_mul (π : F) q (n - 1) hq1
    rw [hfac, Polynomial.aeval_mul, hx', zero_mul]
  -- so `x` lies in the level `K_n`
  have hxL : x ∈ (LTLevel F (π : F) q n : Set (AlgebraicClosure F)) :=
    NK.LocalReciprocityLubinTate.LTdivisionSet_subset_LTLevel F (π : F) q n hxmem
  have hle : IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F))
      ≤ LTLevel F (π : F) q n := by
    rw [IntermediateField.adjoin_le_iff]
    intro y hy
    rw [Set.mem_singleton_iff] at hy
    subst hy
    exact hxL
  -- the level is finite over `F`, and `F(x)` has degree `(q-1)q^{n-1}`
  haveI := finiteDimensional_LTLevel F (π : F) q n hq
  calc (q - 1) * q ^ (n - 1)
      = Module.finrank F ↥(IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F))) :=
        (finrank_adjoin_root_LTpolyEis F π hπ q (n - 1) hq hx').symm
    _ ≤ Module.finrank F ↥(LTLevel F (π : F) q n) :=
        IntermediateField.finrank_le_of_le_right hle

end

end NK.LocalReciprocityLubinTate.LubinTate
