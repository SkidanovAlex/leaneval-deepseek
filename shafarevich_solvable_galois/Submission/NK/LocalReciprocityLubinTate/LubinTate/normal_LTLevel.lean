namespace NK.LocalReciprocityLubinTate.LubinTate

universe u

/-- The Lubin–Tate level `K_n = F(Λ_n)` is normal over `F`.

`Λ_n` is the set of roots in the algebraic closure of the iterate `f^{(n)}` of the standard
Lubin–Tate polynomial `f(T) = πT + T^q`, and `K_n = F(Λ_n)` is generated by those roots.  Since
`K_n` is by definition the subfield generated by all the roots of `f^{(n)}`, it is the splitting
field of `f^{(n)}` over `F`, hence normal over `F` (no separability is needed here). -/
theorem normal_LTLevel (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : F) (q n : ℕ) (hq : 2 ≤ q) :
    Normal F ↥(NK.LocalReciprocityLubinTate.LTLevel F π q n) := by
  -- `K_n` is the adjoin of the roots of the iterate, which is a splitting field of it.
  have hp : ((LTpolyIter π q n).map (algebraMap F (AlgebraicClosure F))).Splits :=
    IsAlgClosed.splits _
  have hsplit : Polynomial.IsSplittingField F ↥(LTLevel F π q n) (LTpolyIter π q n) :=
    IntermediateField.adjoin_rootSet_isSplittingField hp
  exact Normal.of_isSplittingField (LTpolyIter π q n)

end NK.LocalReciprocityLubinTate.LubinTate
