/-
# The evaluation at a torsion point lands in `F(x)`

For `x ∈ Λ_n`, the evaluation homomorphism
`evMap x : 𝒪[F][T]/(f^{(n)}(T)) → AlgebraicClosure F` (`τ ↦ x`) of `Eval/TorsionRing.lean` has
image contained in the subfield `F(x) ⊆ K_n` generated by `x`.

The reason is purely formal.  The homomorphism `evMap x` is the lift, along
`𝒪[F][T]/(f^{(n)}(T)) → F[X] → AlgebraicClosure F`, of the coefficient map `𝒪[F] → F`, and it
sends the class `τ` of `T` to `x`.  Hence for `u = mk p g` we have
`evMap x u = g.eval₂ ((algebraMap F _).comp (algebraMap (O F) F)) x
           = aeval x (g.map (algebraMap (O F) F))`,
the value at `x` of a polynomial with coefficients in `F`.  Values of that shape lie in the
`F`-subalgebra `Algebra.adjoin F {x}` generated by `x`, which is contained in the intermediate
field `IntermediateField.adjoin F {x} = F(x)`.
-/
import Mathlib
import Submission.NK.LocalReciprocityLubinTate.Eval.TorsionRing
import Submission.NK.LocalReciprocityLubinTate.Eval.evMap_tau
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open Polynomial

namespace NK.LocalReciprocityLubinTate.Eval

universe u

section Adjoin

variable {F : Type u} [Field F]

/-- A value at `x` of a polynomial with coefficients in `F` lies in the `F`-subalgebra generated
by `x`. -/
theorem aeval_mem_adjoin_singleton (x : AlgebraicClosure F) (p : Polynomial F) :
    (Polynomial.aeval x) p ∈ Algebra.adjoin F ({x} : Set (AlgebraicClosure F)) := by
  rw [Algebra.adjoin_singleton_eq_range_aeval]
  exact ⟨p, rfl⟩

/-- The `F`-subalgebra generated by `x` is contained in the intermediate field `F(x)`. -/
theorem adjoin_singleton_subset_intermediateField_adjoin (x : AlgebraicClosure F) :
    (Algebra.adjoin F ({x} : Set (AlgebraicClosure F)) : Set (AlgebraicClosure F)) ⊆
      (IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F)) : Set (AlgebraicClosure F)) :=
  Algebra.adjoin_le_iff.mpr
    (Set.singleton_subset_iff.mpr (IntermediateField.mem_adjoin_simple_self F x))

end Adjoin

/-- **The evaluation at a torsion point lands in `F(x)`**: for `x ∈ Λ_n` (the `n`-th Lubin–Tate
torsion set) the image of `evMap x : 𝒪[F][T]/(f^{(n)}(T)) → AlgebraicClosure F`, `τ ↦ x`, is
contained in `F(x) = F⟮x⟯`. -/
theorem evMap_mem_adjoin_singleton {F : Type*} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F]
    (π : ↥(ValuativeRel.valuation F).integer) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (x : AlgebraicClosure F)
    (hx : x ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n)
    (u : NK.LocalReciprocityLubinTate.Eval.LTtorsionRing F π q n) :
    NK.LocalReciprocityLubinTate.Eval.evMap π q n hq x hx u ∈
      (IntermediateField.adjoin F ({x} : Set (AlgebraicClosure F)) : Set (AlgebraicClosure F)) := by
  -- every element of the ambient ring is the class of a polynomial
  obtain ⟨g, hg⟩ :=
    AdjoinRoot.mk_surjective (g := NK.LocalReciprocityLubinTate.LTpolyIter π q n) u
  rw [← hg]
  -- the evaluation of such a class is the value at `x` of a polynomial with `F`-coefficients
  have key : NK.LocalReciprocityLubinTate.Eval.evMap π q n hq x hx
        (AdjoinRoot.mk (NK.LocalReciprocityLubinTate.LTpolyIter π q n) g)
      = (Polynomial.aeval x) (g.map (algebraMap (O F) F)) := by
    simp only [NK.LocalReciprocityLubinTate.Eval.evMap]
    rw [AdjoinRoot.lift_mk, Polynomial.aeval_def, Polynomial.eval₂_map]
  rw [key]
  exact adjoin_singleton_subset_intermediateField_adjoin x
    (aeval_mem_adjoin_singleton x (g.map (algebraMap (O F) F)))

end NK.LocalReciprocityLubinTate.Eval
