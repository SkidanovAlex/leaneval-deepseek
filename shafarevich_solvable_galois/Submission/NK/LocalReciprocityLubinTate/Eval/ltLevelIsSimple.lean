/-
# The Lubin–Tate level is generated by one primitive division point (unconditional)

This file discharges the fibre hypothesis of `Eval/ltLevelIsSimple_of_fibre.lean` using the fibre
computation `Eval/exists_mem_principalUnits_of_aeval_eq.lean` and the canonical Lubin–Tate module
over `𝒪[F]` (`lubinTateModule_integers`), and then records the two classical consequences:

* `NK.LocalReciprocityLubinTate.finrank_LTLevel_eq`: `[K_n : F] = (q-1)q^{n-1}`;
* `NK.LocalReciprocityLubinTate.card_aut_LTLevel_eq`: `#Gal(K_n/F) = (q-1)q^{n-1}`

for `q = residueCard F`, unconditionally (Milne, *CFT*, Theorem I.3.1 and 3.6 (a),(b); Serre,
*Local Fields*, Ch. XV §4).

## Main results

* `NK.LocalReciprocityLubinTate.ltLevelIsSimple_residueCard`;
* `NK.LocalReciprocityLubinTate.finrank_LTLevel_eq`;
* `NK.LocalReciprocityLubinTate.card_aut_LTLevel_eq`.
-/
import Mathlib
import Submission.NK.LocalReciprocityLubinTate.Eval.ltLevelIsSimple_of_fibre
import Submission.NK.LocalReciprocityLubinTate.Eval.exists_mem_principalUnits_of_aeval_eq
import Submission.NK.LocalReciprocityLubinTate.Eval.law_factorization_lubinTate
import Submission.NK.LocalReciprocityLubinTate.LubinTate.Integers
import Submission.NK.LocalReciprocityLubinTate.LubinTate.finrank_LTLevel_eq_of_isSimple
import Submission.NK.LocalReciprocityLubinTate.LubinTate.card_aut_LTLevel_eq_of_isSimple
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

open scoped ValuativeRel
open Polynomial

namespace NK.LocalReciprocityLubinTate

universe u

/-- **The Lubin–Tate level is generated by any primitive division point.**  For a nonarchimedean
local field `F` of characteristic zero and an irreducible `π ∈ 𝒪[F]`, every `π^n`-division point of
the standard Lubin–Tate group of `π` lies in the field generated by any single *primitive* one:

  `Λ_n ⊆ F(y)`  for  `y ∈ Λ_n ∖ Λ_{n-1}`,

i.e. `F(Λ_n) = F(y)`.

This is Milne, *CFT*, Theorem I.3.1 in its structural form (`Λ_n` is a free `𝒪[F]/π^n`-module of
rank one, so that any primitive point generates it), obtained here without the `𝒪[F]`-module
structure on `Λ_n`: the fibre formula `Eval.exists_mem_principalUnits_of_aeval_eq` plays the role of
the module isomorphism. -/
theorem ltLevelIsSimple_residueCard {F : Type u} [Field F] [CharZero F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π) (n : ℕ) (hn : 1 ≤ n) :
    LTLevelIsSimple F (π : F) (residueCard F) n := by
  classical
  obtain ⟨M, hpi⟩ := lubinTateModule_integers F π hπ
  obtain ⟨Θ, hΘ, hlaw⟩ := LubinTateModule.exists_unit_factorization π hπ
    (residueCard F) M
  exact Eval.ltLevelIsSimple_of_fibre π hπ (residueCard F) n (two_le_residueCard F) hn rfl M hpi
    (fun N hN w z hw hw' hz hf =>
      Eval.exists_mem_principalUnits_of_aeval_eq π hπ N hN M hpi Θ hΘ hlaw hw hw' hz hf)

/-- **The degree of the `n`-th Lubin–Tate level** (Milne, *CFT*, Theorem 3.6 (a); Serre,
*Local Fields*, Ch. XV §4): for `n ≥ 1`,

  `[F(Λ_n) : F] = (q-1) q^{n-1}`.

This is unconditional for `q = residueCard F`. -/
theorem finrank_LTLevel_eq {F : Type u} [Field F] [CharZero F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π) (n : ℕ) (hn : 1 ≤ n) :
    Module.finrank F ↥(LTLevel F (π : F) (residueCard F) n)
      = (residueCard F - 1) * residueCard F ^ (n - 1) :=
  LubinTate.finrank_LTLevel_eq_of_isSimple F π hπ (residueCard F) n (two_le_residueCard F) hn
    (ltLevelIsSimple_residueCard π hπ n hn)

/-- **The Galois group of the `n`-th Lubin–Tate level** (Milne, *CFT*, Theorem 3.6 (b)): for
`n ≥ 1`, `#Gal(F(Λ_n)/F) = (q-1) q^{n-1}`, unconditionally for `q = residueCard F`. -/
theorem card_aut_LTLevel_eq {F : Type u} [Field F] [CharZero F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F]
    (π : (↥(ValuativeRel.valuation F).integer)) (hπ : Irreducible π) (n : ℕ) (hn : 1 ≤ n) :
    Nat.card (↥(LTLevel F (π : F) (residueCard F) n) ≃ₐ[F]
        ↥(LTLevel F (π : F) (residueCard F) n))
      = (residueCard F - 1) * residueCard F ^ (n - 1) :=
  LubinTate.card_aut_LTLevel_eq_of_isSimple F π hπ (residueCard F) n (two_le_residueCard F) hn
    (ltLevelIsSimple_residueCard π hπ n hn)

end NK.LocalReciprocityLubinTate
