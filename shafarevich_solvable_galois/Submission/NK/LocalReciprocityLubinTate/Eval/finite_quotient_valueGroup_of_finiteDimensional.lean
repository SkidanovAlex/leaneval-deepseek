namespace NK.LocalReciprocityLubinTate.Eval

open MonoidWithZeroHom

variable {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]

/-- The valuation, restricted to the units of the field, as a homomorphism into the units of the
value group.  For `x : Aˣ` this is the unit of the value group with underlying value `v x`. -/
noncomputable def unitsVal {A : Type*} {Γ : Type*} [GroupWithZero A] [GroupWithZero Γ]
    (v : A →*₀ Γ) : Aˣ →* Γˣ where
  toFun x := Units.mk0 (v x) (map_ne_zero v |>.mpr (Units.ne_zero x))
  map_one' := by ext; simp
  map_mul' := by intro x y; ext; simp [map_mul]

@[simp] lemma unitsVal_coe {A : Type*} {Γ : Type*} [GroupWithZero A] [GroupWithZero Γ]
    (v : A →*₀ Γ) (u : Aˣ) : ((unitsVal v u : Γˣ) : Γ) = v (u : A) := rfl

/-- For a monoid-with-zero homomorphism `f` out of a group with zero, the value group `f.valueGroup`
(the subgroup of the units of the codomain generated by the range of `f`) is exactly the range of
`unitsVal f`: the values of the nonzero elements of the source. -/
lemma valueGroup_eq_range_unitsVal {A : Type*} {Γ : Type*} [GroupWithZero A] [GroupWithZero Γ]
    (f : A →*₀ Γ) : f.valueGroup = (unitsVal f).range := by
  apply le_antisymm
  · rw [MonoidWithZeroHom.valueGroup_def]
    refine (Subgroup.closure_le (unitsVal f).range).mpr ?_
    intro b hb
    simp only [SetLike.mem_coe, MonoidWithZeroHom.mem_valueMonoid_iff, Set.mem_preimage,
      Set.mem_range] at hb
    obtain ⟨a, ha⟩ := hb
    have ha0 : a ≠ 0 := by
      rintro rfl
      exact Units.ne_zero b (by rw [← ha, map_zero])
    refine ⟨Units.mk0 a ha0, ?_⟩
    ext
    simpa [unitsVal] using ha
  · rintro u ⟨x, rfl⟩
    exact MonoidWithZeroHom.mem_valueGroup f ⟨x, by simp [unitsVal]⟩

/-- **The ramification index of a finite extension is at most its degree.**  For a finite-dimensional
field extension `K ⊆ L` and a surjective valuation `v : L → Γ`, the quotient of the units of the
value group `Γ` by the value group of the restriction of `v` to `K` is finite, of cardinality at
most `[L : K]`.

The valuation `v` is surjective whenever it is the valuation attached to a valuation subring of `L`,
which is the case of interest (see
`finite_quotient_valueGroup_of_finiteDimensional`). -/
theorem finite_quotient_valueGroup_of_finiteDimensional_general
    {K L Γ : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
    [LinearOrderedCommGroupWithZero Γ] (v : Valuation L Γ) (hv : Function.Surjective ⇑v) :
    Finite (Γˣ ⧸ MonoidWithZeroHom.valueGroup
        (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L)))) ∧
      Nat.card (Γˣ ⧸ MonoidWithZeroHom.valueGroup
        (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L)))) ≤ Module.finrank K L := by
  classical
  set H : Subgroup Γˣ := MonoidWithZeroHom.valueGroup
    (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L))) with hH
  have hHrange : H = (unitsVal (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L)))).range := by
    rw [hH, valueGroup_eq_range_unitsVal]
  set φ : Lˣ →* Γˣ := unitsVal (MonoidWithZeroHom.ofClass v) with hφ
  have hφcoe : ∀ u : Lˣ, ((φ u : Γˣ) : Γ) = v (u : L) := fun u => rfl
  -- every element of the value group is the value of a unit of `L`
  have hsurj : ∀ g : Γˣ, ∃ u : Lˣ, φ u = g := by
    intro g
    obtain ⟨y, hy⟩ := hv (g : Γ)
    have hy0 : y ≠ 0 := by
      rintro rfl
      exact g.ne_zero (by rw [← hy, map_zero])
    refine ⟨Units.mk0 y hy0, ?_⟩
    ext
    simpa [hφcoe, hy]
  -- choose, for every coset, a unit of `L` mapping to a representative of the coset
  let χ : Γˣ ⧸ H → Lˣ := fun c => Classical.choose (hsurj (Quotient.out c))
  have hχ : ∀ c : Γˣ ⧸ H, φ (χ c) = Quotient.out c :=
    fun c => Classical.choose_spec (hsurj (Quotient.out c))
  have hgval : ∀ c : Γˣ ⧸ H, ((Quotient.out c : Γˣ) : Γ) = v (χ c : L) := by
    intro c
    rw [← hχ c]
    rfl
  -- the chosen representatives of distinct cosets are not congruent modulo `H`
  have hsep : ∀ c c' : Γˣ ⧸ H, c ≠ c' → Quotient.out c * (Quotient.out c')⁻¹ ∉ H := by
    intro c c' hne hmem
    haveI : H.Normal := Subgroup.normal_of_isMulCommutative H
    have h1 : (QuotientGroup.mk' H) (Quotient.out c) = c := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.out_eq']
    have h2 : (QuotientGroup.mk' H) (Quotient.out c') = c' := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.out_eq']
    have h3 : (QuotientGroup.mk' H) (Quotient.out c * (Quotient.out c')⁻¹) = 1 := by
      rw [QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact hmem
    rw [map_mul, map_inv, h1, h2] at h3
    exact hne (mul_inv_eq_one.mp h3)
  have hmemψ : ∀ u : Kˣ,
      unitsVal (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L))) u ∈ H := by
    intro u
    rw [hHrange]
    exact ⟨u, rfl⟩
  -- distinct cosets have distinct valuations modulo `v(Kˣ)`
  have hvalne : ∀ (c c' : Γˣ ⧸ H) (a a' : K), c ≠ c' → a ≠ 0 → a' ≠ 0 →
      v (a • (χ c : L)) ≠ v (a' • (χ c' : L)) := by
    intro c c' a a' hne ha ha' heq
    set A : Γˣ := unitsVal (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L))) (Units.mk0 a ha)
      with hA
    set C : Γˣ := unitsVal (MonoidWithZeroHom.ofClass (v.comap (algebraMap K L))) (Units.mk0 a' ha')
      with hC
    -- the two products `A * φ (χ c)` and `C * φ (χ c')` have the same value
    have hAB : A * φ (χ c) = C * φ (χ c') := by
      have h := heq
      rw [Algebra.smul_def, Algebra.smul_def, map_mul, map_mul, ← hgval c, ← hgval c'] at h
      ext
      simp only [hA, hC, Units.val_mul, hφcoe, hχ, unitsVal_coe, Units.val_mk0]
      exact h
    have hkey : φ (χ c) * (φ (χ c'))⁻¹ = A⁻¹ * C := by
      have h1 : A * φ (χ c) * (φ (χ c'))⁻¹ = C := by
        rw [hAB, mul_assoc, mul_inv_cancel, mul_one]
      calc φ (χ c) * (φ (χ c'))⁻¹ = A⁻¹ * (A * φ (χ c) * (φ (χ c'))⁻¹) := by group
        _ = A⁻¹ * C := by rw [h1]
    have hmem : φ (χ c) * (φ (χ c'))⁻¹ ∈ H := by
      rw [hkey]
      exact H.mul_mem (H.inv_mem (by rw [hA]; exact hmemψ _))
        (by rw [hC]; exact hmemψ _)
    exact hsep c c' hne (by rw [← hχ c, ← hχ c']; exact hmem)
  -- representatives of the cosets are `K`-linearly independent
  have hli : LinearIndependent K (fun c : Γˣ ⧸ H => (χ c : L)) := by
    rw [linearIndependent_iff']
    intro s a hrel c hc
    by_contra hac
    set t : Finset (Γˣ ⧸ H) := s.filter (fun d => a d ≠ 0) with ht
    have htc : c ∈ t := by rw [ht, Finset.mem_filter]; exact ⟨hc, hac⟩
    have hrelt : ∑ d ∈ t, a d • (χ d : L) = 0 := by
      refine (Finset.sum_subset ?_ ?_).trans hrel
      · intro d hd
        rw [ht] at hd
        exact (Finset.mem_filter.mp hd).1
      · intro d hds hdt
        have h0 : a d = 0 := by
          by_contra h
          exact hdt (by rw [ht, Finset.mem_filter]; exact ⟨hds, h⟩)
        rw [h0, zero_smul]
    -- take an element of the support of maximal valuation
    obtain ⟨c₀, hc₀t, hmax⟩ := Finset.exists_max_image t (fun d => v (a d • (χ d : L)))
      ⟨c, htc⟩
    have hc₀0 : a c₀ ≠ 0 := by
      have := hc₀t
      rw [ht, Finset.mem_filter] at this
      exact this.2
    have hstrict : ∀ d ∈ t.erase c₀, v (a d • (χ d : L)) < v (a c₀ • (χ c₀ : L)) := by
      intro d hd
      rw [Finset.mem_erase] at hd
      obtain ⟨hdne, hdt⟩ := hd
      have hd0 : a d ≠ 0 := by
        have := hdt
        rw [ht, Finset.mem_filter] at this
        exact this.2
      exact lt_of_le_of_ne (hmax d hdt) (hvalne d c₀ (a d) (a c₀) hdne hd0 hc₀0)
    have hg0 : v (a c₀ • (χ c₀ : L)) ≠ 0 := by
      rw [Valuation.ne_zero_iff]
      exact smul_ne_zero hc₀0 (Units.ne_zero (χ c₀))
    have hlt : v (∑ d ∈ t.erase c₀, a d • (χ d : L)) < v (a c₀ • (χ c₀ : L)) :=
      v.map_sum_lt hg0 hstrict
    have hcomp : ∑ d ∈ t.erase c₀, a d • (χ d : L) = -(a c₀ • (χ c₀ : L)) := by
      have h := Finset.sum_erase_add t (fun d => a d • (χ d : L)) hc₀t
      rw [hrelt] at h
      exact eq_neg_of_add_eq_zero_left h
    rw [hcomp, Valuation.map_neg] at hlt
    exact (lt_irrefl _) hlt
  have hfin : Finite (Γˣ ⧸ H) := hli.finite
  haveI : Fintype (Γˣ ⧸ H) := Fintype.ofFinite _
  exact ⟨hfin, by rw [Nat.card_eq_fintype_card]; exact hli.fintype_card_le_finrank⟩

/-- For a finite extension `K ⊆ L` of fields and a valuation subring `W` of `L`, the quotient of the
value group of `W` by the value group of the restriction of the valuation to `K` is finite and has
cardinality at most `[L : K]`. -/
theorem finite_quotient_valueGroup_of_finiteDimensional
    {K L : Type*} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
    (W : ValuationSubring L) :
    Finite (W.ValueGroupˣ ⧸
        MonoidWithZeroHom.valueGroup
          (MonoidWithZeroHom.ofClass (W.valuation.comap (algebraMap K L)))) ∧
      Nat.card (W.ValueGroupˣ ⧸
        MonoidWithZeroHom.valueGroup
          (MonoidWithZeroHom.ofClass (W.valuation.comap (algebraMap K L))))
        ≤ Module.finrank K L :=
  finite_quotient_valueGroup_of_finiteDimensional_general W.valuation W.valuation_surjective

end NK.LocalReciprocityLubinTate.Eval
