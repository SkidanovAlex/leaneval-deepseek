open scoped ValuativeRel
open Polynomial MvPowerSeries

namespace NK.LocalReciprocityLubinTate.Eval

noncomputable section

universe u

/-- The ring of integers `𝒪[F]` of a nonarchimedean local field. -/
abbrev O (F : Type u) [Field F] [ValuativeRel F] : Type u := ↥(ValuativeRel.valuation F).integer

/-- **The ambient ring of the torsion-point evaluation**: `𝒪[F][T]/(f^{(n)}(T))`, where
`f(T) = πT + T^q` is the standard Lubin–Tate polynomial of the uniformiser `π`.

It is a free `𝒪[F]`-module of rank `q^n`; it carries the `𝔪[F]`-adic topology, and the class of `T`
is topologically nilpotent (`f^{(n)}` is monic with all lower coefficients divisible by `π`). -/
abbrev LTtorsionRing (F : Type u) [Field F] [ValuativeRel F] (π : O F) (q n : ℕ) : Type u :=
  AdjoinRoot (LTpolyIter π q n)

namespace LTtorsionRing

variable {F : Type u} [Field F] [ValuativeRel F]

instance (π : O F) (q n : ℕ) : CommRing (LTtorsionRing F π q n) := inferInstance

instance (π : O F) (q n : ℕ) : Algebra (O F) (LTtorsionRing F π q n) := inferInstance

/-- `𝒪[F][T]/(f^{(n)}(T))` is a finite free `𝒪[F]`-module (of rank `q^n`). -/
theorem moduleFinite (π : O F) (q n : ℕ) (hq : 2 ≤ q) :
    Module.Finite (O F) (LTtorsionRing F π q n) :=
  (AdjoinRoot.powerBasis' (LubinTate.LTpolyIter_monic_degree π q n hq).1).finite

/-- The class of `T` in `𝒪[F][T]/(f^{(n)}(T))`.  For `q ≥ 1` it satisfies `f^{(n)}(τ) = 0`. -/
def tau (π : O F) (q n : ℕ) : LTtorsionRing F π q n := AdjoinRoot.root (LTpolyIter π q n)

/-- The image of the uniformiser `π` in the ambient ring. -/
def piT (π : O F) (q n : ℕ) : LTtorsionRing F π q n :=
  algebraMap (O F) (LTtorsionRing F π q n) π

theorem tau_spec (π : O F) (q n : ℕ) :
    (aeval (tau π q n)) (LTpolyIter π q n) = 0 := by
  show (aeval (AdjoinRoot.root (LTpolyIter π q n))) (LTpolyIter π q n) = 0
  rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]

/-- The defining ideal `(π)` of the adic topology, written with `piT`. -/
def adicIdeal (π : O F) (q n : ℕ) : Ideal (LTtorsionRing F π q n) :=
  Ideal.span {piT π q n}

end LTtorsionRing

open LTtorsionRing

section Topology

variable {F : Type u} [Field F] [ValuativeRel F] (π : O F) (q n : ℕ)

/-- The `(π)`-adic topology on `𝒪[F]`, the one making the structure map
`𝒪[F] → 𝒪[F][T]/(f^{(n)}(T))` continuous. -/
def adicTopologyO : TopologicalSpace (O F) := Ideal.adicTopology (Ideal.span ({π} : Set (O F)))

/-- The `𝔪[F]`-adic topology on the ambient ring (the ideal is generated by the image of `π`). -/
noncomputable instance instTopologicalSpace :
    TopologicalSpace (LTtorsionRing F π q n) :=
  Ideal.adicTopology (adicIdeal π q n)

instance instIsLinearTopology :
    IsLinearTopology (LTtorsionRing F π q n) (LTtorsionRing F π q n) :=
  Ideal.isLinearTopology _

instance instNonarchimedeanRing : NonarchimedeanRing (LTtorsionRing F π q n) :=
  Ideal.nonarchimedean _

instance instIsTopologicalRing : IsTopologicalRing (LTtorsionRing F π q n) :=
  (Ideal.nonarchimedean _).toIsTopologicalRing

instance instIsTopologicalAddGroup : IsTopologicalAddGroup (LTtorsionRing F π q n) :=
  IsTopologicalRing.to_topologicalAddGroup

/-- The uniform structure of the ambient ring: the one attached to its (commutative) topological
additive group. -/
noncomputable instance instUniformSpace : UniformSpace (LTtorsionRing F π q n) :=
  IsTopologicalAddGroup.rightUniformSpace _

instance instIsUniformAddGroup : IsUniformAddGroup (LTtorsionRing F π q n) :=
  isUniformAddGroup_of_addCommGroup

end Topology

/-! ### The discrete structure on `𝒪[F]`

Milne's evaluation of a power series is an algebraic operation (`MvPowerSeries.subst` is *defined*
with the discrete uniformity on the coefficient ring), and the transport identity
`MvPowerSeries.eval₂_subst` is stated under `DiscreteUniformity` on the coefficient ring.  We
therefore make the discrete topology and uniformity on `𝒪[F]` the *global* instances.  This is
harmless for the rest of the development: every other statement about `𝒪[F]` in this chapter
(`IsAdicComplete`, `IsDiscreteValuationRing`, `HenselianLocalRing`, …) is topology-free.  Note that
in Lean's order on `TopologicalSpace`/`UniformSpace` the *discrete* structure is `⊥`. -/

instance (priority := 2000) instDiscreteTopologicalSpaceO (F : Type u) [Field F] [ValuativeRel F] :
    TopologicalSpace (O F) := ⊥

instance (priority := 2000) instDiscreteUniformSpaceO (F : Type u) [Field F] [ValuativeRel F] :
    UniformSpace (O F) := ⊥

instance (priority := 2000) instDiscreteUniformityO (F : Type u) [Field F] [ValuativeRel F] :
    DiscreteUniformity (O F) := ⟨rfl⟩

section Eval

variable {F : Type u} [Field F] [ValuativeRel F] (π : O F) (q n : ℕ) (hq : 2 ≤ q)

/-- **Evaluation of the ambient ring at a torsion point.**  For `x ∈ Λ_n` (so `f^{(n)}(x) = 0`), the
unique `𝒪[F]`-algebra homomorphism `𝒪[F][T]/(f^{(n)}(T)) → AlgebraicClosure F` with `τ ↦ x`. -/
def evMap (x : AlgebraicClosure F) (hx : x ∈ LTdivisionSet F (π : F) q n) :
    LTtorsionRing F π q n →+* AlgebraicClosure F :=
  AdjoinRoot.lift ((algebraMap F (AlgebraicClosure F)).comp (algebraMap (O F) F)) x (by
    have hx' : (aeval x) (LTpolyIter (π : F) q n) = 0 :=
      (mem_LTdivisionSet_iff (π : F) q n hq).mp hx
    have hmap : (LTpolyIter π q n).map (algebraMap (O F) F) = LTpolyIter (π : F) q n :=
      LTpolyIter_map (algebraMap (O F) F) π q n
    rw [Polynomial.eval₂_eq_eval_map, ← Polynomial.map_map, hmap]
    simpa [Polynomial.aeval_def, Polynomial.eval_map] using hx')



end Eval

end

end NK.LocalReciprocityLubinTate.Eval
