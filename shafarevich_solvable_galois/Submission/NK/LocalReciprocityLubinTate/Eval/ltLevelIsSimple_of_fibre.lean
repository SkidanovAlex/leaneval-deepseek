namespace NK.LocalReciprocityLubinTate.Eval

open Polynomial

/-! ## The `𝒪[F]`-orbit of a primitive torsion point fills the level

The strategy of the proof of `ltLevelIsSimple_of_fibre` is the classical one for Milne, *CFT*,
Theorem I.3.1: for a primitive `y ∈ Λ_n ∖ Λ_{n-1}`, the map

  `𝒪[F] ⧸ π^n → Λ_n,   a ↦ a · y`

of the `𝒪[F]`-action of `Eval/TorsionAction.lean` is a bijection.  Injectivity is the statement
that the annihilator of the primitive point `y` is `(π^n)` (`Eval/smulDiv_ann.lean`); both sides
have `q^n` elements (`ncard_LTdivisionSet` and `Audit.natCard_quotient_maximalIdeal_pow`).  Hence
`Λ_n = {a · y : a ∈ 𝒪[F]}` and, since every `a · y` is the value at `y` of the evaluation `evMap y`
of an element of `T_n`, hence lies in `F(y)` (`evMap_mem_adjoin_singleton`), the whole level is
generated by `y`.

The one step which is *not* part of the "purely polynomial" action (the bridge
`π^m · x = f^{(m)}(x)` of `Eval/smulDiv_mem.lean`) is the additivity needed to pass from
`a · y = b · y` to `(a - b) · y = 0`; it is supplied by the Lubin–Tate addition formula
`smulDiv_add_formula`, using the *unconditional* unit factorisation
`LubinTateModule.exists_unit_factorization` of the group law. -/

/-- **The `𝒪[F]`-module generated by a primitive torsion point is all of `Λ_n`.**

For `y ∈ Λ_n ∖ Λ_{n-1}` with `n ≥ 1`, the set `{a · y : a ∈ 𝒪[F]}` of multiples of `y` under the
`𝒪[F]`-action of the Lubin–Tate module is exactly the set `Λ_n` of `π^n`-division points.

This is the "rank one" half of Milne, *CFT*, Theorem I.3.1 for the standard Lubin–Tate group
`f(T) = πT + T^q`: `Λ_n` is a free `𝒪[F]/π^n`-module, generated by any primitive point. -/
theorem range_smulDiv_eq_LTdivisionSet {F : Type*} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (π : ↥(ValuativeRel.valuation F).integer) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (hn : 1 ≤ n) (hres : q = NK.LocalReciprocityLubinTate.residueCard F)
    (M : LubinTateModule (↥(ValuativeRel.valuation F).integer) π q)
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq π q)
    {y : AlgebraicClosure F}
    (hy : y ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n)
    (hy' : y ∉ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (n - 1)) :
    Set.range (fun a : ↥(ValuativeRel.valuation F).integer => smulDiv π hπ q n hq M hy a) =
      NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n := by
  classical
  -- the unit factorisation of the Lubin–Tate group law
  obtain ⟨Θ, hΘ, hlaw⟩ :=
    NK.LocalReciprocityLubinTate.LubinTateModule.exists_unit_factorization π hπ q M
  let I : Ideal ↥(ValuativeRel.valuation F).integer := Ideal.span {π ^ n}
  -- the annihilator computation: `a · y = b · y ↔ a - b ∈ (π^n)`
  have hker : ∀ a b : ↥(ValuativeRel.valuation F).integer,
      smulDiv π hπ q n hq M hy a = smulDiv π hπ q n hq M hy b ↔ a - b ∈ I := by
    intro a b
    constructor
    · intro h
      obtain ⟨H, hH, hform⟩ := smulDiv_add_formula π hπ q n hq M Θ hΘ hlaw hy b (a - b)
      rw [show b + (a - b) = a from by ring, h] at hform
      have hzero : smulDiv π hπ q n hq M hy (a - b) * H = 0 :=
        add_left_cancel (a := smulDiv π hπ q n hq M hy b) (by rw [add_zero]; exact hform.symm)
      have hx0 : smulDiv π hπ q n hq M hy (a - b) = 0 := (mul_eq_zero.mp hzero).resolve_right hH
      exact (smulDiv_eq_zero_iff π hπ q n hq M hpi hy hy' hn (a - b)).mp hx0
    · intro hab
      have hzero : smulDiv π hπ q n hq M hy (a - b) = 0 :=
        (smulDiv_eq_zero_iff π hπ q n hq M hpi hy hy' hn (a - b)).mpr hab
      have h := smulDiv_add_of_eq_zero π hπ q n hq M Θ hΘ hlaw hy b (a - b) hzero
      rwa [show b + (a - b) = a from by ring] at h
  -- the orbit `T` of `y`
  have hTsub : Set.range (fun a : ↥(ValuativeRel.valuation F).integer =>
      smulDiv π hπ q n hq M hy a) ⊆
      NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n := by
    rintro x ⟨a, rfl⟩
    exact smulDiv_mem π hπ q n hq M hpi y hy a
  have hTgen : Set.range (fun a : ↥(ValuativeRel.valuation F).integer =>
      smulDiv π hπ q n hq M hy a) ⊆
      (IntermediateField.adjoin F ({y} : Set (AlgebraicClosure F)) :
        Set (AlgebraicClosure F)) := by
    rintro x ⟨a, rfl⟩
    exact evMap_mem_adjoin_singleton π hπ q n hq y hy (actionTau π hπ q n hq M a)
  have hTcard : (Set.range (fun a : ↥(ValuativeRel.valuation F).integer =>
      smulDiv π hπ q n hq M hy a)).ncard = q ^ n := by
    -- the surjection `𝒪[F] ⧸ (π^n) → T`, injective by `hker`
    let g : (↥(ValuativeRel.valuation F).integer ⧸ I) → AlgebraicClosure F :=
      fun x => smulDiv π hπ q n hq M hy x.out
    have hgmk : ∀ a : ↥(ValuativeRel.valuation F).integer,
        g (Ideal.Quotient.mk I a) = smulDiv π hπ q n hq M hy a := by
      intro a
      have hout : (Ideal.Quotient.mk I a).out - a ∈ I :=
        (Ideal.Quotient.eq (I := I)).mp (Ideal.Quotient.mk_out (x := Ideal.Quotient.mk I a))
      exact (hker _ a).mpr hout
    have hginj : Function.Injective g := by
      intro p r hpr
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective p
      obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective r
      rw [hgmk a, hgmk b] at hpr
      exact (Ideal.Quotient.eq).mpr ((hker a b).mp hpr)
    have hrange : Set.range (fun a : ↥(ValuativeRel.valuation F).integer =>
        smulDiv π hπ q n hq M hy a) = Set.range g := by
      ext x
      constructor
      · rintro ⟨a, rfl⟩
        exact ⟨Ideal.Quotient.mk I a, hgmk a⟩
      · rintro ⟨p, rfl⟩
        exact ⟨p.out, rfl⟩
    rw [hrange, Set.ncard_range_of_injective hginj]
    have hIeq : I = (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer) ^ n := by
      show Ideal.span {π ^ n} = _
      rw [← Ideal.span_singleton_pow, ← hπ.maximalIdeal_eq]
    calc Nat.card (↥(ValuativeRel.valuation F).integer ⧸ I)
        = Nat.card (↥(ValuativeRel.valuation F).integer ⧸
            (IsLocalRing.maximalIdeal ↥(ValuativeRel.valuation F).integer) ^ n) :=
          Nat.card_congr (Ideal.quotEquivOfEq hIeq).toEquiv
      _ = NK.LocalReciprocityLubinTate.residueCard F ^ n :=
          NK.LocalReciprocityLubinTate.Audit.natCard_quotient_maximalIdeal_pow F n
      _ = q ^ n := by rw [hres]
  have hΛfin : (NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n).Finite := by
    unfold NK.LocalReciprocityLubinTate.LTdivisionSet
    exact Set.toFinite _
  have hΛcard : (NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q n).ncard = q ^ n :=
    NK.LocalReciprocityLubinTate.ncard_LTdivisionSet F π hπ q n hq
  exact Set.eq_of_subset_of_ncard_le hTsub (by rw [hTcard, hΛcard]) hΛfin

/-- **The Lubin–Tate level is generated by a single primitive division point** (Milne, *CFT*,
Theorem I.3.1): for the standard Lubin–Tate group `f(T) = πT + T^q` of a uniformiser `π` with
`q = #𝓀[F]`, any `y ∈ Λ_n ∖ Λ_{n-1}` generates the whole level, `Λ_n ⊆ F(y)`.

This is the form of `LTLevelIsSimple F (π:F) q n` stated directly in terms of the `𝒪[F]`-action:
`Λ_n` is the orbit `{a · y}` (`range_smulDiv_eq_LTdivisionSet`), and every `a · y` is the value of
`evMap y` at an element of `T_n`, hence lies in `F(y)` (`evMap_mem_adjoin_singleton`).  No
hypothesis about the fibres of the reduction `f : Λ_n → Λ_{n-1}` is needed. -/
theorem ltLevelIsSimple_of_smulDiv {F : Type*} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (π : ↥(ValuativeRel.valuation F).integer) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (hn : 1 ≤ n) (hres : q = NK.LocalReciprocityLubinTate.residueCard F)
    (M : LubinTateModule (↥(ValuativeRel.valuation F).integer) π q)
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq π q) :
    NK.LocalReciprocityLubinTate.LTLevelIsSimple F (π : F) q n := by
  intro y hy hy' z hz
  have hrange := range_smulDiv_eq_LTdivisionSet π hπ q n hq hn hres M hpi hy hy'
  rw [← hrange] at hz
  obtain ⟨a, rfl⟩ := hz
  exact evMap_mem_adjoin_singleton π hπ q n hq y hy (actionTau π hπ q n hq M a)

set_option linter.unusedVariables false in
/-- **A fibre computation suffices for the simplicity of the level.**  Version of
`ltLevelIsSimple_of_smulDiv` in which the `𝒪[F]`-action is not used directly: one only needs to
know that every point of the fibre of `f : Λ_N → Λ_{N-1}` over the value `f(w)` of a primitive
`w` is a unit multiple of `w` (hypothesis `hfib`, the fibre formula of Milne, *CFT*, §I.3).

In fact the argument of `ltLevelIsSimple_of_smulDiv` does not use `hfib` at all: the hypothesis is
kept here because it is the datum the caller has available. -/
theorem ltLevelIsSimple_of_fibre {F : Type*} [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] [CharZero F]
    (π : ↥(ValuativeRel.valuation F).integer) (hπ : Irreducible π) (q n : ℕ) (hq : 2 ≤ q)
    (hn : 1 ≤ n) (hres : q = NK.LocalReciprocityLubinTate.residueCard F)
    (M : LubinTateModule (↥(ValuativeRel.valuation F).integer) π q)
    (hpi : M.toLaw.piEndo = NK.LocalReciprocityLubinTate.piXAddXq π q)
    (hfib : ∀ (N : ℕ), 2 ≤ N → ∀ {w z : AlgebraicClosure F}
      (hw : w ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q N),
      w ∉ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q (N - 1) →
      z ∈ NK.LocalReciprocityLubinTate.LTdivisionSet F (π : F) q N →
      (Polynomial.aeval z) (NK.LocalReciprocityLubinTate.LTpoly (π : F) q) =
        (Polynomial.aeval w) (NK.LocalReciprocityLubinTate.LTpoly (π : F) q) →
      ∃ u : (↥(ValuativeRel.valuation F).integer)ˣ,
        u ∈ NK.LocalReciprocityLubinTate.principalUnits F (N - 1) ∧
        z = NK.LocalReciprocityLubinTate.Eval.smulDiv π hπ q N hq M hw (↑u)) :
    NK.LocalReciprocityLubinTate.LTLevelIsSimple F (π : F) q n :=
  ltLevelIsSimple_of_smulDiv π hπ q n hq hn hres M hpi

end NK.LocalReciprocityLubinTate.Eval
