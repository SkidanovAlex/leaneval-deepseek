local notation "Ω" => SeparableClosure (Q.adicCompletion K)
local notation "Lvl" d:max => NK.TameStructureDeep.Degree.levelField (K' := Ω) Q d
local notation "gen" d:max => NK.TameStructureDeep.Degree.levelRoot (K' := Ω) Q d

/-! ## The cyclotomic levels of the unramified tower, inside the separable closure -/

/-- **Canonicity of the unramified cyclotomic level.**  The level `d` of the unramified tower is
generated by *any* primitive `(q ^ d - 1)`-st root of unity of the separable closure, not only by
the chosen one: any two such roots are powers of each other. -/
theorem levelField_eq_adjoin_of_isPrimitiveRoot (d : ℕ) (hd : d ≠ 0) {ζ : Ω}
    (hζ : IsPrimitiveRoot ζ (NK.TameStructureDeep.Degree.levelN Q d)) :
    IntermediateField.adjoin (Q.adicCompletion K) ({ζ} : Set Ω) = Lvl d := by
  haveI : NeZero (NK.TameStructureDeep.Degree.levelN Q d) :=
    ⟨NK.TameStructureDeep.Degree.levelN_ne_zero Q d hd⟩
  have hroot := NK.TameStructureDeep.Degree.levelRoot_isPrimitiveRoot (K' := Ω) Q d hd
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    refine Set.singleton_subset_iff.mpr ?_
    obtain ⟨i, -, hi⟩ := hroot.eq_pow_of_pow_eq_one hζ.pow_eq_one
    rw [← hi]
    exact pow_mem (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d) i
  · rw [NK.TameStructureDeep.Degree.levelField]
    refine IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr ?_)
    obtain ⟨i, -, hi⟩ := hζ.eq_pow_of_pow_eq_one hroot.pow_eq_one
    rw [← hi]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self _ ζ) i

/-- The level `d` is a finite extension of the local field. -/
theorem finiteDimensional_levelField (d : ℕ) : FiniteDimensional (Q.adicCompletion K) ↥(Lvl d) := by
  rw [NK.TameStructureDeep.Degree.levelField]
  refine IntermediateField.adjoin.finiteDimensional ?_
  rcases eq_or_ne d 0 with rfl | hd
  · rw [NK.TameStructureDeep.Degree.levelRoot, dif_pos rfl]
    exact isIntegral_zero
  · exact ⟨Polynomial.X ^ NK.TameStructureDeep.Degree.levelN Q d - Polynomial.C 1,
      Polynomial.monic_X_pow_sub_C 1 (NK.TameStructureDeep.Degree.levelN_ne_zero Q d hd),
      by
        simpa [sub_eq_zero] using
          (NK.TameStructureDeep.Degree.levelRoot_isPrimitiveRoot (K' := Ω) Q d hd).pow_eq_one⟩

/-! ## The Frobenius of a cyclotomic level -/

/-- **The iterated action of the Frobenius**: the `k`-th power of the level-`d` Frobenius acts on
the generator by `ζ ↦ ζ ^ (q ^ k)`. -/
theorem levelFrob_pow_apply_root (d k : ℕ) (hd : d ≠ 0) :
    ((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) ^ k)
        ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ =
      ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ ^
        (NK.LocalStructure.residueCard K Q ^ k) := by
  induction k with
  | zero => simp
  | succ k ih =>
    have h1 : ((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) ^ (k + 1))
          ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ =
        (((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) ^ k)
          ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩) ^
          (NK.LocalStructure.residueCard K Q) := by
      rw [pow_succ, AlgEquiv.mul_apply,
        NK.TameStructureDeep.Degree.levelFrob_apply (K' := Ω) Q d hd, map_pow]
    rw [h1, ih, ← pow_mul, ← pow_succ]

/-- The `d`-th power of the level-`d` Frobenius is the identity. -/
theorem pow_levelFrob_eq_one (d : ℕ) (hd : d ≠ 0) :
    (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) ^ d = 1 := by
  have hq : 1 < NK.LocalStructure.residueCard K Q := by
    have h2 := NK.TameStructureDeep.Degree.two_le_residueCard Q
    omega
  have hprim : IsPrimitiveRoot
      (⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ : ↥(Lvl d))
      (NK.TameStructureDeep.Degree.levelN Q d) :=
    IsPrimitiveRoot.coe_submonoidClass_iff.mp
      (NK.TameStructureDeep.Degree.levelRoot_isPrimitiveRoot (K' := Ω) Q d hd)
  apply NK.TameStructureDeep.Degree.levelEquiv_ext_root (K' := Ω) Q d hd
  rw [levelFrob_pow_apply_root Q d d hd, AlgEquiv.one_apply]
  have h1 : NK.LocalStructure.residueCard K Q ^ d =
      NK.TameStructureDeep.Degree.levelN Q d + 1 := by
    rw [NK.TameStructureDeep.Degree.levelN]
    exact (Nat.sub_add_cancel (Nat.one_le_pow d _ hq.le)).symm
  rw [h1, pow_succ, hprim.pow_eq_one, one_mul]

/-- **The order of the level-`d` Frobenius is `d`.** -/
theorem orderOf_levelFrob (d : ℕ) (hd : d ≠ 0) :
    orderOf (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) = d := by
  have hq : 1 < NK.LocalStructure.residueCard K Q := by
    have h2 := NK.TameStructureDeep.Degree.two_le_residueCard Q
    omega
  rw [orderOf_eq_iff (Nat.pos_of_ne_zero hd)]
  refine ⟨pow_levelFrob_eq_one Q d hd, ?_⟩
  intro m hm hmlt hcontra
  have h1 : ((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd) ^ m)
        ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ =
      ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ := by
    rw [hcontra]; rfl
  rw [levelFrob_pow_apply_root Q d m hd] at h1
  have h1' : (gen d) ^ (NK.LocalStructure.residueCard K Q ^ m) = gen d := by
    have h := congrArg (fun x : ↥(Lvl d) => (x : Ω)) h1
    simpa [SubmonoidClass.coe_pow] using h
  have h2 : (gen d) ^ (NK.LocalStructure.residueCard K Q ^ m - 1) = 1 := by
    have hpos : 1 ≤ NK.LocalStructure.residueCard K Q ^ m := Nat.one_le_pow m _ hq.le
    have h3 : (gen d) ^ (NK.LocalStructure.residueCard K Q ^ m - 1) * (gen d) =
        (gen d) ^ (NK.LocalStructure.residueCard K Q ^ m) := by
      rw [← pow_succ, Nat.sub_add_cancel hpos]
    have h4 : (gen d) ^ (NK.LocalStructure.residueCard K Q ^ m - 1) * (gen d) =
        1 * (gen d) := by rw [h3, h1', one_mul]
    exact mul_right_cancel₀
      ((NK.TameStructureDeep.Degree.levelRoot_isPrimitiveRoot (K' := Ω) Q d hd).ne_zero
        (NK.TameStructureDeep.Degree.levelN_ne_zero Q d hd)) h4
  have h5 : NK.TameStructureDeep.Degree.levelN Q d ∣
      NK.LocalStructure.residueCard K Q ^ m - 1 :=
    ((NK.TameStructureDeep.Degree.levelRoot_isPrimitiveRoot (K' := Ω) Q d hd).pow_eq_one_iff_dvd _).mp h2
  have h6 : m = 0 := NK.TameStructureDeep.Degree.pow_eq_one_of_dvd_pow_sub_one
    (q := NK.LocalStructure.residueCard K Q) (d := d) (k := m) hq hm h5
  omega

/-! ## Restriction of the Frobenius along the tower -/

/-- The level `d` regarded as a subfield of the level `d'` (for `d ≤ d'`). -/
noncomputable def levelFieldInLevelField (d d' : ℕ) :
    IntermediateField (Q.adicCompletion K) ↥(Lvl d') :=
  (Lvl d).comap (Lvl d').val

/-- The canonical `F`-algebra isomorphism identifying the level `d` with its image in the level
`d'`. -/
noncomputable def levelFieldInLevelFieldEquiv (d d' : ℕ) (hle : Lvl d ≤ Lvl d') :
    ↥(Lvl d) ≃ₐ[Q.adicCompletion K] ↥(levelFieldInLevelField Q d d') where
  toFun x := ⟨⟨x.1, hle x.2⟩, x.2⟩
  invFun y := ⟨y.1.1, y.2⟩
  left_inv x := Subtype.ext rfl
  right_inv y := Subtype.ext (Subtype.ext rfl)
  map_mul' _ _ := Subtype.ext (Subtype.ext rfl)
  map_add' _ _ := Subtype.ext (Subtype.ext rfl)
  commutes' _ := Subtype.ext (Subtype.ext rfl)

theorem levelFieldInLevelFieldEquiv_apply_coe (d d' : ℕ) (hle : Lvl d ≤ Lvl d')
    (x : ↥(Lvl d)) :
    ((levelFieldInLevelFieldEquiv Q d d' hle x : ↥(levelFieldInLevelField Q d d')) :
      ↥(Lvl d')) = ⟨x.1, hle x.2⟩ := rfl

theorem levelFieldInLevelFieldEquiv_symm_apply_coe (d d' : ℕ) (hle : Lvl d ≤ Lvl d')
    (y : ↥(levelFieldInLevelField Q d d')) :
    ((levelFieldInLevelFieldEquiv Q d d' hle).symm y : ↥(Lvl d)) = ⟨y.1.1, y.2⟩ := rfl

/-- **The Frobenius of the level `d'` acts on the generator of the level `d` by `ζ ↦ ζ ^ q`**,
when `d ∣ d'`. -/
theorem levelFrob_apply_levelRoot_of_dvd (d d' : ℕ) (hd : d ≠ 0) (hd' : d' ≠ 0) (hdd : d ∣ d') :
    (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
        ⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
          (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩ =
      (⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
          (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩ : ↥(Lvl d')) ^
        (NK.LocalStructure.residueCard K Q) := by
  obtain ⟨k, hk⟩ := NK.TameStructureDeep.Degree.levelRoot_pow_eq (K' := Ω) Q hd hd' hdd
  have harg : (⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
        (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩ : ↥(Lvl d')) =
      (⟨gen d', NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d'⟩ :
        ↥(Lvl d')) ^ k := by
    refine Subtype.ext ?_
    rw [SubmonoidClass.coe_pow]
    exact hk
  calc (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
        ⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
          (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩
      = (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
          ((⟨gen d', NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d'⟩ :
            ↥(Lvl d')) ^ k) := by rw [harg]
    _ = ((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
          ⟨gen d', NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d'⟩) ^ k := by
          rw [map_pow]
    _ = ((⟨gen d', NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d'⟩ :
            ↥(Lvl d')) ^ (NK.LocalStructure.residueCard K Q)) ^ k := by
          rw [NK.TameStructureDeep.Degree.levelFrob_apply (K' := Ω) Q d' hd']
    _ = (⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
          (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩ : ↥(Lvl d')) ^
            (NK.LocalStructure.residueCard K Q) := by
          refine Subtype.ext ?_
          rw [SubmonoidClass.coe_pow, SubmonoidClass.coe_pow, SubmonoidClass.coe_pow]
          have hbar : ((⟨gen d, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
                (NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d)⟩ : ↥(Lvl d')) : Ω)
              = ((⟨gen d', NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d'⟩ :
                ↥(Lvl d')) : Ω) ^ k := hk
          rw [hbar, ← pow_mul, ← pow_mul,
            Nat.mul_comm (NK.LocalStructure.residueCard K Q) k]

/-- **The Frobenius restricts along the tower.**  For `d ∣ d'`, the restriction of the level-`d'`
Frobenius to the subfield `levelField d` is the level-`d` Frobenius. -/
theorem levelFrob_restrict (d d' : ℕ) (hd : d ≠ 0) (hd' : d' ≠ 0) (hdd : d ∣ d')
    (y : ↥(Lvl d)) :
    ((NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
        ⟨y.1, NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd y.2⟩ :
          ↥(Lvl d')) =
      ⟨(NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd y).1,
        NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
          (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd y).2⟩ := by
  have hle : Lvl d ≤ Lvl d' :=
    NK.TameStructureDeep.Degree.levelField_le_levelField (K' := Ω) Q hd hd' hdd
  haveI : NeZero d := ⟨hd⟩
  let e := levelFieldInLevelFieldEquiv Q d d' hle
  haveI : Normal (Q.adicCompletion K) ↥(levelFieldInLevelField Q d d') := Normal.of_algEquiv e
  let τ := AlgEquiv.restrictNormalHom ↥(levelFieldInLevelField Q d d')
    (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
  have hres : e.symm.autCongr τ = NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd := by
    apply NK.TameStructureDeep.Degree.levelEquiv_ext_root (K' := Ω) Q d hd
    rw [AlgEquiv.autCongr_apply, AlgEquiv.trans_apply, AlgEquiv.trans_apply]
    change e.symm (τ (e ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩)) =
      NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd
        ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩
    have hτ : τ (e ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩) =
        e (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd
          ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩) := by
      have h3 : ((τ (e ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩) :
            ↥(levelFieldInLevelField Q d d')) : ↥(Lvl d')) =
          (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
            ((e ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩ :
              ↥(levelFieldInLevelField Q d d')) : ↥(Lvl d')) :=
        AlgEquiv.restrictNormalHom_apply (L := levelFieldInLevelField Q d d')
          (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
          (e ⟨gen d, NK.TameStructureDeep.Degree.mem_levelField_root (K' := Ω) Q d⟩)
      refine Subtype.ext ?_
      rw [h3, levelFieldInLevelFieldEquiv_apply_coe,
        levelFrob_apply_levelRoot_of_dvd Q d d' hd hd' hdd,
        levelFieldInLevelFieldEquiv_apply_coe]
      refine Subtype.ext ?_
      rw [SubmonoidClass.coe_pow,
        NK.TameStructureDeep.Degree.levelFrob_apply (K' := Ω) Q d hd,
        SubmonoidClass.coe_pow]
    rw [hτ, AlgEquiv.symm_apply_apply]
  have h2 : τ (e y) = e (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d hd y) := by
    have h := congrArg (fun (σ : ↥(Lvl d) ≃ₐ[Q.adicCompletion K] ↥(Lvl d)) => e (σ y)) hres
    rw [AlgEquiv.autCongr_apply, AlgEquiv.trans_apply, AlgEquiv.trans_apply,
      AlgEquiv.apply_symm_apply] at h
    exact h
  have h3 : ((τ (e y) : ↥(levelFieldInLevelField Q d d')) : ↥(Lvl d')) =
      (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd')
        ((e y : ↥(levelFieldInLevelField Q d d')) : ↥(Lvl d')) :=
    AlgEquiv.restrictNormalHom_apply (L := levelFieldInLevelField Q d d')
      (NK.TameStructureDeep.Degree.levelFrob (K' := Ω) Q d' hd') (e y)
  rw [h2, levelFieldInLevelFieldEquiv_apply_coe] at h3
  exact h3.symm

/-! ## The norm group of an unramified level -/

/-- **The norm group of the unramified level of degree `d`** is `⟨π ^ d⟩ · U⁰`.

The level `levelField Q d = F⟮ζ_{q ^ d - 1}⟯` is the unramified extension of `F` of degree `d`;
its norm group is computed by comparing it with the local field of a global unramified extension
of `F` of degree `d` (whose norm group is `NK.Unramified.normGroup_eq_unramifiedNormGroup`):
the global local field contains a Teichmüller lift of a generator of its residue field, i.e. a
primitive `(q ^ d - 1)`-st root of unity, which generates it; pushing that root of unity into the
separable closure identifies the two fields. -/
theorem normGroup_levelField (d : ℕ) (hd : d ≠ 0) :
    NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(Lvl d) =
      Subgroup.zpowers (NK.LocalReciprocityLubinTate.uniformizerUnit K Q ^ d) ⊔
        NK.LocalReciprocityLubinTate.adicUnits K Q := by
  classical
  -- ## Step 1: global data — a finite Galois extension `L₁ / K` with a place `q₁ | Q` unramified
  -- of inertia degree `d`.
  obtain ⟨L'', hL''f, hL''nf, hAlg1, hAlg2, hST'', hfd1, hfd2, hgal1, hgal2, q'', hq''over, hq''e,
    hq''f, L₁, hL₁f, hL₁nf, hL₁alg, hL₁fd, hL₁gal, hL₁alg'', hSTL, hL₁fd'', hL₁gal'', q₁, hq₁over,
    hq''overq₁, hq₁e, hq₁f⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_galois_unramified_tower_with_subfield
      (L := K) (L' := K) Q Q (Ideal.LiesOver.mk (by rw [Ideal.under]; rfl)) d
      (Nat.pos_of_ne_zero hd)
  haveI : FiniteDimensional K L₁ := hL₁fd
  haveI : IsGalois K L₁ := hL₁gal
  -- the inertia degree of `Q` over itself is one
  have hself : @Ideal.inertiaDeg (NumberField.RingOfIntegers K) _ Q.asIdeal
      (NumberField.RingOfIntegers K) _ (NumberField.inst_ringOfIntegersAlgebra K K) = 1 := by
    letI : Algebra (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers K) :=
      NumberField.inst_ringOfIntegersAlgebra K K
    have halg : (algebraMap (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers K) :
        NumberField.RingOfIntegers K →+* NumberField.RingOfIntegers K) =
        RingHom.id (NumberField.RingOfIntegers K) := by ext x; rfl
    haveI : Q.asIdeal.LiesOver Q.asIdeal := Ideal.LiesOver.mk (by
      show Q.asIdeal = Ideal.under (NumberField.RingOfIntegers K) Q.asIdeal
      rw [Ideal.under, halg, Ideal.comap_id])
    rw [Ideal.inertiaDeg_eq_of_isMaximal Q.asIdeal Q.asIdeal]
    exact Module.finrank_self _
  have hq₁f' : q₁.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) = d := by
    rw [hq₁f, hself, mul_one]
  -- ## Step 2: the local field `(L₁)_{q₁}` and its norm group.
  letI : Algebra (Q.adicCompletion K) (q₁.adicCompletion L₁) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q₁ hq₁over)
  haveI hfd : FiniteDimensional (Q.adicCompletion K) (q₁.adicCompletion L₁) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q₁ hq₁over
  have hrank : Module.finrank (Q.adicCompletion K) (q₁.adicCompletion L₁) = d := by
    rw [← Commons.NumberTheory.NumberField.Completion.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
      Q q₁ hq₁over, hq₁e, one_mul, hq₁f']
  have hnorm : NK.LocalReciprocity.normGroup (Q.adicCompletion K) (q₁.adicCompletion L₁) =
      Subgroup.zpowers (NK.LocalReciprocityLubinTate.uniformizerUnit K Q ^ d) ⊔
        NK.LocalReciprocityLubinTate.adicUnits K Q := by
    rw [NK.Unramified.normGroup_eq_unramifiedNormGroup Q q₁ hq₁over hq₁e, hq₁f']
    rfl
  -- ## Step 3: a primitive `(q ^ d - 1)`-st root of unity in `(L₁)_{q₁}`.
  obtain ⟨ζ, hζ, -⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_isPrimitiveRoot_lift_adicCompletionB
      Q q₁ hq₁over
  have hcard : Nat.card (IsLocalRing.ResidueField (q₁.adicCompletionIntegers L₁)) =
      NK.LocalStructure.residueCard K Q ^ d := by
    rw [Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletion_eq_pow_inertiaDeg
      K L₁ Q q₁ hq₁over, hq₁f']
    rfl
  have hζ' : IsPrimitiveRoot (ζ : q₁.adicCompletion L₁)
      (NK.TameStructureDeep.Degree.levelN Q d) := by
    show IsPrimitiveRoot (ζ : q₁.adicCompletion L₁) (NK.LocalStructure.residueCard K Q ^ d - 1)
    rwa [hcard] at hζ
  -- ## Step 4: push the root of unity into the separable closure.
  obtain ⟨ψ⟩ := Commons.FieldTheory.SeparableClosure.nonempty_algHom_of_isSepClosure
    (F := Q.adicCompletion K) (F' := q₁.adicCompletion L₁) (E := Ω)
  have hη : IsPrimitiveRoot (ψ (ζ : q₁.adicCompletion L₁))
      (NK.TameStructureDeep.Degree.levelN Q d) :=
    hζ'.map_of_injective (RingHom.injective ψ.toRingHom)
  have hErank : Module.finrank (Q.adicCompletion K) ↥(ψ.fieldRange) = d := by
    rw [← LinearEquiv.finrank_eq (ψ.equivFieldRange).toLinearEquiv, hrank]
  haveI hEfd : FiniteDimensional (Q.adicCompletion K) ↥(ψ.fieldRange) :=
    FiniteDimensional.of_surjective (ψ.equivFieldRange).toLinearMap
      (ψ.equivFieldRange).surjective
  have hadj : IntermediateField.adjoin (Q.adicCompletion K)
        ({ψ (ζ : q₁.adicCompletion L₁)} : Set Ω) = ψ.fieldRange := by
    refine IntermediateField.eq_of_le_of_finrank_eq ?_ ?_
    · refine IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr ?_)
      exact AlgHom.mem_fieldRange.mpr ⟨(ζ : q₁.adicCompletion L₁), rfl⟩
    · rw [NK.TameStructureDeep.Degree.finrank_adjoin_eq_orderOf Q
          (NK.TameStructureDeep.Degree.levelN_ne_zero Q d hd)
          (NK.TameStructureDeep.Degree.not_residueChar_dvd_levelN Q d hd) hη]
      have horder : orderOf ((NK.LocalStructure.residueCard K Q :
          ZMod (NK.TameStructureDeep.Degree.levelN Q d))) = d :=
        NK.TameStructureDeep.Degree.orderOf_residueCard_pow_sub_one Q d hd
      rw [horder, hErank]
  have hEeq : ψ.fieldRange = Lvl d :=
    hadj.symm.trans (levelField_eq_adjoin_of_isPrimitiveRoot Q d hd hη)
  calc NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(Lvl d)
      = NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(ψ.fieldRange) := by rw [hEeq]
    _ = NK.LocalReciprocity.normGroup (Q.adicCompletion K) (q₁.adicCompletion L₁) :=
        (NK.LocalReciprocity.normGroup_eq_of_algEquiv ψ.equivFieldRange).symm
    _ = Subgroup.zpowers (NK.LocalReciprocityLubinTate.uniformizerUnit K Q ^ d) ⊔
          NK.LocalReciprocityLubinTate.adicUnits K Q := hnorm

end

theorem exists_nested_unramified_levels {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ (E : ℕ → IntermediateField (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K)))
      (hmono : ∀ j : ℕ, E j ≤ E (j + 1))
      (γ : ∀ j : ℕ, ↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j)),
      (∀ j : ℕ, FiniteDimensional (Q.adicCompletion K) ↥(E j)) ∧
      (∀ j : ℕ, IsGalois (Q.adicCompletion K) ↥(E j)) ∧
      (∀ j : ℕ, Module.finrank (Q.adicCompletion K) ↥(E j) = Nat.factorial (j + 1)) ∧
      (∀ j : ℕ, orderOf (γ j) = Nat.factorial (j + 1)) ∧
      (∀ j : ℕ, ∀ y : ↥(E j),
        ((γ (j + 1)) ⟨y.1, hmono j y.2⟩ : ↥(E (j + 1))) =
          ⟨(γ j y).1, hmono j (γ j y).2⟩) ∧
      (∀ j : ℕ, NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(E j)
        = Subgroup.zpowers
            (NK.LocalReciprocityLubinTate.uniformizerUnit K Q ^ Nat.factorial (j + 1))
          ⊔ NK.LocalReciprocityLubinTate.adicUnits K Q) := by
  classical
  refine ⟨fun j => NK.TameStructureDeep.Degree.levelField
      (K' := SeparableClosure (Q.adicCompletion K)) Q (Nat.factorial (j + 1)),
      ?_, ?_, ⟨?_, ?_, ?_, ?_, ?_, ?_⟩⟩
  · -- the levels are nested
    intro j
    exact NK.TameStructureDeep.Degree.levelField_le_levelField
      (K' := SeparableClosure (Q.adicCompletion K)) Q
      (Nat.factorial_ne_zero (j + 1)) (Nat.factorial_ne_zero (j + 1 + 1))
      (Nat.factorial_dvd_factorial (Nat.le_succ (j + 1)))
  · -- the Frobenius generators
    exact fun j => NK.TameStructureDeep.Degree.levelFrob
      (K' := SeparableClosure (Q.adicCompletion K)) Q (Nat.factorial (j + 1))
      (Nat.factorial_ne_zero (j + 1))
  · -- finite dimensionality
    exact fun j => finiteDimensional_levelField Q (Nat.factorial (j + 1))
  · -- the Galois property
    intro j
    haveI : NeZero (Nat.factorial (j + 1)) := ⟨Nat.factorial_ne_zero (j + 1)⟩
    exact NK.TameStructureDeep.Degree.isGalois_levelField
      (K' := SeparableClosure (Q.adicCompletion K)) Q (Nat.factorial (j + 1))
  · -- the degree
    exact fun j => NK.TameStructureDeep.Tame.finrank_levelField
      (K' := SeparableClosure (Q.adicCompletion K)) Q (Nat.factorial (j + 1))
      (Nat.factorial_ne_zero (j + 1))
  · -- the order of the Frobenius
    exact fun j => orderOf_levelFrob Q (Nat.factorial (j + 1)) (Nat.factorial_ne_zero (j + 1))
  · -- compatibility of the Frobenius generators
    intro j y
    exact levelFrob_restrict Q (Nat.factorial (j + 1)) (Nat.factorial (j + 1 + 1))
      (Nat.factorial_ne_zero (j + 1)) (Nat.factorial_ne_zero (j + 1 + 1))
      (Nat.factorial_dvd_factorial (Nat.le_succ (j + 1))) y
  · -- the norm groups
    exact fun j => normGroup_levelField Q (Nat.factorial (j + 1)) (Nat.factorial_ne_zero (j + 1))

end NK.LocalReciprocityLubinTate.Unramified
