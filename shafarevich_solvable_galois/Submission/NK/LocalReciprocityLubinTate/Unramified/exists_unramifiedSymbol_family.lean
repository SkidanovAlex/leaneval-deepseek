/-!
# The unramified Artin symbols of a nested family of unramified levels

For a number field `K`, a finite place `Q` and the completion `F = Q.adicCompletion K`, consider a
nesting of finite Galois extensions

`E 0 ≤ E 1 ≤ E 2 ≤ ⋯`  of `F`,  with `[E j : F] = (j+1)!`,

equipped with a compatible family of automorphisms `γ j ∈ Gal(E j / F)` of order `(j+1)!`, and with
`N_{E j/F} E jˣ = ⟨π^{(j+1)!}⟩ · U⁰` (the norm group of the *unramified* extension of degree
`(j+1)!`).

The theorem `exists_unramifiedSymbol_family` produces the family of **unramified Artin symbols**

`Ψ j : Fˣ →* Gal(E j / F)`,

surjective, with `Ψ j π = γ j`, trivial on the units `U⁰ = 𝒪[F]ˣ` of the ring of integers, and
compatible with the restriction maps `Gal(E (j+1)/F) → Gal(E j/F)`.

Mathematically this is the classical description of the local Artin symbol on the unramified part
of `Fˣ`: it is the composite of the valuation `Fˣ → ℤ` with the map `ℤ → Gal(E j/F)`, `1 ↦ γ j`
(the Frobenius), and it is surjective because `γ j` has order `[E j : F] = #Gal(E j/F)`, hence
generates the Galois group.

## Main definitions and results

* `NK.LocalReciprocityLubinTate.Unramified.valExpo` — the exponent of a unit of `F` along a
  uniformiser `π`, i.e. the unique `k : ℤ` with `valUnits π ^ k = valUnits x`; it is the valuation
  in multiplicative notation, and it is what makes `Ψ j` a group homomorphism;
* `NK.LocalReciprocityLubinTate.Unramified.zpow_compat_of_compat` — powers of a compatible pair of
  automorphisms are compatible;
* `NK.LocalReciprocityLubinTate.Unramified.exists_unramifiedSymbol_family` — the family `Ψ`.
-/

set_option maxHeartbeats 800000
set_option linter.style.haveILetI false

open scoped ValuativeRel

namespace NK.LocalReciprocityLubinTate.Unramified

universe u

noncomputable section

/-! ## The exponent of a unit of `F` along a uniformiser

`valUnits F : Fˣ →* (ValueGroupWithZero F)ˣ` is the valuation of `F` restricted to the units, with
kernel the units `U⁰ = 𝒪[F]ˣ` of the ring of integers; for a uniformiser `π` its value group is the
cyclic group generated by `valUnits F π` (`Units.mem_zpowers_valUnits_pi`).  We may therefore read
off, for every `x : Fˣ`, a unique integer `valExpo F π hπ x` with
`valUnits F π ^ valExpo F π hπ x = valUnits F x`.  This is the *valuation* `Fˣ → ℤ` in
multiplicative notation, and its basic properties (`valExpo_mul`, `valExpo_pi`, `valExpo_zpow`,
`valExpo_unitsIncl`) are exactly the statement that `valUnits F π ^ (−)` is a group isomorphism onto
the value group. -/

/-- **The exponent of `x` along the uniformiser `π`**: the unique integer `k` with
`valUnits F π ^ k = valUnits F x`. -/
def valExpo (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) (x : Fˣ) : ℤ :=
  Classical.choose (Subgroup.mem_zpowers_iff.mp
    (NK.LocalReciprocityLubinTate.Units.mem_zpowers_valUnits_pi F π hπ x))

/-- The defining property of `valExpo`. -/
theorem valExpo_spec (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) (x : Fˣ) :
    (NK.LocalReciprocityLubinTate.Units.valUnits F π) ^ (valExpo F π hπ x)
      = NK.LocalReciprocityLubinTate.Units.valUnits F x :=
  Classical.choose_spec (Subgroup.mem_zpowers_iff.mp
    (NK.LocalReciprocityLubinTate.Units.mem_zpowers_valUnits_pi F π hπ x))

/-- **Uniqueness of the exponent**: `valExpo F π hπ` is the unique integer with
`valUnits F π ^ k = valUnits F x`. -/
theorem valExpo_unique (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F))
    {x : Fˣ} {k : ℤ}
    (h : (NK.LocalReciprocityLubinTate.Units.valUnits F π) ^ k
      = NK.LocalReciprocityLubinTate.Units.valUnits F x) :
    valExpo F π hπ x = k := by
  have huniq : ∀ {a b : ℤ}, (NK.LocalReciprocityLubinTate.Units.valUnits F π) ^ a
      = (NK.LocalReciprocityLubinTate.Units.valUnits F π) ^ b → a = b := by
    intro a b hab
    have h1 : (NK.LocalReciprocityLubinTate.Units.valUnits F π) ^ (a - b) = 1 := by
      rw [zpow_sub, hab, mul_inv_cancel]
    have h2 : a - b = 0 :=
      (NK.LocalReciprocityLubinTate.Units.zpow_valUnits_pi_eq_one_iff F π hπ (a - b)).mp h1
    omega
  exact huniq ((valExpo_spec F π hπ x).trans h.symm)

/-- `valExpo` of the unit `1` is `0`. -/
theorem valExpo_one (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    valExpo F π hπ 1 = 0 :=
  valExpo_unique F π hπ (by rw [map_one, zpow_zero])

/-- `valExpo` is additive: it is the valuation of `Fˣ` in multiplicative notation. -/
theorem valExpo_mul (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) (x y : Fˣ) :
    valExpo F π hπ (x * y) = valExpo F π hπ x + valExpo F π hπ y :=
  valExpo_unique F π hπ (by
    rw [map_mul, zpow_add, valExpo_spec F π hπ x, valExpo_spec F π hπ y])

/-- The uniformiser has exponent one: `valExpo F π hπ π = 1`. -/
theorem valExpo_pi (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    valExpo F π hπ π = 1 :=
  valExpo_unique F π hπ (by rw [zpow_one])

/-- Powers of the uniformiser have the expected exponent: `valExpo F π hπ (π ^ k) = k`, so that
`valExpo` is surjective onto `ℤ`. -/
theorem valExpo_zpow (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F)) (k : ℤ) :
    valExpo F π hπ (π ^ k) = k :=
  valExpo_unique F π hπ (by rw [map_zpow])

/-- The units `U⁰ = 𝒪[F]ˣ` of the ring of integers have exponent zero. -/
theorem valExpo_unitsIncl (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
    [IsNonarchimedeanLocalField F] (π : Fˣ) (hπ : IsUniformizer F (π : F))
    (u : (↥(ValuativeRel.valuation F).integer)ˣ) :
    valExpo F π hπ (NK.LocalReciprocityLubinTate.Units.unitsIncl F u) = 0 := by
  have hmem : NK.LocalReciprocityLubinTate.Units.unitsIncl F u
      ∈ (NK.LocalReciprocityLubinTate.Units.valUnits F).ker := by
    rw [NK.LocalReciprocityLubinTate.Units.ker_valUnits]
    exact ⟨u, rfl⟩
  have h : NK.LocalReciprocityLubinTate.Units.valUnits F
      (NK.LocalReciprocityLubinTate.Units.unitsIncl F u) = 1 :=
    MonoidHom.mem_ker.mp hmem
  exact valExpo_unique F π hπ (by rw [h, zpow_zero])

/-! ## Powers of a compatible pair of automorphisms

A pair `(σ, τ) ∈ Gal(E (j+1)/F) × Gal(E j/F)` is *compatible* if `σ` restricts to `τ` along the
inclusion `E j ≤ E (j+1)`, i.e. `στ`: `σ ⟨y⟩ = ⟨τ y⟩` for all `y ∈ E j`.  Compatibility is preserved
by powers, with integer exponents. -/

section PowerCompat

variable {K : Type} [Field K] [NumberField K]
variable (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable (E : ℕ → IntermediateField (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K)))
variable (hmono : ∀ j : ℕ, E j ≤ E (j + 1))

/-- **Natural powers of a compatible pair are compatible.** -/
theorem pow_compat_of_compat (j : ℕ)
    (σ : ↥(E (j+1)) ≃ₐ[Q.adicCompletion K] ↥(E (j+1)))
    (τ : ↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j))
    (h : ∀ y : ↥(E j), (σ ⟨y.1, hmono j y.2⟩ : ↥(E (j+1))) = ⟨(τ y).1, hmono j (τ y).2⟩) :
    ∀ (n : ℕ) (y : ↥(E j)),
      ((σ ^ n) ⟨y.1, hmono j y.2⟩ : ↥(E (j+1))) = ⟨((τ ^ n) y).1, hmono j ((τ ^ n) y).2⟩ := by
  intro n
  induction n with
  | zero => intro y; simp
  | succ n ih =>
    intro y
    rw [pow_succ, AlgEquiv.mul_apply, h y, ih (τ y), pow_succ, AlgEquiv.mul_apply]

/-- **Integer powers of a compatible pair are compatible.** -/
theorem zpow_compat_of_compat (j : ℕ)
    (σ : ↥(E (j+1)) ≃ₐ[Q.adicCompletion K] ↥(E (j+1)))
    (τ : ↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j))
    (h : ∀ y : ↥(E j), (σ ⟨y.1, hmono j y.2⟩ : ↥(E (j+1))) = ⟨(τ y).1, hmono j (τ y).2⟩) :
    ∀ (k : ℤ) (y : ↥(E j)),
      ((σ ^ k) ⟨y.1, hmono j y.2⟩ : ↥(E (j+1))) = ⟨((τ ^ k) y).1, hmono j ((τ ^ k) y).2⟩ := by
  have hpow := pow_compat_of_compat Q E hmono j σ τ h
  have hinv : ∀ y : ↥(E j),
      ((σ⁻¹) ⟨y.1, hmono j y.2⟩ : ↥(E (j+1))) = ⟨((τ⁻¹) y).1, hmono j ((τ⁻¹) y).2⟩ := by
    intro y
    have h1 : (σ ⟨((τ⁻¹) y).1, hmono j ((τ⁻¹) y).2⟩ : ↥(E (j+1))) = ⟨y.1, hmono j y.2⟩ := by
      rw [h ((τ⁻¹) y)]
      congr 1
      simp
    have h2 := congrArg (fun t : ↥(E (j+1)) => (σ⁻¹) t) h1
    rw [← AlgEquiv.mul_apply, inv_mul_cancel, AlgEquiv.one_apply] at h2
    exact h2.symm
  have hpowinv := pow_compat_of_compat Q E hmono j (σ⁻¹) (τ⁻¹) hinv
  intro k y
  obtain ⟨n, hn | hn⟩ := Int.eq_nat_or_neg k
  · rw [hn, zpow_natCast]; exact hpow n y
  · rw [hn]
    have hσ : σ ^ (-(n : ℤ)) = (σ⁻¹) ^ n := by rw [zpow_neg, zpow_natCast, ← inv_pow]
    have hτ : τ ^ (-(n : ℤ)) = (τ⁻¹) ^ n := by rw [zpow_neg, zpow_natCast, ← inv_pow]
    rw [hσ, hτ]
    exact hpowinv n y

end PowerCompat

/-! ## The family of unramified Artin symbols -/

/-- **The family of unramified Artin symbols.**  For a nested family `E` of finite Galois
extensions of `F = Q.adicCompletion K` with `[E j : F] = (j+1)!` and a compatible family of
automorphisms `γ j` of order `(j+1)!`, there is a family of *surjective* homomorphisms
`Ψ j : Fˣ →* Gal(E j/F)` with `Ψ j π = γ j`, trivial on `U⁰ = 𝒪[F]ˣ`, and compatible with the
restrictions `Gal(E (j+1)/F) → Gal(E j/F)`.

`Ψ j` is the unramified Artin symbol: exponentiate `γ j` (the Frobenius at level `j`) by the
valuation `valExpo` of `x`.  It is surjective because `γ j` has order `[E j : F]`, which is the
order of `Gal(E j/F)`; it is trivial on `U⁰` because `U⁰` is the kernel of the valuation; and it is
compatible because `γ (j+1)` restricts to `γ j` and powers of compatible automorphisms are
compatible (`zpow_compat_of_compat`). -/
theorem exists_unramifiedSymbol_family {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    {π : (Q.adicCompletion K)ˣ}
    (hπ : NK.LocalReciprocityLubinTate.IsUniformizer (Q.adicCompletion K) (π : Q.adicCompletion K))
    (E : ℕ → IntermediateField (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K)))
    (hmono : ∀ j : ℕ, E j ≤ E (j + 1))
    (hfd : ∀ j : ℕ, FiniteDimensional (Q.adicCompletion K) ↥(E j))
    (hgal : ∀ j : ℕ, IsGalois (Q.adicCompletion K) ↥(E j))
    (hfin : ∀ j : ℕ, Module.finrank (Q.adicCompletion K) ↥(E j) = Nat.factorial (j + 1))
    (γ : ∀ j : ℕ, ↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j))
    (hγ : ∀ j : ℕ, orderOf (γ j) = Nat.factorial (j + 1))
    (hγcompat : ∀ (j : ℕ) (y : ↥(E j)),
      ((γ (j + 1)) ⟨y.1, hmono j y.2⟩ : ↥(E (j + 1))) = ⟨(γ j y).1, hmono j (γ j y).2⟩)
    (hN : ∀ j : ℕ, NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(E j)
      = Subgroup.zpowers
          (NK.LocalReciprocityLubinTate.uniformizerUnit K Q ^ Nat.factorial (j + 1))
        ⊔ NK.LocalReciprocityLubinTate.adicUnits K Q) :
    ∃ Ψ : ∀ j : ℕ,
        (Q.adicCompletion K)ˣ →* (↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j)),
      (∀ j : ℕ, Function.Surjective (Ψ j)) ∧
      (∀ j : ℕ, Ψ j π = γ j) ∧
      (∀ (j : ℕ) (u : (↥(ValuativeRel.valuation (Q.adicCompletion K)).integer)ˣ),
        Ψ j (NK.LocalReciprocityLubinTate.Units.unitsIncl (Q.adicCompletion K) u) = 1) ∧
      (∀ (j : ℕ) (x : (Q.adicCompletion K)ˣ) (y : ↥(E j)),
        ((Ψ (j + 1) x) ⟨y.1, hmono j y.2⟩ : ↥(E (j + 1))) =
          ⟨((Ψ j x) y).1, hmono j ((Ψ j x) y).2⟩) := by
  -- `γ j` generates `Gal(E j / F)`, because its order `(j+1)!` is the order of the group.
  have htop : ∀ j : ℕ, Subgroup.zpowers (γ j) = ⊤ := by
    intro j
    haveI := hfd j
    haveI := hgal j
    refine Subgroup.eq_top_of_card_eq _ ?_
    rw [Nat.card_zpowers, hγ j, IsGalois.card_aut_eq_finrank (Q.adicCompletion K) ↥(E j), hfin j]
  -- the unramified Artin symbol at level `j`: `x ↦ γ j ^ (valuation of x)`.
  let Ψ : ∀ j : ℕ, (Q.adicCompletion K)ˣ →* (↥(E j) ≃ₐ[Q.adicCompletion K] ↥(E j)) := fun j =>
    { toFun := fun x => (γ j) ^ (valExpo (Q.adicCompletion K) π hπ x)
      map_one' := by rw [valExpo_one, zpow_zero]
      map_mul' := by intro x y; rw [valExpo_mul, zpow_add] }
  have hΨ : ∀ (j : ℕ) (x : (Q.adicCompletion K)ˣ),
      Ψ j x = (γ j) ^ (valExpo (Q.adicCompletion K) π hπ x) := fun j x => rfl
  refine ⟨Ψ, ?_, ?_, ?_, ?_⟩
  · intro j σ
    have hmem : σ ∈ Subgroup.zpowers (γ j) := by rw [htop j]; exact Subgroup.mem_top σ
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hmem
    refine ⟨π ^ k, ?_⟩
    rw [hΨ, valExpo_zpow, hk]
  · intro j
    rw [hΨ, valExpo_pi, zpow_one]
  · intro j u
    rw [hΨ, valExpo_unitsIncl, zpow_zero]
  · intro j x y
    rw [hΨ (j+1) x, hΨ j x]
    exact zpow_compat_of_compat Q E hmono j (γ (j+1)) (γ j) (hγcompat j)
      (valExpo (Q.adicCompletion K) π hπ x) y

end

end NK.LocalReciprocityLubinTate.Unramified
