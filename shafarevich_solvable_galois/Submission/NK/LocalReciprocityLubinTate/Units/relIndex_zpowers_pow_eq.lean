set_option linter.unusedVariables false

namespace NK.LocalReciprocityLubinTate.Units

/-- In `Multiplicative A`, the subgroup generated by `ofAdd a` is the multiplicative copy of the
additive subgroup generated by `a`. -/
lemma zpowers_ofAdd_eq_toSubgroup {A : Type*} [AddGroup A] (a : A) :
    Subgroup.zpowers (Multiplicative.ofAdd a) = (AddSubgroup.zmultiples a).toSubgroup := by
  ext x
  rw [Subgroup.mem_zpowers_iff, Multiplicative.mem_toSubgroup, AddSubgroup.mem_zmultiples_iff]
  constructor
  · rintro ⟨m, hm⟩
    exact ⟨m, by rw [← hm, ← ofAdd_zsmul, toAdd_ofAdd]⟩
  · rintro ⟨m, hm⟩
    exact ⟨m, by rw [← ofAdd_zsmul, hm, ofAdd_toAdd]⟩

/-- In `Multiplicative ℤ`, the element `ofAdd 1` generates the whole group. -/
lemma zpowers_ofAdd_one : Subgroup.zpowers (Multiplicative.ofAdd (1 : ℤ)) = ⊤ := by
  rw [Subgroup.eq_top_iff']
  intro x
  rw [Subgroup.mem_zpowers_iff]
  exact ⟨x.toAdd, by rw [← ofAdd_zsmul]; simp⟩

/-- **The relative index of `⟨g ^ k⟩` in `⟨g⟩` for `g` of infinite order is `k`.**

The map `ℤ → G`, `n ↦ g ^ n`, is injective exactly when `g` has infinite order, so `⟨g⟩` is an
infinite cyclic group with generator `g`; under this identification `⟨g ^ k⟩ = kℤ` and the index
of `kℤ` in `ℤ` is `k`. -/
theorem relIndex_zpowers_pow_eq {G : Type*} [Group G] (g : G) (hg : orderOf g = 0) {k : ℕ}
    (hk : 1 ≤ k) : (Subgroup.zpowers (g ^ k)).relIndex (Subgroup.zpowers g) = k := by
  -- `g` generates a copy of `ℤ` inside `G`: the hom `f : Multiplicative ℤ →* G`, `ofAdd n ↦ g ^ n`,
  -- is injective because `orderOf g = 0`.
  set f : Multiplicative ℤ →* G := zpowersHom G g with hf
  have hker : f.ker = ⊥ := by
    rw [hf, zpowersHom_ker_eq, hg]
    simp
  have hinj : Function.Injective f := (MonoidHom.ker_eq_bot_iff f).mp hker
  -- Relative index is preserved by an injective homomorphism, so it suffices to compute it for
  -- `kℤ ≤ ℤ` inside `Multiplicative ℤ`.
  have key := Subgroup.relIndex_map_map_of_injective (f := f)
      (Subgroup.zpowers (Multiplicative.ofAdd (k : ℤ)))
      (Subgroup.zpowers (Multiplicative.ofAdd (1 : ℤ))) hinj
  rw [MonoidHom.map_zpowers, MonoidHom.map_zpowers] at key
  have hfk : f (Multiplicative.ofAdd (k : ℤ)) = g ^ k := by
    rw [hf, zpowersHom_apply, toAdd_ofAdd, zpow_natCast]
  have hf1 : f (Multiplicative.ofAdd (1 : ℤ)) = g := by
    rw [hf, zpowersHom_apply, toAdd_ofAdd, zpow_one]
  rw [hfk, hf1] at key
  -- `ofAdd 1` generates `Multiplicative ℤ`, and `⟨ofAdd k⟩` corresponds to `kℤ`, whose index in
  -- `ℤ` is `|k| = k`.
  rw [key, zpowers_ofAdd_one, Subgroup.relIndex_top_right, zpowers_ofAdd_eq_toSubgroup,
      AddSubgroup.index_toSubgroup, Int.index_zmultiples, Int.natAbs_natCast]

end NK.LocalReciprocityLubinTate.Units
