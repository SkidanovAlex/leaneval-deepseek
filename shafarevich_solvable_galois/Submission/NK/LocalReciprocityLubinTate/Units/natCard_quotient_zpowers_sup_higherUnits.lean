/-!
# The index of `⟨π⟩ · U^n` in `Fˣ`

For a nonarchimedean local field `F` with uniformiser `π`, residue cardinality `q = #𝓀[F]` and
higher unit filtration `U^n = higherUnits F n`, the group `Fˣ / (⟨π⟩ · U^n)` is finite of order
`(q - 1) q ^ (n - 1)` (`n ≥ 1`).

The proof splits the group `Fˣ` along the valuation.  The valuation restricted to the units is a
homomorphism `valUnits : Fˣ →* (ValueGroupWithZero F)ˣ` with kernel the units `𝒪[F]ˣ` of the ring of
integers; since `π` is a uniformiser its image under `valUnits` generates the value group, so
`⟨π⟩` is a complement of `𝒪[F]ˣ` in `Fˣ`:

* `Subgroup.zpowers π ⊓ 𝒪[F]ˣ = ⊥` (`inf_zpowers_range`),
* `Subgroup.zpowers π ⊔ 𝒪[F]ˣ = ⊤` (`sup_zpowers_range`).

Consequently the inclusion `𝒪[F]ˣ ⧸ principalUnits F n → Fˣ ⧸ (⟨π⟩ · higherUnits F n)` is an
isomorphism, and the result follows from the cardinality of `𝒪[F]ˣ ⧸ principalUnits F n`, which is
the standard count `#(𝒪[F]/𝔪^n)ˣ = (q-1) q^{n-1}`.
-/

open scoped ValuativeRel

namespace NK.LocalReciprocityLubinTate.Units

universe u

noncomputable section

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

/-- The inclusion of the units of the ring of integers `𝒪[F]` into the units `Fˣ` of the field. -/
def unitsIncl : (↥𝒪[F])ˣ →* Fˣ :=
  _root_.Units.map (Subring.subtype 𝒪[F]).toMonoidHom

/-- The valuation of `F`, restricted to the units, with values in the units of the value group. -/
def valUnits : Fˣ →* (ValuativeRel.ValueGroupWithZero F)ˣ :=
  _root_.Units.map (ValuativeRel.valuation F).toMonoidHom

theorem valUnits_pi (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    valUnits F π = _root_.Units.mk0 (ValuativeRel.valuation F π) hπ.val_ne_zero := by
  ext; rfl

omit [TopologicalSpace F] [IsNonarchimedeanLocalField F] in
/-- The kernel of the valuation on the units is the group of units of the ring of integers. -/
theorem ker_valUnits : (valUnits F).ker = (unitsIncl F).range := by
  ext x
  rw [MonoidHom.mem_ker, MonoidHom.mem_range]
  constructor
  · intro hx
    have hv : ValuativeRel.valuation F (x : F) = 1 := by
      have h : ((valUnits F x : (ValuativeRel.ValueGroupWithZero F)ˣ) :
            ValuativeRel.ValueGroupWithZero F)
          = ((1 : (ValuativeRel.ValueGroupWithZero F)ˣ) :
            ValuativeRel.ValueGroupWithZero F) := by
        rw [hx]
      simpa [valUnits] using h
    have hmem : (x : F) ∈ (ValuativeRel.valuation F).integer := by
      rw [Valuation.mem_integer_iff, hv]
    have halg : (algebraMap ↥𝒪[F] F) (⟨(x : F), hmem⟩ : ↥𝒪[F]) = (x : F) := rfl
    have hunit : IsUnit (⟨(x : F), hmem⟩ : ↥𝒪[F]) := by
      rw [Valuation.Integers.isUnit_iff_valuation_eq_one
        (Valuation.integer.integers (ValuativeRel.valuation F)), halg]
      exact hv
    refine ⟨hunit.unit, ?_⟩
    apply Units.ext
    show ((hunit.unit : ↥𝒪[F]) : F) = (x : F)
    rw [IsUnit.unit_spec]
  · rintro ⟨u, rfl⟩
    have hv : ValuativeRel.valuation F (((u : ↥𝒪[F]) : F)) = 1 := by
      have h := (Valuation.Integers.isUnit_iff_valuation_eq_one
        (v := ValuativeRel.valuation F) (O := ↥𝒪[F])
        (Valuation.integer.integers (ValuativeRel.valuation F))).mp u.isUnit
      rw [show (algebraMap ↥𝒪[F] F) (u : ↥𝒪[F]) = ((u : ↥𝒪[F]) : F) from rfl] at h
      exact h
    ext
    simp only [valUnits, unitsIncl, Units.coe_map, Units.val_one]
    exact hv

/-- Every unit of `F` lies in the subgroup generated by `π` and `𝒪[F]ˣ`, because `valUnits π`
generates the value group. -/
theorem mem_zpowers_valUnits_pi (π : Fˣ) (hπ : IsUniformizer F (π : F)) (x : Fˣ) :
    valUnits F x ∈ Subgroup.zpowers (valUnits F π) := by
  have hmem : valUnits F x ∈ ((ValuativeRel.valuation F : F →*₀ ValuativeRel.ValueGroupWithZero F)).valueGroup := by
    apply Subgroup.subset_closure
    change (ValuativeRel.valuation F x : ValuativeRel.ValueGroupWithZero F) ∈
      Set.range ⇑(ValuativeRel.valuation F)
    exact Set.mem_range_self _
  rw [hπ.zpowers_eq_valueGroup] at hmem
  rwa [← valUnits_pi F π hπ] at hmem

/-- A power of `valUnits π` is trivial only for the zero exponent. -/
theorem zpow_valUnits_pi_eq_one_iff (π : Fˣ) (hπ : IsUniformizer F (π : F)) (k : ℤ) :
    (valUnits F π) ^ k = 1 ↔ k = 0 := by
  constructor
  · intro hk
    have h1 : (ValuativeRel.valuation F π) ^ k = 1 := by
      have h := congrArg (fun u : (ValuativeRel.ValueGroupWithZero F)ˣ =>
        (u : ValuativeRel.ValueGroupWithZero F)) hk
      simpa [valUnits, Units.val_zpow_eq_zpow_val] using h
    exact (zpow_eq_one_iff_right₀ (le_of_lt hπ.val_pos) (ne_of_lt hπ.val_lt_one)).mp h1
  · rintro rfl
    exact zpow_zero _

/-- `⟨π⟩` and the units of the ring of integers intersect trivially. -/
theorem inf_zpowers_range (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    Subgroup.zpowers π ⊓ (unitsIncl F).range = ⊥ := by
  rw [eq_bot_iff]
  intro y hy
  rw [Subgroup.mem_inf] at hy
  obtain ⟨hy1, hy2⟩ := hy
  rw [Subgroup.mem_bot]
  rw [Subgroup.mem_zpowers_iff] at hy1
  obtain ⟨k, hk⟩ := hy1
  have hyv : valUnits F y = 1 := by
    rw [← ker_valUnits] at hy2
    exact MonoidHom.mem_ker.mp hy2
  rw [← hk, map_zpow] at hyv
  have hk0 : k = 0 := (zpow_valUnits_pi_eq_one_iff F π hπ k).mp hyv
  rw [← hk, hk0, zpow_zero]

/-- `⟨π⟩` and the units of the ring of integers generate `Fˣ`. -/
theorem sup_zpowers_range (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    Subgroup.zpowers π ⊔ (unitsIncl F).range = ⊤ := by
  rw [eq_top_iff]
  intro x _
  rw [Subgroup.mem_sup]
  obtain ⟨k, hk⟩ := (Subgroup.mem_zpowers_iff.mp (mem_zpowers_valUnits_pi F π hπ x))
  refine ⟨π ^ k, Subgroup.mem_zpowers_iff.mpr ⟨k, rfl⟩, x * π ^ (-k), ?_, ?_⟩
  · rw [← ker_valUnits, MonoidHom.mem_ker, map_mul, map_zpow, ← hk, ← zpow_add]
    simp
  · rw [mul_comm (π ^ k) (x * π ^ (-k)), mul_assoc, ← zpow_add]
    simp

/-- **The index of `⟨π⟩ · U^n` in `Fˣ`.**

For a nonarchimedean local field `F` with residue cardinality `q = #𝓀[F]`, uniformiser `π` and
higher unit group `U^n = higherUnits F n` (`n ≥ 1`), the quotient `Fˣ / (⟨π⟩ · U^n)` has order
`(q - 1) q ^ (n - 1)`. -/
theorem natCard_quotient_zpowers_sup_higherUnits (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (π : Fˣ)
    (hπ : NK.LocalReciprocityLubinTate.IsUniformizer F (π : F)) (n : ℕ) (hn : 1 ≤ n) :
    Nat.card (Fˣ ⧸ (Subgroup.zpowers π ⊔ NK.LocalReciprocityLubinTate.higherUnits F n)) =
      (NK.LocalReciprocityLubinTate.residueCard F - 1) *
        NK.LocalReciprocityLubinTate.residueCard F ^ (n - 1) := by
  have hιinj : Function.Injective (unitsIncl F) :=
    _root_.Units.map_injective (f := (Subring.subtype 𝒪[F]).toMonoidHom)
      (fun a b h => Subtype.ext h)
  have hinf := inf_zpowers_range F π hπ
  have hsup := sup_zpowers_range F π hπ
  have hUm : higherUnits F n = (principalUnits F n).map (unitsIncl F) := rfl
  have hKU : (Subgroup.zpowers π ⊔ higherUnits F n) ⊓ (unitsIncl F).range = higherUnits F n := by
    apply le_antisymm
    · intro y hy
      rw [Subgroup.mem_inf, Subgroup.mem_sup] at hy
      obtain ⟨⟨a, ha, b, hb, hab⟩, hyr⟩ := hy
      have hbr : b ∈ (unitsIncl F).range :=
        Subgroup.map_le_range (unitsIncl F) (principalUnits F n) (hUm ▸ hb)
      have har : a ∈ (unitsIncl F).range := by
        have : a = y * b⁻¹ := by rw [← hab]; group
        rw [this]
        exact Subgroup.mul_mem _ hyr (Subgroup.inv_mem _ hbr)
      have ha1 : a = 1 := by
        have : a ∈ Subgroup.zpowers π ⊓ (unitsIncl F).range := ⟨ha, har⟩
        rw [hinf, Subgroup.mem_bot] at this
        exact this
      rw [← hab, ha1, one_mul]
      exact hb
    · intro y hy
      rw [Subgroup.mem_inf]
      exact ⟨Subgroup.mem_sup_right hy,
        Subgroup.map_le_range (unitsIncl F) (principalUnits F n) (hUm ▸ hy)⟩
  let Φ : (↥𝒪[F])ˣ ⧸ principalUnits F n →*
      Fˣ ⧸ (Subgroup.zpowers π ⊔ higherUnits F n) :=
    QuotientGroup.map (principalUnits F n) (Subgroup.zpowers π ⊔ higherUnits F n) (unitsIncl F) (by
      intro u hu
      rw [Subgroup.mem_comap]
      exact Subgroup.mem_sup_right (hUm.symm ▸ Subgroup.mem_map_of_mem (unitsIncl F) hu))
  have hinj : Function.Injective Φ := by
    rw [← MonoidHom.ker_eq_bot_iff Φ, QuotientGroup.ker_map, Subgroup.map_eq_bot_iff,
      QuotientGroup.ker_mk']
    intro u hu
    rw [Subgroup.mem_comap] at hu
    have h1 : unitsIncl F u ∈ (Subgroup.zpowers π ⊔ higherUnits F n) ⊓ (unitsIncl F).range :=
      ⟨hu, MonoidHom.mem_range.mpr ⟨u, rfl⟩⟩
    rw [hKU] at h1
    rw [hUm, Subgroup.mem_map_iff_mem hιinj] at h1
    exact h1
  have hsurj : Function.Surjective Φ := by
    intro y
    refine QuotientGroup.induction_on y ?_
    intro x
    have hx : x ∈ Subgroup.zpowers π ⊔ (unitsIncl F).range := by rw [hsup]; trivial
    rw [Subgroup.mem_sup] at hx
    obtain ⟨a, ha, b, hb, hab⟩ := hx
    obtain ⟨u, rfl⟩ := MonoidHom.mem_range.mp hb
    refine ⟨↑u, ?_⟩
    rw [QuotientGroup.map_mk, ← hab, QuotientGroup.eq]
    have hcomm : (unitsIncl F u)⁻¹ * (a * unitsIncl F u) = a := by
      rw [mul_comm a (unitsIncl F u), ← mul_assoc, inv_mul_cancel, one_mul]
    rw [hcomm]
    exact Subgroup.mem_sup_left ha
  let e := MulEquiv.ofBijective Φ ⟨hinj, hsurj⟩
  calc Nat.card (Fˣ ⧸ (Subgroup.zpowers π ⊔ higherUnits F n))
      = Nat.card ((↥𝒪[F])ˣ ⧸ principalUnits F n) := (Nat.card_congr e.toEquiv).symm
    _ = Nat.card (((↥𝒪[F]) ⧸ maximalIdealOfIntegers F ^ n))ˣ :=
        Nat.card_congr (Classical.choice (unitsQuotPrincipalUnitsEquiv F n)).toEquiv
    _ = (residueCard F - 1) * residueCard F ^ (n - 1) :=
        natCard_units_quot_pow_maximalIdeal F n hn

end

end NK.LocalReciprocityLubinTate.Units
