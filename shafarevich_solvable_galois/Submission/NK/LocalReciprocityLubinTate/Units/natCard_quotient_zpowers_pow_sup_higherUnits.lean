/-!
# The index of `⟨π ^ (m+1)⟩ · U ^ (n+1)` in `Fˣ`

For a nonarchimedean local field `F` with uniformiser `π`, residue cardinality `q = #𝓀[F]` and
higher unit filtration `U^n = higherUnits F n`, the group
`Fˣ / (⟨π ^ (m+1)⟩ · U ^ (n+1))` is finite of order `(m + 1) (q - 1) q ^ n`.

This is the index of the Lubin–Tate norm group `N_{E_{m,n}/F} E_{m,n}ˣ = ⟨π^{m+1}⟩ · U^{n+1}`
(Serre, *Local Fields*, Ch. XV §3–§5), and hence the degree of the level `E_{m,n}` over `F`.

## The proof

The valuation restricted to the units, `valUnits F : Fˣ →* (ValueGroupWithZero F)ˣ`, has kernel the
units `𝒪[F]ˣ = unitsIncl F` (`ker_valUnits`) and image generated by the image of a uniformiser
(`range_valUnits`).  Writing

* `A = ⟨π^(m+1)⟩`,
* `D = 𝒪[F]ˣ ≤ Fˣ` (the units of the ring of integers),
* `B = U^(n+1) ≤ D`,

the quotient `Fˣ ⧸ (A ⊔ B)` splits, by `Subgroup.quotientEquivProdOfLE`, as the product of

* `Fˣ ⧸ (A ⊔ D)`, of order `m + 1`: the index of `A ⊔ D` is computed from `Subgroup.index_comap`
  applied to `valUnits`, reducing it to the index of `⟨g^(m+1)⟩` in the infinite cyclic group
  `⟨g⟩`, `g = valUnits F π` (`relIndex_zpowers_pow_eq`);
* `(A ⊔ D) ⧸ (A ⊔ B)`, which is isomorphic to `𝒪[F]ˣ ⧸ U^(n+1)`: the inclusion `𝒪[F]ˣ → A ⊔ D` is
  surjective with kernel `U^(n+1)`, using `(A ⊔ B) ⊓ D = B` (a consequence of
  `⟨π⟩ ⊓ 𝒪[F]ˣ = ⊥`).

The order of `𝒪[F]ˣ ⧸ U^(n+1)` is the standard `#(𝒪[F]/𝔪^(n+1))ˣ = (q-1) q^n`
(`unitsQuotPrincipalUnitsEquiv` and `natCard_units_quot_pow_maximalIdeal`).
-/

open scoped ValuativeRel

namespace NK.LocalReciprocityLubinTate.Units

universe u

noncomputable section

variable (F : Type u) [Field F] [ValuativeRel F] [TopologicalSpace F]
  [IsNonarchimedeanLocalField F]

/-- **The image of the valuation on the units is generated by the image of a uniformiser.**

The value group of `F` is generated by `valUnits F π` when `π` is a uniformiser, so the same is
true of the image of the valuation on `Fˣ`. -/
theorem range_valUnits (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    (valUnits F).range = Subgroup.zpowers (valUnits F π) := by
  refine le_antisymm ?_ ?_
  · rintro _ ⟨x, rfl⟩
    exact mem_zpowers_valUnits_pi F π hπ x
  · rw [Subgroup.zpowers_le]
    exact MonoidHom.mem_range.mpr ⟨π, rfl⟩

/-- **The image of a uniformiser under the valuation on the units has infinite order.** -/
theorem orderOf_valUnits_pi (π : Fˣ) (hπ : IsUniformizer F (π : F)) :
    orderOf (valUnits F π) = 0 := by
  rw [orderOf_eq_zero_iff, isOfFinOrder_iff_pow_eq_one]
  rintro ⟨n, hn, hn1⟩
  have h2 : (valUnits F π) ^ (n : ℤ) = 1 := by
    rw [zpow_natCast]
    exact hn1
  have h3 := (zpow_valUnits_pi_eq_one_iff F π hπ (n : ℤ)).mp h2
  omega

/-- **The index of `⟨π ^ k⟩ · 𝒪[F]ˣ` in `Fˣ` is `k`.**

`⟨π^k⟩ ⊔ 𝒪[F]ˣ` is the preimage under `valUnits` of the subgroup generated by the `k`-th power of
`valUnits F π`, and `valUnits F π` generates the value group `⟨valUnits F π⟩`; the index is
therefore the index of `⟨g^k⟩` in the infinite cyclic group `⟨g⟩`. -/
theorem index_zpowers_pow_sup_range_units (π : Fˣ) (hπ : IsUniformizer F (π : F)) {k : ℕ}
    (hk : 1 ≤ k) : (Subgroup.zpowers (π ^ k) ⊔ (unitsIncl F).range).index = k := by
  have h1 : Subgroup.zpowers (π ^ k) ⊔ (unitsIncl F).range
      = Subgroup.comap (valUnits F) (Subgroup.zpowers ((valUnits F π) ^ k)) := by
    rw [← ker_valUnits F, ← Subgroup.comap_map_eq (valUnits F) (Subgroup.zpowers (π ^ k))]
    rw [MonoidHom.map_zpowers, map_pow]
  rw [h1]
  rw [Subgroup.index_comap]
  rw [range_valUnits F π hπ]
  exact relIndex_zpowers_pow_eq (valUnits F π) (orderOf_valUnits_pi F π hπ) hk

/-- **The index of the Lubin–Tate norm group `⟨π ^ (m+1)⟩ · U ^ (n+1)` in `Fˣ`.**

For a nonarchimedean local field `F` with residue cardinality `q = #𝓀[F]`, uniformiser `π` and
higher unit group `U^n = higherUnits F n`, the quotient `Fˣ / (⟨π^{m+1}⟩ · U^{n+1})` has order
`(m + 1) (q - 1) q ^ n`. -/
theorem natCard_quotient_zpowers_pow_sup_higherUnits (F : Type u) [Field F] [ValuativeRel F]
    [TopologicalSpace F] [IsNonarchimedeanLocalField F] (π : Fˣ)
    (hπ : NK.LocalReciprocityLubinTate.IsUniformizer F (π : F)) (m n : ℕ) :
    Nat.card (Fˣ ⧸ (Subgroup.zpowers (π ^ (m + 1)) ⊔
        NK.LocalReciprocityLubinTate.higherUnits F (n + 1))) =
      (m + 1) * (NK.LocalReciprocityLubinTate.residueCard F - 1) *
        NK.LocalReciprocityLubinTate.residueCard F ^ n := by
  have hιinj : Function.Injective (unitsIncl F) :=
    Units.map_injective (f := (Subring.subtype 𝒪[F]).toMonoidHom) (fun a b h => Subtype.ext h)
  set A : Subgroup Fˣ := Subgroup.zpowers (π ^ (m + 1)) with hA
  set D : Subgroup Fˣ := (unitsIncl F).range with hD
  set B : Subgroup Fˣ := NK.LocalReciprocityLubinTate.higherUnits F (n + 1) with hB
  have hBm : B = (principalUnits F (n + 1)).map (unitsIncl F) := by
    rw [hB]
    rfl
  have hBD : B ≤ D := by
    rw [hD, hBm]
    exact Subgroup.map_le_range (unitsIncl F) (principalUnits F (n + 1))
  -- `⟨π ^ (m+1)⟩` meets `𝒪[F]ˣ` trivially
  have hpow_mem : π ^ (m + 1) ∈ Subgroup.zpowers π :=
    Subgroup.mem_zpowers_iff.mpr ⟨((m + 1 : ℕ) : ℤ), by rw [zpow_natCast]⟩
  have hle : Subgroup.zpowers (π ^ (m + 1)) ≤ Subgroup.zpowers π :=
    Subgroup.zpowers_le.mpr hpow_mem
  have hinf : A ⊓ D = ⊥ := by
    rw [hA, hD]
    apply le_antisymm _ bot_le
    intro y hy
    rw [Subgroup.mem_inf] at hy
    have h2 : y ∈ Subgroup.zpowers π ⊓ (unitsIncl F).range := ⟨hle hy.1, hy.2⟩
    rwa [inf_zpowers_range F π hπ] at h2
  -- hence `(A ⊔ B) ⊓ D = B`
  have hKU : (A ⊔ B) ⊓ D = B := by
    apply le_antisymm
    · intro y hy
      rw [Subgroup.mem_inf, Subgroup.mem_sup] at hy
      obtain ⟨⟨a, ha, b, hb, hab⟩, hyr⟩ := hy
      have hbr : b ∈ D := hBD hb
      have har : a ∈ D := by
        have h : a = y * b⁻¹ := by rw [← hab]; group
        rw [h]; exact Subgroup.mul_mem _ hyr (Subgroup.inv_mem _ hbr)
      have ha1 : a = 1 := by
        have hmem : a ∈ A ⊓ D := ⟨ha, har⟩
        rw [hinf] at hmem
        exact Subgroup.mem_bot.mp hmem
      rw [← hab, ha1, one_mul]
      exact hb
    · intro y hy
      rw [Subgroup.mem_inf]
      exact ⟨Subgroup.mem_sup_right hy, hBD hy⟩
  -- the product splitting
  have hprod : Nat.card (Fˣ ⧸ (A ⊔ B)) =
      Nat.card (Fˣ ⧸ (A ⊔ D)) *
        Nat.card (↥(A ⊔ D) ⧸ (A ⊔ B).subgroupOf (A ⊔ D)) := by
    rw [Nat.card_congr (Subgroup.quotientEquivProdOfLE (sup_le_sup_left hBD A)), Nat.card_prod]
  -- the first factor
  have hfirst : Nat.card (Fˣ ⧸ (A ⊔ D)) = m + 1 := by
    rw [← Subgroup.index_eq_card (A ⊔ D), hA, hD]
    exact index_zpowers_pow_sup_range_units F π hπ (Nat.le_add_left 1 m)
  -- the second factor: `(A ⊔ D) ⧸ (A ⊔ B) ≃* 𝒪[F]ˣ ⧸ U^(n+1)`
  have hsecond : Nat.card (↥(A ⊔ D) ⧸ (A ⊔ B).subgroupOf (A ⊔ D)) =
      Nat.card ((↥𝒪[F])ˣ ⧸ principalUnits F (n + 1)) := by
    let ι' : (↥𝒪[F])ˣ →* ↥(A ⊔ D) :=
      { toFun := fun u => ⟨unitsIncl F u, Subgroup.mem_sup_right (MonoidHom.mem_range.mpr ⟨u, rfl⟩)⟩
        map_one' := by ext; simp
        map_mul' := by intro a b; ext; simp }
    let Ψ : (↥𝒪[F])ˣ ⧸ principalUnits F (n + 1) →*
        ↥(A ⊔ D) ⧸ (A ⊔ B).subgroupOf (A ⊔ D) :=
      QuotientGroup.map (principalUnits F (n + 1)) ((A ⊔ B).subgroupOf (A ⊔ D)) ι' (by
        intro u hu
        rw [Subgroup.mem_comap, Subgroup.mem_subgroupOf, hBm]
        exact Subgroup.mem_sup_right (Subgroup.mem_map_of_mem (unitsIncl F) hu))
    have hinj : Function.Injective Ψ := by
      rw [← MonoidHom.ker_eq_bot_iff Ψ, QuotientGroup.ker_map, Subgroup.map_eq_bot_iff,
        QuotientGroup.ker_mk']
      intro u hu
      rw [Subgroup.mem_comap] at hu
      have h1 : unitsIncl F u ∈ (A ⊔ B) ⊓ D :=
        ⟨Subgroup.mem_subgroupOf.mp hu, MonoidHom.mem_range.mpr ⟨u, rfl⟩⟩
      rw [hKU] at h1
      rwa [hBm, Subgroup.mem_map_iff_mem hιinj] at h1
    have hsurj : Function.Surjective Ψ := by
      intro y
      refine QuotientGroup.induction_on y ?_
      intro x
      have hx : (x : Fˣ) ∈ A ⊔ D := x.2
      rw [Subgroup.mem_sup] at hx
      obtain ⟨a, ha, b, hb, hab⟩ := hx
      obtain ⟨u, rfl⟩ := MonoidHom.mem_range.mp (hD ▸ hb)
      refine ⟨u, ?_⟩
      rw [QuotientGroup.map_mk, QuotientGroup.eq]
      apply Subgroup.mem_subgroupOf.mpr
      have hcoe : ((((ι' u)⁻¹ * x : ↥(A ⊔ D))) : Fˣ) = a := by
        show (unitsIncl F u)⁻¹ * (x : Fˣ) = a
        rw [← hab, mul_comm a ((unitsIncl F) u), inv_mul_cancel_left]
      rw [hcoe]
      exact Subgroup.mem_sup_left ha
    exact (Nat.card_congr (MulEquiv.ofBijective Ψ ⟨hinj, hsurj⟩).toEquiv).symm
  -- the order of `𝒪[F]ˣ ⧸ U^(n+1)`
  have hunits : Nat.card ((↥𝒪[F])ˣ ⧸ principalUnits F (n + 1)) =
      (NK.LocalReciprocityLubinTate.residueCard F - 1) *
        NK.LocalReciprocityLubinTate.residueCard F ^ n := by
    rw [Nat.card_congr (Classical.choice (unitsQuotPrincipalUnitsEquiv F (n + 1))).toEquiv]
    simpa using natCard_units_quot_pow_maximalIdeal F (n + 1) (Nat.le_add_left 1 n)
  rw [hprod, hfirst, hsecond, hunits]
  ring

end

end NK.LocalReciprocityLubinTate.Units
