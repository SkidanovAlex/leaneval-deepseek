/-!
# Divisibility by `π` of the coefficients of the Lubin–Tate discrepancy `D φ`

For Lubin–Tate series `f`, `g` and any `φ` with `φ(0) = 0`, all coefficients of the discrepancy

`D φ = f ∘ φ - φ ∘ (X ↦ g(X))`

are divisible by `π`.  This is the observation on which the degree induction
(`existsUnique_lubinTate_solution`) runs: it says that the discrepancy `D φ` always lies in the
ideal generated by `π`, so that the equation `D φ = 0` is, at the level of coefficients, an
equation of the form `π · (unit) = (something)`.

The mathematical content is the "freshman's dream" in the residue ring: the image of a
Lubin–Tate series in `A ⧸ (π)` is `X^q`, and in the residue ring the `q`-th power map is additive
(because `q` is a power of the residue characteristic) and the identity (because the residue ring
satisfies `z^q = z`); hence `φ^q = φ(X₁^q, …, Xₙ^q)` modulo `π`.

## Proof outline

Let `I = (π)` and let `mk : A →+* A ⧸ I` be the quotient map.  Working in `A ⧸ I`,
* every coefficient of `f - X^q` lies in `I`, hence `map mk f = X^q` (`map_mk_isLubinTateSeries`);
* similarly `map mk (gSub n g i) = Xᵢ^q` (`map_mk_gSub`);
* the `q`-th power and the substitution `Xᵢ ↦ Xᵢ^q` agree in the residue ring
  (`subst_X_pow_eq_pow`, proved from `MvPowerSeries.map_iterateFrobenius_expand`).

Since `MvPowerSeries.map` commutes with substitution (`MvPowerSeries.map_subst`), the image of `D φ`
in the residue ring is `φ^q - φ^q = 0`.
-/

open MvPowerSeries

namespace NK.LocalReciprocityLubinTate.ModPi

universe u v

variable {A : Type u} [CommRing A]

section OneVariable

/-- In one variable, an exponent vector is determined by its `0`-th component. -/
theorem finsupp_fin_one_eq_single (s : Fin 1 →₀ ℕ) : s = Finsupp.single 0 (s 0) := by
  apply Finsupp.ext
  intro i
  rw [show i = 0 from Subsingleton.elim i 0]
  simp

/-- The coefficients of a one-variable power series are its `coeffX`s. -/
theorem coeff_eq_coeffX (s : Fin 1 →₀ ℕ) (f : MvPowerSeries (Fin 1) A) :
    MvPowerSeries.coeff s f = coeffX (s 0) f := by
  rw [finsupp_fin_one_eq_single s]
  simp [coeffX]

/-- The `k`-th coefficient of `X^q`. -/
theorem coeffX_X_pow (k q : ℕ) :
    coeffX k ((MvPowerSeries.X 0 : MvPowerSeries (Fin 1) A) ^ q) = if k = q then 1 else 0 := by
  rw [coeffX, MvPowerSeries.coeff_X_pow]
  by_cases hk : k = q
  · rw [if_pos (by rw [hk]), if_pos hk]
  · rw [if_neg (fun h => hk (by simpa using congrArg (fun g : Fin 1 →₀ ℕ => g 0) h)),
      if_neg hk]

end OneVariable

/-- `map mk h = 0` if and only if every coefficient of `h` lies in `I`. -/
theorem map_mk_eq_zero_iff {I : Ideal A} {σ : Type v} {h : MvPowerSeries σ A} :
    MvPowerSeries.map (Ideal.Quotient.mk I) h = 0 ↔
      ∀ s : σ →₀ ℕ, MvPowerSeries.coeff s h ∈ I := by
  constructor
  · intro hh s
    have hc := congrArg (fun x => MvPowerSeries.coeff s x) hh
    rw [MvPowerSeries.coeff_map, MvPowerSeries.coeff_zero] at hc
    exact Ideal.Quotient.eq_zero_iff_mem.mp hc
  · intro hh
    ext s
    rw [MvPowerSeries.coeff_map, MvPowerSeries.coeff_zero]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hh s)

/-- **The image of a Lubin–Tate series in the residue ring is `X^q`.** -/
theorem map_mk_isLubinTateSeries {π : A} {q : ℕ} {f : MvPowerSeries (Fin 1) A}
    (hf : IsLubinTateSeries π q f) :
    MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) f =
      (MvPowerSeries.X 0 : MvPowerSeries (Fin 1) (A ⧸ Ideal.span {π})) ^ q := by
  have hzero : MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
      (f - (MvPowerSeries.X 0 : MvPowerSeries (Fin 1) A) ^ q) = 0 := by
    rw [map_mk_eq_zero_iff]
    intro s
    rw [map_sub, coeff_eq_coeffX s f,
      coeff_eq_coeffX s ((MvPowerSeries.X 0 : MvPowerSeries (Fin 1) A) ^ q), coeffX_X_pow]
    by_cases hk : s 0 = q
    · rw [if_pos hk]
      simpa [hk] using hf.coeff_congr q
    · rw [if_neg hk, sub_zero]
      have h := hf.coeff_congr (s 0)
      rw [if_neg hk] at h
      simpa using h
  rw [map_sub, map_pow, map_X] at hzero
  exact sub_eq_zero.mp hzero

/-- **The image of `g(Xᵢ)` in the residue ring is `Xᵢ^q`.** -/
theorem map_mk_gSub {π : A} {q n : ℕ} {g : MvPowerSeries (Fin 1) A}
    (hg : IsLubinTateSeries π q g) (i : Fin n) :
    MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
        (LubinTate.gSub n g i) =
      (MvPowerSeries.X i : MvPowerSeries (Fin n) (A ⧸ Ideal.span {π})) ^ q := by
  have hsub : MvPowerSeries.HasSubst
      (![MvPowerSeries.X i] : Fin 1 → MvPowerSeries (Fin n) A) :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero
      (a := (![MvPowerSeries.X i] : Fin 1 → MvPowerSeries (Fin n) A)) (fun j => by
        rw [Matrix.cons_val_fin_one]
        exact MvPowerSeries.constantCoeff_X i)
  have hmap := MvPowerSeries.map_subst
    (a := (![MvPowerSeries.X i] : Fin 1 → MvPowerSeries (Fin n) A)) hsub
    (h := Ideal.Quotient.mk (Ideal.span {π})) (f := g)
  rw [LubinTate.gSub, hmap, map_mk_isLubinTateSeries hg]
  have hfam : (fun j : Fin 1 => MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
        ((![MvPowerSeries.X i] : Fin 1 → MvPowerSeries (Fin n) A) j)) =
      (fun _ : Fin 1 =>
        (MvPowerSeries.X i : MvPowerSeries (Fin n) (A ⧸ Ideal.span {π}))) := by
    funext j
    rw [Matrix.cons_val_fin_one]
    simp
  rw [hfam]
  have hsub2 : MvPowerSeries.HasSubst
      (fun _ : Fin 1 =>
        (MvPowerSeries.X i : MvPowerSeries (Fin n) (A ⧸ Ideal.span {π}))) :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero (fun _ => by
      show MvPowerSeries.constantCoeff
        ((fun _ : Fin 1 => (MvPowerSeries.X i : MvPowerSeries (Fin n) (A ⧸ Ideal.span {π}))) 0) = 0
      simpa using MvPowerSeries.constantCoeff_X (σ := Fin n) (R := A ⧸ Ideal.span {π}) i)
  rw [MvPowerSeries.subst_pow hsub2, MvPowerSeries.subst_X hsub2]

/-- The substitution `Xᵢ ↦ Xᵢ^q` is the algebra homomorphism `MvPowerSeries.expand q`. -/
theorem subst_X_pow_eq_expand {σ : Type v} {R : Type u} [CommRing R] {q : ℕ} (hq0 : q ≠ 0)
    (ψ : MvPowerSeries σ R) :
    MvPowerSeries.subst (fun i => (MvPowerSeries.X i : MvPowerSeries σ R) ^ q) ψ =
      MvPowerSeries.expand q hq0 ψ := by
  rw [MvPowerSeries.expand, MvPowerSeries.substAlgHom_apply]

/-- **The freshman's dream in the residue ring**: the substitution `Xᵢ ↦ Xᵢ^q` is the `q`-th power
map, because `q` is a power of the residue characteristic and `z^q = z` in the residue ring. -/
theorem subst_X_pow_eq_pow {σ : Type v} {R : Type u} [CommRing R] {p q k : ℕ} (hp : p.Prime)
    [CharP R p] (hq : q = p ^ k) (hres : ∀ z : R, z ^ q = z) (ψ : MvPowerSeries σ R) :
    MvPowerSeries.subst (fun i => (MvPowerSeries.X i : MvPowerSeries σ R) ^ q) ψ = ψ ^ q := by
  haveI : ExpChar R p := ExpChar.prime hp
  have hp0 : p ≠ 0 := hp.ne_zero
  have hpow0 : p ^ k ≠ 0 := pow_ne_zero k hp0
  have hid : iterateFrobenius R p k = RingHom.id R := by
    ext z
    rw [iterateFrobenius_def, RingHom.id_apply, ← hq]
    exact hres z
  have hmain : MvPowerSeries.expand (p ^ k) hpow0 ψ = ψ ^ (p ^ k) := by
    have h := MvPowerSeries.map_iterateFrobenius_expand (R := R) p hp0 ψ k
    rw [hid] at h
    simpa only [MvPowerSeries.map_id, RingHom.id_apply] using h
  rw [hq, subst_X_pow_eq_expand hpow0 ψ]
  exact hmain

theorem coeff_Dsub_mem_span {A : Type u} [CommRing A] {π : A} {q n : ℕ}
    (hπ : NK.LocalReciprocityLubinTate.IsLubinTateCoeff π q)
    (hpow : NK.LocalReciprocityLubinTate.IsFrobeniusPower π q)
    {f g : MvPowerSeries (Fin 1) A}
    (hf : NK.LocalReciprocityLubinTate.IsLubinTateSeries π q f)
    (hg : NK.LocalReciprocityLubinTate.IsLubinTateSeries π q g)
    {φ : MvPowerSeries (Fin n) A} (hφ : φ.constantCoeff = 0) (s : Fin n →₀ ℕ) :
    MvPowerSeries.coeff s (NK.LocalReciprocityLubinTate.LubinTate.Dsub n f g φ) ∈
      Ideal.span {π} := by
  classical
  obtain ⟨p, hpprime, hchar, k, hqk⟩ := hpow
  haveI : CharP (A ⧸ Ideal.span {π}) p := hchar
  have hres : ∀ z : A ⧸ Ideal.span {π}, z ^ q = z := hπ.2.1
  have hsubPhi : MvPowerSeries.HasSubst (![φ] : Fin 1 → MvPowerSeries (Fin n) A) :=
    MvPowerSeries.hasSubst_of_constantCoeff_zero
      (a := (![φ] : Fin 1 → MvPowerSeries (Fin n) A)) (fun j => by
        rw [Matrix.cons_val_fin_one]
        exact hφ)
  have hsubg : MvPowerSeries.HasSubst (LubinTate.gSub n g) := by
    refine MvPowerSeries.hasSubst_of_constantCoeff_zero (fun i => ?_)
    rw [LubinTate.gSub]
    exact MvPowerSeries.constantCoeff_subst_eq_zero
      (MvPowerSeries.hasSubst_of_constantCoeff_zero
        (a := (![MvPowerSeries.X i] : Fin 1 → MvPowerSeries (Fin n) A)) (fun j => by
          rw [Matrix.cons_val_fin_one]
          exact MvPowerSeries.constantCoeff_X i))
      (fun j => by
        rw [Matrix.cons_val_fin_one]
        exact MvPowerSeries.constantCoeff_X i)
      hg.constantCoeff
  have hterm1 : MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
        (MvPowerSeries.subst (![φ] : Fin 1 → MvPowerSeries (Fin n) A) f) =
      (MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) φ) ^ q := by
    have h1 := MvPowerSeries.map_subst (a := (![φ] : Fin 1 → MvPowerSeries (Fin n) A)) hsubPhi
      (h := Ideal.Quotient.mk (Ideal.span {π})) (f := f)
    rw [h1]
    have hfam1 : (fun j : Fin 1 => MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
          ((![φ] : Fin 1 → MvPowerSeries (Fin n) A) j)) =
        (fun _ : Fin 1 => MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) φ) := by
      funext j
      rw [Matrix.cons_val_fin_one]
    rw [hfam1, map_mk_isLubinTateSeries hf]
    have hsubψ : MvPowerSeries.HasSubst
        (fun _ : Fin 1 => MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) φ) :=
      MvPowerSeries.hasSubst_of_constantCoeff_zero (fun _ => by
        rw [MvPowerSeries.constantCoeff_map, hφ, map_zero])
    rw [MvPowerSeries.subst_pow hsubψ, MvPowerSeries.subst_X hsubψ]
  have hterm2 : MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
        (MvPowerSeries.subst (LubinTate.gSub n g) φ) =
      (MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) φ) ^ q := by
    have h2 := MvPowerSeries.map_subst (a := LubinTate.gSub n g) hsubg
      (h := Ideal.Quotient.mk (Ideal.span {π})) (f := φ)
    rw [h2]
    have hfam2 : (fun i : Fin n =>
          MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) (LubinTate.gSub n g i)) =
        (fun i : Fin n =>
          (MvPowerSeries.X i : MvPowerSeries (Fin n) (A ⧸ Ideal.span {π})) ^ q) :=
      funext fun i => map_mk_gSub hg i
    rw [hfam2]
    exact subst_X_pow_eq_pow hpprime hqk hres
      (MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π})) φ)
  have hD : MvPowerSeries.map (Ideal.Quotient.mk (Ideal.span {π}))
      (LubinTate.Dsub n f g φ) = 0 := by
    rw [LubinTate.Dsub, map_sub, sub_eq_zero]
    exact hterm1.trans hterm2.symm
  exact (map_mk_eq_zero_iff.mp hD) s

end NK.LocalReciprocityLubinTate.ModPi
