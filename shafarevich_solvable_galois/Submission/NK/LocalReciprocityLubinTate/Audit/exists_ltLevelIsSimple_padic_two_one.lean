/-!
# The level-simplicity hypothesis at `q = 2`, `n = 1`, over `ℚ_[2]`

`NK.LocalReciprocityLubinTate.LTLevelIsSimple F π q n` asks that every division point of level `n`
lies in the field generated by any single *primitive* one.  It is the structural consequence of
Milne's theorem that `Λ_n` is a free `𝒪[F]/π^n`-module of rank one.

The case `q = 2`, `n = 1` is *elementary*: the `π`-division points are the roots of
`f(T) = πT + T^2`, i.e. `Λ_1 = {0} ∪ {roots of X + π} = {0, -π}`, a set with two elements.  Hence
for a primitive point `y ∈ Λ_1 ∖ Λ_0` one has `y = -π`, so `π = -y` and both elements `0`, `-π = y`
of `Λ_1` lie in `F(y)`.  In particular

`LTdivisionSet ℚ_[2] π 2 1 ⊆ ↑(adjoin ℚ_[2] {y})`,

which is exactly `LTLevelIsSimple ℚ_[2] π 2 1`.

This is the `n = 1`, `q = 2` instance demanded by the audit of the chapter: together with
`Audit.exists_irreducible_padic` it exhibits a *non-vacuous* witness of the level-simplicity
hypothesis over `ℚ_[2]`.

## Main results

* `NK.LocalReciprocityLubinTate.Audit.LTdivisionSet_two_one_eq` — `Λ_1 = {0, -π}` for `q = 2`;
* `NK.LocalReciprocityLubinTate.Audit.exists_ltLevelIsSimple_padic_two_one`.
-/

open Polynomial

namespace NK.LocalReciprocityLubinTate.Audit

/-- **The `π`-division points for `q = 2`**: for the standard Lubin–Tate polynomial
`f(T) = πT + T^2` the set `Λ_1` of `π`-division points is `{0, -π}`.  Indeed
`Λ_1 = Λ_0 ∪ (roots of f^{[0]}) = {0} ∪ (roots of X + π)`. -/
lemma LTdivisionSet_two_one_eq (F : Type*) [Field F] (c : F) :
    NK.LocalReciprocityLubinTate.LTdivisionSet F c 2 1
      = {0, -algebraMap F (AlgebraicClosure F) c} := by
  rw [show (1 : ℕ) = 0 + 1 from rfl,
    NK.LocalReciprocityLubinTate.LTdivisionSet_succ_eq_union F c 2 0 (by norm_num),
    NK.LocalReciprocityLubinTate.LTdivisionSet_zero F c 2]
  have heis : NK.LocalReciprocityLubinTate.LTpolyEis c 2 0 = Polynomial.X + Polynomial.C c := by
    simp [NK.LocalReciprocityLubinTate.LTpolyEis, NK.LocalReciprocityLubinTate.LTpolyIter_zero]
  rw [heis]
  ext x
  rw [Set.mem_union, Set.mem_singleton_iff, Set.mem_insert_iff, Set.mem_singleton_iff,
    Polynomial.mem_rootSet_of_ne (Polynomial.monic_X_add_C c).ne_zero, Polynomial.aeval_add,
    Polynomial.aeval_X, Polynomial.aeval_C, add_eq_zero_iff_eq_neg]

/-- **Audit, `p = 2`, `q = 2`, `n = 1`**: there is an irreducible element `π` of the ring of
integers of `ℚ_[2]` (namely the uniformiser `2`) for which the level `Λ_1` of the Lubin–Tate
group of `f(T) = πT + T^2` is generated by any single primitive division point.

`Λ_1 = {0, -π}` has two elements, so the only primitive point is `y = -π`; then `π = -y` and hence
both `0` and `-π = y` lie in `ℚ_[2](y)`. -/
theorem exists_ltLevelIsSimple_padic_two_one :
    ∃ π : ↥(ValuativeRel.valuation ℚ_[2]).integer, Irreducible π ∧
      NK.LocalReciprocityLubinTate.LTLevelIsSimple ℚ_[2] (π : ℚ_[2]) 2 1 := by
  obtain ⟨π, hπ, -⟩ := exists_irreducible_padic 2
  refine ⟨π, hπ, ?_⟩
  rw [NK.LocalReciprocityLubinTate.LTLevelIsSimple]
  intro y hy hy0
  have hΛ := LTdivisionSet_two_one_eq ℚ_[2] (π : ℚ_[2])
  have hΛ0 : NK.LocalReciprocityLubinTate.LTdivisionSet ℚ_[2] (π : ℚ_[2]) 2 0 = {0} :=
    NK.LocalReciprocityLubinTate.LTdivisionSet_zero ℚ_[2] (π : ℚ_[2]) 2
  have hyne : y ≠ 0 := by
    intro h
    exact hy0 (by rw [hΛ0]; exact h)
  have hyval : y = -algebraMap ℚ_[2] (AlgebraicClosure ℚ_[2]) (π : ℚ_[2]) := by
    rw [hΛ] at hy
    rcases hy with h | h
    · exact absurd h hyne
    · exact h
  intro z hz
  rw [hΛ] at hz
  rcases hz with hz | hz
  · rw [hz]
    exact IntermediateField.zero_mem _
  · rw [hz, ← hyval]
    exact IntermediateField.subset_adjoin ℚ_[2] ({y} : Set (AlgebraicClosure ℚ_[2]))
      (Set.mem_singleton y)

end NK.LocalReciprocityLubinTate.Audit
