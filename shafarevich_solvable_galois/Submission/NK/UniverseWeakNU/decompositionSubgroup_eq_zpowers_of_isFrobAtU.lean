# The decomposition group of an unramified prime is generated by its Frobenius
(at an arbitrary universe)

Universe-polymorphic copy of `Submission/Work/WeakNU/decompositionSubgroup_eq_zpowers_of_isFrobAt.lean`.

Let `N/ℚ` be a finite Galois extension of number fields (`N : Type u`), `P` a prime of `𝓞 N`
which is unramified over `ℚ`, and `σ` a Frobenius element at `P`.  Then the decomposition group
of `P` is the cyclic subgroup generated by `σ`:

`decompositionSubgroup P = Subgroup.zpowers σ`.

The proof is the classical comparison of cardinalities.  A Frobenius element fixes its own prime
(`NK.Chebotarev.IsFrobAtStabilizes`), so `⟨σ⟩ ≤ D_P`; the order of the decomposition group is
`e(P|p) · f(P|p)` (`Submission.NeukirchUchida.Local.card_decompositionSubgroup`) with `e = 1` by
hypothesis, while the order of a Frobenius is the inertia degree
(`NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg`).  Two subgroups of the same finite cardinality,
one contained in the other, are equal.
-/

import Mathlib
import Submission.NK.UniverseWeakNU.PrimeOrbitU
import Submission.NK.UniverseWeakNU.Defs
import Submission.NK.Chebotarev.IsFrobAtStabilizes
import Submission.NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg
import Submission.NeukirchUchida.Local.LocalGalois
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

set_option linter.style.haveILetI false

namespace NK.UniverseWeakNU

universe u

/-- **The decomposition group of an unramified prime is generated by its Frobenius.** -/
theorem decompositionSubgroup_eq_zpowers_of_isFrobAtU {N : Type u} [Field N] [NumberField N] [Algebra ℚ N] [IsGalois ℚ N] (P : NK.Chebotarev.PrimeIdeal N) (σ : Gal(N/ℚ)) (hram : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers ℚ) = 1) (hfrob : NK.Chebotarev.IsFrobAt P σ) : Submission.NeukirchUchida.Local.decompositionSubgroup (K := ℚ) P = Subgroup.zpowers σ := by
  -- the prime `p` of `ℚ` below `P`
  have hlies : P.asIdeal.LiesOver (P.under (NumberField.RingOfIntegers ℚ)).asIdeal := by
    rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
    exact ⟨rfl⟩
  -- a Frobenius at `P` fixes `P`, so it lies in the decomposition group
  have hmem : σ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := ℚ) P := by
    rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup]
    exact IsDedekindDomain.HeightOneSpectrum.ext (by
      rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
      exact NK.Chebotarev.IsFrobAtStabilizes hfrob)
  -- the decomposition group has `e · f = f` elements
  have hcard : Nat.card ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := ℚ) P)
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers ℚ) := by
    rw [Submission.NeukirchUchida.Local.card_decompositionSubgroup (K := ℚ) (L := N)
      (P.under (NumberField.RingOfIntegers ℚ)) P hlies]
    letI : MulSemiringAction Gal(N/ℚ) (NumberField.RingOfIntegers N) :=
      IsIntegralClosure.MulSemiringAction (NumberField.RingOfIntegers ℚ) ℚ N
        (NumberField.RingOfIntegers N)
    haveI hGal : IsGaloisGroup Gal(N/ℚ) (NumberField.RingOfIntegers ℚ)
        (NumberField.RingOfIntegers N) :=
      IsGaloisGroup.of_isFractionRing Gal(N/ℚ) (NumberField.RingOfIntegers ℚ)
        (NumberField.RingOfIntegers N) ℚ N
    haveI := hlies
    rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := NumberField.RingOfIntegers ℚ)
          (B := NumberField.RingOfIntegers N)
          (P.under (NumberField.RingOfIntegers ℚ)).asIdeal P.asIdeal (Gal(N/ℚ)),
        Ideal.inertiaDegIn_eq_inertiaDeg (A := NumberField.RingOfIntegers ℚ)
          (B := NumberField.RingOfIntegers N)
          (P.under (NumberField.RingOfIntegers ℚ)).asIdeal P.asIdeal (Gal(N/ℚ)), hram, one_mul]
  -- the cyclic group generated by `σ` has `orderOf σ = f` elements
  have hcardzp : Nat.card ↥(Subgroup.zpowers σ)
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers ℚ) := by
    rw [Nat.card_zpowers]
    exact NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg hlies hram hfrob
  exact (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hmem)
    (by rw [hcard, hcardzp])).symm

end NK.UniverseWeakNU
