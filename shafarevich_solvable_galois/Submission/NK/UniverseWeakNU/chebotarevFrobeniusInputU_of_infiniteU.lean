namespace NK.UniverseWeakNU

noncomputable section

universe u

open NK.Chebotarev
open NK.ChebotarevGeneral

/-- **`LiesOver` the rational prime attached to a finite place of `ℚ`, at an arbitrary universe.**

For `N : Type u`, a finite place `𝔭` of `ℚ` and a prime `P` of `𝓞 N`, lying over the principal
ideal generated by the rational prime `ratPrimeOf 𝔭` is the same as lying over the ideal of `𝔭`
itself.  Universe-polymorphic form of `NK.ChebotarevGeneral.liesOver_span_ratPrimeOf_iff`. -/
theorem liesOver_span_ratPrimeOf_iffU {N : Type u} [Field N] [NumberField N] [Algebra ℚ N]
    (𝔭 : PrimeIdeal ℚ) (P : PrimeIdeal N) :
    P.asIdeal.LiesOver (Ideal.span {((ratPrimeOf 𝔭 : ℕ) : ℤ)}) ↔
      P.asIdeal.LiesOver 𝔭.asIdeal := by
  rw [ideal_span_ratPrimeOf 𝔭, Ideal.under_def]
  exact (NK.WeakNU.liesOver_iff_liesOver_comap_of_surjective
    (A := ℤ) (B := NumberField.RingOfIntegers ℚ) (C := NumberField.RingOfIntegers N)
    (Rat.int_algebraMap_surjective (NumberField.RingOfIntegers ℚ)) P.asIdeal 𝔭.asIdeal).symm

theorem chebotarevFrobeniusInputU_of_infiniteU (h : ChebotarevInfiniteU.{u}) :
    ChebotarevFrobeniusInputU.{u} := by
  classical
  intro N _ _ _ _ σ T
  -- Čebotarev's theorem in existence form at the base field `ℚ`
  have hinf : (frobSet (K := ℚ) (N := N) σ).Infinite := h ℚ N σ
  -- discard the finitely many ramified primes
  have hinf' : (frobSet (K := ℚ) (N := N) σ ∩
      {𝔭 | IsUnramifiedAt (K := ℚ) (N := N) 𝔭}).Infinite := by
    have h' := hinf.sdiff (finite_setOf_not_isUnramified (K := ℚ) (N := N))
    convert h' using 1
    ext 𝔭
    simp only [Set.mem_sdiff, Set.mem_ofPred_eq, Set.mem_inter_iff, not_not]
  -- pass to rational primes
  have hPinf : (ratPrimeOf '' (frobSet (K := ℚ) (N := N) σ ∩
      {𝔭 | IsUnramifiedAt (K := ℚ) (N := N) 𝔭})).Infinite :=
    Set.Infinite.image (fun _ _ _ _ hxy => ratPrimeOf_injective hxy) hinf'
  have hnotT : ∃ 𝔭 ∈ (frobSet (K := ℚ) (N := N) σ ∩
      {𝔭 | IsUnramifiedAt (K := ℚ) (N := N) 𝔭}), ratPrimeOf 𝔭 ∉ (T : Set ℕ) := by
    obtain ⟨q, hqimg, hqT⟩ := (hPinf.sdiff T.finite_toSet).nonempty
    obtain ⟨𝔮, h𝔮mem, h𝔮q⟩ := hqimg
    exact ⟨𝔮, h𝔮mem, by rwa [← h𝔮q] at hqT⟩
  obtain ⟨𝔭, h𝔭mem, h𝔭T⟩ := hnotT
  refine ⟨ratPrimeOf 𝔭, ratPrimeOf_prime 𝔭, h𝔭T, ?_, ?_⟩
  · intro P hP
    exact h𝔭mem.2 P ((liesOver_span_ratPrimeOf_iffU 𝔭 P).mp hP)
  · obtain ⟨P, hP, hσ⟩ := h𝔭mem.1
    exact ⟨P, (liesOver_span_ratPrimeOf_iffU 𝔭 P).mpr hP, hσ⟩

end

end NK.UniverseWeakNU
