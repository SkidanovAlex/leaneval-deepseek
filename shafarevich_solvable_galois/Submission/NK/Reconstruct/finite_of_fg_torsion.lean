open scoped BigOperators

namespace NK.Reconstruct

/-- A finitely generated module over the `ℓ`-adic integers `ℤ_[ℓ]` in which every element is
annihilated by some power of `ℓ` is finite.

Indeed, an exponent `ℓ ^ N` then kills each element of a finite generating set, hence all of `M`,
so `M` is a quotient of `(ℤ_[ℓ] ⧸ (ℓ ^ N)) ^ k`, and the quotient ring `ℤ_[ℓ] ⧸ (ℓ ^ N)` is the
finite ring `ZMod (ℓ ^ N)`. -/
theorem finite_of_fg_torsion {ℓ : ℕ} [Fact ℓ.Prime] {M : Type*} [AddCommGroup M]
    [Module (PadicInt ℓ) M] [Module.Finite (PadicInt ℓ) M]
    (h : ∀ x : M, ∃ n : ℕ, (ℓ : PadicInt ℓ) ^ n • x = 0) : Finite M := by
  classical
  obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := PadicInt ℓ) (M := M)
  -- `N` is an exponent annihilating every generator.
  set N : ℕ := ∑ i : Fin k, (h (g i)).choose with hNdef
  have hNle : ∀ i : Fin k, (h (g i)).choose ≤ N := by
    intro i
    have hh := Finset.single_le_sum (s := (Finset.univ : Finset (Fin k)))
      (f := fun j : Fin k => (h (g j)).choose) (fun j _ => Nat.zero_le _) (Finset.mem_univ i)
    rw [hNdef]
    simpa using hh
  have hkill : ∀ i : Fin k, (ℓ : PadicInt ℓ) ^ N • g i = 0 := by
    intro i
    have hle := hNle i
    have hpow : (ℓ : PadicInt ℓ) ^ N
        = (ℓ : PadicInt ℓ) ^ (h (g i)).choose
          * (ℓ : PadicInt ℓ) ^ (N - (h (g i)).choose) := by
      rw [← pow_add, Nat.add_sub_of_le hle]
    rw [hpow, mul_comm, mul_smul, (h (g i)).choose_spec, smul_zero]
  -- The ideal generated by `ℓ ^ N` acts trivially on every generator, hence on all of `M`.
  set I : Ideal (PadicInt ℓ) := Ideal.span {((ℓ : PadicInt ℓ)) ^ N} with hIdef
  have hmem_kill : ∀ (r : PadicInt ℓ), r ∈ I → ∀ i : Fin k, r • g i = 0 := by
    intro r hr i
    rw [hIdef] at hr
    rw [Ideal.mem_span_singleton] at hr
    obtain ⟨c, rfl⟩ := hr
    rw [mul_comm, mul_smul, hkill i, smul_zero]
  -- A surjection `(ℤ_[ℓ] ⧸ I)^k → M`, built from a section of the quotient map.
  let sec : (PadicInt ℓ ⧸ I) → PadicInt ℓ :=
    fun a => Classical.choose (Ideal.Quotient.mk_surjective a)
  have hsec : ∀ a, Ideal.Quotient.mk I (sec a) = a :=
    fun a => Classical.choose_spec (Ideal.Quotient.mk_surjective a)
  let ψ : (Fin k → (PadicInt ℓ ⧸ I)) → M := fun f => ∑ i, sec (f i) • g i
  have hsurj : Function.Surjective ψ := by
    intro m
    have hm : m ∈ Submodule.span (PadicInt ℓ) (Set.range g) := by
      rw [hg]; exact Submodule.mem_top
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (PadicInt ℓ)).mp hm
    refine ⟨fun i => Ideal.Quotient.mk I (c i), ?_⟩
    show ∑ i, sec (Ideal.Quotient.mk I (c i)) • g i = m
    rw [← hc]
    apply Finset.sum_congr rfl
    intro i _
    have hdiff : sec (Ideal.Quotient.mk I (c i)) - c i ∈ I := by
      rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, hsec, sub_self]
    have h0 : (sec (Ideal.Quotient.mk I (c i)) - c i) • g i = 0 := hmem_kill _ hdiff i
    rwa [sub_smul, sub_eq_zero] at h0
  -- The quotient ring `ℤ_[ℓ] ⧸ I` is finite: it is `ZMod (ℓ ^ N)`.
  have hsurj' : Function.Surjective (PadicInt.toZModPow (p := ℓ) N) := by
    intro y
    obtain ⟨m, hm⟩ := ZMod.intCast_surjective y
    exact ⟨(m : PadicInt ℓ), by rw [← hm]; exact map_intCast (PadicInt.toZModPow (p := ℓ) N) m⟩
  have hfin : Finite (PadicInt ℓ ⧸ I) := by
    have hker : I = RingHom.ker (PadicInt.toZModPow (p := ℓ) N) := by
      rw [hIdef, PadicInt.ker_toZModPow]
    let e : (PadicInt ℓ ⧸ I) ≃+* ZMod (ℓ ^ N) :=
      (Ideal.quotEquivOfEq hker).trans (RingHom.quotientKerEquivOfSurjective hsurj')
    exact Finite.of_injective e.toEquiv e.toEquiv.injective
  exact @Finite.of_surjective (Fin k → (PadicInt ℓ ⧸ I)) M
    (@Pi.finite (Fin k) (fun _ => (PadicInt ℓ ⧸ I)) inferInstance (fun _ => hfin)) ψ hsurj

end NK.Reconstruct
