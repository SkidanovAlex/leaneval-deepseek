/-!
# Auxiliary imaginary quadratic levels over a number field

For a number field `K` inside a separable closure `Ω` of `ℚ` and a finite level `L/K` which is
*totally real* (no complex infinite place), we produce two square roots `i` (`i ^ 2 = -1`) and
`y` (`y ^ 2 = -q`, `q` a prime, hence `q > 0`) inside `Ω` such that

* the two quadratic extensions `L(i)` and `L(y)` are linearly disjoint over `L`, i.e.
  `(L ⊔ K⟮i⟯) ⊓ (L ⊔ K⟮y⟯) = L` (`K⟮i⟯` being the field generated by `i` over `K`), and
* each of the fields `L ⊔ K⟮i⟯`, `L ⊔ K⟮y⟯` has a complex infinite place.

The construction is the standard one: since `L` is totally real, no `-m` with `m > 0` is a square
in `L`, and there is a prime `q` which is not a square in `L` (`NK.Reconstruct.exists_prime_not_sq`,
finiteness of the intermediate fields of `L/ℚ`).  Then `q` not a square forces `L(i) ≠ L(y)`, and a
real embedding of either field would send a square root of a negative rational to a real square
root of a negative number.

## Contents

* `NK.Reconstruct.exists_isComplex_of_sq_eq_neg_natCast` — a field embeddable in `ℂ` containing a
  square root of `-m`, `m > 0`, has a complex infinite place;
* `NK.Reconstruct.not_isSquare_neg_natCast_of_totallyReal` — in a totally real number field no
  `-m`, `m > 0`, is a square;
* `NK.Reconstruct.mem_sup_adjoin_sq_neg_one`, `NK.Reconstruct.mem_sup_adjoin_sq_neg_nat` — the
  elements of `L ⊔ F⟮i⟯` (resp. `L ⊔ F⟮y⟯`) are exactly `a + b * i` (resp. `a + b * y`) with
  `a, b ∈ L`;
* `NK.Reconstruct.inf_sup_adjoin_eq` — the disjointness, pure field theory;
* `NK.Reconstruct.exists_aux_imaginary_level` — the target.
-/

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.style.haveILetI false

namespace NK.Reconstruct

/-- A field which embeds into `ℂ` and contains an element `x` whose square is `-m`, `m > 0`, has a
complex infinite place: a real embedding would send `x` to a real square root of `-m`. -/
theorem exists_isComplex_of_sq_eq_neg_natCast {K : Type*} [Field K] (ψ : K →+* ℂ) {x : K} {m : ℕ}
    (hm : 0 < m) (hx : x ^ 2 = -(m : K)) :
    ∃ v : NumberField.InfinitePlace K, NumberField.InfinitePlace.IsComplex v := by
  refine ⟨NumberField.InfinitePlace.mk ψ, ?_⟩
  rw [NumberField.InfinitePlace.isComplex_mk_iff]
  intro hreal
  have hc : ((hreal.embedding x : ℝ) : ℂ) ^ 2 = -(m : ℂ) := by
    rw [show ((hreal.embedding x : ℝ) : ℂ) = ψ x by simp]
    rw [← map_pow, hx, map_neg, map_natCast]
  have h2 : ((hreal.embedding x : ℝ)) ^ 2 = -(m : ℝ) := by
    exact_mod_cast hc
  have hmR : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  nlinarith [sq_nonneg (hreal.embedding x)]

/-- In a totally real number field `K`, no element of `K` has square `-m` with `m > 0`. -/
theorem not_isSquare_neg_natCast_of_totallyReal {K : Type*} [Field K] [Algebra ℚ K] [NumberField K]
    (htr : ∀ v : NumberField.InfinitePlace K, ¬ NumberField.InfinitePlace.IsComplex v) :
    ∀ m : ℕ, 0 < m → ¬ IsSquare (-(m : K)) := by
  obtain ⟨v⟩ : Nonempty (NumberField.InfinitePlace K) := inferInstance
  have hv1 : NumberField.InfinitePlace.IsReal v :=
    NumberField.InfinitePlace.not_isComplex_iff_isReal.mp (htr v)
  have hv2 : NumberField.ComplexEmbedding.IsReal v.embedding :=
    NumberField.InfinitePlace.isReal_iff.mp hv1
  intro m hm hsq
  obtain ⟨a, ha⟩ := hsq
  have h1 : (hv2.embedding a) ^ 2 = -(m : ℝ) := by
    rw [← map_pow, show a ^ 2 = -(m : K) from by rw [pow_two]; exact ha.symm, map_neg, map_natCast]
  have hmR : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  nlinarith [sq_nonneg (hv2.embedding a)]

/-- **The elements of `L ⊔ F⟮i⟯` when `i ^ 2 = -1`, `i ∉ L`** are exactly `a + b * i` with
`a, b ∈ L`. -/
theorem mem_sup_adjoin_sq_neg_one {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (L : IntermediateField F Ω) {i : Ω} (hi : i ^ 2 = -1) (hiL : i ∉ (L : Set Ω)) :
    ∀ x : Ω, x ∈ (L ⊔ IntermediateField.adjoin F ({i} : Set Ω)) ↔
      ∃ a b : ↥L, x = (a : Ω) + (b : Ω) * i := by
  have hcast : ((L ⊔ IntermediateField.adjoin F ({i} : Set Ω) : IntermediateField F Ω) : Set Ω)
      = ((IntermediateField.adjoin ↥L ({i} : Set Ω) : IntermediateField ↥L Ω) : Set Ω) := by
    rw [← IntermediateField.restrictScalars_adjoin_eq_sup (F := F) L ({i} : Set Ω)]
    exact IntermediateField.coe_restrictScalars F
  have hwi : i ^ 2 = algebraMap ↥L Ω (-1) := by rw [map_neg, map_one]; exact hi
  have hiL' : ∀ c : ↥L, algebraMap ↥L Ω c ≠ i := fun c hc => hiL (by rw [← hc]; exact c.2)
  have hdesc := adjoin_sq_eq_set (F := ↥L) (K := Ω) (d := -1) (w := i) hwi hiL'
  intro x
  rw [← SetLike.mem_coe, hcast, hdesc, Set.mem_ofPred_eq]
  simp only [IntermediateField.algebraMap_apply]

/-- **The elements of `L ⊔ F⟮y⟯` when `y ^ 2 = -q`, `y ∉ L`** are exactly `a + b * y` with
`a, b ∈ L`. -/
theorem mem_sup_adjoin_sq_neg_nat {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω]
    (L : IntermediateField F Ω) {y : Ω} {q : ℕ} (hy : y ^ 2 = -(q : Ω))
    (hyL : y ∉ (L : Set Ω)) :
    ∀ x : Ω, x ∈ (L ⊔ IntermediateField.adjoin F ({y} : Set Ω)) ↔
      ∃ a b : ↥L, x = (a : Ω) + (b : Ω) * y := by
  have hcast : ((L ⊔ IntermediateField.adjoin F ({y} : Set Ω) : IntermediateField F Ω) : Set Ω)
      = ((IntermediateField.adjoin ↥L ({y} : Set Ω) : IntermediateField ↥L Ω) : Set Ω) := by
    rw [← IntermediateField.restrictScalars_adjoin_eq_sup (F := F) L ({y} : Set Ω)]
    exact IntermediateField.coe_restrictScalars F
  have hwy : y ^ 2 = algebraMap ↥L Ω (-(q : ↥L)) := by
    rw [map_neg, map_natCast]
    exact hy
  have hyL' : ∀ c : ↥L, algebraMap ↥L Ω c ≠ y := fun c hc => hyL (by rw [← hc]; exact c.2)
  have hdesc := adjoin_sq_eq_set (F := ↥L) (K := Ω) (d := -(q : ↥L)) (w := y) hwy hyL'
  intro x
  rw [← SetLike.mem_coe, hcast, hdesc, Set.mem_ofPred_eq]
  simp only [IntermediateField.algebraMap_apply]

/-- **`L(i) ∩ L(y) = L`**: if `i ^ 2 = -1`, `y ^ 2 = -q`, `i, y ∉ L` and `q` is not a square in `L`,
then the two quadratic extensions `L ⊔ F⟮i⟯` and `L ⊔ F⟮y⟯` of `L` meet exactly in `L`. -/
theorem inf_sup_adjoin_eq {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω] [NeZero (2 : Ω)]
    (L : IntermediateField F Ω) {i y : Ω} {q : ℕ}
    (hi : i ^ 2 = -1) (hy : y ^ 2 = -(q : Ω))
    (hiL : i ∉ (L : Set Ω)) (hyL : y ∉ (L : Set Ω))
    (hqnsq : ¬ IsSquare (q : ↥L)) :
    (L ⊔ IntermediateField.adjoin F ({i} : Set Ω)) ⊓
      (L ⊔ IntermediateField.adjoin F ({y} : Set Ω)) = L := by
  have hSi := mem_sup_adjoin_sq_neg_one (F := F) (Ω := Ω) L hi hiL
  have hSy := mem_sup_adjoin_sq_neg_nat (F := F) (Ω := Ω) L hy hyL
  apply SetLike.ext
  intro x
  rw [IntermediateField.mem_inf]
  constructor
  · rintro ⟨hxi, hxy⟩
    rw [hSi x] at hxi
    rw [hSy x] at hxy
    obtain ⟨a, b, hab⟩ := hxi
    obtain ⟨a', b', hab'⟩ := hxy
    by_cases hb : b = 0
    · have hab'' : x = (a : Ω) := by rw [hab]; simp [hb]
      simpa [hab''] using a.2
    · exfalso
      have hb0 : (b : Ω) ≠ 0 := fun h => hb ((algebraMap ↥L Ω).injective (by
        show algebraMap ↥L Ω b = algebraMap ↥L Ω 0
        rw [map_zero]
        exact h))
      have h1 : x - (a : Ω) = (b : Ω) * i := by rw [hab]; ring
      have h2 : x - (a' : Ω) = (b' : Ω) * y := by rw [hab']; ring
      have e1 : (x - (a : Ω)) ^ 2 = -((b : Ω) ^ 2) := by rw [h1, mul_pow, hi]; ring
      have e2 : (x - (a' : Ω)) ^ 2 = -((b' : Ω) ^ 2 * (q : Ω)) := by rw [h2, mul_pow, hy]; ring
      have key : (2 * x - (a : Ω) - (a' : Ω)) * ((a' : Ω) - (a : Ω))
          = (b' : Ω) ^ 2 * (q : Ω) - (b : Ω) ^ 2 := by
        calc (2 * x - (a : Ω) - (a' : Ω)) * ((a' : Ω) - (a : Ω))
            = (x - (a : Ω)) ^ 2 - (x - (a' : Ω)) ^ 2 := by ring
          _ = -((b : Ω) ^ 2) - (-((b' : Ω) ^ 2 * (q : Ω))) := by rw [e1, e2]
          _ = (b' : Ω) ^ 2 * (q : Ω) - (b : Ω) ^ 2 := by ring
      by_cases haa : a' = a
      · rw [haa, sub_self, mul_zero] at key
        have hz : (b' : Ω) ^ 2 * (q : Ω) - (b : Ω) ^ 2 = 0 := by rw [← key]
        have hl : (b : Ω) ^ 2 = (b' : Ω) ^ 2 * (q : Ω) := (sub_eq_zero.mp hz).symm
        have hlift : (b : ↥L) ^ 2 = (b' : ↥L) ^ 2 * (q : ↥L) := by
          apply (algebraMap ↥L Ω).injective
          simpa only [map_mul, map_pow, map_natCast, IntermediateField.algebraMap_apply] using hl
        have hb'ne : b' ≠ 0 := by
          intro h0
          have hb2 : (b : ↥L) ^ 2 = 0 := by rw [hlift, h0]; ring
          exact hb (sq_eq_zero_iff.mp hb2)
        have hb'2 : (b' : ↥L) ^ 2 ≠ 0 := pow_ne_zero 2 hb'ne
        have hstep1 : (q : ↥L) = (b : ↥L) ^ 2 * ((b' : ↥L) ^ 2)⁻¹ := by
          rw [hlift, mul_comm ((b' : ↥L) ^ 2) (q : ↥L), mul_assoc, mul_inv_cancel₀ hb'2, mul_one]
        have hstep2 : (b : ↥L) ^ 2 * ((b' : ↥L) ^ 2)⁻¹ = ((b : ↥L) * (b' : ↥L)⁻¹) ^ 2 := by
          rw [← inv_pow, ← mul_pow]
        exact hqnsq ⟨(b : ↥L) * (b' : ↥L)⁻¹, by rw [← pow_two, ← hstep2, ← hstep1]⟩
      · have hne : (a' : Ω) - (a : Ω) ≠ 0 := by
          intro h
          refine haa ((algebraMap ↥L Ω).injective ?_)
          show algebraMap ↥L Ω a' = algebraMap ↥L Ω a
          rw [← sub_eq_zero]
          exact h
        have hdiv : 2 * x - (a : Ω) - (a' : Ω)
            = ((b' : Ω) ^ 2 * (q : Ω) - (b : Ω) ^ 2) / ((a' : Ω) - (a : Ω)) := by
          rw [eq_div_iff hne]
          exact key
        have h2x : 2 * x = (a : Ω) + (a' : Ω)
            + ((b' : Ω) ^ 2 * (q : Ω) - (b : Ω) ^ 2) / ((a' : Ω) - (a : Ω)) := by
          rw [← hdiv]; ring
        have hx2 : 2 * x ∈ (L : Set Ω) := by
          rw [h2x]
          show (((a + a' + ((b' : ↥L) ^ 2 * (q : ↥L) - (b : ↥L) ^ 2) / (a' - a) : ↥L)) : Ω)
            ∈ (L : Set Ω)
          exact (a + a' + ((b' : ↥L) ^ 2 * (q : ↥L) - (b : ↥L) ^ 2) / (a' - a)).2
        have h2mem : (2 : Ω) ∈ (L : Set Ω) := by
          have h := L.algebraMap_mem (2 : F)
          simpa using h
        have hxm : x ∈ (L : Set Ω) := by
          have hdiv' := L.div_mem hx2 h2mem
          rwa [mul_div_cancel_left₀ x (NeZero.out : (2 : Ω) ≠ 0)] at hdiv'
        refine hiL ?_
        have hi' : i = (x - (a : Ω)) / (b : Ω) := by
          rw [h1, mul_div_cancel_left₀ i hb0]
        rw [hi']
        exact L.div_mem (L.sub_mem hxm a.2) b.2
  · intro hx
    refine ⟨?_, ?_⟩
    · rw [hSi x]; exact ⟨⟨x, hx⟩, 0, by simp⟩
    · rw [hSy x]; exact ⟨⟨x, hx⟩, 0, by simp⟩

/-- **Auxiliary imaginary quadratic levels over a totally real number field.**

For a number field `K ⊆ Ω` and a finite totally real level `L/K`, there are `i, y ∈ Ω` and a prime
`q` with `i ^ 2 = -1`, `y ^ 2 = -q`, such that `L(i)` and `L(y)` are linearly disjoint over `L`
and each has a complex infinite place. -/
theorem exists_aux_imaginary_level {Ω : Type*} [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω]
    [IsSepClosure ℚ Ω] (K : NK.Reconstruct.NumFieldIn ℚ Ω)
    (L : IntermediateField ↥K.L Ω) [FiniteDimensional ↥K.L L] [NumberField ↥L]
    (htr : ∀ v : NumberField.InfinitePlace ↥L, ¬ NumberField.InfinitePlace.IsComplex v) :
    ∃ (i y : Ω) (q : ℕ), i ^ 2 = -1 ∧ y ^ 2 = -(q : Ω) ∧ 0 < q ∧
      ((L ⊔ IntermediateField.adjoin ↥K.L {i}) ⊓
        (L ⊔ IntermediateField.adjoin ↥K.L {y}) = L) ∧
      (∃ v : NumberField.InfinitePlace ↥(L ⊔ IntermediateField.adjoin ↥K.L {i}),
        NumberField.InfinitePlace.IsComplex v) ∧
      (∃ v : NumberField.InfinitePlace ↥(L ⊔ IntermediateField.adjoin ↥K.L {y}),
        NumberField.InfinitePlace.IsComplex v) := by
  haveI hchar : CharZero Ω := Algebra.charZero_of_charZero ℚ Ω
  haveI hFfin : FiniteDimensional ℚ ↥K.L := K.finite
  -- a prime which is not a square in `L`, viewed as a field over `ℚ`
  let Lq : IntermediateField ℚ Ω := IntermediateField.restrictScalars ℚ L
  haveI hLq : FiniteDimensional ℚ ↥Lq := FiniteDimensional.trans ℚ ↥K.L ↥L
  obtain ⟨q, hqprime, hqnsq⟩ := exists_prime_not_sq Lq
  have hqnsq0 : ¬ ∃ x : ↥L, x ^ 2 = (q : ↥L) := hqnsq
  have hqnsq' : ¬ IsSquare (q : ↥L) := by
    rintro ⟨r, hr⟩
    exact hqnsq0 ⟨r, by rw [hr, pow_two]⟩
  have hqpos : 0 < q := hqprime.pos
  haveI hsc : IsSepClosed Ω := IsSepClosure.sep_closed ℚ
  -- square roots of `-1` and of `-q`
  obtain ⟨i, hi⟩ : ∃ i : Ω, i ^ 2 = -1 := by
    obtain ⟨j, hj⟩ := IsSepClosed.exists_eq_mul_self (-1 : Ω)
    exact ⟨j, by rw [pow_two, hj]⟩
  obtain ⟨y, hy⟩ : ∃ y : Ω, y ^ 2 = -(q : Ω) := by
    obtain ⟨j, hj⟩ := IsSepClosed.exists_eq_mul_self (-(q : Ω))
    exact ⟨j, by rw [pow_two, hj]⟩
  -- `L` being totally real, neither `i` nor `y` lies in `L`
  have hiL : i ∉ (L : Set Ω) := by
    intro himem
    have hsq : (⟨i, himem⟩ : ↥L) ^ 2 = -(1 : ↥L) := by
      apply Subtype.ext
      rw [IntermediateField.coe_pow]
      push_cast
      exact hi
    refine not_isSquare_neg_natCast_of_totallyReal (K := ↥L) htr 1 one_pos ⟨(⟨i, himem⟩ : ↥L), ?_⟩
    simpa using hsq.symm.trans (pow_two _)
  have hyL : y ∉ (L : Set Ω) := by
    intro hmem
    have hsq : (⟨y, hmem⟩ : ↥L) ^ 2 = -(q : ↥L) := by
      apply Subtype.ext
      rw [IntermediateField.coe_pow]
      push_cast
      exact hy
    refine not_isSquare_neg_natCast_of_totallyReal (K := ↥L) htr q hqpos ⟨(⟨y, hmem⟩ : ↥L), ?_⟩
    simpa using hsq.symm.trans (pow_two _)
  have hSi := mem_sup_adjoin_sq_neg_one (F := ↥K.L) (Ω := Ω) L hi hiL
  have hSy := mem_sup_adjoin_sq_neg_nat (F := ↥K.L) (Ω := Ω) L hy hyL
  refine ⟨i, y, q, hi, hy, hqpos, ?_, ?_, ?_⟩
  · -- the two quadratic extensions are distinct
    exact inf_sup_adjoin_eq (F := ↥K.L) (Ω := Ω) L hi hy hiL hyL hqnsq'
  · -- `L(i)` has a complex infinite place
    obtain ⟨Φ⟩ : Nonempty (Ω →+* ℂ) := by
      haveI halg : IsAlgClosure ℚ Ω := IsSepClosure.isAlgClosure_of_perfectField ℚ Ω
      haveI hac : IsAlgClosed Ω := IsAlgClosure.isAlgClosed ℚ
      exact ⟨(IsAlgClosed.lift : Ω →ₐ[ℚ] ℂ).toRingHom⟩
    have hmem : i ∈ (L ⊔ IntermediateField.adjoin ↥K.L ({i} : Set Ω)) :=
      (hSi i).mpr ⟨0, 1, by simp⟩
    have hx : (⟨i, hmem⟩ : ↥(L ⊔ IntermediateField.adjoin ↥K.L ({i} : Set Ω))) ^ 2
        = -(1 : ↥(L ⊔ IntermediateField.adjoin ↥K.L ({i} : Set Ω))) := by
      apply Subtype.ext
      rw [IntermediateField.coe_pow]
      push_cast
      exact hi
    exact exists_isComplex_of_sq_eq_neg_natCast
      (Φ.comp (algebraMap ↥(L ⊔ IntermediateField.adjoin ↥K.L ({i} : Set Ω)) Ω))
      (x := ⟨i, hmem⟩) (m := 1) one_pos (by simpa using hx)
  · -- `L(y)` has a complex infinite place
    obtain ⟨Φ⟩ : Nonempty (Ω →+* ℂ) := by
      haveI halg : IsAlgClosure ℚ Ω := IsSepClosure.isAlgClosure_of_perfectField ℚ Ω
      haveI hac : IsAlgClosed Ω := IsAlgClosure.isAlgClosed ℚ
      exact ⟨(IsAlgClosed.lift : Ω →ₐ[ℚ] ℂ).toRingHom⟩
    have hmem : y ∈ (L ⊔ IntermediateField.adjoin ↥K.L ({y} : Set Ω)) :=
      (hSy y).mpr ⟨0, 1, by simp⟩
    have hx : (⟨y, hmem⟩ : ↥(L ⊔ IntermediateField.adjoin ↥K.L ({y} : Set Ω))) ^ 2
        = -(q : ↥(L ⊔ IntermediateField.adjoin ↥K.L ({y} : Set Ω))) := by
      apply Subtype.ext
      rw [IntermediateField.coe_pow]
      push_cast
      exact hy
    exact exists_isComplex_of_sq_eq_neg_natCast
      (Φ.comp (algebraMap ↥(L ⊔ IntermediateField.adjoin ↥K.L ({y} : Set Ω)) Ω))
      (x := ⟨y, hmem⟩) (m := q) hqpos hx

end NK.Reconstruct
