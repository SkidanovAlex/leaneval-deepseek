/-!
# Detection by the Frobenius elements of `G_K` (corrected form)

`Submission/Work/Reconstruct/Assembly.lean` proves that two continuous homomorphisms out of
`Gal(K'/K)` agreeing on every `NK.Reconstruct.IsFrobElement` are equal.  That statement is
**vacuous**: as recorded in `frobElementAt.lean` §18.2, the predicate `IsFrobElement` holds for
*every* element of `Gal(K'/K)` (the trivial level `L = ⊥` always supplies a witness, because the
trivial automorphism of the residue field satisfies Fermat).  The present file provides the honest
replacement, on Serre's notion `IsFrobElementAt` — a genuine condition, and one whose density is the
Čebotarev density theorem (`dense_isFrobElementAt`).

## Contents

* `topologicalClosure_isFrobElementAt_eq_top` — the closure of the subgroup generated by the
  Frobenius elements is everything;
* `eq_of_eq_on_isFrobElementAt` — two continuous homomorphisms out of `Gal(K'/K)` which agree on
  every Frobenius element (at every prime) are equal.

Both consume the density theorem (hypothesis (c) of the reconstruction); neither is a tautology:
`IsFrobElementAt p σ` genuinely constrains `σ` (it pins it at every finite level).
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

namespace NK.Reconstruct

open scoped Pointwise

variable {K : Type*} [Field K] [NumberField K] {K' : Type*} [Field K'] [Algebra K K']
  [IsSepClosure K K']

/-- The set of Frobenius elements of `Gal(K'/K)`. -/
def FrobElementAtSet (K : Type*) [Field K] [NumberField K] (K' : Type*) [Field K']
    [Algebra K K'] : Set Gal(K'/K) :=
  {g : Gal(K'/K) | ∃ p : NK.Chebotarev.PrimeIdeal K, IsFrobElementAt p g}

/-- **Čebotarev, restated**: the set of Frobenius elements is dense. -/
theorem dense_frobElementAtSet (hc : ChebotarevInput K K') :
    Dense (FrobElementAtSet K K') :=
  dense_isFrobElementAt (K := K) (K' := K') hc

/-- **The Frobenius elements topologically generate `Gal(K'/K)`** — the honest replacement of
`NK.Reconstruct.topologicalClosure_isFrobElement_eq_top` (whose predicate is vacuous): the closure
of the subgroup they generate is everything, because they are dense (Čebotarev). -/
theorem topologicalClosure_isFrobElementAt_eq_top (hc : ChebotarevInput K K') :
    (Subgroup.closure (FrobElementAtSet K K')).topologicalClosure = ⊤ := by
  have hdense : Dense ((Subgroup.closure (FrobElementAtSet K K') : Subgroup Gal(K'/K)) :
      Set Gal(K'/K)) :=
    (dense_frobElementAtSet (K := K) (K' := K') hc).mono Subgroup.subset_closure
  refine eq_top_iff.mpr fun x _ => ?_
  have : x ∈ ((Subgroup.closure (FrobElementAtSet K K')).topologicalClosure :
      Set Gal(K'/K)) := by
    rw [Subgroup.topologicalClosure_coe, hdense.closure_eq]
    trivial
  exact this

/-- **Detection by the Frobenius elements, in the honest form.**  Two continuous homomorphisms out
of `Gal(K'/K)` into a Hausdorff topological group which agree on every Frobenius element (at every
prime of `K`) are equal: the Frobenius elements are dense (Čebotarev) and the set of coincidences of
two continuous maps into a Hausdorff space is closed. -/
theorem eq_of_eq_on_isFrobElementAt {H : Type*} [Group H] [TopologicalSpace H] [T2Space H]
    (hc : ChebotarevInput K K') (φ ψ : Gal(K'/K) →* H) (hφ : Continuous φ) (hψ : Continuous ψ)
    (h : ∀ (p : NK.Chebotarev.PrimeIdeal K) (σ : Gal(K'/K)), IsFrobElementAt p σ →
      φ σ = ψ σ) : φ = ψ := by
  have hclosed : IsClosed {σ : Gal(K'/K) | φ σ = ψ σ} := isClosed_eq hφ hψ
  have hsub : FrobElementAtSet K K' ⊆ {σ : Gal(K'/K) | φ σ = ψ σ} := by
    rintro σ ⟨p, hp⟩
    exact h p σ hp
  have hEq : {σ : Gal(K'/K) | φ σ = ψ σ} = Set.univ := by
    refine Set.eq_univ_of_forall fun σ => ?_
    have hσ : σ ∈ closure (FrobElementAtSet K K') := by
      rw [(dense_frobElementAtSet (K := K) (K' := K') hc).closure_eq]
      trivial
    have h2 : σ ∈ closure {σ : Gal(K'/K) | φ σ = ψ σ} := closure_mono hsub hσ
    rwa [hclosed.closure_eq] at h2
  exact MonoidHom.ext fun σ => Set.eq_univ_iff_forall.mp hEq σ

end NK.Reconstruct
