/-!
# Shimizu's Proposition 4f.5 from the two rank inputs

This file proves **Shimizu's Proposition 4f.5** (`NK.Reconstruct.Fourf5Input Ω ℓ`, arXiv:2009.10431,
§4; the "pinning" step of Neukirch's §12.2):

> for finite Galois levels `K₁, K₂ ⊆ L` of a separable closure `Ω` of `ℚ`, if `K₁` has a complex
> prime and `K₁^{(∞,ℓ)}L = LK₂^{(∞,ℓ)}`, then `K₁ = K₂`,

from the two rank inputs of `NK.Reconstruct.hausRank`:

* `NK.Reconstruct.HausRankInput Ω ℓ` — `r_ℓ(K) = rank_{ℤ_ℓ} Γ_K^{tf}`;
* `NK.Reconstruct.RankStrictMonoLevelInput ℚ Ω ℓ` — Shimizu's Lemma 4f.2,
* `NK.Reconstruct.ComplexPlaceInput Ω` — **a complex prime of a level is inherited by every
  larger level**, which is Shimizu's remark "Hence `K₂` also has a complex prime" at the end of the
  proof of Proposition 4f.5.  It is *not* an arithmetic input: it is the elementary statement that
  an infinite place of a number field is dominated by a place of any finite extension
  (`NumberField.InfinitePlace.comap_surjective`) and that a place above a complex place is complex
  (`NumberField.InfinitePlace.IsComplex.of_comap`).  It is isolated here because the transfer of
  these two Mathlib lemmas to intermediate fields of `Ω` requires the relative `Algebra` structure
  on a pair of intermediate fields (`RingHom.toAlgebra`), which is a formal rather than a
  mathematical point; see the README.

Everything else — the finiteness of the cokernel of `π^{tf}_{L/K}`, the identification of its
kernel with the automorphisms fixing `K^{(∞,ℓ)}`, the functoriality of the base change and the
monotonicity of the rank — is proved in `Submission/Work/Reconstruct/hausPi.lean` and
`Submission/Work/Reconstruct/hausRank.lean`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000

namespace NK.Reconstruct

open scoped Pointwise

variable {Ω : Type*} [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω]

/-- **A complex prime descends to every larger level**: if a finite Galois level `K` of `Ω/ℚ` has a
complex prime, so does every level `M ⊇ K`. -/
def ComplexPlaceInput (Ω : Type*) [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω] : Prop :=
  ∀ (K M : FrobLevel ℚ Ω) [IsSepClosure ↥K.L Ω], K.L ≤ M.L →
    (∃ v : NumberField.InfinitePlace ↥K.L, NumberField.InfinitePlace.IsComplex v) →
      ∃ w : NumberField.InfinitePlace ↥M.L, NumberField.InfinitePlace.IsComplex w

/-- **`ComplexPlaceInput` is a theorem.**  Every infinite place of `K` is dominated by an infinite
place of the finite (hence algebraic) extension `M` (`NumberField.InfinitePlace.comap_surjective`),
and a place above a complex place is complex (`NumberField.InfinitePlace.IsComplex.of_comap`).

The relative `Algebra` structure on the pair of intermediate fields is obtained from the inclusion
`↥K.L →+* ↥M.L` by `RingHom.toAlgebra`. -/
theorem complexPlaceInput (Ω : Type*) [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω] :
    ComplexPlaceInput Ω := by
  intro K M _ h hv
  obtain ⟨v, hv⟩ := hv
  haveI : Algebra ↥K.L ↥M.L :=
    ({ toFun := fun x => ⟨x.1, h x.2⟩
       map_one' := Subtype.ext rfl
       map_mul' := fun a b => Subtype.ext rfl
       map_zero' := Subtype.ext rfl
       map_add' := fun a b => Subtype.ext rfl } : ↥K.L →+* ↥M.L).toAlgebra
  haveI : Algebra.IsAlgebraic ↥K.L ↥M.L := Algebra.IsAlgebraic.of_finite ↥K.L ↥M.L
  obtain ⟨w, hw⟩ := NumberField.InfinitePlace.comap_surjective (k := ↥K.L) (K := ↥M.L) v
  have hw' : w.comap (algebraMap ↥K.L ↥M.L) = v := hw
  exact ⟨w, NumberField.InfinitePlace.IsComplex.of_comap (algebraMap ↥K.L ↥M.L) (by
    rw [hw']; exact hv)⟩

/-- **The rank step of Shimizu's proof of Proposition 4f.5.**

If `K₁^{(∞,ℓ)}L = LK₂^{(∞,ℓ)}` and `M := K₁ ∩ K₂`, then `r_ℓ(M) ≥ r_ℓ(K₁)`.

In Shimizu's proof this is the computation
`im(res^{K₁}) = im(res^{K₂}) = Hom(Γ_L/N, ℤ_ℓ)` (the equality of the images is the common kernel
`N = ker π_{L/K₁} = ker π_{L/K₂}`, `NK.Reconstruct.ker_hausPi_eq_of_levelInfinity_eq`), which has
rank `r_ℓ(K₁)`, is contained in `Hom(Γ_L,ℤ_ℓ)^{G(L/K₁∩K₂)}` — the images are invariant under both
`G(L/K₁)` and `G(L/K₂)` and `G(L/K₁∩K₂)` is generated by them, `L/ℚ` being Galois — and the
invariants have rank `r_ℓ(M)` by the "In particular" of Lemma 4f.1, i.e. by
`NK.Reconstruct.lemma4f1_of_transfer_rank` (whose *finite-cokernel* half is the named transfer
input `NK.Reconstruct.TransferInput`, CoNF (1.6.7)).

This is therefore the single place in Proposition 4f.5 where the duality `res = π^*` and the transfer
identity enter; everything else is proved in `Submission/Work/Reconstruct/hausPi.lean` and
`Submission/Work/Reconstruct/hausRank.lean`. -/
def ResRankInput (Ω : Type*) [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω]
    (ℓ : ℕ) [Fact ℓ.Prime] : Prop :=
  ∀ (K₁ K₂ M L : FrobLevel ℚ Ω) [IsSepClosure ↥K₁.L Ω] [IsSepClosure ↥K₂.L Ω]
    [IsSepClosure ↥M.L Ω],
    M.L = (K₁.L ⊓ K₂.L) → (K₁.L ≤ L.L) → (K₂.L ≤ L.L) →
    (levelInfinityOf (NumFieldIn.ofFrobLevel K₁) ℓ ⊔ L.L = L.L ⊔ levelInfinityOf (NumFieldIn.ofFrobLevel K₂) ℓ) →
      rankGamma ↥K₁.L Ω ℓ ≤ rankGamma ↥M.L Ω ℓ

/-- **Shimizu's Proposition 4f.5** (arXiv:2009.10431, §4) from the two rank inputs and the
inheritance of complex primes.

The proof is Shimizu's: with `M := K₁ ∩ K₂`,

1. `r_ℓ(K₁) = r_ℓ(K₂)` — the kernels of `π^{tf}_{L/K₁}` and `π^{tf}_{L/K₂}` agree because
   `K₁^{(∞,ℓ)}L = LK₂^{(∞,ℓ)}` (`NK.Reconstruct.ker_hausPi_eq_of_levelInfinity_eq`), and the rank
   of `Γ_K^{tf}` is the rank of the image of the base change
   (`NK.Reconstruct.rank_hausQuot_eq_rank_range_hausPi`);
2. Lemma 4f.2 applied to `M ⊆ K₁` (which has a complex prime) forces `M = K₁`, i.e. `K₁ ⊆ K₂`;
3. `K₂` has a complex prime by `ComplexPlaceInput`, and Lemma 4f.2 applied to `K₁ ⊆ K₂` contradicts
   the equality of ranks. -/
theorem fourf5_of_rankInputs (ℓ : ℕ) [Fact ℓ.Prime]
    (hH : HausRankInput Ω ℓ) (hM : RankStrictMonoLevelInput ℚ Ω ℓ)
    (hR : ResRankInput Ω ℓ) : Fourf5Input Ω ℓ := by
  intro K₁ K₂ L h₁ h₂ hsep₁ hsep₂ hsup hcomplex
  haveI : IsSepClosure ↥L.L Ω := isSepClosure_of_le L.L
  -- Step 1: the ℓ-ranks of `K₁` and `K₂` agree.
  have hker := ker_hausPi_eq_of_levelInfinity_eq (NumFieldIn.ofFrobLevel K₁) (NumFieldIn.ofFrobLevel K₂) L h₁ h₂ ℓ hsup
  have hrank : rankGamma ↥K₁.L Ω ℓ = rankGamma ↥K₂.L Ω ℓ := by
    have hcard : (rankGamma ↥K₁.L Ω ℓ : Cardinal) = (rankGamma ↥K₂.L Ω ℓ : Cardinal) := by
      rw [← hH ↥K₁.L Ω, ← hH ↥K₂.L Ω]
      exact rank_hausQuot_eq_of_ker_eq (NumFieldIn.ofFrobLevel K₁) (NumFieldIn.ofFrobLevel K₂) L h₁ h₂ ℓ hker
    exact_mod_cast hcard
  -- the meet `M = K₁ ∩ K₂`
  have hMK₁ : (K₁.inf K₂).L ≤ K₁.L := FrobLevel.inf_le_left K₁ K₂
  have hMK₂ : (K₁.inf K₂).L ≤ K₂.L := FrobLevel.inf_le_right K₁ K₂
  haveI : IsSepClosure ↥(K₁.inf K₂).L Ω := isSepClosure_of_le (K₁.inf K₂).L
  -- Step 2 (monotonicity): `r_ℓ(M) ≤ r_ℓ(K₁)`.
  have hβ : rankGamma ↥(K₁.inf K₂).L Ω ℓ ≤ rankGamma ↥K₁.L Ω ℓ := by
    have hcard := rank_hausQuot_le_of_le (K₁.inf K₂) K₁ L hMK₁ h₁ ℓ
    rw [hH ↥(K₁.inf K₂).L Ω, hH ↥K₁.L Ω] at hcard
    exact_mod_cast hcard
  -- Step 3 (Shimizu's rank computation): `r_ℓ(K₁) ≤ r_ℓ(M)`, hence equality.
  have hup : rankGamma ↥K₁.L Ω ℓ ≤ rankGamma ↥(K₁.inf K₂).L Ω ℓ :=
    hR K₁ K₂ (K₁.inf K₂) L rfl h₁ h₂ hsup
  have hMeq : rankGamma ↥(K₁.inf K₂).L Ω ℓ = rankGamma ↥K₁.L Ω ℓ := le_antisymm hβ hup
  -- Step 4: Lemma 4f.2 on `M ⊆ K₁` forces `K₁ ⊆ K₂`.
  have hM₁ : (K₁.inf K₂).L = K₁.L := by
    by_contra hne
    exact absurd hMeq (ne_of_lt (hM (K₁.inf K₂) K₁ hMK₁ hne hcomplex))
  have hle : K₁.L ≤ K₂.L := hM₁ ▸ hMK₂
  -- Step 5: Lemma 4f.2 on `K₁ ⊆ K₂` contradicts the equality of ranks.
  have hcplx₂ := complexPlaceInput Ω K₁ K₂ hle hcomplex
  by_contra hne
  exact (ne_of_lt (hM K₁ K₂ hle hne hcplx₂)) hrank

/-- **Shimizu's Theorem 4.0 (the assembly), with `Fourf5Input` proved from the rank inputs.**

This is `NK.Reconstruct.exists_isomorphism_of_prop4f3_data` with its `Fourf5Input` hypothesis
discharged by `NK.Reconstruct.fourf5_of_rankInputs`: from the data of Proposition 4f.3 together
with the three rank inputs and `ComplexPlaceInput`, the two base fields are isomorphic. -/
theorem exists_isomorphism_of_prop4f3_data_of_rankInputs {K₁ K₂ L : FrobLevel ℚ Ω}
    (h₁ : K₁.L ≤ L.L) (h₂ : K₂.L ≤ L.L)
    [IsSepClosure ↥K₁.L Ω] [IsSepClosure ↥K₂.L Ω] [IsSepClosure ↥L.L Ω]
    (ℓ : ℕ) [Fact ℓ.Prime]
    (σbar : Gamma ↥K₁.L Ω ℓ ≃* Gamma ↥K₂.L Ω ℓ) (hσbar : Continuous ⇑σbar)
    (primeMap : NK.Chebotarev.PrimeIdeal ↥K₁.L ≃ NK.Chebotarev.PrimeIdeal ↥K₂.L)
    (hb : ∀ (𝔭 : NK.Chebotarev.PrimeIdeal ↥K₁.L) (g₁ : Gal(Ω/↥K₁.L)) (g₂ : Gal(Ω/↥K₂.L)),
        IsFrobElementAt 𝔭 g₁ → IsFrobElementAt (primeMap 𝔭) g₂ →
        σbar (galToGamma (K := ↥K₁.L) (K' := Ω) ℓ g₁) =
          galToGamma (K := ↥K₂.L) (K' := Ω) ℓ g₂)
    (hchar : ∀ 𝔭 : NK.Chebotarev.PrimeIdeal ↥K₁.L,
        Ideal.under ℤ (primeMap 𝔭).asIdeal = Ideal.under ℤ 𝔭.asIdeal)
    (Θ : Gal(↥L.L/ℚ) → Ω ≃ₐ[ℚ] Ω)
    (hΘmem : ∀ τ, ∀ x : Ω, x ∈ L.L ↔ Θ τ x ∈ L.L)
    (hΘres : ∀ τ (x : ↥L.L), Θ τ (x : Ω) = (τ x : Ω))
    (hcomplex : ∃ v : NumberField.InfinitePlace ↥K₁.L, NumberField.InfinitePlace.IsComplex v)
    (hc : ChebotarevInput ℚ Ω)
    (hH : HausRankInput Ω ℓ) (hM : RankStrictMonoLevelInput ℚ Ω ℓ)
    (hR : ResRankInput Ω ℓ) :
    ∃ τ : Gal(↥L.L/ℚ), Nonempty (↥K₁.L ≃+* ↥K₂.L) :=
  exists_isomorphism_of_prop4f3_data K₁ K₂ L h₁ h₂ ℓ σbar hσbar primeMap hb hchar Θ hΘmem hΘres
    hcomplex hc (fourf5_of_rankInputs ℓ hH hM hR)

end NK.Reconstruct
