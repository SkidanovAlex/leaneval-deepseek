/-!
# The Frobenius elements topologically generate the absolute Galois group

Let `K` be a number field and `K'` a separable closure of `K`.  An element `g : Gal(K'/K)` is a
*Frobenius element* (`NK.Reconstruct.IsFrobElement`) if for some finite normal (hence Galois)
intermediate field `L` and some prime `P` of `𝓞 L` over a prime `p` of `𝓞 K`, the restriction of
`g` to `L` is the arithmetic Frobenius at `P`.

The main result of this file is that the subgroup generated by the Frobenius elements is *dense*
in `Gal(K'/K)` for the Krull topology:

`(Subgroup.closure {g | IsFrobElement g}).topologicalClosure = ⊤`.

The proof does not use the Čebotarev density theorem itself.  By the infinite Galois
correspondence it suffices to show that the fixed field of the closed subgroup
`H = closure {g | IsFrobElement g}` is `⊥`; for this it suffices (the finite Galois levels being
cofinal) that for each finite normal level `L` the image of `H` in `Gal(L/K)` is everything.
And that follows from the finite-level statement `NK.Chebotarev.FrobeniusGenerateTop`: the
Frobenius elements of a finite Galois extension `L/K` of number fields generate `Gal(L/K)`, and
every such Frobenius element is the restriction of an element of `H` (lift it along the surjective
restriction map).

The upgrade from the finite levels to the infinite extension uses the infinite Galois
correspondence: a closed subgroup surjecting onto every finite quotient is everything, because a
non-zero element of `Gal(K'/K)` is visible in a finite Galois quotient.
-/

open scoped Topology

set_option linter.style.haveILetI false

namespace NK.Reconstruct

theorem topologicalClosure_isFrobElement_eq_top {K K' : Type*} [Field K] [NumberField K]
    [Field K'] [Algebra K K'] [IsSepClosure K K'] :
    (Subgroup.closure {g : Gal(K'/K) | NK.Reconstruct.IsFrobElement g}).topologicalClosure
      = ⊤ := by
  classical
  let S : Set Gal(K'/K) := {g : Gal(K'/K) | IsFrobElement g}
  let H : Subgroup Gal(K'/K) := Subgroup.closure S
  -- ## Step 1: the image of `H` in every finite normal level is everything.
  have hmap : ∀ (L : IntermediateField K K') [FiniteDimensional K L] [Normal K L]
      [NumberField ↥L], Subgroup.map (AlgEquiv.restrictNormalHom L) H = ⊤ := by
    intro L hfd hnorm hnf
    haveI : FiniteDimensional K L := hfd
    haveI : Normal K L := hnorm
    haveI : NumberField ↥L := hnf
    haveI : IsGalois K ↥L := Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
    rw [eq_top_iff, ← NK.Chebotarev.FrobeniusGenerateTop (K := K) (L := ↥L)]
    rw [Subgroup.closure_le]
    intro σ hσ
    obtain ⟨p, hp⟩ := hσ
    rw [NK.Chebotarev.isFrobAtPrime_iff] at hp
    obtain ⟨P, hP, hfrob⟩ := hp
    obtain ⟨g, hg⟩ := AlgEquiv.restrictNormalHom_surjective (F := K) (K₁ := ↥L) (E := K') σ
    refine Subgroup.mem_map.mpr ⟨g, ?_, hg⟩
    refine Subgroup.subset_closure ⟨L, hfd, hnorm, hnf, p, P, hP, ?_⟩
    rw [hg]
    exact hfrob
  -- ## Step 2: the closed subgroup generated by the Frobenius elements is everything.
  let C : ClosedSubgroup Gal(K'/K) :=
    ⟨H.topologicalClosure, H.isClosed_topologicalClosure⟩
  have hmapC : ∀ (L : IntermediateField K K') [FiniteDimensional K L] [Normal K L]
      [NumberField ↥L],
      Subgroup.map (AlgEquiv.restrictNormalHom L) (C : Subgroup Gal(K'/K)) = ⊤ := by
    intro L hfd hnorm hnf
    haveI : FiniteDimensional K L := hfd
    haveI : Normal K L := hnorm
    haveI : NumberField ↥L := hnf
    rw [eq_top_iff, ← hmap L]
    exact Subgroup.map_mono (Subgroup.le_topologicalClosure H)
  -- Its fixed field is `⊥`, since every element of `K'` lies in a finite Galois level.
  have hfix : IntermediateField.fixedField (C : Subgroup Gal(K'/K)) = ⊥ := by
    refine le_antisymm ?_ bot_le
    intro y hy
    rw [IntermediateField.mem_fixedField_iff] at hy
    let M : FiniteGaloisIntermediateField K K' :=
      FiniteGaloisIntermediateField.adjoin K ({y} : Set K')
    let L : IntermediateField K K' := M.toIntermediateField
    haveI hLfd : FiniteDimensional K L := M.finiteDimensional
    haveI hLgal : IsGalois K L := M.isGalois
    haveI hLnorm : Normal K L := hLgal.to_normal
    haveI hLnf : NumberField ↥L := NumberField.of_module_finite K ↥L
    have hyL : y ∈ L :=
      FiniteGaloisIntermediateField.subset_adjoin K ({y} : Set K') (Set.mem_singleton y)
    have htop := hmapC L
    -- Every `K`-automorphism of `L` is the restriction of an element of `C`, so it fixes `y`.
    have hfix_y : ∀ τ : Gal(L/K), τ ⟨y, hyL⟩ = ⟨y, hyL⟩ := by
      intro τ
      have hτ : τ ∈ Subgroup.map (AlgEquiv.restrictNormalHom L) (C : Subgroup Gal(K'/K)) := by
        rw [htop]
        exact Subgroup.mem_top τ
      obtain ⟨c, hc, hcτ⟩ := Subgroup.mem_map.mp hτ
      have hcy : c y = y := hy c hc
      apply Subtype.ext
      rw [← hcτ, AlgEquiv.restrictNormalHom_apply, hcy]
    have hybot : (⟨y, hyL⟩ : ↥L) ∈ (⊥ : IntermediateField K ↥L) := by
      rw [InfiniteGalois.mem_bot_iff_fixed]
      intro f
      exact hfix_y f
    obtain ⟨z, hz⟩ := IntermediateField.mem_bot.mp hybot
    refine ⟨z, ?_⟩
    have hz' : (algebraMap K ↥L z : K') = y := congrArg Subtype.val hz
    rwa [show (algebraMap K ↥L z : K') = algebraMap K K' z from rfl] at hz'
  -- A closed subgroup with trivial fixed field is everything.
  have hCtop : (C : Subgroup Gal(K'/K)) = ⊤ := by
    rw [← InfiniteGalois.fixingSubgroup_fixedField C, hfix, IntermediateField.fixingSubgroup_bot]
  show H.topologicalClosure = ⊤
  exact hCtop

end NK.Reconstruct
