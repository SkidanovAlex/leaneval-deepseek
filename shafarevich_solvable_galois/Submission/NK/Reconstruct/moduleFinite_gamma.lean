section Level

variable {K : Type*} [Field K] [NumberField K] {K' : Type*} [Field K'] [Algebra K K']
  [IsGalois K K']

/-- The scalar action of `ℤ_ℓ` on a finite level is continuous (the level is discrete). -/
theorem continuous_smul_level (ℓ : ℕ) [Fact ℓ.Prime] (L : FrobLevel K K')
    (v : Additive (LevelEllPart L.L ℓ)) :
    Continuous (fun a : PadicInt ℓ => (a • v : Additive (LevelEllPart L.L ℓ))) := by
  have h : ∀ a : PadicInt ℓ, (a • v : Additive (LevelEllPart L.L ℓ))
      = (PadicInt.toZModPow (p := ℓ) (ellExp (LevelAbelianization L.L) ℓ) a) • v :=
    fun a => rfl
  have hf : Continuous (fun z : ZMod (ℓ ^ ellExp (LevelAbelianization L.L) ℓ) =>
      (z • v : Additive (LevelEllPart L.L ℓ))) := continuous_of_discreteTopology
  exact (hf.comp (NK.Reconstruct.continuous_toZModPow ℓ _)).congr (fun a => (h a).symm)

/-- The level map `c ↦ ∑ i, c i • v i` of a tuple of level elements is continuous. -/
theorem continuous_sum_smul (ℓ : ℕ) [Fact ℓ.Prime] (L : FrobLevel K K') {ι : Type*} [Fintype ι]
    (v : ι → Additive (LevelEllPart L.L ℓ)) :
    Continuous (fun c : ι → PadicInt ℓ => ∑ i, c i • v i) := by
  refine continuous_finsetSum (Finset.univ : Finset ι) fun i _ => ?_
  exact (continuous_smul_level ℓ L (v i)).comp (continuous_apply i)

/-- The additive version of the projection to a level, as a `ℤ_ℓ`-linear map. -/
noncomputable def projAdd (ℓ : ℕ) [Fact ℓ.Prime] (L : FrobLevel K K') :
    Additive (Gamma K K' ℓ) →ₗ[PadicInt ℓ] Additive (LevelEllPart L.L ℓ) where
  toFun F := Additive.ofMul (Gamma.proj L (Additive.toMul F))
  map_add' F G := rfl
  map_smul' a F := rfl

@[simp] theorem projAdd_apply (ℓ : ℕ) [Fact ℓ.Prime] (L : FrobLevel K K')
    (F : Additive (Gamma K K' ℓ)) :
    projAdd ℓ L F = Additive.ofMul (Gamma.proj L (Additive.toMul F)) := rfl

/-- The transition maps are compatible with linear combinations. -/
theorem ellRestrictAdd_sum_smul (ℓ : ℕ) [Fact ℓ.Prime] {L T : FrobLevel K K'}
    (hLT : L.L ≤ T.L) {ι : Type*} [Fintype ι] (c : ι → PadicInt ℓ)
    (v : ι → Additive (LevelEllPart T.L ℓ)) :
    ∑ i, c i • (ellRestrictAdd ℓ L T hLT (v i))
      = ellRestrictAdd ℓ L T hLT (∑ i, c i • v i) := by
  rw [map_sum]
  exact Finset.sum_congr rfl fun i _ => (ellRestrictAdd_smul ℓ hLT (c i) (v i)).symm

/-- **The `Additive` transfer of a generation statement.** -/
theorem addSubgroup_closure_ofMul_eq_top {G : Type*} [Group G] {ι : Type*} (S : ι → G)
    (h : Subgroup.closure (Set.range S) = ⊤) :
    AddSubgroup.closure (Set.range (fun i => Additive.ofMul (S i))) = ⊤ := by
  have h1 : (⊤ : AddSubgroup (Additive G)) = (Subgroup.closure (Set.range S)).toAddSubgroup := by
    rw [h, OrderIso.map_top]
  rw [h1, Subgroup.toAddSubgroup_closure]
  apply le_antisymm
  · refine AddSubgroup.closure_mono ?_
    rintro A ⟨i, hi⟩
    exact ⟨i, by rw [← hi]; rfl⟩
  · refine AddSubgroup.closure_mono ?_
    rintro A ⟨i, hi⟩
    exact ⟨i, by refine Additive.toMul.injective ?_; simpa using hi⟩

end Level

section Main

variable {K : Type*} [Field K] [NumberField K] {K' : Type*} [Field K'] [Algebra K K']
  [IsGalois K K']

/-- The universal property of `Γ_K` in additive form. -/
theorem gamma_ext_add (ℓ : ℕ) {f g : Additive (Gamma K K' ℓ)}
    (h : ∀ L : FrobLevel K K', Additive.ofMul (Gamma.proj L (Additive.toMul f))
        = Additive.ofMul (Gamma.proj L (Additive.toMul g))) : f = g := by
  have h1 : ∀ L : FrobLevel K K', Gamma.proj (ℓ := ℓ) L (Additive.toMul f)
      = Gamma.proj (ℓ := ℓ) L (Additive.toMul g) :=
    fun L => Additive.ofMul.injective (h L)
  exact Gamma.ext h1

end Main

/-- **`Γ_K` is a finitely generated `ℤ_ℓ`-module.**

Indeed `Γ_K = lim_L Γ_{L,ℓ}` is the projective limit of the finite ℓ-parts `Γ_{L,ℓ}` of the
abelianisations of the finite normal levels `L/K` of `K'`, the transition maps are surjective and
the ranks `r_ℓ(L) = ellRank Gal(L/K)^ab ℓ` are bounded by a constant `r`.  Hence every level is
generated by `r` elements and, by compactness, the limit is generated by `r` elements as well.

The boundedness of the level ranks is the *legitimate* arithmetic input here: it is supplied by
class field theory (the level groups are quotients of the finitely generated ℤ_ℓ-module `Γ_K` of
`NK.Reconstruct.torsionFreeGamma`, and conversely it is a field of
`NK.Reconstruct.RankFormulaInput`).  This statement is deliberately phrased with `BddAbove`
alone, so that it does not depend on the (degenerate) invariant `NK.Reconstruct.rankGamma`; see
the discussion in `Submission/Work/Reconstruct/torsionFreeGamma.lean`. -/
theorem moduleFinite_gamma_of_bddAbove {K : Type*} [Field K] [NumberField K] {K' : Type*}
    [Field K'] [Algebra K K'] [IsGalois K K'] (ℓ : ℕ) [Fact ℓ.Prime]
    (h : BddAbove (Set.range (fun L : FrobLevel K K' => FrobLevel.rank L ℓ))) :
    Module.Finite (PadicInt ℓ) (Additive (Gamma K K' ℓ)) := by
  classical
  obtain ⟨r, hr⟩ := h
  have hrank : ∀ L : FrobLevel K K', FrobLevel.rank L ℓ ≤ r :=
    fun L => hr (Set.mem_range_self L)
  have hgen : ∀ L : FrobLevel K K', ∃ S : Fin r → LevelEllPart L.L ℓ,
      Subgroup.closure (Set.range S) = (⊤ : Subgroup (LevelEllPart L.L ℓ)) :=
    fun L => exists_closure_eq_top_of_log_ellTorsion_le (A := LevelAbelianization L.L) (hrank L)
  -- Step 1: the generating conditions are closed
  have hclosed : ∀ L : FrobLevel K K', IsClosed {y : Fin r → Additive (Gamma K K' ℓ) |
      Submodule.span (PadicInt ℓ)
        (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))) = ⊤} := by
    intro L
    have hcont : Continuous (fun y : Fin r → Additive (Gamma K K' ℓ) =>
        fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (y i)))) := by
      refine continuous_pi fun i => ?_
      exact (continuous_proj ℓ L).comp (continuous_apply i)
    exact IsClosed.preimage hcont (isClosed_discrete ({z : Fin r → Additive (LevelEllPart L.L ℓ) |
      Submodule.span (PadicInt ℓ) (Set.range z) = ⊤}))
  -- Step 2: finite intersection property
  have hfip : ∀ u : Finset (FrobLevel K K'), ∃ y : Fin r → Additive (Gamma K K' ℓ),
      ∀ L ∈ u, Submodule.span (PadicInt ℓ)
        (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))) = ⊤ := by
    intro u
    rcases u.eq_empty_or_nonempty with rfl | ⟨L₀, hL₀⟩
    · exact ⟨0, fun L hL => absurd hL (Finset.notMem_empty L)⟩
    · obtain ⟨T, hT, -⟩ := projSurj_finset_exists_upper_bound L₀ u
      obtain ⟨S, hS⟩ := hgen T
      choose y hy using fun i : Fin r => proj_surjective (K := K) (K' := K') ℓ T (S i)
      refine ⟨fun i => Additive.ofMul (y i), fun L hL => ?_⟩
      have hLT : L.L ≤ T.L := hT L hL
      have hres : Subgroup.closure (Set.range (fun i => ellRestrict ℓ L T hLT (S i))) = ⊤ := by
        have hmap := Subgroup.map_top_of_surjective (ellRestrict ℓ L T hLT)
          (ellRestrict_surjective ℓ hLT)
        rw [← hS, MonoidHom.map_closure] at hmap
        have h2 : Set.range (fun i => ellRestrict ℓ L T hLT (S i))
            = ellRestrict ℓ L T hLT '' Set.range S := Set.range_comp _ _
        rw [h2]
        exact hmap
      have hadd := addSubgroup_closure_ofMul_eq_top (fun i => ellRestrict ℓ L T hLT (S i)) hres
      have hset : Set.range (fun i => Additive.ofMul
            (Gamma.proj L (Additive.toMul (Additive.ofMul (y i)))))
          = Set.range (fun i => Additive.ofMul (ellRestrict ℓ L T hLT (S i))) := by
        congr 1
        funext i
        show Gamma.proj L (y i) = ellRestrict ℓ L T hLT (S i)
        rw [← hy i, ← Gamma.proj_compatible L T hLT (y i)]
      rw [hset]
      have hle : AddSubgroup.closure (Set.range (fun i => Additive.ofMul (ellRestrict ℓ L T hLT (S i))))
          ≤ (Submodule.span (PadicInt ℓ)
            (Set.range (fun i => Additive.ofMul (ellRestrict ℓ L T hLT (S i))))).toAddSubgroup :=
        (AddSubgroup.closure_le _).mpr (fun x hx => Submodule.subset_span hx)
      exact eq_top_iff.mpr (fun z _ => hle (hadd ▸ AddSubgroup.mem_top z))
  -- Step 3: compactness gives a tuple generating every level
  obtain ⟨y, hy⟩ : ∃ y : Fin r → Additive (Gamma K K' ℓ), ∀ L : FrobLevel K K',
      Submodule.span (PadicInt ℓ)
        (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))) = ⊤ := by
    have hne : (⋂ L : FrobLevel K K', {z : Fin r → Additive (Gamma K K' ℓ) |
        Submodule.span (PadicInt ℓ)
          (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (z i))))) = ⊤}).Nonempty := by
      by_contra hcon
      rw [Set.not_nonempty_iff_eq_empty] at hcon
      obtain ⟨u, hu⟩ := isCompact_univ.elim_finite_subfamily_closed _ hclosed (by simpa using hcon)
      obtain ⟨z, hzu⟩ := hfip u
      have hmem : z ∈ (Set.univ : Set (Fin r → Additive (Gamma K K' ℓ))) ∩
          ⋂ L ∈ u, {z : Fin r → Additive (Gamma K K' ℓ) |
            Submodule.span (PadicInt ℓ)
              (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (z i))))) = ⊤} := by
        refine ⟨Set.mem_univ _, ?_⟩
        rw [Set.mem_iInter]
        intro L
        rw [Set.mem_iInter]
        exact hzu L
      exact Set.disjoint_left.mp hu hmem.1 hmem.2
    obtain ⟨z, hz⟩ := hne
    exact ⟨z, fun L => Set.mem_iInter.mp hz L⟩
  -- Step 4: the tuple generates Γ_K, by compactness in the coefficient space
  have hspan : Submodule.span (PadicInt ℓ) (Set.range y) = ⊤ := by
    rw [eq_top_iff]
    intro x _
    rw [Submodule.mem_span_range_iff_exists_fun (PadicInt ℓ)]
    have hclos : ∀ L : FrobLevel K K', IsClosed {c : Fin r → PadicInt ℓ |
        ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
          = Additive.ofMul (Gamma.proj L (Additive.toMul x))} := by
      intro L
      exact IsClosed.preimage (continuous_sum_smul ℓ L _)
        (isClosed_discrete ({a : Additive (LevelEllPart L.L ℓ) |
          a = Additive.ofMul (Gamma.proj L (Additive.toMul x))}))
    have hne : ∀ L : FrobLevel K K', ({c : Fin r → PadicInt ℓ |
        ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
          = Additive.ofMul (Gamma.proj L (Additive.toMul x))} : Set _).Nonempty := by
      intro L
      have hm : Additive.ofMul (Gamma.proj L (Additive.toMul x)) ∈ Submodule.span (PadicInt ℓ)
          (Set.range (fun i => Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))) := by
        rw [hy L]
        exact Submodule.mem_top
      obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (PadicInt ℓ)).mp hm
      exact ⟨c, hc⟩
    have hfip2 : ∀ u : Finset (FrobLevel K K'), ∃ c : Fin r → PadicInt ℓ, ∀ L ∈ u,
        c ∈ {c : Fin r → PadicInt ℓ |
          ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
            = Additive.ofMul (Gamma.proj L (Additive.toMul x))} := by
      intro u
      rcases u.eq_empty_or_nonempty with rfl | ⟨L₀, hL₀⟩
      · exact ⟨0, fun L hL => absurd hL (Finset.notMem_empty L)⟩
      · obtain ⟨T, hT, -⟩ := projSurj_finset_exists_upper_bound L₀ u
        obtain ⟨c, hc⟩ := hne T
        refine ⟨c, fun L hL => ?_⟩
        have hLT : L.L ≤ T.L := hT L hL
        have hkey : ∀ z : Additive (Gamma K K' ℓ), ellRestrictAdd ℓ L T hLT
            (Additive.ofMul (Gamma.proj T (Additive.toMul z)))
            = Additive.ofMul (Gamma.proj L (Additive.toMul z)) := by
          intro z
          show Additive.toMul (ellRestrictAdd ℓ L T hLT
              (Additive.ofMul (Gamma.proj T (Additive.toMul z))))
              = Additive.toMul (Additive.ofMul (Gamma.proj L (Additive.toMul z)))
          rw [ellRestrictAdd_apply]
          show ellRestrict ℓ L T hLT (Gamma.proj T (Additive.toMul z))
            = Gamma.proj L (Additive.toMul z)
          rw [Gamma.proj_compatible L T hLT (Additive.toMul z)]
        have hcon := congrArg (ellRestrictAdd ℓ L T hLT) hc
        rw [← ellRestrictAdd_sum_smul ℓ hLT] at hcon
        simp only [hkey] at hcon
        exact hcon
    have hne2 : (⋂ L : FrobLevel K K', {c : Fin r → PadicInt ℓ |
        ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
          = Additive.ofMul (Gamma.proj L (Additive.toMul x))}).Nonempty := by
      by_contra hcon
      rw [Set.not_nonempty_iff_eq_empty] at hcon
      obtain ⟨u, hu⟩ := isCompact_univ.elim_finite_subfamily_closed _ hclos (by simpa using hcon)
      obtain ⟨c, hcu⟩ := hfip2 u
      have hmem : c ∈ (Set.univ : Set (Fin r → PadicInt ℓ)) ∩
          ⋂ L ∈ u, {c : Fin r → PadicInt ℓ |
            ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
              = Additive.ofMul (Gamma.proj L (Additive.toMul x))} := by
        refine ⟨Set.mem_univ _, ?_⟩
        rw [Set.mem_iInter]
        intro L
        rw [Set.mem_iInter]
        exact hcu L
      exact Set.disjoint_left.mp hu hmem.1 hmem.2
    obtain ⟨c, hc⟩ := hne2
    refine ⟨c, ?_⟩
    refine gamma_ext_add ℓ fun L => ?_
    have hkey2 : Additive.ofMul (Gamma.proj L (Additive.toMul (∑ i, c i • y i)))
        = ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i)))) := by
      have hh : projAdd ℓ L (∑ i, c i • y i) = ∑ i, c i • projAdd ℓ L (y i) := by
        rw [map_sum]
        exact Finset.sum_congr rfl fun i _ => map_smul (projAdd ℓ L) (c i) (y i)
      simpa only [projAdd_apply] using hh
    have hcL : ∑ i, c i • (Additive.ofMul (Gamma.proj L (Additive.toMul (y i))))
        = Additive.ofMul (Gamma.proj L (Additive.toMul x)) := Set.mem_iInter.mp hc L
    rw [hkey2, hcL]
  exact Module.Finite.of_fg_top
    ((Submodule.fg_iff_exists_fin_generating_family).mpr ⟨r, y, hspan⟩)



end NK.Reconstruct
