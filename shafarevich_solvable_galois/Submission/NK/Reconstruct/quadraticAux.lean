/-!
# Auxiliary quadratic facts for `NK.Reconstruct.exists_aux_imaginary`

This module collects the elementary field-theoretic and number-theoretic facts used to
construct, inside a separable closure `Ω` of `ℚ`, two imaginary quadratic fields
`ℚ(i)` and `ℚ(√(-q))` whose compositum is linearly disjoint from a given totally real
number field `A ⊆ Ω`.

## Contents

* `adjoin_sq_eq_set`: if `w ^ 2 = d` with `d` in the base field and `w` is not in the image of
  the base field, then `F⟮w⟯ = {a + b * w}`.
* `linIndep_of_notMem`: the pair `(1, w)` is linearly independent over `F` when `w ∉ F`.
* `eq_zero_or_eq_zero_of_sq_mem`: in `F⟮w⟯` (`w ^ 2 = d`, `w ∉ F`), an element whose square lies
  in `F` is either in `F` or an `F`-multiple of `w`.
* `not_isSquare_natCast_of_prime`, `not_isSquare_natCast_mul_prime`: a prime, and the product of
  two distinct primes, is not a square in `ℚ`.
-/

set_option autoImplicit false

namespace NK.Reconstruct

/-- **Elements of `F⟮w⟯` when `w² ∈ F` and `w ∉ F` are exactly `a + b * w`.**

(If `w` is not in the image of the base field, the map `(a,b) ↦ a + b * w` is injective and its
image is the subfield generated by `w`.) -/
theorem adjoin_sq_eq_set {F K : Type*} [Field F] [Field K] [Algebra F K]
    {d : F} {w : K} (hw : w ^ 2 = algebraMap F K d)
    (hw' : ∀ c : F, algebraMap F K c ≠ w) :
    ((IntermediateField.adjoin F {w} : IntermediateField F K) : Set K)
      = {x : K | ∃ a b : F, x = algebraMap F K a + algebraMap F K b * w} := by
  have key : ∀ a b : F, (algebraMap F K a + algebraMap F K b * w)
      * (algebraMap F K a - algebraMap F K b * w) = algebraMap F K (a ^ 2 - b ^ 2 * d) := by
    intro a b
    have h1 : (algebraMap F K a + algebraMap F K b * w) * (algebraMap F K a - algebraMap F K b * w)
        = algebraMap F K a ^ 2 - algebraMap F K b ^ 2 * w ^ 2 := by ring
    rw [h1, hw, map_sub, map_mul, map_pow, map_pow]
  let S : Subfield K :=
    { carrier := {x : K | ∃ a b : F, x = algebraMap F K a + algebraMap F K b * w}
      mul_mem' := by
        rintro x y ⟨a₁, b₁, rfl⟩ ⟨a₂, b₂, rfl⟩
        refine ⟨a₁ * a₂ + b₁ * b₂ * d, a₁ * b₂ + b₁ * a₂, ?_⟩
        have h2 : (algebraMap F K a₁ + algebraMap F K b₁ * w)
            * (algebraMap F K a₂ + algebraMap F K b₂ * w)
            = algebraMap F K a₁ * algebraMap F K a₂
              + (algebraMap F K a₁ * algebraMap F K b₂ + algebraMap F K b₁ * algebraMap F K a₂) * w
              + algebraMap F K b₁ * algebraMap F K b₂ * w ^ 2 := by ring
        rw [h2, hw]
        simp only [map_add, map_mul]
        ring
      one_mem' := ⟨1, 0, by simp⟩
      add_mem' := by
        rintro x y ⟨a₁, b₁, rfl⟩ ⟨a₂, b₂, rfl⟩
        exact ⟨a₁ + a₂, b₁ + b₂, by rw [map_add, map_add]; ring⟩
      zero_mem' := ⟨0, 0, by simp⟩
      neg_mem' := by
        rintro x ⟨a, b, rfl⟩
        exact ⟨-a, -b, by rw [map_neg, map_neg]; ring⟩
      inv_mem' := by
        rintro x ⟨a, b, rfl⟩
        by_cases hb : b = 0
        · subst hb
          simp only [map_zero, zero_mul, add_zero]
          exact ⟨a⁻¹, 0, by rw [map_inv₀, map_zero, zero_mul, add_zero]⟩
        · refine ⟨(a ^ 2 - b ^ 2 * d)⁻¹ * a, -((a ^ 2 - b ^ 2 * d)⁻¹ * b), ?_⟩
          have hb' : algebraMap F K b ≠ 0 := (map_ne_zero_iff _ (algebraMap F K).injective).mpr hb
          have hN : a ^ 2 - b ^ 2 * d ≠ 0 := by
            intro h0
            have hz : (algebraMap F K a + algebraMap F K b * w)
                * (algebraMap F K a - algebraMap F K b * w) = 0 := by
              rw [key a b, h0, map_zero]
            rcases mul_eq_zero.mp hz with h1 | h2
            · have hx0 : algebraMap F K a = -(algebraMap F K b * w) := eq_neg_of_add_eq_zero_left h1
              have hw1 : w = algebraMap F K (-(b⁻¹ * a)) := by
                rw [map_neg, map_mul, map_inv₀, hx0, mul_neg, neg_neg, inv_mul_cancel_left₀ hb' w]
              exact hw' _ hw1.symm
            · have hx0 : algebraMap F K a = algebraMap F K b * w := sub_eq_zero.mp h2
              have hw1 : w = algebraMap F K (b⁻¹ * a) := by
                rw [map_mul, map_inv₀, hx0, ← mul_assoc, inv_mul_cancel₀ hb', one_mul]
              exact hw' _ hw1.symm
          rw [show algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹ * a)
                + algebraMap F K (-((a ^ 2 - b ^ 2 * d)⁻¹ * b)) * w
              = algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹) * (algebraMap F K a - algebraMap F K b * w) by
                rw [map_mul, map_neg, map_mul]; ring]
          refine inv_eq_of_mul_eq_one_right ?_
          calc (algebraMap F K a + algebraMap F K b * w)
                * (algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹) * (algebraMap F K a - algebraMap F K b * w))
              = algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹)
                * ((algebraMap F K a + algebraMap F K b * w)
                    * (algebraMap F K a - algebraMap F K b * w)) := by ring
            _ = algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹) * algebraMap F K (a ^ 2 - b ^ 2 * d) := by
                  rw [key a b]
            _ = algebraMap F K ((a ^ 2 - b ^ 2 * d)⁻¹ * (a ^ 2 - b ^ 2 * d)) := by rw [map_mul]
            _ = 1 := by rw [inv_mul_cancel₀ hN, map_one] }
  have hSI : S.toIntermediateField (fun a => ⟨a, 0, by simp⟩) = IntermediateField.adjoin F {w} := by
    apply le_antisymm
    · intro x hx
      obtain ⟨a, b, rfl⟩ := hx
      exact add_mem (IntermediateField.algebraMap_mem _ a)
        (mul_mem (IntermediateField.algebraMap_mem _ b) (IntermediateField.subset_adjoin F {w} (by simp)))
    · rw [IntermediateField.adjoin_le_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact ⟨0, 1, by simp⟩
  rw [← hSI]
  rfl

/-- If `w` is not in the image of the base field, then `(1, w)` is linearly independent over it. -/
theorem linIndep_of_notMem {F K : Type*} [Field F] [Field K] [Algebra F K] {w : K}
    (hw' : ∀ c : F, algebraMap F K c ≠ w) :
    ∀ a b : F, algebraMap F K a + algebraMap F K b * w = 0 → a = 0 ∧ b = 0 := by
  intro a b hab
  by_cases hb : b = 0
  · subst hb
    simp only [map_zero, zero_mul, add_zero] at hab
    exact ⟨(algebraMap F K).injective (by simpa using hab), rfl⟩
  · exfalso
    have hb' : algebraMap F K b ≠ 0 := (map_ne_zero_iff _ (algebraMap F K).injective).mpr hb
    have h1 : algebraMap F K b * w = -algebraMap F K a := eq_neg_of_add_eq_zero_right hab
    have h2 : w = algebraMap F K (b⁻¹ * (-a)) := by
      rw [map_mul, map_inv₀, map_neg, ← h1, ← mul_assoc, inv_mul_cancel₀ hb', one_mul]
    exact hw' _ h2.symm

/-- In `F⟮w⟯` with `w ^ 2 = d` and `w ∉ F`, an element whose square lies in `F` is either in
`F` or an `F`-multiple of `w`. -/
theorem eq_zero_or_eq_zero_of_sq_mem {F K : Type*} [Field F] [Field K] [Algebra F K]
    [NeZero (2 : F)] {d : F} {w : K} (hw : w ^ 2 = algebraMap F K d)
    (hw' : ∀ c : F, algebraMap F K c ≠ w) {u v : F}
    (h : ∃ c : F, (algebraMap F K u + algebraMap F K v * w) ^ 2 = algebraMap F K c) :
    u = 0 ∨ v = 0 := by
  obtain ⟨c, hc⟩ := h
  have hlin := linIndep_of_notMem hw'
  have hexp : (algebraMap F K u + algebraMap F K v * w) ^ 2
      = algebraMap F K (u ^ 2 + v ^ 2 * d) + algebraMap F K (2 * u * v) * w := by
    have h1 : (algebraMap F K u + algebraMap F K v * w) ^ 2
        = algebraMap F K u ^ 2 + algebraMap F K v ^ 2 * w ^ 2
          + algebraMap F K (2 * u * v) * w := by
      rw [show algebraMap F K (2 * u * v) = (2 : K) * algebraMap F K u * algebraMap F K v by
        simp only [map_mul, map_ofNat]]
      ring
    rw [h1, hw]
    simp only [map_add, map_mul, map_pow]
  have hsum : algebraMap F K (u ^ 2 + v ^ 2 * d) + algebraMap F K (2 * u * v) * w
      = algebraMap F K c := by rw [← hexp]; exact hc
  have hkey : algebraMap F K (2 * u * v) * w = algebraMap F K (c - (u ^ 2 + v ^ 2 * d)) := by
    rw [map_sub]
    exact eq_sub_iff_add_eq.mpr (by rw [add_comm, hsum])
  have hzero : algebraMap F K (-(c - (u ^ 2 + v ^ 2 * d))) + algebraMap F K (2 * u * v) * w = 0 := by
    rw [map_neg, hkey]; ring
  have := (hlin _ _ hzero).2
  have h2 : (2 : F) * u * v = 0 := this
  rcases mul_eq_zero.mp h2 with h3 | h3
  · rcases mul_eq_zero.mp h3 with h4 | h4
    · exact absurd h4 (NeZero.ne 2)
    · exact Or.inl h4
  · exact Or.inr h3

/-- A prime is not a square in `ℚ`. -/
theorem not_isSquare_natCast_of_prime {p : ℕ} (hp : p.Prime) : ¬ IsSquare ((p : ℕ) : ℚ) :=
  fun h => hp.not_isSquare (Rat.isSquare_natCast_iff.mp h)

/-- The product of two distinct primes is not a square in `ℚ`. -/
theorem not_isSquare_natCast_mul_prime {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q) :
    ¬ IsSquare ((p * q : ℕ) : ℚ) := by
  intro h
  obtain ⟨m, hm⟩ := Rat.isSquare_natCast_iff.mp h
  have hpm : p ∣ m := by
    have : p ∣ m * m := by rw [← hm]; exact dvd_mul_right p q
    rcases (hp.dvd_mul.mp this) with h' | h' <;> exact h'
  obtain ⟨k, rfl⟩ := hpm
  have hq' : q = p * k * k := by
    have : p * q = p * (p * k * k) := by rw [hm]; ring
    exact Nat.mul_left_cancel hp.pos this
  have : p ∣ q := ⟨k * k, by rw [hq']; ring⟩
  rcases hq.eq_one_or_self_of_dvd p this with h1 | h1
  · exact absurd h1 hp.ne_one
  · exact hne h1

end NK.Reconstruct
