/-- `ℤ_[ℓ]` has finite quotients: the quotient of `ℤ_[ℓ]` by a nonzero ideal is finite.
Indeed a nonzero ideal is generated by a power of `ℓ`, and `ℤ_[ℓ] ⧸ (ℓ ^ k) ≃+* ZMod (ℓ ^ k)`. -/
instance instHasFiniteQuotientsPadicInt {ℓ : ℕ} [Fact ℓ.Prime] :
    Ring.HasFiniteQuotients (PadicInt ℓ) where
  finiteQuotient {I} hI := by
    obtain ⟨k, hk⟩ := PadicInt.ideal_eq_span_pow_p (p := ℓ) hI
    subst hk
    have hs : Function.Surjective (PadicInt.toZModPow (p := ℓ) k) := fun y =>
      ⟨(y.val : PadicInt ℓ), by rw [map_natCast, ZMod.natCast_zmod_val]⟩
    haveI : Finite (ZMod (ℓ ^ k)) := Fintype.finite (ZMod.fintype (ℓ ^ k))
    have hker := PadicInt.ker_toZModPow (p := ℓ) k
    rw [← hker]
    exact Finite.of_injective ((PadicInt.toZModPow (p := ℓ) k).quotientKerEquivOfSurjective hs).toFun
      ((PadicInt.toZModPow (p := ℓ) k).quotientKerEquivOfSurjective hs).injective

/-- Key extension criterion.  Let `I ⊆ A` be a submodule, `N ≠ 0` a scalar with `N • A ⊆ I`, and
`mN : A →ₗ ↥I` the induced map `a ↦ N • a`.  If `φ : ↥I →ₗ ℤ_[ℓ]` takes values in `(N)` on the
image of `mN`, then `φ` extends to a linear form on `A`.  (This is division by `N` on the
`N`-divisible part of the image.) -/
lemma exists_extension_of_forall_mem_span {ℓ : ℕ} [Fact ℓ.Prime] {A : Type*}
    [AddCommGroup A] [Module (PadicInt ℓ) A]
    (I : Submodule (PadicInt ℓ) A) {N : PadicInt ℓ} (hN : N ≠ 0)
    (mN : A →ₗ[PadicInt ℓ] ↥I) (hmN : ∀ y : ↥I, mN (y : A) = N • y)
    (φ : ↥I →ₗ[PadicInt ℓ] PadicInt ℓ)
    (h : ∀ a : A, φ (mN a) ∈ Ideal.span {N}) :
    ∃ g : A →ₗ[PadicInt ℓ] PadicInt ℓ, g.comp I.subtype = φ := by
  -- multiplication by `N` identifies `ℤ_[ℓ]` with the principal ideal `(N)`
  let fN : PadicInt ℓ →ₗ[PadicInt ℓ] ↥(Ideal.span {N}) :=
    LinearMap.codRestrict (Ideal.span {N}) (LinearMap.mulRight (PadicInt ℓ) N)
      (fun c => by rw [Ideal.mem_span_singleton']; exact ⟨c, by rw [LinearMap.mulRight_apply]⟩)
  have hinj : Function.Injective fN := by
    intro a b hab
    have h2 : a * N = b * N := congrArg Subtype.val hab
    exact mul_right_cancel₀ hN h2
  have hsurj : Function.Surjective fN := by
    intro x
    obtain ⟨c, hc⟩ := (Ideal.mem_span_singleton').mp x.2
    exact ⟨c, Subtype.ext hc⟩
  let eN : PadicInt ℓ ≃ₗ[PadicInt ℓ] ↥(Ideal.span {N}) := LinearEquiv.ofBijective fN ⟨hinj, hsurj⟩
  have heN : ∀ c : PadicInt ℓ, (eN c : PadicInt ℓ) = c * N := by
    intro c
    rw [show eN c = fN c from LinearEquiv.ofBijective_apply fN c]
    rw [show ((fN c : ↥(Ideal.span {N})) : PadicInt ℓ) =
        (LinearMap.mulRight (PadicInt ℓ) N) c from LinearMap.codRestrict_apply _ _ c]
    rw [LinearMap.mulRight_apply]
  -- divide by `N`
  let g' : A →ₗ[PadicInt ℓ] ↥(Ideal.span {N}) := (φ.comp mN).codRestrict (Ideal.span {N}) h
  let g : A →ₗ[PadicInt ℓ] PadicInt ℓ := eN.symm.toLinearMap.comp g'
  refine ⟨g, ?_⟩
  have hkey : ∀ a : A, (g a) * N = φ (mN a) := by
    intro a
    have h1 : eN (g a) = g' a := LinearEquiv.apply_symm_apply eN (g' a)
    have h2 : (g' a : PadicInt ℓ) = φ (mN a) := by
      rw [show g' a = (φ.comp mN).codRestrict (Ideal.span {N}) h a from rfl]
      rw [LinearMap.codRestrict_apply]
      rfl
    rw [← heN (g a), h1, h2]
  ext y
  refine mul_right_cancel₀ hN ?_
  change g (y : A) * N = φ y * N
  rw [hkey (y : A), hmN y, map_smul, smul_eq_mul]
  ring

/-- **Abstract duality lemma.**  If `I ⊆ A` is a submodule with finite quotient `A ⧸ I`, then the
cokernel of the dual of the inclusion `I ↪ A` is finite.  Equivalently: `Hom(I, ℤ_[ℓ])` differs
from the restriction of `Hom(A, ℤ_[ℓ])` by a finite group.

The proof exhibits an injective map from `Hom(I, ℤ_[ℓ]) ⧸ res(Hom(A, ℤ_[ℓ]))` into the finite
module `(A ⧸ I) →ₗ (ℤ_[ℓ] ⧸ N ℤ_[ℓ])`, where `N ≠ 0` annihilates `A ⧸ I`; a form `φ` lands in the
restriction of `Hom(A, ℤ_[ℓ])` exactly when `φ (N a) ≡ 0 mod N` for all `a`. -/
lemma finite_dual_quotient_of_finite_quotient {ℓ : ℕ} [Fact ℓ.Prime] {A : Type*}
    [AddCommGroup A] [Module (PadicInt ℓ) A] (I : Submodule (PadicInt ℓ) A)
    (hI : Finite (A ⧸ I)) :
    Finite (Module.Dual (PadicInt ℓ) ↥I ⧸ LinearMap.range (LinearMap.dualMap I.subtype)) := by
  haveI := hI
  -- a nonzero scalar annihilating `A ⧸ I`
  have hcard : Nat.card (A ⧸ I) ≠ 0 := by
    haveI : Nonempty (A ⧸ I) := ⟨0⟩
    have h := Nat.card_pos (α := A ⧸ I)
    omega
  let N : PadicInt ℓ := (Nat.card (A ⧸ I) : PadicInt ℓ)
  have hN : N ≠ 0 := by
    simp only [N]
    exact_mod_cast hcard
  have hkill : ∀ c : A ⧸ I, N • c = 0 := by
    intro c
    show ((Nat.card (A ⧸ I) : PadicInt ℓ)) • c = 0
    rw [Nat.cast_smul_eq_nsmul]
    exact card_nsmul_eq_zero'
  have hmN : ∀ a : A, N • a ∈ I := by
    intro a
    have h : I.mkQ (N • a) = 0 := by
      rw [map_smul]
      exact hkill _
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h
  let mN : A →ₗ[PadicInt ℓ] ↥I := LinearMap.codRestrict I (N • LinearMap.id) hmN
  have hmNy : ∀ y : ↥I, mN (y : A) = N • y := fun y => Subtype.ext rfl
  haveI : Finite (PadicInt ℓ ⧸ Ideal.span {N}) :=
    Ring.HasFiniteQuotients.finiteQuotient (by simpa [Ideal.span_singleton_eq_bot] using hN)
  -- the evaluation map
  let q : PadicInt ℓ →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N}) := (Ideal.span {N}).mkQ
  let ψ : (↥I →ₗ[PadicInt ℓ] PadicInt ℓ) →ₗ[PadicInt ℓ]
      (A →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N})) :=
    (LinearMap.llcomp (PadicInt ℓ) A (PadicInt ℓ) (PadicInt ℓ ⧸ Ideal.span {N}) q).comp
      (LinearMap.dualMap mN)
  have hψ_apply : ∀ (φ : ↥I →ₗ[PadicInt ℓ] PadicInt ℓ) (a : A), (ψ φ) a = q (φ (mN a)) := by
    intro φ a
    rw [show ψ = (LinearMap.llcomp (PadicInt ℓ) A (PadicInt ℓ) (PadicInt ℓ ⧸ Ideal.span {N}) q).comp
        (LinearMap.dualMap mN) from rfl]
    rw [LinearMap.comp_apply, LinearMap.llcomp_apply, LinearMap.dualMap_apply]
  have hmem_span : ∀ (x : PadicInt ℓ), q x = 0 ↔ x ∈ Ideal.span {N} := by
    intro x
    rw [show q x = Submodule.Quotient.mk x from Submodule.mkQ_apply _ x,
      Submodule.Quotient.mk_eq_zero]
  -- `ψ φ` kills `I`, so it descends to `A ⧸ I`
  have hψmem : ∀ (φ : ↥I →ₗ[PadicInt ℓ] PadicInt ℓ) (y : I), (ψ φ) (y : A) = 0 := by
    intro φ y
    rw [hψ_apply φ (y : A), hmNy y]
    apply (hmem_span _).mpr
    rw [Ideal.mem_span_singleton']
    exact ⟨φ y, by rw [map_smul, smul_eq_mul, mul_comm]⟩
  have hψ : ∀ φ, I ≤ (ψ φ).ker := fun φ y hy => by
    rw [LinearMap.mem_ker]
    exact hψmem φ ⟨y, hy⟩
  let ev : (↥I →ₗ[PadicInt ℓ] PadicInt ℓ) →ₗ[PadicInt ℓ]
      (A ⧸ I →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N})) :=
    { toFun := fun φ => I.liftQ (ψ φ) (hψ φ)
      map_add' := by
        intro φ₁ φ₂
        refine LinearMap.ext fun x => ?_
        induction x using Submodule.Quotient.induction_on with
        | _ z => simp only [Submodule.liftQ_apply, LinearMap.add_apply, map_add]
      map_smul' := by
        intro r φ
        refine LinearMap.ext fun x => ?_
        induction x using Submodule.Quotient.induction_on with
        | _ z => simp only [Submodule.liftQ_apply, LinearMap.smul_apply, map_smul, RingHom.id_apply] }
  have ev_apply : ∀ φ, ev φ = I.liftQ (ψ φ) (hψ φ) := fun φ => rfl
  -- the kernel of `ev` is the image of the restriction map
  have hker1 : LinearMap.range (LinearMap.dualMap I.subtype) ≤ LinearMap.ker ev := by
    rintro f ⟨g, rfl⟩
    rw [LinearMap.mem_ker]
    refine LinearMap.ext fun x => ?_
    induction x using Submodule.Quotient.induction_on with
    | _ z =>
      rw [ev_apply, Submodule.liftQ_apply, LinearMap.zero_apply, hψ_apply, LinearMap.dualMap_apply]
      rw [show I.subtype (mN z) = N • z from rfl, map_smul]
      apply (hmem_span _).mpr
      rw [Ideal.mem_span_singleton']
      exact ⟨g z, by rw [smul_eq_mul, mul_comm]⟩
  have hker2 : LinearMap.ker ev ≤ LinearMap.range (LinearMap.dualMap I.subtype) := by
    intro φ hφ
    have hψ0 : ψ φ = 0 := by
      have h := Submodule.liftQ_mkQ I (ψ φ) (hψ φ)
      have h0 : I.liftQ (ψ φ) (hψ φ) = 0 := hφ
      rw [h0, LinearMap.zero_comp] at h
      exact h.symm
    have hmem : ∀ a : A, φ (mN a) ∈ Ideal.span {N} := by
      intro a
      have h0 : (ψ φ) a = 0 := by rw [hψ0]; rfl
      rw [hψ_apply] at h0
      exact (hmem_span _).mp h0
    obtain ⟨g, hg⟩ := exists_extension_of_forall_mem_span I hN mN hmNy φ hmem
    exact ⟨g, hg⟩
  have hker : LinearMap.ker ev = LinearMap.range (LinearMap.dualMap I.subtype) :=
    le_antisymm hker2 hker1
  -- `ev` induces an injection of the quotient into a finite type
  let L : (Module.Dual (PadicInt ℓ) ↥I ⧸ LinearMap.range (LinearMap.dualMap I.subtype)) →ₗ[PadicInt ℓ]
      (A ⧸ I →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N})) :=
    Submodule.liftQ (p := LinearMap.range (LinearMap.dualMap I.subtype)) (f := ev)
      (τ₁₂ := RingHom.id (PadicInt ℓ)) hker1
  have hL : L.ker = ⊥ := Submodule.ker_liftQ_eq_bot _ ev hker1 hker.le
  haveI : Finite (A ⧸ I →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N})) :=
    Finite.of_injective
      (fun f : (A ⧸ I →ₗ[PadicInt ℓ] (PadicInt ℓ ⧸ Ideal.span {N})) =>
        (f : A ⧸ I → (PadicInt ℓ ⧸ Ideal.span {N})))
      (fun f g h => LinearMap.ext (congrFun h))
  exact Finite.of_injective L (by rw [← LinearMap.ker_eq_bot]; exact hL)

/-- **Transport of the abstract duality lemma to a general map.**  If `π : B →ₗ A` has finite
kernel, then `B` and `range π` have the same duals (any linear form on `B` vanishes on the finite
kernel), so the cokernel of the dual of `π` is that of the dual of the inclusion `range π ↪ A`. -/
lemma finite_dualMap_cokernel {ℓ : ℕ} [Fact ℓ.Prime] {A B : Type*}
    [AddCommGroup A] [Module (PadicInt ℓ) A] [AddCommGroup B] [Module (PadicInt ℓ) B]
    (π : B →ₗ[PadicInt ℓ] A) (hker : Finite (LinearMap.ker π))
    (hfinI : Finite (Module.Dual (PadicInt ℓ) ↥(LinearMap.range π) ⧸
       LinearMap.range (LinearMap.dualMap (LinearMap.range π).subtype))) :
    Finite (Module.Dual (PadicInt ℓ) B ⧸ LinearMap.range (LinearMap.dualMap π)) := by
  let rr : B →ₗ[PadicInt ℓ] ↥(LinearMap.range π) :=
    LinearMap.codRestrict (LinearMap.range π) π (fun b => ⟨b, rfl⟩)
  let Φ : Module.Dual (PadicInt ℓ) ↥(LinearMap.range π) →ₗ[PadicInt ℓ] Module.Dual (PadicInt ℓ) B :=
    LinearMap.dualMap rr
  have hΦinj : Function.Injective Φ := by
    intro φ ψ h
    ext x
    obtain ⟨b, hb⟩ := x.2
    have h2 : (rr b : ↥(LinearMap.range π)) = x := Subtype.ext hb
    have h3 := congrFun (congrArg DFunLike.coe h) b
    rw [show (Φ φ) b = φ (rr b) from LinearMap.dualMap_apply _ _ _,
        show (Φ ψ) b = ψ (rr b) from LinearMap.dualMap_apply _ _ _] at h3
    rw [h2] at h3
    exact h3
  have hΦsurj : Function.Surjective Φ := by
    intro ψ
    -- any form on `B` vanishes on the finite kernel of `π`
    have hzero : ψ.comp (LinearMap.ker π).subtype = 0 := by
      have hfin : Finite ↥((ψ.comp (LinearMap.ker π).subtype).range) :=
        Finite.of_surjective (fun k : ↥(LinearMap.ker π) =>
            ⟨(ψ.comp (LinearMap.ker π).subtype) k, LinearMap.mem_range_self _ k⟩)
          (fun y => by obtain ⟨k, hk⟩ := LinearMap.mem_range.mp y.2; exact ⟨k, Subtype.ext hk⟩)
      exact LinearMap.range_eq_bot.mp (submodule_eq_bot_of_finite _ hfin)
    have hle : LinearMap.ker π ≤ LinearMap.ker ψ := by
      rw [← Submodule.range_subtype (LinearMap.ker π)]
      exact LinearMap.range_le_ker_iff.mpr hzero
    refine ⟨((LinearMap.ker π).liftQ ψ hle).comp (LinearMap.quotKerEquivRange π).symm.toLinearMap, ?_⟩
    ext b
    rw [show Φ _ b = _ from LinearMap.dualMap_apply _ _ _, LinearMap.comp_apply]
    have h1 : ((LinearMap.quotKerEquivRange π).symm.toLinearMap) (rr b) = (LinearMap.ker π).mkQ b := by
      change (LinearMap.quotKerEquivRange π).symm (rr b) = _
      exact LinearMap.quotKerEquivRange_symm_apply_image π b ⟨b, rfl⟩
    rw [h1, Submodule.mkQ_apply, Submodule.liftQ_apply]
  let e : Module.Dual (PadicInt ℓ) ↥(LinearMap.range π) ≃ₗ[PadicInt ℓ] Module.Dual (PadicInt ℓ) B :=
    LinearEquiv.ofBijective Φ ⟨hΦinj, hΦsurj⟩
  have he : e.toLinearMap = Φ := rfl
  have he_comp : e.toLinearMap.comp (LinearMap.dualMap (LinearMap.range π).subtype) =
      LinearMap.dualMap π := by
    rw [he]
    ext g b
    show g (↑(rr b)) = g (π b)
    rfl
  haveI := hfinI
  have hmap : (LinearMap.range (LinearMap.dualMap (LinearMap.range π).subtype)).map e.toLinearMap =
      LinearMap.range (LinearMap.dualMap π) := by
    rw [← LinearMap.range_comp, he_comp]
  let E := Submodule.Quotient.equiv (LinearMap.range (LinearMap.dualMap (LinearMap.range π).subtype))
    (LinearMap.range (LinearMap.dualMap π)) e hmap
  exact Finite.of_injective (α := Module.Dual (PadicInt ℓ) B ⧸ LinearMap.range (LinearMap.dualMap π))
    (β := Module.Dual (PadicInt ℓ) ↥(LinearMap.range π) ⧸
      LinearMap.range (LinearMap.dualMap (LinearMap.range π).subtype))
    E.symm.toEquiv.toFun E.symm.toEquiv.injective

/-- **Lemma 4f.1, abstract duality form.**  If `π : B → A` is a `ℤ_ℓ`-linear map whose cokernel and
whose kernel are finite, then the dual `π^* : Hom(A, ℤ_ℓ) → Hom(B, ℤ_ℓ)` is injective with finite
cokernel. -/
theorem lemma4f1_dual {ℓ : ℕ} [Fact ℓ.Prime] {A B : Type*}
    [AddCommGroup A] [Module (PadicInt ℓ) A] [AddCommGroup B] [Module (PadicInt ℓ) B]
    (π : B →ₗ[PadicInt ℓ] A) (hcok : Finite (A ⧸ LinearMap.range π))
    (hker : Finite (LinearMap.ker π)) :
    Function.Injective (LinearMap.dualMap π) ∧
      Finite (Module.Dual (PadicInt ℓ) B ⧸ LinearMap.range (LinearMap.dualMap π)) := by
  refine ⟨?_, ?_⟩
  · -- injectivity: a form killing `range π` factors through the finite cokernel
    rw [← LinearMap.ker_eq_bot]
    rw [Submodule.eq_bot_iff]
    intro φ hφ
    refine dual_injective_of_finite_index π hcok φ ?_
    have h1 : (LinearMap.dualMap π) φ = 0 := LinearMap.mem_ker.mp hφ
    ext b
    rw [LinearMap.comp_apply]
    have h2 := congrArg (fun f : B →ₗ[PadicInt ℓ] PadicInt ℓ => f b) h1
    rw [LinearMap.dualMap_apply, LinearMap.zero_apply] at h2
    exact h2
  · -- finite cokernel
    exact finite_dualMap_cokernel π hker (finite_dual_quotient_of_finite_quotient _ hcok)

end NK.Reconstruct
