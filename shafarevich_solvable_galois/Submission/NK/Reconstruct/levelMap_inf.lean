/-!
# `levelMap` preserves finite intersections

`NK.Reconstruct.levelMap ψ L` is the image of a finite level `L` under the correspondence of
levels induced by a homeomorphic isomorphism `ψ` of absolute Galois groups: the fixed field of
`L.fixingSubgroup.map ψ`.

The point of this file is that this correspondence preserves *finite intersections* of levels:

`levelMap ψ (L ⊓ M) = levelMap ψ L ⊓ levelMap ψ M`.

The mathematical content is the interaction of `ψ` with the Galois correspondence of an infinite
Galois extension.  The fixing subgroup of an intersection of levels is the *topological closure* of
the subgroup generated by the two fixing subgroups

`(L ⊓ M).fixingSubgroup = (L.fixingSubgroup ⊔ M.fixingSubgroup).topologicalClosure`,

and the fixed field of a subgroup equals the fixed field of its topological closure, while a
homeomorphism of Galois groups carries topological closures to topological closures.  This is why
the statement is not a formal triviality: the naive "join of the fixing subgroups" is not closed in
general, and only the closure is canonical.

## Main results

* `NK.Reconstruct.fixedField_sup_subgroup` — the fixed field of the subgroup generated by `H` and
  `K` is the intersection of the two fixed fields (for *arbitrary* subgroups, no closedness);
* `NK.Reconstruct.fixedField_topologicalClosure` — the fixed field of a subgroup equals the fixed
  field of its topological closure;
* `NK.Reconstruct.map_topologicalClosure_of_isHomeomorph` — a homeomorphism of topological groups
  carries the topological closure of a subgroup to the topological closure of its image;
* `NK.Reconstruct.levelMap_inf` — the target lemma.
-/

namespace NK.Reconstruct

open scoped Pointwise

/-! ## Auxiliary facts about the Galois correspondence of an infinite Galois extension -/

/-- **The fixed field of a join of subgroups is the meet of the fixed fields**, for arbitrary
subgroups: an element is fixed by the subgroup generated by `H` and `K` if and only if it is fixed
by `H` and by `K`.  (The infimum of intermediate fields is just their intersection.) -/
theorem fixedField_sup_subgroup {k E : Type*} [Field k] [Field E] [Algebra k E]
    (H K : Subgroup Gal(E/k)) :
    IntermediateField.fixedField (H ⊔ K) =
      IntermediateField.fixedField H ⊓ IntermediateField.fixedField K := by
  apply le_antisymm
  · exact le_inf (IntermediateField.fixedField_le le_sup_left)
      (IntermediateField.fixedField_le le_sup_right)
  · refine (IntermediateField.le_iff_le (H ⊔ K)
      (IntermediateField.fixedField H ⊓ IntermediateField.fixedField K)).mpr ?_
    exact sup_le ((IntermediateField.le_iff_le H _).mp inf_le_left)
      ((IntermediateField.le_iff_le K _).mp inf_le_right)

/-- **The fixed field of a subgroup equals the fixed field of its topological closure**: the
stabiliser of a point of `E` is closed (it contains the open fixing subgroup of the finite level
generated by that point), and the fixing subgroup of the fixed field of `H` is a closed subgroup
containing `H`. -/
theorem fixedField_topologicalClosure {k E : Type*} [Field k] [Field E] [Algebra k E]
    [IsGalois k E] (H : Subgroup Gal(E/k)) :
    IntermediateField.fixedField H.topologicalClosure = IntermediateField.fixedField H := by
  refine le_antisymm (IntermediateField.fixedField_le (Subgroup.le_topologicalClosure H)) ?_
  calc IntermediateField.fixedField H
      = IntermediateField.fixedField (IntermediateField.fixedField H).fixingSubgroup :=
        (InfiniteGalois.fixedField_fixingSubgroup _).symm
    _ ≤ IntermediateField.fixedField H.topologicalClosure :=
        IntermediateField.fixedField_le
          (Subgroup.topologicalClosure_minimal H ((IntermediateField.le_iff_le H _).mp le_rfl)
            (InfiniteGalois.fixingSubgroup_isClosed _))

/-- **A homeomorphism of topological groups carries topological closures of subgroups to
topological closures of subgroups**: the image of `closure s` is closed and contains the image of
`s`, while the image of `closure s` is contained in the closure of the image by continuity. -/
theorem map_topologicalClosure_of_isHomeomorph {G H : Type*} [TopologicalSpace G] [Group G]
    [IsTopologicalGroup G] [TopologicalSpace H] [Group H] [IsTopologicalGroup H]
    (f : G →* H) (hf : IsHomeomorph f) (s : Subgroup G) :
    s.topologicalClosure.map f = (s.map f).topologicalClosure := by
  apply SetLike.ext'
  simp only [Subgroup.topologicalClosure_coe, Subgroup.coe_map]
  exact hf.image_closure _

/-! ## The target lemma -/

/-- **The level correspondence induced by a homeomorphic isomorphism of absolute Galois groups
preserves infima of finite levels.** -/
theorem levelMap_inf {Ω : Type*} [Field Ω] [Algebra ℚ Ω] [IsGalois ℚ Ω] [IsSepClosure ℚ Ω]
    (K₁ K₂ : NK.Reconstruct.NumFieldIn ℚ Ω) [IsSepClosure ↥K₁.L Ω] [IsSepClosure ↥K₂.L Ω]
    (ψ : Gal(Ω/↥K₁.L) ≃* Gal(Ω/↥K₂.L)) (hψ : IsHomeomorph ψ)
    (L M : IntermediateField ↥K₁.L Ω) [FiniteDimensional ↥K₁.L L] [FiniteDimensional ↥K₁.L M] :
    NK.Reconstruct.levelMap ψ (L ⊓ M) = NK.Reconstruct.levelMap ψ L ⊓ NK.Reconstruct.levelMap ψ M := by
  -- The fixing subgroup of `L ⊓ M` is the topological closure of the subgroup generated by
  -- `Gal(Ω/L)` and `Gal(Ω/M)`.
  have hfield : IntermediateField.fixedField
      (L.fixingSubgroup ⊔ M.fixingSubgroup).topologicalClosure = L ⊓ M := by
    rw [fixedField_topologicalClosure, fixedField_sup_subgroup,
      InfiniteGalois.fixedField_fixingSubgroup L, InfiniteGalois.fixedField_fixingSubgroup M]
  have hfix : (L ⊓ M).fixingSubgroup =
      (L.fixingSubgroup ⊔ M.fixingSubgroup).topologicalClosure := by
    rw [← hfield]
    exact InfiniteGalois.fixingSubgroup_fixedField ⟨_, Subgroup.isClosed_topologicalClosure _⟩
  -- `ψ` interchanges topological closures.
  have hmap : ((L.fixingSubgroup ⊔ M.fixingSubgroup).topologicalClosure).map
        (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L)) =
      ((L.fixingSubgroup ⊔ M.fixingSubgroup).map
        (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))).topologicalClosure :=
    map_topologicalClosure_of_isHomeomorph _ hψ _
  calc NK.Reconstruct.levelMap ψ (L ⊓ M)
      = IntermediateField.fixedField
          ((L ⊓ M).fixingSubgroup.map (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) := rfl
    _ = IntermediateField.fixedField
          (((L.fixingSubgroup ⊔ M.fixingSubgroup).topologicalClosure).map
            (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) := by rw [hfix]
    _ = IntermediateField.fixedField
          (((L.fixingSubgroup ⊔ M.fixingSubgroup).map
            (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))).topologicalClosure) := by rw [hmap]
    _ = IntermediateField.fixedField
          ((L.fixingSubgroup ⊔ M.fixingSubgroup).map
            (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) := fixedField_topologicalClosure _
    _ = IntermediateField.fixedField
          (L.fixingSubgroup.map (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L)) ⊔
            M.fixingSubgroup.map (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) := by rw [Subgroup.map_sup]
    _ = IntermediateField.fixedField
            (L.fixingSubgroup.map (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) ⊓
          IntermediateField.fixedField
            (M.fixingSubgroup.map (ψ : Gal(Ω/↥K₁.L) →* Gal(Ω/↥K₂.L))) :=
        fixedField_sup_subgroup _ _
    _ = NK.Reconstruct.levelMap ψ L ⊓ NK.Reconstruct.levelMap ψ M := rfl

end NK.Reconstruct
