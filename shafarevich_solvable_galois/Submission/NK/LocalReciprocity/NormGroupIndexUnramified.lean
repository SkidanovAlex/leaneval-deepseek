/-!
# The index of the norm group of an unramified local extension

For an unramified finite Galois extension `L_q / K_Q` of local fields, the local norm index theorem
holds: the norm group `N_{L_q/K_Q}(L_qˣ)` has index `[L_q : K_Q]` in `K_Qˣ`.  For an unramified
extension this needs no commutativity hypothesis, because `Gal(L_q/K_Q)` is generated by the
Frobenius and hence automatically abelian (`frobeniusLocal_generates`); this file records that,
reducing the unramified case to the abelian norm index theorem of the commons
(`Commons.NumberTheory.NumberField.Completion.natCard_quotient_units_range_norm_eq_finrank_of_abelian_local`).
-/

open scoped NumberField
open IsDedekindDomain.HeightOneSpectrum

namespace NK.LocalReciprocity

noncomputable section

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- The Galois group of the local field is commutative when the Frobenius generates it. -/
theorem isMulCommutative_of_frobeniusLocal_generates
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (q : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) [hq : q.asIdeal.LiesOver Q.asIdeal]
    (hunr : q.asIdeal.ramificationIdx (𝓞 K) = 1) :
    ∀ a b : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L, a * b = b * a := by
  have htop := frobeniusLocal_generates Q q hunr
  intro a b
  obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (htop ▸ Subgroup.mem_top a)
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (htop ▸ Subgroup.mem_top b)
  rw [← hm, ← hn, ← zpow_add, add_comm, zpow_add]

/-- **The local index formula for an unramified extension**: the norm group has index the local
degree. -/
theorem index_normGroup_eq_finrank_of_ramificationIdx_eq_one
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (q : IsDedekindDomain.HeightOneSpectrum (𝓞 L)) [hq : q.asIdeal.LiesOver Q.asIdeal]
    (hunr : q.asIdeal.ramificationIdx (𝓞 K) = 1) :
    (normGroup (Q.adicCompletion K) (q.adicCompletion L)).index =
      Module.finrank (Q.adicCompletion K) (q.adicCompletion L) :=
  index_normGroup_eq_finrank Q q (isMulCommutative_of_frobeniusLocal_generates Q q hunr)

end

end NK.LocalReciprocity
