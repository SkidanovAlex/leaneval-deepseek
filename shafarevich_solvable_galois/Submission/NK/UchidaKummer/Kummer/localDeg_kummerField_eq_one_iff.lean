/-! ## The Kummer field as a simple extension -/

/-- **The Kummer field of `a` is the simple extension generated by any `p`-th root of `a`.**

If `α ∈ K'` satisfies `α ^ p = a` (`p` prime, `ζ` a primitive `p`-th root of unity in `k`), then
every `p`-th root of `a` is of the form `ζ ^ i * α`, so the subfield generated by *all* the
`p`-th roots is the simple extension `k⟮α⟯`. -/
theorem kummerField_eq_adjoin_simple {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    (p : ℕ) (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p) (a : kˣ) {α : K'}
    (hα : α ^ p = algebraMap k K' (a : k)) :
    NK.LocalAnabelian.kummerField (K' := K') p a = k⟮α⟯ := by
  have hb0 : algebraMap k K' (a : k) ≠ 0 := by simp
  have hα0 : α ≠ 0 := by
    intro h; rw [h, zero_pow hp.ne_zero] at hα; exact hb0 hα.symm
  refine le_antisymm ?_ ?_
  · rw [show NK.LocalAnabelian.kummerField (K' := K') p a
        = IntermediateField.adjoin k {β : K' | β ^ p = algebraMap k K' (a : k)} from rfl,
      IntermediateField.adjoin_le_iff]
    intro β hβ
    have hx : (β / α) ^ p = 1 := by rw [div_pow, hβ, hα, div_self hb0]
    have hmem : β / α ∈ nthRoots p (1 : K') := (mem_nthRoots hp.pos).mpr hx
    rw [(hζ.map_of_injective (RingHom.injective (algebraMap k K'))).nthRoots_eq
      (show (1 : K') ^ p = 1 by simp)] at hmem
    simp only [Multiset.mem_map, Multiset.mem_range] at hmem
    obtain ⟨i, hi, hβi⟩ := hmem
    rw [mul_one] at hβi
    have hβeq : β = algebraMap k K' (ζ ^ i) * α := by
      rw [map_pow, hβi, div_mul_cancel₀ β hα0]
    rw [hβeq]
    exact mul_mem (IntermediateField.algebraMap_mem _ (ζ ^ i))
      (IntermediateField.mem_adjoin_simple_self k α)
  · rw [IntermediateField.adjoin_simple_le_iff]
    exact NK.LocalAnabelian.mem_kummerField_of_pow_eq hα

/-! ## Existence of the root -/

/-- In a separable closure of `k`, the polynomial `X ^ p - a` has a root. -/
theorem exists_pow_eq_algebraMap_of_isSepClosure {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] [IsSepClosure k K'] (p : ℕ) (hp : p.Prime) {ζ : k}
    (hζ : IsPrimitiveRoot ζ p) (a : kˣ) :
    ∃ α : K', α ^ p = algebraMap k K' (a : k) := by
  haveI : IsSepClosed K' := IsSepClosure.sep_closed k
  have hchar : p ≠ ringChar k :=
    NK.LocalAnabelian.Kummer.pow_ne_ringChar_of_isPrimitiveRoot p hp hζ
  have hpk : (p : k) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime (R := k) hp hchar.symm
  have hsep : (X ^ p - C (a : k)).Separable := separable_X_pow_sub_C (a : k) hpk (by simp)
  obtain ⟨α, hα⟩ := IsSepClosed.exists_aeval_eq_zero K' (X ^ p - C (a : k))
    (by rw [degree_X_pow_sub_C hp.pos]; exact Nat.cast_ne_zero.mpr hp.ne_zero) hsep
  rw [aeval_def, eval₂_sub, eval₂_pow, eval₂_C, eval₂_X, sub_eq_zero] at hα
  exact ⟨α, hα⟩

/-! ## The image of the root lies in the image of the completion -/

/-- **If `a` is an `ℓ`-th power in the completion `K_𝔮`, the image of any `ℓ`-th root of `a`
in the completion `L_q` is already in the image of `K_𝔮`.**

Indeed all the roots of `X ^ ℓ - a` in the local field `L_q` are `ζ ^ i * b` with `b ^ ℓ = a` and
`ζ` the image of the primitive root of unity, hence lie in the image of `K_𝔮`. -/
theorem algebraMap_mem_range_adicCompletionMap_of_pow_eq
    {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L]
    (Q : NK.Chebotarev.PrimeIdeal K) (q : NK.Chebotarev.PrimeIdeal L)
    (hq : q.asIdeal.LiesOver Q.asIdeal) (ℓ : ℕ) (hℓ : ℓ.Prime) {ζ : K}
    (hζ : IsPrimitiveRoot ζ ℓ) {a : Kˣ} {b : (Q.adicCompletion K)ˣ}
    (hb : algebraMap K (Q.adicCompletion K) (a : K) = (b : Q.adicCompletion K) ^ ℓ)
    {α : L} (hα : α ^ ℓ = algebraMap K L (a : K)) :
    algebraMap L (q.adicCompletion L) α ∈
      Set.range (Commons.RingTheory.Henselian.adicCompletionMap Q q hq) := by
  classical
  haveI : NeZero ℓ := ⟨hℓ.ne_zero⟩
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  haveI hST : IsScalarTower K (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion Q q hq
  have hI : Function.Injective (Commons.RingTheory.Henselian.adicCompletionMap Q q hq) :=
    RingHom.injective _
  set b' : q.adicCompletion L :=
    (Commons.RingTheory.Henselian.adicCompletionMap Q q hq) (b : Q.adicCompletion K) with hb'def
  have hb'0 : b' ≠ 0 := by
    rw [hb'def, ← map_zero (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)]
    exact fun h => (Units.ne_zero b) (hI h)
  have hθ : (algebraMap L (q.adicCompletion L) α) ^ ℓ = b' ^ ℓ := by
    rw [← map_pow, hα]
    rw [← IsScalarTower.algebraMap_apply K L (q.adicCompletion L) (a : K)]
    rw [IsScalarTower.algebraMap_apply K (Q.adicCompletion K) (q.adicCompletion L) (a : K)]
    rw [RingHom.algebraMap_toAlgebra, hb, map_pow (Commons.RingTheory.Henselian.adicCompletionMap Q q hq), hb'def]
  have hone : (algebraMap L (q.adicCompletion L) α / b') ^ ℓ = 1 := by
    rw [div_pow, hθ, div_self (pow_ne_zero ℓ hb'0)]
  let ζ' : q.adicCompletion L :=
    (Commons.RingTheory.Henselian.adicCompletionMap Q q hq) (algebraMap K (Q.adicCompletion K) ζ)
  have hζ' : IsPrimitiveRoot ζ' ℓ :=
    ((hζ.map_of_injective (RingHom.injective (algebraMap K (Q.adicCompletion K))))).map_of_injective hI
  obtain ⟨i, hi, hζi⟩ := hζ'.eq_pow_of_pow_eq_one hone
  refine ⟨algebraMap K (Q.adicCompletion K) (ζ ^ i) * (b : Q.adicCompletion K), ?_⟩
  rw [map_mul (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)]
  rw [map_pow (algebraMap K (Q.adicCompletion K))]
  rw [map_pow (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)]
  rw [← hb'def]
  have hζi' : (Commons.RingTheory.Henselian.adicCompletionMap Q q hq
      (algebraMap K (Q.adicCompletion K) ζ)) ^ i =
      (algebraMap L (q.adicCompletion L)) α / b' := hζi
  rw [hζi']
  rw [div_mul_cancel₀ _ hb'0]


/-! ## Propagation from the root to the whole Kummer field -/

/-- **If the image of a generator lies in the image of the base change, so does everything.**

Let `L = K⟮α⟯` be an intermediate field, `q` a prime of `L` over `Q`, and regard `L_q` as a
`K_Q`-algebra via `adicCompletionMap`.  If the image of `α` in `L_q` lies in the image of `K_Q`,
then the image of every element of `L` does: the preimage of the subfield
`range (adicCompletionMap)` under `L → L_q` is a subfield of `L` containing `K` and `α`. -/
theorem range_algebraMap_subset_range_adicCompletionMap
    {K K' : Type*} [Field K] [NumberField K] [Field K'] [Algebra K K']
    (L : IntermediateField K K') [FiniteDimensional K L] [NumberField ↥L]
    {α : K'} (hαL : α ∈ L) (hgen : L.toSubalgebra = Algebra.adjoin K ({α} : Set K'))
    (Q : NK.Chebotarev.PrimeIdeal K) (q : NK.Chebotarev.PrimeIdeal ↥L)
    (hq : q.asIdeal.LiesOver Q.asIdeal)
    (hθ : algebraMap ↥L (q.adicCompletion ↥L) (⟨α, hαL⟩ : ↥L) ∈
      Set.range (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)) :
    Set.range (algebraMap ↥L (q.adicCompletion ↥L)) ⊆
      Set.range (Commons.RingTheory.Henselian.adicCompletionMap Q q hq) := by
  classical
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion ↥L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  haveI hST : IsScalarTower K (Q.adicCompletion K) (q.adicCompletion ↥L) :=
    Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion Q q hq
  have hkey : ∀ (y : K') (hy : y ∈ Algebra.adjoin K ({α} : Set K')) (hyL : y ∈ L),
      algebraMap ↥L (q.adicCompletion ↥L) (⟨y, hyL⟩ : ↥L) ∈
        (Commons.RingTheory.Henselian.adicCompletionMap Q q hq).fieldRange := by
    intro y hy
    refine Algebra.adjoin_induction (s := ({α} : Set K'))
      (p := fun z _ => ∀ (hzL : z ∈ L),
        algebraMap ↥L (q.adicCompletion ↥L) (⟨z, hzL⟩ : ↥L) ∈
          (Commons.RingTheory.Henselian.adicCompletionMap Q q hq).fieldRange)
      ?_ ?_ ?_ ?_ hy
    · intro z hz hzL
      have hzα : z = α := Set.mem_singleton_iff.mp hz
      obtain ⟨u, hu⟩ := hθ
      refine RingHom.mem_fieldRange.mpr ⟨u, ?_⟩
      rw [hu]
      rw [show (⟨z, hzL⟩ : ↥L) = ⟨α, hαL⟩ from Subtype.ext hzα]
    · intro r hrL
      refine RingHom.mem_fieldRange.mpr ⟨algebraMap K (Q.adicCompletion K) r, ?_⟩
      rw [← RingHom.algebraMap_toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)]
      rw [← IsScalarTower.algebraMap_apply K (Q.adicCompletion K) (q.adicCompletion ↥L) r]
      rw [show (⟨algebraMap K K' r, hrL⟩ : ↥L) = algebraMap K ↥L r from Subtype.ext rfl]
      rw [← IsScalarTower.algebraMap_apply K ↥L (q.adicCompletion ↥L) r]
    · intro z w hz hw ihz ihw hzwL
      have hzL : z ∈ L := by
        have h := hz; rwa [← hgen] at h
      have hwL : w ∈ L := by
        have h := hw; rwa [← hgen] at h
      have h1 : (⟨z + w, hzwL⟩ : ↥L) = ⟨z, hzL⟩ + ⟨w, hwL⟩ := Subtype.ext rfl
      rw [h1, map_add]
      exact Subfield.add_mem _ (ihz hzL) (ihw hwL)
    · intro z w hz hw ihz ihw hzwL
      have hzL : z ∈ L := by
        have h := hz; rwa [← hgen] at h
      have hwL : w ∈ L := by
        have h := hw; rwa [← hgen] at h
      have h1 : (⟨z * w, hzwL⟩ : ↥L) = ⟨z, hzL⟩ * ⟨w, hwL⟩ := Subtype.ext rfl
      rw [h1, map_mul]
      exact Subfield.mul_mem _ (ihz hzL) (ihw hwL)
  rintro y ⟨x, rfl⟩
  have hx' : (x : K') ∈ Algebra.adjoin K ({α} : Set K') := by
    have h : (x : K') ∈ L.toSubalgebra := x.2
    rwa [hgen] at h
  have hmem := hkey (x : K') hx' x.2
  exact Set.mem_range.mpr (RingHom.mem_fieldRange.mp hmem)

/-! ## The image of `L` spans `L_q` over `K_Q` -/

/-- **The image of `L` in `L_q` spans `L_q` over `K_Q`.**

The image of `L` in its completion `L_q` is dense, and it is contained in the `K_Q`-span `V` of the
image; being a subspace of the finite-dimensional `K_Q`-space `L_q`, `V` is finite-dimensional,
hence closed, hence all of `L_q`. -/
theorem span_range_algebraMap_adicCompletion_eq_top {K L : Type*} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    (Q : NK.Chebotarev.PrimeIdeal K) (q : NK.Chebotarev.PrimeIdeal L)
    (hq : q.asIdeal.LiesOver Q.asIdeal) :
    letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
    Submodule.span (Q.adicCompletion K)
      (Set.range (algebraMap L (q.adicCompletion L))) = ⊤ := by
  letI : Algebra (Q.adicCompletion K) (q.adicCompletion L) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap Q q hq)
  haveI : IsScalarTower K (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion Q q hq
  have hcont : Continuous (algebraMap (Q.adicCompletion K) (q.adicCompletion L)) :=
    Commons.RingTheory.Henselian.adicCompletionMap_continuous Q q hq
  haveI : ContinuousSMul (Q.adicCompletion K) (q.adicCompletion L) :=
    continuousSMul_of_algebraMap (Q.adicCompletion K) (q.adicCompletion L) hcont
  haveI : Module.Finite (Q.adicCompletion K) (q.adicCompletion L) :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
  have hdense : DenseRange (algebraMap L (q.adicCompletion L)) :=
    IsDedekindDomain.HeightOneSpectrum.denseRange_algebraMap (R := NumberField.RingOfIntegers L) L q
  have hc : IsClosed ((Submodule.span (Q.adicCompletion K)
      (Set.range (algebraMap L (q.adicCompletion L))) : Set (q.adicCompletion L))) :=
    Submodule.closed_of_finiteDimensional (𝕜 := Q.adicCompletion K) _
  have h2 : closure (Set.range (algebraMap L (q.adicCompletion L))) = Set.univ :=
    Set.eq_univ_of_forall hdense
  have h1 : ((Submodule.span (Q.adicCompletion K)
      (Set.range (algebraMap L (q.adicCompletion L))) : Submodule (Q.adicCompletion K) _)
      : Set (q.adicCompletion L)) = Set.univ := by
    refine Set.univ_subset_iff.mp ?_
    rw [← h2, ← hc.closure_eq]
    exact closure_mono Submodule.subset_span
  exact SetLike.ext'_iff.mpr h1

/-! ## The local degree of a Kummer extension at a prime -/

/-- **The local Kummer dichotomy.**

For a number field `K`, a prime `ℓ`, a primitive `ℓ`-th root of unity `ζ ∈ K`, a unit `a ∈ Kˣ` and
the Kummer field `L = K(a^{1/ℓ})` inside a separable closure `K'`, the prime `𝔭` splits completely
in `L` (equivalently: all the primes of `L` above `𝔭` have local degree `e·f = 1`) if and only if
`a` is an `ℓ`-th power in the completion `K_𝔭`. -/
theorem localDeg_kummerField_eq_one_iff {K K' : Type*} [Field K] [NumberField K] [Field K']
    [Algebra K K'] [IsSepClosure K K'] (ℓ : ℕ) (hℓ : ℓ.Prime)
    {ζ : K} (hζ : IsPrimitiveRoot ζ ℓ) (a : Kˣ)
    (L : IntermediateField K K') [FiniteDimensional K L] [NumberField ↥L]
    (hL : L = NK.LocalAnabelian.kummerField (K' := K') ℓ a)
    (𝔭 : NK.Chebotarev.PrimeIdeal K) :
    (∀ P : NK.Chebotarev.PrimeIdeal ↥L, P.asIdeal.LiesOver 𝔭.asIdeal →
        NK.UchidaKummer.localDeg P 𝔭 = 1) ↔
      ∃ b : (𝔭.adicCompletion K)ˣ,
        algebraMap K (𝔭.adicCompletion K) (a : K) = (b : 𝔭.adicCompletion K) ^ ℓ := by
  classical
  obtain ⟨α, hα⟩ := exists_pow_eq_algebraMap_of_isSepClosure (k := K) (K' := K') ℓ hℓ hζ a
  have hαL : α ∈ L := by
    rw [hL]; exact NK.LocalAnabelian.mem_kummerField_of_pow_eq hα
  have hgen : L = K⟮α⟯ := hL.trans (kummerField_eq_adjoin_simple ℓ hℓ hζ a hα)
  have hsub : L.toSubalgebra = Algebra.adjoin K ({α} : Set K') := by
    rw [hgen]
    exact IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (IsIntegral.of_pow hℓ.pos (by rw [hα]; exact isIntegral_algebraMap)).isAlgebraic
  have hαL' : (⟨α, hαL⟩ : ↥L) ^ ℓ = algebraMap K ↥L (a : K) := by
    apply Subtype.ext
    push_cast
    exact hα
  constructor
  · -- `⇒`: a prime of local degree one forces `a` to be a local `ℓ`-th power
    intro hloc
    obtain ⟨P, hP⟩ := Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver
      (K := K) (L := ↥L) 𝔭
    letI : Algebra (𝔭.adicCompletion K) (P.adicCompletion ↥L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 P hP)
    haveI hST : IsScalarTower K (𝔭.adicCompletion K) (P.adicCompletion ↥L) :=
      Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion 𝔭 P hP
    have hef : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) *
        P.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) = 1 := by
      have h := hloc P hP
      rwa [NK.UchidaKummer.localDeg] at h
    have hfr : Module.finrank (𝔭.adicCompletion K) (P.adicCompletion ↥L) = 1 := by
      rw [← Commons.NumberTheory.NumberField.Completion.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg 𝔭 P hP,
        hef]
    have hsurj : Function.Surjective
        (algebraMap (𝔭.adicCompletion K) (P.adicCompletion ↥L)) :=
      (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp hfr).2
    have hθ : (algebraMap ↥L (P.adicCompletion ↥L) (⟨α, hαL⟩ : ↥L)) ^ ℓ =
        algebraMap (𝔭.adicCompletion K) (P.adicCompletion ↥L)
          (algebraMap K (𝔭.adicCompletion K) (a : K)) := by
      rw [← map_pow, hαL']
      rw [← IsScalarTower.algebraMap_apply K ↥L (P.adicCompletion ↥L) (a : K)]
      rw [IsScalarTower.algebraMap_apply K (𝔭.adicCompletion K) (P.adicCompletion ↥L) (a : K)]
    obtain ⟨c, hc⟩ := hsurj (algebraMap ↥L (P.adicCompletion ↥L) (⟨α, hαL⟩ : ↥L))
    have hcℓ : c ^ ℓ = algebraMap K (𝔭.adicCompletion K) (a : K) := by
      apply RingHom.injective (algebraMap (𝔭.adicCompletion K) (P.adicCompletion ↥L))
      rw [map_pow, hc, hθ]
    have hc0 : c ≠ 0 := by
      intro h0
      rw [h0, zero_pow hℓ.ne_zero] at hcℓ
      exact (Units.ne_zero a)
        (RingHom.injective (algebraMap K (𝔭.adicCompletion K)) hcℓ.symm)
    exact ⟨Units.mk0 c hc0, by rw [Units.val_mk0]; exact hcℓ.symm⟩
  · -- `⇐`: a local `ℓ`-th power forces every prime above `𝔭` to have local degree one
    rintro ⟨b, hb⟩ P hP
    letI : Algebra (𝔭.adicCompletion K) (P.adicCompletion ↥L) :=
      RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 P hP)
    haveI hST : IsScalarTower K (𝔭.adicCompletion K) (P.adicCompletion ↥L) :=
      Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion 𝔭 P hP
    have hθ : algebraMap ↥L (P.adicCompletion ↥L) (⟨α, hαL⟩ : ↥L) ∈
        Set.range (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 P hP) :=
      algebraMap_mem_range_adicCompletionMap_of_pow_eq 𝔭 P hP ℓ hℓ hζ hb hαL'
    have hset : Set.range (algebraMap ↥L (P.adicCompletion ↥L)) ⊆
        Set.range (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 P hP) :=
      range_algebraMap_subset_range_adicCompletionMap L hαL hsub 𝔭 P hP hθ
    have hspan := span_range_algebraMap_adicCompletion_eq_top 𝔭 P hP
    have htop : LinearMap.range
        (Algebra.linearMap (𝔭.adicCompletion K) (P.adicCompletion ↥L)) = ⊤ := by
      refine top_le_iff.mp ?_
      rw [← hspan]
      refine le_trans (Submodule.span_mono hset) ?_
      refine Submodule.span_le.mpr ?_
      intro y hy
      obtain ⟨u, hu⟩ := hy
      exact ⟨u, by
        rw [Algebra.linearMap_apply, RingHom.algebraMap_toAlgebra]
        exact hu⟩
    have hsurj : Function.Surjective
        (algebraMap (𝔭.adicCompletion K) (P.adicCompletion ↥L)) := by
      intro y
      have hy : y ∈ LinearMap.range
          (Algebra.linearMap (𝔭.adicCompletion K) (P.adicCompletion ↥L)) :=
        htop ▸ Submodule.mem_top
      obtain ⟨u, hu⟩ := LinearMap.mem_range.mp hy
      exact ⟨u, by rw [← Algebra.linearMap_apply]; exact hu⟩
    have hfr : Module.finrank (𝔭.adicCompletion K) (P.adicCompletion ↥L) = 1 :=
      Algebra.finrank_eq_one_iff_bijective_algebraMap.mpr
        ⟨(by rw [RingHom.algebraMap_toAlgebra]; exact RingHom.injective _), hsurj⟩
    have hef : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) *
        P.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) = 1 := by
      rw [Commons.NumberTheory.NumberField.Completion.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg 𝔭 P hP,
        hfr]
    rwa [NK.UchidaKummer.localDeg]

end NK.UchidaKummer.Kummer
