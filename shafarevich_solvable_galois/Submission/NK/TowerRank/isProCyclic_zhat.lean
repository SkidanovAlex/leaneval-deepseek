open ProfiniteGrp

/-! ## The canonical generator of `Ẑ` -/

/-- The canonical map `ℤ → Ẑ` (the dense copy of `ℤ` inside `Ẑ`), as a monoid homomorphism. -/
abbrev zEta : Multiplicative ℤ →* NK.LocalAnabelian.Zhat :=
  CategoryTheory.ConcreteCategory.hom
    (ProfiniteGrp.ProfiniteCompletion.eta (GrpCat.of (Multiplicative ℤ)))

/-- The canonical generator `1` of `Ẑ`. -/
def zhatGen : NK.LocalAnabelian.Zhat := zEta (Multiplicative.ofAdd 1)

/-- The canonical copy of `ℤ` inside `Ẑ` has dense range. -/
lemma zEta_denseRange : DenseRange zEta :=
  ProfiniteGrp.ProfiniteCompletion.denseRange (GrpCat.of (Multiplicative ℤ))

/-- The canonical generator of `Ẑ` raised to the `k`-th power is the image of `k`. -/
lemma eta_eq_pow (k : ℤ) : zEta (Multiplicative.ofAdd k) = zhatGen ^ k := by
  have h : Multiplicative.ofAdd k = (Multiplicative.ofAdd 1 : Multiplicative ℤ) ^ k := by
    rw [← Int.ofAdd_mul 1 k, one_mul]
  rw [h, map_zpow]
  rfl

/-- The range of `ℤ → Ẑ` is the cyclic subgroup generated by `zhatGen`. -/
lemma range_zEta : Set.range zEta = (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat) := by
  ext x
  constructor
  · rintro ⟨m, rfl⟩
    rw [← ofAdd_toAdd m, eta_eq_pow]
    rw [SetLike.mem_coe, Subgroup.mem_zpowers_iff]
    exact ⟨Multiplicative.toAdd m, rfl⟩
  · intro hx
    have hx' : x ∈ Subgroup.zpowers zhatGen := hx
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.mp hx'
    exact ⟨Multiplicative.ofAdd k, eta_eq_pow k⟩

/-- **`zhatGen` is a topological generator of `Ẑ`**: the closure of the cyclic subgroup it
generates is everything. -/
lemma closure_zpowers_zhatGen :
    closure (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat) = ⊤ := by
  have h : closure (Set.range zEta) = ⊤ := zEta_denseRange.closure_eq
  rwa [range_zEta] at h

/-! ## `Ẑ` is commutative -/

/-- Every element of `Ẑ` commutes with every element of the dense copy of `ℤ`. -/
lemma commute_zEta (x : NK.LocalAnabelian.Zhat) (a : Multiplicative ℤ) :
    x * zEta a = zEta a * x := by
  have h : (fun t : NK.LocalAnabelian.Zhat => t * zEta a) =
      (fun t : NK.LocalAnabelian.Zhat => zEta a * t) := by
    refine zEta_denseRange.equalizer ?_ ?_ ?_
    · exact continuous_id.mul continuous_const
    · exact continuous_const.mul continuous_id
    · funext b
      simp only [Function.comp_apply]
      rw [← map_mul, ← map_mul, mul_comm b a]
  exact congrFun h x

/-- **`Ẑ` is commutative.** -/
lemma zhat_mul_comm (x y : NK.LocalAnabelian.Zhat) : x * y = y * x := by
  have h : (fun t : NK.LocalAnabelian.Zhat => x * t) =
      (fun t : NK.LocalAnabelian.Zhat => t * x) := by
    refine zEta_denseRange.equalizer ?_ ?_ ?_
    · exact continuous_const.mul continuous_id
    · exact continuous_id.mul continuous_const
    · funext b
      simp only [Function.comp_apply]
      exact commute_zEta x b
  exact congrFun h y

/-- The commutative group structure on `Ẑ`. -/
instance instCommGroupZhat : CommGroup NK.LocalAnabelian.Zhat where
  mul_comm := zhat_mul_comm

/-! ## The subgroup of `n`-th powers -/

/-- The `n`-th power map `Ẑ → Ẑ`, `x ↦ x ^ n`, as an endomorphism. -/
def powHom (n : ℕ) : NK.LocalAnabelian.Zhat →* NK.LocalAnabelian.Zhat where
  toFun := fun x => x ^ n
  map_one' := one_pow n
  map_mul' := fun x y => mul_pow x y n

/-- The subgroup `Ẑ ^ n = {x ^ n : x ∈ Ẑ}` of `n`-th powers. -/
def powSubgroup (n : ℕ) : Subgroup NK.LocalAnabelian.Zhat := (powHom n).range

/-- The underlying set of `powSubgroup n` is the set of `n`-th powers. -/
lemma coe_powSubgroup (n : ℕ) :
    (powSubgroup n : Set NK.LocalAnabelian.Zhat) =
      Set.range (fun x : NK.LocalAnabelian.Zhat => x ^ n) := by
  rw [powSubgroup, MonoidHom.coe_range]
  rfl

/-- **The subgroup of `n`-th powers is closed**: it is the image of the compact group `Ẑ` under
the continuous power map. -/
lemma isClosed_powSubgroup (n : ℕ) : IsClosed (powSubgroup n : Set NK.LocalAnabelian.Zhat) := by
  rw [coe_powSubgroup]
  exact (isCompact_range (continuous_pow n)).isClosed

/-! ## `Ẑ ⧸ Ẑ ^ n` is cyclic -/

/-- The image of the canonical generator in `Ẑ ⧸ Ẑ ^ n` is a topological generator: the closure
of its `zpowers` is the whole quotient.  This is the density of `ℤ` inside `Ẑ` transported along
the (continuous, surjective) quotient map. -/
lemma closure_zpowers_mk_powSubgroup (n : ℕ) :
    closure (Subgroup.zpowers (QuotientGroup.mk' (powSubgroup n) zhatGen) :
      Set (NK.LocalAnabelian.Zhat ⧸ powSubgroup n)) = ⊤ := by
  have hcont : Continuous (QuotientGroup.mk' (powSubgroup n) :
      NK.LocalAnabelian.Zhat → NK.LocalAnabelian.Zhat ⧸ powSubgroup n) := by
    rw [QuotientGroup.coe_mk']; exact continuous_coinduced_rng
  have hsub : (QuotientGroup.mk' (powSubgroup n)) ''
        closure (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat) ⊆
      closure ((QuotientGroup.mk' (powSubgroup n)) ''
        (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat)) :=
    image_closure_subset_closure_image hcont
  have hclosure : closure (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat) = Set.univ := by
    rw [closure_zpowers_zhatGen, Set.top_eq_univ]
  have hsurj : Set.range (QuotientGroup.mk' (powSubgroup n)) = Set.univ :=
    Set.range_eq_univ.mpr (QuotientGroup.mk'_surjective (powSubgroup n))
  rw [hclosure, Set.image_univ, hsurj] at hsub
  have himg : (QuotientGroup.mk' (powSubgroup n)) ''
        (Subgroup.zpowers zhatGen : Set NK.LocalAnabelian.Zhat) =
      (Subgroup.zpowers (QuotientGroup.mk' (powSubgroup n) zhatGen) :
        Set (NK.LocalAnabelian.Zhat ⧸ powSubgroup n)) := by
    rw [← Subgroup.coe_map, MonoidHom.map_zpowers]
  rw [himg] at hsub
  exact Dense.closure_eq (fun y => hsub (Set.mem_univ y))

/-- **`Ẑ ⧸ Ẑ ^ n` is cyclic.**  The image of the canonical generator is a topological generator
whose `n`-th power is trivial, so its `zpowers` is finite, hence closed in the (Hausdorff)
quotient `Ẑ ⧸ Ẑ ^ n`, hence everything. -/
lemma isCyclic_quotient_powSubgroup (n : ℕ) (hn : 0 < n) :
    IsCyclic (NK.LocalAnabelian.Zhat ⧸ powSubgroup n) := by
  haveI : T1Space (NK.LocalAnabelian.Zhat ⧸ powSubgroup n) :=
    QuotientGroup.t1Space_iff.mpr (isClosed_powSubgroup n)
  have hmem : zhatGen ^ n ∈ powSubgroup n := by
    show zhatGen ^ n ∈ (powSubgroup n : Set NK.LocalAnabelian.Zhat)
    rw [coe_powSubgroup]
    exact ⟨zhatGen, rfl⟩
  have hxpow : (QuotientGroup.mk' (powSubgroup n) zhatGen) ^ n = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff (zhatGen ^ n)).mpr hmem
  have hfin : (Subgroup.zpowers (QuotientGroup.mk' (powSubgroup n) zhatGen) :
      Set (NK.LocalAnabelian.Zhat ⧸ powSubgroup n)).Finite := by
    refine IsOfFinOrder.finite_zpowers ?_
    rw [isOfFinOrder_iff_pow_eq_one]
    exact ⟨n, hn, hxpow⟩
  have hzpow : Subgroup.zpowers (QuotientGroup.mk' (powSubgroup n) zhatGen) = ⊤ := by
    refine SetLike.coe_injective ?_
    show ((Subgroup.zpowers (QuotientGroup.mk' (powSubgroup n) zhatGen) :
      Set (NK.LocalAnabelian.Zhat ⧸ powSubgroup n))) = ⊤
    rw [← hfin.isClosed.closure_eq, closure_zpowers_mk_powSubgroup n]
  exact isCyclic_iff_exists_zpowers_eq_top.mpr ⟨_, hzpow⟩

/-! ## The theorem -/

/-- **`Ẑ` is pro-cyclic**: every finite quotient of `Ẑ` is cyclic.

If `N ≤ Ẑ` has finite index `d`, then `x ^ d ∈ N` for every `x ∈ Ẑ` (in the finite quotient
`Ẑ ⧸ N`, of order `d`, every element has order dividing `d`).  So `powSubgroup d ≤ N`, and
`Ẑ ⧸ N` is a quotient of `Ẑ ⧸ powSubgroup d`, which is cyclic by
`isCyclic_quotient_powSubgroup`. -/
theorem isProCyclic_zhat : NK.LocalTame.IsProCyclic NK.LocalAnabelian.Zhat := by
  intro N hN hfi
  haveI : N.Normal := hN
  set d := N.index with hd
  have hdne : d ≠ 0 := hfi.index_ne_zero
  have hdpos : 0 < d := Nat.pos_of_ne_zero hdne
  have hle : powSubgroup d ≤ N := by
    intro z hz
    show z ∈ (N : Set NK.LocalAnabelian.Zhat)
    have hz' : z ∈ (powSubgroup d : Set NK.LocalAnabelian.Zhat) := hz
    rw [coe_powSubgroup] at hz'
    obtain ⟨y, rfl⟩ := hz'
    have hcard : Nat.card (NK.LocalAnabelian.Zhat ⧸ N) = d :=
      (Subgroup.index_eq_card N).symm
    have hord : orderOf (QuotientGroup.mk' N y) ∣ d := by
      rw [← hcard]
      exact orderOf_dvd_natCard _
    have hpow : (QuotientGroup.mk' N y) ^ d = 1 := orderOf_dvd_iff_pow_eq_one.mp hord
    have h2 : QuotientGroup.mk' N (y ^ d) = 1 := by rw [map_pow, hpow]
    exact (QuotientGroup.eq_one_iff (y ^ d)).mp h2
  haveI hcyc : IsCyclic (NK.LocalAnabelian.Zhat ⧸ powSubgroup d) :=
    isCyclic_quotient_powSubgroup d hdpos
  have hle' : powSubgroup d ≤ Subgroup.comap (MonoidHom.id NK.LocalAnabelian.Zhat) N := hle
  have hsurj : Function.Surjective
      (QuotientGroup.map (powSubgroup d) N (MonoidHom.id NK.LocalAnabelian.Zhat) hle') := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N q
    refine ⟨QuotientGroup.mk' (powSubgroup d) x, ?_⟩
    rw [QuotientGroup.map_mk']
    rfl
  exact isCyclic_of_surjective _ hsurj

end

end NK.TowerRank
