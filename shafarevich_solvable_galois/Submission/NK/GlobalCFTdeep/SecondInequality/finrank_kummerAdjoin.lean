variable {k K' : Type*} [Field k] [Field K'] [Algebra k K']

/-- The set of `p`-th roots in `K'` of the elements of a subgroup `T ≤ kˣ`. -/
def kummerRootSet (p : ℕ) (T : Subgroup kˣ) : Set K' :=
  {x : K' | ∃ a ∈ T, x ^ p = algebraMap k K' (a : k)}

/-- The Kummer extension of `k` in `K'` generated by the `p`-th roots of the elements
of a subgroup `T ≤ kˣ`. -/
noncomputable def kummerAdjoin (p : ℕ) (T : Subgroup kˣ) : IntermediateField k K' :=
  IntermediateField.adjoin k (kummerRootSet (K' := K') p T)

variable (p : ℕ)

lemma kummerRootSet_mono {T₁ T₂ : Subgroup kˣ} (h : T₁ ≤ T₂) :
    kummerRootSet (K' := K') p T₁ ⊆ kummerRootSet (K' := K') p T₂ := by
  rintro x ⟨a, ha, hx⟩
  exact ⟨a, h ha, hx⟩

lemma kummerAdjoin_mono {T₁ T₂ : Subgroup kˣ} (h : T₁ ≤ T₂) :
    kummerAdjoin (K' := K') p T₁ ≤ kummerAdjoin (K' := K') p T₂ := by
  rw [kummerAdjoin, kummerAdjoin, IntermediateField.adjoin_le_iff]
  exact fun x hx => IntermediateField.subset_adjoin k _
    (kummerRootSet_mono (K' := K') p h hx)

lemma le_kummerAdjoin (T : Subgroup kˣ) :
    kummerRootSet (K' := K') p T ⊆ ↑(kummerAdjoin (K' := K') p T) :=
  IntermediateField.subset_adjoin k _

/-- The `p`-th roots of a `p`-th power are generated by the `p`-th roots of the elements of
`T`: if `x ^ p = t * b ^ p` with `t ∈ T`, then `x / b` is a `p`-th root of `t`. -/
lemma kummerRootSet_sup_powSubgroup (T : Subgroup kˣ) :
    kummerRootSet (K' := K') p (T ⊔ powSubgroup p k) ⊆
      ↑(kummerAdjoin (K' := K') p T) := by
  rintro x ⟨a, ha, hx⟩
  rw [Subgroup.mem_sup] at ha
  obtain ⟨t, ht, u, hu, rfl⟩ := ha
  obtain ⟨b, hb⟩ := MonoidHom.mem_range.mp (show u ∈ (powMonoidHom p : kˣ →* kˣ).range from hu)
  rw [powMonoidHom_apply] at hb
  have htu : ((t * u : kˣ) : k) = (t : k) * ((b : k)) ^ p := by
    rw [← hb, Units.val_mul, Units.val_pow_eq_pow_val]
  have hb0 : algebraMap k K' (b : k) ≠ 0 := by
    simpa using (algebraMap k K').injective.ne (Units.ne_zero b)
  have hx' : (x * (algebraMap k K' (b : k))⁻¹) ^ p = algebraMap k K' (t : k) := by
    rw [mul_pow, inv_pow, hx, htu, map_mul, map_pow, mul_assoc,
      mul_inv_cancel₀ (pow_ne_zero p hb0), mul_one]
  have hmem : x * (algebraMap k K' (b : k))⁻¹ ∈ kummerAdjoin (K' := K') p T :=
    IntermediateField.subset_adjoin k _ (Set.mem_setOf.mpr ⟨t, ht, hx'⟩)
  have hbmem : algebraMap k K' (b : k) ∈ kummerAdjoin (K' := K') p T :=
    IntermediateField.algebraMap_mem _ _
  have hmul : x * (algebraMap k K' (b : k))⁻¹ * algebraMap k K' (b : k) = x := by
    rw [mul_assoc, inv_mul_cancel₀ hb0, mul_one]
  rw [← hmul]
  exact mul_mem hmem hbmem

lemma kummerAdjoin_sup_powSubgroup (T : Subgroup kˣ) :
    kummerAdjoin (K' := K') p (T ⊔ powSubgroup p k) = kummerAdjoin (K' := K') p T := by
  refine le_antisymm ?_ (kummerAdjoin_mono (K' := K') p le_sup_left)
  rw [kummerAdjoin, IntermediateField.adjoin_le_iff]
  exact kummerRootSet_sup_powSubgroup (K' := K') p T

lemma kummerAdjoin_eq_iSup_kummerField (T : Subgroup kˣ) :
    kummerAdjoin (K' := K') p T = ⨆ c : ↥T, kummerField (K' := K') p (c : kˣ) := by
  have hset : kummerRootSet (K' := K') p T
      = ⋃ c : ↥T, {x : K' | x ^ p = algebraMap k K' ((c : kˣ) : k)} := by
    ext x
    constructor
    · rintro ⟨a, ha, hx⟩
      exact Set.mem_iUnion.mpr ⟨⟨a, ha⟩, hx⟩
    · intro hx
      rw [Set.mem_iUnion] at hx
      obtain ⟨⟨a, ha⟩, hx⟩ := hx
      exact ⟨a, ha, hx⟩
  rw [kummerAdjoin, hset, IntermediateField.adjoin_iUnion]
  rfl

variable {p}

variable [IsSepClosure k K']

/-- A `p`-th root of `c ∈ T` lies in `k(T^{1/p})`. -/
theorem exists_root_mem_kummerAdjoin (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (T : Subgroup kˣ) (c : ↥T) :
    ∃ y : ↥(kummerAdjoin (K' := K') p T),
      y ^ p = algebraMap k ↥(kummerAdjoin (K' := K') p T) ((c : kˣ) : k) := by
  haveI : IsSepClosed K' := IsSepClosure.sep_closed k
  have hchar : p ≠ ringChar k := pow_ne_ringChar_of_isPrimitiveRoot p hp hζ
  have hpk : (p : k) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime (R := k) hp hchar.symm
  have hsep : (X ^ p - C ((c : kˣ) : k)).Separable := separable_X_pow_sub_C _ hpk (by simp)
  obtain ⟨α, hα⟩ := IsSepClosed.exists_aeval_eq_zero K' (X ^ p - C ((c : kˣ) : k))
    (by rw [degree_X_pow_sub_C hp.pos]; exact Nat.cast_ne_zero.mpr hp.ne_zero) hsep
  rw [aeval_def, eval₂_sub, eval₂_pow, eval₂_C, eval₂_X, sub_eq_zero] at hα
  exact ⟨⟨α, IntermediateField.subset_adjoin k _
    (Set.mem_setOf.mpr ⟨(c : kˣ), c.2, hα⟩)⟩, Subtype.ext hα⟩

/-- The Kummer field of an element of `kˣ` is the splitting field of `X ^ p - C a`, hence
Galois over `k` of degree `1` or `p`. -/
theorem isGalois_kummerField (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p) (a : kˣ) :
    IsGalois k ↥(kummerField (K' := K') p a) := by
  by_cases ha : a ∈ powSubgroup p k
  · rw [kummerField_eq_bot_of_mem_powSubgroup (K' := K') p hp hζ ha]
    infer_instance
  · exact (isGalois_kummerField_and_finrank (K' := K') p hp hζ a ha).1

/-- The Kummer field of an element of `kˣ` is finite dimensional over `k`. -/
theorem finiteDimensional_kummerField (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (a : kˣ) : FiniteDimensional k ↥(kummerField (K' := K') p a) := by
  haveI : IsSepClosed K' := IsSepClosure.sep_closed k
  have hchar : p ≠ ringChar k := pow_ne_ringChar_of_isPrimitiveRoot p hp hζ
  have hpk : (p : k) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime (R := k) hp hchar.symm
  have hsep : (X ^ p - C (a : k)).Separable := separable_X_pow_sub_C _ hpk (by simp)
  obtain ⟨α, hα⟩ := IsSepClosed.exists_aeval_eq_zero K' (X ^ p - C (a : k))
    (by rw [degree_X_pow_sub_C hp.pos]; exact Nat.cast_ne_zero.mpr hp.ne_zero) hsep
  rw [aeval_def, eval₂_sub, eval₂_pow, eval₂_C, eval₂_X, sub_eq_zero] at hα
  have hmap0 : algebraMap k K' (a : k) ≠ 0 := by
    simpa using (algebraMap k K').injective.ne (Units.ne_zero a)
  have hα0 : α ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.ne_zero] at hα
    exact hmap0 hα.symm
  have heq : kummerField (K' := K') p a = k⟮α⟯ := by
    refine le_antisymm ?_ ?_
    · rw [kummerField_le_iff]
      intro β hβ
      have h1 : (β / α) ^ p = 1 := by
        rw [div_pow, hβ, hα, div_self hmap0]
      obtain ⟨m, hm⟩ := exists_pow_eq_algebraMap_of_pow_eq_one p hp hζ h1
      have hβeq : β = algebraMap k K' (ζ ^ m) * α := by
        rw [hm, div_mul_cancel₀ β hα0]
      rw [hβeq]
      exact mul_mem (IntermediateField.algebraMap_mem _ (ζ ^ m))
        (mem_adjoin_simple_self k α)
    · rw [adjoin_simple_le_iff]
      exact mem_kummerField_of_pow_eq hα
  rw [heq]
  exact IntermediateField.adjoin.finiteDimensional
    (IsIntegral.of_pow hp.pos (by rw [hα]; exact isIntegral_algebraMap))

/-- `k(T^{1/p})` is a Galois extension of `k`. -/
theorem isGalois_kummerAdjoin (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (T : Subgroup kˣ) : IsGalois k ↥(kummerAdjoin (K' := K') p T) := by
  rw [kummerAdjoin_eq_iSup_kummerField]
  haveI : ∀ c : ↥T, IsGalois k ↥(kummerField (K' := K') p (c : kˣ)) :=
    fun c => isGalois_kummerField (K' := K') hp hζ (c : kˣ)
  exact IsGalois.mk

/-- If `T` contains `(kˣ)^p` and `T/(kˣ)^p` is finite, then `k(T^{1/p})` is finite
dimensional over `k`. -/
theorem finiteDimensional_kummerAdjoin_of_finite (hp : p.Prime) {ζ : k}
    (hζ : IsPrimitiveRoot ζ p) (T : Subgroup kˣ) (_hPT : powSubgroup p k ≤ T)
    [Finite (↥T ⧸ (powSubgroup p k).subgroupOf T)] :
    FiniteDimensional k ↥(kummerAdjoin (K' := K') p T) := by
  haveI : Fintype (↥T ⧸ (powSubgroup p k).subgroupOf T) := Fintype.ofFinite _
  let V := ↥T ⧸ (powSubgroup p k).subgroupOf T
  let sec : V → ↥T := fun v => Quotient.out v
  have hsec : ∀ v : V, QuotientGroup.mk (sec v) = v := fun v => Quotient.out_eq v
  -- each coset of `(kˣ)^p` in `T` has the same Kummer field
  have hsame : ∀ c : ↥T, kummerField (K' := K') p (c : kˣ)
      = kummerField (K' := K') p ((sec (QuotientGroup.mk c) : ↥T) : kˣ) := by
    intro c
    have h1 : (QuotientGroup.mk c : V) = QuotientGroup.mk (sec (QuotientGroup.mk c)) :=
      (hsec (QuotientGroup.mk c)).symm
    rw [QuotientGroup.eq] at h1
    exact kummerField_eq_of_div_mem_powSubgroup (K' := K') p h1
  have hL : kummerAdjoin (K' := K') p T
      = ⨆ v : V, kummerField (K' := K') p ((sec v : ↥T) : kˣ) := by
    rw [kummerAdjoin_eq_iSup_kummerField]
    refine le_antisymm (iSup_le fun c => ?_) (iSup_le fun v => ?_)
    · exact (le_of_eq (hsame c)).trans
        (le_iSup (fun v : V => kummerField (K' := K') p ((sec v : ↥T) : kˣ))
          (QuotientGroup.mk c))
    · exact le_iSup (fun c : ↥T => kummerField (K' := K') p (c : kˣ)) (sec v)
  rw [hL]
  haveI : ∀ v : V, FiniteDimensional k ↥(kummerField (K' := K') p ((sec v : ↥T) : kˣ)) :=
    fun v => finiteDimensional_kummerField (K' := K') hp hζ _
  exact IntermediateField.finiteDimensional_iSup_of_finite

/-- If `x ^ p = y ^ p` and `y ≠ 0` in a field extension of `F` containing a primitive
`p`-th root of unity `ζ`, then `x / y` is the image of a power of `ζ`. -/
theorem exists_div_eq_algebraMap_of_pow_eq {F E : Type*} [Field F] [Field E] [Algebra F E]
    {p : ℕ} (hp : p.Prime) {ζ : F} (hζ : IsPrimitiveRoot ζ p) {x y : E} (h : x ^ p = y ^ p)
    (hy : y ≠ 0) : ∃ m : ℕ, x / y = algebraMap F E (ζ ^ m) := by
  have h1 : (x / y) ^ p = 1 := by rw [div_pow, h, div_self (pow_ne_zero p hy)]
  obtain ⟨m, hm⟩ := exists_pow_eq_algebraMap_of_pow_eq_one p hp hζ h1
  exact ⟨m, hm.symm⟩

/-- An `F`-algebra automorphism of `E` fixes `x / y` whenever `x ^ p = y ^ p ≠ 0`. -/
theorem algEquiv_div_eq_div_of_pow_eq {F E : Type*} [Field F] [Field E] [Algebra F E]
    {p : ℕ} (hp : p.Prime) {ζ : F} (hζ : IsPrimitiveRoot ζ p) (σ : E ≃ₐ[F] E) {x y : E}
    (h : x ^ p = y ^ p) (hy : y ≠ 0) : σ x / x = σ y / y := by
  obtain ⟨m, hm⟩ := exists_div_eq_algebraMap_of_pow_eq hp hζ h hy
  have hz0 : algebraMap F E (ζ ^ m) ≠ 0 := by
    simpa using (algebraMap F E).injective.ne (pow_ne_zero m (hζ.ne_zero hp.ne_zero))
  have hx : x = algebraMap F E (ζ ^ m) * y := (div_eq_iff hy).mp hm
  calc σ x / x = (algebraMap F E (ζ ^ m) * σ y) / (algebraMap F E (ζ ^ m) * y) := by
        rw [hx, map_mul, AlgEquiv.commutes]
    _ = σ y / y := mul_div_mul_left _ _ hz0

section Pairing

variable {p : ℕ} (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)

/-- A chosen `p`-th root in `k(T^{1/p})` of an element of a subgroup `T ≤ kˣ`. -/
noncomputable def kummerRoot (T : Subgroup kˣ) (c : ↥T) :
    ↥(kummerAdjoin (K' := K') p T) :=
  Classical.choose (exists_root_mem_kummerAdjoin (K' := K') hp hζ T c)

theorem kummerRoot_pow (T : Subgroup kˣ) (c : ↥T) :
    (kummerRoot (K' := K') hp hζ T c) ^ p
      = algebraMap k ↥(kummerAdjoin (K' := K') p T) ((c : kˣ) : k) :=
  Classical.choose_spec (exists_root_mem_kummerAdjoin (K' := K') hp hζ T c)

theorem algebraMap_kummerAdjoin_ne_zero (p : ℕ) (T : Subgroup kˣ) {x : k} (hx : x ≠ 0) :
    algebraMap k ↥(kummerAdjoin (K' := K') p T) x ≠ 0 := by
  simpa using (algebraMap k ↥(kummerAdjoin (K' := K') p T)).injective.ne hx

theorem kummerRoot_ne_zero (T : Subgroup kˣ) (c : ↥T) :
    kummerRoot (K' := K') hp hζ T c ≠ 0 := by
  intro h0
  have h2 := kummerRoot_pow (K' := K') hp hζ T c
  rw [h0, zero_pow hp.ne_zero] at h2
  exact algebraMap_kummerAdjoin_ne_zero (K' := K') p T (Units.ne_zero (c : kˣ)) h2.symm

/-- The Kummer pairing `(σ, c) ↦ σ(c^{1/p})/c^{1/p}`. -/
noncomputable def kummerTheta (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    ↥(kummerAdjoin (K' := K') p T) :=
  σ (kummerRoot (K' := K') hp hζ T c) / kummerRoot (K' := K') hp hζ T c

theorem kummerTheta_ne_zero (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    kummerTheta (K' := K') hp hζ T σ c ≠ 0 := by
  have h1 : σ (kummerRoot (K' := K') hp hζ T c) ≠ 0 := by
    simpa using (AlgEquiv.injective σ).ne (kummerRoot_ne_zero (K' := K') hp hζ T c)
  exact div_ne_zero h1 (kummerRoot_ne_zero (K' := K') hp hζ T c)

theorem kummerTheta_mul_right (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c d : ↥T) :
    kummerTheta (K' := K') hp hζ T σ (c * d)
      = kummerTheta (K' := K') hp hζ T σ c * kummerTheta (K' := K') hp hζ T σ d := by
  have hpow : (kummerRoot (K' := K') hp hζ T (c * d)) ^ p
      = (kummerRoot (K' := K') hp hζ T c * kummerRoot (K' := K') hp hζ T d) ^ p := by
    rw [kummerRoot_pow, mul_pow, kummerRoot_pow, kummerRoot_pow, ← map_mul]
    rfl
  calc kummerTheta (K' := K') hp hζ T σ (c * d)
      = σ (kummerRoot (K' := K') hp hζ T c * kummerRoot (K' := K') hp hζ T d)
          / (kummerRoot (K' := K') hp hζ T c * kummerRoot (K' := K') hp hζ T d) :=
        algEquiv_div_eq_div_of_pow_eq hp hζ σ hpow
          (mul_ne_zero (kummerRoot_ne_zero (K' := K') hp hζ T c)
            (kummerRoot_ne_zero (K' := K') hp hζ T d))
    _ = (σ (kummerRoot (K' := K') hp hζ T c) * σ (kummerRoot (K' := K') hp hζ T d))
          / (kummerRoot (K' := K') hp hζ T c * kummerRoot (K' := K') hp hζ T d) := by
        rw [map_mul]
    _ = kummerTheta (K' := K') hp hζ T σ c * kummerTheta (K' := K') hp hζ T σ d :=
        (div_mul_div_comm _ _ _ _).symm

theorem kummerTheta_one_right (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) :
    kummerTheta (K' := K') hp hζ T σ 1 = 1 := by
  have h : (kummerRoot (K' := K') hp hζ T (1 : ↥T)) ^ p = 1 := by
    rw [kummerRoot_pow]; simp
  obtain ⟨m, hm⟩ := exists_pow_eq_algebraMap_of_pow_eq_one p hp hζ h
  have hz0 : algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m) ≠ 0 :=
    algebraMap_kummerAdjoin_ne_zero (K' := K') p T (pow_ne_zero m (hζ.ne_zero hp.ne_zero))
  unfold kummerTheta
  rw [← hm, AlgEquiv.commutes, div_self hz0]

theorem kummerTheta_mul_left (T : Subgroup kˣ)
    (σ τ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    kummerTheta (K' := K') hp hζ T (σ * τ) c
      = kummerTheta (K' := K') hp hζ T σ c * kummerTheta (K' := K') hp hζ T τ c := by
  have hpow : (τ (kummerRoot (K' := K') hp hζ T c)) ^ p
      = (kummerRoot (K' := K') hp hζ T c) ^ p := by
    rw [← map_pow, kummerRoot_pow]
    exact AlgEquiv.commutes τ (((c : kˣ) : k))
  obtain ⟨m, hm⟩ := exists_div_eq_algebraMap_of_pow_eq (F := k) hp hζ hpow
    (kummerRoot_ne_zero (K' := K') hp hζ T c)
  have hτ : τ (kummerRoot (K' := K') hp hζ T c)
      = algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m) * kummerRoot (K' := K') hp hζ T c :=
    (div_eq_iff (kummerRoot_ne_zero (K' := K') hp hζ T c)).mp hm
  have hcomp : ∀ x : ↥(kummerAdjoin (K' := K') p T), (σ * τ) x = σ (τ x) := fun x => rfl
  calc kummerTheta (K' := K') hp hζ T (σ * τ) c
      = σ (τ (kummerRoot (K' := K') hp hζ T c)) / kummerRoot (K' := K') hp hζ T c := by
        unfold kummerTheta; rw [hcomp]
    _ = σ (algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m)
            * kummerRoot (K' := K') hp hζ T c) / kummerRoot (K' := K') hp hζ T c := by
        rw [hτ]
    _ = (algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m)
            * σ (kummerRoot (K' := K') hp hζ T c)) / kummerRoot (K' := K') hp hζ T c := by
        rw [map_mul, AlgEquiv.commutes]
    _ = algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m)
          * (σ (kummerRoot (K' := K') hp hζ T c) / kummerRoot (K' := K') hp hζ T c) := by
        rw [mul_div_assoc]
    _ = kummerTheta (K' := K') hp hζ T σ c * kummerTheta (K' := K') hp hζ T τ c := by
        unfold kummerTheta
        rw [hm, mul_comm]

theorem kummerTheta_one_left (T : Subgroup kˣ) (c : ↥T) :
    kummerTheta (K' := K') hp hζ T 1 c = 1 := by
  unfold kummerTheta
  rw [show (1 : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))
      (kummerRoot (K' := K') hp hζ T c) = kummerRoot (K' := K') hp hζ T c from rfl,
    div_self (kummerRoot_ne_zero (K' := K') hp hζ T c)]

/-- The Kummer pairing, with values in the units of `k(T^{1/p})`. -/
noncomputable def kummerThetaUnit (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    (↥(kummerAdjoin (K' := K') p T))ˣ :=
  Units.mk0 (kummerTheta (K' := K') hp hζ T σ c) (kummerTheta_ne_zero (K' := K') hp hζ T σ c)

theorem kummerThetaUnit_mul_right (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c d : ↥T) :
    kummerThetaUnit (K' := K') hp hζ T σ (c * d)
      = kummerThetaUnit (K' := K') hp hζ T σ c * kummerThetaUnit (K' := K') hp hζ T σ d := by
  apply Units.ext
  exact kummerTheta_mul_right (K' := K') hp hζ T σ c d

theorem kummerThetaUnit_one_right (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) :
    kummerThetaUnit (K' := K') hp hζ T σ 1 = 1 := by
  apply Units.ext
  exact kummerTheta_one_right (K' := K') hp hζ T σ

theorem kummerThetaUnit_mul_left (T : Subgroup kˣ)
    (σ τ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    kummerThetaUnit (K' := K') hp hζ T (σ * τ) c
      = kummerThetaUnit (K' := K') hp hζ T σ c * kummerThetaUnit (K' := K') hp hζ T τ c := by
  apply Units.ext
  exact kummerTheta_mul_left (K' := K') hp hζ T σ τ c

theorem kummerThetaUnit_one_left (T : Subgroup kˣ) (c : ↥T) :
    kummerThetaUnit (K' := K') hp hζ T 1 c = 1 := by
  apply Units.ext
  exact kummerTheta_one_left (K' := K') hp hζ T c

/-- For a fixed `σ : Gal(k(T^{1/p})/k)`, the assignment `c ↦ σ(c^{1/p})/c^{1/p}` is a
homomorphism `T → k(T^{1/p})ˣ`. -/
noncomputable def kummerCharRight (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) :
    ↥T →* (↥(kummerAdjoin (K' := K') p T))ˣ where
  toFun := kummerThetaUnit (K' := K') hp hζ T σ
  map_one' := kummerThetaUnit_one_right (K' := K') hp hζ T σ
  map_mul' := kummerThetaUnit_mul_right (K' := K') hp hζ T σ

theorem kummerCharRight_apply (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    kummerCharRight (K' := K') hp hζ T σ c = kummerThetaUnit (K' := K') hp hζ T σ c := rfl

/-- The Kummer pairing as a homomorphism `Gal(k(T^{1/p})/k) → Hom(T, k(T^{1/p})ˣ)`. -/
noncomputable def kummerPairing (T : Subgroup kˣ) :
    (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) →*
      (↥T →* (↥(kummerAdjoin (K' := K') p T))ˣ) where
  toFun := kummerCharRight (K' := K') hp hζ T
  map_one' := by
    ext c
    rw [kummerCharRight_apply, MonoidHom.one_apply, kummerThetaUnit_one_left]
  map_mul' σ τ := by
    ext c
    rw [kummerCharRight_apply, MonoidHom.mul_apply, kummerThetaUnit_mul_left]
    rfl

theorem kummerPairing_apply (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) (c : ↥T) :
    kummerPairing (K' := K') hp hζ T σ c = kummerThetaUnit (K' := K') hp hζ T σ c := rfl

/-- The pairing is trivial on `(kˣ)^p`: a `p`-th power has a `p`-th root in `k` itself,
which is fixed by every `k`-algebra automorphism. -/
theorem kummerTheta_eq_one_of_mem_powSubgroup (T : Subgroup kˣ)
    (σ : ↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) {c : ↥T}
    (hc : (c : kˣ) ∈ powSubgroup p k) : kummerTheta (K' := K') hp hζ T σ c = 1 := by
  obtain ⟨b, hb⟩ := MonoidHom.mem_range.mp (show (c : kˣ) ∈
    (powMonoidHom p : kˣ →* kˣ).range from hc)
  rw [powMonoidHom_apply] at hb
  have hbval : ((b ^ p : kˣ) : k) = (b : k) ^ p := Units.val_pow_eq_pow_val b p
  have hpow : (kummerRoot (K' := K') hp hζ T c) ^ p
      = (algebraMap k ↥(kummerAdjoin (K' := K') p T) (b : k)) ^ p := by
    rw [kummerRoot_pow, ← hb, hbval, map_pow]
  unfold kummerTheta
  rw [algEquiv_div_eq_div_of_pow_eq hp hζ σ hpow
      (algebraMap_kummerAdjoin_ne_zero (K' := K') p T (Units.ne_zero b)),
    AlgEquiv.commutes, div_self (algebraMap_kummerAdjoin_ne_zero (K' := K') p T (Units.ne_zero b))]

/-- The `p`-th power of a value of the Kummer pairing is `1`. -/
theorem kummerTheta_pow (T : Subgroup kˣ)
    (σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))) (c : ↥T) :
    (kummerTheta (K' := K') hp hζ T σ c) ^ p = 1 := by
  unfold kummerTheta
  rw [div_pow, ← map_pow, kummerRoot_pow, AlgEquiv.commutes,
    div_self (algebraMap_kummerAdjoin_ne_zero (K' := K') p T (Units.ne_zero (c : kˣ)))]

/-- Every element of `k(T^{1/p})` lies in the `k`-subfield generated by the chosen roots. -/
theorem mem_map_adjoin_kummerRoot (T : Subgroup kˣ) {y : K'}
    (hy : y ∈ kummerRootSet (K' := K') p T) :
    y ∈ IntermediateField.map (IntermediateField.val (kummerAdjoin (K' := K') p T))
      (IntermediateField.adjoin k (Set.range (kummerRoot (K' := K') hp hζ T))) := by
  obtain ⟨a, ha, hya⟩ := hy
  have hr : ((kummerRoot (K' := K') hp hζ T ⟨a, ha⟩ : ↥(kummerAdjoin (K' := K') p T)) : K') ^ p
      = algebraMap k K' (a : k) :=
    congrArg (fun z : ↥(kummerAdjoin (K' := K') p T) => (z : K'))
      (kummerRoot_pow (K' := K') hp hζ T ⟨a, ha⟩)
  have hy0 : y ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.ne_zero] at hya
    have hne : algebraMap k K' (a : k) ≠ 0 := by
      simpa using (algebraMap k K').injective.ne (Units.ne_zero a)
    exact hne hya.symm
  have hr0 : ((kummerRoot (K' := K') hp hζ T ⟨a, ha⟩ : ↥(kummerAdjoin (K' := K') p T)) : K') ≠ 0 := by
    intro h0
    exact kummerRoot_ne_zero (K' := K') hp hζ T ⟨a, ha⟩ (Subtype.ext h0)
  obtain ⟨m, hm⟩ := exists_div_eq_algebraMap_of_pow_eq (F := k) hp hζ (hya.trans hr.symm) hr0
  have hyeq : y = algebraMap k K' (ζ ^ m)
      * ((kummerRoot (K' := K') hp hζ T ⟨a, ha⟩ : ↥(kummerAdjoin (K' := K') p T)) : K') := by
    rw [← hm, div_mul_cancel₀ _ hr0]
  refine (IntermediateField.mem_map _).mpr ⟨algebraMap k ↥(kummerAdjoin (K' := K') p T) (ζ ^ m)
      * kummerRoot (K' := K') hp hζ T ⟨a, ha⟩, ?_, ?_⟩
  · exact mul_mem (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.subset_adjoin k _ ⟨⟨a, ha⟩, rfl⟩)
  · rw [map_mul, AlgHom.commutes]
    exact hyeq.symm

/-- The chosen `p`-th roots generate `k(T^{1/p})` over `k`. -/
theorem adjoin_kummerRoot_eq_top (T : Subgroup kˣ) :
    IntermediateField.adjoin k (Set.range (kummerRoot (K' := K') hp hζ T)) = ⊤ := by
  refine IntermediateField.map_injective (IntermediateField.val (kummerAdjoin (K' := K') p T)) ?_
  refine le_antisymm (IntermediateField.map_mono _ le_top) ?_
  have h1 : kummerAdjoin (K' := K') p T ≤
      IntermediateField.map (IntermediateField.val (kummerAdjoin (K' := K') p T))
        (IntermediateField.adjoin k (Set.range (kummerRoot (K' := K') hp hζ T))) := by
    change IntermediateField.adjoin k (kummerRootSet (K' := K') p T) ≤ _
    rw [IntermediateField.adjoin_le_iff]
    exact fun y hy => mem_map_adjoin_kummerRoot (K' := K') hp hζ T hy
  have h2 : IntermediateField.map (IntermediateField.val (kummerAdjoin (K' := K') p T))
      (⊤ : IntermediateField k ↥(kummerAdjoin (K' := K') p T)) ≤ kummerAdjoin (K' := K') p T := by
    intro y hy
    obtain ⟨x, -, rfl⟩ := (IntermediateField.mem_map ⊤).mp hy
    exact x.2
  exact le_trans h2 h1

/-- An automorphism fixing all chosen roots is trivial. -/
theorem eq_one_of_fixes_kummerRoot (T : Subgroup kˣ)
    (σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)))
    (h : ∀ c : ↥T, σ (kummerRoot (K' := K') hp hζ T c) = kummerRoot (K' := K') hp hζ T c) :
    σ = 1 := by
  have hfix : ∀ x ∈ IntermediateField.adjoin k (Set.range (kummerRoot (K' := K') hp hζ T)),
      σ x = x := fun x hx =>
    IntermediateField.adjoin_induction (F := k)
      (s := Set.range (kummerRoot (K' := K') hp hζ T))
      (p := fun x _ => σ x = x)
      (fun y hy => by
        obtain ⟨c, rfl⟩ := Set.mem_range.mp hy
        exact h c)
      (fun r => σ.commutes r)
      (fun y z hy hz ihy ihz => by rw [map_add, ihy, ihz])
      (fun y hy ihy => by rw [map_inv₀, ihy])
      (fun y z hy hz ihy ihz => by rw [map_mul, ihy, ihz]) hx
  refine AlgEquiv.ext fun x => hfix x ?_
  rw [adjoin_kummerRoot_eq_top (K' := K') hp hζ T]
  trivial

/-- The triviality of the Kummer pairing characterises the identity. -/
theorem kummerPairing_eq_one_iff (T : Subgroup kˣ)
    (σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))) :
    kummerPairing (K' := K') hp hζ T σ = 1 ↔ σ = 1 := by
  constructor
  · intro h
    refine eq_one_of_fixes_kummerRoot (K' := K') hp hζ T σ fun c => ?_
    have hc : kummerCharRight (K' := K') hp hζ T σ c = 1 := by
      have h1 : (kummerPairing (K' := K') hp hζ T σ) c
          = (1 : ↥T →* (↥(kummerAdjoin (K' := K') p T))ˣ) c := by rw [h]
      rwa [MonoidHom.one_apply] at h1
    have hθ : kummerTheta (K' := K') hp hζ T σ c = 1 :=
      congrArg (fun u : (↥(kummerAdjoin (K' := K') p T))ˣ =>
        (u : ↥(kummerAdjoin (K' := K') p T))) hc
    unfold kummerTheta at hθ
    exact (div_eq_one_iff_eq (kummerRoot_ne_zero (K' := K') hp hζ T c)).mp hθ
  · rintro rfl
    exact map_one _

/-- The pairing kills `(kˣ)^p ⊆ T`, so it descends to `T/(kˣ)^p`. -/
theorem kummerCharRight_kills (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    (σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))) :
    (powSubgroup p k).subgroupOf T ≤ (kummerCharRight (K' := K') hp hζ T σ).ker := by
  intro c hc
  rw [MonoidHom.mem_ker]
  apply Units.ext
  show kummerTheta (K' := K') hp hζ T σ c = 1
  exact kummerTheta_eq_one_of_mem_powSubgroup (K' := K') hp hζ T σ
    (Subgroup.mem_subgroupOf.mp hc)

/-- The pairing as a homomorphism on the quotient `T/(kˣ)^p`. -/
noncomputable def kummerPairingQuot (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) →*
      ((↥T ⧸ (powSubgroup p k).subgroupOf T) →* (↥(kummerAdjoin (K' := K') p T))ˣ) where
  toFun σ := QuotientGroup.lift ((powSubgroup p k).subgroupOf T)
    (kummerCharRight (K' := K') hp hζ T σ) (kummerCharRight_kills (K' := K') hp hζ T hPT σ)
  map_one' := by
    apply MonoidHom.ext
    intro v
    refine Quotient.inductionOn v (fun c => ?_)
    rw [QuotientGroup.lift_mk, MonoidHom.one_apply]
    exact kummerThetaUnit_one_left (K' := K') hp hζ T c
  map_mul' σ τ := by
    apply MonoidHom.ext
    intro v
    refine Quotient.inductionOn v (fun c => ?_)
    rw [QuotientGroup.lift_mk, MonoidHom.mul_apply, QuotientGroup.lift_mk, QuotientGroup.lift_mk]
    exact kummerThetaUnit_mul_left (K' := K') hp hζ T σ τ c

theorem kummerPairingQuot_apply_mk (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    (σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))) (c : ↥T) :
    kummerPairingQuot (K' := K') hp hζ T hPT σ (QuotientGroup.mk c)
      = kummerThetaUnit (K' := K') hp hζ T σ c :=
  QuotientGroup.lift_mk ((powSubgroup p k).subgroupOf T)
    (kummerCharRight_kills (K' := K') hp hζ T hPT σ) c

theorem kummerPairingQuot_injective (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    Function.Injective (kummerPairingQuot (K' := K') hp hζ T hPT) := by
  rw [← MonoidHom.ker_eq_bot_iff, Subgroup.eq_bot_iff_forall]
  intro σ hσ
  refine eq_one_of_fixes_kummerRoot (K' := K') hp hζ T σ fun c => ?_
  rw [MonoidHom.mem_ker] at hσ
  have h3 : kummerPairingQuot (K' := K') hp hζ T hPT σ (QuotientGroup.mk c) = 1 := by
    rw [hσ]
    rfl
  rw [kummerPairingQuot_apply_mk (K' := K') hp hζ T hPT σ c] at h3
  have h2 : kummerTheta (K' := K') hp hζ T σ c = 1 :=
    congrArg (fun u : (↥(kummerAdjoin (K' := K') p T))ˣ =>
      (u : ↥(kummerAdjoin (K' := K') p T))) h3
  unfold kummerTheta at h2
  exact (div_eq_one_iff_eq (kummerRoot_ne_zero (K' := K') hp hζ T c)).mp h2

/-- If the pairing annihilates `c ∈ T` on all of `Gal(k(T^{1/p})/k)`, then `c` is a
`p`-th power in `k`. -/
theorem mem_powSubgroup_of_kummerTheta_eq_one (T : Subgroup kˣ)
    [IsGalois k ↥(kummerAdjoin (K' := K') p T)]
    [FiniteDimensional k ↥(kummerAdjoin (K' := K') p T)] (c : ↥T)
    (h : ∀ σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)),
      kummerTheta (K' := K') hp hζ T σ c = 1) :
    (c : kˣ) ∈ powSubgroup p k := by
  have hfix : ∀ σ : (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)),
      σ (kummerRoot (K' := K') hp hζ T c) = kummerRoot (K' := K') hp hζ T c := by
    intro σ
    have hσ := h σ
    unfold kummerTheta at hσ
    exact (div_eq_one_iff_eq (kummerRoot_ne_zero (K' := K') hp hζ T c)).mp hσ
  have hmem : kummerRoot (K' := K') hp hζ T c ∈ IntermediateField.fixedField
      (⊤ : Subgroup (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T))) := by
    rw [IntermediateField.mem_fixedField_iff]
    intro σ _
    exact hfix σ
  rw [IsGalois.fixedField_top] at hmem
  rw [IntermediateField.mem_bot] at hmem
  obtain ⟨y, hy⟩ := hmem
  have hy0 : y ≠ 0 := by
    intro h0
    rw [h0, map_zero] at hy
    exact kummerRoot_ne_zero (K' := K') hp hζ T c hy.symm
  refine MonoidHom.mem_range.mpr ⟨Units.mk0 y hy0, ?_⟩
  rw [powMonoidHom_apply]
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_mk0]
  have h2 : algebraMap k ↥(kummerAdjoin (K' := K') p T) (y ^ p)
      = algebraMap k ↥(kummerAdjoin (K' := K') p T) (((c : kˣ)) : k) := by
    rw [map_pow, hy, kummerRoot_pow]
  exact (algebraMap k ↥(kummerAdjoin (K' := K') p T)).injective h2

/-- If the pairing annihilates a class on all of `Gal(k(T^{1/p})/k)`, then the class is
trivial. -/
theorem kummerPairingQuot_apply_eq_one_iff (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    [IsGalois k ↥(kummerAdjoin (K' := K') p T)]
    [FiniteDimensional k ↥(kummerAdjoin (K' := K') p T)]
    (v : ↥T ⧸ (powSubgroup p k).subgroupOf T)
    (h : ∀ σ, kummerPairingQuot (K' := K') hp hζ T hPT σ v = 1) : v = 1 := by
  obtain ⟨c, rfl⟩ := Quotient.exists_rep v
  rw [QuotientGroup.eq_one_iff]
  refine mem_powSubgroup_of_kummerTheta_eq_one (K' := K') hp hζ T c fun σ => ?_
  have h3 := h σ
  rw [kummerPairingQuot_apply_mk (K' := K') hp hζ T hPT σ c] at h3
  exact congrArg (fun u : (↥(kummerAdjoin (K' := K') p T))ˣ =>
    (u : ↥(kummerAdjoin (K' := K') p T))) h3

end Pairing

section Assembly

variable {p : ℕ} (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)

/-- The exponent of `T/(kˣ)^p` divides `p`. -/
theorem exponent_quotient_dvd (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    Monoid.exponent (↥T ⧸ (powSubgroup p k).subgroupOf T) ∣ p := by
  refine Monoid.exponent_dvd_of_forall_pow_eq_one fun v => ?_
  refine Quotient.inductionOn v (fun c => ?_)
  change ((QuotientGroup.mk' ((powSubgroup p k).subgroupOf T)) c) ^ p = 1
  rw [← map_pow]
  change (QuotientGroup.mk (c ^ p) : ↥T ⧸ (powSubgroup p k).subgroupOf T) = 1
  rw [QuotientGroup.eq_one_iff]
  exact Subgroup.mem_subgroupOf.mpr
    (MonoidHom.mem_range.mpr ⟨(c : kˣ), by rw [powMonoidHom_apply]; rfl⟩)

/-- The exponent of the range of the descended pairing divides `p`. -/
theorem exponent_range_dvd (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    Monoid.exponent (kummerPairingQuot (K' := K') hp hζ T hPT).range ∣ p := by
  refine Monoid.exponent_dvd_of_forall_pow_eq_one fun χ => ?_
  obtain ⟨σ, hσ⟩ := MonoidHom.mem_range.mp χ.2
  apply Subtype.ext
  apply MonoidHom.ext
  intro v
  obtain ⟨c, rfl⟩ := Quotient.exists_rep v
  simp only [Subgroup.coe_pow, Subgroup.coe_one, MonoidHom.pow_apply, MonoidHom.one_apply]
  rw [← hσ, kummerPairingQuot_apply_mk]
  exact Units.ext (by
    simp only [kummerThetaUnit, Units.val_pow_eq_pow_val, Units.val_mk0, Units.val_one]
    exact kummerTheta_pow (K' := K') hp hζ T σ c)

/-- The evaluation pairing `T/(kˣ)^p × Gal(k(T^{1/p})/k) → k(T^{1/p})ˣ`. -/
noncomputable def kummerPairingEval (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    (↥T ⧸ (powSubgroup p k).subgroupOf T) →*
      ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
        (↥(kummerAdjoin (K' := K') p T))ˣ) where
  toFun v :=
    { toFun := fun χ => χ.1 v
      map_one' := by simp
      map_mul' := fun a b => by simp [MonoidHom.mul_apply] }
  map_one' := by
    apply MonoidHom.ext
    intro χ
    exact map_one χ.1
  map_mul' u v := by
    apply MonoidHom.ext
    intro χ
    exact map_mul χ.1 u v

theorem kummerPairingEval_injective (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    [IsGalois k ↥(kummerAdjoin (K' := K') p T)]
    [FiniteDimensional k ↥(kummerAdjoin (K' := K') p T)] :
    Function.Injective (kummerPairingEval (K' := K') hp hζ T hPT) := by
  intro u v huv
  have h1 : u * v⁻¹ = 1 := by
    refine kummerPairingQuot_apply_eq_one_iff (K' := K') hp hζ T hPT (u * v⁻¹) fun σ => ?_
    have h3 : (kummerPairingQuot (K' := K') hp hζ T hPT σ) u
        = (kummerPairingQuot (K' := K') hp hζ T hPT σ) v :=
      congrArg (fun f : (kummerPairingQuot (K' := K') hp hζ T hPT).range →*
          (↥(kummerAdjoin (K' := K') p T))ˣ =>
        f ⟨kummerPairingQuot (K' := K') hp hζ T hPT σ, ⟨σ, rfl⟩⟩) huv
    show (kummerPairingQuot (K' := K') hp hζ T hPT σ) (u * v⁻¹) = 1
    rw [map_mul, MonoidHom.map_inv, h3]
    simp
  exact mul_inv_eq_one.mp h1

/-- If `k(T^{1/p})` is finite dimensional over `k`, then `T/(kˣ)^p` is finite. -/
theorem finite_quotient_of_moduleFinite (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    (hfin : Module.Finite k ↥(kummerAdjoin (K' := K') p T)) :
    Finite (↥T ⧸ (powSubgroup p k).subgroupOf T) := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI hEnoughP : HasEnoughRootsOfUnity ↥(kummerAdjoin (K' := K') p T) p :=
    ⟨⟨algebraMap k ↥(kummerAdjoin (K' := K') p T) ζ,
        hζ.map_of_injective (RingHom.injective _)⟩, inferInstance⟩
  haveI : FiniteDimensional k ↥(kummerAdjoin (K' := K') p T) := hfin
  haveI : IsGalois k ↥(kummerAdjoin (K' := K') p T) := isGalois_kummerAdjoin (K' := K') hp hζ T
  haveI : Finite (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k] ↥(kummerAdjoin (K' := K') p T)) :=
    Finite.of_injective
      (fun e => (e : ↥(kummerAdjoin (K' := K') p T) →ₐ[k] ↥(kummerAdjoin (K' := K') p T)))
      AlgEquiv.coe_toAlgHom_injective
  haveI : Finite (kummerPairingQuot (K' := K') hp hζ T hPT).range :=
    Finite.of_surjective (kummerPairingQuot (K' := K') hp hζ T hPT).rangeRestrict
      (MonoidHom.rangeRestrict_surjective _)
  haveI hEnoughR : HasEnoughRootsOfUnity ↥(kummerAdjoin (K' := K') p T)
      (Monoid.exponent (kummerPairingQuot (K' := K') hp hζ T hPT).range) :=
    HasEnoughRootsOfUnity.of_dvd _ (exponent_range_dvd (K' := K') hp hζ T hPT)
  haveI : Finite ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
      (↥(kummerAdjoin (K' := K') p T))ˣ) := by
    have h : Nat.card ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
        (↥(kummerAdjoin (K' := K') p T))ˣ) ≠ 0 := by
      rw [CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity _
        ↥(kummerAdjoin (K' := K') p T)]
      exact Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
    exact (Nat.card_ne_zero.mp h).2
  exact Finite.of_injective _ (kummerPairingEval_injective (K' := K') hp hζ T hPT)

/-- **The degree formula in the finite case.** -/
theorem finrank_eq_index_of_finite (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T)
    [Finite (↥T ⧸ (powSubgroup p k).subgroupOf T)] :
    Module.finrank k ↥(kummerAdjoin (K' := K') p T)
      = Nat.card (↥T ⧸ (powSubgroup p k).subgroupOf T) := by
  haveI hfd : FiniteDimensional k ↥(kummerAdjoin (K' := K') p T) :=
    finiteDimensional_kummerAdjoin_of_finite (K' := K') hp hζ T hPT
  haveI hgal : IsGalois k ↥(kummerAdjoin (K' := K') p T) :=
    isGalois_kummerAdjoin (K' := K') hp hζ T
  haveI : Fintype (↥T ⧸ (powSubgroup p k).subgroupOf T) := Fintype.ofFinite _
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI hEnoughP : HasEnoughRootsOfUnity ↥(kummerAdjoin (K' := K') p T) p :=
    ⟨⟨algebraMap k ↥(kummerAdjoin (K' := K') p T) ζ,
        hζ.map_of_injective (RingHom.injective _)⟩, inferInstance⟩
  set V := ↥T ⧸ (powSubgroup p k).subgroupOf T with hVdef
  have hinj : Function.Injective (kummerPairingQuot (K' := K') hp hζ T hPT) :=
    kummerPairingQuot_injective (K' := K') hp hζ T hPT
  haveI hEnoughV : HasEnoughRootsOfUnity ↥(kummerAdjoin (K' := K') p T) (Monoid.exponent V) :=
    HasEnoughRootsOfUnity.of_dvd _ (exponent_quotient_dvd T hPT)
  have hcardHomV : Nat.card (V →* (↥(kummerAdjoin (K' := K') p T))ˣ) = Nat.card V :=
    CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity V ↥(kummerAdjoin (K' := K') p T)
  haveI : Finite (V →* (↥(kummerAdjoin (K' := K') p T))ˣ) := by
    have h : Nat.card (V →* (↥(kummerAdjoin (K' := K') p T))ˣ) ≠ 0 := by
      rw [hcardHomV]
      exact Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
    exact (Nat.card_ne_zero.mp h).2
  have hle1 : Nat.card (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k]
      ↥(kummerAdjoin (K' := K') p T)) ≤ Nat.card V := by
    rw [← hcardHomV]
    exact Nat.card_le_card_of_injective _ hinj
  -- the reverse inequality
  have hRcard : Nat.card (kummerPairingQuot (K' := K') hp hζ T hPT).range
      = Nat.card (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k]
          ↥(kummerAdjoin (K' := K') p T)) :=
    Nat.card_congr
      { toFun := fun χ => Classical.choose χ.2
        invFun := fun σ => ⟨kummerPairingQuot (K' := K') hp hζ T hPT σ, ⟨σ, rfl⟩⟩
        left_inv := fun χ => Subtype.ext (Classical.choose_spec χ.2)
        right_inv := fun σ => hinj (Classical.choose_spec
          (show (kummerPairingQuot (K' := K') hp hζ T hPT σ)
            ∈ (kummerPairingQuot (K' := K') hp hζ T hPT).range from ⟨σ, rfl⟩)) }
  haveI hEnoughR : HasEnoughRootsOfUnity ↥(kummerAdjoin (K' := K') p T)
      (Monoid.exponent (kummerPairingQuot (K' := K') hp hζ T hPT).range) :=
    HasEnoughRootsOfUnity.of_dvd _ (exponent_range_dvd (K' := K') hp hζ T hPT)
  have hcardHomR : Nat.card ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
      (↥(kummerAdjoin (K' := K') p T))ˣ)
      = Nat.card (kummerPairingQuot (K' := K') hp hζ T hPT).range :=
    CommGroup.card_monoidHom_of_hasEnoughRootsOfUnity _ ↥(kummerAdjoin (K' := K') p T)
  haveI : Finite ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
      (↥(kummerAdjoin (K' := K') p T))ˣ) := by
    have h : Nat.card ((kummerPairingQuot (K' := K') hp hζ T hPT).range →*
        (↥(kummerAdjoin (K' := K') p T))ˣ) ≠ 0 := by
      rw [hcardHomR]
      exact Nat.card_ne_zero.mpr ⟨inferInstance, inferInstance⟩
    exact (Nat.card_ne_zero.mp h).2
  have hle2 : Nat.card V ≤ Nat.card (kummerPairingQuot (K' := K') hp hζ T hPT).range := by
    rw [← hcardHomR]
    exact Nat.card_le_card_of_injective _
      (kummerPairingEval_injective (K' := K') hp hζ T hPT)
  have hEq : Nat.card V = Nat.card (↥(kummerAdjoin (K' := K') p T) ≃ₐ[k]
      ↥(kummerAdjoin (K' := K') p T)) :=
    le_antisymm (by rw [← hRcard]; exact hle2) hle1
  rw [← IsGalois.card_aut_eq_finrank k ↥(kummerAdjoin (K' := K') p T)]
  exact hEq.symm

/-- **The degree formula.**  The degree of `k(T^{1/p})` over `k` is the index of `(kˣ)^p`
in `T·(kˣ)^p`. -/
theorem finrank_kummerAdjoin_of_le (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (T : Subgroup kˣ) (hPT : powSubgroup p k ≤ T) :
    Module.finrank k ↥(kummerAdjoin (K' := K') p T) = ((powSubgroup p k).subgroupOf T).index := by
  rw [Subgroup.index_eq_card]
  by_cases hV : Finite (↥T ⧸ (powSubgroup p k).subgroupOf T)
  · exact finrank_eq_index_of_finite (K' := K') hp hζ T hPT
  · have hcard : Nat.card (↥T ⧸ (powSubgroup p k).subgroupOf T) = 0 :=
      Nat.card_eq_zero.mpr (Or.inr (not_finite_iff_infinite.mp hV))
    rw [hcard, Module.finrank, Cardinal.toNat_eq_zero]
    right
    by_contra hlt
    rw [not_le] at hlt
    haveI : Module.Finite k ↥(kummerAdjoin (K' := K') p T) := Module.rank_lt_aleph0_iff.mp hlt
    exact hV (finite_quotient_of_moduleFinite (K' := K') hp hζ T hPT inferInstance)

end Assembly

end

end NK.GlobalCFTdeep.SecondInequality

namespace NK.GlobalCFTdeep.SecondInequality

open NK.LocalAnabelian (powSubgroup)

theorem finrank_kummerAdjoin {k K' : Type} [Field k] [Field K'] [Algebra k K'] [IsSepClosure k K'] {p : ℕ} (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p) (S : Subgroup kˣ) : Module.finrank k ↥(IntermediateField.adjoin k {x : K' | ∃ a ∈ S, x ^ p = algebraMap k K' (a : k)}) = ((NK.LocalAnabelian.powSubgroup p k).subgroupOf (S ⊔ NK.LocalAnabelian.powSubgroup p k)).index := by
  have h1 : IntermediateField.adjoin k {x : K' | ∃ a ∈ S, x ^ p = algebraMap k K' (a : k)}
      = kummerAdjoin (K' := K') p S := rfl
  rw [h1, ← kummerAdjoin_sup_powSubgroup (K' := K') p S]
  exact finrank_kummerAdjoin_of_le (K' := K') hp hζ (S ⊔ powSubgroup p k) le_sup_right

end NK.GlobalCFTdeep.SecondInequality
