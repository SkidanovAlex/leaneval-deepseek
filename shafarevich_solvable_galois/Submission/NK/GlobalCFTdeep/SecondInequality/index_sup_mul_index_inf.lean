/-!
# The modular index formula for subgroups of an abelian group

For subgroups `B ≤ A` of a commutative group `G` and any third subgroup `C`, the index `[A : B]`
factors as a product of the indices of the two "projections" of the pair `(B, A)` onto the
sublattice generated by `C`:

  `[(A ⊔ C) : (B ⊔ C)] * [(A ⊓ C) : (B ⊓ C)] = [A : B]`.

This is the index form of Dedekind's modular identity: in `ℤ` with `A = ℤ`, `B = 2ℤ`, `C = 3ℤ` we
get `1 * 2 = 2`.

The proof is a chain of the standard `relIndex` identities of Mathlib:

* `relIndex_sup_left` : `K.relIndex (K ⊔ H) = K.relIndex H` (second isomorphism theorem, `K` normal);
* `inf_relIndex_right` : `(H ⊓ K).relIndex K = H.relIndex K`;
* `relIndex_mul_relIndex` : `relIndex` is multiplicative in towers;
* Dedekind's modular law `sup_inf_assoc_of_le` : `(B ⊔ C) ⊓ A = B ⊔ (A ⊓ C)` when `B ≤ A`.
-/

namespace NK.GlobalCFTdeep.SecondInequality

theorem index_sup_mul_index_inf {G : Type} [CommGroup G] (A B C : Subgroup G) (hBA : B ≤ A) (h1 : ((B ⊔ C).subgroupOf (A ⊔ C)).FiniteIndex) (h2 : ((B ⊓ C).subgroupOf (A ⊓ C)).FiniteIndex) : ((B ⊔ C).subgroupOf (A ⊔ C)).index * ((B ⊓ C).subgroupOf (A ⊓ C)).index = (B.subgroupOf A).index := by
  -- Dedekind's modular law in the sublattice generated by `B ≤ A` and `C`.
  have hmod : (B ⊔ C) ⊓ A = B ⊔ (A ⊓ C) := by
    rw [sup_inf_assoc_of_le C hBA, inf_comm]
  -- `(B ⊔ C) ⊔ A = A ⊔ C`, since `B ≤ A`.
  have hA : (B ⊔ C) ⊔ A = A ⊔ C := by
    rw [sup_assoc, sup_comm C A, ← sup_assoc, sup_of_le_right hBA]
  -- Step 1: `[(A ⊔ C) : (B ⊔ C)] = [A : B ⊔ (A ⊓ C)]`.
  have key1 : (B ⊔ C).relIndex (A ⊔ C) = (B ⊔ (A ⊓ C)).relIndex A := by
    rw [← hA, Subgroup.relIndex_sup_left, ← hmod, Subgroup.inf_relIndex_right]
  -- Step 2: `[B ⊔ (A ⊓ C) : B] = [(A ⊓ C) : (B ⊓ C)]` (second isomorphism theorem).
  have key2 : B.relIndex (B ⊔ (A ⊓ C)) = (B ⊓ C).relIndex (A ⊓ C) := by
    have h : B ⊓ (A ⊓ C) = B ⊓ C := by rw [← inf_assoc, inf_of_le_left hBA]
    rw [Subgroup.relIndex_sup_left, ← Subgroup.inf_relIndex_right, h]
  -- Package the two steps with the multiplicativity of `relIndex` along `B ≤ B ⊔ (A ⊓ C) ≤ A`.
  show (B ⊔ C).relIndex (A ⊔ C) * (B ⊓ C).relIndex (A ⊓ C) = B.relIndex A
  rw [key1, ← key2, mul_comm]
  exact Subgroup.relIndex_mul_relIndex B (B ⊔ (A ⊓ C)) A le_sup_left (sup_le hBA inf_le_left)

end NK.GlobalCFTdeep.SecondInequality
