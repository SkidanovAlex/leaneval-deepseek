namespace NK.GlobalCFTdeep.SecondInequality

/-!
# A degree-one criterion from a large norm subgroup

If `D ≤ 𝕀 K` is a subgroup of the idèle group of `K` which is contained in the norm image
`N_{E/K} 𝕀 E` and which, together with the principal idèles `Kˣ`, generates all of `𝕀 K`, then
`[E : K] = 1`.

Indeed, mapping along the quotient map `𝕀 K → C_K = 𝕀 K ⧸ Kˣ` kills the principal idèles, so the
class group `C_K` is already generated by the classes of `D`; since `D ≤ N_{E/K} 𝕀 E`, the norm
class subgroup `N_{E/K} C_E` is all of `C_K`.  The first inequality of global class field theory
(`NK.GlobalCFTdeep.first_inequality_unconditional`) gives `[E : K] ≤ [C_K : N_{E/K} C_E] = 1`,
and `[E : K] ≥ 1` because `E` is a nontrivial finite extension.
-/

theorem finrank_eq_one_of_le_normImage {K E : Type} [Field K] [NumberField K] [Field E] [NumberField E] [Algebra K E] [FiniteDimensional K E] [IsGalois K E] [IsCyclic (E ≃ₐ[K] E)] (D : Subgroup (NK.GlobalCFT.Idele K)) (hD : D ≤ NK.GlobalCFT.Idele.normImage K E) (htop : (NK.GlobalCFT.Idele.principalSubgroup K) ⊔ D = ⊤) : Module.finrank K E = 1 := by
  -- The principal idèles lie in the kernel of the quotient map, so their image is trivial.
  have hker : (NK.GlobalCFT.Idele.principalSubgroup K).map
      (NK.GlobalCFT.IdeleClassGroup.mk K) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    rw [show (NK.GlobalCFT.IdeleClassGroup.mk K).ker
        = NK.GlobalCFT.Idele.principalSubgroup K from QuotientGroup.ker_mk' _]
  -- Hence the classes of `D` already generate `C_K`.
  have hmapD : D.map (NK.GlobalCFT.IdeleClassGroup.mk K) = ⊤ := by
    have h := congrArg (Subgroup.map (NK.GlobalCFT.IdeleClassGroup.mk K)) htop
    rw [Subgroup.map_sup, hker, bot_sup_eq] at h
    rw [h]
    rw [← MonoidHom.range_eq_map, MonoidHom.range_eq_top]
    exact NK.GlobalCFT.IdeleClassGroup.mk_surjective K
  -- Since `D ≤ N_{E/K} 𝕀 E`, the norm class subgroup is all of `C_K`.
  have hnorm : NK.GlobalCFT.Idele.normClassSubgroup K E = ⊤ := by
    rw [NK.GlobalCFT.Idele.normClassSubgroup]
    exact top_unique (hmapD ▸ Subgroup.map_mono hD)
  have hidx : (NK.GlobalCFT.Idele.normClassSubgroup K E).index = 1 := by
    rw [hnorm]; exact Subgroup.index_top
  -- The first inequality gives `[E : K] ≤ [C_K : N_{E/K} C_E] = 1`.
  have h1 : Module.finrank K E ≤ 1 := by
    rw [← hidx]
    exact NK.GlobalCFTdeep.first_inequality_unconditional (K := K) (L := E)
  have h2 : 1 ≤ Module.finrank K E := Module.finrank_pos
  omega

end NK.GlobalCFTdeep.SecondInequality
