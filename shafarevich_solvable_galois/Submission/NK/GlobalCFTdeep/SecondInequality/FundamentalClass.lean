/-!
# The class-formation axioms from the second inequality and Hasse's fundamental class

`NK.GlobalCFT.CohomologicalFieldAxiom K L` is the cohomological heart of global class field
theory.  This file derives it from

* `HeckeRegularity` (Hecke's theorem, the analytic input of the second inequality — via the first
  and second inequalities, the inflation–restriction sequence and the corestriction identity it
  gives `H¹(H, C_L) = 0` for every subgroup `H`);
* `NK.GlobalCFTdeep.HasseNormPrinciple` (the licensed local–global principle for norms);
* `HasseFundamentalClass` — **Hasse's fundamental class** (Milne, *Class Field Theory*,
  Remark 5.5 and Theorem VIII.4.7): `H²(L/K) ≅ Br(L/K)` is *cyclic of order* `[L:K]`, generated by
  the fundamental class.

The only classical input beyond Hecke's theorem and the norm principle is the last one; the
vanishing of `H¹` is *proved*, not assumed.  (Milne's proof of the order of `H²` passes through
the Brauer group and the fundamental exact sequence
`0 → Br(L/K) → ⨁_v Br(L_v/K_v) → ℚ/ℤ → 0`; that is exactly what `HasseFundamentalClass`
records.)
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField RestrictedProduct IsMulCommutative
open NumberField IsDedekindDomain
open CategoryTheory

noncomputable section

namespace NK.GlobalCFTdeep.SecondInequality

open NK.GlobalCFT

/-- **Hasse's fundamental class** (Milne, *Class Field Theory*, Remark 5.5 and Theorem VIII.4.7;
Neukirch, *Algebraic Number Theory*, V.5): for every finite Galois extension `L/K` of number
fields, `H²(Gal(L/K), C_L) ≅ Br(L/K)` is cyclic of order `[L:K]`, i.e. it has order `[L:K]` and
contains an element — the fundamental class `u_{L/K}` — of that order.

This is a specific classical theorem; it is the only part of the class-formation axioms that this
chapter does not prove (the vanishing of `H¹` is proved in `Unconditional.lean`). -/
structure HasseFundamentalClass : Prop where
  /-- the order of `H²(Gal(L/K), C_L)` is `[L:K]`. -/
  order : ∀ {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L],
    Nat.card (groupCohomology (IdeleClassGroup.rep K L) 2) = Nat.card (L ≃ₐ[K] L)
  /-- the fundamental class: an element of order `[L:K]`. -/
  fundamentalClass : ∀ {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L],
    ∃ α : groupCohomology (IdeleClassGroup.rep K L) 2, addOrderOf α = Nat.card (L ≃ₐ[K] L)

/-- **The class-formation axioms for every finite Galois extension of number fields**, from Hecke's
regularity, the licensed Hasse norm principle and Hasse's fundamental class. -/
theorem cohomologicalFieldAxiom_of_hasseFundamentalClass (hH : HeckeRegularity)
    (hhn : NK.GlobalCFTdeep.HasseNormPrinciple) (hfc : HasseFundamentalClass) {K L : Type}
    [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] :
    CohomologicalFieldAxiom K L where
  h1_trivial H := subsingleton_groupCohomology_one_res_ideleClassGroup hH hhn H
  h2_card H := by
    classical
    let K' : IntermediateField K L := IntermediateField.fixedField H
    haveI : NumberField ↥K' := inferInstance
    haveI : FiniteDimensional ↥K' L := inferInstance
    haveI : IsGalois ↥K' L := inferInstance
    have hiso := groupCohomology.mapIso (G := ↥H) (H := (L ≃ₐ[↥K'] L))
      (A := IdeleClassGroup.rep ↥K' L)
      (B := Rep.res H.subtype (IdeleClassGroup.rep K L))
      (IntermediateField.subgroupEquivAlgEquiv H) (LinearEquiv.refl ℤ _)
      (by intro g; rfl) 2
    have hcard : Nat.card (groupCohomology (Rep.res H.subtype (IdeleClassGroup.rep K L)) 2)
        = Nat.card (groupCohomology (IdeleClassGroup.rep ↥K' L) 2) :=
      Nat.card_congr hiso.toLinearEquiv.toEquiv
    rw [hcard, hfc.order (K := ↥K') (L := L)]
    exact (Nat.card_congr (IntermediateField.subgroupEquivAlgEquiv H).toEquiv).symm
  fundamentalClass := hfc.fundamentalClass

/-- **Artin's reciprocity law for every finite Galois extension**, from Hecke's regularity, the
licensed Hasse norm principle and Hasse's fundamental class: the canonical isomorphism
`C_K ⧸ N_{L/K}C_L ≅ Gal(L/K)ᵃᵇ`. -/
noncomputable def galoisReciprocity_of_hasseFundamentalClass (hH : HeckeRegularity)
    (hhn : NK.GlobalCFTdeep.HasseNormPrinciple) (hfc : HasseFundamentalClass) {K L : Type}
    [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] [Group.IsSolvable (L ≃ₐ[K] L)] : GaloisReciprocity K L :=
  galoisReciprocity_of_cohomologicalFieldAxiom
    (cohomologicalFieldAxiom_of_hasseFundamentalClass hH hhn hfc)

/-- **Artin's reciprocity law for abelian extensions**, from Hecke's regularity, the licensed
Hasse norm principle and Hasse's fundamental class. -/
noncomputable def artinReciprocity_of_hasseFundamentalClass (hH : HeckeRegularity)
    (hhn : NK.GlobalCFTdeep.HasseNormPrinciple) (hfc : HasseFundamentalClass) {K L : Type}
    [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    [IsGalois K L] [IsMulCommutative (L ≃ₐ[K] L)] : ArtinReciprocity K L :=
  artinReciprocity_of_cohomologicalFieldAxiom
    (cohomologicalFieldAxiom_of_hasseFundamentalClass hH hhn hfc)

end NK.GlobalCFTdeep.SecondInequality
