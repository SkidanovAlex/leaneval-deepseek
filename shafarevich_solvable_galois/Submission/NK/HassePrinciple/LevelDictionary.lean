open CategoryTheory
open scoped Pointwise

set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option linter.unusedSectionVars false

universe u

namespace NK.HassePrinciple

open NK.BrauerHasse

variable {K K' : Type u} [Field K] [Field K'] [Algebra K K'] [IsSepClosure K K']

/-! ## The fixed field of a generated subgroup -/

/-- The fixed field of the subgroup generated by two subgroups is the intersection of the two fixed
fields; the order-dual of `IntermediateField.fixingSubgroup_sup`. -/
theorem IntermediateField.fixedField_sup (V W : Subgroup Gal(K'/K)) :
    IntermediateField.fixedField (V ⊔ W) =
      IntermediateField.fixedField V ⊓ IntermediateField.fixedField W := by
  ext x
  rw [IntermediateField.mem_fixedField_iff, IntermediateField.mem_inf,
    IntermediateField.mem_fixedField_iff, IntermediateField.mem_fixedField_iff]
  refine ⟨fun h => ⟨fun v hv => h v (Subgroup.mem_sup_left hv),
    fun w hw => h w (Subgroup.mem_sup_right hw)⟩, ?_⟩
  rintro ⟨h1, h2⟩ σ hσ
  have hS : V ⊔ W ≤ MulAction.stabilizer Gal(K'/K) x :=
    sup_le (fun v hv => by rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]; exact h1 v hv)
      (fun w hw => by rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]; exact h2 w hw)
  have := hS hσ
  rwa [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at this

/-! ## Closedness of `V ⊔ Gal(K'/L)` -/

/-- For a closed subgroup `V` and a finite Galois intermediate field `L`, the subgroup
`V ⊔ Gal(K'/L)` is closed: it is the product `V · Gal(K'/L)` (the second factor being normal), i.e.
the continuous image of the compact set `V × Gal(K'/L)`. -/
theorem isClosed_sup_fixingSubgroup (V : Subgroup Gal(K'/K)) (hV : IsClosed (V : Set Gal(K'/K)))
    (L : FiniteGaloisIntermediateField K K') :
    IsClosed ((V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K)) : Set Gal(K'/K)) := by
  rw [Subgroup.mul_normal]
  exact ((hV.isCompact).mul
    (IntermediateField.fixingSubgroup_isClosed (L : IntermediateField K K')).isCompact).isClosed

/-- **The key identification of the level dictionary**: for a closed subgroup `V` and a finite Galois
intermediate field `L`, the subgroup `V ⊔ Gal(K'/L)` is the Galois group of the extension
`K'/(L ⊓ K'^V)`. -/
theorem sup_fixingSubgroup_eq_fixingSubgroup_inf (V : Subgroup Gal(K'/K))
    (hV : IsClosed (V : Set Gal(K'/K))) (L : FiniteGaloisIntermediateField K K') :
    (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K))
      = ((L : IntermediateField K K') ⊓ IntermediateField.fixedField V).fixingSubgroup := by
  have hcl := isClosed_sup_fixingSubgroup V hV L
  refine le_antisymm ?_ ?_
  · exact sup_le ((IntermediateField.le_iff_le (K := _) (H := V)).mp inf_le_right)
      (IntermediateField.fixingSubgroup_le inf_le_left)
  · intro σ hσ
    have hfix : IntermediateField.fixedField (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K)) =
        ((L : IntermediateField K K') ⊓ IntermediateField.fixedField V) := by
      rw [IntermediateField.fixedField_sup, InfiniteGalois.fixedField_fixingSubgroup
        (k := K) (K := K') (L := (L : IntermediateField K K')), inf_comm]
    have h2 : (IntermediateField.fixedField
        (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K))).fixingSubgroup
        = (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K)) :=
      InfiniteGalois.fixingSubgroup_fixedField ⟨_, hcl⟩
    rw [hfix] at h2
    rw [← h2]
    exact hσ

/-! ## The level group as a group of the level extension -/

/-- **Noether's second isomorphism theorem for the level group**: the level group is the quotient of
`V ⊔ Gal(K'/L)` by `Gal(K'/L)`.  This holds for every subgroup `V` (no closedness needed). -/
noncomputable def levelGroupMulEquivSup (V : Subgroup Gal(K'/K))
    (L : FiniteGaloisIntermediateField K K') :
    LevelGroup V L ≃*
      (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K)) ⧸
        (L.fixingSubgroup.subgroupOf (V ⊔ L.fixingSubgroup : Subgroup Gal(K'/K))) :=
  QuotientGroup.quotientInfEquivProdNormalQuotient V L.fixingSubgroup

/-- **The level group is a quotient of the Galois group of a number-field extension**: for a closed
subgroup `V`, the level group `V ⧸ (V ⊓ Gal(K'/L))` is the quotient of `Gal(K'/(L ⊓ K'^V))` by
`Gal(K'/L)`.  The base field `L ⊓ K'^V` contains `K` and is finite over it (`K` being a number
field, it is itself a number field, and `L` is finite over it), so `H²(LevelGroup V L, Z/p)` is a
cohomology group of an extension of number fields. -/
noncomputable def levelGroupMulEquivFixingSubgroup (V : Subgroup Gal(K'/K))
    (hV : IsClosed (V : Set Gal(K'/K))) (L : FiniteGaloisIntermediateField K K') :
    LevelGroup V L ≃*
      ((L : IntermediateField K K') ⊓ IntermediateField.fixedField V).fixingSubgroup ⧸
        (L.fixingSubgroup.subgroupOf ((L : IntermediateField K K') ⊓ IntermediateField.fixedField V).fixingSubgroup) := by
  rw [← sup_fixingSubgroup_eq_fixingSubgroup_inf V hV L]
  exact levelGroupMulEquivSup V L

/-- The restriction map `Gal(K'/K) →* Gal(L/K)` attached to a finite Galois intermediate field
`L` (the source of the canonical description of the level group as a subgroup of `Gal(L/K)`). -/
noncomputable abbrev levelRestrict (L : FiniteGaloisIntermediateField K K') : Gal(K'/K) →* Gal(↥L/K) :=
  AlgEquiv.restrictNormalHom (F := K) (E := (L : IntermediateField K K'))

/-- The restriction map `V →* Gal(L/K)`, whose range is the level group: the level group realised
inside the *finite* Galois group `Gal(L/K)`. -/
noncomputable abbrev levelRestrictHom (V : Subgroup Gal(K'/K))
    (L : FiniteGaloisIntermediateField K K') : ↥V →* Gal(↥L/K) :=
  (levelRestrict L).comp V.subtype

/-- The kernel of the restriction map is `V ⊓ Gal(K'/L)`, so the level group is its cokernel. -/
theorem levelRestrictHom_ker (V : Subgroup Gal(K'/K)) (L : FiniteGaloisIntermediateField K K') :
    (levelRestrictHom V L).ker = L.fixingSubgroup.subgroupOf V := by
  ext x
  rw [Subgroup.mem_subgroupOf, MonoidHom.mem_ker, IntermediateField.mem_fixingSubgroup_iff]
  change (x : Gal(K'/K)).restrictNormal (L : IntermediateField K K') = 1 ↔ _
  rw [AlgEquiv.restrictNormal_eq_one_iff]

/-- The range of the restriction map is `V.map Gal(K'/K) →* Gal(L/K)`. -/
theorem levelRestrictHom_range (V : Subgroup Gal(K'/K)) (L : FiniteGaloisIntermediateField K K') :
    (levelRestrictHom V L).range = V.map (levelRestrict L) := by
  rw [levelRestrictHom, MonoidHom.range_comp, Subgroup.range_subtype]

/-- **The level group is the Galois group of the finite extension `L/(L ⊓ K'^V)` of number
fields.**  This is the arithmetic form of the level dictionary: the level group is the image of `V`
under the restriction `Gal(K'/K) →* Gal(L/K)`, i.e. the subgroup of `Gal(L/K)` fixing exactly the
base field `L ⊓ K'^V`. -/
noncomputable def levelGroupMulEquivLevelGalois (V : Subgroup Gal(K'/K))
    (L : FiniteGaloisIntermediateField K K') :
    LevelGroup V L ≃*
      (↥L ≃ₐ[↥(IntermediateField.fixedField (V.map (levelRestrict L)))] ↥L) := by
  refine (QuotientGroup.quotientMulEquivOfEq (levelRestrictHom_ker V L).symm).trans ?_
  refine (QuotientGroup.quotientKerEquivRange (levelRestrictHom V L)).trans ?_
  have hfix : (IntermediateField.fixedField (V.map (levelRestrict L))).fixingSubgroup
      = (levelRestrictHom V L).range := by
    rw [levelRestrictHom_range]
    exact IntermediateField.fixingSubgroup_fixedField (H := V.map (levelRestrict L))
  exact (MulEquiv.subgroupCongr hfix).symm.trans (IntermediateField.fixingSubgroupEquiv _)

/-- The two descriptions of the base field of the level extension agree:
`L ⊓ K'^V = fixedField_{L/K}(V|_L)` (the fixed field of the image of `V` in `Gal(L/K)`). -/
theorem lift_fixedField_map_restrictNormalHom (V : Subgroup Gal(K'/K))
    (L : FiniteGaloisIntermediateField K K') :
    IntermediateField.lift (IntermediateField.fixedField (V.map (levelRestrict L)))
      = ((L : IntermediateField K K') ⊓ IntermediateField.fixedField V) := by
  rw [eq_comm, inf_comm]
  simpa only [levelRestrict] using
    InfiniteGalois.restrict_fixedField V (L : IntermediateField K K')

end NK.HassePrinciple
