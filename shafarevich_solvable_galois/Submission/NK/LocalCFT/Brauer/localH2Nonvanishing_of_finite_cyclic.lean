/-!
# `H²(G_κ, ℤ/p) ≠ 0` for `κ` a local field whose absolute Galois group is `ℤ/p`

This module combines the two halves that are already available in the workspace:

* `NK.LocalCFT.Brauer.localH2Nonvanishing_iff_finite`: when `F'/F` is a *finite* extension, the
  colimit `H²(G_F, ℤ/p)` (`NK.LocalCFT.LocalH2Nonvanishing`) is non-zero if and only if
  `H²(Gal(F'/F), ℤ/p)` is;
* `NK.LocalCFT.Brauer.exists_ne_zero_H2_of_finite_cyclic`: a finite cyclic group `G` of prime
  order `p` satisfies `∃ x : H²(G, ℤ/p), x ≠ 0`.

The only glue needed is that **a group generated by one element is commutative**: the second input
above is stated for `CommGroup`, while `F' ≃ₐ[F] F'` only carries its canonical `Group` structure
(automorphism groups of fields are not commutative in general).  Its commutativity, however, is a
short computation from the hypothesis `∀ x, x ∈ Subgroup.zpowers g`: both factors are integral
powers of the single generator `g`, and integral powers of a common element commute.

Thus `H²(Gal(F'/F), ℤ/p) ≠ 0` for a cyclic Galois extension of degree `p`, and hence
`H²(G_F, ℤ/p) ≠ 0` in the finite case.  This is the elementary `p`-cyclic case of the local Brauer
non-vanishing: no residue-characteristic or ramification hypothesis is involved, which is exactly
as it should be — `H²(G_κ, ℤ/p) ≅ ℤ/p` holds for *every* prime `p` and every local field `κ`.

Note that `IsSepClosure F F'` together with `FiniteDimensional F F'` forces `F' = F` (a separable
closure of `F` is separably closed, and a finite separably closed extension is trivial), so this
lemma is the degenerate finite case of the local Brauer input.  It is stated in the general shape
required by the caller and is completely non-vacuous: the group `F' ≃ₐ[F] F'` is trivial there and
`H²` of the trivial group is `ℤ/p ≠ 0`.
-/

universe u

namespace NK.LocalCFT.Brauer

set_option linter.style.haveILetI false

theorem localH2Nonvanishing_of_finite_cyclic {p : ℕ} [Fact p.Prime] {F F' : Type u} [Field F]
    [Field F'] [Algebra F F'] [IsSepClosure F F'] [FiniteDimensional F F']
    (g : F' ≃ₐ[F] F') (hg : ∀ x : F' ≃ₐ[F] F', x ∈ Subgroup.zpowers g)
    (hcard : Nat.card (F' ≃ₐ[F] F') = p) :
    NK.LocalCFT.LocalH2Nonvanishing p F F' := by
  -- `p` is non-zero, so `Nat.card` non-zero gives that the Galois group is finite.
  have hp : p ≠ 0 := (Fact.out : p.Prime).ne_zero
  haveI : Finite (F' ≃ₐ[F] F') := (Nat.card_ne_zero.mp (by rw [hcard]; exact hp)).2
  haveI : Fintype (F' ≃ₐ[F] F') := Fintype.ofFinite _
  -- A group generated by one element is commutative, so the canonical `Group` structure on
  -- `F' ≃ₐ[F] F'` can be refined to a `CommGroup` structure (with the *same* group law: the
  -- `toGroup` field below is `inferInstance`, so the type `H2 p (F' ≃ₐ[F] F')` is unchanged).
  letI : CommGroup (F' ≃ₐ[F] F') :=
    { (inferInstance : Group (F' ≃ₐ[F] F')) with
      mul_comm := by
        intro a b
        obtain ⟨m, hm⟩ := Subgroup.mem_zpowers_iff.mp (hg a)
        obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hg b)
        rw [← hm, ← hn, ← zpow_add, ← zpow_add, add_comm] }
  -- In the finite case the colimit `H²(G_F, ℤ/p)` is the single top level `H²(Gal(F'/F), ℤ/p)`.
  rw [NK.LocalCFT.Brauer.localH2Nonvanishing_iff_finite p]
  exact NK.LocalCFT.Brauer.exists_ne_zero_H2_of_finite_cyclic g hg hcard

end NK.LocalCFT.Brauer
