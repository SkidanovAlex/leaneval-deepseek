/-!
# The local Brauer computation at the real place: `H²(G_ℝ, ℤ/2) ≅ ℤ/2`

The sibling file `Submission/Work/LocalCFT/Brauer/localH2Nonvanishing_of_finite_cyclic.lean`
records the non-vanishing half of the local Brauer computation for a finite level `F'/F` with
cyclic Galois group of prime order `p`.  Here we record the *complete* computation — both halves of
`NK.BrauerHasse.LocalFieldBrauerCyclic` — for the smallest instance of that shape, namely the
degenerate local field `ℝ` with separable closure `ℂ` and `p = 2`:

  `H²(Gal(ℂ/ℝ), ℤ/2) ≅ ℤ/2`,  where `Gal(ℂ/ℝ) = {1, conj} ≅ ℤ/2`.

Since `ℝ ⊆ ℂ` is a separable closure (`IsSepClosure ℝ ℂ`) this is a legitimate — if degenerate —
instance of the local Brauer computation of local class field theory: the "local field" is `ℝ`,
i.e. the real place of `ℚ` rather than a `p`-adic one.  It is non-vacuous and it is exactly the
input the sibling area consumes in the form `LocalFieldBrauerCyclic`.

## The pieces

* `NK.LocalCFT.Brauer.nonempty_H2_equiv_of_mulEquiv` — an isomorphism of groups induces an
  equivalence of their second cohomology with trivial `ℤ/p`-coefficients.
* `NK.LocalCFT.Brauer.nonempty_H2Profinite_top_equiv_H2` — for a *finite* separable closure
  `F'/F`, the profinite cohomology `H2Profinite p ⊤` (the colimit over the finite Galois
  intermediate fields) is the second cohomology of the top level `⊤`, i.e. of `Gal(F'/F)`.
* `NK.LocalCFT.Brauer.nonempty_H2_equiv_coeff_of_comm` — for a finite *commutative* group `G`
  generated by an element `g` with `Nat.card G = p` prime, `H²(G, ℤ/p) ≅ ℤ/p`.  The proof is the
  degree-two case of the periodicity of the cohomology of a cyclic group
  (`Rep.FiniteCyclicGroup.groupCohomologyIsoEven`): for the *trivial* representation the period map
  `groupCohomologyπEven` has domain `Ker(ρ(g) - 1) = ℤ/p` (the action is trivial) and kernel the
  norm group `N = ∑_g ρ(g) = p · 1 = 0` (the characteristic is `p`), so it is the desired
  bijection `ℤ/p ≅ H²(G, ℤ/p)`.
* `NK.LocalCFT.Brauer.galComplexMulEquiv` — the isomorphism of groups
  `Gal(ℂ/ℝ) ≃* Multiplicative (ℤ/2)`: every `ℝ`-algebra automorphism of `ℂ` is the identity or
  complex conjugation (`Complex.real_algHom_eq_id_or_conj`), so `Gal(ℂ/ℝ) = {1, conj}` is a group
  with two elements and is identified with the standard model `Multiplicative (ℤ/2)`.

The last point is what allows the cyclic computation to be applied to the Galois group: `Gal(ℂ/ℝ)`
carries only a `Group` (not a `CommGroup`) instance, and the cohomology of finite cyclic groups in
Mathlib is stated for commutative groups, so the computation is transported along
`galComplexMulEquiv` instead of being performed in place.
-/

open CategoryTheory

set_option linter.style.haveILetI false

namespace NK.LocalCFT.Brauer

universe u

/-! ## Equivalences of `H²` induced by group isomorphisms -/

/-- **An isomorphism of groups induces an equivalence of their second cohomology with trivial
`ℤ/p`-coefficients.**  `H²(·, ℤ/p)` is contravariant in the group, and for a group isomorphism
`e : G ≃* H` the induced maps `H2.map e` and `H2.map e.symm` are mutually inverse by
`H2.map_comp` and `H2.map_id`. -/
theorem nonempty_H2_equiv_of_mulEquiv {p : ℕ} {G H : Type u} [Group G] [Group H] (e : G ≃* H) :
    Nonempty (NK.BrauerHasse.H2 p G ≃ NK.BrauerHasse.H2 p H) := by
  have hid1 : ((e.symm : H →* G)).comp (e : G →* H) = MonoidHom.id G := by ext x; simp
  have hid2 : ((e : G →* H)).comp (e.symm : H →* G) = MonoidHom.id H := by ext x; simp
  have h1 : (NK.BrauerHasse.H2.map (p := p) (e.symm : H →* G)) ≫
      (NK.BrauerHasse.H2.map (p := p) (e : G →* H)) = 𝟙 (NK.BrauerHasse.H2 p G) := by
    rw [← NK.BrauerHasse.H2.map_comp (f := (e.symm : H →* G)) (g := (e : G →* H)), hid1,
      NK.BrauerHasse.H2.map_id]
  have h2 : (NK.BrauerHasse.H2.map (p := p) (e : G →* H)) ≫
      (NK.BrauerHasse.H2.map (p := p) (e.symm : H →* G)) = 𝟙 (NK.BrauerHasse.H2 p H) := by
    rw [← NK.BrauerHasse.H2.map_comp (f := (e : G →* H)) (g := (e.symm : H →* G)), hid2,
      NK.BrauerHasse.H2.map_id]
  refine ⟨{ toFun := fun x => (NK.BrauerHasse.H2.map (p := p) (e.symm : H →* G)).hom x
            invFun := fun y => (NK.BrauerHasse.H2.map (p := p) (e : G →* H)).hom y
            left_inv := fun x => ?_
            right_inv := fun y => ?_ }⟩
  · have hh := congrArg (fun (f : NK.BrauerHasse.H2 p G ⟶ NK.BrauerHasse.H2 p G) =>
      f.hom x) h1
    simpa using hh
  · have hh := congrArg (fun (f : NK.BrauerHasse.H2 p H ⟶ NK.BrauerHasse.H2 p H) =>
      f.hom y) h2
    simpa using hh

/-- **For a finite separable closure `F'/F`, the profinite cohomology at `⊤` is the second
cohomology of `Gal(F'/F)`.**  The finite levels of the colimit defining `H2Profinite p ⊤` have a
top element, namely `F'` itself (`topLev`), and the structure map out of the top level is a
bijection; the level group at the top level is `Gal(F'/F)` (`levelGroupTopEquiv`). -/
theorem nonempty_H2Profinite_top_equiv_H2 {F F' : Type u} [Field F] [Field F'] [Algebra F F']
    [IsSepClosure F F'] [FiniteDimensional F F'] (p : ℕ) :
    Nonempty (NK.BrauerHasse.H2Profinite (K := F) (K' := F') p ⊤ ≃
      NK.BrauerHasse.H2 p (F' ≃ₐ[F] F')) := by
  have hbij : Function.Bijective
      (fun a : NK.BrauerHasse.LevelH2 (K := F) (K' := F') p ⊤ (topLev (F := F) (F' := F')) =>
        NK.BrauerHasse.H2Profinite.ofLevel (topLev (F := F) (F' := F')) a) :=
    ⟨ofLevel_topLev_injective (F := F) (F' := F') p,
      fun y => ofLevel_topLev_surjective (F := F) (F' := F') p y⟩
  obtain ⟨e⟩ := nonempty_H2_equiv_of_mulEquiv (p := p) (levelGroupTopEquiv (F := F) (F' := F'))
  exact ⟨(Equiv.ofBijective _ hbij).symm.trans e⟩

/-! ## `H²(G, ℤ/p) ≅ ℤ/p` for a cyclic group of prime order -/

/-- **The second cohomology of a finite cyclic group of prime order with trivial `ℤ/p`-coefficients
is `ℤ/p`.**

`G` is finite and generated by `g` with `Nat.card G = p`.  The proof uses the periodicity of the
cohomology of a cyclic group: the period map `Rep.FiniteCyclicGroup.groupCohomologyπEven` maps the
cycles `Ker(ρ(g) - 1)` onto `H²(G, ℤ/p)` with kernel the norm group, and for the trivial
representation `Ker(ρ(g) - 1) = ℤ/p` while `N = ∑_{g ∈ G} ρ(g) = p · 1 = 0`.  Thus it is a
bijection. -/
theorem nonempty_H2_equiv_coeff_of_comm {p : ℕ} [Fact p.Prime] {G : Type u} [CommGroup G]
    [Fintype G] (g : G) (hg : ∀ x, x ∈ Subgroup.zpowers g) (hcard : Nat.card G = p) :
    Nonempty (NK.BrauerHasse.H2 p G ≃ NK.BrauerHasse.Coeff.{u} p) := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  let A := Rep.trivial (NK.BrauerHasse.Coeff.{u} p) G (NK.BrauerHasse.Coeff.{u} p)
  have hid : (Rep.Hom.hom (A.applyAsHom g)).toLinearMap = LinearMap.id := by
    apply LinearMap.ext
    intro v
    rw [Representation.IntertwiningMap.toLinearMap_apply, Rep.applyAsHom_apply,
      Rep.trivial_ρ_apply]
    rfl
  have hsub : (Rep.applyAsHom A g - 𝟙 A).hom.toLinearMap = 0 := by
    simp [Rep.sub_hom, hid]
  have hnorm : A.norm.hom.toLinearMap = 0 := by
    show (Rep.trivial (NK.BrauerHasse.Coeff.{u} p) G
      (NK.BrauerHasse.Coeff.{u} p)).norm.hom.toLinearMap = 0
    apply LinearMap.ext
    intro v
    rw [Representation.IntertwiningMap.toLinearMap_apply, Rep.norm_apply, Representation.norm]
    simp only [LinearMap.sum_apply]
    rw [Finset.sum_congr rfl (fun d _ => Rep.trivial_ρ_apply d v)]
    rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, hcard]
    simp
  haveI h1 : Epi (ShortComplex.moduleCatCyclesIso
      (Rep.FiniteCyclicGroup.normHomCompSub A g)).inv := inferInstance
  haveI h2 : Epi (Rep.FiniteCyclicGroup.normHomCompSub A g).homologyπ := inferInstance
  haveI h3 : Epi (Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg 2 (by norm_num)).inv :=
    inferInstance
  haveI hepi : Epi (Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num)) := by
    change Epi ((ShortComplex.moduleCatCyclesIso
        (Rep.FiniteCyclicGroup.normHomCompSub A g)).inv ≫
      (Rep.FiniteCyclicGroup.normHomCompSub A g).homologyπ ≫
      (Rep.FiniteCyclicGroup.groupCohomologyIsoEven A g hg 2 (by norm_num)).inv)
    exact epi_comp _ _
  have hsurjπ : Function.Surjective (ConcreteCategory.hom
      (Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num))) :=
    (ModuleCat.epi_iff_surjective _).1 hepi
  have hinjπ : Function.Injective (ConcreteCategory.hom
      (Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num))) := by
    intro x y hxy
    have hz : (ConcreteCategory.hom
        (Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num))) (x - y) = 0 := by
      rw [map_sub, hxy, sub_self]
    have hz' := (Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff A g hg 2
      (by norm_num) (x - y)).1 hz
    rw [hnorm, LinearMap.range_zero, Submodule.mem_bot] at hz'
    exact Subtype.ext (sub_eq_zero.mp hz')
  let f : A.V → NK.BrauerHasse.H2 p G := fun c =>
    Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num)
      ⟨c, by rw [hsub, LinearMap.ker_zero]; exact Submodule.mem_top⟩
  have hinj : Function.Injective f := by
    intro c c' h
    exact congrArg Subtype.val (hinjπ h)
  have hsurj : Function.Surjective f := by
    intro y
    obtain ⟨x, hx⟩ := hsurjπ y
    exact ⟨x.1, hx⟩
  exact ⟨(Equiv.ofBijective f ⟨hinj, hsurj⟩).symm⟩

/-! ## The standard cyclic group of order two -/

/-- Every element of `Multiplicative (ℤ/2)` is `1` or the generator. -/
lemma multiplicative_zmodTwo_cases (x : Multiplicative (ZMod 2)) :
    x = 1 ∨ x = Multiplicative.ofAdd 1 := by
  revert x; decide

/-- The generator of `Multiplicative (ℤ/2)` is not the identity. -/
lemma multiplicative_zmodTwo_ofAdd_one_ne_one : (Multiplicative.ofAdd (1 : ZMod 2)) ≠ 1 := by
  decide

/-- The generator of `Multiplicative (ℤ/2)` is of order two. -/
lemma multiplicative_zmodTwo_ofAdd_one_mul_self :
    (Multiplicative.ofAdd (1 : ZMod 2)) * (Multiplicative.ofAdd 1) = 1 := by
  decide

/-- `Multiplicative (ℤ/2)` is generated by its non-trivial element. -/
lemma mem_zpowers_multiplicative_zmodTwo (x : Multiplicative (ZMod 2)) :
    x ∈ Subgroup.zpowers (Multiplicative.ofAdd (1 : ZMod 2)) := by
  rcases multiplicative_zmodTwo_cases x with h | h
  · rw [h]; exact Subgroup.one_mem _
  · rw [h]; exact Subgroup.mem_zpowers _

/-- `Multiplicative (ℤ/2)` has two elements. -/
lemma card_multiplicative_zmodTwo : Nat.card (Multiplicative (ZMod 2)) = 2 :=
  (Nat.card_congr (Multiplicative.ofAdd (α := ZMod 2))).symm.trans (Nat.card_zmod 2)

/-! ## The Galois group of `ℂ/ℝ` -/

/-- Every `ℝ`-algebra automorphism of `ℂ` is the identity or complex conjugation. -/
theorem complexGalois_eq_one_or_conj (x : ℂ ≃ₐ[ℝ] ℂ) : x = 1 ∨ x = Complex.conjAe := by
  rcases Complex.real_algHom_eq_id_or_conj (x : ℂ →ₐ[ℝ] ℂ) with h | h
  · left
    ext z
    exact congrFun (congrArg (fun (f : ℂ →ₐ[ℝ] ℂ) => (f : ℂ → ℂ)) h) z
  · right
    ext z
    exact congrFun (congrArg (fun (f : ℂ →ₐ[ℝ] ℂ) => (f : ℂ → ℂ)) h) z

/-- Complex conjugation is of order two. -/
lemma complexGalois_conjAe_mul_self : Complex.conjAe * Complex.conjAe = 1 := by
  ext z
  simp [Complex.conjAe_coe]

/-- Complex conjugation is not the identity. -/
lemma complexGalois_conjAe_ne_one : Complex.conjAe ≠ (1 : ℂ ≃ₐ[ℝ] ℂ) := by
  intro h
  have hI : (Complex.I : ℂ) = -Complex.I := by
    have h' := congrArg (fun (f : ℂ ≃ₐ[ℝ] ℂ) => f Complex.I) h.symm
    rw [Complex.conjAe_coe, Complex.conj_I] at h'
    exact h'
  have h2 : (Complex.I : ℂ) = 0 := by
    have h3 : (2 : ℂ) * Complex.I = 0 := by
      rw [two_mul]
      exact add_eq_zero_iff_eq_neg.mpr hI
    rcases mul_eq_zero.mp h3 with h4 | h4
    · exact absurd h4 (by norm_num)
    · exact h4
  exact Complex.I_ne_zero h2

/-- **The Galois group of `ℂ/ℝ` is the standard cyclic group of order two.**  Every `ℝ`-algebra
automorphism of `ℂ` is the identity or complex conjugation, whence the group isomorphism sending
the non-trivial element (complex conjugation) to the generator of `Multiplicative (ℤ/2)`. -/
noncomputable def galComplexMulEquiv : (ℂ ≃ₐ[ℝ] ℂ) ≃* Multiplicative (ZMod 2) := by
  classical
  exact
  { toFun x := if x = 1 then 1 else Multiplicative.ofAdd 1
    invFun y := if y = 1 then 1 else Complex.conjAe
    left_inv x := by
      rcases complexGalois_eq_one_or_conj x with h | h
      · rw [h]; simp
      · rw [h]; simp [complexGalois_conjAe_ne_one]
    right_inv y := by
      rcases multiplicative_zmodTwo_cases y with h | h
      · rw [h]; simp
      · rw [h]; simp [complexGalois_conjAe_ne_one]
    map_mul' x y := by
      rcases complexGalois_eq_one_or_conj x with hx | hx <;>
        rcases complexGalois_eq_one_or_conj y with hy | hy <;>
        simp [hx, hy, complexGalois_conjAe_mul_self, complexGalois_conjAe_ne_one,
          multiplicative_zmodTwo_ofAdd_one_mul_self] }

/-! ## The computation for `Multiplicative (ℤ/2)` and for `Gal(ℂ/ℝ)` -/

/-- `H²(ℤ/2, ℤ/2) ≅ ℤ/2`. -/
theorem nonempty_H2_equiv_coeff_zmodTwo :
    Nonempty (NK.BrauerHasse.H2 2 (Multiplicative (ZMod 2)) ≃
      NK.BrauerHasse.Coeff.{0} 2) :=
  nonempty_H2_equiv_coeff_of_comm (p := 2) (Multiplicative.ofAdd (1 : ZMod 2))
    mem_zpowers_multiplicative_zmodTwo card_multiplicative_zmodTwo

/-- `H²(ℤ/2, ℤ/2)` is non-zero. -/
theorem exists_ne_zero_H2_zmodTwo :
    ∃ x : NK.BrauerHasse.H2 2 (Multiplicative (ZMod 2)), x ≠ 0 :=
  exists_ne_zero_H2_of_finite_cyclic (p := 2) (Multiplicative.ofAdd (1 : ZMod 2))
    mem_zpowers_multiplicative_zmodTwo card_multiplicative_zmodTwo

/-- **`H²(Gal(ℂ/ℝ), ℤ/2) ≅ ℤ/2`**: the cyclic computation transported along
`galComplexMulEquiv`. -/
theorem nonempty_H2_galComplex_equiv_coeff :
    Nonempty (NK.BrauerHasse.H2 2 (ℂ ≃ₐ[ℝ] ℂ) ≃ NK.BrauerHasse.Coeff.{0} 2) :=
  by
  obtain ⟨e₁⟩ := nonempty_H2_equiv_of_mulEquiv (p := 2) galComplexMulEquiv
  obtain ⟨e₂⟩ := nonempty_H2_equiv_coeff_zmodTwo
  exact ⟨e₁.trans e₂⟩

/-- **`H²(Gal(ℂ/ℝ), ℤ/2) ≠ 0`**: the cyclic computation transported along
`galComplexMulEquiv`. -/
theorem exists_ne_zero_H2_galComplex :
    ∃ x : NK.BrauerHasse.H2 2 (ℂ ≃ₐ[ℝ] ℂ), x ≠ 0 :=
  (NK.LocalCFT.Brauer.Aux.H2_ne_zero_iff_of_mulEquiv (p := 2) galComplexMulEquiv).mpr
    exists_ne_zero_H2_zmodTwo

/-! ## The theorem -/

/-- **The local Brauer computation at the real place**: `H²(G_ℝ, ℤ/2) ≅ ℤ/2` for the separable
closure `ℝ ⊆ ℂ`.

`Gal(ℂ/ℝ) = {1, conj} ≅ ℤ/2`, so this is the case `p = 2` of the cyclic computation,
transported from `Gal(ℂ/ℝ)` to the colimit `H2Profinite 2 ⊤` by
`NK.LocalCFT.Brauer.nonempty_H2Profinite_top_equiv_H2`. -/
theorem localFieldBrauerCyclic_complex [IsSepClosure ℝ ℂ] :
    NK.BrauerHasse.LocalFieldBrauerCyclic (κ := ℝ) (κ' := ℂ) 2 := by
  refine ⟨?_, ?_⟩
  · obtain ⟨e₁⟩ := nonempty_H2Profinite_top_equiv_H2 (F := ℝ) (F' := ℂ) 2
    obtain ⟨e₂⟩ := nonempty_H2_galComplex_equiv_coeff
    exact ⟨e₁.trans e₂⟩
  · exact (localH2Nonvanishing_iff_finite (F := ℝ) (F' := ℂ) 2).mpr exists_ne_zero_H2_galComplex

end NK.LocalCFT.Brauer
