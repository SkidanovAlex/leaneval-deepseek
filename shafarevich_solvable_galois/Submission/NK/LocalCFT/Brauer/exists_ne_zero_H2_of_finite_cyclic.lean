/-!
# Non-vanishing of `H²(G, ℤ/p)` for a finite cyclic group `G` of order `p`

For a finite cyclic group `G` of prime order `p`, the second cohomology with coefficients in the
trivial module `ℤ/p` is non-zero:

  `H²(G, ℤ/p) ≅ ℤ/p ≠ 0`.

This is the elementary piece of the local Brauer computation used by the local class field theory
side of Neukirch–Uchida: `H²(G_κ, ℤ/p) ≠ 0` for a local field `κ`.

The proof is the degree-two case of the periodicity of the cohomology of a cyclic group, in the
form proved in Mathlib (`Rep.FiniteCyclicGroup.groupCohomologyπEven`): for a finite cyclic group
generated by `g` and any `k`-linear representation `A`, the quotient map

  `Ker(ρ(g) - 1) ⟶ Ker(ρ(g) - 1)/Im(N) ≅ H²(G, A)`

is the degree-two edge of the periodicity, and its kernel is the image of the norm `N = ∑_g ρ(g)`
(`Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff`).  For the *trivial* representation
`A = ℤ/p` with `G` of order `p` we have `ρ(g) = 1`, so `Ker(ρ(g) - 1)` is everything, while
`N = ∑_g 1 = p • 1 = 0` since `ℤ/p` has characteristic `p`.  Hence `π` is injective and the image
of `1 ≠ 0 ∈ ℤ/p` is a non-zero class of `H²(G, ℤ/p)`.
-/

universe u

open CategoryTheory Representation

set_option linter.style.haveILetI false

namespace NK.LocalCFT.Brauer

/-- **Non-vanishing of `H²(ℤ/p, ℤ/p)`.**  Let `G` be a finite cyclic group of prime order `p`,
generated by `g`.  Then `H²(G, ℤ/p)` (with trivial coefficients `ℤ/p`, in the shape
`NK.BrauerHasse.H2 p G`) has a non-zero element.

The class exhibited below is the image of `1 ∈ ℤ/p` under the periodicity quotient map
`Ker(ρ(g) - 1) ⟶ H²(G, ℤ/p)`: for the trivial representation the kernel is all of `ℤ/p` and the
norm map vanishes because `∑_{g ∈ G} 1 = p · 1 = 0` in characteristic `p`. -/
theorem exists_ne_zero_H2_of_finite_cyclic {p : ℕ} [Fact p.Prime] {G : Type u} [CommGroup G]
    [Fintype G] (g : G) (hg : ∀ x : G, x ∈ Subgroup.zpowers g) (hcard : Nat.card G = p) :
    ∃ x : NK.BrauerHasse.H2 p G, x ≠ 0 := by
  classical
  haveI : NeZero p := ⟨(Fact.out : p.Prime).ne_zero⟩
  -- The trivial `ℤ/p`-representation of `G`.
  let A := Rep.trivial (NK.BrauerHasse.Coeff p) G (NK.BrauerHasse.Coeff p)
  -- `ρ(g) = 1`, hence `ρ(g) - 1 = 0` as a linear endomorphism of `A`.
  have hid : (Rep.Hom.hom (A.applyAsHom g)).toLinearMap = LinearMap.id := by
    apply LinearMap.ext
    intro v
    rw [Representation.IntertwiningMap.toLinearMap_apply, Rep.applyAsHom_apply,
      Rep.trivial_ρ_apply]
    rfl
  have hsub : (Rep.applyAsHom A g - 𝟙 A).hom.toLinearMap = 0 := by
    simp [Rep.sub_hom, hid]
  -- The norm map `N = ∑_g ρ(g) = |G| • 1 = p • 1 = 0` in characteristic `p`.
  have hnorm : A.norm.hom.toLinearMap = 0 := by
    show (Rep.trivial (NK.BrauerHasse.Coeff p) G
      (NK.BrauerHasse.Coeff p)).norm.hom.toLinearMap = 0
    apply LinearMap.ext
    intro v
    rw [Representation.IntertwiningMap.toLinearMap_apply, Rep.norm_apply, Representation.norm]
    simp only [LinearMap.sum_apply]
    rw [Finset.sum_congr rfl (fun d _ => Rep.trivial_ρ_apply d v)]
    rw [Finset.sum_const, Finset.card_univ, ← Nat.card_eq_fintype_card, hcard]
    simp
  -- The periodicity quotient map `Ker(ρ(g) - 1) ⟶ H²(G, A)`, evaluated at `1 ∈ ℤ/p`.
  refine ⟨Rep.FiniteCyclicGroup.groupCohomologyπEven A g hg 2 (by norm_num) ⟨1, ?_⟩, ?_⟩
  · simp [hsub]
  · intro h0
    rw [Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff] at h0
    rw [hnorm, LinearMap.range_zero, Submodule.mem_bot] at h0
    exact one_ne_zero h0

end NK.LocalCFT.Brauer
