namespace NK.LocalCFT.NilpotentObstruction

open scoped commutatorElement

/-- **Key structural lemma.** If a group `G` is generated by an abelian subgroup `B`
together with its commutator subgroup (`B ⊔ [G,G] = ⊤`), then the commutator subgroup
is "perfect relative to `G`": `[[G,G], G] = [G,G]`.

Indeed, the reverse inclusion `[[G,G],G] ≤ [G,G]` always holds since `[G,G]` is normal.
For the other direction, work modulo `N = [[G,G],G]`: the image of `[G,G]` is central in
`G/N` (because `[[G,G],G] = N`), while the image of `B` is abelian, and these two images
generate `G/N`. Hence `G/N` is abelian, i.e. `[G,G] ≤ N`.  Concretely, writing
`x = b₁c₁`, `y = b₂c₂` with `bᵢ ∈ B`, `cᵢ ∈ [G,G]`, the commutator identity
`[uv,w] = u[v,w]u⁻¹ · [u,w]` and `[u,vw] = [u,v]·v[u,w]v⁻¹` expresses `[x,y]` as a
product of conjugates of commutators `[c₁,·]`, `[·,c₂]` (in `N`) and the single element
`[b₁,b₂] = 1` (since `B` is abelian). -/
theorem commutator_eq_commutator_commutator {G : Type*} [Group G] (B : Subgroup G)
    (hB : ∀ x ∈ B, ∀ y ∈ B, x * y = y * x) (h : B ⊔ _root_.commutator G = ⊤) :
    ⁅_root_.commutator G, (⊤ : Subgroup G)⁆ = _root_.commutator G := by
  set C : Subgroup G := _root_.commutator G with hC
  set N : Subgroup G := ⁅C, (⊤ : Subgroup G)⁆ with hN
  -- `N ≤ C`, because `C` is normal and `[C,⊤] ≤ C` for any normal `C`.
  have hle1 : N ≤ C := by rw [hN]; exact Subgroup.commutator_le_left C ⊤
  -- `N` is normal in `G`.
  have hNn : N.Normal := by rw [hN]; exact Subgroup.commutator_normal C ⊤
  -- Every commutator of elements of `G` lies in `N`.
  have key : ∀ x y : G, ⁅x, y⁆ ∈ N := by
    intro x y
    have hx : x ∈ B ⊔ C := by rw [h]; exact Subgroup.mem_top x
    have hy : y ∈ B ⊔ C := by rw [h]; exact Subgroup.mem_top y
    obtain ⟨b₁, hb₁, c₁, hc₁, rfl⟩ :=
      (Subgroup.mem_sup_of_normal_right (s := B) (t := C)).mp hx
    obtain ⟨b₂, hb₂, c₂, hc₂, rfl⟩ :=
      (Subgroup.mem_sup_of_normal_right (s := B) (t := C)).mp hy
    -- Members of `N` built from commutators with a `C`-argument.
    have hNc : ∀ c ∈ C, ∀ g : G, ⁅c, g⁆ ∈ N :=
      fun c hc g => Subgroup.commutator_mem_commutator hc (Subgroup.mem_top g)
    have hNc' : ∀ c ∈ C, ∀ g : G, ⁅g, c⁆ ∈ N :=
      fun c hc g => (commutatorElement_inv c g) ▸ N.inv_mem (hNc c hc g)
    -- `b₁` and `b₂` commute.
    have hb12 : ⁅b₁, b₂⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (hB b₁ hb₁ b₂ hb₂)
    have m1 : ⁅c₁, b₂⁆ ∈ N := hNc c₁ hc₁ b₂
    have m2 : b₂ * ⁅c₁, c₂⁆ * b₂⁻¹ ∈ N := hNn.conj_mem ⁅c₁, c₂⁆ (hNc c₁ hc₁ c₂) b₂
    have m3 : ⁅c₁, b₂⁆ * (b₂ * ⁅c₁, c₂⁆ * b₂⁻¹) ∈ N := N.mul_mem m1 m2
    have m4 : b₁ * (⁅c₁, b₂⁆ * (b₂ * ⁅c₁, c₂⁆ * b₂⁻¹)) * b₁⁻¹ ∈ N :=
      hNn.conj_mem _ m3 b₁
    have m5 : b₂ * ⁅b₁, c₂⁆ * b₂⁻¹ ∈ N := hNn.conj_mem ⁅b₁, c₂⁆ (hNc' c₂ hc₂ b₁) b₂
    have heq : ⁅b₁ * c₁, b₂ * c₂⁆
        = b₁ * (⁅c₁, b₂⁆ * (b₂ * ⁅c₁, c₂⁆ * b₂⁻¹)) * b₁⁻¹
            * (b₂ * ⁅b₁, c₂⁆ * b₂⁻¹) := by
      rw [commutatorElement_mul_left_eq_conj_mul, commutatorElement_mul_right_eq_mul_conj,
        commutatorElement_mul_right_eq_mul_conj, hb12]
      group
    rw [heq]
    exact N.mul_mem m4 m5
  -- `C ≤ N`: `C = [⊤,⊤]` and every element commutator lies in `N`.
  have hle2 : C ≤ N := by
    rw [hC]
    change ⁅(⊤ : Subgroup G), (⊤ : Subgroup G)⁆ ≤ N
    rw [Subgroup.commutator_le]
    intro x _ y _
    exact key x y
  exact le_antisymm hle1 hle2

end NK.LocalCFT.NilpotentObstruction
