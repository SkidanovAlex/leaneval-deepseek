namespace NK.LocalCFT.Units.EllRank

noncomputable section

variable {G : Type*} [AddCommGroup G]

/-! ## The linear maps induced on the elementary abelian quotients -/

/-- The map `V ⧸ ℓV → W ⧸ ℓW` induced by an inclusion `V ≤ W` of additive subgroups. -/
def ellQuotMap (ℓ : ℕ) (V W : AddSubgroup G) (hVW : V ≤ W) :
    ellQuot ℓ ↥V →ₗ[ZMod ℓ] ellQuot ℓ ↥W :=
  (QuotientAddGroup.map (nsmulTop ℓ ↥V) (nsmulTop ℓ ↥W) (AddSubgroup.inclusion hVW)
    (fun x hx => by
      obtain ⟨y, -, hy⟩ := AddSubgroup.mem_map.mp hx
      refine AddSubgroup.mem_map.mpr ⟨AddSubgroup.inclusion hVW y, trivial, ?_⟩
      rw [← hy, nsmulAddMonoidHom_apply, nsmulAddMonoidHom_apply, map_nsmul])).toZModLinearMap ℓ

@[simp] lemma ellQuotMap_mk (ℓ : ℕ) (V W : AddSubgroup G) (hVW : V ≤ W) (x : ↥V) :
    ellQuotMap ℓ V W hVW (QuotientAddGroup.mk' _ x)
      = QuotientAddGroup.mk' _ (AddSubgroup.inclusion hVW x) := rfl

/-- The map `W ⧸ pW → V ⧸ pV` given by `x ↦ p • x`; it is well defined as soon as
`p • W ⊆ V`. -/
def ellQuotMulMap (p : ℕ) (V W : AddSubgroup G) (hpW : ∀ w ∈ W, p • w ∈ V) :
    ellQuot p ↥W →ₗ[ZMod p] ellQuot p ↥V :=
  (QuotientAddGroup.map (nsmulTop p ↥W) (nsmulTop p ↥V)
    { toFun := fun w => ⟨p • (w : G), hpW w w.2⟩
      map_zero' := Subtype.ext (by simp)
      map_add' := fun a b => Subtype.ext (by simp) }
    (fun x hx => by
      obtain ⟨y, -, hy⟩ := AddSubgroup.mem_map.mp hx
      refine AddSubgroup.mem_map.mpr ⟨⟨p • (y : G), hpW y y.2⟩, trivial, ?_⟩
      rw [← hy, nsmulAddMonoidHom_apply, nsmulAddMonoidHom_apply]
      exact Subtype.ext (by simp))).toZModLinearMap p

lemma ellQuotMulMap_mk (p : ℕ) (V W : AddSubgroup G) (hpW : ∀ w ∈ W, p • w ∈ V) (w : ↥W) :
    ellQuotMulMap p V W hpW (QuotientAddGroup.mk' _ w)
      = QuotientAddGroup.mk' _ ⟨p • (w : G), hpW w w.2⟩ := rfl

/-- Bézout in `ℤ`: coprime natural numbers admit an integral linear combination equal to
`1`. -/
lemma exists_int_bezout_of_coprime {ℓ p : ℕ} (h : ℓ.Coprime p) : ∃ A B : ℤ, A * ℓ + B * p = 1 := by
  have h1 : Int.gcd (ℓ : ℤ) (p : ℤ) = 1 := by
    rw [Int.gcd_natCast_natCast, Nat.Coprime.gcd_eq_one h]
  refine ⟨Int.gcdA (ℓ : ℤ) (p : ℤ), Int.gcdB (ℓ : ℤ) (p : ℤ), ?_⟩
  have h2 := Int.gcd_eq_gcd_ab (ℓ : ℤ) (p : ℤ)
  rw [h1, Nat.cast_one] at h2
  rw [mul_comm (Int.gcdA (ℓ : ℤ) (p : ℤ) : ℤ) (ℓ : ℤ),
    mul_comm (Int.gcdB (ℓ : ℤ) (p : ℤ) : ℤ) (p : ℤ), ← h2]

/-- Distinct primes are coprime. -/
lemma coprime_of_prime_of_prime_ne {ℓ p : ℕ} (hℓ : ℓ.Prime) (hp : p.Prime) (hne : ℓ ≠ p) :
    ℓ.Coprime p :=
  hℓ.coprime_iff_not_dvd.mpr (fun hdvd => hne ((Nat.prime_dvd_prime_iff_eq hℓ hp).mp hdvd))

/-! ## The case `ℓ ≠ p`: the induced map is an isomorphism -/

/-- If `V ≤ W` and `[W : V] = p` with `ℓ ≠ p` a prime, the map `V ⧸ ℓV → W ⧸ ℓW` is
injective: an element of `V` that is an `ℓ`-th multiple in `W` is already one in `V`,
by the Bézout identity `A * ℓ + B * p = 1` and `p • W ⊆ V`. -/
lemma ellQuotMap_injective_of_prime_ne {ℓ p : ℕ} (hℓ : ℓ.Prime) (hp : p.Prime) (hne : ℓ ≠ p)
    {V W : AddSubgroup G} (hVW : V ≤ W) (h : V.relIndex W = p) :
    Function.Injective (ellQuotMap ℓ V W hVW) := by
  have hcop : ℓ.Coprime p := coprime_of_prime_of_prime_ne hℓ hp hne
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro x hx
  obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop ℓ ↥V) x
  simp only [ellQuotMap_mk, LinearMap.mem_ker] at hx
  -- `v` is an `ℓ`-th multiple in `W`
  have hv : (AddSubgroup.inclusion hVW v : ↥W) ∈ nsmulTop ℓ ↥W := by
    have := (QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop ℓ ↥W)
      (x := (AddSubgroup.inclusion hVW v : ↥W)) (y := 0)).mp hx
    simpa using this
  obtain ⟨w, -, hw⟩ := AddSubgroup.mem_map.mp hv
  rw [nsmulAddMonoidHom_apply] at hw
  obtain ⟨A, B, hAB⟩ := exists_int_bezout_of_coprime hcop
  -- `w` is a combination of `v` and `p • w`, both of which lie in `V`
  have h2 : (w : ↥W) = A • ((ℓ : ℤ) • w) + B • ((p : ℤ) • w) := by
    conv_lhs => rw [show (w : ↥W) = (A * (ℓ : ℤ) + B * (p : ℤ)) • w by rw [hAB, one_zsmul]]
    rw [add_zsmul, mul_zsmul, mul_zsmul]
  have hwV : (w : G) ∈ V := by
    have hwc : (ℓ : ℤ) • (w : G) = (v : G) := by
      rw [natCast_zsmul]; simpa using congrArg Subtype.val hw
    have h3 : (w : G) = A • ((ℓ : ℤ) • (w : G)) + B • ((p : ℤ) • (w : G)) := by
      simpa using congrArg (fun t : ↥W => (t : G)) h2
    rw [h3, hwc]
    refine AddSubgroup.add_mem V (AddSubgroup.zsmul_mem V v.2 A) ?_
    have hpw : (p : ℤ) • (w : G) ∈ V := by
      rw [natCast_zsmul]; exact nsmul_mem_of_relIndex_prime hp h w.2
    exact AddSubgroup.zsmul_mem V hpw B
  have hvV : v ∈ nsmulTop ℓ ↥V := by
    refine AddSubgroup.mem_map.mpr ⟨⟨(w : G), hwV⟩, trivial, ?_⟩
    rw [nsmulAddMonoidHom_apply]
    exact Subtype.ext (by simpa using congrArg Subtype.val hw)
  rw [show (0 : ellQuot ℓ ↥V) = QuotientAddGroup.mk' _ (0 : ↥V) from rfl]
  exact (QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop ℓ ↥V) (x := v) (y := 0)).mpr
    (by simpa using hvV)

/-- If `V ≤ W` and `[W : V] = p` with `ℓ ≠ p` a prime, the map `V ⧸ ℓV → W ⧸ ℓW` is
surjective: by Bézout every `x ∈ W` differs from an element of `V` by an `ℓ`-th multiple
in `W`. -/
lemma ellQuotMap_surjective_of_prime_ne {ℓ p : ℕ} (hℓ : ℓ.Prime) (hp : p.Prime) (hne : ℓ ≠ p)
    {V W : AddSubgroup G} (hVW : V ≤ W) (h : V.relIndex W = p) :
    Function.Surjective (ellQuotMap ℓ V W hVW) := by
  have hcop : ℓ.Coprime p := coprime_of_prime_of_prime_ne hℓ hp hne
  intro y
  obtain ⟨w, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop ℓ ↥W) y
  obtain ⟨A, B, hAB⟩ := exists_int_bezout_of_coprime hcop
  have hmem : (B • ((p : ℤ) • (w : G))) ∈ V := by
    have hpw : (p : ℤ) • (w : G) ∈ V := by
      rw [natCast_zsmul]; exact nsmul_mem_of_relIndex_prime hp h w.2
    exact AddSubgroup.zsmul_mem V hpw B
  refine ⟨QuotientAddGroup.mk' _ (⟨B • ((p : ℤ) • (w : G)), hmem⟩ : ↥V), ?_⟩
  rw [ellQuotMap_mk]
  have hinc : ((AddSubgroup.inclusion hVW (⟨B • ((p : ℤ) • (w : G)), hmem⟩ : ↥V)) : ↥W)
      = B • ((p : ℤ) • w) := Subtype.ext (by simp)
  rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.mk'_apply, hinc]
  rw [eq_comm, QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop ℓ ↥W)]
  have h2 : (w : ↥W) = A • ((ℓ : ℤ) • w) + B • ((p : ℤ) • w) := by
    conv_lhs => rw [show (w : ↥W) = (A * (ℓ : ℤ) + B * (p : ℤ)) • w by rw [hAB, one_zsmul]]
    rw [add_zsmul, mul_zsmul, mul_zsmul]
  have hsub : (w : ↥W) - B • ((p : ℤ) • w) = A • ((ℓ : ℤ) • w) := by
    rw [sub_eq_iff_eq_add]
    exact h2
  rw [hsub]
  refine AddSubgroup.mem_map.mpr ⟨A • w, trivial, ?_⟩
  rw [nsmulAddMonoidHom_apply, ← natCast_zsmul, smul_comm]

/-! ## The case `ℓ = p`: rank-nullity for the two maps -/

/-- For `[W : V] = p` prime, the image of `ψ : W ⧸ pW → V ⧸ pV`, `x ↦ p • x`, is the
kernel of `φ : V ⧸ pV → W ⧸ pW`. -/
lemma range_mulMap_eq_ker {p : ℕ} (hp : p.Prime) {V W : AddSubgroup G} (hVW : V ≤ W)
    (h : V.relIndex W = p) :
    (ellQuotMulMap p V W (fun _ hw => nsmul_mem_of_relIndex_prime hp h hw)).range
      = (ellQuotMap p V W hVW).ker := by
  ext z
  constructor
  · intro hz
    obtain ⟨u, hu⟩ := hz
    rw [← hu, LinearMap.mem_ker]
    obtain ⟨w, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop p ↥W) u
    rw [ellQuotMulMap_mk, ellQuotMap_mk, QuotientAddGroup.mk'_apply]
    refine (QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop p ↥W)
      (x := AddSubgroup.inclusion hVW (⟨p • (w : G), nsmul_mem_of_relIndex_prime hp h w.2⟩ : ↥V))
      (y := 0)).mpr ?_
    rw [sub_zero]
    refine AddSubgroup.mem_map.mpr ⟨w, trivial, ?_⟩
    rw [nsmulAddMonoidHom_apply]
    exact Subtype.ext (by simp)
  · intro hz
    rw [LinearMap.mem_ker] at hz
    obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop p ↥V) z
    rw [ellQuotMap_mk] at hz
    have hmem : (AddSubgroup.inclusion hVW v : ↥W) ∈ nsmulTop p ↥W := by
      have := (QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop p ↥W)
        (x := (AddSubgroup.inclusion hVW v : ↥W)) (y := 0)).mp hz
      simpa using this
    obtain ⟨w, -, hw⟩ := AddSubgroup.mem_map.mp hmem
    rw [nsmulAddMonoidHom_apply] at hw
    refine ⟨QuotientAddGroup.mk' _ w, ?_⟩
    rw [ellQuotMulMap_mk]
    have : (⟨p • (w : G), nsmul_mem_of_relIndex_prime hp h w.2⟩ : ↥V) = v :=
      Subtype.ext (by simpa using congrArg Subtype.val hw)
    rw [this]

/-- For `[W : V] = p`, the image of `φ : V ⧸ pV → W ⧸ pW` is contained in the kernel of
`ψ : W ⧸ pW → V ⧸ pV`, because `p`-multiples of elements of `V` are `p`-multiples of
elements of `V`. -/
lemma range_map_le_ker_mulMap {p : ℕ} (hp : p.Prime) {V W : AddSubgroup G} (hVW : V ≤ W)
    (h : V.relIndex W = p) :
    (ellQuotMap p V W hVW).range
      ≤ (ellQuotMulMap p V W (fun _ hw => nsmul_mem_of_relIndex_prime hp h hw)).ker := by
  rintro z ⟨u, rfl⟩
  rw [LinearMap.mem_ker]
  obtain ⟨v, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop p ↥V) u
  rw [ellQuotMap_mk, ellQuotMulMap_mk, QuotientAddGroup.mk'_apply]
  refine (QuotientAddGroup.eq_iff_sub_mem (N := nsmulTop p ↥V)
    (x := (⟨p • ((AddSubgroup.inclusion hVW v : ↥W) : G),
      nsmul_mem_of_relIndex_prime hp h (AddSubgroup.inclusion hVW v).2⟩ : ↥V)) (y := 0)).mpr ?_
  rw [sub_zero]
  exact AddSubgroup.mem_map.mpr ⟨v, trivial, by
    rw [nsmulAddMonoidHom_apply]
    exact Subtype.ext (by simp)⟩

/-- For `[W : V] = p` prime, the cokernel of `φ : V ⧸ pV → W ⧸ pW` is at most
one-dimensional: `W ⧸ V ≅ 𝔽_p` is generated by a single element. -/
lemma rank_quot_range_le_one {p : ℕ} [Fact p.Prime] {V W : AddSubgroup G} (hVW : V ≤ W)
    (h : V.relIndex W = p) :
    Module.rank (ZMod p) (ellQuot p ↥W ⧸ (ellQuotMap p V W hVW).range) ≤ 1 := by
  have hp : p.Prime := Fact.out
  obtain ⟨w₀, hw₀W, _hw₀V, hgen⟩ := exists_sub_mem_of_relIndex_prime hVW hp h
  -- the class of `w₀` generates the quotient
  refine rank_le_one (Submodule.Quotient.mk (QuotientAddGroup.mk' (nsmulTop p ↥W)
    (⟨w₀, hw₀W⟩ : ↥W))) ?_
  intro y
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  obtain ⟨x, rfl⟩ := QuotientAddGroup.mk'_surjective (nsmulTop p ↥W) z
  obtain ⟨m, hm⟩ := hgen x x.2
  refine ⟨(m : ZMod p), ?_⟩
  rw [Int.cast_smul_eq_zsmul]
  have hsub : QuotientAddGroup.mk' (nsmulTop p ↥W) x
      - m • QuotientAddGroup.mk' (nsmulTop p ↥W) (⟨w₀, hw₀W⟩ : ↥W)
      ∈ (ellQuotMap p V W hVW).range := by
    refine ⟨QuotientAddGroup.mk' _ ⟨(x : G) - m • w₀, hm⟩, ?_⟩
    rw [ellQuotMap_mk]
    rw [show (AddSubgroup.inclusion hVW (⟨(x : G) - m • w₀, hm⟩ : ↥V) : ↥W)
        = (x : ↥W) - m • (⟨w₀, hw₀W⟩ : ↥W) from Subtype.ext (by simp)]
    rw [map_sub, map_zsmul]
  have hzero : (Submodule.mkQ (ellQuotMap p V W hVW).range)
      (QuotientAddGroup.mk' (nsmulTop p ↥W) x
        - m • QuotientAddGroup.mk' (nsmulTop p ↥W) (⟨w₀, hw₀W⟩ : ↥W)) = 0 := by
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hsub
  rw [map_sub, map_zsmul] at hzero
  exact (sub_eq_zero.mp hzero).symm

/-- **Dimension inequality in the equal-characteristic case.**  If `V ≤ W` with
`[W : V] = p`, then `dim_{𝔽_p} (V ⧸ pV) ≤ dim_{𝔽_p} (W ⧸ pW)`. -/
lemma finrank_ellQuot_le_self {p : ℕ} [Fact p.Prime] {V W : AddSubgroup G} (hVW : V ≤ W)
    (h : V.relIndex W = p) :
    Module.finrank (ZMod p) (ellQuot p ↥V) ≤ Module.finrank (ZMod p) (ellQuot p ↥W) := by
  have hp : p.Prime := Fact.out
  set ψ := ellQuotMulMap p V W (fun _ hw => nsmul_mem_of_relIndex_prime hp h hw) with hψdef
  set φ := ellQuotMap p V W hVW with hφdef
  have hψker : ψ.range = φ.ker := by
    rw [hψdef, hφdef]; exact range_mulMap_eq_ker hp hVW h
  have hφker : φ.range ≤ ψ.ker := by
    rw [hφdef, hψdef]; exact range_map_le_ker_mulMap hp hVW h
  have hcoker : Module.rank (ZMod p) (ellQuot p ↥W ⧸ φ.range) ≤ 1 := by
    rw [hφdef]; exact rank_quot_range_le_one hVW h
  -- rank-nullity for `φ` and for `ψ`
  have h1 : Module.rank (ZMod p) (ellQuot p ↥V)
      = Module.rank (ZMod p) ψ.range + Module.rank (ZMod p) φ.range := by
    have := LinearMap.rank_range_add_rank_ker φ
    rw [← hψker, add_comm] at this
    exact this.symm
  have h2 : Module.rank (ZMod p) (ellQuot p ↥W)
      = Module.rank (ZMod p) ψ.range + Module.rank (ZMod p) ψ.ker :=
    (LinearMap.rank_range_add_rank_ker ψ).symm
  have hle : Module.rank (ZMod p) (ellQuot p ↥V) ≤ Module.rank (ZMod p) (ellQuot p ↥W) := by
    rw [h1, h2]
    exact add_le_add le_rfl (Submodule.rank_mono hφker)
  -- the cokernel of `φ` is one-dimensional, so the dimension of `W ⧸ pW` is bounded
  have hrankφ : Module.rank (ZMod p) ↥φ.range ≤ Module.rank (ZMod p) (ellQuot p ↥V) := by
    rw [h1]; exact le_add_left le_rfl
  have hboundW : Module.rank (ZMod p) (ellQuot p ↥W) ≤ Module.rank (ZMod p) ↥φ.range + 1 := by
    rw [← Submodule.rank_quotient_add_rank φ.range]
    calc Module.rank (ZMod p) (ellQuot p ↥W ⧸ φ.range) + Module.rank (ZMod p) ↥φ.range
        ≤ 1 + Module.rank (ZMod p) ↥φ.range := add_le_add hcoker le_rfl
      _ = Module.rank (ZMod p) ↥φ.range + 1 := add_comm _ _
  have hbound : Module.rank (ZMod p) (ellQuot p ↥W)
      ≤ Module.rank (ZMod p) (ellQuot p ↥V) + 1 :=
    le_trans hboundW (add_le_add hrankφ le_rfl)
  by_cases h0 : Module.finrank (ZMod p) (ellQuot p ↥V) = 0
  · rw [h0]; exact Nat.zero_le _
  · -- if `V ⧸ pV` is finite-dimensional, so is `W ⧸ pW`, and `finrank` converts `rank`
    have hrankV : Module.rank (ZMod p) (ellQuot p ↥V)
        = (Module.finrank (ZMod p) (ellQuot p ↥V) : Cardinal) :=
      (Cardinal.toNat_eq_iff h0).mp rfl
    have hlt : Module.rank (ZMod p) (ellQuot p ↥W) < Cardinal.aleph0 := by
      refine lt_of_le_of_lt hbound ?_
      rw [hrankV, ← Nat.cast_one, ← Nat.cast_add]
      exact Cardinal.natCast_lt_aleph0
    exact Cardinal.toNat_le_toNat hle hlt

/-- **Dimension inequality.**  If `V ≤ W` with `[W : V] = p` a prime, then for any prime
`ℓ` the `𝔽_ℓ`-dimension of `V ⧸ ℓV` is at most that of `W ⧸ ℓW`. -/
lemma finrank_ellQuot_le_of_relIndex_prime {ℓ p : ℕ} [Fact ℓ.Prime] [Fact p.Prime]
    {V W : AddSubgroup G} (hVW : V ≤ W) (h : V.relIndex W = p) :
    Module.finrank (ZMod ℓ) (ellQuot ℓ ↥V) ≤ Module.finrank (ZMod ℓ) (ellQuot ℓ ↥W) := by
  by_cases hlp : ℓ = p
  · subst hlp; exact finrank_ellQuot_le_self hVW h
  · have hbij : Function.Bijective (ellQuotMap ℓ V W hVW) :=
      ⟨ellQuotMap_injective_of_prime_ne Fact.out Fact.out hlp hVW h,
       ellQuotMap_surjective_of_prime_ne Fact.out Fact.out hlp hVW h⟩
    exact le_of_eq (LinearEquiv.finrank_eq (LinearEquiv.ofBijective _ hbij))

/-! ## The target statement -/

theorem natCard_projectivization_ellDual_le_of_relIndex_prime {ℓ p : ℕ} [Fact ℓ.Prime] [Fact p.Prime]
    {G : Type*} [AddCommGroup G] (V W : AddSubgroup G) (hVW : V ≤ W) (h : V.relIndex W = p) :
    Nat.card (Projectivization (ZMod ℓ) (ellDual ℓ ↥V)) ≤
      Nat.card (Projectivization (ZMod ℓ) (ellDual ℓ ↥W)) := by
  -- the number of points is monotone in the dimension, and dualising preserves the dimension
  refine natCard_projectivization_le_of_finrank_le (ZMod ℓ) (ellDual ℓ ↥V) (ellDual ℓ ↥W) ?_
  rw [Subspace.dual_finrank_eq, Subspace.dual_finrank_eq]
  exact finrank_ellQuot_le_of_relIndex_prime hVW h

end

end NK.LocalCFT.Units.EllRank
