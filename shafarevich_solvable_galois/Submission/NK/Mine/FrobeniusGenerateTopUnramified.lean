/-!
# The Frobenius elements at unramified primes generate the Galois group

For a finite Galois extension `L / K` of number fields, the Frobenius elements at the primes `p`
of `K` which are *unramified* in `L` already generate `Gal(L/K)`:

`Subgroup.closure {σ | ∃ p unramified in L, IsFrobAtPrime p σ} = ⊤`.

This strengthens `NK.Chebotarev.FrobeniusGenerateTop`, which allows every prime `p` of `K`.

The argument follows the same scheme as `FrobeniusGenerateTop`.  Let `H` be the subgroup
generated by the Frobenius elements at unramified primes and let `F` be its fixed field.  Since the
set of Frobenius elements is conjugation invariant, `H` is normal and `F / K` is Galois.  For a
prime `p` unramified in `L`, a Frobenius `σ` at a prime of `L` above `p` lies in `H` by
construction, hence acts trivially on `F`; restricting the Frobenius to the normal intermediate
field `F` (`IsFrobAtRestrictNormalHom`) shows that `1` is a Frobenius at every prime of `F` above
`p`.  As `p` is also unramified in `F` (ramification indices are multiplicative in towers, so
`e(F/K)` divides `e(L/K) = 1`), the order of the Frobenius equals the inertia degree
(`IsFrobAtOrderOfEqInertiaDeg`), so the inertia degree is `1`, and the fundamental identity forces
`p` to split completely in `F`.

Hence every prime of `K` unramified in `L` splits completely in `F`.  By `Dedekind`'s density
theorem for the completely split primes (`hasDirichletDensity_primes_splitsCompletely`, the
"trivial conjugacy class" case, available unconditionally) the completely split primes of `F / K`
have Dirichlet density `1 / [F : K]`, while the unramified primes of `L / K` have density `1`
(their complement is the finite set of ramified primes).  Comparing densities gives
`1 / [F : K] = 1`, i.e. `F = K` and `H = ⊤`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option maxHeartbeats 800000

open IsDedekindDomain

namespace NK.Mine

open NK.Chebotarev

theorem FrobeniusGenerateTopUnramified {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] :
    Subgroup.closure {σ : Gal(L/K) | ∃ p : NK.Chebotarev.PrimeIdeal K,
      (∀ P : NK.Chebotarev.PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ} = ⊤ := by
  classical
  set S : Set Gal(L/K) := {σ : Gal(L/K) | ∃ p : NK.Chebotarev.PrimeIdeal K,
      (∀ P : NK.Chebotarev.PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ} with hSdef
  set H : Subgroup Gal(L/K) := Subgroup.closure S with hHdef
  -- ## `S` is conjugation invariant, so `H` is normal
  have hconj : ∀ ⦃σ : Gal(L/K)⦄, σ ∈ S → ∀ τ : Gal(L/K), τ * σ * τ⁻¹ ∈ S := by
    intro σ hσ τ
    obtain ⟨p, hunr, hfrob⟩ := hσ
    exact ⟨p, hunr, isFrobAtPrime_conj hfrob τ⟩
  have hconj_sub : Group.conjugatesOfSet S ⊆ S := by
    intro x hx
    obtain ⟨y, hy, hc⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨c, hc'⟩ := isConj_iff.mp hc
    rw [← hc']
    exact hconj hy c
  have hclosure_eq : Subgroup.normalClosure S = Subgroup.closure S :=
    le_antisymm (Subgroup.closure_mono hconj_sub) Subgroup.closure_le_normalClosure
  have hHnormal : H.Normal := by
    rw [hHdef]
    have hnorm : (Subgroup.normalClosure S).Normal := inferInstance
    rwa [hclosure_eq] at hnorm
  haveI : H.Normal := hHnormal
  set F : IntermediateField K L := IntermediateField.fixedField H with hFdef
  haveI hFgal : IsGalois K F := by rw [hFdef]; infer_instance
  -- ## At an unramified prime of `K` every prime of `F` has trivial Frobenius
  have key : ∀ (p : PrimeIdeal K) (q : PrimeIdeal F),
      (∀ P : PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) →
      q.asIdeal.LiesOver p.asIdeal → IsFrobAt (K := K) (L := F) q 1 := by
    intro p q hunr hq
    obtain ⟨P0⟩ := (inferInstance : Nonempty (q.asIdeal.primesOver (NumberField.RingOfIntegers L)))
    let P : PrimeIdeal L := ⟨P0.1, P0.2.1, Ideal.ne_bot_of_mem_primesOver q.ne_bot P0.2⟩
    have hPq : P.asIdeal.LiesOver q.asIdeal := P0.2.2
    have hPp : P.asIdeal.LiesOver p.asIdeal := liesOver_trans hPq hq
    obtain ⟨σ, hσ⟩ := exists_isFrobAt (K := K) (L := L) p P hPp
    have hσS : σ ∈ S := ⟨p, hunr, P, hPp, hσ⟩
    have hσH : σ ∈ H := Subgroup.subset_closure hσS
    have hσfix : σ ∈ (IntermediateField.fixedField H).fixingSubgroup := by
      rw [IntermediateField.fixingSubgroup_fixedField H]
      exact hσH
    have hone : AlgEquiv.restrictNormalHom (K₁ := L) F σ = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker]
      exact hσfix
    have hfrob := IsFrobAtRestrictNormalHom (K := K) (M := L) F hPp hσ
    have hq_eq : P.under (NumberField.RingOfIntegers F) = q :=
      IsDedekindDomain.HeightOneSpectrum.ext
        (by rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]; exact hPq.over.symm)
    rw [hq_eq, hone] at hfrob
    simpa using hfrob
  -- ## Unramified primes of `K` split completely in `F`
  have hsplit : ∀ p : PrimeIdeal K,
      (∀ P : PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1) →
      (p.asIdeal.primesOver (NumberField.RingOfIntegers F)).ncard = Module.finrank K F := by
    intro p hunrL
    obtain ⟨q0⟩ := (inferInstance : Nonempty (p.asIdeal.primesOver (NumberField.RingOfIntegers F)))
    let q : PrimeIdeal F := ⟨q0.1, q0.2.1, Ideal.ne_bot_of_mem_primesOver p.ne_bot q0.2⟩
    have hq : q.asIdeal.LiesOver p.asIdeal := q0.2.2
    haveI := hq
    -- `q` is unramified over `K`, because ramification indices multiply in the tower `K ⊆ F ⊆ L`
    have he1 : q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1 := by
      obtain ⟨P0⟩ := (inferInstance : Nonempty (q.asIdeal.primesOver (NumberField.RingOfIntegers L)))
      let P : PrimeIdeal L := ⟨P0.1, P0.2.1, Ideal.ne_bot_of_mem_primesOver q.ne_bot P0.2⟩
      have hPq : P.asIdeal.LiesOver q.asIdeal := P0.2.2
      have hPp : P.asIdeal.LiesOver p.asIdeal := liesOver_trans hPq hq
      haveI := hPq
      have htower := Ideal.ramificationIdx_tower (R := NumberField.RingOfIntegers K)
        (S := NumberField.RingOfIntegers F) (T := NumberField.RingOfIntegers L)
        q.asIdeal P.asIdeal
      rw [hunrL P hPp] at htower
      exact Nat.eq_one_of_mul_eq_one_right (m := q.asIdeal.ramificationIdx
        (NumberField.RingOfIntegers K)) (n := P.asIdeal.ramificationIdx
          (NumberField.RingOfIntegers F)) htower.symm
    have hf1 : q.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) = 1 := by
      have h := IsFrobAtOrderOfEqInertiaDeg (K := K) (L := F) hq he1 (key p q hunrL hq)
      rw [orderOf_one] at h
      exact h.symm
    rw [Commons.NumberTheory.NumberField.ncard_primesOver_eq_finrank_iff_splitCompletely p]
    refine ⟨?_, ?_⟩
    · rw [Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal q.asIdeal (F ≃ₐ[K] F)]
      exact he1
    · rw [Ideal.inertiaDegIn_eq_inertiaDeg p.asIdeal q.asIdeal (F ≃ₐ[K] F)]
      exact hf1
  -- ## Density comparison
  -- The primes of `K` which are unramified in `L` form a set of Dirichlet density `1`
  have hUnrZero : NumberField.Set.HasDirichletDensity
      ({p : PrimeIdeal K | ∀ P : PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1})ᶜ 0 := by
    have hBadFin : ({p : PrimeIdeal K | ∃ P : PrimeIdeal L, P.asIdeal.LiesOver p.asIdeal ∧
        P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) ≠ 1}).Finite := by
      have hL : ({Q : PrimeIdeal L |
          Q.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) ≠ 1}).Finite :=
        Commons.NumberTheory.NumberField.finite_setOf_ramificationIdx_ne_one
      refine (hL.image (fun Q : PrimeIdeal L =>
        IsDedekindDomain.HeightOneSpectrum.under (NumberField.RingOfIntegers K) Q)).subset ?_
      rintro p ⟨P, hP, heP⟩
      exact ⟨P, heP, IsDedekindDomain.HeightOneSpectrum.ext (by
        rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal, hP.over])⟩
    refine Commons.NumberTheory.NumberField.Set.hasDirichletDensity_zero_of_subset
      (Commons.NumberTheory.NumberField.Set.hasDirichletDensity_zero_of_finite hBadFin) ?_
    intro p hp
    by_contra hbad
    exact hp fun P hP => by
      by_contra hne
      exact hbad ⟨P, hP, hne⟩
  -- The completely split primes of `F` contain the unramified primes of `L`, hence have density `1`
  have hSplZero : NumberField.Set.HasDirichletDensity
      ({p : PrimeIdeal K |
        (p.asIdeal.primesOver (NumberField.RingOfIntegers F)).ncard =
          Module.finrank K F})ᶜ 0 := by
    refine Commons.NumberTheory.NumberField.Set.hasDirichletDensity_zero_of_subset hUnrZero ?_
    intro p hp hunr
    exact hp (hsplit p hunr)
  have hSplCompl : NumberField.Set.HasDirichletDensity
      ({p : PrimeIdeal K |
        (p.asIdeal.primesOver (NumberField.RingOfIntegers F)).ncard =
          Module.finrank K F})ᶜ (1 - 1 / (Module.finrank K F : ℝ)) :=
    Commons.NumberTheory.NumberField.Set.hasDirichletDensity_compl
      (Commons.NumberTheory.NumberField.Set.hasDirichletDensity_primes_splitsCompletely
        (K := K) (L := F))
  have heq : 1 - 1 / (Module.finrank K F : ℝ) = 0 := tendsto_nhds_unique hSplCompl hSplZero
  have hfpos : (0 : ℝ) < (Module.finrank K F : ℝ) := by
    exact_mod_cast Module.finrank_pos (R := K) (M := F)
  have hf1 : (Module.finrank K F : ℝ) = 1 := by
    field_simp at heq
    linarith
  have hfin1 : Module.finrank K F = 1 := by exact_mod_cast hf1
  -- ## Hence `F = K` and `H = ⊤`
  have hFbot : F = ⊥ := IntermediateField.finrank_eq_one_iff.mp hfin1
  have hfixed : IntermediateField.fixedField H = ⊥ := by rw [← hFdef]; exact hFbot
  have h1 : (IntermediateField.fixedField H).fixingSubgroup = ⊤ := by
    rw [hfixed, IntermediateField.fixingSubgroup_bot]
  rw [IntermediateField.fixingSubgroup_fixedField H] at h1
  exact h1

end NK.Mine
