/-!
# The "easy half of Cebotarev": a prime which does not split completely

For a finite Galois extension `L / K` of number fields of degree `> 1` there is a prime of `K`
which does *not* split completely in `L`.  This is the complement of the statement
`Commons.NumberTheory.NumberField.exists_prime_splitsCompletely` and is proved from the same
Dirichlet-density computation: the primes splitting completely have density `1 / [L : K] < 1`,
while the empty set has density `0`.

This is the input of `NK.FieldTheory.Galois.stabilizer_iSup_eq_top`: it is what shows that the
absolute Galois group of a number field is generated by its decomposition groups.
-/

open Filter IsDedekindDomain Topology Set

namespace NK.Mine

/-- **Some prime does not split completely.**  If `L / K` is a finite Galois extension of number
fields of degree `> 1`, then some nonzero prime `p` of `𝓞 K` has fewer primes of `𝓞 L` above it than
the degree `[L : K]`. -/
theorem exists_prime_not_splitsCompletely {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (h : 1 < Module.finrank K L) :
    ∃ p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K),
      (p.asIdeal.primesOver (NumberField.RingOfIntegers L)).ncard < Module.finrank K L := by
  by_contra hcon
  simp only [not_exists, not_lt] at hcon
  set S : Set (IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :=
    {p | (p.asIdeal.primesOver (NumberField.RingOfIntegers L)).ncard = Module.finrank K L}
    with hSdef
  have hSuniv : S = univ := by
    ext p
    simp only [hSdef, mem_setOf_eq, mem_univ, iff_true]
    exact le_antisymm
      (Commons.NumberTheory.NumberField.ncard_primesOver_le_finrank (K := K) (L := L) p) (hcon p)
  have h1 : NumberField.Set.HasDirichletDensity S (1 / (Module.finrank K L : ℝ)) :=
    Commons.NumberTheory.NumberField.Set.hasDirichletDensity_primes_splitsCompletely
  have hcompl : NumberField.Set.HasDirichletDensity Sᶜ (1 - 1 / (Module.finrank K L : ℝ)) :=
    Commons.NumberTheory.NumberField.Set.hasDirichletDensity_compl h1
  have hzero : NumberField.Set.HasDirichletDensity Sᶜ 0 := by
    rw [hSuniv, compl_univ]
    exact Commons.NumberTheory.NumberField.Set.hasDirichletDensity_zero_of_finite
      (Set.finite_empty)
  have heq : (1 - 1 / (Module.finrank K L : ℝ)) = 0 := tendsto_nhds_unique hcompl hzero
  have hfpos : (0 : ℝ) < (Module.finrank K L : ℝ) := by
    exact_mod_cast (Module.finrank_pos (R := K) (M := L))
  have hf1 : (Module.finrank K L : ℝ) = 1 := by
    field_simp at heq
    linarith
  have : Module.finrank K L = 1 := by exact_mod_cast hf1
  omega

end NK.Mine
