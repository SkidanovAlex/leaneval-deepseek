open IsDedekindDomain.HeightOneSpectrum
open scoped NumberField WithZero

namespace NK.Mine

noncomputable section

/-! ## A general group-theoretic lemma

If a surjective homomorphism `φ : G →* H` of commutative groups has kernel consisting of
`n`-th powers in `G` (i.e. `ker φ ⊆ G^n`), then `φ` identifies `G / G^n` with `H / H^n`:
the induced map is surjective because `φ` is, and injective because a preimage of an `n`-th
power differs from an `n`-th power by an element of `ker φ ⊆ G^n`. -/
theorem natCard_quot_powMonoidHom_eq_of_ker_le_pow {G H : Type*} [CommGroup G] [CommGroup H]
    (φ : G →* H) (hφ : Function.Surjective φ) (n : ℕ)
    (hker : φ.ker ≤ (powMonoidHom n : G →* G).range) :
    Nat.card (G ⧸ (powMonoidHom n : G →* G).range) =
      Nat.card (H ⧸ (powMonoidHom n : H →* H).range) := by
  classical
  -- `G^n` is the preimage under `φ` of `H^n`
  have key : (powMonoidHom n : G →* G).range
      = Subgroup.comap φ (powMonoidHom n : H →* H).range := by
    ext x
    simp only [Subgroup.mem_comap, MonoidHom.mem_range, powMonoidHom_apply]
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨φ y, by simp [map_pow]⟩
    · rintro ⟨y, hy⟩
      obtain ⟨w, rfl⟩ := hφ y
      have h2 : x * (w ^ n)⁻¹ ∈ φ.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_inv, map_pow, hy, mul_inv_cancel]
      obtain ⟨z, hz⟩ := MonoidHom.mem_range.mp (hker h2)
      simp only [powMonoidHom_apply] at hz
      refine ⟨z * w, ?_⟩
      rw [mul_pow, hz]
      group
  -- the composite `G → H ⧸ H^n` is surjective with kernel `G^n`
  let g : G →* H ⧸ (powMonoidHom n : H →* H).range :=
    (QuotientGroup.mk' _).comp φ
  have hg_surj : Function.Surjective g := (QuotientGroup.mk'_surjective _).comp hφ
  have hgker : g.ker = (powMonoidHom n : G →* G).range := by
    ext x
    rw [key, MonoidHom.mem_ker]
    show (QuotientGroup.mk' _) (φ x) = 1 ↔ φ x ∈ (powMonoidHom n : H →* H).range
    exact QuotientGroup.eq_one_iff (φ x)
  rw [← hgker]
  exact Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective g hg_surj).toEquiv

end

end NK.Mine

namespace NK.Mine

open scoped Classical

theorem index_powSub_units_eq {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {p ℓ : ℕ}
    (hp : p.Prime) (hℓ : ℓ.Prime) (hne : ℓ ≠ p)
    (hchar : CharP (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) p) (n : ℕ) :
    (Subgroup.closure (Set.range fun y : (𝔭.adicCompletion K)ˣ => y ^ (ℓ ^ n))).index =
      ℓ ^ n * (ℓ ^ n).gcd (Nat.card (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) - 1) := by
  classical
  have hNe : NeZero (ℓ ^ n) := ⟨pow_ne_zero n hℓ.ne_zero⟩
  have hne0 : ℓ ^ n ≠ 0 := pow_ne_zero n hℓ.ne_zero
  -- Step 1: split off the valuation, using that `ℤ` is torsion free.
  have h1 : Nat.card ((𝔭.adicCompletion K)ˣ ⧸
      (powMonoidHom (ℓ ^ n) : (𝔭.adicCompletion K)ˣ →* (𝔭.adicCompletion K)ˣ).range) =
      ℓ ^ n * Nat.card ((𝔭.adicCompletionIntegers K)ˣ ⧸
        (powMonoidHom (ℓ ^ n) :
          (𝔭.adicCompletionIntegers K)ˣ →* (𝔭.adicCompletionIntegers K)ˣ).range) := by
    have htor : ∀ h : Multiplicative ℤ, h ^ (ℓ ^ n) = 1 → h = 1 :=
      fun h hh => Commons.NumberTheory.NumberField.Completion.pow_right_injective_zint hne0
        (by rw [hh, one_pow])
    have hmain := Commons.NumberTheory.NumberField.Completion.natCard_quot_powMonoidHom_eq_mul
      (Commons.NumberTheory.NumberField.Completion.unitsValLog (𝔭.adicCompletion K))
      (Commons.NumberTheory.NumberField.Completion.unitsValLog_adicCompletion_surjective K 𝔭)
      (ℓ ^ n) htor
    rw [hmain, Commons.NumberTheory.NumberField.Completion.natCard_multiplicative_int_quot_pow]
    congr 1
    have hker : (Commons.NumberTheory.NumberField.Completion.unitsValLog (𝔭.adicCompletion K)).ker
        = (𝔭.adicCompletionIntegers K).unitGroup :=
      Commons.NumberTheory.NumberField.Completion.adicUnitsVal_eq_unitGroup K 𝔭
    rw [hker]
    exact NK.LocalInputs.PowerQuotient.natCard_quot_powMonoidHom_eq_of_mulEquiv (ℓ ^ n)
      (ValuationSubring.unitGroupMulEquiv (𝔭.adicCompletionIntegers K))
  -- Step 2: pass to the residue field, using that `U¹` is `ℓ ^ n`-divisible (`ℓ ≠ p`).
  have h2 : Nat.card ((𝔭.adicCompletionIntegers K)ˣ ⧸
        (powMonoidHom (ℓ ^ n) :
          (𝔭.adicCompletionIntegers K)ˣ →* (𝔭.adicCompletionIntegers K)ˣ).range) =
      Nat.card ((IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ ⧸
        (powMonoidHom (ℓ ^ n) : (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ →*
          (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ).range) := by
    refine natCard_quot_powMonoidHom_eq_of_ker_le_pow
      (Units.map (IsLocalRing.residue (𝔭.adicCompletionIntegers K)).toMonoidHom)
      (Commons.NumberTheory.NumberField.Completion.surjective_units_residue_adicCompletion 𝔭)
      (ℓ ^ n) ?_
    intro u hu
    have hu' : u ∈ NK.LocalInputs.PowerQuotient.pu 𝔭 1 := by
      rw [NK.LocalInputs.PowerQuotient.pu_one]; exact hu
    obtain ⟨v, hv⟩ := NK.Mine.pu_pow_surjective 𝔭 hp hℓ hne hchar n ⟨u, hu'⟩
    rw [MonoidHom.mem_range]
    exact ⟨(v : (𝔭.adicCompletionIntegers K)ˣ), by
      simpa [powMonoidHom_apply, Subgroup.coe_pow] using Subtype.ext_iff.mp hv⟩
  -- Step 3: the residue field units are finite cyclic of order `#k - 1`.
  have h3 : Nat.card ((IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ ⧸
        (powMonoidHom (ℓ ^ n) : (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ →*
          (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ).range) =
      (ℓ ^ n).gcd (Nat.card (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) - 1) := by
    have : Finite (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) :=
      Commons.NumberTheory.NumberField.Completion.finite_residueField_adicCompletion K 𝔭
    have : Fintype (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) := Fintype.ofFinite _
    have : Fintype ((IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ) := Fintype.ofFinite _
    have : IsCyclic ((IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ) := inferInstance
    rw [Commons.GroupTheory.SpecificGroups.Cyclic.card_quotient_powMonoidHom
        (G := (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))ˣ),
      ← Nat.card_eq_fintype_card, Nat.card_units, Nat.card_eq_fintype_card]
  have hcl : Subgroup.closure (Set.range fun y : (𝔭.adicCompletion K)ˣ => y ^ (ℓ ^ n))
      = (powMonoidHom (ℓ ^ n) : (𝔭.adicCompletion K)ˣ →* (𝔭.adicCompletion K)ˣ).range :=
    NK.Mine.closure_range_pow_eq_powMonoidHom_range _ (ℓ ^ n)
  rw [hcl, Subgroup.index_eq_card, h1, h2, h3]

end NK.Mine
