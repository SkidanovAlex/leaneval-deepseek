/-!
# Every finite abelian Galois extension is realised inside the algebraic closure

Let `B / F` be a finite Galois extension whose Galois group is abelian, `m = [B : F]`, and let
`S = N_{B/F} Bˣ` be its norm group.  This file shows that `B` can be realised as an explicit
subfield of the algebraic closure `AlgebraicClosure F`: an intermediate field `E` which is
* generated by a single element `θ` (`E = F⟮θ⟯`, the primitive element theorem for the separable
  extension `B/F`), and
* carries a `F`-algebra isomorphism `B ≃ₐ[F] E` (the chosen `F`-embedding of `B` into the
  algebraic closure).

Consequently all the invariants of `B/F` transported by that isomorphism — finite dimensionality,
the Galois property, commutativity of the automorphism group, the degree and the norm group — hold
for `E/F` as well.

The proof is entirely elementary: `IsAlgClosed.lift` provides an `F`-algebra embedding
`B →ₐ[F] AlgebraicClosure F` of the algebraic extension `B/F` into the algebraically closed
`AlgebraicClosure F`, `AlgHom.equivFieldRange` turns it into an `F`-algebra isomorphism onto its
range `φ.fieldRange`, and `IntermediateField.adjoin_map` computes the range of the primitive
generator.
-/

theorem exists_adjoin_galois_abelian_subfield {F B : Type*} [Field F] [Field B] [Algebra F B]
    [FiniteDimensional F B] [IsGalois F B]
    (hcomm : ∀ σ τ : B ≃ₐ[F] B, σ * τ = τ * σ)
    (m : ℕ) (hfin : Module.finrank F B = m) (S : Subgroup Fˣ)
    (hN : NK.LocalReciprocity.normGroup F B = S) :
    ∃ (E : IntermediateField F (AlgebraicClosure F)) (θ : AlgebraicClosure F),
      E = IntermediateField.adjoin F {θ} ∧ FiniteDimensional F E ∧ IsGalois F E ∧
      (∀ σ τ : ↥E ≃ₐ[F] ↥E, σ * τ = τ * σ) ∧ Module.finrank F ↥E = m ∧
      NK.LocalReciprocity.normGroup F ↥E = S := by
  -- A primitive generator of `B` over `F` (the extension is finite Galois, hence separable).
  obtain ⟨α, hα⟩ := Field.exists_primitive_element F B
  -- An `F`-algebra embedding of `B` into the algebraic closure.
  let φ : B →ₐ[F] AlgebraicClosure F := IsAlgClosed.lift
  -- The induced `F`-algebra isomorphism `B ≃ₐ[F] φ.fieldRange`.
  let e : B ≃ₐ[F] ↥φ.fieldRange := φ.equivFieldRange
  refine ⟨φ.fieldRange, φ α, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- the range is generated by the image of the primitive element
    have h := AlgHom.fieldRange_eq_map φ
    rw [h, ← hα, IntermediateField.adjoin_map, Set.image_singleton]
  · -- finite dimensionality transports along `e`
    exact FiniteDimensional.of_injective (e.symm : ↥φ.fieldRange →ₗ[F] B) e.symm.injective
  · -- the Galois property transports along `e`
    exact IsGalois.of_algEquiv e
  · -- commutativity of the automorphism group transports along `e`
    intro σ τ
    apply e.autCongr.symm.injective
    simp only [map_mul]
    exact hcomm _ _
  · -- the degree transports along `e`
    rw [← e.toLinearEquiv.finrank_eq]
    exact hfin
  · -- the norm group transports along `e`
    rw [← NK.LocalReciprocity.normGroup_eq_of_algEquiv e]
    exact hN

end NK.Unramified
