/-!
# Quadratic Galois extensions: generators and norms

Let `E/F` be a finite-dimensional Galois extension of degree `2`.  This file proves

* `exists_aut_ne_one` : there is a nontrivial `F`-algebra automorphism `σ` of `E`;
* `mem_bot_of_aut_eq_self` : an element fixed by `σ` lies in `F`;
* `aut_apply_eq_neg` : if `x ∉ F` and `x ^ 2 ∈ F` then `σ x = -x`;
* `algebraMap_norm_eq_mul_aut` : `N_{E/F}(x) = x · σ x`;
* `norm_eq_neg` : if `x ∉ F` and `x ^ 2 = a ∈ F` then `N_{E/F}(x) = -a`;
* `norm_algebraMap_add_mul` : `N_{E/F}(u + v x) = u ^ 2 - a v ^ 2`;
* `exists_gen_sq_mem` : `E` is generated by an element `x ∉ F` with `x ^ 2 = a ∈ F`, `a` a
  non-square of `F`.
-/

namespace NK.NUV2.QuadFaithful

noncomputable section

section GroupOrderTwo

variable {G : Type*} [Group G] [Fintype G] {σ : G}

/-- **In a group of order two, every element is `1` or a given non-identity element.** -/
theorem eq_one_or_eq_of_card_two (hcard : Fintype.card G = 2) (hσ : σ ≠ 1) (g : G) :
    g = 1 ∨ g = σ := by
  classical
  have huniv : (Finset.univ : Finset G) = {1, σ} := by
    refine (Finset.eq_univ_of_card _ ?_).symm
    rw [Finset.card_pair (Ne.symm hσ), hcard]
  have : g ∈ ({1, σ} : Finset G) := by rw [← huniv]; exact Finset.mem_univ g
  simpa using this

/-- In a group of order two, a non-identity element is an involution. -/
theorem mul_self_eq_one_of_card_two (hcard : Fintype.card G = 2) (hσ : σ ≠ 1) : σ * σ = 1 := by
  rcases eq_one_or_eq_of_card_two hcard hσ (σ * σ) with h | h
  · exact h
  · exfalso
    have h' : σ = 1 := by
      have := congrArg (· * σ⁻¹) h
      simpa [mul_assoc] using this
    exact hσ h'

end GroupOrderTwo

section Quadratic

variable {F E : Type*} [Field F] [Field E] [Algebra F E]
  [FiniteDimensional F E] [IsGalois F E]

/-- **A quadratic Galois extension has a nontrivial automorphism.** -/
theorem exists_aut_ne_one (h : Module.finrank F E = 2) :
    ∃ σ : E ≃ₐ[F] E, σ ≠ 1 := by
  have hcard : Nat.card (E ≃ₐ[F] E) = 2 := by
    rw [IsGalois.card_aut_eq_finrank F E, h]
  obtain ⟨x, y, hxy, -⟩ := Nat.card_eq_two_iff.mp hcard
  rcases eq_or_ne x 1 with hx | hx
  · exact ⟨y, fun hy => hxy (hx.trans hy.symm)⟩
  · exact ⟨x, hx⟩

theorem card_aut_eq_two (h : Module.finrank F E = 2) : Fintype.card (E ≃ₐ[F] E) = 2 := by
  rw [← Nat.card_eq_fintype_card, IsGalois.card_aut_eq_finrank F E, h]

/-- **An element of a quadratic Galois extension fixed by the nontrivial automorphism lies in the
base field.** -/
theorem mem_bot_of_aut_eq_self (h : Module.finrank F E = 2) {σ : E ≃ₐ[F] E} (hσ : σ ≠ 1)
    {x : E} (hx : σ x = x) : x ∈ Set.range (algebraMap F E) := by
  have hmem : x ∈ IntermediateField.fixedField (⊤ : Subgroup (E ≃ₐ[F] E)) := by
    rw [IntermediateField.mem_fixedField_iff]
    intro f _
    rcases eq_one_or_eq_of_card_two (card_aut_eq_two h) hσ f with rfl | rfl
    · rfl
    · exact hx
  rw [show (⊤ : Subgroup (E ≃ₐ[F] E)) = (⊥ : IntermediateField F E).fixingSubgroup from
      IntermediateField.fixingSubgroup_bot.symm] at hmem
  rw [IsGalois.fixedField_fixingSubgroup (K := (⊥ : IntermediateField F E))] at hmem
  rwa [IntermediateField.mem_bot] at hmem

/-- **The nontrivial automorphism of a quadratic Galois extension sends a generator with square in
the base field to its negative.** -/
theorem aut_apply_eq_neg (h : Module.finrank F E = 2) {σ : E ≃ₐ[F] E} (hσ : σ ≠ 1)
    {x : E} (hx : x ∉ Set.range (algebraMap F E)) {a : F} (ha : x ^ 2 = algebraMap F E a) :
    σ x = -x := by
  have hσ2 : σ * σ = 1 := mul_self_eq_one_of_card_two (card_aut_eq_two h) hσ
  have hne : σ x ≠ x := fun heq => hx (mem_bot_of_aut_eq_self h hσ heq)
  have hsq : (σ x) ^ 2 = x ^ 2 := by
    rw [← map_pow, ha, AlgEquiv.commutes]
  have hfac : (σ x - x) * (σ x + x) = 0 := by
    have hz : (σ x) ^ 2 - x ^ 2 = 0 := by rw [hsq]; ring
    linear_combination hz
  rcases mul_eq_zero.mp hfac with h' | h'
  · exact absurd (sub_eq_zero.mp h') hne
  · linear_combination h'

/-- **The norm in a quadratic Galois extension is the product with the conjugate.** -/
theorem algebraMap_norm_eq_mul_aut (h : Module.finrank F E = 2) {σ : E ≃ₐ[F] E} (hσ : σ ≠ 1)
    (x : E) : algebraMap F E (Algebra.norm F x) = x * σ x := by
  classical
  rw [Algebra.norm_eq_prod_automorphisms]
  have huniv : (Finset.univ : Finset (E ≃ₐ[F] E)) = {1, σ} := by
    refine (Finset.eq_univ_of_card _ ?_).symm
    rw [Finset.card_pair (Ne.symm hσ), card_aut_eq_two h]
  rw [huniv, Finset.prod_pair (Ne.symm hσ)]
  simp

/-- **The norm of an element of a quadratic Galois extension whose square lies in the base
field.** -/
theorem norm_eq_neg (h : Module.finrank F E = 2) {x : E} (hx : x ∉ Set.range (algebraMap F E))
    {a : F} (ha : x ^ 2 = algebraMap F E a) : Algebra.norm F x = -a := by
  obtain ⟨σ, hσ⟩ := exists_aut_ne_one h
  have h1 : algebraMap F E (Algebra.norm F x) = algebraMap F E (-a) := by
    rw [algebraMap_norm_eq_mul_aut h hσ, aut_apply_eq_neg h hσ hx ha, map_neg, ← ha]
    ring
  exact (algebraMap F E).injective h1

/-- **The norm of `u + v x` in a quadratic Galois extension.** -/
theorem norm_algebraMap_add_mul (h : Module.finrank F E = 2) {x : E}
    (hx : x ∉ Set.range (algebraMap F E)) {a : F} (ha : x ^ 2 = algebraMap F E a) (u v : F) :
    Algebra.norm F (algebraMap F E u + algebraMap F E v * x) = u ^ 2 - a * v ^ 2 := by
  obtain ⟨σ, hσ⟩ := exists_aut_ne_one h
  have hσx : σ x = -x := aut_apply_eq_neg h hσ hx ha
  have h1 : algebraMap F E (Algebra.norm F (algebraMap F E u + algebraMap F E v * x))
      = algebraMap F E (u ^ 2 - a * v ^ 2) := by
    rw [algebraMap_norm_eq_mul_aut h hσ]
    have hσu : σ (algebraMap F E u) = algebraMap F E u := AlgEquiv.commutes σ u
    have hσv : σ (algebraMap F E v) = algebraMap F E v := AlgEquiv.commutes σ v
    have hσuv : σ (algebraMap F E u + algebraMap F E v * x)
        = algebraMap F E u - algebraMap F E v * x := by
      rw [map_add, map_mul, hσu, hσv, hσx]
      ring
    rw [hσuv]
    rw [map_sub, map_mul, map_pow, map_pow, ← ha]
    ring
  exact (algebraMap F E).injective h1

/-- **A quadratic Galois extension of characteristic `≠ 2` is generated by an element `x ∉ F`
whose square lies in `F` and is not a square of `F`.** -/
theorem exists_gen_sq_mem (h2 : (2 : F) ≠ 0) (h : Module.finrank F E = 2) :
    ∃ (x : E) (a : F), x ≠ 0 ∧ x ∉ Set.range (algebraMap F E) ∧ x ^ 2 = algebraMap F E a ∧
      ¬ IsSquare a := by
  classical
  have h2E : (2 : E) ≠ 0 := by
    intro hzero
    apply h2
    have : (algebraMap F E) (2 : F) = (algebraMap F E) 0 := by
      rw [map_ofNat, map_zero, hzero]
    exact (algebraMap F E).injective this
  obtain ⟨σ, hσ⟩ := exists_aut_ne_one h
  have hσ2 : σ * σ = 1 := mul_self_eq_one_of_card_two (card_aut_eq_two h) hσ
  obtain ⟨x₀, hx₀⟩ : ∃ x₀ : E, σ x₀ ≠ x₀ := by
    by_contra hcon
    simp only [not_exists, not_ne_iff] at hcon
    exact hσ (AlgEquiv.ext hcon)
  set x : E := x₀ - σ x₀ with hxdef
  have hσx : σ x = -x := by
    rw [hxdef, map_sub, ← AlgEquiv.mul_apply, hσ2, AlgEquiv.one_apply]
    ring
  have hxne : x ≠ 0 := by
    intro hzero
    have h1 : x₀ - σ x₀ = 0 := by rw [← hxdef]; exact hzero
    exact hx₀ (sub_eq_zero.mp h1).symm
  have hfix : σ (x ^ 2) = x ^ 2 := by
    rw [map_pow, hσx]; ring
  have hmem : x ^ 2 ∈ Set.range (algebraMap F E) := mem_bot_of_aut_eq_self h hσ hfix
  obtain ⟨a, ha⟩ := hmem
  have hxnot : x ∉ Set.range (algebraMap F E) := by
    rintro ⟨b, hb⟩
    have h1 : σ x = x := by rw [← hb, AlgEquiv.commutes]
    rw [hσx] at h1
    have hxx : x + x = 0 := eq_neg_iff_add_eq_zero.mp h1.symm
    have h2x : (2 : E) * x = 0 := by rw [two_mul]; exact hxx
    rcases mul_eq_zero.mp h2x with h' | h'
    · exact h2E h'
    · exact hxne h'
  refine ⟨x, a, hxne, hxnot, ha.symm, ?_⟩
  rintro ⟨b, hb⟩
  have hb1 : a = b ^ 2 := by rw [hb]; ring
  have hb' : (algebraMap F E b) ^ 2 = x ^ 2 := by rw [← map_pow, ← hb1, ha]
  have hfac : (x - algebraMap F E b) * (x + algebraMap F E b) = 0 := by
    have : x ^ 2 - (algebraMap F E b) ^ 2 = 0 := by rw [hb']; ring
    linear_combination this
  rcases mul_eq_zero.mp hfac with h' | h'
  · exact hxnot ⟨b, (sub_eq_zero.mp h').symm⟩
  · exact hxnot ⟨-b, by rw [map_neg]; exact (eq_neg_of_add_eq_zero_left h').symm⟩

end Quadratic

end

end NK.NUV2.QuadFaithful
