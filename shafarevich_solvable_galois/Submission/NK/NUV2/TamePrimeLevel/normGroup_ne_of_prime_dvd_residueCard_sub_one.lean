/-!
## Auxiliary lemmas for the case `ℓ ∣ q - 1`

The main result of this file (`normGroup_ne_of_prime_dvd_residueCard_sub_one`) is proved by
Kummer theory.  The three ingredients proved here are:

* `finiteIndex_range_powMonoidHom_adicCompletion`: the group `Fˣ ⧸ (Fˣ)^ℓ` is *finite* (indeed of
  index at most `ℓ (q-1) q^n`) for every `ℓ ≥ 1`, where `F = Q.adicCompletion K` — Newton's method
  on `1 + 𝔪` shows that some higher unit group `U^n` consists of `ℓ`-th powers, and
  `⟨π^ℓ⟩ ⊔ U^n` then has explicitly finite index;
* `norm_adjoin_simple_root_of_pow_eq`: the norm of an `ℓ`-th root of `a` in `k⟮α⟯` is `a`
  (via `Algebra.norm_eq_prod_roots` and the explicit description of the roots of `X^ℓ - a`);
* `map_mk_normGroup_of_kummerFieldQuot_eq`: for a degree-`ℓ` Kummer level `M = k⟮α⟯` of `k`, the
  image of `N_{M/k} Mˣ` in `kˣ ⧸ (kˣ)^ℓ` is the cyclic subgroup generated by the Kummer class of
  `M`; this is the Kummer-theoretic description of the norm group used to compare two levels.
-/

/-! ### Finiteness of `Fˣ ⧸ (Fˣ)^ℓ` -/

/-- **The `ℓ`-th power subgroup of `Fˣ` has finite index** for `F = Q.adicCompletion K` and any
`ℓ ≥ 1`.

The proof uses no more than the local structure theory: Newton's method
(`NK.LocalReciprocityLubinTate.Units.exists_pow_eq_of_mem_maximalIdeal_pow`, which needs only
characteristic zero and `ℓ ≥ 1`) produces `n` with `U^n ≤ (Fˣ)^ℓ`, and for a uniformiser `π` the
group `⟨π^ℓ⟩ ⊔ U^n` has index `ℓ (q-1) q^{n-1}` by
`NK.LocalReciprocityLubinTate.Units.natCard_quotient_zpowers_pow_sup_higherUnits`. -/
theorem finiteIndex_range_powMonoidHom_adicCompletion {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (((powMonoidHom ℓ : (Q.adicCompletion K)ˣ →* (Q.adicCompletion K)ˣ)).range).FiniteIndex := by
  classical
  obtain ⟨n, hn⟩ := NK.LocalReciprocityLubinTate.Units.exists_pow_eq_of_mem_maximalIdeal_pow
    (Q.adicCompletion K) ℓ hℓ
  -- some higher unit group consists of `ℓ`-th powers
  have hU : NK.LocalReciprocityLubinTate.higherUnits (Q.adicCompletion K) (n + 1) ≤
      (powMonoidHom ℓ : (Q.adicCompletion K)ˣ →* (Q.adicCompletion K)ˣ).range := by
    intro u hu
    obtain ⟨v, hv, hv_eq⟩ := Subgroup.mem_map.mp hu
    rw [NK.LocalReciprocityLubinTate.mem_principalUnits_iff] at hv
    obtain ⟨x, hx, hxpow⟩ := hn ((v : ↥(ValuativeRel.valuation (Q.adicCompletion K)).integer) - 1)
      (Ideal.pow_le_pow_right (Nat.le_succ n) hv)
    have hxunit : IsUnit (1 + x : ↥(ValuativeRel.valuation (Q.adicCompletion K)).integer) := by
      rw [← IsLocalRing.notMem_maximalIdeal]
      intro hmem
      have h1 : (1 : ↥(ValuativeRel.valuation (Q.adicCompletion K)).integer) ∈
          NK.LocalReciprocityLubinTate.maximalIdealOfIntegers (Q.adicCompletion K) := by
        have hsub : (1 + x) - x = (1 : ↥(ValuativeRel.valuation (Q.adicCompletion K)).integer) := by
          ring
        rw [← hsub]
        exact sub_mem hmem hx
      exact (IsLocalRing.maximalIdeal.isMaximal _).ne_top (Ideal.eq_top_iff_one _ |>.mpr h1)
    have hpowunit : hxunit.unit ^ ℓ = v := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, IsUnit.unit_spec, hxpow]
      ring
    refine MonoidHom.mem_range.mpr ⟨Units.map
      (Subring.subtype (ValuativeRel.valuation (Q.adicCompletion K)).integer).toMonoidHom
      hxunit.unit, ?_⟩
    rw [powMonoidHom_apply, ← map_pow, hpowunit, ← hv_eq]
  obtain ⟨π, hπ⟩ := NK.LocalReciprocityLubinTate.exists_isUniformizer_adicCompletion Q
  have hKle : Subgroup.zpowers (π ^ ℓ) ⊔
      NK.LocalReciprocityLubinTate.higherUnits (Q.adicCompletion K) (n + 1) ≤
      (powMonoidHom ℓ : (Q.adicCompletion K)ˣ →* (Q.adicCompletion K)ˣ).range := by
    refine sup_le ?_ hU
    rw [Subgroup.zpowers_le]
    exact MonoidHom.mem_range.mpr ⟨π, rfl⟩
  have hcard : Nat.card ((Q.adicCompletion K)ˣ ⧸ (Subgroup.zpowers (π ^ ℓ) ⊔
      NK.LocalReciprocityLubinTate.higherUnits (Q.adicCompletion K) (n + 1))) =
      ℓ * (NK.LocalReciprocityLubinTate.residueCard (Q.adicCompletion K) - 1) *
        NK.LocalReciprocityLubinTate.residueCard (Q.adicCompletion K) ^ n := by
    have h := NK.LocalReciprocityLubinTate.Units.natCard_quotient_zpowers_pow_sup_higherUnits
      (Q.adicCompletion K) π hπ (ℓ - 1) n
    rwa [Nat.sub_add_cancel hℓ] at h
  have hq2 : 2 ≤ NK.LocalReciprocityLubinTate.residueCard (Q.adicCompletion K) := by
    haveI : Fintype 𝓀[Q.adicCompletion K] := Fintype.ofFinite _
    rw [NK.LocalReciprocityLubinTate.residueCard, Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hKne : (Subgroup.zpowers (π ^ ℓ) ⊔
      NK.LocalReciprocityLubinTate.higherUnits (Q.adicCompletion K) (n + 1)).index ≠ 0 := by
    rw [Subgroup.index_eq_card, hcard]
    refine Nat.mul_ne_zero (Nat.mul_ne_zero (by omega) (by omega)) ?_
    exact pow_ne_zero n (by omega)
  have hCne : ((powMonoidHom ℓ :
      (Q.adicCompletion K)ˣ →* (Q.adicCompletion K)ˣ).range).index ≠ 0 := by
    intro h0
    have hrel := Subgroup.relIndex_mul_index hKle
    rw [h0, mul_zero] at hrel
    exact hKne hrel.symm
  exact Subgroup.finiteIndex_iff.mpr hCne

/-! ### The norm of an `ℓ`-th root of `a` -/

/-- **The norm of an `ℓ`-th root of `a`.**

Let `k` be a field containing a primitive `ℓ`-th root of unity `ζ` (`ℓ` an odd prime), let `α` be
an element of a field extension with `α ^ ℓ = a ∈ kˣ` and `a` not an `ℓ`-th power in `k`.  Then the
norm of `α` from `k⟮α⟯` is `a`.

Since `X ^ ℓ - a` is irreducible over `k`, the minimal polynomial of `α` is `X ^ ℓ - a`, and
`Algebra.norm_eq_prod_roots` writes the norm as the product of the roots `ζ ^ i * α` of `X ^ ℓ - a`
in the ambient field; that product is `(∏_{i<ℓ} ζ ^ i) * α ^ ℓ = a`, the factor of roots of unity
being `ζ ^ (ℓ (ℓ-1)/2) = 1` because `ℓ` is odd. -/
theorem norm_adjoin_simple_root_of_pow_eq {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    {ℓ : ℕ} (hℓ : ℓ.Prime) (hodd : ℓ ≠ 2) {ζ : k} (hζ : IsPrimitiveRoot ζ ℓ)
    {a : kˣ} (ha : a ∉ NK.LocalAnabelian.powSubgroup ℓ k) {α : K'}
    (hα : α ^ ℓ = algebraMap k K' (a : k)) :
    algebraMap k K' (Algebra.norm k (⟨α, IntermediateField.mem_adjoin_simple_self k α⟩ :
      ↥(k⟮α⟯))) = algebraMap k K' (a : k) := by
  have hane : ∀ b : k, b ^ ℓ ≠ (a : k) := by
    intro b hb
    have hb0 : b ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero] at hb
      exact Units.ne_zero a hb.symm
    refine ha (MonoidHom.mem_range.mpr ⟨Units.mk0 b hb0, ?_⟩)
    rw [powMonoidHom_apply]
    ext
    simpa using hb
  have hirr : Irreducible (X ^ ℓ - C (a : k)) := X_pow_sub_C_irreducible_of_prime hℓ hane
  set L : IntermediateField k K' := k⟮α⟯ with hLdef
  set x : ↥L := ⟨α, IntermediateField.mem_adjoin_simple_self k α⟩ with hxdef
  have hxα : (algebraMap ↥L K') x = α := rfl
  have hxpow : x ^ ℓ = algebraMap k ↥L (a : k) := by
    apply (algebraMap ↥L K').injective
    rw [map_pow, hxα, hα]
    exact (IsScalarTower.algebraMap_apply k ↥L K' (a : k)).symm
  have hroot : aeval x (X ^ ℓ - C (a : k)) = 0 := by
    rw [map_sub, aeval_X_pow, aeval_C, hxpow, sub_self]
  have hminpoly : minpoly k x = X ^ ℓ - C (a : k) :=
    (minpoly.eq_of_irreducible_of_monic hirr hroot (monic_X_pow_sub_C _ hℓ.ne_zero)).symm
  have hζ' : IsPrimitiveRoot (algebraMap k K' ζ) ℓ :=
    hζ.map_of_injective (algebraMap k K').injective
  have hsplit : (Polynomial.map (algebraMap k K') (minpoly k x)).Splits := by
    rw [hminpoly, Polynomial.map_sub, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C]
    exact X_pow_sub_C_splits_of_isPrimitiveRoot hζ' hα
  have hnorm := Algebra.norm_eq_prod_roots (K := k) (L := ↥L) K' (x := x) hsplit
  rw [hnorm]
  have htop : (k⟮x⟯ : IntermediateField k ↥L) = ⊤ := by
    apply IntermediateField.lift_injective L
    rw [IntermediateField.lift_adjoin_simple, IntermediateField.lift_top]
  rw [htop, IntermediateField.finrank_top, pow_one]
  rw [hminpoly, Polynomial.aroots_def, Polynomial.map_sub, Polynomial.map_pow,
    Polynomial.map_X, Polynomial.map_C]
  show (Polynomial.nthRoots ℓ (algebraMap k K' (a : k))).prod = algebraMap k K' (a : k)
  rw [hζ'.nthRoots_eq hα]
  rw [show (Multiset.range ℓ).map (fun i => (algebraMap k K' ζ) ^ i * α) =
      (Finset.range ℓ).val.map (fun i => (algebraMap k K' ζ) ^ i * α) from by
    rw [Finset.range_val]]
  rw [← Finset.prod_eq_multiset_prod, Finset.prod_mul_distrib, Finset.prod_const,
    Finset.card_range, Finset.prod_pow_eq_pow_sum, Finset.sum_range_id, hα]
  have hodd' : Odd ℓ := hℓ.odd_of_ne_two hodd
  have h2 : (2 : ℕ) ∣ ℓ - 1 := by
    obtain ⟨m, hm⟩ := hodd'
    exact ⟨m, by omega⟩
  have hkey : (algebraMap k K' ζ) ^ (ℓ * (ℓ - 1) / 2) = 1 := by
    rw [Nat.mul_div_assoc ℓ h2, pow_mul, hζ'.pow_eq_one, one_pow]
  rw [hkey, one_mul]

/-! ### The Kummer field is the simple extension generated by a root -/

/-- The Kummer field of `a` is generated by any single `ℓ`-th root of `a`. -/
theorem kummerField_eq_adjoin_of_pow_eq {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    (ℓ : ℕ) (hℓ : ℓ.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ ℓ) {a : kˣ} {α : K'}
    (hα : α ^ ℓ = algebraMap k K' (a : k)) :
    NK.LocalAnabelian.kummerField (K' := K') ℓ a = k⟮α⟯ := by
  have hane : algebraMap k K' (a : k) ≠ 0 := by simp
  have hα0 : α ≠ 0 := by
    rintro rfl
    rw [zero_pow hℓ.ne_zero] at hα
    exact hane hα.symm
  refine le_antisymm ?_ ?_
  · rw [NK.LocalAnabelian.kummerField_le_iff]
    intro β hβ
    have hx : (β / α) ^ ℓ = 1 := by rw [div_pow, hβ, hα, div_self hane]
    have hmem : β / α ∈ nthRoots ℓ (1 : K') := (mem_nthRoots hℓ.pos).mpr hx
    rw [(hζ.map_of_injective (algebraMap k K').injective).nthRoots_eq
      (show (1 : K') ^ ℓ = 1 by simp)] at hmem
    simp only [Multiset.mem_map, Multiset.mem_range] at hmem
    obtain ⟨i, -, hβi⟩ := hmem
    rw [mul_one] at hβi
    have hβeq : β = algebraMap k K' (ζ ^ i) * α := by
      rw [map_pow, hβi, div_mul_cancel₀ β hα0]
    rw [hβeq]
    exact mul_mem (IntermediateField.algebraMap_mem _ (ζ ^ i))
      (IntermediateField.mem_adjoin_simple_self k α)
  · rw [IntermediateField.adjoin_simple_le_iff]
    exact NK.LocalAnabelian.mem_kummerField_of_pow_eq hα

/-! ### Membership of the Kummer class in the image of the norm group -/

/-- **The Kummer class of a degree-`ℓ` level is a norm.**

For `x ≠ 1` in `kˣ ⧸ (kˣ)^ℓ` and `M` the Kummer field of a representative `a` of `x`, the element
`a` — hence the class `x` — lies in the image of `N_{M/k} Mˣ` in `kˣ ⧸ (kˣ)^ℓ`.

Pick a root `α` of `X ^ ℓ - a`; then `M = k⟮α⟯` (`kummerField_eq_adjoin_of_pow_eq`), and
`a = N_{M/k}(α)` by `norm_adjoin_simple_root_of_pow_eq`. -/
theorem out_mem_normGroup_of_kummerFieldQuot_eq {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] [IsSepClosure k K'] {ℓ : ℕ} (hℓ : ℓ.Prime) (hodd : ℓ ≠ 2) {ζ : k}
    (hζ : IsPrimitiveRoot ζ ℓ) {x : NK.LocalAnabelian.KummerGroup ℓ k} (hx : x ≠ 1)
    {M : IntermediateField k K'}
    (hM : NK.LocalAnabelian.kummerFieldQuot (K' := K') ℓ x = M) :
    Quotient.out x ∈ NK.LocalReciprocity.normGroup k ↥M := by
  haveI hsep : IsSepClosed K' := IsSepClosure.sep_closed k
  set a : kˣ := Quotient.out x with hadef
  haveI : NeZero ((ℓ : ℕ) : K') := ⟨by
    have hchar : ℓ ≠ ringChar k :=
      NK.LocalAnabelian.Kummer.pow_ne_ringChar_of_isPrimitiveRoot ℓ hℓ hζ
    have hk : (ℓ : k) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime (R := k) hℓ hchar.symm
    intro h0
    exact hk ((algebraMap k K').injective (by rw [map_natCast, h0, map_zero]))⟩
  obtain ⟨α, hα⟩ := IsSepClosed.exists_pow_nat_eq (k := K') (algebraMap k K' (a : k)) ℓ
  have hfield : k⟮α⟯ = NK.LocalAnabelian.kummerFieldQuot (K' := K') ℓ x := by
    rw [NK.LocalAnabelian.kummerFieldQuot]
    exact (kummerField_eq_adjoin_of_pow_eq ℓ hℓ hζ hα).symm
  have hA := norm_adjoin_simple_root_of_pow_eq hℓ hodd hζ
    (NK.LocalAnabelian.notMem_powSubgroup_of_out_ne_one hx) hα
  have hnormk : Algebra.norm k (⟨α, IntermediateField.mem_adjoin_simple_self k α⟩ :
      ↥(k⟮α⟯)) = (a : k) := (algebraMap k K').injective hA
  have hmem : a ∈ NK.LocalReciprocity.normGroup k ↥(k⟮α⟯) := by
    rw [NK.LocalReciprocity.mem_normGroup_iff]
    refine ⟨Units.mk0 ⟨α, IntermediateField.mem_adjoin_simple_self k α⟩ ?_, ?_⟩
    · intro h
      have h0 : α = 0 := congrArg Subtype.val h
      rw [h0, zero_pow hℓ.ne_zero] at hα
      exact (by simp : algebraMap k K' (a : k) ≠ 0) hα.symm
    · exact hnormk
  rw [← hM]
  rw [← NK.LocalReciprocity.normGroup_eq_of_algEquiv (IntermediateField.equivOfEq hfield)]
  exact hmem

/-! ### The norm group of a degree-`ℓ` Kummer level -/

/-- **The image of the norm group of a degree-`ℓ` Kummer level is the Kummer class group of the
level.**

Let `k` be a field with a primitive `ℓ`-th root of unity `ζ` (`ℓ` an odd prime), let `K'` be a
separable closure of `k`, and let `M` be the Kummer field of a nontrivial class
`x ∈ kˣ ⧸ (kˣ)^ℓ`.  Assume that

* the norm index theorem `[kˣ : N_{M/k} Mˣ] = ℓ` holds for `M`, and
* `(kˣ)^ℓ` has finite index `≤ ℓ²` in `kˣ`.

Then the image of `N_{M/k} Mˣ` in `kˣ ⧸ (kˣ)^ℓ` is the cyclic subgroup generated by `x`.

Indeed `(kˣ)^ℓ ≤ N(M)` (`pow_finrank_mem_normGroup`, `[M : k] = ℓ`) and the class of a
representative of `x` is a norm (`out_mem_normGroup_of_kummerFieldQuot_eq`), so `N(M)/(kˣ)^ℓ` is a
subgroup of `kˣ/(kˣ)^ℓ` containing the order-`ℓ` element `x`; the index identity
`[N(M) : (kˣ)^ℓ] · [kˣ : N(M)] = [kˣ : (kˣ)^ℓ] ≤ ℓ²` together with the finiteness of the index of
`(kˣ)^ℓ` bounds it by `ℓ`, forcing equality. -/
theorem map_mk_normGroup_of_kummerFieldQuot_eq {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] [IsSepClosure k K'] (ℓ : ℕ) (hℓ : ℓ.Prime) (hodd : ℓ ≠ 2) {ζ : k}
    (hζ : IsPrimitiveRoot ζ ℓ) {x : NK.LocalAnabelian.KummerGroup ℓ k} (hx : x ≠ 1)
    {M : IntermediateField k K'}
    (hM : NK.LocalAnabelian.kummerFieldQuot (K' := K') ℓ x = M)
    (hidx : (NK.LocalReciprocity.normGroup k ↥M).index = ℓ)
    (hC : (NK.LocalAnabelian.powSubgroup ℓ k).index ≤ ℓ ^ 2)
    (hCne : (NK.LocalAnabelian.powSubgroup ℓ k).index ≠ 0) :
    Subgroup.map (QuotientGroup.mk' (NK.LocalAnabelian.powSubgroup ℓ k))
      (NK.LocalReciprocity.normGroup k ↥M)
      = Subgroup.zpowers x := by
  classical
  set C := NK.LocalAnabelian.powSubgroup ℓ k with hCdef
  set N := NK.LocalReciprocity.normGroup k ↥M with hNdef
  have hgal := NK.LocalAnabelian.kummerFieldQuot_isGalois_finrank (K' := K') ℓ hℓ hζ hx
  have hfin : Module.finrank k ↥M = ℓ := by rw [← hM]; exact hgal.2
  haveI hfd : FiniteDimensional k ↥M :=
    FiniteDimensional.of_finrank_pos (by rw [hfin]; exact hℓ.pos)
  -- `(kˣ)^ℓ ≤ N(M)`
  have hCN : C ≤ N := by
    intro y hy
    obtain ⟨u, rfl⟩ := MonoidHom.mem_range.mp hy
    have hpow : u ^ Module.finrank k ↥M ∈ N := by
      rw [hNdef]
      exact NK.Summary.NUV2.pow_finrank_mem_normGroup M u
    rwa [hfin] at hpow
  have haN : Quotient.out x ∈ N := out_mem_normGroup_of_kummerFieldQuot_eq hℓ hodd hζ hx hM
  -- the image of the norm group in the Kummer class group
  set H := Subgroup.map (QuotientGroup.mk' C) N with hHdef
  have hcomap : Subgroup.comap (QuotientGroup.mk' C) H = N := by
    rw [hHdef, Subgroup.comap_map_eq]
    rw [show (QuotientGroup.mk' C).ker = C from QuotientGroup.ker_mk' C, sup_eq_left.mpr hCN]
  have hHindex : H.index = ℓ := by
    rw [← Subgroup.index_comap_of_surjective H (QuotientGroup.mk'_surjective C), hcomap, hNdef]
    exact hidx
  have hcardHN : Nat.card ↥H * ℓ = C.index := by
    have h1 : Nat.card ↥H * H.index = Nat.card (kˣ ⧸ C) := Subgroup.card_mul_index H
    rwa [hHindex, ← Subgroup.index_eq_card C] at h1
  have hcardH : Nat.card ↥H ≤ ℓ := by
    rw [pow_two] at hC
    exact Nat.le_of_mul_le_mul_right (by rw [hcardHN]; exact hC) hℓ.pos
  have hHne : Nat.card ↥H ≠ 0 := by
    intro h0
    rw [h0, zero_mul] at hcardHN
    exact hCne hcardHN.symm
  haveI hfinH : Finite ↥H := (Nat.card_ne_zero.mp hHne).2
  -- `x` lies in the image
  have hxH : x ∈ H := by
    rw [hHdef, Subgroup.mem_map]
    exact ⟨Quotient.out x, haN, by rw [QuotientGroup.mk'_apply]; exact Quotient.out_eq x⟩
  have hle : Subgroup.zpowers x ≤ H := Subgroup.zpowers_le.mpr hxH
  have hcardz : Nat.card ↥(Subgroup.zpowers x) = ℓ := by
    rw [Nat.card_zpowers]
    have hdvd : orderOf x ∣ ℓ :=
      orderOf_dvd_iff_pow_eq_one.mpr (NK.LocalAnabelian.kummerGroup_pow_self ℓ x)
    rcases hℓ.eq_one_or_self_of_dvd (orderOf x) hdvd with hh | hh
    · exact absurd (orderOf_eq_one_iff.mp hh) hx
    · exact hh
  have hinj : Function.Injective (fun a : ↥(Subgroup.zpowers x) => (⟨a.1, hle a.2⟩ : ↥H)) := by
    intro a b hab
    have h1 : (a.1 : NK.LocalAnabelian.KummerGroup ℓ k) = b.1 :=
      congrArg (fun z : ↥H => (z.1 : NK.LocalAnabelian.KummerGroup ℓ k)) hab
    exact Subtype.ext h1
  have hcardle : ℓ ≤ Nat.card ↥H := by
    rw [← hcardz]
    exact Nat.card_le_card_of_injective _ hinj
  have hcardeq : Nat.card ↥(Subgroup.zpowers x) = Nat.card ↥H := by
    rw [hcardz]; exact Nat.le_antisymm hcardle hcardH
  exact (NK.LocalAnabelian.Kummer.eq_of_le_of_natCard_eq_of_ne_zero hHne hle hcardeq).symm

/-! ### The main result -/

/-- **Case `ℓ ∣ q - 1` of `normGroup_ne_of_finrank_eq_prime_tame`.**  For `F = Q.adicCompletion K`
and an odd prime `ℓ` dividing `q - 1` (`q = NK.LocalStructure.residueCard K Q`), two distinct
normal levels of `F^{ab}` of degree `ℓ` have distinct norm groups.  Here one may assume the bound
`hV : [Fˣ : (Fˣ)^ℓ] ≤ ℓ²` (`(Fˣ)^ℓ = (powMonoidHom ℓ).range`); it is supplied for the intended
application by `NK.NUV2.TamePrimeLevel.index_range_powMonoidHom_le_sq`.

Proof plan.

* `ℓ ∣ q - 1` gives a primitive `ℓ`-th root of unity `ζ ∈ F`
  (`NK.TameStructureDeep.Tame.exists_isPrimitiveRoot_adicCompletion_self` for the primitive
  `(q-1)`-st root of unity, then `IsPrimitiveRoot.pow`).
* `Normal` plus finite-dimensionality over the characteristic-`0` field `F` makes `Lᵢ/F` Galois;
  `Gal(Lᵢ/F)` has prime order `ℓ`, hence is cyclic, and the Kummer theory of Mathlib
  (`KummerExtension.exists_root_adjoin_eq_top_of_isCyclic`) gives `αᵢ ∈ Lᵢ` with `αᵢ ^ ℓ = aᵢ ∈ F`
  and `F⟮αᵢ⟯ = ⊤`.
* `N(αᵢ) = aᵢ`: with `σ` generating `Gal(Lᵢ/F)` and `ζᵢ = σ αᵢ / αᵢ` a primitive `ℓ`-th root of
  unity, `N(αᵢ) = ∏_{j<ℓ} σ^j αᵢ = αᵢ ^ ℓ * ζᵢ ^ (ℓ(ℓ-1)/2) = aᵢ` since `ℓ` is odd.
* `(Fˣ)^ℓ ⊆ N(Lᵢ)` (tower identity, `NK.Summary.NUV2.pow_finrank_mem_normGroup`) and
  `[Fˣ : N(Lᵢ)] = ℓ` (`normIndex_adicCompletion`), so
  `[N(Lᵢ) : (Fˣ)^ℓ] = [Fˣ : (Fˣ)^ℓ] / ℓ ≤ ℓ`.  As `aᵢ ∉ (Fˣ)^ℓ` (otherwise `Lᵢ = F`), the subgroup
  `N(Lᵢ)/(Fˣ)^ℓ` contains the order-`ℓ` element `aᵢ (Fˣ)^ℓ`, hence equals it:
  `N(Lᵢ) = ⟨aᵢ⟩ * (Fˣ)^ℓ`.
* If `N(L₁) = N(L₂)` then `a₁` and `a₂` generate the same cyclic subgroup of `Fˣ/(Fˣ)^ℓ`, so
  `a₁ = a₂ ^ j * c ^ ℓ`; taking `ℓ`-th roots gives `α₁ = α₂ ^ j * c * ζ'` with `ζ' ^ ℓ = 1` and
  `ζ' ∈ μ_ℓ ⊆ F`, whence `L₁ = F⟮α₁⟯ = F⟮α₂⟯ = L₂`, contradicting `hne`. -/
theorem normGroup_ne_of_prime_dvd_residueCard_sub_one
    {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (ℓ : ℕ) (hℓ : ℓ.Prime) (hodd : ℓ ≠ 2)
    (hdvd : ℓ ∣ NK.LocalStructure.residueCard K Q - 1)
    (hV : (((powMonoidHom ℓ : (Q.adicCompletion K)ˣ →* (Q.adicCompletion K)ˣ)).range).index ≤ ℓ ^ 2)
    (L₁ L₂ : IntermediateField (Q.adicCompletion K)
      (NK.LocalReciprocity.maxAbelianSubext (Q.adicCompletion K)
        (SeparableClosure (Q.adicCompletion K))))
    [FiniteDimensional (Q.adicCompletion K) ↥L₁] [Normal (Q.adicCompletion K) ↥L₁]
    [FiniteDimensional (Q.adicCompletion K) ↥L₂] [Normal (Q.adicCompletion K) ↥L₂]
    (h₁ : Module.finrank (Q.adicCompletion K) ↥L₁ = ℓ)
    (h₂ : Module.finrank (Q.adicCompletion K) ↥L₂ = ℓ)
    (hne : L₁ ≠ L₂) :
    NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥L₁
      ≠ NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥L₂ := by
  intro hN
  set F := Q.adicCompletion K with hFdef
  -- a primitive `ℓ`-th root of unity in `F`, from `ℓ ∣ q - 1`
  obtain ⟨ζ₀, hζ₀⟩ := NK.TameStructureDeep.Tame.exists_isPrimitiveRoot_adicCompletion_self K Q
  obtain ⟨k, hk⟩ := hdvd
  have hq2 : 2 ≤ NK.LocalStructure.residueCard K Q :=
    NK.TameStructureDeep.Tame.two_le_residueCard_adicCompletion K Q
  have hζ : IsPrimitiveRoot (ζ₀ ^ k) ℓ :=
    hζ₀.pow (n := NK.LocalStructure.residueCard K Q - 1) (a := k) (b := ℓ)
      (by omega) (by rw [mul_comm]; exact hk)
  -- the index of the `ℓ`-th powers is finite
  have hCne : (((powMonoidHom ℓ : Fˣ →* Fˣ)).range).index ≠ 0 :=
    Subgroup.finiteIndex_iff.mp (finiteIndex_range_powMonoidHom_adicCompletion Q ℓ hℓ.one_le)
  -- the two levels, transported into the separable closure of `F`
  have hgal₁ : IsGalois F ↥(NK.LocalReciprocity.levelMap L₁) :=
    isGalois_iff.mpr ⟨inferInstance, inferInstance⟩
  have hgal₂ : IsGalois F ↥(NK.LocalReciprocity.levelMap L₂) :=
    isGalois_iff.mpr ⟨inferInstance, inferInstance⟩
  have hfin₁ : Module.finrank F ↥(NK.LocalReciprocity.levelMap L₁) = ℓ :=
    (NK.LocalReciprocity.levelEquiv L₁).toLinearEquiv.finrank_eq.symm.trans h₁
  have hfin₂ : Module.finrank F ↥(NK.LocalReciprocity.levelMap L₂) = ℓ :=
    (NK.LocalReciprocity.levelEquiv L₂).toLinearEquiv.finrank_eq.symm.trans h₂
  obtain ⟨x₁, hx₁ne, hx₁eq⟩ : ∃ x : NK.LocalAnabelian.KummerGroup ℓ F, x ≠ 1 ∧
      NK.LocalAnabelian.kummerFieldQuot (K' := SeparableClosure F) ℓ x
        = NK.LocalReciprocity.levelMap L₁ :=
    NK.LocalAnabelian.exists_ne_one_kummerFieldQuot_eq (K' := SeparableClosure F)
      ℓ hℓ hζ ⟨NK.LocalReciprocity.levelMap L₁, hgal₁, hfin₁⟩
  obtain ⟨x₂, hx₂ne, hx₂eq⟩ : ∃ x : NK.LocalAnabelian.KummerGroup ℓ F, x ≠ 1 ∧
      NK.LocalAnabelian.kummerFieldQuot (K' := SeparableClosure F) ℓ x
        = NK.LocalReciprocity.levelMap L₂ :=
    NK.LocalAnabelian.exists_ne_one_kummerFieldQuot_eq (K' := SeparableClosure F)
      ℓ hℓ hζ ⟨NK.LocalReciprocity.levelMap L₂, hgal₂, hfin₂⟩
  -- the norm index theorem at the two levels
  have hidx₁ : (NK.LocalReciprocity.normGroup F
      ↥(NK.LocalReciprocity.levelMap L₁)).index = ℓ := by
    rw [← NK.LocalReciprocity.normGroup_levelMap L₁]
    rw [NK.LocalReciprocityLubinTate.NormIndex.normIndex_adicCompletion Q L₁, h₁]
  have hidx₂ : (NK.LocalReciprocity.normGroup F
      ↥(NK.LocalReciprocity.levelMap L₂)).index = ℓ := by
    rw [← NK.LocalReciprocity.normGroup_levelMap L₂]
    rw [NK.LocalReciprocityLubinTate.NormIndex.normIndex_adicCompletion Q L₂, h₂]
  -- the Kummer classes determine the norm groups
  have hmap₁ := map_mk_normGroup_of_kummerFieldQuot_eq (k := F) (K' := SeparableClosure F)
    ℓ hℓ hodd hζ hx₁ne hx₁eq hidx₁ hV hCne
  have hmap₂ := map_mk_normGroup_of_kummerFieldQuot_eq (k := F) (K' := SeparableClosure F)
    ℓ hℓ hodd hζ hx₂ne hx₂eq hidx₂ hV hCne
  -- from the assumed equality of the norm groups
  have hEq : NK.LocalReciprocity.normGroup F
      ↥(NK.LocalReciprocity.levelMap L₁) =
      NK.LocalReciprocity.normGroup F ↥(NK.LocalReciprocity.levelMap L₂) := by
    rw [← NK.LocalReciprocity.normGroup_levelMap L₁,
      ← NK.LocalReciprocity.normGroup_levelMap L₂]
    exact hN
  have hzp : Subgroup.zpowers x₁ = Subgroup.zpowers x₂ := by
    rw [← hmap₁, ← hmap₂, hEq]
  have hmem : x₁ ∈ Subgroup.zpowers x₂ := by rw [← hzp]; exact Subgroup.mem_zpowers x₁
  have hfields : NK.LocalAnabelian.kummerFieldQuot (K' := SeparableClosure F) ℓ x₁
      = NK.LocalAnabelian.kummerFieldQuot (K' := SeparableClosure F) ℓ x₂ :=
    NK.LocalAnabelian.Kummer.kummerFieldQuot_eq_of_mem_zpowers ℓ hℓ hζ hx₂ne hx₁ne hmem
  have hM : NK.LocalReciprocity.levelMap L₁ = NK.LocalReciprocity.levelMap L₂ := by
    rw [← hx₁eq, ← hx₂eq]
    exact hfields
  exact hne (IntermediateField.map_injective
    (IntermediateField.val (NK.LocalReciprocity.maxAbelianSubext (Q.adicCompletion K)
      (SeparableClosure (Q.adicCompletion K)))) hM)

end

end NK.NUV2.TamePrimeLevel
