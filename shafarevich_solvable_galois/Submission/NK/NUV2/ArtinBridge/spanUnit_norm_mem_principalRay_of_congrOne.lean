namespace NK.NUV2.ArtinBridge

open scoped NumberField
open NumberField IsDedekindDomain

/-- **The congruence predicate of the principal ray is membership of the principal idèle in the
congruence subgroup.**  `CongrOne m b` — the `𝔭`-adic congruence `b ≡ 1 mod (m)` at every prime
`(m) ⊆ 𝔭`, together with the total positivity of `b` — is exactly the statement that the
principal idèle `(b)` lies in the congruence subgroup `U_m` of the idèles. -/
lemma congrOne_iff_principalIdele_mem_congruenceSubgroup {K : Type*} [Field K] [NumberField K]
    (m : ℕ) (b : Kˣ) :
    NK.CFTLib.ArtinReciprocityIdeal.CongrOne m b ↔
      NK.GlobalCFT.Idele.principalIdele K b ∈ NK.CFTLib.Arl.congruenceSubgroup K m := by
  rw [NK.CFTLib.ArtinReciprocityIdeal.CongrOne]
  refine ⟨fun h => ⟨fun 𝔭 h𝔭 => ?_, fun w hw => ?_⟩,
    fun h => ⟨fun 𝔭 h𝔭 => ?_, fun w hw => ?_⟩⟩
  · simpa using h.1 𝔭 h𝔭
  · simpa [NK.CFTLib.Arl.PosAtReal] using h.2 w hw
  · simpa using h.1 𝔭 h𝔭
  · simpa [NK.CFTLib.Arl.PosAtReal] using h.2 w hw

/-- **The congruence subgroups decrease with the modulus.**  If `m ∣ m'` then the idèles
congruent to `1` modulo `m'` are congruent to `1` modulo `m`: the primes dividing `(m)` also
divide `(m')`, and `v_𝔭 ((m') ) ≤ v_𝔭 (m)`. -/
lemma congruenceSubgroup_le_of_dvd {K : Type*} [Field K] [NumberField K] {m m' : ℕ}
    (hdvd : m ∣ m') :
    NK.CFTLib.Arl.congruenceSubgroup K m' ≤ NK.CFTLib.Arl.congruenceSubgroup K m := by
  intro x hx
  obtain ⟨k, hk⟩ := hdvd
  refine ⟨fun 𝔭 h𝔭 => ?_, fun w => hx.2 w⟩
  have h𝔭' : ((m' : ℕ) : 𝓞 K) ∈ 𝔭.asIdeal := by
    rw [hk, Nat.cast_mul]
    exact Ideal.mul_mem_right _ _ h𝔭
  have hval : Valued.v (((m' : ℕ) : 𝔭.adicCompletion K)) ≤
      Valued.v (((m : ℕ) : 𝔭.adicCompletion K)) := by
    rw [hk, Nat.cast_mul, map_mul]
    calc Valued.v (((m : ℕ) : 𝔭.adicCompletion K)) *
          Valued.v (((k : ℕ) : 𝔭.adicCompletion K))
        ≤ Valued.v (((m : ℕ) : 𝔭.adicCompletion K)) * 1 :=
          mul_le_mul_of_nonneg_left (NK.CFTLib.Arl.val_natCast_le_one 𝔭 k) zero_le
      _ = Valued.v (((m : ℕ) : 𝔭.adicCompletion K)) := mul_one _
  exact (hx.1 𝔭 h𝔭').trans hval

/-- **Norm descent for the principal ray** (the "norming down" step of the Lang/Childress transfer argument). Let `E/K` be a finite extension of number fields, `0 < m'` and `m ∣ m'` natural numbers, and `β ∈ Eˣ` an element congruent to `1` modulo `m'` (in the sense of `CongrOne`: `β - 1` is divisible by `m'` in every adic completion at a prime containing `(m')`, and `β` is positive at every real place). Then the principal ideal of `K` generated by the norm `N_{E/K}(β)` lies in the principal ray `principalRay K m`.

The hypothesis `0 < m'` is necessary: for `m' = 0` the congruence condition is vacuous (`v (β - 1) ≤ v 0` holds for all `β`) and the statement fails, e.g. `K = E = ℚ`, `m = 5`, `m' = 0`, `β = 2`. This is the corrected form of `NK.CFTLib.ArtinReciprocityIdeal.norm_principalRay_le` (which is stated without `0 < m'` and is false for that reason).

Suggested route: `β = 1 + δ` with `v(δ) ≤ v(m')`; the norm of `1 + δ` is `1 + (element of valuation ≤ v(δ))` (expand `∏_σ (1 + σδ) - 1` as a sum of products each containing a factor `σδ`, and use the ultrametric inequality), hence `Nβ ≡ 1 mod m'`, and `m ∣ m'` upgrades this to `≡ 1 mod m`; total positivity of `Nβ` follows since each real conjugate factor is positive and complex conjugates contribute `|·|²`. Then unwind `principalRay` as a `Subgroup.closure` and use `spanUnit` multiplicativity. -/
theorem spanUnit_norm_mem_principalRay_of_congrOne {K E : Type*} [Field K] [NumberField K]
    [Field E] [NumberField E] [Algebra K E] [FiniteDimensional K E]
    {m m' : ℕ} (hm' : 0 < m') (hdvd : m ∣ m') (β : Eˣ)
    (hcong : NK.CFTLib.ArtinReciprocityIdeal.CongrOne (K := E) m' β) :
    NK.CFTLib.ArtinReciprocityIdeal.spanUnit (K := K) (Units.map (Algebra.norm K) β) ∈
      NK.CFTLib.ArtinReciprocityIdeal.principalRay K m := by
  -- the principal idèle of `β` lies in the congruence subgroup of `E` of modulus `m'`
  have hmem : NK.GlobalCFT.Idele.principalIdele E β ∈
      NK.CFTLib.Arl.congruenceSubgroup E m' :=
    (congrOne_iff_principalIdele_mem_congruenceSubgroup (K := E) m' β).mp hcong
  -- the idèlic norm of a congruence-`1` idèle is congruent to `1`
  have hnorm : NK.GlobalCFT.Idele.normIdeleHom K E
      (NK.GlobalCFT.Idele.principalIdele E β) ∈
      NK.CFTLib.Arl.congruenceSubgroup K m' :=
    NK.CFTLib.Arl.normIdeleHom_mem_congruenceSubgroup (K := K) (L := E) m' hm' hmem
  rw [NK.GlobalCFT.Idele.normIdeleHom_principalIdele (K := K) (L := E)] at hnorm
  -- the modulus `m'` is a multiple of `m`, so we may descend to the modulus `m`
  have hfin : NK.GlobalCFT.Idele.principalIdele K (Units.map (Algebra.norm K) β) ∈
      NK.CFTLib.Arl.congruenceSubgroup K m :=
    congruenceSubgroup_le_of_dvd hdvd hnorm
  -- back to the principal ray
  exact Subgroup.subset_closure ⟨Units.map (Algebra.norm K) β,
    (congrOne_iff_principalIdele_mem_congruenceSubgroup (K := K) m
      (Units.map (Algebra.norm K) β)).mpr hfin, rfl⟩

end NK.NUV2.ArtinBridge
