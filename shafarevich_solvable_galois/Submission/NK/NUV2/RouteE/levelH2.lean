/-!
# `H²(Gal(E/F), Eˣ)` is cyclic of order `[E : F]` at a finite abelian local level

For a finite abelian Galois extension `E/F` of `p`-adic fields over `F = Q.adicCompletion K`, the
second cohomology `H²(Gal(E/F), Eˣ)` of the units is cyclic of order `[E : F]` (local class field
theory: `H²(Gal(E/F), Eˣ) ≅ (1/[E:F])ℤ/ℤ`).  This is the numerical input `L1` of the
character-formula route to the local reciprocity law: it makes the `ℚ/ℤ`-valued invariant
`NK.NUV2.RouteC.invariantOf` attached to a *generator* available at every level.

The two numerical bounds are the local fundamental class
(`groupCohomology_two_units_ge_finrank`) and the abelian upper bound
(`natCard_groupCohomology_two_units_le_finrank_of_abelian`); the element of maximal order is
`exists_addOrderOf_eq_finrank_groupCohomology_two_units_aux` (Milne, *CFT*, III.2).
-/

namespace NK.NUV2.RouteE

/-- **`L1`: at a finite abelian level of a `p`-adic field, `H²` of the units is cyclic of order the
degree.**  More precisely: its cardinality is `[E : F]`, and it has an element of that additive
order (so it is cyclic, generated by `u`). -/
theorem h2_cyclic_level {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    {F E : Type} [Field F] [Field E]
    [Algebra (Q.adicCompletion K) F] [Algebra F E] [Algebra (Q.adicCompletion K) E]
    [IsScalarTower (Q.adicCompletion K) F E]
    [FiniteDimensional (Q.adicCompletion K) F] [FiniteDimensional F E]
    [FiniteDimensional (Q.adicCompletion K) E] [IsGalois F E]
    (hcomm : ∀ σ τ : E ≃ₐ[F] E, σ * τ = τ * σ) :
    Nat.card (groupCohomology (Rep.ofAlgebraAutOnUnits F E) 2) = Module.finrank F E ∧
      ∃ u : groupCohomology (Rep.ofAlgebraAutOnUnits F E) 2,
        addOrderOf u = Module.finrank F E := by
  refine ⟨le_antisymm ?_ ?_, ?_⟩
  · exact Commons.NumberTheory.NumberField.Completion.natCard_groupCohomology_two_units_le_finrank_of_abelian
      (Q := Q) (B := F) (E := E) hcomm
  · exact Commons.NumberTheory.NumberField.Completion.groupCohomology_two_units_ge_finrank
      (Q := Q) (F := F) (E := E)
  · exact Commons.NumberTheory.NumberField.Completion.ArtinMap.exists_addOrderOf_eq_finrank_groupCohomology_two_units_aux
      (Q := Q) (F := F) (E := E)

end NK.NUV2.RouteE
