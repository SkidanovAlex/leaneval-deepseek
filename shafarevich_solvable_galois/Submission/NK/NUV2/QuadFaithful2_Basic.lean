noncomputable section

variable {K : Type} [Field K] [NumberField K]

/-! ## The quadratic level `F(√c)` of a unit, and its norm group

For a `p`-adic field `F = Q.adicCompletion K` and `c ∈ Fˣ` we let `F(√c) ≤ F^{ab}` be the
quadratic level generated by a square root of `c` (the trivial level when `c` is a square), and
write `qNorm c` for its norm group.  The structural facts proved here are:

* `qNorm_index`: for `c` a non-square, `[Fˣ : N] = 2` (the norm index theorem);
* `mem_qNorm_iff`: `x ∈ qNorm c` iff `x` is represented by the norm form `u ^ 2 - c * v ^ 2`;
* `mem_qNorm_comm`: **symmetry** — for non-squares `x, c`, `x ∈ qNorm c ↔ c ∈ qNorm x`;
* `qNorm_injective`: the norm group determines the square class.

The symmetry is the elementary ingredient that replaces the classical non-degeneracy of the
Hilbert symbol: the relation `x ∈ N_{F(√c)}` is *symmetric* in `x` and `c`, and for fixed `c` the
map `x ↦ [x ∈ N_{F(√c)}]` is a homomorphism because `N_{F(√c)}` is a subgroup of index `2`.  Hence
`c ↦ qNorm c` is injective on the non-squares. -/

section QuadLevels

variable (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))

local instance : CharZero (Q.adicCompletion K) :=
  Commons.NumberTheory.NumberField.charZero_adicCompletion Q

/-- The maximal abelian subextension `F^{ab}` of a separable closure of `F = Q.adicCompletion K`. -/
abbrev qAbs : IntermediateField (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K)) :=
  NK.LocalReciprocity.maxAbelianSubext (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K))

/-- A square root of a unit of `F` in the separable closure. -/
theorem exists_sqroot (c : (Q.adicCompletion K)ˣ) :
    ∃ y : SeparableClosure (Q.adicCompletion K),
      y * y = algebraMap (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K))
        (c : Q.adicCompletion K) := by
  haveI h2 : NeZero (2 : SeparableClosure (Q.adicCompletion K)) := by
    refine ⟨fun h => NeZero.ne (2 : Q.adicCompletion K) ?_⟩
    have hmap : algebraMap (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K))
        (2 : Q.adicCompletion K) = 0 := by
      rw [map_ofNat, h]
    exact (algebraMap (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K))).injective
      (hmap.trans (map_zero _).symm)
  haveI : IsSepClosed (SeparableClosure (Q.adicCompletion K)) :=
    IsSepClosure.sep_closed (Q.adicCompletion K)
  obtain ⟨z, hz⟩ := IsSepClosed.exists_eq_mul_self
    (algebraMap (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K)) (c : Q.adicCompletion K))
  exact ⟨z, hz.symm⟩

/-- A chosen square root of a unit in the separable closure. -/
noncomputable def sqUnit (c : (Q.adicCompletion K)ˣ) : SeparableClosure (Q.adicCompletion K) :=
  Classical.choose (exists_sqroot Q c)

theorem sqUnit_mul_self (c : (Q.adicCompletion K)ˣ) :
    sqUnit Q c * sqUnit Q c = algebraMap (Q.adicCompletion K) (SeparableClosure (Q.adicCompletion K))
      (c : Q.adicCompletion K) :=
  Classical.choose_spec (exists_sqroot Q c)

/-- The square root of `c` viewed as an element of `F^{ab}`. -/
noncomputable def sqMem (c : (Q.adicCompletion K)ˣ) : ↥(qAbs Q) :=
  ⟨sqUnit Q c, NK.NUV2.LC.mem_maxAbelianSubext_of_sq (sqUnit Q c) (c : Q.adicCompletion K)
    (sqUnit_mul_self Q c)⟩

theorem sqMem_mul_self (c : (Q.adicCompletion K)ˣ) :
    sqMem Q c * sqMem Q c =
      algebraMap (Q.adicCompletion K) ↥(qAbs Q) (c : Q.adicCompletion K) :=
  NK.NUV2.LC.quadLevel_coe_mul_self (sqUnit Q c) (c : Q.adicCompletion K) (sqUnit_mul_self Q c)

/-- **The quadratic level `F(√c)` of `c ∈ Fˣ`**, as a level of `F^{ab}`. -/
noncomputable def qLevel (c : (Q.adicCompletion K)ˣ) : IntermediateField (Q.adicCompletion K) ↥(qAbs Q) :=
  NK.NUV2.LC.quadLevel (sqUnit Q c) (c : Q.adicCompletion K) (sqUnit_mul_self Q c)

theorem qLevel_def (c : (Q.adicCompletion K)ˣ) :
    qLevel Q c = IntermediateField.adjoin (Q.adicCompletion K) {sqMem Q c} := rfl

instance qLevel_finiteDimensional (c : (Q.adicCompletion K)ˣ) :
    FiniteDimensional (Q.adicCompletion K) ↥(qLevel Q c) :=
  NK.NUV2.LC.quadLevel_finiteDimensional (sqUnit Q c) (c : Q.adicCompletion K)
    (sqUnit_mul_self Q c)

instance qLevel_normal (c : (Q.adicCompletion K)ˣ) :
    Normal (Q.adicCompletion K) ↥(qLevel Q c) :=
  NK.NUV2.LC.quadLevel_normal (sqUnit Q c) (c : Q.adicCompletion K) (sqUnit_mul_self Q c)

instance qLevel_isGalois (c : (Q.adicCompletion K)ˣ) :
    IsGalois (Q.adicCompletion K) ↥(qLevel Q c) :=
  NK.LocalCFT.NormGroup.instIsGaloisLevelOfMaxAbelian (qLevel Q c)

/-- The generator of `F(√c)`. -/
noncomputable def qGen (c : (Q.adicCompletion K)ˣ) : ↥(qLevel Q c) :=
  ⟨sqMem Q c, by
    rw [qLevel_def]
    exact IntermediateField.subset_adjoin (Q.adicCompletion K) {sqMem Q c} (Set.mem_singleton _)⟩

theorem qGen_sq (c : (Q.adicCompletion K)ˣ) :
    qGen Q c ^ 2 = algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (c : Q.adicCompletion K) := by
  rw [pow_two]
  apply Subtype.ext
  exact sqMem_mul_self Q c

/-- **The norm group `N_{F(√c)/F} F(√c)ˣ`.** -/
noncomputable abbrev qNorm (c : (Q.adicCompletion K)ˣ) : Subgroup (Q.adicCompletion K)ˣ :=
  NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(qLevel Q c)

/-! ### `qGen` is not a base-field element, and `F(√c)` has degree two -/

theorem sqMem_notMem_range (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    sqMem Q c ∉ Set.range (algebraMap (Q.adicCompletion K) ↥(qAbs Q)) := by
  rintro ⟨b, hb⟩
  have hsq : b ^ 2 = (c : Q.adicCompletion K) := by
    refine (algebraMap (Q.adicCompletion K) ↥(qAbs Q)).injective ?_
    rw [map_pow, pow_two, hb, sqMem_mul_self]
  have hb0 : b ≠ 0 := by
    rintro rfl
    rw [zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hsq
    exact Units.ne_zero c hsq.symm
  refine hc (NK.NUV2.QuadFaithful.mem_sq_iff.mpr ⟨Units.mk0 b hb0, Units.ext ?_⟩)
  rw [Units.val_pow_eq_pow_val, Units.val_mk0]
  exact hsq

theorem qGen_notMem_range (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    qGen Q c ∉ Set.range (algebraMap (Q.adicCompletion K) ↥(qLevel Q c)) := by
  rintro ⟨b, hb⟩
  refine sqMem_notMem_range Q c hc ⟨b, ?_⟩
  simpa [qGen] using congrArg (IntermediateField.val (qLevel Q c)) hb

theorem qLevel_finrank_eq_two (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    Module.finrank (Q.adicCompletion K) ↥(qLevel Q c) = 2 := by
  have hle : Module.finrank (Q.adicCompletion K) ↥(qLevel Q c) ≤ 2 :=
    NK.NUV2.LC.quadLevel_finrank_le_two (sqUnit Q c) (c : Q.adicCompletion K)
      (sqUnit_mul_self Q c)
  have hne : Module.finrank (Q.adicCompletion K) ↥(qLevel Q c) ≠ 1 := by
    intro h1
    have hbot : qLevel Q c = ⊥ := IntermediateField.finrank_eq_one_iff.mp h1
    have hmem : sqMem Q c ∈ (⊥ : IntermediateField (Q.adicCompletion K) ↥(qAbs Q)) := by
      rw [← hbot]
      exact (qGen Q c).2
    exact sqMem_notMem_range Q c hc (IntermediateField.mem_bot.mp hmem)
  have hpos : 0 < Module.finrank (Q.adicCompletion K) ↥(qLevel Q c) := Module.finrank_pos
  omega

theorem qNorm_index (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    (qNorm Q c).index = 2 := by
  have h := NK.LocalReciprocityLubinTate.NormIndex.normIndex_adicCompletion Q (qLevel Q c)
  rw [h, qLevel_finrank_eq_two Q c hc]

/-! ### The norm form and the symmetry of the norm relation -/

/-- Every element of the quadratic level `F(√c)` is of the form `u + v √c`. -/
theorem exists_eq_add_mul_qGen (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) (w : ↥(qLevel Q c)) :
    ∃ u v : Q.adicCompletion K,
      w = algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u +
        algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v * qGen Q c := by
  have hli : LinearIndependent (Q.adicCompletion K)
      ![algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (1 : Q.adicCompletion K), qGen Q c] := by
    rw [linearIndependent_fin2]
    refine ⟨?_, ?_⟩
    · intro h0
      have hb0 : qGen Q c = 0 := by simpa using h0
      exact qGen_notMem_range Q c hc ⟨0, by rw [hb0, map_zero]⟩
    · intro a ha
      by_cases ha0 : a = 0
      · rw [ha0, zero_smul] at ha
        exact one_ne_zero ha.symm
      · refine qGen_notMem_range Q c hc ⟨a⁻¹, ?_⟩
        have h1 : algebraMap (Q.adicCompletion K) ↥(qLevel Q c) a * qGen Q c = 1 := by
          have := ha
          rwa [Algebra.smul_def] at this
        rw [map_inv₀]
        exact inv_eq_of_mul_eq_one_right h1
  have hrange : (Set.range ![algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (1 : Q.adicCompletion K),
      qGen Q c]) = {algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (1 : Q.adicCompletion K), qGen Q c} := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  have hspan : Submodule.span (Q.adicCompletion K)
      {algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (1 : Q.adicCompletion K), qGen Q c} = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [← hrange, finrank_span_eq_card hli, qLevel_finrank_eq_two Q c hc]
    simp
  have hmem : w ∈ Submodule.span (Q.adicCompletion K)
      {algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (1 : Q.adicCompletion K), qGen Q c} := by
    rw [hspan]
    trivial
  obtain ⟨u, v, huv⟩ := Submodule.mem_span_pair.mp hmem
  refine ⟨u, v, ?_⟩
  rw [← huv]
  simp only [Algebra.smul_def, map_one, mul_one]

/-- **The norm form**: for `c` a non-square, `x` is a norm from `F(√c)` if and only if it is
represented by `u ^ 2 - c * v ^ 2`. -/
theorem mem_qNorm_iff (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) (x : (Q.adicCompletion K)ˣ) :
    x ∈ qNorm Q c ↔ ∃ u v : Q.adicCompletion K, (u, v) ≠ 0 ∧
      (x : Q.adicCompletion K) = u ^ 2 - (c : Q.adicCompletion K) * v ^ 2 := by
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := (NK.LocalReciprocity.mem_normGroup_iff x).mp hx
    obtain ⟨u, v, huv⟩ := exists_eq_add_mul_qGen Q c hc (y : ↥(qLevel Q c))
    have hform : Algebra.norm (Q.adicCompletion K) (y : ↥(qLevel Q c)) =
        u ^ 2 - (c : Q.adicCompletion K) * v ^ 2 := by
      rw [huv]
      exact NK.NUV2.QuadFaithful.norm_algebraMap_add_mul (qLevel_finrank_eq_two Q c hc)
        (qGen_notMem_range Q c hc) (qGen_sq Q c) u v
    refine ⟨u, v, ?_, ?_⟩
    · rintro h0
      have hu : u = 0 := congrArg Prod.fst h0
      have hv : v = 0 := congrArg Prod.snd h0
      refine Units.ne_zero y ?_
      rw [huv, hu, hv]
      simp
    · rw [← hy, hform]
  · rintro ⟨u, v, huv, hx⟩
    have hne : algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u +
        algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v * qGen Q c ≠ 0 := by
      intro h0
      rcases eq_or_ne v 0 with hv | hv
      · rw [hv, map_zero, zero_mul, add_zero] at h0
        have hu : u = 0 := (algebraMap (Q.adicCompletion K) ↥(qLevel Q c)).injective
          (by rw [h0, map_zero])
        exact huv (by simp [hu, hv])
      · have hv' : algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v ≠ 0 := by
          intro hh
          exact hv ((algebraMap (Q.adicCompletion K) ↥(qLevel Q c)).injective (by rw [hh, map_zero]))
        have h3 : algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v * qGen Q c =
            -(algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u) := by
          have h := congrArg (fun z : ↥(qLevel Q c) => z - algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u) h0
          rw [add_sub_cancel_left, zero_sub] at h
          exact h
        refine qGen_notMem_range Q c hc ⟨-(u / v), ?_⟩
        have h2 : qGen Q c = -(algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u) *
            (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v)⁻¹ := by
          calc qGen Q c = (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v)⁻¹ *
                ((algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v) * qGen Q c) := by
                rw [← mul_assoc, inv_mul_cancel₀ hv', one_mul]
            _ = (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v)⁻¹ *
                (-(algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u)) := by rw [h3]
            _ = -(algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u) *
                (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v)⁻¹ := by ring
        rw [h2, map_neg, map_div₀]
        ring
    change x ∈ NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(qLevel Q c)
    rw [NK.LocalReciprocity.mem_normGroup_iff]
    refine ⟨Units.mk0 _ hne, ?_⟩
    show Algebra.norm (Q.adicCompletion K)
      (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) u +
        algebraMap (Q.adicCompletion K) ↥(qLevel Q c) v * qGen Q c) = (x : Q.adicCompletion K)
    rw [NK.NUV2.QuadFaithful.norm_algebraMap_add_mul (qLevel_finrank_eq_two Q c hc)
      (qGen_notMem_range Q c hc) (qGen_sq Q c) u v, hx]

/-- The squares of `Fˣ` are norms from any quadratic level. -/
theorem sq_le_qNorm (c : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) ≤ qNorm Q c := by
  rw [NK.NUV2.QuadFaithful.sq_le_iff]
  intro u
  change u ^ 2 ∈ NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(qLevel Q c)
  rw [NK.LocalReciprocity.mem_normGroup_iff]
  refine ⟨Units.mk0 (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (u : Q.adicCompletion K))
    (by simpa using Units.ne_zero u), ?_⟩
  show Algebra.norm (Q.adicCompletion K)
      (algebraMap (Q.adicCompletion K) ↥(qLevel Q c) (u : Q.adicCompletion K)) =
    ((u ^ 2 : (Q.adicCompletion K)ˣ) : Q.adicCompletion K)
  haveI : Module.Free (Q.adicCompletion K) ↥(qLevel Q c) := Module.Free.of_divisionRing _ _
  rw [Algebra.norm_algebraMap, qLevel_finrank_eq_two Q c hc]
  simp

/-- **Symmetry of the norm relation**: for non-squares `x, c`, `x` is a norm from `F(√c)` if and
only if `c` is a norm from `F(√x)`. -/
theorem mem_qNorm_comm (c : (Q.adicCompletion K)ˣ) (x : (Q.adicCompletion K)ˣ)
    (hc : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K))
    (hx : x ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K)) :
    x ∈ qNorm Q c ↔ c ∈ qNorm Q x := by
  have aux : ∀ (p q : (Q.adicCompletion K)ˣ),
      q ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) →
      p ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) →
      p ∈ qNorm Q q → q ∈ qNorm Q p := by
    intro p q hq hp hpq
    obtain ⟨u, v, huv, hpuv⟩ := (mem_qNorm_iff Q q hq p).mp hpq
    have hv : v ≠ 0 := by
      rintro rfl
      have hsquare : (p : Q.adicCompletion K) = u ^ 2 := by rw [hpuv]; ring
      have hune : (p : Q.adicCompletion K) ≠ 0 := Units.ne_zero p
      have hu0 : u ≠ 0 := by
        rintro rfl
        rw [zero_pow (by norm_num : (2 : ℕ) ≠ 0)] at hsquare
        exact hune hsquare
      refine hp (NK.NUV2.QuadFaithful.mem_sq_iff.mpr ⟨Units.mk0 u hu0, ?_⟩)
      refine Units.ext ?_
      rw [Units.val_pow_eq_pow_val, Units.val_mk0]
      exact hsquare.symm
    refine (mem_qNorm_iff Q p hp q).mpr ⟨u / v, 1 / v, ?_, ?_⟩
    · intro h0
      exact one_div_ne_zero hv (congrArg Prod.snd h0)
    have h1 : (q : Q.adicCompletion K) * v ^ 2 = u ^ 2 - (p : Q.adicCompletion K) := by
      rw [hpuv]; ring
    calc (q : Q.adicCompletion K)
        = ((q : Q.adicCompletion K) * v ^ 2) / v ^ 2 :=
          (mul_div_cancel_right₀ _ (pow_ne_zero 2 hv)).symm
      _ = (u ^ 2 - (p : Q.adicCompletion K)) / v ^ 2 := by rw [h1]
      _ = (u / v) ^ 2 - (p : Q.adicCompletion K) * (1 / v) ^ 2 := by
            rw [div_pow, one_div, inv_pow]; ring
  exact ⟨aux x c hc hx, aux c x hx hc⟩

/-- **The norm group of `F(√c)` determines the square class of `c`.** -/
theorem qNorm_injective (a b : (Q.adicCompletion K)ˣ)
    (ha : a ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K))
    (hb : b ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K))
    (h : qNorm Q a = qNorm Q b) : a / b ∈ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) := by
  by_contra hab
  have hkey : ∀ c : (Q.adicCompletion K)ˣ,
      c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) →
      (a ∈ qNorm Q c ↔ b ∈ qNorm Q c) := by
    intro c hc
    rw [mem_qNorm_comm Q c a hc ha, mem_qNorm_comm Q c b hc hb, h]
  have hxmem : ∀ c : (Q.adicCompletion K)ˣ,
      c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) → a / b ∈ qNorm Q c := by
    intro c hc
    have h1 : a * b⁻¹ ∈ qNorm Q c := by
      rw [Subgroup.mul_mem_iff_of_index_two (qNorm_index Q c hc)]
      rw [inv_mem_iff]
      exact hkey c hc
    rwa [div_eq_mul_inv]
  have hne_top : qNorm Q (a / b) ≠ ⊤ := by
    intro htop
    have h1 : (qNorm Q (a / b)).index = 1 := by rw [htop, Subgroup.index_top]
    have h2 := qNorm_index Q (a / b) hab
    omega
  obtain ⟨c, hc⟩ : ∃ c : (Q.adicCompletion K)ˣ, c ∉ qNorm Q (a / b) := by
    by_contra hcon
    simp only [not_exists, not_not] at hcon
    exact hne_top (le_antisymm le_top fun x _ => hcon x)
  have hc' : c ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) := fun hcsq =>
    hc (sq_le_qNorm Q (a / b) hab hcsq)
  exact hc ((mem_qNorm_comm Q c (a / b) hc' hab).mp (hxmem c hc'))

/-! ### From an arbitrary quadratic level to a canonical one -/

/-- In a field, two elements with the same square are equal or opposite. -/
theorem eq_or_eq_neg_of_mul_self_eq {E : Type*} [Field E] {x y : E} (h : y * y = x * x) :
    y = x ∨ y = -x := by
  have h' : (y - x) * (y + x) = 0 := by linear_combination h
  rcases mul_eq_zero.mp h' with h1 | h2
  · exact Or.inl (sub_eq_zero.mp h1)
  · exact Or.inr (by rw [add_eq_zero_iff_eq_neg] at h2; exact h2)

/-- Adjoining `x` and adjoining `-x` give the same field. -/
theorem adjoin_singleton_neg {E : Type*} [Field E] [Algebra (Q.adicCompletion K) E] (x : E) :
    IntermediateField.adjoin (Q.adicCompletion K) ({x} : Set E) =
      IntermediateField.adjoin (Q.adicCompletion K) ({-x} : Set E) := by
  have h1 : x ∈ (IntermediateField.adjoin (Q.adicCompletion K) ({-x} : Set E)) := by
    have h := neg_mem (IntermediateField.subset_adjoin (Q.adicCompletion K) ({-x} : Set E)
      (Set.mem_singleton (-x)))
    simpa using h
  have h2 : -x ∈ (IntermediateField.adjoin (Q.adicCompletion K) ({x} : Set E)) :=
    neg_mem (IntermediateField.subset_adjoin (Q.adicCompletion K) ({x} : Set E)
      (Set.mem_singleton x))
  exact le_antisymm
    (IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr h1))
    (IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr h2))

/-- A quadratic level of `F^{ab}` generated by an element whose square lies in `Fˣ` is a canonical
level `F(√a)`. -/
theorem eq_qLevel_of_gen {L : IntermediateField (Q.adicCompletion K) ↥(qAbs Q)}
    [FiniteDimensional (Q.adicCompletion K) L]
    (hL : Module.finrank (Q.adicCompletion K) ↥L = 2)
    {x : ↥L} {a : (Q.adicCompletion K)ˣ}
    (hx : x ∉ Set.range (algebraMap (Q.adicCompletion K) ↥L))
    (hsq : x ^ 2 = algebraMap (Q.adicCompletion K) ↥L (a : Q.adicCompletion K)) :
    L = qLevel Q a := by
  set x' : ↥(qAbs Q) := x.1 with hx'def
  have hsq_ab : x' ^ 2 = algebraMap (Q.adicCompletion K) ↥(qAbs Q) (a : Q.adicCompletion K) := by
    have h := congrArg (fun z : ↥L => (z : ↥(qAbs Q))) hsq
    simpa [x', pow_two] using h
  have hx' : x' ∉ Set.range (algebraMap (Q.adicCompletion K) ↥(qAbs Q)) := by
    rintro ⟨b, hb⟩
    refine hx ⟨b, ?_⟩
    apply Subtype.ext
    simpa [x'] using hb
  have hmemL : x' ∈ L := x.2
  -- the adjoin of x' is L
  have hle : IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q)) ≤ L :=
    IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hmemL)
  have hmul : x' * x' = algebraMap (Q.adicCompletion K) ↥(qAbs Q) (a : Q.adicCompletion K) := by
    rw [← pow_two]
    exact hsq_ab
  have hfin : Module.finrank (Q.adicCompletion K)
      ↥(IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q))) = 2 := by
    have hdata := NK.NUV2.LC.adjoinSq_normal_finrank_le (K := Q.adicCompletion K)
      (L := ↥(qAbs Q)) x' (a : Q.adicCompletion K) hmul
    haveI : FiniteDimensional (Q.adicCompletion K)
        ↥(IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q))) := hdata.2.1
    have hle2 := hdata.2.2
    have hne : Module.finrank (Q.adicCompletion K)
        ↥(IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q))) ≠ 1 := by
      intro h1
      have hbot : IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q)) = ⊥ :=
        IntermediateField.finrank_eq_one_iff.mp h1
      have hmem : x' ∈ (⊥ : IntermediateField (Q.adicCompletion K) ↥(qAbs Q)) := by
        rw [← hbot]
        exact IntermediateField.mem_adjoin_simple_self (Q.adicCompletion K) x'
      exact hx' (IntermediateField.mem_bot.mp hmem)
    have hpos : 0 < Module.finrank (Q.adicCompletion K)
        ↥(IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q))) :=
      Module.finrank_pos
    omega
  have hEq : IntermediateField.adjoin (Q.adicCompletion K) ({x'} : Set ↥(qAbs Q)) = L :=
    IntermediateField.eq_of_le_of_finrank_eq hle (by rw [hfin, hL])
  rw [← hEq, qLevel_def]
  have hroot : sqMem Q a * sqMem Q a = x' * x' := by
    rw [sqMem_mul_self, ← hsq_ab, pow_two]
  rcases eq_or_eq_neg_of_mul_self_eq hroot with h | h
  · rw [h]
  · rw [h]
    exact adjoin_singleton_neg (K := K) (Q := Q) x'

/-- **Distinct quadratic levels of `F^{ab}` have distinct norm groups.**

This is the residue-characteristic-`2` case of the injectivity of `L ↦ N_L` on quadratic levels
(the non-degeneracy of the Kummer/Hilbert pairing at `n = 2`), proved here from the symmetry
`mem_qNorm_comm` of the norm relation: if `N_{L₁} = N_{L₂}` then the generators `a₁, a₂` (with
`Lᵢ = F(√aᵢ)`) have the same norm group, so `a₁/a₂` is a norm from every `F(√c)`, hence a square. -/
theorem normGroup_quadratic_injective {L₁ L₂ : IntermediateField (Q.adicCompletion K) ↥(qAbs Q)}
    [FiniteDimensional (Q.adicCompletion K) L₁] [Normal (Q.adicCompletion K) L₁]
    [FiniteDimensional (Q.adicCompletion K) L₂] [Normal (Q.adicCompletion K) L₂]
    (h₁ : Module.finrank (Q.adicCompletion K) ↥L₁ = 2)
    (h₂ : Module.finrank (Q.adicCompletion K) ↥L₂ = 2)
    (h : NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥L₁ =
      NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥L₂) : L₁ = L₂ := by
  have h2ne : (2 : Q.adicCompletion K) ≠ 0 := Nat.cast_ne_zero.mpr (by norm_num)
  obtain ⟨x₁, a₁, hx₁ne, hx₁not, hx₁sq, ha₁not⟩ :=
    NK.NUV2.QuadFaithful.exists_gen_sq_mem (F := Q.adicCompletion K) (E := ↥L₁) h2ne h₁
  obtain ⟨x₂, a₂, hx₂ne, hx₂not, hx₂sq, ha₂not⟩ :=
    NK.NUV2.QuadFaithful.exists_gen_sq_mem (F := Q.adicCompletion K) (E := ↥L₂) h2ne h₂
  have ha₁0 : a₁ ≠ 0 := by
    rintro rfl
    have h : x₁ ^ 2 = 0 := by rw [hx₁sq]; simp
    rw [pow_two] at h
    exact hx₁ne (mul_self_eq_zero.mp h)
  have ha₂0 : a₂ ≠ 0 := by
    rintro rfl
    have h : x₂ ^ 2 = 0 := by rw [hx₂sq]; simp
    rw [pow_two] at h
    exact hx₂ne (mul_self_eq_zero.mp h)
  set au₁ : (Q.adicCompletion K)ˣ := Units.mk0 a₁ ha₁0 with hau₁
  set au₂ : (Q.adicCompletion K)ˣ := Units.mk0 a₂ ha₂0 with hau₂
  have hnot₁ : au₁ ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) := fun hmem =>
    ha₁not ((NK.NUV2.QuadFaithful.isSquare_iff_units_mem_sq ha₁0).mpr hmem)
  have hnot₂ : au₂ ∉ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) := fun hmem =>
    ha₂not ((NK.NUV2.QuadFaithful.isSquare_iff_units_mem_sq ha₂0).mpr hmem)
  have hL₁ : L₁ = qLevel Q au₁ := eq_qLevel_of_gen Q h₁ hx₁not hx₁sq
  have hL₂ : L₂ = qLevel Q au₂ := eq_qLevel_of_gen Q h₂ hx₂not hx₂sq
  have hq : qNorm Q au₁ = qNorm Q au₂ := by
    change NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(qLevel Q au₁) =
      NK.LocalReciprocity.normGroup (Q.adicCompletion K) ↥(qLevel Q au₂)
    rw [← hL₁, ← hL₂]
    exact h
  have hdiv : au₁ / au₂ ∈ NK.NUV2.QuadFaithful.sq (Q.adicCompletion K) :=
    qNorm_injective Q au₁ au₂ hnot₁ hnot₂ hq
  exact NK.NUV2.QuadFaithful.eq_of_div_mem_sq h₁ h₂ hx₁not hx₂not hx₁sq hx₂sq hdiv

end QuadLevels

end

end NK.NUV2
