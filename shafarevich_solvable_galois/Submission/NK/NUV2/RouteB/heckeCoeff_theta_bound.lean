/-!
# Hecke's partial-sum estimate for a non-trivial ray class character

`NK.NUV2.RouteB.heckeCoeff_theta_bound`: for a number field `K`, an *open* subgroup
`U ≤ 𝕀 K` with finite ray class group, a finite set `S` of primes and a ray class character `χ`
which is non-trivial on the class of some prime ideal, the partial sums of the coefficients
`heckeCoeff K U S χ` of the Hecke `L`-series of `χ` satisfy a power saving
`‖∑_{k ≤ N} heckeCoeff k‖ ≤ C · N^θ` with `θ < 1`.  This is Hecke's theorem (1917) in the form
consumed by the Abel-summation step `NK.NUV2.HeckeLAbel.tendsto_LSeries_of_partial_sum_bound`.

## Structure of the proof

* `NK.NUV2.RouteB.HeckeTheta.exists_modulus_and_closure` (delegated): an open `U` contains the
  congruence idèles of a modulus `𝔪 ≠ 0`, so that `classOfIdeal K U (Ideal.span {γ}) = 1` for
  every totally positive `γ ≡ 1 (mod 𝔪)`; moreover the classes of *all* prime ideals lie in the
  subgroup generated by the classes of the primes coprime to `𝔪`.
* Consequently the target's hypothesis `∃ 𝔭, χ(classOfIdeal K U 𝔭) ≠ 1` upgrades to
  `∃ 𝔮 ∤ 𝔪, χ(classOfIdeal K U 𝔮) ≠ 1`: otherwise `χ` would be trivial on the whole subgroup
  generated by the prime classes coprime to `𝔪`, hence (by the second part of the modulus lemma)
  on the class of every prime ideal.  This is the argument carried out below.
* `NK.NUV2.RouteB.HeckeTheta.heckeCoeff_theta_bound_aux` (delegated): the character-sum bound
  under the upgraded hypothesis (this is the analytic heart: the equidistribution of the ideals in
  the ray classes, via the lattice point count in the fundamental cone).
-/

open scoped BigOperators

namespace NK.NUV2.RouteB

theorem heckeCoeff_theta_bound :
    ∀ (K : Type) [Field K] [NumberField K] (U : Subgroup (NK.GlobalCFT.Idele K)),
      IsOpen (U : Set (NK.GlobalCFT.Idele K)) →
      Finite (NK.GlobalCFT.IdeleClassGroup.rayClassGroup K U) →
      ∀ (S : Finset (NK.HeckeL.PrimeIdeal K)) (χ : NK.HeckeL.RayChar K U), χ ≠ 1 →
      (∃ 𝔭 : NK.HeckeL.PrimeIdeal K,
        χ (NK.HeckeL.classOfIdeal K U 𝔭.asIdeal) ≠ 1) →
      ∃ C θ : ℝ, 0 < C ∧ 0 ≤ θ ∧ θ < 1 ∧ ∀ N : ℕ, 1 ≤ N →
        ‖∑ k ∈ Finset.Icc 1 N, NK.HeckeL.heckeCoeff K U S χ k‖ ≤ C * (N : ℝ) ^ θ := by
  intro K _ _ U hU hFin S χ hχ hprime
  obtain ⟨𝔪, h𝔪, hcong, hclosure⟩ := HeckeTheta.exists_modulus_and_closure U hU hFin
  obtain ⟨𝔭, h𝔭⟩ := hprime
  -- Upgrade the hypothesis to a prime coprime to the modulus.
  have hne : ∃ 𝔮 : NK.HeckeL.PrimeIdeal K, ¬ 𝔮.asIdeal ∣ 𝔪 ∧
      χ (NK.HeckeL.classOfIdeal K U 𝔮.asIdeal) ≠ 1 := by
    by_contra hcon
    push Not at hcon
    have hle : HeckeTheta.coprimePrimeClosure U 𝔪 ≤ χ.ker := by
      rw [HeckeTheta.coprimePrimeClosure]
      refine (Subgroup.closure_le _).mpr ?_
      rintro y ⟨𝔮, rfl⟩
      exact MonoidHom.mem_ker.mpr (hcon 𝔮.1 𝔮.2)
    exact h𝔭 (MonoidHom.mem_ker.mp (hle (hclosure 𝔭)))
  exact HeckeTheta.heckeCoeff_theta_bound_aux K U hU hFin 𝔪 h𝔪 hcong S χ hχ hne

end NK.NUV2.RouteB
