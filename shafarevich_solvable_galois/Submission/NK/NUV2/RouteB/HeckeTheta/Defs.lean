namespace NK.NUV2.RouteB.HeckeTheta

/-- `α ∈ K` is **positive at the real infinite place `w`**: the image of `α` in the completion
`w.Completion ≃+* ℝ` is positive. -/
def IsPositiveAtRealPlace {K : Type} [Field K] (w : InfinitePlace K) (hw : w.IsReal)
    (α : K) : Prop :=
  0 < (InfinitePlace.Completion.ringEquivRealOfIsReal hw) (algebraMap K w.Completion α)

/-- An algebraic integer is **totally positive** if it is positive at every real place. -/
def IsTotallyPositive {K : Type} [Field K] [NumberField K] (γ : 𝓞 K) : Prop :=
  ∀ (w : InfinitePlace K) (hw : w.IsReal),
    IsPositiveAtRealPlace w hw (algebraMap (𝓞 K) K γ)

/-- The subgroup of the ray class group `𝕀 K ⧸ (Kˣ·U)` generated by the classes of the prime
ideals coprime to `𝔪`.  This is the subgroup on which a ray class character has to be non-trivial
in order for the partial sums of its Hecke coefficients to be `O(N^θ)` with `θ < 1`. -/
def coprimePrimeClosure {K : Type} [Field K] [NumberField K]
    (U : Subgroup (NK.GlobalCFT.Idele K)) (𝔪 : Ideal (𝓞 K)) :
    Subgroup (NK.GlobalCFT.IdeleClassGroup.rayClassGroup K U) :=
  Subgroup.closure (Set.range (fun 𝔮 : {𝔮 : NK.HeckeL.PrimeIdeal K // ¬ 𝔮.asIdeal ∣ 𝔪} =>
    NK.HeckeL.classOfIdeal K U 𝔮.1.asIdeal))

@[simp]
theorem classOfIdeal_mem_coprimePrimeClosure {K : Type} [Field K] [NumberField K]
    (U : Subgroup (NK.GlobalCFT.Idele K)) (𝔪 : Ideal (𝓞 K))
    (𝔮 : {𝔮 : NK.HeckeL.PrimeIdeal K // ¬ 𝔮.asIdeal ∣ 𝔪}) :
    NK.HeckeL.classOfIdeal K U 𝔮.1.asIdeal ∈ coprimePrimeClosure U 𝔪 :=
  Subgroup.subset_closure ⟨𝔮, rfl⟩

/-- The **sign conditions** at a finite set of real places: the real component of `x` is negative
at every place of `S`. -/
def signRegion {K : Type} [Field K] [NumberField K]
    (S : Finset {w : InfinitePlace K // w.IsReal}) (x : NumberField.mixedEmbedding.mixedSpace K) :
    Prop :=
  ∀ w ∈ S, (x.1) w < 0

/-- The number of points of the coset `x₀ + idealLattice K I` which lie in the fundamental cone,
have the prescribed **sign pattern** `σ` at the real places (`σ w = true` means "negative at `w`",
`σ w = false` means "positive at `w`"), and norm at most `Y`. -/
def coneCosetCount {K : Type} [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ)
    (σ : {w : InfinitePlace K // w.IsReal} → Bool)
    (x₀ : NumberField.mixedEmbedding.mixedSpace K) (Y : ℝ) : ℕ :=
  Nat.card {x : NumberField.mixedEmbedding.mixedSpace K //
    x - x₀ ∈ (NumberField.mixedEmbedding.idealLattice K I :
      Set (NumberField.mixedEmbedding.mixedSpace K)) ∧
    x ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
    (∀ w : {w : InfinitePlace K // w.IsReal},
      (σ w = true → (x.1) w < 0) ∧ (σ w = false → 0 < (x.1) w)) ∧
    NumberField.mixedEmbedding.norm x ≤ Y}

/-- The number of points of the coset `x₀ + idealLattice K I` in the fundamental cone, with at
least one vanishing real coordinate, and norm at most `Y`. -/
def coneCosetCountZero {K : Type} [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ)
    (x₀ : NumberField.mixedEmbedding.mixedSpace K) (Y : ℝ) : ℕ :=
  Nat.card {x : NumberField.mixedEmbedding.mixedSpace K //
    x - x₀ ∈ (NumberField.mixedEmbedding.idealLattice K I :
      Set (NumberField.mixedEmbedding.mixedSpace K)) ∧
    x ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
    (∃ w : {w : InfinitePlace K // w.IsReal}, (x.1) w = 0) ∧
    NumberField.mixedEmbedding.norm x ≤ Y}

