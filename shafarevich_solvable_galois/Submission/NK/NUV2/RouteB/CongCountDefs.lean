/-!
# Counting ideals in a congruence class: the vocabulary

For a number field `K`, a nonzero ideal `𝔪` of `𝓞 K` and `a : 𝓞 K` coprime to `𝔪`, the number

  `N_a(X) = #{𝔟 ≠ 0 principal : ∃ α, α - a ∈ 𝔪 ∧ 𝔟 = (α), absNorm 𝔟 ≤ X}`

of ideals generated by an element of the congruence class `a + 𝔪` behaves like
`X · κ / torsionOrder K` up to a power-saving error, where `κ` is the main term constant of the
Minkowski/lattice count in the fundamental cone. The file defines the vocabulary:

* `GeoHyp` — the geometric input (the lattice point count in the fundamental cone with a
  power saving error term);
* `coneMainTerm` — its main term constant;
* `cosetConeCount 𝔪 c X` — the number of points of the coset `c + 𝔪` that lie in the fundamental
  cone and have norm `≤ X` (this is the quantity controlled by `GeoHyp`);
* `CongModIdeal 𝔪 a α` — the condition that some unit multiple of `α` is `≡ a (mod 𝔪)`;
* `congConeSet 𝔪 a X` — the cone points `α` of norm `≤ X` with `CongModIdeal 𝔪 a α` (the disjoint union
  over the classes of `(𝓞 K)ˣ ⧸ unitCongOne 𝔪` of the `cosetConeCount`s);
* `congIdeals 𝔪 a X` — the set of ideals counted by the target statement.

The three counting identities that connect them are stated (and delegated) separately; this file
only fixes the vocabulary so that they can be stated once and used both here and in the target.
-/

namespace NK.NUV2.RouteB

open NumberField NumberField.mixedEmbedding
open scoped nonZeroDivisors

set_option autoImplicit false
set_option linter.unusedVariables false
set_option linter.unusedSectionVars false

/-- **The geometric input.** For every number field `K`, every fractional ideal `I` and every
shift `x₀`, the number of points of the coset `x₀ + I` lying in the fundamental cone with norm
`≤ X` equals `X` times the Minkowski main term, up to `O(X^θ)` with `θ < 1`. -/
def GeoHyp : Prop :=
  ∀ (K : Type) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K)ˣ)
    (x₀ : NumberField.mixedEmbedding.mixedSpace K),
    ∃ (C θ : ℝ), 0 < C ∧ θ < 1 ∧ ∀ X : ℝ, 1 ≤ X →
      |((Nat.card {a : NumberField.mixedEmbedding.mixedSpace K //
          a - x₀ ∈ (NumberField.mixedEmbedding.idealLattice K I :
            Set (NumberField.mixedEmbedding.mixedSpace K)) ∧
          a ∈ NumberField.mixedEmbedding.fundamentalCone K ∧
          NumberField.mixedEmbedding.norm a ≤ X}) : ℝ)
        - X * (2 ^ NumberField.InfinitePlace.nrRealPlaces K *
            (2 * Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces K *
            NumberField.Units.regulator K /
            ((FractionalIdeal.absNorm
                (I : FractionalIdeal (nonZeroDivisors (NumberField.RingOfIntegers K)) K) : ℝ) *
              Real.sqrt |((NumberField.discr K : ℤ) : ℝ)|))|
      ≤ C * X ^ θ

/-- The main term constant of the geometric count. -/
noncomputable def coneMainTerm (K : Type*) [Field K] [NumberField K]
    (I : (FractionalIdeal (nonZeroDivisors (𝓞 K)) K)ˣ) : ℝ :=
  2 ^ InfinitePlace.nrRealPlaces K * (2 * Real.pi) ^ InfinitePlace.nrComplexPlaces K *
    NumberField.Units.regulator K /
    ((FractionalIdeal.absNorm (I : FractionalIdeal (nonZeroDivisors (𝓞 K)) K) : ℝ) *
      Real.sqrt |((NumberField.discr K : ℤ) : ℝ)|)

/-- The points of the coset `c + 𝔪` that lie in the fundamental cone and have norm `≤ X`. -/
noncomputable def cosetConeCount {K : Type*} [Field K] [NumberField K]
    (𝔪 : Ideal (𝓞 K)) (c : 𝓞 K) (X : ℝ) : ℕ :=
  Nat.card {α : 𝓞 K // α - c ∈ 𝔪 ∧ mixedEmbedding K α ∈ fundamentalCone K ∧
    mixedEmbedding.norm (mixedEmbedding K α) ≤ X}

/-- `α` is congruent to `a` modulo `𝔪` up to a unit factor: some unit multiple of `α` is
congruent to `a`. -/
def CongModIdeal {K : Type*} [Field K] (𝔪 : Ideal (𝓞 K)) (a α : 𝓞 K) : Prop :=
  ∃ u : (𝓞 K)ˣ, (u : 𝓞 K) * α - a ∈ 𝔪

/-- The cone points of norm `≤ X` some unit multiple of which is `≡ a (mod 𝔪)`. -/
def congConeSet {K : Type*} [Field K] [NumberField K]
    (𝔪 : Ideal (𝓞 K)) (a : 𝓞 K) (X : ℝ) : Set (𝓞 K) :=
  {α | CongModIdeal 𝔪 a α ∧ mixedEmbedding K α ∈ fundamentalCone K ∧
    mixedEmbedding.norm (mixedEmbedding K α) ≤ X}

/-- The non-zero ideals generated by an element of the congruence class `a + 𝔪`, of norm `≤ X`. -/
def congIdeals {K : Type*} [Field K] [NumberField K]
    (𝔪 : Ideal (𝓞 K)) (a : 𝓞 K) (X : ℝ) : Set (Ideal (𝓞 K)) :=
  {𝔟 | 𝔟 ≠ 0 ∧ (∃ α : 𝓞 K, α - a ∈ 𝔪 ∧ 𝔟 = Ideal.span {α}) ∧ Ideal.absNorm 𝔟 ≤ X}

variable {K : Type*} [Field K] [NumberField K]

instance instFiniteQuotientUnitCongOne (𝔪 : Ideal (𝓞 K)) [NeZero 𝔪] :
    Finite ((𝓞 K)ˣ ⧸ unitCongOne 𝔪) :=
  Subgroup.finite_quotient_of_finiteIndex (H := unitCongOne 𝔪)

noncomputable instance instFintypeQuotientUnitCongOne (𝔪 : Ideal (𝓞 K)) [NeZero 𝔪] :
    Fintype ((𝓞 K)ˣ ⧸ unitCongOne 𝔪) :=
  Fintype.ofFinite ((𝓞 K)ˣ ⧸ unitCongOne 𝔪)

theorem mem_congConeSet {𝔪 : Ideal (𝓞 K)} {a : 𝓞 K} {X : ℝ} {α : 𝓞 K} :
    α ∈ congConeSet 𝔪 a X ↔ CongModIdeal 𝔪 a α ∧ mixedEmbedding K α ∈ fundamentalCone K ∧
      mixedEmbedding.norm (mixedEmbedding K α) ≤ X := Iff.rfl

theorem mem_congIdeals {𝔪 : Ideal (𝓞 K)} {a : 𝓞 K} {X : ℝ} {𝔟 : Ideal (𝓞 K)} :
    𝔟 ∈ congIdeals 𝔪 a X ↔
      𝔟 ≠ 0 ∧ (∃ α : 𝓞 K, α - a ∈ 𝔪 ∧ 𝔟 = Ideal.span {α}) ∧ Ideal.absNorm 𝔟 ≤ X :=
  Iff.rfl

/-- `CongModIdeal` is insensitive to multiplying `α` by a unit. -/
theorem congMod_mul_unit {𝔪 : Ideal (𝓞 K)} {a : 𝓞 K} {α : 𝓞 K} (v : (𝓞 K)ˣ) :
    CongModIdeal 𝔪 a ((v : 𝓞 K) * α) ↔ CongModIdeal 𝔪 a α := by
  constructor
  · rintro ⟨u, hu⟩
    exact ⟨u * v, by simpa [mul_assoc] using hu⟩
  · rintro ⟨u, hu⟩
    refine ⟨u * v⁻¹, ?_⟩
    have hkey : ((u : 𝓞 K) * ((v⁻¹ : (𝓞 K)ˣ) : 𝓞 K)) * (v : 𝓞 K) = (u : 𝓞 K) := by
      rw [mul_assoc, ← Units.val_mul, inv_mul_cancel, Units.val_one, mul_one]
    have h : (((u * v⁻¹ : (𝓞 K)ˣ)) : 𝓞 K) * ((v : 𝓞 K) * α) = (u : 𝓞 K) * α := by
      rw [Units.val_mul]
      calc (u : 𝓞 K) * ((v⁻¹ : (𝓞 K)ˣ) : 𝓞 K) * ((v : 𝓞 K) * α)
          = ((u : 𝓞 K) * ((v⁻¹ : (𝓞 K)ˣ) : 𝓞 K)) * (v : 𝓞 K) * α := by ring
        _ = (u : 𝓞 K) * α := by rw [hkey]
    simpa only [h] using hu

/-- The target's ideal count is the `Nat.card` of `congIdeals`. -/
theorem natCard_congIdeals_eq {𝔪 : Ideal (𝓞 K)} {a : 𝓞 K} {X : ℝ} :
    Nat.card {𝔟 : Ideal (𝓞 K) // 𝔟 ∈ congIdeals 𝔪 a X}
      = Nat.card {𝔟 : Ideal (𝓞 K) //
          𝔟 ≠ 0 ∧ (∃ α : 𝓞 K, α - a ∈ 𝔪 ∧ 𝔟 = Ideal.span {α}) ∧
            Ideal.absNorm 𝔟 ≤ X} := rfl

end NK.NUV2.RouteB
