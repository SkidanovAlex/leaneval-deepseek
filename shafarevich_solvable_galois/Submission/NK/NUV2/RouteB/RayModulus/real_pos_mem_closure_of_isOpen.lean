/-!
# Positive elements lie in the subgroup generated by an open neighbourhood of `1`

Let `K` be a number field and `w` a real infinite place.  Then `w.Completion ≃+* ℝ`
(`NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal`), so the unit group of the
completion is (topologically) `ℝˣ`.  The subgroup generated by an open neighbourhood `O` of `1`
is open, hence contains the connected component of `1`, i.e. the positive reals:
every `x` in the units whose image under the identification with `ℝ` is positive lies in
`Subgroup.closure O`.

The proof is elementary: `O` being open in `(w.Completion)ˣ` (whose topology is induced by the
coercion to `w.Completion`) contains a ball `B(1,ε)`, and for `r > 0` the numbers
`exp (log r / n)` tend to `1`, so `x = u ^ n` with `u ∈ O`.
-/

set_option linter.unusedSectionVars false

open NumberField Filter

noncomputable section

namespace NK.NUV2.RouteB.RayModulus

theorem real_pos_mem_closure_of_isOpen (K : Type) [Field K] [NumberField K]
    (w : NumberField.InfinitePlace K) (hw : w.IsReal)
    (O : Set ((w.Completion)ˣ)) (hO : IsOpen O) (h1 : (1 : (w.Completion)ˣ) ∈ O) :
    ∀ x : (w.Completion)ˣ,
      0 < NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw (x : w.Completion) →
      x ∈ Subgroup.closure O := by
  intro x hx
  -- `φ` identifies the completion with `ℝ`; it is an isometry.
  set φ : w.Completion ≃+* ℝ := NumberField.InfinitePlace.Completion.ringEquivRealOfIsReal hw
    with hφdef
  have hφiso : Isometry φ :=
    NumberField.InfinitePlace.Completion.isometry_extensionEmbeddingOfIsReal hw
  -- The topology on the units is induced by the coercion, so `O` contains a ball around `1`.
  have hemb : Topology.IsInducing (Units.val : (w.Completion)ˣ → w.Completion) :=
    (Units.isEmbedding_val₀ (G₀ := w.Completion)).isInducing
  obtain ⟨U, hUopen, hUeq⟩ := hemb.isOpen_iff.mp hO
  have h1U : (1 : w.Completion) ∈ U := by
    have : (1 : (w.Completion)ˣ) ∈ Units.val ⁻¹' U := by rw [hUeq]; exact h1
    simpa using this
  obtain ⟨ε, hεpos, hball⟩ := Metric.mem_nhds_iff.mp (hUopen.mem_nhds h1U)
  -- `r = φ x > 0`.
  set r : ℝ := φ (x : w.Completion) with hrdef
  have hrpos : 0 < r := by rw [hrdef, hφdef]; exact hx
  -- `exp (log r / n) → 1`.
  have htend : Filter.Tendsto (fun m : ℕ => Real.exp (Real.log r / (m : ℝ))) Filter.atTop
      (nhds 1) := by
    have h0 : Filter.Tendsto (fun m : ℕ => Real.log r / (m : ℝ)) Filter.atTop (nhds 0) :=
      tendsto_const_div_atTop_nhds_zero_nat (Real.log r)
    have hcomp := (Real.continuous_exp.tendsto 0).comp h0
    simpa only [Function.comp_def, Real.exp_zero] using hcomp
  obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp htend) ε hεpos
  -- The candidate `n`-th root of `r`.
  set a : ℝ := Real.exp (Real.log r / ((N + 1 : ℕ) : ℝ)) with hadef
  have hapos : 0 < a := Real.exp_pos _
  have hmε : dist a 1 < ε := by
    rw [hadef]
    exact hN (N+1) (Nat.le_succ N)
  -- Its preimage under `φ` and the corresponding unit.
  set t : w.Completion := φ.symm a with htdef
  have hφt : φ t = a := by rw [htdef]; exact RingEquiv.apply_symm_apply φ a
  have htne : t ≠ 0 := by
    intro h
    have : a = 0 := by rw [← hφt, h, map_zero]
    exact (ne_of_gt hapos) this
  set u : (w.Completion)ˣ := Units.mk0 t htne with hudef
  have htu : (u : w.Completion) = t := Units.val_mk0 htne
  have hdist : dist t 1 < ε := by
    have h1' : dist (φ t) (φ 1) = dist t 1 := hφiso.dist_eq t 1
    rw [← h1', hφt, map_one]
    exact hmε
  -- `u` lies in `O`.
  have huO : u ∈ O := by
    have hUt : t ∈ U := hball (Metric.mem_ball.mpr hdist)
    rw [← hUeq]
    simpa [htu] using hUt
  -- `a ^ (N+1) = r`.
  have ha_pow : a ^ (N + 1) = r := by
    rw [hadef, ← Real.exp_nat_mul]
    rw [mul_div_cancel₀ (Real.log r) (by positivity : ((N+1 : ℕ) : ℝ) ≠ 0)]
    exact Real.exp_log hrpos
  -- Hence `x = u ^ (N+1)`.
  have hux : u ^ (N + 1) = x := by
    apply Units.ext
    rw [Units.val_pow_eq_pow_val, htu]
    apply φ.injective
    rw [map_pow, hφt, ha_pow]
  rw [← hux]
  exact Subgroup.pow_mem (Subgroup.closure O) (Subgroup.subset_closure huO) (N+1)

end NK.NUV2.RouteB.RayModulus
