/-!
# The concrete connecting map `δ : H¹(G, ℚ/ℤ) ⟶ H²(G, ℤ)`

The Commons file `…/groupCohomology_two_int_iso_one_qmodz.lean` proves that
`δ : H¹(G, ℚ/ℤ) ⟶ H²(G, ℤ)` (the connecting map of the coefficient sequence
`0 → ℤ → ℚ → ℚ/ℤ → 0`) is an isomorphism, but its coefficient sequence is `private`, so the
*specific* map is not exported.  Route C's θ-construction (the character formula
`χ(θ a) = ι_u(a ∪ δχ)`) needs the specific `δ`, together with its naturality in the group, which is
why the sequence is reproduced here (this file, unlike the Commons one, is fine to import from
`NK.`).

Main contents: `qmodZ`, `coeffSes`, `coeffSes_shortExact`, `delta`, `delta_apply`.
-/

open CategoryTheory

namespace NK.NUV2.RouteC

/-- `ℚ/ℤ`, presented as the quotient of `ℚ` by the subgroup generated by `1`. -/
abbrev qmodZ : Type := ℚ ⧸ AddSubgroup.closure ({(1 : ℚ)} : Set ℚ)

/-- The inclusion `ℤ ↪ ℚ`, as a `ℤ`-linear map. -/
abbrev intToRat : ℤ →ₗ[ℤ] ℚ := (Int.castAddHom ℚ).toIntLinearMap

/-- The quotient map `ℚ ↠ ℚ/ℤ`. -/
abbrev ratToQmodZ : ℚ →ₗ[ℤ] qmodZ :=
  (QuotientAddGroup.mk' (AddSubgroup.closure ({(1 : ℚ)} : Set ℚ))).toIntLinearMap

variable (G : Type) [Group G]

/-- The inclusion of the trivial representation `ℤ` into the trivial representation `ℚ`. -/
abbrev coeffF : Rep.trivial ℤ G ℤ ⟶ Rep.trivial ℤ G ℚ :=
  Rep.ofHom ⟨intToRat, fun g => by rw [Rep.trivial_ρ, Rep.trivial_ρ]; simp⟩

/-- The projection of the trivial representation `ℚ` onto the trivial representation `ℚ/ℤ`. -/
abbrev coeffG : Rep.trivial ℤ G ℚ ⟶ Rep.trivial ℤ G qmodZ :=
  Rep.ofHom ⟨ratToQmodZ, fun g => by rw [Rep.trivial_ρ, Rep.trivial_ρ]; simp⟩

/-- The coefficient sequence `0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` of trivial `ℤ`-linear
`G`-representations. -/
abbrev coeffSes : ShortComplex (Rep ℤ G) :=
  ShortComplex.mk (coeffF G) (coeffG G) (by
    apply Rep.hom_ext
    apply Representation.IntertwiningMap.ext
    apply LinearMap.ext
    intro x
    show ((x : ℚ) : qmodZ) = 0
    rw [QuotientAddGroup.eq_zero_iff]
    rw [← AddSubgroup.zmultiples_eq_closure, AddSubgroup.mem_zmultiples_iff]
    exact ⟨x, by simp⟩)

/-- The coefficient sequence `0 ⟶ ℤ ⟶ ℚ ⟶ ℚ/ℤ ⟶ 0` is short exact. -/
theorem coeffSes_shortExact : (coeffSes G).ShortExact :=
  Commons.RepresentationTheory.GroupCohomology.shortExact_of_mono_epi_elementwise
    (k := ℤ) (G := G) (coeffSes G)
    ((Rep.mono_iff_injective (coeffF G)).2 (fun a b hab => by
      have hab' : (a : ℚ) = (b : ℚ) := hab
      exact Int.cast_injective hab'))
    ((Rep.epi_iff_surjective (coeffG G)).2 (fun y => by
      obtain ⟨x, hx⟩ := QuotientAddGroup.mk'_surjective
        (AddSubgroup.closure ({(1 : ℚ)} : Set ℚ)) y
      refine ⟨x, ?_⟩
      show ((x : ℚ) : qmodZ) = y
      exact hx))
    (fun x hx => by
      have hx' : ratToQmodZ x = 0 := hx
      have hmem : x ∈ AddSubgroup.closure ({(1 : ℚ)} : Set ℚ) :=
        (QuotientAddGroup.eq_zero_iff x).1 hx'
      rw [← AddSubgroup.zmultiples_eq_closure] at hmem
      rw [AddSubgroup.mem_zmultiples_iff] at hmem
      obtain ⟨n, hn⟩ := hmem
      refine ⟨n, ?_⟩
      show intToRat n = x
      rw [show intToRat n = (n : ℚ) from rfl]
      simpa using hn)

/-- **The connecting map `δ : H¹(G, ℚ/ℤ) ⟶ H²(G, ℤ)` of the coefficient sequence**, as a
`ℤ`-linear map.  It is an isomorphism for finite `G` (`deltaLinearEquiv`). -/
noncomputable def deltaHom (G : Type) [Group G] :
    groupCohomology (Rep.trivial ℤ G qmodZ) 1 ⟶ groupCohomology (Rep.trivial ℤ G ℤ) 2 :=
  groupCohomology.δ (coeffSes_shortExact G) 1 2 rfl

/-- The adjacent terms `H¹(G, ℚ)` and `H²(G, ℚ)` vanish, so `δ` is an isomorphism. -/
theorem isIso_deltaHom (G : Type) [Group G] [Fintype G] : IsIso (deltaHom G) :=
  groupCohomology.isIso_δ_of_isZero (coeffSes_shortExact G) 1
    (ModuleCat.isZero_iff_subsingleton.mpr
      (Commons.RepresentationTheory.GroupCohomology.subsingleton_groupCohomology_trivial_rat G 1
        (by norm_num)))
    (ModuleCat.isZero_iff_subsingleton.mpr
      (Commons.RepresentationTheory.GroupCohomology.subsingleton_groupCohomology_trivial_rat G 2
        (by norm_num)))

/-- **`δ : H¹(G, ℚ/ℤ) ≅ H²(G, ℤ)`** for finite `G`. -/
noncomputable def deltaLinearEquiv (G : Type) [Group G] [Fintype G] :
    groupCohomology (Rep.trivial ℤ G qmodZ) 1 ≃ₗ[ℤ] groupCohomology (Rep.trivial ℤ G ℤ) 2 :=
  haveI := isIso_deltaHom G
  (asIso (deltaHom G)).toLinearEquiv

section HomIdentification

variable (Γ : Type) [Group Γ] (M : Type) [AddCommGroup M]

/-- The action of `Rep.trivial` is trivial (rewriting lemma for the coercion shape produced by
`mem_cocycles₁_iff`). -/
theorem trivialRep_ρ_apply (g : Γ) (x : M) : (Rep.trivial ℤ Γ M).ρ g x = x := by
  rw [Rep.trivial_ρ]
  rfl

/-- The cocycle attached to an additive map `Additive Γ →+ M`. -/
noncomputable def homCocycle (ψ : Additive Γ →+ M) :
    groupCohomology.cocycles₁ (Rep.trivial ℤ Γ M) :=
  ⟨fun g => ψ (Additive.ofMul g), by
    rw [groupCohomology.mem_cocycles₁_iff]
    intro g h
    rw [show Additive.ofMul (g * h) = Additive.ofMul g + Additive.ofMul h from ofMul_mul g h,
      map_add, trivialRep_ρ_apply, add_comm]⟩

/-- The canonical map `Hom(Γ, M) → H¹(Γ, M)` for **trivial** coefficients; here `Hom(Γ, M)` is
`Additive Γ →+ M`, i.e. additive maps on the additive group attached to `Γ`.  An additive map is a
1-cocycle (`mem_cocycles₁_iff` with trivial action), and `B¹(Γ,M) = 0`. -/
noncomputable def homToH1 : (Additive Γ →+ M) →+ groupCohomology (Rep.trivial ℤ Γ M) 1 where
  toFun ψ := groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M ψ)
  map_zero' := by
    show groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M 0)
      = (0 : groupCohomology (Rep.trivial ℤ Γ M) 1)
    rw [show homCocycle Γ M 0 = 0 from rfl]
    exact map_zero _
  map_add' ψ χ := by
    show groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M (ψ + χ))
      = groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M ψ)
        + groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M χ)
    rw [← map_add]
    apply congrArg (groupCohomology.H1π (Rep.trivial ℤ Γ M))
    apply groupCohomology.cocycles₁_ext
    intro g
    rfl

theorem coboundaries₁_eq_bot : groupCohomology.coboundaries₁ (Rep.trivial ℤ Γ M) = ⊥ := by
  rw [groupCohomology.coboundaries₁, groupCohomology.d₀₁_eq_zero]
  exact LinearMap.range_zero

theorem homToH1_injective : Function.Injective (homToH1 Γ M) := by
  intro ψ χ h
  have hsub : groupCohomology.H1π (Rep.trivial ℤ Γ M) (homCocycle Γ M (ψ - χ)) = 0 := by
    have h0 : homToH1 Γ M (ψ - χ) = 0 := by rw [map_sub, h, sub_self]
    rw [← h0]
    rfl
  have hmem : (fun g => (ψ - χ) (Additive.ofMul g)) ∈
      groupCohomology.coboundaries₁ (Rep.trivial ℤ Γ M) :=
    (groupCohomology.H1π_eq_zero_iff _).1 hsub
  rw [coboundaries₁_eq_bot Γ M, Submodule.mem_bot] at hmem
  have hz : ψ - χ = 0 := by
    ext z
    have h1 := congrFun hmem (Additive.toMul z)
    show (ψ - χ) z = 0
    rw [show z = Additive.ofMul (Additive.toMul z) from rfl]
    exact h1
  exact sub_eq_zero.mp hz

theorem homToH1_surjective : Function.Surjective (homToH1 Γ M) := by
  intro x
  induction x using groupCohomology.H1_induction_on with
  | h y =>
    have hyc : (y : Γ → M) ∈ groupCohomology.cocycles₁ (Rep.trivial ℤ Γ M) := y.2
    have hy_apply : ∀ g h : Γ, y (g * h) = y h + y g := by
      intro g h
      have := (groupCohomology.mem_cocycles₁_iff (y : Γ → M)).1 hyc g h
      rw [this, trivialRep_ρ_apply]
    refine ⟨AddMonoidHom.mk' (fun w => y (Additive.toMul w)) ?_, ?_⟩
    · intro z w
      show y (Additive.toMul (z + w)) = y (Additive.toMul z) + y (Additive.toMul w)
      rw [show Additive.toMul (z + w) = Additive.toMul z * Additive.toMul w from rfl, hy_apply,
        add_comm]
    · show groupCohomology.H1π (Rep.trivial ℤ Γ M)
          (homCocycle Γ M (AddMonoidHom.mk' (fun w => y (Additive.toMul w)) _))
        = groupCohomology.H1π (Rep.trivial ℤ Γ M) y
      apply congrArg (groupCohomology.H1π (Rep.trivial ℤ Γ M))
      apply groupCohomology.cocycles₁_ext
      intro g
      rfl

/-- **`Hom(Γ, M) ≅ H¹(Γ, M)`** for a group `Γ` and a trivial `Γ`-module `M`, where `Hom` is taken
in the additive group `Additive Γ`. -/
noncomputable def homAddEquivH1 : (Additive Γ →+ M) ≃+ groupCohomology (Rep.trivial ℤ Γ M) 1 :=
  AddEquiv.ofBijective (homToH1 Γ M)
    ⟨homToH1_injective Γ M, homToH1_surjective Γ M⟩

end HomIdentification

section Character

/-- **The character-side invariant `δ : Hom(G, ℚ/ℤ) ≅ H²(G, ℤ)`** for finite `G` (characters are
the additive maps `Additive G →+ ℚ/ℤ`): the composite of `Hom(G, ℚ/ℤ) ≅ H¹(G, ℚ/ℤ)`
(`homAddEquivH1`) with the connecting map (`deltaLinearEquiv`).  This is the map appearing in the
θ-construction's character formula `χ(θ a) = ι_u(a ∪ δχ)`. -/
noncomputable def deltaHomChar (G : Type) [Group G] [Fintype G] :
    (Additive G →+ qmodZ) ≃+ groupCohomology (Rep.trivial ℤ G ℤ) 2 :=
  (homAddEquivH1 G qmodZ).trans (deltaLinearEquiv G).toAddEquiv

end Character

end NK.NUV2.RouteC
