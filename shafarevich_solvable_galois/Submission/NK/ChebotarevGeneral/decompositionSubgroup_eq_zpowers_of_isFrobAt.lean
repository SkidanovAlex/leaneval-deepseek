/-!
# The decomposition group of an unramified prime is generated by its Frobenius

Let `N/K` be a finite Galois extension of number fields, `P` a prime of `𝓞 N` unramified over
`K` and `σ` a Frobenius element at `P`.  Then the decomposition group of `P` is the cyclic
subgroup generated by `σ`:

`decompositionSubgroup (K := K) P = Subgroup.zpowers σ`.

The proof is the classical comparison of cardinalities.  A Frobenius element fixes its own prime
(`NK.Chebotarev.IsFrobAtStabilizes`), so `⟨σ⟩ ≤ D_P`; the order of the decomposition group is
`e(P|p) · f(P|p)` (`Submission.NeukirchUchida.Local.card_decompositionSubgroup`) with `e = 1` by
hypothesis, while the order of a Frobenius is the inertia degree
(`NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg`).  Two subgroups of the same finite cardinality,
one contained in the other, are equal.
-/

namespace NK.ChebotarevGeneral

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

open IsDedekindDomain

/-- **The decomposition group of an unramified prime is generated by its Frobenius.** -/
theorem decompositionSubgroup_eq_zpowers_of_isFrobAt {K N : Type*} [Field K] [NumberField K]
    [Field N] [NumberField N] [Algebra K N] [FiniteDimensional K N] [IsGalois K N]
    (P : NK.Chebotarev.PrimeIdeal N) (σ : Gal(N/K))
    (hram : P.asIdeal.ramificationIdx (NumberField.RingOfIntegers K) = 1)
    (hfrob : NK.Chebotarev.IsFrobAt (K := K) (L := N) P σ) :
    Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) P = Subgroup.zpowers σ := by
  -- the prime `p` of `K` below `P`
  have hlies : P.asIdeal.LiesOver (P.under (NumberField.RingOfIntegers K)).asIdeal := by
    rw [IsDedekindDomain.HeightOneSpectrum.under_asIdeal]
    exact ⟨rfl⟩
  -- a Frobenius at `P` fixes `P`, so it lies in the decomposition group
  have hmem : σ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) P := by
    rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup]
    exact IsDedekindDomain.HeightOneSpectrum.ext (by
      rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
      exact NK.Chebotarev.IsFrobAtStabilizes hfrob)
  -- the decomposition group has `e · f = f` elements
  have hcard : Nat.card ↥(Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) P)
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) := by
    rw [Submission.NeukirchUchida.Local.card_decompositionSubgroup (K := K) (L := N)
      (P.under (NumberField.RingOfIntegers K)) P hlies]
    letI : MulSemiringAction Gal(N/K) (NumberField.RingOfIntegers N) :=
      IsIntegralClosure.MulSemiringAction (NumberField.RingOfIntegers K) K N
        (NumberField.RingOfIntegers N)
    haveI hGal : IsGaloisGroup Gal(N/K) (NumberField.RingOfIntegers K)
        (NumberField.RingOfIntegers N) :=
      IsGaloisGroup.of_isFractionRing Gal(N/K) (NumberField.RingOfIntegers K)
        (NumberField.RingOfIntegers N) K N
    haveI := hlies
    rw [Ideal.ramificationIdxIn_eq_ramificationIdx (A := NumberField.RingOfIntegers K)
          (B := NumberField.RingOfIntegers N)
          (P.under (NumberField.RingOfIntegers K)).asIdeal P.asIdeal (Gal(N/K)),
        Ideal.inertiaDegIn_eq_inertiaDeg (A := NumberField.RingOfIntegers K)
          (B := NumberField.RingOfIntegers N)
          (P.under (NumberField.RingOfIntegers K)).asIdeal P.asIdeal (Gal(N/K)), hram, one_mul]
  -- the cyclic group generated by `σ` has `orderOf σ = f` elements
  have hcardzp : Nat.card ↥(Subgroup.zpowers σ)
      = P.asIdeal.inertiaDeg (NumberField.RingOfIntegers K) := by
    rw [Nat.card_zpowers]
    exact NK.Chebotarev.IsFrobAtOrderOfEqInertiaDeg hlies hram hfrob
  exact (Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hmem)
    (by rw [hcard, hcardzp])).symm

end NK.ChebotarevGeneral
