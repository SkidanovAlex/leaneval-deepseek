open scoped Classical
open IntermediateField

set_option linter.unusedVariables false

namespace NK.TameStructureDeep.Tame

noncomputable section

variable {κ K' : Type*} [Field κ] [Field K'] [Algebra κ K']

/-- **Every root of unity of order prime to `p` lies in `κ^{ur} = κ(μ_{p'})`.**

If `ζ ^ m = 1` and `p ∤ m`, then `ζ` is a root of unity whose order divides `m`, hence is prime
to `p`, so `ζ` generates one of the layers `κ⟮ζ⟯` whose supremum is
`NK.LocalAnabelian.unramifiedClosure p`. -/
theorem mem_unramifiedClosure_of_pow_eq_one {p m : ℕ} (hm : ¬ p ∣ m) {ζ : K'}
    (hζ : ζ ^ m = 1) :
    ζ ∈ NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p := by
  have hdvd : orderOf ζ ∣ m := orderOf_dvd_iff_pow_eq_one.mpr hζ
  have hne : ¬ p ∣ orderOf ζ := fun h => hm (h.trans hdvd)
  exact NK.TameStructureDeep.mem_unramifiedClosure_of_isPrimitiveRoot (κ := κ) (K' := K')
    hne (IsPrimitiveRoot.iff_orderOf.mpr rfl)

/-- **The compositum `U ⊔ κ⟮S⟯` is contained in the field generated by `U ∪ S`.** -/
theorem sup_le_adjoin_union (U : IntermediateField κ K') (S : Set K') :
    U ⊔ IntermediateField.adjoin κ S ≤ IntermediateField.adjoin κ ((U : Set K') ∪ S) := by
  rw [IntermediateField.sup_def]
  refine IntermediateField.adjoin_le_iff.mpr (Set.union_subset ?_ ?_)
  · intro x hx
    exact IntermediateField.subset_adjoin κ _ (Or.inl hx)
  · intro x hx
    have hle : IntermediateField.adjoin κ S ≤ IntermediateField.adjoin κ ((U : Set K') ∪ S) :=
      IntermediateField.adjoin_le_iff.mpr
        (fun y hy => IntermediateField.subset_adjoin κ _ (Or.inr hy))
    exact SetLike.le_def.mp hle hx

/-- **The field generated by `U ∪ {β}` is contained in the Kummer layer `U ⊔ κ⟮β⟯`.** -/
theorem adjoin_union_le_sup (U : IntermediateField κ K') (β : K') :
    IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) ≤
      U ⊔ IntermediateField.adjoin κ ({β} : Set K') := by
  refine IntermediateField.adjoin_le_iff.mpr (Set.union_subset ?_ ?_)
  · intro x hx
    exact (le_sup_left : U ≤ U ⊔ IntermediateField.adjoin κ ({β} : Set K')) hx
  · exact Set.singleton_subset_iff.mpr
      (SetLike.le_def.mp le_sup_right (IntermediateField.mem_adjoin_simple_self κ β))

/-- **Transport of membership between Kummer layers**: if `β₁` lies in `κ(U ∪ {β})` then so does
every element of `κ(U ∪ {β₁})`. -/
theorem mem_adjoin_union_of_mem {U : IntermediateField κ K'} {β β₁ y : K'}
    (hβ₁ : β₁ ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')))
    (hy : y ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β₁} : Set K'))) :
    y ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) :=
  SetLike.le_def.mp (IntermediateField.adjoin_le_iff.mpr (Set.union_subset
    (fun x hx => IntermediateField.subset_adjoin κ _ (Or.inl hx))
    (Set.singleton_subset_iff.mpr hβ₁))) hy

/-- `κ^{tr}` is generated over `κ` by `κ^{ur}` together with the prime-to-`p` roots of `π`. -/
theorem tameClosure_le_adjoin_union (p : ℕ) (π : κ) :
    tameClosure (K' := K') p π ≤
      IntermediateField.adjoin κ
        (((NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p :
            IntermediateField κ K') : Set K') ∪ tameRootSet (K' := K') p π) := by
  rw [tameClosure]
  exact sup_le_adjoin_union _ _

/-- **A Kummer layer of the tame closure.**

Every element `α` of the maximal tamely ramified extension
`κ^{tr} = κ^{ur}(π^{1/n} : (n,p) = 1)` (`NK.TameStructureDeep.Tame.tameClosure p π`) already
lies in a *single* Kummer layer `κ^{ur} ⊔ κ⟮β⟯` with `β ^ n = π`, `p ∤ n`:

  `∃ n, p ∤ n, ∃ β, β ^ n = π, α ∈ κ^{ur} ⊔ κ⟮β⟯`.

Indeed `κ^{tr}` is generated over `κ` by `κ^{ur}` and the prime-to-`p` roots `β` of `π`
(`tameClosure_le_adjoin_union`), and the Kummer layers `κ^{ur} ⊔ κ⟮β⟯` form a *directed* family
(`exists_root_capturing_pair`: two roots of orders `n₁`, `n₂` are captured by a root of order
`lcm n₁ n₂`), so an element of the union is already in one member. -/
theorem exists_kummerLayer_of_mem_tameClosure {κ K' : Type*} [Field κ] [Field K'] [Algebra κ K']
    [IsSepClosure κ K'] (p : ℕ) (hp : p.Prime) {π : κ} {α : K'}
    (hα : α ∈ NK.TameStructureDeep.Tame.tameClosure (κ := κ) (K' := K') p π) :
    ∃ (n : ℕ) (β : K'), ¬ p ∣ n ∧ β ^ n = algebraMap κ K' π ∧
      α ∈ NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p ⊔
        IntermediateField.adjoin κ ({β} : Set K') := by
  classical
  let U : IntermediateField κ K' := NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p
  have hα' : α ∈ IntermediateField.adjoin κ ((U : Set K') ∪ tameRootSet (K' := K') p π) :=
    SetLike.le_def.mp (tameClosure_le_adjoin_union (κ := κ) (K' := K') p π) hα
  have key : ∀ x ∈ IntermediateField.adjoin κ ((U : Set K') ∪ tameRootSet (K' := K') p π),
      ∃ (n : ℕ) (β : K'), ¬ p ∣ n ∧ β ^ n = algebraMap κ K' π ∧
        x ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) := by
    intro x hx
    refine IntermediateField.adjoin_induction κ (p := fun y _ =>
      ∃ (n : ℕ) (β : K'), ¬ p ∣ n ∧ β ^ n = algebraMap κ K' π ∧
        y ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K'))) ?_ ?_ ?_ ?_ ?_ hx
    · rintro y (hy | hy)
      · exact ⟨1, algebraMap κ K' π, hp.not_dvd_one, by simp,
          IntermediateField.subset_adjoin κ _ (Or.inl hy)⟩
      · obtain ⟨n, hn, hyn⟩ := hy
        exact ⟨n, y, hn, hyn,
          IntermediateField.subset_adjoin κ _ (Or.inr (by simp))⟩
    · intro c
      exact ⟨1, algebraMap κ K' π, hp.not_dvd_one, by simp,
        IntermediateField.algebraMap_mem _ c⟩
    · rintro y z hy hz ⟨n₁, β₁, hn₁, hβ₁, hmem₁⟩ ⟨n₂, β₂, hn₂, hβ₂, hmem₂⟩
      obtain ⟨n, β, hn, hβ, hc₁, hc₂⟩ := exists_root_capturing_pair (κ := κ) (K' := K')
        (π := algebraMap κ K' π) hp hn₁ hn₂ hβ₁ hβ₂
      have hc₁' : β₁ ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) :=
        SetLike.le_def.mp (sup_le_adjoin_union U ({β} : Set K')) hc₁
      have hc₂' : β₂ ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) :=
        SetLike.le_def.mp (sup_le_adjoin_union U ({β} : Set K')) hc₂
      exact ⟨n, β, hn, hβ, add_mem (mem_adjoin_union_of_mem hc₁' hmem₁)
        (mem_adjoin_union_of_mem hc₂' hmem₂)⟩
    · rintro y hy ⟨n, β, hn, hβ, hmem⟩
      exact ⟨n, β, hn, hβ, inv_mem hmem⟩
    · rintro y z hy hz ⟨n₁, β₁, hn₁, hβ₁, hmem₁⟩ ⟨n₂, β₂, hn₂, hβ₂, hmem₂⟩
      obtain ⟨n, β, hn, hβ, hc₁, hc₂⟩ := exists_root_capturing_pair (κ := κ) (K' := K')
        (π := algebraMap κ K' π) hp hn₁ hn₂ hβ₁ hβ₂
      have hc₁' : β₁ ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) :=
        SetLike.le_def.mp (sup_le_adjoin_union U ({β} : Set K')) hc₁
      have hc₂' : β₂ ∈ IntermediateField.adjoin κ ((U : Set K') ∪ ({β} : Set K')) :=
        SetLike.le_def.mp (sup_le_adjoin_union U ({β} : Set K')) hc₂
      exact ⟨n, β, hn, hβ, mul_mem (mem_adjoin_union_of_mem hc₁' hmem₁)
        (mem_adjoin_union_of_mem hc₂' hmem₂)⟩
  obtain ⟨n, β, hn, hβ, hmem⟩ := key α hα'
  exact ⟨n, β, hn, hβ, SetLike.le_def.mp (adjoin_union_le_sup U β) hmem⟩

end

end NK.TameStructureDeep.Tame
