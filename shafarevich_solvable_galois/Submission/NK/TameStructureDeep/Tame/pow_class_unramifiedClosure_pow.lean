namespace NK.TameStructureDeep.Tame

/-- **Auxiliary induction step for `pow_class_unramifiedClosure_pow`.**

In the *multiplicative* form which makes the induction over `n` transparent: if
`π` is a uniformiser of `κ = K_𝔭` whose image `P` in `K'` is nonzero, then for every `n ≥ 1`
prime to the residue characteristic and every `b` in `κ^{ur} = unramifiedClosure p` there are
`j : ℤ` and `c ∈ κ^{ur}` with `b = P ^ j * c ^ n`.

The case `n` a prime is `pow_class_unramifiedClosure`; for composite `n` we factor `n = ℓ * m`
with `ℓ` prime and apply the induction hypothesis in the form `b = P ^ j₁ * c₁ ^ m` and the
prime case to `c₁`, in the form `c₁ = P ^ j₂ * c₂ ^ ℓ`. -/
private theorem pow_class_aux {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {π : 𝔭.adicCompletionIntegers K} (hπ : IsUniformizerAt 𝔭 π)
    (hP0 : algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) ≠ 0) :
    ∀ n : ℕ, 0 < n → Nat.Coprime n (resCharAt 𝔭) → ∀ b : K',
      b ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
        (resCharAt 𝔭) →
      ∃ j : ℤ, ∃ c : K', c ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K)
        (K' := K') (resCharAt 𝔭) ∧
        b = (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) ^ j * c ^ n := by
  set P : K' := algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) with hPdef
  have hP : P ≠ 0 := by rw [hPdef]; exact hP0
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn hcop b hb
    rcases lt_or_ge n 2 with hlt | hge
    · -- `n = 1`: take `c = b`, `j = 0`
      have hn1 : n = 1 := by omega
      subst hn1
      exact ⟨0, b, hb, by simp⟩
    · -- `n ≥ 2`: factor `n = ℓ * m` with `ℓ` prime
      obtain ⟨ℓ, hℓprime, hℓdvd⟩ := Nat.exists_prime_and_dvd (by omega : n ≠ 1)
      set m : ℕ := n / ℓ with hmdef
      have hmul : ℓ * m = n := by rw [hmdef]; exact Nat.mul_div_cancel' hℓdvd
      have hmpos : 0 < m := by
        rcases Nat.eq_zero_or_pos m with h0 | h
        · rw [h0, mul_zero] at hmul; omega
        · exact h
      have hmlt : m < n := by
        have h1 := Nat.mul_lt_mul_of_pos_right hℓprime.one_lt hmpos
        rw [one_mul, hmul] at h1
        exact h1
      have hmcop : Nat.Coprime m (resCharAt 𝔭) :=
        hcop.coprime_dvd_left (by rw [← hmul]; exact dvd_mul_left m ℓ)
      have hℓcop : Nat.Coprime ℓ (resCharAt 𝔭) := hcop.coprime_dvd_left hℓdvd
      have hℓp : ℓ ≠ resCharAt 𝔭 := by
        intro h
        rw [← h] at hℓcop
        exact hℓprime.ne_one ((Nat.coprime_self ℓ).mp hℓcop)
      -- the inductive hypothesis applied to `b` and the prime case applied to `c₁`
      obtain ⟨j₁, c₁, hc₁mem, hc₁eq⟩ := ih m hmlt hmpos hmcop b hb
      obtain ⟨j₂, c₂, hc₂mem, hc₂eq⟩ := pow_class_unramifiedClosure 𝔭 hπ hℓprime hℓp hc₁mem
      have hc₁' : P ^ j₂ * c₂ ^ ℓ = c₁ := by
        have h := (eq_div_iff_mul_eq (zpow_ne_zero j₂ hP)).mp hc₂eq
        rw [mul_comm] at h
        exact h
      -- exponent bookkeeping
      have hkey : P ^ j₁ * (P ^ j₂ * c₂ ^ ℓ) ^ m = P ^ (j₁ + (m : ℤ) * j₂) * c₂ ^ n := by
        rw [mul_pow, ← pow_mul, hmul]
        have h3 : (P ^ j₂) ^ m = P ^ (j₂ * (m : ℤ)) := by
          rw [← zpow_natCast (P ^ j₂) m, ← zpow_mul]
        rw [h3, ← mul_assoc, ← zpow_add₀ hP, mul_comm j₂ (m : ℤ)]
      refine ⟨j₁ + (m : ℤ) * j₂, c₂, hc₂mem, ?_⟩
      rw [hc₁eq, ← hc₁']
      exact hkey

/-- **`n`-th power form of `pow_class_unramifiedClosure`.**

Let `κ = K_𝔭`, `p = resCharAt 𝔭`, `π` a uniformiser of `κ` and `κ^{ur} = unramifiedClosure p ⊆ K'`.
For `n ≥ 1` prime to `p`, every element `b` of `κ^{ur}` is `π^j` times an `n`-th power of an
element of `κ^{ur}`, `j : ℤ`.  (Equivalently: `κ^{ur×}/(κ^{ur×})^n` is generated by the class of
`π`.)  Follows from `pow_class_unramifiedClosure` (the case `n` a prime `≠ p`) by induction. -/
theorem pow_class_unramifiedClosure_pow {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {π : 𝔭.adicCompletionIntegers K} (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π)
    {n : ℕ} (hn : 0 < n) (hcop : Nat.Coprime n (NK.TameStructureDeep.Tame.resCharAt 𝔭))
    {b : K'} (hb : b ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭)) :
    ∃ (j : ℤ) (c : K'), c ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K)
        (K' := K') (NK.TameStructureDeep.Tame.resCharAt 𝔭) ∧
      c ^ n = b / (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) ^ j := by
  by_cases hP : (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) = 0
  · -- degenerate case: `π` maps to `0`, and `b / 0 = 0 = 0 ^ n`
    refine ⟨1, 0, zero_mem _, ?_⟩
    rw [hP, zero_pow hn.ne', zero_zpow 1 (by norm_num), div_zero]
  · obtain ⟨j, c, hcmem, hceq⟩ := pow_class_aux 𝔭 hπ hP n hn hcop b hb
    refine ⟨j, c, hcmem, ?_⟩
    rw [hceq, mul_div_cancel_left₀ _ (zpow_ne_zero j hP)]

end NK.TameStructureDeep.Tame
