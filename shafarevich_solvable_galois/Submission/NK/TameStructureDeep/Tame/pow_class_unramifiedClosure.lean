theorem pow_class_unramifiedClosure {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {π : 𝔭.adicCompletionIntegers K} (hπ : NK.TameStructureDeep.Tame.IsUniformizerAt 𝔭 π)
    {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓp : ℓ ≠ NK.TameStructureDeep.Tame.resCharAt 𝔭)
    {b : K'} (hb : b ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
      (NK.TameStructureDeep.Tame.resCharAt 𝔭)) :
    ∃ (j : ℤ) (c : K'), c ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K)
        (K' := K') (NK.TameStructureDeep.Tame.resCharAt 𝔭) ∧
      c ^ ℓ = b / (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) ^ j := by
  classical
  have hp : (resCharAt 𝔭).Prime := NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭
  -- (0) the trivial case
  rcases eq_or_ne b 0 with rfl | hb0
  · refine ⟨0, 0, zero_mem _, ?_⟩
    simp [hℓ.ne_zero]
  -- (1) reduce `b` to a single primitive-root layer
  obtain ⟨M, ζ, hMp, hζ, hbζ⟩ :=
    exists_adjoin_primitiveRoot_of_mem_unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K') hp hb
  have hM0 : M ≠ 0 := fun h => hMp (h ▸ dvd_zero (resCharAt 𝔭))
  haveI hMne : NeZero M := ⟨hM0⟩
  -- (2) numerical data
  have hcop_qM : Nat.Coprime (NK.LocalStructure.residueCard K 𝔭) M :=
    coprime_residueCard_of_not_dvd 𝔭 hMp
  obtain ⟨hdvd, hdpos⟩ :=
    NK.TameStructureDeep.Degree.dvd_pow_orderOf_sub_one
      (q := NK.LocalStructure.residueCard K 𝔭) hM0 hcop_qM
  set d : ℕ := orderOf ((NK.LocalStructure.residueCard K 𝔭 : ZMod M)) with hddef
  have hMd : M ∣ NK.LocalStructure.residueCard K 𝔭 ^ d - 1 := hdvd
  have hdpos' : 0 < d := hdpos
  have hDpos : 0 < d * ℓ * (ℓ - 1) := by
    have h2 : 1 ≤ ℓ - 1 := by have := hℓ.two_le; omega
    exact Nat.mul_pos (Nat.mul_pos hdpos' hℓ.pos) (by omega)
  -- (3) the tower of global fields and primes
  obtain ⟨L₁, hF₁, hNF₁, hA₁, 𝔮₁, hlies₁, he₁, hf₁, hfr₁⟩ :=
    NK.TameStructureDeep.Degree.exists_unramified_extension_of_inertiaDeg' (L := K) 𝔭 d hdpos'
  letI : Field L₁ := hF₁
  letI : NumberField L₁ := hNF₁
  letI : Algebra K L₁ := hA₁
  haveI hFD₁ : FiniteDimensional K L₁ := FiniteDimensional.of_finrank_pos (by rw [hfr₁]; exact hdpos')
  obtain ⟨L₂, hF₂, hNF₂, hA₂, 𝔮₂, hlies₂, he₂, hf₂, hfr₂⟩ :=
    NK.TameStructureDeep.Degree.exists_unramified_extension_of_inertiaDeg'
      (L := L₁) 𝔮₁ (ℓ * (ℓ - 1)) (by
        have h2 : 1 ≤ ℓ - 1 := by have := hℓ.two_le; omega
        exact Nat.mul_pos hℓ.pos (by omega))
  letI : Field L₂ := hF₂
  letI : NumberField L₂ := hNF₂
  letI : Algebra L₁ L₂ := hA₂
  have hposk : 0 < ℓ * (ℓ - 1) := by
    have h2 : 1 ≤ ℓ - 1 := by have := hℓ.two_le; omega
    exact Nat.mul_pos hℓ.pos (by omega)
  haveI hFD₂ : FiniteDimensional L₁ L₂ :=
    FiniteDimensional.of_finrank_pos (by rw [hfr₂]; exact hposk)
  letI : Algebra K L₂ := ((algebraMap L₁ L₂).comp (algebraMap K L₁)).toAlgebra
  haveI hSTK : IsScalarTower K L₁ L₂ := IsScalarTower.of_algebraMap_eq (fun x => rfl)
  haveI hlies₂₀ : 𝔮₂.asIdeal.LiesOver 𝔭.asIdeal :=
    Ideal.LiesOver.trans 𝔮₂.asIdeal 𝔮₁.asIdeal 𝔭.asIdeal
  -- (4) the local fields
  letI hAlgκ₁ : Algebra (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔮₁ hlies₁)
  haveI hST₁ : IsScalarTower K (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) :=
    Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion 𝔭 𝔮₁ hlies₁
  letI hAlgκ₂ : Algebra (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap 𝔮₁ 𝔮₂ hlies₂)
  haveI hST₂ : IsScalarTower L₁ (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) :=
    Commons.NumberTheory.NumberField.Completion.isScalarTower_adicCompletion 𝔮₁ 𝔮₂ hlies₂
  letI hAlgκκ₂ : Algebra (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) :=
    RingHom.toAlgebra (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔮₂ hlies₂₀)
  have hcompat : (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)).comp
      (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁))
      = algebraMap (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) := by
    show (Commons.RingTheory.Henselian.adicCompletionMap 𝔮₁ 𝔮₂ hlies₂).comp
        (Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔮₁ hlies₁) = _
    exact Commons.NumberTheory.NumberField.Completion.adicCompletionMap_comp 𝔭 𝔮₁ 𝔮₂ hlies₁ hlies₂ hlies₂₀
  -- cardinalities of the residue fields
  have hcard₁ : Nat.card (IsLocalRing.ResidueField (𝔮₁.adicCompletionIntegers L₁))
      = (NK.LocalStructure.residueCard K 𝔭) ^ d := by
    rw [Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletion_eq_pow_inertiaDeg
      K L₁ 𝔭 𝔮₁ hlies₁, hf₁]
    rfl
  have hcard₂ : Nat.card (IsLocalRing.ResidueField (𝔮₂.adicCompletionIntegers L₂))
      = (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) := by
    rw [Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletion_eq_pow_inertiaDeg
      L₁ L₂ 𝔮₁ 𝔮₂ hlies₂, hf₂, hcard₁, ← pow_mul]
    ring_nf
  haveI hSTκκ₂ : IsScalarTower (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) :=
    IsScalarTower.of_algebraMap_eq (fun x => (RingHom.congr_fun hcompat x).symm)
  -- (5) the embedding of the big local field into `K'`
  haveI hFinκ₁ : FiniteDimensional (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) :=
    FiniteDimensional.of_finrank_pos (by
      rw [← Commons.NumberTheory.NumberField.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
        (K := K) (L := L₁) 𝔭 𝔮₁ hlies₁, he₁, one_mul, hf₁]
      exact hdpos')
  haveI hFinκ₁κ₂ : FiniteDimensional (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) :=
    FiniteDimensional.of_finrank_pos (by
      rw [← Commons.NumberTheory.NumberField.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
        (K := L₁) (L := L₂) 𝔮₁ 𝔮₂ hlies₂, he₂, one_mul, hf₂]
      exact hposk)
  haveI hFinκκ₂ : FiniteDimensional (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) :=
    FiniteDimensional.trans (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
  haveI hIntκ₂ : Algebra.IsIntegral (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) :=
    ⟨fun x => IsIntegral.of_finite _ x⟩
  haveI hCharκ : CharZero (𝔭.adicCompletion K) :=
    Commons.NumberTheory.NumberField.charZero_adicCompletion 𝔭
  haveI hSepκ₂ : Algebra.IsSeparable (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) :=
    Algebra.IsSeparable.of_integral _ _
  obtain ⟨ι⟩ := Commons.FieldTheory.SeparableClosure.nonempty_algHom_of_isSepClosure
    (F := 𝔭.adicCompletion K) (F' := 𝔮₂.adicCompletion L₂) (E := K')
  have hιinj : Function.Injective ι := ι.toRingHom.injective
  -- (6) the primitive roots of unity used for the transport
  obtain ⟨η₁, hη₁, -⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_isPrimitiveRoot_lift_adicCompletionB
      𝔭 𝔮₁ hlies₁
  obtain ⟨η₂, hη₂, hη₂res⟩ :=
    Commons.NumberTheory.NumberField.Completion.exists_isPrimitiveRoot_lift_adicCompletionB
      𝔮₁ 𝔮₂ hlies₂
  have hη₁' : IsPrimitiveRoot (η₁ : 𝔮₁.adicCompletion L₁)
      ((NK.LocalStructure.residueCard K 𝔭) ^ d - 1) := by
    rw [← hcard₁]; exact hη₁
  have hη₂' : IsPrimitiveRoot (η₂ : 𝔮₂.adicCompletion L₂)
      ((NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) - 1) := by
    rw [← hcard₂]; exact hη₂
  -- the image of `η₁` in `κ₂`, and then in `K'`
  have hinj₁₂ : Function.Injective
      (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)) :=
    Commons.NumberTheory.NumberField.Completion.adicCompletionMap_injective 𝔮₁ 𝔮₂ hlies₂
  set η₁₂ : 𝔮₂.adicCompletion L₂ :=
    algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) (η₁ : 𝔮₁.adicCompletion L₁) with hη₁₂def
  have hη₁₂ : IsPrimitiveRoot η₁₂ ((NK.LocalStructure.residueCard K 𝔭) ^ d - 1) :=
    hη₁'.map_of_injective (f := (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) :
      𝔮₁.adicCompletion L₁ →+* 𝔮₂.adicCompletion L₂)) hinj₁₂
  -- `q ≥ 2` and `d * ℓ * (ℓ - 1) ≠ 0`
  have hq2 : 2 ≤ NK.LocalStructure.residueCard K 𝔭 := by
    obtain ⟨f, hf, hqf⟩ :=
      NK.LocalStructure.Tame.residueCard_eq_pow_of_charP 𝔭 hp
        (NK.Mine.charP_ringChar_residueField_adicCompletion 𝔭)
    rw [hqf]
    calc 2 ≤ resCharAt 𝔭 := hp.two_le
      _ = (resCharAt 𝔭) ^ 1 := (pow_one _).symm
      _ ≤ (resCharAt 𝔭) ^ f := Nat.pow_le_pow_right hp.pos (by omega)
  have hDne : d * ℓ * (ℓ - 1) ≠ 0 :=
    Nat.mul_ne_zero (Nat.mul_ne_zero hdpos'.ne' hℓ.ne_zero) (by have := hℓ.two_le; omega)
  -- (7) the image `μ = ι η₁₂` is a primitive `(q ^ d - 1)`-st root of unity, and `ζ` is a power of it
  have hμ : IsPrimitiveRoot (ι η₁₂) ((NK.LocalStructure.residueCard K 𝔭) ^ d - 1) :=
    hη₁₂.map_of_injective ι.injective
  haveI hNzd : NeZero ((NK.LocalStructure.residueCard K 𝔭) ^ d - 1) :=
    ⟨by
      have h1 : 2 ≤ (NK.LocalStructure.residueCard K 𝔭) ^ d :=
        le_trans hq2 (Nat.le_self_pow hdpos'.ne' _)
      omega⟩
  have hζn : ζ ^ ((NK.LocalStructure.residueCard K 𝔭) ^ d - 1) = 1 := by
    obtain ⟨t, ht⟩ := hMd
    rw [ht, pow_mul, hζ.pow_eq_one, one_pow]
  obtain ⟨k, -, hk⟩ := hμ.eq_pow_of_pow_eq_one hζn
  have hb_mu : b ∈ IntermediateField.adjoin (𝔭.adicCompletion K) ({ι η₁₂} : Set K') := by
    refine (IntermediateField.adjoin_le_iff.mpr ?_) hbζ
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [← hk]
    exact pow_mem (IntermediateField.mem_adjoin_simple_self (𝔭.adicCompletion K) (ι η₁₂)) k
  have hmap_eq : IntermediateField.map ι
      (IntermediateField.adjoin (𝔭.adicCompletion K) ({η₁₂} : Set (𝔮₂.adicCompletion L₂)))
      = IntermediateField.adjoin (𝔭.adicCompletion K) ({ι η₁₂} : Set K') := by
    rw [IntermediateField.adjoin_map, Set.image_singleton]
  have hb_map : b ∈ IntermediateField.map ι
      (IntermediateField.adjoin (𝔭.adicCompletion K) ({η₁₂} : Set (𝔮₂.adicCompletion L₂))) := by
    rw [hmap_eq]; exact hb_mu
  obtain ⟨y, hy_mem, hy_eq⟩ := (IntermediateField.mem_map _).mp hb_map
  -- `y` lies in the image of `κ₁`
  have hη₁₂_mem : η₁₂ ∈ (IsScalarTower.toAlgHom (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
      (𝔮₂.adicCompletion L₂)).fieldRange := by
    rw [AlgHom.mem_fieldRange]
    refine ⟨(η₁ : 𝔮₁.adicCompletion L₁), ?_⟩
    show algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
      (η₁ : 𝔮₁.adicCompletion L₁) = η₁₂
    exact hη₁₂def.symm
  obtain ⟨x₁, hx₁_eq⟩ : ∃ x₁ : 𝔮₁.adicCompletion L₁,
      algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) x₁ = y := by
    have hle : IntermediateField.adjoin (𝔭.adicCompletion K) ({η₁₂} : Set (𝔮₂.adicCompletion L₂)) ≤
        (IsScalarTower.toAlgHom (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
          (𝔮₂.adicCompletion L₂)).fieldRange :=
      IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr hη₁₂_mem)
    obtain ⟨z, hz⟩ := (AlgHom.mem_fieldRange).mp (hle hy_mem)
    exact ⟨z, by rw [← hz, IsScalarTower.toAlgHom_apply]⟩
  have hy_ne : y ≠ 0 := fun h => hb0 (by rw [← hy_eq, h, map_zero])
  have hx₁_ne : x₁ ≠ 0 := fun h => hy_ne (by rw [← hx₁_eq, h, map_zero])
  -- (8) decomposition of `x₁` along the uniformiser of `κ`
  obtain ⟨j, u₁, hu₁⟩ :=
    NK.TameStructureDeep.Tame.exists_units_mul_zpow_adicCompletionMap_uniformizer 𝔭 𝔮₁
      hlies₁ he₁ hπ hx₁_ne
  -- `ℓ` is a unit of `𝒪₂` (it is a unit of `𝒪_𝔭`, and the canonical map preserves units)
  have hunit₂ : IsUnit (ℓ : 𝔮₂.adicCompletionIntegers L₂) := by
    have hℓunit : IsUnit (ℓ : 𝔭.adicCompletionIntegers K) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit]
      have hne : ((ℓ : ℕ) : IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) ≠ 0 :=
        CharP.cast_ne_zero_of_ne_of_prime (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))
          hℓ (Ne.symm hℓp)
      simpa using hne
    have hmap := IsUnit.map (((Commons.RingTheory.Henselian.adicCompletionMap 𝔭 𝔮₂ hlies₂₀).comp
      (𝔭.adicCompletionIntegers K).subtype).codRestrict (𝔮₂.adicCompletionIntegers L₂)
      (fun x => Commons.RingTheory.Henselian.adicCompletionMap_mem_integers 𝔭 𝔮₂ hlies₂₀ x.2))
      hℓunit
    simpa using hmap
  -- (9)+(10) an `ℓ`-th root of the unit in `κ₂`
  obtain ⟨w₂, hw₂⟩ :=
    NK.TameStructureDeep.Tame.exists_pow_eq_unit_adicCompletion_tower 𝔭 𝔮₁ 𝔮₂ hlies₁ hlies₂ he₂
      hℓ hℓp hdpos' hunit₂ hcard₁ hcard₂ u₁
  -- (11) the image of `κ₂` in `K'` lies in the unramified closure
  have hfr₁' : Module.finrank (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) = d := by
    rw [← Commons.NumberTheory.NumberField.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
      (K := K) (L := L₁) 𝔭 𝔮₁ hlies₁, he₁, one_mul, hf₁]
  have hfr₂' : Module.finrank (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) = ℓ * (ℓ - 1) := by
    rw [← Commons.NumberTheory.NumberField.finrank_adicCompletion_eq_ramificationIdx_mul_inertiaDeg
      (K := L₁) (L := L₂) 𝔮₁ 𝔮₂ hlies₂, he₂, one_mul, hf₂]
  have hfrU : Module.finrank (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) = d * ℓ * (ℓ - 1) := by
    rw [← Module.finrank_mul_finrank (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
      (𝔮₂.adicCompletion L₂), hfr₁', hfr₂']
    ring
  have hNne : (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) - 1 ≠ 0 := by
    have h1 : 2 ≤ (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) :=
      le_trans hq2 (Nat.le_self_pow hDne _)
    omega
  have hpq : resCharAt 𝔭 ∣ NK.LocalStructure.residueCard K 𝔭 := by
    obtain ⟨f, hf, hqf⟩ :=
      NK.LocalStructure.Tame.residueCard_eq_pow_of_charP 𝔭 hp
        (NK.Mine.charP_ringChar_residueField_adicCompletion 𝔭)
    rw [hqf]
    exact dvd_pow_self _ (by omega)
  have hNp : ¬ resCharAt 𝔭 ∣ (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) - 1 := by
    intro hdiv
    have hqpow : resCharAt 𝔭 ∣ (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) :=
      dvd_trans hpq (dvd_pow_self _ hDne)
    have hsub := Nat.dvd_sub hqpow hdiv
    rw [show (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1))
        - ((NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) - 1) = 1 by
      have h2 : 2 ≤ (NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) :=
        le_trans hq2 (Nat.le_self_pow hDne _)
      omega] at hsub
    exact hp.not_dvd_one hsub
  have hψ : IsPrimitiveRoot (ι (η₂ : 𝔮₂.adicCompletion L₂))
      ((NK.LocalStructure.residueCard K 𝔭) ^ (d * ℓ * (ℓ - 1)) - 1) :=
    hη₂'.map_of_injective ι.injective
  set F : IntermediateField (𝔭.adicCompletion K) K' :=
    IntermediateField.adjoin (𝔭.adicCompletion K) ({(ι (η₂ : 𝔮₂.adicCompletion L₂))} : Set K') with hFdef
  have hfrF : Module.finrank (𝔭.adicCompletion K) ↥F = d * ℓ * (ℓ - 1) := by
    rw [hFdef, NK.TameStructureDeep.Degree.finrank_adjoin_eq_orderOf 𝔭 hNne hNp hψ]
    exact NK.TameStructureDeep.Degree.orderOf_residueCard_pow_sub_one 𝔭 (d * ℓ * (ℓ - 1)) hDne
  have hfrRange : Module.finrank (𝔭.adicCompletion K) ↥(ι.fieldRange) = d * ℓ * (ℓ - 1) := by
    rw [← (AlgHom.equivFieldRange ι).toLinearEquiv.finrank_eq, hfrU]
  haveI hFinRange : FiniteDimensional (𝔭.adicCompletion K) ↥(ι.fieldRange) :=
    FiniteDimensional.of_finrank_pos (by rw [hfrRange]; exact hDpos)
  have hFr : F = ι.fieldRange := by
    refine IntermediateField.eq_of_le_of_finrank_eq ?_ ?_
    · rw [hFdef, IntermediateField.adjoin_le_iff]
      intro x hx
      rw [Set.mem_singleton_iff] at hx
      subst hx
      exact (AlgHom.mem_fieldRange).mpr ⟨_, rfl⟩
    · rw [hfrF, hfrRange]
  have hlevel : F ≤ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
      (resCharAt 𝔭) := by
    rw [hFdef, IntermediateField.adjoin_le_iff]
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst hx
    exact NK.TameStructureDeep.mem_unramifiedClosure_of_isPrimitiveRoot hNp hψ
  have himage : ∀ x : 𝔮₂.adicCompletion L₂,
      ι x ∈ NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
        (resCharAt 𝔭) := by
    intro x
    refine hlevel ?_
    rw [hFr]
    exact (AlgHom.mem_fieldRange).mpr ⟨x, rfl⟩
  -- (12) assembly
  have hπne : (π : 𝔭.adicCompletion K) ≠ 0 := by
    obtain ⟨ρ, hρval, hρspan⟩ :=
      Commons.NumberTheory.NumberField.Completion.exists_uniformizer_adicCompletionIntegers 𝔭
    have hρ0 : ρ ≠ 0 := fun h => by
      have hzero : Valued.v ((ρ : 𝔭.adicCompletionIntegers K) : 𝔭.adicCompletion K) = 0 := by
        rw [h]; simp
      rw [hρval] at hzero
      exact WithZero.exp_ne_zero hzero
    intro h0
    have hπ0 : π = 0 := Subtype.coe_injective h0
    have h𝔪 : IsLocalRing.maximalIdeal (𝔭.adicCompletionIntegers K) = Ideal.span {π} := hπ
    have hmem : ρ ∈ IsLocalRing.maximalIdeal (𝔭.adicCompletionIntegers K) := by
      rw [hρspan]; exact Ideal.mem_span_singleton_self ρ
    have hmem2 : ρ ∈ Ideal.span ({π} : Set (𝔭.adicCompletionIntegers K)) := by
      rw [← h𝔪]; exact hmem
    rw [hπ0, Set.singleton_zero, Ideal.span_zero, Ideal.mem_bot] at hmem2
    exact hρ0 hmem2
  have hπimg : ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
      (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) (π : 𝔭.adicCompletion K)))
      = algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) := by
    rw [show algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
          (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) (π : 𝔭.adicCompletion K))
        = algebraMap (𝔭.adicCompletion K) (𝔮₂.adicCompletion L₂) (π : 𝔭.adicCompletion K)
        from RingHom.congr_fun hcompat _]
    exact AlgHom.commutes ι (π : 𝔭.adicCompletion K)
  have hx₁' : x₁ = (u₁ : 𝔮₁.adicCompletion L₁) *
      (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁) (π : 𝔭.adicCompletion K)) ^ j := hu₁
  have hc : (ι (w₂ : 𝔮₂.adicCompletion L₂)) ^ ℓ =
      ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) (u₁ : 𝔮₁.adicCompletion L₁)) := by
    rw [← map_pow, hw₂]
    rfl
  have hb_decomp : b = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
        (u₁ : 𝔮₁.adicCompletion L₁))
      * (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) ^ j := by
    calc b = ι y := hy_eq.symm
      _ = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) x₁) := by rw [hx₁_eq]
      _ = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
            ((u₁ : 𝔮₁.adicCompletion L₁) *
              (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
                (π : 𝔭.adicCompletion K)) ^ j)) := by rw [hx₁']
      _ = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) (u₁ : 𝔮₁.adicCompletion L₁)
            * (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
              (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
                (π : 𝔭.adicCompletion K))) ^ j) := by rw [map_mul, map_zpow₀]
      _ = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) (u₁ : 𝔮₁.adicCompletion L₁))
            * (ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂)
              (algebraMap (𝔭.adicCompletion K) (𝔮₁.adicCompletion L₁)
                (π : 𝔭.adicCompletion K)))) ^ j := by rw [map_mul, map_zpow₀]
      _ = ι (algebraMap (𝔮₁.adicCompletion L₁) (𝔮₂.adicCompletion L₂) (u₁ : 𝔮₁.adicCompletion L₁))
            * (algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K)) ^ j := by rw [hπimg]
  refine ⟨j, ι (w₂ : 𝔮₂.adicCompletion L₂), himage _, ?_⟩
  rw [hb_decomp, hc, mul_div_cancel_right₀ _ (zpow_ne_zero j ((map_ne_zero (algebraMap (𝔭.adicCompletion K) K')).mpr hπne))]

end NK.TameStructureDeep.Tame
