/-! ## Elementary auxiliary lemmas -/

/-- If two primitive `n`-th roots of unity generate the same (level) field: for two primitive
`n`-th roots of unity in a field, the fields they generate over any subfield coincide. -/
theorem adjoin_eq_adjoin_of_isPrimitiveRoot {F E : Type*} [Field F] [Field E] [Algebra F E]
    {n : ℕ} [NeZero n] {ζ ζ' : E} (hζ : IsPrimitiveRoot ζ n) (hζ' : IsPrimitiveRoot ζ' n) :
    F⟮ζ⟯ = F⟮ζ'⟯ := by
  obtain ⟨k, -, hk⟩ := hζ.eq_pow_of_pow_eq_one (ξ := ζ') hζ'.pow_eq_one
  have h1 : ζ' ∈ F⟮ζ⟯ := by
    rw [← hk]; exact pow_mem (mem_adjoin_simple_self F ζ) k
  obtain ⟨l, -, hl⟩ := hζ'.eq_pow_of_pow_eq_one (ξ := ζ) hζ.pow_eq_one
  have h2 : ζ ∈ F⟮ζ'⟯ := by
    rw [← hl]; exact pow_mem (mem_adjoin_simple_self F ζ') l
  exact le_antisymm (adjoin_simple_le_iff.mpr h2) (adjoin_simple_le_iff.mpr h1)

/-- A power of a primitive root generates a subfield of the field generated by the root. -/
theorem adjoin_pow_le_adjoin {F E : Type*} [Field F] [Field E] [Algebra F E]
    (x : E) (k : ℕ) : F⟮x ^ k⟯ ≤ F⟮x⟯ := by
  rw [adjoin_simple_le_iff]
  exact pow_mem (mem_adjoin_simple_self F x) k

end NK.TameStructureDeep.Tame

