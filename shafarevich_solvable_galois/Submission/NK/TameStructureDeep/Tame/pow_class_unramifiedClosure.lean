/-- The residue cardinality `q = #(O_κ/𝔪)` is a power of the residue characteristic. -/
theorem exists_residueCard_eq_pow {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ f : ℕ, NK.LocalStructure.residueCard K 𝔭 = (resCharAt 𝔭) ^ f := by
  obtain ⟨f, -, hqf⟩ := NK.LocalStructure.Tame.residueCard_eq_pow_of_charP 𝔭
    (NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭)
    (NK.Mine.charP_ringChar_residueField_adicCompletion 𝔭)
  exact ⟨f, hqf⟩

/-- `q` is coprime to any `M` prime to the residue characteristic. -/
theorem coprime_residueCard_of_not_dvd {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {M : ℕ}
    (hM : ¬ resCharAt 𝔭 ∣ M) : Nat.Coprime (NK.LocalStructure.residueCard K 𝔭) M := by
  obtain ⟨f, hf⟩ := exists_residueCard_eq_pow 𝔭
  rw [hf]
  exact Nat.Coprime.pow_left f
    ((Nat.Prime.coprime_iff_not_dvd (NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭)).mpr hM)

/-- `ℓ` is coprime to the residue cardinality `q`. -/
theorem coprime_ell_residueCard {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {ℓ : ℕ}
    (hℓ : ℓ.Prime) (hℓp : ℓ ≠ resCharAt 𝔭) :
    Nat.Coprime ℓ (NK.LocalStructure.residueCard K 𝔭) := by
  obtain ⟨f, hf⟩ := exists_residueCard_eq_pow 𝔭
  rw [hf]
  exact Nat.Coprime.pow_right f
    ((Nat.Prime.coprime_iff_not_dvd hℓ).mpr
      (fun h => hℓp ((NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭).dvd_iff_eq hℓ.ne_one |>.mp h).symm))

end NK.TameStructureDeep.Tame

