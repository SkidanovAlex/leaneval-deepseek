/-!
# Auxiliary results for the pro-cyclicity of the tame inertia

Two auxiliary results for the proof that the tamely ramified quotient
`I_κ/V_κ = Gal(κ^{tr}/κ^{ur})` is pro-cyclic:

* an abstract criterion: a group `G` all of whose quotients by the subgroup generated by the
  `m`-th powers are cyclic is pro-cyclic (`NK.LocalTame.IsProCyclic` quantifies over *all*
  finite-index normal subgroups, not only the open ones);
* the inertia subgroup `I_κ = Gal(K'/κ^{ur})` is abelian modulo the corrected wild inertia
  `V_κ = Gal(K'/κ^{tr})`: for `σ, τ ∈ I_κ` the commutator `[σ, τ]` fixes `κ^{tr}`.
-/

open scoped Classical
open IntermediateField

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace NK.TameStructureDeep.Tame

noncomputable section

/-! ## 1. The abstract endgame

`NK.LocalTame.IsProCyclic G` quantifies over *all* finite index normal subgroups, not only the
open ones, so the endgame has to be formulated in terms of the subgroup generated by the `m`-th
powers: if `N ⧸ G` has order `m`, every `m`-th power lies in `N`. -/

/-- The subgroup of `G` generated by the `m`-th powers. -/
def powSpan {G : Type*} [Group G] (m : ℕ) : Subgroup G :=
  Subgroup.closure (Set.range fun x : G => x ^ m)

/-- **Pro-cyclicity from cyclicity modulo the `m`-th powers.**

If for every `m > 0` the quotient of `G` by the *normal closure* of the subgroup generated by the
`m`-th powers is cyclic, then `G` is pro-cyclic: for a normal subgroup `N` of finite index `m`,
every `m`-th power lies in `N`, so `G ⧸ N` is a quotient of `G ⧸ m`-th powers. -/
theorem isProCyclic_of_forall_isCyclic_quotient_powSpan {G : Type*} [Group G]
    (h : ∀ m : ℕ, 0 < m →
      IsCyclic (G ⧸ Subgroup.normalClosure (Set.range fun x : G => x ^ m))) :
    NK.LocalTame.IsProCyclic G := by
  intro N hN hfi
  haveI : N.Normal := hN
  set m := N.index with hm
  have hmpos : 0 < m := Nat.pos_of_ne_zero hfi.index_ne_zero
  have hCN : Subgroup.normalClosure (Set.range fun x : G => x ^ m) ≤ N := by
    refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨y, rfl⟩
    have hcard : Nat.card (G ⧸ N) = m := (Subgroup.index_eq_card N).symm
    have hord : orderOf (QuotientGroup.mk' N y) ∣ m := by
      rw [← hcard]
      exact orderOf_dvd_natCard _
    have hpow : (QuotientGroup.mk' N y) ^ m = 1 := orderOf_dvd_iff_pow_eq_one.mp hord
    rw [← map_pow] at hpow
    exact (QuotientGroup.eq_one_iff (y ^ m)).mp hpow
  haveI hcyc : IsCyclic (G ⧸ Subgroup.normalClosure (Set.range fun x : G => x ^ m)) :=
    h m hmpos
  have hCN' : Subgroup.normalClosure (Set.range fun x : G => x ^ m) ≤
      Subgroup.comap (MonoidHom.id G) N := hCN
  have hsurj : Function.Surjective
      (QuotientGroup.map (Subgroup.normalClosure (Set.range fun x : G => x ^ m)) N
        (MonoidHom.id G) hCN') := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N q
    exact ⟨QuotientGroup.mk' _ x, by rw [QuotientGroup.map_mk']; rfl⟩
  exact isCyclic_of_surjective _ hsurj

/-! ## 2. The inertia subgroup modulo the corrected wild inertia is abelian

For `σ, τ` in `I_κ = Gal(K'/κ^{ur})` the commutator `[σ, τ]` fixes `κ^{tr}`: it fixes `κ^{ur}` by
the normality of the inertia subgroup, and it fixes every `n`-th root `β` of the uniformiser `π`
(`p ∤ n`) because the Kummer characters `σ β / β`, `τ β / β` lie in `μ_n ⊆ κ^{ur}` and are
therefore fixed by `σ` and `τ`.  Hence `I_κ/V_κ` is abelian. -/

section Abelian

variable {κ K' : Type*} [Field κ] [Field K'] [Algebra κ K']

/-- **The Kummer character of an inertia element on a prime-to-`p` root of `π` lies in `κ^{ur}`.**

If `σ` fixes `κ^{ur}` pointwise, `β ≠ 0` and `β ^ n = π` with `p ∤ n`, then `(σ β / β) ^ n = 1`, so
`σ β / β` is an `n`-th root of unity, hence lies in `κ^{ur}` (as `p ∤ n`, all prime-to-`p` roots of
unity do). -/
lemma kummerChar_mem_unramifiedClosure {p n : ℕ} (hn : ¬ p ∣ n) {π : κ} {σ : Gal(K'/κ)}
    (hσ : σ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    {β : K'} (hβ : β ^ n = algebraMap κ K' π) (hβne : β ≠ 0) :
    σ β / β ∈ NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p := by
  have hfix : σ (algebraMap κ K' π) = algebraMap κ K' π :=
    (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ _ (IntermediateField.algebraMap_mem _ π)
  have hπne : algebraMap κ K' π ≠ 0 := by rw [← hβ]; exact pow_ne_zero n hβne
  refine NK.TameStructureDeep.Tame.mem_unramifiedClosure_of_pow_eq_one (κ := κ) (K' := K') hn ?_
  show (σ β / β) ^ n = 1
  rw [div_pow, ← map_pow, hβ, hfix]
  exact div_self hπne

/-- **`σ⁻¹ β` for an inertia element.**  With `c = σ β / β ∈ κ^{ur}` fixed by `σ`, the inverse of
`σ` acts on the Kummer line `κ^{ur} β` by `c⁻¹`. -/
lemma inv_apply_root {p n : ℕ} (hn : ¬ p ∣ n) {π : κ} {σ : Gal(K'/κ)}
    (hσ : σ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    {β : K'} (hβ : β ^ n = algebraMap κ K' π) (hβne : β ≠ 0) :
    σ⁻¹ β = (σ β / β)⁻¹ * β := by
  have hchar := kummerChar_mem_unramifiedClosure (K' := K') hn hσ hβ hβne
  have hfx : σ (σ β / β) = σ β / β :=
    (IntermediateField.mem_fixingSubgroup_iff _ σ).mp hσ _ hchar
  have h1 : σ ((σ β / β)⁻¹ * β) = β := by
    rw [map_mul, map_inv₀, hfx, inv_div]
    exact div_mul_cancel₀ β ((map_ne_zero σ).mpr hβne)
  exact (AlgEquiv.symm_apply_eq σ).mpr h1.symm

/-- **The Kummer character is multiplicative**: `(ρ ρ') β / β = (ρ β / β) (ρ' β / β)` for
`ρ, ρ'` in the inertia subgroup. -/
lemma div_mul_apply_root {p n : ℕ} (hn : ¬ p ∣ n) {π : κ} {ρ ρ' : Gal(K'/κ)}
    (hρ : ρ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    (hρ' : ρ' ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    {β : K'} (hβ : β ^ n = algebraMap κ K' π) (hβne : β ≠ 0) :
    ((ρ * ρ') β) / β = (ρ β / β) * ((ρ' β) / β) := by
  have hchar := kummerChar_mem_unramifiedClosure (K' := K') hn hρ' hβ hβne
  have hfix : ρ (ρ' β / β) = ρ' β / β :=
    (IntermediateField.mem_fixingSubgroup_iff _ ρ).mp hρ _ hchar
  rw [AlgEquiv.mul_apply,
    show ρ' β = (ρ' β / β) * β from (div_mul_cancel₀ (ρ' β) hβne).symm,
    map_mul, hfix]
  field_simp

/-- **The commutator of two inertia elements fixes every prime-to-`p` root of `π`.** -/
lemma commutator_apply_root {p n : ℕ} (hn : ¬ p ∣ n) {π : κ} {σ τ : Gal(K'/κ)}
    (hσ : σ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    (hτ : τ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    {β : K'} (hβ : β ^ n = algebraMap κ K' π) (hβne : β ≠ 0) :
    (σ * τ * σ⁻¹ * τ⁻¹) β = β := by
  have hinvm : ∀ (ρ : Gal(K'/κ)),
      ρ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup →
      ρ⁻¹ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup :=
    fun ρ hρ => Subgroup.inv_mem _ hρ
  have h1 : ((σ⁻¹ * τ⁻¹) β) / β = (σ β / β)⁻¹ * (τ β / β)⁻¹ := by
    rw [div_mul_apply_root (K' := K') hn (hinvm σ hσ) (hinvm τ hτ) hβ hβne,
      inv_apply_root (K' := K') hn hσ hβ hβne, inv_apply_root (K' := K') hn hτ hβ hβne]
    rw [mul_div_cancel_right₀ ((σ β / β)⁻¹) hβne, mul_div_cancel_right₀ ((τ β / β)⁻¹) hβne]
  have h2 : ((τ * (σ⁻¹ * τ⁻¹)) β) / β = (τ β / β) * ((σ β / β)⁻¹ * (τ β / β)⁻¹) := by
    rw [div_mul_apply_root (K' := K') hn hτ (mul_mem (hinvm σ hσ) (hinvm τ hτ)) hβ hβne, h1]
  have h3 : ((σ * (τ * (σ⁻¹ * τ⁻¹))) β) / β =
      (σ β / β) * ((τ β / β) * ((σ β / β)⁻¹ * (τ β / β)⁻¹)) := by
    rw [div_mul_apply_root (K' := K') hn hσ
      (mul_mem hτ (mul_mem (hinvm σ hσ) (hinvm τ hτ))) hβ hβne, h2]
  have hX : ((σ * (τ * (σ⁻¹ * τ⁻¹))) β) / β = 1 := by
    rw [h3]
    field_simp
    exact div_self (mul_ne_zero ((map_ne_zero σ).mpr hβne) ((map_ne_zero τ).mpr hβne))
  rw [show σ * τ * σ⁻¹ * τ⁻¹ = σ * (τ * (σ⁻¹ * τ⁻¹)) from rfl]
  exact (div_eq_one_iff_eq hβne).mp hX

/-- **The commutator of two inertia elements lies in the corrected wild inertia.**  Equivalently,
`I_κ/V_κ = Gal(κ^{tr}/κ^{ur})` is abelian. -/
theorem commutator_mem_correctedWildInertia {p : ℕ} (hp : p ≠ 1) {π : κ} (σ τ : Gal(K'/κ))
    (hσ : σ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup)
    (hτ : τ ∈ (NK.LocalAnabelian.unramifiedClosure (κ := κ) (K' := K') p).fixingSubgroup) :
    σ * τ * σ⁻¹ * τ⁻¹ ∈ NK.TameStructureDeep.Tame.correctedWildInertia (K' := K') p π := by
  refine mem_correctedWildInertia_of_forall hp _ ?_ ?_
  · intro y hy
    exact (IntermediateField.mem_fixingSubgroup_iff _ _).mp
      (mul_mem (mul_mem hσ hτ) (mul_mem (Subgroup.inv_mem _ hσ) (Subgroup.inv_mem _ hτ))) y hy
  · intro n hn β hβ
    by_cases hβ0 : β = 0
    · rw [hβ0]; simp
    · exact commutator_apply_root hn hσ hτ hβ hβ0

end Abelian





end

end NK.TameStructureDeep.Tame
