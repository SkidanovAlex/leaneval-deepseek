/-!
# The fixed field of the `m`-th powers of the tame inertia

For a uniformiser `π` of `κ = K_𝔭` and a `d₀`-th root `γ` of `π` with `d₀ = primeToPart 𝔭 m` the
largest divisor of `m` prime to the residue characteristic, every element of `κ^{tr}` which is
fixed by the `m`-th power of every element of the inertia subgroup `I_κ = Gal(K'/κ^{ur})` already
lies in the layer `κ^{ur} ⊔ κ⟮γ⟯` (`mem_adjoin_root_of_fixed`).  This is the arithmetic half of
the computation of the fixed field of the `m`-th powers of `I_κ`, which in turn computes the
finite quotients of `I_κ/V_κ = Gal(κ^{tr}/κ^{ur})` and hence its pro-cyclicity.
-/
open scoped Classical
open IntermediateField

noncomputable section

namespace NK.TameStructureDeep.Tame

variable {K : Type*} [Field K] [NumberField K]
variable (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
variable {K' : Type*} [Field K'] [Algebra (𝔭.adicCompletion K) K']
  [IsSepClosure (𝔭.adicCompletion K) K']

local notation "κur" =>
  NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K') (resCharAt 𝔭)

/-- **A `g`-th root of the uniformiser lies in the layer generated by a `d`-th root.**  If
`β ^ n = π = γ ^ d` and `g ∣ gcd n d`, then `β ^ (n / g)` differs from `γ ^ (d / g)` by a `g`-th
root of unity, which lies in `κ^{ur}` as `p ∤ g`. -/
lemma adjoin_pow_div_le_adjoin {π : 𝔭.adicCompletionIntegers K}
    (hπne : algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) ≠ 0) {β γ : K'}
    {n g d : ℕ} (hd : d ≠ 0)
    (hβ : β ^ n = algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K))
    (hγ : γ ^ d = algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K))
    (hgn : g ∣ n) (hgd : g ∣ d) (hgp : ¬ (resCharAt 𝔭) ∣ g) :
    κur ⊔ IntermediateField.adjoin (𝔭.adicCompletion K) ({β ^ (n / g)} : Set K') ≤
      κur ⊔ IntermediateField.adjoin (𝔭.adicCompletion K) ({γ} : Set K') := by
  have hng : g * (n / g) = n := Nat.mul_div_cancel' hgn
  have hdg : g * (d / g) = d := Nat.mul_div_cancel' hgd
  have hγ0 : γ ≠ 0 := fun h => hπne (by rw [← hγ, h, zero_pow hd])
  have hγg0 : γ ^ (d / g) ≠ 0 := pow_ne_zero _ hγ0
  have hratio : β ^ (n / g) / γ ^ (d / g) ∈ κur := by
    refine NK.TameStructureDeep.Tame.mem_unramifiedClosure_of_pow_eq_one
      (κ := 𝔭.adicCompletion K) (K' := K') hgp ?_
    have h1 : (β ^ (n / g)) ^ g = algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) := by
      rw [← pow_mul, Nat.mul_comm (n / g) g, hng, hβ]
    have h2 : (γ ^ (d / g)) ^ g = algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) := by
      rw [← pow_mul, Nat.mul_comm (d / g) g, hdg, hγ]
    rw [div_pow, h1, h2, div_self hπne]
  have hβeq : β ^ (n / g) = (β ^ (n / g) / γ ^ (d / g)) * γ ^ (d / g) :=
    (div_mul_cancel₀ _ hγg0).symm
  refine sup_le le_sup_left ?_
  rw [IntermediateField.adjoin_le_iff]
  rintro y hy
  rw [Set.mem_singleton_iff] at hy
  subst hy
  rw [hβeq]
  have hγsub : γ ∈ κur ⊔ IntermediateField.adjoin (𝔭.adicCompletion K) ({γ} : Set K') :=
    SetLike.le_def.mp
      (le_sup_right : IntermediateField.adjoin (𝔭.adicCompletion K) ({γ} : Set K') ≤ κur ⊔ _)
      (IntermediateField.subset_adjoin _ _ (Set.mem_singleton γ))
  exact mul_mem (SetLike.le_def.mp (le_sup_left : κur ≤ κur ⊔ _) hratio) (pow_mem hγsub (d / g))

/-- **The hard direction of the layer computation, assembled.**  Any `x ∈ κ^{tr}` fixed by the
`m`-th power of every element of the inertia subgroup already lies in the layer
`κ^{ur} ⊔ κ⟮γ⟯` generated by a `d₀`-th root `γ` of the uniformiser. -/
theorem mem_adjoin_root_of_fixed {m : ℕ} (hm : 0 < m) {π : 𝔭.adicCompletionIntegers K}
    (hπ : IsUniformizerAt 𝔭 π) {γ : K'} (hγ : γ ^ primeToPart 𝔭 m =
      algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K))
    {x : K'} (hx : x ∈ NK.TameStructureDeep.Tame.tameClosure (κ := 𝔭.adicCompletion K)
        (K' := K') (resCharAt 𝔭) (π : 𝔭.adicCompletion K))
    (hfix : ∀ σ : Gal(K'/(𝔭.adicCompletion K)), σ ∈ (κur).fixingSubgroup → (σ ^ m) x = x) :
    x ∈ κur ⊔ IntermediateField.adjoin (𝔭.adicCompletion K) ({γ} : Set K') := by
  have hp : (resCharAt 𝔭).Prime := NK.Mine.prime_ringChar_residueField_adicCompletion 𝔭
  obtain ⟨n, β, hnp, hβ, hxβ⟩ :=
    exists_kummerLayer_of_mem_tameClosure (κ := 𝔭.adicCompletion K) (K' := K') (resCharAt 𝔭) hp
      (π := (π : 𝔭.adicCompletion K)) hx
  have hn0 : n ≠ 0 := fun h => hnp (h ▸ dvd_zero (resCharAt 𝔭))
  have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
  have hcop : Nat.Coprime n (resCharAt 𝔭) :=
    Nat.coprime_comm.mpr ((Nat.Prime.coprime_iff_not_dvd hp).mpr hnp)
  have hx' : x ∈ κur ⊔ IntermediateField.adjoin (𝔭.adicCompletion K)
      ({β ^ (n / Nat.gcd n m)} : Set K') :=
    mem_adjoin_pow_div_gcd_of_fixed 𝔭 hπ hnpos hcop hβ hxβ hfix
  have hπne : algebraMap (𝔭.adicCompletion K) K' (π : 𝔭.adicCompletion K) ≠ 0 := by
    have hirr : Irreducible π := (IsDiscreteValuationRing.irreducible_iff_uniformizer π).mpr hπ
    exact fun h => hirr.ne_zero (Subtype.coe_injective (by simpa using h))
  have hspec := primeToPart_spec' 𝔭 hm.ne'
  have hd0 : primeToPart 𝔭 m ≠ 0 := (Nat.pos_of_dvd_of_pos hspec.1 hm).ne'
  have hgp : ¬ (resCharAt 𝔭) ∣ Nat.gcd n m := fun h => hnp (h.trans (Nat.gcd_dvd_left n m))
  have hdvd : Nat.gcd n m ∣ primeToPart 𝔭 m := hspec.2.2 (Nat.gcd n m) (Nat.gcd_dvd_right n m) hgp
  exact SetLike.le_def.mp (adjoin_pow_div_le_adjoin 𝔭 hπne hd0 hβ hγ (Nat.gcd_dvd_left n m) hdvd hgp)
    hx'

end NK.TameStructureDeep.Tame
