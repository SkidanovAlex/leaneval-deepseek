/-!
# Pro-cyclicity of `I/V` from cyclicity modulo the `m`-th powers

`NK.LocalTame.IsProCyclic G` (`Submission/Work/LocalTame/Basic.lean`) quantifies over *all*
finite-index normal subgroups of `G`, while the arithmetic input available for the tame inertia
is stated only for the subgroups generated by the `m`-th powers.  This file bridges the two:
if for every `m > 0` the quotient of `I` by `V.subgroupOf I ⊔ (m-th powers of I)` (normalised)
is cyclic, then `I/V` is pro-cyclic.

Indeed, if `N ≤ I/V` is normal of index `m`, every `m`-th power of an element of `I` lies in the
preimage `K` of `N` in `I`, so `K` contains `V.subgroupOf I ⊔ m-th powers`; hence
`(I/V) ⧸ N ≅ I ⧸ K` is a quotient of `I ⧸ (V.subgroupOf I ⊔ m-th powers)`, which is cyclic by
hypothesis.
-/

set_option linter.style.haveILetI false

namespace NK.TameStructureDeep.Tame

theorem isProCyclic_quotient_of_forall_isCyclic_powSpan {G : Type*} [Group G]
    (V I : Subgroup G) [V.Normal]
    (h : ∀ m : ℕ, 0 < m → IsCyclic (↥I ⧸ (V.subgroupOf I ⊔
      Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m)))) :
    NK.LocalTame.IsProCyclic (↥I ⧸ V.subgroupOf I) := by
  intro N hN hfi
  haveI : N.Normal := hN
  set m : ℕ := N.index with hm
  have hmpos : 0 < m := Nat.pos_of_ne_zero hfi.index_ne_zero
  -- the preimage `K` of `N` in `I`
  set K : Subgroup ↥I := N.comap (QuotientGroup.mk' (V.subgroupOf I)) with hKdef
  have hKnorm : K.Normal := by rw [hKdef]; exact Subgroup.Normal.comap hN _
  haveI : K.Normal := hKnorm
  -- `V.subgroupOf I ≤ K`
  have hVK : V.subgroupOf I ≤ K := by
    rw [hKdef]
    intro x hx
    rw [Subgroup.mem_comap]
    have h1 : QuotientGroup.mk' (V.subgroupOf I) x = 1 := (QuotientGroup.eq_one_iff x).mpr hx
    rw [h1]
    exact N.one_mem
  -- the `m`-th powers of `I` lie in `K`: `N` has index `m` in `I/V`
  have hCK : Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m) ≤ K := by
    rw [hKdef]
    refine Subgroup.normalClosure_le_normal ?_
    rintro _ ⟨y, rfl⟩
    change (QuotientGroup.mk' (V.subgroupOf I)) (y ^ m) ∈ N
    have hcard : Nat.card ((↥I ⧸ V.subgroupOf I) ⧸ N) = m := (Subgroup.index_eq_card N).symm
    have hord : orderOf (QuotientGroup.mk' N (QuotientGroup.mk' (V.subgroupOf I) y)) ∣ m := by
      rw [← hcard]
      exact orderOf_dvd_natCard _
    have hpow : (QuotientGroup.mk' N (QuotientGroup.mk' (V.subgroupOf I) y)) ^ m = 1 :=
      orderOf_dvd_iff_pow_eq_one.mp hord
    rw [← map_pow] at hpow
    have hmem : (QuotientGroup.mk' (V.subgroupOf I) y) ^ m ∈ N :=
      (QuotientGroup.eq_one_iff _).mp hpow
    simpa [map_pow] using hmem
  have hle : V.subgroupOf I ⊔ Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m) ≤ K :=
    sup_le hVK hCK
  have hcyc : IsCyclic (↥I ⧸ (V.subgroupOf I ⊔
      Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m))) := h m hmpos
  haveI := hcyc
  -- the hypothesis gives a surjection onto `I ⧸ K`
  have hle' : (V.subgroupOf I ⊔ Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m)) ≤
      K.comap (MonoidHom.id ↥I) := hle
  have hsurj : Function.Surjective (QuotientGroup.map
      (V.subgroupOf I ⊔ Subgroup.normalClosure (Set.range fun x : ↥I => x ^ m)) K
      (MonoidHom.id ↥I) hle') := by
    intro q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective K q
    refine ⟨QuotientGroup.mk' _ x, ?_⟩
    rw [QuotientGroup.map_mk']
    rfl
  have hKcyc : IsCyclic (↥I ⧸ K) := isCyclic_of_surjective _ hsurj
  -- `I ⧸ K ≅ (I/V) ⧸ N`
  let φ : ↥I →* (↥I ⧸ V.subgroupOf I) ⧸ N :=
    (QuotientGroup.mk' N).comp (QuotientGroup.mk' (V.subgroupOf I))
  have hφker : φ.ker = K := by
    rw [hKdef]
    ext x
    rw [MonoidHom.mem_ker, Subgroup.mem_comap]
    show (QuotientGroup.mk' N) ((QuotientGroup.mk' (V.subgroupOf I)) x) = 1 ↔ _
    exact QuotientGroup.eq_one_iff _
  have hsurjφ : Function.Surjective φ := by
    intro q
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N q
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (V.subgroupOf I) y
    exact ⟨x, rfl⟩
  have e : (↥I ⧸ K) ≃* ((↥I ⧸ V.subgroupOf I) ⧸ N) :=
    (QuotientGroup.quotientMulEquivOfEq hφker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective φ hsurjφ)
  exact e.isCyclic.mp hKcyc

end NK.TameStructureDeep.Tame
