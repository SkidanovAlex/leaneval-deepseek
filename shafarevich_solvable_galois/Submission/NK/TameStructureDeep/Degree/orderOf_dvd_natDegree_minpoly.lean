/-- If the residue characteristic of the `𝔭`-adic completion of `K` does not divide `n`, then
`(n : 𝓞 K)` is not in `𝔭`: the maximal ideal of the completion's ring of integers is generated by
the image of `𝔭`. -/
lemma natCast_notMem_asIdeal {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) {n : ℕ}
    (hn : ¬ ringChar (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) ∣ n) :
    ((n : ℕ) : 𝓞 K) ∉ 𝔭.asIdeal := by
  intro hmem
  have hres : IsLocalRing.residue (𝔭.adicCompletionIntegers K)
      ((n : ℕ) : 𝔭.adicCompletionIntegers K) = 0 := by
    refine (IsLocalRing.residue_eq_zero_iff (R := 𝔭.adicCompletionIntegers K) _).mpr ?_
    rw [Commons.NumberTheory.NumberField.adicCompletionIntegers_maximalIdeal_eq_map]
    have h1 : ((n : ℕ) : 𝔭.adicCompletionIntegers K)
        = algebraMap (𝓞 K) (𝔭.adicCompletionIntegers K) ((n : ℕ) : 𝓞 K) :=
      (map_natCast (algebraMap (𝓞 K) (𝔭.adicCompletionIntegers K)) n).symm
    rw [h1]
    exact Ideal.mem_map_of_mem _ hmem
  have hcast : ((n : ℕ) : IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) = 0 := by
    rw [← map_natCast (IsLocalRing.residue (𝔭.adicCompletionIntegers K)) n]
    exact hres
  exact hn ((CharP.cast_eq_zero_iff (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))
    (ringChar (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K))) n).mp hcast)

/-- **The order of `q` modulo `n` divides the degree of the `n`-th cyclotomic extension of a
`p`-adic field**, where `q` is the residue field cardinality and `p ∤ n`.

The proof is the standard one, in its global form.  Let `L = K(ζ_n)` be the cyclotomic number
field, `Q` a prime of `𝓞 L` above `𝔭`, and `L_Q` the `Q`-adic completion of `L`.  Let
`σ ∈ Gal(L/K)` be a Frobenius at `Q`: `σ` acts on the residue field `𝓞 L ⧸ Q` by the
`q`-th power map, where `q = #(𝓞 K ⧸ 𝔭)`.

* `σ` acts on `ζ_n` by a power `ζ_n ↦ ζ_n ^ a`; reducing modulo `Q` and using that the
  reduction of `ζ_n` is again a primitive `n`-th root of unity (here `p ∤ n` is used) gives
  `a ≡ q (mod n)`.
* The `κ`-algebra automorphism of `L_Q` induced by `σ` restricts to the cyclotomic subfield
  `F = κ(ζ_n) ⊆ L_Q`, whose degree over `κ = 𝔭.adicCompletion K` is the degree of the local
  cyclotomic extension, i.e. `(minpoly κ ζ).natDegree`.  Hence `(σ|_F) ^ d = 1` for
  `d = (minpoly κ ζ).natDegree`, and applying this to `ζ_n` gives `a ^ d ≡ 1 (mod n)`, so
  `q ^ d ≡ 1 (mod n)`, which is the claim. -/
theorem orderOf_dvd_natDegree_minpoly {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K']
    {n : ℕ} (hn0 : n ≠ 0)
    (hn : ¬ ringChar (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) ∣ n)
    {ζ : K'} (hζ : IsPrimitiveRoot ζ n) :
    orderOf ((NK.LocalStructure.residueCard K 𝔭 : ZMod n)) ∣
      (minpoly (𝔭.adicCompletion K) ζ).natDegree := by
  classical
  by_cases hn1 : n = 1
  · subst hn1
    have hζ1 : ζ = 1 := by simpa using hζ.pow_eq_one
    have hmin : (minpoly (𝔭.adicCompletion K) ζ).natDegree = 1 := by
      have h1 : ζ = algebraMap (𝔭.adicCompletion K) K' (1 : 𝔭.adicCompletion K) := by
        rw [map_one]; exact hζ1
      rw [h1, minpoly.eq_X_sub_C K' (1 : 𝔭.adicCompletion K), Polynomial.natDegree_X_sub_C]
    have hord : orderOf ((NK.LocalStructure.residueCard K 𝔭 : ZMod 1)) = 1 := by
      rw [Subsingleton.elim ((NK.LocalStructure.residueCard K 𝔭 : ZMod 1)) (1 : ZMod 1),
        orderOf_one]
    rw [hord, hmin]
  haveI : NeZero n := ⟨hn0⟩
  have hn2 : 1 < n := lt_of_le_of_ne (Nat.pos_of_ne_zero hn0) (Ne.symm hn1)
  have hnmem : ((n : ℕ) : 𝓞 K) ∉ 𝔭.asIdeal := natCast_notMem_asIdeal 𝔭 hn
  -- ### the global cyclotomic field and a prime above `𝔭`
  let L := CyclotomicField n K
  haveI hcycK : IsCyclotomicExtension ({n} : Set ℕ) K L := inferInstance
  haveI hgalK : IsGalois K L := IsCyclotomicExtension.isGalois {n} K L
  haveI hnfL : NumberField L := inferInstance
  obtain ⟨ζ₀, hζ₀⟩ := IsCyclotomicExtension.exists_isPrimitiveRoot K L (Set.mem_singleton n) hn0
  obtain ⟨Q, hQ⟩ :=
    Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver (K := K) (L := L) 𝔭
  haveI hQLO : Q.asIdeal.LiesOver 𝔭.asIdeal := hQ
  let L' := Q.adicCompletion L
  letI hAlgL' : Algebra (𝔭.adicCompletion K) L' :=
    Submission.NeukirchUchida.Local.adicCompletionAlgebra 𝔭 Q hQ
  haveI hmodfin : Module.Finite (𝔭.adicCompletion K) L' :=
    Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion 𝔭 Q hQ
  -- ### the two cyclotomic subfields
  let ζ' : L' := algebraMap L L' ζ₀
  have hζ' : IsPrimitiveRoot ζ' n := hζ₀.map_of_injective
    (Submission.NeukirchUchida.Local.injective_algebraMap_adicCompletion Q)
  let E₁ := IntermediateField.adjoin (𝔭.adicCompletion K) ({ζ} : Set K')
  let F := IntermediateField.adjoin (𝔭.adicCompletion K) ({ζ'} : Set L')
  haveI hintK' : Algebra.IsIntegral (𝔭.adicCompletion K) K' := inferInstance
  haveI hintL' : Algebra.IsIntegral (𝔭.adicCompletion K) L' :=
    ⟨fun x => IsIntegral.of_finite (𝔭.adicCompletion K) x⟩
  have hcycE₁ : IsCyclotomicExtension ({n} : Set ℕ) (𝔭.adicCompletion K) ↥E₁ :=
    IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension (𝔭.adicCompletion K) hζ
  have hcycF : IsCyclotomicExtension ({n} : Set ℕ) (𝔭.adicCompletion K) ↥F :=
    IsPrimitiveRoot.intermediateField_adjoin_isCyclotomicExtension (𝔭.adicCompletion K) hζ'
  haveI := hcycE₁
  haveI hgalF : IsGalois (𝔭.adicCompletion K) ↥F := IsCyclotomicExtension.isGalois {n} _ _
  -- ### the degree of the local cyclotomic extension
  have hdeg : (minpoly (𝔭.adicCompletion K) ζ).natDegree =
      Module.finrank (𝔭.adicCompletion K) ↥F := by
    haveI := hcycF
    have hintζ : IsIntegral (𝔭.adicCompletion K) ζ := Algebra.IsIntegral.isIntegral ζ
    have hfin₁ : Module.finrank (𝔭.adicCompletion K) ↥E₁ =
        (minpoly (𝔭.adicCompletion K) ζ).natDegree :=
      IntermediateField.adjoin.finrank (K := 𝔭.adicCompletion K) hintζ
    have hfin₂ : Module.finrank (𝔭.adicCompletion K) ↥E₁ =
        Module.finrank (𝔭.adicCompletion K) ↥F :=
      (IsCyclotomicExtension.algEquiv ({n} : Set ℕ) (𝔭.adicCompletion K) ↥E₁ ↥F).toLinearEquiv.finrank_eq
    rw [← hfin₁, hfin₂]
  -- ### the Frobenius at `Q`
  obtain ⟨σ, hσmap, hσres⟩ :=
    Commons.NumberTheory.NumberField.exists_frobenius_galRestrict (K := K) (L := L) 𝔭 Q hQ
  have hσmem : σ ∈ Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) Q := by
    rw [Submission.NeukirchUchida.Local.mem_decompositionSubgroup]
    apply IsDedekindDomain.HeightOneSpectrum.ext
    rw [Submission.NeukirchUchida.Local.placeSmul_asIdeal]
    exact hσmap
  let σ' : Submission.NeukirchUchida.Local.decompositionSubgroup (K := K) Q := ⟨σ, hσmem⟩
  let σL : L' ≃ₐ[𝔭.adicCompletion K] L' :=
    Submission.NeukirchUchida.Local.decompositionToLocalGalois 𝔭 Q hQ σ'
  have hσL_coe (x : L) : σL (x : L') = (σ x : L') := by
    have h1 : ⇑σL =
        ⇑(Submission.NeukirchUchida.Local.decompositionToLocalGaloisFun 𝔭 Q hQ σ') := rfl
    rw [h1, Submission.NeukirchUchida.Local.decompositionToLocalGaloisFun_apply]
    exact Submission.NeukirchUchida.Local.decompositionToAdicCompletion_coe Q σ' x
  -- ### `σ` acts on `ζ₀` by a power
  have hσζ₀n : (σ ζ₀) ^ n = 1 := by rw [← map_pow, hζ₀.pow_eq_one, map_one]
  obtain ⟨a, ha_lt, ha⟩ := hζ₀.eq_pow_of_pow_eq_one hσζ₀n
  have hσζ₀ : σ ζ₀ = ζ₀ ^ a := ha.symm
  have ha_ne : a ≠ 0 := by
    rintro rfl
    have hζ0eq : ζ₀ = 1 := by
      have h2 : (1 : L) = σ ζ₀ := by simpa using ha
      have h3 : σ ζ₀ = σ 1 := by rw [map_one]; exact h2.symm
      exact σ.injective h3
    have hdiv : n ∣ 1 := hζ₀.dvd_of_pow_eq_one 1 (by rw [hζ0eq]; simp)
    have h1 : n = 1 := Nat.dvd_one.mp hdiv
    omega
  have hσL_ζ' : σL ζ' = ζ' ^ a := by
    have h2 : σL ζ' = (σ ζ₀ : L') := hσL_coe ζ₀
    rw [h2, hσζ₀]
    exact map_pow (algebraMap L L' : L →+* L') ζ₀ a
  -- ### the exponent congruence `a ≡ q (mod n)`
  obtain ⟨ζ₀', hζ₀'coe⟩ := (IsIntegralClosure.isIntegral_iff (A := 𝓞 L) (R := ℤ) (B := L)).mp
    (hζ₀.isIntegral (Nat.pos_of_ne_zero hn0))
  have hζ₀'prim : IsPrimitiveRoot (ζ₀' : L) n := by
    rw [show (ζ₀' : L) = ζ₀ from hζ₀'coe]
    exact hζ₀
  have hreduc : IsPrimitiveRoot (Ideal.Quotient.mk Q.asIdeal ζ₀') n :=
    Commons.NumberTheory.NumberField.Completion.isPrimitiveRoot_reduction 𝔭 hnmem Q hQ hζ₀'prim
  have hgalζ : (galRestrict (𝓞 K) K L (𝓞 L) σ) ζ₀' = ζ₀' ^ a := by
    apply NumberField.RingOfIntegers.coe_injective (K := L)
    calc (algebraMap (𝓞 L) L) ((galRestrict (𝓞 K) K L (𝓞 L) σ) ζ₀')
        = σ ((algebraMap (𝓞 L) L) ζ₀') := algebraMap_galRestrict_apply (𝓞 K) σ ζ₀'
      _ = σ ζ₀ := by rw [hζ₀'coe]
      _ = ζ₀ ^ a := hσζ₀
      _ = (algebraMap (𝓞 L) L) (ζ₀' ^ a) := by rw [map_pow, hζ₀'coe]
  have hred_pow : (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ a
      = (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) := by
    calc (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ a
        = Ideal.Quotient.mk Q.asIdeal (ζ₀' ^ a) := (map_pow _ _ _).symm
      _ = Ideal.Quotient.mk Q.asIdeal ((galRestrict (𝓞 K) K L (𝓞 L) σ) ζ₀') := by rw [hgalζ]
      _ = (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) := hσres ζ₀'
  have hmod : a ≡ Nat.card (𝓞 K ⧸ 𝔭.asIdeal) [MOD n] := by
    rcases le_total a (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) with hle | hle
    · have h1 : (Ideal.Quotient.mk Q.asIdeal ζ₀') ^
          (Nat.card (𝓞 K ⧸ 𝔭.asIdeal) - a) = 1 := by
        have h2 : (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ a *
            (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (Nat.card (𝓞 K ⧸ 𝔭.asIdeal) - a)
            = (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ a * 1 := by
          rw [mul_one, ← pow_add, Nat.add_sub_of_le hle, hred_pow]
        exact mul_left_cancel₀ (pow_ne_zero _ (hreduc.ne_zero (NeZero.ne n))) h2
      exact (Nat.modEq_iff_dvd' hle).mpr ((hreduc.pow_eq_one_iff_dvd _).mp h1)
    · have h1 : (Ideal.Quotient.mk Q.asIdeal ζ₀') ^
          (a - Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) = 1 := by
        have h2 : (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) *
            (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (a - Nat.card (𝓞 K ⧸ 𝔭.asIdeal))
            = (Ideal.Quotient.mk Q.asIdeal ζ₀') ^ (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) * 1 := by
          rw [mul_one, ← pow_add, Nat.add_sub_of_le hle, hred_pow]
        exact mul_left_cancel₀ (pow_ne_zero _ (hreduc.ne_zero (NeZero.ne n))) h2
      exact ((Nat.modEq_iff_dvd' hle).mpr ((hreduc.pow_eq_one_iff_dvd _).mp h1)).symm
  have hZmod : ((a : ℕ) : ZMod n) = ((Nat.card (𝓞 K ⧸ 𝔭.asIdeal) : ℕ) : ZMod n) :=
    (ZMod.natCast_eq_natCast_iff a (Nat.card (𝓞 K ⧸ 𝔭.asIdeal)) n).mpr hmod
  -- ### the restriction to the local cyclotomic subfield `F`
  haveI hnormF : Normal (𝔭.adicCompletion K) ↥F := IsGalois.to_normal
  let ρ : ↥F ≃ₐ[𝔭.adicCompletion K] ↥F :=
    AlgEquiv.restrictNormalHom (F := 𝔭.adicCompletion K) (K₁ := L') ↥F σL
  have happ : ∀ (k : ℕ) (x : ↥F), (((ρ ^ k) x : ↥F) : L') = (σL ^ k) ((x : ↥F) : L') := by
    intro k
    induction k with
    | zero => intro x; simp
    | succ k ih =>
      intro x
      have h1 : ((ρ ^ (k + 1)) x : ↥F) = (ρ ^ k) (ρ x) := by
        rw [pow_succ, AlgEquiv.mul_apply]
      have h2 : (((ρ x : ↥F)) : L') = σL (((x : ↥F)) : L') :=
        AlgEquiv.restrictNormalHom_apply F σL x
      have h3 : (σL ^ k) (σL (((x : ↥F)) : L')) = (σL ^ (k + 1)) (((x : ↥F)) : L') := by
        rw [← AlgEquiv.mul_apply, ← pow_succ]
      rw [h1, ih (ρ x), h2, h3]
  have hmemζ' : ζ' ∈ F := IntermediateField.mem_adjoin_simple_self (𝔭.adicCompletion K) ζ'
  have hρpow : ρ ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree = 1 := by
    rw [hdeg, ← IsGalois.card_aut_eq_finrank (𝔭.adicCompletion K) ↥F]
    exact pow_card_eq_one'
  have hfix : (σL ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree) ζ' = ζ' := by
    have h1 : (ρ ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree) ⟨ζ', hmemζ'⟩ = ⟨ζ', hmemζ'⟩ := by
      rw [hρpow]; rfl
    have h2 := happ (minpoly (𝔭.adicCompletion K) ζ).natDegree ⟨ζ', hmemζ'⟩
    rw [h1] at h2
    exact h2.symm
  -- ### `a ^ d ≡ 1 (mod n)`
  have hσpow : ∀ k : ℕ, (σL ^ k) ζ' = ζ' ^ (a ^ k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc (σL ^ (k + 1)) ζ' = σL ((σL ^ k) ζ') := by rw [pow_succ', AlgEquiv.mul_apply]
        _ = σL (ζ' ^ (a ^ k)) := by rw [ih]
        _ = (σL ζ') ^ (a ^ k) := by rw [map_pow]
        _ = (ζ' ^ a) ^ (a ^ k) := by rw [hσL_ζ']
        _ = ζ' ^ (a ^ (k + 1)) := by rw [← pow_mul, ← pow_succ']
  have hpowfix : ζ' ^ (a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree) = ζ' := by
    rw [← hσpow, hfix]
  have hfinal : ((a : ℕ) : ZMod n) ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree = 1 := by
    have hpos : 1 ≤ a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree :=
      Nat.one_le_pow _ _ (Nat.pos_of_ne_zero ha_ne)
    have hdvd : n ∣ a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree - 1 := by
      refine (hζ'.pow_eq_one_iff_dvd _).mp ?_
      have h2 : ζ' ^ (a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree - 1) * ζ' = 1 * ζ' := by
        rw [one_mul, ← pow_succ, Nat.sub_add_cancel hpos, hpowfix]
      exact mul_right_cancel₀ (hζ'.ne_zero (NeZero.ne n)) h2
    have h3 : ((a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree : ℕ) : ZMod n) = 1 := by
      rw [show a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree
            = (a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree - 1) + 1
          from (Nat.sub_add_cancel hpos).symm,
        Nat.cast_add, Nat.cast_one,
        (CharP.cast_eq_zero_iff (ZMod n) n
          (a ^ (minpoly (𝔭.adicCompletion K) ζ).natDegree - 1)).mpr hdvd, zero_add]
    simpa using h3
  -- ### conclude
  have hq_eq : (NK.LocalStructure.residueCard K 𝔭 : ZMod n)
      = ((Nat.card (𝓞 K ⧸ 𝔭.asIdeal) : ℕ) : ZMod n) := by
    rw [NK.LocalStructure.residueCard]
    exact congrArg (fun m : ℕ => ((m : ℕ) : ZMod n))
      (Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletionIntegers_eq_natCard_quotient K 𝔭)
  rw [hq_eq, ← hZmod]
  exact orderOf_dvd_iff_pow_eq_one.mpr hfinal

end NK.TameStructureDeep.Degree
