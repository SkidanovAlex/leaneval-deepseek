/-!
# The unramified closure `κ(μ_{p'})` is generated by the roots of unity it contains

Let `K` be a number field, `𝔭` a finite place, `κ = K_𝔭` its completion, `p` the residue
characteristic emboxed into `NK.TameStructureDeep.Degree.residueChar 𝔭`, and let
`L = NK.LocalAnabelian.unramifiedClosure p` be the maximal unramified extension
`κ(μ_{p'})`, realised inside a separable closure `K'`.

By definition `L` is the compositum of the simple extensions `κ⟮ζ⟯` over all primitive
`n`-th roots of unity `ζ ∈ K'` with `(n, p) = 1`.  The present lemma records that this
compositum is *already* generated by the roots of unity lying **inside** `L`:

`L = ⨆_{n, p ∤ n} ⨆_{ζ ∈ L, ζ primitive n-th root} κ⟮ζ⟯`.

This is the form in which the cyclotomic level tower inside `L` is used: the `Galois`
correspondence for `L/κ` is computed from the subfields `κ⟮ζ⟯ ⊆ L` alone, so one needs to
know that these subfields already exhaust `L`.

The proof is formal bookkeeping: `IntermediateField.lift` (`F ↦ F.map L.val`) is an
injective, supremum-preserving map from the intermediate fields of `L/κ` to the
intermediate fields of `K'/κ` contained in `L`; it sends `κ⟮ζ⟯` (for `ζ : L`) to
`κ⟮↑ζ⟯`, and it sends `⊤` to `L`.  So the assertion is equivalent to the identity
`⨆_{n, p ∤ n} ⨆_{ζ ∈ L} κ⟮↑ζ⟯ = ⨆_{n, p ∤ n} ⨆_{ζ ∈ K'} κ⟮ζ⟯`, which holds because
every `ζ ∈ K'` that is a primitive `n`-th root of unity with `p ∤ n` lies in
`κ⟮ζ⟯ ≤ L`, hence contributes to the `L`-indexed supremum.
-/

open scoped Classical
open IntermediateField

namespace NK.TameStructureDeep.Degree

theorem iSup_adjoin_primitiveRoot_eq_top {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {K' : Type*}
    [Field K'] [Algebra (𝔭.adicCompletion K) K'] [IsSepClosure (𝔭.adicCompletion K) K'] :
    ((⨆ (n : {n : ℕ // ¬ NK.TameStructureDeep.Degree.residueChar 𝔭 ∣ n})
      (ζ : ↥(NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
        (NK.TameStructureDeep.Degree.residueChar 𝔭)))
      (_ : IsPrimitiveRoot ζ (n : ℕ)),
        IntermediateField.adjoin (𝔭.adicCompletion K) ({ζ} : Set _)) :
      IntermediateField (𝔭.adicCompletion K)
        ↥(NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
          (NK.TameStructureDeep.Degree.residueChar 𝔭)))
      = ⊤ := by
  -- Abbreviate the unramified closure and pass to the ambient field `K'`: since
  -- `IntermediateField.lift L` is injective and sends `⊤` to `L`, it suffices to
  -- identify the lift of the left-hand side with `L`.
  set L := NK.LocalAnabelian.unramifiedClosure (κ := 𝔭.adicCompletion K) (K' := K')
    (NK.TameStructureDeep.Degree.residueChar 𝔭) with hL
  refine ((IntermediateField.lift_injective L).eq_iff).mp ?_
  rw [IntermediateField.lift_top]
  -- `lift` is `map L.val`, and `map` preserves suprema; on `κ⟮ζ⟯` (`ζ : L`) it is
  -- `adjoin_map`, giving `κ⟮↑ζ⟯`.
  simp only [IntermediateField.lift, IntermediateField.map_iSup]
  simp only [IntermediateField.adjoin_map, Set.image_singleton, IntermediateField.coe_val]
  -- It remains to show that the `L`-indexed supremum of the `κ⟮↑ζ⟯` is `L` itself.
  refine le_antisymm ?_ ?_
  · -- `κ⟮↑ζ⟯ ≤ L` for `ζ ∈ L`, since `L` is a subfield containing `κ` and `ζ`.
    refine iSup_le fun n => iSup_le fun ζ => iSup_le fun hζ => ?_
    exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr ζ.2)
  · -- Conversely, unfold the definition of `L`: every term `κ⟮ζ⟯` of its defining
    -- supremum is a term of the `L`-indexed supremum, because `ζ ∈ κ⟮ζ⟯ ≤ L`.
    conv_lhs => rw [hL, NK.LocalAnabelian.unramifiedClosure]
    refine iSup_le fun n => iSup_le fun ζ => iSup_le fun hζ => ?_
    have hmem : ζ ∈ L := by
      rw [hL, NK.LocalAnabelian.unramifiedClosure]
      have h1 : (𝔭.adicCompletion K)⟮ζ⟯ ≤ ⨆ (n : {n : ℕ // ¬ residueChar 𝔭 ∣ n}) (ζ' : K')
          (_ : IsPrimitiveRoot ζ' (↑n)), (𝔭.adicCompletion K)⟮ζ'⟯ := by
        refine le_iSup_of_le n ?_
        refine le_iSup_of_le ζ ?_
        exact le_iSup_of_le hζ (le_refl _)
      exact h1 (IntermediateField.subset_adjoin _ _ (Set.mem_singleton ζ))
    refine le_iSup_of_le n ?_
    refine le_iSup_of_le (⟨ζ, hmem⟩ : ↥L) ?_
    have hζ' : IsPrimitiveRoot (⟨ζ, hmem⟩ : ↥L) (↑n) := by
      rw [← IsPrimitiveRoot.coe_submonoidClass_iff (N := L) (ζ := (⟨ζ, hmem⟩ : ↥L)) (k := ↑n)]
      exact hζ
    exact le_iSup_of_le hζ' (le_refl _)

end NK.TameStructureDeep.Degree
