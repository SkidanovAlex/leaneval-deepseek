/-!
# The `p`-power quotient of the `p`-power torsion of the units of a local field

For a field `κ` and a prime `p`, let `μ_{p^∞}(κ) ≤ κˣ` be the subgroup generated by the elements
killed by some power of `p` (equivalently, the `p`-power torsion subgroup).  Then

  `μ_{p^∞}(κ) / μ_{p^∞}(κ)^p` has order `p ^ zetaIndicator p κ`,

i.e. order `p` when `κ` contains a primitive `p`-th root of unity and order `1` otherwise.

The proof uses only that the `p`-power torsion subgroup, when bounded by an exponent `p ^ N`,
is contained in the group `μ_{p^N}(κ)` of `p^N`-th roots of unity in the field; the `p`-th power
map on the (finite, abelian) torsion subgroup then has kernel `μ_p(κ)` and index `#μ_p(κ)`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedVariables false

namespace NK.LocalInputs.PowerQuotient

open scoped Classical

/-- **The order of `μ_p(κ)`**: for a prime `p` and a field `κ`, the group of `p`-th roots of
unity in `κ` has order `p ^ zetaIndicator p κ`. -/
private theorem natCard_rootsOfUnity_eq_pow_zetaIndicator (p : ℕ) (hp : p.Prime) (κ : Type*)
    [Field κ] :
    Nat.card (rootsOfUnity p κ) = p ^ NK.LocalInputs.zetaIndicator p κ := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  by_cases h : ∃ ζ : κ, IsPrimitiveRoot ζ p
  · obtain ⟨ζ, hζ⟩ := h
    rw [(NK.LocalInputs.zetaIndicator_eq_one_iff p κ).mpr ⟨ζ, hζ⟩, pow_one]
    exact hζ.card_rootsOfUnity
  · rw [(NK.LocalInputs.zetaIndicator_eq_zero_iff p κ).mpr h, pow_zero,
      Nat.card_eq_one_iff_unique]
    have key : ∀ x : κ, x ^ p = 1 → x = 1 := by
      intro x hx
      rcases hp.eq_one_or_self_of_dvd (orderOf x) (orderOf_dvd_iff_pow_eq_one.mpr hx) with h1 | h2
      · exact orderOf_eq_one_iff.mp h1
      · exact absurd ⟨x, IsPrimitiveRoot.iff_orderOf.mpr h2⟩ h
    have keyu : ∀ u : κˣ, u ^ p = 1 → u = 1 := by
      intro u hu
      refine Units.ext (key (u : κ) ?_)
      rw [← Units.val_pow_eq_pow_val, hu, Units.val_one]
    refine ⟨⟨fun a b => Subtype.ext ?_⟩, ⟨⟨1, by simp⟩⟩⟩
    have ha : (a : κˣ) ^ p = 1 := (mem_rootsOfUnity p (a : κˣ)).mp a.2
    have hb : (b : κˣ) ^ p = 1 := (mem_rootsOfUnity p (b : κˣ)).mp b.2
    rw [keyu a.1 ha, keyu b.1 hb]

/-- **The `p`-power quotient of the `p`-power torsion of the units of a field.**  If every
`p`-power torsion unit is killed by `p ^ N`, the quotient of the `p`-power torsion subgroup by its
`p`-th powers has order `p ^ zetaIndicator p κ`. -/
private theorem natCard_powTorsion_quot_pow_field (p : ℕ) (hp : p.Prime) (κ : Type*) [Field κ]
    {N : ℕ} (hN : ∀ ζ : κˣ, (∃ m : ℕ, ζ ^ p ^ m = 1) → ζ ^ p ^ N = 1) :
    Nat.card (↥(Subgroup.closure {ζ : κˣ | ∃ m : ℕ, ζ ^ p ^ m = 1}) ⧸
      (powMonoidHom p : ↥(Subgroup.closure {ζ : κˣ | ∃ m : ℕ, ζ ^ p ^ m = 1}) →*
        ↥(Subgroup.closure {ζ : κˣ | ∃ m : ℕ, ζ ^ p ^ m = 1})).range) =
      p ^ NK.LocalInputs.zetaIndicator p κ := by
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : NeZero (p ^ N) := ⟨pow_ne_zero N hp.ne_zero⟩
  let S : Set κˣ := {ζ : κˣ | ∃ m : ℕ, ζ ^ p ^ m = 1}
  let G : Subgroup κˣ := Subgroup.closure S
  change Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).range) =
      p ^ NK.LocalInputs.zetaIndicator p κ
  -- the `p`-power torsion elements form a subgroup, so the closure is exactly the torsion set
  have hmem : ∀ x : κˣ, x ∈ G ↔ ∃ m : ℕ, x ^ p ^ m = 1 := by
    intro x
    constructor
    · intro hx
      induction hx using Subgroup.closure_induction with
      | mem y hy => exact hy
      | one => exact ⟨0, by simp⟩
      | mul a b ha hb ha' hb' =>
        obtain ⟨m, hm⟩ := ha'
        obtain ⟨n, hn⟩ := hb'
        refine ⟨max m n, ?_⟩
        have h1 : a ^ p ^ max m n = 1 := by
          obtain ⟨d, hd⟩ := pow_dvd_pow p (le_max_left m n)
          rw [hd, pow_mul, hm, one_pow]
        have h2 : b ^ p ^ max m n = 1 := by
          obtain ⟨d, hd⟩ := pow_dvd_pow p (le_max_right m n)
          rw [hd, pow_mul, hn, one_pow]
        rw [mul_pow, h1, h2, mul_one]
      | inv a ha ha' =>
        obtain ⟨m, hm⟩ := ha'
        exact ⟨m, by rw [inv_pow, hm, inv_one]⟩
    · rintro ⟨m, hm⟩
      have hxS : x ∈ S := ⟨m, hm⟩
      exact Subgroup.subset_closure hxS
  -- bounded `p`-power torsion is contained in the `p ^ N`-th roots of unity, hence finite
  have hle : G ≤ rootsOfUnity (p ^ N) κ := by
    intro x hx
    rw [mem_rootsOfUnity]
    exact hN x ((hmem x).mp hx)
  haveI : Finite ↥G := Finite.of_injective (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle)
  -- the `p`-th power map on `G`: Lagrange's theorem for its range and its kernel
  have hlag : Nat.card ↥G =
      Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).range) *
        Nat.card ↥(powMonoidHom p : ↥G →* ↥G).range :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  have hfirst : Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).ker) =
      Nat.card ↥(powMonoidHom p : ↥G →* ↥G).range :=
    Nat.card_congr (QuotientGroup.quotientKerEquivRange _).toEquiv
  have hlag2 : Nat.card ↥G =
      Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).ker) *
        Nat.card ↥(powMonoidHom p : ↥G →* ↥G).ker :=
    Subgroup.card_eq_card_quotient_mul_card_subgroup _
  haveI : Nonempty ↥(powMonoidHom p : ↥G →* ↥G).range :=
    ⟨1, (powMonoidHom p : ↥G →* ↥G).range.one_mem⟩
  haveI : Finite ↥(powMonoidHom p : ↥G →* ↥G).range :=
    Finite.of_injective (Subgroup.subtype _) Subtype.val_injective
  have hpos : 0 < Nat.card ↥(powMonoidHom p : ↥G →* ↥G).range := Nat.card_pos
  -- `#(G/G^p) = #G[p]`
  have hkey : Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).range) =
      Nat.card ↥(powMonoidHom p : ↥G →* ↥G).ker := by
    have h3 : Nat.card (↥G ⧸ (powMonoidHom p : ↥G →* ↥G).range) *
          Nat.card ↥(powMonoidHom p : ↥G →* ↥G).range =
        Nat.card ↥(powMonoidHom p : ↥G →* ↥G).ker *
          Nat.card ↥(powMonoidHom p : ↥G →* ↥G).range := by
      rw [← hlag, hlag2, hfirst]
      exact Nat.mul_comm _ _
    exact Nat.mul_right_cancel hpos h3
  -- the kernel of the `p`-th power map is exactly the group of `p`-th roots of unity
  have hmap : (powMonoidHom p : ↥G →* ↥G).ker.map G.subtype = rootsOfUnity p κ := by
    ext x
    constructor
    · intro hx
      rw [Subgroup.mem_map] at hx
      obtain ⟨y, hy, rfl⟩ := hx
      rw [mem_rootsOfUnity]
      simpa using congrArg Subtype.val hy
    · intro hx
      rw [mem_rootsOfUnity] at hx
      have hxS : x ∈ S := ⟨1, by rwa [pow_one]⟩
      rw [Subgroup.mem_map]
      refine ⟨⟨x, Subgroup.subset_closure hxS⟩, ?_, rfl⟩
      exact Subtype.ext (by simpa using hx)
  have hcardker : Nat.card ↥(powMonoidHom p : ↥G →* ↥G).ker =
      Nat.card (rootsOfUnity p κ) := by
    rw [← hmap]
    exact Nat.card_congr (Subgroup.equivMapOfInjective _ G.subtype Subtype.val_injective).toEquiv
  rw [hkey, hcardker]
  exact natCard_rootsOfUnity_eq_pow_zetaIndicator p hp κ

theorem natCard_powTorsion_quot_pow {K : Type*} [Field K] [NumberField K]
    (𝔭 : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) {p : ℕ} (hp : p.Prime)
    (hres : CharP (IsLocalRing.ResidueField (𝔭.adicCompletionIntegers K)) p) {N : ℕ}
    (hN : ∀ ζ : (𝔭.adicCompletion K)ˣ, (∃ m : ℕ, ζ ^ p ^ m = 1) → ζ ^ p ^ N = 1) :
    Nat.card (↥(Subgroup.closure {ζ : (𝔭.adicCompletion K)ˣ | ∃ m : ℕ, ζ ^ p ^ m = 1}) ⧸
      (powMonoidHom p : ↥(Subgroup.closure {ζ : (𝔭.adicCompletion K)ˣ |
          ∃ m : ℕ, ζ ^ p ^ m = 1}) →*
        ↥(Subgroup.closure {ζ : (𝔭.adicCompletion K)ˣ |
          ∃ m : ℕ, ζ ^ p ^ m = 1})).range) =
      p ^ NK.LocalInputs.zetaIndicator p (𝔭.adicCompletion K) :=
  natCard_powTorsion_quot_pow_field p hp (𝔭.adicCompletion K) hN

end NK.LocalInputs.PowerQuotient
