/-!
# Hilbert reciprocity for cyclic extensions: vocabulary and the reduction

This file collects the vocabulary used by the statement

> `NK.CFTLib.hilbertReciprocity_cyclic`: for a cyclic extension `L/K` of number fields and
> `a ∈ Kˣ`, if `P(a)·z ∈ N_{L/K}𝕀_L` for an idèle `z` supported at a single place `v₀`, then
> `P(a) ∈ N_{L/K}𝕀_L`,

and proves the **reduction** of that statement to the classical "the set of places of local-norm
failure is never a singleton" form of Hilbert reciprocity (Milne, *CFT*, VII.8.1(a) /
VIII.2 Example 2.2(ii)):

`HilbertReciprocityOnePlace`: an `a ∈ Kˣ` which is a local norm at every place `v ≠ v₀` is a local
norm at `v₀` as well.

The reduction is elementary: writing `P(a)·z = n ∈ N𝕀_L` with `z v = 1` for `v ≠ v₀`, one has
`a_v = (P(a)·z)_v = n_v` for every `v ≠ v₀`, so `a` is a local norm at every place different from
`v₀`; the local-norm form of Hilbert reciprocity upgrades this to all places, and the one-place
dictionary `onePlace_mem_normImage_iff` then exhibits `P(a)` as a norm idèle.

The arithmetic heart (the `Prop` `HilbertReciprocityOnePlace`) is stated with `def`, so nothing here
is `sorry`-free-dependent on it; it is attacked separately.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false
set_option maxHeartbeats 4000000

open scoped NumberField RestrictedProduct
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib

open NK.GlobalCFT

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L]

/-- The canonical map `Kˣ → K_vˣ` (the image of a global element in the completion at `v`). -/
noncomputable def localImageHom (v : Place K) : Kˣ →* (Place.localField K v)ˣ :=
  Units.map (algebraMap K (Place.localField K v)).toMonoidHom

@[simp] theorem localImageHom_apply (v : Place K) (x : Kˣ) :
    localImageHom (K := K) v x =
      Units.map (algebraMap K (Place.localField K v)).toMonoidHom x := rfl

/-- The subgroup of `Kˣ` of the elements that are local norms at the place `v`. -/
noncomputable def localNormPreimage (v : Place K) : Subgroup Kˣ :=
  (NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v).comap (localImageHom v)

theorem mem_localNormPreimage {v : Place K} {x : Kˣ} :
    x ∈ localNormPreimage (K := K) (L := L) v ↔
      localImageHom v x ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v :=
  Iff.rfl

/-- The norm group `N_{L/K} Lˣ` of the extension, as a subgroup of `Kˣ`. -/
noncomputable def normUnitSubgroup : Subgroup Kˣ :=
  MonoidHom.range (Units.map (Algebra.norm K : L →* K))

/-- **A component of an idèle norm is a local norm**: the `v`-component of `N_{L/K} y` lies in the
subgroup of `K_vˣ` generated by the local norm images.  (This is
`NK.CFTLib.IdeleHasse.normIdeleFun_mem_localNormSubgroup`.) -/
theorem mem_localNormSubgroup_normIdeleFun [IsGalois K L] (y : Idele L) (v : Place K) :
    Idele.normIdeleFun K L y v ∈
      NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v :=
  NK.CFTLib.IdeleHasse.normIdeleFun_mem_localNormSubgroup (K := K) (L := L) y v

/-- **Every component of a norm idèle is a local norm.** -/
theorem mem_localNormSubgroup_of_mem_normImage [IsGalois K L] {x : Idele K}
    (hx : x ∈ Idele.normImage K L) (v : Place K) :
    x v ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v := by
  obtain ⟨y, hy⟩ := Idele.mem_normImage.mp hx
  rw [hy v]
  exact mem_localNormSubgroup_normIdeleFun (K := K) (L := L) y v

/-- **A global norm is a local norm at every place.** -/
theorem normUnitSubgroup_le_localNormPreimage [IsGalois K L] (v : Place K) :
    normUnitSubgroup (K := K) (L := L) ≤ localNormPreimage (K := K) (L := L) v := by
  rintro x ⟨y, rfl⟩
  rw [mem_localNormPreimage]
  have hy : Idele.normIdeleHom K L (Idele.principalIdele L y) ∈ Idele.normImage K L :=
    Idele.mem_normImage.mpr ⟨Idele.principalIdele L y, fun _ => rfl⟩
  have h := mem_localNormSubgroup_of_mem_normImage (K := K) (L := L) hy v
  rwa [Idele.normIdeleHom_principalIdele, Idele.principalIdele_apply] at h

/-- **Membership in the local norm subgroup produces a local-norm equation**: if `a ∈ K_vˣ` is a
local norm then the one-place idèle at `a` is an idèle norm, hence is the `v`-component of a norm
idèle. -/
theorem exists_normIdeleFun_eq_of_mem_localNormSubgroup [IsGalois K L] {v : Place K}
    {a : (Place.localField K v)ˣ}
    (ha : a ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v) :
    ∃ y : Idele L, a = Idele.normIdeleFun K L y v := by
  have h : NK.HassePrinciple.onePlace v a ∈ Idele.normImage K L :=
    (NK.CFTLib.IdeleHasse.onePlace_mem_normImage_iff (K := K) (L := L) v a).mpr ha
  obtain ⟨y, hy⟩ := Idele.mem_normImage.mp h
  refine ⟨y, ?_⟩
  have hyv := hy v
  rwa [NK.HassePrinciple.onePlace_apply_self] at hyv

/-- **Hilbert reciprocity for cyclic extensions of number fields, "no singleton place of local-norm
failure" form** (Milne, *CFT*, VII.8.1(a), equivalently VIII.2 Example 2.2(ii)): a global element
`a ∈ Kˣ` which is a local norm at every place different from `v₀` is a local norm at `v₀` as well.
Equivalently (`mem_normImage_iff_localNorm`), the set of places at which `a` fails to be a local
norm is never a singleton.

This is the arithmetic heart of `NK.CFTLib.hilbertReciprocity_cyclic` and is equivalent to
Hilbert's reciprocity law `∑_v inv_v = 0`; it is the remaining input of the reduction
`NK.CFTLib.hilbertReciprocity_cyclic_of_onePlace` below. -/
def HilbertReciprocityOnePlace : Prop :=
  ∀ {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)] (a : Kˣ) (v₀ : Place K),
    (∀ v : Place K, v ≠ v₀ →
      localImageHom v a ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v) →
    localImageHom v₀ a ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v₀

/-- **Interface with the idèle formulation of the crux** used elsewhere in the workspace
(`NK.CFTLib.IdeleHasse.HilbertReciprocityCyclic`, the `onePlace v`-formulation): the local-norm
form of Hilbert reciprocity follows from it, via the one-place dictionary
`onePlace_mem_normImage_iff`. -/
theorem hilbertReciprocityOnePlace_of_onePlaceIdeles
    (H : NK.CFTLib.IdeleHasse.HilbertReciprocityCyclic) :
    HilbertReciprocityOnePlace := by
  intro K L _ _ _ _ _ _ _ _ a v₀ h
  have h' : ∀ v : Place K, v ≠ v₀ →
      NK.HassePrinciple.onePlace v (localImageHom v a) ∈ Idele.normImage K L :=
    fun v hv => (NK.CFTLib.IdeleHasse.onePlace_mem_normImage_iff (K := K) (L := L) v
      (localImageHom v a)).mpr (h v hv)
  have h₀ := H (K := K) (L := L) inferInstance a v₀ h'
  exact (NK.CFTLib.IdeleHasse.onePlace_mem_normImage_iff (K := K) (L := L) v₀
    (localImageHom v₀ a)).mp h₀

/-- **The reduction**: Hilbert reciprocity in the "no singleton bad set" form implies the
`NK.CFTLib.hilbertReciprocity_cyclic` statement. -/
theorem hilbertReciprocity_cyclic_of_onePlace (H : HilbertReciprocityOnePlace)
    (K L : Type) [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
    [FiniteDimensional K L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)]
    (a : Kˣ) (v₀ : Place K)
    (h : ∃ z : Idele K, (∀ v : Place K, v ≠ v₀ → z v = 1) ∧
      Idele.principalIdele K a * z ∈ Idele.normImage K L) :
    Idele.principalIdele K a ∈ Idele.normImage K L := by
  classical
  obtain ⟨z, hz1, hzmem⟩ := h
  -- `a` is a local norm at every place different from `v₀`
  have hloc : ∀ v : Place K, v ≠ v₀ →
      localImageHom v a ∈ NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L) v := by
    intro v hv
    have hmem := mem_localNormSubgroup_of_mem_normImage (K := K) (L := L) hzmem v
    rw [Idele.mul_apply, hz1 v hv, mul_one, Idele.principalIdele_apply] at hmem
    exact hmem
  -- the crux at `v₀`
  have hloc₀ := H a v₀ hloc
  -- conclude via the local–global dictionary
  rw [NK.CFTLib.IdeleHasse.mem_normImage_iff_localNorm]
  intro v
  refine exists_normIdeleFun_eq_of_mem_localNormSubgroup (K := K) (L := L) ?_
  by_cases hv : v = v₀
  · subst hv
    exact hloc₀
  · exact hloc v hv

end NK.CFTLib
