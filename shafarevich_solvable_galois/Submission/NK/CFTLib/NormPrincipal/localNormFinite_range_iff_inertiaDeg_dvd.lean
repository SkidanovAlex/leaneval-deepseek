/-!
# The image of the local norm of an unramified local extension

Let `K / F` be a finite Galois extension of number fields which is unramified at every finite
place (`differentIdeal (𝓞 F) (𝓞 K) = ⊤`), let `Q` be a finite place of `F` and `q` a finite place of
`K` above `Q`.  Then the local extension `K_q / F_Q` is unramified of degree
`f = [K_q : F_Q] = q.asIdeal.inertiaDeg (𝓞 F)`, and its norm group on the units of the
completions is

`N_{K_q/F_Q} K_qˣ = { z ∈ F_Qˣ | f ∣ v_Q z }`,

where `v_Q z = NK.CFTLib.finVal F Q z` is the normalized `Q`-adic valuation of `z` in additive
coordinates.  This is the statement of the main theorem below.

## Strategy

* the local computation `Commons.NumberTheory.NumberField.Completion.norm_range_of_ramificationIdx_eq_one`
  says `y` is a norm on the completions iff its valuation is an `f`-th power in the value group;
* `exists_val_eq_pow_iff_dvd_finVal` translates "the valuation is an `f`-th power" into the
  divisibility statement `(f : ℤ) ∣ finVal F Q z`;
* the restriction of the norm map to unit groups is handled by passing from a norm equation on
  the completions to one on the unit groups and back.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField WithZero
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.NormPrincipal

/-- **The value group form of the divisibility condition.**  For a unit `z` of the completion
`F_Q` and `0 < f`, `z` has a valuation which is an `f`-th power in the value group if and only if
its additive valuation `finVal F Q z` is divisible by `f`.

Indeed `Valued.v z = WithZero.exp (-(finVal F Q z))` and the `f`-th powers in the value group
`WithZero (Multiplicative ℤ)` are the elements `WithZero.exp (-(f * m))`, `m : ℤ`; the value group
is generated by the valuation of a uniformizer, so every integer `m` is attained
(`unitsValLog_adicCompletion_surjective`). -/
lemma exists_val_eq_pow_iff_dvd_finVal {F : Type} [Field F] [NumberField F]
    (Q : HeightOneSpectrum (𝓞 F)) (z : (Q.adicCompletion F)ˣ) (f : ℕ) (hf : 0 < f) :
    (∃ w : Q.adicCompletion F, Valued.v (z : Q.adicCompletion F) = (Valued.v w) ^ f) ↔
      (f : ℤ) ∣ finVal F Q z := by
  have hz : Valued.v (z : Q.adicCompletion F) ≠ 0 := by
    rw [Valuation.ne_zero_iff]; exact Units.ne_zero z
  have hlogz : WithZero.log (Valued.v (z : Q.adicCompletion F)) = -(finVal F Q z) := by
    simp only [finVal, neg_neg]
  have hspec : Valued.v (z : Q.adicCompletion F) = WithZero.exp (-(finVal F Q z)) := by
    rw [← hlogz]; exact (WithZero.exp_log hz).symm
  constructor
  · rintro ⟨w, hw⟩
    have hwne : w ≠ 0 := by
      rintro rfl
      rw [map_zero, zero_pow hf.ne'] at hw
      exact hz hw
    have hlog : WithZero.log (Valued.v (z : Q.adicCompletion F)) =
        (f : ℤ) * WithZero.log (Valued.v w) := by
      rw [hw, WithZero.log_pow]
      simp
    refine ⟨- WithZero.log (Valued.v w), ?_⟩
    have h2 : -(finVal F Q z) = (f : ℤ) * WithZero.log (Valued.v w) := by
      rw [← hlogz]; exact hlog
    linarith
  · rintro ⟨m, hm⟩
    obtain ⟨w, hw⟩ := Commons.NumberTheory.NumberField.Completion.unitsValLog_adicCompletion_surjective
      F Q (Multiplicative.ofAdd (-m))
    have hwlog : WithZero.log (Valued.v (w : Q.adicCompletion F)) = -m := by
      have := congrArg Multiplicative.toAdd hw
      simpa [Commons.NumberTheory.NumberField.Completion.unitsValLog_apply] using this
    have hw' : Valued.v (w : Q.adicCompletion F) = WithZero.exp (-m) := by
      rw [← hwlog]
      exact (WithZero.exp_log (by rw [Valuation.ne_zero_iff]; exact Units.ne_zero w)).symm
    refine ⟨(w : Q.adicCompletion F), ?_⟩
    have hexp : (Valued.v (w : Q.adicCompletion F)) ^ f =
        WithZero.exp (-(finVal F Q z)) := by
      rw [hw', ← WithZero.exp_nsmul]
      congr 1
      rw [show -(finVal F Q z) = -((f : ℤ) * m) from by rw [hm]]
      simp only [nsmul_eq_mul]
      ring
    rw [hspec, hexp]

theorem localNormFinite_range_iff_inertiaDeg_dvd
    {F K : Type} [Field F] [NumberField F] [Field K] [NumberField K] [Algebra F K]
    [FiniteDimensional F K] [IsGalois F K]
    (hfin : differentIdeal (NumberField.RingOfIntegers F) (NumberField.RingOfIntegers K) = ⊤)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers F))
    (q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hq : q.asIdeal.LiesOver Q.asIdeal) (z : (Q.adicCompletion F)ˣ) :
    (∃ y : (q.adicCompletion K)ˣ,
        NK.GlobalCFT.Place.localNormFinite q Q hq y = z) ↔
      (q.asIdeal.inertiaDeg (NumberField.RingOfIntegers F) : ℤ) ∣ NK.CFTLib.finVal F Q z := by
  letI : Algebra (Q.adicCompletion F) (q.adicCompletion K) :=
    (Commons.RingTheory.Henselian.adicCompletionMap Q q hq).toAlgebra
  have hlf : NK.GlobalCFT.Place.localNormFinite q Q hq =
      Units.map (Algebra.norm (Q.adicCompletion F)) := rfl
  -- The relative different is the unit ideal, so the local extension is unramified.
  have hunr : q.asIdeal.ramificationIdx (𝓞 F) = 1 := by
    rw [← Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal
      q.asIdeal q.isPrime, hfin]
    intro h
    rw [Ideal.dvd_iff_le] at h
    exact q.isPrime.ne_top (top_le_iff.mp h)
  -- Passing between the norm map on the completions and on their unit groups.
  have hstep : (∃ y : (q.adicCompletion K)ˣ,
        NK.GlobalCFT.Place.localNormFinite q Q hq y = z) ↔
      (∃ x : q.adicCompletion K,
        Algebra.norm (Q.adicCompletion F) x = (z : Q.adicCompletion F)) := by
    constructor
    · rintro ⟨y, hy⟩
      exact ⟨(y : q.adicCompletion K), by rw [← hy, hlf, Units.coe_map]⟩
    · rintro ⟨x, hx⟩
      haveI : Module.Finite (Q.adicCompletion F) (q.adicCompletion K) :=
        Commons.NumberTheory.NumberField.Completion.module_finite_adicCompletion Q q hq
      haveI : Module.Free (Q.adicCompletion F) (q.adicCompletion K) :=
        Module.Free.of_divisionRing _ _
      have hxne : x ≠ 0 := by
        intro hx0
        rw [hx0, Algebra.norm_zero] at hx
        exact (Units.ne_zero z) hx.symm
      refine ⟨Units.mk0 x hxne, ?_⟩
      rw [hlf]
      exact Units.ext (by rw [Units.coe_map, Units.val_mk0]; exact hx)
  rw [hstep, Commons.NumberTheory.NumberField.Completion.norm_range_of_ramificationIdx_eq_one
      Q q hq hunr (z : Q.adicCompletion F)]
  exact exists_val_eq_pow_iff_dvd_finVal Q z _ (Ideal.inertiaDeg_pos q.asIdeal (𝓞 F))

end NK.CFTLib.NormPrincipal
