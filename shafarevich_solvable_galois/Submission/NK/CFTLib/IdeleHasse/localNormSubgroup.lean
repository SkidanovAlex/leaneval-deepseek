/-!
# The local norm subgroup at a place

For a finite extension `L / K` of number fields and a place `v` of `K`, this file defines the
subgroup `NK.CFTLib.IdeleHasse.localNormSubgroup K L v ≤ K_vˣ` generated by the images of the
local norms `N_{L_w/K_v}` over the places `w` of `L` above `v`, and proves the "one-place"
dictionary `onePlace v a ∈ N_{L/K} 𝕀_L ↔ a ∈ localNormSubgroup K L v`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

open scoped NumberField RestrictedProduct
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.IdeleHasse

open NK.GlobalCFT

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L]

/-- The subgroup of `K_vˣ` generated by the images of the local norms `N_{L_w/K_v}` over the places
`w` of `L` above `v`.  By `mem_normImage_onePlace` below it is exactly the subgroup of those `a`
for which the one-place idèle `onePlace v a` is a norm of idèles. -/
noncomputable def localNormSubgroup (v : Place K) : Subgroup ((Place.localField K v)ˣ) :=
  match v with
  | Sum.inl w =>
      ⨆ (w' : {w' : InfinitePlace L // w'.LiesOver w}),
        MonoidHom.range (@Place.localNormInfinite K _ L _ _ w'.1 w w'.2)
  | Sum.inr Q =>
      ⨆ (q : {q : HeightOneSpectrum (𝓞 L) // q.asIdeal.LiesOver Q.asIdeal}),
        MonoidHom.range (Place.localNormFinite q.1 Q q.2)

theorem localNormSubgroup_ofInfinite (w : InfinitePlace K) :
    localNormSubgroup (K := K) (L := L) (Place.ofInfinite w) =
      ⨆ (w' : {w' : InfinitePlace L // w'.LiesOver w}),
        MonoidHom.range (@Place.localNormInfinite K _ L _ _ w'.1 w w'.2) := rfl

theorem localNormSubgroup_ofFinite (Q : HeightOneSpectrum (𝓞 K)) :
    localNormSubgroup (K := K) (L := L) (Place.ofFinite Q) =
      ⨆ (q : {q : HeightOneSpectrum (𝓞 L) // q.asIdeal.LiesOver Q.asIdeal}),
        MonoidHom.range (Place.localNormFinite q.1 Q q.2) := rfl

end NK.CFTLib.IdeleHasse
