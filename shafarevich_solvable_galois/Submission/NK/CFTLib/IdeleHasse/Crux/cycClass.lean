/-!
# The cyclic class of a global element at a cyclic Galois level

For a finite Galois extension `F/K` of number fields with `Gal(F/K)` *cyclic* and generated by `g`,
and an element `x ∈ Kˣ`, the **cyclic class** `cyclicClass K F g hg x` is the image of `x` under the
periodicity isomorphism `(Fˣ)^G ⧸ N(Fˣ) ≅ H²(G, Fˣ)` of Mathlib's finite cyclic group cohomology.
It is the class of the cyclic algebra `(F/K, g, x)` in `H²(Gal(F/K), Fˣ) = Br(F/K)`.

* `cyclicElem` — the element of `ker (ρ g - 1)` corresponding to `x`;
* `cyclicClass` — its periodicity image;
* `cyclicClass_eq_zero_iff` — *the class of `x` vanishes if and only if `x` is a norm*.

The universe of the coefficient ring `CoeffInt = ULift ℤ` is pinned to `0` through the abbreviation
`urep`; without this the statements mentioning `NK.HassePrinciple.unitsRep K F` elaborate with a
free universe and do not unify with the Mathlib API for `Rep.{0,0,0}`.
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

open NK.GlobalCFT CategoryTheory

namespace NK.CFTLib.IdeleHasse.Crux

/-- `NK.HassePrinciple.unitsRep K F` with all universes pinned to `0`. -/
noncomputable abbrev urep (K F : Type) [Field K] [Field F] [Algebra K F] :
    Rep.{0,0,0} NK.HassePrinciple.CoeffInt (F ≃ₐ[K] F) :=
  NK.HassePrinciple.unitsRep K F

variable {K F : Type} [Field K] [NumberField K] [Field F] [NumberField F] [Algebra K F]
  [FiniteDimensional K F] [IsGalois K F] [IsCyclic (F ≃ₐ[K] F)]

/-- The image of `x ∈ Kˣ` in `Fˣ`, as an element of the module of `unitsRep K F`. -/
noncomputable def cyclicElemRaw (y : Kˣ) : (urep K F).V :=
  Additive.ofMul (Units.map (algebraMap K F).toMonoidHom y)

attribute [local instance] IsCyclic.commGroup in
/-- **The image of `x ∈ Kˣ` is fixed by `Gal(F/K)`**: it lies in the kernel of `ρ g - 1`. -/
lemma cyclicElemRaw_mem (g : F ≃ₐ[K] F) (y : Kˣ) :
    cyclicElemRaw (K := K) (F := F) y ∈
      LinearMap.ker (Rep.Hom.hom ((urep K F).applyAsHom g - 𝟙 (urep K F))).toLinearMap := by
  rw [LinearMap.mem_ker]
  have hx : (urep K F).ρ g
      (Additive.ofMul (Units.map (algebraMap K F).toMonoidHom y))
      = Additive.ofMul (Units.map (algebraMap K F).toMonoidHom y) := by
    rw [show (urep K F).ρ g (Additive.ofMul (Units.map (algebraMap K F).toMonoidHom y))
        = Additive.ofMul (g • Units.map (algebraMap K F).toMonoidHom y) from rfl]
    congr 1
    ext
    exact AlgEquiv.commutes g (y : K)
  exact sub_eq_zero.mpr hx

attribute [local instance] IsCyclic.commGroup in
/-- **The element of the invariants `ker (ρ g - 1)` attached to `x ∈ Kˣ`.** -/
noncomputable def cyclicElem (g : F ≃ₐ[K] F) (y : Kˣ) :
    ↥(LinearMap.ker (Rep.Hom.hom ((urep K F).applyAsHom g - 𝟙 (urep K F))).toLinearMap) :=
  ⟨cyclicElemRaw y, cyclicElemRaw_mem g y⟩

attribute [local instance] IsCyclic.commGroup in
/-- **The cyclic class of `x ∈ Kˣ` at the cyclic level `F/K`** (generated by `g`): the image of `x`
under Mathlib's periodicity map `ker (ρ g - 1) ⟶ H²(Gal(F/K), Fˣ)`. -/
noncomputable def cyclicClass (g : F ≃ₐ[K] F) (hg : ∀ x : F ≃ₐ[K] F, x ∈ Subgroup.zpowers g)
    (y : Kˣ) : ↥(groupCohomology (urep K F) 2) :=
  (Rep.FiniteCyclicGroup.groupCohomologyπEven (urep K F) g hg 2 (by norm_num)).hom
    (cyclicElem g y)

attribute [local instance] IsCyclic.commGroup in
/-- **The cyclic class of `x` vanishes if and only if `x` is a norm from `F`**: this is the
classical `H²(G, Fˣ) ≅ Fˣ^G ⧸ N(Fˣ)` for a finite cyclic group, in the form
`groupCohomologyπEven_eq_zero_iff`. -/
theorem cyclicClass_eq_zero_iff (g : F ≃ₐ[K] F) (hg : ∀ x : F ≃ₐ[K] F, x ∈ Subgroup.zpowers g)
    (y : Kˣ) :
    cyclicClass (K := K) (F := F) g hg y = 0 ↔
      cyclicElemRaw (K := K) (F := F) y ∈
        LinearMap.range (Rep.Hom.hom (Rep.norm (urep K F))).toLinearMap := by
  have h := Rep.FiniteCyclicGroup.groupCohomologyπEven_eq_zero_iff
    (urep K F) g hg 2 (by norm_num) (cyclicElem g y)
  rw [LinearMap.mem_range] at h
  rw [LinearMap.mem_range]
  exact h

end NK.CFTLib.IdeleHasse.Crux
