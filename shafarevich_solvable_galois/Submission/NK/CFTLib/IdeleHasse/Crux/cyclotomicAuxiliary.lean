noncomputable section

/-- The intermediate field `K⟮ζ⟯` generated by `ζ`. -/
@[reducible] private def zetaAdjoin {K E : Type} [Field K] [Field E] [Algebra K E] (ζ : E) :
    IntermediateField K E :=
  IntermediateField.adjoin K ({ζ} : Set E)

/-- The image of `L` in an extension `E`. -/
@[reducible] private def imageSubfield {K L E : Type} [Field K] [Field L] [Field E] [Algebra K L]
    [Algebra K E] [Algebra L E] [IsScalarTower K L E] : IntermediateField K E :=
  (IsScalarTower.toAlgHom K L E).fieldRange

/-- A two-element family of intermediate fields, for `IntermediateField.normal_iSup`. -/
@[reducible] private def pairField {K E : Type} [Field K] [Field E] [Algebra K E]
    (F₁ F₂ : IntermediateField K E) : Bool → IntermediateField K E
  | true => F₁
  | false => F₂

/-- The two-element family in the case at hand. -/
@[reducible] private def pairHere {K L : Type} [Field K] [Field L] [Algebra K L] (q : ℕ)
    (ζ : CyclotomicField q L) : Bool → IntermediateField K (CyclotomicField q L) :=
  pairField (imageSubfield (K := K) (L := L) (E := CyclotomicField q L)) (zetaAdjoin (K := K) ζ)


/-- The norm of a height-one prime of a number field is at least `2`. -/
private lemma two_le_absNorm {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) : 2 ≤ Ideal.absNorm Q.asIdeal := by
  have h0 : Ideal.absNorm Q.asIdeal ≠ 0 := fun hc => Q.ne_bot (Ideal.absNorm_eq_zero_iff.mp hc)
  have h1 : Ideal.absNorm Q.asIdeal ≠ 1 := fun hc => Q.isMaximal.ne_top (Ideal.absNorm_eq_one_iff.mp hc)
  omega


/-- If `q` is a rational prime lying in the height-one prime `Q`, then `q ∣ NQ`. -/
private lemma dvd_absNorm_of_mem {K : Type} [Field K] [NumberField K]
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K)) (q : ℕ) (hq : q.Prime)
    (h : (q : 𝓞 K) ∈ Q.asIdeal) : q ∣ Ideal.absNorm Q.asIdeal := by
  have hle : Ideal.span ({(q : 𝓞 K)} : Set (𝓞 K)) ≤ Q.asIdeal := by
    rw [Ideal.span_singleton_le_iff_mem]; exact h
  have hdvd : Ideal.absNorm Q.asIdeal ∣
      Ideal.absNorm (Ideal.span ({(q : 𝓞 K)} : Set (𝓞 K))) :=
    Ideal.absNorm_dvd_absNorm_of_le hle
  rw [Ideal.absNorm_span_natCast] at hdvd
  obtain ⟨p, hp, hpdvd⟩ :=
    Nat.exists_prime_and_dvd (n := Ideal.absNorm Q.asIdeal) (by have := two_le_absNorm Q; omega)
  have hpq : p = q :=
    (hq.eq_one_or_self_of_dvd p (hp.dvd_of_dvd_pow (hpdvd.trans hdvd))).resolve_left hp.ne_one
  exact hpq ▸ hpdvd


/-- **The inertia degree divisibility for the cyclotomic extension of prime conductor `q`.**

At any prime `w` of `M` above `Q`, the inertia degree `f(w|Q)` is divisible by the order of `NQ`
in `(ℤ/q)ˣ`. -/
private lemma orderOf_unitOfCoprime_dvd_inertiaDeg {K M : Type} [Field K] [NumberField K] [Field M]
    [NumberField M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (q : ℕ) (hq : q.Prime) [IsCyclotomicExtension ({q} : Set ℕ) K M]
    (Q : IsDedekindDomain.HeightOneSpectrum (𝓞 K))
    (hcop : Nat.Coprime (Ideal.absNorm Q.asIdeal) q)
    (w : IsDedekindDomain.HeightOneSpectrum (𝓞 M)) (hw : w.asIdeal.LiesOver Q.asIdeal) :
    orderOf (ZMod.unitOfCoprime (Ideal.absNorm Q.asIdeal) hcop) ∣
      w.asIdeal.inertiaDeg (𝓞 K) := by
  classical
  haveI hqne : NeZero q := ⟨hq.ne_zero⟩
  -- ### `q` does not lie in `Q`, hence not in `w`
  have hqQ : (q : 𝓞 K) ∉ Q.asIdeal := by
    intro h
    exact hq.not_dvd_one (hcop.symm.dvd_of_dvd_mul_left (m := Ideal.absNorm Q.asIdeal)
      (by simpa using dvd_absNorm_of_mem Q q hq h))
  have hqw : (q : 𝓞 M) ∉ w.asIdeal := by
    intro hmem
    have h2 : (q : 𝓞 K) ∈ w.asIdeal.under (𝓞 K) := by
      rw [Ideal.mem_under]
      rw [map_natCast]
      exact hmem
    rw [(Ideal.LiesOver.over (self := hw)).symm] at h2
    exact hqQ h2
  -- ### a primitive `q`-th root of unity, integral over `𝓞 K`
  obtain ⟨ζ, hζ⟩ :=
    IsCyclotomicExtension.exists_isPrimitiveRoot K M (Set.mem_singleton q) hq.ne_zero
  have hint : IsIntegral (𝓞 K) ζ :=
    IsIntegral.tower_top (A := 𝓞 K) (B := M) (hζ.isIntegral hq.pos)
  obtain ⟨ζB, hζB⟩ :=
    (IsIntegralClosure.isIntegral_iff (A := 𝓞 M) (R := 𝓞 K) (B := M)).mp hint
  have hsumM : ∑ i ∈ Finset.range q, ζ ^ i = 0 := hζ.geom_sum_eq_zero hq.one_lt
  have hsum : ∑ i ∈ Finset.range q, ζB ^ i = 0 := by
    apply RingOfIntegers.coe_injective
    rw [map_sum, map_zero]
    simp only [map_pow, hζB]
    exact hsumM
  -- ### finiteness of the residue fields
  haveI hfinw : Finite (𝓞 M ⧸ w.asIdeal) :=
    Ring.HasFiniteQuotients.finiteQuotient w.ne_bot
  haveI hfintw : Fintype (𝓞 M ⧸ w.asIdeal) := Fintype.ofFinite _
  haveI hfinQ : Finite (𝓞 K ⧸ Q.asIdeal) :=
    Ring.HasFiniteQuotients.finiteQuotient Q.ne_bot
  haveI hfintQ : Fintype (𝓞 K ⧸ Q.asIdeal) := Fintype.ofFinite _
  -- ### the image of `ζB` in the residue field has order `q`
  have hdvd : q ∣ Fintype.card (𝓞 M ⧸ w.asIdeal) - 1 := by
    letI : Field (𝓞 M ⧸ w.asIdeal) := Ideal.Quotient.field w.asIdeal
    let x : 𝓞 M ⧸ w.asIdeal := Ideal.Quotient.mk w.asIdeal ζB
    have hpow : x ^ q = 1 := by
      have h1 : ζB ^ q = 1 := by
        apply RingOfIntegers.coe_injective
        rw [map_pow, hζB, map_one, hζ.pow_eq_one]
      show (Ideal.Quotient.mk w.asIdeal ζB) ^ q = 1
      rw [← map_pow, h1, map_one]
    have hne1 : x ≠ 1 := by
      intro hx1
      refine hqw ?_
      have hmap : Ideal.Quotient.mk w.asIdeal (∑ i ∈ Finset.range q, ζB ^ i) = 0 := by
        rw [hsum, map_zero]
      have hterm : ∀ i : ℕ, (Ideal.Quotient.mk w.asIdeal ζB) ^ i = (1 : 𝓞 M ⧸ w.asIdeal) :=
        fun i => by rw [show Ideal.Quotient.mk w.asIdeal ζB = (1 : 𝓞 M ⧸ w.asIdeal) from hx1,
          one_pow]
      have hqeq : (q : 𝓞 M ⧸ w.asIdeal) = 0 := by
        rw [← hmap, map_sum]
        simp only [map_pow]
        rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_const, Finset.card_range,
          nsmul_eq_mul, mul_one]
      exact Ideal.Quotient.eq_zero_iff_mem.mp hqeq
    have hmul1 : x * x ^ (q - 1) = 1 := by
      rw [← pow_succ', Nat.sub_add_cancel hq.one_le, hpow]
    let u : (𝓞 M ⧸ w.asIdeal)ˣ := Units.mkOfMulEqOne x (x ^ (q - 1)) hmul1
    have huco : (u : 𝓞 M ⧸ w.asIdeal) = x := Units.val_mkOfMulEqOne hmul1
    have huq : u ^ q = 1 := by
      apply Units.ext
      rw [Units.val_pow_eq_pow_val, Units.val_one, huco]
      exact hpow
    have hune : u ≠ 1 := by
      intro h
      refine hne1 ?_
      rw [← huco, h, Units.val_one]
    have hord : orderOf u = q := by
      haveI : Fact q.Prime := ⟨hq⟩
      exact orderOf_eq_prime huq hune
    have h1 : q ∣ Nat.card (𝓞 M ⧸ w.asIdeal) - 1 := by
      rw [← Nat.card_units (𝓞 M ⧸ w.asIdeal)]
      exact hord ▸ orderOf_dvd_natCard u
    rwa [Nat.card_eq_fintype_card] at h1
  -- ### compare with the cardinality of the residue field of `Q`
  have habs : Ideal.absNorm Q.asIdeal = Fintype.card (𝓞 K ⧸ Q.asIdeal) := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  have hcard : Fintype.card (𝓞 M ⧸ w.asIdeal)
      = Fintype.card (𝓞 K ⧸ Q.asIdeal) ^ w.asIdeal.inertiaDeg (𝓞 K) := by
    letI : Field (𝓞 K ⧸ Q.asIdeal) := Ideal.Quotient.field Q.asIdeal
    letI : Field (𝓞 M ⧸ w.asIdeal) := Ideal.Quotient.field w.asIdeal
    rw [Ideal.inertiaDeg_eq_of_isMaximal Q.asIdeal w.asIdeal,
      Module.card_eq_pow_finrank (K := 𝓞 K ⧸ Q.asIdeal) (V := 𝓞 M ⧸ w.asIdeal)]
  have hqNQf : q ∣ Ideal.absNorm Q.asIdeal ^ w.asIdeal.inertiaDeg (𝓞 K) - 1 := by
    rw [hcard] at hdvd
    rwa [← habs] at hdvd
  -- ### conclude
  have hle : 1 ≤ Ideal.absNorm Q.asIdeal ^ w.asIdeal.inertiaDeg (𝓞 K) :=
    one_le_pow₀ (by have := two_le_absNorm Q; omega)
  have hcast : ((Ideal.absNorm Q.asIdeal ^ w.asIdeal.inertiaDeg (𝓞 K) : ℕ) : ZMod q) = 1 := by
    have h0 : (((Ideal.absNorm Q.asIdeal ^ w.asIdeal.inertiaDeg (𝓞 K)) - 1 : ℕ) : ZMod q) = 0 :=
      (ZMod.natCast_eq_zero_iff _ _).mpr hqNQf
    rw [Nat.cast_sub hle, Nat.cast_one, sub_eq_zero] at h0
    exact h0
  refine orderOf_dvd_iff_pow_eq_one.mpr ?_
  apply Units.ext
  rw [Units.val_pow_eq_pow_val, Units.val_one, ZMod.coe_unitOfCoprime]
  simpa only [Nat.cast_pow] using hcast


theorem cyclotomicAuxiliary {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (q : ℕ) (hq : q.Prime)
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (hcop : Nat.Coprime (Ideal.absNorm Q.asIdeal) q) :
    ∃ (M E : Type) (_ : Field M) (_ : NumberField M) (_ : Field E) (_ : NumberField E)
      (_ : Algebra K M) (_ : Algebra K E) (_ : Algebra L E) (_ : Algebra M E)
      (_ : IsScalarTower K L E) (_ : IsScalarTower K M E)
      (_ : FiniteDimensional K M) (_ : FiniteDimensional K E)
      (_ : IsGalois K M) (_ : IsGalois K E) (_ : IsCyclic (M ≃ₐ[K] M))
      (_ : IsCyclotomicExtension {q} K M),
      (Algebra.adjoin K (Set.range (algebraMap L E) ∪ Set.range (algebraMap M E)) = ⊤) ∧
      (∀ (w : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers M)),
        w.asIdeal.LiesOver Q.asIdeal →
        orderOf (ZMod.unitOfCoprime (Ideal.absNorm Q.asIdeal) hcop) ∣
          w.asIdeal.inertiaDeg (NumberField.RingOfIntegers K)) := by
  classical
  haveI hqne : NeZero q := ⟨hq.ne_zero⟩
  obtain ⟨ζ, hζ⟩ := IsCyclotomicExtension.exists_isPrimitiveRoot L (CyclotomicField q L)
      (Set.mem_singleton q) hq.ne_zero
  haveI hcycL : IsCyclotomicExtension ({q} : Set ℕ) L (CyclotomicField q L) := inferInstance
  haveI hcycM : IsCyclotomicExtension ({q} : Set ℕ) K ↥(zetaAdjoin (K := K) ζ) :=
    hζ.intermediateField_adjoin_isCyclotomicExtension (K := K) (L := CyclotomicField q L)
  haveI hgalM : IsGalois K ↥(zetaAdjoin (K := K) ζ) :=
    IsCyclotomicExtension.isGalois ({q} : Set ℕ) K ↥(zetaAdjoin (K := K) ζ)
  haveI hfdM : FiniteDimensional K ↥(zetaAdjoin (K := K) ζ) :=
    IsCyclotomicExtension.finiteDimensional ({q} : Set ℕ) K ↥(zetaAdjoin (K := K) ζ)
  haveI hNM : NumberField ↥(zetaAdjoin (K := K) ζ) :=
    IsCyclotomicExtension.numberField ({q} : Set ℕ) K ↥(zetaAdjoin (K := K) ζ)
  have hcycAut : IsCyclic (↥(zetaAdjoin (K := K) ζ) ≃ₐ[K] ↥(zetaAdjoin (K := K) ζ)) := by
    haveI hunits : IsCyclic (ZMod q)ˣ := ZMod.isCyclic_units_prime hq
    have hζM : IsPrimitiveRoot (IsCyclotomicExtension.zeta q K ↥(zetaAdjoin (K := K) ζ)) q :=
      IsCyclotomicExtension.zeta_spec q K ↥(zetaAdjoin (K := K) ζ)
    have hinj : Function.Injective (IsPrimitiveRoot.autToPow K hζM) := hζM.autToPow_injective K
    haveI hrange : IsCyclic (MonoidHom.range (IsPrimitiveRoot.autToPow K hζM)) := Subgroup.isCyclic _
    have e : (↥(zetaAdjoin (K := K) ζ) ≃ₐ[K] ↥(zetaAdjoin (K := K) ζ)) ≃*
        ↥(MonoidHom.range (IsPrimitiveRoot.autToPow K hζM)) :=
      MonoidHom.ofInjective (f := IsPrimitiveRoot.autToPow K hζM) hinj
    exact isCyclic_of_surjective e.symm.toMonoidHom e.symm.surjective
  -- ## the generation condition
  have hgenL : Algebra.adjoin L ({ζ} : Set (CyclotomicField q L)) = ⊤ :=
    IsCyclotomicExtension.adjoin_primitive_root_eq_top (A := L) hζ
  have hadjoin : Algebra.adjoin K (Set.range (algebraMap L (CyclotomicField q L)) ∪
      Set.range (algebraMap ↥(zetaAdjoin (K := K) ζ) (CyclotomicField q L))) = ⊤ := by
    have h1 : (Algebra.adjoin L ({ζ} : Set (CyclotomicField q L))).restrictScalars K
        ≤ Algebra.adjoin K (Set.range (algebraMap L (CyclotomicField q L)) ∪
          Set.range (algebraMap ↥(zetaAdjoin (K := K) ζ) (CyclotomicField q L))) := by
      have key := Algebra.Subalgebra.restrictScalars_adjoin (S := L) K
        (s := ({ζ} : Set (CyclotomicField q L)))
      rw [key]
      refine sup_le ?_ ?_
      · rintro y ⟨l, rfl⟩
        exact Algebra.subset_adjoin (Or.inl ⟨l, rfl⟩)
      · refine Algebra.adjoin_mono ?_
        intro y hy
        rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact Or.inr ⟨⟨ζ, IntermediateField.mem_adjoin_simple_self K ζ⟩, rfl⟩
    have h2 : (Algebra.adjoin L ({ζ} : Set (CyclotomicField q L))).restrictScalars K = ⊤ := by
      rw [hgenL]
      exact Subalgebra.restrictScalars_top K
    rw [h2] at h1
    exact top_le_iff.mp h1
  -- ## the normality of `E`
  haveI hNL : Normal K ↥(imageSubfield (K := K) (L := L) (E := CyclotomicField q L)) :=
    Normal.of_algEquiv (AlgEquiv.ofInjectiveField (IsScalarTower.toAlgHom K L (CyclotomicField q L)))
  haveI hNsup : Normal K
      ↥(imageSubfield (K := K) (L := L) (E := CyclotomicField q L) ⊔ zetaAdjoin (K := K) ζ) := by
    haveI hfam : ∀ b : Bool, Normal K ↥(pairHere (K := K) (L := L) q ζ b) := by
      intro b
      cases b
      · exact hgalM.to_normal
      · exact hNL
    haveI hN := IntermediateField.normal_iSup (F := K) (K := CyclotomicField q L)
      (t := pairHere (K := K) (L := L) q ζ)
    have hsup2 : (⨆ b : Bool, pairHere (K := K) (L := L) q ζ b)
        = imageSubfield (K := K) (L := L) (E := CyclotomicField q L) ⊔ zetaAdjoin (K := K) ζ := by
      refine le_antisymm ?_ ?_
      · refine iSup_le fun b => ?_
        cases b
        · exact le_sup_right
        · exact le_sup_left
      · exact sup_le (le_iSup (pairHere (K := K) (L := L) q ζ) true)
          (le_iSup (pairHere (K := K) (L := L) q ζ) false)
    exact Normal.of_algEquiv (IntermediateField.equivOfEq hsup2)
  have hsup : imageSubfield (K := K) (L := L) (E := CyclotomicField q L) ⊔ zetaAdjoin (K := K) ζ
      = ⊤ := by
    have hle : Algebra.adjoin K (Set.range (algebraMap L (CyclotomicField q L)) ∪
        Set.range (algebraMap ↥(zetaAdjoin (K := K) ζ) (CyclotomicField q L)))
        ≤ (imageSubfield (K := K) (L := L) (E := CyclotomicField q L)
            ⊔ zetaAdjoin (K := K) ζ).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      rintro y (hy | hy)
      · obtain ⟨l, rfl⟩ := hy
        exact (le_sup_left : imageSubfield (K := K) (L := L) (E := CyclotomicField q L)
            ≤ imageSubfield (K := K) (L := L) (E := CyclotomicField q L) ⊔ zetaAdjoin (K := K) ζ)
          (AlgHom.mem_fieldRange.mpr ⟨l, rfl⟩)
      · obtain ⟨m, rfl⟩ := hy
        exact (le_sup_right : zetaAdjoin (K := K) ζ
            ≤ imageSubfield (K := K) (L := L) (E := CyclotomicField q L) ⊔ zetaAdjoin (K := K) ζ)
          m.2
    rw [hadjoin] at hle
    exact IntermediateField.toSubalgebra_inj.mp (eq_top_iff.mpr hle)
  haveI hNE : Normal K (CyclotomicField q L) :=
    Normal.of_algEquiv ((IntermediateField.equivOfEq hsup).trans IntermediateField.topEquiv)
  haveI hgalE : IsGalois K (CyclotomicField q L) := isGalois_iff.mpr ⟨inferInstance, hNE⟩
  refine ⟨↥(zetaAdjoin (K := K) ζ), CyclotomicField q L, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
    ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact inferInstance
  · exact hNM
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact inferInstance
  · exact hfdM
  · exact inferInstance
  · exact hgalM
  · exact hgalE
  · exact hcycAut
  · exact ⟨hcycM, hadjoin, fun w hw => orderOf_unitOfCoprime_dvd_inertiaDeg q hq Q hcop w hw⟩

end

end NK.CFTLib.IdeleHasse.Crux
