/-!
# The local Artin map of a finite cyclic extension at a finite place

Let `L / K` be a finite cyclic Galois extension of number fields and `Q` a finite place of `K`.
This file produces a group homomorphism

`F : (K_Q)ˣ →* Gal(L/K)`

whose kernel is the local norm subgroup `NK.CFTLib.IdeleHasse.localNormSubgroup K L v` (the
subgroup of `K_Qˣ` generated by the local norms `N_{L_w/K_Q} L_wˣ`, which — by
`range_localNormFinite_eq_of_liesOver` — is the norm group of every completion `L_w`, `w | Q`),
and which is Frobenius-normalised: if `Q` is unramified in `L/K`, then `F` sends a local
uniformiser to `frobAtPrime Q`.

## The construction

Fix a place `q` of `L` above `Q` and identify the decomposition group `D_q` with the local Galois
group `Gal(L_q/K_Q)` (`decompositionSubgroupMulEquivLocalGalois`).

* If `Q` is unramified in `L/K`, use the canonical Frobenius-normalised local Artin map
  `NK.LocalReciprocity.artinUnramified Q q` (whose kernel is the norm group and which sends a
  uniformiser to the local Frobenius).  The element of `D_q` corresponding to the local Frobenius
  is an arithmetic Frobenius at `q` (`isFrobAt_of_decompositionToLocalGalois_eq_frobeniusLocal`),
  hence, by the uniqueness of the Frobenius at an unramified prime of an abelian extension, it is
  `frobAtPrime Q`.
* If `Q` is ramified the second clause of the statement is vacuous, and it suffices to use the
  general local reciprocity law in the form `exists_mulEquiv_artinMap_of_commute`.

## Main result

* `NK.CFTLib.IdeleHasse.exists_localMap_ofFinite`
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 2000000
set_option backward.isDefEq.respectTransparency false

open scoped NumberField
open IsDedekindDomain
open NK.GlobalCFT

noncomputable section

namespace NK.CFTLib.IdeleHasse

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-! ### Coercions of algebraic operations into the adic completion -/

/-- The canonical coercion `K → v.adicCompletion K` preserves differences. -/
theorem coe_sub_adicCompletion {K : Type} [Field K] [NumberField K]
    (v : HeightOneSpectrum (𝓞 K)) (a b : K) :
    ((a - b : K) : v.adicCompletion K) = (↑a : v.adicCompletion K) - ↑b := by
  rw [show ((a - b : K) : v.adicCompletion K)
        = NumberField.FinitePlace.embedding v (a - b) from rfl,
    show ((a : K) : v.adicCompletion K) = NumberField.FinitePlace.embedding v a from rfl,
    show ((b : K) : v.adicCompletion K) = NumberField.FinitePlace.embedding v b from rfl,
    map_sub]

/-- The canonical coercion `K → v.adicCompletion K` preserves powers. -/
theorem coe_pow_adicCompletion {K : Type} [Field K] [NumberField K]
    (v : HeightOneSpectrum (𝓞 K)) (a : K) (n : ℕ) :
    ((a ^ n : K) : v.adicCompletion K) = (↑a : v.adicCompletion K) ^ n := by
  rw [show ((a ^ n : K) : v.adicCompletion K)
        = NumberField.FinitePlace.embedding v (a ^ n) from rfl,
    show ((a : K) : v.adicCompletion K) = NumberField.FinitePlace.embedding v a from rfl,
    map_pow]

/-! ### The local Frobenius is a global Frobenius -/

/-- **The element of the decomposition group corresponding to the local Frobenius at `q` is an
arithmetic Frobenius at `q`.**

Both conditions say that the automorphism acts on the residue field of `q` by the
`#(𝓞 K/Q)`-th power map; the dictionary between them is the canonical identification of the
decomposition group with the local Galois group
(`decompositionSubgroupMulEquivLocalGalois`), on which the action on the completion is the action
on `L` (`decompositionToAdicCompletion_coe`), together with the fact that the residue field
cardinality equals the inertia degree of the place (`residueCard`). -/
theorem isFrobAt_of_decompositionToLocalGalois_eq_frobeniusLocal
    (Q : HeightOneSpectrum (𝓞 K)) (q : HeightOneSpectrum (𝓞 L))
    [hq : q.asIdeal.LiesOver Q.asIdeal]
    (hunr : q.asIdeal.ramificationIdx (𝓞 K) = 1)
    (σ : Gal(L/K))
    (hσ : σ ∈ Commons.NumberTheory.NumberField.Completion.decompositionSubgroup (K := K) q)
    (h : Commons.NumberTheory.NumberField.Completion.decompositionToLocalGaloisFun Q q hq ⟨σ, hσ⟩
        = NK.LocalReciprocity.frobeniusLocal Q q hunr) :
    NK.Chebotarev.IsFrobAt q σ := by
  classical
  rw [NK.Chebotarev.isFrobAt_def]
  intro x
  have hN : Nat.card (𝓞 K ⧸ Ideal.under (𝓞 K) q.asIdeal) = Nat.card (𝓞 K ⧸ Q.asIdeal) := by
    rw [hq.over]
  rw [hN]
  rw [← IsDedekindDomain.HeightOneSpectrum.valuation_lt_one_iff_mem (R := 𝓞 L) (K := L) q]
  set Φloc : q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L :=
    Commons.NumberTheory.NumberField.Completion.decompositionToLocalGaloisFun Q q hq ⟨σ, hσ⟩
    with hΦloc
  have hspec : NK.LocalReciprocity.IsFrobeniusLocal Q q Φloc := by
    rw [h]
    exact NK.LocalReciprocity.frobeniusLocal_spec Q q hunr
  have hy : ((algebraMap (𝓞 L) L x : L) : q.adicCompletion L) ∈ q.adicCompletionIntegers L := by
    rw [IsDedekindDomain.HeightOneSpectrum.mem_adicCompletionIntegers]
    rw [IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
    exact IsDedekindDomain.HeightOneSpectrum.valuation_le_one q x
  have hval := hspec ⟨((algebraMap (𝓞 L) L x : L) : q.adicCompletion L), hy⟩
  have hcoe : Φloc ((algebraMap (𝓞 L) L x : L) : q.adicCompletion L)
      = ((σ (algebraMap (𝓞 L) L x) : L) : q.adicCompletion L) := by
    rw [hΦloc, Commons.NumberTheory.NumberField.Completion.decompositionToLocalGaloisFun_apply]
    exact Commons.NumberTheory.NumberField.Completion.decompositionToAdicCompletion_coe q ⟨σ, hσ⟩
      (algebraMap (𝓞 L) L x)
  rw [hcoe] at hval
  have hcard : NK.LocalReciprocity.residueCard K Q = Nat.card (𝓞 K ⧸ Q.asIdeal) :=
    Commons.NumberTheory.NumberField.Completion.natCard_residueField_adicCompletionIntegers_eq_natCard_quotient
      K Q
  have hvalL : q.valuation L (σ (algebraMap (𝓞 L) L x)
        - (algebraMap (𝓞 L) L x) ^ NK.LocalReciprocity.residueCard K Q) < 1 := by
    rw [← IsDedekindDomain.HeightOneSpectrum.valuedAdicCompletion_eq_valuation'
      (R := 𝓞 L) (K := L) q]
    rw [coe_sub_adicCompletion, coe_pow_adicCompletion]
    exact hval
  have hgal : (algebraMap (𝓞 L) L ((galRestrict (𝓞 K) K L (𝓞 L) σ) x))
      = σ (algebraMap (𝓞 L) L x) := algebraMap_galRestrict_apply (𝓞 K) σ x
  have harg : (algebraMap (𝓞 L) L ((galRestrict (𝓞 K) K L (𝓞 L) σ) x
        - x ^ Nat.card (𝓞 K ⧸ Q.asIdeal)))
      = σ (algebraMap (𝓞 L) L x)
        - (algebraMap (𝓞 L) L x) ^ NK.LocalReciprocity.residueCard K Q := by
    rw [map_sub, map_pow, hgal, hcard]
  change (HeightOneSpectrum.valuation L q)
    (algebraMap (𝓞 L) L ((galRestrict (𝓞 K) K L (𝓞 L) σ) x
      - x ^ Nat.card (𝓞 K ⧸ Q.asIdeal))) < 1
  rw [harg]
  exact hvalL

/-! ### The kernel of the local norm at a single place is the local norm subgroup -/

/-- The range of the local norm map at a single place `q | Q` is the local norm subgroup
(the supremum over all places above `Q`, a family of equal subgroups). -/
theorem range_localNormFinite_eq_localNormSubgroup
    (Q : HeightOneSpectrum (𝓞 K)) (q : HeightOneSpectrum (𝓞 L))
    (hq : q.asIdeal.LiesOver Q.asIdeal) :
    MonoidHom.range (Place.localNormFinite q Q hq) =
      localNormSubgroup (K := K) (L := L) (Place.ofFinite Q) := by
  rw [localNormSubgroup_ofFinite]
  refine le_antisymm (le_iSup (fun q' : {q' : HeightOneSpectrum (𝓞 L) //
      q'.asIdeal.LiesOver Q.asIdeal} => MonoidHom.range (Place.localNormFinite q'.1 Q q'.2))
    ⟨q, hq⟩) (iSup_le fun q' => ?_)
  rw [range_localNormFinite_eq_of_liesOver Q q' q q'.2 hq]

/-- The kernel of the composite of a local map `K_Qˣ →* Gal(L_q/K_Q)` with the identification of
the local Galois group with the decomposition group and the inclusion into `Gal(L/K)` is the
kernel of the local map, hence the local norm subgroup. -/
theorem ker_comp_decompositionSubgroupMulEquivLocalGalois
    (Q : HeightOneSpectrum (𝓞 K)) (q : HeightOneSpectrum (𝓞 L))
    [hq : q.asIdeal.LiesOver Q.asIdeal]
    (Ψ : (Q.adicCompletion K)ˣ →* (q.adicCompletion L ≃ₐ[Q.adicCompletion K] q.adicCompletion L))
    (hker : MonoidHom.ker Ψ = MonoidHom.range (Place.localNormFinite q Q hq)) :
    MonoidHom.ker ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroup
          (K := K) q).subtype.comp
        ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
          Q q hq).symm.toMonoidHom.comp Ψ))
      = localNormSubgroup (K := K) (L := L) (Place.ofFinite Q) := by
  rw [← range_localNormFinite_eq_localNormSubgroup Q q hq, ← hker]
  ext x
  constructor
  · intro hx
    change (((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
      Q q hq).symm (Ψ x)).1) = 1 at hx
    have h1 : (Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
          Q q hq).symm (Ψ x)
        = (Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
            Q q hq).symm 1 := by
      rw [map_one]
      exact Subtype.ext hx
    exact (Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
      Q q hq).symm.injective h1
  · intro hx
    change (((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
      Q q hq).symm (Ψ x)).1) = 1
    rw [hx, map_one, Subgroup.coe_one]

/-! ### The local map -/

theorem exists_localMap_ofFinite {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (hcyc : IsCyclic (L ≃ₐ[K] L))
    (Q : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K)) :
    ∃ F : (Q.adicCompletion K)ˣ →* (L ≃ₐ[K] L),
      MonoidHom.ker F = NK.CFTLib.IdeleHasse.localNormSubgroup (K := K) (L := L)
        (NK.GlobalCFT.Place.ofFinite Q) ∧
      (NK.HeckeL.IsUnramifiedIn (K := K) (L := L) Q →
        F (NK.GlobalCFT.IdeleClassGroup.unifUnit K Q) =
          NK.Chebotarev.frobAtPrime (K := K) (L := L) Q) := by
  classical
  haveI := hcyc
  have hcomm : ∀ a b : L ≃ₐ[K] L, a * b = b * a :=
    fun a b => IsCyclic.isMulCommutative.is_comm.comm a b
  obtain ⟨q, hq⟩ := NK.Chebotarev.exists_primeIdeal_liesOver (K := K) (L := L) Q
  haveI : q.asIdeal.LiesOver Q.asIdeal := hq
  by_cases hunr : NK.HeckeL.IsUnramifiedIn (K := K) (L := L) Q
  · have hu : q.asIdeal.ramificationIdx (𝓞 K) = 1 := hunr q hq
    refine ⟨(Commons.NumberTheory.NumberField.Completion.decompositionSubgroup
        (K := K) q).subtype.comp
      ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
          Q q hq).symm.toMonoidHom.comp
        (NK.LocalReciprocity.artinUnramified Q q hu)), ?_, ?_⟩
    · refine ker_comp_decompositionSubgroupMulEquivLocalGalois Q q _ ?_
      rw [NK.LocalReciprocity.ker_artinUnramified Q q hu]
      rfl
    · intro _
      have hval : NK.LocalReciprocity.artinUnramified Q q hu
          (NK.GlobalCFT.IdeleClassGroup.unifUnit K Q) =
          NK.LocalReciprocity.frobeniusLocal Q q hu := by
        rw [NK.LocalReciprocity.artinUnramified_apply, NK.LocalReciprocity.valExponent_apply,
          NK.GlobalCFT.IdeleClassGroup.valued_unifUnit, WithZero.log_exp]
        simp
      have hψ : Commons.NumberTheory.NumberField.Completion.decompositionToLocalGaloisFun Q q hq
          ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
            Q q hq).symm (NK.LocalReciprocity.frobeniusLocal Q q hu))
          = NK.LocalReciprocity.frobeniusLocal Q q hu := by
        have hcoee :=
          Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois_coe
            Q q hq ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
              Q q hq).symm (NK.LocalReciprocity.frobeniusLocal Q q hu))
        rw [MulEquiv.apply_symm_apply] at hcoee
        exact hcoee.symm
      have hfrob : NK.Chebotarev.IsFrobAt q
          ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
            Q q hq).symm (NK.LocalReciprocity.frobeniusLocal Q q hu)).1 :=
        isFrobAt_of_decompositionToLocalGalois_eq_frobeniusLocal Q q hu _ _ hψ
      have hfp : NK.Chebotarev.frobAtPrime (K := K) (L := L) Q
          = ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
              Q q hq).symm (NK.LocalReciprocity.frobeniusLocal Q q hu)).1 :=
        (NK.Chebotarev.isFrobAtPrime_iff_frobAtPrime_eq hcomm Q hunr _).mp ⟨q, hq, hfrob⟩
      rw [hfp]
      show ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
          Q q hq).symm (NK.LocalReciprocity.artinUnramified Q q hu
            (NK.GlobalCFT.IdeleClassGroup.unifUnit K Q))).1
        = ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
            Q q hq).symm (NK.LocalReciprocity.frobeniusLocal Q q hu)).1
      rw [hval]
  · obtain ⟨Φ, _, hΦker⟩ :=
      Commons.NumberTheory.NumberField.Completion.exists_mulEquiv_artinMap_of_commute hcomm Q q hq
    refine ⟨(Commons.NumberTheory.NumberField.Completion.decompositionSubgroup
        (K := K) q).subtype.comp
      ((Commons.NumberTheory.NumberField.Completion.decompositionSubgroupMulEquivLocalGalois
          Q q hq).symm.toMonoidHom.comp Φ), ?_, ?_⟩
    · refine ker_comp_decompositionSubgroupMulEquivLocalGalois Q q Φ ?_
      rw [hΦker]
      rfl
    · intro hbad
      exact absurd hbad hunr

end NK.CFTLib.IdeleHasse
