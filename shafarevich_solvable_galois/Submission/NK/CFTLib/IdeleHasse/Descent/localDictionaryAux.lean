/-!
# Auxiliary lemmas for the localisation dictionary at a finite place

These are the local-field and group-theoretic auxiliaries used by the localisation dictionary; they
are copies of lemmas in `NK.CFTLib.IdeleHasse.Crux.locUnits_cyclicClass_ofFinite` (whose module is
being edited by another agent), with their statements unchanged, so that the explicit-cocycle
dictionary can be built independently.
-/

open scoped NumberField
open NumberField IsDedekindDomain
open NK.GlobalCFT CategoryTheory

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option backward.isDefEq.respectTransparency false

namespace NK.CFTLib.IdeleHasse.Descent

/-- The `algebraMap` of a number field into one of its `q`-adic completions is the coercion. -/
lemma algebraMap_adicCompletion_eq_coe {L : Type} [Field L] [NumberField L]
    (q : HeightOneSpectrum (𝓞 L)) (x : L) :
    algebraMap L (q.adicCompletion L) x = (x : q.adicCompletion L) := by
  rw [IsDedekindDomain.HeightOneSpectrum.algebraMap_adicCompletion (R := 𝓞 L) (K := L)
    (S := L) (v := q)]
  rfl

variable {K F : Type} [Field K] [NumberField K] [Field F] [NumberField F] [Algebra K F]
  [FiniteDimensional K F] [IsGalois K F]

/-- **The compatibility of the algebra maps**: the `q`-component of the image of `y : Kˣ` in the
units of `F` is the image of the local image of `y` at `Q` under the local algebra map
`K_Q → F_q`. -/
lemma unitsToLocalUnitsHom_algebraMap (Q : HeightOneSpectrum (𝓞 K))
    (q : HeightOneSpectrum (𝓞 F)) (hq : q.asIdeal.LiesOver Q.asIdeal) (y : Kˣ) :
    NK.HassePrinciple.unitsToLocalUnitsHom (Place.ofFinite q)
        (Units.map (algebraMap K F).toMonoidHom y)
      = Units.map (Place.localAlgebraMapFinite q Q hq).toMonoidHom
          (localImageAt (K := K) (Place.ofFinite Q) y) := by
  apply Units.ext
  simp only [NK.HassePrinciple.unitsToLocalUnitsHom, Place.localAlgebraMapFinite,
    localImageAt, Units.coe_map]
  change algebraMap F (q.adicCompletion F) (algebraMap K F (y : K)) =
    Commons.RingTheory.Henselian.adicCompletionMap Q q hq (algebraMap K (Q.adicCompletion K) (y : K))
  rw [algebraMap_adicCompletion_eq_coe q (algebraMap K F (y : K))]
  rw [show algebraMap K (Q.adicCompletion K) (y : K) = ((y : K) : Q.adicCompletion K) from
    algebraMap_adicCompletion_eq_coe Q (y : K)]
  rw [Commons.RingTheory.Henselian.adicCompletionMap_apply]

/-- An element of a subgroup `S` whose underlying element lies in `⟨a⟩` lies in the subgroup
generated by any lift `γ` of `a`. -/
lemma mem_zpowers_of_coe_mem_zpowers {S : Subgroup (F ≃ₐ[K] F)} {γ : ↥S} {a : F ≃ₐ[K] F}
    (hγ : (γ : F ≃ₐ[K] F) = a) {y : ↥S} (hy : (y : F ≃ₐ[K] F) ∈ Subgroup.zpowers a) :
    y ∈ Subgroup.zpowers γ := by
  obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp hy
  refine Subgroup.mem_zpowers_iff.mpr ⟨n, ?_⟩
  apply Subtype.ext
  rw [Subgroup.coe_zpow, hγ, hn]

/-- Units of an injective monoid hom form an injective map. -/
lemma injective_units_map {A B : Type*} [Monoid A] [Monoid B] (f : A →* B)
    (hf : Function.Injective f) : Function.Injective (Units.map f) := by
  intro u v huv
  refine Units.ext (hf ?_)
  exact congrArg (fun w : Bˣ => (w : B)) huv

/-- The local norm subgroup at a finite place is the range of the local norm map for any fixed
place above it. -/
lemma localNormSubgroup_ofFinite_eq_range (Q : HeightOneSpectrum (𝓞 K))
    (q : HeightOneSpectrum (𝓞 F)) (hq : q.asIdeal.LiesOver Q.asIdeal) :
    localNormSubgroup (K := K) (L := F) (Place.ofFinite Q)
      = MonoidHom.range (Place.localNormFinite q Q hq) := by
  rw [localNormSubgroup_ofFinite]
  refine le_antisymm (iSup_le fun i => ?_) ?_
  · rw [range_localNormFinite_eq_of_liesOver Q i.1 q i.2 hq]
  · intro x hx
    exact Subgroup.mem_iSup_of_mem ⟨q, hq⟩ hx

/-- The range of the norm endomorphism of the local units representation, in the form in which it
occurs after the cyclic-class criterion. -/
lemma mem_range_norm_localUnitsRep_apply (Q : HeightOneSpectrum (𝓞 K))
    (q : HeightOneSpectrum (𝓞 F)) (hq : q.asIdeal.LiesOver Q.asIdeal)
    [Fintype ↥(MulAction.stabilizer (F ≃ₐ[K] F) (Place.ofFinite q))]
    (u : (Place.localField F (Place.ofFinite q))ˣ) :
    (Additive.ofMul u ∈ LinearMap.range (Rep.Hom.hom (Rep.norm
        (NK.HassePrinciple.localUnitsRep K F (Place.ofFinite q)))).toLinearMap)
      ↔ ∃ z, Units.map (Place.localAlgebraMapFinite q Q hq).toMonoidHom
          (Place.localNormFinite q Q hq z) = u :=
  NK.CFTLib.IdeleHasse.Crux.mem_range_norm_localUnitsRep_ofFinite (K := K) (N := F) q Q hq u

end NK.CFTLib.IdeleHasse.Descent
