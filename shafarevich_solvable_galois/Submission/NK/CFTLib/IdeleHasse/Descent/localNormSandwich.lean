/-!
# The index sandwich for the base change of a local norm group

Let `F ⊆ F' ⊆ E'` and `F ⊆ C ⊆ E'` be towers of finite-dimensional fields.  Write
`N' = N_{F'/F}F'ˣ ≤ Fˣ`, `N_C = N_{C/F}Cˣ ≤ Fˣ` and `N'' = N_{E'/F'}E'ˣ ≤ F'ˣ`.

The lemma `normGroup_index_sandwich` shows that **every element of `Fˣ` is a norm from `E'` over
`F'`**, from the two structural inputs

* `[Fˣ : N' ⊔ N_C] = f` (the two norm groups together fill the subgroup of `Fˣ` generated by the
  `f`-th powers of a uniformiser and the units), and
* `[E' : F'] = [C : F] / f` (the degree identity: `E'/F'` is as big as the ramification index of
  `C/F`),

together with the norm index theorems `[Fˣ : N_C] = [C : F]`, `[F'ˣ : N''] = [E' : F']` and the
divisibility `[C : F] ∣ [F' : F]`.

The argument is the "sandwich": with `H = N''` and `H' = (N')⁻¹(N_C)` one has `H ≤ H'` by
transitivity of norms, `Fˣ ≤ H'` because `N'(a) = a^{[F':F]}` and `[Fˣ : N_C] ∣ [F':F]`, and the two
groups have the same index `[F'ˣ : H] = [F'ˣ : H'] = [C:F]/f = [E':F']`; hence `H = H'` and
`Fˣ ≤ H`.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false

noncomputable section

namespace NK.CFTLib.IdeleHasse

open NK.LocalReciprocity

variable {F F' C E' : Type}

/-- **The index sandwich.** -/
theorem normGroup_index_sandwich
    [Field F] [Field F'] [Field C] [Field E']
    [Algebra F F'] [Algebra F C] [Algebra F' E'] [Algebra C E'] [Algebra F E']
    [IsScalarTower F F' E'] [IsScalarTower F C E']
    [FiniteDimensional F F'] [FiniteDimensional F C] [FiniteDimensional F' E']
    (f : ℕ) (hf : 0 < f)
    (hidxE' : (normGroup F' E').index = Module.finrank F' E')
    (hidxN : (normGroup F C).index = Module.finrank F C)
    (hP : (normGroup F F' ⊔ normGroup F C).index = f)
    (hdeg : Module.finrank F' E' = Module.finrank F C / f)
    (hdvd : Module.finrank F C ∣ Module.finrank F F') :
    ∀ a : Fˣ, Units.map (algebraMap F F').toMonoidHom a ∈ normGroup F' E' := by
  classical
  intro a
  -- ## Step 1: `H ≤ H'`
  have hle : normGroup F' E' ≤
      (normGroup F C).comap (Units.map (Algebra.norm F : F' →* F)) := by
    intro x hx
    rw [Subgroup.mem_comap]
    have hmap : (normGroup F' E').map (Units.map (Algebra.norm F : F' →* F)) =
        normGroup F E' := (normGroup_trans (F := F) (E := F') (M := E')).symm
    have hmono : normGroup F E' ≤ normGroup F C := normGroup_le_of_tower
    exact hmono (hmap ▸ Subgroup.mem_map_of_mem _ hx)
  -- ## Step 2: `Fˣ ⊆ H'`
  have hFsub : ∀ b : Fˣ,
      Units.map (algebraMap F F').toMonoidHom b ∈
        (normGroup F C).comap (Units.map (Algebra.norm F : F' →* F)) := by
    intro b
    rw [Subgroup.mem_comap]
    have hcoe : (Units.map (Algebra.norm F : F' →* F)
        (Units.map (algebraMap F F').toMonoidHom b) : F)
        = (b : F) ^ Module.finrank F F' := by
      rw [Units.coe_map, Units.coe_map]
      exact Algebra.norm_algebraMap (R := F) (S := F') (b : F)
    have h1 : (Units.map (Algebra.norm F : F' →* F)
        (Units.map (algebraMap F F').toMonoidHom b)) = b ^ Module.finrank F F' :=
      Units.ext hcoe
    rw [h1]
    have hpow : b ^ (normGroup F C).index ∈ normGroup F C := Subgroup.pow_index_mem _ _
    rw [hidxN] at hpow
    obtain ⟨k, hk⟩ := hdvd
    rw [hk]
    have h2 : b ^ (Module.finrank F C * k) = (b ^ Module.finrank F C) ^ k :=
      pow_mul b (Module.finrank F C) k
    rw [h2]
    exact Subgroup.pow_mem _ hpow k
  -- ## Step 3: the index of `H'`
  have hrelidx : (normGroup F C).relIndex (normGroup F F') * f = Module.finrank F C := by
    have h2 := Subgroup.relIndex_mul_index
      (H := normGroup F C) (K := normGroup F C ⊔ normGroup F F') le_sup_left
    rw [hidxN] at h2
    have h3 : (normGroup F C ⊔ normGroup F F').index = f := by
      rw [sup_comm]; exact hP
    rw [h3] at h2
    simpa only [Subgroup.relIndex_sup_left] using h2
  have hH'ind : ((normGroup F C).comap (Units.map (Algebra.norm F : F' →* F))).index =
      Module.finrank F C / f := by
    rw [Subgroup.index_comap]
    have hrange : (Units.map (Algebra.norm F : F' →* F)).range = normGroup F F' := rfl
    rw [hrange, ← hrelidx, Nat.mul_div_cancel _ hf]
  -- ## Step 4: the two indices agree
  have hIdxEq : (normGroup F' E').index =
      ((normGroup F C).comap (Units.map (Algebra.norm F : F' →* F))).index := by
    rw [hidxE', hH'ind]
    exact hdeg
  have hpos : 0 < Module.finrank F' E' := Module.finrank_pos
  -- ## Step 5: hence `H = H'`
  have hEq : normGroup F' E' =
      (normGroup F C).comap (Units.map (Algebra.norm F : F' →* F)) := by
    refine le_antisymm hle ?_
    have hrel := Subgroup.relIndex_mul_index hle
    have hidx2 : Module.finrank F' E' =
        ((normGroup F C).comap (Units.map (Algebra.norm F : F' →* F))).index :=
      hidxE'.symm.trans hIdxEq
    have hmul : (normGroup F' E').relIndex
        ((normGroup F C).comap (Units.map (Algebra.norm F : F' →* F))) *
        Module.finrank F' E' = 1 * Module.finrank F' E' := by
      rw [hidx2, hrel, one_mul]
      exact hIdxEq
    have h1 : (normGroup F' E').relIndex
        ((normGroup F C).comap (Units.map (Algebra.norm F : F' →* F))) = 1 :=
      Nat.eq_of_mul_eq_mul_right hpos hmul
    exact Subgroup.relIndex_eq_one.mp h1
  rw [hEq]
  exact hFsub a

end NK.CFTLib.IdeleHasse
