namespace NK.CFTLib

/-!
# Fixed points and the norm for a prime-order group action

For a finite group `Q` of prime order `p` acting on a commutative group `A`, and a
`Q`-stable subgroup `N ≤ A` containing all "coboundaries" `σ • a * a⁻¹`
(`hact`), the kernel condition `hker` on the norm map forces

  `A = A^Q · N`,

i.e. every element of `A` lies in the subgroup generated by the fixed points of
`Q` and by `N`.

The proof is the standard "Hilbert 90 for a cyclic prime order group" argument.
It does *not* use the full Hilbert 90 theorem; instead it uses the norm
`Nm x = ∏ σ, σ • x` and the map `δ x = g • x * x⁻¹` for a generator `g` of `Q`:

* `Nm` lands in the fixed points, so `δ (Nm a) = 1`;
* `δ` is a homomorphism and commutes with the action of `g`, whence
  `Nm (δ a) = δ (Nm a) = 1`;
* since `δ a ∈ N`, the hypothesis `hker` applies and gives
  `δ a ∈ closure {σ • m * m⁻¹}`;
* the latter closure equals `δ N` (here cyclicity of `Q` is used), so there is
  `n ∈ N` with `δ n = δ a`; then `a * n⁻¹` is fixed by all of `Q` and
  `a = (a * n⁻¹) * n`.
-/

private def delta {Q A : Type} [Group Q] [CommGroup A] [MulDistribMulAction Q A] (g : Q) : A →* A where
  toFun x := g • x * x⁻¹
  map_one' := by simp
  map_mul' x y := by
    rw [smul_mul', mul_inv]
    ac_rfl

private lemma prod_mulLeft_eq {Q A : Type} [Group Q] [Fintype Q] [CommMonoid A] (g : Q) (f : Q → A) :
    (∏ σ : Q, f (g * σ)) = ∏ σ : Q, f σ :=
  Finset.prod_bijective (fun σ : Q => g * σ) (Equiv.mulLeft g).bijective (fun i => by simp) (fun i _ => rfl)

private lemma pow_fixed {Q A : Type} [Group Q] [MulAction Q A] (g : Q) :
    ∀ (k : ℕ) (y : A), g • y = y → g ^ k • y = y := by
  intro k
  induction k with
  | zero => intro y _; simp
  | succ k ih =>
    intro y hy
    rw [pow_succ', mul_smul, ih y hy, hy]

private lemma mul_inv_mul_inv_eq {G : Type} [CommGroup G] (a b c : G) :
    (a * b⁻¹) * (c * a⁻¹) = c * b⁻¹ := by
  have h : (a * b⁻¹) * (c * a⁻¹) = (a * a⁻¹) * (b⁻¹ * c) := by ac_rfl
  rw [h, mul_inv_cancel, one_mul, mul_comm]

theorem mem_sup_fixedPoints_of_prime_card {p : ℕ} (hp : p.Prime) {Q A : Type} [Group Q] [Fintype Q] [CommGroup A] [MulDistribMulAction Q A] (hQ : Nat.card Q = p) (N : Subgroup A) (hact : ∀ (σ : Q) (a : A), σ • a * a⁻¹ ∈ N) (hker : ∀ n : N, (∏ σ : Q, σ • (n : A)) = 1 → (n : A) ∈ Subgroup.closure {x : A | ∃ σ : Q, ∃ m : N, x = σ • (m : A) * (m : A)⁻¹}) (a : A) : a ∈ Subgroup.closure {x : A | ∀ σ : Q, σ • x = x} ⊔ N := by
  obtain ⟨g, hg1⟩ : ∃ g : Q, g ≠ 1 := by
    have hnt : Nontrivial Q := by
      refine Fintype.one_lt_card_iff_nontrivial.mp ?_
      rw [← Nat.card_eq_fintype_card, hQ]
      exact hp.one_lt
    exact exists_ne 1
  -- every element of `Q` is a natural power of the chosen generator `g`
  have hpow : ∀ σ : Q, ∃ k : ℕ, g ^ k = σ := by
    have horder : orderOf g = p := by
      have hdvd : orderOf g ∣ p := by rw [← hQ]; exact orderOf_dvd_natCard g
      rcases hp.eq_one_or_self_of_dvd (orderOf g) hdvd with h | h
      · exact absurd (orderOf_eq_one_iff.mp h) hg1
      · exact h
    have hgen : Subgroup.zpowers g = ⊤ := by
      apply Subgroup.eq_top_of_card_eq
      rw [Nat.card_zpowers, horder, hQ]
    intro σ
    have hσ : σ ∈ Subgroup.zpowers g := by rw [hgen]; trivial
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp hσ
    have hgp : g ^ p = 1 := by rw [← hQ]; exact pow_card_eq_one'
    have hpz : (p : ℤ) ≠ 0 := by exact_mod_cast hp.ne_zero
    have hmod : 0 ≤ k % (p : ℤ) := Int.emod_nonneg k hpz
    refine ⟨(k % (p : ℤ)).toNat, ?_⟩
    calc g ^ (k % (p : ℤ)).toNat
        = g ^ ((k % (p : ℤ)).toNat : ℤ) := (zpow_natCast g _).symm
      _ = g ^ (k % (p : ℤ)) := by rw [Int.toNat_of_nonneg hmod]
      _ = g ^ k := (zpow_eq_zpow_emod' k hgp).symm
      _ = σ := hk
  -- `N` is stable under the action of `Q`
  have hNstable : ∀ (σ : Q) (m : A), m ∈ N → σ • m ∈ N := by
    intro σ m hm
    have h := hact σ m
    have heq : σ • m = (σ • m * m⁻¹) * m := by group
    rw [heq]
    exact N.mul_mem h hm
  -- `δ x = g • x * x⁻¹` commutes with the action of `g`, hence of every power `g ^ k`
  have hδ_smul_g : ∀ z : A, delta g (g • z) = g • delta g z := by
    intro z
    change g • (g • z) * (g • z)⁻¹ = g • (g • z * z⁻¹)
    rw [smul_mul', smul_inv']
  have hδ_pow : ∀ (k : ℕ) (y : A), delta g (g ^ k • y) = g ^ k • delta g y := by
    intro k
    induction k with
    | zero => intro y; simp
    | succ k ih =>
      intro y
      calc delta g (g ^ (k + 1) • y)
          = delta g (g • (g ^ k • y)) := by rw [pow_succ', mul_smul]
        _ = g • delta g (g ^ k • y) := hδ_smul_g (g ^ k • y)
        _ = g • (g ^ k • delta g y) := by rw [ih]
        _ = g ^ (k + 1) • delta g y := by rw [pow_succ', mul_smul]
  -- the norm `Nm a = ∏ σ, σ • a` is fixed by `g`
  have hNm_fixed : g • (∏ σ : Q, σ • a) = ∏ σ : Q, σ • a := by
    have hA : g • (∏ σ : Q, σ • a) = ∏ σ : Q, g • (σ • a) :=
      map_prod (MulDistribMulAction.toMonoidEnd Q A g) (fun σ => σ • a) Finset.univ
    rw [hA]
    have hB : (∏ σ : Q, g • (σ • a)) = ∏ σ : Q, (g * σ) • a :=
      Finset.prod_congr rfl (fun σ _ => (mul_smul g σ a).symm)
    rw [hB]
    exact prod_mulLeft_eq g (fun σ => σ • a)
  have hδaN : delta g a ∈ N := hact g a
  -- the norm of `δ a` is `1`
  have hnorm : (∏ σ : Q, σ • delta g a) = 1 := by
    have h2a : delta g (∏ σ : Q, σ • a) = ∏ σ : Q, delta g (σ • a) :=
      map_prod (delta g) (fun σ => σ • a) Finset.univ
    have h2b : (∏ σ : Q, delta g (σ • a)) = ∏ σ : Q, σ • delta g a := by
      refine Finset.prod_congr rfl (fun σ _ => ?_)
      obtain ⟨k, hk⟩ := hpow σ
      rw [← hk]
      exact hδ_pow k a
    rw [← h2b, ← h2a]
    change g • (∏ σ : Q, σ • a) * (∏ σ : Q, σ • a)⁻¹ = 1
    rw [hNm_fixed]
    simp
  -- the "telescoping" identity computing `δ` of a partial norm
  have htelescope : ∀ (k : ℕ) (m : A),
      delta g (∏ i ∈ Finset.range k, g ^ i • m) = g ^ k • m * m⁻¹ := by
    intro k
    induction k with
    | zero => intro m; simp
    | succ k ih =>
      intro m
      rw [Finset.prod_range_succ, map_mul (delta g), ih]
      have h1 : delta g (g ^ k • m) = g ^ (k+1) • m * (g ^ k • m)⁻¹ := by
        change g • (g ^ k • m) * (g ^ k • m)⁻¹ = g ^ (k+1) • m * (g ^ k • m)⁻¹
        rw [pow_succ', mul_smul]
      rw [h1]
      exact mul_inv_mul_inv_eq (g ^ k • m) m (g ^ (k+1) • m)
  -- the closure of the coboundaries is contained in `δ N`
  have hDle : Subgroup.closure {x : A | ∃ σ : Q, ∃ m : N, x = σ • (m : A) * (m : A)⁻¹}
      ≤ N.map (delta g) := by
    rw [Subgroup.closure_le (N.map (delta g))]
    rintro x ⟨σ, m, rfl⟩
    obtain ⟨k, hk⟩ := hpow σ
    rw [← hk]
    refine Subgroup.mem_map.mpr ⟨∏ i ∈ Finset.range k, g ^ i • (m : A), ?_, htelescope k (m : A)⟩
    exact Subgroup.prod_mem N (fun i _ => hNstable (g ^ i) (m : A) m.2)
  have hδa_closure : delta g a ∈ Subgroup.closure
      {x : A | ∃ σ : Q, ∃ m : N, x = σ • (m : A) * (m : A)⁻¹} :=
    hker ⟨delta g a, hδaN⟩ hnorm
  obtain ⟨n, hnN, hn_eq⟩ := Subgroup.mem_map.mp (hDle hδa_closure)
  -- `a * n⁻¹` is fixed by `g`, hence by all of `Q`
  have hgy : g • (a * n⁻¹) = a * n⁻¹ := by
    have h : delta g (a * n⁻¹) = 1 := by
      rw [map_mul, map_inv, hn_eq, mul_inv_cancel]
    exact mul_inv_eq_one.mp h
  have ha_eq : a = (a * n⁻¹) * n := by group
  rw [ha_eq]
  refine Subgroup.mul_mem _ (Subgroup.mem_sup_left ?_) (Subgroup.mem_sup_right hnN)
  exact Subgroup.subset_closure (fun σ => by
    obtain ⟨k, hk⟩ := hpow σ
    rw [← hk]
    exact pow_fixed g k (a * n⁻¹) hgy)

end NK.CFTLib
