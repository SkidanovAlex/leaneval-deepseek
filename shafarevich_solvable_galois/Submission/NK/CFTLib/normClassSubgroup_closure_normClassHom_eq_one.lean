/-!
# Norm-one elements of the norm subgroup are generated by the coboundaries

Let `K ⊆ M ⊆ L` be number fields with `M/K` and `L/M` finite Galois and `Gal(L/K)` cyclic.  For
`n ∈ N_{L/M}C_L ≤ C_M` with `N_{M/K}(n) = 1`, this file proves that `n` lies in the subgroup of
`C_M` generated by the "coboundaries" `σ • m * m⁻¹` (`σ ∈ Gal(M/K)`, `m ∈ N_{L/M}C_L`).

Equivalently (and this is how it is proved), the `Ĥ⁻¹` of the `Gal(M/K)`-module `N_{L/M}C_L`
vanishes.  The proof uses the vanishing of `H¹(Gal(L/K), C_L)` (the second inequality) together
with the periodicity of the cohomology of a cyclic group, which identifies `Ĥ⁻¹` with `H¹`: an
element `y ∈ C_L` with `N_{L/K}(y) = 1` is therefore a coboundary `y = γ • z * z⁻¹`, and applying
the (Galois-equivariant) norm `N_{L/M}` gives the result.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.style.haveILetI false

open scoped NumberField RestrictedProduct IsMulCommutative
open NumberField IsDedekindDomain
open NK.GlobalCFT CategoryTheory

noncomputable section

namespace NK.CFTLib

section Compat

variable {K M L : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Field L]
  [NumberField L] [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]

/-- The action of `Gal(L/M)` on the idèles of `L` agrees with the action of the underlying
`K`-algebra automorphisms (restriction of scalars). -/
theorem idele_smul_restrictScalars (h : L ≃ₐ[M] L) (x : Idele L) :
    h • x = (h.restrictScalars K) • x := by
  ext v
  rw [Idele.smul_apply, Idele.smul_apply]
  congr 1

/-- The action of `Gal(L/M)` on the idèle class group of `L` agrees with the action of the
underlying `K`-algebra automorphisms (restriction of scalars). -/
theorem ideleClassGroup_smul_restrictScalars (h : L ≃ₐ[M] L) (q : IdeleClassGroup L) :
    h • q = (h.restrictScalars K) • q := by
  obtain ⟨x, rfl⟩ := IdeleClassGroup.mk_surjective L q
  rw [IdeleClassGroup.smul_mk (K := M) (L := L) h x,
    IdeleClassGroup.smul_mk (K := K) (L := L) (h.restrictScalars K) x]
  congr 1

end Compat

section NormEquiv

variable {K M L : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Field L]
  [NumberField L] [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L]
  [FiniteDimensional K M] [FiniteDimensional M L] [FiniteDimensional K L]
  [IsGalois K M] [IsGalois M L] [IsCyclic (L ≃ₐ[K] L)]

/-- **The norm `N_{L/M}` is Galois-equivariant.**  For `γ ∈ Gal(L/K)` and `q ∈ C_L` one has
`N_{L/M}(γ • q) = (γ|_M) • N_{L/M}(q)`.

This is the `M ⊆ L` instance of the general fact that the norm is a morphism of Galois modules;
it is proved here from the `H⁰`-computation `ψ(N_{L/M}(q)) = ∏_{σ ∈ Gal(L/M)} σ • q` (where
`ψ : C_M →* C_L` is the canonical inclusion) and the corresponding equivariance of `ψ`. -/
theorem normClassHom_smul (γ : L ≃ₐ[K] L) (q : IdeleClassGroup L) :
    IdeleClassGroup.normClassHom M L (γ • q) =
      (AlgEquiv.restrictNormalHom M γ) • IdeleClassGroup.normClassHom M L q := by
  classical
  haveI hN : Normal K M := IsGalois.to_normal
  letI : CommGroup (L ≃ₐ[K] L) := IsCyclic.commGroup
  obtain ⟨u, hu⟩ : ∃ u : Place L → Place M, ∀ w, Place.LiesOver w (u w) :=
    ⟨fun w => Classical.choose (Inclusion.globalCFT_exists_placeUnder (K := M) (L := L) w),
      fun w => Classical.choose_spec (Inclusion.globalCFT_exists_placeUnder (K := M) (L := L) w)⟩
  obtain ⟨φ, hφ⟩ := Inclusion.globalCFT_ideleInclusion_exists (K := M) (L := L) u hu
  obtain ⟨ψ, hψ⟩ :=
    Inclusion.globalCFT_ideleClassGroup_inclusion_exists (K := M) (L := L) u hu φ hφ
  have hψinj : Function.Injective ψ :=
    Inclusion.globalCFT_ideleClassGroup_inclusion_injective u hu φ hφ ψ hψ
  have hψnorm : ∀ q : IdeleClassGroup L,
      ψ (IdeleClassGroup.normClassHom M L q) = ∏ σ : L ≃ₐ[M] L, σ • q :=
    fun q => globalCFT_normClassHom_eq_prod_smul u hu φ hφ ψ hψ q
  have hψsmul : ∀ (σ : L ≃ₐ[K] L) (q : IdeleClassGroup M),
      ψ (AlgEquiv.restrictNormalHom M σ • q) = σ • ψ q := by
    intro σ q
    obtain ⟨x, rfl⟩ := IdeleClassGroup.mk_surjective M q
    rw [IdeleClassGroup.smul_mk, hψ ((AlgEquiv.restrictNormalHom M σ) • x), hψ x,
      IdeleClassGroup.smul_mk,
      NK.HassePrinciple.ideleInclusion_smul_of_restrict u hu φ hφ σ x]
  apply hψinj
  rw [hψnorm (γ • q), hψsmul γ (IdeleClassGroup.normClassHom M L q), hψnorm q,
    Finset.smul_prod']
  refine Finset.prod_congr rfl (fun σ _ => ?_)
  rw [ideleClassGroup_smul_restrictScalars (K := K) σ (γ • q),
    ideleClassGroup_smul_restrictScalars (K := K) σ q, ← mul_smul, ← mul_smul, mul_comm]

end NormEquiv

/-- **Norm-one elements of the norm subgroup are coboundaries.**  Let `K ⊆ M ⊆ L` be a tower of
number fields with `Gal(L/K)` cyclic, `N ⊆ N_{L/M}C_L ≤ C_M` an element with `N_{M/K}(n) = 1`.
Then `n` lies in the subgroup of `C_M` generated by the elements `σ • m * m⁻¹` with `σ ∈ Gal(M/K)`
and `m ∈ N_{L/M}C_L`. -/
theorem normClassSubgroup_closure_normClassHom_eq_one {K M L : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Field L] [NumberField L] [Algebra K M] [Algebra M L] [Algebra K L] [IsScalarTower K M L] [FiniteDimensional K M] [FiniteDimensional M L] [FiniteDimensional K L] [IsGalois K M] [IsGalois M L] [IsGalois K L] [IsCyclic (L ≃ₐ[K] L)] (p : ℕ) (hp : p.Prime) (hKM : Module.finrank K M = p) (hML : Module.finrank M L = p) : ∀ n ∈ NK.GlobalCFT.Idele.normClassSubgroup M L, NK.GlobalCFT.IdeleClassGroup.normClassHom K M n = 1 → n ∈ Subgroup.closure {x : NK.GlobalCFT.IdeleClassGroup M | ∃ σ : Gal(M/K), ∃ m ∈ NK.GlobalCFT.Idele.normClassSubgroup M L, x = σ • m * m⁻¹} := by
  classical
  intro n hn hnorm
  obtain ⟨y, rfl⟩ := Idele.mem_normClassSubgroup.mp hn
  -- the norm of `y` down to `K` is trivial
  have hNK : IdeleClassGroup.normClassHom K L y = 1 := by
    rw [← NormGroup.globalCFT_normClassHom_trans (K := K) (L := M) (M := L) y]
    exact hnorm
  -- `H⁰`-computation for the outer extension: the product of the conjugates of `y` is `1`
  obtain ⟨u, hu⟩ : ∃ u : Place L → Place K, ∀ w, Place.LiesOver w (u w) :=
    ⟨fun w => Classical.choose (Inclusion.globalCFT_exists_placeUnder (K := K) (L := L) w),
      fun w => Classical.choose_spec (Inclusion.globalCFT_exists_placeUnder (K := K) (L := L) w)⟩
  obtain ⟨φ, hφ⟩ := Inclusion.globalCFT_ideleInclusion_exists (K := K) (L := L) u hu
  obtain ⟨ψ, hψ⟩ :=
    Inclusion.globalCFT_ideleClassGroup_inclusion_exists (K := K) (L := L) u hu φ hφ
  have hprod : (∏ σ : L ≃ₐ[K] L, σ • y) = 1 := by
    have h1 := globalCFT_normClassHom_eq_prod_smul u hu φ hφ ψ hψ y
    rw [hNK, map_one] at h1
    exact h1.symm
  -- the `ℤ[Gal(L/K)]`-module `C_L`, with its norm written as the product of the translates
  letI : CommGroup (L ≃ₐ[K] L) := IsCyclic.commGroup
  let ρ : Representation ℤ (L ≃ₐ[K] L) (Additive (IdeleClassGroup L)) :=
    Representation.ofMulDistribMulAction (L ≃ₐ[K] L) (IdeleClassGroup L)
  have hx0 : ρ.norm (Additive.ofMul y) = 0 := by
    apply Additive.toMul.injective
    rw [Representation.norm_ofMulDistribMulAction_eq]
    simp [hprod]
  -- `Ĥ⁻¹(Gal(L/K), C_L) = 0`, by periodicity and `H¹ = 0`
  haveI hTate : Subsingleton (tateCohomology (Rep.of ρ) (-1)) :=
    NK.GlobalCFTdeep.subsingleton_tateCohomology_neg_one_of_subsingleton_groupCohomology_one_cyclic
      (IdeleClassGroup.rep K L)
      NK.GlobalCFTdeep.subsingleton_groupCohomology_one_ideleClassGroup
  -- hence `y` is a coboundary
  obtain ⟨γ, hγ⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
  have hγtop : Subgroup.zpowers γ = ⊤ := (Subgroup.eq_top_iff' _).mpr hγ
  obtain ⟨w, hw⟩ := NK.GlobalCFTdeep.exists_sub_smul_eq_of_subsingleton_tateCohomology_neg_one
    ρ hTate γ hγtop hx0
  set c : IdeleClassGroup L := Additive.toMul w with hc
  have hkey : Additive.toMul (ρ γ w) = γ • c := by
    have hw' : w = Additive.ofMul c := by rw [hc]; rfl
    rw [hw']
    change Additive.toMul
      ((Representation.ofMulDistribMulAction (L ≃ₐ[K] L) (IdeleClassGroup L)) γ
        (Additive.ofMul c)) = γ • c
    simp
  have hq : γ • c * c⁻¹ = y := by
    have h3 := congrArg Additive.toMul hw
    rw [toMul_sub, toMul_ofMul, hkey, div_eq_mul_inv] at h3
    exact h3
  -- apply the equivariant norm `N_{L/M}`
  haveI hN : Normal K M := IsGalois.to_normal
  refine Subgroup.subset_closure ⟨AlgEquiv.restrictNormalHom M γ,
    IdeleClassGroup.normClassHom M L c, Idele.mem_normClassSubgroup.mpr ⟨c, rfl⟩, ?_⟩
  rw [← hq, map_mul, map_inv, normClassHom_smul]

end NK.CFTLib
