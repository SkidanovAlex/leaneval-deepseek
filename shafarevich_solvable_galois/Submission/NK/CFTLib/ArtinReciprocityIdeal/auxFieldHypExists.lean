/-- Elements of `adjoin K {ζ} ⊔ E` (over `K`) are contained in the ℚ-subalgebra generated by
`E` and `ζ`. -/
private lemma subset_sup_rat {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω] [Algebra ℚ K]
    [Algebra ℚ Ω] [IsScalarTower ℚ K Ω] (E : IntermediateField K Ω) (ζ : Ω) :
    ((E ⊔ IntermediateField.adjoin K ({ζ} : Set Ω) : IntermediateField K Ω) : Set Ω) ⊆
      ((E.restrictScalars ℚ ⊔ IntermediateField.adjoin ℚ ({ζ} : Set Ω) :
        IntermediateField ℚ Ω) : Set Ω) := by
  intro x hx
  have hEq : (E ⊔ IntermediateField.adjoin K ({ζ} : Set Ω) : IntermediateField K Ω)
      = IntermediateField.adjoin K ((E : Set Ω) ∪ {ζ}) := by
    rw [IntermediateField.adjoin_union, IntermediateField.adjoin_self]
  rw [hEq] at hx
  have hle₁ : ((E.restrictScalars ℚ : IntermediateField ℚ Ω) : Set Ω) ⊆
      ((E.restrictScalars ℚ ⊔ IntermediateField.adjoin ℚ ({ζ} : Set Ω) :
        IntermediateField ℚ Ω) : Set Ω) :=
    SetLike.coe_subset_coe.mpr le_sup_left
  have hle₂ : ((IntermediateField.adjoin ℚ ({ζ} : Set Ω) : IntermediateField ℚ Ω) : Set Ω) ⊆
      ((E.restrictScalars ℚ ⊔ IntermediateField.adjoin ℚ ({ζ} : Set Ω) :
        IntermediateField ℚ Ω) : Set Ω) :=
    SetLike.coe_subset_coe.mpr le_sup_right
  induction hx using IntermediateField.adjoin_induction with
  | mem y hy =>
      rcases hy with hy | hy
      · exact hle₁ hy
      · rw [Set.mem_singleton_iff] at hy
        rw [hy]
        exact hle₂ (IntermediateField.mem_adjoin_simple_self ℚ ζ)
  | algebraMap c => exact hle₁ (E.algebraMap_mem c)
  | add y z hy hz ihy ihz => exact add_mem ihy ihz
  | mul y z hy hz ihy ihz => exact mul_mem ihy ihz
  | inv y hy ih => exact inv_mem ih

/-- If `Φ` is a Frobenius at a prime `P` of `Ω` over `p` and `Φ` lies in a normal subgroup `H`,
then `1` is a Frobenius at `p` for the fixed field of `H`. -/
private theorem isFrobAtPrime_one_fixedField {K Ω : Type} [Field K] [NumberField K] [Field Ω]
    [NumberField Ω] [Algebra K Ω] [FiniteDimensional K Ω] [IsGalois K Ω]
    (H : Subgroup Gal(Ω/K)) [H.Normal] {p : NK.Chebotarev.PrimeIdeal K}
    {P : NK.Chebotarev.PrimeIdeal Ω} (hP : P.asIdeal.LiesOver p.asIdeal)
    {Φ : Gal(Ω/K)} (hΦ : NK.Chebotarev.IsFrobAt P Φ) (hmem : Φ ∈ H) :
    NK.Chebotarev.IsFrobAtPrime (K := K) (L := ↥(IntermediateField.fixedField H)) p 1 := by
  haveI : IsGalois K ↥(IntermediateField.fixedField H) := IsGalois.of_fixedField_normal_subgroup H
  refine ⟨P.under (NumberField.RingOfIntegers ↥(IntermediateField.fixedField H)), ?_, ?_⟩
  · refine Ideal.LiesOver.mk ?_
    rw [NK.Chebotarev.under_asIdeal, Ideal.under_under, hP.over]
  · have h1 : AlgEquiv.restrictNormalHom (IntermediateField.fixedField H) Φ = 1 := by
      rw [← MonoidHom.mem_ker, IntermediateField.restrictNormalHom_ker,
        IntermediateField.fixingSubgroup_fixedField]
      exact hmem
    rw [← h1]
    exact NK.Chebotarev.IsFrobAtRestrictNormalHom (IntermediateField.fixedField H) hP hΦ

/-- A Frobenius element at a prime acts on a primitive root of unity by raising it to the
norm.  (`NK.CFTLib.ARL.isFrobAtPrime_zeta` for an arbitrary primitive root rather than the
standard generator of a cyclotomic extension.) -/
private theorem isFrobAtPrime_zeta' {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (n : ℕ) [NeZero n]
    (ζ : L) (hζ : IsPrimitiveRoot ζ n) (p : NK.Chebotarev.PrimeIdeal K) (σ : Gal(L/K))
    (hs : (n : NumberField.RingOfIntegers K) ∉ p.asIdeal)
    (hfrob : NK.Chebotarev.IsFrobAtPrime (L := L) p σ) :
    σ ζ = ζ ^ p.asIdeal.absNorm := by
  obtain ⟨P, hP, hfrobP⟩ := hfrob
  have hζint : IsPrimitiveRoot hζ.toInteger n := hζ.toInteger_isPrimitiveRoot
  have hcoe : algebraMap (NumberField.RingOfIntegers L) L hζ.toInteger = ζ := hζ.coe_toInteger
  have hnP : (n : NumberField.RingOfIntegers L) ∉ P.asIdeal := by
    intro hmem
    apply hs
    have h' : algebraMap (NumberField.RingOfIntegers K) (NumberField.RingOfIntegers L)
        (n : NumberField.RingOfIntegers K) ∈ P.asIdeal := by
      rwa [map_natCast]
    exact (Ideal.mem_of_liesOver (P := P.asIdeal) (p := p.asIdeal)
      (x := (n : NumberField.RingOfIntegers K))).mpr h'
  have h1 : galRestrict (NumberField.RingOfIntegers K) K L (NumberField.RingOfIntegers L) σ
        hζ.toInteger
      = hζ.toInteger ^ Nat.card (NumberField.RingOfIntegers K ⧸
          P.asIdeal.under (NumberField.RingOfIntegers K)) :=
    AlgHom.IsArithFrobAt.apply_of_pow_eq_one hfrobP hζint.pow_eq_one hnP
  have h2 := congrArg (algebraMap (NumberField.RingOfIntegers L) L) h1
  rw [map_pow, algebraMap_galRestrict_apply] at h2
  rw [hcoe, ← hP.over] at h2
  have habs : Nat.card (NumberField.RingOfIntegers K ⧸ p.asIdeal) = p.asIdeal.absNorm := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  rwa [habs] at h2

theorem auxFieldHypExists (K L : Type) [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    [IsCyclic (L ≃ₐ[K] L)] (m : ℕ) (hm : 0 < m) :
    NK.CFTLib.ARL.AuxFieldHyp K L m := by
  classical
  intro s hs S hS
  -- ## the arithmetic input
  set n : ℕ := Module.finrank K L with hn
  have hn0 : 0 < n := by rw [hn]; exact Module.finrank_pos
  let a : s → ℕ := fun i => Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal
  have ha : ∀ i : s, 1 < a i := by
    intro i
    haveI : (i : NK.Chebotarev.PrimeIdeal K).asIdeal.IsMaximal :=
      Ring.DimensionLEOne.maximalOfPrime (i : NK.Chebotarev.PrimeIdeal K).ne_bot
        (i : NK.Chebotarev.PrimeIdeal K).isPrime
    haveI hfin : Finite (𝓞 K ⧸ (i : NK.Chebotarev.PrimeIdeal K).asIdeal) :=
      Commons.NumberTheory.NumberField.finite_quotient_heightOneSpectrum _
    haveI : Fintype (𝓞 K ⧸ (i : NK.Chebotarev.PrimeIdeal K).asIdeal) := Fintype.ofFinite _
    haveI : Field (𝓞 K ⧸ (i : NK.Chebotarev.PrimeIdeal K).asIdeal) := Ideal.Quotient.field _
    have h : a i = Nat.card (𝓞 K ⧸ (i : NK.Chebotarev.PrimeIdeal K).asIdeal) := by
      rw [show a i = Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal from rfl,
        Ideal.absNorm_apply, Submodule.cardQuot_apply]
    rw [h, Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  set T : Finset ℕ := S ∪ m.primeFactors ∪ (NumberField.discr K).natAbs.primeFactors ∪
    (NumberField.discr L).natAbs.primeFactors with hTdef
  have hT : ∀ p ∈ T, p.Prime := by
    intro p hp
    rw [hTdef] at hp
    rcases Finset.mem_union.mp hp with hp | hp
    · rcases Finset.mem_union.mp hp with hp | hp
      · rcases Finset.mem_union.mp hp with hp | hp
        · exact hS p hp
        · exact Nat.prime_of_mem_primeFactors hp
      · exact Nat.prime_of_mem_primeFactors hp
    · exact Nat.prime_of_mem_primeFactors hp
  obtain ⟨M, hMne, ℓu, au, havoid, hauco, harith⟩ :=
    NK.CFTLib.ARL.auxField_arith_zpow n hn0 a ha T hT
  haveI : NeZero M := hMne
  -- ## the easy conjuncts
  have hMm : M.Coprime m := by
    rw [Nat.coprime_iff_gcd_eq_one]
    by_contra h1
    obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd h1
    have hpM : p ∣ M := dvd_trans hpd (Nat.gcd_dvd_left M m)
    have hpm : p ∣ m := dvd_trans hpd (Nat.gcd_dvd_right M m)
    refine havoid p ?_ hpM
    rw [hTdef]
    exact Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_union_right _
        (Nat.mem_primeFactors.mpr ⟨hp, hpm, hm.ne'⟩)))
  have hMS : ∀ p ∈ S, ¬ p ∣ M := by
    intro p hp
    refine havoid p ?_
    rw [hTdef]
    exact Finset.mem_union_left _
      (Finset.mem_union_left _ (Finset.mem_union_left _ hp))
  have hcop : ∀ i : s, (a i).Coprime M := by
    intro i
    have hunit : IsUnit (((a i : ℕ) : ZMod M)) := by
      rw [← hauco i]
      exact (au i).isUnit
    exact (ZMod.isUnit_iff_coprime (a i) M).mp hunit
  have hMabs : ∀ p : ℕ, p.Prime → p ∣ M → ∀ 𝔭 ∈ s, ¬ p ∣ Ideal.absNorm 𝔭.asIdeal := by
    intro p hp hpM 𝔭 h𝔭 hpdvd
    have h2 : p ∣ (a ⟨𝔭, h𝔭⟩).gcd M := Nat.dvd_gcd hpdvd hpM
    rw [(hcop ⟨𝔭, h𝔭⟩).gcd_eq_one] at h2
    exact hp.not_dvd_one h2
  have hMnotmem : ∀ i : s, (M : 𝓞 K) ∉ (i : NK.Chebotarev.PrimeIdeal K).asIdeal := by
    intro i hmem
    have hle : Ideal.span {((M : ℕ) : 𝓞 K)} ≤ (i : NK.Chebotarev.PrimeIdeal K).asIdeal :=
      Ideal.span_le.mpr (by simpa using hmem)
    have hdvd : Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal ∣
        M ^ Module.finrank ℤ (𝓞 K) := by
      have h := Ideal.absNorm_dvd_absNorm_of_le hle
      rw [Ideal.absNorm_span_singleton, Algebra.norm_natCast, Int.natAbs_pow,
        Int.natAbs_natCast] at h
      exact h
    have h2 : Nat.Coprime (Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal)
        (M ^ Module.finrank ℤ (𝓞 K)) := (hcop i).pow_right _
    have hone : Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal = 1 :=
      Nat.Coprime.eq_one_of_dvd h2 hdvd
    have hge : 1 < Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal := by
      have h := ha i
      rw [show a i = Ideal.absNorm (i : NK.Chebotarev.PrimeIdeal K).asIdeal from rfl] at h
      exact h
    omega
  have hdK : ∀ p : ℕ, p.Prime → p ∣ M → ¬ p ∣ (NumberField.discr K).natAbs := by
    intro p hp hpM hpd
    refine havoid p ?_ hpM
    rw [hTdef]
    exact Finset.mem_union_left _ (Finset.mem_union_right _ (Nat.mem_primeFactors.mpr
      ⟨hp, hpd, Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero K)⟩))
  have hdL : ∀ p : ℕ, p.Prime → p ∣ M → ¬ p ∣ (NumberField.discr L).natAbs := by
    intro p hp hpM hpd
    refine havoid p ?_ hpM
    rw [hTdef]
    exact Finset.mem_union_right _ (Nat.mem_primeFactors.mpr
      ⟨hp, hpd, Int.natAbs_ne_zero.mpr (NumberField.discr_ne_zero L)⟩)
  -- ## the auxiliary field
  refine ⟨M, hMne, hMm, hMS, hMabs,
    NK.CFTLib.ARL.disjoint_restrictScalars_adjoin_zeta (K := K) (L := L) M hdL, ?_⟩
  let Ω := CyclotomicField M L
  haveI hgalΩ : IsGalois K Ω :=
    NK.CFTLib.ARL.isGalois_cyclotomicField_over_base (K := K) (L := L) M
  haveI hfdΩ : FiniteDimensional K Ω := FiniteDimensional.trans K L Ω
  haveI hTowerQ : IsScalarTower ℚ K Ω :=
    IsScalarTower.of_algebraMap_eq fun x => by simp [map_ratCast]
  obtain ⟨σ, hσ⟩ := IsCyclic.exists_generator (α := L ≃ₐ[K] L)
  haveI hAgal : IsGalois K ↥(AuxA K L M) := AuxA_isGalois (K := K) (L := L) M
  haveI hAfd : FiniteDimensional K ↥(AuxA K L M) := AuxA_finiteDimensional (K := K) (L := L) M
  haveI hAnormal : Normal K ↥(AuxA K L M) := hAgal.to_normal
  haveI hBgal : IsGalois K ↥(AuxB K L M) := AuxB_isGalois (K := K) (L := L) M
  haveI hBfd : FiniteDimensional K ↥(AuxB K L M) := AuxB_finiteDimensional (K := K) (L := L) M
  haveI hBnormal : Normal K ↥(AuxB K L M) := hBgal.to_normal
  haveI hBcyc : IsCyclotomicExtension {M} K ↥(AuxB K L M) := AuxB_isCyclotomic (K := K) (L := L) M
  -- ## the product decomposition of `Gal(Ω/K)`
  let θA : Gal(Ω/K) →* Gal(↥(AuxA K L M)/K) := AlgEquiv.restrictNormalHom (AuxA K L M)
  let θB : Gal(Ω/K) →* Gal(↥(AuxB K L M)/K) := AlgEquiv.restrictNormalHom (AuxB K L M)
  have hkerA : θA.ker = (AuxA K L M).fixingSubgroup :=
    IntermediateField.restrictNormalHom_ker (AuxA K L M)
  have hkerB : θB.ker = (AuxB K L M).fixingSubgroup :=
    IntermediateField.restrictNormalHom_ker (AuxB K L M)
  have hinj : Function.Injective (fun γ : Gal(Ω/K) => (θA γ, θB γ)) := by
    intro x y hxy
    have h1 : θA (x * y⁻¹) = 1 := by
      rw [map_mul, map_inv, show θA x = θA y from congrArg Prod.fst hxy, mul_inv_cancel]
    have h2 : θB (x * y⁻¹) = 1 := by
      rw [map_mul, map_inv, show θB x = θB y from congrArg Prod.snd hxy, mul_inv_cancel]
    have h3 : x * y⁻¹ ∈ (AuxA K L M).fixingSubgroup := hkerA ▸ (MonoidHom.mem_ker.mpr h1)
    have h4 : x * y⁻¹ ∈ (AuxB K L M).fixingSubgroup := hkerB ▸ (MonoidHom.mem_ker.mpr h2)
    have h5 : x * y⁻¹ ∈ (AuxA K L M ⊔ AuxB K L M).fixingSubgroup := by
      rw [IntermediateField.fixingSubgroup_sup]
      exact ⟨h3, h4⟩
    rw [AuxA_sup_AuxB_eq_top (K := K) (L := L) M, IntermediateField.fixingSubgroup_top] at h5
    exact mul_inv_eq_one.mp h5
  have hfrΩ : Module.finrank K Ω =
      Module.finrank K ↥(AuxA K L M) * Module.finrank K ↥(AuxB K L M) := by
    have hLD : (AuxA K L M).LinearDisjoint ↥(AuxB K L M) :=
      IntermediateField.LinearDisjoint.of_inf_eq_bot
        (AuxA_inf_AuxB_eq_bot (K := K) (L := L) M hdL)
    rw [← hLD.finrank_sup, AuxA_sup_AuxB_eq_top (K := K) (L := L) M,
      IntermediateField.finrank_top']
  have hcardNat : Nat.card Gal(Ω/K) =
      Nat.card (Gal(↥(AuxA K L M)/K) × Gal(↥(AuxB K L M)/K)) := by
    rw [Nat.card_prod, IsGalois.card_aut_eq_finrank K Ω,
      IsGalois.card_aut_eq_finrank K ↥(AuxA K L M),
      IsGalois.card_aut_eq_finrank K ↥(AuxB K L M), hfrΩ]
  have hcard : Fintype.card Gal(Ω/K) =
      Fintype.card (Gal(↥(AuxA K L M)/K) × Gal(↥(AuxB K L M)/K)) := by
    simp only [Fintype.card_eq_nat_card]
    exact hcardNat
  have hbij : Function.Bijective (fun γ : Gal(Ω/K) => (θA γ, θB γ)) :=
    (Fintype.bijective_iff_injective_and_card _).mpr ⟨hinj, hcard⟩
  let ψ : Gal(Ω/K) ≃* (Gal(↥(AuxA K L M)/K) × Gal(↥(AuxB K L M)/K)) :=
    MulEquiv.ofBijective (θA.prod θB) hbij
  have hψ : ∀ γ : Gal(Ω/K), ψ γ = (θA γ, θB γ) := fun γ => MulEquiv.ofBijective_apply _ _ γ
  -- ## commutativity
  haveI hCommA : IsMulCommutative Gal(↥(AuxA K L M)/K) := ⟨⟨fun x y => by
    obtain ⟨x', rfl⟩ := (AlgEquiv.autCongr (AuxA_algEquiv (K := K) (L := L) M)).surjective x
    obtain ⟨y', rfl⟩ := (AlgEquiv.autCongr (AuxA_algEquiv (K := K) (L := L) M)).surjective y
    rw [← map_mul, ← map_mul, IsMulCommutative.is_comm.comm x' y']⟩⟩
  haveI hCommB : IsMulCommutative Gal(↥(AuxB K L M)/K) :=
    IsCyclotomicExtension.isMulCommutative {M} K ↥(AuxB K L M)
  haveI hCommΩ : IsMulCommutative Gal(Ω/K) := ⟨⟨fun γ δ => ψ.injective (by
    simp only [map_mul]
    exact IsMulCommutative.is_comm.comm (ψ γ) (ψ δ))⟩⟩
  -- ## the elements `σA` and `τ`
  let σA : Gal(↥(AuxA K L M)/K) := AlgEquiv.autCongr (AuxA_algEquiv (K := K) (L := L) M) σ
  have hσA_gen : Subgroup.zpowers σA = ⊤ := by
    rw [Subgroup.eq_top_iff']
    intro y
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.mp (hσ
      ((AlgEquiv.autCongr (AuxA_algEquiv (K := K) (L := L) M)).symm y))
    refine Subgroup.mem_zpowers_iff.mpr ⟨k, ?_⟩
    rw [show σA = AlgEquiv.autCongr (AuxA_algEquiv (K := K) (L := L) M) σ from rfl,
      ← map_zpow]
    rw [hk]
    exact MulEquiv.apply_symm_apply _ y
  have hcardA : Nat.card Gal(↥(AuxA K L M)/K) = n := by
    rw [IsGalois.card_aut_eq_finrank K ↥(AuxA K L M), AuxA_finrank (K := K) (L := L) M]
  have hσAn : σA ^ (n : ℤ) = 1 := by
    rw [zpow_natCast, ← hcardA]
    exact orderOf_dvd_iff_pow_eq_one.mp (orderOf_dvd_natCard σA)
  have hfrB : Module.finrank K ↥(AuxB K L M) = M.totient :=
    NK.CFTLib.Existence.finrank_adjoin_zeta_eq_totient (K := K) (Ω := Ω) M hdK
      (IsCyclotomicExtension.zeta M L Ω) (IsCyclotomicExtension.zeta_spec M L Ω)
  set ζB : ↥(AuxB K L M) := ⟨IsCyclotomicExtension.zeta M L Ω,
    IntermediateField.subset_adjoin K _ (Set.mem_singleton _)⟩ with hζBdef
  have hζB : IsPrimitiveRoot ζB M := by
    rw [← IsPrimitiveRoot.coe_submonoidClass_iff]
    exact IsCyclotomicExtension.zeta_spec M L Ω
  have hbsurj : Function.Surjective (hζB.autToPow K) := by
    have hinj : Function.Injective (hζB.autToPow K) := hζB.autToPow_injective K
    have hcardB : Fintype.card (Gal(↥(AuxB K L M)/K)) = M.totient := by
      rw [Fintype.card_eq_nat_card, IsGalois.card_aut_eq_finrank K ↥(AuxB K L M), hfrB]
    have hcard : Fintype.card (Gal(↥(AuxB K L M)/K)) = Fintype.card (ZMod M)ˣ := by
      rw [hcardB, ZMod.card_units_eq_totient]
    obtain ⟨e⟩ := Fintype.card_eq.mp hcard
    exact Function.Injective.surjective_of_finite e hinj
  obtain ⟨b, hbχ⟩ := hbsurj ℓu
  have hb : b ζB = ζB ^ (ℓu : ZMod M).val := by
    have h := IsPrimitiveRoot.autToPow_spec K hζB b
    rw [hbχ] at h
    exact h.symm
  let τ : Gal(Ω/K) := ψ.symm (σA, b)
  have hτ : ψ τ = (σA, b) := ψ.apply_symm_apply _
  have hθAτ : θA τ = σA := by
    have h := congrArg Prod.fst hτ
    simpa [hψ τ] using h
  have hθBτ : θB τ = b := by
    have h := congrArg Prod.snd hτ
    simpa [hψ τ] using h
  have hcomm : ∀ Φ : Gal(Ω/K), Commute τ Φ := by
    intro Φ
    have hP : ψ τ * ψ Φ = ψ Φ * ψ τ := by
      rw [hψ τ, hψ Φ]
      refine Prod.ext ?_ ?_ <;> simp only [Prod.fst_mul, Prod.snd_mul]
      · exact IsMulCommutative.is_comm.comm (θA τ) (θA Φ)
      · exact IsMulCommutative.is_comm.comm (θB τ) (θB Φ)
    have heq : ψ (τ * Φ) = ψ (Φ * τ) := by
      rw [map_mul, map_mul]
      exact hP
    exact ψ.injective heq
  -- ## the primes and their Frobenius elements
  have h𝔓exists : ∀ i : s, ∃ P : NK.Chebotarev.PrimeIdeal Ω,
      P.asIdeal.LiesOver (i : NK.Chebotarev.PrimeIdeal K).asIdeal :=
    fun i => NK.Chebotarev.exists_primeIdeal_liesOver (K := K) (L := Ω)
      (i : NK.Chebotarev.PrimeIdeal K)
  choose 𝔓 h𝔓lies using h𝔓exists
  have hΦexists : ∀ i : s, ∃ ρ : Gal(Ω/K), NK.Chebotarev.IsFrobAt (𝔓 i) ρ :=
    fun i => NK.Chebotarev.exists_isFrobAt (K := K) (L := Ω)
      (i : NK.Chebotarev.PrimeIdeal K) (𝔓 i) (h𝔓lies i)
  choose Φ hΦfrob using hΦexists
  -- ## the subgroups and the fields
  let Hsub : s → Subgroup Gal(Ω/K) :=
    fun i => NK.CFTLib.ARL.closurePairSubgroup τ (Φ i) (hcomm (Φ i))
  let Hinf : Subgroup Gal(Ω/K) := ⨅ i : s, Hsub i
  let E : IntermediateField K Ω := IntermediateField.fixedField Hinf
  have hHinf_le : ∀ i : s, Hinf ≤ Hsub i := fun i => iInf_le _ i
  have hτHinf : τ ∈ Hinf := by
    rw [Subgroup.mem_iInf]
    intro i
    exact ⟨1, 0, by rw [zpow_one, zpow_zero, mul_one]⟩
  have hE𝔭_le : ∀ i : s, IntermediateField.fixedField (Hsub i) ≤ E :=
    fun i => IntermediateField.fixedField_le (hHinf_le i)
  -- ## the key subgroup computation
  have hζΩ : IsPrimitiveRoot (IsCyclotomicExtension.zeta M L Ω) M :=
    IsCyclotomicExtension.zeta_spec M L Ω
  let χΩ : Gal(Ω/K) →* (ZMod M)ˣ := hζΩ.autToPow K
  have hχτ : χΩ τ = ℓu := by
    have hτζ : τ (IsCyclotomicExtension.zeta M L Ω) =
        (IsCyclotomicExtension.zeta M L Ω) ^ (ℓu : ZMod M).val := by
      have hrc := AlgEquiv.restrictNormal_commutes τ (AuxB K L M) ζB
      have hrest : τ.restrictNormal (AuxB K L M) = b := by
        rw [show τ.restrictNormal (AuxB K L M) = θB τ from rfl, hθBτ]
      rw [hrest, hb, map_pow] at hrc
      rw [show (algebraMap ↥(AuxB K L M) Ω) ζB = IsCyclotomicExtension.zeta M L Ω from rfl]
        at hrc
      exact hrc.symm
    have h2 := NK.CFTLib.ARL.autToPow_eq_of_pow_eq hζΩ τ (ℓu : ZMod M).val hτζ
    refine Units.ext ?_
    rw [h2]
    exact ZMod.natCast_zmod_val (ℓu : ZMod M)
  have hχΦ : ∀ i : s, χΩ (Φ i) = au i := by
    intro i
    have hΦζ : (Φ i) (IsCyclotomicExtension.zeta M L Ω) =
        (IsCyclotomicExtension.zeta M L Ω) ^
          (i : NK.Chebotarev.PrimeIdeal K).asIdeal.absNorm :=
      isFrobAtPrime_zeta' M (IsCyclotomicExtension.zeta M L Ω) hζΩ
        (i : NK.Chebotarev.PrimeIdeal K) (Φ i) (hMnotmem i)
        ⟨𝔓 i, h𝔓lies i, hΦfrob i⟩
    have h2 := NK.CFTLib.ARL.autToPow_eq_of_pow_eq hζΩ (Φ i)
      ((i : NK.Chebotarev.PrimeIdeal K).asIdeal.absNorm) hΦζ
    refine Units.ext ?_
    rw [h2]
    exact (hauco i).symm
  have hFix : ∀ i : s, Hsub i ⊓ (AuxB K L M).fixingSubgroup = ⊥ := by
    intro i
    rw [eq_bot_iff]
    intro x hx
    rw [Subgroup.mem_inf] at hx
    obtain ⟨hxH, hxB⟩ := hx
    obtain ⟨j, k, hjk⟩ := hxH
    have hxζ : x (IsCyclotomicExtension.zeta M L Ω) = IsCyclotomicExtension.zeta M L Ω :=
      (IntermediateField.mem_fixingSubgroup_iff (AuxB K L M) x).mp hxB _
        (IntermediateField.subset_adjoin K _ (Set.mem_singleton _))
    have hχx : χΩ x = 1 := by
      have h2 := NK.CFTLib.ARL.autToPow_eq_of_pow_eq hζΩ x 1 (by rw [hxζ, pow_one])
      refine Units.ext ?_
      rw [h2]
      simp
    have hrel : ℓu ^ j * (au i) ^ k = 1 := by
      have h1 : χΩ (τ ^ j * (Φ i) ^ k) = 1 := by
        rw [show τ ^ j * (Φ i) ^ k = x from hjk]
        exact hχx
      rw [map_mul, map_zpow, map_zpow, hχτ, hχΦ i] at h1
      exact h1
    have hn_j : (n : ℤ) ∣ j := (harith i j k hrel).1
    have hn_k : (n : ℤ) ∣ k := (harith i j k hrel).2
    have hθAΦn : (θA (Φ i)) ^ (n : ℤ) = 1 := by
      rw [zpow_natCast, ← hcardA]
      exact orderOf_dvd_iff_pow_eq_one.mp (orderOf_dvd_natCard (θA (Φ i)))
    have hθAx : θA x = 1 := by
      have h3 : θA (τ ^ j * (Φ i) ^ k) = 1 := by
        rw [map_mul, map_zpow, map_zpow, hθAτ]
        obtain ⟨c1, hc1⟩ := hn_j
        obtain ⟨c2, hc2⟩ := hn_k
        rw [hc1, hc2, zpow_mul, zpow_mul, hσAn, hθAΦn]
        simp
      rwa [show τ ^ j * (Φ i) ^ k = x from hjk] at h3
    have hx1 : x = 1 := by
      refine hinj ?_
      show (θA x, θB x) = (θA 1, θB 1)
      have hθBx : θB x = 1 := MonoidHom.mem_ker.mp (hkerB ▸ hxB)
      rw [hθAx, hθBx, map_one, map_one]
    exact hx1
  have htopK : ∀ i : s, IntermediateField.fixedField (Hsub i) ⊔ AuxB K L M = ⊤ := by
    intro i
    have h1 := IsGalois.fixedField_fixingSubgroup
      (IntermediateField.fixedField (Hsub i) ⊔ AuxB K L M)
    rw [IntermediateField.fixingSubgroup_sup, IntermediateField.fixingSubgroup_fixedField,
      hFix i, IntermediateField.fixedField_bot] at h1
    exact h1.symm
  have htopQ : ∀ i : s,
      (((IntermediateField.fixedField (Hsub i)).restrictScalars ℚ) ⊔
        (IntermediateField.adjoin ℚ ({IsCyclotomicExtension.zeta M L Ω} : Set Ω))) = ⊤ := by
    intro i
    refine le_antisymm le_top ?_
    intro x _
    refine subset_sup_rat (K := K) (Ω := Ω) (IntermediateField.fixedField (Hsub i))
      (IsCyclotomicExtension.zeta M L Ω) ?_
    rw [show IntermediateField.fixedField (Hsub i) ⊔
        IntermediateField.adjoin K ({IsCyclotomicExtension.zeta M L Ω} : Set Ω) = ⊤
      from htopK i]
    trivial
  have hFrob : ∀ i : s, NK.Chebotarev.IsFrobAtPrime (K := K)
      (L := ↥(IntermediateField.fixedField (Hsub i))) (i : NK.Chebotarev.PrimeIdeal K) 1 := by
    intro i
    haveI : (Hsub i).Normal := Subgroup.normal_of_isMulCommutative (Hsub i)
    exact isFrobAtPrime_one_fixedField (Hsub i) (h𝔓lies i) (hΦfrob i) ⟨0, 1, by rw [zpow_zero, zpow_one, one_mul]⟩
  have hEdisj : Disjoint E (AuxA K L M) := by
    rw [disjoint_iff]
    refine le_antisymm ?_ bot_le
    intro x hx
    rw [IntermediateField.mem_inf] at hx
    obtain ⟨hxE, hxA⟩ := hx
    have hτfix : τ ∈ (IntermediateField.fixedField Hinf).fixingSubgroup := by
      rw [IntermediateField.fixingSubgroup_fixedField]
      exact hτHinf
    have hτx : τ x = x := (IntermediateField.mem_fixingSubgroup_iff _ τ).mp hτfix x hxE
    set ŷ : ↥(AuxA K L M) := ⟨x, hxA⟩ with hŷ
    have hval : (algebraMap ↥(AuxA K L M) Ω) ŷ = x := rfl
    have hσAŷ : σA ŷ = ŷ := by
      have hrc := AlgEquiv.restrictNormal_commutes τ (AuxA K L M) ŷ
      have h2 : (τ.restrictNormal (AuxA K L M)) ŷ = σA ŷ := by
        rw [show τ.restrictNormal (AuxA K L M) = θA τ from rfl, hθAτ]
      rw [h2, hval, hτx] at hrc
      exact (algebraMap ↥(AuxA K L M) Ω).injective hrc
    have hfix : ∀ f : Gal(↥(AuxA K L M)/K), f ŷ = ŷ := by
      have hle : Subgroup.zpowers σA ≤ MulAction.stabilizer Gal(↥(AuxA K L M)/K) ŷ := by
        rw [Subgroup.zpowers_le, MulAction.mem_stabilizer_iff]
        exact hσAŷ
      intro f
      have hf : f ∈ Subgroup.zpowers σA := by rw [hσA_gen]; exact Subgroup.mem_top f
      exact hle hf
    have hbot : ŷ ∈ (⊥ : IntermediateField K ↥(AuxA K L M)) :=
      (IsGalois.mem_bot_iff_fixed ŷ).mpr hfix
    rw [IntermediateField.mem_bot] at hbot
    obtain ⟨c, hc⟩ := hbot
    refine IntermediateField.mem_bot.mpr ⟨c, ?_⟩
    rw [IsScalarTower.algebraMap_apply K ↥(AuxA K L M) Ω c, hc]
    exact hval
  exact ⟨E, hEdisj, fun 𝔭 h𝔭 => ⟨IntermediateField.fixedField (Hsub ⟨𝔭, h𝔭⟩),
    hE𝔭_le ⟨𝔭, h𝔭⟩, htopQ ⟨𝔭, h𝔭⟩, hFrob ⟨𝔭, h𝔭⟩⟩⟩

end NK.CFTLib.ArtinReciprocityIdeal
