/-!
# `I(m)`: the group of fractional ideals coprime to the modulus `m`

`NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K m` (Lang's `I(c)`) is defined in
`LangDefs.lean` as the *subgroup generated* by the prime ideals not dividing `(m)`, while
`FracCoprime m A` is the *property* of having no prime factor dividing `(m)` (its `count` at
every height-one prime containing `(m)` vanishes). This module proves that the two agree:

`A ∈ idealCoprimeGroup K m ↔ FracCoprime m A`.

The two directions are the two halves of the unique factorisation of a fractional ideal of a
Dedekind domain as a finitely supported product `∏_𝔭 𝔭 ^ (count K 𝔭 A)`:

* a product of primes which do not divide `(m)` (and inverses thereof) has vanishing `count` at
  every prime which does;
* conversely, an element whose `count` vanishes away from the primes coprime to `(m)` is the
  finitely supported product of the corresponding prime powers, hence lies in the subgroup
  generated by them.

The subgroup `FracCoprime m` is packaged as `fracCoprimeSubgroup K m` for reuse.
-/

set_option autoImplicit false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

namespace NK.CFTLib.ArtinReciprocityIdeal

variable {K : Type} [Field K] [NumberField K]

/-- **The fractional ideals coprime to `(m)` form a subgroup** of the group `Frac K` of
fractional ideals: `1` has no prime factors, and `count` is additive under multiplication and
negates under inversion. -/
def fracCoprimeSubgroup (K : Type) [Field K] [NumberField K] (m : ℕ) : Subgroup (Frac K) where
  carrier := {A | FracCoprime m A}
  mul_mem' := by
    intro A B hA hB 𝔭 h𝔭
    rw [Units.val_mul, FractionalIdeal.count_mul K 𝔭 A.ne_zero B.ne_zero, hA 𝔭 h𝔭, hB 𝔭 h𝔭,
      add_zero]
  one_mem' := by
    intro 𝔭 _
    rw [Units.val_one, FractionalIdeal.count_one K 𝔭]
  inv_mem' := by
    intro A hA 𝔭 h𝔭
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv K 𝔭, hA 𝔭 h𝔭, neg_zero]

/-- **`I(m)` is exactly the set of fractional ideals coprime to `(m)`**: the subgroup of `Frac K`
generated by the prime ideals not dividing `(m)` equals the set of fractional ideals whose
`count` vanishes at every prime containing `(m)`. -/
theorem mem_idealCoprimeGroup_iff {K : Type} [Field K] [NumberField K] (m : ℕ)
    (A : NK.CFTLib.ArtinReciprocityIdeal.Frac K) :
    A ∈ NK.CFTLib.ArtinReciprocityIdeal.idealCoprimeGroup K m ↔
      NK.CFTLib.ArtinReciprocityIdeal.FracCoprime m A := by
  constructor
  · -- The generators of `I(m)` are coprime to `(m)`, and the coprime fractional ideals form a
    -- subgroup, so the whole of `I(m)` consists of them.
    intro h
    have hle : idealCoprimeGroup K m ≤ fracCoprimeSubgroup K m := by
      rw [idealCoprimeGroup]
      refine (Subgroup.closure_le (fracCoprimeSubgroup K m)).mpr ?_
      rintro A ⟨𝔭, hm, rfl⟩ 𝔮 h𝔮
      have hne : 𝔭 ≠ 𝔮 := fun he => hm (he ▸ h𝔮)
      simpa [idealUnit] using FractionalIdeal.count_maximal_coprime K 𝔮 hne
    exact hle h
  · -- Conversely, `A` is the finitely supported product of the prime powers `𝔭 ^ (count 𝔭 A)`;
    -- every factor with `(m) ⊆ 𝔭` has exponent `0`, and every other factor is a generator.
    intro hA
    set e : HeightOneSpectrum (𝓞 K) → ℤ :=
      fun 𝔭 => FractionalIdeal.count K 𝔭 (A : FractionalIdeal (𝓞 K)⁰ K) with he
    set u : HeightOneSpectrum (𝓞 K) → Frac K :=
      fun 𝔭 => idealUnit 𝔭.asIdeal 𝔭.ne_bot with hu
    have hfin : Function.HasFiniteMulSupport fun 𝔭 : HeightOneSpectrum (𝓞 K) => u 𝔭 ^ e 𝔭 := by
      have hcount : {𝔭 : HeightOneSpectrum (𝓞 K) | e 𝔭 ≠ 0}.Finite := by
        have h1 := Filter.eventually_cofinite.mp
          (FractionalIdeal.finite_factors (K := K) (A : FractionalIdeal (𝓞 K)⁰ K))
        simpa [he] using h1
      exact hcount.subset fun 𝔭 h𝔭 he0 =>
        h𝔭 (by show u 𝔭 ^ e 𝔭 = 1; rw [he0, zpow_zero])
    have hmem : ∀ 𝔭, u 𝔭 ^ e 𝔭 ∈ idealCoprimeGroup K m := by
      intro 𝔭
      by_cases h𝔭 : (m : 𝓞 K) ∈ 𝔭.asIdeal
      · have h0 : e 𝔭 = 0 := hA 𝔭 h𝔭
        rw [h0, zpow_zero]
        exact Subgroup.one_mem _
      · have hgen : u 𝔭 ∈ idealCoprimeGroup K m := by
          rw [idealCoprimeGroup]
          exact Subgroup.subset_closure ⟨𝔭, h𝔭, rfl⟩
        exact Subgroup.zpow_mem _ hgen (e 𝔭)
    have hprod : (∏ᶠ 𝔭, u 𝔭 ^ e 𝔭) ∈ idealCoprimeGroup K m :=
      finprod_induction (fun x => x ∈ idealCoprimeGroup K m)
        (Subgroup.one_mem _) (fun _ _ hx hy => Subgroup.mul_mem _ hx hy) hmem
    have hAeq : A = ∏ᶠ 𝔭, u 𝔭 ^ e 𝔭 := by
      apply Units.ext
      change (A : FractionalIdeal (𝓞 K)⁰ K) =
        (Units.coeHom (FractionalIdeal (𝓞 K)⁰ K)) (∏ᶠ 𝔭, u 𝔭 ^ e 𝔭)
      rw [MonoidHom.map_finprod (Units.coeHom (FractionalIdeal (𝓞 K)⁰ K)) hfin,
        ← FractionalIdeal.finprod_heightOneSpectrum_factorization' (K := K)
          (I := (A : FractionalIdeal (𝓞 K)⁰ K)) A.ne_zero]
      refine finprod_congr fun 𝔭 => ?_
      simp [u, e, idealUnit]
    rw [hAeq]
    exact hprod

end NK.CFTLib.ArtinReciprocityIdeal
