/-!
# The abelian case of the Artin reciprocity law from the cyclic case

This module implements Lang, *Algebraic Number Theory*, Ch. X, Theorem 3: the ideal-theoretic
Artin reciprocity law for an abelian extension follows from the cyclic case, because

* an element of an abelian Galois group is trivial iff its restrictions to all the subextensions
  `L^H/K` with `Gal(L/K)/H` cyclic are trivial (`iInf_subgroup_isCyclic_quotient`), and
* a modulus which is a conductor for each of those cyclic subextensions is a conductor for `L/K`
  (`artinConductor_of_cyclic_quotients`);
* a multiple of the absolute norm of the relative different satisfies the ramification condition
  (`ramificationIdxIn_eq_one_of_absNorm_differentIdeal_notMem`).
-/

set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

namespace NK.CFTLib

open NK.Chebotarev
open NumberField
open scoped NumberField

variable {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **A multiple of the absolute norm of the relative different is ramified only at ramified
primes.**  If the prime `p` of `K` does not divide the principal ideal generated by
`Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L))`, then `p` is unramified in `L`. -/
theorem ramificationIdxIn_eq_one_of_absNorm_differentIdeal_notMem
    (p : PrimeIdeal K)
    (h : ((Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L)) : ℕ) : 𝓞 K) ∉ p.asIdeal) :
    Ideal.ramificationIdxIn p.asIdeal (𝓞 L) = 1 := by
  classical
  by_contra hne
  obtain ⟨Q, hQ⟩ :=
    Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver (K := K) (L := L) p
  haveI : Q.asIdeal.LiesOver p.asIdeal := hQ
  letI hMSA : MulSemiringAction (L ≃ₐ[K] L) (𝓞 L) :=
    IsIntegralClosure.MulSemiringAction (𝓞 K) K L (𝓞 L)
  haveI hGG : IsGaloisGroup (L ≃ₐ[K] L) (𝓞 K) (𝓞 L) :=
    IsGaloisGroup.of_isFractionRing (L ≃ₐ[K] L) (𝓞 K) (𝓞 L) K L
  have hQram : Q.asIdeal.ramificationIdx (𝓞 K) ≠ 1 := by
    intro h1
    exact hne (by
      rw [Ideal.ramificationIdxIn_eq_ramificationIdx p.asIdeal Q.asIdeal (L ≃ₐ[K] L)]
      exact h1)
  have hdvd : Q.asIdeal ∣ differentIdeal (𝓞 K) (𝓞 L) := by
    by_contra hnd
    exact hQram ((Commons.NumberTheory.NumberField.ramificationIdx_one_iff_not_dvd_differentIdeal
      (E := K) (K := L) Q.asIdeal Q.2).mp hnd)
  have hmem : ((Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L)) : ℕ) : 𝓞 L) ∈ Q.asIdeal :=
    Ideal.dvd_iff_le.mp hdvd (Ideal.absNorm_mem _)
  have hmemK : ((Ideal.absNorm (differentIdeal (𝓞 K) (𝓞 L)) : ℕ) : 𝓞 K) ∈ p.asIdeal := by
    rw [hQ.over, Ideal.mem_comap]
    simpa using hmem
  exact h hmemK

/-- **Lang X.2 Theorem 3, the reduction step.**  A modulus which is a conductor for every cyclic
quotient `L^H/K` of an abelian extension `L/K` and which satisfies the ramification condition is a
conductor for `L/K`. -/
theorem artinConductor_of_cyclic_quotients [IsMulCommutative (Gal(L/K))]
    (hgrp : ∀ g : Gal(L/K), g ≠ 1 →
      ∃ H : Subgroup Gal(L/K), IsCyclic (Gal(L/K) ⧸ H) ∧ g ∉ H)
    {m : ℕ} (hm : 0 < m)
    (hram : ∀ p : PrimeIdeal K, (m : 𝓞 K) ∉ p.asIdeal →
      Ideal.ramificationIdxIn p.asIdeal (𝓞 L) = 1)
    (hcyc : ∀ (H : Subgroup Gal(L/K)), IsCyclic (Gal(L/K) ⧸ H) →
      artinConductor K ↥(IntermediateField.fixedField H) m) :
    artinConductor K L m := by
  refine ⟨hm, hram, ?_⟩
  intro a ha hpos s e σ hs hfac hfrob
  by_contra hne
  obtain ⟨H, hHcyc, hHnot⟩ := hgrp _ hne
  let M : IntermediateField K L := IntermediateField.fixedField H
  haveI : FiniteDimensional K M := inferInstance
  haveI : NumberField M := inferInstance
  haveI : Normal K M := inferInstance
  haveI : IsGalois K M :=
    Commons.FieldTheory.Galois.isGalois_of_normal_of_charZero
  -- the conductor condition at the level of the cyclic subextension `M`
  have hMcond : (s.toList.map (fun p =>
      (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) M (σ p)) ^ e p)).prod = 1 :=
    (hcyc H hHcyc).2.2 a ha hpos s e _ hs hfac
      (fun p hp => exists_isFrobAtPrime_restrict M (hfrob p hp))
  -- the restriction of the product
  have hres : AlgEquiv.restrictNormalHom (F := K) (K₁ := L) M
        (s.toList.map (fun p => σ p ^ e p)).prod
      = (s.toList.map (fun p =>
          (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) M (σ p)) ^ e p)).prod := by
    rw [map_list_prod, List.map_map]
    congr 1
    exact List.map_congr_left fun p _ =>
      map_pow (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) M) (σ p) (e p)
  have hker : (s.toList.map (fun p => σ p ^ e p)).prod ∈
      (AlgEquiv.restrictNormalHom (F := K) (K₁ := L) M).ker := by
    rw [MonoidHom.mem_ker, hres]
    exact hMcond
  rw [IntermediateField.restrictNormalHom_ker,
    IntermediateField.fixingSubgroup_fixedField H] at hker
  exact hHnot hker

end NK.CFTLib
