/-!
# The ideal-theoretic framework of the cyclic conductor theorem

This module sets up the vocabulary of the ideal-theoretic Artin symbol for a modulus `(m)`
together with total positivity at the real places, in the form needed for the proof of
`NK.CFTLib.ARL.artinKillsPrincipal_cyclic_B` (Lang, *Algebraic Number Theory*, Ch. X §2).

* `NK.CFTLib.ARL.unitsToIdealUnits` — the principal fractional ideal of a unit of `K`.
* `NK.CFTLib.ARL.Icoprime K m` — the group of fractional ideals of `𝓞 K` prime to `(m)`
  (as a subgroup of the units of the fractional ideal group).
* `NK.CFTLib.ARL.principalRay K m` — the principal ray `P_m`: the ideals `(α)` with
  `α ≡ 1 mod m` and `α` positive at every real place.
* `NK.CFTLib.ARL.normIdeals K L m` — the norm group `𝔑(m)`: the subgroup generated by
  `N_{L/K}(𝔅)` for the ideals `𝔅` of `𝓞 L` prime to `(m)`.
* `NK.CFTLib.ARL.artinSymAt` — the ideal-theoretic Artin symbol restricted to `Icoprime K m`.

The two inputs of the main theorem are stated as separate lemmas (which are proved in the
sibling modules):

* `NK.CFTLib.ARL.index_principalRay_sup_normIdeals_le` — the *universal norm index inequality*
  in ideal form, `[I(m) : P_m·𝔑(m)] ≤ [L : K]`;
* `NK.CFTLib.ARL.artinSym_surjective` — the Artin symbol is surjective onto `Gal(L/K)`.
-/

set_option autoImplicit false
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false

open scoped NumberField nonZeroDivisors
open NumberField IsDedekindDomain

noncomputable section

namespace NK.CFTLib.ARL

open NK.GlobalCFT NK.CFTLib.Arl

variable (K : Type) [Field K] [NumberField K]

/-- **The principal fractional ideal of a unit of `K`**, as a homomorphism from `Kˣ` to the units
of the group of fractional ideals of `𝓞 K`. -/
noncomputable def unitsToIdealUnits : Kˣ →* (FractionalIdeal (𝓞 K)⁰ K)ˣ where
  toFun x := Units.mk0 (FractionalIdeal.spanSingleton (𝓞 K)⁰ (x : K))
    (FractionalIdeal.spanSingleton_ne_zero_iff.mpr (Units.ne_zero x))
  map_one' := by
    simp only [Units.val_one, FractionalIdeal.spanSingleton_one]
    exact Units.mk0_one _
  map_mul' x y := by
    refine Units.ext ?_
    simp only [Units.val_mk0, Units.val_mul, FractionalIdeal.spanSingleton_mul_spanSingleton,
      Units.val_mul]

@[simp] lemma unitsToIdealUnits_coe (x : Kˣ) :
    ((unitsToIdealUnits K x : (FractionalIdeal (𝓞 K)⁰ K)ˣ) : FractionalIdeal (𝓞 K)⁰ K)
      = FractionalIdeal.spanSingleton (𝓞 K)⁰ (x : K) := rfl

/-- **The group of fractional ideals of `𝓞 K` prime to `(m)`.** -/
noncomputable def Icoprime (m : ℕ) : Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) where
  carrier := {𝔞 | ∀ 𝔭 : HeightOneSpectrum (𝓞 K),
    (m : 𝓞 K) ∈ 𝔭.asIdeal → FractionalIdeal.count K 𝔭 (𝔞 : FractionalIdeal (𝓞 K)⁰ K) = 0}
  one_mem' := by
    intro 𝔭 _
    rw [Units.val_one]
    exact FractionalIdeal.count_one K 𝔭
  mul_mem' := by
    intro a b ha hb 𝔭 h𝔭
    rw [Units.val_mul, FractionalIdeal.count_mul K 𝔭 (Units.ne_zero a)
      (Units.ne_zero b), ha 𝔭 h𝔭, hb 𝔭 h𝔭, add_zero]
  inv_mem' := by
    intro a ha 𝔭 h𝔭
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv K 𝔭]
    rw [ha 𝔭 h𝔭]
    ring

@[simp] lemma mem_Icoprime {m : ℕ} {𝔞 : (FractionalIdeal (𝓞 K)⁰ K)ˣ} :
    𝔞 ∈ Icoprime K m ↔ ∀ 𝔭 : HeightOneSpectrum (𝓞 K),
      (m : 𝓞 K) ∈ 𝔭.asIdeal → FractionalIdeal.count K 𝔭 (𝔞 : FractionalIdeal (𝓞 K)⁰ K) = 0 :=
  Iff.rfl

/-- **The principal ray `P_m`.**  The subgroup generated by the principal ideals `(α)` with `α ∈ Kˣ`
congruent to `1` modulo `m` at all primes dividing `(m)` and positive at every real place. -/
noncomputable def principalRay (m : ℕ) : Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
  (Subgroup.comap (Idele.principalIdele K) (NK.CFTLib.Arl.congruenceSubgroup K m)).map
    (unitsToIdealUnits K)

/-- **The norm group `𝔑(m)`**: the subgroup of the group of fractional ideals of `𝓞 K` generated
by the norms `N_{L/K}(𝔅)` of the ideals `𝔅` of `𝓞 L` which are prime to `(m)`. -/
noncomputable def normIdeals (K : Type) [Field K] [NumberField K]
    (L : Type) [Field L] [NumberField L] [Algebra K L] [FiniteDimensional K L]
    (m : ℕ) : Subgroup ((FractionalIdeal (𝓞 K)⁰ K)ˣ) :=
  Subgroup.closure (Set.range (fun 𝔅 : {I : Ideal (𝓞 L) // I ≠ ⊥ ∧
      ∀ 𝔭 : HeightOneSpectrum (𝓞 L), (m : 𝓞 L) ∈ 𝔭.asIdeal → ¬ 𝔭.asIdeal ∣ I} =>
    Units.mk0 (Ideal.relNorm (𝓞 K) (𝔅 : Ideal (𝓞 L)) : FractionalIdeal (𝓞 K)⁰ K)
      (by
        rw [FractionalIdeal.coeIdeal_ne_zero]
        exact fun h => 𝔅.2.1 ((Ideal.relNorm_eq_bot_iff).mp h))))

/-- **The Artin symbol on the ideals prime to `(m)`.** -/
noncomputable def artinSymAt {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L]
    [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    (hcomm : ∀ a b : Gal(L/K), a * b = b * a) (m : ℕ)
    (𝔞 : Icoprime K m) : Gal(L/K) :=
  artinSym hcomm (𝔞.1 : FractionalIdeal (𝓞 K)⁰ K)

section ArtinSurjective

variable {K L : Type} [Field K] [NumberField K] [Field L] [NumberField L] [Algebra K L]
  [FiniteDimensional K L] [IsGalois K L]

/-- **The Artin symbol as a homomorphism on the ideals prime to `(m)`.** -/
noncomputable def artinSymHom (hcomm : ∀ a b : Gal(L/K), a * b = b * a) (m : ℕ) :
    Icoprime K m →* Gal(L/K) where
  toFun 𝔞 := artinSym hcomm (𝔞.1 : FractionalIdeal (𝓞 K)⁰ K)
  map_one' := by
    show artinSym hcomm ((1 : Icoprime K m).1 : FractionalIdeal (𝓞 K)⁰ K) = 1
    rw [Subgroup.coe_one, Units.val_one]
    exact artinSym_one hcomm
  map_mul' 𝔞 𝔟 := by
    show artinSym hcomm ((𝔞 * 𝔟 : Icoprime K m).1 : FractionalIdeal (𝓞 K)⁰ K)
      = artinSym hcomm (𝔞.1 : FractionalIdeal (𝓞 K)⁰ K)
        * artinSym hcomm (𝔟.1 : FractionalIdeal (𝓞 K)⁰ K)
    rw [Subgroup.coe_mul, Units.val_mul, artinSym_mul hcomm (Units.ne_zero 𝔞.1)
      (Units.ne_zero 𝔟.1)]

theorem artinSymHom_apply (hcomm : ∀ a b : Gal(L/K), a * b = b * a) (m : ℕ)
    (𝔞 : Icoprime K m) :
    artinSymHom hcomm m 𝔞 = artinSym hcomm (𝔞.1 : FractionalIdeal (𝓞 K)⁰ K) := rfl

/-- The prime ideal `𝔭`, viewed as an element of `Icoprime K m`, when `(m) ⊄ 𝔭`. -/
noncomputable def primeOfIcoprime (m : ℕ) (𝔭 : HeightOneSpectrum (𝓞 K)) (h : (m : 𝓞 K) ∉ 𝔭.asIdeal) :
    Icoprime K m :=
  ⟨Units.mk0 (𝔭.asIdeal : FractionalIdeal (𝓞 K)⁰ K) (by
      rw [FractionalIdeal.coeIdeal_ne_zero]; exact 𝔭.ne_bot),
    by
      classical
      intro q hq
      rw [Units.val_mk0]
      by_cases hqeq : q = 𝔭
      · rw [hqeq] at hq; exact absurd hq h
      · rw [FractionalIdeal.count_maximal (K := K) (v := q) 𝔭, if_neg (Ne.symm hqeq)]⟩

@[simp] theorem primeOfIcoprime_coe (m : ℕ) (𝔭 : HeightOneSpectrum (𝓞 K)) (h : (m : 𝓞 K) ∉ 𝔭.asIdeal) :
    ((primeOfIcoprime m 𝔭 h).1 : FractionalIdeal (𝓞 K)⁰ K)
      = (𝔭.asIdeal : FractionalIdeal (𝓞 K)⁰ K) := rfl


/-- **The Artin symbol is surjective** (Lang, *Algebraic Number Theory*, Ch. X §1, Theorem 1),
in the form needed here: if every prime `𝔭` with `(m) ∉ 𝔭` is unramified in `L/K`, then
`𝔞 ↦ ψ(𝔞)` maps `I(m)` onto `Gal(L/K)`.

Indeed the image is a subgroup containing the Frobenius element of every prime `𝔭 ∤ (m)`, and these
generate `Gal(L/K)` by `NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem`
(Dedekind's density theorem for the completely split primes). -/
theorem artinSymHom_surjective (hcomm : ∀ a b : Gal(L/K), a * b = b * a) (m : ℕ) (hm : 0 < m)
    (hram : ∀ 𝔭 : HeightOneSpectrum (𝓞 K), (m : 𝓞 K) ∉ 𝔭.asIdeal →
      ∀ P : HeightOneSpectrum (𝓞 L), P.asIdeal.LiesOver 𝔭.asIdeal →
        P.asIdeal.ramificationIdx (𝓞 K) = 1) :
    Function.Surjective (artinSymHom (K := K) (L := L) hcomm m) := by
  classical
  -- the finite set of primes containing `(m)`
  have hm0 : ((m : ℕ) : 𝓞 K) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.pos_iff_ne_zero.mp hm)
  have hfin : {𝔭 : HeightOneSpectrum (𝓞 K) | (m : 𝓞 K) ∈ 𝔭.asIdeal}.Finite := by
    refine (Ideal.finite_factors (R := 𝓞 K) (I := Ideal.span {((m : ℕ) : 𝓞 K)})
      (fun h => hm0 (Ideal.span_singleton_eq_bot.mp h))).subset ?_
    intro 𝔭 h𝔭
    simp only [Set.mem_ofPred_eq] at h𝔭 ⊢
    rw [Ideal.dvd_iff_le, Ideal.span_singleton_le_iff_mem]
    exact h𝔭
  let T : Finset (HeightOneSpectrum (𝓞 K)) := hfin.toFinset
  have hTmem : ∀ 𝔭 : HeightOneSpectrum (𝓞 K), 𝔭 ∈ T ↔ (m : 𝓞 K) ∈ 𝔭.asIdeal :=
    fun 𝔭 => Set.Finite.mem_toFinset hfin
  have hgen : Subgroup.closure {σ : Gal(L/K) | ∃ p : HeightOneSpectrum (𝓞 K), p ∉ T ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ} = ⊤ :=
    NK.GlobalCFTdeep.SecondInequality.frobeniusGenerateTop_of_notMem (K := K) (L := L) T
  have hle : Subgroup.closure {σ : Gal(L/K) | ∃ p : HeightOneSpectrum (𝓞 K), p ∉ T ∧
      NK.Chebotarev.IsFrobAtPrime (K := K) (L := L) p σ}
      ≤ (artinSymHom (K := K) (L := L) hcomm m).range := by
    rw [Subgroup.closure_le]
    rintro σ ⟨p, hpT, hpσ⟩
    have hpm : (m : 𝓞 K) ∉ p.asIdeal := fun h => hpT ((hTmem p).mpr h)
    have hunr : ∀ P : HeightOneSpectrum (𝓞 L), P.asIdeal.LiesOver p.asIdeal →
        P.asIdeal.ramificationIdx (𝓞 K) = 1 := hram p hpm
    have hpeq : NK.Chebotarev.frobAtPrime (K := K) (L := L) p = σ :=
      (NK.Chebotarev.isFrobAtPrime_iff_frobAtPrime_eq (K := K) (L := L) hcomm p hunr σ).mp hpσ
    refine ⟨primeOfIcoprime m p hpm, ?_⟩
    rw [artinSymHom_apply, primeOfIcoprime_coe, Arl.artinSym_prime hcomm p, hpeq]
  have htop : (⊤ : Subgroup Gal(L/K)) ≤ (artinSymHom (K := K) (L := L) hcomm m).range := by
    rw [← hgen]; exact hle
  intro x
  exact MonoidHom.mem_range.mp (htop (Subgroup.mem_top x))


/-- **The kernel of the Artin symbol has index `[L : K]`** (Lang, *Algebraic Number Theory*,
Ch. X §1, Theorem 1): if `ψ : I(m) → Gal(L/K)` is surjective then `[I(m) : ker ψ] = [L : K]`. -/
theorem index_ker_artinSymHom (hcomm : ∀ a b : Gal(L/K), a * b = b * a) (m : ℕ) (hm : 0 < m)
    (hram : ∀ 𝔭 : HeightOneSpectrum (𝓞 K), (m : 𝓞 K) ∉ 𝔭.asIdeal →
      ∀ P : HeightOneSpectrum (𝓞 L), P.asIdeal.LiesOver 𝔭.asIdeal →
        P.asIdeal.ramificationIdx (𝓞 K) = 1) :
    (artinSymHom (K := K) (L := L) hcomm m).ker.index = Module.finrank K L := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr (artinSymHom_surjective hcomm m hm hram),
    Subgroup.card_top, IsGalois.card_aut_eq_finrank]

end ArtinSurjective



end NK.CFTLib.ARL
