/-!
# A modulus with two independent elements of order divisible by `n`

This file proves `NK.CFTLib.ARL.exists_mod_order_independent` (van der Waerden's
lemmas 1–2, as used in Lang, *Algebraic Number Theory*, Chapter X §2, and in the proof of
Artin's lemma): for `a > 1`, `n > 0` and a finite set `S` of primes, there are `m > 0` and
`b` such that

* no prime of `S` divides `m`, and every prime dividing `m` divides neither `a` nor `b`;
* `n ∣ orderOf (a mod m)` and `n ∣ orderOf (b mod m)`;
* the cyclic subgroups generated by `a` and by `b` inside `(ZMod m)ˣ` intersect trivially
  (the displayed condition `a ^ i = b ^ j → a ^ i = 1`).

The construction is `m = m₁ * q` where

* for every prime `ℓ ∣ n` a prime `p_ℓ ∤ a`, `p_ℓ ∉ S` is chosen with `ℓ ^ E_ℓ ∣ ord_{p_ℓ}(a)`
  (so that `n ∣ ord_{m₁}(a)` for `m₁ = ∏ p_ℓ`), and
* `q ≡ 1 + n [MOD n * rad n]` is a large prime chosen by Dirichlet so that `v_ℓ(q - 1) = v_ℓ(n)`
  for every `ℓ ∣ n`; then `b ≡ 1 (mod m₁)` and `b ≡ (element of order n) (mod q)`.

The three number-theoretic inputs are proved in the sibling files.
-/

namespace NK.CFTLib.ARL

/-- If `n ∣ q - 1` and `ℓ ^ (n.factorization ℓ + 1) ∤ q - 1` for every prime `ℓ ∣ n`, then
`n` is coprime to `(q - 1) / n`: the two numbers have complementary `ℓ`-parts. -/
lemma coprime_div_of_factorization_eq {n q : ℕ} (hn : n ≠ 0) (hq : 2 ≤ q) (hdvd : n ∣ q - 1)
    (hval : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ n → ¬ ℓ ^ (n.factorization ℓ + 1) ∣ q - 1) :
    n.Coprime ((q - 1) / n) := by
  have hq1 : q - 1 ≠ 0 := by omega
  have hm0 : (q - 1) / n ≠ 0 := by
    have hpos : 0 < (q - 1) / n :=
      Nat.div_pos (Nat.le_of_dvd (by omega) hdvd) (Nat.pos_of_ne_zero hn)
    omega
  rw [Nat.coprime_iff_gcd_eq_one]
  have hfac : (Nat.gcd n ((q - 1) / n)).factorization = 0 := by
    rw [Nat.factorization_gcd hn hm0]
    ext ℓ
    rw [Finsupp.inf_apply, Finsupp.zero_apply]
    rcases eq_or_ne (n.factorization ℓ) 0 with h0 | h0
    · simp [h0]
    · have hℓprime : ℓ.Prime := by
        by_contra h
        exact h0 (Nat.factorization_eq_zero_of_not_prime n h)
      have hℓdvd : ℓ ∣ n := Nat.dvd_of_factorization_pos h0
      have heq : (q - 1).factorization ℓ = n.factorization ℓ := by
        refine le_antisymm ?_ ((Nat.factorization_le_iff_dvd hn hq1).mpr hdvd ℓ)
        by_contra hcon
        push_neg at hcon
        exact hval ℓ hℓprime hℓdvd ((hℓprime.pow_dvd_iff_le_factorization hq1).mpr hcon)
      have hmiss : ((q - 1) / n).factorization ℓ = 0 := by
        rw [Nat.factorization_div hdvd, Finsupp.tsub_apply, heq, tsub_self]
      simp [hmiss]
  rcases (Nat.factorization_eq_zero_iff' _).mp hfac with h | h
  · exact absurd h (fun hh => by rw [Nat.gcd_eq_zero_iff] at hh; exact hn hh.1)
  · exact h

/-- If `ℓ ^ (n.factorization ℓ) ∣ i` for every prime `ℓ ∣ n`, then `n ∣ i`. -/
lemma dvd_of_forall_primeFactor_pow_dvd {n i : ℕ} (hn : n ≠ 0)
    (h : ∀ ℓ : ℕ, ℓ.Prime → ℓ ∣ n → ℓ ^ n.factorization ℓ ∣ i) : n ∣ i := by
  rw [Nat.dvd_iff_prime_pow_dvd_dvd]
  intro p k hp hpk
  rcases eq_or_ne k 0 with hk | hk
  · subst hk; simp
  · have hpdvd : p ∣ n := dvd_trans (dvd_pow_self p hk) hpk
    have hkle : k ≤ n.factorization p := (hp.pow_dvd_iff_le_factorization hn).mp hpk
    exact dvd_trans (pow_dvd_pow p hkle) (h p hp hpdvd)

/-- The multiplicative order of `a` in `ZMod p` is bounded by the order of `a` in `ZMod m`
whenever `p ∣ m`, by reduction. -/
lemma orderOf_dvd_orderOf_of_dvd {p m : ℕ} (h : p ∣ m) (a : ℕ) :
    orderOf ((a : ZMod p)) ∣ orderOf ((a : ZMod m)) := by
  have hfun : (ZMod.castHom h (ZMod p)).toMonoidHom (a : ZMod m) = (a : ZMod p) := by
    simp [ZMod.castHom_apply, ZMod.cast_natCast]
  have := orderOf_map_dvd (ZMod.castHom h (ZMod p)).toMonoidHom (a : ZMod m)
  rwa [hfun] at this

theorem exists_mod_order_independent (n a : ℕ) (ha : 1 < a) (hn : 0 < n) (S : Finset ℕ)
    (hS : ∀ p ∈ S, p.Prime) : ∃ m b : ℕ, 0 < m ∧ (∀ p ∈ S, ¬ p ∣ m) ∧ (∀ p : ℕ, p.Prime → p ∣ m → ¬ p ∣ a) ∧ (∀ p : ℕ, p.Prime → p ∣ m → ¬ p ∣ b) ∧ n ∣ orderOf ((a : ZMod m)) ∧ n ∣ orderOf ((b : ZMod m)) ∧ (∀ i j : ℕ, (a : ZMod m) ^ i = (b : ZMod m) ^ j → (a : ZMod m) ^ i = 1) := by
  classical
  rcases eq_or_ne n 1 with h1 | hn1
  · subst h1
    refine ⟨1, 1, one_pos, ?_, ?_, ?_, one_dvd _, one_dvd _, ?_⟩
    · intro p hpS hpdvd; exact (hS p hpS).not_dvd_one hpdvd
    · intro p hp hpdvd; exact absurd hpdvd hp.not_dvd_one
    · intro p hp hpdvd; exact absurd hpdvd hp.not_dvd_one
    · intro i j _; exact Subsingleton.elim _ _
  · have ha2 : 2 ≤ a := ha
    have hn2 : 2 ≤ n := by omega
    set B : ℕ := max a (S.sup id) with hBdef
    set P : Finset ℕ := n.primeFactors with hPdef
    have hPprime : ∀ ℓ ∈ P, ℓ.Prime := by
      intro ℓ hℓ; rw [hPdef] at hℓ; exact Nat.prime_of_mem_primeFactors hℓ
    have hPdvd : ∀ ℓ ∈ P, ℓ ∣ n := by
      intro ℓ hℓ; rw [hPdef] at hℓ; exact (Nat.mem_primeFactors.mp hℓ).2.1
    set Ef : ℕ → ℕ := fun ℓ => max (n.factorization ℓ) (Nat.log ℓ B + 1) with hEfdef
    have hEf_gt : ∀ ℓ ∈ P, B < ℓ ^ Ef ℓ := by
      intro ℓ hℓ
      have hℓ2 : 1 < ℓ := (hPprime ℓ hℓ).one_lt
      calc B < ℓ ^ (Nat.log ℓ B + 1) := Nat.lt_pow_succ_log_self hℓ2 B
        _ ≤ ℓ ^ Ef ℓ := Nat.pow_le_pow_right (le_of_lt hℓ2) (le_max_right _ _)
    have hEf_part : ∀ ℓ ∈ P, n.factorization ℓ ≤ Ef ℓ := fun ℓ _ => le_max_left _ _
    have hEf_ge1 : ∀ ℓ ∈ P, 1 ≤ Ef ℓ := fun ℓ _ =>
      le_trans (Nat.succ_le_succ (Nat.zero_le _)) (le_max_right _ _)
    -- existence of the primes `p ℓ`
    have hmain : ∀ ℓ ∈ P, ∃ p : ℕ, p.Prime ∧ ¬ p ∣ a ∧ ℓ ^ Ef ℓ ∣ orderOf ((a : ZMod p)) ∧
        B < p := by
      intro ℓ hℓP
      have hℓprime := hPprime ℓ hℓP
      rcases eq_or_ne ℓ 2 with h2 | h2
      · subst h2
        by_cases hodd : Odd a
        · obtain ⟨p, hp, hpa, hdiv, hlt⟩ :=
            exists_prime_dvd_orderOf_two a (Ef 2) ha2 hodd (hEf_ge1 2 hℓP)
          exact ⟨p, hp, hpa, hdiv, lt_trans (hEf_gt 2 hℓP) hlt⟩
        · have hne : ¬ a ≡ 1 [MOD 2] := by
            intro hcon
            exact hodd (by rw [Nat.odd_iff]; simpa [Nat.ModEq] using hcon)
          obtain ⟨p, hp, hpa, hdiv, hlt⟩ :=
            exists_prime_dvd_orderOf_not_modEq_one a 2 (Ef 2) ha2 (by norm_num) (hEf_ge1 2 hℓP) hne
          exact ⟨p, hp, hpa, hdiv, lt_trans (hEf_gt 2 hℓP) hlt⟩
      · have hoddℓ : Odd ℓ := hℓprime.odd_of_ne_two h2
        by_cases hcong : a ≡ 1 [MOD ℓ]
        · obtain ⟨p, hp, hpa, hdiv, hlt⟩ :=
            exists_prime_dvd_orderOf_modEq_one_odd a ℓ (Ef ℓ) ha2 hℓprime hoddℓ (hEf_ge1 ℓ hℓP) hcong
          exact ⟨p, hp, hpa, hdiv, lt_trans (hEf_gt ℓ hℓP) hlt⟩
        · obtain ⟨p, hp, hpa, hdiv, hlt⟩ :=
            exists_prime_dvd_orderOf_not_modEq_one a ℓ (Ef ℓ) ha2 hℓprime (hEf_ge1 ℓ hℓP) hcong
          exact ⟨p, hp, hpa, hdiv, lt_trans (hEf_gt ℓ hℓP) hlt⟩
    have hmain2 : ∃ p : ℕ → ℕ, ∀ ℓ ∈ P, (p ℓ).Prime ∧ ¬ p ℓ ∣ a ∧
        ℓ ^ Ef ℓ ∣ orderOf ((a : ZMod (p ℓ))) ∧ B < p ℓ := by
      have h : ∀ ℓ : ℕ, ∃ r : ℕ, ℓ ∈ P → ((r).Prime ∧ ¬ r ∣ a ∧
          ℓ ^ Ef ℓ ∣ orderOf ((a : ZMod r)) ∧ B < r) := by
        intro ℓ
        by_cases hℓ : ℓ ∈ P
        · obtain ⟨r, hr⟩ := hmain ℓ hℓ
          exact ⟨r, fun _ => hr⟩
        · exact ⟨0, fun hh => absurd hh hℓ⟩
      choose p hp using h
      exact ⟨p, fun ℓ hℓ => hp ℓ hℓ⟩
    obtain ⟨p, hp⟩ := hmain2
    set m₁ : ℕ := ∏ ℓ ∈ P, p ℓ with hm₁def
    have hp_dvd_m₁ : ∀ ℓ ∈ P, p ℓ ∣ m₁ := by
      intro ℓ hℓ; rw [hm₁def]; exact Finset.dvd_prod_of_mem _ hℓ
    have hm₁pos : 0 < m₁ := by
      rw [hm₁def]; exact Finset.prod_pos (fun ℓ hℓ => (hp ℓ hℓ).1.pos)
    -- the prime `q`
    obtain ⟨q, hqprime, hqB, hqdiv, hqval, u, huord⟩ :=
      exists_prime_units_order n (max m₁ B) hn
    have hqpos : 0 < q := hqprime.pos
    have hq_gt_m₁ : m₁ < q := lt_of_le_of_lt (le_max_left _ _) hqB
    have hq_gt_B : B < q := lt_of_le_of_lt (le_max_right _ _) hqB
    have hq_gt_a : a < q := by
      have : a ≤ max m₁ B := le_trans (le_max_left a (S.sup id)) (le_max_right _ _)
      omega
    have hqcop : m₁.Coprime q := by
      refine ((hqprime.coprime_iff_not_dvd).mpr ?_).symm
      intro hdvd
      have := Nat.le_of_dvd hm₁pos hdvd
      omega
    have hnm : n.Coprime ((q - 1) / n) :=
      coprime_div_of_factorization_eq hn.ne' hqprime.two_le hqdiv hqval
    -- the CRT system for `b`
    set bq : ℕ := (u : ZMod q).val with hbqdef
    have hbqval : (bq : ZMod q) = (u : ZMod q) := by
      rw [hbqdef]
      haveI : NeZero q := ⟨hqprime.ne_zero⟩
      exact ZMod.natCast_zmod_val _
    have hbqcop : bq.Coprime q := by
      rw [hbqdef]
      haveI : NeZero q := ⟨hqprime.ne_zero⟩
      exact (ZMod.unitsEquivCoprime (n := q) u).2
    obtain ⟨b, hbq_mod, hb1_mod⟩ :
        ∃ b : ℕ, b ≡ bq [MOD q] ∧ b ≡ 1 [MOD m₁] :=
      ⟨(Nat.chineseRemainder hqcop.symm bq 1 : ℕ),
        (Nat.chineseRemainder hqcop.symm bq 1).2.1,
        (Nat.chineseRemainder hqcop.symm bq 1).2.2⟩
    have hbq_cast : (b : ZMod q) = (u : ZMod q) :=
      (ZMod.natCast_eq_natCast_iff b bq q).mpr hbq_mod |>.trans hbqval
    have hbq_ord : orderOf ((b : ZMod q)) = n := by
      rw [hbq_cast, orderOf_units]; exact huord
    set m : ℕ := m₁ * q with hmdef
    have hm₁dvd_m : m₁ ∣ m := by rw [hmdef]; exact dvd_mul_right m₁ q
    have hqdvd_m : q ∣ m := by rw [hmdef]; exact dvd_mul_left q m₁
    -- every prime divisor of `m` is one of the `p ℓ` or `q`
    have hprimes_m : ∀ r : ℕ, r.Prime → r ∣ m → (∃ ℓ ∈ P, r = p ℓ) ∨ r = q := by
      intro r hr hrd
      rw [hmdef] at hrd
      rcases (hr.dvd_mul).mp hrd with h | h
      · left
        obtain ⟨ℓ, hℓP, hℓdvd⟩ := (Prime.dvd_finsetProd_iff (Nat.prime_iff.mp hr)
          (fun ℓ => p ℓ)).mp (by rwa [hm₁def] at h)
        exact ⟨ℓ, hℓP, (((hp ℓ hℓP).1.dvd_iff_eq hr.ne_one).mp hℓdvd).symm⟩
      · right
        exact ((hqprime.dvd_iff_eq hr.ne_one).mp h).symm
    refine ⟨m, b, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hmdef]; exact Nat.mul_pos hm₁pos hqpos
    · intro r hrS hrdvd
      have hrprime : r.Prime := hS r hrS
      have hrB : r ≤ B := by
        rw [hBdef]
        exact le_trans (Finset.le_sup (f := id) hrS) (le_max_right _ _)
      rcases hprimes_m r hrprime hrdvd with ⟨ℓ, hℓP, heq⟩ | heq
      · have := (hp ℓ hℓP).2.2.2
        omega
      · omega
    · intro r hrprime hrdvd hra
      rcases hprimes_m r hrprime hrdvd with ⟨ℓ, hℓP, heq⟩ | heq
      · exact (hp ℓ hℓP).2.1 (heq ▸ hra)
      · refine absurd (heq ▸ hra) ?_
        intro hqa
        have := Nat.le_of_dvd (by omega : 0 < a) hqa
        omega
    · intro r hrprime hrdvd hrb
      rcases hprimes_m r hrprime hrdvd with ⟨ℓ, hℓP, heq⟩ | heq
      · have hbmod : b ≡ 1 [MOD p ℓ] := hb1_mod.of_dvd (hp_dvd_m₁ ℓ hℓP)
        have hnb : ¬ p ℓ ∣ b := by
          intro hdvd2
          have h0 : b % p ℓ = 0 := Nat.mod_eq_zero_of_dvd hdvd2
          have h1 : b % p ℓ = 1 % p ℓ := hbmod
          have h2 : 1 % p ℓ = 1 := Nat.mod_eq_of_lt (hp ℓ hℓP).1.one_lt
          omega
        exact hnb (heq ▸ hrb)
      · have hnb : ¬ q ∣ b := by
          intro hdvd2
          have h0 : b % q = 0 := Nat.mod_eq_zero_of_dvd hdvd2
          have h1 : b % q = bq % q := hbq_mod
          have h2 : bq % q = 0 := by omega
          have h3 : q ∣ bq := Nat.dvd_of_mod_eq_zero h2
          exact (hqprime.coprime_iff_not_dvd.mp hbqcop.symm) h3
        exact hnb (heq ▸ hrb)
    · -- `n ∣ orderOf (a : ZMod m)`
      refine dvd_of_forall_primeFactor_pow_dvd hn.ne' (fun ℓ hℓprime hℓdvd => ?_)
      have hℓP : ℓ ∈ P := by
        rw [hPdef, Nat.mem_primeFactors]
        exact ⟨hℓprime, hℓdvd, hn.ne'⟩
      have h1 : ℓ ^ Ef ℓ ∣ orderOf ((a : ZMod m₁)) :=
        dvd_trans (hp ℓ hℓP).2.2.1 (orderOf_dvd_orderOf_of_dvd (hp_dvd_m₁ ℓ hℓP) a)
      have h2 : orderOf ((a : ZMod m₁)) ∣ orderOf ((a : ZMod m)) :=
        orderOf_dvd_orderOf_of_dvd hm₁dvd_m a
      exact dvd_trans (pow_dvd_pow ℓ (hEf_part ℓ hℓP)) (dvd_trans h1 h2)
    · -- `n ∣ orderOf (b : ZMod m)`
      rw [← hbq_ord]
      exact orderOf_dvd_orderOf_of_dvd hqdvd_m b
    · -- independence
      intro i j hij
      have hmod₁ : (a : ZMod m₁) ^ i = 1 := by
        have h1 : (a : ZMod m₁) ^ i = (b : ZMod m₁) ^ j := by
          have h2 := congrArg (ZMod.castHom hm₁dvd_m (ZMod m₁)) hij
          simp only [map_pow, ZMod.castHom_apply, ZMod.cast_natCast hm₁dvd_m] at h2
          exact h2
        have h3 : (b : ZMod m₁) = 1 := by
          simpa using (ZMod.natCast_eq_natCast_iff b 1 m₁).mpr hb1_mod
        rw [h3, one_pow] at h1
        exact h1
      have hni : n ∣ i := by
        refine dvd_of_forall_primeFactor_pow_dvd hn.ne' (fun ℓ hℓprime hℓdvd => ?_)
        have hℓP : ℓ ∈ P := by
          rw [hPdef, Nat.mem_primeFactors]
          exact ⟨hℓprime, hℓdvd, hn.ne'⟩
        have hord : orderOf ((a : ZMod m₁)) ∣ i := orderOf_dvd_iff_pow_eq_one.mpr hmod₁
        exact dvd_trans (pow_dvd_pow ℓ (hEf_part ℓ hℓP))
          (dvd_trans (dvd_trans (hp ℓ hℓP).2.2.1
            (orderOf_dvd_orderOf_of_dvd (hp_dvd_m₁ ℓ hℓP) a)) hord)
      have hmodq : (a : ZMod q) ^ i = 1 := by
        obtain ⟨k, hk⟩ := hni
        have hq1 : (a : ZMod q) ^ i = (b : ZMod q) ^ j := by
          have h2 := congrArg (ZMod.castHom hqdvd_m (ZMod q)) hij
          simp only [map_pow, ZMod.castHom_apply, ZMod.cast_natCast hqdvd_m] at h2
          exact h2
        have hA : ((a : ZMod q) ^ n) ^ k = (b : ZMod q) ^ j := by
          rw [← pow_mul, ← hk]
          exact hq1
        have hpow : ((a : ZMod q) ^ n) ^ (k * n) = 1 := by
          rw [pow_mul, hA, ← pow_mul, mul_comm j n, pow_mul]
          rw [← hbq_ord, pow_orderOf_eq_one, one_pow]
        have hordA : orderOf ((a : ZMod q) ^ n) ∣ k * n :=
          orderOf_dvd_iff_pow_eq_one.mpr hpow
        have hA_dvd : orderOf ((a : ZMod q) ^ n) ∣ (q - 1) / n := by
          rw [orderOf_dvd_iff_pow_eq_one, ← pow_mul, Nat.mul_div_cancel' hqdiv]
          haveI : Fact q.Prime := ⟨hqprime⟩
          refine ZMod.pow_card_sub_one_eq_one (a := (a : ZMod q)) ?_
          intro hcon
          have hdvd : q ∣ a := Int.natCast_dvd_natCast.mp
            ((ZMod.intCast_zmod_eq_zero_iff_dvd (a : ℤ) q).mp (by simpa using hcon))
          have := Nat.le_of_dvd (by omega : 0 < a) hdvd
          omega
        have hcop : Nat.Coprime n (orderOf ((a : ZMod q) ^ n)) :=
          Nat.Coprime.coprime_dvd_right hA_dvd hnm
        have hAk : ((a : ZMod q) ^ n) ^ k = 1 :=
          orderOf_dvd_iff_pow_eq_one.mp (hcop.symm.dvd_of_dvd_mul_right hordA)
        rw [hk, pow_mul]
        exact hAk
      have h1 : ((m₁ : ℤ)) ∣ (a : ℤ) ^ i - 1 := by
        refine (ZMod.intCast_zmod_eq_zero_iff_dvd _ m₁).mp ?_
        push_cast
        rw [hmod₁, sub_self]
      have h2 : ((q : ℤ)) ∣ (a : ℤ) ^ i - 1 := by
        refine (ZMod.intCast_zmod_eq_zero_iff_dvd _ q).mp ?_
        push_cast
        rw [hmodq, sub_self]
      have h3 : ((m₁ : ℤ) * (q : ℤ)) ∣ (a : ℤ) ^ i - 1 :=
        (Nat.isCoprime_iff_coprime.mpr hqcop).mul_dvd h1 h2
      have h4 : ((m : ℕ) : ℤ) ∣ (a : ℤ) ^ i - 1 := by
        rw [hmdef]; push_cast; exact h3
      have h5 : ((((a : ℤ) ^ i - 1 : ℤ)) : ZMod m) = 0 :=
        (ZMod.intCast_zmod_eq_zero_iff_dvd _ m).mpr h4
      push_cast at h5
      exact sub_eq_zero.mp h5

end NK.CFTLib.ARL
