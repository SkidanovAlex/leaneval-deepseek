/-!
# T3 in the clean universe: the inflation–restriction descent

The clean (cycle-free) version of the descent step of the Brauer transfer: for a tower
`K ⊆ M ⊆ E` of finite Galois extensions of number fields, an `α ∈ H²(Gal(E/K), Eˣ)` in the kernel
of the restriction to `Gal(E/M)` comes from the level `M/K`, of the explicit form
`α = inflation (cycClassOf g hg b)` for some `b ∈ Kˣ`.

This assembles `NK.CFTLib.HRclean.T3.exists_inflation_eq_of_resToGal_eq_zero` (the
inflation–restriction exactness + Galois descent, copied from the on-disk proof) with the
periodicity of the cyclic class (`NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass` + Galois
descent for the units).
-/

open CategoryTheory

namespace NK.CFTLib.HRclean.T3

/-- **Periodicity of the cyclic class, for a prescribed generator.**  Every class
`β ∈ H²(Gal(M/K), Mˣ)` is the cyclic class of a global element `b ∈ Kˣ`, for any fixed generator
`g` of the (cyclic) Galois group. -/
theorem exists_cycClassOf_eq {K M : Type} [Field K] [NumberField K] [Field M]
    [NumberField M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (g : M ≃ₐ[K] M) (hg : ∀ σ : M ≃ₐ[K] M, σ ∈ Subgroup.zpowers g)
    (β : groupCohomology (NK.HassePrinciple.unitsRep K M) 2) :
    ∃ b : Kˣ, NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := M) g hg b = β := by
  obtain ⟨a, ha, hcls⟩ := NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass
    (NK.HassePrinciple.unitsRep K M) g hg β
  set a' : Mˣ := Additive.toMul a with ha'_def
  have hfix : ∀ σ : M ≃ₐ[K] M, Units.map σ.toMonoidHom a' = a' := by
    intro σ
    have h1 := ha σ
    have h2 : (NK.HassePrinciple.unitsRep K M).ρ σ a
        = Additive.ofMul (Units.map σ.toMonoidHom (Additive.toMul a)) := rfl
    rw [h2, ← ha'_def] at h1
    exact Additive.ofMul.injective h1
  have hfix' : ∀ σ : M ≃ₐ[K] M, σ (a' : M) = (a' : M) := by
    intro σ
    have h1 := hfix σ
    have h2 := congrArg (fun u : Mˣ => (u : M)) h1
    rw [Units.coe_map] at h2
    exact h2
  obtain ⟨k, hk⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := K) (E := M)
    (a' : M)).mpr hfix'
  have hk0 : k ≠ 0 := by
    intro h0
    have h1 : (a' : M) = 0 := by rw [← hk, h0]; simp
    exact a'.ne_zero h1
  refine ⟨Units.mk0 k hk0, ?_⟩
  have h3 : Units.map (algebraMap K M).toMonoidHom (Units.mk0 k hk0) = a' := by
    apply Units.ext
    rw [Units.coe_map]
    simpa using hk
  have hunits : NK.CFTLib.IdeleHasse.Descent.unitsImage (K := K) (F := M)
      (Units.mk0 k hk0) = a := by
    rw [NK.CFTLib.IdeleHasse.Descent.unitsImage, h3, ha'_def]
    rfl
  rw [NK.CFTLib.IdeleHasse.Descent.cycClassOf]
  subst hunits
  exact hcls

/-- **The descent (re-gluing) step of the Brauer transfer** (T3), clean version.

For a tower `K ⊆ M ⊆ E` of finite Galois extensions of number fields with `E` generated by the
images of `L` and `M`, a class `α ∈ H²(Gal(E/K), Eˣ)` whose restriction to `Gal(E/M)` vanishes is
the inflation of the cyclic class of a global element `b ∈ Kˣ` at the level `M/K`. -/
theorem exists_cycClassOf_of_res_eq_zero {K L M E : Type} [Field K] [NumberField K] [Field L]
    [NumberField L] [Field M] [NumberField M] [Field E] [NumberField E] [Algebra K L]
    [Algebra K M] [Algebra K E] [Algebra L E] [Algebra M E] [IsScalarTower K L E]
    [IsScalarTower K M E] [FiniteDimensional K L] [FiniteDimensional K M] [FiniteDimensional K E]
    [IsGalois K L] [IsGalois K M] [IsGalois K E] [IsGalois M E]
    (hgen : Algebra.adjoin K (Set.range (algebraMap L E) ∪ Set.range (algebraMap M E)) = ⊤)
    (g : M ≃ₐ[K] M) (hg : ∀ σ : M ≃ₐ[K] M, σ ∈ Subgroup.zpowers g)
    (α : groupCohomology (NK.HassePrinciple.unitsRep K E) 2)
    (hα : (NK.CFTLib.HRclean.Cheb.resToGal K M E).hom α = 0) :
    ∃ (b : Kˣ), α = (NK.CFTLib.HRclean.ARL.inflation (K := K) (L := M) (E := E)).hom
            (NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := M) g hg b) := by
  obtain ⟨β, hβ⟩ := exists_inflation_eq_of_resToGal_eq_zero (K := K) (M := M) (E := E) α hα
  obtain ⟨b, hb⟩ := exists_cycClassOf_eq (K := K) (M := M) g hg β
  exact ⟨b, hβ.symm.trans (congrArg _ hb.symm)⟩

end NK.CFTLib.HRclean.T3
