open Finset

/-! ## Subgroups of a cyclic group -/

/-- **A subgroup of a cyclic group is determined by its order.**  If `K` is a subgroup of the
cyclic group `⟨γ⟩`, of cardinality `d` dividing the order of `γ`, then `K` is the subgroup
generated by `γ ^ (orderOf γ / d)`. -/
lemma subgroup_eq_zpowers_of_card {G : Type*} [Group G] [Fintype G] {γ : G} {K : Subgroup G}
    (hK : K ≤ Subgroup.zpowers γ) {d : ℕ} (hcard : Nat.card K = d) (hdvd : d ∣ orderOf γ) :
    K = Subgroup.zpowers (γ ^ (orderOf γ / d)) := by
  obtain ⟨k, rfl⟩ := (Subgroup.le_zpowers_iff γ K).mp hK
  have h1 : orderOf (γ ^ k) = d := by rw [← Nat.card_zpowers, hcard]
  rw [orderOf_pow] at h1
  set m := orderOf γ with hm
  have hdpos : 0 < d := by rw [← hcard]; exact Nat.card_pos
  have hmpos : 0 < m := hm ▸ orderOf_pos γ
  have hg1 : m.gcd k ∣ m := Nat.gcd_dvd_left m k
  have hg2 : m.gcd k ∣ k := Nat.gcd_dvd_right m k
  have e1 : m.gcd k * d = m := by rw [← h1]; exact Nat.mul_div_cancel' hg1
  have e2 : (m / d) * d = m := Nat.div_mul_cancel hdvd
  have hmd : m.gcd k = m / d := by
    apply Nat.mul_right_cancel hdpos
    rw [e1, e2]
  have hk : m / d ∣ k := hmd ▸ hg2
  obtain ⟨k₁, hk₁⟩ := hk
  have hmem : γ ^ k ∈ Subgroup.zpowers (γ ^ (m / d)) := by
    rw [hk₁, pow_mul]
    exact Subgroup.npow_mem_zpowers _ _
  refine Subgroup.eq_of_le_of_card_ge (Subgroup.zpowers_le.mpr hmem) ?_
  have hgcd : m.gcd (m / d) = m / d := Nat.gcd_eq_right (Nat.div_dvd_of_dvd hdvd)
  have hcard2 : Nat.card (Subgroup.zpowers (γ ^ (m / d))) = d := by
    rw [Nat.card_zpowers, orderOf_pow, hgcd]
    exact Nat.div_div_self hdvd hmpos.ne'
  rw [hcard2, hcard]

/-- Elements generating the same cyclic subgroup have the same fixed-point count. -/
lemma fixedCount_congr_of_zpowers_eq {G X : Type*} [Group G] [MulAction G X] {g g' : G}
    (h : Subgroup.zpowers g = Subgroup.zpowers g') : fixedCount g X = fixedCount g' X := by
  have hfix : MulAction.fixedBy X g = MulAction.fixedBy X g' := by
    ext x
    simp only [MulAction.mem_fixedBy]
    constructor
    · intro hx
      have h1 : g ∈ MulAction.stabilizer G x := (MulAction.mem_stabilizer_iff).mpr hx
      have h2 : Subgroup.zpowers g ≤ MulAction.stabilizer G x := Subgroup.zpowers_le.mpr h1
      rw [h] at h2
      exact (MulAction.mem_stabilizer_iff).mp (h2 (Subgroup.mem_zpowers g'))
    · intro hx
      have h1 : g' ∈ MulAction.stabilizer G x := (MulAction.mem_stabilizer_iff).mpr hx
      have h2 : Subgroup.zpowers g' ≤ MulAction.stabilizer G x := Subgroup.zpowers_le.mpr h1
      rw [← h] at h2
      exact (MulAction.mem_stabilizer_iff).mp (h2 (Subgroup.mem_zpowers g))
  have e1 : fixedCount g X = Nat.card (MulAction.fixedBy X g) := rfl
  have e2 : fixedCount g' X = Nat.card (MulAction.fixedBy X g') := rfl
  rw [e1, e2, hfix]

/-- The element `σ ^ (orderOf σ / m)` has order `m`, for `m ∣ orderOf σ`. -/
lemma orderOf_pow_div_eq {G : Type*} [Group G] [Fintype G] (σ : G) {m : ℕ}
    (hm : m ∣ orderOf σ) : orderOf (σ ^ (orderOf σ / m)) = m := by
  have hmpos : 0 < m := Nat.pos_of_dvd_of_pos hm (orderOf_pos σ)
  have hndvd : orderOf σ / m ∣ orderOf σ := Nat.div_dvd_of_dvd hm
  exact (by rw [orderOf_pow, Nat.gcd_eq_right hndvd, Nat.div_div_self hm (orderOf_pos σ).ne'] :
    orderOf (σ ^ (orderOf σ / m)) = m)

/-- **Grouping elements of `⟨σ ^ (orderOf σ / m)⟩` by their order.**  An element `g` of order `d`
of the subgroup generated by `σ ^ (orderOf σ / m)` generates the same subgroup as `σ ^ (orderOf σ / d)`,
hence has the same fixed-point count. -/
lemma fixedCount_eq_of_orderOf_eq {G X : Type*} [Group G] [Fintype G] [MulAction G X]
    (σ : G) {m d : ℕ} (hm : m ∣ orderOf σ) (hd : d ∣ m)
    {g : Subgroup.zpowers (σ ^ (orderOf σ / m))} (hg : orderOf (g : G) = d) :
    fixedCount (g : G) X = fixedCount (σ ^ (orderOf σ / d)) X := by
  have hdvd : d ∣ orderOf σ := hd.trans hm
  have h1 : Subgroup.zpowers (σ ^ (orderOf σ / m)) ≤ Subgroup.zpowers σ :=
    Subgroup.zpowers_le.mpr (Subgroup.npow_mem_zpowers σ _)
  have h3 : (g : G) ∈ Subgroup.zpowers σ := h1 g.2
  have hK : Subgroup.zpowers (g : G) ≤ Subgroup.zpowers σ := Subgroup.zpowers_le.mpr h3
  have hcard : Nat.card (Subgroup.zpowers (g : G)) = d := by rw [Nat.card_zpowers, hg]
  exact fixedCount_congr_of_zpowers_eq (subgroup_eq_zpowers_of_card hK hcard hdvd)

/-! ## The Burnside relation -/

/-- **Burnside's lemma, grouped by order.**  Let `σ` be an element of a finite group `G` acting on a
finite set `X`, and let `m ∣ orderOf σ`.  Then the number of orbits of the cyclic subgroup
`⟨σ ^ (orderOf σ / m)⟩` of order `m`, multiplied by `m`, is the sum over the divisors `d ∣ m` of
`Nat.totient d` times the number of points fixed by `σ ^ (orderOf σ / d)`. -/
lemma card_mul_orbitCount_eq_sum_totient {G : Type*} [Group G] [Fintype G]
    (σ : G) (X : Type*) [MulAction G X] [Finite X] (m : ℕ) (hm : m ∣ orderOf σ) :
    Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) * orbitCount (σ ^ (orderOf σ / m)) X
      = ∑ d ∈ m.divisors, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X := by
  classical
  have hFX : Fintype X := Fintype.ofFinite X
  letI := hFX
  have hmpos : 0 < m := Nat.pos_of_dvd_of_pos hm (orderOf_pos σ)
  have hG'card : Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) = m := by
    rw [Nat.card_zpowers, orderOf_pow_div_eq σ hm]
  -- Burnside's lemma for the subgroup `⟨σ ^ (orderOf σ / m)⟩`
  have hburn : Nat.card (MulAction.orbitRel.Quotient (Subgroup.zpowers (σ ^ (orderOf σ / m))) X)
      * Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m)))
      = ∑ g : Subgroup.zpowers (σ ^ (orderOf σ / m)), Nat.card (MulAction.fixedBy X g) := by
    rw [Finset.sum_congr rfl (fun g (_ : g ∈ Finset.univ) =>
      Nat.card_eq_fintype_card (α := MulAction.fixedBy X g))]
    rw [Nat.card_eq_fintype_card
        (α := MulAction.orbitRel.Quotient (Subgroup.zpowers (σ ^ (orderOf σ / m))) X),
      Nat.card_eq_fintype_card (α := Subgroup.zpowers (σ ^ (orderOf σ / m)))]
    exact (MulAction.sum_card_fixedBy_eq_card_orbits_mul_card_group
      (Subgroup.zpowers (σ ^ (orderOf σ / m))) X).symm
  have hstep1 : Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) * orbitCount (σ ^ (orderOf σ / m)) X
      = ∑ g : Subgroup.zpowers (σ ^ (orderOf σ / m)), Nat.card (MulAction.fixedBy X g) := by
    rw [orbitCount, mul_comm]
    exact hburn
  -- group the elements of the subgroup by their order
  have hfiber := Finset.sum_fiberwise_of_maps_to
      (s := (Finset.univ : Finset (Subgroup.zpowers (σ ^ (orderOf σ / m))))) (t := m.divisors)
      (g := fun g : Subgroup.zpowers (σ ^ (orderOf σ / m)) => orderOf (g : G))
      (f := fun g : Subgroup.zpowers (σ ^ (orderOf σ / m)) => Nat.card (MulAction.fixedBy X g))
      (fun i _ => by
        rw [Nat.mem_divisors]
        refine ⟨?_, hmpos.ne'⟩
        rw [Subgroup.orderOf_coe]
        have h' : orderOf i ∣ Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) :=
          orderOf_dvd_natCard i
        rwa [hG'card] at h')
  rw [hstep1, ← hfiber]
  refine Finset.sum_congr rfl ?_
  intro d hd
  have hdm : d ∣ m := (Nat.mem_divisors.mp hd).1
  have hconst : ∀ g ∈ Finset.univ.filter
        (fun g : Subgroup.zpowers (σ ^ (orderOf σ / m)) => orderOf (g : G) = d),
      Nat.card (MulAction.fixedBy X g) = fixedCount (σ ^ (orderOf σ / d)) X := by
    intro g hg
    rw [Finset.mem_filter] at hg
    exact fixedCount_eq_of_orderOf_eq (X := X) σ hm hdm (g := g) hg.2
  rw [Finset.sum_congr rfl hconst, Finset.sum_const, nsmul_eq_mul]
  congr 1
  have hs : (Finset.univ.filter
        (fun g : Subgroup.zpowers (σ ^ (orderOf σ / m)) => orderOf (g : G) = d))
      = (Finset.univ.filter
        (fun g : Subgroup.zpowers (σ ^ (orderOf σ / m)) => orderOf g = d)) := by
    ext g
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Subgroup.orderOf_coe]
  rw [hs]
  exact IsCyclic.card_orderOf_eq_totient
    (by rw [← Nat.card_eq_fintype_card, hG'card]; exact hdm)

/-! ## The main theorem -/

theorem fixedCount_eq_of_orbitCount_eq {G X Y : Type*} [Group G] [Fintype G] [MulAction G X]
    [MulAction G Y] [Finite X] [Finite Y] (σ : G)
    (h : ∀ i : ℕ, NK.WeakNU.orbitCount (σ ^ i) X = NK.WeakNU.orbitCount (σ ^ i) Y) :
    NK.WeakNU.fixedCount σ X = NK.WeakNU.fixedCount σ Y := by
  classical
  -- For every `m ∣ orderOf σ`, the fixed-point counts of `σ ^ (orderOf σ / m)` agree.
  have hP : ∀ m, (m ∣ orderOf σ) →
      fixedCount (σ ^ (orderOf σ / m)) X = fixedCount (σ ^ (orderOf σ / m)) Y := by
    intro m
    refine Nat.strong_induction_on m (fun m ih hm => ?_)
    have hmpos : 0 < m := Nat.pos_of_dvd_of_pos hm (orderOf_pos σ)
    have hX := card_mul_orbitCount_eq_sum_totient σ X m hm
    have hY := card_mul_orbitCount_eq_sum_totient σ Y m hm
    have hL : Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) * orbitCount (σ ^ (orderOf σ / m)) X
        = Nat.card (Subgroup.zpowers (σ ^ (orderOf σ / m))) * orbitCount (σ ^ (orderOf σ / m)) Y := by
      rw [h (orderOf σ / m)]
    have hS : ∑ d ∈ m.divisors, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X
        = ∑ d ∈ m.divisors, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) Y := by
      rw [← hX, ← hY]
      exact hL
    have hmemm : m ∈ m.divisors := Nat.mem_divisors.mpr ⟨dvd_rfl, hmpos.ne'⟩
    have hXm : Nat.totient m * fixedCount (σ ^ (orderOf σ / m)) X
        + ∑ d ∈ m.divisors.erase m, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X
        = ∑ d ∈ m.divisors, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X :=
      Finset.add_sum_erase m.divisors
        (fun d => Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X) hmemm
    have hYm : Nat.totient m * fixedCount (σ ^ (orderOf σ / m)) Y
        + ∑ d ∈ m.divisors.erase m, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) Y
        = ∑ d ∈ m.divisors, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) Y :=
      Finset.add_sum_erase m.divisors
        (fun d => Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) Y) hmemm
    rw [← hXm, ← hYm] at hS
    have hErase : ∑ d ∈ m.divisors.erase m, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) X
        = ∑ d ∈ m.divisors.erase m, Nat.totient d * fixedCount (σ ^ (orderOf σ / d)) Y := by
      refine Finset.sum_congr rfl ?_
      intro d hd
      rw [Finset.mem_erase] at hd
      have hdm : d ∣ m := (Nat.mem_divisors.mp hd.2).1
      have hdlt : d < m := Nat.lt_of_le_of_ne (Nat.le_of_dvd hmpos hdm) hd.1
      rw [ih d hdlt (hdm.trans hm)]
    rw [hErase] at hS
    exact Nat.mul_left_cancel (Nat.totient_pos.mpr hmpos) (Nat.add_right_cancel hS)
  have hfin := hP (orderOf σ) dvd_rfl
  rwa [Nat.div_self (orderOf_pos σ), pow_one] at hfin

end

end NK.WeakNU
