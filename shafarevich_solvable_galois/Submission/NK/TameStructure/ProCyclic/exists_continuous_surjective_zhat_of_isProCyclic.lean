/-! ## Separation by finite quotients -/

/-- **An element of every open normal subgroup is trivial.**  In a compact totally disconnected
group the open normal subgroups have trivial intersection. -/
theorem eq_one_of_mem_openNormalSubgroups {z : H}
    (hz : ∀ N : OpenNormalSubgroup H, z ∈ N) : z = 1 := by
  by_contra hz1
  have hU : IsOpen ({z}ᶜ : Set H) := isClosed_singleton.isOpen_compl
  have h1U : (1 : H) ∈ ({z}ᶜ : Set H) := by
    simp only [Set.mem_compl_iff, Set.mem_singleton_iff]
    exact fun h => hz1 h.symm
  obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hU h1U
  exact (hN (hz N)) (by simp)

/-- **Separation by finite quotients.**  Two elements of a profinite group with the same image in
every finite quotient coincide. -/
theorem eq_of_forall_mk'_eq {x y : H}
    (h : ∀ N : OpenNormalSubgroup H,
      QuotientGroup.mk' N.toSubgroup x = QuotientGroup.mk' N.toSubgroup y) : x = y := by
  have hmem : ∀ N : OpenNormalSubgroup H, x * y⁻¹ ∈ N := by
    intro N
    have h2 : QuotientGroup.mk' N.toSubgroup (x * y⁻¹) = 1 := by
      rw [map_mul, map_inv, h N, mul_inv_cancel]
    rw [QuotientGroup.mk'_apply] at h2
    exact (QuotientGroup.eq_one_iff (x * y⁻¹)).mp h2
  have h1 : x * y⁻¹ = 1 := eq_one_of_mem_openNormalSubgroups hmem
  exact mul_inv_eq_one.mp h1

/-! ## Compatibility of the component maps -/

/-- The transition homomorphism `H ⧸ M →* H ⧸ N` for `M ≤ N` is continuous. -/
theorem continuous_quotient_map_of_le {M N : Subgroup H} [M.Normal] [N.Normal] (hle : M ≤ N) :
    Continuous (QuotientGroup.map M N (MonoidHom.id H) (by simpa using hle)) := by
  rw [(QuotientGroup.isQuotientMap_mk M).continuous_iff]
  have hid : (QuotientGroup.map M N (MonoidHom.id H) (by simpa using hle)) ∘
      (QuotientGroup.mk : H → H ⧸ M) = QuotientGroup.mk := by
    funext x
    rw [Function.comp_apply, QuotientGroup.map_mk]
    rfl
  rw [hid]
  exact QuotientGroup.continuous_mk

/-- **Compatibility of the component maps.**  For open normal subgroups `M ≤ N`, the transition
map `H ⧸ M →* H ⧸ N` carries `famHom g M z` to `famHom g N z`.  Both sides are continuous
homomorphisms `Ẑ →* H ⧸ N` whose composites with the dense inclusion of `ℤ` are equal. -/
theorem famHom_compat (g : H) {M N : OpenNormalSubgroup H} (hle : M.toSubgroup ≤ N.toSubgroup)
    (z : Zhat) :
    (QuotientGroup.map M.toSubgroup N.toSubgroup (MonoidHom.id H) (by simpa using hle))
        (famHom g M z) = famHom g N z := by
  set ψ : Zhat →* (H ⧸ N.toSubgroup) :=
    (QuotientGroup.map M.toSubgroup N.toSubgroup (MonoidHom.id H) (by simpa using hle)).comp
      (famHom g M) with hψ
  have hcont : Continuous ψ :=
    (continuous_quotient_map_of_le (M := M.toSubgroup) (N := N.toSubgroup) hle).comp
      (famHom_cont g M)
  have heq : ψ ∘ (ProfiniteCompletion.eta ZGrp) = (famHom g N) ∘ (ProfiniteCompletion.eta ZGrp) := by
    funext m
    simp only [Function.comp_apply, hψ, MonoidHom.comp_apply]
    rw [famHom_eta g M m, famHom_eta g N m, map_zpow, QuotientGroup.map_mk',
      MonoidHom.id_apply, QuotientGroup.mk'_apply]
  have h2 : ⇑ψ = ⇑(famHom g N) :=
    DenseRange.equalizer denseRange_eta hcont (famHom_cont g N) heq
  exact congrFun h2 z

/-! ## Gluing the compatible family -/

/-- **Existence of a compatible element.**  Given `z : Ẑ`, there is an element of `H` whose image
in every finite quotient is the prescribed `famHom g N z`.

Each set `{x | xN = famHom g N z}` is closed, being the preimage of a point under the continuous
projection `H → H ⧸ N` (the quotient is Hausdorff).  The finite intersection property holds:
given finitely many `N`, an element of `H` whose image modulo their intersection `M` (again open
normal) is `famHom g M z` has the prescribed images modulo each `N`, by compatibility.
Compactness of `H` then supplies a common element. -/
theorem exists_mk'_eq_famHom (g : H) (z : Zhat) :
    ∃ x : H, ∀ N : OpenNormalSubgroup H, QuotientGroup.mk' N.toSubgroup x = famHom g N z := by
  have hfip : ∀ s : Finset (OpenNormalSubgroup H),
      (⋂ N ∈ s, {x : H | QuotientGroup.mk' N.toSubgroup x = famHom g N z}).Nonempty := by
    intro s
    have hmain : ∃ x : H, ∀ N ∈ s, QuotientGroup.mk' N.toSubgroup x = famHom g N z := by
      set Msub : Subgroup H := ⨅ N : s, ((N : OpenNormalSubgroup H) : Subgroup H) with hMsub
      have hMopen : IsOpen (Msub : Set H) := by
        rw [hMsub, Subgroup.coe_iInf]
        exact isOpen_iInter_of_finite fun N => (N : OpenNormalSubgroup H).isOpen'
      have hMnorm : Msub.Normal :=
        Subgroup.normal_iInf_normal fun N => (N : OpenNormalSubgroup H).isNormal'
      let M : OpenNormalSubgroup H := ⟨⟨Msub, hMopen⟩, hMnorm⟩
      have hMto : M.toSubgroup = Msub := rfl
      obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective M.toSubgroup (famHom g M z)
      refine ⟨x, fun N hN => ?_⟩
      have hle : M.toSubgroup ≤ N.toSubgroup := by
        rw [hMto]
        intro y hy
        exact iInf_le (fun N : s => ((N : OpenNormalSubgroup H) : Subgroup H)) ⟨N, hN⟩ hy
      have h1 : (QuotientGroup.map M.toSubgroup N.toSubgroup (MonoidHom.id H) (by simpa using hle))
          (QuotientGroup.mk' M.toSubgroup x) = QuotientGroup.mk' N.toSubgroup x := by
        rw [QuotientGroup.map_mk']
        rfl
      rw [← h1, hx, famHom_compat g hle z]
    obtain ⟨x, hx⟩ := hmain
    exact ⟨x, by simpa only [Set.mem_iInter, Set.mem_ofPred_eq] using hx⟩
  obtain ⟨x, hx⟩ := CompactSpace.iInter_nonempty
    (t := fun N : OpenNormalSubgroup H =>
      {x : H | QuotientGroup.mk' N.toSubgroup x = famHom g N z})
    (fun N => by
      have hc : Continuous (QuotientGroup.mk' N.toSubgroup : H → H ⧸ N.toSubgroup) :=
        QuotientGroup.continuous_mk (N := N.toSubgroup)
      exact isClosed_singleton.preimage hc)
    hfip
  exact ⟨x, fun N => Set.mem_iInter.mp hx N⟩

/-- The chosen element of `H` whose images in all finite quotients are the prescribed
`famHom g N z`. -/
def phiFun (g : H) (z : Zhat) : H := Classical.choose (exists_mk'_eq_famHom g z)

/-- The defining property of `phiFun`. -/
theorem phiFun_spec (g : H) (z : Zhat) (N : OpenNormalSubgroup H) :
    QuotientGroup.mk' N.toSubgroup (phiFun g z) = famHom g N z :=
  (Classical.choose_spec (exists_mk'_eq_famHom g z)) N

/-- `phiFun` is determined by its images in the finite quotients. -/
theorem phiFun_eq_of (g : H) (z : Zhat) {x : H}
    (hx : ∀ N : OpenNormalSubgroup H, QuotientGroup.mk' N.toSubgroup x = famHom g N z) :
    phiFun g z = x :=
  eq_of_forall_mk'_eq fun N => by rw [phiFun_spec g z N, hx N]

/-! ## The homomorphism `Ẑ →* H` -/

/-- **The homomorphism `phiHom g : Ẑ →* H`.** -/
def phiHom (g : H) : Zhat →* H where
  toFun := phiFun g
  map_one' := phiFun_eq_of g 1 fun N => by simp
  map_mul' z w := phiFun_eq_of g (z * w) (x := phiFun g z * phiFun g w) fun N => by
    rw [map_mul, phiFun_spec g z N, phiFun_spec g w N, map_mul]

/-- **Continuity of `phiHom g`.**  It suffices to check continuity after composing with the
projections onto finite quotients.  If `U` is a neighbourhood of `phiFun g z`, then
`phiFun g z · N ⊆ U` for some open normal `N`, and the preimage of the coset `phiFun g z · N`
is open because the composite `Ẑ → H ⧸ N` is continuous and the finite quotient is discrete. -/
theorem phiFun_continuous (g : H) : Continuous (phiFun g) := by
  rw [continuous_def]
  intro U hU
  rw [isOpen_iff_mem_nhds]
  intro z hz
  set x : H := phiFun g z with hx
  have hopen : IsOpen {v : H | x * v ∈ U} := hU.preimage (continuous_const.mul continuous_id)
  have h1 : (1 : H) ∈ {v : H | x * v ∈ U} := by
    simp only [Set.mem_ofPred_eq, mul_one]
    rwa [hx]
  obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hopen h1
  have hVopen : IsOpen {w : Zhat | famHom g N w = famHom g N z} := by
    haveI : DiscreteTopology (H ⧸ N.toSubgroup) :=
      QuotientGroup.discreteTopology (N := N.toSubgroup) N.isOpen'
    exact (isOpen_discrete {famHom g N z}).preimage (famHom_cont g N)
  have hmem : {w : Zhat | famHom g N w = famHom g N z} ∈ nhds z :=
    hVopen.mem_nhds (show z ∈ {w : Zhat | famHom g N w = famHom g N z} from rfl)
  refine Filter.mem_of_superset hmem ?_
  intro w hw
  have hw' : famHom g N w = famHom g N z := hw
  have h2 : QuotientGroup.mk' N.toSubgroup (phiFun g w) = QuotientGroup.mk' N.toSubgroup x := by
    rw [phiFun_spec g w N, hx, phiFun_spec g z N]
    exact hw'
  have h3 : x⁻¹ * phiFun g w ∈ N.toSubgroup := by
    rw [← QuotientGroup.eq]
    simpa only [QuotientGroup.mk'_apply] using h2.symm
  have h4 : x * (x⁻¹ * phiFun g w) ∈ U := hN h3
  rwa [show x * (x⁻¹ * phiFun g w) = phiFun g w from by group] at h4

/-- `phiHom g` is continuous. -/
theorem phiHom_continuous (g : H) : Continuous (phiHom g) := phiFun_continuous g

/-- The component maps are surjective when `g` generates every finite quotient. -/
theorem famHom_surjective (g : H)
    (hg : ∀ N : OpenNormalSubgroup H, Subgroup.zpowers (QuotientGroup.mk' N.toSubgroup g) = ⊤)
    (N : OpenNormalSubgroup H) : Function.Surjective (famHom g N) := by
  intro y
  have hy : y ∈ Subgroup.zpowers (QuotientGroup.mk' N.toSubgroup g) := by
    rw [hg N]; exact Subgroup.mem_top y
  rw [Subgroup.mem_zpowers_iff] at hy
  obtain ⟨k, hk⟩ := hy
  exact ⟨intCastZhat k, by rw [famHom_intCastZhat]; exact hk⟩

/-- **Surjectivity of `phiHom g`** when `g` is a topological generator: the image meets every
coset of every open normal subgroup, hence is dense; and it is closed, `Ẑ` being compact and `H`
Hausdorff. -/
theorem phiFun_surjective (g : H)
    (hg : ∀ N : OpenNormalSubgroup H, Subgroup.zpowers (QuotientGroup.mk' N.toSubgroup g) = ⊤) :
    Function.Surjective (phiFun g) := by
  have hdense : Dense (Set.range (phiFun g)) := by
    rw [dense_iff_inter_open]
    intro U hUopen hUne
    obtain ⟨y, hyU⟩ := hUne
    have hopen : IsOpen {v : H | y * v ∈ U} := hUopen.preimage (continuous_const.mul continuous_id)
    have h1 : (1 : H) ∈ {v : H | y * v ∈ U} := by
      simpa only [Set.mem_ofPred_eq, mul_one] using hyU
    obtain ⟨N, hN⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hopen h1
    obtain ⟨z, hz⟩ := famHom_surjective g hg N (QuotientGroup.mk' N.toSubgroup y)
    refine ⟨phiFun g z, ?_, ⟨z, rfl⟩⟩
    have h2 : QuotientGroup.mk' N.toSubgroup (phiFun g z) = QuotientGroup.mk' N.toSubgroup y := by
      rw [phiFun_spec g z N, hz]
    have h3 : y⁻¹ * phiFun g z ∈ N.toSubgroup := by
      rw [← QuotientGroup.eq]
      simpa only [QuotientGroup.mk'_apply] using h2.symm
    have h4 : y * (y⁻¹ * phiFun g z) ∈ U := hN h3
    rwa [show y * (y⁻¹ * phiFun g z) = phiFun g z from by group] at h4
  have hclosed : IsClosed (Set.range (phiFun g)) :=
    (isCompact_range (phiFun_continuous g)).isClosed
  intro x
  have hx : x ∈ closure (Set.range (phiFun g)) := by
    rw [Dense.closure_eq hdense]
    exact Set.mem_univ x
  rw [closure_eq_iff_isClosed.mpr hclosed] at hx
  exact Set.mem_range.mp hx

/-! ## The main result -/

theorem exists_continuous_surjective_zhat_of_isProCyclic {H : Type*} [Group H]
    [TopologicalSpace H] [IsTopologicalGroup H] [T2Space H] [CompactSpace H]
    [TotallyDisconnectedSpace H] (h : NK.LocalTame.IsProCyclic H) :
    ∃ f : NK.LocalAnabelian.Zhat →* H, Continuous f ∧ Function.Surjective f := by
  obtain ⟨g, hg⟩ := exists_topologicallyCyclic_of_isProCyclic h
  exact ⟨phiHom g, phiHom_continuous g, phiFun_surjective g hg⟩

end

