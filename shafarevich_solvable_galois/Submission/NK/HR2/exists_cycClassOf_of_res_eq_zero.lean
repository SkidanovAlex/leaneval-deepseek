/-!
# Descent of a class with vanishing restriction, in the cyclic-class form

For a tower of number fields `K ⊆ L, M ⊆ E` (`E = L·M`), `L/K`, `M/K`, `E/K`, `E/M` Galois with
`Gal(M/K)` cyclic generated by `g`: a class `α ∈ H²(Gal(E/K), Eˣ)` whose restriction to
`Gal(E/M) ≤ Gal(E/K)` vanishes is the inflation of the cyclic class of some global element
`b ∈ Kˣ`:

`∃ b,  α = inf_{M,E} ( cycClassOf_{M/K}(b) )`.

This is input (b) of `NK.HR2.transferStepOnePlace` (the same statement is restated there, in
the namespace `NK.NUV2.ChebAux.Transfer`, where it is still unproved; that file is its only
consumer).

## The proof (four steps)

The hard cohomological input is **already proved** elsewhere, axiom-clean:

* `NK.CFTLib.HR.TransferAux.descent` : `a : H²(urep K E)` with `resToM K M E a = 0` gives
  `∃ β : H²(urep K M), levelInfMap K M E β = a`
  (H² inflation–restriction exactness
  `…H2_inflation_restriction_exact_of_subsingleton_H1_general` + Hilbert 90 for the units of
  `E/M` (`TransferAux.h1ResUnits`) + Galois descent `(Eˣ)^{Gal(E/M)} = Mˣ`
  (`TransferAux.descentMorphism`)).

What is added here:

1. `urep K E` and `NK.HassePrinciple.unitsRep K E` are *definitionally* equal
   (`urep` is the universe-pinned abbreviation), so no transport of `α` is needed.
2. `resToGal_eq_map_comp` : the restriction `resToGal` (along `Gal(E/M) ↪ Gal(E/K)`) is the
   restriction to the normal subgroup `rN K M E = ker (Gal(E/K) →* Gal(M/K))` followed by the
   transport `Tt` along the canonical isomorphism `galEquivRhn : Gal(E/M) ≃* rN K M E`
   (this is `groupCohomology.map_comp` for the factorisation
   `rN.subtype ∘ galEquivRhn = inclMK`).  Since `Tt = Tiso.inv` for the isomorphism `Tiso` of
   `groupCohomology.mapIso`, `Tt` is injective, whence
   `resToM_eq_zero_of_resToGal_eq_zero`.
3. `levelInfMap_eq_inflation` : `levelInfMap` (coefficient morphism along
   `AlgEquiv.restrictNormalHom`) equals `NK.NUV2.ARL.HR.inflation` (coefficient morphism along
   `NK.NUV2.ARL.HR.restrictHom`, which is defined through the image field), the two group homs
   being equal by `restrictHom_eq_restrictNormalHom`.
4. `exists_cycClassOf_eq_period` : periodicity at a cyclic level — every class in
   `H²(Gal(M/K), Mˣ)` is `cycClassOf (g) b` for some `b ∈ Kˣ`
   (`NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass` + Galois descent
   `IsGalois.mem_range_algebraMap_iff_fixed`).

The helpers `mem_rn_iff`, `restrictHom_eq_restrictNormalHom`, `galEquivRhn`,
`rn_subtype_comp_galEquivRhn` are *copied* from
`Submission/Work/NUV2/ARL/HR/exists_cycClassOf_of_res_eq_zero.lean` (that module has to be
avoided because it transitively imports the currently broken
`CFTLib/HR/TransferAux/exists_inflation_eq_of_resToGal_eq_zero.lean`).

`hgen` and `L` are not used mathematically (they are kept in the statement).

Axioms: `propext, Classical.choice, Quot.sound`.
-/

set_option maxHeartbeats 1600000
set_option linter.style.haveILetI false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option autoImplicit false

open CategoryTheory

namespace NK.HR2

/-! ## 1. The subgroup `Gal(E/M) ≤ Gal(E/K)` and the compatibility of the two restrictions -/

section Aux

variable {K M E : Type} [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E] [Algebra M E]
  [IsScalarTower K M E] [IsGalois K M] [IsGalois K E]

/-- Membership in `rN K M E = ker (Gal(E/K) →* Gal(M/K))`, characterised by fixing `M` pointwise. -/
theorem mem_rn_iff (σ : Gal(E/K)) :
    σ ∈ NK.CFTLib.HR.TransferAux.rN K M E ↔
      ∀ m : M, σ (algebraMap M E m) = algebraMap M E m := by
  rw [NK.CFTLib.HR.TransferAux.rN, MonoidHom.mem_ker]
  have key : ∀ τ : Gal(M/K), τ = 1 ↔ ∀ m : M, τ m = m := by
    intro τ; constructor
    · intro h m; rw [h]; rfl
    · intro h; ext m; exact h m
  rw [key]
  constructor
  · intro h m
    have h1 := AlgEquiv.restrictNormal_commutes (F := K) (K₁ := E) (K₂ := E) σ M m
    have h2 : (σ.restrictNormal M) m = m := h m
    rw [h2] at h1
    exact h1.symm
  · intro h m
    apply (algebraMap M E).injective
    have h1 := AlgEquiv.restrictNormal_commutes (F := K) (K₁ := E) (K₂ := E) σ M m
    rw [show (AlgEquiv.restrictNormalHom (F := K) (K₁ := E) (E := M)) σ = σ.restrictNormal M
      from rfl]
    rw [h1]
    exact h m

/-- **The `K`-algebra isomorphism of the image field with `M`**: the restriction map
`NK.NUV2.ARL.HR.restrictHom` (defined through the image field) is Mathlib's
`AlgEquiv.restrictNormalHom`. -/
theorem restrictHom_eq_restrictNormalHom :
    NK.NUV2.ARL.HR.restrictHom (K := K) (L := M) (E := E)
      = AlgEquiv.restrictNormalHom (F := K) (K₁ := E) (E := M) := by
  ext σ x
  apply (algebraMap M E).injective
  rw [NK.NUV2.ARL.HR.restrictHom_apply_coe]
  exact (AlgEquiv.restrictNormal_commutes (F := K) (K₁ := E) (K₂ := E) σ M x).symm

/-- The canonical isomorphism between `Gal(E/M)` and the kernel `rN K M E` of the restriction,
sending `τ` to its image in `Gal(E/K)`. -/
noncomputable def galEquivRhn :
    Gal(E/M) ≃* ↥(NK.CFTLib.HR.TransferAux.rN K M E) where
  toFun τ := ⟨NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E) τ, by
    rw [mem_rn_iff]; intro m; exact τ.commutes m⟩
  invFun s := AlgEquiv.ofRingEquiv (f := (s.1).toRingEquiv)
    (fun m => (mem_rn_iff (s.1)).mp s.2 m)
  left_inv τ := AlgEquiv.ext fun x => rfl
  right_inv s := Subtype.ext (AlgEquiv.ext fun x => rfl)
  map_mul' a b := Subtype.ext (map_mul _ a b)

@[simp]
theorem galEquivRhn_apply_coe (τ : Gal(E/M)) :
    ((galEquivRhn τ : NK.CFTLib.HR.TransferAux.rN K M E) : Gal(E/K))
      = NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E) τ := rfl

theorem rn_subtype_comp_galEquivRhn :
    (NK.CFTLib.HR.TransferAux.rN K M E).subtype.comp (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom
      = NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E) := by
  ext τ; rfl

end Aux

/-! ## 2. The coefficient representation `(Eˣ)^{Gal(E/M)}` and the transported restriction -/

section Bridge

variable {K M E : Type} [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E] [Algebra M E]
  [IsScalarTower K M E] [IsGalois K M] [IsGalois K E]

/-- The coefficient representation `Eˣ`, viewed as a representation of the normal subgroup
`rN K M E = ker (Gal(E/K) →* Gal(M/K))`. -/
noncomputable abbrev B0 (K M E : Type) [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E]
    [Algebra M E] [IsScalarTower K M E] [Normal K M] :
    Rep.{0,0,0} NK.HassePrinciple.CoeffInt ↥(NK.CFTLib.HR.TransferAux.rN K M E) :=
  Rep.res (NK.CFTLib.HR.TransferAux.rN K M E).subtype
    (NK.CFTLib.IdeleHasse.Crux.urep K E)

/-- The restriction to the normal subgroup `rN K M E` (definitionally the `M`-side restriction
`NK.CFTLib.HR.TransferAux.resToM`). -/
noncomputable abbrev M0 (K M E : Type) [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E]
    [Algebra M E] [IsScalarTower K M E] [Normal K M] :
    groupCohomology (NK.CFTLib.IdeleHasse.Crux.urep K E) 2 ⟶
      groupCohomology (B0 K M E) 2 :=
  groupCohomology.map (NK.CFTLib.HR.TransferAux.rN K M E).subtype (𝟙 (B0 K M E)) 2

/-- The transport of the cohomology of `Eˣ` along the canonical isomorphism
`Gal(E/M) ≃* ker (Gal(E/K) →* Gal(M/K))`. -/
noncomputable abbrev Tt (K M E : Type) [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E]
    [Algebra M E] [IsScalarTower K M E] [IsGalois K M] [IsGalois K E] :
    groupCohomology (B0 K M E) 2 ⟶
      groupCohomology (Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom
        (B0 K M E)) 2 :=
  groupCohomology.map (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom
    (𝟙 (Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom (B0 K M E))) 2

/-- The isomorphism exhibited by `Tt`. -/
noncomputable abbrev Tiso (K M E : Type) [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E]
    [Algebra M E] [IsScalarTower K M E] [IsGalois K M] [IsGalois K E] :
    groupCohomology (Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom
        (B0 K M E)) 2 ≅ groupCohomology (B0 K M E) 2 :=
  groupCohomology.mapIso (k := NK.HassePrinciple.CoeffInt)
    (G := Gal(E/M)) (H := ↥(NK.CFTLib.HR.TransferAux.rN K M E))
    (A := B0 K M E)
    (B := Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom (B0 K M E))
    (galEquivRhn (K := K) (M := M) (E := E))
    (LinearEquiv.refl NK.HassePrinciple.CoeffInt (B0 K M E).V)
    (by intro g; rfl) 2

/-- **`Tt` is the inverse of the isomorphism `Tiso`**: `Tt` (the transport along
`Gal(E/M) ≃* ker (Gal(E/K) →* Gal(M/K))`) is the inverse of the isomorphism `Tiso` of
`groupCohomology.mapIso`. -/
theorem Tt_eq_Tiso_inv (K M E : Type) [Field K] [Field M] [Field E] [Algebra K M] [Algebra K E]
    [Algebra M E] [IsScalarTower K M E] [IsGalois K M] [IsGalois K E] :
    Tt K M E = (Tiso K M E).inv := by
  simp only [Tt, Tiso]
  exact groupCohomology.map_congr rfl (by rfl) 2

/-- **The restriction `resToGal` is the restriction to the normal subgroup `rN K M E`, followed by
the transport along `Gal(E/M) ≃* rN K M E`.** -/
theorem resToGal_eq_map_comp :
    (NK.NUV2.ARL.HR.resToGal (K := K) (M := M) (E := E))
      = (M0 K M E) ≫ (Tt K M E) := by
  have h := groupCohomology.map_comp (k := NK.HassePrinciple.CoeffInt)
    (G := Gal(E/M)) (H := ↥(NK.CFTLib.HR.TransferAux.rN K M E)) (K := Gal(E/K))
    (A := NK.CFTLib.IdeleHasse.Crux.urep K E) (B := B0 K M E)
    (C := Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom (B0 K M E))
    (f := (NK.CFTLib.HR.TransferAux.rN K M E).subtype)
    (g := (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom)
    (φ := 𝟙 (B0 K M E))
    (ψ := 𝟙 (Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom (B0 K M E))) 2
  change (groupCohomology.map (NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E))
      (𝟙 (Rep.res (NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E))
        (NK.CFTLib.IdeleHasse.Crux.urep K E))) 2)
    = (groupCohomology.map (NK.CFTLib.HR.TransferAux.rN K M E).subtype (𝟙 (B0 K M E)) 2)
      ≫ (groupCohomology.map (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom
          (𝟙 (Rep.res (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom (B0 K M E))) 2)
  rw [← h]
  exact (groupCohomology.map_congr
    (f := ((NK.CFTLib.HR.TransferAux.rN K M E).subtype).comp
      (galEquivRhn (K := K) (M := M) (E := E)).toMonoidHom)
    (g := NK.NUV2.ARL.HR.inclMK (K := K) (M := M) (E := E))
    (rn_subtype_comp_galEquivRhn (K := K) (M := M) (E := E)) (by rfl) 2).symm

/-- **A class killed by `resToGal` is killed by the restriction to the normal subgroup
`rN K M E`** (the `M`-side form `NK.CFTLib.HR.TransferAux.resToM`). -/
theorem resToM_eq_zero_of_resToGal_eq_zero
    (a : groupCohomology (NK.CFTLib.IdeleHasse.Crux.urep K E) 2)
    (h : (NK.NUV2.ARL.HR.resToGal (K := K) (M := M) (E := E)).hom a = 0) :
    (NK.CFTLib.HR.TransferAux.resToM K M E).hom a = 0 := by
  have h1 : (Tt K M E).hom ((NK.CFTLib.HR.TransferAux.resToM K M E).hom a) = 0 := by
    have h2 : ((M0 K M E) ≫ (Tt K M E)).hom a = 0 := by
      rw [← resToGal_eq_map_comp (K := K) (M := M) (E := E)]
      exact h
    rwa [ModuleCat.hom_comp, LinearMap.comp_apply] at h2
  have h3 : ((Tt K M E) ≫ (Tiso K M E).hom).hom ((NK.CFTLib.HR.TransferAux.resToM K M E).hom a)
      = (NK.CFTLib.HR.TransferAux.resToM K M E).hom a := by
    rw [Tt_eq_Tiso_inv (K := K) (M := M) (E := E)]
    rw [Iso.inv_hom_id]
    rfl
  rw [ModuleCat.hom_comp, LinearMap.comp_apply] at h3
  rw [h1, map_zero] at h3
  exact h3.symm

end Bridge

/-! ## 3. The level inflation `levelInfMap` is `NK.NUV2.ARL.HR.inflation` -/

section InflationBridge

variable {K M E : Type} [Field K] [NumberField K] [Field M] [NumberField M] [Field E]
  [NumberField E] [Algebra K M] [Algebra K E] [Algebra M E] [IsScalarTower K M E]
  [FiniteDimensional K M] [FiniteDimensional K E] [IsGalois K M] [IsGalois K E]

/-- `NK.CFTLib.HR.TransferAux.levelInfMap` (coefficient morphism along
`AlgEquiv.restrictNormalHom`) is `NK.NUV2.ARL.HR.inflation` (coefficient morphism along
`NK.NUV2.ARL.HR.restrictHom`), the two group homs being equal. -/
theorem levelInfMap_eq_inflation :
    (NK.CFTLib.HR.TransferAux.levelInfMap K M E)
      = (NK.NUV2.ARL.HR.inflation (K := K) (L := M) (E := E)) := by
  change groupCohomology.map (AlgEquiv.restrictNormalHom (K₁ := E) (E := M))
      (NK.CFTLib.HR.TransferAux.unitsInclCoeff K M E) 2
    = groupCohomology.map (NK.NUV2.ARL.HR.restrictHom (K := K) (L := M) (E := E))
        (NK.NUV2.ARL.HR.unitsInclRep (K := K) (L := M) (E := E)) 2
  exact groupCohomology.map_congr
    (f := AlgEquiv.restrictNormalHom (F := K) (K₁ := E) (E := M))
    (g := NK.NUV2.ARL.HR.restrictHom (K := K) (L := M) (E := E))
    (restrictHom_eq_restrictNormalHom (K := K) (M := M) (E := E)).symm
    (by rfl) 2

end InflationBridge

/-! ## 4. Periodicity: every class at a cyclic level is the cyclic class of a global element -/

section Periodicity

/-- **The cyclic class representative of a class in `H²(Gal(M/K), Mˣ)`.**  For a finite Galois
extension `M/K` with `Gal(M/K)` cyclic generated by `g`, every class is the cyclic class of a global
element `b ∈ Kˣ` (Galois descent for the invariants together with the periodicity surjectivity
`NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass`). -/
theorem exists_cycClassOf_eq_period {K M : Type} [Field K] [NumberField K] [Field M]
    [NumberField M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]
    (g : M ≃ₐ[K] M) (hg : ∀ σ : M ≃ₐ[K] M, σ ∈ Subgroup.zpowers g)
    (β : groupCohomology (NK.HassePrinciple.unitsRep K M) 2) :
    ∃ b : Kˣ, NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := M) g hg b = β := by
  obtain ⟨a, ha, hcls⟩ := NK.CFTLib.IdeleHasse.Descent.exists_eq_cycClass
    (NK.CFTLib.IdeleHasse.Crux.urep K M) g hg β
  set a' : Mˣ := Additive.toMul a with ha'
  have hfix : ∀ σ : M ≃ₐ[K] M, Units.map σ.toMonoidHom a' = a' := by
    intro σ
    have h1 := ha σ
    have h2 : (NK.HassePrinciple.unitsRep K M).ρ σ a
        = Additive.ofMul (Units.map σ.toMonoidHom (Additive.toMul a)) := rfl
    rw [h2, ← ha'] at h1
    exact Additive.ofMul.injective h1
  have hfix' : ∀ σ : M ≃ₐ[K] M, σ (a' : M) = (a' : M) := by
    intro σ
    have h1 := hfix σ
    have h2 := congrArg (fun u : Mˣ => (u : M)) h1
    rw [Units.coe_map] at h2
    exact h2
  obtain ⟨k, hk⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := K) (E := M) (a' : M)).mpr hfix'
  have hk0 : k ≠ 0 := by
    intro h0
    have h1 : (a' : M) = 0 := by rw [← hk, h0]; simp
    exact a'.ne_zero h1
  refine ⟨Units.mk0 k hk0, ?_⟩
  have h3 : Units.map (algebraMap K M).toMonoidHom (Units.mk0 k hk0) = a' := by
    apply Units.ext
    rw [Units.coe_map]
    simpa using hk
  have hunits : NK.CFTLib.IdeleHasse.Descent.unitsImage (K := K) (F := M) (Units.mk0 k hk0)
      = a := by
    rw [NK.CFTLib.IdeleHasse.Descent.unitsImage, h3, ha']
    rfl
  rw [NK.CFTLib.IdeleHasse.Descent.cycClassOf]
  subst hunits
  exact hcls

end Periodicity

/-! ## 5. The descent of a class with vanishing restriction -/

theorem exists_cycClassOf_of_res_eq_zero {K L M E : Type} [Field K] [NumberField K] [Field L]
    [NumberField L] [Field M] [NumberField M] [Field E] [NumberField E] [Algebra K L]
    [Algebra K M] [Algebra K E] [Algebra L E] [Algebra M E] [IsScalarTower K L E]
    [IsScalarTower K M E] [FiniteDimensional K L] [FiniteDimensional K M] [FiniteDimensional K E]
    [IsGalois K L] [IsGalois K M] [IsGalois K E] [IsGalois M E]
    (hgen : Algebra.adjoin K (Set.range (algebraMap L E) ∪ Set.range (algebraMap M E)) = ⊤)
    (g : M ≃ₐ[K] M) (hg : ∀ σ : M ≃ₐ[K] M, σ ∈ Subgroup.zpowers g)
    (α : groupCohomology (NK.HassePrinciple.unitsRep K E) 2)
    (hα : (NK.NUV2.ChebAux.Transfer.resToGal K M E).hom α = 0) :
    ∃ (b : Kˣ), α = (NK.NUV2.ARL.HR.inflation (K := K) (L := M) (E := E)).hom
            (NK.CFTLib.IdeleHasse.Descent.cycClassOf (K := K) (F := M) g hg b) := by
  haveI : FiniteDimensional M E := Module.Finite.of_restrictScalars_finite K M E
  have hα' : (NK.NUV2.ARL.HR.resToGal (K := K) (M := M) (E := E)).hom α = 0 := hα
  have hαM : (NK.CFTLib.HR.TransferAux.resToM K M E).hom α = 0 :=
    resToM_eq_zero_of_resToGal_eq_zero (K := K) (M := M) (E := E) α hα'
  obtain ⟨β, hβ⟩ := NK.CFTLib.HR.TransferAux.descent (K := K) (M := M) (E := E) α hαM
  obtain ⟨b, hb⟩ := exists_cycClassOf_eq_period (K := K) (M := M) g hg β
  refine ⟨b, ?_⟩
  rw [← levelInfMap_eq_inflation (K := K) (M := M) (E := E), hb]
  exact hβ.symm

end NK.HR2
