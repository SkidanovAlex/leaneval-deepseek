/-! ## Index-`n` subgroups -/

/-- The number of subgroups of `G` of index `n`.

For infinite `G` with infinitely many index-`n` subgroups this is `0`, by the
convention on `Nat.card` for infinite types; in every application below the
quantity is finite. -/
noncomputable def numIndexSubgroups (n : ℕ) (G : Type*) [Group G] : ℕ :=
  Nat.card {H : Subgroup G // H.index = n}

/-- The join of all index-`p` subgroups of `G`.

For a *pro-`p`* group (or more generally a group all of whose index-`p` subgroups are
normal) this is the Frattini subgroup `Φ_p(G) = G^p[G,G]` and `G ⧸ Φ_p(G)` is the maximal
elementary abelian `p`-quotient.  For a general profinite group it is *not*: index-`p`
subgroups need not be normal (e.g. the stabiliser of a non-Galois cubic extension in
`Gal(ℚ̄/ℚ)` has index `3` and is not normal), so the join need not be normal.  The
correct Frattini subgroup for the general case is the closed subgroup generated by
`p`-th powers and commutators; see `NK.ProfiniteP.frattiniSubgroup`.  Nothing below
uses this definition; it is recorded only for orientation. -/
noncomputable def pFrattini (p : ℕ) (G : Type*) [Group G] : Subgroup G :=
  ⨆ (H : {H : Subgroup G // H.index = p}), H.1

/-- `HasFrattiniRank p r G` records that `G` has `(p^r - 1)/(p - 1)` subgroups of index
`p`; equivalently (for `p` prime) that its maximal elementary abelian `p`-quotient is
`(ℤ/p)^r`, *provided* every index-`p` subgroup is normal.

The two readings agree for pro-`p` groups and for abelian groups — the situation in which
this is used here (`Abelianization` of an absolute Galois group) — and the count of
index-`p` subgroups is the form in which the arithmetic computations produce the
invariant: the number of index-`p` subgroups of `(ℤ/p)^r` is `(p^r - 1)/(p - 1)`.  For a
general profinite group the count of *all* index-`p` subgroups can strictly exceed
`(p^{frattiniRank} - 1)/(p - 1)` because of the non-normal ones; this is why the
`p`-adic results of `PadicField/` are stated for the abelianisation
(`HasAbelianFrattiniRank`) and not for `Gal(κ̄/κ)` itself. -/
def HasFrattiniRank (p r : ℕ) (G : Type*) [Group G] : Prop :=
  numIndexSubgroups p G = (p ^ r - 1) / (p - 1)

/-- `HasAbelianFrattiniRank p r G` is the same invariant for the abelianisation
`G ⧸ [G,G]`: it is the rank of the maximal elementary abelian `p`-quotient of `G^{ab}`,
equivalently the number of index-`p` (normal) subgroups of `G`, i.e. of *abelian*
degree-`p` quotients of `G`.  This is the invariant of an absolute Galois group that
local reciprocity computes. -/
def HasAbelianFrattiniRank (p r : ℕ) (G : Type*) [Group G] : Prop :=
  HasFrattiniRank p r (Abelianization G)

/-! ## Invariance under group isomorphisms -/

/-- Transporting a subgroup along a group isomorphism preserves its index. -/
theorem index_map_mulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (K : Subgroup G) : (K.map e.toMonoidHom).index = K.index :=
  Subgroup.index_map_equiv K e

/-- The bijection between subgroups induced by a group isomorphism. -/
def subgroupEquivOfMulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) :
    Subgroup G ≃ Subgroup H where
  toFun K := K.map e.toMonoidHom
  invFun K := K.comap e.toMonoidHom
  left_inv K := by
    ext x
    simp only [Subgroup.mem_comap, Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, hyx⟩
      rwa [e.injective hyx] at hy
    · intro hx
      exact ⟨x, hx, rfl⟩
  right_inv K := by
    ext x
    simp only [Subgroup.mem_comap, Subgroup.mem_map]
    constructor
    · rintro ⟨y, hy, hyx⟩
      rwa [← hyx]
    · intro hx
      exact ⟨e.symm x, by simpa using hx, by simp⟩

/-- **Invariance of the index count.** A group isomorphism `G ≃* H` induces a
bijection between subgroups of index `n`. No continuity is needed, so this
applies in particular to a homeomorphic isomorphism of profinite groups. -/
theorem numIndexSubgroups_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) (n : ℕ) :
    numIndexSubgroups n G = numIndexSubgroups n H := by
  refine Nat.card_congr (Equiv.subtypeEquiv (subgroupEquivOfMulEquiv e) ?_)
  intro K
  show K.index = n ↔ (K.map e.toMonoidHom).index = n
  rw [index_map_mulEquiv]

/-- **Invariance of the Frattini rank.** -/
theorem hasFrattiniRank_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H) {p r : ℕ}
    (h : HasFrattiniRank p r G) : HasFrattiniRank p r H := by
  unfold HasFrattiniRank at h ⊢
  rw [← numIndexSubgroups_congr e p]
  exact h

/-- The abelianisation of a group isomorphism. -/
def abelianizationMulEquiv {G H : Type*} [Group G] [Group H] (e : G ≃* H) :
    Abelianization G ≃* Abelianization H :=
  QuotientGroup.congr (commutator G) (commutator H) e (by
    rw [show commutator G = ⁅(⊤ : Subgroup G), ⊤⁆ from rfl,
      show commutator H = ⁅(⊤ : Subgroup H), ⊤⁆ from rfl, Subgroup.map_commutator]
    simp)

/-- **Invariance of the abelianised Frattini rank.** -/
theorem hasAbelianFrattiniRank_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    {p r : ℕ} (h : HasAbelianFrattiniRank p r G) : HasAbelianFrattiniRank p r H :=
  hasFrattiniRank_congr (abelianizationMulEquiv e) h

/-! ## The `ℓ`-tower rank predicate -/

/-- `HasUnboundedTowerRank ℓ G` is the invariant of Ivanov (arXiv:1309.3046,
Lemma 3.12) which detects the residue characteristic of a local field: it says
that the `ℓ`-Frattini ranks of the finite-index subgroups `V` of `G` with
`G / V` a finite `ℓ`-group are unbounded.

Equivalently: `dim_{F_ℓ} H¹(V, ℤ/ℓ)` is unbounded as `V` runs over the open
subgroups of `G` with `G / V` a pro-`ℓ` group.  We phrase it without any
cohomology: the dimension of `H¹(V, ℤ/ℓ)` is the rank of `V ⧸ Φ_ℓ(V)`, i.e. the
number of index-`ℓ` subgroups of `V` transformed by `(ℓ^r - 1)/(ℓ - 1)`. -/
def HasUnboundedTowerRank (ℓ : ℕ) (G : Type*) [Group G] : Prop :=
  ∀ N : ℕ, ∃ V : Subgroup G, V.FiniteIndex ∧ (∃ k : ℕ, V.index = ℓ ^ k) ∧
    N < numIndexSubgroups ℓ V

/-- **Invariance of the tower rank predicate.** It is an isomorphism invariant of
`G` as an abstract group. -/
theorem hasUnboundedTowerRank_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    {ℓ : ℕ} (h : HasUnboundedTowerRank ℓ G) : HasUnboundedTowerRank ℓ H := by
  intro N
  obtain ⟨V, hfin, hpow, hN⟩ := h N
  refine ⟨V.map e.toMonoidHom, ?_, ?_, ?_⟩
  · show (V.map e.toMonoidHom).FiniteIndex
    rw [Subgroup.finiteIndex_iff, index_map_mulEquiv]
    exact (Subgroup.finiteIndex_iff (H := V)).mp hfin
  · obtain ⟨k, hk⟩ := hpow
    exact ⟨k, by rw [index_map_mulEquiv, hk]⟩
  · rw [← numIndexSubgroups_congr
      (Subgroup.equivMapOfInjective V e.toMonoidHom e.injective) ℓ]
    exact hN

/-- **Uniqueness of the Frattini rank.**  For a prime `p` the number of index-`p` subgroups of
`(ℤ/p)^r` is injective in `r`, so the count determines the rank. -/
theorem eq_of_hasFrattiniRank {p r s : ℕ} (hp : p.Prime) {G : Type*} [Group G]
    (h : HasFrattiniRank p r G) (h' : HasFrattiniRank p s G) : r = s := by
  have hp1 : 1 ≤ p := hp.one_le
  have hdvd : ∀ t : ℕ, (p - 1) ∣ p ^ t - 1 := fun t => by
    simpa using Nat.sub_dvd_pow_sub_pow p 1 t
  have hpr : p ^ r - 1 = (p - 1) * ((p ^ r - 1) / (p - 1)) :=
    (Nat.mul_div_cancel' (hdvd r)).symm
  have hps : p ^ s - 1 = (p - 1) * ((p ^ s - 1) / (p - 1)) :=
    (Nat.mul_div_cancel' (hdvd s)).symm
  have hq : (p ^ r - 1) / (p - 1) = (p ^ s - 1) / (p - 1) := by
    have h1 : numIndexSubgroups p G = (p ^ r - 1) / (p - 1) := h
    have h2 : numIndexSubgroups p G = (p ^ s - 1) / (p - 1) := h'
    rw [← h1, h2]
  rw [hq] at hpr
  have heq : p ^ r - 1 = p ^ s - 1 := hpr.trans hps.symm
  have hpow : p ^ r = p ^ s := by
    have h1 : 1 ≤ p ^ r := one_le_pow₀ hp1
    have h2 : 1 ≤ p ^ s := one_le_pow₀ hp1
    have hc := congrArg (· + 1) heq
    rwa [Nat.sub_add_cancel h1, Nat.sub_add_cancel h2] at hc
  exact Nat.pow_right_injective hp.two_le hpow

/-- **Uniqueness of the abelianised Frattini rank.** -/
theorem eq_of_hasAbelianFrattiniRank {p r s : ℕ} (hp : p.Prime) {G : Type*} [Group G]
    (h : HasAbelianFrattiniRank p r G) (h' : HasAbelianFrattiniRank p s G) : r = s :=
  eq_of_hasFrattiniRank hp h h'

/-- The predicate "the abelianisation has non-trivial `p`-torsion" is an invariant of the
abstract group: it is the group-theoretic trace of `ζ_p ∈ κ` for a `p`-adic field. -/
def HasPTorsionAbelianization (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∃ x : Abelianization G, x ≠ 1 ∧ x ^ p = 1

/-- **Invariance of `p`-torsion in the abelianisation.** -/
theorem hasPTorsionAbelianization_congr {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    {p : ℕ} (h : HasPTorsionAbelianization p G) : HasPTorsionAbelianization p H := by
  obtain ⟨x, hx1, hxp⟩ := h
  refine ⟨abelianizationMulEquiv e x, fun h => hx1 ((abelianizationMulEquiv e).injective ?_), ?_⟩
  · rw [h, map_one]
  · rw [← map_pow, hxp, map_one]

/-- **Invariance of `p`-torsion in the abelianisation, as an iff.** -/
theorem hasPTorsionAbelianization_congr_iff {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (p : ℕ) : HasPTorsionAbelianization p G ↔ HasPTorsionAbelianization p H :=
  ⟨fun h => hasPTorsionAbelianization_congr e h,
    fun h => hasPTorsionAbelianization_congr e.symm h⟩

/-- **Invariance of the tower rank predicate as an iff.** -/
theorem hasUnboundedTowerRank_congr_iff {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    (ℓ : ℕ) : HasUnboundedTowerRank ℓ G ↔ HasUnboundedTowerRank ℓ H :=
  ⟨fun h => hasUnboundedTowerRank_congr e h, fun h => hasUnboundedTowerRank_congr e.symm h⟩

/-- **The residue characteristic is detected by the tower rank predicate.**
`ResidueCharDetectedBy p G` says that `p` is the unique prime `ℓ` for which `G`
has unbounded `ℓ`-tower rank.  This is the group-theoretic form in which the
residue characteristic of a `p`-adic field is recovered from its absolute Galois
group (Ivanov, Lemma 3.12). -/
def ResidueCharDetectedBy (p : ℕ) (G : Type*) [Group G] : Prop :=
  ∀ ℓ, ℓ.Prime → (HasUnboundedTowerRank ℓ G ↔ ℓ = p)

/-- **The residue characteristic is an isomorphism invariant.** -/
theorem residueCharDetectedBy_unique {G H : Type*} [Group G] [Group H] (e : G ≃* H)
    {p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hG : ResidueCharDetectedBy p G)
    (hH : ResidueCharDetectedBy q H) : p = q := by
  have h1 : HasUnboundedTowerRank p G := (hG p hp).mpr rfl
  have h2 : HasUnboundedTowerRank p H := hasUnboundedTowerRank_congr e h1
  exact (hH p hp).mp h2

end

