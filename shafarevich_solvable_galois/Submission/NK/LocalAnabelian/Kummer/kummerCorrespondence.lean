open scoped Classical

namespace NK.LocalAnabelian.Kummer

noncomputable section

variable {G : Type*} [Group G]

/-- A nontrivial `p`-torsion element generates a subgroup with exactly `p` elements. -/
theorem natCard_zpowers_eq_of_pow_eq_one {p : ℕ} (hp : p.Prime) {x : G}
    (hx : x ≠ 1) (hxp : x ^ p = 1) : Nat.card (Subgroup.zpowers x) = p := by
  rw [Nat.card_zpowers]
  rcases hp.eq_one_or_self_of_dvd (orderOf x) (orderOf_dvd_iff_pow_eq_one.mpr hxp) with h | h
  · exact absurd (orderOf_eq_one_iff.mp h) hx
  · exact h

/-- A subgroup `S` of a subgroup `T` with `Nat.card S = Nat.card T ≠ 0` is equal to `T`.
(The hypothesis `Nat.card T ≠ 0` cannot be dropped: `2ℤ ≤ ℤ` with both `Nat.card`s
equal to `0`.) -/
theorem eq_of_le_of_natCard_eq_of_ne_zero {S T : Subgroup G} (hT : Nat.card T ≠ 0)
    (hST : S ≤ T) (hcard : Nat.card S = Nat.card T) : S = T := by
  have hFinT : Finite T := (Nat.card_ne_zero.mp hT).2
  have hsub : (S : Set G) ⊆ (T : Set G) := hST
  have hncard : (T : Set G).ncard ≤ (S : Set G).ncard := by
    rw [← Nat.card_coe_set_eq, ← Nat.card_coe_set_eq]
    exact hcard.ge
  have hset : (S : Set G) = (T : Set G) :=
    Set.eq_of_subset_of_ncard_le hsub hncard (Set.finite_coe_iff.mpr hFinT)
  exact Subgroup.ext fun x => by simpa using Set.ext_iff.mp hset x

/-- A subgroup with `p` elements, `p` prime, contains a nontrivial element. -/
theorem exists_mem_ne_one_of_natCard_eq_prime {p : ℕ} (hp : p.Prime) {C : Subgroup G}
    (hC : Nat.card C = p) : ∃ x ∈ C, x ≠ 1 := by
  have hFin : Finite C := (Nat.card_ne_zero.mp (by rw [hC]; exact hp.ne_zero)).2
  haveI : Fintype C := Fintype.ofFinite C
  have hlt : 1 < Fintype.card C := by rw [← Nat.card_eq_fintype_card, hC]; exact hp.one_lt
  haveI : Nontrivial C := Fintype.one_lt_card_iff_nontrivial.mp hlt
  obtain ⟨x, hx⟩ := exists_ne (1 : C)
  exact ⟨x.1, x.2, fun h => hx (Subtype.ext h)⟩

/-- **The Kummer correspondence.**  Over a field `k` containing a primitive `p`-th root
of unity `ζ` (`p` a prime), inside a separable closure `K'` of `k`, the degree-`p` Galois
extensions of `k` correspond bijectively to the order-`p` subgroups of the Kummer class
group `kˣ/(kˣ)^p`. -/
theorem kummerCorrespondence {k K' : Type*} [Field k] [Field K'] [Algebra k K']
    [IsSepClosure k K'] (p : ℕ) (hp : p.Prime) {ζ : k}
    (hζ : IsPrimitiveRoot ζ p) [Finite (KummerGroup p k)] :
    Nonempty ({L : IntermediateField k K' // IsGalois k L ∧ Module.finrank k L = p} ≃
      {C : Subgroup (KummerGroup p k) // Nat.card C = p}) := by
  classical
  -- a nontrivial class `X L` with `k(X L^{1/p}) = L`, for every degree-`p` Galois `L`
  let X : {L : IntermediateField k K' // IsGalois k L ∧ Module.finrank k L = p} →
      KummerGroup p k := fun L =>
    Classical.choose (NK.LocalAnabelian.exists_ne_one_kummerFieldQuot_eq (K' := K') p hp hζ L)
  have hX : ∀ L, X L ≠ 1 ∧ kummerFieldQuot (K' := K') p (X L) = L.1 := fun L =>
    Classical.choose_spec (NK.LocalAnabelian.exists_ne_one_kummerFieldQuot_eq (K' := K') p hp hζ L)
  -- the correspondence `L ↦ ⟨X L⟩`
  let g : {L : IntermediateField k K' // IsGalois k L ∧ Module.finrank k L = p} →
      {C : Subgroup (KummerGroup p k) // Nat.card C = p} := fun L =>
    ⟨Subgroup.zpowers (X L),
      natCard_zpowers_eq_of_pow_eq_one hp (hX L).1 (kummerGroup_pow_self p (X L))⟩
  have hinj : Function.Injective g := by
    intro L L' hEq
    -- equal subgroups means `X L'` is a power of `X L`, hence the same Kummer field
    have hzpow : Subgroup.zpowers (X L) = Subgroup.zpowers (X L') := congrArg Subtype.val hEq
    have hmem : X L' ∈ Subgroup.zpowers (X L) := by
      rw [hzpow]; exact Subgroup.mem_zpowers (X L')
    have heq := kummerFieldQuot_eq_of_mem_zpowers (K' := K') p hp hζ (x := X L) (y := X L')
      (hX L).1 (hX L').1 hmem
    exact Subtype.ext (by rw [← (hX L').2, heq, (hX L).2])
  have hsurj : Function.Surjective g := by
    intro C
    -- every order-`p` subgroup has a nontrivial element `x`, and is generated by it
    obtain ⟨x, hxC, hx1⟩ :=
      exists_mem_ne_one_of_natCard_eq_prime (G := KummerGroup p k) hp (C := C.1) C.2
    have hgal : IsGalois k (kummerFieldQuot (K' := K') p x) ∧
        Module.finrank k (kummerFieldQuot (K' := K') p x) = p :=
      kummerFieldQuot_isGalois_finrank (K' := K') p hp hζ hx1
    let L₀ : {L : IntermediateField k K' // IsGalois k L ∧ Module.finrank k L = p} :=
      ⟨kummerFieldQuot (K' := K') p x, hgal⟩
    refine ⟨L₀, ?_⟩
    have hspec := hX L₀
    have hmem : X L₀ ∈ Subgroup.zpowers x :=
      mem_zpowers_of_kummerFieldQuot_eq (K' := K') p hp hζ (x := x) (y := X L₀) hx1 hspec.1 hspec.2
    have hyC : X L₀ ∈ C.1 := Subgroup.zpowers_le.mpr hxC hmem
    have hle : Subgroup.zpowers (X L₀) ≤ C.1 := Subgroup.zpowers_le.mpr hyC
    have hcard : Nat.card (Subgroup.zpowers (X L₀)) = Nat.card C.1 := by
      rw [natCard_zpowers_eq_of_pow_eq_one hp hspec.1 (kummerGroup_pow_self p (X L₀)), C.2]
    have hCne : Nat.card C.1 ≠ 0 := by rw [C.2]; exact hp.ne_zero
    exact Subtype.ext (eq_of_le_of_natCard_eq_of_ne_zero hCne hle hcard)
  exact ⟨Equiv.ofBijective g ⟨hinj, hsurj⟩⟩

end

end NK.LocalAnabelian.Kummer
