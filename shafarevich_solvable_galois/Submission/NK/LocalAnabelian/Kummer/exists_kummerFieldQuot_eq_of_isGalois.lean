namespace NK.LocalAnabelian.Kummer

open NK.LocalAnabelian
open IntermediateField

noncomputable section

/-- If `a` and `b` in `kˣ` differ by a `p`-th power, then the corresponding Kummer
fields coincide (one inclusion; the other follows by symmetry). -/
theorem kummerField_le_of_div_mem_powSubgroup {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] (p : ℕ) {a b : kˣ} (h : a⁻¹ * b ∈ powSubgroup p k) :
    kummerField (K' := K') p a ≤ kummerField (K' := K') p b := by
  obtain ⟨c, hc⟩ := MonoidHom.mem_range.mp h
  rw [powMonoidHom_apply] at hc
  have hc' : ((c : kˣ) : k) ^ p = ((a : kˣ) : k)⁻¹ * ((b : kˣ) : k) := by
    simpa using congrArg (fun u : kˣ => (u : k)) hc
  have hbc : ((b : kˣ) : k) = ((a : kˣ) : k) * ((c : kˣ) : k) ^ p := by
    rw [hc']; field_simp
  rw [kummerField_le_iff]
  intro β hβ
  have hmap : algebraMap k K' ((c : kˣ) : k) ≠ 0 := by
    intro h0
    have : ((c : kˣ) : k) = 0 := (algebraMap k K').injective (by simpa using h0)
    exact (c : kˣ).ne_zero this
  have hmem : β * algebraMap k K' ((c : kˣ) : k) ∈ kummerField (K' := K') p b := by
    apply mem_kummerField_of_pow_eq
    rw [mul_pow, ← map_pow, hβ, ← map_mul, hbc]
  have hd : algebraMap k K' ((c : kˣ) : k) ∈ kummerField (K' := K') p b :=
    IntermediateField.algebraMap_mem _ _
  have hdiv := IntermediateField.div_mem (kummerField (K' := K') p b) hmem hd
  rwa [mul_div_cancel_right₀ _ hmap] at hdiv

/-- The Kummer field of `a` depends only on the class of `a` in `kˣ/(kˣ)^p`. -/
theorem kummerField_eq_of_div_mem_powSubgroup' {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] (p : ℕ) {a b : kˣ} (h : a⁻¹ * b ∈ powSubgroup p k) :
    kummerField (K' := K') p a = kummerField (K' := K') p b := by
  refine le_antisymm (kummerField_le_of_div_mem_powSubgroup p h)
    (kummerField_le_of_div_mem_powSubgroup p ?_)
  have hba : b⁻¹ * a = (a⁻¹ * b)⁻¹ := by group
  rw [hba]
  exact inv_mem h

/-- **Surjectivity of the Kummer correspondence.**  Every intermediate field `L`
with `L/k` Galois of degree a prime `p`, the base field containing a primitive
`p`-th root of unity `ζ`, is the Kummer field of some class in `kˣ/(kˣ)^p`. -/
theorem exists_kummerFieldQuot_eq_of_isGalois {k K' : Type*} [Field k] [Field K']
    [Algebra k K'] (p : ℕ) (hp : p.Prime) {ζ : k} (hζ : IsPrimitiveRoot ζ p)
    (L : IntermediateField k K') (hgal : IsGalois k L) (hdeg : Module.finrank k L = p) :
    ∃ x : KummerGroup p k, kummerFieldQuot (K' := K') p x = L := by
  haveI : FiniteDimensional k L := FiniteDimensional.of_finrank_pos (by rw [hdeg]; exact hp.pos)
  haveI : NeZero p := ⟨hp.ne_zero⟩
  haveI : Fact p.Prime := ⟨hp⟩
  have hcard : Nat.card Gal(L/k) = p := by rw [IsGalois.card_aut_eq_finrank, hdeg]
  haveI : IsCyclic Gal(L/k) := isCyclic_of_prime_card hcard
  -- A Kummer generator of `L/k`
  have hprim : (primitiveRoots (Module.finrank k L) k).Nonempty := by
    rw [hdeg]; exact ⟨ζ, (mem_primitiveRoots hp.pos).mpr hζ⟩
  obtain ⟨α, ha_mem, hgen⟩ := exists_root_adjoin_eq_top_of_isCyclic (K := k) (L := L) hprim
  rw [hdeg] at ha_mem
  obtain ⟨a, ha⟩ := ha_mem
  have hα : α ^ p = algebraMap k L a := ha.symm
  -- `a ≠ 0`, since `α` generates a nontrivial extension
  have hane : a ≠ 0 := by
    intro h0
    have hα0 : α = 0 := by
      have hz : α ^ p = 0 := by rw [hα, h0, map_zero]
      exact (pow_eq_zero_iff hp.ne_zero).mp hz
    have htop : (⊤ : IntermediateField k L) = ⊥ := by
      rw [← hgen, hα0, IntermediateField.adjoin_zero]
    have hfin : Module.finrank k L = 1 :=
      IntermediateField.bot_eq_top_iff_finrank_eq_one.mp htop.symm
    rw [hdeg] at hfin
    exact hp.ne_one hfin
  -- the Kummer field of `α ^ p` is `L`
  have hkummer : kummerField (K' := K') p (Units.mk0 a hane) = L := by
    refine le_antisymm ?_ ?_
    · rw [kummerField_le_iff]
      intro β hβ
      have hβa : β ^ p = algebraMap k K' a := by simpa using hβ
      have hαK : (α : K') ^ p = algebraMap k K' a := by
        rw [← IntermediateField.algebraMap_apply L α]
        rw [← map_pow (algebraMap ↥L K') α p, hα,
          ← IsScalarTower.algebraMap_apply k ↥L K' a]
      have hne : (α : K') ≠ 0 := by
        intro h0
        have hz : algebraMap k K' a = 0 := by rw [← hαK, h0, zero_pow hp.ne_zero]
        exact hane ((algebraMap k K').injective (by simpa using hz))
      have hane' : algebraMap k K' a ≠ 0 := hαK ▸ pow_ne_zero p hne
      have hratio : (β / (α : K')) ^ p = 1 := by
        rw [div_pow, hβa, hαK, div_self hane']
      have hζK : IsPrimitiveRoot (algebraMap k K' ζ) p :=
        hζ.map_of_injective (algebraMap k K').injective
      obtain ⟨i, _, hzi⟩ := hζK.eq_pow_of_pow_eq_one hratio
      have hζmem : (algebraMap k K' ζ) ^ i ∈ L :=
        pow_mem (IntermediateField.algebraMap_mem L ζ) i
      have hβeq : β = (α : K') * ((algebraMap k K' ζ) ^ i) := by
        rw [hzi, mul_div_cancel₀ _ hne]
      rw [hβeq]
      exact IntermediateField.mul_mem L α.2 hζmem
    · have hαK : (α : K') ^ p = algebraMap k K' a := by
        rw [← IntermediateField.algebraMap_apply L α]
        rw [← map_pow (algebraMap ↥L K') α p, hα,
          ← IsScalarTower.algebraMap_apply k ↥L K' a]
      have hpow : (α : K') ^ p = algebraMap k K' ((Units.mk0 a hane : kˣ) : k) := by
        rw [hαK, Units.val_mk0]
      have hlift : IntermediateField.adjoin k ({(α : K')} : Set K') = L := by
        have h1 : IntermediateField.lift (F := L) (⊤ : IntermediateField k L) = L :=
          IntermediateField.lift_top (F := k) (E := K') L
        calc IntermediateField.adjoin k ({(α : K')} : Set K')
            = IntermediateField.lift (F := L) (k⟮α⟯) :=
              (IntermediateField.lift_adjoin_simple k L α).symm
          _ = IntermediateField.lift (F := L) (⊤ : IntermediateField k L) := by rw [hgen]
          _ = L := h1
      rw [kummerField, ← hlift]
      apply IntermediateField.adjoin_le_iff.mpr
      rw [Set.singleton_subset_iff]
      exact IntermediateField.subset_adjoin k _ (by rw [Set.mem_ofPred_eq]; exact hpow)
  -- the class of `α ^ p`
  refine ⟨Quotient.mk'' (s₁ := QuotientGroup.leftRel (powSubgroup p k)) (Units.mk0 a hane), ?_⟩
  have hx := Quotient.out_eq' (Quotient.mk'' (s₁ := QuotientGroup.leftRel (powSubgroup p k))
    (Units.mk0 a hane))
  have hmem : (Quotient.out (Quotient.mk'' (s₁ := QuotientGroup.leftRel (powSubgroup p k))
      (Units.mk0 a hane)))⁻¹ * (Units.mk0 a hane) ∈ powSubgroup p k :=
    QuotientGroup.leftRel_apply.mp (Quotient.eq''.mp hx)
  rw [kummerFieldQuot, kummerField_eq_of_div_mem_powSubgroup' p hmem, hkummer]

end

end NK.LocalAnabelian.Kummer
