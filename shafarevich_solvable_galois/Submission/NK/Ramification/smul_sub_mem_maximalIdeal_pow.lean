# The higher ramification filtration shifts the valuation by its index

If `σ` lies in the `i`-th higher ramification subgroup `G_i` of a discretely valued
extension (in the lower numbering of `NK.Ramification.Defs`, so that
`σ x - x ∈ 𝔪^{i+1}` for every `x ∈ A`) and `x` lies in `𝔪^j`, then

  `σ • x - x ∈ 𝔪^{i+j}`.

This is the classical statement "`σ ∈ G_i` implies `v(σ x - x) ≥ v(x) + i`" in the
special case where `x` is integral.  It is what lets one transport the filtration
through powers of the maximal ideal, and it is proved here by induction on `j` using
only that `𝔪^j` is generated by `π^j` and that `σ` preserves each `𝔪^j`.

Note that the hypothesis `1 ≤ i` is not needed for the argument; it is kept because it
is part of the interface requested by the caller.
-/
import Mathlib
import Submission.NK.Ramification.Defs
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

namespace NK.Ramification

theorem smul_sub_mem_maximalIdeal_pow {K L : Type*} [Field K] [Field L] [Algebra K L]
    (A : ValuationSubring L) [IsDiscreteValuationRing A] (π : A)
    (hπ : IsLocalRing.maximalIdeal A = Ideal.span {π})
    {i j : ℕ} (hi : 1 ≤ i) (σ : A.decompositionSubgroup K)
    (hσ : σ ∈ NK.Ramification.ramificationSubgroup (K := K) A i)
    {x : A} (hx : x ∈ IsLocalRing.maximalIdeal A ^ j) :
    σ • x - x ∈ IsLocalRing.maximalIdeal A ^ (i + j) := by
  have _ : 1 ≤ i := hi
  -- `𝔪^n` is generated by `π^n` because `𝔪` is generated by `π`.
  have hpow : ∀ n : ℕ, IsLocalRing.maximalIdeal A ^ n = Ideal.span ({π ^ n} : Set A) := by
    intro n
    rw [hπ, Ideal.span_singleton_pow]
  have hπmem : π ∈ IsLocalRing.maximalIdeal A := by
    rw [hπ]; exact Ideal.mem_span_singleton_self π
  -- Induction on `j`: `x ∈ 𝔪^{j+1}` is `x = π * y` with `y ∈ 𝔪^j`, and
  -- `σ x - x = (σ π - π) (σ y) + π (σ y - y)`.
  suffices h : ∀ j : ℕ, ∀ x : A, x ∈ IsLocalRing.maximalIdeal A ^ j →
      σ • x - x ∈ IsLocalRing.maximalIdeal A ^ (i + j) by
    exact h j x hx
  intro j
  induction j with
  | zero =>
      intro x _
      exact Ideal.pow_le_pow_right (Nat.le_succ i) (hσ x)
  | succ j ih =>
      intro x hx
      rw [hpow (j + 1), Ideal.mem_span_singleton] at hx
      obtain ⟨c, hc⟩ := hx
      -- `y = π^j * c` lies in `𝔪^j`
      have hy : π ^ j * c ∈ IsLocalRing.maximalIdeal A ^ j := by
        rw [hpow j, Ideal.mem_span_singleton]
        exact ⟨c, rfl⟩
      have hIH : σ • (π ^ j * c) - π ^ j * c ∈ IsLocalRing.maximalIdeal A ^ (i + j) :=
        ih _ hy
      have hxsy : σ • (π ^ j * c) ∈ IsLocalRing.maximalIdeal A ^ j :=
        smul_mem_maximalIdeal_pow A σ j hy
      have hx_eq : x = π * (π ^ j * c) := by rw [hc, pow_succ']; ring
      have hsmul : σ • (π * (π ^ j * c)) = (σ • π) * (σ • (π ^ j * c)) := by
        have h := map_mul (smulRingEquiv A σ) π (π ^ j * c)
        simp only [smulRingEquiv_apply] at h
        exact h
      rw [hx_eq, hsmul]
      have hdecomp : (σ • π) * (σ • (π ^ j * c)) - π * (π ^ j * c)
          = (σ • π - π) * (σ • (π ^ j * c)) + π * (σ • (π ^ j * c) - π ^ j * c) := by
        ring
      rw [hdecomp]
      apply add_mem
      · have h4 : (σ • π - π) * (σ • (π ^ j * c)) ∈
            IsLocalRing.maximalIdeal A ^ (i + (j + 1)) := by
          have h5 := Ideal.mul_mem_mul (hσ π) hxsy
          rwa [← pow_add, show (i + 1) + j = i + (j + 1) by omega] at h5
        exact h4
      · have h3 : π * (σ • (π ^ j * c) - π ^ j * c) ∈
            IsLocalRing.maximalIdeal A * IsLocalRing.maximalIdeal A ^ (i + j) :=
          Ideal.mul_mem_mul hπmem hIH
        rwa [← pow_succ'] at h3

end NK.Ramification
