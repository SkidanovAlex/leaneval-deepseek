/-!
# Two isomorphisms of number fields inducing the same transport of primes are equal

The transport of primes along a ring isomorphism `τ : L₁ ≃+* L₂` of number fields
(`NK.Reconstruct.primeTransport τ`) is functorial, and a ring automorphism `σ` of a number field
which fixes *every* prime of the ring of integers is the identity: passing to the fixed field `F`
of `σ` (over which `K` is Galois with group generated by `σ`, by Artin's theorem) there is a prime
of `𝓞 F` splitting completely in `K`, and the action of the Galois group at a completely split prime
is free — so `σ` cannot fix a prime above it.

Consequently two isomorphisms `e f : K ≃+* L` of number fields inducing the same map on primes
coincide: their ratio `f⁻¹ ∘ e` is an automorphism of `K` fixing every prime, hence is `1`.
-/

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false
set_option autoImplicit false
set_option maxHeartbeats 1600000

namespace NK.ReconstructField

open NK.Reconstruct

/-! ## Functoriality of the transport of primes -/

/-- **The isomorphism of rings of integers induced by a composite is the composite.** -/
lemma ringOfIntegersEquiv_trans {A B C : Type*} [Field A] [Field B] [Field C]
    (e : A ≃+* B) (f : B ≃+* C) :
    NK.Reconstruct.ringOfIntegersEquiv (e.trans f) =
      (NK.Reconstruct.ringOfIntegersEquiv e).trans (NK.Reconstruct.ringOfIntegersEquiv f) := by
  apply RingEquiv.ext
  intro x
  apply Subtype.ext
  show ((NK.Reconstruct.ringOfIntegersEquiv (e.trans f) x : NumberField.RingOfIntegers C) : C) =
    ((NK.Reconstruct.ringOfIntegersEquiv f
      (NK.Reconstruct.ringOfIntegersEquiv e x) : NumberField.RingOfIntegers C) : C)
  rw [NK.Reconstruct.ringOfIntegersEquiv_apply, NK.Reconstruct.ringOfIntegersEquiv_apply,
    NK.Reconstruct.ringOfIntegersEquiv_apply]
  rfl

/-- **Functoriality of the transport of primes**: transporting a prime along a composite of ring
isomorphisms is transporting it successively. -/
lemma primeTransport_trans {A B C : Type*} [Field A] [NumberField A] [Field B] [NumberField B]
    [Field C] [NumberField C] (e : A ≃+* B) (f : B ≃+* C) (P : NK.Chebotarev.PrimeIdeal A) :
    NK.Reconstruct.primeTransport (e.trans f) P =
      NK.Reconstruct.primeTransport f (NK.Reconstruct.primeTransport e P) := by
  apply IsDedekindDomain.HeightOneSpectrum.ext
  show Ideal.map ((NK.Reconstruct.ringOfIntegersEquiv (e.trans f) :
      NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers C)) P.asIdeal =
    Ideal.map ((NK.Reconstruct.ringOfIntegersEquiv f :
      NumberField.RingOfIntegers B →+* NumberField.RingOfIntegers C))
      (Ideal.map ((NK.Reconstruct.ringOfIntegersEquiv e :
        NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers B)) P.asIdeal)
  rw [show ((NK.Reconstruct.ringOfIntegersEquiv (e.trans f) :
        NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers C)) =
      ((NK.Reconstruct.ringOfIntegersEquiv f :
        NumberField.RingOfIntegers B →+* NumberField.RingOfIntegers C)).comp
        ((NK.Reconstruct.ringOfIntegersEquiv e :
          NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers B)) from by
    rw [ringOfIntegersEquiv_trans]
    ext x
    rfl,
    Ideal.map_map]

/-- **Transporting a prime along the identity is the identity.** -/
lemma primeTransport_refl {A : Type*} [Field A] [NumberField A]
    (P : NK.Chebotarev.PrimeIdeal A) :
    NK.Reconstruct.primeTransport (RingEquiv.refl A) P = P := by
  apply IsDedekindDomain.HeightOneSpectrum.ext
  show Ideal.map ((NK.Reconstruct.ringOfIntegersEquiv (RingEquiv.refl A) :
      NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers A)) P.asIdeal = P.asIdeal
  have h1 : ((NK.Reconstruct.ringOfIntegersEquiv (RingEquiv.refl A) :
      NumberField.RingOfIntegers A →+* NumberField.RingOfIntegers A))
      = RingHom.id (NumberField.RingOfIntegers A) := by
    apply RingHom.ext
    intro x
    apply Subtype.ext
    show ((NK.Reconstruct.ringOfIntegersEquiv (RingEquiv.refl A) x :
      NumberField.RingOfIntegers A) : A) = ((x : NumberField.RingOfIntegers A) : A)
    rw [NK.Reconstruct.ringOfIntegersEquiv_apply]
    rfl
  rw [h1, Ideal.map_id]

/-! ## The transport of primes along a Galois automorphism is the Galois action

For a Galois automorphism `σ` of a number field extension `L / K`, the isomorphism of rings of
integers induced by `σ` is its restriction `galRestrict`, so the two actions on primes agree. -/

/-- The isomorphism of rings of integers induced by a Galois automorphism is its restriction
`galRestrict` to the rings of integers. -/
private lemma ringOfIntegersEquiv_eq_galRestrict {K L : Type*} [Field K] [NumberField K]
    [Field L] [NumberField L] [Algebra K L] (σ : Gal(L/K)) :
    (NK.Reconstruct.ringOfIntegersEquiv σ.toRingEquiv :
        NumberField.RingOfIntegers L →+* NumberField.RingOfIntegers L) =
      (galRestrict (NumberField.RingOfIntegers K) K L (NumberField.RingOfIntegers L) σ :
        NumberField.RingOfIntegers L →+* NumberField.RingOfIntegers L) := by
  apply RingHom.ext
  intro x
  apply Subtype.ext
  show ((NK.Reconstruct.ringOfIntegersEquiv σ.toRingEquiv x :
      NumberField.RingOfIntegers L) : L) =
    ((galRestrict (NumberField.RingOfIntegers K) K L (NumberField.RingOfIntegers L) σ x :
      NumberField.RingOfIntegers L) : L)
  rw [NK.Reconstruct.ringOfIntegersEquiv_apply]
  exact (algebraMap_galRestrict_apply (NumberField.RingOfIntegers K) σ x).symm

/-- **The transport of primes along a Galois automorphism is the Galois action on primes.** -/
private lemma primeTransport_eq_smul {K L : Type*} [Field K] [NumberField K] [Field L]
    [NumberField L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L] (σ : Gal(L/K))
    (P : NK.Chebotarev.PrimeIdeal L) :
    NK.Reconstruct.primeTransport σ.toRingEquiv P = σ • P := by
  apply IsDedekindDomain.HeightOneSpectrum.ext
  rw [NK.Chebotarev.smul_primeIdeal_asIdeal]
  show Ideal.map ((NK.Reconstruct.ringOfIntegersEquiv σ.toRingEquiv :
      NumberField.RingOfIntegers L →+* NumberField.RingOfIntegers L)) P.asIdeal =
    Ideal.map ((galRestrict (NumberField.RingOfIntegers K) K L
      (NumberField.RingOfIntegers L) σ :
      NumberField.RingOfIntegers L →+* NumberField.RingOfIntegers L)) P.asIdeal
  rw [ringOfIntegersEquiv_eq_galRestrict]

/-! ## The core lemma: an automorphism fixing every prime is trivial -/

/-- **A ring automorphism of a number field fixing every finite prime is trivial.**

If `σ : K ≃+* K` fixes every nonzero prime ideal of `𝓞 K`, then `σ = 1`: let `F = K ^ ⟨σ⟩` be its
fixed field; by Artin's theorem (`IsGalois.of_fixed_field`) `K / F` is Galois with group generated
by `σ`, and `Commons.NumberTheory.NumberField.exists_prime_splitsCompletely` provides a prime of
`𝓞 F` splitting completely in `K`.  At a completely split prime the action of the Galois group is
free (`NK.UchidaKummer.eq_one_of_smul_eq_of_splitsCompletely`), so the fact that `σ` fixes a
prime above it forces `σ = 1`. -/
private lemma eq_one_of_primeTransport_eq_self_aux {K : Type*} [Field K] [NumberField K]
    (σ : K ≃+* K)
    (h : ∀ P : NK.Chebotarev.PrimeIdeal K, NK.Reconstruct.primeTransport σ P = P) :
    σ = 1 := by
  classical
  -- a ring automorphism of a field of characteristic zero fixes `ℚ`
  have hfix : ∀ q : ℚ, σ (algebraMap ℚ K q) = algebraMap ℚ K q := by
    intro q
    simpa using map_ratCast σ q
  -- `σ` as an automorphism of `K` over `ℚ`
  let σa : K ≃ₐ[ℚ] K := AlgEquiv.ofRingEquiv (f := σ) hfix
  -- the fixed field of `σ`
  let F : IntermediateField ℚ K := IntermediateField.fixedField (Subgroup.zpowers σa)
  haveI hFfd : FiniteDimensional ↥F K := inferInstance
  haveI hFgal : IsGalois ↥F K := IsGalois.of_fixed_field K (Subgroup.zpowers σa)
  haveI hFnum : NumberField ↥F :=
    Commons.NumberTheory.NumberField.numberField_of_intermediateField F
  -- `σ` fixes `F` pointwise, hence is an automorphism of `K` over `F`
  have hfixF : ∀ x : ↥F, σ (algebraMap ↥F K x) = algebraMap ↥F K x := by
    intro x
    have hx : (x : K) ∈ F := x.2
    have hmem : σa (x : K) = (x : K) :=
      (IntermediateField.mem_fixedField_iff (Subgroup.zpowers σa) (x : K)).mp hx σa
        (Subgroup.mem_zpowers σa)
    show σ (x : K) = (x : K)
    rw [← AlgEquiv.ofRingEquiv_apply (f := σ) hfix (x : K)]
    exact hmem
  let σF : K ≃ₐ[↥F] K := AlgEquiv.ofRingEquiv (f := σ) hfixF
  have hσFcoe : σF.toRingEquiv = σ := by
    apply RingEquiv.ext
    intro x
    exact AlgEquiv.ofRingEquiv_apply (f := σ) hfixF x
  -- a prime of `𝓞 F` splitting completely in `K`, and a prime of `𝓞 K` above it
  obtain ⟨𝔮, hsplit⟩ :=
    Commons.NumberTheory.NumberField.exists_prime_splitsCompletely (K := ↥F) (L := K)
  obtain ⟨P, hP⟩ :=
    Commons.NumberTheory.NumberField.exists_heightOneSpectrum_liesOver (K := ↥F) (L := K) 𝔮
  -- `σ` fixes `P`, so it lies in the (trivial) decomposition group of `P`
  have hsmul : σF • P = P := by
    rw [← primeTransport_eq_smul σF P, hσFcoe]
    exact h P
  have hσF1 : σF = 1 :=
    NK.UchidaKummer.eq_one_of_smul_eq_of_splitsCompletely hsplit hP hsmul
  have : (σF.toRingEquiv : K ≃+* K) = 1 := by rw [hσF1]; rfl
  rwa [hσFcoe] at this

/-! ## The main theorem -/

/-- **Two ring isomorphisms of number fields inducing the same transport of primes are equal.** -/
theorem eq_of_primeTransport_eq {K L : Type*} [Field K] [NumberField K] [Field L] [NumberField L]
    (e f : K ≃+* L)
    (h : ∀ P : NK.Chebotarev.PrimeIdeal K,
      NK.Reconstruct.primeTransport e P = NK.Reconstruct.primeTransport f P) :
    e = f := by
  -- the ratio `e ∘ f⁻¹` fixes every prime of `𝓞 K`
  have hσ : ∀ P : NK.Chebotarev.PrimeIdeal K,
      NK.Reconstruct.primeTransport (e.trans f.symm) P = P := by
    intro P
    rw [primeTransport_trans, h P, ← primeTransport_trans (e := f) (f := f.symm)]
    rw [show f.trans f.symm = RingEquiv.refl K from RingEquiv.ext (fun x => by simp),
      primeTransport_refl]
  -- hence it is the identity
  have h1 : e.trans f.symm = 1 := eq_one_of_primeTransport_eq_self_aux (e.trans f.symm) hσ
  calc e = (e.trans f.symm).trans f := (RingEquiv.ext (fun x => by simp)).symm
    _ = (1 : K ≃+* K).trans f := by rw [h1]
    _ = f := by ext x; simp

end NK.ReconstructField
