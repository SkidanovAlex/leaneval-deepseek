# Filtered systems of level data and their colimits

The coefficient layer `Submission/Work/BrauerTwist/Basic.lean` produces, for every closed subgroup
`U ≤ Gal(K'/K)`, a *system* of finite level data: the level cohomologies `H²(U, μ_p(L))` indexed by
the finite Galois levels `L` of `K'/K`, connected by transition maps `levelMap`.  This file isolates
the abstract bookkeeping of such systems — the colimit, the structure maps, the universal property
and the normal form for equality in the colimit — *once*, so that the twisted
(`μ_p`-)cohomology of `Profinite.lean` can be obtained by instantiating it, and so that the same
machinery serves the (trivial-coefficient) colimit of `Submission/Work/BrauerHasse/Profinite.lean`
if it is ever re-instantiated.

A `LevelSystem` is
* a type family `obj L` over the finite Galois intermediate fields `L` of `K'/K`,
* transition maps `map h : obj L → obj L'` for `L ≤ L'`,
* the two coherence laws `map_refl` and `map_comp`.

This is all the structure the colimit bookkeeping needs.  The key point (which is what makes the
colimit computable) is that the finite Galois intermediate fields are *directed* under `⊔`, so the
equivalence relation generated by the transition maps is the relation "the two elements agree after
mapping to a common dominating level".

## Main definitions

* `NK.BrauerTwist.LevelSystem`, `NK.BrauerTwist.LevelSystem.Colim`;
* `NK.BrauerTwist.LevelSystem.ofLevel`, `.lift` — the structure map and the universal property;
* `NK.BrauerTwist.LevelSystem.ofLevel_eq_iff` — equality in the colimit.
-/

import Mathlib
import Mathlib.FieldTheory.Galois.GaloisClosure
-- PORT435-BEGIN (v4.35 isDefEq respectTransparency compat)
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false
-- PORT435-END

set_option autoImplicit false

universe u

namespace NK.BrauerTwist

/-- A **level system**: a directed system of level data over the finite Galois intermediate fields
of `K'/K` (directed by the lattice structure, `⊔`).  The only structure needed for the colimit
bookkeeping is the type family together with the transition maps and their two coherence laws. -/
structure LevelSystem (K K' : Type u) [Field K] [Field K'] [Algebra K K'] where
  /-- the level data at a finite Galois level -/
  obj : FiniteGaloisIntermediateField K K' → Type u
  /-- the transition map between levels -/
  map : ∀ ⦃L L' : FiniteGaloisIntermediateField K K'⦄, L ≤ L' → obj L → obj L'
  /-- the transition map of the identity inclusion is the identity -/
  map_refl : ∀ (L : FiniteGaloisIntermediateField K K') (x : obj L), map (le_refl L) x = x
  /-- the transition maps compose -/
  map_comp : ∀ {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'} (h₁ : L₁ ≤ L₂) (h₂ : L₂ ≤ L₃)
    (x : obj L₁), map h₂ (map h₁ x) = map (h₁.trans h₂) x

namespace LevelSystem

variable {K K' : Type u} [Field K] [Field K'] [Algebra K K']

section defs

variable (S : LevelSystem K K')

/-- The generating relation of the colimit: an element of a level and its image under a transition
map to a larger level. -/
def gen : (Σ L : FiniteGaloisIntermediateField K K', S.obj L) →
    (Σ L : FiniteGaloisIntermediateField K K', S.obj L) → Prop :=
  fun x y => ∃ (h : x.1 ≤ y.1), y.2 = S.map h x.2

/-- **The colimit of a level system.**  It is implemented by hand, as the quotient of the disjoint
union of the level data by the equivalence relation generated by the transition maps. -/
def Colim : Type u := Quot (Relation.EqvGen S.gen)

/-- The structure map from a level into the colimit. -/
def ofLevel (L : FiniteGaloisIntermediateField K K') (a : S.obj L) : S.Colim :=
  Quot.mk _ ⟨L, a⟩

end defs

variable {S : LevelSystem K K'}

/-- **Every element of the colimit comes from a finite level.** -/
lemma ofLevel_surjective (x : S.Colim) :
    ∃ (L : FiniteGaloisIntermediateField K K') (a : S.obj L), S.ofLevel L a = x := by
  induction x using Quot.ind with
  | _ y => exact ⟨y.1, y.2, rfl⟩

/-- An element of a level and its image in a larger level define the same class. -/
lemma ofLevel_map {L L' : FiniteGaloisIntermediateField K K'} (h : L ≤ L') (a : S.obj L) :
    S.ofLevel L' (S.map h a) = S.ofLevel L a :=
  (Quot.sound (Relation.EqvGen.rel _ _ ⟨h, rfl⟩)).symm

/-- The transition maps are insensitive to the proof of the inclusion (the levels form a partial
order, so the type of inclusions is a proposition). -/
lemma map_congr {L L' : FiniteGaloisIntermediateField K K'} {h h' : L ≤ L'} :
    S.map h = S.map h' := by
  rw [Subsingleton.elim h h']

/-- **The universal property of the colimit**: a compatible family of maps on the levels descends
to the colimit. -/
def lift {β : Sort*} (f : ∀ L : FiniteGaloisIntermediateField K K', S.obj L → β)
    (hf : ∀ (L L' : FiniteGaloisIntermediateField K K') (h : L ≤ L') (a : S.obj L),
      f L' (S.map h a) = f L a) : S.Colim → β :=
  Quot.lift (fun x => f x.1 x.2) (by
    intro x y hxy
    induction hxy with
    | rel x y hxy => exact (hf x.1 y.1 hxy.1 x.2).symm.trans (congrArg (f y.1) hxy.2).symm
    | refl x => rfl
    | symm x y hxy ih => exact ih.symm
    | trans x y z hxy hyz ihxy ihyz => exact ihxy.trans ihyz)

@[simp]
lemma lift_ofLevel {β : Sort*} (f : ∀ L : FiniteGaloisIntermediateField K K', S.obj L → β)
    (hf : ∀ (L L' : FiniteGaloisIntermediateField K K') (h : L ≤ L') (a : S.obj L),
      f L' (S.map h a) = f L a)
    (L : FiniteGaloisIntermediateField K K') (a : S.obj L) :
    S.lift f hf (S.ofLevel L a) = f L a := rfl

/-- Two maps out of the colimit agreeing on all levels are equal. -/
lemma lift_unique {β : Sort*} (f : ∀ L : FiniteGaloisIntermediateField K K', S.obj L → β)
    (hf : ∀ (L L' : FiniteGaloisIntermediateField K K') (h : L ≤ L') (a : S.obj L),
      f L' (S.map h a) = f L a)
    (g : S.Colim → β) (hg : ∀ L a, g (S.ofLevel L a) = f L a) :
    g = S.lift f hf := by
  funext x
  obtain ⟨L, a, rfl⟩ := ofLevel_surjective x
  rw [lift_ofLevel, hg]

/-! ## Equality in the colimit -/

section equality

variable (S : LevelSystem K K')

/-- Elementwise form of `LevelSystem.map_comp`. -/
lemma map_map {L₁ L₂ L₃ : FiniteGaloisIntermediateField K K'} (h₁ : L₁ ≤ L₂) (h₂ : L₂ ≤ L₃)
    (x : S.obj L₁) : S.map h₂ (S.map h₁ x) = S.map (h₁.trans h₂) x :=
  S.map_comp h₁ h₂ x

/-- **Description of the equivalence relation generated by the transition maps.**

Two elements of the disjoint union of the levels become equal in the colimit if and only if they
agree after mapping to a common dominating finite Galois level.  The directedness of the levels
enters through the transitivity step: the compositum of two dominating levels is again one. -/
theorem eqvGen_gen_iff (x y : Σ L : FiniteGaloisIntermediateField K K', S.obj L) :
    Relation.EqvGen S.gen x y ↔
      ∃ (M : FiniteGaloisIntermediateField K K') (h₁ : x.1 ≤ M) (h₂ : y.1 ≤ M),
        S.map h₁ x.2 = S.map h₂ y.2 := by
  constructor
  · intro h
    induction h with
    | rel a b hab =>
        obtain ⟨hab, hb⟩ := hab
        refine ⟨a.1 ⊔ b.1, le_sup_left, le_sup_right, ?_⟩
        calc S.map (le_sup_left : a.1 ≤ a.1 ⊔ b.1) a.2
            = S.map (hab.trans (le_sup_right : b.1 ≤ a.1 ⊔ b.1)) a.2 :=
                congrFun (map_congr (S := S)) a.2
          _ = S.map (le_sup_right : b.1 ≤ a.1 ⊔ b.1) (S.map hab a.2) :=
                (S.map_map hab le_sup_right a.2).symm
          _ = S.map (le_sup_right : b.1 ≤ a.1 ⊔ b.1) b.2 := by rw [← hb]
    | refl a => exact ⟨a.1, le_rfl, le_rfl, rfl⟩
    | symm a b hab ih =>
        obtain ⟨M, h₁, h₂, e⟩ := ih
        exact ⟨M, h₂, h₁, e.symm⟩
    | trans a b c hab hbc ihab ihbc =>
        obtain ⟨M₁, ha₁, hb₁, e₁⟩ := ihab
        obtain ⟨M₂, hb₂, hc₂, e₂⟩ := ihbc
        refine ⟨M₁ ⊔ M₂, ha₁.trans le_sup_left, hc₂.trans le_sup_right, ?_⟩
        calc S.map (ha₁.trans le_sup_left) a.2
            = S.map (le_sup_left : M₁ ≤ M₁ ⊔ M₂) (S.map ha₁ a.2) :=
                (S.map_map ha₁ le_sup_left a.2).symm
          _ = S.map (le_sup_left : M₁ ≤ M₁ ⊔ M₂) (S.map hb₁ b.2) := by rw [e₁]
          _ = S.map (hb₁.trans le_sup_left) b.2 := S.map_map hb₁ le_sup_left b.2
          _ = S.map (hb₂.trans le_sup_right) b.2 := congrFun (map_congr (S := S)) b.2
          _ = S.map (le_sup_right : M₂ ≤ M₁ ⊔ M₂) (S.map hb₂ b.2) :=
                (S.map_map hb₂ le_sup_right b.2).symm
          _ = S.map (le_sup_right : M₂ ≤ M₁ ⊔ M₂) (S.map hc₂ c.2) := by rw [e₂]
          _ = S.map (hc₂.trans le_sup_right) c.2 := S.map_map hc₂ le_sup_right c.2
  · rintro ⟨M, h₁, h₂, e⟩
    refine Relation.EqvGen.trans x (⟨M, S.map h₁ x.2⟩ : Σ L, S.obj L) y ?_ ?_
    · exact Relation.EqvGen.rel x _ ⟨h₁, rfl⟩
    · rw [show (⟨M, S.map h₁ x.2⟩ : Σ L, S.obj L) = (⟨M, S.map h₂ y.2⟩ : Σ L, S.obj L)
        from by rw [e]]
      exact (Relation.EqvGen.rel y _ ⟨h₂, rfl⟩).symm

/-- **Two classes of the colimit coincide if and only if they already coincide on a common
dominating finite level.** -/
theorem ofLevel_eq_iff {L L' : FiniteGaloisIntermediateField K K'} (a : S.obj L) (b : S.obj L') :
    S.ofLevel L a = S.ofLevel L' b ↔
      ∃ (M : FiniteGaloisIntermediateField K K') (h₁ : L ≤ M) (h₂ : L' ≤ M),
        S.map h₁ a = S.map h₂ b := by
  have key := S.eqvGen_gen_iff (⟨L, a⟩ : Σ L, S.obj L) (⟨L', b⟩ : Σ L, S.obj L)
  have hidem : ∀ {x y : Σ L : FiniteGaloisIntermediateField K K', S.obj L},
      Relation.EqvGen (Relation.EqvGen S.gen) x y ↔ Relation.EqvGen S.gen x y :=
    fun {_ _} => Equivalence.eqvGen_iff (Relation.EqvGen.is_equivalence S.gen)
  constructor
  · intro h
    exact key.mp (hidem.mp (Quot.eqvGen_exact h))
  · rintro ⟨M, h₁, h₂, e⟩
    exact Quot.eqvGen_sound (hidem.mpr (key.mpr ⟨M, h₁, h₂, e⟩))

end equality

end LevelSystem

end NK.BrauerTwist
