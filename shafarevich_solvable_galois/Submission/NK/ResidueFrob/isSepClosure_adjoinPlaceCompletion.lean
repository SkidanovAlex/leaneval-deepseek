import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.DedekindDomain.AdicValuation
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import Submission.NK.NeukirchUchida.nonempty_mulEquiv_decompositionGroupOf_adjoin

/-!
# `M = K_p·K'` is a separable closure of the `p`-adic completion `K_p`

Let `K` be a number field, `p` a finite place of `K`, `K'` a separable closure of `K`, `A` a place
of `K'` above `p`, `C = placeCompletion A` the completion of `K'` at `A`, and let

`M = adjoinPlaceCompletion p A = K_p · K' ⊆ C`

be the subfield of `C` generated by the image of the `p`-adic completion `K_p` of `K` and the
image of `K'`.

Then `M` is a separable closure of `K_p` (Neukirch–Schmidt–Wingberg, Chapter XII, step 5 of the
proof of the local decomposition theorem).  Concretely:

* every element of `M` is algebraic over `K_p` (the image of `K'` consists of algebraic elements,
  and `K_p` is algebraic over `K`), and `K_p` has characteristic zero, so `M/K_p` is separable;
* conversely, the separable closure of `K_p` in `C` is contained in `M`: an element of `C` which is
  algebraic over `K_p` is algebraic over `K`, hence lies in the image of `K'`
  (`isAlgebraic_iff_exists_placeCompletionCoe`).

Hence `M = separableClosure K_p C`, and the latter is a separable closure of `K_p` because `C` is
separably closed (`isSepClosed_placeCompletion`).
-/

namespace NK.ResidueFrob

open scoped Pointwise Valued

/-- **The subfield `M = K_p · K'` of the completion `C = placeCompletion A` generated by `K_p` and
the image of `K'` is a separable closure of `K_p`.** -/
theorem isSepClosure_adjoinPlaceCompletion {K : Type*} [Field K] [NumberField K]
    {K' : Type*} [Field K'] [Algebra K K'] [IsSepClosure K K']
    (p : IsDedekindDomain.HeightOneSpectrum (NumberField.RingOfIntegers K))
    (A : ValuationSubring K')
    (hA : A.comap (algebraMap K K') =
      IsDedekindDomain.HeightOneSpectrum.valuationSubringAtPrime K p)
    [Algebra (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      (NK.NeukirchUchida.placeCompletion A)]
    (halg : ∀ z : IsDedekindDomain.HeightOneSpectrum.adicCompletion K p,
      algebraMap _ _ z = NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA z) :
    IsSepClosure (IsDedekindDomain.HeightOneSpectrum.adicCompletion K p)
      ↥(NK.NeukirchUchida.adjoinPlaceCompletion p A) := by
  let Kp := IsDedekindDomain.HeightOneSpectrum.adicCompletion K p
  have hΦ : (algebraMap Kp (NK.NeukirchUchida.placeCompletion A)) =
      NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA := RingHom.ext halg
  have hCZ : CharZero Kp := charZero_of_injective_algebraMap (RingHom.injective (algebraMap K Kp))
  have hSepC : IsSepClosed (NK.NeukirchUchida.placeCompletion A) :=
    NK.NeukirchUchida.isSepClosed_placeCompletion p A hA
  -- every element of `M` is algebraic over `K_p`
  have hM_alg : ∀ x ∈ NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A,
      IsAlgebraic Kp x :=
    fun x hx => NK.NeukirchUchida.isAlgebraic_of_mem_adjoinPlaceCompletion p A hA halg hx
  -- `M` is contained in the separable closure of `K_p` in `C` (`K_p` is perfect)
  have hM_le_sep : NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A ≤
      separableClosure Kp (NK.NeukirchUchida.placeCompletion A) := by
    intro x hx
    rw [mem_separableClosure_iff]
    exact PerfectField.separable_of_irreducible (minpoly.irreducible (hM_alg x hx).isIntegral)
  -- conversely, every element separable over `K_p` lies in `M`
  have hsep_le_M : separableClosure Kp (NK.NeukirchUchida.placeCompletion A) ≤
      NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A := by
    intro x hx
    rw [mem_separableClosure_iff] at hx
    obtain ⟨q, hq0, hqx⟩ := hx.isIntegral.isAlgebraic
    -- `x` is a root of a nonzero polynomial over `K_p`; Krasner's lemma then puts `x` into the
    -- subfield generated by `K_p` and a single element of `K'`.
    have hx' : ∃ q : Polynomial Kp, q ≠ 0 ∧
        Polynomial.eval₂ (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) x q = 0 :=
      ⟨q, hq0, by
        rw [Polynomial.aeval_def, hΦ] at hqx
        exact hqx⟩
    obtain ⟨y, hy⟩ := NK.NeukirchUchida.exists_mem_subfieldClosure_of_eval_eq_zero p A hA
      (NK.NeukirchUchida.comap_adicCompletionToPlaceCompletion_eq_adicCompletionIntegers p A hA)
      hx'
    have hsub : Set.range (NK.NeukirchUchida.adicCompletionToPlaceCompletion p A hA) ∪
        {NK.NeukirchUchida.placeCompletionCoe A y} ⊆
        (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A :
          Set (NK.NeukirchUchida.placeCompletion A)) := by
      rintro z (⟨w, rfl⟩ | rfl)
      · rw [← hΦ]
        exact (NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A).algebraMap_mem w
      · exact IntermediateField.subset_adjoin Kp
          (Set.range (NK.NeukirchUchida.placeCompletionCoe A)) ⟨y, rfl⟩
    exact Subfield.closure_le.mpr hsub hy
  have hMeq : NK.NeukirchUchida.adjoinPlaceCompletion (K := K) (K' := K') p A =
      separableClosure Kp (NK.NeukirchUchida.placeCompletion A) :=
    le_antisymm hM_le_sep hsep_le_M
  -- `M = separableClosure K_p C`, which is a separable closure of `K_p` as `C` is separably closed
  exact hMeq ▸ (separableClosure.isSepClosure Kp (NK.NeukirchUchida.placeCompletion A))

end NK.ResidueFrob
