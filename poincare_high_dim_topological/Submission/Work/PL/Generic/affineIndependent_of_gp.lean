import Mathlib
import Submission.Work.PL.Defs
import Submission.Work.PL.Generic.Basic
import Submission.Work.PL.Generic.Hull
import Submission.Work.PL.Generic.eq_of_sum_smul_eq_of_affineIndependent
import Submission.Work.PL.Generic.affineSpan_eq_top_of_sum_smul_ne

namespace Work.PL.Generic

variable {n : ℕ} {ι : Type*}

/-- The affine span of the image of at most `n` points of `ℝⁿ` is not everything: an affine subspace
of `ℝⁿ` generated by `k ≤ n` points has direction of dimension `≤ k - 1 < n`.  (Mathlib's
`affineSpan_image_ne_top_of_encard_le_finrank`, together with
`Set.encard_coe_eq_coe_finsetCard` and `finrank ℝ (EuclideanSpace ℝ (Fin n)) = n`.) -/
theorem affineSpan_image_ne_top_of_card_le (y : ι → PL.E n) (T : Finset ι) (hT : T.card ≤ n) :
    affineSpan ℝ (y '' (T : Set ι)) ≠ ⊤ := by
  refine affineSpan_image_ne_top_of_encard_le_finrank ℝ T.finite_toSet ?_ y
  rw [Set.encard_coe_eq_coe_finsetCard,
    show Module.finrank ℝ (PL.E n) = n from by simp [PL.E]]
  exact_mod_cast hT

/-- **Extraction of an explicit affine dependence.**  If the vertex family `fun v : ↥σ => y v` is not
affinely independent, then there are coefficients `c : ι → ℝ`, supported on `σ`, which are not all
zero and satisfy the two affine-dependence relations `∑ c = 0`, `∑ c • y = 0`.  (Unfold
`AffineIndependent` through `affineIndependent_iff_of_fintype`, `Finset.weightedVSub_eq_linear_combination`
and transport the coefficients from the subtype `↥σ` to `ι`.) -/
theorem exists_coeff_of_not_affineIndependent [DecidableEq ι]
    (y : ι → PL.E n) (σ : Finset ι)
    (h : ¬ AffineIndependent ℝ (fun v : ↥σ => y ↑v)) :
    ∃ c : ι → ℝ, (∑ v ∈ σ, c v = 0) ∧ (∑ v ∈ σ, c v • y v = 0) ∧ ∃ v ∈ σ, c v ≠ 0 := by
  classical
  rw [affineIndependent_iff_of_fintype] at h
  push Not at h
  obtain ⟨w, hw0, hwv, hwi⟩ := h
  have hwv' : ∑ i : ↥σ, w i • y ↑i = 0 := by
    rw [← Finset.weightedVSub_eq_linear_combination Finset.univ hw0, hwv]
  set c : ι → ℝ := fun v => if hv : v ∈ σ then w ⟨v, hv⟩ else 0 with hc
  have hcv : ∀ v hv, c v = w ⟨v, hv⟩ := by intro v hv; simp only [hc]; rw [dite_eq_left hv]
  have hsum1 : (∑ v ∈ σ, c v) = ∑ i : ↥σ, w i := by
    rw [← Finset.sum_attach σ c, Finset.attach_eq_univ]
    exact Finset.sum_congr rfl (fun x _ => hcv ↑x x.property)
  have hsum2 : (∑ v ∈ σ, c v • y v) = ∑ i : ↥σ, w i • y ↑i := by
    rw [← Finset.sum_attach σ (fun v => c v • y v), Finset.attach_eq_univ]
    exact Finset.sum_congr rfl (fun x _ => by rw [hcv ↑x x.property])
  refine ⟨c, by rw [hsum1, hw0], by rw [hsum2, hwv'], ?_⟩
  obtain ⟨i, hi⟩ := hwi
  exact ⟨↑i, i.property, by rw [hcv ↑i i.property]; exact hi⟩

/-- **The frozen part absorbs a dependence supported on it.**  If a nonzero affine dependence
`∑ c = 0`, `∑ c • y = 0` of the vertices along `σ` is supported on `fz` (i.e. every vertex of `σ`
with `c v ≠ 0` is frozen), then `c` vanishes identically on `σ` — because it restricts to a
dependence of the affinely independent frozen part `σ ∩ fz`. -/
theorem eq_zero_of_dependence_supported_on_frozen [DecidableEq ι]
    (fz : Finset ι) (y : ι → PL.E n) (σ : Finset ι)
    (hnd : AffineIndependent ℝ (fun v : ↥(σ ∩ fz) => y ↑v))
    {c : ι → ℝ} (hc0 : ∑ v ∈ σ, c v = 0) (hcy : ∑ v ∈ σ, c v • y v = 0)
    (hfr : ∀ v ∈ σ, c v ≠ 0 → v ∈ fz) :
    ∀ v ∈ σ, c v = 0 := by
  classical
  set d : ↥(σ ∩ fz) → ℝ := fun i => c ↑i with hd
  have hsub : σ ∩ fz ⊆ σ := Finset.inter_subset_left
  have hzv : ∀ v ∈ σ, v ∉ σ ∩ fz → c v = 0 := by
    intro v hv hvn
    by_contra hcne
    exact hvn (Finset.mem_inter.mpr ⟨hv, hfr v hv hcne⟩)
  have hd0 : ∑ i : ↥(σ ∩ fz), d i = 0 := by
    have h1 : (∑ i : ↥(σ ∩ fz), d i) = ∑ v ∈ σ ∩ fz, c v := by
      rw [← Finset.sum_attach (σ ∩ fz) c, Finset.attach_eq_univ]
    rw [h1, Finset.sum_subset hsub hzv, hc0]
  have hdy : ∑ i : ↥(σ ∩ fz), d i • y ↑i = 0 := by
    have h1 : (∑ i : ↥(σ ∩ fz), d i • y ↑i) = ∑ v ∈ σ ∩ fz, c v • y v := by
      rw [← Finset.sum_attach (σ ∩ fz) (fun v => c v • y v), Finset.attach_eq_univ]
    rw [h1, Finset.sum_subset hsub (fun v hv hvn => by rw [hzv v hv hvn, zero_smul]), hcy]
  intro v hv
  by_cases hvf : v ∈ fz
  · exact hnd.eq_zero_of_sum_eq_zero hd0 hdy ⟨v, Finset.mem_inter.mpr ⟨hv, hvf⟩⟩ (Finset.mem_univ _)
  · exact hzv v hv (fun h => hvf (Finset.mem_inter.mp h).2)

/-- Generic position implies affine independence, given independence of the frozen part.  Proof: a
minimal dependent subset (circuit) `C ⊆ σ` which is not contained in `σ ∩ fz` contains a free `u`,
and then `y u ∈ affineSpan ℝ (y '' (C \ {u}))` with `|C \ {u}| ≤ |σ| - 1 ≤ n`; an affine span of at
most `n` points of `ℝⁿ` has dimension `< n`, so it cannot be `⊤`, contradicting `hgp`.  (Compare
`AffineIndependent.affineIndependent_iff_not_finrank_vectorSpan_le` /
`finrank_vectorSpan_range_add_one_le` for the dimension bound.) -/
theorem affineIndependent_of_gp {n : ℕ} {ι : Type*} [DecidableEq ι]
    (fz : Finset ι) (y : ι → PL.E n) (σ : Finset ι) (hcard : σ.card ≤ n + 1)
    (hgp : ∀ u, u ∉ fz → ∀ T : Finset ι, T ⊆ σ → u ∉ T →
      y u ∈ (affineSpan ℝ (y '' (T : Set ι)) : Set (PL.E n)) →
        affineSpan ℝ (y '' (T : Set ι)) = ⊤)
    (hnd : AffineIndependent ℝ (fun v : ↥(σ ∩ fz) => y v)) :
    AffineIndependent ℝ (fun v : ↥σ => y v) := by
  classical
  by_contra hcon
  obtain ⟨c, hc0, hcy, v0, hv0, hcv0⟩ := exists_coeff_of_not_affineIndependent y σ hcon
  -- There is a *free* index `u ∈ σ` with `c u ≠ 0`: otherwise `c` is supported on the frozen part.
  have hex : ∃ u, u ∈ σ ∧ c u ≠ 0 ∧ u ∉ fz := by
    by_contra h
    push Not at h
    exact hcv0 (eq_zero_of_dependence_supported_on_frozen fz y σ hnd hc0 hcy h v0 hv0)
  obtain ⟨u, huσ, hcu, hufz⟩ := hex
  -- `y u` lies in the affine span of the remaining vertices `σ \ {u}`.
  have hmem : y u ∈ (affineSpan ℝ (y '' (((σ.erase u : Finset ι)) : Set ι)) : Set (PL.E n)) :=
    mem_affineSpan_erase_of_sum_smul_eq_zero σ y huσ hcu hc0 hcy
  have hsub : σ.erase u ⊆ σ := Finset.erase_subset u σ
  have hnu : u ∉ σ.erase u := Finset.notMem_erase u σ
  -- Generic position then forces that affine span to be everything.
  have htop := hgp u hufz (σ.erase u) hsub hnu hmem
  -- But `σ \ {u}` has at most `n` elements and `ℝⁿ` needs `n + 1` points to be spanned.
  have hcard' : (σ.erase u).card ≤ n := by
    rw [Finset.card_erase_of_mem huσ]; omega
  exact affineSpan_image_ne_top_of_card_le y (σ.erase u) hcard' htop

end Work.PL.Generic
