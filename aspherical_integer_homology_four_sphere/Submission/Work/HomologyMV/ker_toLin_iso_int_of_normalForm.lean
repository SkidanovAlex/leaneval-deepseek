import Mathlib
import Submission.Work.HomologyMV.LinAlg

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The kernel of a matrix in normal form `[1_m | 0]`

This file proves the certificate behind `ker φ₃ ≅ ℤ`, i.e. `H₄(M̂) ≅ ℤ`:

if an `m × (m+1)` integer matrix `A` becomes `projMat m = [1_m | 0]` after an invertible
change of basis `P` (with inverse `Q`), then the kernel of `A` (viewed as a map
`ℤ^{m+1} → ℤ^m`) is `ℤ`, generated by the `(m+1)`-st column of `P`.

The proof has two ingredients.
* `ker (toLin' (projMat m))` is `ℤ`: the projection dropping the last coordinate has kernel
  the vectors supported at the last coordinate (`KerNF.projKernelEquiv`).
* Changing basis along a linear equivalence does not change the kernel
  (`KerNF.comapLinearEquiv`), and `A * P = projMat m` exhibits `ker (toLin' (projMat m))`
  as the pullback of `ker (toLin' A)` along `toLin' P`, which is an equivalence.
-/

namespace Work.HomologyMV

namespace KerNF

noncomputable section

/-- Componentwise formula for the linear map `toLin' (projMat m)`: it forgets the last
coordinate. -/
theorem toLin'_projMat_apply (m : ℕ) (v : Fin (m + 1) → ℤ) (i : Fin m) :
    Matrix.toLin' (projMat m) v i = v (Fin.castSucc i) := by
  rw [Matrix.toLin'_apply, Matrix.mulVec_apply]
  rw [dotProduct]
  rw [Fintype.sum_eq_single (Fin.castSucc i)]
  · simp
  · intro b hb
    simp only [Matrix.row_apply, projMat_apply_val]
    have : ¬ ((b : ℕ) = (i : ℕ)) := by intro h; exact hb (Fin.ext h)
    simp [this]

/-- A vector supported at the last coordinate lies in the kernel of `toLin' (projMat m)`. -/
theorem toLin'_projMat_single_last (m : ℕ) (k : ℤ) :
    Matrix.toLin' (projMat m) (Pi.single (Fin.last m) k) = 0 := by
  funext i
  rw [toLin'_projMat_apply]
  exact Pi.single_eq_of_ne (M := fun _ => ℤ) (Fin.castSucc_ne_last i) k

/-- Evaluation at the last coordinate, as a linear functional on `ker (toLin' (projMat m))`. -/
def projKerEval (m : ℕ) : (Matrix.toLin' (projMat m)).ker →ₗ[ℤ] ℤ :=
  (LinearMap.proj (Fin.last m)).comp (Submodule.subtype _)

/-- The generator of `ker (toLin' (projMat m))`: the vector with `1` at the last coordinate. -/
def projKerGen (m : ℕ) : ℤ →ₗ[ℤ] (Matrix.toLin' (projMat m)).ker :=
  LinearMap.toSpanSingleton ℤ _ ⟨Pi.single (Fin.last m) (1 : ℤ), toLin'_projMat_single_last m 1⟩

theorem projKerEval_comp_projKerGen (m : ℕ) :
    projKerEval m ∘ₗ projKerGen m = LinearMap.id := by
  apply LinearMap.ext
  intro k
  simp [projKerEval, projKerGen, LinearMap.toSpanSingleton_apply, Pi.single_eq_same]

theorem projKerGen_comp_projKerEval (m : ℕ) :
    projKerGen m ∘ₗ projKerEval m = LinearMap.id := by
  ext x j
  simp only [LinearMap.comp_apply, LinearMap.id_apply, projKerEval, projKerGen,
    LinearMap.toSpanSingleton_apply, LinearMap.proj_apply, Submodule.subtype_apply,
    Submodule.coe_smul]
  by_cases hj : j = Fin.last m
  · subst hj
    simp [Pi.single_eq_same]
  · obtain ⟨i, rfl⟩ := Fin.eq_castSucc_of_ne_last hj
    rw [Pi.smul_apply, Pi.single_eq_of_ne (M := fun _ => ℤ) (Fin.castSucc_ne_last i), smul_zero]
    have hx := congrFun x.2 i
    rw [toLin'_projMat_apply] at hx
    exact hx.symm

/-- **The kernel of the normal form `projMat m = [1_m | 0]` is `ℤ`.** -/
def projKernelEquiv (m : ℕ) : (Matrix.toLin' (projMat m)).ker ≃ₗ[ℤ] ℤ :=
  LinearEquiv.ofLinearMap (projKerEval m) (projKerGen m)
    (projKerEval_comp_projKerGen m) (projKerGen_comp_projKerEval m)

/-- **Kernels are unchanged by a linear equivalence.** For a linear equivalence `e : M ≃ M'`
and a submodule `S ≤ M'`, the pullback `e ⁻¹' S` is linearly equivalent to `S`. -/
def comapLinearEquiv {M M' : Type*} [AddCommGroup M] [AddCommGroup M'] (e : M ≃ₗ[ℤ] M')
    (S : Submodule ℤ M') : (S.comap (e : M →ₗ[ℤ] M')) ≃ₗ[ℤ] S where
  toFun x := ⟨e x.1, x.2⟩
  invFun y := ⟨e.symm y.1, by
    show e (e.symm y.1) ∈ S
    rw [e.apply_symm_apply]; exact y.2⟩
  left_inv x := by ext; simp
  right_inv y := by ext; simp
  map_add' x y := by ext; simp
  map_smul' c x := by ext; simp

end

end KerNF

/-- The kernel of an `m × (m+1)` integer matrix `A` that becomes the normal form `projMat m = [1_m | 0]` after an invertible change of basis `P` (with inverse `Q`) is `ℤ`, generated by the last column of `P`. This is the certificate behind `ker φ₃ ≅ ℤ`, i.e. `H₄(M̂) ≅ ℤ`. -/
theorem ker_toLin_iso_int_of_normalForm (m : ℕ) (A : Matrix (Fin m) (Fin (m + 1)) ℤ) (P Q : Matrix (Fin (m + 1)) (Fin (m + 1)) ℤ) (hPQ : P * Q = 1) (hQP : Q * P = 1) (hproj : A * P = projMat m) : Nonempty ((Matrix.toLin' A).ker ≃ₗ[ℤ] ℤ) := by
  have hcomp : Matrix.toLin' (projMat m) = (Matrix.toLin' A) ∘ₗ (Matrix.toLin' P) := by
    rw [← hproj, Matrix.toLin'_mul]
  have hPQ' : (Matrix.toLin' P) ∘ₗ (Matrix.toLin' Q) = LinearMap.id := by
    rw [← Matrix.toLin'_mul, hPQ, Matrix.toLin'_one]
  have hQP' : (Matrix.toLin' Q) ∘ₗ (Matrix.toLin' P) = LinearMap.id := by
    rw [← Matrix.toLin'_mul, hQP, Matrix.toLin'_one]
  -- `Matrix.toLin' P` is an invertible linear map
  let e : (Fin (m + 1) → ℤ) ≃ₗ[ℤ] (Fin (m + 1) → ℤ) :=
    LinearEquiv.ofLinearMap (Matrix.toLin' P) (Matrix.toLin' Q) hPQ' hQP'
  have he : (e : (Fin (m + 1) → ℤ) →ₗ[ℤ] (Fin (m + 1) → ℤ)) = Matrix.toLin' P := rfl
  -- the kernel of `projMat m` is the pullback of the kernel of `A` along `e`
  have hker : (Matrix.toLin' (projMat m)).ker
      = Submodule.comap (e : (Fin (m + 1) → ℤ) →ₗ[ℤ] (Fin (m + 1) → ℤ))
          (Matrix.toLin' A).ker := by
    rw [hcomp, he, LinearMap.ker_comp]
  exact ⟨((LinearEquiv.ofEq _ _ hker).trans
    (KerNF.comapLinearEquiv e (Matrix.toLin' A).ker)).symm.trans (KerNF.projKernelEquiv m)⟩

end Work.HomologyMV
