import Mathlib
import Submission.Work.Subdivision.PieceQuot

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The subdivided piece is the local module

This file proves `sdPieceMapLin_bijective`: the linear map

`PolyCW.sdPieceMapLin P n E ha k : locMod P a k ⟶
  (sdTop P n (insert a E)).chain.X k ⧸ (sdPiece P n E a).sub k`

induced by the inclusion `leSub P a k ↪ sdTopMod P n (insert a E) k` is bijective,
for every cell `a` of dimension `n + 1` and every `a ∉ E`.

This is the module-theoretic content of the second isomorphism theorem in the
situation of `PieceEquiv.lean`: the refined filtration `sdTop P n (insert a E) k`
is the sum of `sdTop P n E k` and `leSub P a k`, and these meet in `ltSub P a k`
(`PolyCW.sdTopMod_insert`, `PolyCW.sdTopMod_inf_leSub`).  Consequently the map
identifies the quotient of `sdTop P n (insert a E) k` by `sdTopMod P n E k` with
`leSub P a k ⧸ ltSub P a k = locMod P a k`.

The general form of the statement used here — for a linear map `f : M →ₗ N`, a
pair of submodules `p ≤ q.comap f` with `q.comap f ≤ p` and `f.range ⊔ q = ⊤` —
is `sdPieceMapLinMapQ_bijective_aux` below; it says that `Submodule.mapQ`
is bijective exactly when the induced map is injective (`q.comap f = p`) and
surjective (`f.range ⊔ q = ⊤`).
-/

namespace Work.Subdivision

noncomputable section

/-- **`Submodule.mapQ` is bijective between the quotient by `p` and the quotient
by `q`** as soon as the relation `p ≤ q.comap f` (which is the hypothesis `h` of
`mapQ`) is an equality and the image of `f` together with `q` generates the
target (`f.range ⊔ q = ⊤`).

Injectivity is read off from `Submodule.ker_mapQ`, surjectivity from
`Submodule.range_mapQ`. -/
theorem sdPieceMapLinMapQ_bijective_aux {M N : Type*} [AddCommGroup M] [Module ℤ M]
    [AddCommGroup N] [Module ℤ N] (f : M →ₗ[ℤ] N) {p : Submodule ℤ M} {q : Submodule ℤ N}
    (h : p ≤ q.comap f) (hinj : q.comap f ≤ p) (hsup : f.range ⊔ q = ⊤) :
    Function.Bijective (p.mapQ q f h) := by
  refine ⟨?_, ?_⟩
  · rw [← LinearMap.ker_eq_bot, Submodule.ker_mapQ]
    have hbot : Submodule.map p.mkQ p = ⊥ := by
      rw [eq_bot_iff, Submodule.map_le_iff_le_comap, Submodule.comap_bot, Submodule.ker_mkQ]
    exact le_antisymm ((Submodule.map_mono hinj).trans hbot.le) bot_le
  · rw [← LinearMap.range_eq_top, Submodule.range_mapQ, Submodule.map_mkQ_eq_top, sup_comm]
    exact hsup

/-- The map `sdPieceMapLin P n E ha k`, from the local module of the new `(n+1)`-cell
`a` to the quotient of the refined subdivided filtration by the unrefined one, is
bijective. -/
theorem sdPieceMapLin_bijective (P : Work.Subdivision.PolyCW) (n : ℕ)
    (E : Finset P.Cell) {a : P.Cell} (ha : P.dim a = n + 1) (hE : a ∉ E) (k : ℕ) :
    Function.Bijective (Work.Subdivision.PolyCW.sdPieceMapLin P n E ha k) := by
  -- Injectivity: the preimage of `sdPiece.sub k` under the inclusion is `locRel`.
  have hinj : ((PolyCW.sdPiece P n E a).sub k).comap (PolyCW.sdInc P n E ha k) ≤
      PolyCW.locRel P a k := by
    intro x hx
    -- `x` is a chain supported below `a` whose image lies in the `n`-skeleton;
    -- hence it is supported strictly below `a`.
    have hxE : (x : Work.Subdivision.chainMod P.Cell k) ∈ PolyCW.sdTopMod P n E k := hx
    have hmem : (x : Work.Subdivision.chainMod P.Cell k) ∈
        PolyCW.sdTopMod P n E k ⊓ PolyCW.leSub P a k :=
      ⟨hxE, x.2⟩
    exact (le_of_eq (Work.Subdivision.sdTopMod_inf_leSub P n E ha hE k)) hmem
  -- Surjectivity: the refined filtration is generated by the `n`-skeleton and
  -- the part supported below `a`.
  have hsup : (PolyCW.sdInc P n E ha k).range ⊔ (PolyCW.sdPiece P n E a).sub k = ⊤ := by
    refine eq_top_iff.mpr fun w _ => ?_
    have hw : w.1 ∈ PolyCW.sdTopMod P n E k ⊔ PolyCW.leSub P a k :=
      (le_of_eq (Work.Subdivision.sdTopMod_insert P n E ha k)) w.2
    obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hw
    refine Submodule.mem_sup.mpr ⟨⟨v, PolyCW.leSub_le_sdTopMod_insert P ha E k hv⟩, ?_,
      ⟨u, PolyCW.sdTopMod_mono P n (Finset.subset_insert a E) k hu⟩, ?_, ?_⟩
    · exact LinearMap.mem_range.mpr ⟨⟨v, hv⟩, rfl⟩
    · exact hu
    · refine Subtype.ext ?_
      show v + u = w.1
      rw [add_comm]
      exact huv
  exact sdPieceMapLinMapQ_bijective_aux (PolyCW.sdInc P n E ha k)
    (PolyCW.leSub_le_sdTopMod_insert' P n E ha k) hinj hsup

end

end Work.Subdivision
