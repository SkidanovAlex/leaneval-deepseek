import Mathlib
import Submission.Work.Subdivision.Support
import Submission.Work.Subdivision.SubdivAssembly
import Submission.Work.Subdivision.D_subdivCell
import Submission.Work.Subdivision.SubDataQuasiIso

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The local complex of a cell

For a cell `e` of a `PolyCW`, the **local complex** `locCx P e` is the chain
complex of the "interior" of `e`: in degree `k` its chains are the `k`-simplices
of the order complex whose top vertex is exactly `e`, i.e.

`leSub e k` (chains with all vertices `≤ e`) modulo `ltSub e k` (chains with all
vertices `< e`).

The differential drops a non-top vertex (dropping the top vertex is zero in the
quotient).  The local condition of the subdivision — the blueprint's `hsph` — is

`LocallySpherical P hdd haug : ∀ e, QuasiIso (locMap P hdd haug e)`,

where `locMap P hdd haug e : unitCx (P.dim e) ⟶ locCx P e` sends the generator of
the one-dimensional complex concentrated in degree `dim e` to the class of
`subdivCell P (P.dim e) e`.  Equivalently: `H_j(locCx P e) = 0` for `j ≠ dim e`
and `H_{dim e}(locCx P e) ≅ ℤ` generated by `[subdivCell e]`.

The order complex of `Iio e` is `ltSub e`; since `leSub e` is the cone on it, the
above condition is the cone-shadow of "`H(∂L_e) ≅ H(S^{dim e - 1})` and
`∂_{L_e}(top)` generates", which is what the certificates per face-lattice type
supply.  The reduction from `LocallySpherical` to the quasi-isomorphism of the
subdivision is `PolyCW.subdiv_quasiIso_of_local` (`LocalMain.lean`).
-/

namespace Work.Subdivision

open CategoryTheory

universe u

noncomputable section

/-- The `ℤ`-module `ℤ`, in a chosen universe (a `ULift` of `ℤ`). -/
abbrev unitMod : ModuleCat ℤ := ModuleCat.of ℤ (ULift.{u} ℤ)

/-- The chain complex concentrated in degree `n`, where it is `ℤ`. -/
noncomputable abbrev unitCx (n : ℕ) : ChainComplex (ModuleCat ℤ) ℕ :=
  (HomologicalComplex.single (ModuleCat ℤ) (ComplexShape.down ℕ) n).obj (unitMod.{u})

namespace PolyCW

variable (P : PolyCW.{u})

/-! ### The differential preserves the local chains -/

/-- The differential of a `k`-simplex with all vertices `≤ e` is a sum of
`(k-1)`-simplices with all vertices `≤ e`. -/
theorem D_mem_leSub (e : P.Cell) (k : ℕ) :
    leSub P e (k + 1) ≤ Submodule.comap (D (α := P.Cell) k) (leSub P e k) := by
  rw [leSub, Submodule.span_le]
  rintro x ⟨σ, hσ, rfl⟩
  refine Submodule.mem_comap.mpr ?_
  rw [show Finsupp.single σ (1 : ℤ) = sdElem P σ from by simp [sdElem], D_sdElem]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ ?_
  exact sdElem_mem_leSub P fun j => hσ (i.succAbove j)

/-- The differential of a `k`-simplex with all vertices `< e` is a sum of
`(k-1)`-simplices with all vertices `< e`. -/
theorem D_mem_ltSub (e : P.Cell) (k : ℕ) :
    ltSub P e (k + 1) ≤ Submodule.comap (D (α := P.Cell) k) (ltSub P e k) := by
  rw [ltSub, Submodule.span_le]
  rintro x ⟨σ, hσ, rfl⟩
  refine Submodule.mem_comap.mpr ?_
  rw [show Finsupp.single σ (1 : ℤ) = sdElem P σ from by simp [sdElem], D_sdElem]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ ?_
  exact sdElem_mem_ltSub P fun j => hσ (i.succAbove j)

theorem ltSub_le_leSub (e : P.Cell) (k : ℕ) : ltSub P e k ≤ leSub P e k := by
  rw [ltSub, leSub, Submodule.span_le]
  rintro x ⟨σ, hσ, rfl⟩
  exact sdElem_mem_leSub P fun i => le_of_lt (hσ i)

/-! ### The subdivision chain of a cell lies in the local chains -/

/-- The subdivision chain of a cell of dimension `n` lies in the chains with all
vertices `≤ e`. -/
theorem subdivCell_mem_leSub (n : ℕ) (e : {e : P.Cell // P.dim e = n}) :
    subdivCell P n e ∈ leSub P e.1 n :=
  mem_leSub_of_support P fun σ hσ i => subdivCell_support P n e σ hσ i

/-- The subdivision chain of a cell `f` of dimension `n` lies in the chains with
all vertices `< e`, as soon as `f < e`. -/
theorem subdivCell_mem_ltSub_of_lt {e : P.Cell} {n : ℕ} (f : {f : P.Cell // P.dim f = n})
    (hf : f.1 < e) : subdivCell P n f ∈ ltSub P e n :=
  mem_ltSub_of_support P fun σ hσ i =>
    lt_of_le_of_lt (subdivCell_support P n f σ hσ i) hf

/-! ### The local complex -/

/-- The differential of the local chains, restricted from the ambient `D`. -/
noncomputable abbrev leSubD (e : P.Cell) (k : ℕ) :
    ↥(leSub P e (k + 1)) →ₗ[ℤ] ↥(leSub P e k) :=
  (D (α := P.Cell) k).restrict fun _ hx => D_mem_leSub P e k hx

theorem leSubD_apply (e : P.Cell) (k : ℕ) (x : ↥(leSub P e (k + 1))) :
    (Submodule.subtype (leSub P e k)) (leSubD P e k x) = D (α := P.Cell) k ↑x := rfl

theorem coe_leSubD_apply (e : P.Cell) (k : ℕ) (x : ↥(leSub P e (k + 1))) :
    ((leSubD P e k x : ↥(leSub P e k)) : chainMod P.Cell k) = D (α := P.Cell) k ↑x := rfl

/-- The submodule of `↥(leSub P e k)` of the chains with all vertices `< e`. -/
abbrev locRel (e : P.Cell) (k : ℕ) : Submodule ℤ ↥(leSub P e k) :=
  (ltSub P e k).comap (Submodule.subtype (leSub P e k))

/-- The `k`-chains of the local complex of `e`: the `k`-simplices of the order
complex with top vertex `e`, i.e. `leSub e k ⧸ ltSub e k`. -/
abbrev locMod (e : P.Cell) (k : ℕ) : Type u := ↥(leSub P e k) ⧸ locRel P e k

/-- The differential of the local complex: drop a non-top vertex; dropping the
top vertex lands in `ltSub`, hence is zero in the quotient. -/
noncomputable abbrev locD (e : P.Cell) (k : ℕ) :
    locMod P e (k + 1) →ₗ[ℤ] locMod P e k :=
  Submodule.mapQ (locRel P e (k + 1)) (locRel P e k) (leSubD P e k) fun x hx => by
    have hx' : (↑x : chainMod P.Cell (k + 1)) ∈ ltSub P e (k + 1) := by
      rw [locRel] at hx
      exact hx
    show (Submodule.subtype (leSub P e k)) (leSubD P e k x) ∈ ltSub P e k
    rw [leSubD_apply]
    exact D_mem_ltSub P e k hx'

theorem locD_mk (e : P.Cell) (k : ℕ) (x : ↥(leSub P e (k + 1))) :
    locD P e k (Submodule.Quotient.mk x) = Submodule.Quotient.mk (leSubD P e k x) :=
  Submodule.mapQ_apply _ _ _ _

theorem locD_comp (e : P.Cell) (k : ℕ) : (locD P e k).comp (locD P e (k + 1)) = 0 := by
  refine LinearMap.ext fun x => ?_
  induction x using Submodule.Quotient.induction_on with
  | _ y =>
      rw [LinearMap.comp_apply, LinearMap.zero_apply, locD_mk P e (k + 1) y,
        locD_mk P e k (leSubD P e (k + 1) y)]
      refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
      show (Submodule.subtype (leSub P e k)) (leSubD P e k (leSubD P e (k + 1) y)) ∈ ltSub P e k
      rw [show (Submodule.subtype (leSub P e k)) (leSubD P e k (leSubD P e (k + 1) y))
            = D (α := P.Cell) k (D (α := P.Cell) (k + 1) (↑y : chainMod P.Cell (k + 2))) from by
        rw [leSubD_apply]
        exact congrArg (D (α := P.Cell) k) (leSubD_apply P e (k + 1) y)]
      rw [show D (α := P.Cell) k (D (α := P.Cell) (k + 1) (↑y : chainMod P.Cell (k + 2)))
            = ((D (α := P.Cell) k).comp (D (α := P.Cell) (k + 1))) ↑y from rfl,
        show ((D (α := P.Cell) k).comp (D (α := P.Cell) (k + 1))) ↑y = 0
          from LinearMap.congr_fun (orderD_comp (α := P.Cell) k) ↑y]
      exact Submodule.zero_mem _

/-- **The local complex of a cell.**  Its `k`-chains are the `k`-simplices of the
order complex whose top vertex is `e`, modulo the ones below `e`: it is
`leSub e k ⧸ ltSub e k`. -/
noncomputable abbrev locCx (e : P.Cell) : ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.of (fun k => ModuleCat.of ℤ (locMod P e k))
    (fun k => ModuleCat.ofHom (locD P e k))
    (fun k => ModuleCat.hom_ext (by
      rw [ModuleCat.hom_comp, ModuleCat.hom_ofHom, ModuleCat.hom_zero]
      exact locD_comp P e k))

@[simp] theorem locCx_X (e : P.Cell) (k : ℕ) :
    (locCx P e).X k = ModuleCat.of ℤ (locMod P e k) := rfl

@[simp] theorem locCx_d (e : P.Cell) (k : ℕ) :
    (locCx P e).d (k + 1) k = ModuleCat.ofHom (locD P e k) := by
  simp only [locCx, ChainComplex.of_d]

/-- The class of the subdivision chain of `e` in its local complex; this is the
candidate generator of the top homology of the local complex. -/
def locClsAux (n : ℕ) (e : {e : P.Cell // P.dim e = n}) : (locCx P e.1).X n :=
  Submodule.Quotient.mk (⟨subdivCell P n e, subdivCell_mem_leSub P n e⟩ : ↥(leSub P e.1 n))

@[simp] theorem locClsAux_eq (n : ℕ) (e : {e : P.Cell // P.dim e = n}) :
    locClsAux P n e = Submodule.Quotient.mk
      (⟨subdivCell P n e, subdivCell_mem_leSub P n e⟩ : ↥(leSub P e.1 n)) := rfl

/-- **The key cycle condition**: the boundary of the subdivision chain of `e`,
computed by the cone recursion `D_subdivCell`, is a sum of subdivision chains of
proper faces of `e`, all of which lie in `ltSub e`, so the class of `subdivCell e`
in the local complex is a cycle. -/
theorem locClsAux_cycle (hdd : P.HasDdZero) (haug : P.HasAugZero) (n : ℕ)
    (e : {e : P.Cell // P.dim e = n + 1}) :
    (locCx P e.1).d (n + 1) n (locClsAux P (n + 1) e) = 0 := by
  rw [locCx_d]
  show locD P e.1 n (locClsAux P (n + 1) e) = 0
  rw [locClsAux_eq, locD_mk]
  refine (Submodule.Quotient.mk_eq_zero _).mpr ?_
  show (Submodule.subtype (leSub P e.1 n))
      (leSubD P e.1 n (⟨subdivCell P (n + 1) e, subdivCell_mem_leSub P (n + 1) e⟩ :
        ↥(leSub P e.1 (n + 1)))) ∈ ltSub P e.1 n
  rw [show (Submodule.subtype (leSub P e.1 n))
        (leSubD P e.1 n (⟨subdivCell P (n + 1) e, subdivCell_mem_leSub P (n + 1) e⟩ :
          ↥(leSub P e.1 (n + 1))))
        = D (α := P.Cell) n (subdivCell P (n + 1) e)
      from leSubD_apply P e.1 n _]
  rw [D_subdivCell P hdd haug n e]
  refine Submodule.sum_mem _ fun f _ => Submodule.smul_mem _ _ ?_
  refine subdivCell_mem_ltSub_of_lt P ⟨f.1, ?_⟩ ((P.mem_facets e.1 f.1).1 f.2).1

/-! ### The local map and the local condition -/

/-- The generator map `ℤ → M`, `1 ↦ x`, with source in the chosen universe. -/
noncomputable abbrev spanMap {M : ModuleCat ℤ} (x : M) : unitMod ⟶ M :=
  ModuleCat.ofHom
    ((LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) x).comp
      (ULift.moduleEquiv (M := ℤ)).toLinearMap)

/-- **The local map of a cell**: the generator of the complex concentrated in
degree `dim e` is mapped to the class of the subdivision chain of `e` in the
local complex. -/
noncomputable def locMapAux (hdd : P.HasDdZero) (haug : P.HasAugZero) (n : ℕ)
    (e : {e : P.Cell // P.dim e = n}) : unitCx n ⟶ locCx P e.1 :=
  HomologicalComplex.mkHomFromSingle (K := locCx P e.1) (j := n)
    (spanMap (locClsAux P n e))
    fun k hk => by
      have hk' : n = k + 1 := hk.symm
      subst hk'
      apply ModuleCat.hom_ext
      refine LinearMap.ext fun z => ?_
      rw [ModuleCat.hom_comp, ModuleCat.hom_zero, LinearMap.comp_apply, LinearMap.zero_apply,
        ModuleCat.hom_ofHom, LinearMap.comp_apply, LinearMap.toSpanSingleton,
        LinearMap.smulRight_apply, LinearMap.id_apply, map_smul,
        locClsAux_cycle P hdd haug k e, smul_zero]

/-- The local map of a cell. -/
noncomputable def locMap (hdd : P.HasDdZero) (haug : P.HasAugZero) (e : P.Cell) :
    unitCx (P.dim e) ⟶ locCx P e :=
  locMapAux P hdd haug (P.dim e) ⟨e, rfl⟩

/-- **The local (sphere/generator) condition**: for every cell `e` the
subdivision chain of `e` generates the top homology of the local complex `Q_e`
and all other homology of `Q_e` vanishes.  This is the hypothesis of
`PolyCW.subdiv_quasiIso_of_local`; the certificates per face-lattice type supply
it from `H(∂L_e) ≅ H(S^{dim e - 1})` and the generator condition. -/
abbrev LocallySpherical (hdd : P.HasDdZero) (haug : P.HasAugZero) : Prop :=
  ∀ e : P.Cell, QuasiIso (locMap P hdd haug e)

/-- The dimension-indexed form of `LocallySpherical`, for the cells of a fixed
dimension. -/
theorem locMapAux_quasiIso (hdd : P.HasDdZero) (haug : P.HasAugZero)
    (h : LocallySpherical P hdd haug) (n : ℕ) (e : {e : P.Cell // P.dim e = n}) :
    QuasiIso (locMapAux P hdd haug n e) := by
  obtain ⟨a, ha⟩ := e
  cases ha
  exact h a

end PolyCW

end

end Work.Subdivision
