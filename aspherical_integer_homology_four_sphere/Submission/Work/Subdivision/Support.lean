import Mathlib
import Submission.Work.Subdivision.Filtration

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# Chains supported in a set of simplices

The chain modules of the order complex are free on the simplices, so a submodule
generated by a set of *simplices* (each contributing its basis vector) is exactly
the submodule of chains whose support is contained in that set.  This file proves
that in the general form

`Work.Subdivision.Finsupp.mem_span_single_one_iff`:
`x ∈ span {single b 1 | b ∈ B} ↔ ↑x.support ⊆ B`,

and then specialises it to the submodules of a subdivided `PolyCW` used in the
local study of a cell `e`:

* `PolyCW.leSub e k` — simplices all of whose vertices are `≤ e`
  (`PolyCW.leSub_support`, `PolyCW.mem_leSub_of_support`),
* `PolyCW.ltSub e k` — simplices all of whose vertices are `< e`
  (`PolyCW.ltSub_support`, `PolyCW.mem_ltSub_of_support`),
* `PolyCW.sdSubMod n k` — simplices all of whose vertices have dimension `≤ n`
  (`PolyCW.sdSubMod_support`, `PolyCW.mem_sdSubMod_of_support`).

The consequence used everywhere below is that these submodules are *coordinate
submodules*: they are the spans of subsets of a basis, hence membership is
detected on the support of the `Finsupp`.
-/

namespace Work.Subdivision

universe u

/-- A chain lies in the span of the basis vectors `single b 1` with `b ∈ B` exactly
when its support is contained in `B`. -/
theorem Finsupp.mem_span_single_one_iff {ι R : Type*} [Ring R] [DecidableEq ι]
    {B : Set ι} {x : ι →₀ R} :
    x ∈ Submodule.span R {y : ι →₀ R | ∃ b ∈ B, y = Finsupp.single b 1} ↔ ↑x.support ⊆ B := by
  constructor
  · intro hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨b, hb, rfl⟩ := hy
        intro c hc
        have hc' : c = b := by
          have h := Finsupp.support_single_subset (a := b) (b := (1 : R)) hc
          simpa using h
        rw [hc']
        exact hb
    | zero => intro c hc; simp at hc
    | add y z _ _ ihy ihz =>
        intro c hc
        rcases Finset.mem_union.mp (Finsupp.support_add hc) with h | h
        exacts [ihy h, ihz h]
    | smul a y _ ihy => intro c hc; exact ihy (Finsupp.support_smul hc)
  · intro hx
    rw [← Finsupp.sum_single x]
    refine Submodule.sum_mem _ fun b hb => ?_
    have : Finsupp.single b (x b) = x b • Finsupp.single b (1 : R) := by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [this]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, hx hb, rfl⟩)

namespace PolyCW

variable (P : PolyCW)

noncomputable section

/-! ### The local chains of a cell -/

/-- The chains of the order complex of `Iic e`: `k`-simplices all of whose
vertices are faces of `e`. -/
def leSub (e : P.Cell) (k : ℕ) : Submodule ℤ (chainMod P.Cell k) :=
  Submodule.span ℤ {y : chainMod P.Cell k |
    ∃ σ : Simplex P.Cell k, (∀ i, σ i ≤ e) ∧ y = Finsupp.single σ 1}

/-- The chains of the order complex of `Iio e`: `k`-simplices all of whose
vertices are proper faces of `e`. -/
def ltSub (e : P.Cell) (k : ℕ) : Submodule ℤ (chainMod P.Cell k) :=
  Submodule.span ℤ {y : chainMod P.Cell k |
    ∃ σ : Simplex P.Cell k, (∀ i, σ i < e) ∧ y = Finsupp.single σ 1}

theorem leSub_support {e : P.Cell} {k : ℕ} {x : chainMod P.Cell k} (hx : x ∈ leSub P e k) :
    ∀ σ ∈ x.support, ∀ i, σ i ≤ e := by
  rw [leSub] at hx
  exact fun σ hσ i =>
    (Finsupp.mem_span_single_one_iff (R := ℤ) (B := {σ : Simplex P.Cell k | ∀ i, σ i ≤ e})).1 hx hσ i

theorem mem_leSub_of_support {e : P.Cell} {k : ℕ} {x : chainMod P.Cell k}
    (h : ∀ σ ∈ x.support, ∀ i, σ i ≤ e) : x ∈ leSub P e k := by
  rw [leSub]
  exact (Finsupp.mem_span_single_one_iff (R := ℤ)
    (B := {σ : Simplex P.Cell k | ∀ i, σ i ≤ e})).2 fun σ hσ => h σ hσ

theorem ltSub_support {e : P.Cell} {k : ℕ} {x : chainMod P.Cell k} (hx : x ∈ ltSub P e k) :
    ∀ σ ∈ x.support, ∀ i, σ i < e := by
  rw [ltSub] at hx
  exact fun σ hσ i =>
    (Finsupp.mem_span_single_one_iff (R := ℤ) (B := {σ : Simplex P.Cell k | ∀ i, σ i < e})).1 hx hσ i

theorem mem_ltSub_of_support {e : P.Cell} {k : ℕ} {x : chainMod P.Cell k}
    (h : ∀ σ ∈ x.support, ∀ i, σ i < e) : x ∈ ltSub P e k := by
  rw [ltSub]
  exact (Finsupp.mem_span_single_one_iff (R := ℤ)
    (B := {σ : Simplex P.Cell k | ∀ i, σ i < e})).2 fun σ hσ => h σ hσ

theorem sdElem_mem_leSub {e : P.Cell} {k : ℕ} {σ : Simplex P.Cell k}
    (h : ∀ i, σ i ≤ e) : sdElem P σ ∈ leSub P e k := by
  rw [leSub]
  exact Submodule.subset_span ⟨σ, h, by simp [sdElem]⟩

theorem sdElem_mem_ltSub {e : P.Cell} {k : ℕ} {σ : Simplex P.Cell k}
    (h : ∀ i, σ i < e) : sdElem P σ ∈ ltSub P e k := by
  rw [ltSub]
  exact Submodule.subset_span ⟨σ, h, by simp [sdElem]⟩

/-! ### The `n`-skeleton as a coordinate submodule -/

theorem sdSubMod_support {n k : ℕ} {x : (sdChain P).X k} (hx : x ∈ sdSubMod P n k) :
    ∀ σ ∈ x.support, ∀ i, P.dim (σ i) ≤ n := by
  have hset : {y : (sdChain P).X k | ∃ σ : Simplex P.Cell k, (∀ i, P.dim (σ i) ≤ n) ∧ y = sdElem P σ}
      = {y : (sdChain P).X k |
          ∃ b ∈ {σ : Simplex P.Cell k | ∀ i, P.dim (σ i) ≤ n}, y = Finsupp.single b 1} := by
    ext y
    constructor <;> rintro ⟨σ, hσ, rfl⟩ <;> exact ⟨σ, hσ, by simp [sdElem]⟩
  rw [sdSubMod, hset] at hx
  exact fun σ hσ i =>
    (Finsupp.mem_span_single_one_iff (R := ℤ) (B := {σ : Simplex P.Cell k | ∀ i, P.dim (σ i) ≤ n})).1
      hx hσ i

theorem mem_sdSubMod_of_support {n k : ℕ} {x : (sdChain P).X k}
    (h : ∀ σ ∈ x.support, ∀ i, P.dim (σ i) ≤ n) : x ∈ sdSubMod P n k := by
  have hset : {y : (sdChain P).X k | ∃ σ : Simplex P.Cell k, (∀ i, P.dim (σ i) ≤ n) ∧ y = sdElem P σ}
      = {y : (sdChain P).X k |
          ∃ b ∈ {σ : Simplex P.Cell k | ∀ i, P.dim (σ i) ≤ n}, y = Finsupp.single b 1} := by
    ext y
    constructor <;> rintro ⟨σ, hσ, rfl⟩ <;> exact ⟨σ, hσ, by simp [sdElem]⟩
  rw [sdSubMod, hset]
  exact (Finsupp.mem_span_single_one_iff (R := ℤ)
    (B := {σ : Simplex P.Cell k | ∀ i, P.dim (σ i) ≤ n})).2 fun σ hσ => h σ hσ

end

end PolyCW

end Work.Subdivision
