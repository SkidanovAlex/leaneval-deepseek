import Mathlib
import Submission.Work.Subdivision.Level
import Submission.Work.Subdivision.ComapChain

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The pieces of a skeletal level, cell by cell

Refining the two filtrations `cellTop P hdd n E` and `sdTop P n E` (`Level.lean`)
by a single new `(n+1)`-cell `a` gives the two **pieces** of the level carried by
that cell:

* `cellPiece P hdd n E a` — the relative subcomplex of `cellTop (insert a E)` over
  `cellTop E`; its only non-zero chain module is the one generated by the new
  cell,
* `sdPiece P n E a` — the relative subcomplex of `sdTop (insert a E)` over
  `sdTop E`; its chains are the simplices whose top vertex is exactly `a`.

The maps induced by the subdivision on these pieces are the local maps of the
cell: the piece quotients are canonically `unitCx (dim a)` and the local complex
`locCx P a` (`sdPieceEquiv`, `cellPieceEquiv`), and the induced map is `locMap P a`
up to these identifications.  Feeding this into the five lemma cell by cell
(`PieceInduction.lean`) yields the quasi-isomorphism of the subdivision from the
per-cell condition `LocallySpherical`.
-/

namespace Work.Subdivision

open CategoryTheory

universe u

noncomputable section

namespace PolyCW

variable (P : PolyCW.{u})

/-- The relative subcomplex of the refined cellular filtration carried by the new
cell `a`. -/
noncomputable abbrev cellPiece (hdd : P.HasDdZero) (n : ℕ) (E : Finset P.Cell) (a : P.Cell) :
    SubData ((cellTop P hdd n (insert a E)).chain) where
  sub k := Submodule.comap (Submodule.subtype ((cellTop P hdd n (insert a E)).sub k))
    (cellTopMod P hdd n E k)
  d_mem k x hx := by
    refine Submodule.mem_comap.mpr ?_
    rw [SubData.chain_d_eq, SubData.dLcpt_apply]
    exact cellTopMod_d_mem P hdd n E k (Submodule.mem_comap.mp hx)

/-- The relative subcomplex of the refined subdivided filtration carried by the
new cell `a`. -/
noncomputable abbrev sdPiece (n : ℕ) (E : Finset P.Cell) (a : P.Cell) :
    SubData ((sdTop P n (insert a E)).chain) where
  sub k := Submodule.comap (Submodule.subtype ((sdTop P n (insert a E)).sub k))
    (sdTopMod P n E k)
  d_mem k x hx := by
    refine Submodule.mem_comap.mpr ?_
    rw [SubData.chain_d_eq, SubData.dLcpt_apply]
    exact sdTopMod_d_mem P n E k (Submodule.mem_comap.mp hx)

end PolyCW

end

end Work.Subdivision
