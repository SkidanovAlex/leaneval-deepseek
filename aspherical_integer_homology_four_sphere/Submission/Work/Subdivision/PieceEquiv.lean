import Mathlib
import Submission.Work.Subdivision.Piece

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The pieces of a level are the local complexes of the new cell

The successive quotients of the refined filtration (`Piece.lean`) are computed
here, degree by degree, using the second isomorphism theorem
(`LinearMap.quotientInfEquivSupQuotient`): the quotient of

* `sdTop P n (insert a E)` by `sdTop P n E` is the local module
  `locMod P a k = leSub a k ⧸ ltSub a k` (`PolyCW.sdPieceEquiv`), and
* `cellTop P hdd n (insert a E)` by `cellTop P hdd n E` is `ℤ`
  (`PolyCW.cellPieceEquiv`).

Both identifications are the degreewise form of the decomposition of the `n`-th
graded piece of the subdivision as the direct sum of the local complexes of the
`(n+1)`-cells.
-/

namespace Work.Subdivision

open CategoryTheory

universe u

set_option maxHeartbeats 4000000

noncomputable section

namespace PolyCW

variable (P : PolyCW.{u})

/-- The two orders of the intersection of `leSub` and `sdTopMod` agree (the two
submodules live in definitionally equal modules, so `inf_comm` does not apply
directly). -/
theorem leSub_inf_sdTopMod_comm (n : ℕ) (E : Finset P.Cell) (a : P.Cell) (k : ℕ) :
    leSub P a k ⊓ sdTopMod P n E k = sdTopMod P n E k ⊓ leSub P a k := by
  refine le_antisymm ?_ ?_ <;> intro x hx <;> exact ⟨hx.2, hx.1⟩

/-- **The subdivided piece is the local module.**  The second isomorphism theorem
identifies the quotient of `sdTop P n (insert a E)` by `sdTop P n E` with
`leSub P a k ⧸ (leSub P a k ⊓ sdTop P n E) = leSub P a k ⧸ ltSub P a k`. -/
noncomputable def sdPieceEquiv (n : ℕ) (E : Finset P.Cell) {a : P.Cell} (k : ℕ)
    (hinf : leSub P a k ⊓ sdTopMod P n E k = ltSub P a k) :
    (↥(leSub P a k ⊔ sdTopMod P n E k) ⧸
        (sdTopMod P n E k).comap (Submodule.subtype (leSub P a k ⊔ sdTopMod P n E k)))
      ≃ₗ[ℤ] locMod P a k :=
  (LinearMap.quotientInfEquivSupQuotient (leSub P a k) (sdTopMod P n E k)).symm.trans
    (Submodule.quotEquivOfEq
      (p := (leSub P a k).comap (Submodule.subtype (leSub P a k)) ⊓
        (sdTopMod P n E k).comap (Submodule.subtype (leSub P a k)))
      (p' := (ltSub P a k).comap (Submodule.subtype (leSub P a k)))
      (by
        have h1 : (leSub P a k).comap (Submodule.subtype (leSub P a k)) ⊓
            (sdTopMod P n E k).comap (Submodule.subtype (leSub P a k))
            = ((leSub P a k) ⊓ sdTopMod P n E k).comap (Submodule.subtype (leSub P a k)) := by
          refine le_antisymm ?_ ?_ <;> intro x hx <;> exact ⟨hx.1, hx.2⟩
        rw [h1, hinf]))

/-- The same identification, in the form in which the piece of the filtration
appears: the quotient of `sdTop P n (insert a E)` by `sdTop P n E`. -/
noncomputable def sdPieceEquiv' (n : ℕ) (E : Finset P.Cell) {a : P.Cell} (k : ℕ)
    (hsup : sdTopMod P n (insert a E) k = sdTopMod P n E k ⊔ leSub P a k)
    (hinf : leSub P a k ⊓ sdTopMod P n E k = ltSub P a k) :
    (↥(sdTopMod P n (insert a E) k) ⧸
        (sdTopMod P n E k).comap (Submodule.subtype (sdTopMod P n (insert a E) k)))
      ≃ₗ[ℤ] locMod P a k :=
  (show sdTopMod P n (insert a E) k = leSub P a k ⊔ sdTopMod P n E k from by
    rw [hsup]; exact sup_comm _ _) ▸
    sdPieceEquiv P n E k hinf

/-- The module generated by a single `(n+1)`-cell `a` inside the `(n+1)`-chains. -/
abbrev cellGenMod (hdd : P.HasDdZero) (n : ℕ) {a : P.Cell} (ha : P.dim a = n + 1) : Type u :=
  ↥(Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))

/-- **The cellular piece is the span of the new cell.**  The quotient of
`cellTop P hdd n (insert a E)` by `cellTop P hdd n E` is generated by the new cell
`a` alone, i.e. it is the span of that single basis vector of the free module on
the `(n+1)`-cells. -/
noncomputable def cellPieceEquiv (hdd : P.HasDdZero) (n : ℕ) (E : Finset P.Cell) {a : P.Cell}
    (ha : P.dim a = n + 1)
    (hinf : cellTopMod P hdd n E (n + 1) ⊓
      Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))) = ⊥) :
    (↥(Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))) ⊔
          cellTopMod P hdd n E (n + 1)) ⧸
        (cellTopMod P hdd n E (n + 1)).comap
          (Submodule.subtype (Submodule.span ℤ
            ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))) ⊔
              cellTopMod P hdd n E (n + 1))))
      ≃ₗ[ℤ] (↥(Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} :
          Set ((cellChain P hdd).X (n + 1)))) ⧸ (⊥ : Submodule ℤ ↥(Submodule.span ℤ
          ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1)))))) :=
  LinearEquiv.trans
    ((LinearMap.quotientInfEquivSupQuotient
      (Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))
      (cellTopMod P hdd n E (n + 1))).symm)
    (Submodule.quotEquivOfEq
      (p := (Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} :
          Set ((cellChain P hdd).X (n + 1)))).comap (Submodule.subtype (Submodule.span ℤ
          ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))) ⊓
        (cellTopMod P hdd n E (n + 1)).comap (Submodule.subtype (Submodule.span ℤ
          ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))))
      (p' := (⊥ : Submodule ℤ (Submodule.span ℤ
        ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))))
      (by
        have h1 : (Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} :
              Set ((cellChain P hdd).X (n + 1)))).comap
              (Submodule.subtype (Submodule.span ℤ
                ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))) ⊓
            (cellTopMod P hdd n E (n + 1)).comap (Submodule.subtype (Submodule.span ℤ
              ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1)))))
            = ((Submodule.span ℤ ({cellElem P hdd (n + 1) ⟨a, ha⟩} :
                Set ((cellChain P hdd).X (n + 1)))) ⊓ cellTopMod P hdd n E (n + 1)).comap
              (Submodule.subtype (Submodule.span ℤ
                ({cellElem P hdd (n + 1) ⟨a, ha⟩} : Set ((cellChain P hdd).X (n + 1))))) := by
          refine le_antisymm ?_ ?_ <;> intro x hx <;> exact ⟨hx.1, hx.2⟩
        rw [h1, inf_comm, hinf, Submodule.comap_bot, Submodule.ker_subtype]))

end PolyCW

end

end Work.Subdivision
