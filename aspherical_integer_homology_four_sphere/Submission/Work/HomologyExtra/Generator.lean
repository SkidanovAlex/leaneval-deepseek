-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The identity simplex generates `Hₙ(Δⁿ, ∂Δⁿ)` (dimensions `n ≥ 2`)

The main theorem of the chapter is that the class of the identity singular simplex
`ιₙ : Δⁿ → Δⁿ` generates `Hₙ(Δⁿ,∂Δⁿ)`, i.e. that the map

`simplexGenMap n : ℤ ⟶ Hₙ(Δⁿ,∂Δⁿ)`, `1 ↦ [ιₙ]`

is an isomorphism.  Together with `Work.HomologyExtra.relHomology_simplexPair` (which says
`H_k(Δⁿ,∂Δⁿ) = 0` for `k ≠ n`) this is the statement that `H_*(Δⁿ,∂Δⁿ)` is `ℤ` concentrated in
degree `n`, with `[ιₙ]` as an explicit generator — the input of the `Δ`-complex comparison in
`Submission/Work/DeltaHomology/`.

This file proves the cases `n ≥ 2`.  The remaining cases `n = 0, 1` are dealt with in
`Submission/Work/HomologyExtra/GeneratorOne.lean`; the unconditional statement is
`Work.HomologyExtra.isIso_simplexGenMap` in `Submission/Work/HomologyExtra/Main.lean`.

## The proof for `n ≥ 2`

Writing `n = k + 2`:

* `simplexGenMap_pairdelta (k+1)` — **tracking the identity simplex through the connecting map**:
  `simplexGenMap (k+2) ≫ pairδ = simplexBoundaryClass (k+1)`;
* the connecting map `pairδ` of the pair `(Δ^{k+2}, ∂Δ^{k+2})` in degree `k + 1` is an isomorphism
  because the outer terms of the pair sequence vanish (the simplex is contractible):
  `isIso_pairdelta_succ_succ k`;
* `epi_simplexBoundaryClass (k+1) (by omega)` — the fundamental cycle of the sphere
  `∂Δ^{k+2}` generates `H_{k+1}(∂Δ^{k+2}; ℤ)` (proved by the Mayer–Vietoris induction in
  `Submission/Work/HomologyExtra/epi_simplexBoundaryClass.lean`).

Hence `simplexGenMap (k+2)` is an epimorphism
(`epi_simplexGenMap_of_epi_simplexBoundaryClass`), and since `Hₙ(Δⁿ,∂Δⁿ) ≅ ℤ` is generated by one
element (`relHomology_simplexPair_top`), it is an isomorphism (`isIso_simplexGenMap_of_epi`).

The two excluded dimensions are genuinely different: in degree `0` the boundary `∂Δ⁰` is empty, so
the connecting map route has no content; in degree `1` the connecting map
`H₁(Δ¹,∂Δ¹) → H₀(∂Δ¹)` is injective but not surjective (its cokernel is `H₀(Δ¹) = ℤ`), so the
argument above — which needs `H_{k+1}(Δ^{k+2}) = 0` — does not apply.
-/

set_option backward.isDefEq.respectTransparency false

open CategoryTheory AlgebraicTopology CategoryTheory.Limits

namespace Work.HomologyExtra

noncomputable section

/-- **The identity simplex generates `Hₙ(Δⁿ,∂Δⁿ)` for every `n ≥ 2`**: the map `1 ↦ [ιₙ]` is an
epimorphism. -/
theorem epi_simplexGenMap_of_two_le (n : ℕ) (hn : 2 ≤ n) : Epi (simplexGenMap n) := by
  obtain ⟨k, rfl⟩ : ∃ k, n = k + 2 := ⟨n - 2, by omega⟩
  exact epi_simplexGenMap_of_epi_simplexBoundaryClass k
    (epi_simplexBoundaryClass (k + 1) (by omega))

/-- **The class of the identity singular simplex is a generator of `Hₙ(Δⁿ,∂Δⁿ)`**, `n ≥ 2`: the map
`ℤ → Hₙ(Δⁿ,∂Δⁿ)`, `1 ↦ [ιₙ]` is an isomorphism. -/
theorem isIso_simplexGenMap_of_two_le (n : ℕ) (hn : 2 ≤ n) : IsIso (simplexGenMap n) :=
  isIso_simplexGenMap_of_epi n (epi_simplexGenMap_of_two_le n hn)
    (relHomology_simplexPair_top n (by omega))

end

end Work.HomologyExtra
