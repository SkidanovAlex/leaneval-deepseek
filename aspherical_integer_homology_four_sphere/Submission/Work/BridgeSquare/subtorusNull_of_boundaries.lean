/-
# `BridgeSquare/subtorusNull_of_boundaries.lean` — from the three chain-level boundary
statements to the vanishing `H_k(s_v) = 0` (`k = 1, 2`)

`Work.BridgeSquare.SubtorusBoundaries` says that the three singular chains of `M̄` obtained by
pushing the `Δ`-generators of `H_1(T²)` (the loops `a`, `b`) and of `H_2(T²)` (the `2`-cycle
`T₀ - T₁`) along the subtorus map `F_v : T²_v → M̄` are *boundaries*.  This file proves that this
implies `Work.BridgeSquare.SubtorusNull`, i.e. `H_k(F_v) = 0` for `k = 1, 2`.

The mathematical content is that `H_1(T²)` is generated by `[a]`, `[b]` and `H_2(T²)` by
`[T₀ - T₁]`.  In the `Δ`-complex `torus2DeltaCx` of `T²` there is one vertex, three edges `a, b, c`
and two triangles `T₀, T₁`, with `∂T₀ = ∂T₁ = a + b - c`; hence `∂₁ = 0` — every `1`-chain is a
cycle — and `H_1` is generated by `[a]`, `[b]` because `e₀ + e₁ - e₂ = ∂T₀` is a boundary.

Everything is carried out in the *matrix model* `ℤ --0--> ℤ³ --!![1,1;1,1;-1,-1]--> ℤ²` of the
torus, which is chain-isomorphic to `torus2DeltaCx.chain` through the coproduct-to-product
identification `torus2ChainIsoAlt`.  The generation statements are packaged in the general vanishing
lemma `Work.BridgeSquare.SNAux.homologyMap_eq_zero_of_factors`: the cycles of the source, composed
with a chain map, factor through the differential of the target if and only if the induced map on
`H_i` vanishes.

The auxiliary vocabulary and lemmas live in the local namespace `Work.BridgeSquare.SNAux` of this
file, so that the file is self-contained and its names do not collide with those of
`BridgeSquare/SubtorusData.lean`.

## Note on the spelling of the hypothesis

The delegated statement asked for the hypothesis to be written
`Work.BridgeSquare.SubtorusBoundaries (rt := Work.RTOwed.rtData)`.  That spelling does not
elaborate: `Work.BridgeSquare.SubtorusBoundaries` (`BridgeSquare/CuspSection.lean`) is a `Prop` with
**no** datum argument — its section's `variable [rt : Work.Space.RTData]` does not occur in its
type or value, because `singA`/`singB`/`singT` are stated at the concrete datum
`Work.RTOwed.rtData` (Lean: ``Invalid argument name `rt` for function `SubtorusBoundaries` ``).
The datum argument is therefore vacuous, and the statement proved here is the intended one:

  `Work.BridgeSquare.SubtorusBoundaries → Work.BridgeSquare.SubtorusNull (rt := Work.RTOwed.rtData)`.

If the interface is meant to carry the datum, the owner of `CuspSection.lean` can parameterise
`singA`/`singB`/`singT` by the section variable `rt` (their values genuinely use it); then
`SubtorusBoundaries` obtains the argument and the requested spelling becomes literal.
-/
import Mathlib
import Submission.Work.BridgeSquare.CuspSection
import Submission.Work.PieceHomology.Torus2
import Submission.Work.PieceHomology.Torus2Chi
import Submission.Work.PieceHomology.torus2Data
import Submission.Work.PieceHomology.exists_torus2DeltaCx
import Submission.Work.PieceHomology.torus2Realization

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option autoImplicit false
set_option maxHeartbeats 2000000
set_option linter.unusedVariables false

open CategoryTheory CategoryTheory.Limits HomologicalComplex
open LeanEval.Topology

namespace Work.BridgeSquare

namespace SNAux

noncomputable section

/-! ## §0  The vocabulary

`SCh X k` is the singular chain module of `X` in degree `k`, in the `singChain`/`singCxFun`
spelling in which the comparison lemmas of `Work.DeltaHomology` apply syntactically. -/

/-- The singular chain complex of `X` over `ℤ`, in the `singChain` spelling. -/
abbrev Sing (X : TopCat) : ChainComplex (ModuleCat ℤ) ℕ :=
  Work.Homology.singChain Work.Homology.ZMod X

/-- The singular `k`-chains of `X`. -/
abbrev SCh (X : TopCat) (k : ℕ) : ModuleCat ℤ := (Sing X).X k

/-- The singular chain complex of the two-torus. -/
abbrev Ltor : ChainComplex (ModuleCat ℤ) ℕ := Sing Work.PieceHomology.Torus2Space

/-- The singular chain complex of `M̄`. -/
abbrev Lmbar : ChainComplex (ModuleCat ℤ) ℕ := Sing (TopCat.of Work.FoldInst.Mbar)

/-- The singular `k`-chains of the two-torus. -/
abbrev SChT (k : ℕ) : ModuleCat ℤ := Ltor.X k

/-- The singular `k`-chains of `M̄`. -/
abbrev SChM (k : ℕ) : ModuleCat ℤ := Lmbar.X k

/-- The `k`-chains of the `Δ`-chain complex of the torus, in the coproduct spelling. -/
abbrev Tor2KX (k : ℕ) : ModuleCat ℤ :=
  ∐ (fun _ : Fin (Work.PieceHomology.torus2Card k) => Work.Homology.ZMod)

/-- **The `Δ`-chain complex of the two-torus**, in the presentation whose chain groups are the
coproducts `Tor2KX k` (definitionally `Work.PieceHomology.torus2DeltaCx.chain`). -/
abbrev Tor2K : ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.of Tor2KX (fun k => Work.PieceHomology.torus2DeltaCx.chainD k)
    (Work.DeltaHomology.chainD_comp Work.PieceHomology.torus2DeltaCx)

/-- **The matrix model of the torus**: `ℤ --0--> ℤ³ --M--> ℤ²` with `M = !![1,1;1,1;-1,-1]`,
in the presentation whose index types are the numerals `torus2Card k`.  It is definitionally
`Work.PieceHomology.torus2Cx.toChainComplex`. -/
abbrev Tor2M : ChainComplex (ModuleCat ℤ) ℕ :=
  ChainComplex.of (fun k => ModuleCat.of ℤ (Fin (Work.PieceHomology.torus2Card k) → ℤ))
    (fun k => ModuleCat.ofHom
      (Matrix.toLin' ((Work.PieceHomology.torus2Bd k).toMatrix)))
    (fun k => by
      rw [← ModuleCat.ofHom_comp, ← Matrix.toLin'_mul, Work.PieceHomology.torus2Bd_comp k]
      simp)

/-- The matrix model is the delivered `torus2Cx.toChainComplex` (definitionally). -/
theorem Tor2M_eq_torus2Cx : Tor2M = Work.PieceHomology.torus2Cx.toChainComplex := rfl

/-- **The `Δ`-chain complex of the torus is its matrix model**. -/
abbrev Tor2E : Tor2K ≅ Tor2M := Work.PieceHomology.ExistsTorus2.torus2ChainIsoAlt

/-- The comparison chain map `Δ`-chains of `T²` → singular chains of `T²`. -/
abbrev tor2Phi : Tor2K ⟶ Ltor := Work.PieceHomology.torus2RealizationData.deltaChainMap

/-- The subtorus map `F_v`, as a chain map. -/
abbrev tor2Psi (v : Work.Space.Cusp) : Ltor ⟶ Lmbar :=
  singCxFun.map (Fn (rt := rtConcrete) v)

/-- `Φ ≫ F_v`, the composite appearing in the statement of the boundary hypotheses. -/
abbrev tor2Th (v : Work.Space.Cusp) : Tor2K ⟶ Lmbar := tor2Phi ≫ tor2Psi v

/-- The same composite, with the `Δ`-chain complex replaced by the matrix model. -/
abbrev tor2ThM (v : Work.Space.Cusp) : Tor2M ⟶ Lmbar := Tor2E.inv ≫ tor2Th v

/-- The degree-`k` component of `tor2ThM v`. -/
abbrev ThMF (v : Work.Space.Cusp) (k : ℕ) : Tor2M.X k ⟶ SChM k := (tor2ThM v).f k

/-- The generator `σ` of the `Δ`-chain complex of `T²`, as a morphism out of `ℤ`. -/
abbrev kgen (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    Work.Homology.ZMod ⟶ Tor2KX k :=
  (Limits.Sigma.ι (fun _ : Fin (Work.PieceHomology.torus2Card k) => Work.Homology.ZMod) σ :
    Work.Homology.ZMod ⟶ Tor2KX k)

/-- The `Δ`-generator `σ` of the torus, pushed to the singular chains of `T²`. -/
abbrev dgen (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    Work.Homology.ZMod ⟶ SChT k :=
  (kgen k σ ≫ (Work.PieceHomology.torus2RealizationData).deltaChainMapFun k :
    Work.Homology.ZMod ⟶ SChT k)

/-- The `σ`-th standard basis vector of the matrix model, as a morphism out of `ℤ`. -/
abbrev bgen (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    Work.Homology.ZMod ⟶ Tor2M.X k :=
  (Limits.Sigma.ι (fun _ : Fin (Work.PieceHomology.torus2Card k) => Work.Homology.ZMod) σ ≫
      (Work.PieceHomology.coprodIsoFreeMod (Work.PieceHomology.torus2Card k)).hom :
    Work.Homology.ZMod ⟶ Tor2M.X k)

/-- The generator `T₀ - T₁` of the `2`-cycles of the matrix model. -/
abbrev genT : Work.Homology.ZMod ⟶ Tor2M.X 2 :=
  (ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ (Fin (Work.PieceHomology.torus2Card 2) → ℤ)
      (Pi.single (Work.PieceHomology.torus2Tri 0) 1
        - Pi.single (Work.PieceHomology.torus2Tri 1) 1)) : Work.Homology.ZMod ⟶
        ModuleCat.of ℤ (Fin (Work.PieceHomology.torus2Card 2) → ℤ))

/-- The first-coordinate functional on the `2`-chains of the matrix model. -/
abbrev rho2 : Tor2M.X 2 ⟶ Work.Homology.ZMod :=
  (ModuleCat.ofHom (((LinearMap.proj (Work.PieceHomology.torus2Tri 0)) :
      (Fin (Work.PieceHomology.torus2Card 2) → ℤ) →ₗ[ℤ] ℤ)) : _ ⟶ Work.Homology.ZMod)




/-! ## §0b  The single-chain morphism `ℤ → M`

Any chain `c` of `M̄` gives a morphism out of `ℤ`, namely `a ↦ a • c`; this is how the boundary
witnesses of `SubtorusBoundaries` are turned into morphisms. -/

/-- The morphism `ℤ ⟶ M` sending `1` to `c`. -/
noncomputable def ptMor {k : ℕ} (c : SChM k) : Work.Homology.ZMod ⟶ SChM k :=
  ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ (SChM k) c)

/-- `ptMor` evaluated at `1`. -/
theorem ptMor_apply {k : ℕ} (c : SChM k) : (ptMor c) (1 : ℤ) = c := by
  change (LinearMap.toSpanSingleton ℤ (SChM k) c) (1 : ℤ) = c
  rw [LinearMap.toSpanSingleton_apply]
  exact @one_smul ℤ ↥(SChM k) Int.instMonoid ((SChM k).isModule.toMulAction) c

theorem Tor2E_hom_f (k : ℕ) :
    Tor2E.hom.f k = (Work.PieceHomology.ExistsTorus2.torus2ChainIsoComponent k).hom :=
  HomologicalComplex.Hom.isoOfComponents_hom_f _ _ k

theorem Tor2E_f_kgen (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    Tor2E.hom.f k (kgen k σ (1 : ℤ)) = Pi.single σ 1 := by
  have h := congrArg (fun f : Work.Homology.ZMod ⟶ Tor2M.X k => f (1 : ℤ))
    (Work.PieceHomology.coprodIsoFreeMod_ι (Work.PieceHomology.torus2Card k) σ)
  rw [Tor2E_hom_f, Work.PieceHomology.ExistsTorus2.torus2ChainIsoComponent_hom]
  refine h.trans ?_
  change (LinearMap.single ℤ (fun _ : Fin (Work.PieceHomology.torus2Card k) => ℤ) σ) (1 : ℤ)
    = Pi.single σ 1
  rw [LinearMap.single_apply]

theorem bgen_apply (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    (bgen k σ) (1 : ℤ) = Pi.single σ 1 := by
  have h := congrArg (fun f : Work.Homology.ZMod ⟶ Tor2M.X k => f (1 : ℤ))
    (Work.PieceHomology.coprodIsoFreeMod_ι (Work.PieceHomology.torus2Card k) σ)
  refine h.trans ?_
  change (LinearMap.single ℤ (fun _ : Fin (Work.PieceHomology.torus2Card k) => ℤ) σ) (1 : ℤ)
    = Pi.single σ 1
  rw [LinearMap.single_apply]

theorem Tor2E_hom_comp_inv (k : ℕ) :
    Tor2E.hom.f k ≫ Tor2E.inv.f k = 𝟙 (Tor2K.X k) := by
  have h1 : Tor2E.hom ≫ Tor2E.inv = 𝟙 Tor2K := Iso.hom_inv_id Tor2E
  have h2 := congrArg (fun f : Tor2K ⟶ Tor2K => f.f k) h1
  simpa only [HomologicalComplex.comp_f, HomologicalComplex.id_f] using h2

theorem Tor2E_inv_f_single (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    (Tor2E.inv.f k) (Pi.single σ 1) = kgen k σ (1 : ℤ) := by
  calc (Tor2E.inv.f k) (Pi.single σ 1)
      = (Tor2E.inv.f k) ((Tor2E.hom.f k) (kgen k σ (1 : ℤ))) := by rw [Tor2E_f_kgen]
    _ = ((Tor2E.hom.f k) ≫ (Tor2E.inv.f k)) (kgen k σ (1 : ℤ)) :=
        (CategoryTheory.comp_apply _ _ _).symm
    _ = (𝟙 (Tor2K.X k)) (kgen k σ (1 : ℤ)) := by rw [Tor2E_hom_comp_inv]
    _ = kgen k σ (1 : ℤ) := rfl

theorem bgen_comp_inv (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    (bgen k σ ≫ (Tor2E.inv.f k : Tor2M.X k ⟶ Tor2K.X k) : Work.Homology.ZMod ⟶ Tor2K.X k)
      = kgen k σ := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change ((bgen k σ ≫ (Tor2E.inv.f k : Tor2M.X k ⟶ Tor2K.X k) : Work.Homology.ZMod ⟶ Tor2K.X k)
      : Work.Homology.ZMod ⟶ Tor2K.X k) (1 : ℤ)
    = (kgen k σ : Work.Homology.ZMod ⟶ Tor2K.X k) (1 : ℤ)
  rw [CategoryTheory.comp_apply, bgen_apply, Tor2E_inv_f_single]

theorem chiChain_eq_dgen (k : ℕ) (σ : Fin (Work.PieceHomology.torus2Card k)) :
    chiChain k σ = (dgen k σ) (1 : ℤ) := by
  have h1 : dgen k σ
      = (SSet.ιChainComplex (TopCat.toSSet.obj Work.PieceHomology.Torus2Space)
          (R := ModuleCat.of ℤ ℤ)
          (Work.PieceHomology.torus2Chi k
            (Fin.cast (Work.PieceHomology.torus2DeltaCx_card k).symm σ)) :
        Work.Homology.ZMod ⟶ SChT k) :=
    Work.DeltaHomology.DeltaSimplexMap.deltaChainMapFun_chainι _ k _
  have h2 : ((SSet.ιChainComplex (TopCat.toSSet.obj Work.PieceHomology.Torus2Space)
          (R := ModuleCat.of ℤ ℤ)
          (Work.PieceHomology.torus2Chi k
            (Fin.cast (Work.PieceHomology.torus2DeltaCx_card k).symm σ)) :
        Work.Homology.ZMod ⟶ SChT k) (1 : ℤ)) = chiChain k σ := rfl
  exact ((congrArg (fun f => (f : Work.Homology.ZMod ⟶ SChT k) (1 : ℤ)) h1).trans h2).symm

theorem tor2Th_f_apply (v : Work.Space.Cusp) (k : ℕ) (x : Tor2K.X k) :
    (tor2Th v).f k x
      = (tor2Psi v).f k ((Work.PieceHomology.torus2RealizationData).deltaChainMapFun k x) :=
  rfl

theorem ThMF_apply (v : Work.Space.Cusp) (k : ℕ) (x : Tor2M.X k) :
    ThMF v k x = (tor2Th v).f k ((Tor2E.inv.f k) x) :=
  rfl

theorem genT_apply : (genT : Work.Homology.ZMod ⟶ Tor2M.X 2) (1 : ℤ)
    = Pi.single (Work.PieceHomology.torus2Tri 0) 1
      - Pi.single (Work.PieceHomology.torus2Tri 1) 1 := by
  change (LinearMap.toSpanSingleton ℤ (Fin (Work.PieceHomology.torus2Card 2) → ℤ)
      (Pi.single (Work.PieceHomology.torus2Tri 0) 1
        - Pi.single (Work.PieceHomology.torus2Tri 1) 1)) (1 : ℤ) = _
  rw [LinearMap.toSpanSingleton_apply, one_smul]

theorem bgen_sub_eq_genT :
    (bgen 2 (Work.PieceHomology.torus2Tri 0) - bgen 2 (Work.PieceHomology.torus2Tri 1) :
      Work.Homology.ZMod ⟶ Tor2M.X 2) = genT := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  rw [ModuleCat.hom_sub, LinearMap.sub_apply, bgen_apply, bgen_apply, genT_apply]


theorem sub_apply_apply {X Y : ModuleCat ℤ} (f g : X ⟶ Y) (x : X) :
    (f - g) x = f x - g x :=
  LinearMap.sub_apply f.hom g.hom x

theorem kgen_sub_apply :
    ((kgen 2 (Work.PieceHomology.torus2Tri 0) - kgen 2 (Work.PieceHomology.torus2Tri 1) :
        Work.Homology.ZMod ⟶ Tor2K.X 2) (1 : ℤ))
      = (kgen 2 (Work.PieceHomology.torus2Tri 0)) (1 : ℤ)
        - (kgen 2 (Work.PieceHomology.torus2Tri 1)) (1 : ℤ) :=
  sub_apply_apply _ _ _

theorem kgen_sub_eq_genT_inv :
    (kgen 2 (Work.PieceHomology.torus2Tri 0) - kgen 2 (Work.PieceHomology.torus2Tri 1) :
      Work.Homology.ZMod ⟶ Tor2K.X 2)
      = (genT ≫ (Tor2E.inv.f 2 : Tor2M.X 2 ⟶ Tor2K.X 2) : Work.Homology.ZMod ⟶ Tor2K.X 2) := by
  rw [← bgen_comp_inv 2 (Work.PieceHomology.torus2Tri 0),
    ← bgen_comp_inv 2 (Work.PieceHomology.torus2Tri 1), ← Preadditive.sub_comp,
    bgen_sub_eq_genT]

theorem singA_model (v : Work.Space.Cusp) :
    singA v = ((bgen 1 (Work.PieceHomology.torus2Edge 0) ≫ ThMF v 1) (1 : ℤ)) := by
  have hb := congrArg (fun f : Work.Homology.ZMod ⟶ Tor2K.X 1 => f (1 : ℤ))
    (bgen_comp_inv 1 (Work.PieceHomology.torus2Edge 0))
  calc singA v
      = (tor2Psi v).f 1 (chiChain 1 (Work.PieceHomology.torus2Edge 0)) := rfl
    _ = (tor2Psi v).f 1 ((dgen 1 (Work.PieceHomology.torus2Edge 0)) (1 : ℤ)) :=
        congrArg (fun x => (tor2Psi v).f 1 x)
          (chiChain_eq_dgen 1 (Work.PieceHomology.torus2Edge 0))
    _ = (tor2Th v).f 1 (kgen 1 (Work.PieceHomology.torus2Edge 0) (1 : ℤ)) := rfl
    _ = (tor2Th v).f 1 (((bgen 1 (Work.PieceHomology.torus2Edge 0) ≫
          (Tor2E.inv.f 1 : Tor2M.X 1 ⟶ Tor2K.X 1)) : Work.Homology.ZMod ⟶ Tor2K.X 1) (1 : ℤ)) := by
        rw [hb]
    _ = ThMF v 1 ((bgen 1 (Work.PieceHomology.torus2Edge 0)) (1 : ℤ)) := rfl
    _ = ((bgen 1 (Work.PieceHomology.torus2Edge 0) ≫ ThMF v 1) (1 : ℤ)) := rfl

theorem singB_model (v : Work.Space.Cusp) :
    singB v = ((bgen 1 (Work.PieceHomology.torus2Edge 1) ≫ ThMF v 1) (1 : ℤ)) := by
  have hb := congrArg (fun f : Work.Homology.ZMod ⟶ Tor2K.X 1 => f (1 : ℤ))
    (bgen_comp_inv 1 (Work.PieceHomology.torus2Edge 1))
  calc singB v
      = (tor2Psi v).f 1 (chiChain 1 (Work.PieceHomology.torus2Edge 1)) := rfl
    _ = (tor2Psi v).f 1 ((dgen 1 (Work.PieceHomology.torus2Edge 1)) (1 : ℤ)) :=
        congrArg (fun x => (tor2Psi v).f 1 x)
          (chiChain_eq_dgen 1 (Work.PieceHomology.torus2Edge 1))
    _ = (tor2Th v).f 1 (kgen 1 (Work.PieceHomology.torus2Edge 1) (1 : ℤ)) := rfl
    _ = (tor2Th v).f 1 (((bgen 1 (Work.PieceHomology.torus2Edge 1) ≫
          (Tor2E.inv.f 1 : Tor2M.X 1 ⟶ Tor2K.X 1)) : Work.Homology.ZMod ⟶ Tor2K.X 1) (1 : ℤ)) := by
        rw [hb]
    _ = ThMF v 1 ((bgen 1 (Work.PieceHomology.torus2Edge 1)) (1 : ℤ)) := rfl
    _ = ((bgen 1 (Work.PieceHomology.torus2Edge 1) ≫ ThMF v 1) (1 : ℤ)) := rfl

theorem singT_model (v : Work.Space.Cusp) :
    singT v = ((genT ≫ ThMF v 2) (1 : ℤ)) := by
  calc singT v
      = (tor2Psi v).f 2 (chiChain 2 (Work.PieceHomology.torus2Tri 0))
          - (tor2Psi v).f 2 (chiChain 2 (Work.PieceHomology.torus2Tri 1)) := rfl
    _ = (tor2Psi v).f 2 ((dgen 2 (Work.PieceHomology.torus2Tri 0)) (1 : ℤ))
          - (tor2Psi v).f 2 ((dgen 2 (Work.PieceHomology.torus2Tri 1)) (1 : ℤ)) := by
        rw [chiChain_eq_dgen 2 (Work.PieceHomology.torus2Tri 0),
          chiChain_eq_dgen 2 (Work.PieceHomology.torus2Tri 1)]
    _ = (tor2Th v).f 2 (kgen 2 (Work.PieceHomology.torus2Tri 0) (1 : ℤ))
          - (tor2Th v).f 2 (kgen 2 (Work.PieceHomology.torus2Tri 1) (1 : ℤ)) := rfl
    _ = (tor2Th v).f 2 ((kgen 2 (Work.PieceHomology.torus2Tri 0)
          - kgen 2 (Work.PieceHomology.torus2Tri 1)) (1 : ℤ)) := by
        rw [← map_sub, kgen_sub_apply]
    _ = (tor2Th v).f 2 ((genT ≫ (Tor2E.inv.f 2 : Tor2M.X 2 ⟶ Tor2K.X 2) :
          Work.Homology.ZMod ⟶ Tor2K.X 2) (1 : ℤ)) := by rw [kgen_sub_eq_genT_inv]
    _ = ThMF v 2 ((genT : Work.Homology.ZMod ⟶ Tor2M.X 2) (1 : ℤ)) := rfl
    _ = ((genT ≫ ThMF v 2) (1 : ℤ)) := rfl

/-! ## §3  The general vanishing lemma -/

theorem homologyMap_eq_zero_of_factors
    {K L : ChainComplex (ModuleCat ℤ) ℕ} (φ : K ⟶ L) (i : ℕ)
    (h : ∃ c : K.cycles i ⟶ L.X (i+1), c ≫ L.d (i+1) i = K.iCycles i ≫ φ.f i) :
    HomologicalComplex.homologyMap φ i = 0 := by
  obtain ⟨c, hc⟩ := h
  have hcyc : c ≫ L.toCycles (i+1) i = HomologicalComplex.cyclesMap φ i := by
    rw [← cancel_mono (L.iCycles i), Category.assoc, HomologicalComplex.toCycles_i, hc,
      HomologicalComplex.cyclesMap_i]
  rw [← cancel_epi (K.homologyπ i), HomologicalComplex.homologyπ_naturality, ← hcyc,
    Category.assoc, HomologicalComplex.toCycles_comp_homologyπ, Limits.comp_zero,
    Limits.comp_zero]

/-! ## §4  Element computations in the matrix model -/

theorem add_apply_apply {X Y : ModuleCat ℤ} (f g : X ⟶ Y) (x : X) :
    (f + g) x = f x + g x :=
  LinearMap.add_apply f.hom g.hom x

theorem zero_apply_apply {X Y : ModuleCat ℤ} (x : X) : (0 : X ⟶ Y) x = (0 : Y) := by
  change (0 : X →ₗ[ℤ] Y) x = 0
  rw [LinearMap.zero_apply]

theorem d21_eq : (Tor2M.d 2 1)
    = (ModuleCat.ofHom (Matrix.toLin' ((Work.PieceHomology.torus2Bd 1).toMatrix)) :
        Tor2M.X 2 ⟶ Tor2M.X 1) := by
  have h : (Tor2M.d 2 1) = (Tor2M.d (1 + 1) 1) := rfl
  rw [h]
  exact ChainComplex.of_d (fun k => ModuleCat.of ℤ (Fin (Work.PieceHomology.torus2Card k) → ℤ))
    (fun k => ModuleCat.ofHom (Matrix.toLin' ((Work.PieceHomology.torus2Bd k).toMatrix))) 1

theorem Tor2M_d21_single (σ : Fin (Work.PieceHomology.torus2Card 2)) :
    (Tor2M.d 2 1) (Pi.single σ 1)
      = Pi.single (Work.PieceHomology.torus2Edge 0) 1
        + Pi.single (Work.PieceHomology.torus2Edge 1) 1
        - Pi.single (Work.PieceHomology.torus2Edge 2) 1 := by
  fin_cases σ <;> decide

theorem sum_two {M : Type*} [AddCommMonoid M] (g : Fin (Work.PieceHomology.torus2Card 2) → M) :
    (∑ j, g j) = g (Work.PieceHomology.torus2Tri 0) + g (Work.PieceHomology.torus2Tri 1) := by
  rw [show (Finset.univ : Finset (Fin (Work.PieceHomology.torus2Card 2)))
      = {Work.PieceHomology.torus2Tri 0, Work.PieceHomology.torus2Tri 1} from by decide]
  exact Finset.sum_pair (by decide)

theorem tor2Bd1_entry0 (i : Fin (Work.PieceHomology.torus2Card 1)) :
    (Work.PieceHomology.torus2Bd 1).toMatrix i (Work.PieceHomology.torus2Tri 0)
      = if i = Work.PieceHomology.torus2Edge 2 then (-1 : ℤ) else 1 := by
  fin_cases i <;> decide

theorem tor2Bd1_entry1 (i : Fin (Work.PieceHomology.torus2Card 1)) :
    (Work.PieceHomology.torus2Bd 1).toMatrix i (Work.PieceHomology.torus2Tri 1)
      = if i = Work.PieceHomology.torus2Edge 2 then (-1 : ℤ) else 1 := by
  fin_cases i <;> decide

theorem d21_eval (x : Tor2M.X 2) :
    ((Tor2M.d 2 1) x) (Work.PieceHomology.torus2Edge 2)
      = - (x (Work.PieceHomology.torus2Tri 0) + x (Work.PieceHomology.torus2Tri 1)) := by
  have h := d21_eq
  rw [h]
  change (Matrix.toLin' ((Work.PieceHomology.torus2Bd 1).toMatrix)) x
    (Work.PieceHomology.torus2Edge 2) = _
  rw [Matrix.toLin'_apply, Matrix.mulVec_apply_eq_sum, sum_two]
  rw [tor2Bd1_entry0 (Work.PieceHomology.torus2Edge 2),
    tor2Bd1_entry1 (Work.PieceHomology.torus2Edge 2)]
  simp only [ite_true]
  ring

theorem d21_formula (x : Tor2M.X 2) :
    (Tor2M.d 2 1) x
      = fun i => (x (Work.PieceHomology.torus2Tri 0) + x (Work.PieceHomology.torus2Tri 1))
          * (if i = Work.PieceHomology.torus2Edge 2 then (-1 : ℤ) else 1) := by
  have h := d21_eq
  rw [h]
  change (Matrix.toLin' ((Work.PieceHomology.torus2Bd 1).toMatrix)) x = _
  rw [Matrix.toLin'_apply]
  funext i
  rw [Matrix.mulVec_apply_eq_sum, sum_two]
  rw [tor2Bd1_entry0 i, tor2Bd1_entry1 i]
  ring

theorem genT_apply' : (genT : Work.Homology.ZMod ⟶ Tor2M.X 2) (1 : ℤ)
    = Pi.single (Work.PieceHomology.torus2Tri 0) 1
      - Pi.single (Work.PieceHomology.torus2Tri 1) 1 := by
  change (LinearMap.toSpanSingleton ℤ (Fin (Work.PieceHomology.torus2Card 2) → ℤ)
      (Pi.single (Work.PieceHomology.torus2Tri 0) 1
        - Pi.single (Work.PieceHomology.torus2Tri 1) 1)) (1 : ℤ) = _
  rw [LinearMap.toSpanSingleton_apply, one_smul]

theorem genT_smul (a : ℤ) : (genT : Work.Homology.ZMod ⟶ Tor2M.X 2) a
    = a • (Pi.single (Work.PieceHomology.torus2Tri 0) 1
      - Pi.single (Work.PieceHomology.torus2Tri 1) 1) := by
  change (LinearMap.toSpanSingleton ℤ (Fin (Work.PieceHomology.torus2Card 2) → ℤ)
      (Pi.single (Work.PieceHomology.torus2Tri 0) 1
        - Pi.single (Work.PieceHomology.torus2Tri 1) 1)) a = _
  rw [LinearMap.toSpanSingleton_apply]

theorem genT_cycle : genT ≫ Tor2M.d 2 1 = 0 := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change ((genT ≫ Tor2M.d 2 1 : Work.Homology.ZMod ⟶ Tor2M.X 1) (1 : ℤ))
    = ((0 : Work.Homology.ZMod ⟶ Tor2M.X 1) (1 : ℤ))
  rw [CategoryTheory.comp_apply, genT_apply', map_sub,
    Tor2M_d21_single (Work.PieceHomology.torus2Tri 0),
    Tor2M_d21_single (Work.PieceHomology.torus2Tri 1)]
  rw [sub_self]
  exact (zero_apply_apply (X := Work.Homology.ZMod) (Y := Tor2M.X 1) (1 : ℤ)).symm

theorem rho2_apply (x : Tor2M.X 2) :
    (rho2) x = x (Work.PieceHomology.torus2Tri 0) := by
  change (LinearMap.proj (Work.PieceHomology.torus2Tri 0)) x
    = x (Work.PieceHomology.torus2Tri 0)
  rw [LinearMap.proj_apply]

theorem genT_rho2 : genT ≫ rho2 = 𝟙 Work.Homology.ZMod := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change ((genT ≫ rho2 : Work.Homology.ZMod ⟶ Work.Homology.ZMod) (1 : ℤ)) = (1 : ℤ)
  rw [CategoryTheory.comp_apply, genT_apply']
  decide

theorem ker_d21 (x : Tor2M.X 2) (hx : (Tor2M.d 2 1) x = 0) : genT (rho2 x) = x := by
  have h0 : x (Work.PieceHomology.torus2Tri 0) + x (Work.PieceHomology.torus2Tri 1) = 0 := by
    have h := congrFun hx (Work.PieceHomology.torus2Edge 2)
    rw [d21_eval x] at h
    rw [show (0 : Tor2M.X 1) (Work.PieceHomology.torus2Edge 2) = 0 from rfl] at h
    linarith [h]
  have h1 : x (Work.PieceHomology.torus2Tri 1) = - x (Work.PieceHomology.torus2Tri 0) := by
    linarith [h0]
  have hx' : (x (Work.PieceHomology.torus2Tri 0)) • (Pi.single (Work.PieceHomology.torus2Tri 0) 1)
      + (x (Work.PieceHomology.torus2Tri 1)) • (Pi.single (Work.PieceHomology.torus2Tri 1) 1)
      = x := by
    have h := (Pi.basisFun ℤ (Fin (Work.PieceHomology.torus2Card 2))).sum_repr x
    simp only [Pi.basisFun_repr, Pi.basisFun_apply] at h
    rwa [sum_two] at h
  rw [genT_smul, rho2_apply, smul_sub, sub_eq_add_neg, ← neg_smul, ← h1, hx']

theorem iCycles_rho2_genT : Tor2M.iCycles 2 ≫ (rho2 ≫ genT) = Tor2M.iCycles 2 := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  change genT (rho2 (Tor2M.iCycles 2 y)) = Tor2M.iCycles 2 y
  refine ker_d21 _ ?_
  change (Tor2M.d 2 1) (Tor2M.iCycles 2 y) = 0
  rw [← CategoryTheory.comp_apply, HomologicalComplex.iCycles_d]
  rfl

/-! ## §5  The degree-one factorization, in the matrix presentation -/

theorem bgen_d21 :
    (bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ Tor2M.d 2 1 :
      Work.Homology.ZMod ⟶ Tor2M.X 1)
      = bgen 1 (Work.PieceHomology.torus2Edge 0) + bgen 1 (Work.PieceHomology.torus2Edge 1)
        - bgen 1 (Work.PieceHomology.torus2Edge 2) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change ((bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ Tor2M.d 2 1 :
      Work.Homology.ZMod ⟶ Tor2M.X 1) (1 : ℤ))
    = ((bgen 1 (Work.PieceHomology.torus2Edge 0) + bgen 1 (Work.PieceHomology.torus2Edge 1)
        - bgen 1 (Work.PieceHomology.torus2Edge 2) : Work.Homology.ZMod ⟶ Tor2M.X 1) (1 : ℤ))
  rw [CategoryTheory.comp_apply, bgen_apply,
    Tor2M_d21_single (Work.PieceHomology.torus2Tri 0), sub_apply_apply, add_apply_apply,
    bgen_apply, bgen_apply, bgen_apply]

/-! ## §6  The degree-two factorization -/

theorem exists_factors_two (v : Work.Space.Cusp)
    (hT : ∃ wT : Work.Homology.ZMod ⟶ SChM 3,
      wT ≫ Lmbar.d 3 2 = genT ≫ ThMF v 2) :
    ∃ c : Tor2M.cycles 2 ⟶ SChM 3, c ≫ Lmbar.d 3 2 = Tor2M.iCycles 2 ≫ ThMF v 2 := by
  obtain ⟨wT, hwT⟩ := hT
  refine ⟨(Tor2M.iCycles 2 ≫ rho2) ≫ wT, ?_⟩
  calc ((Tor2M.iCycles 2 ≫ rho2) ≫ wT) ≫ Lmbar.d 3 2
      = (Tor2M.iCycles 2 ≫ rho2) ≫ (wT ≫ Lmbar.d 3 2) := Category.assoc _ _ _
    _ = (Tor2M.iCycles 2 ≫ rho2) ≫ (genT ≫ ThMF v 2) := by rw [hwT]
    _ = ((Tor2M.iCycles 2 ≫ rho2) ≫ genT) ≫ ThMF v 2 := (Category.assoc _ _ _).symm
    _ = (Tor2M.iCycles 2 ≫ (rho2 ≫ genT)) ≫ ThMF v 2 := by
        rw [Category.assoc (Tor2M.iCycles 2) rho2 genT]
    _ = Tor2M.iCycles 2 ≫ ThMF v 2 := by rw [iCycles_rho2_genT]


/-! ## §5b  The degree-one factorization of the matrix model

`H_1` of the torus is generated by the classes of the two loops `e₀ = a`, `e₁ = b`: every
`1`-chain is a cycle (`∂₁ = 0`) and the third loop satisfies `e₀ + e₁ - e₂ = ∂T₀`.  Hence if the
images of `a` and `b` bound, so does the image of every `1`-chain. -/

/-- **The degree-one factorization.**  If the images in `M̄` of the two loops `a`, `b` of the
`Δ`-model of `T²` are boundaries, then the whole degree-one part of the map `ThMF v 1 : H_1`-chains
factors through the differential `d : C_2(M̄) → C_1(M̄)`. -/
theorem exists_factors_one (v : Work.Space.Cusp)
    (hA : ∃ wa : Work.Homology.ZMod ⟶ SChM 2,
      wa ≫ Lmbar.d 2 1 = bgen 1 (Work.PieceHomology.torus2Edge 0) ≫ ThMF v 1)
    (hB : ∃ wb : Work.Homology.ZMod ⟶ SChM 2,
      wb ≫ Lmbar.d 2 1 = bgen 1 (Work.PieceHomology.torus2Edge 1) ≫ ThMF v 1) :
    ∃ w : Tor2M.X 1 ⟶ SChM 2, w ≫ Lmbar.d 2 1 = ThMF v 1 := by
  obtain ⟨wa, hwa⟩ := hA
  obtain ⟨wb, hwb⟩ := hB
  have hT : (ThMF v 2 ≫ Lmbar.d 2 1) = (Tor2M.d 2 1 ≫ ThMF v 1) :=
    HomologicalComplex.Hom.comm (tor2ThM v) 2 1
  -- the differential of the matrix model on the generator `T₀`
  have hD : Tor2M.d 2 1 (Pi.single (Work.PieceHomology.torus2Tri 0) 1)
      = Pi.single (Work.PieceHomology.torus2Edge 0) 1
        + Pi.single (Work.PieceHomology.torus2Edge 1) 1
        - Pi.single (Work.PieceHomology.torus2Edge 2) 1 := by
    have h := congrArg (fun f : Work.Homology.ZMod ⟶ Tor2M.X 1 => f (1 : ℤ)) bgen_d21
    rw [CategoryTheory.comp_apply, bgen_apply] at h
    rw [sub_apply_apply, add_apply_apply, bgen_apply, bgen_apply, bgen_apply] at h
    exact h
  -- the two given factorizations, evaluated at `1`
  have hwa1 : Lmbar.d 2 1 (wa (1 : ℤ))
      = ThMF v 1 (Pi.single (Work.PieceHomology.torus2Edge 0) 1) := by
    have h := congrArg (fun f : Work.Homology.ZMod ⟶ SChM 1 => f (1 : ℤ)) hwa
    rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, bgen_apply] at h
    exact h
  have hwb1 : Lmbar.d 2 1 (wb (1 : ℤ))
      = ThMF v 1 (Pi.single (Work.PieceHomology.torus2Edge 1) 1) := by
    have h := congrArg (fun f : Work.Homology.ZMod ⟶ SChM 1 => f (1 : ℤ)) hwb
    rw [CategoryTheory.comp_apply, CategoryTheory.comp_apply, bgen_apply] at h
    exact h
  -- the third generator
  have hU : Lmbar.d 2 1
        ((wa + wb - bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ ThMF v 2) (1 : ℤ))
      = ThMF v 1 (Pi.single (Work.PieceHomology.torus2Edge 2) 1) := by
    have hC : Lmbar.d 2 1 ((bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ ThMF v 2) (1 : ℤ))
        = ThMF v 1 (Tor2M.d 2 1 (Pi.single (Work.PieceHomology.torus2Tri 0) 1)) := by
      rw [CategoryTheory.comp_apply, bgen_apply]
      have h := congrArg (fun f : Tor2M.X 2 ⟶ SChM 1 =>
        f (Pi.single (Work.PieceHomology.torus2Tri 0) 1)) hT
      simpa only [CategoryTheory.comp_apply] using h
    have hE : Pi.single (Work.PieceHomology.torus2Edge 0) 1
          + Pi.single (Work.PieceHomology.torus2Edge 1) 1
          - Tor2M.d 2 1 (Pi.single (Work.PieceHomology.torus2Tri 0) 1)
        = Pi.single (Work.PieceHomology.torus2Edge 2) 1 := by
      rw [hD]
      abel
    rw [sub_apply_apply, add_apply_apply, map_sub, map_add, hwa1, hwb1, hC,
      ← map_add, ← map_sub, hE]
  -- the linear combination defining the factorization
  let hL : (Fin (Work.PieceHomology.torus2Card 1) →₀ ℤ) →ₗ[ℤ] SChM 2 :=
    Finsupp.linearCombination ℤ
      (fun i : Fin (Work.PieceHomology.torus2Card 1) =>
        if i = Work.PieceHomology.torus2Edge 0 then (wa (1 : ℤ))
        else if i = Work.PieceHomology.torus2Edge 1 then (wb (1 : ℤ))
        else ((wa + wb - bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ ThMF v 2) (1 : ℤ)))
  let hF : (Fin (Work.PieceHomology.torus2Card 1) → ℤ) →ₗ[ℤ]
      (Fin (Work.PieceHomology.torus2Card 1) →₀ ℤ) :=
    ((Finsupp.linearEquivFunOnFinite ℤ ℤ (Fin (Work.PieceHomology.torus2Card 1))).symm :
      (Fin (Work.PieceHomology.torus2Card 1) → ℤ) ≃ₗ[ℤ]
        (Fin (Work.PieceHomology.torus2Card 1) →₀ ℤ)).toLinearMap
  have hW : ∀ i : Fin (Work.PieceHomology.torus2Card 1),
      (hL.comp hF) (Pi.single i 1)
        = (if i = Work.PieceHomology.torus2Edge 0 then (wa (1 : ℤ))
           else if i = Work.PieceHomology.torus2Edge 1 then (wb (1 : ℤ))
           else ((wa + wb - bgen 2 (Work.PieceHomology.torus2Tri 0) ≫ ThMF v 2) (1 : ℤ))) := by
    intro i
    simp only [hL, hF, LinearMap.comp_apply, LinearEquiv.coe_coe,
      Finsupp.linearEquivFunOnFinite_symm_single, Finsupp.linearCombination_single]
    exact @one_smul ℤ ↥(SChM 2) Int.instMonoid ((SChM 2).isModule.toMulAction) _
  refine ⟨ModuleCat.ofHom (hL.comp hF), ?_⟩
  apply ModuleCat.hom_ext
  apply (Pi.basisFun ℤ (Fin (Work.PieceHomology.torus2Card 1))).ext
  intro i
  rw [Pi.basisFun_apply]
  change Lmbar.d 2 1 ((hL.comp hF) (Pi.single i 1)) = ThMF v 1 (Pi.single i 1)
  rw [hW i]
  by_cases h0 : i = Work.PieceHomology.torus2Edge 0
  · rw [if_pos h0, h0]
    exact hwa1
  · rw [if_neg h0]
    by_cases h1 : i = Work.PieceHomology.torus2Edge 1
    · rw [if_pos h1, h1]
      exact hwb1
    · rw [if_neg h1]
      have hi : i = Work.PieceHomology.torus2Edge 2 := by
        revert i
        decide
      rw [hi]
      exact hU


/-! ## §7  The three boundary hypotheses, as statements about the matrix model -/

theorem exists_wa (h : SubtorusBoundaries) (v : Work.Space.Cusp) :
    ∃ wa : Work.Homology.ZMod ⟶ SChM 2,
      wa ≫ Lmbar.d 2 1 = bgen 1 (Work.PieceHomology.torus2Edge 0) ≫ ThMF v 1 := by
  obtain ⟨c, hc⟩ := (h v).1
  refine ⟨ptMor c, ?_⟩
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change (((ptMor c) ≫ Lmbar.d 2 1 : Work.Homology.ZMod ⟶ SChM 1) (1 : ℤ))
    = ((bgen 1 (Work.PieceHomology.torus2Edge 0) ≫ ThMF v 1 :
        Work.Homology.ZMod ⟶ SChM 1) (1 : ℤ))
  rw [CategoryTheory.comp_apply, ptMor_apply, hc, singA_model v]

theorem exists_wb (h : SubtorusBoundaries) (v : Work.Space.Cusp) :
    ∃ wb : Work.Homology.ZMod ⟶ SChM 2,
      wb ≫ Lmbar.d 2 1 = bgen 1 (Work.PieceHomology.torus2Edge 1) ≫ ThMF v 1 := by
  obtain ⟨c, hc⟩ := (h v).2.1
  refine ⟨ptMor c, ?_⟩
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change (((ptMor c) ≫ Lmbar.d 2 1 : Work.Homology.ZMod ⟶ SChM 1) (1 : ℤ))
    = ((bgen 1 (Work.PieceHomology.torus2Edge 1) ≫ ThMF v 1 :
        Work.Homology.ZMod ⟶ SChM 1) (1 : ℤ))
  rw [CategoryTheory.comp_apply, ptMor_apply, hc, singB_model v]

theorem exists_wT (h : SubtorusBoundaries) (v : Work.Space.Cusp) :
    ∃ wT : Work.Homology.ZMod ⟶ SChM 3,
      wT ≫ Lmbar.d 3 2 = genT ≫ ThMF v 2 := by
  obtain ⟨c, hc⟩ := (h v).2.2
  refine ⟨ptMor c, ?_⟩
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  change (((ptMor c) ≫ Lmbar.d 3 2 : Work.Homology.ZMod ⟶ SChM 2) (1 : ℤ))
    = ((genT ≫ ThMF v 2 : Work.Homology.ZMod ⟶ SChM 2) (1 : ℤ))
  rw [CategoryTheory.comp_apply, ptMor_apply, hc, singT_model v]

/-! ## §8  From the boundary hypotheses to `H_k(s_v) = 0` -/

/-- The degree-one input of `homologyMap_eq_zero_of_factors` for the matrix model. -/
theorem exists_cycles_one (h : SubtorusBoundaries) (v : Work.Space.Cusp) :
    ∃ c : Tor2M.cycles 1 ⟶ SChM 2, c ≫ Lmbar.d 2 1 = Tor2M.iCycles 1 ≫ ThMF v 1 := by
  obtain ⟨w, hw⟩ := exists_factors_one v (exists_wa h v) (exists_wb h v)
  exact ⟨Tor2M.iCycles 1 ≫ w, by rw [Category.assoc, hw]⟩

/-- The degree-two input of `homologyMap_eq_zero_of_factors` for the matrix model. -/
theorem exists_cycles_two (h : SubtorusBoundaries) (v : Work.Space.Cusp) :
    ∃ c : Tor2M.cycles 2 ⟶ SChM 3, c ≫ Lmbar.d 3 2 = Tor2M.iCycles 2 ≫ ThMF v 2 :=
  exists_factors_two v (exists_wT h v)

theorem homologyMap_thM_eq_zero (h : SubtorusBoundaries) (v : Work.Space.Cusp) (k : ℕ)
    (hk : k = 1 ∨ k = 2) : HomologicalComplex.homologyMap (tor2ThM v) k = 0 := by
  rcases hk with rfl | rfl
  · exact homologyMap_eq_zero_of_factors (tor2ThM v) 1 (exists_cycles_one h v)
  · exact homologyMap_eq_zero_of_factors (tor2ThM v) 2 (exists_cycles_two h v)

theorem homologyMap_th_eq_zero (h : SubtorusBoundaries) (v : Work.Space.Cusp) (k : ℕ)
    (hk : k = 1 ∨ k = 2) : HomologicalComplex.homologyMap (tor2Th v) k = 0 := by
  have h0 : HomologicalComplex.homologyMap (tor2ThM v) k = 0 := homologyMap_thM_eq_zero h v k hk
  have h1 : HomologicalComplex.homologyMap Tor2E.inv k ≫
      HomologicalComplex.homologyMap (tor2Th v) k = 0 := by
    simpa only [HomologicalComplex.homologyMap_comp] using h0
  haveI : IsIso (HomologicalComplex.homologyMap Tor2E.inv k) := inferInstance
  calc HomologicalComplex.homologyMap (tor2Th v) k
      = (inv (HomologicalComplex.homologyMap Tor2E.inv k) ≫
          HomologicalComplex.homologyMap Tor2E.inv k) ≫
            HomologicalComplex.homologyMap (tor2Th v) k := by
        rw [IsIso.inv_hom_id, Category.id_comp]
    _ = inv (HomologicalComplex.homologyMap Tor2E.inv k) ≫
          (HomologicalComplex.homologyMap Tor2E.inv k ≫
            HomologicalComplex.homologyMap (tor2Th v) k) :=
        Category.assoc _ _ _
    _ = 0 := by rw [h1, Limits.comp_zero]

theorem homologyMap_psi_eq_zero (h : SubtorusBoundaries) (v : Work.Space.Cusp) (k : ℕ)
    (hk : k = 1 ∨ k = 2) : HomologicalComplex.homologyMap (tor2Psi v) k = 0 := by
  have h0 : HomologicalComplex.homologyMap (tor2Th v) k = 0 := homologyMap_th_eq_zero h v k hk
  have h1 : HomologicalComplex.homologyMap tor2Phi k ≫
      HomologicalComplex.homologyMap (tor2Psi v) k = 0 := by
    simpa only [HomologicalComplex.homologyMap_comp] using h0
  haveI : QuasiIso tor2Phi :=
    Work.DeltaHomology.deltaChainMap_quasiIso Work.PieceHomology.torus2DeltaCx
      Work.PieceHomology.torus2RealizationData
  haveI : IsIso (HomologicalComplex.homologyMap tor2Phi k) := inferInstance
  calc HomologicalComplex.homologyMap (tor2Psi v) k
      = (inv (HomologicalComplex.homologyMap tor2Phi k) ≫
          HomologicalComplex.homologyMap tor2Phi k) ≫
            HomologicalComplex.homologyMap (tor2Psi v) k := by
        rw [IsIso.inv_hom_id, Category.id_comp]
    _ = inv (HomologicalComplex.homologyMap tor2Phi k) ≫
          (HomologicalComplex.homologyMap tor2Phi k ≫
            HomologicalComplex.homologyMap (tor2Psi v) k) :=
        Category.assoc _ _ _
    _ = 0 := by rw [h1, Limits.comp_zero]


end

end SNAux

theorem subtorusNull_of_boundaries
    (h : Work.BridgeSquare.SubtorusBoundaries) :
    Work.BridgeSquare.SubtorusNull (rt := Work.RTOwed.rtData) := by
  intro v k hk
  have h0 : HomologicalComplex.homologyMap (SNAux.tor2Psi v) k = 0 :=
    SNAux.homologyMap_psi_eq_zero h v k hk
  exact h0


end Work.BridgeSquare
