/-- The flat index of a `(j,i)` slot. -/
def fl0 (p : Fin 24 × Fin 3) : Fin (3 * 24) :=
  ⟨3 * (p.1 : ℕ) + (p.2 : ℕ), by have h := p.1.isLt; have h2 := p.2.isLt; omega⟩
/-- The flat index of a `(j,i)` slot of the wall. -/
def flw0 (p : Fin 32 × Fin 3) : Fin (3 * 32) :=
  ⟨3 * (p.1 : ℕ) + (p.2 : ℕ), by have h := p.1.isLt; have h2 := p.2.isLt; omega⟩

def aCF0 : Fin (3 * 24) → Fin Nat0 := ![8, 1, 0, 9, 4, 0, 31, 0, 1, 47, 3, 2, 48, 4, 2, 53, 2, 3, 57, 0, 4, 58, 2, 4, 35, 10, 8, 59, 10, 9, 71, 9, 10, 71, 9, 10, 61, 12, 11, 65, 11, 12, 69, 35, 34, 70, 36, 34, 105, 34, 36, 55, 49, 47, 59, 49, 48, 62, 55, 54, 72, 61, 62, 76, 70, 69, 77, 72, 73, 84, 76, 74]
def aCF0' : Fin (3 * 24) → Fin Nat0 := ![17, 14, 13, 18, 15, 13, 40, 13, 14, 96, 88, 87, 97, 89, 87, 102, 87, 88, 64, 13, 15, 107, 87, 89, 43, 19, 17, 106, 90, 91, 84, 91, 90, 77, 18, 19, 110, 93, 92, 113, 92, 93, 81, 43, 44, 82, 45, 44, 112, 44, 45, 101, 95, 96, 106, 95, 97, 109, 101, 103, 85, 110, 109, 79, 82, 81, 86, 85, 83, 86, 79, 78]
def aWF0 : Fin (3 * 32) → Fin Nat0 := ![80, 42, 44, 80, 111, 112, 67, 29, 28, 67, 100, 99, 108, 100, 103, 108, 111, 113, 38, 29, 26, 38, 42, 41, 68, 33, 34, 68, 104, 105, 66, 27, 28, 66, 98, 99, 94, 98, 102, 94, 104, 107, 21, 27, 25, 21, 33, 32, 6, 52, 51, 6, 24, 23, 16, 63, 64, 16, 39, 40, 37, 39, 41, 37, 24, 26, 60, 63, 65, 60, 52, 54, 5, 50, 51, 5, 22, 23, 7, 56, 57, 7, 30, 31, 20, 30, 32, 20, 22, 25, 46, 56, 58, 46, 50, 53]
def aB00 : Fin 3 → Fin Nat0 := ![83, 75, 74]
def aB01 : Fin 3 → Fin Nat0 := ![78, 75, 73]

/-- The atom of the first edge family of the collar. -/
def aC0 : Fin 24 × Fin 3 → Fin Nat0 := fun p => aCF0 (fl0 p)
/-- The atom of the second edge family of the collar. -/
def aC0' : Fin 24 × Fin 3 → Fin Nat0 := fun p => aCF0' (fl0 p)
/-- The atom of the edges of the wall. -/
def aW0 : Fin 32 × Fin 3 → Fin Nat0 := fun p => aWF0 (flw0 p)

def cC0 : Fin 24 × Fin 3 → ℤ := fun p => colCoef0 p.1 * ((-1 : ℤ) ^ (p.2 : ℕ))
def cC0' : Fin 24 × Fin 3 → ℤ := fun p => colCoef0 p.1 * ((-1 : ℤ) ^ (p.2 : ℕ))
def cW0 : Fin 32 × Fin 3 → ℤ := fun p => coefV0 p.1 * ((-1 : ℤ) ^ (p.2 : ℕ))
def cB0 : Fin 3 → ℤ := fun i => ((-1 : ℤ) ^ (i : ℕ))

def D10 : Fin Nat0 → ℤ := fun l =>
  ∑ p ∈ Finset.univ.filter (fun p => aC0 p = l), cC0 p
def D20 : Fin Nat0 → ℤ := fun l =>
  ∑ p ∈ Finset.univ.filter (fun p => aC0' p = l), cC0' p
def D30 : Fin Nat0 → ℤ := fun l =>
  ∑ p ∈ Finset.univ.filter (fun p => aW0 p = l), cW0 p
def D40 : Fin Nat0 → ℤ := fun l =>
  ∑ p ∈ Finset.univ.filter (fun p => aB00 p = l), cB0 p
def D50 : Fin Nat0 → ℤ := fun l =>
  ∑ p ∈ Finset.univ.filter (fun p => aB01 p = l), cB0 p

/-- The canonical basis vector of each atom. -/
abbrev X0 : Fin Nat0 → AffC 1 := fun l => Finsupp.single (B0 l) (1 : ℤ)

set_option maxHeartbeats 0 in
theorem hcoef0_c0 : ∀ l : Fin Nat0, 0 ≤ l.val → l.val < 60 → D10 l - D20 l = D30 l - (D40 l - D50 l) := by decide +kernel
set_option maxHeartbeats 0 in
theorem hcoef0_c1 : ∀ l : Fin Nat0, 60 ≤ l.val → D10 l - D20 l = D30 l - (D40 l - D50 l) := by decide +kernel
/-- The pointwise coefficient identity of the collar of cusp `0`. -/
theorem hcoef0 : ∀ l : Fin Nat0, D10 l - D20 l = D30 l - (D40 l - D50 l) := by
  intro l
  by_cases h0 : l.val < 60
  · exact hcoef0_c0 l (by omega) h0
  exact hcoef0_c1 l (by omega)

/-- The atoms of the first edge family of the collar. -/
theorem brC0 : ∀ p : Fin 24 × Fin 3, B0 (aC0 p) = vface (k := 1) p.2 (colTri0 p.1) := by
  rintro ⟨j, i⟩
  fin_cases j <;> fin_cases i <;>
    · funext k
      fin_cases k <;> rfl

theorem cS0_0 : (fun k => colTri0 0 k + colLam0 0) = ![slabPt (-1/2) (1/2) (1), slabPt (-1/2) (1/4) (1), slabPt (-1/4) (1/4) (1)] := by
  funext k
  fin_cases k
  · show slabPt (-1/2) (-1/2) (1) + slabPt (0) (1) (0) = slabPt (-1/2) (1/2) (1)
    rw [slabPt_add']; norm_num
  · show slabPt (-1/2) (-3/4) (1) + slabPt (0) (1) (0) = slabPt (-1/2) (1/4) (1)
