/-! ## §1  The binary biproduct of `ℤ`-modules: components and surjectivity of a lift -/

/-- The first component of an element of a binary biproduct, read through `biprodIsoProd`. -/
private theorem biprod_fst_hom_iso {B C : ModuleCat ℤ} (y : ↑(B ⊞ C)) :
    (biprod.fst : B ⊞ C ⟶ B).hom y = ((ModuleCat.biprodIsoProd B C).hom y).1 := by
  have hφinv : (ModuleCat.biprodIsoProd B C).inv ((ModuleCat.biprodIsoProd B C).hom y) = y := by
    have h := ConcreteCategory.congr_hom (CategoryTheory.Iso.hom_inv_id (ModuleCat.biprodIsoProd B C)) y
    rw [ConcreteCategory.comp_apply] at h
    simpa using h
  conv_lhs => rw [← hφinv]
  exact ModuleCat.biprodIsoProd_inv_comp_fst_apply B C _

/-- The second component of an element of a binary biproduct, read through `biprodIsoProd`. -/
private theorem biprod_snd_hom_iso {B C : ModuleCat ℤ} (y : ↑(B ⊞ C)) :
    (biprod.snd : B ⊞ C ⟶ C).hom y = ((ModuleCat.biprodIsoProd B C).hom y).2 := by
  have hφinv : (ModuleCat.biprodIsoProd B C).inv ((ModuleCat.biprodIsoProd B C).hom y) = y := by
    have h := ConcreteCategory.congr_hom (CategoryTheory.Iso.hom_inv_id (ModuleCat.biprodIsoProd B C)) y
    rw [ConcreteCategory.comp_apply] at h
    simpa using h
  conv_lhs => rw [← hφinv]
  exact ModuleCat.biprodIsoProd_inv_comp_snd_apply B C _

/-- The first component of `biprod.lift f g`, evaluated. -/
private theorem biprod_lift_fst_hom {B C M : ModuleCat ℤ} (f : M ⟶ B) (g : M ⟶ C) (x : ↑M) :
    (biprod.fst : B ⊞ C ⟶ B).hom ((biprod.lift f g).hom x) = f.hom x := by
  rw [← ConcreteCategory.congr_hom (CategoryTheory.Limits.biprod.lift_fst f g) x,
    ConcreteCategory.comp_apply]

/-- The second component of `biprod.lift f g`, evaluated. -/
private theorem biprod_lift_snd_hom {B C M : ModuleCat ℤ} (f : M ⟶ B) (g : M ⟶ C) (x : ↑M) :
    (biprod.snd : B ⊞ C ⟶ C).hom ((biprod.lift f g).hom x) = g.hom x := by
  rw [← ConcreteCategory.congr_hom (CategoryTheory.Limits.biprod.lift_snd f g) x,
    ConcreteCategory.comp_apply]

/-- `biprodIsoProd` is injective. -/
private theorem biprod_iso_hom_inj {B C : ModuleCat ℤ} :
    Function.Injective (ModuleCat.biprodIsoProd B C).hom := by
  intro u v huv
  have h1 : (ModuleCat.biprodIsoProd B C).inv ((ModuleCat.biprodIsoProd B C).hom u) = u := by
    have h := ConcreteCategory.congr_hom (CategoryTheory.Iso.hom_inv_id (ModuleCat.biprodIsoProd B C)) u
    rw [ConcreteCategory.comp_apply] at h
    simpa using h
  have h2 : (ModuleCat.biprodIsoProd B C).inv ((ModuleCat.biprodIsoProd B C).hom v) = v := by
    have h := ConcreteCategory.congr_hom (CategoryTheory.Iso.hom_inv_id (ModuleCat.biprodIsoProd B C)) v
    rw [ConcreteCategory.comp_apply] at h
    simpa using h
  rw [← h1, ← h2, huv]

/-- **Surjectivity of a binary `biprod.lift`**, in components. -/
private theorem biprod_lift_surjective_iff {B C M : ModuleCat ℤ} (f : M ⟶ B) (g : M ⟶ C) :
    Function.Surjective (biprod.lift f g).hom ↔
      ∀ (a : ↑B) (c : ↑C), ∃ x : ↑M, f.hom x = a ∧ g.hom x = c := by
  constructor
  · intro h a c
    obtain ⟨x, hx⟩ := h ((ModuleCat.biprodIsoProd B C).inv (a, c))
    have hp : (ModuleCat.biprodIsoProd B C).hom ((biprod.lift f g).hom x) = (a, c) := by
      rw [hx]
      have h2 := ConcreteCategory.congr_hom
        (CategoryTheory.Iso.inv_hom_id (ModuleCat.biprodIsoProd B C)) (a, c)
      rw [ConcreteCategory.comp_apply] at h2
      simpa using h2
    refine ⟨x, ?_, ?_⟩
    · rw [← biprod_lift_fst_hom f g x, biprod_fst_hom_iso, hp]
    · rw [← biprod_lift_snd_hom f g x, biprod_snd_hom_iso, hp]
  · intro h y
    obtain ⟨x, hx1, hx2⟩ := h ((ModuleCat.biprodIsoProd B C).hom y).1
      ((ModuleCat.biprodIsoProd B C).hom y).2
    refine ⟨x, biprod_iso_hom_inj ?_⟩
    apply Prod.ext
    · rw [← biprod_fst_hom_iso ((biprod.lift f g).hom x), biprod_lift_fst_hom]
      exact hx1
    · rw [← biprod_snd_hom_iso ((biprod.lift f g).hom x), biprod_lift_snd_hom]
      exact hx2

/-! ## §2  Functoriality of `homMap`, and the spelling of its source -/

/-- `homMap` of the identity, in the `homology` spelling of the source. -/
private theorem homMap_id (k : ℕ) (X : TopCat) :
    homMap (𝟙 X) k = 𝟙 ((Work.BridgeSquare.singCxFun.obj X).homology k) := by
  show HomologicalComplex.homologyMap
      (Work.BridgeSquare.singCxFun.map (𝟙 X)) k
    = 𝟙 ((Work.BridgeSquare.singCxFun.obj X).homology k)
  rw [Work.BridgeSquare.singCxFun.map_id X, HomologicalComplex.homologyMap_id]

/-! ## §3  The pieces of `⊔_v T²_v` and the relation `secT v = homeo ≫ incl` -/

/-- The `v`-th piece `T²_v ⊆ ⊔_v T²_v`. -/
abbrev torPiece (v : Work.Space.Cusp) : Set (Top (rt := rt)) :=
  Work.HomologyIso.sigmaPiece (fun v : Work.Space.Cusp => rt.core.Torus v) v

/-- **`secT v` is the inclusion of the `v`-th piece**, transported along the canonical
homeomorphism `T²_v ≅ {⟨v,·⟩}`. -/
theorem secT_eq_homeo_incl (v : Work.Space.Cusp) :
    Work.Homology.homeomorphTopCatHom
        (Work.HomologyIso.sigmaPieceHomeomorph (fun v : Work.Space.Cusp => rt.core.Torus v) v)
      ≫ Work.Homology.incl (torPiece (rt := rt) v) = secT (rt := rt) v := by
  apply TopCat.hom_ext
  ext x <;> try rfl

/-- The inverse relation: the inclusion of the `v`-th piece is the inverse homeomorphism followed
by `secT v`. -/
theorem inv_homeo_comp_secT (v : Work.Space.Cusp) :
    Work.Homology.homeomorphTopCatInv
        (Work.HomologyIso.sigmaPieceHomeomorph (fun v : Work.Space.Cusp => rt.core.Torus v) v)
      ≫ secT (rt := rt) v = Work.Homology.incl (torPiece (rt := rt) v) := by
  rw [← secT_eq_homeo_incl (rt := rt) v, ← Category.assoc,
    Work.Homology.homeomorphTopCatInv_comp_hom, Category.id_comp]

/-- The singular chain complex of the `v`-th piece `T²_v`. -/
abbrev torCx (v : Work.Space.Cusp) : ChainComplex (ModuleCat ℤ) ℕ :=
  Work.Homology.singChain Work.Homology.ZMod (TopCat.of (torPiece (rt := rt) v))

/-- The chain-level splitting of the singular chains of `⊔_v T²_v` over its five pieces. -/
abbrev torCxIso : CategoryTheory.Limits.biproduct
      (fun v : Work.Space.Cusp => torCx (rt := rt) v) ≅
    Work.Homology.singChain Work.Homology.ZMod (Top (rt := rt)) :=
  Work.BridgeSquare.sigmaOpenCoverChain (X := Top (rt := rt)) (V := torPiece (rt := rt))
    (fun i => Work.HomologyIso.isOpen_sigmaPiece _ i)
    (fun i j hij => Work.HomologyIso.disjoint_sigmaPiece _ hij)
    (fun x => Work.HomologyIso.exists_mem_sigmaPiece _ x) Work.Homology.ZMod

/-- **The `v`-th projection of `H_k(⊔_v T²_v)`** onto the homology of the `v`-th piece, in the
`intHomology` spelling of the target. -/
def pieceProj (v : Work.Space.Cusp) (k : ℕ) :
    LeanEval.Topology.intHomology k (Top (rt := rt)) ⟶
      LeanEval.Topology.intHomology k (TopCat.of (torPiece (rt := rt) v)) :=
  HomologicalComplex.homologyMap
    ((torCxIso (rt := rt)).inv ≫ biproduct.π (torCx (rt := rt)) v) k

/-- **The pieces generate `H_k(⊔_v T²_v)`**: a map out of it that vanishes on the image of the
inclusion of every piece is zero.

This is the chain-level splitting `∑_v π_v ∘ ι_v = 1` of the singular chains over the finite
disjoint open cover of the five tori, transported to homology. -/
private theorem eq_zero_of_comp_incl_eq_zero (k : ℕ) (N : ModuleCat ℤ)
    (φ : LeanEval.Topology.intHomology k (Top (rt := rt)) ⟶ N)
    (hφ : ∀ v : Work.Space.Cusp,
      homMap (Work.Homology.incl (torPiece (rt := rt) v)) k ≫ φ = 0) :
    φ = 0 := by
  classical
  have hdesc : (torCxIso (rt := rt)).hom = biproduct.desc (fun i =>
      Work.Homology.singChainMap Work.Homology.ZMod
        (Work.Homology.incl (torPiece (rt := rt) i))) := rfl
  have h2 : HomologicalComplex.homologyMap (torCxIso (rt := rt)).hom k
      = ∑ i, HomologicalComplex.homologyMap
            (biproduct.π (torCx (rt := rt)) i) k
          ≫ HomologicalComplex.homologyMap
              (Work.Homology.singChainMap Work.Homology.ZMod
                (Work.Homology.incl (torPiece (rt := rt) i))) k := by
    rw [hdesc, Work.Homology.biproduct_desc_eq', Work.Homology.homologyMap_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [HomologicalComplex.homologyMap_comp]
  have key_chain : (𝟙 ((Work.Homology.singChain Work.Homology.ZMod
        (Top (rt := rt))).homology k)) =
      ∑ i : Work.Space.Cusp,
        HomologicalComplex.homologyMap
            ((torCxIso (rt := rt)).inv ≫ biproduct.π (torCx (rt := rt)) i) k
          ≫ HomologicalComplex.homologyMap
              (Work.Homology.singChainMap Work.Homology.ZMod
                (Work.Homology.incl (torPiece (rt := rt) i))) k := by
    have step1 : (𝟙 ((Work.Homology.singChain Work.Homology.ZMod
          (Top (rt := rt))).homology k))
        = HomologicalComplex.homologyMap (torCxIso (rt := rt)).inv k
            ≫ HomologicalComplex.homologyMap (torCxIso (rt := rt)).hom k := by
      rw [← HomologicalComplex.homologyMap_comp, CategoryTheory.Iso.inv_hom_id,
        HomologicalComplex.homologyMap_id]
    have step2 : HomologicalComplex.homologyMap (torCxIso (rt := rt)).inv k
          ≫ HomologicalComplex.homologyMap (torCxIso (rt := rt)).hom k
        = ∑ i : Work.Space.Cusp,
            HomologicalComplex.homologyMap
                ((torCxIso (rt := rt)).inv ≫ biproduct.π (torCx (rt := rt)) i) k
              ≫ HomologicalComplex.homologyMap
                  (Work.Homology.singChainMap Work.Homology.ZMod
                    (Work.Homology.incl (torPiece (rt := rt) i))) k := by
      rw [h2, CategoryTheory.Preadditive.comp_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [← Category.assoc, ← HomologicalComplex.homologyMap_comp]
    rw [step1, step2]
  have key : (𝟙 (LeanEval.Topology.intHomology k (Top (rt := rt)))) =
      ∑ i : Work.Space.Cusp, pieceProj (rt := rt) i k
        ≫ homMap (Work.Homology.incl (torPiece (rt := rt) i)) k := key_chain
  have hgoal : φ = (∑ i : Work.Space.Cusp, pieceProj (rt := rt) i k
      ≫ homMap (Work.Homology.incl (torPiece (rt := rt) i)) k) ≫ φ := by
    conv_lhs => rw [← Category.id_comp φ]
    rw [key]
  rw [hgoal, CategoryTheory.Preadditive.sum_comp]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [Category.assoc, hφ i]
  simp

/-! ## §4  The section is null on homology -/

/-- `secMap0 = secMap secPt0` is a section of `projMap`. -/
theorem secMap0_comp_projMap :
    secMap0 (rt := rt) ≫ projMap (rt := rt) = 𝟙 (Top (rt := rt)) := by
  apply TopCat.hom_ext
  apply ContinuousMap.ext
  intro y
  exact secMap_projMap (rt := rt) secPt0 y

/-- `H_k(π) ∘ H_k(secMap0) = 1`. -/
theorem homMap_secMap0_comp_projMap (k : ℕ) :
    homMap (secMap0 (rt := rt)) k ≫ homMap (projMap (rt := rt)) k = 𝟙 _ := by
  rw [← homMap_comp, secMap0_comp_projMap]
  exact homMap_id k (Top (rt := rt))

/-- **The section is null on homology**: if `H_k(Fn v) = 0` for every cusp `v`, then
`H_k(secMap0) ∘ H_k(cuspMap) = 0`.

Indeed `H_k(Fn v) = H_k(secT v) ≫ H_k(secMap0) ≫ H_k(cuspMap)`, and `H_k(secT v)` is the
`v`-th piece inclusion up to a homeomorphism, so the hypothesis says that
`H_k(secMap0) ≫ H_k(cuspMap)` vanishes on the image of every piece — and the pieces generate
`H_k(⊔_v T²_v)` (`eq_zero_of_comp_incl_eq_zero`). -/
theorem secMap0_comp_cuspMap_eq_zero (k : ℕ)
    (hFn : ∀ v : Work.Space.Cusp, homMap (Fn (rt := rt) v) k = 0) :
    homMap (secMap0 (rt := rt)) k ≫ homMap (cuspMap (rt := rt)) k = 0 := by
  refine eq_zero_of_comp_incl_eq_zero (rt := rt) k
    (LeanEval.Topology.intHomology k (Mop (rt := rt)))
    (homMap (secMap0 (rt := rt)) k ≫ homMap (cuspMap (rt := rt)) k) ?_
  intro v
  have h1 : homMap (Work.Homology.incl (torPiece (rt := rt) v)) k
      = homMap (Work.Homology.homeomorphTopCatInv
            (Work.HomologyIso.sigmaPieceHomeomorph
              (fun v : Work.Space.Cusp => rt.core.Torus v) v)) k
        ≫ homMap (secT (rt := rt) v) k := by
    rw [← homMap_comp, inv_homeo_comp_secT]
  have h2 : homMap (secT (rt := rt) v) k
      ≫ (homMap (secMap0 (rt := rt)) k ≫ homMap (cuspMap (rt := rt)) k) = 0 := by
    rw [← hFn v,
      show Fn (rt := rt) v
        = secT (rt := rt) v ≫ (secMap0 (rt := rt) ≫ cuspMap (rt := rt)) from rfl]
    rw [homMap_comp (secT (rt := rt) v) (secMap0 (rt := rt) ≫ cuspMap (rt := rt)) k,
      homMap_comp (secMap0 (rt := rt)) (cuspMap (rt := rt)) k]
  rw [h1, Category.assoc, h2]
  simp

/-! ## §5  The cusp pair is surjective -/

/-- **The cusp pair is surjective** as soon as `H_k(τ)` is surjective and the section is null on
homology: given `(a, c)`, take `x = x₂ + H(s)(c - P x₂)` with `F x₂ = a`. -/
theorem cuspPair_surjective_of (k : ℕ)
    (hc : Function.Surjective (homMap (cuspMap (rt := rt)) k).hom)
    (hsec : homMap (secMap0 (rt := rt)) k ≫ homMap (cuspMap (rt := rt)) k = 0) :
    Function.Surjective (cuspPair (rt := rt) k).hom := by
  rw [show cuspPair (rt := rt) k
      = biprod.lift (homMap (cuspMap (rt := rt)) k) (homMap (projMap (rt := rt)) k)
        from rfl,
    biprod_lift_surjective_iff]
  intro a c
  obtain ⟨x₂, hx₂⟩ := hc a
  refine ⟨x₂ + (homMap (secMap0 (rt := rt)) k).hom
      (c - (homMap (projMap (rt := rt)) k).hom x₂), ?_, ?_⟩
  · rw [map_add, hx₂]
    have hz : (homMap (cuspMap (rt := rt)) k).hom
        ((homMap (secMap0 (rt := rt)) k).hom
          (c - (homMap (projMap (rt := rt)) k).hom x₂)) = 0 := by
      rw [← ModuleCat.comp_apply, hsec]
      rfl
    rw [hz, add_zero]
  · rw [map_add]
    have hz : (homMap (projMap (rt := rt)) k).hom
        ((homMap (secMap0 (rt := rt)) k).hom
          (c - (homMap (projMap (rt := rt)) k).hom x₂))
        = c - (homMap (projMap (rt := rt)) k).hom x₂ := by
      rw [← ModuleCat.comp_apply, homMap_secMap0_comp_projMap, ConcreteCategory.id_apply]
    rw [hz]
    abel

/-! ## §6  The degree-`3` vanishing of the torus pieces -/

/-- **`H_3(T²) = 0`** for the concrete torus `(ℝ/ℤ)²`: the standard `Δ`-structure of `T²` has
`rankT2 3 = 0`. -/
private theorem subsingleton_intHomology_three_torus :
    Subsingleton ↥(LeanEval.Topology.intHomology 3
      (TopCat.of (Fin 2 → AddCircle (1 : ℝ)))) := by
  have e := Work.PieceHomology.eT2_torus2 Work.PieceHomology.torus2RealizationData 3
  have h0 : Work.HomologyIso.rankT2 ((3 : ℕ) : ℤ) = 0 :=
    Work.HomologyIso.rankT2_eq_zero ((3 : ℕ) : ℤ) (by norm_num) (by norm_num) (by norm_num)
  haveI : Subsingleton ↥(Work.HomologyIso.ModelT2 ((3 : ℕ) : ℤ)) := by
    rw [Work.HomologyIso.ModelT2, h0]
    exact ModuleCat.isZero_iff_subsingleton.mp Work.HomologyMV.isZero_freeMod_zero
  exact Function.Surjective.subsingleton (Work.Final.function_surjective_of_iso e)

/-- **`H_3(Fn v) = 0`** for the concrete datum: the source `H_3(T²_v)` is trivial. -/
private theorem fn_homology_three_eq_zero (v : Work.Space.Cusp) :
    homMap (Fn (rt := Work.RTOwed.rtData) v) 3 = 0 := by
  haveI hsub : Subsingleton ↥(LeanEval.Topology.intHomology 3
      (TopCat.of (Work.RTOwed.rtData.core.Torus v))) :=
    subsingleton_intHomology_three_torus
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro y
  rw [Subsingleton.elim y (0 : ↥(LeanEval.Topology.intHomology 3
    (TopCat.of (Work.RTOwed.rtData.core.Torus v))))]
  simp

end

/-! ## §7  The requested theorem -/

theorem cuspPair_surjective
    (hnull : Work.BridgeSquare.SubtorusNull (rt := Work.RTOwed.rtData))
    (k : ℕ) (hk : 1 ≤ k ∧ k ≤ 3) :
    Function.Surjective
      (Work.BridgeSquare.cuspPair (rt := Work.RTOwed.rtData) k).hom := by
  refine cuspPair_surjective_of (rt := Work.RTOwed.rtData) k
    (Work.BridgeSquare.cuspMap_surjective k hk) ?_
  refine secMap0_comp_cuspMap_eq_zero (rt := Work.RTOwed.rtData) k fun v => ?_
  obtain ⟨h1, h3⟩ := hk
  interval_cases k
  · exact hnull v 1 (Or.inl rfl)
  · exact hnull v 2 (Or.inr rfl)
  · exact fn_homology_three_eq_zero v

end Work.BridgeSquare
