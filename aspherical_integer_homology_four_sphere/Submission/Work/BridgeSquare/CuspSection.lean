/-
# `BridgeSquare/CuspSection.lean` — the section `s_v` and the subtorus maps `F_v`

The last mathematical input of the Mayer–Vietoris bridge is, by `Work.BridgeSquare.mvFhat_conj_cuspPair`,
surjectivity of the cusp pair `F_k = (H_k τ, H_k π)`.  Its `A`-half needs two facts
(`Submission/Work/NOTES_LEAD_aspherical_bridge.md` §2.3–2.6):

* **(c)** `H_k τ` is surjective (`k = 1, 2, 3`);
* **(a)** `H_k(s_v) = 0` (`k = 1, 2`), where `s_v : T²_v → ⊔_v (∂[-1,1]² × T²_v)` is the section
  `y ↦ ⟨v, (p₀, y)⟩` at a basepoint `p₀` of the square boundary, composed with `τ`.

This file fixes that vocabulary:

* `secMap0` — the section at the corner `p₀ = bndOfU 0`;
* `secT v` — the `v`-th component `T²_v → ⊔_v T²_v`;
* **`Fn v`** — the composite `T²_v → M̄`, `y ↦ τ⟨v, (p₀, y)⟩`, i.e. `H_k(Fn v) = H_k(s_v)`;
* `Fn_eq` — `Fn v` is `secT v ≫ secMap0 ≫ cuspMap` (definitional), so that
  `homMap (Fn v) k = homMap (cuspMap) k ∘ homMap (secMap0) k ∘ homMap (secT v) k`;
* `Fv` — the same map in the plane coordinates of the `v`-th cusp chart,
  `Fv v y = τ⟨v, (bndOfU 0, y)⟩` for `y : Fin 2 → ℝ`;
* **`cusp_subtorus_null`** — the statement of **(a)**.
-/
import Mathlib
import Submission.Work.BridgeSquare.Data
import Submission.Work.BridgeSquare.CuspPair
import Submission.Work.PieceHomology.Torus2Chi

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false



set_option autoImplicit false
set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option maxHeartbeats 1000000

open LeanEval.Topology
open CategoryTheory CategoryTheory.Limits
open scoped Topology

namespace Work.BridgeSquare

noncomputable section

variable [rt : Work.Space.RTData]

/-- **The basepoint of the section**: the corner `bndOfU 0 = (1,1)` of the square boundary, read
as a point of `∂[-1,1]²`. -/
def secPt0 : Work.Space.Split.BdryPt :=
  ⟨⟨Work.Cusp.bndOfU 0, Work.Cusp.bndOfU_mem 0⟩, Work.Cusp.nrm_bndOfU 0⟩

/-- **The section at the corner** `⊔_v T²_v → ⊔_v (∂[-1,1]² × T²_v)`, `⟨v,y⟩ ↦ ⟨v,(p₀,y)⟩`. -/
def secMap0 : Top (rt := rt) ⟶ Cop (rt := rt) := secMap (rt := rt) secPt0

/-- The `v`-th component of `⊔_v T²_v`: `T²_v → ⊔_v T²_v`. -/
def secT (v : Work.Space.Cusp) : TopCat.of (rt.core.Torus v) ⟶ Top (rt := rt) :=
  TopCat.ofHom ⟨fun y => ⟨v, y⟩, continuous_sigmaMk⟩

/-- **The subtorus map** `F_v : T²_v → M̄`: the `v`-th component of `secMap0 ≫ cuspMap`, i.e.
`y ↦ τ⟨v, (p₀, y)⟩`.  The statement **(a)** is `homMap (Fn v) k = 0` for `k = 1, 2`. -/
def Fn (v : Work.Space.Cusp) : TopCat.of (rt.core.Torus v) ⟶ Mop (rt := rt) :=
  secT (rt := rt) v ≫ secMap0 (rt := rt) ≫ cuspMap (rt := rt)

/-- `Fn v` is the composite of the three maps, so that `H_k(Fn v)` factors. -/
theorem Fn_eq (v : Work.Space.Cusp) :
    Fn (rt := rt) v = secT (rt := rt) v ≫ secMap0 (rt := rt) ≫ cuspMap (rt := rt) := rfl

/-- **Statement (a)**: the `v`-th subtorus is null in `H_1` and `H_2` of `M̄`, i.e.
`H_k(s_v) = 0` for `k = 1, 2`. -/
def SubtorusNull : Prop :=
  ∀ (v : Work.Space.Cusp) (k : ℕ), (k = 1 ∨ k = 2) →
    homMap (Fn (rt := rt) v) k = 0

/-! ## The three boundary statements

The `Δ`-model `torus2DeltaCx` of `T²` has one vertex, the three loops `a, b, c` with
`∂(T₀) = ∂(T₁) = a + b - c`, so `H_1(T²)` is generated by `[a], [b]` and `H_2(T²)` by
`[T₀] - [T₁]`.  Since `deltaChainMap torus2RealizationData` is a quasi-isomorphism, statement (a)
reduces to **three chain-level boundary statements** for the singular chains of `M̄` below.
All of this is stated at the concrete datum `Work.RTOwed.rtData`, where `rt.core.Torus v` is `Fin 2
→ AddCircle 1` on the nose, so that the `Δ`-characteristic maps of `T²` compose with `Fn v`.
-/

/-- The singular chain of a continuous simplex of `M̄`. -/
noncomputable def singSimplex {k : ℕ}
    (g : C(Convexity.StdSimplex ℝ (Fin (k + 1)), TopCat.of Work.FoldInst.Mbar)) :
    (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X k :=
  (((TopCat.toSSet.obj (TopCat.of Work.FoldInst.Mbar)).ιChainComplex
    (R := ModuleCat.of ℤ ℤ)
    ((TopCat.toSSetObjEquiv (TopCat.of Work.FoldInst.Mbar)
      (Opposite.op (SimplexCategory.mk k))).symm g))) (1 : ℤ)

/-- The singular chain of the `σ`-th `k`-simplex of the `Δ`-model of `T²`. -/
noncomputable def chiChain (k : ℕ)
    (σ : Fin (Work.PieceHomology.torus2Card k)) :
    (singCxFun.obj Work.PieceHomology.Torus2Space).X k :=
  (((TopCat.toSSet.obj Work.PieceHomology.Torus2Space).ιChainComplex
    (R := ModuleCat.of ℤ ℤ)
    (Work.PieceHomology.torus2Chi k
      (Fin.cast (Work.PieceHomology.torus2DeltaCx_card k).symm σ)))) (1 : ℤ)

/-- The image in `M̄` of the loop `a` of the `Δ`-model of `T²`. -/
noncomputable def singA (v : Work.Space.Cusp) :
    (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 1 :=
  ((singCxFun.map (Fn (rt := Work.RTOwed.rtData) v)).f 1) (chiChain 1 (Work.PieceHomology.torus2Edge 0))

/-- The image in `M̄` of the loop `b` of the `Δ`-model of `T²`. -/
noncomputable def singB (v : Work.Space.Cusp) :
    (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 1 :=
  ((singCxFun.map (Fn (rt := Work.RTOwed.rtData) v)).f 1) (chiChain 1 (Work.PieceHomology.torus2Edge 1))

/-- The image in `M̄` of the `2`-cycle `χ_{T₀} - χ_{T₁}` of the `Δ`-model of `T²`. -/
noncomputable def singT (v : Work.Space.Cusp) :
    (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 2 :=
  ((singCxFun.map (Fn (rt := Work.RTOwed.rtData) v)).f 2) (chiChain 2 (Work.PieceHomology.torus2Tri 0))
    - ((singCxFun.map (Fn (rt := Work.RTOwed.rtData) v)).f 2) (chiChain 2 (Work.PieceHomology.torus2Tri 1))

/-- **The three boundary statements.**  Each of the three singular chains of `M̄` coming from the
`Δ`-generators of `H_1(T²)` and `H_2(T²)` is a boundary.  Proving this is the content of
`NOTES_LEAD_aspherical_bridge.md` §2.6 (G1–G4): the affine cone comparison. -/
def SubtorusBoundaries : Prop :=
  ∀ v : Work.Space.Cusp,
    (∃ c : (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 2,
      (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).d 2 1 c = singA v) ∧
    (∃ c : (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 2,
      (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).d 2 1 c = singB v) ∧
    (∃ c : (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).X 3,
      (singCxFun.obj (TopCat.of Work.FoldInst.Mbar)).d 3 2 c = singT v)

end

end Work.BridgeSquare
