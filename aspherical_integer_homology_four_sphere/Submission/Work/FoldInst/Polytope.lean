/-
# `Q̄` and the sign-change action

The truncated 24-cell `Q̄` is a compact convex subset of the open unit ball, invariant under the
group `Gg` of sign changes generated by the side pairings.  This file collects the elementary
consequences of the certificates in `Submission.Work.FoldInst.Cert` used everywhere else.
-/
import Mathlib
import Submission.Work.HypModel.Main
import Submission.Work.FoldInst.Basic
import Submission.Work.FoldInst.Cert

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open Matrix
open scoped Matrix

namespace Work.FoldInst

theorem signVec_sq (g : Fin 4 → ZMod 2) (i : Fin 4) : signVec g i * signVec g i = 1 := by
  have key : ∀ a : ZMod 2, (if a = 0 then (1 : ℤ) else -1) * (if a = 0 then (1 : ℤ) else -1) = 1 :=
    by decide
  simpa [signVec] using key (g i)

/-- The sign change acts coordinatewise by the sign vector. -/
theorem act_apply (g : Fin 4 → ZMod 2) (y : E4) :
    act g y = fun i => (signVec g i : ℝ) * y i := by
  rw [act, HypModel.rot4_diagonal]

@[simp] theorem act_apply_apply (g : Fin 4 → ZMod 2) (y : E4) (i : Fin 4) :
    act g y i = (signVec g i : ℝ) * y i := by
  rw [act_apply]

/-- The permutation of the sides is an involution. -/
theorem sidePerm_invol (g : Fin 4 → ZMod 2) (S : Fin 24) : sidePerm g (sidePerm g S) = S :=
  sideNormal_injective (by
    ext i
    rw [sideNormal_sidePerm, sideNormal_sidePerm, ← mul_assoc, signVec_sq, one_mul])

/-- The permutation of the ideal vertices is an involution. -/
theorem truncPerm_invol (g : Fin 4 → ZMod 2) (w : Fin 24) : truncPerm g (truncPerm g w) = w :=
  truncNormal2_injective (by
    ext i
    rw [truncNormal2_truncPerm, truncNormal2_truncPerm, ← mul_assoc, signVec_sq, one_mul])

theorem sideSlack_act_aux (g : Fin 4 → ZMod 2) (S : Fin 24) (y : E4) :
    sideSlack (sidePerm g S) (act g y) = sideSlack S y := by
  simp only [sideSlack]
  congr 1
  refine Finset.sum_congr rfl fun i _ => ?_
  have h : ((signVec g i : ℤ) : ℝ) * ((signVec g i : ℤ) : ℝ) = 1 := by
    exact_mod_cast signVec_sq g i
  rw [act_apply_apply, sideNormal_sidePerm, Int.cast_mul]
  calc ((signVec g i : ℤ) : ℝ) * ((sideNormal S i : ℤ) : ℝ) *
        (((signVec g i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i)
      = (((signVec g i : ℤ) : ℝ) * ((signVec g i : ℤ) : ℝ)) *
          (((sideNormal S i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i) := by ring
    _ = ((sideNormal S i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i := by rw [h, one_mul]

/-- The action of the sign change on the side slacks, in the form used for `Q̄`. -/
theorem sideSlack_act (g : Fin 4 → ZMod 2) (S : Fin 24) (y : E4) :
    sideSlack S (act g y) = sideSlack (sidePerm g S) y := by
  have h := sideSlack_act_aux g (sidePerm g S) y
  rwa [sidePerm_invol] at h

theorem truncSlack_act_aux (g : Fin 4 → ZMod 2) (w : Fin 24) (y : E4) :
    truncSlack (truncPerm g w) (act g y) = truncSlack w y := by
  have hsum : (∑ i, (truncNormal2 (truncPerm g w) i : ℝ) * (act g y : Fin 4 → ℝ) i) =
      ∑ i, (truncNormal2 w i : ℝ) * (y : Fin 4 → ℝ) i := by
    refine Finset.sum_congr rfl fun i _ => ?_
    have h : ((signVec g i : ℤ) : ℝ) * ((signVec g i : ℤ) : ℝ) = 1 := by
      exact_mod_cast signVec_sq g i
    rw [act_apply_apply, truncNormal2_truncPerm, Int.cast_mul]
    calc ((signVec g i : ℤ) : ℝ) * ((truncNormal2 w i : ℤ) : ℝ) *
          (((signVec g i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i)
        = (((signVec g i : ℤ) : ℝ) * ((signVec g i : ℤ) : ℝ)) *
            (((truncNormal2 w i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i) := by ring
      _ = ((truncNormal2 w i : ℤ) : ℝ) * (y : Fin 4 → ℝ) i := by rw [h, one_mul]
  simp only [truncSlack, hsum]

/-- The action of the sign change on the truncation slacks, in the form used for `Q̄`. -/
theorem truncSlack_act (g : Fin 4 → ZMod 2) (w : Fin 24) (y : E4) :
    truncSlack w (act g y) = truncSlack (truncPerm g w) y := by
  have h := truncSlack_act_aux g (truncPerm g w) y
  rwa [truncPerm_invol] at h

theorem act_zero (y : E4) : act 0 y = y := by
  ext i
  simp [act_apply_apply, signVec]

theorem signVec_add (g h : Fin 4 → ZMod 2) :
    signVec (g + h) = fun i => signVec g i * signVec h i := by
  funext i
  have key : ∀ a b : ZMod 2,
      (if a + b = 0 then (1 : ℤ) else -1) = (if a = 0 then 1 else -1) *
        (if b = 0 then 1 else -1) := by decide
  simpa [signVec] using key (g i) (h i)

theorem act_add (g h : Fin 4 → ZMod 2) (y : E4) :
    act g (act h y) = act (g + h) y := by
  ext i
  rw [act_apply_apply, act_apply_apply, act_apply_apply, signVec_add]
  push_cast
  ring

theorem signVec_neg (g : Fin 4 → ZMod 2) : signVec (-g) = signVec g := by
  decide +revert

theorem act_neg (g : Fin 4 → ZMod 2) (y : E4) : act (-g) y = act g y := by
  ext i
  rw [act_apply_apply, act_apply_apply, signVec_neg]

/-- `Q̄` is invariant under the sign-change action. -/
theorem Qbar_act (g : Fin 4 → ZMod 2) (y : E4) : act g y ∈ Qbar ↔ y ∈ Qbar := by
  constructor
  · intro hy
    exact ⟨fun S => by rw [← sideSlack_act_aux g S y]; exact hy.1 (sidePerm g S),
      fun w => by rw [← truncSlack_act_aux g w y]; exact hy.2 (truncPerm g w)⟩
  · intro hy
    exact ⟨fun S => by rw [sideSlack_act g S y]; exact hy.1 (sidePerm g S),
      fun w => by rw [truncSlack_act g w y]; exact hy.2 (truncPerm g w)⟩

/-- The sign-change action preserves the set of sides tight at a point. -/
theorem tight_act (g : Fin 4 → ZMod 2) (y : E4) (S : Fin 24) :
    sideSlack S (act g y) = 0 ↔ sideSlack (sidePerm g S) y = 0 := by
  rw [sideSlack_act]

/-- The type of a side is invariant under the sign change. -/
theorem sideType_sidePerm (g : Fin 4 → ZMod 2) (S : Fin 24) :
    sideType (sidePerm g S) = sideType S := by
  simp only [sideType, sideTypeIdx_sidePerm]

/-- **The identification group of a point is invariant under its own action.** -/
theorem Ksub_act (g : Fin 4 → ZMod 2) (y : E4) : Ksub (act g y) = Ksub y := by
  unfold Ksub
  congr 1
  ext γ
  constructor
  · rintro ⟨S, hS, rfl⟩
    exact ⟨sidePerm g S, (tight_act g y S).mp hS, (sideType_sidePerm g S).symm⟩
  · rintro ⟨S, hS, rfl⟩
    refine ⟨sidePerm g S, ?_, (sideType_sidePerm g S).symm⟩
    rw [sideSlack_act g (sidePerm g S) y, sidePerm_invol]
    exact hS

end Work.FoldInst
