import Mathlib
import Submission.Work.FoldInst.CertFlip
import Submission.Work.FoldInst.Voronoi

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.FoldInst

/-! ### Subset sums present a subgroup when every element has exponent two

`Gg = (Fin 4 → ZMod 2) × ZMod 2` is an elementary abelian `2`-group: `γ + γ = 0` for every `γ`
(`Gg_add_self`).  Consequently the additive subgroup generated by the values of a function
`g : Fin c → Gg` on a finite set `J` of indices is exactly the set of *subset sums*
`∑ t ∈ Δ, g t` over the subsets `Δ ⊆ J`.  This is the combinatorial heart of the description of
the identification group `Ksub`. -/

/-- **The subgroup generated by `g` on `J` is the set of subset sums.** For `g : Fin c → Gg` and a
finite set `J` of indices, `x` lies in the additive subgroup of `Gg` generated by the values
`g t`, `t ∈ J`, if and only if `x = ∑ t ∈ Δ, g t` for some `Δ ⊆ J`. -/
theorem mem_closure_image_iff {c : ℕ} (g : Fin c → Gg) (J : Finset (Fin c)) (x : Gg) :
    x ∈ AddSubgroup.closure (g '' (J : Set (Fin c))) ↔
      ∃ Δ : Finset (Fin c), Δ ⊆ J ∧ x = ∑ t ∈ Δ, g t := by
  -- A finite sum of generators is its own negative, since `Gg` has exponent two.
  have hTself : ∀ s : Finset (Fin c), (∑ t ∈ s, g t) + (∑ t ∈ s, g t) = 0 := by
    intro s
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_eq_zero (fun t _ => Gg_add_self (g t))
  -- Splitting a sum along `s = (s \ t) ∪ (s ∩ t)`.
  have hTsdiff : ∀ s t : Finset (Fin c),
      (∑ u ∈ s, g u) = (∑ u ∈ s \ t, g u) + (∑ u ∈ s ∩ t, g u) := by
    intro s t
    conv_lhs => rw [← Finset.sdiff_union_inter s t]
    rw [Finset.sum_union (Finset.disjoint_sdiff_inter s t)]
  -- Two equal summands cancel in the middle of a sum.
  have hcancel : ∀ a b cc : Gg, b + b = 0 → (a + b) + (cc + b) = a + cc := by
    intro a b cc h
    rw [show (a + b) + (cc + b) = (a + cc) + (b + b) from by abel, h, add_zero]
  constructor
  · intro hx
    induction hx using AddSubgroup.closure_induction with
    | mem y hy =>
        obtain ⟨t, htJ, rfl⟩ := hy
        exact ⟨{t}, Finset.singleton_subset_iff.mpr htJ, by simp⟩
    | zero => exact ⟨∅, by simp⟩
    | add a b ha hb iha ihb =>
        obtain ⟨s, hsJ, hs⟩ := iha
        obtain ⟨t, htJ, ht⟩ := ihb
        -- The sum of two subset sums is the subset sum over the symmetric difference.
        refine ⟨(s \ t) ∪ (t \ s), ?_, ?_⟩
        · exact Finset.union_subset (Finset.Subset.trans Finset.sdiff_subset hsJ)
            (Finset.Subset.trans Finset.sdiff_subset htJ)
        · have hdisj : Disjoint (s \ t) (t \ s) :=
            Finset.disjoint_left.mpr fun u hu1 hu2 =>
              (Finset.mem_sdiff.mp hu1).2 (Finset.mem_sdiff.mp hu2).1
          rw [hs, ht, Finset.sum_union hdisj, hTsdiff s t, hTsdiff t s,
            show (∑ u ∈ t ∩ s, g u) = ∑ u ∈ s ∩ t, g u from by rw [Finset.inter_comm]]
          exact hcancel _ _ _ (hTself (s ∩ t))
    | neg a ha iha =>
        obtain ⟨s, hsJ, hs⟩ := iha
        exact ⟨s, hsJ, by rw [hs, neg_eq_of_add_eq_zero_left (hTself s)]⟩
  · rintro ⟨Δ, hΔJ, rfl⟩
    -- Every subset sum of `J` lies in the closure.
    have key : ∀ Δ : Finset (Fin c), Δ ⊆ J →
        (∑ t ∈ Δ, g t) ∈ AddSubgroup.closure (g '' (J : Set (Fin c))) := by
      intro Δ
      induction Δ using Finset.induction with
      | empty => intro _; exact (AddSubgroup.closure _).zero_mem
      | insert a s ha ih =>
          intro hsub
          rw [Finset.sum_insert ha]
          exact AddSubgroup.add_mem _
            (AddSubgroup.subset_closure (Set.mem_image_of_mem g (hsub (Finset.mem_insert_self a s))))
            (ih fun b hb => hsub (Finset.mem_insert_of_mem hb))
    exact key Δ hΔJ

/-! ### The identification group on a Voronoi piece -/

/-- **The identification group of a point of a Voronoi piece is generated by the tight walls.**
For `x` in the Voronoi piece `Dvor i r`, a group element lies in `Ksub x` if and only if it is the
sum of the wall generators `foldGen i t` over a set `Δ` of walls that are *tight* at `x`. -/
theorem Ksub_eq_wallSum (i : Fin 98) {r : Fin (foldCodim i) → Bool} {x : Xbar}
    (hx : x ∈ Dvor i r) (γ : Gg) :
    γ ∈ Ksub x.2.1 ↔ ∃ Δ : Finset (Fin (foldCodim i)),
      (∀ t ∈ Δ, sideSlack (foldWalls i r t) x.2.1 = 0) ∧ γ = wallSum i Δ := by
  classical
  -- The set of walls of `r` that are tight at `x`.
  set J : Finset (Fin (foldCodim i)) :=
    Finset.univ.filter (fun t => sideSlack (foldWalls i r t) x.2.1 = 0) with hJdef
  have hJmem : ∀ t : Fin (foldCodim i), t ∈ J ↔ sideSlack (foldWalls i r t) x.2.1 = 0 := by
    intro t
    rw [hJdef]
    simp
  -- The identification group is the subgroup generated by the types of the tight walls.
  have hKsub : Ksub x.2.1 = AddSubgroup.closure (foldGen i '' (J : Set (Fin (foldCodim i)))) := by
    refine le_antisymm ?_ ?_
    · rw [Ksub_eq_closure x]
      apply AddSubgroup.closure_mono
      -- Every tight side is a wall of the representative (`Dvor_tight`), and its type is the
      -- corresponding wall generator (`sideType_sidePerm`).
      rintro γ ⟨S, hS, rfl⟩
      rw [tightSides_spec] at hS
      obtain ⟨t, ht⟩ := Dvor_tight i r hx hS
      refine ⟨t, ?_, ?_⟩
      · exact (hJmem t).mpr (by rw [ht]; exact hS)
      · rw [← ht]
        simp only [foldGen, foldWalls]
        exact (sideType_sidePerm (toG (foldKr i r)) (foldWallAt i t)).symm
    · rw [AddSubgroup.closure_le]
      rintro γ ⟨t, htJ, rfl⟩
      rw [Ksub_eq_closure x]
      apply AddSubgroup.subset_closure
      refine ⟨foldWalls i r t, ?_, ?_⟩
      · rw [tightSides_spec]
        exact (hJmem t).mp htJ
      · simp only [foldGen, foldWalls]
        exact (sideType_sidePerm (toG (foldKr i r)) (foldWallAt i t)).symm
  -- Convert the subgroup membership into a subset-sum statement, then into the slack condition.
  have hmem : γ ∈ Ksub x.2.1 ↔
      ∃ Δ : Finset (Fin (foldCodim i)), Δ ⊆ J ∧ γ = ∑ t ∈ Δ, foldGen i t := by
    rw [hKsub]
    exact mem_closure_image_iff (foldGen i) J γ
  rw [hmem]
  constructor
  · rintro ⟨Δ, hΔJ, hγ⟩
    exact ⟨Δ, fun t ht => (hJmem t).mp (hΔJ ht), by rw [hγ, wallSum]⟩
  · rintro ⟨Δ, hΔ, hγ⟩
    exact ⟨Δ, fun t ht => (hJmem t).mpr (hΔ t ht), by rw [hγ, wallSum]⟩

end Work.FoldInst
