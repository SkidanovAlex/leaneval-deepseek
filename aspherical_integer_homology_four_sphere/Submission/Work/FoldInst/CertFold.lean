def foldRowCheck (i : Fin 98) : Bool :=
  (List.finRange 8).all (fun j =>
    if isReal i j then
      decide (foldN2 i * foldRepD i j * diagK (foldRepK i j) = reflE (foldRepEps i j) * foldN2 i)
    else true)
