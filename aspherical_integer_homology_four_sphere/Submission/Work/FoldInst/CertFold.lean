/-
# The heavy certificate: the fold identity

Generated by `Submission/Work/FoldInst/gen_cert.py`.  This is the single expensive `decide`: the
fold identity `N_F D_r K_r = R_{ε_r} N_F` for all the representatives of the 98 fold classes.
-/
import Mathlib
import Submission.Work.FoldInst.Basic
import Submission.Work.FoldInst.Cert

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option maxRecDepth 100000
set_option maxHeartbeats 800000000

noncomputable section

open Matrix
open scoped Matrix

namespace Work.FoldInst

/-- **The fold identity** `(2N_F) D_r K_r = R_{ε_r} (2N_F)`, for every real representative. -/
def foldIdentityCheck : Bool :=
  (List.finRange 98).all (fun i => (List.finRange 8).all (fun j =>
    if isReal i j then
      decide (foldN2 i * foldRepD i j * diagK (foldRepK i j) = reflE (foldRepEps i j) * foldN2 i)
    else true))

theorem foldIdentityCheck_eq : foldIdentityCheck = true := by decide

/-- The fold identity for every real representative. -/
theorem fold_identity (i : Fin 98) (j : Fin 8) (h : isReal i j = true) :
    foldN2 i * foldRepD i j * diagK (foldRepK i j) = reflE (foldRepEps i j) * foldN2 i := by
  have h1 := (List.all_eq_true.mp foldIdentityCheck_eq) i (List.mem_finRange i)
  have h2 := (List.all_eq_true.mp h1) j (List.mem_finRange j)
  simp only [h, ite_true] at h2
  exact of_decide_eq_true h2

end Work.FoldInst
