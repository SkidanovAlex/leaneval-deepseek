/-- The fold identity for every real representative. -/
theorem fold_identity (i : Fin 98) (j : Fin 8) (h : isReal i j = true) :
    foldN2 i * foldRepD i j * diagK (foldRepK i j) = reflE (foldRepEps i j) * foldN2 i := by
  have h2 := (List.all_eq_true.mp (foldRowCheck_all i)) j (List.mem_finRange j)
  simp only [h, ite_true] at h2
  exact of_decide_eq_true h2

