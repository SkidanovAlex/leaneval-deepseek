def isReal (i : Fin 98) (j : Fin 8) : Bool :=
  (List.finRange 3).all (fun t =>
    if (j.val / 2 ^ t.val) % 2 = 1 then
      decide (foldPosIsWall i t = 1 ∧ (foldPosToWall i t : ℕ) < foldCodim i) else true)

/-- The real patterns are exactly the representatives of the sign indices. -/
theorem isReal_iff (i : Fin 98) (j : Fin 8) :
    isReal i j = true ↔ ∃ r : Fin (foldCodim i) → Bool, j = foldRepOf i r := by
  decide +revert

theorem isReal_repOf (i : Fin 98) (r : Fin (foldCodim i) → Bool) :
    isReal i (foldRepOf i r) = true :=
  (isReal_iff i _).mpr ⟨r, rfl⟩

