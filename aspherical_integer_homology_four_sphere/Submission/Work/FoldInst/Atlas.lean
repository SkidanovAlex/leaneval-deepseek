/-
# The identification groupoid `~₁` and the class atlas of `M̄`

`M̄` is the quotient of the two copies `ZMod 2 × Q̄` by the relation generated by the side pairings.
The relation is presented by the group `Gg`: a point `x = (c,y)` is identified with `γ · x` for
every `γ` in the group `Ksub y` generated by the *types* of the sides tight at `y`.  This file
proves that this relation is an equivalence relation and that it is presented by a finite class
atlas (closed domains, continuous glue maps), which gives `M̄` its `T2` structure.
-/
import Mathlib
import Submission.Work.QuotientT2.ClassAtlas
import Submission.Work.FoldInst.Basic
import Submission.Work.FoldInst.Polytope
import Submission.Work.FoldInst.Continuous

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open Matrix
open scoped Matrix

namespace Work.FoldInst

/-! ### The relation `~₁` -/

/-- The group `Gg` has exponent two. -/
theorem Gg_add_self (γ : Gg) : γ + γ = 0 := by
  refine Prod.ext ?_ ?_
  · funext i
    exact ZMod2_add_self (γ.1 i)
  · exact ZMod2_add_self γ.2

/-- The identification group of `actX γ x` is the identification group of `x`. -/
theorem Ksub_actX (γ : Gg) (x : Xbar) : Ksub (actX γ x).2.1 = Ksub x.2.1 := by
  rw [show (actX γ x).2.1 = act γ.1 x.2.1 from rfl, Ksub_act]

/-- The relation generated by the side pairings. -/
def rel (x y : Xbar) : Prop := ∃ γ ∈ Ksub x.2.1, actX γ x = y

theorem rel_refl (x : Xbar) : rel x x :=
  ⟨0, (Ksub x.2.1).zero_mem, actX_zero x⟩

theorem rel_symm {x y : Xbar} (h : rel x y) : rel y x := by
  obtain ⟨γ, hγ, rfl⟩ := h
  refine ⟨γ, ?_, ?_⟩
  · rw [Ksub_actX γ x]
    exact hγ
  · rw [actX_add, Gg_add_self, actX_zero]

theorem rel_trans {x y z : Xbar} (h1 : rel x y) (h2 : rel y z) : rel x z := by
  obtain ⟨γ, hγ, rfl⟩ := h1
  obtain ⟨η, hη, rfl⟩ := h2
  refine ⟨η + γ, ?_, ?_⟩
  · rw [Ksub_actX γ x] at hη
    exact AddSubgroup.add_mem _ hη hγ
  · rw [actX_add]

theorem rel_equivalence : Equivalence rel :=
  ⟨rel_refl, fun h => rel_symm h, fun h1 h2 => rel_trans h1 h2⟩

/-- The equivalence relation `~₁` on the two copies of `Q̄`. -/
def setoid : Setoid Xbar := ⟨rel, rel_equivalence⟩

theorem setoid_iff {x y : Xbar} : setoid x y ↔ rel x y := Iff.rfl

/-! ### The class atlas presentation -/

/-- The sides tight at a point, as a `Bool` vector. -/
def tightSides (x : Xbar) : Fin 24 → Bool := fun S => decide (sideSlack S x.2.1 = 0)

theorem tightSides_spec (x : Xbar) (S : Fin 24) :
    tightSides x S = true ↔ sideSlack S x.2.1 = 0 := by
  simp [tightSides]

theorem Ksub_eq_closure (x : Xbar) :
    Ksub x.2.1 = AddSubgroup.closure {γ : Gg | ∃ S : Fin 24, tightSides x S = true ∧
      γ = sideType S} := by
  unfold Ksub
  congr 1
  ext γ
  constructor
  · rintro ⟨S, hS, rfl⟩
    exact ⟨S, (tightSides_spec x S).mpr hS, rfl⟩
  · rintro ⟨S, hS, rfl⟩
    exact ⟨S, (tightSides_spec x S).mp hS, rfl⟩

/-- The index type of the class atlas: a group element together with a set of sides whose types
generate it. -/
def AtlasIdx := {p : Gg × (Fin 24 → Bool) //
  p.1 ∈ AddSubgroup.closure {γ : Gg | ∃ S : Fin 24, p.2 S = true ∧ γ = typeGen (sideTypeIdx S)}}

instance : Fintype AtlasIdx := by
  classical
  exact Subtype.fintype _

/-- The closed domain of an atlas index: the sides selected by `p.2` are tight. -/
def atlasDom (p : AtlasIdx) : Set Xbar := {x | ∀ S : Fin 24, p.1.2 S = true → sideSlack S x.2.1 = 0}

theorem atlasDom_closed (p : AtlasIdx) : IsClosed (atlasDom p) := by
  have h : atlasDom p = ⋂ (S : Fin 24), ⋂ (_ : p.1.2 S = true),
      {x : Xbar | sideSlack S x.2.1 = 0} := by
    ext x
    simp only [atlasDom, Set.mem_ofPred_eq, Set.mem_iInter]
  rw [h]
  refine isClosed_iInter fun S => isClosed_iInter fun hS => ?_
  exact isClosed_eq ((continuous_sideSlack S).comp
    ((continuous_subtype_val : Continuous (Subtype.val : Qbar → E4)).comp continuous_snd))
    continuous_const

/-- The glue map of an atlas index. -/
def atlasGlue (p : AtlasIdx) (x : atlasDom p) : Xbar := actX p.1.1 x.1

/-- A group element generated by the types of a set of sides belongs to `Ksub` at every point at
which those sides are tight. -/
theorem mem_Ksub_of_mem_closure {x : Xbar} {R : Fin 24 → Bool} {γ : Gg}
    (h : γ ∈ AddSubgroup.closure {γ : Gg | ∃ S : Fin 24, R S = true ∧ γ = typeGen (sideTypeIdx S)})
    (hx : ∀ S : Fin 24, R S = true → sideSlack S x.2.1 = 0) : γ ∈ Ksub x.2.1 := by
  induction h using AddSubgroup.closure_induction with
  | mem z hz =>
      obtain ⟨S, hS, rfl⟩ := hz
      exact AddSubgroup.subset_closure ⟨S, hx S hS, by simp [typeGen, sideType]⟩
  | zero => exact (Ksub x.2.1).zero_mem
  | add a b ha hb ha' hb' => exact AddSubgroup.add_mem _ ha' hb'
  | neg a ha ha' => exact AddSubgroup.neg_mem _ ha'

/-- Conversely, an element of `Ksub x` is generated by the types of the sides tight at `x`. -/
theorem mem_closure_of_mem_Ksub {x : Xbar} {γ : Gg} (h : γ ∈ Ksub x.2.1) :
    γ ∈ AddSubgroup.closure {γ : Gg | ∃ S : Fin 24, tightSides x S = true ∧
      γ = typeGen (sideTypeIdx S)} := by
  rw [Ksub_eq_closure x] at h
  induction h using AddSubgroup.closure_induction with
  | mem z hz =>
      obtain ⟨S, hS, rfl⟩ := hz
      exact AddSubgroup.subset_closure ⟨S, hS, by simp [typeGen, sideType]⟩
  | zero => exact (AddSubgroup.closure _).zero_mem
  | add a b ha hb ha' hb' => exact AddSubgroup.add_mem _ ha' hb'
  | neg a ha ha' => exact AddSubgroup.neg_mem _ ha'

theorem atlasGlue_rel (p : AtlasIdx) (x : atlasDom p) : rel x.1 (atlasGlue p x) :=
  ⟨p.1.1, mem_Ksub_of_mem_closure p.2 x.2, rfl⟩

theorem rel_iff_atlas {x y : Xbar} :
    rel x y ↔ ∃ p : AtlasIdx, ∃ hx : x ∈ atlasDom p, atlasGlue p ⟨x, hx⟩ = y := by
  constructor
  · rintro ⟨γ, hγ, rfl⟩
    exact ⟨⟨(γ, tightSides x), mem_closure_of_mem_Ksub hγ⟩,
      fun S hS => (tightSides_spec x S).mp hS, rfl⟩
  · rintro ⟨p, hx, rfl⟩
    exact atlasGlue_rel p ⟨x, hx⟩

/-- **The class atlas of `~₁`.** -/
def classAtlas : QuotientT2.ClassAtlas Xbar where
  ι := AtlasIdx
  dom := atlasDom
  dom_closed := atlasDom_closed
  glue := atlasGlue
  glue_continuous := fun p => (continuous_actX p.1.1).comp continuous_subtype_val
  rel := rel
  rel_iff := fun x y => rel_iff_atlas
  iseqv := rel_equivalence

theorem classAtlas_setoid : classAtlas.setoid = setoid := rfl

end Work.FoldInst
