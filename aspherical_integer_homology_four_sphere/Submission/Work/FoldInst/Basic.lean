/-
# The `M̄` instantiation: the space `M̄` and the fold charts

This is the *definition* file of the area `Work.FoldInst`: the truncated 24-cell `Q̄`, the group of
sign changes acting on it, the identification groupoid `~₁` of the Ratcliffe–Tschantz orientable
double cover, the quotient `M̄`, and the fold-chart data attached to the 98 face classes.

## Conventions

* `E4 = EuclideanSpace ℝ (Fin 4)`; a *Klein* model point of the 24-cell is a vector `y : E4`.
* the 24 *sides* of `Q`: the constraints `sideSlack S y = 1 - n_S · y ≥ 0` of `Q̄`;
* the 24 *truncations*: the constraints `truncSlack w y = (1 - δ_K) - p_w · y ≥ 0`, `δ_K = 1/5`, at
  the 24 ideal vertices `p_w`;
* `Qbar = {y | all the constraints hold}` (a compact convex polytope inside the open unit ball);
* `Gg = (Fin 4 → ZMod 2) × ZMod 2` is the group generated by the side pairings: the first factor is
  the Klein sign change `y ↦ (g_i y_i)`, the second factor the *copy bit* of the double cover;
  `0 ↦ +1`, `1 ↦ −1` on the first factor, and the group law is componentwise addition;
* `sidePerm g S` is the side whose normal is the sign change of `n_S`, `truncPerm g w` the ideal
  vertex obtained from `w`; `sideTypeIdx S` is the type of `S` (there are five distinct pairings)
  and `sideType S ∈ Gg` the corresponding element;
* `Ksub y` is the subgroup of `Gg` generated by the types of the sides *tight* at `y`; the relation
  `~₁` on `Xbar = ZMod 2 × Qbar` is `x ~ y ↔ ∃ γ ∈ Ksub x.2, y = γ · x`.

## Layout

* `Basic.lean` (this file): definitions and their elementary API.
* `Cert.lean` (generated): the finite checks on the tables.
* `Polytope.lean`: `Q̄` is a compact convex subset of the open ball, invariant under `Gg`.
* `Atlas.lean`: `~₁` is an equivalence relation presented by a finite class atlas.
* `Quotient.lean`: `M̄ = Xbar/~₁`, its topological instances, and the truncation set `Tset`.
* `FoldPiece.lean`, `FoldChart.lean`, `Cover.lean`: the fold charts of the blueprint's FOLD area.
-/
import Mathlib
import Submission.Work.HypModel.Main
import Submission.Work.FoldInst.Data

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open Matrix
open scoped Matrix

namespace Work.FoldInst

/-- The coordinate space of the Klein model and of the upper half space model. -/
abbrev E4 := EuclideanSpace ℝ (Fin 4)

/-! ### The constraints, `Q̄`, and the sign-change group -/

/-- The slack of the side constraint `S`: `1 − n_S · y`. -/
def sideSlack (S : Fin 24) (y : E4) : ℝ := 1 - ∑ i, (sideNormal S i : ℝ) * y i

/-- The slack of the truncation constraint at the ideal vertex `w`: `(1 − δ_K) − p_w · y`, written
with the integral table `truncNormal2 = 2 p_w` (so that the numerical certificates stay integral):
`(8 − 5·(2p_w · y))/10 = 4/5 − p_w · y`. -/
def truncSlack (w : Fin 24) (y : E4) : ℝ :=
  (8 - 5 * ∑ i, (truncNormal2 w i : ℝ) * y i) / 10

/-- **The truncated 24-cell** `Q̄`: the intersection of the 24 side and the 24 truncation
constraints. -/
def Qbar : Set E4 := {y | (∀ S, 0 ≤ sideSlack S y) ∧ (∀ w, 0 ≤ truncSlack w y)}

/-- The group generated by the side pairings: `(Fin 4 → ZMod 2)` is the Klein sign change,
`ZMod 2` the copy bit of the orientable double cover. -/
abbrev Gg := (Fin 4 → ZMod 2) × ZMod 2

/-- The sign vector `±1` of a Klein sign change (`0 ↦ +1`, `1 ↦ −1`). -/
def signVec (g : Fin 4 → ZMod 2) : Fin 4 → ℤ := fun i => if g i = 0 then 1 else -1

/-- The Klein diagonal `diag(k₀,k₁,k₂,k₃,1)` of a `±1` vector, as an integer matrix. -/
def diagK (k : Fin 4 → ℤ) : Matrix (Fin 5) (Fin 5) ℤ :=
  Matrix.diagonal fun i => if h : (i : ℕ) < 4 then k ⟨i, h⟩ else 1

/-- The reflection matrix `R_ε = diag(ε₀,ε₁,ε₂,1,1)`, as an integer matrix. -/
def reflE (e : Fin 3 → ℤ) : Matrix (Fin 5) (Fin 5) ℤ :=
  Matrix.diagonal fun i => if h : (i : ℕ) < 3 then e ⟨i, h⟩ else 1

/-- The Lorentz form matrix `J = diag(1,1,1,1,−1)` over `ℤ`. -/
def J5 : Matrix (Fin 5) (Fin 5) ℤ :=
  Matrix.diagonal fun i : Fin 5 => if (i : ℕ) < 4 then 1 else -1

/-- `A` is a Lorentz matrix: `Aᵀ J A = J`. -/
def IsLorentzZ (A : Matrix (Fin 5) (Fin 5) ℤ) : Prop := Aᵀ * J5 * A = J5

instance (A : Matrix (Fin 5) (Fin 5) ℤ) : Decidable (IsLorentzZ A) :=
  inferInstanceAs (Decidable (Aᵀ * J5 * A = J5))

/-- The same matrix over `ℚ`, scaled by `1/2` (the constant `m` clears the entries of the
normalisation). -/
def matQ (m : ℕ) (A : Matrix (Fin 5) (Fin 5) ℤ) : Matrix (Fin 5) (Fin 5) ℚ :=
  ((m : ℚ)⁻¹) • A.map (Int.castRingHom ℚ)

/-- The same matrix over `ℝ`, scaled by `1/2`. -/
def matR (m : ℕ) (A : Matrix (Fin 5) (Fin 5) ℤ) : Matrix (Fin 5) (Fin 5) ℝ :=
  ((m : ℝ)⁻¹) • A.map (Int.castRingHom ℝ)

/-- The normalisation `N_F` (the table stores `2 N_F`). -/
def foldN (i : Fin 98) : Matrix (Fin 5) (Fin 5) ℚ := matQ 2 (foldN2 i)

/-- The normalisation `N_F` over `ℝ`. -/
def foldNr (i : Fin 98) : Matrix (Fin 5) (Fin 5) ℝ := matR 2 (foldN2 i)

/-- A group element of `Gg` is determined by its action on the Klein coordinates; the
permutation tables are indexed by the encoding `g₀ + 2g₁ + 4g₂ + 8g₃`. -/
def enc (g : Fin 4 → ZMod 2) : Fin 16 :=
  ⟨(g 0).val + 2 * (g 1).val + 4 * (g 2).val + 8 * (g 3).val, by
    have h0 : (g 0).val < 2 := (g 0).isLt
    have h1 : (g 1).val < 2 := (g 1).isLt
    have h2 : (g 2).val < 2 := (g 2).isLt
    have h3 : (g 3).val < 2 := (g 3).isLt
    omega⟩

/-- The encoding of a `±1` pattern of `Fin 3` as an element of `Fin 8`. -/
def enc3 (e : Fin 3 → ℤ) : Fin 8 :=
  ⟨(if e 0 = 1 then 0 else 1) + 2 * (if e 1 = 1 then 0 else 1) +
      4 * (if e 2 = 1 then 0 else 1), by
    have h0 : (if e 0 = 1 then (0 : ℕ) else 1) < 2 := by split <;> omega
    have h1 : (if e 1 = 1 then (0 : ℕ) else 1) < 2 := by split <;> omega
    have h2 : (if e 2 = 1 then (0 : ℕ) else 1) < 2 := by split <;> omega
    omega⟩

/-- The `±1` vector of a group element. -/
def toK (g : Fin 4 → ZMod 2) : Fin 4 → ℤ := signVec g

/-- The group element of a `±1` vector. -/
def toG (k : Fin 4 → ℤ) : Fin 4 → ZMod 2 := fun i => if k i = 1 then 0 else 1

theorem toG_toK (g : Fin 4 → ZMod 2) : toG (toK g) = g := by
  funext i
  have h : ∀ x : ZMod 2, (if x = 0 then (0 : ZMod 2) else 1) = x := by decide
  simpa [toG, toK, signVec] using h (g i)

/-- The linear (Klein) action of a sign change on `E4`, as a `rot4` of a diagonal matrix. -/
def act (g : Fin 4 → ZMod 2) (y : E4) : E4 :=
  HypModel.rot4 (Matrix.diagonal fun i => (signVec g i : ℝ)) y

/-- The permutation of the sides induced by a sign change. -/
def sidePerm (g : Fin 4 → ZMod 2) (S : Fin 24) : Fin 24 := sidePermTable (enc g) S

/-- The permutation of the ideal vertices induced by a sign change. -/
def truncPerm (g : Fin 4 → ZMod 2) (w : Fin 24) : Fin 24 := truncPermTable (enc g) w

/-- The type of a side, as an element of the group `Gg`. -/
def sideType (S : Fin 24) : Gg :=
  (toG (typeGenK (sideTypeIdx S)), (typeGenFlip (sideTypeIdx S) : ZMod 2))

/-- The subgroup of `Gg` generated by the types of the sides *tight* at `y`. -/
def Ksub (y : E4) : AddSubgroup Gg :=
  AddSubgroup.closure {γ : Gg | ∃ S : Fin 24, sideSlack S y = 0 ∧ γ = sideType S}

/-! ### The 98 fold classes: the sign index and the representative data -/

set_option maxRecDepth 100000 in
theorem foldCodim_le (i : Fin 98) : foldCodim i ≤ 3 :=
  (by decide : ∀ i : Fin 98, foldCodim i ≤ 3) i

/-- The sign index `Fin c → Bool` of a fold class of codimension `c`: `true` means that the
corresponding wall coordinate is negated. -/
def foldWallSet (i : Fin 98) (t : Fin 3) : Fin 24 := foldWall i t

/-- The `i`-th wall of a fold class, for `i < codim`. -/
def foldWallAt (i : Fin 98) (t : Fin (foldCodim i)) : Fin 24 :=
  foldWall i ⟨t, by have h := t.isLt; have := foldCodim_le i; omega⟩

/-- The triple position of the `i`-th wall, for `i < codim`. -/
def foldWallPosAt (i : Fin 98) (t : Fin (foldCodim i)) : Fin 3 :=
  foldWallPos i ⟨t, by have h := t.isLt; have := foldCodim_le i; omega⟩

/-- The inclusion `Fin 3 → Fin 4` of the triple coordinates into the model coordinates. -/
def f3to4 (t : Fin 3) : Fin 4 := ⟨t, by omega⟩

/-- The inclusion `Fin 3 → Fin 5` of the triple coordinates into the matrix rows. -/
def f3to5 (t : Fin 3) : Fin 5 := ⟨t, by omega⟩

/-- The inclusion `Fin 4 → Fin 5` of the model coordinates into the matrix rows. -/
def f4to5 (t : Fin 4) : Fin 5 := ⟨t, by omega⟩

/-- The `±1` sign pattern (triple-indexed) attached to a sign index: `true` at the `t`-th wall
means that the corresponding triple coordinate is negated. -/
def foldPattern (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Fin 3 → ℤ :=
  fun j => if h : foldPosIsWall i j = 1 ∧ (foldPosToWall i j : ℕ) < foldCodim i then
      (if r ⟨foldPosToWall i j, h.2⟩ then -1 else 1) else 1

/-- The representative index `Fin 8` of a sign index. -/
def foldRepOf (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Fin 8 :=
  enc3 (foldPattern i r)

/-- The developing matrix `D_r` of a sign index. -/
def foldDr (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Matrix (Fin 5) (Fin 5) ℤ :=
  foldRepD i (foldRepOf i r)

/-- The Klein diagonal `k_r` of the identification of the representative of a sign index. -/
def foldKr (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Fin 4 → ℤ :=
  foldRepK i (foldRepOf i r)

/-- The sign vector `ε_r` of a sign index. -/
def foldEr (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Fin 3 → ℤ :=
  foldRepEps i (foldRepOf i r)

/-- The copy of the representative of a sign index. -/
def foldCr (i : Fin 98) (r : Fin (foldCodim i) → Bool) : ZMod 2 :=
  ((foldRepCopy i (foldRepOf i r) : ℤ) : ZMod 2)

/-- The walls of the representative of a sign index: the images of the root walls under `k_r`. -/
def foldWalls (i : Fin 98) (r : Fin (foldCodim i) → Bool) : Fin (foldCodim i) → Fin 24 :=
  fun t => sidePerm (toG (foldKr i r)) (foldWallAt i t)

/-- Test helper (certificate): is the eps pattern `j` a real pattern of the fold class `i`? -/
def isRealTest (i : Fin 98) (j : Fin 8) : Bool :=
  (List.finRange 3).all (fun t =>
    if (j.val / 2 ^ t.val) % 2 = 1 then
      decide (foldPosIsWall i t = 1 ∧ (foldPosToWall i t : ℕ) < foldCodim i) else true)

end Work.FoldInst
