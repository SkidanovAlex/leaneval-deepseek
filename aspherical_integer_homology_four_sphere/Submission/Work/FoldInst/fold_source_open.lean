/-
# The source of a fold chart is open in `M̄`

For a fold class `i : Fin 98` of codimension `c = foldCodim i`, the fold chart of `i` has `2^c`
*pieces*, indexed by the sign patterns `r : Fin c → Bool`.  Each piece is the image in `M̄` of the
open set `Dlift i r ⊆ Xbar` (the points of the copy `foldCr i r` of `Q̄` off the walls of the
representative, `FoldPiece.lean`).  This file proves that the union of these images is **open** —
the `hsource_open` field of the `FoldGlue` data of the blueprint's FOLD area.

The mathematical content is the *saturation* of `C = ⋃ r, Dlift i r`: the identification relation
`~₁` of `M̄` maps the chamber `Dlift i r` onto the chamber `Dlift i r'` of the reflected
representative, so that `mk ⁻¹' (mk '' C) = C`.  Since `mk` is the quotient map, `IsOpen C` gives
`IsOpen (mk '' C)`.

The combinatorial input is the group `foldH i` generated by the types of the walls: the table of
representatives satisfies, for every wall `t` and sign pattern `r`, that adding the group element
`foldGen i t` of the wall moves the "state" `(toG (foldKr i ·), foldCr i ·)` of the representative
to that of another representative (`fold_state_step`, a finite check via `decide`).
-/
import Mathlib
import Submission.Work.FoldInst.FoldPiece
import Submission.Work.FoldInst.Quotient

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

namespace Work.FoldInst

/-! ### The side permutation is a group action -/

/-- The side permutation `sidePerm` is a homomorphism in the group variable. -/
theorem sidePerm_add (g h : Fin 4 → ZMod 2) (S : Fin 24) :
    sidePerm (g + h) S = sidePerm g (sidePerm h S) := by
  apply sideNormal_injective
  ext i
  rw [sideNormal_sidePerm, sideNormal_sidePerm, sideNormal_sidePerm, signVec_add]
  ring

/-! ### The group generated by the wall types, and its action on the pieces -/

/-- The type of the `t`-th wall of the fold class `i`, as an element of `Gg`. -/
def foldGen (i : Fin 98) (t : Fin (foldCodim i)) : Gg := sideType (foldWallAt i t)

/-- The group generated by the types of the walls of the fold class `i`. -/
def foldH (i : Fin 98) : AddSubgroup Gg := AddSubgroup.closure (Set.range (foldGen i))

/-- **The piece `Dlift i r` is carried by the action of `γ` to the piece `Dlift i r'`** whenever
the "state" `(toG (foldKr i ·), foldCr i ·)` of `r'` is the `γ`-translate of that of `r`.  The
walls of `r'` are then the `γ`-images of the walls of `r`, and the slack condition transports
along `sideSlack_act`. -/
theorem actX_image_Dlift (i : Fin 98) (γ : Gg) (r r' : Fin (foldCodim i) → Bool)
    (hk : toG (foldKr i r') = γ.1 + toG (foldKr i r))
    (hc : foldCr i r' = γ.2 + foldCr i r) :
    actX γ '' Dlift i r = Dlift i r' := by
  have hwall : ∀ t : Fin (foldCodim i), sidePerm γ.1 (foldWalls i r' t) = foldWalls i r t := by
    intro t
    have harg : γ.1 + toG (foldKr i r') = toG (foldKr i r) := by
      have hgg : γ.1 + γ.1 = 0 := by ext j; exact ZMod2_add_self (γ.1 j)
      calc γ.1 + toG (foldKr i r') = γ.1 + (γ.1 + toG (foldKr i r)) := by rw [hk]
        _ = (γ.1 + γ.1) + toG (foldKr i r) := by rw [add_assoc]
        _ = toG (foldKr i r) := by rw [hgg, zero_add]
    simp only [foldWalls]
    rw [← sidePerm_add, harg]
  ext x
  constructor
  · rintro ⟨z, hz, rfl⟩
    obtain ⟨hz1, hz2⟩ := hz
    refine ⟨?_, ?_⟩
    · show z.1 + γ.2 = foldCr i r'
      rw [hc, hz1]
      abel
    · intro S hS
      rw [actX_snd, sideSlack_act]
      exact hz2 _ (fun t ht => by
        have h2 : sidePerm γ.1 (foldWalls i r' t) = sidePerm γ.1 S := by rw [hwall t]; exact ht
        have h3 : foldWalls i r' t = S := by
          have := congrArg (sidePerm γ.1) h2
          simpa [sidePerm_invol] using this
        exact hS t h3)
  · rintro hz'
    obtain ⟨hz'1, hz'2⟩ := hz'
    refine ⟨actX γ x, ?_, ?_⟩
    · refine ⟨?_, ?_⟩
      · show x.1 + γ.2 = foldCr i r
        have h2 : γ.2 + γ.2 = 0 := ZMod2_add_self γ.2
        calc x.1 + γ.2 = (γ.2 + foldCr i r) + γ.2 := by rw [hz'1, hc]
          _ = (γ.2 + γ.2) + foldCr i r := by abel
          _ = foldCr i r := by rw [h2, zero_add]
      · intro S hS
        rw [actX_snd, sideSlack_act]
        exact hz'2 _ (fun t ht => by
          have h2 : sidePerm γ.1 (foldWalls i r' t) = S := by rw [ht, sidePerm_invol]
          exact hS t ((hwall t).symm.trans h2))
    · rw [actX_add, Gg_add_self, actX_zero]

/- **The finite certificate of the fold pieces**: for every wall `t` of the fold class `i` and
every sign pattern `r`, the translate of the state `(toG (foldKr i ·), foldCr i ·)` by the wall
type `foldGen i t` is again the state of a sign pattern `r'`. -/
set_option maxHeartbeats 20000000 in
theorem fold_state_step_all :
    (∀ (i : Fin 98) (t : Fin (foldCodim i)) (r : Fin (foldCodim i) → Bool),
      ∃ r' : Fin (foldCodim i) → Bool,
        ((toG (foldKr i r') : Fin 4 → ZMod 2), foldCr i r') =
          foldGen i t + ((toG (foldKr i r) : Fin 4 → ZMod 2), foldCr i r)) := by
  decide

/-- The finite certificate of the fold pieces in usable form. -/
theorem fold_state_step (i : Fin 98) (t : Fin (foldCodim i)) (r : Fin (foldCodim i) → Bool) :
    ∃ r' : Fin (foldCodim i) → Bool,
      ((toG (foldKr i r') : Fin 4 → ZMod 2), foldCr i r') =
        foldGen i t + ((toG (foldKr i r) : Fin 4 → ZMod 2), foldCr i r) :=
  fold_state_step_all i t r

/-- **The union of the pieces is invariant under the wall group.**  If `γ` lies in the group
generated by the wall types, then it carries each piece `Dlift i r` into the union of the pieces. -/
theorem actX_foldH_image_subset (i : Fin 98) (γ : Gg) (hγ : γ ∈ foldH i)
    (r : Fin (foldCodim i) → Bool) :
    actX γ '' Dlift i r ⊆ ⋃ r' : Fin (foldCodim i) → Bool, Dlift i r' := by
  have hP : ∀ γ ∈ foldH i, ∀ r : Fin (foldCodim i) → Bool,
      actX γ '' Dlift i r ⊆ ⋃ r' : Fin (foldCodim i) → Bool, Dlift i r' := by
    intro γ hγ
    refine AddSubgroup.closure_induction (p := fun γ _ =>
      ∀ r : Fin (foldCodim i) → Bool,
        actX γ '' Dlift i r ⊆ ⋃ r' : Fin (foldCodim i) → Bool, Dlift i r') ?_ ?_ ?_ ?_ hγ
    · intro g hg r
      obtain ⟨t, rfl⟩ := hg
      obtain ⟨r', hr'⟩ := fold_state_step i t r
      have hk : toG (foldKr i r') = (foldGen i t).1 + toG (foldKr i r) := by
        simpa using congrArg Prod.fst hr'
      have hc : foldCr i r' = (foldGen i t).2 + foldCr i r := by
        simpa using congrArg Prod.snd hr'
      rw [actX_image_Dlift i (foldGen i t) r r' hk hc]
      exact Set.subset_iUnion _ r'
    · intro r
      rw [show actX (0 : Gg) = id from funext actX_zero, Set.image_id]
      exact Set.subset_iUnion _ r
    · intro x y hx hy ihx ihy r
      calc actX (x + y) '' Dlift i r
          = actX x '' (actX y '' Dlift i r) := by
            rw [Set.image_image]
            exact Set.image_congr fun z _ => (actX_add x y z).symm
        _ ⊆ actX x '' (⋃ r', Dlift i r') := Set.image_mono (ihy r)
        _ = ⋃ r', actX x '' Dlift i r' := Set.image_iUnion
        _ ⊆ ⋃ r', (⋃ r'', Dlift i r'') := Set.iUnion_mono fun r' => ihx r'
        _ ⊆ ⋃ r'', Dlift i r'' := by
              intro z hz
              obtain ⟨r', hz'⟩ := Set.mem_iUnion.mp hz
              exact hz'
    · intro x hx ih r
      rw [show actX (-x) = actX x from funext (actX_neg x)]
      exact ih r
  exact hP γ hγ r

/-! ### Saturation of the union of the pieces -/

/-- The identification group of a point of a piece is contained in the wall group. -/
theorem Ksub_le_foldH (i : Fin 98) {x : Xbar}
    (hx : x ∈ ⋃ r : Fin (foldCodim i) → Bool, Dlift i r) :
    Ksub x.2.1 ≤ foldH i := by
  obtain ⟨r, hr⟩ := Set.mem_iUnion.mp hx
  obtain ⟨hr1, hr2⟩ := hr
  rw [Ksub_eq_closure]
  apply AddSubgroup.closure_mono
  rintro γ ⟨S, hS, rfl⟩
  rw [tightSides_spec] at hS
  have hwall : ∃ t : Fin (foldCodim i), foldWalls i r t = S := by
    by_contra h
    exact absurd hS (ne_of_gt (hr2 S (fun t ht => h ⟨t, ht⟩)))
  obtain ⟨t, ht⟩ := hwall
  refine ⟨t, ?_⟩
  rw [foldGen, ← ht, foldWalls]
  exact (sideType_sidePerm (toG (foldKr i r)) (foldWallAt i t)).symm

/-- The union of the pieces is saturated for the identification relation `~₁`. -/
theorem mem_foldC_of_rel (i : Fin 98) {z x : Xbar}
    (hz : z ∈ ⋃ r : Fin (foldCodim i) → Bool, Dlift i r) (h : rel z x) :
    x ∈ ⋃ r : Fin (foldCodim i) → Bool, Dlift i r := by
  obtain ⟨γ, hγ, rfl⟩ := h
  obtain ⟨r, hr⟩ := Set.mem_iUnion.mp hz
  exact actX_foldH_image_subset i γ (Ksub_le_foldH i hz hγ) r ⟨z, hr, rfl⟩

/-! ### The source is open -/

theorem fold_source_open (i : Fin 98) :
    IsOpen (⋃ r : Fin (foldCodim i) → Bool, mk '' Dlift i r) := by
  have hpre : mk ⁻¹' (⋃ r : Fin (foldCodim i) → Bool, mk '' Dlift i r)
      = (⋃ r : Fin (foldCodim i) → Bool, Dlift i r) := by
    ext x
    simp only [Set.mem_preimage, Set.mem_iUnion, Set.mem_image]
    constructor
    · rintro ⟨r, z, hz, hzx⟩
      exact Set.mem_iUnion.mp
        (mem_foldC_of_rel i (Set.mem_iUnion.mpr ⟨r, hz⟩) (Quotient.eq.mp hzx))
    · rintro ⟨r, hr⟩
      exact ⟨r, x, hr, rfl⟩
  refine isOpen_quotient_iff_preimage.mpr ?_
  rw [hpre]
  exact isOpen_iUnion (fun r => isOpen_Dlift i r)

end Work.FoldInst
