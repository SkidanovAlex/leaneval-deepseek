import Mathlib
import Submission.Work.RTOwed.sideSlack_pos_of_not_wall
import Submission.Work.RTOwed.wallLo_slack_sign
import Submission.Work.RTOwed.wallHi_slack_sign
import Submission.Work.RTOwed.cuspCert.CuspSupport
import Submission.Work.RTOwed.chartKlein_mem

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.RTOwed

-- in namespace Work.RTOwed (file Submission/Work/RTOwed/Ksub_chartKlein_le.lean)
/-- The subgroup generated by the sides tight at the cube chart point of `a` at the cube coordinate
`u` (in the half-open unit box of `a`) and the height `s ∈ [11/10, ceilH a u]` is generated by the
*lower* walls of the *pinned* coordinates of `u`.  This is the version at an arbitrary height of
`Work.RTOwed.cuspCert.Ksub_le_spanFin` (which is the ceiling point `kleinPt a u`), proved from
`Work.RTOwed.sideSlack_pos_of_not_wall` (the non-wall sides are strictly positive) together with the
sign laws `wallLo_slack_sign` / `wallHi_slack_sign` for the wall sides; the route is the one of
`Work.RTOwed.cuspCert.tight_is_wall` and `Work.RTOwed.cuspCert.Ksub_le_spanFin` in
`Submission/Work/RTOwed/cuspCert/CuspSupport.lean`. -/
theorem Ksub_chartKlein_le (a : Fin 48) {u : CuspE3} (hu : u ∈ cuspCert.halfopenBox a)
    {s : ℝ} (hs1 : 11 / 10 ≤ s) (hs2 : s ≤ ceilH a u) :
    Work.FoldInst.Ksub (chartKlein a (mkE4 u s)) ≤ cuspCert.spanSub a (cuspCert.pinned a u) := by
  have huBox : u ∈ cubeBox a := cuspCert.halfopenBox_subset_cubeBox a hu
  have hmem : chartKlein a (mkE4 u s) ∈ Work.FoldInst.Qbar := chartKlein_mem a huBox hs1 hs2
  have hbox : ∀ j : Fin 3, (Work.Cusp.cubeCorner a j : ℝ) - 1 ≤ u j
      ∧ u j ≤ (Work.Cusp.cubeCorner a j : ℝ) + 2 := by
    intro j
    have h := hu j
    exact ⟨by linarith [h.1], by linarith [h.2]⟩
  rw [Work.FoldInst.Ksub_eq_closure
    (⟨(0 : ZMod 2), ⟨chartKlein a (mkE4 u s), hmem⟩⟩ : Work.FoldInst.Xbar)]
  refine (AddSubgroup.closure_le (cuspCert.spanSub a (cuspCert.pinned a u))).mpr ?_
  rintro γ ⟨S, hS, rfl⟩
  have hS0 : Work.FoldInst.sideSlack S (chartKlein a (mkE4 u s)) = 0 :=
    (Work.FoldInst.tightSides_spec
      (⟨(0 : ZMod 2), ⟨chartKlein a (mkE4 u s), hmem⟩⟩ : Work.FoldInst.Xbar) S).mp hS
  have hcases : (∃ i : Fin 3, S = wallLo a i) ∨ (∃ i : Fin 3, S = wallHi a i) := by
    by_contra h
    have h1 : ∀ i : Fin 3, S ≠ wallLo a i := fun i hi => h (Or.inl ⟨i, hi⟩)
    have h2 : ∀ i : Fin 3, S ≠ wallHi a i := fun i hi => h (Or.inr ⟨i, hi⟩)
    have hpos : 0 < Work.FoldInst.sideSlack S (chartKlein a (mkE4 u s)) :=
      sideSlack_pos_of_not_wall a huBox hs1 hs2 fun i => ⟨h1 i, h2 i⟩
    linarith
  rcases hcases with ⟨i, rfl⟩ | ⟨i, rfl⟩
  · have hpin : i ∈ cuspCert.pinned a u :=
      (cuspCert.mem_pinned).mpr ((wallLo_slack_sign a i hs1 hbox).2.1.mp hS0)
    simpa [cuspCert.spanSub, cuspCert.wGen, cuspCert.wType, Work.FoldInst.sideType,
      Work.FoldInst.typeGen] using cuspCert.wGen_mem_spanFin a hpin
  · have hcontra : u i = (Work.Cusp.cubeCorner a i : ℝ) + 1 :=
      (wallHi_slack_sign a i hs1 hbox).2.1.mp hS0
    linarith [(hu i).2]

end Work.RTOwed
