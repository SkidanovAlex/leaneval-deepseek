/-
# The displacement lattice of the junction charts of `M̂`

The junction charts `Work.RTOwed.jChart a D v P` (`Submission/Work/RTOwed/FillAtlas.lean`) are
indexed by the pinning data `Work.RTOwed.JPin a v`; two of them describe the *same* polar
coordinate of the filling piece of the cusp `v`, so that the transition of two junction charts of
one cusp is the change of the lift of the polar coordinate, i.e. a translation of the coordinate
space `E4` by a vector of the **displacement lattice**

`jlVec v n m = (0, 2π(n + ⟪cuspY v μ(m), σ_v⟫/‖σ_v‖²), (wOf v μ(m))₀, (wOf v μ(m))₁)`.

Written out, the lattice is generated by

* `(0, 2π, 0, 0)`: the shift `θ ↦ θ + 2π` of the angle coordinate, which changes the perimeter
  parameter by an integer and is invisible to `bndOfU` and to the ceiling `β ∘ cuspX`
  (`Work.Cusp.cuspInvInner_add_int_mul_two_pi`);
* the two `w`-shifts `(0, 2π⟪cuspY v e_i, σ_v⟫/‖σ_v‖², (wOf v e_i)₀, (wOf v e_i)₁)`, which change
  the torus lift `y ↦ y + e_i` of the filling piece, i.e. the class of `y` in `(ℝ/ℤ)²`, while
  keeping the point of `M̂` fixed.

The `θ`-component is forced: shifting the torus lift `y ↦ y + μ(m)` changes the recovered
perimeter coordinate `uqOf v q` by `−⟪cuspY v μ(m), σ_v⟫/‖σ_v‖²`, so the angle coordinate must
compensate by `2π` times that amount in order to leave the edge point `t • bndOfU u` of the
filling square unchanged.

This file fixes the vocabulary and the elementary algebra of `jlVec` (its coordinates, linearity,
non-degeneracy), which is used by the fiber computations of the junction coordinate inclusion and
by the proof of `Work.RTOwed.jTrans_same`.
-/
import Mathlib
import Submission.Work.RTOwed.FillAtlas

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open Set Topology Function
open scoped Real InnerProductSpace

namespace Work.RTOwed

open Work.Cusp

/-! ## The real vector of an integer pair -/

/-- The real vector `(m 0, m 1)` of an integer pair. -/
def jLreal (m : Fin 2 → ℤ) : E2 := !₂[(m 0 : ℝ), (m 1 : ℝ)]

@[simp] theorem jLreal_apply (m : Fin 2 → ℤ) (i : Fin 2) : jLreal m i = (m i : ℝ) := by
  fin_cases i <;> rfl

@[simp] theorem jLreal_zero : jLreal (0 : Fin 2 → ℤ) = 0 := by
  ext i
  fin_cases i <;> simp [jLreal]

theorem jLreal_add (m m' : Fin 2 → ℤ) : jLreal (m + m') = jLreal m + jLreal m' := by
  ext i
  fin_cases i <;> simp [jLreal]

theorem jLreal_neg (m : Fin 2 → ℤ) : jLreal (-m) = -jLreal m := by
  ext i
  fin_cases i <;> simp [jLreal]

theorem jLreal_sub (m m' : Fin 2 → ℤ) : jLreal (m - m') = jLreal m - jLreal m' := by
  ext i
  fin_cases i <;> simp [jLreal]

theorem jLreal_eq_zero {m : Fin 2 → ℤ} (h : jLreal m = 0) : m = 0 := by
  funext i
  have h1 : (m i : ℝ) = 0 := by
    have h2 := congrArg (fun y : E2 => y i) h
    rw [jLreal_apply] at h2
    simpa using h2
  exact_mod_cast h1

/-! ## Linearity of the cusp coordinates `cuspY` and `wOf` -/

@[simp] theorem cuspY_zero (v : Work.Space.Cusp) : cuspY v (0 : E2) = 0 := by
  ext i
  fin_cases i <;> simp [cuspY]

@[simp] theorem wOf_zero (v : Work.Space.Cusp) : wOf v (0 : E2) = 0 := by
  ext i
  fin_cases i <;> simp [wOf]

theorem cuspY_neg (v : Work.Space.Cusp) (y : E2) : cuspY v (-y) = -cuspY v y := by
  ext i
  fin_cases i <;> simp [cuspY] <;> ring

theorem cuspY_sub (v : Work.Space.Cusp) (y y' : E2) :
    cuspY v (y - y') = cuspY v y - cuspY v y' := by
  ext i
  fin_cases i <;> simp [cuspY] <;> ring

theorem wOf_neg (v : Work.Space.Cusp) (y : E2) : wOf v (-y) = -wOf v y := by
  ext i
  fin_cases i <;> simp [wOf, cuspY_neg]

theorem wOf_sub (v : Work.Space.Cusp) (y y' : E2) : wOf v (y - y') = wOf v y - wOf v y' := by
  rw [sub_eq_add_neg, wOf_add, wOf_neg, sub_eq_add_neg]

/-! ## The displacement vector -/

/-- **The displacement lattice vector of the junction charts**: the change of the polar
coordinates `(r,θ,w₁,w₂)` of a point of the filling piece of the cusp `v` that leaves the point of
`M̂` unchanged (a change of the lift of the perimeter coordinate by the integer `n` together with a
change of the torus lift by `m`, the angle coordinate compensating for the shift of the recovered
perimeter coordinate). -/
def jlVec (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) : E4 :=
  !₂[0, 2 * π * ((n : ℝ) + ⟪cuspY v (jLreal m), slope v⟫_ℝ / ‖slope v‖ ^ 2),
    wOf v (jLreal m) 0, wOf v (jLreal m) 1]

@[simp] theorem jlVec_apply_zero (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    (jlVec v n m) 0 = 0 := rfl

@[simp] theorem jlVec_apply_one (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    (jlVec v n m) 1
      = 2 * π * ((n : ℝ) + ⟪cuspY v (jLreal m), slope v⟫_ℝ / ‖slope v‖ ^ 2) := rfl

@[simp] theorem jlVec_apply_two (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    (jlVec v n m) 2 = wOf v (jLreal m) 0 := rfl

@[simp] theorem jlVec_apply_three (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    (jlVec v n m) 3 = wOf v (jLreal m) 1 := rfl

/-- The `θ`-coordinate of the displacement, split into its two parts. -/
theorem jlVec_one_eq (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    (jlVec v n m) 1
      = 2 * π * (n : ℝ)
        + 2 * π * (⟪cuspY v (jLreal m), slope v⟫_ℝ / ‖slope v‖ ^ 2) := by
  rw [jlVec_apply_one]
  ring

theorem jlVec_zero (v : Work.Space.Cusp) : jlVec v 0 0 = 0 := by
  apply WithLp.ofLp_injective
  funext i
  fin_cases i <;> simp [jlVec]

/-- **The group law of the displacement lattice**: the sum of the displacements of `(n,m)` and
`(n',m')` is the displacement of `(n+n', m+m')`. -/
theorem jlVec_add (v : Work.Space.Cusp) (n n' : ℤ) (m m' : Fin 2 → ℤ) :
    jlVec v n m + jlVec v n' m' = jlVec v (n + n') (m + m') := by
  apply WithLp.ofLp_injective
  funext i
  fin_cases i <;>
    simp only [jlVec, PiLp.add_apply, jLreal_add, cuspY_add, wOf_add, inner_add_left] <;>
    push_cast <;> ring_nf

theorem jlVec_neg (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    jlVec v (-n) (-m) = -jlVec v n m := by
  have h := jlVec_add v (-n) n (-m) m
  rw [neg_add_cancel, neg_add_cancel, jlVec_zero] at h
  exact eq_neg_of_add_eq_zero_left h

theorem jlVec_sub (v : Work.Space.Cusp) (n n' : ℤ) (m m' : Fin 2 → ℤ) :
    jlVec v n m - jlVec v n' m' = jlVec v (n - n') (m - m') := by
  rw [sub_eq_add_neg, ← jlVec_neg, sub_eq_add_neg]
  exact jlVec_add v n (-n') m (-m')

/-- **Non-degeneracy**: the displacement `jlVec v n m` vanishes only for `(n,m) = 0`. -/
theorem jlVec_eq_zero_iff (v : Work.Space.Cusp) (n : ℤ) (m : Fin 2 → ℤ) :
    jlVec v n m = 0 ↔ n = 0 ∧ m = 0 := by
  constructor
  · intro h
    have hw : wOf v (jLreal m) = 0 := by
      ext i
      fin_cases i
      · simpa using congrArg (fun x : E4 => x 2) h
      · simpa using congrArg (fun x : E4 => x 3) h
    have hm : jLreal m = 0 := by
      rw [← invY_wOf v (jLreal m), hw]
      simp [invY]
    have hm0 : m = 0 := jLreal_eq_zero hm
    have h1 : (jlVec v n m) 1 = 0 := by rw [h]; rfl
    rw [jlVec_apply_one, hm0, jLreal_zero, cuspY_zero] at h1
    simp only [inner_zero_left, zero_div, add_zero] at h1
    have hne : (2 : ℝ) * π ≠ 0 := by positivity
    have hn : (n : ℝ) = 0 := by
      rcases mul_eq_zero.mp h1 with h2 | h2
      · exact absurd h2 hne
      · exact h2
    exact ⟨by exact_mod_cast hn, hm0⟩
  · rintro ⟨rfl, rfl⟩
    exact jlVec_zero v

/-! ## Two elementary facts used by the fiber computations -/

/-- **The value of the inner cusp inverse on the inner branch**: for `q 0 ≤ r_J` the recovered
point of the filling square is `t • bndOfU (uqOf v q)` with `t = q 0/(2 r_J)`, and the recovered
torus coordinates are `y = invY v (q 2, q 3)`. -/
theorem cuspInvInner_le (v : Work.Space.Cusp) {q : E4} (h : q 0 ≤ rJ) :
    cuspInvInner v q
      = ((q 0 / (2 * rJ)) • bndOfU (uqOf v q), invY v (!₂[q 2, q 3] : E2)) := by
  simp only [cuspInvInner, ite_eq_left h, uqOf]
  congr 1
  congr 1
  ring

/-- **The equality of two classes in `ℝ/ℤ`**: the classes of `x` and `y` coincide iff `x − y` is an
integer. -/
theorem addCircle_coe_eq_iff (x y : ℝ) :
    ((x : AddCircle (1 : ℝ)) = (y : AddCircle (1 : ℝ))) ↔ ∃ k : ℤ, x - y = (k : ℝ) := by
  rw [← sub_eq_zero, ← AddCircle.coe_sub, AddCircle.coe_eq_zero_iff]
  constructor
  · rintro ⟨n, hn⟩
    exact ⟨n, by simpa using hn.symm⟩
  · rintro ⟨n, hn⟩
    exact ⟨n, by simpa using hn.symm⟩

end Work.RTOwed
