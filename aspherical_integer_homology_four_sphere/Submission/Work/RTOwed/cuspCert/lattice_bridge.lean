import Mathlib
import Submission.Work.RTOwed.cuspDev

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The lattice bridge of the concrete cusp development

This file proves `lattice_bridge`, the conjunction of the two "algebraic" certificates of the cusp
development `Submission/Work/RTOwed/cuspDev.lean`:

* `Work.Cusp.lattice v = {z | latVec v z}`: the cusp lattice `Λ_v = ⟨κ_{v,1}, κ_{v,2}, κ_{v,3}⟩`,
  defined as the additive subgroup generated by the three vectors `kv v i`, is the diagonal lattice
  `diag (latMod v) · ℤ³` of the data table;
* `latVec v l → mbarPt v (x + l) = mbarPt v x`: the ceiling map `mbarPt v` is invariant under
  `Λ_v`.

The mathematical content is: `kappa` is a `ℤ`-basis of `diag (latMod v) · ℤ³` (a finite check on
the integer tables `Data.lean`), the lattice membership `latVec` is an additive subgroup, and the
cube index `cubeOfMod` depends only on the residues `⌊x⌋ᵢ mod latMod v i` (again a finite check on
the table); the remaining step is the floor identity `⌊xᵢ + m⌋ = ⌊xᵢ⌋ + m` for `m ∈ ℤ`.
-/

noncomputable section

open Set Topology Function

namespace Work.RTOwed.cuspCert

/-! ### The cube index depends only on the residues of the floor vector -/

/-- **The cube index is invariant under the lattice `diag (latMod v) · ℤ³`**: adding to the
floor vector a vector whose `i`-th coordinate is a multiple of `latMod v i` does not change
`cubeOfMod v`.  This is a finite check on the table `Work.Cusp.cubeOfMod` (whose `i`-th branch
tests only `p i % latMod v i`). -/
theorem cubeOfMod_add_latMod (v : Fin 5) (p c : Fin 3 → ℤ) :
    Work.Cusp.cubeOfMod v (fun i => p i + (Work.Cusp.latMod v i : ℤ) * c i) =
      Work.Cusp.cubeOfMod v p := by
  fin_cases v <;> simp [Work.Cusp.cubeOfMod, Work.Cusp.latMod]

/-! ### The cusp lattice in coordinates -/

/-- The `i`-th standard basis vector of `E3`. -/
def eVec (i : Fin 3) : CuspE3 := PiLp.single 2 i (1 : ℝ)

/-- `-(kv v j)` lies in the cusp lattice `Λ_v`. -/
theorem neg_kv_mem (v : Fin 5) (j : Fin 3) : -(Work.Cusp.kv v j) ∈ Work.Cusp.lattice v :=
  AddSubgroup.neg_mem _ (AddSubgroup.subset_closure ⟨j, rfl⟩)

/-- A vector equal to `-(kv v j)` lies in `Λ_v`. -/
theorem mem_of_eq_neg {v : Fin 5} {w : CuspE3} {j : Fin 3}
    (h : w = -(Work.Cusp.kv v j)) : w ∈ Work.Cusp.lattice v := by
  rw [h]; exact neg_kv_mem v j

/-- **`latMod v i • eᵢ ∈ Λ_v`**: the diagonal entries of the data table are lattice vectors.
This is the finite check that `kappa` generates the full diagonal lattice; each of the three
elementary vectors is one of the `κ_{v,j}` up to sign. -/
theorem latMod_smul_eVec_mem (v : Fin 5) (i : Fin 3) :
    (Work.Cusp.latMod v i : ℝ) • eVec i ∈ Work.Cusp.lattice v := by
  fin_cases v
  · fin_cases i
    · refine mem_of_eq_neg (v := 0) (j := 2) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 0) (j := 0) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 0) (j := 1) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
  · fin_cases i
    · refine mem_of_eq_neg (v := 1) (j := 0) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 1) (j := 2) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 1) (j := 1) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
  · fin_cases i
    · refine mem_of_eq_neg (v := 2) (j := 2) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 2) (j := 1) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 2) (j := 0) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
  · fin_cases i
    · refine mem_of_eq_neg (v := 3) (j := 2) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 3) (j := 0) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 3) (j := 1) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
  · fin_cases i
    · refine mem_of_eq_neg (v := 4) (j := 2) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 4) (j := 1) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]
    · refine mem_of_eq_neg (v := 4) (j := 0) ?_
      apply PiLp.ext; intro j; fin_cases j <;>
        simp [eVec, Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod, PiLp.smul_apply]

/-- Each generator `kv v i` of the lattice satisfies the coordinate divisibility `latVec v`. -/
theorem kv_latVec (v : Fin 5) (i : Fin 3) : latVec v (Work.Cusp.kv v i) := by
  intro j
  refine ⟨(Work.Cusp.kappa v i j : ℤ) / (Work.Cusp.latMod v j : ℤ), ?_⟩
  fin_cases v <;> fin_cases i <;> fin_cases j <;>
    norm_num [Work.Cusp.kv, Work.Cusp.kappa, Work.Cusp.latMod]

/-- The coordinate form `latVec v` as an additive subgroup. -/
def latSub (v : Fin 5) : AddSubgroup CuspE3 where
  carrier := {z | latVec v z}
  zero_mem' := by intro i; exact ⟨0, by simp⟩
  add_mem' := by
    intro z w hz hw i
    obtain ⟨a, ha⟩ := hz i
    obtain ⟨b, hb⟩ := hw i
    exact ⟨a + b, by rw [PiLp.add_apply, ha, hb]; push_cast; ring⟩
  neg_mem' := by
    intro z hz i
    obtain ⟨a, ha⟩ := hz i
    exact ⟨-a, by rw [PiLp.neg_apply, ha]; push_cast; ring⟩

/-- **The coordinate form generates the whole lattice**: any `z` with coordinatewise divisibility
by `latMod v` is an integer combination of the `latMod v i • eᵢ`, hence lies in `Λ_v`. -/
theorem mem_lattice_of_latVec (v : Fin 5) {z : CuspE3} (hz : latVec v z) :
    z ∈ Work.Cusp.lattice v := by
  choose k hk using hz
  have hz' : z = ∑ i : Fin 3, (k i) • ((Work.Cusp.latMod v i : ℝ) • eVec i) := by
    apply PiLp.ext; intro j
    rw [hk j]
    fin_cases j <;> simp [eVec, PiLp.smul_apply, Fin.sum_univ_three] <;> ring
  rw [hz']
  exact AddSubgroup.sum_mem _ fun i _ =>
    AddSubgroup.zsmul_mem _ (latMod_smul_eVec_mem v i) (k i)

/-- **`Λ_v = diag (latMod v) · ℤ³`**: the cusp lattice is the diagonal lattice of the data. -/
theorem lattice_eq (v : Fin 5) :
    (Work.Cusp.lattice v : Set CuspE3) = {z | latVec v z} := by
  ext z
  constructor
  · intro hz
    exact (AddSubgroup.closure_le (latSub v)).mpr (fun u hu => by
      obtain ⟨i, rfl⟩ := hu
      exact kv_latVec v i) hz
  · intro hz
    exact mem_lattice_of_latVec v hz

/-! ### Lattice shifts of the cusp coordinates -/

/-- The lattice vector with integer coordinates `L`, as an element of `E3`. -/
def intVec (L : Fin 3 → ℤ) : CuspE3 := WithLp.toLp 2 fun i => (L i : ℝ)

theorem intVec_apply (L : Fin 3 → ℤ) (i : Fin 3) : intVec L i = (L i : ℝ) := rfl

/-- The floor vector of `x + intVec L` is the floor vector of `x` plus `L`. -/
theorem floorV_intVec (x : CuspE3) (L : Fin 3 → ℤ) :
    floorV (x + intVec L) = fun i => floorV x i + L i := by
  funext i
  simp only [floorV, PiLp.add_apply, intVec_apply, Int.floor_add_intCast]

/-- The cube index of `x + intVec L`. -/
theorem cubeOf_intVec (v : Fin 5) (x : CuspE3) (L : Fin 3 → ℤ) :
    cubeOf v (x + intVec L) = Work.Cusp.cubeOfMod v (fun i => floorV x i + L i) := by
  simp only [cubeOf, floorV_intVec]

/-- **The cube index is `Λ_v`-periodic.** -/
theorem cubeOf_intVec_lat (v : Fin 5) (x : CuspE3) (c : Fin 3 → ℤ) :
    cubeOf v (x + intVec (fun i => (Work.Cusp.latMod v i : ℤ) * c i)) = cubeOf v x := by
  rw [cubeOf_intVec, cubeOfMod_add_latMod]
  rfl

/-- **The reduced representative is `Λ_v`-periodic**: if the cube index is unchanged, then
`redV v (x + intVec L) = redV v x`. -/
theorem redV_intVec_of (v : Fin 5) (x : CuspE3) (L : Fin 3 → ℤ)
    (h : cubeOf v (x + intVec L) = cubeOf v x) :
    redV v (x + intVec L) = redV v x := by
  apply PiLp.ext; intro i
  simp only [redV, WithLp.ofLp_toLp, PiLp.add_apply, intVec_apply, Int.floor_add_intCast, h]
  push_cast
  ring

/-- `cuspPtX v` depends only on `cubeOf v ·` and `redV v ·`. -/
theorem cuspPtX_congr (v : Fin 5) {x x' : CuspE3}
    (h1 : cubeOf v x = cubeOf v x') (h2 : redV v x = redV v x') :
    cuspPtX v x = cuspPtX v x' := by
  unfold cuspPtX
  rw [h1, h2]

/-- **`mbarPt v` is invariant under the cusp lattice `Λ_v`.** -/
theorem mbarPt_latVec (v : Fin 5) (x l : CuspE3) (hl : latVec v l) :
    mbarPt v (x + l) = mbarPt v x := by
  choose c hc using hl
  have hL : l = intVec (fun i => (Work.Cusp.latMod v i : ℤ) * c i) := by
    apply PiLp.ext; intro i
    rw [hc i, intVec_apply]
    push_cast
    ring
  rw [hL]
  exact congrArg Work.FoldInst.mk
    (cuspPtX_congr v (cubeOf_intVec_lat v x c) (redV_intVec_of v x _ (cubeOf_intVec_lat v x c)))

/-! ### The bridge -/

theorem lattice_bridge :
    (∀ v : Fin 5,
      (Work.Cusp.lattice v : Set Work.RTOwed.CuspE3) = {z | Work.RTOwed.latVec v z}) ∧
    (∀ (v : Fin 5) (x l : Work.RTOwed.CuspE3), Work.RTOwed.latVec v l →
      Work.RTOwed.mbarPt v (x + l) = Work.RTOwed.mbarPt v x) :=
  ⟨lattice_eq, mbarPt_latVec⟩

end Work.RTOwed.cuspCert
