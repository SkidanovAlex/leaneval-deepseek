/-! ## The finite checks on the gluing data -/

theorem gOf_gIdx : ∀ (γ : Work.FoldInst.Gg), gOf (gIdx γ) = γ := by decide +kernel

theorem sG_gIdx : ∀ (γ : Work.FoldInst.Gg), sG (gIdx γ) = γ.1 := by decide +kernel

theorem sFlip_gIdx : ∀ (γ : Work.FoldInst.Gg), sFlip (gIdx γ) = γ.2 := by decide +kernel

theorem tgt_spec_c0 : ∀ (a : Fin 48) (idx : Fin 32), 0 ≤ a.val → a.val < 12 → (cubeVert (tgt a idx) = Work.FoldInst.truncPerm (sG idx) (cubeVert a)
      ∧ cubeBit (tgt a idx) = cubeBit a + sFlip idx) := by decide +kernel
theorem tgt_spec_c1 : ∀ (a : Fin 48) (idx : Fin 32), 12 ≤ a.val → a.val < 24 → (cubeVert (tgt a idx) = Work.FoldInst.truncPerm (sG idx) (cubeVert a)
      ∧ cubeBit (tgt a idx) = cubeBit a + sFlip idx) := by decide +kernel
theorem tgt_spec_c2 : ∀ (a : Fin 48) (idx : Fin 32), 24 ≤ a.val → a.val < 36 → (cubeVert (tgt a idx) = Work.FoldInst.truncPerm (sG idx) (cubeVert a)
      ∧ cubeBit (tgt a idx) = cubeBit a + sFlip idx) := by decide +kernel
theorem tgt_spec_c3 : ∀ (a : Fin 48) (idx : Fin 32), 36 ≤ a.val → (cubeVert (tgt a idx) = Work.FoldInst.truncPerm (sG idx) (cubeVert a)
      ∧ cubeBit (tgt a idx) = cubeBit a + sFlip idx) := by decide +kernel
theorem tgt_spec : ∀ (a : Fin 48) (idx : Fin 32),
    cubeVert (tgt a idx) = Work.FoldInst.truncPerm (sG idx) (cubeVert a)
      ∧ cubeBit (tgt a idx) = cubeBit a + sFlip idx := by
  intro a idx
  by_cases h0 : a.val < 12
  · exact tgt_spec_c0 a idx (by omega) h0
  by_cases h1 : a.val < 24
  · exact tgt_spec_c1 a idx (by omega) h1
  by_cases h2 : a.val < 36
  · exact tgt_spec_c2 a idx (by omega) h2
  exact tgt_spec_c3 a idx (by omega)

theorem cube_unique : ∀ (b b' : Fin 48), cubeVert b = cubeVert b' → cubeBit b = cubeBit b' →
    b = b' := by decide +kernel

/-- **The vacuity check, first part**: the pinned coordinate of the vacuity datum of a nonzero
element of the group generated by the wall types is pinned by that group. -/
theorem vac_mem_c0 : ∀ (a : Fin 48) (idx : Fin 32) (D : Finset (Fin 3)), 0 ≤ a.val → a.val < 12 → (gOf idx ∈ spanFin a D → gOf idx ≠ 0 → vacI a idx ∈ D) := by decide +kernel
theorem vac_mem_c1 : ∀ (a : Fin 48) (idx : Fin 32) (D : Finset (Fin 3)), 12 ≤ a.val → a.val < 24 → (gOf idx ∈ spanFin a D → gOf idx ≠ 0 → vacI a idx ∈ D) := by decide +kernel
theorem vac_mem_c2 : ∀ (a : Fin 48) (idx : Fin 32) (D : Finset (Fin 3)), 24 ≤ a.val → a.val < 36 → (gOf idx ∈ spanFin a D → gOf idx ≠ 0 → vacI a idx ∈ D) := by decide +kernel
theorem vac_mem_c3 : ∀ (a : Fin 48) (idx : Fin 32) (D : Finset (Fin 3)), 36 ≤ a.val → (gOf idx ∈ spanFin a D → gOf idx ≠ 0 → vacI a idx ∈ D) := by decide +kernel
theorem vac_mem : ∀ (a : Fin 48) (idx : Fin 32) (D : Finset (Fin 3)),
    gOf idx ∈ spanFin a D → gOf idx ≠ 0 → vacI a idx ∈ D := by
  intro a idx D
  by_cases h0 : a.val < 12
  · exact vac_mem_c0 a idx D (by omega) h0
  by_cases h1 : a.val < 24
  · exact vac_mem_c1 a idx D (by omega) h1
  by_cases h2 : a.val < 36
  · exact vac_mem_c2 a idx D (by omega) h2
  exact vac_mem_c3 a idx D (by omega)

/-- **The vacuity check, second part**: the glued image of the vacuity datum sits at the excluded
upper end of the target box. -/
theorem vac_coef_c0 : ∀ (a : Fin 48) (idx : Fin 32), 0 ≤ a.val → a.val < 12 → (gOf idx ∈ spanFin a Finset.univ → gOf idx ≠ 0 →
      (NC a idx (vacK a idx) (vacI a idx) = -160
        ∧ (∀ j : Fin 3, j ≠ vacI a idx → NC a idx (vacK a idx) j = 0)
        ∧ MC a idx (vacK a idx)
            = 160 * (Work.Cusp.cubeCorner (tgt a idx) (vacK a idx) + 1
                + Work.Cusp.cubeCorner a (vacI a idx)))) := by decide +kernel
theorem vac_coef_c1 : ∀ (a : Fin 48) (idx : Fin 32), 12 ≤ a.val → a.val < 24 → (gOf idx ∈ spanFin a Finset.univ → gOf idx ≠ 0 →
      (NC a idx (vacK a idx) (vacI a idx) = -160
        ∧ (∀ j : Fin 3, j ≠ vacI a idx → NC a idx (vacK a idx) j = 0)
        ∧ MC a idx (vacK a idx)
            = 160 * (Work.Cusp.cubeCorner (tgt a idx) (vacK a idx) + 1
                + Work.Cusp.cubeCorner a (vacI a idx)))) := by decide +kernel
theorem vac_coef_c2 : ∀ (a : Fin 48) (idx : Fin 32), 24 ≤ a.val → a.val < 36 → (gOf idx ∈ spanFin a Finset.univ → gOf idx ≠ 0 →
      (NC a idx (vacK a idx) (vacI a idx) = -160
        ∧ (∀ j : Fin 3, j ≠ vacI a idx → NC a idx (vacK a idx) j = 0)
        ∧ MC a idx (vacK a idx)
            = 160 * (Work.Cusp.cubeCorner (tgt a idx) (vacK a idx) + 1
                + Work.Cusp.cubeCorner a (vacI a idx)))) := by decide +kernel
theorem vac_coef_c3 : ∀ (a : Fin 48) (idx : Fin 32), 36 ≤ a.val → (gOf idx ∈ spanFin a Finset.univ → gOf idx ≠ 0 →
      (NC a idx (vacK a idx) (vacI a idx) = -160
        ∧ (∀ j : Fin 3, j ≠ vacI a idx → NC a idx (vacK a idx) j = 0)
        ∧ MC a idx (vacK a idx)
            = 160 * (Work.Cusp.cubeCorner (tgt a idx) (vacK a idx) + 1
                + Work.Cusp.cubeCorner a (vacI a idx)))) := by decide +kernel
theorem vac_coef : ∀ (a : Fin 48) (idx : Fin 32),
    gOf idx ∈ spanFin a Finset.univ → gOf idx ≠ 0 →
      (NC a idx (vacK a idx) (vacI a idx) = -160
        ∧ (∀ j : Fin 3, j ≠ vacI a idx → NC a idx (vacK a idx) j = 0)
        ∧ MC a idx (vacK a idx)
            = 160 * (Work.Cusp.cubeCorner (tgt a idx) (vacK a idx) + 1
                + Work.Cusp.cubeCorner a (vacI a idx))) := by
  intro a idx
  by_cases h0 : a.val < 12
  · exact vac_coef_c0 a idx (by omega) h0
  by_cases h1 : a.val < 24
  · exact vac_coef_c1 a idx (by omega) h1
  by_cases h2 : a.val < 36
  · exact vac_coef_c2 a idx (by omega) h2
  exact vac_coef_c3 a idx (by omega)

end

section
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

theorem kleinToX_kleinPt_coef_c0 : ∀ (a : Fin 48) (k j : Fin 3), 0 ≤ a.val → a.val < 12 → ((∑ l : Fin 4, C16 a k l * A10 a l j) = 160 * (if k = j then 1 else 0)) := by decide +kernel
theorem kleinToX_kleinPt_coef_c1 : ∀ (a : Fin 48) (k j : Fin 3), 12 ≤ a.val → a.val < 24 → ((∑ l : Fin 4, C16 a k l * A10 a l j) = 160 * (if k = j then 1 else 0)) := by decide +kernel
theorem kleinToX_kleinPt_coef_c2 : ∀ (a : Fin 48) (k j : Fin 3), 24 ≤ a.val → a.val < 36 → ((∑ l : Fin 4, C16 a k l * A10 a l j) = 160 * (if k = j then 1 else 0)) := by decide +kernel
theorem kleinToX_kleinPt_coef_c3 : ∀ (a : Fin 48) (k j : Fin 3), 36 ≤ a.val → ((∑ l : Fin 4, C16 a k l * A10 a l j) = 160 * (if k = j then 1 else 0)) := by decide +kernel
theorem kleinToX_kleinPt_coef : ∀ (a : Fin 48) (k j : Fin 3),
    (∑ l : Fin 4, C16 a k l * A10 a l j) = 160 * (if k = j then 1 else 0) := by
  intro a k j
  by_cases h0 : a.val < 12
  · exact kleinToX_kleinPt_coef_c0 a k j (by omega) h0
  by_cases h1 : a.val < 24
  · exact kleinToX_kleinPt_coef_c1 a k j (by omega) h1
  by_cases h2 : a.val < 36
  · exact kleinToX_kleinPt_coef_c2 a k j (by omega) h2
  exact kleinToX_kleinPt_coef_c3 a k j (by omega)

theorem kleinToX_kleinPt_const : ∀ (a : Fin 48) (k : Fin 3),
    (∑ l : Fin 4, C16 a k l * b10 a l) + 10 * c16 a k = 0 := by decide +kernel
end

/-- **The affine maps `kleinToX a` and `kleinPt a` are mutually inverse.** -/
theorem kleinToX_kleinPt (a : Fin 48) (u : CuspE3) : kleinToX a (kleinPt a u) = u := by
  apply PiLp.ext
  intro k
  rw [kleinToX_apply]
  have h1 : (∑ l : Fin 4, ((C16 a k l : ℤ) : ℝ) * kleinPt a u l)
      = (∑ j : Fin 3, ((∑ l : Fin 4, C16 a k l * A10 a l j : ℤ) : ℝ) * u j) / 10
        + ((∑ l : Fin 4, C16 a k l * b10 a l : ℤ) : ℝ) / 10 := by
    have hcore : ∀ l : Fin 4, kleinPt a u l
        = (∑ j : Fin 3, ((A10 a l j : ℤ) : ℝ) * u j) / 10 + ((b10 a l : ℤ) : ℝ) / 10 :=
      fun l => kleinPt_apply a u l
    rw [show (∑ l : Fin 4, ((C16 a k l : ℤ) : ℝ) * kleinPt a u l)
        = ∑ l : Fin 4, ((C16 a k l : ℤ) : ℝ)
          * ((∑ j : Fin 3, ((A10 a l j : ℤ) : ℝ) * u j) / 10 + ((b10 a l : ℤ) : ℝ) / 10) from by
      refine Finset.sum_congr rfl (fun l _ => ?_)
      rw [hcore l]]
    rw [sum_swap_mul' (fun l => ((C16 a k l : ℤ) : ℝ)) (fun l j => ((A10 a l j : ℤ) : ℝ)) u
      (fun l => ((b10 a l : ℤ) : ℝ))]
    push_cast
    ring
  rw [h1]
  have h2 : (∑ j : Fin 3, ((160 * (if k = j then (1 : ℤ) else 0) : ℤ) : ℝ) * u j) = 160 * u k := by
    rw [Finset.sum_eq_single k]
    · rw [if_pos rfl]; norm_num
    · intro j _ hj
      rw [if_neg (fun h : k = j => hj h.symm)]; norm_num
    · intro hk; exact absurd (Finset.mem_univ k) hk
  have h3 : ((∑ l : Fin 4, C16 a k l * b10 a l : ℤ) : ℝ) = -10 * ((c16 a k : ℤ) : ℝ) := by
    have hZ := kleinToX_kleinPt_const a k
    have hR : ((∑ l : Fin 4, C16 a k l * b10 a l : ℤ) : ℝ) + 10 * ((c16 a k : ℤ) : ℝ) = 0 := by
      have h := congrArg (fun z : ℤ => (z : ℝ)) hZ
      push_cast at h
      simpa using h
    linarith
  rw [show (∑ j : Fin 3, ((∑ l : Fin 4, C16 a k l * A10 a l j : ℤ) : ℝ) * u j) = 160 * u k from by
    rw [show (∑ j : Fin 3, ((∑ l : Fin 4, C16 a k l * A10 a l j : ℤ) : ℝ) * u j)
        = ∑ j : Fin 3, ((160 * (if k = j then (1 : ℤ) else 0) : ℤ) : ℝ) * u j from by
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [kleinToX_kleinPt_coef a k j]]
    exact h2]
  rw [h3]
  norm_num
  ring

/-- The cusp shift is a lattice vector. -/
theorem latVec_cuspShift (v : Fin 5) (x : CuspE3) : latVec v (intVec (cuspShift v x)) := by
  intro i
  have hd := cubeOfMod_corner_dvd v (floorV x) i
  have hcs : cuspShift v x i
      = floorV x i - Work.Cusp.cubeCorner (Work.Cusp.cubeOfMod v (floorV x)) i := rfl
  obtain ⟨k, hk⟩ := hd
  refine ⟨k, ?_⟩
  rw [intVec_apply, hcs, hk]
  push_cast
  ring

theorem latVec_add {v : Fin 5} {z w : CuspE3} (hz : latVec v z) (hw : latVec v w) :
    latVec v (z + w) := by
  intro i
  obtain ⟨k, hk⟩ := hz i
  obtain ⟨l, hl⟩ := hw i
  exact ⟨k + l, by rw [PiLp.add_apply, hk, hl]; push_cast; ring⟩

theorem latVec_sub {v : Fin 5} {z w : CuspE3} (hz : latVec v z) (hw : latVec v w) :
    latVec v (z - w) := by
  intro i
  obtain ⟨k, hk⟩ := hz i
  obtain ⟨l, hl⟩ := hw i
  exact ⟨k - l, by rw [PiLp.sub_apply, hk, hl]; push_cast; ring⟩

theorem redV_add_shift (v : Fin 5) (x : CuspE3) :
    x = redV v x + intVec (cuspShift v x) := by
  apply PiLp.ext
  intro i
  have h := congrFun (redV_sub_eq v x) i
  simp only [intVec_apply, PiLp.add_apply] at h ⊢
  linarith

/-- `truncPerm` of the trivial sign change is the identity. -/
theorem truncPerm_zero (w : Fin 24) : Work.FoldInst.truncPerm (0 : Fin 4 → ZMod 2) w = w := by
  fin_cases w <;> decide +kernel

theorem spanFin_mono {a : Fin 48} {D D' : Finset (Fin 3)} (h : D ⊆ D') :
    spanFin a D ⊆ spanFin a D' := by
  intro x hx
  obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hx
  exact Finset.mem_image.mpr ⟨A, Finset.mem_powerset.mpr ((Finset.mem_powerset.mp hA).trans h), rfl⟩

theorem vacuous (a : Fin 48) (γ : Work.FoldInst.Gg) (u : CuspE3)
    (hu : u ∈ halfopenBox a) (hγ : γ ∈ spanSub a (pinned a u)) (hne : γ ≠ 0)
    (hu' : kleinToX (tgt a (gIdx γ)) (Work.FoldInst.act γ.1 (kleinPt a u))
        ∈ halfopenBox (tgt a (gIdx γ))) : False := by
  have hspanD : gOf (gIdx γ) ∈ spanFin a (pinned a u) := by
    rw [gOf_gIdx]; exact hγ
  have hspanU : gOf (gIdx γ) ∈ spanFin a Finset.univ :=
    spanFin_mono (Finset.subset_univ _) hspanD
  have hneU : gOf (gIdx γ) ≠ 0 := by rw [gOf_gIdx]; exact hne
  have hI : vacI a (gIdx γ) ∈ pinned a u := vac_mem a (gIdx γ) (pinned a u) hspanD hneU
  have hui : u (vacI a (gIdx γ)) = (Work.Cusp.cubeCorner a (vacI a (gIdx γ)) : ℝ) :=
    (mem_pinned).mp hI
  obtain ⟨h1, h2, h3⟩ := vac_coef a (gIdx γ) hspanU hneU
  have hx : 160 * (kleinToX (tgt a (gIdx γ)) (Work.FoldInst.act γ.1 (kleinPt a u)))
        (vacK a (gIdx γ))
      = 160 * ((Work.Cusp.cubeCorner (tgt a (gIdx γ)) (vacK a (gIdx γ)) : ℝ) + 1) := by
    have hG := Gu_eq a (gIdx γ) u (vacK a (gIdx γ))
    rw [sG_gIdx] at hG
    rw [hG]
    have hsum : (∑ j : Fin 3, ((NC a (gIdx γ) (vacK a (gIdx γ)) j : ℤ) : ℝ) * u j)
        = ((NC a (gIdx γ) (vacK a (gIdx γ)) (vacI a (gIdx γ)) : ℤ) : ℝ)
            * u (vacI a (gIdx γ)) := by
      refine Finset.sum_eq_single (vacI a (gIdx γ)) (fun j _ hj => ?_)
        (fun h => absurd (Finset.mem_univ _) h)
      rw [h2 j hj]; ring
    rw [hsum, h1, hui, h3]
    push_cast
    ring
  have hlt := (hu' (vacK a (gIdx γ))).2
  linarith


theorem intVec_sub (L M : Fin 3 → ℤ) : intVec (L - M) = intVec L - intVec M := by
  apply PiLp.ext
  intro i
  simp only [intVec_apply, PiLp.sub_apply, Pi.sub_apply]
  push_cast
  ring

/-- **The decomposition of a difference of cusp coordinates**. -/
theorem sub_eq_redV_shift (v : Fin 5) (x x' : CuspE3) :
    x - x' = (redV v x - redV v x') + intVec (cuspShift v x - cuspShift v x') := by
  apply PiLp.ext
  intro i
  have h1 := congrFun (redV_sub_eq v x) i
  have h2 := congrFun (redV_sub_eq v x') i
  have e1 : x i = redV v x i + (cuspShift v x i : ℝ) := by linarith
  have e2 : x' i = redV v x' i + (cuspShift v x' i : ℝ) := by linarith
  simp only [PiLp.sub_apply, PiLp.add_apply, intVec_apply, Pi.sub_apply, e1, e2]
  push_cast
  ring


end Work.RTOwed.cuspCert
