/-
# The support lemmas of the injectivity certificate of the ceiling map

This file sets up the vocabulary of `Work.RTOwed.cuspCert.mbarPt_inj`:

* the *lower walls* of a cube (`wallLo a i`) and their group elements (`wGen`),
* the half open unit box `halfopenBox a` (the actual domain of `redV v ·`) and the pinned set of a
  point of it,
* the finite subgroup generated by a set of wall types (`spanFin`),
* the vacuity machinery: an element of the group generated by the wall types of a point of
  `halfopenBox a` reverses a pinned coordinate, so that the corresponding glued point sits at the
  excluded upper end of the target box.
-/
import Mathlib
import Submission.Work.RTOwed.cuspCert.CuspTabs
import Submission.Work.RTOwed.cuspCert.lattice_bridge
import Submission.Work.RTOwed.cuspCert.cubeOfMod_corner_dvd

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open Set

namespace Work.RTOwed.cuspCert

open Work.RTOwed

/-! ## The lower walls of a cube -/

/-- The type of the `i`-th lower wall of the cube `a`. -/
def wType (a : Fin 48) (i : Fin 3) : Fin 5 := Work.FoldInst.sideTypeIdx (wallLo a i)

/-- The group element (type) of the `i`-th lower wall of the cube `a`. -/
def wGen (a : Fin 48) (i : Fin 3) : Work.FoldInst.Gg := Work.FoldInst.typeGen (wType a i)

/-- The finite subgroup of `Gg` generated by the wall types indexed by `D`: the set of subset sums
of `wGen a i`, `i ∈ D`. -/
def spanFin (a : Fin 48) (D : Finset (Fin 3)) : Finset Work.FoldInst.Gg :=
  D.powerset.image (fun D' => D'.sum (wGen a))

theorem zadd_self_gg (x : Work.FoldInst.Gg) : x + x = 0 := by
  refine Prod.ext ?_ ?_
  · funext i; exact Work.FoldInst.ZMod2_add_self _
  · exact Work.FoldInst.ZMod2_add_self _

theorem zneg_gg (x : Work.FoldInst.Gg) : -x = x := by
  refine Prod.ext ?_ ?_
  · funext i; exact Work.FoldInst.ZMod2_neg _
  · exact Work.FoldInst.ZMod2_neg _

theorem spanFin_zero (a : Fin 48) (D : Finset (Fin 3)) :
    (0 : Work.FoldInst.Gg) ∈ spanFin a D := by
  refine Finset.mem_image.mpr ⟨∅, Finset.empty_mem_powerset D, ?_⟩
  simp

theorem wGen_mem_spanFin (a : Fin 48) {D : Finset (Fin 3)} {i : Fin 3} (hi : i ∈ D) :
    wGen a i ∈ spanFin a D := by
  refine Finset.mem_image.mpr ⟨{i}, Finset.mem_powerset.mpr (by simpa using hi), ?_⟩
  simp

/-- The sum over the symmetric difference of two finsets. -/
theorem sum_symm (a : Fin 48) (A B : Finset (Fin 3)) :
    ((A \ B) ∪ (B \ A)).sum (wGen a) = A.sum (wGen a) + B.sum (wGen a) := by
  have hd1 : Disjoint (A \ B) (B \ A) := by
    rw [Finset.disjoint_left]
    intro i hi hj
    exact (Finset.mem_sdiff.mp hi).2 (Finset.mem_sdiff.mp hj).1
  rw [Finset.sum_union hd1]
  have hA' : A.sum (wGen a) = (A \ B).sum (wGen a) + (A ∩ B).sum (wGen a) := by
    have hs : A \ (A ∩ B) = A \ B :=
      Finset.ext fun i => by simp only [Finset.mem_sdiff, Finset.mem_inter]; tauto
    rw [← Finset.sum_sdiff (f := wGen a) (s₁ := A ∩ B) (s₂ := A) Finset.inter_subset_left, hs]
  have hB' : B.sum (wGen a) = (B \ A).sum (wGen a) + (A ∩ B).sum (wGen a) := by
    have hs : B \ (A ∩ B) = B \ A :=
      Finset.ext fun i => by simp only [Finset.mem_sdiff, Finset.mem_inter]; tauto
    rw [← Finset.sum_sdiff (f := wGen a) (s₁ := A ∩ B) (s₂ := B) Finset.inter_subset_right, hs]
  rw [hA', hB']
  have hre : ((A \ B).sum (wGen a) + (A ∩ B).sum (wGen a))
      + ((B \ A).sum (wGen a) + (A ∩ B).sum (wGen a))
      = (A \ B).sum (wGen a) + (B \ A).sum (wGen a)
        + ((A ∩ B).sum (wGen a) + (A ∩ B).sum (wGen a)) := by abel
  rw [hre, zadd_self_gg, add_zero]

theorem spanFin_add (a : Fin 48) (D : Finset (Fin 3)) {x y : Work.FoldInst.Gg}
    (hx : x ∈ spanFin a D) (hy : y ∈ spanFin a D) : x + y ∈ spanFin a D := by
  obtain ⟨A, hA, rfl⟩ := Finset.mem_image.mp hx
  obtain ⟨B, hB, rfl⟩ := Finset.mem_image.mp hy
  have hAd : A ⊆ D := Finset.mem_powerset.mp hA
  have hBd : B ⊆ D := Finset.mem_powerset.mp hB
  refine Finset.mem_image.mpr ⟨(A \ B) ∪ (B \ A), Finset.mem_powerset.mpr ?_, ?_⟩
  · intro i hi
    rcases Finset.mem_union.mp hi with h | h
    · exact hAd (Finset.mem_sdiff.mp h).1
    · exact hBd (Finset.mem_sdiff.mp h).1
  · exact sum_symm a A B

theorem spanFin_neg (a : Fin 48) (D : Finset (Fin 3)) {x : Work.FoldInst.Gg}
    (hx : x ∈ spanFin a D) : -x ∈ spanFin a D := by
  rw [zneg_gg]; exact hx

/-- The subgroup structure of `spanFin a D`. -/
def spanSub (a : Fin 48) (D : Finset (Fin 3)) : AddSubgroup Work.FoldInst.Gg where
  carrier := ↑(spanFin a D)
  zero_mem' := spanFin_zero a D
  add_mem' := fun hx hy => spanFin_add a D hx hy
  neg_mem' := fun hx => spanFin_neg a D hx

/-- The type generators of the walls indexed by `D` lie in `spanFin a D`. -/
theorem closure_le_spanFin (a : Fin 48) (D : Finset (Fin 3)) :
    AddSubgroup.closure (wGen a '' (↑D : Set (Fin 3))) ≤ spanSub a D := by
  refine (AddSubgroup.closure_le (spanSub a D)).mpr ?_
  rintro _ ⟨i, hi, rfl⟩
  simpa [spanSub] using wGen_mem_spanFin a hi


def halfopenBox (a : Fin 48) : Set CuspE3 :=
  {u | ∀ i : Fin 3, (Work.Cusp.cubeCorner a i : ℝ) ≤ u i
    ∧ u i < (Work.Cusp.cubeCorner a i : ℝ) + 1}

theorem halfopenBox_subset_cubeBox (a : Fin 48) : halfopenBox a ⊆ cubeBox a :=
  fun _ hu i => ⟨(hu i).1, le_of_lt (hu i).2⟩

theorem redV_mem_halfopenBox (v : Fin 5) (x : CuspE3) :
    redV v x ∈ halfopenBox (cubeOf v x) := by
  intro i
  have h1 : (⌊x i⌋ : ℝ) ≤ x i := Int.floor_le _
  have h2 : x i < (⌊x i⌋ : ℝ) + 1 := Int.lt_floor_add_one _
  simp only [redV, PiLp.toLp_apply]
  constructor <;> linarith


def pinned (a : Fin 48) (u : CuspE3) : Finset (Fin 3) :=
  Finset.univ.filter (fun i => u i = (Work.Cusp.cubeCorner a i : ℝ))

theorem mem_pinned {a : Fin 48} {u : CuspE3} {i : Fin 3} :
    i ∈ pinned a u ↔ u i = (Work.Cusp.cubeCorner a i : ℝ) := by
  simp [pinned]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 8000000 in
theorem notIdZero_of_not_wall_c0 : ∀ (a : Fin 48) (D : Finset (Fin 3)) (S : Fin 24), 0 ≤ a.val → a.val < 12 → (S ∉ D.image (wallLo a) →
    (KsideZ a S ≠ 0 ∨ ∃ j : Fin 3, j ∉ D ∧ EsideZ a S j ≠ 0)) := by decide +kernel
theorem notIdZero_of_not_wall_c1 : ∀ (a : Fin 48) (D : Finset (Fin 3)) (S : Fin 24), 12 ≤ a.val → a.val < 24 → (S ∉ D.image (wallLo a) →
    (KsideZ a S ≠ 0 ∨ ∃ j : Fin 3, j ∉ D ∧ EsideZ a S j ≠ 0)) := by decide +kernel
theorem notIdZero_of_not_wall_c2 : ∀ (a : Fin 48) (D : Finset (Fin 3)) (S : Fin 24), 24 ≤ a.val → a.val < 36 → (S ∉ D.image (wallLo a) →
    (KsideZ a S ≠ 0 ∨ ∃ j : Fin 3, j ∉ D ∧ EsideZ a S j ≠ 0)) := by decide +kernel
theorem notIdZero_of_not_wall_c3 : ∀ (a : Fin 48) (D : Finset (Fin 3)) (S : Fin 24), 36 ≤ a.val → (S ∉ D.image (wallLo a) →
    (KsideZ a S ≠ 0 ∨ ∃ j : Fin 3, j ∉ D ∧ EsideZ a S j ≠ 0)) := by decide +kernel
theorem notIdZero_of_not_wall : ∀ (a : Fin 48) (D : Finset (Fin 3)) (S : Fin 24),
    S ∉ D.image (wallLo a) →
    (KsideZ a S ≠ 0 ∨ ∃ j : Fin 3, j ∉ D ∧ EsideZ a S j ≠ 0) := by
  intro a D S
  by_cases h0 : a.val < 12
  · exact notIdZero_of_not_wall_c0 a D S (by omega) h0
  by_cases h1 : a.val < 24
  · exact notIdZero_of_not_wall_c1 a D S (by omega) h1
  by_cases h2 : a.val < 36
  · exact notIdZero_of_not_wall_c2 a D S (by omega) h2
  exact notIdZero_of_not_wall_c3 a D S (by omega)

theorem hclRc (a : Fin 48) (j : Fin 3) :
    (cl a j : ℝ) = (Work.Cusp.cubeCorner a j : ℝ) := by
  rw [hclZ a j]

theorem halfopenBox_eVec_mem {a : Fin 48} {u : CuspE3} (hu : u ∈ halfopenBox a) {j : Fin 3}
    {d : ℝ} (hd1 : d ≤ u j - (Work.Cusp.cubeCorner a j : ℝ))
    (hd2 : d ≤ (Work.Cusp.cubeCorner a j : ℝ) + 1 - u j) (hd0 : 0 ≤ d) :
    u - d • eVec j ∈ cubeBox a ∧ u + d • eVec j ∈ cubeBox a := by
  constructor
  · intro l
    simp only [cubeBox, Set.mem_ofPred_eq, PiLp.sub_apply, PiLp.smul_apply, eVec,
      PiLp.single_apply]
    by_cases hl : l = j
    · subst hl
      rw [ite_eq_left rfl, smul_eq_mul, mul_one]
      exact ⟨by linarith, by linarith⟩
    · rw [ite_eq_right hl, smul_eq_mul, mul_zero, sub_zero]
      exact ⟨(hu l).1, le_of_lt (hu l).2⟩
  · intro l
    simp only [cubeBox, Set.mem_ofPred_eq, PiLp.add_apply, PiLp.smul_apply, eVec,
      PiLp.single_apply]
    by_cases hl : l = j
    · subst hl
      rw [ite_eq_left rfl, smul_eq_mul, mul_one]
      exact ⟨by linarith, by linarith⟩
    · rw [ite_eq_right hl, smul_eq_mul, mul_zero, add_zero]
      exact ⟨(hu l).1, le_of_lt (hu l).2⟩

theorem sideSlack_shift (a : Fin 48) (S : Fin 24) (j : Fin 3) (d : ℝ) (u : CuspE3) :
    10 * Work.FoldInst.sideSlack S (kleinPt a (u + d • eVec j))
      = 10 * Work.FoldInst.sideSlack S (kleinPt a u) + d * EsideR a S j := by
  rw [ten_sideSlack, ten_sideSlack]
  have hpt : ∀ l : Fin 3, (u + d • eVec j) l - (cl a l : ℝ)
      = (u l - (cl a l : ℝ)) + d * (if l = j then 1 else 0) := by
    intro l
    simp only [PiLp.add_apply, PiLp.smul_apply, eVec, PiLp.single_apply]
    by_cases hl : l = j
    · subst hl
      simp only [PiLp.add_apply, PiLp.smul_apply, eVec, PiLp.single_apply, smul_eq_mul, mul_one]
      ring
    · have h0 : (if l = j then (1 : ℝ) else 0) = 0 := by simp [hl]
      rw [h0, smul_eq_mul, mul_zero]; ring
  have h1 : ∑ l : Fin 3, EsideR a S l * ((u + d • eVec j) l - (cl a l : ℝ))
      = (∑ l : Fin 3, EsideR a S l * (u l - (cl a l : ℝ))) + d * EsideR a S j := by
    calc ∑ l : Fin 3, EsideR a S l * ((u + d • eVec j) l - (cl a l : ℝ))
        = ∑ l : Fin 3, EsideR a S l * ((u l - (cl a l : ℝ)) + d * (if l = j then 1 else 0)) :=
          Finset.sum_congr rfl (fun l _ => by rw [hpt l])
      _ = ∑ l : Fin 3, (EsideR a S l * (u l - (cl a l : ℝ))
            + EsideR a S l * (d * (if l = j then 1 else 0))) :=
          Finset.sum_congr rfl (fun l _ => by ring)
      _ = (∑ l : Fin 3, EsideR a S l * (u l - (cl a l : ℝ)))
            + ∑ l : Fin 3, EsideR a S l * (d * (if l = j then 1 else 0)) :=
          Finset.sum_add_distrib
      _ = (∑ l : Fin 3, EsideR a S l * (u l - (cl a l : ℝ))) + d * EsideR a S j := by
          congr 1
          rw [Finset.sum_eq_single j]
          · rw [if_pos rfl]; ring
          · intro l _ hl; rw [if_neg hl]; ring
          · intro h; exact absurd (Finset.mem_univ j) h
  rw [h1]
  ring

theorem EsideZ_eq_zero_of_not_pinned (a : Fin 48) {u : CuspE3} (hu : u ∈ halfopenBox a)
    {S : Fin 24} (hS : Work.FoldInst.sideSlack S (kleinPt a u) = 0) {j : Fin 3}
    (hj : u j ≠ (Work.Cusp.cubeCorner a j : ℝ)) : EsideZ a S j = 0 := by
  have hlt : (Work.Cusp.cubeCorner a j : ℝ) < u j := lt_of_le_of_ne (hu j).1 (Ne.symm hj)
  have hgt : u j < (Work.Cusp.cubeCorner a j : ℝ) + 1 := (hu j).2
  obtain ⟨d, hd1, hd2, hd0⟩ : ∃ d : ℝ, d ≤ u j - (Work.Cusp.cubeCorner a j : ℝ)
      ∧ d ≤ (Work.Cusp.cubeCorner a j : ℝ) + 1 - u j ∧ 0 < d := by
    refine ⟨min (u j - (Work.Cusp.cubeCorner a j : ℝ))
      ((Work.Cusp.cubeCorner a j : ℝ) + 1 - u j) / 2, ?_, ?_, ?_⟩
    · have := min_le_left (u j - (Work.Cusp.cubeCorner a j : ℝ))
        ((Work.Cusp.cubeCorner a j : ℝ) + 1 - u j); linarith
    · have := min_le_right (u j - (Work.Cusp.cubeCorner a j : ℝ))
        ((Work.Cusp.cubeCorner a j : ℝ) + 1 - u j); linarith
    · have h1 : 0 < u j - (Work.Cusp.cubeCorner a j : ℝ) := by linarith
      have h2 : 0 < (Work.Cusp.cubeCorner a j : ℝ) + 1 - u j := by linarith
      have h3 : 0 < min (u j - (Work.Cusp.cubeCorner a j : ℝ))
          ((Work.Cusp.cubeCorner a j : ℝ) + 1 - u j) := lt_min h1 h2
      linarith
  obtain ⟨hm1, hm2⟩ := halfopenBox_eVec_mem hu hd1 hd2 (le_of_lt hd0)
  have h0 : 10 * Work.FoldInst.sideSlack S (kleinPt a u) = 0 := by rw [hS, mul_zero]
  have hpl : 0 ≤ d * EsideR a S j := by
    have hnn := sideSlack_nonneg a S _ hm2
    have h10 : 0 ≤ 10 * Work.FoldInst.sideSlack S (kleinPt a (u + d • eVec j)) := by linarith
    rw [sideSlack_shift a S j d u, h0, zero_add] at h10
    exact h10
  have hmi : 0 ≤ -(d * EsideR a S j) := by
    have hsub : u - d • eVec j = u + (-d) • eVec j := by rw [neg_smul, sub_eq_add_neg]
    have hnn := sideSlack_nonneg a S _ hm1
    rw [hsub] at hnn
    have h10 : 0 ≤ 10 * Work.FoldInst.sideSlack S (kleinPt a (u + (-d) • eVec j)) := by linarith
    rw [sideSlack_shift a S j (-d) u, h0, zero_add] at h10
    rw [neg_mul] at h10
    linarith
  have hE : EsideR a S j = 0 := by
    have h : d * EsideR a S j = 0 := le_antisymm (by linarith) hpl
    exact (mul_eq_zero.mp h).resolve_left (ne_of_gt hd0)
  have hcast : ((EsideZ a S j : ℤ) : ℝ) = 0 := by rw [EsideZ_cast a S j, hE]
  exact_mod_cast hcast

theorem KsideZ_eq_zero_of_slack (a : Fin 48) {u : CuspE3} (hu : u ∈ halfopenBox a)
    {S : Fin 24} (hS : Work.FoldInst.sideSlack S (kleinPt a u) = 0) : KsideZ a S = 0 := by
  have h0 : 10 * Work.FoldInst.sideSlack S (kleinPt a u) = 0 := by rw [hS, mul_zero]
  have hsum : KsideR a S + ∑ l : Fin 3, EsideR a S l * (u l - (cl a l : ℝ)) = 0 := by
    have := ten_sideSlack a S u
    rw [h0] at this
    linarith
  have hzero : ∑ l : Fin 3, EsideR a S l * (u l - (cl a l : ℝ)) = 0 := by
    refine Finset.sum_eq_zero fun l _ => ?_
    by_cases hl : u l = (Work.Cusp.cubeCorner a l : ℝ)
    · rw [hl, hclRc]; ring
    · have hE := EsideZ_eq_zero_of_not_pinned a hu hS hl
      rw [← EsideZ_cast a S l, hE]
      simp
  have hKR : KsideR a S = 0 := by linarith
  have hcast : ((KsideZ a S : ℤ) : ℝ) = 0 := by rw [KsideZ_cast a S, hKR]
  exact_mod_cast hcast

theorem tight_is_wall (a : Fin 48) {u : CuspE3} (hu : u ∈ halfopenBox a) {S : Fin 24}
    (hS : Work.FoldInst.sideSlack S (kleinPt a u) = 0) :
    ∃ i : Fin 3, u i = (Work.Cusp.cubeCorner a i : ℝ) ∧ S = wallLo a i := by
  by_contra hcon
  have hnotin : S ∉ (pinned a u).image (wallLo a) := by
    intro hmem
    obtain ⟨i, hi, hSi⟩ := Finset.mem_image.mp hmem
    exact hcon ⟨i, (mem_pinned).mp hi, hSi.symm⟩
  rcases notIdZero_of_not_wall a (pinned a u) S hnotin with hK | ⟨j, hj, hE⟩
  · exact hK (KsideZ_eq_zero_of_slack a hu hS)
  · exact hE (EsideZ_eq_zero_of_not_pinned a hu hS (fun h => hj ((mem_pinned).mpr h)))

theorem Ksub_le_spanFin (a : Fin 48) {u : CuspE3} (hu : u ∈ halfopenBox a) :
    Work.FoldInst.Ksub (kleinPt a u) ≤ spanSub a (pinned a u) := by
  have hy : kleinPt a u ∈ Work.FoldInst.Qbar :=
    cube_quad.1 a u (halfopenBox_subset_cubeBox a hu)
  have h := Work.FoldInst.Ksub_eq_closure (⟨(0 : ZMod 2), ⟨kleinPt a u, hy⟩⟩ : Work.FoldInst.Xbar)
  rw [h]
  refine (AddSubgroup.closure_le (spanSub a (pinned a u))).mpr ?_
  rintro γ ⟨S, hS, rfl⟩
  have hS' : Work.FoldInst.sideSlack S (kleinPt a u) = 0 := by
    have := (Work.FoldInst.tightSides_spec
      (⟨(0 : ZMod 2), ⟨kleinPt a u, hy⟩⟩ : Work.FoldInst.Xbar) S).mp hS
    simpa using this
  obtain ⟨i, hi, hSi⟩ := tight_is_wall a hu hS'
  rw [hSi]
  simpa [spanSub, wGen, wType, Work.FoldInst.sideType, Work.FoldInst.typeGen]
      using wGen_mem_spanFin a ((mem_pinned).mpr hi)

theorem sBitZ_eq : ∀ (idx : Fin 32) (l : Fin 4), Work.FoldInst.signVec (sG idx) l = sBitZ idx l := by
  intro idx l
  fin_cases idx <;> fin_cases l <;> rfl

theorem kleinPt_apply (a : Fin 48) (u : CuspE3) (i : Fin 4) :
    kleinPt a u i = (∑ j : Fin 3, ((A10 a i j : ℤ) : ℝ) * u j) / 10
      + ((b10 a i : ℤ) : ℝ) / 10 := by
  simp only [kleinPt, PiLp.toLp_apply, Fin.sum_univ_three, hA10, hb10]
  ring

theorem act_apply (g : Fin 4 → ZMod 2) (y : CuspE4) (i : Fin 4) :
    Work.FoldInst.act g y i = ((Work.FoldInst.signVec g i : ℤ) : ℝ) * y i := by
  simp only [Work.FoldInst.act, Work.HypModel.rot4, Matrix.diagonal, PiLp.toLp_apply,
    Fin.sum_univ_four]
  fin_cases i <;> simp [Work.FoldInst.signVec]

theorem kleinToX_apply (a : Fin 48) (y : CuspE4) (k : Fin 3) :
    kleinToX a y k = (∑ l : Fin 4, ((C16 a k l : ℤ) : ℝ) * y l) / 16
      + ((c16 a k : ℤ) : ℝ) / 16 := by
  simp only [kleinToX, PiLp.toLp_apply, Fin.sum_univ_four, hC16, hc16]
  ring

def NC (a : Fin 48) (idx : Fin 32) (k : Fin 3) (j : Fin 3) : ℤ :=
  ∑ l : Fin 4, C16 (tgt a idx) k l * sBitZ idx l * A10 a l j

def MC (a : Fin 48) (idx : Fin 32) (k : Fin 3) : ℤ :=
  (∑ l : Fin 4, C16 (tgt a idx) k l * sBitZ idx l * b10 a l) + 10 * c16 (tgt a idx) k

theorem sum_swap_mul (F : Fin 4 → ℝ) (G : Fin 4 → Fin 3 → ℝ) (u : Fin 3 → ℝ) :
    (∑ x : Fin 4, F x * (∑ y : Fin 3, G x y * u y))
      = ∑ y : Fin 3, (∑ x : Fin 4, F x * G x y) * u y := by
  simp only [Finset.mul_sum]
  rw [Finset.sum_comm]
  congr 1
  ext y
  rw [Finset.sum_mul]
  congr 1
  ext x
  ring

theorem sum_swap_mul' (F : Fin 4 → ℝ) (G : Fin 4 → Fin 3 → ℝ) (u : Fin 3 → ℝ) (c : Fin 4 → ℝ) :
    (∑ x : Fin 4, F x * ((∑ y : Fin 3, G x y * u y) / 10 + c x / 10))
      = (∑ y : Fin 3, (∑ x : Fin 4, F x * G x y) * u y) / 10
        + (∑ x : Fin 4, F x * c x) / 10 := by
  have h1 : ∀ x : Fin 4, F x * ((∑ y : Fin 3, G x y * u y) / 10 + c x / 10)
      = (F x * (∑ y : Fin 3, G x y * u y)) / 10 + F x * c x / 10 := by
    intro x; ring
  simp only [h1, Finset.sum_add_distrib]
  congr 1
  · rw [← Finset.sum_div]; congr 1
    exact sum_swap_mul F G u
  · rw [← Finset.sum_div]

theorem Gu_eq (a : Fin 48) (idx : Fin 32) (u : CuspE3) (k : Fin 3) :
    160 * (kleinToX (tgt a idx) (Work.FoldInst.act (sG idx) (kleinPt a u))) k
      = (∑ j : Fin 3, ((NC a idx k j : ℤ) : ℝ) * u j) + ((MC a idx k : ℤ) : ℝ) := by
  rw [kleinToX_apply]
  have hcore : ∀ l : Fin 4, Work.FoldInst.act (sG idx) (kleinPt a u) l
      = ((sBitZ idx l : ℤ) : ℝ)
        * ((∑ j : Fin 3, ((A10 a l j : ℤ) : ℝ) * u j) / 10 + ((b10 a l : ℤ) : ℝ) / 10) := by
    intro l
    rw [act_apply, sBitZ_eq, kleinPt_apply]
  rw [show (∑ l : Fin 4,
        ((C16 (tgt a idx) k l : ℤ) : ℝ) * Work.FoldInst.act (sG idx) (kleinPt a u) l)
      = ∑ l : Fin 4, (((C16 (tgt a idx) k l : ℤ) : ℝ) * ((sBitZ idx l : ℤ) : ℝ))
        * ((∑ j : Fin 3, ((A10 a l j : ℤ) : ℝ) * u j) / 10
          + ((b10 a l : ℤ) : ℝ) / 10) from by
    refine Finset.sum_congr rfl (fun l _ => ?_)
    rw [hcore l]
    ring]
  rw [sum_swap_mul' (fun l => ((C16 (tgt a idx) k l : ℤ) : ℝ) * ((sBitZ idx l : ℤ) : ℝ))
    (fun l j => ((A10 a l j : ℤ) : ℝ)) u (fun l => ((b10 a l : ℤ) : ℝ))]
  simp only [NC, MC]
  push_cast
  ring

