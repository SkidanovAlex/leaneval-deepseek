/-
# The injectivity of the ceiling map modulo the cusp lattice

`Work.RTOwed.mbarPt v : E3 → M̄` is the ceiling map of the `v`-th cusp of the truncated 24-cell: it
sends the cusp coordinate `x` to the point of `M̄` with upper half space coordinates `(x, β x)` on
the truncation torus `T_v`.  This file proves that its fibres are exactly the cosets of the cusp
lattice `Λ_v = diag (latMod v) · ℤ³`:

  `Work.RTOwed.mbarPt v x = Work.RTOwed.mbarPt v x' → Work.RTOwed.latVec v (x - x')`.

## The proof

Write `a = cubeOf v x`, `u = redV v x` for the cube of `x` and the representative of `x` in its unit
cube (resp. primed); `u` lies in the *half open* box of `a` (`redV_mem_halfopenBox`) and
`kleinPt a u` is the corresponding point of `Q̄` on the truncation facet of the ideal vertex
`cubeVert a` (`cube_quad`).  The hypothesis `mbarPt v x = mbarPt v x'` says that the two points of
`X̄ = ZMod 2 × Q̄` lie in the same class of `M̄`, i.e. that there is a group element `γ ∈ Gg` with

  `γ · (cubeBit a, kleinPt a u) = (cubeBit a', kleinPt a' u')` and `γ ∈ Ksub (kleinPt a u)`.

Since the action maps the truncation facet of `w` to that of `truncPerm γ.1 w`, both vertices
`cubeVert a'` and `truncPerm γ.1 (cubeVert a)` are tight at the point `kleinPt a' u' ∈ Q̄`; the two
facets of `Q̄` are disjoint (`facet_disjoint`), so they are equal, and with the copy bit this
*determines* `a' = tgt a (gIdx γ)` (`cube_unique`, `tgt_spec`).  Two cases remain:

* `γ = 0`: then `a' = a` and `kleinPt a u = kleinPt a u'`, so `u = u'` (`kleinToX_kleinPt`);
* `γ ≠ 0`: the element `γ` is generated by the types of the sides tight at `kleinPt a u`, and the
  tight sides are the lower walls of the pinned coordinates (`tight_is_wall`), so
  `γ ∈ spanSub a (pinned a u)` (`Ksub_le_spanFin`).  But every nonzero element of that group
  reverses a pinned coordinate, sending the glued point to the *excluded upper end* of the target
  box (`vacuous`, whose two finite inputs are `vac_mem` and `vac_coef`): a contradiction.

Finally `x - x' = (u - u') + intVec (cuspShift v x - cuspShift v x')` (`sub_eq_redV_shift`) with both
terms lattice vectors (`latVec_cuspShift`, `cubeOfMod_corner_dvd`), which gives the claim.
-/
import Mathlib
import Submission.Work.RTOwed.cuspDev
import Submission.Work.RTOwed.cuspCertWalls
import Submission.Work.RTOwed.cuspCert.CuspSupport
import Submission.Work.RTOwed.cuspCert.facet_disjoint

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.RTOwed.cuspCert

open Work.RTOwed

set_option maxHeartbeats 4000000 in
theorem mbarPt_inj : ∀ (v : Fin 5) (x x' : Work.RTOwed.CuspE3),
    Work.RTOwed.mbarPt v x = Work.RTOwed.mbarPt v x' → Work.RTOwed.latVec v (x - x') := by
  intro v x x' h
  have hmem : redV v x ∈ cubeBox (cubeOf v x) := redV_mem_cubeBox v x
  have hmemho : redV v x ∈ halfopenBox (cubeOf v x) := redV_mem_halfopenBox v x
  have hmem' : redV v x' ∈ cubeBox (cubeOf v x') := redV_mem_cubeBox v x'
  have hmemho' : redV v x' ∈ halfopenBox (cubeOf v x') := redV_mem_halfopenBox v x'
  have hy : kleinPt (cubeOf v x) (redV v x) ∈ Work.FoldInst.Qbar := cube_quad.1 _ _ hmem
  have hy' : kleinPt (cubeOf v x') (redV v x') ∈ Work.FoldInst.Qbar := cube_quad.1 _ _ hmem'
  obtain ⟨γ, hγ, hact⟩ : ∃ γ ∈ Work.FoldInst.Ksub (kleinPt (cubeOf v x) (redV v x)),
      Work.FoldInst.actX γ (xbarOf (cubeOf v x) (kleinPt (cubeOf v x) (redV v x)) hy)
        = xbarOf (cubeOf v x') (kleinPt (cubeOf v x') (redV v x')) hy' := by
    have hq : Work.FoldInst.mk (cuspPtX v x) = Work.FoldInst.mk (cuspPtX v x') := h
    have hrel := Work.FoldInst.setoid_iff.mp (Quotient.exact hq)
    rwa [cuspPtX_of_mem v x hy, cuspPtX_of_mem v x' hy'] at hrel
  have hbit : cubeBit (cubeOf v x) + γ.2 = cubeBit (cubeOf v x') := by
    have := congrArg Prod.fst hact
    simpa [xbarOf, Work.FoldInst.actX_fst] using this
  have hklein : Work.FoldInst.act γ.1 (kleinPt (cubeOf v x) (redV v x))
      = kleinPt (cubeOf v x') (redV v x') := by
    have := congrArg (fun z : Work.FoldInst.Xbar => z.2.1) hact
    simpa [xbarOf, Work.FoldInst.actX_snd] using this
  have hmatch : cubeVert (cubeOf v x')
      = Work.FoldInst.truncPerm γ.1 (cubeVert (cubeOf v x)) := by
    have h1 : Work.FoldInst.truncSlack (Work.FoldInst.truncPerm γ.1 (cubeVert (cubeOf v x)))
        (kleinPt (cubeOf v x') (redV v x')) = 0 := by
      rw [← hklein]
      rw [show Work.FoldInst.truncSlack (Work.FoldInst.truncPerm γ.1 (cubeVert (cubeOf v x)))
            (Work.FoldInst.act γ.1 (kleinPt (cubeOf v x) (redV v x)))
          = Work.FoldInst.truncSlack (cubeVert (cubeOf v x))
            (kleinPt (cubeOf v x) (redV v x)) from by
        rw [Work.FoldInst.truncSlack_act, Work.FoldInst.truncPerm_invol]]
      exact cube_quad.2 _ _ hmem
    have h2 : Work.FoldInst.truncSlack (cubeVert (cubeOf v x'))
        (kleinPt (cubeOf v x') (redV v x')) = 0 := cube_quad.2 _ _ hmem'
    by_contra hne
    exact facet_disjoint _ _ hne hy' h2 h1
  have hspec := tgt_spec (cubeOf v x) (gIdx γ)
  have ha'tgt : cubeOf v x' = tgt (cubeOf v x) (gIdx γ) := by
    refine cube_unique _ _ ?_ ?_
    · rw [hmatch, hspec.1, sG_gIdx]
    · rw [← hbit, hspec.2, sFlip_gIdx]
  have hshift : latVec v (intVec (cuspShift v x - cuspShift v x')) := by
    rw [intVec_sub]
    exact latVec_sub (latVec_cuspShift v x) (latVec_cuspShift v x')
  by_cases hγ0 : γ = 0
  · have ha'self : cubeOf v x' = cubeOf v x := by
      refine cube_unique _ _ ?_ ?_
      · rw [hmatch, hγ0]
        change Work.FoldInst.truncPerm (0 : Fin 4 → ZMod 2) (cubeVert (cubeOf v x))
          = cubeVert (cubeOf v x)
        exact truncPerm_zero _
      · rw [← hbit, hγ0]
        simp
    have hk : kleinPt (cubeOf v x) (redV v x) = kleinPt (cubeOf v x) (redV v x') := by
      have h2 := hklein
      rw [hγ0, ha'self] at h2
      rw [show ((0 : Work.FoldInst.Gg)).1 = (0 : Fin 4 → ZMod 2) from rfl,
        Work.FoldInst.act_zero] at h2
      exact h2
    have hu'self : redV v x' = redV v x := by
      calc redV v x' = kleinToX (cubeOf v x) (kleinPt (cubeOf v x) (redV v x')) :=
            (kleinToX_kleinPt (cubeOf v x) (redV v x')).symm
        _ = kleinToX (cubeOf v x) (kleinPt (cubeOf v x) (redV v x)) := by rw [← hk]
        _ = redV v x := kleinToX_kleinPt (cubeOf v x) (redV v x)
    have hdiff : latVec v (redV v x - redV v x') := by
      rw [hu'self]
      intro i
      exact ⟨0, by simp⟩
    rw [sub_eq_redV_shift]
    exact latVec_add hdiff hshift
  · have hspan : γ ∈ spanSub (cubeOf v x) (pinned (cubeOf v x) (redV v x)) :=
      Ksub_le_spanFin (cubeOf v x) hmemho hγ
    refine absurd (vacuous (cubeOf v x) γ (redV v x) hmemho hspan hγ0 ?_) not_false
    rw [← ha'tgt, hklein, kleinToX_kleinPt]
    exact hmemho'

end Work.RTOwed.cuspCert
