import Submission.Work.RTOwed.cuspCert.cube_quad

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The cusp tables of the injectivity certificate

Generated data for `Work.RTOwed.cuspCert.mbarPt_inj`:

* `C16`, `c16`: the integer tables `16 * cubeKleinToX`, `16 * cubeKleinToXb`;
* `tgt a idx`: the cube glued to the cube `a` by the group element of index `idx` (the cube with
  vertex `truncPerm (sG idx) (cubeVert a)` and copy bit `cubeBit a + sFlip idx`);
* `vacI a idx`, `vacK a idx`: for a nonzero group element of index `idx` in the group generated by
  the wall types of `a`, a pinned coordinate `vacI` and a coordinate `vacK` whose image under the
  corresponding gluing sits at the excluded upper end of the target box.
-/

noncomputable section

namespace Work.RTOwed.cuspCert

open Work.FoldInst

/-- The sign of the `i`-th coordinate of the group element of index `idx` (index = `enc g` for the
first 16 indices, `enc g + 16` when the copy bit is `1`). -/
def sBitZ (idx : Fin 32) (i : Fin 4) : ℤ :=
  if (((idx : ℕ) / 2 ^ (i : ℕ)) % 2 = 0) then 1 else -1

/-- The sign pattern `Fin 4 → ZMod 2` of the group element of index `idx`. -/
def sG (idx : Fin 32) : Fin 4 → ZMod 2 :=
  fun i => if (((idx : ℕ) / 2 ^ (i : ℕ)) % 2 = 0) then 0 else 1

/-- The copy bit of the group element of index `idx`. -/
def sFlip (idx : Fin 32) : ZMod 2 := if (idx : ℕ) < 16 then 0 else 1

/-- The index of a group element. -/
def gIdx (γ : Work.FoldInst.Gg) : Fin 32 :=
  ⟨(Work.FoldInst.enc γ.1).val + 16 * (γ.2).val, by
    have h1 : (Work.FoldInst.enc γ.1).val < 16 := (Work.FoldInst.enc γ.1).isLt
    have h2 : (γ.2).val < 2 := (γ.2).isLt
    omega⟩

/-- The group element of index `idx`. -/
def gOf (idx : Fin 32) : Work.FoldInst.Gg := (sG idx, sFlip idx)

