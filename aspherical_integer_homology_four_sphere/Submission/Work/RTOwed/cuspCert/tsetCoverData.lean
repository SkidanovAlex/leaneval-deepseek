/-- The fibre direction of the projection `π_a`: `π_a y = y + truncSlack (cubeVert a) y • projV a`. -/
def projV (a : Fin 48) : CuspE4 := WithLp.toLp 2 fun r : Fin 4 => (projVZ a r : ℝ) / 8

/-- The lattice shift of the neighbour: `λᵢ = latMod vᵢ * covK a e i`. -/
def latOf (a : Fin 48) (e : Fin 8) (i : Fin 3) : ℤ :=
  (Work.Cusp.latMod (Work.Cusp.cubeCusp a) i : ℤ) * covK a e i

/-- The point `x` shifted by the lattice offset of the neighbour cube: `zOf a e x = x − λ`. -/
def zOf (a : Fin 48) (e : Fin 8) (x : CuspE3) : CuspE3 :=
  WithLp.toLp 2 fun i : Fin 3 => x i - (latOf a e i : ℝ)
/-- **The group element gluing the cell of `covB a e` (at the point `z`) to the cell of `a`** (at the
point `x = z + λ`): the sign vector `covS a e` and the copy flip `covF a e`. -/
def covGam (a : Fin 48) (e : Fin 8) : Work.FoldInst.Gg :=
  (Work.FoldInst.toG (covS a e), (covF a e : ZMod 2))

/-- **The saturation region of the cell `a` for the pattern `e`**: the coordinates flagged by `e`
are saturated at the upper corner of the cube box. -/
def Region (a : Fin 48) (e : Fin 8) (x : CuspE3) : Prop :=
  ∀ i : Fin 3, satOf e i = 1 → x i = (Work.Cusp.cubeCorner a i : ℝ) + 1

end Work.RTOwed.cuspCert