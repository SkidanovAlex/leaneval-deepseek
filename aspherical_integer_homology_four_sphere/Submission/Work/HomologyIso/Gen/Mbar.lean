      mbarSDR_checkHom k hk⟩)

/-- **The homology of the complex**: `H_k ≅ ℤ^{mbar k}`. -/
theorem mbarCx_homology (k : ℕ) :
    Nonempty (mbarCx.homology k ≅ ModuleCat.of ℤ (Fin (mbarB k) → ℤ)) :=
  SDR.sound mbarSDR mbarSDR_check k

end Work.HomologyIso.Gen
