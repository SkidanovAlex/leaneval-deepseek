import Mathlib
import Submission.Work.Cohomology.Pullback

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# Naturality of the degree-0 augmentation

For a simplicial set `X` and a coefficient object `R` of a preadditive category with coproducts
and homology, Mathlib provides the augmentation morphism

`X.homology₀ε R : X.homology R 0 ⟶ R`

which is (for `R` the ring of coefficients) the map sending a connected component to `1`.

The purpose of this file is the naturality of that augmentation: for a morphism `f : X ⟶ Y` of
simplicial sets, the induced map on degree-`0` homology followed by the augmentation of `Y` is the
augmentation of `X`.  Through the identification
`TopCat.singularHomology₀ε X R = SSet.homology₀ε (toSSet.obj X) R` and
`chainMap R X Y f = SSet.chainComplexMap (toSSet.map f) R`, this is exactly the statement that
the singular augmentation `H₀(-;R) ⟶ R` is natural, i.e. `epsilonNaturality` below.

The proof rests on the explicit description of `homology₀ε` on homology classes of `0`-simplices
(`SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε`, a Mathlib lemma) together with the fact
that the zeroth cycles of a chain complex are generated by those `0`-simplices
(`Work.Cohomology.liftCycles_ext`).
-/

namespace Work.Cohomology

open CategoryTheory Limits AlgebraicTopology
open scoped Simplicial

universe w u v

section General

variable {C : Type u} [Category.{v} C] [HasCoproducts.{w} C] [Preadditive C]

/-- In a simplicial chain complex over `R`, the zeroth cycles `(X.chainComplex R).cycles 0` are
generated by the images of the `0`-simplices `X _⦋0⦌`.  Concretely, a morphism out of the zeroth
cycles is determined by its composites with `liftCycles (ιChainComplex x)`. -/
lemma liftCycles_ext [CategoryWithHomology C] (X : SSet.{w}) (R : C)
    {u v : (X.chainComplex R).cycles 0 ⟶ R}
    (h : ∀ x : X _⦋0⦌,
      (X.chainComplex R).liftCycles (X.ιChainComplex x) 0 (by simp) (by simp) ≫ u =
      (X.chainComplex R).liftCycles (X.ιChainComplex x) 0 (by simp) (by simp) ≫ v) :
    u = v := by
  -- `iCycles 0 : (X.chainComplex R).cycles 0 ⟶ (X.chainComplex R).X 0` is an isomorphism for a
  -- chain complex indexed by `ℕ`, so a morphism out of the zeroth cycles is equivalently a
  -- morphism out of the zeroth chains, where the `0`-simplices are jointly epimorphic.
  let e := (ChainComplex.cycles₀Iso (X.chainComplex R)).inv
  suffices he : e ≫ u = e ≫ v by exact (cancel_epi e).mp he
  refine SSet.chainComplex_hom_ext (fun x => ?_)
  have hx := h x
  have hl : X.ιChainComplex x ≫ e =
      (X.chainComplex R).liftCycles (X.ιChainComplex x) 0 (by simp) (by simp) := by
    conv_lhs => rw [← HomologicalComplex.liftCycles_i (X.chainComplex R) (X.ιChainComplex x) 0
      (by simp) (by simp)]
    rw [Category.assoc, HomologicalComplex.iCyclesIso_hom_inv_id]
    simp
  rw [← Category.assoc, ← Category.assoc, hl]
  exact hx

/-- Compatibility of the generators of the zeroth cycles with the chain map induced by a morphism
of simplicial sets. -/
lemma liftCycles_cyclesMap_chainComplexMap [CategoryWithHomology C] {X Y : SSet.{w}} (f : X ⟶ Y)
    (R : C) (x : X _⦋0⦌) :
    (X.chainComplex R).liftCycles (X.ιChainComplex x) 0 (by simp) (by simp) ≫
      HomologicalComplex.cyclesMap (SSet.chainComplexMap f R) 0 =
    (Y.chainComplex R).liftCycles (Y.ιChainComplex (f.app _ x)) 0 (by simp) (by simp) := by
  rw [← cancel_mono ((Y.chainComplex R).iCycles 0)]
  rw [Category.assoc, HomologicalComplex.cyclesMap_i]
  rw [← Category.assoc, HomologicalComplex.liftCycles_i, SSet.ι_chainComplexMap_f,
    HomologicalComplex.liftCycles_i]

/-- **Naturality of the degree-`0` augmentation.**  For a morphism `f : X ⟶ Y` of simplicial sets,
the augmentation of `Y` commutes with the map induced by `f` on degree-`0` homology. -/
theorem SSet_homologyMap_homology₀ε [CategoryWithHomology C] {X Y : SSet.{w}} (f : X ⟶ Y) (R : C) :
    SSet.homologyMap f R 0 ≫ SSet.homology₀ε Y R = SSet.homology₀ε X R := by
  -- Test against the generators; we may cancel the epimorphism `homologyπ 0`.
  rw [← cancel_epi ((X.chainComplex R).homologyπ 0)]
  rw [← Category.assoc, HomologicalComplex.homologyπ_naturality, Category.assoc]
  refine liftCycles_ext X R (fun x => ?_)
  rw [← Category.assoc, liftCycles_cyclesMap_chainComplexMap]
  simp only [SSet.liftCycles_ιChainComplex_homologyπ_homology₀ε]

end General

/-- The augmentation `H₀(-; ℤ) ⟶ ℤ` of singular homology is natural. -/
theorem epsilonNaturality (X Y : TopCat) (f : X ⟶ Y) :
    CategoryTheory.CategoryStruct.comp
      (HomologicalComplex.homologyMap (Work.Cohomology.chainMap ℤ X Y f) 0)
      (TopCat.singularHomology₀ε Y (ModuleCat.of ℤ ℤ))
    = TopCat.singularHomology₀ε X (ModuleCat.of ℤ ℤ) := by
  exact SSet_homologyMap_homology₀ε (TopCat.toSSet.map f) (ModuleCat.of ℤ ℤ)

end Work.Cohomology
