import Mathlib
import Submission.Work.Cohomology.SmallChains
import Submission.Work.Cohomology.SdIter
import Submission.Work.Cohomology.sdHomotopy

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# A smallness-preserving chain homotopy from an iterated subdivision to the identity

Let `X` be a topological space, `U V ⊆ X` subsets and `N : ℕ`.  This file proves that there is a
chain homotopy `T` from the `N`-fold barycentric subdivision `sdChainMapIter X N` to the identity of
the singular chain complex `C_*(X; ℤ)` whose homotopy components `C_n(X) ⟶ C_{n+1}(X)` preserve the
**small chains** of the cover `{U, V}` (`IsSmallChain U V`, the submodule of chains generated by the
simplices whose image lies in `U` or in `V`).

This is the "injectivity" half of the small-simplices theorem: given a small cycle `z = ∂w`, one
picks `N` making `Sd^N w` small (the *surjectivity* half, a separate file), and then
`z = ∂(Sd^N w - T z)` exhibits `z` as a small boundary because `T z` is small.

The mathematical point is that the standard cone homotopy `tHom` (`Sd ~ id`,
`Submission/Work/Cohomology/sdHomotopy.lean`) is *local*: the homotopy image of a singular simplex
`σ` is the push-forward `σ_*(cLC n)` of the cone chain along `σ`, so every simplex occurring in it
is of the form `σ ∘ v` and hence has image contained in the image of `σ`.  Consequently `tHom`
carries small chains to small chains, and the same holds for the iterate used to go from `Sd^N` to
the identity.

The proof is organised as follows.

* `IsSmall.comp_sdMap` — the composite of a small simplex with an arbitrary simplex of `Δⁿ` is
  small (its image is contained in the image of the original simplex).
* `IsSmall.range_sdMap_le` / `smallLift` — consequently `sdMap n σ`, viewed as a map of simplicial
  sets, factors through the small subcomplex.
* `pushChain_mem_small` — hence the push-forward of **any** chain of `Δⁿ` along a small `σ` is a
  small chain (this is the locality of `sdElem` and `tElem`).
* `sdElem_mem`, `tElem_mem` — the subdivision of a small simplex and the homotopy image of a small
  simplex are small chains.
* `map_mem_of_gen` — a morphism `C_n(X) ⟶ C_k(X)` that sends the generator of every small simplex
  to a small chain maps small chains to small chains (it factors through the small chains, the
  factor being defined on the free generators of the small chain complex).
* `sdHomotopyLoc` — the explicit chain homotopy `tHom : Sd ~ id` packaged as a `Homotopy`, with
  `sdHomotopyLoc_hom` computing its components; the smallness statement is
  `sdHomotopyLoc_small`.
* `exists_small_homotopy_aux` — the telescoping induction
  `T_N = (T_{N-1} ∘ Sd) + tHom` producing the homotopy from `Sd^N` to the identity together with
  the smallness property; `exists_small_homotopy` is the requested statement.
-/

set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 800000

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

/-! ## 1. Smallness is local: the push-forward along a small simplex -/

/-- The composite of a small singular simplex `σ` with an arbitrary simplex `τ` of `Δⁿ` is small:
the image of `σ ∘ τ` is contained in the image of `σ`, which lies in `U` or in `V`. -/
lemma IsSmall.comp_sdMap {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) (k : ℕ) (τ : Simplex (Delta n) k) :
    IsSmall U V ((TopCat.toSSet.map (sdMap n σ)).app (Opposite.op ⦋k⦌) τ) := by
  rw [isSmall_iff] at hσ ⊢
  have hfun : (fun z : (Delta k : TopCat) =>
      (ConcreteCategory.hom (sdMap k
        ((TopCat.toSSet.map (sdMap n σ)).app (Opposite.op ⦋k⦌) τ))) z)
      = fun z => (ConcreteCategory.hom (sdMap n σ)) ((ConcreteCategory.hom (sdMap k τ)) z) := by
    funext z
    rw [← ConcreteCategory.comp_apply, ← sdMap_map]
  rw [hfun]
  exact hσ.imp (fun h => (Set.range_comp_subset_range _ _).trans h)
    (fun h => (Set.range_comp_subset_range _ _).trans h)

/-- The singular simplicial set of `Δⁿ` maps into the subcomplex of small simplices of `X` as soon
as the singular simplex `σ : Δⁿ ⟶ X` is small. -/
lemma IsSmall.range_sdMap_le {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) :
    SSet.Subcomplex.range (TopCat.toSSet.map (sdMap n σ)) ≤ smallSubcomplex U V := by
  intro m x hx
  rw [Subfunctor.range_obj] at hx
  simp only [Set.mem_range] at hx
  obtain ⟨y, rfl⟩ := hx
  exact hσ.comp_sdMap m.unop.len y

/-- The factorisation of `sdMap n σ` (as a map of simplicial sets) through the small subcomplex,
for a small singular simplex `σ`. -/
noncomputable def IsSmall.smallLift {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) : TopCat.toSSet.obj (Delta n) ⟶ smallSSet U V :=
  SSet.Subcomplex.lift (TopCat.toSSet.map (sdMap n σ)) hσ.range_sdMap_le

lemma IsSmall.smallLift_ι {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) :
    hσ.smallLift ≫ (smallSubcomplex U V).ι = TopCat.toSSet.map (sdMap n σ) :=
  SSet.Subcomplex.lift_ι _ _

lemma IsSmall.smallLift_app {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) (k : ℕ) (τ : Simplex (Delta n) k) :
    (smallSubcomplex U V).ι.app (Opposite.op ⦋k⦌) ((hσ.smallLift).app (Opposite.op ⦋k⦌) τ)
      = (TopCat.toSSet.map (sdMap n σ)).app (Opposite.op ⦋k⦌) τ :=
  congrArg (fun (g : TopCat.toSSet.obj (Delta n) ⟶ TopCat.toSSet.obj X) =>
    g.app (Opposite.op ⦋k⦌) τ) hσ.smallLift_ι

/-- **Locality**: the push-forward of an arbitrary chain of `Δⁿ` along a small singular simplex `σ`
is a small chain of `X`. -/
lemma pushChain_mem_small {X : TopCat} {U V : Set X} {n k : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) (c : (singularChains ℤ (Delta n)).X k) :
    pushChain (Delta n) X (sdMap n σ) k c ∈ smallChainSubmodule U V k := by
  have hfac : pushChainHom (Delta n) X (sdMap n σ) k
      = (SSet.chainComplexMap hσ.smallLift (ModuleCat.of ℤ ℤ)).f k ≫
        (SSet.chainComplexMap (smallSubcomplex U V).ι (ModuleCat.of ℤ ℤ)).f k := by
    apply SSet.chainComplex_hom_ext (X := TopCat.toSSet.obj (Delta n))
    intro τ
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    show (ModuleCat.Hom.hom ((SSet.chainComplexMap (TopCat.toSSet.map (sdMap n σ))
        (ModuleCat.of ℤ ℤ)).f k))
        ((ModuleCat.Hom.hom ((TopCat.toSSet.obj (Delta n)).ιChainComplex
          (R := ModuleCat.of ℤ ℤ) τ)) 1)
      = (ModuleCat.Hom.hom ((SSet.chainComplexMap (smallSubcomplex U V).ι
          (ModuleCat.of ℤ ℤ)).f k))
        ((ModuleCat.Hom.hom ((SSet.chainComplexMap hσ.smallLift
          (ModuleCat.of ℤ ℤ)).f k))
          ((ModuleCat.Hom.hom ((TopCat.toSSet.obj (Delta n)).ιChainComplex
            (R := ModuleCat.of ℤ ℤ) τ)) 1))
    rw [chainComplexMap_ι_apply, chainComplexMap_ι_apply]
    rw [chainComplexMap_ι_apply]
    rw [hσ.smallLift_app k τ]
  refine ⟨ModuleCat.Hom.hom ((SSet.chainComplexMap hσ.smallLift (ModuleCat.of ℤ ℤ)).f k) c, ?_⟩
  have h := congrArg (fun (g : (singularChains ℤ (Delta n)).X k ⟶ (singularChains ℤ X).X k) =>
    ModuleCat.Hom.hom g c) hfac.symm
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  exact h

/-! ## 2. The subdivision and the cone homotopy preserve small chains -/

/-- The subdivision of a small singular simplex is a small chain. -/
lemma sdElem_mem {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) : sdElem X n σ ∈ smallChainSubmodule U V n :=
  pushChain_mem_small hσ (sdChain n)

/-- The homotopy image `tElem X n σ = σ_*(cLC n)` of a small singular simplex is a small chain. -/
lemma tElem_mem {X : TopCat} {U V : Set X} {n : ℕ} {σ : Simplex X n}
    (hσ : IsSmall U V σ) :
    tElem X n σ ∈ smallChainSubmodule U V (n + 1) :=
  pushChain_mem_small hσ (toChain n (n + 1) (cLC n))

lemma smallToSing_ι {X : TopCat} (U V : Set X) (n : ℕ) (x : (smallSSet U V) _⦋n⦌) :
    (ModuleCat.Hom.hom ((smallToSing U V).f n))
      ((ModuleCat.Hom.hom ((smallSSet U V).ιChainComplex (R := ModuleCat.of ℤ ℤ) x)) 1)
      = gen X n x.1 :=
  chainComplexMap_ι_apply (smallSubcomplex U V).ι n x 1

/-- If a morphism `C_n(X) ⟶ C_k(X)` sends the generator of every small simplex to a small chain,
then it maps all small chains to small chains: it factors through the small chain complex, the
factor being defined on the free generators of `C_n` of the small subcomplex. -/
lemma IsSmallChain.map_of_gen {X : TopCat} {U V : Set X} {n k : ℕ}
    (φ : (singularChains ℤ X).X n ⟶ (singularChains ℤ X).X k)
    (hgen : ∀ (σ : Simplex X n), IsSmall U V σ → ∃ c' : (smallChains U V).X k,
      (ModuleCat.Hom.hom ((smallToSing U V).f k)) c' = ModuleCat.Hom.hom φ (gen X n σ)) :
    ∀ c : (singularChains ℤ X).X n, IsSmallChain U V c →
      (φ.hom c) ∈ smallChainSubmodule U V k := by
  classical
  intro c hc
  obtain ⟨c', hc'⟩ := hc
  let legs : ∀ x : (smallSSet U V) _⦋n⦌, ModuleCat.of ℤ ℤ ⟶ (smallChains U V).X k := fun x =>
    ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ (↑((smallChains U V).X k))
      ((Classical.choose (hgen x.1 x.2) : (smallChains U V).X k)))
  let F : ((smallSSet U V).chainComplex (ModuleCat.of ℤ ℤ)).X n ⟶
      (smallChains U V).X k :=
    ((smallSSet U V).isColimitChainComplexXCofan (ModuleCat.of ℤ ℤ) n).desc (Cofan.mk _ legs)
  have hleg : ∀ x, ((smallSSet U V).ιChainComplex (R := ModuleCat.of ℤ ℤ) x) ≫ F = legs x :=
    fun x => Cofan.IsColimit.fac _ _ x
  have hfac : F ≫ (smallToSing U V).f k = (smallToSing U V).f n ≫ φ := by
    apply SSet.chainComplex_hom_ext (X := smallSSet U V)
    intro x
    rw [← Category.assoc, hleg x]
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    simp only [legs, ModuleCat.hom_comp, LinearMap.comp_apply]
    rw [show (ModuleCat.Hom.hom (ModuleCat.ofHom (LinearMap.toSpanSingleton ℤ
        (↑((smallChains U V).X k))
        ((Classical.choose (hgen x.1 x.2) : (smallChains U V).X k))))) 1
        = Classical.choose (hgen x.1 x.2) from by
      rw [ModuleCat.hom_ofHom, LinearMap.toSpanSingleton_apply, one_smul]]
    rw [Classical.choose_spec (hgen x.1 x.2)]
    rw [smallToSing_ι]
  refine ⟨ModuleCat.Hom.hom F c', ?_⟩
  have h := congrArg (fun (g : (smallChains U V).X n ⟶ (singularChains ℤ X).X k) =>
    ModuleCat.Hom.hom g c') hfac
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply] at h
  rw [← hc', h]

/-- The barycentric subdivision maps small chains to small chains. -/
lemma Sd_mem (X : TopCat) (U V : Set X) {n : ℕ} {c : (singularChains ℤ X).X n}
    (hc : IsSmallChain U V c) : IsSmallChain U V (Sd X n c) :=
  IsSmallChain.map_of_gen (sdHom X n) (fun σ hσ => by
    obtain ⟨c', hc'⟩ := sdElem_mem (X := X) hσ
    refine ⟨c', ?_⟩
    rw [hc']
    exact (Sd_gen X n σ).symm) c hc

/-- The homotopy component `tHom X n` maps small chains to small chains. -/
lemma tHom_mem (X : TopCat) (U V : Set X) {n : ℕ} {c : (singularChains ℤ X).X n}
    (hc : IsSmallChain U V c) : IsSmallChain U V ((tHom X n).hom c) :=
  IsSmallChain.map_of_gen (tHom X n) (fun σ hσ => by
    obtain ⟨c', hc'⟩ := tElem_mem (X := X) hσ
    refine ⟨c', ?_⟩
    rw [hc']
    exact (tHom_gen X n σ).symm) c hc

/-! ## 3. The explicit local chain homotopy `Sd ~ id` -/

/-- The difference `sdChainMap X - 𝟙` is the null-homotopic chain map built from the homotopy
components `tRel X`; this is the content of the proof of `sdHomotopy`, recorded in the form needed
to build the homotopy whose components are the maps `tHom X n`. -/
lemma sdChainMap_sub_id_eq_nullHomotopicMap' (X : TopCat) :
    sdChainMap X - 𝟙 (singularChains ℤ X) = Homotopy.nullHomotopicMap' (tRel X) := by
  apply HomologicalComplex.hom_ext
  intro i
  apply SSet.chainComplex_hom_ext (X := TopCat.toSSet.obj X)
  intro σ
  apply ModuleCat.hom_ext
  apply LinearMap.ext_ring
  rcases i with _ | m
  · show (sdChainMap X - 𝟙 (singularChains ℤ X)).f 0 (gen X 0 σ) =
      (Homotopy.nullHomotopicMap' (tRel X)).f 0 (gen X 0 σ)
    have hL : (sdChainMap X - 𝟙 (singularChains ℤ X)).f 0 (gen X 0 σ)
        = sdElem X 0 σ - gen X 0 σ := by
      simp only [HomologicalComplex.sub_f_apply, HomologicalComplex.id_f, ModuleCat.hom_sub,
        LinearMap.sub_apply, ModuleCat.hom_id, LinearMap.id_apply]
      rw [show (sdChainMap X).f 0 (gen X 0 σ) = sdElem X 0 σ from by
        show Sd X 0 (gen X 0 σ) = sdElem X 0 σ
        rw [Sd_gen]]
    rw [hL, tRel_eval_zero, sdElem_zero, sub_self]
  · show (sdChainMap X - 𝟙 (singularChains ℤ X)).f (m + 1) (gen X (m + 1) σ) =
      (Homotopy.nullHomotopicMap' (tRel X)).f (m + 1) (gen X (m + 1) σ)
    have hL : (sdChainMap X - 𝟙 (singularChains ℤ X)).f (m + 1) (gen X (m + 1) σ)
        = sdElem X (m + 1) σ - gen X (m + 1) σ := by
      simp only [HomologicalComplex.sub_f_apply, HomologicalComplex.id_f, ModuleCat.hom_sub,
        LinearMap.sub_apply, ModuleCat.hom_id, LinearMap.id_apply]
      rw [show (sdChainMap X).f (m + 1) (gen X (m + 1) σ) = sdElem X (m + 1) σ from by
        show Sd X (m + 1) (gen X (m + 1) σ) = sdElem X (m + 1) σ
        rw [Sd_gen]]
    rw [hL, tRel_eval X m σ, tElem_boundary X m σ]
    abel

/-- The chain homotopy `Sd ~ id` whose homotopy components are the maps `tHom X n` (hence the
"local", smallness preserving homotopy). -/
noncomputable def sdHomotopyLoc (X : TopCat) :
    Homotopy (sdChainMap X) (𝟙 (singularChains ℤ X)) :=
  (Homotopy.equivSubZero (f := sdChainMap X) (g := 𝟙 (singularChains ℤ X))).symm
    ((Homotopy.ofEq (sdChainMap_sub_id_eq_nullHomotopicMap' X)).trans
      (Homotopy.nullHomotopy' (tRel X)))

/-- The components of `sdHomotopyLoc` are the homotopy components `tHom X n`. -/
lemma sdHomotopyLoc_hom (X : TopCat) (n : ℕ) :
    (sdHomotopyLoc X).hom n (n + 1) = tHom X n := by
  change ((Homotopy.ofEq (sdChainMap_sub_id_eq_nullHomotopicMap' X)).trans
      (Homotopy.nullHomotopy' (tRel X))).hom n (n + 1) = tHom X n
  rw [Homotopy.trans_hom, Homotopy.ofEq_hom, Homotopy.nullHomotopy'_hom]
  simp only [Pi.zero_apply, zero_add]
  rw [dif_pos (show (ComplexShape.down ℕ).Rel (n + 1) n from rfl)]
  exact tRel_self X n _

/-- `sdHomotopyLoc` preserves small chains. -/
lemma sdHomotopyLoc_small (X : TopCat) (U V : Set X) (n : ℕ)
    (c : (singularChains ℤ X).X n) (hc : IsSmallChain U V c) :
    IsSmallChain U V (((sdHomotopyLoc X).hom n (n + 1)).hom c) := by
  rw [sdHomotopyLoc_hom]
  exact tHom_mem X U V hc

/-! ## 4. Iterating -/

/-- The homotopy from `Sd^N` to the identity whose components preserve small chains, obtained from
`sdHomotopyLoc` by the telescoping formula `T_N = (T_{N-1} ∘ Sd) + tHom`. -/
theorem exists_small_homotopy_aux (X : TopCat) (U V : Set X) (N : ℕ) :
    ∃ T : Homotopy (sdChainMapIter X N) (𝟙 (singularChains ℤ X)),
      ∀ (n : ℕ) (c : (singularChains ℤ X).X n), IsSmallChain U V c →
          IsSmallChain U V ((T.hom n (n + 1)).hom c) := by
  induction N with
  | zero =>
    refine ⟨Homotopy.refl (sdChainMapIter X 0), ?_⟩
    intro n c hc
    rw [Homotopy.refl_hom]
    simp
  | succ N ih =>
    obtain ⟨T, hT⟩ := ih
    refine ⟨(T.compRightId (sdChainMap X)).trans (sdHomotopyLoc X), ?_⟩
    intro n c hc
    rw [Homotopy.trans_hom, Homotopy.compRightId_hom, sdHomotopyLoc_hom]
    have hsum : IsSmallChain U V
        ((Sd X (n + 1)) ((T.hom n (n + 1)).hom c) + (tHom X n).hom c) :=
      IsSmallChain.add (Sd_mem X U V (hT n c hc)) (tHom_mem X U V hc)
    convert hsum using 1
    simp only [ModuleCat.hom_add, LinearMap.add_apply, ModuleCat.hom_comp, LinearMap.comp_apply]
    rfl

theorem exists_small_homotopy (X : TopCat) (U V : Set X) (N : ℕ) :
    ∃ T : Homotopy (sdChainMapIter X N)
        (CategoryTheory.CategoryStruct.id (singularChains ℤ X)),
      ∀ (n : ℕ) (c : (singularChains ℤ X).X n), IsSmallChain U V c →
          IsSmallChain U V ((T.hom n (n + 1)).hom c) :=
  exists_small_homotopy_aux X U V N

end

end Work.Cohomology
