import Submission.Work.Cohomology.Subdivision
import Submission.Work.Cohomology.Sd_comm

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# The subdivision operator as a chain map

`Sd_comm` (`Submission/Work/Cohomology/Sd_comm.lean`) proves that the subdivision operator `Sd`
defined in `Submission/Work/Cohomology/Subdivision.lean` commutes with the singular differential.
This file packages it as a morphism of chain complexes,

`sdChainMap X : singularChains ℤ X ⟶ singularChains ℤ X`,

the endomorphism of the singular chain complex (with `ℤ` coefficients) which is the subject of the
small-simplices theorem: for an open cover `{U,V}` of `X` some iterate of `sdChainMap X` maps all
chains into the subcomplex generated by simplices lying in `U` or in `V`, and `sdChainMap X` is
chain homotopic to the identity (the homotopy is delegated separately).
-/

set_option backward.isDefEq.respectTransparency false

open CategoryTheory AlgebraicTopology Simplicial Limits
open scoped Simplicial

namespace Work.Cohomology

noncomputable section

/-- **The subdivision operator as a chain map** on the singular chains, with `ℤ` coefficients. -/
def sdChainMap (X : TopCat) : singularChains ℤ X ⟶ singularChains ℤ X where
  f n := sdHom X n
  comm' i j hij := by
    obtain rfl : i = j + 1 := hij.symm
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro c
    exact (Sd_comm X j c).symm

end

end Work.Cohomology
