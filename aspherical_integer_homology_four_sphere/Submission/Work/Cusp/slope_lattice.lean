/-
# The cusp lattice in the `(σ_v, λ₂, λ₃)`-coordinates

The cusp lattice is defined as the subgroup generated by the three lattice vectors `κ_{v,1}`,
`κ_{v,2}`, `κ_{v,3}` (`Basic.lattice`).  The meridian σ_v = κ_{v,1} + b_v κ_{v,2} + c_v κ_{v,3}
(with `c_v = 0`) completes with λ₂ = κ_{v,2}, λ₃ = κ_{v,3} to a *basis* of the same lattice over ℤ:

  `lattice v = AddSubgroup.closure {σ_v, λ₂, λ₃}`,

because `σ_v = κ_{v,1} + b_v κ_{v,2}` and `b_v ∈ ℤ` (`slopeB`, `slopeC` are ℤ-valued, `slopeC = 0`).
This is the "`(σ_v, λ₂, λ₃)`-coordinates" of the contract's `τ_v`: the cusp torus `ℝ³/Λ_v` is the
cube `(ℝ/ℤ)³` in those coordinates.
-/
import Mathlib
import Submission.Work.Cusp.Basic

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option linter.unusedSimpArgs false

noncomputable section

open Set Topology Function
open scoped Real InnerProductSpace

namespace Work.Cusp

/-- `c_v = slopeC v = 0`: the meridian lies in the coordinate plane of `κ_{v,1}, κ_{v,2}`. -/
theorem slopeC_eq_zero (v : Fin 5) : slopeC v = 0 := by fin_cases v <;> rfl

/-- **`σ_v` in the `κ`-basis**: `σ_v = κ_{v,1} + b_v κ_{v,2}`. -/
theorem slope_eq_kv (v : Fin 5) :
    slope v = (1 : ℤ) • kv v 0 + (slopeB v) • kv v 1 := by
  ext j
  fin_cases j <;>
  · simp only [slope, kv, PiLp.add_apply, PiLp.smul_apply, zsmul_eq_mul, slopeC_eq_zero,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
      Matrix.tail_cons, Fin.reduceFinMk]
    push_cast
    ring

/-- **`κ_{v,1} = σ_v − b_v κ_{v,2}`** (the inverse change of basis). -/
theorem kv_zero_eq_slope (v : Fin 5) :
    kv v 0 = (1 : ℤ) • slope v + (-(slopeB v)) • lam2 v := by
  ext j
  fin_cases j <;>
  · simp only [slope, lam2, kv, PiLp.add_apply, PiLp.smul_apply, zsmul_eq_mul, slopeC_eq_zero,
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
      Matrix.tail_cons, Fin.reduceFinMk]
    push_cast
    ring

/-- **The cusp lattice in the meridian coordinates**: `Λ_v` is generated by `σ_v`, `λ₂` and `λ₃`. -/
theorem lattice_eq_closure_slope (v : Fin 5) :
    lattice v = AddSubgroup.closure ({slope v, lam2 v, lam3 v} : Set E3) := by
  have hmem : ∀ x : E3, x ∈ ({slope v, lam2 v, lam3 v} : Set E3) →
      x ∈ AddSubgroup.closure ({slope v, lam2 v, lam3 v} : Set E3) :=
    fun x hx => AddSubgroup.subset_closure hx
  refine le_antisymm ?_ ?_
  · rw [lattice, AddSubgroup.closure_le]
    rintro d ⟨i, rfl⟩
    have h2 : kv v 1 = lam2 v := rfl
    have h3 : kv v 2 = lam3 v := rfl
    fin_cases i
    · change kv v 0 ∈ AddSubgroup.closure ({slope v, lam2 v, lam3 v} : Set E3)
      rw [kv_zero_eq_slope]
      exact add_mem (zsmul_mem (hmem _ (by simp)) 1)
        (zsmul_mem (hmem _ (by simp)) (-(slopeB v)))
    · change kv v 1 ∈ AddSubgroup.closure ({slope v, lam2 v, lam3 v} : Set E3)
      rw [h2]
      exact hmem _ (by simp)
    · change kv v 2 ∈ AddSubgroup.closure ({slope v, lam2 v, lam3 v} : Set E3)
      rw [h3]
      exact hmem _ (by simp)
  · rw [AddSubgroup.closure_le]
    intro d hd
    rcases hd with rfl | rfl | rfl
    · rw [slope_eq_kv]
      exact add_mem (zsmul_mem (AddSubgroup.subset_closure (Set.mem_range_self 0)) 1)
        (zsmul_mem (AddSubgroup.subset_closure (Set.mem_range_self 1)) (slopeB v))
    · exact AddSubgroup.subset_closure (Set.mem_range_self 1)
    · exact AddSubgroup.subset_closure (Set.mem_range_self 2)

end Work.Cusp
