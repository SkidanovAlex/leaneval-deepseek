/-
# Periodicity of the ceiling map `mbarPt` under the cusp lattice

`Work.Cusp.CuspGlueData` gives, for the `v`-th cusp, the ceiling map `mbarPt : E3 → M̄` of the
truncation torus: the point of `M̄` with UHS coordinates `(x, β x)`.  The truncation torus is the
cusp torus `ℝ³/Λ_v` (`lattice v = Λ_v = ⟨κ_{v,1}, κ_{v,2}, κ_{v,3}⟩`), so the ceiling map must be
invariant under the lattice:

  `mbarPt (x + l) = mbarPt x`  for `l ∈ Λ_v`.

This is what makes the ceiling map descend to `τ_v : ℝ³/Λ_v → T_v` and, in particular, makes the
AddCircle-lift `cuspTau` of the ceiling map continuous (the endpoints of the fundamental cube agree).

## The proof

`mbarPt x = mbarLow (ceilingPt x)` and the ceiling point over `x` lies on the cusped boundary
`Tset`, where it is glued to the filling boundary point of coordinates `(outerU v x, outerY v x)`
(`incMbar_mbarPt_eq`).  Since `incMbar` is injective (`Assembly.incMbar_injective`), it suffices to
compare those filling boundary points.  Writing `l ∈ Λ_v` as an integer combination of the `κ_{v,i}`,
one computes (with `κ_{v,1} = σ_v − b_v κ_{v,2}`, `κ_{v,2} = λ₂`, `κ_{v,3} = λ₃`, the lattice basis
being orthogonal):

* `outerU v (x + κ_{v,i}) = outerU v x + δ_{i,1}`,
* `outerY v (x + κ_{v,i}) = outerY v x + (δ_{i,2} − b_v δ_{i,1}, δ_{i,3})`,

so the meridian parameter moves by the integer `δ_{i,1}` (invisible under the `1`-periodic `bndOfU`
and under the class in `AddCircle 1`) and the two torus coordinates move by the integers
`δ_{i,2} − b_v δ_{i,1}` and `δ_{i,3}` (again invisible in `AddCircle 1`).  The set of periods of
`mbarPt` is an additive subgroup of `E3` (as for `β`, see `beta_lattice_periodic`), so the result
follows for all of `Λ_v = AddSubgroup.closure (Set.range (kv v))`.
-/
import Mathlib
import Submission.Work.Cusp.Assembly
import Submission.Work.Cusp.Basic
import Submission.Work.Cusp.bndOfU_add_int
import Submission.Work.Cusp.cuspCoordM_continuous

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


noncomputable section

open scoped Real InnerProductSpace

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false

namespace Work.Cusp

/-! ### Integer shifts in `AddCircle 1` -/

/-- The class of an integer in `AddCircle (1 : ℝ)` is zero: `AddCircle` is `ℝ` modulo the
subgroup generated by `1`. -/
lemma addCircle_coe_int_eq_zero (m : ℤ) : ((m : ℝ) : AddCircle (1 : ℝ)) = 0 := by
  rw [AddCircle.coe_eq_zero_iff]
  exact ⟨m, by simp⟩

/-- Adding an integer to a real does not change its class in `AddCircle (1 : ℝ)`. -/
lemma addCircle_coe_add_int (y : ℝ) (m : ℤ) :
    ((y + (m : ℝ) : ℝ) : AddCircle (1 : ℝ)) = (y : AddCircle (1 : ℝ)) := by
  rw [AddCircle.coe_add, addCircle_coe_int_eq_zero, add_zero]

/-! ### The `κ`-coordinates of the lattice generators -/

/-- `kappaCoord` is additive in its last argument (the `κ_{v,i}`-coordinate of `x`). -/
lemma kappaCoord_add (v : Fin 5) (i : Fin 3) (x y : E3) :
    kappaCoord v i (x + y) = kappaCoord v i x + kappaCoord v i y := by
  rw [kappaCoord, kappaCoord, kappaCoord, inner_add_left, add_div]

/-- The `κ_{v,i}`-coordinate of the generator `κ_{v,j}` is `δ_{i,j}` (the `κ_{v,i}` are an
orthogonal basis): this is the metric content of the whole file, and it is a finite computation
on the explicit integral data `Data.kappa`. -/
lemma kappaCoord_kv (v : Fin 5) (i j : Fin 3) :
    kappaCoord v i (kv v j) = if i = j then 1 else 0 := by
  fin_cases v <;> fin_cases i <;> fin_cases j <;>
    simp [kappaCoord, kv, kappa, PiLp.inner_apply, Fin.sum_univ_three, PiLp.norm_sq_eq_of_L2]

/-! ### The meridian coordinate `outerU` -/

/-- **`outerU` shifts by `δ_{i,1}` under a generator**: the `κ_{v,1}`-coordinate of
`x + κ_{v,i}` is the one of `x` plus `1` exactly when `i = 1` (i.e. `i = 0 : Fin 3`). -/
lemma outerU_add_kv (v : Fin 5) (i : Fin 3) (x : E3) :
    outerU v (x + kv v i) = outerU v x + (if (0 : Fin 3) = i then (1 : ℝ) else 0) := by
  show kappaCoord v 0 (x + kv v i) = kappaCoord v 0 x + (if (0 : Fin 3) = i then (1 : ℝ) else 0)
  rw [kappaCoord_add, kappaCoord_kv]

/-- The same, with the shift written as an integer. -/
lemma outerU_add_kv_int (v : Fin 5) (i : Fin 3) (x : E3) :
    outerU v (x + kv v i)
      = outerU v x + (((if (0 : Fin 3) = i then (1 : ℤ) else 0) : ℤ) : ℝ) := by
  rw [outerU_add_kv]
  congr 1
  by_cases h : (0 : Fin 3) = i <;> simp [h]

/-! ### The torus coordinates `outerY` -/

/-- **The first torus coordinate shifts by `δ_{i,2} − b_v δ_{i,1}` under a generator**. -/
lemma outerY_add_kv_fst_int (v : Fin 5) (i : Fin 3) (x : E3) :
    (outerY v (x + kv v i)) 0
      = (outerY v x) 0 + ((((if (1 : Fin 3) = i then (1 : ℤ) else 0)
          - slopeB v * (if (0 : Fin 3) = i then (1 : ℤ) else 0)) : ℤ) : ℝ) := by
  simp only [outerY, outerU_add_kv, kappaCoord_add, kappaCoord_kv, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons] <;> push_cast <;> ring

/-- **The second torus coordinate shifts by `δ_{i,3}` under a generator**. -/
lemma outerY_add_kv_snd_int (v : Fin 5) (i : Fin 3) (x : E3) :
    (outerY v (x + kv v i)) 1
      = (outerY v x) 1 + (((if (2 : Fin 3) = i then (1 : ℤ) else 0) : ℤ) : ℝ) := by
  simp only [outerY, kappaCoord_add, kappaCoord_kv, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.head_cons] <;> push_cast <;> ring

/-! ### The generator periods of `mbarPt` -/

/-- **`mbarPt` is invariant under each lattice generator `κ_{v,i}`.**  Both sides are glued to
filling boundary points whose coordinates agree: the meridian parameters differ by the integer
`δ_{i,1}`, hence have the same `bndOfU`, and the two torus coordinates differ by integers, hence
have the same class in `AddCircle 1`. -/
lemma mbarPt_add_kv (a : Work.Space.Assembly) (v : Work.Space.Cusp) (D : CuspGlueData a v)
    (i : Fin 3) (x : E3) : D.mbarPt (x + kv v i) = D.mbarPt x := by
  apply a.incMbar_injective
  rw [incMbar_mbarPt_eq a v D (x + kv v i), incMbar_mbarPt_eq a v D x]
  refine incW_pair_congr a v ?_ ?_
  · show bndOfU (outerU v (x + kv v i)) = bndOfU (outerU v x)
    rw [outerU_add_kv_int]
    exact bndOfU_add_int (outerU v x) _
  · refine congrArg D.tor.symm ?_
    funext j
    fin_cases j
    · show (((outerY v (x + kv v i)) 0 : ℝ) : AddCircle (1 : ℝ))
        = (((outerY v x) 0 : ℝ) : AddCircle (1 : ℝ))
      rw [outerY_add_kv_fst_int]
      exact addCircle_coe_add_int _ _
    · show (((outerY v (x + kv v i)) 1 : ℝ) : AddCircle (1 : ℝ))
        = (((outerY v x) 1 : ℝ) : AddCircle (1 : ℝ))
      rw [outerY_add_kv_snd_int]
      exact addCircle_coe_add_int _ _

/-! ### The period subgroup -/

/-- The set of periods of `mbarPt` is an additive subgroup of `E3` (exactly as for `β`, see
`beta_lattice_periodic`): `0` is a period, and both `l₁ + l₂` and `-l₁` are periods when `l₁`,
`l₂` are. -/
def mbarPtPeriodSub (a : Work.Space.Assembly) (v : Work.Space.Cusp) (D : CuspGlueData a v) :
    AddSubgroup E3 where
  carrier := {l | ∀ x, D.mbarPt (x + l) = D.mbarPt x}
  zero_mem' := by intro x; simp
  add_mem' := by
    intro p q hp hq x
    rw [← add_assoc, hq (x + p), hp x]
  neg_mem' := by
    intro p hp x
    have h := hp (x + -p)
    rw [add_assoc, neg_add_cancel, add_zero] at h
    exact h.symm

/-- Every lattice generator `κ_{v,i}` is a period of `mbarPt`. -/
lemma kv_mem_mbarPtPeriodSub (a : Work.Space.Assembly) (v : Work.Space.Cusp)
    (D : CuspGlueData a v) : Set.range (kv v) ⊆ (mbarPtPeriodSub a v D : Set E3) := by
  rintro d ⟨i, rfl⟩
  exact mbarPt_add_kv a v D i

/-- **The ceiling map `mbarPt` is invariant under the cusp lattice** `Λ_v`: the ceiling point over
`x + l` and over `x` are the same point of the truncation torus. -/
theorem mbarPt_periodic (a : Work.Space.Assembly) (v : Work.Space.Cusp) (D : CuspGlueData a v)
    (x : E3) (l : E3) (hl : l ∈ lattice v) : D.mbarPt (x + l) = D.mbarPt x :=
  (AddSubgroup.closure_le (mbarPtPeriodSub a v D) |>.mpr (kv_mem_mbarPtPeriodSub a v D)) hl x

end Work.Cusp
