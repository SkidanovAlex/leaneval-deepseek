/-- The list of facets of a face of `Q̄`, read off from the generated data `qFacetLRows`.

The lookup is hierarchical (`x.val / 32`, `x.val % 32`) so that the kernel evaluates it in
about `50` reduction steps rather than `865`. -/
def qFacetL (x : Fin 865) : List (Fin 865) :=
  (qFacetLRows.getD (x.val / 32) []).getD (x.val % 32) []

/-- **Soundness of the list of facets**: `qFacetL x` enumerates exactly `qFacet x`. -/
theorem qFacetL_toFinset_fun : ∀ x : Fin 865, (qFacetL x).toFinset = qFacet x := by
  decide

/-- The facet list has no repeated element. -/
theorem qFacetL_nodup_fun : ∀ x : Fin 865, (qFacetL x).Nodup := by
  decide

theorem qFacetL_toFinset (x : Fin 865) : (qFacetL x).toFinset = qFacet x :=
  qFacetL_toFinset_fun x

theorem qFacetL_nodup (x : Fin 865) : (qFacetL x).Nodup := qFacetL_nodup_fun x

/-- Membership in the facet list, transported to `qFacet`. -/
theorem mem_qFacetL_iff {x y : Fin 865} : y ∈ qFacetL x ↔ y ∈ qFacet x := by
  rw [← List.mem_toFinset, qFacetL_toFinset]

end Work.MbarHomology.BdFiber
