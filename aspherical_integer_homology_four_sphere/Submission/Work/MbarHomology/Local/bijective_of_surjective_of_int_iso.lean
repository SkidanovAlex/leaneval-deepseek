import Mathlib
import Submission.Work.MbarHomology.Local.SupportCx

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


namespace Work.MbarHomology.Local

universe u

/-- A surjective `ℤ`-linear map between two `ℤ`-modules that are each isomorphic to `ℤ`
is automatically injective (hence bijective).

Concretely: `M` is generated by `x = e.symm 1`, so every `m` is an integral multiple of `x`;
composing `f` with the isomorphism `g : N ≃ₗ[ℤ] ℤ` yields a surjective `ℤ`-linear map `h : M → ℤ`,
and surjectivity forces `h x` to be a unit of `ℤ`, whence `h m = 0 → m = 0`. -/
theorem bijective_of_surjective_of_int_iso {M N : Type u} [AddCommGroup M] [Module ℤ M] [AddCommGroup N] [Module ℤ N] (hM : Nonempty (M ≃ₗ[ℤ] ℤ)) (hN : Nonempty (N ≃ₗ[ℤ] ℤ)) (f : M →ₗ[ℤ] N) (hf : Function.Surjective f) : Function.Bijective f := by
  obtain ⟨e⟩ := hM
  obtain ⟨g⟩ := hN
  -- `x` generates `M` as a `ℤ`-module.
  set x : M := e.symm 1 with hxdef
  have hrepr : ∀ m : M, m = (e m) • x := by
    intro m
    have h1 : (e m) • x = e.symm (e m) := by
      rw [hxdef]
      rw [← map_zsmul e.symm (e m) 1]
      have h2 : (e m) • (1 : ℤ) = e m := by rw [zsmul_eq_mul]; simp
      rw [h2, e.symm_apply_apply]
    rw [h1, e.symm_apply_apply]
  -- `h = g ∘ f : M → ℤ` is surjective.
  have hsurj : Function.Surjective (g.toLinearMap.comp f) := by
    intro n
    obtain ⟨m, hm⟩ := hf (g.symm n)
    exact ⟨m, by simp [LinearMap.comp_apply, hm]⟩
  let c : ℤ := (g.toLinearMap.comp f) x
  obtain ⟨m₀, hm₀⟩ := hsurj 1
  have hcomp : ∀ m : M, (g.toLinearMap.comp f) m = (e m) • c := by
    intro m
    conv_lhs => rw [hrepr m]
    rw [map_zsmul]
  -- `c = h x` is a unit of `ℤ`, since `1 = h m₀ = (e m₀) · c`.
  have hck : c * (e m₀) = 1 := by
    have h := hcomp m₀
    rw [hm₀] at h
    rw [zsmul_eq_mul] at h
    simp only [Int.cast_id] at h
    calc c * (e m₀) = (e m₀) * c := mul_comm _ _
      _ = 1 := h.symm
  -- hence `f` is injective
  have hkey : ∀ m : M, f m = 0 → m = 0 := by
    intro m hfm
    have hm0 : (g.toLinearMap.comp f) m = 0 := by
      rw [LinearMap.comp_apply, hfm]; exact map_zero g
    have hmc : (e m) * c = 0 := by
      rw [hcomp m] at hm0
      rw [zsmul_eq_mul] at hm0
      simpa only [Int.cast_id] using hm0
    have hem : e m = 0 := by
      calc e m = (e m) * 1 := (mul_one _).symm
        _ = (e m) * (c * (e m₀)) := by rw [hck]
        _ = ((e m) * c) * (e m₀) := by rw [mul_assoc]
        _ = 0 := by rw [hmc, zero_mul]
    have h2 : e.symm (e m) = e.symm 0 := congrArg e.symm hem
    rw [e.symm_apply_apply m] at h2
    simpa using h2
  exact ⟨fun a b hab => by
    have h : f (a - b) = 0 := by rw [map_sub, hab, sub_self]
    have := hkey (a - b) h
    rwa [sub_eq_zero] at this, hf⟩

end Work.MbarHomology.Local
