/-
# The pieces of a stage step, identified with the local models

For a `PolyCW` `P`, a cell `a` and a stage `T` of `a` (`PolyCW.IsStage`), the two
support filtrations of `StageCx.lean` refine to the relative pieces

* `cellPieceS P hdd a h` — the relative cellular subcomplex of `cellS (insert a T)`
  over `cellS T`, and
* `sdPieceS P a h` — the relative subdivided subcomplex of `sdS (insert a T)` over
  `sdS T`.

This file identifies their quotients with the local models

* `(cellPieceS P hdd a h).quot ≅ unitCx (P.dim a)` (`cellPieceSIso`), and
* `(sdPieceS P a h).quot ≅ locCx P a` (`sdPieceSIso`),

and computes the map induced by the subdivision on these quotients: up to these
identifications it is the local map `locMap P hdd haug a` of the cell
(`cellPieceSMap_stageQuotMap`, whose two `Iso`s are the input of
`stageQuotMap_eq_locMap`).

The mathematical content is the second isomorphism theorem at the two stages: in
degree `k`

* `sdSMod (insert a T) k = sdSMod T k ⊔ leSub a k` and
  `sdSMod T k ⊓ leSub a k = ltSub a k` (`sdSMod_insert`, `sdSMod_inf_leSub`), so
  the quotient is the local module `locMod a k = leSub a k ⧸ ltSub a k`, and
* in degree `P.dim a` `cellSMod (insert a T) (P.dim a)` is
  `cellSMod T (P.dim a)` plus the line spanned by the new cell `a`, meeting it
  trivially (`cellSMod_insert_eq`, `cellSMod_inf_span`), so the quotient is `ℤ`
  generated by the class of `a`.

This is the support-form analogue of `Work.Subdivision.PieceQuot`/`PieceIso`/
`PieceSquare`.
-/
import Mathlib
import Submission.Work.MbarHomology.Local.StageCx
import Submission.Work.Subdivision.PieceSquare

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option autoImplicit false

namespace Work.Subdivision

open CategoryTheory

universe u

noncomputable section

namespace PolyCW

variable (P : PolyCW.{u})

set_option allowUnsafeReducibility true
attribute [local reducible] cellChain sdChain cellS sdS cellSMod sdSMod leSub ltSub
  SubData.chain SubData.quot SubData.quotOf PolyCW.icF PolyCW.ioF

/-! ### The generator map of a `ℤ`-module -/

/-- The value of `spanMap x` on a lifted integer, as the value of the underlying
`toSpanSingleton`. -/
theorem spanMap_apply_ulift {M : ModuleCat ℤ} (x : M) (c : ℤ) :
    spanMap x (ULift.up c) = (LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) x) c := rfl

/-! ### The cellular piece of a stage step -/

/-- The generator of the cellular piece of a stage step: the class of the new cell
in the quotient `cellSMod (insert a T) (P.dim a) ⧸ cellSMod T (P.dim a)`. -/
noncomputable def cellPieceSGen (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) : ((cellPieceS P hdd a h).quot).X (P.dim a) :=
  Submodule.Quotient.mk
    (⟨cellElem P hdd (P.dim a) ⟨a, rfl⟩,
      cellElem_mem_cellSMod P hdd (insert a T) (P.dim a) ⟨a, rfl⟩
        (Finset.mem_insert_self a T)⟩ :
      ↥(cellSMod P hdd (insert a T) (P.dim a)))

/-- The coefficient map `ℤ → (cellPieceS).quot.X (P.dim a)`, `1 ↦ [a]`. -/
noncomputable def cellPieceSCoeffF (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) : unitMod.{u} ⟶ ((cellPieceS P hdd a h).quot).X (P.dim a) :=
  spanMap (cellPieceSGen P hdd a h)

@[simp] theorem cellPieceSCoeffF_one (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) :
    (cellPieceSCoeffF P hdd a h) (ULift.up (1 : ℤ)) = cellPieceSGen P hdd a h :=
  spanMap_one _

/-- The cellular piece of a stage step is trivial away from the degree of the new
cell: there the two cellular filtrations agree. -/
theorem cellPieceS_subsingleton (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) {k : ℕ} (hk : k ≠ P.dim a) :
    Subsingleton ((cellPieceS P hdd a h).quot.X k) := by
  have hsub : (cellPieceS P hdd a h).sub k = ⊤ := by
    refine eq_top_iff.mpr fun x _ => Submodule.mem_comap.mpr ?_
    have hx : (x : (cellChain P hdd).X k) ∈ cellSMod P hdd (insert a T) k := x.2
    rw [cellSMod_insert_of_ne P hdd h hk] at hx
    exact hx
  exact subsingleton_quotient_of_eq_top hsub

/-- In the degree of the new cell, the cellular filtration of the stage meets the
line spanned by the new cell trivially. -/
theorem cellSMod_inf_span_cellElem (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) :
    cellSMod P hdd T (P.dim a) ⊓
      Submodule.span ℤ ({cellElem P hdd (P.dim a) ⟨a, rfl⟩} :
        Set ((cellChain P hdd).X (P.dim a))) = ⊥ := by
  have hset : cellSMod P hdd T (P.dim a) =
      Submodule.span ℤ {v : {e : P.Cell // P.dim e = P.dim a} →₀ ℤ |
        ∃ i : {e : P.Cell // P.dim e = P.dim a}, i.1 ∈ T ∧ v = Finsupp.single i 1} := rfl
  rw [hset]
  exact span_single_inf_span_single _
    {i : {e : P.Cell // P.dim e = P.dim a} | i.1 ∈ T} ⟨a, rfl⟩ (by simpa using h.notMem)

/-- The identification of the cellular piece of a stage step with the model
complex `unitCx (P.dim a)`, as a chain map sending the generator to the class of
the new cell. -/
noncomputable def cellPieceSMap (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) : unitCx (P.dim a) ⟶ (cellPieceS P hdd a h).quot :=
  HomologicalComplex.mkHomFromSingle (K := (cellPieceS P hdd a h).quot) (j := P.dim a)
    (A := unitMod.{u}) (cellPieceSCoeffF P hdd a h)
    (fun k hk => by
      haveI : Subsingleton ((cellPieceS P hdd a h).quot.X k) :=
        cellPieceS_subsingleton P hdd a h (by
          have h2 : k + 1 = P.dim a := hk
          omega)
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      exact Subsingleton.elim _ _)

/-- In the degree of the new cell, the cellular piece map is the canonical
inclusion of the model complex composed with the coefficient map. -/
theorem cellPieceSMap_f_self (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) :
    (cellPieceSMap P hdd a h).f (P.dim a) =
      (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) (P.dim a) unitMod.{u}).hom ≫
        cellPieceSCoeffF P hdd a h :=
  HomologicalComplex.mkHomFromSingle_f _ _

/-! ### The subdivided piece of a stage step -/

/-- The inclusion `leSub a k ↪ sdSMod (insert a T) k`, over the plain chain module. -/
noncomputable abbrev sdSInc {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    ↥(leSub P a k) →ₗ[ℤ] ↥(sdSMod P (insert a T) k) :=
  Submodule.inclusion (R := ℤ) (M := chainMod P.Cell k) (p := leSub P a k)
    (p' := sdSMod P (insert a T) k) (leSub_le_sdSMod_insert P h k)

@[simp] theorem sdSInc_apply {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ)
    (x : ↥(leSub P a k)) :
    (sdSInc P h k x : ↥(sdSMod P (insert a T) k)) =
      (⟨(x : chainMod P.Cell k), leSub_le_sdSMod_insert P h k x.2⟩ :
        ↥(sdSMod P (insert a T) k)) := rfl

/-- The inclusion `leSub a k ↪ sdSMod (insert a T) k` carries `ltSub a k` into the
rejected submodule `sdSMod T k`. -/
theorem leSub_le_sdPieceS_sub {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    locRel P a k ≤ ((sdPieceS P a h).sub k).comap (sdSInc P h k) := by
  intro x hx
  have hx' : (x : chainMod P.Cell k) ∈ ltSub P a k := hx
  have hmem : (x : chainMod P.Cell k) ∈ sdSMod P T k := ltSub_le_sdSMod P h k hx'
  refine Submodule.mem_comap.mpr ?_
  show (sdSInc P h k x : ↥(sdSMod P (insert a T) k)) ∈ (sdPieceS P a h).sub k
  rw [sdSInc_apply]
  exact hmem

/-- The identification of the local module `locMod a k` of the new cell with the
quotient of the refined subdivided filtration by the unrefined one, in degree `k`
(second isomorphism theorem, in the form of `Submodule.mapQ`). -/
noncomputable def sdPieceSMapLin {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    locMod P a k →ₗ[ℤ] ((sdS P (insert a T)).chain.X k ⧸ (sdPieceS P a h).sub k) :=
  Submodule.mapQ (locRel P a k) ((sdPieceS P a h).sub k) (sdSInc P h k)
    (leSub_le_sdPieceS_sub P h k)

/-- The computation rule: on the class of a chain supported below `a`, the map
`sdPieceSMapLin` is again that class. -/
theorem sdPieceSMapLin_apply {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ)
    (y : ↥(leSub P a k)) :
    sdPieceSMapLin P h k (Submodule.Quotient.mk y) =
      (Submodule.Quotient.mk (sdSInc P h k y) : ((sdPieceS P a h).quot).X k) :=
  Submodule.mapQ_apply _ _ _ y

/-- `sdPieceSMapLin` is a chain map: it commutes with the differentials. -/
theorem sdPieceSMapLin_comm {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    (ModuleCat.ofHom (sdPieceSMapLin P h (k + 1))) ≫ ((sdPieceS P a h).quot).d (k + 1) k =
      ((locCx P a).d (k + 1) k) ≫ (ModuleCat.ofHom (sdPieceSMapLin P h k)) := by
  apply ModuleCat.hom_ext
  rw [SubData.quot_d, locCx_d]
  rw [ModuleCat.hom_comp, ModuleCat.hom_comp]
  simp only [ModuleCat.hom_ofHom]
  apply LinearMap.ext
  intro x
  refine Submodule.Quotient.induction_on (p := locRel P a (k + 1)) x ?_
  intro y
  rw [LinearMap.comp_apply, LinearMap.comp_apply]
  rw [sdPieceSMapLin_apply P h (k + 1) y]
  rw [locD_mk]
  rw [sdPieceSMapLin_apply P h k (leSubD P a k y)]
  rw [SubData.quotD_apply]
  refine congrArg Submodule.Quotient.mk ?_
  apply Subtype.ext
  rw [SubData.chain_d (S := sdS P (insert a T)) k, ModuleCat.hom_ofHom]
  rw [SubData.dL_apply (S := sdS P (insert a T)) k]
  rw [sdChain_d]
  rw [ModuleCat.hom_ofHom]
  simp only [sdSInc, Submodule.coe_inclusion]
  exact (leSubD_apply P a k y).symm

/-- The identification of the subdivided piece of a stage step with the local
complex of the new cell, as a chain map. -/
noncomputable def sdPieceSMap {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) :
    locCx P a ⟶ (sdPieceS P a h).quot :=
  ChainComplex.ofHom (fun k => ModuleCat.ofHom (sdPieceSMapLin P h k))
    (fun k => sdPieceSMapLin_comm P h k)

@[simp] theorem sdPieceSMap_f {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    (sdPieceSMap P h).f k = ModuleCat.ofHom (sdPieceSMapLin P h k) := rfl

/-- **The subdivided piece is the local complex of the new cell** (module level):
the map `sdPieceSMapLin` is bijective in every degree. -/
theorem sdPieceSMapLin_bijective {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ) :
    Function.Bijective (sdPieceSMapLin P h k) := by
  have hinj : ((sdPieceS P a h).sub k).comap (sdSInc P h k) ≤ locRel P a k := by
    intro x hx
    have hxT : (x : chainMod P.Cell k) ∈ sdSMod P T k := hx
    have hmem : (x : chainMod P.Cell k) ∈ sdSMod P T k ⊓ leSub P a k := ⟨hxT, x.2⟩
    exact (le_of_eq (sdSMod_inf_leSub P h k)) hmem
  have hsup : (sdSInc P h k).range ⊔ (sdPieceS P a h).sub k = ⊤ := by
    refine eq_top_iff.mpr fun w _ => ?_
    have hw : (w : chainMod P.Cell k) ∈ sdSMod P T k ⊔ leSub P a k :=
      (le_of_eq (sdSMod_insert P h k)) w.2
    obtain ⟨u, hu, v, hv, huv⟩ := Submodule.mem_sup.mp hw
    refine Submodule.mem_sup.mpr ⟨⟨v, leSub_le_sdSMod_insert P h k hv⟩, ?_,
      ⟨u, sdSMod_mono P (Finset.subset_insert a T) k hu⟩, ?_, ?_⟩
    · exact LinearMap.mem_range.mpr ⟨⟨v, hv⟩, rfl⟩
    · exact hu
    · refine Subtype.ext ?_
      show v + u = (w : chainMod P.Cell k)
      rw [add_comm]
      exact huv
  exact sdPieceMapLinMapQ_bijective_aux (sdSInc P h k) (leSub_le_sdPieceS_sub P h k) hinj hsup

theorem sdPieceSMap_isIso {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) :
    IsIso (sdPieceSMap P h) := by
  haveI hf : ∀ k, IsIso ((sdPieceSMap P h).f k) := fun k => by
    rw [ConcreteCategory.isIso_iff_bijective]
    exact sdPieceSMapLin_bijective P h k
  exact HomologicalComplex.Hom.isIso_of_components (sdPieceSMap P h)

/-- **The subdivided piece is the local complex of the new cell.** -/
noncomputable def sdPieceSIso {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) :
    (sdPieceS P a h).quot ≅ locCx P a := by
  haveI := sdPieceSMap_isIso P h
  exact (asIso (sdPieceSMap P h)).symm

@[simp] theorem sdPieceSIso_inv {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) :
    (sdPieceSIso P h).inv = sdPieceSMap P h := rfl

/-- The value of `sdPieceSIso` on the image of the forward map. -/
theorem sdPieceSIso_apply {T : Finset P.Cell} {a : P.Cell} (h : IsStage P a T) (k : ℕ)
    (x : (locCx P a).X k) :
    (sdPieceSIso P h).hom.f k ((sdPieceSMap P h).f k x) = x := by
  have hcomp : (sdPieceSIso P h).inv.f k ≫ (sdPieceSIso P h).hom.f k =
      (𝟙 ((locCx P a).X k) : (locCx P a).X k ⟶ (locCx P a).X k) := by
    rw [← HomologicalComplex.comp_f, Iso.inv_hom_id, HomologicalComplex.id_f]
  rw [← sdPieceSIso_inv P h, ← ModuleCat.comp_apply, hcomp, ModuleCat.id_apply]

/-! ### The element computations -/

/-- The subdivided piece map on the class of the subdivision chain of the new cell. -/
theorem sdPieceSMap_locClsAux (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell)
    (h : IsStage P a T) :
    (sdPieceSMap P h).f (P.dim a) (locClsAux P (P.dim a) ⟨a, rfl⟩) =
      (Submodule.Quotient.mk
        (⟨subdivCell P (P.dim a) ⟨a, rfl⟩,
          leSub_le_sdSMod_insert P h (P.dim a)
            (subdivCell_mem_leSub P (P.dim a) ⟨a, rfl⟩)⟩ :
          ↥(sdSMod P (insert a T) (P.dim a))) : ((sdPieceS P a h).quot).X (P.dim a)) := by
  rw [show locClsAux P (P.dim a) ⟨a, rfl⟩ = Submodule.Quotient.mk
      (⟨subdivCell P (P.dim a) ⟨a, rfl⟩,
        subdivCell_mem_leSub P (P.dim a) ⟨a, rfl⟩⟩ : ↥(leSub P a (P.dim a))) from rfl]
  show sdPieceSMapLin P h (P.dim a) (Submodule.Quotient.mk
      (⟨subdivCell P (P.dim a) ⟨a, rfl⟩,
        subdivCell_mem_leSub P (P.dim a) ⟨a, rfl⟩⟩ : ↥(leSub P a (P.dim a)))) = _
  rw [sdPieceSMapLin_apply, sdSInc_apply]

/-- The stage quotient map on the generator of the cellular piece: the class of the
subdivision chain of the new cell. -/
theorem stageQuotMap_gen (hdd : P.HasDdZero) (haug : P.HasAugZero) {T : Finset P.Cell}
    (a : P.Cell) (h : IsStage P a T) :
    (stageQuotMap P hdd haug a h).f (P.dim a) (cellPieceSGen P hdd a h) =
      (Submodule.Quotient.mk
        (⟨subdivCell P (P.dim a) ⟨a, rfl⟩,
          leSub_le_sdSMod_insert P h (P.dim a)
            (subdivCell_mem_leSub P (P.dim a) ⟨a, rfl⟩)⟩ :
          ↥(sdSMod P (insert a T) (P.dim a))) : ((sdPieceS P a h).quot).X (P.dim a)) := by
  rw [show cellPieceSGen P hdd a h = Submodule.Quotient.mk
      (⟨cellElem P hdd (P.dim a) ⟨a, rfl⟩,
        cellElem_mem_cellSMod P hdd (insert a T) (P.dim a) ⟨a, rfl⟩
          (Finset.mem_insert_self a T)⟩ :
        ↥(cellSMod P hdd (insert a T) (P.dim a))) from rfl]
  rw [stageQuotMap, Work.Subdivision.quotMap_apply_mk]
  refine congrArg Submodule.Quotient.mk ?_
  rw [levelMapS_f]
  rw [levelMapS_f_apply P hdd haug a h (P.dim a)
    ⟨cellElem P hdd (P.dim a) ⟨a, rfl⟩,
      cellElem_mem_cellSMod P hdd (insert a T) (P.dim a) ⟨a, rfl⟩
        (Finset.mem_insert_self a T)⟩]
  refine Subtype.ext ?_
  show subdivLM P (P.dim a) (Finsupp.single (⟨a, rfl⟩ : {e : P.Cell // P.dim e = P.dim a}) 1) =
    subdivCell P (P.dim a) ⟨a, rfl⟩
  rw [subdivLM_single]

/-- The `(P.dim a)`-component of the local map of a cell. -/
theorem locMap_f_self (hdd : P.HasDdZero) (haug : P.HasAugZero) (a : P.Cell) :
    (locMap P hdd haug a).f (P.dim a) =
      (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) (P.dim a) unitMod.{u}).hom ≫
        spanMap (locClsAux P (P.dim a) ⟨a, rfl⟩) :=
  locMapAux_f_eq P hdd haug (P.dim a) ⟨a, rfl⟩

/-- **The map induced by the subdivision on the pieces of a stage step is the
local map of the new cell.**  The two sides of the commuting square are the two
composites `unitCx (P.dim a) ⟶ (sdPieceS P a h).quot`. -/
theorem cellPieceSMap_stageQuotMap (hdd : P.HasDdZero) (haug : P.HasAugZero)
    {T : Finset P.Cell} (a : P.Cell) (h : IsStage P a T) :
    cellPieceSMap P hdd a h ≫ stageQuotMap P hdd haug a h =
      locMap P hdd haug a ≫ sdPieceSMap P h := by
  have hgen : (stageQuotMap P hdd haug a h).f (P.dim a) (cellPieceSGen P hdd a h) =
      (sdPieceSMap P h).f (P.dim a) (locClsAux P (P.dim a) ⟨a, rfl⟩) := by
    rw [stageQuotMap_gen P hdd haug a h, sdPieceSMap_locClsAux P hdd a h]
  apply HomologicalComplex.from_single_hom_ext
  rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f, cellPieceSMap_f_self, locMap_f_self]
  simp only [Category.assoc]
  have hAB : cellPieceSCoeffF P hdd a h ≫ (stageQuotMap P hdd haug a h).f (P.dim a) =
      spanMap (locClsAux P (P.dim a) ⟨a, rfl⟩) ≫ (sdPieceSMap P h).f (P.dim a) := by
    unfold cellPieceSCoeffF
    rw [spanMap_comp, spanMap_comp, hgen]
  exact congrArg (fun t => (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) (P.dim a)
    unitMod.{u}).hom ≫ t) hAB

end PolyCW

end

end Work.Subdivision
