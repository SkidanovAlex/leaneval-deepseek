/-
# The cellular piece of a stage step is `ℤ`, generated by the new cell

For a `PolyCW` `P`, a cell `a` and a stage `T` of `a` (`PolyCW.IsStage`), the
relative cellular piece `cellPieceS P hdd a h` of `cellS (insert a T)` over
`cellS T` has, in the degree of the new cell, the successive quotient
`cellSMod (insert a T) (dim a) ⧸ cellSMod T (dim a)` freely generated by the
class of the new cell `a`.

Concretely, in degree `dim a` the two support submodules are

* `R = cellSMod (insert a T) (dim a) = Q ⊔ L` and
* `Q = cellSMod T (dim a)`, with `Q ⊓ L = ⊥`,

where `L = ℤ ∙ cellElem a` is the line spanned by the new basis vector
(`cellSMod_insert_eq`, `cellSMod_inf_span_cellElem`).  Hence the quotient
`↥R ⧸ Q` is generated by the class of `cellElem a`, and that generator is
torsion-free; equivalently the coefficient map `cellPieceSCoeffF`, sending the
generator of `unitMod = ℤ` to that class, is a bijection.

This is the support-form analogue of
`Work.Subdivision.cellPieceCoeffF_bijective`.
-/
import Mathlib
import Submission.Work.MbarHomology.Local.SupportPieces

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option autoImplicit false

namespace Work.MbarHomology.Local

open CategoryTheory

universe u

noncomputable section

/-! ## The abstract quotient computation

We first isolate the elementary fact behind the statement: for submodules
`R = Q ⊔ L`, `Q ⊓ L = ⊥`, `L = ℤ ∙ x` with `x` a basis vector of a free module,
the coefficient map `ℤ → ↥R ⧸ Q`, `1 ↦ [x]`, is bijective.  We work in the
concrete free module `ι →₀ ℤ` to avoid the `ℤ`-module diamond of Mathlib's
`Submodule`/quotient instances.
-/

/-- The `spanMap` of an element of a `ℤ`-module is bijective exactly when the
underlying linear map `ℤ → M`, `k ↦ k • x`, is; the source differs from `ℤ` only
by the (bijective) universe lift `ULift.moduleEquiv`. -/
private theorem sCoeff_spanMap_bijective_iff (M : ModuleCat ℤ) (x : M) :
    Function.Bijective (Work.Subdivision.PolyCW.spanMap x) ↔
      Function.Bijective (LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) x) := by
  have hcomp : (⇑(Work.Subdivision.PolyCW.spanMap x) : ULift ℤ → ↥M) =
      ((LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) x) ∘
        (ULift.moduleEquiv (R := ℤ) (M := ℤ) : ULift ℤ → ℤ)) := by
    funext u
    simp only [Work.Subdivision.PolyCW.spanMap, ModuleCat.hom_ofHom, LinearMap.coe_comp,
      Function.comp_apply, LinearEquiv.coe_coe]
  rw [hcomp]
  constructor
  · intro h
    exact (Function.Bijective.of_comp_iff _ (LinearEquiv.bijective _)).mp h
  · intro h
    exact h.comp (LinearEquiv.bijective _)

/-- If `y` generates `M` (as a `ℤ`-module) and is torsion-free
(`k • y = 0 → k = 0`), then the coefficient map `ℤ → M`, `1 ↦ y`, is bijective. -/
private theorem sCoeff_bijective_spanMap_of (M : ModuleCat ℤ) (y : M)
    (hspan : Submodule.span ℤ ({y} : Set (↥M)) = ⊤)
    (htor : ∀ k : ℤ, (LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) y) k = 0 → k = 0) :
    Function.Bijective (Work.Subdivision.PolyCW.spanMap y) := by
  rw [sCoeff_spanMap_bijective_iff (M := M) y]
  refine ⟨?_, ?_⟩
  · intro k l hkl
    have h2 : (LinearMap.toSpanSingleton (R := ℤ) (M := ↥M) y) (k - l) = 0 := by
      rw [map_sub, hkl, sub_self]
    have h3 := htor (k - l) h2
    omega
  · rw [← LinearMap.range_eq_top]
    rw [LinearMap.range_toSpanSingleton]
    exact hspan

/-- **The abstract quotient computation**, in the free module `ι →₀ ℤ`.  If
`R = Q ⊔ L` with `Q ⊓ L = ⊥` and `L = ℤ ∙ x` where `x = Finsupp.single i 1`,
then the coefficient map `ℤ → ↥R ⧸ Q`, `1 ↦ [x]`, is bijective. -/
private theorem sCoeff_bijective_spanMap_quot (ι : Type*) [DecidableEq ι]
    (R Q L : Submodule ℤ (ι →₀ ℤ)) (i : ι)
    (hsup : R = Q ⊔ L) (hinf : Q ⊓ L = ⊥)
    (hL : L = Submodule.span ℤ ({Finsupp.single i (1:ℤ)} : Set (ι →₀ ℤ)))
    (hx : Finsupp.single i (1:ℤ) ∈ R) :
    Function.Bijective (Work.Subdivision.PolyCW.spanMap
      (M := ModuleCat.of ℤ (↥R ⧸ Q.comap (Submodule.subtype R)))
      (Submodule.Quotient.mk (p := Q.comap (Submodule.subtype R))
        ⟨Finsupp.single i (1:ℤ), hx⟩)) := by
  set q : Submodule ℤ ↥R := Q.comap (Submodule.subtype R) with hq
  set gen : ↥R ⧸ q := Submodule.Quotient.mk (p := q) ⟨Finsupp.single i (1:ℤ), hx⟩ with hgen
  apply sCoeff_bijective_spanMap_of (M := ModuleCat.of ℤ (↥R ⧸ q)) gen
  · -- the class of `x` generates the quotient
    rw [Submodule.eq_top_iff']
    intro m
    induction m using Submodule.Quotient.induction_on with
    | _ v =>
      have hvR : (v : ι →₀ ℤ) ∈ Q ⊔ L := by rw [← hsup]; exact v.2
      obtain ⟨y, hyQ, z, hzL, hyz⟩ := Submodule.mem_sup.mp hvR
      obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hL ▸ hzL)
      have hv : (v : ι →₀ ℤ) = y + c • Finsupp.single i (1:ℤ) := by rw [← hyz, ← hc]
      have hq' : (Submodule.Quotient.mk (p := q) v : ↥R ⧸ q) = c • gen := by
        rw [hgen, ← Submodule.Quotient.mk_smul q c (⟨Finsupp.single i (1:ℤ), hx⟩ : ↥R)]
        rw [Submodule.Quotient.eq]
        rw [Submodule.mem_comap]
        change ((v - c • (⟨Finsupp.single i (1:ℤ), hx⟩ : ↥R) : ↥R) : ι →₀ ℤ) ∈ Q
        have hcoe : ((v - c • (⟨Finsupp.single i (1:ℤ), hx⟩ : ↥R) : ↥R) : ι →₀ ℤ)
            = (v : ι →₀ ℤ) - c • Finsupp.single i (1:ℤ) := by
          rw [Submodule.coe_sub, Submodule.coe_smul]
        rw [hcoe, hv, add_sub_cancel_right]
        exact hyQ
      rw [hq']
      exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton gen))
  · -- the class of `x` is torsion-free
    intro k hk
    have hk' : k • gen = 0 := by rw [← LinearMap.toSpanSingleton_apply]; exact hk
    have hmem : k • Finsupp.single i (1:ℤ) ∈ Q := by
      have h1 : (Submodule.Quotient.mk (p := q)
          (k • (⟨Finsupp.single i (1:ℤ), hx⟩ : ↥R)) : ↥R ⧸ q) = 0 := by
        rw [Submodule.Quotient.mk_smul, ← hgen]; exact hk'
      rw [Submodule.Quotient.mk_eq_zero] at h1
      rw [Submodule.mem_comap] at h1
      simpa [Submodule.coe_smul] using h1
    have hmemL : k • Finsupp.single i (1:ℤ) ∈ L := by
      rw [hL]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
    have hz : k • Finsupp.single i (1:ℤ) = 0 := by
      have h2 : k • Finsupp.single i (1:ℤ) ∈ Q ⊓ L := Submodule.mem_inf.mpr ⟨hmem, hmemL⟩
      rw [hinf] at h2
      simpa using h2
    have hw : k • Finsupp.single i (1:ℤ) = Finsupp.single i k := by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
    rw [hw] at hz
    exact Finsupp.single_eq_zero.mp hz

/-! ## The coefficient map of the cellular piece of a stage step -/

theorem cellPieceSCoeffF_bijective (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) {T : Finset P.Cell} (a : P.Cell) (h : Work.Subdivision.PolyCW.IsStage P a T) :
    Function.Bijective (Work.Subdivision.PolyCW.cellPieceSCoeffF P hdd a h) := by
  have key := sCoeff_bijective_spanMap_quot {e : P.Cell // P.dim e = P.dim a}
    (Work.Subdivision.PolyCW.cellSMod P hdd (insert a T) (P.dim a))
    (Work.Subdivision.PolyCW.cellSMod P hdd T (P.dim a))
    (Submodule.span ℤ
      ({Work.Subdivision.PolyCW.cellElem P hdd (P.dim a) ⟨a, rfl⟩} :
        Set ({e : P.Cell // P.dim e = P.dim a} →₀ ℤ)))
    ⟨a, rfl⟩
    (Work.Subdivision.PolyCW.cellSMod_insert_eq P hdd h)
    (Work.Subdivision.PolyCW.cellSMod_inf_span_cellElem P hdd a h)
    rfl
    (Work.Subdivision.PolyCW.cellElem_mem_cellSMod P hdd (insert a T) (P.dim a) ⟨a, rfl⟩
      (Finset.mem_insert_self a T))
  exact key

end

end Work.MbarHomology.Local
