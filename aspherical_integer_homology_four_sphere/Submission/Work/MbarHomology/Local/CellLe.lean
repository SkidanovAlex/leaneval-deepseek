/-
# The cellular subcomplex of the closed cell of `e`, and closed-cell acyclicity

For a `PolyCW` `P` and a cell `e`, the subcomplex `cellLe P hdd e` of the cellular chain complex
`cellChain P hdd` is spanned by the cells `f ≤ e` — i.e. by the cells of the closed cell of `e`.
Its chain complex is the *cellular* complex of the face lattice `Iic e`.

The acyclicity of this complex (`IsCellAcyclic`) is the input of
`Work.MbarHomology.locallySpherical_of_closed`: for the face poset `QbarCW` of the truncated
24-cell, `cellLe QbarCW e` is spanned by at most `865` cells and its acyclicity is certified once
per cell by a small `SDR` certificate.
-/
import Mathlib
import Submission.Work.Subdivision.CellChain
import Submission.Work.Subdivision.SubComplex
import Submission.Work.Subdivision.Local

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option autoImplicit false

namespace Work.MbarHomology

open CategoryTheory

noncomputable section

/-- The cells `f ≤ e` of dimension `k`, as a set of `k`-chains. -/
def cellSubSet (P : Work.Subdivision.PolyCW) (e : P.Cell) (k : ℕ) : Set (P.cellMod k) :=
  {x | ∃ f : {f : P.Cell // P.dim f = k}, f.1 ≤ e ∧ x = Finsupp.single f (1 : ℤ)}

/-- The submodule of the `k`-chains generated by the cells `f ≤ e` of dimension `k`. -/
def cellSubMod (P : Work.Subdivision.PolyCW) (e : P.Cell) (k : ℕ) : Submodule ℤ (P.cellMod k) :=
  Submodule.span ℤ (cellSubSet P e k)

theorem mem_cellSubMod_single (P : Work.Subdivision.PolyCW) (e : P.Cell)
    (k : ℕ) (f : {f : P.Cell // P.dim f = k}) (hf : f.1 ≤ e) :
    (Finsupp.single f (1 : ℤ) : P.cellMod k) ∈ cellSubMod P e k :=
  Submodule.subset_span ⟨f, hf, rfl⟩

/-- The submodules `cellSubMod` are closed under the differential: the faces of a face of `e` are
faces of `e`. -/
theorem cellSubMod_d_mem (P : Work.Subdivision.PolyCW) (e : P.Cell) (k : ℕ)
    (x : P.cellMod (k + 1)) (hx : x ∈ cellSubMod P e (k + 1)) :
    Work.Subdivision.PolyCW.cellD P k x ∈ cellSubMod P e k := by
  have key : cellSubSet P e (k + 1) ⊆
      (Submodule.comap (Work.Subdivision.PolyCW.cellD P k) (cellSubMod P e k) :
        Set (P.cellMod (k + 1))) := by
    intro y hy
    obtain ⟨f, hf, rfl⟩ := hy
    rw [SetLike.mem_coe, Submodule.mem_comap, Work.Subdivision.PolyCW.cellD_single]
    refine Submodule.sum_mem _ fun y hy => Submodule.smul_mem _ _ ?_
    have hyf : y.1 < f.1 := ((P.mem_facets f.1 y.1).1 y.2).1
    have hydim : P.dim y.1 = k := by
      have h1 : P.dim f.1 = P.dim y.1 + 1 := ((P.mem_facets f.1 y.1).1 y.2).2
      have h2 : P.dim f.1 = k + 1 := f.2
      omega
    exact mem_cellSubMod_single P e k ⟨y.1, hydim⟩ (le_of_lt (lt_of_lt_of_le hyf hf))
  exact Submodule.mem_comap.mp ((Submodule.span_le.mpr key) hx)

/-- The subcomplex data of the closed cell of `e`. -/
def cellSubData (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (e : P.Cell) :
    Work.Subdivision.SubData (P.cellChain hdd) where
  sub k := cellSubMod P e k
  d_mem k x hx := by
    rw [Work.Subdivision.PolyCW.cellChain_d]
    exact cellSubMod_d_mem P e k x hx

/-- **The cellular chain complex of the closed cell of `e`**: the subcomplex of `cellChain P hdd`
spanned by the cells `f ≤ e`. -/
def cellLe (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (e : P.Cell) :
    ChainComplex (ModuleCat ℤ) ℕ :=
  (cellSubData P hdd e).chain

/-- The model for the homology of an acyclic closed cell: `ℤ` in degree zero and `0` elsewhere. -/
abbrev cellHomModel (k : ℕ) : ModuleCat ℤ :=
  if k = 0 then ModuleCat.of ℤ ℤ else ModuleCat.of ℤ PUnit

/-- **Closed-cell acyclicity**: the cellular chain complex of the closed cell of every cell of `P`
has the homology of a point. -/
def IsCellAcyclic (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) : Prop :=
  ∀ (e : P.Cell) (k : ℕ), Nonempty ((cellLe P hdd e).homology k ≅ cellHomModel k)

end

end Work.MbarHomology
