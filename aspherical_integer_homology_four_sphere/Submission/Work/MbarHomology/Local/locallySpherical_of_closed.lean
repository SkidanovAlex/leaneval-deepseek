/-! ### The value of the restricted subdivision on a chain -/

/-- The `k`-th component of the subdivision restricted to the support filtration of a lower
finset is the restricted component of the subdivision. -/
theorem stageMap_f (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (haug : P.HasAugZero)
    (S : Finset P.Cell) (hS : IsLowerFinset P S) (k : ℕ) :
    (stageMap P hdd haug S hS).f k =
      (cellS P hdd S hS).restrictCptMap (sdS P S) (subdiv P hdd haug)
        (subdivCpt_mem_S P hdd haug hS) k := rfl

/-- The value of the restricted subdivision on a chain of the support filtration, in the
subdivided support filtration. -/
theorem stageMap_f_apply (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (haug : P.HasAugZero)
    (S : Finset P.Cell) (hS : IsLowerFinset P S) (k : ℕ)
    (x : ↥((cellS P hdd S hS).chain.X k)) :
    ((((cellS P hdd S hS).restrictCptMap (sdS P S) (subdiv P hdd haug)
        (subdivCpt_mem_S P hdd haug hS) k) x : ↥(sdSMod P S k))) =
      (⟨subdivLM P k ((x : ↥(cellSMod P hdd S k)) : (cellChain P hdd).X k),
        (subdivCpt_mem_S P hdd haug hS k x.2)⟩ : ↥(sdSMod P S k)) := rfl

/-! ### The abstract criterion in degree zero

A chain map from a complex whose homology is `ℤ` in degree `0` and torsion-free (here: zero) above
into the complex `unitCx 0` concentrated in degree `0`, which is surjective on chains in degree
`0`, is a quasi-isomorphism.  The hypothesis `H₀(K) ≅ ℤ` and the surjectivity in degree `0`
upgrade to an isomorphism of `H₀` by `bijective_of_surjective_of_int_iso`, and the higher homology
is zero on both sides. -/

/-- **Quasi-isomorphism criterion for a chain map into `ℤ[0]`.** -/
theorem quasiIso_of_comp_unitCx (K : ChainComplex (ModuleCat ℤ) ℕ) [∀ i, K.HasHomology i]
    (φ : K ⟶ unitCx 0)
    (hK0 : Nonempty (↥(K.homology 0) ≃ₗ[ℤ] ℤ))
    (hKi : ∀ i, i ≠ 0 → Subsingleton (↥(K.homology i)))
    (hsurj : Function.Surjective ⇑(ConcreteCategory.hom (φ.f 0))) :
    QuasiIso φ := by
  rw [quasiIso_iff]
  intro i
  rw [quasiIsoAt_iff_isIso_homologyMap]
  by_cases hi : i = 0
  · subst hi
    -- In degree `0` the map is surjective with values in `ℤ` on both sides, hence an isomorphism.
    haveI : IsIso (HomologicalComplex.opcyclesMap φ 0) := by
      rw [ConcreteCategory.isIso_iff_bijective]
      refine bijective_of_surjective_of_int_iso ?_ ?_ _ ?_
      · exact ⟨(Iso.toLinearEquiv (ChainComplex.isoHomologyι₀ K)).symm.trans hK0.some⟩
      · exact ⟨((Iso.toLinearEquiv (ChainComplex.isoHomologyι₀ (unitCx 0))).symm.trans
          (Iso.toLinearEquiv (HomologicalComplex.singleObjHomologySelfIso
            (ComplexShape.down ℕ) 0 unitMod))).trans (ULift.moduleEquiv (R := ℤ) (M := ℤ))⟩
      · intro y
        obtain ⟨z, hz⟩ := (ModuleCat.epi_iff_surjective
          ((unitCx 0).pOpcycles 0)).mp inferInstance y
        obtain ⟨w, hw⟩ := hsurj z
        refine ⟨K.pOpcycles 0 w, ?_⟩
        have h1 : HomologicalComplex.opcyclesMap φ 0 (K.pOpcycles 0 w) =
            (unitCx 0).pOpcycles 0 (φ.f 0 w) := by
          have h := congrArg (fun (t : K.X 0 ⟶ (unitCx 0).opcycles 0) => t w)
            (HomologicalComplex.p_opcyclesMap φ 0)
          simpa only [ModuleCat.comp_apply] using h
        rw [h1, hw, hz]
    -- `homologyMap φ 0` is an isomorphism because `isoHomologyι₀` converts it into
    -- `opcyclesMap φ 0`.
    have hnat := ChainComplex.isoHomologyι₀_inv_naturality φ
    have h1 : IsIso ((ChainComplex.isoHomologyι₀ K).inv ≫
        HomologicalComplex.homologyMap φ 0) := by
      rw [hnat]
      infer_instance
    exact IsIso.of_isIso_comp_left (ChainComplex.isoHomologyι₀ K).inv
      (HomologicalComplex.homologyMap φ 0)
  · -- In positive degrees both sides have trivial homology.
    rw [ConcreteCategory.isIso_iff_bijective]
    haveI : Subsingleton (↥(K.homology i)) := hKi i hi
    haveI : Subsingleton (↥((unitCx 0).homology i)) :=
      ModuleCat.subsingleton_of_isZero
        (HomologicalComplex.isZero_single_obj_homology (ComplexShape.down ℕ) 0 unitMod i hi)
    exact ⟨fun a b _ => Subsingleton.elim a b, fun y => ⟨0, Subsingleton.elim _ _⟩⟩

/-! ### A vertex of every closed cell

`IsCellAcyclic` at a cell `e` in degree `0` forces `e` to have a cell of dimension `0` below it:
otherwise the `0`-chains of the closed cell of `e` vanish and so does its `H₀`, contradicting
`H₀ ≅ ℤ`. -/

theorem exists_dim_zero_le (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (e : P.Cell)
    (hcl : Work.MbarHomology.IsCellAcyclic P hdd) :
    ∃ v : P.Cell, P.dim v = 0 ∧ v ≤ e := by
  by_contra hno
  have hset : {y : (cellChain P hdd).X 0 | ∃ e' : {e' : P.Cell // P.dim e' = 0},
      e'.1 ∈ icF P e ∧ y = cellElem P hdd 0 e'} = (∅ : Set ((cellChain P hdd).X 0)) := by
    rw [Set.eq_empty_iff_forall_notMem]
    rintro y ⟨e', he', -⟩
    exact hno ⟨e'.1, e'.2, by simpa [icF] using he'⟩
  have hbot : cellSMod P hdd (icF P e) 0 = ⊥ := by
    rw [cellSMod, hset, Submodule.span_empty]
  have hX0 : IsZero ((cellIcCx P hdd e).X 0) := by
    haveI : Subsingleton (↥((cellIcCx P hdd e).X 0)) := by
      rw [show ((cellIcCx P hdd e).X 0) = ModuleCat.of ℤ ↥(cellSMod P hdd (icF P e) 0)
        from rfl, hbot]
      infer_instance
    exact ModuleCat.isZero_of_subsingleton _
  have hz : IsZero ((cellIcCx P hdd e).homology 0) :=
    ShortComplex.isZero_homology_of_isZero_X₂ ((cellIcCx P hdd e).sc 0) hX0
  have hz' : IsZero ((Work.MbarHomology.cellLe P hdd e).homology 0) := by
    rw [← cellIcCx_eq_cellLe P hdd e]
    exact hz
  obtain ⟨e₀⟩ := hcl e 0
  have hmod : IsZero (Work.MbarHomology.cellHomModel 0) := (Iso.isZero_iff e₀).mp hz'
  have hsub0 : Subsingleton (↥(Work.MbarHomology.cellHomModel 0)) :=
    ModuleCat.subsingleton_of_isZero hmod
  have hsub : Subsingleton ℤ := by simpa [Work.MbarHomology.cellHomModel] using hsub0
  exact one_ne_zero (Subsingleton.elim (1 : ℤ) 0)

/-- The model for a point in degree `0` is `ℤ`. -/
theorem cellHomModel_zero :
    Work.MbarHomology.cellHomModel 0 = ModuleCat.of ℤ ℤ := by
  dsimp only [Work.MbarHomology.cellHomModel]
  rw [ite_eq_left rfl]

/-! ### Surjectivity of the closed-cell subdivision in degree `0` -/

/-- The composite of the subdivision of the closed cell of `e` with the coefficient-sum
retraction is surjective in degree `0`: the `0`-cell `v` maps to the subdividing vertex, on which
the retraction takes the value `1`. -/
theorem stageMap_comp_leSubRetr_surjective (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero)
    (haug : P.HasAugZero) (e v : P.Cell) (hv0 : P.dim v = 0) (hve : v ≤ e) :
    Function.Surjective (((stageMap P hdd haug (icF P e)
      (isLowerFinset_filter_le P e) ≫ leSubRetr P e).f 0 :
        ↥(cellSMod P hdd (icF P e) 0) → ULift.{0} ℤ)) := by
  intro z
  have hmem : v ∈ icF P e := by simp [icF, hve]
  have hretr : (leSubRetr P e).f 0
      (⟨sdElem P (Simplex.vertex v), sdElem_mem_sdSMod P (icF P e) 0 (Simplex.vertex v)
        (fun _ => hmem)⟩ : ↥(sdSMod P (icF P e) 0)) = ULift.up (1 : ℤ) :=
    leSubRetr_sdElem_vertex P e v hve
  have hval : (stageMap P hdd haug (icF P e) (isLowerFinset_filter_le P e)).f 0
      (⟨cellElem P hdd 0 ⟨v, hv0⟩,
        cellElem_mem_cellSMod P hdd (icF P e) 0 ⟨v, hv0⟩ hmem⟩ :
        ↥(cellSMod P hdd (icF P e) 0))
      = (⟨sdElem P (Simplex.vertex v), sdElem_mem_sdSMod P (icF P e) 0 (Simplex.vertex v)
        (fun _ => hmem)⟩ : ↥(sdSMod P (icF P e) 0)) := by
    rw [stageMap_f P hdd haug (icF P e) (isLowerFinset_filter_le P e) 0]
    rw [stageMap_f_apply P hdd haug (icF P e) (isLowerFinset_filter_le P e) 0 _]
    refine Subtype.ext ?_
    show (P.subdivLM 0) _ = sdElem P (Simplex.vertex v)
    rw [show ((⟨cellElem P hdd 0 ⟨v, hv0⟩,
        cellElem_mem_cellSMod P hdd (icF P e) 0 ⟨v, hv0⟩ hmem⟩ :
        ↥(cellSMod P hdd (icF P e) 0)) : (cellChain P hdd).X 0)
      = Finsupp.single (⟨v, hv0⟩ : {e // P.dim e = 0}) (1 : ℤ) from rfl]
    rw [subdivLM_single, subdivCell_zero]
    rfl
  refine ⟨(ULift.down z) • (⟨cellElem P hdd 0 ⟨v, hv0⟩,
      cellElem_mem_cellSMod P hdd (icF P e) 0 ⟨v, hv0⟩ hmem⟩ :
      ↥(cellSMod P hdd (icF P e) 0)), ?_⟩
  rw [HomologicalComplex.comp_f, ModuleCat.comp_apply, map_zsmul, map_zsmul, hval, hretr]
  rw [← ULift.up_down z]
  exact ULift.ext (by simp)

/-! ### (B) The subdivision of a closed cell -/

/-- **(B) The subdivision on the closed cell of a cell is a quasi-isomorphism.** -/
theorem stageMap_icF_quasiIso (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero)
    (haug : P.HasAugZero) (hcl : Work.MbarHomology.IsCellAcyclic P hdd) (e : P.Cell) :
    QuasiIso (stageMap P hdd haug (icF P e) (isLowerFinset_filter_le P e)) := by
  obtain ⟨v, hv0, hve⟩ := exists_dim_zero_le P hdd e hcl
  have hEq : (cellS P hdd (icF P e) (isLowerFinset_filter_le P e)).chain =
      Work.MbarHomology.cellLe P hdd e := cellIcCx_eq_cellLe P hdd e
  have hK0 : Nonempty (↥(((cellS P hdd (icF P e) (isLowerFinset_filter_le P e)).chain).homology 0)
      ≃ₗ[ℤ] ℤ) := by
    obtain ⟨e₀⟩ := hcl e 0
    exact ⟨(Iso.toLinearEquiv ((eqToIso (congrArg
        (fun (C : ChainComplex (ModuleCat ℤ) ℕ) => C.homology 0) hEq)).trans e₀)).trans
      (Iso.toLinearEquiv (eqToIso cellHomModel_zero))⟩
  have hKi : ∀ i, i ≠ 0 → Subsingleton
      (↥(((cellS P hdd (icF P e) (isLowerFinset_filter_le P e)).chain).homology i)) := by
    intro i hi
    obtain ⟨e₀⟩ := hcl e i
    haveI : Subsingleton (↥(Work.MbarHomology.cellHomModel i)) := by
      rw [Work.MbarHomology.cellHomModel, ite_eq_right hi]
      infer_instance
    exact ⟨fun a b => (Iso.toLinearEquiv ((eqToIso (congrArg
        (fun (C : ChainComplex (ModuleCat ℤ) ℕ) => C.homology i) hEq)).trans e₀)).injective
      (Subsingleton.elim _ _)⟩
  have hcomp : QuasiIso (stageMap P hdd haug (icF P e) (isLowerFinset_filter_le P e)
      ≫ leSubRetr P e) :=
    quasiIso_of_comp_unitCx _ _ hK0 hKi (stageMap_comp_leSubRetr_surjective P hdd haug e v hv0 hve)
  haveI hretr : QuasiIso (leSubRetr P e) := leSubRetr_quasiIso P e
  exact quasiIso_of_comp_right (stageMap P hdd haug (icF P e) (isLowerFinset_filter_le P e))
    (leSubRetr P e) (hφ := hretr) (hφφ' := hcomp)

/-! ### The stages of the boundary and of the closed cell of a cell -/

/-- The proper faces of `e` are exactly the cells of `ioF e` of dimension below `dim e`. -/
theorem stageBelow_ioF_eq (P : Work.Subdivision.PolyCW) (e : P.Cell) :
    stageBelow P (ioF P e) (P.dim e) = ioF P e := by
  ext f
  simp only [stageBelow, ioF, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨hf, hdim⟩
    exact lt_of_le_of_ne (le_of_lt hf)
      (fun hfe => by rw [hfe] at hdim; exact lt_irrefl _ hdim)
  · intro hf
    exact ⟨hf, P.dim_lt hf.le (ne_of_lt hf)⟩

/-- **The boundary of a cell is a stage of its own.** -/
theorem isStage_ioF (P : Work.Subdivision.PolyCW) (e : P.Cell) :
    Work.Subdivision.PolyCW.IsStage P e (ioF P e) where
  lower := isLowerFinset_filter_lt P e
  notMem := by simp [ioF]
  dim_le := by intro f hf; exact P.dim_le (le_of_lt (by simpa [ioF] using hf))
  faces := by intro f hf; simp [ioF, hf]

/-- Adjoining the cell `e` to its boundary stage gives the closed cell of `e`. -/
theorem closedCell_insert_ioF (P : Work.Subdivision.PolyCW) (e : P.Cell) :
    insert e (ioF P e) = icF P e := by
  ext f
  simp only [Finset.mem_insert, ioF, icF, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro (rfl | hf)
    · exact le_rfl
    · exact le_of_lt hf
  · intro hf
    rcases eq_or_lt_of_le hf with rfl | hlt
    · exact Or.inl rfl
    · exact Or.inr hlt

/-! ### (A) The subdivision of the boundary of a cell -/

/-- **(A) The subdivision on the boundary of a cell.**  Assuming the local condition at every
proper face of `e`, the restriction of the subdivision to the filtration supported on the proper
faces of `e` is a quasi-isomorphism.  This is the cell-by-cell induction `stageLevel_quasiIso`
at the lower set `ioF e`. -/
theorem boundaryStage_quasiIso (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero)
    (haug : P.HasAugZero) (e : P.Cell)
    (hLS : ∀ a ∈ ioF P e, QuasiIso (locMap P hdd haug a)) :
    QuasiIso (stageMap P hdd haug (ioF P e) (isLowerFinset_filter_lt P e)) := by
  have hbase := stageLevel_quasiIso P hdd haug (ioF P e) (isLowerFinset_filter_lt P e) hLS
    (P.dim e) (∅ : Finset P.Cell) (Finset.empty_subset _)
  exact (quasiIso_stageMap_congr P hdd haug (S := stageBelow P (ioF P e) (P.dim e) ∪ ∅)
    (S' := ioF P e) (by rw [Finset.union_empty, stageBelow_ioF_eq]) _ _).mp hbase

/-! ### The local condition and the theorem -/

/-- **(C) The local condition at a cell, from (A) and (B).** -/
theorem locMap_quasiIso_aux (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero)
    (haug : P.HasAugZero) (hcl : Work.MbarHomology.IsCellAcyclic P hdd) (e : P.Cell)
    (hLS : ∀ a ∈ ioF P e, QuasiIso (locMap P hdd haug a)) :
    QuasiIso (locMap P hdd haug e) := by
  refine locMap_quasiIso_of_stage (T := ioF P e) P hdd haug e (isStage_ioF P e) ?_ ?_
  · exact boundaryStage_quasiIso P hdd haug e hLS
  · exact (quasiIso_stageMap_congr P hdd haug (closedCell_insert_ioF P e)
      (isStage_ioF P e).insert_lower (isLowerFinset_filter_le P e)).mpr
      (stageMap_icF_quasiIso P hdd haug hcl e)

/-- **The local condition holds at every cell**, by strong induction on the dimension: at `e`,
(A) needs it only at the proper faces of `e`. -/
theorem locMap_quasiIso (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero)
    (haug : P.HasAugZero) (hcl : Work.MbarHomology.IsCellAcyclic P hdd) (e : P.Cell) :
    QuasiIso (locMap P hdd haug e) := by
  have hmain : ∀ n, ∀ e : P.Cell, P.dim e = n → QuasiIso (locMap P hdd haug e) := by
    intro n
    induction n using Nat.strong_induction_on with
    | _ n ih =>
      intro e he
      refine locMap_quasiIso_aux P hdd haug hcl e fun a ha => ih (P.dim a) ?_ a rfl
      have hlt : a < e := by simpa [ioF] using ha
      exact lt_of_lt_of_le (P.dim_lt hlt.le (ne_of_lt hlt)) (le_of_eq he)
  exact hmain (P.dim e) e rfl

/-- **Closed-cell acyclicity implies local sphericity.** -/
theorem locallySpherical_of_closed (P : Work.Subdivision.PolyCW) (hdd : P.HasDdZero) (haug : P.HasAugZero) (hcl : Work.MbarHomology.IsCellAcyclic P hdd) : P.LocallySpherical hdd haug :=
  fun e => locMap_quasiIso P hdd haug hcl e

end

end Work.MbarHomology.Local
