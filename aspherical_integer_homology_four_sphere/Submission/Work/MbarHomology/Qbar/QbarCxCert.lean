/-
# Transport and model lemmas for the closed-cell certificates

The per-cell `SDR` data of the closed cells of `Q̄` (files `CxData/*.lean`, generated by
`Submission/Work/MbarHomology/scripts/gen_qbar_cx_sdr2.py`) is computed from an *explicit
enumeration* `E e k` of the `k`-cells below the cell `e` (a literal list of face indices), so
that the kernel can evaluate the sparse identities quickly.

This file provides

* the literal sparse data formats `svecOfNat`/`sopOfNat` and the transports `svecCast`/`sopCast`,
* `bdOfEnum`, the boundary matrix of a closed cell computed from the enumeration `E`, and
  `bdOfEnum_toMatrix`, its entry formula,
* `cellD_eq_bdOfEnum`: **the geometric cellular differential of the closed cell of `e` is
  computed by `bdOfEnum E` in the coordinates `E`** — a *symbolic* comparison (a case split on
  the facet table `qFacet` of `Q̄`), valid for every enumeration `E`, so that no per-entry
  computation is needed in the per-cell assembly,
* the two generic ingredients of the final assembly: the homology isomorphism induced by an
  isomorphism of chain complexes, and the identification of the model `bModel` with the homology
  of a point.
-/
import Mathlib
import Submission.Work.Certificates.SDR
import Submission.Work.Certificates.SDR.sound
import Submission.Work.Certificates.exists_iso_of_subsingleton
import Submission.Work.Certificates.SVec.toFun_filterMap_finRange
import Submission.Work.MbarHomology.Local.CellLe
import Submission.Work.MbarHomology.Qbar.QbarCxEnum
import Submission.Work.MbarHomology.Qbar.CellDApply
import Submission.Work.MbarHomology.Qbar.bdData_toMatrix

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option maxRecDepth 100000
set_option autoImplicit false

namespace Work.MbarHomology

open CategoryTheory

/-! ### Literal sparse data -/

/-- A sparse vector from a list of `(index, coefficient)` pairs with plain `ℕ` indices (the
out-of-range entries are dropped): this is the format in which the generated data is written, so
that the kernel can evaluate it without the elaborate proof terms of `Fin.cast`. -/
def svecOfNat (n : ℕ) (l : List (ℕ × ℤ)) : Work.Certificates.SVec n :=
  l.filterMap fun p => if h : p.1 < n then some (⟨p.1, h⟩, p.2) else none

/-- A sparse operator from the list of its columns, each given as `(index, coefficient)` pairs with
plain `ℕ` indices. -/
def sopOfNat (n m : ℕ) (cols : List (List (ℕ × ℤ))) : Work.Certificates.SOp n m :=
  ⟨fun j => svecOfNat n (cols.getD j.val [])⟩

/-- Sparse vectors transported along an equality of the ambient ranks. -/
def svecCast {n m : ℕ} (h : n = m) (v : Work.Certificates.SVec n) : Work.Certificates.SVec m :=
  v.map fun p => (Fin.cast h p.1, p.2)

/-- Sparse operators transported along equalities of the ranks. -/
def sopCast {n m n' m' : ℕ} (h : n = n') (h' : m = m') (A : Work.Certificates.SOp n m) :
    Work.Certificates.SOp n' m' :=
  ⟨fun j => svecCast h (A.img (Fin.cast h'.symm j))⟩

/-- The coefficient sum `ℤ^{n} → ℤ`, as a sparse operator (`1` on every generator). -/
def coefSumSOp (n : ℕ) : Work.Certificates.SOp 1 n := ⟨fun _ => [(0, (1 : ℤ))]⟩

/-- The section `ℤ → ℤ^{n}` onto one generator. -/
def vertexSOp (n : ℕ) (i : Fin n) : Work.Certificates.SOp n 1 := ⟨fun _ => [(i, (1 : ℤ))]⟩

/-! ### The boundary matrix of a closed cell from an explicit enumeration -/

/-- The `(i,j)`-entry of the boundary matrix of a closed cell, computed from an *explicit
enumeration* `E k` of the `k`-cells below the cell (a literal list of face indices): this is the
same formula as `bdEntry`, but with the enumeration given as data, so that the kernel can evaluate
it quickly. -/
def bdEntryE (E : ℕ → List (Fin 865)) (k : ℕ) (i : Fin (E k).length)
    (j : Fin (E (k+1)).length) : ℤ :=
  if (E k).get i ∈ qFacet ((E (k+1)).get j) then
    qInc ((E (k+1)).get j) ((E k).get i) else 0

/-- **The boundary matrix of a closed cell**, computed from the enumeration `E`: the `j`-th column
is the boundary of the `j`-th `(k+1)`-cell below the cell, written in the coordinates `E k` (the
non-zero entries only). -/
def bdOfEnum (E : ℕ → List (Fin 865)) (k : ℕ) :
    Work.Certificates.SOp (E k).length (E (k+1)).length :=
  ⟨fun j => (List.finRange (E k).length).filterMap fun i =>
      if bdEntryE E k i j = 0 then none else some (i, bdEntryE E k i j)⟩

/-- The `(i,j)`-entry of `bdOfEnum` is its defining formula. -/
theorem bdOfEnum_toMatrix (E : ℕ → List (Fin 865)) (k : ℕ) (i : Fin (E k).length)
    (j : Fin (E (k+1)).length) :
    (bdOfEnum E k).toMatrix i j = bdEntryE E k i j :=
  congrFun (Work.Certificates.SVec.toFun_filterMap_finRange (E k).length
    (fun i' => bdEntryE E k i' j)) i

/-! ### The geometric differential in the coordinates `E` -/

section

-- `QbarCW.Cell` is definitionally `QbarCell`, but the projection `QbarCW.facets` is elaborated
-- with argument type `QbarCW.Cell`; the legacy transparency behaviour lets `rw`/`exact` identify
-- the two (as in `QbarCW_hasAugZero.lean`).
set_option backward.isDefEq.respectTransparency false

/-- **The geometric cellular differential of the closed cell of `e` is computed by `bdOfEnum E`**
in the coordinates given by the enumeration `c` of the cells below `e`.  The proof is symbolic: a
case split on whether `(E k).get i` is listed among the facets of `(E (k+1)).get j`, using only
the *soundness* of the facet table (`qFacet_isFacet`) and the definition of `qInc`. -/
theorem cellD_eq_bdOfEnum (E : ℕ → List (Fin 865))
    (c : ∀ k, Fin (E k).length → {f : QbarCell // QbarCW.dim f = k})
    (hc : ∀ k i, (c k i).1 = ⟨(E k).get i⟩) :
    ∀ (k : ℕ) (i : Fin (E k).length) (j : Fin (E (k+1)).length),
      (QbarCW.cellD k (Finsupp.single (c (k+1) j) 1)) (c k i) =
        (bdOfEnum E k).toMatrix i j := by
  intro k i j
  rw [bdOfEnum_toMatrix]
  unfold bdEntryE
  rw [Work.MbarHomology.Qbar.qbar_cellD_apply_single]
  rw [hc k i, hc (k+1) j]
  rw [QbarCW_inc]
  by_cases h : (E k).get i ∈ qFacet ((E (k+1)).get j)
  · rw [ite_eq_left h]
    rw [qInc, ite_eq_left h]
    rw [ite_eq_left (Work.MbarHomology.Qbar.qFacet_isFacet ((E (k+1)).get j) ((E k).get i) h)]
  · rw [ite_eq_right h]
    rw [qInc, ite_eq_right h]
    by_cases h2 : (⟨(E k).get i⟩ : QbarCell) ∈ QbarCW.facets (⟨(E (k+1)).get j⟩ : QbarCell)
    · rw [ite_eq_left h2]
    · rw [ite_eq_right h2]

end

/-! ### The assembly -/

/-- An isomorphism of chain complexes induces an isomorphism on homology. -/
theorem homology_iso_of_iso {C D : ChainComplex (ModuleCat ℤ) ℕ} (h : Nonempty (C ≅ D)) (k : ℕ) :
    Nonempty (C.homology k ≅ D.homology k) := by
  obtain ⟨e⟩ := h
  exact ⟨(HomologicalComplex.homologyFunctor (ModuleCat ℤ) (ComplexShape.down ℕ) k).mapIso e⟩

/-- The model complex `bModel` has the homology of a point: `ℤ` in degree `0` and nothing above. -/
theorem bModel_iso (k : ℕ) :
    Nonempty (ModuleCat.of ℤ (Fin (bModel k) → ℤ) ≅ cellHomModel k) := by
  by_cases hk : k = 0
  · subst hk
    exact ⟨(LinearEquiv.funUnique (Fin 1) ℤ ℤ).toModuleIso⟩
  · have hb : bModel k = 0 := bModel_eq_zero hk
    rw [hb, cellHomModel, if_neg hk]
    exact Work.Certificates.exists_iso_of_subsingleton
      (M := ModuleCat.of ℤ (Fin 0 → ℤ)) (N := ModuleCat.of ℤ PUnit)

/-- **Closed-cell acyclicity from an SDR certificate and a coordinate presentation.** -/
theorem cellAcyclic_of_sdr {C : Work.Certificates.FinChainCx} {e : QbarCell}
    (hdd : Work.Subdivision.PolyCW.HasDdZero QbarCW)
    (hiso : Nonempty (C.toChainComplex ≅ cellLe QbarCW hdd e))
    (hSDR : ∀ k, Nonempty (C.homology k ≅ ModuleCat.of ℤ (Fin (bModel k) → ℤ))) (k : ℕ) :
    Nonempty ((cellLe QbarCW hdd e).homology k ≅ cellHomModel k) := by
  obtain ⟨i1⟩ := homology_iso_of_iso hiso k
  obtain ⟨i2⟩ := hSDR k
  obtain ⟨i3⟩ := bModel_iso k
  exact ⟨i1.symm.trans (i2.trans i3)⟩

end Work.MbarHomology
