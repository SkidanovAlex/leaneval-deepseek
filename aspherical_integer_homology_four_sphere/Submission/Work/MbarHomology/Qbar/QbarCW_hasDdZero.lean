/-
# `∂ ∘ ∂ = 0` for the face poset of `Q̄`

`QbarCW : PolyCW` is the face poset of the truncated 24-cell, with incidence numbers `qInc` taken
from rt_complex.  The statement proved here is `QbarCW.HasDdZero`, i.e. the cellular differential
`∂e = ∑_{f ⋖ e} inc(e,f) • f` satisfies `∂ ∘ ∂ = 0`.

## Proof

1. **Generic algebra** (`Work.Subdivision.PolyCW.cellDval_apply`,
   `cellD_comp_single_apply`, `dd2`, `hasDdZero_of_dd2`).  For a general `PolyCW`, the composed
   differential vanishes iff for all `k`, all `(k+2)`-cells `e` and all `k`-cells `g` the
   coefficient `dd2 k e g = ∑_{f ∈ facets e, g ∈ facets f} inc e f · inc f g` vanishes.

2. **The table identity** `dd2_eq_ddTab`.  Here only the *cheap* half of the bridge
   `mem_facets_of_mem_qFacet` (an entry of `qFacet e` is a facet of `e`, proved from the generated
   check `facetCond_all`) is used, together with `mem_facets_iff` (facets are exactly the faces
   obtained by adding one constraint to the tight set).  The *converse* half is not needed: the
   table `qInc x y` is `0` unless `y ∈ qFacet x` (`qInc` is defined by that `if`), so the summands
   over the extra elements of `facets e` vanish automatically.  This replaces `dd2` by the purely
   table-valued double sum `ddTab e g`.

3. **The table identities** (`QbarDdCheck.lean`, generated by
   `scripts/gen_qbar_dd_check.py`, which re-verifies every identity in Python first):
   * `facetCond_all`:   every entry of the generated list `Flist e` satisfies the codimension-one
     tight-set relation,
   * `facetComplete_all`:  `Flist e` lists exactly `qFacet e`,
   * `coefChk_all`:  `ddTab e g = 0` for every entry `g` of the generated list `Slist e`,
   * `coefComplete_all`:  `Slist e` lists exactly `⋃_{f ∈ qFacet e} qFacet f`.

   The lists are checked with `List.all` (cheap for the kernel) rather than with `∀ x ∈ s, …`
   (which re-enumerates all of `Fin 865` per element); the coefficient family is split into index
   ranges because it dominates the kernel's memory.  Everything is a kernel-checked `decide`:
   no `native_decide` and no extra axioms.

4. **Assembly** (`coefChk_mem` and the main theorem): for a `k`-cell `g` that is a face of a facet
   of `e` the coefficient is zero by the certificate, and otherwise `ddTab_zero_of_notMem` applies.
-/
import Mathlib
import Submission.Work.MbarHomology.Qbar.QbarDdCheck

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option maxRecDepth 100000
set_option autoImplicit false

namespace Work.MbarHomology.Qbar

open Work.MbarHomology

open Work.Subdivision
open Work.Subdivision.PolyCW

section General

variable {P : PolyCW}

/-- The `(k+1)`-cell `e` of `∂` evaluated at the `k`-cell `g`. -/
lemma cellDval_apply (k : ℕ) (e : {e : P.Cell // P.dim e = k + 1})
    (g : {g : P.Cell // P.dim g = k}) :
    cellDval P k e g = (if g.1 ∈ P.facets e.1 then P.inc e.1 g.1 else 0) := by
  simp only [cellDval, Finsupp.finsetSum_apply, Finsupp.smul_apply, Finsupp.single_apply,
    smul_eq_mul, Subtype.ext_iff]
  rw [Finset.sum_attach (f := fun x : P.Cell => P.inc e.1 x * if x = g.1 then (1:ℤ) else 0)]
  simp only [mul_ite, mul_one, mul_zero]
  rw [Finset.sum_ite_eq']

/-- The coefficient of the `k`-cell `g` in `∂∂e`, for a `(k+2)`-cell `e`. -/
lemma cellD_comp_single_apply (k : ℕ) (e : {e : P.Cell // P.dim e = k + 2})
    (g : {g : P.Cell // P.dim g = k}) :
    ((cellD P k).comp (cellD P (k+1))) (Finsupp.single e 1) g =
      ∑ f ∈ (P.facets e.1).filter (fun f => g.1 ∈ P.facets f), P.inc e.1 f * P.inc f g.1 := by
  rw [LinearMap.comp_apply, cellD_single, cellDval]
  simp only [map_sum, map_smul, cellD_single]
  rw [Finsupp.finsetSum_apply]
  simp only [Finsupp.smul_apply, smul_eq_mul, cellDval_apply]
  rw [Finset.sum_attach (f := fun x : P.Cell =>
      P.inc e.1 x * (if g.1 ∈ P.facets x then P.inc x g.1 else 0))]
  rw [Finset.sum_filter]
  simp only [mul_ite, mul_zero]

/-- The coefficient of the `k`-cell `g` in `∂∂e` (a filtered sum over the facets of `e`). -/
noncomputable def dd2 (k : ℕ) (e : {e : P.Cell // P.dim e = k + 2})
    (g : {g : P.Cell // P.dim g = k}) : ℤ :=
  ∑ f ∈ (P.facets e.1).filter (fun f => g.1 ∈ P.facets f), P.inc e.1 f * P.inc f g.1

/-- `∂ ∘ ∂ = 0` follows from the vanishing of all coefficients `dd2 k e g`. -/
theorem hasDdZero_of_dd2
    (h : ∀ k (e : {e : P.Cell // P.dim e = k + 2}) (g : {g : P.Cell // P.dim g = k}),
      dd2 k e g = 0) : P.HasDdZero := by
  intro k
  apply Finsupp.lhom_ext
  intro a b
  have h0 : ((cellD P k).comp (cellD P (k+1))) (Finsupp.single a 1) = 0 := by
    apply Finsupp.ext
    intro g
    rw [cellD_comp_single_apply, Finsupp.zero_apply]
    exact h k a g
  have hs : (Finsupp.single a b : cellMod P (k+2)) = b • Finsupp.single a 1 := by
    ext x
    rw [Finsupp.smul_apply, Finsupp.single_apply, Finsupp.single_apply]
    by_cases hx : x = a <;> simp [hx]
  rw [hs, map_smul, h0, smul_zero]
  simp

end General

open Work.MbarHomology
open Classical

/-- The facets of `e` are exactly the faces whose tight set is obtained from that of `e` by adding
one constraint. -/
theorem mem_facets_iff (e f : QbarCW.Cell) :
    f ∈ QbarCW.facets e ↔
      qTight e.idx ⊆ qTight f.idx ∧ (qTight f.idx).card = (qTight e.idx).card + 1 := by
  rw [show f ∈ QbarCW.facets e ↔ (f < e ∧ QbarCW.dim e = QbarCW.dim f + 1) from by
    simp only [PolyCW.facets, Finset.mem_filter, Finset.mem_univ, true_and]]
  constructor
  · intro ⟨hlt, hdim⟩
    rw [show f < e ↔ qTight e.idx ⊆ qTight f.idx ∧ ¬ qTight f.idx ⊆ qTight e.idx from Iff.rfl] at hlt
    rw [show QbarCW.dim e = 4 - (qTight e.idx).card from rfl,
      show QbarCW.dim f = 4 - (qTight f.idx).card from rfl] at hdim
    refine ⟨hlt.1, ?_⟩
    have h1 := qCard_le e.idx
    have h2 := qCard_le f.idx
    omega
  · intro ⟨hsub, hcard⟩
    rw [show f < e ↔ qTight e.idx ⊆ qTight f.idx ∧ ¬ qTight f.idx ⊆ qTight e.idx from Iff.rfl]
    rw [show QbarCW.dim e = 4 - (qTight e.idx).card from rfl,
      show QbarCW.dim f = 4 - (qTight f.idx).card from rfl]
    refine ⟨⟨hsub, ?_⟩, ?_⟩
    · intro hcontra
      have hle : (qTight f.idx).card ≤ (qTight e.idx).card := Finset.card_le_card hcontra
      omega
    · have h1 := qCard_le e.idx
      have h2 := qCard_le f.idx
      omega

/-- Every entry of the facet table `qFacet e` is a facet of `e` (the cheap half of the bridge). -/
theorem mem_facets_of_mem_qFacet {e f : Fin 865} (h : f ∈ qFacet e) :
    (⟨f⟩ : QbarCW.Cell) ∈ QbarCW.facets (⟨e⟩ : QbarCW.Cell) := by
  have hF : f ∈ Flist e := by
    rw [← List.mem_toFinset, facetComplete_all e]
    exact h
  have hc : qTight e ⊆ qTight f ∧ (qTight f).card = (qTight e).card + 1 :=
    of_decide_eq_true (List.all_eq_true.mp (facetCond_all e) f hF)
  exact (mem_facets_iff ⟨e⟩ ⟨f⟩).mpr hc

/-- `dd2` expressed purely in terms of the generated tables. -/
theorem dd2_eq_ddTab (k : ℕ) (e : {e : QbarCW.Cell // QbarCW.dim e = k + 2})
    (g : {g : QbarCW.Cell // QbarCW.dim g = k}) :
    dd2 k e g = ddTab e.1.idx g.1.idx := by
  have hsub : (qFacet e.1.idx).image (fun i => (⟨i⟩ : QbarCW.Cell)) ⊆ QbarCW.facets e.1 := by
    intro x hx
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    exact mem_facets_of_mem_qFacet hi
  have hzero : ∀ x ∈ QbarCW.facets e.1,
      x ∉ (qFacet e.1.idx).image (fun i => (⟨i⟩ : QbarCW.Cell)) →
      (if g.1 ∈ QbarCW.facets x then QbarCW.inc e.1 x * QbarCW.inc x g.1 else 0) = 0 := by
    intro x hx hxn
    have hxq : x.idx ∉ qFacet e.1.idx := by
      intro hc
      exact hxn (Finset.mem_image.mpr ⟨x.idx, hc, rfl⟩)
    have hz : QbarCW.inc e.1 x = 0 := by
      rw [show QbarCW.inc e.1 x = qInc e.1.idx x.idx from rfl]
      simp [qInc, hxq]
    by_cases hg : g.1 ∈ QbarCW.facets x
    · rw [if_pos hg, hz, zero_mul]
    · rw [if_neg hg]
  have hinj : Set.InjOn (fun i : Fin 865 => (⟨i⟩ : QbarCW.Cell)) ↑(qFacet e.1.idx) := by
    intro a _ b _ hab
    exact congrArg QbarCell.idx hab
  rw [dd2, ddTab, Finset.sum_filter]
  calc ∑ x ∈ QbarCW.facets e.1,
        (if g.1 ∈ QbarCW.facets x then QbarCW.inc e.1 x * QbarCW.inc x g.1 else 0)
      = ∑ x ∈ (qFacet e.1.idx).image (fun i => (⟨i⟩ : QbarCW.Cell)),
        (if g.1 ∈ QbarCW.facets x then QbarCW.inc e.1 x * QbarCW.inc x g.1 else 0) :=
        (Finset.sum_subset hsub hzero).symm
    _ = ∑ i ∈ qFacet e.1.idx,
        (if g.1 ∈ QbarCW.facets (⟨i⟩ : QbarCW.Cell)
          then QbarCW.inc e.1 (⟨i⟩ : QbarCW.Cell) * QbarCW.inc (⟨i⟩ : QbarCW.Cell) g.1 else 0) :=
        Finset.sum_image hinj
    _ = ∑ i ∈ qFacet e.1.idx,
        (if g.1.idx ∈ qFacet i then qInc e.1.idx i * qInc i g.1.idx else 0) := by
        apply Finset.sum_congr rfl
        intro i hi
        by_cases h : g.1.idx ∈ qFacet i
        · have hf : (⟨g.1.idx⟩ : QbarCW.Cell) ∈ QbarCW.facets (⟨i⟩ : QbarCW.Cell) :=
            mem_facets_of_mem_qFacet h
          have hf' : g.1 ∈ QbarCW.facets (⟨i⟩ : QbarCW.Cell) := hf
          have hI : QbarCW.inc e.1 (⟨i⟩ : QbarCW.Cell) = qInc e.1.idx i := rfl
          have hJ : QbarCW.inc (⟨i⟩ : QbarCW.Cell) g.1 = qInc i g.1.idx := rfl
          simp only [h, hf', if_true]
          rw [hI, hJ]
        · have hz : qInc i g.1.idx = 0 := by simp [qInc, h]
          have hz2 : QbarCW.inc (⟨i⟩ : QbarCW.Cell) g.1 = 0 := by
            rw [show QbarCW.inc (⟨i⟩ : QbarCW.Cell) g.1 = qInc i g.1.idx from rfl, hz]
          simp only [h, if_false, hz, hz2, mul_zero]
          split <;> rfl

/-- The dispatched coefficient check, in the `∀ g ∈ Sset e` form used by the assembly. -/
theorem coefChk_mem (e : Fin 865) : ∀ g ∈ Sset e, ddTab e g = 0 := by
  have h1 := coefChk_all e
  have h2 := coefComplete_all e
  intro g hg
  have hg' : g ∈ Slist e := by
    rw [← List.mem_toFinset, h2]
    exact hg
  exact of_decide_eq_true (List.all_eq_true.mp h1 g hg')

theorem QbarCW_hasDdZero : Work.Subdivision.PolyCW.HasDdZero Work.MbarHomology.QbarCW := by
  apply hasDdZero_of_dd2
  intro k e g
  rw [dd2_eq_ddTab]
  by_cases hmem : g.1.idx ∈ Sset e.1.idx
  · exact coefChk_mem e.1.idx g.1.idx hmem
  · exact ddTab_zero_of_notMem hmem

end Work.MbarHomology.Qbar
