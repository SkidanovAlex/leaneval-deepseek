/-! ### the closed cell of the face `48` -/

def E48 : ℕ → List (Fin 865)
  | 0 => [579, 602, 611, 614]
  | 1 => [295, 303, 306, 314]
  | 2 => [48]
  | 3 => []
  | 4 => []
  | _ => []

theorem E48_len0 : (E48 0).length = 4 := rfl
theorem E48_len1 : (E48 1).length = 4 := rfl
theorem E48_len2 : (E48 2).length = 1 := rfl
theorem E48_len3 : (E48 3).length = 0 := rfl
theorem E48_len4 : (E48 4).length = 0 := rfl

theorem E48_nil5 (k : ℕ) : E48 (k+5) = [] := rfl

theorem E48_dimtop : QbarCW.dim (⟨(48 : Fin 865)⟩ : QbarCell) ≤ 2 := by decide

theorem E48_nil3 : E48 3 = [] := rfl
theorem E48_nil4 : E48 4 = [] := rfl

theorem E48_hE0 : E48 0 = dimListLe 48 0 := by decide
theorem E48_hE1 : E48 1 = dimListLe 48 1 := by decide
theorem E48_hE2 : E48 2 = dimListLe 48 2 := by decide
theorem E48_hE3 : E48 3 = dimListLe 48 3 := by
  rw [E48_nil3, dimListLe_eq_nil_of_dim_lt (by decide)]
theorem E48_hE4 : E48 4 = dimListLe 48 4 := by
  rw [E48_nil4, dimListLe_eq_nil_of_dim_lt (by decide)]

theorem E48_hE (k : ℕ) : E48 k = dimListLe 48 k := by
  match k with
  | 0 => exact E48_hE0
  | 1 => exact E48_hE1
  | 2 => exact E48_hE2
  | 3 => exact E48_hE3
  | 4 => exact E48_hE4
  | k+5 => rw [E48_nil5, dimListLe_eq_nil 48 (k+5) (by omega)]

theorem E48_dim (k : ℕ) (i : Fin (E48 k).length) : QbarCW.dim (⟨(E48 k).get i⟩ : QbarCell) = k := by
  have hmem : (E48 k).get i ∈ dimListLe 48 k := by
    rw [← E48_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E48_le (k : ℕ) (i : Fin (E48 k).length) : (⟨(E48 k).get i⟩ : QbarCell) ≤ (⟨(48 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E48 k).get i ∈ dimListLe 48 k := by
    rw [← E48_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E48_nodup (k : ℕ) : (E48 k).Nodup := by
  rw [E48_hE k]
  exact dimListLe_nodup 48 k

def c48 : ∀ k, Fin (E48 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E48 k).get i⟩, E48_dim k i⟩

theorem c48_le (k : ℕ) (i : Fin (E48 k).length) : (c48 k i).1 ≤ (⟨(48 : Fin 865)⟩ : QbarCell) :=
  E48_le k i

theorem c48_inj : ∀ k, Function.Injective (c48 k) := by
  intro k i j hij
  have h1 : (E48 k).get i = (E48 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E48_nodup k).get_inj_iff.mp h1

theorem c48_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(48 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c48 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 48 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 48 0).get i' ∈ E48 0 := by
        rw [E48_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c48 0 i).1 = (⟨(E48 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 48 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 48 1).get i' ∈ E48 1 := by
        rw [E48_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c48 1 i).1 = (⟨(E48 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 48 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 48 2).get i' ∈ E48 2 := by
        rw [E48_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c48 2 i).1 = (⟨(E48 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 48 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 48 3).get i' ∈ E48 3 := by
        rw [E48_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c48 3 i).1 = (⟨(E48 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 48 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 48 4).get i' ∈ E48 4 := by
        rw [E48_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c48 4 i).1 = (⟨(E48 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

