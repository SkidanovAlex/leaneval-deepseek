theorem E96_hE (k : ℕ) : E96 k = dimListLe 96 k := by
  match k with
  | 0 => exact E96_hE0
  | 1 => exact E96_hE1
  | 2 => exact E96_hE2
  | 3 => exact E96_hE3
  | 4 => exact E96_hE4
  | k+5 => rw [E96_nil5, dimListLe_eq_nil 96 (k+5) (by omega)]

theorem E96_dim (k : ℕ) (i : Fin (E96 k).length) : QbarCW.dim (⟨(E96 k).get i⟩ : QbarCell) = k := by
  have hmem : (E96 k).get i ∈ dimListLe 96 k := by
    rw [← E96_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E96_le (k : ℕ) (i : Fin (E96 k).length) : (⟨(E96 k).get i⟩ : QbarCell) ≤ (⟨(96 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E96 k).get i ∈ dimListLe 96 k := by
    rw [← E96_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E96_nodup (k : ℕ) : (E96 k).Nodup := by
  rw [E96_hE k]
  exact dimListLe_nodup 96 k

def c96 : ∀ k, Fin (E96 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E96 k).get i⟩, E96_dim k i⟩

