  E96_le k i

theorem c96_inj : ∀ k, Function.Injective (c96 k) := by
  intro k i j hij
  have h1 : (E96 k).get i = (E96 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E96_nodup k).get_inj_iff.mp h1

theorem c96_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(96 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c96 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 96 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 96 0).get i' ∈ E96 0 := by
        rw [E96_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c96 0 i).1 = (⟨(E96 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 96 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 96 1).get i' ∈ E96 1 := by
        rw [E96_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c96 1 i).1 = (⟨(E96 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 96 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 96 2).get i' ∈ E96 2 := by
        rw [E96_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c96 2 i).1 = (⟨(E96 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 96 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 96 3).get i' ∈ E96 3 := by
        rw [E96_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c96 3 i).1 = (⟨(E96 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 96 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 96 4).get i' ∈ E96 4 := by
        rw [E96_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c96 4 i).1 = (⟨(E96 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

