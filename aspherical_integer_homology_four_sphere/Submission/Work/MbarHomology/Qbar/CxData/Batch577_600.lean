def Cx600 : Work.Certificates.FinChainCx where
  dim := fun k => (E600 k).length
  bd := Cx600_bd
  bd_comp := Work.Certificates.FinChainCx.bdCheck_sound
    (dim := fun k => (E600 k).length) (bd := Cx600_bd) (N := 5)
    (fun k hk => E600_len_zero hk)
    (Work.Certificates.FinChainCx.bdCheck_of_pieces (N := 5) (fun k hk => by
      interval_cases k
      · exact Cx600_bdcomp0
