theorem Cx600_hbd' : ∀ (k : ℕ) (i : Fin (Cx600.dim k)) (j : Fin (Cx600.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c600 (k+1) j) 1)) (c600 k i) = (Cx600_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx600_bdEq k hk)]
    exact cellD_eq_bdOfEnum E600 c600 (fun k i => rfl) k i j
  · have h0 : (E600 k).length = 0 := E600_len_zero (by omega)
    have hlt : i.val < (E600 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

