  | 1 => exact E600_hE1
  | 2 => exact E600_hE2
  | 3 => exact E600_hE3
  | 4 => exact E600_hE4
  | k+5 => rw [E600_nil5, dimListLe_eq_nil 600 (k+5) (by omega)]

theorem E600_dim (k : ℕ) (i : Fin (E600 k).length) : QbarCW.dim (⟨(E600 k).get i⟩ : QbarCell) = k := by
  have hmem : (E600 k).get i ∈ dimListLe 600 k := by
    rw [← E600_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E600_le (k : ℕ) (i : Fin (E600 k).length) : (⟨(E600 k).get i⟩ : QbarCell) ≤ (⟨(600 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E600 k).get i ∈ dimListLe 600 k := by
    rw [← E600_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E600_nodup (k : ℕ) : (E600 k).Nodup := by
  rw [E600_hE k]
  exact dimListLe_nodup 600 k

def c600 : ∀ k, Fin (E600 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E600 k).get i⟩, E600_dim k i⟩

theorem c600_le (k : ℕ) (i : Fin (E600 k).length) : (c600 k i).1 ≤ (⟨(600 : Fin 865)⟩ : QbarCell) :=
  E600_le k i

theorem c600_inj : ∀ k, Function.Injective (c600 k) := by
  intro k i j hij
  have h1 : (E600 k).get i = (E600 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E600_nodup k).get_inj_iff.mp h1

theorem c600_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(600 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c600 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 600 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 600 0).get i' ∈ E600 0 := by
        rw [E600_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c600 0 i).1 = (⟨(E600 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 600 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 600 1).get i' ∈ E600 1 := by
        rw [E600_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c600 1 i).1 = (⟨(E600 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 600 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 600 2).get i' ∈ E600 2 := by
        rw [E600_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c600 2 i).1 = (⟨(E600 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 600 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 600 3).get i' ∈ E600 3 := by
        rw [E600_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c600 3 i).1 = (⟨(E600 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 600 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 600 4).get i' ∈ E600 4 := by
        rw [E600_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c600 4 i).1 = (⟨(E600 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

theorem E600_len_zero {k : ℕ} (hk : 5 ≤ k) : (E600 k).length = 0 := by
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 5 := ⟨k - 5, by omega⟩
  rfl

