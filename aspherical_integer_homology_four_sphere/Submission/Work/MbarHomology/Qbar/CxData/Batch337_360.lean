  b := bModel
  Z := Cx360_Z
  ρ := Cx360_rho
  h := Cx360_h
  dim_zero := fun k hk => E360_len_zero hk
  b_zero := fun k hk => by simp [bModel]; omega

theorem Cx360_checkHomZero : Cx360_sdr.checkHomZero = true := by decide +kernel
theorem Cx360_checkDeg0 : Cx360_sdr.checkDeg 0 = true := by decide +kernel
theorem Cx360_checkDeg1 : Cx360_sdr.checkDeg 1 = true := by decide +kernel
theorem Cx360_checkDeg2 : Cx360_sdr.checkDeg 2 = true := by decide +kernel
theorem Cx360_checkDeg3 : Cx360_sdr.checkDeg 3 = true := by decide +kernel
theorem Cx360_checkDeg4 : Cx360_sdr.checkDeg 4 = true := by decide +kernel

theorem Cx360_sdr_check : Cx360_sdr.check = true := by
  rw [Work.Certificates.SDR.check_eq, Cx360_checkHomZero, Bool.true_and, List.all_eq_true]
  intro k hk
  have hk5 : k < 5 := List.mem_range.mp hk
  interval_cases k
  · exact Cx360_checkDeg0
  · exact Cx360_checkDeg1
  · exact Cx360_checkDeg2
  · exact Cx360_checkDeg3
  · exact Cx360_checkDeg4

theorem Cx360_homology (k : ℕ) : Nonempty ((Cx360).homology k ≅ ModuleCat.of ℤ (Fin (bModel k) → ℤ)) :=
  Work.Certificates.SDR.sound Cx360_sdr Cx360_sdr_check k

theorem Cx360_acyclic (hdd : QbarCW.HasDdZero) (k : ℕ) :
    Nonempty ((cellLe QbarCW hdd (⟨(360 : Fin 865)⟩ : QbarCell)).homology k ≅ cellHomModel k) :=
  cellAcyclic_of_sdr hdd
    (Work.MbarHomology.Qbar.cellLe_iso_finChainCx QbarCW hdd (⟨(360 : Fin 865)⟩ : QbarCell) Cx360
      c360 (c360_le) (c360_inj) (c360_surj) (Cx360_hbd'))
    (Cx360_homology) k


end QbarCxData

end Work.MbarHomology
