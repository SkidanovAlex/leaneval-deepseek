    (Work.MbarHomology.Qbar.cellLe_iso_finChainCx QbarCW hdd (⟨(11 : Fin 865)⟩ : QbarCell) Cx11
      c11 (c11_le) (c11_inj) (c11_surj) (Cx11_hbd'))
    (Cx11_homology) k

