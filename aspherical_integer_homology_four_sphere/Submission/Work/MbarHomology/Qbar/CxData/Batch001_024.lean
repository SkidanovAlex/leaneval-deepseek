  | 0 => [630, 738, 773, 776, 779, 782, 785, 788]
  | 1 => [258, 266, 279, 287, 326, 334, 342, 439, 447, 519, 522, 571]
  | 2 => [42, 54, 91, 125, 162, 182]
  | 3 => [11]
  | 4 => []
  | _ => []

theorem E11_len0 : (E11 0).length = 8 := rfl
theorem E11_len1 : (E11 1).length = 12 := rfl
theorem E11_len2 : (E11 2).length = 6 := rfl
theorem E11_len3 : (E11 3).length = 1 := rfl
theorem E11_len4 : (E11 4).length = 0 := rfl

theorem E11_nil5 (k : ℕ) : E11 (k+5) = [] := rfl

theorem E11_dimtop : QbarCW.dim (⟨(11 : Fin 865)⟩ : QbarCell) ≤ 3 := by decide +kernel

theorem E11_nil4 : E11 4 = [] := rfl

theorem E11_hE0 : E11 0 = dimListLe 11 0 := by decide +kernel
theorem E11_hE1 : E11 1 = dimListLe 11 1 := by decide +kernel
theorem E11_hE2 : E11 2 = dimListLe 11 2 := by decide +kernel
theorem E11_hE3 : E11 3 = dimListLe 11 3 := by decide +kernel
theorem E11_hE4 : E11 4 = dimListLe 11 4 := by
  rw [E11_nil4, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]

theorem E11_hE (k : ℕ) : E11 k = dimListLe 11 k := by
  match k with
  | 0 => exact E11_hE0
  | 1 => exact E11_hE1
  | 2 => exact E11_hE2
  | 3 => exact E11_hE3
  | 4 => exact E11_hE4
  | k+5 => rw [E11_nil5, dimListLe_eq_nil 11 (k+5) (by omega)]

theorem E11_dim (k : ℕ) (i : Fin (E11 k).length) : QbarCW.dim (⟨(E11 k).get i⟩ : QbarCell) = k := by
  have hmem : (E11 k).get i ∈ dimListLe 11 k := by
    rw [← E11_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E11_le (k : ℕ) (i : Fin (E11 k).length) : (⟨(E11 k).get i⟩ : QbarCell) ≤ (⟨(11 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E11 k).get i ∈ dimListLe 11 k := by
    rw [← E11_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E11_nodup (k : ℕ) : (E11 k).Nodup := by
  rw [E11_hE k]
  exact dimListLe_nodup 11 k

def c11 : ∀ k, Fin (E11 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E11 k).get i⟩, E11_dim k i⟩

theorem c11_le (k : ℕ) (i : Fin (E11 k).length) : (c11 k i).1 ≤ (⟨(11 : Fin 865)⟩ : QbarCell) :=
  E11_le k i

theorem c11_inj : ∀ k, Function.Injective (c11 k) := by
  intro k i j hij
  have h1 : (E11 k).get i = (E11 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E11_nodup k).get_inj_iff.mp h1

theorem c11_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(11 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c11 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 11 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 11 0).get i' ∈ E11 0 := by
        rw [E11_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c11 0 i).1 = (⟨(E11 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 11 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 11 1).get i' ∈ E11 1 := by
        rw [E11_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c11 1 i).1 = (⟨(E11 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 11 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 11 2).get i' ∈ E11 2 := by
        rw [E11_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c11 2 i).1 = (⟨(E11 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 11 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 11 3).get i' ∈ E11 3 := by
        rw [E11_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c11 3 i).1 = (⟨(E11 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 11 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 11 4).get i' ∈ E11 4 := by
        rw [E11_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c11 4 i).1 = (⟨(E11 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

theorem E11_len_zero {k : ℕ} (hk : 5 ≤ k) : (E11 k).length = 0 := by
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 5 := ⟨k - 5, by omega⟩
  rfl

