  bd := Cx24_bd
  bd_comp := Work.Certificates.FinChainCx.bdCheck_sound
    (dim := fun k => (E24 k).length) (bd := Cx24_bd) (N := 5)
    (fun k hk => E24_len_zero hk)
    (Work.Certificates.FinChainCx.bdCheck_of_pieces (N := 5) (fun k hk => by
      interval_cases k
      · exact Cx24_bdcomp0
      · exact Cx24_bdcomp1
      · exact Cx24_bdcomp2
      · exact Cx24_bdcomp3
      · exact Cx24_bdcomp4
      ))

theorem Cx24_hbd' : ∀ (k : ℕ) (i : Fin (Cx24.dim k)) (j : Fin (Cx24.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c24 (k+1) j) 1)) (c24 k i) = (Cx24_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx24_bdEq k hk)]
    exact cellD_eq_bdOfEnum E24 c24 (fun k i => rfl) k i j
  · have h0 : (E24 k).length = 0 := E24_len_zero (by omega)
    have hlt : i.val < (E24 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

