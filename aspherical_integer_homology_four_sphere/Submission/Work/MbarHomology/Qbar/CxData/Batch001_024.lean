def Cx11 : Work.Certificates.FinChainCx where
  dim := fun k => (E11 k).length
  bd := Cx11_bd
  bd_comp := Work.Certificates.FinChainCx.bdCheck_sound
    (dim := fun k => (E11 k).length) (bd := Cx11_bd) (N := 5)
    (fun k hk => E11_len_zero hk)
    (Work.Certificates.FinChainCx.bdCheck_of_pieces (N := 5) (fun k hk => by
      interval_cases k
      · exact Cx11_bdcomp0
      · exact Cx11_bdcomp1
      · exact Cx11_bdcomp2
      · exact Cx11_bdcomp3
      · exact Cx11_bdcomp4
      ))

theorem Cx11_hbd' : ∀ (k : ℕ) (i : Fin (Cx11.dim k)) (j : Fin (Cx11.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c11 (k+1) j) 1)) (c11 k i) = (Cx11_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx11_bdEq k hk)]
    exact cellD_eq_bdOfEnum E11 c11 (fun k i => rfl) k i j
  · have h0 : (E11 k).length = 0 := E11_len_zero (by omega)
    have hlt : i.val < (E11 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

