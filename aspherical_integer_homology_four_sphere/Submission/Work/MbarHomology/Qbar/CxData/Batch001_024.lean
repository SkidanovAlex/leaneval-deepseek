theorem Cx11_acyclic (hdd : QbarCW.HasDdZero) (k : ℕ) :
    Nonempty ((cellLe QbarCW hdd (⟨(11 : Fin 865)⟩ : QbarCell)).homology k ≅ cellHomModel k) :=
