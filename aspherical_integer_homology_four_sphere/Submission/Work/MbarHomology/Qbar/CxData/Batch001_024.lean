theorem E24_hE2 : E24 2 = dimListLe 24 2 := by decide +kernel
theorem E24_hE3 : E24 3 = dimListLe 24 3 := by decide +kernel
theorem E24_hE4 : E24 4 = dimListLe 24 4 := by
  rw [E24_nil4, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]

theorem E24_hE (k : ℕ) : E24 k = dimListLe 24 k := by
  match k with
  | 0 => exact E24_hE0
  | 1 => exact E24_hE1
  | 2 => exact E24_hE2
  | 3 => exact E24_hE3
  | 4 => exact E24_hE4
  | k+5 => rw [E24_nil5, dimListLe_eq_nil 24 (k+5) (by omega)]

theorem E24_dim (k : ℕ) (i : Fin (E24 k).length) : QbarCW.dim (⟨(E24 k).get i⟩ : QbarCell) = k := by
  have hmem : (E24 k).get i ∈ dimListLe 24 k := by
    rw [← E24_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E24_le (k : ℕ) (i : Fin (E24 k).length) : (⟨(E24 k).get i⟩ : QbarCell) ≤ (⟨(24 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E24 k).get i ∈ dimListLe 24 k := by
    rw [← E24_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E24_nodup (k : ℕ) : (E24 k).Nodup := by
  rw [E24_hE k]
  exact dimListLe_nodup 24 k

def c24 : ∀ k, Fin (E24 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E24 k).get i⟩, E24_dim k i⟩

theorem c24_le (k : ℕ) (i : Fin (E24 k).length) : (c24 k i).1 ≤ (⟨(24 : Fin 865)⟩ : QbarCell) :=
  E24_le k i

theorem c24_inj : ∀ k, Function.Injective (c24 k) := by
  intro k i j hij
  have h1 : (E24 k).get i = (E24 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E24_nodup k).get_inj_iff.mp h1

theorem c24_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(24 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c24 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 24 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 24 0).get i' ∈ E24 0 := by
        rw [E24_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c24 0 i).1 = (⟨(E24 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 24 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 24 1).get i' ∈ E24 1 := by
        rw [E24_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c24 1 i).1 = (⟨(E24 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 24 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 24 2).get i' ∈ E24 2 := by
        rw [E24_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c24 2 i).1 = (⟨(E24 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 24 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 24 3).get i' ∈ E24 3 := by
        rw [E24_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c24 3 i).1 = (⟨(E24 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 24 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 24 4).get i' ∈ E24 4 := by
        rw [E24_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c24 4 i).1 = (⟨(E24 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

theorem E24_len_zero {k : ℕ} (hk : 5 ≤ k) : (E24 k).length = 0 := by
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 5 := ⟨k - 5, by omega⟩
  rfl

