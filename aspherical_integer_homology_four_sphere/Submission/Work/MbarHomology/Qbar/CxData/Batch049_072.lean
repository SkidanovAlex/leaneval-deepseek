  E52_le k i

theorem c52_inj : ∀ k, Function.Injective (c52 k) := by
  intro k i j hij
  have h1 : (E52 k).get i = (E52 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E52_nodup k).get_inj_iff.mp h1

