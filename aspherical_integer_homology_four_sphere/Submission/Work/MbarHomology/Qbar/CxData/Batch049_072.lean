  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 52 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 52 0).get i' ∈ E52 0 := by
        rw [E52_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c52 0 i).1 = (⟨(E52 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 52 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 52 1).get i' ∈ E52 1 := by
