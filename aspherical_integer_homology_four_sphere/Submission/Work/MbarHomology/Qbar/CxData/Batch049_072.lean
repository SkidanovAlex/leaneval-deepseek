theorem Cx52_hbd' : ∀ (k : ℕ) (i : Fin (Cx52.dim k)) (j : Fin (Cx52.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c52 (k+1) j) 1)) (c52 k i) = (Cx52_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx52_bdEq k hk)]
    exact cellD_eq_bdOfEnum E52 c52 (fun k i => rfl) k i j
  · have h0 : (E52 k).length = 0 := E52_len_zero (by omega)
    have hlt : i.val < (E52 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

