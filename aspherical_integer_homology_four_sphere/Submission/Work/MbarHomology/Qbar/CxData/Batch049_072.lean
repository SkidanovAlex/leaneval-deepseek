      exact ⟨i, by rw [show (c52 1 i).1 = (⟨(E52 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 52 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 52 2).get i' ∈ E52 2 := by
        rw [E52_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c52 2 i).1 = (⟨(E52 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 52 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 52 3).get i' ∈ E52 3 := by
