    (dim := fun k => (E52 k).length) (bd := Cx52_bd) (N := 5)
    (fun k hk => E52_len_zero hk)
    (Work.Certificates.FinChainCx.bdCheck_of_pieces (N := 5) (fun k hk => by
      interval_cases k
      · exact Cx52_bdcomp0
      · exact Cx52_bdcomp1
      · exact Cx52_bdcomp2
      · exact Cx52_bdcomp3
