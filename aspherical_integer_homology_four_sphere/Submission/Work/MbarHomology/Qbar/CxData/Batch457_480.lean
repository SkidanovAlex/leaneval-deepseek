      have hmem : (dimListLe 480 3).get i' ∈ E480 3 := by
        rw [E480_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c480 3 i).1 = (⟨(E480 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 480 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 480 4).get i' ∈ E480 4 := by
        rw [E480_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c480 4 i).1 = (⟨(E480 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

