      have hmem : (dimListLe 480 0).get i' ∈ E480 0 := by
        rw [E480_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c480 0 i).1 = (⟨(E480 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 480 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 480 1).get i' ∈ E480 1 := by
