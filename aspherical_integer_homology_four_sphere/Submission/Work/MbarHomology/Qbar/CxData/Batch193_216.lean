  exact (E216_nodup k).get_inj_iff.mp h1

theorem c216_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(216 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c216 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 216 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 216 0).get i' ∈ E216 0 := by
        rw [E216_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c216 0 i).1 = (⟨(E216 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 216 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 216 1).get i' ∈ E216 1 := by
        rw [E216_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c216 1 i).1 = (⟨(E216 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 216 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 216 2).get i' ∈ E216 2 := by
        rw [E216_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c216 2 i).1 = (⟨(E216 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 216 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 216 3).get i' ∈ E216 3 := by
        rw [E216_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c216 3 i).1 = (⟨(E216 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 216 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 216 4).get i' ∈ E216 4 := by
        rw [E216_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c216 4 i).1 = (⟨(E216 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

