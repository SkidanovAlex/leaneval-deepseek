  | 2 => exact E120_hE2
  | 3 => exact E120_hE3
  | 4 => exact E120_hE4
  | k+5 => rw [E120_nil5, dimListLe_eq_nil 120 (k+5) (by omega)]

theorem E120_dim (k : ℕ) (i : Fin (E120 k).length) : QbarCW.dim (⟨(E120 k).get i⟩ : QbarCell) = k := by
  have hmem : (E120 k).get i ∈ dimListLe 120 k := by
    rw [← E120_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E120_le (k : ℕ) (i : Fin (E120 k).length) : (⟨(E120 k).get i⟩ : QbarCell) ≤ (⟨(120 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E120 k).get i ∈ dimListLe 120 k := by
    rw [← E120_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E120_nodup (k : ℕ) : (E120 k).Nodup := by
  rw [E120_hE k]
  exact dimListLe_nodup 120 k

def c120 : ∀ k, Fin (E120 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E120 k).get i⟩, E120_dim k i⟩

theorem c120_le (k : ℕ) (i : Fin (E120 k).length) : (c120 k i).1 ≤ (⟨(120 : Fin 865)⟩ : QbarCell) :=
  E120_le k i

theorem c120_inj : ∀ k, Function.Injective (c120 k) := by
  intro k i j hij
  have h1 : (E120 k).get i = (E120 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E120_nodup k).get_inj_iff.mp h1

theorem c120_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(120 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c120 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 120 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 120 0).get i' ∈ E120 0 := by
        rw [E120_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c120 0 i).1 = (⟨(E120 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 120 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 120 1).get i' ∈ E120 1 := by
        rw [E120_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c120 1 i).1 = (⟨(E120 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 120 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 120 2).get i' ∈ E120 2 := by
        rw [E120_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c120 2 i).1 = (⟨(E120 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 120 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 120 3).get i' ∈ E120 3 := by
        rw [E120_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c120 3 i).1 = (⟨(E120 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 120 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 120 4).get i' ∈ E120 4 := by
        rw [E120_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c120 4 i).1 = (⟨(E120 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

theorem E120_len_zero {k : ℕ} (hk : 5 ≤ k) : (E120 k).length = 0 := by
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 5 := ⟨k - 5, by omega⟩
  rfl

