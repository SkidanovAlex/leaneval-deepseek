theorem Cx120_hbd' : ∀ (k : ℕ) (i : Fin (Cx120.dim k)) (j : Fin (Cx120.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c120 (k+1) j) 1)) (c120 k i) = (Cx120_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx120_bdEq k hk)]
    exact cellD_eq_bdOfEnum E120 c120 (fun k i => rfl) k i j
  · have h0 : (E120 k).length = 0 := E120_len_zero (by omega)
    have hlt : i.val < (E120 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

