  | 0 => [648]
  | 1 => []
  | 2 => []
  | 3 => []
  | 4 => []
  | _ => []

theorem E648_len0 : (E648 0).length = 1 := rfl
theorem E648_len1 : (E648 1).length = 0 := rfl
theorem E648_len2 : (E648 2).length = 0 := rfl
theorem E648_len3 : (E648 3).length = 0 := rfl
theorem E648_len4 : (E648 4).length = 0 := rfl

theorem E648_nil5 (k : ℕ) : E648 (k+5) = [] := rfl

theorem E648_dimtop : QbarCW.dim (⟨(648 : Fin 865)⟩ : QbarCell) ≤ 0 := by decide +kernel

theorem E648_nil1 : E648 1 = [] := rfl
theorem E648_nil2 : E648 2 = [] := rfl
theorem E648_nil3 : E648 3 = [] := rfl
theorem E648_nil4 : E648 4 = [] := rfl

theorem E648_hE0 : E648 0 = dimListLe 648 0 := by decide +kernel
theorem E648_hE1 : E648 1 = dimListLe 648 1 := by
  rw [E648_nil1, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]
theorem E648_hE2 : E648 2 = dimListLe 648 2 := by
  rw [E648_nil2, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]
theorem E648_hE3 : E648 3 = dimListLe 648 3 := by
  rw [E648_nil3, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]
theorem E648_hE4 : E648 4 = dimListLe 648 4 := by
  rw [E648_nil4, dimListLe_eq_nil_of_dim_lt (by decide +kernel)]

theorem E648_hE (k : ℕ) : E648 k = dimListLe 648 k := by
  match k with
  | 0 => exact E648_hE0
  | 1 => exact E648_hE1
  | 2 => exact E648_hE2
  | 3 => exact E648_hE3
  | 4 => exact E648_hE4
  | k+5 => rw [E648_nil5, dimListLe_eq_nil 648 (k+5) (by omega)]

theorem E648_dim (k : ℕ) (i : Fin (E648 k).length) : QbarCW.dim (⟨(E648 k).get i⟩ : QbarCell) = k := by
  have hmem : (E648 k).get i ∈ dimListLe 648 k := by
    rw [← E648_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

theorem E648_le (k : ℕ) (i : Fin (E648 k).length) : (⟨(E648 k).get i⟩ : QbarCell) ≤ (⟨(648 : Fin 865)⟩ : QbarCell) := by
  have hmem : (E648 k).get i ∈ dimListLe 648 k := by
    rw [← E648_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).2

theorem E648_nodup (k : ℕ) : (E648 k).Nodup := by
  rw [E648_hE k]
  exact dimListLe_nodup 648 k

def c648 : ∀ k, Fin (E648 k).length → {f : QbarCell // QbarCW.dim f = k} :=
  fun k i => ⟨⟨(E648 k).get i⟩, E648_dim k i⟩

theorem c648_le (k : ℕ) (i : Fin (E648 k).length) : (c648 k i).1 ≤ (⟨(648 : Fin 865)⟩ : QbarCell) :=
  E648_le k i

theorem c648_inj : ∀ k, Function.Injective (c648 k) := by
  intro k i j hij
  have h1 : (E648 k).get i = (E648 k).get j :=
    congrArg (fun x : {f : QbarCell // QbarCW.dim f = k} => x.1.idx) hij
  exact (E648_nodup k).get_inj_iff.mp h1

theorem c648_surj (k : ℕ) (f : QbarCell) (hf : f ≤ (⟨(648 : Fin 865)⟩ : QbarCell)) (hd : QbarCW.dim f = k) : ∃ i, (c648 k i).1 = f := by
  match k with
  | 0 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 648 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 648 0).get i' ∈ E648 0 := by
        rw [E648_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c648 0 i).1 = (⟨(E648 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 648 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 648 1).get i' ∈ E648 1 := by
        rw [E648_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c648 1 i).1 = (⟨(E648 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 648 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 648 2).get i' ∈ E648 2 := by
        rw [E648_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c648 2 i).1 = (⟨(E648 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 648 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 648 3).get i' ∈ E648 3 := by
        rw [E648_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c648 3 i).1 = (⟨(E648 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 648 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 648 4).get i' ∈ E648 4 := by
        rw [E648_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c648 4 i).1 = (⟨(E648 4).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | k+5 =>
      have h1 : QbarCW.dim f ≤ 4 := by rw [QbarCW_dim]; omega
      omega

theorem E648_len_zero {k : ℕ} (hk : 5 ≤ k) : (E648 k).length = 0 := by
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 5 := ⟨k - 5, by omega⟩
  rfl

def Cx648_bdLit0 : Work.Certificates.SOp (E648 0).length ((E648 1).length) :=
  Work.Certificates.SOp.zero _ _
def Cx648_bdLit1 : Work.Certificates.SOp (E648 1).length ((E648 2).length) :=
  Work.Certificates.SOp.zero _ _
def Cx648_bdLit2 : Work.Certificates.SOp (E648 2).length ((E648 3).length) :=
  Work.Certificates.SOp.zero _ _
def Cx648_bdLit3 : Work.Certificates.SOp (E648 3).length ((E648 4).length) :=
  Work.Certificates.SOp.zero _ _

def Cx648_bd : ∀ k, Work.Certificates.SOp ((E648 k).length) ((E648 (k+1)).length)
  | 0 => Cx648_bdLit0
  | 1 => Cx648_bdLit1
  | 2 => Cx648_bdLit2
  | 3 => Cx648_bdLit3
  | _ => Work.Certificates.SOp.zero _ _

theorem Cx648_bdEq0 : (Cx648_bd 0).eqb (bdOfEnum E648 0) = true := by decide +kernel
theorem Cx648_bdEq1 : (Cx648_bd 1).eqb (bdOfEnum E648 1) = true := by decide +kernel
theorem Cx648_bdEq2 : (Cx648_bd 2).eqb (bdOfEnum E648 2) = true := by decide +kernel
theorem Cx648_bdEq3 : (Cx648_bd 3).eqb (bdOfEnum E648 3) = true := by decide +kernel
theorem Cx648_bdEq4 : (Cx648_bd 4).eqb (bdOfEnum E648 4) = true := by decide +kernel

theorem Cx648_bdEq (k : ℕ) (hk : k < 5) : (Cx648_bd k).eqb (bdOfEnum E648 k) = true := by
  interval_cases k
  · exact Cx648_bdEq0
  · exact Cx648_bdEq1
  · exact Cx648_bdEq2
  · exact Cx648_bdEq3
  · exact Cx648_bdEq4

theorem Cx648_bdcomp0 : Work.Certificates.FinChainCx.bdCheckDeg (fun k => (E648 k).length) Cx648_bd 0 = true := by decide +kernel
theorem Cx648_bdcomp1 : Work.Certificates.FinChainCx.bdCheckDeg (fun k => (E648 k).length) Cx648_bd 1 = true := by decide +kernel
theorem Cx648_bdcomp2 : Work.Certificates.FinChainCx.bdCheckDeg (fun k => (E648 k).length) Cx648_bd 2 = true := by decide +kernel
theorem Cx648_bdcomp3 : Work.Certificates.FinChainCx.bdCheckDeg (fun k => (E648 k).length) Cx648_bd 3 = true := by decide +kernel
theorem Cx648_bdcomp4 : Work.Certificates.FinChainCx.bdCheckDeg (fun k => (E648 k).length) Cx648_bd 4 = true := by decide +kernel

def Cx648 : Work.Certificates.FinChainCx where
  dim := fun k => (E648 k).length
  bd := Cx648_bd
  bd_comp := Work.Certificates.FinChainCx.bdCheck_sound
    (dim := fun k => (E648 k).length) (bd := Cx648_bd) (N := 5)
    (fun k hk => E648_len_zero hk)
    (Work.Certificates.FinChainCx.bdCheck_of_pieces (N := 5) (fun k hk => by
      interval_cases k
      · exact Cx648_bdcomp0
      · exact Cx648_bdcomp1
      · exact Cx648_bdcomp2
      · exact Cx648_bdcomp3
      · exact Cx648_bdcomp4
      ))

theorem Cx648_hbd' : ∀ (k : ℕ) (i : Fin (Cx648.dim k)) (j : Fin (Cx648.dim (k+1))), (QbarCW.cellD k (Finsupp.single (c648 (k+1) j) 1)) (c648 k i) = (Cx648_bd k).toMatrix i j := by
  intro k i j
  by_cases hk : k < 5
  · rw [Work.Certificates.SOp.eqb_sound (Cx648_bdEq k hk)]
    exact cellD_eq_bdOfEnum E648 c648 (fun k i => rfl) k i j
  · have h0 : (E648 k).length = 0 := E648_len_zero (by omega)
    have hlt : i.val < (E648 k).length := i.isLt
    rw [h0] at hlt
    exact absurd hlt (Nat.not_lt_zero i.val)

def Cx648_Z : ∀ k, Work.Certificates.SOp ((E648 k).length) (bModel k)
  | 0 => (sopOfNat 1 1 [[(0, 1)]] : Work.Certificates.SOp (E648 0).length (bModel 0))
  | _ => Work.Certificates.SOp.zero _ _

def Cx648_rho : ∀ k, Work.Certificates.SOp (bModel k) ((E648 k).length)
  | 0 => (coefSumSOp 1 : Work.Certificates.SOp (bModel 0) ((E648 0).length))
  | _ => Work.Certificates.SOp.zero _ _

def Cx648_h : ∀ k, Work.Certificates.SOp ((E648 (k+1)).length) ((E648 k).length)
  | 0 => Work.Certificates.SOp.zero _ _
  | 1 => Work.Certificates.SOp.zero _ _
  | 2 => Work.Certificates.SOp.zero _ _
  | 3 => Work.Certificates.SOp.zero _ _
  | 4 => Work.Certificates.SOp.zero _ _
  | _ => Work.Certificates.SOp.zero _ _

def Cx648_sdr : Work.Certificates.SDR Cx648 where
  N := 5
  b := bModel
  Z := Cx648_Z
  ρ := Cx648_rho
  h := Cx648_h
  dim_zero := fun k hk => E648_len_zero hk
  b_zero := fun k hk => by simp [bModel]; omega

theorem Cx648_checkHomZero : Cx648_sdr.checkHomZero = true := by decide +kernel
theorem Cx648_checkDeg0 : Cx648_sdr.checkDeg 0 = true := by decide +kernel
theorem Cx648_checkDeg1 : Cx648_sdr.checkDeg 1 = true := by decide +kernel
theorem Cx648_checkDeg2 : Cx648_sdr.checkDeg 2 = true := by decide +kernel
theorem Cx648_checkDeg3 : Cx648_sdr.checkDeg 3 = true := by decide +kernel
theorem Cx648_checkDeg4 : Cx648_sdr.checkDeg 4 = true := by decide +kernel

theorem Cx648_sdr_check : Cx648_sdr.check = true := by
  rw [Work.Certificates.SDR.check_eq, Cx648_checkHomZero, Bool.true_and, List.all_eq_true]
  intro k hk
  have hk5 : k < 5 := List.mem_range.mp hk
  interval_cases k
  · exact Cx648_checkDeg0
  · exact Cx648_checkDeg1
  · exact Cx648_checkDeg2
  · exact Cx648_checkDeg3
  · exact Cx648_checkDeg4

theorem Cx648_homology (k : ℕ) : Nonempty ((Cx648).homology k ≅ ModuleCat.of ℤ (Fin (bModel k) → ℤ)) :=
  Work.Certificates.SDR.sound Cx648_sdr Cx648_sdr_check k

theorem Cx648_acyclic (hdd : QbarCW.HasDdZero) (k : ℕ) :
    Nonempty ((cellLe QbarCW hdd (⟨(648 : Fin 865)⟩ : QbarCell)).homology k ≅ cellHomModel k) :=
  cellAcyclic_of_sdr hdd
    (Work.MbarHomology.Qbar.cellLe_iso_finChainCx QbarCW hdd (⟨(648 : Fin 865)⟩ : QbarCell) Cx648
      c648 (c648_le) (c648_inj) (c648_surj) (Cx648_hbd'))
    (Cx648_homology) k


