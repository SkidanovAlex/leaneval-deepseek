  | 4 => exact E192_hE4
  | k+5 => rw [E192_nil5, dimListLe_eq_nil 192 (k+5) (by omega)]

theorem E192_dim (k : ℕ) (i : Fin (E192 k).length) : QbarCW.dim (⟨(E192 k).get i⟩ : QbarCell) = k := by
  have hmem : (E192 k).get i ∈ dimListLe 192 k := by
    rw [← E192_hE k]; exact List.get_mem _ i
  exact (mem_dimListLe.1 hmem).1

