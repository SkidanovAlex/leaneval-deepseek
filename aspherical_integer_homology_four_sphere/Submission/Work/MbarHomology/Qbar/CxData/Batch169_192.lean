      have hmem : (dimListLe 192 3).get i' ∈ E192 3 := by
        rw [E192_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c192 3 i).1 = (⟨(E192 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 192 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 192 4).get i' ∈ E192 4 := by
