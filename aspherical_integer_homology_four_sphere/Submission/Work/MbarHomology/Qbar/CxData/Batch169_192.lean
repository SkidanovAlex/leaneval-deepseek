      have hmem : (dimListLe 192 0).get i' ∈ E192 0 := by
        rw [E192_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c192 0 i).1 = (⟨(E192 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 192 1 ⟨f, hf, hd⟩
