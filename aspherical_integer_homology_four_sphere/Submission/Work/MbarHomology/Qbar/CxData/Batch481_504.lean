  b := bModel
  Z := Cx504_Z
  ρ := Cx504_rho
  h := Cx504_h
  dim_zero := fun k hk => E504_len_zero hk
  b_zero := fun k hk => by simp [bModel]; omega

theorem Cx504_checkHomZero : Cx504_sdr.checkHomZero = true := by decide +kernel
theorem Cx504_checkDeg0 : Cx504_sdr.checkDeg 0 = true := by decide +kernel
theorem Cx504_checkDeg1 : Cx504_sdr.checkDeg 1 = true := by decide +kernel
theorem Cx504_checkDeg2 : Cx504_sdr.checkDeg 2 = true := by decide +kernel
theorem Cx504_checkDeg3 : Cx504_sdr.checkDeg 3 = true := by decide +kernel
theorem Cx504_checkDeg4 : Cx504_sdr.checkDeg 4 = true := by decide +kernel

theorem Cx504_sdr_check : Cx504_sdr.check = true := by
  rw [Work.Certificates.SDR.check_eq, Cx504_checkHomZero, Bool.true_and, List.all_eq_true]
  intro k hk
  have hk5 : k < 5 := List.mem_range.mp hk
  interval_cases k
  · exact Cx504_checkDeg0
  · exact Cx504_checkDeg1
  · exact Cx504_checkDeg2
  · exact Cx504_checkDeg3
  · exact Cx504_checkDeg4

theorem Cx504_homology (k : ℕ) : Nonempty ((Cx504).homology k ≅ ModuleCat.of ℤ (Fin (bModel k) → ℤ)) :=
  Work.Certificates.SDR.sound Cx504_sdr Cx504_sdr_check k

theorem Cx504_acyclic (hdd : QbarCW.HasDdZero) (k : ℕ) :
    Nonempty ((cellLe QbarCW hdd (⟨(504 : Fin 865)⟩ : QbarCell)).homology k ≅ cellHomModel k) :=
  cellAcyclic_of_sdr hdd
    (Work.MbarHomology.Qbar.cellLe_iso_finChainCx QbarCW hdd (⟨(504 : Fin 865)⟩ : QbarCell) Cx504
      c504 (c504_le) (c504_inj) (c504_surj) (Cx504_hbd'))
    (Cx504_homology) k


