      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c264 3 i).1 = (⟨(E264 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
