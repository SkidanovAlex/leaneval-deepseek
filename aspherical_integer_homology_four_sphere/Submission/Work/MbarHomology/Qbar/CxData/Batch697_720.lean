      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 720 0 ⟨f, hf, hd⟩
      have hmem : (dimListLe 720 0).get i' ∈ E720 0 := by
        rw [E720_hE0]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c720 0 i).1 = (⟨(E720 0).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 1 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 720 1 ⟨f, hf, hd⟩
      have hmem : (dimListLe 720 1).get i' ∈ E720 1 := by
        rw [E720_hE1]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c720 1 i).1 = (⟨(E720 1).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 2 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 720 2 ⟨f, hf, hd⟩
      have hmem : (dimListLe 720 2).get i' ∈ E720 2 := by
        rw [E720_hE2]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c720 2 i).1 = (⟨(E720 2).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 3 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 720 3 ⟨f, hf, hd⟩
      have hmem : (dimListLe 720 3).get i' ∈ E720 3 := by
        rw [E720_hE3]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
      exact ⟨i, by rw [show (c720 3 i).1 = (⟨(E720 3).get i⟩ : QbarCell) from rfl, hi]; exact congrArg Subtype.val hi'⟩
  | 4 =>
      obtain ⟨i', hi'⟩ := Work.MbarHomology.Qbar.cellOf_surjective 720 4 ⟨f, hf, hd⟩
      have hmem : (dimListLe 720 4).get i' ∈ E720 4 := by
        rw [E720_hE4]; exact List.get_mem _ i'
      obtain ⟨i, hi⟩ := List.mem_iff_get.mp hmem
