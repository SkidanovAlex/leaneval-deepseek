import Mathlib
import Submission.Work.MbarHomology.Mbar.Flags
import Submission.Work.MbarHomology.Qbar.Basic
import Submission.Work.MbarHomology.ConvexCells.sd_carrier_of_basic

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


/-!
# `Ksub` at the barycentre of a face of a flag

The identification subgroup `Ksub y` of the Klein group `Gg` is generated by the types of the sides
*tight* at `y` (`Submission/Work/FoldInst/Basic.lean`).  At the barycentre of a flag `s`
(a strictly increasing tuple of faces of the truncated 24-cell `Q̄`) the tight set is the tight set
of the *top* (largest) face of the flag: `QbarPD.tightAt (bary s) = QbarPD.tight (topIdx s)`.

Dropping the `i`-th vertex of a flag replaces the top face by one of its faces, and the new top face
is contained in the old one whenever `i` is the index of the top vertex.  Hence the tight set at the
barycentre only grows and `Ksub (bary s) ≤ Ksub (bary (face i s))`.

This is the input the well-definedness of the face maps of the `Δ`-complex `mbarSd` needs
(`Work.MbarHomology.Mbar.flagRel_face`).

The development is self-contained: the flag-point machinery of `Work.ConvexCells` specialized to
`QbarPD` (the `OkBasic`-flavoured lemmas of `Work.MbarHomology.ConvexCells.sd_carrier_of_basic`) is
reproduced here in the `Simplex`-indexed form needed, so that this file does not depend on the
`flagRel_face` area.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000
set_option autoImplicit false

namespace Work.MbarHomology.Mbar

open Work.Subdivision Work.ConvexCells
open scoped BigOperators

noncomputable section

/-! ## 1. The affine realization of a flag and its tight set -/

/-- The affine point `∑ wᵢ · posR(Fᵢ)` of the open simplex of the flag `s` with weights `w`. -/
private def ptW {k : ℕ} (s : Simplex QbarCW.Cell k) (w : Fin (k + 1) → ℝ) : E 4 :=
  ∑ i, w i • QbarPD.posR (s i).idx

/-- `ptW` at the uniform weights is the barycentre `bary` of the flag. -/
private theorem ptW_uniform {k : ℕ} (s : Simplex QbarCW.Cell k) :
    ptW s (fun _ => ((k + 1 : ℝ))⁻¹) = bary s := rfl

/-- The uniform weights on `Fin (k+1)` sum to one. -/
private theorem uniform_sum (k : ℕ) :
    (∑ _i : Fin (k + 1), ((k + 1 : ℝ))⁻¹) = 1 := by
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
    show (((k + 1 : ℕ) : ℝ)) = ((k : ℝ) + 1) by push_cast; ring]
  exact mul_inv_cancel₀ (by positivity)

/-- The affine point of a flag with nonnegative weights summing to one lies in `Q̄`. -/
private theorem ptW_mem {k : ℕ} (s : Simplex QbarCW.Cell k) {w : Fin (k + 1) → ℝ}
    (hw : ∀ i, 0 ≤ w i) (hsum : ∑ i, w i = 1) : ptW s w ∈ Work.FoldInst.Qbar := by
  rw [← QbarPD_Pset]
  show ∑ i, w i • QbarPD.posR (s i).idx ∈ QbarPD.Pset
  exact QbarPD.Pset_convex.sum_mem (t := Finset.univ) (fun i _ => by simpa using hw i)
    (by simpa using hsum)
    (fun i _ => posR_mem_Pset_basic QbarPD_okBasic (s i).idx)

/-- The barycentre of a flag lies in `Q̄`. -/
private theorem bary_mem {k : ℕ} (s : Simplex QbarCW.Cell k) : bary s ∈ Work.FoldInst.Qbar := by
  rw [← ptW_uniform s]
  exact ptW_mem s (fun _ => by positivity) (uniform_sum k)

/-- The top (largest) face of a flag, as an index of `Fin 865`. -/
private def topIdx {k : ℕ} (s : Simplex QbarCW.Cell k) : Fin 865 := (s (Fin.last k)).idx

/-- A constraint is tight at every face of a flag iff it is tight at its top face. -/
private theorem mem_tight_iff_top {k : ℕ} (s : Simplex QbarCW.Cell k) (c : Fin 48) :
    (∀ i, c ∈ QbarPD.tight (s i).idx) ↔ c ∈ QbarPD.tight (topIdx s) := by
  refine ⟨fun h => h (Fin.last k), fun h i => ?_⟩
  have hle : s i ≤ s (Fin.last k) := by
    rcases lt_or_eq_of_le (Fin.le_last i) with hlt | heq
    · exact le_of_lt (s.strictMono hlt)
    · rw [heq]
  exact hle h

/-- The tight set of the affine point of a flag with strictly positive weights is the tight set of
the top face of the flag. -/
private theorem ptW_tightAt {k : ℕ} (s : Simplex QbarCW.Cell k) {w : Fin (k + 1) → ℝ}
    (hw : ∀ i, 0 < w i) (hsum : ∑ i, w i = 1) :
    QbarPD.tightAt (ptW s w) = QbarPD.tight (topIdx s) := by
  have hcombo := PolytopeData.tightAt_combo (P := QbarPD) (s := Finset.univ) (w := w)
    (z := fun i => QbarPD.posR (s i).idx)
    (fun i _ => le_of_lt (hw i)) (by simpa using hsum)
    (fun i _ => posR_mem_Pset_basic QbarPD_okBasic (s i).idx)
  ext c
  have hiff : (∀ i, inner ℝ (QbarPD.nR c) (QbarPD.posR (s i).idx) = QbarPD.bR c)
      ↔ c ∈ QbarPD.tight (topIdx s) :=
    Iff.trans (forall_congr' fun i => inner_posR_eq_iff_basic QbarPD_okBasic (s i).idx c)
      (mem_tight_iff_top s c)
  simp only [ptW]
  rw [hcombo c]
  simp only [Finset.mem_univ, true_implies]
  exact Iff.trans ⟨fun h i => h i (ne_of_gt (hw i)), fun h i _ => h i⟩ hiff

/-- The tight set of the barycentre of a flag is the tight set of its top face. -/
private theorem bary_tightAt {k : ℕ} (s : Simplex QbarCW.Cell k) :
    QbarPD.tightAt (bary s) = QbarPD.tight (topIdx s) := by
  rw [← ptW_uniform s]
  exact ptW_tightAt s (fun _ => by positivity) (uniform_sum k)

/-! ## 2. `Ksub` against the tight sets of the sides -/

/-- The subgroup of `Gg` generated by the side constraints belonging to `T`. -/
private def KsubF (T : Finset (Fin 48)) : AddSubgroup Work.FoldInst.Gg :=
  AddSubgroup.closure {γ : Work.FoldInst.Gg |
    ∃ S : Fin 24, Fin.castAdd 24 S ∈ T ∧ γ = Work.FoldInst.sideType S}

/-- `KsubF` is monotone in the tight set. -/
private theorem KsubF_mono {T T' : Finset (Fin 48)} (h : T ⊆ T') : KsubF T ≤ KsubF T' :=
  AddSubgroup.closure_mono fun _ ⟨S, hS, hg⟩ => ⟨S, h hS, hg⟩

/-- A side constraint is an equality at `y ∈ Q̄` iff it is a tight constraint there. -/
private theorem sideSlack_eq_zero_iff_tightAt {y : E 4} (hy : y ∈ Work.FoldInst.Qbar)
    (S : Fin 24) :
    Fin.castAdd 24 S ∈ QbarPD.tightAt y ↔ Work.FoldInst.sideSlack S y = 0 := by
  have hy' : y ∈ QbarPD.Pset := QbarPD_Pset ▸ hy
  refine (PolytopeData.tightAt_of_mem (P := QbarPD) hy' (Fin.castAdd 24 S)).trans ?_
  have hnR : QbarPD.nR (Fin.castAdd 24 S)
      = ((1920 : ℝ))⁻¹ • Work.ConvexCells.toE (Work.FoldInst.sideNormal S) := by
    simp only [PolytopeData.nR, QbarPD_nrm, QbarPD_D, qNrm_castAdd, Nat.cast_ofNat]
  have hbR : QbarPD.bR (Fin.castAdd 24 S) = ((1920 : ℝ))⁻¹ := by
    simp only [PolytopeData.bR, QbarPD_rhs, QbarPD_D, qRhs_castAdd, Int.cast_one]
    norm_num
  rw [hnR, hbR, inner_smul_left, Work.ConvexCells.inner_toE_right]
  simp only [RCLike.conj_to_real]
  constructor
  · intro h
    have hX : (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * y j) = 1 := by
      have h' : ((1920 : ℝ))⁻¹ * (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * y j)
          = ((1920 : ℝ))⁻¹ * 1 := by rw [mul_one]; exact h
      exact mul_left_cancel₀ (by norm_num) h'
    rw [Work.FoldInst.sideSlack, hX, sub_self]
  · intro h
    have hX : (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * y j) = 1 := by
      have h1 : (1 : ℝ) = ∑ j, (Work.FoldInst.sideNormal S j : ℝ) * y j := by
        rw [Work.FoldInst.sideSlack, sub_eq_zero] at h
        exact h
      exact h1.symm
    rw [hX, mul_one]

/-- The identification subgroup `Ksub y` at a point of `Q̄` is generated by the side constraints
tight there. -/
private theorem Ksub_eq_KsubF {y : E 4} (hy : y ∈ Work.FoldInst.Qbar) :
    Work.FoldInst.Ksub y = KsubF (QbarPD.tightAt y) := by
  unfold Work.FoldInst.Ksub KsubF
  congr 1
  ext γ
  constructor
  · rintro ⟨S, hS, rfl⟩
    exact ⟨S, (sideSlack_eq_zero_iff_tightAt hy S).mpr hS, rfl⟩
  · rintro ⟨S, hS, rfl⟩
    exact ⟨S, (sideSlack_eq_zero_iff_tightAt hy S).mp hS, rfl⟩

/-! ## 3. The top face only grows when a vertex is dropped -/

/-- Dropping a vertex of a flag replaces its top face by one of its faces, so the tight set of the
top face only grows. -/
private theorem tight_topIdx_face_subset {k : ℕ} (i : Fin (k + 2))
    (s : Simplex QbarCW.Cell (k + 1)) :
    QbarPD.tight (topIdx s) ⊆ QbarPD.tight (topIdx (Simplex.face i s)) := by
  show qTight (s (Fin.last (k + 1))).idx ⊆ qTight ((Simplex.face i s) (Fin.last k)).idx
  rw [Simplex.face_apply]
  exact s.strictMono.monotone (Fin.le_last _)

theorem Ksub_bary_face {k : ℕ} (i : Fin (k + 2))
    (s : Work.Subdivision.Simplex Work.MbarHomology.QbarCW.Cell (k + 1)) :
    Work.FoldInst.Ksub (Work.MbarHomology.bary s) ≤
      Work.FoldInst.Ksub (Work.MbarHomology.bary (Work.Subdivision.Simplex.face i s)) := by
  rw [Ksub_eq_KsubF (bary_mem s), Ksub_eq_KsubF (bary_mem (Simplex.face i s)),
    bary_tightAt s, bary_tightAt (Simplex.face i s)]
  exact KsubF_mono (tight_topIdx_face_subset i s)

end

end Work.MbarHomology.Mbar
