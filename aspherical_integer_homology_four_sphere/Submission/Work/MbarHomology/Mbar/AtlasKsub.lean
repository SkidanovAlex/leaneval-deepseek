/-
# The identification subgroup and the cocycle of the cell atlas of `M̄`

**Work package W7** of `Submission/Work/NOTES_LEAD_eA.md`.

`KsubAtlas F` is the subgroup of the Klein group `Gg` generated by the types of the sides that are
*tight* at the face `F` of `Q̄`; it is the identification group at the barycentre of any flag whose
top face is `F` (`Ksub_bary_eq_KsubAtlas`), and it is invariant under the sign-change action
(`KsubAtlas_faceAct`).  Since `Gg` has exponent two, `γ ∈ KsubAtlas F` is equivalent to `γ` being a sum of
types of tight sides (`mem_KsubAtlas_iff`).

The cocycle identity `Enode (γ · x) = Enode x + γ` for `γ ∈ KsubAtlas x.2` -- the form in which the
orbit tables enter -- is checked on the subset sums (`cocycle_filter`) and then transported to all
of `KsubAtlas` (`Enode_cocycle`).
-/
import Mathlib
import Submission.Work.MbarHomology.Mbar.AtlasFacetData

-- Lean v4.35.0-rc3 / Mathlib 5e0c4e5 made `isDefEq` respect transparency when unifying instances; with it,
-- `ZMod.instField` and `ZMod.commRing` (and `Neg (ZMod p)` via `SubtractionMonoid`) no longer unify, which
-- breaks `ring`/`rw`/module-instance search on `ZMod p`. Restore the v4.34 behaviour for this file.
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.instanceSearchTypes false
set_option backward.isDefEq.respectTransparency.types false


set_option maxRecDepth 100000
set_option maxHeartbeats 8000000
set_option autoImplicit false

namespace Work.MbarHomology.Mbar

open Work.Subdivision Work.ConvexCells
open scoped BigOperators

noncomputable section

/-! ## 1. Subset sums in a group of exponent two -/

theorem zmod2_add_self' (a : ZMod 2) : a + a = 0 := by revert a; decide

/-- Every element of the Klein group satisfies `γ + γ = 0`. -/
theorem gg_add_self (γ : Work.FoldInst.Gg) : γ + γ = 0 := by
  refine Prod.ext ?_ ?_
  · funext i; exact zmod2_add_self' (γ.1 i)
  · exact zmod2_add_self' γ.2

/-- **Subset sums**: in a group of exponent two, the closure of a finite set is the set of sums over
its subsets. -/
theorem mem_closure_image_iff {α : Type*} [DecidableEq α] (T : Finset α) (f : α → Work.FoldInst.Gg)
    (γ : Work.FoldInst.Gg) :
    γ ∈ AddSubgroup.closure (f '' (↑T : Set α)) ↔ ∃ A ∈ T.powerset, ∑ a ∈ A, f a = γ := by
  constructor
  · intro h
    let H : AddSubgroup Work.FoldInst.Gg :=
      { carrier := {γ | ∃ A ∈ T.powerset, ∑ a ∈ A, f a = γ}
        zero_mem' := ⟨∅, by simp, by simp⟩
        add_mem' := by
          rintro a b ⟨A, hA, rfl⟩ ⟨B, hB, rfl⟩
          rw [Finset.mem_powerset] at hA hB
          refine ⟨(A \ B) ∪ (B \ A), ?_, ?_⟩
          · rw [Finset.mem_powerset]
            intro x hx
            rcases Finset.mem_union.mp hx with h | h
            · exact hA (Finset.mem_sdiff.mp h).1
            · exact hB (Finset.mem_sdiff.mp h).1
          · rw [Finset.sum_union (by
              rw [Finset.disjoint_left]
              intro x hx1 hx2
              exact (Finset.mem_sdiff.mp hx1).2 (Finset.mem_sdiff.mp hx2).1)]
            have f1 : ∑ a ∈ A \ B, f a + ∑ a ∈ A ∩ B, f a = ∑ a ∈ A, f a := by
              rw [← Finset.sum_union (Finset.disjoint_sdiff_inter A B), Finset.sdiff_union_inter]
            have f2 : ∑ a ∈ B \ A, f a + ∑ a ∈ A ∩ B, f a = ∑ a ∈ B, f a := by
              rw [← Finset.sum_union (by
                rw [Finset.disjoint_left]
                intro x hx1 hx2
                exact (Finset.mem_sdiff.mp hx1).2 (Finset.mem_inter.mp hx2).1)]
              rw [Finset.inter_comm, Finset.sdiff_union_inter]
            have f3 : ∑ a ∈ A ∩ B, f a + ∑ a ∈ A ∩ B, f a = 0 := by
              rw [← Finset.sum_add_distrib]
              exact Finset.sum_eq_zero fun x _ => gg_add_self (f x)
            have h1 : ∑ a ∈ A \ B, f a = ∑ a ∈ A, f a + ∑ a ∈ A ∩ B, f a := by
              have h := congrArg (fun t => t + ∑ a ∈ A ∩ B, f a) f1
              rw [_root_.add_assoc, f3, _root_.add_zero] at h
              exact h
            have h2 : ∑ a ∈ B \ A, f a = ∑ a ∈ B, f a + ∑ a ∈ A ∩ B, f a := by
              have h := congrArg (fun t => t + ∑ a ∈ A ∩ B, f a) f2
              rw [_root_.add_assoc, f3, _root_.add_zero] at h
              exact h
            rw [h1, h2]
            rw [show (∑ a ∈ A, f a + ∑ a ∈ A ∩ B, f a) + (∑ a ∈ B, f a + ∑ a ∈ A ∩ B, f a)
                  = ∑ a ∈ A, f a + ∑ a ∈ B, f a + (∑ a ∈ A ∩ B, f a + ∑ a ∈ A ∩ B, f a) by
                abel]
            rw [f3, _root_.add_zero]
        neg_mem' := by
          rintro a ⟨A, hA, rfl⟩
          refine ⟨A, hA, ?_⟩
          rw [← Finset.sum_neg_distrib]
          exact Finset.sum_congr rfl fun x _ =>
            (neg_eq_of_add_eq_zero_left (gg_add_self (f x))).symm }
    have hsub : (f '' (↑T : Set α)) ⊆ (H : Set Work.FoldInst.Gg) := by
      rintro a ⟨x, hx, rfl⟩
      refine ⟨{x}, ?_, by simp⟩
      rw [Finset.mem_powerset]
      exact Finset.singleton_subset_iff.mpr (by simpa using hx)
    exact (AddSubgroup.closure_le H).mpr hsub h
  · rintro ⟨A, hA, rfl⟩
    rw [Finset.mem_powerset] at hA
    exact AddSubgroup.sum_mem _ fun a ha => AddSubgroup.subset_closure ⟨a, hA ha, rfl⟩

/-! ## 2. The identification subgroup of a face -/

/-- The sides tight at a face of `Q̄`. -/
def tightSidesIdx (F : Fin 865) : Finset (Fin 24) :=
  (Finset.univ : Finset (Fin 24)).filter (fun S => Fin.castAdd 24 S ∈ qTight F)

/-- The sum of the types of a set of sides, as an element of `Gg`. -/
def sideTypeSum (A : Finset (Fin 24)) : Work.FoldInst.Gg := ∑ S ∈ A, Work.FoldInst.sideType S

/-- The subgroup of `Gg` generated by the types of the sides tight at a face. -/
def KsubAtlas (F : Fin 865) : AddSubgroup Work.FoldInst.Gg :=
  AddSubgroup.closure (Work.FoldInst.sideType '' (tightSidesIdx F : Set (Fin 24)))

theorem mem_KsubAtlas_iff (F : Fin 865) (γ : Work.FoldInst.Gg) :
    γ ∈ KsubAtlas F ↔ ∃ A ∈ (tightSidesIdx F).powerset, sideTypeSum A = γ :=
  mem_closure_image_iff (tightSidesIdx F) Work.FoldInst.sideType γ

/-! ## 3. `KsubAtlas` at the barycentre of a flag -/

theorem mem_tightSidesIdx (F : Fin 865) (S : Fin 24) :
    S ∈ tightSidesIdx F ↔ Fin.castAdd 24 S ∈ qTight F := by
  simp [tightSidesIdx]

/-- The slack of a side at the barycentre of a flag is the average of its values on the faces. -/
theorem sideSlack_bary (S : Fin 24) {k : ℕ} (s : Simplex QbarCW.Cell k) :
    Work.FoldInst.sideSlack S (bary s)
      = ∑ i : Fin (k + 1),
          ((k + 1 : ℝ))⁻¹ * Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx) := by
  have hnR : QbarPD.nR (Fin.castAdd 24 S)
      = ((1920 : ℝ))⁻¹ • Work.ConvexCells.toE (Work.FoldInst.sideNormal S) := by
    simp only [PolytopeData.nR, QbarPD_nrm, QbarPD_D, qNrm_castAdd, Nat.cast_ofNat]
  have hval : ∀ y : E 4, inner ℝ (QbarPD.nR (Fin.castAdd 24 S)) y
      = ((1920 : ℝ))⁻¹ * (1 - Work.FoldInst.sideSlack S y) := by
    intro y
    rw [hnR, inner_smul_left, Work.ConvexCells.inner_toE_right]
    simp only [RCLike.conj_to_real]
    rw [Work.FoldInst.sideSlack]
    ring
  have hsum : ∑ _i : Fin (k + 1), ((k + 1 : ℝ))⁻¹ = 1 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    exact mul_inv_cancel₀ (by positivity)
  have hlin := PolytopeData.inner_sum_smul (P := QbarPD) (s := Finset.univ)
    (w := fun _ : Fin (k + 1) => ((k + 1 : ℝ))⁻¹)
    (z := fun i : Fin (k + 1) => QbarPD.posR (s i).idx) (Fin.castAdd 24 S)
  have hbary : (∑ i ∈ (Finset.univ : Finset (Fin (k+1))),
      ((k + 1 : ℝ))⁻¹ • QbarPD.posR (s i).idx) = bary s := rfl
  rw [hbary] at hlin
  rw [hval (bary s), Finset.sum_congr rfl (fun i _ => by rw [hval (QbarPD.posR (s i).idx)])] at hlin
  have hcancel : ((1920 : ℝ))⁻¹ * (1 - Work.FoldInst.sideSlack S (bary s))
      = ((1920 : ℝ))⁻¹
        * ∑ i, ((k + 1 : ℝ))⁻¹ * (1 - Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx)) := by
    rw [hlin, Finset.mul_sum]
    exact Finset.sum_congr rfl fun i _ => by ring
  have h2 := mul_left_cancel₀ (show ((1920 : ℝ))⁻¹ ≠ 0 by norm_num) hcancel
  have h3 : (∑ i, ((k + 1 : ℝ))⁻¹
        * (1 - Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx)))
      = 1 - ∑ i, ((k + 1 : ℝ))⁻¹ * Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx) := by
    have hpt : ∀ i : Fin (k + 1), ((k + 1 : ℝ))⁻¹
          * (1 - Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx))
        = ((k + 1 : ℝ))⁻¹
          - ((k + 1 : ℝ))⁻¹ * Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx) :=
      fun i => by ring
    rw [Finset.sum_congr rfl fun i _ => hpt i, Finset.sum_sub_distrib, hsum]
  rw [h3] at h2
  linarith

/-- A side is tight at the `pos` point of a face iff it is tight at the face. -/
theorem sideSlack_posR_eq_zero_iff (S : Fin 24) (f : Fin 865) :
    Work.FoldInst.sideSlack S (QbarPD.posR f) = 0 ↔ Fin.castAdd 24 S ∈ qTight f := by
  have hinner : inner ℝ (QbarPD.nR (Fin.castAdd 24 S)) (QbarPD.posR f)
      = ((1920 : ℝ))⁻¹
        * (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * (QbarPD.posR f) j) := by
    rw [show QbarPD.nR (Fin.castAdd 24 S)
        = ((1920 : ℝ))⁻¹ • Work.ConvexCells.toE (Work.FoldInst.sideNormal S) from by
      simp only [PolytopeData.nR, QbarPD_nrm, QbarPD_D, qNrm_castAdd, Nat.cast_ofNat],
      inner_smul_left, Work.ConvexCells.inner_toE_right]
    simp only [RCLike.conj_to_real]
  have hbR : QbarPD.bR (Fin.castAdd 24 S) = ((1920 : ℝ))⁻¹ := by
    simp only [PolytopeData.bR, QbarPD_rhs, QbarPD_D, qRhs_castAdd, Int.cast_one]
    norm_num
  rw [mem_qTight_iff_inner f (Fin.castAdd 24 S), hinner, hbR]
  have hbase : Work.FoldInst.sideSlack S (QbarPD.posR f)
      = 1 - ∑ j, (Work.FoldInst.sideNormal S j : ℝ) * (QbarPD.posR f) j := rfl
  rw [hbase]
  constructor
  · intro h
    have hsum1 : (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * (QbarPD.posR f) j) = 1 := by
      linarith
    rw [hsum1, mul_one]
  · intro h
    have hsum1 : (∑ j, (Work.FoldInst.sideNormal S j : ℝ) * (QbarPD.posR f) j) = 1 := by
      refine mul_left_cancel₀ (show ((1920 : ℝ))⁻¹ ≠ 0 by norm_num) ?_
      simpa using h
    linarith

/-- The `pos` point of a face lies in `Q̄`. -/
theorem posR_mem_Qbar (f : Fin 865) : QbarPD.posR f ∈ Work.FoldInst.Qbar := by
  rw [← QbarPD_Pset]
  exact posR_mem_Pset_basic QbarPD_okBasic f

/-- Every sub-face of a face is tight at all the sides the face is tight at. -/
theorem mem_qTight_of_le {a b : QbarCell} (h : b ≤ a) (S : Fin 24)
    (hS : Fin.castAdd 24 S ∈ qTight a.idx) : Fin.castAdd 24 S ∈ qTight b.idx :=
  QbarCell_le_iff.mp h hS

/-- **The identification group at the barycentre of a flag** is the subgroup generated by the types
of the sides tight at its top face. -/
theorem Ksub_bary_eq_KsubAtlas {k : ℕ} (s : Simplex QbarCW.Cell k) :
    Work.FoldInst.Ksub (bary s) = KsubAtlas ((s (Fin.last k)).idx) := by
  refine le_antisymm ?_ ?_
  · refine (AddSubgroup.closure_le (KsubAtlas ((s (Fin.last k)).idx))).mpr ?_
    rintro γ ⟨S, hS, rfl⟩
    refine AddSubgroup.subset_closure ⟨S, (mem_tightSidesIdx _ S).mpr ?_, rfl⟩
    rw [← sideSlack_posR_eq_zero_iff S (s (Fin.last k)).idx]
    rw [sideSlack_bary] at hS
    have hterm : ∀ i ∈ (Finset.univ : Finset (Fin (k + 1))), 0 ≤ ((k + 1 : ℝ))⁻¹
        * Work.FoldInst.sideSlack S (QbarPD.posR (s i).idx) := fun i _ =>
      mul_nonneg (by positivity) ((posR_mem_Qbar (s i).idx).1 S)
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg hterm).mp hS (Fin.last k) (Finset.mem_univ _)
    exact (mul_eq_zero.mp hzero).resolve_left (by positivity)
  · refine (AddSubgroup.closure_le (Work.FoldInst.Ksub (bary s))).mpr ?_
    rintro γ ⟨S, hS, rfl⟩
    refine AddSubgroup.subset_closure ⟨S, ?_, rfl⟩
    rw [sideSlack_bary]
    refine Finset.sum_eq_zero fun i _ => mul_eq_zero.mpr (Or.inr ?_)
    rw [sideSlack_posR_eq_zero_iff]
    exact mem_qTight_of_le (s.strictMono.monotone (Fin.le_last i)) S
      ((mem_tightSidesIdx _ S).mp hS)

/-! ## 4. Invariance of `KsubAtlas` under the sign-change action -/

theorem consAct_natAdd (g : Fin 4 → ZMod 2) (w : Fin 24) :
    consAct g (Fin.natAdd 24 w) = Fin.natAdd 24 (Work.FoldInst.truncPerm g w) := by
  decide +revert

theorem natAdd_ne_castAdd (w S : Fin 24) : Fin.natAdd 24 w ≠ Fin.castAdd 24 S := by
  intro h
  have hv : (Fin.natAdd 24 w).val = (Fin.castAdd 24 S).val := congrArg Fin.val h
  rw [Fin.val_natAdd, Fin.val_castAdd] at hv
  have := S.isLt
  omega

theorem castAdd_inj' {S S' : Fin 24} (h : Fin.castAdd 24 S = Fin.castAdd 24 S') : S = S' := by
  apply Fin.ext
  simpa using congrArg Fin.val h

theorem KsubAtlas_faceAct (g : Fin 4 → ZMod 2) (F : Fin 865) :
    KsubAtlas (faceAct g F) = KsubAtlas F := by
  refine le_antisymm ?_ ?_
  · refine (AddSubgroup.closure_le (KsubAtlas F)).mpr ?_
    rintro γ ⟨S, hS, rfl⟩
    simp only [Finset.mem_coe, mem_tightSidesIdx, qTight_faceAct] at hS
    obtain ⟨i, hi, hii⟩ := Finset.mem_image.mp hS
    rcases lt_or_ge (i : ℕ) 24 with hi24 | hi24
    · have hie : i = Fin.castAdd 24 (⟨(i : ℕ), hi24⟩ : Fin 24) := Fin.ext rfl
      rw [hie, consAct_castAdd] at hii
      have hperm : Work.FoldInst.sidePerm g ⟨(i : ℕ), hi24⟩ = S := castAdd_inj' hii
      refine AddSubgroup.subset_closure ⟨⟨(i : ℕ), hi24⟩, ?_, ?_⟩
      · exact (mem_tightSidesIdx F _).mpr hi
      · rw [← hperm, Work.FoldInst.sideType_sidePerm]
    · exfalso
      have hie : i = Fin.natAdd 24 (⟨(i : ℕ) - 24, by omega⟩ : Fin 24) :=
        Fin.ext (by simp [Fin.natAdd]; omega)
      rw [hie, consAct_natAdd] at hii
      exact natAdd_ne_castAdd _ _ hii
  · refine (AddSubgroup.closure_le (KsubAtlas (faceAct g F))).mpr ?_
    rintro γ ⟨S, hS, rfl⟩
    refine AddSubgroup.subset_closure
      ⟨Work.FoldInst.sidePerm g S, ?_, Work.FoldInst.sideType_sidePerm g S⟩
    simp only [Finset.mem_coe, mem_tightSidesIdx, qTight_faceAct]
    exact Finset.mem_image.mpr
      ⟨Fin.castAdd 24 S, (mem_tightSidesIdx F S).mp hS, consAct_castAdd g S⟩

end

end Work.MbarHomology.Mbar
